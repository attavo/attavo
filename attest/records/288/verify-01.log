vo/1-example ATTAVO_ITERATION=1 ATTAVO_FEEDBACK=\\\"$tmp/feedback.txt\\\" \\\"$here/adapters/claude-code/run\\\" > \\\"$2\\\" 2>/dev/null && echo 0 > \\\"$2.rc\\\" || echo $? > \\\"$2.rc\\\"\\n}\\nrun \\\"$tmp/auth.jsonl\\\" \\\"$tmp/auth.out\\\"\\nrun \\\"$tmp/other.jsonl\\\" \\\"$tmp/other.out\\\"\\ntest \\\"$(cat \\\"$tmp/auth.out.rc\\\")\\\" = 1\\ntest \\\"$(cat \\\"$tmp/other.out.rc\\\")\\\" = 1\\npython3 - \\\"$tmp\\\" <<'PY'\\nimport json, sys\\nfrom pathlib import Path\\ntmp = Path(sys.argv[1])\\nlast = json.loads((tmp / \\\"auth.out\\\").read_text().strip().splitlines()[-1])\\nassert last == {\\\"class\\\": \\\"environment\\\", \\\"detail\\\": \\\"Failed to authenticate: OAuth session expired and could not be refreshed\\\"}, last\\nassert '\\\"class\\\": \\\"environment\\\"' not in (tmp / \\\"other.out\\\").read_text()\\nPY\\nfor t in test_claude_code_classes_an_authentication_failure_as_environment_from_the_field test_claude_code_does_not_class_other_stream_errors_or_matching_words_as_environment\\ndo\\n  grep -q \\\"^def $t(\\\" tests/test_adapter_claude_code.py\\ndone\\nrm -rf \\\"$tmp\\\"\",\"is_error\":false}]},\"parent_tool_use_id\":null,\"session_id\":\"aa97438b-e700-4e9e-85e2-1d5bd8de4b83\",\"uuid\":\"3156cd22-665f-4e66-b0ea-5ec187122162\",\"timestamp\":\"2026-09-30T02:23:06.504Z\",\"tool_use_result\":{\"stdout\":\"#!/bin/sh\\nset -e\\nhere=$(pwd)\\ntmp=$(mktemp -d \\\"${TMPDIR:-/tmp}/attavo.XXXXXX\\\")\\nprintf '%s\\\\n' '{\\\"type\\\": \\\"system\\\", \\\"subtype\\\": \\\"init\\\"}' '{\\\"type\\\": \\\"assistant\\\", \\\"error\\\": \\\"authentication_failed\\\", \\\"is_api_error_message\\\": true, \\\"message\\\": {\\\"content\\\": [{\\\"type\\\": \\\"text\\\", \\\"text\\\": \\\"Failed to authenticate: OAuth session expired and could not be refreshed\\\"}]}}' > \\\"$tmp/auth.jsonl\\\"\\nprintf '%s\\\\n' '{\\\"type\\\": \\\"system\\\", \\\"subtype\\\": \\\"init\\\"}' '{\\\"type\\\": \\\"assistant\\\", \\\"error\\\": \\\"invalid_request\\\", \\\"message\\\": {\\\"content\\\": [{\\\"type\\\": \\\"text\\\", \\\"text\\\": \\\"Failed to authenticate: OAuth session expired and could not be refreshed\\\"}]}}' > \\\"$tmp/other.jsonl\\\"\\nrun() {\\n  ATTAVO_ADAPTER_STREAM_FILE=\\\"$1\\\" ATTAVO_SPEC_DIR=\\\"$here/tests/fixtures/build_valid/specs/1\\\" ATTAVO_RECORDS_DIR=\\\"$tmp/records\\\" ATTAVO_RULINGS=\\\"$tmp/rulings.md\\\" ATTAVO_BRANCH=attavo/1-example ATTAVO_ITERATION=1 ATTAVO_FEEDBACK=\\\"$tmp/feedback.txt\\\" \\\"$here/adapters/claude-code/run\\\" > \\\"$2\\\" 2>/dev/null && echo 0 > \\\"$2.rc\\\" || echo $? > \\\"$2.rc\\\"\\n}\\nrun \\\"$tmp/auth.jsonl\\\" \\\"$tmp/auth.out\\\"\\nrun \\\"$tmp/other.jsonl\\\" \\\"$tmp/other.out\\\"\\ntest \\\"$(cat \\\"$tmp/auth.out.rc\\\")\\\" = 1\\ntest \\\"$(cat \\\"$tmp/other.out.rc\\\")\\\" = 1\\npython3 - \\\"$tmp\\\" <<'PY'\\nimport json, sys\\nfrom pathlib import Path\\ntmp = Path(sys.argv[1])\\nlast = json.loads((tmp / \\\"auth.out\\\").read_text().strip().splitlines()[-1])\\nassert last == {\\\"class\\\": \\\"environment\\\", \\\"detail\\\": \\\"Failed to authenticate: OAuth session expired and could not be refreshed\\\"}, last\\nassert '\\\"class\\\": \\\"environment\\\"' not in (tmp / \\\"other.out\\\").read_text()\\nPY\\nfor t in test_claude_code_classes_an_authentication_failure_as_environment_from_the_field test_claude_code_does_not_class_other_stream_errors_or_matching_words_as_environment\\ndo\\n  grep -q \\\"^def $t(\\\" tests/test_adapter_claude_code.py\\ndone\\nrm -rf \\\"$tmp\\\"\",\"stderr\":\"\",\"interrupted\":false,\"isImage\":false,\"noOutputExpected\":false}}\n+{\"type\":\"system\",\"subtype\":\"thinking_tokens\",\"estimated_tokens\":50,\"estimated_tokens_delta\":50,\"session_id\":\"aa97438b-e700-4e9e-85e2-1d5bd8de4b83\",\"uuid\":\"386a0dfc-a96e-4fe5-a066-906bb9cde4c8\"}\n+{\"type\":\"system\",\"subtype\":\"thinking_tokens\",\"estimated_tokens\":150,\"estimated_tokens_delta\":100,\"session_id\":\"aa97438b-e700-4e9e-85e2-1d5bd8de4b83\",\"uuid\":\"506eb15d-0454-4da4-8692-bd57a0244e5b\"}\n+{\"type\":\"system\",\"subtype\":\"thinking_tokens\",\"estimated_tokens\":241,\"estimated_tokens_delta\":91,\"session_id\":\"aa97438b-e700-4e9e-85e2-1d5bd8de4b83\",\"uuid\":\"5dbdbf6f-7c27-46c4-a519-88f880b75658\"}\n+{\"type\":\"assistant\",\"message\":{\"model\":\"claude-sonnet-5\",\"id\":\"msg_011CfYpzBFCJFbTJ3E15FqhX\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"thinking\",\"thinking\":\"\",\"signature\":\"\"}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":1050,\"cache_read_input_tokens\":28869,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":1050},\"output_tokens\":2,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"aa97438b-e700-4e9e-85e2-1d5bd8de4b83\",\"uuid\":\"cbb3d8b8-086a-43ab-9bfb-1ff01fa657c0\",\"timestamp\":\"2026-09-30T02:23:09.984Z\",\"request_id\":\"req_011CfYpzAv7JsyVKNvcSpzCK\"}\n+{\"type\":\"assistant\",\"message\":{\"model\":\"claude-sonnet-5\",\"id\":\"msg_011CfYpzBFCJFbTJ3E15FqhX\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_012cEjT5XxHU7gTbBvrzUNer\",\"name\":\"Read\",\"input\":{\"file_path\":\"/Users/davidbean/Projects/attavo-worktree-288/adapters/claude-code/run\"},\"caller\":{\"type\":\"direct\"}}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":1050,\"cache_read_input_tokens\":28869,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":1050},\"output_tokens\":2,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"aa97438b-e700-4e9e-85e2-1d5bd8de4b83\",\"uuid\":\"dcf1420d-dd95-4b09-b4e1-3a3e913f4338\",\"timestamp\":\"2026-09-30T02:23:10.450Z\",\"request_id\":\"req_011CfYpzAv7JsyVKNvcSpzCK\",\"wire_tool_inputs\":{\"toolu_012cEjT5XxHU7gTbBvrzUNer\":{\"file_path\":\"/Users/davidbean/Projects/attavo-worktree-288/adapters/claude-code/run\"}}}\n+{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_012cEjT5XxHU7gTbBvrzUNer\",\"type\":\"tool_result\",\"content\":\"1\\t#!/usr/bin/env python3\\n2\\t\\\"\\\"\\\"adapters/claude-code/run -- see README.md (this directory) for the four\\n3\\tconfiguration keys, and ../README.md for the shared adapter contract.\\n4\\t\\n5\\tA live `claude` invocation is not exercised by the test suite (judgment\\n6\\tis measured, not tested); its argument construction is checked by\\n7\\tATTAVO_ADAPTER_DRY_RUN=1, which prints the `claude` command line as a\\n8\\tJSON array instead of running it, its response handling is checked by\\n9\\tATTAVO_ADAPTER_RESPONSE_FILE, which reads a canned final report object\\n10\\tfrom a file instead of invoking `claude`, and (issue #26) its\\n11\\t`--output-format stream-json --verbose` mapping -- the event stream\\n12\\tthis adapter maps to ATTAVO_EVENTS, and the terminal \\\"result\\\" line it\\n13\\treads the report object from -- is checked by ATTAVO_ADAPTER_STREAM_FILE,\\n14\\twhich feeds a recorded transcript instead.\\n15\\t\\n16\\tThe whole result is printed to stdout before this adapter's own final\\n17\\tline, so build-NN.log carries it as the transcript -- a halt otherwise\\n18\\tcannot be explained after the fact. is_error or an absent\\n19\\tstructured_output exit 1 on either stage; a build status \\\"question\\\"\\n20\\twhose question is missing or under MIN_QUESTION_CHARS characters also\\n21\\texits 1 (build records the attempt as failed) rather than a halt\\n22\\tsomeone must rule on.\\n23\\t\\n24\\tATTAVO_STAGE=verify branches to a different objective, schema, and\\n25\\treport shape (issue #46): the instruction states the verify objective\\n26\\t(see verify_instruction) instead of the build one, --json-schema is\\n27\\tVERIFY_SCHEMA instead of STATUS_SCHEMA, and the final line carries\\n28\\tfindings and tests_named instead of status and question.\\n29\\t\\n30\\tIssue #78: the boundary is the tool's own sandbox, not a curated\\n31\\tallowed_tools list judged per sub-command -- confirmed live (recorded on\\n32\\tthe issue, 2026-09-10) against `claude 2.1.268`: `--settings` carrying\\n33\\t`{\\\"sandbox\\\": {\\\"enabled\\\": true, \\\"allowUnsandboxedCommands\\\": false}}` under\\n34\\t`-p` refuses a write outside the working directory (\\\"operation not\\n35\\tpermitted\\\") and, with `network.allowedDomains: []`, refuses an outbound\\n36\\tconnection (\\\"deny network-outbound ...\\\"), both before `--allowedTools`\\n37\\tis ever consulted. build's `--settings` therefore enables the sandbox and\\n38\\tforbids the unsandboxed fallback; verify's additionally sets\\n39\\t`filesystem.denyWrite` on the working directory itself (confirmed live:\\n40\\t`denyWrite` takes a list of paths, not a bare boolean -- `true` alone did\\n41\\tnot stop a write inside the directory). `--allowedTools` shrinks to the\\n42\\ttool names each stage may use at all -- `Read,Edit,Write,Bash` for build,\\n43\\t`Read,Bash` for verify -- since Edit and Write are not Bash and the\\n44\\tsandbox does not govern them. `allowed_tools` is retired as a manifest\\n45\\tkey: a config that still declares it is refused by name rather than\\n46\\tsilently accepted.\\n47\\t\\n48\\tIssue #88 (class A: a report is not a question). `--json-schema`\\n49\\tconstrains the tool's structured_output to \\\"done\\\"/\\\"question\\\", but\\n50\\tnothing stops \\\"question\\\" from carrying a status report rather than an\\n51\\tactual question -- confirmed against tenant zero's own corpus, five\\n52\\tspecimens with no \\\"?\\\" anywhere in the text. A \\\"question\\\" whose text\\n53\\tclears MIN_QUESTION_CHARS but contains no \\\"?\\\" is a report, not a\\n54\\tquestion: this adapter re-invokes the executor once, appending\\n55\\tREINSTRUCTION to the same instruction, before ever reporting a halt to\\n56\\ta person. A second report in a row still halts (someone must look), but\\n57\\tits report line carries \\\"class\\\": \\\"non-question\\\" and both raw results\\n58\\treached stdout above it -- an extra field bin/attavo's own record schema\\n59\\tdoes not know about and never has to: it reads \\\"status\\\"/\\\"question\\\" off\\n60\\tthis line exactly as before, so a \\\"question\\\" halt still halts. Read via\\n61\\tATTAVO_ADAPTER_RESPONSE_FILE, a JSON array is a queue -- one canned\\n62\\tresult per invocation this adapter makes, its last element repeating\\n63\\tonce exhausted -- while a single object still repeats for every call,\\n64\\tunchanged.\\n65\\t\\n66\\tIssue #88 (class B: work that outlives the invocation). Confirmed live,\\n67\\tthis machine, `claude 2.1.269`: with both \\\"Agent\\\" and \\\"Task\\\" allowed, a\\n68\\tprompt asking for a subagent produced `subagent_stats.spawned: 1`, `\\\"Agent\\\"`\\n69\\talone in `--disallowedTools` (Task is not a distinct tool in this build)\\n70\\tbrought it back to 0 -- the tool's own reply named \\\"Workflow\\\" as the\\n71\\tother path to background work, so both are named here. `--allowedTools`\\n72\\tis an allow-list a background spawn does not consult (tenant zero's\\n73\\tspecimen: `--allowedTools` without \\\"Agent\\\" or \\\"Workflow\\\" in it at all did\\n74\\tnot stop three of them), so this adapter also disallows them by name on\\n75\\tboth stages and, after the run, refuses by name -- exit 1, not a\\n76\\thalt -- any response whose subagent_stats.spawned is not zero, with the\\n77\\tcounts in the message. A tool that reports no subagent_stats at all\\n78\\t(spawned absent or 0) is unaffected; this is a refusal on evidence, not a\\n79\\tguess from the flag.\\n80\\t\\\"\\\"\\\"\\n81\\tfrom __future__ import annotations\\n82\\t\\n83\\timport json\\n84\\timport os\\n85\\timport subprocess\\n86\\timport sys\\n87\\tfrom datetime import datetime, timezone\\n88\\tfrom pathlib import Path\\n89\\t\\n90\\t# the helper beside adapters/, imported without leaving a __pycache__ there\\n91\\tsys.dont_write_bytecode = True\\n92\\tsys.path.insert(0, str(Path(__file__).resolve().parent.parent))\\n93\\tfrom executor_env import executor_env  # noqa: E402\\n94\\t\\n95\\tSTATUS_SCHEMA = {\\n96\\t    \\\"type\\\": \\\"object\\\",\\n97\\t    \\\"additionalProperties\\\": False,\\n98\\t    \\\"required\\\": [\\\"status\\\", \\\"question\\\"],\\n99\\t    \\\"properties\\\": {\\n100\\t        \\\"status\\\": {\\\"type\\\": \\\"string\\\", \\\"enum\\\": [\\\"done\\\", \\\"question\\\"]},\\n101\\t        \\\"question\\\": {\\\"type\\\": [\\\"string\\\", \\\"null\\\"]},\\n102\\t    },\\n103\\t}\\n104\\t\\n105\\t# The verify objective (issue #46): a verifier reports findings, not a\\n106\\t# commit. additionalProperties: False means the tool cannot hand back a\\n107\\t# structured_output shaped like STATUS_SCHEMA's status/question by\\n108\\t# accident -- an absent findings key is what cmd_verify treats as\\n109\\t# failed, not a lenient default here.\\n110\\tVERIFY_SCHEMA = {\\n111\\t    \\\"type\\\": \\\"object\\\",\\n112\\t    \\\"additionalProperties\\\": False,\\n113\\t    \\\"required\\\": [\\\"findings\\\", \\\"tests_named\\\"],\\n114\\t    \\\"properties\\\": {\\n115\\t        \\\"findings\\\": {\\n116\\t            \\\"type\\\": \\\"array\\\",\\n117\\t            \\\"items\\\": {\\n118\\t                \\\"type\\\": \\\"object\\\",\\n119\\t                \\\"additionalProperties\\\": False,\\n120\\t                \\\"required\\\": [\\\"title\\\", \\\"specimen\\\", \\\"retires\\\", \\\"rejection_test\\\", \\\"severity\\\"],\\n121\\t                \\\"properties\\\": {\\n122\\t                    \\\"title\\\": {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1},\\n123\\t                    \\\"specimen\\\": {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1},\\n124\\t                    \\\"retires\\\": {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1},\\n125\\t                    \\\"rejection_test\\\": {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1},\\n126\\t                    \\\"severity\\\": {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1},\\n127\\t                },\\n128\\t            },\\n129\\t        },\\n130\\t        \\\"tests_named\\\": {\\\"type\\\": \\\"array\\\", \\\"items\\\": {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1}},\\n131\\t    },\\n132\\t}\\n133\\t\\n134\\t# The counsel objective (issue #100): a stop is read inside the product\\n135\\t# first, before a person. additionalProperties: False for the same reason\\n136\\t# as VERIFY_SCHEMA's own -- the tool cannot hand back a differently-shaped\\n137\\t# structured_output by accident.\\n138\\tCOUNSEL_SCHEMA = {\\n139\\t    \\\"type\\\": \\\"object\\\",\\n140\\t    \\\"additionalProperties\\\": False,\\n141\\t    \\\"required\\\": [\\\"class\\\", \\\"verdict\\\", \\\"citations\\\", \\\"proposal\\\"],\\n142\\t    \\\"properties\\\": {\\n143\\t        \\\"class\\\": {\\\"type\\\": \\\"string\\\"},\\n144\\t        \\\"verdict\\\": {\\\"type\\\": \\\"string\\\", \\\"enum\\\": [\\\"answer\\\", \\\"patch\\\", \\\"person\\\"]},\\n145\\t        \\\"citations\\\": {\\n146\\t            \\\"type\\\": \\\"array\\\",\\n147\\t            \\\"items\\\": {\\n148\\t                \\\"type\\\": \\\"object\\\",\\n149\\t                \\\"additionalProperties\\\": False,\\n150\\t                \\\"required\\\": [\\\"kind\\\", \\\"path\\\", \\\"symbol\\\", \\\"ruling_id\\\"],\\n151\\t                \\\"properties\\\": {\\n152\\t                    \\\"kind\\\": {\\\"type\\\": \\\"string\\\", \\\"enum\\\": [\\\"instruction\\\", \\\"mechanism\\\", \\\"guard\\\"]},\\n153\\t                    \\\"path\\\": {\\\"type\\\": [\\\"string\\\", \\\"null\\\"]},\\n154\\t                    \\\"symbol\\\": {\\\"type\\\": [\\\"string\\\", \\\"null\\\"]},\\n155\\t                    \\\"ruling_id\\\": {\\\"type\\\": [\\\"string\\\", \\\"null\\\"]},\\n156\\t                },\\n157\\t            },\\n158\\t        },\\n159\\t        \\\"proposal\\\": {\\n160\\t            \\\"type\\\": \\\"object\\\",\\n161\\t            \\\"additionalProperties\\\": False,\\n162\\t            \\\"required\\\": [\\\"ruling_text\\\", \\\"patch\\\", \\\"question\\\", \\\"issue\\\"],\\n163\\t            \\\"properties\\\": {\\n164\\t                \\\"ruling_text\\\": {\\\"type\\\": [\\\"string\\\", \\\"null\\\"]},\\n165\\t                \\\"patch\\\": {\\n166\\t                    \\\"type\\\": [\\\"object\\\", \\\"null\\\"],\\n167\\t                    \\\"additionalProperties\\\": False,\\n168\\t                    \\\"required\\\": [\\\"file\\\", \\\"symbol\\\", \\\"rejection_test\\\", \\\"diff\\\"],\\n169\\t                    \\\"properties\\\": {\\n170\\t                        \\\"file\\\": {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1},\\n171\\t                        \\\"symbol\\\": {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1},\\n172\\t                        \\\"rejection_test\\\": {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1},\\n173\\t                        \\\"diff\\\": {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1},\\n174\\t                    },\\n175\\t                },\\n176\\t                \\\"question\\\": {\\\"type\\\": [\\\"string\\\", \\\"null\\\"]},\\n177\\t                # issue #175: the fourth proposal shape, for a \\\"patch\\\" or\\n178\\t                # \\\"person\\\" verdict whose remedy is better filed as an item\\n179\\t                # than shipped as a diff or asked as a bare question.\\n180\\t                \\\"issue\\\": {\\n181\\t                    \\\"type\\\": [\\\"object\\\", \\\"null\\\"],\\n182\\t                    \\\"additionalProperties\\\": False,\\n183\\t                    \\\"required\\\": [\\\"title\\\", \\\"body\\\"],\\n184\\t                    \\\"properties\\\": {\\n185\\t                        \\\"title\\\": {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1},\\n186\\t                        \\\"body\\\": {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1},\\n187\\t                    },\\n188\\t                },\\n189\\t            },\\n190\\t        },\\n191\\t    },\\n192\\t}\\n193\\t\\n194\\t\\n195\\tdef read_text(path_env: str) -> str:\\n196\\t    path = os.environ.get(path_env)\\n197\\t    if not path:\\n198\\t        return \\\"\\\"\\n199\\t    p = Path(path)\\n200\\t    return p.read_text() if p.is_file() else \\\"\\\"\\n201\\t\\n202\\t\\n203\\tdef describe_file(path: str, text: str, diff_like: bool) -> str:\\n204\\t    \\\"\\\"\\\"Path, byte count, line count, and (for a diff) files touched --\\n205\\t    named in the instruction instead of inlining the file's own text, so\\n206\\t    the instruction stays a small fixed size whatever the file's size\\n207\\t    (issue #86: a 27,367-line deletion diff inlined whole exceeded a\\n208\\t    judge's input ceiling -- codex's, on the specimen that surfaced it).\\n209\\t    Files touched counts unified-diff file headers (`diff --git a/...\\n210\\t    b/...`), the shape `git diff` produces.\\\"\\\"\\\"\\n211\\t    size = Path(path).stat().st_size\\n212\\t    lines = text.count(\\\"\\\\n\\\") + (1 if text and not text.endswith(\\\"\\\\n\\\") else 0)\\n213\\t    if not diff_like:\\n214\\t        return f\\\"`{path}` ({size} bytes, {lines} lines)\\\"\\n215\\t    files = sum(1 for l in text.splitlines() if l.startswith(\\\"diff --git \\\"))\\n216\\t    return f\\\"`{path}` ({size} bytes, {lines} lines, {files} files touched)\\\"\\n217\\t\\n218\\t\\n219\\tdef spec_sections() -> list[str]:\\n220\\t    \\\"\\\"\\\"The spec's Problem, Claims, and Criteria sections verbatim -- what\\n221\\t    both build and verify need to see, in the shape the spec contract\\n222\\t    (not this adapter) already gives them.\\\"\\\"\\\"\\n223\\t    spec_dir = Path(os.environ[\\\"ATTAVO_SPEC_DIR\\\"])\\n224\\t    lines = (spec_dir / \\\"spec.md\\\").read_text().splitlines()\\n225\\t    idx = [i for i, l in enumerate(lines) if l.startswith(\\\"## \\\")]\\n226\\t    headings = {lines[i].strip(): i for i in idx}\\n227\\t    bounds = sorted(idx) + [len(lines)]\\n228\\t\\n229\\t    def section(heading: str) -> str:\\n230\\t        start = headings[heading]\\n231\\t        end = bounds[bounds.index(start) + 1] if start in bounds else len(lines)\\n232\\t        return \\\"\\\\n\\\".join(lines[start:end]).strip()\\n233\\t\\n234\\t    return [section(\\\"## Problem\\\"), section(\\\"## Claims\\\"), section(\\\"## Criteria\\\")]\\n235\\t\\n236\\t\\n237\\tdef stub_note() -> str | None:\\n238\\t    \\\"\\\"\\\"None when ATTAVO_SPEC_DIR carries no stub/; else the sentence\\n239\\t    naming what a stub is (issue #90, closed by #93). The stub is\\n240\\t    evidence -- a criterion it satisfies trivially is weak -- but twice\\n241\\t    the judge reported\\n242\\t    a built tree as failing to match its stub as if the stub were the\\n243\\t    intended change (tenant zero #664, #644): one sentence of vocabulary\\n244\\t    was missing, not a smarter judge or a dropped stub.\\\"\\\"\\\"\\n245\\t    stub_dir = Path(os.environ[\\\"ATTAVO_SPEC_DIR\\\"]) / \\\"stub\\\"\\n246\\t    if not stub_dir.is_dir():\\n247\\t        return None\\n248\\t    return (\\n249\\t        f\\\"## The stub at `{stub_dir}`\\\\n\\\\n\\\"\\n250\\t        \\\"The stub is the fixture the acceptance criteria were shown to \\\"\\n251\\t        \\\"pass against; it is not the intended change. A difference \\\"\\n252\\t        \\\"between the built tree and the stub is not a finding: a \\\"\\n253\\t        \\\"criterion the stub satisfies trivially is.\\\")\\n254\\t\\n255\\t\\n256\\tdef build_instruction() -> str:\\n257\\t    parts = list(spec_sections())\\n258\\t\\n259\\t    rulings = read_text(\\\"ATTAVO_RULINGS\\\")\\n260\\t    if rulings.strip():\\n261\\t        parts.append(\\\"## Rulings\\\\n\\\\n\\\" + rulings.strip())\\n262\\t\\n263\\t    feedback_path = os.environ.get(\\\"ATTAVO_FEEDBACK\\\")\\n264\\t    feedback = read_text(\\\"ATTAVO_FEEDBACK\\\")\\n265\\t    if feedback.strip():\\n266\\t        parts.append(\\n267\\t            \\\"## Feedback from the previous attempt\\\\n\\\\n\\\"\\n268\\t            f\\\"The feedback is at {describe_file(feedback_path, feedback, diff_like=False)}. \\\"\\n269\\t            \\\"It is not inlined here: read it yourself with your own tools \\\"\\n270\\t            \\\"before continuing.\\\")\\n271\\t\\n272\\t    parts.append(\\n273\\t        \\\"commit your work on the current branch; if you cannot proceed \\\"\\n274\\t        \\\"without a decision that changes the criteria, do not guess: \\\"\\n275\\t        \\\"answer with status question\\\")\\n276\\t\\n277\\t    test_command = os.environ.get(\\\"ATTAVO_TEST_COMMAND\\\")\\n278\\t    if test_command:\\n279\\t        bound = os.environ.get(\\\"ATTAVO_TEST_TIMEOUT_S\\\")\\n280\\t        parts.append(\\n281\\t            f\\\"to run tests while you work, run `{test_command}`: it runs the tests \\\"\\n282\\t            \\\"selected for the files you have changed\\\"\\n283\\t            + (f\\\" and stops at {bound} s\\\" if bound else \\\"\\\")\\n284\\t            + \\\". Run a single test with `\\\" + test_command + \\\" <path or test id>`. \\\"\\n285\\t            \\\"Do not run the test runner directly, the whole test suite, or any \\\"\\n286\\t            \\\"whole-tree check yourself: when the criteria and \\\" + \\\"`\\\" + test_command + \\\"`\\\"\\n287\\t            + \\\" pass, commit and stop; the gates are run for you and any failure is \\\"\\n288\\t            \\\"returned to you on the next iteration\\\")\\n289\\t\\n290\\t    return \\\"\\\\n\\\\n\\\".join(parts)\\n291\\t\\n292\\t\\n293\\tdef verify_instruction() -> str:\\n294\\t    parts = list(spec_sections())\\n295\\t\\n296\\t    note = stub_note()\\n297\\t    if note:\\n298\\t        parts.append(note)\\n299\\t\\n300\\t    diff_path = os.environ.get(\\\"ATTAVO_DIFF\\\")\\n301\\t    diff = read_text(\\\"ATTAVO_DIFF\\\")\\n302\\t    if diff.strip():\\n303\\t        parts.append(\\n304\\t            \\\"## Diff since the approved spec\\\\n\\\\n\\\"\\n305\\t            f\\\"The diff is at {describe_file(diff_path, diff, diff_like=True)}. \\\"\\n306\\t            \\\"It is not inlined here: read it yourself with your own tools \\\"\\n307\\t            \\\"before judging it.\\\")\\n308\\t    else:\\n309\\t        parts.append(\\\"## Diff since the approved spec\\\\n\\\\n(the diff is empty)\\\")\\n310\\t\\n311\\t    build_record_path = os.environ.get(\\\"ATTAVO_BUILD_RECORD\\\")\\n312\\t    build_record = read_text(\\\"ATTAVO_BUILD_RECORD\\\")\\n313\\t    if build_record.strip():\\n314\\t        parts.append(\\n315\\t            \\\"## The build record\\\\n\\\\n\\\"\\n316\\t            f\\\"The build record is at {describe_file(build_record_path, build_record, diff_like=False)}. \\\"\\n317\\t            \\\"Read it yourself with your own tools.\\\")\\n318\\t\\n319\\t    parts.append(\\n320\\t        \\\"you are verifying a completed build, not building: make no edits, \\\"\\n321\\t        \\\"write no files, commit nothing. Read the diff named above against \\\"\\n322\\t        \\\"the criteria and name what the criteria do not assert but the diff \\\"\\n323\\t        \\\"should still be judged on, and name the tests that would assert \\\"\\n324\\t        \\\"it if they existed. A spec whose approval commit does not \\\"\\n325\\t        \\\"describe the working tree the build produced is itself a \\\"\\n326\\t        \\\"finding: the diff is judged against what was approved, and a \\\"\\n327\\t        \\\"divergence between them is reportable rather than assumed \\\"\\n328\\t        \\\"away. Report each as a finding: title, specimen (the file or \\\"\\n329\\t        \\\"commit the finding is about), retires (what having this \\\"\\n330\\t        \\\"finding on record replaces or closes -- every finding must \\\"\\n331\\t        \\\"carry one, or it is refused unfiled), rejection_test (the test \\\"\\n332\\t        \\\"that would catch a regression of it), and severity. Severity \\\"\\n333\\t        \\\"is derived rather than judged: the version, counter, \\\"\\n334\\t        \\\"condition, or state change that flips a finding from harmless \\\"\\n335\\t        \\\"to blocking; an adjective is not a severity. An empty \\\"\\n336\\t        \\\"findings list means you looked and found nothing to report, not \\\"\\n337\\t        \\\"that you did not look.\\\")\\n338\\t    return \\\"\\\\n\\\\n\\\".join(parts)\\n339\\t\\n340\\t\\n341\\tdef counsel_instruction() -> str:\\n342\\t    \\\"\\\"\\\"Issue #100 (extended by issue #175): a stop is read inside the\\n343\\t    product first, before a person. The record, its log, the diff, the\\n344\\t    forge's checks, the item's graph, the tenant manifest, and this\\n345\\t    product's own root are all handed by path -- named in the instruction\\n346\\t    instead of inlined, the same discipline verify_instruction already\\n347\\t    applies to the diff (issue #86), so this instruction's own size stays\\n348\\t    fixed whatever the record, log, diff, checks, or graph's size.\\\"\\\"\\\"\\n349\\t    parts = list(spec_sections())\\n350\\t\\n351\\t    rulings = read_text(\\\"ATTAVO_RULINGS\\\")\\n352\\t    if rulings.strip():\\n353\\t        parts.append(\\\"## Rulings\\\\n\\\\n\\\" + rulings.strip())\\n354\\t\\n355\\t    note = stub_note()\\n356\\t    if note:\\n357\\t        parts.append(note)\\n358\\t\\n359\\t    record_path = os.environ.get(\\\"ATTAVO_COUNSEL_RECORD\\\")\\n360\\t    record_text = read_text(\\\"ATTAVO_COUNSEL_RECORD\\\")\\n361\\t    if record_text.strip():\\n362\\t        parts.append(\\n363\\t            \\\"## The stage record\\\\n\\\\n\\\"\\n364\\t            f\\\"The record is at {describe_file(record_path, record_text, diff_like=False)}. \\\"\\n365\\t            \\\"Read it yourself with your own tools.\\\")\\n366\\t\\n367\\t    log_path = os.environ.get(\\\"ATTAVO_COUNSEL_LOG\\\")\\n368\\t    log_text = read_text(\\\"ATTAVO_COUNSEL_LOG\\\")\\n369\\t    if log_text.strip():\\n370\\t        parts.append(\\n371\\t            \\\"## The record's log\\\\n\\\\n\\\"\\n372\\t            f\\\"The log is at {describe_file(log_path, log_text, diff_like=False)}. \\\"\\n373\\t            \\\"Read it yourself with your own tools.\\\")\\n374\\t\\n375\\t    diff_path = os.environ.get(\\\"ATTAVO_COUNSEL_DIFF\\\")\\n376\\t    diff_text = read_text(\\\"ATTAVO_COUNSEL_DIFF\\\")\\n377\\t    if diff_text.strip():\\n378\\t        parts.append(\\n379\\t            \\\"## The item's diff since approval\\\\n\\\\n\\\"\\n380\\t            f\\\"The diff is at {describe_file(diff_path, diff_text, diff_like=True)}. \\\"\\n381\\t            \\\"Read it yourself with your own tools.\\\")\\n382\\t\\n383\\t    # issue #175: the forge in the evidence set. ATTAVO_COUNSEL_CHECKS is\\n384\\t    # always written, a JSON {read, reason, checks} envelope -- read false\\n385\\t    # names the missing manifest key rather than leaving the section out,\\n386\\t    # since an unread forge must never be mistaken for a green one.\\n387\\t    checks_path = os.environ.get(\\\"ATTAVO_COUNSEL_CHECKS\\\")\\n388\\t    checks_text = read_text(\\\"ATTAVO_COUNSEL_CHECKS\\\")\\n389\\t    if checks_text.strip():\\n390\\t        parts.append(\\n391\\t            \\\"## The forge's checks on this stop's sha\\\\n\\\\n\\\"\\n392\\t            f\\\"The checks are at {describe_file(checks_path, checks_text, diff_like=False)}: \\\"\\n393\\t            \\\"a JSON object -- read: false means the forge was not read at \\\"\\n394\\t            \\\"all (reason names the missing manifest key; treat this as \\\"\\n395\\t            \\\"unknown, never as green) -- read: true carries one entry per \\\"\\n396\\t            \\\"check, each naming, for a check that did not succeed, the \\\"\\n397\\t            \\\"path of its own failed-step log. Read the failing check's \\\"\\n398\\t            \\\"log before answering about the forge; a remedy that depends \\\"\\n399\\t            \\\"on the forge's state cites the check and its log line.\\\")\\n400\\t\\n401\\t    # issue #175: the graph in the evidence set -- the default branch's\\n402\\t    # own log since this item's branch point, this branch's own commits,\\n403\\t    # the markers and records present at the stop's sha, and the check\\n404\\t    # runs on the last three shas, so \\\"the checks are on the record\\n405\\t    # commit, not the code commit\\\" is readable without a terminal.\\n406\\t    graph_path = os.environ.get(\\\"ATTAVO_COUNSEL_GRAPH\\\")\\n407\\t    graph_text = read_text(\\\"ATTAVO_COUNSEL_GRAPH\\\")\\n408\\t    if graph_text.strip():\\n409\\t        parts.append(\\n410\\t            \\\"## The item's graph\\\\n\\\\n\\\"\\n411\\t            f\\\"The graph is at {describe_file(graph_path, graph_text, diff_like=False)}. \\\"\\n412\\t            \\\"Read it yourself with your own tools.\\\")\\n413\\t\\n414\\t    manifest_path = os.environ.get(\\\"ATTAVO_MANIFEST\\\", \\\"\\\")\\n415\\t    parts.append(f\\\"## The tenant manifest\\\\n\\\\nThe manifest is at `{manifest_path}`. \\\"\\n416\\t                 \\\"Read it yourself with your own tools.\\\")\\n417\\t\\n418\\t    product_root = os.environ.get(\\\"ATTAVO_PRODUCT_ROOT\\\", \\\"\\\")\\n419\\t    parts.append(\\n420\\t        \\\"## The product's own root\\\\n\\\\n\\\"\\n421\\t        f\\\"The product that ran this stage is at `{product_root}` \\\"\\n422\\t        \\\"(`bin/attavo`, `adapters/`, `schema/`, `templates/`). A stop \\\"\\n423\\t        \\\"whose cause is the product's own mechanism, not the tenant's, \\\"\\n424\\t        \\\"is read here.\\\")\\n425\\t\\n426\\t    # issue #175: attavo counsel N --ask hands the operator's own text as\\n427\\t    # the question to answer, over the same evidence set, rather than\\n428\\t    # diagnosing a stop -- the record above is context, not necessarily a\\n429\\t    # failure.\\n430\\t    question = os.environ.get(\\\"ATTAVO_COUNSEL_QUESTION\\\", \\\"\\\")\\n431\\t    if question.strip():\\n432\\t        parts.append(\\n433\\t            \\\"## The operator's question\\\\n\\\\n\\\" + question.strip() +\\n434\\t            \\\"\\\\n\\\\nAnswer this question using the evidence above; the \\\"\\n435\\t            \\\"record named above is context, not necessarily a failure.\\\")\\n436\\t\\n437\\t    parts.append(\\n438\\t        \\\"you are counseling a stop, read-only: make no edits, write no \\\"\\n439\\t        \\\"files, commit nothing. Read the record, its log, the spec, the \\\"\\n440\\t        \\\"rulings, the diff, the forge's checks, the item's graph, the \\\"\\n441\\t        \\\"tenant manifest, and the product's own root named above with \\\"\\n442\\t        \\\"your own tools, then answer with exactly one class (the stop's \\\"\\n443\\t        \\\"class, or \\\\\\\"unclassed\\\\\\\"), one verdict -- \\\\\\\"answer\\\\\\\" (the stop is \\\"\\n444\\t        \\\"answerable inside the rules: a ruling text, in \\\"\\n445\\t        \\\"proposal.ruling_text, with three citations -- instruction, \\\"\\n446\\t        \\\"mechanism, guard, each a path and symbol or a ruling id), \\\"\\n447\\t        \\\"\\\\\\\"patch\\\\\\\" (the stop is a product defect: the mechanism's file \\\"\\n448\\t        \\\"and symbol, a rejection test, and a unified diff, in \\\"\\n449\\t        \\\"proposal.patch -- or, when the remedy is better filed as an \\\"\\n450\\t        \\\"item than shipped as a diff, a title and a body in this \\\"\\n451\\t        \\\"repository's own issue format -- a Severity/Provenance line, \\\"\\n452\\t        \\\"then Problem, Retires, Change, and Acceptance sections -- in \\\"\\n453\\t        \\\"proposal.issue), or \\\\\\\"person\\\\\\\" (the answer would touch the \\\"\\n454\\t        \\\"definition of done and no rule covers it: the question restated \\\"\\n455\\t        \\\"in one line, in proposal.question -- or, when the remedy is \\\"\\n456\\t        \\\"better filed as an item than asked as a bare question, a title \\\"\\n457\\t        \\\"and a body in the same issue format, in proposal.issue) -- and \\\"\\n458\\t        \\\"citations for whichever verdict you gave. You propose; you do \\\"\\n459\\t        \\\"not act.\\\")\\n460\\t    return \\\"\\\\n\\\\n\\\".join(parts)\\n461\\t\\n462\\t\\n463\\tBUILD_ALLOWED_TOOLS = [\\\"Read\\\", \\\"Edit\\\", \\\"Write\\\", \\\"Bash\\\"]\\n464\\t\\n465\\t# Item 229's third attempt: 2,754 s and $6.54 to write the right change and\\n466\\t# be refused at the gate for one path the spec's Claims did not name. The\\n467\\t# gate stays the law, but the boundary is told at the edit: the build's\\n468\\t# Edit and Write are allowed on the claimed paths only, as permission\\n469\\t# rules built from the spec's own Claims list, so an edit outside them is\\n470\\t# refused by the tool at the moment it is tried and the executor's recourse\\n471\\t# is the one it has for anything outside the spec -- a question.\\n472\\tBUILD_FIXED_TOOLS = [\\\"Read\\\", \\\"Bash\\\"]\\n473\\t\\n474\\t\\n475\\tdef claimed_paths() -> list[str]:\\n476\\t    \\\"\\\"\\\"The spec's Claims, one path or glob per line under '## Claims', as\\n477\\t    the spec contract writes them (attavo/spec.py's parse_spec reads the\\n478\\t    same lines).\\\"\\\"\\\"\\n479\\t    spec_dir = os.environ.get(\\\"ATTAVO_SPEC_DIR\\\")\\n480\\t    if not spec_dir:\\n481\\t        return []\\n482\\t    try:\\n483\\t        lines = (Path(spec_dir) / \\\"spec.md\\\").read_text().splitlines()\\n484\\t    except OSError:\\n485\\t        return []\\n486\\t    claims: list[str] = []\\n487\\t    inside = False\\n488\\t    for line in lines:\\n489\\t        if line.startswith(\\\"## \\\"):\\n490\\t            inside = line.strip() == \\\"## Claims\\\"\\n491\\t            continue\\n492\\t        if inside and line.strip().startswith(\\\"- \\\"):\\n493\\t            claims.append(line.strip()[2:].strip())\\n494\\t    return claims\\n495\\t\\n496\\t\\n497\\tdef claim_rule(claim: str) -> str:\\n498\\t    \\\"\\\"\\\"A claim as a permission-rule path: a directory claim (trailing\\n499\\t    slash) covers everything under it.\\\"\\\"\\\"\\n500\\t    return claim + \\\"**\\\" if claim.endswith(\\\"/\\\") else claim\\n501\\t\\n502\\t\\n503\\tdef build_allowed_tools() -> list[str]:\\n504\\t    claims = claimed_paths()\\n505\\t    if not claims:\\n506\\t        return BUILD_ALLOWED_TOOLS\\n507\\t    rules = [f\\\"{tool}({claim_rule(c)})\\\" for c in claims for tool in (\\\"Edit\\\", \\\"Write\\\")]\\n508\\t    return BUILD_FIXED_TOOLS + rules\\n509\\tVERIFY_ALLOWED_TOOLS = [\\\"Read\\\", \\\"Bash\\\"]\\n510\\t\\n511\\t# Issue #88 (class B): both tools the tool's own reply named as a way to\\n512\\t# spawn work that outlives this invocation -- confirmed live against\\n513\\t# `claude 2.1.269` (see module docstring). Named on both stages: verify's\\n514\\t# own allowed tools never included either, and did not stop the\\n515\\t# specimen either.\\n516\\tSUBAGENT_TOOLS = [\\\"Agent\\\", \\\"Workflow\\\"]\\n517\\t\\n518\\t# Items 227 and 229: the executor started `attavo test` in the background,\\n519\\t# loaded Monitor to tail its output file, scheduled wakeups to wait for it,\\n520\\t# and on 227 answered done while the wait was still open. Both let the\\n521\\t# invocation outlive its own answer, the same reason the subagent tools\\n522\\t# are denied.\\n523\\tOUTLIVING_TOOLS = [\\\"Monitor\\\", \\\"ScheduleWakeup\\\"]\\n524\\t\\n525\\t# The raw test runner and the product's transport are not the executor's\\n526\\t# tools: `attavo test` is the one test command (issue #212) and the pass\\n527\\t# is the one transport. Permission-rule patterns, prefix-matched by the\\n528\\t# tool; the product refuses its transport on its own account too\\n529\\t# (ATTAVO_STAGE), so the second half here is belt beside braces.\\n530\\tDENIED_COMMANDS = [\\\"Bash(pytest:*)\\\", \\\"Bash(python3 -m pytest:*)\\\", \\\"Bash(python -m pytest:*)\\\",\\n531\\t                   \\\"Bash(npm test:*)\\\", \\\"Bash(npx vitest:*)\\\", \\\"Bash(go test:*)\\\", \\\"Bash(cargo test:*)\\\",\\n532\\t                   \\\"Bash(attavo drive:*)\\\", \\\"Bash(attavo worker:*)\\\"]\\n533\\t\\n534\\t\\n535\\tdef load_config() -> dict:\\n536\\t    raw = os.environ.get(\\\"ATTAVO_ADAPTER_CONFIG\\\")\\n537\\t    return json.loads(raw) if raw else {}\\n538\\t\\n539\\t\\n540\\tdef refused_config_key(config: dict) -> str | None:\\n541\\t    \\\"\\\"\\\"None if config carries no retired key; else the refusal message.\\n542\\t    allowed_tools (issue #78) is retired, not ignored: the sandbox is the\\n543\\t    boundary now, a curated Bash(...) prefix list is not, and a manifest\\n544\\t    still naming it must be refused rather than silently accepted.\\\"\\\"\\\"\\n545\\t    if \\\"allowed_tools\\\" in config:\\n546\\t        return (\\\"[executor.claude-code].allowed_tools is retired (issue \\\"\\n547\\t                \\\"#78) -- the sandbox is the boundary now, not a curated \\\"\\n548\\t                \\\"Bash(...) prefix list\\\")\\n549\\t    return None\\n550\\t\\n551\\t\\n552\\t# Issue #93: claude code publishes no numeric input-size ceiling\\n553\\t# anywhere in its own surface (--help, docs, or any config file,\\n554\\t# confirmed against claude 2.1.269) -- unlike codex's documented\\n555\\t# input_too_large. This adapter asserts its own instruction stays under\\n556\\t# a fixed bound instead of a tool-documented one, so an undeclared tool\\n557\\t# still cannot be handed an unbounded prompt.\\n558\\tFIXED_BOUND_CHARS = 65_536\\n559\\t\\n560\\t\\n561\\tdef input_limit_chars() -> int:\\n562\\t    \\\"\\\"\\\"The bound this adapter enforces in place of a declared ceiling.\\n563\\t    Overridable only for tests via ATTAVO_ADAPTER_INPUT_LIMIT_CHARS --\\n564\\t    never a tenant knob: the ceiling is a fact about the tool, not\\n565\\t    something [executor.claude-code] can set.\\\"\\\"\\\"\\n566\\t    override = os.environ.get(\\\"ATTAVO_ADAPTER_INPUT_LIMIT_CHARS\\\")\\n567\\t    return int(override) if override else FIXED_BOUND_CHARS\\n568\\t\\n569\\t\\n570\\tdef ceiling_refusal(instruction: str) -> str | None:\\n571\\t    \\\"\\\"\\\"None if instruction stays at or under the fixed bound; else the\\n572\\t    refusal naming both numbers, checked before claude is ever invoked.\\\"\\\"\\\"\\n573\\t    limit = input_limit_chars()\\n574\\t    size = len(instruction)\\n575\\t    if size <= limit:\\n576\\t        return None\\n577\\t    return (f\\\"ceiling exceeded -- instruction is {size} chars, over \\\"\\n578\\t           f\\\"the fixed bound of {limit} chars (claude code declares no \\\"\\n579\\t           f\\\"input limit of its own)\\\")\\n580\\t\\n581\\t\\n582\\tREAD_ONLY_STAGES = (\\\"verify\\\", \\\"counsel\\\")\\n583\\t\\n584\\t\\n585\\tdef sandbox_settings(stage: str, working_directory: Path) -> dict:\\n586\\t    \\\"\\\"\\\"Every Bash command and its children stay confined to\\n587\\t    working_directory (writes) and the network stays closed for every\\n588\\t    stage (issue #78) -- confirmed live, not assumed. verify and counsel\\n589\\t    (issue #100) additionally deny writes to working_directory itself,\\n590\\t    making \\\"make no edits, write no files\\\" mechanical rather than merely\\n591\\t    instructed -- counsel is a read-only invocation, the same sandbox\\n592\\t    verify runs under.\\n593\\t    \\\"\\\"\\\"\\n594\\t    sandbox = {\\n595\\t        \\\"enabled\\\": True,\\n596\\t        \\\"allowUnsandboxedCommands\\\": False,\\n597\\t        \\\"network\\\": {\\\"allowedDomains\\\": []},\\n598\\t    }\\n599\\t    if stage in READ_ONLY_STAGES:\\n600\\t        sandbox[\\\"filesystem\\\"] = {\\\"denyWrite\\\": [str(working_directory)]}\\n601\\t    return {\\\"sandbox\\\": sandbox}\\n602\\t\\n603\\t\\n604\\t# Items 227 and 229: Claude Code's Bash foreground is two minutes while one\\n605\\t# test call is [tests].call_timeout_s (240), so the executor wrapped runs in\\n606\\t# `timeout N` and backgrounded them. The product exports that bound as\\n607\\t# ATTAVO_TEST_TIMEOUT_S; the foreground is set to fit one run plus a margin.\\n608\\tFOREGROUND_MARGIN_S = 60\\n609\\t\\n610\\t\\n611\\tdef foreground_env() -> dict[str, str]:\\n612\\t    \\\"\\\"\\\"The variables this adapter sets itself for its executor: the Bash\\n613\\t    foreground and its ceiling, from ATTAVO_TEST_TIMEOUT_S. None when no\\n614\\t    bound was exported.\\\"\\\"\\\"\\n615\\t    bound = os.environ.get(\\\"ATTAVO_TEST_TIMEOUT_S\\\")\\n616\\t    if not bound:\\n617\\t        return {}\\n618\\t    try:\\n619\\t        millis = str((int(bound) + FOREGROUND_MARGIN_S) * 1000)\\n620\\t    except ValueError:\\n621\\t        return {}\\n622\\t    return {\\\"BASH_DEFAULT_TIMEOUT_MS\\\": millis, \\\"BASH_MAX_TIMEOUT_MS\\\": millis}\\n623\\t\\n624\\t\\n625\\tdef build_command(instruction: str, config: dict, schema: dict, stage: str) -> list[str]:\\n626\\t    auth = config.get(\\\"auth\\\", \\\"api\\\")\\n627\\t    allowed_tools = VERIFY_ALLOWED_TOOLS if stage in READ_ONLY_STAGES else build_allowed_tools()\\n628\\t    # acceptEdits approves every edit before an allow rule is consulted;\\n629\\t    # with claimed-path rules in force the mode is default, so a claimed\\n630\\t    # edit is approved by its rule and an unclaimed one asks -- and a\\n631\\t    # headless -p run answers no. The tenant may still set the mode.\\n632\\t    claimed_rules = stage not in READ_ONLY_STAGES and allowed_tools is not BUILD_ALLOWED_TOOLS\\n633\\t    permission_mode = config.get(\\\"permission_mode\\\", \\\"default\\\" if claimed_rules else \\\"acceptEdits\\\")\\n634\\t\\n635\\t    cmd = [\\\"claude\\\"]\\n636\\t    if auth == \\\"subscription\\\":\\n637\\t        # no --bare: this is the tenant's own login, not a bare API key, so\\n638\\t        # the tenant's project hooks and MCP servers must not load -- only\\n639\\t        # --setting-sources (CLAUDE.md still loads) and --strict-mcp-config\\n640\\t        # keep them out, the same isolation --bare gives in api mode.\\n641\\t        setting_sources = config.get(\\\"setting_sources\\\", \\\"user\\\")\\n642\\t        cmd += [\\\"--setting-sources\\\", setting_sources, \\\"--strict-mcp-config\\\"]\\n643\\t    else:\\n644\\t        cmd += [\\\"--bare\\\"]\\n645\\t    cmd += [\\\"--settings\\\", json.dumps(sandbox_settings(stage, Path.cwd()))]\\n646\\t    cmd += [\\\"-p\\\", instruction,\\n647\\t           \\\"--output-format\\\", \\\"stream-json\\\", \\\"--verbose\\\",\\n648\\t           \\\"--json-schema\\\", json.dumps(schema),\\n649\\t           \\\"--permission-mode\\\", permission_mode,\\n650\\t           \\\"--allowedTools\\\", \\\",\\\".join(allowed_tools),\\n651\\t           \\\"--disallowedTools\\\", \\\",\\\".join(SUBAGENT_TOOLS + OUTLIVING_TOOLS + DENIED_COMMANDS)]\\n652\\t    model = config.get(\\\"model\\\")\\n653\\t    if model:\\n654\\t        cmd += [\\\"--model\\\", model]\\n655\\t    return cmd\\n656\\t\\n657\\t\\n658\\tdef derive_model(response: dict, requested_model: str | None) -> tuple[str | None, str | None]:\\n659\\t    \\\"\\\"\\\"(model, model_version). --output-format json carries no top-level\\n660\\t    \\\"model\\\" field; modelUsage is the per-model cost/usage breakdown, keyed\\n661\\t    by a dated id (e.g. \\\"claude-haiku-4-5-20251001\\\") whose own\\n662\\t    \\\"canonicalModel\\\" entry is the short name (e.g. \\\"claude-haiku-4-5\\\").\\n663\\t\\n664\\t    When a model was requested (issue #77), it is trusted verbatim as\\n665\\t    model rather than picked out of modelUsage: a lightweight helper\\n666\\t    model's few thousand uncached tokens must not outrank a primary\\n667\\t    model whose real weight is almost entirely cached reads, which a\\n668\\t    token-count comparison cannot tell apart from a model that barely\\n669\\t    ran. model_version is the modelUsage key whose canonicalModel matches\\n670\\t    the requested model -- the dated id the tool actually ran -- or None\\n671\\t    when no key matches.\\n672\\t\\n673\\t    When no model was requested, the modelUsage key with the largest\\n674\\t    total of inputTokens + cacheReadInputTokens + cacheCreationInputTokens\\n675\\t    + outputTokens is the model that did the work; cache tokens count\\n676\\t    here for the same reason they must not be left out of a requested\\n677\\t    model's tokens.input (below).\\n678\\t    \\\"\\\"\\\"\\n679\\t    model_usage = response.get(\\\"modelUsage\\\") or {}\\n680\\t\\n681\\t    if requested_model:\\n682\\t        model_version = next(\\n683\\t            (key for key, entry in model_usage.items()\\n684\\t             if entry.get(\\\"canonicalModel\\\") == requested_model),\\n685\\t            None)\\n686\\t        return requested_model, model_version\\n687\\t\\n688\\t    if not model_usage:\\n689\\t        return None, None\\n690\\t\\n691\\t    def total_tokens(key: str) -> int:\\n692\\t        entry = model_usage[key]\\n693\\t        return ((entry.get(\\\"inputTokens\\\", 0) or 0)\\n694\\t                + (entry.get(\\\"cacheReadInputTokens\\\", 0) or 0)\\n695\\t                + (entry.get(\\\"cacheCreationInputTokens\\\", 0) or 0)\\n696\\t                + (entry.get(\\\"outputTokens\\\", 0) or 0))\\n697\\t\\n698\\t    winner = max(model_usage, key=total_tokens)\\n699\\t    return winner, model_usage[winner].get(\\\"canonicalModel\\\")\\n700\\t\\n701\\t\\n702\\tdef adapter_version() -> str:\\n703\\t    try:\\n704\\t        out = subprocess.run([\\\"claude\\\", \\\"--version\\\"], capture_output=True,\\n705\\t                             text=True, check=False)\\n706\\t    except OSError:\\n707\\t        return \\\"\\\"\\n708\\t    return out.stdout.strip()\\n709\\t\\n710\\t\\n711\\tMIN_QUESTION_CHARS = 40\\n712\\t\\n713\\tREINSTRUCTION = (\\n714\\t    \\\"your last answer was a report, not a question; either continue to \\\"\\n715\\t    \\\"done, or ask one question ending in a question mark that names the \\\"\\n716\\t    \\\"spec line or guard you cannot resolve\\\")\\n717\\t\\n718\\t\\n719\\tdef question_class(status: str, question: str | None) -> str:\\n720\\t    \\\"\\\"\\\"\\\"done\\\" (no halt at all), \\\"fail\\\" (a question too short or absent to\\n721\\t    be worth a person's judgment -- MIN_QUESTION_CHARS, unchanged since\\n722\\t    v0.15.0), \\\"report\\\" (long enough but carries no \\\"?\\\" -- issue #88's\\n723\\t    class A, a status update in the question channel), or \\\"question\\\" (a\\n724\\t    real question).\\\"\\\"\\\"\\n725\\t    if status != \\\"question\\\":\\n726\\t        return \\\"done\\\"\\n727\\t    if not question or len(question) < MIN_QUESTION_CHARS:\\n728\\t        # An absent or too-short question is a report with nothing in\\n729\\t        # it: a status update in the question channel (issue #150, three\\n730\\t        # specimens on 2026-09-17), never an exit with no report line.\\n731\\t        return \\\"report\\\"\\n732\\t    if \\\"?\\\" not in question:\\n733\\t        return \\\"report\\\"\\n734\\t    return \\\"question\\\"\\n735\\t\\n736\\t\\n737\\t# R3: a vendor's capacity, rate, or 5xx refusal is transient -- classed on\\n738\\t# this adapter's own report line, the same way non-question already is\\n739\\t# (issue #88), so a pass retries it plainly instead of paying for a\\n740\\t# counsel run on a stop the definition of done never touches (#194's own\\n741\\t# verify-01, closed by the item this adapter now serves).\\n742\\tTRANSIENT_MARKERS = (\\\"overloaded\\\", \\\"rate limit\\\", \\\"rate_limit\\\", \\\"429\\\", \\\"500\\\", \\\"502\\\", \\\"503\\\", \\\"529\\\",\\n743\\t                    \\\"internal server error\\\", \\\"service unavailable\\\", \\\"temporarily unavailable\\\")\\n744\\t\\n745\\t\\n746\\tdef transient_detail(response: dict) -> str | None:\\n747\\t    \\\"\\\"\\\"response.get(\\\"result\\\")'s own text when is_error and it names one of\\n748\\t    TRANSIENT_MARKERS; else None -- an is_error for any other reason (an\\n749\\t    auth mismatch, a malformed request) is not this.\\\"\\\"\\\"\\n750\\t    if not response.get(\\\"is_error\\\"):\\n751\\t        return None\\n752\\t    text = str(response.get(\\\"result\\\") or \\\"\\\")\\n753\\t    low = text.lower()\\n754\\t    return text if any(marker in low for marker in TRANSIENT_MARKERS) else None\\n755\\t\\n756\\t\\n757\\tdef subagent_refusal(response: dict) -> str | None:\\n758\\t    \\\"\\\"\\\"None if response carries no spawned background work; else the\\n759\\t    refusal naming the counts (issue #88, class B). Checked on the\\n760\\t    response itself, not the flag that was supposed to forbid it --\\n761\\t    tenant zero's specimen spawned three with the tool absent from\\n762\\t    --allowedTools entirely, so the flag alone is not the mechanism.\\\"\\\"\\\"\\n763\\t    stats = response.get(\\\"subagent_stats\\\") or {}\\n764\\t    spawned = stats.get(\\\"spawned\\\") or 0\\n765\\t    if not spawned:\\n766\\t        return None\\n767\\t    killed = stats.get(\\\"killed\\\") or {}\\n768\\t    killed_total = sum(v or 0 for v in killed.values())\\n769\\t    return (\\n770\\t        f\\\"adapters/claude-code/run: refused: subagent_stats.spawned={spawned} \\\"\\n771\\t        f\\\"-- the {' or '.join(SUBAGENT_TOOLS)} tool spawned work that can \\\"\\n772\\t        f\\\"outlive this invocation (completed={stats.get('completed', 0)}, \\\"\\n773\\t        f\\\"killed={killed_total}, \\\"\\n774\\t        f\\\"started_in_background={stats.get('started_in_background', 0)})\\\")\\n775\\t\\n776\\t\\n777\\tdef load_canned_responses() -> list[dict] | None:\\n778\\t    \\\"\\\"\\\"None when ATTAVO_ADAPTER_RESPONSE_FILE is unset. Otherwise the\\n779\\t    queue this run answers from: a single object repeats for every\\n780\\t    invocation this adapter makes (unchanged since v0.3.0 -- most tests\\n781\\t    make exactly one), a JSON array is consumed in order, one response\\n782\\t    per invocation, its last element repeating once exhausted (issue\\n783\\t    #88: the non-question retry is a second invocation inside the same\\n784\\t    adapter run, and a canned test needs to hand it a different answer\\n785\\t    than the first). Distinct from ATTAVO_ADAPTER_STREAM_FILE below: a\\n786\\t    canned response here is the final report object itself, the shape\\n787\\t    the model-derivation and report-field tests exercise, never a stream\\n788\\t    to map -- unaffected by --output-format actually being stream-json\\n789\\t    on a real invocation.\\\"\\\"\\\"\\n790\\t    response_file = os.environ.get(\\\"ATTAVO_ADAPTER_RESPONSE_FILE\\\")\\n791\\t    if not response_file:\\n792\\t        return None\\n793\\t    raw = json.loads(Path(response_file).read_text())\\n794\\t    return raw if isinstance(raw, list) else [raw]\\n795\\t\\n796\\t\\n797\\tdef load_canned_stream() -> list[str] | None:\\n798\\t    \\\"\\\"\\\"None when ATTAVO_ADAPTER_STREAM_FILE is unset. Otherwise a\\n799\\t    recorded `claude --output-format stream-json --verbose` transcript,\\n800\\t    one JSONL line per list entry (issue #26, acceptance row 3) -- fed\\n801\\t    through the same line-by-line mapping and terminal \\\"result\\\" read a\\n802\\t    real invocation gets, so the mapping is exercised without a live\\n803\\t    `claude` process.\\\"\\\"\\\"\\n804\\t    stream_file = os.environ.get(\\\"ATTAVO_ADAPTER_STREAM_FILE\\\")\\n805\\t    if not stream_file:\\n806\\t        return None\\n807\\t    return Path(stream_file).read_text().splitlines()\\n808\\t\\n809\\t\\n810\\tdef parse_stream_line(line: str) -> dict | None:\\n811\\t    \\\"\\\"\\\"One parsed JSONL line, or None when it is blank or not JSON -- a\\n812\\t    tracing line on the same stream is not an error, just not an event\\n813\\t    (codex's own parse_events does the same).\\\"\\\"\\\"\\n814\\t    line = line.strip()\\n815\\t    if not line:\\n816\\t        return None\\n817\\t    try:\\n818\\t        return json.loads(line)\\n819\\t    except ValueError:\\n820\\t        return None\\n821\\t\\n822\\t\\n823\\tdef first_string_arg(tool_input: dict | None) -> str:\\n824\\t    \\\"\\\"\\\"The first string-valued argument of a tool_use block's input, in\\n825\\t    declaration order -- a file path or a command, the one value worth a\\n826\\t    feed line; a tool whose arguments are all non-string (booleans,\\n827\\t    numbers) reports \\\"\\\" rather than guess which one matters.\\\"\\\"\\\"\\n828\\t    for value in (tool_input or {}).values():\\n829\\t        if isinstance(value, str):\\n830\\t            return value\\n831\\t    return \\\"\\\"\\n832\\t\\n833\\t\\n834\\tdef tool_result_content_text(content) -> str:\\n835\\t    \\\"\\\"\\\"A tool_result block's own text, whichever of claude code's two\\n836\\t    content shapes it carries: a bare string, or a list of {\\\"type\\\":\\n837\\t    \\\"text\\\", \\\"text\\\": ...} blocks (an image or other non-text block\\n838\\t    contributes nothing -- there is no line of text to render).\\\"\\\"\\\"\\n839\\t    if isinstance(content, str):\\n840\\t        return content\\n841\\t    if isinstance(content, list):\\n842\\t        return \\\"\\\\n\\\".join(b.get(\\\"text\\\", \\\"\\\") for b in content\\n843\\t                         if isinstance(b, dict) and b.get(\\\"type\\\") == \\\"text\\\")\\n844\\t    return \\\"\\\"\\n845\\t\\n846\\t\\n847\\tdef stream_line_events(obj: dict) -> list[tuple[str, str]]:\\n848\\t    \\\"\\\"\\\"[(kind, text), ...] for one parsed stream-json line -- zero, one,\\n849\\t    or several (one assistant turn can carry a text block and a tool_use\\n850\\t    block together, each its own event). An assistant message's text\\n851\\t    block maps to \\\"message\\\", its tool_use blocks to \\\"tool_call\\\" (the\\n852\\t    tool's name and its first string argument); a user message carrying\\n853\\t    a tool_result block maps to \\\"tool_result\\\" (the result's own first\\n854\\t    line). Everything else on the stream -- system, and \\\"result\\\" itself,\\n855\\t    read separately for the report fields rather than rendered as a feed\\n856\\t    line -- maps to nothing.\\\"\\\"\\\"\\n857\\t    events: list[tuple[str, str]] = []\\n858\\t    # The stream is the executor's; its shapes are not the adapter's to\\n859\\t    # assume. A line whose message is not an object (a diagnostic with a\\n860\\t    # string message, attavo/attavo#151 build-02) maps to nothing and\\n861\\t    # stays transcript; nothing here raises on a shape it did not expect.\\n862\\t    message = obj.get(\\\"message\\\")\\n863\\t    if not isinstance(message, dict):\\n864\\t        return events\\n865\\t    content = message.get(\\\"content\\\") or []\\n866\\t    if not isinstance(content, list):\\n867\\t        return events\\n868\\t    if obj.get(\\\"type\\\") == \\\"assistant\\\":\\n869\\t        for block in content:\\n870\\t            if not isinstance(block, dict):\\n871\\t                continue\\n872\\t            if block.get(\\\"type\\\") == \\\"text\\\" and block.get(\\\"text\\\"):\\n873\\t                events.append((\\\"message\\\", block[\\\"text\\\"]))\\n874\\t            elif block.get(\\\"type\\\") == \\\"tool_use\\\":\\n875\\t                name = block.get(\\\"name\\\") or \\\"\\\"\\n876\\t                arg = first_string_arg(block.get(\\\"input\\\"))\\n877\\t                events.append((\\\"tool_call\\\", f\\\"{name} {arg}\\\".strip()))\\n878\\t    elif obj.get(\\\"type\\\") == \\\"user\\\":\\n879\\t        for block in content:\\n880\\t            if isinstance(block, dict) and block.get(\\\"type\\\") == \\\"tool_result\\\":\\n881\\t                text = tool_result_content_text(block.get(\\\"content\\\"))\\n882\\t                first_line = text.splitlines()[0] if text.splitlines() else \\\"\\\"\\n883\\t                events.append((\\\"tool_result\\\", first_line))\\n884\\t    return events\\n885\\t\\n886\\t\\n887\\tEVENT_TEXT_MAX_CHARS = 400\\n888\\t\\n889\\t\\n890\\tdef append_event(events_path: str, kind: str, text: str) -> None:\\n891\\t    \\\"\\\"\\\"One {at, kind, text} JSON line appended to events_path and\\n892\\t    flushed at once -- the same shape and the same open-write-close\\n893\\t    discipline bin/attavo's own append_event uses for its iteration and\\n894\\t    gate events, kept independently here since an adapter is a separate\\n895\\t    process with no import path into the product.\\\"\\\"\\\"\\n896\\t    line = {\\\"at\\\": datetime.now(timezone.utc).strftime(\\\"%Y-%m-%dT%H:%M:%SZ\\\"),\\n897\\t           \\\"kind\\\": kind, \\\"text\\\": \\\" \\\".join(text.split())[:EVENT_TEXT_MAX_CHARS]}\\n898\\t    with open(events_path, \\\"a\\\") as fh:\\n899\\t        fh.write(json.dumps(line) + \\\"\\\\n\\\")\\n900\\t\\n901\\t\\n902\\tdef invoke_stream(cmd: list[str], events_path: str | None, canned_lines: list[str] | None\\n903\\t                  ) -> tuple[str, dict | None, int]:\\n904\\t    \\\"\\\"\\\"(raw transcript text, the terminal \\\"result\\\" object or None, exit\\n905\\t    code) -- from canned_lines (ATTAVO_ADAPTER_STREAM_FILE) when given,\\n906\\t    else a real `claude --output-format stream-json --verbose`\\n907\\t    invocation, read line by line as it runs (not buffered until the\\n908\\t    process exits) so each mapped event reaches events_path while the\\n909\\t    stage is still in progress. Every raw line reaches the returned\\n910\\t    transcript, mapped or not -- issue #34's guarantee: the evidence is\\n911\\t    what build-NN.log saves, not just what this adapter went on to use.\\n912\\t    \\\"\\\"\\\"\\n913\\t    raw_lines: list[str] = []\\n914\\t    result: dict | None = None\\n915\\t\\n916\\t    def handle(line: str) -> None:\\n917\\t        nonlocal result\\n918\\t        if not line.strip():\\n919\\t            return\\n920\\t        raw_lines.append(line)\\n921\\t        obj = parse_stream_line(line)\\n922\\t        if obj is None:\\n923\\t            return\\n924\\t        if obj.get(\\\"type\\\") == \\\"result\\\":\\n925\\t            result = obj\\n926\\t            return\\n927\\t        if events_path:\\n928\\t            for kind, text in stream_line_events(obj):\\n929\\t                append_event(events_path, kind, text)\\n930\\t\\n931\\t    if canned_lines is not None:\\n932\\t        for line in canned_lines:\\n933\\t            handle(line)\\n934\\t        return \\\"\\\\n\\\".join(raw_lines), result, 0\\n935\\t\\n936\\t    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,\\n937\\t                            env={**executor_env(), **foreground_env()})\\n938\\t    assert proc.stdout is not None\\n939\\t    for line in proc.stdout:\\n940\\t        handle(line.rstrip(\\\"\\\\n\\\"))\\n941\\t    proc.wait()\\n942\\t    stderr = proc.stderr.read() if proc.stderr else \\\"\\\"\\n943\\t    if stderr.strip():\\n944\\t        raw_lines.append(stderr.rstrip(\\\"\\\\n\\\"))\\n945\\t    return \\\"\\\\n\\\".join(raw_lines), result, proc.returncode\\n946\\t\\n947\\t\\n948\\tdef invoke_once(cmd: list[str], responses: list[dict] | None, call_index: int,\\n949\\t                events_path: str | None\\n950\\t                ) -> tuple[int | None, dict | None]:\\n951\\t    \\\"\\\"\\\"(None, response) for a result this adapter goes on to evaluate;\\n952\\t    (exit_code, None) when the call itself must end the adapter right\\n953\\t    away (the underlying tool's own non-zero exit, or a 0 exit whose\\n954\\t    stream carried no terminal \\\"result\\\" line at all). Always prints this\\n955\\t    call's raw transcript to stdout first -- issue #34's guarantee holds\\n956\\t    across a retry too: every raw line the tool produced, not just the\\n957\\t    result this adapter finally reports on, reaches build-NN.log.\\n958\\t    \\\"\\\"\\\"\\n959\\t    if responses is not None:\\n960\\t        response = responses[min(call_index, len(responses) - 1)]\\n961\\t        print(json.dumps(response))\\n962\\t        return None, response\\n963\\t\\n964\\t    raw, result, returncode = invoke_stream(cmd, events_path, load_canned_stream())\\n965\\t    if raw.strip():\\n966\\t        print(raw)\\n967\\t    if returncode != 0:\\n968\\t        return returncode, None\\n969\\t    if result is None:\\n970\\t        return 1, None\\n971\\t    return None, result\\n972\\t\\n973\\t\\n974\\tdef usage_fields(response: dict) -> tuple[int, int, float | None]:\\n975\\t    \\\"\\\"\\\"(tokens.input, tokens.output, cost_usd) for one response, pulled\\n976\\t    straight off usage/total_cost_usd -- independent of model derivation,\\n977\\t    so a retry's first, discarded call still counts (issue #88: a\\n978\\t    non-question costs two executor turns, and a report line built from\\n979\\t    the second call alone undercounts by exactly the first one).\\\"\\\"\\\"\\n980\\t    usage = response.get(\\\"usage\\\") or {}\\n981\\t    tokens_input = ((usage.get(\\\"input_tokens\\\", 0) or 0)\\n982\\t                    + (usage.get(\\\"cache_read_input_tokens\\\", 0) or 0)\\n983\\t                    + (usage.get(\\\"cache_creation_input_tokens\\\", 0) or 0))\\n984\\t    tokens_output = usage.get(\\\"output_tokens\\\", 0) or 0\\n985\\t    return tokens_input, tokens_output, response.get(\\\"total_cost_usd\\\")\\n986\\t\\n987\\t\\n988\\tdef add_cost(a: float | None, b: float | None) -> float | None:\\n989\\t    \\\"\\\"\\\"None when neither call reported a cost; otherwise the sum,\\n990\\t    treating an absent figure as 0 -- mirrors bin/attavo's own\\n991\\t    cost_usd accumulation across build iterations.\\\"\\\"\\\"\\n992\\t    if a is None and b is None:\\n993\\t        return None\\n994\\t    return (a or 0) + (b or 0)\\n995\\t\\n996\\t\\n997\\tdef report_fields(response: dict, requested_model: str | None) -> dict | None:\\n998\\t    \\\"\\\"\\\"The fields common to every final report line, derived from one\\n999\\t    tool response; None when no model id can be derived at all (the\\n1000\\t    caller must fail loudly rather than emit a report with no identity\\n1001\\t    behind it).\\\"\\\"\\\"\\n1002\\t    model, model_version = derive_model(response, requested_model)\\n1003\\t    if not model:\\n1004\\t        sys.stderr.write(\\n1005\\t            \\\"adapters/claude-code/run: could not derive a model id -- the \\\"\\n1006\\t            \\\"response carried no requested model and an empty \\\"\\n1007\\t            \\\"'modelUsage'\\\\n\\\")\\n1008\\t        return None\\n1009\\t    if requested_model and response.get(\\\"modelUsage\\\") and not model_version:\\n1010\\t        sys.stderr.write(\\n1011\\t            f\\\"adapters/claude-code/run: requested model {requested_model!r} \\\"\\n1012\\t            \\\"matches no modelUsage canonicalModel -- model_version left \\\"\\n1013\\t            \\\"null\\\\n\\\")\\n1014\\t\\n1015\\t    tokens_input, tokens_output, cost = usage_fields(response)\\n1016\\t    return {\\n1017\\t        \\\"model\\\": model,\\n1018\\t        \\\"model_version\\\": model_version,\\n1019\\t        \\\"adapter_version\\\": adapter_version(),\\n1020\\t        \\\"tokens\\\": {\\\"input\\\": tokens_input, \\\"output\\\": tokens_output},\\n1021\\t        \\\"cost_usd\\\": cost,\\n1022\\t    }\\n1023\\t\\n1024\\t\\n1025\\tdef main() -> int:\\n1026\\t    config = load_config()\\n1027\\t    refusal = refused_config_key(config)\\n1028\\t    if refusal:\\n1029\\t        sys.stderr.write(f\\\"adapters/claude-code/run: refused: {refusal}\\\\n\\\")\\n1030\\t        return 1\\n1031\\t\\n1032\\t    stage = os.environ.get(\\\"ATTAVO_STAGE\\\") or \\\"build\\\"\\n1033\\t    if stage not in (\\\"build\\\", \\\"verify\\\", \\\"counsel\\\"):\\n1034\\t        stage = \\\"build\\\"\\n1035\\t    verifying = stage == \\\"verify\\\"\\n1036\\t    counseling = stage == \\\"counsel\\\"\\n1037\\t    if verifying:\\n1038\\t        instruction, schema = verify_instruction(), VERIFY_SCHEMA\\n1039\\t    elif counseling:\\n1040\\t        instruction, schema = counsel_instruction(), COUNSEL_SCHEMA\\n1041\\t    else:\\n1042\\t        instruction, schema = build_instruction(), STATUS_SCHEMA\\n1043\\t    cmd = build_command(instruction, config, schema, stage)\\n1044\\t\\n1045\\t    ceiling = ceiling_refusal(instruction)\\n1046\\t    if ceiling:\\n1047\\t        sys.stderr.write(f\\\"adapters/claude-code/run: refused: {ceiling}\\\\n\\\")\\n1048\\t        # Reported, not left for the product to find in the words: nothing\\n1049\\t        # was invoked, so no adapter version and no tokens.\\n1050\\t        print(json.dumps({\\\"model\\\": config.get(\\\"model\\\"), \\\"model_version\\\": None,\\n1051\\t                          \\\"adapter_version\\\": None, \\\"tokens\\\": {\\\"input\\\": 0, \\\"output\\\": 0},\\n1052\\t                          \\\"cost_usd\\\": None, \\\"class\\\": \\\"ceiling\\\", \\\"detail\\\": ceiling}))\\n1053\\t        return 1\\n1054\\t\\n1055\\t    if os.environ.get(\\\"ATTAVO_ADAPTER_DRY_RUN\\\"):\\n1056\\t        # {\\\"argv\\\", \\\"instruction\\\", \\\"schema\\\", \\\"env\\\"}, not a bare argv list: the\\n1057\\t        # instruction lives in argv's own \\\"-p\\\" value here, but a second\\n1058\\t        # adapter (issue #41) can deliver it on stdin instead, where\\n1059\\t        # argv carries no instruction at all -- the envelope is what\\n1060\\t        # stays adapter-agnostic for tests/test_executor_conformance.py.\\n1061\\t        print(json.dumps({\\\"argv\\\": cmd, \\\"instruction\\\": instruction, \\\"schema\\\": schema,\\n1062\\t                          \\\"env\\\": foreground_env()}))\\n1063\\t        return 0\\n1064\\t\\n1065\\t    responses = load_canned_responses()\\n1066\\t    events_path = os.environ.get(\\\"ATTAVO_EVENTS\\\")\\n1067\\t\\n1068\\t    exit_code, response = invoke_once(cmd, responses, 0, events_path)\\n1069\\t    if exit_code is not None:\\n1070\\t        return exit_code\\n1071\\t\\n1072\\t    # An error dressed as a question still costs a ruling act. Treat both\\n1073\\t    # the same way build already treats a non-zero adapter exit: failed,\\n1074\\t    # not a halt someone must rule on. Stage-independent: a tool error or\\n1075\\t    # an absent report is a failure whether this is a build or a verify.\\n1076\\t    if response.get(\\\"is_error\\\") or not response.get(\\\"structured_output\\\"):\\n1077\\t        detail = transient_detail(response)\\n1078\\t        if detail:\\n1079\\t            common = report_fields(response, config.get(\\\"model\\\"))\\n1080\\t            if common is not None:\\n1081\\t                print(json.dumps({**common, \\\"class\\\": \\\"transient\\\", \\\"detail\\\": detail}))\\n1082\\t        return 1\\n1083\\t\\n1084\\t    refusal = subagent_refusal(response)\\n1085\\t    if refusal:\\n1086\\t        sys.stderr.write(refusal + \\\"\\\\n\\\")\\n1087\\t        return 1\\n1088\\t\\n1089\\t    structured = response.get(\\\"structured_output\\\") or {}\\n1090\\t\\n1091\\t    if verifying:\\n1092\\t        common = report_fields(response, config.get(\\\"model\\\"))\\n1093\\t        if common is None:\\n1094\\t            return 1\\n1095\\t        # .get(), not \\\"or []\\\": an absent findings key must reach\\n1096\\t        # cmd_verify as None, distinct from an explicit empty list --\\n1097\\t        # that distinction is the whole fix for issue #46.\\n1098\\t        line = {**common,\\n1099\\t               \\\"findings\\\": structured.get(\\\"findings\\\"),\\n1100\\t               \\\"tests_named\\\": structured.get(\\\"tests_named\\\")}\\n1101\\t        print(json.dumps(line))\\n1102\\t        return 0\\n1103\\t\\n1104\\t    if counseling:\\n1105\\t        common = report_fields(response, config.get(\\\"model\\\"))\\n1106\\t        if common is None:\\n1107\\t            return 1\\n1108\\t        line = {**common,\\n1109\\t               \\\"class\\\": structured.get(\\\"class\\\"),\\n1110\\t               \\\"verdict\\\": structured.get(\\\"verdict\\\"),\\n1111\\t               \\\"citations\\\": structured.get(\\\"citations\\\"),\\n1112\\t               \\\"proposal\\\": structured.get(\\\"proposal\\\")}\\n1113\\t        print(json.dumps(line))\\n1114\\t        return 0\\n1115\\t\\n1116\\t    status = structured.get(\\\"status\\\", \\\"done\\\")\\n1117\\t    question = structured.get(\\\"question\\\")\\n1118\\t    cls = question_class(status, question)\\n1119\\t\\n1120\\t    if cls == \\\"fail\\\":\\n1121\\t        return 1\\n1122\\t\\n1123\\t    if cls == \\\"report\\\":\\n1124\\t        # Issue #88, class A: a report in the question channel is\\n1125\\t        # re-instructed once, in this same invocation, before it ever\\n1126\\t        # reaches a person.\\n1127\\t        reinstruction = instruction + \\\"\\\\n\\\\n\\\" + REINSTRUCTION\\n1128\\t        cmd2 = build_command(reinstruction, config, schema, stage)\\n1129\\t        exit_code2, response2 = invoke_once(cmd2, responses, 1, events_path)\\n1130\\t        if exit_code2 is not None:\\n1131\\t            return exit_code2\\n1132\\t        if response2.get(\\\"is_error\\\") or not response2.get(\\\"structured_output\\\"):\\n1133\\t            return 1\\n1134\\t        refusal2 = subagent_refusal(response2)\\n1135\\t        if refusal2:\\n1136\\t            sys.stderr.write(refusal2 + \\\"\\\\n\\\")\\n1137\\t            return 1\\n1138\\t\\n1139\\t        structured2 = response2.get(\\\"structured_output\\\") or {}\\n1140\\t        status2 = structured2.get(\\\"status\\\", \\\"done\\\")\\n1141\\t        question2 = structured2.get(\\\"question\\\")\\n1142\\t        cls2 = question_class(status2, question2)\\n1143\\t        if cls2 == \\\"fail\\\":\\n1144\\t            return 1\\n1145\\t\\n1146\\t        common2 = report_fields(response2, config.get(\\\"model\\\"))\\n1147\\t        if common2 is None:\\n1148\\t            return 1\\n1149\\t        # A non-question costs two executor turns, not one: sum both\\n1150\\t        # calls' tokens and cost into the one report line this\\n1151\\t        # invocation gets, whatever the retry's own outcome -- only\\n1152\\t        # adapter_version/model/model_version stay the second call's.\\n1153\\t        tokens1_input, tokens1_output, cost1 = usage_fields(response)\\n1154\\t        common2[\\\"tokens\\\"][\\\"input\\\"] += tokens1_input\\n1155\\t        common2[\\\"tokens\\\"][\\\"output\\\"] += tokens1_output\\n1156\\t        common2[\\\"cost_usd\\\"] = add_cost(common2[\\\"cost_usd\\\"], cost1)\\n1157\\t\\n1158\\t        if cls2 == \\\"report\\\":\\n1159\\t            # Two reports in a row: still a halt (someone must look),\\n1160\\t            # but the transcript above already carries both raw\\n1161\\t            # results, and this report line names the class so a\\n1162\\t            # reader -- or a future record field, not this one -- can\\n1163\\t            # tell it apart from a genuine question.\\n1164\\t            print(\\\"adapters/claude-code/run: halted: class non-question \\\"\\n1165\\t                  \\\"-- the executor reported instead of asking, twice in \\\"\\n1166\\t                  \\\"a row\\\")\\n1167\\t            line = {**common2, \\\"status\\\": \\\"question\\\", \\\"question\\\": question2,\\n1168\\t                   \\\"class\\\": \\\"non-question\\\"}\\n1169\\t            print(json.dumps(line))\\n1170\\t            return 0\\n1171\\t\\n1172\\t        line = {**common2, \\\"status\\\": status2, \\\"question\\\": question2}\\n1173\\t        print(json.dumps(line))\\n1174\\t        return 0\\n1175\\t\\n1176\\t    common = report_fields(response, config.get(\\\"model\\\"))\\n1177\\t    if common is None:\\n1178\\t        return 1\\n1179\\t    line = {**common, \\\"status\\\": status, \\\"question\\\": question}\\n1180\\t    print(json.dumps(line))\\n1181\\t    return 0\\n1182\\t\\n1183\\t\\n1184\\tif __name__ == \\\"__main__\\\":\\n1185\\t    sys.exit(main())\\n1186\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"aa97438b-e700-4e9e-85e2-1d5bd8de4b83\",\"uuid\":\"827ca3b3-601d-4b7c-8875-461c8045fa83\",\"timestamp\":\"2026-09-30T02:23:10.652Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/davidbean/Projects/attavo-worktree-288/adapters/claude-code/run\",\"content\":\"#!/usr/bin/env python3\\n\\\"\\\"\\\"adapters/claude-code/run -- see README.md (this directory) for the four\\nconfiguration keys, and ../README.md for the shared adapter contract.\\n\\nA live `claude` invocation is not exercised by the test suite (judgment\\nis measured, not tested); its argument construction is checked by\\nATTAVO_ADAPTER_DRY_RUN=1, which prints the `claude` command line as a\\nJSON array instead of running it, its response handling is checked by\\nATTAVO_ADAPTER_RESPONSE_FILE, which reads a canned final report object\\nfrom a file instead of invoking `claude`, and (issue #26) its\\n`--output-format stream-json --verbose` mapping -- the event stream\\nthis adapter maps to ATTAVO_EVENTS, and the terminal \\\"result\\\" line it\\nreads the report object from -- is checked by ATTAVO_ADAPTER_STREAM_FILE,\\nwhich feeds a recorded transcript instead.\\n\\nThe whole result is printed to stdout before this adapter's own final\\nline, so build-NN.log carries it as the transcript -- a halt otherwise\\ncannot be explained after the fact. is_error or an absent\\nstructured_output exit 1 on either stage; a build status \\\"question\\\"\\nwhose question is missing or under MIN_QUESTION_CHARS characters also\\nexits 1 (build records the attempt as failed) rather than a halt\\nsomeone must rule on.\\n\\nATTAVO_STAGE=verify branches to a different objective, schema, and\\nreport shape (issue #46): the instruction states the verify objective\\n(see verify_instruction) instead of the build one, --json-schema is\\nVERIFY_SCHEMA instead of STATUS_SCHEMA, and the final line carries\\nfindings and tests_named instead of status and question.\\n\\nIssue #78: the boundary is the tool's own sandbox, not a curated\\nallowed_tools list judged per sub-command -- confirmed live (recorded on\\nthe issue, 2026-09-10) against `claude 2.1.268`: `--settings` carrying\\n`{\\\"sandbox\\\": {\\\"enabled\\\": true, \\\"allowUnsandboxedCommands\\\": false}}` under\\n`-p` refuses a write outside the working directory (\\\"operation not\\npermitted\\\") and, with `network.allowedDomains: []`, refuses an outbound\\nconnection (\\\"deny network-outbound ...\\\"), both before `--allowedTools`\\nis ever consulted. build's `--settings` therefore enables the sandbox and\\nforbids the unsandboxed fallback; verify's additionally sets\\n`filesystem.denyWrite` on the working directory itself (confirmed live:\\n`denyWrite` takes a list of paths, not a bare boolean -- `true` alone did\\nnot stop a write inside the directory). `--allowedTools` shrinks to the\\ntool names each stage may use at all -- `Read,Edit,Write,Bash` for build,\\n`Read,Bash` for verify -- since Edit and Write are not Bash and the\\nsandbox does not govern them. `allowed_tools` is retired as a manifest\\nkey: a config that still declares it is refused by name rather than\\nsilently accepted.\\n\\nIssue #88 (class A: a report is not a question). `--json-schema`\\nconstrains the tool's structured_output to \\\"done\\\"/\\\"question\\\", but\\nnothing stops \\\"question\\\" from carrying a status report rather than an\\nactual question -- confirmed against tenant zero's own corpus, five\\nspecimens with no \\\"?\\\" anywhere in the text. A \\\"question\\\" whose text\\nclears MIN_QUESTION_CHARS but contains no \\\"?\\\" is a report, not a\\nquestion: this adapter re-invokes the executor once, appending\\nREINSTRUCTION to the same instruction, before ever reporting a halt to\\na person. A second report in a row still halts (someone must look), but\\nits report line carries \\\"class\\\": \\\"non-question\\\" and both raw results\\nreached stdout above it -- an extra field bin/attavo's own record schema\\ndoes not know about and never has to: it reads \\\"status\\\"/\\\"question\\\" off\\nthis line exactly as before, so a \\\"question\\\" halt still halts. Read via\\nATTAVO_ADAPTER_RESPONSE_FILE, a JSON array is a queue -- one canned\\nresult per invocation this adapter makes, its last element repeating\\nonce exhausted -- while a single object still repeats for every call,\\nunchanged.\\n\\nIssue #88 (class B: work that outlives the invocation). Confirmed live,\\nthis machine, `claude 2.1.269`: with both \\\"Agent\\\" and \\\"Task\\\" allowed, a\\nprompt asking for a subagent produced `subagent_stats.spawned: 1`, `\\\"Agent\\\"`\\nalone in `--disallowedTools` (Task is not a distinct tool in this build)\\nbrought it back to 0 -- the tool's own reply named \\\"Workflow\\\" as the\\nother path to background work, so both are named here. `--allowedTools`\\nis an allow-list a background spawn does not consult (tenant zero's\\nspecimen: `--allowedTools` without \\\"Agent\\\" or \\\"Workflow\\\" in it at all did\\nnot stop three of them), so this adapter also disallows them by name on\\nboth stages and, after the run, refuses by name -- exit 1, not a\\nhalt -- any response whose subagent_stats.spawned is not zero, with the\\ncounts in the message. A tool that reports no subagent_stats at all\\n(spawned absent or 0) is unaffected; this is a refusal on evidence, not a\\nguess from the flag.\\n\\\"\\\"\\\"\\nfrom __future__ import annotations\\n\\nimport json\\nimport os\\nimport subprocess\\nimport sys\\nfrom datetime import datetime, timezone\\nfrom pathlib import Path\\n\\n# the helper beside adapters/, imported without leaving a __pycache__ there\\nsys.dont_write_bytecode = True\\nsys.path.insert(0, str(Path(__file__).resolve().parent.parent))\\nfrom executor_env import executor_env  # noqa: E402\\n\\nSTATUS_SCHEMA = {\\n    \\\"type\\\": \\\"object\\\",\\n    \\\"additionalProperties\\\": False,\\n    \\\"required\\\": [\\\"status\\\", \\\"question\\\"],\\n    \\\"properties\\\": {\\n        \\\"status\\\": {\\\"type\\\": \\\"string\\\", \\\"enum\\\": [\\\"done\\\", \\\"question\\\"]},\\n        \\\"question\\\": {\\\"type\\\": [\\\"string\\\", \\\"null\\\"]},\\n    },\\n}\\n\\n# The verify objective (issue #46): a verifier reports findings, not a\\n# commit. additionalProperties: False means the tool cannot hand back a\\n# structured_output shaped like STATUS_SCHEMA's status/question by\\n# accident -- an absent findings key is what cmd_verify treats as\\n# failed, not a lenient default here.\\nVERIFY_SCHEMA = {\\n    \\\"type\\\": \\\"object\\\",\\n    \\\"additionalProperties\\\": False,\\n    \\\"required\\\": [\\\"findings\\\", \\\"tests_named\\\"],\\n    \\\"properties\\\": {\\n        \\\"findings\\\": {\\n            \\\"type\\\": \\\"array\\\",\\n            \\\"items\\\": {\\n                \\\"type\\\": \\\"object\\\",\\n                \\\"additionalProperties\\\": False,\\n                \\\"required\\\": [\\\"title\\\", \\\"specimen\\\", \\\"retires\\\", \\\"rejection_test\\\", \\\"severity\\\"],\\n                \\\"properties\\\": {\\n                    \\\"title\\\": {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1},\\n                    \\\"specimen\\\": {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1},\\n                    \\\"retires\\\": {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1},\\n                    \\\"rejection_test\\\": {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1},\\n                    \\\"severity\\\": {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1},\\n                },\\n            },\\n        },\\n        \\\"tests_named\\\": {\\\"type\\\": \\\"array\\\", \\\"items\\\": {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1}},\\n    },\\n}\\n\\n# The counsel objective (issue #100): a stop is read inside the product\\n# first, before a person. additionalProperties: False for the same reason\\n# as VERIFY_SCHEMA's own -- the tool cannot hand back a differently-shaped\\n# structured_output by accident.\\nCOUNSEL_SCHEMA = {\\n    \\\"type\\\": \\\"object\\\",\\n    \\\"additionalProperties\\\": False,\\n    \\\"required\\\": [\\\"class\\\", \\\"verdict\\\", \\\"citations\\\", \\\"proposal\\\"],\\n    \\\"properties\\\": {\\n        \\\"class\\\": {\\\"type\\\": \\\"string\\\"},\\n        \\\"verdict\\\": {\\\"type\\\": \\\"string\\\", \\\"enum\\\": [\\\"answer\\\", \\\"patch\\\", \\\"person\\\"]},\\n        \\\"citations\\\": {\\n            \\\"type\\\": \\\"array\\\",\\n            \\\"items\\\": {\\n                \\\"type\\\": \\\"object\\\",\\n                \\\"additionalProperties\\\": False,\\n                \\\"required\\\": [\\\"kind\\\", \\\"path\\\", \\\"symbol\\\", \\\"ruling_id\\\"],\\n                \\\"properties\\\": {\\n                    \\\"kind\\\": {\\\"type\\\": \\\"string\\\", \\\"enum\\\": [\\\"instruction\\\", \\\"mechanism\\\", \\\"guard\\\"]},\\n                    \\\"path\\\": {\\\"type\\\": [\\\"string\\\", \\\"null\\\"]},\\n                    \\\"symbol\\\": {\\\"type\\\": [\\\"string\\\", \\\"null\\\"]},\\n                    \\\"ruling_id\\\": {\\\"type\\\": [\\\"string\\\", \\\"null\\\"]},\\n                },\\n            },\\n        },\\n        \\\"proposal\\\": {\\n            \\\"type\\\": \\\"object\\\",\\n            \\\"additionalProperties\\\": False,\\n            \\\"required\\\": [\\\"ruling_text\\\", \\\"patch\\\", \\\"question\\\", \\\"issue\\\"],\\n            \\\"properties\\\": {\\n                \\\"ruling_text\\\": {\\\"type\\\": [\\\"string\\\", \\\"null\\\"]},\\n                \\\"patch\\\": {\\n                    \\\"type\\\": [\\\"object\\\", \\\"null\\\"],\\n                    \\\"additionalProperties\\\": False,\\n                    \\\"required\\\": [\\\"file\\\", \\\"symbol\\\", \\\"rejection_test\\\", \\\"diff\\\"],\\n                    \\\"properties\\\": {\\n                        \\\"file\\\": {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1},\\n                        \\\"symbol\\\": {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1},\\n                        \\\"rejection_test\\\": {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1},\\n                        \\\"diff\\\": {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1},\\n                    },\\n                },\\n                \\\"question\\\": {\\\"type\\\": [\\\"string\\\", \\\"null\\\"]},\\n                # issue #175: the fourth proposal shape, for a \\\"patch\\\" or\\n                # \\\"person\\\" verdict whose remedy is better filed as an item\\n                # than shipped as a diff or asked as a bare question.\\n                \\\"issue\\\": {\\n                    \\\"type\\\": [\\\"object\\\", \\\"null\\\"],\\n                    \\\"additionalProperties\\\": False,\\n                    \\\"required\\\": [\\\"title\\\", \\\"body\\\"],\\n                    \\\"properties\\\": {\\n                        \\\"title\\\": {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1},\\n                        \\\"body\\\": {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1},\\n                    },\\n                },\\n            },\\n        },\\n    },\\n}\\n\\n\\ndef read_text(path_env: str) -> str:\\n    path = os.environ.get(path_env)\\n    if not path:\\n        return \\\"\\\"\\n    p = Path(path)\\n    return p.read_text() if p.is_file() else \\\"\\\"\\n\\n\\ndef describe_file(path: str, text: str, diff_like: bool) -> str:\\n    \\\"\\\"\\\"Path, byte count, line count, and (for a diff) files touched --\\n    named in the instruction instead of inlining the file's own text, so\\n    the instruction stays a small fixed size whatever the file's size\\n    (issue #86: a 27,367-line deletion diff inlined whole exceeded a\\n    judge's input ceiling -- codex's, on the specimen that surfaced it).\\n    Files touched counts unified-diff file headers (`diff --git a/...\\n    b/...`), the shape `git diff` produces.\\\"\\\"\\\"\\n    size = Path(path).stat().st_size\\n    lines = text.count(\\\"\\\\n\\\") + (1 if text and not text.endswith(\\\"\\\\n\\\") else 0)\\n    if not diff_like:\\n        return f\\\"`{path}` ({size} bytes, {lines} lines)\\\"\\n    files = sum(1 for l in text.splitlines() if l.startswith(\\\"diff --git \\\"))\\n    return f\\\"`{path}` ({size} bytes, {lines} lines, {files} files touched)\\\"\\n\\n\\ndef spec_sections() -> list[str]:\\n    \\\"\\\"\\\"The spec's Problem, Claims, and Criteria sections verbatim -- what\\n    both build and verify need to see, in the shape the spec contract\\n    (not this adapter) already gives them.\\\"\\\"\\\"\\n    spec_dir = Path(os.environ[\\\"ATTAVO_SPEC_DIR\\\"])\\n    lines = (spec_dir / \\\"spec.md\\\").read_text().splitlines()\\n    idx = [i for i, l in enumerate(lines) if l.startswith(\\\"## \\\")]\\n    headings = {lines[i].strip(): i for i in idx}\\n    bounds = sorted(idx) + [len(lines)]\\n\\n    def section(heading: str) -> str:\\n        start = headings[heading]\\n        end = bounds[bounds.index(start) + 1] if start in bounds else len(lines)\\n        return \\\"\\\\n\\\".join(lines[start:end]).strip()\\n\\n    return [section(\\\"## Problem\\\"), section(\\\"## Claims\\\"), section(\\\"## Criteria\\\")]\\n\\n\\ndef stub_note() -> str | None:\\n    \\\"\\\"\\\"None when ATTAVO_SPEC_DIR carries no stub/; else the sentence\\n    naming what a stub is (issue #90, closed by #93). The stub is\\n    evidence -- a criterion it satisfies trivially is weak -- but twice\\n    the judge reported\\n    a built tree as failing to match its stub as if the stub were the\\n    intended change (tenant zero #664, #644): one sentence of vocabulary\\n    was missing, not a smarter judge or a dropped stub.\\\"\\\"\\\"\\n    stub_dir = Path(os.environ[\\\"ATTAVO_SPEC_DIR\\\"]) / \\\"stub\\\"\\n    if not stub_dir.is_dir():\\n        return None\\n    return (\\n        f\\\"## The stub at `{stub_dir}`\\\\n\\\\n\\\"\\n        \\\"The stub is the fixture the acceptance criteria were shown to \\\"\\n        \\\"pass against; it is not the intended change. A difference \\\"\\n        \\\"between the built tree and the stub is not a finding: a \\\"\\n        \\\"criterion the stub satisfies trivially is.\\\")\\n\\n\\ndef build_instruction() -> str:\\n    parts = list(spec_sections())\\n\\n    rulings = read_text(\\\"ATTAVO_RULINGS\\\")\\n    if rulings.strip():\\n        parts.append(\\\"## Rulings\\\\n\\\\n\\\" + rulings.strip())\\n\\n    feedback_path = os.environ.get(\\\"ATTAVO_FEEDBACK\\\")\\n    feedback = read_text(\\\"ATTAVO_FEEDBACK\\\")\\n    if feedback.strip():\\n        parts.append(\\n            \\\"## Feedback from the previous attempt\\\\n\\\\n\\\"\\n            f\\\"The feedback is at {describe_file(feedback_path, feedback, diff_like=False)}. \\\"\\n            \\\"It is not inlined here: read it yourself with your own tools \\\"\\n            \\\"before continuing.\\\")\\n\\n    parts.append(\\n        \\\"commit your work on the current branch; if you cannot proceed \\\"\\n        \\\"without a decision that changes the criteria, do not guess: \\\"\\n        \\\"answer with status question\\\")\\n\\n    test_command = os.environ.get(\\\"ATTAVO_TEST_COMMAND\\\")\\n    if test_command:\\n        bound = os.environ.get(\\\"ATTAVO_TEST_TIMEOUT_S\\\")\\n        parts.append(\\n            f\\\"to run tests while you work, run `{test_command}`: it runs the tests \\\"\\n            \\\"selected for the files you have changed\\\"\\n            + (f\\\" and stops at {bound} s\\\" if bound else \\\"\\\")\\n            + \\\". Run a single test with `\\\" + test_command + \\\" <path or test id>`. \\\"\\n            \\\"Do not run the test runner directly, the whole test suite, or any \\\"\\n            \\\"whole-tree check yourself: when the criteria and \\\" + \\\"`\\\" + test_command + \\\"`\\\"\\n            + \\\" pass, commit and stop; the gates are run for you and any failure is \\\"\\n            \\\"returned to you on the next iteration\\\")\\n\\n    return \\\"\\\\n\\\\n\\\".join(parts)\\n\\n\\ndef verify_instruction() -> str:\\n    parts = list(spec_sections())\\n\\n    note = stub_note()\\n    if note:\\n        parts.append(note)\\n\\n    diff_path = os.environ.get(\\\"ATTAVO_DIFF\\\")\\n    diff = read_text(\\\"ATTAVO_DIFF\\\")\\n    if diff.strip():\\n        parts.append(\\n            \\\"## Diff since the approved spec\\\\n\\\\n\\\"\\n            f\\\"The diff is at {describe_file(diff_path, diff, diff_like=True)}. \\\"\\n            \\\"It is not inlined here: read it yourself with your own tools \\\"\\n            \\\"before judging it.\\\")\\n    else:\\n        parts.append(\\\"## Diff since the approved spec\\\\n\\\\n(the diff is empty)\\\")\\n\\n    build_record_path = os.environ.get(\\\"ATTAVO_BUILD_RECORD\\\")\\n    build_record = read_text(\\\"ATTAVO_BUILD_RECORD\\\")\\n    if build_record.strip():\\n        parts.append(\\n            \\\"## The build record\\\\n\\\\n\\\"\\n            f\\\"The build record is at {describe_file(build_record_path, build_record, diff_like=False)}. \\\"\\n            \\\"Read it yourself with your own tools.\\\")\\n\\n    parts.append(\\n        \\\"you are verifying a completed build, not building: make no edits, \\\"\\n        \\\"write no files, commit nothing. Read the diff named above against \\\"\\n        \\\"the criteria and name what the criteria do not assert but the diff \\\"\\n        \\\"should still be judged on, and name the tests that would assert \\\"\\n        \\\"it if they existed. A spec whose approval commit does not \\\"\\n        \\\"describe the working tree the build produced is itself a \\\"\\n        \\\"finding: the diff is judged against what was approved, and a \\\"\\n        \\\"divergence between them is reportable rather than assumed \\\"\\n        \\\"away. Report each as a finding: title, specimen (the file or \\\"\\n        \\\"commit the finding is about), retires (what having this \\\"\\n        \\\"finding on record replaces or closes -- every finding must \\\"\\n        \\\"carry one, or it is refused unfiled), rejection_test (the test \\\"\\n        \\\"that would catch a regression of it), and severity. Severity \\\"\\n        \\\"is derived rather than judged: the version, counter, \\\"\\n        \\\"condition, or state change that flips a finding from harmless \\\"\\n        \\\"to blocking; an adjective is not a severity. An empty \\\"\\n        \\\"findings list means you looked and found nothing to report, not \\\"\\n        \\\"that you did not look.\\\")\\n    return \\\"\\\\n\\\\n\\\".join(parts)\\n\\n\\ndef counsel_instruction() -> str:\\n    \\\"\\\"\\\"Issue #100 (extended by issue #175): a stop is read inside the\\n    product first, before a person. The record, its log, the diff, the\\n    forge's checks, the item's graph, the tenant manifest, and this\\n    product's own root are all handed by path -- named in the instruction\\n    instead of inlined, the same discipline verify_instruction already\\n    applies to the diff (issue #86), so this instruction's own size stays\\n    fixed whatever the record, log, diff, checks, or graph's size.\\\"\\\"\\\"\\n    parts = list(spec_sections())\\n\\n    rulings = read_text(\\\"ATTAVO_RULINGS\\\")\\n    if rulings.strip():\\n        parts.append(\\\"## Rulings\\\\n\\\\n\\\" + rulings.strip())\\n\\n    note = stub_note()\\n    if note:\\n        parts.append(note)\\n\\n    record_path = os.environ.get(\\\"ATTAVO_COUNSEL_RECORD\\\")\\n    record_text = read_text(\\\"ATTAVO_COUNSEL_RECORD\\\")\\n    if record_text.strip():\\n        parts.append(\\n            \\\"## The stage record\\\\n\\\\n\\\"\\n            f\\\"The record is at {describe_file(record_path, record_text, diff_like=False)}. \\\"\\n            \\\"Read it yourself with your own tools.\\\")\\n\\n    log_path = os.environ.get(\\\"ATTAVO_COUNSEL_LOG\\\")\\n    log_text = read_text(\\\"ATTAVO_COUNSEL_LOG\\\")\\n    if log_text.strip():\\n        parts.append(\\n            \\\"## The record's log\\\\n\\\\n\\\"\\n            f\\\"The log is at {describe_file(log_path, log_text, diff_like=False)}. \\\"\\n            \\\"Read it yourself with your own tools.\\\")\\n\\n    diff_path = os.environ.get(\\\"ATTAVO_COUNSEL_DIFF\\\")\\n    diff_text = read_text(\\\"ATTAVO_COUNSEL_DIFF\\\")\\n    if diff_text.strip():\\n        parts.append(\\n            \\\"## The item's diff since approval\\\\n\\\\n\\\"\\n            f\\\"The diff is at {describe_file(diff_path, diff_text, diff_like=True)}. \\\"\\n            \\\"Read it yourself with your own tools.\\\")\\n\\n    # issue #175: the forge in the evidence set. ATTAVO_COUNSEL_CHECKS is\\n    # always written, a JSON {read, reason, checks} envelope -- read false\\n    # names the missing manifest key rather than leaving the section out,\\n    # since an unread forge must never be mistaken for a green one.\\n    checks_path = os.environ.get(\\\"ATTAVO_COUNSEL_CHECKS\\\")\\n    checks_text = read_text(\\\"ATTAVO_COUNSEL_CHECKS\\\")\\n    if checks_text.strip():\\n        parts.append(\\n            \\\"## The forge's checks on this stop's sha\\\\n\\\\n\\\"\\n            f\\\"The checks are at {describe_file(checks_path, checks_text, diff_like=False)}: \\\"\\n            \\\"a JSON object -- read: false means the forge was not read at \\\"\\n            \\\"all (reason names the missing manifest key; treat this as \\\"\\n            \\\"unknown, never as green) -- read: true carries one entry per \\\"\\n            \\\"check, each naming, for a check that did not succeed, the \\\"\\n            \\\"path of its own failed-step log. Read the failing check's \\\"\\n            \\\"log before answering about the forge; a remedy that depends \\\"\\n            \\\"on the forge's state cites the check and its log line.\\\")\\n\\n    # issue #175: the graph in the evidence set -- the default branch's\\n    # own log since this item's branch point, this branch's own commits,\\n    # the markers and records present at the stop's sha, and the check\\n    # runs on the last three shas, so \\\"the checks are on the record\\n    # commit, not the code commit\\\" is readable without a terminal.\\n    graph_path = os.environ.get(\\\"ATTAVO_COUNSEL_GRAPH\\\")\\n    graph_text = read_text(\\\"ATTAVO_COUNSEL_GRAPH\\\")\\n    if graph_text.strip():\\n        parts.append(\\n            \\\"## The item's graph\\\\n\\\\n\\\"\\n            f\\\"The graph is at {describe_file(graph_path, graph_text, diff_like=False)}. \\\"\\n            \\\"Read it yourself with your own tools.\\\")\\n\\n    manifest_path = os.environ.get(\\\"ATTAVO_MANIFEST\\\", \\\"\\\")\\n    parts.append(f\\\"## The tenant manifest\\\\n\\\\nThe manifest is at `{manifest_path}`. \\\"\\n                 \\\"Read it yourself with your own tools.\\\")\\n\\n    product_root = os.environ.get(\\\"ATTAVO_PRODUCT_ROOT\\\", \\\"\\\")\\n    parts.append(\\n        \\\"## The product's own root\\\\n\\\\n\\\"\\n        f\\\"The product that ran this stage is at `{product_root}` \\\"\\n        \\\"(`bin/attavo`, `adapters/`, `schema/`, `templates/`). A stop \\\"\\n        \\\"whose cause is the product's own mechanism, not the tenant's, \\\"\\n        \\\"is read here.\\\")\\n\\n    # issue #175: attavo counsel N --ask hands the operator's own text as\\n    # the question to answer, over the same evidence set, rather than\\n    # diagnosing a stop -- the record above is context, not necessarily a\\n    # failure.\\n    question = os.environ.get(\\\"ATTAVO_COUNSEL_QUESTION\\\", \\\"\\\")\\n    if question.strip():\\n        parts.append(\\n            \\\"## The operator's question\\\\n\\\\n\\\" + question.strip() +\\n            \\\"\\\\n\\\\nAnswer this question using the evidence above; the \\\"\\n            \\\"record named above is context, not necessarily a failure.\\\")\\n\\n    parts.append(\\n        \\\"you are counseling a stop, read-only: make no edits, write no \\\"\\n        \\\"files, commit nothing. Read the record, its log, the spec, the \\\"\\n        \\\"rulings, the diff, the forge's checks, the item's graph, the \\\"\\n        \\\"tenant manifest, and the product's own root named above with \\\"\\n        \\\"your own tools, then answer with exactly one class (the stop's \\\"\\n        \\\"class, or \\\\\\\"unclassed\\\\\\\"), one verdict -- \\\\\\\"answer\\\\\\\" (the stop is \\\"\\n        \\\"answerable inside the rules: a ruling text, in \\\"\\n        \\\"proposal.ruling_text, with three citations -- instruction, \\\"\\n        \\\"mechanism, guard, each a path and symbol or a ruling id), \\\"\\n        \\\"\\\\\\\"patch\\\\\\\" (the stop is a product defect: the mechanism's file \\\"\\n        \\\"and symbol, a rejection test, and a unified diff, in \\\"\\n        \\\"proposal.patch -- or, when the remedy is better filed as an \\\"\\n        \\\"item than shipped as a diff, a title and a body in this \\\"\\n        \\\"repository's own issue format -- a Severity/Provenance line, \\\"\\n        \\\"then Problem, Retires, Change, and Acceptance sections -- in \\\"\\n        \\\"proposal.issue), or \\\\\\\"person\\\\\\\" (the answer would touch the \\\"\\n        \\\"definition of done and no rule covers it: the question restated \\\"\\n        \\\"in one line, in proposal.question -- or, when the remedy is \\\"\\n        \\\"better filed as an item than asked as a bare question, a title \\\"\\n        \\\"and a body in the same issue format, in proposal.issue) -- and \\\"\\n        \\\"citations for whichever verdict you gave. You propose; you do \\\"\\n        \\\"not act.\\\")\\n    return \\\"\\\\n\\\\n\\\".join(parts)\\n\\n\\nBUILD_ALLOWED_TOOLS = [\\\"Read\\\", \\\"Edit\\\", \\\"Write\\\", \\\"Bash\\\"]\\n\\n# Item 229's third attempt: 2,754 s and $6.54 to write the right change and\\n# be refused at the gate for one path the spec's Claims did not name. The\\n# gate stays the law, but the boundary is told at the edit: the build's\\n# Edit and Write are allowed on the claimed paths only, as permission\\n# rules built from the spec's own Claims list, so an edit outside them is\\n# refused by the tool at the moment it is tried and the executor's recourse\\n# is the one it has for anything outside the spec -- a question.\\nBUILD_FIXED_TOOLS = [\\\"Read\\\", \\\"Bash\\\"]\\n\\n\\ndef claimed_paths() -> list[str]:\\n    \\\"\\\"\\\"The spec's Claims, one path or glob per line under '## Claims', as\\n    the spec contract writes them (attavo/spec.py's parse_spec reads the\\n    same lines).\\\"\\\"\\\"\\n    spec_dir = os.environ.get(\\\"ATTAVO_SPEC_DIR\\\")\\n    if not spec_dir:\\n        return []\\n    try:\\n        lines = (Path(spec_dir) / \\\"spec.md\\\").read_text().splitlines()\\n    except OSError:\\n        return []\\n    claims: list[str] = []\\n    inside = False\\n    for line in lines:\\n        if line.startswith(\\\"## \\\"):\\n            inside = line.strip() == \\\"## Claims\\\"\\n            continue\\n        if inside and line.strip().startswith(\\\"- \\\"):\\n            claims.append(line.strip()[2:].strip())\\n    return claims\\n\\n\\ndef claim_rule(claim: str) -> str:\\n    \\\"\\\"\\\"A claim as a permission-rule path: a directory claim (trailing\\n    slash) covers everything under it.\\\"\\\"\\\"\\n    return claim + \\\"**\\\" if claim.endswith(\\\"/\\\") else claim\\n\\n\\ndef build_allowed_tools() -> list[str]:\\n    claims = claimed_paths()\\n    if not claims:\\n        return BUILD_ALLOWED_TOOLS\\n    rules = [f\\\"{tool}({claim_rule(c)})\\\" for c in claims for tool in (\\\"Edit\\\", \\\"Write\\\")]\\n    return BUILD_FIXED_TOOLS + rules\\nVERIFY_ALLOWED_TOOLS = [\\\"Read\\\", \\\"Bash\\\"]\\n\\n# Issue #88 (class B): both tools the tool's own reply named as a way to\\n# spawn work that outlives this invocation -- confirmed live against\\n# `claude 2.1.269` (see module docstring). Named on both stages: verify's\\n# own allowed tools never included either, and did not stop the\\n# specimen either.\\nSUBAGENT_TOOLS = [\\\"Agent\\\", \\\"Workflow\\\"]\\n\\n# Items 227 and 229: the executor started `attavo test` in the background,\\n# loaded Monitor to tail its output file, scheduled wakeups to wait for it,\\n# and on 227 answered done while the wait was still open. Both let the\\n# invocation outlive its own answer, the same reason the subagent tools\\n# are denied.\\nOUTLIVING_TOOLS = [\\\"Monitor\\\", \\\"ScheduleWakeup\\\"]\\n\\n# The raw test runner and the product's transport are not the executor's\\n# tools: `attavo test` is the one test command (issue #212) and the pass\\n# is the one transport. Permission-rule patterns, prefix-matched by the\\n# tool; the product refuses its transport on its own account too\\n# (ATTAVO_STAGE), so the second half here is belt beside braces.\\nDENIED_COMMANDS = [\\\"Bash(pytest:*)\\\", \\\"Bash(python3 -m pytest:*)\\\", \\\"Bash(python -m pytest:*)\\\",\\n                   \\\"Bash(npm test:*)\\\", \\\"Bash(npx vitest:*)\\\", \\\"Bash(go test:*)\\\", \\\"Bash(cargo test:*)\\\",\\n                   \\\"Bash(attavo drive:*)\\\", \\\"Bash(attavo worker:*)\\\"]\\n\\n\\ndef load_config() -> dict:\\n    raw = os.environ.get(\\\"ATTAVO_ADAPTER_CONFIG\\\")\\n    return json.loads(raw) if raw else {}\\n\\n\\ndef refused_config_key(config: dict) -> str | None:\\n    \\\"\\\"\\\"None if config carries no retired key; else the refusal message.\\n    allowed_tools (issue #78) is retired, not ignored: the sandbox is the\\n    boundary now, a curated Bash(...) prefix list is not, and a manifest\\n    still naming it must be refused rather than silently accepted.\\\"\\\"\\\"\\n    if \\\"allowed_tools\\\" in config:\\n        return (\\\"[executor.claude-code].allowed_tools is retired (issue \\\"\\n                \\\"#78) -- the sandbox is the boundary now, not a curated \\\"\\n                \\\"Bash(...) prefix list\\\")\\n    return None\\n\\n\\n# Issue #93: claude code publishes no numeric input-size ceiling\\n# anywhere in its own surface (--help, docs, or any config file,\\n# confirmed against claude 2.1.269) -- unlike codex's documented\\n# input_too_large. This adapter asserts its own instruction stays under\\n# a fixed bound instead of a tool-documented one, so an undeclared tool\\n# still cannot be handed an unbounded prompt.\\nFIXED_BOUND_CHARS = 65_536\\n\\n\\ndef input_limit_chars() -> int:\\n    \\\"\\\"\\\"The bound this adapter enforces in place of a declared ceiling.\\n    Overridable only for tests via ATTAVO_ADAPTER_INPUT_LIMIT_CHARS --\\n    never a tenant knob: the ceiling is a fact about the tool, not\\n    something [executor.claude-code] can set.\\\"\\\"\\\"\\n    override = os.environ.get(\\\"ATTAVO_ADAPTER_INPUT_LIMIT_CHARS\\\")\\n    return int(override) if override else FIXED_BOUND_CHARS\\n\\n\\ndef ceiling_refusal(instruction: str) -> str | None:\\n    \\\"\\\"\\\"None if instruction stays at or under the fixed bound; else the\\n    refusal naming both numbers, checked before claude is ever invoked.\\\"\\\"\\\"\\n    limit = input_limit_chars()\\n    size = len(instruction)\\n    if size <= limit:\\n        return None\\n    return (f\\\"ceiling exceeded -- instruction is {size} chars, over \\\"\\n           f\\\"the fixed bound of {limit} chars (claude code declares no \\\"\\n           f\\\"input limit of its own)\\\")\\n\\n\\nREAD_ONLY_STAGES = (\\\"verify\\\", \\\"counsel\\\")\\n\\n\\ndef sandbox_settings(stage: str, working_directory: Path) -> dict:\\n    \\\"\\\"\\\"Every Bash command and its children stay confined to\\n    working_directory (writes) and the network stays closed for every\\n    stage (issue #78) -- confirmed live, not assumed. verify and counsel\\n    (issue #100) additionally deny writes to working_directory itself,\\n    making \\\"make no edits, write no files\\\" mechanical rather than merely\\n    instructed -- counsel is a read-only invocation, the same sandbox\\n    verify runs under.\\n    \\\"\\\"\\\"\\n    sandbox = {\\n        \\\"enabled\\\": True,\\n        \\\"allowUnsandboxedCommands\\\": False,\\n        \\\"network\\\": {\\\"allowedDomains\\\": []},\\n    }\\n    if stage in READ_ONLY_STAGES:\\n        sandbox[\\\"filesystem\\\"] = {\\\"denyWrite\\\": [str(working_directory)]}\\n    return {\\\"sandbox\\\": sandbox}\\n\\n\\n# Items 227 and 229: Claude Code's Bash foreground is two minutes while one\\n# test call is [tests].call_timeout_s (240), so the executor wrapped runs in\\n# `timeout N` and backgrounded them. The product exports that bound as\\n# ATTAVO_TEST_TIMEOUT_S; the foreground is set to fit one run plus a margin.\\nFOREGROUND_MARGIN_S = 60\\n\\n\\ndef foreground_env() -> dict[str, str]:\\n    \\\"\\\"\\\"The variables this adapter sets itself for its executor: the Bash\\n    foreground and its ceiling, from ATTAVO_TEST_TIMEOUT_S. None when no\\n    bound was exported.\\\"\\\"\\\"\\n    bound = os.environ.get(\\\"ATTAVO_TEST_TIMEOUT_S\\\")\\n    if not bound:\\n        return {}\\n    try:\\n        millis = str((int(bound) + FOREGROUND_MARGIN_S) * 1000)\\n    except ValueError:\\n        return {}\\n    return {\\\"BASH_DEFAULT_TIMEOUT_MS\\\": millis, \\\"BASH_MAX_TIMEOUT_MS\\\": millis}\\n\\n\\ndef build_command(instruction: str, config: dict, schema: dict, stage: str) -> list[str]:\\n    auth = config.get(\\\"auth\\\", \\\"api\\\")\\n    allowed_tools = VERIFY_ALLOWED_TOOLS if stage in READ_ONLY_STAGES else build_allowed_tools()\\n    # acceptEdits approves every edit before an allow rule is consulted;\\n    # with claimed-path rules in force the mode is default, so a claimed\\n    # edit is approved by its rule and an unclaimed one asks -- and a\\n    # headless -p run answers no. The tenant may still set the mode.\\n    claimed_rules = stage not in READ_ONLY_STAGES and allowed_tools is not BUILD_ALLOWED_TOOLS\\n    permission_mode = config.get(\\\"permission_mode\\\", \\\"default\\\" if claimed_rules else \\\"acceptEdits\\\")\\n\\n    cmd = [\\\"claude\\\"]\\n    if auth == \\\"subscription\\\":\\n        # no --bare: this is the tenant's own login, not a bare API key, so\\n        # the tenant's project hooks and MCP servers must not load -- only\\n        # --setting-sources (CLAUDE.md still loads) and --strict-mcp-config\\n        # keep them out, the same isolation --bare gives in api mode.\\n        setting_sources = config.get(\\\"setting_sources\\\", \\\"user\\\")\\n        cmd += [\\\"--setting-sources\\\", setting_sources, \\\"--strict-mcp-config\\\"]\\n    else:\\n        cmd += [\\\"--bare\\\"]\\n    cmd += [\\\"--settings\\\", json.dumps(sandbox_settings(stage, Path.cwd()))]\\n    cmd += [\\\"-p\\\", instruction,\\n           \\\"--output-format\\\", \\\"stream-json\\\", \\\"--verbose\\\",\\n           \\\"--json-schema\\\", json.dumps(schema),\\n           \\\"--permission-mode\\\", permission_mode,\\n           \\\"--allowedTools\\\", \\\",\\\".join(allowed_tools),\\n           \\\"--disallowedTools\\\", \\\",\\\".join(SUBAGENT_TOOLS + OUTLIVING_TOOLS + DENIED_COMMANDS)]\\n    model = config.get(\\\"model\\\")\\n    if model:\\n        cmd += [\\\"--model\\\", model]\\n    return cmd\\n\\n\\ndef derive_model(response: dict, requested_model: str | None) -> tuple[str | None, str | None]:\\n    \\\"\\\"\\\"(model, model_version). --output-format json carries no top-level\\n    \\\"model\\\" field; modelUsage is the per-model cost/usage breakdown, keyed\\n    by a dated id (e.g. \\\"claude-haiku-4-5-20251001\\\") whose own\\n    \\\"canonicalModel\\\" entry is the short name (e.g. \\\"claude-haiku-4-5\\\").\\n\\n    When a model was requested (issue #77), it is trusted verbatim as\\n    model rather than picked out of modelUsage: a lightweight helper\\n    model's few thousand uncached tokens must not outrank a primary\\n    model whose real weight is almost entirely cached reads, which a\\n    token-count comparison cannot tell apart from a model that barely\\n    ran. model_version is the modelUsage key whose canonicalModel matches\\n    the requested model -- the dated id the tool actually ran -- or None\\n    when no key matches.\\n\\n    When no model was requested, the modelUsage key with the largest\\n    total of inputTokens + cacheReadInputTokens + cacheCreationInputTokens\\n    + outputTokens is the model that did the work; cache tokens count\\n    here for the same reason they must not be left out of a requested\\n    model's tokens.input (below).\\n    \\\"\\\"\\\"\\n    model_usage = response.get(\\\"modelUsage\\\") or {}\\n\\n    if requested_model:\\n        model_version = next(\\n            (key for key, entry in model_usage.items()\\n             if entry.get(\\\"canonicalModel\\\") == requested_model),\\n            None)\\n        return requested_model, model_version\\n\\n    if not model_usage:\\n        return None, None\\n\\n    def total_tokens(key: str) -> int:\\n        entry = model_usage[key]\\n        return ((entry.get(\\\"inputTokens\\\", 0) or 0)\\n                + (entry.get(\\\"cacheReadInputTokens\\\", 0) or 0)\\n                + (entry.get(\\\"cacheCreationInputTokens\\\", 0) or 0)\\n                + (entry.get(\\\"outputTokens\\\", 0) or 0))\\n\\n    winner = max(model_usage, key=total_tokens)\\n    return winner, model_usage[winner].get(\\\"canonicalModel\\\")\\n\\n\\ndef adapter_version() -> str:\\n    try:\\n        out = subprocess.run([\\\"claude\\\", \\\"--version\\\"], capture_output=True,\\n                             text=True, check=False)\\n    except OSError:\\n        return \\\"\\\"\\n    return out.stdout.strip()\\n\\n\\nMIN_QUESTION_CHARS = 40\\n\\nREINSTRUCTION = (\\n    \\\"your last answer was a report, not a question; either continue to \\\"\\n    \\\"done, or ask one question ending in a question mark that names the \\\"\\n    \\\"spec line or guard you cannot resolve\\\")\\n\\n\\ndef question_class(status: str, question: str | None) -> str:\\n    \\\"\\\"\\\"\\\"done\\\" (no halt at all), \\\"fail\\\" (a question too short or absent to\\n    be worth a person's judgment -- MIN_QUESTION_CHARS, unchanged since\\n    v0.15.0), \\\"report\\\" (long enough but carries no \\\"?\\\" -- issue #88's\\n    class A, a status update in the question channel), or \\\"question\\\" (a\\n    real question).\\\"\\\"\\\"\\n    if status != \\\"question\\\":\\n        return \\\"done\\\"\\n    if not question or len(question) < MIN_QUESTION_CHARS:\\n        # An absent or too-short question is a report with nothing in\\n        # it: a status update in the question channel (issue #150, three\\n        # specimens on 2026-09-17), never an exit with no report line.\\n        return \\\"report\\\"\\n    if \\\"?\\\" not in question:\\n        return \\\"report\\\"\\n    return \\\"question\\\"\\n\\n\\n# R3: a vendor's capacity, rate, or 5xx refusal is transient -- classed on\\n# this adapter's own report line, the same way non-question already is\\n# (issue #88), so a pass retries it plainly instead of paying for a\\n# counsel run on a stop the definition of done never touches (#194's own\\n# verify-01, closed by the item this adapter now serves).\\nTRANSIENT_MARKERS = (\\\"overloaded\\\", \\\"rate limit\\\", \\\"rate_limit\\\", \\\"429\\\", \\\"500\\\", \\\"502\\\", \\\"503\\\", \\\"529\\\",\\n                    \\\"internal server error\\\", \\\"service unavailable\\\", \\\"temporarily unavailable\\\")\\n\\n\\ndef transient_detail(response: dict) -> str | None:\\n    \\\"\\\"\\\"response.get(\\\"result\\\")'s own text when is_error and it names one of\\n    TRANSIENT_MARKERS; else None -- an is_error for any other reason (an\\n    auth mismatch, a malformed request) is not this.\\\"\\\"\\\"\\n    if not response.get(\\\"is_error\\\"):\\n        return None\\n    text = str(response.get(\\\"result\\\") or \\\"\\\")\\n    low = text.lower()\\n    return text if any(marker in low for marker in TRANSIENT_MARKERS) else None\\n\\n\\ndef subagent_refusal(response: dict) -> str | None:\\n    \\\"\\\"\\\"None if response carries no spawned background work; else the\\n    refusal naming the counts (issue #88, class B). Checked on the\\n    response itself, not the flag that was supposed to forbid it --\\n    tenant zero's specimen spawned three with the tool absent from\\n    --allowedTools entirely, so the flag alone is not the mechanism.\\\"\\\"\\\"\\n    stats = response.get(\\\"subagent_stats\\\") or {}\\n    spawned = stats.get(\\\"spawned\\\") or 0\\n    if not spawned:\\n        return None\\n    killed = stats.get(\\\"killed\\\") or {}\\n    killed_total = sum(v or 0 for v in killed.values())\\n    return (\\n        f\\\"adapters/claude-code/run: refused: subagent_stats.spawned={spawned} \\\"\\n        f\\\"-- the {' or '.join(SUBAGENT_TOOLS)} tool spawned work that can \\\"\\n        f\\\"outlive this invocation (completed={stats.get('completed', 0)}, \\\"\\n        f\\\"killed={killed_total}, \\\"\\n        f\\\"started_in_background={stats.get('started_in_background', 0)})\\\")\\n\\n\\ndef load_canned_responses() -> list[dict] | None:\\n    \\\"\\\"\\\"None when ATTAVO_ADAPTER_RESPONSE_FILE is unset. Otherwise the\\n    queue this run answers from: a single object repeats for every\\n    invocation this adapter makes (unchanged since v0.3.0 -- most tests\\n    make exactly one), a JSON array is consumed in order, one response\\n    per invocation, its last element repeating once exhausted (issue\\n    #88: the non-question retry is a second invocation inside the same\\n    adapter run, and a canned test needs to hand it a different answer\\n    than the first). Distinct from ATTAVO_ADAPTER_STREAM_FILE below: a\\n    canned response here is the final report object itself, the shape\\n    the model-derivation and report-field tests exercise, never a stream\\n    to map -- unaffected by --output-format actually being stream-json\\n    on a real invocation.\\\"\\\"\\\"\\n    response_file = os.environ.get(\\\"ATTAVO_ADAPTER_RESPONSE_FILE\\\")\\n    if not response_file:\\n        return None\\n    raw = json.loads(Path(response_file).read_text())\\n    return raw if isinstance(raw, list) else [raw]\\n\\n\\ndef load_canned_stream() -> list[str] | None:\\n    \\\"\\\"\\\"None when ATTAVO_ADAPTER_STREAM_FILE is unset. Otherwise a\\n    recorded `claude --output-format stream-json --verbose` transcript,\\n    one JSONL line per list entry (issue #26, acceptance row 3) -- fed\\n    through the same line-by-line mapping and terminal \\\"result\\\" read a\\n    real invocation gets, so the mapping is exercised without a live\\n    `claude` process.\\\"\\\"\\\"\\n    stream_file = os.environ.get(\\\"ATTAVO_ADAPTER_STREAM_FILE\\\")\\n    if not stream_file:\\n        return None\\n    return Path(stream_file).read_text().splitlines()\\n\\n\\ndef parse_stream_line(line: str) -> dict | None:\\n    \\\"\\\"\\\"One parsed JSONL line, or None when it is blank or not JSON -- a\\n    tracing line on the same stream is not an error, just not an event\\n    (codex's own parse_events does the same).\\\"\\\"\\\"\\n    line = line.strip()\\n    if not line:\\n        return None\\n    try:\\n        return json.loads(line)\\n    except ValueError:\\n        return None\\n\\n\\ndef first_string_arg(tool_input: dict | None) -> str:\\n    \\\"\\\"\\\"The first string-valued argument of a tool_use block's input, in\\n    declaration order -- a file path or a command, the one value worth a\\n    feed line; a tool whose arguments are all non-string (booleans,\\n    numbers) reports \\\"\\\" rather than guess which one matters.\\\"\\\"\\\"\\n    for value in (tool_input or {}).values():\\n        if isinstance(value, str):\\n            return value\\n    return \\\"\\\"\\n\\n\\ndef tool_result_content_text(content) -> str:\\n    \\\"\\\"\\\"A tool_result block's own text, whichever of claude code's two\\n    content shapes it carries: a bare string, or a list of {\\\"type\\\":\\n    \\\"text\\\", \\\"text\\\": ...} blocks (an image or other non-text block\\n    contributes nothing -- there is no line of text to render).\\\"\\\"\\\"\\n    if isinstance(content, str):\\n        return content\\n    if isinstance(content, list):\\n        return \\\"\\\\n\\\".join(b.get(\\\"text\\\", \\\"\\\") for b in content\\n                         if isinstance(b, dict) and b.get(\\\"type\\\") == \\\"text\\\")\\n    return \\\"\\\"\\n\\n\\ndef stream_line_events(obj: dict) -> list[tuple[str, str]]:\\n    \\\"\\\"\\\"[(kind, text), ...] for one parsed stream-json line -- zero, one,\\n    or several (one assistant turn can carry a text block and a tool_use\\n    block together, each its own event). An assistant message's text\\n    block maps to \\\"message\\\", its tool_use blocks to \\\"tool_call\\\" (the\\n    tool's name and its first string argument); a user message carrying\\n    a tool_result block maps to \\\"tool_result\\\" (the result's own first\\n    line). Everything else on the stream -- system, and \\\"result\\\" itself,\\n    read separately for the report fields rather than rendered as a feed\\n    line -- maps to nothing.\\\"\\\"\\\"\\n    events: list[tuple[str, str]] = []\\n    # The stream is the executor's; its shapes are not the adapter's to\\n    # assume. A line whose message is not an object (a diagnostic with a\\n    # string message, attavo/attavo#151 build-02) maps to nothing and\\n    # stays transcript; nothing here raises on a shape it did not expect.\\n    message = obj.get(\\\"message\\\")\\n    if not isinstance(message, dict):\\n        return events\\n    content = message.get(\\\"content\\\") or []\\n    if not isinstance(content, list):\\n        return events\\n    if obj.get(\\\"type\\\") == \\\"assistant\\\":\\n        for block in content:\\n            if not isinstance(block, dict):\\n                continue\\n            if block.get(\\\"type\\\") == \\\"text\\\" and block.get(\\\"text\\\"):\\n                events.append((\\\"message\\\", block[\\\"text\\\"]))\\n            elif block.get(\\\"type\\\") == \\\"tool_use\\\":\\n                name = block.get(\\\"name\\\") or \\\"\\\"\\n                arg = first_string_arg(block.get(\\\"input\\\"))\\n                events.append((\\\"tool_call\\\", f\\\"{name} {arg}\\\".strip()))\\n    elif obj.get(\\\"type\\\") == \\\"user\\\":\\n        for block in content:\\n            if isinstance(block, dict) and block.get(\\\"type\\\") == \\\"tool_result\\\":\\n                text = tool_result_content_text(block.get(\\\"content\\\"))\\n                first_line = text.splitlines()[0] if text.splitlines() else \\\"\\\"\\n                events.append((\\\"tool_result\\\", first_line))\\n    return events\\n\\n\\nEVENT_TEXT_MAX_CHARS = 400\\n\\n\\ndef append_event(events_path: str, kind: str, text: str) -> None:\\n    \\\"\\\"\\\"One {at, kind, text} JSON line appended to events_path and\\n    flushed at once -- the same shape and the same open-write-close\\n    discipline bin/attavo's own append_event uses for its iteration and\\n    gate events, kept independently here since an adapter is a separate\\n    process with no import path into the product.\\\"\\\"\\\"\\n    line = {\\\"at\\\": datetime.now(timezone.utc).strftime(\\\"%Y-%m-%dT%H:%M:%SZ\\\"),\\n           \\\"kind\\\": kind, \\\"text\\\": \\\" \\\".join(text.split())[:EVENT_TEXT_MAX_CHARS]}\\n    with open(events_path, \\\"a\\\") as fh:\\n        fh.write(json.dumps(line) + \\\"\\\\n\\\")\\n\\n\\ndef invoke_stream(cmd: list[str], events_path: str | None, canned_lines: list[str] | None\\n                  ) -> tuple[str, dict | None, int]:\\n    \\\"\\\"\\\"(raw transcript text, the terminal \\\"result\\\" object or None, exit\\n    code) -- from canned_lines (ATTAVO_ADAPTER_STREAM_FILE) when given,\\n    else a real `claude --output-format stream-json --verbose`\\n    invocation, read line by line as it runs (not buffered until the\\n    process exits) so each mapped event reaches events_path while the\\n    stage is still in progress. Every raw line reaches the returned\\n    transcript, mapped or not -- issue #34's guarantee: the evidence is\\n    what build-NN.log saves, not just what this adapter went on to use.\\n    \\\"\\\"\\\"\\n    raw_lines: list[str] = []\\n    result: dict | None = None\\n\\n    def handle(line: str) -> None:\\n        nonlocal result\\n        if not line.strip():\\n            return\\n        raw_lines.append(line)\\n        obj = parse_stream_line(line)\\n        if obj is None:\\n            return\\n        if obj.get(\\\"type\\\") == \\\"result\\\":\\n            result = obj\\n            return\\n        if events_path:\\n            for kind, text in stream_line_events(obj):\\n                append_event(events_path, kind, text)\\n\\n    if canned_lines is not None:\\n        for line in canned_lines:\\n            handle(line)\\n        return \\\"\\\\n\\\".join(raw_lines), result, 0\\n\\n    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,\\n                            env={**executor_env(), **foreground_env()})\\n    assert proc.stdout is not None\\n    for line in proc.stdout:\\n        handle(line.rstrip(\\\"\\\\n\\\"))\\n    proc.wait()\\n    stderr = proc.stderr.read() if proc.stderr else \\\"\\\"\\n    if stderr.strip():\\n        raw_lines.append(stderr.rstrip(\\\"\\\\n\\\"))\\n    return \\\"\\\\n\\\".join(raw_lines), result, proc.returncode\\n\\n\\ndef invoke_once(cmd: list[str], responses: list[dict] | None, call_index: int,\\n                events_path: str | None\\n                ) -> tuple[int | None, dict | None]:\\n    \\\"\\\"\\\"(None, response) for a result this adapter goes on to evaluate;\\n    (exit_code, None) when the call itself must end the adapter right\\n    away (the underlying tool's own non-zero exit, or a 0 exit whose\\n    stream carried no terminal \\\"result\\\" line at all). Always prints this\\n    call's raw transcript to stdout first -- issue #34's guarantee holds\\n    across a retry too: every raw line the tool produced, not just the\\n    result this adapter finally reports on, reaches build-NN.log.\\n    \\\"\\\"\\\"\\n    if responses is not None:\\n        response = responses[min(call_index, len(responses) - 1)]\\n        print(json.dumps(response))\\n        return None, response\\n\\n    raw, result, returncode = invoke_stream(cmd, events_path, load_canned_stream())\\n    if raw.strip():\\n        print(raw)\\n    if returncode != 0:\\n        return returncode, None\\n    if result is None:\\n        return 1, None\\n    return None, result\\n\\n\\ndef usage_fields(response: dict) -> tuple[int, int, float | None]:\\n    \\\"\\\"\\\"(tokens.input, tokens.output, cost_usd) for one response, pulled\\n    straight off usage/total_cost_usd -- independent of model derivation,\\n    so a retry's first, discarded call still counts (issue #88: a\\n    non-question costs two executor turns, and a report line built from\\n    the second call alone undercounts by exactly the first one).\\\"\\\"\\\"\\n    usage = response.get(\\\"usage\\\") or {}\\n    tokens_input = ((usage.get(\\\"input_tokens\\\", 0) or 0)\\n                    + (usage.get(\\\"cache_read_input_tokens\\\", 0) or 0)\\n                    + (usage.get(\\\"cache_creation_input_tokens\\\", 0) or 0))\\n    tokens_output = usage.get(\\\"output_tokens\\\", 0) or 0\\n    return tokens_input, tokens_output, response.get(\\\"total_cost_usd\\\")\\n\\n\\ndef add_cost(a: float | None, b: float | None) -> float | None:\\n    \\\"\\\"\\\"None when neither call reported a cost; otherwise the sum,\\n    treating an absent figure as 0 -- mirrors bin/attavo's own\\n    cost_usd accumulation across build iterations.\\\"\\\"\\\"\\n    if a is None and b is None:\\n        return None\\n    return (a or 0) + (b or 0)\\n\\n\\ndef report_fields(response: dict, requested_model: str | None) -> dict | None:\\n    \\\"\\\"\\\"The fields common to every final report line, derived from one\\n    tool response; None when no model id can be derived at all (the\\n    caller must fail loudly rather than emit a report with no identity\\n    behind it).\\\"\\\"\\\"\\n    model, model_version = derive_model(response, requested_model)\\n    if not model:\\n        sys.stderr.write(\\n            \\\"adapters/claude-code/run: could not derive a model id -- the \\\"\\n            \\\"response carried no requested model and an empty \\\"\\n            \\\"'modelUsage'\\\\n\\\")\\n        return None\\n    if requested_model and response.get(\\\"modelUsage\\\") and not model_version:\\n        sys.stderr.write(\\n            f\\\"adapters/claude-code/run: requested model {requested_model!r} \\\"\\n            \\\"matches no modelUsage canonicalModel -- model_version left \\\"\\n            \\\"null\\\\n\\\")\\n\\n    tokens_input, tokens_output, cost = usage_fields(response)\\n    return {\\n        \\\"model\\\": model,\\n        \\\"model_version\\\": model_version,\\n        \\\"adapter_version\\\": adapter_version(),\\n        \\\"tokens\\\": {\\\"input\\\": tokens_input, \\\"output\\\": tokens_output},\\n        \\\"cost_usd\\\": cost,\\n    }\\n\\n\\ndef main() -> int:\\n    config = load_config()\\n    refusal = refused_config_key(config)\\n    if refusal:\\n        sys.stderr.write(f\\\"adapters/claude-code/run: refused: {refusal}\\\\n\\\")\\n        return 1\\n\\n    stage = os.environ.get(\\\"ATTAVO_STAGE\\\") or \\\"build\\\"\\n    if stage not in (\\\"build\\\", \\\"verify\\\", \\\"counsel\\\"):\\n        stage = \\\"build\\\"\\n    verifying = stage == \\\"verify\\\"\\n    counseling = stage == \\\"counsel\\\"\\n    if verifying:\\n        instruction, schema = verify_instruction(), VERIFY_SCHEMA\\n    elif counseling:\\n        instruction, schema = counsel_instruction(), COUNSEL_SCHEMA\\n    else:\\n        instruction, schema = build_instruction(), STATUS_SCHEMA\\n    cmd = build_command(instruction, config, schema, stage)\\n\\n    ceiling = ceiling_refusal(instruction)\\n    if ceiling:\\n        sys.stderr.write(f\\\"adapters/claude-code/run: refused: {ceiling}\\\\n\\\")\\n        # Reported, not left for the product to find in the words: nothing\\n        # was invoked, so no adapter version and no tokens.\\n        print(json.dumps({\\\"model\\\": config.get(\\\"model\\\"), \\\"model_version\\\": None,\\n                          \\\"adapter_version\\\": None, \\\"tokens\\\": {\\\"input\\\": 0, \\\"output\\\": 0},\\n                          \\\"cost_usd\\\": None, \\\"class\\\": \\\"ceiling\\\", \\\"detail\\\": ceiling}))\\n        return 1\\n\\n    if os.environ.get(\\\"ATTAVO_ADAPTER_DRY_RUN\\\"):\\n        # {\\\"argv\\\", \\\"instruction\\\", \\\"schema\\\", \\\"env\\\"}, not a bare argv list: the\\n        # instruction lives in argv's own \\\"-p\\\" value here, but a second\\n        # adapter (issue #41) can deliver it on stdin instead, where\\n        # argv carries no instruction at all -- the envelope is what\\n        # stays adapter-agnostic for tests/test_executor_conformance.py.\\n        print(json.dumps({\\\"argv\\\": cmd, \\\"instruction\\\": instruction, \\\"schema\\\": schema,\\n                          \\\"env\\\": foreground_env()}))\\n        return 0\\n\\n    responses = load_canned_responses()\\n    events_path = os.environ.get(\\\"ATTAVO_EVENTS\\\")\\n\\n    exit_code, response = invoke_once(cmd, responses, 0, events_path)\\n    if exit_code is not None:\\n        return exit_code\\n\\n    # An error dressed as a question still costs a ruling act. Treat both\\n    # the same way build already treats a non-zero adapter exit: failed,\\n    # not a halt someone must rule on. Stage-independent: a tool error or\\n    # an absent report is a failure whether this is a build or a verify.\\n    if response.get(\\\"is_error\\\") or not response.get(\\\"structured_output\\\"):\\n        detail = transient_detail(response)\\n        if detail:\\n            common = report_fields(response, config.get(\\\"model\\\"))\\n            if common is not None:\\n                print(json.dumps({**common, \\\"class\\\": \\\"transient\\\", \\\"detail\\\": detail}))\\n        return 1\\n\\n    refusal = subagent_refusal(response)\\n    if refusal:\\n        sys.stderr.write(refusal + \\\"\\\\n\\\")\\n        return 1\\n\\n    structured = response.get(\\\"structured_output\\\") or {}\\n\\n    if verifying:\\n        common = report_fields(response, config.get(\\\"model\\\"))\\n        if common is None:\\n            return 1\\n        # .get(), not \\\"or []\\\": an absent findings key must reach\\n        # cmd_verify as None, distinct from an explicit empty list --\\n        # that distinction is the whole fix for issue #46.\\n        line = {**common,\\n               \\\"findings\\\": structured.get(\\\"findings\\\"),\\n               \\\"tests_named\\\": structured.get(\\\"tests_named\\\")}\\n        print(json.dumps(line))\\n        return 0\\n\\n    if counseling:\\n        common = report_fields(response, config.get(\\\"model\\\"))\\n        if common is None:\\n            return 1\\n        line = {**common,\\n               \\\"class\\\": structured.get(\\\"class\\\"),\\n               \\\"verdict\\\": structured.get(\\\"verdict\\\"),\\n               \\\"citations\\\": structured.get(\\\"citations\\\"),\\n               \\\"proposal\\\": structured.get(\\\"proposal\\\")}\\n        print(json.dumps(line))\\n        return 0\\n\\n    status = structured.get(\\\"status\\\", \\\"done\\\")\\n    question = structured.get(\\\"question\\\")\\n    cls = question_class(status, question)\\n\\n    if cls == \\\"fail\\\":\\n        return 1\\n\\n    if cls == \\\"report\\\":\\n        # Issue #88, class A: a report in the question channel is\\n        # re-instructed once, in this same invocation, before it ever\\n        # reaches a person.\\n        reinstruction = instruction + \\\"\\\\n\\\\n\\\" + REINSTRUCTION\\n        cmd2 = build_command(reinstruction, config, schema, stage)\\n        exit_code2, response2 = invoke_once(cmd2, responses, 1, events_path)\\n        if exit_code2 is not None:\\n            return exit_code2\\n        if response2.get(\\\"is_error\\\") or not response2.get(\\\"structured_output\\\"):\\n            return 1\\n        refusal2 = subagent_refusal(response2)\\n        if refusal2:\\n            sys.stderr.write(refusal2 + \\\"\\\\n\\\")\\n            return 1\\n\\n        structured2 = response2.get(\\\"structured_output\\\") or {}\\n        status2 = structured2.get(\\\"status\\\", \\\"done\\\")\\n        question2 = structured2.get(\\\"question\\\")\\n        cls2 = question_class(status2, question2)\\n        if cls2 == \\\"fail\\\":\\n            return 1\\n\\n        common2 = report_fields(response2, config.get(\\\"model\\\"))\\n        if common2 is None:\\n            return 1\\n        # A non-question costs two executor turns, not one: sum both\\n        # calls' tokens and cost into the one report line this\\n        # invocation gets, whatever the retry's own outcome -- only\\n        # adapter_version/model/model_version stay the second call's.\\n        tokens1_input, tokens1_output, cost1 = usage_fields(response)\\n        common2[\\\"tokens\\\"][\\\"input\\\"] += tokens1_input\\n        common2[\\\"tokens\\\"][\\\"output\\\"] += tokens1_output\\n        common2[\\\"cost_usd\\\"] = add_cost(common2[\\\"cost_usd\\\"], cost1)\\n\\n        if cls2 == \\\"report\\\":\\n            # Two reports in a row: still a halt (someone must look),\\n            # but the transcript above already carries both raw\\n            # results, and this report line names the class so a\\n            # reader -- or a future record field, not this one -- can\\n            # tell it apart from a genuine question.\\n            print(\\\"adapters/claude-code/run: halted: class non-question \\\"\\n                  \\\"-- the executor reported instead of asking, twice in \\\"\\n                  \\\"a row\\\")\\n            line = {**common2, \\\"status\\\": \\\"question\\\", \\\"question\\\": question2,\\n                   \\\"class\\\": \\\"non-question\\\"}\\n            print(json.dumps(line))\\n            return 0\\n\\n        line = {**common2, \\\"status\\\": status2, \\\"question\\\": question2}\\n        print(json.dumps(line))\\n        return 0\\n\\n    common = report_fields(response, config.get(\\\"model\\\"))\\n    if common is None:\\n        return 1\\n    line = {**common, \\\"status\\\": status, \\\"question\\\": question}\\n    print(json.dumps(line))\\n    return 0\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    sys.exit(main())\\n\",\"numLines\":1186,\"startLine\":1,\"totalLines\":1186}}}\n+{\"type\":\"assistant\",\"message\":{\"model\":\"claude-sonnet-5\",\"id\":\"msg_011CfYpzV9UearGs72q2h35f\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"thinking\",\"thinking\":\"\",\"signature\":\"\"}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":22445,\"cache_read_input_tokens\":29919,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":22445},\"output_tokens\":9,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"aa97438b-e700-4e9e-85e2-1d5bd8de4b83\",\"uuid\":\"daf240f3-d6fc-43ff-ac78-257e45fe1fb6\",\"timestamp\":\"2026-09-30T02:23:12.144Z\",\"request_id\":\"req_011CfYpzUfxBAWwmUVnCzitU\"}\n+{\"type\":\"assistant\",\"message\":{\"model\":\"claude-sonnet-5\",\"id\":\"msg_011CfYpzV9UearGs72q2h35f\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_01FkD5SdDv2Bz669nStvkQQN\",\"name\":\"Bash\",\"input\":{\"command\":\"cat attest/specs/288/stub/adapters/claude-code/run\"},\"caller\":{\"type\":\"direct\"}}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":22445,\"cache_read_input_tokens\":29919,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":22445},\"output_tokens\":9,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"aa97438b-e700-4e9e-85e2-1d5bd8de4b83\",\"uuid\":\"ac7b8247-61bd-408c-9228-1376911027ce\",\"timestamp\":\"2026-09-30T02:23:12.828Z\",\"request_id\":\"req_011CfYpzUfxBAWwmUVnCzitU\",\"wire_tool_inputs\":{\"toolu_01FkD5SdDv2Bz669nStvkQQN\":{\"command\":\"cd /Users/davidbean/Projects/attavo-worktree-288 && cat attest/specs/288/stub/adapters/claude-code/run\"}},\"wire_ingest_context\":{\"toolu_01FkD5SdDv2Bz669nStvkQQN\":{\"cwd\":\"/Users/davidbean/Projects/attavo-worktree-288\"}}}\n+{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01FkD5SdDv2Bz669nStvkQQN\",\"type\":\"tool_result\",\"content\":\"<persisted-output>\\nOutput too large (53.4KB). Full output saved to: /Users/davidbean/.claude/projects/-Users-davidbean-Projects-attavo-worktree-288/aa97438b-e700-4e9e-85e2-1d5bd8de4b83/tool-results/b1zescu67.txt\\n\\nPreview (first 2KB):\\n#!/usr/bin/env python3\\n\\\"\\\"\\\"adapters/claude-code/run -- see README.md (this directory) for the four\\nconfiguration keys, and ../README.md for the shared adapter contract.\\n\\nA live `claude` invocation is not exercised by the test suite (judgment\\nis measured, not tested); its argument construction is checked by\\nATTAVO_ADAPTER_DRY_RUN=1, which prints the `claude` command line as a\\nJSON array instead of running it, its response handling is checked by\\nATTAVO_ADAPTER_RESPONSE_FILE, which reads a canned final report object\\nfrom a file instead of invoking `claude`, and (issue #26) its\\n`--output-format stream-json --verbose` mapping -- the event stream\\nthis adapter maps to ATTAVO_EVENTS, and the terminal \\\"result\\\" line it\\nreads the report object from -- is checked by ATTAVO_ADAPTER_STREAM_FILE,\\nwhich feeds a recorded transcript instead.\\n\\nThe whole result is printed to stdout before this adapter's own final\\nline, so build-NN.log carries it as the transcript -- a halt otherwise\\ncannot be explained after the fact. is_error or an absent\\nstructured_output exit 1 on either stage; a build status \\\"question\\\"\\nwhose question is missing or under MIN_QUESTION_CHARS characters also\\nexits 1 (build records the attempt as failed) rather than a halt\\nsomeone must rule on.\\n\\nATTAVO_STAGE=verify branches to a different objective, schema, and\\nreport shape (issue #46): the instruction states the verify objective\\n(see verify_instruction) instead of the build one, --json-schema is\\nVERIFY_SCHEMA instead of STATUS_SCHEMA, and the final line carries\\nfindings and tests_named instead of status and question.\\n\\nIssue #78: the boundary is the tool's own sandbox, not a curated\\nallowed_tools list judged per sub-command -- confirmed live (recorded on\\nthe issue, 2026-09-10) against `claude 2.1.268`: `--settings` carrying\\n`{\\\"sandbox\\\": {\\\"enabled\\\": true, \\\"allowUnsandboxedCommands\\\": false}}` under\\n`-p` refuses a write outside the working directory (\\\"operation not\\n...\\n</persisted-output>\",\"is_error\":false}]},\"parent_tool_use_id\":null,\"session_id\":\"aa97438b-e700-4e9e-85e2-1d5bd8de4b83\",\"uuid\":\"df1295c2-081c-4039-aee5-b3f55ede8417\",\"timestamp\":\"2026-09-30T02:23:12.895Z\",\"tool_use_result\":{\"stdout\":\"#!/usr/bin/env python3\\n\\\"\\\"\\\"adapters/claude-code/run -- see README.md (this directory) for the four\\nconfiguration keys, and ../README.md for the shared adapter contract.\\n\\nA live `claude` invocation is not exercised by the test suite (judgment\\nis measured, not tested); its argument construction is checked by\\nATTAVO_ADAPTER_DRY_RUN=1, which prints the `claude` command line as a\\nJSON array instead of running it, its response handling is checked by\\nATTAVO_ADAPTER_RESPONSE_FILE, which reads a canned final report object\\nfrom a file instead of invoking `claude`, and (issue #26) its\\n`--output-format stream-json --verbose` mapping -- the event stream\\nthis adapter maps to ATTAVO_EVENTS, and the terminal \\\"result\\\" line it\\nreads the report object from -- is checked by ATTAVO_ADAPTER_STREAM_FILE,\\nwhich feeds a recorded transcript instead.\\n\\nThe whole result is printed to stdout before this adapter's own final\\nline, so build-NN.log carries it as the transcript -- a halt otherwise\\ncannot be explained after the fact. is_error or an absent\\nstructured_output exit 1 on either stage; a build status \\\"question\\\"\\nwhose question is missing or under MIN_QUESTION_CHARS characters also\\nexits 1 (build records the attempt as failed) rather than a halt\\nsomeone must rule on.\\n\\nATTAVO_STAGE=verify branches to a different objective, schema, and\\nreport shape (issue #46): the instruction states the verify objective\\n(see verify_instruction) instead of the build one, --json-schema is\\nVERIFY_SCHEMA instead of STATUS_SCHEMA, and the final line carries\\nfindings and tests_named instead of status and question.\\n\\nIssue #78: the boundary is the tool's own sandbox, not a curated\\nallowed_tools list judged per sub-command -- confirmed live (recorded on\\nthe issue, 2026-09-10) against `claude 2.1.268`: `--settings` carrying\\n`{\\\"sandbox\\\": {\\\"enabled\\\": true, \\\"allowUnsandboxedCommands\\\": false}}` under\\n`-p` refuses a write outside the working directory (\\\"operation not\\npermitted\\\") and, with `network.allowedDomains: []`, refuses an outbound\\nconnection (\\\"deny network-outbound ...\\\"), both before `--allowedTools`\\nis ever consulted. build's `--settings` therefore enables the sandbox and\\nforbids the unsandboxed fallback; verify's additionally sets\\n`filesystem.denyWrite` on the working directory itself (confirmed live:\\n`denyWrite` takes a list of paths, not a bare boolean -- `true` alone did\\nnot stop a write inside the directory). `--allowedTools` shrinks to the\\ntool names each stage may use at all -- `Read,Edit,Write,Bash` for build,\\n`Read,Bash` for verify -- since Edit and Write are not Bash and the\\nsandbox does not govern them. `allowed_tools` is retired as a manifest\\nkey: a config that still declares it is refused by name rather than\\nsilently accepted.\\n\\nIssue #88 (class A: a report is not a question). `--json-schema`\\nconstrains the tool's structured_output to \\\"done\\\"/\\\"question\\\", but\\nnothing stops \\\"question\\\" from carrying a status report rather than an\\nactual question -- confirmed against tenant zero's own corpus, five\\nspecimens with no \\\"?\\\" anywhere in the text. A \\\"question\\\" whose text\\nclears MIN_QUESTION_CHARS but contains no \\\"?\\\" is a report, not a\\nquestion: this adapter re-invokes the executor once, appending\\nREINSTRUCTION to the same instruction, before ever reporting a halt to\\na person. A second report in a row still halts (someone must look), but\\nits report line carries \\\"class\\\": \\\"non-question\\\" and both raw results\\nreached stdout above it -- an extra field bin/attavo's own record schema\\ndoes not know about and never has to: it reads \\\"status\\\"/\\\"question\\\" off\\nthis line exactly as before, so a \\\"question\\\" halt still halts. Read via\\nATTAVO_ADAPTER_RESPONSE_FILE, a JSON array is a queue -- one canned\\nresult per invocation this adapter makes, its last element repeating\\nonce exhausted -- while a single object still repeats for every call,\\nunchanged.\\n\\nIssue #88 (class B: work that outlives the invocation). Confirmed live,\\nthis machine, `claude 2.1.269`: with both \\\"Agent\\\" and \\\"Task\\\" allowed, a\\nprompt asking for a subagent produced `subagent_stats.spawned: 1`, `\\\"Agent\\\"`\\nalone in `--disallowedTools` (Task is not a distinct tool in this build)\\nbrought it back to 0 -- the tool's own reply named \\\"Workflow\\\" as the\\nother path to background work, so both are named here. `--allowedTools`\\nis an allow-list a background spawn does not consult (tenant zero's\\nspecimen: `--allowedTools` without \\\"Agent\\\" or \\\"Workflow\\\" in it at all did\\nnot stop three of them), so this adapter also disallows them by name on\\nboth stages and, after the run, refuses by name -- exit 1, not a\\nhalt -- any response whose subagent_stats.spawned is not zero, with the\\ncounts in the message. A tool that reports no subagent_stats at all\\n(spawned absent or 0) is unaffected; this is a refusal on evidence, not a\\nguess from the flag.\\n\\\"\\\"\\\"\\nfrom __future__ import annotations\\n\\nimport json\\nimport os\\nimport subprocess\\nimport sys\\nfrom datetime import datetime, timezone\\nfrom pathlib import Path\\n\\n# the helper beside adapters/, imported without leaving a __pycache__ there\\nsys.dont_write_bytecode = True\\nsys.path.insert(0, str(Path(__file__).resolve().parent.parent))\\nfrom executor_env import executor_env  # noqa: E402\\n\\nSTATUS_SCHEMA = {\\n    \\\"type\\\": \\\"object\\\",\\n    \\\"additionalProperties\\\": False,\\n    \\\"required\\\": [\\\"status\\\", \\\"question\\\"],\\n    \\\"properties\\\": {\\n        \\\"status\\\": {\\\"type\\\": \\\"string\\\", \\\"enum\\\": [\\\"done\\\", \\\"question\\\"]},\\n        \\\"question\\\": {\\\"type\\\": [\\\"string\\\", \\\"null\\\"]},\\n    },\\n}\\n\\n# The verify objective (issue #46): a verifier reports findings, not a\\n# commit. additionalProperties: False means the tool cannot hand back a\\n# structured_output shaped like STATUS_SCHEMA's status/question by\\n# accident -- an absent findings key is what cmd_verify treats as\\n# failed, not a lenient default here.\\nVERIFY_SCHEMA = {\\n    \\\"type\\\": \\\"object\\\",\\n    \\\"additionalProperties\\\": False,\\n    \\\"required\\\": [\\\"findings\\\", \\\"tests_named\\\"],\\n    \\\"properties\\\": {\\n        \\\"findings\\\": {\\n            \\\"type\\\": \\\"array\\\",\\n            \\\"items\\\": {\\n                \\\"type\\\": \\\"object\\\",\\n                \\\"additionalProperties\\\": False,\\n                \\\"required\\\": [\\\"title\\\", \\\"specimen\\\", \\\"retires\\\", \\\"rejection_test\\\", \\\"severity\\\"],\\n                \\\"properties\\\": {\\n                    \\\"title\\\": {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1},\\n                    \\\"specimen\\\": {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1},\\n                    \\\"retires\\\": {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1},\\n                    \\\"rejection_test\\\": {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1},\\n                    \\\"severity\\\": {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1},\\n                },\\n            },\\n        },\\n        \\\"tests_named\\\": {\\\"type\\\": \\\"array\\\", \\\"items\\\": {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1}},\\n    },\\n}\\n\\n# The counsel objective (issue #100): a stop is read inside the product\\n# first, before a person. additionalProperties: False for the same reason\\n# as VERIFY_SCHEMA's own -- the tool cannot hand back a differently-shaped\\n# structured_output by accident.\\nCOUNSEL_SCHEMA = {\\n    \\\"type\\\": \\\"object\\\",\\n    \\\"additionalProperties\\\": False,\\n    \\\"required\\\": [\\\"class\\\", \\\"verdict\\\", \\\"citations\\\", \\\"proposal\\\"],\\n    \\\"properties\\\": {\\n        \\\"class\\\": {\\\"type\\\": \\\"string\\\"},\\n        \\\"verdict\\\": {\\\"type\\\": \\\"string\\\", \\\"enum\\\": [\\\"answer\\\", \\\"patch\\\", \\\"person\\\"]},\\n        \\\"citations\\\": {\\n            \\\"type\\\": \\\"array\\\",\\n            \\\"items\\\": {\\n                \\\"type\\\": \\\"object\\\",\\n                \\\"additionalProperties\\\": False,\\n                \\\"required\\\": [\\\"kind\\\", \\\"path\\\", \\\"symbol\\\", \\\"ruling_id\\\"],\\n                \\\"properties\\\": {\\n                    \\\"kind\\\": {\\\"type\\\": \\\"string\\\", \\\"enum\\\": [\\\"instruction\\\", \\\"mechanism\\\", \\\"guard\\\"]},\\n                    \\\"path\\\": {\\\"type\\\": [\\\"string\\\", \\\"null\\\"]},\\n                    \\\"symbol\\\": {\\\"type\\\": [\\\"string\\\", \\\"null\\\"]},\\n                    \\\"ruling_id\\\": {\\\"type\\\": [\\\"string\\\", \\\"null\\\"]},\\n                },\\n            },\\n        },\\n        \\\"proposal\\\": {\\n            \\\"type\\\": \\\"object\\\",\\n            \\\"additionalProperties\\\": False,\\n            \\\"required\\\": [\\\"ruling_text\\\", \\\"patch\\\", \\\"question\\\", \\\"issue\\\"],\\n            \\\"properties\\\": {\\n                \\\"ruling_text\\\": {\\\"type\\\": [\\\"string\\\", \\\"null\\\"]},\\n                \\\"patch\\\": {\\n                    \\\"type\\\": [\\\"object\\\", \\\"null\\\"],\\n                    \\\"additionalProperties\\\": False,\\n                    \\\"required\\\": [\\\"file\\\", \\\"symbol\\\", \\\"rejection_test\\\", \\\"diff\\\"],\\n                    \\\"properties\\\": {\\n                        \\\"file\\\": {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1},\\n                        \\\"symbol\\\": {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1},\\n                        \\\"rejection_test\\\": {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1},\\n                        \\\"diff\\\": {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1},\\n                    },\\n                },\\n                \\\"question\\\": {\\\"type\\\": [\\\"string\\\", \\\"null\\\"]},\\n                # issue #175: the fourth proposal shape, for a \\\"patch\\\" or\\n                # \\\"person\\\" verdict whose remedy is better filed as an item\\n                # than shipped as a diff or asked as a bare question.\\n                \\\"issue\\\": {\\n                    \\\"type\\\": [\\\"object\\\", \\\"null\\\"],\\n                    \\\"additionalProperties\\\": False,\\n                    \\\"required\\\": [\\\"title\\\", \\\"body\\\"],\\n                    \\\"properties\\\": {\\n                        \\\"title\\\": {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1},\\n                        \\\"body\\\": {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1},\\n                    },\\n                },\\n            },\\n        },\\n    },\\n}\\n\\n\\ndef read_text(path_env: str) -> str:\\n    path = os.environ.get(path_env)\\n    if not path:\\n        return \\\"\\\"\\n    p = Path(path)\\n    return p.read_text() if p.is_file() else \\\"\\\"\\n\\n\\ndef describe_file(path: str, text: str, diff_like: bool) -> str:\\n    \\\"\\\"\\\"Path, byte count, line count, and (for a diff) files touched --\\n    named in the instruction instead of inlining the file's own text, so\\n    the instruction stays a small fixed size whatever the file's size\\n    (issue #86: a 27,367-line deletion diff inlined whole exceeded a\\n    judge's input ceiling -- codex's, on the specimen that surfaced it).\\n    Files touched counts unified-diff file headers (`diff --git a/...\\n    b/...`), the shape `git diff` produces.\\\"\\\"\\\"\\n    size = Path(path).stat().st_size\\n    lines = text.count(\\\"\\\\n\\\") + (1 if text and not text.endswith(\\\"\\\\n\\\") else 0)\\n    if not diff_like:\\n        return f\\\"`{path}` ({size} bytes, {lines} lines)\\\"\\n    files = sum(1 for l in text.splitlines() if l.startswith(\\\"diff --git \\\"))\\n    return f\\\"`{path}` ({size} bytes, {lines} lines, {files} files touched)\\\"\\n\\n\\ndef spec_sections() -> list[str]:\\n    \\\"\\\"\\\"The spec's Problem, Claims, and Criteria sections verbatim -- what\\n    both build and verify need to see, in the shape the spec contract\\n    (not this adapter) already gives them.\\\"\\\"\\\"\\n    spec_dir = Path(os.environ[\\\"ATTAVO_SPEC_DIR\\\"])\\n    lines = (spec_dir / \\\"spec.md\\\").read_text().splitlines()\\n    idx = [i for i, l in enumerate(lines) if l.startswith(\\\"## \\\")]\\n    headings = {lines[i].strip(): i for i in idx}\\n    bounds = sorted(idx) + [len(lines)]\\n\\n    def section(heading: str) -> str:\\n        start = headings[heading]\\n        end = bounds[bounds.index(start) + 1] if start in bounds else len(lines)\\n        return \\\"\\\\n\\\".join(lines[start:end]).strip()\\n\\n    return [section(\\\"## Problem\\\"), section(\\\"## Claims\\\"), section(\\\"## Criteria\\\")]\\n\\n\\ndef stub_note() -> str | None:\\n    \\\"\\\"\\\"None when ATTAVO_SPEC_DIR carries no stub/; else the sentence\\n    naming what a stub is (issue #90, closed by #93). The stub is\\n    evidence -- a criterion it satisfies trivially is weak -- but twice\\n    the judge reported\\n    a built tree as failing to match its stub as if the stub were the\\n    intended change (tenant zero #664, #644): one sentence of vocabulary\\n    was missing, not a smarter judge or a dropped stub.\\\"\\\"\\\"\\n    stub_dir = Path(os.environ[\\\"ATTAVO_SPEC_DIR\\\"]) / \\\"stub\\\"\\n    if not stub_dir.is_dir():\\n        return None\\n    return (\\n        f\\\"## The stub at `{stub_dir}`\\\\n\\\\n\\\"\\n        \\\"The stub is the fixture the acceptance criteria were shown to \\\"\\n        \\\"pass against; it is not the intended change. A difference \\\"\\n        \\\"between the built tree and the stub is not a finding: a \\\"\\n        \\\"criterion the stub satisfies trivially is.\\\")\\n\\n\\ndef build_instruction() -> str:\\n    parts = list(spec_sections())\\n\\n    rulings = read_text(\\\"ATTAVO_RULINGS\\\")\\n    if rulings.strip():\\n        parts.append(\\\"## Rulings\\\\n\\\\n\\\" + rulings.strip())\\n\\n    feedback_path = os.environ.get(\\\"ATTAVO_FEEDBACK\\\")\\n    feedback = read_text(\\\"ATTAVO_FEEDBACK\\\")\\n    if feedback.strip():\\n        parts.append(\\n            \\\"## Feedback from the previous attempt\\\\n\\\\n\\\"\\n            f\\\"The feedback is at {describe_file(feedback_path, feedback, diff_like=False)}. \\\"\\n            \\\"It is not inlined here: read it yourself with your own tools \\\"\\n            \\\"before continuing.\\\")\\n\\n    parts.append(\\n        \\\"commit your work on the current branch; if you cannot proceed \\\"\\n        \\\"without a decision that changes the criteria, do not guess: \\\"\\n        \\\"answer with status question\\\")\\n\\n    test_command = os.environ.get(\\\"ATTAVO_TEST_COMMAND\\\")\\n    if test_command:\\n        bound = os.environ.get(\\\"ATTAVO_TEST_TIMEOUT_S\\\")\\n        parts.append(\\n            f\\\"to run tests while you work, run `{test_command}`: it runs the tests \\\"\\n            \\\"selected for the files you have changed\\\"\\n            + (f\\\" and stops at {bound} s\\\" if bound else \\\"\\\")\\n            + \\\". Run a single test with `\\\" + test_command + \\\" <path or test id>`. \\\"\\n            \\\"Do not run the test runner directly, the whole test suite, or any \\\"\\n            \\\"whole-tree check yourself: when the criteria and \\\" + \\\"`\\\" + test_command + \\\"`\\\"\\n            + \\\" pass, commit and stop; the gates are run for you and any failure is \\\"\\n            \\\"returned to you on the next iteration\\\")\\n\\n    return \\\"\\\\n\\\\n\\\".join(parts)\\n\\n\\ndef verify_instruction() -> str:\\n    parts = list(spec_sections())\\n\\n    note = stub_note()\\n    if note:\\n        parts.append(note)\\n\\n    diff_path = os.environ.get(\\\"ATTAVO_DIFF\\\")\\n    diff = read_text(\\\"ATTAVO_DIFF\\\")\\n    if diff.strip():\\n        parts.append(\\n            \\\"## Diff since the approved spec\\\\n\\\\n\\\"\\n            f\\\"The diff is at {describe_file(diff_path, diff, diff_like=True)}. \\\"\\n            \\\"It is not inlined here: read it yourself with your own tools \\\"\\n            \\\"before judging it.\\\")\\n    else:\\n        parts.append(\\\"## Diff since the approved spec\\\\n\\\\n(the diff is empty)\\\")\\n\\n    build_record_path = os.environ.get(\\\"ATTAVO_BUILD_RECORD\\\")\\n    build_record = read_text(\\\"ATTAVO_BUILD_RECORD\\\")\\n    if build_record.strip():\\n        parts.append(\\n            \\\"## The build record\\\\n\\\\n\\\"\\n            f\\\"The build record is at {describe_file(build_record_path, build_record, diff_like=False)}. \\\"\\n            \\\"Read it yourself with your own tools.\\\")\\n\\n    parts.append(\\n        \\\"you are verifying a completed build, not building: make no edits, \\\"\\n        \\\"write no files, commit nothing. Read the diff named above against \\\"\\n        \\\"the criteria and name what the criteria do not assert but the diff \\\"\\n        \\\"should still be judged on, and name the tests that would assert \\\"\\n        \\\"it if they existed. A spec whose approval commit does not \\\"\\n        \\\"describe the working tree the build produced is itself a \\\"\\n        \\\"finding: the diff is judged against what was approved, and a \\\"\\n        \\\"divergence between them is reportable rather than assumed \\\"\\n        \\\"away. Report each as a finding: title, specimen (the file or \\\"\\n        \\\"commit the finding is about), retires (what having this \\\"\\n        \\\"finding on record replaces or closes -- every finding must \\\"\\n        \\\"carry one, or it is refused unfiled), rejection_test (the test \\\"\\n        \\\"that would catch a regression of it), and severity. Severity \\\"\\n        \\\"is derived rather than judged: the version, counter, \\\"\\n        \\\"condition, or state change that flips a finding from harmless \\\"\\n        \\\"to blocking; an adjective is not a severity. An empty \\\"\\n        \\\"findings list means you looked and found nothing to report, not \\\"\\n        \\\"that you did not look.\\\")\\n    return \\\"\\\\n\\\\n\\\".join(parts)\\n\\n\\ndef counsel_instruction() -> str:\\n    \\\"\\\"\\\"Issue #100 (extended by issue #175): a stop is read inside the\\n    product first, before a person. The record, its log, the diff, the\\n    forge's checks, the item's graph, the tenant manifest, and this\\n    product's own root are all handed by path -- named in the instruction\\n    instead of inlined, the same discipline verify_instruction already\\n    applies to the diff (issue #86), so this instruction's own size stays\\n    fixed whatever the record, log, diff, checks, or graph's size.\\\"\\\"\\\"\\n    parts = list(spec_sections())\\n\\n    rulings = read_text(\\\"ATTAVO_RULINGS\\\")\\n    if rulings.strip():\\n        parts.append(\\\"## Rulings\\\\n\\\\n\\\" + rulings.strip())\\n\\n    note = stub_note()\\n    if note:\\n        parts.append(note)\\n\\n    record_path = os.environ.get(\\\"ATTAVO_COUNSEL_RECORD\\\")\\n    record_text = read_text(\\\"ATTAVO_COUNSEL_RECORD\\\")\\n    if record_text.strip():\\n        parts.append(\\n            \\\"## The stage record\\\\n\\\\n\\\"\\n            f\\\"The record is at {describe_file(record_path, record_text, diff_like=False)}. \\\"\\n            \\\"Read it yourself with your own tools.\\\")\\n\\n    log_path = os.environ.get(\\\"ATTAVO_COUNSEL_LOG\\\")\\n    log_text = read_text(\\\"ATTAVO_COUNSEL_LOG\\\")\\n    if log_text.strip():\\n        parts.append(\\n            \\\"## The record's log\\\\n\\\\n\\\"\\n            f\\\"The log is at {describe_file(log_path, log_text, diff_like=False)}. \\\"\\n            \\\"Read it yourself with your own tools.\\\")\\n\\n    diff_path = os.environ.get(\\\"ATTAVO_COUNSEL_DIFF\\\")\\n    diff_text = read_text(\\\"ATTAVO_COUNSEL_DIFF\\\")\\n    if diff_text.strip():\\n        parts.append(\\n            \\\"## The item's diff since approval\\\\n\\\\n\\\"\\n            f\\\"The diff is at {describe_file(diff_path, diff_text, diff_like=True)}. \\\"\\n            \\\"Read it yourself with your own tools.\\\")\\n\\n    # issue #175: the forge in the evidence set. ATTAVO_COUNSEL_CHECKS is\\n    # always written, a JSON {read, reason, checks} envelope -- read false\\n    # names the missing manifest key rather than leaving the section out,\\n    # since an unread forge must never be mistaken for a green one.\\n    checks_path = os.environ.get(\\\"ATTAVO_COUNSEL_CHECKS\\\")\\n    checks_text = read_text(\\\"ATTAVO_COUNSEL_CHECKS\\\")\\n    if checks_text.strip():\\n        parts.append(\\n            \\\"## The forge's checks on this stop's sha\\\\n\\\\n\\\"\\n            f\\\"The checks are at {describe_file(checks_path, checks_text, diff_like=False)}: \\\"\\n            \\\"a JSON object -- read: false means the forge was not read at \\\"\\n            \\\"all (reason names the missing manifest key; treat this as \\\"\\n            \\\"unknown, never as green) -- read: true carries one entry per \\\"\\n            \\\"check, each naming, for a check that did not succeed, the \\\"\\n            \\\"path of its own failed-step log. Read the failing check's \\\"\\n            \\\"log before answering about the forge; a remedy that depends \\\"\\n            \\\"on the forge's state cites the check and its log line.\\\")\\n\\n    # issue #175: the graph in the evidence set -- the default branch's\\n    # own log since this item's branch point, this branch's own commits,\\n    # the markers and records present at the stop's sha, and the check\\n    # runs on the last three shas, so \\\"the checks are on the record\\n    # commit, not the code commit\\\" is readable without a terminal.\\n    graph_path = os.environ.get(\\\"ATTAVO_COUNSEL_GRAPH\\\")\\n    graph_text = read_text(\\\"ATTAVO_COUNSEL_GRAPH\\\")\\n    if graph_text.strip():\\n        parts.append(\\n            \\\"## The item's graph\\\\n\\\\n\\\"\\n            f\\\"The graph is at {describe_file(graph_path, graph_text, diff_like=False)}. \\\"\\n            \\\"Read it yourself with your own tools.\\\")\\n\\n    manifest_path = os.environ.get(\\\"ATTAVO_MANIFEST\\\", \\\"\\\")\\n    parts.append(f\\\"## The tenant manifest\\\\n\\\\nThe manifest is at `{manifest_path}`. \\\"\\n                 \\\"Read it yourself with your own tools.\\\")\\n\\n    product_root = os.environ.get(\\\"ATTAVO_PRODUCT_ROOT\\\", \\\"\\\")\\n    parts.append(\\n        \\\"## The product's own root\\\\n\\\\n\\\"\\n        f\\\"The product that ran this stage is at `{product_root}` \\\"\\n        \\\"(`bin/attavo`, `adapters/`, `schema/`, `templates/`). A stop \\\"\\n        \\\"whose cause is the product's own mechanism, not the tenant's, \\\"\\n        \\\"is read here.\\\")\\n\\n    # issue #175: attavo counsel N --ask hands the operator's own text as\\n    # the question to answer, over the same evidence set, rather than\\n    # diagnosing a stop -- the record above is context, not necessarily a\\n    # failure.\\n    question = os.environ.get(\\\"ATTAVO_COUNSEL_QUESTION\\\", \\\"\\\")\\n    if question.strip():\\n        parts.append(\\n            \\\"## The operator's question\\\\n\\\\n\\\" + question.strip() +\\n            \\\"\\\\n\\\\nAnswer this question using the evidence above; the \\\"\\n            \\\"record named above is context, not necessarily a failure.\\\")\\n\\n    parts.append(\\n        \\\"you are counseling a stop, read-only: make no edits, write no \\\"\\n        \\\"files, commit nothing. Read the record, its log, the spec, the \\\"\\n        \\\"rulings, the diff, the forge's checks, the item's graph, the \\\"\\n        \\\"tenant manifest, and the product's own root named above with \\\"\\n        \\\"your own tools, then answer with exactly one class (the stop's \\\"\\n        \\\"class, or \\\\\\\"unclassed\\\\\\\"), one verdict -- \\\\\\\"answer\\\\\\\" (the stop is \\\"\\n        \\\"answerable inside the rules: a ruling text, in \\\"\\n        \\\"proposal.ruling_text, with three citations -- instruction, \\\"\\n        \\\"mechanism, guard, each a path and symbol or a ruling id), \\\"\\n        \\\"\\\\\\\"patch\\\\\\\" (the stop is a product defect: the mechanism's file \\\"\\n        \\\"and symbol, a rejection test, and a unified diff, in \\\"\\n        \\\"proposal.patch -- or, when the remedy is better filed as an \\\"\\n        \\\"item than shipped as a diff, a title and a body in this \\\"\\n        \\\"repository's own issue format -- a Severity/Provenance line, \\\"\\n        \\\"then Problem, Retires, Change, and Acceptance sections -- in \\\"\\n        \\\"proposal.issue), or \\\\\\\"person\\\\\\\" (the answer would touch the \\\"\\n        \\\"definition of done and no rule covers it: the question restated \\\"\\n        \\\"in one line, in proposal.question -- or, when the remedy is \\\"\\n        \\\"better filed as an item than asked as a bare question, a title \\\"\\n        \\\"and a body in the same issue format, in proposal.issue) -- and \\\"\\n        \\\"citations for whichever verdict you gave. You propose; you do \\\"\\n        \\\"not act.\\\")\\n    return \\\"\\\\n\\\\n\\\".join(parts)\\n\\n\\nBUILD_ALLOWED_TOOLS = [\\\"Read\\\", \\\"Edit\\\", \\\"Write\\\", \\\"Bash\\\"]\\n\\n# Item 229's third attempt: 2,754 s and $6.54 to write the right change and\\n# be refused at the gate for one path the spec's Claims did not name. The\\n# gate stays the law, but the boundary is told at the edit: the build's\\n# Edit and Write are allowed on the claimed paths only, as permission\\n# rules built from the spec's own Claims list, so an edit outside them is\\n# refused by the tool at the moment it is tried and the executor's recourse\\n# is the one it has for anything outside the spec -- a question.\\nBUILD_FIXED_TOOLS = [\\\"Read\\\", \\\"Bash\\\"]\\n\\n\\ndef claimed_paths() -> list[str]:\\n    \\\"\\\"\\\"The spec's Claims, one path or glob per line under '## Claims', as\\n    the spec contract writes them (attavo/spec.py's parse_spec reads the\\n    same lines).\\\"\\\"\\\"\\n    spec_dir = os.environ.get(\\\"ATTAVO_SPEC_DIR\\\")\\n    if not spec_dir:\\n        return []\\n    try:\\n        lines = (Path(spec_dir) / \\\"spec.md\\\").read_text().splitlines()\\n    except OSError:\\n        return []\\n    claims: list[str] = []\\n    inside = False\\n    for line in lines:\\n        if line.startswith(\\\"## \\\"):\\n            inside = line.strip() == \\\"## Claims\\\"\\n            continue\\n        if inside and line.strip().startswith(\\\"- \\\"):\\n            claims.append(line.strip()[2:].strip())\\n    return claims\\n\\n\\ndef claim_rule(claim: str) -> str:\\n    \\\"\\\"\\\"A claim as a permission-rule path: a directory claim (trailing\\n    slash) covers everything under it.\\\"\\\"\\\"\\n    return claim + \\\"**\\\" if claim.endswith(\\\"/\\\") else claim\\n\\n\\ndef build_allowed_tools() -> list[str]:\\n    claims = claimed_paths()\\n    if not claims:\\n        return BUILD_ALLOWED_TOOLS\\n    rules = [f\\\"{tool}({claim_rule(c)})\\\" for c in claims for tool in (\\\"Edit\\\", \\\"Write\\\")]\\n    return BUILD_FIXED_TOOLS + rules\\nVERIFY_ALLOWED_TOOLS = [\\\"Read\\\", \\\"Bash\\\"]\\n\\n# Issue #88 (class B): both tools the tool's own reply named as a way to\\n# spawn work that outlives this invocation -- confirmed live against\\n# `claude 2.1.269` (see module docstring). Named on both stages: verify's\\n# own allowed tools never included either, and did not stop the\\n# specimen either.\\nSUBAGENT_TOOLS = [\\\"Agent\\\", \\\"Workflow\\\"]\\n\\n# Items 227 and 229: the executor started `attavo test` in the background,\\n# loaded Monitor to tail its output file, scheduled wakeups to wait for it,\\n# and on 227 answered done while the wait was still open. Both let the\\n# invocation outlive its own answer, the same reason the subagent tools\\n# are denied.\\nOUTLIVING_TOOLS = [\\\"Monitor\\\", \\\"ScheduleWakeup\\\"]\\n\\n# The raw test runner and the product's transport are not the executor's\\n# tools: `attavo test` is the one test command (issue #212) and the pass\\n# is the one transport. Permission-rule patterns, prefix-matched by the\\n# tool; the product refuses its transport on its own account too\\n# (ATTAVO_STAGE), so the second half here is belt beside braces.\\nDENIED_COMMANDS = [\\\"Bash(pytest:*)\\\", \\\"Bash(python3 -m pytest:*)\\\", \\\"Bash(python -m pytest:*)\\\",\\n                   \\\"Bash(npm test:*)\\\", \\\"Bash(npx vitest:*)\\\", \\\"Bash(go test:*)\\\", \\\"Bash(cargo test:*)\\\",\\n                   \\\"Bash(attavo drive:*)\\\", \\\"Bash(attavo worker:*)\\\"]\\n\\n\\ndef load_config() -> dict:\\n    raw = os.environ.get(\\\"ATTAVO_ADAPTER_CONFIG\\\")\\n    return json.loads(raw) if raw else {}\\n\\n\\ndef refused_config_key(config: dict) -> str | None:\\n    \\\"\\\"\\\"None if config carries no retired key; else the refusal message.\\n    allowed_tools (issue #78) is retired, not ignored: the sandbox is the\\n    boundary now, a curated Bash(...) prefix list is not, and a manifest\\n    still naming it must be refused rather than silently accepted.\\\"\\\"\\\"\\n    if \\\"allowed_tools\\\" in config:\\n        return (\\\"[executor.claude-code].allowed_tools is retired (issue \\\"\\n                \\\"#78) -- the sandbox is the boundary now, not a curated \\\"\\n                \\\"Bash(...) prefix list\\\")\\n    return None\\n\\n\\n# Issue #93: claude code publishes no numeric input-size ceiling\\n# anywhere in its own surface (--help, docs, or any config file,\\n# confirmed against claude 2.1.269) -- unlike codex's documented\\n# input_too_large. This adapter asserts its own instruction stays under\\n# a fixed bound instead of a tool-documented one, so an undeclared tool\\n# still cannot be handed an unbounded prompt.\\nFIXED_BOUND_CHARS = 65_536\\n\\n\\ndef input_limit_chars() -> int:\\n    \\\"\\\"\\\"The bound this adapter enforces in place of a declared ceiling.\\n    Overridable only for tests via ATTAVO_ADAPTER_INPUT_LIMIT_CHARS --\\n    never a tenant knob: the ceiling is a fact about the tool, not\\n    something [executor.claude-code] can set.\\\"\\\"\\\"\\n    override = os.environ.get(\\\"ATTAVO_ADAPTER_INPUT_LIMIT_CHARS\\\")\\n    return int(override) if override else FIXED_BOUND_CHARS\\n\\n\\ndef ceiling_refusal(instruction: str) -> str | None:\\n    \\\"\\\"\\\"None if instruction stays at or under the fixed bound; else the\\n    refusal naming both numbers, checked before claude is ever invoked.\\\"\\\"\\\"\\n    limit = input_limit_chars()\\n    size = len(instruction)\\n    if size <= limit:\\n        return None\\n    return (f\\\"ceiling exceeded -- instruction is {size} chars, over \\\"\\n           f\\\"the fixed bound of {limit} chars (claude code declares no \\\"\\n           f\\\"input limit of its own)\\\")\\n\\n\\nREAD_ONLY_STAGES = (\\\"verify\\\", \\\"counsel\\\")\\n\\n\\ndef sandbox_settings(stage: str, working_directory: Path) -> dict:\\n    \\\"\\\"\\\"Every Bash command and its children stay confined to\\n    working_directory (writes) and the network stays closed for every\\n    stage (issue #78) -- confirmed live, not assumed. verify and counsel\\n    (issue #100) additionally deny writes to working_directory itself,\\n    making \\\"make no edits, write no files\\\" mechanical rather than merely\\n    instructed -- counsel is a read-only invocation, the same sandbox\\n    verify runs under.\\n    \\\"\\\"\\\"\\n    sandbox = {\\n        \\\"enabled\\\": True,\\n        \\\"allowUnsandboxedCommands\\\": False,\\n        \\\"network\\\": {\\\"allowedDomains\\\": []},\\n    }\\n    if stage in READ_ONLY_STAGES:\\n        sandbox[\\\"filesystem\\\"] = {\\\"denyWrite\\\": [str(working_directory)]}\\n    return {\\\"sandbox\\\": sandbox}\\n\\n\\n# Items 227 and 229: Claude Code's Bash foreground is two minutes while one\\n# test call is [tests].call_timeout_s (240), so the executor wrapped runs in\\n# `timeout N` and backgrounded them. The product exports that bound as\\n# ATTAVO_TEST_TIMEOUT_S; the foreground is set to fit one run plus a margin.\\nFOREGROUND_MARGIN_S = 60\\n\\n\\ndef foreground_env() -> dict[str, str]:\\n    \\\"\\\"\\\"The variables this adapter sets itself for its executor: the Bash\\n    foreground and its ceiling, from ATTAVO_TEST_TIMEOUT_S. None when no\\n    bound was exported.\\\"\\\"\\\"\\n    bound = os.environ.get(\\\"ATTAVO_TEST_TIMEOUT_S\\\")\\n    if not bound:\\n        return {}\\n    try:\\n        millis = str((int(bound) + FOREGROUND_MARGIN_S) * 1000)\\n    except ValueError:\\n        return {}\\n    return {\\\"BASH_DEFAULT_TIMEOUT_MS\\\": millis, \\\"BASH_MAX_TIMEOUT_MS\\\": millis}\\n\\n\\ndef build_command(instruction: str, config: dict, schema: dict, stage: str) -> list[str]:\\n    auth = config.get(\\\"auth\\\", \\\"api\\\")\\n    allowed_tools = VERIFY_ALLOWED_TOOLS if stage in READ_ONLY_STAGES else build_allowed_tools()\\n    # acceptEdits approves every edit before an allow rule is consulted;\\n    # with claimed-path rules in force the mode is default, so a claimed\\n    # edit is approved by its rule and an unclaimed one asks -- and a\\n    # headless -p run answers no. The tenant may still set the mode.\\n    claimed_rules = stage not in READ_ONLY_STAGES and allowed_tools is not BUILD_ALLOWED_TOOLS\\n    permission_mode = config.get(\\\"permission_mode\\\", \\\"default\\\" if claimed_rules else \\\"acceptEdits\\\")\\n\\n    cmd = [\\\"claude\\\"]\\n    if auth == \\\"subscription\\\":\\n        # no --bare: this is the tenant's own login, not a bare API key, so\\n        # the tenant's project hooks and MCP servers must not load -- only\\n        # --setting-sources (CLAUDE.md still loads) and --strict-mcp-config\\n        # keep them out, the same isolation --bare gives in api mode.\\n        setting_sources = config.get(\\\"settin\",\"stderr\":\"\",\"interrupted\":false,\"isImage\":false,\"noOutputExpected\":false,\"persistedOutputPath\":\"/Users/davidbean/.claude/projects/-Users-davidbean-Projects-attavo-worktree-288/aa97438b-e700-4e9e-85e2-1d5bd8de4b83/tool-results/b1zescu67.txt\",\"persistedOutputSize\":54641}}\n+{\"type\":\"assistant\",\"message\":{\"model\":\"claude-sonnet-5\",\"id\":\"msg_011CfYpzehhgvo2ZMQVtA4SE\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"thinking\",\"thinking\":\"\",\"signature\":\"\"}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":1023,\"cache_read_input_tokens\":52364,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":1023},\"output_tokens\":3,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"aa97438b-e700-4e9e-85e2-1d5bd8de4b83\",\"uuid\":\"c39ec057-7315-4122-a072-78aaf75b6210\",\"timestamp\":\"2026-09-30T02:23:14.612Z\",\"request_id\":\"req_011CfYpzeMbv8GSaDL17J2Ro\"}\n+{\"type\":\"assistant\",\"message\":{\"model\":\"claude-sonnet-5\",\"id\":\"msg_011CfYpzehhgvo2ZMQVtA4SE\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_01JCi8yQ3CM7zETrQ6LFNZfr\",\"name\":\"Bash\",\"input\":{\"command\":\"diff -u adapters/claude-code/run attest/specs/288/stub/adapters/claude-code/run\"},\"caller\":{\"type\":\"direct\"}}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":1023,\"cache_read_input_tokens\":52364,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":1023},\"output_tokens\":3,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\
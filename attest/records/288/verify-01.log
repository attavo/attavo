ke_once(cmd: list[str], responses: list[dict] | None, call_index: int,\n     raw, result, returncode = invoke_stream(cmd, events_path, load_canned_stream())\n     if raw.strip():\n         print(raw)\n+    auth = auth_failure(raw)\n+    if auth is not None:\n+        print(json.dumps({\"class\": \"environment\", \"detail\": auth}))\n+        return 1, None\n     if returncode != 0:\n         return returncode, None\n     if result is None:\ndiff --git a/attest/records/288/approval-01.json b/attest/records/288/approval-01.json\nnew file mode 100644\nindex 0000000..78619ee\n--- /dev/null\n+++ b/attest/records/288/approval-01.json\n@@ -0,0 +1,10 @@\n+{\n+  \"sha\": \"78149b4d83b76e62e2a5fe03fd4a204f9221b7aa\",\n+  \"spec_sha\": \"fd5d0fe7b812e3945ef9b4f466c51f3f2f2a6640\",\n+  \"approved_by\": \"dbean10\",\n+  \"at\": \"2026-09-30T02:22:44Z\",\n+  \"record_version\": 2,\n+  \"item\": \"288\",\n+  \"product_version\": \"v0.31.0\",\n+  \"product_pin\": \"v0.31.0\"\n+}\ndiff --git a/attest/records/288/build-01.json b/attest/records/288/build-01.json\nnew file mode 100644\nindex 0000000..d5abcd7\n--- /dev/null\n+++ b/attest/records/288/build-01.json\n@@ -0,0 +1,58 @@\n+{\n+  \"sha\": \"b422183faa30d6af806843c22cbe9a016f64dfd6\",\n+  \"start_sha\": \"c68f633049df308fdbec9d092d6cab9587d955cd\",\n+  \"spec_sha\": \"fd5d0fe7b812e3945ef9b4f466c51f3f2f2a6640\",\n+  \"approval_sha\": \"78149b4d83b76e62e2a5fe03fd4a204f9221b7aa\",\n+  \"at\": \"2026-09-30T02:24:19Z\",\n+  \"adapter\": \"claude-code\",\n+  \"adapter_config\": {\n+    \"auth\": \"subscription\",\n+    \"model\": \"claude-sonnet-5\"\n+  },\n+  \"executor_identity\": {\n+    \"name\": \"attavo executor (claude-code)\",\n+    \"email\": \"executor+claude-code@attavo.invalid\"\n+  },\n+  \"reports\": [\n+    \"tokens\",\n+    \"cost_usd\"\n+  ],\n+  \"adapter_version\": \"2.1.285 (Claude Code)\",\n+  \"model\": \"claude-sonnet-5\",\n+  \"model_version\": \"claude-sonnet-5\",\n+  \"iterations\": 1,\n+  \"criteria\": [\n+ 
\"session_id\":\"aa97438b-e700-4e9e-85e2-1d5bd8de4b83\",\"uuid\":\"66915d6a-6c87-49f4-ad0c-bb1ff588cbd1\",\"timestamp\":\"2026-09-30T02:23:29.529Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/davidbean/Projects/attavo-worktree-288/tests/test_adapter_claude_code.py\",\"content\":\"def test_claude_code_no_events_file_when_atavo_events_is_unset(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"An adapter invocation with no ATTAVO_EVENTS writes no events file\\n    -- the mapping only ever writes to a path the product handed it.\\\"\\\"\\\"\\n    run = run_with_stream(tmp_path, STREAM_LINES, events=False)\\n    assert run.returncode == 0, run.stdout + run.stderr\\n    assert not (tmp_path / \\\"events.jsonl\\\").exists()\\n\\n\\ndef test_claude_code_stream_missing_result_line_fails(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"A 0-exit stream that never carries a terminal \\\"result\\\" line is a\\n    failure, the same class build already treats a tool error or an\\n    absent structured_output as -- not a crash, and not a silent pass.\\\"\\\"\\\"\\n    stream = [{\\\"type\\\": \\\"assistant\\\", \\\"message\\\": {\\\"content\\\": [\\n        {\\\"type\\\": \\\"text\\\", \\\"text\\\": \\\"still working\\\"}]}}]\\n    run = run_with_stream(tmp_path, stream)\\n    assert run.returncode == 1\\n\",\"numLines\":17,\"startLine\":140,\"totalLines\":156}}}\n+{\"type\":\"assistant\",\"message\":{\"model\":\"claude-sonnet-5\",\"id\":\"msg_011CfYq1somo7RWETAvbL9gx\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"Let me check that `Any` is imported in the test file (used in the stub's type annotation).\"}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":567,\"cache_read_input_tokens\":56511,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":567},\"output_tokens\":4,\"service_tier\":\"standard\",\
{"type":"item.started","item":{"id":"item_1","type":"command_execution","command":"/bin/zsh -lc \"git diff --stat cfd3b9cbbf464c045f1ff37b1a6da040a229a7d9 b862f4f30f432b56a72b6475f664f885d95a1af6; git diff --name-status cfd3b9cbbf464c045f1ff37b1a6da040a229a7d9 b862f4f30f432b56a72b6475f664f885d95a1af6; sed -n '1,220p' attavo/attest.py; sed -n '610,780p' attavo/doctor.py; sed -n '1,280p' tests/test_attest_time.py; sed -n '1,280p' tests/test_doctor_sealed.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_1","type":"command_execution","command":"/bin/zsh -lc \"git diff --stat cfd3b9cbbf464c045f1ff37b1a6da040a229a7d9 b862f4f30f432b56a72b6475f664f885d95a1af6; git diff --name-status cfd3b9cbbf464c045f1ff37b1a6da040a229a7d9 b862f4f30f432b56a72b6475f664f885d95a1af6; sed -n '1,220p' attavo/attest.py; sed -n '610,780p' attavo/doctor.py; sed -n '1,280p' tests/test_attest_time.py; sed -n '1,280p' tests/test_doctor_sealed.py\"","aggregated_output":"git: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-yYcaTWaz' (errno=Operation not permitted)\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-Gi8IZI1a' (errno=Operation not permitted)\n attavo/attest.py                    |  3 +-\n attavo/doctor.py                    | 80 +++++++++++++++++++++++++++++-------\n attest/records/204/approval-01.json | 10 +++++\n attest/records/204/build-01.started |  7 ++++\n attest/records/204/spec-01.json     | 29 +++++++++++++\n tests/test_attest_time.py           | 82 ++++++++++++++++++++++++++++++++++++-\n 6 files changed, 194 insertions(+), 17 deletions(-)\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-3bobnMd7' (errno=Operation not permitted)\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-RqwCziLq' (errno=Operation not permitted)\nM\tattavo/attest.py\nM\tattavo/doctor.py\nA\tattest/records/204/approval-01.json\nA\tattest/records/204/build-01.started\nA\tattest/records/204/spec-01.json\nM\ttests/test_attest_time.py\nfrom __future__ import annotations\n\nimport json\nimport sys\nfrom datetime import datetime\nfrom pathlib import Path\nfrom typing import Any, cast\n\nfrom attavo.common import MANIFEST, git, now_iso, product_version, read_manifest\nfrom attavo.records import latest_attempt_path, latest_record, parse_attempts\nfrom attavo.types import (ApprovalRecord, AttestRecord, BuildRecord, ItemCost, ItemTime,\n                          SpecRecord, StageTime, VerifyRecord)\n\n# --- attest: the signed envelope over one item's whole traversal ---\n\ndef derive_attest_items(root: Path, records_rel: str) -> tuple[set[str], str | None]:\n    \"\"\"The item ids from the merge commit's own first-parent diff -- record\n    paths under records_rel/<N>/, not a branch name, which a squash merge\n    discards and which names a forge's convention the product does not\n    know. Returns (items, None), else (empty set, reason) only when the\n    diff itself could not be read -- zero items found is not an error\n    here (issue #58): not every merge is an item merge, and the caller\n    decides what zero, one, or more than one means.\"\"\"\n    try:\n        changed = git(root, \"diff\", \"--name-only\", \"HEAD^1\", \"HEAD\").splitlines()\n    except RuntimeError as exc:\n        return set(), f\"git: {exc}\"\n    prefix = records_rel.rstrip(\"/\") + \"/\"\n    items: set[str] = set()\n    for p in changed:\n        if p.startswith(prefix):\n            rest = p[len(prefix):]\n            item = rest.split(\"/\", 1)[0]\n            if item:\n                items.add(item)\n    return items, None\n\n\nINVOCATION_STAGES = (\"build\", \"verify\", \"counsel\")\n\n\ndef _is_number(value: Any) -> bool:\n    return isinstance(value, (int, float)) and not isinstance(value, bool)\n\n\ndef item_time_and_cost(records_dir: Path, sealed_at_epoch: int | None) -> tuple[ItemTime, ItemCost]:\n    \"\"\"The item's accounting, summed from the records attest already reads\n    (issue: a view showed #158 as 20 minutes, its final build plus its final\n    verify, where its nineteen invocations ran 115): every build, verify,\n    and counsel attempt's wall_clock_s and cost_usd, per stage and for the\n    item, never the final attempt alone. A record that carries no number\n    is named in not_read and makes each sum it belongs to partial --\n    absent is never zero. lead_s runs from the first approval record's\n    `at` to sealed_at_epoch (the committer time of the commit the statement\n    is computed at); both it and waiting_s are None when either end cannot\n    be read. doctor's sixth proof calls this same function over the same\n    records, sealed at the same commit, and fails a sealed statement any\n    field of whose time or cost is not what this returns.\"\"\"\n    stages: dict[str, StageTime] = {}\n    time_not_read: list[str] = []\n    cost_not_read: list[str] = []\n    by_stage: dict[str, float] = {}\n    by_adapter: dict[str, float] = {}\n    for stage in INVOCATION_STAGES:\n        attempts = parse_attempts(records_dir, stage)\n        seconds = 0.0\n        partial = False\n        for n, rec in sorted(attempts.items()):\n            name = f\"{stage}-{n:02d}\"\n            wall = rec.get(\"wall_clock_s\")\n            if _is_number(wall):\n                seconds += float(wall)\n            else:\n                partial = True\n                time_not_read.append(name)\n            cost = rec.get(\"cost_usd\")\n            if _is_number(cost):\n                by_stage[stage] = by_stage.get(stage, 0.0) + float(cost)\n                adapter = rec.get(\"adapter\")\n                key = adapter if isinstance(adapter, str) and adapter else \"not read\"\n                by_adapter[key] = by_adapter.get(key, 0.0) + float(cost)\n            else:\n                cost_not_read.append(name)\n        stages[stage] = {\"attempts\": len(attempts), \"invocation_s\": round(seconds, 3),\n                         \"partial\": partial}\n\n    invocation_s = round(sum(st[\"invocation_s\"] for st in stages.values()), 3)\n    lead_s: float | None = None\n    first_approval = parse_attempts(records_dir, \"approval\")\n    if first_approval and sealed_at_epoch is not None:\n        at = first_approval[min(first_approval)].get(\"at\")\n        try:\n            approved = datetime.fromisoformat(str(at).replace(\"Z\", \"+00:00\"))\n            lead_s = round(sealed_at_epoch - approved.timestamp(), 3)\n        except ValueError:\n            time_not_read.append(f\"approval-{min(first_approval):02d}\")\n    item_time: ItemTime = {\n        \"build\": stages[\"build\"], \"verify\": stages[\"verify\"], \"counsel\": stages[\"counsel\"],\n        \"invocation_s\": invocation_s,\n        \"lead_s\": lead_s,\n        \"waiting_s\": None if lead_s is None else round(lead_s - invocation_s, 3),\n        \"partial\": any(st[\"partial\"] for st in stages.values()),\n        \"not_read\": time_not_read,\n    }\n    item_cost: ItemCost = {\n        \"usd\": round(sum(by_stage.values()), 6),\n        \"by_stage_usd\": {k: round(v, 6) for k, v in by_stage.items()},\n        \"by_adapter_usd\": {k: round(v, 6) for k, v in by_adapter.items()},\n        \"partial\": bool(cost_not_read),\n        \"not_read\": cost_not_read,\n    }\n    return item_time, item_cost\n\n\nNOT_YET = object()\n\nChainRecords = tuple[SpecRecord, ApprovalRecord, BuildRecord, VerifyRecord]\n\n\ndef check_attest_chain(records_dir: Path, item_id: str, partial: bool = False\n                       ) -> tuple[ChainRecords | object | None, str | None]:\n    \"\"\"The two assertions attavo attest refuses on: the latest spec,\n    approval, build, and verify records for item_id all exist, and\n    build's approval_sha names the latest approval -- a re-approval after\n    a build must force a re-run of what changed. Returns (None, message)\n    on either of them, the message being the same text attest prints, not\n    a copy of it a caller re-types (issue #74: proof two reuses it);\n    returns ((spec, approval, build, verify), None) when the chain holds.\n\n    A verify record can only name a build that existed when it was\n    written (issue #109), so a latest verify whose build_sha is not the\n    latest build's sha is never a corrupt chain -- it is a verify\n    superseded by a later build, and is treated as absent: the next\n    stage is verify, not a refusal, exactly as if no verify record\n    existed yet.\n\n    partial (issue #67) is for a pull request, where a later stage's\n    record cannot exist yet because the stage that would produce it is\n    itself waiting on this check. Under partial, a missing (or\n    superseded) record is not a refusal -- the chain assertion still\n    runs over whatever records exist, and (NOT_YET, message) is\n    returned, the message naming the item and the stages present and\n    absent -- or, for a superseded verify, the superseded record and the\n    build it named -- when a stage is still missing once that assertion\n    holds.\"\"\"\n    latest_spec = latest_record(records_dir, \"spec\")\n    latest_approval = latest_record(records_dir, \"approval\")\n    latest_build = latest_record(records_dir, \"build\")\n    latest_verify = latest_record(records_dir, \"verify\")\n\n    # A verify naming a sha other than the latest build's is superseded:\n    # treated as absent for the chain, never as a mismatch.\n    superseded = None\n    if latest_build is not None and latest_verify is not None:\n        named_sha = latest_verify.get(\"build_sha\")\n        if named_sha != latest_build.get(\"sha\"):\n            verify_n = max(parse_attempts(records_dir, \"verify\"))\n            build_attempts = parse_attempts(records_dir, \"build\")\n            named_build_n = next((n for n, rec in build_attempts.items()\n                                  if rec.get(\"sha\") == named_sha), None)\n            named_build = f\"build-{named_build_n:02d}\" if named_build_n is not None else named_sha\n            superseded = (verify_n, named_sha, named_build, max(build_attempts))\n            latest_verify = None\n\n    stages = ((\"spec\", latest_spec), (\"approval\", latest_approval),\n              (\"build\", latest_build), (\"verify\", latest_verify))\n\n    if not partial:\n        for stage, rec in stages:\n            if rec is None:\n                if stage == \"verify\" and superseded is not None:\n                    verify_n, named_sha, _, _ = superseded\n                    return None, (f\"no verify names the latest build \"\n                                 f\"(verify-{verify_n:02d} names {named_sha})\")\n                return None, f\"no {stage} record for item {item_id}\"\n\n    if latest_approval is not None and latest_build is not None:\n        if latest_build.get(\"approval_sha\") != latest_approval.get(\"sha\"):\n            return None, (\"build's approval_sha does not name the latest approval; a \"\n                          \"re-approval after the build must force a re-run\")\n\n    missing = [stage for stage, rec in stages if rec is None]\n    if partial and missing:\n        present = [stage for stage, rec in stages if rec is not None]\n        if missing == [\"verify\"] and superseded is not None:\n            verify_n, _, named_build, latest_build_n = superseded\n            return NOT_YET, (f\"item {item_id} not yet (present: {', '.join(present) or 'none'}; \"\n                             f\"verify-{verify_n:02d} names {named_build}, \"\n                             f\"superseded by build-{latest_build_n:02d})\")\n        return NOT_YET, (f\"item {item_id} not yet (present: {', '.join(present) or 'none'}; \"\n                         f\"absent: {', '.join(missing)})\")\n\n    # Every record is present here: without partial, the loop above refused on\n    # a missing one; with partial, `missing` non-empty returned NOT_YET.\n    return cast(ChainRecords, (latest_spec, latest_approval, latest_build, latest_verify)), None\n\n\ndef cmd_attest(argv: list[str]) -> int:\n    partial = \"--partial\" in argv\n    positional = [a for a in argv if not a.startswith(\"--\")]\n    unknown = [a for a in argv if a.startswith(\"--\") and a != \"--partial\"]\n    if unknown:\n        print(f\"attavo attest: unknown argument {unknown[0]!r}\", file=sys.stderr)\n        return 2\n\n    root = Path(\".\").resolve()\n    m = read_manifest(root)\n    if m is None:\n        print(f\"attavo attest: no {MANIFEST} at {root}\", file=sys.stderr)\n        return 2\n\n    records_rel = m[\"paths\"][\"records\"]\n    item_id = positional[0] if positional else None\n    if item_id is None:\n        items, err = derive_attest_items(root, records_rel)\n        if err:\n            print(f\"attavo attest: refused: {err}\", file=sys.stderr)\n            return 1\n        # Not every merge is an item merge -- a merge that carries no item\n        # at all is an ordinary fact, not a defect (issue #58); the\n\ndef statement_for(root: Path, cmd: str, merge_sha: str) -> tuple[dict[str, Any] | None, int]:\n    \"\"\"The statement the forge holds for merge_sha and the command's exit\n    code. The statement is None when the command exits non-zero or prints\n    anything but a JSON object -- exit 2 means the store itself could not\n    be read (issue #158, amended after build-05: distinct from exit 1,\n    the store read fine and simply held no statement).\"\"\"\n    run = subprocess.run(cmd, shell=True, cwd=str(root), input=merge_sha + \"\\n\",\n                         capture_output=True, text=True, check=False)\n    if run.returncode != 0:\n        return None, run.returncode\n    try:\n        parsed = json.loads(run.stdout)\n    except ValueError:\n        return None, run.returncode\n    return (parsed if isinstance(parsed, dict) else None), run.returncode\n\n\ndef _is_ancestor(root: Path, earlier: str, later: str) -> bool:\n    run = subprocess.run([\"git\", \"-C\", str(root), \"merge-base\", \"--is-ancestor\", earlier, later],\n                         capture_output=True, check=False)\n    return run.returncode == 0\n\n\n# Maps whose keys are the records' data (a stage or an adapter that cost\n# something), not a release's fields: a key missing from one is a difference.\nDATA_KEYED = (\"by_stage_usd\", \"by_adapter_usd\")\n\n\ndef _same(stated: Any, summed: Any) -> bool:\n    \"\"\"Equal as the accounting means it: a number equals a number of the\n    same value (a store may print 40.0 as 40), a bool equals only a bool,\n    and a list is equal member by member. No tolerance: both sides are the\n    same function's rounding of the same records.\"\"\"\n    if isinstance(stated, bool) or isinstance(summed, bool):\n        return isinstance(stated, bool) and isinstance(summed, bool) and stated == summed\n    if isinstance(stated, (int, float)) and isinstance(summed, (int, float)):\n        return float(stated) == float(summed)\n    if isinstance(stated, list) and isinstance(summed, list):\n        return len(stated) == len(summed) and all(_same(a, b) for a, b in zip(stated, summed))\n    return type(stated) is type(summed) and bool(stated == summed)\n\n\ndef _differences(path: str, stated: Any, summed: Any, keyed_by_data: bool = False) -> list[str]:\n    \"\"\"Every field of `stated` that is not what its records sum to, named by\n    its path. Only the keys the statement carries are compared, at every\n    depth, so a field a later release adds is not demanded of a statement\n    sealed before it; a key it carries that the function does not produce\n    is a difference.\"\"\"\n    if not (isinstance(stated, dict) and isinstance(summed, dict)):\n        return [] if _same(stated, summed) else [f\"{path} {stated!r} is not its records' {summed!r}\"]\n    found: list[str] = []\n    for key in sorted(stated):\n        if key not in summed:\n            found.append(f\"{path}.{key} {stated[key]!r} is not a field its records sum to\")\n        else:\n            found += _differences(f\"{path}.{key}\", stated[key], summed[key], key in DATA_KEYED)\n    if keyed_by_data:\n        found += [f\"{path}.{key} is absent; its records sum to {summed[key]!r}\"\n                  for key in sorted(summed.keys() - stated.keys())]\n    return found\n\n\ndef _accounting_disagrees(root: Path, item_records_dir: Path, item: str, merge_sha: str,\n                          statement: dict[str, Any]) -> str | None:\n    \"\"\"A sealed statement that carries `time` and `cost` says what its\n    records sum to, field by field -- the same function attest summed them\n    with, over the same records (none is written after a merge), sealed at\n    the same commit (the statement is computed at the merge, so lead_s and\n    waiting_s are recomputed from its committer time, not excepted). Exact:\n    #202 retired the one-second tolerance. A statement sealed before `time`\n    existed carries neither block and is not checked; one block without the\n    other is a disagreement. No new read of the store.\"\"\"\n    inner = statement.get(\"predicate\")\n    predicate = inner if isinstance(inner, dict) else statement\n    stated_time, stated_cost = predicate.get(\"time\"), predicate.get(\"cost\")\n    if stated_time is None and stated_cost is None:\n        return None\n    where = f\"item {item} merged at {merge_sha[:12]}\"\n    if not isinstance(stated_time, dict) or not isinstance(stated_cost, dict):\n        return f\"{where}: the statement carries one of time and cost without the other\"\n    try:\n        sealed_at: int | None = int(git(root, \"show\", \"-s\", \"--format=%ct\", merge_sha).strip())\n    except (RuntimeError, ValueError):\n        sealed_at = None\n    summed_time, summed_cost = item_time_and_cost(item_records_dir, sealed_at)\n    differing = (_differences(\"time\", stated_time, dict(summed_time))\n                 + _differences(\"cost\", stated_cost, dict(summed_cost)))\n    if differing:\n        return f\"{where}: the statement's \" + \"; \".join(differing)\n    return None\n\n\ndef proof_every_attested_item_is_sealed(root: Path, m: dict[str, Any] | None) -> Proof:\n    p = Proof(\"every-attested-item-is-sealed\", \"every attested item has its statement in the store\")\n    if m is None:\n        return p.fail(f\"no {MANIFEST} at {root}; no records directory is declared\")\n    cmd = attestation_command(m)\n    if cmd is None:\n        return p.fail(\"no [forge].attestation_command in the manifest; the store cannot be read\")\n    records_rel = m.get(\"paths\", {}).get(\"records\", \"\")\n    records_dir = root / records_rel\n    if not records_dir.is_dir():\n        return p.fail(f\"no records directory under {records_dir}\")\n    items = load_records(records_dir)\n    complete = [item for item, stages in sorted(items.items()) if all(s in stages for s in STAGES)]\n\n    # [forge].sealed_since: merges at or before this commit are before the\n    # window -- the tenant could not seal them (no queue, no signing\n    # workflow, or a store that held nothing yet). They are named, never\n    # failed. Absent, the window starts where proof three's does: the\n    # install commit, or [doctor].from (issue #192).\n    since = (m.get(\"forge\") or {}).get(\"sealed_since\")\n    if not (isinstance(since, str) and since.strip()):\n        try:\n            since = proof_window_start(root, m)[1]\n        except WindowRefused as exc:\n            return p.fail(str(exc))\n    merges, refusal = _merges_reachable(root)\n    if refusal:\n        return p.fail(refusal)\n    sealed: list[str] = []\n    before_window: list[str] = []\n    unsealed: list[str] = []\n    not_merged: list[str] = []\n    not_read: list[str] = []\n    reasons: list[str] = []\n    for item in complete:\n        merge_sha, _ = merge_introducing_records(root, records_rel, item, STAGES, merges=merges)\n        if merge_sha is None:\n            not_merged.append(item)\n            continue\n        if _is_ancestor(root, merge_sha, since):\n            before_window.append(item)\n            continue\n        statement, exit_code = statement_for(root, cmd, merge_sha)\n        if statement is not None:\n            sealed.append(item)\n            disagreement = _accounting_disagrees(root, records_dir / item, item, merge_sha,\n                                                 statement)\n            if disagreement:\n                reasons.append(disagreement)\n        elif exit_code == 2:\n            not_read.append(item)\n            reasons.append(f\"item {item} merged at {merge_sha[:12]}: not read -- \"\n                           f\"the store could not be read; {cmd!r} exited 2\")\n        else:\n            unsealed.append(item)\n            reasons.append(f\"item {item} merged at {merge_sha[:12]} has no statement in the store\")\n    if reasons:\n        return p.fail(\"; \".join(reasons), sealed=sealed, before_window=before_window,\n                      unsealed=unsealed, not_merged=not_merged, not_read=not_read)\n    window = f\" at {since[:12]}\" if before_window else \"\"\n    return p.hold(f\"{len(sealed)} sealed, {len(before_window)} before the window{window}, \"\n                 f\"{len(not_merged)} not merged\",\n                 sealed=sealed, before_window=before_window, unsealed=unsealed,\n                 not_merged=not_merged, not_read=not_read)\n\n\ndef doctor(root: Path) -> list[Proof]:\n    m = read_manifest(root)\n    return [proof_every_gate_rejects(root, m),\n            proof_one_item_every_stage(root, m),\n            proof_no_commit_lacks_record(root, m),\n            proof_no_stop_lacks_cause(root, m),\n            proof_no_invocation_lacks_record(root, m),\n            proof_every_attested_item_is_sealed(root, m)]\n\n\ndef cmd_doctor(argv: list[str]) -> int:\n    as_json = \"--json\" in argv\n\"\"\"The statement's `time` and `cost` blocks: every invocation of an item\nsummed by `attavo attest` from the records it already reads, and doctor's\nsixth proof holding the statement to those records.\n\nRegression, run red first on main at 1d2257b: the statement carried the\nfinal attempt per stage and nothing else, so a view derived its own\n\"product time\" -- 20 minutes for an item whose nineteen invocations ran\n115 -- and no record said otherwise.\n\nRun: python3 -m pytest tests -q\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport subprocess\nimport sys\nfrom pathlib import Path\nfrom typing import Any\n\nimport jsonschema\n\nfrom helpers import git\n\nROOT = Path(__file__).resolve().parent.parent\nATTAVO = ROOT / \"bin\" / \"attavo\"\nSCHEMA = json.loads((ROOT / \"schema\" / \"attestation.schema.json\").read_text())\n\n# (stage, attempt, wall_clock_s, cost_usd, adapter): three builds on one\n# executor, two verifies and one counsel on another that reports no cost.\nINVOCATIONS: list[tuple[str, int, float | None, float | None, str]] = [\n    (\"build\", 1, 100.5, 0.25, \"alpha\"),\n    (\"build\", 2, 200.0, 0.5, \"alpha\"),\n    (\"build\", 3, 50.25, 0.125, \"alpha\"),\n    (\"verify\", 1, 10.0, None, \"beta\"),\n    (\"verify\", 2, 30.0, None, \"beta\"),\n    (\"counsel\", 1, 7.5, None, \"beta\"),\n]\n\n\ndef run(root: Path, *args: str, stdin: str | None = None) -> subprocess.CompletedProcess[str]:\n    return subprocess.run([sys.executable, str(ATTAVO), *args], cwd=str(root), input=stdin,\n                          capture_output=True, text=True, check=False)\n\n\ndef write(path: Path, obj: dict[str, Any]) -> None:\n    path.parent.mkdir(parents=True, exist_ok=True)\n    path.write_text(json.dumps(obj))\n\n\ndef make_item(tmp_path: Path, invocations: list[tuple[str, int, float | None, float | None, str]]\n              ) -> tuple[Path, str]:\n    \"\"\"A tenant with one item merged on main's first-parent line: spec and\n    approval records, then every invocation in `invocations`, the chain\n    coherent on the latest of each stage. Returns (root, merge sha).\"\"\"\n    root = tmp_path / \"tenant\"\n    root.mkdir(parents=True)\n    git(root, \"init\", \"-q\", \"-b\", \"main\", \".\")\n    git(root, \"config\", \"user.email\", \"fixture@attavo.invalid\")\n    git(root, \"config\", \"user.name\", \"fixture\")\n    (root / \"attavo.toml\").write_text(\n        '[paths]\\nrecords = \"records\"\\nspecs = \"specs\"\\n\\n'\n        '[forge]\\nattestation_command = \"sh ./fake-store\"\\n')\n    (root / \"fake-store\").write_text(\n        '#!/bin/sh\\nread sha\\ntest -f \"statements/$sha.json\" && cat \"statements/$sha.json\"\\n')\n    git(root, \"add\", \"-A\")\n    git(root, \"commit\", \"-q\", \"-m\", \"install\")\n    git(root, \"checkout\", \"-q\", \"-b\", \"attavo/1-x\")\n    rec = root / \"records\" / \"1\"\n    write(rec / \"spec-01.json\", {\"status\": \"pass\", \"sha\": \"s1\", \"at\": \"2026-01-01T00:00:00Z\"})\n    write(rec / \"approval-01.json\", {\"sha\": \"a1\", \"spec_sha\": \"s1\", \"at\": \"2026-01-01T00:00:00Z\"})\n    for stage, n, wall, cost, adapter in invocations:\n        body: dict[str, Any] = {\"status\": \"pass\", \"sha\": f\"{stage}{n}\", \"adapter\": adapter,\n                                \"approval_sha\": \"a1\", \"cost_usd\": cost}\n        if wall is not None:\n            body[\"wall_clock_s\"] = wall\n        if stage == \"verify\":\n            last_build = max(i[1] for i in invocations if i[0] == \"build\")\n            body[\"build_sha\"] = f\"build{last_build}\"\n        write(rec / f\"{stage}-{n:02d}.json\", body)\n    git(root, \"add\", \"-A\")\n    git(root, \"commit\", \"-q\", \"-m\", \"records for item 1\")\n    git(root, \"checkout\", \"-q\", \"main\")\n    git(root, \"merge\", \"-q\", \"--no-ff\", \"-m\", \"Merge branch 'attavo/1-x'\", \"attavo/1-x\")\n    git(root, \"update-ref\", \"refs/remotes/origin/main\", \"main\")\n    git(root, \"symbolic-ref\", \"refs/remotes/origin/HEAD\", \"refs/remotes/origin/main\")\n    return root, git(root, \"rev-parse\", \"HEAD\").strip()\n\n\ndef attest(root: Path) -> dict[str, Any]:\n    done = run(root, \"attest\", \"1\")\n    assert done.returncode == 0, done.stdout + done.stderr\n    statement: dict[str, Any] = json.loads(done.stdout)\n    return statement\n\n\ndef proof_six(root: Path) -> dict[str, Any]:\n    out = json.loads(run(root, \"doctor\", \"--json\", str(root)).stdout)\n    found: dict[str, Any] = [p for p in out[\"proofs\"]\n                             if p[\"proof\"] == \"every-attested-item-is-sealed\"][0]\n    return found\n\n\ndef test_attest_sums_every_invocation_per_stage_and_per_item(tmp_path: Path) -> None:\n    root, _ = make_item(tmp_path, INVOCATIONS)\n    statement = attest(root)\n    jsonschema.validate(statement, SCHEMA)\n    time = statement[\"time\"]\n    assert time[\"build\"] == {\"attempts\": 3, \"invocation_s\": 350.75, \"partial\": False}\n    assert time[\"verify\"] == {\"attempts\": 2, \"invocation_s\": 40.0, \"partial\": False}\n    assert time[\"counsel\"] == {\"attempts\": 1, \"invocation_s\": 7.5, \"partial\": False}\n    assert time[\"invocation_s\"] == 398.25\n    assert time[\"partial\"] is False and time[\"not_read\"] == []\n    # the final attempt stays where it was, and is not the sum\n    assert statement[\"wall_clock_by_stage_s\"] == {\"build\": 50.25, \"verify\": 30.0}\n    # lead runs from approval-01's `at` to the merge's committer time\n    merged_at = int(git(root, \"show\", \"-s\", \"--format=%ct\", \"HEAD\").strip())\n    assert time[\"lead_s\"] == merged_at - 1767225600\n    assert time[\"waiting_s\"] == round(time[\"lead_s\"] - 398.25, 3)\n\n\ndef test_attest_names_a_record_without_wall_clock_and_never_sums_it_as_zero(tmp_path: Path) -> None:\n    invocations = [i if i[:2] != (\"build\", 2) else (\"build\", 2, None, 0.5, \"alpha\")\n                   for i in INVOCATIONS]\n    root, _ = make_item(tmp_path, invocations)\n    time = attest(root)[\"time\"]\n    assert time[\"not_read\"] == [\"build-02\"]\n    assert time[\"build\"][\"partial\"] is True and time[\"partial\"] is True\n    assert time[\"build\"][\"attempts\"] == 3\n    assert time[\"verify\"][\"partial\"] is False\n\n\ndef test_attest_sums_cost_across_executors_and_says_when_the_total_is_partial(tmp_path: Path) -> None:\n    root, _ = make_item(tmp_path, INVOCATIONS)\n    cost = attest(root)[\"cost\"]\n    assert cost[\"usd\"] == 0.875\n    assert cost[\"by_stage_usd\"] == {\"build\": 0.875}\n    assert cost[\"by_adapter_usd\"] == {\"alpha\": 0.875}\n    assert cost[\"partial\"] is True\n    assert cost[\"not_read\"] == [\"verify-01\", \"verify-02\", \"counsel-01\"]\n\n    priced = [i if i[3] is not None else (i[0], i[1], i[2], 0.0625, i[4]) for i in INVOCATIONS]\n    root2, _ = make_item(tmp_path / \"priced\", priced)\n    cost2 = attest(root2)[\"cost\"]\n    assert cost2[\"usd\"] == 0.875 + 3 * 0.0625\n    assert cost2[\"by_adapter_usd\"] == {\"alpha\": 0.875, \"beta\": 0.1875}\n    assert cost2[\"partial\"] is False and cost2[\"not_read\"] == []\n\n\ndef test_doctor_proof_six_fails_a_statement_whose_time_is_not_its_records(tmp_path: Path) -> None:\n    root, merge = make_item(tmp_path, INVOCATIONS)\n    statement = attest(root)\n    store = root / \"statements\"\n    store.mkdir()\n    envelope = {\"_type\": \"https://in-toto.io/Statement/v1\", \"predicate\": statement}\n    (store / f\"{merge}.json\").write_text(json.dumps(envelope))\n    held = proof_six(root)\n    assert held[\"holds\"] is True and held[\"sealed\"] == [\"1\"], held\n\n    statement[\"time\"][\"invocation_s\"] = 20.0\n    (store / f\"{merge}.json\").write_text(json.dumps(envelope))\n    failed = proof_six(root)\n    assert failed[\"holds\"] is False, failed\n    assert \"item 1\" in failed[\"reason\"] and \"time.invocation_s\" in failed[\"reason\"], failed\n\n    # a statement sealed before `time` and `cost` existed carries neither\n    # and is not checked; one without the other is a disagreement (#203)\n    del statement[\"time\"]\n    del statement[\"cost\"]\n    (store / f\"{merge}.json\").write_text(json.dumps(envelope))\n    assert proof_six(root)[\"holds\"] is True\n\n\ndef seal(root: Path, merge: str, statement: dict[str, Any]) -> None:\n    store = root / \"statements\"\n    store.mkdir(exist_ok=True)\n    envelope = {\"_type\": \"https://in-toto.io/Statement/v1\", \"predicate\": statement}\n    (store / f\"{merge}.json\").write_text(json.dumps(envelope))\n\n\ndef test_doctor_rejects_a_subsecond_time_invocation_mismatch(tmp_path: Path) -> None:\n    \"\"\"#202: the check allowed one second either way, so a statement could\n    say 398.75 of records that sum to 398.25 and hold.\"\"\"\n    root, merge = make_item(tmp_path, INVOCATIONS)\n    statement = attest(root)\n    assert statement[\"time\"][\"invocation_s\"] == 398.25\n    statement[\"time\"][\"invocation_s\"] = 398.75\n    seal(root, merge, statement)\n    failed = proof_six(root)\n    assert failed[\"holds\"] is False, failed\n    assert \"item 1\" in failed[\"reason\"] and \"time.invocation_s\" in failed[\"reason\"], failed\n\n\ndef test_doctor_rejects_statement_whose_time_or_cost_breakdown_disagrees_with_records(\n        tmp_path: Path) -> None:\n    \"\"\"#203: only time.invocation_s was compared, so every other field of\n    the accounting could say anything. Each case leaves invocation_s true.\"\"\"\n    root, merge = make_item(tmp_path, INVOCATIONS)\n    true_statement = attest(root)\n    seal(root, merge, true_statement)\n    assert proof_six(root)[\"holds\"] is True\n\n    def forged(path: tuple[str, ...], value: Any) -> dict[str, Any]:\n        copy: dict[str, Any] = json.loads(json.dumps(true_statement))\n        node = copy\n        for key in path[:-1]:\n            node = node[key]\n        node[path[-1]] = value\n        return copy\n\n    cases: list[tuple[tuple[str, ...], Any, str]] = [\n        ((\"time\", \"build\", \"invocation_s\"), 1.0, \"time.build\"),\n        ((\"time\", \"build\", \"attempts\"), 1, \"time.build\"),\n        ((\"time\", \"lead_s\"), 1.0, \"time.lead_s\"),\n        ((\"time\", \"waiting_s\"), 1.0, \"time.waiting_s\"),\n        ((\"time\", \"partial\"), True, \"time.partial\"),\n        ((\"time\", \"not_read\"), [\"build-02\"], \"time.not_read\"),\n        ((\"cost\", \"usd\"), 0.5, \"cost.usd\"),\n        ((\"cost\", \"by_stage_usd\"), {\"build\": 0.5}, \"cost.by_stage_usd\"),\n        ((\"cost\", \"by_adapter_usd\"), {\"alpha\": 0.5}, \"cost.by_adapter_usd\"),\n        ((\"cost\", \"partial\"), False, \"cost.partial\"),\n        ((\"cost\", \"not_read\"), [], \"cost.not_read\"),\n        ((\"cost\", \"rate_usd\"), 1.0, \"cost.rate_usd\"),\n    ]\n    for path, value, named in cases:\n        seal(root, merge, forged(path, value))\n        failed = proof_six(root)\n        assert failed[\"holds\"] is False, (path, failed)\n        assert \"item 1\" in failed[\"reason\"] and named in failed[\"reason\"], (path, failed)\n\n    one_block: dict[str, Any] = json.loads(json.dumps(true_statement))\n    del one_block[\"cost\"]\n    seal(root, merge, one_block)\n    assert proof_six(root)[\"holds\"] is False\n\n\ndef test_doctor_holds_a_true_statement_however_its_store_prints_it(tmp_path: Path) -> None:\n    \"\"\"The rule that keeps a sealed statement from wedging the doctor: a\n    store may print 40.0 as 40, and a release after the seal may add a\n    field the sealed statement never carried. Neither is a disagreement.\"\"\"\n    root, merge = make_item(tmp_path, INVOCATIONS)\n    statement = attest(root)\n    assert statement[\"time\"][\"verify\"][\"invocation_s\"] == 40.0\n    statement[\"time\"][\"verify\"][\"invocation_s\"] = 40\n    del statement[\"time\"][\"counsel\"]\n    del statement[\"time\"][\"build\"][\"partial\"]\n    seal(root, merge, statement)\n    held = proof_six(root)\n    assert held[\"holds\"] is True and held[\"sealed\"] == [\"1\"], held\n\"\"\"The doctor's fifth proof: every attested item has its statement in the\nstore (issue #158). This repository's own #106, #148, #153 were merged\ndirect, with no merge_group run and so no statement, and the doctor said\ndone anyway -- proof two held on the four stage records with the chain\nheld, never asking whether the merge was sealed.\n\nRun: python3 -m pytest tests -q\n\"\"\"\nimport json\nimport subprocess\nfrom pathlib import Path\nfrom typing import Any, cast\n\nROOT = Path(__file__).resolve().parent.parent\nATTAVO = ROOT / \"bin\" / \"attavo\"\n\nFAKE_ATTEST = (\n    '#!/bin/sh\\nread sha\\ngrep -qx \"$sha\" sealed.txt && printf %s '\n    '\"{\\\\\"_type\\\\\": \\\\\"https://in-toto.io/Statement/v1\\\\\"}\"\\n'\n)\n\n\ndef _git(root: Path, *args: str) -> str:\n    return subprocess.run([\"git\", \"-C\", str(root), *args], capture_output=True, text=True,\n                          check=True).stdout.strip()\n\n\ndef _tenant_with_two_merged_items(tmp_path: Path) -> tuple[Path, str, str]:\n    root = tmp_path / \"sealed\"\n    root.mkdir()\n    subprocess.run([\"git\", \"init\", \"-q\", \"-b\", \"main\", \".\"], cwd=root, check=True)\n    _git(root, \"config\", \"user.email\", \"doctor@attavo.invalid\")\n    _git(root, \"config\", \"user.name\", \"doctor fixture\")\n    (root / \"attavo.toml\").write_text(\n        '[paths]\\nrecords = \"records\"\\n\\n[forge]\\nattestation_command = \"sh ./fake-attest\"\\n')\n    (root / \"fake-attest\").write_text(FAKE_ATTEST)\n    (root / \"sealed.txt\").write_text(\"\")\n    _git(root, \"add\", \".\")\n    _git(root, \"commit\", \"-q\", \"-m\", \"install\")\n    merges = []\n    for item in (\"1\", \"2\"):\n        _git(root, \"checkout\", \"-q\", \"-b\", f\"attavo/{item}-x\")\n        (root / \"records\" / item).mkdir(parents=True)\n        for stage in (\"spec\", \"approval\", \"build\", \"verify\"):\n            (root / \"records\" / item / f\"{stage}-01.json\").write_text('{\"status\": \"pass\"}')\n            _git(root, \"add\", \"records\")\n            _git(root, \"commit\", \"-q\", \"-m\", f\"{stage} record for item {item}\")\n        _git(root, \"checkout\", \"-q\", \"main\")\n        _git(root, \"merge\", \"-q\", \"--no-ff\", \"-m\", f\"Merge branch 'attavo/{item}-x'\", f\"attavo/{item}-x\")\n        merges.append(_git(root, \"rev-parse\", \"HEAD\"))\n    _git(root, \"update-ref\", \"refs/remotes/origin/main\", _git(root, \"rev-parse\", \"main\"))\n    _git(root, \"symbolic-ref\", \"refs/remotes/origin/HEAD\", \"refs/remotes/origin/main\")\n    return root, merges[0], merges[1]\n\n\ndef _tenant_with_one_merged_and_one_unmerged_item(tmp_path: Path) -> Path:\n    root = tmp_path / \"unmerged\"\n    root.mkdir()\n    subprocess.run([\"git\", \"init\", \"-q\", \"-b\", \"main\", \".\"], cwd=root, check=True)\n    _git(root, \"config\", \"user.email\", \"doctor@attavo.invalid\")\n    _git(root, \"config\", \"user.name\", \"doctor fixture\")\n    (root / \"attavo.toml\").write_text(\n        '[paths]\\nrecords = \"records\"\\n\\n[forge]\\nattestation_command = \"sh ./fake-attest\"\\n')\n    (root / \"fake-attest\").write_text(FAKE_ATTEST)\n    (root / \"sealed.txt\").write_text(\"\")\n    _git(root, \"add\", \".\")\n    _git(root, \"commit\", \"-q\", \"-m\", \"install\")\n    _git(root, \"checkout\", \"-q\", \"-b\", \"attavo/1-x\")\n    (root / \"records\" / \"1\").mkdir(parents=True)\n    for stage in (\"spec\", \"approval\", \"build\", \"verify\"):\n        (root / \"records\" / \"1\" / f\"{stage}-01.json\").write_text('{\"status\": \"pass\"}')\n        _git(root, \"add\", \"records\")\n        _git(root, \"commit\", \"-q\", \"-m\", f\"{stage} record for item 1\")\n    _git(root, \"checkout\", \"-q\", \"main\")\n    _git(root, \"merge\", \"-q\", \"--no-ff\", \"-m\", \"Merge branch 'attavo/1-x'\", \"attavo/1-x\")\n    m1 = _git(root, \"rev-parse\", \"HEAD\")\n    (root / \"sealed.txt\").write_text(m1 + \"\\n\")\n    _git(root, \"add\", \"sealed.txt\")\n    _git(root, \"commit\", \"-q\", \"-m\", \"seal item 1\")\n    _git(root, \"checkout\", \"-q\", \"-b\", \"attavo/2-x\")\n    (root / \"records\" / \"2\").mkdir(parents=True)\n    for stage in (\"spec\", \"approval\", \"build\", \"verify\"):\n        (root / \"records\" / \"2\" / f\"{stage}-01.json\").write_text('{\"status\": \"pass\"}')\n        _git(root, \"add\", \"records\")\n        _git(root, \"commit\", \"-q\", \"-m\", f\"{stage} record for item 2\")\n    _git(root, \"checkout\", \"-q\", \"--detach\")\n    _git(root, \"merge\", \"-q\", \"--no-ff\", \"-m\", \"synthetic test merge of attavo/2-x into main\", \"main\")\n    return root\n\n\ndef _proof(root: Path) -> dict[str, Any]:\n    run = subprocess.run([\"python3\", str(ATTAVO), \"doctor\", \"--json\", str(root)],\n                         capture_output=True, text=True, check=False)\n    proofs = json.loads(run.stdout)[\"proofs\"]\n    return cast(dict[str, Any], [p for p in proofs if p[\"proof\"] == \"every-attested-item-is-sealed\"][0])\n\n\ndef test_doctor_proof_six_fails_on_an_unsealed_merge(tmp_path: Path) -> None:\n    root, m1, m2 = _tenant_with_two_merged_items(tmp_path)\n    (root / \"sealed.txt\").write_text(m1 + \"\\n\")\n    p = _proof(root)\n    assert not p[\"holds\"]\n    assert \"item 2\" in p[\"reason\"] and m2[:12] in p[\"reason\"]\n    assert p[\"sealed\"] == [\"1\"] and p[\"unsealed\"] == [\"2\"]\n\n\ndef test_doctor_proof_six_holds_when_every_merge_is_sealed(tmp_path: Path) -> None:\n    root, m1, m2 = _tenant_with_two_merged_items(tmp_path)\n    (root / \"sealed.txt\").write_text(m1 + \"\\n\" + m2 + \"\\n\")\n    p = _proof(root)\n    assert p[\"holds\"] and p[\"sealed\"] == [\"1\", \"2\"]\n\n\ndef test_doctor_proof_six_names_a_merge_before_the_window_without_failing(tmp_path: Path) -> None:\n    root, m1, m2 = _tenant_with_two_merged_items(tmp_path)\n    (root / \"sealed.txt\").write_text(m2 + \"\\n\")\n    (root / \"attavo.toml\").write_text(\n        '[paths]\\nrecords = \"records\"\\n\\n[forge]\\nattestation_command = \"sh ./fake-attest\"\\n'\n        f'sealed_since = \"{m1}\"\\n')\n    p = _proof(root)\n    assert p[\"holds\"] and p[\"before_window\"] == [\"1\"] and p[\"sealed\"] == [\"2\"]\n\n\ndef test_doctor_proof_six_fails_without_an_attestation_command(tmp_path: Path) -> None:\n    root = tmp_path / \"bare\"\n    root.mkdir()\n    subprocess.run([\"git\", \"init\", \"-q\", \"-b\", \"main\", \".\"], cwd=root, check=True)\n    (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n')\n    (root / \"records\").mkdir()\n    p = _proof(root)\n    assert not p[\"holds\"] and \"attestation_command\" in p[\"reason\"]\n\n\ndef test_doctor_proof_six_says_not_read_when_the_store_cannot_be_read(tmp_path: Path) -> None:\n    root = tmp_path / \"unreadable\"\n    root.mkdir()\n    subprocess.run([\"git\", \"init\", \"-q\", \"-b\", \"main\", \".\"], cwd=root, check=True)\n    _git(root, \"config\", \"user.email\", \"doctor@attavo.invalid\")\n    _git(root, \"config\", \"user.name\", \"doctor fixture\")\n    (root / \"attavo.toml\").write_text(\n        '[paths]\\nrecords = \"records\"\\n\\n[forge]\\nattestation_command = \"sh ./unreadable-store\"\\n')\n    (root / \"unreadable-store\").write_text(\n        '#!/bin/sh\\nread sha\\necho \"gh: not logged in\" >&2\\nexit 2\\n')\n    _git(root, \"add\", \".\")\n    _git(root, \"commit\", \"-q\", \"-m\", \"install\")\n    _git(root, \"checkout\", \"-q\", \"-b\", \"attavo/1-x\")\n    (root / \"records\" / \"1\").mkdir(parents=True)\n    for stage in (\"spec\", \"approval\", \"build\", \"verify\"):\n        (root / \"records\" / \"1\" / f\"{stage}-01.json\").write_text('{\"status\": \"pass\"}')\n        _git(root, \"add\", \"records\")\n        _git(root, \"commit\", \"-q\", \"-m\", f\"{stage} record for item 1\")\n    _git(root, \"checkout\", \"-q\", \"main\")\n    _git(root, \"merge\", \"-q\", \"--no-ff\", \"-m\", \"Merge branch 'attavo/1-x'\", \"attavo/1-x\")\n    _git(root, \"update-ref\", \"refs/remotes/origin/main\", _git(root, \"rev-parse\", \"main\"))\n    _git(root, \"symbolic-ref\", \"refs/remotes/origin/HEAD\", \"refs/remotes/origin/main\")\n    p = _proof(root)\n    assert not p[\"holds\"]\n    assert \"not read\" in p[\"reason\"] and \"unreadable-store\" in p[\"reason\"] and \"exited 2\" in p[\"reason\"]\n    assert p[\"not_read\"] == [\"1\"] and p[\"unsealed\"] == [] and p[\"sealed\"] == []\n\n\ndef test_doctor_proof_six_names_an_unmerged_item(tmp_path: Path) -> None:\n    root = _tenant_with_one_merged_and_one_unmerged_item(tmp_path)\n    noref = _proof(root)\n    assert not noref[\"holds\"] and \"refs/remotes/origin/HEAD\" in noref[\"reason\"]\n    _git(root, \"update-ref\", \"refs/remotes/origin/main\", \"main\")\n    _git(root, \"symbolic-ref\", \"refs/remotes/origin/HEAD\", \"refs/remotes/origin/main\")\n    ref = _proof(root)\n    assert ref[\"holds\"]\n    assert ref[\"sealed\"] == [\"1\"] and ref[\"not_merged\"] == [\"2\"] and ref[\"unsealed\"] == []\n","exit_code":0,"status":"completed"}}

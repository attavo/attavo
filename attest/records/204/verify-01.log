{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"PYTHONDONTWRITEBYTECODE=1 python3 - <<'PY'\nfrom attavo.doctor import _same, _accounting_disagrees\nprint(_same(9007199254740993, 9007199254740992.0))\nprint('dict membership behavior: get(None) cannot distinguish absent/null')\nPY\nnl -ba attavo/doctor.py | sed -n '638,715p'; nl -ba tests/test_attest_time.py | sed -n '175,260p'\"","aggregated_output":"zsh:1: can't create temp file for here document: operation not permitted\n   638\t\n   639\tdef _same(stated: Any, summed: Any) -> bool:\n   640\t    \"\"\"Equal as the accounting means it: a number equals a number of the\n   641\t    same value (a store may print 40.0 as 40), a bool equals only a bool,\n   642\t    and a list is equal member by member. No tolerance: both sides are the\n   643\t    same function's rounding of the same records.\"\"\"\n   644\t    if isinstance(stated, bool) or isinstance(summed, bool):\n   645\t        return isinstance(stated, bool) and isinstance(summed, bool) and stated == summed\n   646\t    if isinstance(stated, (int, float)) and isinstance(summed, (int, float)):\n   647\t        return float(stated) == float(summed)\n   648\t    if isinstance(stated, list) and isinstance(summed, list):\n   649\t        return len(stated) == len(summed) and all(_same(a, b) for a, b in zip(stated, summed))\n   650\t    return type(stated) is type(summed) and bool(stated == summed)\n   651\t\n   652\t\n   653\tdef _differences(path: str, stated: Any, summed: Any, keyed_by_data: bool = False) -> list[str]:\n   654\t    \"\"\"Every field of `stated` that is not what its records sum to, named by\n   655\t    its path. Only the keys the statement carries are compared, at every\n   656\t    depth, so a field a later release adds is not demanded of a statement\n   657\t    sealed before it; a key it carries that the function does not produce\n   658\t    is a difference.\"\"\"\n   659\t    if not (isinstance(stated, dict) and isinstance(summed, dict)):\n   660\t        return [] if _same(stated, summed) else [f\"{path} {stated!r} is not its records' {summed!r}\"]\n   661\t    found: list[str] = []\n   662\t    for key in sorted(stated):\n   663\t        if key not in summed:\n   664\t            found.append(f\"{path}.{key} {stated[key]!r} is not a field its records sum to\")\n   665\t        else:\n   666\t            found += _differences(f\"{path}.{key}\", stated[key], summed[key], key in DATA_KEYED)\n   667\t    if keyed_by_data:\n   668\t        found += [f\"{path}.{key} is absent; its records sum to {summed[key]!r}\"\n   669\t                  for key in sorted(summed.keys() - stated.keys())]\n   670\t    return found\n   671\t\n   672\t\n   673\tdef _accounting_disagrees(root: Path, item_records_dir: Path, item: str, merge_sha: str,\n   674\t                          statement: dict[str, Any]) -> str | None:\n   675\t    \"\"\"A sealed statement that carries `time` and `cost` says what its\n   676\t    records sum to, field by field -- the same function attest summed them\n   677\t    with, over the same records (none is written after a merge), sealed at\n   678\t    the same commit (the statement is computed at the merge, so lead_s and\n   679\t    waiting_s are recomputed from its committer time, not excepted). Exact:\n   680\t    #202 retired the one-second tolerance. A statement sealed before `time`\n   681\t    existed carries neither block and is not checked; one block without the\n   682\t    other is a disagreement. No new read of the store.\"\"\"\n   683\t    inner = statement.get(\"predicate\")\n   684\t    predicate = inner if isinstance(inner, dict) else statement\n   685\t    stated_time, stated_cost = predicate.get(\"time\"), predicate.get(\"cost\")\n   686\t    if stated_time is None and stated_cost is None:\n   687\t        return None\n   688\t    where = f\"item {item} merged at {merge_sha[:12]}\"\n   689\t    if not isinstance(stated_time, dict) or not isinstance(stated_cost, dict):\n   690\t        return f\"{where}: the statement carries one of time and cost without the other\"\n   691\t    try:\n   692\t        sealed_at: int | None = int(git(root, \"show\", \"-s\", \"--format=%ct\", merge_sha).strip())\n   693\t    except (RuntimeError, ValueError):\n   694\t        sealed_at = None\n   695\t    summed_time, summed_cost = item_time_and_cost(item_records_dir, sealed_at)\n   696\t    differing = (_differences(\"time\", stated_time, dict(summed_time))\n   697\t                 + _differences(\"cost\", stated_cost, dict(summed_cost)))\n   698\t    if differing:\n   699\t        return f\"{where}: the statement's \" + \"; \".join(differing)\n   700\t    return None\n   701\t\n   702\t\n   703\tdef proof_every_attested_item_is_sealed(root: Path, m: dict[str, Any] | None) -> Proof:\n   704\t    p = Proof(\"every-attested-item-is-sealed\", \"every attested item has its statement in the store\")\n   705\t    if m is None:\n   706\t        return p.fail(f\"no {MANIFEST} at {root}; no records directory is declared\")\n   707\t    cmd = attestation_command(m)\n   708\t    if cmd is None:\n   709\t        return p.fail(\"no [forge].attestation_command in the manifest; the store cannot be read\")\n   710\t    records_rel = m.get(\"paths\", {}).get(\"records\", \"\")\n   711\t    records_dir = root / records_rel\n   712\t    if not records_dir.is_dir():\n   713\t        return p.fail(f\"no records directory under {records_dir}\")\n   714\t    items = load_records(records_dir)\n   715\t    complete = [item for item, stages in sorted(items.items()) if all(s in stages for s in STAGES)]\n   175\t    store.mkdir(exist_ok=True)\n   176\t    envelope = {\"_type\": \"https://in-toto.io/Statement/v1\", \"predicate\": statement}\n   177\t    (store / f\"{merge}.json\").write_text(json.dumps(envelope))\n   178\t\n   179\t\n   180\tdef test_doctor_rejects_a_subsecond_time_invocation_mismatch(tmp_path: Path) -> None:\n   181\t    \"\"\"#202: the check allowed one second either way, so a statement could\n   182\t    say 398.75 of records that sum to 398.25 and hold.\"\"\"\n   183\t    root, merge = make_item(tmp_path, INVOCATIONS)\n   184\t    statement = attest(root)\n   185\t    assert statement[\"time\"][\"invocation_s\"] == 398.25\n   186\t    statement[\"time\"][\"invocation_s\"] = 398.75\n   187\t    seal(root, merge, statement)\n   188\t    failed = proof_six(root)\n   189\t    assert failed[\"holds\"] is False, failed\n   190\t    assert \"item 1\" in failed[\"reason\"] and \"time.invocation_s\" in failed[\"reason\"], failed\n   191\t\n   192\t\n   193\tdef test_doctor_rejects_statement_whose_time_or_cost_breakdown_disagrees_with_records(\n   194\t        tmp_path: Path) -> None:\n   195\t    \"\"\"#203: only time.invocation_s was compared, so every other field of\n   196\t    the accounting could say anything. Each case leaves invocation_s true.\"\"\"\n   197\t    root, merge = make_item(tmp_path, INVOCATIONS)\n   198\t    true_statement = attest(root)\n   199\t    seal(root, merge, true_statement)\n   200\t    assert proof_six(root)[\"holds\"] is True\n   201\t\n   202\t    def forged(path: tuple[str, ...], value: Any) -> dict[str, Any]:\n   203\t        copy: dict[str, Any] = json.loads(json.dumps(true_statement))\n   204\t        node = copy\n   205\t        for key in path[:-1]:\n   206\t            node = node[key]\n   207\t        node[path[-1]] = value\n   208\t        return copy\n   209\t\n   210\t    cases: list[tuple[tuple[str, ...], Any, str]] = [\n   211\t        ((\"time\", \"build\", \"invocation_s\"), 1.0, \"time.build\"),\n   212\t        ((\"time\", \"build\", \"attempts\"), 1, \"time.build\"),\n   213\t        ((\"time\", \"lead_s\"), 1.0, \"time.lead_s\"),\n   214\t        ((\"time\", \"waiting_s\"), 1.0, \"time.waiting_s\"),\n   215\t        ((\"time\", \"partial\"), True, \"time.partial\"),\n   216\t        ((\"time\", \"not_read\"), [\"build-02\"], \"time.not_read\"),\n   217\t        ((\"cost\", \"usd\"), 0.5, \"cost.usd\"),\n   218\t        ((\"cost\", \"by_stage_usd\"), {\"build\": 0.5}, \"cost.by_stage_usd\"),\n   219\t        ((\"cost\", \"by_adapter_usd\"), {\"alpha\": 0.5}, \"cost.by_adapter_usd\"),\n   220\t        ((\"cost\", \"partial\"), False, \"cost.partial\"),\n   221\t        ((\"cost\", \"not_read\"), [], \"cost.not_read\"),\n   222\t        ((\"cost\", \"rate_usd\"), 1.0, \"cost.rate_usd\"),\n   223\t    ]\n   224\t    for path, value, named in cases:\n   225\t        seal(root, merge, forged(path, value))\n   226\t        failed = proof_six(root)\n   227\t        assert failed[\"holds\"] is False, (path, failed)\n   228\t        assert \"item 1\" in failed[\"reason\"] and named in failed[\"reason\"], (path, failed)\n   229\t\n   230\t    one_block: dict[str, Any] = json.loads(json.dumps(true_statement))\n   231\t    del one_block[\"cost\"]\n   232\t    seal(root, merge, one_block)\n   233\t    assert proof_six(root)[\"holds\"] is False\n   234\t\n   235\t\n   236\tdef test_doctor_holds_a_true_statement_however_its_store_prints_it(tmp_path: Path) -> None:\n   237\t    \"\"\"The rule that keeps a sealed statement from wedging the doctor: a\n   238\t    store may print 40.0 as 40, and a release after the seal may add a\n   239\t    field the sealed statement never carried. Neither is a disagreement.\"\"\"\n   240\t    root, merge = make_item(tmp_path, INVOCATIONS)\n   241\t    statement = attest(root)\n   242\t    assert statement[\"time\"][\"verify\"][\"invocation_s\"] == 40.0\n   243\t    statement[\"time\"][\"verify\"][\"invocation_s\"] = 40\n   244\t    del statement[\"time\"][\"counsel\"]\n   245\t    del statement[\"time\"][\"build\"][\"partial\"]\n   246\t    seal(root, merge, statement)\n   247\t    held = proof_six(root)\n   248\t    assert held[\"holds\"] is True and held[\"sealed\"] == [\"1\"], held\n","exit_code":0,"status":"completed"}}

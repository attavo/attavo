,\n    \"time\": {\n      \"type\": \"object\",\n      \"description\": \"Every invocation of the item, summed by attest from its stage records' wall_clock_s: per stage and for the item, every attempt and not the final one alone (wall_clock_by_stage_s is the final attempt). lead_s runs from the first approval record's `at` to the committer time of the commit the statement is computed at; waiting_s is lead_s minus invocation_s. A record with no wall_clock_s is named in not_read and its sums are partial, never smaller in silence.\",\n      \"additionalProperties\": false,\n      \"required\": [\"build\", \"verify\", \"counsel\", \"invocation_s\", \"lead_s\", \"waiting_s\", \"partial\", \"not_read\"],\n      \"properties\": {\n        \"build\": {\"$ref\": \"#/$defs/stage_time\"},\n        \"verify\": {\"$ref\": \"#/$defs/stage_time\"},\n        \"counsel\": {\"$ref\": \"#/$defs/stage_time\"},\n        \"invocation_s\": {\"type\": \"number\", \"minimum\": 0},\n        \"lead_s\": {\"type\": [\"number\", \"null\"]},\n        \"waiting_s\": {\"type\": [\"number\", \"null\"]},\n        \"partial\": {\"type\": \"boolean\"},\n        \"not_read\": {\"type\": \"array\", \"items\": {\"type\": \"string\", \"minLength\": 1}}\n      }\n    },\n    \"cost\": {\n      \"type\": \"object\",\n      \"description\": \"Every record's cost_usd summed by attest: the item's total across stages and executors (ruled 2026-09-19, superseding the 2026-09-09 ruling against a cross-executor sum), with a subtotal per stage and per adapter. Each figure is what the record carries. A record with no cost_usd is named in not_read and makes usd and the subtotals it belongs to partial: absent is never zero, and a partial total says so.\",\n      \"additionalProperties\": false,\n      \"required\": [\"usd\", \"by_stage_usd\", \"by_adapter_usd\", \"partial\", \"not_read\"],\n      \"properties\": {\n        \"usd\": {\"type\": \"number\", \"minimum\": 0},\n        \"by_stage_usd\": {\"type\": \"object\", \"additionalProperties\": {\"type\": \"number\", \"minimum\": 0}},\n        \"by_adapter_usd\": {\"type\": \"object\", \"additionalProperties\": {\"type\": \"number\", \"minimum\": 0}},\n        \"partial\": {\"type\": \"boolean\"},\n        \"not_read\": {\"type\": \"array\", \"items\": {\"type\": \"string\", \"minLength\": 1}}\n      }\n    },\n    \"product_version\": {\"type\": \"string\", \"minLength\": 1},\n    \"product_pin\": {\"type\": [\"string\", \"null\"]}\n  },\n  \"$defs\": {\n    \"stage_time\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\"attempts\", \"invocation_s\", \"partial\"],\n      \"properties\": {\n        \"attempts\": {\"type\": \"integer\", \"minimum\": 0},\n        \"invocation_s\": {\"type\": \"number\", \"minimum\": 0},\n        \"partial\": {\"type\": \"boolean\"}\n      }\n    }\n  }\n}\n    \"product_version\": str,\n    \"product_pin\": str | None,\n})\n\n\nclass StageTime(TypedDict):\n    \"\"\"One stage's invocations summed (the statement's `time` block).\"\"\"\n    attempts: int\n    invocation_s: float\n    partial: bool\n\n\nclass ItemTime(TypedDict):\n    \"\"\"Every invocation's wall_clock_s, per stage and for the item, beside\n    the item's lead time -- summed from the records by `attavo attest`, so\n    a view renders it and never derives it.\"\"\"\n    build: StageTime\n    verify: StageTime\n    counsel: StageTime\n    invocation_s: float\n    lead_s: float | None\n    waiting_s: float | None\n    partial: bool\n    not_read: list[str]\n\n\nclass ItemCost(TypedDict):\n    \"\"\"Every record's cost_usd summed: the item's total across stages and\n    executors, with a subtotal per stage and per adapter. A record with no\n    cost_usd is named in not_read and makes every sum it belongs to\n    partial -- absent is never zero.\"\"\"\n    usd: float\n    by_stage_usd: dict[str, float]\n    by_adapter_usd: dict[str, float]\n    partial: bool\n    not_read: list[str]\n\n\nclass AttestRecord(TypedDict):\n    \"\"\"The statement `attavo attest` prints (schema/attestation.schema.json).\"\"\"\n    sha: str\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-t7GK3sFT' (errno=Operation not permitted)\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-cDp9PEVM' (errno=Operation not permitted)\ncommit b862f4f30f432b56a72b6475f664f885d95a1af6\nAuthor:     attavo executor (claude-code) <executor+claude-code@attavo.invalid>\nAuthorDate: Sun Sep 20 10:48:50 2026 -0600\nCommit:     attavo executor (claude-code) <executor+claude-code@attavo.invalid>\nCommitDate: Sun Sep 20 10:48:50 2026 -0600\n\n    proof six holds a sealed statement to its whole accounting, exactly (#202, #203)\n    \n    Replaces _time_disagrees and its one-second tolerance with\n    _accounting_disagrees: every key the sealed statement's time and cost\n    carry is compared, as numbers, against item_time_and_cost called at the\n    merge commit's committer time, so lead_s and waiting_s are recomputed\n    and no field is excepted. Keys the statement does not carry are not\n    demanded at any depth; a key it carries that the function does not\n    produce is a disagreement, as is one of time and cost without the other.\n    \n    Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>\n\n attavo/attest.py          |  3 +-\n attavo/doctor.py          | 80 ++++++++++++++++++++++++++++++++++++---------\n tests/test_attest_time.py | 82 ++++++++++++++++++++++++++++++++++++++++++++++-\n 3 files changed, 148 insertions(+), 17 deletions(-)\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-o3LH9feq' (errno=Operation not permitted)\ngit: warning: confstr() failed 
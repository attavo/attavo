{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"sed -n '110,155p' attavo/build.py; sed -n '70,115p' attavo/common.py; git status --short; git diff --check d7c87f57ffacdeb1aa2853bf2c23e9434ef226e7..7a10f2cbe401b676fbe3ec1c2202aaac3dca2500\"","aggregated_output":"    for commit in (approval_sha, sha):\n        resolved = subprocess.run([\"git\", \"-C\", str(root), \"cat-file\", \"-e\", f\"{commit}^{{commit}}\"],\n                                  capture_output=True, text=True, check=False)\n        if resolved.returncode != 0:\n            return None\n    pathspec = claims if claims else [\".\"]\n    out = subprocess.run([\"git\", \"-C\", str(root), \"diff\", \"--quiet\", approval_sha, sha,\n                          \"--\", *pathspec], capture_output=True, text=True, check=False)\n    if out.returncode not in (0, 1):\n        return None\n    return out.returncode == 0\n\n\ndef protected_path_touched(root: Path, start_sha: str, records_rel: str,\n                           specs_rel: str) -> str | None:\n    \"\"\"The first path an executor's own commits touched under\n    paths.records or paths.specs since start_sha, or None (issue #140).\n    Neither directory is a claim a spec can make -- paths.records is\n    where the product itself writes, paths.specs is the definition of\n    done -- yet changed_paths above excludes paths.records from the\n    ordinary claims check entirely, so a path there never even reached\n    matches_a_claim to be refused: tenant zero's own item #688 committed\n    its own events file this way, under its records directory, on a\n    build that then passed. Checked directly against the raw diff, not\n    changed_paths's already-filtered list.\"\"\"\n    touched = git(root, \"diff\", \"--name-only\", start_sha, \"HEAD\").splitlines()\n    protected = []\n    for rel in (records_rel, specs_rel):\n        stripped = rel.rstrip(\"/\")\n        protected.append((stripped, stripped + \"/\"))\n    for p in touched:\n        if not p:\n            continue\n        for exact, prefix in protected:\n            if p == exact or p.startswith(prefix):\n                return p\n    return None\n\n\ndef executor_identity(adapter_name: str) -> dict[str, Any]:\n    \"\"\"The executor's identity (issue #33): set by the product, never the\n    tenant's git config, so an executor commit is never indistinguishable\n    from an operator's own -- the specimen is attavo/code-factory@e22fa85.\n    A reserved, undeliverable domain (.invalid) so no mailbox is implied.\n    Distinct from the records app identity: the app says the product\n    pushed this, this says an invocation authored this -- different\n      3. \"unknown\", when PRODUCT_ROOT is not a git repository at all --\n         the case for a forge that extracts this action from a tarball\n         rather than a git checkout, which is exactly when (1) is\n         expected to already have supplied the answer.\n\n    Distinct from the tenant's product_pin -- an operator running a\n    checkout, which is how every build and verify have actually been run\n    so far, bypasses the pin entirely (issue #49).\"\"\"\n    env = os.environ.get(\"ATTAVO_PRODUCT_VERSION\")\n    if env:\n        return env\n    try:\n        return git(PRODUCT_ROOT, \"describe\", \"--tags\", \"--always\", \"--dirty\").strip()\n    except RuntimeError:\n        return \"unknown\"\n\n\ndef now_iso() -> str:\n    return datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n\n\ndef derive_item_id(root: Path) -> str | None:\n    \"\"\"ATTAVO_ITEM first, not last: a rejection fixture's own item id must\n    win over whatever attavo/N-* branch the enclosing tenant repository\n    happens to be checked out on -- the common case is doctor running from\n    a real item's own branch, where a fallback-only env var would never be\n    consulted at all and every gate fixture would silently resolve to the\n    real item instead of its own.\"\"\"\n    env_item = os.environ.get(\"ATTAVO_ITEM\")\n    if env_item:\n        return env_item\n    out = subprocess.run([\"git\", \"-C\", str(root), \"rev-parse\", \"--abbrev-ref\", \"HEAD\"],\n                         capture_output=True, text=True, check=False)\n    branch = out.stdout.strip()\n    m = re.match(r\"^attavo/(\\d+)-\", branch)\n    return m.group(1) if m else None\n\n\ndef fixture_item_id(fixture: Path) -> str | None:\n    \"\"\"The one item id under a rejection fixture's own paths.specs, so the\n    doctor can export it as ATTAVO_ITEM: a fixture carries no attavo/N-*\n    branch for a gate command with no argument to derive from otherwise.\"\"\"\n    fm = read_manifest(fixture)\n    specs_rel = ((fm or {}).get(\"paths\") or {}).get(\"specs\")\n    if not specs_rel:\n        return None\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-fk6T0oWe' (errno=Operation not permitted)\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-9M7HDuPy' (errno=Operation not permitted)\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-gJz0tDLE' (errno=Operation not permitted)\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-QTe1BmT9' (errno=Operation not permitted)\n","exit_code":0,"status":"completed"}}

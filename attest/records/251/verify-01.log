{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/zsh -lc \"rg '\"'^diff --git|''^@@'\"' /var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmprwng39co/diff.patch && sed -n '1,280p' tests/test_claims.py && diff -u attest/specs/251/stub/attavo/claims.py attavo/claims.py || true && git show b028792218ca7dc406b23137457085f016f093b4 --stat --oneline && git show c8bf189f2ee0053a454513be1b744ccb0abc1569:attest/specs/251/spec.md | sed -n '1,240p'\"","aggregated_output":"diff --git a/.attavo/bin/select-tests b/.attavo/bin/select-tests\n@@ -42,6 +42,7 @@ WHOLE_SUITE_PREFIXES = (\"adapters/fixture/\",)\ndiff --git a/attavo/claims.py b/attavo/claims.py\n@@ -0,0 +1,160 @@\ndiff --git a/attavo/cli.py b/attavo/cli.py\n@@ -15,6 +15,7 @@\n@@ -144,6 +145,16 @@ last line serve as its detail. A pass record carries stop: null. See the\n@@ -375,6 +386,7 @@ import sys\n@@ -429,11 +441,13 @@ def main(argv: list[str]) -> int:\ndiff --git a/attest/records/251/approval-01.json b/attest/records/251/approval-01.json\n@@ -0,0 +1,10 @@\ndiff --git a/attest/records/251/build-01.json b/attest/records/251/build-01.json\n@@ -0,0 +1,56 @@\ndiff --git a/attest/records/251/build-01.log b/attest/records/251/build-01.log\n@@ -0,0 +1,46 @@\ndiff --git a/attest/records/251/build-01.started b/attest/records/251/build-01.started\n@@ -0,0 +1,6 @@\ndiff --git a/attest/records/251/spec-01.json b/attest/records/251/spec-01.json\n@@ -0,0 +1,19 @@\ndiff --git a/attest/records/251/verify-01.started b/attest/records/251/verify-01.started\n@@ -0,0 +1,6 @@\ndiff --git a/attest/specs/251/criteria/claims-reads-work-in-flight-and-names-a-collision.sh b/attest/specs/251/criteria/claims-reads-work-in-flight-and-names-a-collision.sh\n@@ -0,0 +1,40 @@\ndiff --git a/attest/specs/251/spec.md b/attest/specs/251/spec.md\n@@ -0,0 +1,26 @@\ndiff --git a/attest/specs/251/stub/.attavo/bin/select-tests b/attest/specs/251/stub/.attavo/bin/select-tests\n@@ -0,0 +1,139 @@\ndiff --git a/attest/specs/251/stub/attavo/claims.py b/attest/specs/251/stub/attavo/claims.py\n@@ -0,0 +1,160 @@\ndiff --git a/attest/specs/251/stub/attavo/cli.py b/attest/specs/251/stub/attavo/cli.py\n@@ -0,0 +1,453 @@\ndiff --git a/attest/specs/251/stub/tests/test_claims.py b/attest/specs/251/stub/tests/test_claims.py\n@@ -0,0 +1,98 @@\ndiff --git a/tests/test_claims.py b/tests/test_claims.py\n@@ -0,0 +1,98 @@\n\"\"\"attavo claims: work in flight read from git, and an item's collisions\nwith it (the Plan Map's L1, 2026-09-27). Written red first: on 3f1bd57\nthere is no claims subcommand and no attavo.claims module.\n\nRun: python3 -m pytest tests -q\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport subprocess\nimport sys\nfrom pathlib import Path\nfrom typing import Any\n\nfrom helpers import commit_all, git, make_tenant\n\nROOT = Path(__file__).resolve().parent.parent\nATTAVO = ROOT / \"bin\" / \"attavo\"\n\n\ndef run_attavo(root: Path, *args: str) -> subprocess.CompletedProcess[str]:\n    return subprocess.run([sys.executable, str(ATTAVO), *args], cwd=str(root),\n                          capture_output=True, text=True, check=False)\n\n\ndef push_branch(root: Path, branch: str, files: dict[str, str]) -> None:\n    \"\"\"A branch in flight: committed off main and published as\n    refs/remotes/origin/<branch>, the way a fetched remote branch reads,\n    then back on main.\"\"\"\n    git(root, \"checkout\", \"-q\", \"-b\", branch, \"main\")\n    for rel, text in files.items():\n        (root / rel).parent.mkdir(parents=True, exist_ok=True)\n        (root / rel).write_text(text)\n    commit_all(root, f\"work on {branch}\")\n    git(root, \"update-ref\", f\"refs/remotes/origin/{branch}\", git(root, \"rev-parse\", \"HEAD\").strip())\n    git(root, \"checkout\", \"-q\", \"main\")\n\n\ndef spec_text(claims: list[str]) -> str:\n    return (\"## Problem\\n\\nClass: fix\\n\\nsomething.\\n\\n## Claims\\n\\n\"\n            + \"\".join(f\"- {c}\\n\" for c in claims)\n            + \"\\n## Criteria\\n\\n- c.sh: exits 0\\n\")\n\n\ndef test_overlap_reads_paths_and_globs_both_ways() -> None:\n    from attavo.claims import overlap\n    assert overlap(\"attavo/spec.py\", \"attavo/spec.py\")\n    assert overlap(\"src/**\", \"src/a/b.py\") and overlap(\"src/a/b.py\", \"src/**\")\n    assert overlap(\"tests/fixtures/*/specs/*/spec.md\", \"tests/fixtures/\")\n    assert not overlap(\"attavo/spec.py\", \"attavo/verify.py\")\n    assert not overlap(\"src/**\", \"docs/readme.md\")\n\n\ndef test_claims_lists_unmerged_branches_with_their_spec_claims_and_skips_merged_ones(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"valid\")\n    push_branch(root, \"attavo/2-x\", {\"specs/2/spec.md\": spec_text([\"attavo/spec.py\"]),\n                                     \"records/2/spec-01.json\": \"{}\\n\"})\n    push_branch(root, \"lane/3-y\", {\"adapters/run\": \"x\\n\"})\n    push_branch(root, \"attavo/4-done\", {\"lib/z.py\": \"z\\n\"})\n    git(root, \"merge\", \"-q\", \"--no-ff\", \"-m\", \"merge 4\", \"attavo/4-done\")\n    git(root, \"update-ref\", \"refs/remotes/origin/main\", git(root, \"rev-parse\", \"HEAD\").strip())\n    run = run_attavo(root, \"claims\", \"--json\")\n    assert run.returncode == 0, run.stdout + run.stderr\n    report: dict[str, Any] = json.loads(run.stdout)\n    by_branch = {f[\"branch\"]: f for f in report[\"in_flight\"]}\n    assert set(by_branch) == {\"attavo/2-x\", \"lane/3-y\"}, by_branch\n    assert by_branch[\"attavo/2-x\"][\"item\"] == \"2\"\n    assert by_branch[\"attavo/2-x\"][\"declared\"] == [\"attavo/spec.py\"]\n    assert by_branch[\"attavo/2-x\"][\"changed\"] == [], \"specs and records are not changes\"\n    assert by_branch[\"lane/3-y\"][\"changed\"] == [\"adapters/run\"] and by_branch[\"lane/3-y\"][\"item\"] is None\n\n\ndef test_an_item_that_collides_with_work_in_flight_is_named_by_branch_and_path_and_exits_one(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"valid\")\n    push_branch(root, \"lane/9-other\", {\"src/marker.txt\": \"someone else\\n\"})\n    run = run_attavo(root, \"claims\", \"1\")\n    assert run.returncode == 1, run.stdout + run.stderr\n    assert \"item 1 collides with 1 branch(es) in flight:\" in run.stdout, run.stdout\n    assert \"lane/9-other: src/marker.txt\" in run.stdout, run.stdout\n\n\ndef test_an_item_with_disjoint_claims_exits_zero_and_its_own_branch_is_not_a_collision(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"valid\")\n    push_branch(root, \"attavo/1-self\", {\"src/marker.txt\": \"mine\\n\"})\n    push_branch(root, \"lane/9-other\", {\"docs/readme.md\": \"x\\n\"})\n    run = run_attavo(root, \"claims\", \"1\", \"--json\")\n    assert run.returncode == 0, run.stdout + run.stderr\n    report = json.loads(run.stdout)\n    assert report[\"item\"] == \"1\" and report[\"claims\"] == [\"src/**\"], report\n    assert report[\"collisions\"] == [], report\n\n\ndef test_claims_refuses_by_name_when_the_default_branch_is_not_set(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"valid\")\n    git(root, \"symbolic-ref\", \"--delete\", \"refs/remotes/origin/HEAD\")\n    run = run_attavo(root, \"claims\")\n    assert run.returncode == 2\n    assert \"refs/remotes/origin/HEAD is not set\" in run.stderr, run.stderr\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-IfJfPmdh' (errno=Operation not permitted)\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-boW5eX47' (errno=Operation not permitted)\nb028792 attavo: spec-gate record for item 251\n attest/records/251/spec-01.json | 19 +++++++++++++++++++\n 1 file changed, 19 insertions(+)\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-oJJlAhKy' (errno=Operation not permitted)\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-qXvN6mxI' (errno=Operation not permitted)\n## Problem\n\nClass: core\n\nTwo sessions built this product on 2026-09-27 and neither could see what the other was changing. The collisions were found by hand: #237 claimed `attavo/spec.py` while the Plan lane was about to specify a change to the same file. They were worked out between sessions through the operator and session tooling (`frontier.py --github`, kept in the Plan lane's handoff folder, not in the product). The product has everything needed to answer the question without that: each item's spec states its Claims, and every branch in flight is a git ref. Nothing in the product reads them together.\n\nThis item adds `attavo claims [N] [--json]`, a read from git alone. Work in flight is every branch under `refs/remotes/origin/` whose tip is not on the default branch (`refs/remotes/origin/HEAD`, as everywhere else in the product). For each it gives the paths the branch changes outside `paths.records` and `paths.specs`, and, when the branch carries an item's spec, that spec's Claims, parsed by `parse_spec` itself so the two can never disagree about what a claim is. With an item, it compares the item's own Claims with every other branch in flight, names each overlap by branch and path, and exits 1 when there is one. The item's own branch is never a collision. A claim is a glob, as build's boundary reads it. Two claims overlap when either matches the other, or, where one carries a wildcard, when their literal prefixes nest: \"may collide\" is reported, never \"cannot\". With `refs/remotes/origin/HEAD` unset, it refuses by name, as `verify` and the doctor do. It writes nothing, gates nothing and blocks nothing.\n\nThis is the lightweight version of claims arbitration (the Plan Map's E5, L1) and the read the screen's frontier view will render. What it will not see, stated so no one reads its silence as clear: intent declared in an open issue before any branch exists, and work that has not been pushed. The first needs the forge, which is a later item behind a manifest command like `[forge].checks_command`, never a vendor call from the product.\n\nThe selector maps `attavo/claims.py` to `tests/test_claims.py`, so a build touching the module runs its own tests, not the whole suite.\n\nThe stub under `stub/` is the change on `00a22d0`: `attavo/claims.py`, the dispatch and help text in `attavo/cli.py`, the selector line, and `tests/test_claims.py`, whose five tests are red on `00a22d0` (no such module). The help text keeps the unknown-subcommand message's `stops, test exist` ending, which a test reads. `python3 -m mypy` exits 0 on the change, and the suite passes on it.\n\nRetires: `frontier.py --github` as the only way to see work in flight (it stays for planned items, which live in the Plan store, until the Plan area reads them); collisions found by the operator relaying one session's claims to another.\n\n## Claims\n\n- attavo/claims.py\n- attavo/cli.py\n- .attavo/bin/select-tests\n- tests/test_claims.py\n\n## Criteria\n\n- claims-reads-work-in-flight-and-names-a-collision.sh: on the fixture tenant with one other branch in flight touching `docs/`, `attavo claims 1` reports no collision and `--json` lists that branch alone; once the branch also touches `src/marker.txt`, inside item 1's `src/**`, `attavo claims 1` exits 1 naming `lane/9-other: src/marker.txt`; and `tests/test_claims.py` carries the five tests named\n","exit_code":0,"status":"completed"}}

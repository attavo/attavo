       return cmd_stops(argv[1:])\nattavo/cli.py:449:        return cmd_test(argv[1:])\nattavo/cli.py:452:          f\"attest, drive, worker, ledger, claims, stops, test exist at this commit\", file=sys.stderr)\nattavo/verify.py:20:from attavo.common import MANIFEST, derive_item_id, git, now_iso, read_manifest\nattavo/verify.py:90:        [\"git\", \"-C\", str(root), \"symbolic-ref\", \"-q\", \"refs/remotes/origin/HEAD\"],\nattavo/verify.py:223:def cmd_verify(argv: list[str]) -> int:\nattavo/verify.py:225:    item_id = argv[0] if argv else derive_item_id(root)\nattavo/verify.py:248:    # claims, is the approved tree there -- asked against the approval,\nattavo/verify.py:259:    claims = parsed[\"claims\"] if parsed else []\nattavo/verify.py:260:    empty = (build_is_empty(root, build_approval_sha, build_sha, claims)\nattavo/drive.py:16:from attavo.common import MANIFEST, PRODUCT_ROOT, derive_item_id, git, read_manifest\nattavo/drive.py:499:def cmd_worker(argv: list[str]) -> int:\nattavo/drive.py:693:# claims-boundary stop is a person's; a tenant's gate refusal is the\nattavo/drive.py:701:NEVER_RETRIED_CLASSES = (\"claims-boundary\", \"gate\", \"environment\")\nattavo/drive.py:883:def cmd_drive(argv: list[str]) -> int:\nattavo/drive.py:928:    item_id = positional[0] if positional else derive_item_id(root)\nattavo/filing.py:9:from attavo.common import MANIFEST, derive_item_id, read_manifest\nattavo/filing.py:16:def cmd_file_findings(argv: list[str]) -> int:\nattavo/filing.py:18:    item_id = argv[0] if argv else derive_item_id(root)\nattavo/filing.py:88:def cmd_file_stops(argv: list[str]) -> int:\nattavo/filing.py:90:    item_id = argv[0] if argv else derive_item_id(root)\nattavo/attest.py:198:def cmd_attest(argv: list[str]) -> int:\ntests/test_spec_gate.py:562:def test_spec_gate_refuses_a_stub_that_touches_a_path_the_claims_do_not_name(tmp_path: Path) -> None:\ntests/test_spec_gate.py:565:    stub is the change's floor, so a stub path outside the claims is a\ntests/test_spec_gate.py:571:    commit_all(root, \"a stub file the claims do not name\")\ntests/test_spec_gate.py:574:    assert \"stub touches a path the claims do not name: lib/helper.py\" in run.stdout, run.stdout\ntests/test_verify.py:482:    subprocess.run([\"git\", \"-C\", str(root), \"symbolic-ref\", \"-d\", \"refs/remotes/origin/HEAD\"],\ntests/test_verify.py:508:    subprocess.run([\"git\", \"-C\", str(root), \"symbolic-ref\", \"-d\", \"refs/remotes/origin/HEAD\"],\ntests/test_build.py:2:names, check the claims boundary, run the criteria and the tenant's\ntests/test_build.py:92:def test_build_refuses_write_outside_claims(tmp_path: Path) -> None:\ntests/test_build.py:136:    touching it is refused by name, class claims-boundary, provenance\ntests/test_build.py:138:    not the definition of done the spec's claims describe). Tenant\ntests/test_build.py:151:    assert rec[\"stop\"] == {\"class\": \"claims-boundary\", \"provenance\": \"executor\",\ntests/test_build.py:157:    \"\"\"Issue #140, acceptance row 3. The same guard for paths.specs --\ntests/test_build.py:168:    assert rec[\"stop\"] == {\"class\": \"claims-boundary\", \"provenance\": \"executor\",\ntests/test_build.py:560:def test_build_refused_on_a_claims_violation_carries_claims_boundary_stop(tmp_path: Path) -> None:\ntests/test_build.py:561:    \"\"\"Issue #89, rejection test 3: a refusal naming a claims path is\ntests/test_build.py:562:    claims-boundary/spec -- the write-outside-claims specimen.\"\"\"\ntests/test_build.py:571:    assert rec[\"stop\"] == {\"class\": \"claims-boundary\", \"provenance\": \"spec\",\ntests/test_build.py:787:    log (build's own refusal field, set by cmd_build's own claims/identity\ntests/test_cli_help.py:130:def test_help_says_the_gate_refuses_a_stub_outside_the_claims() -> None:\ntests/test_cli_help.py:135:    assert \"stub touches a path the claims do not name\" in run.stdout, run.stdout\nattavo/record_only.py:13:def cmd_record_only(argv: list[str]) -> int:\ntests/test_testtool.py:276:    git(root, \"symbolic-ref\", \"refs/remotes/origin/HEAD\", \"refs/remotes/origin/main\")\ntests/test_adapters.py:157:    # Item 229: with a spec that names claims, Edit and Write are allowed on\ntests/test_sealed_since_default.py:60:    _git(root, \"symbolic-ref\", \"refs/remotes/origin/HEAD\", \"refs/remotes/origin/main\")\ntests/test_retry.py:282:    \"\"\"A question with no counsel configured, a claims-boundary stop, and\ntests/test_retry.py:287:        \"claims\": ({\"ATTAVO_FIXTURE_WRITE\": \"outside/claims.txt\"}, \"\"),\ntests/test_file_stops.py:81:    \"claims-boundary\", the boundary it never crossed (tenant zero's own\ntests/test_file_stops.py:125:                       {\"class\": \"claims-boundary\", \"provenance\": \"spec\", \"detail\": None},\ntests/test_file_stops.py:135:    assert [b[\"class\"] for b in filed_bodies] == [\"claims-boundary\", \"ceiling\"]\ntests/test_file_stops.py:159:        {\"class\": \"claims-boundary\", \"provenance\": \"spec\", \"detail\": None})\ntests/test_file_stops.py:179:        {\"class\": \"claims-boundary\", \"provenance\": \"spec\", \"detail\": None})\ntests/test_file_stops.py:284:                       {\"class\": \"claims-boundary\", \"provenance\": \"spec\", \"detail\": None})\ntests/test_file_stops.py:290:    assert filed_bodies[0][\"title\"] == \"stop claims-boundary/spec on item 1: build-01\"\ntests/fixtures/fails_on_stub/specs/1/spec.md:5:The stub overlay does not actually satisfy the criterion it claims to.\nfrom __future__ import annotations\n\nimport fnmatch\nimport os\nimport re\nimport shutil\nimport subprocess\nimport sys\nimport tempfile\nfrom pathlib import Path\nfrom typing import Any, cast\n\nfrom attavo.approval import approval_status\nfrom attavo.common import (\n    MANIFEST,\n    ShallowCheckoutError,\n    derive_item_id,\n    git,\n    last_commit_touching,\n    now_iso,\n    read_manifest,\n)\nfrom attavo.records import latest_record, write_record\n\n# --- the spec contract ---\n\nROOT_CAUSE_LINE = re.compile(r\"^Root-cause:\\s*([a-z0-9][a-z0-9-]*)\\s*$\")\nROOT_CAUSE_ENTRY = re.compile(r\"^- ([a-z0-9][a-z0-9-]*):\\s+\\S\")\nCLASS_LINE = re.compile(r\"^Class:\\s*(\\S+)\\s*$\")\nCLASSES = (\"core\", \"fix\")\n\n\ndef parse_spec(spec_md: Path) -> tuple[dict[str, Any] | None, str | None]:\n    lines = spec_md.read_text().splitlines()\n    heading_idx = [i for i, l in enumerate(lines) if l.startswith(\"## \")]\n    headings = [lines[i].rstrip() for i in heading_idx]\n    expected = [\"## Problem\", \"## Claims\", \"## Criteria\"]\n    if headings != expected:\n        bad = next((h for h in headings if h not in expected), None)\n        if bad is None:\n            missing = [h for h in expected if h not in headings]\n            bad = missing[0] if missing else \"heading order\"\n        return None, f\"headings: found {headings or ['(none)']}, expected {expected} ({bad})\"\n    idx_problem, idx_claims, idx_criteria = heading_idx\n    claims = [l.strip()[2:].strip() for l in lines[idx_claims + 1:idx_criteria]\n              if l.strip().startswith(\"- \")]\n    # A fix item names the root cause its change closes, as one line in\n    # the problem: \"Root-cause: <slug>\". Optional; when present the gate\n    # checks it against the tenant's closed list (root_cause_refusal).\n    root_cause = None\n    for l in lines[idx_problem + 1:idx_claims]:\n        m = ROOT_CAUSE_LINE.match(l)\n        if m:\n            root_cause = m.group(1)\n            break\n    # The item's class, declared by the operator at filing as one line in\n    # the problem: \"Class: core\" (the change touches the mechanism) or\n    # \"Class: fix\". Optional to parse; the gate requires it (class_refusal).\n    item_class = None\n    for l in lines[idx_problem + 1:idx_claims]:\n        cm = CLASS_LINE.match(l)\n        if cm:\n            item_class = cm.group(1)\n            break\n    criteria = []\n    for l in lines[idx_criteria + 1:]:\n        s = l.strip()\n        if not s.startswith(\"- \") or \":\" not in s:\n            continue\n        name = s[2:].split(\":\", 1)[0].strip()\n        criteria.append(name)\n    return {\"claims\": claims, \"criteria\": criteria, \"root_cause\": root_cause, \"class\": item_class}, None\n\n\ndef root_causes_path(root: Path, m: dict[str, Any]) -> Path:\n    \"\"\"The tenant's closed list of root causes: root-causes.md beside\n    the specs directory (attest/root-causes.md when specs live in\n    attest/specs). One root cause per line, \"- <slug>: <one sentence>\".\"\"\"\n    return root / Path(m[\"paths\"][\"specs\"]).parent / \"root-causes.md\"\n\n\ndef listed_root_causes(path: Path) -> list[str]:\n    if not path.is_file():\n        return []\n    return [mm.group(1) for mm in (ROOT_CAUSE_ENTRY.match(l) for l in path.read_text().splitlines()) if mm]\n\n\ndef root_cause_refusal(root: Path, m: dict[str, Any], root_cause: str | None) -> str | None:\n    \"\"\"A spec that names a root cause must name one the tenant lists.\n    Symptom counts do not converge; root-cause counts can, and only if\n    every root cause a fix item names is one the list already carries or\n    an item added on purpose. No root-cause line, no check: a capability\n    item has no root cause.\"\"\"\n    if root_cause is None:\n        return None\n    path = root_causes_path(root, m)\n    if not path.is_file():\n        return f\"root cause: {root_cause} named but {path.relative_to(root)} does not exist\"\n    if root_cause not in listed_root_causes(path):\n        return f\"root cause: {root_cause} is not listed in {path.relative_to(root)}\"\n    return None\n\n\ndef research_policy(m: dict[str, Any]) -> str:\n    \"\"\"[spec].research: \"required\" makes a core spec owe a research record\n    before its gate passes; absent, it owes none. Ruled 2026-09-27: every\n    core item owes research in the end state, behind this flag until the\n    Plan area hosts research. The gate record says which policy applied.\"\"\"\n    return \"required\" if (m.get(\"spec\") or {}).get(\"research\") == \"required\" else \"not required by policy\"\n\n\ndef class_refusal(m: dict[str, Any], parsed: dict[str, Any], records_dir: Path) -> str | None:\n    \"\"\"A spec declares its class; a spec that names a root cause is core\n    (ruled 2026-09-27: a root cause lies behind several issues, and closing\n    it changes the mechanism); and, when the tenant requires research, a\n    core spec has a research record in the item's records before its gate\n    passes.\"\"\"\n    item_class = parsed.get(\"class\")\n    if item_class is None:\n        return \"class: none declared; add a line 'Class: core' or 'Class: fix' to the problem\"\n    if item_class not in CLASSES:\n        return f\"class: {item_class} is not core or fix\"\n    if parsed.get(\"root_cause\") and item_class != \"core\":\n        return f\"class: {item_class} with root cause {parsed['root_cause']}; a root-cause item is core\"\n    if (item_class == \"core\" and research_policy(m) == \"required\"\n            and latest_record(records_dir, \"research\") is None):\n        return \"research: [spec].research is required and the item has no research record\"\n    return None\n\n\ndef run_criterion(exe: Path, cwd: Path) -> int:\n    try:\n        run = subprocess.run([str(exe)], cwd=str(cwd), capture_output=True,\n                             timeout=CRITERION_TIMEOUT, check=False)\n        return run.returncode\n    except subprocess.TimeoutExpired:\n        return 124\n    except OSError:\n        return 126\n\n\ndef stub_outside_claims(spec_dir: Path, claims: list[str]) -> str | None:\n    \"\"\"The first path under stub/ (or named in stub/.removed) that no claim\n    matches, or None. The stub is the change's floor: a path it touches is\n    a path the build will touch, so a Claims list that does not name it is\n    wrong before any build runs (item 229: a claim missed at filing cost\n    an attempt to find). Matched the way cmd_build matches (fnmatch), with\n    a directory claim covering everything under it.\"\"\"\n    stub_dir = spec_dir / \"stub\"\n    if not stub_dir.is_dir():\n        return None\n    paths = sorted(p.relative_to(stub_dir).as_posix() for p in stub_dir.rglob(\"*\")\n                   if p.is_file() and p.name != \".removed\")\n    paths += parse_removed(stub_dir)\n    patterns = [c + \"**\" if c.endswith(\"/\") else c for c in claims]\n    for path in paths:\n        if not any(fnmatch.fnmatch(path, pat) or path.startswith(pat.rstrip(\"*\")) and pat.endswith(\"**\")\n                   for pat in patterns):\n            return path\n    return None\n\n\ndef parse_removed(stub_dir: Path) -> list[str]:\n    \"\"\"The paths listed in stub/.removed, one per line, comments (lines\n    starting with #) and blank lines ignored. [] when the stub carries no\n    .removed at all.\n    \"\"\"\n    removed_file = stub_dir / \".removed\"\n    if not removed_file.is_file():\n        return []\n    paths = []\n    for line in removed_file.read_text().splitlines():\n        s = line.strip()\n        if not s or s.startswith(\"#\"):\n            continue\n        paths.append(s)\n    return paths\n\n\ndef removed_path_refusal(root: Path, stub_dir: Path, rel: str) -> str | None:\n    p = Path(rel)\n    if p.is_absolute() or \"..\" in p.parts:\n        return f\"stub/.removed names a path outside the tree: {rel}\"\n    if not (root / p).exists():\n        return f\"stub/.removed names a path not in the tree: {rel}\"\n    if (stub_dir / p).exists():\n        return f\"stub/.removed names a path the stub also supplies: {rel}\"\n    return None\n\n\ndef stub_removed_refusal(root: Path, spec_dir: Path) -> str | None:\n    \"\"\"Validated by name, before any criterion runs -- a stub whose\n    .removed cannot be applied has no meaning to gate against.\n    \"\"\"\n    stub_dir = spec_dir / \"stub\"\n    for rel in parse_removed(stub_dir):\n        refusal = removed_path_refusal(root, stub_dir, rel)\n        if refusal:\n            return refusal\n    return None\n\n\ndef run_criteria(root: Path, spec_dir: Path, names: list[str]) -> list[dict[str, Any]]:\n    criteria_dir = spec_dir / \"criteria\"\n    stub_dir = spec_dir / \"stub\"\n    with tempfile.TemporaryDirectory() as tmp:\n        tree = Path(tmp) / \"tree\"\n        stubbed = Path(tmp) / \"stubbed\"\n        shutil.copytree(root, tree, ignore=shutil.ignore_patterns(\".git\"))\n        shutil.copytree(root, stubbed, ignore=shutil.ignore_patterns(\".git\"))\n        if stub_dir.is_dir():\n            shutil.copytree(stub_dir, stubbed, dirs_exist_ok=True)\n            for rel in parse_removed(stub_dir):\n                target = stubbed / rel\n                if target.is_dir():\n                    shutil.rmtree(target)\n                elif target.exists():\n                    target.unlink()\n            removed_marker = stubbed / \".removed\"\n            if removed_marker.exists():\n                removed_marker.unlink()\n        results = []\n        for name in names:\n            exe = criteria_dir / name\n            results.append({\"name\": name,\n                            \"on_tree\": run_criterion(exe, tree),\n                            \"on_stub\": run_criterion(exe, stubbed)})\n        return results\n\n\ndef commit_postdates(root: Path, earlier: str, later: str) -> bool:\n    \"\"\"Whether later is a strict descendant of earlier on this branch.\"\"\"\n    if earlier == later:\n        return False\n    run = subprocess.run([\"git\", \"-C\", str(root), \"merge-base\", \"--is-ancestor\", earlier, later],\n                         capture_output=True, check=False)\n    return run.returncode == 0\n\n\ndef cmd_spec_gate(argv: list[str]) -> int:\nfrom __future__ import annotations\n\nimport os\nimport re\nimport subprocess\nimport tomllib\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom typing import Any\n\nMANIFEST = \"attavo.toml\"\n\nSTAGES = (\"spec\", \"approval\", \"build\", \"verify\")\n\n\nPRODUCT_ROOT = Path(__file__).resolve().parent.parent\n\n\nclass Proof:\n    def __init__(self, key: str, title: str) -> None:\n        self.key = key\n        self.title = title\n        self.holds = False\n        self.reason = \"\"\n        self.extra: dict[str, Any] = {}\n\n    def fail(self, reason: str, **extra: Any) -> \"Proof\":\n        self.holds, self.reason = False, reason\n        self.extra.update(extra)\n        return self\n\n    def hold(self, reason: str, **extra: Any) -> \"Proof\":\n        self.holds, self.reason = True, reason\n        self.extra.update(extra)\n        return self\n\n    def as_dict(self) -> dict[str, Any]:\n        return {\"proof\": self.key, \"title\": self.title,\n                \"holds\": self.holds, \"reason\": self.reason, **self.extra}\n\n\ndef read_manifest(root: Path) -> dict[str, Any] | None:\n    path = root / MANIFEST\n    if not path.is_file():\n        return None\n    with path.open(\"rb\") as fh:\n        return tomllib.load(fh)\n\n\ndef git(root: Path, *args: str, env: dict[str, str] | None = None) -> str:\n    out = subprocess.run([\"git\", \"-C\", str(root), *args],\n                         capture_output=True, text=True, check=False, env=env)\n    if out.returncode != 0:\n        raise RuntimeError(out.stderr.strip() or \"git failed\")\n    return out.stdout\n\n\ndef product_version() -> str:\n    \"\"\"What the running program is. Three fallbacks, in order, and never an\n    exception -- this runs inside write_record, after the work it\n    describes already happened, and a raise here would lose the record\n    for an invocation that already ran:\n\n      1. ATTAVO_PRODUCT_VERSION, when the environment sets it. The forge\n         action sets this from its own ref (action.yml, not here -- this\n         function stays forge-agnostic).\n      2. git describe --tags --always --dirty against PRODUCT_ROOT: a\n         tagged release reports its tag, a checkout reports its commit,\n         a dirty tree says so.\n      3. \"unknown\", when PRODUCT_ROOT is not a git repository at all --\n         the case for a forge that extracts this action from a tarball\n         rather than a git checkout, which is exactly when (1) is\n         expected to already have supplied the answer.\n\n    Distinct from the tenant's product_pin -- an operator running a\n    checkout, which is how every build and verify have actually been run\n    so far, bypasses the pin entirely (issue #49).\"\"\"\n    env = os.environ.get(\"ATTAVO_PRODUCT_VERSION\")\n    if env:\n        return env\n    try:\n        return git(PRODUCT_ROOT, \"describe\", \"--tags\", \"--always\", \"--dirty\").strip()\n    except RuntimeError:\n        return \"unknown\"\n\n\ndef now_iso() -> str:\n    return datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n\n\ndef derive_item_id(root: Path) -> str | None:\n    \"\"\"ATTAVO_ITEM first, not last: a rejection fixture's own item id must\n    win over whatever attavo/N-* branch the enclosing tenant repository\n    happens to be checked out on -- the common case is doctor running from\n    a real item's own branch, where a fallback-only env var would never be\n    consulted at all and every gate fixture would silently resolve to the\n    real item instead of its own.\"\"\"\n    env_item = os.environ.get(\"ATTAVO_ITEM\")\n    if env_item:\n        return env_item\n    out = subprocess.run([\"git\", \"-C\", str(root), \"rev-parse\", \"--abbrev-ref\", \"HEAD\"],\n                         capture_output=True, text=True, check=False)\n    branch = out.stdout.strip()\n    m = re.match(r\"^attavo/(\\d+)-\", branch)\n    return m.group(1) if m else None\n\n\ndef fixture_item_id(fixture: Path) -> str | None:\n    \"\"\"The one item id under a rejection fixture's own paths.specs, so the\n    doctor can export it as ATTAVO_ITEM: a fixture carries no attavo/N-*\n    branch for a gate command with no argument to derive from otherwise.\"\"\"\n    fm = read_manifest(fixture)\n    specs_rel = ((fm or {}).get(\"paths\") or {}).get(\"specs\")\n    if not specs_rel:\n        return None\n    specs_dir = fixture / specs_rel\n    if not specs_dir.is_dir():\n        return None\n    items = sorted(p.name for p in specs_dir.iterdir() if p.is_dir())\n    return items[0] if len(items) == 1 else None\n\n\nclass ShallowCheckoutError(RuntimeError):\n    pass\n\n\ndef last_commit_touching(root: Path, relpath: str) -> str | None:\n    shallow = subprocess.run([\"git\", \"-C\", str(root), \"rev-parse\", \"--is-shallow-repository\"],\n                             capture_output=True, text=True, check=False)\n    if shallow.stdout.strip() == \"true\":\n        raise ShallowCheckoutError(\n            \"shallow checkout: git log -1 -- <path> returns HEAD for every path on a \"\n            \"shallow clone; check out with fetch-depth: 0\")\n    out = subprocess.run([\"git\", \"-C\", str(root), \"log\", \"-1\", \"--format=%H\", \"--\", relpath],\n                         capture_output=True, text=True, check=False)\n    sha = out.stdout.strip()\n    return sha or None\n#!/bin/sh\nset -e\nhere=$(pwd)\ntmp=$(mktemp -d \"${TMPDIR:-/tmp}/attavo.XXXXXX\")\ncp -R \"$here/tests/fixtures/valid/.\" \"$tmp/tenant\"\ncd \"$tmp/tenant\"\ngit init -q -b main .\ngit config user.email fixture@attavo.invalid\ngit config user.name \"fixture\"\ngit add -A\ngit commit -q -m install\ngit update-ref refs/remotes/origin/main \"$(git rev-parse HEAD)\"\ngit symbolic-ref refs/remotes/origin/HEAD refs/remotes/origin/main\ngit checkout -q -b lane/9-other\nmkdir -p docs\nprintf 'x\\n' > docs/readme.md\ngit add -A\ngit commit -q -m other\ngit update-ref refs/remotes/origin/lane/9-other \"$(git rev-parse HEAD)\"\ngit checkout -q main\nA=\"python3 $here/bin/attavo\"\n$A claims 1 > \"$tmp/c1.out\"\ngrep -q \"item 1: no collision with work in flight\" \"$tmp/c1.out\"\n$A claims --json > \"$tmp/c2.json\"\npython3 -c 'import sys,json; r=json.load(open(sys.argv[1])); assert [f[\"branch\"] for f in r[\"in_flight\"]] == [\"lane/9-other\"], r' \"$tmp/c2.json\"\ngit checkout -q lane/9-other\nmkdir -p src\nprintf 'y\\n' > src/marker.txt\ngit add -A\ngit commit -q -m collide\ngit update-ref refs/remotes/origin/lane/9-other \"$(git rev-parse HEAD)\"\ngit checkout -q main\nif $A claims 1 > \"$tmp/c3.out\"; then exit 1; fi\ngrep -q \"lane/9-other: src/marker.txt\" \"$tmp/c3.out\"\ncd \"$here\"\nfor t in test_overlap_reads_paths_and_globs_both_ways test_claims_lists_unmerged_branches_with_their_spec_claims_and_skips_merged_ones test_an_item_that_collides_with_work_in_flight_is_named_by_branch_and_path_and_exits_one test_an_item_with_disjoint_claims_exits_zero_and_its_own_branch_is_not_a_collision test_claims_refuses_by_name_when_the_default_branch_is_not_set\ndo\n  grep -q \"^def $t(\" tests/test_claims.py\ndone\nrm -rf \"$tmp\"\n{\"type\":\"system\",\"subtype\":\"init\",\"cwd\":\"/Users/davidbean/Projects/attavo-worktree-251\",\"session_id\":\"72022d71-fa1f-4466-83c0-da8975385c67\",\"tools\":[\"Bash\",\"CronCreate\",\"CronDelete\",\"CronList\",\"DesignSync\",\"Edit\",\"EnterWorktree\",\"ExitWorktree\",\"ListAgents\",\"NotebookEdit\",\"PushNotification\",\"Read\",\"RemoteTrigger\",\"ReportFindings\",\"SendMessage\",\"Skill\",\"StructuredOutput\",\"TaskStop\",\"ToolSearch\",\"WebFetch\",\"WebSearch\",\"Write\"],\"mcp_servers\":[],\"model\":\"claude-sonnet-5\",\"permissionMode\":\"default\",\"slash_commands\":[\"code-factory-writing\",\"deep-research\",\"design\",\"design-sync\",\"dataviz\",\"update-config\",\"verify\",\"debug\",\"code-review\",\"simplify\",\"batch\",\"fewer-permission-prompts\",\"doctor\",\"loop\",\"schedule\",\"claude-api\",\"workflow-authoring\",\"run\",\"run-skill-generator\",\"advisor\",\"agents\",\"auto-mode-setup\",\"autocompact\",\"clear\",\"color\",\"compact\",\"config\",\"output-style\",\"context\",\"effort\",\"fast\",\"focus\",\"heapdump\",\"init\",\"mcp\",\"import\",\"model\",\"__remote-workflow\",\"workflow-launch-ex
    full_env.update(env)\\n    return subprocess.run([sys.executable, str(ATTAVO), *args], cwd=str(root),\\n                          capture_output=True, text=True, check=False, env=full_env)\\n\\n\\ndef latest_record(root: Path, item: str, stage: str) -> dict[str, Any]:\\n    records = sorted((root / \\\"records\\\" / item).glob(f\\\"{stage}-*.json\\\"))\\n    assert records, f\\\"no {stage} record for item {item}\\\"\\n    return cast(dict[str, Any], json.loads(records[-1].read_text()))\\n\\n\\ndef test_spec_gate_refuses_prose_criterion(tmp_path: Path) -> None:\\n    root = make_tenant(tmp_path, \\\"prose_criterion\\\")\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 1\\n    assert \\\"missing.sh\\\" in run.stdout\\n    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n    assert rec[\\\"status\\\"] == \\\"refused\\\"\\n    assert \\\"missing.sh\\\" in rec[\\\"refusal\\\"]\\n    # issue #49: this fixture's manifest carries no [attavo] table at all --\\n    # product_pin is the absent fact, null, not a crash reading it.\\n    assert rec[\\\"product_pin\\\"] is None\\n    assert rec[\\\"product_version\\\"]\\n\\n\\ndef test_spec_gate_refuses_criterion_passing_on_tree(tmp_path: Path) -> None:\\n    root = make_tenant(tmp_path, \\\"passes_on_tree\\\")\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 1\\n    assert \\\"checks.sh\\\" in run.stdout\\n    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n    assert rec[\\\"status\\\"] == \\\"refused\\\"\\n    assert \\\"checks.sh\\\" in rec[\\\"refusal\\\"]\\n\\n\\ndef test_spec_gate_refuses_criterion_failing_on_stub(tmp_path: Path) -> None:\\n    root = make_tenant(tmp_path, \\\"fails_on_stub\\\")\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 1\\n    assert \\\"checks.sh\\\" in run.stdout\\n    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n    assert rec[\\\"status\\\"] == \\\"refused\\\"\\n    assert \\\"checks.sh\\\" in rec[\\\"refusal\\\"]\\n\\n\\ndef test_spec_gate_refuses_wrong_headings(tmp_path: Path) -> None:\\n    root = make_tenant(tmp_path, \\\"wrong_headings\\\")\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 1\\n    assert \\\"Design\\\" in run.stdout\\n    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n    assert rec[\\\"status\\\"] == \\\"refused\\\"\\n    assert \\\"Design\\\" in rec[\\\"refusal\\\"]\\n\\n24:def run_attavo(root: Path, *args: str, env: dict[str, Any] | None = None) -> subprocess.CompletedProcess[str]:\\n32:def latest_record(root: Path, item: str, stage: str) -> dict[str, Any]:\\n38:def test_spec_gate_refuses_prose_criterion(tmp_path: Path) -> None:\\n52:def test_spec_gate_refuses_criterion_passing_on_tree(tmp_path: Path) -> None:\\n62:def test_spec_gate_refuses_criterion_failing_on_stub(tmp_path: Path) -> None:\\n72:def test_spec_gate_refuses_wrong_headings(tmp_path: Path) -> None:\\n82:def test_spec_gate_passes_and_writes_record(tmp_path: Path) -> None:\\n100:def amend_problem(root: Path) -> None:\\n107:def approve_valid(root: Path) -> None:\\n112:def complete_the_build(root: Path) -> None:\\n121:def test_spec_gate_reports_approved_when_approval_is_valid(tmp_path: Path) -> None:\\n144:def test_spec_gate_runs_when_approval_expired(tmp_path: Path) -> None:\\n164:def run_real_build(root: Path) -> subprocess.CompletedProcess[str]:\\n171:def test_spec_gate_built_after_build(tmp_path: Path) -> None:\\n198:def test_spec_gate_built_refuses_a_failing_criterion(tmp_path: Path) -> None:\\n227:def test_spec_gate_removed_deletes_the_path_from_the_stub(tmp_path: Path) -> None:\\n245:def test_spec_gate_removed_refuses_a_path_absent_from_the_tree(tmp_path: Path) -> None:\\n261:def test_spec_gate_removed_refuses_a_path_the_stub_also_supplies(tmp_path: Path) -> None:\\n277:def test_spec_gate_removed_refuses_a_path_outside_the_tree(tmp_path: Path) -> None:\\n293:def test_spec_gate_p
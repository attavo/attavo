issue said\\\\\\\",\\\\n]\\\\n\\\\n[tests]\\\\nselect = \\\\\\\"python3 .attavo/bin/select-tests\\\\\\\"\\\\nrun = \\\\\\\"xargs -r python3 -m pytest -q --deselect tests/test_doctor.py::test_every_gate_rejects --deselect tests/test_doctor.py::test_one_item_traversed_every_stage --deselect tests/test_doctor.py::test_no_commit_lacks_a_record --deselect tests/test_doctor.py::test_no_stop_lacks_cause --deselect tests/test_doctor.py::test_every_attested_item_is_sealed\\\\\\\"\\\\n\\\\n[paths]\\\\nspecs = \\\\\\\"attest/specs\\\\\\\"\\\\nrecords = \\\\\\\"attest/records\\\\\\\"\\\\nrulings = \\\\\\\"attest/rulings.md\\\\\\\"\\\\nrejections = \\\\\\\"attest/rejections\\\\\\\"\\\\n\\\\n[operators]\\\\napprovers = [\\\\\\\"dbean10\\\\\\\"]\\\\n\\\\n[checks]\\\\ncommand = \\\\\\\"python3 -m pytest tests -q --deselect tests/test_doctor.py::test_every_gate_rejects --deselect tests/test_doctor.py::test_one_item_traversed_every_stage --deselect tests/test_doctor.py::test_no_commit_lacks_a_record --deselect tests/test_doctor.py::test_no_stop_lacks_cause --deselect tests/test_doctor.py::test_every_attested_item_is_sealed\\\\\\\"\\\\n\\\\n[drive]\\\\nstall_after_s = 1800\\\\n{\\\\n  \\\\\\\"read\\\\\\\": true,\\\\n  \\\\\\\"reason\\\\\\\": null,\\\\n  \\\\\\\"checks\\\\\\\": [\\\\n    {\\\\n      \\\\\\\"name\\\\\\\": \\\\\\\"coherence\\\\\\\",\\\\n      \\\\\\\"conclusion\\\\\\\": \\\\\\\"success\\\\\\\",\\\\n      \\\\\\\"run_url\\\\\\\": null,\\\\n      \\\\\\\"log\\\\\\\": null\\\\n    },\\\\n    {\\\\n      \\\\\\\"name\\\\\\\": \\\\\\\"doctor\\\\\\\",\\\\n      \\\\\\\"conclusion\\\\\\\": \\\\\\\"success\\\\\\\",\\\\n      \\\\\\\"run_url\\\\\\\": null,\\\\n      \\\\\\\"log\\\\\\\": null\\\\n    },\\\\n    {\\\\n      \\\\\\\"name\\\\\\\": \\\\\\\"test\\\\\\\",\\\\n      \\\\\\\"conclusion\\\\\\\": \\\\\\\"success\\\\\\\",\\\\n      \\\\\\\"run_url\\\\\\\": null,\\\\n      \\\\\\\"log\\\\\\\": null\\\\n    },\\\\n    {\\\\n      \\\\\\\"name\\\\\\\": \\\\\\\"action-self-check
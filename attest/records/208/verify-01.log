out,\n        \"model\": model,\n        \"model_version\": model_version,\n        \"reports\": reports,\n        \"forge_checks\": forge_checks,\n        \"findings\": findings,\n        \"tests_named\": tests_named,\n        \"commits\": commits,\n        \"stub_ratio\": stub_ratio(diff_text, spec_dir / \"stub\", (specs_rel, records_rel)),\n        \"tokens\": tokens,\n        \"cost_usd\": cost_usd,\n        \"wall_clock_s\": round(time.monotonic() - started, 3),\n        \"status\": status_out,\n        \"stop\": derive_stop(status_out, log=transcript,\n                            report_class=(payload or {}).get(\"class\")),\n    }\n    record_path = write_record(item_records_dir, \"verify\", record, m, item_id, log=transcript)\n\n    print(f\"attavo verify: {status_out} ({record_path.name})\")\n    return 0 if status_out == \"pass\" else 1\n\n\n# issue #84: a constant the lane names, not a manifest key, until a tenant\n# disagrees -- how long drive gives a forge's checks room to conclude\n# before it gives up and stops rather than call a judge on a tree the\n# forge has not yet finished reading. Tenant zero's own checks conclude\n# about five minutes after a push; the default bound gives them room to\n# finish so a person is not the one re-running drive after CI, which is\n# exactly the transport act this lane retires. ATTAVO_DRIVE_POLL_BOUND_S\n# and ATTAVO_DRIVE_POLL_INTERVAL_S, read at call time rather than once at\n# import, are for a test's own clock, not a tenant's -- there is no\n# manifest key for either.\nDRIVE_FORGE_POLL_BOUND_DEFAULT_S = 600.0\n\nDRIVE_FORGE_POLL_INTERVAL_DEFAULT_S = 20.0\n\n\ndef drive_forge_poll_bound_s() -> float:\n    return float(os.environ.get(\"ATTAVO_DRIVE_POLL_BOUND_S\", DRIVE_FORGE_POLL_BOUND_DEFAULT_S))\n\n\ndef drive_forge_poll_interval_s() -> float:\n    return float(os.environ.get(\"ATTAVO_DRIVE_POLL_INTERVAL_S\", DRIVE_FORGE_POLL_INTERVAL_DEFAULT_S))\n\n\n{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"$id\": \"https://attavo.dev/schema/records/verify/6\",\n  \"title\": \"attavo verify record (verify-NN.json)\",\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"required\": [\n    \"record_version\", \"item\", \"sha\", \"build_sha\", \"build_record\", \"approval_sha\", \"at\", \"adapter\",\n    \"adapter_config\", \"adapter_version\", \"model\", \"model_version\", \"reports\",\n    \"forge_checks\", \"findings\", \"tests_named\", \"commits\",\n    \"stub_ratio\", \"tokens\", \"cost_usd\", \"wall_clock_s\", \"status\",\n    \"stop\", \"product_version\", \"product_pin\"\n  ],\n  \"properties\": {\n    \"record_version\": {\"type\": \"integer\", \"minimum\": 1},\n    \"item\": {\"type\": \"string\", \"minLength\": 1},\n    \"sha\": {\"type\": \"string\", \"minLength\": 1},\n    \"build_sha\": {\"type\": \"string\", \"minLength\": 1},\n    \"build_record\": {\"type\": [\"string\", \"null\"]},\n    \"approval_sha\": {\"type\": [\"string\", \"null\"]},\n    \"at\": {\"type\": \"string\", \"minLength\": 1},\n    \"adapter\": {\"type\": [\"string\", \"null\"]},\n    \"adapter_config\": {\n      \"type\": \"object\",\n      \"description\": \"Copied verbatim from [executor.<adapter>] merged with [executor.<adapter>.verify]; {} when no adapter was called.\"\n    },\n    \"adapter_version\": {\"type\": [\"string\", \"null\"]},\n    \"model\": {\"type\": [\"string\", \"null\"]},\n    \"model_version\": {\"type\": [\"string\", \"null\"]},\n    \"reports\": {\n      \"type\": \"array\",\n      \"description\": \"Field names adapters/<name>/conformance.json declares this adapter can supply with a real value (vendor independence, 2026-09-09 ruling) -- [] when no adapter was called or it declares no conformance.json. Dollars are never summed across adapters; a field absent here renders as not reported by this executor, never zero or blank.\",\n      \"items\": {\"type\": \"string\", \"minLength\": 1}\n    },\n    \"forge_checks\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\"command\", \"sha\", \"conclusions\"],\n      \"properties\": {\n        \"command\": {\"type\": \"string\", \"minLength\": 1},\n        \"sha\": {\"type\": \"string\", \"minLength\": 1},\n        \"conclusions\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"object\",\n            \"additionalProperties\": false,\n            \"required\": [\"name\", \"conclusion\"],\n            \"properties\": {\n              \"name\": {\"type\": \"string\", \"minLength\": 1},\n              \"conclusion\": {\"type\": \"string\", \"minLength\": 1}\n            }\n          }\n        }\n      }\n    },\n    \"findings\": {\n      \"type\": [\"array\", \"null\"],\n      \"description\": \"null when no adapter was called (the forge checks were not green), or when the adapter ran but reported no findings key at all -- distinct from an explicit empty list, which is a clean report, not a missing channel.\",\n      \"items\": {\n        \"type\": \"object\",\n        \"additionalProperties\": false,\n        \"required\": [\"title\", \"specimen\", \"retires\", \"rejection_test\", \"severity\"],\n        \"properties\": {\n          \"title\": {\"type\": \"string\", \"minLength\": 1},\n          \"specimen\": {\"type\": \"string\", \"minLength\": 1},\n          \"retires\": {\"type\": \"string\", \"minLength\": 1},\n          \"rejection_test\": {\"type\": \"string\", \"minLength\": 1},\n          \"severity\": {\"type\": \"string\", \"minLength\": 1}\n        }\n      }\n    },\n    \"tests_named\": {\n      \"type\": \"array\",\n      \"items\": {\"type\": \"string\", \"minLength\": 1}\n    },\n    \"commits\": {\n      \"type\": \"array\",\n      \"description\": \"Empty unless the adapter moved the branch head during verify -- a report, not a commit; a non-empty list here always accompanies status: \\\"failed\\\", naming exactly what the adapter should not have created.\",\n      \"items\": {\"type\": \"string\", \"minLength\": 1}\n    },\n    \"stub_ratio\": {\n      \"type\": [\"number\", \"null\"], \"minimum\": 0, \"maximum\": 1,\n      \"description\": \"The share of the lines the item's diff adds (outside the specs and records directories, blank lines aside) that are a line of the spec's stub at the same path. Near 1 the build shipped the stub; near 0 the builder wrote the change. Null when the spec carries no stub or the diff adds no counted line. Version 5 carried two further fields that no release ever computed; they are gone.\"\n    },\n    \"tokens\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\"input\", \"output\"],\n      \"properties\": {\n        \"input\": {\"type\": \"integer\", \"minimum\": 0},\n        \"output\": {\"type\": \"integer\", \"minimum\": 0}\n      }\n    },\n    \"cost_usd\": {\"type\": [\"number\", \"null\"]},\n    \"wall_clock_s\": {\"type\": \"number\", \"minimum\": 0},\n    \"status\": {\"type\": \"string\", \"enum\": [\"pass\", \"returned\", \"failed\"]},\n    \"stop\": {\n      \"type\": [\"object\", \"null\"],\n      \"description\": \"Non-null exactly when status is not \\\"pass\\\" (issue #89): what class of stop this is and whose it is, derived by the record writer from the forge_checks and log it already has -- never a fresh read of anything.\",\n      \"additionalProperties\": false,\n      \"required\": [\"class\", \"provenance\", \"detail\"],\n      \"properties\": {\n        \"class\": {\n          \"type\": \"string\",\n          \"enum\": [\"non-question\", \"outlived-invocation\", \"no-cause\", \"forge-unconcluded\",\n                   \"ceiling\", \"claims-boundary\", \"repeated-act\", \"unclassed\", \"question\",\n                   \"died\", \"hung\"]\n        },\n        \"provenance\": {\"type\": \"string\", \"enum\": [\"product\", \"tenant\", \"executor\", \"spec\"]},\n        \"detail\": {\n          \"type\": [\"string\", \"null\"
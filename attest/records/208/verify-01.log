ny, keyed_by_data: bool = Fals\n     return found\n \n \n+def _carried(predicate: dict[str, Any], key: str) -> str:\n+    return repr(predicate[key]) if key in predicate else \"absent\"\n+\n+\n def _accounting_disagrees(root: Path, item_records_dir: Path, item: str, merge_sha: str,\n                           statement: dict[str, Any]) -> str | None:\n     \"\"\"A sealed statement that carries `time` and `cost` says what its\n@@ -678,16 +683,18 @@ def _accounting_disagrees(root: Path, item_records_dir: Path, item: str, merge_s\n     the same commit (the statement is computed at the merge, so lead_s and\n     waiting_s are recomputed from its committer time, not excepted). Exact:\n     #202 retired the one-second tolerance. A statement sealed before `time`\n-    existed carries neither block and is not checked; one block without the\n-    other is a disagreement. No new read of the store.\"\"\"\n+    existed carries neither key and is not checked; a key that is present\n+    holds a block, so a null one, or one block without the other, is a\n+    disagreement. No new read of the store.\"\"\"\n     inner = statement.get(\"predicate\")\n     predicate = inner if isinstance(inner, dict) else statement\n-    stated_time, stated_cost = predicate.get(\"time\"), predicate.get(\"cost\")\n-    if stated_time is None and stated_cost is None:\n+    if \"time\" not in predicate and \"cost\" not in predicate:\n         return None\n+    stated_time, stated_cost = predicate.get(\"time\"), predicate.get(\"cost\")\n     where = f\"item {item} merged at {merge_sha[:12]}\"\n     if not isinstance(stated_time, dict) or not isinstance(stated_cost, dict):\n-        return f\"{where}: the statement carries one of time and cost without the other\"\n+        return (f\"{where}: the statement's time and cost are not both blocks \"\n+                f\"(time is {_carried(predicate, 'time')}, cost is {_carried(predicate, 'cost')})\")\n     try:\n         sealed_at: int | None = int(git(root, \"show\", \"-s\", \"--format=%ct\", merge_sha).strip())\n     except (RuntimeError, ValueError):\ndiff --git a/attavo/types.py b/attavo/types.py\nindex 96295bb..10277a7 100644\n--- a/attavo/types.py\n+++ b/attavo/types.py\n@@ -102,8 +102,6 @@ class VerifyRecord(TypedDict):\n     findings: list[dict[str, Any]] | None\n     tests_named: list[str]\n     commits: list[str]\n-    mutation: dict[str, Any] | None\n-    weak_stub: bool\n     stub_ratio: float | None\n     tokens: dict[str, int]\n     cost_usd: float | None\ndiff --git a/attavo/verify.py b/attavo/verify.py\nindex 2c40f2a..92a89ef 100644\n--- a/attavo/verify.py\n+++ b/attavo/verify.py\n@@ -86,6 +86,43 @@ def diff_since_approval(root: Path, approval_sha: str | None) -> tuple[str, str\n     return git(root, \"diff\", diff_base, \"HEAD\"), None\n \n \n+def stub_ratio(diff_text: str, stub_dir: Path, excluded: tuple[str, ...]) -> float | None:\n+    \"\"\"The share of the lines diff_text adds that are a line of the stub's\n+    file at the same path: near 1 the build shipped the spec author's stub,\n+    near 0 the builder wrote the change. Lines under the excluded\n+    directories (the specs and records, where the stub itself and the\n+    item's records are committed) and blank lines are not counted. None\n+    when there is no stub or the diff adds no counted line -- nothing was\n+    measured, which is not 0.0.\"\"\"\n+    if not stub_dir.is_dir():\n+        return None\n+    skipped = tuple(e.strip(\"/\") for e in excluded)\n+    stub_lines: dict[str, set[str]] = {}\n+    path: str | None = None\n+    in_hunk = False\n+    added = shipped = 0\n+    for line in diff_text.splitlines():\n+        if line.startswith(\"diff --git \"):\n+            path, in_hunk = None, False\n+        elif in_hunk:\n+            if line.startswith(\"+\") and line[1:].strip() and path is not None:\n+                added += 1\n+                shipped += line[1:].rstrip() in stub_lines[path]\n+        elif line.startswith(\"+++ \"):\n+            name = line[4:].split(\"\\t\")[0]\n+            path = name[2:] if name.startswith(\"b/\") else None\n+            if path is not None and any(path == e or path.startswith(e + \"/\") for e in skipped):\n+                path = None\n+            if path is not None and path not in stub_lines:\n+                stub_file = stub_dir / path\n+                stub_lines[path] = (\n+                    {text.rstrip() for text in stub_file.read_text(errors=\"replace\").splitlines()}\n+                    if stub_file.is_file() else set())\n+        elif line.startswith(\"@@\"):\n+            in_hunk = True\n+    return shipped / added if added else None\n+\n+\n def cmd_verify(argv: list[str]) -> int:\n     root = Path(\".\").resolve()\n     item_id = argv[0] if argv else derive_item_id(root)\n@@ -147,7 +184,7 @@ def cmd_verify(argv: list[str]) -> int:\n             \"findings\": None,\n             \"tests_named\": [],\n             \"commits\": [],\n-            \"mutation\": None, \"weak_stub\": False, \"stub_ratio\": None,\n+            \"stub_ratio\": None,\n             \"tokens\": {\"input\": 0, \"output\": 0}, \"cost_usd\": None,\n             \"wall_clock_s\": round(time.monotonic() - started, 3),\n             \"status\": \"returned\",\n@@ -254,7 +291,7 @@ def cmd_verify(argv: list[str]) -> int:\n         \"findings\": findings,\n         \"tests_named\": tests_named,\n         \"commits\": commits,\n-        \"mutation\": None, \"weak_stub\": False, \"stub_ratio\": None,\n+        \"stub_ratio\": stub_ratio(diff_text, spec_dir / \"stub\", (specs_rel, records_rel)),\n         \"tokens\": tokens,\n         \"cost_usd\": cost_usd,\n         \"wall_clock_s\": round(time.monotonic() - started, 3),\ndiff --git a/schema/records/verify.schema.json b/schema/records/verify.schema.json\nindex a0b0212..13c1244 100644\n--- a/schema/records/verify.schema.json\n+++ b/schema/records/verify.schema.json\n@@ -1,14 +1,14 @@\n {\n   \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n-  \"$id\": \"https://attavo.dev/schema/records/verify/5\",\n+  \"$id\": \"https://attavo.dev/schema/records/verify/6\",\n   \"title\": \"attavo verify record (verify-NN.json)\",\n   \"type\": \"object\",\n   \"additionalProperties\": false,\n   \"required\": [\n     \"record_version\", \"item\", \"sha\", \"build_sha\", \"build_record\", \"approval_sha\", \"at\", \"adapter\",\n     \"adapter_config\", \"adapter_version\", \"model\", \"model_version\", \"reports\",\n-    \"forge_checks\", \"findings\", \"tests_named\", \"commits\", \"mutation\",\n-    \"weak_stub\", \"stub_ratio\", \"tokens\", \"cost_usd\", \"wall_clock_s\", \"status\",\n+    \"forge_checks\", \"findings\", \"tests_named\", \"commits\",\n+    \"stub_ratio\", \"tokens\", \"cost_usd\", \"wall_clock_s\", \"status\",\n     \"stop\", \"product_version\", \"product_pin\"\n   ],\n   \"properties\": {\n@@ -78,18 +78,10 @@\n       \"description\": \"Empty unless the adapter moved the branch head during verify -- a report, not a commit; a non-empty list here always accompanies status: \\\"failed\\\", naming exactly what the adapter should not have created.\",\n       \"items\": {\"type\": \"string\", \"minLength\": 1}\n     },\n-    \"mutation\": {\n-      \"type\": [\"object\", \"null\"],\n-      \"additionalProperties\": false,\n-      \"required\": [\"command\", \"score\", \"modules\"],\n-      \"properties\": {\n-        \"command\": {\"type\": \"string\", \"minLength\": 1},\n-        \"score\": {\"type\": \"number\", \"minimum\": 0, \"maximum\": 1},\n-        \"modules\": {\"type\": \"array\", \"items\": {\"type\": \"string\", \"minLength\": 1}}\n-      }\n+    \"stub_ratio\": {\n+      \"type\": [\"number\", \"null\"], \"minimum\": 0, \"maximum\": 1,\n+      \"description\": \"The share of the lines the item's diff adds (outside the specs and records directories, blank lines aside) that are a line of the spec's stub at the same path. Near 1 the build shipped the stub; near 0 the builder wrote the change. Null when the spec carries no stub or the diff adds no counted line. Version 5 carried two further fields that no release ever computed; they are gone.\"\n     },\n-    \"weak_stub\": {\"type\": \"boolean\"},\n-    \"stub_ratio\": {\"type\": [\"number\", \"null\"]},\n     \"tokens\": {\n       \"type\": \"object\",\n       \"additionalProperties\": false,\ndiff --git a/tests/test_attest_time.py b/tests/test_attest_time.py\nindex 08fef01..4ab5025 100644\n--- a/tests/test_attest_time.py\n+++ b/tests/test_attest_time.py\n@@ -246,3 +246,36 @@ def test_doctor_holds_a_true_statement_however_its_store_prints_it(tmp_path: Pat\n     seal(root, merge, statement)\n     held = proof_six(root)\n     assert held[\"holds\"] is True and held[\"sealed\"] == [\"1\"], held\n+\n+\n+def test_doctor_rejects_null_time_without_cost(tmp_path: Path) -> None:\n+    \"\"\"#204's review: `\"time\": null` with no cost read as a statement sealed\n+    before the accounting existed, and was not checked at all.\"\"\"\n+    root, merge = make_item(tmp_path, INVOCATIONS)\n+    statement = attest(root)\n+    statement[\"time\"] = None\n+    del statement[\"cost\"]\n+    seal(root, merge, statement)\n+    failed = proof_six(root)\n+    assert failed[\"holds\"] is False, failed\n+    assert \"item 1\" in failed[\"reason\"] and \"time\" in failed[\"reason\"], failed\n+\n+    statement[\"cost\"] = None\n+    seal(root, merge, statement)\n+    assert proof_six(root)[\"holds\"] is False, \"both blocks null is carried, not absent\"\n+\n+\n+def test_doctor_rejects_large_integer_that_rounds_to_summed_float(tmp_path: Path) -> None:\n+    \"\"\"#204's review: both sides were converted to float, so an integer one\n+    past 2**53 equalled the float beside it.\"\"\"\n+    big = 9007199254740992.0\n+    root, merge = make_item(tmp_path, [(\"build\", 1, big, 0.25, \"alpha\"), (\"verify\", 1, 0.0, None, \"beta\")])\n+    statement = attest(root)\n+    assert statement[\"time\"][\"build\"][\"invocation_s\"] == big\n+    seal(root, merge, statement)\n+    assert proof_six(root)[\"holds\"] is True\n+    statement[\"time\"][\"build\"][\"invocation_s\"] = 9007199254740993\n+    seal(root, merge, statement)\n+    failed = proof_six(root)\n+    assert failed[\"holds\"] is False, failed\n+    assert \"item 1\" in failed[\"reason\"] and \"time.build\" in failed[\"reason\"], failed\ndiff --git a/tests/test_file_findings.py b/tests/test_file_findings.py\nindex 226edaf..9f705ec 100644\n--- a/tests/test_file_findings.py\n+++ b/tests/test_file_findings.py\n@@ -45,7 +45,7 @@ def write_verify_record(root: Path, item: str, findings: list[Any]) -> None:\n         \"model\": \"fixture\", \"model_version\": None,\n         \"forge_checks\": {\"command\": \"true\", \"sha\": \"0\" * 40, \"conclusions\": []},\n         \"findings\": findings, \"tests_named\": [],\n-        \"mutation\": None, \"weak_stub\": False, \"stub_ratio\": None,\n+        \"stub_ratio\": None,\n         \"tokens\": {\"input\": 0, \"output\": 0}, \"cost_usd\": None,\n         \"wall_clock_s\": 0.1, \"status\": \"pass\",\n     }\ndiff --git a/tests/test_stub_ratio.py b/tests/test_stub_ratio.py\nnew file mode 100644\nindex 0000000..dc1fb62\n--- /dev/null\n+++ b/tests/test_stub_ratio.py\n@@ -0,0 +1,78 @@\n+\"\"\"verify's stub_ratio: whose code the review judged. On #194 and #204 the\n+build shipped the spec author's stub almost line for line and every record\n+said weak_stub false, stub_ratio null: three fields no release computed.\n+\n+Run: python3 -m pytest tests -q\n+\"\"\"\n+from __future__ import annotations\n+\n+import json\n+from pathlib import Path\n+\n+from attavo.verify import stub_ratio\n+from helpers import git, make_tenant\n+from test_drive import GREEN_FORGE, add_bare_remote, add_forge, approve_item, latest_record, run_attavo\n+\n+ROOT = Path(__file__).resolve().parent.parent\n+EXCLUDED = (\"specs\", \"records\")\n+\n+\n+def diff(path: str, *added: str) -> str:\n+    body = \"\".join(f\"+{line}\\n\" for line in added)\n+    return f\"diff --git a/{path} b/{path}\\n--- a/{path}\\n+++ b/{path}\\n@@ -0,0 +1,{len(added)} @@\\n{body}\"\n+\n+\n+def stub(tmp_path: Path, files: dict[str, str]) -> Path:\n+    root = tmp_path / \"stub\"\n+    for rel, text in files.items():\n+        (root / rel).parent.mkdir(parents=True, exist_ok=True)\n+        (root / rel).write_text(text)\n+    root.mkdir(exist_ok=True)\n+    return root\n+\n+\n+def test_stub_ratio_is_one_when_every_added_line_is_the_stubs(tmp_path: Path) -> None:\n+    s = stub(tmp_path, {\"pkg/a.py\": \"def f():\\n    return 1\\n\"})\n+    assert stub_ratio(diff(\"pkg/a.py\", \"def f():\", \"    return 1\"), s, EXCLUDED) == 1.0\n+\n+\n+def test_stub_ratio_is_the_share_across_files_and_ignores_blank_lines(tmp_path: Path) -> None:\n+    s = stub(tmp_path, {\"pkg/a.py\": \"def f():\\n    return 1\\n\"})\n+    text = diff(\"pkg/a.py\", \"def f():\", \"\", \"    return 2\") + diff(\"pkg/b.py\", \"x = 1\", \"y = 2\")\n+    assert stub_ratio(text, s, EXCLUDED) == 0.25\n+\n+\n+def test_stub_ratio_matches_a_line_only_against_the_stubs_file_at_the_same_path(tmp_path: Path) -> None:\n+    s = stub(tmp_path, {\"pkg/a.py\": \"x = 1\\n\"})\n+    assert stub_ratio(diff(\"pkg/b.py\", \"x = 1\"), s, EXCLUDED) == 0.0\n+\n+\n+def test_stub_ratio_does_not_count_the_specs_or_the_records_directory(tmp_path: Path) -> None:\n+    s = stub(tmp_path, {\"pkg/a.py\": \"x = 1\\n\"})\n+    text = diff(\"specs/1/stub/pkg/a.py\", \"x = 1\") + diff(\"records/1/build-01.json\", \"{}\") + diff(\"pkg/a.py\", \"x = 1\")\n+    assert stub_ratio(text, s, EXCLUDED) == 1.0\n+\n+\n+def test_stub_ratio_is_null_with_no_stub_or_no_added_line_and_never_zero(tmp_path: Path) -> None:\n+    assert stub_ratio(diff(\"pkg/a.py\", \"x = 1\"), tmp_path / \"absent\", EXCLUDED) is None\n+    s = stub(tmp_path, {\"pkg/a.py\": \"x = 1\\n\"})\n+    assert stub_ratio(\"\", s, EXCLUDED) is None\n+    assert stub_ratio(diff(\"records/1/build-01.json\", \"{}\"), s, EXCLUDED) is None\n+\n+\n+def test_verify_records_the_ratio_and_no_longer_carries_the_two_fields_nothing_computed(tmp_path: Path) -> None:\n+    root = make_tenant(tmp_path, \"build_valid\")\n+    add_forge(root, GREEN_FORGE)\n+    add_bare_remote(root, tmp_path)\n+    # on the item's own branch, as a real item is: the diff under review is\n+    # the branch's work against the default branch, and drive pushes as it goes\n+    git(root, \"checkout\", \"-q\", \"-b\", \"attavo/1-x\")\n+    approve_item(root)\n+    assert run_attavo(root, \"drive\", \"1\").returncode == 0\n+    assert run_attavo(root, \"drive\", \"1\").returncode == 0\n+    record = latest_record(root, \"verify\")\n+    assert record[\"stub_ratio\"] == 0.0, record[\"stub_ratio\"]\n+    assert \"weak_stub\" not in record and \"mutation\" not in record, sorted(record)\n+    schema = json.loads((ROOT / \"schema\" / \"records\" / \"verify.schema.json\").read_text())\n+    assert schema[\"$id\"].endswith(\"/verify/6\"), schema[\"$id\"]\n+    assert \"weak_stub\" not in schema[\"properties\"] and \"mutation\" not in schema[\"properties\"]\n10:{\"type\":\"assistant\",\"message\":{\"model\":\"claude-sonnet-5\",\"id\":\"msg_011CfFR1Ge4QWMAezgv3uN7z\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_01BUdA9CWH8VbBuzvrVMDuHK\",\"name\":\"Bash\",\"input\":{\"command\":\"grep -rn \\\"weak_stub\\\\|stub_ratio\\\\|mutation\\\" --include=* -I . --exclude-dir=.git --exclude-dir=__pycache__ | grep -v \\\"^./attest/records\\\" | head -60\"},\"caller\":{\"type\":\"direct\"}}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":1260,\"cache_read_input_tokens\":18458,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":1260},\"output_tokens\":8,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"input_transformations\":[],\"diagnostics\
mits from the item's\n57- first spec commit to its merge (the same derivation doctor's proof two\n58-@@ -537,7 +562,7 @@ def write_record(records_dir: Path, stage: str, record: dict, m: dict, item: str\n59- \n60: STOP_CLASSES = (\"non-question\", \"outlived-invocation\", \"no-cause\", \"forge-unconcluded\",\n61-                \"ceiling\", \"claims-boundary\", \"repeated-act\", \"unclassed\", \"question\",\n62--               \"environment\", \"gate\")\n63:+               \"environment\", \"gate\", \"died\", \"hung\")\n64- STOP_PROVENANCES = (\"product\", \"tenant\", \"executor\", \"spec\")\n65- \n66- # Beyond the enum spelling itself, the prose issue #88 actually shipped\n67-@@ -804,6 +829,253 @@ def merge_introducing_records(root: Path, records_rel: str, item: str,\n--\n72-+# and committed before the adapter runs, so that an invocation which dies\n73-+# or hangs before writing its own record is a fact on the branch (proof\n74-+# five) rather than a silence (issue #151). ---\n75-+\n76:+INVOCATION_MARKER_SUFFIX = \".started\"\n77-+\n78-+\n79-+def invocation_marker_path(records_dir: Path, stage: str, nn: int) -> Path:\n80-+    return records_dir / f\"{stage}-{nn:02d}{INVOCATION_MARKER_SUFFIX}\"\n81-+\n82-+\n83-+def write_invocation_marker(root: Path, records_dir: Path, stage: str, nn: int) -> Path:\n84-+    \"\"\"The fact that an invocation began, written before it does: at,\n85:+    host, pid, the sha it starts on, and the product that started it.\n86-+    Its record's arrival is what retires it; a marker with no record is\n87:+    an invocation that died or hangs, and proof five names it.\"\"\"\n88-+    import os\n89-+    import socket\n90-+    records_dir.mkdir(parents=True, exist_ok=True)\n91-+    path = invocation_marker_path(records_dir, stage, nn)\n--\n97-+\n98-+\n99-+def invocation_alive(info: dict) -> bool:\n100-+    \"\"\"Whether the marker's pid is a live process on this host. Another\n101:+    host's pid is unknowable from here and reads as not alive: a drive\n102:+    that ran elsewhere and wrote no record is died by absence.\"\"\"\n103-+    import os\n104-+    import socket\n105-+    if info.get(\"host\") != socket.gethostname():\n106-+        return False\n--\n116-+    return True\n117-+\n118-+\n119-+def invocations_without_record(item_records_dir: Path) -> list[tuple[Path, dict]]:\n120:+    \"\"\"Every <stage>-NN.started under one item whose <stage>-NN.json has\n121-+    not arrived, with the marker's own dict ({} when unreadable).\"\"\"\n122-+    out: list[tuple[Path, dict]] = []\n123-+    if not item_records_dir.is_dir():\n124-+        return out\n--\n133-+        out.append((marker, info if isinstance(info, dict) else {}))\n134-+    return out\n135-+\n136-+\n137:+def stall_bound_s(m: dict) -> int | None:\n138:+    \"\"\"[drive].stall_after_s: the tenant's own bound past which a live\n139:+    invocation with no new event is hung. A bound the tenant did not\n140-+    write is a forecast, so there is no default.\"\"\"\n141:+    bound = (m.get(\"drive\") or {}).get(\"stall_after_s\")\n142-+    if isinstance(bound, bool) or not isinstance(bound, (int, float)) or bound <= 0:\n143-+        return None\n144-+    return int(bound)\n145-+\n--\n151-+    records_rel = m.get(\"paths\", {}).get(\"records\", \"\")\n152-+    records_dir = root / records_rel\n153-+    if not records_dir.is_dir():\n154-+        return p.fail(f\"no records directory under {records_dir}\")\n155:+    if stall_bound_s(m) is None:\n156:+        return p.fail(\"no [drive].stall_after_s in the manifest; a hung invocation cannot be \"\n157-+                      \"told from a running one\")\n158-+    recorded = 0\n159-+    running: list[str] = []\n160-+    problems: list[str] = []\n--\n166-+            name = f\"item {item_dir.name} {marker.stem}\"\n167-+            if invocation_alive(info):\n168-+                running.append(f\"{name} (pid {info.get('pid')} since {info.get('at')})\")\n169-+                continue\n170:+            problems.append(f\"{name} started {info.get('at')} on {info.get('host')} \"\n171-+                            f\"pid {info.get('pid')} and never wrote its record\")\n172-+    if problems:\n173-+        return p.fail(\"; \".join(problems), unrecorded_invocations=len(problems),\n174-+                      running_invocations=running)\n--\n189-+\n190-+\n191-+def _events_tail(path: Path | None, lines: int = 20) -> str:\n192-+    \"\"\"The last lines of the adapter's own events file, as text for the\n193:+    recovered record's own log -- or a line saying why there is none.\"\"\"\n194-+    if path is None:\n195-+        return \"no events file for this invocation\\n\"\n196-+    try:\n197-+        text = path.read_text()\n--\n210-+        return None\n211-+    return (datetime.now(timezone.utc) - then).total_seconds()\n212-+\n213-+\n214:+def _seconds_since_last_event(events_path: Path | None, started_at: str | None) -> float | None:\n215-+    \"\"\"How long since this invocation last wrote to its events file --\n216-+    the file's own mtime, which is exactly when a new event last reached\n217-+    disk, without reparsing every event line's own timestamp. Falls back\n218-+    to the marker's own start time when there is no events file at all.\"\"\"\n219-+    if events_path is not None:\n220-+        return time.time() - events_path.stat().st_mtime\n221:+    return _seconds_since(started_at)\n222-+\n223-+\n224:+def _drive_recover(root: Path, m: dict, item_id: str) -> int:\n225:+    \"\"\"`attavo drive --recover [N]`: every invocation of item N that began\n226:+    and wrote no record ends in one here -- class died when its pid is\n227:+    gone or on another host, class hung when it is alive past\n228:+    [drive].stall_after_s with no newer event (and terminated); provenance\n229-+    product; the events tail as the log. A live invocation inside the\n230-+    bound is running and left alone. The record is committed and pushed\n231-+    the way every stage record is; the ordinary relaunch then reads a\n232-+    non-pass record and does what it does.\"\"\"\n233-+    import os\n234-+    import signal\n235-+    records_rel = m[\"paths\"][\"records\"]\n236-+    records_dir = root / records_rel / item_id\n237:+    bound = stall_bound_s(m)\n238-+    if bound is None:\n239:+        print(\"attavo drive: refused: no [drive].stall_after_s in the manifest; a hung \"\n240-+              \"invocation cannot be told from a running one\")\n241-+        return 1\n242-+    pending = invocations_without_record(records_dir)\n243-+    if not pending:\n244:+        print(f\"attavo drive: item {item_id}: every invocation has its record; nothing to recover\")\n245-+        return 0\n246-+    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n247-+    try:\n248-+        git(root, \"remote\", \"get-url\", \"origin\")\n249-+        has_origin = True\n250-+    except RuntimeError:\n251-+        has_origin = False\n252:+    recovered = 0\n253-+    for marker, info in pending:\n254-+        stage, nn_text = marker.stem.rsplit(\"-\", 1)\n255-+        nn = int(nn_text)\n256-+        events = _events_path_for(root, stage, nn)\n--\n258-+        age = _seconds_since_last_event(events, info.get(\"at\"))\n259-+        pid, host = info.get(\"pid\"), info.get(\"host\")\n260-+        if invocation_alive(info):\n261-+            if age is None or age <= bound:\n262:+                print(f\"attavo drive: {marker.stem} is running (pid {pid}, last event \"\n263-+                      f\"{'unknown' if age is None else int(age)} s ago, bound {bound} s); \"\n264:+                      f\"nothing to recover\")\n265-+                continue\n266:+            cls = \"hung\"\n267-+            try:\n268-+                os.kill(int(pid), signal.SIGTERM)\n269-+                ended = \"terminated\"\n270-+            except OSError as exc:\n271-+                ended = f\"not terminated ({exc})\"\n272-+            detail = (f\"pid {pid} on {host} alive with no event for {int(age)} s \"\n273-+                      f\"(bound {bound} s); {ended}\")\n274-+        else:\n275:+            cls = \"died\"\n276-+            detail = (f\"pid {pid} on {host} is not running and wrote no {marker.stem}.json; \"\n277:+                      f\"started {info.get('at')}\")\n278-+        if next_attempt_number(records_dir, stage) != nn:\n279:+            print(f\"attavo drive: stopped: {marker.name} names attempt {nn} but the next \"\n280-+                  f\"{stage} record would be {next_attempt_number(records_dir, stage):02d}; \"\n281:+                  f\"a later record already exists, read the records before recovering\")\n282-+            return 1\n283-+        schema = stage_schema(stage)\n284-+        record = {k: None for k in schema.get(\"required\", [])}\n285-+        approval = latest_record(records_dir, \"approval\") or {}\n--\n293-+        record = {k: v for k, v in record.items() if k in schema.get(\"properties\", {})}\n294-+        try:\n295-+            path = write_record(records_dir, stage, record, m, item_id, log=log)\n296-+        except ValueError as exc:\n297:+            print(f\"attavo drive: stopped: could not write the {cls} record for {marker.stem}: {exc}\")\n298-+            return 1\n299-+        try:\n300-+            commit_record(root, [path], f\"attavo: {stage} record for item {item_id} \"\n301:+                                        f\"({path.stem}), recovered as {cls}\")\n302-+        except RuntimeError as exc:\n303:+            print(f\"attavo drive: stopped: could not commit the {cls} record: {exc}\")\n304-+            return 1\n305-+        if has_origin:\n306-+            ok, err = push_record_commit(root, branch)\n307-+            if not ok:\n308:+                print(f\"attavo drive: stopped: could not push the {cls} record: {err}\")\n309-+                return 1\n310-+        else:\n311:+            print(f\"attavo drive: note: no origin remote; {path.name} is committed, not pushed\")\n312:+        print(f\"attavo drive: recovered {marker.stem} as {cls}: {detail}\")\n313:+        recovered += 1\n314:+    print(f\"attavo drive: item {item_id}: {recovered} invocation(s) recovered\")\n315-+    return 0\n316-+\n317-+\n318- def proof_one_item_every_stage(root: Path, m: dict | None) -> Proof:\n--\n327-+            proof_no_invocation_lacks_record(root, m)]\n328- \n329- \n330- def cmd_doctor(argv: list[str]) -> int:\n331:@@ -2494,6 +2767,20 @@ def _drive_run_stage(root: Path, records_dir: Path, branch: str, stage: str, ite\n332:     pushes stay the same pushes, made by drive in the run that produced\n333-     the record (issue #84's rule 42 row).\"\"\"\n334-     before = latest_attempt_path(records_dir, stage)\n335-+    # The invocation's marker, committed and pushed before the stage runs:\n336-+    # one commit per attempt, so that an invocation which dies or hangs\n337-+    # is a fact on the branch (proof five) and not a silence.\n338-+    nn = next_attempt_number(records_dir, stage)\n339-+    marker = write_invocation_marker(root, records_dir, stage, nn)\n340-+    try:\n341:+        commit_record(root, [marker], f\"attavo: {stage} invocation {nn:02d} started for item {item_id}\")\n342-+    except RuntimeError as exc:\n343:+        print(f\"attavo drive: stopped: could not commit the {stage} invocation marker: {exc}\")\n344-+        return 1\n345-+    ok, err = push_record_commit(root, branch)\n346-+    if not ok:\n347:+        print(f\"attavo drive: stopped: could not push the {stage} invocation marker: {err}\")\n348-+        return 1\n349-     rc = cmd_build([item_id]) if stage == \"build\" else cmd_verify([item_id])\n350-     after = latest_attempt_path(records_dir, stage)\n351- \n352:@@ -2589,7 +2876,8 @@ def _drive_step(root: Path, m: dict, item_id: str) -> tuple[int, bool]:\n353- \n354: def cmd_drive(argv: list[str]) -> int:\n355-     until_ready = \"--until-ready\" in argv\n356--    positional = [a for a in argv if a != \"--until-ready\"]\n357:+    recover = \"--recover\" in argv\n358:+    positional = [a for a in argv if a not in (\"--until-ready\", \"--recover\")]\n359-     root = Path(\".\").resolve()\n360-     item_id = positional[0] if positional else derive_item_id(root)\n361-     if not item_id:\n362:@@ -2601,6 +2889,9 @@ def cmd_drive(argv: list[str]) -> int:\n363:         print(f\"attavo drive: no {MANIFEST} at {root}\", file=sys.stderr)\n364-         return 2\n365- \n366:+    if recover:\n367:+        return _drive_recover(root, m, item_id)\n368-+\n369:     # Without --until-ready this is exactly one call to _drive_step,\n370:     # letter for letter what cmd_drive always did: `not until_ready`\n371-     # returns on the very first iteration regardless of `done`. With it,\n372-@@ -3174,6 +3465,14 @@ def item_ledger(root: Path, m: dict, item_id: str) -> dict:\n373-             operator_acts += 1\n374-             continue\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"printf '%s\n' '--- instruction contract ---' && sed -n '1,150p' /Users/davidbean/Projects/attest/adapters/README.md && printf '%s\n' '--- question guard ---' && rg -n -A45 -B15 '\"'^def question_class|REINSTRUCTION'\"' /Users/davidbean/Projects/attest/adapters/claude-code/run && printf '%s\n' '--- exact final log lines ---' && tail -n 18 attest/records/151/build-03.log\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"printf '%s\n' '--- instruction contract ---' && sed -n '1,150p' /Users/davidbean/Projects/attest/adapters/README.md && printf '%s\n' '--- question guard ---' && rg -n -A45 -B15 '\"'^def question_class|REINSTRUCTION'\"' /Users/davidbean/Projects/attest/adapters/claude-code/run && printf '%s\n' '--- exact final log lines ---' && tail -n 18 attest/records/151/build-03.log\"","aggregated_output":"--- instruction contract ---\n# Adapters\n\nAn adapter is an executable at `adapters/<name>/run`, resolved first under\nthe tenant's `attavo/adapters/`, then under this product's `adapters/`.\n`attavo build` invokes it with the tenant root as its working directory.\n\n## Environment\n\n- `ATTAVO_SPEC_DIR` — the work item's spec directory (`spec.md`, `criteria/`, `stub/`).\n- `ATTAVO_RECORDS_DIR` — the work item's own records directory.\n- `ATTAVO_RULINGS` — the tenant's rulings file (`paths.rulings`).\n- `ATTAVO_BRANCH` — the branch the adapter must commit on.\n- `ATTAVO_ITERATION` — the 1-based attempt number within this `attavo build` invocation.\n- `ATTAVO_FEEDBACK` — a file holding the previous iteration's failing criteria, test output, and checks output; empty on the first iteration.\n- `ATTAVO_ADAPTER_CONFIG` — the tenant manifest's `[executor.<adapter-name>]` table, serialized as JSON (`{}` when the tenant declared none). The product does not know what an adapter's settings mean; each adapter documents its own keys on its own `README.md`. **Never put a secret in this table** — it is copied verbatim into `build-NN.json` as `adapter_config`, and a record is not where secrets live.\n- `ATTAVO_CHECKS_COMMAND` — the tenant's `[checks].command`, unset when the tenant declared no `[checks]` table. The product does not know what it checks; the tenant does. An adapter should tell the executor it is part of done when set, and say nothing about checks when it is not.\n- `ATTAVO_STAGE` — `\"build\"`, `\"verify\"`, or `\"counsel\"` (issue #100), which invocation this is. An adapter that supports every stage branches on it; one that only builds may ignore it.\n- `ATTAVO_EVENTS` — build and verify only: a file path an adapter may append events to while it runs (issue #26). Absent on a stage that does not set it (counsel does not); an adapter that never checks for it breaks nothing.\n- `ATTAVO_DIFF` — verify only: a file holding the diff since the build's approval.\n- `ATTAVO_BUILD_RECORD` — verify only: the path to the `build-NN.json` being verified.\n- `ATTAVO_COUNSEL_RECORD` — counsel only: the path to the non-pass `build-NN.json`/`verify-NN.json` being counseled.\n- `ATTAVO_COUNSEL_LOG` — counsel only: the path to that record's own `.log`, empty when it has none.\n- `ATTAVO_COUNSEL_DIFF` — counsel only: a file holding the item's diff since approval (the same diff verify itself would compute).\n- `ATTAVO_MANIFEST` — counsel only: the path to the tenant's own `attavo.toml`.\n- `ATTAVO_PRODUCT_ROOT` — counsel only: the path to this product's own root (`bin/attavo`, `adapters/`, `schema/`, `templates/`), so a stop whose cause is the product's own mechanism can be read at it.\n- `GIT_AUTHOR_NAME`, `GIT_AUTHOR_EMAIL`, `GIT_COMMITTER_NAME`, `GIT_COMMITTER_EMAIL` — build only: the executor's identity (issue #33), set by the product and never the tenant's git config. An adapter must not override these for the commits it makes; a commit build finds not carrying this identity is refused.\n\n## Output\n\nThe adapter commits its work on the current branch itself. It prints one\nJSON object on its last stdout line:\n\n```json\n{\"status\": \"done\" | \"question\", \"question\": null | \"<text>\",\n \"model\": \"<id>\", \"model_version\": \"<id or null>\",\n \"adapter_version\": \"<tool version>\",\n \"tokens\": {\"input\": n, \"output\": n}, \"cost_usd\": n | null}\n```\n\nA `\"question\"` line may also carry `\"class\": \"non-question\"` (see below);\n`attavo build` reads only `status`/`question` off this line and does not\nknow about the extra field.\n\nAnything else on stdout is the adapter's transcript and is saved beside the\nbuild record as `build-NN.log`, never inside the record.\n\nAn adapter never writes a record. `attavo build` writes the one\n`build-NN.json` for the whole invocation. What it must do with a tool\nerror, an absent report, or a bad question is `tests/test_executor_conformance.py`,\nrun against every `adapters/<name>/conformance.json` it declares.\n\n## Events (issue #26)\n\n`ATTAVO_EVENTS`, when set, names a file the adapter may append events to\nwhile it runs, mapping its own executor's stream into one JSON object\nper line, flushed on every write:\n\n```json\n{\"at\": \"<iso8601, seconds>\", \"kind\": \"message\" | \"tool_call\" | \"tool_result\",\n \"text\": \"<one line, capped at 400 characters>\"}\n```\n\n`text` is the executor's own words for `message`, the tool's name and its\nfirst argument for `tool_call`, and the tool's result's first line for\n`tool_result`. The product appends its own `iteration` and `gate` events\nto the same file (each iteration's start, and each criterion's exit,\nfrom the loop that already runs them) and, for `attavo counsel`, never\nopens the file at all -- events belong to a running stage, not a\nread-only judgment of one already finished.\n\nThe file is never a record and is never committed: it is not among the\npaths `commit_record` names, and a tenant's `.gitignore` is not touched\nfor it, since an uncommitted file in an item's own worktree is already\ninvisible to the ledger and the doctor. An adapter that never writes to\nit breaks nothing -- the file is simply absent, and the screen renders\nthe feed it has without one.\n\n## Counsel (issue #100)\n\nWith `ATTAVO_STAGE=counsel`, the report line carries `class`, `verdict`,\n`citations`, and `proposal` instead of `status`/`question`:\n\n```json\n{\"class\": \"<stop class, or \\\"unclassed\\\">\",\n \"verdict\": \"answer\" | \"patch\" | \"person\",\n \"citations\": [{\"kind\": \"instruction\" | \"mechanism\" | \"guard\",\n                \"path\": \"<path>\" | null, \"symbol\": \"<symbol>\" | null,\n                \"ruling_id\": \"<id>\" | null}, ...],\n \"proposal\": {\"ruling_text\": \"<text>\" | null,\n              \"patch\": {\"file\": \"<path>\", \"symbol\": \"<symbol>\",\n                        \"rejection_test\": \"<test>\", \"diff\": \"<unified diff>\"} | null,\n              \"question\": \"<one line>\" | null},\n \"model\": \"<id>\", \"model_version\": \"<id or null>\",\n \"adapter_version\": \"<tool version>\",\n \"tokens\": {\"input\": n, \"output\": n}, \"cost_usd\": n | null}\n```\n\nCounsel is read-only -- the same sandbox verify runs under -- and it\nnever acts: `proposal` carries a ruling's text or a patch's diff, never\na write or a commit. `adapters/<name>/conformance.json` declares which\nstages an adapter supports as `\"stages\"`; an adapter naming no\n`\"counsel\"` there has not been pointed at this stage.\n\n## Two stops (issue #88)\n\nA `\"question\"` is not always a question. A status report landing in the\nquestion channel (\"I've traced the spec's 5 criteria and dispatched an\nimplementation agent…\") halts an item to a person exactly like a real\nquestion does, but the person has nothing to rule on. Every adapter\ntherefore treats a `\"question\"` whose text clears the length gate but\ncarries no `\"?\"` as a report, not a question: it re-invokes the executor\nonce more, in the same invocation, appending \"your last answer was a\nreport, not a question; either continue to done, or ask one question\nending in a question mark that names the spec line or guard you cannot\nresolve\" to the same instruction. A proper question or a `\"done\"` on the\nretry ends the invocation normally, at the cost of one extra executor\nturn; a second report in a row still halts (someone must look), but its\nreport line carries `\"class\": \"non-question\"` and both raw results\nalready reached the transcript above it. No record field changes: the\nclass lives in the transcript and the report line, not in\n`build-NN.json`.\n\nThe report line's own `tokens` and `cost_usd` sum both calls, whatever\nthe retry's outcome — the record's cost matches the two executor turns\nactually spent, not just the second one; only `model`/`model_version`/\n`adapter_version` come from the second call.\n\nWork can also outlive the invocation that started it: a tool that spawns\nits own background subagents can report `\"done\"` and exit while those\nsubagents are still running or still being torn down, so the checks\n`attavo build` runs right after `\"done\"` land on a tree something else\nis still writing. An adapter whose tool can do this must refuse the run\nby name -- exit 1, with the counts -- rather than report `\"done\"` on it;\n`adapters/<name>/conformance.json` names this ability as\n`\"subagent_guard\": {\"supported\": true, \"situation\": \"<name>\"}` or, when\nthe tool has no such concept to check at all, `{\"supported\": false,\n\"reason\": \"<why>\"}` -- an adapter naming neither is an undeclared blind\nspot, not a legitimate absence (`tests/test_executor_conformance.py`\nenforces this the same way it enforces `\"reports\"`).\n--- question guard ---\n40-`denyWrite` takes a list of paths, not a bare boolean -- `true` alone did\n41-not stop a write inside the directory). `--allowedTools` shrinks to the\n42-tool names each stage may use at all -- `Read,Edit,Write,Bash` for build,\n43-`Read,Bash` for verify -- since Edit and Write are not Bash and the\n44-sandbox does not govern them. `allowed_tools` is retired as a manifest\n45-key: a config that still declares it is refused by name rather than\n46-silently accepted.\n47-\n48-Issue #88 (class A: a report is not a question). `--json-schema`\n49-constrains the tool's structured_output to \"done\"/\"question\", but\n50-nothing stops \"question\" from carrying a status report rather than an\n51-actual question -- confirmed against tenant zero's own corpus, five\n52-specimens with no \"?\" anywhere in the text. A \"question\" whose text\n53-clears MIN_QUESTION_CHARS but contains no \"?\" is a report, not a\n54-question: this adapter re-invokes the executor once, appending\n55:REINSTRUCTION to the same instruction, before ever reporting a halt to\n56-a person. A second report in a row still halts (someone must look), but\n57-its report line carries \"class\": \"non-question\" and both raw results\n58-reached stdout above it -- an extra field bin/attavo's own record schema\n59-does not know about and never has to: it reads \"status\"/\"question\" off\n60-this line exactly as before, so a \"question\" halt still halts. Read via\n61-ATTAVO_ADAPTER_RESPONSE_FILE, a JSON array is a queue -- one canned\n62-result per invocation this adapter makes, its last element repeating\n63-once exhausted -- while a single object still repeats for every call,\n64-unchanged.\n65-\n66-Issue #88 (class B: work that outlives the invocation). Confirmed live,\n67-this machine, `claude 2.1.269`: with both \"Agent\" and \"Task\" allowed, a\n68-prompt asking for a subagent produced `subagent_stats.spawned: 1`, `\"Agent\"`\n69-alone in `--disallowedTools` (Task is not a distinct tool in this build)\n70-brought it back to 0 -- the tool's own reply named \"Workflow\" as the\n71-other path to background work, so both are named here. `--allowedTools`\n72-is an allow-list a background spawn does not consult (tenant zero's\n73-specimen: `--allowedTools` without \"Agent\" or \"Workflow\" in it at all did\n74-not stop three of them), so this adapter also disallows them by name on\n75-both stages and, after the run, refuses by name -- exit 1, not a\n76-halt -- any response whose subagent_stats.spawned is not zero, with the\n77-counts in the message. A tool that reports no subagent_stats at all\n78-(spawned absent or 0) is unaffected; this is a refusal on evidence, not a\n79-guess from the flag.\n80-\"\"\"\n81-from __future__ import annotations\n82-\n83-import json\n84-import os\n85-import subprocess\n86-import sys\n87-from datetime import datetime, timezone\n88-from pathlib import Path\n89-\n90-STATUS_SCHEMA = {\n91-    \"type\": \"object\",\n92-    \"additionalProperties\": False,\n93-    \"required\": [\"status\", \"question\"],\n94-    \"properties\": {\n95-        \"status\": {\"type\": \"string\", \"enum\": [\"done\", \"question\"]},\n96-        \"question\": {\"type\": [\"string\", \"null\"]},\n97-    },\n98-}\n99-\n100-# The verify objective (issue #46): a verifier reports findings, not a\n--\n537-    winner = max(model_usage, key=total_tokens)\n538-    return winner, model_usage[winner].get(\"canonicalModel\")\n539-\n540-\n541-def adapter_version() -> str:\n542-    try:\n543-        out = subprocess.run([\"claude\", \"--version\"], capture_output=True,\n544-                             text=True, check=False)\n545-    except OSError:\n546-        return \"\"\n547-    return out.stdout.strip()\n548-\n549-\n550-MIN_QUESTION_CHARS = 40\n551-\n552:REINSTRUCTION = (\n553-    \"your last answer was a report, not a question; either continue to \"\n554-    \"done, or ask one question ending in a question mark that names the \"\n555-    \"spec line or guard you cannot resolve\")\n556-\n557-\n558:def question_class(status: str, question: str | None) -> str:\n559-    \"\"\"\"done\" (no halt at all), \"fail\" (a question too short or absent to\n560-    be worth a person's judgment -- MIN_QUESTION_CHARS, unchanged since\n561-    v0.15.0), \"report\" (long enough but carries no \"?\" -- issue #88's\n562-    class A, a status update in the question channel), or \"question\" (a\n563-    real question).\"\"\"\n564-    if status != \"question\":\n565-        return \"done\"\n566-    if not question or len(question) < MIN_QUESTION_CHARS:\n567-        return \"fail\"\n568-    if \"?\" not in question:\n569-        return \"report\"\n570-    return \"question\
   ],\\n       \\\"properties\\\": {\\n         \\\"select\\\": {\\n           \\\"type\\\": \\\"string\\\",\\n@@ -65,7 +80,9 @@\\n       \\\"type\\\": \\\"object\\\",\\n       \\\"description\\\": \\\"The tenant's own definition of done: a whole-tree check, as the tenant runs it locally. attavo build runs it each iteration, after the claims boundary, the criteria, and the selected tests -- pass requires its exit to be 0, and a non-zero exit reaches the executor as feedback. Optional; a tenant that declares none is not refused (unlike [tests], which build requires).\\\",\\n       \\\"additionalProperties\\\": false,\\n-      \\\"required\\\": [\\\"command\\\"],\\n+      \\\"required\\\": [\\n+        \\\"command\\\"\\n+      ],\\n       \\\"properties\\\": {\\n         \\\"command\\\": {\\n           \\\"type\\\": \\\"string\\\",\\n@@ -94,7 +111,9 @@\\n     \\\"spec\\\": {\\n       \\\"type\\\": \\\"object\\\",\\n       \\\"additionalProperties\\\": false,\\n-      \\\"required\\\": [\\\"boundary\\\"],\\n+      \\\"required\\\": [\\n+        \\\"boundary\\\"\\n+      ],\\n       \\\"properties\\\": {\\n         \\\"boundary\\\": {\\n           \\\"type\\\": \\\"object\\\",\\n@@ -103,12 +122,18 @@\\n           \\\"properties\\\": {\\n             \\\"paths\\\": {\\n               \\\"type\\\": \\\"array\\\",\\n-              \\\"items\\\": {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1},\\n+              \\\"items\\\": {\\n+                \\\"type\\\": \\\"string\\\",\\n+                \\\"minLength\\\": 1\\n+              },\\n               \\\"description\\\": \\\"Glob patterns; a change touching any of them is governed.\\\"\\n             },\\n             \\\"labels\\\": {\\n               \\\"type\\\": \\\"array\\\",\\n-              \\\"items\\\": {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1},\\n+              \\\"items\\\": {\\n+                \\\"type\\\": \\\"string\\\",\\n+                \\\"minLength\\\": 1\\n+              },\\n          
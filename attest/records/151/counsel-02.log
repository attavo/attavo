_marker_path(records_dir: Path, stage: str, nn: int) -> Path:\n+    return records_dir / f\"{stage}-{nn:02d}{INVOCATION_MARKER_SUFFIX}\"\n+\n+\n+def write_invocation_marker(root: Path, records_dir: Path, stage: str, nn: int) -> Path:\n+    records_dir.mkdir(parents=True, exist_ok=True)\n+    path = invocation_marker_path(records_dir, stage, nn)\n+    info = {\"at\": now_iso(), \"host\": socket.gethostname(), \"pid\": os.getpid(),\n+           \"sha\": git(root, \"rev-parse\", \"HEAD\").strip(), \"product_version\": product_version()}\n+    path.write_text(json.dumps(info, indent=2) + \"\\n\")\n+    return path\n+\n+\n+def invocation_alive(info: dict) -> bool:\n+    \"\"\"Whether the marker's pid is a live process on this host. Another\n+    host's pid is unknowable from here and reads as not alive: an\n+    invocation that ran elsewhere and wrote no record is died by\n+    absence, not hung.\"\"\"\n+    if info.get(\"host\") != socket.gethostname():\n+        return False\n+    pid = info.get(\"pid\")\n+    if not isinstance(pid, int) or isinstance(pid, bool) or pid <= 0:\n+        return False\n+    try:\n+        os.kill(pid, 0)\n+    except ProcessLookupError:\n+        return False\n+    except PermissionError:\n+        return True\n+    return True\n+\n+\n+def invocations_without_record(item_records_dir: Path) -> list[tuple[Path, dict]]:\n+    \"\"\"Every <stage>-NN.started under one item whose <stage>-NN.json has\n+    not arrived, paired with the marker's own dict ({} when unreadable).\"\"\"\n+    out: list[tuple[Path, dict]] = []\n+    if not item_records_dir.is_dir():\n+        return out\n+    for marker in sorted(item_records_dir.glob(f\"*{INVOCATION_MARKER_SUFFIX}\")):\n+        if (item_records_dir / f\"{marker.stem}.json\").is_file():\n+            continue\n+        try:\n+            with marker.open() as fh:\n+                info = json.load(fh)\n+        except (OSError, ValueError):\n+            info = {}\n+        out.append((marker, info if isinstance(info, dict) else {}))\n+    return out\n+\n+\n+def stall_bound_s(m: dict) -> int | None:\n+    \"\"\"[drive].stall_after_s: the tenant's own bound past which a live\n+    invocation with no new event is hung. A bound the tenant did not\n+    declare is a forecast this product does not make, so there is no\n+    default -- proof five and drive --recover both refuse without one.\"\"\"\n+    bound = (m.get(\"drive\") or {}).get(\"stall_after_s\")\n+    if isinstance(bound, bool) or not isinstance(bound, (int, float)) or bound <= 0:\n+        return None\n+    return int(bound)\n+\n+\n+def proof_no_invocation_lacks_record(root: Path, m: dict | None) -> Proof:\n+    p = Proof(\"no-invocation-lacks-record\", \"no invocation lacks its record\")\n+    if m is None:\n+        return p.fail(f\"no {MANIFEST} at {root}; no records directory is declared\")\n+    records_rel = m.get(\"paths\", {}).get(\"records\", \"\")\n+    records_dir = root / records_rel\n+    if not records_dir.is_dir():\n+        return p.fail(f\"no records directory under {records_dir}\")\n+    if stall_bound_s(m) is None:\n+        return p.fail(\"no [drive].stall_after_s in the manifest; a hung invocation cannot be \"\n+                      \"told from a running one\")\n+    recorded = 0\n+    running: list[str] = []\n+    problems: list[str] = []\n+    for item_dir in sorted(d for d in records_dir.iterdir() if d.is_dir()):\n+        for marker in item_dir.glob(f\"*{INVOCATION_MARKER_SUFFIX}\"):\n+            if (item_dir / f\"{marker.stem}.json\").is_file():\n+                recorded += 1\n+        for marker, info in invocations_without_record(item_dir):\n+            name = f\"item {item_dir.name} {marker.stem}\"\n+            if invocation_alive(info):\n+                running.append(f\"{name} (pid {info.get('pid')} since {info.get('at')})\")\n+                continue\n+            problems.append(f\"{name} started {info.get('at')} on {info.get('host')} \"\n+                            f\"pid {info.get('pid')} and never wrote its record\")\n+    if problems:\n+        return p.fail(\"; \".join(problems), unrecorded_invocations=len(problems),\n+                      running_invocations=running)\n+    return p.hold(f\"{recorded} invocation(s) recorded, {len(running)} running\",\n+                  unrecorded_invocations=0, running_invocations=running)\n+\n+\n def proof_one_item_every_stage(root: Path, m: dict | None) -> Proof:\n     p = Proof(\"one-item-every-stage\", \"one item has traversed every stage\")\n     if m is None:\n@@ -1079,7 +1211,8 @@ def doctor(root: Path) -> list[Proof]:\n     return [proof_every_gate_rejects(root, m),\n             proof_one_item_every_stage(root, m),\n             proof_no_commit_lacks_record(root, m),\n-            proof_no_stop_lacks_cause(root, m)]\n+            proof_no_stop_lacks_cause(root, m),\n+            proof_no_invocation_lacks_record(root, m)]\n \n \n def cmd_doctor(argv: list[str]) -> int:\n@@ -2492,7 +2625,26 @@ def _drive_run_stage(root: Path, records_dir: Path, branch: str, stage: str, ite\n     transported together: committed with commit_record and pushed with\n     push_record_commit, whatever the stage record's status -- the record\n     pushes stay the same pushes, made by drive in the run that produced\n-    the record (issue #84's rule 42 row).\"\"\"\n+    the record (issue #84's rule 42 row).\n+\n+    Before the stage runs at all, its own invocation marker (issue #151)\n+    is written, committed, and pushed by itself -- one commit per\n+    attempt, so an invocation that dies with this process, or hangs\n+    past [drive].stall_after_s, is a fact on the branch (the doctor's\n+    fifth proof) rather than a silence, whatever happens next.\"\"\"\n+    nn = next_attempt_number(records_dir, stage)\n+    marker = write_invocation_marker(root, records_dir, stage, nn)\n+    try:\n+        commit_record(root, [marker], f\"attavo: {stage} invocation {nn:02d} started \"\n+                      f\"for item {item_id}\")\n+    except RuntimeError as exc:\n+        print(f\"attavo drive: stopped: could not commit the {stage} invocation marker: {exc}\")\n+        return 1\n+    ok, err = push_record_commit(root, branch)\n+    if not ok:\n+        print(f\"attavo drive: stopped: could not push the {stage} invocation marker: {err}\")\n+        return 1\n+\n     before = latest_attempt_path(records_dir, stage)\n     rc = cmd_build([item_id]) if stage == \"build\" else cmd_verify([item_id])\n     after = latest_attempt_path(records_dir, stage)\n@@ -2542,6 +2694,128 @@ def _drive_run_stage(root: Path, records_dir: Path, branch: str, stage: str, ite\n     return rc\n \n \n+def _events_tail(path: Path, lines: int = 20) -> tuple[str, float | None]:\n+    \"\"\"(the events file's last lines as a log, its own mtime as the last\n+    activity time) -- stage_events_dir's own file, read here rather than\n+    the adapter's stdout, since a died or hung invocation never returned\n+    one. mtime, not a parsed line's own \"at\", is the liveness signal:\n+    append_event flushes every write immediately, so the file's mtime is\n+    exactly the last event's own time without parsing a single line of\n+    it.\"\"\"\n+    if not path.is_file():\n+        return \"no events file for this invocation\\n\", None\n+    try:\n+        text = path.read_text()\n+        mtime = path.stat().st_mtime\n+    except OSError:\n+        return \"events file unreadable\\n\", None\n+    tail = text.splitlines()[-lines:]\n+    return \"\\n\".join(tail) + \"\\n\", mtime\n+\n+\n+def _seconds_since(at: str | None) -> float | None:\n+    if not at:\n+        return None\n+    try:\n+        then = datetime.strptime(at, \"%Y-%m-%dT%H:%M:%SZ\").replace(tzinfo=timezone.utc)\n+    except ValueError:\n+        return None\n+    return (datetime.now(timezone.utc) - then).total_seconds()\n+\n+\n+def _drive_recover(root: Path, m: dict, item_id: str) -> int:\n+    \"\"\"`attavo drive --recover [N]`: every invocation of item N that began\n+    and wrote no record ends in one here -- class died when its pid is\n+    gone or on another host, class hung when it is alive past\n+    [drive].stall_after_s with no newer event (and terminated); provenance\n+    product; the events tail as the log. A live invocation inside the\n+    bound is running and left alone. The record is committed and pushed\n+    the way every stage record is; the ordinary `attavo drive` then reads\n+    a non-pass record and does what it does with one.\"\"\"\n+    records_rel = m[\"paths\"][\"records\"]\n+    records_dir = root / records_rel / item_id\n+    bound = stall_bound_s(m)\n+    if bound is None:\n+        print(\"attavo drive: refused: no [drive].stall_after_s in the manifest; a hung \"\n+              \"invocation cannot be told from a running one\")\n+        return 1\n+    pending = invocations_without_record(records_dir)\n+    if not pending:\n+        print(f\"attavo drive: item {item_id}: every invocation has its record; nothing to recover\")\n+        return 0\n+    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n+    try:\n+        git(root, \"remote\", \"get-url\", \"origin\")\n+        has_origin = True\n+    except RuntimeError:\n+        has_origin = False\n+    recovered = 0\n+    for marker, info in pending:\n+        stage, nn_text = marker.stem.rsplit(\"-\", 1)\n+        nn = int(nn_text)\n+        events_path = stage_events_dir(root) / f\"{stage}-{nn:02d}.events.jsonl\"\n+        log, mtime = _events_tail(events_path)\n+        age = (time.time() - mtime) if mtime is not None else _seconds_since(info.get(\"at\"))\n+        last_event = f\"{int(time.time() - mtime)} s ago\" if mtime is not None else \"none\"\n+        pid, host = info.get(\"pid\"), info.get(\"host\")\n+        if invocation_alive(info):\n+            if age is None or age <= bound:\n+                print(f\"attavo drive: {marker.stem} is running (pid {pid}, last event \"\n+                      f\"{'unknown' if age is None else int(age)} s ago, bound {bound} s); \"\n+                      f\"nothing to recover\")\n+                continue\n+            cls = \"hung\"\n+            try:\n+                os.kill(int(pid), signal.SIGTERM)\n+                ended = \"terminated\"\n+            except OSError as exc:\n+                ended = f\"not terminated ({exc})\"\n+            detail = (f\"pid {pid} on {host} alive with no event for {int(age)} s \"\n+                      f\"(bound {bound} s); {ended}\")\n+        else:\n+            cls = \"died\"\n+            detail = (f\"pid {pid} on {host} is not running and wrote no {marker.stem}.json; \"\n+                      f\"started {info.get('at')}, last event {last_event}\")\n+        if next_attempt_number(records_dir, stage) != nn:\n+            print(f\"attavo drive: stopped: {marker.name} names attempt {nn} but the next \"\n+                  f\"{stage} record would be {next_attempt_number(records_dir, stage):02d}; \"\n+                  f\"a later record already exists, read the records before recovering\")\n+            return 1\n+        schema = stage_schema(stage)\n+        record = {k: None for k in schema.get(\"required\", [])}\n+        approval = latest_record(records_dir, \"approval\") or {}\n+        record.update({\"sha\": info.get(\"sha\"), \"start_sha\": info.get(\"sha\"),\n+                       \"approval_sha\": approval.get(\"sha\"), \"at\": info.get(\"at\"),\n+                       \"adapter\": (m.get(\"executor\") or {}).get(stage),\n+                       \"status\": \"failed\", \"refusal\": None, \"halted\": None,\n+                       \"stop\": {\"class\": cls, \"provenance\": \"product\", \"detail\": detail}})\n+        if \"wall_clock_s\" in record:\n+            record[\"wall_clock_s\"] = None if age is None else int(age)\n+        record = {k: v for k, v in record.items() if k in schema.get(\"properties\", {})}\n+        try:\n+            path = write_record(records_dir, stage, record, m, item_id, log=log)\n+        except ValueError as exc:\n+            print(f\"attavo drive: stopped: could not write the {cls} record for {marker.stem}: {exc}\")\n+            return 1\n+        try:\n+            commit_record(root, [path], f\"attavo: {stage} record for item {item_id} \"\n+                                        f\"({path.stem}), recovered as {cls}\")\n+        except RuntimeError as exc:\n+            print(f\"attavo drive: stopped: could not commit the {cls} record: {exc}\")\n+            return 1\n+        if has_origin:\n+            ok, err = push_record_commit(root, branch)\n+            if not ok:\n+                print(f\"attavo drive: stopped: could not push the {cls} record: {err}\")\n+                return 1\n+        else:\n+            print(f\"attavo drive: note: no origin remote; {path.name} is committed, not pushed\")\n+        print(f\"attavo drive: recovered {marker.stem} as {cls}: {detail}\")\n+        recovered += 1\n+    print(f\"attavo drive: item {item_id}: {recovered} invocation(s) recovered\")\n+    return 0\n+\n+\n def _drive_step(root: Path, m: dict, item_id: str) -> tuple[int, bool]:\n     \"\"\"One mechanical step, exactly as a single `attavo drive` call always\n     has -- and whether repetition under --until-ready should stop here:\n@@ -2589,7 +2863,8 @@ def _drive_step(root: Path, m: dict, item_id: str) -> tuple[int, bool]:\n \n def cmd_drive(argv: list[str]) -> int:\n     until_ready = \"--until-ready\" in argv\n-    positional = [a for a in argv if a != \"--until-ready\"]\n+    recover = \"--recover\" in argv\n+    positional = [a for a in argv if a not in (\"--until-ready\", \"--recover\")]\n     root = Path(\".\").resolve()\n     item_id = positional[0] if positional else derive_item_id(root)\n     if not item_id:\n@@ -2601,6 +2876,9 @@ def cmd_drive(argv: list[str]) -> int:\n         print(f\"attavo drive: no {MANIFEST} at {root}\", file=sys.stderr)\n         return 2\n \n+    if recover:\n+        return _drive_recover(root, m, item_id)\n+\n     # Without --until-ready this is exactly one call to _drive_step,\n     # letter for letter what cmd_drive always did: `not until_ready`\n     # returns on the very first iteration regardless of `done`. With it,\n@@ -3174,6 +3452,15 @@ def item_ledger(root: Path, m: dict, item_id: str) -> dict:\n             operator_acts += 1\n             continue\n \n+        # An invocation marker's own commit (issue #151, proof five): the\n+        # product's act, never the operator's -- RECORD_RE never matches\n+        # a .started file, so record_touch above found nothing for it.\n+        if any(p.startswith(records_prefix) and p.endswith(INVOCATION_MARKER_SUFFIX)\n+              for p in touched):\n+            rows.append({\"sha\": sha, \"identity\": name, \"class\": \"record\"})\n+            product_acts += 1\n+            continue\n+\n         if any(p.startswith(specs_prefix) for p in touched):\n             cls = \"amend\" if approval_seen else \"spec\"\n             rows.append({\"sha\": sha, \"identity\": name, \"class\": cls})\ndiff --git a/schema/manifest.schema.json b/schema/manifest.schema.json\nindex 6dc7c15..1f7fe52 100644\n--- a/schema/manifest.schema.json\n+++ b/schema/manifest.schema.json\n@@ -177,6 +177,17 @@\n           \"minLength\": 1\n         }\n       }\n+    },\n+    \"drive\": {\n+      \"type\": \"object\",\n+      \"additionalProperties\": false,\n+      \"properties\": {\n+        \"stall_after_s\": {\n+          \"type\": \"integer\",\n+          \"minimum\": 1,\n+          \"description\": \"seconds without a new event past which a live invocation is hung; attavo drive --recover terminates and records it\"\n+        }\n+      }\n     }\n   }\n }\ndiff --git a/schema/records/build.schema.json b/schema/records/build.schema.json\nindex 7c933b1..996e724 100644\n--- a/schema/records/build.schema.json\n+++ b/schema/records/build.schema.json\n@@ -110,7 +110,7 @@\n           \"type\": \"string\",\n           \"enum\": [\"non-question\", \"outlived-invocation\", \"no-cause\", \"forge-unconcluded\",\n                    \"ceiling\", \"claims-boundary\", \"repeated-act\", \"unclassed\", \"question\",\n-                   \"environment\", \"gate\"]\n+                   \"environment\", \"gate\", \"died\", \"hung\"]\n         },\n         \"provenance\": {\"type\": \"string\", \"enum\": [\"product\", \"tenant\", \"executor\", \"spec\"]},\n         \"detail\": {\ndiff --git a/schema/records/verify.schema.json b/schema/records/verify.schema.json\nindex adb05c9..389f8f6 100644\n--- a/schema/records/verify.schema.json\n+++ b/schema/records/verify.schema.json\n@@ -111,7 +111,8 @@\n         \"class\": {\n           \"type\": \"string\",\n           \"enum\": [\"non-question\", \"outlived-invocation\", \"no-cause\", \"forge-unconcluded\",\n-                   \"ceiling\", \"claims-boundary\", \"repeated-act\", \"unclassed\", \"question\"]\n+                   \"ceiling\", \"claims-boundary\", \"repeated-act\", \"unclassed\", \"question\",\n+                   \"died\", \"hung\"]\n         },\n         \"provenance\": {\"type\": \"string\", \"enum\": [\"product\", \"tenant\", \"executor\", \"spec\"]},\n         \"detail\": {\ndiff --git a/tests/test_drive.py b/tests/test_drive.py\nindex 5be8f7c..cc51085 100644\n--- a/tests/test_drive.py\n+++ b/tests/test_drive.py\n@@ -735,8 +735,13 @@ def test_drive_retries_a_rejected_push_with_a_merge_never_a_rebase(tmp_path):\n     # rebase, which would have rewritten it under a new sha.\n     assert build_sha in git(root, \"rev-list\", \"HEAD\").split()\n \n-    merge_parents = git(root, \"log\", \"-1\", \"--format=%P\", \"HEAD\").split()\n-    assert len(merge_parents) == 2, \"the retry should have landed a merge commit\"\n+    # issue #151: drive's first push of this run is the build invocation's\n+    # own marker, written and pushed before build ever runs -- the\n+    # rejected push and its retry merge land there, not necessarily on\n+    # the build record's own commit at HEAD, so the merge is looked for\n+    # anywhere in the history rather than assumed to be the tip.\n+    assert git(root, \"rev-list\", \"--merges\", \"HEAD\").split(), \\\n+        \"the retry should have landed a merge commit\"\n \n     assert remote_head(bare, branch) == head_of(root)\n     # the concurrent commit from the other clone is present too\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,230p' /Users/davidbean/Projects/attest/tests/test_adapter_claude_code.py && printf '%s\n' '--- adapter local README stream contract ---' && sed -n '1,180p' /Users/davidbean/Projects/attest/adapters/claude-code/README.md && printf '%s\n' '--- diff file integrity and touched paths ---' && wc -c -l /var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp7az7hilq/diff.patch && rg '\"'^diff --git '\"' /var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp7az7hilq/diff.patch\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,230p' /Users/davidbean/Projects/attest/tests/test_adapter_claude_code.py && printf '%s\n' '--- adapter local README stream contract ---' && sed -n '1,180p' /Users/davidbean/Projects/attest/adapters/claude-code/README.md && printf '%s\n' '--- diff file integrity and touched paths ---' && wc -c -l /var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp7az7hilq/diff.patch && rg '\"'^diff --git '\"' /var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp7az7hilq/diff.patch\"","aggregated_output":"\"\"\"adapters/claude-code/run's stream-json mapping (issue #26): a real\ninvocation now speaks `--output-format stream-json --verbose`, read line\nby line as it runs rather than buffered until the process exits.\nATTAVO_ADAPTER_STREAM_FILE feeds a recorded transcript (one JSONL line\nper entry, the shape a real invocation's stdout would carry) through the\nsame mapping and terminal \"result\" read a live invocation gets, without\nrunning `claude` -- distinct from ATTAVO_ADAPTER_RESPONSE_FILE\n(tests/test_adapters.py), which still feeds the final report object\ndirectly and is untouched by this lane.\n\nRejection tests, written and run red first: on `main` before this issue\n`--output-format` was \"json\", a single buffered object, and\nATTAVO_ADAPTER_STREAM_FILE did not exist.\n\nRun: python3 -m pytest tests -q\n\"\"\"\nimport json\nimport os\nimport subprocess\nfrom pathlib import Path\n\nfrom helpers import FIXTURES\n\nROOT = Path(__file__).resolve().parent.parent\nCLAUDE_CODE_RUN = ROOT / \"adapters\" / \"claude-code\" / \"run\"\n\nRESULT_LINE = {\n    \"type\": \"result\",\n    \"is_error\": False,\n    \"structured_output\": {\"status\": \"done\", \"question\": None},\n    \"usage\": {\"input_tokens\": 5, \"output_tokens\": 9},\n    \"total_cost_usd\": 0.01,\n    \"modelUsage\": {\"claude-sonnet-5\": {\"inputTokens\": 5, \"outputTokens\": 9}},\n}\n\nSTREAM_LINES = [\n    {\"type\": \"system\", \"subtype\": \"init\"},\n    {\"type\": \"assistant\", \"message\": {\"content\": [\n        {\"type\": \"text\", \"text\": \"Reading the spec before I start.\"}]}},\n    {\"type\": \"assistant\", \"message\": {\"content\": [\n        {\"type\": \"tool_use\", \"name\": \"Read\", \"input\": {\"file_path\": \"spec.md\"}}]}},\n    {\"type\": \"user\", \"message\": {\"content\": [\n        {\"type\": \"tool_result\", \"content\": \"## Problem\\nsecond line\\n\"}]}},\n    RESULT_LINE,\n]\n\n\ndef base_env(tmp_path: Path) -> dict:\n    spec_dir = FIXTURES / \"build_valid\" / \"specs\" / \"1\"\n    env = dict(os.environ)\n    env.pop(\"ATTAVO_CHECKS_COMMAND\", None)\n    env.update({\n        \"ATTAVO_SPEC_DIR\": str(spec_dir),\n        \"ATTAVO_RECORDS_DIR\": str(tmp_path / \"records\"),\n        \"ATTAVO_RULINGS\": str(tmp_path / \"rulings.md\"),\n        \"ATTAVO_BRANCH\": \"attavo/1-example\",\n        \"ATTAVO_ITERATION\": \"1\",\n        \"ATTAVO_FEEDBACK\": str(tmp_path / \"feedback.txt\"),\n    })\n    return env\n\n\ndef run_with_stream(tmp_path: Path, lines: list[dict], events: bool = True,\n                    extra_env: dict | None = None) -> subprocess.CompletedProcess:\n    stream_file = tmp_path / \"stream.jsonl\"\n    stream_file.write_text(\"\\n\".join(json.dumps(l) for l in lines) + \"\\n\")\n    env = base_env(tmp_path)\n    env[\"ATTAVO_ADAPTER_STREAM_FILE\"] = str(stream_file)\n    if events:\n        env[\"ATTAVO_EVENTS\"] = str(tmp_path / \"events.jsonl\")\n    if extra_env:\n        env.update(extra_env)\n    return subprocess.run([str(CLAUDE_CODE_RUN)], capture_output=True, text=True,\n                          check=False, env=env)\n\n\ndef read_events(tmp_path: Path) -> list[dict]:\n    path = tmp_path / \"events.jsonl\"\n    if not path.is_file():\n        return []\n    return [json.loads(l) for l in path.read_text().splitlines() if l.strip()]\n\n\ndef test_claude_code_maps_a_recorded_stream_to_events_and_the_same_report_fields(tmp_path):\n    \"\"\"Acceptance row 3. A recorded stream-json transcript maps to one\n    event per assistant text block, tool_use block, and tool_result\n    block, in order, each {at, kind, text}; the terminal \"result\" object\n    feeds the same model/tokens/cost derivation the old --output-format\n    json response did -- the record is byte-for-byte what it was.\n    \"\"\"\n    run = run_with_stream(tmp_path, STREAM_LINES)\n    assert run.returncode == 0, run.stdout + run.stderr\n\n    line = json.loads(run.stdout.splitlines()[-1])\n    assert line[\"model\"] == \"claude-sonnet-5\"\n    assert line[\"tokens\"] == {\"input\": 5, \"output\": 9}\n    assert line[\"cost_usd\"] == 0.01\n    assert line[\"status\"] == \"done\"\n\n    events = read_events(tmp_path)\n    assert [e[\"kind\"] for e in events] == [\"message\", \"tool_call\", \"tool_result\"]\n    assert all(set(e) == {\"at\", \"kind\", \"text\"} for e in events)\n    assert events[0][\"text\"] == \"Reading the spec before I start.\"\n    assert events[1][\"text\"] == \"Read spec.md\"\n    assert events[2][\"text\"] == \"## Problem\"\n\n\ndef test_claude_code_stream_transcript_still_reaches_stdout(tmp_path):\n    \"\"\"Every raw line the stream carried, mapped or not, still reaches\n    stdout (and so build-NN.log) -- issue #34's guarantee, unbroken by\n    the switch to reading the stream line by line.\"\"\"\n    run = run_with_stream(tmp_path, STREAM_LINES)\n    assert run.returncode == 0, run.stdout + run.stderr\n    for raw_line in STREAM_LINES:\n        assert json.dumps(raw_line) in run.stdout\n\n\ndef test_claude_code_tool_call_event_is_one_line_and_capped_at_400_chars(tmp_path):\n    \"\"\"Acceptance row 4. A tool's argument can be a whole file: the\n    mapped event text is collapsed to one line and capped at 400\n    characters, the feed renders lines.\"\"\"\n    long_arg = \"line one\\nline two\\n\" + (\"x\" * 500)\n    stream = [\n        {\"type\": \"assistant\", \"message\": {\"content\": [\n            {\"type\": \"tool_use\", \"name\": \"Bash\", \"input\": {\"command\": long_arg}}]}},\n        RESULT_LINE,\n    ]\n    run = run_with_stream(tmp_path, stream)\n    assert run.returncode == 0, run.stdout + run.stderr\n\n    events = read_events(tmp_path)\n    assert len(events) == 1\n    text = events[0][\"text\"]\n    assert \"\\n\" not in text\n    assert len(text) <= 400\n\n\ndef test_claude_code_no_events_file_when_atavo_events_is_unset(tmp_path):\n    \"\"\"An adapter invocation with no ATTAVO_EVENTS writes no events file\n    -- the mapping only ever writes to a path the product handed it.\"\"\"\n    run = run_with_stream(tmp_path, STREAM_LINES, events=False)\n    assert run.returncode == 0, run.stdout + run.stderr\n    assert not (tmp_path / \"events.jsonl\").exists()\n\n\ndef test_claude_code_stream_missing_result_line_fails(tmp_path):\n    \"\"\"A 0-exit stream that never carries a terminal \"result\" line is a\n    failure, the same class build already treats a tool error or an\n    absent structured_output as -- not a crash, and not a silent pass.\"\"\"\n    stream = [{\"type\": \"assistant\", \"message\": {\"content\": [\n        {\"type\": \"text\", \"text\": \"still working\"}]}}]\n    run = run_with_stream(tmp_path, stream)\n    assert run.returncode == 1\n--- adapter local README stream contract ---\n# adapters/claude-code\n\nRuns `claude -p` against the spec. Configured through `[executor.claude-code]`\nin the tenant's manifest (see `../README.md` for how that table reaches the\nadapter as `ATTAVO_ADAPTER_CONFIG`, and lands verbatim in `build-NN.json` as\n`adapter_config`). **Never put a secret in this table** — it lands in a\nrecord.\n\n## Keys\n\n- `auth` — `\"api\"` (default) or `\"subscription\"`.\n  - `\"api\"`: runs with `--bare`. Requires `ANTHROPIC_API_KEY`; usage bills per token.\n  - `\"subscription\"`: omits `--bare`; adds `--setting-sources user` and `--strict-mcp-config` so the tenant's project hooks and MCP servers do not load (`CLAUDE.md` still does). Runs on the operator's subscription login; usage is included in the plan. `ANTHROPIC_API_KEY` is not required.\n- `model` — omitted means the executor's default. When set, passed as `--model`, and trusted verbatim as the record's `model` rather than picked out of the tool's own usage report (issue #77).\n- `setting_sources` — default `\"user\"`. Only meaningful in subscription mode; ignored in api mode (`--bare` already excludes everything).\n- `permission_mode` — default `\"acceptEdits\"`.\n- `allowed_tools` is retired (issue #78): a manifest that still declares `[executor.claude-code].allowed_tools` is refused by name rather than silently accepted or ignored. See below.\n\n## The tenant's checks\n\n`attavo build` already runs `[checks].command` after each commit and feeds\na failure back on the next iteration — the executor is not the runner of\nthe tenant's checks. When `ATTAVO_CHECKS_COMMAND` is set (`../README.md`),\nthe instruction says so: \"after you commit, the tenant's checks (`<command>`)\nare run for you and any failure is returned to you on the next iteration;\nrun only what you need while editing.\" When it is unset, the instruction\nsays nothing about checks.\n\n## The sandbox is the boundary, not an allowed_tools list\n\nEvery invocation carries `--settings` with a `sandbox` object\n(`sandbox.enabled: true`, `allowUnsandboxedCommands: false`,\n`network.allowedDomains: []`) — confirmed live against `claude 2.1.268`:\nthe sandbox refuses a write outside the working directory and any\noutbound connection, at the OS level, before `--allowedTools` is ever\nconsulted. Verify's `--settings` additionally sets\n`filesystem.denyWrite` on the working directory itself, so \"make no\nedits, write no files\" is mechanical rather than merely instructed.\n`--allowedTools` is therefore fixed per stage to the tool names the\nsandbox does not itself govern — `Read,Edit,Write,Bash` for build,\n`Read,Bash` for verify — not a curated `Bash(git *)`-style prefix list a\ntenant used to grow one denial at a time; `[executor.claude-code]` no\nlonger has a key for it. The network stays closed for both stages; an\nexecutor that needs a package index is a tenant fact for a later\nmanifest key, not this one.\n\nThe raw result's `permission_denials` (in `build-NN.log` since `v0.3.4`)\nstill exists, but a Bash tool call the sandbox will refuse at the OS\nlevel is never denied at the permission layer in the first place — a\nrefusal there shows up as the underlying shell command's own non-zero\nexit in the transcript, not as a `permission_denials` entry.\n\n## cost_usd is a meter, not always a bill\n\n`build-NN.json`'s `cost_usd` is this adapter's report of the tool's\nlist-price meter. It is billed only when `adapter_config.auth` (this\ntable's `auth` key) is `\"api\"`. Under `auth = \"subscription\"`, the same\nfigure is a measure of usage against the operator's plan, not a charge —\nthat build ran on the subscription login, not an API key.\n\n## The raw result\n\nThe whole `--output-format json` result is printed to stdout before this\nadapter's own final line, so `attavo build` saves it verbatim as the\ntranscript in `build-NN.log` — the tool's own account of what happened,\nincluding fields (`num_turns`, `duration_ms`, `is_error`,\n`permission_denials`) the final line never carries. `is_error: true`, no\n`structured_output` at all, or a `status: \"question\"` whose `question` is\nmissing or under 40 characters all make the adapter exit 1 (build records\nthe attempt `failed`) instead of a halt someone has to rule on — a\nquestion worth a person's judgment is at least a sentence.\n\n## A report is not a question (issue #88)\n\nA `status: \"question\"` whose text clears the 40-character gate but\ncarries no `\"?\"` is a report, not a question — five of tenant zero's\ntwelve non-pass build records were exactly this (\"I've traced the\nspec's 5 criteria against the tree and dispatched an implementation\nagent…\"), each costing a person a read and a re-launch for nothing to\nrule on. This adapter re-invokes `claude` once more on a report,\nappending a line asking it to either continue to done or ask a real\nquestion, before ever reporting a halt. A second report in a row still\nhalts, but its report line carries `\"class\": \"non-question\"` and both\nraw results already reached the transcript above it — see `../README.md`.\n`tokens` and `cost_usd` on that line sum both calls; `model`,\n`model_version`, and `adapter_version` come from the second call only.\n\n## Work that can outlive the invocation (issue #88)\n\nConfirmed live against `claude 2.1.269`: a prompt encouraging a\nsubagent produced `subagent_stats.spawned: 1` when the Agent tool was\nallowed, and `0` with `\"Agent\"` alone in `--disallowedTools` — the\ntool's own reply named `Workflow` as the other path to background work,\nso both are disallowed by name on every invocation, both stages.\nTenant zero's own specimen (`#659` build-01) spawned three with neither\ntool in `--allowedTools` at all, so the flag is checked after the fact\ntoo: any response whose `subagent_stats.spawned` is not zero is refused\nby name, with the counts, rather than accepted as `done` — a build the\ntool's own background work could still be writing to.\n--- diff file integrity and touched paths ---\n    8733 5304210 /var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp7az7hilq/diff.patch\ndiff --git a/attest/records/151/approval-01.json b/attest/records/151/approval-01.json\ndiff --git a/attest/records/151/build-01.filed b/attest/records/151/build-01.filed\ndiff --git a/attest/records/151/build-01.json b/attest/records/151/build-01.json\ndiff --git a/attest/records/151/build-01.log b/attest/records/151/build-01.log\ndiff --git a/attest/records/151/counsel-01.json b/attest/records/151/counsel-01.json\ndiff --git a/attest/records/151/counsel-01.log b/attest/records/151/counsel-01.log\ndiff --git a/attest/records/151/spec-01.json b/attest/records/151/spec-01.json\ndiff --git a/attest/specs/151/criteria/died-and-hung-are-stop-classes.sh b/attest/specs/151/criteria/died-and-hung-are-stop-classes.sh\ndiff --git a/attest/specs/151/criteria/doctor-fails-on-an-invocation-without-record.sh b/attest/specs/151/criteria/doctor-fails-on-an-invocation-without-record.sh\ndiff --git a/attest/specs/151/criteria/recover-writes-a-died-record.sh b/attest/specs/151/criteria/recover-writes-a-died-record.sh\ndiff --git a/attest/specs/151/spec.md b/attest/specs/151/spec.md\ndiff --git a/attest/specs/151/stub/attavo.toml b/attest/specs/151/stub/attavo.toml\ndiff --git a/attest/specs/151/stub/bin/attavo b/attest/specs/151/stub/bin/attavo\ndiff --git a/attest/specs/151/stub/bin/attavo.orig b/attest/specs/151/stub/bin/attavo.orig\ndiff --git a/attest/specs/151/stub/schema/manifest.schema.json b/attest/specs/151/stub/schema/manifest.schema.json\ndiff --git a/attest/specs/151/stub/schema/records/build.schema.json b/attest/specs/151/stub/schema/records/build.schema.json\ndiff --git a/attest/specs/151/stub/schema/records/verify.schema.json b/attest/specs/151/stub/schema/records/verify.schema.json\n","exit_code":0,"status":"completed"}}

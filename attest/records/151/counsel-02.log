 assert len(text) <= 400\\n \\n \\n+def test_claude_code_ignores_a_stream_event_with_a_string_message(tmp_path):\\n+    \\\"\\\"\\\"A non-content stream event may carry a diagnostic string in\\n+    message; it remains transcript evidence but is not a feed event and\\n+    must not prevent the terminal result from being read.\\\"\\\"\\\"\\n+    diagnostic = {\\\"type\\\": \\\"rate_limit_event\\\", \\\"message\\\": \\\"rate limit status\\\"}\\n+    run = run_with_stream(tmp_path, [diagnostic, RESULT_LINE])\\n+\\n+    assert run.returncode == 0, run.stdout + run.stderr\\n+    assert json.dumps(diagnostic) in run.stdout\\n+    assert json.loads(run.stdout.splitlines()[-1])[\\\"status\\\"] == \\\"done\\\"\\n+    assert read_events(tmp_path) == []\\n+\\n+\\n def test_claude_code_no_events_file_when_atavo_events_is_unset(tmp_path):\\n     \\\"\\\"\\\"An adapter invocation with no ATTAVO_EVENTS writes no events file\\n     -- the mapping only ever writes to a path the product handed it.\\\"\\\"\\\"\\n\"},\"question\":null}}"}}

\n     },\n     \"paths\": {\n       \"type\": \"object\",\n       \"additionalProperties\": false,\n       \"required\": [\"specs\", \"records\", \"rulings\", \"rejections\"],\n       \"properties\": {\n         \"specs\": {\"type\": \"string\", \"minLength\": 1, \"description\": \"Directory of specs, one per work item, named by issue number.\"},\n         \"rejections\": {\"type\": \"string\", \"minLength\": 1, \"description\": \"Directory of rejection fixtures, one subdirectory per gate name. The doctor's first proof runs each gate against its fixture and requires a rejection.\"},\n         \"records\": {\"type\": \"string\", \"minLength\": 1, \"description\": \"Directory of records, append-only, one subdirectory per work item named by issue number. Scripts write every file here.\"},\n         \"rulings\": {\"type\": \"string\", \"minLength\": 1, \"description\": \"The tenant's rulings file, rendered read-only; the merge of a proposed amendment is the ruling.\"}\n       }\n     },\n     \"operators\": {\n       \"type\": \"object\",\n       \"additionalProperties\": false,\n       \"required\": [\"approvers\"],\n       \"properties\": {\n         \"approvers\": {\n           \"type\": \"array\",\n           \"items\": {\"type\": \"string\", \"minLength\": 1},\n           \"description\": \"Logins allowed to bind a spec's approval to a commit. `attavo approve` refuses a LOGIN not on this list.\"\n         }\n       }\n     },\n     \"doctor\": {\n       \"type\": \"object\",\n       \"description\": \"Optional; the doctor's own read. Absent, proof three's window starts at the install commit, as it always has.\",\n       \"additionalProperties\": false,\n       \"properties\": {\n         \"from\": {\n           \"type\": \"string\",\n           \"description\": \"Anything git rev-parse --verify resolves to a commit on main's first-parent line, at or after the install commit -- a full or abbreviated sha, a tag, a ref -- where proof three's window starts. A tenant that adopted the product on a repository with pre-existing history names the commit after which every push arrived through the queue. Resolved and checked against main's first-parent line, not trusted: a spelling that does not resolve, or a commit that is not on that line, is refused by name.\",\n           \"minLength\": 1\n         }\n       }\n+    },\n+    \"drive\": {\n+      \"type\": \"object\",\n+      \"additionalProperties\": false,\n+      \"properties\": {\n+        \"stall_after_s\": {\n+          \"type\": \"integer\",\n+          \"minimum\": 1,\n+          \"description\": \"seconds without a new event past which a live invocation is hung; attavo drive --recover terminates and records it\"\n+        }\n+      }\n     }\n   }\n }\ndiff --git a/schema/records/build.schema.json b/schema/records/build.schema.json\nindex 7c933b1..996e724 100644\n--- a/schema/records/build.schema.json\n+++ b/schema/records/build.schema.json\n@@ -73,53 +73,53 @@\n       \"required\": [\"command\", \"exit\"],\n       \"properties\": {\n         \"command\": {\"type\": \"string\", \"minLength\": 1},\n         \"exit\": {\"type\": \"integer\"}\n       }\n     },\n     \"tokens\": {\n       \"type\": \"object\",\n       \"additionalProperties\": false,\n       \"required\": [\"input\", \"output\"],\n       \"properties\": {\n         \"input\": {\"type\": \"integer\", \"minimum\": 0},\n         \"output\": {\"type\": \"integer\", \"minimum\": 0}\n       }\n     },\n     \"cost_usd\": {\n       \"type\": [\"number\", \"null\"],\n       \"description\": \"The tool's list-price meter, from the adapter's own report. Billed only when the build ran under adapter_config.auth = \\\"api\\\"; under auth = \\\"subscription\\\" this figure is a measure, not a bill -- usage is included in the operator's plan.\"\n     },\n     \"wall_clock_s\": {\"type\": \"number\", \"minimum\": 0},\n     \"status\": {\"type\": \"string\", \"enum\": [\"pass\", \"refused\", \"halted\", \"failed\"]},\n     \"refusal\": {\"type\": [\"string\", \"null\"]},\n     \"halted\": {\n       \"type\": [\"object\", \"null\"],\n       \"additionalProperties\": false,\n       \"required\": [\"question\"],\n       \"properties\": {\n         \"question\": {\"type\": [\"string\", \"null\"]}\n       }\n     },\n     \"stop\": {\n       \"type\": [\"object\", \"null\"],\n       \"description\": \"Non-null exactly when status is not \\\"pass\\\" (issue #89): what class of stop this is and whose it is, derived by the record writer from the refusal, halted, and log it already has -- never a fresh read of anything.\",\n       \"additionalProperties\": false,\n       \"required\": [\"class\", \"provenance\", \"detail\"],\n       \"properties\": {\n         \"class\": {\n           \"type\": \"string\",\n           \"enum\": [\"non-question\", \"outlived-invocation\", \"no-cause\", \"forge-unconcluded\",\n                    \"ceiling\", \"claims-boundary\", \"repeated-act\", \"unclassed\", \"question\",\n-                   \"environment\", \"gate\"]\n+                   \"environment\", \"gate\", \"died\", \"hung\"]\n         },\n         \"provenance\": {\"type\": \"string\", \"enum\": [\"product\", \"tenant\", \"executor\", \"spec\"]},\n         \"detail\": {\n           \"type\": [\"string\", \"null\"],\n           \"description\": \"Populated for class \\\"unclassed\\\" (the log's last line, capped at 200 characters), class \\\"question\\\" (the halt's own question, its first line only), class \\\"environment\\\" ([checks].command's last output line, capped at 200 characters), and class \\\"gate\\\" (a refused spec-gate record's own refusal string, issue #137 -- never persisted on an actual build record; read here only because stop_class_enum sources the enum from this schema); null for every other class, whose evidence already lives in refusal, halted, or the log itself.\"\n         }\n       }\n     },\n     \"product_version\": {\"type\": \"string\", \"minLength\": 1},\n     \"product_pin\": {\"type\": [\"string\", \"null\"]}\n   }\n }\ndiff --git a/schema/records/verify.schema.json b/schema/records/verify.schema.json\nindex adb05c9..389f8f6 100644\n--- a/schema/records/verify.schema.json\n+++ b/schema/records/verify.schema.json\n@@ -74,53 +74,54 @@\n       \"items\": {\"type\": \"string\", \"minLength\": 1}\n     },\n     \"commits\": {\n       \"type\": \"array\",\n       \"description\": \"Empty unless the adapter moved the branch head during verify -- a report, not a commit; a non-empty list here always accompanies status: \\\"failed\\\", naming exactly what the adapter should not have created.\",\n       \"items\": {\"type\": \"string\", \"minLength\": 1}\n     },\n     \"mutation\": {\n       \"type\": [\"object\", \"null\"],\n       \"additionalProperties\": false,\n       \"required\": [\"command\", \"score\", \"modules\"],\n       \"properties\": {\n         \"command\": {\"type\": \"string\", \"minLength\": 1},\n         \"score\": {\"type\": \"number\", \"minimum\": 0, \"maximum\": 1},\n         \"modules\": {\"type\": \"array\", \"items\": {\"type\": \"string\", \"minLength\": 1}}\n       }\n     },\n     \"weak_stub\": {\"type\": \"boolean\"},\n     \"stub_ratio\": {\"type\": [\"number\", \"null\"]},\n     \"tokens\": {\n       \"type\": \"object\",\n       \"additionalProperties\": false,\n       \"required\": [\"input\", \"output\"],\n       \"properties\": {\n         \"input\": {\"type\": \"integer\", \"minimum\": 0},\n         \"output\": {\"type\": \"integer\", \"minimum\": 0}\n       }\n     },\n     \"cost_usd\": {\"type\": [\"number\", \"null\"]},\n     \"wall_clock_s\": {\"type\": \"number\", \"minimum\": 0},\n     \"status\": {\"type\": \"string\", \"enum\": [\"pass\", \"returned\", \"failed\"]},\n     \"stop\": {\n       \"type\": [\"object\", \"null\"],\n       \"description\": \"Non-null exactly when status is not \\\"pass\\\" (issue #89): what class of stop this is and whose it is, derived by the record writer from the forge_checks and log it already has -- never a fresh read of anything.\",\n       \"additionalProperties\": false,\n       \"required\": [\"class\", \"provenance\", \"detail\"],\n       \"properties\": {\n         \"class\": {\n           \"type\": \"string\",\n           \"enum\": [\"non-question\", \"outlived-invocation\", \"no-cause\", \"forge-unconcluded\",\n-                   \"ceiling\", \"claims-boundary\", \"repeated-act\", \"unclassed\", \"question\"]\n+                   \"ceiling\", \"claims-boundary\", \"repeated-act\", \"unclassed\", \"question\",\n+                   \"died\", \"hung\"]\n         },\n         \"provenance\": {\"type\": \"string\", \"enum\": [\"product\", \"tenant\", \"executor\", \"spec\"]},\n         \"detail\": {\n           \"type\": [\"string\", \"null\"],\n           \"description\": \"Populated for class \\\"unclassed\\\" (the log's last line, capped at 200 characters) and class \\\"question\\\" (the halt's own question, its first line only); null for every other class, whose evidence already lives in forge_checks or the log itself.\"\n         }\n       }\n     },\n     \"product_version\": {\"type\": \"string\", \"minLength\": 1},\n     \"product_pin\": {\"type\": [\"string\", \"null\"]}\n   }\n }\ndiff --git a/tests/test_doctor.py b/tests/test_doctor.py\nindex d147948..37c82de 100644\n--- a/tests/test_doctor.py\n+++ b/tests/test_doctor.py\n@@ -1,100 +1,110 @@\n \"\"\"The doctor's four proofs, as tests written before the capability.\n \n Each test asserts that one proof holds against this repository. All four\n fail at the first commit and must fail: that is the definition of done,\n stated before anything exists to satisfy it. A test here turns green only\n when the capability it names has landed and been used for real.\n \n Run: python3 -m pytest tests -q\n \"\"\"\n import json\n+import os\n import shutil\n+import socket\n import subprocess\n import sys\n from pathlib import Path\n \n from helpers import FIXTURES, commit_all, init_repo, make_tenant\n \n ROOT = Path(__file__).resolve().parent.parent\n ATTAVO = ROOT / \"bin\" / \"attavo\"\n \n \n def run_doctor(root: Path) -> dict:\n     out = subprocess.run([sys.executable, str(ATTAVO), \"doctor\", str(root), \"--json\"],\n                          capture_output=True, text=True, check=False)\n     report = json.loads(out.stdout)\n     assert out.returncode == (0 if report[\"done\"] else 1)\n     return {p[\"proof\"]: p for p in report[\"proofs\"]}\n \n \n def test_every_gate_rejects():\n     \"\"\"Proof 1. Every gate in the manifest rejects its rejection fixture.\n \n     Holds when: a manifest exists, [gates] names at least one gate, each gate\n     has a fixture under paths.rejections, and each gate exits non-zero on it.\n     \"\"\"\n     p = run_doctor(ROOT)[\"every-gate-rejects\"]\n     assert p[\"holds\"], p[\"reason\"]\n \n \n def test_one_item_traversed_every_stage():\n     \"\"\"Proof 2. One work item carries a record for spec, approval, build,\n     verify, and attestation, every one written by a script.\"\"\"\n     p = run_doctor(ROOT)[\"one-item-every-stage\"]\n     assert p[\"holds\"], p[\"reason\"]\n \n \n def test_no_commit_lacks_a_record():\n     \"\"\"Proof 3. Every commit on the default branch after the manifest was\n     introduced is named by a record's sha or commits list.\"\"\"\n     p = run_doctor(ROOT)[\"no-commit-lacks-record\"]\n     assert p[\"holds\"], p[\"reason\"]\n \n \n def test_no_stop_lacks_cause():\n     \"\"\"Proof 4, issue #94. Every non-pass build or verify record at\n     record_version 3 or later carries a stop naming its class and cause.\"\"\"\n     p = run_doctor(ROOT)[\"no-stop-lacks-cause\"]\n     assert p[\"holds\"], p[\"reason\"]\n \n \n+def test_no_invocation_lacks_record():\n+    \"\"\"Proof 5, issue #151. Every <stage>-NN.started marker under\n+    paths.records has arrived at its own <stage>-NN.json, or is still a\n+    live process on this host.\"\"\"\n+    p = run_doctor(ROOT)[\"no-invocation-lacks-record\"]\n+    assert p[\"holds\"], p[\"reason\"]\n+\n+\n def test_record_loader_uses_highest_attempt_number(tmp_path):\n     \"\"\"Acceptance 2a. <stage>-NN.json files are one stage's attempts; the\n     doctor treats the highest NN as latest, and STAGES is unchanged.\n \n     spec-01.json names a commit that isn't on the branch at all; spec-02.json\n     names the real code commit. Proof 3 holds only if the loader reads\n     spec-02, not spec-01 -- i.e. only if it picks the highest attempt.\n     \"\"\"\n     root = tmp_path / \"attempts\"\n     root.mkdir()\n     (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n')\n     init_repo(root, \"install\")\n \n     (root / \"src.txt\").write_text(\"code\\n\")\n     commit_all(root, \"code change\")\n     code_sha = subprocess.run([\"git\", \"-C\", str(root), \"rev-parse\", \"HEAD\"],\n                               capture_output=True, text=True, check=True).stdout.strip()\n \n     records = root / \"records\" / \"1\"\n     records.mkdir(parents=True)\n     (records / \"spec-01.json\").write_text(json.dumps({\"sha\": \"0\" * 40}))\n     (records / \"spec-02.json\").write_text(json.dumps({\"sha\": code_sha}))\n     commit_all(root, \"spec records\")\n \n     p = run_doctor(root)[\"no-commit-lacks-record\"]\n     assert p[\"holds\"], p[\"reason\"]\n \n \n def test_doctor_proof_two_counts_three_of_four_stages_still_red(tmp_path):\n     \"\"\"Acceptance 8. A work item carrying spec, approval, and build records\n     is three of the four STAGES proof two names; verify doesn't exist\n     yet, so the proof stays red and names exactly that one as lacking.\n     \"\"\"\n     root = tmp_path / \"three_stages\"\n     root.mkdir()\n     (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n')\n     init_repo(root, \"install\")\n \n     records = root / \"records\" / \"1\"\n     records.mkdir(parents=True)\n@@ -706,40 +716,135 @@ def test_doctor_proof_four_fails_when_a_log_ends_in_an_adapter_exit_after_only_e\n     split_adapter_stdout bug, now guarded against at read time too).\"\"\"\n     root = tmp_path / \"owed_tool_error\"\n     root.mkdir()\n     (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n')\n     init_repo(root, \"install\")\n \n     records = root / \"records\" / \"1\"\n     records.mkdir(parents=True)\n     verify = {\n         \"status\": \"failed\", \"record_version\": 3,\n         \"stop\": {\"class\": \"unclassed\", \"provenance\": \"product\", \"detail\": \"[adapter exited 1]\"},\n     }\n     (records / \"verify-01.json\").write_text(json.dumps(verify))\n     (records / \"verify-01.log\").write_text(\n         '{\"type\":\"thread.started\",\"thread_id\":\"x\"}\\n[adapter exited 1]')\n     commit_all(root, \"a failed verify whose tool error line was dropped\")\n \n     p = run_doctor(root)[\"no-stop-lacks-cause\"]\n     assert not p[\"holds\"]\n     assert \"tool's own error line is owed\" in p[\"reason\"]\n \n \n def test_doctor_proof_four_fails_on_an_unclassed_stop_with_no_detail(tmp_path):\n     \"\"\"An unclassed stop's whole contract is its detail (issue #89):\n     with none, the record is exactly as unexplained as no stop at all.\"\"\"\n     root = tmp_path / \"unclassed_no_detail\"\n     root.mkdir()\n     (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n')\n     init_repo(root, \"install\")\n \n     records = root / \"records\" / \"1\"\n     records.mkdir(parents=True)\n     build = {\"status\": \"failed\", \"record_version\": 3,\n             \"stop\": {\"class\": \"unclassed\", \"provenance\": \"product\", \"detail\": None}}\n     (records / \"build-01.json\").write_text(json.dumps(build))\n     commit_all(root, \"an unclassed stop with no detail\")\n \n     p = run_doctor(root)[\"no-stop-lacks-cause\"]\n     assert not p[\"holds\"]\n     assert \"unclassed with no detail\" in p[\"reason\"]\n+\n+\n+def _dead_pid() -> int:\n+    \"\"\"A pid guaranteed not to be running: a real child, spawned and\n+    reaped, on this host.\"\"\"\n+    proc = subprocess.Popen([sys.executable, \"-c\", \"pass\"])\n+    proc.wait()\n+    return proc.pid\n+\n+\n+def test_doctor_proof_five_fails_on_a_dead_invocation_with_no_record(tmp_path):\n+    \"\"\"Issue #151: a build-01.started marker naming a dead pid on this\n+    host, with no build-01.json to retire it, is exactly the silence two\n+    build attempts of item #148 left behind -- proof five names it.\"\"\"\n+    root = tmp_path / \"dead_invocation\"\n+    root.mkdir()\n+    (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n\\n'\n+                                      '[drive]\\nstall_after_s = 60\\n')\n+    init_repo(root, \"install\")\n+\n+    records = root / \"records\" / \"1\"\n+    records.mkdir(parents=True)\n+    (records / \"build-01.started\").write_text(json.dumps({\n+        \"at\": \"2026-09-17T13:16:08Z\", \"host\": socket.gethostname(), \"pid\": _dead_pid(),\n+        \"sha\": \"0\" * 40, \"product_version\": \"fixture\"}))\n+    commit_all(root, \"invocation marker for item 1\")\n+\n+    p = run_doctor(root)[\"no-invocation-lacks-record\"]\n+    assert not p[\"holds\"]\n+    assert \"build-01\" in p[\"reason\"] and \"never wrote its record\" in p[\"reason\"]\n+\n+\n+def test_doctor_proof_five_holds_once_the_record_arrives(tmp_path):\n+    \"\"\"The same marker, retired by its own build-01.json: proof five\n+    holds -- the record's arrival is what retires a marker, not its\n+    removal.\"\"\"\n+    root = tmp_path / \"recorded_invocation\"\n+    root.mkdir()\n+    (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n\\n'\n+                                      '[drive]\\nstall_after_s = 60\\n')\n+    init_repo(root, \"install\")\n+\n+    records = root / \"records\" / \"1\"\n+    records.mkdir(parents=True)\n+    (records / \"build-01.started\").write_text(json.dumps({\n+        \"at\": \"2026-09-17T13:16:08Z\", \"host\": socket.gethostname(), \"pid\": _dead_pid(),\n+        \"sha\": \"0\" * 40, \"product_version\": \"fixture\"}))\n+    (records / \"build-01.json\").write_text(json.dumps({\"status\": \"pass\"}))\n+    commit_all(root, \"invocation marker and its record for item 1\")\n+\n+    p = run_doctor(root)[\"no-invocation-lacks-record\"]\n+    assert p[\"holds\"], p[\"reason\"]\n+\n+\n+def test_doctor_proof_five_reports_a_live_invocation_as_running_not_failed(tmp_path):\n+    \"\"\"A marker naming this test's own pid, on this host, with no\n+    record: alive, so proof five holds and names it running rather than\n+    failing the tenant for a drive that has not had the chance to finish\n+    yet.\"\"\"\n+    root = tmp_path / \"live_invocation\"\n+    root.mkdir()\n+    (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n\\n'\n+                                      '[drive]\\nstall_after_s = 60\\n')\n+    init_repo(root, \"install\")\n+\n+    records = root / \"records\" / \"1\"\n+    records.mkdir(parents=True)\n+    (records / \"build-01.started\").write_text(json.dumps({\n+        \"at\": \"2026-09-17T13:16:08Z\", \"host\": socket.gethostname(), \"pid\": os.getpid(),\n+        \"sha\": \"0\" * 40, \"product_version\": \"fixture\"}))\n+    commit_all(root, \"invocation marker for a still-running invocation\")\n+\n+    p = run_doctor(root)[\"no-invocation-lacks-record\"]\n+    assert p[\"holds\"], p[\"reason\"]\n+    assert len(p[\"running_invocations\"]) == 1\n+    assert \"build-01\" in p[\"running_invocations\"][0]\n+\n+\n+def test_doctor_proof_five_fails_without_stall_after_s_in_the_manifest(tmp_path):\n+    \"\"\"A tenant with no [drive].stall_after_s carries no bound past which\n+    a live invocation is hung -- proof five cannot tell a hung drive from\n+    a running one, and refuses to guess a default.\"\"\"\n+    root = tmp_path / \"no_stall_bound\"\n+    root.mkdir()\n+    (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n')\n+    init_repo(root, \"install\")\n+\n+    records = root / \"records\" / \"1\"\n+    records.mkdir(parents=True)\n+    (records / \"build-01.json\").write_text(json.dumps({\"status\": \"pass\"}))\n+    commit_all(root, \"a record with no [drive].stall_after_s declared\")\n+\n+    p = run_doctor(root)[\"no-invocation-lacks-record\"]\n+    assert not p[\"holds\"]\n+    assert \"stall_after_s\" in p[\"reason\"]\ndiff --git a/tests/test_drive.py b/tests/test_drive.py\nindex 5be8f7c..dd0a1c1 100644\n--- a/tests/test_drive.py\n+++ b/tests/test_drive.py\n@@ -1,56 +1,57 @@\n \"\"\"attavo drive: the mechanical transitions between approval and\n ready-to-merge (issue #84) -- one step per invocation, and only that step,\n until a state that belongs to a person. Every test uses the fixture\n adapter and a fake `[forge].checks_command`; every record commit is\n `git commit --only` and pushed to a real (bare) fixture remote.\n \n Regression tests, written and run red first: on `main` at 85f6f3b there\n was no `drive` subcommand, so every one of these failed with \"unknown\n subcommand\".\n \n Run: python3 -m pytest tests -q\n \"\"\"\n import importlib.machinery\n import importlib.util\n import json\n import os\n+import socket\n import subprocess\n import sys\n import time\n from pathlib import Path\n \n from helpers import commit_all, git, make_tenant\n \n ROOT = Path(__file__).resolve().parent.parent\n ATTAVO = ROOT / \"bin\" / \"attavo\"\n \n GREEN_FORGE = \"printf 'ci success\\\\n'\"\n # A concluded conclusion -- checked and failing, not something still\n # running. Distinct from UNCONCLUDED_FORGE below (issue #84): drive polls\n # the one still running for the bound, but stops on the first read of a\n # check that has already concluded, whether or not it passed.\n RED_FORGE = \"printf 'ci failure\\\\n'\"\n UNCONCLUDED_FORGE = \"printf 'ci in_progress\\\\n'\"\n \n # The real defaults (ATTAVO_DRIVE_POLL_BOUND_S=600, _INTERVAL_S=20) are a\n # real forge's clock, not a test's -- tenant zero's own checks conclude\n # about five minutes after a push. Every `attavo drive` call here runs\n # against this much shorter clock instead, read at call time from the\n # same environment variables; test_drive_forge_poll_defaults_are_a_real_\n # forges_clock is the one test that leaves them unset, to assert the\n # defaults themselves. The interval is kept well above typical subprocess\n # startup overhead so a zero-sleep stop and a polled one are easy to tell\n # apart by wall clock alone.\n FAST_POLL_ENV = {\"ATTAVO_DRIVE_POLL_BOUND_S\": \"0.9\", \"ATTAVO_DRIVE_POLL_INTERVAL_S\": \"0.5\"}\n \n \n def run_attavo(root: Path, *args: str, env: dict | None = None) -> subprocess.CompletedProcess:\n     full_env = dict(os.environ)\n     full_env.update(FAST_POLL_ENV)\n     if env:\n         full_env.update(env)\n     return subprocess.run([sys.executable, str(ATTAVO), *args], cwd=str(root),\n                           capture_output=True, text=True, check=False, env=full_env)\n \n \n def attavo_module():\n@@ -78,80 +79,109 @@ def approve_item(root: Path, item: str = \"1\") -> None:\n def add_bare_remote(root: Path, tmp_path: Path) -> Path:\n     \"\"\"A real (bare) remote named origin, seeded with the tenant's current\n     state -- drive's own push target, distinct from the fake\n     refs/remotes/origin/* helpers.init_repo sets up purely for verify's\n     diff base.\"\"\"\n     bare = tmp_path / \"origin.git\"\n     subprocess.run([\"git\", \"init\", \"--quiet\", \"--bare\", \"-b\", \"main\", str(bare)], check=True)\n     git(root, \"remote\", \"add\", \"origin\", str(bare))\n     branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n     git(root, \"push\", \"origin\", f\"HEAD:{branch}\")\n     return bare\n \n \n def records_dir(root: Path, item: str = \"1\") -> Path:\n     return root / \"records\" / item\n \n \n def record_files(root: Path, stage: str, item: str = \"1\") -> list[Path]:\n     return sorted(records_dir(root, item).glob(f\"{stage}-*.json\"))\n \n \n def latest_record(root: Path, stage: str, item: str = \"1\") -> dict:\n     files = record_files(root, stage, item)\n     assert files, f\"no {stage} record for item {item}\"\n     return json.loads(files[-1].read_text())\n \n \n def head_of(root: Path) -> str:\n     return git(root, \"rev-parse\", \"HEAD\").strip()\n \n \n def last_commit_paths(root: Path) -> list[str]:\n     return git(root, \"diff\", \"--name-only\", \"HEAD^\", \"HEAD\").splitlines()\n \n \n def remote_head(bare: Path, branch: str = \"main\") -> str:\n     return subprocess.run([\"git\", \"-C\", str(bare), \"rev-parse\", branch],\n                           capture_output=True, text=True, check=True).stdout.strip()\n \n \n+def add_drive_stall_bound(root: Path, seconds: int = 60) -> None:\n+    toml = root / \"attavo.toml\"\n+    toml.write_text(toml.read_text() + f'\\n[drive]\\nstall_after_s = {seconds}\\n')\n+    commit_all(root, \"declare the stall bound\")\n+\n+\n+def _dead_pid() -> int:\n+    \"\"\"A pid guaranteed not to be running: a real child, spawned and\n+    reaped, on this host.\"\"\"\n+    proc = subprocess.Popen([sys.executable, \"-c\", \"pass\"])\n+    proc.wait()\n+    return proc.pid\n+\n+\n+def write_dead_marker(root: Path, stage: str, nn: int, item: str = \"1\") -> Path:\n+    \"\"\"A <stage>-NN.started marker as a dead invocation would have left\n+    it, committed the way `attavo drive` itself commits one -- but never\n+    followed by its own record.\"\"\"\n+    d = records_dir(root, item)\n+    d.mkdir(parents=True, exist_ok=True)\n+    marker = d / f\"{stage}-{nn:02d}.started\"\n+    marker.write_text(json.dumps({\n+        \"at\": \"2026-09-17T13:16:08Z\", \"host\": socket.gethostname(), \"pid\": _dead_pid(),\n+        \"sha\": head_of(root), \"product_version\": \"fixture\"}))\n+    git(root, \"add\", str(marker.relative_to(root)))\n+    git(root, \"commit\", \"-q\", \"-m\", f\"invocation marker for item {item}\")\n+    return marker\n+\n+\n def test_drive_refuses_without_a_valid_approval(tmp_path):\n     \"\"\"Acceptance row 6. No approval at all: refused by name, nothing run\n     -- no spec-gate, no build, no records of any kind written.\"\"\"\n     root = make_tenant(tmp_path, \"build_valid\")\n     add_forge(root, GREEN_FORGE)\n     add_bare_remote(root, tmp_path)\n \n     run = run_attavo(root, \"drive\", \"1\")\n     assert run.returncode != 0\n     assert \"approval\" in run.stdout\n     assert \"absent\" in run.stdout\n \n     assert not records_dir(root).exists() or list(records_dir(root).glob(\"*.json\")) == []\n \n \n def test_drive_refuses_with_an_expired_approval(tmp_path):\n     \"\"\"Acceptance row 6, the other half: an approval bound to a spec sha\n     that has since moved is expired, not absent -- still refused by name,\n     nothing run.\"\"\"\n     root = make_tenant(tmp_path, \"build_valid\")\n     add_forge(root, GREEN_FORGE)\n     add_bare_remote(root, tmp_path)\n     approve_item(root)\n \n     (root / \"specs\" / \"1\" / \"spec.md\").write_text(\n         (root / \"specs\" / \"1\" / \"spec.md\").read_text() + \"\\n\")\n     commit_all(root, \"touch the spec after approval\")\n \n     run = run_attavo(root, \"drive\", \"1\")\n     assert run.returncode != 0\n     assert \"expired\" in run.stdout\n     assert record_files(root, \"build\") == []\n \n \n def test_drive_builds_from_an_approved_spec_with_no_build(tmp_path):\n     \"\"\"Acceptance row 1. One drive run produces a passing build record,\n     commits only the record and its log (`git commit --only`), and pushes\n     the branch; the fixture remote carries the record commit.\"\"\"\n     root = make_tenant(tmp_path, \"build_valid\")\n     add_forge(root, GREEN_FORGE)\n@@ -698,62 +728,159 @@ def test_drive_a_second_run_in_the_same_state_files_nothing(tmp_path):\n     assert filed.read_text() == filed_after_first  # nothing new was filed\n \n \n def test_drive_retries_a_rejected_push_with_a_merge_never_a_rebase(tmp_path):\n     \"\"\"Acceptance row 7. A rejected push with a divergent remote is\n     retried after `git pull --no-rebase --no-edit`, never a rebase; the\n     build record's own sha is unchanged (still reachable, still what the\n     record names), and the retry lands a merge commit, not a rewritten\n     one.\"\"\"\n     root = make_tenant(tmp_path, \"build_valid\")\n     add_forge(root, GREEN_FORGE)\n     bare = add_bare_remote(root, tmp_path)\n     approve_item(root)\n     branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n \n     # Diverge the bare remote: another clone pushes an unrelated commit to\n     # the same branch before drive's own push happens.\n     other = tmp_path / \"other-clone\"\n     subprocess.run([\"git\", \"clone\", \"--quiet\", str(bare), str(other)], check=True)\n     subprocess.run([\"git\", \"-C\", str(other), \"checkout\", \"-q\", branch], check=True)\n     subprocess.run([\"git\", \"-C\", str(other), \"config\", \"user.email\", \"other@example.com\"],\n                    check=True)\n     subprocess.run([\"git\", \"-C\", str(other), \"config\", \"user.name\", \"Other\"], check=True)\n     (other / \"concurrent.txt\").write_text(\"from elsewhere\\n\")\n     subprocess.run([\"git\", \"-C\", str(other), \"add\", \"-A\"], check=True)\n     subprocess.run([\"git\", \"-C\", str(other), \"commit\", \"-q\", \"-m\", \"a concurrent commit\"],\n                    check=True)\n     subprocess.run([\"git\", \"-C\", str(other), \"push\", \"origin\", f\"HEAD:{branch}\"], check=True)\n \n     run = run_attavo(root, \"drive\", \"1\")\n     assert run.returncode == 0, run.stdout + run.stderr\n \n     rec = latest_record(root, \"build\")\n     assert rec[\"status\"] == \"pass\"\n     build_sha = rec[\"sha\"]\n \n     # The build's own commit sha is still reachable -- a merge, not a\n     # rebase, which would have rewritten it under a new sha.\n     assert build_sha in git(root, \"rev-list\", \"HEAD\").split()\n \n-    merge_parents = git(root, \"log\", \"-1\", \"--format=%P\", \"HEAD\").split()\n-    assert len(merge_parents) == 2, \"the retry should have landed a merge commit\"\n+    # Issue #151: the invocation marker's own push lands first and is\n+    # what meets the divergent remote, so the merge commit the retry\n+    # lands may sit under the build record's commit rather than at HEAD\n+    # itself -- somewhere in the reachable history is what \"never a\n+    # rebase\" requires, not specifically the tip.\n+    merges = git(root, \"log\", \"--merges\", \"--format=%H\", \"HEAD\").split()\n+    assert merges, \"the retry should have landed a merge commit\"\n \n     assert remote_head(bare, branch) == head_of(root)\n     # the concurrent commit from the other clone is present too\n     assert \"concurrent.txt\" in git(root, \"ls-tree\", \"-r\", \"--name-only\", \"HEAD\")\n \n \n+def test_drive_commits_and_pushes_an_invocation_marker_before_the_stage_runs(tmp_path):\n+    \"\"\"Issue #151: the invocation's own marker is a fact on the branch\n+    before the stage runs -- its own commit, authored by the driver\n+    identity, landing and pushed ahead of the stage record's commit.\"\"\"\n+    root = make_tenant(tmp_path, \"build_valid\")\n+    add_forge(root, GREEN_FORGE)\n+    bare = add_bare_remote(root, tmp_path)\n+    approve_item(root)\n+    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n+\n+    run = run_attavo(root, \"drive\", \"1\")\n+    assert run.returncode == 0, run.stdout + run.stderr\n+\n+    marker = records_dir(root) / \"build-01.started\"\n+    assert marker.is_file()\n+    info = json.loads(marker.read_text())\n+    assert info[\"host\"] == socket.gethostname()\n+    assert isinstance(info[\"pid\"], int)\n+\n+    marker_commit = git(root, \"log\", \"--format=%H\", \"--\", str(marker.relative_to(root))).split()[-1]\n+    build_commit = head_of(root)\n+    assert marker_commit != build_commit\n+    # the marker's own commit is an ancestor of the build record's commit\n+    assert git(root, \"merge-base\", \"--is-ancestor\", marker_commit, build_commit) == \"\"\n+\n+    assert git(root, \"log\", \"-1\", \"--format=%an\", marker_commit).strip() == \"attavo driver\"\n+    assert remote_head(bare, branch) == head_of(root)\n+\n+\n+def test_drive_recover_writes_a_died_record_for_a_dead_invocation(tmp_path):\n+    \"\"\"Issue #151: `attavo drive --recover` retires a build-01.started\n+    marker naming a dead pid with a failed record, class died,\n+    provenance product -- committed by the driver identity, pushed to\n+    the fixture remote.\"\"\"\n+    root = make_tenant(tmp_path, \"build_valid\")\n+    add_drive_stall_bound(root)\n+    bare = add_bare_remote(root, tmp_path)\n+    approve_item(root)\n+    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n+\n+    marker = write_dead_marker(root, \"build\", 1)\n+    git(root, \"push\", \"origin\", f\"HEAD:{branch}\")\n+\n+    run = run_attavo(root, \"drive\", \"--recover\", \"1\")\n+    assert run.returncode == 0, run.stdout + run.stderr\n+\n+    rec = latest_record(root, \"build\")\n+    assert rec[\"status\"] == \"failed\"\n+    assert rec[\"stop\"][\"class\"] == \"died\"\n+    assert rec[\"stop\"][\"provenance\"] == \"product\"\n+    assert \"wrote no build-01.json\" in rec[\"stop\"][\"detail\"]\n+\n+    record_path = record_files(root, \"build\")[-1]\n+    assert record_path.with_suffix(\".log\").exists()\n+    assert git(root, \"log\", \"-1\", \"--format=%an\").strip() == \"attavo driver\"\n+    assert git(root, \"status\", \"--porcelain\", \"--\", str(record_path),\n+              str(record_path.with_suffix(\".log\")), str(marker)).strip() == \"\"\n+    assert remote_head(bare, branch) == head_of(root)\n+    assert marker.is_file()  # the marker itself is left in place, retired by the record\n+\n+\n+def test_drive_recover_refuses_without_a_stall_bound(tmp_path):\n+    \"\"\"No [drive].stall_after_s: a hung invocation cannot be told from a\n+    running one, so --recover refuses rather than guessing a bound.\"\"\"\n+    root = make_tenant(tmp_path, \"build_valid\")\n+    add_bare_remote(root, tmp_path)\n+    approve_item(root)\n+\n+    write_dead_marker(root, \"build\", 1)\n+\n+    run = run_attavo(root, \"drive\", \"--recover\", \"1\")\n+    assert run.returncode == 1\n+    assert \"stall_after_s\" in run.stdout\n+    assert record_files(root, \"build\") == []\n+\n+\n+def test_drive_recover_does_nothing_when_every_invocation_has_its_record(tmp_path):\n+    \"\"\"A tenant with no dangling marker: --recover is a no-op, not a\n+    refusal -- there is simply nothing to recover.\"\"\"\n+    root = make_tenant(tmp_path, \"build_valid\")\n+    add_drive_stall_bound(root)\n+    add_forge(root, GREEN_FORGE)\n+    add_bare_remote(root, tmp_path)\n+    approve_item(root)\n+    assert run_attavo(root, \"drive\", \"1\").returncode == 0\n+\n+    run = run_attavo(root, \"drive\", \"--recover\", \"1\")\n+    assert run.returncode == 0, run.stdout + run.stderr\n+    assert \"nothing to recover\" in run.stdout\n+    assert len(record_files(root, \"build\")) == 1\n+\n+\n def test_drive_forge_poll_defaults_are_a_real_forges_clock():\n     \"\"\"The bound and interval every other test overrides with\n     FAST_POLL_ENV default, unset, to at least five minutes and ten\n     seconds -- tenant zero's own checks conclude about five minutes after\n     a push, and a bound shorter than that would make every drive run\n     after a record push stop on 'forge checks not green', with a person\n     running it again after CI: exactly the transport act this lane\n     retires. Row 4 (a forge that never goes green) is unchanged in\n     meaning by this -- it still stops, just after waiting out a real\n     forge's own clock instead of a test's fake one.\n     \"\"\"\n     module = attavo_module()\n     assert module.DRIVE_FORGE_POLL_BOUND_DEFAULT_S >= 300\n     assert module.DRIVE_FORGE_POLL_INTERVAL_DEFAULT_S >= 10\ndiff --git a/tests/test_ledger.py b/tests/test_ledger.py\nindex 566a6c9..99a5266 100644\n--- a/tests/test_ledger.py\n+++ b/tests/test_ledger.py\n@@ -132,60 +132,115 @@ def test_ledger_stops_count_matches_stops_including_a_gate_refusal(tmp_path):\n     write_record(root, \"1\", \"spec\", 1,\n                 {\"status\": \"refused\",\n                  \"refusal\": \"criterion fails against the tree plus stub: \"\n                             \"doctor-template-absent.sh\"})\n     write_record(root, \"1\", \"build\", 1, {\"status\": \"failed\"})\n \n     ledger_run = run_attavo(root, \"ledger\", \"1\", \"--json\")\n     assert ledger_run.returncode == 0, ledger_run.stdout + ledger_run.stderr\n     stops_run = run_attavo(root, \"stops\", \"1\", \"--json\")\n     assert stops_run.returncode == 0, stops_run.stdout + stops_run.stderr\n \n     ledger_data = json.loads(ledger_run.stdout)\n     stops_data = json.loads(stops_run.stdout)\n \n     assert len(stops_data[\"rows\"]) == 2\n     assert ledger_data[\"summary\"][\"stops\"] == len(stops_data[\"rows\"])\n \n \n def test_ledger_marks_a_pre_v018_record_commit_as_record_or_launch(tmp_path):\n     \"\"\"Acceptance row 2: a person's record commit before v0.18.0 prints\n     record-or-launch with the note, never launch or record -- before that\n     version the driver and the executor had no identity of their own to\n     tell a genuine launch apart from an automated one.\"\"\"\n     root = make_tenant(tmp_path, \"ledger_base\")\n     add_spec(root)\n \n     rel = write_record(root, \"1\", \"build\", 1, {\"status\": \"pass\", \"product_version\": \"v0.17.0\"})\n     person_sha = commit_as(root, PERSON, \"manual build record for item 1\", [rel])\n \n     run = run_attavo(root, \"ledger\", \"1\", \"--json\")\n     assert run.returncode == 0, run.stdout + run.stderr\n     data = json.loads(run.stdout)\n \n     row = next(r for r in data[\"rows\"] if r[\"sha\"] == person_sha)\n     assert row[\"class\"] == \"record-or-launch\"\n     assert row[\"note\"] == \"not distinguishable before v0.18.0\"\n     assert data[\"summary\"][\"operator_acts\"] == 0\n     assert data[\"summary\"][\"product_acts\"] == 0\n \n \n+def test_ledger_classifies_an_invocation_marker_commit_as_a_product_record(tmp_path):\n+    \"\"\"Issue #151: the invocation marker's own commit, authored by the\n+    driver identity, touches paths.records without matching a stage\n+    record's own NN.json name -- classified \"record\", the product's own\n+    act, never \"transport\". Otherwise the same order build_merged_item\n+    sets up, with the marker's own commit landing just ahead of the\n+    build record it precedes in a real drive run.\"\"\"\n+    root = make_tenant(tmp_path, \"ledger_base\")\n+    git(root, \"checkout\", \"-b\", \"item\")\n+\n+    spec_sha = add_spec(root, \"1\")\n+\n+    rel = write_record(root, \"1\", \"spec\", 1,\n+                       {\"status\": \"pass\", \"spec_sha\": spec_sha, \"product_version\": \"v0.19.1\"})\n+    commit_as(root, RECORDS_APP, \"attavo: spec-gate record for item 1\", [rel])\n+\n+    rel = write_record(root, \"1\", \"approval\", 1,\n+                       {\"approved_by\": \"alice\", \"sha\": spec_sha, \"spec_sha\": spec_sha,\n+                        \"product_version\": \"v0.19.1\"})\n+    commit_as(root, RECORDS_APP, \"attavo: approval record for item 1\", [rel])\n+\n+    marker_dir = root / \"records\" / \"1\"\n+    marker_dir.mkdir(parents=True, exist_ok=True)\n+    marker = marker_dir / \"build-01.started\"\n+    marker.write_text(json.dumps({\"at\": \"2026-01-01T00:00:00Z\", \"host\": \"h\", \"pid\": 1,\n+                                  \"sha\": spec_sha, \"product_version\": \"v0.19.1\"}))\n+    marker_sha = commit_as(root, DRIVER, \"attavo: build invocation 01 started for item 1\",\n+                           [str(marker.relative_to(root))])\n+\n+    (root / \"built.txt\").write_text(\"built\\n\")\n+    commit_as(root, EXECUTOR, \"fixture: build item 1\", [\"built.txt\"])\n+\n+    rel = write_record(root, \"1\", \"build\", 1, {\"status\": \"pass\", \"product_version\": \"v0.19.1\"})\n+    commit_as(root, DRIVER, \"attavo: build record for item 1 (build-01)\", [rel])\n+\n+    rel = write_record(root, \"1\", \"verify\", 1, {\"status\": \"pass\", \"product_version\": \"v0.19.1\"})\n+    commit_as(root, DRIVER, \"attavo: verify record for item 1 (verify-01)\", [rel])\n+\n+    git(root, \"checkout\", \"main\")\n+    subprocess.run([\"git\", \"-C\", str(root), \"merge\", \"--no-ff\", \"item\",\n+                    \"-m\", \"Merge pull request #1 from x/item\"], check=True)\n+\n+    run = run_attavo(root, \"ledger\", \"1\", \"--json\")\n+    assert run.returncode == 0, run.stdout + run.stderr\n+    data = json.loads(run.stdout)\n+\n+    row = next(r for r in data[\"rows\"] if r[\"sha\"] == marker_sha)\n+    assert row[\"class\"] == \"record\"\n+\n+    classes = [r[\"class\"] for r in data[\"rows\"]]\n+    assert classes == [\"spec\", \"record\", \"approve\", \"record\", \"change\", \"record\", \"record\", \"merge\"]\n+    assert data[\"summary\"][\"product_acts\"] == 4\n+    assert data[\"summary\"][\"operator_acts\"] == 2\n+\n+\n def test_ledger_json_is_one_object_matching_the_text_forms_numbers(tmp_path):\n     \"\"\"Acceptance row 3: --json is one object with rows and summary, and\n     the text form prints the same numbers.\"\"\"\n     root = build_merged_item(tmp_path)\n \n     run_json = run_attavo(root, \"ledger\", \"1\", \"--json\")\n     assert run_json.returncode == 0, run_json.stdout + run_json.stderr\n     data = json.loads(run_json.stdout)\n     assert set(data) == {\"item\", \"rows\", \"summary\"}\n     assert isinstance(data[\"rows\"], list)\n     assert isinstance(data[\"summary\"], dict)\n \n     run_text = run_attavo(root, \"ledger\", \"1\")\n     assert run_text.returncode == 0, run_text.stdout + run_text.stderr\n     summary = data[\"summary\"]\n     assert f\"operator acts: {summary['operator_acts']}\" in run_text.stdout\n     assert f\"product 
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XaZZCLVGyH8YoFhSJkjcpA","type":"tool_result","content":"2634\tdef commit_record(root: Path, record_paths: Path | list[Path], message: str) -> None:\n2635\t    \"\"\"`git commit --only` on every record path given, and each one's .log\n2636\t    and .filed, each if one exists -- never the whole index. A transport\n2637\t    commit that sweeps the index is exactly the regression issue #46\n2638\t    already guards build and verify against on the adapter side; drive\n2639\t    must not reintroduce it on the transport side. The .filed marker\n2640\t    (issue #89) is committed alongside the record it names, in the same\n2641\t    commit and the same push, so a second worktree or a fresh clone reads\n2642\t    the same filed fact rather than refiling every stop it finds with no\n2643\t    marker of its own. A single Path is accepted for the common one-record\n2644\t    case; issue #100 passes a list so the counsel record lands in the same\n2645\t    commit as the stage record it counsels. Authored and committed as\n2646\t    driver_identity(), set by the product and never the tenant's git\n2647\t    config, so a driven item's record commits are never indistinguishable\n2648\t    from an operator's own.\"\"\"\n2649\t    if isinstance(record_paths, Path):\n2650\t        record_paths = [record_paths]\n2651\t    paths: list[str] = []\n2652\t    for record_path in record_paths:\n2653\t        paths.append(str(record_path.relative_to(root)))\n2654\t        log_path = record_path.with_suffix(\".log\")\n2655\t        if log_path.is_file():\n2656\t            paths.append(str(log_path.relative_to(root)))\n2657\t        marker_path = record_path.with_suffix(\".filed\")\n2658\t        if marker_path.is_file():\n2659\t            paths.append(str(marker_path.relative_to(root)))\n2660\t    identity = driver_identity()\n2661\t    env = dict(os.environ)\n2662\t    env[\"GIT_AUTHOR_NAME\"] = identity[\"name\"]\n2663\t    env[\"GIT_AUTHOR_EMAIL\"] = identity[\"email\"]\n2664\t    env[\"GIT_COMMITTER_NAME\"] = identity[\"name\"]\n2665\t    env[\"GIT_COMMITTER_EMAIL\"] = identity[\"email\"]\n2666\t    git(root, \"add\", *paths)\n2667\t    git(root, \"commit\", \"--only\", \"-m\", message, *paths, env=env)\n2668\t\n2669\t\n2670\tdef push_record_commit(root: Path, branch: str) -> tuple[bool, str | None]:\n2671\t    \"\"\"Push HEAD to branch on origin. A push a divergent remote rejects is\n2672\t    retried once after `git pull --no-rebase --no-edit origin branch` -- a\n2673\t    merge, never a rebase, because a rebase would change the sha the record\n2674\t    commit just wrote already names.\"\"\"\n2675\t    def attempt() -> tuple[bool, str]:\n2676\t        run = subprocess.run([\"git\", \"-C\", str(root), \"push\", \"origin\", f\"HEAD:{branch}\"],\n2677\t                             capture_output=True, text=True, check=False)\n2678\t        return run.returncode == 0, run.stderr.strip()\n2679\t\n2680\t    ok, err = attempt()\n2681\t    if ok:\n2682\t        return True, None\n2683\t    pull = subprocess.run([\"git\", \"-C\", str(root), \"pull\", \"--no-rebase\", \"--no-edit\",\n2684\t                           \"origin\", branch], capture_output=True, text=True, check=False)\n2685\t    if pull.returncode != 0:\n2686\t        return False, f\"push rejected and the retry merge failed: {pull.stderr.strip() or err}\"\n2687\t    ok, err = attempt()\n2688\t    if not ok:\n2689\t        return False, f\"push rejected again after merging {branch}: {err}\"\n2690\t    return True, None\n2691\t\n2692\t\n2693\tdef drive_state(root: Path, m: dict, item_id: str) -> tuple[str, str | None, Path]:\n2694\t    \"\"\"(\"no-approval\" | \"build\" | \"verify\" | \"ready\", detail, records_dir):\n2695\t    the next mechanical step for item_id, read from its latest records\n2696\t    alone. A build only counts as current when it is a pass bound to the\n2697\t    valid approval's own sha; a verify only counts as current when it is a\n2698\t    pass bound to that build's own sha -- the same staleness a re-approval\n2699\t    or a re-build must force, attest's own chain check already enforces\n2700\t    (check_attest_chain), read here rather than re-typed.\"\"\"\n2701\t    records_rel = m[\"paths\"][\"records\"]\n2702\t    records_dir = root / records_rel / item_id\n2703\t\n2704\t    status = approval_status(root, m, item_id)\n2705\t    if status != \"valid\":\n2706\t        return \"no-approval\", status, records_dir\n2707\t\n2708\t    latest_approval = latest_record(records_dir, \"approval\")\n2709\t    latest_build = latest_record(records_dir, \"build\")\n2710\t    build_current = (latest_build is not None and latest_build.get(\"status\") == \"pass\"\n2711\t                     and latest_build.get(\"approval_sha\") == (latest_approval or {}).get(\"sha\"))\n2712\t    if not build_current:\n2713\t        return \"build\", None, records_dir\n2714\t\n2715\t    latest_verify = latest_record(records_dir, \"verify\")\n2716\t    verify_current = (latest_verify is not None and latest_verify.get(\"status\") == \"pass\"\n2717\t                      and latest_verify.get(\"build_sha\") == latest_build.get(\"sha\"))\n2718\t    if not verify_current:\n2719\t        return \"verify\", None, records_dir\n2720\t\n2721\t    return \"ready\", None, records_dir\n2722\t\n2723\t\n2724\tdef _drive_run_stage(root: Path, records_dir: Path, branch: str, stage: str, item_id: str) -> int:\n2725\t    \"\"\"Runs build or verify in-process -- the same command `attavo build`\n2726\t    or `attavo verify` would run, printing the same reason on a refusal,\n2727\t    failure, or halt. A non-pass record is counseled (cmd_counsel, issue\n2728\t    #100) and filed (cmd_file_stops, issue #89) before it is transported,\n2729\t    so a stop's own counsel record and .filed marker -- the filing\n2730\t    command's stdout, the issue file-stops just opened -- exist on disk\n2731\t    in time to be committed and pushed in the very same commit as the\n2732\t    stage record and its log; a marker written only after the push would\n2733\t    never reach the ledger at all, and a second worktree or a fresh clone\n2734\t    would refile every stop it finds with no marker beside it. The stage\n2735\t    record and the counsel record (when one was written) are then\n2736\t    transported together: committed with commit_record and pushed with\n2737\t    push_record_commit, whatever the stage record's status -- the record\n2738\t    pushes stay the same pushes, made by drive in the run that produced\n2739\t    the record (issue #84's rule 42 row).\"\"\"\n2740\t    before = latest_attempt_path(records_dir, stage)\n2741\t    # The invocation's marker, committed and pushed before the stage runs:\n2742\t    # one commit per attempt, so that an invocation which dies or hangs\n2743\t    # is a fact on the branch (proof five) and not a silence.\n2744\t    nn = next_attempt_number(records_dir, stage)\n2745\t    marker = write_invocation_marker(root, records_dir, stage, nn)\n2746\t    try:\n2747\t        commit_record(root, [marker], f\"attavo: {stage} invocation {nn:02d} started for item {item_id}\")\n2748\t    except RuntimeError as exc:\n2749\t        print(f\"attavo drive: stopped: could not commit the {stage} invocation marker: {exc}\")\n2750\t        return 1\n2751\t    ok, err = push_record_commit(root, branch)\n2752\t    if not ok:\n2753\t        print(f\"attavo drive: stopped: could not push the {stage} invocation marker: {err}\")\n2754\t        return 1\n2755\t    rc = cmd_build([item_id]) if stage == \"build\" else cmd_verify([item_id])\n2756\t    after = latest_attempt_path(records_dir, stage)\n2757\t\n2758\t    if after is None or after == before:\n2759\t        # Refused before writing anything at all (e.g. no adapter\n2760\t        # configured) -- the stage command already printed why.\n2761\t        return rc if rc != 0 else 1\n2762\t\n2763\t    record = latest_record(records_dir, stage)\n2764\t    status_out = record.get(\"status\")\n2765\t    to_commit = [after]\n2766\t    if status_out != \"pass\":\n2767\t        counsel_before = latest_attempt_path(records_dir, \"counsel\")\n2768\t        cmd_counsel([item_id])\n2769\t        counsel_after = latest_attempt_path(records_dir, \"counsel\")\n2770\t        if counsel_after is not None and counsel_after != counsel_before:\n2771\t            to_commit.append(counsel_after)\n2772\t        # file-stops is its own idempotent read of the item's records, so\n2773\t        # calling it here on every run that wrote a non-pass record is\n2774\t        # safe to call again on a later run: an already-filed stop's own\n2775\t        # marker is what stops it from being filed twice.\n2776\t        cmd_file_stops([item_id])\n2777\t\n2778\t    message = f\"attavo: {stage} record for item {item_id} ({after.stem})\"\n2779\t    try:\n2780\t        commit_record(root, to_commit, message)\n2781\t    except RuntimeError as exc:\n2782\t        print(f\"attavo drive: stopped: could not commit the {stage} record: {exc}\")\n2783\t        return 1\n2784\t\n2785\t    ok, err = push_record_commit(root, branch)\n2786\t    if not ok:\n2787\t        print(f\"attavo drive: stopped: could not push the {stage} record: {err}\")\n2788\t        return 1\n2789\t\n2790\t    if status_out == \"halted\":\n2791\t        question = (record.get(\"halted\") or {}).get(\"question\")\n2792\t        print(f\"attavo drive: stopped: {stage} halted: {question} ({after.name}); \"\n2793\t              f\"pushed to {branch}\")\n2794\t    elif status_out != \"pass\":\n2795\t        reason = record.get(\"refusal\") or status_out\n2796\t        print(f\"attavo drive: stopped: {stage} {status_out}: {reason} ({after.name}); \"\n2797\t              f\"pushed to {branch}\")\n2798\t    else:\n2799\t        print(f\"attavo drive: pushed {after.name} to {branch}\")\n2800\t    return rc\n2801\t\n2802\t\n2803\tdef _drive_step(root: Path, m: dict, item_id: str) -> tuple[int, bool]:\n2804\t    \"\"\"One mechanical step, exactly as a single `attavo drive` call always\n2805\t    has -- and whether repetition under --until-ready should stop here:\n2806\t    True for every refusal or stop (no valid approval, no\n2807\t    [forge].checks_command, the forge not green, or a stage that wrote a\n2808\t    non-pass record) and for the ready-to-merge terminal state; False\n2809\t    only when a stage just passed, so drive_state may have a further\n2810\t    stage to pursue on the next call.\"\"\"\n2811\t    try:\n2812\t        stage, extra, records_dir = drive_state(root, m, item_id)\n2813\t    except ShallowCheckoutError as exc:\n2814\t        print(f\"attavo drive: refused: {exc}\", file=sys.stderr)\n2815\t        return 2, True\n2816\t\n2817\t    if stage == \"no-approval\":\n2818\t        print(f\"attavo drive: refused: approval is {extra}\")\n2819\t        return 1, True\n2820\t\n2821\t    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n2822\t\n2823\t    if stage == \"build\":\n2824\t        rc = _drive_run_stage(root, records_dir, branch, \"build\", item_id)\n2825\t        return rc, rc != 0\n2826\t\n2827\t    checks_command = (m.get(\"forge\") or {}).get(\"checks_command\")\n2828\t    if not checks_command:\n2829\t        print(\"attavo drive: refused: no [forge].checks_command in the manifest\")\n2830\t        return 1, True\n2831\t    head_sha = git(root, \"rev-parse\", \"HEAD\").strip()\n2832\t    forge_checks, ok = poll_forge_checks(root, checks_command, head_sha)\n2833\t    if not ok:"}]},"parent_tool_use_id":null,"session_id":"f081a203-e2ee-47b3-8bf8-5fc3aaeb804d","uuid":"aa46b165-f471-4c05-ae8e-99f7aa2a6f36","timestamp":"2026-09-17T19:42:49.995Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-151/attest/specs/151/stub/bin/attavo","content":"def commit_record(root: Path, record_paths: Path | list[Path], message: str) -> None:\n    \"\"\"`git commit --only` on every record path given, and each one's .log\n    and .filed, each if one exists -- never the whole index. A transport\n    commit that sweeps the index is exactly the regression issue #46\n    already guards build and verify against on the adapter side; drive\n    must not reintroduce it on the transport side. The .filed marker\n    (issue #89) is committed alongside the record it names, in the same\n    commit and the same push, so a second worktree or a fresh clone reads\n    the same filed fact rather than refiling every stop it finds with no\n    marker of its own. A single Path is accepted for the common one-record\n    case; issue #100 passes a list so the counsel record lands in the same\n    commit as the stage record it counsels. Authored and committed as\n    driver_identity(), set by the product and never the tenant's git\n    config, so a driven item's record commits are never indistinguishable\n    from an operator's own.\"\"\"\n    if isinstance(record_paths, Path):\n        record_paths = [record_paths]\n    paths: list[str] = []\n    for record_path in record_paths:\n        paths.append(str(record_path.relative_to(root)))\n        log_path = record_path.with_suffix(\".log\")\n        if log_path.is_file():\n            paths.append(str(log_path.relative_to(root)))\n        marker_path = record_path.with_suffix(\".filed\")\n        if marker_path.is_file():\n            paths.append(str(marker_path.relative_to(root)))\n    identity = driver_identity()\n    env = dict(os.environ)\n    env[\"GIT_AUTHOR_NAME\"] = identity[\"name\"]\n    env[\"GIT_AUTHOR_EMAIL\"] = identity[\"email\"]\n    env[\"GIT_COMMITTER_NAME\"] = identity[\"name\"]\n    env[\"GIT_COMMITTER_EMAIL\"] = identity[\"email\"]\n    git(root, \"add\", *paths)\n    git(root, \"commit\", \"--only\", \"-m\", message, *paths, env=env)\n\n\ndef push_record_commit(root: Path, branch: str) -> tuple[bool, str | None]:\n    \"\"\"Push HEAD to branch on origin. A push a divergent remote rejects is\n    retried once after `git pull --no-rebase --no-edit origin branch` -- a\n    merge, never a rebase, because a rebase would change the sha the record\n    commit just wrote already names.\"\"\"\n    def attempt() -> tuple[bool, str]:\n        run = subprocess.run([\"git\", \"-C\", str(root), \"push\", \"origin\", f\"HEAD:{branch}\"],\n                             capture_output=True, text=True, check=False)\n        return run.returncode == 0, run.stderr.strip()\n\n    ok, err = attempt()\n    if ok:\n        return True, None\n    pull = subprocess.run([\"git\", \"-C\", str(root), \"pull\", \"--no-rebase\", \"--no-edit\",\n                           \"origin\", branch], capture_output=True, text=True, check=False)\n    if pull.returncode != 0:\n        return False, f\"push rejected and the retry merge failed: {pull.stderr.strip() or err}\"\n    ok, err = attempt()\n    if not ok:\n        return False, f\"push rejected again after merging {branch}: {err}\"\n    return True, None\n\n\ndef drive_state(root: Path, m: dict, item_id: str) -> tuple[str, str | None, Path]:\n    \"\"\"(\"no-approval\" | \"build\" | \"verify\" | \"ready\", detail, records_dir):\n    the next mechanical step for item_id, read from its latest records\n    alone. A build only counts as current when it is a pass bound to the\n    valid approval's own sha; a verify only counts as current when it is a\n    pass bound to that build's own sha -- the same staleness a re-approval\n    or a re-build must force, attest's own chain check already enforces\n    (check_attest_chain), read here rather than re-typed.\"\"\"\n    records_rel = m[\"paths\"][\"records\"]\n    records_dir = root / records_rel / item_id\n\n    status = approval_status(root, m, item_id)\n    if status != \"valid\":\n        return \"no-approval\", status, records_dir\n\n    latest_approval = latest_record(records_dir, \"approval\")\n    latest_build = latest_record(records_dir, \"build\")\n    build_current = (latest_build is not None and latest_build.get(\"status\") == \"pass\"\n                     and latest_build.get(\"approval_sha\") == (latest_approval or {}).get(\"sha\"))\n    if not build_current:\n        return \"build\", None, records_dir\n\n    latest_verify = latest_record(records_dir, \"verify\")\n    verify_current = (latest_verify is not None and latest_verify.get(\"status\") == \"pass\"\n                      and latest_verify.get(\"build_sha\") == latest_build.get(\"sha\"))\n    if not verify_current:\n        return \"verify\", None, records_dir\n\n    return \"ready\", None, records_dir\n\n\ndef _drive_run_stage(root: Path, records_dir: Path, branch: str, stage: str, item_id: str) -> int:\n    \"\"\"Runs build or verify in-process -- the same command `attavo build`\n    or `attavo verify` would run, printing the same reason on a refusal,\n    failure, or halt. A non-pass record is counseled (cmd_counsel, issue\n    #100) and filed (cmd_file_stops, issue #89) before it is transported,\n    so a stop's own counsel record and .filed marker -- the filing\n    command's stdout, the issue file-stops just opened -- exist on disk\n    in time to be committed and pushed in the very same commit as the\n    stage record and its log; a marker written only after the push would\n    never reach the ledger at all, and a second worktree or a fresh clone\n    would refile every stop it finds with no marker beside it. The stage\n    record and the counsel record (when one was written) are then\n    transported together: committed with commit_record and pushed with\n    push_record_commit, whatever the stage record's status -- the record\n    pushes stay the same pushes, made by drive in the run that produced\n    the record (issue #84's rule 42 row).\"\"\"\n    before = latest_attempt_path(records_dir, stage)\n    # The invocation's marker, committed and pushed before the stage runs:\n    # one commit per attempt, so that an invocation which dies or hangs\n    # is a fact on the branch (proof five) and not a silence.\n    nn = next_attempt_number(records_dir, stage)\n    marker = write_invocation_marker(root, records_dir, stage, nn)\n    try:\n        commit_record(root, [marker], f\"attavo: {stage} invocation {nn:02d} started for item {item_id}\")\n    except RuntimeError as exc:\n        print(f\"attavo drive: stopped: could not commit the {stage} invocation marker: {exc}\")\n        return 1\n    ok, err = push_record_commit(root, branch)\n    if not ok:\n        print(f\"attavo drive: stopped: could not push the {stage} invocation marker: {err}\")\n        return 1\n    rc = cmd_build([item_id]) if stage == \"build\" else cmd_verify([item_id])\n    after = latest_attempt_path(records_dir, stage)\n\n    if after is None or after == before:\n        # Refused before writing anything at all (e.g. no adapter\n        # configured) -- the stage command already printed why.\n        return rc if rc != 0 else 1\n\n    record = latest_record(records_dir, stage)\n    status_out = record.get(\"status\")\n    to_commit = [after]\n    if status_out != \"pass\":\n        counsel_before = latest_attempt_path(records_dir, \"counsel\")\n        cmd_counsel([item_id])\n        counsel_after = latest_attempt_path(records_dir, \"counsel\")\n        if counsel_after is not None and counsel_after != counsel_before:\n            to_commit.append(counsel_after)\n        # file-stops is its own idempotent read of the item's records, so\n        # calling it here on every run that wrote a non-pass record is\n        # safe to call again on a later run: an already-filed stop's own\n        # marker is what stops it from being filed twice.\n        cmd_file_stops([item_id])\n\n    message = f\"attavo: {stage} record for item {item_id} ({after.stem})\"\n    try:\n        commit_record(root, to_commit, message)\n    except RuntimeError as exc:\n        print(f\"attavo drive: stopped: could not commit the {stage} record: {exc}\")\n        return 1\n\n    ok, err = push_record_commit(root, branch)\n    if not ok:\n        print(f\"attavo drive: stopped: could not push the {stage} record: {err}\")\n        return 1\n\n    if status_out == \"halted\":\n        question = (record.get(\"halted\") or {}).get(\"question\")\n        print(f\"attavo drive: stopped: {stage} halted: {question} ({after.name}); \"\n              f\"pushed to {branch}\")\n    elif status_out != \"pass\":\n        reason = record.get(\"refusal\") or status_out\n        print(f\"attavo drive: stopped: {stage} {status_out}: {reason} ({after.name}); \"\n              f\"pushed to {branch}\")\n    else:\n        print(f\"attavo drive: pushed {after.name} to {branch}\")\n    return rc\n\n\ndef _drive_step(root: Path, m: dict, item_id: str) -> tuple[int, bool]:\n    \"\"\"One mechanical step, exactly as a single `attavo drive` call always\n    has -- and whether repetition under --until-ready should stop here:\n    True for every refusal or stop (no valid approval, no\n    [forge].checks_command, the forge not green, or a stage that wrote a\n    non-pass record) and for the ready-to-merge terminal state; False\n    only when a stage just passed, so drive_state may have a further\n    stage to pursue on the next call.\"\"\"\n    try:\n        stage, extra, records_dir = drive_state(root, m, item_id)\n    except ShallowCheckoutError as exc:\n        print(f\"attavo drive: refused: {exc}\", file=sys.stderr)\n        return 2, True\n\n    if stage == \"no-approval\":\n        print(f\"attavo drive: refused: approval is {extra}\")\n        return 1, True\n\n    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n\n    if stage == \"build\":\n        rc = _drive_run_stage(root, records_dir, branch, \"build\", item_id)\n        return rc, rc != 0\n\n    checks_command = (m.get(\"forge\") or {}).get(\"checks_command\")\n    if not checks_command:\n        print(\"attavo drive: refused: no [forge].checks_command in the manifest\")\n        return 1, True\n    head_sha = git(root, \"rev-parse\", \"HEAD\").strip()\n    forge_checks, ok = poll_forge_checks(root, checks_command, head_sha)\n    if not ok:","numLines":200,"startLine":2634,"totalLines":3663}}}

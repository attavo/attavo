  marker.write_text(json.dumps(\n            {\"at\": datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\"),\n             \"host\": socket.gethostname(), \"pid\": alive.pid, \"sha\": head_of(root),\n             \"product_version\": \"fixture\"}))\n        commit_all(root, \"invocation marker for a live pid\")\n\n        run = run_attavo(root, \"drive\", \"1\", \"--recover\")\n        assert run.returncode == 0, run.stdout + run.stderr\n        assert \"nothing to recover\" in run.stdout\n        assert record_files(root, \"build\") == []\n    finally:\n        alive.terminate()\n        alive.wait()"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1599,"cache_read_input_tokens":215094,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1599},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"f081a203-e2ee-47b3-8bf8-5fc3aaeb804d","uuid":"162f2ecf-b6d9-4dc9-aebe-8fd63ab68dd5","timestamp":"2026-09-17T20:01:25.108Z","request_id":"req_011Cf9c9nyvHiNbut1yzG73U","wire_tool_inputs":{"toolu_01WpJWqBsAGBhp7D9jBQyZtp":{"file_path":"/Users/davidbean/Projects/attavo-worktree-151/tests/test_drive.py","old_string":"def test_drive_recover_leaves_a_live_invocation_alone(tmp_path):\n    \"\"\"A marker naming this test process's own pid -- alive on this host\n    and well inside the stall bound -- is running, not died: recover\n    writes nothing.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_drive_stall_bound(root, 3600)\n\n    marker = records_dir(root) / \"build-01.started\"\n    marker.parent.mkdir(parents=True, exist_ok=True)\n    marker.write_text(json.dumps({\"at\": \"2026-09-17T13:16:08Z\", \"host\": socket.gethostname(),\n                                  \"pid\": os.getpid(), \"sha\": head_of(root),\n                                  \"product_version\": \"fixture\"}))\n    commit_all(root, \"invocation marker for a live pid\")\n\n    run = run_attavo(root, \"drive\", \"1\", \"--recover\")\n    assert run.returncode == 0, run.stdout + run.stderr\n    assert \"nothing to recover\" in run.stdout\n    assert record_files(root, \"build\") == []","new_string":"def test_drive_recover_leaves_a_live_invocation_alone(tmp_path):\n    \"\"\"A marker naming a live, unrelated pid on this host, started just\n    now -- well inside the stall bound -- is running, not died: recover\n    writes nothing. A real subprocess, never this test's own pid: were it\n    ever judged hung, recover would SIGTERM the pid the marker names.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_drive_stall_bound(root, 3600)\n\n    alive = subprocess.Popen([sys.executable, \"-c\", \"import time; time.sleep(30)\"])\n    try:\n        marker = records_dir(root) / \"build-01.started\"\n        marker.parent.mkdir(parents=True, exist_ok=True)\n        marker.write_text(json.dumps(\n            {\"at\": datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\"),\n             \"host\": socket.gethostname(), \"pid\": alive.pid, \"sha\": head_of(root),\n             \"product_version\": \"fixture\"}))\n        commit_all(root, \"invocation marker for a live pid\")\n\n        run = run_attavo(root, \"drive\", \"1\", \"--recover\")\n        assert run.returncode == 0, run.stdout + run.stderr\n        assert \"nothing to recover\" in run.stdout\n        assert record_files(root, \"build\") == []\n    finally:\n        alive.terminate()\n        alive.wait()"}}}

ue\n3438\t\n3439\t        # An invocation marker's own commit (proof five): the product's\n3440\t        # act, never the operator's.\n3441\t        if any(p.startswith(records_prefix) and p.endswith(INVOCATION_MARKER_SUFFIX)\n3442\t               for p in touched):\n3443\t            rows.append({\"sha\": sha, \"identity\": name, \"class\": \"record\"})\n3444\t            product_acts += 1\n3445\t            continue\n3446\t\n3447\t        if any(p.startswith(specs_prefix) for p in touched):\n3448\t            cls = \"amend\" if approval_seen else \"spec\"\n3449\t            rows.append({\"sha\": sha, \"identity\": name, \"class\": cls})\n3450\t            if cls == \"amend\":\n3451\t                operator_acts += 1\n3452\t            continue\n3453\t\n3454\t        rows.append({\"sha\": sha, \"identity\": name, \"class\": \"transport\"})\n3455\t        operator_acts += 1\n3456\t\n3457\t    # issue #137: the same set attavo stops counts, from the same reader\n3458\t    # (item_stops) -- not a second, independent count kept in sync by\n3459\t    # hand. One non-pass record per row, whatever its stage; a gate\n3460\t    # refusal is included the same as a non-pass build or verify record.\n3461\t    stops = len(item_stops(root, m, item_id)[\"rows\"])\n3462\t\n3463\t    summary = {\"operator_acts\": operator_acts, \"product_acts\": product_acts,\n3464\t              \"executor_commits\": executor_commits, \"stops\": stops, \"since\": since}\n3465\t    return {\"item\": item_id, \"rows\": rows, \"summary\": summary}\n3466\t\n3467\t\n3468\tdef cmd_ledger(argv: list[str]) -> int:\n3469\t    as_json = \"--json\" in argv"}]},"parent_tool_use_id":null,"session_id":"f081a203-e2ee-47b3-8bf8-5fc3aaeb804d","uuid":"52c11af3-bbea-41c3-9752-9bca48090bc9","timestamp":"2026-09-17T19:42:58.514Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-151/attest/specs/151/stub/bin/attavo","content":"        touched = _commit_touches(root, sha)\n        record_touch = None\n        for p in touched:\n            if not p.startswith(records_prefix):\n                continue\n            rm = RECORD_RE.match(Path(p).name)\n            if rm and rm.group(1) in STAGES:\n                record_touch = (rm.group(1), p)\n                break\n\n        if record_touch is not None:\n            stage, relpath = record_touch\n            content = _record_at(root, sha, relpath, item_id)\n            if since is None:\n                since = content.get(\"product_version\")\n\n            if stage == \"approval\":\n                rows.append({\"sha\": sha, \"identity\": name, \"class\": \"approve\"})\n                operator_acts += 1\n                approval_seen = True\n                continue\n\n            is_driver = name == driver[\"name\"] and email == driver[\"email\"]\n            is_records_app = _is_records_app(name)\n            if stage == \"spec\" or is_driver or is_records_app:\n                rows.append({\"sha\": sha, \"identity\": name, \"class\": \"record\"})\n                product_acts += 1\n                continue\n\n            version = _semver_tuple(content.get(\"product_version\"))\n            if version is not None and version < LEDGER_V018_CUTOFF:\n                rows.append({\"sha\": sha, \"identity\": name, \"class\": \"record-or-launch\",\n                            \"note\": \"not distinguishable before v0.18.0\"})\n                continue\n\n            rows.append({\"sha\": sha, \"identity\": name, \"class\": \"launch\"})\n            operator_acts += 1\n            continue\n\n        # An invocation marker's own commit (proof five): the product's\n        # act, never the operator's.\n        if any(p.startswith(records_prefix) and p.endswith(INVOCATION_MARKER_SUFFIX)\n               for p in touched):\n            rows.append({\"sha\": sha, \"identity\": name, \"class\": \"record\"})\n            product_acts += 1\n            continue\n\n        if any(p.startswith(specs_prefix) for p in touched):\n            cls = \"amend\" if approval_seen else \"spec\"\n            rows.append({\"sha\": sha, \"identity\": name, \"class\": cls})\n            if cls == \"amend\":\n                operator_acts += 1\n            continue\n\n        rows.append({\"sha\": sha, \"identity\": name, \"class\": \"transport\"})\n        operator_acts += 1\n\n    # issue #137: the same set attavo stops counts, from the same reader\n    # (item_stops) -- not a second, independent count kept in sync by\n    # hand. One non-pass record per row, whatever its stage; a gate\n    # refusal is included the same as a non-pass build or verify record.\n    stops = len(item_stops(root, m, item_id)[\"rows\"])\n\n    summary = {\"operator_acts\": operator_acts, \"product_acts\": product_acts,\n              \"executor_commits\": executor_commits, \"stops\": stops, \"since\": since}\n    return {\"item\": item_id, \"rows\": rows, \"summary\": summary}\n\n\ndef cmd_ledger(argv: list[str]) -> int:\n    as_json = \"--json\" in argv","numLines":70,"startLine":3400,"totalLines":3663}}}

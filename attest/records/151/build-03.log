{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YNBHMxJ4nPXdhXfH1KeypZ","type":"tool_result","content":"747\t    assert remote_head(bare, branch) == head_of(root)\n748\t    # the concurrent commit from the other clone is present too\n749\t    assert \"concurrent.txt\" in git(root, \"ls-tree\", \"-r\", \"--name-only\", \"HEAD\")\n750\t\n751\t\n752\tdef add_drive_stall_bound(root: Path, seconds: int) -> None:\n753\t    toml = root / \"attavo.toml\"\n754\t    toml.write_text(toml.read_text() + f\"\\n[drive]\\nstall_after_s = {seconds}\\n\")\n755\t    commit_all(root, \"configure the drive stall bound\")\n756\t\n757\t\n758\tdef test_drive_writes_and_pushes_an_invocation_marker_before_running_the_stage(tmp_path):\n759\t    \"\"\"Issue #151. Before running build, drive writes a build-01.started\n760\t    marker and commits and pushes it by itself -- the fact that this\n761\t    invocation began is on the branch before the adapter ever runs, so a\n762\t    process that dies mid-build still leaves it behind.\"\"\"\n763\t    root = make_tenant(tmp_path, \"build_valid\")\n764\t    add_forge(root, GREEN_FORGE)\n765\t    bare = add_bare_remote(root, tmp_path)\n766\t    approve_item(root)\n767\t    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n768\t\n769\t    run = run_attavo(root, \"drive\", \"1\")\n770\t    assert run.returncode == 0, run.stdout + run.stderr\n771\t\n772\t    marker_path = records_dir(root) / \"build-01.started\"\n773\t    assert marker_path.is_file()\n774\t    info = json.loads(marker_path.read_text())\n775\t    assert info[\"pid\"] > 0 and info[\"host\"] and info[\"sha\"]\n776\t\n777\t    # The marker's own commit precedes the record's own commit; both\n778\t    # reached the remote.\n779\t    marker_commit = git(root, \"log\", \"-1\", \"--format=%H\",\n780\t                        \"--\", \"records/1/build-01.started\").strip()\n781\t    record_commit = git(root, \"log\", \"-1\", \"--format=%H\",\n782\t                        \"--\", \"records/1/build-01.json\").strip()\n783\t    assert marker_commit != record_commit\n784\t    is_ancestor = subprocess.run(\n785\t        [\"git\", \"-C\", str(root), \"merge-base\", \"--is-ancestor\", marker_commit, record_commit],\n786\t        check=False)\n787\t    assert is_ancestor.returncode == 0, \"the marker's commit should precede the record's\"\n788\t    assert remote_head(bare, branch) == head_of(root)\n789\t\n790\t\n791\tdef test_drive_recover_writes_a_died_record_for_a_dead_marker(tmp_path):\n792\t    \"\"\"Issue #151, acceptance row 2. A marker naming a dead pid on this\n793\t    host, with no record beside it, is recovered as a failed record, stop\n794\t    class died, provenance product, committed by the driver identity with\n795\t    a clean tree -- the fixture #148 left behind by hand, done here by\n796\t    the product instead.\"\"\"\n797\t    root = make_tenant(tmp_path, \"build_valid\")\n798\t    add_drive_stall_bound(root, 60)\n799\t    bare = add_bare_remote(root, tmp_path)\n800\t    approve_item(root)\n801\t\n802\t    dead = subprocess.Popen([sys.executable, \"-c\", \"pass\"])\n803\t    dead.wait()\n804\t    marker = records_dir(root) / \"build-01.started\"\n805\t    marker.parent.mkdir(parents=True, exist_ok=True)\n806\t    marker.write_text(json.dumps({\"at\": \"2026-09-17T13:16:08Z\", \"host\": socket.gethostname(),\n807\t                                  \"pid\": dead.pid, \"sha\": head_of(root),\n808\t                                  \"product_version\": \"fixture\"}))\n809\t    commit_all(root, \"invocation marker for item 1\")\n810\t    git(root, \"push\", \"origin\", \"HEAD:main\")\n811\t\n812\t    run = run_attavo(root, \"drive\", \"1\", \"--recover\")\n813\t    assert run.returncode == 0, run.stdout + run.stderr\n814\t\n815\t    rec = latest_record(root, \"build\")\n816\t    assert rec[\"status\"] == \"failed\"\n817\t    assert rec[\"stop\"][\"class\"] == \"died\"\n818\t    assert rec[\"stop\"][\"provenance\"] == \"product\"\n819\t    assert \"wrote no build-01.json\" in rec[\"stop\"][\"detail\"]\n820\t\n821\t    assert (records_dir(root) / \"build-01.log\").is_file()\n822\t    assert git(root, \"log\", \"-1\", \"--format=%an\").strip() == \"attavo driver\"\n823\t    assert git(root, \"status\", \"--porcelain\").strip() == \"\"\n824\t    assert remote_head(bare) == head_of(root)\n825\t\n826\t\n827\tdef test_drive_recover_leaves_a_live_invocation_alone(tmp_path):\n828\t    \"\"\"A marker naming this test process's own pid -- alive on this host\n829\t    and well inside the stall bound -- is running, not died: recover\n830\t    writes nothing.\"\"\"\n831\t    root = make_tenant(tmp_path, \"build_valid\")\n832\t    add_drive_stall_bound(root, 3600)\n833\t    approve_item(root)\n834\t\n835\t    marker = records_dir(root) / \"build-01.started\"\n836\t    marker.parent.mkdir(parents=True, exist_ok=True)"}]},"parent_tool_use_id":null,"session_id":"f081a203-e2ee-47b3-8bf8-5fc3aaeb804d","uuid":"b984eeb8-1cd9-4e94-8284-8fff85110d5d","timestamp":"2026-09-17T19:59:38.553Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-151/tests/test_drive.py","content":"    assert remote_head(bare, branch) == head_of(root)\n    # the concurrent commit from the other clone is present too\n    assert \"concurrent.txt\" in git(root, \"ls-tree\", \"-r\", \"--name-only\", \"HEAD\")\n\n\ndef add_drive_stall_bound(root: Path, seconds: int) -> None:\n    toml = root / \"attavo.toml\"\n    toml.write_text(toml.read_text() + f\"\\n[drive]\\nstall_after_s = {seconds}\\n\")\n    commit_all(root, \"configure the drive stall bound\")\n\n\ndef test_drive_writes_and_pushes_an_invocation_marker_before_running_the_stage(tmp_path):\n    \"\"\"Issue #151. Before running build, drive writes a build-01.started\n    marker and commits and pushes it by itself -- the fact that this\n    invocation began is on the branch before the adapter ever runs, so a\n    process that dies mid-build still leaves it behind.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    bare = add_bare_remote(root, tmp_path)\n    approve_item(root)\n    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n\n    run = run_attavo(root, \"drive\", \"1\")\n    assert run.returncode == 0, run.stdout + run.stderr\n\n    marker_path = records_dir(root) / \"build-01.started\"\n    assert marker_path.is_file()\n    info = json.loads(marker_path.read_text())\n    assert info[\"pid\"] > 0 and info[\"host\"] and info[\"sha\"]\n\n    # The marker's own commit precedes the record's own commit; both\n    # reached the remote.\n    marker_commit = git(root, \"log\", \"-1\", \"--format=%H\",\n                        \"--\", \"records/1/build-01.started\").strip()\n    record_commit = git(root, \"log\", \"-1\", \"--format=%H\",\n                        \"--\", \"records/1/build-01.json\").strip()\n    assert marker_commit != record_commit\n    is_ancestor = subprocess.run(\n        [\"git\", \"-C\", str(root), \"merge-base\", \"--is-ancestor\", marker_commit, record_commit],\n        check=False)\n    assert is_ancestor.returncode == 0, \"the marker's commit should precede the record's\"\n    assert remote_head(bare, branch) == head_of(root)\n\n\ndef test_drive_recover_writes_a_died_record_for_a_dead_marker(tmp_path):\n    \"\"\"Issue #151, acceptance row 2. A marker naming a dead pid on this\n    host, with no record beside it, is recovered as a failed record, stop\n    class died, provenance product, committed by the driver identity with\n    a clean tree -- the fixture #148 left behind by hand, done here by\n    the product instead.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_drive_stall_bound(root, 60)\n    bare = add_bare_remote(root, tmp_path)\n    approve_item(root)\n\n    dead = subprocess.Popen([sys.executable, \"-c\", \"pass\"])\n    dead.wait()\n    marker = records_dir(root) / \"build-01.started\"\n    marker.parent.mkdir(parents=True, exist_ok=True)\n    marker.write_text(json.dumps({\"at\": \"2026-09-17T13:16:08Z\", \"host\": socket.gethostname(),\n                                  \"pid\": dead.pid, \"sha\": head_of(root),\n                                  \"product_version\": \"fixture\"}))\n    commit_all(root, \"invocation marker for item 1\")\n    git(root, \"push\", \"origin\", \"HEAD:main\")\n\n    run = run_attavo(root, \"drive\", \"1\", \"--recover\")\n    assert run.returncode == 0, run.stdout + run.stderr\n\n    rec = latest_record(root, \"build\")\n    assert rec[\"status\"] == \"failed\"\n    assert rec[\"stop\"][\"class\"] == \"died\"\n    assert rec[\"stop\"][\"provenance\"] == \"product\"\n    assert \"wrote no build-01.json\" in rec[\"stop\"][\"detail\"]\n\n    assert (records_dir(root) / \"build-01.log\").is_file()\n    assert git(root, \"log\", \"-1\", \"--format=%an\").strip() == \"attavo driver\"\n    assert git(root, \"status\", \"--porcelain\").strip() == \"\"\n    assert remote_head(bare) == head_of(root)\n\n\ndef test_drive_recover_leaves_a_live_invocation_alone(tmp_path):\n    \"\"\"A marker naming this test process's own pid -- alive on this host\n    and well inside the stall bound -- is running, not died: recover\n    writes nothing.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_drive_stall_bound(root, 3600)\n    approve_item(root)\n\n    marker = records_dir(root) / \"build-01.started\"\n    marker.parent.mkdir(parents=True, exist_ok=True)","numLines":90,"startLine":747,"totalLines":862}}}

a\": {\"type\": \"string\", \"minLength\": 1},\n    \"build_record\": {\"type\": [\"string\", \"null\"]},\n    \"approval_sha\": {\"type\": [\"string\", \"null\"]},\n    \"at\": {\"type\": \"string\", \"minLength\": 1},\n    \"adapter\": {\"type\": [\"string\", \"null\"]},\n    \"adapter_config\": {\n      \"type\": \"object\",\n      \"description\": \"Copied verbatim from [executor.<adapter>] merged with [executor.<adapter>.verify]; {} when no adapter was called.\"\n    },\n    \"adapter_version\": {\"type\": [\"string\", \"null\"]},\n    \"model\": {\"type\": [\"string\", \"null\"]},\n    \"model_version\": {\"type\": [\"string\", \"null\"]},\n    \"reports\": {\n      \"type\": \"array\",\n      \"description\": \"Field names adapters/<name>/conformance.json declares this adapter can supply with a real value (vendor independence, 2026-09-09 ruling) -- [] when no adapter was called or it declares no conformance.json. Dollars are never summed across adapters; a field absent here renders as not reported by this executor, never zero or blank.\",\n      \"items\": {\"type\": \"string\", \"minLength\": 1}\n    },\n    \"forge_checks\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\"command\", \"sha\", \"conclusions\"],\n      \"properties\": {\n        \"command\": {\"type\": \"string\", \"minLength\": 1},\n        \"sha\": {\"type\": \"string\", \"minLength\": 1},\n        \"conclusions\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"object\",\n            \"additionalProperties\": false,\n            \"required\": [\"name\", \"conclusion\"],\n            \"properties\": {\n              \"name\": {\"type\": \"string\", \"minLength\": 1},\n              \"conclusion\": {\"type\": \"string\", \"minLength\": 1}\n            }\n          }\n        }\n      }\n    },\n    \"findings\": {\n      \"type\": [\"array\", \"null\"],\n      \"description\": \"null when no adapter was called (the forge checks were not green), or when the adapter ran but reported no findings key at all -- distinct from an explicit empty list, which is a clean report, not a missing channel.\",\n      \"items\": {\n        \"type\": \"object\",\n        \"additionalProperties\": false,\n        \"required\": [\"title\", \"specimen\", \"retires\", \"rejection_test\", \"severity\"],\n        \"properties\": {\n          \"title\": {\"type\": \"string\", \"minLength\": 1},\n          \"specimen\": {\"type\": \"string\", \"minLength\": 1},\n          \"retires\": {\"type\": \"string\", \"minLength\": 1},\n          \"rejection_test\": {\"type\": \"string\", \"minLength\": 1},\n          \"severity\": {\"type\": \"string\", \"minLength\": 1}\n        }\n      }\n    },\n    \"tests_named\": {\n      \"type\": \"array\",\n      \"items\": {\"type\": \"string\", \"minLength\": 1}\n    },\n    \"commits\": {\n      \"type\": \"array\",\n      \"description\": \"Empty unless the adapter moved the branch head during verify -- a report, not a commit; a non-empty list here always accompanies status: \\\"failed\\\", naming exactly what the adapter should not have created.\",\n      \"items\": {\"type\": \"string\", \"minLength\": 1}\n    },\n    \"mutation\": {\n      \"type\": [\"object\", \"null\"],\n      \"additionalProperties\": false,\n      \"required\": [\"command\", \"score\", \"modules\"],\n      \"properties\": {\n        \"command\": {\"type\": \"string\", \"minLength\": 1},\n        \"score\": {\"type\": \"number\", \"minimum\": 0, \"maximum\": 1},\n        \"modules\": {\"type\": \"array\", \"items\": {\"type\": \"string\", \"minLength\": 1}}\n      }\n    },\n    \"weak_stub\": {\"type\": \"boolean\"},\n    \"stub_ratio\": {\"type\": [\"number\", \"null\"]},\n    \"tokens\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\"input\", \"output\"],\n      \"properties\": {\n        \"input\": {\"type\": \"integer\", \"minimum\": 0},\n        \"output\": {\"type\": \"integer\", \"minimum\": 0}\n      }\n    },\n    \"cost_usd\": {\"type\": [\"number\", \"null\"]},\n    \"wall_clock_s\": {\"type\": \"number\", \"minimum\": 0},\n    \"status\": {\"type\": \"string\", \"enum\": [\"pass\", \"returned\", \"failed\"]},\n    \"stop\": {\n      \"type\": [\"object\", \"null\"],\n      \"description\": \"Non-null exactly when status is not \\\"pass\\\" (issue #89): what class of stop this is and whose it is, derived by the record writer from the forge_checks and log it already has -- never a fresh read of anything.\",\n      \"additionalProperties\": false,\n      \"required\": [\"class\", \"provenance\", \"detail\"],\n      \"properties\": {\n        \"class\": {\n          \"type\": \"string\",\n          \"enum\": [\"non-question\", \"outlived-invocation\", \"no-cause\", \"forge-unconcluded\",\n                   \"ceiling\", \"claims-boundary\", \"repeated-act\", \"unclassed\", \"question\"]\n        },\n        \"provenance\": {\"type\": \"string\", \"enum\": [\"product\", \"tenant\", \"executor\", \"spec\"]},\n        \"detail\": {\n          \"type\": [\"string\", \"null\"],\n          \"description\": \"Populated for class \\\"unclassed\\\" (the log's last line, capped at 200 characters) and class \\\"question\\\" (the halt's own question, its first line only); null for every other class, whose evidence already lives in forge_checks or the log itself.\"\n        }\n      }\n    },\n    \"product_version\": {\"type\": \"string\", \"minLength\": 1},\n    \"product_pin\": {\"type\": [\"string\", \"null\"]}\n  }\n}\n","structuredPatch":[{"oldStart":111,"oldLines":7,"newStart":111,"newLines":8,"lines":["         \"class\": {","           \"type\": \"string\",","           \"enum\": [\"non-question\", \"outlived-invocation\", \"no-cause\", \"forge-unconcluded\",","-                   \"ceiling\", \"claims-boundary\", \"repeated-act\", \"unclassed\", \"question\"]","+                   \"ceiling\", \
cceptance row 2. A marker naming a dead pid on this\n    host, with no record beside it, is recovered as a failed record, stop\n    class died, provenance product, committed by the driver identity with\n    a clean tree -- the fixture #148 left behind by hand, done here by\n    the product instead.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_drive_stall_bound(root, 60)\n    bare = add_bare_remote(root, tmp_path)\n    approve_item(root)\n\n    dead = subprocess.Popen([sys.executable, \"-c\", \"pass\"])\n    dead.wait()\n    marker = records_dir(root) / \"build-01.started\"\n    marker.parent.mkdir(parents=True, exist_ok=True)\n    marker.write_text(json.dumps({\"at\": \"2026-09-17T13:16:08Z\", \"host\": socket.gethostname(),\n                                  \"pid\": dead.pid, \"sha\": head_of(root),\n                                  \"product_version\": \"fixture\"}))\n    commit_all(root, \"invocation marker for item 1\")\n    git(root, \"push\", \"origin\", \"HEAD:main\")\n\n    run = run_attavo(root, \"drive\", \"1\", \"--recover\")\n    assert run.returncode == 0, run.stdout + run.stderr\n\n    rec = latest_record(root, \"build\")\n    assert rec[\"status\"] == \"failed\"\n    assert rec[\"stop\"][\"class\"] == \"died\"\n    assert rec[\"stop\"][\"provenance\"] == \"product\"\n    assert \"wrote no build-01.json\" in rec[\"stop\"][\"detail\"]\n\n    assert (records_dir(root) / \"build-01.log\").is_file()\n    assert git(root, \"log\", \"-1\", \"--format=%an\").strip() == \"attavo driver\"\n    assert git(root, \"status\", \"--porcelain\").strip() == \"\"\n    assert remote_head(bare) == head_of(root)\n\n\ndef test_drive_recover_leaves_a_live_invocation_alone(tmp_path):\n    \"\"\"A marker naming this test process's own pid -- alive on this host\n    and well inside the stall bound -- is running, not died: recover\n    writes nothing.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_drive_stall_bound(root, 3600)\n    approve_item(root)\n\n    marker = records_dir(root) / \"build-01.started\"\n    marker.parent.mkdir(parents=True, exist_ok=True)\n    marker.write_text(json.dumps({\"at\": \"2026-09-17T13:16:08Z\", \"host\": socket.gethostname(),\n                                  \"pid\": os.getpid(), \"sha\": head_of(root),\n                                  \"product_version\": \"fixture\"}))\n    commit_all(root, \"invocation marker for a live pid\")\n\n    run = run_attavo(root, \"drive\", \"1\", \"--recover\")\n    assert run.returncode == 0, run.stdout + run.stderr\n    assert \"nothing to recover\" in run.stdout\n    assert record_files(root, \"build\") == []\n\n\ndef test_drive_forge_poll_defaults_are_a_real_forges_clock():"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0124yHyGzj74reaosovPowVZ","type":"tool_result","content":"The file /Users/davidbean/Projects/attavo-worktree-151/tests/test_drive.py has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"f081a203-e2ee-47b3-8bf8-5fc3aaeb804d","uuid":"37189e1e-a94c-4563-a5db-e2e9a357a7d7","timestamp":"2026-09-17T19:58:33.300Z","tool_use_result":{"filePath":"/Users/davidbean/Projects/attavo-worktree-151/tests/test_drive.py","oldString":"def test_drive_forge_poll_defaults_are_a_real_forges_clock():","newString":"def add_drive_stall_bound(root: Path, seconds: int) -> None:\n    toml = root / \"attavo.toml\"\n    toml.write_text(toml.read_text() + f\"\\n[drive]\\nstall_after_s = {seconds}\\n\")\n    commit_all(root, \"configure the drive stall bound\")\n\n\ndef test_drive_writes_and_pushes_an_invocation_marker_before_running_the_stage(tmp_path):\n    \"\"\"Issue #151. Before running build, drive writes a build-01.started\n    marker and commits and pushes it by itself -- the fact that this\n    invocation began is on the branch before the adapter ever runs, so a\n    process that dies mid-build still leaves it behind.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    bare = add_bare_remote(root, tmp_path)\n    approve_item(root)\n    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n\n    run = run_attavo(root, \"drive\", \"1\")\n    assert run.returncode == 0, run.stdout + run.stderr\n\n    marker_path = records_dir(root) / \"build-01.started\"\n    assert marker_path.is_file()\n    info = json.loads(marker_path.read_text())\n    assert info[\"pid\"] > 0 and info[\"host\"] and info[\"sha\"]\n\n    # The marker's own commit precedes the record's own commit; both\n    # reached the remote.\n    marker_commit = git(root, \"log\", \"-1\", \"--format=%H\",\n            
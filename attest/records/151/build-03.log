{"type":"assistant","message":{"model":"claude-sonnet-5","id":"msg_011Cf9aoCuPsJiaYhcmwLQs3","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_017e6VgRew5uB8mXSUSQuky9","name":"Read","input":{"file_path":"/Users/davidbean/Projects/attavo-worktree-151/tests/test_drive.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1200,"cache_read_input_tokens":104666,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1200},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"f081a203-e2ee-47b3-8bf8-5fc3aaeb804d","uuid":"06f00ee8-ad39-4c31-92ad-39bd7b377ebd","timestamp":"2026-09-17T19:43:37.660Z","request_id":"req_011Cf9aoBRLhG5vQp2PdDnwX","wire_tool_inputs":{"toolu_017e6VgRew5uB8mXSUSQuky9":{"file_path":"/Users/davidbean/Projects/attavo-worktree-151/tests/test_drive.py"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017e6VgRew5uB8mXSUSQuky9","type":"tool_result","content":"1\t\"\"\"attavo drive: the mechanical transitions between approval and\n2\tready-to-merge (issue #84) -- one step per invocation, and only that step,\n3\tuntil a state that belongs to a person. Every test uses the fixture\n4\tadapter and a fake `[forge].checks_command`; every record commit is\n5\t`git commit --only` and pushed to a real (bare) fixture remote.\n6\t\n7\tRegression tests, written and run red first: on `main` at 85f6f3b there\n8\twas no `drive` subcommand, so every one of these failed with \"unknown\n9\tsubcommand\".\n10\t\n11\tRun: python3 -m pytest tests -q\n12\t\"\"\"\n13\timport importlib.machinery\n14\timport importlib.util\n15\timport json\n16\timport os\n17\timport subprocess\n18\timport sys\n19\timport time\n20\tfrom pathlib import Path\n21\t\n22\tfrom helpers import commit_all, git, make_tenant\n23\t\n24\tROOT = Path(__file__).resolve().parent.parent\n25\tATTAVO = ROOT / \"bin\" / \"attavo\"\n26\t\n27\tGREEN_FORGE = \"printf 'ci success\\\\n'\"\n28\t# A concluded conclusion -- checked and failing, not something still\n29\t# running. Distinct from UNCONCLUDED_FORGE below (issue #84): drive polls\n30\t# the one still running for the bound, but stops on the first read of a\n31\t# check that has already concluded, whether or not it passed.\n32\tRED_FORGE = \"printf 'ci failure\\\\n'\"\n33\tUNCONCLUDED_FORGE = \"printf 'ci in_progress\\\\n'\"\n34\t\n35\t# The real defaults (ATTAVO_DRIVE_POLL_BOUND_S=600, _INTERVAL_S=20) are a\n36\t# real forge's clock, not a test's -- tenant zero's own checks conclude\n37\t# about five minutes after a push. Every `attavo drive` call here runs\n38\t# against this much shorter clock instead, read at call time from the\n39\t# same environment variables; test_drive_forge_poll_defaults_are_a_real_\n40\t# forges_clock is the one test that leaves them unset, to assert the\n41\t# defaults themselves. The interval is kept well above typical subprocess\n42\t# startup overhead so a zero-sleep stop and a polled one are easy to tell\n43\t# apart by wall clock alone.\n44\tFAST_POLL_ENV = {\"ATTAVO_DRIVE_POLL_BOUND_S\": \"0.9\", \"ATTAVO_DRIVE_POLL_INTERVAL_S\": \"0.5\"}\n45\t\n46\t\n47\tdef run_attavo(root: Path, *args: str, env: dict | None = None) -> subprocess.CompletedProcess:\n48\t    full_env = dict(os.environ)\n49\t    full_env.update(FAST_POLL_ENV)\n50\t    if env:\n51\t        full_env.update(env)\n52\t    return subprocess.run([sys.executable, str(ATTAVO), *args], cwd=str(root),\n53\t                          capture_output=True, text=True, check=False, env=full_env)\n54\t\n55\t\n56\tdef attavo_module():\n57\t    \"\"\"bin/attavo imported in-process, for the default-constant assertion\n58\t    below that a CLI invocation cannot provoke without actually waiting\n59\t    out the real clock.\"\"\"\n60\t    loader = importlib.machinery.SourceFileLoader(\"attavo_drive_under_test\", str(ATTAVO))\n61\t    spec = importlib.util.spec_from_loader(loader.name, loader)\n62\t    module = importlib.util.module_from_spec(spec)\n63\t    loader.exec_module(module)\n64\t    return module\n65\t\n66\t\n67\tdef add_forge(root: Path, checks_command: str) -> None:\n68\t    toml = root / \"attavo.toml\"\n69\t    toml.write_text(toml.read_text() + f'\\n[forge]\\nchecks_command = \"{checks_command}\"\\n')\n70\t    commit_all(root, \"configure the forge read\")\n71\t\n72\t\n73\tdef approve_item(root: Path, item: str = \"1\") -> None:\n74\t    assert run_attavo(root, \"spec-gate\", item).returncode == 0\n75\t    assert run_attavo(root, \"approve\", item, \"--by\", \"alice\").returncode == 0\n76\t\n77\t\n78\tdef add_bare_remote(root: Path, tmp_path: Path) -> Path:\n79\t    \"\"\"A real (bare) remote named origin, seeded with the tenant's current\n80\t    state -- drive's own push target, distinct from the fake\n81\t    refs/remotes/origin/* helpers.init_repo sets up purely for verify's\n82\t    diff base.\"\"\"\n83\t    bare = tmp_path / \"origin.git\"\n84\t    subprocess.run([\"git\", \"init\", \"--quiet\", \"--bare\", \"-b\", \"main\", str(bare)], check=True)\n85\t    git(root, \"remote\", \"add\", \"origin\", str(bare))\n86\t    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n87\t    git(root, \"push\", \"origin\", f\"HEAD:{branch}\")\n88\t    return bare\n89\t\n90\t\n91\tdef records_dir(root: Path, item: str = \"1\") -> Path:\n92\t    return root / \"records\" / item\n93\t\n94\t\n95\tdef record_files(root: Path, stage: str, item: str = \"1\") -> list[Path]:\n96\t    return sorted(records_dir(root, item).glob(f\"{stage}-*.json\"))\n97\t\n98\t\n99\tdef latest_record(root: Path, stage: str, item: str = \"1\") -> dict:\n100\t    files = record_files(root, stage, item)\n101\t    assert files, f\"no {stage} record for item {item}\"\n102\t    return json.loads(files[-1].read_text())\n103\t\n104\t\n105\tdef head_of(root: Path) -> str:\n106\t    return git(root, \"rev-parse\", \"HEAD\").strip()\n107\t\n108\t\n109\tdef last_commit_paths(root: Path) -> list[str]:\n110\t    return git(root, \"diff\", \"--name-only\", \"HEAD^\", \"HEAD\").splitlines()\n111\t\n112\t\n113\tdef remote_head(bare: Path, branch: str = \"main\") -> str:\n114\t    return subprocess.run([\"git\", \"-C\", str(bare), \"rev-parse\", branch],\n115\t                          capture_output=True, text=True, check=True).stdout.strip()\n116\t\n117\t\n118\tdef test_drive_refuses_without_a_valid_approval(tmp_path):\n119\t    \"\"\"Acceptance row 6. No approval at all: refused by name, nothing run\n120\t    -- no spec-gate, no build, no records of any kind written.\"\"\"\n121\t    root = make_tenant(tmp_path, \"build_valid\")\n122\t    add_forge(root, GREEN_FORGE)\n123\t    add_bare_remote(root, tmp_path)\n124\t\n125\t    run = run_attavo(root, \"drive\", \"1\")\n126\t    assert run.returncode != 0\n127\t    assert \"approval\" in run.stdout\n128\t    assert \"absent\" in run.stdout\n129\t\n130\t    assert not records_dir(root).exists() or list(records_dir(root).glob(\"*.json\")) == []\n131\t\n132\t\n133\tdef test_drive_refuses_with_an_expired_approval(tmp_path):\n134\t    \"\"\"Acceptance row 6, the other half: an approval bound to a spec sha\n135\t    that has since moved is expired, not absent -- still refused by name,\n136\t    nothing run.\"\"\"\n137\t    root = make_tenant(tmp_path, \"build_valid\")\n138\t    add_forge(root, GREEN_FORGE)\n139\t    add_bare_remote(root, tmp_path)\n140\t    approve_item(root)\n141\t\n142\t    (root / \"specs\" / \"1\" / \"spec.md\").write_text(\n143\t        (root / \"specs\" / \"1\" / \"spec.md\").read_text() + \"\\n\")\n144\t    commit_all(root, \"touch the spec after approval\")\n145\t\n146\t    run = run_attavo(root, \"drive\", \"1\")\n147\t    assert run.returncode != 0\n148\t    assert \"expired\" in run.stdout\n149\t    assert record_files(root, \"build\") == []\n150\t\n151\t\n152\tdef test_drive_builds_from_an_approved_spec_with_no_build(tmp_path):\n153\t    \"\"\"Acceptance row 1. One drive run produces a passing build record,\n154\t    commits only the record and its log (`git commit --only`), and pushes\n155\t    the branch; the fixture remote carries the record commit.\"\"\"\n156\t    root = make_tenant(tmp_path, \"build_valid\")\n157\t    add_forge(root, GREEN_FORGE)\n158\t    bare = add_bare_remote(root, tmp_path)\n159\t    approve_item(root)\n160\t    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n161\t\n162\t    run = run_attavo(root, \"drive\", \"1\")\n163\t    assert run.returncode == 0, run.stdout + run.stderr\n164\t\n165\t    rec = latest_record(root, \"build\")\n166\t    assert rec[\"status\"] == \"pass\"\n167\t\n168\t    record_path = record_files(root, \"build\")[-1]\n169\t    log_path = record_path.with_suffix(\".log\")\n170\t    assert log_path.exists()\n171\t\n172\t    touched = set(last_commit_paths(root))\n173\t    assert touched == {\n174\t        str(record_path.relative_to(root)),\n175\t        str(log_path.relative_to(root)),\n176\t    }\n177\t\n178\t    assert remote_head(bare, branch) == head_of(root)\n179\t\n180\t\n181\tdef test_drive_leaves_the_events_file_out_of_the_record_commit(tmp_path):\n182\t    \"\"\"Issue #26, acceptance row 2, strengthened by issue #140: attavo\n183\t    build always writes a stage's events file now (test_build.py's own\n184\t    row-1 tests), under the checkout's own git directory rather than\n185\t    the working tree -- so it is not merely excluded from the commit's\n186\t    file list, it is not even a path git tracks anything under. The\n187\t    commit's file list still names only the record and its log.\n188\t    \"\"\"\n189\t    root = make_tenant(tmp_path, \"build_valid\")\n190\t    add_forge(root, GREEN_FORGE)\n191\t    add_bare_remote(root, tmp_path)\n192\t    approve_item(root)\n193\t\n194\t    run = run_attavo(root, \"drive\", \"1\")\n195\t    assert run.returncode == 0, run.stdout + run.stderr\n196\t\n197\t    record_path = record_files(root, \"build\")[-1]\n198\t    git_dir = git(root, \"rev-parse\", \"--absolute-git-dir\").strip()\n199\t    events_path = Path(git_dir) / \"attavo\" / \"build-01.events.jsonl\"\n200\t    assert events_path.is_file()\n201\t\n202\t    touched = set(last_commit_paths(root))\n203\t    assert touched == {\n204\t        str(record_path.relative_to(root)),\n205\t        str(record_path.with_suffix(\".log\").relative_to(root)),\n206\t    }\n207\t\n208\t\n209\tdef test_drive_commits_the_record_as_the_driver_not_the_tenants_own_identity(tmp_path):\n210\t    \"\"\"The driver's identity (driver_identity, beside executor_identity):\n211\t    set by the product, never the tenant's git config, so a driven item's\n212\t    record commits are never indistinguishable from an operator's own.\n213\t    The fixture tenant's user.name is set to another value here, so a\n214\t    commit carrying it would prove commit_record fell back to the\n215\t    tenant's git config instead.\"\"\"\n216\t    root = make_tenant(tmp_path, \"build_valid\")\n217\t    git(root, \"config\", \"user.name\", \"Some Operator\")\n218\t    git(root, \"config\", \"user.email\", \"operator@example.com\")\n219\t    add_forge(root, GREEN_FORGE)\n220\t    add_bare_remote(root, tmp_path)\n221\t    approve_item(root)\n222\t\n223\t    run = run_attavo(root, \"drive\", \"1\")\n224\t    assert run.returncode == 0, run.stdout + run.stderr\n225\t\n226\t    author_name = git(root, \"log\", \"-1\", \"--format=%an\").strip()\n227\t    author_email = git(root, \"log\", \"-1\", \"--format=%ae\").strip()\n228\t    committer_name = git(root, \"log\", \"-1\", \"--format=%cn\").strip()\n229\t    committer_email = git(root, \"log\", \"-1\", \"--format=%ce\").strip()\n230\t\n231\t    assert author_name == \"attavo driver\"\n232\t    assert author_email == \"driver@attavo.invalid\"\n233\t    assert committer_name == \"attavo driver\"\n234\t    assert committer_email == \"driver@attavo.invalid\"\n235\t\n236\t\n237\tdef test_drive_verifies_from_a_passed_build_with_the_forge_green(tmp_path):\n238\t    \"\"\"Acceptance row 2. From a passed build with the fake forge green,\n239\t    one run produces a verify record, commits only the record and its log,\n240\t    and pushes.\"\"\"\n241\t    root = make_tenant(tmp_path, \"build_valid\")\n242\t    add_forge(root, GREEN_FORGE)\n243\t    bare = add_bare_remote(root, tmp_path)\n244\t    approve_item(root)\n245\t    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n246\t\n247\t    assert run_attavo(root, \"drive\", \"1\").returncode == 0  # builds\n248\t\n249\t    run = run_attavo(root, \"drive\", \"1\")\n250\t    assert run.returncode == 0, run.stdout + run.stderr\n251\t\n252\t    assert record_files(root, \"build\") and record_files(root, \"verify\")\n253\t    rec = latest_record(root, \"verify\")\n254\t    assert rec[\"status\"] == \"pass\"\n255\t\n256\t    record_path = record_files(root, \"verify\")[-1]\n257\t    log_path = record_path.with_suffix(\".log\")\n258\t    assert log_path.exists()\n259\t\n260\t    touched = set(last_commit_paths(root))\n261\t    assert touched == {\n262\t        str(record_path.relative_to(root)),\n263\t        str(log_path.relative_to(root)),\n264\t    }\n265\t\n266\t    assert remote_head(bare, branch) == head_of(root)\n267\t\n268\t\n269\tdef test_drive_verifies_again_when_the_latest_verify_is_superseded_by_a_later_build(tmp_path):\n270\t    \"\"\"Acceptance row 4, issue #109. A verify record can only name a build\n271\t    that existed when it was written, so a later build makes the latest\n272\t    verify superseded, never a mismatch -- drive derives the next stage\n273\t    as verify, not build, and never refuses.\n274\t\n275\t    Regression: on main before this lane, drive_state's own inline\n276\t    staleness check already treats this as 'verify', so this test does\n277\t    not fail against current code -- it is here to lock the behavior\n278\t    check_attest_chain's fix must not disturb (the acceptance table's\n279\t    'never refuses' row).\"\"\"\n280\t    root = make_tenant(tmp_path, \"build_valid\")\n281\t    add_forge(root, GREEN_FORGE)\n282\t    add_bare_remote(root, tmp_path)\n283\t    approve_item(root)\n284\t\n285\t    assert run_attavo(root, \"drive\", \"1\").returncode == 0  # builds\n286\t    assert run_attavo(root, \"drive\", \"1\").returncode == 0  # verifies\n287\t\n288\t    # A second build record, minted by hand -- a real re-run of the\n289\t    # fixture adapter is not idempotent against its own tree -- naming a\n290\t    # sha the existing verify-01 does not: verify-01 is now superseded.\n291\t    build_01 = json.loads(record_files(root, \"build\")[-1].read_text())\n292\t    build_01[\"sha\"] = \"f\" * 40\n293\t    (records_dir(root) / \"build-02.json\").write_text(json.dumps(build_01))\n294\t    commit_all(root, \"attavo: second build record for #1, minted by hand\")\n295\t\n296\t    run = run_attavo(root, \"drive\", \"1\")\n297\t    assert run.returncode == 0, run.stdout + run.stderr\n298\t    assert len(record_files(root, \"build\")) == 2\n299\t    assert len(record_files(root, \"verify\")) == 2\n300\t    rec = latest_record(root, \"verify\")\n301\t    assert rec[\"status\"] == \"pass\"\n302\t    assert rec[\"build_sha\"] == build_01[\"sha\"]\n303\t\n304\t\n305\tdef test_drive_prints_ready_to_merge_from_a_passed_verify(tmp_path):\n306\t    \"\"\"Acceptance row 3. From a passed verify with the forge green, one\n307\t    run prints ready-to-merge, exits 0, writes nothing, enqueues nothing\n308\t    -- and, per row 8, a further run repeats exactly the same thing.\"\"\"\n309\t    root = make_tenant(tmp_path, \"build_valid\")\n310\t    add_forge(root, GREEN_FORGE)\n311\t    add_bare_remote(root, tmp_path)\n312\t    approve_item(root)\n313\t\n314\t    assert run_attavo(root, \"drive\", \"1\").returncode == 0  # builds\n315\t    assert run_attavo(root, \"drive\", \"1\").returncode == 0  # verifies\n316\t\n317\t    pre_head = head_of(root)\n318\t    run = run_attavo(root, \"drive\", \"1\")\n319\t    assert run.returncode == 0, run.stdout + run.stderr\n320\t    assert \"ready to merge\" in run.stdout\n321\t    assert head_of(root) == pre_head\n322\t    assert record_files(root, \"verify\") and len(record_files(root, \"verify\")) == 1\n323\t\n324\t    # Acceptance row 8: idempotence -- run it again, same result, nothing\n325\t    # new written or pushed.\n326\t    run2 = run_attavo(root, \"drive\", \"1\")\n327\t    assert run2.returncode == 0\n328\t    assert \"ready to merge\" in run2.stdout\n329\t    assert head_of(root) == pre_head\n330\t    assert len(record_files(root, \"verify\")) == 1\n331\t    assert len(record_files(root, \"build\")) == 1\n332\t\n333\t\n334\tdef test_drive_until_ready_runs_build_then_verify_to_ready_in_one_call(tmp_path):\n335\t    \"\"\"Issue #100's own followups. --until-ready repeats step-and-wait in\n336\t    the same process: one call, from an approved item with the forge\n337\t    green, builds, verifies, and prints ready to merge -- both records\n338\t    written and pushed, without the caller invoking drive again after\n339\t    each passing step.\"\"\"\n340\t    root = make_tenant(tmp_path, \"build_valid\")\n341\t    add_forge(root, GREEN_FORGE)\n342\t    bare = add_bare_remote(root, tmp_path)\n343\t    approve_item(root)\n344\t    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n345\t\n346\t    run = run_attavo(root, \"drive\", \"1\", \"--until-ready\")\n347\t    assert run.returncode == 0, run.stdout + run.stderr\n348\t    assert \"ready to merge\" in run.stdout\n349\t\n350\t    assert len(record_files(root, \"build\")) == 1\n351\t    assert len(record_files(root, \"verify\")) == 1\n352\t    assert latest_record(root, \"build\")[\"status\"] == \"pass\"\n353\t    assert latest_record(root, \"verify\")[\"status\"] == \"pass\"\n354\t    assert remote_head(bare, branch) == head_of(root)\n355\t\n356\t    # Idempotence, same as the single-step form: a further --until-ready\n357\t    # call repeats exactly the same ready-to-merge result, writing nothing.\n358\t    run2 = run_attavo(root, \"drive\", \"1\", \"--until-ready\")\n359\t    assert run2.returncode == 0\n360\t    assert \"ready to merge\" in run2.stdout\n361\t    assert len(record_files(root, \"build\")) == 1\n362\t    assert len(record_files(root, \"verify\")) == 1\n363\t\n364\t\n365\tdef test_drive_without_the_flag_still_takes_one_step_at_a_time(tmp_path):\n366\t    \"\"\"Regression: --until-ready is additive. With no flag, an approved\n367\t    item with the forge green still needs two separate calls -- build,\n368\t    then verify -- exactly as before this issue.\"\"\"\n369\t    root = make_tenant(tmp_path, \"build_valid\")\n370\t    add_forge(root, GREEN_FORGE)\n371\t    add_bare_remote(root, tmp_path)\n372\t    approve_item(root)\n373\t\n374\t    run = run_attavo(root, \"drive\", \"1\")\n375\t    assert run.returncode == 0\n376\t    assert record_files(root, \"build\") and not record_files(root, \"verify\")\n377\t\n378\t    run2 = run_attavo(root, \"drive\", \"1\")\n379\t    assert run2.returncode == 0\n380\t    assert record_files(root, \"verify\")\n381\t\n382\t\n383\tdef test_drive_until_ready_stops_on_a_halt(tmp_path):\n384\t    \"\"\"A step that stops on its own account -- here, a halted build --\n385\t    stops the --until-ready loop exactly where the single-step form\n386\t    would, printing the same thing; it does not retry the halted step.\"\"\"\n387\t    root = make_tenant(tmp_path, \"build_valid\")\n388\t    add_forge(root, GREEN_FORGE)\n389\t    bare = add_bare_remote(root, tmp_path)\n390\t    approve_item(root)\n391\t    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n392\t\n393\t    run = run_attavo(root, \"drive\", \"1\", \"--until-ready\",\n394\t                     env={\"ATTAVO_FIXTURE_QUESTION\": \"which overlay wins?\"})\n395\t    assert run.returncode == 3\n396\t    assert \"which overlay wins?\" in run.stdout\n397\t\n398\t    assert len(record_files(root, \"build\")) == 1\n399\t    assert latest_record(root, \"build\")[\"status\"] == \"halted\"\n400\t    assert record_files(root, \"verify\") == []\n401\t    assert remote_head(bare, branch) == head_of(root)\n402\t\n403\t\n404\tdef test_drive_until_ready_stops_when_the_forge_goes_red_after_a_build(tmp_path):\n405\t    \"\"\"A build that passes, then a forge that concludes red for verify's\n406\t    own gate, stops the loop there -- one record written (the pass), no\n407\t    verify record, no retry of the forge read.\"\"\"\n408\t    root = make_tenant(tmp_path, \"build_valid\")\n409\t    add_forge(root, RED_FORGE)\n410\t    add_bare_remote(root, tmp_path)\n411\t    approve_item(root)\n412\t\n413\t    run = run_attavo(root, \"drive\", \"1\", \"--until-ready\")\n414\t    assert run.returncode != 0\n415\t    assert \"ci\" in run.stdout and \"failure\" in run.stdout\n416\t\n417\t    assert len(record_files(root, \"build\")) == 1\n418\t    assert latest_record(root, \"build\")[\"status\"] == \"pass\"\n419\t    assert record_files(root, \"verify\") == []\n420\t\n421\t\n422\tdef test_drive_stops_when_the_forge_is_red(tmp_path):\n423\t    \"\"\"Acceptance row 4. A forge read where the one check has already\n424\t    concluded and failed is not polled at all -- there is nothing left to\n425\t    wait on, so drive stops on the first read, naming the check, with no\n426\t    sleep in between. Writes nothing -- no verify record at all, no new\n427\t    commit.\"\"\"\n428\t    root = make_tenant(tmp_path, \"build_valid\")\n429\t    add_forge(root, RED_FORGE)\n430\t    add_bare_remote(root, tmp_path)\n431\t    approve_item(root)\n432\t\n433\t    assert run_attavo(root, \"drive\", \"1\").returncode == 0  # builds\n434\t    pre_head = head_of(root)\n435\t\n436\t    started = time.monotonic()\n437\t    run = run_attavo(root, \"drive\", \"1\")\n438\t    elapsed = time.monotonic() - started\n439\t    assert run.returncode != 0\n440\t    assert \"ci\" in run.stdout and \"failure\" in run.stdout\n441\t    assert elapsed < 0.4, (\n442\t        f\"a concluded, red forge check should stop on the first read with no \"\n443\t        f\"poll interval slept -- took {elapsed:.2f}s\")\n444\t\n445\t    assert record_files(root, \"verify\") == []\n446\t    assert head_of(root) == pre_head\n447\t\n448\t    # Idempotence (row 8): running again in the same red state stops the\n449\t    # same way, still nothing written.\n450\t    run2 = run_attavo(root, \"drive\", \"1\")\n451\t    assert run2.returncode != 0\n452\t    assert record_files(root, \"verify\") == []\n453\t    assert head_of(root) == pre_head\n454\t\n455\t\n456\tdef test_drive_polls_the_bound_while_the_forge_is_still_running(tmp_path):\n457\t    \"\"\"Acceptance row 4, the unconcluded case: a check still carrying a\n458\t    status (in_progress) rather than a conclusion is not yet red -- drive\n459\t    keeps polling it for the full bound before giving up, unlike a\n460\t    concluded red check, which it does not poll at all. Writes nothing.\"\"\"\n461\t    root = make_tenant(tmp_path, \"build_valid\")\n462\t    add_forge(root, UNCONCLUDED_FORGE)\n463\t    add_bare_remote(root, tmp_path)\n464\t    approve_item(root)\n465\t\n466\t    assert run_attavo(root, \"drive\", \"1\").returncode == 0  # builds\n467\t\n468\t    started = time.monotonic()\n469\t    run = run_attavo(root, \"drive\", \"1\")\n470\t    elapsed = time.monotonic() - started\n471\t    assert run.returncode != 0\n472\t    assert \"ci\" in run.stdout and \"in_progress\" in run.stdout\n473\t    assert elapsed >= 0.4, (\n474\t        f\"a check still in_progress should be polled for the bound, not \"\n475\t        f\"stopped on the first read -- took only {elapsed:.2f}s\")\n476\t\n477\t    assert record_files(root, \"verify\") == []\n478\t\n479\t\n480\tdef test_drive_halts_on_a_question_and_resumes_at_build_after_a_ruling(tmp_path):\n481\t    \"\"\"Acceptance row 5. The fixture adapter halts with a question: drive\n482\t    stops naming the question and the record (and still pushes that\n483\t    halted record, same as any other record build writes). After a\n484\t    ruling is appended, a second run resumes at build and this time\n485\t    passes.\"\"\"\n486\t    root = make_tenant(tmp_path, \"build_valid\")\n487\t    add_forge(root, GREEN_FORGE)\n488\t    bare = add_bare_remote(root, tmp_path)\n489\t    approve_item(root)\n490\t    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n491\t\n492\t    run = run_attavo(root, \"drive\", \"1\",\n493\t                     env={\"ATTAVO_FIXTURE_QUESTION\": \"which overlay wins?\"})\n494\t    assert run.returncode == 3\n495\t    assert \"which overlay wins?\" in run.stdout\n496\t\n497\t    rec = latest_record(root, \"build\")\n498\t    assert rec[\"status\"] == \"halted\"\n499\t    assert rec[\"halted\"] == {\"question\": \"which overlay wins?\"}\n500\t    record_path = record_files(root, \"build\")[-1]\n501\t    assert record_path.name in run.stdout\n502\t\n503\t    # The halted record was still committed and pushed.\n504\t    assert remote_head(bare, branch) == head_of(root)\n505\t\n506\t    rulings = root / \"rulings.md\"\n507\t    rulings.write_text(rulings.read_text() + \"\\n- overlay: use the base tree\\n\"\n508\t                       if rulings.exists() else \"- overlay: use the base tree\\n\")\n509\t    commit_all(root, \"rule on the overlay question\")\n510\t    git(root, \"push\", \"origin\", f\"HEAD:{branch}\")\n511\t\n512\t    run2 = run_attavo(root, \"drive\", \"1\")\n513\t    assert run2.returncode == 0, run2.stdout + run2.stderr\n514\t\n515\t    assert len(record_files(root, \"build\")) == 2\n516\t    rec2 = latest_record(root, \"build\")\n517\t    assert rec2[\"status\"] == \"pass\"\n518\t    assert remote_head(bare, branch) == head_of(root)\n519\t\n520\t\n521\tdef configure_counsel(root: Path) -> None:\n522\t    \"\"\"[executor].counsel = \"fixture\" -- build_valid's own manifest\n523\t    declares [executor].build = \"fixture\" only; counsel needs its own\n524\t    adapter named (issue #100).\"\"\"\n525\t    toml = root / \"attavo.toml\"\n526\t    toml.write_text(toml.read_text().replace(\n527\t        '[executor]\\nbuild = \"fixture\"', '[executor]\\nbuild = \"fixture\"\\ncounsel = \"fixture\"'))\n528\t    commit_all(root, \"configure the counsel adapter\")\n529\t\n530\t\n531\tdef test_drive_counsels_a_stop_before_filing_it_and_commits_both_records_together(tmp_path):\n532\t    \"\"\"Issue #100, acceptance row 3. On a stop, drive calls counsel\n533\t    before file-stops, and commits the counsel record with the stage\n534\t    record in one commit.\"\"\"\n535\t    root = make_tenant(tmp_path, \"build_valid\")\n536\t    add_forge(root, GREEN_FORGE)\n537\t    bare = add_bare_remote(root, tmp_path)\n538\t    configure_counsel(root)\n539\t    approve_item(root)\n540\t    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n541\t    filed = tmp_path / \"filed.jsonl\"\n542\t    configure_filing(root, filed)\n543\t\n544\t    run = run_attavo(root, \"drive\", \"1\",\n545\t                     env={\"ATTAVO_FIXTURE_QUESTION\": \"which overlay wins?\"})\n546\t    assert run.returncode == 3\n547\t\n548\t    assert record_files(root, \"counsel\")\n549\t    counsel_rec = latest_record(root, \"counsel\")\n550\t    assert counsel_rec[\"record_stage\"] == \"build\"\n551\t    assert counsel_rec[\"record\"] == \"build-01\"\n552\t    assert counsel_rec[\"verdict\"] == \"person\"\n553\t\n554\t    committed = set(last_commit_paths(root))\n555\t    assert committed == {\n556\t        \"records/1/build-01.json\", \"records/1/build-01.log\",\n557\t        \"records/1/counsel-01.json\", \"records/1/counsel-01.log\",\n558\t        \"records/1/build-01.filed\",\n559\t    }\n560\t    assert remote_head(bare, branch) == head_of(root)\n561\t\n562\t    filed_bodies = [json.loads(l) for l in filed.read_text().splitlines() if l.strip()]\n563\t    assert len(filed_bodies) == 1\n564\t    assert filed_bodies[0][\"counsel_verdict\"] == \"person\"\n565\t    assert filed_bodies[0][\"counsel_proposal\"][\"question\"]\n566\t\n567\t\n568\tdef test_drive_still_files_a_stop_with_no_counsel_adapter_configured(tmp_path):\n569\t    \"\"\"counsel refuses gracefully (no [executor].counsel or\n570\t    [executor].verify) -- drive still files and transports the stage\n571\t    record; nothing new for counsel to commit.\"\"\"\n572\t    root = make_tenant(tmp_path, \"build_valid\")\n573\t    add_forge(root, GREEN_FORGE)\n574\t    bare = add_bare_remote(root, tmp_path)\n575\t    approve_item(root)\n576\t    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n577\t    filed = tmp_path / \"filed.jsonl\"\n578\t    configure_filing(root, filed)\n579\t\n580\t    run = run_attavo(root, \"drive\", \"1\",\n581\t                     env={\"ATTAVO_FIXTURE_QUESTION\": \"which overlay wins?\"})\n582\t    assert run.returncode == 3\n583\t\n584\t    assert record_files(root, \"counsel\") == []\n585\t    committed = set(last_commit_paths(root))\n586\t    assert committed == {\"records/1/build-01.json\", \"records/1/build-01.log\",\n587\t                         \"records/1/build-01.filed\"}\n588\t    assert remote_head(bare, branch) == head_of(root)\n589\t\n590\t\n591\tdef configure_filing(root: Path, filed_path: Path) -> None:\n592\t    \"\"\"Appended under the [forge] table add_forge already opened -- a\n593\t    second [forge] header in the same file is a TOML redeclaration\n594\t    error. Prints a fake issue URL on stdout, numbered by filed_path's\n595\t    own line count so far -- the fact a real file_issue_command's stdout\n596\t    would carry, and what the .filed marker beside each stop record is\n597\t    meant to hold (issue #89).\"\"\"\n598\t    toml = root / \"attavo.toml\"\n599\t    command = (f\"n=$(wc -l < {filed_path} 2>/dev/null || echo 0); \"\n600\t              f\"cat >> {filed_path}; \"\n601\t              f\"echo https://github.com/tenant/repo/issues/$((n + 1))\")\n602\t    toml.write_text(toml.read_text() + f\"\\nfile_issue_command = '{command}'\\n\")\n603\t    commit_all(root, \"configure issue filing\")\n604\t\n605\t\n606\tdef test_drive_files_a_stop_it_reports_exactly_once(tmp_path):\n607\t    \"\"\"Issue #89, acceptance row 5. A stop drive reports -- here, the\n608\t    fixture adapter's halt -- calls file-stops once: one drive run files\n609\t    exactly one issue for the attempt it just wrote, not zero and not\n610\t    more than one.\"\"\"\n611\t    root = make_tenant(tmp_path, \"build_valid\")\n612\t    add_forge(root, GREEN_FORGE)\n613\t    add_bare_remote(root, tmp_path)\n614\t    approve_item(root)\n615\t    filed = tmp_path / \"filed.jsonl\"\n616\t    configure_filing(root, filed)\n617\t\n618\t    run = run_attavo(root, \"drive\", \"1\",\n619\t                     env={\"ATTAVO_FIXTURE_QUESTION\": \"which overlay wins?\"})\n620\t    assert run.returncode == 3\n621\t\n622\t    filed_bodies = [json.loads(l) for l in filed.read_text().splitlines() if l.strip()]\n623\t    assert len(filed_bodies) == 1\n624\t    assert filed_bodies[0][\"record\"] == \"records/1/build-01.json\"\n625\t\n626\t    # A second drive run halts again -- a new attempt, build-02 -- and\n627\t    # files exactly one more issue for that new record; file-stops' own\n628\t    # .filed marker means build-01's issue is never filed twice.\n629\t    run2 = run_attavo(root, \"drive\", \"1\",\n630\t                      env={\"ATTAVO_FIXTURE_QUESTION\": \"which overlay wins?\"})\n631\t    assert run2.returncode == 3\n632\t    assert len(record_files(root, \"build\")) == 2\n633\t\n634\t    filed_bodies_after = [json.loads(l) for l in filed.read_text().splitlines() if l.strip()]\n635\t    assert len(filed_bodies_after) == 2\n636\t    assert filed_bodies_after[0] == filed_bodies[0]\n637\t    assert filed_bodies_after[1][\"record\"] == \"records/1/build-02.json\"\n638\t\n639\t\n640\tdef test_drive_marker_holds_the_filing_commands_stdout_and_is_committed_with_the_record(tmp_path):\n641\t    \"\"\"A stop's own .filed marker is written before the record is\n642\t    transported, so it carries the filing command's stdout (the issue it\n643\t    opened) and rides in the very same commit as the record and its log\n644\t    -- one commit, one push, as before this fix. Red before it: the\n645\t    marker was written empty, after commit_record and push_record_commit\n646\t    had already run, so it was never part of any commit at all.\n647\t    \"\"\"\n648\t    root = make_tenant(tmp_path, \"build_valid\")\n649\t    add_forge(root, GREEN_FORGE)\n650\t    bare = add_bare_remote(root, tmp_path)\n651\t    approve_item(root)\n652\t    filed = tmp_path / \"filed.jsonl\"\n653\t    configure_filing(root, filed)\n654\t\n655\t    run = run_attavo(root, \"drive\", \"1\",\n656\t                     env={\"ATTAVO_FIXTURE_QUESTION\": \"which overlay wins?\"})\n657\t    assert run.returncode == 3\n658\t\n659\t    marker_path = records_dir(root) / \"build-01.filed\"\n660\t    assert marker_path.is_file()\n661\t    assert marker_path.read_text().strip() == \"https://github.com/tenant/repo/issues/1\"\n662\t\n663\t    committed = set(last_commit_paths(root))\n664\t    assert committed == {\"records/1/build-01.json\", \"records/1/build-01.log\",\n665\t                         \"records/1/build-01.filed\"}\n666\t    assert remote_head(bare) == head_of(root)\n667\t\n668\t\n669\tdef test_drive_a_second_run_in_the_same_state_files_nothing(tmp_path):\n670\t    \"\"\"Issue #89. The marker committed and pushed above is the fact a\n671\t    second worktree or a fresh clone reads too -- a second drive run\n672\t    against the same records, from a fresh clone of the remote drive\n673\t    already pushed to, files nothing for the stop that clone already\n674\t    carries a marker for. Red before this fix: the marker never reached\n675\t    the remote at all, so every clone refiled every stop it found.\n676\t    \"\"\"\n677\t    root = make_tenant(tmp_path, \"build_valid\")\n678\t    add_forge(root, GREEN_FORGE)\n679\t    bare = add_bare_remote(root, tmp_path)\n680\t    approve_item(root)\n681\t    filed = tmp_path / \"filed.jsonl\"\n682\t    configure_filing(root, filed)\n683\t\n684\t    run = run_attavo(root, \"drive\", \"1\",\n685\t                     env={\"ATTAVO_FIXTURE_QUESTION\": \"which overlay wins?\"})\n686\t    assert run.returncode == 3\n687\t    filed_after_first = filed.read_text()\n688\t    assert filed_after_first.strip() != \"\"\n689\t\n690\t    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n691\t    clone = tmp_path / \"fresh-clone\"\n692\t    subprocess.run([\"git\", \"clone\", \"--quiet\", \"--branch\", branch, str(bare), str(clone)],\n693\t                   check=True)\n694\t\n695\t    run2 = run_attavo(clone, \"file-stops\", \"1\")\n696\t    assert run2.returncode == 0\n697\t    assert \"no stops to file\" in run2.stdout\n698\t    assert filed.read_text() == filed_after_first  # nothing new was filed\n699\t\n700\t\n701\tdef test_drive_retries_a_rejected_push_with_a_merge_never_a_rebase(tmp_path):\n702\t    \"\"\"Acceptance row 7. A rejected push with a divergent remote is\n703\t    retried after `git pull --no-rebase --no-edit`, never a rebase; the\n704\t    build record's own sha is unchanged (still reachable, still what the\n705\t    record names), and the retry lands a merge commit, not a rewritten\n706\t    one.\"\"\"\n707\t    root = make_tenant(tmp_path, \"build_valid\")\n708\t    add_forge(root, GREEN_FORGE)\n709\t    bare = add_bare_remote(root, tmp_path)\n710\t    approve_item(root)\n711\t    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n712\t\n713\t    # Diverge the bare remote: another clone pushes an unrelated commit to\n714\t    # the same branch before drive's own push happens.\n715\t    other = tmp_path / \"other-clone\"\n716\t    subprocess.run([\"git\", \"clone\", \"--quiet\", str(bare), str(other)], check=True)\n717\t    subprocess.run([\"git\", \"-C\", str(other), \"checkout\", \"-q\", branch], check=True)\n718\t    subprocess.run([\"git\", \"-C\", str(other), \"config\", \"user.email\", \"other@example.com\"],\n719\t                   check=True)\n720\t    subprocess.run([\"git\", \"-C\", str(other), \"config\", \"user.name\", \"Other\"], check=True)\n721\t    (other / \"concurrent.txt\").write_text(\"from elsewhere\\n\")\n722\t    subprocess.run([\"git\", \"-C\", str(other), \"add\", \"-A\"], check=True)\n723\t    subprocess.run([\"git\", \"-C\", str(other), \"commit\", \"-q\", \"-m\", \"a concurrent commit\"],\n724\t                   check=True)\n725\t    subprocess.run([\"git\", \"-C\", str(other), \"push\", \"origin\", f\"HEAD:{branch}\"], check=True)\n726\t\n727\t    run = run_attavo(root, \"drive\", \"1\")\n728\t    assert run.returncode == 0, run.stdout + run.stderr\n729\t\n730\t    rec = latest_record(root, \"build\")\n731\t    assert rec[\"status\"] == \"pass\"\n732\t    build_sha = rec[\"sha\"]\n733\t\n734\t    # The build's own commit sha is still reachable -- a merge, not a\n735\t    # rebase, which would have rewritten it under a new sha.\n736\t    assert build_sha in git(root, \"rev-list\", \"HEAD\").split()\n737\t\n738\t    merge_parents = git(root, \"log\", \"-1\", \"--format=%P\", \"HEAD\").split()\n739\t    assert len(merge_parents) == 2, \"the retry should have landed a merge commit\"\n740\t\n741\t    assert remote_head(bare, branch) == head_of(root)\n742\t    # the concurrent commit from the other clone is present too\n743\t    assert \"concurrent.txt\" in git(root, \"ls-tree\", \"-r\", \"--name-only\", \"HEAD\")\n744\t\n745\t\n746\tdef test_drive_forge_poll_defaults_are_a_real_forges_clock():\n747\t    \"\"\"The bound and interval every other test overrides with\n748\t    FAST_POLL_ENV default, unset, to at least five minutes and ten\n749\t    seconds -- tenant zero's own checks conclude about five minutes after\n750\t    a push, and a bound shorter than that would make every drive run\n751\t    after a record push stop on 'forge checks not green', with a person\n752\t    running it again after CI: exactly the transport act this lane\n753\t    retires. Row 4 (a forge that never goes green) is unchanged in\n754\t    meaning by this -- it still stops, just after waiting out a real\n755\t    forge's own clock instead of a test's fake one.\n756\t    \"\"\"\n757\t    module = attavo_module()\n758\t    assert module.DRIVE_FORGE_POLL_BOUND_DEFAULT_S >= 300\n759\t    assert module.DRIVE_FORGE_POLL_INTERVAL_DEFAULT_S >= 10\n760\t"}]},"parent_tool_use_id":null,"session_id":"f081a203-e2ee-47b3-8bf8-5fc3aaeb804d","uuid":"20e043a6-4a11-4d3e-ab1a-5a03607688ac","timestamp":"2026-09-17T19:43:37.823Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-151/tests/test_drive.py","content":"\"\"\"attavo drive: the mechanical transitions between approval and\nready-to-merge (issue #84) -- one step per invocation, and only that step,\nuntil a state that belongs to a person. Every test uses the fixture\nadapter and a fake `[forge].checks_command`; every record commit is\n`git commit --only` and pushed to a real (bare) fixture remote.\n\nRegression tests, written and run red first: on `main` at 85f6f3b there\nwas no `drive` subcommand, so every one of these failed with \"unknown\nsubcommand\".\n\nRun: python3 -m pytest tests -q\n\"\"\"\nimport importlib.machinery\nimport importlib.util\nimport json\nimport os\nimport subprocess\nimport sys\nimport time\nfrom pathlib import Path\n\nfrom helpers import commit_all, git, make_tenant\n\nROOT = Path(__file__).resolve().parent.parent\nATTAVO = ROOT / \"bin\" / \"attavo\"\n\nGREEN_FORGE = \"printf 'ci success\\\\n'\"\n# A concluded conclusion -- checked and failing, not something still\n# running. Distinct from UNCONCLUDED_FORGE below (issue #84): drive polls\n# the one still running for the bound, but stops on the first read of a\n# check that has already concluded, whether or not it passed.\nRED_FORGE = \"printf 'ci failure\\\\n'\"\nUNCONCLUDED_FORGE = \"printf 'ci in_progress\\\\n'\"\n\n# The real defaults (ATTAVO_DRIVE_POLL_BOUND_S=600, _INTERVAL_S=20) are a\n# real forge's clock, not a test's -- tenant zero's own checks conclude\n# about five minutes after a push. Every `attavo drive` call here runs\n# against this much shorter clock instead, read at call time from the\n# same environment variables; test_drive_forge_poll_defaults_are_a_real_\n# forges_clock is the one test that leaves them unset, to assert the\n# defaults themselves. The interval is kept well above typical subprocess\n# startup overhead so a zero-sleep stop and a polled one are easy to tell\n# apart by wall clock alone.\nFAST_POLL_ENV = {\"ATTAVO_DRIVE_POLL_BOUND_S\": \"0.9\", \"ATTAVO_DRIVE_POLL_INTERVAL_S\": \"0.5\"}\n\n\ndef run_attavo(root: Path, *args: str, env: dict | None = None) -> subprocess.CompletedProcess:\n    full_env = dict(os.environ)\n    full_env.update(FAST_POLL_ENV)\n    if env:\n        full_env.update(env)\n    return subprocess.run([sys.executable, str(ATTAVO), *args], cwd=str(root),\n                          capture_output=True, text=True, check=False, env=full_env)\n\n\ndef attavo_module():\n    \"\"\"bin/attavo imported in-process, for the default-constant assertion\n    below that a CLI invocation cannot provoke without actually waiting\n    out the real clock.\"\"\"\n    loader = importlib.machinery.SourceFileLoader(\"attavo_drive_under_test\", str(ATTAVO))\n    spec = importlib.util.spec_from_loader(loader.name, loader)\n    module = importlib.util.module_from_spec(spec)\n    loader.exec_module(module)\n    return module\n\n\ndef add_forge(root: Path, checks_command: str) -> None:\n    toml = root / \"attavo.toml\"\n    toml.write_text(toml.read_text() + f'\\n[forge]\\nchecks_command = \"{checks_command}\"\\n')\n    commit_all(root, \"configure the forge read\")\n\n\ndef approve_item(root: Path, item: str = \"1\") -> None:\n    assert run_attavo(root, \"spec-gate\", item).returncode == 0\n    assert run_attavo(root, \"approve\", item, \"--by\", \"alice\").returncode == 0\n\n\ndef add_bare_remote(root: Path, tmp_path: Path) -> Path:\n    \"\"\"A real (bare) remote named origin, seeded with the tenant's current\n    state -- drive's own push target, distinct from the fake\n    refs/remotes/origin/* helpers.init_repo sets up purely for verify's\n    diff base.\"\"\"\n    bare = tmp_path / \"origin.git\"\n    subprocess.run([\"git\", \"init\", \"--quiet\", \"--bare\", \"-b\", \"main\", str(bare)], check=True)\n    git(root, \"remote\", \"add\", \"origin\", str(bare))\n    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n    git(root, \"push\", \"origin\", f\"HEAD:{branch}\")\n    return bare\n\n\ndef records_dir(root: Path, item: str = \"1\") -> Path:\n    return root / \"records\" / item\n\n\ndef record_files(root: Path, stage: str, item: str = \"1\") -> list[Path]:\n    return sorted(records_dir(root, item).glob(f\"{stage}-*.json\"))\n\n\ndef latest_record(root: Path, stage: str, item: str = \"1\") -> dict:\n    files = record_files(root, stage, item)\n    assert files, f\"no {stage} record for item {item}\"\n    return json.loads(files[-1].read_text())\n\n\ndef head_of(root: Path) -> str:\n    return git(root, \"rev-parse\", \"HEAD\").strip()\n\n\ndef last_commit_paths(root: Path) -> list[str]:\n    return git(root, \"diff\", \"--name-only\", \"HEAD^\", \"HEAD\").splitlines()\n\n\ndef remote_head(bare: Path, branch: str = \"main\") -> str:\n    return subprocess.run([\"git\", \"-C\", str(bare), \"rev-parse\", branch],\n                          capture_output=True, text=True, check=True).stdout.strip()\n\n\ndef test_drive_refuses_without_a_valid_approval(tmp_path):\n    \"\"\"Acceptance row 6. No approval at all: refused by name, nothing run\n    -- no spec-gate, no build, no records of any kind written.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    add_bare_remote(root, tmp_path)\n\n    run = run_attavo(root, \"drive\", \"1\")\n    assert run.returncode != 0\n    assert \"approval\" in run.stdout\n    assert \"absent\" in run.stdout\n\n    assert not records_dir(root).exists() or list(records_dir(root).glob(\"*.json\")) == []\n\n\ndef test_drive_refuses_with_an_expired_approval(tmp_path):\n    \"\"\"Acceptance row 6, the other half: an approval bound to a spec sha\n    that has since moved is expired, not absent -- still refused by name,\n    nothing run.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    add_bare_remote(root, tmp_path)\n    approve_item(root)\n\n    (root / \"specs\" / \"1\" / \"spec.md\").write_text(\n        (root / \"specs\" / \"1\" / \"spec.md\").read_text() + \"\\n\")\n    commit_all(root, \"touch the spec after approval\")\n\n    run = run_attavo(root, \"drive\", \"1\")\n    assert run.returncode != 0\n    assert \"expired\" in run.stdout\n    assert record_files(root, \"build\") == []\n\n\ndef test_drive_builds_from_an_approved_spec_with_no_build(tmp_path):\n    \"\"\"Acceptance row 1. One drive run produces a passing build record,\n    commits only the record and its log (`git commit --only`), and pushes\n    the branch; the fixture remote carries the record commit.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    bare = add_bare_remote(root, tmp_path)\n    approve_item(root)\n    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n\n    run = run_attavo(root, \"drive\", \"1\")\n    assert run.returncode == 0, run.stdout + run.stderr\n\n    rec = latest_record(root, \"build\")\n    assert rec[\"status\"] == \"pass\"\n\n    record_path = record_files(root, \"build\")[-1]\n    log_path = record_path.with_suffix(\".log\")\n    assert log_path.exists()\n\n    touched = set(last_commit_paths(root))\n    assert touched == {\n        str(record_path.relative_to(root)),\n        str(log_path.relative_to(root)),\n    }\n\n    assert remote_head(bare, branch) == head_of(root)\n\n\ndef test_drive_leaves_the_events_file_out_of_the_record_commit(tmp_path):\n    \"\"\"Issue #26, acceptance row 2, strengthened by issue #140: attavo\n    build always writes a stage's events file now (test_build.py's own\n    row-1 tests), under the checkout's own git directory rather than\n    the working tree -- so it is not merely excluded from the commit's\n    file list, it is not even a path git tracks anything under. The\n    commit's file list still names only the record and its log.\n    \"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    add_bare_remote(root, tmp_path)\n    approve_item(root)\n\n    run = run_attavo(root, \"drive\", \"1\")\n    assert run.returncode == 0, run.stdout + run.stderr\n\n    record_path = record_files(root, \"build\")[-1]\n    git_dir = git(root, \"rev-parse\", \"--absolute-git-dir\").strip()\n    events_path = Path(git_dir) / \"attavo\" / \"build-01.events.jsonl\"\n    assert events_path.is_file()\n\n    touched = set(last_commit_paths(root))\n    assert touched == {\n        str(record_path.relative_to(root)),\n        str(record_path.with_suffix(\".log\").relative_to(root)),\n    }\n\n\ndef test_drive_commits_the_record_as_the_driver_not_the_tenants_own_identity(tmp_path):\n    \"\"\"The driver's identity (driver_identity, beside executor_identity):\n    set by the product, never the tenant's git config, so a driven item's\n    record commits are never indistinguishable from an operator's own.\n    The fixture tenant's user.name is set to another value here, so a\n    commit carrying it would prove commit_record fell back to the\n    tenant's git config instead.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    git(root, \"config\", \"user.name\", \"Some Operator\")\n    git(root, \"config\", \"user.email\", \"operator@example.com\")\n    add_forge(root, GREEN_FORGE)\n    add_bare_remote(root, tmp_path)\n    approve_item(root)\n\n    run = run_attavo(root, \"drive\", \"1\")\n    assert run.returncode == 0, run.stdout + run.stderr\n\n    author_name = git(root, \"log\", \"-1\", \"--format=%an\").strip()\n    author_email = git(root, \"log\", \"-1\", \"--format=%ae\").strip()\n    committer_name = git(root, \"log\", \"-1\", \"--format=%cn\").strip()\n    committer_email = git(root, \"log\", \"-1\", \"--format=%ce\").strip()\n\n    assert author_name == \"attavo driver\"\n    assert author_email == \"driver@attavo.invalid\"\n    assert committer_name == \"attavo driver\"\n    assert committer_email == \"driver@attavo.invalid\"\n\n\ndef test_drive_verifies_from_a_passed_build_with_the_forge_green(tmp_path):\n    \"\"\"Acceptance row 2. From a passed build with the fake forge green,\n    one run produces a verify record, commits only the record and its log,\n    and pushes.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    bare = add_bare_remote(root, tmp_path)\n    approve_item(root)\n    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n\n    assert run_attavo(root, \"drive\", \"1\").returncode == 0  # builds\n\n    run = run_attavo(root, \"drive\", \"1\")\n    assert run.returncode == 0, run.stdout + run.stderr\n\n    assert record_files(root, \"build\") and record_files(root, \"verify\")\n    rec = latest_record(root, \"verify\")\n    assert rec[\"status\"] == \"pass\"\n\n    record_path = record_files(root, \"verify\")[-1]\n    log_path = record_path.with_suffix(\".log\")\n    assert log_path.exists()\n\n    touched = set(last_commit_paths(root))\n    assert touched == {\n        str(record_path.relative_to(root)),\n        str(log_path.relative_to(root)),\n    }\n\n    assert remote_head(bare, branch) == head_of(root)\n\n\ndef test_drive_verifies_again_when_the_latest_verify_is_superseded_by_a_later_build(tmp_path):\n    \"\"\"Acceptance row 4, issue #109. A verify record can only name a build\n    that existed when it was written, so a later build makes the latest\n    verify superseded, never a mismatch -- drive derives the next stage\n    as verify, not build, and never refuses.\n\n    Regression: on main before this lane, drive_state's own inline\n    staleness check already treats this as 'verify', so this test does\n    not fail against current code -- it is here to lock the behavior\n    check_attest_chain's fix must not disturb (the acceptance table's\n    'never refuses' row).\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    add_bare_remote(root, tmp_path)\n    approve_item(root)\n\n    assert run_attavo(root, \"drive\", \"1\").returncode == 0  # builds\n    assert run_attavo(root, \"drive\", \"1\").returncode == 0  # verifies\n\n    # A second build record, minted by hand -- a real re-run of the\n    # fixture adapter is not idempotent against its own tree -- naming a\n    # sha the existing verify-01 does not: verify-01 is now superseded.\n    build_01 = json.loads(record_files(root, \"build\")[-1].read_text())\n    build_01[\"sha\"] = \"f\" * 40\n    (records_dir(root) / \"build-02.json\").write_text(json.dumps(build_01))\n    commit_all(root, \"attavo: second build record for #1, minted by hand\")\n\n    run = run_attavo(root, \"drive\", \"1\")\n    assert run.returncode == 0, run.stdout + run.stderr\n    assert len(record_files(root, \"build\")) == 2\n    assert len(record_files(root, \"verify\")) == 2\n    rec = latest_record(root, \"verify\")\n    assert rec[\"status\"] == \"pass\"\n    assert rec[\"build_sha\"] == build_01[\"sha\"]\n\n\ndef test_drive_prints_ready_to_merge_from_a_passed_verify(tmp_path):\n    \"\"\"Acceptance row 3. From a passed verify with the forge green, one\n    run prints ready-to-merge, exits 0, writes nothing, enqueues nothing\n    -- and, per row 8, a further run repeats exactly the same thing.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    add_bare_remote(root, tmp_path)\n    approve_item(root)\n\n    assert run_attavo(root, \"drive\", \"1\").returncode == 0  # builds\n    assert run_attavo(root, \"drive\", \"1\").returncode == 0  # verifies\n\n    pre_head = head_of(root)\n    run = run_attavo(root, \"drive\", \"1\")\n    assert run.returncode == 0, run.stdout + run.stderr\n    assert \"ready to merge\" in run.stdout\n    assert head_of(root) == pre_head\n    assert record_files(root, \"verify\") and len(record_files(root, \"verify\")) == 1\n\n    # Acceptance row 8: idempotence -- run it again, same result, nothing\n    # new written or pushed.\n    run2 = run_attavo(root, \"drive\", \"1\")\n    assert run2.returncode == 0\n    assert \"ready to merge\" in run2.stdout\n    assert head_of(root) == pre_head\n    assert len(record_files(root, \"verify\")) == 1\n    assert len(record_files(root, \"build\")) == 1\n\n\ndef test_drive_until_ready_runs_build_then_verify_to_ready_in_one_call(tmp_path):\n    \"\"\"Issue #100's own followups. --until-ready repeats step-and-wait in\n    the same process: one call, from an approved item with the forge\n    green, builds, verifies, and prints ready to merge -- both records\n    written and pushed, without the caller invoking drive again after\n    each passing step.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    bare = add_bare_remote(root, tmp_path)\n    approve_item(root)\n    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n\n    run = run_attavo(root, \"drive\", \"1\", \"--until-ready\")\n    assert run.returncode == 0, run.stdout + run.stderr\n    assert \"ready to merge\" in run.stdout\n\n    assert len(record_files(root, \"build\")) == 1\n    assert len(record_files(root, \"verify\")) == 1\n    assert latest_record(root, \"build\")[\"status\"] == \"pass\"\n    assert latest_record(root, \"verify\")[\"status\"] == \"pass\"\n    assert remote_head(bare, branch) == head_of(root)\n\n    # Idempotence, same as the single-step form: a further --until-ready\n    # call repeats exactly the same ready-to-merge result, writing nothing.\n    run2 = run_attavo(root, \"drive\", \"1\", \"--until-ready\")\n    assert run2.returncode == 0\n    assert \"ready to merge\" in run2.stdout\n    assert len(record_files(root, \"build\")) == 1\n    assert len(record_files(root, \"verify\")) == 1\n\n\ndef test_drive_without_the_flag_still_takes_one_step_at_a_time(tmp_path):\n    \"\"\"Regression: --until-ready is additive. With no flag, an approved\n    item with the forge green still needs two separate calls -- build,\n    then verify -- exactly as before this issue.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    add_bare_remote(root, tmp_path)\n    approve_item(root)\n\n    run = run_attavo(root, \"drive\", \"1\")\n    assert run.returncode == 0\n    assert record_files(root, \"build\") and not record_files(root, \"verify\")\n\n    run2 = run_attavo(root, \"drive\", \"1\")\n    assert run2.returncode == 0\n    assert record_files(root, \"verify\")\n\n\ndef test_drive_until_ready_stops_on_a_halt(tmp_path):\n    \"\"\"A step that stops on its own account -- here, a halted build --\n    stops the --until-ready loop exactly where the single-step form\n    would, printing the same thing; it does not retry the halted step.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    bare = add_bare_remote(root, tmp_path)\n    approve_item(root)\n    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n\n    run = run_attavo(root, \"drive\", \"1\", \"--until-ready\",\n                     env={\"ATTAVO_FIXTURE_QUESTION\": \"which overlay wins?\"})\n    assert run.returncode == 3\n    assert \"which overlay wins?\" in run.stdout\n\n    assert len(record_files(root, \"build\")) == 1\n    assert latest_record(root, \"build\")[\"status\"] == \"halted\"\n    assert record_files(root, \"verify\") == []\n    assert remote_head(bare, branch) == head_of(root)\n\n\ndef test_drive_until_ready_stops_when_the_forge_goes_red_after_a_build(tmp_path):\n    \"\"\"A build that passes, then a forge that concludes red for verify's\n    own gate, stops the loop there -- one record written (the pass), no\n    verify record, no retry of the forge read.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, RED_FORGE)\n    add_bare_remote(root, tmp_path)\n    approve_item(root)\n\n    run = run_attavo(root, \"drive\", \"1\", \"--until-ready\")\n    assert run.returncode != 0\n    assert \"ci\" in run.stdout and \"failure\" in run.stdout\n\n    assert len(record_files(root, \"build\")) == 1\n    assert latest_record(root, \"build\")[\"status\"] == \"pass\"\n    assert record_files(root, \"verify\") == []\n\n\ndef test_drive_stops_when_the_forge_is_red(tmp_path):\n    \"\"\"Acceptance row 4. A forge read where the one check has already\n    concluded and failed is not polled at all -- there is nothing left to\n    wait on, so drive stops on the first read, naming the check, with no\n    sleep in between. Writes nothing -- no verify record at all, no new\n    commit.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, RED_FORGE)\n    add_bare_remote(root, tmp_path)\n    approve_item(root)\n\n    assert run_attavo(root, \"drive\", \"1\").returncode == 0  # builds\n    pre_head = head_of(root)\n\n    started = time.monotonic()\n    run = run_attavo(root, \"drive\", \"1\")\n    elapsed = time.monotonic() - started\n    assert run.returncode != 0\n    assert \"ci\" in run.stdout and \"failure\" in run.stdout\n    assert elapsed < 0.4, (\n        f\"a concluded, red forge check should stop on the first read with no \"\n        f\"poll interval slept -- took {elapsed:.2f}s\")\n\n    assert record_files(root, \"verify\") == []\n    assert head_of(root) == pre_head\n\n    # Idempotence (row 8): running again in the same red state stops the\n    # same way, still nothing written.\n    run2 = run_attavo(root, \"drive\", \"1\")\n    assert run2.returncode != 0\n    assert record_files(root, \"verify\") == []\n    assert head_of(root) == pre_head\n\n\ndef test_drive_polls_the_bound_while_the_forge_is_still_running(tmp_path):\n    \"\"\"Acceptance row 4, the unconcluded case: a check still carrying a\n    status (in_progress) rather than a conclusion is not yet red -- drive\n    keeps polling it for the full bound before giving up, unlike a\n    concluded red check, which it does not poll at all. Writes nothing.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, UNCONCLUDED_FORGE)\n    add_bare_remote(root, tmp_path)\n    approve_item(root)\n\n    assert run_attavo(root, \"drive\", \"1\").returncode == 0  # builds\n\n    started = time.monotonic()\n    run = run_attavo(root, \"drive\", \"1\")\n    elapsed = time.monotonic() - started\n    assert run.returncode != 0\n    assert \"ci\" in run.stdout and \"in_progress\" in run.stdout\n    assert elapsed >= 0.4, (\n        f\"a check still in_progress should be polled for the bound, not \"\n        f\"stopped on the first read -- took only {elapsed:.2f}s\")\n\n    assert record_files(root, \"verify\") == []\n\n\ndef test_drive_halts_on_a_question_and_resumes_at_build_after_a_ruling(tmp_path):\n    \"\"\"Acceptance row 5. The fixture adapter halts with a question: drive\n    stops naming the question and the record (and still pushes that\n    halted record, same as any other record build writes). After a\n    ruling is appended, a second run resumes at build and this time\n    passes.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    bare = add_bare_remote(root, tmp_path)\n    approve_item(root)\n    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n\n    run = run_attavo(root, \"drive\", \"1\",\n                     env={\"ATTAVO_FIXTURE_QUESTION\": \"which overlay wins?\"})\n    assert run.returncode == 3\n    assert \"which overlay wins?\" in run.stdout\n\n    rec = latest_record(root, \"build\")\n    assert rec[\"status\"] == \"halted\"\n    assert rec[\"halted\"] == {\"question\": \"which overlay wins?\"}\n    record_path = record_files(root, \"build\")[-1]\n    assert record_path.name in run.stdout\n\n    # The halted record was still committed and pushed.\n    assert remote_head(bare, branch) == head_of(root)\n\n    rulings = root / \"rulings.md\"\n    rulings.write_text(rulings.read_text() + \"\\n- overlay: use the base tree\\n\"\n                       if rulings.exists() else \"- overlay: use the base tree\\n\")\n    commit_all(root, \"rule on the overlay question\")\n    git(root, \"push\", \"origin\", f\"HEAD:{branch}\")\n\n    run2 = run_attavo(root, \"drive\", \"1\")\n    assert run2.returncode == 0, run2.stdout + run2.stderr\n\n    assert len(record_files(root, \"build\")) == 2\n    rec2 = latest_record(root, \"build\")\n    assert rec2[\"status\"] == \"pass\"\n    assert remote_head(bare, branch) == head_of(root)\n\n\ndef configure_counsel(root: Path) -> None:\n    \"\"\"[executor].counsel = \"fixture\" -- build_valid's own manifest\n    declares [executor].build = \"fixture\" only; counsel needs its own\n    adapter named (issue #100).\"\"\"\n    toml = root / \"attavo.toml\"\n    toml.write_text(toml.read_text().replace(\n        '[executor]\\nbuild = \"fixture\"', '[executor]\\nbuild = \"fixture\"\\ncounsel = \"fixture\"'))\n    commit_all(root, \"configure the counsel adapter\")\n\n\ndef test_drive_counsels_a_stop_before_filing_it_and_commits_both_records_together(tmp_path):\n    \"\"\"Issue #100, acceptance row 3. On a stop, drive calls counsel\n    before file-stops, and commits the counsel record with the stage\n    record in one commit.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    bare = add_bare_remote(root, tmp_path)\n    configure_counsel(root)\n    approve_item(root)\n    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n    filed = tmp_path / \"filed.jsonl\"\n    configure_filing(root, filed)\n\n    run = run_attavo(root, \"drive\", \"1\",\n                     env={\"ATTAVO_FIXTURE_QUESTION\": \"which overlay wins?\"})\n    assert run.returncode == 3\n\n    assert record_files(root, \"counsel\")\n    counsel_rec = latest_record(root, \"counsel\")\n    assert counsel_rec[\"record_stage\"] == \"build\"\n    assert counsel_rec[\"record\"] == \"build-01\"\n    assert counsel_rec[\"verdict\"] == \"person\"\n\n    committed = set(last_commit_paths(root))\n    assert committed == {\n        \"records/1/build-01.json\", \"records/1/build-01.log\",\n        \"records/1/counsel-01.json\", \"records/1/counsel-01.log\",\n        \"records/1/build-01.filed\",\n    }\n    assert remote_head(bare, branch) == head_of(root)\n\n    filed_bodies = [json.loads(l) for l in filed.read_text().splitlines() if l.strip()]\n    assert len(filed_bodies) == 1\n    assert filed_bodies[0][\"counsel_verdict\"] == \"person\"\n    assert filed_bodies[0][\"counsel_proposal\"][\"question\"]\n\n\ndef test_drive_still_files_a_stop_with_no_counsel_adapter_configured(tmp_path):\n    \"\"\"counsel refuses gracefully (no [executor].counsel or\n    [executor].verify) -- drive still files and transports the stage\n    record; nothing new for counsel to commit.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    bare = add_bare_remote(root, tmp_path)\n    approve_item(root)\n    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n    filed = tmp_path / \"filed.jsonl\"\n    configure_filing(root, filed)\n\n    run = run_attavo(root, \"drive\", \"1\",\n                     env={\"ATTAVO_FIXTURE_QUESTION\": \"which overlay wins?\"})\n    assert run.returncode == 3\n\n    assert record_files(root, \"counsel\") == []\n    committed = set(last_commit_paths(root))\n    assert committed == {\"records/1/build-01.json\", \"records/1/build-01.log\",\n                         \"records/1/build-01.filed\"}\n    assert remote_head(bare, branch) == head_of(root)\n\n\ndef configure_filing(root: Path, filed_path: Path) -> None:\n    \"\"\"Appended under the [forge] table add_forge already opened -- a\n    second [forge] header in the same file is a TOML redeclaration\n    error. Prints a fake issue URL on stdout, numbered by filed_path's\n    own line count so far -- the fact a real file_issue_command's stdout\n    would carry, and what the .filed marker beside each stop record is\n    meant to hold (issue #89).\"\"\"\n    toml = root / \"attavo.toml\"\n    command = (f\"n=$(wc -l < {filed_path} 2>/dev/null || echo 0); \"\n              f\"cat >> {filed_path}; \"\n              f\"echo https://github.com/tenant/repo/issues/$((n + 1))\")\n    toml.write_text(toml.read_text() + f\"\\nfile_issue_command = '{command}'\\n\")\n    commit_all(root, \"configure issue filing\")\n\n\ndef test_drive_files_a_stop_it_reports_exactly_once(tmp_path):\n    \"\"\"Issue #89, acceptance row 5. A stop drive reports -- here, the\n    fixture adapter's halt -- calls file-stops once: one drive run files\n    exactly one issue for the attempt it just wrote, not zero and not\n    more than one.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    add_bare_remote(root, tmp_path)\n    approve_item(root)\n    filed = tmp_path / \"filed.jsonl\"\n    configure_filing(root, filed)\n\n    run = run_attavo(root, \"drive\", \"1\",\n                     env={\"ATTAVO_FIXTURE_QUESTION\": \"which overlay wins?\"})\n    assert run.returncode == 3\n\n    filed_bodies = [json.loads(l) for l in filed.read_text().splitlines() if l.strip()]\n    assert len(filed_bodies) == 1\n    assert filed_bodies[0][\"record\"] == \"records/1/build-01.json\"\n\n    # A second drive run halts again -- a new attempt, build-02 -- and\n    # files exactly one more issue for that new record; file-stops' own\n    # .filed marker means build-01's issue is never filed twice.\n    run2 = run_attavo(root, \"drive\", \"1\",\n                      env={\"ATTAVO_FIXTURE_QUESTION\": \"which overlay wins?\"})\n    assert run2.returncode == 3\n    assert len(record_files(root, \"build\")) == 2\n\n    filed_bodies_after = [json.loads(l) for l in filed.read_text().splitlines() if l.strip()]\n    assert len(filed_bodies_after) == 2\n    assert filed_bodies_after[0] == filed_bodies[0]\n    assert filed_bodies_after[1][\"record\"] == \"records/1/build-02.json\"\n\n\ndef test_drive_marker_holds_the_filing_commands_stdout_and_is_committed_with_the_record(tmp_path):\n    \"\"\"A stop's own .filed marker is written before the record is\n    transported, so it carries the filing command's stdout (the issue it\n    opened) and rides in the very same commit as the record and its log\n    -- one commit, one push, as before this fix. Red before it: the\n    marker was written empty, after commit_record and push_record_commit\n    had already run, so it was never part of any commit at all.\n    \"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    bare = add_bare_remote(root, tmp_path)\n    approve_item(root)\n    filed = tmp_path / \"filed.jsonl\"\n    configure_filing(root, filed)\n\n    run = run_attavo(root, \"drive\", \"1\",\n                     env={\"ATTAVO_FIXTURE_QUESTION\": \"which overlay wins?\"})\n    assert run.returncode == 3\n\n    marker_path = records_dir(root) / \"build-01.filed\"\n    assert marker_path.is_file()\n    assert marker_path.read_text().strip() == \"https://github.com/tenant/repo/issues/1\"\n\n    committed = set(last_commit_paths(root))\n    assert committed == {\"records/1/build-01.json\", \"records/1/build-01.log\",\n                         \"records/1/build-01.filed\"}\n    assert remote_head(bare) == head_of(root)\n\n\ndef test_drive_a_second_run_in_the_same_state_files_nothing(tmp_path):\n    \"\"\"Issue #89. The marker committed and pushed above is the fact a\n    second worktree or a fresh clone reads too -- a second drive run\n    against the same records, from a fresh clone of the remote drive\n    already pushed to, files nothing for the stop that clone already\n    carries a marker for. Red before this fix: the marker never reached\n    the remote at all, so every clone refiled every stop it found.\n    \"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    bare = add_bare_remote(root, tmp_path)\n    approve_item(root)\n    filed = tmp_path / \"filed.jsonl\"\n    configure_filing(root, filed)\n\n    run = run_attavo(root, \"drive\", \"1\",\n                     env={\"ATTAVO_FIXTURE_QUESTION\": \"which overlay wins?\"})\n    assert run.returncode == 3\n    filed_after_first = filed.read_text()\n    assert filed_after_first.strip() != \"\"\n\n    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n    clone = tmp_path / \"fresh-clone\"\n    subprocess.run([\"git\", \"clone\", \"--quiet\", \"--branch\", branch, str(bare), str(clone)],\n                   check=True)\n\n    run2 = run_attavo(clone, \"file-stops\", \"1\")\n    assert run2.returncode == 0\n    assert \"no stops to file\" in run2.stdout\n    assert filed.read_text() == filed_after_first  # nothing new was filed\n\n\ndef test_drive_retries_a_rejected_push_with_a_merge_never_a_rebase(tmp_path):\n    \"\"\"Acceptance row 7. A rejected push with a divergent remote is\n    retried after `git pull --no-rebase --no-edit`, never a rebase; the\n    build record's own sha is unchanged (still reachable, still what the\n    record names), and the retry lands a merge commit, not a rewritten\n    one.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    bare = add_bare_remote(root, tmp_path)\n    approve_item(root)\n    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n\n    # Diverge the bare remote: another clone pushes an unrelated commit to\n    # the same branch before drive's own push happens.\n    other = tmp_path / \"other-clone\"\n    subprocess.run([\"git\", \"clone\", \"--quiet\", str(bare), str(other)], check=True)\n    subprocess.run([\"git\", \"-C\", str(other), \"checkout\", \"-q\", branch], check=True)\n    subprocess.run([\"git\", \"-C\", str(other), \"config\", \"user.email\", \"other@example.com\"],\n                   check=True)\n    subprocess.run([\"git\", \"-C\", str(other), \"config\", \"user.name\", \"Other\"], check=True)\n    (other / \"concurrent.txt\").write_text(\"from elsewhere\\n\")\n    subprocess.run([\"git\", \"-C\", str(other), \"add\", \"-A\"], check=True)\n    subprocess.run([\"git\", \"-C\", str(other), \"commit\", \"-q\", \"-m\", \"a concurrent commit\"],\n                   check=True)\n    subprocess.run([\"git\", \"-C\", str(other), \"push\", \"origin\", f\"HEAD:{branch}\"], check=True)\n\n    run = run_attavo(root, \"drive\", \"1\")\n    assert run.returncode == 0, run.stdout + run.stderr\n\n    rec = latest_record(root, \"build\")\n    assert rec[\"status\"] == \"pass\"\n    build_sha = rec[\"sha\"]\n\n    # The build's own commit sha is still reachable -- a merge, not a\n    # rebase, which would have rewritten it under a new sha.\n    assert build_sha in git(root, \"rev-list\", \"HEAD\").split()\n\n    merge_parents = git(root, \"log\", \"-1\", \"--format=%P\", \"HEAD\").split()\n    assert len(merge_parents) == 2, \"the retry should have landed a merge commit\"\n\n    assert remote_head(bare, branch) == head_of(root)\n    # the concurrent commit from the other clone is present too\n    assert \"concurrent.txt\" in git(root, \"ls-tree\", \"-r\", \"--name-only\", \"HEAD\")\n\n\ndef test_drive_forge_poll_defaults_are_a_real_forges_clock():\n    \"\"\"The bound and interval every other test overrides with\n    FAST_POLL_ENV default, unset, to at least five minutes and ten\n    seconds -- tenant zero's own checks conclude about five minutes after\n    a push, and a bound shorter than that would make every drive run\n    after a record push stop on 'forge checks not green', with a person\n    running it again after CI: exactly the transport act this lane\n    retires. Row 4 (a forge that never goes green) is unchanged in\n    meaning by this -- it still stops, just after waiting out a real\n    forge's own clock instead of a test's fake one.\n    \"\"\"\n    module = attavo_module()\n    assert module.DRIVE_FORGE_POLL_BOUND_DEFAULT_S >= 300\n    assert module.DRIVE_FORGE_POLL_INTERVAL_DEFAULT_S >= 10\n","numLines":760,"startLine":1,"totalLines":760}}}

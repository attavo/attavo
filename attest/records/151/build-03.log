None and version < LEDGER_V018_CUTOFF:\n3440\t                rows.append({\"sha\": sha, \"identity\": name, \"class\": \"record-or-launch\",\n3441\t                            \"note\": \"not distinguishable before v0.18.0\"})\n3442\t                continue\n3443\t\n3444\t            rows.append({\"sha\": sha, \"identity\": name, \"class\": \"launch\"})\n3445\t            operator_acts += 1\n3446\t            continue\n3447\t\n3448\t        if any(p.startswith(specs_prefix) for p in touched):\n3449\t            cls = \"amend\" if approval_seen else \"spec\"\n3450\t            rows.append({\"sha\": sha, \"identity\": name, \"class\": cls})\n3451\t            if cls == \"amend\":\n3452\t                operator_acts += 1\n3453\t            continue\n3454\t"}]},"parent_tool_use_id":null,"session_id":"f081a203-e2ee-47b3-8bf8-5fc3aaeb804d","uuid":"c34f581e-a943-4832-8e21-bf4ca266f255","timestamp":"2026-09-17T19:46:47.403Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-151/bin/attavo","content":"            rows.append({\"sha\": sha, \"identity\": name, \"class\": \"merge\"})\n            operator_acts += 1\n            continue\n\n        if email.startswith(\"executor+\") and email.endswith(\"@attavo.invalid\"):\n            rows.append({\"sha\": sha, \"identity\": name, \"class\": \"change\"})\n            executor_commits += 1\n            continue\n\n        touched = _commit_touches(root, sha)\n        record_touch = None\n        for p in touched:\n            if not p.startswith(records_prefix):\n                continue\n            rm = RECORD_RE.match(Path(p).name)\n            if rm and rm.group(1) in STAGES:\n                record_touch = (rm.group(1), p)\n                break\n\n        if record_touch is not None:\n            stage, relpath = record_touch\n            content = _record_at(root, sha, relpath, item_id)\n            if since is None:\n                since = content.get(\"product_version\")\n\n            if stage == \"approval\":\n                rows.append({\"sha\": sha, \"identity\": name, \"class\": \"approve\"})\n                operator_acts += 1\n                approval_seen = True\n                continue\n\n            is_driver = name == driver[\"name\"] and email == driver[\"email\"]\n            is_records_app = _is_records_app(name)\n            if stage == \"spec\" or is_driver or is_records_app:\n                rows.append({\"sha\": sha, \"identity\": name, \"class\": \"record\"})\n                product_acts += 1\n                continue\n\n            version = _semver_tuple(content.get(\"product_version\"))\n            if version is not None and version < LEDGER_V018_CUTOFF:\n                rows.append({\"sha\": sha, \"identity\": name, \"class\": \"record-or-launch\",\n                            \"note\": \"not distinguishable before v0.18.0\"})\n                continue\n\n            rows.append({\"sha\": sha, \"identity\": name, \"class\": \"launch\"})\n            operator_acts += 1\n            continue\n\n        if any(p.startswith(specs_prefix) for p in touched):\n            cls = \"amend\" if approval_seen else \"spec\"\n            rows.append({\"sha\": sha, \"identity\": name, \"class\": cls})\n            if cls == \"amend\":\n                operator_acts += 1\n            continue\n","numLines":55,"startLine":3400,"totalLines":3664}}}

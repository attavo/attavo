{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YRoZXbxWAvFmBdBaDwquij","type":"tool_result","content":"805\t\n806\t\n807\tINVOCATION_MARKER_SUFFIX = \".started\"\n808\t\n809\t\n810\tdef invocation_marker_path(records_dir: Path, stage: str, nn: int) -> Path:\n811\t    return records_dir / f\"{stage}-{nn:02d}{INVOCATION_MARKER_SUFFIX}\"\n812\t\n813\t\n814\tdef write_invocation_marker(root: Path, records_dir: Path, stage: str, nn: int) -> Path:\n815\t    \"\"\"The fact that an invocation began, written before it does: at,\n816\t    host, pid, the sha it starts on, and the product that started it.\n817\t    Its record's arrival is what retires it; a marker with no record is\n818\t    an invocation that died or hangs, and proof five names it.\"\"\"\n819\t    import os\n820\t    import socket\n821\t    from datetime import datetime, timezone\n822\t    records_dir.mkdir(parents=True, exist_ok=True)\n823\t    path = invocation_marker_path(records_dir, stage, nn)\n824\t    sha = git(root, \"rev-parse\", \"HEAD\").strip()\n825\t    info = {\"at\": datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\"),\n826\t            \"host\": socket.gethostname(), \"pid\": os.getpid(), \"sha\": sha,\n827\t            \"product_version\": product_version()}\n828\t    path.write_text(json.dumps(info, indent=2) + \"\\n\")\n829\t    return path\n830\t\n831\t\n832\tdef invocation_alive(info: dict) -> bool:\n833\t    \"\"\"Whether the marker's pid is a live process on this host. Another\n834\t    host's pid is unknowable from here and reads as not alive: a drive\n835\t    that ran elsewhere and wrote no record is died by absence.\"\"\"\n836\t    import os\n837\t    import socket\n838\t    if info.get(\"host\") != socket.gethostname():\n839\t        return False\n840\t    pid = info.get(\"pid\")\n841\t    if not isinstance(pid, int) or isinstance(pid, bool) or pid <= 0:\n842\t        return False\n843\t    try:\n844\t        os.kill(pid, 0)\n845\t    except ProcessLookupError:\n846\t        return False\n847\t    except PermissionError:\n848\t        return True\n849\t    return True\n850\t\n851\t\n852\tdef invocations_without_record(item_records_dir: Path) -> list[tuple[Path, dict]]:\n853\t    \"\"\"Every <stage>-NN.started under one item whose <stage>-NN.json has\n854\t    not arrived, with the marker's own dict ({} when unreadable).\"\"\"\n855\t    out: list[tuple[Path, dict]] = []\n856\t    if not item_records_dir.is_dir():\n857\t        return out\n858\t    for marker in sorted(item_records_dir.glob(f\"*{INVOCATION_MARKER_SUFFIX}\")):\n859\t        if (item_records_dir / f\"{marker.stem}.json\").is_file():\n860\t            continue\n861\t        try:\n862\t            info = json.loads(marker.read_text())\n863\t        except (OSError, ValueError):\n864\t            info = {}\n865\t        out.append((marker, info if isinstance(info, dict) else {}))\n866\t    return out\n867\t\n868\t\n869\tdef stall_bound_s(m: dict) -> int | None:\n870\t    \"\"\"[drive].stall_after_s: the tenant's own bound past which a live\n871\t    invocation with no new event is hung. A bound the tenant did not\n872\t    write is a forecast, so there is no default.\"\"\"\n873\t    bound = (m.get(\"drive\") or {}).get(\"stall_after_s\")\n874\t    if isinstance(bound, bool) or not isinstance(bound, (int, float)) or bound <= 0:\n875\t        return None\n876\t    return int(bound)\n877\t\n878\t\n879\tdef proof_no_invocation_lacks_record(root: Path, m: dict | None) -> Proof:\n880\t    p = Proof(\"no-invocation-lacks-record\", \"no invocation lacks its record\")\n881\t    if m is None:\n882\t        return p.fail(f\"no {MANIFEST} at {root}; no records directory is declared\")\n883\t    records_rel = m.get(\"paths\", {}).get(\"records\", \"\")\n884\t    records_dir = root / records_rel\n885\t    if not records_dir.is_dir():\n886\t        return p.fail(f\"no records directory under {records_dir}\")\n887\t    if stall_bound_s(m) is None:\n888\t        return p.fail(\"no [drive].stall_after_s in the manifest; a hung invocation cannot be \"\n889\t                      \"told from a running one\")\n890\t    recorded = 0\n891\t    running: list[str] = []\n892\t    problems: list[str] = []\n893\t    for item_dir in sorted(d for d in records_dir.iterdir() if d.is_dir()):\n894\t        for marker in item_dir.glob(f\"*{INVOCATION_MARKER_SUFFIX}\"):\n895\t            if (item_dir / f\"{marker.stem}.json\").is_file():\n896\t                recorded += 1\n897\t        for marker, info in invocations_without_record(item_dir):\n898\t            name = f\"item {item_dir.name} {marker.stem}\"\n899\t            if invocation_alive(info):\n900\t                running.append(f\"{name} (pid {info.get('pid')} since {info.get('at')})\")\n901\t                continue\n902\t            problems.append(f\"{name} started {info.get('at')} on {info.get('host')} \"\n903\t                            f\"pid {info.get('pid')} and never wrote its record\")\n904\t    if problems:\n905\t        return p.fail(\"; \".join(problems), unrecorded_invocations=len(problems),\n906\t                      running_invocations=running)\n907\t    return p.hold(f\"{recorded} invocation(s) recorded, {len(running)} running\",\n908\t                  unrecorded_invocations=0, running_invocations=running)\n909\t\n910\t\n911\tdef _events_path_for(root: Path, stage: str, nn: int) -> Path | None:\n912\t    \"\"\"The adapter's own events file for this invocation, under the\n913\t    checkout's git dir (a worktree's own dir when the checkout is one).\"\"\"\n914\t    try:\n915\t        gitdir = Path(git(root, \"rev-parse\", \"--git-dir\").strip())\n916\t    except RuntimeError:\n917\t        return None\n918\t    if not gitdir.is_absolute():\n919\t        gitdir = root / gitdir\n920\t    path = gitdir / \"attavo\" / f\"{stage}-{nn:02d}.events.jsonl\"\n921\t    return path if path.is_file() else None\n922\t\n923\t\n924\tdef _events_tail(path: Path | None, lines: int = 20) -> tuple[str, str | None]:\n925\t    \"\"\"(the last lines as a log, the last event's own at).\"\"\"\n926\t    if path is None:\n927\t        return \"no events file for this invocation\\n\", None\n928\t    try:\n929\t        text = path.read_text()\n930\t    except OSError:\n931\t        return \"events file unreadable\\n\", None\n932\t    tail = text.splitlines()[-lines:]\n933\t    last_at = None\n934\t    for line in reversed(tail):\n935\t        try:\n936\t            at = json.loads(line).get(\"at\")\n937\t        except ValueError:\n938\t            continue\n939\t        if isinstance(at, str):\n940\t            last_at = at\n941\t            break\n942\t    return \"\\n\".join(tail) + \"\\n\", last_at\n943\t\n944\t\n945\tdef _seconds_since(at: str | None) -> float | None:\n946\t    from datetime import datetime, timezone\n947\t    if not at:\n948\t        return None\n949\t    try:\n950\t        then = datetime.strptime(at, \"%Y-%m-%dT%H:%M:%SZ\").replace(tzinfo=timezone.utc)\n951\t    except ValueError:\n952\t        return None\n953\t    return (datetime.now(timezone.utc) - then).total_seconds()\n954\t\n955\t\n956\tdef _drive_recover(root: Path, m: dict, item_id: str) -> int:\n957\t    \"\"\"`attavo drive --recover [N]`: every invocation of item N that began\n958\t    and wrote no record ends in one here -- class died when its pid is\n959\t    gone or on another host, class hung when it is alive past\n960\t    [drive].stall_after_s with no newer event (and terminated); provenance\n961\t    product; the events tail as the log. A live invocation inside the\n962\t    bound is running and left alone. The record is committed and pushed\n963\t    the way every stage record is; the ordinary relaunch then reads a\n964\t    non-pass record and does what it does.\"\"\"\n965\t    import os\n966\t    import signal\n967\t    records_rel = m[\"paths\"][\"records\"]\n968\t    records_dir = root / records_rel / item_id\n969\t    bound = stall_bound_s(m)\n970\t    if bound is None:\n971\t        print(\"attavo drive: refused: no [drive].stall_after_s in the manifest; a hung \"\n972\t              \"invocation cannot be told from a running one\")\n973\t        return 1\n974\t    pending = invocations_without_record(records_dir)\n975\t    if not pending:\n976\t        print(f\"attavo drive: item {item_id}: every invocation has its record; nothing to recover\")\n977\t        return 0\n978\t    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n979\t    try:\n980\t        git(root, \"remote\", \"get-url\", \"origin\")\n981\t        has_origin = True\n982\t    except RuntimeError:\n983\t        has_origin = False\n984\t    recovered = 0\n985\t    for marker, info in pending:\n986\t        stage, nn_text = marker.stem.rsplit(\"-\", 1)\n987\t        nn = int(nn_text)\n988\t        events = _events_path_for(root, stage, nn)\n989\t        log, last_at = _events_tail(events)\n990\t        age = _seconds_since(last_at or info.get(\"at\"))\n991\t        pid, host = info.get(\"pid\"), info.get(\"host\")\n992\t        if invocation_alive(info):\n993\t            if age is None or age <= bound:\n994\t                print(f\"attavo drive: {marker.stem} is running (pid {pid}, last event \"\n995\t                      f\"{'unknown' if age is None else int(age)} s ago, bound {bound} s); \"\n996\t                      f\"nothing to recover\")\n997\t                continue\n998\t            cls = \"hung\"\n999\t            try:\n1000\t                os.kill(int(pid), signal.SIGTERM)\n1001\t                ended = \"terminated\"\n1002\t            except OSError as exc:\n1003\t                ended = f\"not terminated ({exc})\"\n1004\t            detail = (f\"pid {pid} on {host} alive with no event for {int(age)} s \"\n1005\t                      f\"(bound {bound} s); {ended}\")\n1006\t        else:\n1007\t            cls = \"died\"\n1008\t            detail = (f\"pid {pid} on {host} is not running and wrote no {marker.stem}.json; \"\n1009\t                      f\"started {info.get('at')}, last event {last_at or 'none'}\")\n1010\t        if next_attempt_number(records_dir, stage) != nn:\n1011\t            print(f\"attavo drive: stopped: {marker.name} names attempt {nn} but the next \"\n1012\t                  f\"{stage} record would be {next_attempt_number(records_dir, stage):02d}; \"\n1013\t                  f\"a later record already exists, read the records before recovering\")\n1014\t            return 1\n1015\t        schema = stage_schema(stage)\n1016\t        record = {k: None for k in schema.get(\"required\", [])}\n1017\t        approval = latest_record(records_dir, \"approval\") or {}\n1018\t        record.update({\"sha\": info.get(\"sha\"), \"start_sha\": info.get(\"sha\"),\n1019\t                       \"approval_sha\": approval.get(\"sha\"), \"at\": info.get(\"at\"),\n1020\t                       \"adapter\": (m.get(\"executor\") or {}).get(stage),\n1021\t                       \"status\": \"failed\", \"refusal\": None, \"halted\": None,\n1022\t                       \"stop\": {\"class\": cls, \"provenance\": \"product\", \"detail\": detail}})\n1023\t        if \"wall_clock_s\" in record:\n1024\t            record[\"wall_clock_s\"] = None if age is None else int(age)\n1025\t        record = {k: v for k, v in record.items() if k in schema.get(\"properties\", {})}\n1026\t        try:\n1027\t            path = write_record(records_dir, stage, record, m, item_id, log=log)\n1028\t        except ValueError as exc:\n1029\t            print(f\"attavo drive: stopped: could not write the {cls} record for {marker.stem}: {exc}\")\n1030\t            return 1\n1031\t        try:\n1032\t            commit_record(root, [path], f\"attavo: {stage} record for item {item_id} \"\n1033\t                                        f\"({path.stem}), recovered as {cls}\")\n1034\t        except RuntimeError as exc:\n1035\t            print(f\"attavo drive: stopped: could not commit the {cls} record: {exc}\")\n1036\t            return 1\n1037\t        if has_origin:\n1038\t            ok, err = push_record_commit(root, branch)\n1039\t            if not ok:\n1040\t                print(f\"attavo drive: stopped: could not push the {cls} record: {err}\")\n1041\t                return 1\n1042\t        else:\n1043\t            print(f\"attavo drive: note: no origin remote; {path.name} is committed, not pushed\")\n1044\t        print(f\"attavo drive: recovered {marker.stem} as {cls}: {detail}\")\n1045\t        recovered += 1\n1046\t    print(f\"attavo drive: item {item_id}: {recovered} invocation(s) recovered\")\n1047\t    return 0\n1048\t\n1049\t"}]},"parent_tool_use_id":null,"session_id":"f081a203-e2ee-47b3-8bf8-5fc3aaeb804d","uuid":"70872a3b-735b-40e7-a787-bec790d64227","timestamp":"2026-09-17T19:42:39.298Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-151/attest/specs/151/stub/bin/attavo","content":"\n\nINVOCATION_MARKER_SUFFIX = \".started\"\n\n\ndef invocation_marker_path(records_dir: Path, stage: str, nn: int) -> Path:\n    return records_dir / f\"{stage}-{nn:02d}{INVOCATION_MARKER_SUFFIX}\"\n\n\ndef write_invocation_marker(root: Path, records_dir: Path, stage: str, nn: int) -> Path:\n    \"\"\"The fact that an invocation began, written before it does: at,\n    host, pid, the sha it starts on, and the product that started it.\n    Its record's arrival is what retires it; a marker with no record is\n    an invocation that died or hangs, and proof five names it.\"\"\"\n    import os\n    import socket\n    from datetime import datetime, timezone\n    records_dir.mkdir(parents=True, exist_ok=True)\n    path = invocation_marker_path(records_dir, stage, nn)\n    sha = git(root, \"rev-parse\", \"HEAD\").strip()\n    info = {\"at\": datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\"),\n            \"host\": socket.gethostname(), \"pid\": os.getpid(), \"sha\": sha,\n            \"product_version\": product_version()}\n    path.write_text(json.dumps(info, indent=2) + \"\\n\")\n    return path\n\n\ndef invocation_alive(info: dict) -> bool:\n    \"\"\"Whether the marker's pid is a live process on this host. Another\n    host's pid is unknowable from here and reads as not alive: a drive\n    that ran elsewhere and wrote no record is died by absence.\"\"\"\n    import os\n    import socket\n    if info.get(\"host\") != socket.gethostname():\n        return False\n    pid = info.get(\"pid\")\n    if not isinstance(pid, int) or isinstance(pid, bool) or pid <= 0:\n        return False\n    try:\n        os.kill(pid, 0)\n    except ProcessLookupError:\n        return False\n    except PermissionError:\n        return True\n    return True\n\n\ndef invocations_without_record(item_records_dir: Path) -> list[tuple[Path, dict]]:\n    \"\"\"Every <stage>-NN.started under one item whose <stage>-NN.json has\n    not arrived, with the marker's own dict ({} when unreadable).\"\"\"\n    out: list[tuple[Path, dict]] = []\n    if not item_records_dir.is_dir():\n        return out\n    for marker in sorted(item_records_dir.glob(f\"*{INVOCATION_MARKER_SUFFIX}\")):\n        if (item_records_dir / f\"{marker.stem}.json\").is_file():\n            continue\n        try:\n            info = json.loads(marker.read_text())\n        except (OSError, ValueError):\n            info = {}\n        out.append((marker, info if isinstance(info, dict) else {}))\n    return out\n\n\ndef stall_bound_s(m: dict) -> int | None:\n    \"\"\"[drive].stall_after_s: the tenant's own bound past which a live\n    invocation with no new event is hung. A bound the tenant did not\n    write is a forecast, so there is no default.\"\"\"\n    bound = (m.get(\"drive\") or {}).get(\"stall_after_s\")\n    if isinstance(bound, bool) or not isinstance(bound, (int, float)) or bound <= 0:\n        return None\n    return int(bound)\n\n\ndef proof_no_invocation_lacks_record(root: Path, m: dict | None) -> Proof:\n    p = Proof(\"no-invocation-lacks-record\", \"no invocation lacks its record\")\n    if m is None:\n        return p.fail(f\"no {MANIFEST} at {root}; no records directory is declared\")\n    records_rel = m.get(\"paths\", {}).get(\"records\", \"\")\n    records_dir = root / records_rel\n    if not records_dir.is_dir():\n        return p.fail(f\"no records directory under {records_dir}\")\n    if stall_bound_s(m) is None:\n        return p.fail(\"no [drive].stall_after_s in the manifest; a hung invocation cannot be \"\n                      \"told from a running one\")\n    recorded = 0\n    running: list[str] = []\n    problems: list[str] = []\n    for item_dir in sorted(d for d in records_dir.iterdir() if d.is_dir()):\n        for marker in item_dir.glob(f\"*{INVOCATION_MARKER_SUFFIX}\"):\n            if (item_dir / f\"{marker.stem}.json\").is_file():\n                recorded += 1\n        for marker, info in invocations_without_record(item_dir):\n            name = f\"item {item_dir.name} {marker.stem}\"\n            if invocation_alive(info):\n                running.append(f\"{name} (pid {info.get('pid')} since {info.get('at')})\")\n                continue\n            problems.append(f\"{name} started {info.get('at')} on {info.get('host')} \"\n                            f\"pid {info.get('pid')} and never wrote its record\")\n    if problems:\n        return p.fail(\"; \".join(problems), unrecorded_invocations=len(problems),\n                      running_invocations=running)\n    return p.hold(f\"{recorded} invocation(s) recorded, {len(running)} running\",\n                  unrecorded_invocations=0, running_invocations=running)\n\n\ndef _events_path_for(root: Path, stage: str, nn: int) -> Path | None:\n    \"\"\"The adapter's own events file for this invocation, under the\n    checkout's git dir (a worktree's own dir when the checkout is one).\"\"\"\n    try:\n        gitdir = Path(git(root, \"rev-parse\", \"--git-dir\").strip())\n    except RuntimeError:\n        return None\n    if not gitdir.is_absolute():\n        gitdir = root / gitdir\n    path = gitdir / \"attavo\" / f\"{stage}-{nn:02d}.events.jsonl\"\n    return path if path.is_file() else None\n\n\ndef _events_tail(path: Path | None, lines: int = 20) -> tuple[str, str | None]:\n    \"\"\"(the last lines as a log, the last event's own at).\"\"\"\n    if path is None:\n        return \"no events file for this invocation\\n\", None\n    try:\n        text = path.read_text()\n    except OSError:\n        return \"events file unreadable\\n\", None\n    tail = text.splitlines()[-lines:]\n    last_at = None\n    for line in reversed(tail):\n        try:\n            at = json.loads(line).get(\"at\")\n        except ValueError:\n            continue\n        if isinstance(at, str):\n            last_at = at\n            break\n    return \"\\n\".join(tail) + \"\\n\", last_at\n\n\ndef _seconds_since(at: str | None) -> float | None:\n    from datetime import datetime, timezone\n    if not at:\n        return None\n    try:\n        then = datetime.strptime(at, \"%Y-%m-%dT%H:%M:%SZ\").replace(tzinfo=timezone.utc)\n    except ValueError:\n        return None\n    return (datetime.now(timezone.utc) - then).total_seconds()\n\n\ndef _drive_recover(root: Path, m: dict, item_id: str) -> int:\n    \"\"\"`attavo drive --recover [N]`: every invocation of item N that began\n    and wrote no record ends in one here -- class died when its pid is\n    gone or on another host, class hung when it is alive past\n    [drive].stall_after_s with no newer event (and terminated); provenance\n    product; the events tail as the log. A live invocation inside the\n    bound is running and left alone. The record is committed and pushed\n    the way every stage record is; the ordinary relaunch then reads a\n    non-pass record and does what it does.\"\"\"\n    import os\n    import signal\n    records_rel = m[\"paths\"][\"records\"]\n    records_dir = root / records_rel / item_id\n    bound = stall_bound_s(m)\n    if bound is None:\n        print(\"attavo drive: refused: no [drive].stall_after_s in the manifest; a hung \"\n              \"invocation cannot be told from a running one\")\n        return 1\n    pending = invocations_without_record(records_dir)\n    if not pending:\n        print(f\"attavo drive: item {item_id}: every invocation has its record; nothing to recover\")\n        return 0\n    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n    try:\n        git(root, \"remote\", \"get-url\", \"origin\")\n        has_origin = True\n    except RuntimeError:\n        has_origin = False\n    recovered = 0\n    for marker, info in pending:\n        stage, nn_text = marker.stem.rsplit(\"-\", 1)\n        nn = int(nn_text)\n        events = _events_path_for(root, stage, nn)\n        log, last_at = _events_tail(events)\n        age = _seconds_since(last_at or info.get(\"at\"))\n        pid, host = info.get(\"pid\"), info.get(\"host\")\n        if invocation_alive(info):\n            if age is None or age <= bound:\n                print(f\"attavo drive: {marker.stem} is running (pid {pid}, last event \"\n                      f\"{'unknown' if age is None else int(age)} s ago, bound {bound} s); \"\n                      f\"nothing to recover\")\n                continue\n            cls = \"hung\"\n            try:\n                os.kill(int(pid), signal.SIGTERM)\n                ended = \"terminated\"\n            except OSError as exc:\n                ended = f\"not terminated ({exc})\"\n            detail = (f\"pid {pid} on {host} alive with no event for {int(age)} s \"\n                      f\"(bound {bound} s); {ended}\")\n        else:\n            cls = \"died\"\n            detail = (f\"pid {pid} on {host} is not running and wrote no {marker.stem}.json; \"\n                      f\"started {info.get('at')}, last event {last_at or 'none'}\")\n        if next_attempt_number(records_dir, stage) != nn:\n            print(f\"attavo drive: stopped: {marker.name} names attempt {nn} but the next \"\n                  f\"{stage} record would be {next_attempt_number(records_dir, stage):02d}; \"\n                  f\"a later record already exists, read the records before recovering\")\n            return 1\n        schema = stage_schema(stage)\n        record = {k: None for k in schema.get(\"required\", [])}\n        approval = latest_record(records_dir, \"approval\") or {}\n        record.update({\"sha\": info.get(\"sha\"), \"start_sha\": info.get(\"sha\"),\n                       \"approval_sha\": approval.get(\"sha\"), \"at\": info.get(\"at\"),\n                       \"adapter\": (m.get(\"executor\") or {}).get(stage),\n                       \"status\": \"failed\", \"refusal\": None, \"halted\": None,\n                       \"stop\": {\"class\": cls, \"provenance\": \"product\", \"detail\": detail}})\n        if \"wall_clock_s\" in record:\n            record[\"wall_clock_s\"] = None if age is None else int(age)\n        record = {k: v for k, v in record.items() if k in schema.get(\"properties\", {})}\n        try:\n            path = write_record(records_dir, stage, record, m, item_id, log=log)\n        except ValueError as exc:\n            print(f\"attavo drive: stopped: could not write the {cls} record for {marker.stem}: {exc}\")\n            return 1\n        try:\n            commit_record(root, [path], f\"attavo: {stage} record for item {item_id} \"\n                                        f\"({path.stem}), recovered as {cls}\")\n        except RuntimeError as exc:\n            print(f\"attavo drive: stopped: could not commit the {cls} record: {exc}\")\n            return 1\n        if has_origin:\n            ok, err = push_record_commit(root, branch)\n            if not ok:\n                print(f\"attavo drive: stopped: could not push the {cls} record: {err}\")\n                return 1\n        else:\n            print(f\"attavo drive: note: no origin remote; {path.name} is committed, not pushed\")\n        print(f\"attavo drive: recovered {marker.stem} as {cls}: {detail}\")\n        recovered += 1\n    print(f\"attavo drive: item {item_id}: {recovered} invocation(s) recovered\")\n    return 0\n\n","numLines":245,"startLine":805,"totalLines":3663}}}

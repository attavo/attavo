{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AdD1n97h6X9e4aEA4fEJuo","type":"tool_result","content":"2440\t                           \"origin\", branch], capture_output=True, text=True, check=False)\n2441\t    if pull.returncode != 0:\n2442\t        return False, f\"push rejected and the retry merge failed: {pull.stderr.strip() or err}\"\n2443\t    ok, err = attempt()\n2444\t    if not ok:\n2445\t        return False, f\"push rejected again after merging {branch}: {err}\"\n2446\t    return True, None\n2447\t\n2448\t\n2449\tdef drive_state(root: Path, m: dict, item_id: str) -> tuple[str, str | None, Path]:\n2450\t    \"\"\"(\"no-approval\" | \"build\" | \"verify\" | \"ready\", detail, records_dir):\n2451\t    the next mechanical step for item_id, read from its latest records\n2452\t    alone. A build only counts as current when it is a pass bound to the\n2453\t    valid approval's own sha; a verify only counts as current when it is a\n2454\t    pass bound to that build's own sha -- the same staleness a re-approval\n2455\t    or a re-build must force, attest's own chain check already enforces\n2456\t    (check_attest_chain), read here rather than re-typed.\"\"\"\n2457\t    records_rel = m[\"paths\"][\"records\"]\n2458\t    records_dir = root / records_rel / item_id\n2459\t\n2460\t    status = approval_status(root, m, item_id)\n2461\t    if status != \"valid\":\n2462\t        return \"no-approval\", status, records_dir\n2463\t\n2464\t    latest_approval = latest_record(records_dir, \"approval\")\n2465\t    latest_build = latest_record(records_dir, \"build\")\n2466\t    build_current = (latest_build is not None and latest_build.get(\"status\") == \"pass\"\n2467\t                     and latest_build.get(\"approval_sha\") == (latest_approval or {}).get(\"sha\"))\n2468\t    if not build_current:\n2469\t        return \"build\", None, records_dir\n2470\t\n2471\t    latest_verify = latest_record(records_dir, \"verify\")\n2472\t    verify_current = (latest_verify is not None and latest_verify.get(\"status\") == \"pass\"\n2473\t                      and latest_verify.get(\"build_sha\") == latest_build.get(\"sha\"))\n2474\t    if not verify_current:\n2475\t        return \"verify\", None, records_dir\n2476\t\n2477\t    return \"ready\", None, records_dir\n2478\t\n2479\t\n2480\tdef _drive_run_stage(root: Path, records_dir: Path, branch: str, stage: str, item_id: str) -> int:\n2481\t    \"\"\"Runs build or verify in-process -- the same command `attavo build`\n2482\t    or `attavo verify` would run, printing the same reason on a refusal,\n2483\t    failure, or halt. A non-pass record is counseled (cmd_counsel, issue\n2484\t    #100) and filed (cmd_file_stops, issue #89) before it is transported,\n2485\t    so a stop's own counsel record and .filed marker -- the filing\n2486\t    command's stdout, the issue file-stops just opened -- exist on disk\n2487\t    in time to be committed and pushed in the very same commit as the\n2488\t    stage record and its log; a marker written only after the push would\n2489\t    never reach the ledger at all, and a second worktree or a fresh clone\n2490\t    would refile every stop it finds with no marker beside it. The stage\n2491\t    record and the counsel record (when one was written) are then\n2492\t    transported together: committed with commit_record and pushed with\n2493\t    push_record_commit, whatever the stage record's status -- the record\n2494\t    pushes stay the same pushes, made by drive in the run that produced\n2495\t    the record (issue #84's rule 42 row).\"\"\"\n2496\t    before = latest_attempt_path(records_dir, stage)\n2497\t    rc = cmd_build([item_id]) if stage == \"build\" else cmd_verify([item_id])\n2498\t    after = latest_attempt_path(records_dir, stage)\n2499\t\n2500\t    if after is None or after == before:\n2501\t        # Refused before writing anything at all (e.g. no adapter\n2502\t        # configured) -- the stage command already printed why.\n2503\t        return rc if rc != 0 else 1\n2504\t\n2505\t    record = latest_record(records_dir, stage)\n2506\t    status_out = record.get(\"status\")\n2507\t    to_commit = [after]\n2508\t    if status_out != \"pass\":\n2509\t        counsel_before = latest_attempt_path(records_dir, \"counsel\")\n2510\t        cmd_counsel([item_id])\n2511\t        counsel_after = latest_attempt_path(records_dir, \"counsel\")\n2512\t        if counsel_after is not None and counsel_after != counsel_before:\n2513\t            to_commit.append(counsel_after)\n2514\t        # file-stops is its own idempotent read of the item's records, so\n2515\t        # calling it here on every run that wrote a non-pass record is\n2516\t        # safe to call again on a later run: an already-filed stop's own\n2517\t        # marker is what stops it from being filed twice.\n2518\t        cmd_file_stops([item_id])\n2519\t\n2520\t    message = f\"attavo: {stage} record for item {item_id} ({after.stem})\"\n2521\t    try:\n2522\t        commit_record(root, to_commit, message)\n2523\t    except RuntimeError as exc:\n2524\t        print(f\"attavo drive: stopped: could not commit the {stage} record: {exc}\")\n2525\t        return 1\n2526\t\n2527\t    ok, err = push_record_commit(root, branch)\n2528\t    if not ok:\n2529\t        print(f\"attavo drive: stopped: could not push the {stage} record: {err}\")\n2530\t        return 1\n2531\t\n2532\t    if status_out == \"halted\":\n2533\t        question = (record.get(\"halted\") or {}).get(\"question\")\n2534\t        print(f\"attavo drive: stopped: {stage} halted: {question} ({after.name}); \"\n2535\t              f\"pushed to {branch}\")\n2536\t    elif status_out != \"pass\":\n2537\t        reason = record.get(\"refusal\") or status_out\n2538\t        print(f\"attavo drive: stopped: {stage} {status_out}: {reason} ({after.name}); \"\n2539\t              f\"pushed to {branch}\")\n2540\t    else:\n2541\t        print(f\"attavo drive: pushed {after.name} to {branch}\")\n2542\t    return rc\n2543\t\n2544\t\n2545\tdef _drive_step(root: Path, m: dict, item_id: str) -> tuple[int, bool]:\n2546\t    \"\"\"One mechanical step, exactly as a single `attavo drive` call always\n2547\t    has -- and whether repetition under --until-ready should stop here:\n2548\t    True for every refusal or stop (no valid approval, no\n2549\t    [forge].checks_command, the forge not green, or a stage that wrote a\n2550\t    non-pass record) and for the ready-to-merge terminal state; False\n2551\t    only when a stage just passed, so drive_state may have a further\n2552\t    stage to pursue on the next call.\"\"\"\n2553\t    try:\n2554\t        stage, extra, records_dir = drive_state(root, m, item_id)\n2555\t    except ShallowCheckoutError as exc:\n2556\t        print(f\"attavo drive: refused: {exc}\", file=sys.stderr)\n2557\t        return 2, True\n2558\t\n2559\t    if stage == \"no-approval\":\n2560\t        print(f\"attavo drive: refused: approval is {extra}\")\n2561\t        return 1, True\n2562\t\n2563\t    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n2564\t\n2565\t    if stage == \"build\":\n2566\t        rc = _drive_run_stage(root, records_dir, branch, \"build\", item_id)\n2567\t        return rc, rc != 0\n2568\t\n2569\t    checks_command = (m.get(\"forge\") or {}).get(\"checks_command\")\n2570\t    if not checks_command:\n2571\t        print(\"attavo drive: refused: no [forge].checks_command in the manifest\")\n2572\t        return 1, True\n2573\t    head_sha = git(root, \"rev-parse\", \"HEAD\").strip()\n2574\t    forge_checks, ok = poll_forge_checks(root, checks_command, head_sha)\n2575\t    if not ok:\n2576\t        conclusions = (\", \".join(f\"{c['name']} {c['conclusion']}\"\n2577\t                                 for c in forge_checks[\"conclusions\"])\n2578\t                      or \"no checks reported\")\n2579\t        print(f\"attavo drive: stopped: forge checks not green on {head_sha[:12]}: {conclusions}\")\n2580\t        return 1, True\n2581\t\n2582\t    if stage == \"verify\":\n2583\t        rc = _drive_run_stage(root, records_dir, branch, \"verify\", item_id)\n2584\t        return rc, rc != 0\n2585\t\n2586\t    print(f\"attavo drive: item {item_id} is ready to merge\")\n2587\t    return 0, True\n2588\t\n2589\t\n2590\tdef cmd_drive(argv: list[str]) -> int:\n2591\t    until_ready = \"--until-ready\" in argv\n2592\t    positional = [a for a in argv if a != \"--until-ready\"]\n2593\t    root = Path(\".\").resolve()\n2594\t    item_id = positional[0] if positional else derive_item_id(root)\n2595\t    if not item_id:\n2596\t        print(\"attavo drive: cannot derive item id; pass N or run on an attavo/N-* branch\",\n2597\t              file=sys.stderr)\n2598\t        return 2\n2599\t    m = read_manifest(root)\n2600\t    if m is None:\n2601\t        print(f\"attavo drive: no {MANIFEST} at {root}\", file=sys.stderr)\n2602\t        return 2\n2603\t\n2604\t    # Without --until-ready this is exactly one call to _drive_step,\n2605\t    # letter for letter what cmd_drive always did: `not until_ready`\n2606\t    # returns on the very first iteration regardless of `done`. With it,\n2607\t    # a step that just passed (done False) repeats -- step, wait (the\n2608\t    # forge poll already inside _drive_step), step, wait -- until the\n2609\t    # item is ready to merge or a step stops on its own account.\n2610\t    while True:\n2611\t        rc, done = _drive_step(root, m, item_id)\n2612\t        if done or not until_ready:\n2613\t            return rc\n2614\t\n2615\t\n2616\t# --- file-findings: one tenant issue per finding, nothing filed silently ---\n2617\t\n2618\tdef cmd_file_findings(argv: list[str]) -> int:\n2619\t    root = Path(\".\").resolve()\n2620\t    item_id = argv[0] if argv else derive_item_id(root)\n2621\t    if not item_id:\n2622\t        print(\"attavo file-findings: cannot derive item id; pass N or run on an attavo/N-* branch\",\n2623\t              file=sys.stderr)\n2624\t        return 2\n2625\t    m = read_manifest(root)\n2626\t    if m is None:\n2627\t        print(f\"attavo file-findings: no {MANIFEST} at {root}\", file=sys.stderr)\n2628\t        return 2\n2629\t\n2630\t    records_rel = m[\"paths\"][\"records\"]\n2631\t    item_records_dir = root / records_rel / item_id\n2632\t\n2633\t    forge_cfg = m.get(\"forge\") or {}\n2634\t    file_issue_command = forge_cfg.get(\"file_issue_command\")\n2635\t    if not file_issue_command:\n2636\t        print(\"attavo file-findings: refused: no [forge].file_issue_command in the manifest\")\n2637\t        return 1\n2638\t\n2639\t    latest_verify = latest_record(item_records_dir, \"verify\")\n2640\t    if latest_verify is None:\n2641\t        print(f\"attavo file-findings: refused: no verify record for item {item_id}\")\n2642\t        return 1\n2643\t\n2644\t    findings = latest_verify.get(\"findings\") or []\n2645\t    if not findings:\n2646\t        print(\"attavo file-findings: no findings to file\")\n2647\t        return 0\n2648\t\n2649\t    for finding in findings:\n2650\t        if not finding.get(\"retires\"):\n2651\t            title = finding.get(\"title\", \"<untitled>\")\n2652\t            print(f\"attavo file-findings: refused: finding {title!r} carries no retires; \"\n2653\t                  f\"nothing filed\")\n2654\t            return 1\n2655\t\n2656\t    for finding in findings:\n2657\t        run = subprocess.run(file_issue_command, shell=True, cwd=str(root),\n2658\t                             input=json.dumps(finding) + \"\\n\", capture_output=True,\n2659\t                             text=True, check=False)"}]},"parent_tool_use_id":null,"session_id":"1ecc940e-3f1e-4ce3-a5dd-7936fc9640f8","uuid":"f86bec6b-9e87-472c-907b-ff5076fd8f3c","timestamp":"2026-09-17T20:37:53.309Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-151/bin/attavo","content":"                           \"origin\", branch], capture_output=True, text=True, check=False)\n    if pull.returncode != 0:\n        return False, f\"push rejected and the retry merge failed: {pull.stderr.strip() or err}\"\n    ok, err = attempt()\n    if not ok:\n        return False, f\"push rejected again after merging {branch}: {err}\"\n    return True, None\n\n\ndef drive_state(root: Path, m: dict, item_id: str) -> tuple[str, str | None, Path]:\n    \"\"\"(\"no-approval\" | \"build\" | \"verify\" | \"ready\", detail, records_dir):\n    the next mechanical step for item_id, read from its latest records\n    alone. A build only counts as current when it is a pass bound to the\n    valid approval's own sha; a verify only counts as current when it is a\n    pass bound to that build's own sha -- the same staleness a re-approval\n    or a re-build must force, attest's own chain check already enforces\n    (check_attest_chain), read here rather than re-typed.\"\"\"\n    records_rel = m[\"paths\"][\"records\"]\n    records_dir = root / records_rel / item_id\n\n    status = approval_status(root, m, item_id)\n    if status != \"valid\":\n        return \"no-approval\", status, records_dir\n\n    latest_approval = latest_record(records_dir, \"approval\")\n    latest_build = latest_record(records_dir, \"build\")\n    build_current = (latest_build is not None and latest_build.get(\"status\") == \"pass\"\n                     and latest_build.get(\"approval_sha\") == (latest_approval or {}).get(\"sha\"))\n    if not build_current:\n        return \"build\", None, records_dir\n\n    latest_verify = latest_record(records_dir, \"verify\")\n    verify_current = (latest_verify is not None and latest_verify.get(\"status\") == \"pass\"\n                      and latest_verify.get(\"build_sha\") == latest_build.get(\"sha\"))\n    if not verify_current:\n        return \"verify\", None, records_dir\n\n    return \"ready\", None, records_dir\n\n\ndef _drive_run_stage(root: Path, records_dir: Path, branch: str, stage: str, item_id: str) -> int:\n    \"\"\"Runs build or verify in-process -- the same command `attavo build`\n    or `attavo verify` would run, printing the same reason on a refusal,\n    failure, or halt. A non-pass record is counseled (cmd_counsel, issue\n    #100) and filed (cmd_file_stops, issue #89) before it is transported,\n    so a stop's own counsel record and .filed marker -- the filing\n    command's stdout, the issue file-stops just opened -- exist on disk\n    in time to be committed and pushed in the very same commit as the\n    stage record and its log; a marker written only after the push would\n    never reach the ledger at all, and a second worktree or a fresh clone\n    would refile every stop it finds with no marker beside it. The stage\n    record and the counsel record (when one was written) are then\n    transported together: committed with commit_record and pushed with\n    push_record_commit, whatever the stage record's status -- the record\n    pushes stay the same pushes, made by drive in the run that produced\n    the record (issue #84's rule 42 row).\"\"\"\n    before = latest_attempt_path(records_dir, stage)\n    rc = cmd_build([item_id]) if stage == \"build\" else cmd_verify([item_id])\n    after = latest_attempt_path(records_dir, stage)\n\n    if after is None or after == before:\n        # Refused before writing anything at all (e.g. no adapter\n        # configured) -- the stage command already printed why.\n        return rc if rc != 0 else 1\n\n    record = latest_record(records_dir, stage)\n    status_out = record.get(\"status\")\n    to_commit = [after]\n    if status_out != \"pass\":\n        counsel_before = latest_attempt_path(records_dir, \"counsel\")\n        cmd_counsel([item_id])\n        counsel_after = latest_attempt_path(records_dir, \"counsel\")\n        if counsel_after is not None and counsel_after != counsel_before:\n            to_commit.append(counsel_after)\n        # file-stops is its own idempotent read of the item's records, so\n        # calling it here on every run that wrote a non-pass record is\n        # safe to call again on a later run: an already-filed stop's own\n        # marker is what stops it from being filed twice.\n        cmd_file_stops([item_id])\n\n    message = f\"attavo: {stage} record for item {item_id} ({after.stem})\"\n    try:\n        commit_record(root, to_commit, message)\n    except RuntimeError as exc:\n        print(f\"attavo drive: stopped: could not commit the {stage} record: {exc}\")\n        return 1\n\n    ok, err = push_record_commit(root, branch)\n    if not ok:\n        print(f\"attavo drive: stopped: could not push the {stage} record: {err}\")\n        return 1\n\n    if status_out == \"halted\":\n        question = (record.get(\"halted\") or {}).get(\"question\")\n        print(f\"attavo drive: stopped: {stage} halted: {question} ({after.name}); \"\n              f\"pushed to {branch}\")\n    elif status_out != \"pass\":\n        reason = record.get(\"refusal\") or status_out\n        print(f\"attavo drive: stopped: {stage} {status_out}: {reason} ({after.name}); \"\n              f\"pushed to {branch}\")\n    else:\n        print(f\"attavo drive: pushed {after.name} to {branch}\")\n    return rc\n\n\ndef _drive_step(root: Path, m: dict, item_id: str) -> tuple[int, bool]:\n    \"\"\"One mechanical step, exactly as a single `attavo drive` call always\n    has -- and whether repetition under --until-ready should stop here:\n    True for every refusal or stop (no valid approval, no\n    [forge].checks_command, the forge not green, or a stage that wrote a\n    non-pass record) and for the ready-to-merge terminal state; False\n    only when a stage just passed, so drive_state may have a further\n    stage to pursue on the next call.\"\"\"\n    try:\n        stage, extra, records_dir = drive_state(root, m, item_id)\n    except ShallowCheckoutError as exc:\n        print(f\"attavo drive: refused: {exc}\", file=sys.stderr)\n        return 2, True\n\n    if stage == \"no-approval\":\n        print(f\"attavo drive: refused: approval is {extra}\")\n        return 1, True\n\n    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n\n    if stage == \"build\":\n        rc = _drive_run_stage(root, records_dir, branch, \"build\", item_id)\n        return rc, rc != 0\n\n    checks_command = (m.get(\"forge\") or {}).get(\"checks_command\")\n    if not checks_command:\n        print(\"attavo drive: refused: no [forge].checks_command in the manifest\")\n        return 1, True\n    head_sha = git(root, \"rev-parse\", \"HEAD\").strip()\n    forge_checks, ok = poll_forge_checks(root, checks_command, head_sha)\n    if not ok:\n        conclusions = (\", \".join(f\"{c['name']} {c['conclusion']}\"\n                                 for c in forge_checks[\"conclusions\"])\n                      or \"no checks reported\")\n        print(f\"attavo drive: stopped: forge checks not green on {head_sha[:12]}: {conclusions}\")\n        return 1, True\n\n    if stage == \"verify\":\n        rc = _drive_run_stage(root, records_dir, branch, \"verify\", item_id)\n        return rc, rc != 0\n\n    print(f\"attavo drive: item {item_id} is ready to merge\")\n    return 0, True\n\n\ndef cmd_drive(argv: list[str]) -> int:\n    until_ready = \"--until-ready\" in argv\n    positional = [a for a in argv if a != \"--until-ready\"]\n    root = Path(\".\").resolve()\n    item_id = positional[0] if positional else derive_item_id(root)\n    if not item_id:\n        print(\"attavo drive: cannot derive item id; pass N or run on an attavo/N-* branch\",\n              file=sys.stderr)\n        return 2\n    m = read_manifest(root)\n    if m is None:\n        print(f\"attavo drive: no {MANIFEST} at {root}\", file=sys.stderr)\n        return 2\n\n    # Without --until-ready this is exactly one call to _drive_step,\n    # letter for letter what cmd_drive always did: `not until_ready`\n    # returns on the very first iteration regardless of `done`. With it,\n    # a step that just passed (done False) repeats -- step, wait (the\n    # forge poll already inside _drive_step), step, wait -- until the\n    # item is ready to merge or a step stops on its own account.\n    while True:\n        rc, done = _drive_step(root, m, item_id)\n        if done or not until_ready:\n            return rc\n\n\n# --- file-findings: one tenant issue per finding, nothing filed silently ---\n\ndef cmd_file_findings(argv: list[str]) -> int:\n    root = Path(\".\").resolve()\n    item_id = argv[0] if argv else derive_item_id(root)\n    if not item_id:\n        print(\"attavo file-findings: cannot derive item id; pass N or run on an attavo/N-* branch\",\n              file=sys.stderr)\n        return 2\n    m = read_manifest(root)\n    if m is None:\n        print(f\"attavo file-findings: no {MANIFEST} at {root}\", file=sys.stderr)\n        return 2\n\n    records_rel = m[\"paths\"][\"records\"]\n    item_records_dir = root / records_rel / item_id\n\n    forge_cfg = m.get(\"forge\") or {}\n    file_issue_command = forge_cfg.get(\"file_issue_command\")\n    if not file_issue_command:\n        print(\"attavo file-findings: refused: no [forge].file_issue_command in the manifest\")\n        return 1\n\n    latest_verify = latest_record(item_records_dir, \"verify\")\n    if latest_verify is None:\n        print(f\"attavo file-findings: refused: no verify record for item {item_id}\")\n        return 1\n\n    findings = latest_verify.get(\"findings\") or []\n    if not findings:\n        print(\"attavo file-findings: no findings to file\")\n        return 0\n\n    for finding in findings:\n        if not finding.get(\"retires\"):\n            title = finding.get(\"title\", \"<untitled>\")\n            print(f\"attavo file-findings: refused: finding {title!r} carries no retires; \"\n                  f\"nothing filed\")\n            return 1\n\n    for finding in findings:\n        run = subprocess.run(file_issue_command, shell=True, cwd=str(root),\n                             input=json.dumps(finding) + \"\\n\", capture_output=True,\n                             text=True, check=False)","numLines":220,"startLine":2440,"totalLines":3393}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TqiydosHRX1QvcYG6Up8DK","type":"tool_result","content":"1\t\"\"\"The doctor's four proofs, as tests written before the capability.\n2\t\n3\tEach test asserts that one proof holds against this repository. All four\n4\tfail at the first commit and must fail: that is the definition of done,\n5\tstated before anything exists to satisfy it. A test here turns green only\n6\twhen the capability it names has landed and been used for real.\n7\t\n8\tRun: python3 -m pytest tests -q\n9\t\"\"\"\n10\timport json\n11\timport shutil\n12\timport subprocess\n13\timport sys\n14\tfrom pathlib import Path\n15\t\n16\tfrom helpers import FIXTURES, commit_all, init_repo, make_tenant\n17\t\n18\tROOT = Path(__file__).resolve().parent.parent\n19\tATTAVO = ROOT / \"bin\" / \"attavo\"\n20\t\n21\t\n22\tdef run_doctor(root: Path) -> dict:\n23\t    out = subprocess.run([sys.executable, str(ATTAVO), \"doctor\", str(root), \"--json\"],\n24\t                         capture_output=True, text=True, check=False)\n25\t    report = json.loads(out.stdout)\n26\t    assert out.returncode == (0 if report[\"done\"] else 1)\n27\t    return {p[\"proof\"]: p for p in report[\"proofs\"]}\n28\t\n29\t\n30\tdef test_every_gate_rejects():\n31\t    \"\"\"Proof 1. Every gate in the manifest rejects its rejection fixture.\n32\t\n33\t    Holds when: a manifest exists, [gates] names at least one gate, each gate\n34\t    has a fixture under paths.rejections, and each gate exits non-zero on it.\n35\t    \"\"\"\n36\t    p = run_doctor(ROOT)[\"every-gate-rejects\"]\n37\t    assert p[\"holds\"], p[\"reason\"]\n38\t\n39\t\n40\tdef test_one_item_traversed_every_stage():\n41\t    \"\"\"Proof 2. One work item carries a record for spec, approval, build,\n42\t    verify, and attestation, every one written by a script.\"\"\"\n43\t    p = run_doctor(ROOT)[\"one-item-every-stage\"]\n44\t    assert p[\"holds\"], p[\"reason\"]\n45\t\n46\t\n47\tdef test_no_commit_lacks_a_record():\n48\t    \"\"\"Proof 3. Every commit on the default branch after the manifest was\n49\t    introduced is named by a record's sha or commits list.\"\"\"\n50\t    p = run_doctor(ROOT)[\"no-commit-lacks-record\"]\n51\t    assert p[\"holds\"], p[\"reason\"]\n52\t\n53\t\n54\tdef test_no_stop_lacks_cause():\n55\t    \"\"\"Proof 4, issue #94. Every non-pass build or verify record at\n56\t    record_version 3 or later carries a stop naming its class and cause.\"\"\"\n57\t    p = run_doctor(ROOT)[\"no-stop-lacks-cause\"]\n58\t    assert p[\"holds\"], p[\"reason\"]\n59\t\n60\t\n61\tdef test_record_loader_uses_highest_attempt_number(tmp_path):\n62\t    \"\"\"Acceptance 2a. <stage>-NN.json files are one stage's attempts; the\n63\t    doctor treats the highest NN as latest, and STAGES is unchanged.\n64\t\n65\t    spec-01.json names a commit that isn't on the branch at all; spec-02.json\n66\t    names the real code commit. Proof 3 holds only if the loader reads\n67\t    spec-02, not spec-01 -- i.e. only if it picks the highest attempt.\n68\t    \"\"\"\n69\t    root = tmp_path / \"attempts\"\n70\t    root.mkdir()\n71\t    (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n')\n72\t    init_repo(root, \"install\")\n73\t\n74\t    (root / \"src.txt\").write_text(\"code\\n\")\n75\t    commit_all(root, \"code change\")\n76\t    code_sha = subprocess.run([\"git\", \"-C\", str(root), \"rev-parse\", \"HEAD\"],\n77\t                              capture_output=True, text=True, check=True).stdout.strip()\n78\t\n79\t    records = root / \"records\" / \"1\"\n80\t    records.mkdir(parents=True)\n81\t    (records / \"spec-01.json\").write_text(json.dumps({\"sha\": \"0\" * 40}))\n82\t    (records / \"spec-02.json\").write_text(json.dumps({\"sha\": code_sha}))\n83\t    commit_all(root, \"spec records\")\n84\t\n85\t    p = run_doctor(root)[\"no-commit-lacks-record\"]\n86\t    assert p[\"holds\"], p[\"reason\"]\n87\t\n88\t\n89\tdef test_doctor_proof_two_counts_three_of_four_stages_still_red(tmp_path):\n90\t    \"\"\"Acceptance 8. A work item carrying spec, approval, and build records\n91\t    is three of the four STAGES proof two names; verify doesn't exist\n92\t    yet, so the proof stays red and names exactly that one as lacking.\n93\t    \"\"\"\n94\t    root = tmp_path / \"three_stages\"\n95\t    root.mkdir()\n96\t    (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n')\n97\t    init_repo(root, \"install\")\n98\t\n99\t    records = root / \"records\" / \"1\"\n100\t    records.mkdir(parents=True)\n101\t    (records / \"spec-01.json\").write_text(json.dumps({\"status\": \"pass\"}))\n102\t    (records / \"approval-01.json\").write_text(json.dumps({\"approved_by\": \"alice\"}))\n103\t    (records / \"build-01.json\").write_text(json.dumps({\"status\": \"pass\"}))\n104\t    commit_all(root, \"spec, approval, and build records\")\n105\t\n106\t    p = run_doctor(root)[\"one-item-every-stage\"]\n107\t    assert not p[\"holds\"]\n108\t    assert \"verify\" in p[\"reason\"]\n109\t    assert \"build\" not in p[\"reason\"]\n110\t\n111\t\n112\tdef test_doctor_proof_two_holds_on_a_fixture_carrying_all_four_stages_merged(tmp_path):\n113\t    \"\"\"Acceptance row 4, issue #69: attestation is retired as a record\n114\t    type -- STAGES is four stages, not five -- and proof two now also\n115\t    requires the four records to have reached HEAD by an actual merge\n116\t    commit, whose first-parent diff introduces all four, the same\n117\t    derivation attest itself uses. A fixture with one record per stage,\n118\t    landed on a branch and merged --no-ff, is enough to prove the\n119\t    mechanism.\"\"\"\n120\t    root = tmp_path / \"four_stages_merged\""}]},"parent_tool_use_id":null,"session_id":"1ecc940e-3f1e-4ce3-a5dd-7936fc9640f8","uuid":"0c8342f3-34c8-4c9e-bb1e-d3f02b93f354","timestamp":"2026-09-17T20:38:50.291Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-151/tests/test_doctor.py","content":"\"\"\"The doctor's four proofs, as tests written before the capability.\n\nEach test asserts that one proof holds against this repository. All four\nfail at the first commit and must fail: that is the definition of done,\nstated before anything exists to satisfy it. A test here turns green only\nwhen the capability it names has landed and been used for real.\n\nRun: python3 -m pytest tests -q\n\"\"\"\nimport json\nimport shutil\nimport subprocess\nimport sys\nfrom pathlib import Path\n\nfrom helpers import FIXTURES, commit_all, init_repo, make_tenant\n\nROOT = Path(__file__).resolve().parent.parent\nATTAVO = ROOT / \"bin\" / \"attavo\"\n\n\ndef run_doctor(root: Path) -> dict:\n    out = subprocess.run([sys.executable, str(ATTAVO), \"doctor\", str(root), \"--json\"],\n                         capture_output=True, text=True, check=False)\n    report = json.loads(out.stdout)\n    assert out.returncode == (0 if report[\"done\"] else 1)\n    return {p[\"proof\"]: p for p in report[\"proofs\"]}\n\n\ndef test_every_gate_rejects():\n    \"\"\"Proof 1. Every gate in the manifest rejects its rejection fixture.\n\n    Holds when: a manifest exists, [gates] names at least one gate, each gate\n    has a fixture under paths.rejections, and each gate exits non-zero on it.\n    \"\"\"\n    p = run_doctor(ROOT)[\"every-gate-rejects\"]\n    assert p[\"holds\"], p[\"reason\"]\n\n\ndef test_one_item_traversed_every_stage():\n    \"\"\"Proof 2. One work item carries a record for spec, approval, build,\n    verify, and attestation, every one written by a script.\"\"\"\n    p = run_doctor(ROOT)[\"one-item-every-stage\"]\n    assert p[\"holds\"], p[\"reason\"]\n\n\ndef test_no_commit_lacks_a_record():\n    \"\"\"Proof 3. Every commit on the default branch after the manifest was\n    introduced is named by a record's sha or commits list.\"\"\"\n    p = run_doctor(ROOT)[\"no-commit-lacks-record\"]\n    assert p[\"holds\"], p[\"reason\"]\n\n\ndef test_no_stop_lacks_cause():\n    \"\"\"Proof 4, issue #94. Every non-pass build or verify record at\n    record_version 3 or later carries a stop naming its class and cause.\"\"\"\n    p = run_doctor(ROOT)[\"no-stop-lacks-cause\"]\n    assert p[\"holds\"], p[\"reason\"]\n\n\ndef test_record_loader_uses_highest_attempt_number(tmp_path):\n    \"\"\"Acceptance 2a. <stage>-NN.json files are one stage's attempts; the\n    doctor treats the highest NN as latest, and STAGES is unchanged.\n\n    spec-01.json names a commit that isn't on the branch at all; spec-02.json\n    names the real code commit. Proof 3 holds only if the loader reads\n    spec-02, not spec-01 -- i.e. only if it picks the highest attempt.\n    \"\"\"\n    root = tmp_path / \"attempts\"\n    root.mkdir()\n    (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n')\n    init_repo(root, \"install\")\n\n    (root / \"src.txt\").write_text(\"code\\n\")\n    commit_all(root, \"code change\")\n    code_sha = subprocess.run([\"git\", \"-C\", str(root), \"rev-parse\", \"HEAD\"],\n                              capture_output=True, text=True, check=True).stdout.strip()\n\n    records = root / \"records\" / \"1\"\n    records.mkdir(parents=True)\n    (records / \"spec-01.json\").write_text(json.dumps({\"sha\": \"0\" * 40}))\n    (records / \"spec-02.json\").write_text(json.dumps({\"sha\": code_sha}))\n    commit_all(root, \"spec records\")\n\n    p = run_doctor(root)[\"no-commit-lacks-record\"]\n    assert p[\"holds\"], p[\"reason\"]\n\n\ndef test_doctor_proof_two_counts_three_of_four_stages_still_red(tmp_path):\n    \"\"\"Acceptance 8. A work item carrying spec, approval, and build records\n    is three of the four STAGES proof two names; verify doesn't exist\n    yet, so the proof stays red and names exactly that one as lacking.\n    \"\"\"\n    root = tmp_path / \"three_stages\"\n    root.mkdir()\n    (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n')\n    init_repo(root, \"install\")\n\n    records = root / \"records\" / \"1\"\n    records.mkdir(parents=True)\n    (records / \"spec-01.json\").write_text(json.dumps({\"status\": \"pass\"}))\n    (records / \"approval-01.json\").write_text(json.dumps({\"approved_by\": \"alice\"}))\n    (records / \"build-01.json\").write_text(json.dumps({\"status\": \"pass\"}))\n    commit_all(root, \"spec, approval, and build records\")\n\n    p = run_doctor(root)[\"one-item-every-stage\"]\n    assert not p[\"holds\"]\n    assert \"verify\" in p[\"reason\"]\n    assert \"build\" not in p[\"reason\"]\n\n\ndef test_doctor_proof_two_holds_on_a_fixture_carrying_all_four_stages_merged(tmp_path):\n    \"\"\"Acceptance row 4, issue #69: attestation is retired as a record\n    type -- STAGES is four stages, not five -- and proof two now also\n    requires the four records to have reached HEAD by an actual merge\n    commit, whose first-parent diff introduces all four, the same\n    derivation attest itself uses. A fixture with one record per stage,\n    landed on a branch and merged --no-ff, is enough to prove the\n    mechanism.\"\"\"\n    root = tmp_path / \"four_stages_merged\"","numLines":120,"startLine":1,"totalLines":746}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011aaNXfz9LAQ7uBYB2DbPaq","type":"tool_result","content":"864\tdef proof_no_commit_lacks_record(root: Path, m: dict | None) -> Proof:\n865\t    p = Proof(\"no-commit-lacks-record\", \"no commit lacks a record\")\n866\t    if m is None:\n867\t        return p.fail(f\"no {MANIFEST} at {root}; the tenant has no record boundary\")\n868\t    try:\n869\t        install = git(root, \"log\", \"--diff-filter=A\", \"--format=%H\",\n870\t                      \"--reverse\", \"--\", MANIFEST).split()\n871\t    except RuntimeError as exc:\n872\t        return p.fail(f\"git: {exc}\")\n873\t    if not install:\n874\t        return p.fail(f\"{MANIFEST} is not committed; the tenant has no record boundary\")\n875\t    install_sha = install[0]\n876\t    full_chain = git(root, \"rev-list\", f\"{install_sha}..HEAD\", \"--first-parent\").split()\n877\t    if not full_chain:\n878\t        return p.fail(f\"no commit after the install commit {install_sha[:12]}; nothing has been recorded\")\n879\t\n880\t    # issue #74: [doctor] from lets a tenant declare the doctor's read to\n881\t    # start at a later commit on main's first-parent line -- the point\n882\t    # after which every push arrived through the queue -- rather than the\n883\t    # install commit, which on a repository that adopted the product\n884\t    # after its history began is a boundary the doctor cannot otherwise\n885\t    # see. Any spelling git resolves is accepted (a short sha, a tag, a\n886\t    # ref) -- resolved with rev-parse --verify before the first-parent\n887\t    # check runs, so the two failure modes stay distinct: a spelling that\n888\t    # names no commit at all, and a commit that names one off the line.\n889\t    # Checked, not trusted: neither is silently forgiven back to install.\n890\t    declared_from = (m.get(\"doctor\") or {}).get(\"from\")\n891\t    window_start = install_sha\n892\t    if declared_from is not None:\n893\t        try:\n894\t            resolved_from = git(root, \"rev-parse\", \"--verify\", f\"{declared_from}^{{commit}}\").strip()\n895\t        except RuntimeError:\n896\t            return p.fail(f\"[doctor] from {declared_from} does not resolve to a commit\")\n897\t        if resolved_from != install_sha and resolved_from not in full_chain:\n898\t            return p.fail(f\"[doctor] from {declared_from} is not on main's first-parent \"\n899\t                          f\"line after the install commit {install_sha[:12]}\")\n900\t        window_start = resolved_from\n901\t\n902\t    if window_start == install_sha:\n903\t        window_spec = f\"{install_sha}..HEAD\"\n904\t        commits = full_chain\n905\t    else:\n906\t        window_spec = f\"{window_start}^..HEAD\"\n907\t        commits = git(root, \"rev-list\", window_spec, \"--first-parent\").split()\n908\t    before_window = len(full_chain) - len(commits)\n909\t\n910\t    records_rel = m.get(\"paths\", {}).get(\"records\", \"\")\n911\t    records_dir = root / records_rel\n912\t    named: set[str] = set()\n913\t    for stages in load_records(records_dir).values():\n914\t        for rec in stages.values():\n915\t            sha = rec.get(\"sha\")\n916\t            if isinstance(sha, str):\n917\t                named.add(sha)\n918\t            for c in rec.get(\"commits\", []) or []:\n919\t                if isinstance(c, str):\n920\t                    named.add(c)\n921\t    record_commits = set(git(root, \"rev-list\", window_spec, \"--first-parent\",\n922\t                             \"--\", records_rel).split()) if records_rel else set()\n923\t    merges = set(git(root, \"rev-list\", window_spec, \"--first-parent\", \"--merges\").split())\n924\t    boundary_paths = ((m.get(\"spec\") or {}).get(\"boundary\") or {}).get(\"paths\") or []\n925\t\n926\t    # Every first-parent commit in the window is exactly one of three\n927\t    # (issue #72): recorded (a record names it, or its diff touches\n928\t    # paths.records), ordinary (a merge that doesn't), or unrecorded\n929\t    # (anything else -- on a protected main with a queue, a non-merge\n930\t    # commit is the only way a change arrives without the forge).\n931\t    recorded, ordinary, unrecorded = [], [], []\n932\t    ordinary_commits, unrecorded_commits = [], []\n933\t    boundary_evasions = 0\n934\t    for c in commits:\n935\t        if c in named or c in record_commits:\n936\t            recorded.append(c)\n937\t        elif c in merges:\n938\t            ordinary.append(c)\n939\t            evasion = bool(boundary_paths and touches_boundary(root, c, boundary_paths))\n940\t            if evasion:\n941\t                boundary_evasions += 1\n942\t            ordinary_commits.append({\"sha\": c, \"subject\": commit_subject(root, c),\n943\t                                     \"boundary_evasion\": evasion})\n944\t        else:\n945\t            unrecorded.append(c)\n946\t            unrecorded_commits.append({\"sha\": c, \"subject\": commit_subject(root, c)})\n947\t\n948\t    counts = f\"{len(recorded)} recorded, {len(ordinary)} ordinary, {len(unrecorded)} unrecorded\"\n949\t    evasions = boundary_evasions if boundary_paths else \"n/a\"\n950\t    extra = {\"recorded\": len(recorded), \"ordinary\": len(ordinary),\n951\t             \"unrecorded\": len(unrecorded), \"boundary_evasions\": evasions,\n952\t             \"before_window\": before_window,\n953\t             \"ordinary_commits\": ordinary_commits, \"unrecorded_commits\": unrecorded_commits}\n954\t    if unrecorded:\n955\t        return p.fail(f\"{unrecorded[-1][:12]} lacks a record; {counts}; boundary evasions: \"\n956\t                      f\"{evasions}; before the window: {before_window}\", **extra)\n957\t    return p.hold(f\"{counts}; boundary evasions: {evasions}; before the window: {before_window}\",\n958\t                  **extra)\n959\t\n960\t\n961\tADAPTER_EXIT_RE = re.compile(r\"^\\[adapter exited \\d+\\]$\")\n962\t\n963\t\n964\tdef _log_owes_tool_error(log: str | None) -> bool:\n965\t    \"\"\"True when a log's last non-empty line is exactly an adapter-exit\n966\t    marker and every line before it parses as JSON -- an adapter's own\n967\t    event stream, never a tool's own words (issue #94's own specimen,\n968\t    tenant zero's attest/records/659/verify-01.log: codex's\n969\t    \"thread.started\" event, then nothing but \"[adapter exited 1]\" -- the\n970\t    tool's real error line dropped before this reached the log, issue\n971\t    #86's own bug in split_adapter_stdout). A log that is only the exit\n972\t    marker, nothing before it at all, still owes the same line.\"\"\"\n973\t    if not log:\n974\t        return False\n975\t    lines = [l for l in log.splitlines() if l.strip()]\n976\t    if not lines or not ADAPTER_EXIT_RE.match(lines[-1]):\n977\t        return False\n978\t    for l in lines[:-1]:\n979\t        try:\n980\t            json.loads(l)\n981\t        except ValueError:\n982\t            return False\n983\t    return True\n984\t\n985\t"}]},"parent_tool_use_id":null,"session_id":"1ecc940e-3f1e-4ce3-a5dd-7936fc9640f8","uuid":"c4f52d7b-2294-486e-8c74-1c6d9cdbd356","timestamp":"2026-09-17T20:38:38.947Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-151/bin/attavo","content":"def proof_no_commit_lacks_record(root: Path, m: dict | None) -> Proof:\n    p = Proof(\"no-commit-lacks-record\", \"no commit lacks a record\")\n    if m is None:\n        return p.fail(f\"no {MANIFEST} at {root}; the tenant has no record boundary\")\n    try:\n        install = git(root, \"log\", \"--diff-filter=A\", \"--format=%H\",\n                      \"--reverse\", \"--\", MANIFEST).split()\n    except RuntimeError as exc:\n        return p.fail(f\"git: {exc}\")\n    if not install:\n        return p.fail(f\"{MANIFEST} is not committed; the tenant has no record boundary\")\n    install_sha = install[0]\n    full_chain = git(root, \"rev-list\", f\"{install_sha}..HEAD\", \"--first-parent\").split()\n    if not full_chain:\n        return p.fail(f\"no commit after the install commit {install_sha[:12]}; nothing has been recorded\")\n\n    # issue #74: [doctor] from lets a tenant declare the doctor's read to\n    # start at a later commit on main's first-parent line -- the point\n    # after which every push arrived through the queue -- rather than the\n    # install commit, which on a repository that adopted the product\n    # after its history began is a boundary the doctor cannot otherwise\n    # see. Any spelling git resolves is accepted (a short sha, a tag, a\n    # ref) -- resolved with rev-parse --verify before the first-parent\n    # check runs, so the two failure modes stay distinct: a spelling that\n    # names no commit at all, and a commit that names one off the line.\n    # Checked, not trusted: neither is silently forgiven back to install.\n    declared_from = (m.get(\"doctor\") or {}).get(\"from\")\n    window_start = install_sha\n    if declared_from is not None:\n        try:\n            resolved_from = git(root, \"rev-parse\", \"--verify\", f\"{declared_from}^{{commit}}\").strip()\n        except RuntimeError:\n            return p.fail(f\"[doctor] from {declared_from} does not resolve to a commit\")\n        if resolved_from != install_sha and resolved_from not in full_chain:\n            return p.fail(f\"[doctor] from {declared_from} is not on main's first-parent \"\n                          f\"line after the install commit {install_sha[:12]}\")\n        window_start = resolved_from\n\n    if window_start == install_sha:\n        window_spec = f\"{install_sha}..HEAD\"\n        commits = full_chain\n    else:\n        window_spec = f\"{window_start}^..HEAD\"\n        commits = git(root, \"rev-list\", window_spec, \"--first-parent\").split()\n    before_window = len(full_chain) - len(commits)\n\n    records_rel = m.get(\"paths\", {}).get(\"records\", \"\")\n    records_dir = root / records_rel\n    named: set[str] = set()\n    for stages in load_records(records_dir).values():\n        for rec in stages.values():\n            sha = rec.get(\"sha\")\n            if isinstance(sha, str):\n                named.add(sha)\n            for c in rec.get(\"commits\", []) or []:\n                if isinstance(c, str):\n                    named.add(c)\n    record_commits = set(git(root, \"rev-list\", window_spec, \"--first-parent\",\n                             \"--\", records_rel).split()) if records_rel else set()\n    merges = set(git(root, \"rev-list\", window_spec, \"--first-parent\", \"--merges\").split())\n    boundary_paths = ((m.get(\"spec\") or {}).get(\"boundary\") or {}).get(\"paths\") or []\n\n    # Every first-parent commit in the window is exactly one of three\n    # (issue #72): recorded (a record names it, or its diff touches\n    # paths.records), ordinary (a merge that doesn't), or unrecorded\n    # (anything else -- on a protected main with a queue, a non-merge\n    # commit is the only way a change arrives without the forge).\n    recorded, ordinary, unrecorded = [], [], []\n    ordinary_commits, unrecorded_commits = [], []\n    boundary_evasions = 0\n    for c in commits:\n        if c in named or c in record_commits:\n            recorded.append(c)\n        elif c in merges:\n            ordinary.append(c)\n            evasion = bool(boundary_paths and touches_boundary(root, c, boundary_paths))\n            if evasion:\n                boundary_evasions += 1\n            ordinary_commits.append({\"sha\": c, \"subject\": commit_subject(root, c),\n                                     \"boundary_evasion\": evasion})\n        else:\n            unrecorded.append(c)\n            unrecorded_commits.append({\"sha\": c, \"subject\": commit_subject(root, c)})\n\n    counts = f\"{len(recorded)} recorded, {len(ordinary)} ordinary, {len(unrecorded)} unrecorded\"\n    evasions = boundary_evasions if boundary_paths else \"n/a\"\n    extra = {\"recorded\": len(recorded), \"ordinary\": len(ordinary),\n             \"unrecorded\": len(unrecorded), \"boundary_evasions\": evasions,\n             \"before_window\": before_window,\n             \"ordinary_commits\": ordinary_commits, \"unrecorded_commits\": unrecorded_commits}\n    if unrecorded:\n        return p.fail(f\"{unrecorded[-1][:12]} lacks a record; {counts}; boundary evasions: \"\n                      f\"{evasions}; before the window: {before_window}\", **extra)\n    return p.hold(f\"{counts}; boundary evasions: {evasions}; before the window: {before_window}\",\n                  **extra)\n\n\nADAPTER_EXIT_RE = re.compile(r\"^\\[adapter exited \\d+\\]$\")\n\n\ndef _log_owes_tool_error(log: str | None) -> bool:\n    \"\"\"True when a log's last non-empty line is exactly an adapter-exit\n    marker and every line before it parses as JSON -- an adapter's own\n    event stream, never a tool's own words (issue #94's own specimen,\n    tenant zero's attest/records/659/verify-01.log: codex's\n    \"thread.started\" event, then nothing but \"[adapter exited 1]\" -- the\n    tool's real error line dropped before this reached the log, issue\n    #86's own bug in split_adapter_stdout). A log that is only the exit\n    marker, nothing before it at all, still owes the same line.\"\"\"\n    if not log:\n        return False\n    lines = [l for l in log.splitlines() if l.strip()]\n    if not lines or not ADAPTER_EXIT_RE.match(lines[-1]):\n        return False\n    for l in lines[:-1]:\n        try:\n            json.loads(l)\n        except ValueError:\n            return False\n    return True\n\n","numLines":122,"startLine":864,"totalLines":3393}}}

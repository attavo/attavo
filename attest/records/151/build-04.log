ct_acts\": 0, \"executor_commits\": 0,\n                     \"stops\": 0, \"since\": None}\n\n    first_spec_sha = first_commit_touching(root, str(Path(specs_rel) / item_id))\n    if first_spec_sha is None:\n        return {\"item\": item_id, \"rows\": [], \"summary\": empty_summary}\n\n    merge_sha = merge_introducing_records(root, records_rel, item_id, STAGES)\n    if merge_sha is not None:\n        branch_tip = git(root, \"rev-parse\", f\"{merge_sha}^2\").strip()\n        commits = commits_since(root, f\"{first_spec_sha}^\", end=branch_tip)\n        commits += commits_since(root, f\"{merge_sha}^1\", end=merge_sha)\n    else:\n        commits = commits_since(root, f\"{first_spec_sha}^\", end=\"HEAD\")\n\n    driver = driver_identity()\n    rows: list[dict] = []\n    operator_acts = product_acts = executor_commits = 0\n    since = None\n    approval_seen = False\n\n    for c in commits:\n        sha, name, email = c[\"sha\"], c[\"name\"], c[\"email\"]\n\n        if merge_sha is not None and sha == merge_sha:\n            rows.append({\"sha\": sha, \"identity\": name, \"class\": \"merge\"})\n            operator_acts += 1\n            continue\n\n        if email.startswith(\"executor+\") and email.endswith(\"@attavo.invalid\"):\n            rows.append({\"sha\": sha, \"identity\": name, \"class\": \"change\"})\n            executor_commits += 1\n            continue\n\n        touched = _commit_touches(root, sha)\n        record_touch = None\n        for p in touched:","numLines":50,"startLine":3355,"totalLines":3665}}}

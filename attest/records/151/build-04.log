-- where proof three's window starts. A tenant that adopted the product on a repository with pre-existing history names the commit after which every push arrived through the queue. Resolved and checked against main's first-parent line, not trusted: a spelling that does not resolve, or a commit that is not on that line, is refused by name.\",\n          \"minLength\": 1\n        }\n      }\n    },\n    \"drive\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"stall_after_s\": {\n          \"type\": \"integer\",\n          \"minimum\": 1,\n          \"description\": \"seconds without a new event past which a live invocation is hung; attavo drive --recover terminates and records it\"\n        }\n      }\n    }\n  }\n}","originalFile":"{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"$id\": \"https://attavo.dev/schema/manifest/1\",\n  \"title\": \"Attavo tenant manifest (attavo.toml)\",\n  \"description\": \"What a tenant declares to install Attavo: the release it pins, the executor it chose, where the governed path begins and ends, the gates it runs, and where its specs, records, and rulings live. Every key is read by a script; a key no script reads does not belong here.\",\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"required\": [\"schema_version\", \"attavo\", \"executor\", \"spec\", \"gates\", \"paths\", \"operators\"],\n  \"properties\": {\n    \"schema_version\": {\n      \"type\": \"integer\",\n      \"const\": 1\n    },\n    \"attavo\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\"version\"],\n      \"properties\": {\n        \"version\": {\n          \"type\": \"string\",\n          \"description\": \"The Attavo release tag the tenant pins. The tenant holds no Attavo binary; the pinned action supplies it.\",\n          \"pattern\": \"^v[0-9]+\\\\.[0-9]+\\\\.[0-9]+$\"\n        }\n      }\n    },\n    \"executor\": {\n      \"type\": \"object\",\n      \"required\": [\"build\"],\n      \"properties\": {\n        \"build\": {\n          \"type\": \"string\",\n          \"description\": \"Adapter name for the build invocation. The contract is thin: spec, corpus, and branch in; commits and a report record out.\",\n          \"minLength\": 1\n        },\n        \"verify\": {\n          \"type\": \"string\",\n          \"description\": \"Adapter name for the verify invocation. Defaults to build's adapter; may differ.\",\n          \"minLength\": 1\n        }\n      },\n      \"additionalProperties\": {\n        \"type\": \"object\",\n        \"description\": \"[executor.<adapter-name>]: that adapter's own configuration, passed through as ATTAVO_ADAPTER_CONFIG and copied verbatim into build-NN.json as adapter_config. The product does not know what an adapter's settings mean -- any keys, none required. Never put a secret in here: it lands in a record.\"\n      }\n    },\n    \"tests\": {\n      \"type\": \"object\",\n      \"description\": \"How build finds and runs the tests for a touched path. Both keys are required together; a tenant with no [tests] table has not declared selection, and attavo build refuses to run on it.\",\n      \"additionalProperties\": false,\n      \"required\": [\"select\", \"run\"],\n      \"properties\": {\n        \"select\": {\n          \"type\": \"string\",\n          \"description\": \"A command that reads touched paths on stdin, one per line, and writes test identifiers on stdout, one per line.\",\n          \"minLength\": 1\n        },\n        \"run\": {\n          \"type\": \"string\",\n          \"description\": \"A command that reads test identifiers on stdin, one per line; its exit code is the verdict.\",\n          \"minLength\": 1\n        }\n      }\n    },\n    \"checks\": {\n      \"type\": \"object\",\n      \"description\": \"The tenant's own definition of done: a whole-tree check, as the tenant runs it locally. attavo build runs it each iteration, after the claims boundary, the criteria, and the selected tests -- pass requires its exit to be 0, and a non-zero exit reaches the executor as feedback. Optional; a tenant that declares none is not refused (unlike [tests], which build requires).\",\n      \"additionalProperties\": false,\n      \"required\": [\"command\"],\n      \"properties\": {\n        \"command\": {\n          \"type\": \"string\",\n          \"description\": \"The tenant's whole-tree check, run from the tenant root.\",\n          \"minLength\": 1\n        }\n      }\n    },\n    \"forge\": {\n      \"type\": \"object\",\n      \"description\": \"The tenant's own commit-status and issue-tracking reads. The product names no vendor: both keys are commands the tenant supplies. Optional; attavo verify refuses without checks_command, and attavo file-findings refuses without file_issue_command, but neither key requires the other.\",\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"checks_command\": {\n          \"type\": \"string\",\n          \"description\": \"Takes a full commit sha on argv; prints one line per check as \\\"<name> <conclusion>\\\". attavo verify runs it on the item's latest build record's sha before calling any adapter.\",\n          \"minLength\": 1\n        },\n        \"file_issue_command\": {\n          \"type\": \"string\",\n          \"description\": \"Reads one finding as JSON on stdin and files it as a tenant issue. attavo file-findings runs it once per finding in the item's latest verify record.\",\n          \"minLength\": 1\n        }\n      }\n    },\n    \"spec\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\"boundary\"],\n      \"properties\": {\n        \"boundary\": {\n          \"type\": \"object\",\n          \"description\": \"Which changes take the governed path. A change outside the boundary takes the tenant's ordinary pull-request flow, and the path ratio measures both.\",\n          \"additionalProperties\": false,\n          \"properties\": {\n            \"paths\": {\n              \"type\": \"array\",\n              \"items\": {\"type\": \"string\", \"minLength\": 1},\n              \"description\": \"Glob patterns; a change touching any of them is governed.\"\n            },\n            \"labels\": {\n              \"type\": \"array\",\n              \"items\": {\"type\": \"string\", \"minLength\": 1},\n              \"description\": \"Issue labels; an issue carrying any of them is governed.\"\n            },\n            \"max_ordinary_lines\": {\n              \"type\": \"integer\",\n              \"minimum\": 0,\n              \"description\": \"A change above this many net lines is governed regardless of path or label.\"\n            }\n          }\n        }\n      }\n    },\n    \"gates\": {\n      \"type\": \"object\",\n      \"description\": \"Every gate the tenant runs, by name. The doctor's first proof is that each one rejects its fixture; a gate absent from this table does not exist.\",\n      \"propertyNames\": {\"pattern\": \"^[a-z][a-z0-9-]*$\"},\n      \"additionalProperties\": {\n        \"type\": \"object\",\n        \"additionalProperties\": false,\n        \"required\": [\"command\", \"retires\"],\n        \"properties\": {\n          \"command\": {\n            \"type\": \"string\",\n            \"description\": \"The script the gate runs, invoked with the tenant root as its working directory. Exit status is the verdict: non-zero rejects.\",\n            \"minLength\": 1\n          },\n          \"retires\": {\n            \"type\": \"array\",\n            \"minItems\": 1,\n            \"items\": {\"type\": \"string\", \"minLength\": 1},\n            \"description\": \"What this gate replaced. A gate that retires nothing is not admitted to the table.\"\n          }\n        }\n      }\n    },\n    \"paths\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\"specs\", \"records\", \"rulings\", \"rejections\"],\n      \"properties\": {\n        \"specs\": {\"type\": \"string\", \"minLength\": 1, \"description\": \"Directory of specs, one per work item, named by issue number.\"},\n        \"rejections\": {\"type\": \"string\", \"minLength\": 1, \"description\": \"Directory of rejection fixtures, one subdirectory per gate name. The doctor's first proof runs each gate against its fixture and requires a rejection.\"},\n        \"records\": {\"type\": \"string\", \"minLength\": 1, \"description\": \"Directory of records, append-only, one subdirectory per work item named by issue number. Scripts write every file here.\"},\n        \"rulings\": {\"type\": \"string\", \"minLength\": 1, \"description\": \"The tenant's rulings file, rendered read-only; the merge of a proposed amendment is the ruling.\"}\n      }\n    },\n    \"operators\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\"approvers\"],\n      \"properties\": {\n        \"approvers\": {\n          \"type\": \"array\",\n          \"items\": {\"type\": \"string\", \"minLength\": 1},\n          \"description\": \"Logins allowed to bind a spec's approval to a commit. `attavo approve` refuses a LOGIN not on this list.\"\n        }\n      }\n    },\n    \"doctor\": {\n      \"type\": \"object\",\n      \"description\": \"Optional; the doctor's own read. Absent, proof three's window starts at the install commit, as it always has.\",\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"from\": {\n          \"type\": \"string\",\n          \"description\": \"Anything git rev-parse --verify resolves to a commit on main's first-parent line, at or after the install commit -- a full or abbreviated sha, a tag, a ref -- where proof three's window starts. A tenant that adopted the product on a repository with pre-existing history names the commit after which every push arrived through the queue. Resolved and checked against main's first-parent line, not trusted: a spelling that does not resolve, or a commit that is not on that line, is refused by name.\",\n          \"minLength\": 1\n        }\n      }\n    }\n  }\n}\n","structuredPatch":[{"oldStart":177,"oldLines":6,"newStart":177,"newLines":17,"lines":["           \"minLength\": 1","         }","       }","+    },","+    \"drive\": {","+      \"type\": \"object\",","+      \"additionalProperties\": false,","+      \"properties\": {","+        \"stall_after_s\": {","+          \"type\": \"integer\",","+          \"minimum\": 1,","+          \"description\": \"seconds without a new event past which a live invocation is hung; attavo drive --recover terminates and records it\"","+        }","+      }","     }","   }"," }"]}],"userModified":false,"replaceAll":false}}

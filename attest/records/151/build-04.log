wn commits\",\n  \"the || true step in ci.yml that ran the doctor's four proofs against this repository expected to still fail\",\n  \"the reviewing session as the reader of whether the lane did what the issue said\",\n]\n\n[tests]\nselect = \"python3 .attavo/bin/select-tests\"\nrun = \"xargs -r python3 -m pytest -q --deselect tests/test_doctor.py::test_every_gate_rejects --deselect tests/test_doctor.py::test_one_item_traversed_every_stage --deselect tests/test_doctor.py::test_no_commit_lacks_a_record --deselect tests/test_doctor.py::test_no_stop_lacks_cause\"\n\n[paths]\nspecs = \"attest/specs\"\nrecords = \"attest/records\"\nrulings = \"attest/rulings.md\"\nrejections = \"attest/rejections\"\n\n[operators]\napprovers = [\"dbean10\"]\n\n[checks]\ncommand = \"python3 -m pytest tests -q --deselect tests/test_doctor.py::test_every_gate_rejects --deselect tests/test_doctor.py::test_one_item_traversed_every_stage --deselect tests/test_doctor.py::test_no_commit_lacks_a_record --deselect tests/test_doctor.py::test_no_stop_lacks_cause\"\n","structuredPatch":[{"oldStart":46,"oldLines":3,"newStart":46,"newLines":6,"lines":[" "," [checks]"," command = \"python3 -m pytest tests -q --deselect tests/test_doctor.py::test_every_gate_rejects --deselect tests/test_doctor.py::test_one_item_traversed_every_stage --deselect tests/test_doctor.py::test_no_commit_lacks_a_record --deselect tests/test_doctor.py::test_no_stop_lacks_cause\"","+","+[drive]","+stall_after_s = 1800"]}],"userModified":false,"replaceAll":false}}

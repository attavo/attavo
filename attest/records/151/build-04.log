{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BbKFri7gr8FWkof3fRa8Ju","type":"tool_result","content":"954\t\n955\t\n956\tdef _drive_recover(root: Path, m: dict, item_id: str) -> int:\n957\t    \"\"\"`attavo drive --recover [N]`: every invocation of item N that began\n958\t    and wrote no record ends in one here -- class died when its pid is\n959\t    gone or on another host, class hung when it is alive past\n960\t    [drive].stall_after_s with no newer event (and terminated); provenance\n961\t    product; the events tail as the log. A live invocation inside the\n962\t    bound is running and left alone. The record is committed and pushed\n963\t    the way every stage record is; the ordinary relaunch then reads a\n964\t    non-pass record and does what it does.\"\"\"\n965\t    import os\n966\t    import signal\n967\t    records_rel = m[\"paths\"][\"records\"]\n968\t    records_dir = root / records_rel / item_id\n969\t    bound = stall_bound_s(m)\n970\t    if bound is None:\n971\t        print(\"attavo drive: refused: no [drive].stall_after_s in the manifest; a hung \"\n972\t              \"invocation cannot be told from a running one\")\n973\t        return 1\n974\t    pending = invocations_without_record(records_dir)\n975\t    if not pending:\n976\t        print(f\"attavo drive: item {item_id}: every invocation has its record; nothing to recover\")\n977\t        return 0\n978\t    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n979\t    try:\n980\t        git(root, \"remote\", \"get-url\", \"origin\")\n981\t        has_origin = True\n982\t    except RuntimeError:\n983\t        has_origin = False\n984\t    recovered = 0\n985\t    for marker, info in pending:\n986\t        stage, nn_text = marker.stem.rsplit(\"-\", 1)\n987\t        nn = int(nn_text)\n988\t        events = _events_path_for(root, stage, nn)\n989\t        log, last_at = _events_tail(events)\n990\t        age = _seconds_since(last_at or info.get(\"at\"))\n991\t        pid, host = info.get(\"pid\"), info.get(\"host\")\n992\t        if invocation_alive(info):\n993\t            if age is None or age <= bound:\n994\t                print(f\"attavo drive: {marker.stem} is running (pid {pid}, last event \"\n995\t                      f\"{'unknown' if age is None else int(age)} s ago, bound {bound} s); \"\n996\t                      f\"nothing to recover\")\n997\t                continue\n998\t            cls = \"hung\"\n999\t            try:\n1000\t                os.kill(int(pid), signal.SIGTERM)\n1001\t                ended = \"terminated\"\n1002\t            except OSError as exc:\n1003\t                ended = f\"not terminated ({exc})\"\n1004\t            detail = (f\"pid {pid} on {host} alive with no event for {int(age)} s \"\n1005\t                      f\"(bound {bound} s); {ended}\")\n1006\t        else:\n1007\t            cls = \"died\"\n1008\t            detail = (f\"pid {pid} on {host} is not running and wrote no {marker.stem}.json; \"\n1009\t                      f\"started {info.get('at')}, last event {last_at or 'none'}\")\n1010\t        if next_attempt_number(records_dir, stage) != nn:\n1011\t            print(f\"attavo drive: stopped: {marker.name} names attempt {nn} but the next \"\n1012\t                  f\"{stage} record would be {next_attempt_number(records_dir, stage):02d}; \"\n1013\t                  f\"a later record already exists, read the records before recovering\")\n1014\t            return 1\n1015\t        schema = stage_schema(stage)\n1016\t        record = {k: None for k in schema.get(\"required\", [])}\n1017\t        approval = latest_record(records_dir, \"approval\") or {}\n1018\t        record.update({\"sha\": info.get(\"sha\"), \"start_sha\": info.get(\"sha\"),\n1019\t                       \"approval_sha\": approval.get(\"sha\"), \"at\": info.get(\"at\"),\n1020\t                       \"adapter\": (m.get(\"executor\") or {}).get(stage),\n1021\t                       \"status\": \"failed\", \"refusal\": None, \"halted\": None,\n1022\t                       \"stop\": {\"class\": cls, \"provenance\": \"product\", \"detail\": detail}})\n1023\t        if \"wall_clock_s\" in record:\n1024\t            record[\"wall_clock_s\"] = None if age is None else int(age)\n1025\t        record = {k: v for k, v in record.items() if k in schema.get(\"properties\", {})}\n1026\t        try:\n1027\t            path = write_record(records_dir, stage, record, m, item_id, log=log)\n1028\t        except ValueError as exc:\n1029\t            print(f\"attavo drive: stopped: could not write the {cls} record for {marker.stem}: {exc}\")\n1030\t            return 1\n1031\t        try:\n1032\t            commit_record(root, [path], f\"attavo: {stage} record for item {item_id} \"\n1033\t                                        f\"({path.stem}), recovered as {cls}\")\n1034\t        except RuntimeError as exc:\n1035\t            print(f\"attavo drive: stopped: could not commit the {cls} record: {exc}\")\n1036\t            return 1\n1037\t        if has_origin:\n1038\t            ok, err = push_record_commit(root, branch)\n1039\t            if not ok:\n1040\t                print(f\"attavo drive: stopped: could not push the {cls} record: {err}\")\n1041\t                return 1\n1042\t        else:\n1043\t            print(f\"attavo drive: note: no origin remote; {path.name} is committed, not pushed\")\n1044\t        print(f\"attavo drive: recovered {marker.stem} as {cls}: {detail}\")\n1045\t        recovered += 1\n1046\t    print(f\"attavo drive: item {item_id}: {recovered} invocation(s) recovered\")\n1047\t    return 0\n1048\t\n1049\t\n1050\tdef proof_one_item_every_stage(root: Path, m: dict | None) -> Proof:\n1051\t    p = Proof(\"one-item-every-stage\", \"one item has traversed every stage\")\n1052\t    if m is None:\n1053\t        return p.fail(f\"no {MANIFEST} at {root}; no records directory is declared\")"}]},"parent_tool_use_id":null,"session_id":"1ecc940e-3f1e-4ce3-a5dd-7
r\"}\n        }\n      }\n    },\n    \"selected_tests\": {\n      \"type\": [\"object\", \"null\"],\n      \"additionalProperties\": false,\n      \"required\": [\"select\", \"run\", \"count\", \"exit\"],\n      \"properties\": {\n        \"select\": {\"type\": \"string\", \"minLength\": 1},\n        \"run\": {\"type\": \"string\", \"minLength\": 1},\n        \"count\": {\"type\": \"integer\", \"minimum\": 0},\n        \"exit\": {\"type\": \"integer\"}\n      }\n    },\n    \"checks\": {\n      \"type\": [\"object\", \"null\"],\n      \"description\": \"Null when the manifest declares no [checks] table.\",\n      \"additionalProperties\": false,\n      \"required\": [\"command\", \"exit\"],\n      \"properties\": {\n        \"command\": {\"type\": \"string\", \"minLength\": 1},\n        \"exit\": {\"type\": \"integer\"}\n      }\n    },\n    \"tokens\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\"input\", \"output\"],\n      \"properties\": {\n        \"input\": {\"type\": \"integer\", \"minimum\": 0},\n        \"output\": {\"type\": \"integer\", \"minimum\": 0}\n      }\n    },\n    \"cost_usd\": {\n      \"type\": [\"number\", \"null\"],\n      \"description\": \"The tool's list-price meter, from the adapter's own report. Billed only when the build ran under adapter_config.auth = \\\"api\\\"; under auth = \\\"subscription\\\" this figure is a measure, not a bill -- usage is included in the operator's plan.\"\n    },\n    \"wall_clock_s\": {\"type\": \"number\", \"minimum\": 0},\n    \"status\": {\"type\": \"string\", \"enum\": [\"pass\", \"refused\", \"halted\", \"failed\"]},\n    \"refusal\": {\"type\": [\"string\", \"null\"]},\n    \"halted\": {\n      \"type\": [\"object\", \"null\"],\n      \"additionalProperties\": false,\n      \"required\": [\"question\"],\n      \"properties\": {\n        \"question\": {\"type\": [\"string\", \"null\"]}\n      }\n    },\n    \"stop\": {\n      \"type\": [\"object\", \"null\"],\n      \"description\": \"Non-null exactly when status is not \\\"pass\\\" (issue #89): what class of stop this is and whose it is, derived by the record writer from the refusal, halted, and log it already has -- never a fresh read of anything.\",\n      \"additionalProperties\": false,\n      \"required\": [\"class\", \"provenance\", \"detail\"],\n      \"properties\": {\n        \"class\": {\n          \"type\": \"string\",\n          \"enum\": [\"non-question\", \"outlived-invocation\", \"no-cause\", \"forge-unconcluded\",\n                   \"ceiling\", \"claims-boundary\", \"repeated-act\", \"unclassed\", \"question\",\n                   \"environment\", \"gate\"]\n        },\n        \"provenance\": {\"type\": \"string\", \"enum\": [\"product\", \"tenant\", \"executor\", \"spec\"]},\n        \"detail\": {\n          \"type\": [\"string\", \"null\"],\n          \"description\": \"Populated for class \\\"unclassed\\\" (the log's last line, capped at 200 characters), class \\\"question\\\" (the halt's own question, its first line only), class \\\"environment\\\" ([checks].command's last output line, capped at 200 characters), and class \\\"gate\\\" (a refused spec-gate record's own refusal string, issue #137 -- never persisted on an actual build record; read here only because stop_class_enum sources the enum from this schema); null for every other class, whose evidence already lives in refusal, halted, or the log itself.\"\n        }\n      }\n    },\n    \"product_version\": {\"type\": \"string\", \"minLength\": 1},\n    \"product_pin\": {\"type\": [\"string\", \"null\"]}\n  }\n}\n","structuredPatch":[{"oldStart":110,"oldLines":7,"newStart":110,"newLines":7,"lines":["           \"type\": \"string\",","           \"enum\": [\"non-question\", \"outlived-invocation\", \"no-cause\", \"forge-unconcluded\",","                    \"ceiling\", \"claims-boundary\", \"repeated-act\", \"unclassed\", \"question\",","-                   \"environment\", \"gate\"]","+
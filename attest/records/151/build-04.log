1213\t    return run.returncode == 0\n1214\t\n1215\t\n1216\tdef cmd_spec_gate(argv: list[str]) -> int:\n1217\t    root = Path(\".\").resolve()\n1218\t    item_id = argv[0] if argv else derive_item_id(root)\n1219\t    if not item_id:\n1220\t        print(\"attavo spec-gate: cannot derive item id; pass N or run on an attavo/N-* branch\",\n1221\t              file=sys.stderr)\n1222\t        return 2\n1223\t    m = read_manifest(root)\n1224\t    if m is None:\n1225\t        print(f\"attavo spec-gate: no {MANIFEST} at {root}\", file=sys.stderr)\n1226\t        return 2\n1227\t    specs_rel = m[\"paths\"][\"specs\"]\n1228\t    records_rel = m[\"paths\"][\"records\"]\n1229\t    spec_dir = root / specs_rel / item_id\n1230\t    spec_md = spec_dir / \"spec.md\"\n1231\t    if not spec_md.is_file():\n1232\t        print(f\"attavo spec-gate: no spec at {spec_dir}\", file=sys.stderr)\n1233\t        return 2\n1234\t    spec_rel = str(Path(specs_rel) / item_id)\n1235\t    try:\n1236\t        spec_sha = last_commit_touching(root, spec_rel)\n1237\t    except ShallowCheckoutError as exc:\n1238\t        print(f\"attavo spec-gate: refused: {exc}\", file=sys.stderr)\n1239\t        return 2\n1240\t\n1241\t    records_dir = root / records_rel / item_id\n1242\t    try:\n1243\t        approved = approval_status(root, m, item_id) == \"valid\"\n1244\t    except ShallowCheckoutError as exc:\n1245\t        print(f\"attavo spec-gate: refused: {exc}\", file=sys.stderr)\n1246\t        return 2\n1247\t    latest_approval = latest_record(records_dir, \"approval\")\n1248\t    if approved:\n1249\t        record = {\"sha\": git(root, \"rev-parse\", \"HEAD\").strip(), \"spec_sha\": spec_sha,\n1250\t                  \"at\": now_iso(), \"status\": \"approved\",\n1251\t                  \"approval_sha\": latest_approval.get(\"sha\") if latest_approval else None,\n1252\t                  \"criteria\": [], \"refusal\": None}\n1253\t        write_record(records_dir, \"spec\", record, m, item_id)\n1254\t       
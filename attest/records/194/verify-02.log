{"type":"item.completed","item":{"id":"item_7","type":"agent_message","text":"{\"findings\":[{\"title\":\"Proof six accepts an incorrect invocation total when the discrepancy is one second or less\",\"specimen\":\"attavo/doctor.py::_time_disagrees\",\"retires\":\"The assumption that the large 20-second fixture mismatch proves exact agreement between a statement and its records.\",\"rejection_test\":\"test_doctor_rejects_a_subsecond_time_invocation_mismatch\",\"severity\":\"Blocking whenever abs(statement.time.invocation_s - records_sum) is greater than 0 but less than or equal to 1.0; harmless only when the rounded values are equal.\"},{\"title\":\"Proof six authenticates only time.invocation_s, leaving the rest of the new accounting forgeable\",\"specimen\":\"attavo/doctor.py::_time_disagrees\",\"retires\":\"The assumption that a sealed statement carrying time and cost is held to its records merely because its aggregate invocation duration was checked.\",\"rejection_test\":\"test_doctor_rejects_statement_whose_time_or_cost_breakdown_disagrees_with_records\",\"severity\":\"Blocking when any sealed time field other than invocation_s, or any cost total/subtotal/partial/not_read field, disagrees with the records while invocation_s remains correct; harmless while every unchecked field is truthful.\"}],\"tests_named\":[\"test_doctor_rejects_a_subsecond_time_invocation_mismatch\",\"test_doctor_rejects_statement_whose_time_or_cost_breakdown_disagrees_with_records\"]}"}}

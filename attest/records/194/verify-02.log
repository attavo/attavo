{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,260p' /var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp2b_37a01/diff.patch && git show --stat --oneline aa9c02b && git show --format=fuller --no-patch 70d2bc920419432f9f1d66c87e8e2fb4f59d0669 2c4754587314e481152730e456003a8124d18656 && git show 70d2bc920419432f9f1d66c87e8e2fb4f59d0669:attest/specs/194/spec.md 2>/dev/null || true\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,260p' /var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp2b_37a01/diff.patch && git show --stat --oneline aa9c02b && git show --format=fuller --no-patch 70d2bc920419432f9f1d66c87e8e2fb4f59d0669 2c4754587314e481152730e456003a8124d18656 && git show 70d2bc920419432f9f1d66c87e8e2fb4f59d0669:attest/specs/194/spec.md 2>/dev/null || true\"","aggregated_output":"diff --git a/attavo/attest.py b/attavo/attest.py\nindex 6d3e690..79017f2 100644\n--- a/attavo/attest.py\n+++ b/attavo/attest.py\n@@ -2,12 +2,14 @@ from __future__ import annotations\n \n import json\n import sys\n+from datetime import datetime\n from pathlib import Path\n-from typing import cast\n+from typing import Any, cast\n \n from attavo.common import MANIFEST, git, now_iso, product_version, read_manifest\n from attavo.records import latest_attempt_path, latest_record, parse_attempts\n-from attavo.types import ApprovalRecord, AttestRecord, BuildRecord, SpecRecord, VerifyRecord\n+from attavo.types import (ApprovalRecord, AttestRecord, BuildRecord, ItemCost, ItemTime,\n+                          SpecRecord, StageTime, VerifyRecord)\n \n # --- attest: the signed envelope over one item's whole traversal ---\n \n@@ -34,6 +36,81 @@ def derive_attest_items(root: Path, records_rel: str) -> tuple[set[str], str | N\n     return items, None\n \n \n+INVOCATION_STAGES = (\"build\", \"verify\", \"counsel\")\n+\n+\n+def _is_number(value: Any) -> bool:\n+    return isinstance(value, (int, float)) and not isinstance(value, bool)\n+\n+\n+def item_time_and_cost(records_dir: Path, sealed_at_epoch: int | None) -> tuple[ItemTime, ItemCost]:\n+    \"\"\"The item's accounting, summed from the records attest already reads\n+    (issue: a view showed #158 as 20 minutes, its final build plus its final\n+    verify, where its nineteen invocations ran 115): every build, verify,\n+    and counsel attempt's wall_clock_s and cost_usd, per stage and for the\n+    item, never the final attempt alone. A record that carries no number\n+    is named in not_read and makes each sum it belongs to partial --\n+    absent is never zero. lead_s runs from the first approval record's\n+    `at` to sealed_at_epoch (the committer time of the commit the statement\n+    is computed at); both it and waiting_s are None when either end cannot\n+    be read. doctor's sixth proof calls this same function over the same\n+    records and fails a sealed statement whose invocation_s disagrees.\"\"\"\n+    stages: dict[str, StageTime] = {}\n+    time_not_read: list[str] = []\n+    cost_not_read: list[str] = []\n+    by_stage: dict[str, float] = {}\n+    by_adapter: dict[str, float] = {}\n+    for stage in INVOCATION_STAGES:\n+        attempts = parse_attempts(records_dir, stage)\n+        seconds = 0.0\n+        partial = False\n+        for n, rec in sorted(attempts.items()):\n+            name = f\"{stage}-{n:02d}\"\n+            wall = rec.get(\"wall_clock_s\")\n+            if _is_number(wall):\n+                seconds += float(wall)\n+            else:\n+                partial = True\n+                time_not_read.append(name)\n+            cost = rec.get(\"cost_usd\")\n+            if _is_number(cost):\n+                by_stage[stage] = by_stage.get(stage, 0.0) + float(cost)\n+                adapter = rec.get(\"adapter\")\n+                key = adapter if isinstance(adapter, str) and adapter else \"not read\"\n+                by_adapter[key] = by_adapter.get(key, 0.0) + float(cost)\n+            else:\n+                cost_not_read.append(name)\n+        stages[stage] = {\"attempts\": len(attempts), \"invocation_s\": round(seconds, 3),\n+                         \"partial\": partial}\n+\n+    invocation_s = round(sum(st[\"invocation_s\"] for st in stages.values()), 3)\n+    lead_s: float | None = None\n+    first_approval = parse_attempts(records_dir, \"approval\")\n+    if first_approval and sealed_at_epoch is not None:\n+        at = first_approval[min(first_approval)].get(\"at\")\n+        try:\n+            approved = datetime.fromisoformat(str(at).replace(\"Z\", \"+00:00\"))\n+            lead_s = round(sealed_at_epoch - approved.timestamp(), 3)\n+        except ValueError:\n+            time_not_read.append(f\"approval-{min(first_approval):02d}\")\n+    item_time: ItemTime = {\n+        \"build\": stages[\"build\"], \"verify\": stages[\"verify\"], \"counsel\": stages[\"counsel\"],\n+        \"invocation_s\": invocation_s,\n+        \"lead_s\": lead_s,\n+        \"waiting_s\": None if lead_s is None else round(lead_s - invocation_s, 3),\n+        \"partial\": any(st[\"partial\"] for st in stages.values()),\n+        \"not_read\": time_not_read,\n+    }\n+    item_cost: ItemCost = {\n+        \"usd\": round(sum(by_stage.values()), 6),\n+        \"by_stage_usd\": {k: round(v, 6) for k, v in by_stage.items()},\n+        \"by_adapter_usd\": {k: round(v, 6) for k, v in by_adapter.items()},\n+        \"partial\": bool(cost_not_read),\n+        \"not_read\": cost_not_read,\n+    }\n+    return item_time, item_cost\n+\n+\n NOT_YET = object()\n \n ChainRecords = tuple[SpecRecord, ApprovalRecord, BuildRecord, VerifyRecord]\n@@ -175,6 +252,11 @@ def cmd_attest(argv: list[str]) -> int:\n     # is what makes that unambiguous to a reader who has never seen attest\n     # run anywhere but the merge group.\n     head_sha = git(root, \"rev-parse\", \"HEAD\").strip()\n+    try:\n+        sealed_at: int | None = int(git(root, \"show\", \"-s\", \"--format=%ct\", \"HEAD\").strip())\n+    except (RuntimeError, ValueError):\n+        sealed_at = None\n+    item_time, item_cost = item_time_and_cost(records_dir, sealed_at)\n \n     statement: AttestRecord = {\n         \"sha\": head_sha,\n@@ -195,11 +277,13 @@ def cmd_attest(argv: list[str]) -> int:\n         \"interventions\": [],\n         \"acts\": [],\n         \"tokens_by_stage\": {\"build\": latest_build.get(\"tokens\"), \"verify\": latest_verify.get(\"tokens\")},\n-        # Never summed across stages -- the 2026-09-09 ruling on reporting\n-        # across vendors: a stage's executor may report no cost at all.\n+        # The final attempt per stage; every attempt, summed, is in `time`\n+        # and `cost` (the sum across executors was ruled 2026-09-19).\n         \"cost_by_stage_usd\": {\"build\": latest_build.get(\"cost_usd\"), \"verify\": latest_verify.get(\"cost_usd\")},\n         \"wall_clock_by_stage_s\": {\"build\": latest_build.get(\"wall_clock_s\"),\n                                   \"verify\": latest_verify.get(\"wall_clock_s\")},\n+        \"time\": item_time,\n+        \"cost\": item_cost,\n         \"product_version\": product_version(),\n         \"product_pin\": (m.get(\"attavo\") or {}).get(\"version\"),\n     }\ndiff --git a/attavo/doctor.py b/attavo/doctor.py\nindex 5c358a3..c6e2d15 100644\n--- a/attavo/doctor.py\n+++ b/attavo/doctor.py\n@@ -8,7 +8,7 @@ import subprocess\n from pathlib import Path\n from typing import Any\n \n-from attavo.attest import check_attest_chain\n+from attavo.attest import check_attest_chain, item_time_and_cost\n from attavo.common import (\n     MANIFEST,\n     Proof,\n@@ -631,6 +631,26 @@ def _is_ancestor(root: Path, earlier: str, later: str) -> bool:\n     return run.returncode == 0\n \n \n+def _time_disagrees(item_records_dir: Path, item: str, merge_sha: str,\n+                    statement: dict[str, Any]) -> str | None:\n+    \"\"\"A sealed statement that carries `time` says the invocation_s its\n+    records sum to -- the same function attest summed them with, over the\n+    same records (no record is written after a merge). A statement sealed\n+    before `time` existed carries none and is not checked. No new read of\n+    the store: the statement is the one proof six already holds.\"\"\"\n+    inner = statement.get(\"predicate\")\n+    predicate = inner if isinstance(inner, dict) else statement\n+    stated_time = predicate.get(\"time\")\n+    if not isinstance(stated_time, dict):\n+        return None\n+    summed = item_time_and_cost(item_records_dir, None)[0][\"invocation_s\"]\n+    stated = stated_time.get(\"invocation_s\")\n+    if isinstance(stated, bool) or not isinstance(stated, (int, float)) or abs(stated - summed) > 1.0:\n+        return (f\"item {item} merged at {merge_sha[:12]}: the statement's time.invocation_s \"\n+                f\"{stated} is not its records' {summed}\")\n+    return None\n+\n+\n def proof_every_attested_item_is_sealed(root: Path, m: dict[str, Any] | None) -> Proof:\n     p = Proof(\"every-attested-item-is-sealed\", \"every attested item has its statement in the store\")\n     if m is None:\n@@ -676,6 +696,9 @@ def proof_every_attested_item_is_sealed(root: Path, m: dict[str, Any] | None) ->\n         statement, exit_code = statement_for(root, cmd, merge_sha)\n         if statement is not None:\n             sealed.append(item)\n+            disagreement = _time_disagrees(records_dir / item, item, merge_sha, statement)\n+            if disagreement:\n+                reasons.append(disagreement)\n         elif exit_code == 2:\n             not_read.append(item)\n             reasons.append(f\"item {item} merged at {merge_sha[:12]}: not read -- \"\ndiff --git a/attavo/types.py b/attavo/types.py\nindex db2f586..43cdfa4 100644\n--- a/attavo/types.py\n+++ b/attavo/types.py\n@@ -142,6 +142,39 @@ CounselRecord = TypedDict(\"CounselRecord\", {\n })\n \n \n+class StageTime(TypedDict):\n+    \"\"\"One stage's invocations summed (the statement's `time` block).\"\"\"\n+    attempts: int\n+    invocation_s: float\n+    partial: bool\n+\n+\n+class ItemTime(TypedDict):\n+    \"\"\"Every invocation's wall_clock_s, per stage and for the item, beside\n+    the item's lead time -- summed from the records by `attavo attest`, so\n+    a view renders it and never derives it.\"\"\"\n+    build: StageTime\n+    verify: StageTime\n+    counsel: StageTime\n+    invocation_s: float\n+    lead_s: float | None\n+    waiting_s: float | None\n+    partial: bool\n+    not_read: list[str]\n+\n+\n+class ItemCost(TypedDict):\n+    \"\"\"Every record's cost_usd summed: the item's total across stages and\n+    executors, with a subtotal per stage and per adapter. A record with no\n+    cost_usd is named in not_read and makes every sum it belongs to\n+    partial -- absent is never zero.\"\"\"\n+    usd: float\n+    by_stage_usd: dict[str, float]\n+    by_adapter_usd: dict[str, float]\n+    partial: bool\n+    not_read: list[str]\n+\n+\n class AttestRecord(TypedDict):\n     \"\"\"The statement `attavo attest` prints (schema/attestation.schema.json).\"\"\"\n     sha: str\n@@ -161,6 +194,8 @@ class AttestRecord(TypedDict):\n     tokens_by_stage: dict[str, dict[str, Any] | None]\n     cost_by_stage_usd: dict[str, float | None]\n     wall_clock_by_stage_s: dict[str, float | None]\n+    time: ItemTime\n+    cost: ItemCost\n     product_version: str\n     product_pin: str | None\n \ndiff --git a/attest/records/194/approval-01.json b/attest/records/194/approval-01.json\nnew file mode 100644\nindex 0000000..163e26a\n--- /dev/null\n+++ b/attest/records/194/approval-01.json\n@@ -0,0 +1,10 @@\n+{\n+  \"sha\": \"2c4754587314e481152730e456003a8124d18656\",\n+  \"spec_sha\": \"70d2bc920419432f9f1d66c87e8e2fb4f59d0669\",\n+  \"approved_by\": \"dbean10\",\n+  \"at\": \"2026-09-19T14:47:29Z\",\n+  \"record_version\": 2,\n+  \"item\": \"194\",\n+  \"product_version\": \"v0.26.0\",\n+  \"product_pin\": \"v0.26.0\"\n+}\ndiff --git a/attest/records/194/build-01.json b/attest/records/194/build-01.json\nnew file mode 100644\nindex 0000000..656bc8a\n--- /dev/null\n+++ b/attest/records/194/build-01.json\n@@ -0,0 +1,70 @@\n+{\n+  \"sha\": \"aa9c02ba125d391f264f1d2facf0da3fa4d87d4e\",\n+  \"start_sha\": \"4096f8cf673e9d957cf7fbf9ce53824aae536933\",\n+  \"spec_sha\": \"70d2bc920419432f9f1d66c87e8e2fb4f59d0669\",\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-AgH7FjyK' (errno=Operation not permitted)\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-Gek3sEUP' (errno=Operation not permitted)\naa9c02b attest: sum every invocation's time and cost into the statement (#194)\n attavo/attest.py               |  92 +++++++++++++++++++++-\n attavo/doctor.py               |  25 +++++-\n attavo/types.py                |  35 +++++++++\n schema/attestation.schema.json |  47 +++++++++++-\n tests/test_attest_time.py      | 168 +++++++++++++++++++++++++++++++++++++++++\n 5 files changed, 359 insertions(+), 8 deletions(-)\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-MAd0J7yW' (errno=Operation not permitted)\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-vH0iPZXl' (errno=Operation not permitted)\ncommit 70d2bc920419432f9f1d66c87e8e2fb4f59d0669\nAuthor:     David Bean <david.s.bean@gmail.com>\nAuthorDate: Sat Sep 19 08:46:34 2026 -0600\nCommit:     David Bean <david.s.bean@gmail.com>\nCommitDate: Sat Sep 19 08:46:34 2026 -0600\n\n    spec for #194: the first criterion no longer imports jsonschema, which the spec gate's runner does not carry\n    \n    Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>\n\ncommit 2c4754587314e481152730e456003a8124d18656\nAuthor:     attavo-records[bot] <325738051+attavo-records[bot]@users.noreply.github.com>\nAuthorDate: Sat Sep 19 14:46:55 2026 +0000\nCommit:     attavo-records[bot] <325738051+attavo-records[bot]@users.noreply.github.com>\nCommitDate: Sat Sep 19 14:46:55 2026 +0000\n\n    attavo: spec-gate record for item 194\n## Problem\n\nEvery build, verify, and counsel record carries `wall_clock_s` and `cost_usd`, and nothing in the product sums them. The attestation statement carries the final attempt per stage and no more, so a view derived its own figure: on 2026-09-18 the operator screen showed #158 as 20 minutes of product time (its final build plus its final verify, no counsel) where its nineteen invocations ran 114.9 minutes (builds 5,570 s, verifies 909 s, counsels 412 s) against 2,021 minutes of lead time. The item spent six percent of its lead time inside an invocation, which is the number that says where the next minute is worth removing, and no record carried it. The operator ruled 2026-09-19 that this accounting lives in the product; and, the same day, that dollars are summed across stages and executors with a subtotal per executor beside the total (superseding the 2026-09-09 ruling against a cross-executor sum), a total that lacks any record's cost saying so by name. Pricing a record whose executor reports no cost, from a published rate per token shown in Configure, is the cost-basis item and is not this one.\n\nRetires: any view's own arithmetic over records as the source of an item's durations or cost (attavo/screen's Analyze derivation, deleted by a screen item filed against this one); \"product time\" as a name for the final attempt; the statement's silence about every attempt but the last.\n\nThe statement for this item's own merge is printed by the pinned release and carries no `time`; the first statement that does is sealed after the release that ships this and the pin to it. Proof six does not check a statement that carries no `time`.\n\n## Claims\n\n- attavo/attest.py\n- attavo/doctor.py\n- attavo/types.py\n- schema/attestation.schema.json\n- tests/test_attest_time.py\n- tests/test_attest.py\n- tests/test_doctor_sealed.py\n\n## Criteria\n\n- attest-sums-every-invocation.sh: on a fixture item with three builds, two verifies, and one counsel, attavo attest prints a statement valid against schema/attestation.schema.json at $id v3 whose time block carries attempts and invocation_s per stage (350.75, 40.0, 7.5), invocation_s 398.25 for the item, lead_s from approval-01's at to the merge's committer time, waiting_s as their difference, and leaves wall_clock_by_stage_s as the final attempt\n- attest-names-a-record-without-wall-clock.sh: when build-02 carries no wall_clock_s, time.not_read is [\"build-02\"], time.build.partial and time.partial are true, time.build.attempts is still 3, and the missing value is never summed as zero\n- attest-sums-cost-across-executors.sh: cost.usd is the sum of every record's cost_usd across stages and adapters with by_stage_usd and by_adapter_usd beside it; while one adapter's records carry no cost the total is partial and not_read names each such record; once they carry one the total is whole and both adapters have a subtotal\n- doctor-fails-a-statement-whose-time-is-not-its-records.sh: proof every-attested-item-is-sealed holds on a sealed statement whose time.invocation_s equals its records' sum, fails naming item 1 and time.invocation_s when the statement says 20.0, and holds on a statement sealed before time existed\n- the-accounting-has-its-tests.sh: tests/test_attest_time.py carries the four regression tests by name, attavo/types.py's AttestRecord mirrors the schema's properties, and the schema requires time and cost\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,280p' tests/test_attest_time.py && sed -n '1,240p' schema/attestation.schema.json && sed -n '620,735p' attavo/doctor.py && rg -n \\\"item_time_and_cost|time.invocation|attestation.schema|schema_version|predicate\\\" tests/test_attest.py tests/test_doctor_sealed.py attavo -g '*.py'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,280p' tests/test_attest_time.py && sed -n '1,240p' schema/attestation.schema.json && sed -n '620,735p' attavo/doctor.py && rg -n \\\"item_time_and_cost|time.invocation|attestation.schema|schema_version|predicate\\\" tests/test_attest.py tests/test_doctor_sealed.py attavo -g '*.py'\"","aggregated_output":"\"\"\"The statement's `time` and `cost` blocks: every invocation of an item\nsummed by `attavo attest` from the records it already reads, and doctor's\nsixth proof holding the statement to those records.\n\nRegression, run red first on main at 1d2257b: the statement carried the\nfinal attempt per stage and nothing else, so a view derived its own\n\"product time\" -- 20 minutes for an item whose nineteen invocations ran\n115 -- and no record said otherwise.\n\nRun: python3 -m pytest tests -q\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport subprocess\nimport sys\nfrom pathlib import Path\nfrom typing import Any\n\nimport jsonschema\n\nfrom helpers import git\n\nROOT = Path(__file__).resolve().parent.parent\nATTAVO = ROOT / \"bin\" / \"attavo\"\nSCHEMA = json.loads((ROOT / \"schema\" / \"attestation.schema.json\").read_text())\n\n# (stage, attempt, wall_clock_s, cost_usd, adapter): three builds on one\n# executor, two verifies and one counsel on another that reports no cost.\nINVOCATIONS: list[tuple[str, int, float | None, float | None, str]] = [\n    (\"build\", 1, 100.5, 0.25, \"alpha\"),\n    (\"build\", 2, 200.0, 0.5, \"alpha\"),\n    (\"build\", 3, 50.25, 0.125, \"alpha\"),\n    (\"verify\", 1, 10.0, None, \"beta\"),\n    (\"verify\", 2, 30.0, None, \"beta\"),\n    (\"counsel\", 1, 7.5, None, \"beta\"),\n]\n\n\ndef run(root: Path, *args: str, stdin: str | None = None) -> subprocess.CompletedProcess[str]:\n    return subprocess.run([sys.executable, str(ATTAVO), *args], cwd=str(root), input=stdin,\n                          capture_output=True, text=True, check=False)\n\n\ndef write(path: Path, obj: dict[str, Any]) -> None:\n    path.parent.mkdir(parents=True, exist_ok=True)\n    path.write_text(json.dumps(obj))\n\n\ndef make_item(tmp_path: Path, invocations: list[tuple[str, int, float | None, float | None, str]]\n              ) -> tuple[Path, str]:\n    \"\"\"A tenant with one item merged on main's first-parent line: spec and\n    approval records, then every invocation in `invocations`, the chain\n    coherent on the latest of each stage. Returns (root, merge sha).\"\"\"\n    root = tmp_path / \"tenant\"\n    root.mkdir(parents=True)\n    git(root, \"init\", \"-q\", \"-b\", \"main\", \".\")\n    git(root, \"config\", \"user.email\", \"fixture@attavo.invalid\")\n    git(root, \"config\", \"user.name\", \"fixture\")\n    (root / \"attavo.toml\").write_text(\n        '[paths]\\nrecords = \"records\"\\nspecs = \"specs\"\\n\\n'\n        '[forge]\\nattestation_command = \"sh ./fake-store\"\\n')\n    (root / \"fake-store\").write_text(\n        '#!/bin/sh\\nread sha\\ntest -f \"statements/$sha.json\" && cat \"statements/$sha.json\"\\n')\n    git(root, \"add\", \"-A\")\n    git(root, \"commit\", \"-q\", \"-m\", \"install\")\n    git(root, \"checkout\", \"-q\", \"-b\", \"attavo/1-x\")\n    rec = root / \"records\" / \"1\"\n    write(rec / \"spec-01.json\", {\"status\": \"pass\", \"sha\": \"s1\", \"at\": \"2026-01-01T00:00:00Z\"})\n    write(rec / \"approval-01.json\", {\"sha\": \"a1\", \"spec_sha\": \"s1\", \"at\": \"2026-01-01T00:00:00Z\"})\n    for stage, n, wall, cost, adapter in invocations:\n        body: dict[str, Any] = {\"status\": \"pass\", \"sha\": f\"{stage}{n}\", \"adapter\": adapter,\n                                \"approval_sha\": \"a1\", \"cost_usd\": cost}\n        if wall is not None:\n            body[\"wall_clock_s\"] = wall\n        if stage == \"verify\":\n            last_build = max(i[1] for i in invocations if i[0] == \"build\")\n            body[\"build_sha\"] = f\"build{last_build}\"\n        write(rec / f\"{stage}-{n:02d}.json\", body)\n    git(root, \"add\", \"-A\")\n    git(root, \"commit\", \"-q\", \"-m\", \"records for item 1\")\n    git(root, \"checkout\", \"-q\", \"main\")\n    git(root, \"merge\", \"-q\", \"--no-ff\", \"-m\", \"Merge branch 'attavo/1-x'\", \"attavo/1-x\")\n    git(root, \"update-ref\", \"refs/remotes/origin/main\", \"main\")\n    git(root, \"symbolic-ref\", \"refs/remotes/origin/HEAD\", \"refs/remotes/origin/main\")\n    return root, git(root, \"rev-parse\", \"HEAD\").strip()\n\n\ndef attest(root: Path) -> dict[str, Any]:\n    done = run(root, \"attest\", \"1\")\n    assert done.returncode == 0, done.stdout + done.stderr\n    statement: dict[str, Any] = json.loads(done.stdout)\n    return statement\n\n\ndef proof_six(root: Path) -> dict[str, Any]:\n    out = json.loads(run(root, \"doctor\", \"--json\", str(root)).stdout)\n    found: dict[str, Any] = [p for p in out[\"proofs\"]\n                             if p[\"proof\"] == \"every-attested-item-is-sealed\"][0]\n    return found\n\n\ndef test_attest_sums_every_invocation_per_stage_and_per_item(tmp_path: Path) -> None:\n    root, _ = make_item(tmp_path, INVOCATIONS)\n    statement = attest(root)\n    jsonschema.validate(statement, SCHEMA)\n    time = statement[\"time\"]\n    assert time[\"build\"] == {\"attempts\": 3, \"invocation_s\": 350.75, \"partial\": False}\n    assert time[\"verify\"] == {\"attempts\": 2, \"invocation_s\": 40.0, \"partial\": False}\n    assert time[\"counsel\"] == {\"attempts\": 1, \"invocation_s\": 7.5, \"partial\": False}\n    assert time[\"invocation_s\"] == 398.25\n    assert time[\"partial\"] is False and time[\"not_read\"] == []\n    # the final attempt stays where it was, and is not the sum\n    assert statement[\"wall_clock_by_stage_s\"] == {\"build\": 50.25, \"verify\": 30.0}\n    # lead runs from approval-01's `at` to the merge's committer time\n    merged_at = int(git(root, \"show\", \"-s\", \"--format=%ct\", \"HEAD\").strip())\n    assert time[\"lead_s\"] == merged_at - 1767225600\n    assert time[\"waiting_s\"] == round(time[\"lead_s\"] - 398.25, 3)\n\n\ndef test_attest_names_a_record_without_wall_clock_and_never_sums_it_as_zero(tmp_path: Path) -> None:\n    invocations = [i if i[:2] != (\"build\", 2) else (\"build\", 2, None, 0.5, \"alpha\")\n                   for i in INVOCATIONS]\n    root, _ = make_item(tmp_path, invocations)\n    time = attest(root)[\"time\"]\n    assert time[\"not_read\"] == [\"build-02\"]\n    assert time[\"build\"][\"partial\"] is True and time[\"partial\"] is True\n    assert time[\"build\"][\"attempts\"] == 3\n    assert time[\"verify\"][\"partial\"] is False\n\n\ndef test_attest_sums_cost_across_executors_and_says_when_the_total_is_partial(tmp_path: Path) -> None:\n    root, _ = make_item(tmp_path, INVOCATIONS)\n    cost = attest(root)[\"cost\"]\n    assert cost[\"usd\"] == 0.875\n    assert cost[\"by_stage_usd\"] == {\"build\": 0.875}\n    assert cost[\"by_adapter_usd\"] == {\"alpha\": 0.875}\n    assert cost[\"partial\"] is True\n    assert cost[\"not_read\"] == [\"verify-01\", \"verify-02\", \"counsel-01\"]\n\n    priced = [i if i[3] is not None else (i[0], i[1], i[2], 0.0625, i[4]) for i in INVOCATIONS]\n    root2, _ = make_item(tmp_path / \"priced\", priced)\n    cost2 = attest(root2)[\"cost\"]\n    assert cost2[\"usd\"] == 0.875 + 3 * 0.0625\n    assert cost2[\"by_adapter_usd\"] == {\"alpha\": 0.875, \"beta\": 0.1875}\n    assert cost2[\"partial\"] is False and cost2[\"not_read\"] == []\n\n\ndef test_doctor_proof_six_fails_a_statement_whose_time_is_not_its_records(tmp_path: Path) -> None:\n    root, merge = make_item(tmp_path, INVOCATIONS)\n    statement = attest(root)\n    store = root / \"statements\"\n    store.mkdir()\n    envelope = {\"_type\": \"https://in-toto.io/Statement/v1\", \"predicate\": statement}\n    (store / f\"{merge}.json\").write_text(json.dumps(envelope))\n    held = proof_six(root)\n    assert held[\"holds\"] is True and held[\"sealed\"] == [\"1\"], held\n\n    statement[\"time\"][\"invocation_s\"] = 20.0\n    (store / f\"{merge}.json\").write_text(json.dumps(envelope))\n    failed = proof_six(root)\n    assert failed[\"holds\"] is False, failed\n    assert \"item 1\" in failed[\"reason\"] and \"time.invocation_s\" in failed[\"reason\"], failed\n\n    # a statement sealed before `time` existed carries none and is not checked\n    del statement[\"time\"]\n    (store / f\"{merge}.json\").write_text(json.dumps(envelope))\n    assert proof_six(root)[\"holds\"] is True\n{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"$id\": \"https://attavo.dev/attestation/v3\",\n  \"title\": \"The attestation statement `attavo attest` prints on a coherent chain\",\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"required\": [\n    \"sha\", \"merge_sha\", \"item\", \"spec\", \"spec_sha\", \"approval\", \"approval_sha\",\n    \"build\", \"build_sha\", \"verify\", \"verify_sha\", \"at\", \"interventions\", \"acts\",\n    \"tokens_by_stage\", \"cost_by_stage_usd\", \"wall_clock_by_stage_s\", \"time\", \"cost\",\n    \"product_version\", \"product_pin\"\n  ],\n  \"properties\": {\n    \"sha\": {\"type\": \"string\", \"minLength\": 1},\n    \"merge_sha\": {\"type\": \"string\", \"minLength\": 1},\n    \"item\": {\"type\": \"string\", \"minLength\": 1},\n    \"spec\": {\"type\": [\"string\", \"null\"]},\n    \"spec_sha\": {\"type\": [\"string\", \"null\"]},\n    \"approval\": {\"type\": [\"string\", \"null\"]},\n    \"approval_sha\": {\"type\": [\"string\", \"null\"]},\n    \"build\": {\"type\": [\"string\", \"null\"]},\n    \"build_sha\": {\"type\": [\"string\", \"null\"]},\n    \"verify\": {\"type\": [\"string\", \"null\"]},\n    \"verify_sha\": {\"type\": [\"string\", \"null\"]},\n    \"at\": {\"type\": \"string\", \"minLength\": 1},\n    \"interventions\": {\n      \"type\": \"array\",\n      \"description\": \"Corrections or amendments made during the item's traversal. Nothing populates this yet.\",\n      \"items\": {\n        \"type\": \"object\",\n        \"additionalProperties\": false,\n        \"required\": [\"at\", \"class\", \"by\"],\n        \"properties\": {\n          \"at\": {\"type\": \"string\", \"minLength\": 1},\n          \"class\": {\"type\": \"string\", \"minLength\": 1},\n          \"by\": {\"type\": \"string\", \"minLength\": 1}\n        }\n      }\n    },\n    \"acts\": {\n      \"type\": \"array\",\n      \"description\": \"Operator acts on the item: approve, rule, merge. Nothing populates this yet.\",\n      \"items\": {\n        \"type\": \"object\",\n        \"additionalProperties\": false,\n        \"required\": [\"at\", \"act\", \"by\"],\n        \"properties\": {\n          \"at\": {\"type\": \"string\", \"minLength\": 1},\n          \"act\": {\"type\": \"string\", \"enum\": [\"approve\", \"rule\", \"merge\"]},\n          \"by\": {\"type\": \"string\", \"minLength\": 1}\n        }\n      }\n    },\n    \"tokens_by_stage\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\"build\", \"verify\"],\n      \"properties\": {\n        \"build\": {\"type\": [\"object\", \"null\"]},\n        \"verify\": {\"type\": [\"object\", \"null\"]}\n      }\n    },\n    \"cost_by_stage_usd\": {\n      \"type\": \"object\",\n      \"description\": \"The final attempt's cost per stage, as its record carries it; the item's sums are in `cost`.\",\n      \"additionalProperties\": false,\n      \"required\": [\"build\", \"verify\"],\n      \"properties\": {\n        \"build\": {\"type\": [\"number\", \"null\"]},\n        \"verify\": {\"type\": [\"number\", \"null\"]}\n      }\n    },\n    \"wall_clock_by_stage_s\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\"build\", \"verify\"],\n      \"properties\": {\n        \"build\": {\"type\": [\"number\", \"null\"]},\n        \"verify\": {\"type\": [\"number\", \"null\"]}\n      }\n    },\n    \"time\": {\n      \"type\": \"object\",\n      \"description\": \"Every invocation of the item, summed by attest from its stage records' wall_clock_s: per stage and for the item, every attempt and not the final one alone (wall_clock_by_stage_s is the final attempt). lead_s runs from the first approval record's `at` to the committer time of the commit the statement is computed at; waiting_s is lead_s minus invocation_s. A record with no wall_clock_s is named in not_read and its sums are partial, never smaller in silence.\",\n      \"additionalProperties\": false,\n      \"required\": [\"build\", \"verify\", \"counsel\", \"invocation_s\", \"lead_s\", \"waiting_s\", \"partial\", \"not_read\"],\n      \"properties\": {\n        \"build\": {\"$ref\": \"#/$defs/stage_time\"},\n        \"verify\": {\"$ref\": \"#/$defs/stage_time\"},\n        \"counsel\": {\"$ref\": \"#/$defs/stage_time\"},\n        \"invocation_s\": {\"type\": \"number\", \"minimum\": 0},\n        \"lead_s\": {\"type\": [\"number\", \"null\"]},\n        \"waiting_s\": {\"type\": [\"number\", \"null\"]},\n        \"partial\": {\"type\": \"boolean\"},\n        \"not_read\": {\"type\": \"array\", \"items\": {\"type\": \"string\", \"minLength\": 1}}\n      }\n    },\n    \"cost\": {\n      \"type\": \"object\",\n      \"description\": \"Every record's cost_usd summed by attest: the item's total across stages and executors (ruled 2026-09-19, superseding the 2026-09-09 ruling against a cross-executor sum), with a subtotal per stage and per adapter. Each figure is what the record carries. A record with no cost_usd is named in not_read and makes usd and the subtotals it belongs to partial: absent is never zero, and a partial total says so.\",\n      \"additionalProperties\": false,\n      \"required\": [\"usd\", \"by_stage_usd\", \"by_adapter_usd\", \"partial\", \"not_read\"],\n      \"properties\": {\n        \"usd\": {\"type\": \"number\", \"minimum\": 0},\n        \"by_stage_usd\": {\"type\": \"object\", \"additionalProperties\": {\"type\": \"number\", \"minimum\": 0}},\n        \"by_adapter_usd\": {\"type\": \"object\", \"additionalProperties\": {\"type\": \"number\", \"minimum\": 0}},\n        \"partial\": {\"type\": \"boolean\"},\n        \"not_read\": {\"type\": \"array\", \"items\": {\"type\": \"string\", \"minLength\": 1}}\n      }\n    },\n    \"product_version\": {\"type\": \"string\", \"minLength\": 1},\n    \"product_pin\": {\"type\": [\"string\", \"null\"]}\n  },\n  \"$defs\": {\n    \"stage_time\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\"attempts\", \"invocation_s\", \"partial\"],\n      \"properties\": {\n        \"attempts\": {\"type\": \"integer\", \"minimum\": 0},\n        \"invocation_s\": {\"type\": \"number\", \"minimum\": 0},\n        \"partial\": {\"type\": \"boolean\"}\n      }\n    }\n  }\n}\n        return None, run.returncode\n    try:\n        parsed = json.loads(run.stdout)\n    except ValueError:\n        return None, run.returncode\n    return (parsed if isinstance(parsed, dict) else None), run.returncode\n\n\ndef _is_ancestor(root: Path, earlier: str, later: str) -> bool:\n    run = subprocess.run([\"git\", \"-C\", str(root), \"merge-base\", \"--is-ancestor\", earlier, later],\n                         capture_output=True, check=False)\n    return run.returncode == 0\n\n\ndef _time_disagrees(item_records_dir: Path, item: str, merge_sha: str,\n                    statement: dict[str, Any]) -> str | None:\n    \"\"\"A sealed statement that carries `time` says the invocation_s its\n    records sum to -- the same function attest summed them with, over the\n    same records (no record is written after a merge). A statement sealed\n    before `time` existed carries none and is not checked. No new read of\n    the store: the statement is the one proof six already holds.\"\"\"\n    inner = statement.get(\"predicate\")\n    predicate = inner if isinstance(inner, dict) else statement\n    stated_time = predicate.get(\"time\")\n    if not isinstance(stated_time, dict):\n        return None\n    summed = item_time_and_cost(item_records_dir, None)[0][\"invocation_s\"]\n    stated = stated_time.get(\"invocation_s\")\n    if isinstance(stated, bool) or not isinstance(stated, (int, float)) or abs(stated - summed) > 1.0:\n        return (f\"item {item} merged at {merge_sha[:12]}: the statement's time.invocation_s \"\n                f\"{stated} is not its records' {summed}\")\n    return None\n\n\ndef proof_every_attested_item_is_sealed(root: Path, m: dict[str, Any] | None) -> Proof:\n    p = Proof(\"every-attested-item-is-sealed\", \"every attested item has its statement in the store\")\n    if m is None:\n        return p.fail(f\"no {MANIFEST} at {root}; no records directory is declared\")\n    cmd = attestation_command(m)\n    if cmd is None:\n        return p.fail(\"no [forge].attestation_command in the manifest; the store cannot be read\")\n    records_rel = m.get(\"paths\", {}).get(\"records\", \"\")\n    records_dir = root / records_rel\n    if not records_dir.is_dir():\n        return p.fail(f\"no records directory under {records_dir}\")\n    items = load_records(records_dir)\n    complete = [item for item, stages in sorted(items.items()) if all(s in stages for s in STAGES)]\n\n    # [forge].sealed_since: merges at or before this commit are before the\n    # window -- the tenant could not seal them (no queue, no signing\n    # workflow, or a store that held nothing yet). They are named, never\n    # failed. Absent, the window starts where proof three's does: the\n    # install commit, or [doctor].from (issue #192).\n    since = (m.get(\"forge\") or {}).get(\"sealed_since\")\n    if not (isinstance(since, str) and since.strip()):\n        try:\n            since = proof_window_start(root, m)[1]\n        except WindowRefused as exc:\n            return p.fail(str(exc))\n    merges, refusal = _merges_reachable(root)\n    if refusal:\n        return p.fail(refusal)\n    sealed: list[str] = []\n    before_window: list[str] = []\n    unsealed: list[str] = []\n    not_merged: list[str] = []\n    not_read: list[str] = []\n    reasons: list[str] = []\n    for item in complete:\n        merge_sha, _ = merge_introducing_records(root, records_rel, item, STAGES, merges=merges)\n        if merge_sha is None:\n            not_merged.append(item)\n            continue\n        if _is_ancestor(root, merge_sha, since):\n            before_window.append(item)\n            continue\n        statement, exit_code = statement_for(root, cmd, merge_sha)\n        if statement is not None:\n            sealed.append(item)\n            disagreement = _time_disagrees(records_dir / item, item, merge_sha, statement)\n            if disagreement:\n                reasons.append(disagreement)\n        elif exit_code == 2:\n            not_read.append(item)\n            reasons.append(f\"item {item} merged at {merge_sha[:12]}: not read -- \"\n                           f\"the store could not be read; {cmd!r} exited 2\")\n        else:\n            unsealed.append(item)\n            reasons.append(f\"item {item} merged at {merge_sha[:12]} has no statement in the store\")\n    if reasons:\n        return p.fail(\"; \".join(reasons), sealed=sealed, before_window=before_window,\n                      unsealed=unsealed, not_merged=not_merged, not_read=not_read)\n    window = f\" at {since[:12]}\" if before_window else \"\"\n    return p.hold(f\"{len(sealed)} sealed, {len(before_window)} before the window{window}, \"\n                 f\"{len(not_merged)} not merged\",\n                 sealed=sealed, before_window=before_window, unsealed=unsealed,\n                 not_merged=not_merged, not_read=not_read)\n\n\ndef doctor(root: Path) -> list[Proof]:\n    m = read_manifest(root)\n    return [proof_every_gate_rejects(root, m),\n            proof_one_item_every_stage(root, m),\n            proof_no_commit_lacks_record(root, m),\n            proof_no_stop_lacks_cause(root, m),\n            proof_no_invocation_lacks_record(root, m),\n            proof_every_attested_item_is_sealed(root, m)]\n\n\ndef cmd_doctor(argv: list[str]) -> int:\n    as_json = \"--json\" in argv\n    args = [a for a in argv if a != \"--json\"]\n    root = Path(args[0] if args else \".\").resolve()\n    proofs = doctor(root)\n    if as_json:\n        print(json.dumps({\"root\": str(root), \"done\": all(p.holds for p in proofs),\nattavo/doctor.py:11:from attavo.attest import check_attest_chain, item_time_and_cost\nattavo/doctor.py:641:    inner = statement.get(\"predicate\")\nattavo/doctor.py:642:    predicate = inner if isinstance(inner, dict) else statement\nattavo/doctor.py:643:    stated_time = predicate.get(\"time\")\nattavo/doctor.py:646:    summed = item_time_and_cost(item_records_dir, None)[0][\"invocation_s\"]\nattavo/doctor.py:649:        return (f\"item {item} merged at {merge_sha[:12]}: the statement's time.invocation_s \"\ntests/test_attest.py:33:STATEMENT_SCHEMA = json.loads((ROOT / \"schema\" / \"attestation.schema.json\").read_text())\nattavo/attest.py:46:def item_time_and_cost(records_dir: Path, sealed_at_epoch: int | None) -> tuple[ItemTime, ItemCost]:\nattavo/attest.py:259:    item_time, item_cost = item_time_and_cost(records_dir, sealed_at)\nattavo/cli.py:172:statement -- validating against schema/attestation.schema.json -- to\nattavo/cli.py:178:unmodified, as the predicate, against the commit that lands, on the merge\nattavo/types.py:179:    \"\"\"The statement `attavo attest` prints (schema/attestation.schema.json).\"\"\"\n","exit_code":0,"status":"completed"}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Qn3cCpvv5wPwKzKKhhuViW","type":"tool_result","content":"1\t\"\"\"The record kinds, typed. Each TypedDict here mirrors one JSON schema: its\n2\tkeys are that schema's `properties` and its required keys are that schema's\n3\t`required`, and tests/test_types_mirror_schemas.py asserts both, so the type\n4\tcannot drift from the contract. The schema stays the contract; this is its\n5\tmirror (issue #189).\n6\t\n7\tEvery key each schema lists is required, so no class here is total=False; a\n8\tkey the schema someday makes optional goes in a total=False base. A value the\n9\tschema declares as an object with fixed properties but this module does not\n10\tyet name is a dict[str, Any] (or a list of them), no tighter than the schema's\n11\town `additionalProperties` allows for the adapter-owned ones.\n12\t\"\"\"\n13\tfrom __future__ import annotations\n14\t\n15\tfrom typing import Any, Literal, TypedDict\n16\t\n17\t# The stage names a record file's <stage>-NN.json prefix can carry, one per\n18\t# schema under schema/records/.\n19\tStage = Literal[\"spec\", \"approval\", \"build\", \"verify\", \"counsel\"]\n20\t\n21\t# \"class\" is a Python keyword, so the record kinds that carry it are built\n22\t# with the functional syntax.\n23\tStop = TypedDict(\"Stop\", {\n24\t    \"class\": str,\n25\t    \"provenance\": str,\n26\t    \"detail\": str | None,\n27\t})\n28\t\"\"\"build-NN.json's and verify-NN.json's `stop`: the class of a stop and whose\n29\tit is. The two schemas enumerate different classes; the shape is the same.\"\"\"\n30\t\n31\t\n32\tclass SpecRecord(TypedDict):\n33\t    record_version: int\n34\t    item: str\n35\t    sha: str\n36\t    spec_sha: str | None\n37\t    at: str\n38\t    status: str\n39\t    approval_sha: str | None\n40\t    criteria: list[dict[str, Any]]\n41\t    refusal: str | None\n42\t    product_version: str\n43\t    product_pin: str | None\n44\t\n45\t\n46\tclass ApprovalRecord(TypedDict):\n47\t    record_version: int\n48\t    item: str\n49\t    sha: str\n50\t    spec_sha: str | None\n51\t    approved_by: str\n52\t    at: str\n53\t    product_version: str\n54\t    product_pin: str | None\n55\t\n56\t\n57\tclass BuildRecord(TypedDict):\n58\t    record_version: int\n59\t    item: str\n60\t    sha: str\n61\t    start_sha: str\n62\t    spec_sha: str | None\n63\t    approval_sha: str | None\n64\t    at: str\n65\t    adapter: str\n66\t    adapter_config: dict[str, Any]\n67\t    executor_identity: dict[str, str]\n68\t    reports: list[str]\n69\t    adapter_version: str | None\n70\t    model: str | None\n71\t    model_version: str | None\n72\t    iterations: int\n73\t    criteria: list[dict[str, Any]]\n74\t    selected_tests: dict[str, Any] | None\n75\t    checks: dict[str, Any] | None\n76\t    tokens: dict[str, int]\n77\t    cost_usd: float | None\n78\t    wall_clock_s: float\n79\t    status: str\n80\t    refusal: str | None\n81\t    halted: dict[str, Any] | None\n82\t    stop: Stop | None\n83\t    product_version: str\n84\t    product_pin: str | None\n85\t\n86\t\n87\tclass VerifyRecord(TypedDict):\n88\t    record_version: int\n89\t    item: str\n90\t    sha: str\n91\t    build_sha: str\n92\t    build_record: str | None\n93\t    approval_sha: str | None\n94\t    at: str\n95\t    adapter: str | None\n96\t    adapter_config: dict[str, Any]\n97\t    adapter_version: str | None\n98\t    model: str | None\n99\t    model_version: str | None\n100\t    reports: list[str]\n101\t    forge_checks: dict[str, Any]\n102\t    findings: list[dict[str, Any]] | None\n103\t    tests_named: list[str]\n104\t    commits: list[str]\n105\t    mutation: dict[str, Any] | None\n106\t    weak_stub: bool\n107\t    stub_ratio: float | None\n108\t    tokens: dict[str, int]\n109\t    cost_usd: float | None\n110\t    wall_clock_s: float\n111\t    status: str\n112\t    stop: Stop | None\n113\t    product_version: str\n114\t    product_pin: str | None\n115\t\n116\t\n117\tCounselRecord = TypedDict(\"CounselRecord\", {\n118\t    \"record_version\": int,\n119\t    \"item\": str,\n120\t    \"sha\": str,\n121\t    \"record_stage\": str,\n122\t    \"record\": str,\n123\t    \"at\": str,\n124\t    \"adapter\": str | None,\n125\t    \"adapter_config\": dict[str, Any],\n126\t    \"adapter_version\": str | None,\n127\t    \"model\": str | None,\n128\t    \"model_version\": str | None,\n129\t    \"reports\": list[str],\n130\t    \"tokens\": dict[str, int],\n131\t    \"cost_usd\": float | None,\n132\t    \"wall_clock_s\": float,\n133\t    \"status\": str,\n134\t    \"class\": str | None,\n135\t    \"verdict\": str | None,\n136\t    \"citations\": list[dict[str, Any]],\n137\t    \"proposal\": dict[str, Any],\n138\t    \"forge\": dict[str, Any],\n139\t    \"question\": str | None,\n140\t    \"product_version\": str,\n141\t    \"product_pin\": str | None,\n142\t})\n143\t\n144\t\n145\tclass AttestRecord(TypedDict):\n146\t    \"\"\"The statement `attavo attest` prints (schema/attestation.schema.json).\"\"\"\n147\t    sha: str\n148\t    merge_sha: str\n149\t    item: str\n150\t    spec: str | None\n151\t    spec_sha: str | None\n152\t    approval: str | None\n153\t    approval_sha: str | None\n154\t    build: str | None\n155\t    build_sha: str | None\n156\t    verify: str | None\n157\t    verify_sha: str | None\n158\t    at: str\n159\t    interventions: list[dict[str, str]]\n160\t    acts: list[dict[str, str]]\n161\t    tokens_by_stage: dict[str, dict[str, Any] | None]\n162\t    cost_by_stage_usd: dict[str, float | None]\n163\t    wall_clock_by_stage_s: dict[str, float | None]\n164\t    product_version: str\n165\t    product_pin: str | None\n166\t\n167\t\n168\t# What counsel reads a stop from: a build or verify record, or a refused\n169\t# spec-gate record (issue #133).\n170\tStageRecord = SpecRecord | BuildRecord | VerifyRecord\n171\t"}]},"parent_tool_use_id":null,"session_id":"926377d2-0ca9-4491-82d5-45a2a39ba877","uuid":"bb4d342f-e005-42a4-b0fe-603a19bce2e6","timestamp":"2026-09-19T14:51:16.249Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-194/attavo/types.py","content":"\"\"\"The record kinds, typed. Each TypedDict here mirrors one JSON schema: its\nkeys are that schema's `properties` and its required keys are that schema's\n`required`, and tests/test_types_mirror_schemas.py asserts both, so the type\ncannot drift from the contract. The schema stays the contract; this is its\nmirror (issue #189).\n\nEvery key each schema lists is required, so no class here is total=False; a\nkey the schema someday makes optional goes in a total=False base. A value the\nschema declares as an object with fixed properties but this module does not\nyet name is a dict[str, Any] (or a list of them), no tighter than the schema's\nown `additionalProperties` allows for the adapter-owned ones.\n\"\"\"\nfrom __future__ import annotations\n\nfrom typing import Any, Literal, TypedDict\n\n# The stage names a record file's <stage>-NN.json prefix can carry, one per\n# schema under schema/records/.\nStage = Literal[\"spec\", \"approval\", \"build\", \"verify\", \"counsel\"]\n\n# \"class\" is a Python keyword, so the record kinds that carry it are built\n# with the functional syntax.\nStop = TypedDict(\"Stop\", {\n    \"class\": str,\n    \"provenance\": str,\n    \"detail\": str | None,\n})\n\"\"\"build-NN.json's and verify-NN.json's `stop`: the class of a stop and whose\nit is. The two schemas enumerate different classes; the shape is the same.\"\"\"\n\n\nclass SpecRecord(TypedDict):\n    record_version: int\n    item: str\n    sha: str\n    spec_sha: str | None\n    at: str\n    status: str\n    approval_sha: str | None\n    criteria: list[dict[str, Any]]\n    refusal: str | None\n    product_version: str\n    product_pin: str | None\n\n\nclass ApprovalRecord(TypedDict):\n    record_version: int\n    item: str\n    sha: str\n    spec_sha: str | None\n    approved_by: str\n    at: str\n    product_version: str\n    product_pin: str | None\n\n\nclass BuildRecord(TypedDict):\n    record_version: int\n    item: str\n    sha: str\n    start_sha: str\n    spec_sha: str | None\n    approval_sha: str | None\n    at: str\n    adapter: str\n    adapter_config: dict[str, Any]\n    executor_identity: dict[str, str]\n    reports: list[str]\n    adapter_version: str | None\n    model: str | None\n    model_version: str | None\n    iterations: int\n    criteria: list[dict[str, Any]]\n    selected_tests: dict[str, Any] | None\n    checks: dict[str, Any] | None\n    tokens: dict[str, int]\n    cost_usd: float | None\n    wall_clock_s: float\n    status: str\n    refusal: str | None\n    halted: dict[str, Any] | None\n    stop: Stop | None\n    product_version: str\n    product_pin: str | None\n\n\nclass VerifyRecord(TypedDict):\n    record_version: int\n    item: str\n    sha: str\n    build_sha: str\n    build_record: str | None\n    approval_sha: str | None\n    at: str\n    adapter: str | None\n    adapter_config: dict[str, Any]\n    adapter_version: str | None\n    model: str | None\n    model_version: str | None\n    reports: list[str]\n    forge_checks: dict[str, Any]\n    findings: list[dict[str, Any]] | None\n    tests_named: list[str]\n    commits: list[str]\n    mutation: dict[str, Any] | None\n    weak_stub: bool\n    stub_ratio: float | None\n    tokens: dict[str, int]\n    cost_usd: float | None\n    wall_clock_s: float\n    status: str\n    stop: Stop | None\n    product_version: str\n    product_pin: str | None\n\n\nCounselRecord = TypedDict(\"CounselRecord\", {\n    \"record_version\": int,\n    \"item\": str,\n    \"sha\": str,\n    \"record_stage\": str,\n    \"record\": str,\n    \"at\": str,\n    \"adapter\": str | None,\n    \"adapter_config\": dict[str, Any],\n    \"adapter_version\": str | None,\n    \"model\": str | None,\n    \"model_version\": str | None,\n    \"reports\": list[str],\n    \"tokens\": dict[str, int],\n    \"cost_usd\": float | None,\n    \"wall_clock_s\": float,\n    \"status\": str,\n    \"class\": str | None,\n    \"verdict\": str | None,\n    \"citations\": list[dict[str, Any]],\n    \"proposal\": dict[str, Any],\n    \"forge\": dict[str, Any],\n    \"question\": str | None,\n    \"product_version\": str,\n    \"product_pin\": str | None,\n})\n\n\nclass AttestRecord(TypedDict):\n    \"\"\"The statement `attavo attest` prints (schema/attestation.schema.json).\"\"\"\n    sha: str\n    merge_sha: str\n    item: str\n    spec: str | None\n    spec_sha: str | None\n    approval: str | None\n    approval_sha: str | None\n    build: str | None\n    build_sha: str | None\n    verify: str | None\n    verify_sha: str | None\n    at: str\n    interventions: list[dict[str, str]]\n    acts: list[dict[str, str]]\n    tokens_by_stage: dict[str, dict[str, Any] | None]\n    cost_by_stage_usd: dict[str, float | None]\n    wall_clock_by_stage_s: dict[str, float | None]\n    product_version: str\n    product_pin: str | None\n\n\n# What counsel reads a stop from: a build or verify record, or a refused\n# spec-gate record (issue #133).\nStageRecord = SpecRecord | BuildRecord | VerifyRecord\n","numLines":171,"startLine":1,"totalLines":171}}}

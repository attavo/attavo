{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016zdofkKLRRHwF6VnFanLpu","type":"tool_result","content":"1\tfrom __future__ import annotations\n2\t\n3\timport json\n4\timport sys\n5\tfrom pathlib import Path\n6\tfrom typing import cast\n7\t\n8\tfrom attavo.common import MANIFEST, git, now_iso, product_version, read_manifest\n9\tfrom attavo.records import latest_attempt_path, latest_record, parse_attempts\n10\tfrom attavo.types import ApprovalRecord, AttestRecord, BuildRecord, SpecRecord, VerifyRecord\n11\t\n12\t# --- attest: the signed envelope over one item's whole traversal ---\n13\t\n14\tdef derive_attest_items(root: Path, records_rel: str) -> tuple[set[str], str | None]:\n15\t    \"\"\"The item ids from the merge commit's own first-parent diff -- record\n16\t    paths under records_rel/<N>/, not a branch name, which a squash merge\n17\t    discards and which names a forge's convention the product does not\n18\t    know. Returns (items, None), else (empty set, reason) only when the\n19\t    diff itself could not be read -- zero items found is not an error\n20\t    here (issue #58): not every merge is an item merge, and the caller\n21\t    decides what zero, one, or more than one means.\"\"\"\n22\t    try:\n23\t        changed = git(root, \"diff\", \"--name-only\", \"HEAD^1\", \"HEAD\").splitlines()\n24\t    except RuntimeError as exc:\n25\t        return set(), f\"git: {exc}\"\n26\t    prefix = records_rel.rstrip(\"/\") + \"/\"\n27\t    items: set[str] = set()\n28\t    for p in changed:\n29\t        if p.startswith(prefix):\n30\t            rest = p[len(prefix):]\n31\t            item = rest.split(\"/\", 1)[0]\n32\t            if item:\n33\t                items.add(item)\n34\t    return items, None\n35\t\n36\t\n37\tNOT_YET = object()\n38\t\n39\tChainRecords = tuple[SpecRecord, ApprovalRecord, BuildRecord, VerifyRecord]\n40\t\n41\t\n42\tdef check_attest_chain(records_dir: Path, item_id: str, partial: bool = False\n43\t                       ) -> tuple[ChainRecords | object | None, str | None]:\n44\t    \"\"\"The two assertions attavo attest refuses on: the latest spec,\n45\t    approval, build, and verify records for item_id all exist, and\n46\t    build's approval_sha names the latest approval -- a re-approval after\n47\t    a build must force a re-run of what changed. Returns (None, message)\n48\t    on either of them, the message being the same text attest prints, not\n49\t    a copy of it a caller re-types (issue #74: proof two reuses it);\n50\t    returns ((spec, approval, build, verify), None) when the chain holds.\n51\t\n52\t    A verify record can only name a build that existed when it was\n53\t    written (issue #109), so a latest verify whose build_sha is not the\n54\t    latest build's sha is never a corrupt chain -- it is a verify\n55\t    superseded by a later build, and is treated as absent: the next\n56\t    stage is verify, not a refusal, exactly as if no verify record\n57\t    existed yet.\n58\t\n59\t    partial (issue #67) is for a pull request, where a later stage's\n60\t    record cannot exist yet because the stage that would produce it is\n61\t    itself waiting on this check. Under partial, a missing (or\n62\t    superseded) record is not a refusal -- the chain assertion still\n63\t    runs over whatever records exist, and (NOT_YET, message) is\n64\t    returned, the message naming the item and the stages present and\n65\t    absent -- or, for a superseded verify, the superseded record and the\n66\t    build it named -- when a stage is still missing once that assertion\n67\t    holds.\"\"\"\n68\t    latest_spec = latest_record(records_dir, \"spec\")\n69\t    latest_approval = latest_record(records_dir, \"approval\")\n70\t    latest_build = latest_record(records_dir, \"build\")\n71\t    latest_verify = latest_record(records_dir, \"verify\")\n72\t\n73\t    # A verify naming a sha other than the latest build's is superseded:\n74\t    # treated as absent for the chain, never as a mismatch.\n75\t    superseded = None\n76\t    if latest_build is not None and latest_verify is not None:\n77\t        named_sha = latest_verify.get(\"build_sha\")\n78\t        if named_sha != latest_build.get(\"sha\"):\n79\t            verify_n = max(parse_attempts(records_dir, \"verify\"))\n80\t            build_attempts = parse_attempts(records_dir, \"build\")\n81\t            named_build_n = next((n for n, rec in build_attempts.items()\n82\t                                  if rec.get(\"sha\") == named_sha), None)\n83\t            named_build = f\"build-{named_build_n:02d}\" if named_build_n is not None else named_sha\n84\t            superseded = (verify_n, named_sha, named_build, max(build_attempts))\n85\t            latest_verify = None\n86\t\n87\t    stages = ((\"spec\", latest_spec), (\"approval\", latest_approval),\n88\t              (\"build\", latest_build), (\"verify\", latest_verify))\n89\t\n90\t    if not partial:\n91\t        for stage, rec in stages:\n92\t            if rec is None:\n93\t                if stage == \"verify\" and superseded is not None:\n94\t                    verify_n, named_sha, _, _ = superseded\n95\t                    return None, (f\"no verify names the latest build \"\n96\t                                 f\"(verify-{verify_n:02d} names {named_sha})\")\n97\t                return None, f\"no {stage} record for item {item_id}\"\n98\t\n99\t    if latest_approval is not None and latest_build is not None:\n100\t        if latest_build.get(\"approval_sha\") != latest_approval.get(\"sha\"):\n101\t            return None, (\"build's approval_sha does not name the latest approval; a \"\n102\t                          \"re-approval after the build must force a re-run\")\n103\t\n104\t    missing = [stage for stage, rec in stages if rec is None]\n105\t    if partial and missing:\n106\t        present = [stage for stage, rec in stages if rec is not None]\n107\t        if missing == [\"verify\"] and superseded is not None:\n108\t            verify_n, _, named_build, latest_build_n = superseded\n109\t            return NOT_YET, (f\"item {item_id} not yet (present: {', '.join(present) or 'none'}; \"\n110\t                             f\"verify-{verify_n:02d} names {named_build}, \"\n111\t                             f\"superseded by build-{latest_build_n:02d})\")\n112\t        return NOT_YET, (f\"item {item_id} not yet (present: {', '.join(present) or 'none'}; \"\n113\t                         f\"absent: {', '.join(missing)})\")\n114\t\n115\t    # Every record is present here: without partial, the loop above refused on\n116\t    # a missing one; with partial, `missing` non-empty returned NOT_YET.\n117\t    return cast(ChainRecords, (latest_spec, latest_approval, latest_build, latest_verify)), None\n118\t\n119\t\n120\tdef cmd_attest(argv: list[str]) -> int:\n121\t    partial = \"--partial\" in argv\n122\t    positional = [a for a in argv if not a.startswith(\"--\")]\n123\t    unknown = [a for a in argv if a.startswith(\"--\") and a != \"--partial\"]\n124\t    if unknown:\n125\t        print(f\"attavo attest: unknown argument {unknown[0]!r}\", file=sys.stderr)\n126\t        return 2\n127\t\n128\t    root = Path(\".\").resolve()\n129\t    m = read_manifest(root)\n130\t    if m is None:\n131\t        print(f\"attavo attest: no {MANIFEST} at {root}\", file=sys.stderr)\n132\t        return 2\n133\t\n134\t    records_rel = m[\"paths\"][\"records\"]\n135\t    item_id = positional[0] if positional else None\n136\t    if item_id is None:\n137\t        items, err = derive_attest_items(root, records_rel)\n138\t        if err:\n139\t            print(f\"attavo attest: refused: {err}\", file=sys.stderr)\n140\t            return 1\n141\t        # Not every merge is an item merge -- a merge that carries no item\n142\t        # at all is an ordinary fact, not a defect (issue #58); the\n143\t        # attest template runs this on every push and has nothing to\n144\t        # sign or commit when nothing was attested, and its existing\n145\t        # `if:` guards already read this step's own exit code.\n146\t        if not items:\n147\t            print(\"attavo attest: no item derived from the merge commit's record paths; \"\n148\t                  \"nothing to attest\")\n149\t            return 0\n150\t        if len(items) > 1:\n151\t            print(f\"attavo attest: refused: {len(items)} items derived from the merge \"\n152\t                  f\"commit's record paths: {', '.join(sorted(items))}\", file=sys.stderr)\n153\t            return 1\n154\t        item_id = next(iter(items))\n155\t\n156\t    records_dir = root / records_rel / item_id\n157\t    chain, message = check_attest_chain(records_dir, item_id, partial=partial)\n158\t    if chain is None:\n159\t        print(f\"attavo attest: refused: {message}\", file=sys.stderr)\n160\t        return 1\n161\t    if chain is NOT_YET:\n162\t        print(f\"attavo attest --partial: {message}\")\n163\t        return 0\n164\t    latest_spec, latest_approval, latest_build, latest_verify = cast(ChainRecords, chain)\n165\t\n166\t    spec_path = latest_attempt_path(records_dir, \"spec\")\n167\t    approval_path = latest_attempt_path(records_dir, \"approval\")\n168\t    build_path = latest_attempt_path(records_dir, \"build\")\n169\t    verify_path = latest_attempt_path(records_dir, \"verify\")\n170\t\n171\t    # sha and merge_sha are the same commit here -- the one this statement\n172\t    # was computed at. On the merge group that commit is the one main will\n173\t    # hold; kept as two fields because a forge-specific template signs\n174\t    # this statement against \"the commit that lands\", naming it merge_sha\n175\t    # is what makes that unambiguous to a reader who has never seen attest\n176\t    # run anywhere but the merge group.\n177\t    head_sha = git(root, \"rev-parse\", \"HEAD\").strip()\n178\t\n179\t    statement: AttestRecord = {\n180\t        \"sha\": head_sha,\n181\t        \"merge_sha\": head_sha,\n182\t        \"item\": item_id,\n183\t        \"spec\": spec_path.stem if spec_path else None,\n184\t        \"spec_sha\": latest_spec.get(\"sha\"),\n185\t        \"approval\": approval_path.stem if approval_path else None,\n186\t        \"approval_sha\": latest_approval.get(\"sha\"),\n187\t        \"build\": build_path.stem if build_path else None,\n188\t        \"build_sha\": latest_build.get(\"sha\"),\n189\t        \"verify\": verify_path.stem if verify_path else None,\n190\t        \"verify_sha\": latest_verify.get(\"sha\"),\n191\t        \"at\": now_iso(),\n192\t        # Neither is populated by anything today -- no ruling or amendment\n193\t        # log exists yet for either to read from. Carried as empty rather\n194\t        # than omitted, since the schema names them.\n195\t        \"interventions\": [],\n196\t        \"acts\": [],\n197\t        \"tokens_by_stage\": {\"build\": latest_build.get(\"tokens\"), \"verify\": latest_verify.get(\"tokens\")},\n198\t        # Never summed across stages -- the 2026-09-09 ruling on reporting\n199\t        # across vendors: a stage's executor may report no cost at all.\n200\t        \"cost_by_stage_usd\": {\"build\": latest_build.get(\"cost_usd\"), \"verify\": latest_verify.get(\"cost_usd\")},\n201\t        \"wall_clock_by_stage_s\": {\"build\": latest_build.get(\"wall_clock_s\"),\n202\t                                  \"verify\": latest_verify.get(\"wall_clock_s\")},\n203\t        \"product_version\": product_version(),\n204\t        \"product_pin\": (m.get(\"attavo\") or {}).get(\"version\"),\n205\t    }\n206\t    print(json.dumps(statement, indent=2))\n207\t    return 0\n208\t"}]},"parent_tool_use_id":null,"session_id":"926377d2-0ca9-4491-82d5-45a2a39ba877","uuid":"d8ccc0f4-ae3e-4780-9d17-a99e9a997e31","timestamp":"2026-09-19T14:51:15.502Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-194/attavo/attest.py","content":"from __future__ import annotations\n\nimport json\nimport sys\nfrom pathlib import Path\nfrom typing import cast\n\nfrom attavo.common import MANIFEST, git, now_iso, product_version, read_manifest\nfrom attavo.records import latest_attempt_path, latest_record, parse_attempts\nfrom attavo.types import ApprovalRecord, AttestRecord, BuildRecord, SpecRecord, VerifyRecord\n\n# --- attest: the signed envelope over one item's whole traversal ---\n\ndef derive_attest_items(root: Path, records_rel: str) -> tuple[set[str], str | None]:\n    \"\"\"The item ids from the merge commit's own first-parent diff -- record\n    paths under records_rel/<N>/, not a branch name, which a squash merge\n    discards and which names a forge's convention the product does not\n    know. Returns (items, None), else (empty set, reason) only when the\n    diff itself could not be read -- zero items found is not an error\n    here (issue #58): not every merge is an item merge, and the caller\n    decides what zero, one, or more than one means.\"\"\"\n    try:\n        changed = git(root, \"diff\", \"--name-only\", \"HEAD^1\", \"HEAD\").splitlines()\n    except RuntimeError as exc:\n        return set(), f\"git: {exc}\"\n    prefix = records_rel.rstrip(\"/\") + \"/\"\n    items: set[str] = set()\n    for p in changed:\n        if p.startswith(prefix):\n            rest = p[len(prefix):]\n            item = rest.split(\"/\", 1)[0]\n            if item:\n                items.add(item)\n    return items, None\n\n\nNOT_YET = object()\n\nChainRecords = tuple[SpecRecord, ApprovalRecord, BuildRecord, VerifyRecord]\n\n\ndef check_attest_chain(records_dir: Path, item_id: str, partial: bool = False\n                       ) -> tuple[ChainRecords | object | None, str | None]:\n    \"\"\"The two assertions attavo attest refuses on: the latest spec,\n    approval, build, and verify records for item_id all exist, and\n    build's approval_sha names the latest approval -- a re-approval after\n    a build must force a re-run of what changed. Returns (None, message)\n    on either of them, the message being the same text attest prints, not\n    a copy of it a caller re-types (issue #74: proof two reuses it);\n    returns ((spec, approval, build, verify), None) when the chain holds.\n\n    A verify record can only name a build that existed when it was\n    written (issue #109), so a latest verify whose build_sha is not the\n    latest build's sha is never a corrupt chain -- it is a verify\n    superseded by a later build, and is treated as absent: the next\n    stage is verify, not a refusal, exactly as if no verify record\n    existed yet.\n\n    partial (issue #67) is for a pull request, where a later stage's\n    record cannot exist yet because the stage that would produce it is\n    itself waiting on this check. Under partial, a missing (or\n    superseded) record is not a refusal -- the chain assertion still\n    runs over whatever records exist, and (NOT_YET, message) is\n    returned, the message naming the item and the stages present and\n    absent -- or, for a superseded verify, the superseded record and the\n    build it named -- when a stage is still missing once that assertion\n    holds.\"\"\"\n    latest_spec = latest_record(records_dir, \"spec\")\n    latest_approval = latest_record(records_dir, \"approval\")\n    latest_build = latest_record(records_dir, \"build\")\n    latest_verify = latest_record(records_dir, \"verify\")\n\n    # A verify naming a sha other than the latest build's is superseded:\n    # treated as absent for the chain, never as a mismatch.\n    superseded = None\n    if latest_build is not None and latest_verify is not None:\n        named_sha = latest_verify.get(\"build_sha\")\n        if named_sha != latest_build.get(\"sha\"):\n            verify_n = max(parse_attempts(records_dir, \"verify\"))\n            build_attempts = parse_attempts(records_dir, \"build\")\n            named_build_n = next((n for n, rec in build_attempts.items()\n                                  if rec.get(\"sha\") == named_sha), None)\n            named_build = f\"build-{named_build_n:02d}\" if named_build_n is not None else named_sha\n            superseded = (verify_n, named_sha, named_build, max(build_attempts))\n            latest_verify = None\n\n    stages = ((\"spec\", latest_spec), (\"approval\", latest_approval),\n              (\"build\", latest_build), (\"verify\", latest_verify))\n\n    if not partial:\n        for stage, rec in stages:\n            if rec is None:\n                if stage == \"verify\" and superseded is not None:\n                    verify_n, named_sha, _, _ = superseded\n                    return None, (f\"no verify names the latest build \"\n                                 f\"(verify-{verify_n:02d} names {named_sha})\")\n                return None, f\"no {stage} record for item {item_id}\"\n\n    if latest_approval is not None and latest_build is not None:\n        if latest_build.get(\"approval_sha\") != latest_approval.get(\"sha\"):\n            return None, (\"build's approval_sha does not name the latest approval; a \"\n                          \"re-approval after the build must force a re-run\")\n\n    missing = [stage for stage, rec in stages if rec is None]\n    if partial and missing:\n        present = [stage for stage, rec in stages if rec is not None]\n        if missing == [\"verify\"] and superseded is not None:\n            verify_n, _, named_build, latest_build_n = superseded\n            return NOT_YET, (f\"item {item_id} not yet (present: {', '.join(present) or 'none'}; \"\n                             f\"verify-{verify_n:02d} names {named_build}, \"\n                             f\"superseded by build-{latest_build_n:02d})\")\n        return NOT_YET, (f\"item {item_id} not yet (present: {', '.join(present) or 'none'}; \"\n                         f\"absent: {', '.join(missing)})\")\n\n    # Every record is present here: without partial, the loop above refused on\n    # a missing one; with partial, `missing` non-empty returned NOT_YET.\n    return cast(ChainRecords, (latest_spec, latest_approval, latest_build, latest_verify)), None\n\n\ndef cmd_attest(argv: list[str]) -> int:\n    partial = \"--partial\" in argv\n    positional = [a for a in argv if not a.startswith(\"--\")]\n    unknown = [a for a in argv if a.startswith(\"--\") and a != \"--partial\"]\n    if unknown:\n        print(f\"attavo attest: unknown argument {unknown[0]!r}\", file=sys.stderr)\n        return 2\n\n    root = Path(\".\").resolve()\n    m = read_manifest(root)\n    if m is None:\n        print(f\"attavo attest: no {MANIFEST} at {root}\", file=sys.stderr)\n        return 2\n\n    records_rel = m[\"paths\"][\"records\"]\n    item_id = positional[0] if positional else None\n    if item_id is None:\n        items, err = derive_attest_items(root, records_rel)\n        if err:\n            print(f\"attavo attest: refused: {err}\", file=sys.stderr)\n            return 1\n        # Not every merge is an item merge -- a merge that carries no item\n        # at all is an ordinary fact, not a defect (issue #58); the\n        # attest template runs this on every push and has nothing to\n        # sign or commit when nothing was attested, and its existing\n        # `if:` guards already read this step's own exit code.\n        if not items:\n            print(\"attavo attest: no item derived from the merge commit's record paths; \"\n                  \"nothing to attest\")\n            return 0\n        if len(items) > 1:\n            print(f\"attavo attest: refused: {len(items)} items derived from the merge \"\n                  f\"commit's record paths: {', '.join(sorted(items))}\", file=sys.stderr)\n            return 1\n        item_id = next(iter(items))\n\n    records_dir = root / records_rel / item_id\n    chain, message = check_attest_chain(records_dir, item_id, partial=partial)\n    if chain is None:\n        print(f\"attavo attest: refused: {message}\", file=sys.stderr)\n        return 1\n    if chain is NOT_YET:\n        print(f\"attavo attest --partial: {message}\")\n        return 0\n    latest_spec, latest_approval, latest_build, latest_verify = cast(ChainRecords, chain)\n\n    spec_path = latest_attempt_path(records_dir, \"spec\")\n    approval_path = latest_attempt_path(records_dir, \"approval\")\n    build_path = latest_attempt_path(records_dir, \"build\")\n    verify_path = latest_attempt_path(records_dir, \"verify\")\n\n    # sha and merge_sha are the same commit here -- the one this statement\n    # was computed at. On the merge group that commit is the one main will\n    # hold; kept as two fields because a forge-specific template signs\n    # this statement against \"the commit that lands\", naming it merge_sha\n    # is what makes that unambiguous to a reader who has never seen attest\n    # run anywhere but the merge group.\n    head_sha = git(root, \"rev-parse\", \"HEAD\").strip()\n\n    statement: AttestRecord = {\n        \"sha\": head_sha,\n        \"merge_sha\": head_sha,\n        \"item\": item_id,\n        \"spec\": spec_path.stem if spec_path else None,\n        \"spec_sha\": latest_spec.get(\"sha\"),\n        \"approval\": approval_path.stem if approval_path else None,\n        \"approval_sha\": latest_approval.get(\"sha\"),\n        \"build\": build_path.stem if build_path else None,\n        \"build_sha\": latest_build.get(\"sha\"),\n        \"verify\": verify_path.stem if verify_path else None,\n        \"verify_sha\": latest_verify.get(\"sha\"),\n        \"at\": now_iso(),\n        # Neither is populated by anything today -- no ruling or amendment\n        # log exists yet for either to read from. Carried as empty rather\n        # than omitted, since the schema names them.\n        \"interventions\": [],\n        \"acts\": [],\n        \"tokens_by_stage\": {\"build\": latest_build.get(\"tokens\"), \"verify\": latest_verify.get(\"tokens\")},\n        # Never summed across stages -- the 2026-09-09 ruling on reporting\n        # across vendors: a stage's executor may report no cost at all.\n        \"cost_by_stage_usd\": {\"build\": latest_build.get(\"cost_usd\"), \"verify\": latest_verify.get(\"cost_usd\")},\n        \"wall_clock_by_stage_s\": {\"build\": latest_build.get(\"wall_clock_s\"),\n                                  \"verify\": latest_verify.get(\"wall_clock_s\")},\n        \"product_version\": product_version(),\n        \"product_pin\": (m.get(\"attavo\") or {}).get(\"version\"),\n    }\n    print(json.dumps(statement, indent=2))\n    return 0\n","numLines":208,"startLine":1,"totalLines":208}}}

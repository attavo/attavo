{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01W1URL6NYsYU1fHBq2dg1pV","type":"tool_result","content":"git symbolic-ref refs/remotes/origin/HEAD refs/remotes/origin/main\nmerge=$(git rev-parse HEAD)\nmerged_at=$(git show -s --format=%ct HEAD)\npython3 \"$here/bin/attavo\" attest 1 > statement.json\npython3 - \"$here\" \"$merged_at\" <<'PY'\nimport json, sys\nhere, merged_at = sys.argv[1], int(sys.argv[2])\ns = json.load(open(\"statement.json\"))\nschema = json.load(open(here + \"/schema/attestation.schema.json\"))\nassert schema[\"$id\"].endswith(\"/v3\"), schema[\"$id\"]\nassert set(schema[\"required\"]) <= set(s), sorted(set(schema[\"required\"]) - set(s))\nassert set(s) <= set(schema[\"properties\"]), sorted(set(s) - set(schema[\"properties\"]))\nassert set(s[\"time\"]) == set(schema[\"properties\"][\"time\"][\"required\"]), s[\"time\"]\nt = s[\"time\"]\nassert t[\"build\"] == {\"attempts\": 3, \"invocation_s\": 350.75, \"partial\": False}, t\nassert t[\"verify\"] == {\"attempts\": 2, \"invocation_s\": 40.0, \"partial\": False}, t\nassert t[\"counsel\"] == {\"attempts\": 1, \"invocation_s\": 7.5, \"partial\": False}, t\nassert t[\"invocation_s\"] == 398.25 and t[\"partial\"] is False and t[\"not_read\"] == [], t\nassert s[\"wall_clock_by_stage_s\"] == {\"build\": 50.25, \"verify\": 30.0}, s\nassert t[\"lead_s\"] == merged_at - 1767225600, t\nassert t[\"waiting_s\"] == round(t[\"lead_s\"] - 398.25, 3), t\nPY\ncd \"$here\"\nrm -rf \"$tmp\"\n11c11\n< from attavo.attest import check_attest_chain, item_time_and_cost\n---\n> from attavo.attest import check_attest_chain\n609,628d608\n< def _time_disagrees(item_records_dir: Path, item: str, merge_sha: str,\n<                     statement: dict[str, Any]) -> str | None:\n<     \"\"\"A sealed statement that carries `time` says the invocation_s its\n<     records sum to -- the same function attest summed them with, over the\n<     same records (no record is written after a merge). A statement sealed\n<     before `time` existed carries none and is not checked. No new read of\n<     the store: the statement is the one proof six already holds.\"\"\"\n<     inner = statement.get(\"predicate\")\n<     predicate = inner if isinstance(inner, dict) else statement\n<     stated_time = predicate.get(\"time\")\n<     if not isinstance(stated_time, dict):\n<         return None\n<     summed = item_time_and_cost(item_records_dir, None)[0][\"invocation_s\"]\n<     stated = stated_time.get(\"invocation_s\")\n<     if isinstance(stated, bool) or not isinstance(stated, (int, float)) or abs(stated - summed) > 1.0:\n<         return (f\"item {item} merged at {merge_sha[:12]}: the statement's time.invocation_s \"\n<                 f\"{stated} is not its records' {summed}\")\n<     return None\n< \n< \n669,671d648\n<             disagreement = _time_disagrees(records_dir / item, item, merge_sha, statement)\n<             if disagreement:\n<                 reasons.append(disagreement)\n145,177d144\n< class StageTime(TypedDict):\n<     \"\"\"One stage's invocations summed (the statement's `time` block).\"\"\"\n<     attempts: int\n<     invocation_s: float\n<     partial: bool\n< \n< \n< class ItemTime(TypedDict):\n<     \"\"\"Every invocation's wall_clock_s, per stage and for the item, beside\n<     the item's lead time -- summed from the records by `attavo attest`, so\n<     a view renders it and never derives it.\"\"\"\n<     build: StageTime\n<     verify: StageTime\n<     counsel: StageTime\n<     invocation_s: float\n<     lead_s: float | None\n<     waiting_s: float | None\n<     partial: bool\n<     not_read: list[str]\n< \n< \n< class ItemCost(TypedDict):\n<     \"\"\"Every record's cost_usd summed: the item's total across stages and\n<     executors, with a subtotal per stage and per adapter. A record with no\n<     cost_usd is named in not_read and makes every sum it belongs to\n<     partial -- absent is never zero.\"\"\"\n<     usd: float\n<     by_stage_usd: dict[str, float]\n<     by_adapter_usd: dict[str, float]\n<     partial: bool\n<     not_read: list[str]\n< \n< \n197,198d163\n<     time: ItemTime\n<     cost: ItemCost\n3c3\n<   \"$id\": \"https://attavo.dev/attestation/v3\",\n---\n>   \"$id\": \"https://attavo.dev/attestation/v2\",\n10c10\n<     \"tokens_by_stage\", \"cost_by_stage_usd\", \"wall_clock_by_stage_s\", \"time\", \"cost\",\n---\n>     \"tokens_by_stage\", \"cost_by_stage_usd\", \"wall_clock_by_stage_s\",\n65c65\n<       \"description\": \"The final attempt's cost per stage, as its record carries it; the item's sums are in `cost`.\",\n---\n>       \"description\": \"Never summed across stages -- a stage's own executor may report no cost at all.\",\n82,110d81\n<     \"time\": {\n<       \"type\": \"object\",\n<       \"description\": \"Every invocation of the item, summed by attest from its stage records' wall_clock_s: per stage and for the item, every attempt and not the final one alone (wall_clock_by_stage_s is the final attempt). lead_s runs from the first approval record's `at` to the committer time of the commit the statement is computed at; waiting_s is lead_s minus invocation_s. A record with no wall_clock_s is named in not_read and its sums are partial, never smaller in silence.\",\n<       \"additionalProperties\": false,\n<       \"required\": [\"build\", \"verify\", \"counsel\", \"invocation_s\", \"lead_s\", \"waiting_s\", \"partial\", \"not_read\"],\n<       \"properties\": {\n<         \"build\": {\"$ref\": \"#/$defs/stage_time\"},\n<         \"verify\": {\"$ref\": \"#/$defs/stage_time\"},\n<         \"counsel\": {\"$ref\": \"#/$defs/stage_time\"},\n<         \"invocation_s\": {\"type\": \"number\", \"minimum\": 0},\n<         \"lead_s\": {\"type\": [\"number\", \"null\"]},\n<         \"waiting_s\": {\"type\": [\"number\", \"null\"]},\n<         \"partial\": {\"type\": \"boolean\"},\n<         \"not_read\": {\"type\": \"array\", \"items\": {\"type\": \"string\", \"minLength\": 1}}\n<       }\n<     },\n<     \"cost\": {\n<       \"type\": \"object\",\n<       \"description\": \"Every record's cost_usd summed by attest: the item's total across stages and executors (ruled 2026-09-19, superseding the 2026-09-09 ruling against a cross-executor sum), with a subtotal per stage and per adapter. Each figure is what the record carries. A record with no cost_usd is named in not_read and makes usd and the subtotals it belongs to partial: absent is never zero, and a partial total says so.\",\n<       \"additionalProperties\": false,\n<       \"required\": [\"usd\", \"by_stage_usd\", \"by_adapter_usd\", \"partial\", \"not_read\"],\n<       \"properties\": {\n<         \"usd\": {\"type\": \"number\", \"minimum\": 0},\n<         \"by_stage_usd\": {\"type\": \"object\", \"additionalProperties\": {\"type\": \"number\", \"minimum\": 0}},\n<         \"by_adapter_usd\": {\"type\": \"object\", \"additionalProperties\": {\"type\": \"number\", \"minimum\": 0}},\n<         \"partial\": {\"type\": \"boolean\"},\n<         \"not_read\": {\"type\": \"array\", \"items\": {\"type\": \"string\", \"minLength\": 1}}\n<       }\n<     },\n113,124d83\n<   },\n<   \"$defs\": {\n<     \"stage_time\": {\n<       \"type\": \"object\",\n<       \"additionalProperties\": false,\n<       \"required\": [\"attempts\", \"invocation_s\", \"partial\"],\n<       \"properties\": {\n<         \"attempts\": {\"type\": \"integer\", \"minimum\": 0},\n<         \"invocation_s\": {\"type\": \"number\", \"minimum\": 0},\n<         \"partial\": {\"type\": \"boolean\"}\n<       }\n<     }","is_error":false}]},"parent_tool_use_id":null,"session_id":"926377d2-0ca9-4491-82d5-45a2a39ba877","uuid":"08210f91-ad10-485c-b605-959fa8ba2752","timestamp":"2026-09-19T14:51:31.627Z","tool_use_result":{"stdout":"git symbolic-ref refs/remotes/origin/HEAD refs/remotes/origin/main\nmerge=$(git rev-parse HEAD)\nmerged_at=$(git show -s --format=%ct HEAD)\npython3 \"$here/bin/attavo\" attest 1 > statement.json\npython3 - \"$here\" \"$merged_at\" <<'PY'\nimport json, sys\nhere, merged_at = sys.argv[1], int(sys.argv[2])\ns = json.load(open(\"statement.json\"))\nschema = json.load(open(here + \"/schema/attestation.schema.json\"))\nassert schema[\"$id\"].endswith(\"/v3\"), schema[\"$id\"]\nassert set(schema[\"required\"]) <= set(s), sorted(set(schema[\"required\"]) - set(s))\nassert set(s) <= set(schema[\"properties\"]), sorted(set(s) - set(schema[\"properties\"]))\nassert set(s[\"time\"]) == set(schema[\"properties\"][\"time\"][\"required\"]), s[\"time\"]\nt = s[\"time\"]\nassert t[\"build\"] == {\"attempts\": 3, \"invocation_s\": 350.75, \"partial\": False}, t\nassert t[\"verify\"] == {\"attempts\": 2, \"invocation_s\": 40.0, \"partial\": False}, t\nassert t[\"counsel\"] == {\"attempts\": 1, \"invocation_s\": 7.5, \"partial\": False}, t\nassert t[\"invocation_s\"] == 398.25 and t[\"partial\"] is False and t[\"not_read\"] == [], t\nassert s[\"wall_clock_by_stage_s\"] == {\"build\": 50.25, \"verify\": 30.0}, s\nassert t[\"lead_s\"] == merged_at - 1767225600, t\nassert t[\"waiting_s\"] == round(t[\"lead_s\"] - 398.25, 3), t\nPY\ncd \"$here\"\nrm -rf \"$tmp\"\n11c11\n< from attavo.attest import check_attest_chain, item_time_and_cost\n---\n> from attavo.attest import check_attest_chain\n609,628d608\n< def _time_disagrees(item_records_dir: Path, item: str, merge_sha: str,\n<                     statement: dict[str, Any]) -> str | None:\n<     \"\"\"A sealed statement that carries `time` says the invocation_s its\n<     records sum to -- the same function attest summed them with, over the\n<     same records (no record is written after a merge). A statement sealed\n<     before `time` existed carries none and is not checked. No new read of\n<     the store: the statement is the one proof six already holds.\"\"\"\n<     inner = statement.get(\"predicate\")\n<     predicate = inner if isinstance(inner, dict) else statement\n<     stated_time = predicate.get(\"time\")\n<     if not isinstance(stated_time, dict):\n<         return None\n<     summed = item_time_and_cost(item_records_dir, None)[0][\"invocation_s\"]\n<     stated = stated_time.get(\"invocation_s\")\n<     if isinstance(stated, bool) or not isinstance(stated, (int, float)) or abs(stated - summed) > 1.0:\n<         return (f\"item {item} merged at {merge_sha[:12]}: the statement's time.invocation_s \"\n<                 f\"{stated} is not its records' {summed}\")\n<     return None\n< \n< \n669,671d648\n<             disagreement = _time_disagrees(records_dir / item, item, merge_sha, statement)\n<             if disagreement:\n<                 reasons.append(disagreement)\n145,177d144\n< class StageTime(TypedDict):\n<     \"\"\"One stage's invocations summed (the statement's `time` block).\"\"\"\n<     attempts: int\n<     invocation_s: float\n<     partial: bool\n< \n< \n< class ItemTime(TypedDict):\n<     \"\"\"Every invocation's wall_clock_s, per stage and for the item, beside\n<     the item's lead time -- summed from the records by `attavo attest`, so\n<     a view renders it and never derives it.\"\"\"\n<     build: StageTime\n<     verify: StageTime\n<     counsel: StageTime\n<     invocation_s: float\n<     lead_s: float | None\n<     waiting_s: float | None\n<     partial: bool\n<     not_read: list[str]\n< \n< \n< class ItemCost(TypedDict):\n<     \"\"\"Every record's cost_usd summed: the item's total across stages and\n<     executors, with a subtotal per stage and per adapter. A record with no\n<     cost_usd is named in not_read and makes every sum it belongs to\n<     partial -- absent is never zero.\"\"\"\n<     usd: float\n<     by_stage_usd: dict[str, float]\n<     by_adapter_usd: dict[str, float]\n<     partial: bool\n<     not_read: list[str]\n< \n< \n197,198d163\n<     time: ItemTime\n<     cost: ItemCost\n3c3\n<   \"$id\": \"https://attavo.dev/attestation/v3\",\n---\n>   \"$id\": \"https://attavo.dev/attestation/v2\",\n10c10\n<     \"tokens_by_stage\", \"cost_by_stage_usd\", \"wall_clock_by_stage_s\", \"time\", \"cost\",\n---\n>     \"tokens_by_stage\", \"cost_by_stage_usd\", \"wall_clock_by_stage_s\",\n65c65\n<       \"description\": \"The final attempt's cost per stage, as its record carries it; the item's sums are in `cost`.\",\n---\n>       \"description\": \"Never summed across stages -- a stage's own executor may report no cost at all.\",\n82,110d81\n<     \"time\": {\n<       \"type\": \"object\",\n<       \"description\": \"Every invocation of the item, summed by attest from its stage records' wall_clock_s: per stage and for the item, every attempt and not the final one alone (wall_clock_by_stage_s is the final attempt). lead_s runs from the first approval record's `at` to the committer time of the commit the statement is computed at; waiting_s is lead_s minus invocation_s. A record with no wall_clock_s is named in not_read and its sums are partial, never smaller in silence.\",\n<       \"additionalProperties\": false,\n<       \"required\": [\"build\", \"verify\", \"counsel\", \"invocation_s\", \"lead_s\", \"waiting_s\", \"partial\", \"not_read\"],\n<       \"properties\": {\n<         \"build\": {\"$ref\": \"#/$defs/stage_time\"},\n<         \"verify\": {\"$ref\": \"#/$defs/stage_time\"},\n<         \"counsel\": {\"$ref\": \"#/$defs/stage_time\"},\n<         \"invocation_s\": {\"type\": \"number\", \"minimum\": 0},\n<         \"lead_s\": {\"type\": [\"number\", \"null\"]},\n<         \"waiting_s\": {\"type\": [\"number\", \"null\"]},\n<         \"partial\": {\"type\": \"boolean\"},\n<         \"not_read\": {\"type\": \"array\", \"items\": {\"type\": \"string\", \"minLength\": 1}}\n<       }\n<     },\n<     \"cost\": {\n<       \"type\": \"object\",\n<       \"description\": \"Every record's cost_usd summed by attest: the item's total across stages and executors (ruled 2026-09-19, superseding the 2026-09-09 ruling against a cross-executor sum), with a subtotal per stage and per adapter. Each figure is what the record carries. A record with no cost_usd is named in not_read and makes usd and the subtotals it belongs to partial: absent is never zero, and a partial total says so.\",\n<       \"additionalProperties\": false,\n<       \"required\": [\"usd\", \"by_stage_usd\", \"by_adapter_usd\", \"partial\", \"not_read\"],\n<       \"properties\": {\n<         \"usd\": {\"type\": \"number\", \"minimum\": 0},\n<         \"by_stage_usd\": {\"type\": \"object\", \"additionalProperties\": {\"type\": \"number\", \"minimum\": 0}},\n<         \"by_adapter_usd\": {\"type\": \"object\", \"additionalProperties\": {\"type\": \"number\", \"minimum\": 0}},\n<         \"partial\": {\"type\": \"boolean\"},\n<         \"not_read\": {\"type\": \"array\", \"items\": {\"type\": \"string\", \"minLength\": 1}}\n<       }\n<     },\n113,124d83\n<   },\n<   \"$defs\": {\n<     \"stage_time\": {\n<       \"type\": \"object\",\n<       \"additionalProperties\": false,\n<       \"required\": [\"attempts\", \"invocation_s\", \"partial\"],\n<       \"properties\": {\n<         \"attempts\": {\"type\": \"integer\", \"minimum\": 0},\n<         \"invocation_s\": {\"type\": \"number\", \"minimum\": 0},\n<         \"partial\": {\"type\": \"boolean\"}\n<       }\n<     }","stderr":"","interrupted":false,"isImage":false,"returnCodeInterpretation":"Files differ","noOutputExpected":false}}
{"type":"assistant","message":{"model":"claude-sonnet-5","id":"msg_011CfCz9wzyWTWVoiBmsdiG5","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01H9BoTcp5DH3fFom7Qmq4rJ","name":"Bash","input":{"command":"cd /Users/davidbean/Projects/attavo-worktree-194; cat attest/specs/194/stub/tests/test_attest_time.py; git log --oneline -3 -- attest/specs/194/stub; cat attest/rulings.md | tail -20; cat .attavo/bin/forge-attestation 2>/dev/null | head -40"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3676,"cache_read_input_tokens":58670,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3676},"output_tokens":4,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"926377d2-0ca9-4491-82d5-45a2a39ba877","uuid":"632dfb43-1265-4cfe-90e2-e464aac7d03d","timestamp":"2026-09-19T14:51:32.467Z","request_id":"req_011CfCz9wSEyEoP6ZHMSWtAp","wire_tool_inputs":{"toolu_01H9BoTcp5DH3fFom7Qmq4rJ":{"command":"cd /Users/davidbean/Projects/attavo-worktree-194; cat attest/specs/194/stub/tests/test_attest_time.py; git log --oneline -3 -- attest/specs/194/stub; cat attest/rulings.md | tail -20; cat .attavo/bin/forge-attestation 2>/dev/null | head -40"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01H9BoTcp5DH3fFom7Qmq4rJ","type":"tool_result","content":"\"\"\"The statement's `time` and `cost` blocks: every invocation of an item\nsummed by `attavo attest` from the records it already reads, and doctor's\nsixth proof holding the statement to those records.\n\nRegression, run red first on main at 1d2257b: the statement carried the\nfinal attempt per stage and nothing else, so a view derived its own\n\"product time\" -- 20 minutes for an item whose nineteen invocations ran\n115 -- and no record said otherwise.\n\nRun: python3 -m pytest tests -q\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport subprocess\nimport sys\nfrom pathlib import Path\nfrom typing import Any\n\nimport jsonschema\n\nfrom helpers import git\n\nROOT = Path(__file__).resolve().parent.parent\nATTAVO = ROOT / \"bin\" / \"attavo\"\nSCHEMA = json.loads((ROOT / \"schema\" / \"attestation.schema.json\").read_text())\n\n# (stage, attempt, wall_clock_s, cost_usd, adapter): three builds on one\n# executor, two verifies and one counsel on another that reports no cost.\nINVOCATIONS: list[tuple[str, int, float | None, float | None, str]] = [\n    (\"build\", 1, 100.5, 0.25, \"alpha\"),\n    (\"build\", 2, 200.0, 0.5, \"alpha\"),\n    (\"build\", 3, 50.25, 0.125, \"alpha\"),\n    (\"verify\", 1, 10.0, None, \"beta\"),\n    (\"verify\", 2, 30.0, None, \"beta\"),\n    (\"counsel\", 1, 7.5, None, \"beta\"),\n]\n\n\ndef run(root: Path, *args: str, stdin: str | None = None) -> subprocess.CompletedProcess[str]:\n    return subprocess.run([sys.executable, str(ATTAVO), *args], cwd=str(root), input=stdin,\n                          capture_output=True, text=True, check=False)\n\n\ndef write(path: Path, obj: dict[str, Any]) -> None:\n    path.parent.mkdir(parents=True, exist_ok=True)\n    path.write_text(json.dumps(obj))\n\n\ndef make_item(tmp_path: Path, invocations: list[tuple[str, int, float | None, float | None, str]]\n              ) -> tuple[Path, str]:\n    \"\"\"A tenant with one item merged on main's first-parent line: spec and\n    approval records, then every invocation in `invocations`, the chain\n    coherent on the latest of each stage. Returns (root, merge sha).\"\"\"\n    root = tmp_path / \"tenant\"\n    root.mkdir(parents=True)\n    git(root, \"init\", \"-q\", \"-b\", \"main\", \".\")\n    git(root, \"config\", \"user.email\", \"fixture@attavo.invalid\")\n    git(root, \"config\", \"user.name\", \"fixture\")\n    (root / \"attavo.toml\").write_text(\n        '[paths]\\nrecords = \"records\"\\nspecs = \"specs\"\\n\\n'\n        '[forge]\\nattestation_command = \"sh ./fake-store\"\\n')\n    (root / \"fake-store\").write_text(\n        '#!/bin/sh\\nread sha\\ntest -f \"statements/$sha.json\" && cat \"statements/$sha.json\"\\n')\n    git(root, \"add\", \"-A\")\n    git(root, \"commit\", \"-q\", \"-m\", \"install\")\n    git(root, \"checkout\", \"-q\", \"-b\", \"attavo/1-x\")\n    rec = root / \"records\" / \"1\"\n    write(rec / \"spec-01.json\", {\"status\": \"pass\", \"sha\": \"s1\", \"at\": \"2026-01-01T00:00:00Z\"})\n    write(rec / \"approval-01.json\", {\"sha\": \"a1\", \"spec_sha\": \"s1\", \"at\": \"2026-01-01T00:00:00Z\"})\n    for stage, n, wall, cost, adapter in invocations:\n        body: dict[str, Any] = {\"status\": \"pass\", \"sha\": f\"{stage}{n}\", \"adapter\": adapter,\n                                \"approval_sha\": \"a1\", \"cost_usd\": cost}\n        if wall is not None:\n            body[\"wall_clock_s\"] = wall\n        if stage == \"verify\":\n            last_build = max(i[1] for i in invocations if i[0] == \"build\")\n            body[\"build_sha\"] = f\"build{last_build}\"\n        write(rec / f\"{stage}-{n:02d}.json\", body)\n    git(root, \"add\", \"-A\")\n    git(root, \"commit\", \"-q\", \"-m\", \"records for item 1\")\n    git(root, \"checkout\", \"-q\", \"main\")\n    git(root, \"merge\", \"-q\", \"--no-ff\", \"-m\", \"Merge branch 'attavo/1-x'\", \"attavo/1-x\")\n    git(root, \"update-ref\", \"refs/remotes/origin/main\", \"main\")\n    git(root, \"symbolic-ref\", \"refs/remotes/origin/HEAD\", \"refs/remotes/origin/main\")\n    return root, git(root, \"rev-parse\", \"HEAD\").strip()\n\n\ndef attest(root: Path) -> dict[str, Any]:\n    done = run(root, \"attest\", \"1\")\n    assert done.returncode == 0, done.stdout + done.stderr\n    statement: dict[str, Any] = json.loads(done.stdout)\n    return statement\n\n\ndef proof_six(root: Path) -> dict[str, Any]:\n    out = json.loads(run(root, \"doctor\", \"--json\", str(root)).stdout)\n    found: dict[str, Any] = [p for p in out[\"proofs\"]\n                             if p[\"proof\"] == \"every-attested-item-is-sealed\"][0]\n    return found\n\n\ndef test_attest_sums_every_invocation_per_stage_and_per_item(tmp_path: Path) -> None:\n    root, _ = make_item(tmp_path, INVOCATIONS)\n    statement = attest(root)\n    jsonschema.validate(statement, SCHEMA)\n    time = statement[\"time\"]\n    assert time[\"build\"] == {\"attempts\": 3, \"invocation_s\": 350.75, \"partial\": False}\n    assert time[\"verify\"] == {\"attempts\": 2, \"invocation_s\": 40.0, \"partial\": False}\n    assert time[\"counsel\"] == {\"attempts\": 1, \"invocation_s\": 7.5, \"partial\": False}\n    assert time[\"invocation_s\"] == 398.25\n    assert time[\"partial\"] is False and time[\"not_read\"] == []\n    # the final attempt stays where it was, and is not the sum\n    assert statement[\"wall_clock_by_stage_s\"] == {\"build\": 50.25, \"verify\": 30.0}\n    # lead runs from approval-01's `at` to the merge's committer time\n    merged_at = int(git(root, \"show\", \"-s\", \"--format=%ct\", \"HEAD\").strip())\n    assert time[\"lead_s\"] == merged_at - 1767225600\n    assert time[\"waiting_s\"] == round(time[\"lead_s\"] - 398.25, 3)\n\n\ndef test_attest_names_a_record_without_wall_clock_and_never_sums_it_as_zero(tmp_path: Path) -> None:\n    invocations = [i if i[:2] != (\"build\", 2) else (\"build\", 2, None, 0.5, \"alpha\")\n                   for i in INVOCATIONS]\n    root, _ = make_item(tmp_path, invocations)\n    time = attest(root)[\"time\"]\n    assert time[\"not_read\"] == [\"build-02\"]\n    assert time[\"build\"][\"partial\"] is True and time[\"partial\"] is True\n    assert time[\"build\"][\"attempts\"] == 3\n    assert time[\"verify\"][\"partial\"] is False\n\n\ndef test_attest_sums_cost_across_executors_and_says_when_the_total_is_partial(tmp_path: Path) -> None:\n    root, _ = make_item(tmp_path, INVOCATIONS)\n    cost = attest(root)[\"cost\"]\n    assert cost[\"usd\"] == 0.875\n    assert cost[\"by_stage_usd\"] == {\"build\": 0.875}\n    assert cost[\"by_adapter_usd\"] == {\"alpha\": 0.875}\n    assert cost[\"partial\"] is True\n    assert cost[\"not_read\"] == [\"verify-01\", \"verify-02\", \"counsel-01\"]\n\n    priced = [i if i[3] is not None else (i[0], i[1], i[2], 0.0625, i[4]) for i in INVOCATIONS]\n    root2, _ = make_item(tmp_path / \"priced\", priced)\n    cost2 = attest(root2)[\"cost\"]\n    assert cost2[\"usd\"] == 0.875 + 3 * 0.0625\n    assert cost2[\"by_adapter_usd\"] == {\"alpha\": 0.875, \"beta\": 0.1875}\n    assert cost2[\"partial\"] is False and cost2[\"not_read\"] == []\n\n\ndef test_doctor_proof_six_fails_a_statement_whose_time_is_not_its_records(tmp_path: Path) -> None:\n    root, merge = make_item(tmp_path, INVOCATIONS)\n    statement = attest(root)\n    store = root / \"statements\"\n    store.mkdir()\n    envelope = {\"_type\": \"https://in-toto.io/Statement/v1\", \"predicate\": statement}\n    (store / f\"{merge}.json\").write_text(json.dumps(envelope))\n    held = proof_six(root)\n    assert held[\"holds\"] is True and held[\"sealed\"] == [\"1\"], held\n\n    statement[\"time\"][\"invocation_s\"] = 20.0\n    (store / f\"{merge}.json\").write_text(json.dumps(envelope))\n    failed = proof_six(root)\n    assert failed[\"holds\"] is False, failed\n    assert \"item 1\" in failed[\"reason\"] and \"time.invocation_s\" in failed[\"reason\"], failed\n\n    # a statement sealed before `time` existed carries none and is not checked\n    del statement[\"time\"]\n    (store / f\"{merge}.json\").write_text(json.dumps(envelope))\n    assert proof_six(root)[\"holds\"] is True\n9c8f98d spec for #194: the statement accounts for the item's time and cost\n# Rulings\n\nWritten by the merge of a proposed amendment only.\n#!/bin/sh\n# forge-attestation: [forge].attestation_command for attavo doctor's fifth\n# proof (issue #158).\n#\n# Reads a merge commit sha on stdin. actions/attest@v2, in\n# .github/workflows/attavo-coherence.yml, signs the merge's attestation\n# statement over a synthetic subject: the sha256 digest of the merge\n# sha's own text (deterministic and reproducible from the sha alone, since\n# the statement is sealed before the artifact -- the merge -- has landed\n# anywhere to be hashed itself). This script re-derives that same digest\n# and reads it back from the forge's attestation store, printing the\n# statement's predicate payload as JSON on exit 0. It prints nothing and\n# exits non-zero when the store holds no attestation for that digest, or\n# the sha is empty, or `gh` cannot resolve this checkout's repository.\n#\n# Usage: read sha | forge-attestation\n# Requires: `gh`, authenticated, run inside this repository's checkout.\nset -e\nread -r sha\ntest -n \"$sha\" || exit 2\ndigest=$(printf '%s' \"$sha\" | shasum -a 256 | cut -d ' ' -f 1)\nrepo=$(gh repo view --json nameWithOwner --jq .nameWithOwner 2>/dev/null) || exit 2\npayload=$(gh api \"repos/$repo/attestations/sha256:$digest\" --jq '.attestations[0].bundle.dsseEnvelope.payload' 2>/dev/null) || exit 1\ntest -n \"$payload\" && test \"$payload\" != null || exit 1\nprintf '%s' \"$payload\" | base64 -d","is_error":false}]},"parent_tool_use_id":null,"session_id":"926377d2-0ca9-4491-82d5-45a2a39ba877","uuid":"1bd0a35d-ca5e-4831-a92a-a0b5a018c585","timestamp":"2026-09-19T14:51:32.622Z","tool_use_result":{"stdout":"\"\"\"The statement's `time` and `cost` blocks: every invocation of an item\nsummed by `attavo attest` from the records it already reads, and doctor's\nsixth proof holding the statement to those records.\n\nRegression, run red first on main at 1d2257b: the statement carried the\nfinal attempt per stage and nothing else, so a view derived its own\n\"product time\" -- 20 minutes for an item whose nineteen invocations ran\n115 -- and no record said otherwise.\n\nRun: python3 -m pytest tests -q\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport subprocess\nimport sys\nfrom pathlib import Path\nfrom typing import Any\n\nimport jsonschema\n\nfrom helpers import git\n\nROOT = Path(__file__).resolve().parent.parent\nATTAVO = ROOT / \"bin\" / \"attavo\"\nSCHEMA = json.loads((ROOT / \"schema\" / \"attestation.schema.json\").read_text())\n\n# (stage, attempt, wall_clock_s, cost_usd, adapter): three builds on one\n# executor, two verifies and one counsel on another that reports no cost.\nINVOCATIONS: list[tuple[str, int, float | None, float | None, str]] = [\n    (\"build\", 1, 100.5, 0.25, \"alpha\"),\n    (\"build\", 2, 200.0, 0.5, \"alpha\"),\n    (\"build\", 3, 50.25, 0.125, \"alpha\"),\n    (\"verify\", 1, 10.0, None, \"beta\"),\n    (\"verify\", 2, 30.0, None, \"beta\"),\n    (\"counsel\", 1, 7.5, None, \"beta\"),\n]\n\n\ndef run(root: Path, *args: str, stdin: str | None = None) -> subprocess.CompletedProcess[str]:\n    return subprocess.run([sys.executable, str(ATTAVO), *args], cwd=str(root), input=stdin,\n                          capture_output=True, text=True, check=False)\n\n\ndef write(path: Path, obj: dict[str, Any]) -> None:\n    path.parent.mkdir(parents=True, exist_ok=True)\n    path.write_text(json.dumps(obj))\n\n\ndef make_item(tmp_path: Path, invocations: list[tuple[str, int, float | None, float | None, str]]\n              ) -> tuple[Path, str]:\n    \"\"\"A tenant with one item merged on main's first-parent line: spec and\n    approval records, then every invocation in `invocations`, the chain\n    coherent on the latest of each stage. Returns (root, merge sha).\"\"\"\n    root = tmp_path / \"tenant\"\n    root.mkdir(parents=True)\n    git(root, \"init\", \"-q\", \"-b\", \"main\", \".\")\n    git(root, \"config\", \"user.email\", \"fixture@attavo.invalid\")\n    git(root, \"config\", \"user.name\", \"fixture\")\n    (root / \"attavo.toml\").write_text(\n        '[paths]\\nrecords = \"records\"\\nspecs = \"specs\"\\n\\n'\n        '[forge]\\nattestation_command = \"sh ./fake-store\"\\n')\n    (root / \"fake-store\").write_text(\n        '#!/bin/sh\\nread sha\\ntest -f \"statements/$sha.json\" && cat \"statements/$sha.json\"\\n')\n    git(root, \"add\", \"-A\")\n    git(root, \"commit\", \"-q\", \"-m\", \"install\")\n    git(root, \"checkout\", \"-q\", \"-b\", \"attavo/1-x\")\n    rec = root / \"records\" / \"1\"\n    write(rec / \"spec-01.json\", {\"status\": \"pass\", \"sha\": \"s1\", \"at\": \"2026-01-01T00:00:00Z\"})\n    write(rec / \"approval-01.json\", {\"sha\": \"a1\", \"spec_sha\": \"s1\", \"at\": \"2026-01-01T00:00:00Z\"})\n    for stage, n, wall, cost, adapter in invocations:\n        body: dict[str, Any] = {\"status\": \"pass\", \"sha\": f\"{stage}{n}\", \"adapter\": adapter,\n                                \"approval_sha\": \"a1\", \"cost_usd\": cost}\n        if wall is not None:\n            body[\"wall_clock_s\"] = wall\n        if stage == \"verify\":\n            last_build = max(i[1] for i in invocations if i[0] == \"build\")\n            body[\"build_sha\"] = f\"build{last_build}\"\n        write(rec / f\"{stage}-{n:02d}.json\", body)\n    git(root, \"add\", \"-A\")\n    git(root, \"commit\", \"-q\", \"-m\", \"records for item 1\")\n    git(root, \"checkout\", \"-q\", \"main\")\n    git(root, \"merge\", \"-q\", \"--no-ff\", \"-m\", \"Merge branch 'attavo/1-x'\", \"attavo/1-x\")\n    git(root, \"update-ref\", \"refs/remotes/origin/main\", \"main\")\n    git(root, \"symbolic-ref\", \"refs/remotes/origin/HEAD\", \"refs/remotes/origin/main\")\n    return root, git(root, \"rev-parse\", \"HEAD\").strip()\n\n\ndef attest(root: Path) -> dict[str, Any]:\n    done = run(root, \"attest\", \"1\")\n    assert done.returncode == 0, done.stdout + done.stderr\n    statement: dict[str, Any] = json.loads(done.stdout)\n    return statement\n\n\ndef proof_six(root: Path) -> dict[str, Any]:\n    out = json.loads(run(root, \"doctor\", \"--json\", str(root)).stdout)\n    found: dict[str, Any] = [p for p in out[\"proofs\"]\n                             if p[\"proof\"] == \"every-attested-item-is-sealed\"][0]\n    return found\n\n\ndef test_attest_sums_every_invocation_per_stage_and_per_item(tmp_path: Path) -> None:\n    root, _ = make_item(tmp_path, INVOCATIONS)\n    statement = attest(root)\n    jsonschema.validate(statement, SCHEMA)\n    time = statement[\"time\"]\n    assert time[\"build\"] == {\"attempts\": 3, \"invocation_s\": 350.75, \"partial\": False}\n    assert time[\"verify\"] == {\"attempts\": 2, \"invocation_s\": 40.0, \"partial\": False}\n    assert time[\"counsel\"] == {\"attempts\": 1, \"invocation_s\": 7.5, \"partial\": False}\n    assert time[\"invocation_s\"] == 398.25\n    assert time[\"partial\"] is False and time[\"not_read\"] == []\n    # the final attempt stays where it was, and is not the sum\n    assert statement[\"wall_clock_by_stage_s\"] == {\"build\": 50.25, \"verify\": 30.0}\n    # lead runs from approval-01's `at` to the merge's committer time\n    merged_at = int(git(root, \"show\", \"-s\", \"--format=%ct\", \"HEAD\").strip())\n    assert time[\"lead_s\"] == merged_at - 1767225600\n    assert time[\"waiting_s\"] == round(time[\"lead_s\"] - 398.25, 3)\n\n\ndef test_attest_names_a_record_without_wall_clock_and_never_sums_it_as_zero(tmp_path: Path) -> None:\n    invocations = [i if i[:2] != (\"build\", 2) else (\"build\", 2, None, 0.5, \"alpha\")\n                   for i in INVOCATIONS]\n    root, _ = make_item(tmp_path, invocations)\n    time = attest(root)[\"time\"]\n    assert time[\"not_read\"] == [\"build-02\"]\n    assert time[\"build\"][\"partial\"] is True and time[\"partial\"] is True\n    assert time[\"build\"][\"attempts\"] == 3\n    assert time[\"verify\"][\"partial\"] is False\n\n\ndef test_attest_sums_cost_across_executors_and_says_when_the_total_is_partial(tmp_path: Path) -> None:\n    root, _ = make_item(tmp_path, INVOCATIONS)\n    cost = attest(root)[\"cost\"]\n    assert cost[\"usd\"] == 0.875\n    assert cost[\"by_stage_usd\"] == {\"build\": 0.875}\n    assert cost[\"by_adapter_usd\"] == {\"alpha\": 0.875}\n    assert cost[\"partial\"] is True\n    assert cost[\"not_read\"] == [\"verify-01\", \"verify-02\", \"counsel-01\"]\n\n    priced = [i if i[3] is not None else (i[0], i[1], i[2], 0.0625, i[4]) for i in INVOCATIONS]\n    root2, _ = make_item(tmp_path / \"priced\", priced)\n    cost2 = attest(root2)[\"cost\"]\n    assert cost2[\"usd\"] == 0.875 + 3 * 0.0625\n    assert cost2[\"by_adapter_usd\"] == {\"alpha\": 0.875, \"beta\": 0.1875}\n    assert cost2[\"partial\"] is False and cost2[\"not_read\"] == []\n\n\ndef test_doctor_proof_six_fails_a_statement_whose_time_is_not_its_records(tmp_path: Path) -> None:\n    root, merge = make_item(tmp_path, INVOCATIONS)\n    statement = attest(root)\n    store = root / \"statements\"\n    store.mkdir()\n    envelope = {\"_type\": \"https://in-toto.io/Statement/v1\", \"predicate\": statement}\n    (store / f\"{merge}.json\").write_text(json.dumps(envelope))\n    held = proof_six(root)\n    assert held[\"holds\"] is True and held[\"sealed\"] == [\"1\"], held\n\n    statement[\"time\"][\"invocation_s\"] = 20.0\n    (store / f\"{merge}.json\").write_text(json.dumps(envelope))\n    failed = proof_six(root)\n    assert failed[\"holds\"] is False, failed\n    assert \"item 1\" in failed[\"reason\"] and \"time.invocation_s\" in failed[\"reason\"], failed\n\n    # a statement sealed before `time` existed carries none and is not checked\n    del statement[\"time\"]\n    (store / f\"{merge}.json\").write_text(json.dumps(envelope))\n    assert proof_six(root)[\"holds\"] is True\n9c8f98d spec for #194: the statement accounts for the item's time and cost\n# Rulings\n\nWritten by the merge of a proposed amendment only.\n#!/bin/sh\n# forge-attestation: [forge].attestation_command for attavo doctor's fifth\n# proof (issue #158).\n#\n# Reads a merge commit sha on stdin. actions/attest@v2, in\n# .github/workflows/attavo-coherence.yml, signs the merge's attestation\n# statement over a synthetic subject: the sha256 digest of the merge\n# sha's own text (deterministic and reproducible from the sha alone, since\n# the statement is sealed before the artifact -- the merge -- has landed\n# anywhere to be hashed itself). This script re-derives that same digest\n# and reads it back from the forge's attestation store, printing the\n# statement's predicate payload as JSON on exit 0. It prints nothing and\n# exits non-zero when the store holds no attestation for that digest, or\n# the sha is empty, or `gh` cannot resolve this checkout's repository.\n#\n# Usage: read sha | forge-attestation\n# Requires: `gh`, authenticated, run inside this repository's checkout.\nset -e\nread -r sha\ntest -n \"$sha\" || exit 2\ndigest=$(printf '%s' \"$sha\" | shasum -a 256 | cut -d ' ' -f 1)\nrepo=$(gh repo view --json nameWithOwner --jq .nameWithOwner 2>/dev/null) || exit 2\npayload=$(gh api \"repos/$repo/attestations/sha256:$digest\" --jq '.attestations[0].bundle.dsseEnvelope.payload' 2>/dev/null) || exit 1\ntest -n \"$payload\" && test \"$payload\" != null || exit 1\nprintf '%s' \"$payload\" | base64 -d","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LpoTSV4n3uRD4kAnKxKf5T","type":"tool_result","content":"1\t\"\"\"The doctor's fifth proof: every attested item has its statement in the\n2\tstore (issue #158). This repository's own #106, #148, #153 were merged\n3\tdirect, with no merge_group run and so no statement, and the doctor said\n4\tdone anyway -- proof two held on the four stage records with the chain\n5\theld, never asking whether the merge was sealed.\n6\t\n7\tRun: python3 -m pytest tests -q\n8\t\"\"\"\n9\timport json\n10\timport subprocess\n11\tfrom pathlib import Path\n12\tfrom typing import Any, cast\n13\t\n14\tROOT = Path(__file__).resolve().parent.parent\n15\tATTAVO = ROOT / \"bin\" / \"attavo\"\n16\t\n17\tFAKE_ATTEST = (\n18\t    '#!/bin/sh\\nread sha\\ngrep -qx \"$sha\" sealed.txt && printf %s '\n19\t    '\"{\\\\\"_type\\\\\": \\\\\"https://in-toto.io/Statement/v1\\\\\"}\"\\n'\n20\t)\n21\t\n22\t\n23\tdef _git(root: Path, *args: str) -> str:\n24\t    return subprocess.run([\"git\", \"-C\", str(root), *args], capture_output=True, text=True,\n25\t                          check=True).stdout.strip()\n26\t\n27\t\n28\tdef _tenant_with_two_merged_items(tmp_path: Path) -> tuple[Path, str, str]:\n29\t    root = tmp_path / \"sealed\"\n30\t    root.mkdir()\n31\t    subprocess.run([\"git\", \"init\", \"-q\", \"-b\", \"main\", \".\"], cwd=root, check=True)\n32\t    _git(root, \"config\", \"user.email\", \"doctor@attavo.invalid\")\n33\t    _git(root, \"config\", \"user.name\", \"doctor fixture\")\n34\t    (root / \"attavo.toml\").write_text(\n35\t        '[paths]\\nrecords = \"records\"\\n\\n[forge]\\nattestation_command = \"sh ./fake-attest\"\\n')\n36\t    (root / \"fake-attest\").write_text(FAKE_ATTEST)\n37\t    (root / \"sealed.txt\").write_text(\"\")\n38\t    _git(root, \"add\", \".\")\n39\t    _git(root, \"commit\", \"-q\", \"-m\", \"install\")\n40\t    merges = []\n41\t    for item in (\"1\", \"2\"):\n42\t        _git(root, \"checkout\", \"-q\", \"-b\", f\"attavo/{item}-x\")\n43\t        (root / \"records\" / item).mkdir(parents=True)\n44\t        for stage in (\"spec\", \"approval\", \"build\", \"verify\"):\n45\t            (root / \"records\" / item / f\"{stage}-01.json\").write_text('{\"status\": \"pass\"}')\n46\t            _git(root, \"add\", \"records\")\n47\t            _git(root, \"commit\", \"-q\", \"-m\", f\"{stage} record for item {item}\")\n48\t        _git(root, \"checkout\", \"-q\", \"main\")\n49\t        _git(root, \"merge\", \"-q\", \"--no-ff\", \"-m\", f\"Merge branch 'attavo/{item}-x'\", f\"attavo/{item}-x\")\n50\t        merges.append(_git(root, \"rev-parse\", \"HEAD\"))\n51\t    _git(root, \"update-ref\", \"refs/remotes/origin/main\", _git(root, \"rev-parse\", \"main\"))\n52\t    _git(root, \"symbolic-ref\", \"refs/remotes/origin/HEAD\", \"refs/remotes/origin/main\")\n53\t    return root, merges[0], merges[1]\n54\t\n55\t\n56\tdef _tenant_with_one_merged_and_one_unmerged_item(tmp_path: Path) -> Path:\n57\t    root = tmp_path / \"unmerged\"\n58\t    root.mkdir()\n59\t    subprocess.run([\"git\", \"init\", \"-q\", \"-b\", \"main\", \".\"], cwd=root, check=True)\n60\t    _git(root, \"config\", \"user.email\", \"doctor@attavo.invalid\")\n61\t    _git(root, \"config\", \"user.name\", \"doctor fixture\")\n62\t    (root / \"attavo.toml\").write_text(\n63\t        '[paths]\\nrecords = \"records\"\\n\\n[forge]\\nattestation_command = \"sh ./fake-attest\"\\n')\n64\t    (root / \"fake-attest\").write_text(FAKE_ATTEST)\n65\t    (root / \"sealed.txt\").write_text(\"\")\n66\t    _git(root, \"add\", \".\")\n67\t    _git(root, \"commit\", \"-q\", \"-m\", \"install\")\n68\t    _git(root, \"checkout\", \"-q\", \"-b\", \"attavo/1-x\")\n69\t    (root / \"records\" / \"1\").mkdir(parents=True)\n70\t    for stage in (\"spec\", \"approval\", \"build\", \"verify\"):\n71\t        (root / \"records\" / \"1\" / f\"{stage}-01.json\").write_text('{\"status\": \"pass\"}')\n72\t        _git(root, \"add\", \"records\")\n73\t        _git(root, \"commit\", \"-q\", \"-m\", f\"{stage} record for item 1\")\n74\t    _git(root, \"checkout\", \"-q\", \"main\")\n75\t    _git(root, \"merge\", \"-q\", \"--no-ff\", \"-m\", \"Merge branch 'attavo/1-x'\", \"attavo/1-x\")\n76\t    m1 = _git(root, \"rev-parse\", \"HEAD\")\n77\t    (root / \"sealed.txt\").write_text(m1 + \"\\n\")\n78\t    _git(root, \"add\", \"sealed.txt\")\n79\t    _git(root, \"commit\", \"-q\", \"-m\", \"seal item 1\")\n80\t    _git(root, \"checkout\", \"-q\", \"-b\", \"attavo/2-x\")\n81\t    (root / \"records\" / \"2\").mkdir(parents=True)\n82\t    for stage in (\"spec\", \"approval\", \"build\", \"verify\"):\n83\t        (root / \"records\" / \"2\" / f\"{stage}-01.json\").write_text('{\"status\": \"pass\"}')\n84\t        _git(root, \"add\", \"records\")\n85\t        _git(root, \"commit\", \"-q\", \"-m\", f\"{stage} record for item 2\")\n86\t    _git(root, \"checkout\", \"-q\", \"--detach\")\n87\t    _git(root, \"merge\", \"-q\", \"--no-ff\", \"-m\", \"synthetic test merge of attavo/2-x into main\", \"main\")\n88\t    return root\n89\t\n90\t\n91\tdef _proof(root: Path) -> dict[str, Any]:\n92\t    run = subprocess.run([\"python3\", str(ATTAVO), \"doctor\", \"--json\", str(root)],\n93\t                         capture_output=True, text=True, check=False)\n94\t    proofs = json.loads(run.stdout)[\"proofs\"]\n95\t    return cast(dict[str, Any], [p for p in proofs if p[\"proof\"] == \"every-attested-item-is-sealed\"][0])\n96\t\n97\t\n98\tdef test_doctor_proof_six_fails_on_an_unsealed_merge(tmp_path: Path) -> None:\n99\t    root, m1, m2 = _tenant_with_two_merged_items(tmp_path)\n100\t    (root / \"sealed.txt\").write_text(m1 + \"\\n\")\n101\t    p = _proof(root)\n102\t    assert not p[\"holds\"]\n103\t    assert \"item 2\" in p[\"reason\"] and m2[:12] in p[\"reason\"]\n104\t    assert p[\"sealed\"] == [\"1\"] and p[\"unsealed\"] == [\"2\"]\n105\t\n106\t\n107\tdef test_doctor_proof_six_holds_when_every_merge_is_sealed(tmp_path: Path) -> None:\n108\t    root, m1, m2 = _tenant_with_two_merged_items(tmp_path)\n109\t    (root / \"sealed.txt\").write_text(m1 + \"\\n\" + m2 + \"\\n\")\n110\t    p = _proof(root)\n111\t    assert p[\"holds\"] and p[\"sealed\"] == [\"1\", \"2\"]\n112\t\n113\t\n114\tdef test_doctor_proof_six_names_a_merge_before_the_window_without_failing(tmp_path: Path) -> None:\n115\t    root, m1, m2 = _tenant_with_two_merged_items(tmp_path)\n116\t    (root / \"sealed.txt\").write_text(m2 + \"\\n\")\n117\t    (root / \"attavo.toml\").write_text(\n118\t        '[paths]\\nrecords = \"records\"\\n\\n[forge]\\nattestation_command = \"sh ./fake-attest\"\\n'\n119\t        f'sealed_since = \"{m1}\"\\n')\n120\t    p = _proof(root)\n121\t    assert p[\"holds\"] and p[\"before_window\"] == [\"1\"] and p[\"sealed\"] == [\"2\"]\n122\t\n123\t\n124\tdef test_doctor_proof_six_fails_without_an_attestation_command(tmp_path: Path) -> None:\n125\t    root = tmp_path / \"bare\"\n126\t    root.mkdir()\n127\t    subprocess.run([\"git\", \"init\", \"-q\", \"-b\", \"main\", \".\"], cwd=root, check=True)\n128\t    (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n')\n129\t    (root / \"records\").mkdir()\n130\t    p = _proof(root)\n131\t    assert not p[\"holds\"] and \"attestation_command\" in p[\"reason\"]\n132\t\n133\t\n134\tdef test_doctor_proof_six_says_not_read_when_the_store_cannot_be_read(tmp_path: Path) -> None:\n135\t    root = tmp_path / \"unreadable\"\n136\t    root.mkdir()\n137\t    subprocess.run([\"git\", \"init\", \"-q\", \"-b\", \"main\", \".\"], cwd=root, check=True)\n138\t    _git(root, \"config\", \"user.email\", \"doctor@attavo.invalid\")\n139\t    _git(root, \"config\", \"user.name\", \"doctor fixture\")\n140\t    (root / \"attavo.toml\").write_text(\n141\t        '[paths]\\nrecords = \"records\"\\n\\n[forge]\\nattestation_command = \"sh ./unreadable-store\"\\n')\n142\t    (root / \"unreadable-store\").write_text(\n143\t        '#!/bin/sh\\nread sha\\necho \"gh: not logged in\" >&2\\nexit 2\\n')\n144\t    _git(root, \"add\", \".\")\n145\t    _git(root, \"commit\", \"-q\", \"-m\", \"install\")\n146\t    _git(root, \"checkout\", \"-q\", \"-b\", \"attavo/1-x\")\n147\t    (root / \"records\" / \"1\").mkdir(parents=True)\n148\t    for stage in (\"spec\", \"approval\", \"build\", \"verify\"):\n149\t        (root / \"records\" / \"1\" / f\"{stage}-01.json\").write_text('{\"status\": \"pass\"}')\n150\t        _git(root, \"add\", \"records\")\n151\t        _git(root, \"commit\", \"-q\", \"-m\", f\"{stage} record for item 1\")\n152\t    _git(root, \"checkout\", \"-q\", \"main\")\n153\t    _git(root, \"merge\", \"-q\", \"--no-ff\", \"-m\", \"Merge branch 'attavo/1-x'\", \"attavo/1-x\")\n154\t    _git(root, \"update-ref\", \"refs/remotes/origin/main\", _git(root, \"rev-parse\", \"main\"))\n155\t    _git(root, \"symbolic-ref\", \"refs/remotes/origin/HEAD\", \"refs/remotes/origin/main\")\n156\t    p = _proof(root)\n157\t    assert not p[\"holds\"]\n158\t    assert \"not read\" in p[\"reason\"] and \"unreadable-store\" in p[\"reason\"] and \"exited 2\" in p[\"reason\"]\n159\t    assert p[\"not_read\"] == [\"1\"] and p[\"unsealed\"] == [] and p[\"sealed\"] == []\n160\t\n161\t\n162\tdef test_doctor_proof_six_names_an_unmerged_item(tmp_path: Path) -> None:\n163\t    root = _tenant_with_one_merged_and_one_unmerged_item(tmp_path)\n164\t    noref = _proof(root)\n165\t    assert not noref[\"holds\"] and \"refs/remotes/origin/HEAD\" in noref[\"reason\"]\n166\t    _git(root, \"update-ref\", \"refs/remotes/origin/main\", \"main\")\n167\t    _git(root, \"symbolic-ref\", \"refs/remotes/origin/HEAD\", \"refs/remotes/origin/main\")\n168\t    ref = _proof(root)\n169\t    assert ref[\"holds\"]\n170\t    assert ref[\"sealed\"] == [\"1\"] and ref[\"not_merged\"] == [\"2\"] and ref[\"unsealed\"] == []\n171\t"}]},"parent_tool_use_id":null,"session_id":"926377d2-0ca9-4491-82d5-45a2a39ba877","uuid":"ea98f3ef-fcb2-4ce3-b15a-092056426f4c","timestamp":"2026-09-19T14:51:18.614Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-194/tests/test_doctor_sealed.py","content":"\"\"\"The doctor's fifth proof: every attested item has its statement in the\nstore (issue #158). This repository's own #106, #148, #153 were merged\ndirect, with no merge_group run and so no statement, and the doctor said\ndone anyway -- proof two held on the four stage records with the chain\nheld, never asking whether the merge was sealed.\n\nRun: python3 -m pytest tests -q\n\"\"\"\nimport json\nimport subprocess\nfrom pathlib import Path\nfrom typing import Any, cast\n\nROOT = Path(__file__).resolve().parent.parent\nATTAVO = ROOT / \"bin\" / \"attavo\"\n\nFAKE_ATTEST = (\n    '#!/bin/sh\\nread sha\\ngrep -qx \"$sha\" sealed.txt && printf %s '\n    '\"{\\\\\"_type\\\\\": \\\\\"https://in-toto.io/Statement/v1\\\\\"}\"\\n'\n)\n\n\ndef _git(root: Path, *args: str) -> str:\n    return subprocess.run([\"git\", \"-C\", str(root), *args], capture_output=True, text=True,\n                          check=True).stdout.strip()\n\n\ndef _tenant_with_two_merged_items(tmp_path: Path) -> tuple[Path, str, str]:\n    root = tmp_path / \"sealed\"\n    root.mkdir()\n    subprocess.run([\"git\", \"init\", \"-q\", \"-b\", \"main\", \".\"], cwd=root, check=True)\n    _git(root, \"config\", \"user.email\", \"doctor@attavo.invalid\")\n    _git(root, \"config\", \"user.name\", \"doctor fixture\")\n    (root / \"attavo.toml\").write_text(\n        '[paths]\\nrecords = \"records\"\\n\\n[forge]\\nattestation_command = \"sh ./fake-attest\"\\n')\n    (root / \"fake-attest\").write_text(FAKE_ATTEST)\n    (root / \"sealed.txt\").write_text(\"\")\n    _git(root, \"add\", \".\")\n    _git(root, \"commit\", \"-q\", \"-m\", \"install\")\n    merges = []\n    for item in (\"1\", \"2\"):\n        _git(root, \"checkout\", \"-q\", \"-b\", f\"attavo/{item}-x\")\n        (root / \"records\" / item).mkdir(parents=True)\n        for stage in (\"spec\", \"approval\", \"build\", \"verify\"):\n            (root / \"records\" / item / f\"{stage}-01.json\").write_text('{\"status\": \"pass\"}')\n            _git(root, \"add\", \"records\")\n            _git(root, \"commit\", \"-q\", \"-m\", f\"{stage} record for item {item}\")\n        _git(root, \"checkout\", \"-q\", \"main\")\n        _git(root, \"merge\", \"-q\", \"--no-ff\", \"-m\", f\"Merge branch 'attavo/{item}-x'\", f\"attavo/{item}-x\")\n        merges.append(_git(root, \"rev-parse\", \"HEAD\"))\n    _git(root, \"update-ref\", \"refs/remotes/origin/main\", _git(root, \"rev-parse\", \"main\"))\n    _git(root, \"symbolic-ref\", \"refs/remotes/origin/HEAD\", \"refs/remotes/origin/main\")\n    return root, merges[0], merges[1]\n\n\ndef _tenant_with_one_merged_and_one_unmerged_item(tmp_path: Path) -> Path:\n    root = tmp_path / \"unmerged\"\n    root.mkdir()\n    subprocess.run([\"git\", \"init\", \"-q\", \"-b\", \"main\", \".\"], cwd=root, check=True)\n    _git(root, \"config\", \"user.email\", \"doctor@attavo.invalid\")\n    _git(root, \"config\", \"user.name\", \"doctor fixture\")\n    (root / \"attavo.toml\").write_text(\n        '[paths]\\nrecords = \"records\"\\n\\n[forge]\\nattestation_command = \"sh ./fake-attest\"\\n')\n    (root / \"fake-attest\").write_text(FAKE_ATTEST)\n    (root / \"sealed.txt\").write_text(\"\")\n    _git(root, \"add\", \".\")\n    _git(root, \"commit\", \"-q\", \"-m\", \"install\")\n    _git(root, \"checkout\", \"-q\", \"-b\", \"attavo/1-x\")\n    (root / \"records\" / \"1\").mkdir(parents=True)\n    for stage in (\"spec\", \"approval\", \"build\", \"verify\"):\n        (root / \"records\" / \"1\" / f\"{stage}-01.json\").write_text('{\"status\": \"pass\"}')\n        _git(root, \"add\", \"records\")\n        _git(root, \"commit\", \"-q\", \"-m\", f\"{stage} record for item 1\")\n    _git(root, \"checkout\", \"-q\", \"main\")\n    _git(root, \"merge\", \"-q\", \"--no-ff\", \"-m\", \"Merge branch 'attavo/1-x'\", \"attavo/1-x\")\n    m1 = _git(root, \"rev-parse\", \"HEAD\")\n    (root / \"sealed.txt\").write_text(m1 + \"\\n\")\n    _git(root, \"add\", \"sealed.txt\")\n    _git(root, \"commit\", \"-q\", \"-m\", \"seal item 1\")\n    _git(root, \"checkout\", \"-q\", \"-b\", \"attavo/2-x\")\n    (root / \"records\" / \"2\").mkdir(parents=True)\n    for stage in (\"spec\", \"approval\", \"build\", \"verify\"):\n        (root / \"records\" / \"2\" / f\"{stage}-01.json\").write_text('{\"status\": \"pass\"}')\n        _git(root, \"add\", \"records\")\n        _git(root, \"commit\", \"-q\", \"-m\", f\"{stage} record for item 2\")\n    _git(root, \"checkout\", \"-q\", \"--detach\")\n    _git(root, \"merge\", \"-q\", \"--no-ff\", \"-m\", \"synthetic test merge of attavo/2-x into main\", \"main\")\n    return root\n\n\ndef _proof(root: Path) -> dict[str, Any]:\n    run = subprocess.run([\"python3\", str(ATTAVO), \"doctor\", \"--json\", str(root)],\n                         capture_output=True, text=True, check=False)\n    proofs = json.loads(run.stdout)[\"proofs\"]\n    return cast(dict[str, Any], [p for p in proofs if p[\"proof\"] == \"every-attested-item-is-sealed\"][0])\n\n\ndef test_doctor_proof_six_fails_on_an_unsealed_merge(tmp_path: Path) -> None:\n    root, m1, m2 = _tenant_with_two_merged_items(tmp_path)\n    (root / \"sealed.txt\").write_text(m1 + \"\\n\")\n    p = _proof(root)\n    assert not p[\"holds\"]\n    assert \"item 2\" in p[\"reason\"] and m2[:12] in p[\"reason\"]\n    assert p[\"sealed\"] == [\"1\"] and p[\"unsealed\"] == [\"2\"]\n\n\ndef test_doctor_proof_six_holds_when_every_merge_is_sealed(tmp_path: Path) -> None:\n    root, m1, m2 = _tenant_with_two_merged_items(tmp_path)\n    (root / \"sealed.txt\").write_text(m1 + \"\\n\" + m2 + \"\\n\")\n    p = _proof(root)\n    assert p[\"holds\"] and p[\"sealed\"] == [\"1\", \"2\"]\n\n\ndef test_doctor_proof_six_names_a_merge_before_the_window_without_failing(tmp_path: Path) -> None:\n    root, m1, m2 = _tenant_with_two_merged_items(tmp_path)\n    (root / \"sealed.txt\").write_text(m2 + \"\\n\")\n    (root / \"attavo.toml\").write_text(\n        '[paths]\\nrecords = \"records\"\\n\\n[forge]\\nattestation_command = \"sh ./fake-attest\"\\n'\n        f'sealed_since = \"{m1}\"\\n')\n    p = _proof(root)\n    assert p[\"holds\"] and p[\"before_window\"] == [\"1\"] and p[\"sealed\"] == [\"2\"]\n\n\ndef test_doctor_proof_six_fails_without_an_attestation_command(tmp_path: Path) -> None:\n    root = tmp_path / \"bare\"\n    root.mkdir()\n    subprocess.run([\"git\", \"init\", \"-q\", \"-b\", \"main\", \".\"], cwd=root, check=True)\n    (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n')\n    (root / \"records\").mkdir()\n    p = _proof(root)\n    assert not p[\"holds\"] and \"attestation_command\" in p[\"reason\"]\n\n\ndef test_doctor_proof_six_says_not_read_when_the_store_cannot_be_read(tmp_path: Path) -> None:\n    root = tmp_path / \"unreadable\"\n    root.mkdir()\n    subprocess.run([\"git\", \"init\", \"-q\", \"-b\", \"main\", \".\"], cwd=root, check=True)\n    _git(root, \"config\", \"user.email\", \"doctor@attavo.invalid\")\n    _git(root, \"config\", \"user.name\", \"doctor fixture\")\n    (root / \"attavo.toml\").write_text(\n        '[paths]\\nrecords = \"records\"\\n\\n[forge]\\nattestation_command = \"sh ./unreadable-store\"\\n')\n    (root / \"unreadable-store\").write_text(\n        '#!/bin/sh\\nread sha\\necho \"gh: not logged in\" >&2\\nexit 2\\n')\n    _git(root, \"add\", \".\")\n    _git(root, \"commit\", \"-q\", \"-m\", \"install\")\n    _git(root, \"checkout\", \"-q\", \"-b\", \"attavo/1-x\")\n    (root / \"records\" / \"1\").mkdir(parents=True)\n    for stage in (\"spec\", \"approval\", \"build\", \"verify\"):\n        (root / \"records\" / \"1\" / f\"{stage}-01.json\").write_text('{\"status\": \"pass\"}')\n        _git(root, \"add\", \"records\")\n        _git(root, \"commit\", \"-q\", \"-m\", f\"{stage} record for item 1\")\n    _git(root, \"checkout\", \"-q\", \"main\")\n    _git(root, \"merge\", \"-q\", \"--no-ff\", \"-m\", \"Merge branch 'attavo/1-x'\", \"attavo/1-x\")\n    _git(root, \"update-ref\", \"refs/remotes/origin/main\", _git(root, \"rev-parse\", \"main\"))\n    _git(root, \"symbolic-ref\", \"refs/remotes/origin/HEAD\", \"refs/remotes/origin/main\")\n    p = _proof(root)\n    assert not p[\"holds\"]\n    assert \"not read\" in p[\"reason\"] and \"unreadable-store\" in p[\"reason\"] and \"exited 2\" in p[\"reason\"]\n    assert p[\"not_read\"] == [\"1\"] and p[\"unsealed\"] == [] and p[\"sealed\"] == []\n\n\ndef test_doctor_proof_six_names_an_unmerged_item(tmp_path: Path) -> None:\n    root = _tenant_with_one_merged_and_one_unmerged_item(tmp_path)\n    noref = _proof(root)\n    assert not noref[\"holds\"] and \"refs/remotes/origin/HEAD\" in noref[\"reason\"]\n    _git(root, \"update-ref\", \"refs/remotes/origin/main\", \"main\")\n    _git(root, \"symbolic-ref\", \"refs/remotes/origin/HEAD\", \"refs/remotes/origin/main\")\n    ref = _proof(root)\n    assert ref[\"holds\"]\n    assert ref[\"sealed\"] == [\"1\"] and ref[\"not_merged\"] == [\"2\"] and ref[\"unsealed\"] == []\n","numLines":171,"startLine":1,"totalLines":171}}}

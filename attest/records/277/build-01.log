th\": 1,\n      \"description\": \"The stem (e.g. \\\"build-01\\\" or \\\"spec-01\\\") of the non-pass record counsel read.\"\n    },\n    \"at\": {\"type\": \"string\", \"minLength\": 1},\n    \"adapter\": {\"type\": [\"string\", \"null\"]},\n    \"adapter_config\": {\n      \"type\": \"object\",\n      \"description\": \"Copied verbatim from [executor.<adapter>] merged with [executor.<adapter>.counsel].\"\n    },\n    \"adapter_version\": {\"type\": [\"string\", \"null\"]},\n    \"model\": {\"type\": [\"string\", \"null\"]},\n    \"model_version\": {\"type\": [\"string\", \"null\"]},\n    \"reports\": {\n      \"type\": \"array\",\n      \"description\": \"Field names adapters/<name>/conformance.json declares this adapter can supply with a real value (vendor independence, 2026-09-09 ruling) -- [] when no adapter was called or it declares no conformance.json.\",\n      \"items\": {\"type\": \"string\", \"minLength\": 1}\n    },\n    \"tokens\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\"input\", \"output\"],\n      \"properties\": {\n        \"input\": {\"type\": \"integer\", \"minimum\": 0},\n        \"output\": {\"type\": \"integer\", \"minimum\": 0}\n      }\n    },\n    \"cost_usd\": {\"type\": [\"number\", \"null\"]},\n    \"wall_clock_s\": {\"type\": \"number\", \"minimum\": 0},\n    \"status\": {\n      \"type\": \"string\",\n      \"enum\": [\"done\", \"failed\"],\n      \"description\": \"\\\"failed\\\" when the adapter exited non-zero or returned no usable structured answer; class, verdict, citations, and proposal are then null/empty.\"\n    },\n    \"class\": {\n      \"type\": [\"string\", \"null\"],\n      \"enum\": [\"non-question\", \"outlived-invocation\", \"no-cause\", \"forge-unconcluded\",\n               \"ceiling\", \"claims-boundary\", \"repeated-act\", \"unclassed\", null],\n      \"description\": \"The stop's class as counsel itself reads it -- independent of, and possibly disagreeing with, the stop.class the counseled record already carries.\"\n    },\n    \"verdict\": {\n      \"type\": [\"string\", \"null\"],\n      \"enum\": [\"answer\", \"patch\", \"person\", null],\n      \"description\": \"\\\"answer\\\": the stop is answerable inside the rules. \\\"patch\\\": the stop is a product defect. \\\"person\\\": the answer would touch the definition of done and no rule covers it.\"\n    },\n    \"citations\": {\n      \"type\": \"array\",\n      \"description\": \"instruction, mechanism, guard -- each a path and symbol or a ruling id.\",\n      \"items\": {\n        \"type\": \"object\",\n        \"additionalProperties\": false,\n        \"required\": [\"kind\", \"path\", \"symbol\", \"ruling_id\"],\n        \"properties\": {\n          \"kind\": {\"type\": \"string\", \"enum\": [\"instruction\", \"mechanism\", \"guard\"]},\n          \"path\": {\"type\": [\"string\", \"null\"]},\n          \"symbol\": {\"type\": [\"string\", \"null\"]},\n          \"ruling_id\": {\"type\": [\"string\", \"null\"]}\n        }\n      }\n    },\n    \"proposal\": {\n      \"type\": \"object\",\n      \"description\": \"The ruling text (verdict \\\"answer\\\"), the patch or the issue (verdict \\\"patch\\\"), or the one-line question or the issue (verdict \\\"person\\\") -- exactly one of the four populated, matching verdict. issue is the remedy filed as an item rather than shipped as a diff or asked as a bare question (issue #175).\",\n      \"additionalProperties\": false,\n      \"required\": [\"ruling_text\", \"patch\", \"question\", \"issue\"],\n      \"properties\": {\n        \"ruling_text\": {\"type\": [\"string\", \"null\"]},\n        \"patch\": {\n          \"type\": [\"object\", \"null\"],\n          \"additionalProperties\": false,\n          \"required\": [\"file\", \"symbol\", \"rejection_test\", \"diff\"],\n          \"properties\": {\n            \"file\": {\"type\": \"string\", \"minLength\": 1},\n            \"symbol\": {\"type\": \"string\", \"minLength\": 1},\n            \"rejection_test\": {\"type\": \"string\", \"minLength\": 1},\n            \"diff\": {\"type\": \"string\", \"minLength\": 1}\n          }\n        },\n        \"question\": {\"type\": [\"string\", \"null\"]},\n        \"issue\": {\n          \"type\": [\"object\", \"null\"],\n          \"description\": \"A title and a body in this repository's own issue format (a Severity/Provenance line, then Problem, Retires, Change, and Acceptance sections) -- the shape attavo file-stops already files a stop as.\",\n          \"additionalProperties\": false,\n          \"required\": [\"title\", \"body\"],\n          \"properties\": {\n            \"title\": {\"type\": \"string\", \"minLength\": 1},\n            \"body\": {\"type\": \"string\", \"minLength\": 1}\n          }\n        }\n      }\n    },\n    \"forge\": {\n      \"type\": \"object\",\n      \"description\": \"counsel's own read of the forge on the counseled record's sha (issue #175) -- independent of, and read fresh from, whatever the counseled record's own forge_checks (verify only) already carries.\",\n      \"additionalProperties\": false,\n      \"required\": [\"read\", \"reason\", \"checks\"],\n      \"properties\": {\n        \"read\": {\n          \"type\": \"boolean\",\n          \"description\": \"false only for missing manifest configuration or a counseled record with no sha -- never silently treated as a green forge.\"\n        },\n        \"reason\": {\n          \"type\": [\"string\", \"null\"],\n          \"description\": \"Set, naming the missing key, exactly when read is false; null when read is true.\"\n        },\n        \"checks\": {\n          \"type\": \"array\",\n          \"description\": \"One entry per check [forge].checks_command reported on the counseled sha -- [] both when read is false and when a real read found no checks at all.\",\n          \"items\": {\n            \"type\": \"object\",\n            \"additionalProperties\": false,\n            \"required\": [\"name\", \"conclusion\"],\n            \"properties\": {\n              \"name\": {\"type\": \"string\", \"minLength\": 1},\n              \"conclusion\": {\"type\": [\"string\", \"null\"]}\n            }\n          }\n        }\n      }\n    },\n    \"question\": {\n      \"type\": [\"string\", \"null\"],\n      \"description\": \"The operator's own text from `attavo counsel N --ask \\\"<text>\\\"` -- null for the ordinary stop path.\"\n    },\n    \"product_version\": {\"type\": \"string\", \"minLength\": 1},\n    \"product_pin\": {\"type\": [\"string\", \"null\"]}\n  }\n}\n","structuredPatch":[{"oldStart":8,"oldLines":7,"newStart":8,"newLines":8,"lines":["     \"record_version\", \"item\", \"sha\", \"record_stage\", \"record\", \"at\", \"adapter\",","     \"adapter_config\", \"adapter_version\", \"model\", \"model_version\", \"reports\",","     \"tokens\", \"cost_usd\", \"wall_clock_s\", \"status\", \"class\", \"verdict\",","-    \"citations\", \"proposal\", \"forge\", \"question\", \"product_version\", \"product_pin\"","+    \"citations\", \"proposal\", \"forge\", \"question\", \"product_version\", \"product_pin\",","+    \"answers\"","   ],","   \"properties\": {","     \"record_version\": {\"type\": \"integer\", \"minimum\": 1},"]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true}}

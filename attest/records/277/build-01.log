{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Toyca9Z2s67Jx4ipSsVvVh","type":"tool_result","content":"340\t\n341\tdef counsel_instruction() -> str:\n342\t    \"\"\"Issue #100 (extended by issue #175): a stop is read inside the\n343\t    product first, before a person. The record, its log, the diff, the\n344\t    forge's checks, the item's graph, the tenant manifest, and this\n345\t    product's own root are all handed by path -- named in the instruction\n346\t    instead of inlined, the same discipline verify_instruction already\n347\t    applies to the diff (issue #86), so this instruction's own size stays\n348\t    fixed whatever the record, log, diff, checks, or graph's size.\"\"\"\n349\t    parts = list(spec_sections())\n350\t\n351\t    rulings = read_text(\"ATTAVO_RULINGS\")\n352\t    if rulings.strip():\n353\t        parts.append(\"## Rulings\\n\\n\" + rulings.strip())\n354\t\n355\t    note = stub_note()\n356\t    if note:\n357\t        parts.append(note)\n358\t\n359\t    record_path = os.environ.get(\"ATTAVO_COUNSEL_RECORD\")\n360\t    record_text = read_text(\"ATTAVO_COUNSEL_RECORD\")\n361\t    if record_text.strip():\n362\t        parts.append(\n363\t            \"## The stage record\\n\\n\"\n364\t            f\"The record is at {describe_file(record_path, record_text, diff_like=False)}. \"\n365\t            \"Read it yourself with your own tools.\")\n366\t\n367\t    log_path = os.environ.get(\"ATTAVO_COUNSEL_LOG\")\n368\t    log_text = read_text(\"ATTAVO_COUNSEL_LOG\")\n369\t    if log_text.strip():"}]},"parent_tool_use_id":null,"session_id":"c4ee75ad-edac-4244-be61-f864406c706c","uuid":"b64ee39f-c6ac-453e-8dec-d6c8f9f5ba24","timestamp":"2026-10-01T19:50:33.709Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-277/adapters/claude-code/run","content":"\ndef counsel_instruction() -> str:\n    \"\"\"Issue #100 (extended by issue #175): a stop is read inside the\n    product first, before a person. The record, its log, the diff, the\n    forge's checks, the item's graph, the tenant manifest, and this\n    product's own root are all handed by path -- named in the instruction\n    instead of inlined, the same discipline verify_instruction already\n    applies to the diff (issue #86), so this instruction's own size stays\n    fixed whatever the record, log, diff, checks, or graph's size.\"\"\"\n    parts = list(spec_sections())\n\n    rulings = read_text(\"ATTAVO_RULINGS\")\n    if rulings.strip():\n        parts.append(\"## Rulings\\n\\n\" + rulings.strip())\n\n    note = stub_note()\n    if note:\n        parts.append(note)\n\n    record_path = os.environ.get(\"ATTAVO_COUNSEL_RECORD\")\n    record_text = read_text(\"ATTAVO_COUNSEL_RECORD\")\n    if record_text.strip():\n        parts.append(\n            \"## The stage record\\n\\n\"\n            f\"The record is at {describe_file(record_path, record_text, diff_like=False)}. \"\n            \"Read it yourself with your own tools.\")\n\n    log_path = os.environ.get(\"ATTAVO_COUNSEL_LOG\")\n    log_text = read_text(\"ATTAVO_COUNSEL_LOG\")\n    if log_text.strip():","numLines":30,"startLine":340,"totalLines":1213}}}
{"type":"assistant","message":{"model":"claude-sonnet-5","id":"msg_011Cfc6fqGnSCux8KchfMQjC","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_011V5BFLVK7bAaWGQaQLGH2f","name":"Edit","input":{"replace_all":false,"file_path":"/Users/davidbean/Projects/attavo-worktree-277/adapters/claude-code/run","old_string":"    note = stub_note()\n    if note:\n        parts.append(note)\n\n    record_path = os.environ.get(\"ATTAVO_COUNSEL_RECORD\")\n    record_text = read_text(\"ATTAVO_COUNSEL_RECORD\")\n    if record_text.strip():\n        parts.append(\n            \"## The stage record\\n\\n\"\n            f\"The record is at {describe_file(record_path, record_text, diff_like=False)}. \"\n            \"Read it yourself with your own tools.\")\n\n    log_path = os.environ.get(\"ATTAVO_COUNSEL_LOG\")","new_string":"    note = stub_note()\n    if note:\n        parts.append(note)\n\n    # Counsel's own earlier readings of this item come first: a follow-up\n    # question about a stop counsel has already read is answered from that\n    # reading. The class an earlier reading states is not re-derived.\n    prior_path = os.environ.get(\"ATTAVO_COUNSEL_PRIOR\")\n    prior_text = read_text(\"ATTAVO_COUNSEL_PRIOR\")\n    if prior_text.strip():\n        parts.append(\n            \"## Counsel's earlier readings of this item\\n\\n\"\n            f\"They are at {describe_file(prior_path, prior_text, diff_like=False)}: a JSON list, \"\n            \"oldest first, each with the record it read, its class, verdict, ruling text, \"\n            \"citations and any question it answered. Read them first. Do not re-derive a \"\n            \"class an earlier reading states; a question about a stop already read is \"\n            \"answered as a follow-up to that reading, citing it.\")\n\n    reads = [line for line in os.environ.get(\"ATTAVO_COUNSEL_READS\", \"\").splitlines() if line.strip()]\n    if reads:\n        parts.append(\n            \"## The tenant's corpus\\n\\n\"\n            \"The tenant names these as what counsel reads before it answers -- method rules, \"\n            \"briefs, rulings. Read them with your own tools before answering:\\n\\n\" +\n            \"\\n\".join(f\"- `{r}`\" for r in reads))\n\n    record_path = os.environ.get(\"ATTAVO_COUNSEL_RECORD\")\n    record_text = read_text(\"ATTAVO_COUNSEL_RECORD\")\n    if record_text.strip():\n        parts.append(\n            \"## The stage record\\n\\n\"\n            f\"The record is at {describe_file(record_path, record_text, diff_like=False)}. \"\n            \"Read it yourself with your own tools.\")\n\n    log_path = os.environ.get(\"ATTAVO_COUNSEL_LOG\")"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":790,"cache_read_input_tokens":90114,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":790},"output_tokens":16,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"c4ee75ad-edac-4244-be61-f864406c706c","uuid":"1f50c6f9-a74d-4a02-b046-d294db74b8fe","timestamp":"2026-10-01T19:50:41.166Z","request_id":"req_011Cfc6fq1uwRjkzwz6jH1Wq","wire_tool_inputs":{"toolu_011V5BFLVK7bAaWGQaQLGH2f":{"file_path":"/Users/davidbean/Projects/attavo-worktree-277/adapters/claude-code/run","old_string":"    note = stub_note()\n    if note:\n        parts.append(note)\n\n    record_path = os.environ.get(\"ATTAVO_COUNSEL_RECORD\")\n    record_text = read_text(\"ATTAVO_COUNSEL_RECORD\")\n    if record_text.strip():\n        parts.append(\n            \"## The stage record\\n\\n\"\n            f\"The record is at {describe_file(record_path, record_text, diff_like=False)}. \"\n            \"Read it yourself with your own tools.\")\n\n    log_path = os.environ.get(\"ATTAVO_COUNSEL_LOG\")","new_string":"    note = stub_note()\n    if note:\n        parts.append(note)\n\n    # Counsel's own earlier readings of this item come first: a follow-up\n    # question about a stop counsel has already read is answered from that\n    # reading. The class an earlier reading states is not re-derived.\n    prior_path = os.environ.get(\"ATTAVO_COUNSEL_PRIOR\")\n    prior_text = read_text(\"ATTAVO_COUNSEL_PRIOR\")\n    if prior_text.strip():\n        parts.append(\n            \"## Counsel's earlier readings of this item\\n\\n\"\n            f\"They are at {describe_file(prior_path, prior_text, diff_like=False)}: a JSON list, \"\n            \"oldest first, each with the record it read, its class, verdict, ruling text, \"\n            \"citations and any question it answered. Read them first. Do not re-derive a \"\n            \"class an earlier reading states; a question about a stop already read is \"\n            \"answered as a follow-up to that reading, citing it.\")\n\n    reads = [line for line in os.environ.get(\"ATTAVO_COUNSEL_READS\", \"\").splitlines() if line.strip()]\n    if reads:\n        parts.append(\n            \"## The tenant's corpus\\n\\n\"\n            \"The tenant names these as what counsel reads before it answers -- method rules, \"\n            \"briefs, rulings. Read them with your own tools before answering:\\n\\n\" +\n            \"\\n\".join(f\"- `{r}`\" for r in reads))\n\n    record_path = os.environ.get(\"ATTAVO_COUNSEL_RECORD\")\n    record_text = read_text(\"ATTAVO_COUNSEL_RECORD\")\n    if record_text.strip():\n        parts.append(\n            \"## The stage record\\n\\n\"\n            f\"The record is at {describe_file(record_path, record_text, diff_like=False)}. \"\n            \"Read it yourself with your own tools.\")\n\n    log_path = os.environ.get(\"ATTAVO_COUNSEL_LOG\")"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011V5BFLVK7bAaWGQaQLGH2f","type":"tool_result","content":"The file /Users/davidbean/Projects/attavo-worktree-277/adapters/claude-code/run has been updated successfully."}]},"parent_tool_use_id":null,"session_id":"c4ee75ad-edac-4244-be61-f864406c706c","uuid":"da26213c-fc05-4267-beca-eeaa2afb873e","timestamp":"2026-10-01T19:50:41.196Z","tool_use_result":{"filePath":"/Users/davidbean/Projects/attavo-worktree-277/adapters/claude-code/run","oldString":"    note = stub_note()\n    if note:\n        parts.append(note)\n\n    record_path = os.environ.get(\"ATTAVO_COUNSEL_RECORD\")\n    record_text = read_text(\"ATTAVO_COUNSEL_RECORD\")\n    if record_text.strip():\n        parts.append(\n            \"## The stage record\\n\\n\"\n            f\"The record is at {describe_file(record_path, record_text, diff_like=False)}. \"\n            \"Read it yourself with your own tools.\")\n\n    log_path = os.environ.get(\"ATTAVO_COUNSEL_LOG\")","newString":"    note = stub_note()\n    if note:\n        parts.append(note)\n\n    # Counsel's own earlier readings of this item come first: a follow-up\n    # question about a stop counsel has already read is answered from that\n    # reading. The class an earlier reading states is not re-derived.\n    prior_path = os.environ.get(\"ATTAVO_COUNSEL_PRIOR\")\n    prior_text = read_text(\"ATTAVO_COUNSEL_PRIOR\")\n    if prior_text.strip():\n        parts.append(\n            \"## Counsel's earlier readings of this item\\n\\n\"\n            f\"They are at {describe_file(prior_path, prior_text, diff_like=False)}: a JSON list, \"\n            \"oldest first, each with the record it read, its class, verdict, ruling text, \"\n            \"citations and any question it answered. Read them first. Do not re-derive a \"\n            \"class an earlier reading states; a question about a stop already read is \"\n            \"answered as a follow-up to that reading, citing it.\")\n\n    reads = [line for line in os.environ.get(\"ATTAVO_COUNSEL_READS\", \"\").splitlines() if line.strip()]\n    if reads:\n        parts.append(\n            \"## The tenant's corpus\\n\\n\"\n            \"The tenant names these as what counsel reads before it answers -- method rules, \"\n            \"briefs, rulings. Read them with your own tools before answering:\\n\\n\" +\n            \"\\n\".join(f\"- `{r}`\" for r in reads))\n\n    record_path = os.environ.get(\"ATTAVO_COUNSEL_RECORD\")\n    record_text = read_text(\"ATTAVO_COUNSEL_RECORD\")\n    if record_text.strip():\n        parts.append(\n            \"## The stage record\\n\\n\"\n            f\"The record is at {describe_file(record_path, record_text, diff_like=False)}. \"\n            \"Read it yourself with your own tools.\")\n\n    log_path = os.environ.get(\"ATTAVO_COUNSEL_LOG\")","originalFile":"#!/usr/bin/env python3\n\"\"\"adapters/claude-code/run -- see README.md (this directory) for the four\nconfiguration keys, and ../README.md for the shared adapter contract.\n\nA live `claude` invocation is not exercised by the test suite (judgment\nis measured, not tested); its argument construction is checked by\nATTAVO_ADAPTER_DRY_RUN=1, which prints the `claude` command line as a\nJSON array instead of running it, its response handling is checked by\nATTAVO_ADAPTER_RESPONSE_FILE, which reads a canned final report object\nfrom a file instead of invoking `claude`, and (issue #26) its\n`--output-format stream-json --verbose` mapping -- the event stream\nthis adapter maps to ATTAVO_EVENTS, and the terminal \"result\" line it\nreads the report object from -- is checked by ATTAVO_ADAPTER_STREAM_FILE,\nwhich feeds a recorded transcript instead.\n\nThe whole result is printed to stdout before this adapter's own final\nline, so build-NN.log carries it as the transcript -- a halt otherwise\ncannot be explained after the fact. is_error or an absent\nstructured_output exit 1 on either stage; a build status \"question\"\nwhose question is missing or under MIN_QUESTION_CHARS characters also\nexits 1 (build records the attempt as failed) rather than a halt\nsomeone must rule on.\n\nATTAVO_STAGE=verify branches to a different objective, schema, and\nreport shape (issue #46): the instruction states the verify objective\n(see verify_instruction) instead of the build one, --json-schema is\nVERIFY_SCHEMA instead of STATUS_SCHEMA, and the final line carries\nfindings and tests_named instead of status and question.\n\nIssue #78: the boundary is the tool's own sandbox, not a curated\nallowed_tools list judged per sub-command -- confirmed live (recorded on\nthe issue, 2026-09-10) against `claude 2.1.268`: `--settings` carrying\n`{\"sandbox\": {\"enabled\": true, \"allowUnsandboxedCommands\": false}}` under\n`-p` refuses a write outside the working directory (\"operation not\npermitted\") and, with `network.allowedDomains: []`, refuses an outbound\nconnection (\"deny network-outbound ...\"), both before `--allowedTools`\nis ever consulted. build's `--settings` therefore enables the sandbox and\nforbids the unsandboxed fallback; verify's additionally sets\n`filesystem.denyWrite` on the working directory itself (confirmed live:\n`denyWrite` takes a list of paths, not a bare boolean -- `true` alone did\nnot stop a write inside the directory). `--allowedTools` shrinks to the\ntool names each stage may use at all -- `Read,Edit,Write,Bash` for build,\n`Read,Bash` for verify -- since Edit and Write are not Bash and the\nsandbox does not govern them. `allowed_tools` is retired as a manifest\nkey: a config that still declares it is refused by name rather than\nsilently accepted.\n\nIssue #88 (class A: a report is not a question). `--json-schema`\nconstrains the tool's structured_output to \"done\"/\"question\", but\nnothing stops \"question\" from carrying a status report rather than an\nactual question -- confirmed against tenant zero's own corpus, five\nspecimens with no \"?\" anywhere in the text. A \"question\" whose text\nclears MIN_QUESTION_CHARS but contains no \"?\" is a report, not a\nquestion: this adapter re-invokes the executor once, appending\nREINSTRUCTION to the same instruction, before ever reporting a halt to\na person. A second report in a row still halts (someone must look), but\nits report line carries \"class\": \"non-question\" and both raw results\nreached stdout above it -- an extra field bin/attavo's own record schema\ndoes not know about and never has to: it reads \"status\"/\"question\" off\nthis line exactly as before, so a \"question\" halt still halts. Read via\nATTAVO_ADAPTER_RESPONSE_FILE, a JSON array is a queue -- one canned\nresult per invocation this adapter makes, its last element repeating\nonce exhausted -- while a single object still repeats for every call,\nunchanged.\n\nIssue #88 (class B: work that outlives the invocation). Confirmed live,\nthis machine, `claude 2.1.269`: with both \"Agent\" and \"Task\" allowed, a\nprompt asking for a subagent produced `subagent_stats.spawned: 1`, `\"Agent\"`\nalone in `--disallowedTools` (Task is not a distinct tool in this build)\nbrought it back to 0 -- the tool's own reply named \"Workflow\" as the\nother path to background work, so both are named here. `--allowedTools`\nis an allow-list a background spawn does not consult (tenant zero's\nspecimen: `--allowedTools` without \"Agent\" or \"Workflow\" in it at all did\nnot stop three of them), so this adapter also disallows them by name on\nboth stages and, after the run, refuses by name -- exit 1, not a\nhalt -- any response whose subagent_stats.spawned is not zero, with the\ncounts in the message. A tool that reports no subagent_stats at all\n(spawned absent or 0) is unaffected; this is a refusal on evidence, not a\nguess from the flag.\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport os\nimport subprocess\nimport sys\nfrom datetime import datetime, timezone\nfrom pathlib import Path\n\n# the helper beside adapters/, imported without leaving a __pycache__ there\nsys.dont_write_bytecode = True\nsys.path.insert(0, str(Path(__file__).resolve().parent.parent))\nfrom executor_env import executor_env  # noqa: E402\n\nSTATUS_SCHEMA = {\n    \"type\": \"object\",\n    \"additionalProperties\": False,\n    \"required\": [\"status\", \"question\"],\n    \"properties\": {\n        \"status\": {\"type\": \"string\", \"enum\": [\"done\", \"question\"]},\n        \"question\": {\"type\": [\"string\", \"null\"]},\n    },\n}\n\n# The verify objective (issue #46): a verifier reports findings, not a\n# commit. additionalProperties: False means the tool cannot hand back a\n# structured_output shaped like STATUS_SCHEMA's status/question by\n# accident -- an absent findings key is what cmd_verify treats as\n# failed, not a lenient default here.\nVERIFY_SCHEMA = {\n    \"type\": \"object\",\n    \"additionalProperties\": False,\n    \"required\": [\"findings\", \"tests_named\"],\n    \"properties\": {\n        \"findings\": {\n            \"type\": \"array\",\n            \"items\": {\n                \"type\": \"object\",\n                \"additionalProperties\": False,\n                \"required\": [\"title\", \"specimen\", \"retires\", \"rejection_test\", \"severity\"],\n                \"properties\": {\n                    \"title\": {\"type\": \"string\", \"minLength\": 1},\n                    \"specimen\": {\"type\": \"string\", \"minLength\": 1},\n                    \"retires\": {\"type\": \"string\", \"minLength\": 1},\n                    \"rejection_test\": {\"type\": \"string\", \"minLength\": 1},\n                    \"severity\": {\"type\": \"string\", \"minLength\": 1},\n                },\n            },\n        },\n        \"tests_named\": {\"type\": \"array\", \"items\": {\"type\": \"string\", \"minLength\": 1}},\n    },\n}\n\n# The counsel objective (issue #100): a stop is read inside the product\n# first, before a person. additionalProperties: False for the same reason\n# as VERIFY_SCHEMA's own -- the tool cannot hand back a differently-shaped\n# structured_output by accident.\nCOUNSEL_SCHEMA = {\n    \"type\": \"object\",\n    \"additionalProperties\": False,\n    \"required\": [\"class\", \"verdict\", \"citations\", \"proposal\"],\n    \"properties\": {\n        \"class\": {\"type\": \"string\"},\n        \"verdict\": {\"type\": \"string\", \"enum\": [\"answer\", \"patch\", \"person\"]},\n        \"citations\": {\n            \"type\": \"array\",\n            \"items\": {\n                \"type\": \"object\",\n                \"additionalProperties\": False,\n                \"required\": [\"kind\", \"path\", \"symbol\", \"ruling_id\"],\n                \"properties\": {\n                    \"kind\": {\"type\": \"string\", \"enum\": [\"instruction\", \"mechanism\", \"guard\"]},\n                    \"path\": {\"type\": [\"string\", \"null\"]},\n                    \"symbol\": {\"type\": [\"string\", \"null\"]},\n                    \"ruling_id\": {\"type\": [\"string\", \"null\"]},\n                },\n            },\n        },\n        \"proposal\": {\n            \"type\": \"object\",\n            \"additionalProperties\": False,\n            \"required\": [\"ruling_text\", \"patch\", \"question\", \"issue\"],\n            \"properties\": {\n                \"ruling_text\": {\"type\": [\"string\", \"null\"]},\n                \"patch\": {\n                    \"type\": [\"object\", \"null\"],\n                    \"additionalProperties\": False,\n                    \"required\": [\"file\", \"symbol\", \"rejection_test\", \"diff\"],\n                    \"properties\": {\n                        \"file\": {\"type\": \"string\", \"minLength\": 1},\n                        \"symbol\": {\"type\": \"string\", \"minLength\": 1},\n                        \"rejection_test\": {\"type\": \"string\", \"minLength\": 1},\n                        \"diff\": {\"type\": \"string\", \"minLength\": 1},\n                    },\n                },\n                \"question\": {\"type\": [\"string\", \"null\"]},\n                # issue #175: the fourth proposal shape, for a \"patch\" or\n                # \"person\" verdict whose remedy is better filed as an item\n                # than shipped as a diff or asked as a bare question.\n                \"issue\": {\n                    \"type\": [\"object\", \"null\"],\n                    \"additionalProperties\": False,\n                    \"required\": [\"title\", \"body\"],\n                    \"properties\": {\n                        \"title\": {\"type\": \"string\", \"minLength\": 1},\n                        \"body\": {\"type\": \"string\", \"minLength\": 1},\n                    },\n                },\n            },\n        },\n    },\n}\n\n\ndef read_text(path_env: str) -> str:\n    path = os.environ.get(path_env)\n    if not path:\n        return \"\"\n    p = Path(path)\n    return p.read_text() if p.is_file() else \"\"\n\n\ndef describe_file(path: str, text: str, diff_like: bool) -> str:\n    \"\"\"Path, byte count, line count, and (for a diff) files touched --\n    named in the instruction instead of inlining the file's own text, so\n    the instruction stays a small fixed size whatever the file's size\n    (issue #86: a 27,367-line deletion diff inlined whole exceeded a\n    judge's input ceiling -- codex's, on the specimen that surfaced it).\n    Files touched counts unified-diff file headers (`diff --git a/...\n    b/...`), the shape `git diff` produces.\"\"\"\n    size = Path(path).stat().st_size\n    lines = text.count(\"\\n\") + (1 if text and not text.endswith(\"\\n\") else 0)\n    if not diff_like:\n        return f\"`{path}` ({size} bytes, {lines} lines)\"\n    files = sum(1 for l in text.splitlines() if l.startswith(\"diff --git \"))\n    return f\"`{path}` ({size} bytes, {lines} lines, {files} files touched)\"\n\n\ndef spec_sections() -> list[str]:\n    \"\"\"The spec's Problem, Claims, and Criteria sections verbatim -- what\n    both build and verify need to see, in the shape the spec contract\n    (not this adapter) already gives them.\"\"\"\n    spec_dir = Path(os.environ[\"ATTAVO_SPEC_DIR\"])\n    lines = (spec_dir / \"spec.md\").read_text().splitlines()\n    idx = [i for i, l in enumerate(lines) if l.startswith(\"## \")]\n    headings = {lines[i].strip(): i for i in idx}\n    bounds = sorted(idx) + [len(lines)]\n\n    def section(heading: str) -> str:\n        start = headings[heading]\n        end = bounds[bounds.index(start) + 1] if start in bounds else len(lines)\n        return \"\\n\".join(lines[start:end]).strip()\n\n    return [section(\"## Problem\"), section(\"## Claims\"), section(\"## Criteria\")]\n\n\ndef stub_note() -> str | None:\n    \"\"\"None when ATTAVO_SPEC_DIR carries no stub/; else the sentence\n    naming what a stub is (issue #90, closed by #93). The stub is\n    evidence -- a criterion it satisfies trivially is weak -- but twice\n    the judge reported\n    a built tree as failing to match its stub as if the stub were the\n    intended change (tenant zero #664, #644): one sentence of vocabulary\n    was missing, not a smarter judge or a dropped stub.\"\"\"\n    stub_dir = Path(os.environ[\"ATTAVO_SPEC_DIR\"]) / \"stub\"\n    if not stub_dir.is_dir():\n        return None\n    return (\n        f\"## The stub at `{stub_dir}`\\n\\n\"\n        \"The stub is the fixture the acceptance criteria were shown to \"\n        \"pass against; it is not the intended change. A difference \"\n        \"between the built tree and the stub is not a finding: a \"\n        \"criterion the stub satisfies trivially is.\")\n\n\ndef build_instruction() -> str:\n    parts = list(spec_sections())\n\n    rulings = read_text(\"ATTAVO_RULINGS\")\n    if rulings.strip():\n        parts.append(\"## Rulings\\n\\n\" + rulings.strip())\n\n    feedback_path = os.environ.get(\"ATTAVO_FEEDBACK\")\n    feedback = read_text(\"ATTAVO_FEEDBACK\")\n    if feedback.strip():\n        parts.append(\n            \"## Feedback from the previous attempt\\n\\n\"\n            f\"The feedback is at {describe_file(feedback_path, feedback, diff_like=False)}. \"\n            \"It is not inlined here: read it yourself with your own tools \"\n            \"before continuing.\")\n\n    parts.append(\n        \"commit your work on the current branch; if you cannot proceed \"\n        \"without a decision that changes the criteria, do not guess: \"\n        \"answer with status question\")\n\n    test_command = os.environ.get(\"ATTAVO_TEST_COMMAND\")\n    if test_command:\n        bound = os.environ.get(\"ATTAVO_TEST_TIMEOUT_S\")\n        parts.append(\n            f\"to run tests while you work, run `{test_command}`: it runs the tests \"\n            \"selected for the files you have changed\"\n            + (f\" and stops at {bound} s\" if bound else \"\")\n            + \". Run a single test with `\" + test_command + \" <path or test id>`. \"\n            \"Do not run the test runner directly, the whole test suite, or any \"\n            \"whole-tree check yourself: when the criteria and \" + \"`\" + test_command + \"`\"\n            + \" pass, commit and stop; the gates are run for you and any failure is \"\n            \"returned to you on the next iteration\")\n\n    return \"\\n\\n\".join(parts)\n\n\ndef verify_instruction() -> str:\n    parts = list(spec_sections())\n\n    note = stub_note()\n    if note:\n        parts.append(note)\n\n    diff_path = os.environ.get(\"ATTAVO_DIFF\")\n    diff = read_text(\"ATTAVO_DIFF\")\n    if diff.strip():\n        parts.append(\n            \"## Diff since the approved spec\\n\\n\"\n            f\"The diff is at {describe_file(diff_path, diff, diff_like=True)}. \"\n            \"It is not inlined here: read it yourself with your own tools \"\n            \"before judging it.\")\n    else:\n        parts.append(\"## Diff since the approved spec\\n\\n(the diff is empty)\")\n\n    build_record_path = os.environ.get(\"ATTAVO_BUILD_RECORD\")\n    build_record = read_text(\"ATTAVO_BUILD_RECORD\")\n    if build_record.strip():\n        parts.append(\n            \"## The build record\\n\\n\"\n            f\"The build record is at {describe_file(build_record_path, build_record, diff_like=False)}. \"\n            \"Read it yourself with your own tools.\")\n\n    parts.append(\n        \"you are verifying a completed build, not building: make no edits, \"\n        \"write no files, commit nothing. Read the diff named above against \"\n        \"the criteria and name what the criteria do not assert but the diff \"\n        \"should still be judged on, and name the tests that would assert \"\n        \"it if they existed. A spec whose approval commit does not \"\n        \"describe the working tree the build produced is itself a \"\n        \"finding: the diff is judged against what was approved, and a \"\n        \"divergence between them is reportable rather than assumed \"\n        \"away. Report each as a finding: title, specimen (the file or \"\n        \"commit the finding is about), retires (what having this \"\n        \"finding on record replaces or closes -- every finding must \"\n        \"carry one, or it is refused unfiled), rejection_test (the test \"\n        \"that would catch a regression of it), and severity. Severity \"\n        \"is derived rather than judged: the version, counter, \"\n        \"condition, or state change that flips a finding from harmless \"\n        \"to blocking; an adjective is not a severity. An empty \"\n        \"findings list means you looked and found nothing to report, not \"\n        \"that you did not look.\")\n    return \"\\n\\n\".join(parts)\n\n\ndef counsel_instruction() -> str:\n    \"\"\"Issue #100 (extended by issue #175): a stop is read inside the\n    product first, before a person. The record, its log, the diff, the\n    forge's checks, the item's graph, the tenant manifest, and this\n    product's own root are all handed by path -- named in the instruction\n    instead of inlined, the same discipline verify_instruction already\n    applies to the diff (issue #86), so this instruction's own size stays\n    fixed whatever the record, log, diff, checks, or graph's size.\"\"\"\n    parts = list(spec_sections())\n\n    rulings = read_text(\"ATTAVO_RULINGS\")\n    if rulings.strip():\n        parts.append(\"## Rulings\\n\\n\" + rulings.strip())\n\n    note = stub_note()\n    if note:\n        parts.append(note)\n\n    record_path = os.environ.get(\"ATTAVO_COUNSEL_RECORD\")\n    record_text = read_text(\"ATTAVO_COUNSEL_RECORD\")\n    if record_text.strip():\n        parts.append(\n            \"## The stage record\\n\\n\"\n            f\"The record is at {describe_file(record_path, record_text, diff_like=False)}. \"\n            \"Read it yourself with your own tools.\")\n\n    log_path = os.environ.get(\"ATTAVO_COUNSEL_LOG\")\n    log_text = read_text(\"ATTAVO_COUNSEL_LOG\")\n    if log_text.strip():\n        parts.append(\n            \"## The record's log\\n\\n\"\n            f\"The log is at {describe_file(log_path, log_text, diff_like=False)}. \"\n            \"Read it yourself with your own tools.\")\n\n    diff_path = os.environ.get(\"ATTAVO_COUNSEL_DIFF\")\n    diff_text = read_text(\"ATTAVO_COUNSEL_DIFF\")\n    if diff_text.strip():\n        parts.append(\n            \"## The item's diff since approval\\n\\n\"\n            f\"The diff is at {describe_file(diff_path, diff_text, diff_like=True)}. \"\n            \"Read it yourself with your own tools.\")\n\n    # issue #175: the forge in the evidence set. ATTAVO_COUNSEL_CHECKS is\n    # always written, a JSON {read, reason, checks} envelope -- read false\n    # names the missing manifest key rather than leaving the section out,\n    # since an unread forge must never be mistaken for a green one.\n    checks_path = os.environ.get(\"ATTAVO_COUNSEL_CHECKS\")\n    checks_text = read_text(\"ATTAVO_COUNSEL_CHECKS\")\n    if checks_text.strip():\n        parts.append(\n            \"## The forge's checks on this stop's sha\\n\\n\"\n            f\"The checks are at {describe_file(checks_path, checks_text, diff_like=False)}: \"\n            \"a JSON object -- read: false means the forge was not read at \"\n            \"all (reason names the missing manifest key; treat this as \"\n            \"unknown, never as green) -- read: true carries one entry per \"\n            \"check, each naming, for a check that did not succeed, the \"\n            \"path of its own failed-step log. Read the failing check's \"\n            \"log before answering about the forge; a remedy that depends \"\n            \"on the forge's state cites the check and its log line.\")\n\n    # issue #175: the graph in the evidence set -- the default branch's\n    # own log since this item's branch point, this branch's own commits,\n    # the markers and records present at the stop's sha, and the check\n    # runs on the last three shas, so \"the checks are on the record\n    # commit, not the code commit\" is readable without a terminal.\n    graph_path = os.environ.get(\"ATTAVO_COUNSEL_GRAPH\")\n    graph_text = read_text(\"ATTAVO_COUNSEL_GRAPH\")\n    if graph_text.strip():\n        parts.append(\n            \"## The item's graph\\n\\n\"\n            f\"The graph is at {describe_file(graph_path, graph_text, diff_like=False)}. \"\n            \"Read it yourself with your own tools.\")\n\n    manifest_path = os.environ.get(\"ATTAVO_MANIFEST\", \"\")\n    parts.append(f\"## The tenant manifest\\n\\nThe manifest is at `{manifest_path}`. \"\n                 \"Read it yourself with your own tools.\")\n\n    product_root = os.environ.get(\"ATTAVO_PRODUCT_ROOT\", \"\")\n    parts.append(\n        \"## The product's own root\\n\\n\"\n        f\"The product that ran this stage is at `{product_root}` \"\n        \"(`bin/attavo`, `adapters/`, `schema/`, `templates/`). A stop \"\n        \"whose cause is the product's own mechanism, not the tenant's, \"\n        \"is read here.\")\n\n    # issue #175: attavo counsel N --ask hands the operator's own text as\n    # the question to answer, over the same evidence set, rather than\n    # diagnosing a stop -- the record above is context, not necessarily a\n    # failure.\n    question = os.environ.get(\"ATTAVO_COUNSEL_QUESTION\", \"\")\n    if question.strip():\n        parts.append(\n            \"## The operator's question\\n\\n\" + question.strip() +\n            \"\\n\\nAnswer this question using the evidence above; the \"\n            \"record named above is context, not necessarily a failure.\")\n\n    parts.append(\n        \"you are counseling a stop, read-only: make no edits, write no \"\n        \"files, commit nothing. Read the record, its log, the spec, the \"\n        \"rulings, the diff, the forge's checks, the item's graph, the \"\n        \"tenant manifest, and the product's own root named above with \"\n        \"your own tools, then answer with exactly one class (the stop's \"\n        \"class, or \\\"unclassed\\\"), one verdict -- \\\"answer\\\" (the stop is \"\n        \"answerable inside the rules: a ruling text, in \"\n        \"proposal.ruling_text, with three citations -- instruction, \"\n        \"mechanism, guard, each a path and symbol or a ruling id), \"\n        \"\\\"patch\\\" (the stop is a product defect: the mechanism's file \"\n        \"and symbol, a rejection test, and a unified diff, in \"\n        \"proposal.patch -- or, when the remedy is better filed as an \"\n        \"item than shipped as a diff, a title and a body in this \"\n        \"repository's own issue format -- a Severity/Provenance line, \"\n        \"then Problem, Retires, Change, and Acceptance sections -- in \"\n        \"proposal.issue), or \\\"person\\\" (the answer would touch the \"\n        \"definition of done and no rule covers it: the question restated \"\n        \"in one line, in proposal.question -- or, when the remedy is \"\n        \"better filed as an item than asked as a bare question, a title \"\n        \"and a body in the same issue format, in proposal.issue) -- and \"\n        \"citations for whichever verdict you gave. You propose; you do \"\n        \"not act.\")\n    return \"\\n\\n\".join(parts)\n\n\nBUILD_ALLOWED_TOOLS = [\"Read\", \"Edit\", \"Write\", \"Bash\"]\n\n# Item 229's third attempt: 2,754 s and $6.54 to write the right change and\n# be refused at the gate for one path the spec's Claims did not name. The\n# gate stays the law, but the boundary is told at the edit: the build's\n# Edit and Write are allowed on the claimed paths only, as permission\n# rules built from the spec's own Claims list, so an edit outside them is\n# refused by the tool at the moment it is tried and the executor's recourse\n# is the one it has for anything outside the spec -- a question.\nBUILD_FIXED_TOOLS = [\"Read\", \"Bash\"]\n\n\ndef claimed_paths() -> list[str]:\n    \"\"\"The spec's Claims, one path or glob per line under '## Claims', as\n    the spec contract writes them (attavo/spec.py's parse_spec reads the\n    same lines).\"\"\"\n    spec_dir = os.environ.get(\"ATTAVO_SPEC_DIR\")\n    if not spec_dir:\n        return []\n    try:\n        lines = (Path(spec_dir) / \"spec.md\").read_text().splitlines()\n    except OSError:\n        return []\n    claims: list[str] = []\n    inside = False\n    for line in lines:\n        if line.startswith(\"## \"):\n            inside = line.strip() == \"## Claims\"\n            continue\n        if inside and line.strip().startswith(\"- \"):\n            claims.append(line.strip()[2:].strip())\n    return claims\n\n\ndef claim_rule(claim: str) -> str:\n    \"\"\"A claim as a permission-rule path: a directory claim (trailing\n    slash) covers everything under it.\"\"\"\n    return claim + \"**\" if claim.endswith(\"/\") else claim\n\n\ndef build_allowed_tools() -> list[str]:\n    claims = claimed_paths()\n    if not claims:\n        return BUILD_ALLOWED_TOOLS\n    rules = [f\"{tool}({claim_rule(c)})\" for c in claims for tool in (\"Edit\", \"Write\")]\n    return BUILD_FIXED_TOOLS + rules\nVERIFY_ALLOWED_TOOLS = [\"Read\", \"Bash\"]\n\n# Issue #88 (class B): both tools the tool's own reply named as a way to\n# spawn work that outlives this invocation -- confirmed live against\n# `claude 2.1.269` (see module docstring). Named on both stages: verify's\n# own allowed tools never included either, and did not stop the\n# specimen either.\nSUBAGENT_TOOLS = [\"Agent\", \"Workflow\"]\n\n# Items 227 and 229: the executor started `attavo test` in the background,\n# loaded Monitor to tail its output file, scheduled wakeups to wait for it,\n# and on 227 answered done while the wait was still open. Both let the\n# invocation outlive its own answer, the same reason the subagent tools\n# are denied.\nOUTLIVING_TOOLS = [\"Monitor\", \"ScheduleWakeup\"]\n\n# The raw test runner and the product's transport are not the executor's\n# tools: `attavo test` is the one test command (issue #212) and the pass\n# is the one transport. Permission-rule patterns, prefix-matched by the\n# tool; the product refuses its transport on its own account too\n# (ATTAVO_STAGE), so the second half here is belt beside braces.\nDENIED_COMMANDS = [\"Bash(pytest:*)\", \"Bash(python3 -m pytest:*)\", \"Bash(python -m pytest:*)\",\n                   \"Bash(npm test:*)\", \"Bash(npx vitest:*)\", \"Bash(go test:*)\", \"Bash(cargo test:*)\",\n                   \"Bash(attavo drive:*)\", \"Bash(attavo worker:*)\"]\n\n\ndef load_config() -> dict:\n    raw = os.environ.get(\"ATTAVO_ADAPTER_CONFIG\")\n    return json.loads(raw) if raw else {}\n\n\ndef refused_config_key(config: dict) -> str | None:\n    \"\"\"None if config carries no retired key; else the refusal message.\n    allowed_tools (issue #78) is retired, not ignored: the sandbox is the\n    boundary now, a curated Bash(...) prefix list is not, and a manifest\n    still naming it must be refused rather than silently accepted.\"\"\"\n    if \"allowed_tools\" in config:\n        return (\"[executor.claude-code].allowed_tools is retired (issue \"\n                \"#78) -- the sandbox is the boundary now, not a curated \"\n                \"Bash(...) prefix list\")\n    return None\n\n\n# Issue #93: claude code publishes no numeric input-size ceiling\n# anywhere in its own surface (--help, docs, or any config file,\n# confirmed against claude 2.1.269) -- unlike codex's documented\n# input_too_large. This adapter asserts its own instruction stays under\n# a fixed bound instead of a tool-documented one, so an undeclared tool\n# still cannot be handed an unbounded prompt.\nFIXED_BOUND_CHARS = 65_536\n\n\ndef input_limit_chars() -> int:\n    \"\"\"The bound this adapter enforces in place of a declared ceiling.\n    Overridable only for tests via ATTAVO_ADAPTER_INPUT_LIMIT_CHARS --\n    never a tenant knob: the ceiling is a fact about the tool, not\n    something [executor.claude-code] can set.\"\"\"\n    override = os.environ.get(\"ATTAVO_ADAPTER_INPUT_LIMIT_CHARS\")\n    return int(override) if override else FIXED_BOUND_CHARS\n\n\ndef ceiling_refusal(instruction: str) -> str | None:\n    \"\"\"None if instruction stays at or under the fixed bound; else the\n    refusal naming both numbers, checked before claude is ever invoked.\"\"\"\n    limit = input_limit_chars()\n    size = len(instruction)\n    if size <= limit:\n        return None\n    return (f\"ceiling exceeded -- instruction is {size} chars, over \"\n           f\"the fixed bound of {limit} chars (claude code declares no \"\n           f\"input limit of its own)\")\n\n\nREAD_ONLY_STAGES = (\"verify\", \"counsel\")\n\n\ndef sandbox_settings(stage: str, working_directory: Path) -> dict:\n    \"\"\"Every Bash command and its children stay confined to\n    working_directory (writes) and the network stays closed for every\n    stage (issue #78) -- confirmed live, not assumed. verify and counsel\n    (issue #100) additionally deny writes to working_directory itself,\n    making \"make no edits, write no files\" mechanical rather than merely\n    instructed -- counsel is a read-only invocation, the same sandbox\n    verify runs under.\n    \"\"\"\n    sandbox = {\n        \"enabled\": True,\n        \"allowUnsandboxedCommands\": False,\n        \"network\": {\"allowedDomains\": []},\n    }\n    if stage in READ_ONLY_STAGES:\n        sandbox[\"filesystem\"] = {\"denyWrite\": [str(working_directory)]}\n    return {\"sandbox\": sandbox}\n\n\n# Items 227 and 229: Claude Code's Bash foreground is two minutes while one\n# test call is [tests].call_timeout_s (240), so the executor wrapped runs in\n# `timeout N` and backgrounded them. The product exports that bound as\n# ATTAVO_TEST_TIMEOUT_S; the foreground is set to fit one run plus a margin.\nFOREGROUND_MARGIN_S = 60\n\n\ndef foreground_env() -> dict[str, str]:\n    \"\"\"The variables this adapter sets itself for its executor: the Bash\n    foreground and its ceiling, from ATTAVO_TEST_TIMEOUT_S. None when no\n    bound was exported.\"\"\"\n    bound = os.environ.get(\"ATTAVO_TEST_TIMEOUT_S\")\n    if not bound:\n        return {}\n    try:\n        millis = str((int(bound) + FOREGROUND_MARGIN_S) * 1000)\n    except ValueError:\n        return {}\n    return {\"BASH_DEFAULT_TIMEOUT_MS\": millis, \"BASH_MAX_TIMEOUT_MS\": millis}\n\n\ndef build_command(instruction: str, config: dict, schema: dict, stage: str) -> list[str]:\n    auth = config.get(\"auth\", \"api\")\n    allowed_tools = VERIFY_ALLOWED_TOOLS if stage in READ_ONLY_STAGES else build_allowed_tools()\n    # acceptEdits approves every edit before an allow rule is consulted;\n    # with claimed-path rules in force the mode is default, so a claimed\n    # edit is approved by its rule and an unclaimed one asks -- and a\n    # headless -p run answers no. The tenant may still set the mode.\n    claimed_rules = stage not in READ_ONLY_STAGES and allowed_tools is not BUILD_ALLOWED_TOOLS\n    permission_mode = config.get(\"permission_mode\", \"default\" if claimed_rules else \"acceptEdits\")\n\n    cmd = [\"claude\"]\n    if auth == \"subscription\":\n        # no --bare: this is the tenant's own login, not a bare API key, so\n        # the tenant's project hooks and MCP servers must not load -- only\n        # --setting-sources (CLAUDE.md still loads) and --strict-mcp-config\n        # keep them out, the same isolation --bare gives in api mode.\n        setting_sources = config.get(\"setting_sources\", \"user\")\n        cmd += [\"--setting-sources\", setting_sources, \"--strict-mcp-config\"]\n    else:\n        cmd += [\"--bare\"]\n    cmd += [\"--settings\", json.dumps(sandbox_settings(stage, Path.cwd()))]\n    cmd += [\"-p\", instruction,\n           \"--output-format\", \"stream-json\", \"--verbose\",\n           \"--json-schema\", json.dumps(schema),\n           \"--permission-mode\", permission_mode,\n           \"--allowedTools\", \",\".join(allowed_tools),\n           \"--disallowedTools\", \",\".join(SUBAGENT_TOOLS + OUTLIVING_TOOLS + DENIED_COMMANDS)]\n    model = config.get(\"model\")\n    if model:\n        cmd += [\"--model\", model]\n    return cmd\n\n\ndef derive_model(response: dict, requested_model: str | None) -> tuple[str | None, str | None]:\n    \"\"\"(model, model_version). --output-format json carries no top-level\n    \"model\" field; modelUsage is the per-model cost/usage breakdown, keyed\n    by a dated id (e.g. \"claude-haiku-4-5-20251001\") whose own\n    \"canonicalModel\" entry is the short name (e.g. \"claude-haiku-4-5\").\n\n    When a model was requested (issue #77), it is trusted verbatim as\n    model rather than picked out of modelUsage: a lightweight helper\n    model's few thousand uncached tokens must not outrank a primary\n    model whose real weight is almost entirely cached reads, which a\n    token-count comparison cannot tell apart from a model that barely\n    ran. model_version is the modelUsage key whose canonicalModel matches\n    the requested model -- the dated id the tool actually ran -- or None\n    when no key matches.\n\n    When no model was requested, the modelUsage key with the largest\n    total of inputTokens + cacheReadInputTokens + cacheCreationInputTokens\n    + outputTokens is the model that did the work; cache tokens count\n    here for the same reason they must not be left out of a requested\n    model's tokens.input (below).\n    \"\"\"\n    model_usage = response.get(\"modelUsage\") or {}\n\n    if requested_model:\n        model_version = next(\n            (key for key, entry in model_usage.items()\n             if entry.get(\"canonicalModel\") == requested_model),\n            None)\n        return requested_model, model_version\n\n    if not model_usage:\n        return None, None\n\n    def total_tokens(key: str) -> int:\n        entry = model_usage[key]\n        return ((entry.get(\"inputTokens\", 0) or 0)\n                + (entry.get(\"cacheReadInputTokens\", 0) or 0)\n                + (entry.get(\"cacheCreationInputTokens\", 0) or 0)\n                + (entry.get(\"outputTokens\", 0) or 0))\n\n    winner = max(model_usage, key=total_tokens)\n    return winner, model_usage[winner].get(\"canonicalModel\")\n\n\ndef adapter_version() -> str:\n    try:\n        out = subprocess.run([\"claude\", \"--version\"], capture_output=True,\n                             text=True, check=False)\n    except OSError:\n        return \"\"\n    return out.stdout.strip()\n\n\nMIN_QUESTION_CHARS = 40\n\nREINSTRUCTION = (\n    \"your last answer was a report, not a question; either continue to \"\n    \"done, or ask one question ending in a question mark that names the \"\n    \"spec line or guard you cannot resolve\")\n\n\ndef question_class(status: str, question: str | None) -> str:\n    \"\"\"\"done\" (no halt at all), \"fail\" (a question too short or absent to\n    be worth a person's judgment -- MIN_QUESTION_CHARS, unchanged since\n    v0.15.0), \"report\" (long enough but carries no \"?\" -- issue #88's\n    class A, a status update in the question channel), or \"question\" (a\n    real question).\"\"\"\n    if status != \"question\":\n        return \"done\"\n    if not question or len(question) < MIN_QUESTION_CHARS:\n        # An absent or too-short question is a report with nothing in\n        # it: a status update in the question channel (issue #150, three\n        # specimens on 2026-09-17), never an exit with no report line.\n        return \"report\"\n    if \"?\" not in question:\n        return \"report\"\n    return \"question\"\n\n\n# R3: a vendor's capacity, rate, or 5xx refusal is transient -- classed on\n# this adapter's own report line, the same way non-question already is\n# (issue #88), so a pass retries it plainly instead of paying for a\n# counsel run on a stop the definition of done never touches (#194's own\n# verify-01, closed by the item this adapter now serves).\nTRANSIENT_MARKERS = (\"overloaded\", \"rate limit\", \"rate_limit\", \"429\", \"500\", \"502\", \"503\", \"529\",\n                    \"internal server error\", \"service unavailable\", \"temporarily unavailable\")\n\n\ndef transient_detail(response: dict) -> str | None:\n    \"\"\"response.get(\"result\")'s own text when is_error and it names one of\n    TRANSIENT_MARKERS; else None -- an is_error for any other reason (an\n    auth mismatch, a malformed request) is not this.\"\"\"\n    if not response.get(\"is_error\"):\n        return None\n    text = str(response.get(\"result\") or \"\")\n    low = text.lower()\n    return text if any(marker in low for marker in TRANSIENT_MARKERS) else None\n\n\n# Issue #288: the CLI reports its own authentication failure as a\n# structured field on a stream line (\"error\": \"authentication_failed\",\n# #267 build-01 and build-02), then exits non-zero with no result line.\n# That is the operator's act (sign in again), never a retry and never a\n# question for counsel, so it is classed on this adapter's report line\n# from the field, not from the message's words.\nAUTH_ERRORS = (\"authentication_failed\",)\n\n\ndef auth_failure(raw: str) -> str | None:\n    \"\"\"The first stream line's own text whose \"error\" field names an\n    authentication failure; the error value itself when that line\n    carries no text; None when no line does.\"\"\"\n    for line in raw.splitlines():\n        obj = parse_stream_line(line)\n        if obj is None or obj.get(\"error\") not in AUTH_ERRORS:\n            continue\n        content = (obj.get(\"message\") or {}).get(\"content\") or []\n        texts = [c.get(\"text\") for c in content if isinstance(c, dict) and c.get(\"text\")]\n        return texts[0] if texts else str(obj.get(\"error\"))\n    return None\n\n\ndef subagent_refusal(response: dict) -> str | None:\n    \"\"\"None if response carries no spawned background work; else the\n    refusal naming the counts (issue #88, class B). Checked on the\n    response itself, not the flag that was supposed to forbid it --\n    tenant zero's specimen spawned three with the tool absent from\n    --allowedTools entirely, so the flag alone is not the mechanism.\"\"\"\n    stats = response.get(\"subagent_stats\") or {}\n    spawned = stats.get(\"spawned\") or 0\n    if not spawned:\n        return None\n    killed = stats.get(\"killed\") or {}\n    killed_total = sum(v or 0 for v in killed.values())\n    return (\n        f\"adapters/claude-code/run: refused: subagent_stats.spawned={spawned} \"\n        f\"-- the {' or '.join(SUBAGENT_TOOLS)} tool spawned work that can \"\n        f\"outlive this invocation (completed={stats.get('completed', 0)}, \"\n        f\"killed={killed_total}, \"\n        f\"started_in_background={stats.get('started_in_background', 0)})\")\n\n\ndef load_canned_responses() -> list[dict] | None:\n    \"\"\"None when ATTAVO_ADAPTER_RESPONSE_FILE is unset. Otherwise the\n    queue this run answers from: a single object repeats for every\n    invocation this adapter makes (unchanged since v0.3.0 -- most tests\n    make exactly one), a JSON array is consumed in order, one response\n    per invocation, its last element repeating once exhausted (issue\n    #88: the non-question retry is a second invocation inside the same\n    adapter run, and a canned test needs to hand it a different answer\n    than the first). Distinct from ATTAVO_ADAPTER_STREAM_FILE below: a\n    canned response here is the final report object itself, the shape\n    the model-derivation and report-field tests exercise, never a stream\n    to map -- unaffected by --output-format actually being stream-json\n    on a real invocation.\"\"\"\n    response_file = os.environ.get(\"ATTAVO_ADAPTER_RESPONSE_FILE\")\n    if not response_file:\n        return None\n    raw = json.loads(Path(response_file).read_text())\n    return raw if isinstance(raw, list) else [raw]\n\n\ndef load_canned_stream() -> list[str] | None:\n    \"\"\"None when ATTAVO_ADAPTER_STREAM_FILE is unset. Otherwise a\n    recorded `claude --output-format stream-json --verbose` transcript,\n    one JSONL line per list entry (issue #26, acceptance row 3) -- fed\n    through the same line-by-line mapping and terminal \"result\" read a\n    real invocation gets, so the mapping is exercised without a live\n    `claude` process.\"\"\"\n    stream_file = os.environ.get(\"ATTAVO_ADAPTER_STREAM_FILE\")\n    if not stream_file:\n        return None\n    return Path(stream_file).read_text().splitlines()\n\n\ndef parse_stream_line(line: str) -> dict | None:\n    \"\"\"One parsed JSONL line, or None when it is blank or not JSON -- a\n    tracing line on the same stream is not an error, just not an event\n    (codex's own parse_events does the same).\"\"\"\n    line = line.strip()\n    if not line:\n        return None\n    try:\n        return json.loads(line)\n    except ValueError:\n        return None\n\n\ndef first_string_arg(tool_input: dict | None) -> str:\n    \"\"\"The first string-valued argument of a tool_use block's input, in\n    declaration order -- a file path or a command, the one value worth a\n    feed line; a tool whose arguments are all non-string (booleans,\n    numbers) reports \"\" rather than guess which one matters.\"\"\"\n    for value in (tool_input or {}).values():\n        if isinstance(value, str):\n            return value\n    return \"\"\n\n\ndef tool_result_content_text(content) -> str:\n    \"\"\"A tool_result block's own text, whichever of claude code's two\n    content shapes it carries: a bare string, or a list of {\"type\":\n    \"text\", \"text\": ...} blocks (an image or other non-text block\n    contributes nothing -- there is no line of text to render).\"\"\"\n    if isinstance(content, str):\n        return content\n    if isinstance(content, list):\n        return \"\\n\".join(b.get(\"text\", \"\") for b in content\n                         if isinstance(b, dict) and b.get(\"type\") == \"text\")\n    return \"\"\n\n\ndef stream_line_events(obj: dict) -> list[tuple[str, str]]:\n    \"\"\"[(kind, text), ...] for one parsed stream-json line -- zero, one,\n    or several (one assistant turn can carry a text block and a tool_use\n    block together, each its own event). An assistant message's text\n    block maps to \"message\", its tool_use blocks to \"tool_call\" (the\n    tool's name and its first string argument); a user message carrying\n    a tool_result block maps to \"tool_result\" (the result's own first\n    line). Everything else on the stream -- system, and \"result\" itself,\n    read separately for the report fields rather than rendered as a feed\n    line -- maps to nothing.\"\"\"\n    events: list[tuple[str, str]] = []\n    # The stream is the executor's; its shapes are not the adapter's to\n    # assume. A line whose message is not an object (a diagnostic with a\n    # string message, attavo/attavo#151 build-02) maps to nothing and\n    # stays transcript; nothing here raises on a shape it did not expect.\n    message = obj.get(\"message\")\n    if not isinstance(message, dict):\n        return events\n    content = message.get(\"content\") or []\n    if not isinstance(content, list):\n        return events\n    if obj.get(\"type\") == \"assistant\":\n        for block in content:\n            if not isinstance(block, dict):\n                continue\n            if block.get(\"type\") == \"text\" and block.get(\"text\"):\n                events.append((\"message\", block[\"text\"]))\n            elif block.get(\"type\") == \"tool_use\":\n                name = block.get(\"name\") or \"\"\n                arg = first_string_arg(block.get(\"input\"))\n                events.append((\"tool_call\", f\"{name} {arg}\".strip()))\n    elif obj.get(\"type\") == \"user\":\n        for block in content:\n            if isinstance(block, dict) and block.get(\"type\") == \"tool_result\":\n                text = tool_result_content_text(block.get(\"content\"))\n                first_line = text.splitlines()[0] if text.splitlines() else \"\"\n                events.append((\"tool_result\", first_line))\n    return events\n\n\nEVENT_TEXT_MAX_CHARS = 400\n\n\ndef append_event(events_path: str, kind: str, text: str) -> None:\n    \"\"\"One {at, kind, text} JSON line appended to events_path and\n    flushed at once -- the same shape and the same open-write-close\n    discipline bin/attavo's own append_event uses for its iteration and\n    gate events, kept independently here since an adapter is a separate\n    process with no import path into the product.\"\"\"\n    line = {\"at\": datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\"),\n           \"kind\": kind, \"text\": \" \".join(text.split())[:EVENT_TEXT_MAX_CHARS]}\n    with open(events_path, \"a\") as fh:\n        fh.write(json.dumps(line) + \"\\n\")\n\n\ndef invoke_stream(cmd: list[str], events_path: str | None, canned_lines: list[str] | None\n                  ) -> tuple[str, dict | None, int]:\n    \"\"\"(raw transcript text, the terminal \"result\" object or None, exit\n    code) -- from canned_lines (ATTAVO_ADAPTER_STREAM_FILE) when given,\n    else a real `claude --output-format stream-json --verbose`\n    invocation, read line by line as it runs (not buffered until the\n    process exits) so each mapped event reaches events_path while the\n    stage is still in progress. Every raw line reaches the returned\n    transcript, mapped or not -- issue #34's guarantee: the evidence is\n    what build-NN.log saves, not just what this adapter went on to use.\n    \"\"\"\n    raw_lines: list[str] = []\n    result: dict | None = None\n\n    def handle(line: str) -> None:\n        nonlocal result\n        if not line.strip():\n            return\n        raw_lines.append(line)\n        obj = parse_stream_line(line)\n        if obj is None:\n            return\n        if obj.get(\"type\") == \"result\":\n            result = obj\n            return\n        if events_path:\n            for kind, text in stream_line_events(obj):\n                append_event(events_path, kind, text)\n\n    if canned_lines is not None:\n        for line in canned_lines:\n            handle(line)\n        return \"\\n\".join(raw_lines), result, 0\n\n    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,\n                            env={**executor_env(), **foreground_env()})\n    assert proc.stdout is not None\n    for line in proc.stdout:\n        handle(line.rstrip(\"\\n\"))\n    proc.wait()\n    stderr = proc.stderr.read() if proc.stderr else \"\"\n    if stderr.strip():\n        raw_lines.append(stderr.rstrip(\"\\n\"))\n    return \"\\n\".join(raw_lines), result, proc.returncode\n\n\ndef invoke_once(cmd: list[str], responses: list[dict] | None, call_index: int,\n                events_path: str | None\n                ) -> tuple[int | None, dict | None]:\n    \"\"\"(None, response) for a result this adapter goes on to evaluate;\n    (exit_code, None) when the call itself must end the adapter right\n    away (the underlying tool's own non-zero exit, or a 0 exit whose\n    stream carried no terminal \"result\" line at all). Always prints this\n    call's raw transcript to stdout first -- issue #34's guarantee holds\n    across a retry too: every raw line the tool produced, not just the\n    result this adapter finally reports on, reaches build-NN.log.\n    \"\"\"\n    if responses is not None:\n        response = responses[min(call_index, len(responses) - 1)]\n        print(json.dumps(response))\n        return None, response\n\n    raw, result, returncode = invoke_stream(cmd, events_path, load_canned_stream())\n    if raw.strip():\n        print(raw)\n    auth = auth_failure(raw)\n    if auth is not None:\n        print(json.dumps({\"class\": \"environment\", \"detail\": auth}))\n        return 1, None\n    if returncode != 0:\n        return returncode, None\n    if result is None:\n        return 1, None\n    return None, result\n\n\ndef usage_fields(response: dict) -> tuple[int, int, float | None]:\n    \"\"\"(tokens.input, tokens.output, cost_usd) for one response, pulled\n    straight off usage/total_cost_usd -- independent of model derivation,\n    so a retry's first, discarded call still counts (issue #88: a\n    non-question costs two executor turns, and a report line built from\n    the second call alone undercounts by exactly the first one).\"\"\"\n    usage = response.get(\"usage\") or {}\n    tokens_input = ((usage.get(\"input_tokens\", 0) or 0)\n                    + (usage.get(\"cache_read_input_tokens\", 0) or 0)\n                    + (usage.get(\"cache_creation_input_tokens\", 0) or 0))\n    tokens_output = usage.get(\"output_tokens\", 0) or 0\n    return tokens_input, tokens_output, response.get(\"total_cost_usd\")\n\n\ndef add_cost(a: float | None, b: float | None) -> float | None:\n    \"\"\"None when neither call reported a cost; otherwise the sum,\n    treating an absent figure as 0 -- mirrors bin/attavo's own\n    cost_usd accumulation across build iterations.\"\"\"\n    if a is None and b is None:\n        return None\n    return (a or 0) + (b or 0)\n\n\ndef report_fields(response: dict, requested_model: str | None) -> dict | None:\n    \"\"\"The fields common to every final report line, derived from one\n    tool response; None when no model id can be derived at all (the\n    caller must fail loudly rather than emit a report with no identity\n    behind it).\"\"\"\n    model, model_version = derive_model(response, requested_model)\n    if not model:\n        sys.stderr.write(\n            \"adapters/claude-code/run: could not derive a model id -- the \"\n            \"response carried no requested model and an empty \"\n            \"'modelUsage'\\n\")\n        return None\n    if requested_model and response.get(\"modelUsage\") and not model_version:\n        sys.stderr.write(\n            f\"adapters/claude-code/run: requested model {requested_model!r} \"\n            \"matches no modelUsage canonicalModel -- model_version left \"\n            \"null\\n\")\n\n    tokens_input, tokens_output, cost = usage_fields(response)\n    return {\n        \"model\": model,\n        \"model_version\": model_version,\n        \"adapter_version\": adapter_version(),\n        \"tokens\": {\"input\": tokens_input, \"output\": tokens_output},\n        \"cost_usd\": cost,\n    }\n\n\ndef main() -> int:\n    config = load_config()\n    refusal = refused_config_key(config)\n    if refusal:\n        sys.stderr.write(f\"adapters/claude-code/run: refused: {refusal}\\n\")\n        return 1\n\n    stage = os.environ.get(\"ATTAVO_STAGE\") or \"build\"\n    if stage not in (\"build\", \"verify\", \"counsel\"):\n        stage = \"build\"\n    verifying = stage == \"verify\"\n    counseling = stage == \"counsel\"\n    if verifying:\n        instruction, schema = verify_instruction(), VERIFY_SCHEMA\n    elif counseling:\n        instruction, schema = counsel_instruction(), COUNSEL_SCHEMA\n    else:\n        instruction, schema = build_instruction(), STATUS_SCHEMA\n    cmd = build_command(instruction, config, schema, stage)\n\n    ceiling = ceiling_refusal(instruction)\n    if ceiling:\n        sys.stderr.write(f\"adapters/claude-code/run: refused: {ceiling}\\n\")\n        # Reported, not left for the product to find in the words: nothing\n        # was invoked, so no adapter version and no tokens.\n        print(json.dumps({\"model\": config.get(\"model\"), \"model_version\": None,\n                          \"adapter_version\": None, \"tokens\": {\"input\": 0, \"output\": 0},\n                          \"cost_usd\": None, \"class\": \"ceiling\", \"detail\": ceiling}))\n        return 1\n\n    if os.environ.get(\"ATTAVO_ADAPTER_DRY_RUN\"):\n        # {\"argv\", \"instruction\", \"schema\", \"env\"}, not a bare argv list: the\n        # instruction lives in argv's own \"-p\" value here, but a second\n        # adapter (issue #41) can deliver it on stdin instead, where\n        # argv carries no instruction at all -- the envelope is what\n        # stays adapter-agnostic for tests/test_executor_conformance.py.\n        print(json.dumps({\"argv\": cmd, \"instruction\": instruction, \"schema\": schema,\n                          \"env\": foreground_env()}))\n        return 0\n\n    responses = load_canned_responses()\n    events_path = os.environ.get(\"ATTAVO_EVENTS\")\n\n    exit_code, response = invoke_once(cmd, responses, 0, events_path)\n    if exit_code is not None:\n        return exit_code\n\n    # An error dressed as a question still costs a ruling act. Treat both\n    # the same way build already treats a non-zero adapter exit: failed,\n    # not a halt someone must rule on. Stage-independent: a tool error or\n    # an absent report is a failure whether this is a build or a verify.\n    if response.get(\"is_error\") or not response.get(\"structured_output\"):\n        detail = transient_detail(response)\n        if detail:\n            common = report_fields(response, config.get(\"model\"))\n            if common is not None:\n                print(json.dumps({**common, \"class\": \"transient\", \"detail\": detail}))\n        return 1\n\n    refusal = subagent_refusal(response)\n    if refusal:\n        sys.stderr.write(refusal + \"\\n\")\n        return 1\n\n    structured = response.get(\"structured_output\") or {}\n\n    if verifying:\n        common = report_fields(response, config.get(\"model\"))\n        if common is None:\n            return 1\n        # .get(), not \"or []\": an absent findings key must reach\n        # cmd_verify as None, distinct from an explicit empty list --\n        # that distinction is the whole fix for issue #46.\n        line = {**common,\n               \"findings\": structured.get(\"findings\"),\n               \"tests_named\": structured.get(\"tests_named\")}\n        print(json.dumps(line))\n        return 0\n\n    if counseling:\n        common = report_fields(response, config.get(\"model\"))\n        if common is None:\n            return 1\n        line = {**common,\n               \"class\": structured.get(\"class\"),\n               \"verdict\": structured.get(\"verdict\"),\n               \"citations\": structured.get(\"citations\"),\n               \"proposal\": structured.get(\"proposal\")}\n        print(json.dumps(line))\n        return 0\n\n    status = structured.get(\"status\", \"done\")\n    question = structured.get(\"question\")\n    cls = question_class(status, question)\n\n    if cls == \"fail\":\n        return 1\n\n    if cls == \"report\":\n        # Issue #88, class A: a report in the question channel is\n        # re-instructed once, in this same invocation, before it ever\n        # reaches a person.\n        reinstruction = instruction + \"\\n\\n\" + REINSTRUCTION\n        cmd2 = build_command(reinstruction, config, schema, stage)\n        exit_code2, response2 = invoke_once(cmd2, responses, 1, events_path)\n        if exit_code2 is not None:\n            return exit_code2\n        if response2.get(\"is_error\") or not response2.get(\"structured_output\"):\n            return 1\n        refusal2 = subagent_refusal(response2)\n        if refusal2:\n            sys.stderr.write(refusal2 + \"\\n\")\n            return 1\n\n        structured2 = response2.get(\"structured_output\") or {}\n        status2 = structured2.get(\"status\", \"done\")\n        question2 = structured2.get(\"question\")\n        cls2 = question_class(status2, question2)\n        if cls2 == \"fail\":\n            return 1\n\n        common2 = report_fields(response2, config.get(\"model\"))\n        if common2 is None:\n            return 1\n        # A non-question costs two executor turns, not one: sum both\n        # calls' tokens and cost into the one report line this\n        # invocation gets, whatever the retry's own outcome -- only\n        # adapter_version/model/model_version stay the second call's.\n        tokens1_input, tokens1_output, cost1 = usage_fields(response)\n        common2[\"tokens\"][\"input\"] += tokens1_input\n        common2[\"tokens\"][\"output\"] += tokens1_output\n        common2[\"cost_usd\"] = add_cost(common2[\"cost_usd\"], cost1)\n\n        if cls2 == \"report\":\n            # Two reports in a row: still a halt (someone must look),\n            # but the transcript above already carries both raw\n            # results, and this report line names the class so a\n            # reader -- or a future record field, not this one -- can\n            # tell it apart from a genuine question.\n            print(\"adapters/claude-code/run: halted: class non-question \"\n                  \"-- the executor reported instead of asking, twice in \"\n                  \"a row\")\n            line = {**common2, \"status\": \"question\", \"question\": question2,\n                   \"class\": \"non-question\"}\n            print(json.dumps(line))\n            return 0\n\n        line = {**common2, \"status\": status2, \"question\": question2}\n        print(json.dumps(line))\n        return 0\n\n    common = report_fields(response, config.get(\"model\"))\n    if common is None:\n        return 1\n    line = {**common, \"status\": status, \"question\": question}\n    print(json.dumps(line))\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n","structuredPatch":[{"oldStart":356,"oldLines":6,"newStart":356,"newLines":28,"lines":["     if note:","         parts.append(note)"," ","+    # Counsel's own earlier readings of this item come first: a follow-up","+    # question about a stop counsel has already read is answered from that","+    # reading. The class an earlier reading states is not re-derived.","+    prior_path = os.environ.get(\"ATTAVO_COUNSEL_PRIOR\")","+    prior_text = read_text(\"ATTAVO_COUNSEL_PRIOR\")","+    if prior_text.strip():","+        parts.append(","+            \"## Counsel's earlier readings of this item\\n\\n\"","+            f\"They are at {describe_file(prior_path, prior_text, diff_like=False)}: a JSON list, \"","+            \"oldest first, each with the record it read, its class, verdict, ruling text, \"","+            \"citations and any question it answered. Read them first. Do not re-derive a \"","+            \"class an earlier reading states; a question about a stop already read is \"","+            \"answered as a follow-up to that reading, citing it.\")","+","+    reads = [line for line in os.environ.get(\"ATTAVO_COUNSEL_READS\", \"\").splitlines() if line.strip()]","+    if reads:","+        parts.append(","+            \"## The tenant's corpus\\n\\n\"","+            \"The tenant names these as what counsel reads before it answers -- method rules, \"","+            \"briefs, rulings. Read them with your own tools before answering:\\n\\n\" +","+            \"\\n\".join(f\"- `{r}`\" for r in reads))","+","     record_path = os.environ.get(\"ATTAVO_COUNSEL_RECORD\")","     record_text = read_text(\"ATTAVO_COUNSEL_RECORD\")","     if record_text.strip():"]}],"userModified":
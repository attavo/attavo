hon3 .attavo/bin/select-tests\"\ncall_timeout_s = 240\nrun = \"xargs -r python3 -m pytest -q -m 'not own_records'\"\n\n[paths]\nspecs = \"attest/specs\"\nrecords = \"attest/records\"\nrulings = \"attest/rulings.md\"\nrejections = \"attest/rejections\"\n\n[doctor]\nbuilt_since = \"dae6d765f3d6\"\n\n[operators]\napprovers = [\"dbean10\"]\n\n[checks]\ncommand = \"python3 -m mypy\"\nprobe = \"python3 -c 'import pytest, mypy, jsonschema'\"\nprobe_timeout_s = 60\n\n[drive]\nstall_after_s = 1800\nattempts = 3\nretry_after_s = 300\n\n[drive.build]\nceiling_s = 3600\n\n[drive.verify]\nceiling_s = 1200\n","structuredPatch":[{"oldStart":67,"oldLines":3,"newStart":67,"newLines":6,"lines":[" "," [drive.verify]"," ceiling_s = 1200","+","+[counsel]","+reads = [\"docs/method-rules.md\", \"docs/counsel-rulings.md\", \"docs/r3-rulings.md\", \"docs/storage-ruling.md\"]"]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true}}

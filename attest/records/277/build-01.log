{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JHHPAQ7tnPetjJu6JA9cM7","type":"tool_result","content":"#!/bin/sh\n# adapters/fixture/run -- see ../README.md for the contract. Exists for the\n# tests and the doctor; it is not an executor, and it never writes a record.\nset -eu\n\nwrite_name=\"${ATTAVO_FIXTURE_WRITE:-built.txt}\"\n\nif [ -n \"${ATTAVO_FIXTURE_TRANSIENT:-}\" ]; then\n  # R3: a vendor's capacity, rate, or 5xx refusal, classed on the report\n  # line like every class is -- for the rejection fixture only; a real\n  # adapter's own tool reports this on its own transcript, mapped the\n  # same way non-question already is (issue #88).\n  printf '{\"status\":\"failed\",\"question\":null,\"class\":\"transient\",\"detail\":\"%s\",\"model\":\"fixture\",\"model_version\":null,\"adapter_version\":\"fixture-1\",\"tokens\":{\"input\":1,\"output\":1},\"cost_usd\":0.0}\\n' \\\n    \"${ATTAVO_FIXTURE_TRANSIENT}, retry after 30s\"\n  exit 1\nfi\n\nif [ -n \"${ATTAVO_FIXTURE_CEILING_ERROR:-}\" ]; then\n  # issue #89: a tool error line matching a declared ceiling (the\n  # specimen is codex's own \"input_too_large\" on a diff too large to\n  # judge, issue #86) -- for the ceiling/product rejection test only; a\n  # real adapter's own tool prints this, never the adapter itself.\n  echo \"Error: input_too_large: request exceeds the maximum context length\"\n  exit 1\nfi\n\necho \"ATTAVO_ADAPTER_CONFIG=${ATTAVO_ADAPTER_CONFIG:-}\"\necho \"--- ATTAVO_FEEDBACK ---\"\ncat \"${ATTAVO_FEEDBACK:-/dev/null}\" 2>/dev/null || true\necho \"--- end feedback ---\"\n\nif [ -n \"${ATTAVO_EVENTS:-}\" ]; then\n  # issue #26: three canned events, one of each executor kind, so the\n  # conformance suite can assert the shape a real adapter's own mapping\n  # must also produce -- this fixture has no real executor stream to map.\n  at=\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"\n  printf '{\"at\":\"%s\",\"kind\":\"message\",\"text\":\"fixture: starting\"}\\n' \"$at\" >> \"$ATTAVO_EVENTS\"\n  printf '{\"at\":\"%s\",\"kind\":\"tool_call\",\"text\":\"fixture-tool arg1\"}\\n' \"$at\" >> \"$ATTAVO_EVENTS\"\n  printf '{\"at\":\"%s\",\"kind\":\"tool_result\",\"text\":\"ok\"}\\n' \"$at\" >> \"$ATTAVO_EVENTS\"\nfi\n\nif [ \"${ATTAVO_STAGE:-build}\" = \"counsel\" ]; then\n  # issue #100: a read-only reading of a stop -- the record, its log, and\n  # the diff, all handed by path, plus the tenant manifest and this\n  # product's own root. Answers from a canned file\n  # (ATTAVO_FIXTURE_COUNSEL_RESPONSE) when one is set, so a test controls\n  # class/verdict/citations/proposal exactly; otherwise a canned \"person\"\n  # verdict, since a fixture has no rules of its own to answer from.\n  echo \"--- ATTAVO_COUNSEL_RECORD ---\"\n  cat \"${ATTAVO_COUNSEL_RECORD:-/dev/null}\" 2>/dev/null || true\n  echo \"--- end record ---\"\n  echo \"--- ATTAVO_COUNSEL_LOG ---\"\n  cat \"${ATTAVO_COUNSEL_LOG:-/dev/null}\" 2>/dev/null || true\n  echo \"--- end log ---\"\n  echo \"--- ATTAVO_COUNSEL_DIFF ---\"\n  cat \"${ATTAVO_COUNSEL_DIFF:-/dev/null}\" 2>/dev/null || true\n  echo \"--- end diff ---\"\n  echo \"manifest: ${ATTAVO_MANIFEST:-}\"\n  echo \"product root: ${ATTAVO_PRODUCT_ROOT:-}\"\n  if [ -n \"${ATTAVO_FIXTURE_COUNSEL_WAIT_FOR:-}\" ]; then\n    # holds the run open until a test creates this path (at most 30 s), so\n    # a test can read the worker while counsel is in progress without\n    # sleeping a fixed time for it.\n    waited=0\n    while [ ! -e \"${ATTAVO_FIXTURE_COUNSEL_WAIT_FOR}\" ] && [ \"$waited\" -lt 300 ]; do\n      sleep 0.1\n      waited=$((waited + 1))\n    done\n  fi\n  if [ -n \"${ATTAVO_FIXTURE_COUNSEL_RESPONSE:-}\" ]; then\n    cat \"${ATTAVO_FIXTURE_COUNSEL_RESPONSE}\"\n    echo\n  else\n    printf '{\"model\":\"fixture\",\"model_version\":null,\"adapter_version\":\"fixture-1\",\"tokens\":{\"input\":1,\"output\":1},\"cost_usd\":0.0,\"class\":\"unclassed\",\"verdict\":\"person\",\"citations\":[],\"proposal\":{\"ruling_text\":null,\"patch\":null,\"question\":\"what should we do about this stop?\"}}\\n'\n  fi\n  exit 0\nfi\n\nif [ \"${ATTAVO_STAGE:-build}\" = \"verify\" ]; then\n  echo \"--- ATTAVO_DIFF ---\"\n  cat \"${ATTAVO_DIFF:-/dev/null}\" 2>/dev/null || true\n  echo \"--- end diff ---\"\n  if [ -n \"${ATTAVO_FIXTURE_COMMIT_DURING_VERIFY:-}\" ]; then\n    # a verifier that commits anyway (issue #46) -- for the rejection\n    # test only; a real adapter must never do this.\n    echo \"should not exist\" > verify-side-effect.txt\n    git add verify-side-effect.txt\n    git commit -q -m \"fixture: illegitimate commit during verify\"\n  fi\n  if [ -n \"${ATTAVO_FIXTURE_OMIT_FINDINGS:-}\" ]; then\n    # no findings key at all -- the absent-channel case issue #46 fixes,\n    # distinct from an explicit empty list.\n    printf '{\"model\":\"fixture\",\"model_version\":null,\"adapter_version\":\"fixture-1\",\"tokens\":{\"input\":1,\"output\":1},\"cost_usd\":0.0}\\n'\n  else\n    # verify is a report, not a commit: one canned finding naming what\n    # the criteria did not assert.\n    printf '{\"model\":\"fixture\",\"model_version\":null,\"adapter_version\":\"fixture-1\",\"tokens\":{\"input\":1,\"output\":1},\"cost_usd\":0.0,\"findings\":[{\"title\":\"fixture finding\",\"specimen\":\"fixture\",\"retires\":\"nothing real\",\"rejection_test\":\"none\",\"severity\":\"info\"}],\"tests_named\":[\"tests/test_fixture.py::test_marker\"]}\\n'\n  fi\n  exit 0\nfi\n\nif [ -n \"${ATTAVO_FIXTURE_QUESTION:-}\" ]; then\n  # ATTAVO_FIXTURE_REPORT_CLASS (issue #94): an optional \"class\" field on\n  # this report line, for a rejection test proving derive_stop reads\n  # payload.get(\"class\") itself rather than scanning refusal/halted/log\n  # text for it -- the question text carries no such wording.\n  class_field=\"\"\n  if [ -n \"${ATTAVO_FIXTURE_REPORT_CLASS:-}\" ]; then\n    class_field=\",\\\"class\\\":\\\"${ATTAVO_FIXTURE_REPORT_CLASS}\\\"\"\n  fi\n  printf '{\"status\":\"question\",\"question\":\"%s\",\"model\":\"fixture\",\"model_version\":null,\"adapter_version\":\"fixture-1\",\"tokens\":{\"input\":0,\"output\":0},\"cost_usd\":0.0%s}\\n' \\\n    \"$ATTAVO_FIXTURE_QUESTION\" \"$class_field\"\n  exit 0\nfi\n\nif [ -n \"${ATTAVO_FIXTURE_FOREIGN_COMMIT:-}\" ]; then\n  # a commit not authored by the executor identity build exports (issue\n  # #33) -- for the rejection test only; unset the exported GIT_AUTHOR_*\n  # and GIT_COMMITTER_* first, since those env vars outrank -c user.name\n  # in git's own precedence and a real adapter never does either.\n  echo \"built\" > built.txt\n  git add built.txt\n  env -u GIT_AUTHOR_NAME -u GIT_AUTHOR_EMAIL -u GIT_COMMITTER_NAME -u GIT_COMMITTER_EMAIL \\\n    git -c user.name=\"someone\" -c user.email=\"someone@example.com\" \\\n    commit -q -m \"fixture: a commit not authored by the executor\"\n  echo '{\"status\":\"done\",\"question\":null,\"model\":\"fixture\",\"model_version\":null,\"adapter_version\":\"fixture-1\",\"tokens\":{\"input\":1,\"output\":1},\"cost_usd\":0.0}'\n  exit 0\nfi\n\nif [ -n \"${ATTAVO_FIXTURE_REWIND:-}\" ]; then\n  # #289 build-01's executor: a diagnostic `git reset -q HEAD^` after a\n  # commit that never happened, which moved HEAD off the commit the stage\n  # started on -- for the rejection test only.\n  git reset -q HEAD^\nfi\n\nshould_write=1\nif [ -n \"${ATTAVO_FIXTURE_REQUIRE_FEEDBACK:-}\" ]; then\n  should_write=0\n  if [ -s \"${ATTAVO_FEEDBACK:-/dev/null}\" ]; then\n    should_write=1\n  fi\nfi\n\nif [ \"$should_write\" = \"1\" ]; then\n  mkdir -p \"$(dirname \"$write_name\")\"\n  echo \"built\" > \"$write_name\"\n  if [ -n \"${ATTAVO_FIXTURE_NO_COMMIT:-}\" ]; then\n    # item 227's executor: the change written into the tree and never\n    # committed, then \"done\" -- for the rejection tests only.\n    :\n  else\n    git add \"$write_name\"\n    git commit -q -m \"fixture: write $write_name\"\n  fi\nfi\n\necho '{\"status\":\"done\",\"question\":null,\"model\":\"fixture\",\"model_version\":null,\"adapter
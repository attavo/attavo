\\n305\\t\\n306\\t    def as_dict(self) -> dict:\\n307\\t        return {\\\"proof\\\": self.key, \\\"title\\\": self.title,\\n308\\t                \\\"holds\\\": self.holds, \\\"reason\\\": self.reason, **self.extra}\\n309\\t\\n310\\t\\n311\\tdef read_manifest(root: Path) -> dict | None:\\n312\\t    path = root / MANIFEST\\n313\\t    if not path.is_file():\\n314\\t        return None\\n315\\t    with path.open(\\\"rb\\\") as fh:\\n316\\t        return tomllib.load(fh)\\n317\\t\\n318\\t\\n319\\tdef git(root: Path, *args: str, env: dict | None = None) -> str:\\n320\\t    out = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), *args],\\n321\\t                         capture_output=True, text=True, check=False, env=env)\\n322\\t    if out.returncode != 0:\\n323\\t        raise RuntimeError(out.stderr.strip() or \\\"git failed\\\")\\n324\\t    return out.stdout\\n325\\t\\n326\\t\\n327\\tdef product_version() -> str:\\n328\\t    \\\"\\\"\\\"What the running program is. Three fallbacks, in order, and never an\\n329\\t    exception -- this runs inside write_record, after the work it\\n330\\t    describes already happened, and a raise here would lose the record\\n331\\t    for an invocation that already ran:\\n332\\t\\n333\\t      1. ATTAVO_PRODUCT_VERSION, when the environment sets it. The forge\\n334\\t         action sets this from its own ref (action.yml, not here -- this\\n335\\t         function stays forge-agnostic).\\n336\\t      2. git describe --tags --always --dirty against PRODUCT_ROOT: a\\n337\\t         tagged release reports its tag, a checkout reports its commit,\\n338\\t         a dirty tree says so.\\n339\\t      3. \\\"unknown\\\", when PRODUCT_ROOT is not a git repository at all --\\n340\\t         the case for a forge that extracts this action from a tarball\\n341\\t         rather than a git checkout, which is exactly when (1) is\\n342\\t         expected to already have supplied the answer.\\n343\\t\\n344\\t    Distinct from the tenant's product_pin -- an operator running a\\n345\\t    checkout, which is how every build and verify have actually been run\\n346\\t    so far, bypasses the pin entirely (issue #49).\\\"\\\"\\\"\\n347\\t    env = os.environ.get(\\\"ATTAVO_PRODUCT_VERSION\\\")\\n348\\t    if env:\\n349\\t        return env\\n350\\t    try:\\n351\\t        return git(PRODUCT_ROOT, \\\"describe\\\", \\\"--tags\\\", \\\"--always\\\", \\\"--dirty\\\").strip()\\n352\\t    except RuntimeError:\\n353\\t        return \\\"unknown\\\"\\n354\\t\\n355\\t\\n356\\tdef now_iso() -> str:\\n357\\t    return datetime.now(timezone.utc).strftime(\\\"%Y-%m-%dT%H:%M:%SZ\\\")\\n358\\t\\n359\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"6e2492c7-2a27-487f-99c4-d4ecc36025b0\",\"uuid\":\"1c192905-fa83-4f8a-8842-3dcc88e7c035\",\"timestamp\":\"2026-09-17T16:12:26.834Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/davidbean/Projects/attavo-worktree-153/bin/attavo\",\"content\":\"\\n    def hold(self, reason: str, **extra) -> \\\"Proof\\\":\\n        self.holds, self.reason = True, reason\\n        self.extra.update(extra)\\n        return self\\n\\n    def as_dict(self) -> dict:\\n        return {\\\"proof\\\": self.key, \\\"title\\\": self.title,\\n                \\\"holds\\\": self.holds, \\\"reason\\\": self.reason, **self.extra}\\n\\n\\ndef read_manifest(root: Path) -> dict | None:\\n    path = root / MANIFEST\\n    if not path.is_file():\\n        return None\\n    with path.open(\\\"rb\\\") as fh:\\n        return tomllib.load(fh)\\n\\n\\ndef git(root: Path, *args: str, env: dict | None = None) -> str:\\n    out = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), *args],\\n                         capture_output=True, text=True, check=False, env=env)\\n    if out.returncode != 0:\\n        raise RuntimeError(out.stderr.strip() or \\\"git failed\\\")\\n    return out.stdout\\n\\n\\ndef product_version() -> str:\\n    \\\"\\\"\\\"What the running program is. Three fallbacks, in order, and never an\\n    exception -- this runs inside write_record, after the work it\\n    describes already happened, and a raise here would lose the record\\n    for an invocation that already ran:\\n\\n      1. ATTAVO_PRODUCT_VERSION, when the environment sets it. The forge\\n         action sets this from its own ref (action.yml, not here -- this\\n         function stays forge-agnostic).\\n      2. git describe --tags --always --dirty against PRODUCT_ROOT: a\\n         tagged release reports its tag, a checkout reports its commit,\\n         a dirty tree says so.\\n      3. \\\"unknown\\\", when PRODUCT_ROOT is not a git repository at all --\\n         the case for a forge that extracts this action from a tarball\\n         rather than a git checkout, which is exactly when (1) is\\n         expected to already have supplied the answer.\\n\\n    Distinct from the tenant's product_pin -- an operator running a\\n    checkout, which is how every build and verify have actually been run\\n    so far, bypasses the pin entirely (issue #49).\\\"\\\"\\\"\\n    env = os.environ.get(\\\"ATTAVO_PRODUCT_VERSION\\\")\\n    if env:\\n        return env\\n    try:\\n        return git(PRODUCT_ROOT, \\\"describe\\\", \\\"--tags\\\", \\\"--always\\\", \\\"--dirty\\\").strip()\\n    except RuntimeError:\\n        return \\\"unknown\\\"\\n\\n\\ndef now_iso() -> str:\\n    return datetime.now(timezone.utc).strftime(\\\"%Y-%m-%dT%H:%M:%SZ\\\")\\n\\n\",\"numLines\":60,\"startLine\":300,\"totalLines\":3393}}}\n+{\"type\":\"rate_limit_event\",\"rate_limit_info\":{\"status\":\"allowed\",\"resetsAt\":1789664400,\"rateLimitType\":\"five_hour\",\"overageStatus\":\"allowed\",\"overageResetsAt\":1790812800,\"isUsingOverage\":false,\"unifiedWindows\":{\"five_hour\":{\"utilization\":0.34,\"resetsAt\":1789664400},\"seven_day\":{\"utilization\":0.1,\"resetsAt\":1790222400}}},\"uuid\":\"2622f8a8-b272-4248-801b-355ea5f0cf2e\",\"session_id\":\"6e2492c7-2a27-487f-99c4-d4ecc36025b0\"}\n+{\"type\":\"assist
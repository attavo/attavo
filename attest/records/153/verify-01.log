 \"1\", \"--json\")\ntests/test_ledger.py:184:    run_text = run_attavo(root, \"ledger\", \"1\")\ntests/test_stops.py:45:    root = make_tenant(tmp_path, \"ledger_base\")\ntests/test_stops.py:125:    root = make_tenant(tmp_path, \"ledger_base\")\ntests/test_stops.py:144:    root = make_tenant(tmp_path, \"ledger_base\")\ntests/test_stops.py:172:    root = make_tenant(tmp_path, \"ledger_base\")\ntests/test_stops.py:201:    root = make_tenant(tmp_path, \"ledger_base\")\ntests/test_record_only.py:38:def test_record_only_false_when_the_head_commit_touches_specs(tmp_path):\ntests/test_record_only.py:47:def test_record_only_false_when_the_head_commit_touches_both_records_and_specs(tmp_path):\n\"\"\"attavo ledger: every act on an item by identity and class (issue #128).\n\nRegression tests, written and run red first: on `main` before this change\nthere was no `ledger` subcommand, so every one of these failed with\n\"unknown subcommand\".\n\nRun: python3 -m pytest tests -q\n\"\"\"\nimport json\nimport os\nimport subprocess\nimport sys\nfrom pathlib import Path\n\nfrom helpers import git, make_tenant\n\nROOT = Path(__file__).resolve().parent.parent\nATTAVO = ROOT / \"bin\" / \"attavo\"\n\n# The four identities issue #128 names: a person (writes the spec, in the\n# real templates also the one who comments /approve), the records app (a\n# GitHub App's own bot login -- \"<app-slug>[bot]\" -- that commits\n# spec-gate and approval records in attavo-spec-gate.yml and\n# attavo-approve.yml), the driver (drive's own record commits), and the\n# executor (an adapter invocation's own commits).\nPERSON = {\"name\": \"Alice Author\", \"email\": \"alice@example.com\"}\nRECORDS_APP = {\"name\": \"attavo-bot[bot]\", \"email\": \"123+attavo-bot[bot]@users.noreply.github.com\"}\nDRIVER = {\"name\": \"attavo driver\", \"email\": \"driver@attavo.invalid\"}\nEXECUTOR = {\"name\": \"attavo executor (fixture)\", \"email\": \"executor+fixture@attavo.invalid\"}\n\n\ndef run_attavo(root: Path, *args: str) -> subprocess.CompletedProcess:\n    return subprocess.run([sys.executable, str(ATTAVO), *args], cwd=str(root),\n                          capture_output=True, text=True, check=False)\n\n\ndef commit_as(root: Path, identity: dict, message: str, paths: list[str]) -> str:\n    \"\"\"Stage exactly paths and commit as identity, both author and\n    committer -- the same shape commit_record and the tenant's own CI\n    templates set (never the tenant's ambient git config).\"\"\"\n    git(root, \"add\", *paths)\n    env = dict(os.environ)\n    env[\"GIT_AUTHOR_NAME\"] = env[\"GIT_COMMITTER_NAME\"] = identity[\"name\"]\n    env[\"GIT_AUTHOR_EMAIL\"] = env[\"GIT_COMMITTER_EMAIL\"] = identity[\"email\"]\n    subprocess.run([\"git\", \"-C\", str(root), \"commit\", \"-q\", \"-m\", message],\n                   check=True, env=env)\n    return git(root, \"rev-parse\", \"HEAD\").strip()\n\n\ndef write_record(root: Path, item: str, stage: str, n: int, content: dict) -> str:\n    records_dir = root / \"records\" / item\n    records_dir.mkdir(parents=True, exist_ok=True)\n    path = records_dir / f\"{stage}-{n:02d}.json\"\n    path.write_text(json.dumps(content))\n    return str(path.relative_to(root))\n\n\ndef add_spec(root: Path, item: str = \"1\") -> str:\n    spec_dir = root / \"specs\" / item\n    spec_dir.mkdir(parents=True)\n    (spec_dir / \"spec.md\").write_text(\"## Problem\\n\\nsomething.\\n\")\n    return commit_as(root, PERSON, f\"spec: item {item}\", [f\"specs/{item}\"])\n\n\ndef build_merged_item(tmp_path: Path, item: str = \"1\") -> Path:\n    \"\"\"The order #651 had: a person's spec commit, the records app's\n    spec-gate and approval records, the executor's own change, the\n    driver's build and verify records, then the merge landing all of it\n    on main.\"\"\"\n    root = make_tenant(tmp_path, \"ledger_base\")\n    git(root, \"checkout\", \"-b\", \"item\")\n\n    spec_sha = add_spec(root, item)\n\n    rel = write_record(root, item, \"spec\", 1,\n                       {\"status\": \"pass\", \"spec_sha\": spec_sha, \"product_version\": \"v0.19.1\"})\n    commit_as(root, RECORDS_APP, f\"attavo: spec-gate record for item {item}\", [rel])\n\n    rel = write_record(root, item, \"approval\", 1,\n                       {\"approved_by\": \"alice\", \"sha\": spec_sha, \"spec_sha\": spec_sha,\n                        \"product_version\": \"v0.19.1\"})\n    commit_as(root, RECORDS_APP, f\"attavo: approval record for item {item}\", [rel])\n\n    (root / \"built.txt\").write_text(\"built\\n\")\n    commit_as(root, EXECUTOR, f\"fixture: build item {item}\", [\"built.txt\"])\n\n    rel = write_record(root, item, \"build\", 1, {\"status\": \"pass\", \"product_version\": \"v0.19.1\"})\n    commit_as(root, DRIVER, f\"attavo: build record for item {item} (build-01)\", [rel])\n\n    rel = write_record(root, item, \"verify\", 1, {\"status\": \"pass\", \"product_version\": \"v0.19.1\"})\n    commit_as(root, DRIVER, f\"attavo: verify record for item {item} (verify-01)\", [rel])\n\n    git(root, \"checkout\", \"main\")\n    subprocess.run([\"git\", \"-C\", str(root), \"merge\", \"--no-ff\", \"item\",\n                    \"-m\", f\"Merge pull request #{item} from x/item\"], check=True)\n    return root\n\n\ndef test_ledger_classifies_every_commit_and_counts_operator_acts(tmp_path):\n    \"\"\"Acceptance row 1: on a fixture with the four identities, every\n    commit gets exactly one class and the summary counts operator acts 2\n    -- the same shape tenant zero's own #651 reads (1 approve, 1 merge).\"\"\"\n    root = build_merged_item(tmp_path)\n\n    run = run_attavo(root, \"ledger\", \"1\", \"--json\")\n    assert run.returncode == 0, run.stdout + run.stderr\n    data = json.loads(run.stdout)\n\n    classes = [row[\"class\"] for row in data[\"rows\"]]\n    assert classes == [\"spec\", \"record\", \"approve\", \"change\", \"record\", \"record\", \"merge\"]\n    assert all(row[\"class\"] and row[\"sha\"] and row[\"identity\"] for row in data[\"rows\"])\n\n    summary = data[\"summary\"]\n    assert summary[\"operator_acts\"] == 2\n    assert summary[\"product_acts\"] == 3\n    assert summary[\"executor_commits\"] == 1\n    assert summary[\"stops\"] == 0\n    assert summary[\"since\"] == \"v0.19.1\"\n\n\ndef test_ledger_stops_count_matches_stops_including_a_gate_refusal(tmp_path):\n    \"\"\"Issue #137, acceptance row 2. A refused spec-gate record and a\n    non-pass build record: ledger's own stops count is the same set\n    `attavo stops` counts, gate refusals included -- both computed by\n    item_stops, not two producers reading one item and printing\n    different numbers (tenant zero #683: stops printed 1, ledger printed\n    0, because ledger's own count only ever looked at build and verify).\n    \"\"\"\n    root = make_tenant(tmp_path, \"ledger_base\")\n    add_spec(root)\n\n    write_record(root, \"1\", \"spec\", 1,\n                {\"status\": \"refused\",\n                 \"refusal\": \"criterion fails against the tree plus stub: \"\n                            \"doctor-template-absent.sh\"})\n    write_record(root, \"1\", \"build\", 1, {\"status\": \"failed\"})\n\n    ledger_run = run_attavo(root, \"ledger\", \"1\", \"--json\")\n    assert ledger_run.returncode == 0, ledger_run.stdout + ledger_run.stderr\n    stops_run = run_attavo(root, \"stops\", \"1\", \"--json\")\n    assert stops_run.returncode == 0, stops_run.stdout + stops_run.stderr\n\n    ledger_data = json.loads(ledger_run.stdout)\n    stops_data = json.loads(stops_run.stdout)\n\n    assert len(stops_data[\"rows\"]) == 2\n    assert ledger_data[\"summary\"][\"stops\"] == len(stops_data[\"rows\"])\n\n\ndef test_ledger_marks_a_pre_v018_record_commit_as_record_or_launch(tmp_path):\n    \"\"\"Acceptance row 2: a person's record commit before v0.18.0 prints\n    record-or-launch with the note, never launch or record -- before that\n    version the driver and the executor had no identity of their own to\n    tell a genuine launch apart from an automated one.\"\"\"\n    root = make_tenant(tmp_path, \"ledger_base\")\n    add_spec(root)\n\n    rel = write_record(root, \"1\", \"build\", 1, {\"status\": \"pass\", \"product_version\": \"v0.17.0\"})\n    person_sha = commit_as(root, PERSON, \"manual build record for item 1\", [rel])\n\n    run = run_attavo(root, \"ledger\", \"1\", \"--json\")\n    assert run.returncode == 0, run.stdout + run.stderr\n    data = json.loads(run.stdout)\n\n    row = next(r for r in data[\"rows\"] if r[\"sha\"] == person_sha)\n    assert row[\"class\"] == \"record-or-launch\"\n    assert row[\"note\"] == \"not distinguishable before v0.18.0\"\n    assert data[\"summary\"][\"operator_acts\"] == 0\n    assert data[\"summary\"][\"product_acts\"] == 0\n\n\ndef test_ledger_json_is_one_object_matching_the_text_forms_numbers(tmp_path):\n    \"\"\"Acceptance row 3: --json is one object with rows and summary, and\n    the text form prints the same numbers.\"\"\"\n    root = build_merged_item(tmp_path)\n\n    run_json = run_attavo(root, \"ledger\", \"1\", \"--json\")\n    assert run_json.returncode == 0, run_json.stdout + run_json.stderr\n    data = json.loads(run_json.stdout)\n    assert set(data) == {\"item\", \"rows\", \"summary\"}\n    assert isinstance(data[\"rows\"], list)\n    assert isinstance(data[\"summary\"], dict)\n\n    run_text = run_attavo(root, \"ledger\", \"1\")\n    assert run_text.returncode == 0, run_text.stdout + run_text.stderr\n    summary = data[\"summary\"]\n    assert f\"operator acts: {summary['operator_acts']}\" in run_text.stdout\n    assert f\"product acts: {summary['product_acts']}\" in run_text.stdout\n    assert f\"executor commits: {summary['executor_commits']}\" in run_text.stdout\n    assert f\"stops: {summary['stops']}\" in run_text.stdout\n    assert f\"since: {summary['since']}\" in run_text.stdout\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-joeFOQK2' (errno=Operation not permitted)\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-DbUdy9kG' (errno=Operation not permitted)\n    shape the forge itself gives every app identity, not a specific one.\"\"\"\n    return name.endswith(\"[bot]\")\n\n\ndef first_commit_touching(root: Path, relpath: str) -> str | None:\n    \"\"\"The earliest commit touching relpath -- the mirror of\n    last_commit_touching, which answers the latest. Ledger's own walk\n    starts here: the item's first spec commit.\"\"\"\n    out = git(root, \"log\", \"--reverse\", \"--format=%H\", \"--\", relpath)\n    lines = out.split()\n    return lines[0] if lines else None\n\n\ndef _commit_touches(root: Path, sha: str) -> list[str]:\n    return git(root, \"diff\", \"--name-only\", f\"{sha}^1\", sha).splitlines()\n\n\ndef _record_at(root: Path, sha: str, relpath: str, item_id: str) -> dict:\n    \"\"\"A record's own dict at a past commit, not the working tree --\n    ledger's only need for one (issue #128). Read through _load_record\n    (issue #60, acceptance 6: the one place a record's bytes become a\n    dict) by spilling the blob to a throwaway file, rather than a second\n    json.loads of its own: `git show` has no path on disk to hand\n    _load_record directly.\"\"\"\n    out = subprocess.run([\"git\", \"-C\", str(root), \"show\", f\"{sha}:{relpath}\"],\n                         capture_output=True, text=True, check=False)\n    if out.returncode != 0:\n        return {}\n    with tempfile.NamedTemporaryFile(\"w\", suffix=\".json\", delete=False) as fh:\n        fh.write(out.stdout)\n        blob_path = Path(fh.name)\n    try:\n        return _load_record(blob_path, item_id)\n    except json.JSONDecodeError:\n        return {}\n    finally:\n        blob_path.unlink(missing_ok=True)\n\n\ndef item_ledger(root: Path, m: dict, item_id: str) -> dict:\n    \"\"\"{\"item\", \"rows\", \"summary\"}: one row per act between item_id's first\n    spec commit and its merge (merge_introducing_records, the same\n    derivation doctor's proof two and attest both already read) or HEAD\n    when the item has not merged yet.\n\n    Each commit gets exactly one class, in this order: the merge commit\n    itself is \"merge\"; a commit authored by the executor identity\n    (executor_identity) is \"change\"; a commit introducing an approval\n    record is \"approve\", whoever committed it -- an operator's decision,\n    however it reached git; a commit introducing a spec-gate, build, or\n    verify record, authored by the driver identity (driver_identity) or\n    the records app, is \"record\"; the same, authored by a person, is\n    \"launch\" for build or verify (spec-gate records the app always\n    commits, in every template this product ships) -- unless that\n    record's own product_version predates v0.18.0, when driver_identity\n    did not yet exist to tell the two apart, and the row is\n    \"record-or-launch\" with a note, counted in neither summary total\n    rather than guessed; a person's commit touching the spec is \"spec\"\n    before the first approval record and \"amend\" after; anything else by\n    a person is \"transport\" (a merge of main among them).\"\"\"\n    specs_rel = m[\"paths\"][\"specs\"]\n    records_rel = m[\"paths\"][\"records\"]\n    specs_prefix = f\"{specs_rel.rstrip('/')}/{item_id}/\"\n    records_prefix = f\"{records_rel.rstrip('/')}/{item_id}/\"\n    empty_summary = {\"operator_acts\": 0, \"product_acts\": 0, \"executor_commits\": 0,\n                     \"stops\": 0, \"since\": None}\n\n    first_spec_sha = first_commit_touching(root, str(Path(specs_rel) / item_id))\n    if first_spec_sha is None:\n        return {\"item\": item_id, \"rows\": [], \"summary\": empty_summary}\n\n    merge_sha = merge_introducing_records(root, records_rel, item_id, STAGES)\n    if merge_sha is not None:\n        branch_tip = git(root, \"rev-parse\", f\"{merge_sha}^2\").strip()\n        commits = commits_since(root, f\"{first_spec_sha}^\", end=branch_tip)\n        commits += commits_since(root, f\"{merge_sha}^1\", end=merge_sha)\n    else:\n        commits = commits_since(root, f\"{first_spec_sha}^\", end=\"HEAD\")\n\n    driver = driver_identity()\n    rows: list[dict] = []\n    operator_acts = product_acts = executor_commits = 0\n    since = None\n    approval_seen = False\n\n    for c in commits:\n        sha, name, email = c[\"sha\"], c[\"name\"], c[\"email\"]\n\n        if merge_sha is not None and sha == merge_sha:\n            rows.append({\"sha\": sha, \"identity\": name, \"class\": \"merge\"})\n            operator_acts += 1\n            continue\n\n        if email.startswith(\"executor+\") and email.endswith(\"@attavo.invalid\"):\n            rows.append({\"sha\": sha, \"identity\": name, \"class\": \"change\"})\n            executor_commits += 1\n            continue\n\n        touched = _commit_touches(root, sha)\n        record_touch = None\n        for p in touched:\n            if not p.startswith(records_prefix):\n                continue\n            rm = RECORD_RE.match(Path(p).name)\n            if rm and rm.group(1) in STAGES:\n                record_touch = (rm.group(1), p)\n                break\n\n        if record_touch is not None:\n            stage, relpath = record_touch\n            content = _record_at(root, sha, relpath, item_id)\n            if since is None:\n                since = content.get(\"product_version\")\n\n            if stage == \"approval\":\n                rows.append({\"sha\": sha, \"identity\": name, \"class\": \"approve\"})\n                operator_acts += 1\n                approval_seen = True\n                continue\n\n            is_driver = name == driver[\"name\"] and email == driver[\"email\"]\n            is_records_app = _is_records_app(name)\n            if stage == \"spec\" or is_driver or is_records_app:\n                rows.append({\"sha\": sha, \"identity\": name, \"class\": \"record\"})\n                product_acts += 1\n                continue\n\n            version = _semver_tuple(content.get(\"product_version\"))\n            if version is not None and version < LEDGER_V018_CUTOFF:\n                rows.append({\"sha\": sha, \"identity\": name, \"class\": \"record-or-launch\",\n                            \"note\": \"not distinguishable before v0.18.0\"})\n                continue\n\n            rows.append({\"sha\": sha, \"identity\": name, \"class\": \"launch\"})\n            operator_acts += 1\n            continue\n\n        if any(p.startswith(specs_prefix) for p in touched):\n            cls = \"amend\" if approval_seen else \"spec\"\n            rows.append({\"sha\": sha, \"identity\": name, \"class\": cls})\n            if cls == \"amend\":\n                operator_acts += 1\n            continue\n\n        rows.append({\"sha\": sha, \"identity\": name, \"class\": \"transport\"})\n        operator_acts += 1\n\n    # issue #137: the same set attavo stops counts, from the same reader\n    # (item_stops) -- not a second, independent count kept in sync by\n    # hand. One non-pass record per row, whatever its stage; a gate\n    # refusal is included the same as a non-pass build or verify record.\n    stops = len(item_stops(root, m, item_id)[\"rows\"])\n\n    summary = {\"operator_acts\": operator_acts, \"product_acts\": product_acts,\n              \"executor_commits\": executor_commits, \"stops\": stops, \"since\": since}\n    return {\"item\": item_id, \"rows\": rows, \"summary\": summary}\n\n\ndef cmd_ledger(argv: list[str]) -> int:\n    as_json = \"--json\" in argv\n    positional = [a for a in argv if a != \"--json\"]\n    root = Path(\".\").resolve()\n    m = read_manifest(root)\n    if m is None:\n        print(f\"attavo ledger: no {MANIFEST} at {root}\", file=sys.stderr)\n        return 2\n\n    records_rel = m[\"paths\"][\"records\"]\n    if positional:\n        item_ids = [positional[0]]\n    else:\n        records_root = root / records_rel\n        item_ids = (sorted((p.name for p in records_root.iterdir() if p.is_dir()))\n                   if records_root.is_dir() else [])\n\n    ledgers = [item_ledger(root, m, item_id) for item_id in item_ids]\n\n    if as_json:\n        if positional:\n            print(json.dumps(ledgers[0], indent=2))\n        else:\n            print(json.dumps({\"items\": ledgers}, indent=2))\n        return 0\n\n    for entry in ledgers:\n        print(f\"attavo ledger: item {entry['item']}\")\n        for row in entry[\"rows\"]:\n            note = f\"  ({row['note']})\" if \"note\" in row else \"\"\n            print(f\"  {row['sha'][:12]}  {row['identity']:<32}  {row['class']}{note}\")\n        s = entry[\"summary\"]\n        print(f\"  operator acts: {s['operator_acts']}  product acts: {s['product_acts']}  \"\n             f\"executor commits: {s['executor_commits']}  stops: {s['stops']}  \"\n             f\"since: {s['since']}\")\n    if not ledgers:\n        print(f\"attavo ledger: no item found under {records_rel}\")\n    return 0\n## Problem\n\n`attavo ledger --json` on tenant zero's twelve items runs 537 git processes and takes 8.7 s, read on 2026-09-17 with cProfile and a `GIT_TRACE` file: `merge_introducing_records` diffs every merge reachable from HEAD, per item, until it finds the one; `_commit_touches` runs one `git diff` per walked commit; `_record_at` runs one `git show` per record. Git answers each in 16 ms; the process is the cost, and it grows with every commit and record the corpus gains. The operator screen pays the whole of it on every read of Execute, Analyze, and a detail, so the ledger's ten seconds are the screen's ten seconds.\n\nRetires: the git process per merge, per commit, and per record in the ledger's walk.\n\n## Claims\n\n- bin/attavo\n- tests/test_ledger.py\n\n## Criteria\n\n- ledger-six-items-under-sixty-git-processes.sh: on a six-item corpus the script builds with git, attavo ledger --json lists every item's rows and runs at most sixty git processes, counted from a GIT_TRACE file\n- ledger-records-cost-no-git-process.sh: an item with twelve records costs the ledger no more git processes than the same item with four, within two\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-IigaRmIz' (errno=Operation not permitted)\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-kjempUY5' (errno=Operation not permitted)\nattest/records/153/approval-01.json\nattest/records/153/build-01.filed\nattest/records/153/build-01.json\nattest/records/153/build-01.log\nattest/records/153/counsel-01.json\nattest/records/153/counsel-01.log\nbin/attavo\n","exit_code":0,"status":"completed"}}

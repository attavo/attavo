{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01E6qnLmo5Q81MwG289nZuWf","type":"tool_result","content":"1\t\"\"\"attavo ledger: every act on an item by identity and class (issue #128).\n2\t\n3\tRegression tests, written and run red first: on `main` before this change\n4\tthere was no `ledger` subcommand, so every one of these failed with\n5\t\"unknown subcommand\".\n6\t\n7\tRun: python3 -m pytest tests -q\n8\t\"\"\"\n9\timport json\n10\timport os\n11\timport subprocess\n12\timport sys\n13\tfrom pathlib import Path\n14\t\n15\tfrom helpers import git, make_tenant\n16\t\n17\tROOT = Path(__file__).resolve().parent.parent\n18\tATTAVO = ROOT / \"bin\" / \"attavo\"\n19\t\n20\t# The four identities issue #128 names: a person (writes the spec, in the\n21\t# real templates also the one who comments /approve), the records app (a\n22\t# GitHub App's own bot login -- \"<app-slug>[bot]\" -- that commits\n23\t# spec-gate and approval records in attavo-spec-gate.yml and\n24\t# attavo-approve.yml), the driver (drive's own record commits), and the\n25\t# executor (an adapter invocation's own commits).\n26\tPERSON = {\"name\": \"Alice Author\", \"email\": \"alice@example.com\"}\n27\tRECORDS_APP = {\"name\": \"attavo-bot[bot]\", \"email\": \"123+attavo-bot[bot]@users.noreply.github.com\"}\n28\tDRIVER = {\"name\": \"attavo driver\", \"email\": \"driver@attavo.invalid\"}\n29\tEXECUTOR = {\"name\": \"attavo executor (fixture)\", \"email\": \"executor+fixture@attavo.invalid\"}\n30\t\n31\t\n32\tdef run_attavo(root: Path, *args: str) -> subprocess.CompletedProcess:\n33\t    return subprocess.run([sys.executable, str(ATTAVO), *args], cwd=str(root),\n34\t                          capture_output=True, text=True, check=False)\n35\t\n36\t\n37\tdef commit_as(root: Path, identity: dict, message: str, paths: list[str]) -> str:\n38\t    \"\"\"Stage exactly paths and commit as identity, both author and\n39\t    committer -- the same shape commit_record and the tenant's own CI\n40\t    templates set (never the tenant's ambient git config).\"\"\"\n41\t    git(root, \"add\", *paths)\n42\t    env = dict(os.environ)\n43\t    env[\"GIT_AUTHOR_NAME\"] = env[\"GIT_COMMITTER_NAME\"] = identity[\"name\"]\n44\t    env[\"GIT_AUTHOR_EMAIL\"] = env[\"GIT_COMMITTER_EMAIL\"] = identity[\"email\"]\n45\t    subprocess.run([\"git\", \"-C\", str(root), \"commit\", \"-q\", \"-m\", message],\n46\t                   check=True, env=env)\n47\t    return git(root, \"rev-parse\", \"HEAD\").strip()\n48\t\n49\t\n50\tdef write_record(root: Path, item: str, stage: str, n: int, content: dict) -> str:\n51\t    records_dir = root / \"records\" / item\n52\t    records_dir.mkdir(parents=True, exist_ok=True)\n53\t    path = records_dir / f\"{stage}-{n:02d}.json\"\n54\t    path.write_text(json.dumps(content))\n55\t    return str(path.relative_to(root))\n56\t\n57\t\n58\tdef add_spec(root: Path, item: str = \"1\") -> str:\n59\t    spec_dir = root / \"specs\" / item\n60\t    spec_dir.mkdir(parents=True)\n61\t    (spec_dir / \"spec.md\").write_text(\"## Problem\\n\\nsomething.\\n\")\n62\t    return commit_as(root, PERSON, f\"spec: item {item}\", [f\"specs/{item}\"])\n63\t\n64\t\n65\tdef build_merged_item(tmp_path: Path, item: str = \"1\") -> Path:\n66\t    \"\"\"The order #651 had: a person's spec commit, the records app's\n67\t    spec-gate and approval records, the executor's own change, the\n68\t    driver's build and verify records, then the merge landing all of it\n69\t    on main.\"\"\"\n70\t    root = make_tenant(tmp_path, \"ledger_base\")\n71\t    git(root, \"checkout\", \"-b\", \"item\")\n72\t\n73\t    spec_sha = add_spec(root, item)\n74\t\n75\t    rel = write_record(root, item, \"spec\", 1,\n76\t                       {\"status\": \"pass\", \"spec_sha\": spec_sha, \"product_version\": \"v0.19.1\"})\n77\t    commit_as(root, RECORDS_APP, f\"attavo: spec-gate record for item {item}\", [rel])\n78\t\n79\t    rel = write_record(root, item, \"approval\", 1,\n80\t                       {\"approved_by\": \"alice\", \"sha\": spec_sha, \"spec_sha\": spec_sha,\n81\t                        \"product_version\": \"v0.19.1\"})\n82\t    commit_as(root, RECORDS_APP, f\"attavo: approval record for item {item}\", [rel])\n83\t\n84\t    (root / \"built.txt\").write_text(\"built\\n\")\n85\t    commit_as(root, EXECUTOR, f\"fixture: build item {item}\", [\"built.txt\"])\n86\t\n87\t    rel = write_record(root, item, \"build\", 1, {\"status\": \"pass\", \"product_version\": \"v0.19.1\"})\n88\t    commit_as(root, DRIVER, f\"attavo: build record for item {item} (build-01)\", [rel])\n89\t\n90\t    rel = write_record(root, item, \"verify\", 1, {\"status\": \"pass\", \"product_version\": \"v0.19.1\"})\n91\t    commit_as(root, DRIVER, f\"attavo: verify record for item {item} (verify-01)\", [rel])\n92\t\n93\t    git(root, \"checkout\", \"main\")\n94\t    subprocess.run([\"git\", \"-C\", str(root), \"merge\", \"--no-ff\", \"item\",\n95\t                    \"-m\", f\"Merge pull request #{item} from x/item\"], check=True)\n96\t    return root\n97\t\n98\t\n99\tdef test_ledger_classifies_every_commit_and_counts_operator_acts(tmp_path):\n100\t    \"\"\"Acceptance row 1: on a fixture with the four identities, every\n101\t    commit gets exactly one class and the summary counts operator acts 2\n102\t    -- the same shape tenant zero's own #651 reads (1 approve, 1 merge).\"\"\"\n103\t    root = build_merged_item(tmp_path)\n104\t\n105\t    run = run_attavo(root, \"ledger\", \"1\", \"--json\")\n106\t    assert run.returncode == 0, run.stdout + run.stderr\n107\t    data = json.loads(run.stdout)\n108\t\n109\t    classes = [row[\"class\"] for row in data[\"rows\"]]\n110\t    assert classes == [\"spec\", \"record\", \"approve\", \"change\", \"record\", \"record\", \"merge\"]\n111\t    assert all(row[\"class\"] and row[\"sha\"] and row[\"identity\"] for row in data[\"rows\"])\n112\t\n113\t    summary = data[\"summary\"]\n114\t    assert summary[\"operator_acts\"] == 2\n115\t    assert summary[\"product_acts\"] == 3\n116\t    assert summary[\"executor_commits\"] == 1\n117\t    assert summary[\"stops\"] == 0\n118\t    assert summary[\"since\"] == \"v0.19.1\"\n119\t\n120\t\n121\tdef test_ledger_stops_count_matches_stops_including_a_gate_refusal(tmp_path):\n122\t    \"\"\"Issue #137, acceptance row 2. A refused spec-gate record and a\n123\t    non-pass build record: ledger's own stops count is the same set\n124\t    `attavo stops` counts, gate refusals included -- both computed by\n125\t    item_stops, not two producers reading one item and printing\n126\t    different numbers (tenant zero #683: stops printed 1, ledger printed\n127\t    0, because ledger's own count only ever looked at build and verify).\n128\t    \"\"\"\n129\t    root = make_tenant(tmp_path, \"ledger_base\")\n130\t    add_spec(root)\n131\t\n132\t    write_record(root, \"1\", \"spec\", 1,\n133\t                {\"status\": \"refused\",\n134\t                 \"refusal\": \"criterion fails against the tree plus stub: \"\n135\t                            \"doctor-template-absent.sh\"})\n136\t    write_record(root, \"1\", \"build\", 1, {\"status\": \"failed\"})\n137\t\n138\t    ledger_run = run_attavo(root, \"ledger\", \"1\", \"--json\")\n139\t    assert ledger_run.returncode == 0, ledger_run.stdout + ledger_run.stderr\n140\t    stops_run = run_attavo(root, \"stops\", \"1\", \"--json\")\n141\t    assert stops_run.returncode == 0, stops_run.stdout + stops_run.stderr\n142\t\n143\t    ledger_data = json.loads(ledger_run.stdout)\n144\t    stops_data = json.loads(stops_run.stdout)\n145\t\n146\t    assert len(stops_data[\"rows\"]) == 2\n147\t    assert ledger_data[\"summary\"][\"stops\"] == len(stops_data[\"rows\"])\n148\t\n149\t\n150\tdef test_ledger_marks_a_pre_v018_record_commit_as_record_or_launch(tmp_path):\n151\t    \"\"\"Acceptance row 2: a person's record commit before v0.18.0 prints\n152\t    record-or-launch with the note, never launch or record -- before that\n153\t    version the driver and the executor had no identity of their own to\n154\t    tell a genuine launch apart from an automated one.\"\"\"\n155\t    root = make_tenant(tmp_path, \"ledger_base\")\n156\t    add_spec(root)\n157\t\n158\t    rel = write_record(root, \"1\", \"build\", 1, {\"status\": \"pass\", \"product_version\": \"v0.17.0\"})\n159\t    person_sha = commit_as(root, PERSON, \"manual build record for item 1\", [rel])\n160\t\n161\t    run = run_attavo(root, \"ledger\", \"1\", \"--json\")\n162\t    assert run.returncode == 0, run.stdout + run.stderr\n163\t    data = json.loads(run.stdout)\n164\t\n165\t    row = next(r for r in data[\"rows\"] if r[\"sha\"] == person_sha)\n166\t    assert row[\"class\"] == \"record-or-launch\"\n167\t    assert row[\"note\"] == \"not distinguishable before v0.18.0\"\n168\t    assert data[\"summary\"][\"operator_acts\"] == 0\n169\t    assert data[\"summary\"][\"product_acts\"] == 0\n170\t\n171\t\n172\tdef test_ledger_json_is_one_object_matching_the_text_forms_numbers(tmp_path):\n173\t    \"\"\"Acceptance row 3: --json is one object with rows and summary, and\n174\t    the text form prints the same numbers.\"\"\"\n175\t    root = build_merged_item(tmp_path)\n176\t\n177\t    run_json = run_attavo(root, \"ledger\", \"1\", \"--json\")\n178\t    assert run_json.returncode == 0, run_json.stdout + run_json.stderr\n179\t    data = json.loads(run_json.stdout)\n180\t    assert set(data) == {\"item\", \"rows\", \"summary\"}\n181\t    assert isinstance(data[\"rows\"], list)\n182\t    assert isinstance(data[\"summary\"], dict)\n183\t\n184\t    run_text = run_attavo(root, \"ledger\", \"1\")\n185\t    assert run_text.returncode == 0, run_text.stdout + run_text.stderr\n186\t    summary = data[\"summary\"]\n187\t    assert f\"operator acts: {summary['operator_acts']}\" in run_text.stdout\n188\t    assert f\"product acts: {summary['product_acts']}\" in run_text.stdout\n189\t    assert f\"executor commits: {summary['executor_commits']}\" in run_text.stdout\n190\t    assert f\"stops: {summary['stops']}\" in run_text.stdout\n191\t    assert f\"since: {summary['since']}\" in run_text.stdout\n192\t"}]},"parent_tool_use_id":null,"session_id":"884efe91-ac12-4d2f-991f-d41420d3856c","uuid":"72fe0d30-6f53-4d19-80d2-6ddace54e2c5","timestamp":"2026-09-17T16:35:34.677Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-153/tests/test_ledger.py","content":"\"\"\"attavo ledger: every act on an item by identity and class (issue #128).\n\nRegression tests, written and run red first: on `main` before this change\nthere was no `ledger` subcommand, so every one of these failed with\n\"unknown subcommand\".\n\nRun: python3 -m pytest tests -q\n\"\"\"\nimport json\nimport os\nimport subprocess\nimport sys\nfrom pathlib import Path\n\nfrom helpers import git, make_tenant\n\nROOT = Path(__file__).resolve().parent.parent\nATTAVO = ROOT / \"bin\" / \"attavo\"\n\n# The four identities issue #128 names: a person (writes the spec, in the\n# real templates also the one who comments /approve), the records app (a\n# GitHub App's own bot login -- \"<app-slug>[bot]\" -- that commits\n# spec-gate and approval records in attavo-spec-gate.yml and\n# attavo-approve.yml), the driver (drive's own record commits), and the\n# executor (an adapter invocation's own commits).\nPERSON = {\"name\": \"Alice Author\", \"email\": \"alice@example.com\"}\nRECORDS_APP = {\"name\": \"attavo-bot[bot]\", \"email\": \"123+attavo-bot[bot]@users.noreply.github.com\"}\nDRIVER = {\"name\": \"attavo driver\", \"email\": \"driver@attavo.invalid\"}\nEXECUTOR = {\"name\": \"attavo executor (fixture)\", \"email\": \"executor+fixture@attavo.invalid\"}\n\n\ndef run_attavo(root: Path, *args: str) -> subprocess.CompletedProcess:\n    return subprocess.run([sys.executable, str(ATTAVO), *args], cwd=str(root),\n                          capture_output=True, text=True, check=False)\n\n\ndef commit_as(root: Path, identity: dict, message: str, paths: list[str]) -> str:\n    \"\"\"Stage exactly paths and commit as identity, both author and\n    committer -- the same shape commit_record and the tenant's own CI\n    templates set (never the tenant's ambient git config).\"\"\"\n    git(root, \"add\", *paths)\n    env = dict(os.environ)\n    env[\"GIT_AUTHOR_NAME\"] = env[\"GIT_COMMITTER_NAME\"] = identity[\"name\"]\n    env[\"GIT_AUTHOR_EMAIL\"] = env[\"GIT_COMMITTER_EMAIL\"] = identity[\"email\"]\n    subprocess.run([\"git\", \"-C\", str(root), \"commit\", \"-q\", \"-m\", message],\n                   check=True, env=env)\n    return git(root, \"rev-parse\", \"HEAD\").strip()\n\n\ndef write_record(root: Path, item: str, stage: str, n: int, content: dict) -> str:\n    records_dir = root / \"records\" / item\n    records_dir.mkdir(parents=True, exist_ok=True)\n    path = records_dir / f\"{stage}-{n:02d}.json\"\n    path.write_text(json.dumps(content))\n    return str(path.relative_to(root))\n\n\ndef add_spec(root: Path, item: str = \"1\") -> str:\n    spec_dir = root / \"specs\" / item\n    spec_dir.mkdir(parents=True)\n    (spec_dir / \"spec.md\").write_text(\"## Problem\\n\\nsomething.\\n\")\n    return commit_as(root, PERSON, f\"spec: item {item}\", [f\"specs/{item}\"])\n\n\ndef build_merged_item(tmp_path: Path, item: str = \"1\") -> Path:\n    \"\"\"The order #651 had: a person's spec commit, the records app's\n    spec-gate and approval records, the executor's own change, the\n    driver's build and verify records, then the merge landing all of it\n    on main.\"\"\"\n    root = make_tenant(tmp_path, \"ledger_base\")\n    git(root, \"checkout\", \"-b\", \"item\")\n\n    spec_sha = add_spec(root, item)\n\n    rel = write_record(root, item, \"spec\", 1,\n                       {\"status\": \"pass\", \"spec_sha\": spec_sha, \"product_version\": \"v0.19.1\"})\n    commit_as(root, RECORDS_APP, f\"attavo: spec-gate record for item {item}\", [rel])\n\n    rel = write_record(root, item, \"approval\", 1,\n                       {\"approved_by\": \"alice\", \"sha\": spec_sha, \"spec_sha\": spec_sha,\n                        \"product_version\": \"v0.19.1\"})\n    commit_as(root, RECORDS_APP, f\"attavo: approval record for item {item}\", [rel])\n\n    (root / \"built.txt\").write_text(\"built\\n\")\n    commit_as(root, EXECUTOR, f\"fixture: build item {item}\", [\"built.txt\"])\n\n    rel = write_record(root, item, \"build\", 1, {\"status\": \"pass\", \"product_version\": \"v0.19.1\"})\n    commit_as(root, DRIVER, f\"attavo: build record for item {item} (build-01)\", [rel])\n\n    rel = write_record(root, item, \"verify\", 1, {\"status\": \"pass\", \"product_version\": \"v0.19.1\"})\n    commit_as(root, DRIVER, f\"attavo: verify record for item {item} (verify-01)\", [rel])\n\n    git(root, \"checkout\", \"main\")\n    subprocess.run([\"git\", \"-C\", str(root), \"merge\", \"--no-ff\", \"item\",\n                    \"-m\", f\"Merge pull request #{item} from x/item\"], check=True)\n    return root\n\n\ndef test_ledger_classifies_every_commit_and_counts_operator_acts(tmp_path):\n    \"\"\"Acceptance row 1: on a fixture with the four identities, every\n    commit gets exactly one class and the summary counts operator acts 2\n    -- the same shape tenant zero's own #651 reads (1 approve, 1 merge).\"\"\"\n    root = build_merged_item(tmp_path)\n\n    run = run_attavo(root, \"ledger\", \"1\", \"--json\")\n    assert run.returncode == 0, run.stdout + run.stderr\n    data = json.loads(run.stdout)\n\n    classes = [row[\"class\"] for row in data[\"rows\"]]\n    assert classes == [\"spec\", \"record\", \"approve\", \"change\", \"record\", \"record\", \"merge\"]\n    assert all(row[\"class\"] and row[\"sha\"] and row[\"identity\"] for row in data[\"rows\"])\n\n    summary = data[\"summary\"]\n    assert summary[\"operator_acts\"] == 2\n    assert summary[\"product_acts\"] == 3\n    assert summary[\"executor_commits\"] == 1\n    assert summary[\"stops\"] == 0\n    assert summary[\"since\"] == \"v0.19.1\"\n\n\ndef test_ledger_stops_count_matches_stops_including_a_gate_refusal(tmp_path):\n    \"\"\"Issue #137, acceptance row 2. A refused spec-gate record and a\n    non-pass build record: ledger's own stops count is the same set\n    `attavo stops` counts, gate refusals included -- both computed by\n    item_stops, not two producers reading one item and printing\n    different numbers (tenant zero #683: stops printed 1, ledger printed\n    0, because ledger's own count only ever looked at build and verify).\n    \"\"\"\n    root = make_tenant(tmp_path, \"ledger_base\")\n    add_spec(root)\n\n    write_record(root, \"1\", \"spec\", 1,\n                {\"status\": \"refused\",\n                 \"refusal\": \"criterion fails against the tree plus stub: \"\n                            \"doctor-template-absent.sh\"})\n    write_record(root, \"1\", \"build\", 1, {\"status\": \"failed\"})\n\n    ledger_run = run_attavo(root, \"ledger\", \"1\", \"--json\")\n    assert ledger_run.returncode == 0, ledger_run.stdout + ledger_run.stderr\n    stops_run = run_attavo(root, \"stops\", \"1\", \"--json\")\n    assert stops_run.returncode == 0, stops_run.stdout + stops_run.stderr\n\n    ledger_data = json.loads(ledger_run.stdout)\n    stops_data = json.loads(stops_run.stdout)\n\n    assert len(stops_data[\"rows\"]) == 2\n    assert ledger_data[\"summary\"][\"stops\"] == len(stops_data[\"rows\"])\n\n\ndef test_ledger_marks_a_pre_v018_record_commit_as_record_or_launch(tmp_path):\n    \"\"\"Acceptance row 2: a person's record commit before v0.18.0 prints\n    record-or-launch with the note, never launch or record -- before that\n    version the driver and the executor had no identity of their own to\n    tell a genuine launch apart from an automated one.\"\"\"\n    root = make_tenant(tmp_path, \"ledger_base\")\n    add_spec(root)\n\n    rel = write_record(root, \"1\", \"build\", 1, {\"status\": \"pass\", \"product_version\": \"v0.17.0\"})\n    person_sha = commit_as(root, PERSON, \"manual build record for item 1\", [rel])\n\n    run = run_attavo(root, \"ledger\", \"1\", \"--json\")\n    assert run.returncode == 0, run.stdout + run.stderr\n    data = json.loads(run.stdout)\n\n    row = next(r for r in data[\"rows\"] if r[\"sha\"] == person_sha)\n    assert row[\"class\"] == \"record-or-launch\"\n    assert row[\"note\"] == \"not distinguishable before v0.18.0\"\n    assert data[\"summary\"][\"operator_acts\"] == 0\n    assert data[\"summary\"][\"product_acts\"] == 0\n\n\ndef test_ledger_json_is_one_object_matching_the_text_forms_numbers(tmp_path):\n    \"\"\"Acceptance row 3: --json is one object with rows and summary, and\n    the text form prints the same numbers.\"\"\"\n    root = build_merged_item(tmp_path)\n\n    run_json = run_attavo(root, \"ledger\", \"1\", \"--json\")\n    assert run_json.returncode == 0, run_json.stdout + run_json.stderr\n    data = json.loads(run_json.stdout)\n    assert set(data) == {\"item\", \"rows\", \"summary\"}\n    assert isinstance(data[\"rows\"], list)\n    assert isinstance(data[\"summary\"], dict)\n\n    run_text = run_attavo(root, \"ledger\", \"1\")\n    assert run_text.returncode == 0, run_text.stdout + run_text.stderr\n    summary = data[\"summary\"]\n    assert f\"operator acts: {summary['operator_acts']}\" in run_text.stdout\n    assert f\"product acts: {summary['product_acts']}\" in run_text.stdout\n    assert f\"executor commits: {summary['executor_commits']}\" in run_text.stdout\n    assert f\"stops: {summary['stops']}\" in run_text.stdout\n    assert f\"since: {summary['since']}\" in run_text.stdout\n","numLines":192,"startLine":1,"totalLines":192}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CjPUHD6qQ1LiL8G4cMUkjg","type":"tool_result","content":"300\t\n301\t    def hold(self, reason: str, **extra) -> \"Proof\":\n302\t        self.holds, self.reason = True, reason\n303\t        self.extra.update(extra)\n304\t        return self\n305\t\n306\t    def as_dict(self) -> dict:\n307\t        return {\"proof\": self.key, \"title\": self.title,\n308\t                \"holds\": self.holds, \"reason\": self.reason, **self.extra}\n309\t\n310\t\n311\tdef read_manifest(root: Path) -> dict | None:\n312\t    path = root / MANIFEST\n313\t    if not path.is_file():\n314\t        return None\n315\t    with path.open(\"rb\") as fh:\n316\t        return tomllib.load(fh)\n317\t\n318\t\n319\tdef git(root: Path, *args: str, env: dict | None = None) -> str:\n320\t    out = subprocess.run([\"git\", \"-C\", str(root), *args],\n321\t                         capture_output=True, text=True, check=False, env=env)\n322\t    if out.returncode != 0:\n323\t        raise RuntimeError(out.stderr.strip() or \"git failed\")\n324\t    return out.stdout\n325\t\n326\t\n327\tdef product_version() -> str:\n328\t    \"\"\"What the running program is. Three fallbacks, in order, and never an\n329\t    exception -- this runs inside write_record, after the work it\n330\t    describes already happened, and a raise here would lose the record\n331\t    for an invocation that already ran:\n332\t\n333\t      1. ATTAVO_PRODUCT_VERSION, when the environment sets it. The forge\n334\t         action sets this from its own ref (action.yml, not here -- this\n335\t         function stays forge-agnostic).\n336\t      2. git describe --tags --always --dirty against PRODUCT_ROOT: a\n337\t         tagged release reports its tag, a checkout reports its commit,\n338\t         a dirty tree says so.\n339\t      3. \"unknown\", when PRODUCT_ROOT is not a git repository at all --\n340\t         the case for a forge that extracts this action from a tarball\n341\t         rather than a git checkout, which is exactly when (1) is\n342\t         expected to already have supplied the answer.\n343\t\n344\t    Distinct from the tenant's product_pin -- an operator running a\n345\t    checkout, which is how every build and verify have actually been run\n346\t    so far, bypasses the pin entirely (issue #49).\"\"\"\n347\t    env = os.environ.get(\"ATTAVO_PRODUCT_VERSION\")\n348\t    if env:\n349\t        return env\n350\t    try:\n351\t        return git(PRODUCT_ROOT, \"describe\", \"--tags\", \"--always\", \"--dirty\").strip()\n352\t    except RuntimeError:\n353\t        return \"unknown\"\n354\t\n355\t\n356\tdef now_iso() -> str:\n357\t    return datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n358\t\n359\t\n360\tdef derive_item_id(root: Path) -> str | None:\n361\t    \"\"\"ATTAVO_ITEM first, not last: a rejection fixture's own item id must\n362\t    win over whatever attavo/N-* branch the enclosing tenant repository\n363\t    happens to be checked out on -- the common case is doctor running from\n364\t    a real item's own branch, where a fallback-only env var would never be\n365\t    consulted at all and every gate fixture would silently resolve to the\n366\t    real item instead of its own.\"\"\"\n367\t    env_item = os.environ.get(\"ATTAVO_ITEM\")\n368\t    if env_item:\n369\t        return env_item\n370\t    out = subprocess.run([\"git\", \"-C\", str(root), \"rev-parse\", \"--abbrev-ref\", \"HEAD\"],\n371\t                         capture_output=True, text=True, check=False)\n372\t    branch = out.stdout.strip()\n373\t    m = re.match(r\"^attavo/(\\d+)-\", branch)\n374\t    return m.group(1) if m else None\n375\t\n376\t\n377\tdef fixture_item_id(fixture: Path) -> str | None:\n378\t    \"\"\"The one item id under a rejection fixture's own paths.specs, so the\n379\t    doctor can export it as ATTAVO_ITEM: a fixture carries no attavo/N-*\n380\t    branch for a gate command with no argument to derive from otherwise.\"\"\"\n381\t    fm = read_manifest(fixture)\n382\t    specs_rel = ((fm or {}).get(\"paths\") or {}).get(\"specs\")\n383\t    if not specs_rel:\n384\t        return None\n385\t    specs_dir = fixture / specs_rel\n386\t    if not specs_dir.is_dir():\n387\t        return None\n388\t    items = sorted(p.name for p in specs_dir.iterdir() if p.is_dir())\n389\t    return items[0] if len(items) == 1 else None\n390\t\n391\t\n392\tclass ShallowCheckoutError(RuntimeError):\n393\t    pass\n394\t\n395\t\n396\tdef last_commit_touching(root: Path, relpath: str) -> str | None:\n397\t    shallow = subprocess.run([\"git\", \"-C\", str(root), \"rev-parse\", \"--is-shallow-repository\"],\n398\t                             capture_output=True, text=True, check=False)\n399\t    if shallow.stdout.strip() == \"true\":\n400\t        raise ShallowCheckoutError(\n401\t            \"shallow checkout: git log -1 -- <path> returns HEAD for every path on a \"\n402\t            \"shallow clone; check out with fetch-depth: 0\")\n403\t    out = subprocess.run([\"git\", \"-C\", str(root), \"log\", \"-1\", \"--format=%H\", \"--\", relpath],\n404\t                         capture_output=True, text=True, check=False)\n405\t    sha = out.stdout.strip()\n406\t    return sha or None\n407\t\n408\t\n409\t# --- record files: <stage>-NN.json, one per attempt, never overwritten ---\n410\t\n411\tSCHEMA_RECORDS_DIR = PRODUCT_ROOT / \"schema\" / \"records\"\n412\t\n413\t\n414\tdef stage_schema(stage: str) -> dict:\n415\t    \"\"\"schema/records/<stage>.schema.json -- this repository's own\n416\t    declaration of that stage's record shape (issue #60). The only\n417\t    artifact the outbound contract needs; there is no accessor for it\n418\t    beyond reading the file.\"\"\"\n419\t    return json.loads((SCHEMA_RECORDS_DIR / f\"{stage}.schema.json\").read_text())\n420\t\n421\t\n422\tdef schema_id_version(schema: dict) -> int:\n423\t    \"\"\"The trailing integer of a schema's $id (\".../records/build/2\"
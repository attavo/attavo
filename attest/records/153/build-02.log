{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PPE3q4aseMaMWA6huVdx3G","type":"tool_result","content":"3095\t\n3096\t\n3097\tdef _commit_touches(root: Path, sha: str) -> list[str]:\n3098\t    return git(root, \"diff\", \"--name-only\", f\"{sha}^1\", sha).splitlines()\n3099\t\n3100\t\n3101\tdef _record_at(root: Path, sha: str, relpath: str, item_id: str) -> dict:\n3102\t    \"\"\"A record's own dict at a past commit, not the working tree --\n3103\t    ledger's only need for one (issue #128). Read through _load_record\n3104\t    (issue #60, acceptance 6: the one place a record's bytes become a\n3105\t    dict) by spilling the blob to a throwaway file, rather than a second\n3106\t    json.loads of its own: `git show` has no path on disk to hand\n3107\t    _load_record directly.\"\"\"\n3108\t    out = subprocess.run([\"git\", \"-C\", str(root), \"show\", f\"{sha}:{relpath}\"],\n3109\t                         capture_output=True, text=True, check=False)\n3110\t    if out.returncode != 0:\n3111\t        return {}\n3112\t    with tempfile.NamedTemporaryFile(\"w\", suffix=\".json\", delete=False) as fh:\n3113\t        fh.write(out.stdout)\n3114\t        blob_path = Path(fh.name)\n3115\t    try:\n3116\t        return _load_record(blob_path, item_id)\n3117\t    except json.JSONDecodeError:\n3118\t        return {}\n3119\t    finally:\n3120\t        blob_path.unlink(missing_ok=True)\n3121\t\n3122\t\n3123\tdef item_ledger(root: Path, m: dict, item_id: str) -> dict:\n3124\t    \"\"\"{\"item\", \"rows\", \"summary\"}: one row per act between item_id's first\n3125\t    spec commit and its merge (merge_introducing_records, the same\n3126\t    derivation doctor's proof two and attest both already read) or HEAD\n3127\t    when the item has not merged yet.\n3128\t\n3129\t    Each commit gets exactly one class, in this order: the merge commit\n3130\t    itself is \"merge\"; a commit authored by the executor identity\n3131\t    (executor_identity) is \"change\"; a commit introducing an approval\n3132\t    record is \"approve\", whoever committed it -- an operator's decision,\n3133\t    however it reached git; a commit introducing a spec-gate, build, or\n3134\t    verify record, authored by the driver identity (driver_identity) or\n3135\t    the records app, is \"record\"; the same, authored by a person, is\n3136\t    \"launch\" for build or verify (spec-gate records the app always\n3137\t    commits, in every template this product ships) -- unless that\n3138\t    record's own product_version predates v0.18.0, when driver_identity\n3139\t    did not yet exist to tell the two apart, and the row is\n3140\t    \"record-or-launch\" with a note, counted in neither summary total\n3141\t    rather than guessed; a person's commit touching the spec is \"spec\"\n3142\t    before the first approval record and \"amend\" after; anything else by\n3143\t    a person is \"transport\" (a merge of main among them).\"\"\"\n3144\t    specs_rel = m[\"paths\"][\"specs\"]\n3145\t    records_rel = m[\"paths\"][\"records\"]\n3146\t    specs_prefix = f\"{specs_rel.rstrip('/')}/{item_id}/\"\n3147\t    records_prefix = f\"{records_rel.rstrip('/')}/{item_id}/\"\n3148\t    empty_summary = {\"operator_acts\": 0, \"product_acts\": 0, \"executor_commits\": 0,\n3149\t                     \"stops\": 0, \"since\": None}\n3150\t\n3151\t    first_spec_sha = first_commit_touching(root, str(Path(specs_rel) / item_id))\n3152\t    if first_spec_sha is None:\n3153\t        return {\"item\": item_id, \"rows\": [], \"summary\": empty_summary}\n3154\t\n3155\t    merge_sha = merge_introducing_records(root, records_rel, item_id, STAGES)\n3156\t    if merge_sha is not None:\n3157\t        branch_tip = git(root, \"rev-parse\", f\"{merge_sha}^2\").strip()\n3158\t        commits = commits_since(root, f\"{first_spec_sha}^\", end=branch_tip)\n3159\t        commits += commits_since(root, f\"{merge_sha}^1\", end=merge_sha)\n3160\t    else:\n3161\t        commits = commits_since(root, f\"{first_spec_sha}^\", end=\"HEAD\")\n3162\t\n3163\t    driver = driver_identity()\n3164\t    rows: list[dict] = []\n3165\t    operator_acts = product_acts = executor_commits = 0\n3166\t    since = None\n3167\t    approval_seen = False\n3168\t\n3169\t    for c in commits:\n3170\t        sha, name, email = c[\"sha\"], c[\"name\"], c[\"email\"]\n3171\t\n3172\t        if merge_sha is not None and sha == merge_sha:\n3173\t            rows.append({\"sha\": sha, \"identity\": name, \"class\": \"merge\"})\n3174\t            operator_acts += 1\n3175\t            continue\n3176\t\n3177\t        if email.startswith(\"executor+\") and email.endswith(\"@attavo.invalid\"):\n3178\t            rows.append({\"sha\": sha, \"identity\": name, \"class\": \"change\"})\n3179\t            executor_commits += 1\n3180\t            continue\n3181\t\n3182\t        touched = _commit_touches(root, sha)\n3183\t        record_touch = None\n3184\t        for p in touched:\n3185\t            if not p.startswith(records_prefix):\n3186\t                continue\n3187\t            rm = RECORD_RE.match(Path(p).name)\n3188\t            if rm and rm.group(1) in STAGES:\n3189\t                record_touch = (rm.group(1), p)\n3190\t                break\n3191\t\n3192\t        if record_touch is not None:\n3193\t            stage, relpath = record_touch\n3194\t            content = _record_at(root, sha, relpath, item_id)\n3195\t            if since is None:\n3196\t                since = content.get(\"product_version\")\n3197\t\n3198\t            if stage == \"approval\":\n3199\t                rows.append({\"sha\": sha, \"identity\": name, \"class\": \"approve\"})\n3200\t                operator_acts += 1\n3201\t                approval_seen = True\n3202\t                continue\n3203\t\n3204\t            is_driver = name == driver[\"name\"] and email == driver[\"email\"]\n3205\t            is_records_app = _is_records_app(name)\n3206\t            if stage == \"spec\" or is_driver or is_records_app:\n3207\t                rows.append({\"sha\": sha, \"identity\": name, \"class\": \"record\"})\n3208\t                product_acts += 1\n3209\t                continue\n3210\t\n3211\t            version = _semver_tuple(content.get(\"product_version\"))\n3212\t            if version is not None and version < LEDGER_V018_CUTOFF:\n3213\t                rows.append({\"sha\": sha, \"identity\": name, \"class\": \"record-or-launch\",\n3214\t                            \"note\": \"not distinguishable before v0.18.0\"})\n3215\t                continue\n3216\t\n3217\t            rows.append({\"sha\": sha, \"identity\": name, \"class\": \"launch\"})\n3218\t            operator_acts += 1\n3219\t            continue\n3220\t\n3221\t        if any(p.startswith(specs_prefix) for p in touched):\n3222\t            cls = \"amend\" if approval_seen else \"spec\"\n3223\t            rows.append({\"sha\": sha, \"identity\": name, \"class\": cls})\n3224\t            if cls == \"amend\":\n3225\t                operator_acts += 1\n3226\t            continue\n3227\t\n3228\t        rows.append({\"sha\": sha, \"identity\": name, \"class\": \"transport\"})\n3229\t        operator_acts += 1\n3230\t\n3231\t    # issue #137: the same set attavo stops counts, from the same reader\n3232\t    # (item_stops) -- not a second, independent count kept in sync by\n3233\t    # hand. One non-pass record per row, whatever its stage; a gate\n3234\t    # refusal is included the same as a non-pass build or verify record.\n3235\t    stops = len(item_stops(root, m, item_id)[\"rows\"])\n3236\t\n3237\t    summary = {\"operator_acts\": operator_acts, \"product_acts\": product_acts,\n3238\t              \"executor_commits\": executor_commits, \"stops\": stops, \"since\": since}\n3239\t    return {\"item\": item_id, \"rows\": rows, \"summary\": summary}\n3240\t\n3241\t\n3242\tdef cmd_ledger(argv: list[str]) -> int:\n3243\t    as_json = \"--json\" in argv\n3244\t    positional = [a for a in argv if a != \"--json\"]"}]},"parent_tool_use_id":null,"session_id":"884efe91-ac12-4d2f-991f-d41420d3856c","uuid":"5da75dfc-9bf4-4b77-a8eb-b9e6256e736b","timestamp":"2026-09-17T16:39:14.565Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-153/bin/attavo","content":"\n\ndef _commit_touches(root: Path, sha: str) -> list[str]:\n    return git(root, \"diff\", \"--name-only\", f\"{sha}^1\", sha).splitlines()\n\n\ndef _record_at(root: Path, sha: str, relpath: str, item_id: str) -> dict:\n    \"\"\"A record's own dict at a past commit, not the working tree --\n    ledger's only need for one (issue #128). Read through _load_record\n    (issue #60, acceptance 6: the one place a record's bytes become a\n    dict) by spilling the blob to a throwaway file, rather than a second\n    json.loads of its own: `git show` has no path on disk to hand\n    _load_record directly.\"\"\"\n    out = subprocess.run([\"git\", \"-C\", str(root), \"show\", f\"{sha}:{relpath}\"],\n                         capture_output=True, text=True, check=False)\n    if out.returncode != 0:\n        return {}\n    with tempfile.NamedTemporaryFile(\"w\", suffix=\".json\", delete=False) as fh:\n        fh.write(out.stdout)\n        blob_path = Path(fh.name)\n    try:\n        return _load_record(blob_path, item_id)\n    except json.JSONDecodeError:\n        return {}\n    finally:\n        blob_path.unlink(missing_ok=True)\n\n\ndef item_ledger(root: Path, m: dict, item_id: str) -> dict:\n    \"\"\"{\"item\", \"rows\", \"summary\"}: one row per act between item_id's first\n    spec commit and its merge (merge_introducing_records, the same\n    derivation doctor's proof two and attest both already read) or HEAD\n    when the item has not merged yet.\n\n    Each commit gets exactly one class, in this order: the merge commit\n    itself is \"merge\"; a commit authored by the executor identity\n    (executor_identity) is \"change\"; a commit introducing an approval\n    record is \"approve\", whoever committed it -- an operator's decision,\n    however it reached git; a commit introducing a spec-gate, build, or\n    verify record, authored by the driver identity (driver_identity) or\n    the records app, is \"record\"; the same, authored by a person, is\n    \"launch\" for build or verify (spec-gate records the app always\n    commits, in every template this product ships) -- unless that\n    record's own product_version predates v0.18.0, when driver_identity\n    did not yet exist to tell the two apart, and the row is\n    \"record-or-launch\" with a note, counted in neither summary total\n    rather than guessed; a person's commit touching the spec is \"spec\"\n    before the first approval record and \"amend\" after; anything else by\n    a person is \"transport\" (a merge of main among them).\"\"\"\n    specs_rel = m[\"paths\"][\"specs\"]\n    records_rel = m[\"paths\"][\"records\"]\n    specs_prefix = f\"{specs_rel.rstrip('/')}/{item_id}/\"\n    records_prefix = f\"{records_rel.rstrip('/')}/{item_id}/\"\n    empty_summary = {\"operator_acts\": 0, \"product_acts\": 0, \"executor_commits\": 0,\n                     \"stops\": 0, \"since\": None}\n\n    first_spec_sha = first_commit_touching(root, str(Path(specs_rel) / item_id))\n    if first_spec_sha is None:\n        return {\"item\": item_id, \"rows\": [], \"summary\": empty_summary}\n\n    merge_sha = merge_introducing_records(root, records_rel, item_id, STAGES)\n    if merge_sha is not None:\n        branch_tip = git(root, \"rev-parse\", f\"{merge_sha}^2\").strip()\n        commits = commits_since(root, f\"{first_spec_sha}^\", end=branch_tip)\n        commits += commits_since(root, f\"{merge_sha}^1\", end=merge_sha)\n    else:\n        commits = commits_since(root, f\"{first_spec_sha}^\", end=\"HEAD\")\n\n    driver = driver_identity()\n    rows: list[dict] = []\n    operator_acts = product_acts = executor_commits = 0\n    since = None\n    approval_seen = False\n\n    for c in commits:\n        sha, name, email = c[\"sha\"], c[\"name\"], c[\"email\"]\n\n        if merge_sha is not None and sha == merge_sha:\n            rows.append({\"sha\": sha, \"identity\": name, \"class\": \"merge\"})\n            operator_acts += 1\n            continue\n\n        if email.startswith(\"executor+\") and email.endswith(\"@attavo.invalid\"):\n            rows.append({\"sha\": sha, \"identity\": name, \"class\": \"change\"})\n            executor_commits += 1\n            continue\n\n        touched = _commit_touches(root, sha)\n        record_touch = None\n        for p in touched:\n            if not p.startswith(records_prefix):\n                continue\n            rm = RECORD_RE.match(Path(p).name)\n            if rm and rm.group(1) in STAGES:\n                record_touch = (rm.group(1), p)\n                break\n\n        if record_touch is not None:\n            stage, relpath = record_touch\n            content = _record_at(root, sha, relpath, item_id)\n            if since is None:\n                since = content.get(\"product_version\")\n\n            if stage == \"approval\":\n                rows.append({\"sha\": sha, \"identity\": name, \"class\": \"approve\"})\n                operator_acts += 1\n                approval_seen = True\n                continue\n\n            is_driver = name == driver[\"name\"] and email == driver[\"email\"]\n            is_records_app = _is_records_app(name)\n            if stage == \"spec\" or is_driver or is_records_app:\n                rows.append({\"sha\": sha, \"identity\": name, \"class\": \"record\"})\n                product_acts += 1\n                continue\n\n            version = _semver_tuple(content.get(\"product_version\"))\n            if version is not None and version < LEDGER_V018_CUTOFF:\n                rows.append({\"sha\": sha, \"identity\": name, \"class\": \"record-or-launch\",\n                            \"note\": \"not distinguishable before v0.18.0\"})\n                continue\n\n            rows.append({\"sha\": sha, \"identity\": name, \"class\": \"launch\"})\n            operator_acts += 1\n            continue\n\n        if any(p.startswith(specs_prefix) for p in touched):\n            cls = \"amend\" if approval_seen else \"spec\"\n            rows.append({\"sha\": sha, \"identity\": name, \"class\": cls})\n            if cls == \"amend\":\n                operator_acts += 1\n            continue\n\n        rows.append({\"sha\": sha, \"identity\": name, \"class\": \"transport\"})\n        operator_acts += 1\n\n    # issue #137: the same set attavo stops counts, from the same reader\n    # (item_stops) -- not a second, independent count kept in sync by\n    # hand. One non-pass record per row, whatever its stage; a gate\n    # refusal is included the same as a non-pass build or verify record.\n    stops = len(item_stops(root, m, item_id)[\"rows\"])\n\n    summary = {\"operator_acts\": operator_acts, \"product_acts\": product_acts,\n              \"executor_commits\": executor_commits, \"stops\": stops, \"since\": since}\n    return {\"item\": item_id, \"rows\": rows, \"summary\": summary}\n\n\ndef cmd_ledger(argv: list[str]) -> int:\n    as_json = \"--json\" in argv\n    positional = [a for a in argv if a != \"--json\"]","numLines":150,"startLine":3095,"totalLines":3437}}}

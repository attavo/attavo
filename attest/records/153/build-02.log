{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01A5LYDQN7KtUyjUQP6AkQBb","type":"tool_result","content":"700\t               \"detail\": None}\n701\t    if log and any(marker in log.lower() for marker in CEILING_MARKERS):\n702\t        return {\"class\": \"ceiling\", \"provenance\": \"product\", \"detail\": None}\n703\t    return {\"class\": \"unclassed\", \"provenance\": \"product\", \"detail\": _log_last_line(log)}\n704\t\n705\t\n706\tdef gate_stop(refusal: str | None) -> dict:\n707\t    \"\"\"The stop for a refused spec-gate record: class \"gate\", provenance\n708\t    \"spec\", the refusal string itself as cause (issue #137) -- not\n709\t    derive_stop's generic claims-boundary/spec fallback issue #133\n710\t    reused, which named a boundary the record never crossed: \"criterion\n711\t    fails against the tree plus stub: doctor-template-absent.sh\" is not\n712\t    a write outside claims. cmd_spec_gate is untouched by this lane, so\n713\t    a spec record still carries no stop field of its own; this is\n714\t    synthesized wherever a refused one is read (item_stops,\n715\t    cmd_file_stops, proof_no_stop_lacks_cause), never persisted.\"\"\"\n716\t    return {\"class\": \"gate\", \"provenance\": \"spec\", \"detail\": refusal}\n717\t\n718\t\n719\tdef load_records(records_dir: Path) -> dict[str, dict[str, dict]]:\n720\t    \"\"\"{item_id: {stage: latest_record}} for every <records>/<item>/<stage>-NN.json.\"\"\"\n721\t    items: dict[str, dict[str, dict]] = {}\n722\t    if not records_dir.is_dir():\n723\t        return items\n724\t    for item_dir in sorted(p for p in records_dir.iterdir() if p.is_dir()):\n725\t        by_stage: dict[str, dict[int, dict]] = {}\n726\t        for rec in sorted(item_dir.glob(\"*.json\")):\n727\t            m = RECORD_RE.match(rec.name)\n728\t            if not m:\n729\t                continue\n730\t            stage, n = m.group(1), int(m.group(2))\n731\t            try:\n732\t                data = _load_record(rec, item_dir.name)\n733\t            except json.JSONDecodeError:\n734\t                continue\n735\t            by_stage.setdefault(stage, {})[n] = data\n736\t        items[item_dir.name] = {stage: attempts[max(attempts)] for stage, attempts in by_stage.items()}\n737\t    return items\n738\t\n739\t\n740\t# --- doctor's three proofs ---\n741\t\n742\tdef proof_every_gate_rejects(root: Path, m: dict | None) -> Proof:\n743\t    p = Proof(\"every-gate-rejects\", \"every gate rejects its fixture\")\n744\t    if m is None:\n745\t        return p.fail(f\"no {MANIFEST} at {root}; no gate is registered\")\n746\t    gates = m.get(\"gates\") or {}\n747\t    if not gates:\n748\t        return p.fail(\"[gates] is empty; a gate that has rejected nothing does not exist\")\n749\t    fixtures = root / m.get(\"paths\", {}).get(\"rejections\", \"\")\n750\t    # Proposal, not yet ruled on (issue #54): a gate that retires nothing\n751\t    # only adds, so proof one reports it here rather than waiting on the\n752\t    # schema alone -- read_manifest never validates against the manifest\n753\t    # schema at runtime, so a schema requirement is not an enforced one.\n754\t    no_retires = [name for name, gate in sorted(gates.items()) if not gate.get(\"retires\")]\n755\t    missing, accepted = [], []\n756\t    for name, gate in sorted(gates.items()):\n757\t        fixture = fixtures / name\n758\t        if not fixture.is_dir():\n759\t            missing.append(name)\n760\t            continue\n761\t        env = dict(os.environ)\n762\t        item = fixture_item_id(fixture)\n763\t        if item is not None:\n764\t            env[\"ATTAVO_ITEM\"] = item\n765\t        run = subprocess.run(gate[\"command\"], shell=True, cwd=str(fixture),\n766\t                             capture_output=True, text=True, check=False, env=env)\n767\t        if run.returncode == 0:\n768\t            accepted.append(name)\n769\t    if missing:\n770\t        return p.fail(f\"gate(s) with no rejection fixture: {', '.join(missing)}\")\n771\t    if accepted:\n772\t        return p.fail(f\"gate(s) that accepted their rejection fixture: {', '.join(accepted)}\")\n773\t    if no_retires:\n774\t        return p.fail(f\"gate(s) with no retires: {', '.join(no_retires)}\")\n775\t    return p.hold(f\"{len(gates)} gate(s) rejected their fixture\")\n776\t\n777\t\n778\tdef merge_introducing_records(root: Path, records_rel: str, item: str,\n779\t                              stages: tuple[str, ...]) -> str | None:\n780\t    \"\"\"The merge commit reachable from HEAD whose first-parent diff\n781\t    introduces a record for every one of stages, under\n782\t    records_rel/item/ -- the same derivation attest itself uses\n783\t    (derive_attest_items), read here so proof two requires an item's\n784\t    stage records to have arrived by an actual merge, not merely to sit\n785\t    in the tree (issue #69, acceptance row 4).\"\"\"\n786\t    try:\n787\t        merges = git(root, \"log\", \"--merges\", \"--format=%H\", \"HEAD\").split()\n788\t    except RuntimeError:\n789\t        return None\n790\t    prefix = f\"{records_rel.rstrip('/')}/{item}/\"\n791\t    for sha in merges:\n792\t        try:\n793\t            diff = git(root, \"diff\", \"--name-only\", f\"{sha}^1\", sha).splitlines()\n794\t        except RuntimeError:\n795\t            continue\n796\t        found: set[str] = set()\n797\t        for p in diff:\n798\t            if p.startswith(prefix):\n799\t                m = RECORD_RE.match(Path(p).name)\n800\t                if m:\n801\t                    found.add(m.group(1))\n802\t        if all(s in found for s in stages):\n803\t            return sha\n804\t    return None\n805\t\n806\t\n807\tdef proof_one_item_every_stage(root: Path, m: dict | None) -> Proof:\n808\t    p = Proof(\"one-item-every-stage\", \"one item has traversed every stage\")\n809\t    if m is None:\n810\t        return p.fail(f\"no {MANIFEST} at {root}; no records directory is declared\")\n811\t    records_rel = m.get(\"paths\", {}).get(\"records\", \"\")\n812\t    records_dir = root / records_rel\n813\t    items = load_records(records_dir)\n814\t    if not items:\n815\t        return p.fail(f\"no work item under {records_dir.relative_to(root)}\")\n816\t    complete = [item for item, stages in items.items() if all(s in stages for s in STAGES)]\n817\t    if not complete:\n818\t        best = max(items.items(), key=lambda kv: len(kv[1]))\n819\t        lacking = [s for s in STAGES if s not in best[1]]\n820\t        return p.fail(f\"no item carries every stage; item {best[0]} lacks {', '.join(lacking)}\")\n821\t\n822\t    # issue #74: a complete item is counted only when its chain holds --\n823\t    # attavo attest refuses a build re-approved after the fact or a\n824\t    # verify whose build went stale, and the coherence gate refuses the\n825\t    # merge group on exactly that; a proof that never asked would call a\n826\t    # traversal the gate itself would not let through. The refusal text\n827\t    # is check_attest_chain's own, never re-typed here.\n828\t    refused, held, unmerged = [], [], []\n829\t    for item in complete:\n830\t        chain, message = check_attest_chain(records_dir / item, item)\n831\t        if chain is None:\n832\t            refused.append(f\"item {item}: {message}\")\n833\t            continue\n834\t        merge_sha = merge_introducing_records(root, records_rel, item, STAGES)\n835\t        if merge_sha:\n836\t            held.append((item, merge_sha))\n837\t        else:\n838\t            unmerged.append(item)\n839\t\n840\t    if held:\n841\t        names = \", \".join(item for item, _ in held)\n842\t        shas = \", \".join(sha[:12] for _, sha in held)\n843\t        return p.hold(f\"item(s) {names} carry {', '.join(STAGES)} with the chain held, \"\n844\t                      f\"merged at {shas}\")\n845\t    if refused:\n846\t        return p.fail(\"; \".join(refused))\n847\t    return p.fail(f\"item(s) {', '.join(unmerged)} carry every stage with the chain held but no \"\n848\t                  f\"merge commit's first-parent diff introduces all of them\")\n849\t\n850\t\n851\tdef commit_subject(root: Path, sha: str) -> str:\n852\t    return git(root, \"log\", \"-1\", \"--format=%s\", sha).strip()\n853\t\n854\t\n855\tdef touches_boundary(root: Path, sha: str, boundary_paths: list[str]) -> bool:\n856\t    \"\"\"Whether sha's first-parent diff touches a path [spec.boundary].paths\n857\t    declares governed -- an ordinary merge that does is a boundary\n858\t    evasion (issue #72): the tenant carried a governed change around the\n859\t    path the manifest itself names.\"\"\"\n860\t    diff = git(root, \"diff\", \"--name-only\", f\"{sha}^1\", sha).splitlines()\n861\t    return any(fnmatch.fnmatch(path, pattern) for path in diff for pattern in boundary_paths)\n862\t\n863\t\n864\tdef proof_no_commit_lacks_record(root: Path, m: dict | None) -> Proof:\n865\t    p = Proof(\"no-commit-lacks-record\", \"no commit lacks a record\")\n866\t    if m is None:\n867\t        return p.fail(f\"no {MANIFEST} at {root}; the tenant has no record boundary\")\n868\t    try:\n869\t        install = git(root, \"log\", \"--diff-filter=A\", \"--format=%H\",\n870\t                      \"--reverse\", \"--\", MANIFEST).split()\n871\t    except RuntimeError as exc:\n872\t        return p.fail(f\"git: {exc}\")\n873\t    if not install:\n874\t        return p.fail(f\"{MANIFEST} is not committed; the tenant has no record boundary\")\n875\t    install_sha = install[0]\n876\t    full_chain = git(root, \"rev-list\", f\"{install_sha}..HEAD\", \"--first-parent\").split()\n877\t    if not full_chain:\n878\t        return p.fail(f\"no commit after the install commit {install_sha[:12]}; nothing has been recorded\")\n879\t\n880\t    # issue #74: [doctor] from lets a tenant declare the doctor's read to\n881\t    # start at a later commit on main's first-parent line -- the point\n882\t    # after which every push arrived through the queue -- rather than the\n883\t    # install commit, which on a repository that adopted the product\n884\t    # after its history began is a boundary the doctor cannot otherwise\n885\t    # see. Any spelling git resolves is accepted (a short sha, a tag, a\n886\t    # ref) -- resolved with rev-parse --verify before the first-parent\n887\t    # check runs, so the two failure modes stay distinct: a spelling that\n888\t    # names no commit at all, and a commit that names one off the line.\n889\t    # Checked, not trusted: neither is silently forgiven back to install.\n890\t    declared_from = (m.get(\"doctor\") or {}).get(\"from\")\n891\t    window_start = install_sha\n892\t    if declared_from is not None:\n893\t        try:\n894\t            resolved_from = git(root, \"rev-parse\", \"--verify\", f\"{declared_from}^{{commit}}\").strip()\n895\t        except RuntimeError:\n896\t            return p.fail(f\"[doctor] from {declared_from} does not resolve to a commit\")\n897\t        if resolved_from != install_sha and resolved_from not in full_chain:\n898\t            return p.fail(f\"[doctor] from {declared_from} is not on main's first-parent \"\n899\t                          f\"line after the install commit {install_sha[:12]}\")"}]},"parent_tool_use_id":null,"session_id":"884efe91-ac12-4d2f-991f-d41420d3856c","uuid":"d18b61c9-1a9c-4a70-9f9c-0a1a683fd4df","timestamp":"2026-09-17T16:33:30.540Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-153/bin/attavo","content":"               \"detail\": None}\n    if log and any(marker in log.lower() for marker in CEILING_MARKERS):\n        return {\"class\": \"ceiling\", \"provenance\": \"product\", \"detail\": None}\n    return {\"class\": \"unclassed\", \"provenance\": \"product\", \"detail\": _log_last_line(log)}\n\n\ndef gate_stop(refusal: str | None) -> dict:\n    \"\"\"The stop for a refused spec-gate record: class \"gate\", provenance\n    \"spec\", the refusal string itself as cause (issue #137) -- not\n    derive_stop's generic claims-boundary/spec fallback issue #133\n    reused, which named a boundary the record never crossed: \"criterion\n    fails against the tree plus stub: doctor-template-absent.sh\" is not\n    a write outside claims. cmd_spec_gate is untouched by this lane, so\n    a spec record still carries no stop field of its own; this is\n    synthesized wherever a refused one is read (item_stops,\n    cmd_file_stops, proof_no_stop_lacks_cause), never persisted.\"\"\"\n    return {\"class\": \"gate\", \"provenance\": \"spec\", \"detail\": refusal}\n\n\ndef load_records(records_dir: Path) -> dict[str, dict[str, dict]]:\n    \"\"\"{item_id: {stage: latest_record}} for every <records>/<item>/<stage>-NN.json.\"\"\"\n    items: dict[str, dict[str, dict]] = {}\n    if not records_dir.is_dir():\n        return items\n    for item_dir in sorted(p for p in records_dir.iterdir() if p.is_dir()):\n        by_stage: dict[str, dict[int, dict]] = {}\n        for rec in sorted(item_dir.glob(\"*.json\")):\n            m = RECORD_RE.match(rec.name)\n            if not m:\n                continue\n            stage, n = m.group(1), int(m.group(2))\n            try:\n                data = _load_record(rec, item_dir.name)\n            except json.JSONDecodeError:\n                continue\n            by_stage.setdefault(stage, {})[n] = data\n        items[item_dir.name] = {stage: attempts[max(attempts)] for stage, attempts in by_stage.items()}\n    return items\n\n\n# --- doctor's three proofs ---\n\ndef proof_every_gate_rejects(root: Path, m: dict | None) -> Proof:\n    p = Proof(\"every-gate-rejects\", \"every gate rejects its fixture\")\n    if m is None:\n        return p.fail(f\"no {MANIFEST} at {root}; no gate is registered\")\n    gates = m.get(\"gates\") or {}\n    if not gates:\n        return p.fail(\"[gates] is empty; a gate that has rejected nothing does not exist\")\n    fixtures = root / m.get(\"paths\", {}).get(\"rejections\", \"\")\n    # Proposal, not yet ruled on (issue #54): a gate that retires nothing\n    # only adds, so proof one reports it here rather than waiting on the\n    # schema alone -- read_manifest never validates against the manifest\n    # schema at runtime, so a schema requirement is not an enforced one.\n    no_retires = [name for name, gate in sorted(gates.items()) if not gate.get(\"retires\")]\n    missing, accepted = [], []\n    for name, gate in sorted(gates.items()):\n        fixture = fixtures / name\n        if not fixture.is_dir():\n            missing.append(name)\n            continue\n        env = dict(os.environ)\n        item = fixture_item_id(fixture)\n        if item is not None:\n            env[\"ATTAVO_ITEM\"] = item\n        run = subprocess.run(gate[\"command\"], shell=True, cwd=str(fixture),\n                             capture_output=True, text=True, check=False, env=env)\n        if run.returncode == 0:\n            accepted.append(name)\n    if missing:\n        return p.fail(f\"gate(s) with no rejection fixture: {', '.join(missing)}\")\n    if accepted:\n        return p.fail(f\"gate(s) that accepted their rejection fixture: {', '.join(accepted)}\")\n    if no_retires:\n        return p.fail(f\"gate(s) with no retires: {', '.join(no_retires)}\")\n    return p.hold(f\"{len(gates)} gate(s) rejected their fixture\")\n\n\ndef merge_introducing_records(root: Path, records_rel: str, item: str,\n                              stages: tuple[str, ...]) -> str | None:\n    \"\"\"The merge commit reachable from HEAD whose first-parent diff\n    introduces a record for every one of stages, under\n    records_rel/item/ -- the same derivation attest itself uses\n    (derive_attest_items), read here so proof two requires an item's\n    stage records to have arrived by an actual merge, not merely to sit\n    in the tree (issue #69, acceptance row 4).\"\"\"\n    try:\n        merges = git(root, \"log\", \"--merges\", \"--format=%H\", \"HEAD\").split()\n    except RuntimeError:\n        return None\n    prefix = f\"{records_rel.rstrip('/')}/{item}/\"\n    for sha in merges:\n        try:\n            diff = git(root, \"diff\", \"--name-only\", f\"{sha}^1\", sha).splitlines()\n        except RuntimeError:\n            continue\n        found: set[str] = set()\n        for p in diff:\n            if p.startswith(prefix):\n                m = RECORD_RE.match(Path(p).name)\n                if m:\n                    found.add(m.group(1))\n        if all(s in found for s in stages):\n            return sha\n    return None\n\n\ndef proof_one_item_every_stage(root: Path, m: dict | None) -> Proof:\n    p = Proof(\"one-item-every-stage\", \"one item has traversed every stage\")\n    if m is None:\n        return p.fail(f\"no {MANIFEST} at {root}; no records directory is declared\")\n    records_rel = m.get(\"paths\", {}).get(\"records\", \"\")\n    records_dir = root / records_rel\n    items = load_records(records_dir)\n    if not items:\n        return p.fail(f\"no work item under {records_dir.relative_to(root)}\")\n    complete = [item for item, stages in items.items() if all(s in stages for s in STAGES)]\n    if not complete:\n        best = max(items.items(), key=lambda kv: len(kv[1]))\n        lacking = [s for s in STAGES if s not in best[1]]\n        return p.fail(f\"no item carries every stage; item {best[0]} lacks {', '.join(lacking)}\")\n\n    # issue #74: a complete item is counted only when its chain holds --\n    # attavo attest refuses a build re-approved after the fact or a\n    # verify whose build went stale, and the coherence gate refuses the\n    # merge group on exactly that; a proof that never asked would call a\n    # traversal the gate itself would not let through. The refusal text\n    # is check_attest_chain's own, never re-typed here.\n    refused, held, unmerged = [], [], []\n    for item in complete:\n        chain, message = check_attest_chain(records_dir / item, item)\n        if chain is None:\n            refused.append(f\"item {item}: {message}\")\n            continue\n        merge_sha = merge_introducing_records(root, records_rel, item, STAGES)\n        if merge_sha:\n            held.append((item, merge_sha))\n        else:\n            unmerged.append(item)\n\n    if held:\n        names = \", \".join(item for item, _ in held)\n        shas = \", \".join(sha[:12] for _, sha in held)\n        return p.hold(f\"item(s) {names} carry {', '.join(STAGES)} with the chain held, \"\n                      f\"merged at {shas}\")\n    if refused:\n        return p.fail(\"; \".join(refused))\n    return p.fail(f\"item(s) {', '.join(unmerged)} carry every stage with the chain held but no \"\n                  f\"merge commit's first-parent diff introduces all of them\")\n\n\ndef commit_subject(root: Path, sha: str) -> str:\n    return git(root, \"log\", \"-1\", \"--format=%s\", sha).strip()\n\n\ndef touches_boundary(root: Path, sha: str, boundary_paths: list[str]) -> bool:\n    \"\"\"Whether sha's first-parent diff touches a path [spec.boundary].paths\n    declares governed -- an ordinary merge that does is a boundary\n    evasion (issue #72): the tenant carried a governed change around the\n    path the manifest itself names.\"\"\"\n    diff = git(root, \"diff\", \"--name-only\", f\"{sha}^1\", sha).splitlines()\n    return any(fnmatch.fnmatch(path, pattern) for path in diff for pattern in boundary_paths)\n\n\ndef proof_no_commit_lacks_record(root: Path, m: dict | None) -> Proof:\n    p = Proof(\"no-commit-lacks-record\", \"no commit lacks a record\")\n    if m is None:\n        return p.fail(f\"no {MANIFEST} at {root}; the tenant has no record boundary\")\n    try:\n        install = git(root, \"log\", \"--diff-filter=A\", \"--format=%H\",\n                      \"--reverse\", \"--\", MANIFEST).split()\n    except RuntimeError as exc:\n        return p.fail(f\"git: {exc}\")\n    if not install:\n        return p.fail(f\"{MANIFEST} is not committed; the tenant has no record boundary\")\n    install_sha = install[0]\n    full_chain = git(root, \"rev-list\", f\"{install_sha}..HEAD\", \"--first-parent\").split()\n    if not full_chain:\n        return p.fail(f\"no commit after the install commit {install_sha[:12]}; nothing has been recorded\")\n\n    # issue #74: [doctor] from lets a tenant declare the doctor's read to\n    # start at a later commit on main's first-parent line -- the point\n    # after which every push arrived through the queue -- rather than the\n    # install commit, which on a repository that adopted the product\n    # after its history began is a boundary the doctor cannot otherwise\n    # see. Any spelling git resolves is accepted (a short sha, a tag, a\n    # ref) -- resolved with rev-parse --verify before the first-parent\n    # check runs, so the two failure modes stay distinct: a spelling that\n    # names no commit at all, and a commit that names one off the line.\n    # Checked, not trusted: neither is silently forgiven back to install.\n    declared_from = (m.get(\"doctor\") or {}).get(\"from\")\n    window_start = install_sha\n    if declared_from is not None:\n        try:\n            resolved_from = git(root, \"rev-parse\", \"--verify\", f\"{declared_from}^{{commit}}\").strip()\n        except RuntimeError:\n            return p.fail(f\"[doctor] from {declared_from} does not resolve to a commit\")\n        if resolved_from != install_sha and resolved_from not in full_chain:\n            return p.fail(f\"[doctor] from {declared_from} is not on main's first-parent \"\n                          f\"line after the install commit {install_sha[:12]}\")","numLines":200,"startLine":700,"totalLines":3393}}}

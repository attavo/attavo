{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QJne7ceKscZxDT89cZnqsS","type":"tool_result","content":"436\tdef _load_record(path: Path, item_id: str) -> dict:\n437\t    \"\"\"The one place in this repository that turns a record file's bytes\n438\t    into a dict (issue #60, acceptance 6). Defaults record_version to 1\n439\t    when absent -- version 1 is every record written before this release\n440\t    and is never migrated -- and fills item from the directory when\n441\t    absent; refuses when a present item disagrees with it.\"\"\"\n442\t    data = json.loads(path.read_text())\n443\t    data.setdefault(\"record_version\", 1)\n444\t    item = data.get(\"item\")\n445\t    if item is None:\n446\t        data[\"item\"] = item_id\n447\t    elif item != item_id:\n448\t        raise RecordItemMismatch(\n449\t            f\"{path}: item {item!r} disagrees with its directory {item_id!r}\")\n450\t    return data\n451\t\n452\t\n453\tdef parse_attempts(records_dir: Path, stage: str) -> dict[int, dict]:\n454\t    attempts: dict[int, dict] = {}\n455\t    if not records_dir.is_dir():\n456\t        return attempts\n457\t    for f in records_dir.glob(f\"{stage}-*.json\"):\n458\t        m = RECORD_RE.match(f.name)\n459\t        if not m or m.group(1) != stage:\n460\t            continue\n461\t        try:\n462\t            attempts[int(m.group(2))] = _load_record(f, records_dir.name)\n463\t        except json.JSONDecodeError:\n464\t            continue\n465\t    return attempts\n466\t\n467\t\n468\tdef latest_record(records_dir: Path, stage: str) -> dict | None:\n469\t    attempts = parse_attempts(records_dir, stage)\n470\t    return attempts[max(attempts)] if attempts else None\n471\t\n472\t\n473\tdef next_attempt_number(records_dir: Path, stage: str) -> int:\n474\t    attempts = parse_attempts(records_dir, stage)\n475\t    return (max(attempts) + 1) if attempts else 1\n476\t\n477\t\n478\tdef latest_attempt_path(records_dir: Path, stage: str) -> Path | None:\n479\t    \"\"\"The path of the highest-numbered <stage>-NN.json, or None.\"\"\"\n480\t    attempts = parse_attempts(records_dir, stage)\n481\t    if not attempts:\n482\t        return None\n483\t    return records_dir / f\"{stage}-{max(attempts):02d}.json\"\n484\t\n485\t\n486\tdef write_record(records_dir: Path, stage: str, record: dict, m: dict, item: str,\n487\t                 log: str | None = None) -> Path:\n488\t    \"\"\"Every record gains record_version (this stage schema's own $id\n489\t    version -- issue #60) and item (verbatim from the caller, matching the\n490\t    record's directory segment), plus product_version (what ran, derived\n491\t    here) and product_pin (what the tenant declared, copied verbatim from\n492\t    the manifest, or null when the manifest carries no [attavo] table) --\n493\t    the latter two recorded, never enforced (issue #49). A manifest\n494\t    missing the table is an absent fact, not a crash: this is the one\n495\t    caller of write_record that must not raise on a shape the manifest"}]},"parent_tool_use_id":null,"session_id":"884efe91-ac12-4d2f-991f-d41420d3856c","uuid":"6757e0de-409c-4605-978f-c68add332f49","timestamp":"2026-09-17T16:35:39.246Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-153/bin/attavo","content":"def _load_record(path: Path, item_id: str) -> dict:\n    \"\"\"The one place in this repository that turns a record file's bytes\n    into a dict (issue #60, acceptance 6). Defaults record_version to 1\n    when absent -- version 1 is every record written before this release\n    and is never migrated -- and fills item from the directory when\n    absent; refuses when a present item disagrees with it.\"\"\"\n    data = json.loads(path.read_text())\n    data.setdefault(\"record_version\", 1)\n    item = data.get(\"item\")\n    if item is None:\n        data[\"item\"] = item_id\n    elif item != item_id:\n        raise RecordItemMismatch(\n            f\"{path}: item {item!r} disagrees with its directory {item_id!r}\")\n    return data\n\n\ndef parse_attempts(records_dir: Path, stage: str) -> dict[int, dict]:\n    attempts: dict[int, dict] = {}\n    if not records_dir.is_dir():\n        return attempts\n    for f in records_dir.glob(f\"{stage}-*.json\"):\n        m = RECORD_RE.match(f.name)\n        if not m or m.group(1) != stage:\n            continue\n        try:\n            attempts[int(m.group(2))] = _load_record(f, records_dir.name)\n        except json.JSONDecodeError:\n            continue\n    return attempts\n\n\ndef latest_record(records_dir: Path, stage: str) -> dict | None:\n    attempts = parse_attempts(records_dir, stage)\n    return attempts[max(attempts)] if attempts else None\n\n\ndef next_attempt_number(records_dir: Path, stage: str) -> int:\n    attempts = parse_attempts(records_dir, stage)\n    return (max(attempts) + 1) if attempts else 1\n\n\ndef latest_attempt_path(records_dir: Path, stage: str) -> Path | None:\n    \"\"\"The path of the highest-numbered <stage>-NN.json, or None.\"\"\"\n    attempts = parse_attempts(records_dir, stage)\n    if not attempts:\n        return None\n    return records_dir / f\"{stage}-{max(attempts):02d}.json\"\n\n\ndef write_record(records_dir: Path, stage: str, record: dict, m: dict, item: str,\n                 log: str | None = None) -> Path:\n    \"\"\"Every record gains record_version (this stage schema's own $id\n    version -- issue #60) and item (verbatim from the caller, matching the\n    record's directory segment), plus product_version (what ran, derived\n    here) and product_pin (what the tenant declared, copied verbatim from\n    the manifest, or null when the manifest carries no [attavo] table) --\n    the latter two recorded, never enforced (issue #49). A manifest\n    missing the table is an absent fact, not a crash: this is the one\n    caller of write_record that must not raise on a shape the manifest","numLines":60,"startLine":436,"totalLines":3393}}}

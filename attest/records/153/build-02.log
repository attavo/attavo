{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SqibWpjso9nEwozyndu1UR","type":"tool_result","content":"3030\t    m = re.match(r\"^v(\\d+)\\.(\\d+)\\.(\\d+)\", version or \"\")\n3031\t    return (int(m.group(1)), int(m.group(2)), int(m.group(3))) if m else None\n3032\t\n3033\t\n3034\tdef _is_records_app(name: str) -> bool:\n3035\t    \"\"\"The forge's own app-bot login -- exactly the identity the\n3036\t    attavo-spec-gate and attavo-approve templates commit spec-gate and\n3037\t    approval records as (an app-token step mints it at run time from the\n3038\t    tenant's own app credentials): \"<app-slug>[bot]\". Never a name this\n3039\t    product can name in advance, so the one fact it can check is the\n3040\t    shape the forge itself gives every app identity, not a specific one.\"\"\"\n3041\t    return name.endswith(\"[bot]\")\n3042\t\n3043\t\n3044\tdef first_commit_touching(root: Path, relpath: str) -> str | None:\n3045\t    \"\"\"The earliest commit touching relpath -- the mirror of\n3046\t    last_commit_touching, which answers the latest. Ledger's own walk\n3047\t    starts here: the item's first spec commit.\"\"\"\n3048\t    out = git(root, \"log\", \"--reverse\", \"--format=%H\", \"--\", relpath)\n3049\t    lines = out.split()\n3050\t    return lines[0] if lines else None\n3051\t\n3052\t\n3053\tdef _commit_touches(root: Path, sha: str) -> list[str]:\n3054\t    return git(root, \"diff\", \"--name-only\", f\"{sha}^1\", sha).splitlines()\n3055\t\n3056\t\n3057\tdef _record_at(root: Path, sha: str, relpath: str, item_id: str) -> dict:\n3058\t    \"\"\"A record's own dict at a past commit, not the working tree --\n3059\t    ledger's only need for one (issue #128). Read through _load_record\n3060\t    (issue #60, acceptance 6: the one place a record's bytes become a\n3061\t    dict) by spilling the blob to a throwaway file, rather than a second\n3062\t    json.loads of its own: `git show` has no path on disk to hand\n3063\t    _load_record directly.\"\"\"\n3064\t    out = subprocess.run([\"git\", \"-C\", str(root), \"show\", f\"{sha}:{relpath}\"],\n3065\t                         capture_output=True, text=True, check=False)\n3066\t    if out.returncode != 0:\n3067\t        return {}\n3068\t    with tempfile.NamedTemporaryFile(\"w\", suffix=\".json\", delete=False) as fh:\n3069\t        fh.write(out.stdout)\n3070\t        blob_path = Path(fh.name)\n3071\t    try:\n3072\t        return _load_record(blob_path, item_id)\n3073\t    except json.JSONDecodeError:\n3074\t        return {}\n3075\t    finally:\n3076\t        blob_path.unlink(missing_ok=True)\n3077\t\n3078\t\n3079\tdef item_ledger(root: Path, m: dict, item_id: str) -> dict:\n3080\t    \"\"\"{\"item\", \"rows\", \"summary\"}: one row per act between item_id's first\n3081\t    spec commit and its merge (merge_introducing_records, the same\n3082\t    derivation doctor's proof two and attest both already read) or HEAD\n3083\t    when the item has not merged yet.\n3084\t\n3085\t    Each commit gets exactly one class, in this order: the merge commit\n3086\t    itself is \"merge\"; a commit authored by the executor identity\n3087\t    (executor_identity) is \"change\"; a commit introducing an approval\n3088\t    record is \"approve\", whoever committed it -- an operator's decision,\n3089\t    however it reached git; a commit introducing a spec-gate, build, or\n3090\t    verify record, authored by the driver identity (driver_identity) or\n3091\t    the records app, is \"record\"; the same, authored by a person, is\n3092\t    \"launch\" for build or verify (spec-gate records the app always\n3093\t    commits, in every template this product ships) -- unless that\n3094\t    record's own product_version predates v0.18.0, when driver_identity\n3095\t    did not yet exist to tell the two apart, and the row is\n3096\t    \"record-or-launch\" with a note, counted in neither summary total\n3097\t    rather than guessed; a person's commit touching the spec is \"spec\"\n3098\t    before the first approval record and \"amend\" after; anything else by\n3099\t    a person is \"transport\" (a merge of main among them).\"\"\"\n3100\t    specs_rel = m[\"paths\"][\"specs\"]\n3101\t    records_rel = m[\"paths\"][\"records\"]\n3102\t    specs_prefix = f\"{specs_rel.rstrip('/')}/{item_id}/\"\n3103\t    records_prefix = f\"{records_rel.rstrip('/')}/{item_id}/\"\n3104\t    empty_summary = {\"operator_acts\": 0, \"product_acts\": 0, \"executor_commits\": 0,\n3105\t                     \"stops\": 0, \"since\": None}\n3106\t\n3107\t    first_spec_sha = first_commit_touching(root, str(Path(specs_rel) / item_id))\n3108\t    if first_spec_sha is None:\n3109\t        return {\"item\": item_id, \"rows\": [], \"summary\": empty_summary}\n3110\t\n3111\t    merge_sha = merge_introducing_records(root, records_rel, item_id, STAGES)\n3112\t    if merge_sha is not None:\n3113\t        branch_tip = git(root, \"rev-parse\", f\"{merge_sha}^2\").strip()\n3114\t        commits = commits_since(root, f\"{first_spec_sha}^\", end=branch_tip)\n3115\t        commits += commits_since(root, f\"{merge_sha}^1\", end=merge_sha)\n3116\t    else:\n3117\t        commits = commits_since(root, f\"{first_spec_sha}^\", end=\"HEAD\")\n3118\t\n3119\t    driver = driver_identity()\n3120\t    rows: list[dict] = []\n3121\t    operator_acts = product_acts = executor_commits = 0\n3122\t    since = None\n3123\t    approval_seen = False\n3124\t\n3125\t    for c in commits:\n3126\t        sha, name, email = c[\"sha\"], c[\"name\"], c[\"email\"]\n3127\t\n3128\t        if merge_sha is not None and sha == merge_sha:\n3129\t            rows.append({\"sha\": sha, \"identity\": name, \"class\": \"merge\"})\n3130\t            operator_acts += 1\n3131\t            continue\n3132\t\n3133\t        if email.startswith(\"executor+\") and email.endswith(\"@attavo.invalid\"):\n3134\t            rows.append({\"sha\": sha, \"identity\": name, \"class\": \"change\"})\n3135\t            executor_commits += 1\n3136\t            continue\n3137\t\n3138\t        touched = _commit_touches(root, sha)\n3139\t        record_touch = None\n3140\t        for p in touched:\n3141\t            if not p.startswith(records_prefix):\n3142\t                continue\n3143\t            rm = RECORD_RE.match(Path(p).name)\n3144\t            if rm and rm.group(1) in STAGES:\n3145\t                record_touch = (rm.group(1), p)\n3146\t                break\n3147\t\n3148\t        if record_touch is not None:\n3149\t            stage, relpath = record_touch\n3150\t            content = _record_at(root, sha, relpath, item_id)\n3151\t            if since is None:\n3152\t                since = content.get(\"product_version\")\n3153\t\n3154\t            if stage == \"approval\":\n3155\t                rows.append({\"sha\": sha, \"identity\": name, \"class\": \"approve\"})\n3156\t                operator_acts += 1\n3157\t                approval_seen = True\n3158\t                continue\n3159\t\n3160\t            is_driver = name == driver[\"name\"] and email == driver[\"email\"]\n3161\t            is_records_app = _is_records_app(name)\n3162\t            if stage == \"spec\" or is_driver or is_records_app:\n3163\t                rows.append({\"sha\": sha, \"identity\": name, \"class\": \"record\"})\n3164\t                product_acts += 1\n3165\t                continue\n3166\t\n3167\t            version = _semver_tuple(content.get(\"product_version\"))\n3168\t            if version is not None and version < LEDGER_V018_CUTOFF:\n3169\t                rows.append({\"sha\": sha, \"identity\": name, \"class\": \"record-or-launch\",\n3170\t                            \"note\": \"not distinguishable before v0.18.0\"})\n3171\t                continue\n3172\t\n3173\t            rows.append({\"sha\": sha, \"identity\": name, \"class\": \"launch\"})\n3174\t            operator_acts += 1\n3175\t            continue\n3176\t\n3177\t        if any(p.startswith(specs_prefix) for p in touched):\n3178\t            cls = \"amend\" if approval_seen else \"spec\"\n3179\t            rows.append({\"sha\": sha, \"identity\": name, \"class\": cls})\n3180\t            if cls == \"amend\":\n3181\t                operator_acts += 1\n3182\t            continue\n3183\t\n3184\t        rows.append({\"sha\": sha, \"identity\": name, \"class\": \"transport\"})\n3185\t        operator_acts += 1\n3186\t\n3187\t    # issue #137: the same set attavo stops counts, from the same reader\n3188\t    # (item_stops) -- not a second, independent count kept in sync by\n3189\t    # hand. One non-pass record per row, whatever its stage; a gate\n3190\t    # refusal is included the same as a non-pass build or verify record.\n3191\t    stops = len(item_stops(root, m, item_id)[\"rows\"])\n3192\t\n3193\t    summary = {\"operator_acts\": operator_acts, \"product_acts\": product_acts,\n3194\t              \"executor_commits\": executor_commits, \"stops\": stops, \"since\": since}\n3195\t    return {\"item\": item_id, \"rows\": rows, \"summary\": summary}\n3196\t\n3197\t\n3198\tdef cmd_ledger(argv: list[str]) -> int:\n3199\t    as_json = \"--json\" in argv\n3200\t    positional = [a for a in argv if a != \"--json\"]\n3201\t    root = Path(\".\").resolve()\n3202\t    m = read_manifest(root)\n3203\t    if m is None:\n3204\t        print(f\"attavo ledger: no {MANIFEST} at {root}\", file=sys.stderr)\n3205\t        return 2\n3206\t\n3207\t    records_rel = m[\"paths\"][\"records\"]\n3208\t    if positional:\n3209\t        item_ids = [positional[0]]\n3210\t    else:\n3211\t        records_root = root / records_rel\n3212\t        item_ids = (sorted((p.name for p in records_root.iterdir() if p.is_dir()))\n3213\t                   if records_root.is_dir() else [])\n3214\t\n3215\t    ledgers = [item_ledger(root, m, item_id) for item_id in item_ids]\n3216\t\n3217\t    if as_json:\n3218\t        if positional:\n3219\t            print(json.dumps(ledgers[0], indent=2))\n3220\t        else:\n3221\t            print(json.dumps({\"items\": ledgers}, indent=2))\n3222\t        return 0\n3223\t\n3224\t    for entry in ledgers:\n3225\t        print(f\"attavo ledger: item {entry['item']}\")\n3226\t        for row in entry[\"rows\"]:\n3227\t            note = f\"  ({row['note']})\" if \"note\" in row else \"\"\n3228\t            print(f\"  {row['sha'][:12]}  {row['identity']:<32}  {row['class']}{note}\")\n3229\t        s = entry[\"summary\"]\n3230\t        print(f\"  operator acts: {s['operator_acts']}  product acts: {s['product_acts']}  \"\n3231\t             f\"executor commits: {s['executor_commits']}  stops: {s['stops']}  \"\n3232\t             f\"since: {s['since']}\")\n3233\t    if not ledgers:\n3234\t        print(f\"attavo ledger: no item found under {records_rel}\")\n3235\t    return 0\n3236\t\n3237\t\n3238\t# --- stops: every non-pass record by class, provenance, and answerer\n3239\t# (issue #129) ---\n3240\t\n3241\tdef item_stops(root: Path, m: dict, item_id: str) -> dict:\n3242\t    \"\"\"{\"item\", \"rows\", \"totals\"}: one row per non-pass build or verify\n3243\t    record (STOP_STAGES), plus every refused spec-gate record (issue\n3244\t    #133), class \"gate\" (issue #137) -- read from status and refusal\n3245\t    rather than a stop field spec-gate records never carry (gate_stop\n3246\t    synthesizes it) -- under item_id, whatever the record's own\n3247\t    record_version -- a record too old to carry stop at all still gets\n3248\t    a row, its class printed as the doctor's own phrase for it.\n3249\t\n3250\t    The answerer, a closed choice: \"counsel:<verdict>\" when\n3251\t    counsel_record_for finds a counsel record naming this exact stage and\n3252\t    number -- the product's own answer, which wins over whatever the stop\n3253\t    itself says, since a counseled stop was already read once; failing\n3254\t    that, \"person\" for class question (a person's to answer, not a\n3255\t    guard's); failing that, \"guard\" for a class in GUARDED_STOP_CLASSES\n3256\t    (a guard's own rejection needed no further reading); anything else\n3257\t    -- no-cause, unclassed, or no stop at all -- is \"none\": nobody has\n3258\t    answered it yet.\"\"\"\n3259\t    records_rel = m[\"paths\"][\"records\"]\n3260\t    item_records_dir = root / records_rel / item_id\n3261\t    by_class = {c: 0 for c in stop_class_enum()}\n3262\t    by_answerer: dict[str, int] = {}\n3263\t    before_stop_was_recorded = 0\n3264\t    rows: list[dict] = []\n3265\t\n3266\t    def add_row(stage: str, n: int, stop: dict | None) -> None:\n3267\t        nonlocal before_stop_was_recorded\n3268\t        name = f\"{stage}-{n:02d}\"\n3269\t        marker = item_records_dir / f\"{name}.filed\"\n3270\t        filed_issue = marker.read_text() if marker.is_file() else None\n3271\t        counsel = counsel_record_for(item_records_dir, stage, n)\n3272\t\n3273\t        if counsel is not None:\n3274\t            answerer = f\"counsel:{counsel.get('verdict')}\"\n3275\t        elif stop and stop.get(\"class\") == \"question\":\n3276\t            answerer = \"person\"\n3277\t        elif stop and stop.get(\"class\") in GUARDED_STOP_CLASSES:\n3278\t            answerer = \"guard\"\n3279\t        else:\n3280\t            answerer = \"none\"\n3281\t\n3282\t        if stop:\n3283\t            cls, provenance, detail = (stop.get(\"class\"), stop.get(\"provenance\"),\n3284\t                                      stop.get(\"detail\"))\n3285\t            if cls in by_class:\n3286\t                by_class[cls] += 1\n3287\t        else:\n3288\t            cls, provenance, detail = \"before stop was recorded\", None, None\n3289\t            before_stop_was_recorded += 1\n3290\t\n3291\t        by_answerer[answerer] = by_answerer.get(answerer, 0) + 1\n3292\t        rows.append({\"item\": item_id, \"record\": name, \"class\": cls,\n3293\t                    \"provenance\": provenance, \"detail\": detail,\n3294\t                    \"answerer\": answerer, \"filed_issue\": filed_issue})\n3295\t\n3296\t    if item_records_dir.is_dir():\n3297\t        for stage in STOP_STAGES:\n3298\t            for n, rec in sorted(parse_attempts(item_records_dir, stage).items()):\n3299\t                if rec.get(\"status\") == \"pass\":\n3300\t                    continue\n3301\t                add_row(stage, n, rec.get(\"stop\"))\n3302\t        for n, rec in sorted(parse_attempts(item_records_dir, \"spec\").items()):\n3303\t            if rec.get(\"status\") != \"refused\":\n3304\t                continue\n3305\t            add_row(\"spec\", n, gate_stop(rec.get(\"refusal\")))\n3306\t\n3307\t    totals = {\"by_class\": by_class, \"by_answerer\": by_answerer,\n3308\t             \"before_stop_was_recorded\": before_stop_was_recorded}\n3309\t    return {\"item\": item_id, \"rows\": rows, \"totals\": totals}\n3310\t\n3311\t\n3312\tdef cmd_stops(argv: list[str]) -> int:\n3313\t    as_json = \"--json\" in argv\n3314\t    positional = [a for a in argv if a != \"--json\"]\n3315\t    root = Path(\".\").resolve()\n3316\t    m = read_manifest(root)\n3317\t    if m is None:\n3318\t        print(f\"attavo stops: no {MANIFEST} at {root}\", file=sys.stderr)\n3319\t        return 2\n3320\t\n3321\t    records_rel = m[\"paths\"][\"records\"]\n3322\t    if positional:\n3323\t        item_ids = [positional[0]]\n3324\t    else:\n3325\t        records_root = root / records_rel\n3326\t        item_ids = (sorted((p.name for p in records_root.iterdir() if p.is_dir()))\n3327\t                   if records_root.is_dir() else [])\n3328\t\n3329\t    reports = [item_stops(root, m, item_id) for item_id in item_ids]\n3330\t\n3331\t    if as_json:\n3332\t        if positional:\n3333\t            print(json.dumps(reports[0], indent=2))\n3334\t        else:\n3335\t            print(json.dumps({\"items\": reports}, indent=2))\n3336\t        return 0\n3337\t\n3338\t    for entry in reports:\n3339\t        print(f\"attavo stops: item {entry['item']}\")\n3340\t        for row in entry[\"rows\"]:\n3341\t            filed = f\"  filed: {row['filed_issue'].strip()}\" if row[\"filed_issue\"] else \"\"\n3342\t            print(f\"  {row['record']:<10} {row['class']:<24} {row['provenance'] or '-':<10} \"\n3343\t                 f\"{row['answerer']:<16}{filed}\")\n3344\t        t = entry[\"totals\"]\n3345\t        print(f\"  by class: {t['by_class']}\")\n3346\t        print(f\"  by answerer: {t['by_answerer']}\")\n3347\t        print(f\"  before stop was recorded: {t['before_stop_was_recorded']}\")\n3348\t    if not reports:\n3349\t        print(f\"attavo stops: no item found under {records_rel}\")\n3350\t    return 0\n3351\t\n3352\t\n3353\tdef main(argv: list[str]) -> int:\n3354\t    if not argv or argv[0] in (\"-h\", \"--help\"):\n3355\t        print(__doc__.strip())\n3356\t        return 0 if argv else 2\n3357\t    if argv[0] == \"doctor\":\n3358\t        return cmd_doctor(argv[1:])\n3359\t    if argv[0] == \"spec-gate\":\n3360\t        return cmd_spec_gate(argv[1:])\n3361\t    if argv[0] == \"approve\":\n3362\t        return cmd_approve(argv[1:])\n3363\t    if argv[0] == \"approval-status\":\n3364\t        return cmd_approval_status(argv[1:])\n3365\t    if argv[0] == \"build\":\n3366\t        return cmd_build(argv[1:])\n3367\t    if argv[0] == \"verify\":\n3368\t        return cmd_verify(argv[1:])\n3369\t    if argv[0] == \"file-findings\":\n3370\t        return cmd_file_findings(argv[1:])\n3371\t    if argv[0] == \"file-stops\":\n3372\t        return cmd_file_stops(argv[1:])\n3373\t    if argv[0] == \"counsel\":\n3374\t        return cmd_counsel(argv[1:])\n3375\t    if argv[0] == \"record-only\":\n3376\t        return cmd_record_only(argv[1:])\n3377\t    if argv[0] == \"attest\":\n3378\t        return cmd_attest(argv[1:])\n3379\t    if argv[0] == \"drive\":\n3380\t        return cmd_drive(argv[1:])\n3381\t    if argv[0] == \"ledger\":\n3382\t        return cmd_ledger(argv[1:])\n3383\t    if argv[0] == \"stops\":\n3384\t        return cmd_stops(argv[1:])\n3385\t    print(f\"attavo: unknown subcommand {argv[0]!r}; only doctor, spec-gate, approve, \"\n3386\t          f\"approval-status, build, verify, file-findings, file-stops, counsel, record-only, \"\n3387\t          f\"attest, drive, ledger, stops exist at this commit\", file=sys.stderr)\n3388\t    return 2\n3389\t\n3390\t\n3391\tif __name__ == \"__main__\":\n3392\t    sys.exit(main(sys.argv[1:]))\n3393\t"}]},"parent_tool_use_id":null,"session_id":"884efe91-ac12-4d2f-991f-d41420d3856c","uuid":"2fcce191-0338-460a-a3dc-4c09b4a67ff6","timestamp":"2026-09-17T16:33:36.072Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-153/bin/attavo","content":"    m = re.match(r\"^v(\\d+)\\.(\\d+)\\.(\\d+)\", version or \"\")\n    return (int(m.group(1)), int(m.group(2)), int(m.group(3))) if m else None\n\n\ndef _is_records_app(name: str) -> bool:\n    \"\"\"The forge's own app-bot login -- exactly the identity the\n    attavo-spec-gate and attavo-approve templates commit spec-gate and\n    approval records as (an app-token step mints it at run time from the\n    tenant's own app credentials): \"<app-slug>[bot]\". Never a name this\n    product can name in advance, so the one fact it can check is the\n    shape the forge itself gives every app identity, not a specific one.\"\"\"\n    return name.endswith(\"[bot]\")\n\n\ndef first_commit_touching(root: Path, relpath: str) -> str | None:\n    \"\"\"The earliest commit touching relpath -- the mirror of\n    last_commit_touching, which answers the latest. Ledger's own walk\n    starts here: the item's first spec commit.\"\"\"\n    out = git(root, \"log\", \"--reverse\", \"--format=%H\", \"--\", relpath)\n    lines = out.split()\n    return lines[0] if lines else None\n\n\ndef _commit_touches(root: Path, sha: str) -> list[str]:\n    return git(root, \"diff\", \"--name-only\", f\"{sha}^1\", sha).splitlines()\n\n\ndef _record_at(root: Path, sha: str, relpath: str, item_id: str) -> dict:\n    \"\"\"A record's own dict at a past commit, not the working tree --\n    ledger's only need for one (issue #128). Read through _load_record\n    (issue #60, acceptance 6: the one place a record's bytes become a\n    dict) by spilling the blob to a throwaway file, rather than a second\n    json.loads of its own: `git show` has no path on disk to hand\n    _load_record directly.\"\"\"\n    out = subprocess.run([\"git\", \"-C\", str(root), \"show\", f\"{sha}:{relpath}\"],\n                         capture_output=True, text=True, check=False)\n    if out.returncode != 0:\n        return {}\n    with tempfile.NamedTemporaryFile(\"w\", suffix=\".json\", delete=False) as fh:\n        fh.write(out.stdout)\n        blob_path = Path(fh.name)\n    try:\n        return _load_record(blob_path, item_id)\n    except json.JSONDecodeError:\n        return {}\n    finally:\n        blob_path.unlink(missing_ok=True)\n\n\ndef item_ledger(root: Path, m: dict, item_id: str) -> dict:\n    \"\"\"{\"item\", \"rows\", \"summary\"}: one row per act between item_id's first\n    spec commit and its merge (merge_introducing_records, the same\n    derivation doctor's proof two and attest both already read) or HEAD\n    when the item has not merged yet.\n\n    Each commit gets exactly one class, in this order: the merge commit\n    itself is \"merge\"; a commit authored by the executor identity\n    (executor_identity) is \"change\"; a commit introducing an approval\n    record is \"approve\", whoever committed it -- an operator's decision,\n    however it reached git; a commit introducing a spec-gate, build, or\n    verify record, authored by the driver identity (driver_identity) or\n    the records app, is \"record\"; the same, authored by a person, is\n    \"launch\" for build or verify (spec-gate records the app always\n    commits, in every template this product ships) -- unless that\n    record's own product_version predates v0.18.0, when driver_identity\n    did not yet exist to tell the two apart, and the row is\n    \"record-or-launch\" with a note, counted in neither summary total\n    rather than guessed; a person's commit touching the spec is \"spec\"\n    before the first approval record and \"amend\" after; anything else by\n    a person is \"transport\" (a merge of main among them).\"\"\"\n    specs_rel = m[\"paths\"][\"specs\"]\n    records_rel = m[\"paths\"][\"records\"]\n    specs_prefix = f\"{specs_rel.rstrip('/')}/{item_id}/\"\n    records_prefix = f\"{records_rel.rstrip('/')}/{item_id}/\"\n    empty_summary = {\"operator_acts\": 0, \"product_acts\": 0, \"executor_commits\": 0,\n                     \"stops\": 0, \"since\": None}\n\n    first_spec_sha = first_commit_touching(root, str(Path(specs_rel) / item_id))\n    if first_spec_sha is None:\n        return {\"item\": item_id, \"rows\": [], \"summary\": empty_summary}\n\n    merge_sha = merge_introducing_records(root, records_rel, item_id, STAGES)\n    if merge_sha is not None:\n        branch_tip = git(root, \"rev-parse\", f\"{merge_sha}^2\").strip()\n        commits = commits_since(root, f\"{first_spec_sha}^\", end=branch_tip)\n        commits += commits_since(root, f\"{merge_sha}^1\", end=merge_sha)\n    else:\n        commits = commits_since(root, f\"{first_spec_sha}^\", end=\"HEAD\")\n\n    driver = driver_identity()\n    rows: list[dict] = []\n    operator_acts = product_acts = executor_commits = 0\n    since = None\n    approval_seen = False\n\n    for c in commits:\n        sha, name, email = c[\"sha\"], c[\"name\"], c[\"email\"]\n\n        if merge_sha is not None and sha == merge_sha:\n            rows.append({\"sha\": sha, \"identity\": name, \"class\": \"merge\"})\n            operator_acts += 1\n            continue\n\n        if email.startswith(\"executor+\") and email.endswith(\"@attavo.invalid\"):\n            rows.append({\"sha\": sha, \"identity\": name, \"class\": \"change\"})\n            executor_commits += 1\n            continue\n\n        touched = _commit_touches(root, sha)\n        record_touch = None\n        for p in touched:\n            if not p.startswith(records_prefix):\n                continue\n            rm = RECORD_RE.match(Path(p).name)\n            if rm and rm.group(1) in STAGES:\n                record_touch = (rm.group(1), p)\n                break\n\n        if record_touch is not None:\n            stage, relpath = record_touch\n            content = _record_at(root, sha, relpath, item_id)\n            if since is None:\n                since = content.get(\"product_version\")\n\n            if stage == \"approval\":\n                rows.append({\"sha\": sha, \"identity\": name, \"class\": \"approve\"})\n                operator_acts += 1\n                approval_seen = True\n                continue\n\n            is_driver = name == driver[\"name\"] and email == driver[\"email\"]\n            is_records_app = _is_records_app(name)\n            if stage == \"spec\" or is_driver or is_records_app:\n                rows.append({\"sha\": sha, \"identity\": name, \"class\": \"record\"})\n                product_acts += 1\n                continue\n\n            version = _semver_tuple(content.get(\"product_version\"))\n            if version is not None and version < LEDGER_V018_CUTOFF:\n                rows.append({\"sha\": sha, \"identity\": name, \"class\": \"record-or-launch\",\n                            \"note\": \"not distinguishable before v0.18.0\"})\n                continue\n\n            rows.append({\"sha\": sha, \"identity\": name, \"class\": \"launch\"})\n            operator_acts += 1\n            continue\n\n        if any(p.startswith(specs_prefix) for p in touched):\n            cls = \"amend\" if approval_seen else \"spec\"\n            rows.append({\"sha\": sha, \"identity\": name, \"class\": cls})\n            if cls == \"amend\":\n                operator_acts += 1\n            continue\n\n        rows.append({\"sha\": sha, \"identity\": name, \"class\": \"transport\"})\n        operator_acts += 1\n\n    # issue #137: the same set attavo stops counts, from the same reader\n    # (item_stops) -- not a second, independent count kept in sync by\n    # hand. One non-pass record per row, whatever its stage; a gate\n    # refusal is included the same as a non-pass build or verify record.\n    stops = len(item_stops(root, m, item_id)[\"rows\"])\n\n    summary = {\"operator_acts\": operator_acts, \"product_acts\": product_acts,\n              \"executor_commits\": executor_commits, \"stops\": stops, \"since\": since}\n    return {\"item\": item_id, \"rows\": rows, \"summary\": summary}\n\n\ndef cmd_ledger(argv: list[str]) -> int:\n    as_json = \"--json\" in argv\n    positional = [a for a in argv if a != \"--json\"]\n    root = Path(\".\").resolve()\n    m = read_manifest(root)\n    if m is None:\n        print(f\"attavo ledger: no {MANIFEST} at {root}\", file=sys.stderr)\n        return 2\n\n    records_rel = m[\"paths\"][\"records\"]\n    if positional:\n        item_ids = [positional[0]]\n    else:\n        records_root = root / records_rel\n        item_ids = (sorted((p.name for p in records_root.iterdir() if p.is_dir()))\n                   if records_root.is_dir() else [])\n\n    ledgers = [item_ledger(root, m, item_id) for item_id in item_ids]\n\n    if as_json:\n        if positional:\n            print(json.dumps(ledgers[0], indent=2))\n        else:\n            print(json.dumps({\"items\": ledgers}, indent=2))\n        return 0\n\n    for entry in ledgers:\n        print(f\"attavo ledger: item {entry['item']}\")\n        for row in entry[\"rows\"]:\n            note = f\"  ({row['note']})\" if \"note\" in row else \"\"\n            print(f\"  {row['sha'][:12]}  {row['identity']:<32}  {row['class']}{note}\")\n        s = entry[\"summary\"]\n        print(f\"  operator acts: {s['operator_acts']}  product acts: {s['product_acts']}  \"\n             f\"executor commits: {s['executor_commits']}  stops: {s['stops']}  \"\n             f\"since: {s['since']}\")\n    if not ledgers:\n        print(f\"attavo ledger: no item found under {records_rel}\")\n    return 0\n\n\n# --- stops: every non-pass record by class, provenance, and answerer\n# (issue #129) ---\n\ndef item_stops(root: Path, m: dict, item_id: str) -> dict:\n    \"\"\"{\"item\", \"rows\", \"totals\"}: one row per non-pass build or verify\n    record (STOP_STAGES), plus every refused spec-gate record (issue\n    #133), class \"gate\" (issue #137) -- read from status and refusal\n    rather than a stop field spec-gate records never carry (gate_stop\n    synthesizes it) -- under item_id, whatever the record's own\n    record_version -- a record too old to carry stop at all still gets\n    a row, its class printed as the doctor's own phrase for it.\n\n    The answerer, a closed choice: \"counsel:<verdict>\" when\n    counsel_record_for finds a counsel record naming this exact stage and\n    number -- the product's own answer, which wins over whatever the stop\n    itself says, since a counseled stop was already read once; failing\n    that, \"person\" for class question (a person's to answer, not a\n    guard's); failing that, \"guard\" for a class in GUARDED_STOP_CLASSES\n    (a guard's own rejection needed no further reading); anything else\n    -- no-cause, unclassed, or no stop at all -- is \"none\": nobody has\n    answered it yet.\"\"\"\n    records_rel = m[\"paths\"][\"records\"]\n    item_records_dir = root / records_rel / item_id\n    by_class = {c: 0 for c in stop_class_enum()}\n    by_answerer: dict[str, int] = {}\n    before_stop_was_recorded = 0\n    rows: list[dict] = []\n\n    def add_row(stage: str, n: int, stop: dict | None) -> None:\n        nonlocal before_stop_was_recorded\n        name = f\"{stage}-{n:02d}\"\n        marker = item_records_dir / f\"{name}.filed\"\n        filed_issue = marker.read_text() if marker.is_file() else None\n        counsel = counsel_record_for(item_records_dir, stage, n)\n\n        if counsel is not None:\n            answerer = f\"counsel:{counsel.get('verdict')}\"\n        elif stop and stop.get(\"class\") == \"question\":\n            answerer = \"person\"\n        elif stop and stop.get(\"class\") in GUARDED_STOP_CLASSES:\n            answerer = \"guard\"\n        else:\n            answerer = \"none\"\n\n        if stop:\n            cls, provenance, detail = (stop.get(\"class\"), stop.get(\"provenance\"),\n                                      stop.get(\"detail\"))\n            if cls in by_class:\n                by_class[cls] += 1\n        else:\n            cls, provenance, detail = \"before stop was recorded\", None, None\n            before_stop_was_recorded += 1\n\n        by_answerer[answerer] = by_answerer.get(answerer, 0) + 1\n        rows.append({\"item\": item_id, \"record\": name, \"class\": cls,\n                    \"provenance\": provenance, \"detail\": detail,\n                    \"answerer\": answerer, \"filed_issue\": filed_issue})\n\n    if item_records_dir.is_dir():\n        for stage in STOP_STAGES:\n            for n, rec in sorted(parse_attempts(item_records_dir, stage).items()):\n                if rec.get(\"status\") == \"pass\":\n                    continue\n                add_row(stage, n, rec.get(\"stop\"))\n        for n, rec in sorted(parse_attempts(item_records_dir, \"spec\").items()):\n            if rec.get(\"status\") != \"refused\":\n                continue\n            add_row(\"spec\", n, gate_stop(rec.get(\"refusal\")))\n\n    totals = {\"by_class\": by_class, \"by_answerer\": by_answerer,\n             \"before_stop_was_recorded\": before_stop_was_recorded}\n    return {\"item\": item_id, \"rows\": rows, \"totals\": totals}\n\n\ndef cmd_stops(argv: list[str]) -> int:\n    as_json = \"--json\" in argv\n    positional = [a for a in argv if a != \"--json\"]\n    root = Path(\".\").resolve()\n    m = read_manifest(root)\n    if m is None:\n        print(f\"attavo stops: no {MANIFEST} at {root}\", file=sys.stderr)\n        return 2\n\n    records_rel = m[\"paths\"][\"records\"]\n    if positional:\n        item_ids = [positional[0]]\n    else:\n        records_root = root / records_rel\n        item_ids = (sorted((p.name for p in records_root.iterdir() if p.is_dir()))\n                   if records_root.is_dir() else [])\n\n    reports = [item_stops(root, m, item_id) for item_id in item_ids]\n\n    if as_json:\n        if positional:\n            print(json.dumps(reports[0], indent=2))\n        else:\n            print(json.dumps({\"items\": reports}, indent=2))\n        return 0\n\n    for entry in reports:\n        print(f\"attavo stops: item {entry['item']}\")\n        for row in entry[\"rows\"]:\n            filed = f\"  filed: {row['filed_issue'].strip()}\" if row[\"filed_issue\"] else \"\"\n            print(f\"  {row['record']:<10} {row['class']:<24} {row['provenance'] or '-':<10} \"\n                 f\"{row['answerer']:<16}{filed}\")\n        t = entry[\"totals\"]\n        print(f\"  by class: {t['by_class']}\")\n        print(f\"  by answerer: {t['by_answerer']}\")\n        print(f\"  before stop was recorded: {t['before_stop_was_recorded']}\")\n    if not reports:\n        print(f\"attavo stops: no item found under {records_rel}\")\n    return 0\n\n\ndef main(argv: list[str]) -> int:\n    if not argv or argv[0] in (\"-h\", \"--help\"):\n        print(__doc__.strip())\n        return 0 if argv else 2\n    if argv[0] == \"doctor\":\n        return cmd_doctor(argv[1:])\n    if argv[0] == \"spec-gate\":\n        return cmd_spec_gate(argv[1:])\n    if argv[0] == \"approve\":\n        return cmd_approve(argv[1:])\n    if argv[0] == \"approval-status\":\n        return cmd_approval_status(argv[1:])\n    if argv[0] == \"build\":\n        return cmd_build(argv[1:])\n    if argv[0] == \"verify\":\n        return cmd_verify(argv[1:])\n    if argv[0] == \"file-findings\":\n        return cmd_file_findings(argv[1:])\n    if argv[0] == \"file-stops\":\n        return cmd_file_stops(argv[1:])\n    if argv[0] == \"counsel\":\n        return cmd_counsel(argv[1:])\n    if argv[0] == \"record-only\":\n        return cmd_record_only(argv[1:])\n    if argv[0] == \"attest\":\n        return cmd_attest(argv[1:])\n    if argv[0] == \"drive\":\n        return cmd_drive(argv[1:])\n    if argv[0] == \"ledger\":\n        return cmd_ledger(argv[1:])\n    if argv[0] == \"stops\":\n        return cmd_stops(argv[1:])\n    print(f\"attavo: unknown subcommand {argv[0]!r}; only doctor, spec-gate, approve, \"\n          f\"approval-status, build, verify, file-findings, file-stops, counsel, record-only, \"\n          f\"attest, drive, ledger, stops exist at this commit\", file=sys.stderr)\n    return 2\n\n\nif __name__ == \"__main__\":\n    sys.exit(main(sys.argv[1:]))\n","numLines":364,"startLine":3030,"totalLines":3393}}}

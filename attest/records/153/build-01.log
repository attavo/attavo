{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01K9deB5F5aJq9EPqw7zCdf4","type":"tool_result","content":"3126\tdef item_ledger(root: Path, m: dict, item_id: str) -> dict:\n3127\t    \"\"\"{\"item\", \"rows\", \"summary\"}: one row per act between item_id's first\n3128\t    spec commit and its merge (merge_introducing_records, the same\n3129\t    derivation doctor's proof two and attest both already read) or HEAD\n3130\t    when the item has not merged yet.\n3131\t\n3132\t    Each commit gets exactly one class, in this order: the merge commit\n3133\t    itself is \"merge\"; a commit authored by the executor identity\n3134\t    (executor_identity) is \"change\"; a commit introducing an approval\n3135\t    record is \"approve\", whoever committed it -- an operator's decision,\n3136\t    however it reached git; a commit introducing a spec-gate, build, or\n3137\t    verify record, authored by the driver identity (driver_identity) or\n3138\t    the records app, is \"record\"; the same, authored by a person, is\n3139\t    \"launch\" for build or verify (spec-gate records the app always\n3140\t    commits, in every template this product ships) -- unless that\n3141\t    record's own product_version predates v0.18.0, when driver_identity\n3142\t    did not yet exist to tell the two apart, and the row is\n3143\t    \"record-or-launch\" with a note, counted in neither summary total\n3144\t    rather than guessed; a person's commit touching the spec is \"spec\"\n3145\t    before the first approval record and \"amend\" after; anything else by\n3146\t    a person is \"transport\" (a merge of main among them).\"\"\"\n3147\t    specs_rel = m[\"paths\"][\"specs\"]\n3148\t    records_rel = m[\"paths\"][\"records\"]\n3149\t    specs_prefix = f\"{specs_rel.rstrip('/')}/{item_id}/\"\n3150\t    records_prefix = f\"{records_rel.rstrip('/')}/{item_id}/\"\n3151\t    empty_summary = {\"operator_acts\": 0, \"product_acts\": 0, \"executor_commits\": 0,\n3152\t                     \"stops\": 0, \"since\": None}\n3153\t\n3154\t    first_spec_sha = first_commit_touching(root, str(Path(specs_rel) / item_id))\n3155\t    if first_spec_sha is None:\n3156\t        return {\"item\": item_id, \"rows\": [], \"summary\": empty_summary}\n3157\t\n3158\t    merge_sha = merge_introducing_records(root, records_rel, item_id, STAGES)\n3159\t    if merge_sha is not None:\n3160\t        branch_tip = git(root, \"rev-parse\", f\"{merge_sha}^2\").strip()\n3161\t        commits = commits_since(root, f\"{first_spec_sha}^\", end=branch_tip, with_files=True)\n3162\t        commits += commits_since(root, f\"{merge_sha}^1\", end=merge_sha, with_files=True)\n3163\t    else:\n3164\t        commits = commits_since(root, f\"{first_spec_sha}^\", end=\"HEAD\", with_files=True)\n3165\t\n3166\t    driver = driver_identity()\n3167\t    rows: list[dict] = []\n3168\t    operator_acts = product_acts = executor_commits = 0\n3169\t    approval_seen = False\n3170\t    # Commits whose class (or \"since\") needs a record's own content --\n3171\t    # resolved below by one batched read (issue #153), not one `git show`\n3172\t    # per commit walked. row is the same dict already placed in rows, in\n3173\t    # commit order, filled in once content arrives.\n3174\t    pending: list[dict] = []\n3175\t\n3176\t    for c in commits:\n3177\t        sha, name, email, files = c[\"sha\"], c[\"name\"], c[\"email\"], c[\"files\"]\n3178\t\n3179\t        if merge_sha is not None and sha == merge_sha:\n3180\t            rows.append({\"sha\": sha, \"identity\": name, \"class\": \"merge\"})\n3181\t            operator_acts += 1\n3182\t            continue\n3183\t\n3184\t        if email.startswith(\"executor+\") and email.endswith(\"@attavo.invalid\"):\n3185\t            rows.append({\"sha\": sha, \"identity\": name, \"class\": \"change\"})\n3186\t            executor_commits += 1\n3187\t            continue\n3188\t\n3189\t        record_touch = None\n3190\t        for p in files:\n3191\t            if not p.startswith(records_prefix):\n3192\t                continue\n3193\t            rm = RECORD_RE.match(Path(p).name)\n3194\t            if rm and rm.group(1) in STAGES:\n3195\t                record_touch = (rm.group(1), p)\n3196\t                break\n3197\t\n3198\t        if record_touch is not None:\n3199\t            stage, relpath = record_touch\n3200\t            row = {\"sha\": sha, \"identity\": name}\n3201\t            rows.append(row)\n3202\t\n3203\t            if stage == \"approval\":\n3204\t                row[\"class\"] = \"approve\"\n3205\t                operator_acts += 1\n3206\t                approval_seen = True\n3207\t            else:\n3208\t                is_driver = name == driver[\"name\"] and email == driver[\"email\"]\n3209\t                is_records_app = _is_records_app(name)\n3210\t                if stage == \"spec\" or is_driver or is_records_app:\n3211\t                    row[\"class\"] = \"record\"\n3212\t                    product_acts += 1\n3213\t                # else: left unclassed here, decided below once content\n3214\t                # arrives (build/verify authored by a person).\n3215\t\n3216\t            pending.append({\"sha\": sha, \"relpath\": relpath, \"row\": row})\n3217\t            continue\n3218\t\n3219\t        if any(p.startswith(specs_prefix) for p in files):\n3220\t            cls = \"amend\" if approval_seen else \"spec\"\n3221\t            rows.append({\"sha\": sha, \"identity\": name, \"class\": cls})\n3222\t            if cls == \"amend\":\n3223\t                operator_acts += 1\n3224\t            continue\n3225\t\n3226\t        rows.append({\"sha\": sha, \"identity\": name, \"class\": \"transport\"})\n3227\t        operator_acts += 1\n3228\t\n3229\t    contents = _records_at_batch(root, [(p[\"sha\"], p[\"relpath\"]) for p in pending], item_id)\n3230\t    since = None\n3231\t    for p in pending:\n3232\t        content = contents.get((p[\"sha\"], p[\"relpath\"]), {})\n3233\t        if since is None:\n3234\t            since = content.get(\"product_version\")\n3235\t        row = p[\"row\"]\n3236\t        if \"class\" in row:\n3237\t            continue\n3238\t        version = _semver_tuple(content.get(\"product_version\"))\n3239\t        if version is not None and version < LEDGER_V018_CUTOFF:\n3240\t            row[\"class\"] = \"record-or-launch\"\n3241\t            row[\"note\"] = \"not distinguishable before v0.18.0\"\n3242\t        else:\n3243\t            row[\"class\"] = \"launch\"\n3244\t            operator_acts += 1\n3245\t\n3246\t    # issue #137: the same set attavo stops counts, from the same reader\n3247\t    # (item_stops) -- not a second, independent count kept in sync by\n3248\t    # hand. One non-pass record per row, whatever its stage; a gate\n3249\t    # refusal is included the same as a non-pass build or verify record.\n3250\t    stops = len(item_stops(root, m, item_id)[\"rows\"])\n3251\t\n3252\t    summary = {\"operator_acts\": operator_acts, \"product_acts\": product_acts,\n3253\t              \"executor_commits\": executor_commits, \"stops\": stops, \"since\": since}\n3254\t    return {\"item\": item_id, \"rows\": rows, \"summary\": summary}\n3255\t"}]},"parent_tool_use_id":null,"session_id":"6e2492c7-2a27-487f-99c4-d4ecc36025b0","uuid":"db004114-63ca-45b3-a53a-4bd49b25bee5","timestamp":"2026-09-17T16:17:53.712Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-153/bin/attavo","content":"def item_ledger(root: Path, m: dict, item_id: str) -> dict:\n    \"\"\"{\"item\", \"rows\", \"summary\"}: one row per act between item_id's first\n    spec commit and its merge (merge_introducing_records, the same\n    derivation doctor's proof two and attest both already read) or HEAD\n    when the item has not merged yet.\n\n    Each commit gets exactly one class, in this order: the merge commit\n    itself is \"merge\"; a commit authored by the executor identity\n    (executor_identity) is \"change\"; a commit introducing an approval\n    record is \"approve\", whoever committed it -- an operator's decision,\n    however it reached git; a commit introducing a spec-gate, build, or\n    verify record, authored by the driver identity (driver_identity) or\n    the records app, is \"record\"; the same, authored by a person, is\n    \"launch\" for build or verify (spec-gate records the app always\n    commits, in every template this product ships) -- unless that\n    record's own product_version predates v0.18.0, when driver_identity\n    did not yet exist to tell the two apart, and the row is\n    \"record-or-launch\" with a note, counted in neither summary total\n    rather than guessed; a person's commit touching the spec is \"spec\"\n    before the first approval record and \"amend\" after; anything else by\n    a person is \"transport\" (a merge of main among them).\"\"\"\n    specs_rel = m[\"paths\"][\"specs\"]\n    records_rel = m[\"paths\"][\"records\"]\n    specs_prefix = f\"{specs_rel.rstrip('/')}/{item_id}/\"\n    records_prefix = f\"{records_rel.rstrip('/')}/{item_id}/\"\n    empty_summary = {\"operator_acts\": 0, \"product_acts\": 0, \"executor_commits\": 0,\n                     \"stops\": 0, \"since\": None}\n\n    first_spec_sha = first_commit_touching(root, str(Path(specs_rel) / item_id))\n    if first_spec_sha is None:\n        return {\"item\": item_id, \"rows\": [], \"summary\": empty_summary}\n\n    merge_sha = merge_introducing_records(root, records_rel, item_id, STAGES)\n    if merge_sha is not None:\n        branch_tip = git(root, \"rev-parse\", f\"{merge_sha}^2\").strip()\n        commits = commits_since(root, f\"{first_spec_sha}^\", end=branch_tip, with_files=True)\n        commits += commits_since(root, f\"{merge_sha}^1\", end=merge_sha, with_files=True)\n    else:\n        commits = commits_since(root, f\"{first_spec_sha}^\", end=\"HEAD\", with_files=True)\n\n    driver = driver_identity()\n    rows: list[dict] = []\n    operator_acts = product_acts = executor_commits = 0\n    approval_seen = False\n    # Commits whose class (or \"since\") needs a record's own content --\n    # resolved below by one batched read (issue #153), not one `git show`\n    # per commit walked. row is the same dict already placed in rows, in\n    # commit order, filled in once content arrives.\n    pending: list[dict] = []\n\n    for c in commits:\n        sha, name, email, files = c[\"sha\"], c[\"name\"], c[\"email\"], c[\"files\"]\n\n        if merge_sha is not None and sha == merge_sha:\n            rows.append({\"sha\": sha, \"identity\": name, \"class\": \"merge\"})\n            operator_acts += 1\n            continue\n\n        if email.startswith(\"executor+\") and email.endswith(\"@attavo.invalid\"):\n            rows.append({\"sha\": sha, \"identity\": name, \"class\": \"change\"})\n            executor_commits += 1\n            continue\n\n        record_touch = None\n        for p in files:\n            if not p.startswith(records_prefix):\n                continue\n            rm = RECORD_RE.match(Path(p).name)\n            if rm and rm.group(1) in STAGES:\n                record_touch = (rm.group(1), p)\n                break\n\n        if record_touch is not None:\n            stage, relpath = record_touch\n            row = {\"sha\": sha, \"identity\": name}\n            rows.append(row)\n\n            if stage == \"approval\":\n                row[\"class\"] = \"approve\"\n                operator_acts += 1\n                approval_seen = True\n            else:\n                is_driver = name == driver[\"name\"] and email == driver[\"email\"]\n                is_records_app = _is_records_app(name)\n                if stage == \"spec\" or is_driver or is_records_app:\n                    row[\"class\"] = \"record\"\n                    product_acts += 1\n                # else: left unclassed here, decided below once content\n                # arrives (build/verify authored by a person).\n\n            pending.append({\"sha\": sha, \"relpath\": relpath, \"row\": row})\n            continue\n\n        if any(p.startswith(specs_prefix) for p in files):\n            cls = \"amend\" if approval_seen else \"spec\"\n            rows.append({\"sha\": sha, \"identity\": name, \"class\": cls})\n            if cls == \"amend\":\n                operator_acts += 1\n            continue\n\n        rows.append({\"sha\": sha, \"identity\": name, \"class\": \"transport\"})\n        operator_acts += 1\n\n    contents = _records_at_batch(root, [(p[\"sha\"], p[\"relpath\"]) for p in pending], item_id)\n    since = None\n    for p in pending:\n        content = contents.get((p[\"sha\"], p[\"relpath\"]), {})\n        if since is None:\n            since = content.get(\"product_version\")\n        row = p[\"row\"]\n        if \"class\" in row:\n            continue\n        version = _semver_tuple(content.get(\"product_version\"))\n        if version is not None and version < LEDGER_V018_CUTOFF:\n            row[\"class\"] = \"record-or-launch\"\n            row[\"note\"] = \"not distinguishable before v0.18.0\"\n        else:\n            row[\"class\"] = \"launch\"\n            operator_acts += 1\n\n    # issue #137: the same set attavo stops counts, from the same reader\n    # (item_stops) -- not a second, independent count kept in sync by\n    # hand. One non-pass record per row, whatever its stage; a gate\n    # refusal is included the same as a non-pass build or verify record.\n    stops = len(item_stops(root, m, item_id)[\"rows\"])\n\n    summary = {\"operator_acts\": operator_acts, \"product_acts\": product_acts,\n              \"executor_commits\": executor_commits, \"stops\": stops, \"since\": since}\n    return {\"item\": item_id, \"rows\": rows, \"summary\": summary}\n","numLines":130,"startLine":3126,"totalLines":3452}}}

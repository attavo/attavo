{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LhJz6J6hf5z7KL9N6SpJ8M","type":"tool_result","content":"3030\t    m = re.match(r\"^v(\\d+)\\.(\\d+)\\.(\\d+)\", version or \"\")\n3031\t    return (int(m.group(1)), int(m.group(2)), int(m.group(3))) if m else None\n3032\t\n3033\t\n3034\tdef _is_records_app(name: str) -> bool:\n3035\t    \"\"\"The forge's own app-bot login -- exactly the identity the\n3036\t    attavo-spec-gate and attavo-approve templates commit spec-gate and\n3037\t    approval records as (an app-token step mints it at run time from the\n3038\t    tenant's own app credentials): \"<app-slug>[bot]\". Never a name this\n3039\t    product can name in advance, so the one fact it can check is the\n3040\t    shape the forge itself gives every app identity, not a specific one.\"\"\"\n3041\t    return name.endswith(\"[bot]\")\n3042\t\n3043\t\n3044\tdef first_commit_touching(root: Path, relpath: str) -> str | None:\n3045\t    \"\"\"The earliest commit touching relpath -- the mirror of\n3046\t    last_commit_touching, which answers the latest. Ledger's own walk\n3047\t    starts here: the item's first spec commit.\"\"\"\n3048\t    out = git(root, \"log\", \"--reverse\", \"--format=%H\", \"--\", relpath)\n3049\t    lines = out.split()\n3050\t    return lines[0] if lines else None\n3051\t\n3052\t\n3053\tdef _commit_touches(root: Path, sha: str) -> list[str]:\n3054\t    return git(root, \"diff\", \"--name-only\", f\"{sha}^1\", sha).splitlines()\n3055\t\n3056\t\n3057\tdef _record_at(root: Path, sha: str, relpath: str, item_id: str) -> dict:\n3058\t    \"\"\"A record's own dict at a past commit, not the working tree --\n3059\t    ledger's only need for one (issue #128). Read through _load_record\n3060\t    (issue #60, acceptance 6: the one place a record's bytes become a\n3061\t    dict) by spilling the blob to a throwaway file, rather than a second\n3062\t    json.loads of its own: `git show` has no path on disk to hand\n3063\t    _load_record directly.\"\"\"\n3064\t    out = subprocess.run([\"git\", \"-C\", str(root), \"show\", f\"{sha}:{relpath}\"],\n3065\t                         capture_output=True, text=True, check=False)\n3066\t    if out.returncode != 0:\n3067\t        return {}\n3068\t    with tempfile.NamedTemporaryFile(\"w\", suffix=\".json\", delete=False) as fh:\n3069\t        fh.write(out.stdout)\n3070\t        blob_path = Path(fh.name)\n3071\t    try:\n3072\t        return _load_record(blob_path, item_id)\n3073\t    except json.JSONDecodeError:\n3074\t        return {}\n3075\t    finally:\n3076\t        blob_path.unlink(missing_ok=True)\n3077\t\n3078\t\n3079\tdef item_ledger(root: Path, m: dict, item_id: str) -> dict:\n3080\t    \"\"\"{\"item\", \"rows\", \"summary\"}: one row per act between item_id's first\n3081\t    spec commit and its merge (merge_introducing_records, the same\n3082\t    derivation doctor's proof two and attest both already read) or HEAD\n3083\t    when the item has not merged yet.\n3084\t\n3085\t    Each commit gets exactly one class, in this order: the merge commit\n3086\t    itself is \"merge\"; a commit authored by the executor identity\n3087\t    (executor_identity) is \"change\"; a commit introducing an approval\n3088\t    record is \"approve\", whoever committed it -- an operator's decision,\n3089\t    however it reached git; a commit introducing a spec-gate, build, or\n3090\t    verify record, authored by the driver identity (driver_identity) or\n3091\t    the records app, is \"record\"; the same, authored by a person, is\n3092\t    \"launch\" for build or verify (spec-gate records the app always\n3093\t    commits, in every template this product ships) -- unless that\n3094\t    record's own product_version predates v0.18.0, when driver_identity\n3095\t    did not yet exist to tell the two apart, and the row is\n3096\t    \"record-or-launch\" with a note, counted in neither summary total\n3097\t    rather than guessed; a person's commit touching the spec is \"spec\"\n3098\t    before the first approval record and \"amend\" after; anything else by\n3099\t    a person is \"transport\" (a merge of main among them).\"\"\"\n3100\t    specs_rel = m[\"paths\"][\"specs\"]\n3101\t    records_rel = m[\"paths\"][\"records\"]\n3102\t    specs_prefix = f\"{specs_rel.rstrip('/')}/{item_id}/\"\n3103\t    records_prefix = f\"{records_rel.rstrip('/')}/{item_id}/\"\n3104\t    empty_summary = {\"operator_acts\": 0, \"product_acts\": 0, \"executor_commits\": 0,\n3105\t                     \"stops\": 0, \"since\": None}\n3106\t\n3107\t    first_spec_sha = first_commit_touching(root, str(Path(specs_rel) / item_id))\n3108\t    if first_spec_sha is None:\n3109\t        return {\"item\": item_id, \"rows\": [], \"summary\": empty_summary}\n3110\t\n3111\t    merge_sha = merge_introducing_records(root, records_rel, item_id, STAGES)\n3112\t    if merge_sha is not None:\n3113\t        branch_tip = git(root, \"rev-parse\", f\"{merge_sha}^2\").strip()\n3114\t        commits = commits_since(root, f\"{first_spec_sha}^\", end=branch_tip)\n3115\t        commits += commits_since(root, f\"{merge_sha}^1\", end=merge_sha)\n3116\t    else:\n3117\t        commits = commits_since(root, f\"{first_spec_sha}^\", end=\"HEAD\")\n3118\t\n3119\t    driver = driver_identity()\n3120\t    rows: list[dict] = []\n3121\t    operator_acts = product_acts = executor_commits = 0\n3122\t    since = None\n3123\t    approval_seen = False\n3124\t\n3125\t    for c in commits:\n3126\t        sha, name, email = c[\"sha\"], c[\"name\"], c[\"email\"]\n3127\t\n3128\t        if merge_sha is not None and sha == merge_sha:\n3129\t            rows.append({\"sha\": sha, \"identity\": name, \"class\": \"merge\"})\n3130\t            operator_acts += 1\n3131\t            continue\n3132\t\n3133\t        if email.startswith(\"executor+\") and email.endswith(\"@attavo.invalid\"):\n3134\t            rows.append({\"sha\": sha, \"identity\": name, \"class\": \"change\"})\n3135\t            executor_commits += 1\n3136\t            continue\n3137\t\n3138\t        touched = _commit_touches(root, sha)\n3139\t        record_touch = None\n3140\t        for p in touched:\n3141\t            if not p.startswith(records_prefix):\n3142\t                continue\n3143\t            rm = RECORD_RE.match(Path(p).name)\n3144\t            if rm and rm.group(1) in STAGES:\n3145\t                record_touch = (rm.group(1), p)\n3146\t                break\n3147\t\n3148\t        if record_touch is not None:\n3149\t            stage, relpath = record_touch\n3150\t            content = _record_at(root, sha, relpath, item_id)\n3151\t            if since is None:\n3152\t                since = content.get(\"product_version\")\n3153\t\n3154\t            if stage == \"approval\":\n3155\t                rows.append({\"sha\": sha, \"identity\": name, \"class\": \"approve\"})\n3156\t                operator_acts += 1\n3157\t                approval_seen = True\n3158\t                continue\n3159\t\n3160\t            is_driver = name == driver[\"name\"] and email == driver[\"email\"]\n3161\t            is_records_app = _is_records_app(name)\n3162\t            if stage == \"spec\" or is_driver or is_records_app:\n3163\t                rows.append({\"sha\": sha, \"identity\": name, \"class\": \"record\"})\n3164\t                product_acts += 1\n3165\t                continue\n3166\t\n3167\t            version = _semver_tuple(content.get(\"product_version\"))\n3168\t            if version is not None and version < LEDGER_V018_CUTOFF:\n3169\t                rows.append({\"sha\": sha, \"identity\": name, \"class\": \"record-or-launch\",\n3170\t                            \"note\": \"not distinguishable before v0.18.0\"})\n3171\t                continue\n3172\t\n3173\t            rows.append({\"sha\": sha, \"identity\": name, \"class\": \"launch\"})\n3174\t            operator_acts += 1\n3175\t            continue\n3176\t\n3177\t        if any(p.startswith(specs_prefix) for p in touched):\n3178\t            cls = \"amend\" if approval_seen else \"spec\"\n3179\t            rows.append({\"sha\": sha, \"identity\": name, \"class\": cls})\n3180\t            if cls == \"amend\":\n3181\t                operator_acts += 1\n3182\t            continue\n3183\t\n3184\t        rows.append({\"sha\": sha, \"identity\": name, \"class\": \"transport\"})\n3185\t        operator_acts += 1\n3186\t\n3187\t    # issue #137: the same set attavo stops counts, from the same reader\n3188\t    # (item_stops) -- not a second, independent count kept in sync by\n3189\t    # hand. One non-pass record per row, whatever its stage; a gate\n3190\t    # refusal is included the same as a non-pass build or verify record.\n3191\t    stops = len(item_stops(root, m, item_id)[\"rows\"])\n3192\t\n3193\t    summary = {\"operator_acts\": operator_acts, \"product_acts\": product_acts,\n3194\t              \"executor_commits\": executor_commits, \"stops\": stops, \"since\": since}\n3195\t    return {\"item\": item_id, \"rows\": rows, \"summary\": summary}\n3196\t\n3197\t\n3198\tdef cmd_ledger(argv: list[str]) -> int:\n3199\t    as_json = \"--json\" in argv\n3200\t    positional = [a for a in argv if a != \"--json\"]\n3201\t    root = Path(\".\").resolve()\n3202\t    m = read_manifest(root)\n3203\t    if m is None:\n3204\t        print(f\"attavo ledger: no {MANIFEST} at {root}\", file=sys.stderr)\n3205\t        return 2\n3206\t\n3207\t    records_rel = m[\"paths\"][\"records\"]\n3208\t    if positional:\n3209\t        item_ids = [positional[0]]\n3210\t    else:\n3211\t        records_root = root / records_rel\n3212\t        item_ids = (sorted((p.name for p in records_root.iterdir() if p.is_dir()))\n3213\t                   if records_root.is_dir() else [])\n3214\t\n3215\t    ledgers = [item_ledger(root, m, item_id) for item_id in item_ids]\n3216\t\n3217\t    if as_json:\n3218\t        if positional:\n3219\t            print(json.dumps(ledgers[0], indent=2))\n3220\t        else:\n3221\t            print(json.dumps({\"items\": ledgers}, indent=2))\n3222\t        return 0\n3223\t\n3224\t    for entry in ledgers:\n3225\t        print(f\"attavo ledger: item {entry['item']}\")\n3226\t        for row in entry[\"rows\"]:\n3227\t            note = f\"  ({row['note']})\" if \"note\" in row else \"\"\n3228\t            print(f\"  {row['sha'][:12]}  {row['identity']:<32}  {row['class']}{note}\")\n3229\t        s = entry[\"summary\"]\n3230\t        print(f\"  operator acts: {s['operator_acts']}  product acts: {s['product_acts']}  \"\n3231\t             f\"executor commits: {s['executor_commits']}  stops: {s['stops']}  \"\n3232\t             f\"since: {s['since']}\")\n3233\t    if not ledgers:\n3234\t        print(f\"attavo ledger: no item found under {records_rel}\")\n3235\t    return 0\n3236\t\n3237\t\n3238\t# --- stops: every non-pass record by class, provenance, and answerer\n3239\t# (issue #129) ---\n3240\t\n3241\tdef item_stops(root: Path, m: dict, item_id: str) -> dict:\n3242\t    \"\"\"{\"item\", \"rows\", \"totals\"}: one row per non-pass build or verify\n3243\t    record (STOP_STAGES), plus every refused spec-gate record (issue\n3244\t    #133), class \"gate\" (issue #137) -- read from status and refusal\n3245\t    rather than a stop field spec-gate records never carry (gate_stop\n3246\t    synthesizes it) -- under item_id, whatever the record's own\n3247\t    record_version -- a record too old to carry stop at all still gets\n3248\t    a row, its class printed as the doctor's own phrase for it.\n3249\t"}]},"parent_tool_use_id":null,"session_id":"6e2492c7-2a27-487f-99c4-d4ecc36025b0","uuid":"43fbfa1d-77f4-4b1c-967b-0b2604a96578","timestamp":"2026-09-17T16:12:23.284Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-153/bin/attavo","content":"    m = re.match(r\"^v(\\d+)\\.(\\d+)\\.(\\d+)\", version or \"\")\n    return (int(m.group(1)), int(m.group(2)), int(m.group(3))) if m else None\n\n\ndef _is_records_app(name: str) -> bool:\n    \"\"\"The forge's own app-bot login -- exactly the identity the\n    attavo-spec-gate and attavo-approve templates commit spec-gate and\n    approval records as (an app-token step mints it at run time from the\n    tenant's own app credentials): \"<app-slug>[bot]\". Never a name this\n    product can name in advance, so the one fact it can check is the\n    shape the forge itself gives every app identity, not a specific one.\"\"\"\n    return name.endswith(\"[bot]\")\n\n\ndef first_commit_touching(root: Path, relpath: str) -> str | None:\n    \"\"\"The earliest commit touching relpath -- the mirror of\n    last_commit_touching, which answers the latest. Ledger's own walk\n    starts here: the item's first spec commit.\"\"\"\n    out = git(root, \"log\", \"--reverse\", \"--format=%H\", \"--\", relpath)\n    lines = out.split()\n    return lines[0] if lines else None\n\n\ndef _commit_touches(root: Path, sha: str) -> list[str]:\n    return git(root, \"diff\", \"--name-only\", f\"{sha}^1\", sha).splitlines()\n\n\ndef _record_at(root: Path, sha: str, relpath: str, item_id: str) -> dict:\n    \"\"\"A record's own dict at a past commit, not the working tree --\n    ledger's only need for one (issue #128). Read through _load_record\n    (issue #60, acceptance 6: the one place a record's bytes become a\n    dict) by spilling the blob to a throwaway file, rather than a second\n    json.loads of its own: `git show` has no path on disk to hand\n    _load_record directly.\"\"\"\n    out = subprocess.run([\"git\", \"-C\", str(root), \"show\", f\"{sha}:{relpath}\"],\n                         capture_output=True, text=True, check=False)\n    if out.returncode != 0:\n        return {}\n    with tempfile.NamedTemporaryFile(\"w\", suffix=\".json\", delete=False) as fh:\n        fh.write(out.stdout)\n        blob_path = Path(fh.name)\n    try:\n        return _load_record(blob_path, item_id)\n    except json.JSONDecodeError:\n        return {}\n    finally:\n        blob_path.unlink(missing_ok=True)\n\n\ndef item_ledger(root: Path, m: dict, item_id: str) -> dict:\n    \"\"\"{\"item\", \"rows\", \"summary\"}: one row per act between item_id's first\n    spec commit and its merge (merge_introducing_records, the same\n    derivation doctor's proof two and attest both already read) or HEAD\n    when the item has not merged yet.\n\n    Each commit gets exactly one class, in this order: the merge commit\n    itself is \"merge\"; a commit authored by the executor identity\n    (executor_identity) is \"change\"; a commit introducing an approval\n    record is \"approve\", whoever committed it -- an operator's decision,\n    however it reached git; a commit introducing a spec-gate, build, or\n    verify record, authored by the driver identity (driver_identity) or\n    the records app, is \"record\"; the same, authored by a person, is\n    \"launch\" for build or verify (spec-gate records the app always\n    commits, in every template this product ships) -- unless that\n    record's own product_version predates v0.18.0, when driver_identity\n    did not yet exist to tell the two apart, and the row is\n    \"record-or-launch\" with a note, counted in neither summary total\n    rather than guessed; a person's commit touching the spec is \"spec\"\n    before the first approval record and \"amend\" after; anything else by\n    a person is \"transport\" (a merge of main among them).\"\"\"\n    specs_rel = m[\"paths\"][\"specs\"]\n    records_rel = m[\"paths\"][\"records\"]\n    specs_prefix = f\"{specs_rel.rstrip('/')}/{item_id}/\"\n    records_prefix = f\"{records_rel.rstrip('/')}/{item_id}/\"\n    empty_summary = {\"operator_acts\": 0, \"product_acts\": 0, \"executor_commits\": 0,\n                     \"stops\": 0, \"since\": None}\n\n    first_spec_sha = first_commit_touching(root, str(Path(specs_rel) / item_id))\n    if first_spec_sha is None:\n        return {\"item\": item_id, \"rows\": [], \"summary\": empty_summary}\n\n    merge_sha = merge_introducing_records(root, records_rel, item_id, STAGES)\n    if merge_sha is not None:\n        branch_tip = git(root, \"rev-parse\", f\"{merge_sha}^2\").strip()\n        commits = commits_since(root, f\"{first_spec_sha}^\", end=branch_tip)\n        commits += commits_since(root, f\"{merge_sha}^1\", end=merge_sha)\n    else:\n        commits = commits_since(root, f\"{first_spec_sha}^\", end=\"HEAD\")\n\n    driver = driver_identity()\n    rows: list[dict] = []\n    operator_acts = product_acts = executor_commits = 0\n    since = None\n    approval_seen = False\n\n    for c in commits:\n        sha, name, email = c[\"sha\"], c[\"name\"], c[\"email\"]\n\n        if merge_sha is not None and sha == merge_sha:\n            rows.append({\"sha\": sha, \"identity\": name, \"class\": \"merge\"})\n            operator_acts += 1\n            continue\n\n        if email.startswith(\"executor+\") and email.endswith(\"@attavo.invalid\"):\n            rows.append({\"sha\": sha, \"identity\": name, \"class\": \"change\"})\n            executor_commits += 1\n            continue\n\n        touched = _commit_touches(root, sha)\n        record_touch = None\n        for p in touched:\n            if not p.startswith(records_prefix):\n                continue\n            rm = RECORD_RE.match(Path(p).name)\n            if rm and rm.group(1) in STAGES:\n                record_touch = (rm.group(1), p)\n                break\n\n        if record_touch is not None:\n            stage, relpath = record_touch\n            content = _record_at(root, sha, relpath, item_id)\n            if since is None:\n                since = content.get(\"product_version\")\n\n            if stage == \"approval\":\n                rows.append({\"sha\": sha, \"identity\": name, \"class\": \"approve\"})\n                operator_acts += 1\n                approval_seen = True\n                continue\n\n            is_driver = name == driver[\"name\"] and email == driver[\"email\"]\n            is_records_app = _is_records_app(name)\n            if stage == \"spec\" or is_driver or is_records_app:\n                rows.append({\"sha\": sha, \"identity\": name, \"class\": \"record\"})\n                product_acts += 1\n                continue\n\n            version = _semver_tuple(content.get(\"product_version\"))\n            if version is not None and version < LEDGER_V018_CUTOFF:\n                rows.append({\"sha\": sha, \"identity\": name, \"class\": \"record-or-launch\",\n                            \"note\": \"not distinguishable before v0.18.0\"})\n                continue\n\n            rows.append({\"sha\": sha, \"identity\": name, \"class\": \"launch\"})\n            operator_acts += 1\n            continue\n\n        if any(p.startswith(specs_prefix) for p in touched):\n            cls = \"amend\" if approval_seen else \"spec\"\n            rows.append({\"sha\": sha, \"identity\": name, \"class\": cls})\n            if cls == \"amend\":\n                operator_acts += 1\n            continue\n\n        rows.append({\"sha\": sha, \"identity\": name, \"class\": \"transport\"})\n        operator_acts += 1\n\n    # issue #137: the same set attavo stops counts, from the same reader\n    # (item_stops) -- not a second, independent count kept in sync by\n    # hand. One non-pass record per row, whatever its stage; a gate\n    # refusal is included the same as a non-pass build or verify record.\n    stops = len(item_stops(root, m, item_id)[\"rows\"])\n\n    summary = {\"operator_acts\": operator_acts, \"product_acts\": product_acts,\n              \"executor_commits\": executor_commits, \"stops\": stops, \"since\": since}\n    return {\"item\": item_id, \"rows\": rows, \"summary\": summary}\n\n\ndef cmd_ledger(argv: list[str]) -> int:\n    as_json = \"--json\" in argv\n    positional = [a for a in argv if a != \"--json\"]\n    root = Path(\".\").resolve()\n    m = read_manifest(root)\n    if m is None:\n        print(f\"attavo ledger: no {MANIFEST} at {root}\", file=sys.stderr)\n        return 2\n\n    records_rel = m[\"paths\"][\"records\"]\n    if positional:\n        item_ids = [positional[0]]\n    else:\n        records_root = root / records_rel\n        item_ids = (sorted((p.name for p in records_root.iterdir() if p.is_dir()))\n                   if records_root.is_dir() else [])\n\n    ledgers = [item_ledger(root, m, item_id) for item_id in item_ids]\n\n    if as_json:\n        if positional:\n            print(json.dumps(ledgers[0], indent=2))\n        else:\n            print(json.dumps({\"items\": ledgers}, indent=2))\n        return 0\n\n    for entry in ledgers:\n        print(f\"attavo ledger: item {entry['item']}\")\n        for row in entry[\"rows\"]:\n            note = f\"  ({row['note']})\" if \"note\" in row else \"\"\n            print(f\"  {row['sha'][:12]}  {row['identity']:<32}  {row['class']}{note}\")\n        s = entry[\"summary\"]\n        print(f\"  operator acts: {s['operator_acts']}  product acts: {s['product_acts']}  \"\n             f\"executor commits: {s['executor_commits']}  stops: {s['stops']}  \"\n             f\"since: {s['since']}\")\n    if not ledgers:\n        print(f\"attavo ledger: no item found under {records_rel}\")\n    return 0\n\n\n# --- stops: every non-pass record by class, provenance, and answerer\n# (issue #129) ---\n\ndef item_stops(root: Path, m: dict, item_id: str) -> dict:\n    \"\"\"{\"item\", \"rows\", \"totals\"}: one row per non-pass build or verify\n    record (STOP_STAGES), plus every refused spec-gate record (issue\n    #133), class \"gate\" (issue #137) -- read from status and refusal\n    rather than a stop field spec-gate records never carry (gate_stop\n    synthesizes it) -- under item_id, whatever the record's own\n    record_version -- a record too old to carry stop at all still gets\n    a row, its class printed as the doctor's own phrase for it.\n","numLines":220,"startLine":3030,"totalLines":3393}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TBHeQ7rcngwc2RCYdEvjsD","type":"tool_result","content":"3084\tdef _commit_touches(root: Path, sha: str) -> list[str]:\n3085\t    return git(root, \"diff\", \"--name-only\", f\"{sha}^1\", sha).splitlines()\n3086\t\n3087\t\n3088\tdef _record_at(root: Path, sha: str, relpath: str, item_id: str) -> dict:\n3089\t    \"\"\"A record's own dict at a past commit, not the working tree --\n3090\t    ledger's only need for one (issue #128). Read through _load_record\n3091\t    (issue #60, acceptance 6: the one place a record's bytes become a\n3092\t    dict) by spilling the blob to a throwaway file, rather than a second\n3093\t    json.loads of its own: `git show` has no path on disk to hand\n3094\t    _load_record directly.\"\"\"\n3095\t    out = subprocess.run([\"git\", \"-C\", str(root), \"show\", f\"{sha}:{relpath}\"],\n3096\t                         capture_output=True, text=True, check=False)\n3097\t    if out.returncode != 0:\n3098\t        return {}\n3099\t    with tempfile.NamedTemporaryFile(\"w\", suffix=\".json\", delete=False) as fh:\n3100\t        fh.write(out.stdout)\n3101\t        blob_path = Path(fh.name)\n3102\t    try:\n3103\t        return _load_record(blob_path, item_id)\n3104\t    except json.JSONDecodeError:\n3105\t        return {}\n3106\t    finally:\n3107\t        blob_path.unlink(missing_ok=True)\n3108\t\n3109\t\n3110\tdef item_ledger(root: Path, m: dict, item_id: str) -> dict:\n3111\t    \"\"\"{\"item\", \"rows\", \"summary\"}: one row per act between item_id's first\n3112\t    spec commit and its merge (merge_introducing_records, the same\n3113\t    derivation doctor's proof two and attest both already read) or HEAD\n3114\t    when the item has not merged yet.\n3115\t\n3116\t    Each commit gets exactly one class, in this order: the merge commit\n3117\t    itself is \"merge\"; a commit authored by the executor identity\n3118\t    (executor_identity) is \"change\"; a commit introducing an approval\n3119\t    record is \"approve\", whoever committed it -- an operator's decision,\n3120\t    however it reached git; a commit introducing a spec-gate, build, or\n3121\t    verify record, authored by the driver identity (driver_identity) or\n3122\t    the records app, is \"record\"; the same, authored by a person, is\n3123\t    \"launch\" for build or verify (spec-gate records the app always\n3124\t    commits, in every template this product ships) -- unless that\n3125\t    record's own product_version predates v0.18.0, when driver_identity\n3126\t    did not yet exist to tell the two apart, and the row is\n3127\t    \"record-or-launch\" with a note, counted in neither summary total\n3128\t    rather than guessed; a person's commit touching the spec is \"spec\"\n3129\t    before the first approval record and \"amend\" after; anything else by\n3130\t    a person is \"transport\" (a merge of main among them).\"\"\"\n3131\t    specs_rel = m[\"paths\"][\"specs\"]\n3132\t    records_rel = m[\"paths\"][\"records\"]\n3133\t    specs_prefix = f\"{specs_rel.rstrip('/')}/{item_id}/\"\n3134\t    records_prefix = f\"{records_rel.rstrip('/')}/{item_id}/\"\n3135\t    empty_summary = {\"operator_acts\": 0, \"product_acts\": 0, \"executor_commits\": 0,\n3136\t                     \"stops\": 0, \"since\": None}\n3137\t\n3138\t    first_spec_sha = first_commit_touching(root, str(Path(specs_rel) / item_id))\n3139\t    if first_spec_sha is None:\n3140\t        return {\"item\": item_id, \"rows\": [], \"summary\": empty_summary}\n3141\t\n3142\t    merge_sha = merge_introducing_records(root, records_rel, item_id, STAGES)\n3143\t    if merge_sha is not None:\n3144\t        branch_tip = git(root, \"rev-parse\", f\"{merge_sha}^2\").strip()\n3145\t        commits = commits_since(root, f\"{first_spec_sha}^\", end=branch_tip)\n3146\t        commits += commits_since(root, f\"{merge_sha}^1\", end=merge_sha)\n3147\t    else:\n3148\t        commits = commits_since(root, f\"{first_spec_sha}^\", end=\"HEAD\")\n3149\t\n3150\t    driver = driver_identity()\n3151\t    rows: list[dict] = []\n3152\t    operator_acts = product_acts = executor_commits = 0\n3153\t    since = None\n3154\t    approval_seen = False\n3155\t\n3156\t    for c in commits:\n3157\t        sha, name, email = c[\"sha\"], c[\"name\"], c[\"email\"]\n3158\t\n3159\t        if merge_sha is not None and sha == merge_sha:\n3160\t            rows.append({\"sha\": sha, \"identity\": name, \"class\": \"merge\"})\n3161\t            operator_acts += 1\n3162\t            continue\n3163\t\n3164\t        if email.startswith(\"executor+\") and email.endswith(\"@attavo.invalid\"):\n3165\t            rows.append({\"sha\": sha, \"identity\": name, \"class\": \"change\"})\n3166\t            executor_commits += 1\n3167\t            continue\n3168\t\n3169\t        touched = _commit_touches(root, sha)\n3170\t        record_touch = None\n3171\t        for p in touched:\n3172\t            if not p.startswith(records_prefix):\n3173\t                continue\n3174\t            rm = RECORD_RE.match(Path(p).name)\n3175\t            if rm and rm.group(1) in STAGES:\n3176\t                record_touch = (rm.group(1), p)\n3177\t                break\n3178\t\n3179\t        if record_touch is not None:\n3180\t            stage, relpath = record_touch\n3181\t            content = _record_at(root, sha, relpath, item_id)\n3182\t            if since is None:\n3183\t                since = content.get(\"product_version\")\n3184\t\n3185\t            if stage == \"approval\":\n3186\t                rows.append({\"sha\": sha, \"identity\": name, \"class\": \"approve\"})\n3187\t                operator_acts += 1\n3188\t                approval_seen = True\n3189\t                continue\n3190\t\n3191\t            is_driver = name == driver[\"name\"] and email == driver[\"email\"]\n3192\t            is_records_app = _is_records_app(name)\n3193\t            if stage == \"spec\" or is_driver or is_records_app:\n3194\t                rows.append({\"sha\": sha, \"identity\": name, \"class\": \"record\"})\n3195\t                product_acts += 1\n3196\t                continue\n3197\t\n3198\t            version = _semver_tuple(content.get(\"product_version\"))\n3199\t            if version is not None and version < LEDGER_V018_CUTOFF:\n3200\t                rows.append({\"sha\": sha, \"identity\": name, \"class\": \"record-or-launch\",\n3201\t                            \"note\": \"not distinguishable before v0.18.0\"})\n3202\t                continue\n3203\t\n3204\t            rows.append({\"sha\": sha, \"identity\": name, \"class\": \"launch\"})\n3205\t            operator_acts += 1\n3206\t            continue\n3207\t\n3208\t        if any(p.startswith(specs_prefix) for p in touched):\n3209\t            cls = \"amend\" if approval_seen else \"spec\"\n3210\t            rows.append({\"sha\": sha, \"identity\": name, \"class\": cls})\n3211\t            if cls == \"amend\":\n3212\t                operator_acts += 1\n3213\t            continue\n3214\t\n3215\t        rows.append({\"sha\": sha, \"identity\": name, \"class\": \"transport\"})\n3216\t        operator_acts += 1\n3217\t\n3218\t    # issue #137: the same set attavo stops counts, from the same reader\n3219\t    # (item_stops) -- not a second, independent count kept in sync by\n3220\t    # hand. One non-pass record per row, whatever its stage; a gate\n3221\t    # refusal is included the same as a non-pass build or verify record.\n3222\t    stops = len(item_stops(root, m, item_id)[\"rows\"])\n3223\t\n3224\t    summary = {\"operator_acts\": operator_acts, \"product_acts\": product_acts,\n3225\t              \"executor_commits\": executor_commits, \"stops\": stops, \"since\": since}\n3226\t    return {\"item\": item_id, \"rows\": rows, \"summary\": summary}\n3227\t\n3228\t"}]},"parent_tool_use_id":null,"session_id":"6e2492c7-2a27-487f-99c4-d4ecc36025b0","uuid":"f334af0c-5704-402b-8f5b-e77e1b67b233","timestamp":"2026-09-17T16:17:24.562Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-153/bin/attavo","content":"def _commit_touches(root: Path, sha: str) -> list[str]:\n    return git(root, \"diff\", \"--name-only\", f\"{sha}^1\", sha).splitlines()\n\n\ndef _record_at(root: Path, sha: str, relpath: str, item_id: str) -> dict:\n    \"\"\"A record's own dict at a past commit, not the working tree --\n    ledger's only need for one (issue #128). Read through _load_record\n    (issue #60, acceptance 6: the one place a record's bytes become a\n    dict) by spilling the blob to a throwaway file, rather than a second\n    json.loads of its own: `git show` has no path on disk to hand\n    _load_record directly.\"\"\"\n    out = subprocess.run([\"git\", \"-C\", str(root), \"show\", f\"{sha}:{relpath}\"],\n                         capture_output=True, text=True, check=False)\n    if out.returncode != 0:\n        return {}\n    with tempfile.NamedTemporaryFile(\"w\", suffix=\".json\", delete=False) as fh:\n        fh.write(out.stdout)\n        blob_path = Path(fh.name)\n    try:\n        return _load_record(blob_path, item_id)\n    except json.JSONDecodeError:\n        return {}\n    finally:\n        blob_path.unlink(missing_ok=True)\n\n\ndef item_ledger(root: Path, m: dict, item_id: str) -> dict:\n    \"\"\"{\"item\", \"rows\", \"summary\"}: one row per act between item_id's first\n    spec commit and its merge (merge_introducing_records, the same\n    derivation doctor's proof two and attest both already read) or HEAD\n    when the item has not merged yet.\n\n    Each commit gets exactly one class, in this order: the merge commit\n    itself is \"merge\"; a commit authored by the executor identity\n    (executor_identity) is \"change\"; a commit introducing an approval\n    record is \"approve\", whoever committed it -- an operator's decision,\n    however it reached git; a commit introducing a spec-gate, build, or\n    verify record, authored by the driver identity (driver_identity) or\n    the records app, is \"record\"; the same, authored by a person, is\n    \"launch\" for build or verify (spec-gate records the app always\n    commits, in every template this product ships) -- unless that\n    record's own product_version predates v0.18.0, when driver_identity\n    did not yet exist to tell the two apart, and the row is\n    \"record-or-launch\" with a note, counted in neither summary total\n    rather than guessed; a person's commit touching the spec is \"spec\"\n    before the first approval record and \"amend\" after; anything else by\n    a person is \"transport\" (a merge of main among them).\"\"\"\n    specs_rel = m[\"paths\"][\"specs\"]\n    records_rel = m[\"paths\"][\"records\"]\n    specs_prefix = f\"{specs_rel.rstrip('/')}/{item_id}/\"\n    records_prefix = f\"{records_rel.rstrip('/')}/{item_id}/\"\n    empty_summary = {\"operator_acts\": 0, \"product_acts\": 0, \"executor_commits\": 0,\n                     \"stops\": 0, \"since\": None}\n\n    first_spec_sha = first_commit_touching(root, str(Path(specs_rel) / item_id))\n    if first_spec_sha is None:\n        return {\"item\": item_id, \"rows\": [], \"summary\": empty_summary}\n\n    merge_sha = merge_introducing_records(root, records_rel, item_id, STAGES)\n    if merge_sha is not None:\n        branch_tip = git(root, \"rev-parse\", f\"{merge_sha}^2\").strip()\n        commits = commits_since(root, f\"{first_spec_sha}^\", end=branch_tip)\n        commits += commits_since(root, f\"{merge_sha}^1\", end=merge_sha)\n    else:\n        commits = commits_since(root, f\"{first_spec_sha}^\", end=\"HEAD\")\n\n    driver = driver_identity()\n    rows: list[dict] = []\n    operator_acts = product_acts = executor_commits = 0\n    since = None\n    approval_seen = False\n\n    for c in commits:\n        sha, name, email = c[\"sha\"], c[\"name\"], c[\"email\"]\n\n        if merge_sha is not None and sha == merge_sha:\n            rows.append({\"sha\": sha, \"identity\": name, \"class\": \"merge\"})\n            operator_acts += 1\n            continue\n\n        if email.startswith(\"executor+\") and email.endswith(\"@attavo.invalid\"):\n            rows.append({\"sha\": sha, \"identity\": name, \"class\": \"change\"})\n            executor_commits += 1\n            continue\n\n        touched = _commit_touches(root, sha)\n        record_touch = None\n        for p in touched:\n            if not p.startswith(records_prefix):\n                continue\n            rm = RECORD_RE.match(Path(p).name)\n            if rm and rm.group(1) in STAGES:\n                record_touch = (rm.group(1), p)\n                break\n\n        if record_touch is not None:\n            stage, relpath = record_touch\n            content = _record_at(root, sha, relpath, item_id)\n            if since is None:\n                since = content.get(\"product_version\")\n\n            if stage == \"approval\":\n                rows.append({\"sha\": sha, \"identity\": name, \"class\": \"approve\"})\n                operator_acts += 1\n                approval_seen = True\n                continue\n\n            is_driver = name == driver[\"name\"] and email == driver[\"email\"]\n            is_records_app = _is_records_app(name)\n            if stage == \"spec\" or is_driver or is_records_app:\n                rows.append({\"sha\": sha, \"identity\": name, \"class\": \"record\"})\n                product_acts += 1\n                continue\n\n            version = _semver_tuple(content.get(\"product_version\"))\n            if version is not None and version < LEDGER_V018_CUTOFF:\n                rows.append({\"sha\": sha, \"identity\": name, \"class\": \"record-or-launch\",\n                            \"note\": \"not distinguishable before v0.18.0\"})\n                continue\n\n            rows.append({\"sha\": sha, \"identity\": name, \"class\": \"launch\"})\n            operator_acts += 1\n            continue\n\n        if any(p.startswith(specs_prefix) for p in touched):\n            cls = \"amend\" if approval_seen else \"spec\"\n            rows.append({\"sha\": sha, \"identity\": name, \"class\": cls})\n            if cls == \"amend\":\n                operator_acts += 1\n            continue\n\n        rows.append({\"sha\": sha, \"identity\": name, \"class\": \"transport\"})\n        operator_acts += 1\n\n    # issue #137: the same set attavo stops counts, from the same reader\n    # (item_stops) -- not a second, independent count kept in sync by\n    # hand. One non-pass record per row, whatever its stage; a gate\n    # refusal is included the same as a non-pass build or verify record.\n    stops = len(item_stops(root, m, item_id)[\"rows\"])\n\n    summary = {\"operator_acts\": operator_acts, \"product_acts\": product_acts,\n              \"executor_commits\": executor_commits, \"stops\": stops, \"since\": since}\n    return {\"item\": item_id, \"rows\": rows, \"summary\": summary}\n\n","numLines":145,"startLine":3084,"totalLines":3424}}}

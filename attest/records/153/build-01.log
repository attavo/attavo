{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011bgK9GdZwU9gWrycCUZghB","type":"tool_result","content":"80\t                       {\"approved_by\": \"alice\", \"sha\": spec_sha, \"spec_sha\": spec_sha,\n81\t                        \"product_version\": \"v0.19.1\"})\n82\t    commit_as(root, RECORDS_APP, f\"attavo: approval record for item {item}\", [rel])\n83\t\n84\t    (root / \"built.txt\").write_text(\"built\\n\")\n85\t    commit_as(root, EXECUTOR, f\"fixture: build item {item}\", [\"built.txt\"])\n86\t\n87\t    rel = write_record(root, item, \"build\", 1, {\"status\": \"pass\", \"product_version\": \"v0.19.1\"})\n88\t    commit_as(root, DRIVER, f\"attavo: build record for item {item} (build-01)\", [rel])\n89\t\n90\t    rel = write_record(root, item, \"verify\", 1, {\"status\": \"pass\", \"product_version\": \"v0.19.1\"})\n91\t    commit_as(root, DRIVER, f\"attavo: verify record for item {item} (verify-01)\", [rel])\n92\t\n93\t    git(root, \"checkout\", \"main\")\n94\t    subprocess.run([\"git\", \"-C\", str(root), \"merge\", \"--no-ff\", \"item\",\n95\t                    \"-m\", f\"Merge pull request #{item} from x/item\"], check=True)\n96\t    return root\n97\t\n98\t\n99\tdef test_ledger_classifies_every_commit_and_counts_operator_acts(tmp_path):\n100\t    \"\"\"Acceptance row 1: on a fixture with the four identities, every\n101\t    commit gets exactly one class and the summary counts operator acts 2\n102\t    -- the same shape tenant zero's own #651 reads (1 approve, 1 merge).\"\"\"\n103\t    root = build_merged_item(tmp_path)\n104\t\n105\t    run = run_attavo(root, \"ledger\", \"1\", \"--json\")\n106\t    assert run.returncode == 0, run.stdout + run.stderr\n107\t    data = json.loads(run.stdout)\n108\t\n109\t    classes = [row[\"class\"] for row in data[\"rows\"]]\n110\t    assert classes == [\"spec\", \"record\", \"approve\", \"change\", \"record\", \"record\", \"merge\"]\n111\t    assert all(row[\"class\"] and row[\"sha\"] and row[\"identity\"] for row in data[\"rows\"])\n112\t\n113\t    summary = data[\"summary\"]\n114\t    assert summary[\"operator_acts\"] == 2\n115\t    assert summary[\"product_acts\"] == 3\n116\t    assert summary[\"executor_commits\"] == 1\n117\t    assert summary[\"stops\"] == 0\n118\t    assert summary[\"since\"] == \"v0.19.1\"\n119\t\n120\t\n121\tdef test_ledger_stops_count_matches_stops_including_a_gate_refusal(tmp_path):\n122\t    \"\"\"Issue #137, acceptance row 2. A refused spec-gate record and a\n123\t    non-pass build record: ledger's own stops count is the same set\n124\t    `attavo stops` counts, gate refusals included -- both computed by\n125\t    item_stops, not two producers reading one item and printing\n126\t    different numbers (tenant zero #683: stops printed 1, ledger printed\n127\t    0, because ledger's own count only ever looked at build and verify).\n128\t    \"\"\"\n129\t    root = make_tenant(tmp_path, \"ledger_base\")\n130\t    add_spec(root)\n131\t\n132\t    write_record(root, \"1\", \"spec\", 1,\n133\t                {\"status\": \"refused\",\n134\t                 \"refusal\": \"criterion fails against the tree plus stub: \"\n135\t                            \"doctor-template-absent.sh\"})\n136\t    write_record(root, \"1\", \"build\", 1, {\"status\": \"failed\"})\n137\t\n138\t    ledger_run = run_attavo(root, \"ledger\", \"1\", \"--json\")\n139\t    assert ledger_run.returncode == 0, ledger_run.stdout + ledger_run.stderr\n140\t    stops_run = run_attavo(root, \"stops\", \"1\", \"--json\")\n141\t    assert stops_run.returncode == 0, stops_run.stdout + stops_run.stderr\n142\t\n143\t    ledger_data = json.loads(ledger_run.stdout)\n144\t    stops_data = json.loads(stops_run.stdout)\n145\t\n146\t    assert len(stops_data[\"rows\"]) == 2\n147\t    assert ledger_data[\"summary\"][\"stops\"] == len(stops_data[\"rows\"])\n148\t\n149\t\n150\tdef test_ledger_marks_a_pre_v018_record_commit_as_record_or_launch(tmp_path):\n151\t    \"\"\"Acceptance row 2: a person's record commit before v0.18.0 prints\n152\t    record-or-launch with the note, never launch or record -- before that\n153\t    version the driver and the executor had no identity of their own to\n154\t    tell a genuine launch apart from an automated one.\"\"\"\n155\t    root = make_tenant(tmp_path, \"ledger_base\")\n156\t    add_spec(root)\n157\t\n158\t    rel = write_record(root, \"1\", \"build\", 1, {\"status\": \"pass\", \"product_version\": \"v0.17.0\"})\n159\t    person_sha = commit_as(root, PERSON, \"manual build record for item 1\", [rel])\n160\t\n161\t    run = run_attavo(root, \"ledger\", \"1\", \"--json\")\n162\t    assert run.returncode == 0, run.stdout + run.stderr\n163\t    data = json.loads(run.stdout)\n164\t\n165\t    row = next(r for r in data[\"rows\"] if r[\"sha\"] == person_sha)\n166\t    assert row[\"class\"] == \"record-or-launch\"\n167\t    assert row[\"note\"] == \"not distinguishable before v0.18.0\"\n168\t    assert data[\"summary\"][\"operator_acts\"] == 0\n169\t    assert data[\"summary\"][\"product_acts\"] == 0\n170\t\n171\t\n172\tdef test_ledger_json_is_one_object_matching_the_text_forms_numbers(tmp_path):\n173\t    \"\"\"Acceptance row 3: --json is one object with rows and summary, and\n174\t    the text form prints the same numbers.\"\"\"\n175\t    root = build_merged_item(tmp_path)\n176\t\n177\t    run_json = run_attavo(root, \"ledger\", \"1\", \"--json\")\n178\t    assert run_json.returncode == 0, run_json.stdout + run_json.stderr\n179\t    data = json.loads(run_json.stdout)\n180\t    assert set(data) == {\"item\", \"rows\", \"summary\"}\n181\t    assert isinstance(data[\"rows\"], list)\n182\t    assert isinstance(data[\"summary\"], dict)\n183\t\n184\t    run_text = run_attavo(root, \"ledger\", \"1\")\n185\t    assert run_text.returncode == 0, run_text.stdout + run_text.stderr\n186\t    summary = data[\"summary\"]\n187\t    assert f\"operator acts: {summary['operator_acts']}\" in run_text.stdout\n188\t    assert f\"product acts: {summary['product_acts']}\" in run_text.stdout\n189\t    assert f\"executor commits: {summary['executor_commits']}\" in run_text.stdout\n190\t    assert f\"stops: {summary['stops']}\" in run_text.stdout"}]},"parent_tool_use_id":null,"session_id":"6e2492c7-2a27-487f-99c4-d4ecc36025b0","uuid":"1e41945b-5d00-4c39-b21d-f9f87eb136c2","timestamp":"2026-09-17T16:14:42.864Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-153/tests/test_ledger.py","content":"                       {\"approved_by\": \"alice\", \"sha\": spec_sha, \"spec_sha\": spec_sha,\n                        \"product_version\": \"v0.19.1\"})\n    commit_as(root, RECORDS_APP, f\"attavo: approval record for item {item}\", [rel])\n\n    (root / \"built.txt\").write_text(\"built\\n\")\n    commit_as(root, EXECUTOR, f\"fixture: build item {item}\", [\"built.txt\"])\n\n    rel = write_record(root, item, \"build\", 1, {\"status\": \"pass\", \"product_version\": \"v0.19.1\"})\n    commit_as(root, DRIVER, f\"attavo: build record for item {item} (build-01)\", [rel])\n\n    rel = write_record(root, item, \"verify\", 1, {\"status\": \"pass\", \"product_version\": \"v0.19.1\"})\n    commit_as(root, DRIVER, f\"attavo: verify record for item {item} (verify-01)\", [rel])\n\n    git(root, \"checkout\", \"main\")\n    subprocess.run([\"git\", \"-C\", str(root), \"merge\", \"--no-ff\", \"item\",\n                    \"-m\", f\"Merge pull request #{item} from x/item\"], check=True)\n    return root\n\n\ndef test_ledger_classifies_every_commit_and_counts_operator_acts(tmp_path):\n    \"\"\"Acceptance row 1: on a fixture with the four identities, every\n    commit gets exactly one class and the summary counts operator acts 2\n    -- the same shape tenant zero's own #651 reads (1 approve, 1 merge).\"\"\"\n    root = build_merged_item(tmp_path)\n\n    run = run_attavo(root, \"ledger\", \"1\", \"--json\")\n    assert run.returncode == 0, run.stdout + run.stderr\n    data = json.loads(run.stdout)\n\n    classes = [row[\"class\"] for row in data[\"rows\"]]\n    assert classes == [\"spec\", \"record\", \"approve\", \"change\", \"record\", \"record\", \"merge\"]\n    assert all(row[\"class\"] and row[\"sha\"] and row[\"identity\"] for row in data[\"rows\"])\n\n    summary = data[\"summary\"]\n    assert summary[\"operator_acts\"] == 2\n    assert summary[\"product_acts\"] == 3\n    assert summary[\"executor_commits\"] == 1\n    assert summary[\"stops\"] == 0\n    assert summary[\"since\"] == \"v0.19.1\"\n\n\ndef test_ledger_stops_count_matches_stops_including_a_gate_refusal(tmp_path):\n    \"\"\"Issue #137, acceptance row 2. A refused spec-gate record and a\n    non-pass build record: ledger's own stops count is the same set\n    `attavo stops` counts, gate refusals included -- both computed by\n    item_stops, not two producers reading one item and printing\n    different numbers (tenant zero #683: stops printed 1, ledger printed\n    0, because ledger's own count only ever looked at build and verify).\n    \"\"\"\n    root = make_tenant(tmp_path, \"ledger_base\")\n    add_spec(root)\n\n    write_record(root, \"1\", \"spec\", 1,\n                {\"status\": \"refused\",\n                 \"refusal\": \"criterion fails against the tree plus stub: \"\n                            \"doctor-template-absent.sh\"})\n    write_record(root, \"1\", \"build\", 1, {\"status\": \"failed\"})\n\n    ledger_run = run_attavo(root, \"ledger\", \"1\", \"--json\")\n    assert ledger_run.returncode == 0, ledger_run.stdout + ledger_run.stderr\n    stops_run = run_attavo(root, \"stops\", \"1\", \"--json\")\n    assert stops_run.returncode == 0, stops_run.stdout + stops_run.stderr\n\n    ledger_data = json.loads(ledger_run.stdout)\n    stops_data = json.loads(stops_run.stdout)\n\n    assert len(stops_data[\"rows\"]) == 2\n    assert ledger_data[\"summary\"][\"stops\"] == len(stops_data[\"rows\"])\n\n\ndef test_ledger_marks_a_pre_v018_record_commit_as_record_or_launch(tmp_path):\n    \"\"\"Acceptance row 2: a person's record commit before v0.18.0 prints\n    record-or-launch with the note, never launch or record -- before that\n    version the driver and the executor had no identity of their own to\n    tell a genuine launch apart from an automated one.\"\"\"\n    root = make_tenant(tmp_path, \"ledger_base\")\n    add_spec(root)\n\n    rel = write_record(root, \"1\", \"build\", 1, {\"status\": \"pass\", \"product_version\": \"v0.17.0\"})\n    person_sha = commit_as(root, PERSON, \"manual build record for item 1\", [rel])\n\n    run = run_attavo(root, \"ledger\", \"1\", \"--json\")\n    assert run.returncode == 0, run.stdout + run.stderr\n    data = json.loads(run.stdout)\n\n    row = next(r for r in data[\"rows\"] if r[\"sha\"] == person_sha)\n    assert row[\"class\"] == \"record-or-launch\"\n    assert row[\"note\"] == \"not distinguishable before v0.18.0\"\n    assert data[\"summary\"][\"operator_acts\"] == 0\n    assert data[\"summary\"][\"product_acts\"] == 0\n\n\ndef test_ledger_json_is_one_object_matching_the_text_forms_numbers(tmp_path):\n    \"\"\"Acceptance row 3: --json is one object with rows and summary, and\n    the text form prints the same numbers.\"\"\"\n    root = build_merged_item(tmp_path)\n\n    run_json = run_attavo(root, \"ledger\", \"1\", \"--json\")\n    assert run_json.returncode == 0, run_json.stdout + run_json.stderr\n    data = json.loads(run_json.stdout)\n    assert set(data) == {\"item\", \"rows\", \"summary\"}\n    assert isinstance(data[\"rows\"], list)\n    assert isinstance(data[\"summary\"], dict)\n\n    run_text = run_attavo(root, \"ledger\", \"1\")\n    assert run_text.returncode == 0, run_text.stdout + run_text.stderr\n    summary = data[\"summary\"]\n    assert f\"operator acts: {summary['operator_acts']}\" in run_text.stdout\n    assert f\"product acts: {summary['product_acts']}\" in run_text.stdout\n    assert f\"executor commits: {summary['executor_commits']}\" in run_text.stdout\n    assert f\"stops: {summary['stops']}\" in run_text.stdout","numLines":111,"startLine":80,"totalLines":192}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LkM7aD6W82yxEJMDawMH3u","type":"tool_result","content":"1\tfrom __future__ import annotations\n2\t\n3\timport os\n4\timport re\n5\timport shutil\n6\timport subprocess\n7\timport sys\n8\timport tempfile\n9\tfrom pathlib import Path\n10\tfrom typing import Any, cast\n11\t\n12\tfrom attavo.approval import approval_status\n13\tfrom attavo.common import (\n14\t    MANIFEST,\n15\t    ShallowCheckoutError,\n16\t    derive_item_id,\n17\t    git,\n18\t    last_commit_touching,\n19\t    now_iso,\n20\t    read_manifest,\n21\t)\n22\tfrom attavo.records import latest_record, write_record\n23\t\n24\t# --- the spec contract ---\n25\t\n26\tROOT_CAUSE_LINE = re.compile(r\"^Root-cause:\\s*([a-z0-9][a-z0-9-]*)\\s*$\")\n27\tROOT_CAUSE_ENTRY = re.compile(r\"^- ([a-z0-9][a-z0-9-]*):\\s+\\S\")\n28\t\n29\t\n30\tdef parse_spec(spec_md: Path) -> tuple[dict[str, Any] | None, str | None]:\n31\t    lines = spec_md.read_text().splitlines()\n32\t    heading_idx = [i for i, l in enumerate(lines) if l.startswith(\"## \")]\n33\t    headings = [lines[i].rstrip() for i in heading_idx]\n34\t    expected = [\"## Problem\", \"## Claims\", \"## Criteria\"]\n35\t    if headings != expected:\n36\t        bad = next((h for h in headings if h not in expected), None)\n37\t        if bad is None:\n38\t            missing = [h for h in expected if h not in headings]\n39\t            bad = missing[0] if missing else \"heading order\"\n40\t        return None, f\"headings: found {headings or ['(none)']}, expected {expected} ({bad})\"\n41\t    idx_problem, idx_claims, idx_criteria = heading_idx\n42\t    claims = [l.strip()[2:].strip() for l in lines[idx_claims + 1:idx_criteria]\n43\t              if l.strip().startswith(\"- \")]\n44\t    # A fix item names the root cause its change closes, as one line in\n45\t    # the problem: \"Root-cause: <slug>\". Optional; when present the gate\n46\t    # checks it against the tenant's closed list (root_cause_refusal).\n47\t    root_cause = None\n48\t    for l in lines[idx_problem + 1:idx_claims]:\n49\t        m = ROOT_CAUSE_LINE.match(l)\n50\t        if m:\n51\t            root_cause = m.group(1)\n52\t            break\n53\t    criteria = []\n54\t    for l in lines[idx_criteria + 1:]:\n55\t        s = l.strip()\n56\t        if not s.startswith(\"- \") or \":\" not in s:\n57\t            continue\n58\t        name = s[2:].split(\":\", 1)[0].strip()\n59\t        criteria.append(name)\n60\t    return {\"claims\": claims, \"criteria\": criteria, \"root_cause\": root_cause}, None\n61\t\n62\t\n63\tdef root_causes_path(root: Path, m: dict[str, Any]) -> Path:\n64\t    \"\"\"The tenant's closed list of root causes: root-causes.md beside\n65\t    the specs directory (attest/root-causes.md when specs live in\n66\t    attest/specs). One root cause per line, \"- <slug>: <one sentence>\".\"\"\"\n67\t    return root / Path(m[\"paths\"][\"specs\"]).parent / \"root-causes.md\"\n68\t\n69\t\n70\tdef listed_root_causes(path: Path) -> list[str]:\n71\t    if not path.is_file():\n72\t        return []\n73\t    return [mm.group(1) for mm in (ROOT_CAUSE_ENTRY.match(l) for l in path.read_text().splitlines()) if mm]\n74\t\n75\t\n76\tdef root_cause_refusal(root: Path, m: dict[str, Any], root_cause: str | None) -> str | None:\n77\t    \"\"\"A spec that names a root cause must name one the tenant lists.\n78\t    Symptom counts do not converge; root-cause counts can, and only if\n79\t    every root cause a fix item names is one the list already carries or\n80\t    an item added on purpose. No root-cause line, no check: a capability\n81\t    item has no root cause.\"\"\"\n82\t    if root_cause is None:\n83\t        return None\n84\t    path = root_causes_path(root, m)\n85\t    if not path.is_file():\n86\t        return f\"root cause: {root_cause} named but {path.relative_to(root)} does not exist\"\n87\t    if root_cause not in listed_root_causes(path):\n88\t        return f\"root cause: {root_cause} is not listed in {path.relative_to(root)}\"\n89\t    return None\n90\t\n91\t\n92\tdef run_criterion(exe: Path, cwd: Path) -> int:\n93\t    try:\n94\t        run = subprocess.run([str(exe)], cwd=str(cwd), capture_output=True,\n95\t                             timeout=CRITERION_TIMEOUT, check=False)\n96\t        return run.returncode\n97\t    except subprocess.TimeoutExpired:\n98\t        return 124\n99\t    except OSError:\n100\t        return 126\n101\t\n102\t\n103\tdef parse_removed(stub_dir: Path) -> list[str]:\n104\t    \"\"\"The paths listed in stub/.removed, one per line, comments (lines\n105\t    starting with #) and blank lines ignored. [] when the stub carries no\n106\t    .removed at all.\n107\t    \"\"\"\n108\t    removed_file = stub_dir / \".removed\"\n109\t    if not removed_file.is_file():\n110\t        return []\n111\t    paths = []\n112\t    for line in removed_file.read_text().splitlines():\n113\t        s = line.strip()\n114\t        if not s or s.startswith(\"#\"):\n115\t            continue\n116\t        paths.append(s)\n117\t    return paths\n118\t\n119\t\n120\tdef removed_path_refusal(root: Path, stub_dir: Path, rel: str) -> str | None:\n121\t    p = Path(rel)\n122\t    if p.is_absolute() or \"..\" in p.parts:\n123\t        return f\"stub/.removed names a path outside the tree: {rel}\"\n124\t    if not (root / p).exists():\n125\t        return f\"stub/.removed names a path not in the tree: {rel}\"\n126\t    if (stub_dir / p).exists():\n127\t        return f\"stub/.removed names a path the stub also supplies: {rel}\"\n128\t    return None\n129\t\n130\t\n131\tdef stub_removed_refusal(root: Path, spec_dir: Path) -> str | None:\n132\t    \"\"\"Validated by name, before any criterion runs -- a stub whose\n133\t    .removed cannot be applied has no meaning to gate against.\n134\t    \"\"\"\n135\t    stub_dir = spec_dir / \"stub\"\n136\t    for rel in parse_removed(stub_dir):\n137\t        refusal = removed_path_refusal(root, stub_dir, rel)\n138\t        if refusal:\n139\t            return refusal\n140\t    return None\n141\t\n142\t\n143\tdef run_criteria(root: Path, spec_dir: Path, names: list[str]) -> list[dict[str, Any]]:\n144\t    criteria_dir = spec_dir / \"criteria\"\n145\t    stub_dir = spec_dir / \"stub\"\n146\t    with tempfile.TemporaryDirectory() as tmp:\n147\t        tree = Path(tmp) / \"tree\"\n148\t        stubbed = Path(tmp) / \"stubbed\"\n149\t        shutil.copytree(root, tree, ignore=shutil.ignore_patterns(\".git\"))\n150\t        shutil.copytree(root, stubbed, ignore=shutil.ignore_patterns(\".git\"))\n151\t        if stub_dir.is_dir():\n152\t            shutil.copytree(stub_dir, stubbed, dirs_exist_ok=True)\n153\t            for rel in parse_removed(stub_dir):\n154\t                target = stubbed / rel\n155\t                if target.is_dir():\n156\t                    shutil.rmtree(target)\n157\t                elif target.exists():\n158\t                    target.unlink()\n159\t            removed_marker = stubbed / \".removed\"\n160\t            if removed_marker.exists():\n161\t                removed_marker.unlink()\n162\t        results = []\n163\t        for name in names:\n164\t            exe = criteria_dir / name\n165\t            results.append({\"name\": name,\n166\t                            \"on_tree\": run_criterion(exe, tree),\n167\t                            \"on_stub\": run_criterion(exe, stubbed)})\n168\t        return results\n169\t\n170\t\n171\tdef commit_postdates(root: Path, earlier: str, later: str) -> bool:\n172\t    \"\"\"Whether later is a strict descendant of earlier on this branch.\"\"\"\n173\t    if earlier == later:\n174\t        return False\n175\t    run = subprocess.run([\"git\", \"-C\", str(root), \"merge-base\", \"--is-ancestor\", earlier, later],\n176\t                         capture_output=True, check=False)\n177\t    return run.returncode == 0\n178\t\n179\t\n180\tdef cmd_spec_gate(argv: list[str]) -> int:\n181\t    root = Path(\".\").resolve()\n182\t    item_id = argv[0] if argv else derive_item_id(root)\n183\t    if not item_id:\n184\t        print(\"attavo spec-gate: cannot derive item id; pass N or run on an attavo/N-* branch\",\n185\t              file=sys.stderr)\n186\t        return 2\n187\t    m = read_manifest(root)\n188\t    if m is None:\n189\t        print(f\"attavo spec-gate: no {MANIFEST} at {root}\", file=sys.stderr)\n190\t        return 2\n191\t    specs_rel = m[\"paths\"][\"specs\"]\n192\t    records_rel = m[\"paths\"][\"records\"]\n193\t    spec_dir = root / specs_rel / item_id\n194\t    spec_md = spec_dir / \"spec.md\"\n195\t    if not spec_md.is_file():\n196\t        print(f\"attavo spec-gate: no spec at {spec_dir}\", file=sys.stderr)\n197\t        return 2\n198\t    spec_rel = str(Path(specs_rel) / item_id)\n199\t    try:\n200\t        spec_sha = last_commit_touching(root, spec_rel)\n201\t    except ShallowCheckoutError as exc:\n202\t        print(f\"attavo spec-gate: refused: {exc}\", file=sys.stderr)\n203\t        return 2\n204\t\n205\t    records_dir = root / records_rel / item_id\n206\t    try:\n207\t        approved = approval_status(root, m, item_id) == \"valid\"\n208\t    except ShallowCheckoutError as exc:\n209\t        print(f\"attavo spec-gate: refused: {exc}\", file=sys.stderr)\n210\t        return 2\n211\t    latest_approval = latest_record(records_dir, \"approval\")\n212\t    if approved:\n213\t        record: dict[str, Any] = {\"sha\": git(root, \"rev-parse\", \"HEAD\").strip(), \"spec_sha\": spec_sha,\n214\t                  \"at\": now_iso(), \"status\": \"approved\",\n215\t                  \"approval_sha\": latest_approval.get(\"sha\") if latest_approval else None,\n216\t                  \"criteria\": [], \"refusal\": None}\n217\t        write_record(records_dir, \"spec\", record, m, item_id)\n218\t        print(\"attavo spec-gate: approved (no criteria run)\")\n219\t        return 0\n220\t\n221\t    # Third verdict, beside \"approved\" and Phase 1's \"pass\": the approval\n222\t    # is not valid, but a build already ran after it -- the amendment that\n223\t    # expired the approval landed above the line, not below it, and the\n224\t    # tree the build produced is what must satisfy the criteria now, not\n225\t    # the stub that only ever proved they were reachable before approval.\n226\t    # Issue #98: whatever the build's status, including a halt -- the\n227\t    # executor commits then asks, so a halted build's sha postdating the\n228\t    # approval means it did the work. commit_postdates already excludes a\n229\t    # halt that committed nothing, since such a build's sha equals its\n230\t    # start_sha and so postdates nothing.\n231\t    latest_build = latest_record(records_dir, \"build\")\n232\t    built = bool(\n233\t        latest_approval and latest_build\n234\t        and commit_postdates(root, latest_approval[\"sha\"], latest_build[\"sha\"]))\n235\t\n236\t    parsed, refusal = parse_spec(spec_md)\n237\t    results: list[dict[str, Any]] = []\n238\t    if refusal is None:\n239\t        # parse_spec returns a refusal exactly when it returns no spec.\n240\t        parsed = cast(dict[str, Any], parsed)\n241\t        refusal = root_cause_refusal(root, m, parsed.get(\"root_cause\"))\n242\t    if refusal is None:\n243\t        parsed = cast(dict[str, Any], parsed)\n244\t        if built:\n245\t            refusal = stub_removed_refusal(root, spec_dir)\n246\t            if refusal is None:\n247\t                # Per criterion, not the set: passing on the tree is what\n248\t                # the build already satisfied; failing on the tree but\n249\t                # passing on the stub is a new obligation the next build\n250\t                # must meet -- an operator scripting a ruling the executor\n251\t                # skipped. Refused only when a criterion satisfies neither.\n252\t                results = run_criteria(root, spec_dir, parsed[\"criteria\"])\n253\t                fail = next((c for c in results if c[\"on_tree\"] != 0 and c[\"on_stub\"] != 0), None)\n254\t                if fail:\n255\t                    refusal = f\"criterion fails against the tree plus stub: {fail['name']}\"\n256\t        elif not parsed[\"claims\"]:\n257\t            refusal = \"claims: empty; the build may touch nothing\"\n258\t        else:\n259\t            criteria_dir = spec_dir / \"criteria\"\n260\t            listed = parsed[\"criteria\"]\n261\t            existing = sorted(p.name for p in criteria_dir.iterdir()) if criteria_dir.is_dir() else []\n262\t            prose = None\n263\t            for name in listed:\n264\t                if name not in existing:\n265\t                    prose = name\n266\t                    break\n267\t            if prose is None:\n268\t                for name in existing:\n269\t                    if name not in listed:\n270\t                        prose = name\n271\t                        break\n272\t            if prose is None:\n273\t                for name in listed:\n274\t                    if not os.access(criteria_dir / name, os.X_OK):\n275\t                        prose = name\n276\t                        break\n277\t            if prose:\n278\t                refusal = f\"criterion is prose: {prose}\"\n279\t            else:\n280\t                refusal = stub_removed_refusal(root, spec_dir)\n281\t                if refusal is None:\n282\t                    results = run_criteria(root, spec_dir, listed)\n283\t                    fail_tree = next((c for c in results if c[\"on_tree\"] == 0), None)\n284\t                    if fail_tree:\n285\t                        refusal = f\"criterion passes against the tree: {fail_tree['name']}\"\n286\t                    else:\n287\t                        fail_stub = next((c for c in results if c[\"on_stub\"] != 0), None)\n288\t                        if fail_stub:\n289\t                            refusal = f\"criterion fails against the tree plus stub: {fail_stub['name']}\"\n290\t\n291\t    status = \"refused\" if refusal else (\"built\" if built else \"pass\")\n292\t    record = {\"sha\": git(root, \"rev-parse\", \"HEAD\").strip(),\n293\t              \"spec_sha\": spec_sha,\n294\t              \"at\": now_iso(), \"status\": status, \"approval_sha\": None,\n295\t              \"criteria\": results, \"refusal\": refusal}\n296\t    write_record(records_dir, \"spec\", record, m, item_id)\n297\t\n298\t    if refusal:\n299\t        print(f\"attavo spec-gate: refused: {refusal}\")\n300\t        return 1\n301\t    print(f\"attavo spec-gate: {status} ({len(results)} criterion/criteria)\")\n302\t    return 0\n303\t\n304\t\n305\tCRITERION_TIMEOUT = 120\n306\t"}]},"parent_tool_use_id":null,"session_id":"f5ecc061-fc06-439e-a5a7-f0a49ab13107","uuid":"52583a9d-c999-4775-be55-552389f1ad48","timestamp":"2026-09-28T15:45:43.805Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-242/attavo/spec.py","content":"from __future__ import annotations\n\nimport os\nimport re\nimport shutil\nimport subprocess\nimport sys\nimport tempfile\nfrom pathlib import Path\nfrom typing import Any, cast\n\nfrom attavo.approval import approval_status\nfrom attavo.common import (\n    MANIFEST,\n    ShallowCheckoutError,\n    derive_item_id,\n    git,\n    last_commit_touching,\n    now_iso,\n    read_manifest,\n)\nfrom attavo.records import latest_record, write_record\n\n# --- the spec contract ---\n\nROOT_CAUSE_LINE = re.compile(r\"^Root-cause:\\s*([a-z0-9][a-z0-9-]*)\\s*$\")\nROOT_CAUSE_ENTRY = re.compile(r\"^- ([a-z0-9][a-z0-9-]*):\\s+\\S\")\n\n\ndef parse_spec(spec_md: Path) -> tuple[dict[str, Any] | None, str | None]:\n    lines = spec_md.read_text().splitlines()\n    heading_idx = [i for i, l in enumerate(lines) if l.startswith(\"## \")]\n    headings = [lines[i].rstrip() for i in heading_idx]\n    expected = [\"## Problem\", \"## Claims\", \"## Criteria\"]\n    if headings != expected:\n        bad = next((h for h in headings if h not in expected), None)\n        if bad is None:\n            missing = [h for h in expected if h not in headings]\n            bad = missing[0] if missing else \"heading order\"\n        return None, f\"headings: found {headings or ['(none)']}, expected {expected} ({bad})\"\n    idx_problem, idx_claims, idx_criteria = heading_idx\n    claims = [l.strip()[2:].strip() for l in lines[idx_claims + 1:idx_criteria]\n              if l.strip().startswith(\"- \")]\n    # A fix item names the root cause its change closes, as one line in\n    # the problem: \"Root-cause: <slug>\". Optional; when present the gate\n    # checks it against the tenant's closed list (root_cause_refusal).\n    root_cause = None\n    for l in lines[idx_problem + 1:idx_claims]:\n        m = ROOT_CAUSE_LINE.match(l)\n        if m:\n            root_cause = m.group(1)\n            break\n    criteria = []\n    for l in lines[idx_criteria + 1:]:\n        s = l.strip()\n        if not s.startswith(\"- \") or \":\" not in s:\n            continue\n        name = s[2:].split(\":\", 1)[0].strip()\n        criteria.append(name)\n    return {\"claims\": claims, \"criteria\": criteria, \"root_cause\": root_cause}, None\n\n\ndef root_causes_path(root: Path, m: dict[str, Any]) -> Path:\n    \"\"\"The tenant's closed list of root causes: root-causes.md beside\n    the specs directory (attest/root-causes.md when specs live in\n    attest/specs). One root cause per line, \"- <slug>: <one sentence>\".\"\"\"\n    return root / Path(m[\"paths\"][\"specs\"]).parent / \"root-causes.md\"\n\n\ndef listed_root_causes(path: Path) -> list[str]:\n    if not path.is_file():\n        return []\n    return [mm.group(1) for mm in (ROOT_CAUSE_ENTRY.match(l) for l in path.read_text().splitlines()) if mm]\n\n\ndef root_cause_refusal(root: Path, m: dict[str, Any], root_cause: str | None) -> str | None:\n    \"\"\"A spec that names a root cause must name one the tenant lists.\n    Symptom counts do not converge; root-cause counts can, and only if\n    every root cause a fix item names is one the list already carries or\n    an item added on purpose. No root-cause line, no check: a capability\n    item has no root cause.\"\"\"\n    if root_cause is None:\n        return None\n    path = root_causes_path(root, m)\n    if not path.is_file():\n        return f\"root cause: {root_cause} named but {path.relative_to(root)} does not exist\"\n    if root_cause not in listed_root_causes(path):\n        return f\"root cause: {root_cause} is not listed in {path.relative_to(root)}\"\n    return None\n\n\ndef run_criterion(exe: Path, cwd: Path) -> int:\n    try:\n        run = subprocess.run([str(exe)], cwd=str(cwd), capture_output=True,\n                             timeout=CRITERION_TIMEOUT, check=False)\n        return run.returncode\n    except subprocess.TimeoutExpired:\n        return 124\n    except OSError:\n        return 126\n\n\ndef parse_removed(stub_dir: Path) -> list[str]:\n    \"\"\"The paths listed in stub/.removed, one per line, comments (lines\n    starting with #) and blank lines ignored. [] when the stub carries no\n    .removed at all.\n    \"\"\"\n    removed_file = stub_dir / \".removed\"\n    if not removed_file.is_file():\n        return []\n    paths = []\n    for line in removed_file.read_text().splitlines():\n        s = line.strip()\n        if not s or s.startswith(\"#\"):\n            continue\n        paths.append(s)\n    return paths\n\n\ndef removed_path_refusal(root: Path, stub_dir: Path, rel: str) -> str | None:\n    p = Path(rel)\n    if p.is_absolute() or \"..\" in p.parts:\n        return f\"stub/.removed names a path outside the tree: {rel}\"\n    if not (root / p).exists():\n        return f\"stub/.removed names a path not in the tree: {rel}\"\n    if (stub_dir / p).exists():\n        return f\"stub/.removed names a path the stub also supplies: {rel}\"\n    return None\n\n\ndef stub_removed_refusal(root: Path, spec_dir: Path) -> str | None:\n    \"\"\"Validated by name, before any criterion runs -- a stub whose\n    .removed cannot be applied has no meaning to gate against.\n    \"\"\"\n    stub_dir = spec_dir / \"stub\"\n    for rel in parse_removed(stub_dir):\n        refusal = removed_path_refusal(root, stub_dir, rel)\n        if refusal:\n            return refusal\n    return None\n\n\ndef run_criteria(root: Path, spec_dir: Path, names: list[str]) -> list[dict[str, Any]]:\n    criteria_dir = spec_dir / \"criteria\"\n    stub_dir = spec_dir / \"stub\"\n    with tempfile.TemporaryDirectory() as tmp:\n        tree = Path(tmp) / \"tree\"\n        stubbed = Path(tmp) / \"stubbed\"\n        shutil.copytree(root, tree, ignore=shutil.ignore_patterns(\".git\"))\n        shutil.copytree(root, stubbed, ignore=shutil.ignore_patterns(\".git\"))\n        if stub_dir.is_dir():\n            shutil.copytree(stub_dir, stubbed, dirs_exist_ok=True)\n            for rel in parse_removed(stub_dir):\n                target = stubbed / rel\n                if target.is_dir():\n                    shutil.rmtree(target)\n                elif target.exists():\n                    target.unlink()\n            removed_marker = stubbed / \".removed\"\n            if removed_marker.exists():\n                removed_marker.unlink()\n        results = []\n        for name in names:\n            exe = criteria_dir / name\n            results.append({\"name\": name,\n                            \"on_tree\": run_criterion(exe, tree),\n                            \"on_stub\": run_criterion(exe, stubbed)})\n        return results\n\n\ndef commit_postdates(root: Path, earlier: str, later: str) -> bool:\n    \"\"\"Whether later is a strict descendant of earlier on this branch.\"\"\"\n    if earlier == later:\n        return False\n    run = subprocess.run([\"git\", \"-C\", str(root), \"merge-base\", \"--is-ancestor\", earlier, later],\n                         capture_output=True, check=False)\n    return run.returncode == 0\n\n\ndef cmd_spec_gate(argv: list[str]) -> int:\n    root = Path(\".\").resolve()\n    item_id = argv[0] if argv else derive_item_id(root)\n    if not item_id:\n        print(\"attavo spec-gate: cannot derive item id; pass N or run on an attavo/N-* branch\",\n              file=sys.stderr)\n        return 2\n    m = read_manifest(root)\n    if m is None:\n        print(f\"attavo spec-gate: no {MANIFEST} at {root}\", file=sys.stderr)\n        return 2\n    specs_rel = m[\"paths\"][\"specs\"]\n    records_rel = m[\"paths\"][\"records\"]\n    spec_dir = root / specs_rel / item_id\n    spec_md = spec_dir / \"spec.md\"\n    if not spec_md.is_file():\n        print(f\"attavo spec-gate: no spec at {spec_dir}\", file=sys.stderr)\n        return 2\n    spec_rel = str(Path(specs_rel) / item_id)\n    try:\n        spec_sha = last_commit_touching(root, spec_rel)\n    except ShallowCheckoutError as exc:\n        print(f\"attavo spec-gate: refused: {exc}\", file=sys.stderr)\n        return 2\n\n    records_dir = root / records_rel / item_id\n    try:\n        approved = approval_status(root, m, item_id) == \"valid\"\n    except ShallowCheckoutError as exc:\n        print(f\"attavo spec-gate: refused: {exc}\", file=sys.stderr)\n        return 2\n    latest_approval = latest_record(records_dir, \"approval\")\n    if approved:\n        record: dict[str, Any] = {\"sha\": git(root, \"rev-parse\", \"HEAD\").strip(), \"spec_sha\": spec_sha,\n                  \"at\": now_iso(), \"status\": \"approved\",\n                  \"approval_sha\": latest_approval.get(\"sha\") if latest_approval else None,\n                  \"criteria\": [], \"refusal\": None}\n        write_record(records_dir, \"spec\", record, m, item_id)\n        print(\"attavo spec-gate: approved (no criteria run)\")\n        return 0\n\n    # Third verdict, beside \"approved\" and Phase 1's \"pass\": the approval\n    # is not valid, but a build already ran after it -- the amendment that\n    # expired the approval landed above the line, not below it, and the\n    # tree the build produced is what must satisfy the criteria now, not\n    # the stub that only ever proved they were reachable before approval.\n    # Issue #98: whatever the build's status, including a halt -- the\n    # executor commits then asks, so a halted build's sha postdating the\n    # approval means it did the work. commit_postdates already excludes a\n    # halt that committed nothing, since such a build's sha equals its\n    # start_sha and so postdates nothing.\n    latest_build = latest_record(records_dir, \"build\")\n    built = bool(\n        latest_approval and latest_build\n        and commit_postdates(root, latest_approval[\"sha\"], latest_build[\"sha\"]))\n\n    parsed, refusal = parse_spec(spec_md)\n    results: list[dict[str, Any]] = []\n    if refusal is None:\n        # parse_spec returns a refusal exactly when it returns no spec.\n        parsed = cast(dict[str, Any], parsed)\n        refusal = root_cause_refusal(root, m, parsed.get(\"root_cause\"))\n    if refusal is None:\n        parsed = cast(dict[str, Any], parsed)\n        if built:\n            refusal = stub_removed_refusal(root, spec_dir)\n            if refusal is None:\n                # Per criterion, not the set: passing on the tree is what\n                # the build already satisfied; failing on the tree but\n                # passing on the stub is a new obligation the next build\n                # must meet -- an operator scripting a ruling the executor\n                # skipped. Refused only when a criterion satisfies neither.\n                results = run_criteria(root, spec_dir, parsed[\"criteria\"])\n                fail = next((c for c in results if c[\"on_tree\"] != 0 and c[\"on_stub\"] != 0), None)\n                if fail:\n                    refusal = f\"criterion fails against the tree plus stub: {fail['name']}\"\n        elif not parsed[\"claims\"]:\n            refusal = \"claims: empty; the build may touch nothing\"\n        else:\n            criteria_dir = spec_dir / \"criteria\"\n            listed = parsed[\"criteria\"]\n            existing = sorted(p.name for p in criteria_dir.iterdir()) if criteria_dir.is_dir() else []\n            prose = None\n            for name in listed:\n                if name not in existing:\n                    prose = name\n                    break\n            if prose is None:\n                for name in existing:\n                    if name not in listed:\n                        prose = name\n                        break\n            if prose is None:\n                for name in listed:\n                    if not os.access(criteria_dir / name, os.X_OK):\n                        prose = name\n                        break\n            if prose:\n                refusal = f\"criterion is prose: {prose}\"\n            else:\n                refusal = stub_removed_refusal(root, spec_dir)\n                if refusal is None:\n                    results = run_criteria(root, spec_dir, listed)\n                    fail_tree = next((c for c in results if c[\"on_tree\"] == 0), None)\n                    if fail_tree:\n                        refusal = f\"criterion passes against the tree: {fail_tree['name']}\"\n                    else:\n                        fail_stub = next((c for c in results if c[\"on_stub\"] != 0), None)\n                        if fail_stub:\n                            refusal = f\"criterion fails against the tree plus stub: {fail_stub['name']}\"\n\n    status = \"refused\" if refusal else (\"built\" if built else \"pass\")\n    record = {\"sha\": git(root, \"rev-parse\", \"HEAD\").strip(),\n              \"spec_sha\": spec_sha,\n              \"at\": now_iso(), \"status\": status, \"approval_sha\": None,\n              \"criteria\": results, \"refusal\": refusal}\n    write_record(records_dir, \"spec\", record, m, item_id)\n\n    if refusal:\n        print(f\"attavo spec-gate: refused: {refusal}\")\n        return 1\n    print(f\"attavo spec-gate: {status} ({len(results)} criterion/criteria)\")\n    return 0\n\n\nCRITERION_TIMEOUT = 120\n","numLines":306,"startLine":1,"totalLines":306}}}

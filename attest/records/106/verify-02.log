}-{n:02d} is unclassed with no detail; \\\"\\n/Users/davidbean/Projects/attest/bin/attavo:2404:        counsel = counsel_record_for(item_records_dir, stage, n)\\n/Users/davidbean/Projects/attest/bin/attavo:2406:            \\\"class\\\": stop[\\\"class\\\"],\\n/Users/davidbean/Projects/attest/bin/attavo:2407:            \\\"provenance\\\": stop[\\\"provenance\\\"],\\n/Users/davidbean/Projects/attest/bin/attavo:2410:            \\\"counsel_verdict\\\": counsel.get(\\\"verdict\\\") if counsel else None,\\n/Users/davidbean/Projects/attest/bin/attavo:2411:            \\\"counsel_citations\\\": counsel.get(\\\"citations\\\") if counsel else [],\\n/Users/davidbean/Projects/attest/bin/attavo:2412:            \\\"counsel_proposal\\\": counsel.get(\\\"proposal\\\") if counsel else None,\\n/Users/davidbean/Projects/attest/bin/attavo:2637:    if argv[0] == \\\"counsel\\\":\\n/Users/davidbean/Projects/attest/bin/attavo:2638:        return cmd_counsel(argv[1:])\\n/Users/davidbean/Projects/attest/bin/attavo:2646:          f\\\"approval-status, build, verify, file-findings, file-stops, counsel, record-only, \\\"\\n/Users/davidbean/Projects/attest/schema/records/build.schema.json:107:      \\\"required\\\": [\\\"class\\\", \\\"provenance\\\", \\\"detail\\\"],\\n/Users/davidbean/Projects/attest/schema/records/build.schema.json:114:        \\\"provenance\\\": {\\\"type\\\": \\\"string\\\", \\\"enum\\\": [\\\"product\\\", \\\"tenant\\\", \\\"executor\\\", \\\"spec\\\"]},\\n/Users/davidbean/Projects/attest/schema/records/build.schema.json:117:          \\\"description\\\": \\\"Populated for class \\\\\\\"unclassed\\\\\\\" (the log's last line, capped at 200 characters) and class \\\\\\\"question\\\\\\\" (the halt's own question, its first line only); null for every other class, whose evidence already lives in refusal, halted, or the log itself.\\\"\\n/Users/davidbean/Projects/attest/schema/records/verify.schema.json:109:      \\\"required\\\": [\\\"class\\\", \\\"provenance\\\", \\\"detail\\\"],\\n/Users/davidbean/Projects/attest/schema/records/verify.schema.json:116:        \\\"provenance\\\": {\\\"type\\\": \\\"string\\\", \\\"enum\\\": [\\\"product\\\", \\\"tenant\\\", \\\"executor\\\", \\\"spec\\\"]},\\n/Users/davidbean/Projects/attest/schema/records/verify.schema.json:119:          \\\"description\\\": \\\"Populated for class \\\\\\\"unclassed\\\\\\\" (the log's last line, capped at 200 characters) and class \\\\\\\"question\\\\\\\" (the halt's own question, its first line only); null for every other class, whose evidence already lives in forge_checks or the log itself.\\\"\\n/Users/davidbean/Projects/attest/schema/records/counsel.schema.json:3:  \\\"$id\\\": \\\"https://attavo.dev/schema/records/counsel/1\\\",\\n/Users/davidbean/Projects/attest/schema/records/counsel.schema.json:4:  \\\"title\\\": \\\"attavo counsel record (counsel-NN.json)\\\",\\n/Users/davidbean/Projects/attest/schema/records/counsel.schema.json:20:      \\\"description\\\": \\\"Which stage's non-pass record this counsel invocation read.\\\"\\n/Users/davidbean/Projects/attest/schema/records/counsel.schema.json:25:      \\\"description\\\": \\\"The stem (e.g. \\\\\\\"build-01\\\\\\\") of the non-pass record counsel read.\\\"\\n/Users/davidbean/Projects/attest/schema/records/counsel.schema.json:31:      \\\"description\\\": \\\"Copied verbatim from [executor.<adapter>] merged with [executor.<adapter>.counsel].\\\"\\n/Users/davidbean/Projects/attest/schema/records/counsel.schema.json:61:      \\\"description\\\": \\\"The stop's class as counsel itself reads it -- independent of, and possibly disagreeing with, the stop.class the counseled record already carries.\\\"\\n/Users/davidbean/Projects/attest/schema/records/counsel.schema.json:66:      \\\"description\\\": \\\"\\\\\\\"answer\\\\\\\": the stop is answerable inside the rules. \\\\\\\"patch\\\\\\\": the stop is a product defect. \\\\\\\"person\\\\\\\": the answer would touch the definition of done and no rule covers it.\\\"\\n    if m is None:\\n        print(f\\\"attavo build: no {MANIFEST} at {root}\\\", file=sys.stderr)\\n        return 2\\n\\n    adapter_name = (m.get(\\\"executor\\\") or {}).get(\\\"build\\\")\\n    if not adapter_name:\\n        print(\\\"attavo build: refused: no [executor].build in the manifest\\\")\\n        return 1\\n\\n    tests_cfg = m.get(\\\"tests\\\") or {}\\n    if not tests_cfg.get(\\\"select\\\") or not tests_cfg.get(\\\"run\\\"):\\n        print(\\\"attavo build: refused: no [tests] table in the manifest \\\"\\n              \\\"([tests].select and [tests].run are both required)\\\")\\n        return 1\\n\\n    try:\\n        status = approval_status(root, m, item_id)\\n    except ShallowCheckoutError as exc:\\n        print(f\\\"attavo build: refused: {exc}\\\", file=sys.stderr)\\n        return 2\\n    if status != \\\"valid\\\":\\n        print(f\\\"attavo build: refused: approval is {status}\\\")\\n        return 1\\n\\n    adapter_path = resolve_adapter(root, adapter_name)\\n    if adapter_path is None:\\n        print(f\\\"attavo build: refused: no adapter named {adapter_name!r}\\\")\\n        return 1\\n\\n    specs_rel = m[\\\"paths\\\"][\\\"specs\\\"]\\n    records_rel = m[\\\"paths\\\"][\\\"records\\\"]\\n    spec_dir = root / specs_rel / item_id\\n    item_records_dir = root / records_rel / item_id\\n    spec_sha = last_commit_touching(root, str(Path(specs_rel) / item_id))\\n    latest_approval = latest_record(item_records_dir, \\\"approval\\\")\\n    parsed, _ = parse_spec(spec_dir / \\\"spec.md\\\")\\n    claims = parsed[\\\"claims\\\"] if parsed else []\\n    criteria_names = parsed[\\\"criteria\\\"] if parsed else []\\n    adapter_config = merge_adapter_config(m, adapter_name, \\\"build\\\")\\n    checks_command = (m.get(\\\"checks\\\") or {}).get(\\\"command\\\")\\n    identity = executor_identity(adapter_name)\\n    reports = adapter_reports(adapter_path)\\n\\n    start_sha = git(root, \\\"rev-parse\\\", \\\"HEAD\\\").strip()\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n    started = time.monotonic()\\n\\n    adapter_version = model = model_version = None\\n    tokens = {\\\"input\\\": 0, \\\"output\\\": 0}\\n    cost_usd = None\\n    transcripts: list[str] = []\\n    criteria_results: list[dict] = []\\n    selected_tests: dict | None = None\\n    checks_result: dict | None = None\\n    status_out = \\\"failed\\\"\\n    refusal = None\\n    halted = None\\n    iterations_used = 0\\n\\n    with tempfile.TemporaryDirectory() as tmp:\\n        feedback_path = Path(tmp) / \\\"feedback.txt\\\"\\n        feedback_path.write_text(\\\"\\\")\\n\\n        for iteration in range(1, BUILD_ITERATION_BUDGET + 1):\\n            iterations_used = iteration\\n            env = dict(os.environ)\\n            env[\\\"ATTAVO_SPEC_DIR\\\"] = str(spec_dir)\\n            env[\\\"ATTAVO_RECORDS_DIR\\\"] = str(item_records_dir)\\n            env[\\\"ATTAVO_RULINGS\\\"] = str(root / m[\\\"paths\\\"][\\\"rulings\\\"])\\n            env[\\\"ATTAVO_BRANCH\\\"] = branch\\n            env[\\\"ATTAVO_ITERATION\\\"] = str(iteration)\\n            env[\\\"ATTAVO_FEEDBACK\\\"] = str(feedback_path)\\n            env[\\\"ATTAVO_ADAPTER_CONFIG\\\"] = json.dumps(adapter_config)\\n            env[\\\"ATTAVO_STAGE\\\"] = \\\"build\\\"\\n            if checks_command:\\n                env[\\\"ATTAVO_CHECKS_COMMAND\\\"] = checks_command\\n            env[\\\"GIT_AUTHOR_NAME\\\"] = identity[\\\"name\\\"]\\n            env[\\\"GIT_AUTHOR_EMAIL\\\"] = identity[\\\"email\\\"]\\n            env[\\\"GIT_COMMITTER_NAME\\\"] = identity[\\\"name\\\"]\\n            env[\\\"GIT_COMMITTER_EMAIL\\\"] = identity[\\\"email\\\"]\\n\\n            run = subprocess.run([str(adapter_path)], cwd=str(root), env=env,\\n                                 capture_output=True, text=True, check=False)\\n            transcript, payload = split_adapter_stdout(run.stdout)\\n            if run.returncode != 0:\\n                # The guarantee behind issue #53's refusal: an adapter that\\n                # exits non-zero always leaves a non-empty log, even one\\n                # that printed nothing at all on stderr.\\n                detail = f\\\"[adapter exited {run.returncode}]\\\"\\n                if run.stderr.strip():\\n                    detail += \\\"\\\\n\\\" + run.stderr.rstrip(\\\"\\\\n\\\")\\n                transcript = (transcript + \\\"\\\\n\\\" if transcript else \\\"\\\") + detail\\n            transcripts.append(transcript)\\n\\n            if run.returncode != 0 or payload is None or not payload.get(\\\"model\\\"):\\n                status_out = \\\"failed\\\"\\n                break\\n\\n            adapter_version = payload.get(\\\"adapter_version\\\")\\n            model = payload.get(\\\"model\\\")\\n            model_version = payload.get(\\\"model_version\\\")\\n            tok = payload.get(\\\"tokens\\\") or {}\\n            tokens[\\\"input\\\"] += tok.get(\\\"input\\\", 0) or 0\\n            tokens[\\\"output\\\"] += tok.get(\\\"output\\\", 0) or 0\\n            iter_cost = payload.get(\\\"cost_usd\\\")\\n            if iter_cost is not None:\\n                cost_usd = (cost_usd or 0) + iter_cost\\n\\n            if payload.get(\\\"status\\\") == \\\"question\\\":\\n                status_out = \\\"halted\\\"\\n                halted = {\\\"question\\\": payload.get(\\\"question\\\")}\\n                break\\n\\n            foreign = next((c for c in commits_since(root, start_sha)\\n                           if c[\\\"name\\\"] != identity[\\\"name\\\"] or c[\\\"email\\\"] != identity[\\\"email\\\"]),\\n                          None)\\n            if foreign:\\n                status_out = \\\"refused\\\"\\n                refusal = f\\\"commit {foreign['sha']} not authored by the executor\\\"\\n                break\\n\\n            touched = sorted(changed_paths(root, start_sha, records_rel))\\n            bad_path = next((p for p in touched if not matches_a_claim(p, claims)), None)\\n            if bad_path:\\n                status_out = \\\"refused\\\"\\n                refusal = bad_path\\n                break\\n\\n            criteria_results = [\\n                {\\\"name\\\": name, \\\"exit\\\": run_criterion(spec_dir / \\\"criteria\\\" / name, root)}\\n                for name in criteria_names]\\n\\n            select_in = \\\"\\\".join(p + \\\"\\\\n\\\" for p in touched)\\n            select_run = subprocess.run(tests_cfg[\\\"select\\\"], shell=True, cwd=str(root),\\n                                        input=select_in, capture_output=True,\\n                                        text=True, check=False)\\n            identifiers = [l for l in select_run.stdout.splitlines() if l.strip()]\\n            run_in = \\\"\\\".join(i + \\\"\\\\n\\\" for i in identifiers)\\n            test_run = subprocess.run(tests_cfg[\\\"run\\\"], shell=True, cwd=str(root),\\n                                      input=run_in, capture_output=True,\\n                                      text=True, check=False)\\n            selected_tests = {\\\"select\\\": tests_cfg[\\\"select\\\"], \\\"run\\\": tests_cfg[\\\"run\\\"],\\n                              \\\"count\\\": len(identifiers), \\\"exit\\\": test_run.returncode}\\n\\n            checks_run = None\\n            if checks_command:\\n                checks_run = subprocess.run(checks_command, shell=True, cwd=str(root),\\n                                            capture_output=True, text=True, check=False)\\n                checks_result = {\\\"command\\\": checks_command, \\\"exit\\\": checks_run.returncode}\\n\\n            # Issue #89, rejection test 1: the gate output that decides pass\\n            # or fail is appended to the build log itself, under a heading\\n            # per iteration, before this temporary directory goes away --\\n            # tenant zero's #576 build-11 and #659 build-01 are a failed\\n            # record with nothing beside it to say what was red, because\\n            # this output previously lived only in feedback.txt, in a\\n            # tempfile.TemporaryDirectory() cmd_build deletes on return.\\n            gate_lines = [f\\\"criterion {c['name']}: exit {c['exit']}\\\" for c in criteria_results]\\n            gate_lines.append(f\\\"selected tests ({selected_tests['count']}): exit \\\"\\n                              f\\\"{selected_tests['exit']}\\\")\\n            if test_run.stdout.strip():\\n                gate_lines += [\\\"--- selected tests stdout ---\\\", test_run.stdout.rstrip(\\\"\\\\n\\\")]\\n            if test_run.stderr.strip():\\n                gate_lines += [\\\"--- selected tests stderr ---\\\", test_run.stderr.rstrip(\\\"\\\\n\\\")]\\n            if checks_run is not None:\\n                tail = (checks_run.stdout.splitlines() + checks_run.stderr.splitlines())\\n                tail = tail[-CHECKS_FEEDBACK_TAIL_LINES:]\\n                gate_lines.append(f\\\"tenant checks: exit {checks_run.returncode}\\\")\\n                gate_lines += [\\\"--- checks output (tail) ---\\\", *tail]\\n            transcripts[-1] += (f\\\"\\\\n--- attavo gates, iteration {iteration} ---\\\\n\\\"\\n                               + \\\"\\\\n\\\".join(gate_lines))\\n\\n            failing = [c for c in criteria_results if c[\\\"exit\\\"] != 0]\\n            checks_ok = checks_run is None or checks_run.returncode == 0\\n            if not failing and test_run.returncode == 0 and checks_ok:\\n                status_out = \\\"pass\\\"\\n                break\\n\\n            if iteration == BUILD_ITERATION_BUDGET:\\n                status_out = \\\"failed\\\"\\n                break\\n\\n            feedback_lines = []\\n            if failing:\\n                feedback_lines.append(\\\"criteria failing:\\\")\\n                feedback_lines += [f\\\"- {c['name']}: exit {c['exit']}\\\" for c in failing]\\n\",\"exit_code\":1,\"status\":\"failed\"}}\n720:+{\"type\":\"item.completed\",\"item\":{\"id\":\"item_6\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"find /Users/davidbean/Projects/attest/templates -maxdepth 4 -type f -print -exec sed -n '1,220p' {} \\\\\\\\; && sed -n '1,180p' /Users/davidbean/Projects/attest/action.yml && rg -n \\\\\\\"jsonschema\\\\\\\" /Users/davidbean/Projects/attest --glob '\\\"'!attest/records/**'\\\"' --glob '\\\"'!attest/specs/**'\\\"'\\\"\",\"aggregated_output\":\"/Users/davidbean/Projects/attest/templates/workflows/attavo-approve.yml\\n# Template. Copy this file into your own .github/workflows/ and fill in\\n# uses: <owner>/attavo@<tag> below. Not vendored or executed by Attavo's\\n# own repository -- this is the tenant's workflow, not the product's.\\n#\\n# An operator comments \\\"/approve\\\" on the work item's PR. This workflow\\n# checks out the PR's branch, runs `attavo approve --by <actor>` (the item\\n# id is the issue number, not the PR number -- attavo derives it from the\\n# attavo/N-* branch), and commits and pushes the resulting approval-NN.json\\n# -- the push is what binds the approval to a commit.\\n#\\n# The push authenticates as a GitHub App installation, not a bot account\\n# with no login behind it: an app-token step mints an installation token\\n# from the tenant's own app credentials, checkout uses it for the push,\\n# and the commit's author and committer are read from the app's own bot\\n# user at run time, never typed into the template. A push authenticated\\n# this way is what creates the pull_request run on the record commit; the\\n# default GITHUB_TOKEN does not.\\nname: Attavo approval\\n\\non:\\n  issue_comment:\\n    types: [created]\\n\\njobs:\\n  approve:\\n    if: >\\n      github.event.issue.pull_request &&\\n      startsWith(github.event.comment.body, '/approve')\\n    runs-on: ubuntu-latest\\n    permissions:\\n      contents: write\\n      pull-requests: read\\n    steps:\\n      - name: Resolve the PR's branch\\n        id: pr\\n        uses: actions/github-script@v7\\n        with:\\n          script: |\\n            const pr = await github.rest.pulls.get({\\n              owner: context.repo.owner,\\n              repo: context.repo.repo,\\n              pull_number: context.issue.number,\\n            })\\n            core.setOutput('ref', pr.data.head.ref)\\n\\n      - name: Mint an installation token\\n        id: app-token\\n        uses: actions/create-github-app-token@v2\\n        with:\\n          app-id: ${{ secrets.ATTAVO_APP_ID }}\\n          private-key: ${{ secrets.ATTAVO_APP_PRIVATE_KEY }}\\n\\n      - name: Resolve the app's bot identity\\n        id: bot\\n        env:\\n          GH_TOKEN: ${{ steps.app-token.outputs.token }}\\n        run: |\\n          login=\\\"${{ steps.app-token.outputs.app-slug }}[bot]\\\"\\n          id=\\\"$(gh api \\\"/users/$login\\\" --jq .id)\\\"\\n          echo \\\"login=$login\\\" >> \\\"$GITHUB_OUTPUT\\\"\\n          echo \\\"email=${id}+${login}@users.noreply.github.com\\\" >> \\\"$GITHUB_OUTPUT\\\"\\n\\n      - uses: actions/checkout@v4\\n        with:\\n          ref: ${{ steps.pr.outputs.ref }}\\n          fetch-depth: 0\\n          token: ${{ steps.app-token.outputs.token }}\\n\\n      - uses: <owner>/attavo@<tag>\\n\\n      - name: attavo approve\\n        run: attavo approve --by \\\"${{ github.event.comment.user.login }}\\\"\\n\\n      - name: Commit and push the approval record\\n        run: |\\n          git config user.name \\\"${{ steps.bot.outputs.login }}\\\"\\n          git config user.email \\\"${{ steps.bot.outputs.email }}\\\"\\n          records_rel=\\\"$(python3 -c \\\"import tomllib; print(tomllib.load(open('attavo.toml','rb'))['paths']['records'])\\\")\\\"\\n          git add \\\"$records_rel\\\"\\n          git commit -m \\\"attavo: approval record for #${{ github.event.issue.number }}\\\"\\n          git push origin \\\"HEAD:${{ steps.pr.outputs.ref }}\\\"\\n/Users/davidbean/Projects/attest/templates/workflows/attavo-coherence.yml\\n# Template. Copy this file into your own .github/workflows/ and fill in\\n# uses: <owner>/attavo@<tag> below. Not vendored or executed by Attavo's\\n# own repository -- this is the tenant's workflow, not the product's.\\n#\\n# `attavo attest` derives the merged item from the merge ref's own record\\n# paths, refuses unless that item's chain holds, and prints the\\n# attestation statement to stdout -- it never writes to the tree (issue\\n# #69: the four stage records already under paths.records are the\\n# evidence; this job seals them). This workflow runs it on pull_request,\\n# against the pull request's own merge ref, and on merge_group, against\\n# the exact tree the merge will produce, so an incoherent chain refuses\\n# while the branch can still be pushed to.\\n#\\n# On pull_request the run line also carries --partial (issue #67): the\\n# verify record a complete chain would need is the output of `attavo\\n# verify`, which itself waits on this check going green, so the two\\n# checks deadlock without it. --partial treats a missing later record as\\n# \\\"not yet\\\" rather than a refusal, while still enforcing that a build's\\n# approval_sha names the latest approval and a verify's build_sha names\\n# the latest build. merge_group and a push to main still demand the whole\\n# chain -- nothing runs after either that could still supply a record\\n# found missing there. attest's stdout -- the statement, or a not-yet or\\n# zero-item line -- is captured to a plain file, and the attest step\\n# itself reads whether that file parses as a JSON object into its own\\n# `statement` output: a python3 -c json.load check, its exit status read\\n# into the output, never a grep -- a grep would say yes for any line that\\n# merely looks like JSON, which a not-yet line's stage names could. The\\n# not-yet and zero-item lines are prose, not JSON, and a merge group can\\n# carry no item exactly as easily as a pull request can; without this\\n# check the steps below would hand actions/attest that prose the moment\\n# the pin lane's own installing merge -- which touches no item -- reached\\n# the queue.\\n#\\n# Only on merge_group -- github.sha there resolves to the commit that\\n# will actually land on main, not the merge queue's own temporary ref --\\n# and only when attest's own output says the captured file is a\\n# statement, two further steps run: a sha256 digest of that commit's own\\n# sha text (deterministic and reproducible from the sha alone), and\\n# actions/attest@v2, signing attest's printed statement as the predicate,\\n# https://attavo.dev/attestation/v1, over that digest. Signing here\\n# replaces the post-merge attest workflow this product shipped before\\n# (issue #69): the four stage records are the evidence, and the bundle\\n# actions/attest@v2 writes to the forge's attestation store is the seal\\n# over them -- no attestation record is ever written to the tree.\\n#\\n# Neither step carries continue-on-error. Ruled: a merge without a\\n# signature is unattested, and the product's claim is that nothing merges\\n# unattested, so a signing failure fails this required context and the\\n# merge does not happen. This reverses the 2026-09-09 refusal-tolerance\\n# ruling for the step that used to patch a record's signed field either\\n# way; there is no record left for that patch to write to, and a tenant\\n# whose signing provider is unavailable un-requires this context as its\\n# own act, on its own ledger -- not a default this template supplies.\\n#\\n# This step is not folded into attavo-spec-gate.yml's job, for two\\n# reasons: that job skips an ordinary pull request from any branch that\\n# doesn't start with attavo/ (issue #12), and every step after its skip\\n# step is skipped on a record-only commit. An approval push is a\\n# record-only commit -- including a re-approval after a build, the exact\\n# shape that broke the chain on tenant zero (approval-07, issue #62) --\\n# so folding coherence into that job would skip the check on precisely\\n# the commit most likely to need it. Coherence has neither restriction:\\n# it runs on any pull request, record-only commit or not, and reports its\\n# own required context so a tenant can gate the merge queue on it without\\n# widening the spec-gate job's guards.\\n#\\n# actions/checkout@v4 takes no ref: -- the pull_request and merge_group\\n# events default to the merge commit checkout already needs, the same\\n# tree `attavo attest` reads git diff --name-only HEAD^1 HEAD against.\\n# fetch-depth: 0 keeps that first parent reachable.\\n#\\n# No app token is minted and nothing is pushed: attest prints, it never\\n# writes, and the signed statement lives in the forge's attestation\\n# store, not in a commit this job makes.\\nname: Attavo coherence\\n\\non:\\n  pull_request:\\n    types: [opened, synchronize, reopened]\\n  merge_group:\\n\\njobs:\\n  coherence:\\n    runs-on: ubuntu-latest\\n    permissions:\\n      contents: read\\n      id-token: write\\n      attestations: write\\n    steps:\\n      - uses: actions/checkout@v4\\n        with:\\n          fetch-depth: 0\\n\\n      - uses: <owner>/attavo@<tag>\\n\\n      - name: attavo attest\\n        id: attest\\n        run: |\\n          attavo attest ${{ github.event_name == 'pull_request' && '--partial' || '' }} > \\\"$RUNNER_TEMP/attestation.json\\\"\\n          if python3 -c \\\"import json,sys; sys.exit(0 if isinstance(json.load(open(sys.argv[1])), dict) else 1)\\\" \\\"$RUNNER_TEMP/attestation.json\\\" 2>/dev/null; then\\n            echo \\\"statement=true\\\" >> \\\"$GITHUB_OUTPUT\\\"\\n          else\\n            echo \\\"statement=false\\\" >> \\\"$GITHUB_OUTPUT\\\"\\n          fi\\n\\n      - name: Compute the merge commit's subject digest\\n        id: subject\\n        if: github.event_name == 'merge_group' && steps.attest.outputs.statement == 'true'\\n        run: echo \\\"digest=sha256:$(printf '%s' \\\"${{ github.sha }}\\\" | sha256sum | cut -d' ' -f1)\\\" >> \\\"$GITHUB_OUTPUT\\\"\\n\\n      - name: Sign the attestation record\\n        id: sign\\n        if: github.event_name == 'merge_group' && steps.attest.outputs.statement == 'true'\\n        uses: actions/attest@v2\\n        with:\\n          subject-name: ${{ github.sha }}\\n          subject-digest: ${{ steps.subject.outputs.digest }}\\n          predicate-type: https://attavo.dev/attestation/v1\\n          predicate-path: ${{ runner.temp }}/attestation.json\\n/Users/davidbean/Projects/attest/templates/workflows/attavo-spec-gate.yml\\n# Template. Copy this file into your own .github/workflows/ and fill in\\n# uses: <owner>/attavo@<tag> below. Not vendored or executed by Attavo's\\n# own repository -- this is the tenant's workflow, not the product's.\\n#\\n# A push to a work item's PR runs `attavo spec-gate`, then commits and\\n# pushes the resulting spec-NN.json -- the push is what binds the record to\\n# the commit it graded. That push is itself a commit on the branch, so\\n# without the skip step below it would retrigger this same workflow, which\\n# would push another record, forever (issue #9). The skip step reads\\n# `attavo record-only`'s exit code -- whether the *triggering* commit\\n# touched anything outside paths.records, decided once in the product\\n# rather than in this template's own shell (issue #19); a record-only\\n# commit (the gate's own push) skips every step after it.\\n#\\n# The job only runs on a work item's attavo/N-* branch: this event fires on\\n# every pull_request, and a PR from any other branch has no item id for the\\n# gate to derive, so it would exit 2 and fail the required check on ordinary\\n# PRs (issue #12). A branch that doesn't match skips the job, which\\n# satisfies a required check rather than failing it.\\n#\\n# on: also declares merge_group, with the job's if: unchanged -- there is\\n# no attavo/N-* head_ref on a merge group's own synthetic ref, so the job\\n# skips there too, satisfying the required context on the queue the same\\n# way it does on an ordinary pull request. The gate itself belongs on the\\n# pull request, once, before the queue; the full suite runs again on the\\n# merge group (issue #62's coherence template among them).\\n#\\n# The push authenticates as a GitHub App installation, not a bot account\\n# with no login behind it: an app-token step mints an installation token\\n# from the tenant's own app credentials, checkout uses it for the push,\\n# and the commit's author and committer are read from the app's own bot\\n# user at run time, never typed into the template. A push authenticated\\n# this way is what creates the pull_request run on the record commit --\\n# with the skip step above, that run completes instead of retriggering\\n# the gate.\\n#\\n# The commit-and-push step carries if: always() -- a refusal is exactly\\n# the record most worth having on the branch, and a step after a failed\\n# one is skipped by default (issue #28: a refusal record existed only in\\n# the run log, never reached the branch). The job's own conclusion still\\n# tracks the gate: a failed `attavo spec-gate` step fails the job even\\n# though the push step afterward succeeds, since nothing here sets\\n# continue-on-error.\\nname: Attavo spec gate\\n\\non:\\n  pull_request:\\n    types: [opened, synchronize, reopened]\\n  merge_group:\\n\\njobs:\\n  spec-gate:\\n    if: startsWith(github.head_ref, 'attavo/')\\n    runs-on: ubuntu-latest\\n    permissions:\\n      contents: write\\n    steps:\\n      - name: Mint an installation token\\n        id: app-token\\n        uses: actions/create-github-app-token@v2\\n        with:\\n          app-id: ${{ secrets.ATTAVO_APP_ID }}\\n          private-key: ${{ secrets.ATTAVO_APP_PRIVATE_KEY }}\\n\\n      - name: Resolve the app's bot identity\\n        id: bot\\n        env:\\n          GH_TOKEN: ${{ steps.app-token.outputs.token }}\\n        run: |\\n          login=\\\"${{ steps.app-token.outputs.app-slug }}[bot]\\\"\\n          id=\\\"$(gh api \\\"/users/$login\\\" --jq .id)\\\"\\n          echo \\\"login=$login\\\" >> \\\"$GITHUB_OUTPUT\\\"\\n          echo \\\"email=${id}+${login}@users.noreply.github.com\\\" >> \\\"$GITHUB_OUTPUT\\\"\\n\\n      - uses: actions/checkout@v4\\n        with:\\n          ref: ${{ github.event.pull_request.head.ref }}\\n          fetch-depth: 0\\n          token: ${{ steps.app-token.outputs.token }}\\n\\n      - uses: <owner>/attavo@<tag>\\n\\n      - name: Skip when the head commit only touches records\\n        id: touch\\n        run: attavo record-only && echo skip=true >> \\\"$GITHUB_OUTPUT\\\" || echo skip=false >> \\\"$GITHUB_OUTPUT\\\"\\n\\n      - name: attavo spec-gate\\n        if: steps.touch.outputs.skip != 'true'\\n        run: attavo spec-gate\\n\\n      - name: Commit and push the spec-gate record\\n        if: always() && steps.touch.outputs.skip != 'true'\\n        run: |\\n          git config user.name \\\"${{ steps.bot.outputs.login }}\\\"\\n          git config user.email \\\"${{ steps.bot.outputs.email }}\\\"\\n          records_rel=\\\"$(python3 -c \\\"import tomllib; print(tomllib.load(open('attavo.toml','rb'))['paths']['records'])\\\")\\\"\\n          git add \\\"$records_rel\\\"\\n          git commit -m \\\"attavo: spec-gate record for #${{ github.event.pull_request.number }}\\\"\\n          git push origin \\\"HEAD:${{ github.event.pull_request.head.ref }}\\\"\\nname: \\\"Attavo\\\"\\ndescription: \\\"Installs the attavo command, pinned at this tag, on PATH.\\\"\\nruns:\\n  using: \\\"composite\\\"\\n  steps:\\n    - uses: actions/setup-python@v5\\n      with:\\n        python-version: \\\"3.11\\\"\\n    - run: echo \\\"${{ github.action_path }}/bin\\\" >> \\\"$GITHUB_PATH\\\"\\n      shell: bash\\n    - run: |\\n        ref=\\\"${{ github.action_ref }}\\\"\\n        if [ -z \\\"$ref\\\" ] && [ ! -d \\\"${{ github.action_path }}/.git\\\" ]; then\\n          ref=\\\"$(basename \\\"${{ github.action_path }}\\\")\\\"\\n        fi\\n        echo \\\"ATTAVO_PRODUCT_VERSION=$ref\\\" >> \\\"$GITHUB_ENV\\\"\\n      shell: bash\\n/Users/davidbean/Projects/attest/bin/attavo:463:    standard library, not a jsonschema import: bin/attavo is a single\\n/Users/davidbean/Projects/attest/tests/test_attest.py:24:import jsonschema\\n/Users/davidbean/Projects/attest/tests/test_attest.py:88:    jsonschema.validate(statement, STATEMENT_SCHEMA)\\n/Users/davidbean/Projects/attest/tests/test_counsel.py:20:import jsonschema\\n/Users/davidbean/Projects/attest/tests/test_counsel.py:131:    jsonschema.validate(record, COUNSEL_SCHEMA)\\n/Users/davidbean/Projects/attest/tests/test_counsel.py:183:    jsonschema.validate(record, COUNSEL_SCHEMA)\\n/Users/davidbean/Projects/attest/tests/test_counsel.py:210:    jsonschema.validate(record, COUNSEL_SCHEMA)\\n/Users/davidbean/Projects/attest/tests/test_counsel.py:237:    jsonschema.validate(record, COUNSEL_SCHEMA)\\n/Users/davidbean/Projects/attest/tests/test_record_schemas.py:17:import jsonschema\\n/Users/davidbean/Projects/attest/tests/test_record_schemas.py:98:    jsonschema.validate(statement,\\n/Users/davidbean/Projects/attest/tests/test_record_schemas.py:109:        jsonschema.validate(json.loads(path.read_text()), schemas[stage])\\n/Users/davidbean/Projects/attest/tests/test_record_schemas.py:209:    jsonschema.validate(manifest, schema)\\n/Users/davidbean/Projects/attest/tests/test_record_schemas.py:232:    jsonschema.validate(without_checks, schema)\\n/Users/davidbean/Projects/attest/tests/test_record_schemas.py:236:    jsonschema.validate(with_checks, schema)\\n/Users/davidbean/Projects/attest/tests/test_record_schemas.py:246:    not a jsonschema import into bin/attavo -- it is a single script a\\n/Users/davidbean/Projects/attest/tests/test_self_tenancy.py:18:import jsonschema\\n/Users/davidbean/Projects/attest/tests/test_self_tenancy.py:43:    jsonschema.validate(load_manifest(), schema)\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n725:diff --git a/attest/records/106/spec-01.json b/attest/records/106/spec-01.json\n730:@@ -0,0 +1,29 @@\n760:diff --git a/attest/records/106/spec-02.json b/attest/records/106/spec-02.json\n765:@@ -0,0 +1,34 @@\n800:diff --git a/attest/records/106/spec-03.json b/attest/records/106/spec-03.json\n805:@@ -0,0 +1,13 @@\n819:diff --git a/attest/records/106/verify-01.json b/attest/records/106/verify-01.json\n824:@@ -0,0 +1,81 @@\n906:diff --git a/attest/specs/106/criteria/attestation-schema-v2.sh b/attest/specs/106/criteria/attestation-schema-v2.sh\n911:@@ -0,0 +1,2 @@\n913:+grep -q '\"$id\": \"https://attavo.dev/attestation/v2\"' schema/attestation.schema.json\n914:diff --git a/attest/specs/106/criteria/doctor-job-main-only.sh b/attest/specs/106/criteria/doctor-job-main-only.sh\n919:@@ -0,0 +1,2 @@\n922:diff --git a/attest/specs/106/criteria/driver-identity.sh b/attest/specs/106/criteria/driver-identity.sh\n927:@@ -0,0 +1,2 @@\n929:+grep -q 'def driver_identity' bin/attavo && grep -q 'driver@attavo.invalid' bin/attavo\n930:diff --git a/attest/specs/106/criteria/no-ci-runs.sh b/attest/specs/106/criteria/no-ci-runs.sh\n935:@@ -0,0 +1,2 @@\n937:+! grep -n 'ci_runs\\|ATTAVO_CI_RUNS' bin/attavo schema/attestation.schema.json\n938:diff --git a/attest/specs/106/spec.md b/attest/specs/106/spec.md\n943:@@ -0,0 +1,24 @@\n946:+Two facts on the attestation of tenant zero's item #665 (merged `6ac6021`) are wrong or unreadable, and both are the product's. First, the two record commits `attavo drive` made (`e7d9860`, `f572d73`) are authored and committed as the operator's own git identity, because `commit_record` calls `git commit --only` with no identity while `executor_identity` already sets one for the executor's commits; a read by author cannot tell a driver's transport commit from a person's, so the driven clause of Phase 3 is provable only from the attestation's `acts` and not from the log. Second, the attestation carries `ci_runs: 0` on an item whose three pushes each ran six checks: the field is `int(os.environ.get(\"ATTAVO_CI_RUNS\") or 0)`, set by no template, so it reports a wrong number rather than none.\n948:+This item gives the driver its own identity and removes `ci_runs`. `commit_record` authors and commits every record commit as `attavo driver <driver@attavo.invalid>` from a `driver_identity()` beside `executor_identity()`, set by the product and never the tenant's git config, so `git log --author='attavo driver'` on a driven item lists exactly the driver's transport commits; the executor's identity is unchanged. A test in `tests/test_drive.py` sets the fixture tenant's `user.name` to another value, drives to a record commit, and asserts author and committer name and email on it; it must fail against the current `commit_record`. `ci_runs` leaves the attestation statement, the schema's `required` list and `properties`, and `ATTAVO_CI_RUNS` is read nowhere; `tests/test_attest.py::test_partial_does_not_read_ci_runs` is retired with it, and a test asserts the statement `attavo attest` prints carries no `ci_runs` key. The attestation schema's `$id` moves from `/attestation/v1` to `/attestation/v2`, since a required field left the shape. No other behaviour changes; a forge-read producer for CI runs is Phase 4's, if a decision ever needs the number.\n952:+Retires: the by-author read as something the attestation's `acts` field had to stand in for; `ATTAVO_CI_RUNS` and the test that guarded it; one wrong number on every attestation; the doctor as a pull-request check on a tenant with no merged item.\n959:+- tests/test_attest.py\n964:+- no-ci-runs.sh: neither bin/attavo nor the attestation schema mentions ci_runs or ATTAVO_CI_RUNS\n965:+- attestation-schema-v2.sh: the attestation schema's $id is /attestation/v2\n966:+- driver-identity.sh: bin/attavo declares driver_identity with the driver@attavo.invalid address\n968:diff --git a/attest/specs/106/stub/.github/workflows/ci.yml b/attest/specs/106/stub/.github/workflows/ci.yml\n973:@@ -0,0 +1,9 @@\n983:diff --git a/attest/specs/106/stub/bin/attavo b/attest/specs/106/stub/bin/attavo\n988:@@ -0,0 +1,14 @@\n998:+def driver_identity() -> dict:\n1003:diff --git a/attest/specs/106/stub/schema/attestation.schema.json b/attest/specs/106/stub/schema/attestation.schema.json\n1008:@@ -0,0 +1,229 @@\n1011:+  \"$id\": \"https://attavo.dev/attestation/v2\",\n1238:diff --git a/bin/attavo b/bin/attavo\n1242:@@ -279,9 +279,9 @@ def read_manifest(root: Path) -> dict | None:\n1254:@@ -1354,6 +1354,17 @@ def executor_identity(adapter_name: str) -> dict:\n1258:+def driver_identity() -> dict:\n1261:+    `commit_record` makes on the driver's behalf -- is never\n1272:@@ -2065,7 +2076,10 @@ def commit_record(root: Path, record_paths: Path | list[Path], message: str) ->\n1278:+    driver_identity(), set by the product and never the tenant's git\n1284:@@ -2077,8 +2091,14 @@ def commit_record(root: Path, record_paths: Path | list[Path], message: str) ->\n1288:+    identity = driver_identity()\n1300:@@ -2633,9 +2653,6 @@ def cmd_attest(argv: list[str]) -> int:\n1305:-        # that wants this reported sets ATTAVO_CI_RUNS from its own read.\n1306:-        \"ci_runs\": int(os.environ.get(\"ATTAVO_CI_RUNS\") or 0),\n1310:diff --git a/schema/attestation.schema.json b/schema/attestation.schema.json\n1314:@@ -1,13 +1,13 @@\n1317:-  \"$id\": \"https://attavo.dev/attestation/v1\",\n1318:+  \"$id\": \"https://attavo.dev/attestation/v2\",\n1325:-    \"tokens_by_stage\", \"cost_by_stage_usd\", \"wall_clock_by_stage_s\", \"ci_runs\",\n1330:@@ -79,7 +79,6 @@\n1334:-    \"ci_runs\": {\"type\": \"integer\", \"minimum\": 0},\n1338:diff --git a/tests/test_attest.py b/tests/test_attest.py\n1340:--- a/tests/test_attest.py\n1341:+++ b/tests/test_attest.py\n1342:@@ -378,18 +378,20 @@ def test_attest_and_partial_agree_when_verify_two_names_build_two(tmp_path, monk\n1346:-def test_partial_does_not_read_ci_runs(tmp_path, monkeypatch):\n1347:-    \"\"\"A not-yet exit prints no statement, so ATTAVO_CI_RUNS -- read only\n1349:+def test_statement_carries_no_ci_runs_key(tmp_path):\n1360:-    monkeypatch.setenv(\"ATTAVO_CI_RUNS\", \"7\")\n1368:+    assert \"ci_runs\" not in statement\n1372:diff --git a/tests/test_drive.py b/tests/test_drive.py\n1376:@@ -178,6 +178,34 @@ def test_drive_builds_from_an_approved_spec_with_no_build(tmp_path):\n1380:+def test_drive_commits_the_record_as_the_driver_not_the_tenants_own_identity(tmp_path):\n1381:+    \"\"\"The driver's identity (driver_identity, beside executor_identity):\n1385:+    commit carrying it would prove commit_record fell back to the\n","exit_code":0,"status":"completed"}}

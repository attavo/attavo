67-4afa-b9e0-dc09bb237f8a/tasks/bq1us0s3a.output\",\"summary\":\"python3 /Users/davidbean/Projects/attest/bin/attavo test 219 2>&1 | tail -200\",\"uuid\":\"486d501f-0480-465c-8d70-3bb93166e569\",\"session_id\":\"ac4fb82d-7667-4afa-b9e0-dc09bb237f8a\"}\n  2082\tadapters/claude-code/run: halted: class non-question -- the executor reported instead of asking, twice in a row   250\t        \"The stub is the fixture the acceptance criteria were shown to \"\n   251\t        \"pass against; it is not the intended change. A difference \"\n   252\t        \"between the built tree and the stub is not a finding: a \"\n   253\t        \"criterion the stub satisfies trivially is.\")\n   254\t\n   255\t\n   256\tdef build_instruction() -> str:\n   257\t    parts = list(spec_sections())\n   258\t\n   259\t    rulings = read_text(\"ATTAVO_RULINGS\")\n   260\t    if rulings.strip():\n   261\t        parts.append(\"## Rulings\\n\\n\" + rulings.strip())\n   262\t\n   263\t    feedback_path = os.environ.get(\"ATTAVO_FEEDBACK\")\n   264\t    feedback = read_text(\"ATTAVO_FEEDBACK\")\n   265\t    if feedback.strip():\n   266\t        parts.append(\n   267\t            \"## Feedback from the previous attempt\\n\\n\"\n   268\t            f\"The feedback is at {describe_file(feedback_path, feedback, diff_like=False)}. \"\n   269\t            \"It is not inlined here: read it yourself with your own tools \"\n   270\t            \"before continuing.\")\n   271\t\n   272\t    parts.append(\n   273\t        \"commit your work on the current branch; if you cannot proceed \"\n   274\t        \"without a decision that changes the criteria, do not guess: \"\n   275\t        \"answer with status question\")\n   276\t\n   277\t    test_command = os.environ.get(\"ATTAVO_TEST_COMMAND\")\n   278\t    if test_command:\n   279\t        bound = os.environ.get(\"ATTAVO_TEST_TIMEOUT_S\")\n   280\t        parts.append(\n   281\t            f\"to run tests while you work, run `{test_command}`: it runs the tests \"\n   282\t            \"selected for the files you have changed\"\n   283\t            + (f\" and stops at {bound} s\" if bound else \"\")\n   284\t            + \". Do not run the whole test suite or any whole-tree check yourself: \"\n   285\t            \"after you commit, the gates are run for you and any failure is \"\n   620\t\n   621\t\n   622\tMIN_QUESTION_CHARS = 40\n   623\t\n   624\tREINSTRUCTION = (\n   625\t    \"your last answer was a report, not a question; either continue to \"\n   626\t    \"done, or ask one question ending in a question mark that names the \"\n   627\t    \"spec line or guard you cannot resolve\")\n   628\t\n   629\t\n   630\tdef question_class(status: str, question: str | None) -> str:\n   631\t    \"\"\"\"done\" (no halt at all), \"fail\" (a question too short or absent to\n   632\t    be worth a person's judgment -- MIN_QUESTION_CHARS, unchanged since\n   633\t    v0.15.0), \"report\" (long enough but carries no \"?\" -- issue #88's\n   634\t    class A, a status update in the question channel), or \"question\" (a\n   635\t    real question).\"\"\"\n  1010\t        if exit_code2 is not None:\n  1011\t            return exit_code2\n  1012\t        if response2.get(\"is_error\") or not response2.get(\"structured_output\"):\n  1013\t            return 1\n  1014\t        refusal2 = subagent_refusal(response2)\n  1015\t        if refusal2:\n  1016\t            sys.stderr.write(refusal2 + \"\\n\")\n  1017\t            return 1\n  1018\t\n  1019\t        structured2 = response2.get(\"structured_output\") or {}\n  1020\t        status2 = structured2.get(\"status\", \"done\")\n  1021\t        question2 = structured2.get(\"question\")\n  1022\t        cls2 = question_class(status2, question2)\n  1023\t        if cls2 == \"fail\":\n  1024\t            return 1\n  1025\t\n  1026\t        common2 = report_fields(response2, config.get(\"model\"))\n  1027\t        if common2 is None:\n  1028\t            return 1\n  1029\t        # A non-question costs two executor turns, not one: sum both\n  1030\t        # calls' tokens and cost into the one report line this\n  1031\t        # invocation gets, whatever the retry's own outcome -- only\n  1032\t        # adapter_version/model/model_version stay the second call's.\n  1033\t        tokens1_input, tokens1_output, cost1 = usage_fields(response)\n  1034\t        common2[\"tokens\"][\"input\"] += tokens1_input\n  1035\t        common2[\"tokens\"][\"output\"] += tokens1_output\n  1036\t        common2[\"cost_usd\"] = add_cost(common2[\"cost_usd\"], cost1)\n  1037\t\n  1038\t        if cls2 == \"report\":\n  1039\t            # Two reports in a row: still a halt (someone must look),\n  1040\t            # but the transcript above already carries both raw\n  1041\t            # results, and this report line names the class so a\n  1042\t            # reader -- or a future record field, not this one -- can\n  1043\t            # tell it apart from a genuine question.\n  1044\t            print(\"adapters/claude-code/run: halted: class non-question \"\n  1045\t                  \"-- the executor reported instead of asking, twice in \"\n  1046\t                  \"a row\")\n  1047\t            line = {**common2, \"status\": \"question\", \"question\": question2,\n  1048\t                   \"class\": \"non-question\"}\n  1049\t            print(json.dumps(line))\n  1050\t            return 0\n  1051\t\n  1052\t        line = {**common2, \"status\": status2, \"question\": question2}\n  1053\t        print(json.dumps(line))\n  1054\t        return 0\n  1055\t\n   430\t        return rc if rc != 0 else 1\n   431\t\n   432\t    record = cast(dict[str, Any], latest_record(records_dir, stage))\n   433\t    status_out = record.get(\"status\")\n   434\t    to_commit = [after]\n   435\t    if status_out != \"pass\":\n   436\t        # R3: a retryable family (died, hung, transient, returned) asks\n   437\t        # counsel nothing while its budget still has an attempt to\n   438\t        # spend -- the next pass retries it plainly. Once its budget is\n   439\t        # spent, or its last two signatures match, counsel is read once\n   440\t        # more, its sentence carried beside the exhaustion report, never\n   441\t        # instead of it. Every other class is counsel's to read on every\n   442\t        # stop, as before this item -- unless the immediately preceding\n   443\t        # attempt of this stage already carried the identical detail and\n   444\t        # was already counseled: asking counsel the same question twice\n   445\t        # in a row would only spend a second invocation on the same\n   446\t        # answer, so this one is a person's now, not counsel's again.\n   447\t        stop_class = (record.get(\"stop\") or {}).get(\"class\")\n   448\t        budget_stage = \"build\" if stop_class == \"returned\" else stage\n   449\t        if stop_class in RETRYABLE_CLASSES:\n   450\t            ask_counsel = stage_exhausted(records_dir, m, stage, budget_stage)\n   451\t        else:\n   452\t            detail = (record.get(\"stop\") or {}).get(\"detail\")\n   453\t            prior = parse_attempts(records_dir, stage).get(nn - 1) if nn > 1 else None\n   454\t            already_read = (prior is not None and signature_of(detail) is not None\n   455\t                           and signature_of(detail) == signature_of((prior.get(\"stop\") or {}).get(\"detail\"))\n   456\t                           and counsel_record_for(records_dir, stage, nn - 1) is not None)\n   457\t            ask_counsel = not already_read\n   458\t        counsel_before = latest_attempt_path(records_dir, \"counsel\")\n   459\t        if ask_counsel:\n   460\t            cmd_counsel([item_id])\n   461\t        counsel_after = latest_attempt_path(records_dir, \"counsel\")\n   462\t        if counsel_after is not None and counsel_after != counsel_before:\n   463\t            to_commit.append(counsel_after)\n   464\t        # file-stops is its own idempotent read of the item's records, so\n   465\t        # calling it here on every run that wrote a non-pass record is\n   720\t            print(\"attavo drive: --again is a no-op inside the budget; the pass retries on its own\")\n   721\t            return 0\n   722\t    return _advance_again(root, m, item_id, stage, r[\"head\"], again_by=True)\n   723\t\n   724\t\n   725\tdef _counsel_answered(records_dir: Path, r: \"DriveReport\") -> bool:\n   726\t    \"\"\"R3: whether the stop this report just read as \"stopped\" already\n   727\t    carries counsel's own \"answer\" verdict -- every non-retryable class\n   728\t    is counsel's to read (as before this item), and `answer` starts the\n   729\t    next attempt with the answer as its steer, read from the feedback\n   730\t    file the retried attempt's own first iteration is handed\n   731\t    (attavo.build._retry_seed).\"\"\"\n   732\t    if r[\"stop_class\"] in RETRYABLE_CLASSES or not r[\"stage\"] or r[\"attempt\"] is None:\n   733\t        return False\n   734\t    counsel = counsel_record_for(records_dir, r[\"stage\"], r[\"attempt\"])\n   735\t    return counsel is not None and counsel.get(\"verdict\") == \"answer\"\n   736\t\n   737\t\n   738\tdef _pass_once(root: Path, m: dict[str, Any], item_id: str, again: bool) -> tuple[int, \"DriveReport\"]:\n   739\t    \"\"\"One pass: fast-forward to origin (never while a worker holds the\n   740\t    copy), read the report, act at most once, return. The three acts,\n   741\t    one per report state that is the product's move: owes-recovery\n   742\t    recovers; next-build and next-review start their stage, handing a\n   743\t    review the checks the report already read once on the pre-marker\n   744\t    head; a concluded red check on a passed build's head (R3) is a\n   745\t    returned review record, not a level, so the review starts the same\n   746\t    way. On a stopped stage, `--again` always wins (a no-op inside the\n   747\t    budget, the next attempt once it is spent); absent it, a retryable\n   748\t    family retries on its own, and any other stop counsel has already\n   749\t    answered starts the next attempt steered by that answer. Every other\n   750\t    level is printed in the report's own words and left.\"\"\"\n   751\t    from attavo.report import drive_report\n   752\t    fast_forward_to_origin(root, m, item_id)\n   753\t    r = drive_report(root, m, item_id)\n   754\t\n   755\t    if r[\"state\"] == \"owes-recovery\":\n   756\t        records_dir = root / m[\"paths\"][\"records\"] / item_id\n   757\t        return _recover_one(root, m, item_id, records_dir), r\n   758\t    if r[\"state\"] == \"next-build\":\n   759\t        return _start_stage(root, m, item_id, \"build\", None), r\n   760\t    if r[\"state\"] == \"next-review\":\n   761\t        checks_command = (m.get(\"forge\") or {}).get(\"checks_command\")\n   762\t        forge_checks = {\"command\": checks_command, \"sha\": r[\"head\"], \"conclusions\": r[\"checks\"] or []}\n   763\t        return _start_stage(root, m, item_id, \"verify\", forge_checks), r\n   764\t    if r[\"state\"] == \"blocked-on-checks\" and r[\"stage\"] == \"verify\":\n   765\t        # R3: the rejection is a record, not a level with nothing behind\n   766\t        # it (#206's build-01) -- the review starts, reading the same\n   767\t        # forge checks this pass just read, and writes the check\n   768\t        # rejection itself as a returned record (attavo.verify.cmd_verify).\n   769\t        checks_command = (m.get(\"forge\") or {}).get(\"checks_command\")\n   770\t        forge_checks = {\"command\": checks_command, \"sha\": r[\"head\"], \"conclusions\": r[\"checks\"] or []}\n   771\t        return _start_stage(root, m, item_id, \"verify\", forge_checks), r\n   772\t    if r[\"state\"] == \"stopped\" and r[\"stage\"]:\n   773\t        if again:\n   774\t            return _handle_again(root, m, item_id, r), r\n   775\t        records_dir = root / m[\"paths\"][\"records\"] / item_id\n   776\t        if _retry_due(root, m, item_id, r):\n   777\t            return _advance_again(root, m, item_id, _retry_target(r), r[\"head\"]), r\n   778\t        if _counsel_answered(records_dir, r):\n   779\t            return _advance_again(root, m, item_id, _retry_target(r), r[\"head\"]), r\n   780\t\n   781\t    print(f\"attavo drive: {r['says']}\")\n   782\t    return (1 if r[\"state\"] == \"refused\" else 0), r\n   783\t\n   784\t\n   785\t_TERMINAL_STATES = (\"waiting-on-approval\", \"stopped\", \"ready-to-merge\", \"merged\")\n     1\tfrom __future__ import annotations\n     2\t\n     3\timport json\n     4\timport re\n     5\timport sys\n     6\tfrom pathlib import Path\n     7\tfrom typing import Any\n     8\t\n     9\tfrom attavo.common import MANIFEST, read_manifest\n    10\tfrom attavo.records import parse_attempts, stage_schema\n    11\tfrom attavo.types import CounselRecord, Stop\n    12\t\n    13\t# --- stop: every non-pass build or verify record's class and cause (issue\n    14\t# #89) -- derived here, at write time, from the refusal, halted, and log\n    15\t# the caller already has. Never a fresh read of anything: the tenant zero\n    16\t# specimens this retires (#576 build-11, #659 build-01 and verify-01) are\n    17\t# exactly a stop the product wrote with nothing beside it to explain\n    18\t# itself after the fact. ---\n    19\t\n    20\tSTOP_CLASSES = (\"non-question\", \"outlived-invocation\", \"no-cause\", \"forge-unconcluded\",\n    21\t               \"ceiling\", \"claims-boundary\", \"repeated-act\", \"unclassed\", \"question\",\n    22\t               \"environment\", \"gate\", \"died\", \"hung\", \"transient\", \"returned\")\n    23\t\n    24\t# R3: the four families a pass retries without a person -- died and hung\n    25\t# (recovery's, unchanged), transient (a vendor's capacity, rate, or 5xx\n    26\t# refusal), and returned (a build's head a required check rejected, or a\n    27\t# review that returned a blocking finding). Every other non-pass record\n    28\t# is a person's, once counsel has read it.\n    29\tRETRYABLE_CLASSES = (\"died\", \"hung\", \"transient\", \"returned\")\n    30\t\n    31\t\n    32\tdef signature_of(text: str | None) -> str | None:\n    33\t    \"\"\"R3: a failure's signature -- the text a script compares by\n    34\t    equality between two attempts, with every run of digits removed, so\n    35\t    a retry-after, a pid, or a timestamp never keeps two otherwise\n    36\t    identical failures from matching. None for None or empty text.\"\"\"\n    37\t    if not text:\n    38\t        return None\n    39\t    stripped = re.sub(r\"[0-9]+\", \"\", text).strip()\n    40\t    return stripped or None\n    41\t\n    42\t\n    43\tdef stage_exhausted(records_dir: Path, m: dict[str, Any], sig_stage: str, budget_stage: str) -> bool:\n    44\t    \"\"\"R3: whether a retryable stop on sig_stage is exhausted -- its own\n    45\t    last two attempts carry the identical signature (the early stop), or\n   150\t    now instead.\"\"\"\n   151\t    text = text or \"\"\n   152\t    for name in STOP_CLASSES:\n   153\t        markers = CLASS_TEXT_MARKERS.get(name, (name,))\n   154\t        if any(marker in text for marker in markers):\n   155\t            return name\n   156\t    return None\n   157\t\n   158\t\n   159\tdef derive_stop(status: str, *, refusal: str | None = None, halted: dict[str, Any] | None = None,\n   160\t                log: str | None = None, report_class: str | None = None,\n   161\t                refusal_provenance: str | None = None) -> Stop | None:\n   162\t    \"\"\"The stop field for a build or verify record: None for status \"pass\",\n   163\t    else {class, provenance, detail} from what the caller already knows.\n   164\t\n   165\t      - report_class -- payload.get(\"class\") off the adapter's own report\n   166\t        line (issue #88, #94), when it names a STOP_CLASSES member -- is\n   167\t        that class, provenance \"executor\". build.schema.json and\n   168\t        verify.schema.json stay untouched by issue #88 on purpose, so the\n   169\t        class lives only on the report line, never a structured field\n   170\t        cmd_build or cmd_verify forwards on its own account; the caller\n   171\t        reads payload itself and passes this in, since only it still has\n   172\t        payload once an iteration ends. This is non-question's and\n   173\t        outlived-invocation's only path to a record now (issue #94):\n   174\t        CLASS_TEXT_MARKERS disables both for the text scan below, the\n   175\t        same way issue #93 disabled ceiling's bare-name match there. A\n   176\t        class an adapter does not yet put on its report line --\n   177\t        outlived-invocation today, since that refusal path prints no\n   178\t        report line at all -- falls to unclassed below, same as any\n   179\t        other unnamed cause, until the adapter that raises it puts a\n   180\t        class on the line the way non-question already does.\n   181\t      - a halt carrying a non-empty halted.question, once it is not a\n   182\t        non-question caught above, is a genuine question -- question/spec,\n   183\t        with the question's own first line as detail (issue #100's\n   184\t        followups). This is the specimen issue #100 itself was built to\n   185\t        retire: tenant zero's #663 build-01, a proper question, classed\n   186\t        unclassed/product and filed as a product defect with the wrong\n   187\t        provenance -- a question is about the definition of done, which is\n   188\t        a person's or a ruling's to answer, never the product's own\n   189\t        mechanism.\n   190\t      - failing that, a refusal or the log itself that already names its\n   191\t        class in text (issue #88, #93 for ceiling's own pre-emptive\n   192\t        refusal) is that class, provenance \"executor\" -- the log is\n   193\t        checked because neither adapter's refusal *field* carries the\n   194\t        class today; the class-naming line each adapter prints reaches\n   195\t        only the transcript\n   196\t      - a refusal that is not that -- the write-outside-claims path\n   197\t        itself, not the \"commit ... not authored by the executor\" shape\n   198\t        -- is claims-boundary/spec, unless the caller already knows this\n   199\t        refusal touched paths.records or paths.specs (issue #140:\n   200\t        protected_path_touched, checked ahead of the ordinary claims\n   201\t        match in cmd_build) and passes refusal_provenance=\"executor\" --\n   202\t        the product's own directories are not a claim a spec makes, so a\n   203\t        refusal there is not the spec's boundary to answer for\n   204\t      - a returned verify (the forge was not green; no adapter ran) is\n   205\t        forge-unconcluded/tenant\n   206\t      - an adapter exit whose log carries a declared-ceiling error line is\n   207\t        ceiling/product\n   208\t      - anything else is unclassed/product, with the log's last line\n   209\t        (capped at UNCLASSED_DETAIL_MAX_CHARS) as its detail -- the other\n   210\t        class that carries a detail, since every remaining class's\n   211\t        evidence already lives in refusal, halted, forge_checks, or the\n   212\t        log itself.\n   213\t    \"\"\"\n   214\t    if status == \"pass\":\n   215\t        return None\n   216\t    if status == \"returned\":\n   217\t        return {\"class\": \"forge-unconcluded\", \"provenance\": \"tenant\", \"detail\": None}\n   218\t    if report_class in STOP_CLASSES:\n   219\t        return {\"class\": report_class, \"provenance\": \"executor\", \"detail\": None}\n   220\t    question = (halted or {}).get(\"question\")\n   221\t    if status == \"halted\" and question:\n   222\t        return {\"class\": \"question\", \"provenance\": \"spec\",\n   223\t               \"detail\": question.splitlines()[0]}\n   224\t    known = _carries_a_known_class(refusal) or _carries_a_known_class(log)\n   225\t    if known:\n   226\t        return {\"class\": known, \"provenance\": \"executor\", \"detail\": None}\n   227\t    if status == \"refused\" and refusal is not None and not refusal.startswith(\"commit \"):\n   228\t        return {\"class\": \"claims-boundary\", \"provenance\": refusal_provenance or \"spec\",\n   229\t               \"detail\": None}\n   230\t    if log and any(marker in log.lower() for marker in CEILING_MARKERS):\n","exit_code":0,"status":"completed"}}

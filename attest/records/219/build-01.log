{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019QQofo1tFps9hfb7s9S4BU","type":"tool_result","content":"1\tfrom __future__ import annotations\n2\t\n3\timport re\n4\t\n5\timport json\n6\timport sys\n7\tfrom pathlib import Path\n8\tfrom typing import Any\n9\t\n10\tfrom attavo.common import MANIFEST, read_manifest\n11\tfrom attavo.records import parse_attempts, stage_schema\n12\tfrom attavo.types import CounselRecord, Stop\n13\t\n14\t# --- stop: every non-pass build or verify record's class and cause (issue\n15\t# #89) -- derived here, at write time, from the refusal, halted, and log\n16\t# the caller already has. Never a fresh read of anything: the tenant zero\n17\t# specimens this retires (#576 build-11, #659 build-01 and verify-01) are\n18\t# exactly a stop the product wrote with nothing beside it to explain\n19\t# itself after the fact. ---\n20\t\n21\tSTOP_CLASSES = (\"non-question\", \"outlived-invocation\", \"no-cause\", \"forge-unconcluded\",\n22\t               \"ceiling\", \"claims-boundary\", \"repeated-act\", \"unclassed\", \"question\",\n23\t               \"environment\", \"gate\", \"died\", \"hung\", \"transient\", \"returned\")\n24\t\n25\t# R3: the families a pass retries without a person. Everything else is\n26\t# counsel's to read, and a person's when counsel says so.\n27\tRETRYABLE_CLASSES = (\"died\", \"hung\", \"transient\", \"returned\")\n28\t\n29\t\n30\tdef signature_of(text: str | None) -> str | None:\n31\t    \"\"\"R3: a failure's signature, compared by string equality between\n32\t    attempts: the text with every run of digits removed, so two refusals\n33\t    that differ only in a retry-after, a pid, or a timestamp match.\"\"\"\n34\t    if not text:\n35\t        return None\n36\t    return re.sub(r\"[0-9]+\", \"\", text).strip() or None\n37\t\n38\tSTOP_PROVENANCES = (\"product\", \"tenant\", \"executor\", \"spec\")\n39\t\n40\t# Beyond the enum spelling itself, the prose issue #88 actually shipped\n41\t# (adapters/claude-code/run and adapters/codex/run, on main since\n42\t# v0.16.0) once put a class's own name, or a real specimen's wording of\n43\t# it, in the transcript for the generic match below to find. Issue #94\n44\t# moves non-question and outlived-invocation onto report_class instead\n45\t# (below): non-question's own halt line (\"halted: class non-question\")\n46\t# would otherwise still satisfy the bare-name match here with no adapter\n47\t# report-line field involved at all, and outlived-invocation's refusal\n48\t# never named its class in text to begin with, so both are disabled here\n49\t# -- the same pattern issue #93 established for ceiling, just below,\n50\t# rather than removed outright.\n51\tCLASS_TEXT_MARKERS: dict[str, tuple[str, ...]] = {\n52\t    \"non-question\": (),\n53\t    \"outlived-invocation\": (),\n54\t    # Issue #93: ceiling's own text-based check is CEILING_MARKERS, below,\n55\t    # with provenance \"product\" -- a fact about the tool, not an executor\n56\t    # judgment like non-question/outlived-invocation are. Left at the\n57\t    # default (the class's own name, \"ceiling\"), the generic match above\n58\t    # would instead catch adapters/codex/run's and\n59\t    # adapters/claude-code/run's own pre-emptive refusal -- which must\n60\t    # carry the word \"ceiling\" by the same issue's own brief -- as\n61\t    # provenance \"executor\", before CEILING_MARKERS is ever consulted.\n62\t    \"ceiling\": (),\n63\t    # R3: transient is read from the adapter's report line (report_class),\n64\t    # returned is written by the product itself; neither is scanned for,\n65\t    # since a retried attempt's feedback file names the prior stop's class\n66\t    # and that text reaches the transcript.\n67\t    \"transient\": (),\n68\t    \"returned\": (),\n69\t    # A genuine question (issue #100's own followups) is read structurally\n70\t    # -- status \"halted\" carrying a non-empty halted.question -- not by\n71\t    # scanning for the literal word \"question\", which the question's own\n72\t    # text very often contains regardless of what it is actually asking.\n73\t    # Left at the default, the generic match above would misclassify any\n74\t    # question that happens to use the word \"question\" as executor\n75\t    # provenance, before the structural check in derive_stop is reached.\n76\t    \"question\": (),\n77\t    # environment/tenant (issue #115) is set directly by cmd_build's own\n78\t    # preflight -- the one caller who knows a [checks].command exited 2\n79\t    # on the approved tree -- never derived from adapter text. Left at\n80\t    # the default, the generic match above would catch the word\n81\t    # \"environment\" anywhere in a log or refusal (e.g. codex's own\n82\t    # OPENAI_API_KEY auth-mismatch refusal, adapters/codex/run's\n83\t    # check_auth) as an environment/executor stop that never happened.\n84\t    \"environment\": (),\n85\t}\n86\t\n87\t# Known tool error text for a declared ceiling -- issue #86's own specimen\n88\t# (codex's \"Input exceeds...\" line on a diff too large to judge) is\n89\t# \"input_too_large\"; a matching line anywhere in the log, not only its\n90\t# last line, since cmd_build and cmd_verify both append \"[adapter exited\n91\t# N]\" after whatever the tool itself printed. \"ceiling exceeded\" is issue\n92\t# #93's own addition: both adapters now refuse pre-emptively, before the\n93\t# tool is ever invoked, against a declared or fixed input limit, and\n94\t# their refusal text is not caught by any of the three markers above.\n95\tCEILING_MARKERS = (\"input_too_large\", \"exceeds the maximum context length\",\n96\t                  \"context_length_exceeded\", \"ceiling exceeded\")\n97\t\n98\t\n99\t# Issue #100's followups: an unclassed detail is the log's last line\n100\t# verbatim, and that line is sometimes an adapter's own event JSON or a\n101\t# tool's full error text -- thousands of characters wide. Capped here,\n102\t# at write time, so a filed issue's own summary of it (file-stops'\n103\t# log_tail already carries the full picture) stays short; the class\n104\t# itself, \"unclassed\", already says the full explanation lives in the\n105\t# log, not in this field.\n106\tUNCLASSED_DETAIL_MAX_CHARS = 200\n107\t\n108\t\n109\tdef _log_last_line(log: str | None) -> str:\n110\t    lines = [l for l in (log or \"\").splitlines() if l.strip()]\n111\t    last = lines[-1] if lines else \"\"\n112\t    return last[:UNCLASSED_DETAIL_MAX_CHARS]\n113\t\n114\t\n115\tdef _carries_a_known_class(text: str | None) -> str | None:\n116\t    \"\"\"Whichever of STOP_CLASSES this text names -- its own spelling, or\n117\t    one of CLASS_TEXT_MARKERS' real-world phrasings of it, when that\n118\t    class is not disabled there -- or None. Issue #88 is where an\n119\t    adapter's own halt or refusal first named its class this way; issue\n120\t    #93 added ceiling's own pre-emptive refusal to that set and disabled\n121\t    its bare-name match (CEILING_MARKERS covers it instead); issue #94\n122\t    disables non-question and outlived-invocation the same way, reading\n123\t    both from the adapter's own report line (derive_stop's report_class)\n124\t    now instead.\"\"\"\n125\t    text = text or \"\"\n126\t    for name in STOP_CLASSES:\n127\t        markers = CLASS_TEXT_MARKERS.get(name, (name,))\n128\t        if any(marker in text for marker in markers):\n129\t            return name\n130\t    return None\n131\t\n132\t\n133\tdef derive_stop(status: str, *, refusal: str | None = None, halted: dict[str, Any] | None = None,\n134\t                log: str | None = None, report_class: str | None = None,\n135\t                refusal_provenance: str | None = None) -> Stop | None:\n136\t    \"\"\"The stop field for a build or verify record: None for status \"pass\",\n137\t    else {class, provenance, detail} from what the caller already knows.\n138\t\n139\t      - report_class -- payload.get(\"class\") off the adapter's own report\n140\t        line (issue #88, #94), when it names a STOP_CLASSES member -- is\n141\t        that class, provenance \"executor\". build.schema.json and\n142\t        verify.schema.json stay untouched by issue #88 on purpose, so the\n143\t        class lives only on the report line, never a structured field\n144\t        cmd_build or cmd_verify forwards on its own account; the caller\n145\t        reads payload itself and passes this in, since only it still has\n146\t        payload once an iteration ends. This is non-question's and\n147\t        outlived-invocation's only path to a record now (issue #94):\n148\t        CLASS_TEXT_MARKERS disables both for the text scan below, the\n149\t        same way issue #93 disabled ceiling's bare-name match there. A\n150\t        class an adapter does not yet put on its report line --\n151\t        outlived-invocation today, since that refusal path prints no\n152\t        report line at all -- falls to unclassed below, same as any\n153\t        other unnamed cause, until the adapter that raises it puts a\n154\t        class on the line the way non-question already does.\n155\t      - a halt carrying a non-empty halted.question, once it is not a\n156\t        non-question caught above, is a genuine question -- question/spec,\n157\t        with the question's own first line as detail (issue #100's\n158\t        followups). This is the specimen issue #100 itself was built to\n159\t        retire: tenant zero's #663 build-01, a proper question, classed\n160\t        unclassed/product and filed as a product defect with the wrong\n161\t        provenance -- a question is about the definition of done, which is\n162\t        a person's or a ruling's to answer, never the product's own\n163\t        mechanism.\n164\t      - failing that, a refusal or the log itself that already names its\n165\t        class in text (issue #88, #93 for ceiling's own pre-emptive\n166\t        refusal) is that class, provenance \"executor\" -- the log is\n167\t        checked because neither adapter's refusal *field* carries the\n168\t        class today; the class-naming line each adapter prints reaches\n169\t        only the transcript\n170\t      - a refusal that is not that -- the write-outside-claims path\n171\t        itself, not the \"commit ... not authored by the executor\" shape\n172\t        -- is claims-boundary/spec, unless the caller already knows this\n173\t        refusal touched paths.records or paths.specs (issue #140:\n174\t        protected_path_touched, checked ahead of the ordinary claims\n175\t        match in cmd_build) and passes refusal_provenance=\"executor\" --\n176\t        the product's own directories are not a claim a spec makes, so a\n177\t        refusal there is not the spec's boundary to answer for\n178\t      - a returned verify (the forge was not green; no adapter ran) is\n179\t        forge-unconcluded/tenant\n180\t      - an adapter exit whose log carries a declared-ceiling error line is\n181\t        ceiling/product\n182\t      - anything else is unclassed/product, with the log's last line\n183\t        (capped at UNCLASSED_DETAIL_MAX_CHARS) as its detail -- the other\n184\t        class that carries a detail, since every remaining class's\n185\t        evidence already lives in refusal, halted, forge_checks, or the\n186\t        log itself.\n187\t    \"\"\"\n188\t    if status == \"pass\":\n189\t        return None\n190\t    if status == \"returned\":\n191\t        return {\"class\": \"forge-unconcluded\", \"provenance\": \"tenant\", \"detail\": None}\n192\t    if report_class in STOP_CLASSES:\n193\t        return {\"class\": report_class, \"provenance\": \"executor\", \"detail\": None}\n194\t    question = (halted or {}).get(\"question\")\n195\t    if status == \"halted\" and question:\n196\t        return {\"class\": \"question\", \"provenance\": \"spec\",\n197\t               \"detail\": question.splitlines()[0]}\n198\t    known = _carries_a_known_class(refusal) or _carries_a_known_class(log)\n199\t    if known:\n200\t        return {\"class\": known, \"provenance\": \"executor\", \"detail\": None}\n201\t    if status == \"refused\" and refusal is not None and not refusal.startswith(\"commit \"):\n202\t        return {\"class\": \"claims-boundary\", \"provenance\": refusal_provenance or \"spec\",\n203\t               \"detail\": None}\n204\t    if log and any(marker in log.lower() for marker in CEILING_MARKERS):\n205\t        return {\"class\": \"ceiling\", \"provenance\": \"product\", \"detail\": None}\n206\t    return {\"class\": \"unclassed\", \"provenance\": \"product\", \"detail\": _log_last_line(log)}\n207\t\n208\t\n209\tdef gate_stop(refusal: str | None) -> Stop:\n210\t    \"\"\"The stop for a refused spec-gate record: class \"gate\", provenance\n211\t    \"spec\", the refusal string itself as cause (issue #137) -- not\n212\t    derive_stop's generic claims-boundary/spec fallback issue #133\n213\t    reused, which named a boundary the record never crossed: \"criterion\n214\t    fails against the tree plus stub: doctor-template-absent.sh\" is not\n215\t    a write outside claims. cmd_spec_gate is untouched by this lane, so\n216\t    a spec record still carries no stop field of its own; this is\n217\t    synthesized wherever a refused one is read (item_stops,\n218\t    cmd_file_stops, proof_no_stop_lacks_cause), never persisted.\"\"\"\n219\t    return {\"class\": \"gate\", \"provenance\": \"spec\", \"detail\": refusal}\n220\t\n221\t\n222\t# --- stops: every non-pass record by class, provenance, and answerer\n223\t# (issue #129) ---\n224\t\n225\tdef item_stops(root: Path, m: dict[str, Any], item_id: str) -> dict[str, Any]:\n226\t    \"\"\"{\"item\", \"rows\", \"totals\"}: one row per non-pass build or verify\n227\t    record (STOP_STAGES), plus every refused spec-gate record (issue\n228\t    #133), class \"gate\" (issue #137) -- read from status and refusal\n229\t    rather than a stop field spec-gate records never carry (gate_stop\n230\t    synthesizes it) -- under item_id, whatever the record's own\n231\t    record_version -- a record too old to carry stop at all still gets\n232\t    a row, its class printed as the doctor's own phrase for it.\n233\t\n234\t    The answerer, a closed choice: \"counsel:<verdict>\" when\n235\t    counsel_record_for finds a counsel record naming this exact stage and\n236\t    number -- the product's own answer, which wins over whatever the stop\n237\t    itself says, since a counseled stop was already read once; failing\n238\t    that, \"person\" for class question (a person's to answer, not a\n239\t    guard's); failing that, \"guard\" for a class in GUARDED_STOP_CLASSES\n240\t    (a guard's own rejection needed no further reading); anything else\n241\t    -- no-cause, unclassed, or no stop at all -- is \"none\": nobody has\n242\t    answered it yet.\"\"\"\n243\t    records_rel = m[\"paths\"][\"records\"]\n244\t    item_records_dir = root / records_rel / item_id\n245\t    by_class = {c: 0 for c in stop_class_enum()}\n246\t    by_answerer: dict[str, int] = {}\n247\t    before_stop_was_recorded = 0\n248\t    rows: list[dict[str, Any]] = []\n249\t\n250\t    def add_row(stage: str, n: int, stop: Stop | None) -> None:\n251\t        nonlocal before_stop_was_recorded\n252\t        name = f\"{stage}-{n:02d}\"\n253\t        marker = item_records_dir / f\"{name}.filed\"\n254\t        filed_issue = marker.read_text() if marker.is_file() else None\n255\t        counsel = counsel_record_for(item_records_dir, stage, n)\n256\t\n257\t        if counsel is not None:\n258\t            answerer = f\"counsel:{counsel.get('verdict')}\"\n259\t        elif stop and stop.get(\"class\") == \"question\":\n260\t            answerer = \"person\"\n261\t        elif stop and stop.get(\"class\") in GUARDED_STOP_CLASSES:\n262\t            answerer = \"guard\"\n263\t        else:\n264\t            answerer = \"none\"\n265\t\n266\t        if stop:\n267\t            cls, provenance, detail = (stop.get(\"class\"), stop.get(\"provenance\"),\n268\t                                      stop.get(\"detail\"))\n269\t            if cls in by_class:\n270\t                by_class[cls] += 1\n271\t        else:\n272\t            cls, provenance, detail = \"before stop was recorded\", None, None\n273\t            before_stop_was_recorded += 1\n274\t\n275\t        by_answerer[answerer] = by_answerer.get(answerer, 0) + 1\n276\t        rows.append({\"item\": item_id, \"record\": name, \"class\": cls,\n277\t                    \"provenance\": provenance, \"detail\": detail,\n278\t                    \"answerer\": answerer, \"filed_issue\": filed_issue})\n279\t\n280\t    if item_records_dir.is_dir():\n281\t        for stage in STOP_STAGES:\n282\t            for n, rec in sorted(parse_attempts(item_records_dir, stage).items()):\n283\t                if rec.get(\"status\") == \"pass\":\n284\t                    continue\n285\t                add_row(stage, n, rec.get(\"stop\"))\n286\t        for n, rec in sorted(parse_attempts(item_records_dir, \"spec\").items()):\n287\t            if rec.get(\"status\") != \"refused\":\n288\t                continue\n289\t            add_row(\"spec\", n, gate_stop(rec.get(\"refusal\")))\n290\t\n291\t    totals = {\"by_class\": by_class, \"by_answerer\": by_answerer,\n292\t             \"before_stop_was_recorded\": before_stop_was_recorded}\n293\t    return {\"item\": item_id, \"rows\": rows, \"totals\": totals}\n294\t\n295\t\n296\tdef cmd_stops(argv: list[str]) -> int:\n297\t    as_json = \"--json\" in argv\n298\t    positional = [a for a in argv if a != \"--json\"]\n299\t    root = Path(\".\").resolve()\n300\t    m = read_manifest(root)\n301\t    if m is None:\n302\t        print(f\"attavo stops: no {MANIFEST} at {root}\", file=sys.stderr)\n303\t        return 2\n304\t\n305\t    records_rel = m[\"paths\"][\"records\"]\n306\t    if positional:\n307\t        item_ids = [positional[0]]\n308\t    else:\n309\t        records_root = root / records_rel\n310\t        item_ids = (sorted((p.name for p in records_root.iterdir() if p.is_dir()))\n311\t                   if records_root.is_dir() else [])\n312\t\n313\t    reports = [item_stops(root, m, item_id) for item_id in item_ids]\n314\t\n315\t    if as_json:\n316\t        if positional:\n317\t            print(json.dumps(reports[0], indent=2))\n318\t        else:\n319\t            print(json.dumps({\"items\": reports}, indent=2))\n320\t        return 0\n321\t\n322\t    for entry in reports:\n323\t        print(f\"attavo stops: item {entry['item']}\")\n324\t        for row in entry[\"rows\"]:\n325\t            filed = f\"  filed: {row['filed_issue'].strip()}\" if row[\"filed_issue\"] else \"\"\n326\t            print(f\"  {row['record']:<10} {row['class']:<24} {row['provenance'] or '-':<10} \"\n327\t                 f\"{row['answerer']:<16}{filed}\")\n328\t        t = entry[\"totals\"]\n329\t        print(f\"  by class: {t['by_class']}\")\n330\t        print(f\"  by answerer: {t['by_answerer']}\")\n331\t        print(f\"  before stop was recorded: {t['before_stop_was_recorded']}\")\n332\t    if not reports:\n333\t        print(f\"attavo stops: no item found under {records_rel}\")\n334\t    return 0\n335\t\n336\t\n337\t# The stop classes issue #89 gave no code of their own beyond the guard\n338\t# that raised them -- non-question and outlived-invocation from an\n339\t# adapter's own pre-emptive refusal, forge-unconcluded from a returned\n340\t# verify, ceiling from a declared-input-limit error, claims-boundary from\n341\t# the write-outside-claims refusal, repeated-act from... the same shape,\n342\t# environment from cmd_build's own [checks].command preflight (issue\n343\t# #115). question (a person's to answer) and the residual (no-cause,\n344\t# unclassed -- nobody has looked yet) are not in this tuple; attavo stops\n345\t# (issue #129) is the one reader, so it lives beside driver_identity,\n346\t# not beside derive_stop, which never needs to tell a guard from any\n347\t# other class once it has already named one.\n348\tGUARDED_STOP_CLASSES = (\"non-question\", \"outlived-invocation\", \"forge-unconcluded\", \"ceiling\",\n349\t                        \"claims-boundary\", \"repeated-act\", \"environment\")\n350\t\n351\t\n352\tdef stop_class_enum() -> tuple[str, ...]:\n353\t    \"\"\"Every class a stop can name, read from the build record schema's own\n354\t    enum (issue #129) rather than retyped -- STOP_CLASSES already drifted\n355\t    once (environment arrived in the schema before anything but derive_stop\n356\t    read it); a second copy is a second place to forget. build's schema is\n357\t    read, not verify's: verify's own enum is a strict subset (it never\n358\t    raises environment, cmd_build's own preflight alone).\"\"\"\n359\t    schema = stage_schema(\"build\")\n360\t    return tuple(schema[\"properties\"][\"stop\"][\"properties\"][\"class\"][\"enum\"])\n361\t\n362\t\n363\tSTOP_STAGES = (\"build\", \"verify\")\n364\t\n365\t\n366\tdef counsel_record_for(item_records_dir: Path, stage: str, n: int) -> CounselRecord | None:\n367\t    \"\"\"The latest counsel-NN.json (issue #100) whose own \"record\" field\n368\t    names f\"{stage}-{n:02d}\" -- the counsel invocation, if any, that read\n369\t    this exact stage record -- or None when counsel never ran against it\n370\t    (e.g. file-stops run standalone, outside drive).\"\"\"\n371\t    target = f\"{stage}-{n:02d}\"\n372\t    attempts = parse_attempts(item_records_dir, \"counsel\")\n373\t    matches = [rec for _, rec in sorted(attempts.items()) if rec.get(\"record\") == target]\n374\t    return matches[-1] if matches else None\n375\t"}]},"parent_tool_use_id":null,"session_id":"0dd7ed4f-100c-4188-9a34-077aa0b6aa25","uuid":"c879bd15-5596-4965-8776-dbced84a58f5","timestamp":"2026-09-26T02:08:30.988Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-219/attest/specs/219/stub/attavo/stops.py","content":"from __future__ import annotations\n\nimport re\n\nimport json\nimport sys\nfrom pathlib import Path\nfrom typing import Any\n\nfrom attavo.common import MANIFEST, read_manifest\nfrom attavo.records import parse_attempts, stage_schema\nfrom attavo.types import CounselRecord, Stop\n\n# --- stop: every non-pass build or verify record's class and cause (issue\n# #89) -- derived here, at write time, from the refusal, halted, and log\n# the caller already has. Never a fresh read of anything: the tenant zero\n# specimens this retires (#576 build-11, #659 build-01 and verify-01) are\n# exactly a stop the product wrote with nothing beside it to explain\n# itself after the fact. ---\n\nSTOP_CLASSES = (\"non-question\", \"outlived-invocation\", \"no-cause\", \"forge-unconcluded\",\n               \"ceiling\", \"claims-boundary\", \"repeated-act\", \"unclassed\", \"question\",\n               \"environment\", \"gate\", \"died\", \"hung\", \"transient\", \"returned\")\n\n# R3: the families a pass retries without a person. Everything else is\n# counsel's to read, and a person's when counsel says so.\nRETRYABLE_CLASSES = (\"died\", \"hung\", \"transient\", \"returned\")\n\n\ndef signature_of(text: str | None) -> str | None:\n    \"\"\"R3: a failure's signature, compared by string equality between\n    attempts: the text with every run of digits removed, so two refusals\n    that differ only in a retry-after, a pid, or a timestamp match.\"\"\"\n    if not text:\n        return None\n    return re.sub(r\"[0-9]+\", \"\", text).strip() or None\n\nSTOP_PROVENANCES = (\"product\", \"tenant\", \"executor\", \"spec\")\n\n# Beyond the enum spelling itself, the prose issue #88 actually shipped\n# (adapters/claude-code/run and adapters/codex/run, on main since\n# v0.16.0) once put a class's own name, or a real specimen's wording of\n# it, in the transcript for the generic match below to find. Issue #94\n# moves non-question and outlived-invocation onto report_class instead\n# (below): non-question's own halt line (\"halted: class non-question\")\n# would otherwise still satisfy the bare-name match here with no adapter\n# report-line field involved at all, and outlived-invocation's refusal\n# never named its class in text to begin with, so both are disabled here\n# -- the same pattern issue #93 established for ceiling, just below,\n# rather than removed outright.\nCLASS_TEXT_MARKERS: dict[str, tuple[str, ...]] = {\n    \"non-question\": (),\n    \"outlived-invocation\": (),\n    # Issue #93: ceiling's own text-based check is CEILING_MARKERS, below,\n    # with provenance \"product\" -- a fact about the tool, not an executor\n    # judgment like non-question/outlived-invocation are. Left at the\n    # default (the class's own name, \"ceiling\"), the generic match above\n    # would instead catch adapters/codex/run's and\n    # adapters/claude-code/run's own pre-emptive refusal -- which must\n    # carry the word \"ceiling\" by the same issue's own brief -- as\n    # provenance \"executor\", before CEILING_MARKERS is ever consulted.\n    \"ceiling\": (),\n    # R3: transient is read from the adapter's report line (report_class),\n    # returned is written by the product itself; neither is scanned for,\n    # since a retried attempt's feedback file names the prior stop's class\n    # and that text reaches the transcript.\n    \"transient\": (),\n    \"returned\": (),\n    # A genuine question (issue #100's own followups) is read structurally\n    # -- status \"halted\" carrying a non-empty halted.question -- not by\n    # scanning for the literal word \"question\", which the question's own\n    # text very often contains regardless of what it is actually asking.\n    # Left at the default, the generic match above would misclassify any\n    # question that happens to use the word \"question\" as executor\n    # provenance, before the structural check in derive_stop is reached.\n    \"question\": (),\n    # environment/tenant (issue #115) is set directly by cmd_build's own\n    # preflight -- the one caller who knows a [checks].command exited 2\n    # on the approved tree -- never derived from adapter text. Left at\n    # the default, the generic match above would catch the word\n    # \"environment\" anywhere in a log or refusal (e.g. codex's own\n    # OPENAI_API_KEY auth-mismatch refusal, adapters/codex/run's\n    # check_auth) as an environment/executor stop that never happened.\n    \"environment\": (),\n}\n\n# Known tool error text for a declared ceiling -- issue #86's own specimen\n# (codex's \"Input exceeds...\" line on a diff too large to judge) is\n# \"input_too_large\"; a matching line anywhere in the log, not only its\n# last line, since cmd_build and cmd_verify both append \"[adapter exited\n# N]\" after whatever the tool itself printed. \"ceiling exceeded\" is issue\n# #93's own addition: both adapters now refuse pre-emptively, before the\n# tool is ever invoked, against a declared or fixed input limit, and\n# their refusal text is not caught by any of the three markers above.\nCEILING_MARKERS = (\"input_too_large\", \"exceeds the maximum context length\",\n                  \"context_length_exceeded\", \"ceiling exceeded\")\n\n\n# Issue #100's followups: an unclassed detail is the log's last line\n# verbatim, and that line is sometimes an adapter's own event JSON or a\n# tool's full error text -- thousands of characters wide. Capped here,\n# at write time, so a filed issue's own summary of it (file-stops'\n# log_tail already carries the full picture) stays short; the class\n# itself, \"unclassed\", already says the full explanation lives in the\n# log, not in this field.\nUNCLASSED_DETAIL_MAX_CHARS = 200\n\n\ndef _log_last_line(log: str | None) -> str:\n    lines = [l for l in (log or \"\").splitlines() if l.strip()]\n    last = lines[-1] if lines else \"\"\n    return last[:UNCLASSED_DETAIL_MAX_CHARS]\n\n\ndef _carries_a_known_class(text: str | None) -> str | None:\n    \"\"\"Whichever of STOP_CLASSES this text names -- its own spelling, or\n    one of CLASS_TEXT_MARKERS' real-world phrasings of it, when that\n    class is not disabled there -- or None. Issue #88 is where an\n    adapter's own halt or refusal first named its class this way; issue\n    #93 added ceiling's own pre-emptive refusal to that set and disabled\n    its bare-name match (CEILING_MARKERS covers it instead); issue #94\n    disables non-question and outlived-invocation the same way, reading\n    both from the adapter's own report line (derive_stop's report_class)\n    now instead.\"\"\"\n    text = text or \"\"\n    for name in STOP_CLASSES:\n        markers = CLASS_TEXT_MARKERS.get(name, (name,))\n        if any(marker in text for marker in markers):\n            return name\n    return None\n\n\ndef derive_stop(status: str, *, refusal: str | None = None, halted: dict[str, Any] | None = None,\n                log: str | None = None, report_class: str | None = None,\n                refusal_provenance: str | None = None) -> Stop | None:\n    \"\"\"The stop field for a build or verify record: None for status \"pass\",\n    else {class, provenance, detail} from what the caller already knows.\n\n      - report_class -- payload.get(\"class\") off the adapter's own report\n        line (issue #88, #94), when it names a STOP_CLASSES member -- is\n        that class, provenance \"executor\". build.schema.json and\n        verify.schema.json stay untouched by issue #88 on purpose, so the\n        class lives only on the report line, never a structured field\n        cmd_build or cmd_verify forwards on its own account; the caller\n        reads payload itself and passes this in, since only it still has\n        payload once an iteration ends. This is non-question's and\n        outlived-invocation's only path to a record now (issue #94):\n        CLASS_TEXT_MARKERS disables both for the text scan below, the\n        same way issue #93 disabled ceiling's bare-name match there. A\n        class an adapter does not yet put on its report line --\n        outlived-invocation today, since that refusal path prints no\n        report line at all -- falls to unclassed below, same as any\n        other unnamed cause, until the adapter that raises it puts a\n        class on the line the way non-question already does.\n      - a halt carrying a non-empty halted.question, once it is not a\n        non-question caught above, is a genuine question -- question/spec,\n        with the question's own first line as detail (issue #100's\n        followups). This is the specimen issue #100 itself was built to\n        retire: tenant zero's #663 build-01, a proper question, classed\n        unclassed/product and filed as a product defect with the wrong\n        provenance -- a question is about the definition of done, which is\n        a person's or a ruling's to answer, never the product's own\n        mechanism.\n      - failing that, a refusal or the log itself that already names its\n        class in text (issue #88, #93 for ceiling's own pre-emptive\n        refusal) is that class, provenance \"executor\" -- the log is\n        checked because neither adapter's refusal *field* carries the\n        class today; the class-naming line each adapter prints reaches\n        only the transcript\n      - a refusal that is not that -- the write-outside-claims path\n        itself, not the \"commit ... not authored by the executor\" shape\n        -- is claims-boundary/spec, unless the caller already knows this\n        refusal touched paths.records or paths.specs (issue #140:\n        protected_path_touched, checked ahead of the ordinary claims\n        match in cmd_build) and passes refusal_provenance=\"executor\" --\n        the product's own directories are not a claim a spec makes, so a\n        refusal there is not the spec's boundary to answer for\n      - a returned verify (the forge was not green; no adapter ran) is\n        forge-unconcluded/tenant\n      - an adapter exit whose log carries a declared-ceiling error line is\n        ceiling/product\n      - anything else is unclassed/product, with the log's last line\n        (capped at UNCLASSED_DETAIL_MAX_CHARS) as its detail -- the other\n        class that carries a detail, since every remaining class's\n        evidence already lives in refusal, halted, forge_checks, or the\n        log itself.\n    \"\"\"\n    if status == \"pass\":\n        return None\n    if status == \"returned\":\n        return {\"class\": \"forge-unconcluded\", \"provenance\": \"tenant\", \"detail\": None}\n    if report_class in STOP_CLASSES:\n        return {\"class\": report_class, \"provenance\": \"executor\", \"detail\": None}\n    question = (halted or {}).get(\"question\")\n    if status == \"halted\" and question:\n        return {\"class\": \"question\", \"provenance\": \"spec\",\n               \"detail\": question.splitlines()[0]}\n    known = _carries_a_known_class(refusal) or _carries_a_known_class(log)\n    if known:\n        return {\"class\": known, \"provenance\": \"executor\", \"detail\": None}\n    if status == \"refused\" and refusal is not None and not refusal.startswith(\"commit \"):\n        return {\"class\": \"claims-boundary\", \"provenance\": refusal_provenance or \"spec\",\n               \"detail\": None}\n    if log and any(marker in log.lower() for marker in CEILING_MARKERS):\n        return {\"class\": \"ceiling\", \"provenance\": \"product\", \"detail\": None}\n    return {\"class\": \"unclassed\", \"provenance\": \"product\", \"detail\": _log_last_line(log)}\n\n\ndef gate_stop(refusal: str | None) -> Stop:\n    \"\"\"The stop for a refused spec-gate record: class \"gate\", provenance\n    \"spec\", the refusal string itself as cause (issue #137) -- not\n    derive_stop's generic claims-boundary/spec fallback issue #133\n    reused, which named a boundary the record never crossed: \"criterion\n    fails against the tree plus stub: doctor-template-absent.sh\" is not\n    a write outside claims. cmd_spec_gate is untouched by this lane, so\n    a spec record still carries no stop field of its own; this is\n    synthesized wherever a refused one is read (item_stops,\n    cmd_file_stops, proof_no_stop_lacks_cause), never persisted.\"\"\"\n    return {\"class\": \"gate\", \"provenance\": \"spec\", \"detail\": refusal}\n\n\n# --- stops: every non-pass record by class, provenance, and answerer\n# (issue #129) ---\n\ndef item_stops(root: Path, m: dict[str, Any], item_id: str) -> dict[str, Any]:\n    \"\"\"{\"item\", \"rows\", \"totals\"}: one row per non-pass build or verify\n    record (STOP_STAGES), plus every refused spec-gate record (issue\n    #133), class \"gate\" (issue #137) -- read from status and refusal\n    rather than a stop field spec-gate records never carry (gate_stop\n    synthesizes it) -- under item_id, whatever the record's own\n    record_version -- a record too old to carry stop at all still gets\n    a row, its class printed as the doctor's own phrase for it.\n\n    The answerer, a closed choice: \"counsel:<verdict>\" when\n    counsel_record_for finds a counsel record naming this exact stage and\n    number -- the product's own answer, which wins over whatever the stop\n    itself says, since a counseled stop was already read once; failing\n    that, \"person\" for class question (a person's to answer, not a\n    guard's); failing that, \"guard\" for a class in GUARDED_STOP_CLASSES\n    (a guard's own rejection needed no further reading); anything else\n    -- no-cause, unclassed, or no stop at all -- is \"none\": nobody has\n    answered it yet.\"\"\"\n    records_rel = m[\"paths\"][\"records\"]\n    item_records_dir = root / records_rel / item_id\n    by_class = {c: 0 for c in stop_class_enum()}\n    by_answerer: dict[str, int] = {}\n    before_stop_was_recorded = 0\n    rows: list[dict[str, Any]] = []\n\n    def add_row(stage: str, n: int, stop: Stop | None) -> None:\n        nonlocal before_stop_was_recorded\n        name = f\"{stage}-{n:02d}\"\n        marker = item_records_dir / f\"{name}.filed\"\n        filed_issue = marker.read_text() if marker.is_file() else None\n        counsel = counsel_record_for(item_records_dir, stage, n)\n\n        if counsel is not None:\n            answerer = f\"counsel:{counsel.get('verdict')}\"\n        elif stop and stop.get(\"class\") == \"question\":\n            answerer = \"person\"\n        elif stop and stop.get(\"class\") in GUARDED_STOP_CLASSES:\n            answerer = \"guard\"\n        else:\n            answerer = \"none\"\n\n        if stop:\n            cls, provenance, detail = (stop.get(\"class\"), stop.get(\"provenance\"),\n                                      stop.get(\"detail\"))\n            if cls in by_class:\n                by_class[cls] += 1\n        else:\n            cls, provenance, detail = \"before stop was recorded\", None, None\n            before_stop_was_recorded += 1\n\n        by_answerer[answerer] = by_answerer.get(answerer, 0) + 1\n        rows.append({\"item\": item_id, \"record\": name, \"class\": cls,\n                    \"provenance\": provenance, \"detail\": detail,\n                    \"answerer\": answerer, \"filed_issue\": filed_issue})\n\n    if item_records_dir.is_dir():\n        for stage in STOP_STAGES:\n            for n, rec in sorted(parse_attempts(item_records_dir, stage).items()):\n                if rec.get(\"status\") == \"pass\":\n                    continue\n                add_row(stage, n, rec.get(\"stop\"))\n        for n, rec in sorted(parse_attempts(item_records_dir, \"spec\").items()):\n            if rec.get(\"status\") != \"refused\":\n                continue\n            add_row(\"spec\", n, gate_stop(rec.get(\"refusal\")))\n\n    totals = {\"by_class\": by_class, \"by_answerer\": by_answerer,\n             \"before_stop_was_recorded\": before_stop_was_recorded}\n    return {\"item\": item_id, \"rows\": rows, \"totals\": totals}\n\n\ndef cmd_stops(argv: list[str]) -> int:\n    as_json = \"--json\" in argv\n    positional = [a for a in argv if a != \"--json\"]\n    root = Path(\".\").resolve()\n    m = read_manifest(root)\n    if m is None:\n        print(f\"attavo stops: no {MANIFEST} at {root}\", file=sys.stderr)\n        return 2\n\n    records_rel = m[\"paths\"][\"records\"]\n    if positional:\n        item_ids = [positional[0]]\n    else:\n        records_root = root / records_rel\n        item_ids = (sorted((p.name for p in records_root.iterdir() if p.is_dir()))\n                   if records_root.is_dir() else [])\n\n    reports = [item_stops(root, m, item_id) for item_id in item_ids]\n\n    if as_json:\n        if positional:\n            print(json.dumps(reports[0], indent=2))\n        else:\n            print(json.dumps({\"items\": reports}, indent=2))\n        return 0\n\n    for entry in reports:\n        print(f\"attavo stops: item {entry['item']}\")\n        for row in entry[\"rows\"]:\n            filed = f\"  filed: {row['filed_issue'].strip()}\" if row[\"filed_issue\"] else \"\"\n            print(f\"  {row['record']:<10} {row['class']:<24} {row['provenance'] or '-':<10} \"\n                 f\"{row['answerer']:<16}{filed}\")\n        t = entry[\"totals\"]\n        print(f\"  by class: {t['by_class']}\")\n        print(f\"  by answerer: {t['by_answerer']}\")\n        print(f\"  before stop was recorded: {t['before_stop_was_recorded']}\")\n    if not reports:\n        print(f\"attavo stops: no item found under {records_rel}\")\n    return 0\n\n\n# The stop classes issue #89 gave no code of their own beyond the guard\n# that raised them -- non-question and outlived-invocation from an\n# adapter's own pre-emptive refusal, forge-unconcluded from a returned\n# verify, ceiling from a declared-input-limit error, claims-boundary from\n# the write-outside-claims refusal, repeated-act from... the same shape,\n# environment from cmd_build's own [checks].command preflight (issue\n# #115). question (a person's to answer) and the residual (no-cause,\n# unclassed -- nobody has looked yet) are not in this tuple; attavo stops\n# (issue #129) is the one reader, so it lives beside driver_identity,\n# not beside derive_stop, which never needs to tell a guard from any\n# other class once it has already named one.\nGUARDED_STOP_CLASSES = (\"non-question\", \"outlived-invocation\", \"forge-unconcluded\", \"ceiling\",\n                        \"claims-boundary\", \"repeated-act\", \"environment\")\n\n\ndef stop_class_enum() -> tuple[str, ...]:\n    \"\"\"Every class a stop can name, read from the build record schema's own\n    enum (issue #129) rather than retyped -- STOP_CLASSES already drifted\n    once (environment arrived in the schema before anything but derive_stop\n    read it); a second copy is a second place to forget. build's schema is\n    read, not verify's: verify's own enum is a strict subset (it never\n    raises environment, cmd_build's own preflight alone).\"\"\"\n    schema = stage_schema(\"build\")\n    return tuple(schema[\"properties\"][\"stop\"][\"properties\"][\"class\"][\"enum\"])\n\n\nSTOP_STAGES = (\"build\", \"verify\")\n\n\ndef counsel_record_for(item_records_dir: Path, stage: str, n: int) -> CounselRecord | None:\n    \"\"\"The latest counsel-NN.json (issue #100) whose own \"record\" field\n    names f\"{stage}-{n:02d}\" -- the counsel invocation, if any, that read\n    this exact stage record -- or None when counsel never ran against it\n    (e.g. file-stops run standalone, outside drive).\"\"\"\n    target = f\"{stage}-{n:02d}\"\n    attempts = parse_attempts(item_records_dir, \"counsel\")\n    matches = [rec for _, rec in sorted(attempts.items()) if rec.get(\"record\") == target]\n    return matches[-1] if matches else None\n","numLines":375,"startLine":1,"totalLines":375}}}

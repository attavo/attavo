{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Q41tEXVL2necvX8VgvnNAK","type":"tool_result","content":"1\tfrom __future__ import annotations\n2\t\n3\timport fnmatch\n4\timport json\n5\timport os\n6\timport subprocess\n7\timport sys\n8\timport tempfile\n9\timport time\n10\tfrom pathlib import Path\n11\tfrom typing import cast, Any\n12\t\n13\tfrom attavo.approval import approval_status\n14\tfrom attavo.common import (\n15\t    MANIFEST,\n16\t    PRODUCT_ROOT,\n17\t    ShallowCheckoutError,\n18\t    derive_item_id,\n19\t    git,\n20\t    last_commit_touching,\n21\t    now_iso,\n22\t    read_manifest,\n23\t)\n24\tfrom attavo.events import append_event, stage_events_dir\n25\tfrom attavo.records import latest_record, next_attempt_number, write_record\n26\tfrom attavo.spec import parse_spec, run_criterion\n27\tfrom attavo.stops import _log_last_line, derive_stop, signature_of\n28\tfrom attavo.testtool import run_bounded, without_records\n29\t\n30\t# --- build: adapter, claims boundary, criteria, and the tenant's tests ---\n31\t\n32\tSTAGE_NAMES = (\"build\", \"verify\", \"counsel\")\n33\t\n34\t\n35\tdef merge_adapter_config(m: dict[str, Any], adapter_name: str, stage: str) -> dict[str, Any]:\n36\t    \"\"\"[executor.<adapter>] merged with [executor.<adapter>.<stage>], the\n37\t    stage table shadowing the parent for that stage only. Both build and\n38\t    verify call this before setting ATTAVO_ADAPTER_CONFIG, and the\n39\t    record's adapter_config is the merged result.\"\"\"\n40\t    parent = (m.get(\"executor\") or {}).get(adapter_name) or {}\n41\t    if not isinstance(parent, dict):\n42\t        return {}\n43\t    merged = {k: v for k, v in parent.items() if k not in STAGE_NAMES}\n44\t    stage_table = parent.get(stage)\n45\t    if isinstance(stage_table, dict):\n46\t        merged.update(stage_table)\n47\t    return merged\n48\t\n49\t\n50\tdef resolve_adapter(root: Path, name: str) -> Path | None:\n51\t    \"\"\"adapters/<name>/run, resolved first under the tenant's own\n52\t    attavo/adapters/, then under this product's adapters/.\"\"\"\n53\t    for base in (root / \"attavo\" / \"adapters\", PRODUCT_ROOT / \"adapters\"):\n54\t        candidate = base / name / \"run\"\n55\t        if candidate.is_file():\n56\t            return candidate\n57\t    return None\n58\t\n59\t\n60\tdef adapter_reports(adapter_path: Path) -> list[str]:\n61\t    \"\"\"Field names adapters/<name>/conformance.json declares this adapter\n62\t    can supply with a real value -- vendor independence (2026-09-09\n63\t    ruling): the record carries the declaration, so an adapter claiming\n64\t    a field and returning null for it fails the conformance suite\n65\t    instead of writing a silent, uncomparable null. [] when the\n66\t    resolved adapter (a tenant override included) declares no\n67\t    conformance.json at all -- an absent declaration, not a refusal.\"\"\"\n68\t    manifest_path = adapter_path.parent / \"conformance.json\"\n69\t    if not manifest_path.is_file():\n70\t        return []\n71\t    try:\n72\t        manifest = json.loads(manifest_path.read_text())\n73\t    except json.JSONDecodeError:\n74\t        return []\n75\t    reports: list[str] = manifest.get(\"reports\", [])\n76\t    return reports\n77\t\n78\t\n79\tdef changed_paths(root: Path, start_sha: str, records_rel: str) -> list[str]:\n80\t    \"\"\"Paths changed between start_sha and HEAD, other than paths.records --\n81\t    the records directory is where build itself writes, not a claim.\"\"\"\n82\t    return without_records(git(root, \"diff\", \"--name-only\", start_sha, \"HEAD\").splitlines(),\n83\t                           records_rel)\n84\t\n85\t\n86\tdef matches_a_claim(path: str, claims: list[str]) -> bool:\n87\t    return any(fnmatch.fnmatch(path, pattern) for pattern in claims)\n88\t\n89\t\n90\tdef protected_path_touched(root: Path, start_sha: str, records_rel: str,\n91\t                           specs_rel: str) -> str | None:\n92\t    \"\"\"The first path an executor's own commits touched under\n93\t    paths.records or paths.specs since start_sha, or None (issue #140).\n94\t    Neither directory is a claim a spec can make -- paths.records is\n95\t    where the product itself writes, paths.specs is the definition of\n96\t    done -- yet changed_paths above excludes paths.records from the\n97\t    ordinary claims check entirely, so a path there never even reached\n98\t    matches_a_claim to be refused: tenant zero's own item #688 committed\n99\t    its own events file this way, under its records directory, on a\n100\t    build that then passed. Checked directly against the raw diff, not\n101\t    changed_paths's already-filtered list.\"\"\"\n102\t    touched = git(root, \"diff\", \"--name-only\", start_sha, \"HEAD\").splitlines()\n103\t    protected = []\n104\t    for rel in (records_rel, specs_rel):\n105\t        stripped = rel.rstrip(\"/\")\n106\t        protected.append((stripped, stripped + \"/\"))\n107\t    for p in touched:\n108\t        if not p:\n109\t            continue\n110\t        for exact, prefix in protected:\n111\t            if p == exact or p.startswith(prefix):\n112\t                return p\n113\t    return None\n114\t\n115\t\n116\tdef executor_identity(adapter_name: str) -> dict[str, Any]:\n117\t    \"\"\"The executor's identity (issue #33): set by the product, never the\n118\t    tenant's git config, so an executor commit is never indistinguishable\n119\t    from an operator's own -- the specimen is attavo/code-factory@e22fa85.\n120\t    A reserved, undeliverable domain (.invalid) so no mailbox is implied.\n121\t    Distinct from the records app identity: the app says the product\n122\t    pushed this, this says an invocation authored this -- different\n123\t    facts, neither borrows the other's name.\"\"\"\n124\t    return {\"name\": f\"attavo executor ({adapter_name})\",\n125\t            \"email\": f\"executor+{adapter_name}@attavo.invalid\"}\n126\t\n127\t\n128\tdef driver_identity() -> dict[str, Any]:\n129\t    \"\"\"The driver's identity: set by the product, never the tenant's git\n130\t    config, so a driver's own transport commit -- a record commit\n131\t    `commit_record` makes on the driver's behalf -- is never\n132\t    indistinguishable from an operator's own; `git log --author='attavo\n133\t    driver'` on a driven item lists exactly those commits. Distinct from\n134\t    executor_identity: that names an adapter invocation's own commits,\n135\t    this names the transport that carries a stage's record.\"\"\"\n136\t    return {\"name\": \"attavo driver\", \"email\": \"driver@attavo.invalid\"}\n137\t\n138\t\n139\tdef commits_since(root: Path, start_sha: str, end: str = \"HEAD\") -> list[dict[str, Any]]:\n140\t    \"\"\"(sha, name, email) for every commit after start_sha up to and\n141\t    including end, first-parent only, oldest first. cmd_build's own call\n142\t    (start_sha at the invocation, end left at the default HEAD) never sees\n143\t    a merge in that window, so --first-parent changes nothing there;\n144\t    issue #128's ledger is the caller that needs it, to walk one branch's\n145\t    own line without a concurrent merge to main expanding into every\n146\t    commit main gained meanwhile.\"\"\"\n147\t    out = git(root, \"log\", \"--first-parent\", \"--reverse\",\n148\t             \"--format=%H\\x1f%an\\x1f%ae\", f\"{start_sha}..{end}\")\n149\t    commits = []\n150\t    for line in out.splitlines():\n151\t        if not line.strip():\n152\t            continue\n153\t        sha, name, email = line.split(\"\\x1f\")\n154\t        commits.append({\"sha\": sha, \"name\": name, \"email\": email})\n155\t    return commits\n156\t\n157\t\n158\tdef commits_with_diffs(root: Path, start_sha: str, end: str = \"HEAD\") -> list[dict[str, Any]]:\n159\t    \"\"\"commits_since's own (sha, name, email), each with its own\n160\t    first-parent diff already attached as \"touched\" -- one process for the\n161\t    whole range rather than commits_since's list plus a git diff per\n162\t    commit (issue #153, the cost item_ledger's own walk paid per commit).\"\"\"\n163\t    out = git(root, \"log\", \"--first-parent\", \"--reverse\", \"--diff-merges=first-parent\",\n164\t             \"--name-only\", \"--format=\\x01%H\\x1f%an\\x1f%ae\", f\"{start_sha}..{end}\")\n165\t    commits = []\n166\t    for block in out.split(\"\\x01\")[1:]:\n167\t        header, _, rest = block.partition(\"\\n\")\n168\t        sha, name, email = header.split(\"\\x1f\")\n169\t        commits.append({\"sha\": sha, \"name\": name, \"email\": email,\n170\t                        \"touched\": [line for line in rest.splitlines() if line.strip()]})\n171\t    return commits\n172\t\n173\t\n174\tdef split_adapter_stdout(stdout: str) -> tuple[str, dict[str, Any] | None]:\n175\t    \"\"\"(transcript, payload): the adapter's last non-empty stdout line is\n176\t    its JSON report, and everything before it is transcript, only when\n177\t    that last line actually parses as JSON. When it does not -- a tool's\n178\t    own error line printed last on a non-zero exit (issue #86: tenant\n179\t    zero attest/records/659/verify-01.log, codex's own \"Input exceeds...\"\n180\t    line, dropped because it was mistaken for an attempted payload) --\n181\t    nothing here is a report, and the whole stdout is the transcript, so\n182\t    that last line is not silently lost.\n183\t    \"\"\"\n184\t    lines = stdout.splitlines()\n185\t    non_empty = [i for i, l in enumerate(lines) if l.strip()]\n186\t    if not non_empty:\n187\t        return stdout, None\n188\t    last = non_empty[-1]\n189\t    try:\n190\t        payload = json.loads(lines[last])\n191\t    except ValueError:\n192\t        return stdout, None\n193\t    transcript = \"\\n\".join(lines[:last])\n194\t    return transcript, payload\n195\t\n196\t\n197\tBUILD_ITERATION_BUDGET = 3\n198\t\n199\tBUILD_HALT_EXIT = 3\n200\t\n201\tCHECKS_FEEDBACK_TAIL_LINES = 200\n202\t\n203\t\n204\tdef _retry_seed(root: Path, m: dict[str, Any], records_dir: Path) -> tuple[str | None, str]:\n205\t    \"\"\"R3 (stub): the prior attempt this build retries and the feedback it\n206\t    is handed. A build retries the latest build record that is not a pass,\n207\t    or the latest verify record that returned it (class returned).\"\"\"\n208\t    import shlex\n209\t    latest_build = cast(\"dict[str, Any] | None\", latest_record(records_dir, \"build\"))\n210\t    latest_verify = cast(\"dict[str, Any] | None\", latest_record(records_dir, \"verify\"))\n211\t    prior_stem = f\"build-{next_attempt_number(records_dir, 'build') - 1:02d}\"\n212\t    prior: dict[str, Any] | None = None\n213\t    if (latest_verify and (latest_verify.get(\"stop\") or {}).get(\"class\") == \"returned\" and latest_build\n214\t            and latest_verify.get(\"build_sha\") == latest_build.get(\"sha\")):\n215\t        prior = latest_verify\n216\t    elif latest_build and latest_build.get(\"status\") != \"pass\":\n217\t        prior = latest_build\n218\t    if prior is None:\n219\t        return None, \"\"\n220\t    stop: dict[str, Any] = prior.get(\"stop\") or {}\n221\t    lines = [f\"attempt {prior_stem} stopped as {stop.get('class')}: {stop.get('detail') or ''}\",\n222\t             f\"signature: {stop.get('signature') or ''}\", \"\"]\n223\t    forge = m.get(\"forge\") or {}\n224\t    if stop.get(\"class\") == \"returned\" and forge.get(\"check_log_command\"):\n225\t        for c in (prior.get(\"forge_checks\") or {}).get(\"conclusions\") or []:\n226\t            if c.get(\"conclusion\") not in (\"success\", \"neutral\", \"skipped\"):\n227\t                run = subprocess.run(f\"{forge['check_log_command']} {shlex.quote(str(prior.get('sha')))} {shlex.quote(c['name'])}\",\n228\t                                     shell=True, cwd=str(root), capture_output=True, text=True, check=False)\n229\t                lines += [f\"--- check {c['name']} {c['conclusion']} ---\", run.stdout.strip(), \"\"]\n230\t    return prior_stem, \"\\n\".join(lines) + \"\\n\"\n231\t\n232\t\n233\tdef cmd_build(argv: list[str]) -> int:\n234\t    root = Path(\".\").resolve()\n235\t    item_id = argv[0] if argv else derive_item_id(root)\n236\t    if not item_id:\n237\t        print(\"attavo build: cannot derive item id; pass N or run on an attavo/N-* branch\",\n238\t              file=sys.stderr)\n239\t        return 2\n240\t    m = read_manifest(root)\n241\t    if m is None:\n242\t        print(f\"attavo build: no {MANIFEST} at {root}\", file=sys.stderr)\n243\t        return 2\n244\t\n245\t    adapter_name = (m.get(\"executor\") or {}).get(\"build\")\n246\t    if not adapter_name:\n247\t        print(\"attavo build: refused: no [executor].build in the manifest\")\n248\t        return 1\n249\t\n250\t    tests_cfg = m.get(\"tests\") or {}\n251\t    if not tests_cfg.get(\"select\") or not tests_cfg.get(\"run\"):\n252\t        print(\"attavo build: refused: no [tests] table in the manifest \"\n253\t              \"([tests].select and [tests].run are both required)\")\n254\t        return 1\n255\t\n256\t    if (m.get(\"checks\") or {}).get(\"probe\") and not (m.get(\"checks\") or {}).get(\"probe_timeout_s\"):\n257\t        print(\"attavo build: refused: [checks].probe is declared without \"\n258\t              \"[checks].probe_timeout_s (a probe with no bound is not asked)\")\n259\t        return 1\n260\t\n261\t    try:\n262\t        status = approval_status(root, m, item_id)\n263\t    except ShallowCheckoutError as exc:\n264\t        print(f\"attavo build: refused: {exc}\", file=sys.stderr)\n265\t        return 2\n266\t    if status != \"valid\":\n267\t        print(f\"attavo build: refused: approval is {status}\")\n268\t        return 1\n269\t\n270\t    adapter_path = resolve_adapter(root, adapter_name)\n271\t    if adapter_path is None:\n272\t        print(f\"attavo build: refused: no adapter named {adapter_name!r}\")\n273\t        return 1\n274\t\n275\t    specs_rel = m[\"paths\"][\"specs\"]\n276\t    records_rel = m[\"paths\"][\"records\"]\n277\t    spec_dir = root / specs_rel / item_id\n278\t    item_records_dir = root / records_rel / item_id\n279\t    spec_sha = last_commit_touching(root, str(Path(specs_rel) / item_id))\n280\t    latest_approval = latest_record(item_records_dir, \"approval\")\n281\t    parsed, _ = parse_spec(spec_dir / \"spec.md\")\n282\t    claims = parsed[\"claims\"] if parsed else []\n283\t    criteria_names = parsed[\"criteria\"] if parsed else []\n284\t    adapter_config = merge_adapter_config(m, adapter_name, \"build\")\n285\t    checks_cfg = m.get(\"checks\") or {}\n286\t    checks_command = checks_cfg.get(\"command\")\n287\t    probe = checks_cfg.get(\"probe\")\n288\t    probe_timeout_s = checks_cfg.get(\"probe_timeout_s\")\n289\t    identity = executor_identity(adapter_name)\n290\t    reports = adapter_reports(adapter_path)\n291\t\n292\t    start_sha = git(root, \"rev-parse\", \"HEAD\").strip()\n293\t    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n294\t    started = time.monotonic()\n295\t\n296\t    events_path = stage_events_dir(root) / f\"build-{next_attempt_number(item_records_dir, 'build'):02d}.events.jsonl\"\n297\t\n298\t    # Issue #115, then issue #212: whether this machine can run the tenant's\n299\t    # checks at all is asked once here, on the approved tree, before the\n300\t    # adapter is ever invoked -- a missing import at test collection (item\n301\t    # #106's build-01) is not a failing check, and no build could have\n302\t    # passed against it. A tenant that declares [checks].probe is asked by\n303\t    # the probe, inside [checks].probe_timeout_s: exit 0 yes, anything else\n304\t    # or the bound no. A tenant that does not is asked the old way, by\n305\t    # running [checks].command whole -- exit 2 no, exit 0 or 1 (the checks\n306\t    # ran and passed or failed, the expected states before a build) yes --\n307\t    # which is the run #194's build-01 spent 215 s on. Either way the feed\n308\t    # says what is being asked and what the answer was.\n309\t    if checks_command:\n310\t        append_event(events_path, \"gate\", \"checking this machine can run the checks\")\n311\t        asked = checks_command\n312\t        if probe:\n313\t            asked = probe\n314\t            code, out, err, timed_out = run_bounded(probe, root, \"\", probe_timeout_s)\n315\t            refusal_text = (f\"[checks].probe did not finish within {probe_timeout_s} s\" if timed_out\n316\t                            else f\"[checks].probe exited {code} on the approved tree\"\n317\t                            if code != 0 else None)\n318\t        else:\n319\t            preflight = subprocess.run(checks_command, shell=True, cwd=str(root),\n320\t                                       capture_output=True, text=True, check=False)\n321\t            code, out, err = preflight.returncode, preflight.stdout, preflight.stderr\n322\t            refusal_text = (\"[checks].command exited 2 on the approved tree\" if code == 2 else None)\n323\t        if refusal_text:\n324\t            append_event(events_path, \"gate\", f\"this machine cannot run the checks: {refusal_text}\")\n325\t            log = out + err\n326\t            detail = _log_last_line(out + \"\\n\" + err) or refusal_text\n327\t            record = {\n328\t                \"sha\": start_sha,\n329\t                \"start_sha\": start_sha,\n330\t                \"spec_sha\": spec_sha,\n331\t                \"approval_sha\": latest_approval.get(\"sha\") if latest_approval else None,\n332\t                \"at\": now_iso(),\n333\t                \"adapter\": adapter_name,\n334\t                \"adapter_config\": adapter_config,\n335\t                \"executor_identity\": identity,\n336\t                \"reports\": reports,\n337\t                \"adapter_version\": None,\n338\t                \"model\": None,\n339\t                \"model_version\": None,\n340\t                \"iterations\": 1,\n341\t                \"criteria\": [],\n342\t                \"selected_tests\": None,\n343\t                \"checks\": {\"command\": asked, \"exit\": code},\n344\t                \"tokens\": {\"input\": 0, \"output\": 0},\n345\t                \"cost_usd\": None,\n346\t                \"wall_clock_s\": round(time.monotonic() - started, 3),\n347\t                \"status\": \"refused\",\n348\t                \"refusal\": refusal_text,\n349\t                \"halted\": None,\n350\t                \"stop\": {\"class\": \"environment\", \"provenance\": \"tenant\", \"detail\": detail},\n351\t            }\n352\t            record_path = write_record(item_records_dir, \"build\", record, m, item_id,\n353\t                                       log=log or refusal_text + \"\\n\")\n354\t            print(f\"attavo build: refused ({record_path.name})\")\n355\t            return 1\n356\t        append_event(events_path, \"gate\", \"this machine can run the checks\")\n357\t\n358\t    adapter_version = model = model_version = None\n359\t    tokens = {\"input\": 0, \"output\": 0}\n360\t    cost_usd = None\n361\t    transcripts: list[str] = []\n362\t    criteria_results: list[dict[str, Any]] = []\n363\t    selected_tests: dict[str, Any] | None = None\n364\t    checks_result: dict[str, Any] | None = None\n365\t    status_out = \"failed\"\n366\t    refusal = None\n367\t    refusal_provenance = None\n368\t    halted = None\n369\t    iterations_used = 0\n370\t\n371\t    with tempfile.TemporaryDirectory() as tmp:\n372\t        feedback_path = Path(tmp) / \"feedback.txt\"\n373\t        feedback_path.write_text(\"\")\n374\t        # R3 (stub): a retried attempt starts with what the prior attempt\n375\t        # left -- its class and signature, and the evidence a returned\n376\t        # review carries (the red checks' logs, read through\n377\t        # [forge].check_log_command). No new input: the feedback file the\n378\t        # contract already passes.\n379\t        retry_of, seed = _retry_seed(root, m, item_records_dir)\n380\t        if seed:\n381\t            feedback_path.write_text(seed)\n382\t\n383\t        for iteration in range(1, BUILD_ITERATION_BUDGET + 1):\n384\t            iterations_used = iteration\n385\t            append_event(events_path, \"iteration\", f\"iteration {iteration} of {BUILD_ITERATION_BUDGET}\")\n386\t            env = dict(os.environ)\n387\t            # #212 retired the checks command reaching the executor; an\n388\t            # ATTAVO_CHECKS_COMMAND exported by whoever launched `attavo\n389\t            # build` must not reach it by inheritance either.\n390\t            env.pop(\"ATTAVO_CHECKS_COMMAND\", None)\n391\t            env[\"ATTAVO_SPEC_DIR\"] = str(spec_dir)\n392\t            env[\"ATTAVO_RECORDS_DIR\"] = str(item_records_dir)\n393\t            env[\"ATTAVO_RULINGS\"] = str(root / m[\"paths\"][\"rulings\"])\n394\t            env[\"ATTAVO_BRANCH\"] = branch\n395\t            env[\"ATTAVO_ITERATION\"] = str(iteration)\n396\t            env[\"ATTAVO_FEEDBACK\"] = str(feedback_path)\n397\t            env[\"ATTAVO_ADAPTER_CONFIG\"] = json.dumps(adapter_config)\n398\t            env[\"ATTAVO_STAGE\"] = \"build\"\n399\t            env[\"ATTAVO_EVENTS\"] = str(events_path)\n400\t            env[\"ATTAVO_TEST_COMMAND\"] = f\"python3 {PRODUCT_ROOT / 'bin' / 'attavo'} test {item_id}\"\n401\t            if tests_cfg.get(\"call_timeout_s\"):\n402\t                env[\"ATTAVO_TEST_TIMEOUT_S\"] = str(tests_cfg[\"call_timeout_s\"])\n403\t            else:\n404\t                env.pop(\"ATTAVO_TEST_TIMEOUT_S\", None)\n405\t            env[\"GIT_AUTHOR_NAME\"] = identity[\"name\"]\n406\t            env[\"GIT_AUTHOR_EMAIL\"] = identity[\"email\"]\n407\t            env[\"GIT_COMMITTER_NAME\"] = identity[\"name\"]\n408\t            env[\"GIT_COMMITTER_EMAIL\"] = identity[\"email\"]\n409\t\n410\t            run = subprocess.run([str(adapter_path)], cwd=str(root), env=env,\n411\t                                 capture_output=True, text=True, check=False)\n412\t            transcript, payload = split_adapter_stdout(run.stdout)\n413\t            if run.returncode != 0:\n414\t                # The guarantee behind issue #53's refusal: an adapter that\n415\t                # exits non-zero always leaves a non-empty log, even one\n416\t                # that printed nothing at all on stderr.\n417\t                detail = f\"[adapter exited {run.returncode}]\"\n418\t                if run.stderr.strip():\n419\t                    detail += \"\\n\" + run.stderr.rstrip(\"\\n\")\n420\t                transcript = (transcript + \"\\n\" if transcript else \"\") + detail\n421\t            transcripts.append(transcript)\n422\t\n423\t            if run.returncode != 0 or payload is None or not payload.get(\"model\"):\n424\t                status_out = \"failed\"\n425\t                break\n426\t\n427\t            adapter_version = payload.get(\"adapter_version\")\n428\t            model = payload.get(\"model\")\n429\t            model_version = payload.get(\"model_version\")\n430\t            tok = payload.get(\"tokens\") or {}\n431\t            tokens[\"input\"] += tok.get(\"input\", 0) or 0\n432\t            tokens[\"output\"] += tok.get(\"output\", 0) or 0\n433\t            iter_cost = payload.get(\"cost_usd\")\n434\t            if iter_cost is not None:\n435\t                cost_usd = (cost_usd or 0) + iter_cost\n436\t\n437\t            if payload.get(\"status\") == \"question\":\n438\t                status_out = \"halted\"\n439\t                halted = {\"question\": payload.get(\"question\")}\n440\t                break\n441\t\n442\t            foreign = next((c for c in commits_since(root, start_sha)\n443\t                           if c[\"name\"] != identity[\"name\"] or c[\"email\"] != identity[\"email\"]),\n444\t                          None)\n445\t            if foreign:\n446\t                status_out = \"refused\"\n447\t                refusal = f\"commit {foreign['sha']} not authored by the executor\"\n448\t                break\n449\t\n450\t            protected = protected_path_touched(root, start_sha, records_rel, specs_rel)\n451\t            if protected:\n452\t                status_out = \"refused\"\n453\t                refusal = protected\n454\t                refusal_provenance = \"executor\"\n455\t                break\n456\t\n457\t            touched = sorted(changed_paths(root, start_sha, records_rel))\n458\t            bad_path = next((p for p in touched if not matches_a_claim(p, claims)), None)\n459\t            if bad_path:\n460\t                status_out = \"refused\"\n461\t                refusal = bad_path\n462\t                break\n463\t\n464\t            criteria_results = [\n465\t                {\"name\": name, \"exit\": run_criterion(spec_dir / \"criteria\" / name, root)}\n466\t                for name in criteria_names]\n467\t            for c in criteria_results:\n468\t                append_event(events_path, \"gate\", f\"{c['name']}: exit {c['exit']}\")\n469\t\n470\t            select_in = \"\".join(p + \"\\n\" for p in touched)\n471\t            select_run = subprocess.run(tests_cfg[\"select\"], shell=True, cwd=str(root),\n472\t                                        input=select_in, capture_output=True,\n473\t                                        text=True, check=False)\n474\t            identifiers = [l for l in select_run.stdout.splitlines() if l.strip()]\n475\t            run_in = \"\".join(i + \"\\n\" for i in identifiers)\n476\t            test_run = subprocess.run(tests_cfg[\"run\"], shell=True, cwd=str(root),\n477\t                                      input=run_in, capture_output=True,\n478\t                                      text=True, check=False)\n479\t            selected_tests = {\"select\": tests_cfg[\"select\"], \"run\": tests_cfg[\"run\"],\n480\t                              \"count\": len(identifiers), \"exit\": test_run.returncode}\n481\t\n482\t            checks_run = None\n483\t            if checks_command:\n484\t                checks_run = subprocess.run(checks_command, shell=True, cwd=str(root),\n485\t                                            capture_output=True, text=True, check=False)\n486\t                checks_result = {\"command\": checks_command, \"exit\": checks_run.returncode}\n487\t\n488\t            # Issue #89, rejection test 1: the gate output that decides pass\n489\t            # or fail is appended to the build log itself, under a heading\n490\t            # per iteration, before this temporary directory goes away --\n491\t            # tenant zero's #576 build-11 and #659 build-01 are a failed\n492\t            # record with nothing beside it to say what was red, because\n493\t            # this output previously lived only in feedback.txt, in a\n494\t            # tempfile.TemporaryDirectory() cmd_build deletes on return.\n495\t            gate_lines = [f\"criterion {c['name']}: exit {c['exit']}\" for c in criteria_results]\n496\t            gate_lines.append(f\"selected tests ({selected_tests['count']}): exit \"\n497\t                              f\"{selected_tests['exit']}\")\n498\t            if test_run.stdout.strip():\n499\t                gate_lines += [\"--- selected tests stdout ---\", test_run.stdout.rstrip(\"\\n\")]\n500\t            if test_run.stderr.strip():\n501\t                gate_lines += [\"--- selected tests stderr ---\", test_run.stderr.rstrip(\"\\n\")]\n502\t            if checks_run is not None:\n503\t                tail = (checks_run.stdout.splitlines() + checks_run.stderr.splitlines())\n504\t                tail = tail[-CHECKS_FEEDBACK_TAIL_LINES:]\n505\t                gate_lines.append(f\"tenant checks: exit {checks_run.returncode}\")\n506\t                gate_lines += [\"--- checks output (tail) ---\", *tail]\n507\t            transcripts[-1] += (f\"\\n--- attavo gates, iteration {iteration} ---\\n\"\n508\t                               + \"\\n\".join(gate_lines))\n509\t\n510\t            failing = [c for c in criteria_results if c[\"exit\"] != 0]\n511\t            checks_ok = checks_run is None or checks_run.returncode == 0\n512\t            if not failing and test_run.returncode == 0 and checks_ok:\n513\t                status_out = \"pass\"\n514\t                break\n515\t\n516\t            if iteration == BUILD_ITERATION_BUDGET:\n517\t                status_out = \"failed\"\n518\t                break\n519\t\n520\t            feedback_lines = []\n521\t            if failing:\n522\t                feedback_lines.append(\"criteria failing:\")\n523\t                feedback_lines += [f\"- {c['name']}: exit {c['exit']}\" for c in failing]\n524\t            if test_run.returncode != 0:\n525\t                feedback_lines += [f\"test run exit {test_run.returncode}\",\n526\t                                   \"--- stdout ---\", test_run.stdout,\n527\t                                   \"--- stderr ---\", test_run.stderr]\n528\t            if checks_run is not None and checks_run.returncode != 0:\n529\t                tail = (checks_run.stdout.splitlines() + checks_run.stderr.splitlines())\n530\t                tail = tail[-CHECKS_FEEDBACK_TAIL_LINES:]\n531\t                feedback_lines += [f\"checks exit {checks_run.returncode}\",\n532\t                                   \"--- checks output (tail) ---\", *tail]\n533\t            feedback_path.write_text(\"\\n\".join(feedback_lines) + \"\\n\")\n534\t\n535\t    record = {\n536\t        \"sha\": git(root, \"rev-parse\", \"HEAD\").strip(),\n537\t        \"start_sha\": start_sha,\n538\t        \"spec_sha\": spec_sha,\n539\t        \"approval_sha\": latest_approval.get(\"sha\") if latest_approval else None,\n540\t        \"at\": now_iso(),\n541\t        \"adapter\": adapter_name,\n542\t        \"adapter_config\": adapter_config,\n543\t        \"executor_identity\": identity,\n544\t        \"reports\": reports,\n545\t        \"adapter_version\": adapter_version,\n546\t        \"model\": model,\n547\t        \"model_version\": model_version,\n548\t        \"iterations\": iterations_used,\n549\t        \"criteria\": criteria_results,\n550\t        \"selected_tests\": selected_tests,\n551\t        \"checks\": checks_result,\n552\t        \"tokens\": tokens,\n553\t        \"cost_usd\": cost_usd,\n554\t        \"wall_clock_s\": round(time.monotonic() - started, 3),\n555\t        \"status\": status_out,\n556\t        \"refusal\": refusal,\n557\t        \"halted\": halted,\n558\t        \"retry_of\": retry_of,\n559\t        \"steer\": None,\n560\t        \"stop\": derive_stop(status_out, refusal=refusal, halted=halted,\n561\t                            log=\"\\n\".join(transcripts),\n562\t                            report_class=(payload or {}).get(\"class\"),\n563\t                            refusal_provenance=refusal_provenance),\n564\t    }\n565\t    if record[\"stop\"] is not None:\n566\t        stop_in: dict[str, Any] = record[\"stop\"]\n567\t        detail_in: str | None = ((payload or {}).get(\"detail\") if stop_in[\"class\"] == \"transient\"\n568\t                                 else stop_in.get(\"detail\"))\n569\t        record[\"stop\"] = {**stop_in, \"detail\": detail_in, \"signature\": signature_of(detail_in), \"bound\": None}\n570\t    record_path = write_record(item_records_dir, \"build\", record, m, item_id,\n571\t                               log=\"\\n\".join(transcripts))\n572\t\n573\t    print(f\"attavo build: {status_out} ({record_path.name})\")\n574\t    if status_out == \"halted\":\n575\t        return BUILD_HALT_EXIT\n576\t    return 0 if status_out == \"pass\" else 1\n577\t"}]},"parent_tool_use_id":null,"session_id":"0dd7ed4f-100c-4188-9a34-077aa0b6aa25","uuid":"727e5237-5660-4af8-97ed-cf5efc0ae6f1","timestamp":"2026-09-26T02:08:35.475Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-219/attest/specs/219/stub/attavo/build.py","content":"from __future__ import annotations\n\nimport fnmatch\nimport json\nimport os\nimport subprocess\nimport sys\nimport tempfile\nimport time\nfrom pathlib import Path\nfrom typing import cast, Any\n\nfrom attavo.approval import approval_status\nfrom attavo.common import (\n    MANIFEST,\n    PRODUCT_ROOT,\n    ShallowCheckoutError,\n    derive_item_id,\n    git,\n    last_commit_touching,\n    now_iso,\n    read_manifest,\n)\nfrom attavo.events import append_event, stage_events_dir\nfrom attavo.records import latest_record, next_attempt_number, write_record\nfrom attavo.spec import parse_spec, run_criterion\nfrom attavo.stops import _log_last_line, derive_stop, signature_of\nfrom attavo.testtool import run_bounded, without_records\n\n# --- build: adapter, claims boundary, criteria, and the tenant's tests ---\n\nSTAGE_NAMES = (\"build\", \"verify\", \"counsel\")\n\n\ndef merge_adapter_config(m: dict[str, Any], adapter_name: str, stage: str) -> dict[str, Any]:\n    \"\"\"[executor.<adapter>] merged with [executor.<adapter>.<stage>], the\n    stage table shadowing the parent for that stage only. Both build and\n    verify call this before setting ATTAVO_ADAPTER_CONFIG, and the\n    record's adapter_config is the merged result.\"\"\"\n    parent = (m.get(\"executor\") or {}).get(adapter_name) or {}\n    if not isinstance(parent, dict):\n        return {}\n    merged = {k: v for k, v in parent.items() if k not in STAGE_NAMES}\n    stage_table = parent.get(stage)\n    if isinstance(stage_table, dict):\n        merged.update(stage_table)\n    return merged\n\n\ndef resolve_adapter(root: Path, name: str) -> Path | None:\n    \"\"\"adapters/<name>/run, resolved first under the tenant's own\n    attavo/adapters/, then under this product's adapters/.\"\"\"\n    for base in (root / \"attavo\" / \"adapters\", PRODUCT_ROOT / \"adapters\"):\n        candidate = base / name / \"run\"\n        if candidate.is_file():\n            return candidate\n    return None\n\n\ndef adapter_reports(adapter_path: Path) -> list[str]:\n    \"\"\"Field names adapters/<name>/conformance.json declares this adapter\n    can supply with a real value -- vendor independence (2026-09-09\n    ruling): the record carries the declaration, so an adapter claiming\n    a field and returning null for it fails the conformance suite\n    instead of writing a silent, uncomparable null. [] when the\n    resolved adapter (a tenant override included) declares no\n    conformance.json at all -- an absent declaration, not a refusal.\"\"\"\n    manifest_path = adapter_path.parent / \"conformance.json\"\n    if not manifest_path.is_file():\n        return []\n    try:\n        manifest = json.loads(manifest_path.read_text())\n    except json.JSONDecodeError:\n        return []\n    reports: list[str] = manifest.get(\"reports\", [])\n    return reports\n\n\ndef changed_paths(root: Path, start_sha: str, records_rel: str) -> list[str]:\n    \"\"\"Paths changed between start_sha and HEAD, other than paths.records --\n    the records directory is where build itself writes, not a claim.\"\"\"\n    return without_records(git(root, \"diff\", \"--name-only\", start_sha, \"HEAD\").splitlines(),\n                           records_rel)\n\n\ndef matches_a_claim(path: str, claims: list[str]) -> bool:\n    return any(fnmatch.fnmatch(path, pattern) for pattern in claims)\n\n\ndef protected_path_touched(root: Path, start_sha: str, records_rel: str,\n                           specs_rel: str) -> str | None:\n    \"\"\"The first path an executor's own commits touched under\n    paths.records or paths.specs since start_sha, or None (issue #140).\n    Neither directory is a claim a spec can make -- paths.records is\n    where the product itself writes, paths.specs is the definition of\n    done -- yet changed_paths above excludes paths.records from the\n    ordinary claims check entirely, so a path there never even reached\n    matches_a_claim to be refused: tenant zero's own item #688 committed\n    its own events file this way, under its records directory, on a\n    build that then passed. Checked directly against the raw diff, not\n    changed_paths's already-filtered list.\"\"\"\n    touched = git(root, \"diff\", \"--name-only\", start_sha, \"HEAD\").splitlines()\n    protected = []\n    for rel in (records_rel, specs_rel):\n        stripped = rel.rstrip(\"/\")\n        protected.append((stripped, stripped + \"/\"))\n    for p in touched:\n        if not p:\n            continue\n        for exact, prefix in protected:\n            if p == exact or p.startswith(prefix):\n                return p\n    return None\n\n\ndef executor_identity(adapter_name: str) -> dict[str, Any]:\n    \"\"\"The executor's identity (issue #33): set by the product, never the\n    tenant's git config, so an executor commit is never indistinguishable\n    from an operator's own -- the specimen is attavo/code-factory@e22fa85.\n    A reserved, undeliverable domain (.invalid) so no mailbox is implied.\n    Distinct from the records app identity: the app says the product\n    pushed this, this says an invocation authored this -- different\n    facts, neither borrows the other's name.\"\"\"\n    return {\"name\": f\"attavo executor ({adapter_name})\",\n            \"email\": f\"executor+{adapter_name}@attavo.invalid\"}\n\n\ndef driver_identity() -> dict[str, Any]:\n    \"\"\"The driver's identity: set by the product, never the tenant's git\n    config, so a driver's own transport commit -- a record commit\n    `commit_record` makes on the driver's behalf -- is never\n    indistinguishable from an operator's own; `git log --author='attavo\n    driver'` on a driven item lists exactly those commits. Distinct from\n    executor_identity: that names an adapter invocation's own commits,\n    this names the transport that carries a stage's record.\"\"\"\n    return {\"name\": \"attavo driver\", \"email\": \"driver@attavo.invalid\"}\n\n\ndef commits_since(root: Path, start_sha: str, end: str = \"HEAD\") -> list[dict[str, Any]]:\n    \"\"\"(sha, name, email) for every commit after start_sha up to and\n    including end, first-parent only, oldest first. cmd_build's own call\n    (start_sha at the invocation, end left at the default HEAD) never sees\n    a merge in that window, so --first-parent changes nothing there;\n    issue #128's ledger is the caller that needs it, to walk one branch's\n    own line without a concurrent merge to main expanding into every\n    commit main gained meanwhile.\"\"\"\n    out = git(root, \"log\", \"--first-parent\", \"--reverse\",\n             \"--format=%H\\x1f%an\\x1f%ae\", f\"{start_sha}..{end}\")\n    commits = []\n    for line in out.splitlines():\n        if not line.strip():\n            continue\n        sha, name, email = line.split(\"\\x1f\")\n        commits.append({\"sha\": sha, \"name\": name, \"email\": email})\n    return commits\n\n\ndef commits_with_diffs(root: Path, start_sha: str, end: str = \"HEAD\") -> list[dict[str, Any]]:\n    \"\"\"commits_since's own (sha, name, email), each with its own\n    first-parent diff already attached as \"touched\" -- one process for the\n    whole range rather than commits_since's list plus a git diff per\n    commit (issue #153, the cost item_ledger's own walk paid per commit).\"\"\"\n    out = git(root, \"log\", \"--first-parent\", \"--reverse\", \"--diff-merges=first-parent\",\n             \"--name-only\", \"--format=\\x01%H\\x1f%an\\x1f%ae\", f\"{start_sha}..{end}\")\n    commits = []\n    for block in out.split(\"\\x01\")[1:]:\n        header, _, rest = block.partition(\"\\n\")\n        sha, name, email = header.split(\"\\x1f\")\n        commits.append({\"sha\": sha, \"name\": name, \"email\": email,\n                        \"touched\": [line for line in rest.splitlines() if line.strip()]})\n    return commits\n\n\ndef split_adapter_stdout(stdout: str) -> tuple[str, dict[str, Any] | None]:\n    \"\"\"(transcript, payload): the adapter's last non-empty stdout line is\n    its JSON report, and everything before it is transcript, only when\n    that last line actually parses as JSON. When it does not -- a tool's\n    own error line printed last on a non-zero exit (issue #86: tenant\n    zero attest/records/659/verify-01.log, codex's own \"Input exceeds...\"\n    line, dropped because it was mistaken for an attempted payload) --\n    nothing here is a report, and the whole stdout is the transcript, so\n    that last line is not silently lost.\n    \"\"\"\n    lines = stdout.splitlines()\n    non_empty = [i for i, l in enumerate(lines) if l.strip()]\n    if not non_empty:\n        return stdout, None\n    last = non_empty[-1]\n    try:\n        payload = json.loads(lines[last])\n    except ValueError:\n        return stdout, None\n    transcript = \"\\n\".join(lines[:last])\n    return transcript, payload\n\n\nBUILD_ITERATION_BUDGET = 3\n\nBUILD_HALT_EXIT = 3\n\nCHECKS_FEEDBACK_TAIL_LINES = 200\n\n\ndef _retry_seed(root: Path, m: dict[str, Any], records_dir: Path) -> tuple[str | None, str]:\n    \"\"\"R3 (stub): the prior attempt this build retries and the feedback it\n    is handed. A build retries the latest build record that is not a pass,\n    or the latest verify record that returned it (class returned).\"\"\"\n    import shlex\n    latest_build = cast(\"dict[str, Any] | None\", latest_record(records_dir, \"build\"))\n    latest_verify = cast(\"dict[str, Any] | None\", latest_record(records_dir, \"verify\"))\n    prior_stem = f\"build-{next_attempt_number(records_dir, 'build') - 1:02d}\"\n    prior: dict[str, Any] | None = None\n    if (latest_verify and (latest_verify.get(\"stop\") or {}).get(\"class\") == \"returned\" and latest_build\n            and latest_verify.get(\"build_sha\") == latest_build.get(\"sha\")):\n        prior = latest_verify\n    elif latest_build and latest_build.get(\"status\") != \"pass\":\n        prior = latest_build\n    if prior is None:\n        return None, \"\"\n    stop: dict[str, Any] = prior.get(\"stop\") or {}\n    lines = [f\"attempt {prior_stem} stopped as {stop.get('class')}: {stop.get('detail') or ''}\",\n             f\"signature: {stop.get('signature') or ''}\", \"\"]\n    forge = m.get(\"forge\") or {}\n    if stop.get(\"class\") == \"returned\" and forge.get(\"check_log_command\"):\n        for c in (prior.get(\"forge_checks\") or {}).get(\"conclusions\") or []:\n            if c.get(\"conclusion\") not in (\"success\", \"neutral\", \"skipped\"):\n                run = subprocess.run(f\"{forge['check_log_command']} {shlex.quote(str(prior.get('sha')))} {shlex.quote(c['name'])}\",\n                                     shell=True, cwd=str(root), capture_output=True, text=True, check=False)\n                lines += [f\"--- check {c['name']} {c['conclusion']} ---\", run.stdout.strip(), \"\"]\n    return prior_stem, \"\\n\".join(lines) + \"\\n\"\n\n\ndef cmd_build(argv: list[str]) -> int:\n    root = Path(\".\").resolve()\n    item_id = argv[0] if argv else derive_item_id(root)\n    if not item_id:\n        print(\"attavo build: cannot derive item id; pass N or run on an attavo/N-* branch\",\n              file=sys.stderr)\n        return 2\n    m = read_manifest(root)\n    if m is None:\n        print(f\"attavo build: no {MANIFEST} at {root}\", file=sys.stderr)\n        return 2\n\n    adapter_name = (m.get(\"executor\") or {}).get(\"build\")\n    if not adapter_name:\n        print(\"attavo build: refused: no [executor].build in the manifest\")\n        return 1\n\n    tests_cfg = m.get(\"tests\") or {}\n    if not tests_cfg.get(\"select\") or not tests_cfg.get(\"run\"):\n        print(\"attavo build: refused: no [tests] table in the manifest \"\n              \"([tests].select and [tests].run are both required)\")\n        return 1\n\n    if (m.get(\"checks\") or {}).get(\"probe\") and not (m.get(\"checks\") or {}).get(\"probe_timeout_s\"):\n        print(\"attavo build: refused: [checks].probe is declared without \"\n              \"[checks].probe_timeout_s (a probe with no bound is not asked)\")\n        return 1\n\n    try:\n        status = approval_status(root, m, item_id)\n    except ShallowCheckoutError as exc:\n        print(f\"attavo build: refused: {exc}\", file=sys.stderr)\n        return 2\n    if status != \"valid\":\n        print(f\"attavo build: refused: approval is {status}\")\n        return 1\n\n    adapter_path = resolve_adapter(root, adapter_name)\n    if adapter_path is None:\n        print(f\"attavo build: refused: no adapter named {adapter_name!r}\")\n        return 1\n\n    specs_rel = m[\"paths\"][\"specs\"]\n    records_rel = m[\"paths\"][\"records\"]\n    spec_dir = root / specs_rel / item_id\n    item_records_dir = root / records_rel / item_id\n    spec_sha = last_commit_touching(root, str(Path(specs_rel) / item_id))\n    latest_approval = latest_record(item_records_dir, \"approval\")\n    parsed, _ = parse_spec(spec_dir / \"spec.md\")\n    claims = parsed[\"claims\"] if parsed else []\n    criteria_names = parsed[\"criteria\"] if parsed else []\n    adapter_config = merge_adapter_config(m, adapter_name, \"build\")\n    checks_cfg = m.get(\"checks\") or {}\n    checks_command = checks_cfg.get(\"command\")\n    probe = checks_cfg.get(\"probe\")\n    probe_timeout_s = checks_cfg.get(\"probe_timeout_s\")\n    identity = executor_identity(adapter_name)\n    reports = adapter_reports(adapter_path)\n\n    start_sha = git(root, \"rev-parse\", \"HEAD\").strip()\n    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n    started = time.monotonic()\n\n    events_path = stage_events_dir(root) / f\"build-{next_attempt_number(item_records_dir, 'build'):02d}.events.jsonl\"\n\n    # Issue #115, then issue #212: whether this machine can run the tenant's\n    # checks at all is asked once here, on the approved tree, before the\n    # adapter is ever invoked -- a missing import at test collection (item\n    # #106's build-01) is not a failing check, and no build could have\n    # passed against it. A tenant that declares [checks].probe is asked by\n    # the probe, inside [checks].probe_timeout_s: exit 0 yes, anything else\n    # or the bound no. A tenant that does not is asked the old way, by\n    # running [checks].command whole -- exit 2 no, exit 0 or 1 (the checks\n    # ran and passed or failed, the expected states before a build) yes --\n    # which is the run #194's build-01 spent 215 s on. Either way the feed\n    # says what is being asked and what the answer was.\n    if checks_command:\n        append_event(events_path, \"gate\", \"checking this machine can run the checks\")\n        asked = checks_command\n        if probe:\n            asked = probe\n            code, out, err, timed_out = run_bounded(probe, root, \"\", probe_timeout_s)\n            refusal_text = (f\"[checks].probe did not finish within {probe_timeout_s} s\" if timed_out\n                            else f\"[checks].probe exited {code} on the approved tree\"\n                            if code != 0 else None)\n        else:\n            preflight = subprocess.run(checks_command, shell=True, cwd=str(root),\n                                       capture_output=True, text=True, check=False)\n            code, out, err = preflight.returncode, preflight.stdout, preflight.stderr\n            refusal_text = (\"[checks].command exited 2 on the approved tree\" if code == 2 else None)\n        if refusal_text:\n            append_event(events_path, \"gate\", f\"this machine cannot run the checks: {refusal_text}\")\n            log = out + err\n            detail = _log_last_line(out + \"\\n\" + err) or refusal_text\n            record = {\n                \"sha\": start_sha,\n                \"start_sha\": start_sha,\n                \"spec_sha\": spec_sha,\n                \"approval_sha\": latest_approval.get(\"sha\") if latest_approval else None,\n                \"at\": now_iso(),\n                \"adapter\": adapter_name,\n                \"adapter_config\": adapter_config,\n                \"executor_identity\": identity,\n                \"reports\": reports,\n                \"adapter_version\": None,\n                \"model\": None,\n                \"model_version\": None,\n                \"iterations\": 1,\n                \"criteria\": [],\n                \"selected_tests\": None,\n                \"checks\": {\"command\": asked, \"exit\": code},\n                \"tokens\": {\"input\": 0, \"output\": 0},\n                \"cost_usd\": None,\n                \"wall_clock_s\": round(time.monotonic() - started, 3),\n                \"status\": \"refused\",\n                \"refusal\": refusal_text,\n                \"halted\": None,\n                \"stop\": {\"class\": \"environment\", \"provenance\": \"tenant\", \"detail\": detail},\n            }\n            record_path = write_record(item_records_dir, \"build\", record, m, item_id,\n                                       log=log or refusal_text + \"\\n\")\n            print(f\"attavo build: refused ({record_path.name})\")\n            return 1\n        append_event(events_path, \"gate\", \"this machine can run the checks\")\n\n    adapter_version = model = model_version = None\n    tokens = {\"input\": 0, \"output\": 0}\n    cost_usd = None\n    transcripts: list[str] = []\n    criteria_results: list[dict[str, Any]] = []\n    selected_tests: dict[str, Any] | None = None\n    checks_result: dict[str, Any] | None = None\n    status_out = \"failed\"\n    refusal = None\n    refusal_provenance = None\n    halted = None\n    iterations_used = 0\n\n    with tempfile.TemporaryDirectory() as tmp:\n        feedback_path = Path(tmp) / \"feedback.txt\"\n        feedback_path.write_text(\"\")\n        # R3 (stub): a retried attempt starts with what the prior attempt\n        # left -- its class and signature, and the evidence a returned\n        # review carries (the red checks' logs, read through\n        # [forge].check_log_command). No new input: the feedback file the\n        # contract already passes.\n        retry_of, seed = _retry_seed(root, m, item_records_dir)\n        if seed:\n            feedback_path.write_text(seed)\n\n        for iteration in range(1, BUILD_ITERATION_BUDGET + 1):\n            iterations_used = iteration\n            append_event(events_path, \"iteration\", f\"iteration {iteration} of {BUILD_ITERATION_BUDGET}\")\n            env = dict(os.environ)\n            # #212 retired the checks command reaching the executor; an\n            # ATTAVO_CHECKS_COMMAND exported by whoever launched `attavo\n            # build` must not reach it by inheritance either.\n            env.pop(\"ATTAVO_CHECKS_COMMAND\", None)\n            env[\"ATTAVO_SPEC_DIR\"] = str(spec_dir)\n            env[\"ATTAVO_RECORDS_DIR\"] = str(item_records_dir)\n            env[\"ATTAVO_RULINGS\"] = str(root / m[\"paths\"][\"rulings\"])\n            env[\"ATTAVO_BRANCH\"] = branch\n            env[\"ATTAVO_ITERATION\"] = str(iteration)\n            env[\"ATTAVO_FEEDBACK\"] = str(feedback_path)\n            env[\"ATTAVO_ADAPTER_CONFIG\"] = json.dumps(adapter_config)\n            env[\"ATTAVO_STAGE\"] = \"build\"\n            env[\"ATTAVO_EVENTS\"] = str(events_path)\n            env[\"ATTAVO_TEST_COMMAND\"] = f\"python3 {PRODUCT_ROOT / 'bin' / 'attavo'} test {item_id}\"\n            if tests_cfg.get(\"call_timeout_s\"):\n                env[\"ATTAVO_TEST_TIMEOUT_S\"] = str(tests_cfg[\"call_timeout_s\"])\n            else:\n                env.pop(\"ATTAVO_TEST_TIMEOUT_S\", None)\n            env[\"GIT_AUTHOR_NAME\"] = identity[\"name\"]\n            env[\"GIT_AUTHOR_EMAIL\"] = identity[\"email\"]\n            env[\"GIT_COMMITTER_NAME\"] = identity[\"name\"]\n            env[\"GIT_COMMITTER_EMAIL\"] = identity[\"email\"]\n\n            run = subprocess.run([str(adapter_path)], cwd=str(root), env=env,\n                                 capture_output=True, text=True, check=False)\n            transcript, payload = split_adapter_stdout(run.stdout)\n            if run.returncode != 0:\n                # The guarantee behind issue #53's refusal: an adapter that\n                # exits non-zero always leaves a non-empty log, even one\n                # that printed nothing at all on stderr.\n                detail = f\"[adapter exited {run.returncode}]\"\n                if run.stderr.strip():\n                    detail += \"\\n\" + run.stderr.rstrip(\"\\n\")\n                transcript = (transcript + \"\\n\" if transcript else \"\") + detail\n            transcripts.append(transcript)\n\n            if run.returncode != 0 or payload is None or not payload.get(\"model\"):\n                status_out = \"failed\"\n                break\n\n            adapter_version = payload.get(\"adapter_version\")\n            model = payload.get(\"model\")\n            model_version = payload.get(\"model_version\")\n            tok = payload.get(\"tokens\") or {}\n            tokens[\"input\"] += tok.get(\"input\", 0) or 0\n            tokens[\"output\"] += tok.get(\"output\", 0) or 0\n            iter_cost = payload.get(\"cost_usd\")\n            if iter_cost is not None:\n                cost_usd = (cost_usd or 0) + iter_cost\n\n            if payload.get(\"status\") == \"question\":\n                status_out = \"halted\"\n                halted = {\"question\": payload.get(\"question\")}\n                break\n\n            foreign = next((c for c in commits_since(root, start_sha)\n                           if c[\"name\"] != identity[\"name\"] or c[\"email\"] != identity[\"email\"]),\n                          None)\n            if foreign:\n                status_out = \"refused\"\n                refusal = f\"commit {foreign['sha']} not authored by the executor\"\n                break\n\n            protected = protected_path_touched(root, start_sha, records_rel, specs_rel)\n            if protected:\n                status_out = \"refused\"\n                refusal = protected\n                refusal_provenance = \"executor\"\n                break\n\n            touched = sorted(changed_paths(root, start_sha, records_rel))\n            bad_path = next((p for p in touched if not matches_a_claim(p, claims)), None)\n            if bad_path:\n                status_out = \"refused\"\n                refusal = bad_path\n                break\n\n            criteria_results = [\n                {\"name\": name, \"exit\": run_criterion(spec_dir / \"criteria\" / name, root)}\n                for name in criteria_names]\n            for c in criteria_results:\n                append_event(events_path, \"gate\", f\"{c['name']}: exit {c['exit']}\")\n\n            select_in = \"\".join(p + \"\\n\" for p in touched)\n            select_run = subprocess.run(tests_cfg[\"select\"], shell=True, cwd=str(root),\n                                        input=select_in, capture_output=True,\n                                        text=True, check=False)\n            identifiers = [l for l in select_run.stdout.splitlines() if l.strip()]\n            run_in = \"\".join(i + \"\\n\" for i in identifiers)\n            test_run = subprocess.run(tests_cfg[\"run\"], shell=True, cwd=str(root),\n                                      input=run_in, capture_output=True,\n                                      text=True, check=False)\n            selected_tests = {\"select\": tests_cfg[\"select\"], \"run\": tests_cfg[\"run\"],\n                              \"count\": len(identifiers), \"exit\": test_run.returncode}\n\n            checks_run = None\n            if checks_command:\n                checks_run = subprocess.run(checks_command, shell=True, cwd=str(root),\n                                            capture_output=True, text=True, check=False)\n                checks_result = {\"command\": checks_command, \"exit\": checks_run.returncode}\n\n            # Issue #89, rejection test 1: the gate output that decides pass\n            # or fail is appended to the build log itself, under a heading\n            # per iteration, before this temporary directory goes away --\n            # tenant zero's #576 build-11 and #659 build-01 are a failed\n            # record with nothing beside it to say what was red, because\n            # this output previously lived only in feedback.txt, in a\n            # tempfile.TemporaryDirectory() cmd_build deletes on return.\n            gate_lines = [f\"criterion {c['name']}: exit {c['exit']}\" for c in criteria_results]\n            gate_lines.append(f\"selected tests ({selected_tests['count']}): exit \"\n                              f\"{selected_tests['exit']}\")\n            if test_run.stdout.strip():\n                gate_lines += [\"--- selected tests stdout ---\", test_run.stdout.rstrip(\"\\n\")]\n            if test_run.stderr.strip():\n                gate_lines += [\"--- selected tests stderr ---\", test_run.stderr.rstrip(\"\\n\")]\n            if checks_run is not None:\n                tail = (checks_run.stdout.splitlines() + checks_run.stderr.splitlines())\n                tail = tail[-CHECKS_FEEDBACK_TAIL_LINES:]\n                gate_lines.append(f\"tenant checks: exit {checks_run.returncode}\")\n                gate_lines += [\"--- checks output (tail) ---\", *tail]\n            transcripts[-1] += (f\"\\n--- attavo gates, iteration {iteration} ---\\n\"\n                               + \"\\n\".join(gate_lines))\n\n            failing = [c for c in criteria_results if c[\"exit\"] != 0]\n            checks_ok = checks_run is None or checks_run.returncode == 0\n            if not failing and test_run.returncode == 0 and checks_ok:\n                status_out = \"pass\"\n                break\n\n            if iteration == BUILD_ITERATION_BUDGET:\n                status_out = \"failed\"\n                break\n\n            feedback_lines = []\n            if failing:\n                feedback_lines.append(\"criteria failing:\")\n                feedback_lines += [f\"- {c['name']}: exit {c['exit']}\" for c in failing]\n            if test_run.returncode != 0:\n                feedback_lines += [f\"test run exit {test_run.returncode}\",\n                                   \"--- stdout ---\", test_run.stdout,\n                                   \"--- stderr ---\", test_run.stderr]\n            if checks_run is not None and checks_run.returncode != 0:\n                tail = (checks_run.stdout.splitlines() + checks_run.stderr.splitlines())\n                tail = tail[-CHECKS_FEEDBACK_TAIL_LINES:]\n                feedback_lines += [f\"checks exit {checks_run.returncode}\",\n                                   \"--- checks output (tail) ---\", *tail]\n            feedback_path.write_text(\"\\n\".join(feedback_lines) + \"\\n\")\n\n    record = {\n        \"sha\": git(root, \"rev-parse\", \"HEAD\").strip(),\n        \"start_sha\": start_sha,\n        \"spec_sha\": spec_sha,\n        \"approval_sha\": latest_approval.get(\"sha\") if latest_approval else None,\n        \"at\": now_iso(),\n        \"adapter\": adapter_name,\n        \"adapter_config\": adapter_config,\n        \"executor_identity\": identity,\n        \"reports\": reports,\n        \"adapter_version\": adapter_version,\n        \"model\": model,\n        \"model_version\": model_version,\n        \"iterations\": iterations_used,\n        \"criteria\": criteria_results,\n        \"selected_tests\": selected_tests,\n        \"checks\": checks_result,\n        \"tokens\": tokens,\n        \"cost_usd\": cost_usd,\n        \"wall_clock_s\": round(time.monotonic() - started, 3),\n        \"status\": status_out,\n        \"refusal\": refusal,\n        \"halted\": halted,\n        \"retry_of\": retry_of,\n        \"steer\": None,\n        \"stop\": derive_stop(status_out, refusal=refusal, halted=halted,\n                            log=\"\\n\".join(transcripts),\n                            report_class=(payload or {}).get(\"class\"),\n                            refusal_provenance=refusal_provenance),\n    }\n    if record[\"stop\"] is not None:\n        stop_in: dict[str, Any] = record[\"stop\"]\n        detail_in: str | None = ((payload or {}).get(\"detail\") if stop_in[\"class\"] == \"transient\"\n                                 else stop_in.get(\"detail\"))\n        record[\"stop\"] = {**stop_in, \"detail\": detail_in, \"signature\": signature_of(detail_in), \"bound\": None}\n    record_path = write_record(item_records_dir, \"build\", record, m, item_id,\n                               log=\"\\n\".join(transcripts))\n\n    print(f\"attavo build: {status_out} ({record_path.name})\")\n    if status_out == \"halted\":\n        return BUILD_HALT_EXIT\n    return 0 if status_out == \"pass\" else 1\n","numLines":577,"startLine":1,"totalLines":577}}}

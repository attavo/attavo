{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Fj3s7rgGeo5GuMEH8wmPap","type":"tool_result","content":"1\tfrom __future__ import annotations\n2\t\n3\timport json\n4\timport re\n5\tfrom collections.abc import Mapping\n6\tfrom pathlib import Path\n7\tfrom typing import Any, Literal, cast, overload\n8\t\n9\tfrom attavo.common import PRODUCT_ROOT, product_version\n10\tfrom attavo.types import ApprovalRecord, BuildRecord, CounselRecord, SpecRecord, VerifyRecord\n11\t\n12\t# --- record files: <stage>-NN.json, one per attempt, never overwritten ---\n13\t\n14\tSCHEMA_RECORDS_DIR = PRODUCT_ROOT / \"schema\" / \"records\"\n15\t\n16\t\n17\tdef stage_schema(stage: str) -> dict[str, Any]:\n18\t    \"\"\"schema/records/<stage>.schema.json -- this repository's own\n19\t    declaration of that stage's record shape (issue #60). The only\n20\t    artifact the outbound contract needs; there is no accessor for it\n21\t    beyond reading the file.\"\"\"\n22\t    schema: dict[str, Any] = json.loads((SCHEMA_RECORDS_DIR / f\"{stage}.schema.json\").read_text())\n23\t    return schema\n24\t\n25\t\n26\tdef schema_id_version(schema: dict[str, Any]) -> int:\n27\t    \"\"\"The trailing integer of a schema's $id (\".../records/build/2\" -> 2)\n28\t    -- the single place a record shape's version lives. write_record reads\n29\t    this at call time rather than carrying its own copy, so the version it\n30\t    stamps cannot drift from what the schema declares (issue #60).\"\"\"\n31\t    return int(schema[\"$id\"].rsplit(\"/\", 1)[-1])\n32\t\n33\t\n34\tclass RecordItemMismatch(RuntimeError):\n35\t    \"\"\"A record's item field disagrees with the directory it was read\n36\t    from (issue #60, acceptance 5) -- a misfiled or copied record, refused\n37\t    rather than trusted.\"\"\"\n38\t\n39\t\n40\tdef _load_record(path: Path, item_id: str) -> dict[str, Any]:\n41\t    \"\"\"The one place in this repository that turns a record file's bytes\n42\t    into a dict (issue #60, acceptance 6). Defaults record_version to 1\n43\t    when absent -- version 1 is every record written before this release\n44\t    and is never migrated -- and fills item from the directory when\n45\t    absent; refuses when a present item disagrees with it.\"\"\"\n46\t    data = json.loads(path.read_text())\n47\t    data.setdefault(\"record_version\", 1)\n48\t    item = data.get(\"item\")\n49\t    if item is None:\n50\t        data[\"item\"] = item_id\n51\t    elif item != item_id:\n52\t        raise RecordItemMismatch(\n53\t            f\"{path}: item {item!r} disagrees with its directory {item_id!r}\")\n54\t    return cast(dict[str, Any], data)\n55\t\n56\t\n57\t# The typed loaders: a literal stage name selects the record kind the caller\n58\t# gets back (issue #189). The record is read from a file and not validated\n59\t# here, so the kind is the schema's promise, the same one the write side\n60\t# already keeps (write_record refuses a key its schema does not declare);\n61\t# a stage held in a variable is the untyped fallback.\n62\t@overload\n63\tdef parse_attempts(records_dir: Path, stage: Literal[\"spec\"]) -> dict[int, SpecRecord]: ...\n64\t@overload\n65\tdef parse_attempts(records_dir: Path, stage: Literal[\"approval\"]) -> dict[int, ApprovalRecord]: ...\n66\t@overload\n67\tdef parse_attempts(records_dir: Path, stage: Literal[\"build\"]) -> dict[int, BuildRecord]: ...\n68\t@overload\n69\tdef parse_attempts(records_dir: Path, stage: Literal[\"verify\"]) -> dict[int, VerifyRecord]: ...\n70\t@overload\n71\tdef parse_attempts(records_dir: Path, stage: Literal[\"counsel\"]) -> dict[int, CounselRecord]: ...\n72\t@overload\n73\tdef parse_attempts(records_dir: Path, stage: str) -> dict[int, Any]: ...\n74\tdef parse_attempts(records_dir: Path, stage: str) -> dict[int, Any]:\n75\t    attempts: dict[int, Any] = {}\n76\t    if not records_dir.is_dir():\n77\t        return attempts\n78\t    for f in records_dir.glob(f\"{stage}-*.json\"):\n79\t        m = RECORD_RE.match(f.name)\n80\t        if not m or m.group(1) != stage:\n81\t            continue\n82\t        try:\n83\t            attempts[int(m.group(2))] = _load_record(f, records_dir.name)\n84\t        except json.JSONDecodeError:\n85\t            continue\n86\t    return attempts\n87\t\n88\t\n89\t@overload\n90\tdef latest_record(records_dir: Path, stage: Literal[\"spec\"]) -> SpecRecord | None: ...\n91\t@overload\n92\tdef latest_record(records_dir: Path, stage: Literal[\"approval\"]) -> ApprovalRecord | None: ...\n93\t@overload\n94\tdef latest_record(records_dir: Path, stage: Literal[\"build\"]) -> BuildRecord | None: ...\n95\t@overload\n96\tdef latest_record(records_dir: Path, stage: Literal[\"verify\"]) -> VerifyRecord | None: ...\n97\t@overload\n98\tdef latest_record(records_dir: Path, stage: Literal[\"counsel\"]) -> CounselRecord | None: ...\n99\t@overload\n100\tdef latest_record(records_dir: Path, stage: str) -> Any | None: ...\n101\tdef latest_record(records_dir: Path, stage: str) -> Any:\n102\t    attempts = parse_attempts(records_dir, stage)\n103\t    return attempts[max(attempts)] if attempts else None\n104\t\n105\t\n106\tdef next_attempt_number(records_dir: Path, stage: str) -> int:\n107\t    attempts = parse_attempts(records_dir, stage)\n108\t    return (max(attempts) + 1) if attempts else 1\n109\t\n110\t\n111\tdef latest_attempt_path(records_dir: Path, stage: str) -> Path | None:\n112\t    \"\"\"The path of the highest-numbered <stage>-NN.json, or None.\"\"\"\n113\t    attempts = parse_attempts(records_dir, stage)\n114\t    if not attempts:\n115\t        return None\n116\t    return records_dir / f\"{stage}-{max(attempts):02d}.json\"\n117\t\n118\t\n119\tdef write_record(records_dir: Path, stage: str, record: Mapping[str, Any], m: dict[str, Any],\n120\t                 item: str, log: str | None = None) -> Path:\n121\t    \"\"\"Every record gains record_version (this stage schema's own $id\n122\t    version -- issue #60) and item (verbatim from the caller, matching the\n123\t    record's directory segment), plus product_version (what ran, derived\n124\t    here) and product_pin (what the tenant declared, copied verbatim from\n125\t    the manifest, or null when the manifest carries no [attavo] table) --\n126\t    the latter two recorded, never enforced (issue #49). A manifest\n127\t    missing the table is an absent fact, not a crash: this is the one\n128\t    caller of write_record that must not raise on a shape the manifest\n129\t    schema forbids but tomllib.load happily returns.\n130\t\n131\t    Refuses (raises ValueError) a record carrying a key this stage's\n132\t    schema does not declare -- the declared key set enforced with the\n133\t    standard library, not a jsonschema import: bin/attavo is a single\n134\t    script a tenant pins, and a runtime dependency changes installation.\n135\t\n136\t    Also refuses a `status: \"failed\"` record that carries no trail at all\n137\t    -- log the empty or missing text it will sit beside, and refusal and\n138\t    halted (where the stage's schema has them) both null (issue #53).\n139\t    `returned`, `pass`, `halted`, and `refused` owe no such trail. log is\n140\t    None for a stage that invoked no adapter (verify's `returned`), which\n141\t    write_record then writes no log file for; otherwise the log is\n142\t    written before the record, so a refusal leaves no half-pair.\"\"\"\n143\t    records_dir.mkdir(parents=True, exist_ok=True)\n144\t    nn = next_attempt_number(records_dir, stage)\n145\t    schema = stage_schema(stage)\n146\t    record = {**record, \"record_version\": schema_id_version(schema), \"item\": item,\n147\t              \"product_version\": product_version(),\n148\t              \"product_pin\": (m.get(\"attavo\") or {}).get(\"version\")}\n149\t    undeclared = set(record) - set(schema.get(\"properties\", {}))\n150\t    if undeclared:\n151\t        raise ValueError(f\"write_record: {stage} record carries key(s) its schema does not \"\n152\t                         f\"declare: {', '.join(sorted(undeclared))}\")\n153\t    if (record.get(\"status\") == \"failed\" and not log\n154\t            and record.get(\"refusal\") is None and record.get(\"halted\") is None):\n155\t        raise ValueError(f\"write_record: {stage} record status is 'failed' with no log, \"\n156\t                         f\"refusal, or halted to say why\")\n157\t    path = records_dir / f\"{stage}-{nn:02d}.json\"\n158\t    if log is not None:\n159\t        path.with_suffix(\".log\").write_text(log)\n160\t    path.write_text(json.dumps(record, indent=2) + \"\\n\")\n161\t    return path\n162\t\n163\t\n164\tRECORD_RE = re.compile(r\"^([a-z]+)-([0-9]{2,})\\.json$\")\n165\t\n166\t\n167\tdef load_records(records_dir: Path) -> dict[str, dict[str, dict[str, Any]]]:\n168\t    \"\"\"{item_id: {stage: latest_record}} for every <records>/<item>/<stage>-NN.json.\"\"\"\n169\t    items: dict[str, dict[str, dict[str, Any]]] = {}\n170\t    if not records_dir.is_dir():\n171\t        return items\n172\t    for item_dir in sorted(p for p in records_dir.iterdir() if p.is_dir()):\n173\t        by_stage: dict[str, dict[int, dict[str, Any]]] = {}\n174\t        for rec in sorted(item_dir.glob(\"*.json\")):\n175\t            m = RECORD_RE.match(rec.name)\n176\t            if not m:\n177\t                continue\n178\t            stage, n = m.group(1), int(m.group(2))\n179\t            try:\n180\t                data = _load_record(rec, item_dir.name)\n181\t            except json.JSONDecodeError:\n182\t                continue\n183\t            by_stage.setdefault(stage, {})[n] = data\n184\t        items[item_dir.name] = {stage: attempts[max(attempts)] for stage, attempts in by_stage.items()}\n185\t    return items\n186\t"}]},"parent_tool_use_id":null,"session_id":"0dd7ed4f-100c-4188-9a34-077aa0b6aa25","uuid":"ece83142-6bd4-4de9-98d2-cdb265407dea","timestamp":"2026-09-26T02:13:53.791Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-219/attavo/records.py","content":"from __future__ import annotations\n\nimport json\nimport re\nfrom collections.abc import Mapping\nfrom pathlib import Path\nfrom typing import Any, Literal, cast, overload\n\nfrom attavo.common import PRODUCT_ROOT, product_version\nfrom attavo.types import ApprovalRecord, BuildRecord, CounselRecord, SpecRecord, VerifyRecord\n\n# --- record files: <stage>-NN.json, one per attempt, never overwritten ---\n\nSCHEMA_RECORDS_DIR = PRODUCT_ROOT / \"schema\" / \"records\"\n\n\ndef stage_schema(stage: str) -> dict[str, Any]:\n    \"\"\"schema/records/<stage>.schema.json -- this repository's own\n    declaration of that stage's record shape (issue #60). The only\n    artifact the outbound contract needs; there is no accessor for it\n    beyond reading the file.\"\"\"\n    schema: dict[str, Any] = json.loads((SCHEMA_RECORDS_DIR / f\"{stage}.schema.json\").read_text())\n    return schema\n\n\ndef schema_id_version(schema: dict[str, Any]) -> int:\n    \"\"\"The trailing integer of a schema's $id (\".../records/build/2\" -> 2)\n    -- the single place a record shape's version lives. write_record reads\n    this at call time rather than carrying its own copy, so the version it\n    stamps cannot drift from what the schema declares (issue #60).\"\"\"\n    return int(schema[\"$id\"].rsplit(\"/\", 1)[-1])\n\n\nclass RecordItemMismatch(RuntimeError):\n    \"\"\"A record's item field disagrees with the directory it was read\n    from (issue #60, acceptance 5) -- a misfiled or copied record, refused\n    rather than trusted.\"\"\"\n\n\ndef _load_record(path: Path, item_id: str) -> dict[str, Any]:\n    \"\"\"The one place in this repository that turns a record file's bytes\n    into a dict (issue #60, acceptance 6). Defaults record_version to 1\n    when absent -- version 1 is every record written before this release\n    and is never migrated -- and fills item from the directory when\n    absent; refuses when a present item disagrees with it.\"\"\"\n    data = json.loads(path.read_text())\n    data.setdefault(\"record_version\", 1)\n    item = data.get(\"item\")\n    if item is None:\n        data[\"item\"] = item_id\n    elif item != item_id:\n        raise RecordItemMismatch(\n            f\"{path}: item {item!r} disagrees with its directory {item_id!r}\")\n    return cast(dict[str, Any], data)\n\n\n# The typed loaders: a literal stage name selects the record kind the caller\n# gets back (issue #189). The record is read from a file and not validated\n# here, so the kind is the schema's promise, the same one the write side\n# already keeps (write_record refuses a key its schema does not declare);\n# a stage held in a variable is the untyped fallback.\n@overload\ndef parse_attempts(records_dir: Path, stage: Literal[\"spec\"]) -> dict[int, SpecRecord]: ...\n@overload\ndef parse_attempts(records_dir: Path, stage: Literal[\"approval\"]) -> dict[int, ApprovalRecord]: ...\n@overload\ndef parse_attempts(records_dir: Path, stage: Literal[\"build\"]) -> dict[int, BuildRecord]: ...\n@overload\ndef parse_attempts(records_dir: Path, stage: Literal[\"verify\"]) -> dict[int, VerifyRecord]: ...\n@overload\ndef parse_attempts(records_dir: Path, stage: Literal[\"counsel\"]) -> dict[int, CounselRecord]: ...\n@overload\ndef parse_attempts(records_dir: Path, stage: str) -> dict[int, Any]: ...\ndef parse_attempts(records_dir: Path, stage: str) -> dict[int, Any]:\n    attempts: dict[int, Any] = {}\n    if not records_dir.is_dir():\n        return attempts\n    for f in records_dir.glob(f\"{stage}-*.json\"):\n        m = RECORD_RE.match(f.name)\n        if not m or m.group(1) != stage:\n            continue\n        try:\n            attempts[int(m.group(2))] = _load_record(f, records_dir.name)\n        except json.JSONDecodeError:\n            continue\n    return attempts\n\n\n@overload\ndef latest_record(records_dir: Path, stage: Literal[\"spec\"]) -> SpecRecord | None: ...\n@overload\ndef latest_record(records_dir: Path, stage: Literal[\"approval\"]) -> ApprovalRecord | None: ...\n@overload\ndef latest_record(records_dir: Path, stage: Literal[\"build\"]) -> BuildRecord | None: ...\n@overload\ndef latest_record(records_dir: Path, stage: Literal[\"verify\"]) -> VerifyRecord | None: ...\n@overload\ndef latest_record(records_dir: Path, stage: Literal[\"counsel\"]) -> CounselRecord | None: ...\n@overload\ndef latest_record(records_dir: Path, stage: str) -> Any | None: ...\ndef latest_record(records_dir: Path, stage: str) -> Any:\n    attempts = parse_attempts(records_dir, stage)\n    return attempts[max(attempts)] if attempts else None\n\n\ndef next_attempt_number(records_dir: Path, stage: str) -> int:\n    attempts = parse_attempts(records_dir, stage)\n    return (max(attempts) + 1) if attempts else 1\n\n\ndef latest_attempt_path(records_dir: Path, stage: str) -> Path | None:\n    \"\"\"The path of the highest-numbered <stage>-NN.json, or None.\"\"\"\n    attempts = parse_attempts(records_dir, stage)\n    if not attempts:\n        return None\n    return records_dir / f\"{stage}-{max(attempts):02d}.json\"\n\n\ndef write_record(records_dir: Path, stage: str, record: Mapping[str, Any], m: dict[str, Any],\n                 item: str, log: str | None = None) -> Path:\n    \"\"\"Every record gains record_version (this stage schema's own $id\n    version -- issue #60) and item (verbatim from the caller, matching the\n    record's directory segment), plus product_version (what ran, derived\n    here) and product_pin (what the tenant declared, copied verbatim from\n    the manifest, or null when the manifest carries no [attavo] table) --\n    the latter two recorded, never enforced (issue #49). A manifest\n    missing the table is an absent fact, not a crash: this is the one\n    caller of write_record that must not raise on a shape the manifest\n    schema forbids but tomllib.load happily returns.\n\n    Refuses (raises ValueError) a record carrying a key this stage's\n    schema does not declare -- the declared key set enforced with the\n    standard library, not a jsonschema import: bin/attavo is a single\n    script a tenant pins, and a runtime dependency changes installation.\n\n    Also refuses a `status: \"failed\"` record that carries no trail at all\n    -- log the empty or missing text it will sit beside, and refusal and\n    halted (where the stage's schema has them) both null (issue #53).\n    `returned`, `pass`, `halted`, and `refused` owe no such trail. log is\n    None for a stage that invoked no adapter (verify's `returned`), which\n    write_record then writes no log file for; otherwise the log is\n    written before the record, so a refusal leaves no half-pair.\"\"\"\n    records_dir.mkdir(parents=True, exist_ok=True)\n    nn = next_attempt_number(records_dir, stage)\n    schema = stage_schema(stage)\n    record = {**record, \"record_version\": schema_id_version(schema), \"item\": item,\n              \"product_version\": product_version(),\n              \"product_pin\": (m.get(\"attavo\") or {}).get(\"version\")}\n    undeclared = set(record) - set(schema.get(\"properties\", {}))\n    if undeclared:\n        raise ValueError(f\"write_record: {stage} record carries key(s) its schema does not \"\n                         f\"declare: {', '.join(sorted(undeclared))}\")\n    if (record.get(\"status\") == \"failed\" and not log\n            and record.get(\"refusal\") is None and record.get(\"halted\") is None):\n        raise ValueError(f\"write_record: {stage} record status is 'failed' with no log, \"\n                         f\"refusal, or halted to say why\")\n    path = records_dir / f\"{stage}-{nn:02d}.json\"\n    if log is not None:\n        path.with_suffix(\".log\").write_text(log)\n    path.write_text(json.dumps(record, indent=2) + \"\\n\")\n    return path\n\n\nRECORD_RE = re.compile(r\"^([a-z]+)-([0-9]{2,})\\.json$\")\n\n\ndef load_records(records_dir: Path) -> dict[str, dict[str, dict[str, Any]]]:\n    \"\"\"{item_id: {stage: latest_record}} for every <records>/<item>/<stage>-NN.json.\"\"\"\n    items: dict[str, dict[str, dict[str, Any]]] = {}\n    if not records_dir.is_dir():\n        return items\n    for item_dir in sorted(p for p in records_dir.iterdir() if p.is_dir()):\n        by_stage: dict[str, dict[int, dict[str, Any]]] = {}\n        for rec in sorted(item_dir.glob(\"*.json\")):\n            m = RECORD_RE.match(rec.name)\n            if not m:\n                continue\n            stage, n = m.group(1), int(m.group(2))\n            try:\n                data = _load_record(rec, item_dir.name)\n            except json.JSONDecodeError:\n                continue\n            by_stage.setdefault(stage, {})[n] = data\n        items[item_dir.name] = {stage: attempts[max(attempts)] for stage, attempts in by_stage.items()}\n    return items\n","numLines":186,"startLine":1,"totalLines":186}}}

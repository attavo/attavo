tail is the signature two attempts of it are\n        # compared by, digits stripped, so a retry-after or a timestamp\n        # never keeps two otherwise identical refusals from matching.\n        transient_detail = (payload or {}).get(\"detail\")\n        record[\"stop\"] = {**stop, \"detail\": transient_detail,\n                          \"signature\": signature_of(transient_detail), \"bound\": None}\n    record_path = write_record(item_records_dir, \"build\", record, m, item_id,\n                               log=\"\\n\".join(transcripts))"}}}

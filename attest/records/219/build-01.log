{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QqADXutstUyp2ztgvkWVDs","type":"tool_result","content":"1\tfrom __future__ import annotations\n2\t\n3\timport io\n4\timport json\n5\timport os\n6\timport signal\n7\timport subprocess\n8\timport sys\n9\timport threading\n10\timport time\n11\tfrom pathlib import Path\n12\tfrom typing import TYPE_CHECKING, Any, NamedTuple, cast\n13\t\n14\tfrom attavo.approval import approval_status\n15\tfrom attavo.build import cmd_build, driver_identity\n16\tfrom attavo.common import MANIFEST, PRODUCT_ROOT, derive_item_id, git, read_manifest\n17\tfrom attavo.counsel import cmd_counsel\n18\tfrom attavo.doctor import (\n19\t    _parse_json_line,\n20\t    attempts_budget,\n21\t    ceiling_s,\n22\t    invocation_alive,\n23\t    invocations_without_record,\n24\t    retry_after_s,\n25\t    stall_bound_s,\n26\t    write_invocation_marker,\n27\t)\n28\tfrom attavo.stops import RETRYABLE_CLASSES, signature_of\n29\tfrom attavo.events import stage_events_dir\n30\tfrom attavo.filing import cmd_file_stops\n31\tfrom attavo.records import (\n32\t    latest_attempt_path,\n33\t    latest_record,\n34\t    next_attempt_number,\n35\t    stage_schema,\n36\t    write_record,\n37\t)\n38\tfrom attavo.verify import cmd_verify, read_forge_checks\n39\t\n40\tif TYPE_CHECKING:\n41\t    from attavo.types import DriveReport\n42\t\n43\t# --- drive: the mechanical transitions between approval and ready-to-merge\n44\t# (issue #84), under the reconciler's R2 (rulings A, B, C's recovery half,\n45\t# F, G, H): `attavo drive N` is one short pass. It reads the report\n46\t# (attavo.report), acts at most once -- recovers a dead or hung\n47\t# invocation, or starts the next stage in a detached worker -- and\n48\t# returns within seconds; the stage itself runs in `attavo worker`, a\n49\t# child of the pass's own session, which outlives it. Writes no record of\n50\t# its own: the stage records already on disk, and the invocation markers\n51\t# and heartbeats beside them, are the only state a pass or a worker\n52\t# reads. ---\n53\t\n54\t\n55\tdef commit_record(root: Path, record_paths: Path | list[Path], message: str) -> None:\n56\t    \"\"\"`git commit --only` on every record path given, and each one's .log\n57\t    and .filed, each if one exists -- never the whole index. A transport\n58\t    commit that sweeps the index is exactly the regression issue #46\n59\t    already guards build and verify against on the adapter side; drive\n60\t    must not reintroduce it on the transport side. The .filed marker\n61\t    (issue #89) is committed alongside the record it names, in the same\n62\t    commit and the same push, so a second worktree or a fresh clone reads\n63\t    the same filed fact rather than refiling every stop it finds with no\n64\t    marker of its own. A single Path is accepted for the common one-record\n65\t    case; issue #100 passes a list so the counsel record lands in the same\n66\t    commit as the stage record it counsels. Authored and committed as\n67\t    driver_identity(), set by the product and never the tenant's git\n68\t    config, so a driven item's record commits are never indistinguishable\n69\t    from an operator's own.\"\"\"\n70\t    if isinstance(record_paths, Path):\n71\t        record_paths = [record_paths]\n72\t    paths: list[str] = []\n73\t    for record_path in record_paths:\n74\t        paths.append(str(record_path.relative_to(root)))\n75\t        log_path = record_path.with_suffix(\".log\")\n76\t        if log_path.is_file():\n77\t            paths.append(str(log_path.relative_to(root)))\n78\t        marker_path = record_path.with_suffix(\".filed\")\n79\t        if marker_path.is_file():\n80\t            paths.append(str(marker_path.relative_to(root)))\n81\t    identity = driver_identity()\n82\t    env = dict(os.environ)\n83\t    env[\"GIT_AUTHOR_NAME\"] = identity[\"name\"]\n84\t    env[\"GIT_AUTHOR_EMAIL\"] = identity[\"email\"]\n85\t    env[\"GIT_COMMITTER_NAME\"] = identity[\"name\"]\n86\t    env[\"GIT_COMMITTER_EMAIL\"] = identity[\"email\"]\n87\t    git(root, \"add\", *paths)\n88\t    git(root, \"commit\", \"--only\", \"-m\", message, *paths, env=env)\n89\t\n90\t\n91\tdef push_record_commit(root: Path, branch: str) -> tuple[bool, str | None]:\n92\t    \"\"\"Push HEAD to branch on origin. A push a divergent remote rejects is\n93\t    retried once after `git pull --no-rebase --no-edit origin branch` -- a\n94\t    merge, never a rebase, because a rebase would change the sha the record\n95\t    commit just wrote already names. This is the record push's own retry\n96\t    -- the worker's, once it has the lease -- distinct from push_lease\n97\t    below, which never retries.\"\"\"\n98\t    def attempt() -> tuple[bool, str]:\n99\t        run = subprocess.run([\"git\", \"-C\", str(root), \"push\", \"origin\", f\"HEAD:{branch}\"],\n100\t                             capture_output=True, text=True, check=False)\n101\t        return run.returncode == 0, run.stderr.strip()\n102\t\n103\t    ok, err = attempt()\n104\t    if ok:\n105\t        return True, None\n106\t    pull = subprocess.run([\"git\", \"-C\", str(root), \"pull\", \"--no-rebase\", \"--no-edit\",\n107\t                           \"origin\", branch], capture_output=True, text=True, check=False)\n108\t    if pull.returncode != 0:\n109\t        return False, f\"push rejected and the retry merge failed: {pull.stderr.strip() or err}\"\n110\t    ok, err = attempt()\n111\t    if not ok:\n112\t        return False, f\"push rejected again after merging {branch}: {err}\"\n113\t    return True, None\n114\t\n115\t\n116\t_RACE_MARKERS = (\"non-fast-forward\", \"fetch first\", \"stale info\", \"cannot lock ref\",\n117\t                 \"failed to update ref\")\n118\t\n119\t\n120\tdef push_lease(root: Path, branch: str) -> tuple[str, str | None]:\n121\t    \"\"\"Push HEAD to branch on origin as a plain fast-forward -- no merge,\n122\t    no retry: this is the lease the marker commit takes on the attempt it\n123\t    names (ruling A). (\"pushed\", None) on success.\n124\t\n125\t    (\"lost-race\", stderr) when git's own ref check is what rejected it --\n126\t    the branch moved since this pass fast-forwarded to it (a sequential\n127\t    \"[rejected] ... (fetch first)\"), or the remote's own ref transaction\n128\t    lost a genuine simultaneous push (\"[remote rejected] ... (failed to\n129\t    update ref)\", \"cannot lock ref\"): either way, another pass's own\n130\t    marker (or record) landed there first. The pass that reads this is\n131\t    the loser: it says so, resets its own marker commit, and starts\n132\t    nothing.\n133\t\n134\t    (\"refused\", stderr) for every other rejection -- a remote that\n135\t    refuses the push outright (a hook, a permission, an unreachable\n136\t    remote). This is not a race for the lease; it is a refusal, and ends\n137\t    the pass with exit 1.\"\"\"\n138\t    run = subprocess.run([\"git\", \"-C\", str(root), \"push\", \"origin\", f\"HEAD:{branch}\"],\n139\t                         capture_output=True, text=True, check=False)\n140\t    if run.returncode == 0:\n141\t        return \"pushed\", None\n142\t    stderr = run.stderr\n143\t    if any(marker in stderr for marker in _RACE_MARKERS):\n144\t        return \"lost-race\", stderr.strip()\n145\t    return \"refused\", stderr.strip()\n146\t\n147\t\n148\tdef has_origin(root: Path) -> bool:\n149\t    \"\"\"Whether this checkout carries an origin remote at all -- a fixture\n150\t    or a scratch checkout with none is not a refusal; a pass commits\n151\t    locally and skips the push, the way recovery always has.\"\"\"\n152\t    try:\n153\t        git(root, \"remote\", \"get-url\", \"origin\")\n154\t        return True\n155\t    except RuntimeError:\n156\t        return False\n157\t\n158\t\n159\tdef drive_state(root: Path, m: dict[str, Any], item_id: str) -> tuple[str, str | None, Path]:\n160\t    \"\"\"(\"no-approval\" | \"build\" | \"verify\" | \"ready\", detail, records_dir):\n161\t    the next mechanical step for item_id, read from its latest records\n162\t    alone. A build only counts as current when it is a pass bound to the\n163\t    valid approval's own sha; a verify only counts as current when it is a\n164\t    pass bound to that build's own sha -- the same staleness a re-approval\n165\t    or a re-build must force, attest's own chain check already enforces\n166\t    (check_attest_chain), read here rather than re-typed.\"\"\"\n167\t    records_rel = m[\"paths\"][\"records\"]\n168\t    records_dir = root / records_rel / item_id\n169\t\n170\t    status = approval_status(root, m, item_id)\n171\t    if status != \"valid\":\n172\t        return \"no-approval\", status, records_dir\n173\t\n174\t    latest_approval = latest_record(records_dir, \"approval\")\n175\t    latest_build = latest_record(records_dir, \"build\")\n176\t    build_current = (latest_build is not None and latest_build.get(\"status\") == \"pass\"\n177\t                     and latest_build.get(\"approval_sha\")\n178\t                     == (latest_approval.get(\"sha\") if latest_approval else None))\n179\t    if latest_build is None or not build_current:\n180\t        return \"build\", None, records_dir\n181\t\n182\t    latest_verify = latest_record(records_dir, \"verify\")\n183\t    verify_current = (latest_verify is not None and latest_verify.get(\"status\") == \"pass\"\n184\t                      and latest_verify.get(\"build_sha\") == latest_build.get(\"sha\"))\n185\t    if not verify_current:\n186\t        return \"verify\", None, records_dir\n187\t\n188\t    return \"ready\", None, records_dir\n189\t\n190\t\n191\t# --- the heartbeat, the worker log, and the forge-checks handoff: local\n192\t# facts under the checkout's own git directory (issue #140's precedent),\n193\t# never committed and never among the paths commit_record ever names. ---\n194\t\n195\tdef heartbeat_s() -> float:\n196\t    return float(os.environ.get(\"ATTAVO_HEARTBEAT_S\", 15))\n197\t\n198\t\n199\tdef heartbeat_path(root: Path, stage: str, nn: int) -> Path:\n200\t    return stage_events_dir(root) / f\"{stage}-{nn:02d}.heartbeat\"\n201\t\n202\t\n203\tdef worker_log_path(root: Path, stage: str, nn: int) -> Path:\n204\t    return stage_events_dir(root) / f\"{stage}-{nn:02d}.worker.log\"\n205\t\n206\t\n207\tdef forge_checks_path(root: Path, stage: str, nn: int) -> Path:\n208\t    return stage_events_dir(root) / f\"{stage}-{nn:02d}.forge-checks.json\"\n209\t\n210\t\n211\tdef _events_path_for(root: Path, stage: str, nn: int) -> Path | None:\n212\t    \"\"\"The adapter's own events file for this invocation, under the\n213\t    checkout's git dir (a worktree's own dir when the checkout is one).\"\"\"\n214\t    try:\n215\t        gitdir = Path(git(root, \"rev-parse\", \"--git-dir\").strip())\n216\t    except RuntimeError:\n217\t        return None\n218\t    if not gitdir.is_absolute():\n219\t        gitdir = root / gitdir\n220\t    path = gitdir / \"attavo\" / f\"{stage}-{nn:02d}.events.jsonl\"\n221\t    return path if path.is_file() else None\n222\t\n223\t\n224\tdef _events_tail(path: Path | None, lines: int = 20) -> tuple[str, str | None]:\n225\t    \"\"\"(the last lines as a log, the last event's own at).\"\"\"\n226\t    if path is None:\n227\t        return \"no events file for this invocation\\n\", None\n228\t    try:\n229\t        text = path.read_text()\n230\t    except OSError:\n231\t        return \"events file unreadable\\n\", None\n232\t    tail = text.splitlines()[-lines:]\n233\t    last_at = None\n234\t    for line in reversed(tail):\n235\t        parsed = _parse_json_line(line)\n236\t        if not isinstance(parsed, dict):\n237\t            continue\n238\t        at = parsed.get(\"at\")\n239\t        if isinstance(at, str):\n240\t            last_at = at\n241\t            break\n242\t    return \"\\n\".join(tail) + \"\\n\", last_at\n243\t\n244\t\n245\tdef _seconds_since(at: str | None) -> float | None:\n246\t    from datetime import datetime, timezone\n247\t    if not at:\n248\t        return None\n249\t    try:\n250\t        then = datetime.strptime(at, \"%Y-%m-%dT%H:%M:%SZ\").replace(tzinfo=timezone.utc)\n251\t    except ValueError:\n252\t        return None\n253\t    return (datetime.now(timezone.utc) - then).total_seconds()\n254\t\n255\t\n256\tclass InvocationReading(NamedTuple):\n257\t    \"\"\"What one marker with no record reads as, from here and now.\"\"\"\n258\t    stage: str\n259\t    nn: int\n260\t    log: str\n261\t    last_at: str | None\n262\t    age: float | None\n263\t    cls: str  # \"running\" | \"hung\" | \"died\"\n264\t    bound: str | None = None  # R3: \"stall\" or \"ceiling\" when cls is hung\n265\t\n266\t\n267\tdef read_invocation(root: Path, bound: int | None, marker: Path, info: dict[str, Any]) -> InvocationReading:\n268\t    \"\"\"Whether an invocation that began and wrote no record is running,\n269\t    hung, or died -- read from its own heartbeat first (R2): a heartbeat\n270\t    file fresh within three beats of ATTAVO_HEARTBEAT_S is alive; a stale\n271\t    one is died, whether or not the pid still lives -- a worker stuck\n272\t    somewhere that never reaches its own heartbeat loop again is exactly\n273\t    what this is for. Only with no heartbeat file at all -- an invocation\n274\t    from before this release, or one that died before touching its\n275\t    first beat -- does this fall back to the pid: alive and, with a\n276\t    stall bound declared, past it is hung; alive with no bound, or\n277\t    within it, is running for as long as it lives; not alive is died.\n278\t    The stall bound decides hung, never died.\"\"\"\n279\t    stage, nn_text = marker.stem.rsplit(\"-\", 1)\n280\t    nn = int(nn_text)\n281\t    log, last_at = _events_tail(_events_path_for(root, stage, nn))\n282\t    # R3: the stage ceiling, wall clock from the marker, judged before any\n283\t    # liveness signal -- alive past it is hung by the ceiling.\n284\t    ceiling = ceiling_s(_manifest_of(root), stage)\n285\t    since_start = _seconds_since(info.get(\"at\"))\n286\t    if ceiling is not None and since_start is not None and since_start > ceiling:\n287\t        return InvocationReading(stage, nn, log, last_at, since_start, \"hung\", \"ceiling\")\n288\t    if not _streams_events(root, _manifest_of(root), stage):\n289\t        bound = None\n290\t    beat = heartbeat_path(root, stage, nn)\n291\t    if beat.is_file():\n292\t        try:\n293\t            beat_age = time.time() - beat.stat().st_mtime\n294\t        except OSError:\n295\t            beat_age = None\n296\t        cls = \"running\" if beat_age is not None and beat_age <= heartbeat_s() * 3 else \"died\"\n297\t        return InvocationReading(stage, nn, log, last_at, beat_age, cls)\n298\t    age = _seconds_since(last_at or info.get(\"at\"))\n299\t    if not invocation_alive(info):\n300\t        return InvocationReading(stage, nn, log, last_at, age, \"died\")\n301\t    if bound is None or age is None or age <= bound:\n302\t        return InvocationReading(stage, nn, log, last_at, age, \"running\")\n303\t    return InvocationReading(stage, nn, log, last_at, age, \"hung\", \"stall\")\n304\t\n305\t\n306\tdef _manifest_of(root: Path) -> dict[str, Any]:\n307\t    return read_manifest(root) or {}\n308\t\n309\t\n310\tdef _streams_events(root: Path, m: dict[str, Any], stage: str) -> bool:\n311\t    \"\"\"R3: whether the stage's adapter declares it streams events\n312\t    (conformance.json, streams_events); one that does not is judged by\n313\t    its ceiling alone, never by event age.\"\"\"\n314\t    name = (m.get(\"executor\") or {}).get(stage) or (m.get(\"executor\") or {}).get(\"build\")\n315\t    if not name:\n316\t        return True\n317\t    for base in (root / \"attavo\" / \"adapters\", PRODUCT_ROOT / \"adapters\"):\n318\t        conf = base / name / \"conformance.json\"\n319\t        if conf.is_file():\n320\t            try:\n321\t                return bool(json.loads(conf.read_text()).get(\"streams_events\", True))\n322\t            except (OSError, ValueError):\n323\t                return True\n324\t    return True\n325\t\n326\t\n327\tdef uncommitted_record(root: Path, records_dir: Path, stage: str) -> Path | None:\n328\t    \"\"\"The latest <stage>-NN.json this working tree carries that git has\n329\t    no commit for yet -- the moment between a worker's write and its own\n330\t    commit. None when the latest record is already committed, or there\n331\t    is none at all.\"\"\"\n332\t    path = latest_attempt_path(records_dir, stage)\n333\t    if path is None or not path.is_file():\n334\t        return None\n335\t    status = subprocess.run(\n336\t        [\"git\", \"-C\", str(root), \"status\", \"--porcelain\", \"--\", str(path.relative_to(root))],\n337\t        capture_output=True, text=True, check=False)\n338\t    return path if status.stdout.strip() else None\n339\t\n340\t\n341\tdef worker_holds_copy(root: Path, records_dir: Path) -> bool:\n342\t    \"\"\"True when this checkout's own working tree cannot safely be moved\n343\t    -- an invocation marker with no record yet (a worker, here or\n344\t    elsewhere, still holds this attempt), or a build or verify record the\n345\t    working tree carries that git has not committed yet. Scoped to the\n346\t    stage records a pass or a worker itself ever transports -- an\n347\t    operator's own spec-gate or approve, routinely uncommitted between\n348\t    their own act and the next pass, is not this. A pass never\n349\t    fast-forwards while this holds (never while a worker holds the\n350\t    copy).\"\"\"\n351\t    if invocations_without_record(records_dir):\n352\t        return True\n353\t    return (uncommitted_record(root, records_dir, \"build\") is not None\n354\t           or uncommitted_record(root, records_dir, \"verify\") is not None)\n355\t\n356\t\n357\tdef fast_forward_to_origin(root: Path, m: dict[str, Any], item_id: str) -> None:\n358\t    \"\"\"The pass's own read of origin's branch, taken before it reads\n359\t    anything else -- a commit landed there from elsewhere (an approval\n360\t    from the screen, a ruling, another pass's own record) is not a race\n361\t    for the lease, it is exactly what the lease is for. Never while a\n362\t    worker holds this copy (worker_holds_copy): resetting a working tree\n363\t    a detached child is still writing into would corrupt its own commits.\n364\t    A plain fast-forward when origin is simply ahead; when this checkout\n365\t    also carries its own commits origin has not seen yet (an operator's\n366\t    approval, not yet pushed), those are replayed on top of origin's own\n367\t    tip instead -- no merge commit, and the marker this pass is about to\n368\t    write still lands as a fast-forward when it pushes. Silent about\n369\t    everything short of that -- a real conflict, or an absent origin, is\n370\t    left for the ordinary read (and the marker push, for the lease) to\n371\t    sort out.\"\"\"\n372\t    records_dir = root / m[\"paths\"][\"records\"] / item_id\n373\t    if worker_holds_copy(root, records_dir) or not has_origin(root):\n374\t        return\n375\t    try:\n376\t        branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n377\t        git(root, \"fetch\", \"origin\", branch)\n378\t    except RuntimeError:\n379\t        return\n380\t    try:\n381\t        git(root, \"merge\", \"--ff-only\", \"FETCH_HEAD\")\n382\t        return\n383\t    except RuntimeError:\n384\t        pass\n385\t    try:\n386\t        git(root, \"rebase\", \"FETCH_HEAD\")\n387\t    except RuntimeError:\n388\t        subprocess.run([\"git\", \"-C\", str(root), \"rebase\", \"--abort\"],\n389\t                       capture_output=True, text=True, check=False)\n390\t\n391\t\n392\t# --- the worker: a detached child of the pass's own session, running the\n393\t# stage exactly as the pass used to inline, touching its own heartbeat\n394\t# while it does (R2). ---\n395\t\n396\tdef _stage_body(item_id: str, stage: str, nn: int) -> int:\n397\t    \"\"\"Runs build or verify in-process -- the same command `attavo build`\n398\t    or `attavo verify` would run -- while touching heartbeat_path every\n399\t    heartbeat_s() seconds, then transports whatever it wrote: counsel and\n400\t    file-stops on a non-pass record (issue #100, #89), one `git commit\n401\t    --only`, one push with the record push's own merge retry. The\n402\t    marker is the pass's, already committed and pushed before this\n403\t    starts; this writes and transports only the stage's own record (and,\n404\t    on a stop, its counsel record).\"\"\"\n405\t    root = Path(\".\").resolve()\n406\t    m = read_manifest(root)\n407\t    if m is None:\n408\t        return 2\n409\t    records_dir = root / m[\"paths\"][\"records\"] / item_id\n410\t    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n411\t    before = latest_attempt_path(records_dir, stage)\n412\t\n413\t    beat = heartbeat_path(root, stage, nn)\n414\t    beat.parent.mkdir(parents=True, exist_ok=True)\n415\t    beat.touch()\n416\t    stop_beat = threading.Event()\n417\t\n418\t    def _tick() -> None:\n419\t        while not stop_beat.wait(heartbeat_s()):\n420\t            beat.touch()\n421\t\n422\t    beat_thread = threading.Thread(target=_tick, daemon=True)\n423\t    beat_thread.start()\n424\t    try:\n425\t        rc = cmd_build([item_id]) if stage == \"build\" else cmd_verify([item_id])\n426\t    finally:\n427\t        stop_beat.set()\n428\t        beat_thread.join()\n429\t\n430\t    after = latest_attempt_path(records_dir, stage)\n431\t    if after is None or after == before:\n432\t        # Refused before writing anything at all (e.g. no adapter\n433\t        # configured) -- the stage command already printed why.\n434\t        return rc if rc != 0 else 1\n435\t\n436\t    record = cast(dict[str, Any], latest_record(records_dir, stage))\n437\t    status_out = record.get(\"status\")\n438\t    to_commit = [after]\n439\t    if status_out != \"pass\":\n440\t        counsel_before = latest_attempt_path(records_dir, \"counsel\")\n441\t        cmd_counsel([item_id])\n442\t        counsel_after = latest_attempt_path(records_dir, \"counsel\")\n443\t        if counsel_after is not None and counsel_after != counsel_before:\n444\t            to_commit.append(counsel_after)\n445\t        # file-stops is its own idempotent read of the item's records, so\n446\t        # calling it here on every run that wrote a non-pass record is\n447\t        # safe to call again on a later run: an already-filed stop's own\n448\t        # marker is what stops it from being filed twice.\n449\t        cmd_file_stops([item_id])\n450\t\n451\t    message = f\"attavo: {stage} record for item {item_id} ({after.stem})\"\n452\t    try:\n453\t        commit_record(root, to_commit, message)\n454\t    except RuntimeError as exc:\n455\t        print(f\"attavo drive: stopped: could not commit the {stage} record: {exc}\")\n456\t        return 1\n457\t\n458\t    if has_origin(root):\n459\t        ok, err = push_record_commit(root, branch)\n460\t        if not ok:\n461\t            print(f\"attavo drive: stopped: could not push the {stage} record: {err}\")\n462\t            return 1\n463\t    else:\n464\t        print(f\"attavo drive: note: no origin remote; {after.name} is committed, not pushed\")\n465\t\n466\t    if status_out == \"halted\":\n467\t        question = (record.get(\"halted\") or {}).get(\"question\")\n468\t        print(f\"attavo drive: stopped: {stage} halted: {question} ({after.name}); \"\n469\t              f\"pushed to {branch}\")\n470\t    elif status_out != \"pass\":\n471\t        reason = record.get(\"refusal\") or status_out\n472\t        print(f\"attavo drive: stopped: {stage} {status_out}: {reason} ({after.name}); \"\n473\t              f\"pushed to {branch}\")\n474\t    else:\n475\t        print(f\"attavo drive: pushed {after.name} to {branch}\")\n476\t    return rc\n477\t\n478\t\n479\tdef cmd_worker(argv: list[str]) -> int:\n480\t    \"\"\"`attavo worker N <build|verify> NN`: the detached child a pass\n481\t    starts once its marker is pushed -- the lease held, the attempt is\n482\t    this worker's to run. Its own session (start_new_session, set by the\n483\t    pass that spawns it); its stdout and stderr are the pass's own\n484\t    redirect, to <git-dir>/attavo/<stage>-NN.worker.log.\"\"\"\n485\t    cast(io.TextIOWrapper, sys.stdout).reconfigure(line_buffering=True)\n486\t    if len(argv) != 3:\n487\t        print(\"attavo worker: usage: attavo worker N <build|verify> NN\", file=sys.stderr)\n488\t        return 2\n489\t    item_id, stage, nn_text = argv\n490\t    if stage not in (\"build\", \"verify\"):\n491\t        print(f\"attavo worker: {stage!r} is not build or verify\", file=sys.stderr)\n492\t        return 2\n493\t    try:\n494\t        nn = int(nn_text)\n495\t    except ValueError:\n496\t        print(f\"attavo worker: {nn_text!r} is not an attempt number\", file=sys.stderr)\n497\t        return 2\n498\t    return _stage_body(item_id, stage, nn)\n499\t\n500\t\n501\t# --- the pass's own two acts: start a stage (the lease), and recover\n502\t# exactly the one invocation the report names owed one. ---\n503\t\n504\tdef _start_stage(root: Path, m: dict[str, Any], item_id: str, stage: str,\n505\t                 forge_checks: dict[str, Any] | None) -> int:\n506\t    \"\"\"The lease (ruling A): the marker, committed and pushed as a plain\n507\t    fast-forward with no merge and no retry (push_lease). Lost to another\n508\t    pass, or refused outright by the remote, both undo the marker commit\n509\t    here (git reset --hard) so this checkout carries no half-taken\n510\t    attempt either way; only a pushed lease starts the worker. On a\n511\t    review, forge_checks is the checks this same pass already read on\n512\t    the pre-marker head (ruling B) -- written to\n513\t    <git-dir>/attavo/verify-NN.forge-checks.json and named in\n514\t    ATTAVO_FORGE_CHECKS, so the worker's own `attavo verify` reads it\n515\t    instead of polling.\"\"\"\n516\t    records_dir = root / m[\"paths\"][\"records\"] / item_id\n517\t    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n518\t    nn = next_attempt_number(records_dir, stage)\n519\t    marker = write_invocation_marker(root, records_dir, stage, nn)\n520\t    try:\n521\t        commit_record(root, [marker], f\"attavo: {stage} invocation {nn:02d} started for item {item_id}\")\n522\t    except RuntimeError as exc:\n523\t        print(f\"attavo drive: stopped: could not commit the {stage} invocation marker: {exc}\")\n524\t        return 1\n525\t\n526\t    if has_origin(root):\n527\t        outcome, err = push_lease(root, branch)\n528\t        if outcome != \"pushed\":\n529\t            git(root, \"reset\", \"--hard\", \"HEAD^\")\n530\t            if outcome == \"lost-race\":\n531\t                print(f\"attavo drive: another pass holds this attempt ({marker.name}); nothing started\")\n532\t                return 0\n533\t            print(f\"attavo drive: stopped: could not push the {stage} invocation marker: {err}\")\n534\t            return 1\n535\t\n536\t    env = dict(os.environ)\n537\t    if forge_checks is not None:\n538\t        checks_file = forge_checks_path(root, stage, nn)\n539\t        checks_file.write_text(json.dumps(forge_checks))\n540\t        env[\"ATTAVO_FORGE_CHECKS\"] = str(checks_file)\n541\t    log = worker_log_path(root, stage, nn)\n542\t    with log.open(\"ab\") as fh, open(os.devnull, \"rb\") as devnull:\n543\t        proc = subprocess.Popen(\n544\t            [sys.executable, str(PRODUCT_ROOT / \"bin\" / \"attavo\"), \"worker\", item_id, stage, f\"{nn:02d}\"],\n545\t            cwd=str(root), env=env, stdin=devnull, stdout=fh, stderr=subprocess.STDOUT,\n546\t            start_new_session=True)\n547\t    word = \"Build\" if stage == \"build\" else \"Review\"\n548\t    print(f\"attavo drive: {word} started (attempt {nn:02d}, worker pid {proc.pid})\")\n549\t    return 0\n550\t\n551\t\n552\tdef _recover_one(root: Path, m: dict[str, Any], item_id: str, records_dir: Path) -> int:\n553\t    \"\"\"The pass's own recovery act (what `--recover` did): exactly the one\n554\t    invocation the report just read as owing one -- died or hung -- ends\n555\t    here. class died when the heartbeat is stale (or absent and the pid\n556\t    is gone), class hung when there is no heartbeat, the pid lives, and a\n557\t    declared [drive].stall_after_s has passed with no newer event, and\n558\t    terminated. Provenance product; the events tail as the log. Committed\n559\t    and pushed the way any stage record is (push_record_commit, with its\n560\t    own merge retry) -- this is not a race for a lease, since no new\n561\t    attempt marker is written.\"\"\"\n562\t    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n563\t    bound = stall_bound_s(m)\n564\t    pending = invocations_without_record(records_dir)\n565\t    readings = [(marker, info, read_invocation(root, bound, marker, info)) for marker, info in pending]\n566\t    candidate = next(((mk, i, rd) for mk, i, rd in readings if rd.cls != \"running\"), None)\n567\t    if candidate is None:\n568\t        # The report read this a moment ago; nothing owed recovery by the\n569\t        # time this pass got here (another pass recovered it, or it\n570\t        # finished on its own).\n571\t        return 0\n572\t    marker, info, reading = candidate\n573\t    stage, nn, log, last_at, age, cls, crossed = reading\n574\t    pid, host = info.get(\"pid\"), info.get(\"host\")\n575\t\n576\t    if next_attempt_number(records_dir, stage) != nn:\n577\t        print(f\"attavo drive: stopped: {marker.name} names attempt {nn} but the next \"\n578\t              f\"{stage} record would be {next_attempt_number(records_dir, stage):02d}; \"\n579\t              f\"a later record already exists, read the records before recovering\")\n580\t        return 1\n581\t\n582\t    if cls == \"hung\":\n583\t        try:\n584\t            os.kill(cast(int, pid), signal.SIGTERM)\n585\t            ended = \"terminated\"\n586\t        except OSError as exc:\n587\t            ended = f\"not terminated ({exc})\"\n588\t        if crossed == \"ceiling\":\n589\t            detail = (f\"pid {pid} on {host} alive {int(cast(float, age))} s after its marker, past the \"\n590\t                      f\"{stage} ceiling of {ceiling_s(m, stage)} s; {ended}\")\n591\t        else:\n592\t            detail = (f\"pid {pid} on {host} alive with no event for {int(cast(float, age))} s \"\n593\t                      f\"(bound {bound} s); {ended}\")\n594\t    else:\n595\t        detail = (f\"pid {pid} on {host} is not running and wrote no {marker.stem}.json; \"\n596\t                  f\"started {info.get('at')}, last event {last_at or 'none'}\")\n597\t\n598\t    schema = stage_schema(stage)\n599\t    record: dict[str, Any] = {k: None for k in schema.get(\"required\", [])}\n600\t    approval = latest_record(records_dir, \"approval\")\n601\t    record.update({\"sha\": info.get(\"sha\"), \"start_sha\": info.get(\"sha\"),\n602\t                   \"approval_sha\": approval.get(\"sha\") if approval else None,\n603\t                   \"at\": info.get(\"at\"),\n604\t                   \"adapter\": (m.get(\"executor\") or {}).get(stage),\n605\t                   \"status\": \"failed\", \"refusal\": None, \"halted\": None,\n606\t                   \"retry_of\": None, \"steer\": None,\n607\t                   \"stop\": {\"class\": cls, \"provenance\": \"product\", \"detail\": detail,\n608\t                            \"signature\": signature_of(log.strip().splitlines()[-1] if log.strip() else detail),\n609\t                            \"bound\": crossed}})\n610\t    if \"wall_clock_s\" in record:\n611\t        record[\"wall_clock_s\"] = None if age is None else int(age)\n612\t    record = {k: v for k, v in record.items() if k in schema.get(\"properties\", {})}\n613\t    try:\n614\t        path = write_record(records_dir, stage, record, m, item_id, log=log)\n615\t    except ValueError as exc:\n616\t        print(f\"attavo drive: stopped: could not write the {cls} record for {marker.stem}: {exc}\")\n617\t        return 1\n618\t    try:\n619\t        commit_record(root, [path], f\"attavo: {stage} record for item {item_id} \"\n620\t                                    f\"({path.stem}), recovered as {cls}\")\n621\t    except RuntimeError as exc:\n622\t        print(f\"attavo drive: stopped: could not commit the {cls} record: {exc}\")\n623\t        return 1\n624\t    if has_origin(root):\n625\t        ok, err = push_record_commit(root, branch)\n626\t        if not ok:\n627\t            print(f\"attavo drive: stopped: could not push the {cls} record: {err}\")\n628\t            return 1\n629\t    else:\n630\t        print(f\"attavo drive: note: no origin remote; {path.name} is committed, not pushed\")\n631\t    print(f\"attavo drive: recovered {marker.stem} as {cls}: {detail}\")\n632\t    return 0\n633\t\n634\t\n635\tdef _advance_again(root: Path, m: dict[str, Any], item_id: str, stage: str, head: str | None) -> int:\n636\t    \"\"\"`--again`'s own act on a stopped stage: exactly what next-build or\n637\t    next-review would do, bypassing the level a plain pass leaves alone\n638\t    for the operator. A review reads the forge fresh here -- once, since\n639\t    the report's own stopped reading never touched it -- rather than\n640\t    reusing a read that was never taken.\"\"\"\n641\t    if stage == \"build\":\n642\t        return _start_stage(root, m, item_id, \"build\", None)\n643\t    checks_command = (m.get(\"forge\") or {}).get(\"checks_command\")\n644\t    if not checks_command:\n645\t        print(\"attavo drive: refused: no [forge].checks_command in the manifest\")\n646\t        return 1\n647\t    forge_checks, ok = read_forge_checks(root, checks_command, cast(str, head))\n648\t    if not ok:\n649\t        conclusions = forge_checks[\"conclusions\"]\n650\t        named = \", \".join(f\"{c['name']} {c['conclusion']}\" for c in conclusions) or \"no checks reported\"\n651\t        print(f\"attavo drive: forge checks not green on {cast(str, head)[:12]}: {named}\")\n652\t        return 0\n653\t    return _start_stage(root, m, item_id, \"verify\", forge_checks)\n654\t\n655\t\n656\tdef _retry_due(root: Path, m: dict[str, Any], item_id: str, r: \"DriveReport\") -> bool:\n657\t    \"\"\"R3 (stub): a stopped stage whose class is retryable, whose budget is\n658\t    not spent, whose last two signatures differ, and -- for transient --\n659\t    whose record is older than retry_after_s, is retried by this pass.\"\"\"\n660\t    if r[\"stop_class\"] not in RETRYABLE_CLASSES:\n661\t        return False\n662\t    records_dir = root / m[\"paths\"][\"records\"] / item_id\n663\t    stage = \"build\" if r[\"stop_class\"] == \"returned\" else cast(str, r[\"stage\"])\n664\t    spent = next_attempt_number(records_dir, stage) - 1\n665\t    if spent >= attempts_budget(m):\n666\t        return False\n667\t    from attavo.records import parse_attempts\n668\t    attempts = parse_attempts(records_dir, cast(str, r[\"stage\"]))\n669\t    if len(attempts) >= 2:\n670\t        last, prev = attempts[max(attempts)], attempts[sorted(attempts)[-2]]\n671\t        sig_last = ((last.get(\"stop\") or {}).get(\"signature\"))\n672\t        sig_prev = ((prev.get(\"stop\") or {}).get(\"signature\"))\n673\t        if sig_last is not None and sig_last == sig_prev:\n674\t            return False\n675\t    if r[\"stop_class\"] == \"transient\":\n676\t        rec = attempts[max(attempts)] if attempts else {}\n677\t        age = _seconds_since(rec.get(\"at\"))\n678\t        if age is not None and age < retry_after_s(m):\n679\t            return False\n680\t    return True\n681\t\n682\t\n683\tdef _pass_once(root: Path, m: dict[str, Any], item_id: str, again: bool) -> tuple[int, \"DriveReport\"]:\n684\t    \"\"\"One pass: fast-forward to origin (never while a worker holds the\n685\t    copy), read the report, act at most once, return. The three acts,\n686\t    one per report state that is the product's move: owes-recovery\n687\t    recovers; next-build and next-review start their stage, handing a\n688\t    review the checks the report already read once on the pre-marker\n689\t    head. --again starts the next attempt of a stopped stage. Every\n690\t    other level is printed in the report's own words and left.\"\"\"\n691\t    from attavo.report import drive_report\n692\t    fast_forward_to_origin(root, m, item_id)\n693\t    r = drive_report(root, m, item_id)\n694\t\n695\t    if r[\"state\"] == \"owes-recovery\":\n696\t        records_dir = root / m[\"paths\"][\"records\"] / item_id\n697\t        return _recover_one(root, m, item_id, records_dir), r\n698\t    if r[\"state\"] == \"next-build\":\n699\t        return _start_stage(root, m, item_id, \"build\", None), r\n700\t    if r[\"state\"] == \"next-review\":\n701\t        checks_command = (m.get(\"forge\") or {}).get(\"checks_command\")\n702\t        forge_checks = {\"command\": checks_command, \"sha\": r[\"head\"], \"conclusions\": r[\"checks\"] or []}\n703\t        return _start_stage(root, m, item_id, \"verify\", forge_checks), r\n704\t    if r[\"state\"] == \"stopped\" and r[\"stage\"] and _retry_due(root, m, item_id, r):\n705\t        stage = \"build\" if r[\"stop_class\"] == \"returned\" else r[\"stage\"]\n706\t        return _advance_again(root, m, item_id, stage, r[\"head\"]), r\n707\t    if r[\"state\"] == \"blocked-on-checks\" and r[\"stage\"] == \"verify\":\n708\t        # R3: a concluded red check on a passed build's head is a record,\n709\t        # not a level -- the review returns it, and the next build is\n710\t        # handed the evidence.\n711\t        checks_command = (m.get(\"forge\") or {}).get(\"checks_command\")\n712\t        forge_checks = {\"command\": checks_command, \"sha\": r[\"head\"], \"conclusions\": r[\"checks\"] or []}\n713\t        return _start_stage(root, m, item_id, \"verify\", forge_checks), r\n714\t    if again and r[\"state\"] == \"stopped\" and r[\"stage\"]:\n715\t        return _advance_again(root, m, item_id, r[\"stage\"], r[\"head\"]), r\n716\t\n717\t    print(f\"attavo drive: {r['says']}\")\n718\t    return (1 if r[\"state\"] == \"refused\" else 0), r\n719\t\n720\t\n721\t_TERMINAL_STATES = (\"waiting-on-approval\", \"stopped\", \"ready-to-merge\", \"merged\")\n722\t\n723\t\n724\tdef _until_ready(root: Path, m: dict[str, Any], item_id: str, again: bool) -> int:\n725\t    \"\"\"--until-ready: the pass, repeated in one process, sleeping\n726\t    ATTAVO_DRIVE_POLL_INTERVAL_S between passes, until the level is the\n727\t    operator's or done (exit 0), a concluded check is red (exit 1), or\n728\t    an unconcluded one has not concluded within ATTAVO_DRIVE_POLL_BOUND_S\n729\t    (exit 1). A stage running in its own worker is not bounded by this --\n730\t    only time spent waiting on the forge is.\"\"\"\n731\t    from attavo.verify import drive_forge_poll_bound_s, drive_forge_poll_interval_s\n732\t    bound = drive_forge_poll_bound_s()\n733\t    interval = drive_forge_poll_interval_s()\n734\t    waiting_since: float | None = None\n735\t    while True:\n736\t        rc, r = _pass_once(root, m, item_id, again)\n737\t        state = r[\"state\"]\n738\t\n739\t        if state == \"waiting-on-checks\":\n740\t            if waiting_since is None:\n741\t                waiting_since = time.monotonic()\n742\t            elif time.monotonic() - waiting_since >= bound:\n743\t                print(f\"attavo drive: stopped: the checks did not conclude within {bound:.0f}s\")\n744\t                return 1\n745\t        else:\n746\t            waiting_since = None\n747\t\n748\t        if rc != 0:\n749\t            return rc\n750\t        if state in _TERMINAL_STATES:\n751\t            return 0\n752\t        if state == \"blocked-on-checks\":\n753\t            return 1\n754\t        time.sleep(interval)\n755\t\n756\t\n757\tdef _drive_all() -> int:\n758\t    \"\"\"--all: one pass, in its own process, in every ../attavo-worktree-N\n759\t    beside this checkout -- each one derives its own item from its own\n760\t    attavo/N-* branch. Every line either prints is prefixed with the\n761\t    worktree's own directory name, so an operator reading them together\n762\t    can tell which item each line is about.\"\"\"\n763\t    root = Path(\".\").resolve()\n764\t    siblings = sorted(p for p in root.parent.glob(\"attavo-worktree-*\") if p.is_dir())\n765\t    if not siblings:\n766\t        print(\"attavo drive: --all found no ../attavo-worktree-N beside this checkout\")\n767\t        return 0\n768\t    worst = 0\n769\t    for copy in siblings:\n770\t        run = subprocess.run([sys.executable, str(PRODUCT_ROOT / \"bin\" / \"attavo\"), \"drive\"],\n771\t                             cwd=str(copy), capture_output=True, text=True, check=False)\n772\t        for line in (run.stdout + run.stderr).splitlines():\n773\t            print(f\"{copy.name}: {line}\")\n774\t        worst = max(worst, run.returncode)\n775\t    return worst\n776\t\n777\t\n778\tdef cmd_drive(argv: list[str]) -> int:\n779\t    # Issue #145: Python block-buffers stdout when it is not a tty (a\n780\t    # pipe, e.g. a screen reading this process live), so every line this\n781\t    # prints would otherwise sit unflushed until the process exits.\n782\t    # Line-buffering makes a pipe reader see each line the moment it is\n783\t    # printed, the same as a terminal already does; `attavo worker`\n784\t    # reconfigures its own stdout the same way.\n785\t    cast(io.TextIOWrapper, sys.stdout).reconfigure(line_buffering=True)\n786\t\n787\t    if \"--recover\" in argv:\n788\t        print(\"attavo drive: --recover is gone; a pass recovers a dead or hung invocation \"\n789\t              \"itself, as soon as the report owes one\", file=sys.stderr)\n790\t        return 2\n791\t\n792\t    until_ready = \"--until-ready\" in argv\n793\t    report = \"--report\" in argv\n794\t    again = \"--again\" in argv\n795\t    all_flag = \"--all\" in argv\n796\t    positional = [a for a in argv if not a.startswith(\"--\")]\n797\t\n798\t    if all_flag:\n799\t        if until_ready or report or again or positional:\n800\t            print(\"attavo drive: --all runs one pass in every worktree beside this checkout; \"\n801\t                  \"drop N and every other flag\", file=sys.stderr)\n802\t            return 2\n803\t        return _drive_all()\n804\t\n805\t    root = Path(\".\").resolve()\n806\t    item_id = positional[0] if positional else derive_item_id(root)\n807\t    if not item_id:\n808\t        print(\"attavo drive: cannot derive item id; pass N or run on an attavo/N-* branch\",\n809\t              file=sys.stderr)\n810\t        return 2\n811\t    m = read_manifest(root)\n812\t    if m is None:\n813\t        print(f\"attavo drive: no {MANIFEST} at {root}\", file=sys.stderr)\n814\t        return 2\n815\t\n816\t    if report:\n817\t        if until_ready or again:\n818\t            print(\"attavo drive: --report reads and does nothing else; drop --until-ready \"\n819\t                  \"and --again\", file=sys.stderr)\n820\t            return 2\n821\t        fast_forward_to_origin(root, m, item_id)\n822\t        from attavo.report import drive_report\n823\t        print(json.dumps(drive_report(root, m, item_id), indent=2))\n824\t        return 0\n825\t\n826\t    if until_ready:\n827\t        return _until_ready(root, m, item_id, again)\n828\t    rc, _ = _pass_once(root, m, item_id, again)\n829\t    return rc\n830\t"}]},"parent_tool_use_id":null,"session_id":"0dd7ed4f-100c-4188-9a34-077aa0b6aa25","uuid":"66e14470-fad5-423a-a07d-cd2bab181c94","timestamp":"2026-09-26T02:08:30.707Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-219/attest/specs/219/stub/attavo/drive.py","content":"from __future__ import annotations\n\nimport io\nimport json\nimport os\nimport signal\nimport subprocess\nimport sys\nimport threading\nimport time\nfrom pathlib import Path\nfrom typing import TYPE_CHECKING, Any, NamedTuple, cast\n\nfrom attavo.approval import approval_status\nfrom attavo.build import cmd_build, driver_identity\nfrom attavo.common import MANIFEST, PRODUCT_ROOT, derive_item_id, git, read_manifest\nfrom attavo.counsel import cmd_counsel\nfrom attavo.doctor import (\n    _parse_json_line,\n    attempts_budget,\n    ceiling_s,\n    invocation_alive,\n    invocations_without_record,\n    retry_after_s,\n    stall_bound_s,\n    write_invocation_marker,\n)\nfrom attavo.stops import RETRYABLE_CLASSES, signature_of\nfrom attavo.events import stage_events_dir\nfrom attavo.filing import cmd_file_stops\nfrom attavo.records import (\n    latest_attempt_path,\n    latest_record,\n    next_attempt_number,\n    stage_schema,\n    write_record,\n)\nfrom attavo.verify import cmd_verify, read_forge_checks\n\nif TYPE_CHECKING:\n    from attavo.types import DriveReport\n\n# --- drive: the mechanical transitions between approval and ready-to-merge\n# (issue #84), under the reconciler's R2 (rulings A, B, C's recovery half,\n# F, G, H): `attavo drive N` is one short pass. It reads the report\n# (attavo.report), acts at most once -- recovers a dead or hung\n# invocation, or starts the next stage in a detached worker -- and\n# returns within seconds; the stage itself runs in `attavo worker`, a\n# child of the pass's own session, which outlives it. Writes no record of\n# its own: the stage records already on disk, and the invocation markers\n# and heartbeats beside them, are the only state a pass or a worker\n# reads. ---\n\n\ndef commit_record(root: Path, record_paths: Path | list[Path], message: str) -> None:\n    \"\"\"`git commit --only` on every record path given, and each one's .log\n    and .filed, each if one exists -- never the whole index. A transport\n    commit that sweeps the index is exactly the regression issue #46\n    already guards build and verify against on the adapter side; drive\n    must not reintroduce it on the transport side. The .filed marker\n    (issue #89) is committed alongside the record it names, in the same\n    commit and the same push, so a second worktree or a fresh clone reads\n    the same filed fact rather than refiling every stop it finds with no\n    marker of its own. A single Path is accepted for the common one-record\n    case; issue #100 passes a list so the counsel record lands in the same\n    commit as the stage record it counsels. Authored and committed as\n    driver_identity(), set by the product and never the tenant's git\n    config, so a driven item's record commits are never indistinguishable\n    from an operator's own.\"\"\"\n    if isinstance(record_paths, Path):\n        record_paths = [record_paths]\n    paths: list[str] = []\n    for record_path in record_paths:\n        paths.append(str(record_path.relative_to(root)))\n        log_path = record_path.with_suffix(\".log\")\n        if log_path.is_file():\n            paths.append(str(log_path.relative_to(root)))\n        marker_path = record_path.with_suffix(\".filed\")\n        if marker_path.is_file():\n            paths.append(str(marker_path.relative_to(root)))\n    identity = driver_identity()\n    env = dict(os.environ)\n    env[\"GIT_AUTHOR_NAME\"] = identity[\"name\"]\n    env[\"GIT_AUTHOR_EMAIL\"] = identity[\"email\"]\n    env[\"GIT_COMMITTER_NAME\"] = identity[\"name\"]\n    env[\"GIT_COMMITTER_EMAIL\"] = identity[\"email\"]\n    git(root, \"add\", *paths)\n    git(root, \"commit\", \"--only\", \"-m\", message, *paths, env=env)\n\n\ndef push_record_commit(root: Path, branch: str) -> tuple[bool, str | None]:\n    \"\"\"Push HEAD to branch on origin. A push a divergent remote rejects is\n    retried once after `git pull --no-rebase --no-edit origin branch` -- a\n    merge, never a rebase, because a rebase would change the sha the record\n    commit just wrote already names. This is the record push's own retry\n    -- the worker's, once it has the lease -- distinct from push_lease\n    below, which never retries.\"\"\"\n    def attempt() -> tuple[bool, str]:\n        run = subprocess.run([\"git\", \"-C\", str(root), \"push\", \"origin\", f\"HEAD:{branch}\"],\n                             capture_output=True, text=True, check=False)\n        return run.returncode == 0, run.stderr.strip()\n\n    ok, err = attempt()\n    if ok:\n        return True, None\n    pull = subprocess.run([\"git\", \"-C\", str(root), \"pull\", \"--no-rebase\", \"--no-edit\",\n                           \"origin\", branch], capture_output=True, text=True, check=False)\n    if pull.returncode != 0:\n        return False, f\"push rejected and the retry merge failed: {pull.stderr.strip() or err}\"\n    ok, err = attempt()\n    if not ok:\n        return False, f\"push rejected again after merging {branch}: {err}\"\n    return True, None\n\n\n_RACE_MARKERS = (\"non-fast-forward\", \"fetch first\", \"stale info\", \"cannot lock ref\",\n                 \"failed to update ref\")\n\n\ndef push_lease(root: Path, branch: str) -> tuple[str, str | None]:\n    \"\"\"Push HEAD to branch on origin as a plain fast-forward -- no merge,\n    no retry: this is the lease the marker commit takes on the attempt it\n    names (ruling A). (\"pushed\", None) on success.\n\n    (\"lost-race\", stderr) when git's own ref check is what rejected it --\n    the branch moved since this pass fast-forwarded to it (a sequential\n    \"[rejected] ... (fetch first)\"), or the remote's own ref transaction\n    lost a genuine simultaneous push (\"[remote rejected] ... (failed to\n    update ref)\", \"cannot lock ref\"): either way, another pass's own\n    marker (or record) landed there first. The pass that reads this is\n    the loser: it says so, resets its own marker commit, and starts\n    nothing.\n\n    (\"refused\", stderr) for every other rejection -- a remote that\n    refuses the push outright (a hook, a permission, an unreachable\n    remote). This is not a race for the lease; it is a refusal, and ends\n    the pass with exit 1.\"\"\"\n    run = subprocess.run([\"git\", \"-C\", str(root), \"push\", \"origin\", f\"HEAD:{branch}\"],\n                         capture_output=True, text=True, check=False)\n    if run.returncode == 0:\n        return \"pushed\", None\n    stderr = run.stderr\n    if any(marker in stderr for marker in _RACE_MARKERS):\n        return \"lost-race\", stderr.strip()\n    return \"refused\", stderr.strip()\n\n\ndef has_origin(root: Path) -> bool:\n    \"\"\"Whether this checkout carries an origin remote at all -- a fixture\n    or a scratch checkout with none is not a refusal; a pass commits\n    locally and skips the push, the way recovery always has.\"\"\"\n    try:\n        git(root, \"remote\", \"get-url\", \"origin\")\n        return True\n    except RuntimeError:\n        return False\n\n\ndef drive_state(root: Path, m: dict[str, Any], item_id: str) -> tuple[str, str | None, Path]:\n    \"\"\"(\"no-approval\" | \"build\" | \"verify\" | \"ready\", detail, records_dir):\n    the next mechanical step for item_id, read from its latest records\n    alone. A build only counts as current when it is a pass bound to the\n    valid approval's own sha; a verify only counts as current when it is a\n    pass bound to that build's own sha -- the same staleness a re-approval\n    or a re-build must force, attest's own chain check already enforces\n    (check_attest_chain), read here rather than re-typed.\"\"\"\n    records_rel = m[\"paths\"][\"records\"]\n    records_dir = root / records_rel / item_id\n\n    status = approval_status(root, m, item_id)\n    if status != \"valid\":\n        return \"no-approval\", status, records_dir\n\n    latest_approval = latest_record(records_dir, \"approval\")\n    latest_build = latest_record(records_dir, \"build\")\n    build_current = (latest_build is not None and latest_build.get(\"status\") == \"pass\"\n                     and latest_build.get(\"approval_sha\")\n                     == (latest_approval.get(\"sha\") if latest_approval else None))\n    if latest_build is None or not build_current:\n        return \"build\", None, records_dir\n\n    latest_verify = latest_record(records_dir, \"verify\")\n    verify_current = (latest_verify is not None and latest_verify.get(\"status\") == \"pass\"\n                      and latest_verify.get(\"build_sha\") == latest_build.get(\"sha\"))\n    if not verify_current:\n        return \"verify\", None, records_dir\n\n    return \"ready\", None, records_dir\n\n\n# --- the heartbeat, the worker log, and the forge-checks handoff: local\n# facts under the checkout's own git directory (issue #140's precedent),\n# never committed and never among the paths commit_record ever names. ---\n\ndef heartbeat_s() -> float:\n    return float(os.environ.get(\"ATTAVO_HEARTBEAT_S\", 15))\n\n\ndef heartbeat_path(root: Path, stage: str, nn: int) -> Path:\n    return stage_events_dir(root) / f\"{stage}-{nn:02d}.heartbeat\"\n\n\ndef worker_log_path(root: Path, stage: str, nn: int) -> Path:\n    return stage_events_dir(root) / f\"{stage}-{nn:02d}.worker.log\"\n\n\ndef forge_checks_path(root: Path, stage: str, nn: int) -> Path:\n    return stage_events_dir(root) / f\"{stage}-{nn:02d}.forge-checks.json\"\n\n\ndef _events_path_for(root: Path, stage: str, nn: int) -> Path | None:\n    \"\"\"The adapter's own events file for this invocation, under the\n    checkout's git dir (a worktree's own dir when the checkout is one).\"\"\"\n    try:\n        gitdir = Path(git(root, \"rev-parse\", \"--git-dir\").strip())\n    except RuntimeError:\n        return None\n    if not gitdir.is_absolute():\n        gitdir = root / gitdir\n    path = gitdir / \"attavo\" / f\"{stage}-{nn:02d}.events.jsonl\"\n    return path if path.is_file() else None\n\n\ndef _events_tail(path: Path | None, lines: int = 20) -> tuple[str, str | None]:\n    \"\"\"(the last lines as a log, the last event's own at).\"\"\"\n    if path is None:\n        return \"no events file for this invocation\\n\", None\n    try:\n        text = path.read_text()\n    except OSError:\n        return \"events file unreadable\\n\", None\n    tail = text.splitlines()[-lines:]\n    last_at = None\n    for line in reversed(tail):\n        parsed = _parse_json_line(line)\n        if not isinstance(parsed, dict):\n            continue\n        at = parsed.get(\"at\")\n        if isinstance(at, str):\n            last_at = at\n            break\n    return \"\\n\".join(tail) + \"\\n\", last_at\n\n\ndef _seconds_since(at: str | None) -> float | None:\n    from datetime import datetime, timezone\n    if not at:\n        return None\n    try:\n        then = datetime.strptime(at, \"%Y-%m-%dT%H:%M:%SZ\").replace(tzinfo=timezone.utc)\n    except ValueError:\n        return None\n    return (datetime.now(timezone.utc) - then).total_seconds()\n\n\nclass InvocationReading(NamedTuple):\n    \"\"\"What one marker with no record reads as, from here and now.\"\"\"\n    stage: str\n    nn: int\n    log: str\n    last_at: str | None\n    age: float | None\n    cls: str  # \"running\" | \"hung\" | \"died\"\n    bound: str | None = None  # R3: \"stall\" or \"ceiling\" when cls is hung\n\n\ndef read_invocation(root: Path, bound: int | None, marker: Path, info: dict[str, Any]) -> InvocationReading:\n    \"\"\"Whether an invocation that began and wrote no record is running,\n    hung, or died -- read from its own heartbeat first (R2): a heartbeat\n    file fresh within three beats of ATTAVO_HEARTBEAT_S is alive; a stale\n    one is died, whether or not the pid still lives -- a worker stuck\n    somewhere that never reaches its own heartbeat loop again is exactly\n    what this is for. Only with no heartbeat file at all -- an invocation\n    from before this release, or one that died before touching its\n    first beat -- does this fall back to the pid: alive and, with a\n    stall bound declared, past it is hung; alive with no bound, or\n    within it, is running for as long as it lives; not alive is died.\n    The stall bound decides hung, never died.\"\"\"\n    stage, nn_text = marker.stem.rsplit(\"-\", 1)\n    nn = int(nn_text)\n    log, last_at = _events_tail(_events_path_for(root, stage, nn))\n    # R3: the stage ceiling, wall clock from the marker, judged before any\n    # liveness signal -- alive past it is hung by the ceiling.\n    ceiling = ceiling_s(_manifest_of(root), stage)\n    since_start = _seconds_since(info.get(\"at\"))\n    if ceiling is not None and since_start is not None and since_start > ceiling:\n        return InvocationReading(stage, nn, log, last_at, since_start, \"hung\", \"ceiling\")\n    if not _streams_events(root, _manifest_of(root), stage):\n        bound = None\n    beat = heartbeat_path(root, stage, nn)\n    if beat.is_file():\n        try:\n            beat_age = time.time() - beat.stat().st_mtime\n        except OSError:\n            beat_age = None\n        cls = \"running\" if beat_age is not None and beat_age <= heartbeat_s() * 3 else \"died\"\n        return InvocationReading(stage, nn, log, last_at, beat_age, cls)\n    age = _seconds_since(last_at or info.get(\"at\"))\n    if not invocation_alive(info):\n        return InvocationReading(stage, nn, log, last_at, age, \"died\")\n    if bound is None or age is None or age <= bound:\n        return InvocationReading(stage, nn, log, last_at, age, \"running\")\n    return InvocationReading(stage, nn, log, last_at, age, \"hung\", \"stall\")\n\n\ndef _manifest_of(root: Path) -> dict[str, Any]:\n    return read_manifest(root) or {}\n\n\ndef _streams_events(root: Path, m: dict[str, Any], stage: str) -> bool:\n    \"\"\"R3: whether the stage's adapter declares it streams events\n    (conformance.json, streams_events); one that does not is judged by\n    its ceiling alone, never by event age.\"\"\"\n    name = (m.get(\"executor\") or {}).get(stage) or (m.get(\"executor\") or {}).get(\"build\")\n    if not name:\n        return True\n    for base in (root / \"attavo\" / \"adapters\", PRODUCT_ROOT / \"adapters\"):\n        conf = base / name / \"conformance.json\"\n        if conf.is_file():\n            try:\n                return bool(json.loads(conf.read_text()).get(\"streams_events\", True))\n            except (OSError, ValueError):\n                return True\n    return True\n\n\ndef uncommitted_record(root: Path, records_dir: Path, stage: str) -> Path | None:\n    \"\"\"The latest <stage>-NN.json this working tree carries that git has\n    no commit for yet -- the moment between a worker's write and its own\n    commit. None when the latest record is already committed, or there\n    is none at all.\"\"\"\n    path = latest_attempt_path(records_dir, stage)\n    if path is None or not path.is_file():\n        return None\n    status = subprocess.run(\n        [\"git\", \"-C\", str(root), \"status\", \"--porcelain\", \"--\", str(path.relative_to(root))],\n        capture_output=True, text=True, check=False)\n    return path if status.stdout.strip() else None\n\n\ndef worker_holds_copy(root: Path, records_dir: Path) -> bool:\n    \"\"\"True when this checkout's own working tree cannot safely be moved\n    -- an invocation marker with no record yet (a worker, here or\n    elsewhere, still holds this attempt), or a build or verify record the\n    working tree carries that git has not committed yet. Scoped to the\n    stage records a pass or a worker itself ever transports -- an\n    operator's own spec-gate or approve, routinely uncommitted between\n    their own act and the next pass, is not this. A pass never\n    fast-forwards while this holds (never while a worker holds the\n    copy).\"\"\"\n    if invocations_without_record(records_dir):\n        return True\n    return (uncommitted_record(root, records_dir, \"build\") is not None\n           or uncommitted_record(root, records_dir, \"verify\") is not None)\n\n\ndef fast_forward_to_origin(root: Path, m: dict[str, Any], item_id: str) -> None:\n    \"\"\"The pass's own read of origin's branch, taken before it reads\n    anything else -- a commit landed there from elsewhere (an approval\n    from the screen, a ruling, another pass's own record) is not a race\n    for the lease, it is exactly what the lease is for. Never while a\n    worker holds this copy (worker_holds_copy): resetting a working tree\n    a detached child is still writing into would corrupt its own commits.\n    A plain fast-forward when origin is simply ahead; when this checkout\n    also carries its own commits origin has not seen yet (an operator's\n    approval, not yet pushed), those are replayed on top of origin's own\n    tip instead -- no merge commit, and the marker this pass is about to\n    write still lands as a fast-forward when it pushes. Silent about\n    everything short of that -- a real conflict, or an absent origin, is\n    left for the ordinary read (and the marker push, for the lease) to\n    sort out.\"\"\"\n    records_dir = root / m[\"paths\"][\"records\"] / item_id\n    if worker_holds_copy(root, records_dir) or not has_origin(root):\n        return\n    try:\n        branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n        git(root, \"fetch\", \"origin\", branch)\n    except RuntimeError:\n        return\n    try:\n        git(root, \"merge\", \"--ff-only\", \"FETCH_HEAD\")\n        return\n    except RuntimeError:\n        pass\n    try:\n        git(root, \"rebase\", \"FETCH_HEAD\")\n    except RuntimeError:\n        subprocess.run([\"git\", \"-C\", str(root), \"rebase\", \"--abort\"],\n                       capture_output=True, text=True, check=False)\n\n\n# --- the worker: a detached child of the pass's own session, running the\n# stage exactly as the pass used to inline, touching its own heartbeat\n# while it does (R2). ---\n\ndef _stage_body(item_id: str, stage: str, nn: int) -> int:\n    \"\"\"Runs build or verify in-process -- the same command `attavo build`\n    or `attavo verify` would run -- while touching heartbeat_path every\n    heartbeat_s() seconds, then transports whatever it wrote: counsel and\n    file-stops on a non-pass record (issue #100, #89), one `git commit\n    --only`, one push with the record push's own merge retry. The\n    marker is the pass's, already committed and pushed before this\n    starts; this writes and transports only the stage's own record (and,\n    on a stop, its counsel record).\"\"\"\n    root = Path(\".\").resolve()\n    m = read_manifest(root)\n    if m is None:\n        return 2\n    records_dir = root / m[\"paths\"][\"records\"] / item_id\n    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n    before = latest_attempt_path(records_dir, stage)\n\n    beat = heartbeat_path(root, stage, nn)\n    beat.parent.mkdir(parents=True, exist_ok=True)\n    beat.touch()\n    stop_beat = threading.Event()\n\n    def _tick() -> None:\n        while not stop_beat.wait(heartbeat_s()):\n            beat.touch()\n\n    beat_thread = threading.Thread(target=_tick, daemon=True)\n    beat_thread.start()\n    try:\n        rc = cmd_build([item_id]) if stage == \"build\" else cmd_verify([item_id])\n    finally:\n        stop_beat.set()\n        beat_thread.join()\n\n    after = latest_attempt_path(records_dir, stage)\n    if after is None or after == before:\n        # Refused before writing anything at all (e.g. no adapter\n        # configured) -- the stage command already printed why.\n        return rc if rc != 0 else 1\n\n    record = cast(dict[str, Any], latest_record(records_dir, stage))\n    status_out = record.get(\"status\")\n    to_commit = [after]\n    if status_out != \"pass\":\n        counsel_before = latest_attempt_path(records_dir, \"counsel\")\n        cmd_counsel([item_id])\n        counsel_after = latest_attempt_path(records_dir, \"counsel\")\n        if counsel_after is not None and counsel_after != counsel_before:\n            to_commit.append(counsel_after)\n        # file-stops is its own idempotent read of the item's records, so\n        # calling it here on every run that wrote a non-pass record is\n        # safe to call again on a later run: an already-filed stop's own\n        # marker is what stops it from being filed twice.\n        cmd_file_stops([item_id])\n\n    message = f\"attavo: {stage} record for item {item_id} ({after.stem})\"\n    try:\n        commit_record(root, to_commit, message)\n    except RuntimeError as exc:\n        print(f\"attavo drive: stopped: could not commit the {stage} record: {exc}\")\n        return 1\n\n    if has_origin(root):\n        ok, err = push_record_commit(root, branch)\n        if not ok:\n            print(f\"attavo drive: stopped: could not push the {stage} record: {err}\")\n            return 1\n    else:\n        print(f\"attavo drive: note: no origin remote; {after.name} is committed, not pushed\")\n\n    if status_out == \"halted\":\n        question = (record.get(\"halted\") or {}).get(\"question\")\n        print(f\"attavo drive: stopped: {stage} halted: {question} ({after.name}); \"\n              f\"pushed to {branch}\")\n    elif status_out != \"pass\":\n        reason = record.get(\"refusal\") or status_out\n        print(f\"attavo drive: stopped: {stage} {status_out}: {reason} ({after.name}); \"\n              f\"pushed to {branch}\")\n    else:\n        print(f\"attavo drive: pushed {after.name} to {branch}\")\n    return rc\n\n\ndef cmd_worker(argv: list[str]) -> int:\n    \"\"\"`attavo worker N <build|verify> NN`: the detached child a pass\n    starts once its marker is pushed -- the lease held, the attempt is\n    this worker's to run. Its own session (start_new_session, set by the\n    pass that spawns it); its stdout and stderr are the pass's own\n    redirect, to <git-dir>/attavo/<stage>-NN.worker.log.\"\"\"\n    cast(io.TextIOWrapper, sys.stdout).reconfigure(line_buffering=True)\n    if len(argv) != 3:\n        print(\"attavo worker: usage: attavo worker N <build|verify> NN\", file=sys.stderr)\n        return 2\n    item_id, stage, nn_text = argv\n    if stage not in (\"build\", \"verify\"):\n        print(f\"attavo worker: {stage!r} is not build or verify\", file=sys.stderr)\n        return 2\n    try:\n        nn = int(nn_text)\n    except ValueError:\n        print(f\"attavo worker: {nn_text!r} is not an attempt number\", file=sys.stderr)\n        return 2\n    return _stage_body(item_id, stage, nn)\n\n\n# --- the pass's own two acts: start a stage (the lease), and recover\n# exactly the one invocation the report names owed one. ---\n\ndef _start_stage(root: Path, m: dict[str, Any], item_id: str, stage: str,\n                 forge_checks: dict[str, Any] | None) -> int:\n    \"\"\"The lease (ruling A): the marker, committed and pushed as a plain\n    fast-forward with no merge and no retry (push_lease). Lost to another\n    pass, or refused outright by the remote, both undo the marker commit\n    here (git reset --hard) so this checkout carries no half-taken\n    attempt either way; only a pushed lease starts the worker. On a\n    review, forge_checks is the checks this same pass already read on\n    the pre-marker head (ruling B) -- written to\n    <git-dir>/attavo/verify-NN.forge-checks.json and named in\n    ATTAVO_FORGE_CHECKS, so the worker's own `attavo verify` reads it\n    instead of polling.\"\"\"\n    records_dir = root / m[\"paths\"][\"records\"] / item_id\n    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n    nn = next_attempt_number(records_dir, stage)\n    marker = write_invocation_marker(root, records_dir, stage, nn)\n    try:\n        commit_record(root, [marker], f\"attavo: {stage} invocation {nn:02d} started for item {item_id}\")\n    except RuntimeError as exc:\n        print(f\"attavo drive: stopped: could not commit the {stage} invocation marker: {exc}\")\n        return 1\n\n    if has_origin(root):\n        outcome, err = push_lease(root, branch)\n        if outcome != \"pushed\":\n            git(root, \"reset\", \"--hard\", \"HEAD^\")\n            if outcome == \"lost-race\":\n                print(f\"attavo drive: another pass holds this attempt ({marker.name}); nothing started\")\n                return 0\n            print(f\"attavo drive: stopped: could not push the {stage} invocation marker: {err}\")\n            return 1\n\n    env = dict(os.environ)\n    if forge_checks is not None:\n        checks_file = forge_checks_path(root, stage, nn)\n        checks_file.write_text(json.dumps(forge_checks))\n        env[\"ATTAVO_FORGE_CHECKS\"] = str(checks_file)\n    log = worker_log_path(root, stage, nn)\n    with log.open(\"ab\") as fh, open(os.devnull, \"rb\") as devnull:\n        proc = subprocess.Popen(\n            [sys.executable, str(PRODUCT_ROOT / \"bin\" / \"attavo\"), \"worker\", item_id, stage, f\"{nn:02d}\"],\n            cwd=str(root), env=env, stdin=devnull, stdout=fh, stderr=subprocess.STDOUT,\n            start_new_session=True)\n    word = \"Build\" if stage == \"build\" else \"Review\"\n    print(f\"attavo drive: {word} started (attempt {nn:02d}, worker pid {proc.pid})\")\n    return 0\n\n\ndef _recover_one(root: Path, m: dict[str, Any], item_id: str, records_dir: Path) -> int:\n    \"\"\"The pass's own recovery act (what `--recover` did): exactly the one\n    invocation the report just read as owing one -- died or hung -- ends\n    here. class died when the heartbeat is stale (or absent and the pid\n    is gone), class hung when there is no heartbeat, the pid lives, and a\n    declared [drive].stall_after_s has passed with no newer event, and\n    terminated. Provenance product; the events tail as the log. Committed\n    and pushed the way any stage record is (push_record_commit, with its\n    own merge retry) -- this is not a race for a lease, since no new\n    attempt marker is written.\"\"\"\n    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n    bound = stall_bound_s(m)\n    pending = invocations_without_record(records_dir)\n    readings = [(marker, info, read_invocation(root, bound, marker, info)) for marker, info in pending]\n    candidate = next(((mk, i, rd) for mk, i, rd in readings if rd.cls != \"running\"), None)\n    if candidate is None:\n        # The report read this a moment ago; nothing owed recovery by the\n        # time this pass got here (another pass recovered it, or it\n        # finished on its own).\n        return 0\n    marker, info, reading = candidate\n    stage, nn, log, last_at, age, cls, crossed = reading\n    pid, host = info.get(\"pid\"), info.get(\"host\")\n\n    if next_attempt_number(records_dir, stage) != nn:\n        print(f\"attavo drive: stopped: {marker.name} names attempt {nn} but the next \"\n              f\"{stage} record would be {next_attempt_number(records_dir, stage):02d}; \"\n              f\"a later record already exists, read the records before recovering\")\n        return 1\n\n    if cls == \"hung\":\n        try:\n            os.kill(cast(int, pid), signal.SIGTERM)\n            ended = \"terminated\"\n        except OSError as exc:\n            ended = f\"not terminated ({exc})\"\n        if crossed == \"ceiling\":\n            detail = (f\"pid {pid} on {host} alive {int(cast(float, age))} s after its marker, past the \"\n                      f\"{stage} ceiling of {ceiling_s(m, stage)} s; {ended}\")\n        else:\n            detail = (f\"pid {pid} on {host} alive with no event for {int(cast(float, age))} s \"\n                      f\"(bound {bound} s); {ended}\")\n    else:\n        detail = (f\"pid {pid} on {host} is not running and wrote no {marker.stem}.json; \"\n                  f\"started {info.get('at')}, last event {last_at or 'none'}\")\n\n    schema = stage_schema(stage)\n    record: dict[str, Any] = {k: None for k in schema.get(\"required\", [])}\n    approval = latest_record(records_dir, \"approval\")\n    record.update({\"sha\": info.get(\"sha\"), \"start_sha\": info.get(\"sha\"),\n                   \"approval_sha\": approval.get(\"sha\") if approval else None,\n                   \"at\": info.get(\"at\"),\n                   \"adapter\": (m.get(\"executor\") or {}).get(stage),\n                   \"status\": \"failed\", \"refusal\": None, \"halted\": None,\n                   \"retry_of\": None, \"steer\": None,\n                   \"stop\": {\"class\": cls, \"provenance\": \"product\", \"detail\": detail,\n                            \"signature\": signature_of(log.strip().splitlines()[-1] if log.strip() else detail),\n                            \"bound\": crossed}})\n    if \"wall_clock_s\" in record:\n        record[\"wall_clock_s\"] = None if age is None else int(age)\n    record = {k: v for k, v in record.items() if k in schema.get(\"properties\", {})}\n    try:\n        path = write_record(records_dir, stage, record, m, item_id, log=log)\n    except ValueError as exc:\n        print(f\"attavo drive: stopped: could not write the {cls} record for {marker.stem}: {exc}\")\n        return 1\n    try:\n        commit_record(root, [path], f\"attavo: {stage} record for item {item_id} \"\n                                    f\"({path.stem}), recovered as {cls}\")\n    except RuntimeError as exc:\n        print(f\"attavo drive: stopped: could not commit the {cls} record: {exc}\")\n        return 1\n    if has_origin(root):\n        ok, err = push_record_commit(root, branch)\n        if not ok:\n            print(f\"attavo drive: stopped: could not push the {cls} record: {err}\")\n            return 1\n    else:\n        print(f\"attavo drive: note: no origin remote; {path.name} is committed, not pushed\")\n    print(f\"attavo drive: recovered {marker.stem} as {cls}: {detail}\")\n    return 0\n\n\ndef _advance_again(root: Path, m: dict[str, Any], item_id: str, stage: str, head: str | None) -> int:\n    \"\"\"`--again`'s own act on a stopped stage: exactly what next-build or\n    next-review would do, bypassing the level a plain pass leaves alone\n    for the operator. A review reads the forge fresh here -- once, since\n    the report's own stopped reading never touched it -- rather than\n    reusing a read that was never taken.\"\"\"\n    if stage == \"build\":\n        return _start_stage(root, m, item_id, \"build\", None)\n    checks_command = (m.get(\"forge\") or {}).get(\"checks_command\")\n    if not checks_command:\n        print(\"attavo drive: refused: no [forge].checks_command in the manifest\")\n        return 1\n    forge_checks, ok = read_forge_checks(root, checks_command, cast(str, head))\n    if not ok:\n        conclusions = forge_checks[\"conclusions\"]\n        named = \", \".join(f\"{c['name']} {c['conclusion']}\" for c in conclusions) or \"no checks reported\"\n        print(f\"attavo drive: forge checks not green on {cast(str, head)[:12]}: {named}\")\n        return 0\n    return _start_stage(root, m, item_id, \"verify\", forge_checks)\n\n\ndef _retry_due(root: Path, m: dict[str, Any], item_id: str, r: \"DriveReport\") -> bool:\n    \"\"\"R3 (stub): a stopped stage whose class is retryable, whose budget is\n    not spent, whose last two signatures differ, and -- for transient --\n    whose record is older than retry_after_s, is retried by this pass.\"\"\"\n    if r[\"stop_class\"] not in RETRYABLE_CLASSES:\n        return False\n    records_dir = root / m[\"paths\"][\"records\"] / item_id\n    stage = \"build\" if r[\"stop_class\"] == \"returned\" else cast(str, r[\"stage\"])\n    spent = next_attempt_number(records_dir, stage) - 1\n    if spent >= attempts_budget(m):\n        return False\n    from attavo.records import parse_attempts\n    attempts = parse_attempts(records_dir, cast(str, r[\"stage\"]))\n    if len(attempts) >= 2:\n        last, prev = attempts[max(attempts)], attempts[sorted(attempts)[-2]]\n        sig_last = ((last.get(\"stop\") or {}).get(\"signature\"))\n        sig_prev = ((prev.get(\"stop\") or {}).get(\"signature\"))\n        if sig_last is not None and sig_last == sig_prev:\n            return False\n    if r[\"stop_class\"] == \"transient\":\n        rec = attempts[max(attempts)] if attempts else {}\n        age = _seconds_since(rec.get(\"at\"))\n        if age is not None and age < retry_after_s(m):\n            return False\n    return True\n\n\ndef _pass_once(root: Path, m: dict[str, Any], item_id: str, again: bool) -> tuple[int, \"DriveReport\"]:\n    \"\"\"One pass: fast-forward to origin (never while a worker holds the\n    copy), read the report, act at most once, return. The three acts,\n    one per report state that is the product's move: owes-recovery\n    recovers; next-build and next-review start their stage, handing a\n    review the checks the report already read once on the pre-marker\n    head. --again starts the next attempt of a stopped stage. Every\n    other level is printed in the report's own words and left.\"\"\"\n    from attavo.report import drive_report\n    fast_forward_to_origin(root, m, item_id)\n    r = drive_report(root, m, item_id)\n\n    if r[\"state\"] == \"owes-recovery\":\n        records_dir = root / m[\"paths\"][\"records\"] / item_id\n        return _recover_one(root, m, item_id, records_dir), r\n    if r[\"state\"] == \"next-build\":\n        return _start_stage(root, m, item_id, \"build\", None), r\n    if r[\"state\"] == \"next-review\":\n        checks_command = (m.get(\"forge\") or {}).get(\"checks_command\")\n        forge_checks = {\"command\": checks_command, \"sha\": r[\"head\"], \"conclusions\": r[\"checks\"] or []}\n        return _start_stage(root, m, item_id, \"verify\", forge_checks), r\n    if r[\"state\"] == \"stopped\" and r[\"stage\"] and _retry_due(root, m, item_id, r):\n        stage = \"build\" if r[\"stop_class\"] == \"returned\" else r[\"stage\"]\n        return _advance_again(root, m, item_id, stage, r[\"head\"]), r\n    if r[\"state\"] == \"blocked-on-checks\" and r[\"stage\"] == \"verify\":\n        # R3: a concluded red check on a passed build's head is a record,\n        # not a level -- the review returns it, and the next build is\n        # handed the evidence.\n        checks_command = (m.get(\"forge\") or {}).get(\"checks_command\")\n        forge_checks = {\"command\": checks_command, \"sha\": r[\"head\"], \"conclusions\": r[\"checks\"] or []}\n        return _start_stage(root, m, item_id, \"verify\", forge_checks), r\n    if again and r[\"state\"] == \"stopped\" and r[\"stage\"]:\n        return _advance_again(root, m, item_id, r[\"stage\"], r[\"head\"]), r\n\n    print(f\"attavo drive: {r['says']}\")\n    return (1 if r[\"state\"] == \"refused\" else 0), r\n\n\n_TERMINAL_STATES = (\"waiting-on-approval\", \"stopped\", \"ready-to-merge\", \"merged\")\n\n\ndef _until_ready(root: Path, m: dict[str, Any], item_id: str, again: bool) -> int:\n    \"\"\"--until-ready: the pass, repeated in one process, sleeping\n    ATTAVO_DRIVE_POLL_INTERVAL_S between passes, until the level is the\n    operator's or done (exit 0), a concluded check is red (exit 1), or\n    an unconcluded one has not concluded within ATTAVO_DRIVE_POLL_BOUND_S\n    (exit 1). A stage running in its own worker is not bounded by this --\n    only time spent waiting on the forge is.\"\"\"\n    from attavo.verify import drive_forge_poll_bound_s, drive_forge_poll_interval_s\n    bound = drive_forge_poll_bound_s()\n    interval = drive_forge_poll_interval_s()\n    waiting_since: float | None = None\n    while True:\n        rc, r = _pass_once(root, m, item_id, again)\n        state = r[\"state\"]\n\n        if state == \"waiting-on-checks\":\n            if waiting_since is None:\n                waiting_since = time.monotonic()\n            elif time.monotonic() - waiting_since >= bound:\n                print(f\"attavo drive: stopped: the checks did not conclude within {bound:.0f}s\")\n                return 1\n        else:\n            waiting_since = None\n\n        if rc != 0:\n            return rc\n        if state in _TERMINAL_STATES:\n            return 0\n        if state == \"blocked-on-checks\":\n            return 1\n        time.sleep(interval)\n\n\ndef _drive_all() -> int:\n    \"\"\"--all: one pass, in its own process, in every ../attavo-worktree-N\n    beside this checkout -- each one derives its own item from its own\n    attavo/N-* branch. Every line either prints is prefixed with the\n    worktree's own directory name, so an operator reading them together\n    can tell which item each line is about.\"\"\"\n    root = Path(\".\").resolve()\n    siblings = sorted(p for p in root.parent.glob(\"attavo-worktree-*\") if p.is_dir())\n    if not siblings:\n        print(\"attavo drive: --all found no ../attavo-worktree-N beside this checkout\")\n        return 0\n    worst = 0\n    for copy in siblings:\n        run = subprocess.run([sys.executable, str(PRODUCT_ROOT / \"bin\" / \"attavo\"), \"drive\"],\n                             cwd=str(copy), capture_output=True, text=True, check=False)\n        for line in (run.stdout + run.stderr).splitlines():\n            print(f\"{copy.name}: {line}\")\n        worst = max(worst, run.returncode)\n    return worst\n\n\ndef cmd_drive(argv: list[str]) -> int:\n    # Issue #145: Python block-buffers stdout when it is not a tty (a\n    # pipe, e.g. a screen reading this process live), so every line this\n    # prints would otherwise sit unflushed until the process exits.\n    # Line-buffering makes a pipe reader see each line the moment it is\n    # printed, the same as a terminal already does; `attavo worker`\n    # reconfigures its own stdout the same way.\n    cast(io.TextIOWrapper, sys.stdout).reconfigure(line_buffering=True)\n\n    if \"--recover\" in argv:\n        print(\"attavo drive: --recover is gone; a pass recovers a dead or hung invocation \"\n              \"itself, as soon as the report owes one\", file=sys.stderr)\n        return 2\n\n    until_ready = \"--until-ready\" in argv\n    report = \"--report\" in argv\n    again = \"--again\" in argv\n    all_flag = \"--all\" in argv\n    positional = [a for a in argv if not a.startswith(\"--\")]\n\n    if all_flag:\n        if until_ready or report or again or positional:\n            print(\"attavo drive: --all runs one pass in every worktree beside this checkout; \"\n                  \"drop N and every other flag\", file=sys.stderr)\n            return 2\n        return _drive_all()\n\n    root = Path(\".\").resolve()\n    item_id = positional[0] if positional else derive_item_id(root)\n    if not item_id:\n        print(\"attavo drive: cannot derive item id; pass N or run on an attavo/N-* branch\",\n              file=sys.stderr)\n        return 2\n    m = read_manifest(root)\n    if m is None:\n        print(f\"attavo drive: no {MANIFEST} at {root}\", file=sys.stderr)\n        return 2\n\n    if report:\n        if until_ready or again:\n            print(\"attavo drive: --report reads and does nothing else; drop --until-ready \"\n                  \"and --again\", file=sys.stderr)\n            return 2\n        fast_forward_to_origin(root, m, item_id)\n        from attavo.report import drive_report\n        print(json.dumps(drive_report(root, m, item_id), indent=2))\n        return 0\n\n    if until_ready:\n        return _until_ready(root, m, item_id, again)\n    rc, _ = _pass_once(root, m, item_id, again)\n    return rc\n","numLines":830,"startLine":1,"totalLines":830}}}

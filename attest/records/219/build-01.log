{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Kfhu5ZT8nKWy5z5w7Wdz9S","type":"tool_result","content":"1\t\"\"\"The reconciler's R2 (claude/reconciler-brief-2026-09-20.md, rulings A, B,\n2\tH): `attavo drive N` is one short pass that reads the report, acts at most\n3\tonce, and returns; a stage runs in a detached worker with its own\n4\theartbeat; the marker's push is the lease; recovery is the pass's; the\n5\treview takes the checks the pass read on the pre-marker head.\n6\t\n7\tRun: python3 -m pytest tests -q\n8\t\"\"\"\n9\tfrom __future__ import annotations\n10\t\n11\timport json\n12\timport os\n13\timport socket\n14\timport subprocess\n15\timport sys\n16\timport time\n17\tfrom pathlib import Path\n18\tfrom typing import Any\n19\t\n20\tfrom helpers import commit_all, git, make_tenant\n21\tfrom test_drive import (\n22\t    GREEN_FORGE,\n23\t    add_bare_remote,\n24\t    add_drive_stall_bound,\n25\t    add_forge,\n26\t    approve_item,\n27\t    head_of,\n28\t    latest_record,\n29\t    record_files,\n30\t    records_dir,\n31\t    remote_head,\n32\t    run_attavo,\n33\t    write_dead_marker,\n34\t)\n35\t\n36\tROOT = Path(__file__).resolve().parent.parent\n37\tFAST = {\"ATTAVO_HEARTBEAT_S\": \"0.2\", \"ATTAVO_DRIVE_POLL_INTERVAL_S\": \"0.5\"}\n38\t\n39\t\n40\tdef slow_adapter(root: Path, seconds: float) -> None:\n41\t    \"\"\"A tenant-side build adapter: the product's own fixture adapter,\n42\t    after `seconds` of sleep on the build stage.\"\"\"\n43\t    d = root / \"attavo\" / \"adapters\" / \"fixture\"\n44\t    d.mkdir(parents=True, exist_ok=True)\n45\t    run = d / \"run\"\n46\t    run.write_text(f'#!/bin/sh\\nif [ \"${{ATTAVO_STAGE:-build}}\" = build ]; then sleep {seconds}; fi\\n'\n47\t                   f'exec sh {ROOT / \"adapters\" / \"fixture\" / \"run\"}\\n')\n48\t    run.chmod(0o755)\n49\t    commit_all(root, \"a slow tenant-side adapter\")\n50\t\n51\t\n52\tdef git_dir(root: Path) -> Path:\n53\t    return Path(git(root, \"rev-parse\", \"--absolute-git-dir\").strip())\n54\t\n55\t\n56\tdef report(root: Path) -> dict[str, Any]:\n57\t    run = run_attavo(root, \"drive\", \"1\", \"--report\", env=FAST)\n58\t    assert run.returncode == 0, run.stdout + run.stderr\n59\t    out: dict[str, Any] = json.loads(run.stdout)\n60\t    return out\n61\t\n62\t\n63\tdef pushed(bare: Path, subject: str) -> bool:\n64\t    log = subprocess.run([\"git\", \"-C\", str(bare), \"log\", \"--format=%s\", \"main\"], capture_output=True, text=True).stdout\n65\t    return subject in log\n66\t\n67\t\n68\tdef wait_for(pred: Any, seconds: float = 20) -> None:\n69\t    deadline = time.monotonic() + seconds\n70\t    while time.monotonic() < deadline:\n71\t        if pred():\n72\t            return\n73\t        time.sleep(0.2)\n74\t    raise AssertionError(\"condition not met in time\")\n75\t\n76\t\n77\tdef built_tenant(tmp_path: Path, seconds: float = 3) -> tuple[Path, Path]:\n78\t    root = make_tenant(tmp_path, \"build_valid\")\n79\t    add_forge(root, GREEN_FORGE)\n80\t    add_drive_stall_bound(root)\n81\t    slow_adapter(root, seconds)\n82\t    bare = add_bare_remote(root, tmp_path)\n83\t    approve_item(root)\n84\t    return root, bare\n85\t\n86\t\n87\tdef test_a_pass_returns_while_the_worker_runs_and_the_worker_outlives_it(tmp_path: Path) -> None:\n88\t    root, bare = built_tenant(tmp_path, seconds=3)\n89\t    started = time.monotonic()\n90\t    run = run_attavo(root, \"drive\", \"1\", env=FAST)\n91\t    elapsed = time.monotonic() - started\n92\t    assert run.returncode == 0, run.stdout + run.stderr\n93\t    assert elapsed < 2.5, f\"the pass took {elapsed:.1f}s: it waited for the stage\"\n94\t    assert \"Build started\" in run.stdout, run.stdout\n95\t    assert (records_dir(root) / \"build-01.started\").exists()\n96\t    assert remote_head(bare, \"main\") == head_of(root), \"the marker was not pushed before the pass returned\"\n97\t    assert record_files(root, \"build\") == [], \"the record existed before the worker could have written it\"\n98\t    wait_for(lambda: record_files(root, \"build\") != [])\n99\t    wait_for(lambda: remote_head(bare, \"main\") == head_of(root))\n100\t    assert latest_record(root, \"build\")[\"status\"] == \"pass\"\n101\t\n102\t\n103\tdef test_the_worker_touches_its_heartbeat_and_the_report_reads_running_by_it(tmp_path: Path) -> None:\n104\t    root, _ = built_tenant(tmp_path, seconds=3)\n105\t    assert run_attavo(root, \"drive\", \"1\", env=FAST).returncode == 0\n106\t    beat = git_dir(root) / \"attavo\" / \"build-01.heartbeat\"\n107\t    wait_for(beat.exists, 5)\n108\t    first = beat.stat().st_mtime\n109\t    time.sleep(0.6)\n110\t    assert beat.stat().st_mtime > first, \"the heartbeat did not move\"\n111\t    r = report(root)\n112\t    assert (r[\"state\"], r[\"kind\"]) == (\"running\", \"waits\"), r\n113\t    wait_for(lambda: record_files(root, \"build\") != [])\n114\t\n115\t\n116\tdef test_a_stale_heartbeat_reads_died_though_the_pid_lives_and_a_fresh_one_reads_alive(tmp_path: Path) -> None:\n117\t    root = make_tenant(tmp_path, \"build_valid\")\n118\t    add_forge(root, GREEN_FORGE)\n119\t    add_drive_stall_bound(root, 600)\n120\t    approve_item(root)\n121\t    d = records_dir(root)\n122\t    d.mkdir(parents=True, exist_ok=True)\n123\t    marker = d / \"build-01.started\"\n124\t    now = time.strftime(\"%Y-%m-%dT%H:%M:%SZ\", time.gmtime())\n125\t    marker.write_text(json.dumps({\"at\": now, \"host\": socket.gethostname(),\n126\t                                  \"pid\": os.getpid(), \"sha\": head_of(root), \"product_version\": \"fixture\"}))\n127\t    commit_all(root, \"a marker whose pid is this test\")\n128\t    beat = git_dir(root) / \"attavo\" / \"build-01.heartbeat\"\n129\t    beat.parent.mkdir(parents=True, exist_ok=True)\n130\t    beat.touch()\n131\t    os.utime(beat, (time.time() - 60, time.time() - 60))\n132\t    r = report(root)\n133\t    assert (r[\"state\"], r[\"stop_class\"]) == (\"owes-recovery\", \"died\"), r\n134\t    beat.touch()\n135\t    r = report(root)\n136\t    assert r[\"state\"] == \"running\", r\n137\t\n138\t\n139\tdef test_two_passes_at_once_start_one_worker_and_the_loser_says_so(tmp_path: Path) -> None:\n140\t    root, bare = built_tenant(tmp_path, seconds=3)\n141\t    commit_all(root, \"the approval, so a second checkout carries it\")\n142\t    git(root, \"push\", \"-q\", \"origin\", \"HEAD:main\")\n143\t    clone = tmp_path / \"second\"\n144\t    git(root.parent, \"clone\", \"-q\", \"-b\", git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip(), str(bare), str(clone))\n145\t    git(clone, \"config\", \"user.email\", \"test@example.com\")\n146\t    git(clone, \"config\", \"user.name\", \"Attavo Test\")\n147\t    git(clone, \"remote\", \"set-head\", \"origin\", \"-a\")\n148\t    env = dict(os.environ)\n149\t    env.update(FAST)\n150\t    procs = [subprocess.Popen([sys.executable, str(ROOT / \"bin\" / \"attavo\"), \"drive\", \"1\"], cwd=str(c),\n151\t                              env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)\n152\t             for c in (root, clone)]\n153\t    outs = [p.communicate(timeout=30)[0] for p in procs]\n154\t    started = [o for o in outs if \"Build started\" in o]\n155\t    held = [o for o in outs if \"another pass holds\" in o]\n156\t    assert len(started) == 1 and len(held) == 1, outs\n157\t    log = subprocess.run([\"git\", \"-C\", str(bare), \"log\", \"--format=%s\", \"main\"], capture_output=True, text=True).stdout\n158\t    assert log.count(\"build invocation 01 started\") == 1, log\n159\t    wait_for(lambda: \"build record for item 1\" in subprocess.run(\n160\t        [\"git\", \"-C\", str(bare), \"log\", \"--format=%s\", \"main\"], capture_output=True, text=True).stdout)\n161\t\n162\t\n163\tdef test_a_pass_recovers_a_dead_invocation_and_recover_is_gone(tmp_path: Path) -> None:\n164\t    root = make_tenant(tmp_path, \"build_valid\")\n165\t    add_forge(root, GREEN_FORGE)\n166\t    add_drive_stall_bound(root)\n167\t    approve_item(root)\n168\t    write_dead_marker(root, \"build\", 1)\n169\t    gone = run_attavo(root, \"drive\", \"--recover\", \"1\", env=FAST)\n170\t    assert gone.returncode == 2 and \"gone\" in gone.stderr, gone.stdout + gone.stderr\n171\t    run = run_attavo(root, \"drive\", \"1\", env=FAST)\n172\t    assert run.returncode == 0, run.stdout + run.stderr\n173\t    rec = latest_record(root, \"build\")\n174\t    assert rec[\"stop\"][\"class\"] == \"died\", rec[\"stop\"]\n175\t\n176\t\n177\tdef test_the_review_takes_the_checks_the_pass_read_and_never_polls(tmp_path: Path) -> None:\n178\t    root = make_tenant(tmp_path, \"build_valid\")\n179\t    calls = tmp_path / \"forge-calls.txt\"\n180\t    forge = tmp_path / \"forge.sh\"\n181\t    forge.write_text(f'#!/bin/sh\\necho \"$1\" >> {calls}\\nprintf \"ci success\\\\n\"\\n')\n182\t    forge.chmod(0o755)\n183\t    add_forge(root, f\"sh {forge}\")\n184\t    add_drive_stall_bound(root)\n185\t    slow_adapter(root, 0)\n186\t    bare = add_bare_remote(root, tmp_path)\n187\t    approve_item(root)\n188\t    assert run_attavo(root, \"drive\", \"1\", env=FAST).returncode == 0\n189\t    wait_for(lambda: pushed(bare, \"build record for item 1\"))\n190\t    calls.write_text(\"\")\n191\t    pre_marker = head_of(root)\n192\t    run = run_attavo(root, \"drive\", \"1\", env=FAST)\n193\t    assert \"Review started\" in run.stdout, run.stdout + run.stderr\n194\t    wait_for(lambda: record_files(root, \"verify\") != [])\n195\t    rec = latest_record(root, \"verify\")\n196\t    assert rec[\"status\"] == \"pass\", rec\n197\t    assert rec[\"forge_checks\"][\"sha\"] == pre_marker, (rec[\"forge_checks\"], pre_marker)\n198\t    read_by = [l for l in calls.read_text().split() if l]\n199\t    assert read_by == [pre_marker], f\"the forge was read {len(read_by)} time(s) after the build: {read_by}\"\n200\t\n201\t\n202\tdef test_until_ready_is_a_loop_of_passes_that_returns_at_ready(tmp_path: Path) -> None:\n203\t    root, _ = built_tenant(tmp_path, seconds=0)\n204\t    run = run_attavo(root, \"drive\", \"1\", \"--until-ready\", env=FAST)\n205\t    assert run.returncode == 0, run.stdout + run.stderr\n206\t    assert \"Build started\" in run.stdout and \"Review started\" in run.stdout, run.stdout\n207\t    assert run.stdout.strip().endswith(\"Ready to merge\"), run.stdout\n208\t    assert report(root)[\"state\"] == \"ready-to-merge\"\n209\t\n210\t\n211\tdef test_a_stopped_stage_is_left_alone_by_a_pass_and_started_again_by_again(tmp_path: Path) -> None:\n212\t    root = make_tenant(tmp_path, \"build_valid\")\n213\t    add_forge(root, GREEN_FORGE)\n214\t    add_drive_stall_bound(root)\n215\t    approve_item(root)\n216\t    write_dead_marker(root, \"build\", 1)\n217\t    assert run_attavo(root, \"drive\", \"1\", env=FAST).returncode == 0\n218\t    assert latest_record(root, \"build\")[\"stop\"][\"class\"] == \"died\"\n219\t    plain = run_attavo(root, \"drive\", \"1\", env=FAST)\n220\t    assert plain.returncode == 0 and \"Needs you\" in plain.stdout, plain.stdout\n221\t    assert not (records_dir(root) / \"build-02.started\").exists()\n222\t    again = run_attavo(root, \"drive\", \"1\", \"--again\", env=FAST)\n223\t    assert \"Build started\" in again.stdout, again.stdout + again.stderr\n224\t    assert (records_dir(root) / \"build-02.started\").exists()\n225\t    wait_for(lambda: len(record_files(root, \"build\")) == 2)\n226\t\n227\t\n228\tdef test_all_runs_one_pass_in_every_working_copy_beside_the_checkout(tmp_path: Path) -> None:\n229\t    root = make_tenant(tmp_path, \"build_valid\", name=\"tenant\")\n230\t    add_forge(root, GREEN_FORGE)\n231\t    add_drive_stall_bound(root)\n232\t    slow_adapter(root, 0)\n233\t    bare = add_bare_remote(root, tmp_path)\n234\t    for n in (\"1\",):\n235\t        copy = tmp_path / f\"attavo-worktree-{n}\"\n236\t        git(root, \"worktree\", \"add\", \"-q\", \"-b\", f\"attavo/{n}-x\", str(copy), \"HEAD\")\n237\t        git(copy, \"config\", \"user.email\", \"test@example.com\")\n238\t        git(copy, \"config\", \"user.name\", \"Attavo Test\")\n239\t        approve_item(copy, n)\n240\t    run = run_attavo(root, \"drive\", \"--all\", env=FAST)\n241\t    assert run.returncode == 0, run.stdout + run.stderr\n242\t    assert \"attavo-worktree-1: attavo drive: Build started\" in run.stdout, run.stdout\n243\t    wait_for(lambda: record_files(tmp_path / \"attavo-worktree-1\", \"build\") != [])\n244\t"}]},"parent_tool_use_id":null,"session_id":"0dd7ed4f-100c-4188-9a34-077aa0b6aa25","uuid":"ff7c9bbe-79f0-4630-a1ec-8bb479b2cf25","timestamp":"2026-09-26T02:14:55.286Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-219/tests/test_pass.py","content":"\"\"\"The reconciler's R2 (claude/reconciler-brief-2026-09-20.md, rulings A, B,\nH): `attavo drive N` is one short pass that reads the report, acts at most\nonce, and returns; a stage runs in a detached worker with its own\nheartbeat; the marker's push is the lease; recovery is the pass's; the\nreview takes the checks the pass read on the pre-marker head.\n\nRun: python3 -m pytest tests -q\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport os\nimport socket\nimport subprocess\nimport sys\nimport time\nfrom pathlib import Path\nfrom typing import Any\n\nfrom helpers import commit_all, git, make_tenant\nfrom test_drive import (\n    GREEN_FORGE,\n    add_bare_remote,\n    add_drive_stall_bound,\n    add_forge,\n    approve_item,\n    head_of,\n    latest_record,\n    record_files,\n    records_dir,\n    remote_head,\n    run_attavo,\n    write_dead_marker,\n)\n\nROOT = Path(__file__).resolve().parent.parent\nFAST = {\"ATTAVO_HEARTBEAT_S\": \"0.2\", \"ATTAVO_DRIVE_POLL_INTERVAL_S\": \"0.5\"}\n\n\ndef slow_adapter(root: Path, seconds: float) -> None:\n    \"\"\"A tenant-side build adapter: the product's own fixture adapter,\n    after `seconds` of sleep on the build stage.\"\"\"\n    d = root / \"attavo\" / \"adapters\" / \"fixture\"\n    d.mkdir(parents=True, exist_ok=True)\n    run = d / \"run\"\n    run.write_text(f'#!/bin/sh\\nif [ \"${{ATTAVO_STAGE:-build}}\" = build ]; then sleep {seconds}; fi\\n'\n                   f'exec sh {ROOT / \"adapters\" / \"fixture\" / \"run\"}\\n')\n    run.chmod(0o755)\n    commit_all(root, \"a slow tenant-side adapter\")\n\n\ndef git_dir(root: Path) -> Path:\n    return Path(git(root, \"rev-parse\", \"--absolute-git-dir\").strip())\n\n\ndef report(root: Path) -> dict[str, Any]:\n    run = run_attavo(root, \"drive\", \"1\", \"--report\", env=FAST)\n    assert run.returncode == 0, run.stdout + run.stderr\n    out: dict[str, Any] = json.loads(run.stdout)\n    return out\n\n\ndef pushed(bare: Path, subject: str) -> bool:\n    log = subprocess.run([\"git\", \"-C\", str(bare), \"log\", \"--format=%s\", \"main\"], capture_output=True, text=True).stdout\n    return subject in log\n\n\ndef wait_for(pred: Any, seconds: float = 20) -> None:\n    deadline = time.monotonic() + seconds\n    while time.monotonic() < deadline:\n        if pred():\n            return\n        time.sleep(0.2)\n    raise AssertionError(\"condition not met in time\")\n\n\ndef built_tenant(tmp_path: Path, seconds: float = 3) -> tuple[Path, Path]:\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    add_drive_stall_bound(root)\n    slow_adapter(root, seconds)\n    bare = add_bare_remote(root, tmp_path)\n    approve_item(root)\n    return root, bare\n\n\ndef test_a_pass_returns_while_the_worker_runs_and_the_worker_outlives_it(tmp_path: Path) -> None:\n    root, bare = built_tenant(tmp_path, seconds=3)\n    started = time.monotonic()\n    run = run_attavo(root, \"drive\", \"1\", env=FAST)\n    elapsed = time.monotonic() - started\n    assert run.returncode == 0, run.stdout + run.stderr\n    assert elapsed < 2.5, f\"the pass took {elapsed:.1f}s: it waited for the stage\"\n    assert \"Build started\" in run.stdout, run.stdout\n    assert (records_dir(root) / \"build-01.started\").exists()\n    assert remote_head(bare, \"main\") == head_of(root), \"the marker was not pushed before the pass returned\"\n    assert record_files(root, \"build\") == [], \"the record existed before the worker could have written it\"\n    wait_for(lambda: record_files(root, \"build\") != [])\n    wait_for(lambda: remote_head(bare, \"main\") == head_of(root))\n    assert latest_record(root, \"build\")[\"status\"] == \"pass\"\n\n\ndef test_the_worker_touches_its_heartbeat_and_the_report_reads_running_by_it(tmp_path: Path) -> None:\n    root, _ = built_tenant(tmp_path, seconds=3)\n    assert run_attavo(root, \"drive\", \"1\", env=FAST).returncode == 0\n    beat = git_dir(root) / \"attavo\" / \"build-01.heartbeat\"\n    wait_for(beat.exists, 5)\n    first = beat.stat().st_mtime\n    time.sleep(0.6)\n    assert beat.stat().st_mtime > first, \"the heartbeat did not move\"\n    r = report(root)\n    assert (r[\"state\"], r[\"kind\"]) == (\"running\", \"waits\"), r\n    wait_for(lambda: record_files(root, \"build\") != [])\n\n\ndef test_a_stale_heartbeat_reads_died_though_the_pid_lives_and_a_fresh_one_reads_alive(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    add_drive_stall_bound(root, 600)\n    approve_item(root)\n    d = records_dir(root)\n    d.mkdir(parents=True, exist_ok=True)\n    marker = d / \"build-01.started\"\n    now = time.strftime(\"%Y-%m-%dT%H:%M:%SZ\", time.gmtime())\n    marker.write_text(json.dumps({\"at\": now, \"host\": socket.gethostname(),\n                                  \"pid\": os.getpid(), \"sha\": head_of(root), \"product_version\": \"fixture\"}))\n    commit_all(root, \"a marker whose pid is this test\")\n    beat = git_dir(root) / \"attavo\" / \"build-01.heartbeat\"\n    beat.parent.mkdir(parents=True, exist_ok=True)\n    beat.touch()\n    os.utime(beat, (time.time() - 60, time.time() - 60))\n    r = report(root)\n    assert (r[\"state\"], r[\"stop_class\"]) == (\"owes-recovery\", \"died\"), r\n    beat.touch()\n    r = report(root)\n    assert r[\"state\"] == \"running\", r\n\n\ndef test_two_passes_at_once_start_one_worker_and_the_loser_says_so(tmp_path: Path) -> None:\n    root, bare = built_tenant(tmp_path, seconds=3)\n    commit_all(root, \"the approval, so a second checkout carries it\")\n    git(root, \"push\", \"-q\", \"origin\", \"HEAD:main\")\n    clone = tmp_path / \"second\"\n    git(root.parent, \"clone\", \"-q\", \"-b\", git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip(), str(bare), str(clone))\n    git(clone, \"config\", \"user.email\", \"test@example.com\")\n    git(clone, \"config\", \"user.name\", \"Attavo Test\")\n    git(clone, \"remote\", \"set-head\", \"origin\", \"-a\")\n    env = dict(os.environ)\n    env.update(FAST)\n    procs = [subprocess.Popen([sys.executable, str(ROOT / \"bin\" / \"attavo\"), \"drive\", \"1\"], cwd=str(c),\n                              env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)\n             for c in (root, clone)]\n    outs = [p.communicate(timeout=30)[0] for p in procs]\n    started = [o for o in outs if \"Build started\" in o]\n    held = [o for o in outs if \"another pass holds\" in o]\n    assert len(started) == 1 and len(held) == 1, outs\n    log = subprocess.run([\"git\", \"-C\", str(bare), \"log\", \"--format=%s\", \"main\"], capture_output=True, text=True).stdout\n    assert log.count(\"build invocation 01 started\") == 1, log\n    wait_for(lambda: \"build record for item 1\" in subprocess.run(\n        [\"git\", \"-C\", str(bare), \"log\", \"--format=%s\", \"main\"], capture_output=True, text=True).stdout)\n\n\ndef test_a_pass_recovers_a_dead_invocation_and_recover_is_gone(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    add_drive_stall_bound(root)\n    approve_item(root)\n    write_dead_marker(root, \"build\", 1)\n    gone = run_attavo(root, \"drive\", \"--recover\", \"1\", env=FAST)\n    assert gone.returncode == 2 and \"gone\" in gone.stderr, gone.stdout + gone.stderr\n    run = run_attavo(root, \"drive\", \"1\", env=FAST)\n    assert run.returncode == 0, run.stdout + run.stderr\n    rec = latest_record(root, \"build\")\n    assert rec[\"stop\"][\"class\"] == \"died\", rec[\"stop\"]\n\n\ndef test_the_review_takes_the_checks_the_pass_read_and_never_polls(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"build_valid\")\n    calls = tmp_path / \"forge-calls.txt\"\n    forge = tmp_path / \"forge.sh\"\n    forge.write_text(f'#!/bin/sh\\necho \"$1\" >> {calls}\\nprintf \"ci success\\\\n\"\\n')\n    forge.chmod(0o755)\n    add_forge(root, f\"sh {forge}\")\n    add_drive_stall_bound(root)\n    slow_adapter(root, 0)\n    bare = add_bare_remote(root, tmp_path)\n    approve_item(root)\n    assert run_attavo(root, \"drive\", \"1\", env=FAST).returncode == 0\n    wait_for(lambda: pushed(bare, \"build record for item 1\"))\n    calls.write_text(\"\")\n    pre_marker = head_of(root)\n    run = run_attavo(root, \"drive\", \"1\", env=FAST)\n    assert \"Review started\" in run.stdout, run.stdout + run.stderr\n    wait_for(lambda: record_files(root, \"verify\") != [])\n    rec = latest_record(root, \"verify\")\n    assert rec[\"status\"] == \"pass\", rec\n    assert rec[\"forge_checks\"][\"sha\"] == pre_marker, (rec[\"forge_checks\"], pre_marker)\n    read_by = [l for l in calls.read_text().split() if l]\n    assert read_by == [pre_marker], f\"the forge was read {len(read_by)} time(s) after the build: {read_by}\"\n\n\ndef test_until_ready_is_a_loop_of_passes_that_returns_at_ready(tmp_path: Path) -> None:\n    root, _ = built_tenant(tmp_path, seconds=0)\n    run = run_attavo(root, \"drive\", \"1\", \"--until-ready\", env=FAST)\n    assert run.returncode == 0, run.stdout + run.stderr\n    assert \"Build started\" in run.stdout and \"Review started\" in run.stdout, run.stdout\n    assert run.stdout.strip().endswith(\"Ready to merge\"), run.stdout\n    assert report(root)[\"state\"] == \"ready-to-merge\"\n\n\ndef test_a_stopped_stage_is_left_alone_by_a_pass_and_started_again_by_again(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    add_drive_stall_bound(root)\n    approve_item(root)\n    write_dead_marker(root, \"build\", 1)\n    assert run_attavo(root, \"drive\", \"1\", env=FAST).returncode == 0\n    assert latest_record(root, \"build\")[\"stop\"][\"class\"] == \"died\"\n    plain = run_attavo(root, \"drive\", \"1\", env=FAST)\n    assert plain.returncode == 0 and \"Needs you\" in plain.stdout, plain.stdout\n    assert not (records_dir(root) / \"build-02.started\").exists()\n    again = run_attavo(root, \"drive\", \"1\", \"--again\", env=FAST)\n    assert \"Build started\" in again.stdout, again.stdout + again.stderr\n    assert (records_dir(root) / \"build-02.started\").exists()\n    wait_for(lambda: len(record_files(root, \"build\")) == 2)\n\n\ndef test_all_runs_one_pass_in_every_working_copy_beside_the_checkout(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"build_valid\", name=\"tenant\")\n    add_forge(root, GREEN_FORGE)\n    add_drive_stall_bound(root)\n    slow_adapter(root, 0)\n    bare = add_bare_remote(root, tmp_path)\n    for n in (\"1\",):\n        copy = tmp_path / f\"attavo-worktree-{n}\"\n        git(root, \"worktree\", \"add\", \"-q\", \"-b\", f\"attavo/{n}-x\", str(copy), \"HEAD\")\n        git(copy, \"config\", \"user.email\", \"test@example.com\")\n        git(copy, \"config\", \"user.name\", \"Attavo Test\")\n        approve_item(copy, n)\n    run = run_attavo(root, \"drive\", \"--all\", env=FAST)\n    assert run.returncode == 0, run.stdout + run.stderr\n    assert \"attavo-worktree-1: attavo drive: Build started\" in run.stdout, run.stdout\n    wait_for(lambda: record_files(tmp_path / \"attavo-worktree-1\", \"build\") != [])\n","numLines":244,"startLine":1,"totalLines":244}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RNwV9bNVqJtExovzENJ89D","type":"tool_result","content":"545\t            [sys.executable, str(PRODUCT_ROOT / \"bin\" / \"attavo\"), \"worker\", item_id, stage, f\"{nn:02d}\"],\n546\t            cwd=str(root), env=env, stdin=devnull, stdout=fh, stderr=subprocess.STDOUT,\n547\t            start_new_session=True)\n548\t    word = \"Build\" if stage == \"build\" else \"Review\"\n549\t    print(f\"attavo drive: {word} started (attempt {nn:02d}, worker pid {proc.pid})\")\n550\t    return 0\n551\t\n552\t\n553\tdef _recover_one(root: Path, m: dict[str, Any], item_id: str, records_dir: Path) -> int:\n554\t    \"\"\"The pass's own recovery act (what `--recover` did): exactly the one\n555\t    invocation the report just read as owing one -- died or hung -- ends\n556\t    here. class died when the heartbeat is stale (or absent and the pid\n557\t    is gone), class hung when there is no heartbeat, the pid lives, and a\n558\t    declared [drive].stall_after_s has passed with no newer event, and\n559\t    terminated. Provenance product; the events tail as the log. Committed\n560\t    and pushed the way any stage record is (push_record_commit, with its\n561\t    own merge retry) -- this is not a race for a lease, since no new\n562\t    attempt marker is written.\"\"\"\n563\t    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n564\t    bound = stall_bound_s(m)\n565\t    pending = invocations_without_record(records_dir)\n566\t    readings = [(marker, info, read_invocation(root, bound, marker, info)) for marker, info in pending]\n567\t    candidate = next(((mk, i, rd) for mk, i, rd in readings if rd.cls != \"running\"), None)\n568\t    if candidate is None:\n569\t        # The report read this a moment ago; nothing owed recovery by the\n570\t        # time this pass got here (another pass recovered it, or it\n571\t        # finished on its own).\n572\t        return 0\n573\t    marker, info, reading = candidate\n574\t    stage, nn, log, last_at, age, cls = reading\n575\t    pid, host = info.get(\"pid\"), info.get(\"host\")\n576\t\n577\t    if next_attempt_number(records_dir, stage) != nn:\n578\t        print(f\"attavo drive: stopped: {marker.name} names attempt {nn} but the next \"\n579\t              f\"{stage} record would be {next_attempt_number(records_dir, stage):02d}; \"\n580\t              f\"a later record already exists, read the records before recovering\")\n581\t        return 1\n582\t\n583\t    if cls == \"hung\":\n584\t        try:\n585\t            os.kill(cast(int, pid), signal.SIGTERM)\n586\t            ended = \"terminated\"\n587\t        except OSError as exc:\n588\t            ended = f\"not terminated ({exc})\"\n589\t        detail = (f\"pid {pid} on {host} alive with no event for {int(cast(float, age))} s \"\n590\t                  f\"(bound {bound} s); {ended}\")\n591\t    else:\n592\t        detail = (f\"pid {pid} on {host} is not running and wrote no {marker.stem}.json; \"\n593\t                  f\"started {info.get('at')}, last event {last_at or 'none'}\")\n594\t\n595\t    schema = stage_schema(stage)\n596\t    record: dict[str, Any] = {k: None for k in schema.get(\"required\", [])}\n597\t    approval = latest_record(records_dir, \"approval\")\n598\t    record.update({\"sha\": info.get(\"sha\"), \"start_sha\": info.get(\"sha\"),\n599\t                   \"approval_sha\": approval.get(\"sha\") if approval else None,\n600\t                   \"at\": info.get(\"at\"),\n601\t                   \"adapter\": (m.get(\"executor\") or {}).get(stage),\n602\t                   \"status\": \"failed\", \"refusal\": None, \"halted\": None,\n603\t                   \"stop\": {\"class\": cls, \"provenance\": \"product\", \"detail\": detail}})\n604\t    if \"wall_clock_s\" in record:\n605\t        record[\"wall_clock_s\"] = None if age is None else int(age)\n606\t    record = {k: v for k, v in record.items() if k in schema.get(\"properties\", {})}\n607\t    try:\n608\t        path = write_record(records_dir, stage, record, m, item_id, log=log)\n609\t    except ValueError as exc:"}]},"parent_tool_use_id":null,"session_id":"0dd7ed4f-100c-4188-9a34-077aa0b6aa25","uuid":"b42aa907-f457-480f-b4c4-8f16f1185f99","timestamp":"2026-09-26T02:26:29.823Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-219/attavo/drive.py","content":"            [sys.executable, str(PRODUCT_ROOT / \"bin\" / \"attavo\"), \"worker\", item_id, stage, f\"{nn:02d}\"],\n            cwd=str(root), env=env, stdin=devnull, stdout=fh, stderr=subprocess.STDOUT,\n            start_new_session=True)\n    word = \"Build\" if stage == \"build\" else \"Review\"\n    print(f\"attavo drive: {word} started (attempt {nn:02d}, worker pid {proc.pid})\")\n    return 0\n\n\ndef _recover_one(root: Path, m: dict[str, Any], item_id: str, records_dir: Path) -> int:\n    \"\"\"The pass's own recovery act (what `--recover` did): exactly the one\n    invocation the report just read as owing one -- died or hung -- ends\n    here. class died when the heartbeat is stale (or absent and the pid\n    is gone), class hung when there is no heartbeat, the pid lives, and a\n    declared [drive].stall_after_s has passed with no newer event, and\n    terminated. Provenance product; the events tail as the log. Committed\n    and pushed the way any stage record is (push_record_commit, with its\n    own merge retry) -- this is not a race for a lease, since no new\n    attempt marker is written.\"\"\"\n    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n    bound = stall_bound_s(m)\n    pending = invocations_without_record(records_dir)\n    readings = [(marker, info, read_invocation(root, bound, marker, info)) for marker, info in pending]\n    candidate = next(((mk, i, rd) for mk, i, rd in readings if rd.cls != \"running\"), None)\n    if candidate is None:\n        # The report read this a moment ago; nothing owed recovery by the\n        # time this pass got here (another pass recovered it, or it\n        # finished on its own).\n        return 0\n    marker, info, reading = candidate\n    stage, nn, log, last_at, age, cls = reading\n    pid, host = info.get(\"pid\"), info.get(\"host\")\n\n    if next_attempt_number(records_dir, stage) != nn:\n        print(f\"attavo drive: stopped: {marker.name} names attempt {nn} but the next \"\n              f\"{stage} record would be {next_attempt_number(records_dir, stage):02d}; \"\n              f\"a later record already exists, read the records before recovering\")\n        return 1\n\n    if cls == \"hung\":\n        try:\n            os.kill(cast(int, pid), signal.SIGTERM)\n            ended = \"terminated\"\n        except OSError as exc:\n            ended = f\"not terminated ({exc})\"\n        detail = (f\"pid {pid} on {host} alive with no event for {int(cast(float, age))} s \"\n                  f\"(bound {bound} s); {ended}\")\n    else:\n        detail = (f\"pid {pid} on {host} is not running and wrote no {marker.stem}.json; \"\n                  f\"started {info.get('at')}, last event {last_at or 'none'}\")\n\n    schema = stage_schema(stage)\n    record: dict[str, Any] = {k: None for k in schema.get(\"required\", [])}\n    approval = latest_record(records_dir, \"approval\")\n    record.update({\"sha\": info.get(\"sha\"), \"start_sha\": info.get(\"sha\"),\n                   \"approval_sha\": approval.get(\"sha\") if approval else None,\n                   \"at\": info.get(\"at\"),\n                   \"adapter\": (m.get(\"executor\") or {}).get(stage),\n                   \"status\": \"failed\", \"refusal\": None, \"halted\": None,\n                   \"stop\": {\"class\": cls, \"provenance\": \"product\", \"detail\": detail}})\n    if \"wall_clock_s\" in record:\n        record[\"wall_clock_s\"] = None if age is None else int(age)\n    record = {k: v for k, v in record.items() if k in schema.get(\"properties\", {})}\n    try:\n        path = write_record(records_dir, stage, record, m, item_id, log=log)\n    except ValueError as exc:","numLines":65,"startLine":545,"totalLines":787}}}

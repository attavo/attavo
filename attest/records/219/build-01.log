{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MS7QmfgASwWHheSx1f8F9H","type":"tool_result","content":"280\t    assert rec[\"commits\"] == [post_head]  # named, not silently kept\n281\t\n282\t\n283\tdef test_verify_records_a_silently_failing_adapter_without_being_refused(tmp_path: Path) -> None:\n284\t    \"\"\"Issue #53, rejection test 4. Same guarantee as build's: an adapter\n285\t    invoked during verify that exits non-zero with nothing on stdout or\n286\t    stderr must not leave a failed record with an empty log and no trail\n287\t    -- cmd_verify puts the adapter's exit status into the log before the\n288\t    write, so the write is not refused.\n289\t    \"\"\"\n290\t    root = make_tenant(tmp_path, \"build_valid\")\n291\t    add_forge(root, GREEN_FORGE)\n292\t    approve_item(root)\n293\t    assert run_attavo(root, \"build\", \"1\").returncode == 0\n294\t\n295\t    adapter_dir = root / \"attavo\" / \"adapters\" / \"silent\"\n296\t    adapter_dir.mkdir(parents=True)\n297\t    adapter_run = adapter_dir / \"run\"\n298\t    adapter_run.write_text(\"#!/bin/sh\\nexit 1\\n\")\n299\t    adapter_run.chmod(0o755)\n300\t    toml = root / \"attavo.toml\"\n301\t    toml.write_text(toml.read_text().replace(\n302\t        '[executor]\\nbuild = \"fixture\"', '[executor]\\nbuild = \"fixture\"\\nverify = \"silent\"'))\n303\t    commit_all(root, \"use a silently failing verify adapter\")\n304\t\n305\t    run = run_attavo(root, \"verify\", \"1\")\n306\t    assert run.returncode == 1\n307\t\n308\t    rec = latest_verify(root)\n309\t    assert rec[\"status\"] == \"failed\"\n310\t\n311\t    log = (root / \"records\" / \"1\" / \"verify-01.log\").read_text()\n312\t    assert log.strip() != \"\"\n313\t    assert \"1\" in log  # the exit status, so the record explains itself\n314\t\n315\t\n316\tdef test_verify_ceiling_error_line_carries_ceiling_stop(tmp_path: Path) -> None:\n317\t    \"\"\"Issue #89, rejection test 3: an adapter exit with a tool error line\n318\t    matching a declared ceiling is ceiling/product -- issue #86's own\n319\t    specimen, codex's \"input_too_large\" on a diff too large to judge.\"\"\"\n320\t    root = make_tenant(tmp_path, \"build_valid\")\n321\t    add_forge(root, GREEN_FORGE)\n322\t    approve_item(root)\n323\t    assert run_attavo(root, \"build\", \"1\").returncode == 0\n324\t\n325\t    run = run_attavo(root, \"verify\", \"1\", env={\"ATTAVO_FIXTURE_CEILING_ERROR\": \"1\"})\n326\t    assert run.returncode == 1\n327\t\n328\t    rec = latest_verify(root)\n329\t    assert rec[\"status\"] == \"failed\"\n330\t    assert rec[\"stop\"] == {\"class\": \"ceiling\", \"provenance\": \"product\", \"detail\": None}\n331\t    log = latest_verify_log(root)\n332\t    assert \"input_too_large\" in log\n333\t\n334\t\n335\tdef test_verify_records_the_tools_own_error_line_on_a_nonzero_exit(tmp_path: Path) -> None:\n336\t    \"\"\"Issue #86, rejection test 3. Specimen: tenant zero\n337\t    attest/records/659/verify-01.log -- two lines, thread.started and\n338\t    \"[adapter exited 1]\", though the codex adapter printed codex's own\n339\t    \"Input exceeds...\" error line to its stdout, which issue #53's fix\n340\t    was supposed to guarantee reaches the log. The mechanism:\n341\t    split_adapter_stdout takes the adapter's last non-empty stdout line\n342\t    as an attempted JSON payload and treats only what comes before it as\n343\t    transcript; on a non-zero exit, a tool's own error line, printed\n344\t    last, is that attempted payload -- it fails to parse as JSON and is\n345\t    dropped from the transcript instead of kept in it. An adapter that\n346\t    prints an event line, then an error line, then exits 1: the log\n347\t    must still carry the error line.\n348\t    \"\"\"\n349\t    root = make_tenant(tmp_path, \"build_valid\")\n350\t    add_forge(root, GREEN_FORGE)\n351\t    approve_item(root)\n352\t    assert run_attavo(root, \"build\", \"1\").returncode == 0\n353\t\n354\t    adapter_dir = root / \"attavo\" / \"adapters\" / \"loud\"\n355\t    adapter_dir.mkdir(parents=True)\n356\t    adapter_run = adapter_dir / \"run\"\n357\t    adapter_run.write_text(\n358\t        \"#!/bin/sh\\n\"\n359\t        \"echo '{\\\"type\\\":\\\"thread.started\\\"}'\\n\"\n360\t        \"echo 'Error: turn/start failed: input_too_large'\\n\"\n361\t        \"exit 1\\n\")\n362\t    adapter_run.chmod(0o755)\n363\t    toml = root / \"attavo.toml\"\n364\t    toml.write_text(toml.read_text().replace(\n365\t        '[executor]\\nbuild = \"fixture\"', '[executor]\\nbuild = \"fixture\"\\nverify = \"loud\"'))\n366\t    commit_all(root, \"use a verify adapter that errors loudly on stdout\")\n367\t\n368\t    run = run_attavo(root, \"verify\", \"1\")\n369\t    assert run.returncode == 1\n370\t\n371\t    log = (root / \"records\" / \"1\" / \"verify-01.log\").read_text()\n372\t    assert \"input_too_large\" in log\n373\t\n374\t\n375\t# --- issue #52: the diff handed to the adapter is the item's own work,\n376\t# not everything merged onto the branch since approval ---\n377\t#\n378\t# The issue's own proposed fix -- a three-dot diff against approval_sha,\n379\t# i.e. `git diff $(git merge-base approval_sha HEAD) HEAD` -- turns out"}]},"parent_tool_use_id":null,"session_id":"0dd7ed4f-100c-4188-9a34-077aa0b6aa25","uuid":"3c668e41-61ad-44ec-b5b7-b04e632f6957","timestamp":"2026-09-26T02:23:22.730Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-219/tests/test_verify.py","content":"    assert rec[\"commits\"] == [post_head]  # named, not silently kept\n\n\ndef test_verify_records_a_silently_failing_adapter_without_being_refused(tmp_path: Path) -> None:\n    \"\"\"Issue #53, rejection test 4. Same guarantee as build's: an adapter\n    invoked during verify that exits non-zero with nothing on stdout or\n    stderr must not leave a failed record with an empty log and no trail\n    -- cmd_verify puts the adapter's exit status into the log before the\n    write, so the write is not refused.\n    \"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    approve_item(root)\n    assert run_attavo(root, \"build\", \"1\").returncode == 0\n\n    adapter_dir = root / \"attavo\" / \"adapters\" / \"silent\"\n    adapter_dir.mkdir(parents=True)\n    adapter_run = adapter_dir / \"run\"\n    adapter_run.write_text(\"#!/bin/sh\\nexit 1\\n\")\n    adapter_run.chmod(0o755)\n    toml = root / \"attavo.toml\"\n    toml.write_text(toml.read_text().replace(\n        '[executor]\\nbuild = \"fixture\"', '[executor]\\nbuild = \"fixture\"\\nverify = \"silent\"'))\n    commit_all(root, \"use a silently failing verify adapter\")\n\n    run = run_attavo(root, \"verify\", \"1\")\n    assert run.returncode == 1\n\n    rec = latest_verify(root)\n    assert rec[\"status\"] == \"failed\"\n\n    log = (root / \"records\" / \"1\" / \"verify-01.log\").read_text()\n    assert log.strip() != \"\"\n    assert \"1\" in log  # the exit status, so the record explains itself\n\n\ndef test_verify_ceiling_error_line_carries_ceiling_stop(tmp_path: Path) -> None:\n    \"\"\"Issue #89, rejection test 3: an adapter exit with a tool error line\n    matching a declared ceiling is ceiling/product -- issue #86's own\n    specimen, codex's \"input_too_large\" on a diff too large to judge.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    approve_item(root)\n    assert run_attavo(root, \"build\", \"1\").returncode == 0\n\n    run = run_attavo(root, \"verify\", \"1\", env={\"ATTAVO_FIXTURE_CEILING_ERROR\": \"1\"})\n    assert run.returncode == 1\n\n    rec = latest_verify(root)\n    assert rec[\"status\"] == \"failed\"\n    assert rec[\"stop\"] == {\"class\": \"ceiling\", \"provenance\": \"product\", \"detail\": None}\n    log = latest_verify_log(root)\n    assert \"input_too_large\" in log\n\n\ndef test_verify_records_the_tools_own_error_line_on_a_nonzero_exit(tmp_path: Path) -> None:\n    \"\"\"Issue #86, rejection test 3. Specimen: tenant zero\n    attest/records/659/verify-01.log -- two lines, thread.started and\n    \"[adapter exited 1]\", though the codex adapter printed codex's own\n    \"Input exceeds...\" error line to its stdout, which issue #53's fix\n    was supposed to guarantee reaches the log. The mechanism:\n    split_adapter_stdout takes the adapter's last non-empty stdout line\n    as an attempted JSON payload and treats only what comes before it as\n    transcript; on a non-zero exit, a tool's own error line, printed\n    last, is that attempted payload -- it fails to parse as JSON and is\n    dropped from the transcript instead of kept in it. An adapter that\n    prints an event line, then an error line, then exits 1: the log\n    must still carry the error line.\n    \"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    approve_item(root)\n    assert run_attavo(root, \"build\", \"1\").returncode == 0\n\n    adapter_dir = root / \"attavo\" / \"adapters\" / \"loud\"\n    adapter_dir.mkdir(parents=True)\n    adapter_run = adapter_dir / \"run\"\n    adapter_run.write_text(\n        \"#!/bin/sh\\n\"\n        \"echo '{\\\"type\\\":\\\"thread.started\\\"}'\\n\"\n        \"echo 'Error: turn/start failed: input_too_large'\\n\"\n        \"exit 1\\n\")\n    adapter_run.chmod(0o755)\n    toml = root / \"attavo.toml\"\n    toml.write_text(toml.read_text().replace(\n        '[executor]\\nbuild = \"fixture\"', '[executor]\\nbuild = \"fixture\"\\nverify = \"loud\"'))\n    commit_all(root, \"use a verify adapter that errors loudly on stdout\")\n\n    run = run_attavo(root, \"verify\", \"1\")\n    assert run.returncode == 1\n\n    log = (root / \"records\" / \"1\" / \"verify-01.log\").read_text()\n    assert \"input_too_large\" in log\n\n\n# --- issue #52: the diff handed to the adapter is the item's own work,\n# not everything merged onto the branch since approval ---\n#\n# The issue's own proposed fix -- a three-dot diff against approval_sha,\n# i.e. `git diff $(git merge-base approval_sha HEAD) HEAD` -- turns out","numLines":100,"startLine":280,"totalLines":508}}}

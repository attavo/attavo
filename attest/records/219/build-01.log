{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LXTaJEHkxpqyDTSpgMbtaZ","type":"tool_result","content":"1\tfrom __future__ import annotations\n2\t\n3\timport json\n4\timport os\n5\timport shlex\n6\timport subprocess\n7\timport sys\n8\timport tempfile\n9\timport time\n10\tfrom pathlib import Path\n11\tfrom typing import Any, cast\n12\t\n13\tfrom attavo.build import (\n14\t    adapter_reports,\n15\t    merge_adapter_config,\n16\t    resolve_adapter,\n17\t    split_adapter_stdout,\n18\t)\n19\tfrom attavo.common import MANIFEST, PRODUCT_ROOT, derive_item_id, git, now_iso, read_manifest\n20\tfrom attavo.records import latest_attempt_path, latest_record, write_record\n21\tfrom attavo.types import SpecRecord, StageRecord\n22\tfrom attavo.verify import diff_since_approval, read_forge_checks\n23\t\n24\t# --- counsel: a stop is read inside the product first, before a person\n25\t# (issue #100). Read-only -- it commits nothing and writes nothing outside\n26\t# paths.records/<N>/ -- and it never acts: it proposes a ruling, a patch,\n27\t# or names the one-line question a person must answer. ---\n28\t\n29\tCOUNSEL_STAGES = (\"build\", \"verify\")\n30\t\n31\t\n32\tdef latest_non_pass_stage_record(records_dir: Path) -> tuple[str | None, StageRecord | None, Path | None]:\n33\t    \"\"\"(stage, record, path) for the item's most recent non-pass build or\n34\t    verify record, by its own \"at\" timestamp -- or, when neither stage\n35\t    carries one, the item's latest refused spec-gate record (issue #133):\n36\t    a refused gate is the same shape of stop, earlier, and it is read only\n37\t    once a build or verify record exists to counsel first, since either\n38\t    one already implies the gate that produced it passed. (None, None,\n39\t    None) when none of the three exists. \"Most recent\" rather than\n40\t    \"build, else verify\" so a stop on the stage that ran later (typically\n41\t    verify, bound to a build that already passed) is the one counseled.\"\"\"\n42\t    candidates: list[tuple[str, StageRecord, Path]] = []\n43\t    for stage in COUNSEL_STAGES:\n44\t        path = latest_attempt_path(records_dir, stage)\n45\t        if path is None:\n46\t            continue\n47\t        # A path exists, so the record read from the same files does too.\n48\t        rec = cast(StageRecord, latest_record(records_dir, stage))\n49\t        if rec.get(\"status\") == \"pass\":\n50\t            continue\n51\t        candidates.append((stage, rec, path))\n52\t    if candidates:\n53\t        candidates.sort(key=lambda c: c[1].get(\"at\") or \"\")\n54\t        return candidates[-1]\n55\t    spec_path = latest_attempt_path(records_dir, \"spec\")\n56\t    if spec_path is not None:\n57\t        spec_rec = cast(SpecRecord, latest_record(records_dir, \"spec\"))\n58\t        if spec_rec.get(\"status\") == \"refused\":\n59\t            return \"spec\", spec_rec, spec_path\n60\t    return None, None, None\n61\t\n62\t\n63\tdef latest_stage_record(records_dir: Path) -> tuple[str | None, StageRecord | None, Path | None]:\n64\t    \"\"\"(stage, record, path) for the item's most recent build or verify\n65\t    record regardless of status, by its own \"at\" timestamp -- or, when\n66\t    neither stage carries one, the item's latest spec-gate record,\n67\t    regardless of status. The evidence set `attavo counsel --ask` reads\n68\t    over (issue #175): a question is not bound to a stop, so the pass\n69\t    filter latest_non_pass_stage_record applies does not apply here.\n70\t    (None, None, None) when the item carries no record of any of the\n71\t    three stages yet.\"\"\"\n72\t    candidates: list[tuple[str, StageRecord, Path]] = []\n73\t    for stage in COUNSEL_STAGES:\n74\t        path = latest_attempt_path(records_dir, stage)\n75\t        if path is None:\n76\t            continue\n77\t        candidates.append((stage, cast(StageRecord, latest_record(records_dir, stage)), path))\n78\t    if candidates:\n79\t        candidates.sort(key=lambda c: c[1].get(\"at\") or \"\")\n80\t        return candidates[-1]\n81\t    spec_path = latest_attempt_path(records_dir, \"spec\")\n82\t    if spec_path is not None:\n83\t        return \"spec\", cast(SpecRecord, latest_record(records_dir, \"spec\")), spec_path\n84\t    return None, None, None\n85\t\n86\t\n87\tdef counsel_forge_evidence(root: Path, forge_cfg: dict[str, Any], sha: str | None, tmp: Path\n88\t                          ) -> tuple[dict[str, Any], Path]:\n89\t    \"\"\"(forge, checks_path) -- issue #175. forge is the summary counsel's\n90\t    own record carries: {\"read\", \"reason\", \"checks\"}, \"checks\" a list of\n91\t    {\"name\", \"conclusion\"} pairs. checks_path is always written, under\n92\t    tmp, as ATTAVO_COUNSEL_CHECKS: a JSON {\"read\", \"reason\", \"checks\"}\n93\t    envelope whose own \"checks\" carry the richer {\"name\", \"conclusion\",\n94\t    \"run_url\", \"log\"} shape the adapter reads -- \"log\" naming a sibling\n95\t    file under tmp with that check's own failed-step log, fetched through\n96\t    [forge].check_log_command for every check not \"success\". Absent\n97\t    [forge].checks_command, absent [forge].check_log_command, or a\n98\t    counseled record with no sha of its own: read is false and reason\n99\t    names exactly which is missing -- never a checks list a reader could\n100\t    mistake for \"all clear\" (an empty list from a real, successful read\n101\t    is not this; that is read: true, checks: []).\"\"\"\n102\t    checks_command = forge_cfg.get(\"checks_command\")\n103\t    check_log_command = forge_cfg.get(\"check_log_command\")\n104\t    checks_path = tmp / \"checks.json\"\n105\t\n106\t    if not checks_command:\n107\t        reason = \"not read: no [forge].checks_command\"\n108\t    elif not check_log_command:\n109\t        reason = \"not read: no [forge].check_log_command\"\n110\t    elif not sha:\n111\t        reason = \"not read: the counseled record carries no sha\"\n112\t    else:\n113\t        reason = None\n114\t\n115\t    if reason is not None:\n116\t        envelope = {\"read\": False, \"reason\": reason, \"checks\": []}\n117\t        checks_path.write_text(json.dumps(envelope, indent=2) + \"\\n\")\n118\t        return envelope, checks_path\n119\t\n120\t    # reason is None only when checks_command, check_log_command, and sha are all set.\n121\t    checks_command, sha = cast(str, checks_command), cast(str, sha)\n122\t    raw_checks, _ok = read_forge_checks(root, checks_command, sha)\n123\t    payload_checks: list[dict[str, Any]] = []\n124\t    record_checks: list[dict[str, Any]] = []\n125\t    for i, c in enumerate(raw_checks[\"conclusions\"]):\n126\t        name, conclusion = c[\"name\"], c[\"conclusion\"]\n127\t        log_path = None\n128\t        if conclusion != \"success\":\n129\t            log_run = subprocess.run(\n130\t                f\"{check_log_command} {shlex.quote(sha)} {shlex.quote(name)}\",\n131\t                shell=True, cwd=str(root), capture_output=True, text=True, check=False)\n132\t            if log_run.returncode == 0 and log_run.stdout.strip():\n133\t                log_file = tmp / f\"check-{i:02d}.log\"\n134\t                log_file.write_text(log_run.stdout)\n135\t                log_path = str(log_file)\n136\t        payload_checks.append({\"name\": name, \"conclusion\": conclusion,\n137\t                               \"run_url\": None, \"log\": log_path})\n138\t        record_checks.append({\"name\": name, \"conclusion\": conclusion})\n139\t\n140\t    checks_path.write_text(json.dumps(\n141\t        {\"read\": True, \"reason\": None, \"checks\": payload_checks}, indent=2) + \"\\n\")\n142\t    return {\"read\": True, \"reason\": None, \"checks\": record_checks}, checks_path\n143\t\n144\t\n145\tdef counsel_graph_text(root: Path, m: dict[str, Any], item_id: str, sha: str | None,\n146\t                       checks_command: str | None) -> str:\n147\t    \"\"\"A text report of the item's own place on the branch (issue #175):\n148\t    the default branch's first-parent log since the item's own branch\n149\t    point, this branch's own commits (sha, author, subject), the markers\n150\t    and records present at the counseled sha, and the check runs on the\n151\t    last three shas on this branch -- so a stop whose cause is \"the\n152\t    checks are on the record commit, not the code commit\" is readable\n153\t    without a terminal. Best-effort: a git read that fails (a shallow\n154\t    checkout, an unset refs/remotes/origin/HEAD) is noted in the text\n155\t    rather than raised, since the graph is evidence, not a gate.\"\"\"\n156\t    records_rel = m[\"paths\"][\"records\"]\n157\t    parts: list[str] = []\n158\t\n159\t    symref = subprocess.run(\n160\t        [\"git\", \"-C\", str(root), \"symbolic-ref\", \"-q\", \"refs/remotes/origin/HEAD\"],\n161\t        capture_output=True, text=True, check=False)\n162\t    default_ref = symref.stdout.strip() if symref.returncode == 0 else None\n163\t\n164\t    if default_ref:\n165\t        try:\n166\t            branch_point = git(root, \"merge-base\", default_ref, \"HEAD\").strip()\n167\t            parts.append(\n168\t                \"## the default branch, first-parent, since this item's branch point\\n\\n\" +\n169\t                (git(root, \"log\", \"--first-parent\", \"--oneline\",\n170\t                    f\"{branch_point}..{default_ref}\").strip() or \"(nothing new)\"))\n171\t            parts.append(\n172\t                \"## this branch's own commits since the branch point\\n\\n\" +\n173\t                (git(root, \"log\", \"--first-parent\", \"--format=%H %an %s\",\n174\t                    f\"{branch_point}..HEAD\").strip() or \"(no commits yet)\"))\n175\t        except RuntimeError as exc:\n176\t            parts.append(f\"## the default branch\\n\\n(could not be read: {exc})\")\n177\t    else:\n178\t        parts.append(\"## the default branch\\n\\n(refs/remotes/origin/HEAD is not set)\")\n179\t\n180\t    if sha:\n181\t        try:\n182\t            tree = git(root, \"ls-tree\", \"-r\", \"--name-only\", sha, \"--\",\n183\t                      f\"{records_rel.rstrip('/')}/{item_id}/\").strip()\n184\t            parts.append(f\"## markers and records present at {sha}\\n\\n\" + (tree or \"(none)\"))\n185\t        except RuntimeError as exc:\n186\t            parts.append(f\"## markers and records present at {sha}\\n\\n(could not be read: {exc})\")\n187\t\n188\t    if checks_command:\n189\t        try:\n190\t            recent = git(root, \"log\", \"--first-parent\", \"-3\", \"--format=%H\", \"HEAD\").split()\n191\t        except RuntimeError:\n192\t            recent = []\n193\t        lines = []\n194\t        for s in recent:\n195\t            checks, _ = read_forge_checks(root, checks_command, s)\n196\t            line = \", \".join(f\"{c['name']}={c['conclusion']}\" for c in checks[\"conclusions\"])\n197\t            lines.append(f\"{s}: {line or '(no checks)'}\")\n198\t        if lines:\n199\t            parts.append(\"## check runs for the last three shas on this branch\\n\\n\" +\n200\t                         \"\\n\".join(lines))\n201\t\n202\t    return \"\\n\\n\".join(parts)\n203\t\n204\t\n205\tdef cmd_counsel(argv: list[str]) -> int:\n206\t    root = Path(\".\").resolve()\n207\t    ask: str | None = None\n208\t    positional: list[str] = []\n209\t    i = 0\n210\t    while i < len(argv):\n211\t        if argv[i] == \"--ask\":\n212\t            ask = argv[i + 1] if i + 1 < len(argv) else None\n213\t            i += 2\n214\t        else:\n215\t            positional.append(argv[i])\n216\t            i += 1\n217\t    item_id = positional[0] if positional else derive_item_id(root)\n218\t    if not item_id:\n219\t        print(\"attavo counsel: cannot derive item id; pass N or run on an attavo/N-* branch\",\n220\t              file=sys.stderr)\n221\t        return 2\n222\t    if ask is not None and not ask.strip():\n223\t        print(\"attavo counsel: --ask requires non-empty text\", file=sys.stderr)\n224\t        return 2\n225\t    m = read_manifest(root)\n226\t    if m is None:\n227\t        print(f\"attavo counsel: no {MANIFEST} at {root}\", file=sys.stderr)\n228\t        return 2\n229\t\n230\t    specs_rel = m[\"paths\"][\"specs\"]\n231\t    records_rel = m[\"paths\"][\"records\"]\n232\t    item_records_dir = root / records_rel / item_id\n233\t\n234\t    # issue #175: --ask reads the item's latest records regardless of\n235\t    # status -- a question is not bound to a stop -- everything else\n236\t    # about the evidence set and the write is shared with the stop path.\n237\t    if ask is not None:\n238\t        stage, stop_record, record_path = latest_stage_record(item_records_dir)\n239\t        no_record_msg = f\"no build, verify, or spec-gate record for item {item_id}\"\n240\t    else:\n241\t        stage, stop_record, record_path = latest_non_pass_stage_record(item_records_dir)\n242\t        no_record_msg = f\"no non-pass build, verify, or spec-gate record for item {item_id}\"\n243\t    if stop_record is None:\n244\t        print(f\"attavo counsel: refused: {no_record_msg}\")\n245\t        return 1\n246\t    # latest_*_stage_record returns all three of (stage, record, path) or none.\n247\t    stage, record_path = cast(str, stage), cast(Path, record_path)\n248\t\n249\t    executor = m.get(\"executor\") or {}\n250\t    adapter_name = executor.get(\"counsel\") or executor.get(\"verify\")\n251\t    if not adapter_name:\n252\t        print(\"attavo counsel: refused: no [executor].counsel or [executor].verify \"\n253\t              \"in the manifest\")\n254\t        return 1\n255\t    adapter_path = resolve_adapter(root, adapter_name)\n256\t    if adapter_path is None:\n257\t        print(f\"attavo counsel: refused: no adapter named {adapter_name!r}\")\n258\t        return 1\n259\t\n260\t    adapter_config = merge_adapter_config(m, adapter_name, \"counsel\")\n261\t    reports = adapter_reports(adapter_path)\n262\t    spec_dir = root / specs_rel / item_id\n263\t    log_path = record_path.with_suffix(\".log\")\n264\t\n265\t    diff_text, diff_refusal = diff_since_approval(root, stop_record.get(\"approval_sha\"))\n266\t    if diff_refusal:\n267\t        print(f\"attavo counsel: refused: {diff_refusal}\")\n268\t        return 1\n269\t\n270\t    forge_cfg = m.get(\"forge\") or {}\n271\t    stop_sha = stop_record.get(\"sha\")\n272\t\n273\t    started = time.monotonic()\n274\t\n275\t    with tempfile.TemporaryDirectory() as tmp:\n276\t        tmp_path = Path(tmp)\n277\t        diff_path = tmp_path / \"diff.patch\"\n278\t        diff_path.write_text(diff_text)\n279\t\n280\t        forge, checks_path = counsel_forge_evidence(root, forge_cfg, stop_sha, tmp_path)\n281\t\n282\t        graph_path = tmp_path / \"graph.txt\"\n283\t        graph_path.write_text(counsel_graph_text(\n284\t            root, m, item_id, stop_sha, forge_cfg.get(\"checks_command\")))\n285\t\n286\t        env = dict(os.environ)\n287\t        env[\"ATTAVO_SPEC_DIR\"] = str(spec_dir)\n288\t        env[\"ATTAVO_RECORDS_DIR\"] = str(item_records_dir)\n289\t        env[\"ATTAVO_RULINGS\"] = str(root / m[\"paths\"][\"rulings\"])\n290\t        env[\"ATTAVO_STAGE\"] = \"counsel\"\n291\t        env[\"ATTAVO_COUNSEL_RECORD\"] = str(record_path)\n292\t        env[\"ATTAVO_COUNSEL_LOG\"] = str(log_path) if log_path.is_file() else \"\"\n293\t        env[\"ATTAVO_COUNSEL_DIFF\"] = str(diff_path)\n294\t        env[\"ATTAVO_COUNSEL_CHECKS\"] = str(checks_path)\n295\t        env[\"ATTAVO_COUNSEL_GRAPH\"] = str(graph_path)\n296\t        env[\"ATTAVO_MANIFEST\"] = str(root / MANIFEST)\n297\t        env[\"ATTAVO_PRODUCT_ROOT\"] = str(PRODUCT_ROOT)\n298\t        env[\"ATTAVO_ADAPTER_CONFIG\"] = json.dumps(adapter_config)\n299\t        if ask is not None:\n300\t            env[\"ATTAVO_COUNSEL_QUESTION\"] = ask\n301\t\n302\t        run = subprocess.run([str(adapter_path)], cwd=str(root), env=env,\n303\t                             capture_output=True, text=True, check=False)\n304\t        transcript, payload = split_adapter_stdout(run.stdout)\n305\t        if run.returncode != 0:\n306\t            detail = f\"[adapter exited {run.returncode}]\"\n307\t            if run.stderr.strip():\n308\t                detail += \"\\n\" + run.stderr.rstrip(\"\\n\")\n309\t            transcript = (transcript + \"\\n\" if transcript else \"\") + detail\n310\t\n311\t    status_out = \"failed\"\n312\t    model = model_version = adapter_version_out = None\n313\t    tokens = {\"input\": 0, \"output\": 0}\n314\t    cost_usd = None\n315\t    cls = verdict = None\n316\t    citations: list[Any] = []\n317\t    proposal = {\"ruling_text\": None, \"patch\": None, \"question\": None, \"issue\": None}\n318\t\n319\t    if (run.returncode == 0 and payload is not None\n320\t            and payload.get(\"verdict\") in (\"answer\", \"patch\", \"person\")):\n321\t        status_out = \"done\"\n322\t        model = payload.get(\"model\")\n323\t        model_version = payload.get(\"model_version\")\n324\t        adapter_version_out = payload.get(\"adapter_version\")\n325\t        tok = payload.get(\"tokens\") or {}\n326\t        tokens = {\"input\": tok.get(\"input\", 0) or 0, \"output\": tok.get(\"output\", 0) or 0}\n327\t        cost_usd = payload.get(\"cost_usd\")\n328\t        cls = payload.get(\"class\")\n329\t        verdict = payload.get(\"verdict\")\n330\t        citations = payload.get(\"citations\") or []\n331\t        proposal = {**proposal, **(payload.get(\"proposal\") or {})}\n332\t\n333\t    record = {\n334\t        \"sha\": git(root, \"rev-parse\", \"HEAD\").strip(),\n335\t        \"record_stage\": stage,\n336\t        \"record\": record_path.stem,\n337\t        \"at\": now_iso(),\n338\t        \"adapter\": adapter_name,\n339\t        \"adapter_config\": adapter_config,\n340\t        \"adapter_version\": adapter_version_out,\n341\t        \"model\": model,\n342\t        \"model_version\": model_version,\n343\t        \"reports\": reports,\n344\t        \"tokens\": tokens,\n345\t        \"cost_usd\": cost_usd,\n346\t        \"wall_clock_s\": round(time.monotonic() - started, 3),\n347\t        \"status\": status_out,\n348\t        \"class\": cls,\n349\t        \"verdict\": verdict,\n350\t        \"citations\": citations,\n351\t        \"proposal\": proposal,\n352\t        \"forge\": forge,\n353\t        \"question\": ask,\n354\t    }\n355\t    record_out_path = write_record(item_records_dir, \"counsel\", record, m, item_id, log=transcript)\n356\t\n357\t    print(f\"attavo counsel: {status_out} ({record_out_path.name})\")\n358\t    return 0 if status_out == \"done\" else 1\n359\t"}]},"parent_tool_use_id":null,"session_id":"0dd7ed4f-100c-4188-9a34-077aa0b6aa25","uuid":"1ef29ba2-e039-4fdc-a115-24701db2c343","timestamp":"2026-09-26T02:13:53.365Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-219/attavo/counsel.py","content":"from __future__ import annotations\n\nimport json\nimport os\nimport shlex\nimport subprocess\nimport sys\nimport tempfile\nimport time\nfrom pathlib import Path\nfrom typing import Any, cast\n\nfrom attavo.build import (\n    adapter_reports,\n    merge_adapter_config,\n    resolve_adapter,\n    split_adapter_stdout,\n)\nfrom attavo.common import MANIFEST, PRODUCT_ROOT, derive_item_id, git, now_iso, read_manifest\nfrom attavo.records import latest_attempt_path, latest_record, write_record\nfrom attavo.types import SpecRecord, StageRecord\nfrom attavo.verify import diff_since_approval, read_forge_checks\n\n# --- counsel: a stop is read inside the product first, before a person\n# (issue #100). Read-only -- it commits nothing and writes nothing outside\n# paths.records/<N>/ -- and it never acts: it proposes a ruling, a patch,\n# or names the one-line question a person must answer. ---\n\nCOUNSEL_STAGES = (\"build\", \"verify\")\n\n\ndef latest_non_pass_stage_record(records_dir: Path) -> tuple[str | None, StageRecord | None, Path | None]:\n    \"\"\"(stage, record, path) for the item's most recent non-pass build or\n    verify record, by its own \"at\" timestamp -- or, when neither stage\n    carries one, the item's latest refused spec-gate record (issue #133):\n    a refused gate is the same shape of stop, earlier, and it is read only\n    once a build or verify record exists to counsel first, since either\n    one already implies the gate that produced it passed. (None, None,\n    None) when none of the three exists. \"Most recent\" rather than\n    \"build, else verify\" so a stop on the stage that ran later (typically\n    verify, bound to a build that already passed) is the one counseled.\"\"\"\n    candidates: list[tuple[str, StageRecord, Path]] = []\n    for stage in COUNSEL_STAGES:\n        path = latest_attempt_path(records_dir, stage)\n        if path is None:\n            continue\n        # A path exists, so the record read from the same files does too.\n        rec = cast(StageRecord, latest_record(records_dir, stage))\n        if rec.get(\"status\") == \"pass\":\n            continue\n        candidates.append((stage, rec, path))\n    if candidates:\n        candidates.sort(key=lambda c: c[1].get(\"at\") or \"\")\n        return candidates[-1]\n    spec_path = latest_attempt_path(records_dir, \"spec\")\n    if spec_path is not None:\n        spec_rec = cast(SpecRecord, latest_record(records_dir, \"spec\"))\n        if spec_rec.get(\"status\") == \"refused\":\n            return \"spec\", spec_rec, spec_path\n    return None, None, None\n\n\ndef latest_stage_record(records_dir: Path) -> tuple[str | None, StageRecord | None, Path | None]:\n    \"\"\"(stage, record, path) for the item's most recent build or verify\n    record regardless of status, by its own \"at\" timestamp -- or, when\n    neither stage carries one, the item's latest spec-gate record,\n    regardless of status. The evidence set `attavo counsel --ask` reads\n    over (issue #175): a question is not bound to a stop, so the pass\n    filter latest_non_pass_stage_record applies does not apply here.\n    (None, None, None) when the item carries no record of any of the\n    three stages yet.\"\"\"\n    candidates: list[tuple[str, StageRecord, Path]] = []\n    for stage in COUNSEL_STAGES:\n        path = latest_attempt_path(records_dir, stage)\n        if path is None:\n            continue\n        candidates.append((stage, cast(StageRecord, latest_record(records_dir, stage)), path))\n    if candidates:\n        candidates.sort(key=lambda c: c[1].get(\"at\") or \"\")\n        return candidates[-1]\n    spec_path = latest_attempt_path(records_dir, \"spec\")\n    if spec_path is not None:\n        return \"spec\", cast(SpecRecord, latest_record(records_dir, \"spec\")), spec_path\n    return None, None, None\n\n\ndef counsel_forge_evidence(root: Path, forge_cfg: dict[str, Any], sha: str | None, tmp: Path\n                          ) -> tuple[dict[str, Any], Path]:\n    \"\"\"(forge, checks_path) -- issue #175. forge is the summary counsel's\n    own record carries: {\"read\", \"reason\", \"checks\"}, \"checks\" a list of\n    {\"name\", \"conclusion\"} pairs. checks_path is always written, under\n    tmp, as ATTAVO_COUNSEL_CHECKS: a JSON {\"read\", \"reason\", \"checks\"}\n    envelope whose own \"checks\" carry the richer {\"name\", \"conclusion\",\n    \"run_url\", \"log\"} shape the adapter reads -- \"log\" naming a sibling\n    file under tmp with that check's own failed-step log, fetched through\n    [forge].check_log_command for every check not \"success\". Absent\n    [forge].checks_command, absent [forge].check_log_command, or a\n    counseled record with no sha of its own: read is false and reason\n    names exactly which is missing -- never a checks list a reader could\n    mistake for \"all clear\" (an empty list from a real, successful read\n    is not this; that is read: true, checks: []).\"\"\"\n    checks_command = forge_cfg.get(\"checks_command\")\n    check_log_command = forge_cfg.get(\"check_log_command\")\n    checks_path = tmp / \"checks.json\"\n\n    if not checks_command:\n        reason = \"not read: no [forge].checks_command\"\n    elif not check_log_command:\n        reason = \"not read: no [forge].check_log_command\"\n    elif not sha:\n        reason = \"not read: the counseled record carries no sha\"\n    else:\n        reason = None\n\n    if reason is not None:\n        envelope = {\"read\": False, \"reason\": reason, \"checks\": []}\n        checks_path.write_text(json.dumps(envelope, indent=2) + \"\\n\")\n        return envelope, checks_path\n\n    # reason is None only when checks_command, check_log_command, and sha are all set.\n    checks_command, sha = cast(str, checks_command), cast(str, sha)\n    raw_checks, _ok = read_forge_checks(root, checks_command, sha)\n    payload_checks: list[dict[str, Any]] = []\n    record_checks: list[dict[str, Any]] = []\n    for i, c in enumerate(raw_checks[\"conclusions\"]):\n        name, conclusion = c[\"name\"], c[\"conclusion\"]\n        log_path = None\n        if conclusion != \"success\":\n            log_run = subprocess.run(\n                f\"{check_log_command} {shlex.quote(sha)} {shlex.quote(name)}\",\n                shell=True, cwd=str(root), capture_output=True, text=True, check=False)\n            if log_run.returncode == 0 and log_run.stdout.strip():\n                log_file = tmp / f\"check-{i:02d}.log\"\n                log_file.write_text(log_run.stdout)\n                log_path = str(log_file)\n        payload_checks.append({\"name\": name, \"conclusion\": conclusion,\n                               \"run_url\": None, \"log\": log_path})\n        record_checks.append({\"name\": name, \"conclusion\": conclusion})\n\n    checks_path.write_text(json.dumps(\n        {\"read\": True, \"reason\": None, \"checks\": payload_checks}, indent=2) + \"\\n\")\n    return {\"read\": True, \"reason\": None, \"checks\": record_checks}, checks_path\n\n\ndef counsel_graph_text(root: Path, m: dict[str, Any], item_id: str, sha: str | None,\n                       checks_command: str | None) -> str:\n    \"\"\"A text report of the item's own place on the branch (issue #175):\n    the default branch's first-parent log since the item's own branch\n    point, this branch's own commits (sha, author, subject), the markers\n    and records present at the counseled sha, and the check runs on the\n    last three shas on this branch -- so a stop whose cause is \"the\n    checks are on the record commit, not the code commit\" is readable\n    without a terminal. Best-effort: a git read that fails (a shallow\n    checkout, an unset refs/remotes/origin/HEAD) is noted in the text\n    rather than raised, since the graph is evidence, not a gate.\"\"\"\n    records_rel = m[\"paths\"][\"records\"]\n    parts: list[str] = []\n\n    symref = subprocess.run(\n        [\"git\", \"-C\", str(root), \"symbolic-ref\", \"-q\", \"refs/remotes/origin/HEAD\"],\n        capture_output=True, text=True, check=False)\n    default_ref = symref.stdout.strip() if symref.returncode == 0 else None\n\n    if default_ref:\n        try:\n            branch_point = git(root, \"merge-base\", default_ref, \"HEAD\").strip()\n            parts.append(\n                \"## the default branch, first-parent, since this item's branch point\\n\\n\" +\n                (git(root, \"log\", \"--first-parent\", \"--oneline\",\n                    f\"{branch_point}..{default_ref}\").strip() or \"(nothing new)\"))\n            parts.append(\n                \"## this branch's own commits since the branch point\\n\\n\" +\n                (git(root, \"log\", \"--first-parent\", \"--format=%H %an %s\",\n                    f\"{branch_point}..HEAD\").strip() or \"(no commits yet)\"))\n        except RuntimeError as exc:\n            parts.append(f\"## the default branch\\n\\n(could not be read: {exc})\")\n    else:\n        parts.append(\"## the default branch\\n\\n(refs/remotes/origin/HEAD is not set)\")\n\n    if sha:\n        try:\n            tree = git(root, \"ls-tree\", \"-r\", \"--name-only\", sha, \"--\",\n                      f\"{records_rel.rstrip('/')}/{item_id}/\").strip()\n            parts.append(f\"## markers and records present at {sha}\\n\\n\" + (tree or \"(none)\"))\n        except RuntimeError as exc:\n            parts.append(f\"## markers and records present at {sha}\\n\\n(could not be read: {exc})\")\n\n    if checks_command:\n        try:\n            recent = git(root, \"log\", \"--first-parent\", \"-3\", \"--format=%H\", \"HEAD\").split()\n        except RuntimeError:\n            recent = []\n        lines = []\n        for s in recent:\n            checks, _ = read_forge_checks(root, checks_command, s)\n            line = \", \".join(f\"{c['name']}={c['conclusion']}\" for c in checks[\"conclusions\"])\n            lines.append(f\"{s}: {line or '(no checks)'}\")\n        if lines:\n            parts.append(\"## check runs for the last three shas on this branch\\n\\n\" +\n                         \"\\n\".join(lines))\n\n    return \"\\n\\n\".join(parts)\n\n\ndef cmd_counsel(argv: list[str]) -> int:\n    root = Path(\".\").resolve()\n    ask: str | None = None\n    positional: list[str] = []\n    i = 0\n    while i < len(argv):\n        if argv[i] == \"--ask\":\n            ask = argv[i + 1] if i + 1 < len(argv) else None\n            i += 2\n        else:\n            positional.append(argv[i])\n            i += 1\n    item_id = positional[0] if positional else derive_item_id(root)\n    if not item_id:\n        print(\"attavo counsel: cannot derive item id; pass N or run on an attavo/N-* branch\",\n              file=sys.stderr)\n        return 2\n    if ask is not None and not ask.strip():\n        print(\"attavo counsel: --ask requires non-empty text\", file=sys.stderr)\n        return 2\n    m = read_manifest(root)\n    if m is None:\n        print(f\"attavo counsel: no {MANIFEST} at {root}\", file=sys.stderr)\n        return 2\n\n    specs_rel = m[\"paths\"][\"specs\"]\n    records_rel = m[\"paths\"][\"records\"]\n    item_records_dir = root / records_rel / item_id\n\n    # issue #175: --ask reads the item's latest records regardless of\n    # status -- a question is not bound to a stop -- everything else\n    # about the evidence set and the write is shared with the stop path.\n    if ask is not None:\n        stage, stop_record, record_path = latest_stage_record(item_records_dir)\n        no_record_msg = f\"no build, verify, or spec-gate record for item {item_id}\"\n    else:\n        stage, stop_record, record_path = latest_non_pass_stage_record(item_records_dir)\n        no_record_msg = f\"no non-pass build, verify, or spec-gate record for item {item_id}\"\n    if stop_record is None:\n        print(f\"attavo counsel: refused: {no_record_msg}\")\n        return 1\n    # latest_*_stage_record returns all three of (stage, record, path) or none.\n    stage, record_path = cast(str, stage), cast(Path, record_path)\n\n    executor = m.get(\"executor\") or {}\n    adapter_name = executor.get(\"counsel\") or executor.get(\"verify\")\n    if not adapter_name:\n        print(\"attavo counsel: refused: no [executor].counsel or [executor].verify \"\n              \"in the manifest\")\n        return 1\n    adapter_path = resolve_adapter(root, adapter_name)\n    if adapter_path is None:\n        print(f\"attavo counsel: refused: no adapter named {adapter_name!r}\")\n        return 1\n\n    adapter_config = merge_adapter_config(m, adapter_name, \"counsel\")\n    reports = adapter_reports(adapter_path)\n    spec_dir = root / specs_rel / item_id\n    log_path = record_path.with_suffix(\".log\")\n\n    diff_text, diff_refusal = diff_since_approval(root, stop_record.get(\"approval_sha\"))\n    if diff_refusal:\n        print(f\"attavo counsel: refused: {diff_refusal}\")\n        return 1\n\n    forge_cfg = m.get(\"forge\") or {}\n    stop_sha = stop_record.get(\"sha\")\n\n    started = time.monotonic()\n\n    with tempfile.TemporaryDirectory() as tmp:\n        tmp_path = Path(tmp)\n        diff_path = tmp_path / \"diff.patch\"\n        diff_path.write_text(diff_text)\n\n        forge, checks_path = counsel_forge_evidence(root, forge_cfg, stop_sha, tmp_path)\n\n        graph_path = tmp_path / \"graph.txt\"\n        graph_path.write_text(counsel_graph_text(\n            root, m, item_id, stop_sha, forge_cfg.get(\"checks_command\")))\n\n        env = dict(os.environ)\n        env[\"ATTAVO_SPEC_DIR\"] = str(spec_dir)\n        env[\"ATTAVO_RECORDS_DIR\"] = str(item_records_dir)\n        env[\"ATTAVO_RULINGS\"] = str(root / m[\"paths\"][\"rulings\"])\n        env[\"ATTAVO_STAGE\"] = \"counsel\"\n        env[\"ATTAVO_COUNSEL_RECORD\"] = str(record_path)\n        env[\"ATTAVO_COUNSEL_LOG\"] = str(log_path) if log_path.is_file() else \"\"\n        env[\"ATTAVO_COUNSEL_DIFF\"] = str(diff_path)\n        env[\"ATTAVO_COUNSEL_CHECKS\"] = str(checks_path)\n        env[\"ATTAVO_COUNSEL_GRAPH\"] = str(graph_path)\n        env[\"ATTAVO_MANIFEST\"] = str(root / MANIFEST)\n        env[\"ATTAVO_PRODUCT_ROOT\"] = str(PRODUCT_ROOT)\n        env[\"ATTAVO_ADAPTER_CONFIG\"] = json.dumps(adapter_config)\n        if ask is not None:\n            env[\"ATTAVO_COUNSEL_QUESTION\"] = ask\n\n        run = subprocess.run([str(adapter_path)], cwd=str(root), env=env,\n                             capture_output=True, text=True, check=False)\n        transcript, payload = split_adapter_stdout(run.stdout)\n        if run.returncode != 0:\n            detail = f\"[adapter exited {run.returncode}]\"\n            if run.stderr.strip():\n                detail += \"\\n\" + run.stderr.rstrip(\"\\n\")\n            transcript = (transcript + \"\\n\" if transcript else \"\") + detail\n\n    status_out = \"failed\"\n    model = model_version = adapter_version_out = None\n    tokens = {\"input\": 0, \"output\": 0}\n    cost_usd = None\n    cls = verdict = None\n    citations: list[Any] = []\n    proposal = {\"ruling_text\": None, \"patch\": None, \"question\": None, \"issue\": None}\n\n    if (run.returncode == 0 and payload is not None\n            and payload.get(\"verdict\") in (\"answer\", \"patch\", \"person\")):\n        status_out = \"done\"\n        model = payload.get(\"model\")\n        model_version = payload.get(\"model_version\")\n        adapter_version_out = payload.get(\"adapter_version\")\n        tok = payload.get(\"tokens\") or {}\n        tokens = {\"input\": tok.get(\"input\", 0) or 0, \"output\": tok.get(\"output\", 0) or 0}\n        cost_usd = payload.get(\"cost_usd\")\n        cls = payload.get(\"class\")\n        verdict = payload.get(\"verdict\")\n        citations = payload.get(\"citations\") or []\n        proposal = {**proposal, **(payload.get(\"proposal\") or {})}\n\n    record = {\n        \"sha\": git(root, \"rev-parse\", \"HEAD\").strip(),\n        \"record_stage\": stage,\n        \"record\": record_path.stem,\n        \"at\": now_iso(),\n        \"adapter\": adapter_name,\n        \"adapter_config\": adapter_config,\n        \"adapter_version\": adapter_version_out,\n        \"model\": model,\n        \"model_version\": model_version,\n        \"reports\": reports,\n        \"tokens\": tokens,\n        \"cost_usd\": cost_usd,\n        \"wall_clock_s\": round(time.monotonic() - started, 3),\n        \"status\": status_out,\n        \"class\": cls,\n        \"verdict\": verdict,\n        \"citations\": citations,\n        \"proposal\": proposal,\n        \"forge\": forge,\n        \"question\": ask,\n    }\n    record_out_path = write_record(item_records_dir, \"counsel\", record, m, item_id, log=transcript)\n\n    print(f\"attavo counsel: {status_out} ({record_out_path.name})\")\n    return 0 if status_out == \"done\" else 1\n","numLines":359,"startLine":1,"totalLines":359}}}

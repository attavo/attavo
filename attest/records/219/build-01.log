def _advance_again(root: Path, m: dict[str, Any], item_id: str, stage: str, head: str | None, *,\n                   again_by: bool = False) -> int:\n    \"\"\"The next attempt of a stopped stage: exactly what next-build or\n    next-review would do, bypassing the level a plain pass leaves alone\n    for the operator -- the pass's own automatic retry of a retryable\n    family, or `--again`'s act once a budget is spent (again_by). A\n    review reads the forge fresh here -- once, since the report's own\n    stopped reading never touched it -- rather than reusing a read that\n    was never taken.\"\"\"\n    if stage == \"build\":\n        return _start_stage(root, m, item_id, \"build\", None, again_by=again_by)\n    checks_command = (m.get(\"forge\") or {}).get(\"checks_command\")\n    if not checks_command:\n        print(\"attavo drive: refused: no [forge].checks_command in the manifest\")\n        return 1\n    forge_checks, ok = read_forge_checks(root, checks_command, cast(str, head))\n    if not ok:\n        conclusions = forge_checks[\"conclusions\"]\n        named = \", \".join(f\"{c['name']} {c['conclusion']}\" for c in conclusions) or \"no checks reported\"\n        print(f\"attavo drive: forge checks not green on {cast(str, head)[:12]}: {named}\")\n        return 0\n    return _start_stage(root, m, item_id, \"verify\", forge_checks, again_by=again_by)\n\n\ndef _retry_target(r: \"DriveReport\") -> str:\n    \"\"\"The stage the next attempt actually starts: class \"returned\" (a\n    build's head a check rejected, or a review's own blocking finding) is\n    always the verify record's own stop, but the retry it starts is the\n    next build.\"\"\"\n    return \"build\" if r[\"stop_class\"] == \"returned\" else cast(str, r[\"stage\"])\n\n\ndef _retry_due(root: Path, m: dict[str, Any], item_id: str, r: \"DriveReport\") -> bool:\n    \"\"\"R3: a stopped stage whose class is one of the four retryable\n    families, whose budget is not spent, whose last two signatures\n    differ, and -- for transient -- whose record has aged past\n    [drive].retry_after_s, is retried by the next plain pass, no\n    counsel, no operator act.\"\"\"\n    if r[\"stop_class\"] not in RETRYABLE_CLASSES:\n        return False\n    records_dir = root / m[\"paths\"][\"records\"] / item_id\n    sig_stage = cast(str, r[\"stage\"])\n    budget_stage = _retry_target(r)\n    if stage_exhausted(records_dir, m, sig_stage, budget_stage):\n        return False\n    if r[\"stop_class\"] == \"transient\":\n        attempts = parse_attempts(records_dir, sig_stage)\n        latest = attempts[max(attempts)] if attempts else {}\n        age = _seconds_since(latest.get(\"at\"))\n        if age is None or age < retry_after_s(m):\n            return False\n    return True\n\n\ndef _handle_again(root: Path, m: dict[str, Any], item_id: str, r: \"DriveReport\") -> int:\n    \"\"\"`--again`'s own act on a stopped stage (R3): a retryable family\n    whose budget is not spent is left to the pass's own automatic retry\n    -- a no-op here, saying so -- since starting it twice would spend two\n    attempts on one press. A retryable family whose budget is spent, or\n    any other stopped class, starts the next attempt at once, its marker\n    naming --again as what started it.\"\"\"\n    stage = _retry_target(r)\n    if r[\"stop_class\"] in RETRYABLE_CLASSES:\n        records_dir = root / m[\"paths\"][\"records\"] / item_id\n        if not stage_exhausted(records_dir, m, cast(str, r[\"stage\"]), stage):\n            print(\"attavo drive: --again is a no-op inside the budget; the pass retries on its own\")\n            return 0\n    return _advance_again(root, m, item_id, stage, r[\"head\"], again_by=True)\n\n\ndef _counsel_answered(records_dir: Path, r: \"DriveReport\") -> bool:\n    \"\"\"R3: whether the stop this report just read as \"stopped\" already\n    carries counsel's own \"answer\" verdict -- every non-retryable class\n    is counsel's to read (as before this item), and `answer` starts the\n    next attempt with the answer as its steer, read from the feedback\n    file the retried attempt's own first iteration is handed\n    (attavo.build._retry_seed).\"\"\"\n    if r[\"stop_class\"] in RETRYABLE_CLASSES or not r[\"stage\"] or r[\"attempt\"] is None:\n        return False\n    counsel = counsel_record_for(records_dir, cast(str, r[\"stage\"]), cast(int, r[\"attempt\"]))\n    return counsel is not None and counsel.get(\"verdict\") == \"answer\"\n\n\ndef _pass_once(root: Path, m: dict[str, Any], item_id: str, again: bool) -> tuple[int, \"DriveReport\"]:\n    \"\"\"One pass: fast-forward to origin (never while a worker holds the\n    copy), read the report, act at most once, return. The three acts,\n    one per report state that is the product's move: owes-recovery\n    recovers; next-build and next-review start their stage, handing a\n    review the checks the report already read once on the pre-marker\n    head; a concluded red check on a passed build's head (R3) is a\n    returned review record, not a level, so the review starts the same\n    way. On a stopped stage, `--again` always wins (a no-op inside the\n    budget, the next attempt once it is spent); absent it, a retryable\n    family retries on its own, and any other stop counsel has already\n    answered starts the next attempt steered by that answer. Every other\n    level is printed in the report's own words and left.\"\"\"\n    from attavo.report import drive_report\n    fast_forward_to_origin(root, m, item_id)\n    r = drive_report(root, m, item_id)\n\n    if r[\"state\"] == \"owes-recovery\":\n        records_dir = root / m[\"paths\"][\"records\"] / item_id\n        return _recover_one(root, m, item_id, records_dir), r\n    if r[\"state\"] == \"next-build\":\n        return _start_stage(root, m, item_id, \"build\", None), r\n    if r[\"state\"] == \"next-review\":\n        checks_command = (m.get(\"forge\") or {}).get(\"checks_command\")\n        forge_checks = {\"command\": checks_command, \"sha\": r[\"head\"], \"conclusions\": r[\"checks\"] or []}\n        return _start_stage(root, m, item_id, \"verify\", forge_checks), r\n    if r[\"state\"] == \"blocked-on-checks\" and r[\"stage\"] == \"verify\":\n        # R3: the rejection is a record, not a level with nothing behind\n        # it (#206's build-01) -- the review starts, reading the same\n        # forge checks this pass just read, and writes the check\n        # rejection itself as a returned record (attavo.verify.cmd_verify).\n        checks_command = (m.get(\"forge\") or {}).get(\"checks_command\")\n        forge_checks = {\"command\": checks_command, \"sha\": r[\"head\"], \"conclusions\": r[\"checks\"] or []}\n        return _start_stage(root, m, item_id, \"verify\", forge_checks), r\n    if r[\"state\"] == \"stopped\" and r[\"stage\"]:\n        if again:\n            return _handle_again(root, m, item_id, r), r\n        records_dir = root / m[\"paths\"][\"records\"] / item_id\n        if _retry_due(root, m, item_id, r):\n            return _advance_again(root, m, item_id, _retry_target(r), r[\"head\"]), r\n        if _counsel_answered(records_dir, r):\n            return _advance_again(root, m, item_id, _retry_target(r), r[\"head\"]), r\n\n    print(f\"attavo drive: {r['says']}\")\n    return (1 if r[\"state\"] == \"refused\" else 0), r"}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01K3N8PPwiEHjPhPH8rYSFPz","type":"tool_result","content":"1\t\"\"\"`attavo drive N --report`: what one item is waiting on and for whom, as a\n2\tpure function of its records, its markers, and one read of the forge. It\n3\twrites nothing, starts nothing, and never waits (#171: a refusal nobody\n4\tcould read, twice on #194).\n5\t\n6\tRun: python3 -m pytest tests -q\n7\t\"\"\"\n8\tfrom __future__ import annotations\n9\t\n10\timport json\n11\timport os\n12\timport socket\n13\timport time\n14\tfrom datetime import datetime, timedelta, timezone\n15\tfrom pathlib import Path\n16\tfrom typing import Any\n17\t\n18\timport pytest\n19\tfrom helpers import commit_all, git, make_tenant\n20\tfrom test_attest_time import INVOCATIONS, make_item\n21\tfrom test_drive import (\n22\t    GREEN_FORGE,\n23\t    RED_FORGE,\n24\t    UNCONCLUDED_FORGE,\n25\t    add_bare_remote,\n26\t    add_drive_stall_bound,\n27\t    add_forge,\n28\t    approve_item,\n29\t    drive,\n30\t    head_of,\n31\t    record_files,\n32\t    records_dir,\n33\t    run_attavo,\n34\t    write_dead_marker,\n35\t)\n36\t\n37\tROOT = Path(__file__).resolve().parent.parent\n38\tSCHEMA = json.loads((ROOT / \"schema\" / \"drive-report.schema.json\").read_text())\n39\t\n40\t\n41\tdef report(root: Path, item: str = \"1\", env: dict[str, Any] | None = None) -> dict[str, Any]:\n42\t    before = (head_of(root), git(root, \"status\", \"--porcelain\"),\n43\t              sorted(p.name for p in records_dir(root, item).glob(\"*\")))\n44\t    run = run_attavo(root, \"drive\", item, \"--report\", env=env)\n45\t    assert run.returncode == 0, run.stdout + run.stderr\n46\t    after = (head_of(root), git(root, \"status\", \"--porcelain\"),\n47\t             sorted(p.name for p in records_dir(root, item).glob(\"*\")))\n48\t    assert before == after, \"the report wrote something\"\n49\t    out: dict[str, Any] = json.loads(run.stdout)\n50\t    assert set(out) == set(SCHEMA[\"required\"]) == set(SCHEMA[\"properties\"]), out\n51\t    assert out[\"state\"] in SCHEMA[\"properties\"][\"state\"][\"enum\"], out\n52\t    assert out[\"kind\"] in SCHEMA[\"properties\"][\"kind\"][\"enum\"], out\n53\t    assert \"drive\" not in out[\"says\"].lower() and \"verify\" not in out[\"says\"].lower(), out\n54\t    return out\n55\t\n56\t\n57\tdef test_report_names_a_red_check_and_the_head_and_writes_nothing(tmp_path: Path) -> None:\n58\t    \"\"\"#171: on a concluded red check the product printed one line into a\n59\t    log nobody read, exited 1, and wrote nothing. The report says it for as\n60\t    long as it is true.\"\"\"\n61\t    root = make_tenant(tmp_path, \"build_valid\")\n62\t    add_forge(root, RED_FORGE)\n63\t    add_bare_remote(root, tmp_path)\n64\t    approve_item(root)\n65\t    assert drive(root, \"1\").returncode == 0\n66\t    out = report(root)\n67\t    assert (out[\"state\"], out[\"kind\"], out[\"stage\"]) == (\"blocked-on-checks\", \"waits\", \"verify\"), out\n68\t    assert out[\"checks\"] == [{\"name\": \"ci\", \"conclusion\": \"failure\"}], out\n69\t    assert \"ci failure\" in out[\"says\"] and head_of(root)[:7] in out[\"says\"], out\n70\t    assert record_files(root, \"verify\") == []\n71\t    assert report(root) == out, \"two reads of one level differ\"\n72\t\n73\t\n74\tdef test_report_never_waits_on_a_check_that_is_still_running(tmp_path: Path) -> None:\n75\t    root = make_tenant(tmp_path, \"build_valid\")\n76\t    add_forge(root, UNCONCLUDED_FORGE)\n77\t    add_bare_remote(root, tmp_path)\n78\t    approve_item(root)\n79\t    assert drive(root, \"1\").returncode == 0\n80\t    started = time.monotonic()\n81\t    out = report(root, env={\"ATTAVO_DRIVE_POLL_BOUND_S\": \"30\", \"ATTAVO_DRIVE_POLL_INTERVAL_S\": \"5\"})\n82\t    assert time.monotonic() - started < 4, \"the report polled\"\n83\t    assert (out[\"state\"], out[\"kind\"]) == (\"waiting-on-checks\", \"waits\"), out\n84\t    assert \"ci in_progress\" in out[\"says\"], out\n85\t\n86\t\n87\tdef test_report_walks_an_item_from_approval_to_ready(tmp_path: Path) -> None:\n88\t    root = make_tenant(tmp_path, \"build_valid\")\n89\t    add_forge(root, GREEN_FORGE)\n90\t    add_bare_remote(root, tmp_path)\n91\t    assert run_attavo(root, \"spec-gate\", \"1\").returncode == 0\n92\t    out = report(root)\n93\t    assert (out[\"state\"], out[\"kind\"]) == (\"waiting-on-approval\", \"yours\"), out\n94\t    approve_item(root)\n95\t    assert (report(root)[\"state\"], report(root)[\"kind\"]) == (\"next-build\", \"acts\")\n96\t    assert drive(root, \"1\").returncode == 0\n97\t    assert (report(root)[\"state\"], report(root)[\"stage\"]) == (\"next-review\", \"verify\")\n98\t    assert drive(root, \"1\").returncode == 0\n99\t    out = report(root)\n100\t    assert (out[\"state\"], out[\"kind\"], out[\"says\"]) == (\"ready-to-merge\", \"yours\", \"Ready to merge\"), out\n101\t\n102\t\n103\tdef test_report_says_what_recovery_would_record_for_a_dead_invocation(tmp_path: Path) -> None:\n104\t    root = make_tenant(tmp_path, \"build_valid\")\n105\t    add_forge(root, GREEN_FORGE)\n106\t    add_drive_stall_bound(root)\n107\t    approve_item(root)\n108\t    write_dead_marker(root, \"build\", 1)\n109\t    out = report(root)\n110\t    assert (out[\"state\"], out[\"kind\"], out[\"stage\"], out[\"attempt\"], out[\"stop_class\"]) == (\n111\t        \"owes-recovery\", \"acts\", \"build\", 1, \"died\"), out\n112\t    assert not (records_dir(root) / \"build-01.json\").exists()\n113\t\n114\t\n115\tdef test_report_names_the_stopped_record_its_class_its_counsel_and_its_issue(tmp_path: Path) -> None:\n116\t    root = make_tenant(tmp_path, \"build_valid\")\n117\t    add_forge(root, GREEN_FORGE)\n118\t    add_drive_stall_bound(root)\n119\t    approve_item(root)\n120\t    write_dead_marker(root, \"build\", 1)\n121\t    assert drive(root, \"1\").returncode == 0\n122\t    d = records_dir(root)\n123\t    (d / \"build-01.filed\").write_text(\"https://example.invalid/issues/9\\n\")\n124\t    commit_all(root, \"the stop is filed\")\n125\t    out = report(root)\n126\t    assert (out[\"state\"], out[\"kind\"], out[\"record\"], out[\"stop_class\"], out[\"filed\"]) == (\n127\t        \"stopped\", \"yours\", \"build-01\", \"died\", \"https://example.invalid/issues/9\"), out\n128\t    assert out[\"says\"].startswith(\"Needs you: build attempt 01 stopped as died\"), out\n129\t\n130\t\n131\tdef write_live_marker(root: Path, stage: str, nn: int, age_s: int) -> None:\n132\t    \"\"\"A marker whose pid is this test's own process: alive, on this host,\n133\t    begun age_s seconds ago, with no events file.\"\"\"\n134\t    at = (datetime.now(timezone.utc) - timedelta(seconds=age_s)).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n135\t    marker = records_dir(root) / f\"{stage}-{nn:02d}.started\"\n136\t    marker.parent.mkdir(parents=True, exist_ok=True)\n137\t    marker.write_text(json.dumps({\"at\": at, \"host\": socket.gethostname(), \"pid\": os.getpid(),\n138\t                                  \"sha\": head_of(root), \"product_version\": \"fixture\"}))\n139\t    commit_all(root, \"invocation marker for item 1\")\n140\t\n141\t\n142\tdef test_report_reads_an_expired_approval_as_yours_and_says_why(tmp_path: Path) -> None:\n143\t    root = make_tenant(tmp_path, \"build_valid\")\n144\t    add_forge(root, GREEN_FORGE)\n145\t    approve_item(root)\n146\t    spec = root / \"specs\" / \"1\" / \"spec.md\"\n147\t    spec.write_text(spec.read_text() + \"\\n\")\n148\t    commit_all(root, \"touch the spec after approval\")\n149\t    out = report(root)\n150\t    assert (out[\"state\"], out[\"kind\"]) == (\"waiting-on-approval\", \"yours\"), out\n151\t    assert \"expired\" in out[\"says\"], out\n152\t\n153\t\n154\tdef test_report_reads_a_live_invocation_inside_the_bound_as_running(tmp_path: Path) -> None:\n155\t    \"\"\"Launch stayed on the screen while #194's build ran: a view guessed\n156\t    whose move it was.\"\"\"\n157\t    root = make_tenant(tmp_path, \"build_valid\")\n158\t    add_forge(root, GREEN_FORGE)\n159\t    add_drive_stall_bound(root, 60)\n160\t    approve_item(root)\n161\t    write_live_marker(root, \"build\", 1, age_s=5)\n162\t    out = report(root)\n163\t    assert (out[\"state\"], out[\"kind\"], out[\"stage\"], out[\"attempt\"]) == (\"running\", \"waits\", \"build\", 1), out\n164\t    assert out[\"since\"] and isinstance(out[\"last_event_age_s\"], int), out\n165\t    assert out[\"says\"].startswith(\"Build running since \"), out\n166\t\n167\t\n168\tdef test_report_reads_a_live_invocation_past_the_bound_as_hung_and_ends_nothing(tmp_path: Path) -> None:\n169\t    root = make_tenant(tmp_path, \"build_valid\")\n170\t    add_forge(root, GREEN_FORGE)\n171\t    add_drive_stall_bound(root, 60)\n172\t    approve_item(root)\n173\t    write_live_marker(root, \"build\", 1, age_s=600)\n174\t    out = report(root)\n175\t    assert (out[\"state\"], out[\"kind\"], out[\"stop_class\"]) == (\"owes-recovery\", \"acts\", \"hung\"), out\n176\t    os.kill(os.getpid(), 0)  # the report terminated nothing: this process is its \"hung\" pid\n177\t\n178\t\n179\tdef test_report_reads_a_review_of_an_earlier_build_as_review_next(tmp_path: Path) -> None:\n180\t    \"\"\"#109: a later build supersedes the latest review; the item is not\n181\t    ready and is not stopped.\"\"\"\n182\t    root = make_tenant(tmp_path, \"build_valid\")\n183\t    add_forge(root, GREEN_FORGE)\n184\t    add_bare_remote(root, tmp_path)\n185\t    approve_item(root)\n186\t    assert drive(root, \"1\").returncode == 0\n187\t    assert drive(root, \"1\").returncode == 0\n188\t    assert report(root)[\"state\"] == \"ready-to-merge\"\n189\t    build = json.loads(record_files(root, \"build\")[-1].read_text())\n190\t    build[\"sha\"] = \"f\" * 40\n191\t    (records_dir(root) / \"build-02.json\").write_text(json.dumps(build))\n192\t    commit_all(root, \"a second build record, minted by hand\")\n193\t    out = report(root)\n194\t    assert (out[\"state\"], out[\"kind\"], out[\"stage\"]) == (\"next-review\", \"acts\", \"verify\"), out\n195\t\n196\t\n197\tdef test_report_does_not_read_a_failed_build_of_an_earlier_approval_as_stopped(tmp_path: Path) -> None:\n198\t    root = make_tenant(tmp_path, \"build_valid\")\n199\t    add_forge(root, GREEN_FORGE)\n200\t    approve_item(root)\n201\t    (records_dir(root) / \"build-01.json\").write_text(json.dumps(\n202\t        {\"status\": \"failed\", \"sha\": \"b\" * 40, \"approval_sha\": \"0\" * 40,\n203\t         \"stop\": {\"class\": \"gate\", \"provenance\": \"tenant\", \"detail\": None}}))\n204\t    commit_all(root, \"a failed build bound to an approval that is not the current one\")\n205\t    out = report(root)\n206\t    assert (out[\"state\"], out[\"kind\"]) == (\"next-build\", \"acts\"), out\n207\t\n208\t\n209\tdef test_report_names_the_counsel_record_that_read_the_stop(tmp_path: Path) -> None:\n210\t    root = make_tenant(tmp_path, \"build_valid\")\n211\t    add_forge(root, GREEN_FORGE)\n212\t    add_drive_stall_bound(root)\n213\t    approve_item(root)\n214\t    write_dead_marker(root, \"build\", 1)\n215\t    assert drive(root, \"1\").returncode == 0\n216\t    (records_dir(root) / \"counsel-01.json\").write_text(json.dumps(\n217\t        {\"record\": \"build-01\", \"record_stage\": \"build\", \"verdict\": \"person\", \"status\": \"done\"}))\n218\t    commit_all(root, \"counsel read the stop\")\n219\t    out = report(root)\n220\t    assert (out[\"state\"], out[\"counsel\"]) == (\"stopped\", \"counsel-01\"), out\n221\t    assert \"counsel-01\" in out[\"says\"] and \"person\" in out[\"says\"], out\n222\t\n223\t\n224\tdef test_report_reads_a_merged_item_as_merged(tmp_path: Path) -> None:\n225\t    \"\"\"The screen showed #204 as waiting, its pull request \"not read\", after\n226\t    it had merged: the branch survived and no view read the history.\"\"\"\n227\t    root, merge = make_item(tmp_path, INVOCATIONS)\n228\t    run = run_attavo(root, \"drive\", \"1\", \"--report\")\n229\t    assert run.returncode == 0, run.stdout + run.stderr\n230\t    out = json.loads(run.stdout)\n231\t    assert (out[\"state\"], out[\"kind\"]) == (\"merged\", \"done\"), out\n232\t    assert merge[:7] in out[\"says\"], out\n233\t\n234\t\n235\t@pytest.mark.own_records\n236\tdef test_report_reads_every_item_this_repository_carries(tmp_path: Path) -> None:\n237\t    \"\"\"A new reader must not wedge on a record that already exists (#194's\n238\t    verify-01). Every item under this repository's own records directory\n239\t    yields a report, in-process, with no forge read of its own.\"\"\"\n240\t    from attavo.common import read_manifest\n241\t    from attavo.report import drive_report\n242\t    m = read_manifest(ROOT)\n243\t    assert m is not None\n244\t    m = {**m, \"forge\": {**(m.get(\"forge\") or {}), \"checks_command\": \"printf 'ci success\\\\n'\"}}\n245\t    items = sorted(p.name for p in (ROOT / m[\"paths\"][\"records\"]).iterdir() if p.is_dir())\n246\t    assert items\n247\t    for item in items:\n248\t        out = drive_report(ROOT, m, item)\n249\t        assert out[\"state\"] in SCHEMA[\"properties\"][\"state\"][\"enum\"], (item, out)\n250\t\n251\t\n252\tdef test_report_compares_attempts_at_exhaustion(tmp_path: Path) -> None:\n253\t    \"\"\"R3 (ruled 2026-09-20): when a stage's budget is spent or two\n254\t    attempts failed the same way, the report carries every attempt's\n255\t    class, signature, bound crossed, wall clock and cost, whether the\n256\t    last two signatures match, and the rulings available -- computed\n257\t    across the records, not from counsel on one.\"\"\"\n258\t    from test_retry import add_drive_table, stop_of\n259\t    root = make_tenant(tmp_path, \"build_valid\")\n260\t    add_forge(root, GREEN_FORGE)\n261\t    add_drive_table(root, build_ceiling_s=10**7, verify_ceiling_s=10**7)\n262\t    approve_item(root)\n263\t    write_dead_marker(root, \"build\", 1)\n264\t    assert drive(root, \"1\").returncode == 0\n265\t    write_dead_marker(root, \"build\", 2)\n266\t    assert drive(root, \"1\").returncode == 0\n267\t    assert stop_of(root, \"build\", 1)[\"class\"] == stop_of(root, \"build\", 2)[\"class\"] == \"died\"\n268\t    out = report(root)\n269\t    assert out[\"state\"] == \"stopped\", out\n270\t    assert [a[\"attempt\"] for a in out[\"attempts\"]] == [1, 2], out[\"attempts\"]\n271\t    assert all(set(a) >= {\"class\", \"signature\", \"bound\", \"wall_clock_s\", \"cost_usd\"} for a in out[\"attempts\"])\n272\t    assert isinstance(out[\"signatures_match\"], bool)\n273\t    assert any(\"again\" in r for r in out[\"rulings_available\"]), out[\"rulings_available\"]\n274\t"}]},"parent_tool_use_id":null,"session_id":"0dd7ed4f-100c-4188-9a34-077aa0b6aa25","uuid":"cd94c4e0-29b9-4fd8-811b-0d8b4d49af81","timestamp":"2026-09-26T02:09:45.835Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-219/attest/specs/219/stub/tests/test_report.py","content":"\"\"\"`attavo drive N --report`: what one item is waiting on and for whom, as a\npure function of its records, its markers, and one read of the forge. It\nwrites nothing, starts nothing, and never waits (#171: a refusal nobody\ncould read, twice on #194).\n\nRun: python3 -m pytest tests -q\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport os\nimport socket\nimport time\nfrom datetime import datetime, timedelta, timezone\nfrom pathlib import Path\nfrom typing import Any\n\nimport pytest\nfrom helpers import commit_all, git, make_tenant\nfrom test_attest_time import INVOCATIONS, make_item\nfrom test_drive import (\n    GREEN_FORGE,\n    RED_FORGE,\n    UNCONCLUDED_FORGE,\n    add_bare_remote,\n    add_drive_stall_bound,\n    add_forge,\n    approve_item,\n    drive,\n    head_of,\n    record_files,\n    records_dir,\n    run_attavo,\n    write_dead_marker,\n)\n\nROOT = Path(__file__).resolve().parent.parent\nSCHEMA = json.loads((ROOT / \"schema\" / \"drive-report.schema.json\").read_text())\n\n\ndef report(root: Path, item: str = \"1\", env: dict[str, Any] | None = None) -> dict[str, Any]:\n    before = (head_of(root), git(root, \"status\", \"--porcelain\"),\n              sorted(p.name for p in records_dir(root, item).glob(\"*\")))\n    run = run_attavo(root, \"drive\", item, \"--report\", env=env)\n    assert run.returncode == 0, run.stdout + run.stderr\n    after = (head_of(root), git(root, \"status\", \"--porcelain\"),\n             sorted(p.name for p in records_dir(root, item).glob(\"*\")))\n    assert before == after, \"the report wrote something\"\n    out: dict[str, Any] = json.loads(run.stdout)\n    assert set(out) == set(SCHEMA[\"required\"]) == set(SCHEMA[\"properties\"]), out\n    assert out[\"state\"] in SCHEMA[\"properties\"][\"state\"][\"enum\"], out\n    assert out[\"kind\"] in SCHEMA[\"properties\"][\"kind\"][\"enum\"], out\n    assert \"drive\" not in out[\"says\"].lower() and \"verify\" not in out[\"says\"].lower(), out\n    return out\n\n\ndef test_report_names_a_red_check_and_the_head_and_writes_nothing(tmp_path: Path) -> None:\n    \"\"\"#171: on a concluded red check the product printed one line into a\n    log nobody read, exited 1, and wrote nothing. The report says it for as\n    long as it is true.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, RED_FORGE)\n    add_bare_remote(root, tmp_path)\n    approve_item(root)\n    assert drive(root, \"1\").returncode == 0\n    out = report(root)\n    assert (out[\"state\"], out[\"kind\"], out[\"stage\"]) == (\"blocked-on-checks\", \"waits\", \"verify\"), out\n    assert out[\"checks\"] == [{\"name\": \"ci\", \"conclusion\": \"failure\"}], out\n    assert \"ci failure\" in out[\"says\"] and head_of(root)[:7] in out[\"says\"], out\n    assert record_files(root, \"verify\") == []\n    assert report(root) == out, \"two reads of one level differ\"\n\n\ndef test_report_never_waits_on_a_check_that_is_still_running(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, UNCONCLUDED_FORGE)\n    add_bare_remote(root, tmp_path)\n    approve_item(root)\n    assert drive(root, \"1\").returncode == 0\n    started = time.monotonic()\n    out = report(root, env={\"ATTAVO_DRIVE_POLL_BOUND_S\": \"30\", \"ATTAVO_DRIVE_POLL_INTERVAL_S\": \"5\"})\n    assert time.monotonic() - started < 4, \"the report polled\"\n    assert (out[\"state\"], out[\"kind\"]) == (\"waiting-on-checks\", \"waits\"), out\n    assert \"ci in_progress\" in out[\"says\"], out\n\n\ndef test_report_walks_an_item_from_approval_to_ready(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    add_bare_remote(root, tmp_path)\n    assert run_attavo(root, \"spec-gate\", \"1\").returncode == 0\n    out = report(root)\n    assert (out[\"state\"], out[\"kind\"]) == (\"waiting-on-approval\", \"yours\"), out\n    approve_item(root)\n    assert (report(root)[\"state\"], report(root)[\"kind\"]) == (\"next-build\", \"acts\")\n    assert drive(root, \"1\").returncode == 0\n    assert (report(root)[\"state\"], report(root)[\"stage\"]) == (\"next-review\", \"verify\")\n    assert drive(root, \"1\").returncode == 0\n    out = report(root)\n    assert (out[\"state\"], out[\"kind\"], out[\"says\"]) == (\"ready-to-merge\", \"yours\", \"Ready to merge\"), out\n\n\ndef test_report_says_what_recovery_would_record_for_a_dead_invocation(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    add_drive_stall_bound(root)\n    approve_item(root)\n    write_dead_marker(root, \"build\", 1)\n    out = report(root)\n    assert (out[\"state\"], out[\"kind\"], out[\"stage\"], out[\"attempt\"], out[\"stop_class\"]) == (\n        \"owes-recovery\", \"acts\", \"build\", 1, \"died\"), out\n    assert not (records_dir(root) / \"build-01.json\").exists()\n\n\ndef test_report_names_the_stopped_record_its_class_its_counsel_and_its_issue(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    add_drive_stall_bound(root)\n    approve_item(root)\n    write_dead_marker(root, \"build\", 1)\n    assert drive(root, \"1\").returncode == 0\n    d = records_dir(root)\n    (d / \"build-01.filed\").write_text(\"https://example.invalid/issues/9\\n\")\n    commit_all(root, \"the stop is filed\")\n    out = report(root)\n    assert (out[\"state\"], out[\"kind\"], out[\"record\"], out[\"stop_class\"], out[\"filed\"]) == (\n        \"stopped\", \"yours\", \"build-01\", \"died\", \"https://example.invalid/issues/9\"), out\n    assert out[\"says\"].startswith(\"Needs you: build attempt 01 stopped as died\"), out\n\n\ndef write_live_marker(root: Path, stage: str, nn: int, age_s: int) -> None:\n    \"\"\"A marker whose pid is this test's own process: alive, on this host,\n    begun age_s seconds ago, with no events file.\"\"\"\n    at = (datetime.now(timezone.utc) - timedelta(seconds=age_s)).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n    marker = records_dir(root) / f\"{stage}-{nn:02d}.started\"\n    marker.parent.mkdir(parents=True, exist_ok=True)\n    marker.write_text(json.dumps({\"at\": at, \"host\": socket.gethostname(), \"pid\": os.getpid(),\n                                  \"sha\": head_of(root), \"product_version\": \"fixture\"}))\n    commit_all(root, \"invocation marker for item 1\")\n\n\ndef test_report_reads_an_expired_approval_as_yours_and_says_why(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    approve_item(root)\n    spec = root / \"specs\" / \"1\" / \"spec.md\"\n    spec.write_text(spec.read_text() + \"\\n\")\n    commit_all(root, \"touch the spec after approval\")\n    out = report(root)\n    assert (out[\"state\"], out[\"kind\"]) == (\"waiting-on-approval\", \"yours\"), out\n    assert \"expired\" in out[\"says\"], out\n\n\ndef test_report_reads_a_live_invocation_inside_the_bound_as_running(tmp_path: Path) -> None:\n    \"\"\"Launch stayed on the screen while #194's build ran: a view guessed\n    whose move it was.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    add_drive_stall_bound(root, 60)\n    approve_item(root)\n    write_live_marker(root, \"build\", 1, age_s=5)\n    out = report(root)\n    assert (out[\"state\"], out[\"kind\"], out[\"stage\"], out[\"attempt\"]) == (\"running\", \"waits\", \"build\", 1), out\n    assert out[\"since\"] and isinstance(out[\"last_event_age_s\"], int), out\n    assert out[\"says\"].startswith(\"Build running since \"), out\n\n\ndef test_report_reads_a_live_invocation_past_the_bound_as_hung_and_ends_nothing(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    add_drive_stall_bound(root, 60)\n    approve_item(root)\n    write_live_marker(root, \"build\", 1, age_s=600)\n    out = report(root)\n    assert (out[\"state\"], out[\"kind\"], out[\"stop_class\"]) == (\"owes-recovery\", \"acts\", \"hung\"), out\n    os.kill(os.getpid(), 0)  # the report terminated nothing: this process is its \"hung\" pid\n\n\ndef test_report_reads_a_review_of_an_earlier_build_as_review_next(tmp_path: Path) -> None:\n    \"\"\"#109: a later build supersedes the latest review; the item is not\n    ready and is not stopped.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    add_bare_remote(root, tmp_path)\n    approve_item(root)\n    assert drive(root, \"1\").returncode == 0\n    assert drive(root, \"1\").returncode == 0\n    assert report(root)[\"state\"] == \"ready-to-merge\"\n    build = json.loads(record_files(root, \"build\")[-1].read_text())\n    build[\"sha\"] = \"f\" * 40\n    (records_dir(root) / \"build-02.json\").write_text(json.dumps(build))\n    commit_all(root, \"a second build record, minted by hand\")\n    out = report(root)\n    assert (out[\"state\"], out[\"kind\"], out[\"stage\"]) == (\"next-review\", \"acts\", \"verify\"), out\n\n\ndef test_report_does_not_read_a_failed_build_of_an_earlier_approval_as_stopped(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    approve_item(root)\n    (records_dir(root) / \"build-01.json\").write_text(json.dumps(\n        {\"status\": \"failed\", \"sha\": \"b\" * 40, \"approval_sha\": \"0\" * 40,\n         \"stop\": {\"class\": \"gate\", \"provenance\": \"tenant\", \"detail\": None}}))\n    commit_all(root, \"a failed build bound to an approval that is not the current one\")\n    out = report(root)\n    assert (out[\"state\"], out[\"kind\"]) == (\"next-build\", \"acts\"), out\n\n\ndef test_report_names_the_counsel_record_that_read_the_stop(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    add_drive_stall_bound(root)\n    approve_item(root)\n    write_dead_marker(root, \"build\", 1)\n    assert drive(root, \"1\").returncode == 0\n    (records_dir(root) / \"counsel-01.json\").write_text(json.dumps(\n        {\"record\": \"build-01\", \"record_stage\": \"build\", \"verdict\": \"person\", \"status\": \"done\"}))\n    commit_all(root, \"counsel read the stop\")\n    out = report(root)\n    assert (out[\"state\"], out[\"counsel\"]) == (\"stopped\", \"counsel-01\"), out\n    assert \"counsel-01\" in out[\"says\"] and \"person\" in out[\"says\"], out\n\n\ndef test_report_reads_a_merged_item_as_merged(tmp_path: Path) -> None:\n    \"\"\"The screen showed #204 as waiting, its pull request \"not read\", after\n    it had merged: the branch survived and no view read the history.\"\"\"\n    root, merge = make_item(tmp_path, INVOCATIONS)\n    run = run_attavo(root, \"drive\", \"1\", \"--report\")\n    assert run.returncode == 0, run.stdout + run.stderr\n    out = json.loads(run.stdout)\n    assert (out[\"state\"], out[\"kind\"]) == (\"merged\", \"done\"), out\n    assert merge[:7] in out[\"says\"], out\n\n\n@pytest.mark.own_records\ndef test_report_reads_every_item_this_repository_carries(tmp_path: Path) -> None:\n    \"\"\"A new reader must not wedge on a record that already exists (#194's\n    verify-01). Every item under this repository's own records directory\n    yields a report, in-process, with no forge read of its own.\"\"\"\n    from attavo.common import read_manifest\n    from attavo.report import drive_report\n    m = read_manifest(ROOT)\n    assert m is not None\n    m = {**m, \"forge\": {**(m.get(\"forge\") or {}), \"checks_command\": \"printf 'ci success\\\\n'\"}}\n    items = sorted(p.name for p in (ROOT / m[\"paths\"][\"records\"]).iterdir() if p.is_dir())\n    assert items\n    for item in items:\n        out = drive_report(ROOT, m, item)\n        assert out[\"state\"] in SCHEMA[\"properties\"][\"state\"][\"enum\"], (item, out)\n\n\ndef test_report_compares_attempts_at_exhaustion(tmp_path: Path) -> None:\n    \"\"\"R3 (ruled 2026-09-20): when a stage's budget is spent or two\n    attempts failed the same way, the report carries every attempt's\n    class, signature, bound crossed, wall clock and cost, whether the\n    last two signatures match, and the rulings available -- computed\n    across the records, not from counsel on one.\"\"\"\n    from test_retry import add_drive_table, stop_of\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    add_drive_table(root, build_ceiling_s=10**7, verify_ceiling_s=10**7)\n    approve_item(root)\n    write_dead_marker(root, \"build\", 1)\n    assert drive(root, \"1\").returncode == 0\n    write_dead_marker(root, \"build\", 2)\n    assert drive(root, \"1\").returncode == 0\n    assert stop_of(root, \"build\", 1)[\"class\"] == stop_of(root, \"build\", 2)[\"class\"] == \"died\"\n    out = report(root)\n    assert out[\"state\"] == \"stopped\", out\n    assert [a[\"attempt\"] for a in out[\"attempts\"]] == [1, 2], out[\"attempts\"]\n    assert all(set(a) >= {\"class\", \"signature\", \"bound\", \"wall_clock_s\", \"cost_usd\"} for a in out[\"attempts\"])\n    assert isinstance(out[\"signatures_match\"], bool)\n    assert any(\"again\" in r for r in out[\"rulings_available\"]), out[\"rulings_available\"]\n","numLines":274,"startLine":1,"totalLines":274}}}

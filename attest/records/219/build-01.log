{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QgM1KGjkYrMretQkP2Ee8b","type":"tool_result","content":"1\tfrom __future__ import annotations\n2\t\n3\timport json\n4\timport os\n5\timport shlex\n6\timport subprocess\n7\timport sys\n8\timport tempfile\n9\timport time\n10\tfrom pathlib import Path\n11\tfrom typing import Any\n12\t\n13\tfrom attavo.build import (\n14\t    adapter_reports,\n15\t    merge_adapter_config,\n16\t    resolve_adapter,\n17\t    split_adapter_stdout,\n18\t)\n19\tfrom attavo.common import MANIFEST, derive_item_id, git, now_iso, read_manifest\n20\tfrom attavo.events import stage_events_dir\n21\tfrom attavo.records import latest_attempt_path, latest_record, next_attempt_number, write_record\n22\tfrom attavo.stops import derive_stop\n23\t\n24\t# --- verify: the forge's own read first, a judge only once it is green ---\n25\t\n26\tFORGE_OK_CONCLUSIONS = {\"success\", \"neutral\", \"skipped\"}\n27\t\n28\t# issue #84: a concluded check's second token is a conclusion --\n29\t# FORGE_OK_CONCLUSIONS, or another concluded one such as failure,\n30\t# cancelled, or timed_out; an unconcluded check's is a status instead,\n31\t# one of these. drive's own poll (poll_forge_checks) is the one reader\n32\t# that needs to tell a still-running check apart from a concluded, not-ok\n33\t# one -- read_forge_checks itself only ever needed \"green or not\".\n34\tFORGE_UNCONCLUDED_STATUSES = {\"queued\", \"in_progress\", \"pending\", \"waiting\"}\n35\t\n36\t\n37\tdef read_forge_checks(root: Path, checks_command: str, sha: str) -> tuple[dict[str, Any], bool]:\n38\t    \"\"\"Runs the tenant's [forge].checks_command on sha; the product does\n39\t    not know what forge that command reads. One line per check as\n40\t    \"<name> <conclusion>\"; a command that fails to run, or any conclusion\n41\t    other than success/neutral/skipped, is not green.\"\"\"\n42\t    run = subprocess.run(f\"{checks_command} {shlex.quote(sha)}\", shell=True, cwd=str(root),\n43\t                         capture_output=True, text=True, check=False)\n44\t    conclusions: list[dict[str, str]] = []\n45\t    for line in run.stdout.splitlines():\n46\t        line = line.strip()\n47\t        if not line:\n48\t            continue\n49\t        parts = line.rsplit(\" \", 1)\n50\t        if len(parts) == 2:\n51\t            conclusions.append({\"name\": parts[0], \"conclusion\": parts[1]})\n52\t    # A commit the forge has no record of is not green -- it is unread.\n53\t    # The executor's own commit is exactly this: the forge attaches\n54\t    # checks to a pull request's head, and that commit stops being the\n55\t    # head the moment a record commit lands on top of it. all() over an\n56\t    # empty list is True, which is why this is spelled out rather than\n57\t    # implied by the loop above.\n58\t    ok = run.returncode == 0 and bool(conclusions) and all(\n59\t        c[\"conclusion\"] in FORGE_OK_CONCLUSIONS for c in conclusions)\n60\t    return {\"command\": checks_command, \"sha\": sha, \"conclusions\": conclusions}, ok\n61\t\n62\t\n63\tdef diff_since_approval(root: Path, approval_sha: str | None) -> tuple[str, str | None]:\n64\t    \"\"\"(diff_text, refusal): the item's own work since approval, not\n65\t    everything merged onto the branch since then (issue #52) -- a\n66\t    three-dot diff against approval_sha itself is not enough, since\n67\t    approval_sha is already an ancestor of HEAD in the normal flow and\n68\t    merge-base(approval_sha, HEAD) is just approval_sha again (verified\n69\t    empirically, see issue #52). Diffing from the merge-base of HEAD and\n70\t    the remote's default branch instead excludes content that arrived by\n71\t    merging that branch in, because that content is already present on\n72\t    both sides of the merge base. refs/remotes/origin/HEAD is what names\n73\t    the default branch without hard-coding \"main\"; when it is not set,\n74\t    there is nothing to diff against and this refuses rather than guess.\n75\t    (\"\", None) when approval_sha is falsy -- nothing to diff from at all.\n76\t    Shared by cmd_verify and cmd_counsel, which both hand an adapter this\n77\t    same diff.\"\"\"\n78\t    if not approval_sha:\n79\t        return \"\", None\n80\t    symref = subprocess.run(\n81\t        [\"git\", \"-C\", str(root), \"symbolic-ref\", \"-q\", \"refs/remotes/origin/HEAD\"],\n82\t        capture_output=True, text=True, check=False)\n83\t    if symref.returncode != 0:\n84\t        return \"\", \"refs/remotes/origin/HEAD is not set; run `git remote set-head origin -a`\"\n85\t    diff_base = git(root, \"merge-base\", symref.stdout.strip(), \"HEAD\").strip()\n86\t    return git(root, \"diff\", diff_base, \"HEAD\"), None\n87\t\n88\t\n89\tdef stub_ratio(diff_text: str, stub_dir: Path, excluded: tuple[str, ...]) -> float | None:\n90\t    \"\"\"The share of the lines diff_text adds that are a line of the stub's\n91\t    file at the same path: near 1 the build shipped the spec author's stub,\n92\t    near 0 the builder wrote the change. Lines under the excluded\n93\t    directories (the specs and records, where the stub itself and the\n94\t    item's records are committed) and blank lines are not counted. None\n95\t    when there is no stub or the diff adds no counted line -- nothing was\n96\t    measured, which is not 0.0.\"\"\"\n97\t    if not stub_dir.is_dir():\n98\t        return None\n99\t    skipped = tuple(e.strip(\"/\") for e in excluded)\n100\t    stub_lines: dict[str, set[str]] = {}\n101\t    path: str | None = None\n102\t    in_hunk = False\n103\t    added = shipped = 0\n104\t    for line in diff_text.splitlines():\n105\t        if line.startswith(\"diff --git \"):\n106\t            path, in_hunk = None, False\n107\t        elif in_hunk:\n108\t            if line.startswith(\"+\") and line[1:].strip() and path is not None:\n109\t                added += 1\n110\t                shipped += line[1:].rstrip() in stub_lines[path]\n111\t        elif line.startswith(\"+++ \"):\n112\t            name = line[4:].split(\"\\t\")[0]\n113\t            path = name[2:] if name.startswith(\"b/\") else None\n114\t            if path is not None and any(path == e or path.startswith(e + \"/\") for e in skipped):\n115\t                path = None\n116\t            if path is not None and path not in stub_lines:\n117\t                stub_file = stub_dir / path\n118\t                stub_lines[path] = (\n119\t                    {text.rstrip() for text in stub_file.read_text(errors=\"replace\").splitlines()}\n120\t                    if stub_file.is_file() else set())\n121\t        elif line.startswith(\"@@\"):\n122\t            in_hunk = True\n123\t    return shipped / added if added else None\n124\t\n125\t\n126\tdef _returned_stop(forge_checks: dict[str, Any]) -> dict[str, Any]:\n127\t    \"\"\"R3 (stub): a review returned by a concluded red required check is\n128\t    class returned (retryable: the next build is handed the evidence); one\n129\t    returned by checks still running is forge-unconcluded, as before.\"\"\"\n130\t    from attavo.stops import signature_of\n131\t    conclusions = forge_checks.get(\"conclusions\") or []\n132\t    red = sorted(c[\"name\"] for c in conclusions\n133\t                 if c[\"conclusion\"] not in FORGE_OK_CONCLUSIONS and c[\"conclusion\"] not in FORGE_UNCONCLUDED_STATUSES)\n134\t    unconcluded = [c for c in conclusions if c[\"conclusion\"] in FORGE_UNCONCLUDED_STATUSES]\n135\t    if red and not unconcluded:\n136\t        detail = \", \".join(f\"{c['name']} {c['conclusion']}\" for c in conclusions if c[\"name\"] in red)\n137\t        return {\"class\": \"returned\", \"provenance\": \"tenant\", \"detail\": detail,\n138\t                \"signature\": signature_of(\" \".join(red)), \"bound\": None}\n139\t    stop: dict[str, Any] = dict(derive_stop(\"returned\") or {})\n140\t    return {**stop, \"signature\": None, \"bound\": None}\n141\t\n142\t\n143\tdef cmd_verify(argv: list[str]) -> int:\n144\t    root = Path(\".\").resolve()\n145\t    item_id = argv[0] if argv else derive_item_id(root)\n146\t    if not item_id:\n147\t        print(\"attavo verify: cannot derive item id; pass N or run on an attavo/N-* branch\",\n148\t              file=sys.stderr)\n149\t        return 2\n150\t    m = read_manifest(root)\n151\t    if m is None:\n152\t        print(f\"attavo verify: no {MANIFEST} at {root}\", file=sys.stderr)\n153\t        return 2\n154\t\n155\t    specs_rel = m[\"paths\"][\"specs\"]\n156\t    records_rel = m[\"paths\"][\"records\"]\n157\t    item_records_dir = root / records_rel / item_id\n158\t\n159\t    latest_build = latest_record(item_records_dir, \"build\")\n160\t    if latest_build is None:\n161\t        print(f\"attavo verify: refused: no build record for item {item_id}\")\n162\t        return 1\n163\t    if latest_build.get(\"status\") != \"pass\":\n164\t        print(f\"attavo verify: refused: latest build record is \"\n165\t              f\"{latest_build.get('status')!r}, not pass\")\n166\t        return 1\n167\t\n168\t    forge_cfg = m.get(\"forge\") or {}\n169\t    checks_command = forge_cfg.get(\"checks_command\")\n170\t    if not checks_command:\n171\t        print(\"attavo verify: refused: no [forge].checks_command in the manifest\")\n172\t        return 1\n173\t\n174\t    build_sha = latest_build[\"sha\"]\n175\t    build_record_path = latest_attempt_path(item_records_dir, \"build\")\n176\t    approval_sha = latest_build.get(\"approval_sha\")\n177\t    spec_dir = root / specs_rel / item_id\n178\t    started = time.monotonic()\n179\t    head_sha = git(root, \"rev-parse\", \"HEAD\").strip()\n180\t\n181\t    diff_text, diff_refusal = diff_since_approval(root, approval_sha)\n182\t    if diff_refusal:\n183\t        print(f\"attavo verify: refused: {diff_refusal}\")\n184\t        return 1\n185\t    # The forge attaches checks to a pull request's head, not to the\n186\t    # executor's own commit -- that commit stops being the head the\n187\t    # moment a record commit lands on top of it (issue #44). Reading the\n188\t    # forge on head_sha is what the forge actually checked and what will\n189\t    # be merged; build_sha and forge_checks[\"sha\"] can differ, and both\n190\t    # are kept on the record rather than one sha serving two purposes.\n191\t    # head_sha is a marker commit just pushed (issue #178): the forge has\n192\t    # not attached anything to it yet on the first read, so this polls\n193\t    # with the same bound and interval the drive's own guard uses, giving\n194\t    # those checks room to conclude before this read judges them.\n195\t    given = os.environ.get(\"ATTAVO_FORGE_CHECKS\")\n196\t    if given:\n197\t        # Reconciler ruling B: the pass read the checks on the head before\n198\t        # its marker commit and found them green; a records-only commit\n199\t        # cannot change them (#210's proof), so the review takes that read\n200\t        # and does not poll a head the forge has not attached anything to.\n201\t        forge_checks = json.loads(Path(given).read_text())\n202\t        forge_ok = bool(forge_checks.get(\"conclusions\")) and all(\n203\t            c[\"conclusion\"] in FORGE_OK_CONCLUSIONS for c in forge_checks[\"conclusions\"])\n204\t    else:\n205\t        forge_checks, forge_ok = poll_forge_checks(root, checks_command, head_sha)\n206\t\n207\t    if not forge_ok:\n208\t        record: dict[str, Any] = {\n209\t            \"sha\": head_sha,\n210\t            \"build_sha\": build_sha,\n211\t            \"build_record\": build_record_path.stem if build_record_path else None,\n212\t            \"approval_sha\": approval_sha,\n213\t            \"at\": now_iso(),\n214\t            \"adapter\": None, \"adapter_config\": {}, \"adapter_version\": None,\n215\t            \"model\": None, \"model_version\": None,\n216\t            \"reports\": [],\n217\t            \"forge_checks\": forge_checks,\n218\t            \"findings\": None,\n219\t            \"tests_named\": [],\n220\t            \"commits\": [],\n221\t            \"stub_ratio\": stub_ratio(diff_text, spec_dir / \"stub\", (specs_rel, records_rel)),\n222\t            \"tokens\": {\"input\": 0, \"output\": 0}, \"cost_usd\": None,\n223\t            \"wall_clock_s\": round(time.monotonic() - started, 3),\n224\t            \"status\": \"returned\",\n225\t            \"retry_of\": None, \"steer\": None,\n226\t            \"stop\": _returned_stop(forge_checks),\n227\t        }\n228\t        record_path = write_record(item_records_dir, \"verify\", record, m, item_id)\n229\t        print(f\"attavo verify: returned ({record_path.name}); the forge checks are not green\")\n230\t        return 0\n231\t\n232\t    executor = m.get(\"executor\") or {}\n233\t    adapter_name = executor.get(\"verify\") or executor.get(\"build\")\n234\t    if not adapter_name:\n235\t        print(\"attavo verify: refused: no [executor].verify or [executor].build in the manifest\")\n236\t        return 1\n237\t    adapter_path = resolve_adapter(root, adapter_name)\n238\t    if adapter_path is None:\n239\t        print(f\"attavo verify: refused: no adapter named {adapter_name!r}\")\n240\t        return 1\n241\t\n242\t    adapter_config = merge_adapter_config(m, adapter_name, \"verify\")\n243\t    reports = adapter_reports(adapter_path)\n244\t    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n245\t\n246\t    events_path = stage_events_dir(root) / f\"verify-{next_attempt_number(item_records_dir, 'verify'):02d}.events.jsonl\"\n247\t\n248\t    with tempfile.TemporaryDirectory() as tmp:\n249\t        diff_path = Path(tmp) / \"diff.patch\"\n250\t        diff_path.write_text(diff_text)\n251\t\n252\t        env = dict(os.environ)\n253\t        env[\"ATTAVO_SPEC_DIR\"] = str(spec_dir)\n254\t        env[\"ATTAVO_RECORDS_DIR\"] = str(item_records_dir)\n255\t        env[\"ATTAVO_RULINGS\"] = str(root / m[\"paths\"][\"rulings\"])\n256\t        env[\"ATTAVO_BRANCH\"] = branch\n257\t        env[\"ATTAVO_STAGE\"] = \"verify\"\n258\t        env[\"ATTAVO_DIFF\"] = str(diff_path)\n259\t        env[\"ATTAVO_BUILD_RECORD\"] = str(build_record_path) if build_record_path else \"\"\n260\t        env[\"ATTAVO_ADAPTER_CONFIG\"] = json.dumps(adapter_config)\n261\t        env[\"ATTAVO_EVENTS\"] = str(events_path)\n262\t\n263\t        run = subprocess.run([str(adapter_path)], cwd=str(root), env=env,\n264\t                             capture_output=True, text=True, check=False)\n265\t        transcript, payload = split_adapter_stdout(run.stdout)\n266\t        if run.returncode != 0:\n267\t            # Same guarantee as cmd_build's, issue #53: a non-zero adapter\n268\t            # exit always leaves a non-empty log.\n269\t            detail = f\"[adapter exited {run.returncode}]\"\n270\t            if run.stderr.strip():\n271\t                detail += \"\\n\" + run.stderr.rstrip(\"\\n\")\n272\t            transcript = (transcript + \"\\n\" if transcript else \"\") + detail\n273\t\n274\t    # Verify is a report, not a commit (issue #46): the adapter is invoked\n275\t    # on the branch head it was handed, and must leave that head alone.\n276\t    # Checked by comparing the head before the invocation (head_sha,\n277\t    # already read above for the forge) against the head after it.\n278\t    post_adapter_head = git(root, \"rev-parse\", \"HEAD\").strip()\n279\t    commits: list[str] = []\n280\t    if post_adapter_head != head_sha:\n281\t        commits = git(root, \"rev-list\", f\"{head_sha}..{post_adapter_head}\", \"--reverse\").split()\n282\t\n283\t    status_out = \"failed\"\n284\t    findings = None\n285\t    tests_named: list[str] = []\n286\t    model = model_version = adapter_version_out = None\n287\t    tokens = {\"input\": 0, \"output\": 0}\n288\t    cost_usd = None\n289\t\n290\t    if run.returncode == 0 and payload is not None and payload.get(\"model\"):\n291\t        model = payload.get(\"model\")\n292\t        model_version = payload.get(\"model_version\")\n293\t        adapter_version_out = payload.get(\"adapter_version\")\n294\t        tok = payload.get(\"tokens\") or {}\n295\t        tokens = {\"input\": tok.get(\"input\", 0) or 0, \"output\": tok.get(\"output\", 0) or 0}\n296\t        cost_usd = payload.get(\"cost_usd\")\n297\t        # \"findings\" absent (or explicitly null) is not the same as an\n298\t        # empty list: the adapter had no channel to report one at all,\n299\t        # which is not a clean bill of health (issue #46). A commit\n300\t        # during verify fails the attempt regardless of what it reported.\n301\t        if not commits and \"findings\" in payload and payload[\"findings\"] is not None:\n302\t            findings = payload[\"findings\"]\n303\t            tests_named = payload.get(\"tests_named\") or []\n304\t            status_out = \"pass\"\n305\t\n306\t    record = {\n307\t        \"sha\": head_sha,\n308\t        \"build_sha\": build_sha,\n309\t        \"build_record\": build_record_path.stem if build_record_path else None,\n310\t        \"approval_sha\": approval_sha,\n311\t        \"at\": now_iso(),\n312\t        \"adapter\": adapter_name,\n313\t        \"adapter_config\": adapter_config,\n314\t        \"adapter_version\": adapter_version_out,\n315\t        \"model\": model,\n316\t        \"model_version\": model_version,\n317\t        \"reports\": reports,\n318\t        \"forge_checks\": forge_checks,\n319\t        \"findings\": findings,\n320\t        \"tests_named\": tests_named,\n321\t        \"commits\": commits,\n322\t        \"stub_ratio\": stub_ratio(diff_text, spec_dir / \"stub\", (specs_rel, records_rel)),\n323\t        \"tokens\": tokens,\n324\t        \"cost_usd\": cost_usd,\n325\t        \"wall_clock_s\": round(time.monotonic() - started, 3),\n326\t        \"status\": status_out,\n327\t        \"stop\": derive_stop(status_out, log=transcript,\n328\t                            report_class=(payload or {}).get(\"class\")),\n329\t    }\n330\t    record_path = write_record(item_records_dir, \"verify\", record, m, item_id, log=transcript)\n331\t\n332\t    print(f\"attavo verify: {status_out} ({record_path.name})\")\n333\t    return 0 if status_out == \"pass\" else 1\n334\t\n335\t\n336\t# issue #84: a constant the lane names, not a manifest key, until a tenant\n337\t# disagrees -- how long drive gives a forge's checks room to conclude\n338\t# before it gives up and stops rather than call a judge on a tree the\n339\t# forge has not yet finished reading. Tenant zero's own checks conclude\n340\t# about five minutes after a push; the default bound gives them room to\n341\t# finish so a person is not the one re-running drive after CI, which is\n342\t# exactly the transport act this lane retires. ATTAVO_DRIVE_POLL_BOUND_S\n343\t# and ATTAVO_DRIVE_POLL_INTERVAL_S, read at call time rather than once at\n344\t# import, are for a test's own clock, not a tenant's -- there is no\n345\t# manifest key for either.\n346\tDRIVE_FORGE_POLL_BOUND_DEFAULT_S = 600.0\n347\t\n348\tDRIVE_FORGE_POLL_INTERVAL_DEFAULT_S = 20.0\n349\t\n350\t\n351\tdef drive_forge_poll_bound_s() -> float:\n352\t    return float(os.environ.get(\"ATTAVO_DRIVE_POLL_BOUND_S\", DRIVE_FORGE_POLL_BOUND_DEFAULT_S))\n353\t\n354\t\n355\tdef drive_forge_poll_interval_s() -> float:\n356\t    return float(os.environ.get(\"ATTAVO_DRIVE_POLL_INTERVAL_S\", DRIVE_FORGE_POLL_INTERVAL_DEFAULT_S))\n357\t\n358\t\n359\tdef forge_checks_unconcluded(forge_checks: dict[str, Any]) -> bool:\n360\t    \"\"\"Whether poll_forge_checks should keep waiting rather than stop at\n361\t    once: an empty read (the forge has not attached any check to this sha\n362\t    yet) or any one check still carrying a status (queued, in_progress,\n363\t    pending, waiting) rather than a concluded conclusion. A concluded\n364\t    conclusion that is not green (failure, cancelled, timed_out, and\n365\t    anything else read_forge_checks did not recognize as ok) is not this\n366\t    -- that check is done, whether or not it passed.\"\"\"\n367\t    conclusions = forge_checks[\"conclusions\"]\n368\t    if not conclusions:\n369\t        return True\n370\t    return any(c[\"conclusion\"] in FORGE_UNCONCLUDED_STATUSES for c in conclusions)\n371\t\n372\t\n373\tdef poll_forge_checks(root: Path, checks_command: str, sha: str) -> tuple[dict[str, Any], bool]:\n374\t    \"\"\"read_forge_checks, retried within drive_forge_poll_bound_s() while\n375\t    some check is still unconcluded (forge_checks_unconcluded) -- a check\n376\t    still running is not yet red, and drive gives it a little room to\n377\t    conclude before it gives up. A read where every check has already\n378\t    concluded, green or not, stops here at once: there is nothing left to\n379\t    wait on. The bound and interval are constants this lane names, not a\n380\t    manifest key, re-read at call time so a test's own clock\n381\t    (ATTAVO_DRIVE_POLL_BOUND_S, ATTAVO_DRIVE_POLL_INTERVAL_S) never has to\n382\t    survive past when it was set.\"\"\"\n383\t    bound = drive_forge_poll_bound_s()\n384\t    interval = drive_forge_poll_interval_s()\n385\t    deadline = time.monotonic() + bound\n386\t    forge_checks, ok = read_forge_checks(root, checks_command, sha)\n387\t    while not ok and forge_checks_unconcluded(forge_checks) and time.monotonic() < deadline:\n388\t        time.sleep(interval)\n389\t        forge_checks, ok = read_forge_checks(root, checks_command, sha)\n390\t    return forge_checks, ok\n391\t"}]},"parent_tool_use_id":null,"session_id":"0dd7ed4f-100c-4188-9a34-077aa0b6aa25","uuid":"7a203e6d-18e9-4251-8595-c77e2de449dd","timestamp":"2026-09-26T02:08:39.467Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-219/attest/specs/219/stub/attavo/verify.py","content":"from __future__ import annotations\n\nimport json\nimport os\nimport shlex\nimport subprocess\nimport sys\nimport tempfile\nimport time\nfrom pathlib import Path\nfrom typing import Any\n\nfrom attavo.build import (\n    adapter_reports,\n    merge_adapter_config,\n    resolve_adapter,\n    split_adapter_stdout,\n)\nfrom attavo.common import MANIFEST, derive_item_id, git, now_iso, read_manifest\nfrom attavo.events import stage_events_dir\nfrom attavo.records import latest_attempt_path, latest_record, next_attempt_number, write_record\nfrom attavo.stops import derive_stop\n\n# --- verify: the forge's own read first, a judge only once it is green ---\n\nFORGE_OK_CONCLUSIONS = {\"success\", \"neutral\", \"skipped\"}\n\n# issue #84: a concluded check's second token is a conclusion --\n# FORGE_OK_CONCLUSIONS, or another concluded one such as failure,\n# cancelled, or timed_out; an unconcluded check's is a status instead,\n# one of these. drive's own poll (poll_forge_checks) is the one reader\n# that needs to tell a still-running check apart from a concluded, not-ok\n# one -- read_forge_checks itself only ever needed \"green or not\".\nFORGE_UNCONCLUDED_STATUSES = {\"queued\", \"in_progress\", \"pending\", \"waiting\"}\n\n\ndef read_forge_checks(root: Path, checks_command: str, sha: str) -> tuple[dict[str, Any], bool]:\n    \"\"\"Runs the tenant's [forge].checks_command on sha; the product does\n    not know what forge that command reads. One line per check as\n    \"<name> <conclusion>\"; a command that fails to run, or any conclusion\n    other than success/neutral/skipped, is not green.\"\"\"\n    run = subprocess.run(f\"{checks_command} {shlex.quote(sha)}\", shell=True, cwd=str(root),\n                         capture_output=True, text=True, check=False)\n    conclusions: list[dict[str, str]] = []\n    for line in run.stdout.splitlines():\n        line = line.strip()\n        if not line:\n            continue\n        parts = line.rsplit(\" \", 1)\n        if len(parts) == 2:\n            conclusions.append({\"name\": parts[0], \"conclusion\": parts[1]})\n    # A commit the forge has no record of is not green -- it is unread.\n    # The executor's own commit is exactly this: the forge attaches\n    # checks to a pull request's head, and that commit stops being the\n    # head the moment a record commit lands on top of it. all() over an\n    # empty list is True, which is why this is spelled out rather than\n    # implied by the loop above.\n    ok = run.returncode == 0 and bool(conclusions) and all(\n        c[\"conclusion\"] in FORGE_OK_CONCLUSIONS for c in conclusions)\n    return {\"command\": checks_command, \"sha\": sha, \"conclusions\": conclusions}, ok\n\n\ndef diff_since_approval(root: Path, approval_sha: str | None) -> tuple[str, str | None]:\n    \"\"\"(diff_text, refusal): the item's own work since approval, not\n    everything merged onto the branch since then (issue #52) -- a\n    three-dot diff against approval_sha itself is not enough, since\n    approval_sha is already an ancestor of HEAD in the normal flow and\n    merge-base(approval_sha, HEAD) is just approval_sha again (verified\n    empirically, see issue #52). Diffing from the merge-base of HEAD and\n    the remote's default branch instead excludes content that arrived by\n    merging that branch in, because that content is already present on\n    both sides of the merge base. refs/remotes/origin/HEAD is what names\n    the default branch without hard-coding \"main\"; when it is not set,\n    there is nothing to diff against and this refuses rather than guess.\n    (\"\", None) when approval_sha is falsy -- nothing to diff from at all.\n    Shared by cmd_verify and cmd_counsel, which both hand an adapter this\n    same diff.\"\"\"\n    if not approval_sha:\n        return \"\", None\n    symref = subprocess.run(\n        [\"git\", \"-C\", str(root), \"symbolic-ref\", \"-q\", \"refs/remotes/origin/HEAD\"],\n        capture_output=True, text=True, check=False)\n    if symref.returncode != 0:\n        return \"\", \"refs/remotes/origin/HEAD is not set; run `git remote set-head origin -a`\"\n    diff_base = git(root, \"merge-base\", symref.stdout.strip(), \"HEAD\").strip()\n    return git(root, \"diff\", diff_base, \"HEAD\"), None\n\n\ndef stub_ratio(diff_text: str, stub_dir: Path, excluded: tuple[str, ...]) -> float | None:\n    \"\"\"The share of the lines diff_text adds that are a line of the stub's\n    file at the same path: near 1 the build shipped the spec author's stub,\n    near 0 the builder wrote the change. Lines under the excluded\n    directories (the specs and records, where the stub itself and the\n    item's records are committed) and blank lines are not counted. None\n    when there is no stub or the diff adds no counted line -- nothing was\n    measured, which is not 0.0.\"\"\"\n    if not stub_dir.is_dir():\n        return None\n    skipped = tuple(e.strip(\"/\") for e in excluded)\n    stub_lines: dict[str, set[str]] = {}\n    path: str | None = None\n    in_hunk = False\n    added = shipped = 0\n    for line in diff_text.splitlines():\n        if line.startswith(\"diff --git \"):\n            path, in_hunk = None, False\n        elif in_hunk:\n            if line.startswith(\"+\") and line[1:].strip() and path is not None:\n                added += 1\n                shipped += line[1:].rstrip() in stub_lines[path]\n        elif line.startswith(\"+++ \"):\n            name = line[4:].split(\"\\t\")[0]\n            path = name[2:] if name.startswith(\"b/\") else None\n            if path is not None and any(path == e or path.startswith(e + \"/\") for e in skipped):\n                path = None\n            if path is not None and path not in stub_lines:\n                stub_file = stub_dir / path\n                stub_lines[path] = (\n                    {text.rstrip() for text in stub_file.read_text(errors=\"replace\").splitlines()}\n                    if stub_file.is_file() else set())\n        elif line.startswith(\"@@\"):\n            in_hunk = True\n    return shipped / added if added else None\n\n\ndef _returned_stop(forge_checks: dict[str, Any]) -> dict[str, Any]:\n    \"\"\"R3 (stub): a review returned by a concluded red required check is\n    class returned (retryable: the next build is handed the evidence); one\n    returned by checks still running is forge-unconcluded, as before.\"\"\"\n    from attavo.stops import signature_of\n    conclusions = forge_checks.get(\"conclusions\") or []\n    red = sorted(c[\"name\"] for c in conclusions\n                 if c[\"conclusion\"] not in FORGE_OK_CONCLUSIONS and c[\"conclusion\"] not in FORGE_UNCONCLUDED_STATUSES)\n    unconcluded = [c for c in conclusions if c[\"conclusion\"] in FORGE_UNCONCLUDED_STATUSES]\n    if red and not unconcluded:\n        detail = \", \".join(f\"{c['name']} {c['conclusion']}\" for c in conclusions if c[\"name\"] in red)\n        return {\"class\": \"returned\", \"provenance\": \"tenant\", \"detail\": detail,\n                \"signature\": signature_of(\" \".join(red)), \"bound\": None}\n    stop: dict[str, Any] = dict(derive_stop(\"returned\") or {})\n    return {**stop, \"signature\": None, \"bound\": None}\n\n\ndef cmd_verify(argv: list[str]) -> int:\n    root = Path(\".\").resolve()\n    item_id = argv[0] if argv else derive_item_id(root)\n    if not item_id:\n        print(\"attavo verify: cannot derive item id; pass N or run on an attavo/N-* branch\",\n              file=sys.stderr)\n        return 2\n    m = read_manifest(root)\n    if m is None:\n        print(f\"attavo verify: no {MANIFEST} at {root}\", file=sys.stderr)\n        return 2\n\n    specs_rel = m[\"paths\"][\"specs\"]\n    records_rel = m[\"paths\"][\"records\"]\n    item_records_dir = root / records_rel / item_id\n\n    latest_build = latest_record(item_records_dir, \"build\")\n    if latest_build is None:\n        print(f\"attavo verify: refused: no build record for item {item_id}\")\n        return 1\n    if latest_build.get(\"status\") != \"pass\":\n        print(f\"attavo verify: refused: latest build record is \"\n              f\"{latest_build.get('status')!r}, not pass\")\n        return 1\n\n    forge_cfg = m.get(\"forge\") or {}\n    checks_command = forge_cfg.get(\"checks_command\")\n    if not checks_command:\n        print(\"attavo verify: refused: no [forge].checks_command in the manifest\")\n        return 1\n\n    build_sha = latest_build[\"sha\"]\n    build_record_path = latest_attempt_path(item_records_dir, \"build\")\n    approval_sha = latest_build.get(\"approval_sha\")\n    spec_dir = root / specs_rel / item_id\n    started = time.monotonic()\n    head_sha = git(root, \"rev-parse\", \"HEAD\").strip()\n\n    diff_text, diff_refusal = diff_since_approval(root, approval_sha)\n    if diff_refusal:\n        print(f\"attavo verify: refused: {diff_refusal}\")\n        return 1\n    # The forge attaches checks to a pull request's head, not to the\n    # executor's own commit -- that commit stops being the head the\n    # moment a record commit lands on top of it (issue #44). Reading the\n    # forge on head_sha is what the forge actually checked and what will\n    # be merged; build_sha and forge_checks[\"sha\"] can differ, and both\n    # are kept on the record rather than one sha serving two purposes.\n    # head_sha is a marker commit just pushed (issue #178): the forge has\n    # not attached anything to it yet on the first read, so this polls\n    # with the same bound and interval the drive's own guard uses, giving\n    # those checks room to conclude before this read judges them.\n    given = os.environ.get(\"ATTAVO_FORGE_CHECKS\")\n    if given:\n        # Reconciler ruling B: the pass read the checks on the head before\n        # its marker commit and found them green; a records-only commit\n        # cannot change them (#210's proof), so the review takes that read\n        # and does not poll a head the forge has not attached anything to.\n        forge_checks = json.loads(Path(given).read_text())\n        forge_ok = bool(forge_checks.get(\"conclusions\")) and all(\n            c[\"conclusion\"] in FORGE_OK_CONCLUSIONS for c in forge_checks[\"conclusions\"])\n    else:\n        forge_checks, forge_ok = poll_forge_checks(root, checks_command, head_sha)\n\n    if not forge_ok:\n        record: dict[str, Any] = {\n            \"sha\": head_sha,\n            \"build_sha\": build_sha,\n            \"build_record\": build_record_path.stem if build_record_path else None,\n            \"approval_sha\": approval_sha,\n            \"at\": now_iso(),\n            \"adapter\": None, \"adapter_config\": {}, \"adapter_version\": None,\n            \"model\": None, \"model_version\": None,\n            \"reports\": [],\n            \"forge_checks\": forge_checks,\n            \"findings\": None,\n            \"tests_named\": [],\n            \"commits\": [],\n            \"stub_ratio\": stub_ratio(diff_text, spec_dir / \"stub\", (specs_rel, records_rel)),\n            \"tokens\": {\"input\": 0, \"output\": 0}, \"cost_usd\": None,\n            \"wall_clock_s\": round(time.monotonic() - started, 3),\n            \"status\": \"returned\",\n            \"retry_of\": None, \"steer\": None,\n            \"stop\": _returned_stop(forge_checks),\n        }\n        record_path = write_record(item_records_dir, \"verify\", record, m, item_id)\n        print(f\"attavo verify: returned ({record_path.name}); the forge checks are not green\")\n        return 0\n\n    executor = m.get(\"executor\") or {}\n    adapter_name = executor.get(\"verify\") or executor.get(\"build\")\n    if not adapter_name:\n        print(\"attavo verify: refused: no [executor].verify or [executor].build in the manifest\")\n        return 1\n    adapter_path = resolve_adapter(root, adapter_name)\n    if adapter_path is None:\n        print(f\"attavo verify: refused: no adapter named {adapter_name!r}\")\n        return 1\n\n    adapter_config = merge_adapter_config(m, adapter_name, \"verify\")\n    reports = adapter_reports(adapter_path)\n    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n\n    events_path = stage_events_dir(root) / f\"verify-{next_attempt_number(item_records_dir, 'verify'):02d}.events.jsonl\"\n\n    with tempfile.TemporaryDirectory() as tmp:\n        diff_path = Path(tmp) / \"diff.patch\"\n        diff_path.write_text(diff_text)\n\n        env = dict(os.environ)\n        env[\"ATTAVO_SPEC_DIR\"] = str(spec_dir)\n        env[\"ATTAVO_RECORDS_DIR\"] = str(item_records_dir)\n        env[\"ATTAVO_RULINGS\"] = str(root / m[\"paths\"][\"rulings\"])\n        env[\"ATTAVO_BRANCH\"] = branch\n        env[\"ATTAVO_STAGE\"] = \"verify\"\n        env[\"ATTAVO_DIFF\"] = str(diff_path)\n        env[\"ATTAVO_BUILD_RECORD\"] = str(build_record_path) if build_record_path else \"\"\n        env[\"ATTAVO_ADAPTER_CONFIG\"] = json.dumps(adapter_config)\n        env[\"ATTAVO_EVENTS\"] = str(events_path)\n\n        run = subprocess.run([str(adapter_path)], cwd=str(root), env=env,\n                             capture_output=True, text=True, check=False)\n        transcript, payload = split_adapter_stdout(run.stdout)\n        if run.returncode != 0:\n            # Same guarantee as cmd_build's, issue #53: a non-zero adapter\n            # exit always leaves a non-empty log.\n            detail = f\"[adapter exited {run.returncode}]\"\n            if run.stderr.strip():\n                detail += \"\\n\" + run.stderr.rstrip(\"\\n\")\n            transcript = (transcript + \"\\n\" if transcript else \"\") + detail\n\n    # Verify is a report, not a commit (issue #46): the adapter is invoked\n    # on the branch head it was handed, and must leave that head alone.\n    # Checked by comparing the head before the invocation (head_sha,\n    # already read above for the forge) against the head after it.\n    post_adapter_head = git(root, \"rev-parse\", \"HEAD\").strip()\n    commits: list[str] = []\n    if post_adapter_head != head_sha:\n        commits = git(root, \"rev-list\", f\"{head_sha}..{post_adapter_head}\", \"--reverse\").split()\n\n    status_out = \"failed\"\n    findings = None\n    tests_named: list[str] = []\n    model = model_version = adapter_version_out = None\n    tokens = {\"input\": 0, \"output\": 0}\n    cost_usd = None\n\n    if run.returncode == 0 and payload is not None and payload.get(\"model\"):\n        model = payload.get(\"model\")\n        model_version = payload.get(\"model_version\")\n        adapter_version_out = payload.get(\"adapter_version\")\n        tok = payload.get(\"tokens\") or {}\n        tokens = {\"input\": tok.get(\"input\", 0) or 0, \"output\": tok.get(\"output\", 0) or 0}\n        cost_usd = payload.get(\"cost_usd\")\n        # \"findings\" absent (or explicitly null) is not the same as an\n        # empty list: the adapter had no channel to report one at all,\n        # which is not a clean bill of health (issue #46). A commit\n        # during verify fails the attempt regardless of what it reported.\n        if not commits and \"findings\" in payload and payload[\"findings\"] is not None:\n            findings = payload[\"findings\"]\n            tests_named = payload.get(\"tests_named\") or []\n            status_out = \"pass\"\n\n    record = {\n        \"sha\": head_sha,\n        \"build_sha\": build_sha,\n        \"build_record\": build_record_path.stem if build_record_path else None,\n        \"approval_sha\": approval_sha,\n        \"at\": now_iso(),\n        \"adapter\": adapter_name,\n        \"adapter_config\": adapter_config,\n        \"adapter_version\": adapter_version_out,\n        \"model\": model,\n        \"model_version\": model_version,\n        \"reports\": reports,\n        \"forge_checks\": forge_checks,\n        \"findings\": findings,\n        \"tests_named\": tests_named,\n        \"commits\": commits,\n        \"stub_ratio\": stub_ratio(diff_text, spec_dir / \"stub\", (specs_rel, records_rel)),\n        \"tokens\": tokens,\n        \"cost_usd\": cost_usd,\n        \"wall_clock_s\": round(time.monotonic() - started, 3),\n        \"status\": status_out,\n        \"stop\": derive_stop(status_out, log=transcript,\n                            report_class=(payload or {}).get(\"class\")),\n    }\n    record_path = write_record(item_records_dir, \"verify\", record, m, item_id, log=transcript)\n\n    print(f\"attavo verify: {status_out} ({record_path.name})\")\n    return 0 if status_out == \"pass\" else 1\n\n\n# issue #84: a constant the lane names, not a manifest key, until a tenant\n# disagrees -- how long drive gives a forge's checks room to conclude\n# before it gives up and stops rather than call a judge on a tree the\n# forge has not yet finished reading. Tenant zero's own checks conclude\n# about five minutes after a push; the default bound gives them room to\n# finish so a person is not the one re-running drive after CI, which is\n# exactly the transport act this lane retires. ATTAVO_DRIVE_POLL_BOUND_S\n# and ATTAVO_DRIVE_POLL_INTERVAL_S, read at call time rather than once at\n# import, are for a test's own clock, not a tenant's -- there is no\n# manifest key for either.\nDRIVE_FORGE_POLL_BOUND_DEFAULT_S = 600.0\n\nDRIVE_FORGE_POLL_INTERVAL_DEFAULT_S = 20.0\n\n\ndef drive_forge_poll_bound_s() -> float:\n    return float(os.environ.get(\"ATTAVO_DRIVE_POLL_BOUND_S\", DRIVE_FORGE_POLL_BOUND_DEFAULT_S))\n\n\ndef drive_forge_poll_interval_s() -> float:\n    return float(os.environ.get(\"ATTAVO_DRIVE_POLL_INTERVAL_S\", DRIVE_FORGE_POLL_INTERVAL_DEFAULT_S))\n\n\ndef forge_checks_unconcluded(forge_checks: dict[str, Any]) -> bool:\n    \"\"\"Whether poll_forge_checks should keep waiting rather than stop at\n    once: an empty read (the forge has not attached any check to this sha\n    yet) or any one check still carrying a status (queued, in_progress,\n    pending, waiting) rather than a concluded conclusion. A concluded\n    conclusion that is not green (failure, cancelled, timed_out, and\n    anything else read_forge_checks did not recognize as ok) is not this\n    -- that check is done, whether or not it passed.\"\"\"\n    conclusions = forge_checks[\"conclusions\"]\n    if not conclusions:\n        return True\n    return any(c[\"conclusion\"] in FORGE_UNCONCLUDED_STATUSES for c in conclusions)\n\n\ndef poll_forge_checks(root: Path, checks_command: str, sha: str) -> tuple[dict[str, Any], bool]:\n    \"\"\"read_forge_checks, retried within drive_forge_poll_bound_s() while\n    some check is still unconcluded (forge_checks_unconcluded) -- a check\n    still running is not yet red, and drive gives it a little room to\n    conclude before it gives up. A read where every check has already\n    concluded, green or not, stops here at once: there is nothing left to\n    wait on. The bound and interval are constants this lane names, not a\n    manifest key, re-read at call time so a test's own clock\n    (ATTAVO_DRIVE_POLL_BOUND_S, ATTAVO_DRIVE_POLL_INTERVAL_S) never has to\n    survive past when it was set.\"\"\"\n    bound = drive_forge_poll_bound_s()\n    interval = drive_forge_poll_interval_s()\n    deadline = time.monotonic() + bound\n    forge_checks, ok = read_forge_checks(root, checks_command, sha)\n    while not ok and forge_checks_unconcluded(forge_checks) and time.monotonic() < deadline:\n        time.sleep(interval)\n        forge_checks, ok = read_forge_checks(root, checks_command, sha)\n    return forge_checks, ok\n","numLines":391,"startLine":1,"totalLines":391}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Pspr9a5dSfYj638N5ykTPH","type":"tool_result","content":"1\t\"\"\"The executor conformance suite (issue #40): the entrance exam a second\n2\tadapter passes before it is pointed at a tenant. Every situation here is a\n3\tclaude-code specimen from the last week of Lane 2, stated as contract\n4\tagainst the adapter's own two test hooks -- ATTAVO_ADAPTER_DRY_RUN and\n5\tATTAVO_ADAPTER_RESPONSE_FILE -- rather than against claude-code's own\n6\tmodule path, so a second adapter inherits it by declaring a\n7\tconformance.json, not by copying a test file.\n8\t\n9\tEach adapter under adapters/ (except NOT_AN_EXECUTOR) declares its own\n10\tconformance.json: {\"dry_run_env\": \"<VAR>\", \"response_env\": \"<VAR>\",\n11\t\"tool_binary\": \"<name>\", \"success_script\": \"<shell text>\",\n12\t\"reports\": [\"<field>\", ...], \"situations\": {\"<name>\": <canned response>}}.\n13\tdry_run_env and response_env are the two hooks tests/test_adapters.py\n14\talready exercised for claude-code (issues #24, #30, #34); tool_binary is\n15\tthe name of the executable the adapter shells out to when neither hook\n16\tis set, needed to fake a non-zero exit from it (situation 5) without a\n17\tmodel in the loop. success_script and reports are issue #41's, once a\n18\tsecond adapter (codex) proved the first two claude-code-shaped: a\n19\tcanned \"done\" response's shape and a fake tool's own successful output\n20\tare each adapter's private contract, not this file's assumption.\n21\t\n22\tdry_run()'s own envelope -- {\"argv\", \"instruction\", \"schema\"} -- is\n23\tissue #41's too. argv alone was claude-code's shape: its instruction\n24\tlives in argv's own \"-p\" value, but codex delivers its instruction on\n25\tstdin, where argv carries none at all, so the suite reads \"instruction\"\n26\tand \"schema\" directly rather than parsing either out of argv.\n27\t\n28\tSituation 8: a commit the adapter makes carries the identity attavo build\n29\texports (issue #33) -- checked by faking the adapter's own tool_binary on\n30\tPATH, the same technique situation 5 uses, so the fake tool can commit\n31\tfor real inside a throwaway repo without a model in the loop. Its own\n32\tcanned \"success_script\" (above) is what lets this generalize past\n33\tclaude-code's single-JSON-blob response shape.\n34\t\n35\tSituation 12: vendor independence (2026-09-09 ruling) -- an adapter's\n36\tdeclared \"reports\" fields must actually be non-null on a \"done\" run, so\n37\ta silent measurement gap fails the suite instead of writing one.\n38\t\n39\tSituations 20 and 21: the executor sees none of the adapter's contract\n40\t(issue #198) -- no ATTAVO_* name reaches the process an adapter launches,\n41\tso nothing the executor runs can read the item's live events file, let\n42\talone append to it.\n43\t\n44\tRun: python3 -m pytest tests/test_executor_conformance.py -q\n45\t\"\"\"\n46\timport json\n47\timport os\n48\timport subprocess\n49\tfrom pathlib import Path\n50\tfrom typing import Any, cast\n51\t\n52\timport pytest\n53\t\n54\tfrom helpers import FIXTURES\n55\t\n56\tROOT = Path(__file__).resolve().parent.parent\n57\tADAPTERS_DIR = ROOT / \"adapters\"\n58\t\n59\t# Not an executor: adapters/fixture/run exists for the tests and the\n60\t# doctor, has no canned-response hook, and is never pointed at a tenant.\n61\tNOT_AN_EXECUTOR = {\"fixture\"}\n62\t\n63\tMIN_QUESTION_CHARS = 40\n64\t\n65\t\n66\tdef find_adapters_without_conformance(adapters_dir: Path) -> list[str]:\n67\t    \"\"\"Every directory under adapters_dir, other than NOT_AN_EXECUTOR,\n68\t    that carries no conformance.json -- named, so a second adapter cannot\n69\t    join by declaring nothing.\"\"\"\n70\t    missing: list[str] = []\n71\t    if not adapters_dir.is_dir():\n72\t        return missing\n73\t    for d in sorted(p for p in adapters_dir.iterdir() if p.is_dir()):\n74\t        if d.name in NOT_AN_EXECUTOR:\n75\t            continue\n76\t        if not (d / \"conformance.json\").is_file():\n77\t            missing.append(d.name)\n78\t    return missing\n79\t\n80\t\n81\tdef load_conformance() -> dict[str, dict[str, Any]]:\n82\t    manifests = {}\n83\t    for name in sorted(p.name for p in ADAPTERS_DIR.iterdir() if p.is_dir()):\n84\t        if name in NOT_AN_EXECUTOR:\n85\t            continue\n86\t        manifest_path = ADAPTERS_DIR / name / \"conformance.json\"\n87\t        if manifest_path.is_file():\n88\t            manifests[name] = json.loads(manifest_path.read_text())\n89\t    return manifests\n90\t\n91\t\n92\tCONFORMANCE = load_conformance()\n93\tADAPTER_NAMES = sorted(CONFORMANCE)\n94\t\n95\t\n96\tdef base_env(tmp_path: Path) -> dict[str, Any]:\n97\t    spec_dir = FIXTURES / \"build_valid\" / \"specs\" / \"1\"\n98\t    env = dict(os.environ)\n99\t    env.pop(\"ATTAVO_CHECKS_COMMAND\", None)\n100\t    env.pop(\"ATTAVO_TEST_COMMAND\", None)\n101\t    env.pop(\"ATTAVO_TEST_TIMEOUT_S\", None)\n102\t    # codex's own auth guard (issue #41) refuses \"subscription\" (the\n103\t    # default) when this is set -- absent here regardless of what the\n104\t    # ambient shell running these tests happens to carry, so the suite\n105\t    # never depends on the operator's own environment.\n106\t    env.pop(\"OPENAI_API_KEY\", None)\n107\t    env.update({\n108\t        \"ATTAVO_SPEC_DIR\": str(spec_dir),\n109\t        \"ATTAVO_RECORDS_DIR\": str(tmp_path / \"records\"),\n110\t        \"ATTAVO_RULINGS\": str(tmp_path / \"rulings.md\"),\n111\t        \"ATTAVO_BRANCH\": \"attavo/1-example\",\n112\t        \"ATTAVO_ITERATION\": \"1\",\n113\t        \"ATTAVO_FEEDBACK\": str(tmp_path / \"feedback.txt\"),\n114\t        # codex requires [executor.codex].model (issue #41); harmless\n115\t        # for claude-code, which treats every key here as optional.\n116\t        \"ATTAVO_ADAPTER_CONFIG\": json.dumps({\"model\": \"test-model\"}),\n117\t    })\n118\t    return env\n119\t\n120\t\n121\tdef run_adapter(adapter_name: str, env: dict[str, Any], cwd: Path | None = None) -> subprocess.CompletedProcess[str]:\n122\t    run_path = ADAPTERS_DIR / adapter_name / \"run\"\n123\t    return subprocess.run([str(run_path)], capture_output=True, text=True,\n124\t                          check=False, env=env, cwd=str(cwd) if cwd else None)\n125\t\n126\t\n127\tdef dry_run(adapter_name: str, tmp_path: Path, extra_env: dict[str, Any] | None = None) -> dict[str, Any]:\n128\t    \"\"\"{\"argv\", \"instruction\", \"schema\"}: the instruction and the schema\n129\t    named separately from argv, because a second adapter (issue #41)\n130\t    delivers the instruction on stdin, where argv itself carries none.\"\"\"\n131\t    manifest = CONFORMANCE[adapter_name]\n132\t    env = base_env(tmp_path)\n133\t    env[manifest[\"dry_run_env\"]] = \"1\"\n134\t    if extra_env:\n135\t        env.update(extra_env)\n136\t    run = run_adapter(adapter_name, env)\n137\t    assert run.returncode == 0, run.stderr\n138\t    return cast(dict[str, Any], json.loads(run.stdout))\n139\t\n140\t\n141\tdef run_situation(adapter_name: str, situation: str, tmp_path: Path,\n142\t                  extra_env: dict[str, Any] | None = None) -> subprocess.CompletedProcess[str]:\n143\t    manifest = CONFORMANCE[adapter_name]\n144\t    response = manifest[\"situations\"][situation]\n145\t    response_file = tmp_path / \"response.json\"\n146\t    response_file.write_text(json.dumps(response))\n147\t    env = base_env(tmp_path)\n148\t    env[manifest[\"response_env\"]] = str(response_file)\n149\t    if extra_env:\n150\t        env.update(extra_env)\n151\t    return run_adapter(adapter_name, env)\n152\t\n153\t\n154\tdef test_every_executor_adapter_declares_conformance() -> None:\n155\t    \"\"\"Acceptance 3 (real check, against this repository's own adapters/).\"\"\"\n156\t    missing = find_adapters_without_conformance(ADAPTERS_DIR)\n157\t    assert not missing, f\"adapter(s) with no conformance.json: {', '.join(missing)}\"\n158\t\n159\t\n160\tdef test_find_adapters_without_conformance_names_the_directory(tmp_path: Path) -> None:\n161\t    \"\"\"Acceptance 3 (fixture): a directory with no conformance.json is\n162\t    named, without touching the real adapters/ tree.\"\"\"\n163\t    adapters_dir = tmp_path / \"adapters\"\n164\t    declared = adapters_dir / \"declared\"\n165\t    declared.mkdir(parents=True)\n166\t    (declared / \"run\").write_text(\"#!/bin/sh\\n\")\n167\t    (declared / \"conformance.json\").write_text(\"{}\")\n168\t\n169\t    undeclared = adapters_dir / \"undeclared\"\n170\t    undeclared.mkdir(parents=True)\n171\t    (undeclared / \"run\").write_text(\"#!/bin/sh\\n\")\n172\t\n173\t    assert find_adapters_without_conformance(adapters_dir) == [\"undeclared\"]\n174\t\n175\t\n176\t@pytest.mark.parametrize(\"adapter_name\", ADAPTER_NAMES)\n177\tdef test_situation_1_report_line_is_last_and_has_a_model(adapter_name: str, tmp_path: Path) -> None:\n178\t    run = run_situation(adapter_name, \"done\", tmp_path)\n179\t    assert run.returncode == 0, run.stderr\n180\t    lines = [l for l in run.stdout.splitlines() if l.strip()]\n181\t    report = json.loads(lines[-1])\n182\t    assert report.get(\"model\")\n183\t\n184\t\n185\t@pytest.mark.parametrize(\"adapter_name\", ADAPTER_NAMES)\n186\tdef test_situation_2_tool_error_fails_and_prints_the_result(adapter_name: str, tmp_path: Path) -> None:\n187\t    run = run_situation(adapter_name, \"is_error\", tmp_path)\n188\t    assert run.returncode != 0\n189\t    assert run.stdout.strip(), \"the raw result must still reach stdout\"\n190\t\n191\t\n192\t@pytest.mark.parametrize(\"adapter_name\", ADAPTER_NAMES)\n193\tdef test_situation_3_no_structured_output_fails(adapter_name: str, tmp_path: Path) -> None:\n194\t    run = run_situation(adapter_name, \"no_structured_output\", tmp_path)\n195\t    assert run.returncode != 0\n196\t\n197\t\n198\t@pytest.mark.parametrize(\"adapter_name\", ADAPTER_NAMES)\n199\tdef test_situation_4_question_quality_gates_the_halt(adapter_name: str, tmp_path: Path) -> None:\n200\t    # An absent, empty, or short question is a report in the question\n201\t    # channel (issue #150): the adapter re-invokes once and, when the\n202\t    # retry yields nothing better, reports class non-question with the\n203\t    # tokens of both turns kept -- never an exit with no report line.\n204\t    for situation in (\"question_null\", \"question_empty\", \"question_short\"):\n205\t        run = run_situation(adapter_name, situation, tmp_path)\n206\t        assert run.returncode == 0, f\"{situation}: {run.stderr}\"\n207\t        report = json.loads(run.stdout.splitlines()[-1])\n208\t        assert report[\"status\"] == \"question\", (situation, report)\n209\t        assert report[\"class\"] == \"non-question\", (situation, report)\n210\t\n211\t    run = run_situation(adapter_name, \"question_long\", tmp_path)\n212\t    assert run.returncode == 0, run.stderr\n213\t    report = json.loads(run.stdout.splitlines()[-1])\n214\t    assert report[\"status\"] == \"question\"\n215\t\n216\t\n217\t@pytest.mark.parametrize(\"adapter_name\", ADAPTER_NAMES)\n218\tdef test_situation_5_underlying_tool_nonzero_exit_passes_through(adapter_name: str, tmp_path: Path) -> None:\n219\t    \"\"\"A fake <tool_binary> on PATH that writes to both of its streams and\n220\t    exits 3: the adapter exits 3, and its own stdout -- the only stream\n221\t    build-NN.log is built from -- carries both of the tool's streams.\n222\t    \"\"\"\n223\t    manifest = CONFORMANCE[adapter_name]\n224\t    tool_binary = manifest[\"tool_binary\"]\n225\t\n226\t    fake_bin = tmp_path / \"fakebin\"\n227\t    fake_bin.mkdir()\n228\t    fake_tool = fake_bin / tool_binary\n229\t    fake_tool.write_text(\n230\t        \"#!/bin/sh\\n\"\n231\t        \"echo 'tool stdout: ran out of budget'\\n\"\n232\t        \"echo 'tool stderr: overloaded_error' >&2\\n\"\n233\t        \"exit 3\\n\")\n234\t    fake_tool.chmod(0o755)\n235\t\n236\t    env = base_env(tmp_path)\n237\t    env[\"PATH\"] = f\"{fake_bin}{os.pathsep}{env.get('PATH', '')}\"\n238\t\n239\t    run = run_adapter(adapter_name, env)\n240\t    assert run.returncode == 3\n241\t    assert \"tool stdout: ran out of budget\" in run.stdout\n242\t    assert \"tool stderr: overloaded_error\" in run.stdout\n243\t\n244\t\n245\t@pytest.mark.parametrize(\"adapter_name\", ADAPTER_NAMES)\n246\tdef test_situation_6_transcript_non_empty_on_every_path(adapter_name: str, tmp_path: Path) -> None:\n247\t    for situation in (\"done\", \"is_error\", \"no_structured_output\", \"question_short\"):\n248\t        run = run_situation(adapter_name, situation, tmp_path)\n249\t        assert run.stdout.strip(), f\"{situation} produced no transcript at all\"\n250\t\n251\t\n252\t@pytest.mark.parametrize(\"adapter_name\", ADAPTER_NAMES)\n253\tdef test_situation_7_the_one_test_command_in_the_invocation(adapter_name: str, tmp_path: Path) -> None:\n254\t    \"\"\"The executor is given one test command and no whole-tree command.\n255\t    Naming the tenant's checks in the instruction made the executor their\n256\t    runner however the sentence was worded (tenant zero build-10; #194's\n257\t    590 s wait; #204 and #206, where the whole suite was run twice inside\n258\t    one build), so the checks command is not in the instruction at all.\"\"\"\n259\t    command = \"python3 /product/bin/attavo test 7\"\n260\t    checks = \"python3 bin/factory-lane check --base origin/main\"\n261\t    given = dry_run(adapter_name, tmp_path, extra_env={\n262\t        \"ATTAVO_TEST_COMMAND\": command, \"ATTAVO_TEST_TIMEOUT_S\": \"240\",\n263\t        \"ATTAVO_CHECKS_COMMAND\": checks})\n264\t    assert command in given[\"instruction\"]\n265\t    assert \"240 s\" in given[\"instruction\"]\n266\t    assert checks not in given[\"instruction\"]\n267\t\n268\t    without = dry_run(adapter_name, tmp_path)\n269\t    assert command not in without[\"instruction\"]\n270\t    assert \"attavo test\" not in without[\"instruction\"]\n271\t\n272\t\n273\t@pytest.mark.parametrize(\"adapter_name\", ADAPTER_NAMES)\n274\tdef test_situation_8_commits_carry_the_attavo_build_identity(adapter_name: str, tmp_path: Path) -> None:\n275\t    \"\"\"Issue #33. attavo build exports the executor identity -- set by the\n276\t    product, never the tenant's git config -- as GIT_AUTHOR_NAME/EMAIL and\n277\t    GIT_COMMITTER_NAME/EMAIL before invoking the adapter; the adapter must\n278\t    pass it through rather than setting its own explicit environment for\n279\t    the underlying tool. The fake tool_binary here commits for real, so\n280\t    this checks the adapter's own subprocess call, not just the harness.\n281\t    Regression: the specimen is attavo/code-factory@e22fa85, an executor\n282\t    commit indistinguishable in git log from the operator's own, because\n283\t    no identity was exported for it to carry.\n284\t    \"\"\"\n285\t    manifest = CONFORMANCE[adapter_name]\n286\t    tool_binary = manifest[\"tool_binary\"]\n287\t\n288\t    repo = tmp_path / \"repo\"\n289\t    repo.mkdir()\n290\t    subprocess.run([\"git\", \"init\", \"-q\", \"-b\", \"main\"], cwd=str(repo), check=True)\n291\t    subprocess.run([\"git\", \"config\", \"user.name\", \"a tenant operator\"], cwd=str(repo), check=True)\n292\t    subprocess.run([\"git\", \"config\", \"user.email\", \"operator@example.com\"], cwd=str(repo), check=True)\n293\t    (repo / \"README.md\").write_text(\"seed\\n\")\n294\t    subprocess.run([\"git\", \"add\", \"-A\"], cwd=str(repo), check=True)\n295\t    subprocess.run([\"git\", \"commit\", \"-q\", \"-m\", \"seed\"], cwd=str(repo), check=True)\n296\t\n297\t    fake_bin = tmp_path / \"fakebin\"\n298\t    fake_bin.mkdir()\n299\t    fake_tool = fake_bin / tool_binary\n300\t    # A successful invocation's own shape is per-adapter (claude-code's\n301\t    # single JSON blob vs. codex's JSONL-plus-output-file), so each\n302\t    # adapter declares its own script rather than this file assuming\n303\t    # one -- assuming claude-code's shape here was itself the\n304\t    # claude-code-ism issue #41 found building a second adapter.\n305\t    fake_tool.write_text(manifest[\"success_script\"])\n306\t    fake_tool.chmod(0o755)\n307\t\n308\t    identity_name = f\"attavo executor ({adapter_name})\"\n309\t    identity_email = f\"executor+{adapter_name}@attavo.invalid\"\n310\t    env = base_env(tmp_path)\n311\t    env[\"PATH\"] = f\"{fake_bin}{os.pathsep}{env.get('PATH', '')}\"\n312\t    env[\"GIT_AUTHOR_NAME\"] = identity_name\n313\t    env[\"GIT_AUTHOR_EMAIL\"] = identity_email\n314\t    env[\"GIT_COMMITTER_NAME\"] = identity_name\n315\t    env[\"GIT_COMMITTER_EMAIL\"] = identity_email\n316\t\n317\t    run = run_adapter(adapter_name, env, cwd=repo)\n318\t    assert run.returncode == 0, run.stderr\n319\t\n320\t    log = subprocess.run([\"git\", \"-C\", str(repo), \"log\", \"-1\", \"--format=%an/%ae\"],\n321\t                         capture_output=True, text=True, check=True).stdout.strip()\n322\t    assert log == f\"{identity_name}/{identity_email}\"\n323\t\n324\t\n325\t@pytest.mark.parametrize(\"adapter_name\", ADAPTER_NAMES)\n326\tdef test_situation_9_verify_stage_uses_a_findings_schema(adapter_name: str, tmp_path: Path) -> None:\n327\t    \"\"\"Issue #46, rejection test 3. With ATTAVO_STAGE=verify, the\n328\t    invocation names a response shape carrying findings and tests_named\n329\t    -- not build's status/question. Red at 699f56d for claude-code,\n330\t    where ATTAVO_STAGE was read nowhere and every invocation got the\n331\t    build schema.\n332\t    \"\"\"\n333\t    schema = dry_run(adapter_name, tmp_path, extra_env={\"ATTAVO_STAGE\": \"verify\"})[\"schema\"]\n334\t    assert \"findings\" in schema.get(\"properties\", {})\n335\t    assert \"tests_named\" in schema.get(\"properties\", {})\n336\t\n337\t\n338\t@pytest.mark.parametrize(\"adapter_name\", ADAPTER_NAMES)\n339\tdef test_situation_10_verify_names_approval_commit_divergence_as_reportable(adapter_name: str, tmp_path: Path) -> None:\n340\t    \"\"\"Issue #48, rejection test 1. With ATTAVO_STAGE=verify, the\n341\t    invocation's instruction names a spec whose approval commit does\n342\t    not describe the working tree as itself a reportable finding --\n343\t    issue #4's absorption, specified in issue #40's section 2, lost\n344\t    between issue #40 and issue #46. Red at d04b484, where\n345\t    verify_instruction() never said this.\n346\t    \"\"\"\n347\t    instruction = dry_run(adapter_name, tmp_path, extra_env={\"ATTAVO_STAGE\": \"verify\"})[\"instruction\"]\n348\t    assert \"approval commit\" in instruction\n349\t    assert \"reportable\" in instruction\n350\t\n351\t\n352\t@pytest.mark.parametrize(\"adapter_name\", ADAPTER_NAMES)\n353\tdef test_situation_11_verify_defines_severity_as_derived(adapter_name: str, tmp_path: Path) -> None:\n354\t    \"\"\"Issue #48, rejection test 2. With ATTAVO_STAGE=verify, the\n355\t    invocation's instruction defines severity as derived rather than\n356\t    judged. Red at d04b484, where severity was named once in the\n357\t    finding fields and defined nowhere.\n358\t    \"\"\"\n359\t    instruction = dry_run(adapter_name, tmp_path, extra_env={\"ATTAVO_STAGE\": \"verify\"})[\"instruction\"]\n360\t    assert \"severity\" in instruction\n361\t    assert \"derived rather than judged\" in instruction\n362\t\n363\t\n364\t@pytest.mark.parametrize(\"adapter_name\", ADAPTER_NAMES)\n365\tdef test_situation_12_adapter_supplies_every_field_it_declares(adapter_name: str, tmp_path: Path) -> None:\n366\t    \"\"\"Vendor independence (2026-09-09 ruling). conformance.json's\n367\t    \"reports\" names the fields this adapter can supply with a real\n368\t    value -- an adapter claiming a field and returning null for it is a\n369\t    silent measurement gap, not a legitimate absence, and this fails\n370\t    the suite instead of writing one. Dollars are never summed across\n371\t    executors; absent is null, never zero or blank -- this situation is\n372\t    what makes an adapter's null trustworthy as \"not reported by this\n373\t    executor\" rather than \"forgot to report it\".\n374\t    \"\"\"\n375\t    manifest = CONFORMANCE[adapter_name]\n376\t    reports = manifest.get(\"reports\", [])\n377\t    run = run_situation(adapter_name, \"done\", tmp_path)\n378\t    assert run.returncode == 0, run.stderr\n379\t    report = json.loads(run.stdout.splitlines()[-1])\n380\t    for field in reports:\n381\t        assert report.get(field) is not None, (\n382\t            f\"{adapter_name} declares {field!r} in its reports but a done \"\n383\t            f\"run's own report line carries none\")\n384\t\n385\t\n386\t@pytest.mark.parametrize(\"adapter_name\", ADAPTER_NAMES)\n387\tdef test_situation_13_subagent_guard_is_declared(adapter_name: str, tmp_path: Path) -> None:\n388\t    \"\"\"Issue #88, rejection test (class B, general across any adapter).\n389\t    Every adapter's conformance.json names subagent_guard.supported: an\n390\t    adapter naming neither a working check nor an admitted inability is\n391\t    an undeclared blind spot, not a legitimate absence (mirrors\n392\t    situation 12's vendor-independence ruling). A supported adapter's\n393\t    named situation must refuse the run -- naming the tool's own counts\n394\t    -- rather than reporting done on work that can outlive it; an\n395\t    unsupported adapter must say why it cannot check at all.\n396\t    \"\"\"\n397\t    manifest = CONFORMANCE[adapter_name]\n398\t    guard = manifest.get(\"subagent_guard\")\n399\t    assert guard is not None, f\"{adapter_name} declares no subagent_guard\"\n400\t    assert isinstance(guard.get(\"supported\"), bool), (\n401\t        f\"{adapter_name}'s subagent_guard.supported must be true or false\")\n402\t\n403\t    if guard[\"supported\"]:\n404\t        run = run_situation(adapter_name, guard[\"situation\"], tmp_path)\n405\t        assert run.returncode != 0, (\n406\t            f\"{adapter_name} accepted a run with spawned background work \"\n407\t            \"as done\")\n408\t        transcript = run.stdout + run.stderr\n409\t        assert \"subagent\" in transcript.lower()\n410\t    else:\n411\t        assert guard.get(\"reason\"), (\n412\t            f\"{adapter_name} declares subagent_guard.supported: false \"\n413\t            \"with no reason\")\n414\t\n415\t\n416\t@pytest.mark.parametrize(\"adapter_name\", ADAPTER_NAMES)\n417\tdef test_situation_14_input_limit_is_declared(adapter_name: str, tmp_path: Path) -> None:\n418\t    \"\"\"Issue #93, rejection test 1. Every adapter's conformance.json\n419\t    names input_limit: a unit and a number (as the tool documents it),\n420\t    or a null value and a reason (mirrors situation 13's vendor-\n421\t    independence pattern: an adapter naming neither is an undeclared\n422\t    blind spot, not a legitimate absence).\"\"\"\n423\t    manifest = CONFORMANCE[adapter_name]\n424\t    limit = manifest.get(\"input_limit\")\n425\t    assert limit is not None, f\"{adapter_name} declares no input_limit\"\n426\t\n427\t    if limit.get(\"value\") is not None:\n428\t        assert limit.get(\"unit\") in (\"chars\", \"tokens\"), (\n429\t            f\"{adapter_name}'s input_limit has a value but no chars/tokens unit\")\n430\t    else:\n431\t        assert limit.get(\"reason\"), (\n432\t            f\"{adapter_name}'s input_limit has no value and no reason\")\n433\t\n434\t\n435\tdef counsel_extra_env(tmp_path: Path) -> dict[str, Any]:\n436\t    \"\"\"Issue #100: the record, its log, the diff, the tenant manifest,\n437\t    and this product's own root, all handed by path -- the general\n438\t    contract every adapter's counsel stage shares.\"\"\"\n439\t    record_path = tmp_path / \"build-01.json\"\n440\t    record_path.write_text(json.dumps({\"status\": \"halted\"}))\n441\t    log_path = tmp_path / \"build-01.log\"\n442\t    log_path.write_text(\"adapter transcript\\n\")\n443\t    diff_path = tmp_path / \"diff.patch\"\n444\t    diff_path.write_text(\"diff --git a/x.py b/x.py\\n\")\n445\t    manifest_path = tmp_path / \"attavo.toml\"\n446\t    manifest_path.write_text(\"schema_version = 1\\n\")\n447\t    return {\n448\t        \"ATTAVO_STAGE\": \"counsel\",\n449\t        \"ATTAVO_COUNSEL_RECORD\": str(record_path),\n450\t        \"ATTAVO_COUNSEL_LOG\": str(log_path),\n451\t        \"ATTAVO_COUNSEL_DIFF\": str(diff_path),\n452\t        \"ATTAVO_MANIFEST\": str(manifest_path),\n453\t        \"ATTAVO_PRODUCT_ROOT\": str(ROOT),\n454\t    }\n455\t\n456\t\n457\t@pytest.mark.parametrize(\"adapter_name\", ADAPTER_NAMES)\n458\tdef test_situation_16_counsel_stage_is_declared(adapter_name: str) -> None:\n459\t    \"\"\"Issue #100, acceptance row 4. Every adapter's conformance.json\n460\t    names \"counsel\" among its declared stages -- an adapter naming none\n461\t    is not one this lane has pointed at the counsel stage.\"\"\"\n462\t    manifest = CONFORMANCE[adapter_name]\n463\t    stages = manifest.get(\"stages\")\n464\t    assert stages is not None and \"counsel\" in stages, (\n465\t        f\"{adapter_name} declares no counsel stage\")\n466\t\n467\t\n468\t@pytest.mark.parametrize(\"adapter_name\", ADAPTER_NAMES)\n469\tdef test_situation_17_counsel_names_the_product_root_and_the_record(adapter_name: str, tmp_path: Path) -> None:\n470\t    \"\"\"Issue #100, acceptance row 4. The counsel instruction names this\n471\t    product's own root and the record path handed to it, and its schema\n472\t    requires the structured answer (class, verdict, citations, proposal).\"\"\"\n473\t    extra = counsel_extra_env(tmp_path)\n474\t    result = dry_run(adapter_name, tmp_path, extra_env=extra)\n475\t    instruction = result[\"instruction\"]\n476\t\n477\t    assert str(ROOT) in instruction\n478\t    assert extra[\"ATTAVO_COUNSEL_RECORD\"] in instruction\n479\t    schema_required = set(result[\"schema\"].get(\"required\", []))\n480\t    assert schema_required == {\"class\", \"verdict\", \"citations\", \"proposal\"}\n481\t\n482\t\n483\t@pytest.mark.parametrize(\"adapter_name\", ADAPTER_NAMES)\n484\tdef test_situation_18_counsel_instruction_stays_under_the_bound_with_large_files(\n485\t        adapter_name: str, tmp_path: Path) -> None:\n486\t    \"\"\"Issue #100, acceptance row 4. A 2 MB record log and diff both leave\n487\t    the counsel instruction under the fixed bound -- the same guarantee\n488\t    build and verify already carry (issue #86), so counsel does not\n489\t    reintroduce the ceiling regression on its own new files.\"\"\"\n490\t    FIXED_BOUND_CHARS = 65536\n491\t\n492\t    extra = counsel_extra_env(tmp_path)\n493\t    large_log = make_large_file(tmp_path / \"build-01.log\", diff_like=False)\n494\t    large_diff = make_large_file(tmp_path / \"diff.patch\", diff_like=True)\n495\t    extra[\"ATTAVO_COUNSEL_LOG\"] = str(large_log)\n496\t    extra[\"ATTAVO_COUNSEL_DIFF\"] = str(large_diff)\n497\t\n498\t    result = dry_run(adapter_name, tmp_path, extra_env=extra)\n499\t    assert len(result[\"instruction\"].encode()) < FIXED_BOUND_CHARS\n500\t\n501\t\n502\tdef test_situation_19_codex_writes_events_when_attavo_events_is_set(tmp_path: Path) -> None:\n503\t    \"\"\"Issue #138, acceptance row 2. With ATTAVO_EVENTS set, the codex\n504\t    adapter maps its own JSONL stream to the same {at, kind, text}\n505\t    shape claude-code already writes -- checked through the\n506\t    conformance suite's existing canned-response hook, since codex's\n507\t    own invoke() parses the \"events\" list the same way whether canned\n508\t    or live, and the \"done\" situation's own item.completed/\n509\t    agent_message event (confirmed live, issue #41) is exactly such a\n510\t    stream. Codex-only, not parametrized across ADAPTER_NAMES:\n511\t    claude-code's own canned-response hook feeds the final report\n512\t    object directly and never touches ATTAVO_EVENTS -- its mapping is\n513\t    tests/test_adapter_claude_code.py's own module, through the\n514\t    separate ATTAVO_ADAPTER_STREAM_FILE hook issue #26 added for it.\n515\t    \"\"\"\n516\t    events_path = tmp_path / \"events.jsonl\"\n517\t    run = run_situation(\"codex\", \"done\", tmp_path,\n518\t                        extra_env={\"ATTAVO_EVENTS\": str(events_path)})\n519\t    assert run.returncode == 0, run.stderr\n520\t\n521\t    lines = [json.loads(l) for l in events_path.read_text().splitlines() if l.strip()]\n522\t    assert lines, \"no events written\"\n523\t    assert all(set(e) == {\"at\", \"kind\", \"text\"} for e in lines)\n524\t    assert any(e[\"kind\"] == \"message\" and e[\"text\"] == \"ok\" for e in lines)\n525\t\n526\t\n527\tdef run_with_fake_executor(adapter_name: str, tmp_path: Path, script: str,\n528\t                           extra_env: dict[str, Any]) -> subprocess.CompletedProcess[str]:\n529\t    \"\"\"The adapter's real launch path: a fake <tool_binary> on PATH running\n530\t    `script`, then exiting 3 -- the adapter passes a non-zero exit through\n531\t    (situation 5) with the tool's stdout in its own, so the transcript is\n532\t    what the executor's process printed. Runs in a throwaway cwd.\"\"\"\n533\t    fake_bin = tmp_path / \"fakebin\"\n534\t    fake_bin.mkdir()\n535\t    fake_tool = fake_bin / CONFORMANCE[adapter_name][\"tool_binary\"]\n536\t    fake_tool.write_text(f\"#!/bin/sh\\n{script}\\nexit 3\\n\")\n537\t    fake_tool.chmod(0o755)\n538\t\n539\t    cwd = tmp_path / \"cwd\"\n540\t    cwd.mkdir()\n541\t    env = base_env(tmp_path)\n542\t    env[\"PATH\"] = f\"{fake_bin}{os.pathsep}{env.get('PATH', '')}\"\n543\t    env.update(extra_env)\n544\t    return run_adapter(adapter_name, env, cwd=cwd)\n545\t\n546\t\n547\t@pytest.mark.parametrize(\"adapter_name\", ADAPTER_NAMES)\n548\tdef test_situation_20_the_executor_sees_no_attavo_variable(adapter_name: str, tmp_path: Path) -> None:\n549\t    \"\"\"Issue #198, acceptance row 1. A canned executor that prints its\n550\t    environment shows no ATTAVO_ name -- the adapter's contract is the\n551\t    adapter's alone -- while every other variable still reaches it.\n552\t    Specimen: attavo/attavo#194 build-01, where the executor's own\n553\t    test run inherited ATTAVO_EVENTS and 26 of 83 lines of the item's\n554\t    events file were not the executor's. The way back in is any new\n555\t    launch of the executor that does not go through the shared helper.\n556\t    \"\"\"\n557\t    run = run_with_fake_executor(\n558\t        adapter_name, tmp_path, \"env\",\n559\t        {\"ATTAVO_EVENTS\": str(tmp_path / \"events.jsonl\"),\n560\t         \"ATTAVO_STAGE\": \"build\",\n561\t         \"EXECUTOR_SENTINEL\": \"passes-through\"})\n562\t    assert run.returncode == 3, run.stderr\n563\t\n564\t    names = [l.split(\"=\", 1)[0] for l in run.stdout.splitlines() if \"=\" in l]\n565\t    assert \"EXECUTOR_SENTINEL\" in names and \"PATH\" in names, (\n566\t        \"the executor's own environment did not print\", run.stdout)\n567\t    leaked = sorted(n for n in names if n.startswith(\"ATTAVO_\"))\n568\t    assert not leaked, f\"{adapter_name} launched its executor with {', '.join(leaked)}\"\n569\t\n570\t\n571\t@pytest.mark.parametrize(\"adapter_name\", ADAPTER_NAMES)\n572\tdef test_situation_21_a_fixture_run_inside_the_executor_leaves_the_events_file_alone(\n573\t        adapter_name: str, tmp_path: Path) -> None:\n574\t    \"\"\"Issue #198, acceptance row 2 -- the specimen itself. The executor\n575\t    runs the repository's test suite, the suite runs adapters/fixture/run,\n576\t    and the fixture appends to ATTAVO_EVENTS when it finds it set. Here\n577\t    the executor's tool call is that nested fixture run: the outer\n578\t    events file's line count is the same as with no nested run.\"\"\"\n579\t    events = tmp_path / \"events.jsonl\"\n580\t    events.write_text('{\"at\": \"2026-09-19T00:00:00Z\", \"kind\": \"message\", \"text\": \"outer\"}\\n')\n581\t    before = events.read_text().splitlines()\n582\t\n583\t    fixture_run = ADAPTERS_DIR / \"fixture\" / \"run\"\n584\t    run = run_with_fake_executor(\n585\t        adapter_name, tmp_path, f'\"{fixture_run}\" >/dev/null',\n586\t        {\"ATTAVO_EVENTS\": str(events)})\n587\t    assert run.returncode == 3, run.stderr\n588\t\n589\t    assert events.read_text().splitlines() == before\n590\t    assert (tmp_path / \"cwd\" / \"built.txt\").is_file(), (\n591\t        \"the nested fixture run did not happen, so nothing was checked\")\n592\t\n593\t\n594\tdef make_large_file(path: Path, diff_like: bool) -> Path:\n595\t    \"\"\"A file over 2 MB: a diff-shaped one (3 files, unified-diff\n596\t    headers) or a flat feedback-shaped one, the same shapes issue #86's\n597\t    own rejection tests use.\"\"\"\n598\t    if diff_like:\n599\t        chunks = []\n600\t        for i in range(3):\n601\t            chunks.append(f\"diff --git a/file{i}.py b/file{i}.py\\n\")\n602\t            chunks.append(\"+line of a large deletion diff\\n\" * 30000)\n603\t        path.write_text(\"\".join(chunks))\n604\t    else:\n605\t        path.write_text(\"a failing test line\\n\" * 120000)\n606\t    return path\n607\t\n608\t\n609\t@pytest.mark.parametrize(\"adapter_name\", ADAPTER_NAMES)\n610\tdef test_situation_15_instruction_stays_under_the_bound_with_large_files(adapter_name: str, tmp_path: Path) -> None:\n611\t    \"\"\"Issue #93, rejection test 3. A 2 MB diff and a 2 MB feedback file\n612\t    both leave the dry-run instruction under the 64 KB fixed bound --\n613\t    the guarantee issue #86 built (naming a file's path instead of\n614\t    inlining it) staying in place, checked generally rather than per\n615\t    adapter file, so a third adapter inlining a large file again is\n616\t    caught here rather than only in judgment.\"\"\"\n617\t    FIXED_BOUND_CHARS = 65536\n618\t\n619\t    diff_path = make_large_file(tmp_path / \"diff.patch\", diff_like=True)\n620\t    assert diff_path.stat().st_size > 2_000_000\n621\t    verify = dry_run(adapter_name, tmp_path, extra_env={\n622\t        \"ATTAVO_STAGE\": \"verify\", \"ATTAVO_DIFF\": str(diff_path)})\n623\t    assert len(verify[\"instruction\"].encode()) < FIXED_BOUND_CHARS\n624\t\n625\t    feedback_path = make_large_file(tmp_path / \"feedback.txt\", diff_like=False)\n626\t    assert feedback_path.stat().st_size > 2_000_000\n627\t    build = dry_run(adapter_name, tmp_path, extra_env={\"ATTAVO_FEEDBACK\": str(feedback_path)})\n628\t    assert len(build[\"instruction\"].encode()) < FIXED_BOUND_CHARS\n629\t"}]},"parent_tool_use_id":null,"session_id":"0dd7ed4f-100c-4188-9a34-077aa0b6aa25","uuid":"df4af5f0-44a9-4d9e-91eb-91d722647676","timestamp":"2026-09-26T02:14:32.650Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-219/tests/test_executor_conformance.py","content":"\"\"\"The executor conformance suite (issue #40): the entrance exam a second\nadapter passes before it is pointed at a tenant. Every situation here is a\nclaude-code specimen from the last week of Lane 2, stated as contract\nagainst the adapter's own two test hooks -- ATTAVO_ADAPTER_DRY_RUN and\nATTAVO_ADAPTER_RESPONSE_FILE -- rather than against claude-code's own\nmodule path, so a second adapter inherits it by declaring a\nconformance.json, not by copying a test file.\n\nEach adapter under adapters/ (except NOT_AN_EXECUTOR) declares its own\nconformance.json: {\"dry_run_env\": \"<VAR>\", \"response_env\": \"<VAR>\",\n\"tool_binary\": \"<name>\", \"success_script\": \"<shell text>\",\n\"reports\": [\"<field>\", ...], \"situations\": {\"<name>\": <canned response>}}.\ndry_run_env and response_env are the two hooks tests/test_adapters.py\nalready exercised for claude-code (issues #24, #30, #34); tool_binary is\nthe name of the executable the adapter shells out to when neither hook\nis set, needed to fake a non-zero exit from it (situation 5) without a\nmodel in the loop. success_script and reports are issue #41's, once a\nsecond adapter (codex) proved the first two claude-code-shaped: a\ncanned \"done\" response's shape and a fake tool's own successful output\nare each adapter's private contract, not this file's assumption.\n\ndry_run()'s own envelope -- {\"argv\", \"instruction\", \"schema\"} -- is\nissue #41's too. argv alone was claude-code's shape: its instruction\nlives in argv's own \"-p\" value, but codex delivers its instruction on\nstdin, where argv carries none at all, so the suite reads \"instruction\"\nand \"schema\" directly rather than parsing either out of argv.\n\nSituation 8: a commit the adapter makes carries the identity attavo build\nexports (issue #33) -- checked by faking the adapter's own tool_binary on\nPATH, the same technique situation 5 uses, so the fake tool can commit\nfor real inside a throwaway repo without a model in the loop. Its own\ncanned \"success_script\" (above) is what lets this generalize past\nclaude-code's single-JSON-blob response shape.\n\nSituation 12: vendor independence (2026-09-09 ruling) -- an adapter's\ndeclared \"reports\" fields must actually be non-null on a \"done\" run, so\na silent measurement gap fails the suite instead of writing one.\n\nSituations 20 and 21: the executor sees none of the adapter's contract\n(issue #198) -- no ATTAVO_* name reaches the process an adapter launches,\nso nothing the executor runs can read the item's live events file, let\nalone append to it.\n\nRun: python3 -m pytest tests/test_executor_conformance.py -q\n\"\"\"\nimport json\nimport os\nimport subprocess\nfrom pathlib import Path\nfrom typing import Any, cast\n\nimport pytest\n\nfrom helpers import FIXTURES\n\nROOT = Path(__file__).resolve().parent.parent\nADAPTERS_DIR = ROOT / \"adapters\"\n\n# Not an executor: adapters/fixture/run exists for the tests and the\n# doctor, has no canned-response hook, and is never pointed at a tenant.\nNOT_AN_EXECUTOR = {\"fixture\"}\n\nMIN_QUESTION_CHARS = 40\n\n\ndef find_adapters_without_conformance(adapters_dir: Path) -> list[str]:\n    \"\"\"Every directory under adapters_dir, other than NOT_AN_EXECUTOR,\n    that carries no conformance.json -- named, so a second adapter cannot\n    join by declaring nothing.\"\"\"\n    missing: list[str] = []\n    if not adapters_dir.is_dir():\n        return missing\n    for d in sorted(p for p in adapters_dir.iterdir() if p.is_dir()):\n        if d.name in NOT_AN_EXECUTOR:\n            continue\n        if not (d / \"conformance.json\").is_file():\n            missing.append(d.name)\n    return missing\n\n\ndef load_conformance() -> dict[str, dict[str, Any]]:\n    manifests = {}\n    for name in sorted(p.name for p in ADAPTERS_DIR.iterdir() if p.is_dir()):\n        if name in NOT_AN_EXECUTOR:\n            continue\n        manifest_path = ADAPTERS_DIR / name / \"conformance.json\"\n        if manifest_path.is_file():\n            manifests[name] = json.loads(manifest_path.read_text())\n    return manifests\n\n\nCONFORMANCE = load_conformance()\nADAPTER_NAMES = sorted(CONFORMANCE)\n\n\ndef base_env(tmp_path: Path) -> dict[str, Any]:\n    spec_dir = FIXTURES / \"build_valid\" / \"specs\" / \"1\"\n    env = dict(os.environ)\n    env.pop(\"ATTAVO_CHECKS_COMMAND\", None)\n    env.pop(\"ATTAVO_TEST_COMMAND\", None)\n    env.pop(\"ATTAVO_TEST_TIMEOUT_S\", None)\n    # codex's own auth guard (issue #41) refuses \"subscription\" (the\n    # default) when this is set -- absent here regardless of what the\n    # ambient shell running these tests happens to carry, so the suite\n    # never depends on the operator's own environment.\n    env.pop(\"OPENAI_API_KEY\", None)\n    env.update({\n        \"ATTAVO_SPEC_DIR\": str(spec_dir),\n        \"ATTAVO_RECORDS_DIR\": str(tmp_path / \"records\"),\n        \"ATTAVO_RULINGS\": str(tmp_path / \"rulings.md\"),\n        \"ATTAVO_BRANCH\": \"attavo/1-example\",\n        \"ATTAVO_ITERATION\": \"1\",\n        \"ATTAVO_FEEDBACK\": str(tmp_path / \"feedback.txt\"),\n        # codex requires [executor.codex].model (issue #41); harmless\n        # for claude-code, which treats every key here as optional.\n        \"ATTAVO_ADAPTER_CONFIG\": json.dumps({\"model\": \"test-model\"}),\n    })\n    return env\n\n\ndef run_adapter(adapter_name: str, env: dict[str, Any], cwd: Path | None = None) -> subprocess.CompletedProcess[str]:\n    run_path = ADAPTERS_DIR / adapter_name / \"run\"\n    return subprocess.run([str(run_path)], capture_output=True, text=True,\n                          check=False, env=env, cwd=str(cwd) if cwd else None)\n\n\ndef dry_run(adapter_name: str, tmp_path: Path, extra_env: dict[str, Any] | None = None) -> dict[str, Any]:\n    \"\"\"{\"argv\", \"instruction\", \"schema\"}: the instruction and the schema\n    named separately from argv, because a second adapter (issue #41)\n    delivers the instruction on stdin, where argv itself carries none.\"\"\"\n    manifest = CONFORMANCE[adapter_name]\n    env = base_env(tmp_path)\n    env[manifest[\"dry_run_env\"]] = \"1\"\n    if extra_env:\n        env.update(extra_env)\n    run = run_adapter(adapter_name, env)\n    assert run.returncode == 0, run.stderr\n    return cast(dict[str, Any], json.loads(run.stdout))\n\n\ndef run_situation(adapter_name: str, situation: str, tmp_path: Path,\n                  extra_env: dict[str, Any] | None = None) -> subprocess.CompletedProcess[str]:\n    manifest = CONFORMANCE[adapter_name]\n    response = manifest[\"situations\"][situation]\n    response_file = tmp_path / \"response.json\"\n    response_file.write_text(json.dumps(response))\n    env = base_env(tmp_path)\n    env[manifest[\"response_env\"]] = str(response_file)\n    if extra_env:\n        env.update(extra_env)\n    return run_adapter(adapter_name, env)\n\n\ndef test_every_executor_adapter_declares_conformance() -> None:\n    \"\"\"Acceptance 3 (real check, against this repository's own adapters/).\"\"\"\n    missing = find_adapters_without_conformance(ADAPTERS_DIR)\n    assert not missing, f\"adapter(s) with no conformance.json: {', '.join(missing)}\"\n\n\ndef test_find_adapters_without_conformance_names_the_directory(tmp_path: Path) -> None:\n    \"\"\"Acceptance 3 (fixture): a directory with no conformance.json is\n    named, without touching the real adapters/ tree.\"\"\"\n    adapters_dir = tmp_path / \"adapters\"\n    declared = adapters_dir / \"declared\"\n    declared.mkdir(parents=True)\n    (declared / \"run\").write_text(\"#!/bin/sh\\n\")\n    (declared / \"conformance.json\").write_text(\"{}\")\n\n    undeclared = adapters_dir / \"undeclared\"\n    undeclared.mkdir(parents=True)\n    (undeclared / \"run\").write_text(\"#!/bin/sh\\n\")\n\n    assert find_adapters_without_conformance(adapters_dir) == [\"undeclared\"]\n\n\n@pytest.mark.parametrize(\"adapter_name\", ADAPTER_NAMES)\ndef test_situation_1_report_line_is_last_and_has_a_model(adapter_name: str, tmp_path: Path) -> None:\n    run = run_situation(adapter_name, \"done\", tmp_path)\n    assert run.returncode == 0, run.stderr\n    lines = [l for l in run.stdout.splitlines() if l.strip()]\n    report = json.loads(lines[-1])\n    assert report.get(\"model\")\n\n\n@pytest.mark.parametrize(\"adapter_name\", ADAPTER_NAMES)\ndef test_situation_2_tool_error_fails_and_prints_the_result(adapter_name: str, tmp_path: Path) -> None:\n    run = run_situation(adapter_name, \"is_error\", tmp_path)\n    assert run.returncode != 0\n    assert run.stdout.strip(), \"the raw result must still reach stdout\"\n\n\n@pytest.mark.parametrize(\"adapter_name\", ADAPTER_NAMES)\ndef test_situation_3_no_structured_output_fails(adapter_name: str, tmp_path: Path) -> None:\n    run = run_situation(adapter_name, \"no_structured_output\", tmp_path)\n    assert run.returncode != 0\n\n\n@pytest.mark.parametrize(\"adapter_name\", ADAPTER_NAMES)\ndef test_situation_4_question_quality_gates_the_halt(adapter_name: str, tmp_path: Path) -> None:\n    # An absent, empty, or short question is a report in the question\n    # channel (issue #150): the adapter re-invokes once and, when the\n    # retry yields nothing better, reports class non-question with the\n    # tokens of both turns kept -- never an exit with no report line.\n    for situation in (\"question_null\", \"question_empty\", \"question_short\"):\n        run = run_situation(adapter_name, situation, tmp_path)\n        assert run.returncode == 0, f\"{situation}: {run.stderr}\"\n        report = json.loads(run.stdout.splitlines()[-1])\n        assert report[\"status\"] == \"question\", (situation, report)\n        assert report[\"class\"] == \"non-question\", (situation, report)\n\n    run = run_situation(adapter_name, \"question_long\", tmp_path)\n    assert run.returncode == 0, run.stderr\n    report = json.loads(run.stdout.splitlines()[-1])\n    assert report[\"status\"] == \"question\"\n\n\n@pytest.mark.parametrize(\"adapter_name\", ADAPTER_NAMES)\ndef test_situation_5_underlying_tool_nonzero_exit_passes_through(adapter_name: str, tmp_path: Path) -> None:\n    \"\"\"A fake <tool_binary> on PATH that writes to both of its streams and\n    exits 3: the adapter exits 3, and its own stdout -- the only stream\n    build-NN.log is built from -- carries both of the tool's streams.\n    \"\"\"\n    manifest = CONFORMANCE[adapter_name]\n    tool_binary = manifest[\"tool_binary\"]\n\n    fake_bin = tmp_path / \"fakebin\"\n    fake_bin.mkdir()\n    fake_tool = fake_bin / tool_binary\n    fake_tool.write_text(\n        \"#!/bin/sh\\n\"\n        \"echo 'tool stdout: ran out of budget'\\n\"\n        \"echo 'tool stderr: overloaded_error' >&2\\n\"\n        \"exit 3\\n\")\n    fake_tool.chmod(0o755)\n\n    env = base_env(tmp_path)\n    env[\"PATH\"] = f\"{fake_bin}{os.pathsep}{env.get('PATH', '')}\"\n\n    run = run_adapter(adapter_name, env)\n    assert run.returncode == 3\n    assert \"tool stdout: ran out of budget\" in run.stdout\n    assert \"tool stderr: overloaded_error\" in run.stdout\n\n\n@pytest.mark.parametrize(\"adapter_name\", ADAPTER_NAMES)\ndef test_situation_6_transcript_non_empty_on_every_path(adapter_name: str, tmp_path: Path) -> None:\n    for situation in (\"done\", \"is_error\", \"no_structured_output\", \"question_short\"):\n        run = run_situation(adapter_name, situation, tmp_path)\n        assert run.stdout.strip(), f\"{situation} produced no transcript at all\"\n\n\n@pytest.mark.parametrize(\"adapter_name\", ADAPTER_NAMES)\ndef test_situation_7_the_one_test_command_in_the_invocation(adapter_name: str, tmp_path: Path) -> None:\n    \"\"\"The executor is given one test command and no whole-tree command.\n    Naming the tenant's checks in the instruction made the executor their\n    runner however the sentence was worded (tenant zero build-10; #194's\n    590 s wait; #204 and #206, where the whole suite was run twice inside\n    one build), so the checks command is not in the instruction at all.\"\"\"\n    command = \"python3 /product/bin/attavo test 7\"\n    checks = \"python3 bin/factory-lane check --base origin/main\"\n    given = dry_run(adapter_name, tmp_path, extra_env={\n        \"ATTAVO_TEST_COMMAND\": command, \"ATTAVO_TEST_TIMEOUT_S\": \"240\",\n        \"ATTAVO_CHECKS_COMMAND\": checks})\n    assert command in given[\"instruction\"]\n    assert \"240 s\" in given[\"instruction\"]\n    assert checks not in given[\"instruction\"]\n\n    without = dry_run(adapter_name, tmp_path)\n    assert command not in without[\"instruction\"]\n    assert \"attavo test\" not in without[\"instruction\"]\n\n\n@pytest.mark.parametrize(\"adapter_name\", ADAPTER_NAMES)\ndef test_situation_8_commits_carry_the_attavo_build_identity(adapter_name: str, tmp_path: Path) -> None:\n    \"\"\"Issue #33. attavo build exports the executor identity -- set by the\n    product, never the tenant's git config -- as GIT_AUTHOR_NAME/EMAIL and\n    GIT_COMMITTER_NAME/EMAIL before invoking the adapter; the adapter must\n    pass it through rather than setting its own explicit environment for\n    the underlying tool. The fake tool_binary here commits for real, so\n    this checks the adapter's own subprocess call, not just the harness.\n    Regression: the specimen is attavo/code-factory@e22fa85, an executor\n    commit indistinguishable in git log from the operator's own, because\n    no identity was exported for it to carry.\n    \"\"\"\n    manifest = CONFORMANCE[adapter_name]\n    tool_binary = manifest[\"tool_binary\"]\n\n    repo = tmp_path / \"repo\"\n    repo.mkdir()\n    subprocess.run([\"git\", \"init\", \"-q\", \"-b\", \"main\"], cwd=str(repo), check=True)\n    subprocess.run([\"git\", \"config\", \"user.name\", \"a tenant operator\"], cwd=str(repo), check=True)\n    subprocess.run([\"git\", \"config\", \"user.email\", \"operator@example.com\"], cwd=str(repo), check=True)\n    (repo / \"README.md\").write_text(\"seed\\n\")\n    subprocess.run([\"git\", \"add\", \"-A\"], cwd=str(repo), check=True)\n    subprocess.run([\"git\", \"commit\", \"-q\", \"-m\", \"seed\"], cwd=str(repo), check=True)\n\n    fake_bin = tmp_path / \"fakebin\"\n    fake_bin.mkdir()\n    fake_tool = fake_bin / tool_binary\n    # A successful invocation's own shape is per-adapter (claude-code's\n    # single JSON blob vs. codex's JSONL-plus-output-file), so each\n    # adapter declares its own script rather than this file assuming\n    # one -- assuming claude-code's shape here was itself the\n    # claude-code-ism issue #41 found building a second adapter.\n    fake_tool.write_text(manifest[\"success_script\"])\n    fake_tool.chmod(0o755)\n\n    identity_name = f\"attavo executor ({adapter_name})\"\n    identity_email = f\"executor+{adapter_name}@attavo.invalid\"\n    env = base_env(tmp_path)\n    env[\"PATH\"] = f\"{fake_bin}{os.pathsep}{env.get('PATH', '')}\"\n    env[\"GIT_AUTHOR_NAME\"] = identity_name\n    env[\"GIT_AUTHOR_EMAIL\"] = identity_email\n    env[\"GIT_COMMITTER_NAME\"] = identity_name\n    env[\"GIT_COMMITTER_EMAIL\"] = identity_email\n\n    run = run_adapter(adapter_name, env, cwd=repo)\n    assert run.returncode == 0, run.stderr\n\n    log = subprocess.run([\"git\", \"-C\", str(repo), \"log\", \"-1\", \"--format=%an/%ae\"],\n                         capture_output=True, text=True, check=True).stdout.strip()\n    assert log == f\"{identity_name}/{identity_email}\"\n\n\n@pytest.mark.parametrize(\"adapter_name\", ADAPTER_NAMES)\ndef test_situation_9_verify_stage_uses_a_findings_schema(adapter_name: str, tmp_path: Path) -> None:\n    \"\"\"Issue #46, rejection test 3. With ATTAVO_STAGE=verify, the\n    invocation names a response shape carrying findings and tests_named\n    -- not build's status/question. Red at 699f56d for claude-code,\n    where ATTAVO_STAGE was read nowhere and every invocation got the\n    build schema.\n    \"\"\"\n    schema = dry_run(adapter_name, tmp_path, extra_env={\"ATTAVO_STAGE\": \"verify\"})[\"schema\"]\n    assert \"findings\" in schema.get(\"properties\", {})\n    assert \"tests_named\" in schema.get(\"properties\", {})\n\n\n@pytest.mark.parametrize(\"adapter_name\", ADAPTER_NAMES)\ndef test_situation_10_verify_names_approval_commit_divergence_as_reportable(adapter_name: str, tmp_path: Path) -> None:\n    \"\"\"Issue #48, rejection test 1. With ATTAVO_STAGE=verify, the\n    invocation's instruction names a spec whose approval commit does\n    not describe the working tree as itself a reportable finding --\n    issue #4's absorption, specified in issue #40's section 2, lost\n    between issue #40 and issue #46. Red at d04b484, where\n    verify_instruction() never said this.\n    \"\"\"\n    instruction = dry_run(adapter_name, tmp_path, extra_env={\"ATTAVO_STAGE\": \"verify\"})[\"instruction\"]\n    assert \"approval commit\" in instruction\n    assert \"reportable\" in instruction\n\n\n@pytest.mark.parametrize(\"adapter_name\", ADAPTER_NAMES)\ndef test_situation_11_verify_defines_severity_as_derived(adapter_name: str, tmp_path: Path) -> None:\n    \"\"\"Issue #48, rejection test 2. With ATTAVO_STAGE=verify, the\n    invocation's instruction defines severity as derived rather than\n    judged. Red at d04b484, where severity was named once in the\n    finding fields and defined nowhere.\n    \"\"\"\n    instruction = dry_run(adapter_name, tmp_path, extra_env={\"ATTAVO_STAGE\": \"verify\"})[\"instruction\"]\n    assert \"severity\" in instruction\n    assert \"derived rather than judged\" in instruction\n\n\n@pytest.mark.parametrize(\"adapter_name\", ADAPTER_NAMES)\ndef test_situation_12_adapter_supplies_every_field_it_declares(adapter_name: str, tmp_path: Path) -> None:\n    \"\"\"Vendor independence (2026-09-09 ruling). conformance.json's\n    \"reports\" names the fields this adapter can supply with a real\n    value -- an adapter claiming a field and returning null for it is a\n    silent measurement gap, not a legitimate absence, and this fails\n    the suite instead of writing one. Dollars are never summed across\n    executors; absent is null, never zero or blank -- this situation is\n    what makes an adapter's null trustworthy as \"not reported by this\n    executor\" rather than \"forgot to report it\".\n    \"\"\"\n    manifest = CONFORMANCE[adapter_name]\n    reports = manifest.get(\"reports\", [])\n    run = run_situation(adapter_name, \"done\", tmp_path)\n    assert run.returncode == 0, run.stderr\n    report = json.loads(run.stdout.splitlines()[-1])\n    for field in reports:\n        assert report.get(field) is not None, (\n            f\"{adapter_name} declares {field!r} in its reports but a done \"\n            f\"run's own report line carries none\")\n\n\n@pytest.mark.parametrize(\"adapter_name\", ADAPTER_NAMES)\ndef test_situation_13_subagent_guard_is_declared(adapter_name: str, tmp_path: Path) -> None:\n    \"\"\"Issue #88, rejection test (class B, general across any adapter).\n    Every adapter's conformance.json names subagent_guard.supported: an\n    adapter naming neither a working check nor an admitted inability is\n    an undeclared blind spot, not a legitimate absence (mirrors\n    situation 12's vendor-independence ruling). A supported adapter's\n    named situation must refuse the run -- naming the tool's own counts\n    -- rather than reporting done on work that can outlive it; an\n    unsupported adapter must say why it cannot check at all.\n    \"\"\"\n    manifest = CONFORMANCE[adapter_name]\n    guard = manifest.get(\"subagent_guard\")\n    assert guard is not None, f\"{adapter_name} declares no subagent_guard\"\n    assert isinstance(guard.get(\"supported\"), bool), (\n        f\"{adapter_name}'s subagent_guard.supported must be true or false\")\n\n    if guard[\"supported\"]:\n        run = run_situation(adapter_name, guard[\"situation\"], tmp_path)\n        assert run.returncode != 0, (\n            f\"{adapter_name} accepted a run with spawned background work \"\n            \"as done\")\n        transcript = run.stdout + run.stderr\n        assert \"subagent\" in transcript.lower()\n    else:\n        assert guard.get(\"reason\"), (\n            f\"{adapter_name} declares subagent_guard.supported: false \"\n            \"with no reason\")\n\n\n@pytest.mark.parametrize(\"adapter_name\", ADAPTER_NAMES)\ndef test_situation_14_input_limit_is_declared(adapter_name: str, tmp_path: Path) -> None:\n    \"\"\"Issue #93, rejection test 1. Every adapter's conformance.json\n    names input_limit: a unit and a number (as the tool documents it),\n    or a null value and a reason (mirrors situation 13's vendor-\n    independence pattern: an adapter naming neither is an undeclared\n    blind spot, not a legitimate absence).\"\"\"\n    manifest = CONFORMANCE[adapter_name]\n    limit = manifest.get(\"input_limit\")\n    assert limit is not None, f\"{adapter_name} declares no input_limit\"\n\n    if limit.get(\"value\") is not None:\n        assert limit.get(\"unit\") in (\"chars\", \"tokens\"), (\n            f\"{adapter_name}'s input_limit has a value but no chars/tokens unit\")\n    else:\n        assert limit.get(\"reason\"), (\n            f\"{adapter_name}'s input_limit has no value and no reason\")\n\n\ndef counsel_extra_env(tmp_path: Path) -> dict[str, Any]:\n    \"\"\"Issue #100: the record, its log, the diff, the tenant manifest,\n    and this product's own root, all handed by path -- the general\n    contract every adapter's counsel stage shares.\"\"\"\n    record_path = tmp_path / \"build-01.json\"\n    record_path.write_text(json.dumps({\"status\": \"halted\"}))\n    log_path = tmp_path / \"build-01.log\"\n    log_path.write_text(\"adapter transcript\\n\")\n    diff_path = tmp_path / \"diff.patch\"\n    diff_path.write_text(\"diff --git a/x.py b/x.py\\n\")\n    manifest_path = tmp_path / \"attavo.toml\"\n    manifest_path.write_text(\"schema_version = 1\\n\")\n    return {\n        \"ATTAVO_STAGE\": \"counsel\",\n        \"ATTAVO_COUNSEL_RECORD\": str(record_path),\n        \"ATTAVO_COUNSEL_LOG\": str(log_path),\n        \"ATTAVO_COUNSEL_DIFF\": str(diff_path),\n        \"ATTAVO_MANIFEST\": str(manifest_path),\n        \"ATTAVO_PRODUCT_ROOT\": str(ROOT),\n    }\n\n\n@pytest.mark.parametrize(\"adapter_name\", ADAPTER_NAMES)\ndef test_situation_16_counsel_stage_is_declared(adapter_name: str) -> None:\n    \"\"\"Issue #100, acceptance row 4. Every adapter's conformance.json\n    names \"counsel\" among its declared stages -- an adapter naming none\n    is not one this lane has pointed at the counsel stage.\"\"\"\n    manifest = CONFORMANCE[adapter_name]\n    stages = manifest.get(\"stages\")\n    assert stages is not None and \"counsel\" in stages, (\n        f\"{adapter_name} declares no counsel stage\")\n\n\n@pytest.mark.parametrize(\"adapter_name\", ADAPTER_NAMES)\ndef test_situation_17_counsel_names_the_product_root_and_the_record(adapter_name: str, tmp_path: Path) -> None:\n    \"\"\"Issue #100, acceptance row 4. The counsel instruction names this\n    product's own root and the record path handed to it, and its schema\n    requires the structured answer (class, verdict, citations, proposal).\"\"\"\n    extra = counsel_extra_env(tmp_path)\n    result = dry_run(adapter_name, tmp_path, extra_env=extra)\n    instruction = result[\"instruction\"]\n\n    assert str(ROOT) in instruction\n    assert extra[\"ATTAVO_COUNSEL_RECORD\"] in instruction\n    schema_required = set(result[\"schema\"].get(\"required\", []))\n    assert schema_required == {\"class\", \"verdict\", \"citations\", \"proposal\"}\n\n\n@pytest.mark.parametrize(\"adapter_name\", ADAPTER_NAMES)\ndef test_situation_18_counsel_instruction_stays_under_the_bound_with_large_files(\n        adapter_name: str, tmp_path: Path) -> None:\n    \"\"\"Issue #100, acceptance row 4. A 2 MB record log and diff both leave\n    the counsel instruction under the fixed bound -- the same guarantee\n    build and verify already carry (issue #86), so counsel does not\n    reintroduce the ceiling regression on its own new files.\"\"\"\n    FIXED_BOUND_CHARS = 65536\n\n    extra = counsel_extra_env(tmp_path)\n    large_log = make_large_file(tmp_path / \"build-01.log\", diff_like=False)\n    large_diff = make_large_file(tmp_path / \"diff.patch\", diff_like=True)\n    extra[\"ATTAVO_COUNSEL_LOG\"] = str(large_log)\n    extra[\"ATTAVO_COUNSEL_DIFF\"] = str(large_diff)\n\n    result = dry_run(adapter_name, tmp_path, extra_env=extra)\n    assert len(result[\"instruction\"].encode()) < FIXED_BOUND_CHARS\n\n\ndef test_situation_19_codex_writes_events_when_attavo_events_is_set(tmp_path: Path) -> None:\n    \"\"\"Issue #138, acceptance row 2. With ATTAVO_EVENTS set, the codex\n    adapter maps its own JSONL stream to the same {at, kind, text}\n    shape claude-code already writes -- checked through the\n    conformance suite's existing canned-response hook, since codex's\n    own invoke() parses the \"events\" list the same way whether canned\n    or live, and the \"done\" situation's own item.completed/\n    agent_message event (confirmed live, issue #41) is exactly such a\n    stream. Codex-only, not parametrized across ADAPTER_NAMES:\n    claude-code's own canned-response hook feeds the final report\n    object directly and never touches ATTAVO_EVENTS -- its mapping is\n    tests/test_adapter_claude_code.py's own module, through the\n    separate ATTAVO_ADAPTER_STREAM_FILE hook issue #26 added for it.\n    \"\"\"\n    events_path = tmp_path / \"events.jsonl\"\n    run = run_situation(\"codex\", \"done\", tmp_path,\n                        extra_env={\"ATTAVO_EVENTS\": str(events_path)})\n    assert run.returncode == 0, run.stderr\n\n    lines = [json.loads(l) for l in events_path.read_text().splitlines() if l.strip()]\n    assert lines, \"no events written\"\n    assert all(set(e) == {\"at\", \"kind\", \"text\"} for e in lines)\n    assert any(e[\"kind\"] == \"message\" and e[\"text\"] == \"ok\" for e in lines)\n\n\ndef run_with_fake_executor(adapter_name: str, tmp_path: Path, script: str,\n                           extra_env: dict[str, Any]) -> subprocess.CompletedProcess[str]:\n    \"\"\"The adapter's real launch path: a fake <tool_binary> on PATH running\n    `script`, then exiting 3 -- the adapter passes a non-zero exit through\n    (situation 5) with the tool's stdout in its own, so the transcript is\n    what the executor's process printed. Runs in a throwaway cwd.\"\"\"\n    fake_bin = tmp_path / \"fakebin\"\n    fake_bin.mkdir()\n    fake_tool = fake_bin / CONFORMANCE[adapter_name][\"tool_binary\"]\n    fake_tool.write_text(f\"#!/bin/sh\\n{script}\\nexit 3\\n\")\n    fake_tool.chmod(0o755)\n\n    cwd = tmp_path / \"cwd\"\n    cwd.mkdir()\n    env = base_env(tmp_path)\n    env[\"PATH\"] = f\"{fake_bin}{os.pathsep}{env.get('PATH', '')}\"\n    env.update(extra_env)\n    return run_adapter(adapter_name, env, cwd=cwd)\n\n\n@pytest.mark.parametrize(\"adapter_name\", ADAPTER_NAMES)\ndef test_situation_20_the_executor_sees_no_attavo_variable(adapter_name: str, tmp_path: Path) -> None:\n    \"\"\"Issue #198, acceptance row 1. A canned executor that prints its\n    environment shows no ATTAVO_ name -- the adapter's contract is the\n    adapter's alone -- while every other variable still reaches it.\n    Specimen: attavo/attavo#194 build-01, where the executor's own\n    test run inherited ATTAVO_EVENTS and 26 of 83 lines of the item's\n    events file were not the executor's. The way back in is any new\n    launch of the executor that does not go through the shared helper.\n    \"\"\"\n    run = run_with_fake_executor(\n        adapter_name, tmp_path, \"env\",\n        {\"ATTAVO_EVENTS\": str(tmp_path / \"events.jsonl\"),\n         \"ATTAVO_STAGE\": \"build\",\n         \"EXECUTOR_SENTINEL\": \"passes-through\"})\n    assert run.returncode == 3, run.stderr\n\n    names = [l.split(\"=\", 1)[0] for l in run.stdout.splitlines() if \"=\" in l]\n    assert \"EXECUTOR_SENTINEL\" in names and \"PATH\" in names, (\n        \"the executor's own environment did not print\", run.stdout)\n    leaked = sorted(n for n in names if n.startswith(\"ATTAVO_\"))\n    assert not leaked, f\"{adapter_name} launched its executor with {', '.join(leaked)}\"\n\n\n@pytest.mark.parametrize(\"adapter_name\", ADAPTER_NAMES)\ndef test_situation_21_a_fixture_run_inside_the_executor_leaves_the_events_file_alone(\n        adapter_name: str, tmp_path: Path) -> None:\n    \"\"\"Issue #198, acceptance row 2 -- the specimen itself. The executor\n    runs the repository's test suite, the suite runs adapters/fixture/run,\n    and the fixture appends to ATTAVO_EVENTS when it finds it set. Here\n    the executor's tool call is that nested fixture run: the outer\n    events file's line count is the same as with no nested run.\"\"\"\n    events = tmp_path / \"events.jsonl\"\n    events.write_text('{\"at\": \"2026-09-19T00:00:00Z\", \"kind\": \"message\", \"text\": \"outer\"}\\n')\n    before = events.read_text().splitlines()\n\n    fixture_run = ADAPTERS_DIR / \"fixture\" / \"run\"\n    run = run_with_fake_executor(\n        adapter_name, tmp_path, f'\"{fixture_run}\" >/dev/null',\n        {\"ATTAVO_EVENTS\": str(events)})\n    assert run.returncode == 3, run.stderr\n\n    assert events.read_text().splitlines() == before\n    assert (tmp_path / \"cwd\" / \"built.txt\").is_file(), (\n        \"the nested fixture run did not happen, so nothing was checked\")\n\n\ndef make_large_file(path: Path, diff_like: bool) -> Path:\n    \"\"\"A file over 2 MB: a diff-shaped one (3 files, unified-diff\n    headers) or a flat feedback-shaped one, the same shapes issue #86's\n    own rejection tests use.\"\"\"\n    if diff_like:\n        chunks = []\n        for i in range(3):\n            chunks.append(f\"diff --git a/file{i}.py b/file{i}.py\\n\")\n            chunks.append(\"+line of a large deletion diff\\n\" * 30000)\n        path.write_text(\"\".join(chunks))\n    else:\n        path.write_text(\"a failing test line\\n\" * 120000)\n    return path\n\n\n@pytest.mark.parametrize(\"adapter_name\", ADAPTER_NAMES)\ndef test_situation_15_instruction_stays_under_the_bound_with_large_files(adapter_name: str, tmp_path: Path) -> None:\n    \"\"\"Issue #93, rejection test 3. A 2 MB diff and a 2 MB feedback file\n    both leave the dry-run instruction under the 64 KB fixed bound --\n    the guarantee issue #86 built (naming a file's path instead of\n    inlining it) staying in place, checked generally rather than per\n    adapter file, so a third adapter inlining a large file again is\n    caught here rather than only in judgment.\"\"\"\n    FIXED_BOUND_CHARS = 65536\n\n    diff_path = make_large_file(tmp_path / \"diff.patch\", diff_like=True)\n    assert diff_path.stat().st_size > 2_000_000\n    verify = dry_run(adapter_name, tmp_path, extra_env={\n        \"ATTAVO_STAGE\": \"verify\", \"ATTAVO_DIFF\": str(diff_path)})\n    assert len(verify[\"instruction\"].encode()) < FIXED_BOUND_CHARS\n\n    feedback_path = make_large_file(tmp_path / \"feedback.txt\", diff_like=False)\n    assert feedback_path.stat().st_size > 2_000_000\n    build = dry_run(adapter_name, tmp_path, extra_env={\"ATTAVO_FEEDBACK\": str(feedback_path)})\n    assert len(build[\"instruction\"].encode()) < FIXED_BOUND_CHARS\n","numLines":629,"startLine":1,"totalLines":629}}}

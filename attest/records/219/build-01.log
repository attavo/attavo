ce_stage, int(n_text))\n    if counsel is not None and counsel.get(\"verdict\") == \"answer\":\n        for nn, rec in sorted(parse_attempts(records_dir, \"counsel\").items(), reverse=True):\n            if rec.get(\"record\") == source_stem and rec.get(\"verdict\") == \"answer\":\n                steer_stem = f\"counsel-{nn:02d}\"\n                break\n        ruling_text = (counsel.get(\"proposal\") or {}).get(\"ruling_text\")\n        lines += [f\"steer from {steer_stem}: {ruling_text or ''}\", \"\"]\n\n    return prior_stem, steer_stem, \"\\n\".join(lines) + \"\\n\"\n\n\ndef cmd_build(argv: list[str]) -> int:"}}}

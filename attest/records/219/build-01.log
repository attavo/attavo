ings\" absent (or explicitly null) is not the same as an\n        # empty list: the adapter had no channel to report one at all,\n        # which is not a clean bill of health (issue #46). A commit\n        # during verify fails the attempt regardless of what it reported.\n        if not commits and \"findings\" in payload and payload[\"findings\"] is not None:\n            findings = payload[\"findings\"]\n            tests_named = payload.get(\"tests_named\") or []\n            # R3: a finding whose severity is blocking makes the review's\n            # status failed with class returned, retryable -- the next\n            # build is handed its title as evidence; every other\n            # severity leaves the review a pass and is filed as today.\n            blocking = [f for f in findings if isinstance(f, dict) and f.get(\"severity\") == \"blocking\"]\n            if blocking:\n                titles = sorted(str(f.get(\"title\") or \"\") for f in blocking)\n                detail = \"; \".join(titles)\n                blocking_stop = {\"class\": \"returned\", \"provenance\": \"tenant\", \"detail\": detail,\n                                 \"signature\": signature_of(\" \".join(titles)), \"bound\": None}\n            else:\n                status_out = \"pass\"\n\n    # R3: a minimal, custom verify adapter (a returned-review fixture, a\n    # bare canned response) can print nothing at all before its own\n    # report line, leaving the transcript empty -- write_record's own\n    # trail guard (issue #53) would otherwise refuse a failed record for\n    # carrying none; a non-pass status always has one to point to.\n    log_out = transcript if transcript.strip() else \"(no adapter transcript before the report line)\\n\"\n\n    stop = derive_stop(status_out, log=log_out, report_class=(payload or {}).get(\"class\"))\n    if blocking_stop is not None:\n        stop = blocking_stop\n    elif stop is not None and stop[\"class\"] == \"transient\":\n        transient_detail = (payload or {}).get(\"detail\")\n        stop = {**stop, \"detail\": transient_detail, \"signature\": signature_of(transient_detail),\n               \"bound\": None}\n\n    record = {\n        \"sha\": head_sha,\n        \"build_sha\": build_sha,\n        \"build_record\": build_record_path.stem if build_record_path else None,\n        \"approval_sha\": approval_sha,\n        \"at\": now_iso(),\n        \"adapter\": adapter_name,\n        \"adapter_config\": adapter_config,\n        \"adapter_version\": adapter_version_out,\n        \"model\": model,\n        \"model_version\": model_version,\n        \"reports\": reports,\n        \"forge_checks\": forge_checks,\n        \"findings\": findings,\n        \"tests_named\": tests_named,\n        \"commits\": commits,\n        \"stub_ratio\": stub_ratio(diff_text, spec_dir / \"stub\", (specs_rel, records_rel)),\n        \"tokens\": tokens,\n        \"cost_usd\": cost_usd,\n        \"wall_clock_s\": round(time.monotonic() - started, 3),\n        \"status\": status_out,\n        \"retry_of\": None,\n        \"steer\": None,\n        \"stop\": stop,\n    }"}}}

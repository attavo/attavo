{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01QHvAh3kcpfzFMSfwyG2B97","type":"tool_result","content":"1\t\"\"\"The doctor's five proofs, as tests written before the capability.\n2\t\n3\tEach test asserts that one proof holds against this repository. All five\n4\tfail at the first commit and must fail: that is the definition of done,\n5\tstated before anything exists to satisfy it. A test here turns green only\n6\twhen the capability it names has landed and been used for real.\n7\t\n8\tRun: python3 -m pytest tests -q\n9\t\"\"\"\n10\timport json\n11\timport os\n12\timport shutil\n13\timport socket\n14\timport subprocess\n15\timport sys\n16\tfrom pathlib import Path\n17\tfrom typing import Any\n18\t\n19\timport pytest\n20\tfrom helpers import FIXTURES, commit_all, init_repo, make_tenant\n21\t\n22\tROOT = Path(__file__).resolve().parent.parent\n23\tATTAVO = ROOT / \"bin\" / \"attavo\"\n24\t\n25\t\n26\tdef run_doctor(root: Path) -> dict[str, Any]:\n27\t    out = subprocess.run([sys.executable, str(ATTAVO), \"doctor\", str(root), \"--json\"],\n28\t                         capture_output=True, text=True, check=False)\n29\t    report = json.loads(out.stdout)\n30\t    assert out.returncode == (0 if report[\"done\"] else 1)\n31\t    return {p[\"proof\"]: p for p in report[\"proofs\"]}\n32\t\n33\t\n34\tdef test_every_gate_rejects() -> None:\n35\t    \"\"\"Proof 1. Every gate in the manifest rejects its rejection fixture.\n36\t\n37\t    Holds when: a manifest exists, [gates] names at least one gate, each gate\n38\t    has a fixture under paths.rejections, and each gate exits non-zero on it.\n39\t    \"\"\"\n40\t    p = run_doctor(ROOT)[\"every-gate-rejects\"]\n41\t    assert p[\"holds\"], p[\"reason\"]\n42\t\n43\t\n44\tdef test_one_item_traversed_every_stage() -> None:\n45\t    \"\"\"Proof 2. One work item carries a record for spec, approval, build,\n46\t    verify, and attestation, every one written by a script.\"\"\"\n47\t    p = run_doctor(ROOT)[\"one-item-every-stage\"]\n48\t    assert p[\"holds\"], p[\"reason\"]\n49\t\n50\t\n51\tdef test_no_commit_lacks_a_record() -> None:\n52\t    \"\"\"Proof 3. Every commit on the default branch after the manifest was\n53\t    introduced is named by a record's sha or commits list.\"\"\"\n54\t    p = run_doctor(ROOT)[\"no-commit-lacks-record\"]\n55\t    assert p[\"holds\"], p[\"reason\"]\n56\t\n57\t\n58\tdef test_no_stop_lacks_cause() -> None:\n59\t    \"\"\"Proof 4, issue #94. Every non-pass build or verify record at\n60\t    record_version 3 or later carries a stop naming its class and cause.\"\"\"\n61\t    p = run_doctor(ROOT)[\"no-stop-lacks-cause\"]\n62\t    assert p[\"holds\"], p[\"reason\"]\n63\t\n64\t\n65\t@pytest.mark.own_records\n66\tdef test_no_invocation_lacks_record() -> None:\n67\t    \"\"\"Proof 5, issue #151. Every <stage>-NN.started marker under\n68\t    paths.records has arrived at its own <stage>-NN.json, or is still a\n69\t    live process on this host.\"\"\"\n70\t    p = run_doctor(ROOT)[\"no-invocation-lacks-record\"]\n71\t    assert p[\"holds\"], p[\"reason\"]\n72\t\n73\t\n74\tdef test_every_attested_item_is_sealed() -> None:\n75\t    \"\"\"Proof 5, issue #158. Every merged, fully-staged item has a\n76\t    statement in the forge's attestation store for its merge commit --\n77\t    #106, #148, #153 predate [forge].sealed_since and are named before the\n78\t    window instead.\"\"\"\n79\t    p = run_doctor(ROOT)[\"every-attested-item-is-sealed\"]\n80\t    assert p[\"holds\"], p[\"reason\"]\n81\t\n82\t\n83\tdef test_record_loader_uses_highest_attempt_number(tmp_path: Path) -> None:\n84\t    \"\"\"Acceptance 2a. <stage>-NN.json files are one stage's attempts; the\n85\t    doctor treats the highest NN as latest, and STAGES is unchanged.\n86\t\n87\t    spec-01.json names a commit that isn't on the branch at all; spec-02.json\n88\t    names the real code commit. Proof 3 holds only if the loader reads\n89\t    spec-02, not spec-01 -- i.e. only if it picks the highest attempt.\n90\t    \"\"\"\n91\t    root = tmp_path / \"attempts\"\n92\t    root.mkdir()\n93\t    (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n')\n94\t    init_repo(root, \"install\")\n95\t\n96\t    (root / \"src.txt\").write_text(\"code\\n\")\n97\t    commit_all(root, \"code change\")\n98\t    code_sha = subprocess.run([\"git\", \"-C\", str(root), \"rev-parse\", \"HEAD\"],\n99\t                              capture_output=True, text=True, check=True).stdout.strip()\n100\t\n101\t    records = root / \"records\" / \"1\"\n102\t    records.mkdir(parents=True)\n103\t    (records / \"spec-01.json\").write_text(json.dumps({\"sha\": \"0\" * 40}))\n104\t    (records / \"spec-02.json\").write_text(json.dumps({\"sha\": code_sha}))\n105\t    commit_all(root, \"spec records\")\n106\t\n107\t    p = run_doctor(root)[\"no-commit-lacks-record\"]\n108\t    assert p[\"holds\"], p[\"reason\"]\n109\t\n110\t\n111\tdef test_doctor_proof_two_counts_three_of_four_stages_still_red(tmp_path: Path) -> None:\n112\t    \"\"\"Acceptance 8. A work item carrying spec, approval, and build records\n113\t    is three of the four STAGES proof two names; verify doesn't exist\n114\t    yet, so the proof stays red and names exactly that one as lacking.\n115\t    \"\"\"\n116\t    root = tmp_path / \"three_stages\"\n117\t    root.mkdir()\n118\t    (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n')\n119\t    init_repo(root, \"install\")\n120\t\n121\t    records = root / \"records\" / \"1\"\n122\t    records.mkdir(parents=True)\n123\t    (records / \"spec-01.json\").write_text(json.dumps({\"status\": \"pass\"}))\n124\t    (records / \"approval-01.json\").write_text(json.dumps({\"approved_by\": \"alice\"}))\n125\t    (records / \"build-01.json\").write_text(json.dumps({\"status\": \"pass\"}))\n126\t    commit_all(root, \"spec, approval, and build records\")\n127\t\n128\t    p = run_doctor(root)[\"one-item-every-stage\"]\n129\t    assert not p[\"holds\"]\n130\t    assert \"verify\" in p[\"reason\"]\n131\t    assert \"build\" not in p[\"reason\"]\n132\t\n133\t\n134\tdef test_doctor_proof_two_holds_on_a_fixture_carrying_all_four_stages_merged(tmp_path: Path) -> None:\n135\t    \"\"\"Acceptance row 4, issue #69: attestation is retired as a record\n136\t    type -- STAGES is four stages, not five -- and proof two now also\n137\t    requires the four records to have reached HEAD by an actual merge\n138\t    commit, whose first-parent diff introduces all four, the same\n139\t    derivation attest itself uses. A fixture with one record per stage,\n140\t    landed on a branch and merged --no-ff, is enough to prove the\n141\t    mechanism.\"\"\"\n142\t    root = tmp_path / \"four_stages_merged\"\n143\t    root.mkdir()\n144\t    (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n')\n145\t    init_repo(root, \"install\")\n146\t\n147\t    subprocess.run([\"git\", \"-C\", str(root), \"checkout\", \"-b\", \"attavo/1-x\"], check=True)\n148\t    records = root / \"records\" / \"1\"\n149\t    records.mkdir(parents=True)\n150\t    (records / \"spec-01.json\").write_text(json.dumps({\"status\": \"pass\"}))\n151\t    (records / \"approval-01.json\").write_text(json.dumps({\"approved_by\": \"alice\"}))\n152\t    (records / \"build-01.json\").write_text(json.dumps({\"status\": \"pass\"}))\n153\t    (records / \"verify-01.json\").write_text(json.dumps({\"status\": \"pass\"}))\n154\t    commit_all(root, \"spec, approval, build, and verify records\")\n155\t    subprocess.run([\"git\", \"-C\", str(root), \"checkout\", \"main\"], check=True)\n156\t    subprocess.run([\"git\", \"-C\", str(root), \"merge\", \"--no-ff\", \"-m\",\n157\t                    \"Merge branch 'attavo/1-x'\", \"attavo/1-x\"], check=True)\n158\t\n159\t    p = run_doctor(root)[\"one-item-every-stage\"]\n160\t    assert p[\"holds\"], p[\"reason\"]\n161\t\n162\t\n163\tdef test_doctor_proof_two_fails_when_four_stage_records_are_never_merged(tmp_path: Path) -> None:\n164\t    \"\"\"Acceptance row 4's other half, issue #69: the same four records,\n165\t    committed straight to main with no merge at all -- proof two fails,\n166\t    naming the missing merge rather than a lacking stage.\"\"\"\n167\t    root = tmp_path / \"four_stages_unmerged\"\n168\t    root.mkdir()\n169\t    (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n')\n170\t    init_repo(root, \"install\")\n171\t\n172\t    records = root / \"records\" / \"1\"\n173\t    records.mkdir(parents=True)\n174\t    (records / \"spec-01.json\").write_text(json.dumps({\"status\": \"pass\"}))\n175\t    (records / \"approval-01.json\").write_text(json.dumps({\"approved_by\": \"alice\"}))\n176\t    (records / \"build-01.json\").write_text(json.dumps({\"status\": \"pass\"}))\n177\t    (records / \"verify-01.json\").write_text(json.dumps({\"status\": \"pass\"}))\n178\t    commit_all(root, \"spec, approval, build, and verify records, committed directly\")\n179\t\n180\t    p = run_doctor(root)[\"one-item-every-stage\"]\n181\t    assert not p[\"holds\"]\n182\t    assert \"merge\" in p[\"reason\"]\n183\t\n184\t\n185\tdef test_proof_two_fails_naming_the_item_and_refusal_text_on_approval_sha_mismatch(tmp_path: Path) -> None:\n186\t    \"\"\"Acceptance row 1, issue #74. build-01's approval_sha does not name\n187\t    the latest approval's sha -- attavo attest would refuse exactly this\n188\t    chain, and from v0.11.0 the coherence gate refuses the merge group on\n189\t    it. Proof two must refuse it too, not just find the four stages\n190\t    present: fails naming the item and check_attest_chain's own refusal\n191\t    text, never a re-typed copy of it.\"\"\"\n192\t    root = tmp_path / \"approval_sha_mismatch\"\n193\t    root.mkdir()\n194\t    (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n')\n195\t    init_repo(root, \"install\")\n196\t\n197\t    subprocess.run([\"git\", \"-C\", str(root), \"checkout\", \"-b\", \"attavo/1-x\"], check=True)\n198\t    records = root / \"records\" / \"1\"\n199\t    records.mkdir(parents=True)\n200\t    (records / \"spec-01.json\").write_text(json.dumps({\"status\": \"pass\"}))\n201\t    (records / \"approval-01.json\").write_text(json.dumps({\"approved_by\": \"alice\", \"sha\": \"1\" * 40}))\n202\t    (records / \"build-01.json\").write_text(\n203\t        json.dumps({\"status\": \"pass\", \"approval_sha\": \"2\" * 40, \"sha\": \"3\" * 40}))\n204\t    (records / \"verify-01.json\").write_text(json.dumps({\"status\": \"pass\", \"build_sha\": \"3\" * 40}))\n205\t    commit_all(root, \"spec, approval, build, and verify records with a stale approval_sha\")\n206\t    subprocess.run([\"git\", \"-C\", str(root), \"checkout\", \"main\"], check=True)\n207\t    subprocess.run([\"git\", \"-C\", str(root), \"merge\", \"--no-ff\", \"-m\",\n208\t                    \"Merge branch 'attavo/1-x'\", \"attavo/1-x\"], check=True)\n209\t\n210\t    p = run_doctor(root)[\"one-item-every-stage\"]\n211\t    assert not p[\"holds\"]\n212\t    assert \"item 1\" in p[\"reason\"]\n213\t    assert \"approval_sha does not name the latest approval\" in p[\"reason\"]\n214\t\n215\t\n216\tdef test_proof_two_fails_naming_the_item_and_the_superseded_verify(tmp_path: Path) -> None:\n217\t    \"\"\"Acceptance row 5, issue #109. verify-01's build_sha does not name\n218\t    the latest build's sha, so verify-01 is superseded by that later\n219\t    build, not a mismatch -- proof two fails, naming it, with the new\n220\t    message, never the retired mismatch wording.\"\"\"\n221\t    root = tmp_path / \"build_sha_mismatch\"\n222\t    root.mkdir()\n223\t    (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n')\n224\t    init_repo(root, \"install\")\n225\t\n226\t    subprocess.run([\"git\", \"-C\", str(root), \"checkout\", \"-b\", \"attavo/1-x\"], check=True)\n227\t    records = root / \"records\" / \"1\"\n228\t    records.mkdir(parents=True)\n229\t    (records / \"spec-01.json\").write_text(json.dumps({\"status\": \"pass\"}))\n230\t    (records / \"approval-01.json\").write_text(json.dumps({\"approved_by\": \"alice\", \"sha\": \"1\" * 40}))\n231\t    (records / \"build-01.json\").write_text(\n232\t        json.dumps({\"status\": \"pass\", \"approval_sha\": \"1\" * 40, \"sha\": \"3\" * 40}))\n233\t    (records / \"verify-01.json\").write_text(json.dumps({\"status\": \"pass\", \"build_sha\": \"9\" * 40}))\n234\t    commit_all(root, \"spec, approval, build, and verify records with a stale build_sha\")\n235\t    subprocess.run([\"git\", \"-C\", str(root), \"checkout\", \"main\"], check=True)\n236\t    subprocess.run([\"git\", \"-C\", str(root), \"merge\", \"--no-ff\", \"-m\",\n237\t                    \"Merge branch 'attavo/1-x'\", \"attavo/1-x\"], check=True)\n238\t\n239\t    p = run_doctor(root)[\"one-item-every-stage\"]\n240\t    assert not p[\"holds\"]\n241\t    assert \"item 1\" in p[\"reason\"]\n242\t    assert \"no verify names the latest build\" in p[\"reason\"]\n243\t    assert \"verify-01 names\" in p[\"reason\"]\n244\t    assert \"verify's build_sha does not name the latest build\" not in p[\"reason\"]\n245\t\n246\t\n247\tdef test_proof_two_holds_naming_only_the_held_item_when_another_is_refused(tmp_path: Path) -> None:\n248\t    \"\"\"Acceptance row 3, issue #74. Item 1 carries every stage but a\n249\t    stale approval_sha; item 2's chain holds cleanly. Proof two holds,\n250\t    naming only item 2 -- item 1's refusal never leaks into a passing\n251\t    reason.\"\"\"\n252\t    root = tmp_path / \"two_items_one_refused\"\n253\t    root.mkdir()\n254\t    (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n')\n255\t    init_repo(root, \"install\")\n256\t\n257\t    subprocess.run([\"git\", \"-C\", str(root), \"checkout\", \"-b\", \"attavo/1-x\"], check=True)\n258\t    records1 = root / \"records\" / \"1\"\n259\t    records1.mkdir(parents=True)\n260\t    (records1 / \"spec-01.json\").write_text(json.dumps({\"status\": \"pass\"}))\n261\t    (records1 / \"approval-01.json\").write_text(json.dumps({\"approved_by\": \"alice\", \"sha\": \"1\" * 40}))\n262\t    (records1 / \"build-01.json\").write_text(\n263\t        json.dumps({\"status\": \"pass\", \"approval_sha\": \"2\" * 40, \"sha\": \"3\" * 40}))\n264\t    (records1 / \"verify-01.json\").write_text(json.dumps({\"status\": \"pass\", \"build_sha\": \"3\" * 40}))\n265\t    commit_all(root, \"spec, approval, build, and verify records for item 1, chain refused\")\n266\t    subprocess.run([\"git\", \"-C\", str(root), \"checkout\", \"main\"], check=True)\n267\t    subprocess.run([\"git\", \"-C\", str(root), \"merge\", \"--no-ff\", \"-m\",\n268\t                    \"Merge branch 'attavo/1-x'\", \"attavo/1-x\"], check=True)\n269\t\n270\t    subprocess.run([\"git\", \"-C\", str(root), \"checkout\", \"-b\", \"attavo/2-x\"], check=True)\n271\t    records2 = root / \"records\" / \"2\"\n272\t    records2.mkdir(parents=True)\n273\t    (records2 / \"spec-01.json\").write_text(json.dumps({\"status\": \"pass\"}))\n274\t    (records2 / \"approval-01.json\").write_text(json.dumps({\"approved_by\": \"alice\", \"sha\": \"9\" * 40}))\n275\t    (records2 / \"build-01.json\").write_text(\n276\t        json.dumps({\"status\": \"pass\", \"approval_sha\": \"9\" * 40, \"sha\": \"8\" * 40}))\n277\t    (records2 / \"verify-01.json\").write_text(json.dumps({\"status\": \"pass\", \"build_sha\": \"8\" * 40}))\n278\t    commit_all(root, \"spec, approval, build, and verify records for item 2, chain holds\")\n279\t    subprocess.run([\"git\", \"-C\", str(root), \"checkout\", \"main\"], check=True)\n280\t    subprocess.run([\"git\", \"-C\", str(root), \"merge\", \"--no-ff\", \"-m\",\n281\t                    \"Merge branch 'attavo/2-x'\", \"attavo/2-x\"], check=True)\n282\t    merge2_sha = subprocess.run([\"git\", \"-C\", str(root), \"rev-parse\", \"HEAD\"],\n283\t                                capture_output=True, text=True, check=True).stdout.strip()\n284\t\n285\t    p = run_doctor(root)[\"one-item-every-stage\"]\n286\t    assert p[\"holds\"], p[\"reason\"]\n287\t    assert p[\"reason\"] == (\n288\t        \"item(s) 2 carry spec, approval, build, verify with the chain held, \"\n289\t        f\"merged at {merge2_sha[:12]}\")\n290\t\n291\t\n292\tdef test_proof_three_holds_on_an_item_merge_with_no_attestation_record(tmp_path: Path) -> None:\n293\t    \"\"\"Acceptance row 5, issue #69: an item's merge commit carries its\n294\t    record paths in its own first-parent diff, so it is a record commit\n295\t    by the rule that already exists -- no merge_sha field is needed, and\n296\t    there is no attestation record at all now that attest never writes\n297\t    (replaces test_merge_sha_covers_the_merge_commit_for_proof_three,\n298\t    deleted alongside the merge_sha special case it exercised).\"\"\"\n299\t    root = tmp_path / \"item_merge\"\n300\t    root.mkdir()\n301\t    (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n')\n302\t    init_repo(root, \"install\")\n303\t\n304\t    subprocess.run([\"git\", \"-C\", str(root), \"checkout\", \"-b\", \"attavo/1-x\"], check=True)\n305\t    records = root / \"records\" / \"1\"\n306\t    records.mkdir(parents=True)\n307\t    (records / \"spec-01.json\").write_text(json.dumps({\"status\": \"pass\"}))\n308\t    (records / \"approval-01.json\").write_text(json.dumps({\"approved_by\": \"alice\"}))\n309\t    (records / \"build-01.json\").write_text(json.dumps({\"status\": \"pass\"}))\n310\t    (records / \"verify-01.json\").write_text(json.dumps({\"status\": \"pass\"}))\n311\t    commit_all(root, \"spec, approval, build, and verify records for item 1\")\n312\t    subprocess.run([\"git\", \"-C\", str(root), \"checkout\", \"main\"], check=True)\n313\t    subprocess.run([\"git\", \"-C\", str(root), \"merge\", \"--no-ff\", \"-m\",\n314\t                    \"Merge branch 'attavo/1-x'\", \"attavo/1-x\"], check=True)\n315\t\n316\t    p = run_doctor(root)[\"no-commit-lacks-record\"]\n317\t    assert p[\"holds\"], p[\"reason\"]\n318\t    assert not (records / \"attestation-01.json\").exists()\n319\t\n320\t\n321\tdef _three_way_fixture(tmp_path: Path, name: str, *, boundary_paths: list[str] | None,\n322\t                       ordinary_touches: str, include_direct_commit: bool) -> Path:\n323\t    \"\"\"A tenant history carrying one commit of each of proof three's three\n324\t    kinds (issue #72): an item merge (recorded, by the records-path rule\n325\t    proof two's fixtures already exercise), a --no-ff merge touching only\n326\t    `ordinary_touches` (ordinary), and, when asked, one commit made\n327\t    straight to main naming no record (unrecorded -- on a protected main\n328\t    with a queue, the only way a change arrives without the forge).\n329\t    \"\"\"\n330\t    root = tmp_path / name\n331\t    root.mkdir()\n332\t    manifest = '[paths]\\nrecords = \"records\"\\n'\n333\t    if boundary_paths is not None:\n334\t        patterns = \", \".join(f'\"{path}\"' for path in boundary_paths)\n335\t        manifest += f'\\n[spec.boundary]\\npaths = [{patterns}]\\n'\n336\t    (root / \"attavo.toml\").write_text(manifest)\n337\t    init_repo(root, \"install\")\n338\t\n339\t    subprocess.run([\"git\", \"-C\", str(root), \"checkout\", \"-b\", \"attavo/1-x\"], check=True)\n340\t    records = root / \"records\" / \"1\"\n341\t    records.mkdir(parents=True)\n342\t    (records / \"spec-01.json\").write_text(json.dumps({\"status\": \"pass\"}))\n343\t    commit_all(root, \"spec record for item 1\")\n344\t    subprocess.run([\"git\", \"-C\", str(root), \"checkout\", \"main\"], check=True)\n345\t    subprocess.run([\"git\", \"-C\", str(root), \"merge\", \"--no-ff\", \"-m\",\n346\t                    \"Merge branch 'attavo/1-x'\", \"attavo/1-x\"], check=True)\n347\t\n348\t    subprocess.run([\"git\", \"-C\", str(root), \"checkout\", \"-b\", \"ordinary-change\"], check=True)\n349\t    touched = root / ordinary_touches\n350\t    touched.parent.mkdir(parents=True, exist_ok=True)\n351\t    touched.write_text(\"v2\\n\")\n352\t    commit_all(root, \"an ordinary change\")\n353\t    subprocess.run([\"git\", \"-C\", str(root), \"checkout\", \"main\"], check=True)\n354\t    subprocess.run([\"git\", \"-C\", str(root), \"merge\", \"--no-ff\", \"-m\",\n355\t                    \"Merge branch 'ordinary-change'\", \"ordinary-change\"], check=True)\n356\t\n357\t    if include_direct_commit:\n358\t        (root / \"direct.txt\").write_text(\"direct\\n\")\n359\t        commit_all(root, \"a change committed straight to main\")\n360\t\n361\t    return root\n362\t\n363\t\n364\tdef test_proof_three_fails_naming_the_direct_commit_with_the_three_counts(tmp_path: Path) -> None:\n365\t    \"\"\"Acceptance row 1, issue #72. The three-way fixture with its direct\n366\t    commit included: proof three fails, naming the direct commit and\n367\t    reporting all three counts in the reason.\"\"\"\n368\t    root = _three_way_fixture(tmp_path, \"direct_commit\", boundary_paths=[\"boundary/**\"],\n369\t                              ordinary_touches=\"pins/version.txt\", include_direct_commit=True)\n370\t    direct_sha = subprocess.run([\"git\", \"-C\", str(root), \"rev-parse\", \"HEAD\"],\n371\t                                capture_output=True, text=True, check=True).stdout.strip()\n372\t\n373\t    p = run_doctor(root)[\"no-commit-lacks-record\"]\n374\t    assert not p[\"holds\"]\n375\t    assert \"1 recorded, 1 ordinary, 1 unrecorded\" in p[\"reason\"]\n376\t    assert direct_sha[:12] in p[\"reason\"]\n377\t\n378\t\n379\tdef test_proof_three_holds_with_zero_unrecorded_once_the_direct_commit_is_gone(tmp_path: Path) -> None:\n380\t    \"\"\"Acceptance row 2, issue #72. The same fixture with the direct commit\n381\t    removed: proof three holds, reporting `0 unrecorded`.\"\"\"\n382\t    root = _three_way_fixture(tmp_path, \"no_direct_commit\", boundary_paths=[\"boundary/**\"],\n383\t                              ordinary_touches=\"pins/version.txt\", include_direct_commit=False)\n384\t\n385\t    p = run_doctor(root)[\"no-commit-lacks-record\"]\n386\t    assert p[\"holds\"], p[\"reason\"]\n387\t    assert \"1 recorded, 1 ordinary, 0 unrecorded\" in p[\"reason\"]\n388\t\n389\t\n390\tdef test_proof_three_reports_boundary_evasions_and_still_holds(tmp_path: Path) -> None:\n391\t    \"\"\"Acceptance row 3, issue #72. The ordinary merge touches a path\n392\t    inside [spec.boundary].paths: the reason carries `boundary evasions:\n393\t    1`, and the proof still holds -- evasions are reported, never\n394\t    refused.\"\"\"\n395\t    root = _three_way_fixture(tmp_path, \"boundary_evasion\", boundary_paths=[\"boundary/**\"],\n396\t                              ordinary_touches=\"boundary/thing.txt\", include_direct_commit=False)\n397\t\n398\t    p = run_doctor(root)[\"no-commit-lacks-record\"]\n399\t    assert p[\"holds\"], p[\"reason\"]\n400\t    assert \"boundary evasions: 1\" in p[\"reason\"]\n401\t\n402\t\n403\tdef test_proof_three_reports_boundary_evasions_as_not_available_with_no_boundary_paths(tmp_path: Path) -> None:\n404\t    \"\"\"Acceptance row 4, issue #72. A tenant declaring no [spec.boundary]\n405\t    paths at all: evasions are reported as `n/a`, not `0` -- an absent\n406\t    read is not the same measurement as zero evasions found.\"\"\"\n407\t    root = _three_way_fixture(tmp_path, \"no_boundary\", boundary_paths=None,\n408\t                              ordinary_touches=\"pins/version.txt\", include_direct_commit=False)\n409\t\n410\t    p = run_doctor(root)[\"no-commit-lacks-record\"]\n411\t    assert p[\"holds\"], p[\"reason\"]\n412\t    assert \"boundary evasions: n/a\" in p[\"reason\"]\n413\t    assert p[\"boundary_evasions\"] == \"n/a\"\n414\t\n415\t\n416\tdef test_proof_three_json_carries_the_path_ratio_fields(tmp_path: Path) -> None:\n417\t    \"\"\"Acceptance row 5, issue #72. `attavo doctor --json` carries\n418\t    `recorded`, `ordinary`, `unrecorded`, and `boundary_evasions` on\n419\t    proof three's own entry -- the path-ratio primitive Phase 4 names,\n420\t    produced now because a decision depends on it.\"\"\"\n421\t    root = _three_way_fixture(tmp_path, \"json_fields\", boundary_paths=[\"boundary/**\"],\n422\t                              ordinary_touches=\"pins/version.txt\", include_direct_commit=False)\n423\t\n424\t    p = run_doctor(root)[\"no-commit-lacks-record\"]\n425\t    assert p[\"recorded\"] == 1\n426\t    assert p[\"ordinary\"] == 1\n427\t    assert p[\"unrecorded\"] == 0\n428\t    assert p[\"boundary_evasions\"] == 0\n429\t\n430\t\n431\tdef test_proof_three_json_lists_the_ordinary_and_unrecorded_commits(tmp_path: Path) -> None:\n432\t    \"\"\"Issue #148. Proof three's JSON entry carries `ordinary_commits` and\n433\t    `unrecorded_commits`, each commit with sha and subject, so a reader\n434\t    can name the commits behind the counts without re-running the\n435\t    classification by hand. The ordinary merge that touches a boundary\n436\t    path is flagged `boundary_evasion: true`.\"\"\"\n437\t    root = _three_way_fixture(tmp_path, \"commit_lists\", boundary_paths=[\"boundary/**\"],\n438\t                              ordinary_touches=\"boundary/thing.txt\", include_direct_commit=True)\n439\t    direct_sha = subprocess.run([\"git\", \"-C\", str(root), \"rev-parse\", \"HEAD\"],\n440\t                                capture_output=True, text=True, check=True).stdout.strip()\n441\t\n442\t    p = run_doctor(root)[\"no-commit-lacks-record\"]\n443\t    ordinary_commits = p[\"ordinary_commits\"]\n444\t    unrecorded_commits = p[\"unrecorded_commits\"]\n445\t    assert [c[\"subject\"] for c in ordinary_commits] == [\"Merge branch 'ordinary-change'\"]\n446\t    assert len(ordinary_commits[0][\"sha\"]) == 40\n447\t    assert ordinary_commits[0][\"boundary_evasion\"] is True\n448\t    assert [c[\"subject\"] for c in unrecorded_commits] == [\"a change committed straight to main\"]\n449\t    assert unrecorded_commits[0][\"sha\"] == direct_sha\n450\t\n451\t\n452\tdef _window_fixture(tmp_path: Path, name: str) -> tuple[Path, str, str]:\n453\t    \"\"\"Two commits made straight to main, then a branch carrying item 1's\n454\t    spec record, merged --no-ff. Returns (root, merge_sha, branch_sha) --\n455\t    merge_sha is on main's first-parent line and is the only sha issue\n456\t    #74's [doctor] from tests declare as valid; branch_sha is the branch\n457\t    commit itself, reachable only as the merge's second parent and never\n458\t    on that line, the sha the invalid-from test declares instead.\"\"\"\n459\t    root = tmp_path / name\n460\t    root.mkdir()\n461\t    (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n')\n462\t    init_repo(root, \"install\")\n463\t\n464\t    (root / \"pre1.txt\").write_text(\"1\\n\")\n465\t    commit_all(root, \"a change committed straight to main\")\n466\t    (root / \"pre2.txt\").write_text(\"2\\n\")\n467\t    commit_all(root, \"another change committed straight to main\")\n468\t\n469\t    subprocess.run([\"git\", \"-C\", str(root), \"checkout\", \"-b\", \"attavo/1-x\"], check=True)\n470\t    records = root / \"records\" / \"1\"\n471\t    records.mkdir(parents=True)\n472\t    (records / \"spec-01.json\").write_text(json.dumps({\"status\": \"pass\"}))\n473\t    commit_all(root, \"spec record for item 1\")\n474\t    branch_sha = subprocess.run([\"git\", \"-C\", str(root), \"rev-parse\", \"HEAD\"],\n475\t                                capture_output=True, text=True, check=True).stdout.strip()\n476\t    subprocess.run([\"git\", \"-C\", str(root), \"checkout\", \"main\"], check=True)\n477\t    subprocess.run([\"git\", \"-C\", str(root), \"merge\", \"--no-ff\", \"-m\",\n478\t                    \"Merge branch 'attavo/1-x'\", \"attavo/1-x\"], check=True)\n479\t    merge_sha = subprocess.run([\"git\", \"-C\", str(root), \"rev-parse\", \"HEAD\"],\n480\t                               capture_output=True, text=True, check=True).stdout.strip()\n481\t    return root, merge_sha, branch_sha\n482\t\n483\t\n484\tdef _declare_doctor_from(root: Path, from_sha: str) -> None:\n485\t    \"\"\"Names [doctor] from via its own merge, not a direct commit to\n486\t    main -- declaring the window must never itself read as an unrecorded\n487\t    commit inside it.\"\"\"\n488\t    subprocess.run([\"git\", \"-C\", str(root), \"checkout\", \"-b\", \"declare-window\"], check=True)\n489\t    toml = root / \"attavo.toml\"\n490\t    toml.write_text(toml.read_text() + f'\\n[doctor]\\nfrom = \"{from_sha}\"\\n')\n491\t    commit_all(root, \"declare the doctor's window\")\n492\t    subprocess.run([\"git\", \"-C\", str(root), \"checkout\", \"main\"], check=True)\n493\t    subprocess.run([\"git\", \"-C\", str(root), \"merge\", \"--no-ff\", \"-m\",\n494\t                    \"Merge branch 'declare-window'\", \"declare-window\"], check=True)\n495\t\n496\t\n497\tdef test_proof_three_holds_reporting_before_the_window_with_doctor_from(tmp_path: Path) -> None:\n498\t    \"\"\"Acceptance row 4, issue #74. [doctor] from names the item merge:\n499\t    the two commits made straight to main before it fall before the\n500\t    window, not into unrecorded -- proof three holds, `before the\n501\t    window: 2`, and the window's own counts, 1 recorded (the item merge)\n502\t    and 1 ordinary (the merge that declares the window itself).\"\"\"\n503\t    root, merge_sha, _ = _window_fixture(tmp_path, \"window_holds\")\n504\t    _declare_doctor_from(root, merge_sha)\n505\t\n506\t    p = run_doctor(root)[\"no-commit-lacks-record\"]\n507\t    assert p[\"holds\"], p[\"reason\"]\n508\t    assert \"before the window: 2\" in p[\"reason\"]\n509\t    assert \"1 recorded, 1 ordinary, 0 unrecorded\" in p[\"reason\"]\n510\t    assert p[\"before_window\"] == 2\n511\t\n512\t\n513\tdef test_proof_three_holds_when_doctor_from_names_a_seven_character_prefix(tmp_path: Path) -> None:\n514\t    \"\"\"Acceptance row 5 (amendment), issue #74. [doctor] from need not be\n515\t    a full sha -- any spelling git rev-parse --verify resolves is\n516\t    accepted, resolved before the first-parent check runs. A\n517\t    seven-character prefix of the item merge holds with the same counts\n518\t    as the full-sha case.\"\"\"\n519\t    root, merge_sha, _ = _window_fixture(tmp_path, \"window_holds_short_sha\")\n520\t    _declare_doctor_from(root, merge_sha[:7])\n521\t\n522\t    p = run_doctor(root)[\"no-commit-lacks-record\"]\n523\t    assert p[\"holds\"], p[\"reason\"]\n524\t    assert \"before the window: 2\" in p[\"reason\"]\n525\t    assert \"1 recorded, 1 ordinary, 0 unrecorded\" in p[\"reason\"]\n526\t    assert p[\"before_window\"] == 2\n527\t\n528\t\n529\tdef test_proof_three_fails_naming_the_key_when_doctor_from_is_off_the_first_parent_line(tmp_path: Path) -> None:\n530\t    \"\"\"Acceptance row 5, issue #74. [doctor] from names the item branch's\n531\t    own commit -- reachable only as a merge's second parent, never on\n532\t    main's first-parent line -- proof three fails naming the key rather\n533\t    than silently falling back to the install commit.\"\"\"\n534\t    root, _, branch_sha = _window_fixture(tmp_path, \"window_off_line\")\n535\t    _declare_doctor_from(root, branch_sha)\n536\t\n537\t    p = run_doctor(root)[\"no-commit-lacks-record\"]\n538\t    assert not p[\"holds\"]\n539\t    assert \"[doctor] from\" in p[\"reason\"]\n540\t    assert branch_sha[:12] in p[\"reason\"]\n541\t\n542\t\n543\tdef test_proof_three_defaults_to_the_install_commit_when_doctor_key_is_absent(tmp_path: Path) -> None:\n544\t    \"\"\"Acceptance row 6, issue #74. No [doctor] table at all: the window\n545\t    defaults to the install commit exactly as before this issue -- both\n546\t    commits made straight to main are still read as unrecorded, and\n547\t    before_window is 0 -- the read every existing proof-three test\n548\t    exercises is unaffected by the key's addition.\"\"\"\n549\t    root, _merge_sha, _branch_sha = _window_fixture(tmp_path, \"window_absent\")\n550\t\n551\t    p = run_doctor(root)[\"no-commit-lacks-record\"]\n552\t    assert not p[\"holds\"]\n553\t    assert \"1 recorded, 0 ordinary, 2 unrecorded\" in p[\"reason\"]\n554\t    assert \"before the window: 0\" in p[\"reason\"]\n555\t    assert p[\"before_window\"] == 0\n556\t\n557\t\n558\tdef test_doctor_proof_one_refuses_a_gate_with_empty_retires(tmp_path: Path) -> None:\n559\t    \"\"\"Residual, issue #54 -- proposed, not yet ruled on: a gate that\n560\t    retires nothing only adds. The manifest schema has required\n561\t    [gates.<name>].retires to be non-empty since Phase 1, but read_manifest\n562\t    never validates against that schema, so nothing enforced it at\n563\t    runtime until this proof read it directly.\"\"\"\n564\t    root = tmp_path / \"empty_retires\"\n565\t    root.mkdir()\n566\t    (root / \"attavo.toml\").write_text(\n567\t        '[paths]\\nrejections = \"rejections\"\\n\\n'\n568\t        '[gates.spec]\\ncommand = \"false\"\\nretires = []\\n')\n569\t    (root / \"rejections\" / \"spec\").mkdir(parents=True)\n570\t    init_repo(root, \"install\")\n571\t\n572\t    p = run_doctor(root)[\"every-gate-rejects\"]\n573\t    assert not p[\"holds\"]\n574\t    assert \"retires\" in p[\"reason\"] and \"spec\" in p[\"reason\"]\n575\t\n576\t\n577\tdef test_doctor_proof_one_runs_the_gate_without_an_item_argument(tmp_path: Path) -> None:\n578\t    \"\"\"Issue #7, and its regression test. [gates.spec].command is a bare\n579\t    `attavo spec-gate`, no item argument, and its rejections/spec/ fixture\n580\t    carries no attavo/N-* branch at all (init_repo leaves it on `main`) --\n581\t    so before the doctor exported the fixture's item as ATTAVO_ITEM, the\n582\t    gate command would exit 2 (cannot derive item id) without ever writing\n583\t    a record, which still counts as \"rejected\" but proves nothing about the\n584\t    prose criterion this fixture means to test.\n585\t\n586\t    Red at the merge base: no ATTAVO_ITEM export existed, so no\n587\t    spec-01.json was ever written and reading it raised FileNotFoundError.\n588\t    Green once the doctor exports it: the record exists and names the\n589\t    prose criterion by name, which is the actual thing proof one asserts.\n590\t    \"\"\"\n591\t    outer = tmp_path / \"gate_rejection\"\n592\t    shutil.copytree(FIXTURES / \"gate_rejection\", outer)\n593\t    cmd = f\"{sys.executable} {ATTAVO}\"\n594\t    toml = outer / \"attavo.toml\"\n595\t    toml.write_text(toml.read_text().replace(\"ATTAVO_CMD\", cmd))\n596\t    init_repo(outer / \"rejections\" / \"spec\")\n597\t\n598\t    p = run_doctor(outer)[\"every-gate-rejects\"]\n599\t    assert p[\"holds\"], p[\"reason\"]\n600\t\n601\t    record = json.loads(\n602\t        (outer / \"rejections\" / \"spec\" / \"records\" / \"1\" / \"spec-01.json\").read_text())\n603\t    assert record[\"refusal\"] == \"criterion is prose: missing.sh\"\n604\t\n605\t\n606\tdef test_doctor_proof_four_fails_on_a_failed_record_with_no_stop(tmp_path: Path) -> None:\n607\t    \"\"\"Acceptance row 1, issue #94: a failed build record at\n608\t    record_version 3 with a two-line log and no stop at all -- a stop\n609\t    the product forgot to write, the way tenant zero's #576 build-11\n610\t    (before record_version 3 existed) was diagnosed only by a person\n611\t    rerunning it by hand. Fails today: no proof four exists.\"\"\"\n612\t    root = make_tenant(tmp_path, \"no_stop_lacks_cause\")\n613\t\n614\t    p = run_doctor(root)[\"no-stop-lacks-cause\"]\n615\t    assert not p[\"holds\"]\n616\t    assert \"build-01\" in p[\"reason\"]\n617\t    assert \"no stop\" in p[\"reason\"]\n618\t\n619\t\n620\tdef test_doctor_proof_four_holds_on_a_fixture_with_stop_and_gates_heading(tmp_path: Path) -> None:\n621\t    \"\"\"Acceptance row 2, issue #94: a failed build record whose stop is\n622\t    present and valid, and whose log carries the gates heading since\n623\t    gates actually ran (selected_tests is set) -- proof four holds.\"\"\"\n624\t    root = tmp_path / \"stop_holds\"\n625\t    root.mkdir()\n626\t    (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n')\n627\t    init_repo(root, \"install\")\n628\t\n629\t    records = root / \"records\" / \"1\"\n630\t    records.mkdir(parents=True)\n631\t    build = {\n632\t        \"status\": \"failed\", \"record_version\": 3,\n633\t        \"selected_tests\": {\"select\": \"cat\", \"run\": \"cat\", \"count\": 1, \"exit\": 1},\n634\t        \"stop\": {\"class\": \"unclassed\", \"provenance\": \"product\", \"detail\": \"1 failed, 0 passed\"},\n635\t    }\n636\t    (records / \"build-01.json\").write_text(json.dumps(build))\n637\t    (records / \"build-01.log\").write_text(\n638\t        \"--- attavo gates, iteration 1 ---\\ncriterion x: exit 1\\n1 failed, 0 passed\")\n639\t    commit_all(root, \"a failed build record with a proper stop and gates heading\")\n640\t\n641\t    p = run_doctor(root)[\"no-stop-lacks-cause\"]\n642\t    assert p[\"holds\"], p[\"reason\"]\n643\t\n644\t\n645\tdef test_doctor_proof_four_reports_older_records_mixing_versions_2_and_3(tmp_path: Path) -> None:\n646\t    \"\"\"Acceptance row 3, issue #94: a record_version 2 record predates\n647\t    stop by construction (proof three's own window lesson) and is\n648\t    counted, never refused; a record_version 3 record alongside it is\n649\t    checked as usual. Proof four holds, reporting the older count.\"\"\"\n650\t    root = tmp_path / \"mixed_versions\"\n651\t    root.mkdir()\n652\t    (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n')\n653\t    init_repo(root, \"install\")\n654\t\n655\t    records = root / \"records\" / \"1\"\n656\t    records.mkdir(parents=True)\n657\t    (records / \"build-01.json\").write_text(json.dumps({\"status\": \"failed\", \"record_version\": 2}))\n658\t    (records / \"verify-01.json\").write_text(json.dumps({\n659\t        \"status\": \"returned\", \"record_version\": 3,\n660\t        \"stop\": {\"class\": \"forge-unconcluded\", \"provenance\": \"tenant\", \"detail\": None}}))\n661\t    commit_all(root, \"one older record before stop, one current record with a stop\")\n662\t\n663\t    p = run_doctor(root)[\"no-stop-lacks-cause\"]\n664\t    assert p[\"holds\"], p[\"reason\"]\n665\t    assert \"1 record(s) before stop was recorded\" in p[\"reason\"]\n666\t    assert p[\"older_records\"] == 1\n667\t\n668\t\n669\tdef test_doctor_proof_four_holds_with_no_non_pass_records_to_check(tmp_path: Path) -> None:\n670\t    \"\"\"A tenant found on a real v0.16.3 pin: no non-pass build or verify\n671\t    record at record_version 3 or later exists to check -- every item\n672\t    passed. The clause is \"every failed or refused record carries its\n673\t    cause\", which holds vacuously on an empty set, the way proof three\n674\t    holds when nothing is unrecorded. Proof four must hold, reporting\n675\t    0 checked and the older-record count, not fail the tenant for having\n676\t    nothing to check.\"\"\"\n677\t    root = tmp_path / \"all_pass\"\n678\t    root.mkdir()\n679\t    (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n')\n680\t    init_repo(root, \"install\")\n681\t\n682\t    records = root / \"records\" / \"1\"\n683\t    records.mkdir(parents=True)\n684\t    (records / \"build-01.json\").write_text(json.dumps({\"status\": \"failed\", \"record_version\": 2}))\n685\t    (records / \"verify-01.json\").write_text(json.dumps({\"status\": \"pass\", \"record_version\": 3}))\n686\t    commit_all(root, \"one older record before stop, one current record that passed\")\n687\t\n688\t    p = run_doctor(root)[\"no-stop-lacks-cause\"]\n689\t    assert p[\"holds\"], p[\"reason\"]\n690\t    assert \"0 checked\" in p[\"reason\"]\n691\t    assert \"1 record(s) before stop was recorded\" in p[\"reason\"]\n692\t    assert p[\"older_records\"] == 1\n693\t\n694\t\n695\tdef test_doctor_proof_four_fails_when_gates_ran_but_the_log_lacks_their_heading(tmp_path: Path) -> None:\n696\t    \"\"\"Issue #94's own proposed fix: a failed build whose selected_tests\n697\t    is set -- gates definitely ran that iteration -- but whose log\n698\t    carries no gates heading at all. Tenant zero's #659 build-01 was\n699\t    exactly this before issue #89's own fix landed: the gate output that\n700\t    failed it lived only in a temporary directory the product deleted.\"\"\"\n701\t    root = tmp_path / \"missing_gates_heading\"\n702\t    root.mkdir()\n703\t    (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n')\n704\t    init_repo(root, \"install\")\n705\t\n706\t    records = root / \"records\" / \"1\"\n707\t    records.mkdir(parents=True)\n708\t    build = {\n709\t        \"status\": \"failed\", \"record_version\": 3,\n710\t        \"selected_tests\": {\"select\": \"cat\", \"run\": \"cat\", \"count\": 1, \"exit\": 1},\n711\t        \"stop\": {\"class\": \"unclassed\", \"provenance\": \"product\", \"detail\": \"1 failed, 0 passed\"},\n712\t    }\n713\t    (records / \"build-01.json\").write_text(json.dumps(build))\n714\t    (records / \"build-01.log\").write_text(\"1 failed, 0 passed\")\n715\t    commit_all(root, \"a failed build with gates run but no gates heading in the log\")\n716\t\n717\t    p = run_doctor(root)[\"no-stop-lacks-cause\"]\n718\t    assert not p[\"holds\"]\n719\t    assert \"gates heading\" in p[\"reason\"]\n720\t\n721\t\n722\tdef test_doctor_proof_four_fails_when_a_log_ends_in_an_adapter_exit_after_only_event_lines(\n723\t        tmp_path: Path) -> None:\n724\t    \"\"\"Issue #94's own proposed fix, tenant zero's #659 verify-01\n725\t    specimen: a log whose last line is a bare adapter-exit marker with\n726\t    nothing before it but the adapter's own JSON event stream -- the\n727\t    tool's real error line never reached it (issue #86's own\n728\t    split_adapter_stdout bug, now guarded against at read time too).\"\"\"\n729\t    root = tmp_path / \"owed_tool_error\"\n730\t    root.mkdir()\n731\t    (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n')\n732\t    init_repo(root, \"install\")\n733\t\n734\t    records = root / \"records\" / \"1\"\n735\t    records.mkdir(parents=True)\n736\t    verify = {\n737\t        \"status\": \"failed\", \"record_version\": 3,\n738\t        \"stop\": {\"class\": \"unclassed\", \"provenance\": \"product\", \"detail\": \"[adapter exited 1]\"},\n739\t    }\n740\t    (records / \"verify-01.json\").write_text(json.dumps(verify))\n741\t    (records / \"verify-01.log\").write_text(\n742\t        '{\"type\":\"thread.started\",\"thread_id\":\"x\"}\\n[adapter exited 1]')\n743\t    commit_all(root, \"a failed verify whose tool error line was dropped\")\n744\t\n745\t    p = run_doctor(root)[\"no-stop-lacks-cause\"]\n746\t    assert not p[\"holds\"]\n747\t    assert \"tool's own error line is owed\" in p[\"reason\"]\n748\t\n749\t\n750\tdef test_proof_four_reads_an_error_event_as_the_tools_own_words(tmp_path: Path) -> None:\n751\t    \"\"\"Issue #200: a review the vendor refused (\"Selected model is at\n752\t    capacity\") logs the tool's own error as an `error` event, then the\n753\t    exit marker. The cause is in the log, in the tool's words, so proof\n754\t    four does not owe a line. An `error` event with an empty or missing\n755\t    message says nothing and still owes it.\"\"\"\n756\t    event_lines = ('{\"type\":\"thread.started\",\"thread_id\":\"x\"}\\n'\n757\t                   '{\"type\":\"turn.started\"}\\n')\n758\t    exit_line = \"[adapter exited 1]\"\n759\t    verify = {\n760\t        \"status\": \"failed\", \"record_version\": 3,\n761\t        \"stop\": {\"class\": \"unclassed\", \"provenance\": \"product\", \"detail\": exit_line},\n762\t    }\n763\t    cases = {\n764\t        \"with_message\": (\n765\t            '{\"type\":\"error\",\"message\":\"Selected model is at capacity. '\n766\t            'Please try a different model.\"}\\n', True),\n767\t        \"empty_message\": ('{\"type\":\"error\",\"message\":\"\"}\\n', False),\n768\t        \"missing_message\": ('{\"type\":\"error\"}\\n', False),\n769\t    }\n770\t    for name, (error_line, holds) in cases.items():\n771\t        root = tmp_path / name\n772\t        root.mkdir()\n773\t        (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n')\n774\t        init_repo(root, \"install\")\n775\t\n776\t        records = root / \"records\" / \"1\"\n777\t        records.mkdir(parents=True)\n778\t        (records / \"verify-01.json\").write_text(json.dumps(verify))\n779\t        (records / \"verify-01.log\").write_text(event_lines + error_line + exit_line)\n780\t        commit_all(root, f\"a failed verify whose log has an error event: {name}\")\n781\t\n782\t        p = run_doctor(root)[\"no-stop-lacks-cause\"]\n783\t        assert p[\"holds\"] is holds, (name, p[\"reason\"])\n784\t        if not holds:\n785\t            assert \"tool's own error line is owed\" in p[\"reason\"], name\n786\t\n787\t\n788\tdef test_doctor_proof_four_fails_on_an_unclassed_stop_with_no_detail(tmp_path: Path) -> None:\n789\t    \"\"\"An unclassed stop's whole contract is its detail (issue #89):\n790\t    with none, the record is exactly as unexplained as no stop at all.\"\"\"\n791\t    root = tmp_path / \"unclassed_no_detail\"\n792\t    root.mkdir()\n793\t    (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n')\n794\t    init_repo(root, \"install\")\n795\t\n796\t    records = root / \"records\" / \"1\"\n797\t    records.mkdir(parents=True)\n798\t    build = {\"status\": \"failed\", \"record_version\": 3,\n799\t            \"stop\": {\"class\": \"unclassed\", \"provenance\": \"product\", \"detail\": None}}\n800\t    (records / \"build-01.json\").write_text(json.dumps(build))\n801\t    commit_all(root, \"an unclassed stop with no detail\")\n802\t\n803\t    p = run_doctor(root)[\"no-stop-lacks-cause\"]\n804\t    assert not p[\"holds\"]\n805\t    assert \"unclassed with no detail\" in p[\"reason\"]\n806\t\n807\t\n808\tdef _dead_pid() -> int:\n809\t    \"\"\"A pid guaranteed not to be running: a real child, spawned and\n810\t    reaped, on this host.\"\"\"\n811\t    proc = subprocess.Popen([sys.executable, \"-c\", \"pass\"])\n812\t    proc.wait()\n813\t    return proc.pid\n814\t\n815\t\n816\tdef test_doctor_proof_five_fails_on_a_dead_invocation_with_no_record(tmp_path: Path) -> None:\n817\t    \"\"\"Issue #151: a build-01.started marker naming a dead pid on this\n818\t    host, with no build-01.json to retire it, is exactly the silence two\n819\t    build attempts of item #148 left behind -- proof five names it.\"\"\"\n820\t    root = tmp_path / \"dead_invocation\"\n821\t    root.mkdir()\n822\t    (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n\\n'\n823\t                                      '[drive]\\nstall_after_s = 60\\n')\n824\t    init_repo(root, \"install\")\n825\t\n826\t    records = root / \"records\" / \"1\"\n827\t    records.mkdir(parents=True)\n828\t    (records / \"build-01.started\").write_text(json.dumps({\n829\t        \"at\": \"2026-09-17T13:16:08Z\", \"host\": socket.gethostname(), \"pid\": _dead_pid(),\n830\t        \"sha\": \"0\" * 40, \"product_version\": \"fixture\"}))\n831\t    commit_all(root, \"invocation marker for item 1\")\n832\t\n833\t    p = run_doctor(root)[\"no-invocation-lacks-record\"]\n834\t    assert not p[\"holds\"]\n835\t    assert \"build-01\" in p[\"reason\"] and \"never wrote its record\" in p[\"reason\"]\n836\t\n837\t\n838\tdef test_doctor_proof_five_holds_once_the_record_arrives(tmp_path: Path) -> None:\n839\t    \"\"\"The same marker, retired by its own build-01.json: proof five\n840\t    holds -- the record's arrival is what retires a marker, not its\n841\t    removal.\"\"\"\n842\t    root = tmp_path / \"recorded_invocation\"\n843\t    root.mkdir()\n844\t    (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n\\n'\n845\t                                      '[drive]\\nstall_after_s = 60\\n')\n846\t    init_repo(root, \"install\")\n847\t\n848\t    records = root / \"records\" / \"1\"\n849\t    records.mkdir(parents=True)\n850\t    (records / \"build-01.started\").write_text(json.dumps({\n851\t        \"at\": \"2026-09-17T13:16:08Z\", \"host\": socket.gethostname(), \"pid\": _dead_pid(),\n852\t        \"sha\": \"0\" * 40, \"product_version\": \"fixture\"}))\n853\t    (records / \"build-01.json\").write_text(json.dumps({\"status\": \"pass\"}))\n854\t    commit_all(root, \"invocation marker and its record for item 1\")\n855\t\n856\t    p = run_doctor(root)[\"no-invocation-lacks-record\"]\n857\t    assert p[\"holds\"], p[\"reason\"]\n858\t\n859\t\n860\tdef test_doctor_proof_five_reports_a_live_invocation_as_running_not_failed(tmp_path: Path) -> None:\n861\t    \"\"\"A marker naming this test's own pid, on this host, with no\n862\t    record: alive, so proof five holds and names it running rather than\n863\t    failing the tenant for a drive that has not had the chance to finish\n864\t    yet.\"\"\"\n865\t    root = tmp_path / \"live_invocation\"\n866\t    root.mkdir()\n867\t    (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n\\n'\n868\t                                      '[drive]\\nstall_after_s = 60\\n')\n869\t    init_repo(root, \"install\")\n870\t\n871\t    records = root / \"records\" / \"1\"\n872\t    records.mkdir(parents=True)\n873\t    (records / \"build-01.started\").write_text(json.dumps({\n874\t        \"at\": \"2026-09-17T13:16:08Z\", \"host\": socket.gethostname(), \"pid\": os.getpid(),\n875\t        \"sha\": \"0\" * 40, \"product_version\": \"fixture\"}))\n876\t    commit_all(root, \"invocation marker for a still-running invocation\")\n877\t\n878\t    p = run_doctor(root)[\"no-invocation-lacks-record\"]\n879\t    assert p[\"holds\"], p[\"reason\"]\n880\t    assert len(p[\"running_invocations\"]) == 1\n881\t    assert \"build-01\" in p[\"running_invocations\"][0]\n882\t\n883\t\n884\tdef test_doctor_proof_five_fails_without_stall_after_s_in_the_manifest(tmp_path: Path) -> None:\n885\t    \"\"\"A tenant with no [drive].stall_after_s carries no bound past which\n886\t    a live invocation is hung -- proof five cannot tell a hung drive from\n887\t    a running one, and refuses to guess a default.\"\"\"\n888\t    root = tmp_path / \"no_stall_bound\"\n889\t    root.mkdir()\n890\t    (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n')\n891\t    init_repo(root, \"install\")\n892\t\n893\t    records = root / \"records\" / \"1\"\n894\t    records.mkdir(parents=True)\n895\t    (records / \"build-01.json\").write_text(json.dumps({\"status\": \"pass\"}))\n896\t    commit_all(root, \"a record with no [drive].stall_after_s declared\")\n897\t\n898\t    p = run_doctor(root)[\"no-invocation-lacks-record\"]\n899\t    assert not p[\"holds\"]\n900\t    assert \"stall_after_s\" in p[\"reason\"]\n901\t\n902\t\n903\tdef test_doctor_refuses_a_drive_table_without_ceilings(tmp_path: Path) -> None:\n904\t    \"\"\"R3: a [drive] table that declares a stall bound and no\n905\t    [drive.build].ceiling_s or [drive.verify].ceiling_s carries no bound\n906\t    past which a live stage is hung by wall clock -- proof five refuses\n907\t    to guess one, as it refuses to guess the stall bound.\"\"\"\n908\t    root = tmp_path / \"no_ceilings\"\n909\t    root.mkdir()\n910\t    (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n\\n[drive]\\nstall_after_s = 60\\nattempts = 3\\n')\n911\t    init_repo(root, \"install\")\n912\t\n913\t    records = root / \"records\" / \"1\"\n914\t    records.mkdir(parents=True)\n915\t    (records / \"build-01.json\").write_text(json.dumps({\"status\": \"pass\"}))\n916\t    commit_all(root, \"a drive table with no ceilings\")\n917\t\n918\t    p = run_doctor(root)[\"no-invocation-lacks-record\"]\n919\t    assert not p[\"holds\"]\n920\t    assert \"ceiling\" in p[\"reason\"]\n921\t"}]},"parent_tool_use_id":null,"session_id":"0dd7ed4f-100c-4188-9a34-077aa0b6aa25","uuid":"d8fbac03-b70f-4e16-9320-a840e3d50893","timestamp":"2026-09-26T02:09:46.433Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-219/attest/specs/219/stub/tests/test_doctor.py","content":"\"\"\"The doctor's five proofs, as tests written before the capability.\n\nEach test asserts that one proof holds against this repository. All five\nfail at the first commit and must fail: that is the definition of done,\nstated before anything exists to satisfy it. A test here turns green only\nwhen the capability it names has landed and been used for real.\n\nRun: python3 -m pytest tests -q\n\"\"\"\nimport json\nimport os\nimport shutil\nimport socket\nimport subprocess\nimport sys\nfrom pathlib import Path\nfrom typing import Any\n\nimport pytest\nfrom helpers import FIXTURES, commit_all, init_repo, make_tenant\n\nROOT = Path(__file__).resolve().parent.parent\nATTAVO = ROOT / \"bin\" / \"attavo\"\n\n\ndef run_doctor(root: Path) -> dict[str, Any]:\n    out = subprocess.run([sys.executable, str(ATTAVO), \"doctor\", str(root), \"--json\"],\n                         capture_output=True, text=True, check=False)\n    report = json.loads(out.stdout)\n    assert out.returncode == (0 if report[\"done\"] else 1)\n    return {p[\"proof\"]: p for p in report[\"proofs\"]}\n\n\ndef test_every_gate_rejects() -> None:\n    \"\"\"Proof 1. Every gate in the manifest rejects its rejection fixture.\n\n    Holds when: a manifest exists, [gates] names at least one gate, each gate\n    has a fixture under paths.rejections, and each gate exits non-zero on it.\n    \"\"\"\n    p = run_doctor(ROOT)[\"every-gate-rejects\"]\n    assert p[\"holds\"], p[\"reason\"]\n\n\ndef test_one_item_traversed_every_stage() -> None:\n    \"\"\"Proof 2. One work item carries a record for spec, approval, build,\n    verify, and attestation, every one written by a script.\"\"\"\n    p = run_doctor(ROOT)[\"one-item-every-stage\"]\n    assert p[\"holds\"], p[\"reason\"]\n\n\ndef test_no_commit_lacks_a_record() -> None:\n    \"\"\"Proof 3. Every commit on the default branch after the manifest was\n    introduced is named by a record's sha or commits list.\"\"\"\n    p = run_doctor(ROOT)[\"no-commit-lacks-record\"]\n    assert p[\"holds\"], p[\"reason\"]\n\n\ndef test_no_stop_lacks_cause() -> None:\n    \"\"\"Proof 4, issue #94. Every non-pass build or verify record at\n    record_version 3 or later carries a stop naming its class and cause.\"\"\"\n    p = run_doctor(ROOT)[\"no-stop-lacks-cause\"]\n    assert p[\"holds\"], p[\"reason\"]\n\n\n@pytest.mark.own_records\ndef test_no_invocation_lacks_record() -> None:\n    \"\"\"Proof 5, issue #151. Every <stage>-NN.started marker under\n    paths.records has arrived at its own <stage>-NN.json, or is still a\n    live process on this host.\"\"\"\n    p = run_doctor(ROOT)[\"no-invocation-lacks-record\"]\n    assert p[\"holds\"], p[\"reason\"]\n\n\ndef test_every_attested_item_is_sealed() -> None:\n    \"\"\"Proof 5, issue #158. Every merged, fully-staged item has a\n    statement in the forge's attestation store for its merge commit --\n    #106, #148, #153 predate [forge].sealed_since and are named before the\n    window instead.\"\"\"\n    p = run_doctor(ROOT)[\"every-attested-item-is-sealed\"]\n    assert p[\"holds\"], p[\"reason\"]\n\n\ndef test_record_loader_uses_highest_attempt_number(tmp_path: Path) -> None:\n    \"\"\"Acceptance 2a. <stage>-NN.json files are one stage's attempts; the\n    doctor treats the highest NN as latest, and STAGES is unchanged.\n\n    spec-01.json names a commit that isn't on the branch at all; spec-02.json\n    names the real code commit. Proof 3 holds only if the loader reads\n    spec-02, not spec-01 -- i.e. only if it picks the highest attempt.\n    \"\"\"\n    root = tmp_path / \"attempts\"\n    root.mkdir()\n    (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n')\n    init_repo(root, \"install\")\n\n    (root / \"src.txt\").write_text(\"code\\n\")\n    commit_all(root, \"code change\")\n    code_sha = subprocess.run([\"git\", \"-C\", str(root), \"rev-parse\", \"HEAD\"],\n                              capture_output=True, text=True, check=True).stdout.strip()\n\n    records = root / \"records\" / \"1\"\n    records.mkdir(parents=True)\n    (records / \"spec-01.json\").write_text(json.dumps({\"sha\": \"0\" * 40}))\n    (records / \"spec-02.json\").write_text(json.dumps({\"sha\": code_sha}))\n    commit_all(root, \"spec records\")\n\n    p = run_doctor(root)[\"no-commit-lacks-record\"]\n    assert p[\"holds\"], p[\"reason\"]\n\n\ndef test_doctor_proof_two_counts_three_of_four_stages_still_red(tmp_path: Path) -> None:\n    \"\"\"Acceptance 8. A work item carrying spec, approval, and build records\n    is three of the four STAGES proof two names; verify doesn't exist\n    yet, so the proof stays red and names exactly that one as lacking.\n    \"\"\"\n    root = tmp_path / \"three_stages\"\n    root.mkdir()\n    (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n')\n    init_repo(root, \"install\")\n\n    records = root / \"records\" / \"1\"\n    records.mkdir(parents=True)\n    (records / \"spec-01.json\").write_text(json.dumps({\"status\": \"pass\"}))\n    (records / \"approval-01.json\").write_text(json.dumps({\"approved_by\": \"alice\"}))\n    (records / \"build-01.json\").write_text(json.dumps({\"status\": \"pass\"}))\n    commit_all(root, \"spec, approval, and build records\")\n\n    p = run_doctor(root)[\"one-item-every-stage\"]\n    assert not p[\"holds\"]\n    assert \"verify\" in p[\"reason\"]\n    assert \"build\" not in p[\"reason\"]\n\n\ndef test_doctor_proof_two_holds_on_a_fixture_carrying_all_four_stages_merged(tmp_path: Path) -> None:\n    \"\"\"Acceptance row 4, issue #69: attestation is retired as a record\n    type -- STAGES is four stages, not five -- and proof two now also\n    requires the four records to have reached HEAD by an actual merge\n    commit, whose first-parent diff introduces all four, the same\n    derivation attest itself uses. A fixture with one record per stage,\n    landed on a branch and merged --no-ff, is enough to prove the\n    mechanism.\"\"\"\n    root = tmp_path / \"four_stages_merged\"\n    root.mkdir()\n    (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n')\n    init_repo(root, \"install\")\n\n    subprocess.run([\"git\", \"-C\", str(root), \"checkout\", \"-b\", \"attavo/1-x\"], check=True)\n    records = root / \"records\" / \"1\"\n    records.mkdir(parents=True)\n    (records / \"spec-01.json\").write_text(json.dumps({\"status\": \"pass\"}))\n    (records / \"approval-01.json\").write_text(json.dumps({\"approved_by\": \"alice\"}))\n    (records / \"build-01.json\").write_text(json.dumps({\"status\": \"pass\"}))\n    (records / \"verify-01.json\").write_text(json.dumps({\"status\": \"pass\"}))\n    commit_all(root, \"spec, approval, build, and verify records\")\n    subprocess.run([\"git\", \"-C\", str(root), \"checkout\", \"main\"], check=True)\n    subprocess.run([\"git\", \"-C\", str(root), \"merge\", \"--no-ff\", \"-m\",\n                    \"Merge branch 'attavo/1-x'\", \"attavo/1-x\"], check=True)\n\n    p = run_doctor(root)[\"one-item-every-stage\"]\n    assert p[\"holds\"], p[\"reason\"]\n\n\ndef test_doctor_proof_two_fails_when_four_stage_records_are_never_merged(tmp_path: Path) -> None:\n    \"\"\"Acceptance row 4's other half, issue #69: the same four records,\n    committed straight to main with no merge at all -- proof two fails,\n    naming the missing merge rather than a lacking stage.\"\"\"\n    root = tmp_path / \"four_stages_unmerged\"\n    root.mkdir()\n    (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n')\n    init_repo(root, \"install\")\n\n    records = root / \"records\" / \"1\"\n    records.mkdir(parents=True)\n    (records / \"spec-01.json\").write_text(json.dumps({\"status\": \"pass\"}))\n    (records / \"approval-01.json\").write_text(json.dumps({\"approved_by\": \"alice\"}))\n    (records / \"build-01.json\").write_text(json.dumps({\"status\": \"pass\"}))\n    (records / \"verify-01.json\").write_text(json.dumps({\"status\": \"pass\"}))\n    commit_all(root, \"spec, approval, build, and verify records, committed directly\")\n\n    p = run_doctor(root)[\"one-item-every-stage\"]\n    assert not p[\"holds\"]\n    assert \"merge\" in p[\"reason\"]\n\n\ndef test_proof_two_fails_naming_the_item_and_refusal_text_on_approval_sha_mismatch(tmp_path: Path) -> None:\n    \"\"\"Acceptance row 1, issue #74. build-01's approval_sha does not name\n    the latest approval's sha -- attavo attest would refuse exactly this\n    chain, and from v0.11.0 the coherence gate refuses the merge group on\n    it. Proof two must refuse it too, not just find the four stages\n    present: fails naming the item and check_attest_chain's own refusal\n    text, never a re-typed copy of it.\"\"\"\n    root = tmp_path / \"approval_sha_mismatch\"\n    root.mkdir()\n    (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n')\n    init_repo(root, \"install\")\n\n    subprocess.run([\"git\", \"-C\", str(root), \"checkout\", \"-b\", \"attavo/1-x\"], check=True)\n    records = root / \"records\" / \"1\"\n    records.mkdir(parents=True)\n    (records / \"spec-01.json\").write_text(json.dumps({\"status\": \"pass\"}))\n    (records / \"approval-01.json\").write_text(json.dumps({\"approved_by\": \"alice\", \"sha\": \"1\" * 40}))\n    (records / \"build-01.json\").write_text(\n        json.dumps({\"status\": \"pass\", \"approval_sha\": \"2\" * 40, \"sha\": \"3\" * 40}))\n    (records / \"verify-01.json\").write_text(json.dumps({\"status\": \"pass\", \"build_sha\": \"3\" * 40}))\n    commit_all(root, \"spec, approval, build, and verify records with a stale approval_sha\")\n    subprocess.run([\"git\", \"-C\", str(root), \"checkout\", \"main\"], check=True)\n    subprocess.run([\"git\", \"-C\", str(root), \"merge\", \"--no-ff\", \"-m\",\n                    \"Merge branch 'attavo/1-x'\", \"attavo/1-x\"], check=True)\n\n    p = run_doctor(root)[\"one-item-every-stage\"]\n    assert not p[\"holds\"]\n    assert \"item 1\" in p[\"reason\"]\n    assert \"approval_sha does not name the latest approval\" in p[\"reason\"]\n\n\ndef test_proof_two_fails_naming_the_item_and_the_superseded_verify(tmp_path: Path) -> None:\n    \"\"\"Acceptance row 5, issue #109. verify-01's build_sha does not name\n    the latest build's sha, so verify-01 is superseded by that later\n    build, not a mismatch -- proof two fails, naming it, with the new\n    message, never the retired mismatch wording.\"\"\"\n    root = tmp_path / \"build_sha_mismatch\"\n    root.mkdir()\n    (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n')\n    init_repo(root, \"install\")\n\n    subprocess.run([\"git\", \"-C\", str(root), \"checkout\", \"-b\", \"attavo/1-x\"], check=True)\n    records = root / \"records\" / \"1\"\n    records.mkdir(parents=True)\n    (records / \"spec-01.json\").write_text(json.dumps({\"status\": \"pass\"}))\n    (records / \"approval-01.json\").write_text(json.dumps({\"approved_by\": \"alice\", \"sha\": \"1\" * 40}))\n    (records / \"build-01.json\").write_text(\n        json.dumps({\"status\": \"pass\", \"approval_sha\": \"1\" * 40, \"sha\": \"3\" * 40}))\n    (records / \"verify-01.json\").write_text(json.dumps({\"status\": \"pass\", \"build_sha\": \"9\" * 40}))\n    commit_all(root, \"spec, approval, build, and verify records with a stale build_sha\")\n    subprocess.run([\"git\", \"-C\", str(root), \"checkout\", \"main\"], check=True)\n    subprocess.run([\"git\", \"-C\", str(root), \"merge\", \"--no-ff\", \"-m\",\n                    \"Merge branch 'attavo/1-x'\", \"attavo/1-x\"], check=True)\n\n    p = run_doctor(root)[\"one-item-every-stage\"]\n    assert not p[\"holds\"]\n    assert \"item 1\" in p[\"reason\"]\n    assert \"no verify names the latest build\" in p[\"reason\"]\n    assert \"verify-01 names\" in p[\"reason\"]\n    assert \"verify's build_sha does not name the latest build\" not in p[\"reason\"]\n\n\ndef test_proof_two_holds_naming_only_the_held_item_when_another_is_refused(tmp_path: Path) -> None:\n    \"\"\"Acceptance row 3, issue #74. Item 1 carries every stage but a\n    stale approval_sha; item 2's chain holds cleanly. Proof two holds,\n    naming only item 2 -- item 1's refusal never leaks into a passing\n    reason.\"\"\"\n    root = tmp_path / \"two_items_one_refused\"\n    root.mkdir()\n    (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n')\n    init_repo(root, \"install\")\n\n    subprocess.run([\"git\", \"-C\", str(root), \"checkout\", \"-b\", \"attavo/1-x\"], check=True)\n    records1 = root / \"records\" / \"1\"\n    records1.mkdir(parents=True)\n    (records1 / \"spec-01.json\").write_text(json.dumps({\"status\": \"pass\"}))\n    (records1 / \"approval-01.json\").write_text(json.dumps({\"approved_by\": \"alice\", \"sha\": \"1\" * 40}))\n    (records1 / \"build-01.json\").write_text(\n        json.dumps({\"status\": \"pass\", \"approval_sha\": \"2\" * 40, \"sha\": \"3\" * 40}))\n    (records1 / \"verify-01.json\").write_text(json.dumps({\"status\": \"pass\", \"build_sha\": \"3\" * 40}))\n    commit_all(root, \"spec, approval, build, and verify records for item 1, chain refused\")\n    subprocess.run([\"git\", \"-C\", str(root), \"checkout\", \"main\"], check=True)\n    subprocess.run([\"git\", \"-C\", str(root), \"merge\", \"--no-ff\", \"-m\",\n                    \"Merge branch 'attavo/1-x'\", \"attavo/1-x\"], check=True)\n\n    subprocess.run([\"git\", \"-C\", str(root), \"checkout\", \"-b\", \"attavo/2-x\"], check=True)\n    records2 = root / \"records\" / \"2\"\n    records2.mkdir(parents=True)\n    (records2 / \"spec-01.json\").write_text(json.dumps({\"status\": \"pass\"}))\n    (records2 / \"approval-01.json\").write_text(json.dumps({\"approved_by\": \"alice\", \"sha\": \"9\" * 40}))\n    (records2 / \"build-01.json\").write_text(\n        json.dumps({\"status\": \"pass\", \"approval_sha\": \"9\" * 40, \"sha\": \"8\" * 40}))\n    (records2 / \"verify-01.json\").write_text(json.dumps({\"status\": \"pass\", \"build_sha\": \"8\" * 40}))\n    commit_all(root, \"spec, approval, build, and verify records for item 2, chain holds\")\n    subprocess.run([\"git\", \"-C\", str(root), \"checkout\", \"main\"], check=True)\n    subprocess.run([\"git\", \"-C\", str(root), \"merge\", \"--no-ff\", \"-m\",\n                    \"Merge branch 'attavo/2-x'\", \"attavo/2-x\"], check=True)\n    merge2_sha = subprocess.run([\"git\", \"-C\", str(root), \"rev-parse\", \"HEAD\"],\n                                capture_output=True, text=True, check=True).stdout.strip()\n\n    p = run_doctor(root)[\"one-item-every-stage\"]\n    assert p[\"holds\"], p[\"reason\"]\n    assert p[\"reason\"] == (\n        \"item(s) 2 carry spec, approval, build, verify with the chain held, \"\n        f\"merged at {merge2_sha[:12]}\")\n\n\ndef test_proof_three_holds_on_an_item_merge_with_no_attestation_record(tmp_path: Path) -> None:\n    \"\"\"Acceptance row 5, issue #69: an item's merge commit carries its\n    record paths in its own first-parent diff, so it is a record commit\n    by the rule that already exists -- no merge_sha field is needed, and\n    there is no attestation record at all now that attest never writes\n    (replaces test_merge_sha_covers_the_merge_commit_for_proof_three,\n    deleted alongside the merge_sha special case it exercised).\"\"\"\n    root = tmp_path / \"item_merge\"\n    root.mkdir()\n    (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n')\n    init_repo(root, \"install\")\n\n    subprocess.run([\"git\", \"-C\", str(root), \"checkout\", \"-b\", \"attavo/1-x\"], check=True)\n    records = root / \"records\" / \"1\"\n    records.mkdir(parents=True)\n    (records / \"spec-01.json\").write_text(json.dumps({\"status\": \"pass\"}))\n    (records / \"approval-01.json\").write_text(json.dumps({\"approved_by\": \"alice\"}))\n    (records / \"build-01.json\").write_text(json.dumps({\"status\": \"pass\"}))\n    (records / \"verify-01.json\").write_text(json.dumps({\"status\": \"pass\"}))\n    commit_all(root, \"spec, approval, build, and verify records for item 1\")\n    subprocess.run([\"git\", \"-C\", str(root), \"checkout\", \"main\"], check=True)\n    subprocess.run([\"git\", \"-C\", str(root), \"merge\", \"--no-ff\", \"-m\",\n                    \"Merge branch 'attavo/1-x'\", \"attavo/1-x\"], check=True)\n\n    p = run_doctor(root)[\"no-commit-lacks-record\"]\n    assert p[\"holds\"], p[\"reason\"]\n    assert not (records / \"attestation-01.json\").exists()\n\n\ndef _three_way_fixture(tmp_path: Path, name: str, *, boundary_paths: list[str] | None,\n                       ordinary_touches: str, include_direct_commit: bool) -> Path:\n    \"\"\"A tenant history carrying one commit of each of proof three's three\n    kinds (issue #72): an item merge (recorded, by the records-path rule\n    proof two's fixtures already exercise), a --no-ff merge touching only\n    `ordinary_touches` (ordinary), and, when asked, one commit made\n    straight to main naming no record (unrecorded -- on a protected main\n    with a queue, the only way a change arrives without the forge).\n    \"\"\"\n    root = tmp_path / name\n    root.mkdir()\n    manifest = '[paths]\\nrecords = \"records\"\\n'\n    if boundary_paths is not None:\n        patterns = \", \".join(f'\"{path}\"' for path in boundary_paths)\n        manifest += f'\\n[spec.boundary]\\npaths = [{patterns}]\\n'\n    (root / \"attavo.toml\").write_text(manifest)\n    init_repo(root, \"install\")\n\n    subprocess.run([\"git\", \"-C\", str(root), \"checkout\", \"-b\", \"attavo/1-x\"], check=True)\n    records = root / \"records\" / \"1\"\n    records.mkdir(parents=True)\n    (records / \"spec-01.json\").write_text(json.dumps({\"status\": \"pass\"}))\n    commit_all(root, \"spec record for item 1\")\n    subprocess.run([\"git\", \"-C\", str(root), \"checkout\", \"main\"], check=True)\n    subprocess.run([\"git\", \"-C\", str(root), \"merge\", \"--no-ff\", \"-m\",\n                    \"Merge branch 'attavo/1-x'\", \"attavo/1-x\"], check=True)\n\n    subprocess.run([\"git\", \"-C\", str(root), \"checkout\", \"-b\", \"ordinary-change\"], check=True)\n    touched = root / ordinary_touches\n    touched.parent.mkdir(parents=True, exist_ok=True)\n    touched.write_text(\"v2\\n\")\n    commit_all(root, \"an ordinary change\")\n    subprocess.run([\"git\", \"-C\", str(root), \"checkout\", \"main\"], check=True)\n    subprocess.run([\"git\", \"-C\", str(root), \"merge\", \"--no-ff\", \"-m\",\n                    \"Merge branch 'ordinary-change'\", \"ordinary-change\"], check=True)\n\n    if include_direct_commit:\n        (root / \"direct.txt\").write_text(\"direct\\n\")\n        commit_all(root, \"a change committed straight to main\")\n\n    return root\n\n\ndef test_proof_three_fails_naming_the_direct_commit_with_the_three_counts(tmp_path: Path) -> None:\n    \"\"\"Acceptance row 1, issue #72. The three-way fixture with its direct\n    commit included: proof three fails, naming the direct commit and\n    reporting all three counts in the reason.\"\"\"\n    root = _three_way_fixture(tmp_path, \"direct_commit\", boundary_paths=[\"boundary/**\"],\n                              ordinary_touches=\"pins/version.txt\", include_direct_commit=True)\n    direct_sha = subprocess.run([\"git\", \"-C\", str(root), \"rev-parse\", \"HEAD\"],\n                                capture_output=True, text=True, check=True).stdout.strip()\n\n    p = run_doctor(root)[\"no-commit-lacks-record\"]\n    assert not p[\"holds\"]\n    assert \"1 recorded, 1 ordinary, 1 unrecorded\" in p[\"reason\"]\n    assert direct_sha[:12] in p[\"reason\"]\n\n\ndef test_proof_three_holds_with_zero_unrecorded_once_the_direct_commit_is_gone(tmp_path: Path) -> None:\n    \"\"\"Acceptance row 2, issue #72. The same fixture with the direct commit\n    removed: proof three holds, reporting `0 unrecorded`.\"\"\"\n    root = _three_way_fixture(tmp_path, \"no_direct_commit\", boundary_paths=[\"boundary/**\"],\n                              ordinary_touches=\"pins/version.txt\", include_direct_commit=False)\n\n    p = run_doctor(root)[\"no-commit-lacks-record\"]\n    assert p[\"holds\"], p[\"reason\"]\n    assert \"1 recorded, 1 ordinary, 0 unrecorded\" in p[\"reason\"]\n\n\ndef test_proof_three_reports_boundary_evasions_and_still_holds(tmp_path: Path) -> None:\n    \"\"\"Acceptance row 3, issue #72. The ordinary merge touches a path\n    inside [spec.boundary].paths: the reason carries `boundary evasions:\n    1`, and the proof still holds -- evasions are reported, never\n    refused.\"\"\"\n    root = _three_way_fixture(tmp_path, \"boundary_evasion\", boundary_paths=[\"boundary/**\"],\n                              ordinary_touches=\"boundary/thing.txt\", include_direct_commit=False)\n\n    p = run_doctor(root)[\"no-commit-lacks-record\"]\n    assert p[\"holds\"], p[\"reason\"]\n    assert \"boundary evasions: 1\" in p[\"reason\"]\n\n\ndef test_proof_three_reports_boundary_evasions_as_not_available_with_no_boundary_paths(tmp_path: Path) -> None:\n    \"\"\"Acceptance row 4, issue #72. A tenant declaring no [spec.boundary]\n    paths at all: evasions are reported as `n/a`, not `0` -- an absent\n    read is not the same measurement as zero evasions found.\"\"\"\n    root = _three_way_fixture(tmp_path, \"no_boundary\", boundary_paths=None,\n                              ordinary_touches=\"pins/version.txt\", include_direct_commit=False)\n\n    p = run_doctor(root)[\"no-commit-lacks-record\"]\n    assert p[\"holds\"], p[\"reason\"]\n    assert \"boundary evasions: n/a\" in p[\"reason\"]\n    assert p[\"boundary_evasions\"] == \"n/a\"\n\n\ndef test_proof_three_json_carries_the_path_ratio_fields(tmp_path: Path) -> None:\n    \"\"\"Acceptance row 5, issue #72. `attavo doctor --json` carries\n    `recorded`, `ordinary`, `unrecorded`, and `boundary_evasions` on\n    proof three's own entry -- the path-ratio primitive Phase 4 names,\n    produced now because a decision depends on it.\"\"\"\n    root = _three_way_fixture(tmp_path, \"json_fields\", boundary_paths=[\"boundary/**\"],\n                              ordinary_touches=\"pins/version.txt\", include_direct_commit=False)\n\n    p = run_doctor(root)[\"no-commit-lacks-record\"]\n    assert p[\"recorded\"] == 1\n    assert p[\"ordinary\"] == 1\n    assert p[\"unrecorded\"] == 0\n    assert p[\"boundary_evasions\"] == 0\n\n\ndef test_proof_three_json_lists_the_ordinary_and_unrecorded_commits(tmp_path: Path) -> None:\n    \"\"\"Issue #148. Proof three's JSON entry carries `ordinary_commits` and\n    `unrecorded_commits`, each commit with sha and subject, so a reader\n    can name the commits behind the counts without re-running the\n    classification by hand. The ordinary merge that touches a boundary\n    path is flagged `boundary_evasion: true`.\"\"\"\n    root = _three_way_fixture(tmp_path, \"commit_lists\", boundary_paths=[\"boundary/**\"],\n                              ordinary_touches=\"boundary/thing.txt\", include_direct_commit=True)\n    direct_sha = subprocess.run([\"git\", \"-C\", str(root), \"rev-parse\", \"HEAD\"],\n                                capture_output=True, text=True, check=True).stdout.strip()\n\n    p = run_doctor(root)[\"no-commit-lacks-record\"]\n    ordinary_commits = p[\"ordinary_commits\"]\n    unrecorded_commits = p[\"unrecorded_commits\"]\n    assert [c[\"subject\"] for c in ordinary_commits] == [\"Merge branch 'ordinary-change'\"]\n    assert len(ordinary_commits[0][\"sha\"]) == 40\n    assert ordinary_commits[0][\"boundary_evasion\"] is True\n    assert [c[\"subject\"] for c in unrecorded_commits] == [\"a change committed straight to main\"]\n    assert unrecorded_commits[0][\"sha\"] == direct_sha\n\n\ndef _window_fixture(tmp_path: Path, name: str) -> tuple[Path, str, str]:\n    \"\"\"Two commits made straight to main, then a branch carrying item 1's\n    spec record, merged --no-ff. Returns (root, merge_sha, branch_sha) --\n    merge_sha is on main's first-parent line and is the only sha issue\n    #74's [doctor] from tests declare as valid; branch_sha is the branch\n    commit itself, reachable only as the merge's second parent and never\n    on that line, the sha the invalid-from test declares instead.\"\"\"\n    root = tmp_path / name\n    root.mkdir()\n    (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n')\n    init_repo(root, \"install\")\n\n    (root / \"pre1.txt\").write_text(\"1\\n\")\n    commit_all(root, \"a change committed straight to main\")\n    (root / \"pre2.txt\").write_text(\"2\\n\")\n    commit_all(root, \"another change committed straight to main\")\n\n    subprocess.run([\"git\", \"-C\", str(root), \"checkout\", \"-b\", \"attavo/1-x\"], check=True)\n    records = root / \"records\" / \"1\"\n    records.mkdir(parents=True)\n    (records / \"spec-01.json\").write_text(json.dumps({\"status\": \"pass\"}))\n    commit_all(root, \"spec record for item 1\")\n    branch_sha = subprocess.run([\"git\", \"-C\", str(root), \"rev-parse\", \"HEAD\"],\n                                capture_output=True, text=True, check=True).stdout.strip()\n    subprocess.run([\"git\", \"-C\", str(root), \"checkout\", \"main\"], check=True)\n    subprocess.run([\"git\", \"-C\", str(root), \"merge\", \"--no-ff\", \"-m\",\n                    \"Merge branch 'attavo/1-x'\", \"attavo/1-x\"], check=True)\n    merge_sha = subprocess.run([\"git\", \"-C\", str(root), \"rev-parse\", \"HEAD\"],\n                               capture_output=True, text=True, check=True).stdout.strip()\n    return root, merge_sha, branch_sha\n\n\ndef _declare_doctor_from(root: Path, from_sha: str) -> None:\n    \"\"\"Names [doctor] from via its own merge, not a direct commit to\n    main -- declaring the window must never itself read as an unrecorded\n    commit inside it.\"\"\"\n    subprocess.run([\"git\", \"-C\", str(root), \"checkout\", \"-b\", \"declare-window\"], check=True)\n    toml = root / \"attavo.toml\"\n    toml.write_text(toml.read_text() + f'\\n[doctor]\\nfrom = \"{from_sha}\"\\n')\n    commit_all(root, \"declare the doctor's window\")\n    subprocess.run([\"git\", \"-C\", str(root), \"checkout\", \"main\"], check=True)\n    subprocess.run([\"git\", \"-C\", str(root), \"merge\", \"--no-ff\", \"-m\",\n                    \"Merge branch 'declare-window'\", \"declare-window\"], check=True)\n\n\ndef test_proof_three_holds_reporting_before_the_window_with_doctor_from(tmp_path: Path) -> None:\n    \"\"\"Acceptance row 4, issue #74. [doctor] from names the item merge:\n    the two commits made straight to main before it fall before the\n    window, not into unrecorded -- proof three holds, `before the\n    window: 2`, and the window's own counts, 1 recorded (the item merge)\n    and 1 ordinary (the merge that declares the window itself).\"\"\"\n    root, merge_sha, _ = _window_fixture(tmp_path, \"window_holds\")\n    _declare_doctor_from(root, merge_sha)\n\n    p = run_doctor(root)[\"no-commit-lacks-record\"]\n    assert p[\"holds\"], p[\"reason\"]\n    assert \"before the window: 2\" in p[\"reason\"]\n    assert \"1 recorded, 1 ordinary, 0 unrecorded\" in p[\"reason\"]\n    assert p[\"before_window\"] == 2\n\n\ndef test_proof_three_holds_when_doctor_from_names_a_seven_character_prefix(tmp_path: Path) -> None:\n    \"\"\"Acceptance row 5 (amendment), issue #74. [doctor] from need not be\n    a full sha -- any spelling git rev-parse --verify resolves is\n    accepted, resolved before the first-parent check runs. A\n    seven-character prefix of the item merge holds with the same counts\n    as the full-sha case.\"\"\"\n    root, merge_sha, _ = _window_fixture(tmp_path, \"window_holds_short_sha\")\n    _declare_doctor_from(root, merge_sha[:7])\n\n    p = run_doctor(root)[\"no-commit-lacks-record\"]\n    assert p[\"holds\"], p[\"reason\"]\n    assert \"before the window: 2\" in p[\"reason\"]\n    assert \"1 recorded, 1 ordinary, 0 unrecorded\" in p[\"reason\"]\n    assert p[\"before_window\"] == 2\n\n\ndef test_proof_three_fails_naming_the_key_when_doctor_from_is_off_the_first_parent_line(tmp_path: Path) -> None:\n    \"\"\"Acceptance row 5, issue #74. [doctor] from names the item branch's\n    own commit -- reachable only as a merge's second parent, never on\n    main's first-parent line -- proof three fails naming the key rather\n    than silently falling back to the install commit.\"\"\"\n    root, _, branch_sha = _window_fixture(tmp_path, \"window_off_line\")\n    _declare_doctor_from(root, branch_sha)\n\n    p = run_doctor(root)[\"no-commit-lacks-record\"]\n    assert not p[\"holds\"]\n    assert \"[doctor] from\" in p[\"reason\"]\n    assert branch_sha[:12] in p[\"reason\"]\n\n\ndef test_proof_three_defaults_to_the_install_commit_when_doctor_key_is_absent(tmp_path: Path) -> None:\n    \"\"\"Acceptance row 6, issue #74. No [doctor] table at all: the window\n    defaults to the install commit exactly as before this issue -- both\n    commits made straight to main are still read as unrecorded, and\n    before_window is 0 -- the read every existing proof-three test\n    exercises is unaffected by the key's addition.\"\"\"\n    root, _merge_sha, _branch_sha = _window_fixture(tmp_path, \"window_absent\")\n\n    p = run_doctor(root)[\"no-commit-lacks-record\"]\n    assert not p[\"holds\"]\n    assert \"1 recorded, 0 ordinary, 2 unrecorded\" in p[\"reason\"]\n    assert \"before the window: 0\" in p[\"reason\"]\n    assert p[\"before_window\"] == 0\n\n\ndef test_doctor_proof_one_refuses_a_gate_with_empty_retires(tmp_path: Path) -> None:\n    \"\"\"Residual, issue #54 -- proposed, not yet ruled on: a gate that\n    retires nothing only adds. The manifest schema has required\n    [gates.<name>].retires to be non-empty since Phase 1, but read_manifest\n    never validates against that schema, so nothing enforced it at\n    runtime until this proof read it directly.\"\"\"\n    root = tmp_path / \"empty_retires\"\n    root.mkdir()\n    (root / \"attavo.toml\").write_text(\n        '[paths]\\nrejections = \"rejections\"\\n\\n'\n        '[gates.spec]\\ncommand = \"false\"\\nretires = []\\n')\n    (root / \"rejections\" / \"spec\").mkdir(parents=True)\n    init_repo(root, \"install\")\n\n    p = run_doctor(root)[\"every-gate-rejects\"]\n    assert not p[\"holds\"]\n    assert \"retires\" in p[\"reason\"] and \"spec\" in p[\"reason\"]\n\n\ndef test_doctor_proof_one_runs_the_gate_without_an_item_argument(tmp_path: Path) -> None:\n    \"\"\"Issue #7, and its regression test. [gates.spec].command is a bare\n    `attavo spec-gate`, no item argument, and its rejections/spec/ fixture\n    carries no attavo/N-* branch at all (init_repo leaves it on `main`) --\n    so before the doctor exported the fixture's item as ATTAVO_ITEM, the\n    gate command would exit 2 (cannot derive item id) without ever writing\n    a record, which still counts as \"rejected\" but proves nothing about the\n    prose criterion this fixture means to test.\n\n    Red at the merge base: no ATTAVO_ITEM export existed, so no\n    spec-01.json was ever written and reading it raised FileNotFoundError.\n    Green once the doctor exports it: the record exists and names the\n    prose criterion by name, which is the actual thing proof one asserts.\n    \"\"\"\n    outer = tmp_path / \"gate_rejection\"\n    shutil.copytree(FIXTURES / \"gate_rejection\", outer)\n    cmd = f\"{sys.executable} {ATTAVO}\"\n    toml = outer / \"attavo.toml\"\n    toml.write_text(toml.read_text().replace(\"ATTAVO_CMD\", cmd))\n    init_repo(outer / \"rejections\" / \"spec\")\n\n    p = run_doctor(outer)[\"every-gate-rejects\"]\n    assert p[\"holds\"], p[\"reason\"]\n\n    record = json.loads(\n        (outer / \"rejections\" / \"spec\" / \"records\" / \"1\" / \"spec-01.json\").read_text())\n    assert record[\"refusal\"] == \"criterion is prose: missing.sh\"\n\n\ndef test_doctor_proof_four_fails_on_a_failed_record_with_no_stop(tmp_path: Path) -> None:\n    \"\"\"Acceptance row 1, issue #94: a failed build record at\n    record_version 3 with a two-line log and no stop at all -- a stop\n    the product forgot to write, the way tenant zero's #576 build-11\n    (before record_version 3 existed) was diagnosed only by a person\n    rerunning it by hand. Fails today: no proof four exists.\"\"\"\n    root = make_tenant(tmp_path, \"no_stop_lacks_cause\")\n\n    p = run_doctor(root)[\"no-stop-lacks-cause\"]\n    assert not p[\"holds\"]\n    assert \"build-01\" in p[\"reason\"]\n    assert \"no stop\" in p[\"reason\"]\n\n\ndef test_doctor_proof_four_holds_on_a_fixture_with_stop_and_gates_heading(tmp_path: Path) -> None:\n    \"\"\"Acceptance row 2, issue #94: a failed build record whose stop is\n    present and valid, and whose log carries the gates heading since\n    gates actually ran (selected_tests is set) -- proof four holds.\"\"\"\n    root = tmp_path / \"stop_holds\"\n    root.mkdir()\n    (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n')\n    init_repo(root, \"install\")\n\n    records = root / \"records\" / \"1\"\n    records.mkdir(parents=True)\n    build = {\n        \"status\": \"failed\", \"record_version\": 3,\n        \"selected_tests\": {\"select\": \"cat\", \"run\": \"cat\", \"count\": 1, \"exit\": 1},\n        \"stop\": {\"class\": \"unclassed\", \"provenance\": \"product\", \"detail\": \"1 failed, 0 passed\"},\n    }\n    (records / \"build-01.json\").write_text(json.dumps(build))\n    (records / \"build-01.log\").write_text(\n        \"--- attavo gates, iteration 1 ---\\ncriterion x: exit 1\\n1 failed, 0 passed\")\n    commit_all(root, \"a failed build record with a proper stop and gates heading\")\n\n    p = run_doctor(root)[\"no-stop-lacks-cause\"]\n    assert p[\"holds\"], p[\"reason\"]\n\n\ndef test_doctor_proof_four_reports_older_records_mixing_versions_2_and_3(tmp_path: Path) -> None:\n    \"\"\"Acceptance row 3, issue #94: a record_version 2 record predates\n    stop by construction (proof three's own window lesson) and is\n    counted, never refused; a record_version 3 record alongside it is\n    checked as usual. Proof four holds, reporting the older count.\"\"\"\n    root = tmp_path / \"mixed_versions\"\n    root.mkdir()\n    (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n')\n    init_repo(root, \"install\")\n\n    records = root / \"records\" / \"1\"\n    records.mkdir(parents=True)\n    (records / \"build-01.json\").write_text(json.dumps({\"status\": \"failed\", \"record_version\": 2}))\n    (records / \"verify-01.json\").write_text(json.dumps({\n        \"status\": \"returned\", \"record_version\": 3,\n        \"stop\": {\"class\": \"forge-unconcluded\", \"provenance\": \"tenant\", \"detail\": None}}))\n    commit_all(root, \"one older record before stop, one current record with a stop\")\n\n    p = run_doctor(root)[\"no-stop-lacks-cause\"]\n    assert p[\"holds\"], p[\"reason\"]\n    assert \"1 record(s) before stop was recorded\" in p[\"reason\"]\n    assert p[\"older_records\"] == 1\n\n\ndef test_doctor_proof_four_holds_with_no_non_pass_records_to_check(tmp_path: Path) -> None:\n    \"\"\"A tenant found on a real v0.16.3 pin: no non-pass build or verify\n    record at record_version 3 or later exists to check -- every item\n    passed. The clause is \"every failed or refused record carries its\n    cause\", which holds vacuously on an empty set, the way proof three\n    holds when nothing is unrecorded. Proof four must hold, reporting\n    0 checked and the older-record count, not fail the tenant for having\n    nothing to check.\"\"\"\n    root = tmp_path / \"all_pass\"\n    root.mkdir()\n    (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n')\n    init_repo(root, \"install\")\n\n    records = root / \"records\" / \"1\"\n    records.mkdir(parents=True)\n    (records / \"build-01.json\").write_text(json.dumps({\"status\": \"failed\", \"record_version\": 2}))\n    (records / \"verify-01.json\").write_text(json.dumps({\"status\": \"pass\", \"record_version\": 3}))\n    commit_all(root, \"one older record before stop, one current record that passed\")\n\n    p = run_doctor(root)[\"no-stop-lacks-cause\"]\n    assert p[\"holds\"], p[\"reason\"]\n    assert \"0 checked\" in p[\"reason\"]\n    assert \"1 record(s) before stop was recorded\" in p[\"reason\"]\n    assert p[\"older_records\"] == 1\n\n\ndef test_doctor_proof_four_fails_when_gates_ran_but_the_log_lacks_their_heading(tmp_path: Path) -> None:\n    \"\"\"Issue #94's own proposed fix: a failed build whose selected_tests\n    is set -- gates definitely ran that iteration -- but whose log\n    carries no gates heading at all. Tenant zero's #659 build-01 was\n    exactly this before issue #89's own fix landed: the gate output that\n    failed it lived only in a temporary directory the product deleted.\"\"\"\n    root = tmp_path / \"missing_gates_heading\"\n    root.mkdir()\n    (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n')\n    init_repo(root, \"install\")\n\n    records = root / \"records\" / \"1\"\n    records.mkdir(parents=True)\n    build = {\n        \"status\": \"failed\", \"record_version\": 3,\n        \"selected_tests\": {\"select\": \"cat\", \"run\": \"cat\", \"count\": 1, \"exit\": 1},\n        \"stop\": {\"class\": \"unclassed\", \"provenance\": \"product\", \"detail\": \"1 failed, 0 passed\"},\n    }\n    (records / \"build-01.json\").write_text(json.dumps(build))\n    (records / \"build-01.log\").write_text(\"1 failed, 0 passed\")\n    commit_all(root, \"a failed build with gates run but no gates heading in the log\")\n\n    p = run_doctor(root)[\"no-stop-lacks-cause\"]\n    assert not p[\"holds\"]\n    assert \"gates heading\" in p[\"reason\"]\n\n\ndef test_doctor_proof_four_fails_when_a_log_ends_in_an_adapter_exit_after_only_event_lines(\n        tmp_path: Path) -> None:\n    \"\"\"Issue #94's own proposed fix, tenant zero's #659 verify-01\n    specimen: a log whose last line is a bare adapter-exit marker with\n    nothing before it but the adapter's own JSON event stream -- the\n    tool's real error line never reached it (issue #86's own\n    split_adapter_stdout bug, now guarded against at read time too).\"\"\"\n    root = tmp_path / \"owed_tool_error\"\n    root.mkdir()\n    (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n')\n    init_repo(root, \"install\")\n\n    records = root / \"records\" / \"1\"\n    records.mkdir(parents=True)\n    verify = {\n        \"status\": \"failed\", \"record_version\": 3,\n        \"stop\": {\"class\": \"unclassed\", \"provenance\": \"product\", \"detail\": \"[adapter exited 1]\"},\n    }\n    (records / \"verify-01.json\").write_text(json.dumps(verify))\n    (records / \"verify-01.log\").write_text(\n        '{\"type\":\"thread.started\",\"thread_id\":\"x\"}\\n[adapter exited 1]')\n    commit_all(root, \"a failed verify whose tool error line was dropped\")\n\n    p = run_doctor(root)[\"no-stop-lacks-cause\"]\n    assert not p[\"holds\"]\n    assert \"tool's own error line is owed\" in p[\"reason\"]\n\n\ndef test_proof_four_reads_an_error_event_as_the_tools_own_words(tmp_path: Path) -> None:\n    \"\"\"Issue #200: a review the vendor refused (\"Selected model is at\n    capacity\") logs the tool's own error as an `error` event, then the\n    exit marker. The cause is in the log, in the tool's words, so proof\n    four does not owe a line. An `error` event with an empty or missing\n    message says nothing and still owes it.\"\"\"\n    event_lines = ('{\"type\":\"thread.started\",\"thread_id\":\"x\"}\\n'\n                   '{\"type\":\"turn.started\"}\\n')\n    exit_line = \"[adapter exited 1]\"\n    verify = {\n        \"status\": \"failed\", \"record_version\": 3,\n        \"stop\": {\"class\": \"unclassed\", \"provenance\": \"product\", \"detail\": exit_line},\n    }\n    cases = {\n        \"with_message\": (\n            '{\"type\":\"error\",\"message\":\"Selected model is at capacity. '\n            'Please try a different model.\"}\\n', True),\n        \"empty_message\": ('{\"type\":\"error\",\"message\":\"\"}\\n', False),\n        \"missing_message\": ('{\"type\":\"error\"}\\n', False),\n    }\n    for name, (error_line, holds) in cases.items():\n        root = tmp_path / name\n        root.mkdir()\n        (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n')\n        init_repo(root, \"install\")\n\n        records = root / \"records\" / \"1\"\n        records.mkdir(parents=True)\n        (records / \"verify-01.json\").write_text(json.dumps(verify))\n        (records / \"verify-01.log\").write_text(event_lines + error_line + exit_line)\n        commit_all(root, f\"a failed verify whose log has an error event: {name}\")\n\n        p = run_doctor(root)[\"no-stop-lacks-cause\"]\n        assert p[\"holds\"] is holds, (name, p[\"reason\"])\n        if not holds:\n            assert \"tool's own error line is owed\" in p[\"reason\"], name\n\n\ndef test_doctor_proof_four_fails_on_an_unclassed_stop_with_no_detail(tmp_path: Path) -> None:\n    \"\"\"An unclassed stop's whole contract is its detail (issue #89):\n    with none, the record is exactly as unexplained as no stop at all.\"\"\"\n    root = tmp_path / \"unclassed_no_detail\"\n    root.mkdir()\n    (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n')\n    init_repo(root, \"install\")\n\n    records = root / \"records\" / \"1\"\n    records.mkdir(parents=True)\n    build = {\"status\": \"failed\", \"record_version\": 3,\n            \"stop\": {\"class\": \"unclassed\", \"provenance\": \"product\", \"detail\": None}}\n    (records / \"build-01.json\").write_text(json.dumps(build))\n    commit_all(root, \"an unclassed stop with no detail\")\n\n    p = run_doctor(root)[\"no-stop-lacks-cause\"]\n    assert not p[\"holds\"]\n    assert \"unclassed with no detail\" in p[\"reason\"]\n\n\ndef _dead_pid() -> int:\n    \"\"\"A pid guaranteed not to be running: a real child, spawned and\n    reaped, on this host.\"\"\"\n    proc = subprocess.Popen([sys.executable, \"-c\", \"pass\"])\n    proc.wait()\n    return proc.pid\n\n\ndef test_doctor_proof_five_fails_on_a_dead_invocation_with_no_record(tmp_path: Path) -> None:\n    \"\"\"Issue #151: a build-01.started marker naming a dead pid on this\n    host, with no build-01.json to retire it, is exactly the silence two\n    build attempts of item #148 left behind -- proof five names it.\"\"\"\n    root = tmp_path / \"dead_invocation\"\n    root.mkdir()\n    (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n\\n'\n                                      '[drive]\\nstall_after_s = 60\\n')\n    init_repo(root, \"install\")\n\n    records = root / \"records\" / \"1\"\n    records.mkdir(parents=True)\n    (records / \"build-01.started\").write_text(json.dumps({\n        \"at\": \"2026-09-17T13:16:08Z\", \"host\": socket.gethostname(), \"pid\": _dead_pid(),\n        \"sha\": \"0\" * 40, \"product_version\": \"fixture\"}))\n    commit_all(root, \"invocation marker for item 1\")\n\n    p = run_doctor(root)[\"no-invocation-lacks-record\"]\n    assert not p[\"holds\"]\n    assert \"build-01\" in p[\"reason\"] and \"never wrote its record\" in p[\"reason\"]\n\n\ndef test_doctor_proof_five_holds_once_the_record_arrives(tmp_path: Path) -> None:\n    \"\"\"The same marker, retired by its own build-01.json: proof five\n    holds -- the record's arrival is what retires a marker, not its\n    removal.\"\"\"\n    root = tmp_path / \"recorded_invocation\"\n    root.mkdir()\n    (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n\\n'\n                                      '[drive]\\nstall_after_s = 60\\n')\n    init_repo(root, \"install\")\n\n    records = root / \"records\" / \"1\"\n    records.mkdir(parents=True)\n    (records / \"build-01.started\").write_text(json.dumps({\n        \"at\": \"2026-09-17T13:16:08Z\", \"host\": socket.gethostname(), \"pid\": _dead_pid(),\n        \"sha\": \"0\" * 40, \"product_version\": \"fixture\"}))\n    (records / \"build-01.json\").write_text(json.dumps({\"status\": \"pass\"}))\n    commit_all(root, \"invocation marker and its record for item 1\")\n\n    p = run_doctor(root)[\"no-invocation-lacks-record\"]\n    assert p[\"holds\"], p[\"reason\"]\n\n\ndef test_doctor_proof_five_reports_a_live_invocation_as_running_not_failed(tmp_path: Path) -> None:\n    \"\"\"A marker naming this test's own pid, on this host, with no\n    record: alive, so proof five holds and names it running rather than\n    failing the tenant for a drive that has not had the chance to finish\n    yet.\"\"\"\n    root = tmp_path / \"live_invocation\"\n    root.mkdir()\n    (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n\\n'\n                                      '[drive]\\nstall_after_s = 60\\n')\n    init_repo(root, \"install\")\n\n    records = root / \"records\" / \"1\"\n    records.mkdir(parents=True)\n    (records / \"build-01.started\").write_text(json.dumps({\n        \"at\": \"2026-09-17T13:16:08Z\", \"host\": socket.gethostname(), \"pid\": os.getpid(),\n        \"sha\": \"0\" * 40, \"product_version\": \"fixture\"}))\n    commit_all(root, \"invocation marker for a still-running invocation\")\n\n    p = run_doctor(root)[\"no-invocation-lacks-record\"]\n    assert p[\"holds\"], p[\"reason\"]\n    assert len(p[\"running_invocations\"]) == 1\n    assert \"build-01\" in p[\"running_invocations\"][0]\n\n\ndef test_doctor_proof_five_fails_without_stall_after_s_in_the_manifest(tmp_path: Path) -> None:\n    \"\"\"A tenant with no [drive].stall_after_s carries no bound past which\n    a live invocation is hung -- proof five cannot tell a hung drive from\n    a running one, and refuses to guess a default.\"\"\"\n    root = tmp_path / \"no_stall_bound\"\n    root.mkdir()\n    (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n')\n    init_repo(root, \"install\")\n\n    records = root / \"records\" / \"1\"\n    records.mkdir(parents=True)\n    (records / \"build-01.json\").write_text(json.dumps({\"status\": \"pass\"}))\n    commit_all(root, \"a record with no [drive].stall_after_s declared\")\n\n    p = run_doctor(root)[\"no-invocation-lacks-record\"]\n    assert not p[\"holds\"]\n    assert \"stall_after_s\" in p[\"reason\"]\n\n\ndef test_doctor_refuses_a_drive_table_without_ceilings(tmp_path: Path) -> None:\n    \"\"\"R3: a [drive] table that declares a stall bound and no\n    [drive.build].ceiling_s or [drive.verify].ceiling_s carries no bound\n    past which a live stage is hung by wall clock -- proof five refuses\n    to guess one, as it refuses to guess the stall bound.\"\"\"\n    root = tmp_path / \"no_ceilings\"\n    root.mkdir()\n    (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n\\n[drive]\\nstall_after_s = 60\\nattempts = 3\\n')\n    init_repo(root, \"install\")\n\n    records = root / \"records\" / \"1\"\n    records.mkdir(parents=True)\n    (records / \"build-01.json\").write_text(json.dumps({\"status\": \"pass\"}))\n    commit_all(root, \"a drive table with no ceilings\")\n\n    p = run_doctor(root)[\"no-invocation-lacks-record\"]\n    assert not p[\"holds\"]\n    assert \"ceiling\" in p[\"reason\"]\n","numLines":921,"startLine":1,"totalLines":921}}}

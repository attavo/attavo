  \"your own tools, then answer with exactly one class (the stop's \"\n   441\t        \"class, or \\\"unclassed\\\"), one verdict -- \\\"answer\\\" (the stop is \"\n   442\t        \"answerable inside the rules: a ruling text, in \"\n   443\t        \"proposal.ruling_text, with three citations -- instruction, \"\n   444\t        \"mechanism, guard, each a path and symbol or a ruling id), \"\n   445\t        \"\\\"patch\\\" (the stop is a product defect: the mechanism's file \"\n   446\t        \"and symbol, a rejection test, and a unified diff, in \"\n   447\t        \"proposal.patch -- or, when the remedy is better filed as an \"\n   448\t        \"item than shipped as a diff, a title and a body in this \"\n   449\t        \"repository's own issue format -- a Severity/Provenance line, \"\n   450\t        \"then Problem, Retires, Change, and Acceptance sections -- in \"\n   451\t        \"proposal.issue), or \\\"person\\\" (the answer would touch the \"\n   452\t        \"definition of done and no rule covers it: the question restated \"\n   453\t        \"in one line, in proposal.question -- or, when the remedy is \"\n   454\t        \"better filed as an item than asked as a bare question, a title \"\n   455\t        \"and a body in the same issue format, in proposal.issue) -- and \"\n   456\t        \"citations for whichever verdict you gave. You propose; you do \"\n   457\t        \"not act.\")\n   458\t    return \"\\n\\n\".join(parts)\n   459\t\n   460\t\n   461\tBUILD_ALLOWED_TOOLS = [\"Read\", \"Edit\", \"Write\", \"Bash\"]\n   462\tVERIFY_ALLOWED_TOOLS = [\"Read\", \"Bash\"]\n   463\t\n   464\t# Issue #88 (class B): both tools the tool's own reply named as a way to\n   465\t# spawn work that outlives this invocation -- confirmed live against\n   466\t# `claude 2.1.269` (see module docstring). Named on both stages: verify's\n   467\t# own allowed tools never included either, and did not stop the\n   468\t# specimen either.\n   469\tSUBAGENT_TOOLS = [\"Agent\", \"Workflow\"]\n   470\t\n   471\t\n   472\tdef load_config() -> dict:\n   473\t    raw = os.environ.get(\"ATTAVO_ADAPTER_CONFIG\")\n   474\t    return json.loads(raw) if raw else {}\n   475\t\n   476\t\n   477\tdef refused_config_key(config: dict) -> str | None:\n   478\t    \"\"\"None if config carries no retired key; else the refusal message.\n   479\t    allowed_tools (issue #78) is retired, not ignored: the sandbox is the\n   480\t    boundary now, a curated Bash(...) prefix list is not, and a manifest\n   481\t    still naming it must be refused rather than silently accepted.\"\"\"\n   482\t    if \"allowed_tools\" in config:\n   483\t        return (\"[executor.claude-code].allowed_tools is retired (issue \"\n   484\t                \"#78) -- the sandbox is the boundary now, not a curated \"\n   485\t                \"Bash(...) prefix list\")\n   486\t    return None\n   487\t\n   488\t\n   489\t# Issue #93: claude code publishes no numeric input-size ceiling\n   490\t# anywhere in its own surface (--help, docs, or any config file,\n   491\t# confirmed against claude 2.1.269) -- unlike codex's documented\n   492\t# input_too_large. This adapter asserts its own instruction stays under\n   493\t# a fixed bound instead of a tool-documented one, so an undeclared tool\n   494\t# still cannot be handed an unbounded prompt.\n   495\tFIXED_BOUND_CHARS = 65_536\n   496\t\n   497\t\n   498\tdef input_limit_chars() -> int:\n   499\t    \"\"\"The bound this adapter enforces in place of a declared ceiling.\n   500\t    Overridable only for tests via ATTAVO_ADAPTER_INPUT_LIMIT_CHARS --\n   501\t    never a tenant knob: the ceiling is a fact about the tool, not\n   502\t    something [executor.claude-code] can set.\"\"\"\n   503\t    override = os.environ.get(\"ATTAVO_ADAPTER_INPUT_LIMIT_CHARS\")\n   504\t    return int(override) if override else FIXED_BOUND_CHARS\n   505\t\n   506\t\n   507\tdef ceiling_refusal(instruction: str) -> str | None:\n   508\t    \"\"\"None if instruction stays at or under the fixed bound; else the\n   509\t    refusal naming both numbers, checked before claude is ever invoked.\"\"\"\n   510\t    limit = input_limit_chars()\n   511\t    size = len(instruction)\n   512\t    if size <= limit:\n   513\t        return None\n   514\t    return (f\"ceiling exceeded -- instruction is {size} chars, over \"\n   515\t           f\"the fixed bound of {limit} chars (claude code declares no \"\n   516\t           f\"input limit of its own)\")\n   517\t\n   518\t\n   519\tREAD_ONLY_STAGES = (\"verify\", \"counsel\")\n   520\t\n   521\t\n   522\tdef sandbox_settings(stage: str, working_directory: Path) -> dict:\n   523\t    \"\"\"Every Bash command and its children stay confined to\n   524\t    working_directory (writes) and the network stays closed for every\n   525\t    stage (issue #78) -- confirmed live, not assumed. verify and counsel\n   526\t    (issue #100) additionally deny writes to working_directory itself,\n   527\t    making \"make no edits, write no files\" mechanical rather than merely\n   528\t    instructed -- counsel is a read-only invocation, the same sandbox\n   529\t    verify runs under.\n   530\t    \"\"\"\n   531\t    sandbox = {\n   532\t        \"enabled\": True,\n   533\t        \"allowUnsandboxedCommands\": False,\n   534\t        \"network\": {\"allowedDomains\": []},\n   535\t    }\n   536\t    if stage in READ_ONLY_STAGES:\n   537\t        sandbox[\"filesystem\"] = {\"denyWrite\": [str(working_directory)]}\n   538\t    return {\"sandbox\": sandbox}\n   539\t\n   540\t\n   541\tdef build_command(instruction: str, config: dict, schema: dict, stage: str) -> list[str]:\n   542\t    auth = config.get(\"auth\", \"api\")\n   543\t    allowed_tools = VERIFY_ALLOWED_TOOLS if stage in READ_ONLY_STAGES else BUILD_ALLOWED_TOOLS\n   544\t    permission_mode = config.get(\"permission_mode\", \"acceptEdits\")\n   545\t\n   546\t    cmd = [\"claude\"]\n   547\t    if auth == \"subscription\":\n   548\t        # no --bare: this is the tenant's own login, not a bare API key, so\n   549\t        # the tenant's project hooks and MCP servers must not load -- only\n   550\t        # --setting-sources (CLAUDE.md still loads) and --strict-mcp-config\n   551\t        # keep them out, the same isolation --bare gives in api mode.\n   552\t        setting_sources = config.get(\"setting_sources\", \"user\")\n   553\t        cmd += [\"--setting-sources\", setting_sources, \"--strict-mcp-config\"]\n   554\t    else:\n   555\t        cmd += [\"--bare\"]\n   556\t    cmd += [\"--settings\", json.dumps(sandbox_settings(stage, Path.c","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false,"persistedOutputPath":"/Users/davidbean/.claude/projects/-Users-davidbean-Projects-attavo-worktree-219/0dd7ed4f-100c-4188-9a34-077aa0b6aa25/tool-results/bzmapq88o.txt","persistedOutputSize":55043}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01J1TX3T8gT5L7E1oaG2Uo46","type":"tool_result","content":"1\t\"\"\"The record kinds, typed. Each TypedDict here mirrors one JSON schema: its\n2\tkeys are that schema's `properties` and its required keys are that schema's\n3\t`required`, and tests/test_types_mirror_schemas.py asserts both, so the type\n4\tcannot drift from the contract. The schema stays the contract; this is its\n5\tmirror (issue #189).\n6\t\n7\tEvery key each schema lists is required, so no class here is total=False; a\n8\tkey the schema someday makes optional goes in a total=False base. A value the\n9\tschema declares as an object with fixed properties but this module does not\n10\tyet name is a dict[str, Any] (or a list of them), no tighter than the schema's\n11\town `additionalProperties` allows for the adapter-owned ones.\n12\t\"\"\"\n13\tfrom __future__ import annotations\n14\t\n15\tfrom typing import Any, Literal, TypedDict\n16\t\n17\t# The stage names a record file's <stage>-NN.json prefix can carry, one per\n18\t# schema under schema/records/.\n19\tStage = Literal[\"spec\", \"approval\", \"build\", \"verify\", \"counsel\"]\n20\t\n21\t# \"class\" is a Python keyword, so the record kinds that carry it are built\n22\t# with the functional syntax.\n23\tStop = TypedDict(\"Stop\", {\n24\t    \"class\": str,\n25\t    \"provenance\": str,\n26\t    \"detail\": str | None,\n27\t})\n28\t\"\"\"build-NN.json's and verify-NN.json's `stop`: the class of a stop and whose\n29\tit is. The two schemas enumerate different classes; the shape is the same.\"\"\"\n30\t\n31\t\n32\tclass SpecRecord(TypedDict):\n33\t    record_version: int\n34\t    item: str\n35\t    sha: str\n36\t    spec_sha: str | None\n37\t    at: str\n38\t    status: str\n39\t    approval_sha: str | None\n40\t    criteria: list[dict[str, Any]]\n41\t    refusal: str | None\n42\t    product_version: str\n43\t    product_pin: str | None\n44\t\n45\t\n46\tclass ApprovalRecord(TypedDict):\n47\t    record_version: int\n48\t    item: str\n49\t    sha: str\n50\t    spec_sha: str | None\n51\t    approved_by: str\n52\t    at: str\n53\t    product_version: str\n54\t    product_pin: str | None\n55\t\n56\t\n57\tclass BuildRecord(TypedDict):\n58\t    record_version: int\n59\t    item: str\n60\t    sha: str\n61\t    start_sha: str\n62\t    spec_sha: str | None\n63\t    approval_sha: str | None\n64\t    at: str\n65\t    adapter: str\n66\t    adapter_config: dict[str, Any]\n67\t    executor_identity: dict[str, str]\n68\t    reports: list[str]\n69\t    adapter_version: str | None\n70\t    model: str | None\n71\t    model_version: str | None\n72\t    iterations: int\n73\t    criteria: list[dict[str, Any]]\n74\t    selected_tests: dict[str, Any] | None\n75\t    checks: dict[str, Any] | None\n76\t    tokens: dict[str, int]\n77\t    cost_usd: float | None\n78\t    wall_clock_s: float\n79\t    status: str\n80\t    refusal: str | None\n81\t    halted: dict[str, Any] | None\n82\t    stop: Stop | None\n83\t    product_version: str\n84\t    product_pin: str | None\n85\t\n86\t\n87\tclass VerifyRecord(TypedDict):\n88\t    record_version: int\n89\t    item: str\n90\t    sha: str\n91\t    build_sha: str\n92\t    build_record: str | None\n93\t    approval_sha: str | None\n94\t    at: str\n95\t    adapter: str | None\n96\t    adapter_config: dict[str, Any]\n97\t    adapter_version: str | None\n98\t    model: str | None\n99\t    model_version: str | None\n100\t    reports: list[str]\n101\t    forge_checks: dict[str, Any]\n102\t    findings: list[dict[str, Any]] | None\n103\t    tests_named: list[str]\n104\t    commits: list[str]\n105\t    stub_ratio: float | None\n106\t    tokens: dict[str, int]\n107\t    cost_usd: float | None\n108\t    wall_clock_s: float\n109\t    status: str\n110\t    stop: Stop | None\n111\t    product_version: str\n112\t    product_pin: str | None\n113\t\n114\t\n115\tCounselRecord = TypedDict(\"CounselRecord\", {\n116\t    \"record_version\": int,\n117\t    \"item\": str,\n118\t    \"sha\": str,\n119\t    \"record_stage\": str,\n120\t    \"record\": str,\n121\t    \"at\": str,\n122\t    \"adapter\": str | None,\n123\t    \"adapter_config\": dict[str, Any],\n124\t    \"adapter_version\": str | None,\n125\t    \"model\": str | None,\n126\t    \"model_version\": str | None,\n127\t    \"reports\": list[str],\n128\t    \"tokens\": dict[str, int],\n129\t    \"cost_usd\": float | None,\n130\t    \"wall_clock_s\": float,\n131\t    \"status\": str,\n132\t    \"class\": str | None,\n133\t    \"verdict\": str | None,\n134\t    \"citations\": list[dict[str, Any]],\n135\t    \"proposal\": dict[str, Any],\n136\t    \"forge\": dict[str, Any],\n137\t    \"question\": str | None,\n138\t    \"product_version\": str,\n139\t    \"product_pin\": str | None,\n140\t})\n141\t\n142\t\n143\tclass StageTime(TypedDict):\n144\t    \"\"\"One stage's invocations summed (the statement's `time` block).\"\"\"\n145\t    attempts: int\n146\t    invocation_s: float\n147\t    partial: bool\n148\t\n149\t\n150\tclass ItemTime(TypedDict):\n151\t    \"\"\"Every invocation's wall_clock_s, per stage and for the item, beside\n152\t    the item's lead time -- summed from the records by `attavo attest`, so\n153\t    a view renders it and never derives it.\"\"\"\n154\t    build: StageTime\n155\t    verify: StageTime\n156\t    counsel: StageTime\n157\t    invocation_s: float\n158\t    lead_s: float | None\n159\t    waiting_s: float | None\n160\t    partial: bool\n161\t    not_read: list[str]\n162\t\n163\t\n164\tclass ItemCost(TypedDict):\n165\t    \"\"\"Every record's cost_usd summed: the item's total across stages and\n166\t    executors, with a subtotal per stage and per adapter. A record with no\n167\t    cost_usd is named in not_read and makes every sum it belongs to\n168\t    partial -- absent is never zero.\"\"\"\n169\t    usd: float\n170\t    by_stage_usd: dict[str, float]\n171\t    by_adapter_usd: dict[str, float]\n172\t    partial: bool\n173\t    not_read: list[str]\n174\t\n175\t\n176\tclass AttestRecord(TypedDict):\n177\t    \"\"\"The statement `attavo attest` prints (schema/attestation.schema.json).\"\"\"\n178\t    sha: str\n179\t    merge_sha: str\n180\t    item: str\n181\t    spec: str | None\n182\t    spec_sha: str | None\n183\t    approval: str | None\n184\t    approval_sha: str | None\n185\t    build: str | None\n186\t    build_sha: str | None\n187\t    verify: str | None\n188\t    verify_sha: str | None\n189\t    at: str\n190\t    interventions: list[dict[str, str]]\n191\t    acts: list[dict[str, str]]\n192\t    tokens_by_stage: dict[str, dict[str, Any] | None]\n193\t    cost_by_stage_usd: dict[str, float | None]\n194\t    wall_clock_by_stage_s: dict[str, float | None]\n195\t    time: ItemTime\n196\t    cost: ItemCost\n197\t    product_version: str\n198\t    product_pin: str | None\n199\t\n200\t\n201\t# What counsel reads a stop from: a build or verify record, or a refused\n202\t# spec-gate record (issue #133).\n203\tStageRecord = SpecRecord | BuildRecord | VerifyRecord\n204\t\n205\t\n206\tclass DriveReport(TypedDict):\n207\t    \"\"\"What `attavo drive N --report` prints (schema/drive-report.schema.json):\n208\t    the item's level, read from its records, its markers, and the forge.\"\"\"\n209\t    item: str\n210\t    state: str\n211\t    kind: str\n212\t    says: str\n213\t    stage: str | None\n214\t    attempt: int | None\n215\t    record: str | None\n216\t    stop_class: str | None\n217\t    counsel: str | None\n218\t    filed: str | None\n219\t    head: str | None\n220\t    checks: list[dict[str, str]] | None\n221\t    since: str | None\n222\t    last_event_age_s: int | None\n223\t    attempts: list[dict[str, Any]] | None\n224\t    signatures_match: bool | None\n225\t    rulings_available: list[str] | None\n226\t"}]},"parent_tool_use_id":null,"session_id":"0dd7ed4f-100c-4188-9a34-077aa0b6aa25","uuid":"ac25fde2-acca-4bff-9aa2-85863ea22e67","timestamp":"2026-09-26T02:08:48.907Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-219/attest/specs/219/stub/attavo/types.py","content":"\"\"\"The record kinds, typed. Each TypedDict here mirrors one JSON schema: its\nkeys are that schema's `properties` and its required keys are that schema's\n`required`, and tests/test_types_mirror_schemas.py asserts both, so the type\ncannot drift from the contract. The schema stays the contract; this is its\nmirror (issue #189).\n\nEvery key each schema lists is required, so no class here is total=False; a\nkey the schema someday makes optional goes in a total=False base. A value the\nschema declares as an object with fixed properties but this module does not\nyet name is a dict[str, Any] (or a list of them), no tighter than the schema's\nown `additionalProperties` allows for the adapter-owned ones.\n\"\"\"\nfrom __future__ import annotations\n\nfrom typing import Any, Literal, TypedDict\n\n# The stage names a record file's <stage>-NN.json prefix can carry, one per\n# schema under schema/records/.\nStage = Literal[\"spec\", \"approval\", \"build\", \"verify\", \"counsel\"]\n\n# \"class\" is a Python keyword, so the record kinds that carry it are built\n# with the functional syntax.\nStop = TypedDict(\"Stop\", {\n    \"class\": str,\n    \"provenance\": str,\n    \"detail\": str | None,\n})\n\"\"\"build-NN.json's and verify-NN.json's `stop`: the class of a stop and whose\nit is. The two schemas enumerate different classes; the shape is the same.\"\"\"\n\n\nclass SpecRecord(TypedDict):\n    record_version: int\n    item: str\n    sha: str\n    spec_sha: str | None\n    at: str\n    status: str\n    approval_sha: str | None\n    criteria: list[dict[str, Any]]\n    refusal: str | None\n    product_version: str\n    product_pin: str | None\n\n\nclass ApprovalRecord(TypedDict):\n    record_version: int\n    item: str\n    sha: str\n    spec_sha: str | None\n    approved_by: str\n    at: str\n    product_version: str\n    product_pin: str | None\n\n\nclass BuildRecord(TypedDict):\n    record_version: int\n    item: str\n    sha: str\n    start_sha: str\n    spec_sha: str | None\n    approval_sha: str | None\n    at: str\n    adapter: str\n    adapter_config: dict[str, Any]\n    executor_identity: dict[str, str]\n    reports: list[str]\n    adapter_version: str | None\n    model: str | None\n    model_version: str | None\n    iterations: int\n    criteria: list[dict[str, Any]]\n    selected_tests: dict[str, Any] | None\n    checks: dict[str, Any] | None\n    tokens: dict[str, int]\n    cost_usd: float | None\n    wall_clock_s: float\n    status: str\n    refusal: str | None\n    halted: dict[str, Any] | None\n    stop: Stop | None\n    product_version: str\n    product_pin: str | None\n\n\nclass VerifyRecord(TypedDict):\n    record_version: int\n    item: str\n    sha: str\n    build_sha: str\n    build_record: str | None\n    approval_sha: str | None\n    at: str\n    adapter: str | None\n    adapter_config: dict[str, Any]\n    adapter_version: str | None\n    model: str | None\n    model_version: str | None\n    reports: list[str]\n    forge_checks: dict[str, Any]\n    findings: list[dict[str, Any]] | None\n    tests_named: list[str]\n    commits: list[str]\n    stub_ratio: float | None\n    tokens: dict[str, int]\n    cost_usd: float | None\n    wall_clock_s: float\n    status: str\n    stop: Stop | None\n    product_version: str\n    product_pin: str | None\n\n\nCounselRecord = TypedDict(\"CounselRecord\", {\n    \"record_version\": int,\n    \"item\": str,\n    \"sha\": str,\n    \"record_stage\": str,\n    \"record\": str,\n    \"at\": str,\n    \"adapter\": str | None,\n    \"adapter_config\": dict[str, Any],\n    \"adapter_version\": str | None,\n    \"model\": str | None,\n    \"model_version\": str | None,\n    \"reports\": list[str],\n    \"tokens\": dict[str, int],\n    \"cost_usd\": float | None,\n    \"wall_clock_s\": float,\n    \"status\": str,\n    \"class\": str | None,\n    \"verdict\": str | None,\n    \"citations\": list[dict[str, Any]],\n    \"proposal\": dict[str, Any],\n    \"forge\": dict[str, Any],\n    \"question\": str | None,\n    \"product_version\": str,\n    \"product_pin\": str | None,\n})\n\n\nclass StageTime(TypedDict):\n    \"\"\"One stage's invocations summed (the statement's `time` block).\"\"\"\n    attempts: int\n    invocation_s: float\n    partial: bool\n\n\nclass ItemTime(TypedDict):\n    \"\"\"Every invocation's wall_clock_s, per stage and for the item, beside\n    the item's lead time -- summed from the records by `attavo attest`, so\n    a view renders it and never derives it.\"\"\"\n    build: StageTime\n    verify: StageTime\n    counsel: StageTime\n    invocation_s: float\n    lead_s: float | None\n    waiting_s: float | None\n    partial: bool\n    not_read: list[str]\n\n\nclass ItemCost(TypedDict):\n    \"\"\"Every record's cost_usd summed: the item's total across stages and\n    executors, with a subtotal per stage and per adapter. A record with no\n    cost_usd is named in not_read and makes every sum it belongs to\n    partial -- absent is never zero.\"\"\"\n    usd: float\n    by_stage_usd: dict[str, float]\n    by_adapter_usd: dict[str, float]\n    partial: bool\n    not_read: list[str]\n\n\nclass AttestRecord(TypedDict):\n    \"\"\"The statement `attavo attest` prints (schema/attestation.schema.json).\"\"\"\n    sha: str\n    merge_sha: str\n    item: str\n    spec: str | None\n    spec_sha: str | None\n    approval: str | None\n    approval_sha: str | None\n    build: str | None\n    build_sha: str | None\n    verify: str | None\n    verify_sha: str | None\n    at: str\n    interventions: list[dict[str, str]]\n    acts: list[dict[str, str]]\n    tokens_by_stage: dict[str, dict[str, Any] | None]\n    cost_by_stage_usd: dict[str, float | None]\n    wall_clock_by_stage_s: dict[str, float | None]\n    time: ItemTime\n    cost: ItemCost\n    product_version: str\n    product_pin: str | None\n\n\n# What counsel reads a stop from: a build or verify record, or a refused\n# spec-gate record (issue #133).\nStageRecord = SpecRecord | BuildRecord | VerifyRecord\n\n\nclass DriveReport(TypedDict):\n    \"\"\"What `attavo drive N --report` prints (schema/drive-report.schema.json):\n    the item's level, read from its records, its markers, and the forge.\"\"\"\n    item: str\n    state: str\n    kind: str\n    says: str\n    stage: str | None\n    attempt: int | None\n    record: str | None\n    stop_class: str | None\n    counsel: str | None\n    filed: str | None\n    head: str | None\n    checks: list[dict[str, str]] | None\n    since: str | None\n    last_event_age_s: int | None\n    attempts: list[dict[str, Any]] | None\n    signatures_match: bool | None\n    rulings_available: list[str] | None\n","numLines":226,"startLine":1,"totalLines":226}}}

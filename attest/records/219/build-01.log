{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01L68bhUhDQQBTuXroJuoQSv","type":"tool_result","content":"218\t    if ok:\n219\t        if ready:\n220\t            r[\"state\"], r[\"kind\"], r[\"says\"] = \"ready-to-merge\", \"yours\", \"Ready to merge\"\n221\t        else:\n222\t            r[\"state\"], r[\"kind\"], r[\"stage\"] = \"next-review\", \"acts\", \"verify\"\n223\t            r[\"says\"] = f\"Review is next; the checks are green on {head7}\"\n224\t        return r\n225\t    unconcluded = [c for c in conclusions if c[\"conclusion\"] in FORGE_UNCONCLUDED_STATUSES]\n226\t    if unconcluded or not conclusions:\n227\t        named = \", \".join(f\"{c['name']} {c['conclusion']}\" for c in unconcluded) or \"no checks reported\"\n228\t        r[\"state\"], r[\"kind\"], r[\"stage\"] = \"waiting-on-checks\", \"waits\", None if ready else \"verify\"\n229\t        r[\"says\"] = f\"Waiting on the checks: {named} on {head7}\"\n230\t        return r\n231\t    named = (\", \".join(f\"{c['name']} {c['conclusion']}\" for c in conclusions\n232\t                       if c[\"conclusion\"] not in FORGE_OK_CONCLUSIONS)\n233\t             or \"the checks command did not succeed\")\n234\t    r[\"state\"], r[\"kind\"], r[\"stage\"] = \"blocked-on-checks\", \"waits\", None if ready else \"verify\"\n235\t    after = \"the item is ready to merge\" if ready else \"review starts\"\n236\t    r[\"says\"] = f\"Blocked: {named} on {head7}; {after} once the checks are green\"\n237\t    return r\n238\t\n239\t\n240\tdef drive_report(root: Path, m: dict[str, Any], item_id: str) -> DriveReport:\n241\t    \"\"\"The item's level, from the same reads `attavo drive` decides on --\n242\t    drive_state over its records, the markers recovery reads, one read of\n243\t    the forge -- and never an act: no record written, nothing started, no\n244\t    poll. A state for every item the records directory carries.\"\"\"\n245\t    records_dir = root / m[\"paths\"][\"records\"] / item_id\n246\t    r: DriveReport = {\"item\": item_id, \"state\": \"refused\", \"kind\": \"yours\", \"says\": \"\", \"stage\": None,\n247\t                      \"attempt\": None, \"record\": None, \"stop_class\": None, \"counsel\": None,\n248\t                      \"filed\": None, \"head\": _head(root), \"checks\": None, \"since\": None,\n249\t                      \"last_event_age_s\": None}\n250\t\n251\t    merge, _ = merge_introducing_records(root, m[\"paths\"][\"records\"], item_id, STAGES)\n252\t    if merge:\n253\t        r[\"state\"], r[\"kind\"], r[\"says\"] = \"merged\", \"done\", f\"Merged in {merge[:7]}\"\n254\t        return r\n255\t\n256\t    try:\n257\t        step, why, _ = drive_state(root, m, item_id)\n258\t    except ShallowCheckoutError as exc:\n259\t        r[\"says\"] = f\"Cannot read this item: {exc}\"\n260\t        return r\n261\t    if step == \"no-approval\":\n262\t        r[\"state\"], r[\"kind\"] = \"waiting-on-approval\", \"yours\"\n263\t        r[\"says\"] = (\"Waiting on you: approve the spec\" if why == \"absent\" else\n264\t                     \"Waiting on you: the approval expired because the spec changed after it; \"\n265\t                     \"approve the spec again\")\n266\t        return r\n267\t"}]},"parent_tool_use_id":null,"session_id":"0dd7ed4f-100c-4188-9a34-077aa0b6aa25","uuid":"f4343970-f799-4544-862b-3dbf9b7af21c","timestamp":"2026-09-26T02:29:04.151Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-219/attavo/report.py","content":"    if ok:\n        if ready:\n            r[\"state\"], r[\"kind\"], r[\"says\"] = \"ready-to-merge\", \"yours\", \"Ready to merge\"\n        else:\n            r[\"state\"], r[\"kind\"], r[\"stage\"] = \"next-review\", \"acts\", \"verify\"\n            r[\"says\"] = f\"Review is next; the checks are green on {head7}\"\n        return r\n    unconcluded = [c for c in conclusions if c[\"conclusion\"] in FORGE_UNCONCLUDED_STATUSES]\n    if unconcluded or not conclusions:\n        named = \", \".join(f\"{c['name']} {c['conclusion']}\" for c in unconcluded) or \"no checks reported\"\n        r[\"state\"], r[\"kind\"], r[\"stage\"] = \"waiting-on-checks\", \"waits\", None if ready else \"verify\"\n        r[\"says\"] = f\"Waiting on the checks: {named} on {head7}\"\n        return r\n    named = (\", \".join(f\"{c['name']} {c['conclusion']}\" for c in conclusions\n                       if c[\"conclusion\"] not in FORGE_OK_CONCLUSIONS)\n             or \"the checks command did not succeed\")\n    r[\"state\"], r[\"kind\"], r[\"stage\"] = \"blocked-on-checks\", \"waits\", None if ready else \"verify\"\n    after = \"the item is ready to merge\" if ready else \"review starts\"\n    r[\"says\"] = f\"Blocked: {named} on {head7}; {after} once the checks are green\"\n    return r\n\n\ndef drive_report(root: Path, m: dict[str, Any], item_id: str) -> DriveReport:\n    \"\"\"The item's level, from the same reads `attavo drive` decides on --\n    drive_state over its records, the markers recovery reads, one read of\n    the forge -- and never an act: no record written, nothing started, no\n    poll. A state for every item the records directory carries.\"\"\"\n    records_dir = root / m[\"paths\"][\"records\"] / item_id\n    r: DriveReport = {\"item\": item_id, \"state\": \"refused\", \"kind\": \"yours\", \"says\": \"\", \"stage\": None,\n                      \"attempt\": None, \"record\": None, \"stop_class\": None, \"counsel\": None,\n                      \"filed\": None, \"head\": _head(root), \"checks\": None, \"since\": None,\n                      \"last_event_age_s\": None}\n\n    merge, _ = merge_introducing_records(root, m[\"paths\"][\"records\"], item_id, STAGES)\n    if merge:\n        r[\"state\"], r[\"kind\"], r[\"says\"] = \"merged\", \"done\", f\"Merged in {merge[:7]}\"\n        return r\n\n    try:\n        step, why, _ = drive_state(root, m, item_id)\n    except ShallowCheckoutError as exc:\n        r[\"says\"] = f\"Cannot read this item: {exc}\"\n        return r\n    if step == \"no-approval\":\n        r[\"state\"], r[\"kind\"] = \"waiting-on-approval\", \"yours\"\n        r[\"says\"] = (\"Waiting on you: approve the spec\" if why == \"absent\" else\n                     \"Waiting on you: the approval expired because the spec changed after it; \"\n                     \"approve the spec again\")\n        return r\n","numLines":50,"startLine":218,"totalLines":298}}}

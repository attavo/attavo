{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Jn13sykPi9hhHP79fNCB1X","type":"tool_result","content":"1\t\"\"\"spec-NN.json, approval-NN.json, build-NN.json, and verify-NN.json\n2\tvalidate against schema/records/*.schema.json. One test over all fixture\n3\trecords; extend it, don't duplicate it, as new record shapes land (issue\n4\t#24's adapter_config, issue #40's verify, among them).\n5\t\n6\tRun: python3 -m pytest tests -q\n7\t\"\"\"\n8\timport importlib\n9\timport importlib.util\n10\timport json\n11\timport os\n12\timport shutil\n13\timport subprocess\n14\timport sys\n15\tfrom pathlib import Path\n16\tfrom typing import Any, cast\n17\t\n18\timport jsonschema\n19\timport pytest\n20\t\n21\tfrom helpers import commit_all, make_tenant\n22\t\n23\tROOT = Path(__file__).resolve().parent.parent\n24\tATTAVO = ROOT / \"bin\" / \"attavo\"\n25\tSCHEMAS_DIR = ROOT / \"schema\" / \"records\"\n26\t\n27\t\n28\tdef run_attavo(root: Path, *args: str) -> subprocess.CompletedProcess[str]:\n29\t    return subprocess.run([sys.executable, str(ATTAVO), *args], cwd=str(root),\n30\t                          capture_output=True, text=True, check=False)\n31\t\n32\t\n33\tdef load_schema(stage: str) -> dict[str, Any]:\n34\t    return cast(dict[str, Any], json.loads((SCHEMAS_DIR / f\"{stage}.schema.json\").read_text()))\n35\t\n36\t\n37\tdef attavo_module() -> Any:\n38\t    \"\"\"attavo.records imported in-process, for the write_record/load_records\n39\t    unit tests below that a CLI invocation cannot provoke (there is no\n40\t    command-line path to a record carrying a key its schema forbids).\"\"\"\n41\t    return importlib.import_module(\"attavo.records\")\n42\t\n43\t\n44\tdef test_records_match_their_shapes(tmp_path: Path) -> None:\n45\t    root = make_tenant(tmp_path, \"build_valid\")\n46\t    toml = root / \"attavo.toml\"\n47\t    toml.write_text(toml.read_text()\n48\t                    + '\\n[executor.fixture]\\ny = 2\\n'\n49\t                    + '\\n[checks]\\ncommand = \"true\"\\n'\n50\t                    + \"\"\"\\n[forge]\\nchecks_command = \"printf 'ci success\\\\n'\"\\n\"\"\")\n51\t    commit_all(root, \"configure the fixture adapter, the tenant's checks, and the forge read\")\n52\t\n53\t    assert run_attavo(root, \"spec-gate\", \"1\").returncode == 0\n54\t    assert run_attavo(root, \"approve\", \"1\", \"--by\", \"alice\").returncode == 0\n55\t    assert run_attavo(root, \"build\", \"1\").returncode == 0\n56\t\n57\t    build_rec = json.loads((root / \"records\" / \"1\" / \"build-01.json\").read_text())\n58\t    assert build_rec[\"adapter_config\"] == {\"y\": 2}\n59\t    assert build_rec[\"checks\"] == {\"command\": \"true\", \"exit\": 0}\n60\t\n61\t    verify = run_attavo(root, \"verify\", \"1\")\n62\t    assert verify.returncode == 0\n63\t    verify_rec = json.loads((root / \"records\" / \"1\" / \"verify-01.json\").read_text())\n64\t    assert verify_rec[\"status\"] == \"pass\"\n65\t    assert verify_rec[\"findings\"]\n66\t\n67\t    # the build didn't touch spec.md, so the approval is still valid: this\n68\t    # spec-gate run writes the new spec-02.json with status \"approved\".\n69\t    approved = run_attavo(root, \"spec-gate\", \"1\")\n70\t    assert approved.returncode == 0\n71\t    assert json.loads((root / \"records\" / \"1\" / \"spec-02.json\").read_text())[\"status\"] == \"approved\"\n72\t\n73\t    # issue #28: an amendment above the line expires the approval, but a\n74\t    # build already ran after it -- status \"built\". Issue #36: built now\n75\t    # judges each criterion on both on_tree and on_stub, like a pass\n76\t    # record; this fixture's stub also satisfies checks_built.sh, so\n77\t    # on_stub is 0, not null.\n78\t    spec_md = root / \"specs\" / \"1\" / \"spec.md\"\n79\t    spec_md.write_text(spec_md.read_text().replace(\"does not emit\", \"used to not emit\"))\n80\t    commit_all(root, \"amend problem prose\")\n81\t    built = run_attavo(root, \"spec-gate\", \"1\")\n82\t    assert built.returncode == 0\n83\t    spec_03 = json.loads((root / \"records\" / \"1\" / \"spec-03.json\").read_text())\n84\t    assert spec_03[\"status\"] == \"built\"\n85\t    assert spec_03[\"criteria\"][0][\"on_stub\"] == 0\n86\t\n87\t    # Issue #69: attest never writes -- it prints a statement instead. An\n88\t    # explicit item id bypasses its merge-commit derivation -- the chain\n89\t    # this fixture already built (build-01 against approval-01, verify-01\n90\t    # against build-01) is exactly what attest checks, so no merge commit\n91\t    # is needed to prove the statement's shape.\n92\t    attest = run_attavo(root, \"attest\", \"1\")\n93\t    assert attest.returncode == 0, attest.stdout + attest.stderr\n94\t    statement = json.loads(attest.stdout)\n95\t    jsonschema.validate(statement,\n96\t                        json.loads((ROOT / \"schema\" / \"attestation.schema.json\").read_text()))\n97\t\n98\t    schemas = {\"spec\": load_schema(\"spec\"), \"approval\": load_schema(\"approval\"),\n99\t              \"build\": load_schema(\"build\"), \"verify\": load_schema(\"verify\")}\n100\t\n101\t    records = sorted((root / \"records\" / \"1\").glob(\"*.json\"))\n102\t    assert ({p.stem.split(\"-\")[0] for p in records}\n103\t           == {\"spec\", \"approval\", \"build\", \"verify\"})\n104\t    for path in records:\n105\t        stage = path.stem.split(\"-\")[0]\n106\t        jsonschema.validate(json.loads(path.read_text()), schemas[stage])\n107\t\n108\t    # issue #49: product_version and product_pin are not optional extras --\n109\t    # every record shape requires them, the same as any other field.\n110\t    for stage, schema in schemas.items():\n111\t        assert \"product_version\" in schema[\"required\"], stage\n112\t        assert \"product_pin\" in schema[\"required\"], stage\n113\t\n114\t    # issue #60, acceptance 1: every record write_record writes carries\n115\t    # record_version -- equal to that stage schema's own $id version, the\n116\t    # single place the version lives -- and item, matching the directory\n117\t    # it was written under.\n118\t    for path in records:\n119\t        stage = path.stem.split(\"-\")[0]\n120\t        rec = json.loads(path.read_text())\n121\t        assert rec[\"record_version\"] == int(schemas[stage][\"$id\"].rsplit(\"/\", 1)[-1]), stage\n122\t        assert rec[\"item\"] == \"1\", stage\n123\t\n124\t\n125\tdef test_records_carry_product_version_distinct_from_pin(tmp_path: Path) -> None:\n126\t    \"\"\"Issue #49: a record names both what ran (product_version, derived\n127\t    from the running checkout via git describe) and what the tenant\n128\t    declared (product_pin, copied verbatim from the manifest). The\n129\t    build_valid fixture pins v0.2.1; this checkout is not on that tag, so\n130\t    every record type written against it must carry both fields and they\n131\t    must differ -- the mismatch is a recorded fact, not an error nothing\n132\t    here refuses on.\"\"\"\n133\t    root = make_tenant(tmp_path, \"build_valid\")\n134\t    toml = root / \"attavo.toml\"\n135\t    toml.write_text(toml.read_text()\n136\t                    + '\\n[executor.fixture]\\ny = 2\\n'\n137\t                    + '\\n[checks]\\ncommand = \"true\"\\n'\n138\t                    + \"\"\"\\n[forge]\\nchecks_command = \"printf 'ci success\\\\n'\"\\n\"\"\")\n139\t    commit_all(root, \"configure the fixture adapter, the tenant's checks, and the forge read\")\n140\t\n141\t    assert run_attavo(root, \"spec-gate\", \"1\").returncode == 0\n142\t    assert run_attavo(root, \"approve\", \"1\", \"--by\", \"alice\").returncode == 0\n143\t    assert run_attavo(root, \"build\", \"1\").returncode == 0\n144\t    assert run_attavo(root, \"verify\", \"1\").returncode == 0\n145\t\n146\t    running_version = subprocess.run(\n147\t        [\"git\", \"describe\", \"--tags\", \"--always\", \"--dirty\"],\n148\t        cwd=str(ROOT), capture_output=True, text=True, check=True).stdout.strip()\n149\t\n150\t    records = sorted((root / \"records\" / \"1\").glob(\"*.json\"))\n151\t    assert {p.stem.split(\"-\")[0] for p in records} == {\"spec\", \"approval\", \"build\", \"verify\"}\n152\t    for path in records:\n153\t        rec = json.loads(path.read_text())\n154\t        assert rec[\"product_pin\"] == \"v0.2.1\"\n155\t        assert rec[\"product_version\"] == running_version\n156\t        assert rec[\"product_version\"] != rec[\"product_pin\"]\n157\t\n158\t\n159\tdef test_product_version_unknown_when_product_root_is_not_a_git_repo(tmp_path: Path) -> None:\n160\t    \"\"\"Issue #49 follow-up: GitHub Actions extracts an action into\n161\t    _actions/ from a tarball, not a git checkout -- PRODUCT_ROOT there has\n162\t    no .git, so `git describe` fails and, unguarded, raises inside\n163\t    write_record: the one function that must never fail, since it runs\n164\t    after the work it records already happened. A copy of bin/attavo\n165\t    placed under a fresh, non-git tmp_path reproduces PRODUCT_ROOT with no\n166\t    .git without needing an actual GitHub Actions run. Red today: the\n167\t    KeyError this reproduces is a RuntimeError from git(), uncaught, and\n168\t    no record is written at all. schema/ is copied alongside bin/, same as\n169\t    the real action extraction: write_record reads schema/records/<stage>.schema.json\n170\t    from PRODUCT_ROOT (issue #60), which the action ships beside bin/.\"\"\"\n171\t    product_bin = tmp_path / \"product\" / \"bin\"\n172\t    product_bin.mkdir(parents=True)\n173\t    shutil.copy(ATTAVO, product_bin / \"attavo\")\n174\t    shutil.copytree(ROOT / \"attavo\", tmp_path / \"product\" / \"attavo\")\n175\t    shutil.copytree(ROOT / \"schema\", tmp_path / \"product\" / \"schema\")\n176\t\n177\t    root = make_tenant(tmp_path, \"build_valid\", name=\"tenant\")\n178\t\n179\t    env = dict(os.environ)\n180\t    env.pop(\"ATTAVO_PRODUCT_VERSION\", None)\n181\t    run = subprocess.run([sys.executable, str(product_bin / \"attavo\"), \"spec-gate\", \"1\"],\n182\t                        cwd=str(root), env=env, capture_output=True, text=True, check=False)\n183\t    assert run.returncode == 0, run.stderr\n184\t\n185\t    rec = json.loads((root / \"records\" / \"1\" / \"spec-01.json\").read_text())\n186\t    assert rec[\"product_version\"] == \"unknown\"\n187\t\n188\t\n189\tdef test_manifest_schema_accepts_open_executor_config() -> None:\n190\t    \"\"\"Issue #24, acceptance 5 (manifest half): [executor.<adapter-name>]\n191\t    is an open table -- the schema permits any keys under it, none\n192\t    required, alongside the existing build/verify string keys.\"\"\"\n193\t    schema = json.loads((ROOT / \"schema\" / \"manifest.schema.json\").read_text())\n194\t    manifest = {\n195\t        \"schema_version\": 1,\n196\t        \"attavo\": {\"version\": \"v0.3.1\"},\n197\t        \"executor\": {\n198\t            \"build\": \"claude-code\",\n199\t            \"claude-code\": {\"auth\": \"subscription\", \"some_future_key\": True},\n200\t        },\n201\t        \"spec\": {\"boundary\": {\"paths\": [\"src/**\"]}},\n202\t        \"gates\": {},\n203\t        \"paths\": {\"specs\": \"specs\", \"records\": \"records\",\n204\t                 \"rulings\": \"rulings.md\", \"rejections\": \"rejections\"},\n205\t        \"operators\": {\"approvers\": [\"alice\"]},\n206\t    }\n207\t    jsonschema.validate(manifest, schema)\n208\t\n209\t\n210\tdef base_manifest() -> dict[str, Any]:\n211\t    return {\n212\t        \"schema_version\": 1,\n213\t        \"attavo\": {\"version\": \"v0.3.3\"},\n214\t        \"executor\": {\"build\": \"fixture\"},\n215\t        \"spec\": {\"boundary\": {\"paths\": [\"src/**\"]}},\n216\t        \"gates\": {},\n217\t        \"paths\": {\"specs\": \"specs\", \"records\": \"records\",\n218\t                 \"rulings\": \"rulings.md\", \"rejections\": \"rejections\"},\n219\t        \"operators\": {\"approvers\": [\"alice\"]},\n220\t    }\n221\t\n222\t\n223\tdef test_manifest_schema_describes_checks() -> None:\n224\t    \"\"\"Issue #30, acceptance 4 (manifest half): [checks] is optional, with\n225\t    command required inside it -- a manifest with no [checks] table at\n226\t    all is still valid (unlike [tests], which build itself requires).\"\"\"\n227\t    schema = json.loads((ROOT / \"schema\" / \"manifest.schema.json\").read_text())\n228\t\n229\t    without_checks = base_manifest()\n230\t    jsonschema.validate(without_checks, schema)\n231\t\n232\t    with_checks = base_manifest()\n233\t    with_checks[\"checks\"] = {\"command\": \"python3 bin/factory-lane check --base origin/main\"}\n234\t    jsonschema.validate(with_checks, schema)\n235\t\n236\t\n237\t# --- issue #60: records declare their own record_version and item ---\n238\t\n239\tdef test_write_record_refuses_a_key_its_schema_does_not_declare(tmp_path: Path) -> None:\n240\t    \"\"\"Acceptance 2: write_record enforces the declared key set at write\n241\t    time -- a record carrying a key its stage's schema does not list under\n242\t    \"properties\" is refused, and nothing is written. Enforced with the\n243\t    standard library (set difference against the schema's own properties),\n244\t    not a jsonschema import into bin/attavo -- it is a single script a\n245\t    tenant pins, and a runtime dependency changes installation.\"\"\"\n246\t    attavo = attavo_module()\n247\t    schema = load_schema(\"spec\")\n248\t    record: dict[str, Any] = {k: None for k in schema[\"properties\"]\n249\t             if k not in (\"record_version\", \"item\", \"product_version\", \"product_pin\")}\n250\t    record[\"unexpected_key\"] = \"not in the schema\"\n251\t\n252\t    records_dir = tmp_path / \"records\" / \"1\"\n253\t    with pytest.raises(ValueError, match=\"unexpected_key\"):\n254\t        attavo.write_record(records_dir, \"spec\", record, {\"attavo\": {}}, \"1\")\n255\t    assert list(records_dir.glob(\"spec-*.json\")) == []\n256\t\n257\t\n258\tdef test_write_record_stamps_record_version_from_the_schemas_id(tmp_path: Path) -> None:\n259\t    \"\"\"Acceptance/correction point 2: record_version is read from the\n260\t    stage schema's own $id at call time rather than carried separately in\n261\t    bin/attavo, so it cannot drift from what the schema declares. Point\n262\t    write_record at a copy of the real build schema whose $id is bumped\n263\t    past what ships today, and confirm the written record follows it.\"\"\"\n264\t    attavo = attavo_module()\n265\t    schema_dir = tmp_path / \"schema\"\n266\t    (schema_dir / \"records\").mkdir(parents=True)\n267\t    build_schema = load_schema(\"build\")\n268\t    bumped = json.loads(json.dumps(build_schema))\n269\t    stem, _, tail = bumped[\"$id\"].rpartition(\"/\")\n270\t    bumped[\"$id\"] = f\"{stem}/{int(tail) + 1}\"\n271\t    (schema_dir / \"records\" / \"build.schema.json\").write_text(json.dumps(bumped))\n272\t\n273\t    real_schema_dir = attavo.SCHEMA_RECORDS_DIR\n274\t    attavo.SCHEMA_RECORDS_DIR = schema_dir / \"records\"\n275\t    try:\n276\t        record: dict[str, Any] = {k: None for k in build_schema[\"properties\"]\n277\t                 if k not in (\"record_version\", \"item\", \"product_version\", \"product_pin\")}\n278\t        path = attavo.write_record(tmp_path / \"records\" / \"1\", \"build\", record,\n279\t                                   {\"attavo\": {}}, \"1\")\n280\t    finally:\n281\t        attavo.SCHEMA_RECORDS_DIR = real_schema_dir\n282\t\n283\t    assert json.loads(path.read_text())[\"record_version\"] == int(tail) + 1\n284\t\n285\t\n286\tdef _blank_record(stage: str) -> dict[str, Any]:\n287\t    schema = load_schema(stage)\n288\t    return {k: None for k in schema[\"properties\"]\n289\t            if k not in (\"record_version\", \"item\", \"product_version\", \"product_pin\")}\n290\t\n291\t\n292\tdef test_write_record_refuses_a_failed_record_with_no_trail(tmp_path: Path) -> None:\n293\t    \"\"\"Issue #53, rejection test 1. A failed record whose log is empty and\n294\t    whose refusal and halted are both null explains nothing -- write_record\n295\t    refuses it by name and writes neither the record nor the log. Tenant\n296\t    zero's build-11.json, as recorded, has exactly this shape.\"\"\"\n297\t    attavo = attavo_module()\n298\t    record = _blank_record(\"build\")\n299\t    record.update({\"status\": \"failed\", \"refusal\": None, \"halted\": None})\n300\t\n301\t    records_dir = tmp_path / \"records\" / \"576\"\n302\t    with pytest.raises(ValueError, match=\"failed\"):\n303\t        attavo.write_record(records_dir, \"build\", record, {\"attavo\": {}}, \"576\", log=\"\")\n304\t    assert list(records_dir.glob(\"build-*.json\")) == []\n305\t    assert list(records_dir.glob(\"build-*.log\")) == []\n306\t\n307\t\n308\tdef test_write_record_accepts_a_returned_record_with_no_log(tmp_path: Path) -> None:\n309\t    \"\"\"Issue #53, rejection test 2. A returned verify record owes no log at\n310\t    all, because no adapter ran -- accepted, and write_record writes no log\n311\t    file for it. #576's verify-02 shape.\"\"\"\n312\t    attavo = attavo_module()\n313\t    record = _blank_record(\"verify\")\n314\t    record[\"status\"] = \"returned\"\n315\t\n316\t    records_dir = tmp_path / \"records\" / \"1\"\n317\t    path = attavo.write_record(records_dir, \"verify\", record, {\"attavo\": {}}, \"1\")\n318\t    assert path.exists()\n319\t    assert not path.with_suffix(\".log\").exists()\n320\t\n321\t\n322\tdef test_write_record_accepts_a_failed_record_with_a_populated_refusal(tmp_path: Path) -> None:\n323\t    \"\"\"Issue #53, lane table row 5. A failed record with a populated\n324\t    refusal (or halted) and an empty log is accepted -- the refusal or\n325\t    halted text is itself the trail the rule requires.\"\"\"\n326\t    attavo = attavo_module()\n327\t    record = _blank_record(\"build\")\n328\t    record.update({\"status\": \"failed\", \"refusal\": \"outside the claims boundary\", \"halted\": None})\n329\t\n330\t    records_dir = tmp_path / \"records\" / \"1\"\n331\t    path = attavo.write_record(records_dir, \"build\", record, {\"attavo\": {}}, \"1\", log=\"\")\n332\t    assert path.exists()\n333\t    assert path.with_suffix(\".log\").exists()\n334\t    assert path.with_suffix(\".log\").read_text() == \"\"\n335\t\n336\t\n337\tdef _load_check_record_schema_version() -> Any:\n338\t    \"\"\"scripts/check_record_schema_version.py -- schema_version_drift's\n339\t    one home. CI's schema-version job (.github/workflows/ci.yml, on\n340\t    pull_request and merge_group) imports the same module to run it\n341\t    against this repository's real schema files at the merge base and at\n342\t    HEAD; a merge-base read behaves differently inside pytest than in the\n343\t    workflow, so that comparison lives outside this suite. This test is\n344\t    the helper's own rejection test, run here against a mutated copy of a\n345\t    real schema rather than the merge base.\"\"\"\n346\t    path = ROOT / \"scripts\" / \"check_record_schema_version.py\"\n347\t    spec = importlib.util.spec_from_file_location(\"check_record_schema_version\", path)\n348\t    assert spec is not None and spec.loader is not None\n349\t    module = importlib.util.module_from_spec(spec)\n350\t    spec.loader.exec_module(module)\n351\t    return module\n352\t\n353\t\n354\tschema_version_drift = _load_check_record_schema_version().schema_version_drift\n355\t\n356\t\n357\tdef test_schema_shape_change_without_a_version_bump_is_refused() -> None:\n358\t    \"\"\"Acceptance 3, run against a mutated schema fixture: drop-in a new\n359\t    required field on the real, committed build schema without touching\n360\t    its $id -- refused. The identical mutation with $id bumped alongside\n361\t    it is not.\"\"\"\n362\t    base = load_schema(\"build\")\n363\t    mutated = json.loads(json.dumps(base))\n364\t    mutated[\"properties\"][\"a_new_field\"] = {\"type\": \"string\", \"minLength\": 1}\n365\t    mutated[\"required\"] = mutated[\"required\"] + [\"a_new_field\"]\n366\t    assert schema_version_drift(base, mutated) is not None\n367\t\n368\t    bumped = json.loads(json.dumps(mutated))\n369\t    stem, _, tail = bumped[\"$id\"].rpartition(\"/\")\n370\t    bumped[\"$id\"] = f\"{stem}/{int(tail) + 1}\"\n371\t    assert schema_version_drift(base, bumped) is None\n372\t\n373\t    # a change carrying no shape change at all -- e.g. a description edit\n374\t    # -- never needs a version bump.\n375\t    reworded = json.loads(json.dumps(base))\n376\t    reworded[\"title\"] = reworded[\"title\"] + \" (reworded)\"\n377\t    assert schema_version_drift(base, reworded) is None\n378\t\n379\t\n380\tdef test_load_records_defaults_a_version_1_record_and_fills_its_item(tmp_path: Path) -> None:\n381\t    \"\"\"Acceptance 4: a record written before record_version and item\n382\t    shipped -- tenant zero's real shape at 3648830, common keys across 49\n383\t    records: ['at', 'sha'] and nothing else -- loads with record_version 1\n384\t    and item filled from the directory it sits under. The disk copy is\n385\t    never touched: version 1 is never migrated (issue #60, operator\n386\t    ruling 2026-09-09: record_version is a label, never a trigger for\n387\t    reading or upgrading an older record).\"\"\"\n388\t    attavo = attavo_module()\n389\t    records_dir = tmp_path / \"records\" / \"1\"\n390\t    records_dir.mkdir(parents=True)\n391\t    tenant_zero_shape = {\"sha\": \"a\" * 40, \"at\": \"2026-01-01T00:00:00Z\"}\n392\t    (records_dir / \"build-01.json\").write_text(json.dumps(tenant_zero_shape))\n393\t\n394\t    items = attavo.load_records(tmp_path / \"records\")\n395\t    rec = items[\"1\"][\"build\"]\n396\t    assert rec[\"record_version\"] == 1\n397\t    assert rec[\"item\"] == \"1\"\n398\t\n399\t    on_disk = json.loads((records_dir / \"build-01.json\").read_text())\n400\t    assert on_disk == tenant_zero_shape\n401\t\n402\t\n403\tdef test_load_records_refuses_an_item_that_disagrees_with_its_directory(tmp_path: Path) -> None:\n404\t    \"\"\"Acceptance 5: a record whose item field names a different item\n405\t    than the directory it was found in -- a misfiled or copied record --\n406\t    is refused rather than trusted.\"\"\"\n407\t    attavo = attavo_module()\n408\t    records_dir = tmp_path / \"records\" / \"1\"\n409\t    records_dir.mkdir(parents=True)\n410\t    (records_dir / \"build-01.json\").write_text(json.dumps(\n411\t        {\"sha\": \"a\" * 40, \"at\": \"2026-01-01T00:00:00Z\", \"item\": \"2\"}))\n412\t\n413\t    with pytest.raises(attavo.RecordItemMismatch):\n414\t        attavo.load_records(tmp_path / \"records\")\n415\t\n416\t\n417\tdef test_only_load_record_parses_record_file_content() -> None:\n418\t    \"\"\"Acceptance 6: _load_record is the one place in this repository\n419\t    that turns a <stage>-NN.json record's bytes into a dict; parse_attempts\n420\t    and load_records both read through it rather than calling json.loads\n421\t    themselves. `git grep -n \"json.loads(\" bin/attavo` still finds six\n422\t    other sites -- a schema file, an adapter's conformance.json, an\n423\t    adapter's own stdout report, proof four's own read of one log line at\n424\t    a time to tell an adapter's JSON event stream from a tool's plain-text\n425\t    error (issue #94), proof five's own read of the forge's attestation\n426\t    statement (issue #158), and verify's own read of the forge checks a\n427\t    drive pass already wrote (issue #217, ATTAVO_FORGE_CHECKS) -- none of\n428\t    them a record.\"\"\"\n429\t    text = \"\\n\".join(p.read_text() for p in sorted((ROOT / \"attavo\").rglob(\"*.py\")))\n430\t    assert text.count(\"json.loads(\") == 7, (\n431\t        \"a new json.loads( site was added; review it against issue #60 acceptance 6 \"\n432\t        \"and update this count\")\n433\t    assert \"data = json.loads(path.read_text())\" in text\n434\t\n435\t    for fn in (\"parse_attempts\", \"load_records\"):\n436\t        # The implementation is the last def of the name: the typed loaders'\n437\t        # @overload stubs (issue #189) precede it.\n438\t        start = text.rindex(f\"\\ndef {fn}(\")\n439\t        end = text.index(\"\\ndef \", start + 1)\n440\t        body = text[start:end]\n441\t        assert \"json.loads(\" not in body, f\"{fn} should read through _load_record, not parse directly\"\n442\t        assert \"_load_record(\" in body\n443\t"}]},"parent_tool_use_id":null,"session_id":"0dd7ed4f-100c-4188-9a34-077aa0b6aa25","uuid":"ec8942be-7e24-4e1b-b7d5-57fb0403ad3a","timestamp":"2026-09-26T02:17:32.768Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-219/tests/test_record_schemas.py","content":"\"\"\"spec-NN.json, approval-NN.json, build-NN.json, and verify-NN.json\nvalidate against schema/records/*.schema.json. One test over all fixture\nrecords; extend it, don't duplicate it, as new record shapes land (issue\n#24's adapter_config, issue #40's verify, among them).\n\nRun: python3 -m pytest tests -q\n\"\"\"\nimport importlib\nimport importlib.util\nimport json\nimport os\nimport shutil\nimport subprocess\nimport sys\nfrom pathlib import Path\nfrom typing import Any, cast\n\nimport jsonschema\nimport pytest\n\nfrom helpers import commit_all, make_tenant\n\nROOT = Path(__file__).resolve().parent.parent\nATTAVO = ROOT / \"bin\" / \"attavo\"\nSCHEMAS_DIR = ROOT / \"schema\" / \"records\"\n\n\ndef run_attavo(root: Path, *args: str) -> subprocess.CompletedProcess[str]:\n    return subprocess.run([sys.executable, str(ATTAVO), *args], cwd=str(root),\n                          capture_output=True, text=True, check=False)\n\n\ndef load_schema(stage: str) -> dict[str, Any]:\n    return cast(dict[str, Any], json.loads((SCHEMAS_DIR / f\"{stage}.schema.json\").read_text()))\n\n\ndef attavo_module() -> Any:\n    \"\"\"attavo.records imported in-process, for the write_record/load_records\n    unit tests below that a CLI invocation cannot provoke (there is no\n    command-line path to a record carrying a key its schema forbids).\"\"\"\n    return importlib.import_module(\"attavo.records\")\n\n\ndef test_records_match_their_shapes(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"build_valid\")\n    toml = root / \"attavo.toml\"\n    toml.write_text(toml.read_text()\n                    + '\\n[executor.fixture]\\ny = 2\\n'\n                    + '\\n[checks]\\ncommand = \"true\"\\n'\n                    + \"\"\"\\n[forge]\\nchecks_command = \"printf 'ci success\\\\n'\"\\n\"\"\")\n    commit_all(root, \"configure the fixture adapter, the tenant's checks, and the forge read\")\n\n    assert run_attavo(root, \"spec-gate\", \"1\").returncode == 0\n    assert run_attavo(root, \"approve\", \"1\", \"--by\", \"alice\").returncode == 0\n    assert run_attavo(root, \"build\", \"1\").returncode == 0\n\n    build_rec = json.loads((root / \"records\" / \"1\" / \"build-01.json\").read_text())\n    assert build_rec[\"adapter_config\"] == {\"y\": 2}\n    assert build_rec[\"checks\"] == {\"command\": \"true\", \"exit\": 0}\n\n    verify = run_attavo(root, \"verify\", \"1\")\n    assert verify.returncode == 0\n    verify_rec = json.loads((root / \"records\" / \"1\" / \"verify-01.json\").read_text())\n    assert verify_rec[\"status\"] == \"pass\"\n    assert verify_rec[\"findings\"]\n\n    # the build didn't touch spec.md, so the approval is still valid: this\n    # spec-gate run writes the new spec-02.json with status \"approved\".\n    approved = run_attavo(root, \"spec-gate\", \"1\")\n    assert approved.returncode == 0\n    assert json.loads((root / \"records\" / \"1\" / \"spec-02.json\").read_text())[\"status\"] == \"approved\"\n\n    # issue #28: an amendment above the line expires the approval, but a\n    # build already ran after it -- status \"built\". Issue #36: built now\n    # judges each criterion on both on_tree and on_stub, like a pass\n    # record; this fixture's stub also satisfies checks_built.sh, so\n    # on_stub is 0, not null.\n    spec_md = root / \"specs\" / \"1\" / \"spec.md\"\n    spec_md.write_text(spec_md.read_text().replace(\"does not emit\", \"used to not emit\"))\n    commit_all(root, \"amend problem prose\")\n    built = run_attavo(root, \"spec-gate\", \"1\")\n    assert built.returncode == 0\n    spec_03 = json.loads((root / \"records\" / \"1\" / \"spec-03.json\").read_text())\n    assert spec_03[\"status\"] == \"built\"\n    assert spec_03[\"criteria\"][0][\"on_stub\"] == 0\n\n    # Issue #69: attest never writes -- it prints a statement instead. An\n    # explicit item id bypasses its merge-commit derivation -- the chain\n    # this fixture already built (build-01 against approval-01, verify-01\n    # against build-01) is exactly what attest checks, so no merge commit\n    # is needed to prove the statement's shape.\n    attest = run_attavo(root, \"attest\", \"1\")\n    assert attest.returncode == 0, attest.stdout + attest.stderr\n    statement = json.loads(attest.stdout)\n    jsonschema.validate(statement,\n                        json.loads((ROOT / \"schema\" / \"attestation.schema.json\").read_text()))\n\n    schemas = {\"spec\": load_schema(\"spec\"), \"approval\": load_schema(\"approval\"),\n              \"build\": load_schema(\"build\"), \"verify\": load_schema(\"verify\")}\n\n    records = sorted((root / \"records\" / \"1\").glob(\"*.json\"))\n    assert ({p.stem.split(\"-\")[0] for p in records}\n           == {\"spec\", \"approval\", \"build\", \"verify\"})\n    for path in records:\n        stage = path.stem.split(\"-\")[0]\n        jsonschema.validate(json.loads(path.read_text()), schemas[stage])\n\n    # issue #49: product_version and product_pin are not optional extras --\n    # every record shape requires them, the same as any other field.\n    for stage, schema in schemas.items():\n        assert \"product_version\" in schema[\"required\"], stage\n        assert \"product_pin\" in schema[\"required\"], stage\n\n    # issue #60, acceptance 1: every record write_record writes carries\n    # record_version -- equal to that stage schema's own $id version, the\n    # single place the version lives -- and item, matching the directory\n    # it was written under.\n    for path in records:\n        stage = path.stem.split(\"-\")[0]\n        rec = json.loads(path.read_text())\n        assert rec[\"record_version\"] == int(schemas[stage][\"$id\"].rsplit(\"/\", 1)[-1]), stage\n        assert rec[\"item\"] == \"1\", stage\n\n\ndef test_records_carry_product_version_distinct_from_pin(tmp_path: Path) -> None:\n    \"\"\"Issue #49: a record names both what ran (product_version, derived\n    from the running checkout via git describe) and what the tenant\n    declared (product_pin, copied verbatim from the manifest). The\n    build_valid fixture pins v0.2.1; this checkout is not on that tag, so\n    every record type written against it must carry both fields and they\n    must differ -- the mismatch is a recorded fact, not an error nothing\n    here refuses on.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    toml = root / \"attavo.toml\"\n    toml.write_text(toml.read_text()\n                    + '\\n[executor.fixture]\\ny = 2\\n'\n                    + '\\n[checks]\\ncommand = \"true\"\\n'\n                    + \"\"\"\\n[forge]\\nchecks_command = \"printf 'ci success\\\\n'\"\\n\"\"\")\n    commit_all(root, \"configure the fixture adapter, the tenant's checks, and the forge read\")\n\n    assert run_attavo(root, \"spec-gate\", \"1\").returncode == 0\n    assert run_attavo(root, \"approve\", \"1\", \"--by\", \"alice\").returncode == 0\n    assert run_attavo(root, \"build\", \"1\").returncode == 0\n    assert run_attavo(root, \"verify\", \"1\").returncode == 0\n\n    running_version = subprocess.run(\n        [\"git\", \"describe\", \"--tags\", \"--always\", \"--dirty\"],\n        cwd=str(ROOT), capture_output=True, text=True, check=True).stdout.strip()\n\n    records = sorted((root / \"records\" / \"1\").glob(\"*.json\"))\n    assert {p.stem.split(\"-\")[0] for p in records} == {\"spec\", \"approval\", \"build\", \"verify\"}\n    for path in records:\n        rec = json.loads(path.read_text())\n        assert rec[\"product_pin\"] == \"v0.2.1\"\n        assert rec[\"product_version\"] == running_version\n        assert rec[\"product_version\"] != rec[\"product_pin\"]\n\n\ndef test_product_version_unknown_when_product_root_is_not_a_git_repo(tmp_path: Path) -> None:\n    \"\"\"Issue #49 follow-up: GitHub Actions extracts an action into\n    _actions/ from a tarball, not a git checkout -- PRODUCT_ROOT there has\n    no .git, so `git describe` fails and, unguarded, raises inside\n    write_record: the one function that must never fail, since it runs\n    after the work it records already happened. A copy of bin/attavo\n    placed under a fresh, non-git tmp_path reproduces PRODUCT_ROOT with no\n    .git without needing an actual GitHub Actions run. Red today: the\n    KeyError this reproduces is a RuntimeError from git(), uncaught, and\n    no record is written at all. schema/ is copied alongside bin/, same as\n    the real action extraction: write_record reads schema/records/<stage>.schema.json\n    from PRODUCT_ROOT (issue #60), which the action ships beside bin/.\"\"\"\n    product_bin = tmp_path / \"product\" / \"bin\"\n    product_bin.mkdir(parents=True)\n    shutil.copy(ATTAVO, product_bin / \"attavo\")\n    shutil.copytree(ROOT / \"attavo\", tmp_path / \"product\" / \"attavo\")\n    shutil.copytree(ROOT / \"schema\", tmp_path / \"product\" / \"schema\")\n\n    root = make_tenant(tmp_path, \"build_valid\", name=\"tenant\")\n\n    env = dict(os.environ)\n    env.pop(\"ATTAVO_PRODUCT_VERSION\", None)\n    run = subprocess.run([sys.executable, str(product_bin / \"attavo\"), \"spec-gate\", \"1\"],\n                        cwd=str(root), env=env, capture_output=True, text=True, check=False)\n    assert run.returncode == 0, run.stderr\n\n    rec = json.loads((root / \"records\" / \"1\" / \"spec-01.json\").read_text())\n    assert rec[\"product_version\"] == \"unknown\"\n\n\ndef test_manifest_schema_accepts_open_executor_config() -> None:\n    \"\"\"Issue #24, acceptance 5 (manifest half): [executor.<adapter-name>]\n    is an open table -- the schema permits any keys under it, none\n    required, alongside the existing build/verify string keys.\"\"\"\n    schema = json.loads((ROOT / \"schema\" / \"manifest.schema.json\").read_text())\n    manifest = {\n        \"schema_version\": 1,\n        \"attavo\": {\"version\": \"v0.3.1\"},\n        \"executor\": {\n            \"build\": \"claude-code\",\n            \"claude-code\": {\"auth\": \"subscription\", \"some_future_key\": True},\n        },\n        \"spec\": {\"boundary\": {\"paths\": [\"src/**\"]}},\n        \"gates\": {},\n        \"paths\": {\"specs\": \"specs\", \"records\": \"records\",\n                 \"rulings\": \"rulings.md\", \"rejections\": \"rejections\"},\n        \"operators\": {\"approvers\": [\"alice\"]},\n    }\n    jsonschema.validate(manifest, schema)\n\n\ndef base_manifest() -> dict[str, Any]:\n    return {\n        \"schema_version\": 1,\n        \"attavo\": {\"version\": \"v0.3.3\"},\n        \"executor\": {\"build\": \"fixture\"},\n        \"spec\": {\"boundary\": {\"paths\": [\"src/**\"]}},\n        \"gates\": {},\n        \"paths\": {\"specs\": \"specs\", \"records\": \"records\",\n                 \"rulings\": \"rulings.md\", \"rejections\": \"rejections\"},\n        \"operators\": {\"approvers\": [\"alice\"]},\n    }\n\n\ndef test_manifest_schema_describes_checks() -> None:\n    \"\"\"Issue #30, acceptance 4 (manifest half): [checks] is optional, with\n    command required inside it -- a manifest with no [checks] table at\n    all is still valid (unlike [tests], which build itself requires).\"\"\"\n    schema = json.loads((ROOT / \"schema\" / \"manifest.schema.json\").read_text())\n\n    without_checks = base_manifest()\n    jsonschema.validate(without_checks, schema)\n\n    with_checks = base_manifest()\n    with_checks[\"checks\"] = {\"command\": \"python3 bin/factory-lane check --base origin/main\"}\n    jsonschema.validate(with_checks, schema)\n\n\n# --- issue #60: records declare their own record_version and item ---\n\ndef test_write_record_refuses_a_key_its_schema_does_not_declare(tmp_path: Path) -> None:\n    \"\"\"Acceptance 2: write_record enforces the declared key set at write\n    time -- a record carrying a key its stage's schema does not list under\n    \"properties\" is refused, and nothing is written. Enforced with the\n    standard library (set difference against the schema's own properties),\n    not a jsonschema import into bin/attavo -- it is a single script a\n    tenant pins, and a runtime dependency changes installation.\"\"\"\n    attavo = attavo_module()\n    schema = load_schema(\"spec\")\n    record: dict[str, Any] = {k: None for k in schema[\"properties\"]\n             if k not in (\"record_version\", \"item\", \"product_version\", \"product_pin\")}\n    record[\"unexpected_key\"] = \"not in the schema\"\n\n    records_dir = tmp_path / \"records\" / \"1\"\n    with pytest.raises(ValueError, match=\"unexpected_key\"):\n        attavo.write_record(records_dir, \"spec\", record, {\"attavo\": {}}, \"1\")\n    assert list(records_dir.glob(\"spec-*.json\")) == []\n\n\ndef test_write_record_stamps_record_version_from_the_schemas_id(tmp_path: Path) -> None:\n    \"\"\"Acceptance/correction point 2: record_version is read from the\n    stage schema's own $id at call time rather than carried separately in\n    bin/attavo, so it cannot drift from what the schema declares. Point\n    write_record at a copy of the real build schema whose $id is bumped\n    past what ships today, and confirm the written record follows it.\"\"\"\n    attavo = attavo_module()\n    schema_dir = tmp_path / \"schema\"\n    (schema_dir / \"records\").mkdir(parents=True)\n    build_schema = load_schema(\"build\")\n    bumped = json.loads(json.dumps(build_schema))\n    stem, _, tail = bumped[\"$id\"].rpartition(\"/\")\n    bumped[\"$id\"] = f\"{stem}/{int(tail) + 1}\"\n    (schema_dir / \"records\" / \"build.schema.json\").write_text(json.dumps(bumped))\n\n    real_schema_dir = attavo.SCHEMA_RECORDS_DIR\n    attavo.SCHEMA_RECORDS_DIR = schema_dir / \"records\"\n    try:\n        record: dict[str, Any] = {k: None for k in build_schema[\"properties\"]\n                 if k not in (\"record_version\", \"item\", \"product_version\", \"product_pin\")}\n        path = attavo.write_record(tmp_path / \"records\" / \"1\", \"build\", record,\n                                   {\"attavo\": {}}, \"1\")\n    finally:\n        attavo.SCHEMA_RECORDS_DIR = real_schema_dir\n\n    assert json.loads(path.read_text())[\"record_version\"] == int(tail) + 1\n\n\ndef _blank_record(stage: str) -> dict[str, Any]:\n    schema = load_schema(stage)\n    return {k: None for k in schema[\"properties\"]\n            if k not in (\"record_version\", \"item\", \"product_version\", \"product_pin\")}\n\n\ndef test_write_record_refuses_a_failed_record_with_no_trail(tmp_path: Path) -> None:\n    \"\"\"Issue #53, rejection test 1. A failed record whose log is empty and\n    whose refusal and halted are both null explains nothing -- write_record\n    refuses it by name and writes neither the record nor the log. Tenant\n    zero's build-11.json, as recorded, has exactly this shape.\"\"\"\n    attavo = attavo_module()\n    record = _blank_record(\"build\")\n    record.update({\"status\": \"failed\", \"refusal\": None, \"halted\": None})\n\n    records_dir = tmp_path / \"records\" / \"576\"\n    with pytest.raises(ValueError, match=\"failed\"):\n        attavo.write_record(records_dir, \"build\", record, {\"attavo\": {}}, \"576\", log=\"\")\n    assert list(records_dir.glob(\"build-*.json\")) == []\n    assert list(records_dir.glob(\"build-*.log\")) == []\n\n\ndef test_write_record_accepts_a_returned_record_with_no_log(tmp_path: Path) -> None:\n    \"\"\"Issue #53, rejection test 2. A returned verify record owes no log at\n    all, because no adapter ran -- accepted, and write_record writes no log\n    file for it. #576's verify-02 shape.\"\"\"\n    attavo = attavo_module()\n    record = _blank_record(\"verify\")\n    record[\"status\"] = \"returned\"\n\n    records_dir = tmp_path / \"records\" / \"1\"\n    path = attavo.write_record(records_dir, \"verify\", record, {\"attavo\": {}}, \"1\")\n    assert path.exists()\n    assert not path.with_suffix(\".log\").exists()\n\n\ndef test_write_record_accepts_a_failed_record_with_a_populated_refusal(tmp_path: Path) -> None:\n    \"\"\"Issue #53, lane table row 5. A failed record with a populated\n    refusal (or halted) and an empty log is accepted -- the refusal or\n    halted text is itself the trail the rule requires.\"\"\"\n    attavo = attavo_module()\n    record = _blank_record(\"build\")\n    record.update({\"status\": \"failed\", \"refusal\": \"outside the claims boundary\", \"halted\": None})\n\n    records_dir = tmp_path / \"records\" / \"1\"\n    path = attavo.write_record(records_dir, \"build\", record, {\"attavo\": {}}, \"1\", log=\"\")\n    assert path.exists()\n    assert path.with_suffix(\".log\").exists()\n    assert path.with_suffix(\".log\").read_text() == \"\"\n\n\ndef _load_check_record_schema_version() -> Any:\n    \"\"\"scripts/check_record_schema_version.py -- schema_version_drift's\n    one home. CI's schema-version job (.github/workflows/ci.yml, on\n    pull_request and merge_group) imports the same module to run it\n    against this repository's real schema files at the merge base and at\n    HEAD; a merge-base read behaves differently inside pytest than in the\n    workflow, so that comparison lives outside this suite. This test is\n    the helper's own rejection test, run here against a mutated copy of a\n    real schema rather than the merge base.\"\"\"\n    path = ROOT / \"scripts\" / \"check_record_schema_version.py\"\n    spec = importlib.util.spec_from_file_location(\"check_record_schema_version\", path)\n    assert spec is not None and spec.loader is not None\n    module = importlib.util.module_from_spec(spec)\n    spec.loader.exec_module(module)\n    return module\n\n\nschema_version_drift = _load_check_record_schema_version().schema_version_drift\n\n\ndef test_schema_shape_change_without_a_version_bump_is_refused() -> None:\n    \"\"\"Acceptance 3, run against a mutated schema fixture: drop-in a new\n    required field on the real, committed build schema without touching\n    its $id -- refused. The identical mutation with $id bumped alongside\n    it is not.\"\"\"\n    base = load_schema(\"build\")\n    mutated = json.loads(json.dumps(base))\n    mutated[\"properties\"][\"a_new_field\"] = {\"type\": \"string\", \"minLength\": 1}\n    mutated[\"required\"] = mutated[\"required\"] + [\"a_new_field\"]\n    assert schema_version_drift(base, mutated) is not None\n\n    bumped = json.loads(json.dumps(mutated))\n    stem, _, tail = bumped[\"$id\"].rpartition(\"/\")\n    bumped[\"$id\"] = f\"{stem}/{int(tail) + 1}\"\n    assert schema_version_drift(base, bumped) is None\n\n    # a change carrying no shape change at all -- e.g. a description edit\n    # -- never needs a version bump.\n    reworded = json.loads(json.dumps(base))\n    reworded[\"title\"] = reworded[\"title\"] + \" (reworded)\"\n    assert schema_version_drift(base, reworded) is None\n\n\ndef test_load_records_defaults_a_version_1_record_and_fills_its_item(tmp_path: Path) -> None:\n    \"\"\"Acceptance 4: a record written before record_version and item\n    shipped -- tenant zero's real shape at 3648830, common keys across 49\n    records: ['at', 'sha'] and nothing else -- loads with record_version 1\n    and item filled from the directory it sits under. The disk copy is\n    never touched: version 1 is never migrated (issue #60, operator\n    ruling 2026-09-09: record_version is a label, never a trigger for\n    reading or upgrading an older record).\"\"\"\n    attavo = attavo_module()\n    records_dir = tmp_path / \"records\" / \"1\"\n    records_dir.mkdir(parents=True)\n    tenant_zero_shape = {\"sha\": \"a\" * 40, \"at\": \"2026-01-01T00:00:00Z\"}\n    (records_dir / \"build-01.json\").write_text(json.dumps(tenant_zero_shape))\n\n    items = attavo.load_records(tmp_path / \"records\")\n    rec = items[\"1\"][\"build\"]\n    assert rec[\"record_version\"] == 1\n    assert rec[\"item\"] == \"1\"\n\n    on_disk = json.loads((records_dir / \"build-01.json\").read_text())\n    assert on_disk == tenant_zero_shape\n\n\ndef test_load_records_refuses_an_item_that_disagrees_with_its_directory(tmp_path: Path) -> None:\n    \"\"\"Acceptance 5: a record whose item field names a different item\n    than the directory it was found in -- a misfiled or copied record --\n    is refused rather than trusted.\"\"\"\n    attavo = attavo_module()\n    records_dir = tmp_path / \"records\" / \"1\"\n    records_dir.mkdir(parents=True)\n    (records_dir / \"build-01.json\").write_text(json.dumps(\n        {\"sha\": \"a\" * 40, \"at\": \"2026-01-01T00:00:00Z\", \"item\": \"2\"}))\n\n    with pytest.raises(attavo.RecordItemMismatch):\n        attavo.load_records(tmp_path / \"records\")\n\n\ndef test_only_load_record_parses_record_file_content() -> None:\n    \"\"\"Acceptance 6: _load_record is the one place in this repository\n    that turns a <stage>-NN.json record's bytes into a dict; parse_attempts\n    and load_records both read through it rather than calling json.loads\n    themselves. `git grep -n \"json.loads(\" bin/attavo` still finds six\n    other sites -- a schema file, an adapter's conformance.json, an\n    adapter's own stdout report, proof four's own read of one log line at\n    a time to tell an adapter's JSON event stream from a tool's plain-text\n    error (issue #94), proof five's own read of the forge's attestation\n    statement (issue #158), and verify's own read of the forge checks a\n    drive pass already wrote (issue #217, ATTAVO_FORGE_CHECKS) -- none of\n    them a record.\"\"\"\n    text = \"\\n\".join(p.read_text() for p in sorted((ROOT / \"attavo\").rglob(\"*.py\")))\n    assert text.count(\"json.loads(\") == 7, (\n        \"a new json.loads( site was added; review it against issue #60 acceptance 6 \"\n        \"and update this count\")\n    assert \"data = json.loads(path.read_text())\" in text\n\n    for fn in (\"parse_attempts\", \"load_records\"):\n        # The implementation is the last def of the name: the typed loaders'\n        # @overload stubs (issue #189) precede it.\n        start = text.rindex(f\"\\ndef {fn}(\")\n        end = text.index(\"\\ndef \", start + 1)\n        body = text[start:end]\n        assert \"json.loads(\" not in body, f\"{fn} should read through _load_record, not parse directly\"\n        assert \"_load_record(\" in body\n","numLines":443,"startLine":1,"totalLines":443}}}

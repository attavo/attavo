\"\\\"\\\"\\nattavo/stops.py:68:# moves non-question and outlived-invocation onto report_class instead\\nattavo/stops.py:69:# (below): non-question's own halt line (\\\"halted: class non-question\\\")\\nattavo/stops.py:76:    \\\"non-question\\\": (),\\nattavo/stops.py:80:    # judgment like non-question/outlived-invocation are. Left at the\\nattavo/stops.py:88:    # (derive_stop's report_class), returned is written by the product\\nattavo/stops.py:96:    # -- status \\\"halted\\\" carrying a non-empty halted.question -- not by\\nattavo/stops.py:148:    disables non-question and outlived-invocation the same way, reading\\nattavo/stops.py:149:    both from the adapter's own report line (derive_stop's report_class)\\nattavo/stops.py:159:def derive_stop(status: str, *, refusal: str | None = None, halted: dict[str, Any] | None = None,\\nattavo/stops.py:172:        payload once an iteration ends. This is non-question's and\\nattavo/stops.py:180:        class on the line the way non-question already does.\\nattavo/stops.py:181:      - a halt carrying a non-empty halted.question, once it is not a\\nattavo/stops.py:182:        non-question caught above, is a genuine question -- question/spec,\\nattavo/stops.py:188:        a person's or a ruling's to answer, never the product's own\\nattavo/stops.py:203:        refusal there is not the spec's boundary to answer for\\nattavo/stops.py:211:        evidence already lives in refusal, halted, forge_checks, or the\\nattavo/stops.py:220:    question = (halted or {}).get(\\\"question\\\")\\nattavo/stops.py:221:    if status == \\\"halted\\\" and question:\\nattavo/stops.py:236:    \\\"\\\"\\\"The stop for a refused spec-gate record: class \\\"gate\\\", provenance\\nattavo/stops.py:248:# --- stops: every non-pass record by class, provenance, and answerer\\nattavo/stops.py:260:    The answerer, a closed choice: \\\"counsel:<verdict>\\\" when\\nattavo/stops.py:261:    counsel_record_for finds a counsel record naming this exact stage and\\nattavo/stops.py:262:    number -- the product's own answer, which wins over whatever the stop\\nattavo/stops.py:263:    itself says, since a counseled stop was already read once; failing\\nattavo/stops.py:264:    that, \\\"person\\\" for class question (a person's to answer, not a\\nattavo/stops.py:268:    answered it yet.\\\"\\\"\\\"\\nattavo/stops.py:271:    by_class = {c: 0 for c in stop_class_enum()}\\nattavo/stops.py:272:    by_answerer: dict[str, int] = {}\\nattavo/stops.py:281:        counsel = counsel_record_for(item_records_dir, stage, n)\\nattavo/stops.py:283:        if counsel is not None:\\nattavo/stops.py:284:            answerer = f\\\"counsel:{counsel.get('verdict')}\\\"\\nattavo/stops.py:285:        elif stop and stop.get(\\\"class\\\") == \\\"question\\\":\\nattavo/stops.py:286:            answerer = \\\"person\\\"\\nattavo/stops.py:287:        elif stop and stop.get(\\\"class\\\") in GUARDED_STOP_CLASSES:\\nattavo/stops.py:288:            answerer = \\\"guard\\\"\\nattavo/stops.py:290:            answerer = \\\"none\\\"\\nattavo/stops.py:293:            cls, provenance, detail = (stop.get(\\\"class\\\"), stop.get(\\\"provenance\\\"),\\nattavo/stops.py:301:        by_answerer[answerer] = by_answerer.get(answerer, 0) + 1\\nattavo/stops.py:304:                    \\\"answerer\\\": answerer, \\\"filed_issue\\\": filed_issue})\\nattavo/stops.py:317:    totals = {\\\"by_class\\\": by_class, \\\"by_answerer\\\": by_answerer,\\nattavo/stops.py:353:                 f\\\"{row['answerer']:<16}{filed}\\\")\\nattavo/stops.py:356:        print(f\\\"  by answerer: {t['by_answerer']}\\\")\\nattavo/stops.py:363:# The stop classes issue #89 gave no code of their own beyond the guard\\nattavo/stops.py:364:# that raised them -- non-question and outlived-invocation from an\\nattavo/stops.py:369:# #115). question (a person's to answer) and the residual (no-cause,\\nattavo/stops.py:374:GUARDED_STOP_CLASSES = (\\\"non-question\\\", \\\"outlived-invocation\\\", \\\"forge-unconcluded\\\", \\\"ceiling\\\",\\nattavo/stops.py:378:def stop_class_enum() -> tuple[str, ...]:\\nattavo/stops.py:386:    return tuple(schema[\\\"properties\\\"][\\\"stop\\\"][\\\"properties\\\"][\\\"class\\\"][\\\"enum\\\"])\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n+{\"type\":\"item.completed\",\"item\":{\"id\":\"item_4\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"sed -n '1,120p' adapters/claude-code/run; sed -n '240,290p' adapters/claude-code/run; sed -n '610,640p' adapters/claude-code/run; sed -n '920,1060p' adapters/claude-code/run; sed -n '1,240p' attavo/stops.py; sed -n '420,500p' attavo/drive.py; sed -n '720,790p' attavo/drive.py; sed -n '1,260p' /Users/davidbean/Projects/attest/attest/rulings.md; rg -n '\\\"'^diff --git|''^@@|non-question|question.*null|StructuredOutput|test run|background|mypy|retry'\\\"' /var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmpemqyp_jr/diff.patch | tail -n 500\\\"\",\"aggregated_output\":\"#!/usr/bin/env python3\\n\\\"\\\"\\\"adapters/claude-code/run -- see README.md (this directory) for the four\\nconfiguration keys, and ../README.md for the shared adapter contract.\\n\\nA live `claude` invocation is not exercised by the test suite (judgment\\nis measured, not tested); its argument construction is checked by\\nATTAVO_ADAPTER_DRY_RUN=1, which prints the `claude` command line as a\\nJSON array instead of running it, its response handling is checked by\\nATTAVO_ADAPTER_RESPONSE_FILE, which reads a canned final report object\\nfrom a file instead of invoking `claude`, and (issue #26) its\\n`--output-format stream-json --verbose` mapping -- the event stream\\nthis adapter maps to ATTAVO_EVENTS, and the terminal \\\"result\\\" line it\\nreads the report object from -- is checked by ATTAVO_ADAPTER_STREAM_FILE,\\nwhich feeds a recorded transcript instead.\\n\\nThe whole result is printed to stdout before this adapter's own final\\nline, so build-NN.log carries it as the transcript -- a halt otherwise\\ncannot be explained after the fact. is_error or an absent\\nstructured_output exit 1 on either stage; a build status \\\"question\\\"\\nwhose question is missing or under MIN_QUESTION_CHARS characters also\\nexits 1 (build records the attempt as failed) rather than a halt\\nsomeone must rule on.\\n\\nATTAVO_STAGE=verify branches to a different objective, schema, and\\nreport shape (issue #46): the instruction states the verify objective\\n(see verify_instruction) instead of the build one, --json-schema is\\nVERIFY_SCHEMA instead of STATUS_SCHEMA, and the final line carries\\nfindings and tests_named instead of status and question.\\n\\nIssue #78: the boundary is the tool's own sandbox, not a curated\\nallowed_tools list judged per sub-command -- confirmed live (recorded on\\nthe issue, 2026-09-10) against `claude 2.1.268`: `--settings` carrying\\n`{\\\"sandbox\\\": {\\\"enabled\\\": true, \\\"allowUnsandboxedCommands\\\": false}}` under\\n`-p` refuses a write outside the working directory (\\\"operation not\\npermitted\\\") and, with `network.allowedDomains: []`, refuses an outbound\\nconnection (\\\"deny network-outbound ...\\\"), both before `--allowedTools`\\nis ever consulted. build's `--settings` therefore enables the sandbox and\\nforbids the unsandboxed fallback; verify's additionally sets\\n`filesystem.denyWrite` on the working directory itself (confirmed live:\\n`denyWrite` takes a list of paths, not a bare boolean -- `true` alone did\\nnot stop a write inside the directory). `--allowedTools` shrinks to the\\ntool names each stage may use at all -- `Read,Edit,Write,Bash` for build,\\n`Read,Bash` for verify -- since Edit and Write are not Bash and the\\nsandbox does not govern them. `allowed_tools` is retired as a manifest\\nkey: a config that still declares it is refused by name rather than\\nsilently accepted.\\n\\nIssue #88 (class A: a report is not a question). `--json-schema`\\nconstrains the tool's structured_output to \\\"done\\\"/\\\"question\\\", but\\nnothing stops \\\"question\\\" from carrying a status report rather than an\\nactual question -- confirmed against tenant zero's own corpus, five\\nspecimens with no \\\"?\\\" anywhere in the text. A \\\"question\\\" whose text\\nclears MIN_QUESTION_CHARS but contains no \\\"?\\\" is a report, not a\\nquestion: this adapter re-invokes the executor once, appending\\nREINSTRUCTION to the same instruction, before ever reporting a halt to\\na person. A second report in a row still halts (someone must look), but\\nits report line carries \\\"class\\\": \\\"non-question\\\" and both raw results\\nreached stdout above it -- an extra field bin/attavo's own record schema\\ndoes not know about and never has to: it reads \\\"status\\\"/\\\"question\\\" off\\nthis line exactly as before, so a \\\"question\\\" halt still halts. Read via\\nATTAVO_ADAPTER_RESPONSE_FILE, a JSON array is a queue -- one canned\\nresult per invocation this adapter makes, its last element repeating\\nonce exhausted -- while a single object still repeats for every call,\\nunchanged.\\n\\nIssue #88 (class B: work that outlives the invocation). Confirmed live,\\nthis machine, `claude 2.1.269`: with both \\\"Agent\\\" and \\\"Task\\\" allowed, a\\nprompt asking for a subagent produced `subagent_stats.spawned: 1`, `\\\"Agent\\\"`\\nalone in `--disallowedTools` (Task is not a distinct tool in this build)\\nbrought it back to 0 -- the tool's own reply named \\\"Workflow\\\" as the\\nother path to background work, so both are named here. `--allowedTools`\\nis an allow-list a background spawn does not consult (tenant zero's\\nspecimen: `--allowedTools` without \\\"Agent\\\" or \\\"Workflow\\\" in it at all did\\nnot stop three of them), so this adapter also disallows them by name on\\nboth stages and, after the run, refuses by name -- exit 1, not a\\nhalt -- any response whose subagent_stats.spawned is not zero, with the\\ncounts in the message. A tool that reports no subagent_stats at all\\n(spawned absent or 0) is unaffected; this is a refusal on evidence, not a\\nguess from the flag.\\n\\\"\\\"\\\"\\nfrom __future__ import annotations\\n\\nimport json\\nimport os\\nimport subprocess\\nimport sys\\nfrom datetime import datetime, timezone\\nfrom pathlib import Path\\n\\n# the helper beside adapters/, imported without leaving a __pycache__ there\\nsys.dont_write_bytecode = True\\nsys.path.insert(0, str(Path(__file__).resolve().parent.parent))\\nfrom executor_env import executor_env  # noqa: E402\\n\\nSTATUS_SCHEMA = {\\n    \\\"type\\\": \\\"object\\\",\\n    \\\"additionalProperties\\\": False,\\n    \\\"required\\\": [\\\"status\\\", \\\"question\\\"],\\n    \\\"properties\\\": {\\n        \\\"status\\\": {\\\"type\\\": \\\"string\\\", \\\"enum\\\": [\\\"done\\\", \\\"question\\\"]},\\n        \\\"question\\\": {\\\"type\\\": [\\\"string\\\", \\\"null\\\"]},\\n    },\\n}\\n\\n# The verify objective (issue #46): a verifier reports findings, not a\\n# commit. additionalProperties: False means the tool cannot hand back a\\n# structured_output shaped like STATUS_SCHEMA's status/question by\\n# accident -- an absent findings key is what cmd_verify treats as\\n# failed, not a lenient default here.\\nVERIFY_SCHEMA = {\\n    \\\"type\\\": \\\"object\\\",\\n    \\\"additionalProperties\\\": False,\\n    \\\"required\\\": [\\\"findings\\\", \\\"tests_named\\\"],\\n    \\\"properties\\\": {\\n        \\\"findings\\\": {\\n            \\\"type\\\": \\\"array\\\",\\n            \\\"items\\\": {\\n                \\\"type\\\": \\\"object\\\",\\n                \\\"additionalProperties\\\": False,\\n                \\\"required\\\": [\\\"title\\\", \\\"specimen\\\", \\\"retires\\\", \\\"rejection_test\\\", \\\"severity\\\"],\\n    evidence -- a criterion it satisfies trivially is weak -- but twice\\n    the judge reported\\n    a built tree as failing to match its stub as if the stub were the\\n    intended change (tenant zero #664, #644): one sentence of vocabulary\\n    was missing, not a smarter judge or a dropped stub.\\\"\\\"\\\"\\n    stub_dir = Path(os.environ[\\\"ATTAVO_SPEC_DIR\\\"]) / \\\"stub\\\"\\n    if not stub_dir.is_dir():\\n        return None\\n    return (\\n        f\\\"## The stub at `{stub_dir}`\\\\n\\\\n\\\"\\n        \\\"The stub is the fixture the acceptance criteria were shown to \\\"\\n        \\\"pass against; it is not the intended change. A difference \\\"\\n        \\\"between the built tree and the stub is not a finding: a \\\"\\n        \\\"criterion the stub satisfies trivially is.\\\")\\n\\n\\ndef build_instruction() -> str:\\n    parts = list(spec_sections())\\n\\n    rulings = read_text(\\\"ATTAVO_RULINGS\\\")\\n    if rulings.strip():\\n        parts.append(\\\"## Rulings\\\\n\\\\n\\\" + rulings.strip())\\n\\n    feedback_path = os.environ.get(\\\"ATTAVO_FEEDBACK\\\")\\n    feedback = read_text(\\\"ATTAVO_FEEDBACK\\\")\\n    if feedback.strip():\\n        parts.append(\\n            \\\"## Feedback from the previous attempt\\\\n\\\\n\\\"\\n            f\\\"The feedback is at {describe_file(feedback_path, feedback, diff_like=False)}. \\\"\\n            \\\"It is not inlined here: read it yourself with your own tools \\\"\\n            \\\"before continuing.\\\")\\n\\n    parts.append(\\n        \\\"commit your work on the current branch; if you cannot proceed \\\"\\n        \\\"without a decision that changes the criteria, do not guess: \\\"\\n        \\\"answer with status question\\\")\\n\\n    test_command = os.environ.get(\\\"ATTAVO_TEST_COMMAND\\\")\\n    if test_command:\\n        bound = os.environ.get(\\\"ATTAVO_TEST_TIMEOUT_S\\\")\\n        parts.append(\\n            f\\\"to run tests while you work, run `{test_command}`: it runs the tests \\\"\\n            \\\"selected for the files you have changed\\\"\\n            + (f\\\" and stops at {bound} s\\\" if bound else \\\"\\\")\\n            + \\\". Do not run the whole test suite or any whole-tree check yourself: \\\"\\n            \\\"after you commit, the gates are run for you and any failure is \\\"\\n            \\\"returned to you on the next iteration\\\")\\n\\n    return \\\"\\\\n\\\\n\\\".join(parts)\\n\\n\\n    return winner, model_usage[winner].get(\\\"canonicalModel\\\")\\n\\n\\ndef adapter_version() -> str:\\n    try:\\n        out = subprocess.run([\\\"claude\\\", \\\"--version\\\"], capture_output=True,\\n                             text=True, check=False)\\n    except OSError:\\n        return \\\"\\\"\\n    return out.stdout.strip()\\n\\n\\nMIN_QUESTION_CHARS = 40\\n\\nREINSTRUCTION = (\\n    \\\"your last answer was a report, not a question; either continue to \\\"\\n    \\\"done, or ask one question ending in a question mark that names the \\\"\\n    \\\"spec line or guard you cannot resolve\\\")\\n\\n\\ndef question_class(status: str, question: str | None) -> str:\\n    \\\"\\\"\\\"\\\"done\\\" (no halt at all), \\\"fail\\\" (a question too short or absent to\\n    be worth a person's judgment -- MIN_QUESTION_CHARS, unchanged since\\n    v0.15.0), \\\"report\\\" (long enough but carries no \\\"?\\\" -- issue #88's\\n    class A, a status update in the question channel), or \\\"question\\\" (a\\n    real question).\\\"\\\"\\\"\\n    if status != \\\"question\\\":\\n        return \\\"done\\\"\\n    if not question or len(question) < MIN_QUESTION_CHARS:\\n        # An absent or too-short question is a report with nothing in\\n        # it: a status update in the question channel (issue #150, three\\n        sys.stderr.write(f\\\"adapters/claude-code/run: refused: {refusal}\\\\n\\\")\\n        return 1\\n\\n    stage = os.environ.get(\\\"ATTAVO_STAGE\\\") or \\\"build\\\"\\n    if stage not in (\\\"build\\\", \\\"verify\\\", \\\"counsel\\\"):\\n        stage = \\\"build\\\"\\n    verifying = stage == \\\"verify\\\"\\n    counseling = stage == \\\"counsel\\\"\\n    if verifying:\\n        instruction, schema = verify_instruction(), VERIFY_SCHEMA\\n    elif counseling:\\n        instruction, schema = counsel_instruction(), COUNSEL_SCHEMA\\n    else:\\n        instruction, schema = build_instruction(), STATUS_SCHEMA\\n    cmd = build_command(instruction, config, schema, stage)\\n\\n    ceiling = ceiling_refusal(instruction)\\n    if ceiling:\\n        sys.stderr.write(f\\\"adapters/claude-code/run: refused: {ceiling}\\\\n\\\")\\n        return 1\\n\\n    if os.environ.get(\\\"ATTAVO_ADAPTER_DRY_RUN\\\"):\\n        # {\\\"argv\\\", \\\"instruction\\\", \\\"schema\\\"}, not a bare argv list: the\\n        # instruction lives in argv's own \\\"-p\\\" value here, but a second\\n        # adapter (issue #41) can deliver it on stdin instead, where\\n        # argv carries no instruction at all -- the envelope is what\\n        # stays adapter-agnostic for tests/test_executor_conformance.py.\\n        print(json.dumps({\\\"argv\\\": cmd, \\\"instruction\\\": instruction, \\\"schema\\\": schema}))\\n        return 0\\n\\n    responses = load_canned_responses()\\n    events_path = os.environ.get(\\\"ATTAVO_EVENTS\\\")\\n\\n    exit_code, response = invoke_once(cmd, responses, 0, events_path)\\n    if exit_code is not None:\\n        return exit_code\\n\\n    # An error dressed as a question still costs a ruling act. Treat both\\n    # the same way build already treats a non-zero adapter exit: failed,\\n    # not a halt someone must rule on. Stage-independent: a tool error or\\n    # an absent report is a failure whether this is a build or a verify.\\n    if response.get(\\\"is_error\\\") or not response.get(\\\"structured_output\\\"):\\n        return 1\\n\\n    refusal = subagent_refusal(response)\\n    if refusal:\\n        sys.stderr.write(refusal + \\\"\\\\n\\\")\\n        return 1\\n\\n    structured = response.get(\\\"structured_output\\\") or {}\\n\\n    if verifying:\\n        common = report_fields(response, config.get(\\\"model\\\"))\\n        if common is None:\\n            return 1\\n        # .get(), not \\\"or []\\\": an absent findings key must reach\\n        # cmd_verify as None, distinct from an explicit empty list --\\n        # that distinction is the whole fix for issue #46.\\n        line = {**common,\\n               \\\"findings\\\": structured.get(\\\"findings\\\"),\\n               \\\"tests_named\\\": structured.get(\\\"tests_named\\\")}\\n        print(json.dumps(line))\\n        return 0\\n\\n    if counseling:\\n        common = report_fields(response, config.get(\\\"model\\\"))\\n        if common is None:\\n            return 1\\n        line = {**common,\\n               \\\"class\\\": structured.get(\\\"class\\\"),\\n               \\\"verdict\\\": structured.get(\\\"verdict\\\"),\\n               \\\"citations\\\": structured.get(\\\"citations\\\"),\\n               \\\"proposal\\\": structured.get(\\\"proposal\\\")}\\n        print(json.dumps(line))\\n        return 0\\n\\n    status = structured.get(\\\"status\\\", \\\"done\\\")\\n    question = structured.get(\\\"question\\\")\\n    cls = question_class(status, question)\\n\\n    if cls == \\\"fail\\\":\\n        return 1\\n\\n    if cls == \\\"report\\\":\\n        # Issue #88, class A: a report in the question channel is\\n        # re-instructed once, in this same invocation, before it ever\\n        # reaches a person.\\n        reinstruction = instruction + \\\"\\\\n\\\\n\\\" + REINSTRUCTION\\n        cmd2 = build_command(reinstruction, config, schema, stage)\\n        exit_code2, response2 = invoke_once(cmd2, responses, 1, events_path)\\n        if exit_code2 is not None:\\n            return exit_code2\\n        if response2.get(\\\"is_error\\\") or not response2.get(\\\"structured_output\\\"):\\n            return 1\\n        refusal2 = subagent_refusal(response2)\\n        if refusal2:\\n            sys.stderr.write(refusal2 + \\\"\\\\n\\\")\\n            return 1\\n\\n        structured2 = response2.get(\\\"structured_output\\\") or {}\\n        status2 = structured2.get(\\\"status\\\", \\\"done\\\")\\n        question2 = structured2.get(\\\"question\\\")\\n        cls2 = question_class(status2, question2)\\n        if cls2 == \\\"fail\\\":\\n            return 1\\n\\n        common2 = report_fields(response2, config.get(\\\"model\\\"))\\n        if common2 is None:\\n            return 1\\n        # A non-question costs two executor turns, not one: sum both\\n        # calls' tokens and cost into the one report line this\\n        # invocation gets, whatever the retry's own outcome -- only\\n        # adapter_version/model/model_version stay the second call's.\\n        tokens1_input, tokens1_output, cost1 = usage_fields(response)\\n        common2[\\\"tokens\\\"][\\\"input\\\"] += tokens1_input\\n        common2[\\\"tokens\\\"][\\\"output\\\"] += tokens1_output\\n        common2[\\\"cost_usd\\\"] = add_cost(common2[\\\"cost_usd\\\"], cost1)\\n\\n        if cls2 == \\\"report\\\":\\n            # Two reports in a row: still a halt (someone must look),\\n            # but the transcript above already carries both raw\\n            # results, and this report line names the class so a\\n            # reader -- or a future record field, not this one -- can\\n            # tell it apart from a genuine question.\\n            print(\\\"adapters/claude-code/run: halted: class non-question \\\"\\n                  \\\"-- the executor reported instead of asking, twice in \\\"\\n                  \\\"a row\\\")\\n            line = {**common2, \\\"status\\\": \\\"question\\\", \\\"question\\\": question2,\\n                   \\\"class\\\": \\\"non-question\\\"}\\n            print(json.dumps(line))\\n            return 0\\n\\n        line = {**common2, \\\"status\\\": status2, \\\"question\\\": question2}\\n        print(json.dumps(line))\\n        return 0\\n\\n    common = report_fields(response, config.get(\\\"model\\\"))\\n    if common is None:\\n        return 1\\n    line = {**common, \\\"status\\\": status, \\\"question\\\": question}\\n    print(json.dumps(line))\\nfrom __future__ import annotations\\n\\nimport json\\nimport re\\nimport sys\\nfrom pathlib import Path\\nfrom typing import Any\\n\\nfrom attavo.common import MANIFEST, read_manifest\\nfrom attavo.records import parse_attempts, stage_schema\\nfrom attavo.types import CounselRecord, Stop\\n\\n# --- stop: every non-pass build or verify record's class and cause (issue\\n# #89) -- derived here, at write time, from the refusal, halted, and log\\n# the caller already has. Never a fresh read of anything: the tenant zero\\n# specimens this retires (#576 build-11, #659 build-01 and verify-01) are\\n# exactly a stop the product wrote with nothing beside it to explain\\n# itself after the fact. ---\\n\\nSTOP_CLASSES = (\\\"non-question\\\", \\\"outlived-invocation\\\", \\\"no-cause\\\", \\\"forge-unconcluded\\\",\\n               \\\"ceiling\\\", \\\"claims-boundary\\\", \\\"repeated-act\\\", \\\"unclassed\\\", \\\"question\\\",\\n               \\\"environment\\\", \\\"gate\\\", \\\"died\\\", \\\"hung\\\", \\\"transient\\\", \\\"returned\\\")\\n\\n# R3: the four families a pass retries without a person -- died and hung\\n# (recovery's, unchanged), transient (a vendor's capacity, rate, or 5xx\\n# refusal), and returned (a build's head a required check rejected, or a\\n# review that returned a blocking finding). Every other non-pass record\\n# is a person's, once counsel has read it.\\nRETRYABLE_CLASSES = (\\\"died\\\", \\\"hung\\\", \\\"transient\\\", \\\"returned\\\")\\n\\n\\ndef signature_of(text: str | None) -> str | None:\\n    \\\"\\\"\\\"R3: a failure's signature -- the text a script compares by\\n    equality between two attempts, with every run of digits removed, so\\n    a retry-after, a pid, or a timestamp never keeps two otherwise\\n    identical failures from matching. None for None or empty text.\\\"\\\"\\\"\\n    if not text:\\n        return None\\n    stripped = re.sub(r\\\"[0-9]+\\\", \\\"\\\", text).strip()\\n    return stripped or None\\n\\n\\ndef stage_exhausted(records_dir: Path, m: dict[str, Any], sig_stage: str, budget_stage: str) -> bool:\\n    \\\"\\\"\\\"R3: whether a retryable stop on sig_stage is exhausted -- its own\\n    last two attempts carry the identical signature (the early stop), or\\n    budget_stage has already spent [drive].attempts. sig_stage and\\n    budget_stage differ only for class \\\"returned\\\": the signature lives on\\n    the verify record the check rejection wrote, but the budget it spends\\n    is the build attempts the retry itself starts.\\\"\\\"\\\"\\n    from attavo.doctor import attempts_budget\\n    from attavo.records import next_attempt_number\\n    attempts = parse_attempts(records_dir, sig_stage)\\n    if len(attempts) >= 2:\\n        nums = sorted(attempts)\\n        sig_last = (attempts[nums[-1]].get(\\\"stop\\\") or {}).get(\\\"signature\\\")\\n        sig_prev = (attempts[nums[-2]].get(\\\"stop\\\") or {}).get(\\\"signature\\\")\\n        if sig_last is not None and sig_last == sig_prev:\\n            return True\\n    return next_attempt_number(records_dir, budget_stage) - 1 >= attempts_budget(m)\\n\\n\\nSTOP_PROVENANCES = (\\\"product\\\", \\\"tenant\\\", \\\"executor\\\", \\\"spec\\\")\\n\\n# Beyond the enum spelling itself, the prose issue #88 actually shipped\\n# (adapters/claude-code/run and adapters/codex/run, on main since\\n# v0.16.0) once put a class's own name, or a real specimen's wording of\\n# it, in the transcript for the generic match below to find. Issue #94\\n# moves non-question and outlived-invocation onto report_class instead\\n# (below): non-question's own halt line (\\\"halted: class non-question\\\")\\n# would otherwise still satisfy the bare-name match here with no adapter\\n# report-line field involved at all, and outlived-invocation's refusal\\n# never named its class in text to begin with, so both are disabled here\\n# -- the same pattern issue #93 established for ceiling, just below,\\n# rather than removed outright.\\nCLASS_TEXT_MARKERS: dict[str, tuple[str, ...]] = {\\n    \\\"non-question\\\": (),\\n    \\\"outlived-invocation\\\": (),\\n    # Issue #93: ceiling's own text-based check is CEILING_MARKERS, below,\\n    # with provenance \\\"product\\\" -- a fact about the tool, not an executor\\n    # judgment like non-question/outlived-invocation are. Left at the\\n    # default (the class's own name, \\\"ceiling\\\"), the generic match above\\n    # would instead catch adapters/codex/run's and\\n    # adapters/claude-code/run's own pre-emptive refusal -- which must\\n    # carry the word \\\"ceiling\\\" by the same issue's own brief -- as\\n    # provenance \\\"executor\\\", before CEILING_MARKERS is ever consulted.\\n    \\\"ceiling\\\": (),\\n    # R3: transient is read from the adapter's own report line\\n    # (derive_stop's report_class), returned is written by the product\\n    # itself from a forge read or a blocking finding, never scanned for\\n    # in text -- a retried attempt's feedback file names the prior stop's\\n    # class by spelling, and that text reaches the transcript, which the\\n    # generic match below would otherwise catch as executor provenance.\\n    \\\"transient\\\": (),\\n    \\\"returned\\\": (),\\n    # A genuine question (issue #100's own followups) is read structurally\\n    # -- status \\\"halted\\\" carrying a non-empty halted.question -- not by\\n    # scanning for the literal word \\\"question\\\", which the question's own\\n    # text very often contains regardless of what it is actually asking.\\n    # Left at the default, the generic match above would misclassify any\\n    # question that happens to use the word \\\"question\\\" as executor\\n    # provenance, before the structural check in derive_stop is reached.\\n    \\\"question\\\": (),\\n    # environment/tenant (issue #115) is set directly by cmd_build's own\\n    # preflight -- the one caller who knows a [checks].command exited 2\\n    # on the approved tree -- never derived from adapter text. Left at\\n    # the default, the generic match above would catch the word\\n    # \\\"environment\\\" anywhere in a log or refusal (e.g. codex's own\\n    # OPENAI_API_KEY auth-mismatch refusal, adapters/codex/run's\\n    # check_auth) as an environment/executor stop that never happened.\\n    \\\"environment\\\": (),\\n}\\n\\n# Known tool error text for a declared ceiling -- issue #86's own specimen\\n# (codex's \\\"Input exceeds...\\\" line on a diff too large to judge) is\\n# \\\"input_too_large\\\"; a matching line anywhere in the log, not only its\\n# last line, since cmd_build and cmd_verify both append \\\"[adapter exited\\n# N]\\\" after whatever the tool itself printed. \\\"ceiling exceeded\\\" is issue\\n# #93's own addition: both adapters now refuse pre-emptively, before the\\n# tool is ever invoked, against a declared or fixed input limit, and\\n# their refusal text is not caught by any of the three markers above.\\nCEILING_MARKERS = (\\\"input_too_large\\\", \\\"exceeds the maximum context length\\\",\\n                  \\\"context_length_exceeded\\\", \\\"ceiling exceeded\\\")\\n\\n\\n# Issue #100's followups: an unclassed detail is the log's last line\\n# verbatim, and that line is sometimes an adapter's own event JSON or a\\n# tool's full error text -- thousands of characters wide. Capped here,\\n# at write time, so a filed issue's own summary of it (file-stops'\\n# log_tail already carries the full picture) stays short; the class\\n# itself, \\\"unclassed\\\", already says the full explanation lives in the\\n# log, not in this field.\\nUNCLASSED_DETAIL_MAX_CHARS = 200\\n\\n\\ndef _log_last_line(log: str | None) -> str:\\n    lines = [l for l in (log or \\\"\\\").splitlines() if l.strip()]\\n    last = lines[-1] if lines else \\\"\\\"\\n    return last[:UNCLASSED_DETAIL_MAX_CHARS]\\n\\n\\ndef _carries_a_known_class(text: str | None) -> str | None:\\n    \\\"\\\"\\\"Whichever of STOP_CLASSES this text names -- its own spelling, or\\n    one of CLASS_TEXT_MARKERS' real-world phrasings of it, when that\\n    class is not disabled there -- or None. Issue #88 is where an\\n    adapter's own halt or refusal first named its class this way; issue\\n    #93 added ceiling's own pre-emptive refusal to that set and disabled\\n    its bare-name match (CEILING_MARKERS covers it instead); issue #94\\n    disables non-question and outlived-invocation the same way, reading\\n    both from the adapter's own report line (derive_stop's report_class)\\n    now instead.\\\"\\\"\\\"\\n    text = text or \\\"\\\"\\n    for name in STOP_CLASSES:\\n        markers = CLASS_TEXT_MARKERS.get(name, (name,))\\n        if any(marker in text for marker in markers):\\n            return name\\n    return None\\n\\n\\ndef derive_stop(status: str, *, refusal: str | None = None, halted: dict[str, Any] | None = None,\\n                log: str | None = None, report_class: str | None = None,\\n                refusal_provenance: str | None = None) -> Stop | None:\\n    \\\"\\\"\\\"The stop field for a build or verify record: None for status \\\"pass\\\",\\n    else {class, provenance, detail} from what the caller already knows.\\n\\n      - report_class -- payload.get(\\\"class\\\") off the adapter's own report\\n        line (issue #88, #94), when it names a STOP_CLASSES member -- is\\n        that class, provenance \\\"executor\\\". build.schema.json and\\n        verify.schema.json stay untouched by issue #88 on purpose, so the\\n        class lives only on the report line, never a structured field\\n        cmd_build or cmd_verify forwards on its own account; the caller\\n        reads payload itself and passes this in, since only it still has\\n        payload once an iteration ends. This is non-question's and\\n        outlived-invocation's only path to a record now (issue #94):\\n        CLASS_TEXT_MARKERS disables both for the text scan below, the\\n        same way issue #93 disabled ceiling's bare-name match there. A\\n        class an adapter does not yet put on its report line --\\n        outlived-invocation today, since that refusal path prints no\\n        report line at all -- falls to unclassed below, same as any\\n        other unnamed cause, until the adapter that raises it puts a\\n        class on the line the way non-question already does.\\n      - a halt carrying a non-empty halted.question, once it is not a\\n        non-question caught above, is a genuine question -- question/spec,\\n        with the question's own first line as detail (issue #100's\\n        followups). This is the specimen issue #100 itself was built to\\n        retire: tenant zero's #663 build-01, a proper question, classed\\n        unclassed/product and filed as a product defect with the wrong\\n        provenance -- a question is about the definition of done, which is\\n        a person's or a ruling's to answer, never the product's own\\n        mechanism.\\n      - failing that, a refusal or the log itself that already names its\\n        class in text (issue #88, #93 for ceiling's own pre-emptive\\n        refusal) is that class, provenance \\\"executor\\\" -- the log is\\n        checked because neither adapter's refusal *field* carries the\\n        class today; the class-naming line each adapter prints reaches\\n        only the transcript\\n      - a refusal that is not that -- the write-outside-claims path\\n        itself, not the \\\"commit ... not authored by the executor\\\" shape\\n        -- is claims-boundary/spec, unless the caller already knows this\\n        refusal touched paths.records or paths.specs (issue #140:\\n        protected_path_touched, checked ahead of the ordinary claims\\n        match in cmd_build) and passes refusal_provenance=\\\"executor\\\" --\\n        the product's own directories are not a claim a spec makes, so a\\n        refusal there is not the spec's boundary to answer for\\n      - a returned verify (the forge was not green; no adapter ran) is\\n        forge-unconcluded/tenant\\n      - an adapter exit whose log carries a declared-ceiling error line is\\n        ceiling/product\\n      - anything else is unclassed/product, with the log's last line\\n        (capped at UNCLASSED_DETAIL_MAX_CHARS) as its detail -- the other\\n        class that carries a detail, since every remaining class's\\n        evidence already lives in refusal, halted, forge_checks, or the\\n        log itself.\\n    \\\"\\\"\\\"\\n    if status == \\\"pass\\\":\\n        return None\\n    if status == \\\"returned\\\":\\n        return {\\\"class\\\": \\\"forge-unconcluded\\\", \\\"provenance\\\": \\\"tenant\\\", \\\"detail\\\": None}\\n    if report_class in STOP_CLASSES:\\n        return {\\\"class\\\": report_class, \\\"provenance\\\": \\\"executor\\\", \\\"detail\\\": None}\\n    question = (halted or {}).get(\\\"question\\\")\\n    if status == \\\"halted\\\" and question:\\n        return {\\\"class\\\": \\\"question\\\", \\\"provenance\\\": \\\"spec\\\",\\n               \\\"detail\\\": question.splitlines()[0]}\\n    known = _carries_a_known_class(refusal) or _carries_a_known_class(log)\\n    if known:\\n        return {\\\"class\\\": known, \\\"provenance\\\": \\\"executor\\\", \\\"detail\\\": None}\\n    if status == \\\"refused\\\" and refusal is not None and not refusal.startswith(\\\"commit \\\"):\\n        return {\\\"class\\\": \\\"claims-boundary\\\", \\\"provenance\\\": refusal_provenance or \\\"spec\\\",\\n               \\\"detail\\\": None}\\n    if log and any(marker in log.lower() for marker in CEILING_MARKERS):\\n        return {\\\"class\\\": \\\"ceiling\\\", \\\"provenance\\\": \\\"product\\\", \\\"detail\\\": None}\\n    return {\\\"class\\\": \\\"unclassed\\\", \\\"provenance\\\": \\\"product\\\", \\\"detail\\\": _log_last_line(log)}\\n\\n\\ndef gate_stop(refusal: str | None) -> Stop:\\n    \\\"\\\"\\\"The stop for a refused spec-gate record: class \\\"gate\\\", provenance\\n    \\\"spec\\\", the refusal string itself as cause (issue #137) -- not\\n    derive_stop's generic claims-boundary/spec fallback issue #133\\n    reused, which named a boundary the record never crossed: \\\"criterion\\n    fails against the tree plus stub: doctor-template-absent.sh\\\" is not\\n    try:\\n        rc = cmd_build([item_id]) if stage == \\\"build\\\" else cmd_verify([item_id])\\n    finally:\\n        stop_beat.set()\\n        beat_thread.join()\\n\\n    after = latest_attempt_path(records_dir, stage)\\n    if after is None or after == before:\\n        # Refused before writing anything at all (e.g. no adapter\\n        # configured) -- the stage command already printed why.\\n        return rc if rc != 0 else 1\\n\\n    record = cast(dict[str, Any], latest_record(records_dir, stage))\\n    status_out = record.get(\\\"status\\\")\\n    to_commit = [after]\\n    if status_out != \\\"pass\\\":\\n        # R3: a retryable family (died, hung, transient, returned) asks\\n        # counsel nothing while its budget still has an attempt to\\n        # spend -- the next pass retries it plainly. Once its budget is\\n        # spent, or its last two signatures match, counsel is read once\\n        # more, its sentence carried beside the exhaustion report, never\\n        # instead of it. Every other class is counsel's to read on every\\n        # stop, as before this item -- unless the immediately preceding\\n        # attempt of this stage already carried the identical detail and\\n        # was already counseled: asking counsel the same question twice\\n        # in a row would only spend a second invocation on the same\\n        # answer, so this one is a person's now, not counsel's again.\\n        stop_class = (record.get(\\\"stop\\\") or {}).get(\\\"class\\\")\\n        budget_stage = \\\"build\\\" if stop_class == \\\"returned\\\" else stage\\n        if stop_class in RETRYABLE_CLASSES:\\n            ask_counsel = stage_exhausted(records_dir, m, stage, budget_stage)\\n        else:\\n            detail = (record.get(\\\"stop\\\") or {}).get(\\\"detail\\\")\\n            prior = parse_attempts(records_dir, stage).get(nn - 1) if nn > 1 else None\\n            already_read = (prior is not None and signature_of(detail) is not None\\n                           and signature_of(detail) == signature_of((prior.get(\\\"stop\\\") or {}).get(\\\"detail\\\"))\\n                           and counsel_record_for(records_dir, stage, nn - 1) is not None)\\n            ask_counsel = not already_read\\n        counsel_before = latest_attempt_path(records_dir, \\\"counsel\\\")\\n        if ask_counsel:\\n            cmd_counsel([item_id])\\n        counsel_after = latest_attempt_path(records_dir, \\\"counsel\\\")\\n        if counsel_after is not None and counsel_after != counsel_before:\\n            to_commit.append(counsel_after)\\n        # file-stops is its own idempotent read of the item's records, so\\n        # calling it here on every run that wrote a non-pass record is\\n        # safe to call again on a later run: an already-filed stop's own\\n        # marker is what stops it from being filed twice.\\n        cmd_file_stops([item_id])\\n\\n    message = f\\\"attavo: {stage} record for item {item_id} ({after.stem})\\\"\\n    try:\\n        commit_record(root, to_commit, message)\\n    except RuntimeError as exc:\\n        print(f\\\"attavo drive: stopped: could not commit the {stage} record: {exc}\\\")\\n        return 1\\n\\n    if has_origin(root):\\n        ok, err = push_record_commit(root, branch)\\n        if not ok:\\n            print(f\\\"attavo drive: stopped: could not push the {stage} record: {err}\\\")\\n            return 1\\n    else:\\n        print(f\\\"attavo drive: note: no origin remote; {after.name} is committed, not pushed\\\")\\n\\n    if status_out == \\\"halted\\\":\\n        question = (record.get(\\\"halted\\\") or {}).get(\\\"question\\\")\\n        print(f\\\"attavo drive: stopped: {stage} halted: {question} ({after.name}); \\\"\\n              f\\\"pushed to {branch}\\\")\\n    elif status_out != \\\"pass\\\":\\n        reason = record.get(\\\"refusal\\\") or status_out\\n        print(f\\\"attavo drive: stopped: {stage} {status_out}: {reason} ({after.name}); \\\"\\n              f\\\"pushed to {branch}\\\")\\n    else:\\n        print(f\\\"attavo drive: pushed {after.name} to {branch}\\\")\\n    return rc\\n\\n\\ndef cmd_worker(argv: list[str]) -> int:\\n    \\\"\\\"\\\"`attavo worker N <build|verify> NN`: the detached child a pass\\n    starts once its marker is pushed -- the lease held, the attempt is\\n            print(\\\"attavo drive: --again is a no-op inside the budget; the pass retries on its own\\\")\\n            return 0\\n    return _advance_again(root, m, item_id, stage, r[\\\"head\\\"], again_by=True)\\n\\n\\ndef _counsel_answered(records_dir: Path, r: \\\"DriveReport\\\") -> bool:\\n    \\\"\\\"\\\"R3: whether the stop this report just read as \\\"stopped\\\" already\\n    carries counsel's own \\\"answer\\\" verdict -- every non-retryable class\\n    is counsel's to read (as before this item), and `answer` starts the\\n    next attempt with the answer as its steer, read from the feedback\\n    file the retried attempt's own first iteration is handed\\n    (attavo.build._retry_seed).\\\"\\\"\\\"\\n    if r[\\\"stop_class\\\"] in RETRYABLE_CLASSES or not r[\\\"stage\\\"] or r[\\\"attempt\\\"] is None:\\n        return False\\n    counsel = counsel_record_for(records_dir, r[\\\"stage\\\"], r[\\\"attempt\\\"])\\n    return counsel is not None and counsel.get(\\\"verdict\\\") == \\\"answer\\\"\\n\\n\\ndef _pass_once(root: Path, m: dict[str, Any], item_id: str, again: bool) -> tuple[int, \\\"DriveReport\\\"]:\\n    \\\"\\\"\\\"One pass: fast-forward to origin (never while a worker holds the\\n    copy), read the report, act at most once, return. The three acts,\\n    one per report state that is the product's move: owes-recovery\\n    recovers; next-build and next-review start their stage, handing a\\n    review the checks the report already read once on the pre-marker\\n    head; a concluded red check on a passed build's head (R3) is a\\n    returned review record, not a level, so the review starts the same\\n    way. On a stopped stage, `--again` always wins (a no-op inside the\\n    budget, the next attempt once it is spent); absent it, a retryable\\n    family retries on its own, and any other stop counsel has already\\n    answered starts the next attempt steered by that answer. Every other\\n    level is printed in the report's own words and left.\\\"\\\"\\\"\\n    from attavo.report import drive_report\\n    fast_forward_to_origin(root, m, item_id)\\n    r = drive_report(root, m, item_id)\\n\\n    if r[\\\"state\\\"] == \\\"owes-recovery\\\":\\n        records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n        return _recover_one(root, m, item_id, records_dir), r\\n    if r[\\\"state\\\"] == \\\"next-build\\\":\\n        return _start_stage(root, m, item_id, \\\"build\\\", None), r\\n    if r[\\\"state\\\"] == \\\"next-review\\\":\\n        checks_command = (m.get(\\\"forge\\\") or {}).get(\\\"checks_command\\\")\\n        forge_checks = {\\\"command\\\": checks_command, \\\"sha\\\": r[\\\"head\\\"], \\\"conclusions\\\": r[\\\"checks\\\"] or []}\\n        return _start_stage(root, m, item_id, \\\"verify\\\", forge_checks), r\\n    if r[\\\"state\\\"] == \\\"blocked-on-checks\\\" and r[\\\"stage\\\"] == \\\"verify\\\":\\n        # R3: the rejection is a record, not a level with nothing behind\\n        # it (#206's build-01) -- the review starts, reading the same\\n        # forge checks this pass just read, and writes the check\\n        # rejection itself as a returned record (attavo.verify.cmd_verify).\\n        checks_command = (m.get(\\\"forge\\\") or {}).get(\\\"checks_command\\\")\\n        forge_checks = {\\\"command\\\": checks_command, \\\"sha\\\": r[\\\"head\\\"], \\\"conclusions\\\": r[\\\"checks\\\"] or []}\\n        return _start_stage(root, m, item_id, \\\"verify\\\", forge_checks), r\\n    if r[\\\"state\\\"] == \\\"stopped\\\" and r[\\\"stage\\\"]:\\n        if again:\\n            return _handle_again(root, m, item_id, r), r\\n        records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n        if _retry_due(root, m, item_id, r):\\n            return _advance_again(root, m, item_id, _retry_target(r), r[\\\"head\\\"]), r\\n        if _counsel_answered(records_dir, r):\\n            return _advance_again(root, m, item_id, _retry_target(r), r[\\\"head\\\"]), r\\n\\n    print(f\\\"attavo drive: {r['says']}\\\")\\n    return (1 if r[\\\"state\\\"] == \\\"refused\\\" else 0), r\\n\\n\\n_TERMINAL_STATES = (\\\"waiting-on-approval\\\", \\\"stopped\\\", \\\"ready-to-merge\\\", \\\"merged\\\")\\n\\n\\ndef _until_ready(root: Path, m: dict[str, Any], item_id: str, again: bool) -> int:\\n    \\\"\\\"\\\"--until-ready: the pass, repeated in one process, sleeping\\n    ATTAVO_DRIVE_POLL_INTERVAL_S between passes, until the level is the\\n# Rulings\\n\\nWritten by the merge of a proposed amendment only.\\n1:diff --git a/attest/records/219/approval-01.json b/attest/records/219/approval-01.json\\n6:@@ -0,0 +1,10 @@\\n17:diff --git a/attest/records/219/build-01.started b/attest/records/219/build-01.started\\n22:@@ -0,0 +1,7 @@\\n30:diff --git a/attest/records/219/spec-01.json b/attest/records/219/spec-01.json\\n35:@@ -0,0 +1,39 @@\\n75:diff --git a/attest/specs/219/criteria/a-red-check-becomes-a-returned-record-and-the-next-build-is-handed-its-log.sh b/attest/specs/219/criteria/a-red-check-becomes-a-returned-record-and-the-next-build-is-handed-its-log.sh\\n80:@@ -0,0 +1,117 @@\\n101:+    echo '{\\\"status\\\":\\\"done\\\",\\\"question\\\":null,\\\"model\\\":\\\"fixture\\\",\\\"model_version\\\":null,\\\"adapter_version\\\":\\\"fixture-1\\\",\\\"tokens\\\":{\\\"input\\\":1,\\\"output\\\":1},\\\"cost_usd\\\":0.0}'\\n127:+retry_after_s = 1\\n190:+show records/1/build-02.json | python3 -c 'import sys,json; r=json.load(sys.stdin); assert r[\\\"status\\\"] == \\\"pass\\\", r[\\\"status\\\"]; assert r.get(\\\"retry_of\\\") == \\\"build-01\\\", r.get(\\\"retry_of\\\")'\\n198:diff --git a/attest/specs/219/criteria/a-stage-past-its-ceiling-is-hung-by-the-ceiling.sh b/attest/specs/219/criteria/a-stage-past-its-ceiling-is-hung-by-the-ceiling.sh\\n203:@@ -0,0 +1,95 @@\\n232:+retry_after_s = 1\\n299:diff --git a/attest/specs/219/criteria/a-transient-stop-retries-plainly.sh b/attest/specs/219/criteria/a-transient-stop-retries-plainly.sh\\n304:@@ -0,0 +1,80 @@\\n319:+  echo '{\\\"status\\\":\\\"failed\\\",\\\"question\\\":null,\\\"class\\\":\\\"transient\\\",\\\"detail\\\":\\\"API error: overloaded, retry after 30s\\\",\\\"model\\\":\\\"fixture\\\",\\\"model_version\\\":null,\\\"adapter_version\\\":\\\"fixture-1\\\",\\\"tokens\\\":{\\\"input\\\":1,\\\"output\\\":1},\\\"cost_usd\\\":0.0}'\\n332:+retry_after_s = 1\\n381:+show records/1/build-02.json | python3 -c 'import sys,json; r=json.load(sys.stdin); assert r[\\\"status\\\"] == \\\"pass\\\", r[\\\"status\\\"]; assert r.get(\\\"retry_of\\\") == \\\"build-01\\\", r.get(\\\"retry_of\\\")'\\n385:diff --git a/attest/specs/219/criteria/the-manifest-and-the-tests-exist.sh b/attest/specs/219/criteria/the-manifest-and-the-tests-exist.sh\\n390:@@ -0,0 +1,84 @@\\n411:+retry_after_s = 1\\n468:+for t in test_a_transient_stop_retries_plainly_after_the_wait test_died_and_hung_retry_on_the_next_pass test_a_red_check_becomes_a_returned_record_with_the_log_as_evidence test_a_returned_review_retries_with_its_findings_and_counsels_on_the_second test_counsels_verdict_routes_the_next_pass test_a_persons_stop_is_never_retried test_identical_failures_stop_early_and_the_budget_holds test_every_marker_spends_the_budget test_a_stage_past_its_ceiling_is_hung_by_the_ceiling test_again_resets_a_spent_budget_only test_adapters_class_transient\\n470:+  grep -q \\\"^def $t(\\\" tests/test_retry.py\\n475:diff --git a/attest/specs/219/criteria/two-identical-failures-stop-at-two-and-the-report-compares-them.sh b/attest/specs/219/criteria/two-identical-failures-stop-at-two-and-the-report-compares-them.sh\\n480:@@ -0,0 +1,106 @@\\n511:+retry_after_s = 1\\n587:diff --git a/attest/specs/219/spec.md b/attest/specs/219/spec.md\\n592:@@ -0,0 +1,64 @@\\n597:+This is R3 of the reconciler (`claude/reconciler-brief-2026-09-20.md`, ruling C with its two amendments, section 6; the nine rulings of 2026-09-25 recorded in `claude/r3-rulings-2026-09-25.md`). It adds the retry families, one budget, the early stop, the exhaustion report, the stage ceilings, and the input the next attempt is handed; it retires the operator as the only thing that ever runs a stage twice.\\n599:+The families. A stage record that is not a pass belongs to one of four retryable families or to a person. `died` and `hung` (recovery's classes, unchanged) and `transient` (new: a vendor's capacity, rate, or 5xx refusal, classed by the adapter on its report line as every class is) retry plainly: the next pass starts the next attempt, asks counsel nothing, and a `transient` waits `[drive].retry_after_s` (default 300) from its record before the attempt starts, the report reading \\\"retrying build in N s\\\" meanwhile. `returned` (new) is a build whose head a required check rejected, or a build whose review returned a blocking finding (a finding whose `severity` is `blocking` makes the review's status `failed` with class `returned`; every other severity leaves the review a pass and is filed as today): the pass writes the check rejection as a returned review record the moment the report reads a concluded red check on a passed build's head (class `returned`, provenance tenant, no adapter run — the shape `attavo verify` already writes for a forge that is not green), so the rejection is a record and not a level; the next build attempt is handed the evidence; counsel is asked only when the second attempt ends with the same signature. Every other non-pass record is read by counsel as today, and counsel's verdict routes: `answer` starts the next attempt with the answer as its steer; `patch` files and the report reads \\\"waiting on #N\\\"; `person` is the operator's. A question, a claims-boundary stop, a tenant's gate refusal, and an environment refusal are never retried by this item; environment refusal is recorded here and acted on by R4's breaker.\\n605:+The next attempt's input. The product already hands an attempt a feedback file (`ATTAVO_FEEDBACK`), empty on a first iteration. A retried attempt's first iteration starts with that file carrying, in this order and only the parts that exist: the prior attempt's class and signature; the evidence (the failing check's log read through `[forge].check_log_command`, or the review's blocking findings); and the newest steer newer than the blocking record (counsel's `answer` text now; an operator's ruling after R4), with the record it came from named. The attempt's record carries `retry_of` (the prior attempt's stem) and `steer` (the counsel record's stem, or null). No new adapter input, no new environment variable: one file the contract already passes.\\n607:+Ceilings. `[drive.build].ceiling_s` and `[drive.verify].ceiling_s`, wall clock from the marker's `at`. A worker alive past its stage's ceiling is terminated by the next pass and recorded `hung` with `stop.bound = \\\"ceiling\\\"`. An adapter whose `conformance.json` declares `\\\"streams_events\\\": false` is judged by the ceiling alone; its report never says \\\"no event for N s\\\". The doctor refuses a manifest that sets `[drive]` without both ceilings and `attempts`, as it refuses one without `stall_after_s`. The self-tenant declares build 2,400 s, verify 1,200 s, attempts 3, retry_after_s 300; the manifest schema carries the keys.\\n611:+Not in this item: retrying on a different executor; any wait other than the one fixed `retry_after_s`; the breaker; rulings as records.\\n613:+The stub under `stub/` is thin: the two classes and the signature, the schema keys, the doctor's refusal, a pass that retries the four families inside the budget with the early stop and the transient wait, the returned record on a red check with its log handed to the next build, and the ceiling. It has no steer, no blocking-finding return, no transient wait in the report's words, no `--again` narrowing, no adapter classification, and no updates to the existing tests the stop shape and the doctor's refusal break. Ten of the eleven tests in `tests/test_retry.py` are red on the tree; five are red on the stub, listed in the issue. `python3 -m mypy` exits 0 on the built tree with no `type: ignore`.\\n637:+- tests/test_retry.py\\n652:+- a-transient-stop-retries-plainly.sh: on a fixture tenant whose build adapter refuses once with the vendor's capacity error and passes on its second run, passes alone carry the item from an approved spec to a passing build-02 whose retry_of is build-01, build-01's stop class is transient, and no counsel record exists\\n656:+- the-manifest-and-the-tests-exist.sh: the doctor refuses a fixture manifest with a [drive] table and no ceilings, and tests/test_retry.py carries the tests named\\n657:diff --git a/attest/specs/219/stub/attavo.toml b/attest/specs/219/stub/attavo.toml\\n662:@@ -0,0 +1,65 @@\\n714:+command = \\\"python3 -m mypy\\\"\\n715:+probe = \\\"python3 -c 'import pytest, mypy, jsonschema'\\\"\\n721:+retry_after_s = 300\\n728:diff --git a/attest/specs/219/stub/attavo/build.py b/attest/specs/219/stub/attavo/build.py\\n733:@@ -0,0 +1,576 @@\\n937:+def _retry_seed(root: Path, m: dict[str, Any], records_dir: Path) -> tuple[str | None, str]:\\n1112:+        retry_of, seed = _retry_seed(root, m, item_records_dir)\\n1258:+                feedback_lines += [f\\\"test run exit {test_run.returncode}\\\",\\n1291:+        \\\"retry_of\\\": retry_of,\\n1310:diff --git a/attest/specs/219/stub/attavo/doctor.py b/attest/specs/219/stub/attavo/doctor.py\\n1315:@@ -0,0 +1,831 @@\\n1565:+def retry_after_s(m: dict[str, Any]) -> int:\\n1566:+    \\\"\\\"\\\"R3: [drive].retry_after_s, the wait before a transient stop's next\\n1568:+    value = (m.get(\\\"drive\\\") or {}).get(\\\"retry_after_s\\\")\\n2147:diff --git a/attest/specs/219/stub/attavo/drive.py b/attest/specs/219/stub/attavo/drive.py\\n2152:@@ -0,0 +1,829 @@\\n2176:+    retry_after_s,\\n2247:+    commit just wrote already names. This is the record push's own retry\\n2261:+        return False, f\\\"push rejected and the retry merge failed: {pull.stderr.strip() or err}\\\"\\n2274:+    no retry: this is the lease the marker commit takes on the attempt it\\n2553:+    --only`, one push with the record push's own merge retry. The\\n2659:+    fast-forward with no merge and no retry (push_lease). Lost to another\\n2712:+    own merge retry) -- this is not a race for a lease, since no new\\n2758:+                   \\\"retry_of\\\": None, \\\"steer\\\": None,\\n2808:+def _retry_due(root: Path, m: dict[str, Any], item_id: str, r: \\\"DriveReport\\\") -> bool:\\n2809:+    \\\"\\\"\\\"R3 (stub): a stopped stage whose class is retryable, whose budget is\\n2811:+    whose record is older than retry_after_s, is retried by this pass.\\\"\\\"\\\"\\n2830:+        if age is not None and age < retry_after_s(m):\\n2856:+    if r[\\\"state\\\"] == \\\"stopped\\\" and r[\\\"stage\\\"] and _retry_due(root, m, item_id, r):\\n2982:diff --git a/attest/specs/219/stub/attavo/report.py b/attest/specs/219/stub/attavo/report.py\\n2987:@@ -0,0 +1,268 @@\\n3256:diff --git a/attest/specs/219/stub/attavo/stops.py b/attest/specs/219/stub/attavo/stops.py\\n3261:@@ -0,0 +1,374 @@\\n3282:+STOP_CLASSES = (\\\"non-question\\\", \\\"outlived-invocation\\\", \\\"no-cause\\\", \\\"forge-unconcluded\\\",\\n3294:+    that differ only in a retry-after, a pid, or a timestamp match.\\\"\\\"\\\"\\n3305:+# moves non-question and outlived-invocation onto report_class instead\\n3306:+# (below): non-question's own halt line (\\\"halted: class non-question\\\")\\n3313:+
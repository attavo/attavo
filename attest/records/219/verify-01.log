 | tail -200\\\",\\\"uuid\\\":\\\"486d501f-0480-465c-8d70-3bb93166e569\\\",\\\"session_id\\\":\\\"ac4fb82d-7667-4afa-b9e0-dc09bb237f8a\\\"}\\n  2082\\tadapters/claude-code/run: halted: class non-question -- the executor reported instead of asking, twice in a row   250\\t        \\\"The stub is the fixture the acceptance criteria were shown to \\\"\\n   251\\t        \\\"pass against; it is not the intended change. A difference \\\"\\n   252\\t        \\\"between the built tree and the stub is not a finding: a \\\"\\n   253\\t        \\\"criterion the stub satisfies trivially is.\\\")\\n   254\\t\\n   255\\t\\n   256\\tdef build_instruction() -> str:\\n   257\\t    parts = list(spec_sections())\\n   258\\t\\n   259\\t    rulings = read_text(\\\"ATTAVO_RULINGS\\\")\\n   260\\t    if rulings.strip():\\n   261\\t        parts.append(\\\"## Rulings\\\\n\\\\n\\\" + rulings.strip())\\n   262\\t\\n   263\\t    feedback_path = os.environ.get(\\\"ATTAVO_FEEDBACK\\\")\\n   264\\t    feedback = read_text(\\\"ATTAVO_FEEDBACK\\\")\\n   265\\t    if feedback.strip():\\n   266\\t        parts.append(\\n   267\\t            \\\"## Feedback from the previous attempt\\\\n\\\\n\\\"\\n   268\\t            f\\\"The feedback is at {describe_file(feedback_path, feedback, diff_like=False)}. \\\"\\n   269\\t            \\\"It is not inlined here: read it yourself with your own tools \\\"\\n   270\\t            \\\"before continuing.\\\")\\n   271\\t\\n   272\\t    parts.append(\\n   273\\t        \\\"commit your work on the current branch; if you cannot proceed \\\"\\n   274\\t        \\\"without a decision that changes the criteria, do not guess: \\\"\\n   275\\t        \\\"answer with status question\\\")\\n   276\\t\\n   277\\t    test_command = os.environ.get(\\\"ATTAVO_TEST_COMMAND\\\")\\n   278\\t    if test_command:\\n   279\\t        bound = os.environ.get(\\\"ATTAVO_TEST_TIMEOUT_S\\\")\\n   280\\t        parts.append(\\n   281\\t            f\\\"to run tests while you work, run `{test_command}`: it runs the tests \\\"\\n   282\\t            \\\"selected for the files you have changed\\\"\\n   283\\t            + (f\\\" and stops at {bound} s\\\" if bound else \\\"\\\")\\n   284\\t            + \\\". Do not run the whole test suite or any whole-tree check yourself: \\\"\\n   285\\t            \\\"after you commit, the gates are run for you and any failure is \\\"\\n   620\\t\\n   621\\t\\n   622\\tMIN_QUESTION_CHARS = 40\\n   623\\t\\n   624\\tREINSTRUCTION = (\\n   625\\t    \\\"your last answer was a report, not a question; either continue to \\\"\\n   626\\t    \\\"done, or ask one question ending in a question mark that names the \\\"\\n   627\\t    \\\"spec line or guard you cannot resolve\\\")\\n   628\\t\\n   629\\t\\n   630\\tdef question_class(status: str, question: str | None) -> str:\\n   631\\t    \\\"\\\"\\\"\\\"done\\\" (no halt at all), \\\"fail\\\" (a question too short or absent to\\n   632\\t    be worth a person's judgment -- MIN_QUESTION_CHARS, unchanged since\\n   633\\t    v0.15.0), \\\"report\\\" (long enough but carries no \\\"?\\\" -- issue #88's\\n   634\\t    class A, a status update in the question channel), or \\\"question\\\" (a\\n   635\\t    real question).\\\"\\\"\\\"\\n  1010\\t        if exit_code2 is not None:\\n  1011\\t            return exit_code2\\n  1012\\t        if response2.get(\\\"is_error\\\") or not response2.get(\\\"structured_output\\\"):\\n  1013\\t            return 1\\n  1014\\t        refusal2 = subagent_refusal(response2)\\n  1015\\t        if refusal2:\\n  1016\\t            sys.stderr.write(refusal2 + \\\"\\\\n\\\")\\n  1017\\t            return 1\\n  1018\\t\\n  1019\\t        structured2 = response2.get(\\\"structured_output\\\") or {}\\n  1020\\t        status2 = structured2.get(\\\"status\\\", \\\"done\\\")\\n  1021\\t        question2 = structured2.get(\\\"question\\\")\\n  1022\\t        cls2 = question_class(status2, question2)\\n  1023\\t        if cls2 == \\\"fail\\\":\\n  1024\\t            return 1\\n  1025\\t\\n  1026\\t        common2 = report_fields(response2, config.get(\\\"model\\\"))\\n  1027\\t        if common2 is None:\\n  1028\\t            return 1\\n  1029\\t        # A non-question costs two executor turns, not one: sum both\\n  1030\\t        # calls' tokens and cost into the one report line this\\n  1031\\t        # invocation gets, whatever the retry's own outcome -- only\\n  1032\\t        # adapter_version/model/model_version stay the second call's.\\n  1033\\t        tokens1_input, tokens1_output, cost1 = usage_fields(response)\\n  1034\\t        common2[\\\"tokens\\\"][\\\"input\\\"] += tokens1_input\\n  1035\\t        common2[\\\"tokens\\\"][\\\"output\\\"] += tokens1_output\\n  1036\\t        common2[\\\"cost_usd\\\"] = add_cost(common2[\\\"cost_usd\\\"], cost1)\\n  1037\\t\\n  1038\\t        if cls2 == \\\"report\\\":\\n  1039\\t            # Two reports in a row: still a halt (someone must look),\\n  1040\\t            # but the transcript above already carries both raw\\n  1041\\t            # results, and this report line names the class so a\\n  1042\\t            # reader -- or a future record field, not this one -- can\\n  1043\\t            # tell it apart from a genuine question.\\n  1044\\t            print(\\\"adapters/claude-code/run: halted: class non-question \\\"\\n  1045\\t                  \\\"-- the executor reported instead of asking, twice in \\\"\\n  1046\\t                  \\\"a row\\\")\\n  1047\\t            line = {**common2, \\\"status\\\": \\\"question\\\", \\\"question\\\": question2,\\n  1048\\t                   \\\"class\\\": \\\"non-question\\\"}\\n  1049\\t            print(json.dumps(line))\\n  1050\\t            return 0\\n  1051\\t\\n  1052\\t        line = {**common2, \\\"status\\\": status2, \\\"question\\\": question2}\\n  1053\\t        print(json.dumps(line))\\n  1054\\t        return 0\\n  1055\\t\\n   430\\t        return rc if rc != 0 else 1\\n   431\\t\\n   432\\t    record = cast(dict[str, Any], latest_record(records_dir, stage))\\n   433\\t    status_out = record.get(\\\"status\\\")\\n   434\\t    to_commit = [after]\\n   435\\t    if status_out != \\\"pass\\\":\\n   436\\t        # R3: a retryable family (died, hung, transient, returned) asks\\n   437\\t        # counsel nothing while its budget still has an attempt to\\n   438\\t        # spend -- the next pass retries it plainly. Once its budget is\\n   439\\t        # spent, or its last two signatures match, counsel is read once\\n   440\\t        # more, its sentence carried beside the exhaustion report, never\\n   441\\t        # instead of it. Every other class is counsel's to read on every\\n   442\\t        # stop, as before this item -- unless the immediately preceding\\n   443\\t        # attempt of this stage already carried the identical detail and\\n   444\\t        # was already counseled: asking counsel the same question twice\\n   445\\t        # in a row would only spend a second invocation on the same\\n   446\\t        # answer, so this one is a person's now, not counsel's again.\\n   447\\t        stop_class = (record.get(\\\"stop\\\") or {}).get(\\\"class\\\")\\n   448\\t        budget_stage = \\\"build\\\" if stop_class == \\\"returned\\\" else stage\\n   449\\t        if stop_class in RETRYABLE_CLASSES:\\n   450\\t            ask_counsel = stage_exhausted(records_dir, m, stage, budget_stage)\\n   451\\t        else:\\n   452\\t            detail = (record.get(\\\"stop\\\") or {}).get(\\\"detail\\\")\\n   453\\t            prior = parse_attempts(records_dir, stage).get(nn - 1) if nn > 1 else None\\n   454\\t            already_read = (prior is not None and signature_of(detail) is not None\\n   455\\t                           and signature_of(detail) == signature_of((prior.get(\\\"stop\\\") or {}).get(\\\"detail\\\"))\\n   456\\t                           and counsel_record_for(records_dir, stage, nn - 1) is not None)\\n   457\\t            ask_counsel = not already_read\\n   458\\t        counsel_before = latest_attempt_path(records_dir, \\\"counsel\\\")\\n   459\\t        if ask_counsel:\\n   460\\t            cmd_counsel([item_id])\\n   461\\t        counsel_after = latest_attempt_path(records_dir, \\\"counsel\\\")\\n   462\\t        if counsel_after is not None and counsel_after != counsel_before:\\n   463\\t            to_commit.append(counsel_after)\\n   464\\t        # file-stops is its own idempotent read of the item's records, so\\n   465\\t        # calling it here on every run that wrote a non-pass record is\\n   720\\t            print(\\\"attavo drive: --again is a no-op inside the budget; the pass retries on its own\\\")\\n   721\\t            return 0\\n   722\\t    return _advance_again(root, m, item_id, stage, r[\\\"head\\\"], again_by=True)\\n   723\\t\\n   724\\t\\n   725\\tdef _counsel_answered(records_dir: Path, r: \\\"DriveReport\\\") -> bool:\\n   726\\t    \\\"\\\"\\\"R3: whether the stop this report just read as \\\"stopped\\\" already\\n   727\\t    carries counsel's own \\\"answer\\\" verdict -- every non-retryable class\\n   728\\t    is counsel's to read (as before this item), and `answer` starts the\\n   729\\t    next attempt with the answer as its steer, read from the feedback\\n   730\\t    file the retried attempt's own first iteration is handed\\n   731\\t    (attavo.build._retry_seed).\\\"\\\"\\\"\\n   732\\t    if r[\\\"stop_class\\\"] in RETRYABLE_CLASSES or not r[\\\"stage\\\"] or r[\\\"attempt\\\"] is None:\\n   733\\t        return False\\n   734\\t    counsel = counsel_record_for(records_dir, r[\\\"stage\\\"], r[\\\"attempt\\\"])\\n   735\\t    return counsel is not None and counsel.get(\\\"verdict\\\") == \\\"answer\\\"\\n   736\\t\\n   737\\t\\n   738\\tdef _pass_once(root: Path, m: dict[str, Any], item_id: str, again: bool) -> tuple[int, \\\"DriveReport\\\"]:\\n   739\\t    \\\"\\\"\\\"One pass: fast-forward to origin (never while a worker holds the\\n   740\\t    copy), read the report, act at most once, return. The three acts,\\n   741\\t    one per report state that is the product's move: owes-recovery\\n   742\\t    recovers; next-build and next-review start their stage, handing a\\n   743\\t    review the checks the report already read once on the pre-marker\\n   744\\t    head; a concluded red check on a passed build's head (R3) is a\\n   745\\t    returned review record, not a level, so the review starts the same\\n   746\\t    way. On a stopped stage, `--again` always wins (a no-op inside the\\n   747\\t    budget, the next attempt once it is spent); absent it, a retryable\\n   748\\t    family retries on its own, and any other stop counsel has already\\n   749\\t    answered starts the next attempt steered by that answer. Every other\\n   750\\t    level is printed in the report's own words and left.\\\"\\\"\\\"\\n   751\\t    from attavo.report import drive_report\\n   752\\t    fast_forward_to_origin(root, m, item_id)\\n   753\\t    r = drive_report(root, m, item_id)\\n   754\\t\\n   755\\t    if r[\\\"state\\\"] == \\\"owes-recovery\\\":\\n   756\\t        records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n   757\\t        return _recover_one(root, m, item_id, records_dir), r\\n   758\\t    if r[\\\"state\\\"] == \\\"next-build\\\":\\n   759\\t        return _start_stage(root, m, item_id, \\\"build\\\", None), r\\n   760\\t    if r[\\\"state\\\"] == \\\"next-review\\\":\\n   761\\t        checks_command = (m.get(\\\"forge\\\") or {}).get(\\\"checks_command\\\")\\n   762\\t        forge_checks = {\\\"command\\\": checks_command, \\\"sha\\\": r[\\\"head\\\"], \\\"conclusions\\\": r[\\\"checks\\\"] or []}\\n   763\\t        return _start_stage(root, m, item_id, \\\"verify\\\", forge_checks), r\\n   764\\t    if r[\\\"state\\\"] == \\\"blocked-on-checks\\\" and r[\\\"stage\\\"] == \\\"verify\\\":\\n   765\\t        # R3: the rejection is a record, not a level with nothing behind\\n   766\\t        # it (#206's build-01) -- the review starts, reading the same\\n   767\\t        # forge checks this pass just read, and writes the check\\n   768\\t        # rejection itself as a returned record (attavo.verify.cmd_verify).\\n   769\\t        checks_command = (m.get(\\\"forge\\\") or {}).get(\\\"checks_command\\\")\\n   770\\t        forge_checks = {\\\"command\\\": checks_command, \\\"sha\\\": r[\\\"head\\\"], \\\"conclusions\\\": r[\\\"checks\\\"] or []}\\n   771\\t        return _start_stage(root, m, item_id, \\\"verify\\\", forge_checks), r\\n   772\\t    if r[\\\"state\\\"] == \\\"stopped\\\" and r[\\\"stage\\\"]:\\n   773\\t        if again:\\n   774\\t            return _handle_again(root, m, item_id, r), r\\n   775\\t        records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n   776\\t        if _retry_due(root, m, item_id, r):\\n   777\\t            return _advance_again(root, m, item_id, _retry_target(r), r[\\\"head\\\"]), r\\n   778\\t        if _counsel_answered(records_dir, r):\\n   779\\t            return _advance_again(root, m, item_id, _retry_target(r), r[\\\"head\\\"]), r\\n   780\\t\\n   781\\t    print(f\\\"attavo drive: {r['says']}\\\")\\n   782\\t    return (1 if r[\\\"state\\\"] == \\\"refused\\\" else 0), r\\n   783\\t\\n   784\\t\\n   785\\t_TERMINAL_STATES = (\\\"waiting-on-approval\\\", \\\"stopped\\\", \\\"ready-to-merge\\\", \\\"merged\\\")\\n     1\\tfrom __future__ import annotations\\n     2\\t\\n     3\\timport json\\n     4\\timport re\\n     5\\timport sys\\n     6\\tfrom pathlib import Path\\n     7\\tfrom typing import Any\\n     8\\t\\n     9\\tfrom attavo.common import MANIFEST, read_manifest\\n    10\\tfrom attavo.records import parse_attempts, stage_schema\\n    11\\tfrom attavo.types import CounselRecord, Stop\\n    12\\t\\n    13\\t# --- stop: every non-pass build or verify record's class and cause (issue\\n    14\\t# #89) -- derived here, at write time, from the refusal, halted, and log\\n    15\\t# the caller already has. Never a fresh read of anything: the tenant zero\\n    16\\t# specimens this retires (#576 build-11, #659 build-01 and verify-01) are\\n    17\\t# exactly a stop the product wrote with nothing beside it to explain\\n    18\\t# itself after the fact. ---\\n    19\\t\\n    20\\tSTOP_CLASSES = (\\\"non-question\\\", \\\"outlived-invocation\\\", \\\"no-cause\\\", \\\"forge-unconcluded\\\",\\n    21\\t               \\\"ceiling\\\", \\\"claims-boundary\\\", \\\"repeated-act\\\", \\\"unclassed\\\", \\\"question\\\",\\n    22\\t               \\\"environment\\\", \\\"gate\\\", \\\"died\\\", \\\"hung\\\", \\\"transient\\\", \\\"returned\\\")\\n    23\\t\\n    24\\t# R3: the four families a pass retries without a person -- died and hung\\n    25\\t# (recovery's, unchanged), transient (a vendor's capacity, rate, or 5xx\\n    26\\t# refusal), and returned (a build's head a required check rejected, or a\\n    27\\t# review that returned a blocking finding). Every other non-pass record\\n    28\\t# is a person's, once counsel has read it.\\n    29\\tRETRYABLE_CLASSES = (\\\"died\\\", \\\"hung\\\", \\\"transient\\\", \\\"returned\\\")\\n    30\\t\\n    31\\t\\n    32\\tdef signature_of(text: str | None) -> str | None:\\n    33\\t    \\\"\\\"\\\"R3: a failure's signature -- the text a script compares by\\n    34\\t    equality between two attempts, with every run of digits removed, so\\n    35\\t    a retry-after, a pid, or a timestamp never keeps two otherwise\\n    36\\t    identical failures from matching. None for None or empty text.\\\"\\\"\\\"\\n    37\\t    if not text:\\n    38\\t        return None\\n    39\\t    stripped = re.sub(r\\\"[0-9]+\\\", \\\"\\\", text).strip()\\n    40\\t    return stripped or None\\n    41\\t\\n    42\\t\\n    43\\tdef stage_exhausted(records_dir: Path, m: dict[str, Any], sig_stage: str, budget_stage: str) -> bool:\\n    44\\t    \\\"\\\"\\\"R3: whether a retryable stop on sig_stage is exhausted -- its own\\n    45\\t    last two attempts carry the identical signature (the early stop), or\\n   150\\t    now instead.\\\"\\\"\\\"\\n   151\\t    text = text or \\\"\\\"\\n   152\\t    for name in STOP_CLASSES:\\n   153\\t        markers = CLASS_TEXT_MARKERS.get(name, (name,))\\n   154\\t        if any(marker in text for marker in markers):\\n   155\\t            return name\\n   156\\t    return None\\n   157\\t\\n   158\\t\\n   159\\tdef derive_stop(status: str, *, refusal: str | None = None, halted: dict[str, Any] | None = None,\\n   160\\t                log: str | None = None, report_class: str | None = None,\\n   161\\t                refusal_provenance: str | None = None) -> Stop | None:\\n   162\\t    \\\"\\\"\\\"The stop field for a build or verify record: None for status \\\"pass\\\",\\n   163\\t    else {class, provenance, detail} from what the caller already knows.\\n   164\\t\\n   165\\t      - report_class -- payload.get(\\\"class\\\") off the adapter's own report\\n   166\\t        line (issue #88, #94), when it names a STOP_CLASSES member -- is\\n   167\\t        that class, provenance \\\"executor\\\". build.schema.json and\\n   168\\t        verify.schema.json stay untouched by issue #88 on purpose, so the\\n   169\\t        class lives only on the report line, never a structured field\\n   170\\t        cmd_build or cmd_verify forwards on its own account; the caller\\n   171\\t        reads payload itself and passes this in, since only it still has\\n   172\\t        payload once an iteration ends. This is non-question's and\\n   173\\t        outlived-invocation's only path to a record now (issue #94):\\n   174\\t        CLASS_TEXT_MARKERS disables both for the text scan below, the\\n   175\\t        same way issue #93 disabled ceiling's bare-name match there. A\\n   176\\t        class an adapter does not yet put on its report line --\\n   177\\t        outlived-invocation today, since that refusal path prints no\\n   178\\t        report line at all -- falls to unclassed below, same as any\\n   179\\t        other unnamed cause, until the adapter that raises it puts a\\n   180\\t        class on the line the way non-question already does.\\n   181\\t      - a halt carrying a non-empty halted.question, once it is not a\\n   182\\t        non-question caught above, is a genuine question -- question/spec,\\n   183\\t        with the question's own first line as detail (issue #100's\\n   184\\t        followups). This is the specimen issue #100 itself was built to\\n   185\\t        retire: tenant zero's #663 build-01, a proper question, classed\\n   186\\t        unclassed/product and filed as a product defect with the wrong\\n   187\\t        provenance -- a question is about the definition of done, which is\\n   188\\t        a person's or a ruling's to answer, never the product's own\\n   189\\t        mechanism.\\n   190\\t      - failing that, a refusal or the log itself that already names its\\n   191\\t        class in text (issue #88, #93 for ceiling's own pre-emptive\\n   192\\t        refusal) is that class, provenance \\\"executor\\\" -- the log is\\n   193\\t        checked because neither adapter's refusal *field* carries the\\n   194\\t        class today; the class-naming line each adapter prints reaches\\n   195\\t        only the transcript\\n   196\\t      - a refusal that is not that -- the write-outside-claims path\\n   197\\t        itself, not the \\\"commit ... not authored by the executor\\\" shape\\n   198\\t        -- is claims-boundary/spec, unless the caller already knows this\\n   199\\t        refusal touched paths.records or paths.specs (issue #140:\\n   200\\t        protected_path_touched, checked ahead of the ordinary claims\\n   201\\t        match in cmd_build) and passes refusal_provenance=\\\"executor\\\" --\\n   202\\t        the product's own directories are not a claim a spec makes, so a\\n   203\\t        refusal there is not the spec's boundary to answer for\\n   204\\t      - a returned verify (the forge was not green; no adapter ran) is\\n   205\\t        forge-unconcluded/tenant\\n   206\\t      - an adapter exit whose log carries a declared-ceiling error line is\\n   207\\t        ceiling/product\\n   208\\t      - anything else is unclassed/product, with the log's last line\\n   209\\t        (capped at UNCLASSED_DETAIL_MAX_CHARS) as its detail -- the other\\n   210\\t        class that carries a detail, since every remaining class's\\n   211\\t        evidence already lives in refusal, halted, forge_checks, or the\\n   212\\t        log itself.\\n   213\\t    \\\"\\\"\\\"\\n   214\\t    if status == \\\"pass\\\":\\n   215\\t        return None\\n   216\\t    if status == \\\"returned\\\":\\n   217\\t        return {\\\"class\\\": \\\"forge-unconcluded\\\", \\\"provenance\\\": \\\"tenant\\\", \\\"detail\\\": None}\\n   218\\t    if report_class in STOP_CLASSES:\\n   219\\t        return {\\\"class\\\": report_class, \\\"provenance\\\": \\\"executor\\\", \\\"detail\\\": None}\\n   220\\t    question = (halted or {}).get(\\\"question\\\")\\n   221\\t    if status == \\\"halted\\\" and question:\\n   222\\t        return {\\\"class\\\": \\\"question\\\", \\\"provenance\\\": \\\"spec\\\",\\n   223\\t               \\\"detail\\\": question.splitlines()[0]}\\n   224\\t    known = _carries_a_known_class(refusal) or _carries_a_known_class(log)\\n   225\\t    if known:\\n   226\\t        return {\\\"class\\\": known, \\\"provenance\\\": \\\"executor\\\", \\\"detail\\\": None}\\n   227\\t    if status == \\\"refused\\\" and refusal is not None and not refusal.startswith(\\\"commit \\\"):\\n   228\\t        return {\\\"class\\\": \\\"claims-boundary\\\", \\\"provenance\\\": refusal_provenance or \\\"spec\\\",\\n   229\\t               \\\"detail\\\": None}\\n   230\\t    if log and any(marker in log.lower() for marker in CEILING_MARKERS):\\n\",\"exit_code\":0,\"status\":\"completed\"}}\ndiff --git a/attest/records/219/counsel-02.json b/attest/records/219/counsel-02.json\n@@ -0,0 +1,61 @@\ndiff --git a/attest/records/219/counsel-02.log b/attest/records/219/counsel-02.log\n@@ -0,0 +1,19 @@\n+{\"type\":\"item.completed\",\"item\":{\"id\":\"item_3\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"find /Users/davidbean/Projects -path '*/claude/reconciler-brief-2026-09-20.md' -o -path '*/claude/r3-rulings-2026-09-25.md' 2>/dev/null\\nsed -n '1,320p' attest/specs/219/spec.md\\nsed -n '510,575p' attavo/drive.py\\nsed -n '1,210p' /Users/davidbean/Projects/attest/adapters/claude-code/run\\nsed -n '1,220p' /Users/davidbean/Projects/attest/bin/attavo\\\"\",\"aggregated_output\":\"## Problem\\n\\nAfter R2 a pass starts a stage and a worker runs it, but nothing in the product starts a stage again. A build whose worker died is recovered as `died` and then waits for a person; a review the vendor refused at capacity is a `failed` record, a counsel run, a filed issue, and two presses (#194's `verify-01`); a build whose head a required check rejected is a level (`blocked-on-checks`) that never becomes a record, so the item sits until someone reads the screen (#206's `build-01`, red on `typecheck`); a review that returns blocking findings stops the item as if the findings were a question for the operator. Every one of these is a failure whose answer does not touch the definition of done, and the project's rule is that such a failure needs the operator only if the spec must change. Nothing bounds a stage's wall clock either: a review on an adapter that streams no events is judged by a stall bound it can never trip, and the only ceiling is the operator's patience.\\n\\nThis is R3 of the reconciler (`claude/reconciler-brief-2026-09-20.md`, ruling C with its two amendments, section 6; the nine rulings of 2026-09-25 recorded in `claude/r3-rulings-2026-09-25.md`). It adds the retry families, one budget, the early stop, the exhaustion report, the stage ceilings, and the input the next attempt is handed; it retires the operator as the only thing that ever runs a stage twice.\\n\\nThe families. A stage record that is not a pass belongs to one of four retryable families or to a person. `died` and `hung` (recovery's classes, unchanged) and `transient` (new: a vendor's capacity, rate, or 5xx refusal, classed by the adapter on its report line as every class is) retry plainly: the next pass starts the next attempt, asks counsel nothing, and a `transient` waits `[drive].retry_after_s` (default 300) from its record before the attempt starts, the report reading \\\"retrying build in N s\\\" meanwhile. `returned` (new) is a build whose head a required check rejected, or a build whose review returned a blocking finding (a finding whose `severity` is `blocking` makes the review's status `failed` with class `returned`; every other severity leaves the review a pass and is filed as today): the pass writes the check rejection as a returned review record the moment the report reads a concluded red check on a passed build's head (class `returned`, provenance tenant, no adapter run — the shape `attavo verify` already writes for a forge that is not green), so the rejection is a record and not a level; the next build attempt is handed the evidence; counsel is asked only when the second attempt ends with the same signature. Every other non-pass record is read by counsel as today, and counsel's verdict routes: `answer` starts the next attempt with the answer as its steer; `patch` files and the report reads \\\"waiting on #N\\\"; `person` is the operator's. A question, a claims-boundary stop, a tenant's gate refusal, and an environment refusal are never retried by this item; environment refusal is recorded here and acted on by R4's breaker.\\n\\nOne budget. `[drive].attempts` (default 3) per stage, shared by plain, returned, and steered attempts; every attempt with a marker counts, a recovered one included, because the budget bounds what the product spends on a stage. Two attempts of one stage ending with the identical failure signature stop the stage early and do not spend the third. When the budget is spent, or the early stop fires, the report's state is `stopped` and it carries `attempts`: for each attempt its class, signature, the bound it crossed (`stall`, `ceiling`, or none), wall clock and cost; whether the signatures match; and `rulings_available` naming what each would do (`--again` resets the budget, flagged unlikely to help when the signatures match; amending the spec, which moves the approval). Counsel is read once more at exhaustion and its sentence rides beside the comparison, never instead of it.\\n\\nThe signature. Every non-pass stop carries `stop.signature`, a string a script computes from the record and compares by equality, with runs of digits removed: for `died` and `hung`, the last event line; for `transient`, the adapter's stop detail; for a `returned` check rejection, the sorted names of the required checks that concluded red; for a `returned` review, the sorted titles of its blocking findings; for every other class, the stop detail. The exhaustion report prints the signatures side by side.\\n\\nThe next attempt's input. The product already hands an attempt a feedback file (`ATTAVO_FEEDBACK`), empty on a first iteration. A retried attempt's first iteration starts with that file carrying, in this order and only the parts that exist: the prior attempt's class and signature; the evidence (the failing check's log read through `[forge].check_log_command`, or the review's blocking findings); and the newest steer newer than the blocking record (counsel's `answer` text now; an operator's ruling after R4), with the record it came from named. The attempt's record carries `retry_of` (the prior attempt's stem) and `steer` (the counsel record's stem, or null). No new adapter input, no new environment variable: one file the contract already passes.\\n\\nCeilings. `[drive.build].ceiling_s` and `[drive.verify].ceiling_s`, wall clock from the marker's `at`. A worker alive past its stage's ceiling is terminated by the next pass and recorded `hung` with `stop.bound = \\\"ceiling\\\"`. An adapter whose `conformance.json` declares `\\\"streams_events\\\": false` is judged by the ceiling alone; its report never says \\\"no event for N s\\\". The doctor refuses a manifest that sets `[drive]` without both ceilings and `attempts`, as it refuses one without `stall_after_s`. The self-tenant declares build 2,400 s, verify 1,200 s, attempts 3, retry_after_s 300; the manifest schema carries the keys.\\n\\n`--again` after this item starts the next attempt of a stage whose budget is spent, resets that stage's budget, and writes `again_by` into the new marker; inside the budget it is a no-op that says the pass retries on its own. It is retired in R4.\\n\\nNot in this item: retrying on a different executor; any wait other than the one fixed `retry_after_s`; the breaker; rulings as records.\\n\\nThe stub under `stub/` is thin: the two classes and the signature, the schema keys, the doctor's refusal, a pass that retries the four families inside the budget with the early stop and the transient wait, the returned record on a red check with its log handed to the next build, and the ceiling. It has no steer, no blocking-finding return, no transient wait in the report's words, no `--again` narrowing, no adapter classification, and no updates to the existing tests the stop shape and the doctor's refusal break. Ten of the eleven tests in `tests/test_retry.py` are red on the tree; five are red on the stub, listed in the issue. `python3 -m mypy` exits 0 on the built tree with no `type: ignore`.\\n\\nRetires: the operator as the only thing that runs a stage a second time; `blocked-on-checks` as a level with no record behind it (with it, `tests/test_drive.py::test_drive_pass_reads_a_red_forge_as_blocked_and_starts_nothing` and `test_drive_until_ready_stops_when_the_forge_goes_red_after_a_build`, which encode that level, are rewritten to the returned record); the counsel run on a vendor's capacity error (#194's `verify-01`, replayed as this item's rejection fixture); the stall bound as a bound on adapters that do not stream; `--again` inside the budget.\\n\\n## Claims\\n\\n- attavo/drive.py\\n- attavo/report.py\\n- attavo/verify.py\\n- attavo/build.py\\n- attavo/stops.py\\n- attavo/doctor.py\\n- attavo/types.py\\n- schema/manifest.schema.json\\n- schema/records/build.schema.json\\n- schema/records/verify.schema.json\\n- schema/drive-report.schema.json\\n- adapters/fixture/run\\n- adapters/fixture/conformance.json\\n- adapters/claude-code/run\\n- adapters/claude-code/conformance.json\\n- adapters/codex/run\\n- adapters/codex/conformance.json\\n- attavo.toml\\n- tests/test_retry.py\\n- tests/test_pass.py\\n- tests/test_drive.py\\n- tests/test_report.py\\n- tests/test_doctor.py\\n- tests/test_build.py\\n- tests/test_verify.py\\n- tests/test_verify_polls.py\\n- tests/test_proof_five_elsewhere.py\\n- tests/test_record_schemas.py\\n- tests/test_stub_ratio.py\\n- tests/test_types_mirror_schemas.py\\n\\n## Criteria\\n\\n- a-transient-stop-retries-plainly.sh: on a fixture tenant whose build adapter refuses once with the vendor's capacity error and passes on its second run, passes alone carry the item from an approved spec to a passing build-02 whose retry_of is build-01, build-01's stop class is transient, and no counsel record exists\\n- a-red-check-becomes-a-returned-record-and-the-next-build-is-handed-its-log.sh: on a fixture tenant whose checks command reads red once after the first build and green after, a pass writes verify-01 with status returned and class returned naming the red check in its signature, the next pass starts build-02 whose first feedback file names that check and its log, and no operator act occurs between approval and the passing review\\n- two-identical-failures-stop-at-two-and-the-report-compares-them.sh: on a fixture tenant whose build adapter dies on the same event line every run, passes write build-01 and build-02 as died with equal signatures and start no build-03; attavo drive N --report reads stopped with two attempts, matching signatures, and --again among the rulings available\\n- a-stage-past-its-ceiling-is-hung-by-the-ceiling.sh: on a fixture tenant whose build adapter sleeps past a ceiling of two seconds and declares it does not stream, a pass terminates the worker and writes build-01 as hung with bound ceiling, and the report never speaks of event age\\n- the-manifest-and-the-tests-exist.sh: the doctor refuses a fixture manifest with a [drive] table and no ceilings, and tests/test_retry.py carries the tests named\\n    item_id, stage, nn_text = argv\\n    if stage not in (\\\"build\\\", \\\"verify\\\"):\\n        print(f\\\"attavo worker: {stage!r} is not build or verify\\\", file=sys.stderr)\\n        return 2\\n    try:\\n        nn = int(nn_text)\\n    except ValueError:\\n        print(f\\\"attavo worker: {nn_text!r} is not an attempt number\\\", file=sys.stderr)\\n        return 2\\n    return _stage_body(item_id, stage, nn)\\n\\n\\n# --- the pass's own two acts: start a stage (the lease), and recover\\n# exactly the one invocation the report names owed one. ---\\n\\ndef _start_stage(root: Path, m: dict[str, Any], item_id: str, stage: str,\\n                 forge_checks: dict[str, Any] | None, again_by: bool = False) -> int:\\n    \\\"\\\"\\\"The lease (ruling A): the marker, committed and pushed as a plain\\n    fast-forward with no merge and no retry (push_lease). Lost to another\\n    pass, or refused outright by the remote, both undo the marker commit\\n    here (git reset --hard) so this checkout carries no half-taken\\n    attempt either way; only a pushed lease starts the worker. On a\\n    review, forge_checks is the checks this same pass already read on\\n    the pre-marker head (ruling B) -- written to\\n    <git-dir>/attavo/verify-NN.forge-checks.json and named in\\n    ATTAVO_FORGE_CHECKS, so the worker's own `attavo verify` reads it\\n    instead of polling. again_by (R3) is true only when `--again` is what\\n    started this attempt, past a budget already spent or an early stop\\n    -- named in the marker, never on an ordinary or plainly-retried\\n    attempt.\\\"\\\"\\\"\\n    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n    nn = next_attempt_number(records_dir, stage)\\n    marker = write_invocation_marker(root, records_dir, stage, nn, again_by=again_by)\\n    try:\\n        commit_record(root, [marker], f\\\"attavo: {stage} invocation {nn:02d} started for item {item_id}\\\")\\n    except RuntimeError as exc:\\n        print(f\\\"attavo drive: stopped: could not commit the {stage} invocation marker: {exc}\\\")\\n        return 1\\n\\n    if has_origin(root):\\n        outcome, err = push_lease(root, branch)\\n        if outcome != \\\"pushed\\\":\\n            git(root, \\\"reset\\\", \\\"--hard\\\", \\\"HEAD^\\\")\\n            if outcome == \\\"lost-race\\\":\\n                print(f\\\"attavo drive: another pass holds this attempt ({marker.name}); nothing started\\\")\\n                return 0\\n            print(f\\\"attavo drive: stopped: could not push the {stage} invocation marker: {err}\\\")\\n            return 1\\n\\n    env = dict(os.environ)\\n    if forge_checks is not None:\\n        checks_file = forge_checks_path(root, stage, nn)\\n        checks_file.write_text(json.dumps(forge_checks))\\n        env[\\\"ATTAVO_FORGE_CHECKS\\\"] = str(checks_file)\\n    log = worker_log_path(root, stage, nn)\\n    with log.open(\\\"ab\\\") as fh, open(os.devnull, \\\"rb\\\") as devnull:\\n        proc = subprocess.Popen(\\n            [sys.executable, str(PRODUCT_ROOT / \\\"bin\\\" / \\\"attavo\\\"), \\\"worker\\\", item_id, stage, f\\\"{nn:02d}\\\"],\\n            cwd=str(root), env=env, stdin=devnull, stdout=fh, stderr=subprocess.STDOUT,\\n            start_new_session=True)\\n    word = \\\"Build\\\" if stage == \\\"build\\\" else \\\"Review\\\"\\n    print(f\\\"attavo drive: {word} started (attempt {nn:02d}, worker pid {proc.pid})\\\")\\n    return 0\\n\\n\\n#!/usr/bin/env python3\\n\\\"\\\"\\\"adapters/claude-code/run -- see README.md (this directory) for the four\\nconfiguration keys, and ../README.md for the shared adapter contract.\\n\\nA live `claude` invocation is not exercised by the test suite (judgment\\nis measured, not tested); its argument construction is checked by\\nATTAVO_ADAPTER_DRY_RUN=1, which prints the `claude` command line as a\\nJSON array instead of running it, its response handling is checked by\\nATTAVO_ADAPTER_RESPONSE_FILE, which reads a canned final report object\\nfrom a file instead of invoking `claude`, and (issue #26) its\\n`--output-format stream-json --verbose` mapping -- the event stream\\nthis adapter maps to ATTAVO_EVENTS, and the terminal \\\"result\\\" line it\\nreads the report object from -- is checked by ATTAVO_ADAPTER_STREAM_FILE,\\nwhich feeds a recorded transcript instead.\\n\\nThe whole result is printed to stdout before this adapter's own final\\nline, so build-NN.log carries it as the transcript -- a halt otherwise\\ncannot be explained after the fact. is_error or an absent\\nstructured_output exit 1 on either stage; a build status \\\"question\\\"\\nwhose question is missing or under MIN_QUESTION_CHARS characters also\\nexits 1 (build records the attempt as failed) rather than a halt\\nsomeone must rule on.\\n\\nATTAVO_STAGE=verify branches to a different objective, schema, and\\nreport shape (issue #46): the instruction states the verify objective\\n(see verify_instruction) instead of the build one, --json-schema is\\nVERIFY_SCHEMA instead of STATUS_SCHEMA, and the final line carries\\nfindings and tests_named instead of status and question.\\n\\nIssue #78: the boundary is the tool's own sandbox, not a curated\\nallowed_tools list judged per sub-command -- confirmed live (recorded on\\nthe issue, 2026-09-10) against `claude 2.1.268`: `--settings` carrying\\n`{\\\"sandbox\\\": {\\\"enabled\\\": true, \\\"allowUnsandboxedCommands\\\": false}}` under\\n`-p` refuses a write outside the working directory (\\\"operation not\\npermitted\\\") and, with `network.allowedDomains: []`, refuses an outbound\\nconnection (\\\"deny network-outbound ...\\\"), both before `--allowedTools`\\nis ever consulted. build's `--settings` therefore enables the sandbox and\\nforbids the unsandboxed fallback; verify's additionally sets\\n`filesystem.denyWrite` on the working directory itself (confirmed live:\\n`denyWrite` takes a list of paths, not a bare boolean -- `true` alone did\\nnot stop a write inside the directory). `--allowedTools` shrinks to the\\ntool names each stage may use at all -- `Read,Edit,Write,Bash` for build,\\n`Read,Bash` for verify -- since Edit and Write are not Bash and the\\nsandbox does not govern them. `allowed_tools` is retired as a manifest\\nkey: a config that still declares it is refused by name rather than\\nsilently accepted.\\n\\nIssue #88 (class A: a report is not a question). `--json-schema`\\nconstrains the tool's structured_output to \\\"done\\\"/\\\"question\\\", but\\nnothing stops \\\"question\\\" from carrying a status report rather than an\\nactual question -- confirmed against tenant zero's own corpus, five\\nspecimens with no \\\"?\\\" anywhere in the text. A \\\"question\\\" whose text\\nclears MIN_QUESTION_CHARS but contains no \\\"?\\\" is a report, not a\\nquestion: this adapter re-invokes the executor once, appending\\nREINSTRUCTION to the same instruction, before ever reporting a halt to\\na person. A second report in a row still halts (someone must look), but\\nits report line carries \\\"class\\\": \\\"non-question\\\" and both raw results\\nreached stdout above it -- an extra field bin/attavo's own record schema\\ndoes not know about and never has to: it reads \\\"status\\\"/\\\"question\\\" off\\nthis line exactly as before, so a \\\"question\\\" halt still halts. Read via\\nATTAVO_ADAPTER_RESPONSE_FILE, a JSON array is a queue -- one canned\\nresult per invocation this adapter makes, its last element repeating\\nonce exhausted -- while a single object still repeats for every call,\\nunchanged.\\n\\nIssue #88 (class B: work that outlives the invocation). Confirmed live,\\nthis machine, `claude 2.1.269`: with both \\\"Agent\\\" and \\\"Task\\\" allowed, a\\nprompt asking for a subagent produced `subagent_stats.spawned: 1`, `\\\"Agent\\\"`\\nalone in `--disallowedTools` (Task is not a distinct tool in this build)\\nbrought it back to 0 -- the tool's own reply named \\\"Workflow\\\" as the\\nother path to background work, so both are named here. `--allowedTools`\\nis an allow-list a background spawn does not consult (tenant zero's\\nspecimen: `--allowedTools` without \\\"Agent\\\" or \\\"Workflow\\\" in it at all did\\nnot stop three of them), so this adapter also disallows them by name on\\nboth stages and, after the run, refuses by name -- exit 1, not a\\nhalt -- any response whose subagent_stats.spawned is not zero, with the\\ncounts in the message. A tool that reports no subagent_stats at all\\n(spawned absent or 0) is unaffected; this is a refusal on evidence, not a\\nguess from the flag.\\n\\\"\\\"\\\"\\nfrom __future__ import annotations\\n\\nimport json\\nimport os\\nimport subprocess\\nimport sys\\nfrom datetime import datetime, timezone\\nfrom pathlib import Path\\n\\n# the helper beside adapters/, imported without leaving a __pycache__ there\\nsys.dont_write_bytecode = True\\nsys.path.insert(0, str(Path(__file__).resolve().parent.parent))\\nfrom executor_env import executor_env  # noqa: E402\\n\\nSTATUS_SCHEMA = {\\n    \\\"type\\\": \\\"object\\\",\\n    \\\"additionalProperties\\\": False,\\n    \\\"required\\\": [\\\"status\\\", \\\"question\\\"],\\n    \\\"properties\\\": {\\n        \\\"status\\\": {\\\"type\\\": \\\"string\\\", \\\"enum\\\": [\\\"done\\\", \\\"question\\\"]},\\n        \\\"question\\\": {\\\"type\\\": [\\\"string\\\", \\\"null\\\"]},\\n    },\\n}\\n\\n# The verify objective (issue #46): a verifier reports findings, not a\\n# commit. additionalProperties: False means the tool cannot hand back a\\n# structured_output shaped like STATUS_SCHEMA's status/question by\\n# accident -- an absent findings key is what cmd_verify treats as\\n# failed, not a lenient default here.\\nVERIFY_SCHEMA = {\\n    \\\"type\\\": \\\"object\\\",\\n    \\\"additionalProperties\\\": False,\\n    \\\"required\\\": [\\\"findings\\\", \\\"tests_named\\\"],\\n    \\\"properties\\\": {\\n        \\\"findings\\\": {\\n            \\\"type\\\": \\\"array\\\",\\n            \\\"items\\\": {\\n                \\\"type\\\": \\\"object\\\",\\n                \\\"additionalProperties\\\": False,\\n                \\\"required\\\": [\\\"title\\\", \\\"specimen\\\", \\\"retires\\\", \\\"rejection_test\\\", \\\"severity\\\"],\\n                \\\"properties\\\": {\\n                    \\\"title\\\": {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1},\\n                    \\\"specimen\\\": {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1},\\n                    \\\"retires\\\": {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1},\\n                    \\\"rejection_test\\\": {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1},\\n                    \\\"severity\\\": {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1},\\n                },\\n            },\\n        },\\n        \\\"tests_named\\\": {\\\"type\\\": \\\"array\\\", \\\"items\\\": {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1}},\\n    },\\n}\\n\\n# The counsel objective (issue #100): a stop is read inside the product\\n# first, before a person. additionalProperties: False for the same reason\\n# as VERIFY_SCHEMA's own -- the tool cannot hand back a differently-shaped\\n# structured_output by accident.\\nCOUNSEL_SCHEMA = {\\n    \\\"type\\\": \\\"object\\\",\\n    \\\"additionalProperties\\\": False,\\n    \\\"required\\\": [\\\"class\\\", \\\"verdict\\\", \\\"citations\\\", \\\"proposal\\\"],\\n    \\\"properties\\\": {\\n        \\\"class\\\": {\\\"type\\\": \\\"string\\\"},\\n        \\\"verdict\\\": {\\\"type\\\": \\\"string\\\", \\\"enum\\\": [\\\"answer\\\", \\\"patch\\\", \\\"person\\\"]},\\n        \\\"citations\\\": {\\n            \\\"type\\\": \\\"array\\\",\\n            \\\"items\\\": {\\n                \\\"type\\\": \\\"object\\\",\\n                \\\"additionalProperties\\\": False,\\n                \\\"required\\\": [\\\"kind\\\", \\\"path\\\", \\\"symbol\\\", \\\"ruling_id\\\"],\\n                \\\"properties\\\": {\\n                    \\\"kind\\\": {\\\"type\\\": \\\"string\\\", \\\"enum\\\": [\\\"instruction\\\", \\\"mechanism\\\", \\\"guard\\\"]},\\n                    \\\"path\\\": {\\\"type\\\": [\\\"string\\\", \\\"null\\\"]},\\n                    \\\"symbol\\\": {\\\"type\\\": [\\\"string\\\", \\\"null\\\"]},\\n                    \\\"ruling_id\\\": {\\\"type\\\": [\\\"string\\\", \\\"null\\\"]},\\n                },\\n            },\\n        },\\n        \\\"proposal\\\": {\\n            \\\"type\\\": \\\"object\\\",\\n            \\\"additionalProperties\\\": False,\\n            \\\"required\\\": [\\\"ruling_text\\\", \\\"patch\\\", \\\"question\\\", \\\"issue\\\"],\\n            \\\"properties\\\": {\\n                \\\"ruling_text\\\": {\\\"type\\\": [\\\"string\\\", \\\"null\\\"]},\\n                \\\"patch\\\": {\\n                    \\\"type\\\": [\\\"object\\\", \\\"null\\\"],\\n                    \\\"additionalProperties\\\": False,\\n                    \\\"required\\\": [\\\"file\\\", \\\"symbol\\\", \\\"rejection_test\\\", \\\"diff\\\"],\\n                    \\\"properties\\\": {\\n                        \\\"file\\\": {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1},\\n                        \\\"symbol\\\": {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1},\\n                        \\\"rejection_test\\\": {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1},\\n                        \\\"diff\\\": {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1},\\n                    },\\n                },\\n                \\\"question\\\": {\\\"type\\\": [\\\"string\\\", \\\"null\\\"]},\\n                # issue #175: the fourth proposal shape, for a \\\"patch\\\" or\\n                # \\\"person\\\" verdict whose remedy is better filed as an item\\n                # than shipped as a diff or asked as a bare question.\\n                \\\"issue\\\": {\\n                    \\\"type\\\": [\\\"object\\\", \\\"null\\\"],\\n                    \\\"additionalProperties\\\": False,\\n                    \\\"required\\\": [\\\"title\\\", \\\"body\\\"],\\n                    \\\"properties\\\": {\\n                        \\\"title\\\": {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1},\\n                        \\\"body\\\": {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1},\\n                    },\\n                },\\n            },\\n        },\\n    },\\n}\\n\\n\\ndef read_text(path_env: str) -> str:\\n    path = os.environ.get(path_env)\\n    if not path:\\n        return \\\"\\\"\\n    p = Path(path)\\n    return p.read_text() if p.is_file() else \\\"\\\"\\n\\n\\ndef describe_file(path: str, text: str, diff_like: bool) -> str:\\n    \\\"\\\"\\\"Path, byte count, line count, and (for a diff) files touched --\\n    named in the instruction instead of inlining the file's own text, so\\n    the instruction stays a small fixed size whatever the file's size\\n    (issue #86: a 27,367-line deletion diff inlined whole exceeded a\\n    judge's input ceiling -- codex's, on the specimen that surfaced it).\\n    Files touched counts unified-diff file headers (`diff --git a/...\\n    b/...`), the shape `git diff` produces.\\\"\\\"\\\"\\n#!/usr/bin/env python3\\n\\\"\\\"\\\"attavo: the command.\\n\\nThe implementation is the attavo/ package beside this directory, one module\\nper section of what used to be this one script; attavo/cli.py holds the\\nusage text, the command table, and main. This file only puts the package on\\nthe import path and calls main, so a tenant that pins this repository by\\nversion still runs one path with nothing to install.\\n\\\"\\\"\\\"\\nimport sys\\nfrom pathlib import Path\\n\\nsys.path.insert(0, str(Path(__file__).resolve().parent.parent))\\n\\nfrom attavo.cli import main  # noqa: E402\\n\\nif __name__ == \\\"__main__\\\":\\n    sys.exit(main(sys.argv[1:]))\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n+{\"type\":\"item.completed\",\"item\":{\"id\":\"item_7\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"python3 -c 'import json; p=\\\\\\\"attest/records/219/build-02.log\\\\\\\";\\nfor i,l in enumerate(open(p),1):\\n try:\\n  o=json.loads(l)\\n except: continue\\n s=json.dumps(o,separators=(\\\\\\\",\\\\\\\",\\\\\\\":\\\\\\\"))\\n if any(x in s for x in (\\\\\\\"attavo drive\\\\\\\",\\\\\\\"attavo test 219\\\\\\\",\\\\\\\"reset --hard\\\\\\\",\\\\\\\"push failed\\\\\\\",\\\\\\\"build-02.started\\\\\\\",\\\\\\\"git status\\\\\\\",\\\\\\\"git log\\\\\\\")):\\n  print(i, s[:4000])' | tail -120\\nsed -n '110,160p' attavo/drive.py\\nsed -n '280,410p' attavo/drive.py\\nrg -n \\\\\\\"def test_.*push|could not push.*marker|reset|lost.race|_start_stage\\\\\\\" tests/test_drive.py tests/test_pass.py | head -120\\nfind /Users/davidbean/Projects/attest -maxdepth 3 -type f | sort | head -120\\\"\",\"aggregated_output\":\"162 {\\\"type\\\":\\\"user\\\",\\\"message\\\":{\\\"role\\\":\\\"user\\\",\\\"content\\\":[{\\\"tool_use_id\\\":\\\"toolu_01KDAxQudMoLN1YGexyaH6L2\\\",\\\"type\\\":\\\"tool_result\\\",\\\"content\\\":\\\"1\\\\tfrom __future__ import annotations\\\\n2\\\\t\\\\n3\\\\timport io\\\\n4\\\\timport json\\\\n5\\\\timport os\\\\n6\\\\timport signal\\\\n7\\\\timport subprocess\\\\n8\\\\timport sys\\\\n9\\\\timport threading\\\\n10\\\\timport time\\\\n11\\\\tfrom pathlib import Path\\\\n12\\\\tfrom typing import TYPE_CHECKING, Any, NamedTuple, cast\\\\n13\\\\t\\\\n14\\\\tfrom attavo.approval import approval_status\\\\n15\\\\tfrom attavo.build import cmd_build, driver_identity\\\\n16\\\\tfrom attavo.common import MANIFEST, PRODUCT_ROOT, derive_item_id, git, read_manifest\\\\n17\\\\tfrom attavo.counsel import cmd_counsel\\\\n18\\\\tfrom attavo.doctor import (\\\\n19\\\\t    _parse_json_line,\\\\n20\\\\t    attempts_budget,\\\\n21\\\\t    ceiling_s,\\\\n22\\\\t    invocation_alive,\\\\n23\\\\t    invocations_without_record,\\\\n24\\\\t    retry_after_s,\\\\n25\\\\t    stall_bound_s,\\\\n26\\\\t    write_invocation_marker,\\\\n27\\\\t)\\\\n28\\\\tfrom attavo.stops import RETRYABLE_CLASSES, signature_of\\\\n29\\\\tfrom attavo.events import stage_events_dir\\\\n30\\\\tfrom attavo.filing import cmd_file_stops\\\\n31\\\\tfrom attavo.records import (\\\\n32\\\\t    latest_attempt_path,\\\\n33\\\\t    latest_record,\\\\n34\\\\t    next_attempt_number,\\\\n35\\\\t    stage_schema,\\\\n36\\\\t    write_record,\\\\n37\\\\t)\\\\n38\\\\tfrom attavo.verify import cmd_verify, read_forge_checks\\\\n39\\\\t\\\\n40\\\\tif TYPE_CHECKING:\\\\n41\\\\t    from attavo.types import DriveReport\\\\n42\\\\t\\\\n43\\\\t# --- drive: the mechanical transitions between approval and ready-to-merge\\\\n44\\\\t# (issue #84), under the reconciler's R2 (rulings A, B, C's recovery half,\\\\n45\\\\t# F, G, H): `attavo drive N` is one short pass. It reads the report\\\\n46\\\\t# (attavo.report), acts at most once -- recovers a dead or hung\\\\n47\\\\t# invocation, or starts the next stage in a detached worker -- and\\\\n48\\\\t# returns within seconds; the stage itself runs in `attavo worker`, a\\\\n49\\\\t# child of the pass's own session, which outlives it. Writes no record of\\\\n50\\\\t# its own: the stage records already on disk, and the invocation markers\\\\n51\\\\t# and heartbeats beside them, are the only state a pass or a worker\\\\n52\\\\t# reads. ---\\\\n53\\\\t\\\\n54\\\\t\\\\n55\\\\tdef commit_record(root: Path, record_paths: Path | list[Path], message: str) -> None:\\\\n56\\\\t    \\\\\\\"\\\\\\\"\\\\\\\"`git commit --only` on every record path given, and each one's .log\\\\n57\\\\t    and .filed, each if one exists -- never the whole index. A transport\\\\n58\\\\t    commit that sweeps the index is exactly the regression issue #46\\\\n59\\\\t    already guards build and verify against on the adapter side; drive\\\\n60\\\\t    must not reintroduce it on the transport side. The .filed marker\\\\n61\\\\t    (issue #89) is committed alongside the record it names, in the same\\\\n62\\\\t    commit and the same push, so a second worktree or a fresh clone reads\\\\n63\\\\t    the same filed fact rather than refiling every stop it finds with no\\\\n64\\\\t    marker of its own. A single Path is accepted for the common one-record\\\\n65\\\\t    case; issue #100 passes a list so the counsel record lands in the same\\\\n66\\\\t    commit as the stage record it counsels. Authored and committed as\\\\n67\\\\t    driver_identity(), set by the product and never the tenant's git\\\\n68\\\\t    config, so a driven item's record commits are never indistinguishable\\\\n69\\\\t    from an operator's own.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n70\\\\t    if isinstance(record_paths, Path):\\\\n71\\\\t        record_paths = [record_paths]\\\\n72\\\\t    paths: list[str] = []\\\\n73\\\\t    for record_path in record_paths:\\\\n74\\\\t        paths.append(str(record_path.relative_to(root)))\\\\n75\\\\t        log_path = record_path.with_suffix(\\\\\\\".log\\\\\\\")\\\\n76\\\\t        if log_path.is_file():\\\\n77\\\\t            paths.append(str(log_path.relative_to(root)))\\\\n78\\\\t        marker_path = record_path.with_suffix(\\\\\\\".filed\\\\\\\")\\\\n79\\\\t        if marker_path.is_file():\\\\n80\\\\t            paths.append(str(marker_path.relative_to(root)))\\\\n81\\\\t    identity = driver_identity()\\\\n82\\\\t    env = dict(os.environ)\\\\n83\\\\t    env[\\\\\\\"GIT_AUTHOR_NAME\\\\\\\"] = identity[\\\\\\\"name\\\\\\\"]\\\\n84\\\\t    env[\\\\\\\"GIT_AUTHOR_EMAIL\\\\\\\"] = identity[\\\\\\\"email\\\\\\\"]\\\\n85\\\\t    env[\\\\\\\"GIT_COMMITTER_NAME\\\\\\\"] = identity[\\n188 {\\\"type\\\":\\\"user\\\",\\\"message\\\":{\\\"role\\\":\\\"user\\\",\\\"content\\\":[{\\\"tool_use_id\\\":\\\"toolu_0134Pee9Qr6n6LZmZYRLHWXX\\\",\\\"type\\\":\\\"tool_result\\\",\\\"content\\\":\\\"1\\\\tfrom __future__ import annotations\\\\n2\\\\t\\\\n3\\\\timport fnmatch\\\\n4\\\\timport json\\\\n5\\\\timport os\\\\n6\\\\timport subprocess\\\\n7\\\\timport sys\\\\n8\\\\timport tempfile\\\\n9\\\\timport time\\\\n10\\\\tfrom pathlib import Path\\\\n11\\\\tfrom typing import cast, Any\\\\n12\\\\t\\\\n13\\\\tfrom attavo.approval import approval_status\\\\n14\\\\tfrom attavo.common import (\\\\n15\\\\t    MANIFEST,\\\\n16\\\\t    PRODUCT_ROOT,\\\\n17\\\\t    ShallowCheckoutError,\\\\n18\\\\t    derive_item_id,\\\\n19\\\\t    git,\\\\n20\\\\t    last_commit_touching,\\\\n21\\\\t    now_iso,\\\\n22\\\\t    read_manifest,\\\\n23\\\\t)\\\\n24\\\\tfrom attavo.events import append_event, stage_events_dir\\\\n25\\\\tfrom attavo.records import latest_record, next_attempt_number, write_record\\\\n26\\\\tfrom attavo.spec import parse_spec, run_criterion\\\\n27\\\\tfrom attavo.stops import _log_last_line, derive_stop, signature_of\\\\n28\\\\tfrom attavo.testtool import run_bounded, without_records\\\\n29\\\\t\\\\n30\\\\t# --- build: adapter, claims boundary, criteria, and the tenant's tests ---\\\\n31\\\\t\\\\n32\\\\tSTAGE_NAMES = (\\\\\\\"build\\\\\\\", \\\\\\\"verify\\\\\\\", \\\\\\\"counsel\\\\\\\")\\\\n33\\\\t\\\\n34\\\\t\\\\n35\\\\tdef merge_adapter_config(m: dict[str, Any], adapter_name: str, stage: str) -> dict[str, Any]:\\\\n36\\\\t    \\\\\\\"\\\\\\\"\\\\\\\"[executor.<adapter>] merged with [executor.<adapter>.<stage>], the\\\\n37\\\\t    stage table shadowing the parent for that stage only. Both build and\\\\n38\\\\t    verify call this before setting ATTAVO_ADAPTER_CONFIG, and the\\\\n39\\\\t    record's adapter_config is the merged result.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n40\\\\t    parent = (m.get(\\\\\\\"executor\\\\\\\") or {}).get(adapter_name) or {}\\\\n41\\\\t    if not isinstance(parent, dict):\\\\n42\\\\t        return {}\\\\n43\\\\t    merged = {k: v for k, v in parent.items() if k not in STAGE_NAMES}\\\\n44\\\\t    stage_table = parent.get(stage)\\\\n45\\\\t    if isinstance(stage_table, dict):\\\\n46\\\\t        merged.update(stage_table)\\\\n47\\\\t    return merged\\\\n48\\\\t\\\\n49\\\\t\\\\n50\\\\tdef resolve_adapter(root: Path, name: str) -> Path | None:\\\\n51\\\\t    \\\\\\\"\\\\\\\"\\\\\\\"adapters/<name>/run, resolved first under the tenant's own\\\\n52\\\\t    attavo/adapters/, then under this product's adapters/.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n53\\\\t    for base in (root / \\\\\\\"attavo\\\\\\\" / \\\\\\\"adapters\\\\\\\", PRODUCT_ROOT / \\\\\\\"adapters\\\\\\\"):\\\\n54\\\\t        candidate = base / name / \\\\\\\"run\\\\\\\"\\\\n55\\\\t        if candidate.is_file():\\\\n56\\\\t            return candidate\\\\n57\\\\t    return None\\\\n58\\\\t\\\\n59\\\\t\\\\n60\\\\tdef adapter_reports(adapter_path: Path) -> list[str]:\\\\n61\\\\t    \\\\\\\"\\\\\\\"\\\\\\\"Field names adapters/<name>/conformance.json declares this adapter\\\\n62\\\\t    can supply with a real value -- vendor independence (2026-09-09\\\\n63\\\\t    ruling): the record carries the declaration, so an adapter claiming\\\\n64\\\\t    a field and returning null for it fails the conformance suite\\\\n65\\\\t    instead of writing a silent, uncomparable null. [] when the\\\\n66\\\\t    resolved adapter (a tenant override included) declares no\\\\n67\\\\t    conformance.json at all -- an absent declaration, not a refusal.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n68\\\\t    manifest_path = adapter_path.parent / \\\\\\\"conformance.json\\\\\\\"\\\\n69\\\\t    if not manifest_path.is_file():\\\\n70\\\\t        return []\\\\n71\\\\t    try:\\\\n72\\\\t        manifest = json.loads(manifest_path.read_text())\\\\n73\\\\t    except json.JSONDecodeError:\\\\n74\\\\t        return []\\\\n75\\\\t    reports: list[str] = manifest.get(\\\\\\\"reports\\\\\\\", [])\\\\n76\\\\t    return reports\\\\n77\\\\t\\\\n78\\\\t\\\\n79\\\\tdef changed_paths(root: Path, start_sha: str, records_rel: str) -> list[str]:\\\\n80\\\\t    \\\\\\\"\\\\\\\"\\\\\\\"Paths changed between start_sha and HEAD, other than paths.records --\\\\n81\\\\t    the records directory is where build itself writes, not a claim.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n82\\\\t    return without_records(git(root, \\\\\\\"diff\\\\\\\", \\\\\\\"--name-only\\\\\\\", start_sha, \\\\\\\"HEAD\\\\\\\").splitlines(),\\\\n83\\\\t                           records_rel)\\\\n84\\\\t\\\\n85\\\\t\\\\n86\\\\tdef matches_a_claim(path: str, claims: list[str]) -> bool:\\\\n87\\\\t    return any(fnmatch.fnmatch(path, pattern) for pattern in claims)\\\\n88\\\\t\\\\n89\\\\t\\\\n90\\\\tdef protected_path_touched(root: Path, start_sha: str, records_rel: str,\\\\n91\\\\t                           specs_rel: str) -> str | None:\\\\n92\\\\t    \\\\\\\"\\\\\\\"\\\\\\\"Th\\n220 {\\\"type\\\":\\\"user\\\",\\\"message\\\":{\\\"role\\\":\\\"user\\\",\\\"content\\\":[{\\\"tool_use_id\\\":\\\"toolu_01LVCSyR4KKEeqJknyDf9Np1\\\",\\\"type\\\":\\\"tool_result\\\",\\\"content\\\":\\\"1\\\\tfrom __future__ import annotations\\\\n2\\\\t\\\\n3\\\\timport fnmatch\\\\n4\\\\timport json\\\\n5\\\\timport os\\\\n6\\\\timport re\\\\n7\\\\timport subprocess\\\\n8\\\\tfrom pathlib import Path\\\\n9\\\\tfrom typing import Any\\\\n10\\\\t\\\\n11\\\\tfrom attavo.attest import check_attest_chain, item_time_and_cost\\\\n12\\\\tfrom attavo.common import (\\\\n13\\\\t    MANIFEST,\\\\n14\\\\t    Proof,\\\\n15\\\\t    STAGES,\\\\n16\\\\t    fixture_item_id,\\\\n17\\\\t    git,\\\\n18\\\\t    product_version,\\\\n19\\\\t    read_manifest,\\\\n20\\\\t)\\\\n21\\\\tfrom attavo.records import RECORD_RE, load_records, parse_attempts\\\\n22\\\\tfrom attavo.stops import STOP_CLASSES, STOP_PROVENANCES, STOP_STAGES, gate_stop\\\\n23\\\\t\\\\n24\\\\t# --- doctor's three proofs ---\\\\n25\\\\t\\\\n26\\\\tdef proof_every_gate_rejects(root: Path, m: dict[str, Any] | None) -> Proof:\\\\n27\\\\t    p = Proof(\\\\\\\"every-gate-rejects\\\\\\\", \\\\\\\"every gate rejects its fixture\\\\\\\")\\\\n28\\\\t    if m is None:\\\\n29\\\\t        return p.fail(f\\\\\\\"no {MANIFEST} at {root}; no gate is registered\\\\\\\")\\\\n30\\\\t    gates = m.get(\\\\\\\"gates\\\\\\\") or {}\\\\n31\\\\t    if not gates:\\\\n32\\\\t        return p.fail(\\\\\\\"[gates] is empty; a gate that has rejected nothing does not exist\\\\\\\")\\\\n33\\\\t    fixtures = root / m.get(\\\\\\\"paths\\\\\\\", {}).get(\\\\\\\"rejections\\\\\\\", \\\\\\\"\\\\\\\")\\\\n34\\\\t    # Proposal, not yet ruled on (issue #54): a gate that retires nothing\\\\n35\\\\t    # only adds, so proof one reports it here rather than waiting on the\\\\n36\\\\t    # schema alone -- read_manifest never validates against the manifest\\\\n37\\\\t    # schema at runtime, so a schema requirement is not an enforced one.\\\\n38\\\\t    no_retires = [name for name, gate in sorted(gates.items()) if not gate.get(\\\\\\\"retires\\\\\\\")]\\\\n39\\\\t    missing, accepted = [], []\\\\n40\\\\t    for name, gate in sorted(gates.items()):\\\\n41\\\\t        fixture = fixtures / name\\\\n42\\\\t        if not fixture.is_dir():\\\\n43\\\\t            missing.append(name)\\\\n44\\\\t            continue\\\\n45\\\\t        env = dict(os.environ)\\\\n46\\\\t        item = fixture_item_id(fixture)\\\\n47\\\\t        if item is not None:\\\\n48\\\\t            env[\\\\\\\"ATTAVO_ITEM\\\\\\\"] = item\\\\n49\\\\t        run = subprocess.run(gate[\\\\\\\"command\\\\\\\"], shell=True, cwd=str(fixture),\\\\n50\\\\t                             capture_output=True, text=True, check=False, env=env)\\\\n51\\\\t        if run.returncode == 0:\\\\n52\\\\t            accepted.append(name)\\\\n53\\\\t    if missing:\\\\n54\\\\t        return p.fail(f\\\\\\\"gate(s) with no rejection fixture: {', '.join(missing)}\\\\\\\")\\\\n55\\\\t    if accepted:\\\\n56\\\\t        return p.fail(f\\\\\\\"gate(s) that accepted their rejection fixture: {', '.join(accepted)}\\\\\\\")\\\\n57\\\\t    if no_retires:\\\\n58\\\\t        return p.fail(f\\\\\\\"gate(s) with no retires: {', '.join(no_retires)}\\\\\\\")\\\\n59\\\\t    return p.hold(f\\\\\\\"{len(gates)} gate(s) rejected their fixture\\\\\\\")\\\\n60\\\\t\\\\n61\\\\t\\\\n62\\\\tdef _merges_reachable(root: Path) -> tuple[list[dict[str, Any]], str | None]:\\\\n63\\\\t    \\\\\\\"\\\\\\\"\\\\\\\"(merges, refusal): every merge commit on the default branch's own\\\\n64\\\\t    first-parent line -- sha, parents, and its own first-parent diff --\\\\n65\\\\t    read by one process rather than the git log plus one git diff per\\\\n66\\\\t    merge merge_introducing_records used to pay walking toward the one\\\\n67\\\\t    it wants (issue #153). refs/remotes/origin/HEAD names the default\\\\n68\\\\t    branch without hard-coding \\\\\\\"main\\\\\\\", the same primitive\\\\n69\\\\t    diff_since_approval already uses (issue #52); walking from it rather\\\\n70\\\\t    than from HEAD is what keeps a transport merge on an item branch, a\\\\n71\\\\t    pull_request checkout's own synthetic test merge, and a merge_group's\\\\n72\\\\t    temporary merge from ever being mistaken for an item's merge (issue\\\\n73\\\\t    #169) -- none of those is reachable from the default branch's first-\\\\n74\\\\t    parent line by definition. When refs/remotes/origin/HEAD is not set,\\\\n75\\\\t    this refuses by name rather than guess, exactly as diff_since_approval\\\\n76\\\\t    does.\\\\n77\\\\t\\\\n78\\\\t    The walk starts at HEAD itself when the current checkout is literally\\\\n79\\\\t    on the branch refs/remotes/origin/HEAD names (an ordinary checko\\n235 {\\\"type\\\":\\\"user\\\",\\\"message\\\":{\\\"role\\\":\\\"user\\\",\\\"content\\\":[{\\\"tool_use_id\\\":\\\"toolu_01JWNPmFuq7TQmPjq3WRt9s5\\\",\\\"type\\\":\\\"tool_result\\\",\\\"content\\\":\\\"1\\\\tfrom __future__ import annotations\\\\n2\\\\t\\\\n3\\\\timport json\\\\n4\\\\tfrom pathlib import Path\\\\n5\\\\tfrom typing import Any\\\\n6\\\\t\\\\n7\\\\tfrom attavo.common import STAGES, ShallowCheckoutError, git\\\\n8\\\\tfrom attavo.doctor import invocations_without_record, merge_introducing_records, stall_bound_s\\\\n9\\\\tfrom attavo.drive import InvocationReading, drive_state, read_invocation, uncommitted_record\\\\n10\\\\tfrom attavo.records import next_attempt_number, parse_attempts\\\\n11\\\\tfrom attavo.types import CounselRecord, DriveReport\\\\n12\\\\tfrom attavo.verify import FORGE_OK_CONCLUSIONS, FORGE_UNCONCLUDED_STATUSES, read_forge_checks\\\\n13\\\\t\\\\n14\\\\t# --- drive --report (reconciler R1, rulings A and G): what one item is\\\\n15\\\\t# waiting on, and for whom -- drive's own decision (drive_state, the\\\\n16\\\\t# invocation readers recovery uses, read_forge_checks) read without acting\\\\n17\\\\t# on it. It writes nothing, starts nothing, and reads the forge once and\\\\n18\\\\t# never polls it, so a refusal is a level anyone can read again rather than\\\\n19\\\\t# a line drive printed once. `says` speaks the operator's words: a stage is\\\\n20\\\\t# \\\\\\\"build\\\\\\\" or \\\\\\\"review\\\\\\\", never the command that runs it. ---\\\\n21\\\\t\\\\n22\\\\t_WORD = {\\\\\\\"build\\\\\\\": \\\\\\\"build\\\\\\\", \\\\\\\"verify\\\\\\\": \\\\\\\"review\\\\\\\"}\\\\n23\\\\t\\\\n24\\\\t_COUNSEL_SAYS = {\\\\\\\"answer\\\\\\\": \\\\\\\"has an answer\\\\\\\", \\\\\\\"patch\\\\\\\": \\\\\\\"found a product defect\\\\\\\",\\\\n25\\\\t                 \\\\\\\"person\\\\\\\": \\\\\\\"says it is a person's call\\\\\\\"}\\\\n26\\\\t\\\\n27\\\\t\\\\n28\\\\tdef _head(root: Path) -> str | None:\\\\n29\\\\t    try:\\\\n30\\\\t        return git(root, \\\\\\\"rev-parse\\\\\\\", \\\\\\\"HEAD\\\\\\\").strip() or None\\\\n31\\\\t    except RuntimeError:\\\\n32\\\\t        return None\\\\n33\\\\t\\\\n34\\\\t\\\\n35\\\\tdef _latest(records_dir: Path, stage: str) -> tuple[str, dict[str, Any]] | None:\\\\n36\\\\t    \\\\\\\"\\\\\\\"\\\\\\\"(stem, record) of the highest-numbered <stage>-NN.json, or None.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n37\\\\t    attempts = parse_attempts(records_dir, stage)\\\\n38\\\\t    if not attempts:\\\\n39\\\\t        return None\\\\n40\\\\t    nn = max(attempts)\\\\n41\\\\t    return f\\\\\\\"{stage}-{nn:02d}\\\\\\\", attempts[nn]\\\\n42\\\\t\\\\n43\\\\t\\\\n44\\\\tdef _filed(records_dir: Path, stem: str) -> str | None:\\\\n45\\\\t    marker = records_dir / f\\\\\\\"{stem}.filed\\\\\\\"\\\\n46\\\\t    try:\\\\n47\\\\t        text = marker.read_text().strip()\\\\n48\\\\t    except OSError:\\\\n49\\\\t        return None\\\\n50\\\\t    return text or None\\\\n51\\\\t\\\\n52\\\\t\\\\n53\\\\tdef _counsel_of(records_dir: Path, stem: str) -> tuple[str, CounselRecord] | None:\\\\n54\\\\t    \\\\\\\"\\\\\\\"\\\\\\\"The latest counsel record that read the stop named stem.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n55\\\\t    attempts = parse_attempts(records_dir, \\\\\\\"counsel\\\\\\\")\\\\n56\\\\t    for nn in sorted(attempts, reverse=True):\\\\n57\\\\t        if attempts[nn].get(\\\\\\\"record\\\\\\\") == stem:\\\\n58\\\\t            return f\\\\\\\"counsel-{nn:02d}\\\\\\\", attempts[nn]\\\\n59\\\\t    return None\\\\n60\\\\t\\\\n61\\\\t\\\\n62\\\\tdef _stopped(r: DriveReport, records_dir: Path, stage: str, stem: str, record: dict[str, Any]) -> DriveReport:\\\\n63\\\\t    stop = record.get(\\\\\\\"stop\\\\\\\") or {}\\\\n64\\\\t    stop_class = stop.get(\\\\\\\"class\\\\\\\")\\\\n65\\\\t    r[\\\\\\\"state\\\\\\\"], r[\\\\\\\"kind\\\\\\\"], r[\\\\\\\"stage\\\\\\\"] = \\\\\\\"stopped\\\\\\\", \\\\\\\"yours\\\\\\\", stage\\\\n66\\\\t    r[\\\\\\\"attempt\\\\\\\"], r[\\\\\\\"record\\\\\\\"], r[\\\\\\\"stop_class\\\\\\\"] = int(stem.rsplit(\\\\\\\"-\\\\\\\", 1)[1]), stem, stop_class\\\\n67\\\\t    r[\\\\\\\"filed\\\\\\\"] = _filed(records_dir, stem)\\\\n68\\\\t    how = f\\\\\\\"as {stop_class}\\\\\\\" if stop_class else f\\\\\\\"({record.get('status')})\\\\\\\"\\\\n69\\\\t    says = f\\\\\\\"Needs you: {_WORD[stage]} attempt {stem.rsplit('-', 1)[1]} stopped {how}\\\\\\\"\\\\n70\\\\t    counsel = _counsel_of(records_dir, stem)\\\\n71\\\\t    if counsel:\\\\n72\\\\t        r[\\\\\\\"counsel\\\\\\\"] = counsel[0]\\\\n73\\\\t        verdict = _COUNSEL_SAYS.get(str(counsel[1].get(\\\\\\\"verdict\\\\\\\")))\\\\n74\\\\t        says += f\\\\\\\"; {counsel[0]} {verdict or 'could not read it'}\\\\\\\"\\\\n75\\\\t    if r[\\\\\\\"filed\\\\\\\"]:\\\\n76\\\\t        says += f\\\\\\\"; filed as {r['filed']}\\\\\\\"\\\\n77\\\\t    attempts = parse_attempts(records_dir, stage)\\\\n78\\\\t    rows: list[dict[str, Any]] = [\\\\n79\\\\t        {\\\\\\\"attempt\\\\\\\": nn, \\\\\\\"class\\\\\\\": ((rec.get(\\\\\\\"stop\\\\\\\") or {}).get(\\\\\\\"class\\\\\\\")),\\\\n80\\\\t         \\\\\\\"signature\\\\\\\": ((rec.get(\\\\\\\"stop\\\\\\\") or {}).get(\\\\\\\"signature\\\\\\\")),\\\\n81\\\\t       \\n237 {\\\"type\\\":\\\"user\\\",\\\"message\\\":{\\\"role\\\":\\\"user\\\",\\\"content\\\":[{\\\"tool_use_id\\\":\\\"toolu_01YCySNWW5FhQMuy7LHogqwy\\\",\\\"type\\\":\\\"tool_result\\\",\\\"content\\\":\\\"1\\\\t{\\\\n2\\\\t  \\\\\\\"$schema\\\\\\\": \\\\\\\"https://json-schema.org/draft/2020-12/schema\\\\\\\",\\\\n3\\\\t  \\\\\\\"$id\\\\\\\": \\\\\\\"https://attavo.dev/drive-report/v1\\\\\\\",\\\\n4\\\\t  \\\\\\\"title\\\\\\\": \\\\\\\"attavo drive --report\\\\\\\",\\\\n5\\\\t  \\\\\\\"description\\\\\\\": \\\\\\\"What one item is waiting on and for whom: a pure function of its records, its markers, and one read of the forge. Printing it changes nothing.\\\\\\\",\\\\n6\\\\t  \\\\\\\"type\\\\\\\": \\\\\\\"object\\\\\\\",\\\\n7\\\\t  \\\\\\\"additionalProperties\\\\\\\": false,\\\\n8\\\\t  \\\\\\\"required\\\\\\\": [\\\\n9\\\\t    \\\\\\\"item\\\\\\\",\\\\n10\\\\t    \\\\\\\"state\\\\\\\",\\\\n11\\\\t    \\\\\\\"kind\\\\\\\",\\\\n12\\\\t    \\\\\\\"says\\\\\\\",\\\\n13\\\\t    \\\\\\\"stage\\\\\\\",\\\\n14\\\\t    \\\\\\\"attempt\\\\\\\",\\\\n15\\\\t    \\\\\\\"record\\\\\\\",\\\\n16\\\\t    \\\\\\\"stop_class\\\\\\\",\\\\n17\\\\t    \\\\\\\"counsel\\\\\\\",\\\\n18\\\\t    \\\\\\\"filed\\\\\\\",\\\\n19\\\\t    \\\\\\\"head\\\\\\\",\\\\n20\\\\t    \\\\\\\"checks\\\\\\\",\\\\n21\\\\t    \\\\\\\"since\\\\\\\",\\\\n22\\\\t    \\\\\\\"last_event_age_s\\\\\\\",\\\\n23\\\\t    \\\\\\\"attempts\\\\\\\",\\\\n24\\\\t    \\\\\\\"signatures_match\\\\\\\",\\\\n25\\\\t    \\\\\\\"rulings_available\\\\\\\"\\\\n26\\\\t  ],\\\\n27\\\\t  \\\\\\\"properties\\\\\\\": {\\\\n28\\\\t    \\\\\\\"item\\\\\\\": {\\\\n29\\\\t      \\\\\\\"type\\\\\\\": \\\\\\\"string\\\\\\\"\\\\n30\\\\t    },\\\\n31\\\\t    \\\\\\\"state\\\\\\\": {\\\\n32\\\\t      \\\\\\\"type\\\\\\\": \\\\\\\"string\\\\\\\",\\\\n33\\\\t      \\\\\\\"enum\\\\\\\": [\\\\n34\\\\t        \\\\\\\"waiting-on-approval\\\\\\\",\\\\n35\\\\t        \\\\\\\"running\\\\\\\",\\\\n36\\\\t        \\\\\\\"owes-recovery\\\\\\\",\\\\n37\\\\t        \\\\\\\"stopped\\\\\\\",\\\\n38\\\\t        \\\\\\\"next-build\\\\\\\",\\\\n39\\\\t        \\\\\\\"waiting-on-checks\\\\\\\",\\\\n40\\\\t        \\\\\\\"blocked-on-checks\\\\\\\",\\\\n41\\\\t        \\\\\\\"next-review\\\\\\\",\\\\n42\\\\t        \\\\\\\"ready-to-merge\\\\\\\",\\\\n43\\\\t        \\\\\\\"merged\\\\\\\",\\\\n44\\\\t        \\\\\\\"refused\\\\\\\"\\\\n45\\\\t      ]\\\\n46\\\\t    },\\\\n47\\\\t    \\\\\\\"kind\\\\\\\": {\\\\n48\\\\t      \\\\\\\"type\\\\\\\": \\\\\\\"string\\\\\\\",\\\\n49\\\\t      \\\\\\\"enum\\\\\\\": [\\\\n50\\\\t        \\\\\\\"yours\\\\\\\",\\\\n51\\\\t        \\\\\\\"waits\\\\\\\",\\\\n52\\\\t        \\\\\\\"acts\\\\\\\",\\\\n53\\\\t        \\\\\\\"done\\\\\\\"\\\\n54\\\\t      ],\\\\n55\\\\t      \\\\\\\"description\\\\\\\": \\\\\\\"yours: a person's act is next. waits: nothing to do but wait. acts: the next drive would act. done: nothing further from here.\\\\\\\"\\\\n56\\\\t    },\\\\n57\\\\t    \\\\\\\"says\\\\\\\": {\\\\n58\\\\t      \\\\\\\"type\\\\\\\": \\\\\\\"string\\\\\\\",\\\\n59\\\\t      \\\\\\\"description\\\\\\\": \\\\\\\"One sentence in the operator's words.\\\\\\\"\\\\n60\\\\t    },\\\\n61\\\\t    \\\\\\\"stage\\\\\\\": {\\\\n62\\\\t      \\\\\\\"type\\\\\\\": [\\\\n63\\\\t        \\\\\\\"string\\\\\\\",\\\\n64\\\\t        \\\\\\\"null\\\\\\\"\\\\n65\\\\t      ],\\\\n66\\\\t      \\\\\\\"enum\\\\\\\": [\\\\n67\\\\t        \\\\\\\"build\\\\\\\",\\\\n68\\\\t        \\\\\\\"verify\\\\\\\",\\\\n69\\\\t        null\\\\n70\\\\t      ]\\\\n71\\\\t    },\\\\n72\\\\t    \\\\\\\"attempt\\\\\\\": {\\\\n73\\\\t      \\\\\\\"type\\\\\\\": [\\\\n74\\\\t        \\\\\\\"integer\\\\\\\",\\\\n75\\\\t        \\\\\\\"null\\\\\\\"\\\\n76\\\\t      ]\\\\n77\\\\t    },\\\\n78\\\\t    \\\\\\\"record\\\\\\\": {\\\\n79\\\\t      \\\\\\\"type\\\\\\\": [\\\\n80\\\\t        \\\\\\\"string\\\\\\\",\\\\n81\\\\t        \\\\\\\"null\\\\\\\"\\\\n82\\\\t      ]\\\\n83\\\\t    },\\\\n84\\\\t    \\\\\\\"stop_class\\\\\\\": {\\\\n85\\\\t      \\\\\\\"type\\\\\\\": [\\\\n86\\\\t        \\\\\\\"string\\\\\\\",\\\\n87\\\\t        \\\\\\\"null\\\\\\\"\\\\n88\\\\t      ]\\\\n89\\\\t    },\\\\n90\\\\t    \\\\\\\"counsel\\\\\\\": {\\\\n91\\\\t      \\\\\\\"type\\\\\\\": [\\\\n92\\\\t        \\\\\\\"string\\\\\\\",\\\\n93\\\\t        \\\\\\\"null\\\\\\\"\\\\n94\\\\t      ]\\\\n95\\\\t    },\\\\n96\\\\t    \\\\\\\"filed\\\\\\\": {\\\\n97\\\\t      \\\\\\\"type\\\\\\\": [\\\\n98\\\\t        \\\\\\\"string\\\\\\\",\\\\n99\\\\t        \\\\\\\"null\\\\\\\"\\\\n100\\\\t      ]\\\\n101\\\\t    },\\\\n102\\\\t    \\\\\\\"head\\\\\\\": {\\\\n103\\\\t      \\\\\\\"type\\\\\\\": [\\\\n104\\\\t        \\\\\\\"string\\\\\\\",\\\\n105\\\\t        \\\\\\\"null\\\\\\\"\\\\n106\\\\t      ]\\\\n107\\\\t    },\\\\n108\\\\t    \\\\\\\"checks\\\\\\\": {\\\\n109\\\\t      \\\\\\\"type\\\\\\\": [\\\\n110\\\\t        \\\\\\\"array\\\\\\\",\\\\n111\\\\t        \\\\\\\"null\\\\\\\"\\\\n112\\\\t      ],\\\\n113\\\\t      \\\\\\\"items\\\\\\\": {\\\\n114\\\\t        \\\\\\\"type\\\\\\\": \\\\\\\"object\\\\\\\",\\\\n115\\\\t        \\\\\\\"required\\\\\\\": [\\\\n116\\\\t          \\\\\\\"name\\\\\\\",\\\\n117\\\\t          \\\\\\\"conclusion\\\\\\\"\\\\n118\\\\t        ],\\\\n119\\\\t        \\\\\\\"properties\\\\\\\": {\\\\n120\\\\t          \\\\\\\"name\\\\\\\": {\\\\n121\\\\t            \\\\\\\"type\\\\\\\": \\\\\\\"string\\\\\\\"\\\\n122\\\\t          },\\\\n123\\\\t          \\\\\\\"conclusion\\\\\\\": {\\\\n124\\\\t            \\\\\\\"type\\\\\\\": \\\\\\\"string\\\\\\\"\\\\n125\\\\t          }\\\\n126\\\\t        }\\\\n127\\\\t      }\\\\n128\\\\t    },\\\\n129\\\\t    \\\\\\\"since\\\\\\\": {\\\\n130\\\\t      \\\\\\\"type\\\\\\\": [\\\\n131\\\\t        \\\\\\\"string\\\\\\\",\\\\n132\\\\t        \\\\\\\"null\\\\\\\"\\\\n133\\\\t      ]\\\\n134\\\\t    },\\\\n135\\\\t    \\\\\\\"last_event_age_s\\\\\\\": {\\\\n136\\\\t      \\\\\\\"type\\\\\\\": [\\\\n137\\\\t        \\\\\\\"integer\\\\\\\",\\\\n138\\\\t        \\\\\\\"null\\\\\\\"\\\\n139\\\\t      ]\\\\n140\\\\t    },\\\\n141\\\\t    \\\\\\\"attempts\\\\\\\": {\\\\n142\\\\t      \\\\\\\"type\\\\\\\": [\\\\\\\"array\\\\\\\", \\\\\\\"null\\\\\\\"],\\\\n143\\\\t      \\\\\\\"items\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"object\\\\\\\"},\\\\n144\\\\t      \\\\\\\"description\\\\\\\": \\\\\\\"R3: on a stopped stage, one entry per attempt: attempt, class, signature, bound, wall_clock_s, cost_usd; null otherwise\\\\\\\"\\\\n145\\\\t    },\\\\n146\\\\t    \\\\\\\"s\\n247 {\\\"type\\\":\\\"user\\\",\\\"message\\\":{\\\"role\\\":\\\"user\\\",\\\"content\\\":[{\\\"tool_use_id\\\":\\\"toolu_01JoUMXoFjhc8BTF3GKXevqJ\\\",\\\"type\\\":\\\"tool_result\\\",\\\"content\\\":\\\"465:def test_drive_until_ready_stops_when_the_forge_goes_red_after_a_build(tmp_path: Path) -> None:\\\\n466-    \\\\\\\"\\\\\\\"\\\\\\\"A build that passes, then a forge that concludes red on its head,\\\\n467-    stops the loop there with exit 1 -- the loop gave up short of ready\\\\n468-    -- one record written (the pass), no review record, no retry of the\\\\n469-    forge read.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n470-    root = make_tenant(tmp_path, \\\\\\\"build_valid\\\\\\\")\\\\n471-    add_forge(root, RED_FORGE)\\\\n472-    add_bare_remote(root, tmp_path)\\\\n473-    approve_item(root)\\\\n474-\\\\n475-    run = run_attavo(root, \\\\\\\"drive\\\\\\\", \\\\\\\"1\\\\\\\", \\\\\\\"--until-ready\\\\\\\")\\\\n476-    assert run.returncode == 1, run.stdout + run.stderr\\\\n477-    assert \\\\\\\"ci\\\\\\\" in run.stdout and \\\\\\\"failure\\\\\\\" in run.stdout\\\\n478-\\\\n479-    assert len(record_files(root, \\\\\\\"build\\\\\\\")) == 1\\\\n480-    assert latest_record(root, \\\\\\\"build\\\\\\\")[\\\\\\\"status\\\\\\\"] == \\\\\\\"pass\\\\\\\"\\\\n481-    assert record_files(root, \\\\\\\"verify\\\\\\\") == []\\\\n482-\\\\n483-\\\\n484-\\\\n485-def test_drive_line_buffers_stdout_so_a_pipe_reader_sees_the_start_line_before_the_stage_ends(tmp_path: Path) -> None:\\\\n486-    \\\\\\\"\\\\\\\"\\\\\\\"Issue #145, kept under R2. A pipe reader of `attavo drive` saw\\\\n487-    every line arrive as one burst when the process ended -- Python\\\\n488-    block-buffers stdout when it is not a tty. With --until-ready the\\\\n489-    process now outlives a slow stage; a pipe reader with a timeout well\\\\n490-    under the stage's own sleep must already see the \\\\\\\"started\\\\\\\" line the\\\\n491-    pass printed before that sleep ends -- unreachable if stdout is\\\\n492-    still block-buffered. The worker reconfigures its own stdout the same\\\\n493-    way, so its log is readable while it runs.\\\\n494-    \\\\\\\"\\\\\\\"\\\\\\\"\\\\n495-    root = make_tenant(tmp_path, \\\\\\\"build_valid\\\\\\\")\\\\n496-    add_forge(root, GREEN_FORGE)\\\\n497-    add_bare_remote(root, tmp_path)\\\\n498-    approve_item(root)\\\\n499-\\\\n500-    sleep_s = 3.0\\\\n501-    adapter_dir = root / \\\\\\\"attavo\\\\\\\" / \\\\\\\"adapters\\\\\\\" / \\\\\\\"slow\\\\\\\"\\\\n502-    adapter_dir.mkdir(parents=True)\\\\n503-    adapter_run = adapter_dir / \\\\\\\"run\\\\\\\"\\\\n504-    adapter_run.write_text(\\\\n505-        \\\\\\\"#!/bin/sh\\\\\\\\n\\\\\\\"\\\\n--\\\\n563:def test_drive_pass_reads_a_red_forge_as_blocked_and_starts_nothing(tmp_path: Path) -> None:\\\\n564-    \\\\\\\"\\\\\\\"\\\\\\\"Acceptance row 4, as a level. A forge read where the one check has\\\\n565-    already concluded and failed is not polled at all -- the pass reads\\\\n566-    the forge once, says Blocked naming the check, exits 0, and starts\\\\n567-    no review: no marker, no verify record, no new commit, no sleep.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n568-    root = make_tenant(tmp_path, \\\\\\\"build_valid\\\\\\\")\\\\n569-    add_forge(root, RED_FORGE)\\\\n570-    add_bare_remote(root, tmp_path)\\\\n571-    approve_item(root)\\\\n572-\\\\n573-    assert drive(root, \\\\\\\"1\\\\\\\").returncode == 0  # builds\\\\n574-    pre_head = head_of(root)\\\\n575-\\\\n576-    started = time.monotonic()\\\\n577-    run = drive(root, \\\\\\\"1\\\\\\\")\\\\n578-    elapsed = time.monotonic() - started\\\\n579-    assert run.returncode == 0, run.stdout + run.stderr\\\\n580-    assert \\\\\\\"Blocked\\\\\\\" in run.stdout and \\\\\\\"ci failure\\\\\\\" in run.stdout\\\\n581-    assert \\\\\\\"worker pid\\\\\\\" not in run.stdout\\\\n582-    assert elapsed < 0.4, (\\\\n583-        f\\\\\\\"a concluded, red forge check is read once with no poll interval slept \\\\\\\"\\\\n584-        f\\\\\\\"-- took {elapsed:.2f}s\\\\\\\")\\\\n585-\\\\n586-    assert record_files(root, \\\\\\\"verify\\\\\\\") == []\\\\n587-    assert not (records_dir(root) / \\\\\\\"verify-01.started\\\\\\\").exists()\\\\n588-    assert head_of(root) == pre_head\\\\n589-\\\\n590-    # Idempotence (row 8): a pass in the same red state says the same,\\\\n591-    # still nothing written.\\\\n592-    run2 = drive(root, \\\\\\\
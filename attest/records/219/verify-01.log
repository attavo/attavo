{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,460p' tests/test_retry.py; sed -n '1,240p' attavo/stops.py; sed -n '240,460p' attavo/stops.py; sed -n '250,380p' attavo/drive.py; sed -n '520,880p' attavo/drive.py\"","aggregated_output":"\"\"\"The reconciler's R3 (claude/reconciler-brief-2026-09-20.md ruling C and\nits amendments; claude/r3-rulings-2026-09-25.md): a stage that stops for a\nreason that does not touch the definition of done is started again by a\npass, not a person. Four retryable families (died, hung, transient,\nreturned), one budget of [drive].attempts per stage, an early stop on two\nidentical failure signatures, an exhaustion report, stage ceilings, and\nthe prior attempt's evidence handed to the next through the feedback file\nthe adapter contract already passes.\n\nEvery test drives a fixture tenant through `attavo drive N` passes alone\nand reads records, never internals. Written red first against d20fdea\n(R2 as merged) and against R3's thin stub.\n\nRun: python3 -m pytest tests -q\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport os\nimport subprocess\nimport time\nfrom pathlib import Path\nfrom typing import Any\n\nfrom helpers import commit_all, git, make_tenant\nfrom test_drive import (\n    GREEN_FORGE,\n    add_bare_remote,\n    add_forge,\n    approve_item,\n    latest_record,\n    record_files,\n    records_dir,\n    run_attavo,\n)\nfrom test_pass import FAST, pushed, report, wait_for\n\nROOT = Path(__file__).resolve().parent.parent\nFIXTURE_RUN = ROOT / \"adapters\" / \"fixture\" / \"run\"\n\nDONE_LINE = ('{\"status\":\"done\",\"question\":null,\"model\":\"fixture\",\"model_version\":null,'\n             '\"adapter_version\":\"fixture-1\",\"tokens\":{\"input\":1,\"output\":1},\"cost_usd\":0.0}')\nTRANSIENT_LINE = ('{\"status\":\"failed\",\"question\":null,\"class\":\"transient\",'\n                  '\"detail\":\"API error: overloaded, retry after 30s\",\"model\":\"fixture\",'\n                  '\"model_version\":null,\"adapter_version\":\"fixture-1\",'\n                  '\"tokens\":{\"input\":1,\"output\":1},\"cost_usd\":0.0}')\n\n\ndef add_drive_table(root: Path, *, attempts: int = 3, retry_after_s: int = 0,\n                    build_ceiling_s: int = 600, verify_ceiling_s: int = 600,\n                    stall_after_s: int = 60) -> None:\n    toml = root / \"attavo.toml\"\n    toml.write_text(toml.read_text() + (\n        f\"\\n[drive]\\nstall_after_s = {stall_after_s}\\nattempts = {attempts}\\n\"\n        f\"retry_after_s = {retry_after_s}\\n\\n[drive.build]\\nceiling_s = {build_ceiling_s}\\n\\n\"\n        f\"[drive.verify]\\nceiling_s = {verify_ceiling_s}\\n\"))\n    commit_all(root, \"declare the drive table\")\n\n\ndef tenant_adapter(root: Path, build_prelude: str, streams_events: bool | None = None) -> None:\n    \"\"\"A tenant-side build adapter: `build_prelude` runs first on the build\n    stage (it may exit), then the product's own fixture adapter. A build\n    that is retried on a tree already carrying built.txt rewrites it, so\n    the fixture's own commit has something to commit.\"\"\"\n    d = root / \"attavo\" / \"adapters\" / \"fixture\"\n    d.mkdir(parents=True, exist_ok=True)\n    (d / \"run\").write_text(\n        \"#!/bin/sh\\n\"\n        'if [ \"${ATTAVO_STAGE:-build}\" = build ]; then\\n'\n        f\"{build_prelude}\\n\"\n        \"  if [ -f built.txt ]; then\\n\"\n        '    echo \"built again $(date +%s%N)\" > built.txt\\n'\n        \"    git add built.txt\\n\"\n        \"    git commit -q -m 'fixture: write built.txt again'\\n\"\n        f\"    echo '{DONE_LINE}'\\n\"\n        \"    exit 0\\n\"\n        \"  fi\\n\"\n        \"fi\\n\"\n        f\"exec sh {FIXTURE_RUN}\\n\")\n    (d / \"run\").chmod(0o755)\n    if streams_events is not None:\n        (d / \"conformance.json\").write_text(json.dumps({\"streams_events\": streams_events}) + \"\\n\")\n    commit_all(root, \"a tenant-side adapter\")\n\n\ndef approved_tenant(tmp_path: Path, build_prelude: str = \"\", **drive: Any) -> tuple[Path, Path]:\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    add_drive_table(root, **drive)\n    tenant_adapter(root, build_prelude)\n    bare = add_bare_remote(root, tmp_path)\n    approve_item(root)\n    commit_all(root, \"approved\")\n    git(root, \"push\", \"-q\", \"origin\", \"HEAD:main\")\n    return root, bare\n\n\ndef passes_until(root: Path, pred: Any, seconds: float = 40, env: dict[str, str] | None = None) -> None:\n    \"\"\"Passes, spaced, until pred holds: how an operator's loop, the\n    screen's poll, or a scheduler line would drive the item.\"\"\"\n    deadline = time.monotonic() + seconds\n    full = dict(FAST)\n    full.update(env or {})\n    while time.monotonic() < deadline:\n        run_attavo(root, \"drive\", \"1\", env=full)\n        if pred():\n            return\n        time.sleep(0.5)\n    raise AssertionError(\"condition not met in time\")\n\n\ndef stop_of(root: Path, stage: str, nn: int) -> dict[str, Any]:\n    rec = json.loads((records_dir(root) / f\"{stage}-{nn:02d}.json\").read_text())\n    return dict(rec.get(\"stop\") or {})\n\n\ndef counsel_records(root: Path) -> list[Path]:\n    return record_files(root, \"counsel\")\n\n\ndef test_a_transient_stop_retries_plainly_after_the_wait(tmp_path: Path) -> None:\n    \"\"\"Ruling C: a vendor's capacity, rate, or 5xx refusal is `transient`;\n    the next pass starts the next attempt, asks counsel nothing, and\n    waits [drive].retry_after_s first (#194's verify-01 paid for a\n    counsel run and two presses on exactly this).\"\"\"\n    prelude = ('  if [ ! -f \"$ATTAVO_RECORDS_DIR/build-01.json\" ]; then\\n'\n               f\"    echo '{TRANSIENT_LINE}'\\n    exit 1\\n  fi\")\n    root, bare = approved_tenant(tmp_path, prelude, retry_after_s=3)\n    assert run_attavo(root, \"drive\", \"1\", env=FAST).returncode == 0\n    wait_for(lambda: pushed(bare, \"build record for item 1 (build-01)\"))\n    assert stop_of(root, \"build\", 1)[\"class\"] == \"transient\"\n    assert stop_of(root, \"build\", 1)[\"signature\"] == \"API error: overloaded, retry after s\"\n\n    # inside the wait: a pass reads the level and starts nothing\n    early = run_attavo(root, \"drive\", \"1\", env=FAST)\n    assert early.returncode == 0 and \"retrying\" in early.stdout.lower(), early.stdout\n    assert not (records_dir(root) / \"build-02.started\").exists()\n\n    passes_until(root, lambda: len(record_files(root, \"build\")) == 2, seconds=40)\n    rec = latest_record(root, \"build\")\n    assert rec[\"status\"] == \"pass\" and rec[\"retry_of\"] == \"build-01\", rec\n    assert counsel_records(root) == []\n\n\ndef test_died_and_hung_retry_on_the_next_pass(tmp_path: Path) -> None:\n    \"\"\"A recovered died attempt is retried by the pass after the one that\n    recovered it, with no wait and no counsel; the retried record names\n    what it retries.\"\"\"\n    prelude = ('  if [ ! -f \"$ATTAVO_RECORDS_DIR/build-01.json\" ]; then\\n'\n               \"    kill -9 $PPID\\n    sleep 3\\n  fi\")\n    root, bare = approved_tenant(tmp_path, prelude)\n    assert run_attavo(root, \"drive\", \"1\", env=FAST).returncode == 0\n    passes_until(root, lambda: (records_dir(root) / \"build-01.json\").exists(), seconds=30)\n    assert stop_of(root, \"build\", 1)[\"class\"] == \"died\"\n    passes_until(root, lambda: len(record_files(root, \"build\")) == 2, seconds=30)\n    rec = latest_record(root, \"build\")\n    assert rec[\"status\"] == \"pass\" and rec[\"retry_of\"] == \"build-01\", rec\n    assert counsel_records(root) == []\n\n\ndef test_a_red_check_becomes_a_returned_record_with_the_log_as_evidence(tmp_path: Path) -> None:\n    \"\"\"Ruling C amended (#206's build-01): a concluded red required check\n    on a passed build's head is a returned review record, class returned,\n    the red checks its signature; the next build's first feedback carries\n    the check's log read through [forge].check_log_command; no operator\n    act between approval and the passing review.\"\"\"\n    calls = tmp_path / \"forge-calls\"\n    forge = tmp_path / \"forge.sh\"\n    forge.write_text(f'#!/bin/sh\\nn=$(cat {calls} 2>/dev/null || echo 0)\\nn=$((n+1))\\nprintf %s \"$n\" > {calls}\\n'\n                     'if [ \"$n\" = 1 ]; then printf \"typecheck failure\\\\n\"; else printf \"typecheck success\\\\n\"; fi\\n')\n    check_log = tmp_path / \"checklog.sh\"\n    check_log.write_text('#!/bin/sh\\nprintf \"attavo/x.py:12: error: Incompatible return value type\\\\n\"\\n')\n    feedback_copy = tmp_path / \"feedback\"\n    prelude = (f'  cp \"${{ATTAVO_FEEDBACK:-/dev/null}}\" \"{feedback_copy}.$(ls \"$ATTAVO_RECORDS_DIR\" | grep -c \"^build-.*\\\\.started$\")\" 2>/dev/null || true')\n    root = make_tenant(tmp_path, \"build_valid\")\n    toml = root / \"attavo.toml\"\n    toml.write_text(toml.read_text() + f'\\n[forge]\\nchecks_command = \"sh {forge}\"\\ncheck_log_command = \"sh {check_log}\"\\n')\n    commit_all(root, \"a forge that reads red once\")\n    add_drive_table(root)\n    tenant_adapter(root, prelude)\n    bare = add_bare_remote(root, tmp_path)\n    approve_item(root)\n    commit_all(root, \"approved\")\n    git(root, \"push\", \"-q\", \"origin\", \"HEAD:main\")\n    approved_at = git(root, \"rev-parse\", \"HEAD\").strip()\n\n    passes_until(root, lambda: pushed(bare, \"verify record for item 1 (verify-01)\"), seconds=40)\n    returned = latest_record(root, \"verify\")\n    assert returned[\"status\"] == \"returned\", returned\n    assert returned[\"stop\"][\"class\"] == \"returned\" and returned[\"stop\"][\"signature\"] == \"typecheck\", returned[\"stop\"]\n\n    passes_until(root, lambda: pushed(bare, \"build record for item 1 (build-02)\"), seconds=40)\n    assert latest_record(root, \"build\")[\"retry_of\"] == \"build-01\"\n    second = (feedback_copy.parent / (feedback_copy.name + \".2\")).read_text()\n    assert \"typecheck\" in second and \"Incompatible return value type\" in second, second\n\n    passes_until(root, lambda: pushed(bare, \"verify record for item 1 (verify-02)\"), seconds=40)\n    assert latest_record(root, \"verify\")[\"status\"] == \"pass\"\n    authors = set(git(root, \"log\", \"--format=%an\", f\"{approved_at}..origin/main\").splitlines())\n    assert authors <= {\"attavo driver\", \"attavo executor (fixture)\"}, authors\n\n\ndef test_a_returned_review_retries_with_its_findings_and_counsels_on_the_second(tmp_path: Path) -> None:\n    \"\"\"A review that returns blocking findings is the returned family: the\n    next build is handed the findings, counsel is not asked on the first\n    return and is asked on the second identical one.\"\"\"\n    findings = tmp_path / \"findings.json\"\n    findings.write_text(json.dumps([{\"title\": \"the helper is never called\", \"specimen\": \"x\", \"retires\": \"y\",\n                                     \"rejection_test\": \"z\", \"severity\": \"blocking\"}]))\n    feedback_copy = tmp_path / \"feedback\"\n    prelude = (f'  cp \"${{ATTAVO_FEEDBACK:-/dev/null}}\" \"{feedback_copy}.$(ls \"$ATTAVO_RECORDS_DIR\" | grep -c \"^build-.*\\\\.started$\")\" 2>/dev/null || true')\n    root, bare = approved_tenant(tmp_path, prelude)\n    d = root / \"attavo\" / \"adapters\" / \"fixture\"\n    run = (d / \"run\").read_text()\n    verify_branch = ('if [ \"${ATTAVO_STAGE:-build}\" = verify ]; then\\n'\n                     f'  printf \\'{{\"model\":\"fixture\",\"model_version\":null,\"adapter_version\":\"fixture-1\",\"tokens\":{{\"input\":1,\"output\":1}},\"cost_usd\":0.0,\"findings\":%s,\"tests_named\":[]}}\\\\n\\' \"$(cat {findings})\"\\n'\n                     \"  exit 0\\nfi\\n\")\n    (d / \"run\").write_text(run.replace(\"#!/bin/sh\\n\", \"#!/bin/sh\\n\" + verify_branch, 1))\n    commit_all(root, \"a review that returns a blocking finding\")\n    git(root, \"push\", \"-q\", \"origin\", \"HEAD:main\")\n    manifest = root / \"attavo.toml\"\n    manifest.write_text(manifest.read_text().replace('[executor]\\nbuild = \"fixture\"', '[executor]\\nbuild = \"fixture\"\\ncounsel = \"fixture\"'))\n    commit_all(root, \"counsel configured\")\n    git(root, \"push\", \"-q\", \"origin\", \"HEAD:main\")\n\n    passes_until(root, lambda: pushed(bare, \"verify record for item 1 (verify-01)\"), seconds=40)\n    first = latest_record(root, \"verify\")\n    assert first[\"status\"] != \"pass\" and first[\"stop\"][\"class\"] == \"returned\", first\n    assert first[\"stop\"][\"signature\"] == \"the helper is never called\"\n    assert counsel_records(root) == [], \"counsel is not asked on the first return\"\n\n    passes_until(root, lambda: pushed(bare, \"build record for item 1 (build-02)\"), seconds=40)\n    assert latest_record(root, \"build\")[\"retry_of\"] == \"build-01\"\n    assert \"the helper is never called\" in (feedback_copy.parent / (feedback_copy.name + \".2\")).read_text()\n\n    passes_until(root, lambda: pushed(bare, \"verify record for item 1 (verify-02)\"), seconds=40)\n    passes_until(root, lambda: counsel_records(root) != [], seconds=20)\n    assert latest_record(root, \"counsel\")[\"record\"] == \"verify-02\"\n\n\ndef test_counsels_verdict_routes_the_next_pass(tmp_path: Path) -> None:\n    \"\"\"Counsel steers: `answer` starts the next attempt with the answer as\n    its steer (recorded in `steer`); `patch` starts nothing and the\n    report reads waiting on the issue; `person` starts nothing.\"\"\"\n    responses = tmp_path / \"counsel\"\n    responses.mkdir()\n    for verdict in (\"answer\", \"patch\", \"person\"):\n        (responses / f\"{verdict}.json\").write_text(json.dumps({\n            \"model\": \"fixture\", \"model_version\": None, \"adapter_version\": \"fixture-1\",\n            \"tokens\": {\"input\": 1, \"output\": 1}, \"cost_usd\": 0.0, \"class\": \"question\", \"verdict\": verdict,\n            \"citations\": [{\"kind\": \"instruction\", \"path\": \"specs/1/spec.md\", \"symbol\": \"problem\"}],\n            \"proposal\": {\"ruling_text\": \"use the base tree\" if verdict == \"answer\" else None,\n                         \"patch\": \"the fixture cannot read overlays\" if verdict == \"patch\" else None,\n                         \"question\": None if verdict != \"person\" else \"which overlay wins?\"}}))\n    for verdict, expect_attempt in ((\"answer\", 2), (\"patch\", 1), (\"person\", 1)):\n        sub = tmp_path / verdict\n        sub.mkdir()\n        root, bare = approved_tenant(sub)\n        manifest = root / \"attavo.toml\"\n        manifest.write_text(manifest.read_text().replace('[executor]\\nbuild = \"fixture\"', '[executor]\\nbuild = \"fixture\"\\ncounsel = \"fixture\"'))\n        commit_all(root, \"counsel configured\")\n        git(root, \"push\", \"-q\", \"origin\", \"HEAD:main\")\n        env = {\"ATTAVO_FIXTURE_QUESTION\": \"which overlay wins?\",\n               \"ATTAVO_FIXTURE_COUNSEL_RESPONSE\": str(responses / f\"{verdict}.json\")}\n        passes_until(root, lambda: pushed(bare, \"build record for item 1 (build-01)\"), seconds=40, env=env)\n        assert latest_record(root, \"counsel\")[\"verdict\"] == verdict\n        for _ in range(3):\n            run_attavo(root, \"drive\", \"1\", env={**FAST, **env})\n            time.sleep(0.5)\n        if expect_attempt == 2:\n            passes_until(root, lambda: len(record_files(root, \"build\")) == 2, seconds=30, env={**env, \"ATTAVO_FIXTURE_QUESTION\": \"\"})\n            assert latest_record(root, \"build\")[\"steer\"] == \"counsel-01\"\n        else:\n            assert len(record_files(root, \"build\")) == 1, verdict\n            out = report(root)\n            assert out[\"state\"] == \"stopped\", out\n            if verdict == \"patch\":\n                assert \"waiting on\" in out[\"says\"], out[\"says\"]\n\n\ndef test_a_persons_stop_is_never_retried(tmp_path: Path) -> None:\n    \"\"\"A question with no counsel configured, a claims-boundary stop, and\n    an environment refusal are a person's: three passes over each start\n    nothing.\"\"\"\n    cases = {\n        \"question\": ({\"ATTAVO_FIXTURE_QUESTION\": \"which overlay wins?\"}, \"\"),\n        \"claims\": ({\"ATTAVO_FIXTURE_WRITE\": \"outside/claims.txt\"}, \"\"),\n    }\n    for name, (env, prelude) in cases.items():\n        sub = tmp_path / name\n        sub.mkdir()\n        root, bare = approved_tenant(sub, prelude)\n        full = {**FAST, **env}\n        run_attavo(root, \"drive\", \"1\", env=full)\n        wait_for(lambda: pushed(bare, \"build record for item 1 (build-01)\"))\n        first = latest_record(root, \"build\")\n        assert first[\"status\"] != \"pass\", (name, first)\n        for _ in range(3):\n            run_attavo(root, \"drive\", \"1\", env=full)\n            time.sleep(0.3)\n        assert len(record_files(root, \"build\")) == 1, name\n        assert not (records_dir(root) / \"build-02.started\").exists(), name\n        assert report(root)[\"state\"] == \"stopped\"\n\n\ndef test_identical_failures_stop_early_and_the_budget_holds(tmp_path: Path) -> None:\n    \"\"\"Two attempts ending with the identical signature stop the stage at\n    two; two different signatures proceed to a third; a fourth never\n    starts.\"\"\"\n    same = ('  at=\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"\\n'\n            '  printf \\'{\"at\":\"%s\",\"kind\":\"tool_call\",\"text\":\"fixture-tool waiting on lock 4471\"}\\\\n\\' \"$at\" >> \"$ATTAVO_EVENTS\"\\n'\n            \"  kill -9 $PPID\\n  sleep 3\")\n    root, _bare = approved_tenant(tmp_path / \"same\", same)\n    passes_until(root, lambda: len(record_files(root, \"build\")) == 2, seconds=60)\n    for _ in range(6):\n        run_attavo(root, \"drive\", \"1\", env=FAST)\n        time.sleep(0.5)\n    assert len(record_files(root, \"build\")) == 2\n    assert not (records_dir(root) / \"build-03.started\").exists()\n    assert stop_of(root, \"build\", 1)[\"signature\"] == stop_of(root, \"build\", 2)[\"signature\"]\n\n    differ = ('  at=\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"\\n'\n              '  n=$(ls \"$ATTAVO_RECORDS_DIR\" | grep -c \"^build-.*\\\\.started$\")\\n'\n              '  printf \\'{\"at\":\"%s\",\"kind\":\"tool_call\",\"text\":\"fixture-tool step %s of the plan\"}\\\\n\\' \"$at\" \"$(printf \"%s\" \"$n\" | tr 0-9 a-j)\" >> \"$ATTAVO_EVENTS\"\\n'\n              \"  kill -9 $PPID\\n  sleep 3\")\n    root2, _ = approved_tenant(tmp_path / \"differ\", differ)\n    passes_until(root2, lambda: len(record_files(root2, \"build\")) == 3, seconds=90)\n    for _ in range(6):\n        run_attavo(root2, \"drive\", \"1\", env=FAST)\n        time.sleep(0.5)\n    assert len(record_files(root2, \"build\")) == 3\n    assert not (records_dir(root2) / \"build-04.started\").exists()\n    out = report(root2)\n    assert out[\"state\"] == \"stopped\" and len(out[\"attempts\"]) == 3, out\n\n\ndef test_every_marker_spends_the_budget(tmp_path: Path) -> None:\n    \"\"\"A recovered attempt counts: with attempts = 2, one died attempt and\n    one transient attempt spend the budget and a third never starts,\n    though the two signatures differ.\"\"\"\n    prelude = ('  n=$(ls \"$ATTAVO_RECORDS_DIR\" | grep -c \"^build-.*\\\\.started$\")\\n'\n               '  if [ \"$n\" = 1 ]; then kill -9 $PPID; sleep 3; fi\\n'\n               f'  if [ \"$n\" = 2 ]; then echo \\'{TRANSIENT_LINE}\\'; exit 1; fi')\n    root, _ = approved_tenant(tmp_path, prelude, attempts=2)\n    passes_until(root, lambda: len(record_files(root, \"build\")) == 2, seconds=60)\n    for _ in range(6):\n        run_attavo(root, \"drive\", \"1\", env=FAST)\n        time.sleep(0.5)\n    assert len(record_files(root, \"build\")) == 2\n    assert not (records_dir(root) / \"build-03.started\").exists()\n    out = report(root)\n    assert out[\"state\"] == \"stopped\" and out[\"signatures_match\"] is False, out\n    assert any(\"again\" in r for r in out[\"rulings_available\"]), out\n\n\ndef test_a_stage_past_its_ceiling_is_hung_by_the_ceiling(tmp_path: Path) -> None:\n    \"\"\"A worker alive past [drive.build].ceiling_s is terminated and\n    recorded hung with bound ceiling; an adapter that declares it does\n    not stream events is never judged by event age.\"\"\"\n    root, bare = approved_tenant(tmp_path, \"  sleep 20\", build_ceiling_s=2)\n    d = root / \"attavo\" / \"adapters\" / \"fixture\"\n    (d / \"conformance.json\").write_text(json.dumps({\"streams_events\": False}) + \"\\n\")\n    commit_all(root, \"an adapter that does not stream\")\n    git(root, \"push\", \"-q\", \"origin\", \"HEAD:main\")\n    assert run_attavo(root, \"drive\", \"1\", env=FAST).returncode == 0\n    time.sleep(3)\n    out = report(root)\n    assert out[\"state\"] == \"owes-recovery\", out\n    assert \"event\" not in out[\"says\"], out[\"says\"]\n    passes_until(root, lambda: pushed(bare, \"build record for item 1 (build-01)\"), seconds=20)\n    stop = stop_of(root, \"build\", 1)\n    assert stop[\"class\"] == \"hung\" and stop[\"bound\"] == \"ceiling\", stop\n\n\ndef test_again_resets_a_spent_budget_only(tmp_path: Path) -> None:\n    \"\"\"--again on a stage whose budget is spent starts the next attempt\n    and records that in the marker; inside the budget it is a no-op that\n    says the pass retries on its own.\"\"\"\n    same = ('  at=\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"\\n'\n            '  printf \\'{\"at\":\"%s\",\"kind\":\"tool_call\",\"text\":\"fixture-tool waiting on lock\"}\\\\n\\' \"$at\" >> \"$ATTAVO_EVENTS\"\\n'\n            \"  kill -9 $PPID\\n  sleep 3\")\n    root, _ = approved_tenant(tmp_path, same)\n    passes_until(root, lambda: len(record_files(root, \"build\")) == 1, seconds=30)\n    inside = run_attavo(root, \"drive\", \"1\", \"--again\", env=FAST)\n    assert inside.returncode == 0 and \"retries on its own\" in inside.stdout, inside.stdout\n    passes_until(root, lambda: len(record_files(root, \"build\")) == 2, seconds=60)\n    for _ in range(3):\n        run_attavo(root, \"drive\", \"1\", env=FAST)\n        time.sleep(0.5)\n    assert len(record_files(root, \"build\")) == 2\n    again = run_attavo(root, \"drive\", \"1\", \"--again\", env=FAST)\n    assert again.returncode == 0 and \"Build started\" in again.stdout, again.stdout\n    marker = json.loads((records_dir(root) / \"build-03.started\").read_text())\n    assert marker.get(\"again_by\"), marker\n\n\ndef test_adapters_class_transient() -> None:\n    \"\"\"The fixture, claude-code and codex adapters put class transient on\n    the report line for a capacity, rate, or 5xx refusal: each adapter's\n    conformance.json names the situation and the product's own stop\n    classes carry it.\"\"\"\n    from attavo.stops import RETRYABLE_CLASSES, STOP_CLASSES\n    assert \"transient\" in STOP_CLASSES and \"returned\" in STOP_CLASSES\n    assert RETRYABLE_CLASSES == (\"died\", \"hung\", \"transient\", \"returned\")\n    for adapter in (\"fixture\", \"claude-code\", \"codex\"):\n        conf = json.loads((ROOT / \"adapters\" / adapter / \"conformance.json\").read_text())\n        assert \"streams_events\" in conf, adapter\n        assert \"transient\" in json.dumps(conf.get(\"situations\", {})) or \"transient\" in json.dumps(conf), adapter\n    env = dict(os.environ)\n    env[\"ATTAVO_FIXTURE_TRANSIENT\"] = \"API error: overloaded\"\n    env[\"ATTAVO_STAGE\"] = \"build\"\n    run = subprocess.run([\"sh\", str(FIXTURE_RUN)], capture_output=True, text=True, env=env, cwd=str(ROOT))\n    line = [l for l in run.stdout.splitlines() if l.startswith(\"{\")][-1]\n    assert json.loads(line).get(\"class\") == \"transient\", run.stdout\nfrom __future__ import annotations\n\nimport json\nimport re\nimport sys\nfrom pathlib import Path\nfrom typing import Any\n\nfrom attavo.common import MANIFEST, read_manifest\nfrom attavo.records import parse_attempts, stage_schema\nfrom attavo.types import CounselRecord, Stop\n\n# --- stop: every non-pass build or verify record's class and cause (issue\n# #89) -- derived here, at write time, from the refusal, halted, and log\n# the caller already has. Never a fresh read of anything: the tenant zero\n# specimens this retires (#576 build-11, #659 build-01 and verify-01) are\n# exactly a stop the product wrote with nothing beside it to explain\n# itself after the fact. ---\n\nSTOP_CLASSES = (\"non-question\", \"outlived-invocation\", \"no-cause\", \"forge-unconcluded\",\n               \"ceiling\", \"claims-boundary\", \"repeated-act\", \"unclassed\", \"question\",\n               \"environment\", \"gate\", \"died\", \"hung\", \"transient\", \"returned\")\n\n# R3: the four families a pass retries with no person involved -- every\n# other class is counsel's to read first, and a person's when counsel says\n# so (or when counsel is not configured at all).\nRETRYABLE_CLASSES = (\"died\", \"hung\", \"transient\", \"returned\")\n\n\ndef signature_of(text: str | None) -> str | None:\n    \"\"\"R3: a failure's signature, compared between attempts by plain string\n    equality -- text with every run of digits removed, so two stops that\n    differ only in a pid, a timestamp, or a retry-after count still match.\n    None for no text at all (nothing to sign).\"\"\"\n    if not text:\n        return None\n    stripped = re.sub(r\"[0-9]+\", \"\", text).strip()\n    return stripped or None\n\n\nSTOP_PROVENANCES = (\"product\", \"tenant\", \"executor\", \"spec\")\n\n# Beyond the enum spelling itself, the prose issue #88 actually shipped\n# (adapters/claude-code/run and adapters/codex/run, on main since\n# v0.16.0) once put a class's own name, or a real specimen's wording of\n# it, in the transcript for the generic match below to find. Issue #94\n# moves non-question and outlived-invocation onto report_class instead\n# (below): non-question's own halt line (\"halted: class non-question\")\n# would otherwise still satisfy the bare-name match here with no adapter\n# report-line field involved at all, and outlived-invocation's refusal\n# never named its class in text to begin with, so both are disabled here\n# -- the same pattern issue #93 established for ceiling, just below,\n# rather than removed outright.\nCLASS_TEXT_MARKERS: dict[str, tuple[str, ...]] = {\n    \"non-question\": (),\n    \"outlived-invocation\": (),\n    # R3: transient is read from the adapter's own report line\n    # (report_class) below; returned is written directly by the pass or\n    # cmd_verify, never derived from a log's text -- a retried attempt's\n    # feedback file names the prior stop's class in prose, and that text\n    # reaches the next attempt's own transcript, which must not then be\n    # misread as a fresh instance of either class.\n    \"transient\": (),\n    \"returned\": (),\n    # Issue #93: ceiling's own text-based check is CEILING_MARKERS, below,\n    # with provenance \"product\" -- a fact about the tool, not an executor\n    # judgment like non-question/outlived-invocation are. Left at the\n    # default (the class's own name, \"ceiling\"), the generic match above\n    # would instead catch adapters/codex/run's and\n    # adapters/claude-code/run's own pre-emptive refusal -- which must\n    # carry the word \"ceiling\" by the same issue's own brief -- as\n    # provenance \"executor\", before CEILING_MARKERS is ever consulted.\n    \"ceiling\": (),\n    # A genuine question (issue #100's own followups) is read structurally\n    # -- status \"halted\" carrying a non-empty halted.question -- not by\n    # scanning for the literal word \"question\", which the question's own\n    # text very often contains regardless of what it is actually asking.\n    # Left at the default, the generic match above would misclassify any\n    # question that happens to use the word \"question\" as executor\n    # provenance, before the structural check in derive_stop is reached.\n    \"question\": (),\n    # environment/tenant (issue #115) is set directly by cmd_build's own\n    # preflight -- the one caller who knows a [checks].command exited 2\n    # on the approved tree -- never derived from adapter text. Left at\n    # the default, the generic match above would catch the word\n    # \"environment\" anywhere in a log or refusal (e.g. codex's own\n    # OPENAI_API_KEY auth-mismatch refusal, adapters/codex/run's\n    # check_auth) as an environment/executor stop that never happened.\n    \"environment\": (),\n}\n\n# Known tool error text for a declared ceiling -- issue #86's own specimen\n# (codex's \"Input exceeds...\" line on a diff too large to judge) is\n# \"input_too_large\"; a matching line anywhere in the log, not only its\n# last line, since cmd_build and cmd_verify both append \"[adapter exited\n# N]\" after whatever the tool itself printed. \"ceiling exceeded\" is issue\n# #93's own addition: both adapters now refuse pre-emptively, before the\n# tool is ever invoked, against a declared or fixed input limit, and\n# their refusal text is not caught by any of the three markers above.\nCEILING_MARKERS = (\"input_too_large\", \"exceeds the maximum context length\",\n                  \"context_length_exceeded\", \"ceiling exceeded\")\n\n\n# Issue #100's followups: an unclassed detail is the log's last line\n# verbatim, and that line is sometimes an adapter's own event JSON or a\n# tool's full error text -- thousands of characters wide. Capped here,\n# at write time, so a filed issue's own summary of it (file-stops'\n# log_tail already carries the full picture) stays short; the class\n# itself, \"unclassed\", already says the full explanation lives in the\n# log, not in this field.\nUNCLASSED_DETAIL_MAX_CHARS = 200\n\n\ndef _log_last_line(log: str | None) -> str:\n    lines = [l for l in (log or \"\").splitlines() if l.strip()]\n    last = lines[-1] if lines else \"\"\n    return last[:UNCLASSED_DETAIL_MAX_CHARS]\n\n\ndef _carries_a_known_class(text: str | None) -> str | None:\n    \"\"\"Whichever of STOP_CLASSES this text names -- its own spelling, or\n    one of CLASS_TEXT_MARKERS' real-world phrasings of it, when that\n    class is not disabled there -- or None. Issue #88 is where an\n    adapter's own halt or refusal first named its class this way; issue\n    #93 added ceiling's own pre-emptive refusal to that set and disabled\n    its bare-name match (CEILING_MARKERS covers it instead); issue #94\n    disables non-question and outlived-invocation the same way, reading\n    both from the adapter's own report line (derive_stop's report_class)\n    now instead.\"\"\"\n    text = text or \"\"\n    for name in STOP_CLASSES:\n        markers = CLASS_TEXT_MARKERS.get(name, (name,))\n        if any(marker in text for marker in markers):\n            return name\n    return None\n\n\ndef derive_stop(status: str, *, refusal: str | None = None, halted: dict[str, Any] | None = None,\n                log: str | None = None, report_class: str | None = None,\n                refusal_provenance: str | None = None) -> Stop | None:\n    \"\"\"The stop field for a build or verify record: None for status \"pass\",\n    else {class, provenance, detail} from what the caller already knows.\n\n      - report_class -- payload.get(\"class\") off the adapter's own report\n        line (issue #88, #94), when it names a STOP_CLASSES member -- is\n        that class, provenance \"executor\". build.schema.json and\n        verify.schema.json stay untouched by issue #88 on purpose, so the\n        class lives only on the report line, never a structured field\n        cmd_build or cmd_verify forwards on its own account; the caller\n        reads payload itself and passes this in, since only it still has\n        payload once an iteration ends. This is non-question's and\n        outlived-invocation's only path to a record now (issue #94):\n        CLASS_TEXT_MARKERS disables both for the text scan below, the\n        same way issue #93 disabled ceiling's bare-name match there. A\n        class an adapter does not yet put on its report line --\n        outlived-invocation today, since that refusal path prints no\n        report line at all -- falls to unclassed below, same as any\n        other unnamed cause, until the adapter that raises it puts a\n        class on the line the way non-question already does.\n      - a halt carrying a non-empty halted.question, once it is not a\n        non-question caught above, is a genuine question -- question/spec,\n        with the question's own first line as detail (issue #100's\n        followups). This is the specimen issue #100 itself was built to\n        retire: tenant zero's #663 build-01, a proper question, classed\n        unclassed/product and filed as a product defect with the wrong\n        provenance -- a question is about the definition of done, which is\n        a person's or a ruling's to answer, never the product's own\n        mechanism.\n      - failing that, a refusal or the log itself that already names its\n        class in text (issue #88, #93 for ceiling's own pre-emptive\n        refusal) is that class, provenance \"executor\" -- the log is\n        checked because neither adapter's refusal *field* carries the\n        class today; the class-naming line each adapter prints reaches\n        only the transcript\n      - a refusal that is not that -- the write-outside-claims path\n        itself, not the \"commit ... not authored by the executor\" shape\n        -- is claims-boundary/spec, unless the caller already knows this\n        refusal touched paths.records or paths.specs (issue #140:\n        protected_path_touched, checked ahead of the ordinary claims\n        match in cmd_build) and passes refusal_provenance=\"executor\" --\n        the product's own directories are not a claim a spec makes, so a\n        refusal there is not the spec's boundary to answer for\n      - a returned verify (the forge was not green; no adapter ran) is\n        forge-unconcluded/tenant\n      - an adapter exit whose log carries a declared-ceiling error line is\n        ceiling/product\n      - anything else is unclassed/product, with the log's last line\n        (capped at UNCLASSED_DETAIL_MAX_CHARS) as its detail -- the other\n        class that carries a detail, since every remaining class's\n        evidence already lives in refusal, halted, forge_checks, or the\n        log itself.\n    \"\"\"\n    if status == \"pass\":\n        return None\n    if status == \"returned\":\n        return {\"class\": \"forge-unconcluded\", \"provenance\": \"tenant\", \"detail\": None}\n    if report_class in STOP_CLASSES:\n        return {\"class\": report_class, \"provenance\": \"executor\", \"detail\": None}\n    question = (halted or {}).get(\"question\")\n    if status == \"halted\" and question:\n        return {\"class\": \"question\", \"provenance\": \"spec\",\n               \"detail\": question.splitlines()[0]}\n    known = _carries_a_known_class(refusal) or _carries_a_known_class(log)\n    if known:\n        return {\"class\": known, \"provenance\": \"executor\", \"detail\": None}\n    if status == \"refused\" and refusal is not None and not refusal.startswith(\"commit \"):\n        return {\"class\": \"claims-boundary\", \"provenance\": refusal_provenance or \"spec\",\n               \"detail\": None}\n    if log and any(marker in log.lower() for marker in CEILING_MARKERS):\n        return {\"class\": \"ceiling\", \"provenance\": \"product\", \"detail\": None}\n    return {\"class\": \"unclassed\", \"provenance\": \"product\", \"detail\": _log_last_line(log)}\n\n\ndef gate_stop(refusal: str | None) -> Stop:\n    \"\"\"The stop for a refused spec-gate record: class \"gate\", provenance\n    \"spec\", the refusal string itself as cause (issue #137) -- not\n    derive_stop's generic claims-boundary/spec fallback issue #133\n    reused, which named a boundary the record never crossed: \"criterion\n    fails against the tree plus stub: doctor-template-absent.sh\" is not\n    a write outside claims. cmd_spec_gate is untouched by this lane, so\n    a spec record still carries no stop field of its own; this is\n    synthesized wherever a refused one is read (item_stops,\n    cmd_file_stops, proof_no_stop_lacks_cause), never persisted.\"\"\"\n    return {\"class\": \"gate\", \"provenance\": \"spec\", \"detail\": refusal}\n\n\n# --- stops: every non-pass record by class, provenance, and answerer\n# (issue #129) ---\n\ndef item_stops(root: Path, m: dict[str, Any], item_id: str) -> dict[str, Any]:\n    \"\"\"{\"item\", \"rows\", \"totals\"}: one row per non-pass build or verify\n    record (STOP_STAGES), plus every refused spec-gate record (issue\n    #133), class \"gate\" (issue #137) -- read from status and refusal\n    rather than a stop field spec-gate records never carry (gate_stop\n    synthesizes it) -- under item_id, whatever the record's own\n    record_version -- a record too old to carry stop at all still gets\n    a row, its class printed as the doctor's own phrase for it.\n\n    The answerer, a closed choice: \"counsel:<verdict>\" when\n    counsel_record_for finds a counsel record naming this exact stage and\n    counsel_record_for finds a counsel record naming this exact stage and\n    number -- the product's own answer, which wins over whatever the stop\n    itself says, since a counseled stop was already read once; failing\n    that, \"person\" for class question (a person's to answer, not a\n    guard's); failing that, \"guard\" for a class in GUARDED_STOP_CLASSES\n    (a guard's own rejection needed no further reading); anything else\n    -- no-cause, unclassed, or no stop at all -- is \"none\": nobody has\n    answered it yet.\"\"\"\n    records_rel = m[\"paths\"][\"records\"]\n    item_records_dir = root / records_rel / item_id\n    by_class = {c: 0 for c in stop_class_enum()}\n    by_answerer: dict[str, int] = {}\n    before_stop_was_recorded = 0\n    rows: list[dict[str, Any]] = []\n\n    def add_row(stage: str, n: int, stop: Stop | None) -> None:\n        nonlocal before_stop_was_recorded\n        name = f\"{stage}-{n:02d}\"\n        marker = item_records_dir / f\"{name}.filed\"\n        filed_issue = marker.read_text() if marker.is_file() else None\n        counsel = counsel_record_for(item_records_dir, stage, n)\n\n        if counsel is not None:\n            answerer = f\"counsel:{counsel.get('verdict')}\"\n        elif stop and stop.get(\"class\") == \"question\":\n            answerer = \"person\"\n        elif stop and stop.get(\"class\") in GUARDED_STOP_CLASSES:\n            answerer = \"guard\"\n        else:\n            answerer = \"none\"\n\n        if stop:\n            cls, provenance, detail = (stop.get(\"class\"), stop.get(\"provenance\"),\n                                      stop.get(\"detail\"))\n            if cls in by_class:\n                by_class[cls] += 1\n        else:\n            cls, provenance, detail = \"before stop was recorded\", None, None\n            before_stop_was_recorded += 1\n\n        by_answerer[answerer] = by_answerer.get(answerer, 0) + 1\n        rows.append({\"item\": item_id, \"record\": name, \"class\": cls,\n                    \"provenance\": provenance, \"detail\": detail,\n                    \"answerer\": answerer, \"filed_issue\": filed_issue})\n\n    if item_records_dir.is_dir():\n        for stage in STOP_STAGES:\n            for n, rec in sorted(parse_attempts(item_records_dir, stage).items()):\n                if rec.get(\"status\") == \"pass\":\n                    continue\n                add_row(stage, n, rec.get(\"stop\"))\n        for n, rec in sorted(parse_attempts(item_records_dir, \"spec\").items()):\n            if rec.get(\"status\") != \"refused\":\n                continue\n            add_row(\"spec\", n, gate_stop(rec.get(\"refusal\")))\n\n    totals = {\"by_class\": by_class, \"by_answerer\": by_answerer,\n             \"before_stop_was_recorded\": before_stop_was_recorded}\n    return {\"item\": item_id, \"rows\": rows, \"totals\": totals}\n\n\ndef cmd_stops(argv: list[str]) -> int:\n    as_json = \"--json\" in argv\n    positional = [a for a in argv if a != \"--json\"]\n    root = Path(\".\").resolve()\n    m = read_manifest(root)\n    if m is None:\n        print(f\"attavo stops: no {MANIFEST} at {root}\", file=sys.stderr)\n        return 2\n\n    records_rel = m[\"paths\"][\"records\"]\n    if positional:\n        item_ids = [positional[0]]\n    else:\n        records_root = root / records_rel\n        item_ids = (sorted((p.name for p in records_root.iterdir() if p.is_dir()))\n                   if records_root.is_dir() else [])\n\n    reports = [item_stops(root, m, item_id) for item_id in item_ids]\n\n    if as_json:\n        if positional:\n            print(json.dumps(reports[0], indent=2))\n        else:\n            print(json.dumps({\"items\": reports}, indent=2))\n        return 0\n\n    for entry in reports:\n        print(f\"attavo stops: item {entry['item']}\")\n        for row in entry[\"rows\"]:\n            filed = f\"  filed: {row['filed_issue'].strip()}\" if row[\"filed_issue\"] else \"\"\n            print(f\"  {row['record']:<10} {row['class']:<24} {row['provenance'] or '-':<10} \"\n                 f\"{row['answerer']:<16}{filed}\")\n        t = entry[\"totals\"]\n        print(f\"  by class: {t['by_class']}\")\n        print(f\"  by answerer: {t['by_answerer']}\")\n        print(f\"  before stop was recorded: {t['before_stop_was_recorded']}\")\n    if not reports:\n        print(f\"attavo stops: no item found under {records_rel}\")\n    return 0\n\n\n# The stop classes issue #89 gave no code of their own beyond the guard\n# that raised them -- non-question and outlived-invocation from an\n# adapter's own pre-emptive refusal, forge-unconcluded from a returned\n# verify, ceiling from a declared-input-limit error, claims-boundary from\n# the write-outside-claims refusal, repeated-act from... the same shape,\n# environment from cmd_build's own [checks].command preflight (issue\n# #115). question (a person's to answer) and the residual (no-cause,\n# unclassed -- nobody has looked yet) are not in this tuple; attavo stops\n# (issue #129) is the one reader, so it lives beside driver_identity,\n# not beside derive_stop, which never needs to tell a guard from any\n# other class once it has already named one.\nGUARDED_STOP_CLASSES = (\"non-question\", \"outlived-invocation\", \"forge-unconcluded\", \"ceiling\",\n                        \"claims-boundary\", \"repeated-act\", \"environment\")\n\n\ndef stop_class_enum() -> tuple[str, ...]:\n    \"\"\"Every class a stop can name, read from the build record schema's own\n    enum (issue #129) rather than retyped -- STOP_CLASSES already drifted\n    once (environment arrived in the schema before anything but derive_stop\n    read it); a second copy is a second place to forget. build's schema is\n    read, not verify's: verify's own enum is a strict subset (it never\n    raises environment, cmd_build's own preflight alone).\"\"\"\n    schema = stage_schema(\"build\")\n    return tuple(schema[\"properties\"][\"stop\"][\"properties\"][\"class\"][\"enum\"])\n\n\nSTOP_STAGES = (\"build\", \"verify\")\n\n\ndef counsel_record_for(item_records_dir: Path, stage: str, n: int) -> CounselRecord | None:\n    \"\"\"The latest counsel-NN.json (issue #100) whose own \"record\" field\n    names f\"{stage}-{n:02d}\" -- the counsel invocation, if any, that read\n    this exact stage record -- or None when counsel never ran against it\n    (e.g. file-stops run standalone, outside drive).\"\"\"\n    target = f\"{stage}-{n:02d}\"\n    attempts = parse_attempts(item_records_dir, \"counsel\")\n    matches = [rec for _, rec in sorted(attempts.items()) if rec.get(\"record\") == target]\n    return matches[-1] if matches else None\n    try:\n        then = datetime.strptime(at, \"%Y-%m-%dT%H:%M:%SZ\").replace(tzinfo=timezone.utc)\n    except ValueError:\n        return None\n    return (datetime.now(timezone.utc) - then).total_seconds()\n\n\nclass InvocationReading(NamedTuple):\n    \"\"\"What one marker with no record reads as, from here and now.\"\"\"\n    stage: str\n    nn: int\n    log: str\n    last_at: str | None\n    age: float | None\n    cls: str  # \"running\" | \"hung\" | \"died\"\n    bound: str | None = None  # R3: \"stall\" or \"ceiling\" when cls is \"hung\"\n\n\ndef _manifest_of(root: Path) -> dict[str, Any]:\n    m = read_manifest(root)\n    return m if m is not None else {}\n\n\ndef _streams_events(root: Path, m: dict[str, Any], stage: str) -> bool:\n    \"\"\"R3: whether stage's adapter declares it streams events at all\n    (adapters/<name>/conformance.json, \"streams_events\") -- one that does\n    not is judged by its ceiling alone, and never called hung by event\n    age it never produces. True (the ordinary case) when the adapter\n    declares nothing, or none is configured to ask.\"\"\"\n    name = (m.get(\"executor\") or {}).get(stage) or (m.get(\"executor\") or {}).get(\"build\")\n    if not name:\n        return True\n    for base in (root / \"attavo\" / \"adapters\", PRODUCT_ROOT / \"adapters\"):\n        conf = base / name / \"conformance.json\"\n        if conf.is_file():\n            try:\n                return bool(json.loads(conf.read_text()).get(\"streams_events\", True))\n            except (OSError, ValueError):\n                return True\n    return True\n\n\ndef read_invocation(root: Path, bound: int | None, marker: Path, info: dict[str, Any]) -> InvocationReading:\n    \"\"\"Whether an invocation that began and wrote no record is running,\n    hung, or died -- read from its own heartbeat first (R2): a heartbeat\n    file fresh within three beats of ATTAVO_HEARTBEAT_S is alive; a stale\n    one is died, whether or not the pid still lives -- a worker stuck\n    somewhere that never reaches its own heartbeat loop again is exactly\n    what this is for. Only with no heartbeat file at all -- an invocation\n    from before this release, or one that died before touching its\n    first beat -- does this fall back to the pid: alive and, with a\n    stall bound declared, past it is hung; alive with no bound, or\n    within it, is running for as long as it lives; not alive is died.\n    The stall bound decides hung, never died.\n\n    R3: the stage's own ceiling (wall clock from the marker's own `at`)\n    is judged first, before any of that -- alive past it is hung by the\n    ceiling whatever event age says, and an adapter that declares it\n    streams no events is judged by the ceiling alone: bound is read as\n    None for it, so the stall check below never fires on an event age it\n    never had.\"\"\"\n    stage, nn_text = marker.stem.rsplit(\"-\", 1)\n    nn = int(nn_text)\n    log, last_at = _events_tail(_events_path_for(root, stage, nn))\n    m = _manifest_of(root)\n    ceiling = ceiling_s(m, stage)\n    since_start = _seconds_since(info.get(\"at\"))\n    if ceiling is not None and since_start is not None and since_start > ceiling:\n        return InvocationReading(stage, nn, log, last_at, since_start, \"hung\", \"ceiling\")\n    if not _streams_events(root, m, stage):\n        bound = None\n    beat = heartbeat_path(root, stage, nn)\n    if beat.is_file():\n        try:\n            beat_age = time.time() - beat.stat().st_mtime\n        except OSError:\n            beat_age = None\n        cls = \"running\" if beat_age is not None and beat_age <= heartbeat_s() * 3 else \"died\"\n        return InvocationReading(stage, nn, log, last_at, beat_age, cls)\n    age = _seconds_since(last_at or info.get(\"at\"))\n    if not invocation_alive(info):\n        return InvocationReading(stage, nn, log, last_at, age, \"died\")\n    if bound is None or age is None or age <= bound:\n        return InvocationReading(stage, nn, log, last_at, age, \"running\")\n    return InvocationReading(stage, nn, log, last_at, age, \"hung\", \"stall\")\n\n\ndef uncommitted_record(root: Path, records_dir: Path, stage: str) -> Path | None:\n    \"\"\"The latest <stage>-NN.json this working tree carries that git has\n    no commit for yet -- the moment between a worker's write and its own\n    commit. None when the latest record is already committed, or there\n    is none at all.\"\"\"\n    path = latest_attempt_path(records_dir, stage)\n    if path is None or not path.is_file():\n        return None\n    status = subprocess.run(\n        [\"git\", \"-C\", str(root), \"status\", \"--porcelain\", \"--\", str(path.relative_to(root))],\n        capture_output=True, text=True, check=False)\n    return path if status.stdout.strip() else None\n\n\ndef worker_holds_copy(root: Path, records_dir: Path) -> bool:\n    \"\"\"True when this checkout's own working tree cannot safely be moved\n    -- an invocation marker with no record yet (a worker, here or\n    elsewhere, still holds this attempt), or a build or verify record the\n    working tree carries that git has not committed yet. Scoped to the\n    stage records a pass or a worker itself ever transports -- an\n    operator's own spec-gate or approve, routinely uncommitted between\n    their own act and the next pass, is not this. A pass never\n    fast-forwards while this holds (never while a worker holds the\n    copy).\"\"\"\n    if invocations_without_record(records_dir):\n        return True\n    return (uncommitted_record(root, records_dir, \"build\") is not None\n           or uncommitted_record(root, records_dir, \"verify\") is not None)\n\n\ndef fast_forward_to_origin(root: Path, m: dict[str, Any], item_id: str) -> None:\n    \"\"\"The pass's own read of origin's branch, taken before it reads\n    anything else -- a commit landed there from elsewhere (an approval\n    from the screen, a ruling, another pass's own record) is not a race\n    for the lease, it is exactly what the lease is for. Never while a\n    worker holds this copy (worker_holds_copy): resetting a working tree\n    a detached child is still writing into would corrupt its own commits.\n    A plain fast-forward when origin is simply ahead; when this checkout\n    also carries its own commits origin has not seen yet (an operator's\n    approval, not yet pushed), those are replayed on top of origin's own\n    tip instead -- no merge commit, and the marker this pass is about to\n    write still lands as a fast-forward when it pushes. Silent about\n    everything short of that -- a real conflict, or an absent origin, is\n    left for the ordinary read (and the marker push, for the lease) to\n\n\n# --- the pass's own two acts: start a stage (the lease), and recover\n# exactly the one invocation the report names owed one. ---\n\ndef _start_stage(root: Path, m: dict[str, Any], item_id: str, stage: str,\n                 forge_checks: dict[str, Any] | None, again_by: bool = False) -> int:\n    \"\"\"The lease (ruling A): the marker, committed and pushed as a plain\n    fast-forward with no merge and no retry (push_lease). Lost to another\n    pass, or refused outright by the remote, both undo the marker commit\n    here (git reset --hard) so this checkout carries no half-taken\n    attempt either way; only a pushed lease starts the worker. On a\n    review, forge_checks is the checks this same pass already read on\n    the pre-marker head (ruling B) -- written to\n    <git-dir>/attavo/verify-NN.forge-checks.json and named in\n    ATTAVO_FORGE_CHECKS, so the worker's own `attavo verify` reads it\n    instead of polling. again_by (R3) is true only when `--again` is what\n    started this attempt, past a budget already spent or an early stop\n    -- named in the marker, never on an ordinary or plainly-retried\n    attempt.\"\"\"\n    records_dir = root / m[\"paths\"][\"records\"] / item_id\n    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n    nn = next_attempt_number(records_dir, stage)\n    marker = write_invocation_marker(root, records_dir, stage, nn, again_by=again_by)\n    try:\n        commit_record(root, [marker], f\"attavo: {stage} invocation {nn:02d} started for item {item_id}\")\n    except RuntimeError as exc:\n        print(f\"attavo drive: stopped: could not commit the {stage} invocation marker: {exc}\")\n        return 1\n\n    if has_origin(root):\n        outcome, err = push_lease(root, branch)\n        if outcome != \"pushed\":\n            git(root, \"reset\", \"--hard\", \"HEAD^\")\n            if outcome == \"lost-race\":\n                print(f\"attavo drive: another pass holds this attempt ({marker.name}); nothing started\")\n                return 0\n            print(f\"attavo drive: stopped: could not push the {stage} invocation marker: {err}\")\n            return 1\n\n    env = dict(os.environ)\n    if forge_checks is not None:\n        checks_file = forge_checks_path(root, stage, nn)\n        checks_file.write_text(json.dumps(forge_checks))\n        env[\"ATTAVO_FORGE_CHECKS\"] = str(checks_file)\n    log = worker_log_path(root, stage, nn)\n    with log.open(\"ab\") as fh, open(os.devnull, \"rb\") as devnull:\n        proc = subprocess.Popen(\n            [sys.executable, str(PRODUCT_ROOT / \"bin\" / \"attavo\"), \"worker\", item_id, stage, f\"{nn:02d}\"],\n            cwd=str(root), env=env, stdin=devnull, stdout=fh, stderr=subprocess.STDOUT,\n            start_new_session=True)\n    word = \"Build\" if stage == \"build\" else \"Review\"\n    print(f\"attavo drive: {word} started (attempt {nn:02d}, worker pid {proc.pid})\")\n    return 0\n\n\ndef _recover_one(root: Path, m: dict[str, Any], item_id: str, records_dir: Path) -> int:\n    \"\"\"The pass's own recovery act (what `--recover` did): exactly the one\n    invocation the report just read as owing one -- died or hung -- ends\n    here. class died when the heartbeat is stale (or absent and the pid\n    is gone), class hung when there is no heartbeat, the pid lives, and a\n    declared [drive].stall_after_s has passed with no newer event, and\n    terminated. Provenance product; the events tail as the log. Committed\n    and pushed the way any stage record is (push_record_commit, with its\n    own merge retry) -- this is not a race for a lease, since no new\n    attempt marker is written.\"\"\"\n    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n    bound = stall_bound_s(m)\n    pending = invocations_without_record(records_dir)\n    readings = [(marker, info, read_invocation(root, bound, marker, info)) for marker, info in pending]\n    candidate = next(((mk, i, rd) for mk, i, rd in readings if rd.cls != \"running\"), None)\n    if candidate is None:\n        # The report read this a moment ago; nothing owed recovery by the\n        # time this pass got here (another pass recovered it, or it\n        # finished on its own).\n        return 0\n    marker, info, reading = candidate\n    stage, nn, log, last_at, age, cls, crossed = reading\n    pid, host = info.get(\"pid\"), info.get(\"host\")\n\n    if next_attempt_number(records_dir, stage) != nn:\n        print(f\"attavo drive: stopped: {marker.name} names attempt {nn} but the next \"\n              f\"{stage} record would be {next_attempt_number(records_dir, stage):02d}; \"\n              f\"a later record already exists, read the records before recovering\")\n        return 1\n\n    if cls == \"hung\":\n        try:\n            os.kill(cast(int, pid), signal.SIGTERM)\n            ended = \"terminated\"\n        except OSError as exc:\n            ended = f\"not terminated ({exc})\"\n        if crossed == \"ceiling\":\n            detail = (f\"pid {pid} on {host} alive {int(cast(float, age))} s after its marker, \"\n                      f\"past the {stage} ceiling of {ceiling_s(m, stage)} s; {ended}\")\n        else:\n            detail = (f\"pid {pid} on {host} alive with no event for {int(cast(float, age))} s \"\n                      f\"(bound {bound} s); {ended}\")\n    else:\n        detail = (f\"pid {pid} on {host} is not running and wrote no {marker.stem}.json; \"\n                  f\"started {info.get('at')}, last event {last_at or 'none'}\")\n\n    signature_text = log.strip().splitlines()[-1] if log.strip() else detail\n\n    schema = stage_schema(stage)\n    record: dict[str, Any] = {k: None for k in schema.get(\"required\", [])}\n    approval = latest_record(records_dir, \"approval\")\n    record.update({\"sha\": info.get(\"sha\"), \"start_sha\": info.get(\"sha\"),\n                   \"approval_sha\": approval.get(\"sha\") if approval else None,\n                   \"at\": info.get(\"at\"),\n                   \"adapter\": (m.get(\"executor\") or {}).get(stage),\n                   \"status\": \"failed\", \"refusal\": None, \"halted\": None,\n                   \"retry_of\": None, \"steer\": None,\n                   \"stop\": {\"class\": cls, \"provenance\": \"product\", \"detail\": detail,\n                            \"signature\": signature_of(signature_text), \"bound\": crossed}})\n    if \"wall_clock_s\" in record:\n        record[\"wall_clock_s\"] = None if age is None else int(age)\n    record = {k: v for k, v in record.items() if k in schema.get(\"properties\", {})}\n    try:\n        path = write_record(records_dir, stage, record, m, item_id, log=log)\n    except ValueError as exc:\n        print(f\"attavo drive: stopped: could not write the {cls} record for {marker.stem}: {exc}\")\n        return 1\n    try:\n        commit_record(root, [path], f\"attavo: {stage} record for item {item_id} \"\n                                    f\"({path.stem}), recovered as {cls}\")\n    except RuntimeError as exc:\n        print(f\"attavo drive: stopped: could not commit the {cls} record: {exc}\")\n        return 1\n    if has_origin(root):\n        ok, err = push_record_commit(root, branch)\n        if not ok:\n            print(f\"attavo drive: stopped: could not push the {cls} record: {err}\")\n            return 1\n    else:\n        print(f\"attavo drive: note: no origin remote; {path.name} is committed, not pushed\")\n    print(f\"attavo drive: recovered {marker.stem} as {cls}: {detail}\")\n    return 0\n\n\ndef _advance_again(root: Path, m: dict[str, Any], item_id: str, stage: str, head: str | None,\n                   again_by: bool = False) -> int:\n    \"\"\"The next attempt of a stopped stage, bypassing the level a plain\n    pass leaves alone for the operator: what a plain retry (R3, inside\n    the budget) starts on its own, and what `--again` starts by force\n    once the budget is spent or an early stop fired. A review reads the\n    forge fresh here -- once, since the report's own stopped reading\n    never touched it -- rather than reusing a read that was never taken.\"\"\"\n    if stage == \"build\":\n        return _start_stage(root, m, item_id, \"build\", None, again_by=again_by)\n    checks_command = (m.get(\"forge\") or {}).get(\"checks_command\")\n    if not checks_command:\n        print(\"attavo drive: refused: no [forge].checks_command in the manifest\")\n        return 1\n    forge_checks, ok = read_forge_checks(root, checks_command, cast(str, head))\n    if not ok:\n        conclusions = forge_checks[\"conclusions\"]\n        named = \", \".join(f\"{c['name']} {c['conclusion']}\" for c in conclusions) or \"no checks reported\"\n        print(f\"attavo drive: forge checks not green on {cast(str, head)[:12]}: {named}\")\n        return 0\n    return _start_stage(root, m, item_id, \"verify\", forge_checks, again_by=again_by)\n\n\n# --- R3: the retry decision, shared by the report's own kind/says and the\n# pass's own act (retry_state) so the two cannot drift. ---\n\n# Never retried by this item, whatever counsel might rule: a\n# claims-boundary stop is a person's; a tenant's gate refusal is the\n# spec-gate's own, earlier than any of this; an environment refusal is\n# recorded here and acted on by R4's breaker. A question is not in this\n# tuple -- counsel reads it exactly like any other non-pass record, and\n# an \"answer\" verdict starts the next attempt steered by it, the same as\n# any class counsel can rule on; a question nobody answers (no counsel\n# configured, or its own verdict is \"person\") simply never becomes\n# eligible, with no exclusion needed to keep it that way.\nNEVER_RETRIED_CLASSES = (\"claims-boundary\", \"gate\", \"environment\")\n\n\ndef _budget_stage(stage: str, stop_class: str | None) -> str:\n    \"\"\"The stage whose [drive].attempts budget a stop spends -- build for\n    a returned review (the check rejection or the blocking finding is the\n    build's to answer, never the review's own to repeat), the stop's own\n    stage for everything else.\"\"\"\n    return \"build\" if stop_class == \"returned\" else stage\n\n\ndef _signatures_match(records_dir: Path, stage: str) -> bool:\n    \"\"\"Whether the last two attempts of stage carry the identical,\n    non-null signature -- the early stop (R3): two attempts of one stage\n    ending the same way spend no third.\"\"\"\n    attempts = parse_attempts(records_dir, stage)\n    if len(attempts) < 2:\n        return False\n    nums = sorted(attempts)\n    sig_a = (attempts[nums[-1]].get(\"stop\") or {}).get(\"signature\")\n    sig_b = (attempts[nums[-2]].get(\"stop\") or {}).get(\"signature\")\n    return sig_a is not None and sig_a == sig_b\n\n\nclass RetryState(NamedTuple):\n    \"\"\"Whether a plain pass, right now, would start the next attempt of a\n    stopped stage (R3) -- eligible; a transient stop still short of\n    [drive].retry_after_s carries waiting_s instead, eligible for neither\n    a plain pass nor `--again`'s own no-op read of the same fact; steer\n    names the counsel record an \"answer\" verdict would hand the next\n    attempt; target_stage is the stage the next attempt actually starts\n    (build, for a returned review).\"\"\"\n    eligible: bool\n    waiting_s: float | None\n    steer: str | None\n    target_stage: str\n\n\ndef retry_state(root: Path, m: dict[str, Any], records_dir: Path, stage: str,\n                stop_class: str | None, attempt: int | None) -> RetryState:\n    \"\"\"The one read behind both the report's own kind/says (a stopped\n    stage that would retry reads as \"acts\" or \"waits\", never \"yours\") and\n    the pass's own act, so the two cannot say different things about the\n    same stop. died, hung, transient, and returned retry with no counsel\n    asked, inside the shared budget and past the early stop; every other\n    class retries only when counsel's own verdict for this exact stop is\n    \"answer\" -- and never when the class is one of NEVER_RETRIED_CLASSES,\n    whatever counsel might have said.\"\"\"\n    target_stage = _budget_stage(stage, stop_class)\n    if stop_class is None or stop_class in NEVER_RETRIED_CLASSES or attempt is None:\n        return RetryState(False, None, None, target_stage)\n    spent = next_attempt_number(records_dir, target_stage) - 1\n    if spent >= attempts_budget(m):\n        return RetryState(False, None, None, target_stage)\n    if _signatures_match(records_dir, stage):\n        return RetryState(False, None, None, target_stage)\n    if stop_class in RETRYABLE_CLASSES:\n        if stop_class == \"transient\":\n            attempts = parse_attempts(records_dir, stage)\n            rec = attempts.get(attempt)\n            age = _seconds_since(rec.get(\"at\")) if rec else None\n            wait = retry_after_s(m)\n            if age is not None and age < wait:\n                return RetryState(False, wait - age, None, target_stage)\n        return RetryState(True, None, None, target_stage)\n    counsel = counsel_record_for(records_dir, stage, attempt)\n    if counsel is not None and counsel.get(\"verdict\") == \"answer\":\n        target = f\"{stage}-{attempt:02d}\"\n        counsel_attempts = parse_attempts(records_dir, \"counsel\")\n        matches = [n for n, rec in counsel_attempts.items() if rec.get(\"record\") == target]\n        if matches:\n            return RetryState(True, None, f\"counsel-{max(matches):02d}\", target_stage)\n    return RetryState(False, None, None, target_stage)\n\n\ndef _pass_once(root: Path, m: dict[str, Any], item_id: str, again: bool) -> tuple[int, \"DriveReport\"]:\n    \"\"\"One pass: fast-forward to origin (never while a worker holds the\n    copy), read the report, act at most once, return. owes-recovery\n    recovers; next-build and next-review start their stage, handing a\n    review the checks the report already read once on the pre-marker\n    head; blocked-on-checks on a review (R3) starts it too -- the same\n    act as next-review, since a concluded red check on a passed build's\n    head is now a returned record, not a level a pass leaves alone. A\n    stopped stage inside its budget (RetryState.eligible) retries itself,\n    with no flag needed; `--again` is a no-op that says so when the plain\n    mechanism would already act or is only waiting out retry_after_s, and\n    forces the next attempt, named again_by in its marker, when it would\n    not. Every other level is printed in the report's own words and left.\"\"\"\n    from attavo.report import drive_report\n    fast_forward_to_origin(root, m, item_id)\n    r = drive_report(root, m, item_id)\n    records_dir = root / m[\"paths\"][\"records\"] / item_id\n\n    if r[\"state\"] == \"owes-recovery\":\n        return _recover_one(root, m, item_id, records_dir), r\n    if r[\"state\"] == \"next-build\":\n        return _start_stage(root, m, item_id, \"build\", None), r\n    if r[\"state\"] in (\"next-review\", \"blocked-on-checks\") and r[\"stage\"] == \"verify\":\n        checks_command = (m.get(\"forge\") or {}).get(\"checks_command\")\n        forge_checks = {\"command\": checks_command, \"sha\": r[\"head\"], \"conclusions\": r[\"checks\"] or []}\n        return _start_stage(root, m, item_id, \"verify\", forge_checks), r\n    if r[\"state\"] == \"stopped\" and r[\"stage\"]:\n        state = retry_state(root, m, records_dir, r[\"stage\"], r[\"stop_class\"], r[\"attempt\"])\n        if again:\n            if state.eligible or state.waiting_s is not None:\n                print(\"attavo drive: --again inside the budget is a no-op; the pass retries \"\n                      \"on its own\")\n                return 0, r\n            return _advance_again(root, m, item_id, state.target_stage, r[\"head\"], again_by=True), r\n        if state.eligible:\n            return _advance_again(root, m, item_id, state.target_stage, r[\"head\"]), r\n\n    print(f\"attavo drive: {r['says']}\")\n    return (1 if r[\"state\"] == \"refused\" else 0), r\n\n\n_TERMINAL_STATES = (\"waiting-on-approval\", \"stopped\", \"ready-to-merge\", \"merged\")\n\n\ndef _until_ready(root: Path, m: dict[str, Any], item_id: str, again: bool) -> int:\n    \"\"\"--until-ready: the pass, repeated in one process, sleeping\n    ATTAVO_DRIVE_POLL_INTERVAL_S between passes, until the level is the\n    operator's or done (exit 0), a concluded check is red (exit 1), or\n    an unconcluded one has not concluded within ATTAVO_DRIVE_POLL_BOUND_S\n    (exit 1). A stage running in its own worker is not bounded by this --\n    only time spent waiting on the forge is.\"\"\"\n    from attavo.verify import drive_forge_poll_bound_s, drive_forge_poll_interval_s\n    bound = drive_forge_poll_bound_s()\n    interval = drive_forge_poll_interval_s()\n    waiting_since: float | None = None\n    while True:\n        rc, r = _pass_once(root, m, item_id, again)\n        state = r[\"state\"]\n\n        if state == \"waiting-on-checks\":\n            if waiting_since is None:\n                waiting_since = time.monotonic()\n            elif time.monotonic() - waiting_since >= bound:\n                print(f\"attavo drive: stopped: the checks did not conclude within {bound:.0f}s\")\n                return 1\n        else:\n            waiting_since = None\n\n        if rc != 0:\n            return rc\n        # R3: \"stopped\" is terminal only when the pass actually left it\n        # alone -- kind \"acts\" or \"waits\" means this same pass just\n        # retried it (or is only waiting out retry_after_s), and the loop\n        # must keep going rather than call that done.\n        if state in _TERMINAL_STATES and not (state == \"stopped\" and r[\"kind\"] != \"yours\"):\n            return 0\n        # R3: blocked-on-checks on a review is no longer a dead end -- the\n        # pass just converted it into a returned record and, inside its\n        # budget, a build retry follows on its own. Only the post-verify\n        # case (the checks went red after a passing review, stage None)\n        # is still the level with nothing left to do but give up.\n        if state == \"blocked-on-checks\" and r[\"stage\"] is None:\n            return 1\n        time.sleep(interval)\n\n\ndef _drive_all() -> int:\n    \"\"\"--all: one pass, in its own process, in every ../attavo-worktree-N\n    beside this checkout -- each one derives its own item from its own\n    attavo/N-* branch. Every line either prints is prefixed with the\n    worktree's own directory name, so an operator reading them together\n    can tell which item each line is about.\"\"\"\n    root = Path(\".\").resolve()\n    siblings = sorted(p for p in root.parent.glob(\"attavo-worktree-*\") if p.is_dir())\n    if not siblings:\n        print(\"attavo drive: --all found no ../attavo-worktree-N beside this checkout\")\n        return 0\n    worst = 0\n    for copy in siblings:\n        run = subprocess.run([sys.executable, str(PRODUCT_ROOT / \"bin\" / \"attavo\"), \"drive\"],\n                             cwd=str(copy), capture_output=True, text=True, check=False)\n        for line in (run.stdout + run.stderr).splitlines():\n            print(f\"{copy.name}: {line}\")\n        worst = max(worst, run.returncode)\n    return worst\n\n\ndef cmd_drive(argv: list[str]) -> int:\n    # Issue #145: Python block-buffers stdout when it is not a tty (a\n    # pipe, e.g. a screen reading this process live), so every line this\n    # prints would otherwise sit unflushed until the process exits.\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"sed -n '300,460p' tests/test_retry.py; sed -n '180,455p' attavo/build.py; sed -n '110,430p' attavo/verify.py; sed -n '1,330p' attavo/report.py; sed -n '1,180p' attavo/stops.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"sed -n '300,460p' tests/test_retry.py; sed -n '180,455p' attavo/build.py; sed -n '110,430p' attavo/verify.py; sed -n '1,330p' attavo/report.py; sed -n '1,180p' attavo/stops.py\"","aggregated_output":"            time.sleep(0.3)\n        assert len(record_files(root, \"build\")) == 1, name\n        assert not (records_dir(root) / \"build-02.started\").exists(), name\n        assert report(root)[\"state\"] == \"stopped\"\n\n\ndef test_identical_failures_stop_early_and_the_budget_holds(tmp_path: Path) -> None:\n    \"\"\"Two attempts ending with the identical signature stop the stage at\n    two; two different signatures proceed to a third; a fourth never\n    starts.\"\"\"\n    same = ('  at=\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"\\n'\n            '  printf \\'{\"at\":\"%s\",\"kind\":\"tool_call\",\"text\":\"fixture-tool waiting on lock 4471\"}\\\\n\\' \"$at\" >> \"$ATTAVO_EVENTS\"\\n'\n            \"  kill -9 $PPID\\n  sleep 3\")\n    root, _bare = approved_tenant(tmp_path / \"same\", same)\n    passes_until(root, lambda: len(record_files(root, \"build\")) == 2, seconds=60)\n    for _ in range(6):\n        run_attavo(root, \"drive\", \"1\", env=FAST)\n        time.sleep(0.5)\n    assert len(record_files(root, \"build\")) == 2\n    assert not (records_dir(root) / \"build-03.started\").exists()\n    assert stop_of(root, \"build\", 1)[\"signature\"] == stop_of(root, \"build\", 2)[\"signature\"]\n\n    differ = ('  at=\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"\\n'\n              '  n=$(ls \"$ATTAVO_RECORDS_DIR\" | grep -c \"^build-.*\\\\.started$\")\\n'\n              '  printf \\'{\"at\":\"%s\",\"kind\":\"tool_call\",\"text\":\"fixture-tool step %s of the plan\"}\\\\n\\' \"$at\" \"$(printf \"%s\" \"$n\" | tr 0-9 a-j)\" >> \"$ATTAVO_EVENTS\"\\n'\n              \"  kill -9 $PPID\\n  sleep 3\")\n    root2, _ = approved_tenant(tmp_path / \"differ\", differ)\n    passes_until(root2, lambda: len(record_files(root2, \"build\")) == 3, seconds=90)\n    for _ in range(6):\n        run_attavo(root2, \"drive\", \"1\", env=FAST)\n        time.sleep(0.5)\n    assert len(record_files(root2, \"build\")) == 3\n    assert not (records_dir(root2) / \"build-04.started\").exists()\n    out = report(root2)\n    assert out[\"state\"] == \"stopped\" and len(out[\"attempts\"]) == 3, out\n\n\ndef test_every_marker_spends_the_budget(tmp_path: Path) -> None:\n    \"\"\"A recovered attempt counts: with attempts = 2, one died attempt and\n    one transient attempt spend the budget and a third never starts,\n    though the two signatures differ.\"\"\"\n    prelude = ('  n=$(ls \"$ATTAVO_RECORDS_DIR\" | grep -c \"^build-.*\\\\.started$\")\\n'\n               '  if [ \"$n\" = 1 ]; then kill -9 $PPID; sleep 3; fi\\n'\n               f'  if [ \"$n\" = 2 ]; then echo \\'{TRANSIENT_LINE}\\'; exit 1; fi')\n    root, _ = approved_tenant(tmp_path, prelude, attempts=2)\n    passes_until(root, lambda: len(record_files(root, \"build\")) == 2, seconds=60)\n    for _ in range(6):\n        run_attavo(root, \"drive\", \"1\", env=FAST)\n        time.sleep(0.5)\n    assert len(record_files(root, \"build\")) == 2\n    assert not (records_dir(root) / \"build-03.started\").exists()\n    out = report(root)\n    assert out[\"state\"] == \"stopped\" and out[\"signatures_match\"] is False, out\n    assert any(\"again\" in r for r in out[\"rulings_available\"]), out\n\n\ndef test_a_stage_past_its_ceiling_is_hung_by_the_ceiling(tmp_path: Path) -> None:\n    \"\"\"A worker alive past [drive.build].ceiling_s is terminated and\n    recorded hung with bound ceiling; an adapter that declares it does\n    not stream events is never judged by event age.\"\"\"\n    root, bare = approved_tenant(tmp_path, \"  sleep 20\", build_ceiling_s=2)\n    d = root / \"attavo\" / \"adapters\" / \"fixture\"\n    (d / \"conformance.json\").write_text(json.dumps({\"streams_events\": False}) + \"\\n\")\n    commit_all(root, \"an adapter that does not stream\")\n    git(root, \"push\", \"-q\", \"origin\", \"HEAD:main\")\n    assert run_attavo(root, \"drive\", \"1\", env=FAST).returncode == 0\n    time.sleep(3)\n    out = report(root)\n    assert out[\"state\"] == \"owes-recovery\", out\n    assert \"event\" not in out[\"says\"], out[\"says\"]\n    passes_until(root, lambda: pushed(bare, \"build record for item 1 (build-01)\"), seconds=20)\n    stop = stop_of(root, \"build\", 1)\n    assert stop[\"class\"] == \"hung\" and stop[\"bound\"] == \"ceiling\", stop\n\n\ndef test_again_resets_a_spent_budget_only(tmp_path: Path) -> None:\n    \"\"\"--again on a stage whose budget is spent starts the next attempt\n    and records that in the marker; inside the budget it is a no-op that\n    says the pass retries on its own.\"\"\"\n    same = ('  at=\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"\\n'\n            '  printf \\'{\"at\":\"%s\",\"kind\":\"tool_call\",\"text\":\"fixture-tool waiting on lock\"}\\\\n\\' \"$at\" >> \"$ATTAVO_EVENTS\"\\n'\n            \"  kill -9 $PPID\\n  sleep 3\")\n    root, _ = approved_tenant(tmp_path, same)\n    passes_until(root, lambda: len(record_files(root, \"build\")) == 1, seconds=30)\n    inside = run_attavo(root, \"drive\", \"1\", \"--again\", env=FAST)\n    assert inside.returncode == 0 and \"retries on its own\" in inside.stdout, inside.stdout\n    passes_until(root, lambda: len(record_files(root, \"build\")) == 2, seconds=60)\n    for _ in range(3):\n        run_attavo(root, \"drive\", \"1\", env=FAST)\n        time.sleep(0.5)\n    assert len(record_files(root, \"build\")) == 2\n    again = run_attavo(root, \"drive\", \"1\", \"--again\", env=FAST)\n    assert again.returncode == 0 and \"Build started\" in again.stdout, again.stdout\n    marker = json.loads((records_dir(root) / \"build-03.started\").read_text())\n    assert marker.get(\"again_by\"), marker\n\n\ndef test_adapters_class_transient() -> None:\n    \"\"\"The fixture, claude-code and codex adapters put class transient on\n    the report line for a capacity, rate, or 5xx refusal: each adapter's\n    conformance.json names the situation and the product's own stop\n    classes carry it.\"\"\"\n    from attavo.stops import RETRYABLE_CLASSES, STOP_CLASSES\n    assert \"transient\" in STOP_CLASSES and \"returned\" in STOP_CLASSES\n    assert RETRYABLE_CLASSES == (\"died\", \"hung\", \"transient\", \"returned\")\n    for adapter in (\"fixture\", \"claude-code\", \"codex\"):\n        conf = json.loads((ROOT / \"adapters\" / adapter / \"conformance.json\").read_text())\n        assert \"streams_events\" in conf, adapter\n        assert \"transient\" in json.dumps(conf.get(\"situations\", {})) or \"transient\" in json.dumps(conf), adapter\n    env = dict(os.environ)\n    env[\"ATTAVO_FIXTURE_TRANSIENT\"] = \"API error: overloaded\"\n    env[\"ATTAVO_STAGE\"] = \"build\"\n    run = subprocess.run([\"sh\", str(FIXTURE_RUN)], capture_output=True, text=True, env=env, cwd=str(ROOT))\n    line = [l for l in run.stdout.splitlines() if l.startswith(\"{\")][-1]\n    assert json.loads(line).get(\"class\") == \"transient\", run.stdout\n    zero attest/records/659/verify-01.log, codex's own \"Input exceeds...\"\n    line, dropped because it was mistaken for an attempted payload) --\n    nothing here is a report, and the whole stdout is the transcript, so\n    that last line is not silently lost.\n    \"\"\"\n    lines = stdout.splitlines()\n    non_empty = [i for i, l in enumerate(lines) if l.strip()]\n    if not non_empty:\n        return stdout, None\n    last = non_empty[-1]\n    try:\n        payload = json.loads(lines[last])\n    except ValueError:\n        return stdout, None\n    transcript = \"\\n\".join(lines[:last])\n    return transcript, payload\n\n\nBUILD_ITERATION_BUDGET = 3\n\nBUILD_HALT_EXIT = 3\n\nCHECKS_FEEDBACK_TAIL_LINES = 200\n\n\ndef _retry_seed(root: Path, m: dict[str, Any], records_dir: Path\n                ) -> tuple[str | None, str | None, str]:\n    \"\"\"(retry_of, steer, feedback): what a retried build's first iteration\n    is handed (R3), in this order -- the prior attempt's own class and\n    signature; the evidence a returned review carries (a red required\n    check's log, read through [forge].check_log_command, or a review's\n    own blocking findings); and the newest steer newer than the blocking\n    record (counsel's answer text, named by the record it came from). A\n    build retries the latest build record that is not a pass, or --\n    retry_of still naming that same build attempt, the one a required\n    check rejected or a review returned -- the latest verify record that\n    returned it (class returned, its own build_sha matching the latest\n    build's): the two never coexist, since a returned review is read\n    only once its own build has already passed. (None, None, \"\") on a\n    first attempt -- nothing to retry, nothing to seed.\"\"\"\n    latest_build = cast(\"dict[str, Any] | None\", latest_record(records_dir, \"build\"))\n    latest_verify = cast(\"dict[str, Any] | None\", latest_record(records_dir, \"verify\"))\n    prior_stem = f\"build-{next_attempt_number(records_dir, 'build') - 1:02d}\"\n    prior: dict[str, Any] | None = None\n    counsel_stage, counsel_n = \"build\", next_attempt_number(records_dir, \"build\") - 1\n    if (latest_verify and (latest_verify.get(\"stop\") or {}).get(\"class\") == \"returned\"\n            and latest_build and latest_verify.get(\"build_sha\") == latest_build.get(\"sha\")):\n        prior = latest_verify\n        verify_attempts = parse_attempts(records_dir, \"verify\")\n        counsel_stage = \"verify\"\n        counsel_n = max(verify_attempts) if verify_attempts else 0\n    elif latest_build and latest_build.get(\"status\") != \"pass\":\n        prior = latest_build\n    if prior is None:\n        return None, None, \"\"\n\n    stop: dict[str, Any] = prior.get(\"stop\") or {}\n    lines = [f\"attempt {prior_stem} stopped as {stop.get('class')}: {stop.get('detail') or ''}\",\n            f\"signature: {stop.get('signature') or ''}\", \"\"]\n\n    forge = m.get(\"forge\") or {}\n    if stop.get(\"class\") == \"returned\":\n        findings = [f for f in (prior.get(\"findings\") or [])\n                   if str(f.get(\"severity\")) == \"blocking\"]\n        if findings:\n            lines.append(\"blocking findings:\")\n            for finding in findings:\n                lines.append(f\"- {finding.get('title')}: {finding.get('specimen')} \"\n                             f\"(retires: {finding.get('retires')})\")\n            lines.append(\"\")\n        elif forge.get(\"check_log_command\"):\n            for c in (prior.get(\"forge_checks\") or {}).get(\"conclusions\") or []:\n                if c.get(\"conclusion\") in (\"success\", \"neutral\", \"skipped\"):\n                    continue\n                run = subprocess.run(\n                    f\"{forge['check_log_command']} {shlex.quote(str(prior.get('sha')))} \"\n                    f\"{shlex.quote(c['name'])}\", shell=True, cwd=str(root),\n                    capture_output=True, text=True, check=False)\n                lines += [f\"--- check {c['name']} {c['conclusion']} ---\",\n                         run.stdout.strip(), \"\"]\n\n    steer_stem: str | None = None\n    if counsel_n:\n        target = f\"{counsel_stage}-{counsel_n:02d}\"\n        counsel_attempts = parse_attempts(records_dir, \"counsel\")\n        matches = [(n, rec) for n, rec in sorted(counsel_attempts.items())\n                  if rec.get(\"record\") == target]\n        if matches:\n            nn, counsel = matches[-1]\n            if counsel.get(\"verdict\") == \"answer\":\n                steer_stem = f\"counsel-{nn:02d}\"\n                answer = (counsel.get(\"proposal\") or {}).get(\"ruling_text\")\n                if answer:\n                    lines += [f\"steer from {steer_stem}:\", answer.strip(), \"\"]\n\n    return prior_stem, steer_stem, \"\\n\".join(lines) + \"\\n\"\n\n\ndef cmd_build(argv: list[str]) -> int:\n    root = Path(\".\").resolve()\n    item_id = argv[0] if argv else derive_item_id(root)\n    if not item_id:\n        print(\"attavo build: cannot derive item id; pass N or run on an attavo/N-* branch\",\n              file=sys.stderr)\n        return 2\n    m = read_manifest(root)\n    if m is None:\n        print(f\"attavo build: no {MANIFEST} at {root}\", file=sys.stderr)\n        return 2\n\n    adapter_name = (m.get(\"executor\") or {}).get(\"build\")\n    if not adapter_name:\n        print(\"attavo build: refused: no [executor].build in the manifest\")\n        return 1\n\n    tests_cfg = m.get(\"tests\") or {}\n    if not tests_cfg.get(\"select\") or not tests_cfg.get(\"run\"):\n        print(\"attavo build: refused: no [tests] table in the manifest \"\n              \"([tests].select and [tests].run are both required)\")\n        return 1\n\n    if (m.get(\"checks\") or {}).get(\"probe\") and not (m.get(\"checks\") or {}).get(\"probe_timeout_s\"):\n        print(\"attavo build: refused: [checks].probe is declared without \"\n              \"[checks].probe_timeout_s (a probe with no bound is not asked)\")\n        return 1\n\n    try:\n        status = approval_status(root, m, item_id)\n    except ShallowCheckoutError as exc:\n        print(f\"attavo build: refused: {exc}\", file=sys.stderr)\n        return 2\n    if status != \"valid\":\n        print(f\"attavo build: refused: approval is {status}\")\n        return 1\n\n    adapter_path = resolve_adapter(root, adapter_name)\n    if adapter_path is None:\n        print(f\"attavo build: refused: no adapter named {adapter_name!r}\")\n        return 1\n\n    specs_rel = m[\"paths\"][\"specs\"]\n    records_rel = m[\"paths\"][\"records\"]\n    spec_dir = root / specs_rel / item_id\n    item_records_dir = root / records_rel / item_id\n    spec_sha = last_commit_touching(root, str(Path(specs_rel) / item_id))\n    latest_approval = latest_record(item_records_dir, \"approval\")\n    parsed, _ = parse_spec(spec_dir / \"spec.md\")\n    claims = parsed[\"claims\"] if parsed else []\n    criteria_names = parsed[\"criteria\"] if parsed else []\n    adapter_config = merge_adapter_config(m, adapter_name, \"build\")\n    checks_cfg = m.get(\"checks\") or {}\n    checks_command = checks_cfg.get(\"command\")\n    probe = checks_cfg.get(\"probe\")\n    probe_timeout_s = checks_cfg.get(\"probe_timeout_s\")\n    identity = executor_identity(adapter_name)\n    reports = adapter_reports(adapter_path)\n\n    start_sha = git(root, \"rev-parse\", \"HEAD\").strip()\n    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n    started = time.monotonic()\n\n    events_path = stage_events_dir(root) / f\"build-{next_attempt_number(item_records_dir, 'build'):02d}.events.jsonl\"\n\n    # Issue #115, then issue #212: whether this machine can run the tenant's\n    # checks at all is asked once here, on the approved tree, before the\n    # adapter is ever invoked -- a missing import at test collection (item\n    # #106's build-01) is not a failing check, and no build could have\n    # passed against it. A tenant that declares [checks].probe is asked by\n    # the probe, inside [checks].probe_timeout_s: exit 0 yes, anything else\n    # or the bound no. A tenant that does not is asked the old way, by\n    # running [checks].command whole -- exit 2 no, exit 0 or 1 (the checks\n    # ran and passed or failed, the expected states before a build) yes --\n    # which is the run #194's build-01 spent 215 s on. Either way the feed\n    # says what is being asked and what the answer was.\n    if checks_command:\n        append_event(events_path, \"gate\", \"checking this machine can run the checks\")\n        asked = checks_command\n        if probe:\n            asked = probe\n            code, out, err, timed_out = run_bounded(probe, root, \"\", probe_timeout_s)\n            refusal_text = (f\"[checks].probe did not finish within {probe_timeout_s} s\" if timed_out\n                            else f\"[checks].probe exited {code} on the approved tree\"\n                            if code != 0 else None)\n        else:\n            preflight = subprocess.run(checks_command, shell=True, cwd=str(root),\n                                       capture_output=True, text=True, check=False)\n            code, out, err = preflight.returncode, preflight.stdout, preflight.stderr\n            refusal_text = (\"[checks].command exited 2 on the approved tree\" if code == 2 else None)\n        if refusal_text:\n            append_event(events_path, \"gate\", f\"this machine cannot run the checks: {refusal_text}\")\n            log = out + err\n            detail = _log_last_line(out + \"\\n\" + err) or refusal_text\n            record = {\n                \"sha\": start_sha,\n                \"start_sha\": start_sha,\n                \"spec_sha\": spec_sha,\n                \"approval_sha\": latest_approval.get(\"sha\") if latest_approval else None,\n                \"at\": now_iso(),\n                \"adapter\": adapter_name,\n                \"adapter_config\": adapter_config,\n                \"executor_identity\": identity,\n                \"reports\": reports,\n                \"adapter_version\": None,\n                \"model\": None,\n                \"model_version\": None,\n                \"iterations\": 1,\n                \"criteria\": [],\n                \"selected_tests\": None,\n                \"checks\": {\"command\": asked, \"exit\": code},\n                \"tokens\": {\"input\": 0, \"output\": 0},\n                \"cost_usd\": None,\n                \"wall_clock_s\": round(time.monotonic() - started, 3),\n                \"status\": \"refused\",\n                \"refusal\": refusal_text,\n                \"halted\": None,\n                \"retry_of\": None,\n                \"steer\": None,\n                # R3: environment is never retried by this item (recorded\n                # here, acted on by R4's breaker) -- signed anyway for\n                # the exhaustion report's own side-by-side, on the\n                # remote chance a person retries by hand.\n                \"stop\": {\"class\": \"environment\", \"provenance\": \"tenant\", \"detail\": detail,\n                        \"signature\": signature_of(detail), \"bound\": None},\n            }\n            record_path = write_record(item_records_dir, \"build\", record, m, item_id,\n                                       log=log or refusal_text + \"\\n\")\n            print(f\"attavo build: refused ({record_path.name})\")\n            return 1\n        append_event(events_path, \"gate\", \"this machine can run the checks\")\n\n    adapter_version = model = model_version = None\n    tokens = {\"input\": 0, \"output\": 0}\n    cost_usd = None\n    transcripts: list[str] = []\n    criteria_results: list[dict[str, Any]] = []\n    selected_tests: dict[str, Any] | None = None\n    checks_result: dict[str, Any] | None = None\n    status_out = \"failed\"\n    refusal = None\n    refusal_provenance = None\n    halted = None\n    iterations_used = 0\n\n    with tempfile.TemporaryDirectory() as tmp:\n        feedback_path = Path(tmp) / \"feedback.txt\"\n        feedback_path.write_text(\"\")\n        # R3: a retried attempt's first iteration starts with the prior\n        # attempt's class and signature, its evidence, and the newest\n        # steer newer than the blocking record -- the one file the\n        # contract already passes, no new adapter input at all.\n        retry_of, steer, seed = _retry_seed(root, m, item_records_dir)\n        if seed:\n            feedback_path.write_text(seed)\n\n        for iteration in range(1, BUILD_ITERATION_BUDGET + 1):\n            iterations_used = iteration\n            append_event(events_path, \"iteration\", f\"iteration {iteration} of {BUILD_ITERATION_BUDGET}\")\n            env = dict(os.environ)\n            # #212 retired the checks command reaching the executor; an\n            # ATTAVO_CHECKS_COMMAND exported by whoever launched `attavo\n            # build` must not reach it by inheritance either.\n            env.pop(\"ATTAVO_CHECKS_COMMAND\", None)\n            env[\"ATTAVO_SPEC_DIR\"] = str(spec_dir)\n            env[\"ATTAVO_RECORDS_DIR\"] = str(item_records_dir)\n            env[\"ATTAVO_RULINGS\"] = str(root / m[\"paths\"][\"rulings\"])\n            env[\"ATTAVO_BRANCH\"] = branch\n            env[\"ATTAVO_ITERATION\"] = str(iteration)\n            env[\"ATTAVO_FEEDBACK\"] = str(feedback_path)\n            env[\"ATTAVO_ADAPTER_CONFIG\"] = json.dumps(adapter_config)\n            env[\"ATTAVO_STAGE\"] = \"build\"\n            env[\"ATTAVO_EVENTS\"] = str(events_path)\n            env[\"ATTAVO_TEST_COMMAND\"] = f\"python3 {PRODUCT_ROOT / 'bin' / 'attavo'} test {item_id}\"\n            if tests_cfg.get(\"call_timeout_s\"):\n                env[\"ATTAVO_TEST_TIMEOUT_S\"] = str(tests_cfg[\"call_timeout_s\"])\n            else:\n                env.pop(\"ATTAVO_TEST_TIMEOUT_S\", None)\n    for line in diff_text.splitlines():\n        if line.startswith(\"diff --git \"):\n            path, in_hunk = None, False\n        elif in_hunk:\n            if line.startswith(\"+\") and line[1:].strip() and path is not None:\n                added += 1\n                shipped += line[1:].rstrip() in stub_lines[path]\n        elif line.startswith(\"+++ \"):\n            name = line[4:].split(\"\\t\")[0]\n            path = name[2:] if name.startswith(\"b/\") else None\n            if path is not None and any(path == e or path.startswith(e + \"/\") for e in skipped):\n                path = None\n            if path is not None and path not in stub_lines:\n                stub_file = stub_dir / path\n                stub_lines[path] = (\n                    {text.rstrip() for text in stub_file.read_text(errors=\"replace\").splitlines()}\n                    if stub_file.is_file() else set())\n        elif line.startswith(\"@@\"):\n            in_hunk = True\n    return shipped / added if added else None\n\n\ndef _returned_stop(forge_checks: dict[str, Any]) -> dict[str, Any]:\n    \"\"\"R3 (ruling C amended): a review the forge returned because a\n    required check concluded red is class returned, retryable -- the\n    next build attempt is handed the evidence -- signed by the sorted\n    names of the checks that concluded red. A review returned because\n    the checks have not concluded at all yet (nothing to sign) stays\n    forge-unconcluded, as before -- there is no rejection to hand a\n    build, only a wait that already has its own bound (the drive\n    forge-poll bound, unchanged by this item).\"\"\"\n    conclusions = forge_checks.get(\"conclusions\") or []\n    red = sorted(c[\"name\"] for c in conclusions\n                if c[\"conclusion\"] not in FORGE_OK_CONCLUSIONS\n                and c[\"conclusion\"] not in FORGE_UNCONCLUDED_STATUSES)\n    unconcluded = [c for c in conclusions if c[\"conclusion\"] in FORGE_UNCONCLUDED_STATUSES]\n    if red and not unconcluded:\n        detail = \", \".join(f\"{c['name']} {c['conclusion']}\" for c in conclusions if c[\"name\"] in red)\n        return {\"class\": \"returned\", \"provenance\": \"tenant\", \"detail\": detail,\n               \"signature\": signature_of(\" \".join(red)), \"bound\": None}\n    stop = dict(derive_stop(\"returned\") or {})\n    return {**stop, \"signature\": None, \"bound\": None}\n\n\ndef _verify_retry_seed(records_dir: Path, build_sha: str) -> tuple[str | None, str | None]:\n    \"\"\"(retry_of, steer): a plain retry of verify itself -- died, hung,\n    transient, or any other non-returned stop counsel answered -- names\n    the prior verify attempt it retries, the same way build's own retry\n    does. A returned review is never this: its own fix is a new build,\n    not a new verify, so build.py's _retry_seed is what names it as\n    retry_of instead.\"\"\"\n    attempts = parse_attempts(records_dir, \"verify\")\n    if not attempts:\n        return None, None\n    nn = max(attempts)\n    prior = attempts[nn]\n    stop = cast(\"dict[str, Any]\", prior.get(\"stop\") or {})\n    if prior.get(\"status\") == \"pass\" or prior.get(\"build_sha\") != build_sha or stop.get(\"class\") == \"returned\":\n        return None, None\n    prior_stem = f\"verify-{nn:02d}\"\n    counsel = counsel_record_for(records_dir, \"verify\", nn)\n    steer = None\n    if counsel is not None and counsel.get(\"verdict\") == \"answer\":\n        counsel_attempts = parse_attempts(records_dir, \"counsel\")\n        matches = [n for n, rec in counsel_attempts.items() if rec.get(\"record\") == prior_stem]\n        if matches:\n            steer = f\"counsel-{max(matches):02d}\"\n    return prior_stem, steer\n\n\ndef cmd_verify(argv: list[str]) -> int:\n    root = Path(\".\").resolve()\n    item_id = argv[0] if argv else derive_item_id(root)\n    if not item_id:\n        print(\"attavo verify: cannot derive item id; pass N or run on an attavo/N-* branch\",\n              file=sys.stderr)\n        return 2\n    m = read_manifest(root)\n    if m is None:\n        print(f\"attavo verify: no {MANIFEST} at {root}\", file=sys.stderr)\n        return 2\n\n    specs_rel = m[\"paths\"][\"specs\"]\n    records_rel = m[\"paths\"][\"records\"]\n    item_records_dir = root / records_rel / item_id\n\n    latest_build = latest_record(item_records_dir, \"build\")\n    if latest_build is None:\n        print(f\"attavo verify: refused: no build record for item {item_id}\")\n        return 1\n    if latest_build.get(\"status\") != \"pass\":\n        print(f\"attavo verify: refused: latest build record is \"\n              f\"{latest_build.get('status')!r}, not pass\")\n        return 1\n\n    forge_cfg = m.get(\"forge\") or {}\n    checks_command = forge_cfg.get(\"checks_command\")\n    if not checks_command:\n        print(\"attavo verify: refused: no [forge].checks_command in the manifest\")\n        return 1\n\n    build_sha = latest_build[\"sha\"]\n    build_record_path = latest_attempt_path(item_records_dir, \"build\")\n    approval_sha = latest_build.get(\"approval_sha\")\n    spec_dir = root / specs_rel / item_id\n    started = time.monotonic()\n    head_sha = git(root, \"rev-parse\", \"HEAD\").strip()\n\n    diff_text, diff_refusal = diff_since_approval(root, approval_sha)\n    if diff_refusal:\n        print(f\"attavo verify: refused: {diff_refusal}\")\n        return 1\n    # The forge attaches checks to a pull request's head, not to the\n    # executor's own commit -- that commit stops being the head the\n    # moment a record commit lands on top of it (issue #44). Reading the\n    # forge on head_sha is what the forge actually checked and what will\n    # be merged; build_sha and forge_checks[\"sha\"] can differ, and both\n    # are kept on the record rather than one sha serving two purposes.\n    # head_sha is a marker commit just pushed (issue #178): the forge has\n    # not attached anything to it yet on the first read, so this polls\n    # with the same bound and interval the drive's own guard uses, giving\n    # those checks room to conclude before this read judges them.\n    given = os.environ.get(\"ATTAVO_FORGE_CHECKS\")\n    if given:\n        # Reconciler ruling B: the pass read the checks on the head before\n        # its marker commit and found them green; a records-only commit\n        # cannot change them (#210's proof), so the review takes that read\n        # and does not poll a head the forge has not attached anything to.\n        forge_checks = json.loads(Path(given).read_text())\n        forge_ok = bool(forge_checks.get(\"conclusions\")) and all(\n            c[\"conclusion\"] in FORGE_OK_CONCLUSIONS for c in forge_checks[\"conclusions\"])\n    else:\n        forge_checks, forge_ok = poll_forge_checks(root, checks_command, head_sha)\n\n    if not forge_ok:\n        record: dict[str, Any] = {\n            \"sha\": head_sha,\n            \"build_sha\": build_sha,\n            \"build_record\": build_record_path.stem if build_record_path else None,\n            \"approval_sha\": approval_sha,\n            \"at\": now_iso(),\n            \"adapter\": None, \"adapter_config\": {}, \"adapter_version\": None,\n            \"model\": None, \"model_version\": None,\n            \"reports\": [],\n            \"forge_checks\": forge_checks,\n            \"findings\": None,\n            \"tests_named\": [],\n            \"commits\": [],\n            \"stub_ratio\": stub_ratio(diff_text, spec_dir / \"stub\", (specs_rel, records_rel)),\n            \"tokens\": {\"input\": 0, \"output\": 0}, \"cost_usd\": None,\n            \"wall_clock_s\": round(time.monotonic() - started, 3),\n            \"status\": \"returned\",\n            \"retry_of\": None, \"steer\": None,\n            \"stop\": _returned_stop(forge_checks),\n        }\n        record_path = write_record(item_records_dir, \"verify\", record, m, item_id)\n        print(f\"attavo verify: returned ({record_path.name}); the forge checks are not green\")\n        return 0\n\n    executor = m.get(\"executor\") or {}\n    adapter_name = executor.get(\"verify\") or executor.get(\"build\")\n    if not adapter_name:\n        print(\"attavo verify: refused: no [executor].verify or [executor].build in the manifest\")\n        return 1\n    adapter_path = resolve_adapter(root, adapter_name)\n    if adapter_path is None:\n        print(f\"attavo verify: refused: no adapter named {adapter_name!r}\")\n        return 1\n\n    adapter_config = merge_adapter_config(m, adapter_name, \"verify\")\n    reports = adapter_reports(adapter_path)\n    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n\n    events_path = stage_events_dir(root) / f\"verify-{next_attempt_number(item_records_dir, 'verify'):02d}.events.jsonl\"\n\n    with tempfile.TemporaryDirectory() as tmp:\n        diff_path = Path(tmp) / \"diff.patch\"\n        diff_path.write_text(diff_text)\n\n        env = dict(os.environ)\n        env[\"ATTAVO_SPEC_DIR\"] = str(spec_dir)\n        env[\"ATTAVO_RECORDS_DIR\"] = str(item_records_dir)\n        env[\"ATTAVO_RULINGS\"] = str(root / m[\"paths\"][\"rulings\"])\n        env[\"ATTAVO_BRANCH\"] = branch\n        env[\"ATTAVO_STAGE\"] = \"verify\"\n        env[\"ATTAVO_DIFF\"] = str(diff_path)\n        env[\"ATTAVO_BUILD_RECORD\"] = str(build_record_path) if build_record_path else \"\"\n        env[\"ATTAVO_ADAPTER_CONFIG\"] = json.dumps(adapter_config)\n        env[\"ATTAVO_EVENTS\"] = str(events_path)\n\n        run = subprocess.run([str(adapter_path)], cwd=str(root), env=env,\n                             capture_output=True, text=True, check=False)\n        transcript, payload = split_adapter_stdout(run.stdout)\n        if run.returncode != 0:\n            # Same guarantee as cmd_build's, issue #53: a non-zero adapter\n            # exit always leaves a non-empty log.\n            detail = f\"[adapter exited {run.returncode}]\"\n            if run.stderr.strip():\n                detail += \"\\n\" + run.stderr.rstrip(\"\\n\")\n            transcript = (transcript + \"\\n\" if transcript else \"\") + detail\n\n    # Verify is a report, not a commit (issue #46): the adapter is invoked\n    # on the branch head it was handed, and must leave that head alone.\n    # Checked by comparing the head before the invocation (head_sha,\n    # already read above for the forge) against the head after it.\n    post_adapter_head = git(root, \"rev-parse\", \"HEAD\").strip()\n    commits: list[str] = []\n    if post_adapter_head != head_sha:\n        commits = git(root, \"rev-list\", f\"{head_sha}..{post_adapter_head}\", \"--reverse\").split()\n\n    status_out = \"failed\"\n    findings = None\n    tests_named: list[str] = []\n    model = model_version = adapter_version_out = None\n    tokens = {\"input\": 0, \"output\": 0}\n    cost_usd = None\n\n    if run.returncode == 0 and payload is not None and payload.get(\"model\"):\n        model = payload.get(\"model\")\n        model_version = payload.get(\"model_version\")\n        adapter_version_out = payload.get(\"adapter_version\")\n        tok = payload.get(\"tokens\") or {}\n        tokens = {\"input\": tok.get(\"input\", 0) or 0, \"output\": tok.get(\"output\", 0) or 0}\n        cost_usd = payload.get(\"cost_usd\")\n        # \"findings\" absent (or explicitly null) is not the same as an\n        # empty list: the adapter had no channel to report one at all,\n        # which is not a clean bill of health (issue #46). A commit\n        # during verify fails the attempt regardless of what it reported.\n        if not commits and \"findings\" in payload and payload[\"findings\"] is not None:\n            findings = payload[\"findings\"]\n            tests_named = payload.get(\"tests_named\") or []\n            status_out = \"pass\"\n\n    # R3 (ruling C amended): a finding whose severity is \"blocking\" makes\n    # this review's status failed with class returned -- retryable, the\n    # next build attempt handed the findings as its evidence -- signed\n    # by the sorted titles of the blocking findings themselves. Every\n    # other severity leaves the review a pass, filed as today (issue\n    # #46's own findings channel, untouched).\n    blocking = sorted(f[\"title\"] for f in (findings or []) if str(f.get(\"severity\")) == \"blocking\")\n    if blocking:\n        status_out = \"failed\"\n        # write_record refuses a \"failed\" record with no trail at all\n        # (issue #53); a review whose own transcript is otherwise empty\n        # (a terse adapter that prints only its report line) still owes\n        # one -- the blocking findings themselves are the cause.\n        if not transcript.strip():\n            transcript = \"blocking finding(s): \" + \"; \".join(blocking)\n\n    retry_of, steer = _verify_retry_seed(item_records_dir, build_sha)\n    if blocking:\n        stop: dict[str, Any] | None = {\"class\": \"returned\", \"provenance\": \"tenant\",\n                                       \"detail\": \"; \".join(blocking),\n                                       \"signature\": signature_of(\" \".join(blocking)), \"bound\": None}\n    else:\n        stop = cast(\"dict[str, Any] | None\",\n                   derive_stop(status_out, log=transcript, report_class=(payload or {}).get(\"class\")))\n        if stop is not None:\n            stop_detail: str | None = ((payload or {}).get(\"detail\") if stop[\"class\"] == \"transient\"\n                                       else stop.get(\"detail\"))\n            stop = {**stop, \"detail\": stop_detail, \"signature\": signature_of(stop_detail), \"bound\": None}\n\n    record = {\n        \"sha\": head_sha,\n        \"build_sha\": build_sha,\n        \"build_record\": build_record_path.stem if build_record_path else None,\n        \"approval_sha\": approval_sha,\n        \"at\": now_iso(),\n        \"adapter\": adapter_name,\n        \"adapter_config\": adapter_config,\n        \"adapter_version\": adapter_version_out,\n        \"model\": model,\n        \"model_version\": model_version,\n        \"reports\": reports,\n        \"forge_checks\": forge_checks,\n        \"findings\": findings,\n        \"tests_named\": tests_named,\n        \"commits\": commits,\n        \"stub_ratio\": stub_ratio(diff_text, spec_dir / \"stub\", (specs_rel, records_rel)),\n        \"tokens\": tokens,\n        \"cost_usd\": cost_usd,\n        \"wall_clock_s\": round(time.monotonic() - started, 3),\n        \"status\": status_out,\n        \"retry_of\": retry_of,\n        \"steer\": steer,\n        \"stop\": stop,\n    }\n    record_path = write_record(item_records_dir, \"verify\", record, m, item_id, log=transcript)\n\n    print(f\"attavo verify: {status_out} ({record_path.name})\")\n    return 0 if status_out == \"pass\" else 1\n\n\n# issue #84: a constant the lane names, not a manifest key, until a tenant\n# disagrees -- how long drive gives a forge's checks room to conclude\n# before it gives up and stops rather than call a judge on a tree the\n# forge has not yet finished reading. Tenant zero's own checks conclude\n# about five minutes after a push; the default bound gives them room to\n# finish so a person is not the one re-running drive after CI, which is\n# exactly the transport act this lane retires. ATTAVO_DRIVE_POLL_BOUND_S\n# and ATTAVO_DRIVE_POLL_INTERVAL_S, read at call time rather than once at\n# import, are for a test's own clock, not a tenant's -- there is no\n# manifest key for either.\nDRIVE_FORGE_POLL_BOUND_DEFAULT_S = 600.0\n\nDRIVE_FORGE_POLL_INTERVAL_DEFAULT_S = 20.0\n\n\ndef drive_forge_poll_bound_s() -> float:\n    return float(os.environ.get(\"ATTAVO_DRIVE_POLL_BOUND_S\", DRIVE_FORGE_POLL_BOUND_DEFAULT_S))\n\n\ndef drive_forge_poll_interval_s() -> float:\n    return float(os.environ.get(\"ATTAVO_DRIVE_POLL_INTERVAL_S\", DRIVE_FORGE_POLL_INTERVAL_DEFAULT_S))\n\n\ndef forge_checks_unconcluded(forge_checks: dict[str, Any]) -> bool:\n    \"\"\"Whether poll_forge_checks should keep waiting rather than stop at\n    once: an empty read (the forge has not attached any check to this sha\n    yet) or any one check still carrying a status (queued, in_progress,\n    pending, waiting) rather than a concluded conclusion. A concluded\nfrom __future__ import annotations\n\nimport json\nfrom pathlib import Path\nfrom typing import Any\n\nfrom attavo.common import STAGES, ShallowCheckoutError, git\nfrom attavo.doctor import invocations_without_record, merge_introducing_records, stall_bound_s\nfrom attavo.drive import InvocationReading, drive_state, read_invocation, retry_state, uncommitted_record\nfrom attavo.records import next_attempt_number, parse_attempts\nfrom attavo.types import CounselRecord, DriveReport\nfrom attavo.verify import FORGE_OK_CONCLUSIONS, FORGE_UNCONCLUDED_STATUSES, read_forge_checks\n\n# --- drive --report (reconciler R1, rulings A and G): what one item is\n# waiting on, and for whom -- drive's own decision (drive_state, the\n# invocation readers recovery uses, read_forge_checks) read without acting\n# on it. It writes nothing, starts nothing, and reads the forge once and\n# never polls it, so a refusal is a level anyone can read again rather than\n# a line drive printed once. `says` speaks the operator's words: a stage is\n# \"build\" or \"review\", never the command that runs it. ---\n\n_WORD = {\"build\": \"build\", \"verify\": \"review\"}\n\n_COUNSEL_SAYS = {\"answer\": \"has an answer\", \"patch\": \"found a product defect\",\n                 \"person\": \"says it is a person's call\"}\n\n\ndef _head(root: Path) -> str | None:\n    try:\n        return git(root, \"rev-parse\", \"HEAD\").strip() or None\n    except RuntimeError:\n        return None\n\n\ndef _latest(records_dir: Path, stage: str) -> tuple[str, dict[str, Any]] | None:\n    \"\"\"(stem, record) of the highest-numbered <stage>-NN.json, or None.\"\"\"\n    attempts = parse_attempts(records_dir, stage)\n    if not attempts:\n        return None\n    nn = max(attempts)\n    return f\"{stage}-{nn:02d}\", attempts[nn]\n\n\ndef _filed(records_dir: Path, stem: str) -> str | None:\n    marker = records_dir / f\"{stem}.filed\"\n    try:\n        text = marker.read_text().strip()\n    except OSError:\n        return None\n    return text or None\n\n\ndef _counsel_of(records_dir: Path, stem: str) -> tuple[str, CounselRecord] | None:\n    \"\"\"The latest counsel record that read the stop named stem.\"\"\"\n    attempts = parse_attempts(records_dir, \"counsel\")\n    for nn in sorted(attempts, reverse=True):\n        if attempts[nn].get(\"record\") == stem:\n            return f\"counsel-{nn:02d}\", attempts[nn]\n    return None\n\n\ndef _stopped(root: Path, m: dict[str, Any], r: DriveReport, records_dir: Path, stage: str,\n            stem: str, record: dict[str, Any]) -> DriveReport:\n    stop = record.get(\"stop\") or {}\n    stop_class = stop.get(\"class\")\n    attempt = int(stem.rsplit(\"-\", 1)[1])\n    r[\"state\"], r[\"kind\"], r[\"stage\"] = \"stopped\", \"yours\", stage\n    r[\"attempt\"], r[\"record\"], r[\"stop_class\"] = attempt, stem, stop_class\n    r[\"filed\"] = _filed(records_dir, stem)\n\n    # R3: every attempt of this stage, side by side -- the exhaustion\n    # report's own comparison, printed whether or not the budget is\n    # actually spent yet, since a person reading --report wants the same\n    # picture drive itself would act on.\n    attempts = parse_attempts(records_dir, stage)\n    rows: list[dict[str, Any]] = [\n        {\"attempt\": nn, \"class\": (rec.get(\"stop\") or {}).get(\"class\"),\n         \"signature\": (rec.get(\"stop\") or {}).get(\"signature\"),\n         \"bound\": (rec.get(\"stop\") or {}).get(\"bound\"),\n         \"wall_clock_s\": rec.get(\"wall_clock_s\"), \"cost_usd\": rec.get(\"cost_usd\")}\n        for nn, rec in sorted(attempts.items())]\n    r[\"attempts\"] = rows\n    last_two = [row[\"signature\"] for row in rows[-2:]]\n    signatures_match = bool(len(last_two) == 2 and last_two[0] is not None and last_two[0] == last_two[1])\n    r[\"signatures_match\"] = signatures_match\n    r[\"rulings_available\"] = [\n        \"attavo drive N --again: reset the budget and start the next attempt\"\n        + (\" (unlikely to help: the last two attempts failed the same way)\" if signatures_match else \"\"),\n        \"amend the spec (moves the approval)\"]\n\n    state = retry_state(root, m, records_dir, stage, stop_class, attempt)\n    how = f\"as {stop_class}\" if stop_class else f\"({record.get('status')})\"\n    if state.waiting_s is not None:\n        r[\"kind\"] = \"waits\"\n        says = (f\"{_WORD[stage].capitalize()} attempt {attempt:02d} stopped {how}; retrying \"\n                f\"{_WORD[stage]} in {int(state.waiting_s)} s\")\n    elif state.eligible:\n        r[\"kind\"] = \"acts\"\n        says = f\"{_WORD[stage].capitalize()} attempt {attempt:02d} stopped {how}; the next pass retries it\"\n    else:\n        says = f\"Needs you: {_WORD[stage]} attempt {attempt:02d} stopped {how}\"\n    counsel = _counsel_of(records_dir, stem)\n    if counsel:\n        r[\"counsel\"] = counsel[0]\n        verdict = str(counsel[1].get(\"verdict\"))\n        verdict_says = _COUNSEL_SAYS.get(verdict)\n        says += f\"; {counsel[0]} {verdict_says or 'could not read it'}\"\n        if verdict == \"patch\":\n            says += f\"; waiting on {r['filed'] or 'the issue counsel filed'}\"\n    if r[\"filed\"] and \"waiting on\" not in says:\n        says += f\"; filed as {r['filed']}\"\n    r[\"says\"] = says\n    return r\n\n\ndef _invocation(r: DriveReport, reading: InvocationReading, info: dict[str, Any],\n                bound: int | None) -> DriveReport:\n    stage, nn, _log, _last_at, age, cls, crossed = reading\n    r[\"stage\"], r[\"attempt\"], r[\"stop_class\"] = stage, nn, None if cls == \"running\" else cls\n    r[\"since\"] = info.get(\"at\") if isinstance(info.get(\"at\"), str) else None\n    r[\"last_event_age_s\"] = None if age is None else int(age)\n    word = _WORD[stage]\n    if cls == \"running\":\n        r[\"state\"], r[\"kind\"] = \"running\", \"waits\"\n        r[\"says\"] = (f\"{word.capitalize()} running since {r['since'] or 'an unknown time'}; \"\n                     f\"nothing to do until it finishes\")\n    else:\n        r[\"state\"], r[\"kind\"] = \"owes-recovery\", \"acts\"\n        if cls == \"hung\" and crossed == \"ceiling\":\n            # R3: a stage past its own ceiling is hung by wall clock\n            # alone -- never worded in terms of event age, which an\n            # adapter that streams no events never had to begin with.\n            r[\"says\"] = (f\"{word.capitalize()} attempt {nn:02d} is alive {r['last_event_age_s']} s \"\n                         f\"after it began, past its ceiling; recovery would end it and record it \"\n                         f\"as hung\")\n        elif cls == \"hung\":\n            r[\"says\"] = (f\"{word.capitalize()} attempt {nn:02d} is alive but has had no event for \"\n                         f\"{r['last_event_age_s']} s (bound {bound} s); recovery would end it and \"\n                         f\"record it as hung\")\n        else:\n            r[\"says\"] = (f\"{word.capitalize()} attempt {nn:02d} is gone and wrote no record; \"\n                         f\"recovery would record it as died\")\n    return r\n\n\ndef _pending(root: Path, m: dict[str, Any], records_dir: Path, r: DriveReport) -> DriveReport | None:\n    \"\"\"The report for an invocation that began and wrote no record, or None\n    when every invocation has its record. One that needs recovery reads\n    before one still running: it is the one the next move is about. R2:\n    a bound is no longer required to read this at all -- read_invocation\n    reads alive from the heartbeat first, and needs a stall bound only to\n    call a live, heartbeat-less invocation hung rather than running.\"\"\"\n    pending = invocations_without_record(records_dir)\n    if not pending:\n        return None\n    bound = stall_bound_s(m)\n    readings = [(read_invocation(root, bound, marker, info), info) for marker, info in pending]\n    reading, info = next(((rd, i) for rd, i in readings if rd.cls != \"running\"), readings[0])\n    if reading.stage not in _WORD:\n        r[\"state\"], r[\"kind\"] = \"refused\", \"yours\"\n        r[\"says\"] = f\"Found an invocation marker for an unknown stage, {reading.stage}\"\n        return r\n    if reading.cls != \"running\" and next_attempt_number(records_dir, reading.stage) != reading.nn:\n        r[\"state\"], r[\"kind\"], r[\"stage\"], r[\"attempt\"] = \"refused\", \"yours\", reading.stage, reading.nn\n        r[\"says\"] = (f\"{_WORD[reading.stage].capitalize()} attempt {reading.nn:02d} wrote no record, but a \"\n                     f\"later one exists; read the records before recovering\")\n        return r\n    return _invocation(r, reading, info, bound)\n\n\ndef _uncommitted(root: Path, m: dict[str, Any], records_dir: Path, r: DriveReport,\n                 stage: str) -> DriveReport | None:\n    \"\"\"R2: a record the working tree carries but git has no commit for yet\n    -- the moment between a worker's write and its own commit -- reads as\n    running for as long as the invocation it belongs to still touches its\n    heartbeat; one a stale heartbeat left behind is a refusal naming the\n    file, not a silent read of a record that was never actually\n    transported. None when the latest record for stage is already\n    committed (the ordinary case).\"\"\"\n    path = uncommitted_record(root, records_dir, stage)\n    if path is None:\n        return None\n    nn = int(path.stem.rsplit(\"-\", 1)[1])\n    marker = records_dir / f\"{stage}-{nn:02d}.started\"\n    info: dict[str, Any] = {}\n    if marker.is_file():\n        try:\n            with marker.open() as fh:\n                loaded = json.load(fh)\n            info = loaded if isinstance(loaded, dict) else {}\n        except (OSError, ValueError):\n            info = {}\n    bound = stall_bound_s(m)\n    reading = read_invocation(root, bound, marker, info) if marker.is_file() else None\n    word = _WORD[stage]\n    if reading is not None and reading.cls == \"running\":\n        r[\"state\"], r[\"kind\"], r[\"stage\"], r[\"attempt\"] = \"running\", \"waits\", stage, nn\n        r[\"since\"] = info.get(\"at\") if isinstance(info.get(\"at\"), str) else None\n        r[\"says\"] = (f\"{word.capitalize()} running; its {stage}-{nn:02d}.json is written but \"\n                     f\"not yet committed\")\n        return r\n    r[\"state\"], r[\"kind\"] = \"refused\", \"yours\"\n    r[\"says\"] = f\"{path.name} exists but was never committed; its worker's heartbeat went stale first\"\n    return r\n\n\ndef _checks(r: DriveReport, forge_checks: dict[str, Any], ok: bool, ready: bool) -> DriveReport:\n    \"\"\"Read the forge's answer on the head as a level: green, still\n    running, or done and not green.\"\"\"\n    conclusions: list[dict[str, str]] = forge_checks[\"conclusions\"]\n    r[\"checks\"] = [{\"name\": c[\"name\"], \"conclusion\": c[\"conclusion\"]} for c in conclusions]\n    head7 = (r[\"head\"] or \"\")[:7]\n    if ok:\n        if ready:\n            r[\"state\"], r[\"kind\"], r[\"says\"] = \"ready-to-merge\", \"yours\", \"Ready to merge\"\n        else:\n            r[\"state\"], r[\"kind\"], r[\"stage\"] = \"next-review\", \"acts\", \"verify\"\n            r[\"says\"] = f\"Review is next; the checks are green on {head7}\"\n        return r\n    unconcluded = [c for c in conclusions if c[\"conclusion\"] in FORGE_UNCONCLUDED_STATUSES]\n    if unconcluded or not conclusions:\n        named = \", \".join(f\"{c['name']} {c['conclusion']}\" for c in unconcluded) or \"no checks reported\"\n        r[\"state\"], r[\"kind\"], r[\"stage\"] = \"waiting-on-checks\", \"waits\", None if ready else \"verify\"\n        r[\"says\"] = f\"Waiting on the checks: {named} on {head7}\"\n        return r\n    named = (\", \".join(f\"{c['name']} {c['conclusion']}\" for c in conclusions\n                       if c[\"conclusion\"] not in FORGE_OK_CONCLUSIONS)\n             or \"the checks command did not succeed\")\n    r[\"state\"], r[\"kind\"], r[\"stage\"] = \"blocked-on-checks\", \"waits\", None if ready else \"verify\"\n    after = \"the item is ready to merge\" if ready else \"review starts\"\n    r[\"says\"] = f\"Blocked: {named} on {head7}; {after} once the checks are green\"\n    return r\n\n\ndef drive_report(root: Path, m: dict[str, Any], item_id: str) -> DriveReport:\n    \"\"\"The item's level, from the same reads `attavo drive` decides on --\n    drive_state over its records, the markers recovery reads, one read of\n    the forge -- and never an act: no record written, nothing started, no\n    poll. A state for every item the records directory carries.\"\"\"\n    records_dir = root / m[\"paths\"][\"records\"] / item_id\n    r: DriveReport = {\"item\": item_id, \"state\": \"refused\", \"kind\": \"yours\", \"says\": \"\", \"stage\": None,\n                      \"attempt\": None, \"record\": None, \"stop_class\": None, \"counsel\": None,\n                      \"filed\": None, \"head\": _head(root), \"checks\": None, \"since\": None,\n                      \"last_event_age_s\": None, \"attempts\": None, \"signatures_match\": None,\n                      \"rulings_available\": None}\n\n    merge, _ = merge_introducing_records(root, m[\"paths\"][\"records\"], item_id, STAGES)\n    if merge:\n        r[\"state\"], r[\"kind\"], r[\"says\"] = \"merged\", \"done\", f\"Merged in {merge[:7]}\"\n        return r\n\n    try:\n        step, why, _ = drive_state(root, m, item_id)\n    except ShallowCheckoutError as exc:\n        r[\"says\"] = f\"Cannot read this item: {exc}\"\n        return r\n    if step == \"no-approval\":\n        r[\"state\"], r[\"kind\"] = \"waiting-on-approval\", \"yours\"\n        r[\"says\"] = (\"Waiting on you: approve the spec\" if why == \"absent\" else\n                     \"Waiting on you: the approval expired because the spec changed after it; \"\n                     \"approve the spec again\")\n        return r\n\n    pending = _pending(root, m, records_dir, r)\n    if pending:\n        return pending\n\n    if step in (\"build\", \"verify\"):\n        held = _uncommitted(root, m, records_dir, r, step)\n        if held:\n            return held\n\n    build = _latest(records_dir, \"build\")\n    if step == \"build\":\n        approval = _latest(records_dir, \"approval\")\n        if (build and build[1].get(\"status\") != \"pass\"\n                and build[1].get(\"approval_sha\") == (approval[1].get(\"sha\") if approval else None)):\n            return _stopped(root, m, r, records_dir, \"build\", build[0], build[1])\n        r[\"state\"], r[\"kind\"], r[\"stage\"] = \"next-build\", \"acts\", \"build\"\n        r[\"says\"] = \"Build is next\"\n        return r\n\n    review = _latest(records_dir, \"verify\")\n    if (step == \"verify\" and review and review[1].get(\"status\") != \"pass\"\n            and build and review[1].get(\"build_sha\") == build[1].get(\"sha\")):\n        return _stopped(root, m, r, records_dir, \"verify\", review[0], review[1])\n\n    checks_command = (m.get(\"forge\") or {}).get(\"checks_command\")\n    if not checks_command:\n        r[\"says\"] = \"No checks command is set in the manifest, so nothing can say whether the checks are green\"\n        return r\n    forge_checks, ok = read_forge_checks(root, checks_command, r[\"head\"] or \"\")\n    return _checks(r, forge_checks, ok, ready=step == \"ready\")\nfrom __future__ import annotations\n\nimport json\nimport re\nimport sys\nfrom pathlib import Path\nfrom typing import Any\n\nfrom attavo.common import MANIFEST, read_manifest\nfrom attavo.records import parse_attempts, stage_schema\nfrom attavo.types import CounselRecord, Stop\n\n# --- stop: every non-pass build or verify record's class and cause (issue\n# #89) -- derived here, at write time, from the refusal, halted, and log\n# the caller already has. Never a fresh read of anything: the tenant zero\n# specimens this retires (#576 build-11, #659 build-01 and verify-01) are\n# exactly a stop the product wrote with nothing beside it to explain\n# itself after the fact. ---\n\nSTOP_CLASSES = (\"non-question\", \"outlived-invocation\", \"no-cause\", \"forge-unconcluded\",\n               \"ceiling\", \"claims-boundary\", \"repeated-act\", \"unclassed\", \"question\",\n               \"environment\", \"gate\", \"died\", \"hung\", \"transient\", \"returned\")\n\n# R3: the four families a pass retries with no person involved -- every\n# other class is counsel's to read first, and a person's when counsel says\n# so (or when counsel is not configured at all).\nRETRYABLE_CLASSES = (\"died\", \"hung\", \"transient\", \"returned\")\n\n\ndef signature_of(text: str | None) -> str | None:\n    \"\"\"R3: a failure's signature, compared between attempts by plain string\n    equality -- text with every run of digits removed, so two stops that\n    differ only in a pid, a timestamp, or a retry-after count still match.\n    None for no text at all (nothing to sign).\"\"\"\n    if not text:\n        return None\n    stripped = re.sub(r\"[0-9]+\", \"\", text).strip()\n    return stripped or None\n\n\nSTOP_PROVENANCES = (\"product\", \"tenant\", \"executor\", \"spec\")\n\n# Beyond the enum spelling itself, the prose issue #88 actually shipped\n# (adapters/claude-code/run and adapters/codex/run, on main since\n# v0.16.0) once put a class's own name, or a real specimen's wording of\n# it, in the transcript for the generic match below to find. Issue #94\n# moves non-question and outlived-invocation onto report_class instead\n# (below): non-question's own halt line (\"halted: class non-question\")\n# would otherwise still satisfy the bare-name match here with no adapter\n# report-line field involved at all, and outlived-invocation's refusal\n# never named its class in text to begin with, so both are disabled here\n# -- the same pattern issue #93 established for ceiling, just below,\n# rather than removed outright.\nCLASS_TEXT_MARKERS: dict[str, tuple[str, ...]] = {\n    \"non-question\": (),\n    \"outlived-invocation\": (),\n    # R3: transient is read from the adapter's own report line\n    # (report_class) below; returned is written directly by the pass or\n    # cmd_verify, never derived from a log's text -- a retried attempt's\n    # feedback file names the prior stop's class in prose, and that text\n    # reaches the next attempt's own transcript, which must not then be\n    # misread as a fresh instance of either class.\n    \"transient\": (),\n    \"returned\": (),\n    # Issue #93: ceiling's own text-based check is CEILING_MARKERS, below,\n    # with provenance \"product\" -- a fact about the tool, not an executor\n    # judgment like non-question/outlived-invocation are. Left at the\n    # default (the class's own name, \"ceiling\"), the generic match above\n    # would instead catch adapters/codex/run's and\n    # adapters/claude-code/run's own pre-emptive refusal -- which must\n    # carry the word \"ceiling\" by the same issue's own brief -- as\n    # provenance \"executor\", before CEILING_MARKERS is ever consulted.\n    \"ceiling\": (),\n    # A genuine question (issue #100's own followups) is read structurally\n    # -- status \"halted\" carrying a non-empty halted.question -- not by\n    # scanning for the literal word \"question\", which the question's own\n    # text very often contains regardless of what it is actually asking.\n    # Left at the default, the generic match above would misclassify any\n    # question that happens to use the word \"question\" as executor\n    # provenance, before the structural check in derive_stop is reached.\n    \"question\": (),\n    # environment/tenant (issue #115) is set directly by cmd_build's own\n    # preflight -- the one caller who knows a [checks].command exited 2\n    # on the approved tree -- never derived from adapter text. Left at\n    # the default, the generic match above would catch the word\n    # \"environment\" anywhere in a log or refusal (e.g. codex's own\n    # OPENAI_API_KEY auth-mismatch refusal, adapters/codex/run's\n    # check_auth) as an environment/executor stop that never happened.\n    \"environment\": (),\n}\n\n# Known tool error text for a declared ceiling -- issue #86's own specimen\n# (codex's \"Input exceeds...\" line on a diff too large to judge) is\n# \"input_too_large\"; a matching line anywhere in the log, not only its\n# last line, since cmd_build and cmd_verify both append \"[adapter exited\n# N]\" after whatever the tool itself printed. \"ceiling exceeded\" is issue\n# #93's own addition: both adapters now refuse pre-emptively, before the\n# tool is ever invoked, against a declared or fixed input limit, and\n# their refusal text is not caught by any of the three markers above.\nCEILING_MARKERS = (\"input_too_large\", \"exceeds the maximum context length\",\n                  \"context_length_exceeded\", \"ceiling exceeded\")\n\n\n# Issue #100's followups: an unclassed detail is the log's last line\n# verbatim, and that line is sometimes an adapter's own event JSON or a\n# tool's full error text -- thousands of characters wide. Capped here,\n# at write time, so a filed issue's own summary of it (file-stops'\n# log_tail already carries the full picture) stays short; the class\n# itself, \"unclassed\", already says the full explanation lives in the\n# log, not in this field.\nUNCLASSED_DETAIL_MAX_CHARS = 200\n\n\ndef _log_last_line(log: str | None) -> str:\n    lines = [l for l in (log or \"\").splitlines() if l.strip()]\n    last = lines[-1] if lines else \"\"\n    return last[:UNCLASSED_DETAIL_MAX_CHARS]\n\n\ndef _carries_a_known_class(text: str | None) -> str | None:\n    \"\"\"Whichever of STOP_CLASSES this text names -- its own spelling, or\n    one of CLASS_TEXT_MARKERS' real-world phrasings of it, when that\n    class is not disabled there -- or None. Issue #88 is where an\n    adapter's own halt or refusal first named its class this way; issue\n    #93 added ceiling's own pre-emptive refusal to that set and disabled\n    its bare-name match (CEILING_MARKERS covers it instead); issue #94\n    disables non-question and outlived-invocation the same way, reading\n    both from the adapter's own report line (derive_stop's report_class)\n    now instead.\"\"\"\n    text = text or \"\"\n    for name in STOP_CLASSES:\n        markers = CLASS_TEXT_MARKERS.get(name, (name,))\n        if any(marker in text for marker in markers):\n            return name\n    return None\n\n\ndef derive_stop(status: str, *, refusal: str | None = None, halted: dict[str, Any] | None = None,\n                log: str | None = None, report_class: str | None = None,\n                refusal_provenance: str | None = None) -> Stop | None:\n    \"\"\"The stop field for a build or verify record: None for status \"pass\",\n    else {class, provenance, detail} from what the caller already knows.\n\n      - report_class -- payload.get(\"class\") off the adapter's own report\n        line (issue #88, #94), when it names a STOP_CLASSES member -- is\n        that class, provenance \"executor\". build.schema.json and\n        verify.schema.json stay untouched by issue #88 on purpose, so the\n        class lives only on the report line, never a structured field\n        cmd_build or cmd_verify forwards on its own account; the caller\n        reads payload itself and passes this in, since only it still has\n        payload once an iteration ends. This is non-question's and\n        outlived-invocation's only path to a record now (issue #94):\n        CLASS_TEXT_MARKERS disables both for the text scan below, the\n        same way issue #93 disabled ceiling's bare-name match there. A\n        class an adapter does not yet put on its report line --\n        outlived-invocation today, since that refusal path prints no\n        report line at all -- falls to unclassed below, same as any\n        other unnamed cause, until the adapter that raises it puts a\n        class on the line the way non-question already does.\n      - a halt carrying a non-empty halted.question, once it is not a\n        non-question caught above, is a genuine question -- question/spec,\n        with the question's own first line as detail (issue #100's\n        followups). This is the specimen issue #100 itself was built to\n        retire: tenant zero's #663 build-01, a proper question, classed\n        unclassed/product and filed as a product defect with the wrong\n        provenance -- a question is about the definition of done, which is\n        a person's or a ruling's to answer, never the product's own\n        mechanism.\n      - failing that, a refusal or the log itself that already names its\n        class in text (issue #88, #93 for ceiling's own pre-emptive\n        refusal) is that class, provenance \"executor\" -- the log is\n        checked because neither adapter's refusal *field* carries the\n        class today; the class-naming line each adapter prints reaches\n        only the transcript\n      - a refusal that is not that -- the write-outside-claims path\n        itself, not the \"commit ... not authored by the executor\" shape\n        -- is claims-boundary/spec, unless the caller already knows this\n        refusal touched paths.records or paths.specs (issue #140:\n        protected_path_touched, checked ahead of the ordinary claims\n        match in cmd_build) and passes refusal_provenance=\"executor\" --\n","exit_code":0,"status":"completed"}}

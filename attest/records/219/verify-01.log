       return None\\\\n    return text or None\\\\n\\\\n\\\\ndef _counsel_of(records_dir: Path, stem: str) -> tuple[str, CounselRecord] | None:\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"The latest counsel record that read the stop named stem.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n    attempts = parse_attempts(records_dir, \\\\\\\"counsel\\\\\\\")\\\\n    for nn in sorted(attempts, reverse=True):\\\\n        if attempts[nn].get(\\\\\\\"record\\\\\\\") == stem:\\\\n            return f\\\\\\\"counsel-{nn:02d}\\\\\\\", attempts[nn]\\\\n    return None\\\\n\\\\n\\\\ndef _stopped(root: Path, m: dict[str, Any], r: DriveReport, records_dir: Path, stage: str,\\\\n            stem: str, record: dict[str, Any]) -> DriveReport:\\\\n    stop = record.get(\\\\\\\"stop\\\\\\\") or {}\\\\n    stop_class = stop.get(\\\\\\\"class\\\\\\\")\\\\n    attempt = int(stem.rsplit(\\\\\\\"-\\\\\\\", 1)[1])\\\\n    r[\\\\\\\"state\\\\\\\"], r[\\\\\\\"kind\\\\\\\"], r[\\\\\\\"stage\\\\\\\"] = \\\\\\\"stopped\\\\\\\", \\\\\\\"yours\\\\\\\", stage\\\\n    r[\\\\\\\"attempt\\\\\\\"], r[\\\\\\\"record\\\\\\\"], r[\\\\\\\"stop_class\\\\\\\"] = attempt, stem, stop_class\\\\n    r[\\\\\\\"filed\\\\\\\"] = _filed(records_dir, stem)\\\\n\\\\n    # R3: every attempt of this stage, side by side -- the exhaustion\\\\n    # report's own comparison, printed whether or not the budget is\\\\n    # actually spent yet, since a person reading --report wants the same\\\\n    # picture drive itself would act on.\\\\n    attempts = parse_attempts(records_dir, stage)\\\\n    rows: list[dict[str, Any]] = [\\\\n        {\\\\\\\"attempt\\\\\\\": nn, \\\\\\\"class\\\\\\\": (rec.get(\\\\\\\"stop\\\\\\n1202 {\\\"type\\\":\\\"user\\\",\\\"message\\\":{\\\"role\\\":\\\"user\\\",\\\"content\\\":[{\\\"tool_use_id\\\":\\\"toolu_01BAZYKMbRKkC9dwmht7wrbC\\\",\\\"type\\\":\\\"tool_result\\\",\\\"content\\\":\\\"\\\\\\\"\\\\\\\"\\\\\\\"attavo drive: the mechanical transitions between approval and\\\\nready-to-merge (issue #84) -- under R2, one pass per invocation: read the\\\\nreport, act at most once (recover, start the build, start the review) in\\\\na detached worker, return. A level that belongs to a person is printed\\\\nand left. Every test uses the fixture\\\\nadapter and a fake `[forge].checks_command`; every record commit is\\\\n`git commit --only` and pushed to a real (bare) fixture remote.\\\\n\\\\nRegression tests, written and run red first: on `main` at 85f6f3b there\\\\nwas no `drive` subcommand, so every one of these failed with \\\\\\\"unknown\\\\nsubcommand\\\\\\\".\\\\n\\\\nRun: python3 -m pytest tests -q\\\\n\\\\\\\"\\\\\\\"\\\\\\\"\\\\nimport importlib\\\\nimport json\\\\nimport os\\\\nimport socket\\\\nimport queue\\\\nimport subprocess\\\\nimport sys\\\\nimport threading\\\\nimport time\\\\nfrom pathlib import Path\\\\nfrom typing import IO, Any, cast\\\\n\\\\nfrom helpers import commit_all, git, make_tenant\\\\n\\\\nROOT = Path(__file__).resolve().parent.parent\\\\nATTAVO = ROOT / \\\\\\\"bin\\\\\\\" / \\\\\\\"attavo\\\\\\\"\\\\n\\\\nGREEN_FORGE = \\\\\\\"printf 'ci success\\\\\\\\\\\\\\\\n'\\\\\\\"\\\\n# A concluded conclusion -- checked and failing, not something still\\\\n# running. Distinct from UNCONCLUDED_FORGE below (issue #84): drive polls\\\\n# the one still running for the bound, but stops on the first read of a\\\\n# check that has already concluded, whether or not it passed.\\\\nRED_FORGE = \\\\\\\"printf 'ci failure\\\\\\\\\\\\\\\\n'\\\\\\\"\\\\nUNCONCLUDED_FORGE = \\\\\\\"printf 'ci in_progress\\\\\\\\\\\\\\\\n'\\\\\\\"\\\\n\\\\n# The real defaults (ATTAVO_DRIVE_POLL_BOUND_S=600, _INTERVAL_S=20) are a\\\\n# real forge's clock, not a test's -- tenant zero's own checks conclude\\\\n# about five minutes after a push. Every `attavo drive` call here runs\\\\n# against this much shorter clock instead, read at call time from the\\\\n# same environment variables; test_drive_forge_poll_defaults_are_a_real_\\\\n# forges_clock is the one test that leaves them unset, to assert the\\\\n# defaults themselves. The interval is kept well above typical subprocess\\\\n# startup overhead so a zero-sleep stop and a polled one are easy to tell\\\\n# apart by wall clock alone.\\\\nFAST_POLL_ENV = {\\\\\\\"ATTAVO_DRIVE_POLL_BOUND_S\\\\\\\": \\\\\\\"0.9\\\\\\\", \\\\\\\"ATTAVO_DRIVE_POLL_INTERVAL_S\\\\\\\": \\\\\\\"0.5\\\\\\\",\\\\n                 \\\\\\\"ATTAVO_HEARTBEAT_S\\\\\\\": \\\\\\\"0.2\\\\\\\"}\\\\n\\\\n\\\\ndef run_attavo(root: Path, *args: str, env: dict[str, Any] | None = None) -> subprocess.CompletedProcess[str]:\\\\n    full_env = dict(os.environ)\\\\n    full_env.update(FAST_POLL_ENV)\\\\n    if env:\\\\n        full_env.update(env)\\\\n    return subprocess.run([sys.executable, str(ATTAVO), *args], cwd=str(root),\\\\n                          capture_output=True, text=True, check=False, env=full_env)\\\\n\\\\n\\\\ndef drive(root: Path, *args: str, env: dict[str, Any] | None = None) -> subprocess.CompletedProcess[str]:\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"One pass, then wait for the worker it may have started (R2): the pass\\\\n    returns as soon as the marker is pushed and the stage runs detached, so\\\\n    a test that reads the record after \\\\\\\"drive\\\\\\\" waits for the report to stop\\\\n    saying running. The pass's own output is returned, with the worker's\\\\n    log appended, so assertions on the stage's lines still read them.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n    run = run_attavo(root, \\\\\\\"drive\\\\\\\", *args, env=env)\\\\n    import re\\\\n    pids = [int(x) for x in re.findall(r\\\\\\\"worker pid (\\\\\\\\d+)\\\\\\\", run.stdout)]\\\\n    deadline = time.monotonic() + 90\\\\n    while pids and time.monotonic() < deadline:\\\\n        try:\\\\n            os.kill(pids[-1], 0)\\\\n        except ProcessLookupError:\\\\n            break\\\\n        time.sleep(0.2)\\\\n    logs = sorted(Path(git(root, \\\\\\\"rev-parse\\\\\\\", \\\\\\\"--absolute-git-dir\\\\\\\").strip(), \\\\\\\"attavo\\\\\\\").glob(\\\\\\\"*.worker.log\\\\\\\"))\\\\n    tail = \\\\\\\"\\\\\\\".join(p.read_text() for p in logs)\\\\n    return subprocess.CompletedProcess(run.args, run.returncode, run.stdout + tail, run.stderr)\\\\n\\\\n\\\\ndef attavo_module() -> Any:\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"attavo.verify imported in-process, for the default-constant assertion\\\\n    below that a CLI invocation cannot pro\\n1227 {\\\"type\\\":\\\"user\\\",\\\"message\\\":{\\\"role\\\":\\\"user\\\",\\\"content\\\":[{\\\"tool_use_id\\\":\\\"toolu_01GeX3vEuxp1KHdGkRk5DfD3\\\",\\\"type\\\":\\\"tool_result\\\",\\\"content\\\":\\\"460\\\\t    assert record_files(root, \\\\\\\"verify\\\\\\\") == []\\\\n461\\\\t    assert remote_head(bare, branch) == head_of(root)\\\\n462\\\\t\\\\n463\\\\t\\\\n464\\\\t\\\\n465\\\\tdef test_drive_until_ready_stops_when_the_forge_goes_red_after_a_build(tmp_path: Path) -> None:\\\\n466\\\\t    \\\\\\\"\\\\\\\"\\\\\\\"A build that passes, then a forge that concludes red on its head,\\\\n467\\\\t    stops the loop there with exit 1 -- the loop gave up short of ready\\\\n468\\\\t    -- one record written (the pass), no review record, no retry of the\\\\n469\\\\t    forge read.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n470\\\\t    root = make_tenant(tmp_path, \\\\\\\"build_valid\\\\\\\")\\\\n471\\\\t    add_forge(root, RED_FORGE)\\\\n472\\\\t    add_bare_remote(root, tmp_path)\\\\n473\\\\t    approve_item(root)\\\\n474\\\\t\\\\n475\\\\t    run = run_attavo(root, \\\\\\\"drive\\\\\\\", \\\\\\\"1\\\\\\\", \\\\\\\"--until-ready\\\\\\\")\\\\n476\\\\t    assert run.returncode == 1, run.stdout + run.stderr\\\\n477\\\\t    assert \\\\\\\"ci\\\\\\\" in run.stdout and \\\\\\\"failure\\\\\\\" in run.stdout\\\\n478\\\\t\\\\n479\\\\t    assert len(record_files(root, \\\\\\\"build\\\\\\\")) == 1\\\\n480\\\\t    assert latest_record(root, \\\\\\\"build\\\\\\\")[\\\\\\\"status\\\\\\\"] == \\\\\\\"pass\\\\\\\"\\\\n481\\\\t    assert record_files(root, \\\\\\\"verify\\\\\\\") == []\\\\n482\\\\t\\\\n483\\\\t\\\\n484\\\\t\\\\n485\\\\tdef test_drive_line_buffers_stdout_so_a_pipe_reader_sees_the_start_line_before_the_stage_ends(tmp_path: Path) -> None:\\\\n486\\\\t    \\\\\\\"\\\\\\\"\\\\\\\"Issue #145, kept under R2. A pipe reader of `attavo drive` saw\\\\n487\\\\t    every line arrive as one burst when the process ended -- Python\\\\n488\\\\t    block-buffers stdout when it is not a tty. With --until-ready the\\\\n489\\\\t    process now outlives a slow stage; a pipe reader with a timeout well\\\\n490\\\\t    under the stage's own sleep must already see the \\\\\\\"started\\\\\\\" line the\\\\n491\\\\t    pass printed before that sleep ends -- unreachable if stdout is\\\\n492\\\\t    still block-buffered. The worker reconfigures its own stdout the same\\\\n493\\\\t    way, so its log is readable while it runs.\\\\n494\\\\t    \\\\\\\"\\\\\\\"\\\\\\\"\\\\n495\\\\t    root = make_tenant(tmp_path, \\\\\\\"build_valid\\\\\\\")\\\\n496\\\\t    add_forge(root, GREEN_FORGE)\\\\n497\\\\t    add_bare_remote(root, tmp_path)\\\\n498\\\\t    approve_item(root)\\\\n499\\\\t\\\\n500\\\\t    sleep_s = 3.0\\\\n501\\\\t    adapter_dir = root / \\\\\\\"attavo\\\\\\\" / \\\\\\\"adapters\\\\\\\" / \\\\\\\"slow\\\\\\\"\\\\n502\\\\t    adapter_dir.mkdir(parents=True)\\\\n503\\\\t    adapter_run = adapter_dir / \\\\\\\"run\\\\\\\"\\\\n504\\\\t    adapter_run.write_text(\\\\n505\\\\t        \\\\\\\"#!/bin/sh\\\\\\\\n\\\\\\\"\\\\n506\\\\t        \\\\\\\"set -eu\\\\\\\\n\\\\\\\"\\\\n507\\\\t        'if [ \\\\\\\"${ATTAVO_STAGE:-build}\\\\\\\" = \\\\\\\"verify\\\\\\\" ]; then\\\\\\\\n'\\\\n508\\\\t        '  printf \\\\\\\\'{\\\\\\\"model\\\\\\\":\\\\\\\"slow\\\\\\\",\\\\\\\"model_version\\\\\\\":null,\\\\\\\"adapter_version\\\\\\\":\\\\\\\"slow-1\\\\\\\",'\\\\n509\\\\t        '\\\\\\\"tokens\\\\\\\":{\\\\\\\"input\\\\\\\":1,\\\\\\\"output\\\\\\\":1},\\\\\\\"cost_usd\\\\\\\":0.0,\\\\\\\"findings\\\\\\\":[],\\\\\\\"tests_named\\\\\\\":[]}\\\\\\\\\\\\\\\\n\\\\\\\\'\\\\\\\\n'\\\\n510\\\\t        \\\\\\\"  exit 0\\\\\\\\n\\\\\\\"\\\\n511\\\\t        \\\\\\\"fi\\\\\\\\n\\\\\\\"\\\\n512\\\\t        f\\\\\\\"sleep {sleep_s}\\\\\\\\n\\\\\\\"\\\\n513\\\\t        \\\\\\\"echo built > built.txt\\\\\\\\n\\\\\\\"\\\\n514\\\\t        \\\\\\\"git add built.txt\\\\\\\\n\\\\\\\"\\\\n515\\\\t        \\\\\\\"git commit -q -m 'slow: write built.txt'\\\\\\\\n\\\\\\\"\\\\n516\\\\t        'echo \\\\\\\\'{\\\\\\\"status\\\\\\\":\\\\\\\"done\\\\\\\",\\\\\\\"question\\\\\\\":null,\\\\\\\"model\\\\\\\":\\\\\\\"slow\\\\\\\",\\\\\\\"model_version\\\\\\\":null,'\\\\n517\\\\t        '\\\\\\\"adapter_version\\\\\\\":\\\\\\\"slow-1\\\\\\\",\\\\\\\"tokens\\\\\\\":{\\\\\\\"input\\\\\\\":1,\\\\\\\"output\\\\\\\":1},\\\\\\\"cost_usd\\\\\\\":0.0}\\\\\\\\'\\\\\\\\n'\\\\n518\\\\t    )\\\\n519\\\\t    adapter_run.chmod(0o755)\\\\n520\\\\t    toml = root / \\\\\\\"attavo.toml\\\\\\\"\\\\n521\\\\t    toml.write_text(toml.read_text().replace('build = \\\\\\\"fixture\\\\\\\"', 'build = \\\\\\\"slow\\\\\\\"'))\\\\n522\\\\t    commit_all(root, \\\\\\\"use a slow adapter for build\\\\\\\")\\\\n523\\\\t\\\\n524\\\\t    full_env = dict(os.environ)\\\\n525\\\\t    full_env.update(FAST_POLL_ENV)\\\\n526\\\\t    proc = subprocess.Popen(\\\\n527\\\\t        [sys.executable, str(ATTAVO), \\\\\\\"drive\\\\\\\", \\\\\\\"1\\\\\\\", \\\\\\\"--until-ready\\\\\\\"],\\\\n528\\\\t        cwd=str(root), stdout=subprocess.PIPE, stderr=subprocess.STDOUT,\\\\n529\\\\t        text=True, env=full_env)\\\\n530\\\\t\\\\n531\\\\t    lines: \\\\\\\"queue.Queue[str | None]\\\\\\\" = queue.Queue()\\\\n532\\\\t\\\\n533\\\\t    def reader() -> None:\\\\n534\\\\t        for raw in cast(IO[str], proc.stdout):\\\\n535\\\\t            lines.put(raw)\\\\n536\\\\t        lines.put(None)\\\\n537\\\\t\\\\n538\\\\t    thread = threading.Thread(target=reader, daemon=True\\n1230 {\\\"type\\\":\\\"user\\\",\\\"message\\\":{\\\"role\\\":\\\"user\\\",\\\"content\\\":[{\\\"tool_use_id\\\":\\\"toolu_01Ett1NuyJ7h3JdwT5iZp31z\\\",\\\"type\\\":\\\"tool_result\\\",\\\"content\\\":\\\"The file /Users/davidbean/Projects/attavo-worktree-219/tests/test_drive.py has been updated successfully.\\\"}]},\\\"parent_tool_use_id\\\":null,\\\"session_id\\\":\\\"ae622d81-efb9-4dda-92a0-5ebf75b0d73f\\\",\\\"uuid\\\":\\\"fa366d1c-f605-4341-95e0-804029d9dcaa\\\",\\\"timestamp\\\":\\\"2026-09-26T03:43:22.022Z\\\",\\\"tool_use_result\\\":{\\\"filePath\\\":\\\"/Users/davidbean/Projects/attavo-worktree-219/tests/test_drive.py\\\",\\\"oldString\\\":\\\"def test_drive_until_ready_stops_when_the_forge_goes_red_after_a_build(tmp_path: Path) -> None:\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"A build that passes, then a forge that concludes red on its head,\\\\n    stops the loop there with exit 1 -- the loop gave up short of ready\\\\n    -- one record written (the pass), no review record, no retry of the\\\\n    forge read.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n    root = make_tenant(tmp_path, \\\\\\\"build_valid\\\\\\\")\\\\n    add_forge(root, RED_FORGE)\\\\n    add_bare_remote(root, tmp_path)\\\\n    approve_item(root)\\\\n\\\\n    run = run_attavo(root, \\\\\\\"drive\\\\\\\", \\\\\\\"1\\\\\\\", \\\\\\\"--until-ready\\\\\\\")\\\\n    assert run.returncode == 1, run.stdout + run.stderr\\\\n    assert \\\\\\\"ci\\\\\\\" in run.stdout and \\\\\\\"failure\\\\\\\" in run.stdout\\\\n\\\\n    assert len(record_files(root, \\\\\\\"build\\\\\\\")) == 1\\\\n    assert latest_record(root, \\\\\\\"build\\\\\\\")[\\\\\\\"status\\\\\\\"] == \\\\\\\"pass\\\\\\\"\\\\n    assert record_files(root, \\\\\\\"verify\\\\\\\") == []\\\",\\\"newString\\\":\\\"def test_drive_until_ready_stops_after_two_matching_returned_reviews(tmp_path: Path) -> None:\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"R3 (ruling C amended): a build that passes, then a forge that\\\\n    concludes red on its head every time, is no longer a dead end the\\\\n    loop gives up on -- the pass converts it into a returned record and\\\\n    retries the build on its own, inside the budget. Two returned\\\\n    reviews with the identical signature then stop the stage: the loop\\\\n    reads that as done (a person's to look at, not a forge it never\\\\n    finished reading), and exits 0.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n    root = make_tenant(tmp_path, \\\\\\\"build_valid\\\\\\\")\\\\n    add_forge(root, RED_FORGE)\\\\n    add_bare_remote(root, tmp_path)\\\\n    approve_item(root)\\\\n\\\\n    run = run_attavo(root, \\\\\\\"drive\\\\\\\", \\\\\\\"1\\\\\\\", \\\\\\\"--until-ready\\\\\\\")\\\\n    assert run.returncode == 0, run.stdout + run.stderr\\\\n\\\\n    assert len(record_files(root, \\\\\\\"build\\\\\\\")) == 2\\\\n    assert [r[\\\\\\\"status\\\\\\\"] for r in (latest_record(root, \\\\\\\"build\\\\\\\"),)] == [\\\\\\\"pass\\\\\\\"]\\\\n    assert len(record_files(root, \\\\\\\"verify\\\\\\\")) == 2\\\\n    for rec in (json.loads(p.read_text()) for p in record_files(root, \\\\\\\"verify\\\\\\\")):\\\\n        assert rec[\\\\\\\"status\\\\\\\"] == \\\\\\\"returned\\\\\\\" and rec[\\\\\\\"stop\\\\\\\"][\\\\\\\"class\\\\\\\"] == \\\\\\\"returned\\\\\\\"\\\\n    out = json.loads(run_attavo(root, \\\\\\\"drive\\\\\\\", \\\\\\\"1\\\\\\\", \\\\\\\"--report\\\\\\\").stdout)\\\\n    assert out[\\\\\\\"state\\\\\\\"] == \\\\\\\"stopped\\\\\\\" and out[\\\\\\\"signatures_match\\\\\\\"] is True, out\\\",\\\"originalFile\\\":\\\"\\\\\\\"\\\\\\\"\\\\\\\"attavo drive: the mechanical transitions between approval and\\\\nready-to-merge (issue #84) -- under R2, one pass per invocation: read the\\\\nreport, act at most once (recover, start the build, start the review) in\\\\na detached worker, return. A level that belongs to a person is printed\\\\nand left. Every test uses the fixture\\\\nadapter and a fake `[forge].checks_command`; every record commit is\\\\n`git commit --only` and pushed to a real (bare) fixture remote.\\\\n\\\\nRegression tests, written and run red first: on `main` at 85f6f3b there\\\\nwas no `drive` subcommand, so every one of these failed with \\\\\\\"unknown\\\\nsubcommand\\\\\\\".\\\\n\\\\nRun: python3 -m pytest tests -q\\\\n\\\\\\\"\\\\\\\"\\\\\\\"\\\\nimport importlib\\\\nimport json\\\\nimport os\\\\nimport socket\\\\nimport queue\\\\nimport subprocess\\\\nimport sys\\\\nimport threading\\\\nimport time\\\\nfrom pathlib import Path\\\\nfrom typing import IO, Any, cast\\\\n\\\\nfrom helpers import commit_all, git, make_tenant\\\\n\\\\nROOT = Path(__file__).resolve().parent.parent\\\\nATTAVO = ROOT / \\\\\\\"bin\\\\\\\" / \\\\\\\"attavo\\\\\\\"\\\\n\\\\nGREEN_FORGE = \\\\\\\"printf 'ci success\\\\\\\\\\\\\\\\n'\\\\\\\"\\\\n# A concluded conclusion -- checked and failing, not something still\\\\n# running. Distinct from UNCONCLUDED_FORGE below (issue #84): drive polls\\\\n# the one still running for the bound, but stops on the \\n1232 {\\\"type\\\":\\\"user\\\",\\\"message\\\":{\\\"role\\\":\\\"user\\\",\\\"content\\\":[{\\\"tool_use_id\\\":\\\"toolu_01TufuiKqF5G3Mhh31rEe2Gp\\\",\\\"type\\\":\\\"tool_result\\\",\\\"content\\\":\\\"The file /Users/davidbean/Projects/attavo-worktree-219/tests/test_drive.py has been updated successfully.\\\"}]},\\\"parent_tool_use_id\\\":null,\\\"session_id\\\":\\\"ae622d81-efb9-4dda-92a0-5ebf75b0d73f\\\",\\\"uuid\\\":\\\"b70e87a0-f3cf-4423-a8b9-eba99d2e834d\\\",\\\"timestamp\\\":\\\"2026-09-26T03:43:33.298Z\\\",\\\"tool_use_result\\\":{\\\"filePath\\\":\\\"/Users/davidbean/Projects/attavo-worktree-219/tests/test_drive.py\\\",\\\"oldString\\\":\\\"def test_drive_pass_reads_a_red_forge_as_blocked_and_starts_nothing(tmp_path: Path) -> None:\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"Acceptance row 4, as a level. A forge read where the one check has\\\\n    already concluded and failed is not polled at all -- the pass reads\\\\n    the forge once, says Blocked naming the check, exits 0, and starts\\\\n    no review: no marker, no verify record, no new commit, no sleep.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n    root = make_tenant(tmp_path, \\\\\\\"build_valid\\\\\\\")\\\\n    add_forge(root, RED_FORGE)\\\\n    add_bare_remote(root, tmp_path)\\\\n    approve_item(root)\\\\n\\\\n    assert drive(root, \\\\\\\"1\\\\\\\").returncode == 0  # builds\\\\n    pre_head = head_of(root)\\\\n\\\\n    started = time.monotonic()\\\\n    run = drive(root, \\\\\\\"1\\\\\\\")\\\\n    elapsed = time.monotonic() - started\\\\n    assert run.returncode == 0, run.stdout + run.stderr\\\\n    assert \\\\\\\"Blocked\\\\\\\" in run.stdout and \\\\\\\"ci failure\\\\\\\" in run.stdout\\\\n    assert \\\\\\\"worker pid\\\\\\\" not in run.stdout\\\\n    assert elapsed < 0.4, (\\\\n        f\\\\\\\"a concluded, red forge check is read once with no poll interval slept \\\\\\\"\\\\n        f\\\\\\\"-- took {elapsed:.2f}s\\\\\\\")\\\\n\\\\n    assert record_files(root, \\\\\\\"verify\\\\\\\") == []\\\\n    assert not (records_dir(root) / \\\\\\\"verify-01.started\\\\\\\").exists()\\\\n    assert head_of(root) == pre_head\\\\n\\\\n    # Idempotence (row 8): a pass in the same red state says the same,\\\\n    # still nothing written.\\\\n    run2 = drive(root, \\\\\\\"1\\\\\\\")\\\\n    assert run2.returncode == 0\\\\n    assert \\\\\\\"Blocked\\\\\\\" in run2.stdout\\\\n    assert record_files(root, \\\\\\\"verify\\\\\\\") == []\\\\n    assert head_of(root) == pre_head\\\",\\\"newString\\\":\\\"def test_drive_pass_turns_a_red_forge_on_a_passed_build_into_a_returned_record(tmp_path: Path) -> None:\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"R3 (ruling C amended, #206's own build-01): a forge read where the\\\\n    one required check has already concluded and failed is a record now,\\\\n    not a level with nothing behind it -- the pass starts the review,\\\\n    which writes verify-01 status returned, class returned, naming the\\\\n    check in its signature. Inside the budget, the very next pass\\\\n    retries the build on its own -- no operator act, no counsel run.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n    root = make_tenant(tmp_path, \\\\\\\"build_valid\\\\\\\")\\\\n    add_forge(root, RED_FORGE)\\\\n    add_bare_remote(root, tmp_path)\\\\n    approve_item(root)\\\\n\\\\n    assert drive(root, \\\\\\\"1\\\\\\\").returncode == 0  # builds\\\\n    pre_head = head_of(root)\\\\n\\\\n    run = drive(root, \\\\\\\"1\\\\\\\")\\\\n    assert run.returncode == 0, run.stdout + run.stderr\\\\n    assert head_of(root) != pre_head\\\\n\\\\n    assert len(record_files(root, \\\\\\\"verify\\\\\\\")) == 1\\\\n    review = latest_record(root, \\\\\\\"verify\\\\\\\")\\\\n    assert review[\\\\\\\"status\\\\\\\"] == \\\\\\\"returned\\\\\\\", review\\\\n    assert review[\\\\\\\"stop\\\\\\\"][\\\\\\\"class\\\\\\\"] == \\\\\\\"returned\\\\\\\" and \\\\\\\"ci\\\\\\\" in review[\\\\\\\"stop\\\\\\\"][\\\\\\\"signature\\\\\\\"], review[\\\\\\\"stop\\\\\\\"]\\\\n\\\\n    run2 = drive(root, \\\\\\\"1\\\\\\\")\\\\n    assert run2.returncode == 0, run2.stdout + run2.stderr\\\\n    assert len(record_files(root, \\\\\\\"build\\\\\\\")) == 2\\\\n    assert latest_record(root, \\\\\\\"build\\\\\\\")[\\\\\\\"retry_of\\\\\\\"] == \\\\\\\"build-01\\\\\\\"\\\\n    assert record_files(root, \\\\\\\"counsel\\\\\\\") == []\\\",\\\"originalFile\\\":\\\"\\\\\\\"\\\\\\\"\\\\\\\"attavo drive: the mechanical transitions between approval and\\\\nready-to-merge (issue #84) -- under R2, one pass per invocation: read the\\\\nreport, act at most once (recover, start the build, start the review) in\\\\na detached worker, return. A level that belongs to a person is printed\\\\nand left. Every test uses the fixture\\\\nadapter and a fake `[forge].checks_command`; every record commit is\\\\n`git commit --only` and pushed to a real (bare) fixture remote.\\\\n\\\\nRegression tests, written and run r\\n1273 {\\\"type\\\":\\\"user\\\",\\\"message\\\":{\\\"role\\\":\\\"user\\\",\\\"content\\\":[{\\\"tool_use_id\\\":\\\"toolu_01Ert8UfKaYJRMXo8KGkGWRY\\\",\\\"type\\\":\\\"tool_result\\\",\\\"content\\\":\\\"===/tmp/claude-501/tmpxjl3rxmf/build_valid/.git/attavo/verify-01.worker.log===\\\\nTraceback (most recent call last):\\\\n  File \\\\\\\"/Users/davidbean/Projects/attavo-worktree-219/bin/attavo\\\\\\\",
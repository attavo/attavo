n10\\\\tEvery test drives a fixture tenant through `attavo drive N` passes alone\\\\n11\\\\tand reads records, never internals. Written red first against d20fdea\\\\n12\\\\t(R2 as merged) and against R3's thin stub.\\\\n13\\\\t\\\\n14\\\\tRun: python3 -m pytest tests -q\\\\n15\\\\t\\\\\\\"\\\\\\\"\\\\\\\"\\\\n16\\\\tfrom __future__ import annotations\\\\n17\\\\t\\\\n18\\\\timport json\\\\n19\\\\timport os\\\\n20\\\\timport subprocess\\\\n21\\\\timport time\\\\n22\\\\tfrom pathlib import Path\\\\n23\\\\tfrom typing import Any\\\\n24\\\\t\\\\n25\\\\tfrom helpers import commit_all, git, make_tenant\\\\n26\\\\tfrom test_drive import (\\\\n27\\\\t    GREEN_FORGE,\\\\n28\\\\t    add_bare_remote,\\\\n29\\\\t    add_forge,\\\\n30\\\\t    approve_item,\\\\n31\\\\t    latest_record,\\\\n32\\\\t    record_files,\\\\n33\\\\t    records_dir,\\\\n34\\\\t    run_attavo,\\\\n35\\\\t)\\\\n36\\\\tfrom test_pass import FAST, pushed, report, wait_for\\\\n37\\\\t\\\\n38\\\\tROOT = Path(__file__).resolve().parent.parent\\\\n39\\\\tFIXTURE_RUN = ROOT / \\\\\\\"adapters\\\\\\\" / \\\\\\\"fixture\\\\\\\" / \\\\\\\"run\\\\\\\"\\\\n40\\\\t\\\\n41\\\\tDONE_LINE = ('{\\\\\\\"status\\\\\\\":\\\\\\\"done\\\\\\\",\\\\\\\"question\\\\\\\":null,\\\\\\\"model\\\\\\\":\\\\\\\"fixture\\\\\\\",\\\\\\\"model_version\\\\\\\":null,'\\\\n42\\\\t             '\\\\\\\"adapter_version\\\\\\\":\\\\\\\"fixture-1\\\\\\\",\\\\\\\"tokens\\\\\\\":{\\\\\\\"input\\\\\\\":1,\\\\\\\"output\\\\\\\":1},\\\\\\\"cost_usd\\\\\\\":0.0}')\\\\n43\\\\tTRANSIENT_LINE = ('{\\\\\\\"status\\\\\\\":\\\\\\\"failed\\\\\\\",\\\\\\\"question\\\\\\\":null,\\\\\\\"class\\\\\\\":\\\\\\\"transient\\\\\\\",'\\\\n44\\\\t                  '\\\\\\\"detail\\\\\\\":\\\\\\\"API error: overloaded, retry after 30s\\\\\\\",\\\\\\\"model\\\\\\\":\\\\\\\"fixture\\\\\\\",'\\\\n45\\\\t                  '\\\\\\\"model_version\\\\\\\":null,\\\\\\\"adapter_version\\\\\\\":\\\\\\\"fixture-1\\\\\\\",'\\\\n46\\\\t                  '\\\\\\\"tokens\\\\\\\":{\\\\\\\"input\\\\\\\":1,\\\\\\\"output\\\\\\\":1},\\\\\\\"cost_usd\\\\\\\":0.0}')\\\\n47\\\\t\\\\n48\\\\t\\\\n49\\\\tdef add_drive_table(root: Path, *, attempts: int = 3, retry_after_s: int = 0,\\\\n50\\\\t                    build_ceiling_s: int = 600, verify_ceiling_s: int = 600,\\\\n51\\\\t                    stall_after_s: int = 60) -> None:\\\\n52\\\\t    toml = root / \\\\\\\"attavo.toml\\\\\\\"\\\\n53\\\\t    toml.write_text(toml.read_text() + (\\\\n54\\\\t        f\\\\\\\"\\\\\\\\n[drive]\\\\\\\\nstall_after_s = {stall_after_s}\\\\\\\\nattempts = {attempts}\\\\\\\\n\\\\\\\"\\\\n55\\\\t        f\\\\\\\"retry_after_s = {retry_after_s}\\\\\\\\n\\\\\\\\n[drive.build]\\\\\\\\nceiling_s = {build_ceiling_s}\\\\\\\\n\\\\\\\\n\\\\\\\"\\\\n56\\\\t        f\\\\\\\"[drive.verify]\\\\\\\\nceiling_s = {verify_ceiling_s}\\\\\\\\n\\\\\\\"))\\\\n57\\\\t    commit_all(root, \\\\\\\"declare the drive table\\\\\\\")\\\\n58\\\\t\\\\n59\\\\t\\\\n60\\\\tdef tenant_adapter(root: Path, build_prelude: str, streams_events: bool | None = None) -> None:\\\\n61\\\\t    \\\\\\\"\\\\\\\"\\\\\\\"A tenant-side build adapter: `build_prelude` runs first on the build\\\\n62\\\\t    stage (it may exit), then the product's own fixture adapter. A build\\\\n63\\\\t    that is retried on a tree already carrying built.txt rewrites it, so\\\\n64\\\\t    the fixture's own commit has something to commit.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n65\\\\t    d = root / \\\\\\\"attavo\\\\\\\" / \\\\\\\"adapters\\\\\\\" / \\\\\\\"fixture\\\\\\\"\\\\n66\\\\t    d.mkdir(parents=True, exist_ok=True)\\\\n67\\\\t    (d / \\\\\\\"run\\\\\\\").write_text(\\\\n68\\\\t        \\\\\\\"#!/bin/sh\\\\\\\\n\\\\\\\"\\\\n69\\\\t        'if [ \\\\\\\"${ATTAVO_STAGE:-build}\\\\\\\" = build ]; then\\\\\\\\n'\\\\n70\\\\t        f\\\\\\\"{build_prelude}\\\\\\\\n\\\\\\\"\\\\n71\\\\t        \\\\\\\"  if [ -f built.txt ]; then\\\\\\\\n\\\\\\\"\\\\n72\\\\t        '    echo \\\\\\\"built again $(date +%s%N)\\\\\\\" > built.txt\\\\\\\\n'\\\\n73\\\\t        \\\\\\\"    git add built.txt\\\\\\\\n\\\\\\\"\\\\n74\\\\t        \\\\\\\"    git commit -q -m 'fixture: write built.txt again'\\\\\\\\n\\\\\\\"\\\\n75\\\\t        f\\\\\\\"    echo '{DONE_LINE}'\\\\\\\\n\\\\\\\"\\\\n76\\\\t        \\\\\\\"    exit 0\\\\\\\\n\\\\\\\"\\\\n77\\\\t        \\\\\\\"  fi\\\\\\\\n\\\\\\\"\\\\n78\\\\t        \\\\\\\"fi\\\\\\\\n\\\\\\\"\\\\n79\\\\t        f\\\\\\\"exec sh {FIXTURE_RUN}\\\\\\\\n\\\\\\\")\\\\n80\\\\t    (d / \\\\\\\"run\\\\\\\").chmod(0o755)\\\\n81\\\\t    if streams_events is not None:\\\\n82\\\\t        (d / \\\\\\\"conformance.json\\\\\\\").write_text(json.dumps({\\\\\\\"streams_events\\\\\\\": streams_events}) + \\\\\\\"\\\\\\\\n\\\\\\\")\\\\n83\\\\t    commit_all(root, \\\\\\\"a tenant-side adapter\\\\\\\")\\\\n84\\\\t\\\\n85\\\\t\\\\n86\\\\tdef approved_tenant(tmp_path: Path, build_prelude: str = \\\\\\\"\\\\\\\", **drive: Any) -> tuple[Path, Path]:\\\\n87\\\\t    root = make_tenant(tmp_path, \\\\\\\"build_valid\\\\\\\")\\\\n88\\\\t    add_forge(root, GREEN_FORGE)\\\\n89\\\\t    add_drive_table(root, **drive)\\\\n90\\\\t    tenant_adapter(root, build_prelude)\\\\n91\\\\t    bare = add_bare_remote(root, tmp_path)\\\\n92\\\\t    approve_item(root)\\\\n93\\\\t    commit_all(root, \\\\\\\"approved\\\\\\\")\\\\n94\\\\t    git(root, \\\\\\\"push\\\\\\\", \\\\\\\"-q\\\\\\\", \\\\\\\"origin\\\\\\\", \\\\\\\"HEAD:main\\\\\\\")\\\\n95\\\\t    return root, bare\\\\n96\\\\t\\\\n97\\\\t\\\\n98\\\\tdef passes_until(root: Path, pred: Any, seconds: float = 40, env: dict[str, str] | None = None) -> None:\\\\n99\\\\t    \\\\\\\"\\\\\\\"\\\\\\\"Passes, spaced, until pred holds: how an operator's loop, the\\\\n100\\\\t    screen's poll, or a scheduler line would drive the item.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n101\\\\t    deadline = time.monotonic() + seconds\\\\n102\\\\t    full = dict(FAST)\\\\n103\\\\t    full.update(env or {})\\\\n104\\\\t    while time.monotonic() < deadline:\\\\n105\\\\t        run_attavo(root, \\\\\\\"drive\\\\\\\", \\\\\\\"1\\\\\\\", env=full)\\\\n106\\\\t        if pred():\\\\n107\\\\t            return\\\\n108\\\\t        time.sleep(0.5)\\\\n109\\\\t    raise AssertionError(\\\\\\\"condition not met in time\\\\\\\")\\\\n110\\\\t\\\\n111\\\\t\\\\n112\\\\tdef stop_of(root: Path, stage: str, nn: int) -> dict[str, Any]:\\\\n113\\\\t    rec = json.loads((records_dir(root) / f\\\\\\\"{stage}-{nn:02d}.json\\\\\\\").read_text())\\\\n114\\\\t    return dict(rec.get(\\\\\\\"stop\\\\\\\") or {})\\\\n115\\\\t\\\\n116\\\\t\\\\n117\\\\tdef counsel_records(root: Path) -> list[Path]:\\\\n118\\\\t    return record_files(root, \\\\\\\"counsel\\\\\\\")\\\\n119\\\\t\\\\n120\\\\t\\\\n121\\\\tdef test_a_transient_stop_retries_plainly_after_the_wait(tmp_path: Path) -> None:\\\\n122\\\\t    \\\\\\\"\\\\\\\"\\\\\\\"Ruling C: a vendor's capacity, rate, or 5xx refusal is `transient`;\\\\n123\\\\t    the next pass starts the next attempt, asks counsel nothing, and\\\\n124\\\\t    waits [drive].retry_after_s first (#194's verify-01 paid for a\\\\n125\\\\t    counsel run and two presses on exactly this).\\\\\\\"\\\\\\\"\\\\\\\"\\\\n126\\\\t    prelude = ('  if [ ! -f \\\\\\\"$ATTAVO_RECORDS_DIR/build-01.json\\\\\\\" ]; then\\\\\\\\n'\\\\n127\\\\t               f\\\\\\\"    echo '{TRANSIENT_LINE}'\\\\\\\\n    exit 1\\\\\\\\n  fi\\\\\\\")\\\\n128\\\\t    root, bare = approved_tenant(tmp_path, prelude, retry_after_s=3)\\\\n129\\\\t    assert run_attavo(root, \\\\\\\"drive\\\\\\\", \\\\\\\"1\\\\\\\", env=FAST).returncode == 0\\\\n130\\\\t    wait_for(lambda: pushed(bare, \\\\\\\"build record for item 1 (build-01)\\\\\\\"))\\\\n131\\\\t    assert stop_of(root, \\\\\\\"build\\\\\\\", 1)[\\\\\\\"class\\\\\\\"] == \\\\\\\"transient\\\\\\\"\\\\n132\\\\t    assert stop_of(root, \\\\\\\"build\\\\\\\", 1)[\\\\\\\"signature\\\\\\\"] == \\\\\\\"API error: overloaded, retry after s\\\\\\\"\\\\n133\\\\t\\\\n134\\\\t    # inside the wait: a pass reads the level and starts nothing\\\\n135\\\\t    early = run_attavo(root, \\\\\\\"drive\\\\\\\", \\\\\\\"1\\\\\\\", env=FAST)\\\\n136\\\\t    assert early.returncode == 0 and \\\\\\\"retrying\\\\\\\" in early.stdout.lower(), early.stdout\\\\n137\\\\t    assert not (records_dir(root) / \\\\\\\"build-02.started\\\\\\\").exists()\\\\n138\\\\t\\\\n139\\\\t    passes_until(root, lambda: len(record_files(root, \\\\\\\"build\\\\\\\")) == 2, seconds=40)\\\\n140\\\\t    rec = latest_record(root, \\\\\\\"build\\\\\\\")\\\\n141\\\\t    assert rec[\\\\\\\"status\\\\\\\"] == \\\\\\\"pass\\\\\\\" and rec[\\\\\\\"retry_of\\\\\\\"] == \\\\\\\"build-01\\\\\\\", rec\\\\n142\\\\t    assert counsel_records(root) == []\\\\n143\\\\t\\\\n144\\\\t\\\\n145\\\\tdef test_died_and_hung_retry_on_the_next_pass(tmp_path: Path) -> None:\\\\n146\\\\t    \\\\\\\"\\\\\\\"\\\\\\\"A recovered died attempt is retried by the pass after the one that\\\\n147\\\\t    recovered it, with no wait and no counsel; the retried record names\\\\n148\\\\t    what it retries.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n149\\\\t    prelude = ('  if [ ! -f \\\\\\\"$ATTAVO_RECORDS_DIR/build-01.json\\\\\\\" ]; then\\\\\\\\n'\\\\n150\\\\t               \\\\\\\"    kill -9 $PPID\\\\\\\\n    sleep 3\\\\\\\\n  fi\\\\\\\")\\\\n151\\\\t    root, bare = approved_tenant(tmp_path, prelude)\\\\n152\\\\t    assert run_attavo(root, \\\\\\\"drive\\\\\\\", \\\\\\\"1\\\\\\\", env=FAST).returncode == 0\\\\n153\\\\t    passes_until(root, lambda: (records_dir(root) / \\\\\\\"build-01.json\\\\\\\").exists(), seconds=30)\\\\n154\\\\t    assert stop_of(root, \\\\\\\"build\\\\\\\", 1)[\\\\\\\"class\\\\\\\"] == \\\\\\\"died\\\\\\\"\\\\n155\\\\t    passes_until(root, lambda: len(record_files(root, \\\\\\\"build\\\\\\\")) == 2, seconds=30)\\\\n156\\\\t    rec = latest_record(root, \\\\\\\"build\\\\\\\")\\\\n157\\\\t    assert rec[\\\\\\\"status\\\\\\\"] == \\\\\\\"pass\\\\\\\" and rec[\\\\\\\"retry_of\\\\\\\"] == \\\\\\\"build-01\\\\\\\", rec\\\\n158\\\\t    assert counsel_records(root) == []\\\\n159\\\\t\\\\n160\\\\t\\\\n161\\\\tdef test_a_red_check_becomes_a_returned_record_with_the_log_as_evidence(tmp_path: Path) -> None:\\\\n162\\\\t    \\\\\\\"\\\\\\\"\\\\\\\"Ruling C amended (#206's build-01): a concluded red required check\\\\n163\\\\t    on a passed build's head is a returned review record, class returned,\\\\n164\\\\t    the red checks its signature; the next build's first feedback carries\\\\n165\\\\t    the check's log read through [forge].check_log_command; no operator\\\\n166\\\\t    act between approval and the passing review.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n167\\\\t    calls = tmp_path / \\\\\\\"forge-calls\\\\\\\"\\\\n168\\\\t    forge = tmp_path / \\\\\\\"forge.sh\\\\\\\"\\\\n169\\\\t    forge.write_text(f'#!/bin/sh\\\\\\\\nn=$(cat {calls} 2>/dev/null || echo 0)\\\\\\\\nn=$((n+1))\\\\\\\\nprintf %s \\\\\\\"$n\\\\\\\" > {calls}\\\\\\\\n'\\\\n170\\\\t                     'if [ \\\\\\\"$n\\\\\\\" = 1 ]; then printf \\\\\\\"typecheck failure\\\\\\\\\\\\\\\\n\\\\\\\"; else printf \\\\\\\"typecheck success\\\\\\\\\\\\\\\\n\\\\\\\"; fi\\\\\\\\n')\\\\n171\\\\t    check_log = tmp_path / \\\\\\\"checklog.sh\\\\\\\"\\\\n172\\\\t    check_log.write_text('#!/bin/sh\\\\\\\\nprintf \\\\\\\"attavo/x.py:12: error: Incompatible return value type\\\\\\\\\\\\\\\\n\\\\\\\"\\\\\\\\n')\\\\n173\\\\t    feedback_copy = tmp_path / \\\\\\\"feedback\\\\\\\"\\\\n174\\\\t    prelude = (f'  cp \\\\\\\"${{ATTAVO_FEEDBACK:-/dev/null}}\\\\\\\" \\\\\\\"{feedback_copy}.$(ls \\\\\\\"$ATTAVO_RECORDS_DIR\\\\\\\" | grep -c \\\\\\\"^build-.*\\\\\\\\\\\\\\\\.started$\\\\\\\")\\\\\\\" 2>/dev/null || true')\\\\n175\\\\t    root = make_tenant(tmp_path, \\\\\\\"build_valid\\\\\\\")\\\\n176\\\\t    toml = root / \\\\\\\"attavo.toml\\\\\\\"\\\\n177\\\\t    toml.write_text(toml.read_text() + f'\\\\\\\\n[forge]\\\\\\\\nchecks_command = \\\\\\\"sh {forge}\\\\\\\"\\\\\\\\ncheck_log_command = \\\\\\\"sh {check_log}\\\\\\\"\\\\\\\\n')\\\\n178\\\\t    commit_all(root, \\\\\\\"a forge that reads red once\\\\\\\")\\\\n179\\\\t    add_drive_table(root)\\\\n180\\\\t    tenant_adapter(root, prelude)\\\\n181\\\\t    bare = add_bare_remote(root, tmp_path)\\\\n182\\\\t    approve_item(root)\\\\n183\\\\t    commit_all(root, \\\\\\\"approved\\\\\\\")\\\\n184\\\\t    git(root, \\\\\\\"push\\\\\\\", \\\\\\\"-q\\\\\\\", \\\\\\\"origin\\\\\\\", \\\\\\\"HEAD:main\\\\\\\")\\\\n185\\\\t    approved_at = git(root, \\\\\\\"rev-parse\\\\\\\", \\\\\\\"HEAD\\\\\\\").strip()\\\\n186\\\\t\\\\n187\\\\t    passes_until(root, lambda: pushed(bare, \\\\\\\"verify record for item 1 (verify-01)\\\\\\\"), seconds=40)\\\\n188\\\\t    returned = latest_record(root, \\\\\\\"verify\\\\\\\")\\\\n189\\\\t    assert returned[\\\\\\\"status\\\\\\\"] == \\\\\\\"returned\\\\\\\", returned\\\\n190\\\\t    assert returned[\\\\\\\"stop\\\\\\\"][\\\\\\\"class\\\\\\\"] == \\\\\\\"returned\\\\\\\" and returned[\\\\\\\"stop\\\\\\\"][\\\\\\\"signature\\\\\\\"] == \\\\\\\"typecheck\\\\\\\", returned[\\\\\\\"stop\\\\\\\"]\\\\n191\\\\t\\\\n192\\\\t    passes_until(root, lambda: pushed(bare, \\\\\\\"build record for item 1 (build-02)\\\\\\\"), seconds=40)\\\\n193\\\\t    assert latest_record(root, \\\\\\\"build\\\\\\\")[\\\\\\\"retry_of\\\\\\\"] == \\\\\\\"build-01\\\\\\\"\\\\n194\\\\t    second = (feedback_copy.parent / (feedback_copy.name + \\\\\\\".2\\\\\\\")).read_text()\\\\n195\\\\t    assert \\\\\\\"typecheck\\\\\\\" in second and \\\\\\\"Incompatible return value type\\\\\\\" in second, second\\\\n196\\\\t\\\\n197\\\\t    passes_until(root, lambda: pushed(bare, \\\\\\\"verify record for item 1 (verify-02)\\\\\\\"), seconds=40)\\\\n198\\\\t    assert latest_record(root, \\\\\\\"verify\\\\\\\")[\\\\\\\"status\\\\\\\"] == \\\\\\\"pass\\\\\\\"\\\\n199\\\\t    authors = set(git(root, \\\\\\\"log\\\\\\\", \\\\\\\"--format=%an\\\\\\\", f\\\\\\\"{approved_at}..origin/main\\\\\\\").splitlines())\\\\n200\\\\t    assert authors <= {\\\\\\\"attavo driver\\\\\\\", \\\\\\\"attavo executor (fixture)\\\\\\\"}, authors\\\\n201\\\\t\\\\n202\\\\t\\\\n203\\\\tdef test_a_returned_review_retries_with_its_findings_and_counsels_on_the_second(tmp_path: Path) -> None:\\\\n204\\\\t    \\\\\\\"\\\\\\\"\\\\\\\"A review that returns blocking findings is the returned family: the\\\\n205\\\\t    next build is handed the findings, counsel is not asked on the first\\\\n206\\\\t    return and is asked on the second identical one.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n207\\\\t    findings = tmp_path / \\\\\\\"findings.json\\\\\\\"\\\\n208\\\\t    findings.write_text(json.dumps([{\\\\\\\"title\\\\\\\": \\\\\\\"the helper is never called\\\\\\\", \\\\\\\"specimen\\\\\\\": \\\\\\\"x\\\\\\\", \\\\\\\"retires\\\\\\\": \\\\\\\"y\\\\\\\",\\\\n209\\\\t                                     \\\\\\\"rejection_test\\\\\\\": \\\\\\\"z\\\\\\\", \\\\\\\"severity\\\\\\\": \\\\\\\"blocking\\\\\\\"}]))\\\\n210\\\\t    feedback_copy = tmp_path / \\\\\\\"feedback\\\\\\\"\\\\n211\\\\t    prelude = (f'  cp \\\\\\\"${{ATTAVO_FEEDBACK:-/dev/null}}\\\\\\\" \\\\\\\"{feedback_copy}.$(ls \\\\\\\"$ATTAVO_RECORDS_DIR\\\\\\\" | grep -c \\\\\\\"^build-.*\\\\\\\\\\\\\\\\.started$\\\\\\\")\\\\\\\" 2>/dev/null || true')\\\\n212\\\\t    root, bare = approved_tenant(tmp_path, prelude)\\\\n213\\\\t    d = root / \\\\\\\"attavo\\\\\\\" / \\\\\\\"adapters\\\\\\\" / \\\\\\\"fixture\\\\\\\"\\\\n214\\\\t    run = (d / \\\\\\\"run\\\\\\\").read_text()\\\\n215\\\\t    verify_branch = ('if [ \\\\\\\"${ATTAVO_STAGE:-build}\\\\\\\" = verify ]; then\\\\\\\\n'\\\\n216\\\\t                     f'  printf \\\\\\\\'{{\\\\\\\"model\\\\\\\":\\\\\\\"fixture\\\\\\\",\\\\\\\"model_version\\\\\\\":null,\\\\\\\"adapter_version\\\\\\\":\\\\\\\"fixture-1\\\\\\\",\\\\\\\"tokens\\\\\\\":{{\\\\\\\"input\\\\\\\":1,\\\\\\\"output\\\\\\\":1}},\\\\\\\"cost_usd\\\\\\\":0.0,\\\\\\\"findings\\\\\\\":%s,\\\\\\\"tests_named\\\\\\\":[]}}\\\\\\\\\\\\\\\\n\\\\\\\\' \\\\\\\"$(cat {findings})\\\\\\\"\\\\\\\\n'\\\\n217\\\\t                     \\\\\\\"  exit 0\\\\\\\\nfi\\\\\\\\n\\\\\\\")\\\\n218\\\\t    (d / \\\\\\\"run\\\\\\\").write_text(run.replace(\\\\\\\"#!/bin/sh\\\\\\\\n\\\\\\\", \\\\\\\"#!/bin/sh\\\\\\\\n\\\\\\\" + verify_branch, 1))\\\\n219\\\\t    commit_all(root, \\\\\\\"a review that returns a blocking finding\\\\\\\")\\\\n220\\\\t    git(root, \\\\\\\"push\\\\\\\", \\\\\\\"-q\\\\\\\", \\\\\\\"origin\\\\\\\", \\\\\\\"HEAD:main\\\\\\\")\\\\n221\\\\t    manifest = root / \\\\\\\"attavo.toml\\\\\\\"\\\\n222\\\\t    manifest.write_text(manifest.read_text().replace('[executor]\\\\\\\\nbuild = \\\\\\\"fixture\\\\\\\"', '[executor]\\\\\\\\nbuild = \\\\\\\"fixture\\\\\\\"\\\\\\\\ncounsel = \\\\\\\"fixture\\\\\\\"'))\\\\n223\\\\t    commit_all(root, \\\\\\\"counsel configured\\\\\\\")\\\\n224\\\\t    git(root, \\\\\\\"push\\\\\\\", \\\\\\\"-q\\\\\\\", \\\\\\\"origin\\\\\\\", \\\\\\\"HEAD:main\\\\\\\")\\\\n225\\\\t\\\\n226\\\\t    passes_until(root, lambda: pushed(bare, \\\\\\\"verify record for item 1 (verify-01)\\\\\\\"), seconds=40)\\\\n227\\\\t    first = latest_record(root, \\\\\\\"verify\\\\\\\")\\\\n228\\\\t    assert first[\\\\\\\"status\\\\\\\"] != \\\\\\\"pass\\\\\\\" and first[\\\\\\\"stop\\\\\\\"][\\\\\\\"class\\\\\\\"] == \\\\\\\"returned\\\\\\\", first\\\\n229\\\\t    assert first[\\\\\\\"stop\\\\\\\"][\\\\\\\"signature\\\\\\\"] == \\\\\\\"the helper is never called\\\\\\\"\\\\n230\\\\t    assert counsel_records(root) == [], \\\\\\\"counsel is not asked on the first return\\\\\\\"\\\\n231\\\\t\\\\n232\\\\t    passes_until(root, lambda: pushed(bare, \\\\\\\"build record for item 1 (build-02)\\\\\\\"), seconds=40)\\\\n233\\\\t    assert latest_record(root, \\\\\\\"build\\\\\\\")[\\\\\\\"retry_of\\\\\\\"] == \\\\\\\"build-01\\\\\\\"\\\\n234\\\\t    assert \\\\\\\"the helper is never called\\\\\\\" in (feedback_copy.parent / (feedback_copy.name + \\\\\\\".2\\\\\\\")).read_text()\\\\n235\\\\t\\\\n236\\\\t    passes_until(root, lambda: pushed(bare, \\\\\\\"verify record for item 1 (verify-02)\\\\\\\"), seconds=40)\\\\n237\\\\t    passes_until(root, lambda: counsel_records(root) != [], seconds=20)\\\\n238\\\\t    assert latest_record(root, \\\\\\\"counsel\\\\\\\")[\\\\\\\"record\\\\\\\"] == \\\\\\\"verify-02\\\\\\\"\\\\n239\\\\t\\\\n240\\\\t\\\\n241\\\\tdef test_counsels_verdict_routes_the_next_pass(tmp_path: Path) -> None:\\\\n242\\\\t    \\\\\\\"\\\\\\\"\\\\\\\"Counsel steers: `answer` starts the next attempt with the answer as\\\\n243\\\\t    its steer (recorded in `steer`); `patch` starts nothing and the\\\\n244\\\\t    report reads waiting on the issue; `person` starts nothing.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n245\\\\t    responses = tmp_path / \\\\\\\"counsel\\\\\\\"\\\\n246\\\\t    responses.mkdir()\\\\n247\\\\t    for verdict in (\\\\\\\"answer\\\\\\\", \\\\\\\"patch\\\\\\\", \\\\\\\"person\\\\\\\"):\\\\n248\\\\t        (responses / f\\\\\\\"{verdict}.json\\\\\\\").write_text(json.dumps({\\\\n249\\\\t            \\\\\\\"model\\\\\\\": \\\\\\\"fixture\\\\\\\", \\\\\\\"model_version\\\\\\\": None, \\\\\\\"adapter_version\\\\\\\": \\\\\\\"fixture-1\\\\\\\",\\\\n250\\\\t            \\\\\\\"tokens\\\\\\\": {\\\\\\\"input\\\\\\\": 1, \\\\\\\"output\\\\\\\": 1}, \\\\\\\"cost_usd\\\\\\\": 0.0, \\\\\\\"class\\\\\\\": \\\\\\\"question\\\\\\\", \\\\\\\"verdict\\\\\\\": verdict,\\\\n251\\\\t            \\\\\\\"citations\\\\\\\": [{\\\\\\\"kind\\\\\\\": \\\\\\\"instruction\\\\\\\", \\\\\\\"path\\\\\\\": \\\\\\\"specs/1/spec.md\\\\\\\", \\\\\\\"symbol\\\\\\\": \\\\\\\"problem\\\\\\\"}],\\\\n252\\\\t            \\\\\\\"proposal\\\\\\\": {\\\\\\\"ruling_text\\\\\\\": \\\\\\\"use the base tree\\\\\\\" if verdict == \\\\\\\"answer\\\\\\\" else None,\\\\n253\\\\t                         \\\\\\\"patch\\\\\\\": \\\\\\\"the fixture cannot read overlays\\\\\\\" if verdict == \\\\\\\"patch\\\\\\\" else None,\\\\n254\\\\t                         \\\\\\\"question\\\\\\\": None if verdict != \\\\\\\"person\\\\\\\" else \\\\\\\"which overlay wins?\\\\\\\"}}))\\\\n255\\\\t    for verdict, expect_attempt in ((\\\\\\\"answer\\\\\\\", 2), (\\\\\\\"patch\\\\\\\", 1), (\\\\\\\"person\\\\\\\", 1)):\\\\n256\\\\t        sub = tmp_path / verdict\\\\n257\\\\t        sub.mkdir()\\\\n258\\\\t        root, bare = approved_tenant(sub)\\\\n259\\\\t        manifest = root / \\\\\\\"attavo.toml\\\\\\\"\\\\n260\\\\t        manifest.write_text(manifest.read_text().replace('[executor]\\\\\\\\nbuild = \\\\\\\"fixture\\\\\\\"', '[executor]\\\\\\\\nbuild = \\\\\\\"fixture\\\\\\\"\\\\\\\\ncounsel = \\\\\\\"fixture\\\\\\\"'))\\\\n261\\\\t        commit_all(root, \\\\\\\"counsel configured\\\\\\\")\\\\n262\\\\t        git(root, \\\\\\\"push\\\\\\\", \\\\\\\"-q\\\\\\\", \\\\\\\"origin\\\\\\\", \\\\\\\"HEAD:main\\\\\\\")\\\\n263\\\\t        env = {\\\\\\\"ATTAVO_FIXTURE_QUESTION\\\\\\\": \\\\\\\"which overlay wins?\\\\\\\",\\\\n264\\\\t               \\\\\\\"ATTAVO_FIXTURE_COUNSEL_RESPONSE\\\\\\\": str(responses / f\\\\\\\"{verdict}.json\\\\\\\")}\\\\n265\\\\t        passes_until(root, lambda: pushed(bare, \\\\\\\"build record for item 1 (build-01)\\\\\\\"), seconds=40, env=env)\\\\n266\\\\t        assert latest_record(root, \\\\\\\"counsel\\\\\\\")[\\\\\\\"verdict\\\\\\\"] == verdict\\\\n267\\\\t        for _ in range(3):\\\\n268\\\\t            run_attavo(root, \\\\\\\"drive\\\\\\\", \\\\\\\"1\\\\\\\", env={**FAST, **env})\\\\n269\\\\t            time.sleep(0.5)\\\\n270\\\\t        if expect_attempt == 2:\\\\n271\\\\t            passes_until(root, lambda: len(record_files(root, \\\\\\\"build\\\\\\\")) == 2, seconds=30, env={**env, \\\\\\\"ATTAVO_FIXTURE_QUESTION\\\\\\\": \\\\\\\"\\\\\\\"})\\\\n272\\\\t            assert latest_record(root, \\\\\\\"build\\\\\\\")[\\\\\\\"steer\\\\\\\"] == \\\\\\\"counsel-01\\\\\\\"\\\\n273\\\\t        else:\\\\n274\\\\t            assert len(record_files(root, \\\\\\\"build\\\\\\\")) == 1, verdict\\\\n275\\\\t            out = report(root)\\\\n276\\\\t            assert out[\\\\\\\"state\\\\\\\"] == \\\\\\\"stopped\\\\\\\", out\\\\n277\\\\t            if verdict == \\\\\\\"patch\\\\\\\":\\\\n278\\\\t                assert \\\\\\\"waiting on\\\\\\\" in out[\\\\\\\"says\\\\\\\"], out[\\\\\\\"says\\\\\\\"]\\\\n279\\\\t\\\\n280\\\\t\\\\n281\\\\tdef test_a_persons_stop_is_never_retried(tmp_path: Path) -> None:\\\\n282\\\\t    \\\\\\\"\\\\\\\"\\\\\\\"A question with no counsel configured, a claims-boundary stop, and\\\\n283\\\\t    an environment refusal are a person's: three passes over each start\\\\n284\\\\t    nothing.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n285\\\\t    cases = {\\\\n286\\\\t        \\\\\\\"question\\\\\\\": ({\\\\\\\"ATTAVO_FIXTURE_QUESTION\\\\\\\": \\\\\\\"which overlay wins?\\\\\\\"}, \\\\\\\"\\\\\\\"),\\\\n287\\\\t        \\\\\\\"claims\\\\\\\": ({\\\\\\\"ATTAVO_FIXTURE_WRITE\\\\\\\": \\\\\\\"outside/claims.txt\\\\\\\"}, \\\\\\\"\\\\\\\"),\\\\n288\\\\t    }\\\\n289\\\\t    for name, (env, prelude) in cases.items():\\\\n290\\\\t        sub = tmp_path / name\\\\n291\\\\t        sub.mkdir()\\\\n292\\\\t        root, bare = approved_tenant(sub, prelude)\\\\n293\\\\t        full = {**FAST, **env}\\\\n294\\\\t        run_attavo(root, \\\\\\\"drive\\\\\\\", \\\\\\\"1\\\\\\\", env=full)\\\\n295\\\\t        wait_for(lambda: pushed(bare, \\\\\\\"build record for item 1 (build-01)\\\\\\\"))\\\\n296\\\\t        first = latest_record(root, \\\\\\\"build\\\\\\\")\\\\n297\\\\t        assert first[\\\\\\\"status\\\\\\\"] != \\\\\\\"pass\\\\\\\", (name, first)\\\\n298\\\\t        for _ in range(3):\\\\n299\\\\t            run_attavo(root, \\\\\\\"drive\\\\\\\", \\\\\\\"1\\\\\\\", env=full)\\\\n300\\\\t            time.sleep(0.3)\\\\n301\\\\t        assert len(record_files(root, \\\\\\\"build\\\\\\\")) == 1, name\\\\n302\\\\t        assert not (records_dir(root) / \\\\\\\"build-02.started\\\\\\\").exists(), name\\\\n303\\\\t        assert report(root)[\\\\\\\"state\\\\\\\"] == \\\\\\\"stopped\\\\\\\"\\\\n304\\\\t\\\\n305\\\\t\\\\n306\\\\tdef test_identical_failures_stop_early_and_the_budget_holds(tmp_path: Path) -> None:\\\\n307\\\\t    \\\\\\\"\\\\\\\"\\\\\\\"Two attempts ending with the identical signature stop the stage at\\\\n308\\\\t    two; two different signatures proceed to a third; a fourth never\\\\n309\\\\t    starts.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n310\\\\t    same = ('  at=\\\\\\\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\\\\\\\"\\\\\\\\n'\\\\n311\\\\t            '  printf \\\\\\\\'{\\\\\\\"at\\\\\\\":\\\\\\\"%s\\\\\\\",\\\\\\\"kind\\\\\\\":\\\\\\\"tool_call\\\\\\\",\\\\\\\"text\\\\\\\":\\\\\\\"fixture-tool waiting on lock 4471\\\\\\\"}\\\\\\\\\\\\\\\\n\\\\\\\\' \\\\\\\"$at\\\\\\\" >> \\\\\\\"$ATTAVO_EVENTS\\\\\\\"\\\\\\\\n'\\\\n312\\\\t            \\\\\\\"  kill -9 $PPID\\\\\\\\n  sleep 3\\\\\\\")\\\\n313\\\\t    root, _bare = approved_tenant(tmp_path / \\\\\\\"same\\\\\\\", same)\\\\n314\\\\t    passes_until(root, lambda: len(record_files(root, \\\\\\\"build\\\\\\\")) == 2, seconds=60)\\\\n315\\\\t    for _ in range(6):\\\\n316\\\\t        run_attavo(root, \\\\\\\"drive\\\\\\\", \\\\\\\"1\\\\\\\", env=FAST)\\\\n317\\\\t        time.sleep(0.5)\\\\n318\\\\t    assert len(record_files(root, \\\\\\\"build\\\\\\\")) == 2\\\\n319\\\\t    assert not (records_dir(root) / \\\\\\\"build-03.started\\\\\\\").exists()\\\\n320\\\\t    assert stop_of(root, \\\\\\\"build\\\\\\\", 1)[\\\\\\\"signature\\\\\\\"] == stop_of(root, \\\\\\\"build\\\\\\\", 2)[\\\\\\\"signature\\\\\\\"]\\\\n321\\\\t\\\\n322\\\\t    differ = ('  at=\\\\\\\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\\\\\\\"\\\\\\\\n'\\\\n323\\\\t              '  n=$(ls \\\\\\\"$ATTAVO_RECORDS_DIR\\\\\\\" | grep -c \\\\\\\"^build-.*\\\\\\\\\\\\\\\\.started$\\\\\\\")\\\\\\\\n'\\\\n324\\\\t              '  printf \\\\\\\\'{\\\\\\\"at\\\\\\\":\\\\\\\"%s\\\\\\\",\\\\\\\"kind\\\\\\\":\\\\\\\"tool_call\\\\\\\",\\\\\\\"text\\\\\\\":\\\\\\\"fixture-tool step %s of the plan\\\\\\\"}\\\\\\\\\\\\\\\\n\\\\\\\\' \\\\\\\"$at\\\\\\\" \\\\\\\"$(printf \\\\\\\"%s\\\\\\\" \\\\\\\"$n\\\\\\\" | tr 0-9 a-j)\\\\\\\" >> \\\\\\\"$ATTAVO_EVENTS\\\\\\\"\\\\\\\\n'\\\\n325\\\\t              \\\\\\\"  kill -9 $PPID\\\\\\\\n  sleep 3\\\\\\\")\\\\n326\\\\t    root2, _ = approved_tenant(tmp_path / \\\\\\\"differ\\\\\\\", differ)\\\\n327\\\\t    passes_until(root2, lambda: len(record_files(root2, \\\\\\\"build\\\\\\\")) == 3, seconds=90)\\\\n328\\\\t    for _ in range(6):\\\\n329\\\\t        run_attavo(root2, \\\\\\\"drive\\\\\\\", \\\\\\\"1\\\\\\\", env=FAST)\\\\n330\\\\t        time.sleep(0.5)\\\\n331\\\\t    assert len(record_files(root2, \\\\\\\"build\\\\\\\")) == 3\\\\n332\\\\t    assert not (records_dir(root2) / \\\\\\\"build-04.started\\\\\\\").exists()\\\\n333\\\\t    out = report(root2)\\\\n334\\\\t    assert out[\\\\\\\"state\\\\\\\"] == \\\\\\\"stopped\\\\\\\" and len(out[\\\\\\\"attempts\\\\\\\"]) == 3, out\\\\n335\\\\t\\\\n336\\\\t\\\\n337\\\\tdef test_every_marker_spends_the_budget(tmp_path: Path) -> None:\\\\n338\\\\t    \\\\\\\"\\\\\\\"\\\\\\\"A recovered attempt counts: with attempts = 2, one died attempt and\\\\n339\\\\t    one transient attempt spend the budget and a third never starts,\\\\n340\\\\t    though the two signatures differ.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n341\\\\t    prelude = ('  n=$(ls \\\\\\\"$ATTAVO_RECORDS_DIR\\\\\\\" | grep -c \\\\\\\"^build-.*\\\\\\\\\\\\\\\\.started$\\\\\\\")\\\\\\\\n'\\\\n342\\\\t               '  if [ \\\\\\\"$n\\\\\\\" = 1 ]; then kill -9 $PPID; sleep 3; fi\\\\\\\\n'\\\\n343\\\\t               f'  if [ \\\\\\\"$n\\\\\\\" = 2 ]; then echo \\\\\\\\'{TRANSIENT_LINE}\\\\\\\\'; exit 1; fi')\\\\n344\\\\t    root, _ = approved_tenant(tmp_path, prelude, attempts=2)\\\\n345\\\\t    passes_until(root, lambda: len(record_files(root, \\\\\\\"build\\\\\\\")) == 2, seconds=60)\\\\n346\\\\t    for _ in range(6):\\\\n347\\\\t        run_attavo(root, \\\\\\\"drive\\\\\\\", \\\\\\\"1\\\\\\\", env=FAST)\\\\n348\\\\t        time.sleep(0.5)\\\\n349\\\\t    assert len(record_files(root, \\\\\\\"build\\\\\\\")) == 2\\\\n350\\\\t    assert not (records_dir(root) / \\\\\\\"build-03.started\\\\\\\").exists()\\\\n351\\\\t    out = report(root)\\\\n352\\\\t    assert out[\\\\\\\"state\\\\\\\"] == \\\\\\\"stopped\\\\\\\" and out[\\\\\\\"signatures_match\\\\\\\"] is False, out\\\\n353\\\\t    assert any(\\\\\\\"again\\\\\\\" in r for r in out[\\\\\\\"rulings_available\\\\\\\"]), out\\\\n354\\\\t\\\\n355\\\\t\\\\n356\\\\tdef test_a_stage_past_its_ceiling_is_hung_by_the_ceiling(tmp_path: Path) -> None:\\\\n357\\\\t    \\\\\\\"\\\\\\\"\\\\\\\"A worker alive past [drive.build].ceiling_s is terminated and\\\\n358\\\\t    recorded hung with bound ceiling; an adapter that declares it does\\\\n359\\\\t    not stream events is never judged by event age.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n360\\\\t    root, bare = approved_tenant(tmp_path, \\\\\\\"  sleep 20\\\\\\\", build_ceiling_s=2)\\\\n361\\\\t    d = root / \\\\\\\"attavo\\\\\\\" / \\\\\\\"adapters\\\\\\\" / \\\\\\\"fixture\\\\\\\"\\\\n362\\\\t    (d / \\\\\\\"conformance.json\\\\\\\").write_text(json.dumps({\\\\\\\"streams_events\\\\\\\": False}) + \\\\\\\"\\\\\\\\n\\\\\\\")\\\\n363\\\\t    commit_all(root, \\\\\\\"an adapter that does not stream\\\\\\\")\\\\n364\\\\t    git(root, \\\\\\\"push\\\\\\\", \\\\\\\"-q\\\\\\\", \\\\\\\"origin\\\\\\\", \\\\\\\"HEAD:main\\\\\\\")\\\\n365\\\\t    assert run_attavo(root, \\\\\\\"drive\\\\\\\", \\\\\\\"1\\\\\\\", env=FAST).returncode == 0\\\\n366\\\\t    time.sleep(3)\\\\n367\\\\t    out = report(root)\\\\n368\\\\t    assert out[\\\\\\\"state\\\\\\\"] == \\\\\\\"owes-recovery\\\\\\\", out\\\\n369\\\\t    assert \\\\\\\"event\\\\\\\" not in out[\\\\\\\"says\\\\\\\"], out[\\\\\\\"says\\\\\\\"]\\\\n370\\\\t    passes_until(root, lambda: pushed(bare, \\\\\\\"build record for item 1 (build-01)\\\\\\\"), seconds=20)\\\\n371\\\\t    stop = stop_of(root, \\\\\\\"build\\\\\\\", 1)\\\\n372\\\\t    assert stop[\\\\\\\"class\\\\\\\"] == \\\\\\\"hung\\\\\\\" and stop[\\\\\\\"bound\\\\\\\"] == \\\\\\\"ceiling\\\\\\\", stop\\\\n373\\\\t\\\\n374\\\\t\\\\n375\\\\tdef test_again_resets_a_spent_budget_only(tmp_path: Path) -> None:\\\\n376\\\\t    \\\\\\\"\\\\\\\"\\\\\\\"--again on a stage whose budget is spent starts the next attempt\\\\n377\\\\t    and records that in the marker; inside the budget it is a no-op that\\\\n378\\\\t    says the pass retries on its own.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n379\\\\t    same = ('  at=\\\\\\\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\\\\\\\"\\\\\\\\n'\\\\n380\\\\t            '  printf \\\\\\\\'{\\\\\\\"at\\\\\\\":\\\\\\\"%s\\\\\\\",\\\\\\\"kind\\\\\\\":\\\\\\\"tool_call\\\\\\\",\\\\\\\"text\\\\\\\":\\\\\\\"fixture-tool waiting on lock\\\\\\\"}\\\\\\\\\\\\\\\\n\\\\\\\\' \\\\\\\"$at\\\\\\\" >> \\\\\\\"$ATTAVO_EVENTS\\\\\\\"\\\\\\\\n'\\\\n381\\\\t            \\\\\\\"  kill -9 $PPID\\\\\\\\n  sleep 3\\\\\\\")\\\\n382\\\\t    root, _ = approved_tenant(tmp_path, same)\\\\n383\\\\t    passes_until(root, lambda: len(record_files(root, \\\\\\\"build\\\\\\\")) == 1, seconds=30)\\\\n384\\\\t    inside = run_attavo(root, \\\\\\\"drive\\\\\\\", \\\\\\\"1\\\\\\\", \\\\\\\"--again\\\\\\\", env=FAST)\\\\n385\\\\t    assert inside.returncode == 0 and \\\\\\\"retries on its own\\\\\\\" in inside.stdout, inside.stdout\\\\n386\\\\t    passes_until(root, lambda: len(record_files(root, \\\\\\\"build\\\\\\\")) == 2, seconds=60)\\\\n387\\\\t    for _ in range(3):\\\\n388\\\\t        run_attavo(root, \\\\\\\"drive\\\\\\\", \\\\\\\"1\\\\\\\", env=FAST)\\\\n389\\\\t        time.sleep(0.5)\\\\n390\\\\t    assert len(record_files(root, \\\\\\\"build\\\\\\\")) == 2\\\\n391\\\\t    again = run_attavo(root, \\\\\\\"drive\\\\\\\", \\\\\\\"1\\\\\\\", \\\\\\\"--again\\\\\\\", env=FAST)\\\\n392\\\\t    assert again.returncode == 0 and \\\\\\\"Build started\\\\\\\" in again.stdout, again.stdout\\\\n393\\\\t    marker = json.loads((records_dir(root) / \\\\\\\"build-03.started\\\\\\\").read_text())\\\\n394\\\\t    assert marker.get(\\\\\\\"again_by\\\\\\\"), marker\\\\n395\\\\t\\\\n396\\\\t\\\\n397\\\\tdef test_adapters_class_transient() -> None:\\\\n398\\\\t    \\\\\\\"\\\\\\\"\\\\\\\"The fixture, claude-code and codex adapters put class transient on\\\\n399\\\\t    the report line for a capacity, rate, or 5xx refusal: each adapter's\\\\n400\\\\t    conformance.json names the situation and the product's own stop\\\\n401\\\\t    classes carry it.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n402\\\\t    from attavo.stops import RETRYABLE_CLASSES, STOP_CLASSES\\\\n403\\\\t    assert \\\\\\\"transient\\\\\\\" in STOP_CLASSES and \\\\\\\"returned\\\\\\\" in STOP_CLASSES\\\\n404\\\\t    assert RETRYABLE_CLASSES == (\\\\\\\"died\\\\\\\", \\\\\\\"hung\\\\\\\", \\\\\\\"transient\\\\\\\", \\\\\\\"returned\\\\\\\")\\\\n405\\\\t    for adapter in (\\\\\\\"fixture\\\\\\\", \\\\\\\"claude-code\\\\\\\", \\\\\\\"codex\\\\\\\"):\\\\n406\\\\t        conf = json.loads((ROOT / \\\\\\\"adapters\\\\\\\" / adapter / \\\\\\\"conformance.json\\\\\\\").read_text())\\\\n407\\\\t        assert \\\\\\\"streams_events\\\\\\\" in conf, adapter\\\\n408\\\\t        assert \\\\\\\"transient\\\\\\\" in json.dumps(conf.get(\\\\\\\"situations\\\\\\\", {})) or \\\\\\\"transient\\\\\\\" in json.dumps(conf), adapter\\\\n409\\\\t    env = dict(os.environ)\\\\n410\\\\t    env[\\\\\\\"ATTAVO_FIXTURE_TRANSIENT\\\\\\\"] = \\\\\\\"API error: overloaded\\\\\\\"\\\\n411\\\\t    env[\\\\\\\"ATTAVO_STAGE\\\\\\\"] = \\\\\\\"build\\\\\\\"\\\\n412\\\\t    run = subprocess.run([\\\\\\\"sh\\\\\\\", str(FIXTURE_RUN)], capture_output=True, text=True, env=env, cwd=str(ROOT))\\\\n413\\\\t    line = [l for l in run.stdout.splitlines() if l.startswith(\\\\\\\"{\\\\\\\")][-1]\\\\n414\\\\t    assert json.loads(line).get(\\\\\\\"class\\\\\\\") == \\\\\\\"transient\\\\\\\", run.stdout\\\\n415\\\\t\\\"}]},\\\"parent_tool_use_id\\\":null,\\\"session_id\\\":\\\"ac4fb82d-7667-4afa-b9e0-dc09bb237f8a\\\",\\\"uuid\\\":\\\"5f84941b-9bb1-458a-bdb9-2fb86631e99c\\\",\\\"timestamp\\\":\\\"2026-09-26T03:03:33.105Z\\\",\\\"tool_use_result\\\":{\\\"type\\\":\\\"text\\\",\\\"file\\\":{\\\"filePath\\\":\\\"/Users/davidbean/Projects/attavo-worktree-219/tests/test_retry.py\\\",\\\"content\\\":\\\"\\\\\\\"\\\\\\\"\\\\\\\"The reconciler's R3 (claude/reconciler-brief-2026-09-20.md ruling C and\\\\nits amendments; claude/r3-rulings-2026-09-25.md): a stage that stops for a\\\\nreason that does not touch the definition of done is started again by a\\\\npass, not a person. Four retryable families (died, hung, transient,\\\\nreturned), one budget of [drive].attempts per stage, an early stop on two\\\\nidentical failure signatures, an exhaustion report, stage ceilings, and\\\\nthe prior attempt's evidence handed to the next through the feedback file\\\\nthe adapter contract already passes.\\\\n\\\\nEvery test drives a fixture tenant through `attavo drive N` passes alone\\\\nand reads records, never internals. Written red first against d20fdea\\\\n(R2 as merged) and against R3's thin stub.\\\\n\\\\nRun: python3 -m pytest tests -q\\\\n\\\\\\\"\\\\\\\"\\\\\\\"\\\\nfrom __future__ import annotations\\\\n\\\\nimport json\\\\nimport os\\\\nimport subprocess\\\\nimport time\\\\nfrom pathlib import Path\\\\nfrom typing import Any\\\\n\\\\nfrom helpers import commit_all, git, make_tenant\\\\nfrom test_drive import (\\\\n    GREEN_FORGE,\\\\n    add_bare_remote,\\\\n    add_forge,\\\\n    approve_item,\\\\n    latest_record,\\\\n    record_files,\\\\n    records_dir,\\\\n    run_attavo,\\\\n)\\\\nfrom test_pass import FAST, pushed, report, wait_for\\\\n\\\\nROOT = Path(__file__).resolve().parent.parent\\\\nFIXTURE_RUN = ROOT / \\\\\\\"adapters\\\\\\\" / \\\\\\\"fixture\\\\\\\" / \\\\\\\"run\\\\\\\"\\\\n\\\\nDONE_LINE = ('{\\\\\\\"status\\\\\\\":\\\\\\\"done\\\\\\\",\\\\\\\"question\\\\\\\":null,\\\\\\\"model\\\\\\\":\\\\\\\"fixture\\\\\\\",\\\\\\\"model_version\\\\\\\":null,'\\\\n             '\\\\\\\"adapter_version\\\\\\\":\\\\\\\"fixture-1\\\\\\\",\\\\\\\"tokens\\\\\\\":{\\\\\\\"input\\\\\\\":1,\\\\\\\"output\\\\\\\":1},\\\\\\\"cost_usd\\\\\\\":0.0}')\\\\nTRANSIENT_LINE = ('{\\\\\\\"status\\\\\\\":\\\\\\\"failed\\\\\\\",\\\\\\\"question\\\\\\\":null,\\\\\\\"class\\\\\\\":\\\\\\\"transient\\\\\\\",'\\\\n                  '\\\\\\\"detail\\\\\\\":\\\\\\\"API error: overloaded, retry after 30s\\\\\\\",\\\\\\\"model\\\\\\\":\\\\\\\"fixture\\\\\\\",'\\\\n                  '\\\\\\\"model_version\\\\\\\":null,\\\\\\\"adapter_version\\\\\\\":\\\\\\\"fixture-1\\\\\\\",'\\\\n                  '\\\\\\\"tokens\\\\\\\":{\\\\\\\"input\\\\\\\":1,\\\\\\\"output\\\\\\\":1},\\\\\\\"cost_usd\\\\\\\":0.0}')\\\\n\\\\n\\\\ndef add_drive_table(root: Path, *, attempts: int = 3, retry_after_s: int = 0,\\\\n                    build_ceiling_s: int = 600, verify_ceiling_s: int = 600,\\\\n                    stall_after_s: int = 60) -> None:\\\\n    toml = root / \\\\\\\"attavo.toml\\\\\\\"\\\\n    toml.write_text(toml.read_text() + (\\\\n        f\\\\\\\"\\\\\\\\n[drive]\\\\\\\\nstall_after_s = {stall_after_s}\\\\\\\\nattempts = {attempts}\\\\\\\\n\\\\\\\"\\\\n        f\\\\\\\"retry_after_s = {retry_after_s}\\\\\\\\n\\\\\\\\n[drive.build]\\\\\\\\nceiling_s = {build_ceiling_s}\\\\\\\\n\\\\\\\\n\\\\\\\"\\\\n        f\\\\\\\"[drive.verify]\\\\\\\\nceiling_s = {verify_ceiling_s}\\\\\\\\n\\\\\\\"))\\\\n    commit_all(root, \\\\\\\"declare the drive table\\\\\\\")\\\\n\\\\n\\\\ndef tenant_adapter(root: Path, build_prelude: str, streams_events: bool | None = None) -> None:\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"A tenant-side build adapter: `build_prelude` runs first on the build\\\\n    stage (it may exit), then the product's own fixture adapter. A build\\\\n    that is retried on a tree already carrying built.txt rewrites it, so\\\\n    the fixture's own commit has something to commit.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n    d = root / \\\\\\\"attavo\\\\\\\" / \\\\\\\"adapters\\\\\\\" / \\\\\\\"fixture\\\\\\\"\\\\n    d.mkdir(parents=True, exist_ok=True)\\\\n    (d / \\\\\\\"run\\\\\\\").write_text(\\\\n        \\\\\\\"#!/bin/sh\\\\\\\\n\\\\\\\"\\\\n        'if [ \\\\\\\"${ATTAVO_STAGE:-build}\\\\\\\" = build ]; then\\\\\\\\n'\\\\n        f\\\\\\\"{build_prelude}\\\\\\\\n\\\\\\\"\\\\n        \\\\\\\"  if [ -f built.txt ]; then\\\\\\\\n\\\\\\\"\\\\n        '    echo \\\\\\\"built again $(date +%s%N)\\\\\\\" > built.txt\\\\\\\\n'\\\\n        \\\\\\\"    git add built.txt\\\\\\\\n\\\\\\\"\\\\n        \\\\\\\"    git commit -q -m 'fixture: write built.txt again'\\\\\\\\n\\\\\\\"\\\\n        f\\\\\\\"    echo '{DONE_LINE}'\\\\\\\\n\\\\\\\"\\\\n        \\\\\\\"    exit 0\\\\\\\\n\\\\\\\"\\\\n        \\\\\\\"  fi\\\\\\\\n\\\\\\\"\\\\n        \\\\\\\"fi\\\\\\\\n\\\\\\\"\\\\n        f\\\\\\\"exec sh {FIXTURE_RUN}\\\\\\\\n\\\\\\\")\\\\n    (d / \\\\\\\"run\\\\\\\").chmod(0o755)\\\\n    if streams_events is not None:\\\\n        (d / \\\\\\\"conformance.json\\\\\\\").write_text(json.dumps({\\\\\\\"streams_events\\\\\\\": streams_events}) + \\\\\\\"\\\\\\\\n\\\\\\\")\\\\n    commit_all(root, \\\\\\\"a tenant-side adapter\\\\\\\")\\\\n\\\\n\\\\ndef approved_tenant(tmp_path: Path, build_prelude: str = \\\\\\\"\\\\\\\", **drive: Any) -> tuple[Path, Path]:\\\\n    root = make_tenant(tmp_path, \\\\\\\"build_valid\\\\\\\")\\\\n    add_forge(root, GREEN_FORGE)\\\\n    add_drive_table(root, **drive)\\\\n    tenant_adapter(root, build_prelude)\\\\n    bare = add_bare_remote(root, tmp_path)\\\\n    approve_item(root)\\\\n    commit_all(root, \\\\\\\"approved\\\\\\\")\\\\n    git(root, \\\\\\\"push\\\\\\\", \\\\\\\"-q\\\\\\\", \\\\\\\"origin\\\\\\\", \\\\\\\"HEAD:main\\\\\\\")\\\\n    return root, bare\\\\n\\\\n\\\\ndef passes_until(root: Path, pred: Any, seconds: float = 40, env: dict[str, str] | None = None) -> None:\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"Passes, spaced, until pred holds: how an operator's loop, the\\\\n    screen's poll, or a scheduler line would drive the item.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n    deadline = time.monotonic() + seconds\\\\n    full = dict(FAST)\\\\n    full.update(env or {})\\\\n    while time.monotonic() < deadline:\\\\n        run_attavo(root, \\\\\\\"drive\\\\\\\", \\\\\\\"1\\\\\\\", env=full)\\\\n        if pred():\\\\n            return\\\\n        time.sleep(0.5)\\\\n    raise AssertionError(\\\\\\\"condition not met in time\\\\\\\")\\\\n\\\\n\\\\ndef stop_of(root: Path, stage: str, nn: int) -> dict[str, Any]:\\\\n    rec = json.loads((records_dir(root) / f\\\\\\\"{stage}-{nn:02d}.json\\\\\\\").read_text())\\\\n    return dict(rec.get(\\\\\\\"stop\\\\\\\") or {})\\\\n\\\\n\\\\ndef counsel_records(root: Path) -> list[Path]:\\\\n    return record_files(root, \\\\\\\"counsel\\\\\\\")\\\\n\\\\n\\\\ndef test_a_transient_stop_retries_plainly_after_the_wait(tmp_path: Path) -> None:\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"Ruling C: a vendor's capacity, rate, or 5xx refusal is `transient`;\\\\n    the next pass starts the next attempt, asks counsel nothing, and\\\\n    waits [drive].retry_after_s first (#194's verify-01 paid for a\\\\n    counsel run and two presses on exactly this).\\\\\\\"\\\\\\\"\\\\\\\"\\\\n    prelude = ('  if [ ! -f \\\\\\\"$ATTAVO_RECORDS_DIR/build-01.json\\\\\\\" ]; then\\\\\\\\n'\\\\n               f\\\\\\\"    echo '{TRANSIENT_LINE}'\\\\\\\\n    exit 1\\\\\\\\n  fi\\\\\\\")\\\\n    root, bare = approved_tenant(tmp_path, prelude, retry_after_s=3)\\\\n    assert run_attavo(root, \\\\\\\"drive\\\\\\\", \\\\\\\"1\\\\\\\", env=FAST).returncode == 0\\\\n    wait_for(lambda: pushed(bare, \\\\\\\"build record for item 1 (build-01)\\\\\\\"))\\\\n    assert stop_of(root, \\\\\\\"build\\\\\\\", 1)[\\\\\\\"class\\\\\\\"] == \\\\\\\"transient\\\\\\\"\\\\n    assert stop_of(root, \\\\\\\"build\\\\\\\", 1)[\\\\\\\"signature\\\\\\\"] == \\\\\\\"API error: overloaded, retry after s\\\\\\\"\\\\n\\\\n    # inside the wait: a pass reads the level and starts nothing\\\\n    early = run_attavo(root, \\\\\\\"drive\\\\\\\", \\\\\\\"1\\\\\\\", env=FAST)\\\\n    assert early.returncode == 0 and \\\\\\\"retrying\\\\\\\" in early.stdout.lower(), early.stdout\\\\n    assert not (records_dir(root) / \\\\\\\"build-02.started\\\\\\\").exists()\\\\n\\\\n    passes_until(root, lambda: len(record_files(root, \\\\\\\"build\\\\\\\")) == 2, seconds=40)\\\\n    rec = latest_record(root, \\\\\\\"build\\\\\\\")\\\\n    assert rec[\\\\\\\"status\\\\\\\"] == \\\\\\\"pass\\\\\\\" and rec[\\\\\\\"retry_of\\\\\\\"] == \\\\\\\"build-01\\\\\\\", rec\\\\n    assert counsel_records(root) == []\\\\n\\\\n\\\\ndef test_died_and_hung_retry_on_the_next_pass(tmp_path: Path) -> None:\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"A recovered died attempt is retried by the pass after the one that\\\\n    recovered it, with no wait and no counsel; the retried record names\\\\n    what it retries.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n    prelude = ('  if [ ! -f \\\\\\\"$ATTAVO_RECORDS_DIR/build-01.json\\\\\\\" ]; then\\\\\\\\n'\\\\n               \\\\\\\"    kill -9 $PPID\\\\\\\\n    sleep 3\\\\\\\\n  fi\\\\\\\")\\\\n    root, bare = approved_tenant(tmp_path, prelude)\\\\n    assert run_attavo(root, \\\\\\\"drive\\\\\\\", \\\\\\\"1\\\\\\\", env=FAST).returncode == 0\\\\n    passes_until(root, lambda: (records_dir(root) / \\\\\\\"build-01.json\\\\\\\").exists(), seconds=30)\\\\n    assert stop_of(root, \\\\\\\"build\\\\\\\", 1)[\\\\\\\"class\\\\\\\"] == \\\\\\\"died\\\\\\\"\\\\n    passes_until(root, lambda: len(record_files(root, \\\\\\\"build\\\\\\\")) == 2, seconds=30)\\\\n    rec = latest_record(root, \\\\\\\"build\\\\\\\")\\\\n    assert rec[\\\\\\\"status\\\\\\\"] == \\\\\\\"pass\\\\\\\" and rec[\\\\\\\"retry_of\\\\\\\"] == \\\\\\\"build-01\\\\\\\", rec\\\\n    assert counsel_records(root) == []\\\\n\\\\n\\\\ndef test_a_red_check_becomes_a_returned_record_with_the_log_as_evidence(tmp_path: Path) -> None:\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"Ruling C amended (#206's build-01): a concluded red required check\\\\n    on a passed build's head is a returned review record, class returned,\\\\n    the red checks its signature; the next build's first feedback carries\\\\n    the check's log read through [forge].check_log_command; no operator\\\\n    act between approval and the passing review.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n    calls = tmp_path / \\\\\\\"forge-calls\\\\\\\"\\\\n    forge = tmp_path / \\\\\\\"forge.sh\\\\\\\"\\\\n    forge.write_text(f'#!/bin/sh\\\\\\\\nn=$(cat {calls} 2>/dev/null || echo 0)\\\\\\\\nn=$((n+1))\\\\\\\\nprintf %s \\\\\\\"$n\\\\\\\" > {calls}\\\\\\\\n'\\\\n                     'if [ \\\\\\\"$n\\\\\\\" = 1 ]; then printf \\\\\\\"typecheck failure\\\\\\\\\\\\\\\\n\\\\\\\"; else printf \\\\\\\"typecheck success\\\\\\\\\\\\\\\\n\\\\\\\"; fi\\\\\\\\n')\\\\n    check_log = tmp_path / \\\\\\\"checklog.sh\\\\\\\"\\\\n    check_log.write_text('#!/bin/sh\\\\\\\\nprintf \\\\\\\"attavo/x.py:12: error: Incompatible return value type\\\\\\\\\\\\\\\\n\\\\\\\"\\\\\\\\n')\\\\n    feedback_copy = tmp_path / \\\\\\\"feedback\\\\\\\"\\\\n    prelude = (f'  cp \\\\\\\"${{ATTAVO_FEEDBACK:-/dev/null}}\\\\\\\" \\\\\\\"{feedback_copy}.$(ls \\\\\\\"$ATTAVO_RECORDS_DIR\\\\\\\" | grep -c \\\\\\\"^build-.*\\\\\\\\\\\\\\\\.started$\\\\\\\")\\\\\\\" 2>/dev/null || true')\\\\n    root = make_tenant(tmp_path, \\\\\\\"build_valid\\\\\\\")\\\\n    toml = root / \\\\\\\"attavo.toml\\\\\\\"\\\\n    toml.write_text(toml.read_text() + f'\\\\\\\\n[forge]\\\\\\\\nchecks_command = \\\\\\\"sh {forge}\\\\\\\"\\\\\\\\ncheck_log_command = \\\\\\\"sh {check_log}\\\\\\\"\\\\\\\\n')\\\\n    commit_all(root, \\\\\\\"a forge that reads red once\\\\\\\")\\\\n    add_drive_table(root)\\\\n    tenant_adapter(root, prelude)\\\\n    bare = add_bare_remote(root, tmp_path)\\\\n    approve_item(root)\\\\n    commit_all(root, \\\\\\\"approved\\\\\\\")\\\\n    git(root, \\\\\\\"push\\\\\\\", \\\\\\\"-q\\\\\\\", \\\\\\\"origin\\\\\\\", \\\\\\\"HEAD:main\\\\\\\")\\\\n    approved_at = git(root, \\\\\\\"rev-parse\\\\\\\", \\\\\\\"HEAD\\\\\\\").strip()\\\\n\\\\n    passes_until(root, lambda: pushed(bare, \\\\\\\"verify record for item 1 (verify-01)\\\\\\\"), seconds=40)\\\\n    returned = latest_record(root, \\\\\\\"verify\\\\\\\")\\\\n    assert returned[\\\\\\\"status\\\\\\\"] == \\\\\\\"returned\\\\\\\", returned\\\\n    assert returned[\\\\\\\"stop\\\\\\\"][\\\\\\\"class\\\\\\\"] == \\\\\\\"returned\\\\\\\" and returned[\\\\\\\"stop\\\\\\\"][\\\\\\\"signature\\\\\\\"] == \\\\\\\"typecheck\\\\\\\", returned[\\\\\\\"stop\\\\\\\"]\\\\n\\\\n    passes_until(root, lambda: pushed(bare, \\\\\\\"build record for item 1 (build-02)\\\\\\\"), seconds=40)\\\\n    assert latest_record(root, \\\\\\\"build\\\\\\\")[\\\\\\\"retry_of\\\\\\\"] == \\\\\\\"build-01\\\\\\\"\\\\n    second = (feedback_copy.parent / (feedback_copy.name + \\\\\\\".2\\\\\\\")).read_text()\\\\n    assert \\\\\\\"typecheck\\\\\\\" in second and \\\\\\\"Incompatible return value type\\\\\\\" in second, second\\\\n\\\\n    passes_until(root, lambda: pushed(bare, \\\\\\\"verify record for item 1 (verify-02)\\\\\\\"), seconds=40)\\\\n    assert latest_record(root, \\\\\\\"verify\\\\\\\")[\\\\\\\"status\\\\\\\"] == \\\\\\\"pass\\\\\\\"\\\\n    authors = set(git(root, \\\\\\\"log\\\\\\\", \\\\\\\"--format=%an\\\\\\\", f\\\\\\\"{approved_at}..origin/main\\\\\\\").splitlines())\\\\n    assert authors <= {\\\\\\\"attavo driver\\\\\\\", \\\\\\\"attavo executor (fixture)\\\\\\\"}, authors\\\\n\\\\n\\\\ndef test_a_returned_review_retries_with_its_findings_and_counsels_on_the_second(tmp_path: Path) -> None:\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"A review that returns blocking findings is the returned family: the\\\\n    next build is handed the findings, counsel is not asked on the first\\\\n    return and is asked on the second identical one.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n    findings = tmp_path / \\\\\\\"findings.json\\\\\\\"\\\\n    findings.write_text(json.dumps([{\\\\\\\"title\\\\\\\": \\\\\\\"the helper is never called\\\\\\\", \\\\\\\"specimen\\\\\\\": \\\\\\\"x\\\\\\\", \\\\\\\"retires\\\\\\\": \\\\\\\"y\\\\\\\",\\\\n                                     \\\\\\\"rejection_test\\\\\\\": \\\\\\\"z\\\\\\\", \\\\\\\"severity\\\\\\\": \\\\\\\"blocking\\\\\\\"}]))\\\\n    feedback_copy = tmp_path / \\\\\\\"feedback\\\\\\\"\\\\n    prelude = (f'  cp \\\\\\\"${{ATTAVO_FEEDBACK:-/dev/null}}\\\\\\\" \\\\\\\"{feedback_copy}.$(ls \\\\\\\"$ATTAVO_RECORDS_DIR\\\\\\\" | grep -c \\\\\\\"^build-.*\\\\\\\\\\\\\\\\.started$\\\\\\\")\\\\\\\" 2>/dev/null || true')\\\\n    root, bare = approved_tenant(tmp_path, prelude)\\\\n    d = root / \\\\\\\"attavo\\\\\\\" / \\\\\\\"adapters\\\\\\\" / \\\\\\\"fixture\\\\\\\"\\\\n    run = (d / \\\\\\\"run\\\\\\\").read_text()\\\\n    verify_branch = ('if [ \\\\\\\"${ATTAVO_STAGE:-build}\\\\\\\" = verify ]; then\\\\\\\\n'\\\\n                     f'  printf \\\\\\\\'{{\\\\\\\"model\\\\\\\":\\\\\\\"fixture\\\\\\\",\\\\\\\"model_version\\\\\\\":null,\\\\\\\"adapter_version\\\\\\\":\\\\\\\"fixture-1\\\\\\\",\\\\\\\"tokens\\\\\\\":{{\\\\\\\"input\\\\\\\":1,\\\\\\\"output\\\\\\\":1}},\\\\\\\"cost_usd\\\\\\\":0.0,\\\\\\\"findings\\\\\\\":%s,\\\\\\\"tests_named\\\\\\\":[]}}\\\\\\\\\\\\\\\\n\\\\\\\\' \\\\\\\"$(cat {findings})\\\\\\\"\\\\\\\\n'\\\\n                     \\\\\\\"  exit 0\\\\\\\\nfi\\\\\\\\n\\\\\\\")\\\\n    (d / \\\\\\\"run\\\\\\\").write_text(run.replace(\\\\\\\"#!/bin/sh\\\\\\\\n\\\\\\\", \\\\\\\"#!/bin/sh\\\\\\\\n\\\\\\\" + verify_branch, 1))\\\\n    commit_all(root, \\\\\\\"a review that returns a blocking finding\\\\\\\")\\\\n    git(root, \\\\\\\"push\\\\\\\", \\\\\\\"-q\\\\\\\", \\\\\\\"origin\\\\\\\", \\\\\\\"HEAD:main\\\\\\\")\\\\n    manifest = root / \\\\\\\"attavo.toml\\\\\\\"\\\\n    manifest.write_text(manifest.read_text().replace('[executor]\\\\\\\\nbuild = \\\\\\\"fixture\\\\\\\"', '[executor]\\\\\\\\nbuild = \\\\\\\"fixture\\\\\\\"\\\\\\\\ncounsel = \\\\\\\"fixture\\\\\\\"'))\\\\n    commit_all(root, \\\\\\\"counsel configured\\\\\\\")\\\\n    git(root, \\\\\\\"push\\\\\\\", \\\\\\\"-q\\\\\\\", \\\\\\\"origin\\\\\\\", \\\\\\\"HEAD:main\\\\\\\")\\\\n\\\\n    passes_until(root, lambda: pushed(bare, \\\\\\\"verify record for item 1 (verify-01)\\\\\\\"), seconds=40)\\\\n    first = latest_record(root, \\\\\\\"verify\\\\\\\")\\\\n    assert first[\\\\\\\"status\\\\\\\"] != \\\\\\\"pass\\\\\\\" and first[\\\\\\\"stop\\\\\\\"][\\\\\\\"class\\\\\\\"] == \\\\\\\"returned\\\\\\\", first\\\\n    assert first[\\\\\\\"stop\\\\\\\"][\\\\\\\"signature\\\\\\\"] == \\\\\\\"the helper is never called\\\\\\\"\\\\n    assert counsel_records(root) == [], \\\\\\\"counsel is not asked on the first return\\\\\\\"\\\\n\\\\n    passes_until(root, lambda: pushed(bare, \\\\\\\"build record for item 1 (build-02)\\\\\\\"), seconds=40)\\\\n    assert latest_record(root, \\\\\\\"build\\\\\\\")[\\\\\\\"retry_of\\\\\\\"] == \\\\\\\"build-01\\\\\\\"\\\\n    assert \\\\\\\"the helper is never called\\\\\\\" in (feedback_copy.parent / (feedback_copy.name + \\\\\\\".2\\\\\\\")).read_text()\\\\n\\\\n    passes_until(root, lambda: pushed(bare, \\\\\\\"verify record for item 1 (verify-02)\\\\\\\"), seconds=40)\\\\n    passes_until(root, lambda: counsel_records(root) != [], seconds=20)\\\\n    assert latest_record(root, \\\\\\\"counsel\\\\\\\")[\\\\\\\"record\\\\\\\"] == \\\\\\\"verify-02\\\\\\\"\\\\n\\\\n\\\\ndef test_counsels_verdict_routes_the_next_pass(tmp_path: Path) -> None:\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"Counsel steers: `answer` starts the next attempt with the answer as\\\\n    its steer (recorded in `steer`); `patch` starts nothing and the\\\\n    report reads waiting on the issue; `person` starts nothing.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n    responses = tmp_path / \\\\\\\"counsel\\\\\\\"\\\\n    responses.mkdir()\\\\n    for verdict in (\\\\\\\"answer\\\\\\\", \\\\\\\"patch\\\\\\\", \\\\\\\"person\\\\\\\"):\\\\n        (responses / f\\\\\\\"{verdict}.json\\\\\\\").write_text(json.dumps({\\\\n            \\\\\\\"model\\\\\\\": \\\\\\\"fixture\\\\\\\", \\\\\\\"model_version\\\\\\\": None, \\\\\\\"adapter_version\\\\\\\": \\\\\\\"fixture-1\\\\\\\",\\\\n            \\\\\\\"tokens\\\\\\\": {\\\\\\\"input\\\\\\\": 1, \\\\\\\"output\\\\\\\": 1}, \\\\\\\"cost_usd\\\\\\\": 0.0, \\\\\\\"class\\\\\\\": \\\\\\\"question\\\\\\\", \\\\\\\"verdict\\\\\\\": verdict,\\\\n            \\\\\\\"citations\\\\\\\": [{\\\\\\\"kind\\\\\\\": \\\\\\\"instruction\\\\\\\", \\\\\\\"path\\\\\\\": \\\\\\\"specs/1/spec.md\\\\\\\", \\\\\\\"symbol\\\\\\\": \\\\\\\"problem\\\\\\\"}],\\\\n            \\\\\\\"proposal\\\\\\\": {\\\\\\\"ruling_text\\\\\\\": \\\\\\\"use the base tree\\\\\\\" if verdict == \\\\\\\"answer\\\\\\\" else None,\\\\n                         \\\\\\\"patch\\\\\\\": \\\\\\\"the fixture cannot read overlays\\\\\\\" if verdict == \\\\\\\"patch\\\\\\\" else None,\\\\n                         \\\\\\\"question\\\\\\\": None if verdict != \\\\\\\"person\\\\\\\" else \\\\\\\"which overlay wins?\\\\\\\"}}))\\\\n    for verdict, expect_attempt in ((\\\\\\\"answer\\\\\\\", 2), (\\\\\\\"patch\\\\\\\", 1), (\\\\\\\"person\\\\\\\", 1)):\\\\n        sub = tmp_path / verdict\\\\n        sub.mkdir()\\\\n        root, bare = approved_tenant(sub)\\\\n        manifest = root / \\\\\\\"attavo.toml\\\\\\\"\\\\n        manifest.write_text(manifest.read_text().replace('[executor]\\\\\\\\nbuild = \\\\\\\"fixture\\\\\\\"', '[executor]\\\\\\\\nbuild = \\\\\\\"fixture\\\\\\\"\\\\\\\\ncounsel = \\\\\\\"fixture\\\\\\\"'))\\\\n        commit_all(root, \\\\\\\"counsel configured\\\\\\\")\\\\n        git(root, \\\\\\\"push\\\\\\\", \\\\\\\"-q\\\\\\\", \\\\\\\"origin\\\\\\\", \\\\\\\"HEAD:main\\\\\\\")\\\\n        env = {\\\\\\\"ATTAVO_FIXTURE_QUESTION\\\\\\\": \\\\\\\"which overlay wins?\\\\\\\",\\\\n               \\\\\\\"ATTAVO_FIXTURE_COUNSEL_RESPONSE\\\\\\\": str(responses / f\\\\\\\"{verdict}.json\\\\\\\")}\\\\n        passes_until(root, lambda: pushed(bare, \\\\\\\"build record for item 1 (build-01)\\\\\\\"), seconds=40, env=env)\\\\n        assert latest_record(root, \\\\\\\"counsel\\\\\\\")[\\\\\\\"verdict\\\\\\\"] == verdict\\\\n        for _ in range(3):\\\\n            run_attavo(root, \\\\\\\"drive\\\\\\\", \\\\\\\"1\\\\\\\", env={**FAST, **env})\\\\n            time.sleep(0.5)\\\\n        if expect_attempt == 2:\\\\n            passes_until(root, lambda: len(record_files(root, \\\\\\\"build\\\\\\\")) == 2, seconds=30, env={**env, \\\\\\\"ATTAVO_FIXTURE_QUESTION\\\\\\\": \\\\\\\"\\\\\\\"})\\\\n            assert latest_record(root, \\\\\\\"build\\\\\\\")[\\\\\\\"steer\\\\\\\"] == \\\\\\\"counsel-01\\\\\\\"\\\\n        else:\\\\n            assert len(record_files(root, \\\\\\\"build\\\\\\\")) == 1, verdict\\\\n            out = report(root)\\\\n            assert out[\\\\\\\"state\\\\\\\"] == \\\\\\\"stopped\\\\\\\", out\\\\n            if verdict == \\\\\\\"patch\\\\\\\":\\\\n                assert \\\\\\\"waiting on\\\\\\\" in out[\\\\\\\"says\\\\\\\"], out[\\\\\\\"says\\\\\\\"]\\\\n\\\\n\\\\ndef test_a_persons_stop_is_never_retried(tmp_path: Path) -> None:\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"A question with no counsel configured, a claims-boundary stop, and\\\\n    an environment refusal are a person's: three passes over each start\\\\n    nothing.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n    cases = {\\\\n        \\\\\\\"question\\\\\\\": ({\\\\\\\"ATTAVO_FIXTURE_QUESTION\\\\\\\": \\\\\\\"which overlay wins?\\\\\\\"}, \\\\\\\"\\\\\\\"),\\\\n        \\\\\\\"claims\\\\\\\": ({\\\\\\\"ATTAVO_FIXTURE_WRITE\\\\\\\": \\\\\\\"outside/claims.txt\\\\\\\"}, \\\\\\\"\\\\\\\"),\\\\n    }\\\\n    for name, (env, prelude) in cases.items():\\\\n        sub = tmp_path / name\\\\n        sub.mkdir()\\\\n        root, bare = approved_tenant(sub, prelude)\\\\n        full = {**FAST, **env}\\\\n        run_attavo(root, \\\\\\\"drive\\\\\\\", \\\\\\\"1\\\\\\\", env=full)\\\\n        wait_for(lambda: pushed(bare, \\\\\\\"build record for item 1 (build-01)\\\\\\\"))\\\\n        first = latest_record(root, \\\\\\\"build\\\\\\\")\\\\n        assert first[\\\\\\\"status\\\\\\\"] != \\\\\\\"pass\\\\\\\", (name, first)\\\\n        for _ in range(3):\\\\n            run_attavo(root, \\\\\\\"drive\\\\\\\", \\\\\\\"1\\\\\\\", env=full)\\\\n            time.sleep(0.3)\\\\n        assert len(record_files(root, \\\\\\\"build\\\\\\\")) == 1, name\\\\n        assert not (records_dir(root) / \\\\\\\"build-02.started\\\\\\\").exists(), name\\\\n        assert report(root)[\\\\\\\"state\\\\\\\"] == \\\\\\\"stopped\\\\\\\"\\\\n\\\\n\\\\ndef test_identical_failures_stop_early_and_the_budget_holds(tmp_path: Path) -> None:\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"Two attempts ending with the identical signature stop the stage at\\\\n    two; two different signatures proceed to a third; a fourth never\\\\n    starts.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n    same = ('  at=\\\\\\\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\\\\\\\"\\\\\\\\n'\\\\n            '  printf \\\\\\\\'{\\\\\\\"at\\\\\\\":\\\\\\\"%s\\\\\\\",\\\\\\\"kind\\\\\\\":\\\\\\\"tool_call\\\\\\\",\\\\\\\"text\\\\\\\":\\\\\\\"fixture-tool waiting on lock 4471\\\\\\\"}\\\\\\\\\\\\\\\\n\\\\\\\\' \\\\\\\"$at\\\\\\\" >> \\\\\\\"$ATTAVO_EVENTS\\\\\\\"\\\\\\\\n'\\\\n            \\\\\\\"  kill -9 $PPID\\\\\\\\n  sleep 3\\\\\\\")\\\\n    root, _bare = approved_tenant(tmp_path / \\\\\\\"same\\\\\\\", same)\\\\n    passes_until(root, lambda: len(record_files(root, \\\\\\\"build\\\\\\\")) == 2, seconds=60)\\\\n    for _ in range(6):\\\\n        run_attavo(root, \\\\\\\"drive\\\\\\\", \\\\\\\"1\\\\\\\", env=FAST)\\\\n        time.sleep(0.5)\\\\n    assert len(record_files(root, \\\\\\\"build\\\\\\\")) == 2\\\\n    assert not (records_dir(root) / \\\\\\\"build-03.started\\\\\\\").exists()\\\\n    assert stop_of(root, \\\\\\\"build\\\\\\\", 1)[\\\\\\\"signature\\\\\\\"] == stop_of(root, \\\\\\\"build\\\\\\\", 2)[\\\\\\\"signature\\\\\\\"]\\\\n\\\\n    differ = ('  at=\\\\\\\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\\\\\\\"\\\\\\\\n'\\\\n              '  n=$(ls \\\\\\\"$ATTAVO_RECORDS_DIR\\\\\\\" | grep -c \\\\\\\"^build-.*\\\\\\\\\\\\\\\\.started$\\\\\\\")\\\\\\\\n'\\\\n              '  printf \\\\\\\\'{\\\\\\\"at\\\\\\\":\\\\\\\"%s\\\\\\\",\\\\\\\"kind\\\\\\\":\\\\\\\"tool_call\\\\\\\",\\\\\\\"text\\\\\\\":\\\\\\\"fixture-tool step %s of the plan\\\\\\\"}\\\\\\\\\\\\\\\\n\\\\\\\\' \\\\\\\"$at\\\\\\\" \\\\\\\"$(printf \\\\\\\"%s\\\\\\\" \\\\\\\"$n\\\\\\\" | tr 0-9 a-j)\\\\\\\" >> \\\\\\\"$ATTAVO_EVENTS\\\\\\\"\\\\\\\\n'\\\\n              \\\\\\\"  kill -9 $PPID\\\\\\\\n  sleep 3\\\\\\\")\\\\n    root2, _ = approved_tenant(tmp_path / \\\\\\\"differ\\\\\\\", differ)\\\\n    passes_until(root2, lambda: len(record_files(root2, \\\\\\\"build\\\\\\\")) == 3, seconds=90)\\\\n    for _ in range(6):\\\\n        run_attavo(root2, \\\\\\\"drive\\\\\\\", \\\\\\\"1\\\\\\\", env=FAST)\\\\n        time.sleep(0.5)\\\\n    assert len(record_files(root2, \\\\\\\"build\\\\\\\")) == 3\\\\n    assert not (records_dir(root2) / \\\\\\\"build-04.started\\\\\\\").exists()\\\\n    out = report(root2)\\\\n    assert out[\\\\\\\"state\\\\\\\"] == \\\\\\\"stopped\\\\\\\" and len(out[\\\\\\\"attempts\\\\\\\"]) == 3, out\\\\n\\\\n\\\\ndef test_every_marker_spends_the_budget(tmp_path: Path) -> None:\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"A recovered attempt counts: with attempts = 2, one died attempt and\\\\n    one transient attempt spend the budget and a third never starts,\\\\n    though the two signatures differ.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n    prelude = ('  n=$(ls \\\\\\\"$ATTAVO_RECORDS_DIR\\\\\\\" | grep -c \\\\\\\"^build-.*\\\\\\\\\\\\\\\\.started$\\\\\\\")\\\\\\\\n'\\\\n               '  if [ \\\\\\\"$n\\\\\\\" = 1 ]; then kill -9 $PPID; sleep 3; fi\\\\\\\\n'\\\\n               f'  if [ \\\\\\\"$n\\\\\\\" = 2 ]; then echo \\\\\\\\'{TRANSIENT_LINE}\\\\\\\\'; exit 1; fi')\\\\n    root, _ = approved_tenant(tmp_path, prelude, attempts=2)\\\\n    passes_until(root, lambda: len(record_files(root, \\\\\\\"build\\\\\\\")) == 2, seconds=60)\\\\n    for _ in range(6):\\\\n        run_attavo(root, \\\\\\\"drive\\\\\\\", \\\\\\\"1\\\\\\\", env=FAST)\\\\n        time.sleep(0.5)\\\\n    assert len(record_files(root, \\\\\\\"build\\\\\\\")) == 2\\\\n    assert not (records_dir(root) / \\\\\\\"build-03.started\\\\\\\").exists()\\\\n    out = report(root)\\\\n    assert out[\\\\\\\"state\\\\\\\"] == \\\\\\\"stopped\\\\\\\" and out[\\\\\\\"signatures_match\\\\\\\"] is False, out\\\\n    assert any(\\\\\\\"again\\\\\\\" in r for r in out[\\\\\\\"rulings_available\\\\\\\"]), out\\\\n\\\\n\\\\ndef test_a_stage_past_its_ceiling_is_hung_by_the_ceiling(tmp_path: Path) -> None:\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"A worker alive past [drive.build].ceiling_s is terminated and\\\\n    recorded hung with bound ceiling; an adapter that declares it does\\\\n    not stream events is never judged by event age.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n    root, bare = approved_tenant(tmp_path, \\\\\\\"  sleep 20\\\\\\\", build_ceiling_s=2)\\\\n    d = root / \\\\\\\"attavo\\\\\\\" / \\\\\\\"adapters\\\\\\\" / \\\\\\\"fixture\\\\\\\"\\\\n    (d / \\\\\\\"conformance.json\\\\\\\").write_text(json.dumps({\\\\\\\"streams_events\\\\\\\": False}) + \\\\\\\"\\\\\\\\n\\\\\\\")\\\\n    commit_all(root, \\\\\\\"an adapter that does not stream\\\\\\\")\\\\n    git(root, \\\\\\\"push\\\\\\\", \\\\\\\"-q\\\\\\\", \\\\\\\"origin\\\\\\\", \\\\\\\"HEAD:main\\\\\\\")\\\\n    assert run_attavo(root, \\\\\\\"drive\\\\\\\", \\\\\\\"1\\\\\\\", env=FAST).returncode == 0\\\\n    time.sleep(3)\\\\n    out = report(root)\\\\n    assert out[\\\\\\\"state\\\\\\\"] == \\\\\\\"owes-recovery\\\\\\\", out\\\\n    assert \\\\\\\"event\\\\\\\" not in out[\\\\\\\"says\\\\\\\"], out[\\\\\\\"says\\\\\\\"]\\\\n    passes_until(root, lambda: pushed(bare, \\\\\\\"build record for item 1 (build-01)\\\\\\\"), seconds=20)\\\\n    stop = stop_of(root, \\\\\\\"build\\\\\\\", 1)\\\\n    assert stop[\\\\\\\"class\\\\\\\"] == \\\\\\\"hung\\\\\\\" and stop[\\\\\\\"bound\\\\\\\"] == \\\\\\\"ceiling\\\\\\\", stop\\\\n\\\\n\\\\ndef test_again_resets_a_spent_budget_only(tmp_path: Path) -> None:\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"--again on a stage whose budget is spent starts the next attempt\\\\n    and records that in the marker; inside the budget it is a no-op that\\\\n    says the pass retries on its own.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n    same = ('  at=\\\\\\\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\\\\\\\"\\\\\\\\n'\\\\n            '  printf \\\\\\\\'{\\\\\\\"at\\\\\\\":\\\\\\\"%s\\\\\\\",\\\\\\\"kind\\\\\\\":\\\\\\\"tool_call\\\\\\\",\\\\\\\"text\\\\\\\":\\\\\\\"fixture-tool waiting on lock\\\\\\\"}\\\\\\\\\\\\\\\\n\\\\\\\\' \\\\\\\"$at\\\\\\\" >> \\\\\\\"$ATTAVO_EVENTS\\\\\\\"\\\\\\\\n'\\\\n            \\\\\\\"  kill -9 $PPID\\\\\\\\n  sleep 3\\\\\\\")\\\\n    root, _ = approved_tenant(tmp_path, same)\\\\n    passes_until(root, lambda: len(record_files(root, \\\\\\\"build\\\\\\\")) == 1, seconds=30)\\\\n    inside = run_attavo(root, \\\\\\\"drive\\\\\\\", \\\\\\\"1\\\\\\\", \\\\\\\"--again\\\\\\\", env=FAST)\\\\n    assert inside.returncode == 0 and \\\\\\\"retries on its own\\\\\\\" in inside.stdout, inside.stdout\\\\n    passes_until(root, lambda: len(record_files(root, \\\\\\\"build\\\\\\\")) == 2, seconds=60)\\\\n    for _ in range(3):\\\\n        run_attavo(root, \\\\\\\"drive\\\\\\\", \\\\\\\"1\\\\\\\", env=FAST)\\\\n        time.sleep(0.5)\\\\n    assert len(record_files(root, \\\\\\\"build\\\\\\\")) == 2\\\\n    again = run_attavo(root, \\\\\\\"drive\\\\\\\", \\\\\\\"1\\\\\\\", \\\\\\\"--again\\\\\\\", env=FAST)\\\\n    assert again.returncode == 0 and \\\\\\\"Build started\\\\\\\" in again.stdout, again.stdout\\\\n    marker = json.loads((records_dir(root) / \\\\\\\"build-03.started\\\\\\\").read_text())\\\\n    assert marker.get(\\\\\\\"again_by\\\\\\\"), marker\\\\n\\\\n\\\\ndef test_adapters_class_transient() -> None:\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"The fixture, claude-code and codex adapters put class transient on\\\\n    the report line for a capacity, rate, or 5xx refusal: each adapter's\\\\n    conformance.json names the situation and the product's own stop\\\\n    classes carry it.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n    from attavo.stops import RETRYABLE_CLASSES, STOP_CLASSES\\\\n    assert \\\\\\\"transient\\\\\\\" in STOP_CLASSES and \\\\\\\"returned\\\\\\\" in STOP_CLASSES\\\\n    assert RETRYABLE_CLASSES == (\\\\\\\"died\\\\\\\", \\\\\\\"hung\\\\\\\", \\\\\\\"transient\\\\
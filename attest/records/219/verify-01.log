avo/drive.py:747:    if spent >= attempts_budget(m):\nattavo/drive.py:749:    if _signatures_match(records_dir, stage):\nattavo/drive.py:751:    if stop_class in RETRYABLE_CLASSES:\nattavo/drive.py:760:    counsel = counsel_record_for(records_dir, stage, attempt)\nattavo/drive.py:761:    if counsel is not None and counsel.get(\"verdict\") == \"answer\":\nattavo/drive.py:763:        counsel_attempts = parse_attempts(records_dir, \"counsel\")\nattavo/drive.py:764:        matches = [n for n, rec in counsel_attempts.items() if rec.get(\"record\") == target]\nattavo/drive.py:766:            return RetryState(True, None, f\"counsel-{max(matches):02d}\", target_stage)\nattavo/drive.py:781:    forces the next attempt, named again_by in its marker, when it would\nattavo/drive.py:803:            return _advance_again(root, m, item_id, state.target_stage, r[\"head\"], again_by=True), r\n            beat.touch()\n\n    beat_thread = threading.Thread(target=_tick, daemon=True)\n    beat_thread.start()\n    try:\n        rc = cmd_build([item_id]) if stage == \"build\" else cmd_verify([item_id])\n    finally:\n        stop_beat.set()\n        beat_thread.join()\n\n    after = latest_attempt_path(records_dir, stage)\n    if after is None or after == before:\n        # Refused before writing anything at all (e.g. no adapter\n        # configured) -- the stage command already printed why.\n        return rc if rc != 0 else 1\n\n    record = cast(dict[str, Any], latest_record(records_dir, stage))\n    status_out = record.get(\"status\")\n    to_commit = [after]\n    if status_out != \"pass\":\n        stop = record.get(\"stop\") or {}\n        state = retry_state(root, m, records_dir, stage, stop.get(\"class\"),\n                            int(after.stem.rsplit(\"-\", 1)[1]))\n        # R3: a stop the next plain pass would already retry -- now, or\n        # once its transient wait elapses -- asks counsel nothing and\n        # files nothing (#194's own verify-01, replayed as this item's\n        # rejection fixture, paid for exactly this on a vendor's own\n        # capacity error). Counsel reads it, as before, the moment that\n        # is no longer true: the budget is spent, the early stop fired,\n        # or the class was never a plain retry's to begin with.\n        if not (state.eligible or state.waiting_s is not None):\n            counsel_before = latest_attempt_path(records_dir, \"counsel\")\n            cmd_counsel([item_id])\n            counsel_after = latest_attempt_path(records_dir, \"counsel\")\n            if counsel_after is not None and counsel_after != counsel_before:\n                to_commit.append(counsel_after)\n            # file-stops is its own idempotent read of the item's records,\n            # so calling it here on every run that wrote a non-pass record\n            # is safe to call again on a later run: an already-filed\n            # stop's own marker is what stops it from being filed twice.\n            cmd_file_stops([item_id])\n\n    message = f\"attavo: {stage} record for item {item_id} ({after.stem})\"\n    try:\n        commit_record(root, to_commit, message)\n    except RuntimeError as exc:\n        print(f\"attavo drive: stopped: could not commit the {stage} record: {exc}\")\n        return 1\n\n    if has_origin(root):\n        ok, err = push_record_commit(root, branch)\n        if not ok:\n            print(f\"attavo drive: stopped: could not push the {stage} record: {err}\")\n            return 1\n    else:\n        print(f\"attavo drive: note: no origin remote; {after.name} is committed, not pushed\")\n\n    if status_out == \"halted\":\n        question = (record.get(\"halted\") or {}).get(\"question\")\n        print(f\"attavo drive: stopped: {stage} halted: {question} ({after.name}); \"\n              f\"pushed to {branch}\")\n    elif status_out != \"pass\":\n        reason = record.get(\"refusal\") or status_out\n        print(f\"attavo drive: stopped: {stage} {status_out}: {reason} ({after.name}); \"\n              f\"pushed to {branch}\")\n    else:\n        print(f\"attavo drive: pushed {after.name} to {branch}\")\n    return rc\n\n\ndef cmd_worker(argv: list[str]) -> int:\n    \"\"\"`attavo worker N <build|verify> NN`: the detached child a pass\n    starts once its marker is pushed -- the lease held, the attempt is\n    this worker's to run. Its own session (start_new_session, set by the\n    pass that spawns it); its stdout and stderr are the pass's own\n    redirect, to <git-dir>/attavo/<stage>-NN.worker.log.\"\"\"\n    cast(io.TextIOWrapper, sys.stdout).reconfigure(line_buffering=True)\n    if len(argv) != 3:\n        print(\"attavo worker: usage: attavo worker N <build|verify> NN\", file=sys.stderr)\n        return 2\n    item_id, stage, nn_text = argv\n    if stage not in (\"build\", \"verify\"):\n        print(f\"attavo worker: {stage!r} is not build or verify\", file=sys.stderr)\n        return 2\n    try:\n        nn = int(nn_text)\n    except ValueError:\n        print(f\"attavo worker: {nn_text!r} is not an attempt number\", file=sys.stderr)\n        return 2\n    return _stage_body(item_id, stage, nn)\n\n\n# --- the pass's own two acts: start a stage (the lease), and recover\n# exactly the one invocation the report names owed one. ---\n\ndef _start_stage(root: Path, m: dict[str, Any], item_id: str, stage: str,\n                 forge_checks: dict[str, Any] | None, again_by: bool = False) -> int:\n    \"\"\"The lease (ruling A): the marker, committed and pushed as a plain\n    fast-forward with no merge and no retry (push_lease). Lost to another\n    pass, or refused outright by the remote, both undo the marker commit\n    here (git reset --hard) so this checkout carries no half-taken\n    attempt either way; only a pushed lease starts the worker. On a\n    review, forge_checks is the checks this same pass already read on\n    the pre-marker head (ruling B) -- written to\n    <git-dir>/attavo/verify-NN.forge-checks.json and named in\n    ATTAVO_FORGE_CHECKS, so the worker's own `attavo verify` reads it\n    instead of polling. again_by (R3) is true only when `--again` is what\n    started this attempt, past a budget already spent or an early stop\n    -- named in the marker, never on an ordinary or plainly-retried\n    attempt.\"\"\"\n    records_dir = root / m[\"paths\"][\"records\"] / item_id\n    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n    nn = next_attempt_number(records_dir, stage)\n    marker = write_invocation_marker(root, records_dir, stage, nn, again_by=again_by)\n    try:\n        commit_record(root, [marker], f\"attavo: {stage} invocation {nn:02d} started for item {item_id}\")\n    nn = max(attempts)\n    return f\"{stage}-{nn:02d}\", attempts[nn]\n\n\ndef _filed(records_dir: Path, stem: str) -> str | None:\n    marker = records_dir / f\"{stem}.filed\"\n    try:\n        text = marker.read_text().strip()\n    except OSError:\n        return None\n    return text or None\n\n\ndef _counsel_of(records_dir: Path, stem: str) -> tuple[str, CounselRecord] | None:\n    \"\"\"The latest counsel record that read the stop named stem.\"\"\"\n    attempts = parse_attempts(records_dir, \"counsel\")\n    for nn in sorted(attempts, reverse=True):\n        if attempts[nn].get(\"record\") == stem:\n            return f\"counsel-{nn:02d}\", attempts[nn]\n    return None\n\n\ndef _stopped(root: Path, m: dict[str, Any], r: DriveReport, records_dir: Path, stage: str,\n            stem: str, record: dict[str, Any]) -> DriveReport:\n    stop = record.get(\"stop\") or {}\n    stop_class = stop.get(\"class\")\n    attempt = int(stem.rsplit(\"-\", 1)[1])\n    r[\"state\"], r[\"kind\"], r[\"stage\"] = \"stopped\", \"yours\", stage\n    r[\"attempt\"], r[\"record\"], r[\"stop_class\"] = attempt, stem, stop_class\n    r[\"filed\"] = _filed(records_dir, stem)\n\n    # R3: every attempt of this stage, side by side -- the exhaustion\n    # report's own comparison, printed whether or not the budget is\n    # actually spent yet, since a person reading --report wants the same\n    # picture drive itself would act on.\n    attempts = parse_attempts(records_dir, stage)\n    rows: list[dict[str, Any]] = [\n        {\"attempt\": nn, \"class\": (rec.get(\"stop\") or {}).get(\"class\"),\n         \"signature\": (rec.get(\"stop\") or {}).get(\"signature\"),\n         \"bound\": (rec.get(\"stop\") or {}).get(\"bound\"),\n         \"wall_clock_s\": rec.get(\"wall_clock_s\"), \"cost_usd\": rec.get(\"cost_usd\")}\n        for nn, rec in sorted(attempts.items())]\n    r[\"attempts\"] = rows\n    last_two = [row[\"signature\"] for row in rows[-2:]]\n    signatures_match = bool(len(last_two) == 2 and last_two[0] is not None and last_two[0] == last_two[1])\n    r[\"signatures_match\"] = signatures_match\n    r[\"rulings_available\"] = [\n        \"attavo drive N --again: reset the budget and start the next attempt\"\n        + (\" (unlikely to help: the last two attempts failed the same way)\" if signatures_match else \"\"),\n        \"amend the spec (moves the approval)\"]\n\n    state = retry_state(root, m, records_dir, stage, stop_class, attempt)\n    how = f\"as {stop_class}\" if stop_class else f\"({record.get('status')})\"\n    if state.waiting_s is not None:\n        r[\"kind\"] = \"waits\"\n        says = (f\"{_WORD[stage].capitalize()} attempt {attempt:02d} stopped {how}; retrying \"\n                f\"{_WORD[stage]} in {int(state.waiting_s)} s\")\n    elif state.eligible:\n        r[\"kind\"] = \"acts\"\n        says = f\"{_WORD[stage].capitalize()} attempt {attempt:02d} stopped {how}; the next pass retries it\"\n    else:\n        says = f\"Needs you: {_WORD[stage]} attempt {attempt:02d} stopped {how}\"\n    counsel = _counsel_of(records_dir, stem)\n    if counsel:\n        r[\"counsel\"] = counsel[0]\n        verdict = str(counsel[1].get(\"verdict\"))\n        verdict_says = _COUNSEL_SAYS.get(verdict)\n        says += f\"; {counsel[0]} {verdict_says or 'could not read it'}\"\n        if verdict == \"patch\":\n            says += f\"; waiting on {r['filed'] or 'the issue counsel filed'}\"\n    if r[\"filed\"] and \"waiting on\" not in says:\n        says += f\"; filed as {r['filed']}\"\n    r[\"says\"] = says\n    return r\n\n\ndef _invocation(r: DriveReport, reading: InvocationReading, info: dict[str, Any],\n                bound: int | None) -> DriveReport:\n    stage, nn, _log, _last_at, age, cls, crossed = reading\n    r[\"stage\"], r[\"attempt\"], r[\"stop_class\"] = stage, nn, None if cls == \"running\" else cls\n    r[\"since\"] = info.get(\"at\") if isinstance(info.get(\"at\"), str) else None\n    r[\"last_event_age_s\"] = None if age is None else int(age)\n    word = _WORD[stage]\n    if cls == \"running\":\n        r[\"state\"], r[\"kind\"] = \"running\", \"waits\"\n        r[\"says\"] = (f\"{word.capitalize()} running since {r['since'] or 'an unknown time'}; \"\n                     f\"nothing to do until it finishes\")\n    else:\n        r[\"state\"], r[\"kind\"] = \"owes-recovery\", \"acts\"\n        if cls == \"hung\" and crossed == \"ceiling\":\n            # R3: a stage past its own ceiling is hung by wall clock\n            # alone -- never worded in terms of event age, which an\n            # adapter that streams no events never had to begin with.\n            r[\"says\"] = (f\"{word.capitalize()} attempt {nn:02d} is alive {r['last_event_age_s']} s \"\n                         f\"after it began, past its ceiling; recovery would end it and record it \"\n                         f\"as hung\")\n        elif cls == \"hung\":\n            r[\"says\"] = (f\"{word.capitalize()} attempt {nn:02d} is alive but has had no event for \"\n                         f\"{r['last_event_age_s']} s (bound {bound} s); recovery would end it and \"\n                         f\"record it as hung\")\n        else:\n            r[\"says\"] = (f\"{word.capitalize()} attempt {nn:02d} is gone and wrote no record; \"\n                         f\"recovery would record it as died\")\n    return r\n\n\n            if path is not None and any(path == e or path.startswith(e + \"/\") for e in skipped):\n                path = None\n            if path is not None and path not in stub_lines:\n                stub_file = stub_dir / path\n                stub_lines[path] = (\n                    {text.rstrip() for text in stub_file.read_text(errors=\"replace\").splitlines()}\n                    if stub_file.is_file() else set())\n        elif line.startswith(\"@@\"):\n            in_hunk = True\n    return shipped / added if added else None\n\n\ndef _returned_stop(forge_checks: dict[str, Any]) -> dict[str, Any]:\n    \"\"\"R3 (ruling C amended): a review the forge returned because a\n    required check concluded red is class returned, retryable -- the\n    next build attempt is handed the evidence -- signed by the sorted\n    names of the checks that concluded red. A review returned because\n    the checks have not concluded at all yet (nothing to sign) stays\n    forge-unconcluded, as before -- there is no rejection to hand a\n    build, only a wait that already has its own bound (the drive\n    forge-poll bound, unchanged by this item).\"\"\"\n    conclusions = forge_checks.get(\"conclusions\") or []\n    red = sorted(c[\"name\"] for c in conclusions\n                if c[\"conclusion\"] not in FORGE_OK_CONCLUSIONS\n                and c[\"conclusion\"] not in FORGE_UNCONCLUDED_STATUSES)\n    unconcluded = [c for c in conclusions if c[\"conclusion\"] in FORGE_UNCONCLUDED_STATUSES]\n    if red and not unconcluded:\n        detail = \", \".join(f\"{c['name']} {c['conclusion']}\" for c in conclusions if c[\"name\"] in red)\n        return {\"class\": \"returned\", \"provenance\": \"tenant\", \"detail\": detail,\n               \"signature\": signature_of(\" \".join(red)), \"bound\": None}\n    stop = dict(derive_stop(\"returned\") or {})\n    return {**stop, \"signature\": None, \"bound\": None}\n\n\ndef _verify_retry_seed(records_dir: Path, build_sha: str) -> tuple[str | None, str | None]:\n    \"\"\"(retry_of, steer): a plain retry of verify itself -- died, hung,\n    transient, or any other non-returned stop counsel answered -- names\n    the prior verify attempt it retries, the same way build's own retry\n    does. A returned review is never this: its own fix is a new build,\n    not a new verify, so build.py's _retry_seed is what names it as\n    retry_of instead.\"\"\"\n    attempts = parse_attempts(records_dir, \"verify\")\n    if not attempts:\n        return None, None\n    nn = max(attempts)\n    prior = attempts[nn]\n    stop = cast(\"dict[str, Any]\", prior.get(\"stop\") or {})\n    if prior.get(\"status\") == \"pass\" or prior.get(\"build_sha\") != build_sha or stop.get(\"class\") == \"returned\":\n        return None, None\n    prior_stem = f\"verify-{nn:02d}\"\n    counsel = counsel_record_for(records_dir, \"verify\", nn)\n    steer = None\n    if counsel is not None and counsel.get(\"verdict\") == \"answer\":\n        counsel_attempts = parse_attempts(records_dir, \"counsel\")\n        matches = [n for n, rec in counsel_attempts.items() if rec.get(\"record\") == prior_stem]\n        if matches:\n            steer = f\"counsel-{max(matches):02d}\"\n    return prior_stem, steer\n\n\ndef cmd_verify(argv: list[str]) -> int:\n    root = Path(\".\").resolve()\n    item_id = argv[0] if argv else derive_item_id(root)\n    if not item_id:\n        print(\"attavo verify: cannot derive item id; pass N or run on an attavo/N-* branch\",\n              file=sys.stderr)\n        return 2\n    m = read_manifest(root)\n    if m is None:\n        print(f\"attavo verify: no {MANIFEST} at {root}\", file=sys.stderr)\n        return 2\n\n    specs_rel = m[\"paths\"][\"specs\"]\n    records_rel = m[\"paths\"][\"records\"]\n    item_records_dir = root / records_rel / item_id\n\n    latest_build = latest_record(item_records_dir, \"build\")\n    if latest_build is None:\n        print(f\"attavo verify: refused: no build record for item {item_id}\")\n        return 1\n    if latest_build.get(\"status\") != \"pass\":\n        print(f\"attavo verify: refused: latest build record is \"\n              f\"{latest_build.get('status')!r}, not pass\")\n        return 1\n\n    forge_cfg = m.get(\"forge\") or {}\n    checks_command = forge_cfg.get(\"checks_command\")\n    if not checks_command:\n        print(\"attavo verify: refused: no [forge].checks_command in the manifest\")\n        return 1\n\n    build_sha = latest_build[\"sha\"]\n    build_record_path = latest_attempt_path(item_records_dir, \"build\")\n    approval_sha = latest_build.get(\"approval_sha\")\n    spec_dir = root / specs_rel / item_id\n    started = time.monotonic()\n    head_sha = git(root, \"rev-parse\", \"HEAD\").strip()\n\n    diff_text, diff_refusal = diff_since_approval(root, approval_sha)\n    if diff_refusal:\n        print(f\"attavo verify: refused: {diff_refusal}\")\n        adapter_version_out = payload.get(\"adapter_version\")\n        tok = payload.get(\"tokens\") or {}\n        tokens = {\"input\": tok.get(\"input\", 0) or 0, \"output\": tok.get(\"output\", 0) or 0}\n        cost_usd = payload.get(\"cost_usd\")\n        # \"findings\" absent (or explicitly null) is not the same as an\n        # empty list: the adapter had no channel to report one at all,\n        # which is not a clean bill of health (issue #46). A commit\n        # during verify fails the attempt regardless of what it reported.\n        if not commits and \"findings\" in payload and payload[\"findings\"] is not None:\n            findings = payload[\"findings\"]\n            tests_named = payload.get(\"tests_named\") or []\n            status_out = \"pass\"\n\n    # R3 (ruling C amended): a finding whose severity is \"blocking\" makes\n    # this review's status failed with class returned -- retryable, the\n    # next build attempt handed the findings as its evidence -- signed\n    # by the sorted titles of the blocking findings themselves. Every\n    # other severity leaves the review a pass, filed as today (issue\n    # #46's own findings channel, untouched).\n    blocking = sorted(f[\"title\"] for f in (findings or []) if str(f.get(\"severity\")) == \"blocking\")\n    if blocking:\n        status_out = \"failed\"\n        # write_record refuses a \"failed\" record with no trail at all\n        # (issue #53); a review whose own transcript is otherwise empty\n        # (a terse adapter that prints only its report line) still owes\n        # one -- the blocking findings themselves are the cause.\n        if not transcript.strip():\n            transcript = \"blocking finding(s): \" + \"; \".join(blocking)\n\n    retry_of, steer = _verify_retry_seed(item_records_dir, build_sha)\n    if blocking:\n        stop: dict[str, Any] | None = {\"class\": \"returned\", \"provenance\": \"tenant\",\n                                       \"detail\": \"; \".join(blocking),\n                                       \"signature\": signature_of(\" \".join(blocking)), \"bound\": None}\n    else:\n        stop = cast(\"dict[str, Any] | None\",\n                   derive_stop(status_out, log=transcript, report_class=(payload or {}).get(\"class\")))\n        if stop is not None:\n            stop_detail: str | None = ((payload or {}).get(\"detail\") if stop[\"class\"] == \"transient\"\n                                       else stop.get(\"detail\"))\n            stop = {**stop, \"detail\": stop_detail, \"signature\": signature_of(stop_detail), \"bound\": None}\n\n    record = {\n        \"sha\": head_sha,\n        \"build_sha\": build_sha,\n        \"build_record\": build_record_path.stem if build_record_path else None,\n        \"approval_sha\": approval_sha,\n        \"at\": now_iso(),\n        \"adapter\": adapter_name,\n        \"adapter_config\": adapter_config,\n        \"adapter_version\": adapter_version_out,\n        \"model\": model,\n        \"model_version\": model_version,\n        \"reports\": reports,\n        \"forge_checks\": forge_checks,\n        \"findings\": findings,\n        \"tests_named\": tests_named,\n        \"commits\": commits,\n        \"stub_ratio\": stub_ratio(diff_text, spec_dir / \"stub\", (specs_rel, records_rel)),\n        \"tokens\": tokens,\n        \"cost_usd\": cost_usd,\n        \"wall_clock_s\": round(time.monotonic() - started, 3),\n        \"status\": status_out,\n        \"retry_of\": retry_of,\n        \"steer\": steer,\n        \"stop\": stop,\n    }\n    record_path = write_record(item_records_dir, \"verify\", record, m, item_id, log=transcript)\n\n    print(f\"attavo verify: {status_out} ({record_path.name})\")\n    return 0 if status_out == \"pass\" else 1\n\n\n# issue #84: a constant the lane names, not a manifest key, until a tenant\n# disagrees -- how long drive gives a forge's checks room to conclude\n# before it gives up and stops rather than call a judge on a tree the\n# forge has not yet finished reading. Tenant zero's own checks conclude\n# about five minutes after a push; the default bound gives them room to\n# finish so a person is not the one re-running drive after CI, which is\n# exactly the transport act this lane retires. ATTAVO_DRIVE_POLL_BOUND_S\n# and ATTAVO_DRIVE_POLL_INTERVAL_S, read at call time rather than once at\n# import, are for a test's own clock, not a tenant's -- there is no\n# manifest key for either.\nDRIVE_FORGE_POLL_BOUND_DEFAULT_S = 600.0\n\nDRIVE_FORGE_POLL_INTERVAL_DEFAULT_S = 20.0\n\n\ndef drive_forge_poll_bound_s() -> float:\n    return float(os.environ.get(\"ATTAVO_DRIVE_POLL_BOUND_S\", DRIVE_FORGE_POLL_BOUND_DEFAULT_S))\n\n\ndef drive_forge_poll_interval_s() -> float:\n    return float(os.environ.get(\"ATTAVO_DRIVE_POLL_INTERVAL_S\", DRIVE_FORGE_POLL_INTERVAL_DEFAULT_S))\n\n\ndef forge_checks_unconcluded(forge_checks: dict[str, Any]) -> bool:\n    \"\"\"Whether poll_forge_checks should keep waiting rather than stop at\n    once: an empty read (the forge has not attached any check to this sha\n    yet) or any one check still carrying a status (queued, in_progress,\n    pending, waiting) rather than a concluded conclusion. A concluded\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-nGU4meQX' (errno=Operation not permitted)\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-pLARrFk1' (errno=Operation not permitted)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"sed -n '250,345p' attavo/drive.py; sed -n '140,310p' attavo/doctor.py; sed -n '205,270p' schema/manifest.schema.json; sed -n '90,155p' schema/records/build.schema.json; sed -n '90,150p' schema/records/verify.schema.json; git show --format=fuller --no-patch 7fb8a9b; git diff --name-status 52f3e3d..ba49729\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"sed -n '250,345p' attavo/drive.py; sed -n '140,310p' attavo/doctor.py; sed -n '205,270p' schema/manifest.schema.json; sed -n '90,155p' schema/records/build.schema.json; sed -n '90,150p' schema/records/verify.schema.json; git show --format=fuller --no-patch 7fb8a9b; git diff --name-status 52f3e3d..ba49729\"","aggregated_output":"    try:\n        then = datetime.strptime(at, \"%Y-%m-%dT%H:%M:%SZ\").replace(tzinfo=timezone.utc)\n    except ValueError:\n        return None\n    return (datetime.now(timezone.utc) - then).total_seconds()\n\n\nclass InvocationReading(NamedTuple):\n    \"\"\"What one marker with no record reads as, from here and now.\"\"\"\n    stage: str\n    nn: int\n    log: str\n    last_at: str | None\n    age: float | None\n    cls: str  # \"running\" | \"hung\" | \"died\"\n    bound: str | None = None  # R3: \"stall\" or \"ceiling\" when cls is \"hung\"\n\n\ndef _manifest_of(root: Path) -> dict[str, Any]:\n    m = read_manifest(root)\n    return m if m is not None else {}\n\n\ndef _streams_events(root: Path, m: dict[str, Any], stage: str) -> bool:\n    \"\"\"R3: whether stage's adapter declares it streams events at all\n    (adapters/<name>/conformance.json, \"streams_events\") -- one that does\n    not is judged by its ceiling alone, and never called hung by event\n    age it never produces. True (the ordinary case) when the adapter\n    declares nothing, or none is configured to ask.\"\"\"\n    name = (m.get(\"executor\") or {}).get(stage) or (m.get(\"executor\") or {}).get(\"build\")\n    if not name:\n        return True\n    for base in (root / \"attavo\" / \"adapters\", PRODUCT_ROOT / \"adapters\"):\n        conf = base / name / \"conformance.json\"\n        if conf.is_file():\n            try:\n                return bool(json.loads(conf.read_text()).get(\"streams_events\", True))\n            except (OSError, ValueError):\n                return True\n    return True\n\n\ndef read_invocation(root: Path, bound: int | None, marker: Path, info: dict[str, Any]) -> InvocationReading:\n    \"\"\"Whether an invocation that began and wrote no record is running,\n    hung, or died -- read from its own heartbeat first (R2): a heartbeat\n    file fresh within three beats of ATTAVO_HEARTBEAT_S is alive; a stale\n    one is died, whether or not the pid still lives -- a worker stuck\n    somewhere that never reaches its own heartbeat loop again is exactly\n    what this is for. Only with no heartbeat file at all -- an invocation\n    from before this release, or one that died before touching its\n    first beat -- does this fall back to the pid: alive and, with a\n    stall bound declared, past it is hung; alive with no bound, or\n    within it, is running for as long as it lives; not alive is died.\n    The stall bound decides hung, never died.\n\n    R3: the stage's own ceiling (wall clock from the marker's own `at`)\n    is judged first, before any of that -- alive past it is hung by the\n    ceiling whatever event age says, and an adapter that declares it\n    streams no events is judged by the ceiling alone: bound is read as\n    None for it, so the stall check below never fires on an event age it\n    never had.\"\"\"\n    stage, nn_text = marker.stem.rsplit(\"-\", 1)\n    nn = int(nn_text)\n    log, last_at = _events_tail(_events_path_for(root, stage, nn))\n    m = _manifest_of(root)\n    ceiling = ceiling_s(m, stage)\n    since_start = _seconds_since(info.get(\"at\"))\n    if ceiling is not None and since_start is not None and since_start > ceiling:\n        return InvocationReading(stage, nn, log, last_at, since_start, \"hung\", \"ceiling\")\n    if not _streams_events(root, m, stage):\n        bound = None\n    beat = heartbeat_path(root, stage, nn)\n    if beat.is_file():\n        try:\n            beat_age = time.time() - beat.stat().st_mtime\n        except OSError:\n            beat_age = None\n        cls = \"running\" if beat_age is not None and beat_age <= heartbeat_s() * 3 else \"died\"\n        return InvocationReading(stage, nn, log, last_at, beat_age, cls)\n    age = _seconds_since(last_at or info.get(\"at\"))\n    if not invocation_alive(info):\n        return InvocationReading(stage, nn, log, last_at, age, \"died\")\n    if bound is None or age is None or age <= bound:\n        return InvocationReading(stage, nn, log, last_at, age, \"running\")\n    return InvocationReading(stage, nn, log, last_at, age, \"hung\", \"stall\")\n\n\ndef uncommitted_record(root: Path, records_dir: Path, stage: str) -> Path | None:\n    \"\"\"The latest <stage>-NN.json this working tree carries that git has\n    no commit for yet -- the moment between a worker's write and its own\n    commit. None when the latest record is already committed, or there\n    is none at all.\"\"\"\n    path = latest_attempt_path(records_dir, stage)\n    if path is None or not path.is_file():\n        return None\n    status = subprocess.run(\n            return None, refusal\n    prefix = f\"{records_rel.rstrip('/')}/{item}/\"\n    for merge in merges:\n        found: set[str] = set()\n        for p in merge[\"touched\"]:\n            if p.startswith(prefix):\n                m = RECORD_RE.match(Path(p).name)\n                if m:\n                    found.add(m.group(1))\n        if all(s in found for s in stages):\n            return merge[\"sha\"], None\n    return None, None\n\n\nINVOCATION_MARKER_SUFFIX = \".started\"\n\n\ndef invocation_marker_path(records_dir: Path, stage: str, nn: int) -> Path:\n    return records_dir / f\"{stage}-{nn:02d}{INVOCATION_MARKER_SUFFIX}\"\n\n\ndef write_invocation_marker(root: Path, records_dir: Path, stage: str, nn: int,\n                            again_by: bool = False) -> Path:\n    \"\"\"The fact that an invocation began, written before it does: at,\n    host, pid, the sha it starts on, and the product that started it.\n    Its record's arrival is what retires it; a marker with no record is\n    an invocation that died or hangs, and proof five names it. R3:\n    again_by is true only on a marker `--again` wrote to reset a stage\n    whose budget was spent (or whose last two signatures matched) --\n    absent on every ordinary marker, never a bare false.\"\"\"\n    import os\n    import socket\n    from datetime import datetime, timezone\n    records_dir.mkdir(parents=True, exist_ok=True)\n    path = invocation_marker_path(records_dir, stage, nn)\n    sha = git(root, \"rev-parse\", \"HEAD\").strip()\n    info: dict[str, Any] = {\"at\": datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\"),\n                            \"host\": socket.gethostname(), \"pid\": os.getpid(), \"sha\": sha,\n                            \"product_version\": product_version()}\n    if again_by:\n        info[\"again_by\"] = True\n    path.write_text(json.dumps(info, indent=2) + \"\\n\")\n    return path\n\n\ndef invocation_alive(info: dict[str, Any]) -> bool:\n    \"\"\"Whether the marker's pid is a live process on this host. Another\n    host's pid is unknowable from here and reads as not alive: a drive\n    that ran elsewhere and wrote no record is died by absence.\"\"\"\n    import os\n    import socket\n    if info.get(\"host\") != socket.gethostname():\n        return False\n    pid = info.get(\"pid\")\n    if not isinstance(pid, int) or isinstance(pid, bool) or pid <= 0:\n        return False\n    try:\n        os.kill(pid, 0)\n    except ProcessLookupError:\n        return False\n    except PermissionError:\n        return True\n    return True\n\n\ndef invocation_age_s(info: dict[str, Any]) -> float | None:\n    \"\"\"Seconds since the marker's own `at` timestamp -- how long ago the\n    invocation it names began, whatever host wrote it. None when `at` is\n    missing or does not parse.\"\"\"\n    from datetime import datetime, timezone\n    at = info.get(\"at\")\n    if not isinstance(at, str):\n        return None\n    try:\n        stamp = datetime.strptime(at, \"%Y-%m-%dT%H:%M:%SZ\").replace(tzinfo=timezone.utc)\n    except ValueError:\n        return None\n    return (datetime.now(timezone.utc) - stamp).total_seconds()\n\n\ndef invocations_without_record(item_records_dir: Path) -> list[tuple[Path, dict[str, Any]]]:\n    \"\"\"Every <stage>-NN.started under one item whose <stage>-NN.json has\n    not arrived, with the marker's own dict ({} when unreadable).\"\"\"\n    out: list[tuple[Path, dict[str, Any]]] = []\n    if not item_records_dir.is_dir():\n        return out\n    for marker in sorted(item_records_dir.glob(f\"*{INVOCATION_MARKER_SUFFIX}\")):\n        if (item_records_dir / f\"{marker.stem}.json\").is_file():\n            continue\n        try:\n            with marker.open() as fh:\n                info = json.load(fh)\n        except (OSError, ValueError):\n            info = {}\n        out.append((marker, info if isinstance(info, dict) else {}))\n    return out\n\n\ndef stall_bound_s(m: dict[str, Any]) -> int | None:\n    \"\"\"[drive].stall_after_s: the tenant's own bound past which a live\n    invocation with no new event is hung. A bound the tenant did not\n    write is a forecast, so there is no default.\"\"\"\n    bound = (m.get(\"drive\") or {}).get(\"stall_after_s\")\n    if isinstance(bound, bool) or not isinstance(bound, (int, float)) or bound <= 0:\n        return None\n    return int(bound)\n\n\ndef ceiling_s(m: dict[str, Any], stage: str) -> int | None:\n    \"\"\"R3: [drive.<stage>].ceiling_s, the wall clock past which a live\n    invocation of that stage is hung by its ceiling, whatever event age\n    says (or does not say, for an adapter that streams none). No\n    default: a ceiling the tenant did not declare is not assumed.\"\"\"\n    value = ((m.get(\"drive\") or {}).get(stage) or {}).get(\"ceiling_s\")\n    if isinstance(value, bool) or not isinstance(value, (int, float)) or value <= 0:\n        return None\n    return int(value)\n\n\ndef attempts_budget(m: dict[str, Any]) -> int:\n    \"\"\"R3: [drive].attempts, the attempts a stage may spend -- across a\n    plain retry, a returned retry, and a steered one alike -- before the\n    item is a person's; 3 when the manifest does not say.\"\"\"\n    value = (m.get(\"drive\") or {}).get(\"attempts\")\n    if isinstance(value, bool) or not isinstance(value, int) or value < 1:\n        return 3\n    return value\n\n\ndef retry_after_s(m: dict[str, Any]) -> int:\n    \"\"\"R3: [drive].retry_after_s, the wait a transient stop's record sits\n    through before its next attempt starts; 300 when the manifest does\n    not say.\"\"\"\n    value = (m.get(\"drive\") or {}).get(\"retry_after_s\")\n    if isinstance(value, bool) or not isinstance(value, (int, float)) or value < 0:\n        return 300\n    return int(value)\n\n\ndef proof_no_invocation_lacks_record(root: Path, m: dict[str, Any] | None) -> Proof:\n    import socket\n    p = Proof(\"no-invocation-lacks-record\", \"no invocation lacks its record\")\n    if m is None:\n        return p.fail(f\"no {MANIFEST} at {root}; no records directory is declared\")\n    records_rel = m.get(\"paths\", {}).get(\"records\", \"\")\n    records_dir = root / records_rel\n    if not records_dir.is_dir():\n        return p.fail(f\"no records directory under {records_dir}\")\n    bound = stall_bound_s(m)\n    if bound is None:\n        return p.fail(\"no [drive].stall_after_s in the manifest; a hung invocation cannot be \"\n                      \"told from a running one\")\n    # R3: a stage with no ceiling can run forever unjudged even when\n    # stall_after_s is set (an adapter that streams no events trips no\n    # stall bound at all) -- refused the same way stall_after_s's own\n    # absence is, not folded into it, so the reason names exactly which\n    # keys the manifest is missing.\n    missing_ceilings = [f\"[drive.{stage}].ceiling_s\" for stage in (\"build\", \"verify\")\n                        if ceiling_s(m, stage) is None]\n    if missing_ceilings:\n        return p.fail(f\"no {' or '.join(missing_ceilings)} in the manifest; a stage with no \"\n                      f\"ceiling can run forever unjudged (R3)\")\n    if (m.get(\"drive\") or {}).get(\"attempts\") is None:\n        return p.fail(\"no [drive].attempts in the manifest; a retryable stop would spend an \"\n                      \"unbounded number of attempts (R3)\")\n    this_host = socket.gethostname()\n    recorded = 0\n    running: list[str] = []\n    in_flight: list[str] = []\n    problems: list[str] = []\n    for item_dir in sorted(d for d in records_dir.iterdir() if d.is_dir()):\n        \"from\": {\n          \"type\": \"string\",\n          \"description\": \"Anything git rev-parse --verify resolves to a commit on main's first-parent line, at or after the install commit -- a full or abbreviated sha, a tag, a ref -- where proof three's window starts. A tenant that adopted the product on a repository with pre-existing history names the commit after which every push arrived through the queue. Resolved and checked against main's first-parent line, not trusted: a spelling that does not resolve, or a commit that is not on that line, is refused by name.\",\n          \"minLength\": 1\n        }\n      }\n    },\n    \"drive\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"stall_after_s\": {\n          \"type\": \"integer\",\n          \"minimum\": 1,\n          \"description\": \"seconds without a new event past which a live invocation is hung; attavo drive --recover terminates and records it\"\n        },\n        \"attempts\": {\n          \"type\": \"integer\",\n          \"minimum\": 1,\n          \"description\": \"R3: attempts a stage may spend before the item is a person's; 3 when absent\"\n        },\n        \"retry_after_s\": {\n          \"type\": \"integer\",\n          \"minimum\": 0,\n          \"description\": \"R3: seconds a transient stop waits before its next attempt; 300 when absent\"\n        },\n        \"build\": {\n          \"type\": \"object\",\n          \"additionalProperties\": false,\n          \"properties\": {\n            \"ceiling_s\": {\"type\": \"integer\", \"minimum\": 1, \"description\": \"R3: wall clock past which a live build is hung by its ceiling\"}\n          }\n        },\n        \"verify\": {\n          \"type\": \"object\",\n          \"additionalProperties\": false,\n          \"properties\": {\n            \"ceiling_s\": {\"type\": \"integer\", \"minimum\": 1, \"description\": \"R3: wall clock past which a live review is hung by its ceiling\"}\n          }\n        }\n      }\n    }\n  }\n}\n      \"description\": \"The tool's list-price meter, from the adapter's own report. Billed only when the build ran under adapter_config.auth = \\\"api\\\"; under auth = \\\"subscription\\\" this figure is a measure, not a bill -- usage is included in the operator's plan.\"\n    },\n    \"wall_clock_s\": {\"type\": \"number\", \"minimum\": 0},\n    \"status\": {\"type\": \"string\", \"enum\": [\"pass\", \"refused\", \"halted\", \"failed\"]},\n    \"refusal\": {\"type\": [\"string\", \"null\"]},\n    \"halted\": {\n      \"type\": [\"object\", \"null\"],\n      \"additionalProperties\": false,\n      \"required\": [\"question\"],\n      \"properties\": {\n        \"question\": {\"type\": [\"string\", \"null\"]}\n      }\n    },\n    \"stop\": {\n      \"type\": [\"object\", \"null\"],\n      \"description\": \"Non-null exactly when status is not \\\"pass\\\" (issue #89): what class of stop this is and whose it is, derived by the record writer from the refusal, halted, and log it already has -- never a fresh read of anything.\",\n      \"additionalProperties\": false,\n      \"required\": [\"class\", \"provenance\", \"detail\"],\n      \"properties\": {\n        \"class\": {\n          \"type\": \"string\",\n          \"enum\": [\"non-question\", \"outlived-invocation\", \"no-cause\", \"forge-unconcluded\",\n                   \"ceiling\", \"claims-boundary\", \"repeated-act\", \"unclassed\", \"question\",\n                   \"environment\", \"gate\", \"died\", \"hung\", \"transient\", \"returned\"]\n        },\n        \"signature\": {\n          \"type\": [\"string\", \"null\"],\n          \"description\": \"R3: the failure's signature, the detail or last event with every run of digits removed; equal between two attempts means the same failure\"\n        },\n        \"bound\": {\n          \"type\": [\"string\", \"null\"],\n          \"enum\": [\"stall\", \"ceiling\", null],\n          \"description\": \"R3: the bound a hung invocation crossed, or null\"\n        },\n        \"provenance\": {\"type\": \"string\", \"enum\": [\"product\", \"tenant\", \"executor\", \"spec\"]},\n        \"detail\": {\n          \"type\": [\"string\", \"null\"],\n          \"description\": \"Populated for class \\\"unclassed\\\" (the log's last line, capped at 200 characters), class \\\"question\\\" (the halt's own question, its first line only), class \\\"environment\\\" ([checks].command's last output line, capped at 200 characters), and class \\\"gate\\\" (a refused spec-gate record's own refusal string, issue #137 -- never persisted on an actual build record; read here only because stop_class_enum sources the enum from this schema); null for every other class, whose evidence already lives in refusal, halted, or the log itself.\"\n        }\n      }\n    },\n    \"retry_of\": {\n      \"type\": [\"string\", \"null\"],\n      \"description\": \"R3: the stem of the attempt this one retries, or null on a first attempt\"\n    },\n    \"steer\": {\n      \"type\": [\"string\", \"null\"],\n      \"description\": \"R3: the counsel or ruling record whose text this attempt was handed, or null\"\n    },\n    \"product_version\": {\"type\": \"string\", \"minLength\": 1},\n    \"product_pin\": {\"type\": [\"string\", \"null\"]}\n  }\n}\n        \"input\": {\"type\": \"integer\", \"minimum\": 0},\n        \"output\": {\"type\": \"integer\", \"minimum\": 0}\n      }\n    },\n    \"cost_usd\": {\"type\": [\"number\", \"null\"]},\n    \"wall_clock_s\": {\"type\": \"number\", \"minimum\": 0},\n    \"status\": {\"type\": \"string\", \"enum\": [\"pass\", \"returned\", \"failed\"]},\n    \"stop\": {\n      \"type\": [\"object\", \"null\"],\n      \"description\": \"Non-null exactly when status is not \\\"pass\\\" (issue #89): what class of stop this is and whose it is, derived by the record writer from the forge_checks and log it already has -- never a fresh read of anything.\",\n      \"additionalProperties\": false,\n      \"required\": [\"class\", \"provenance\", \"detail\"],\n      \"properties\": {\n        \"class\": {\n          \"type\": \"string\",\n          \"enum\": [\"non-question\", \"outlived-invocation\", \"no-cause\", \"forge-unconcluded\",\n                   \"ceiling\", \"claims-boundary\", \"repeated-act\", \"unclassed\", \"question\",\n                   \"died\", \"hung\", \"transient\", \"returned\"]\n        },\n        \"signature\": {\n          \"type\": [\"string\", \"null\"],\n          \"description\": \"R3: the failure's signature, the detail or last event with every run of digits removed; equal between two attempts means the same failure\"\n        },\n        \"bound\": {\n          \"type\": [\"string\", \"null\"],\n          \"enum\": [\"stall\", \"ceiling\", null],\n          \"description\": \"R3: the bound a hung invocation crossed, or null\"\n        },\n        \"provenance\": {\"type\": \"string\", \"enum\": [\"product\", \"tenant\", \"executor\", \"spec\"]},\n        \"detail\": {\n          \"type\": [\"string\", \"null\"],\n          \"description\": \"Populated for class \\\"unclassed\\\" (the log's last line, capped at 200 characters) and class \\\"question\\\" (the halt's own question, its first line only); null for every other class, whose evidence already lives in forge_checks or the log itself.\"\n        }\n      }\n    },\n    \"retry_of\": {\n      \"type\": [\"string\", \"null\"],\n      \"description\": \"R3: the stem of the attempt this one retries, or null on a first attempt\"\n    },\n    \"steer\": {\n      \"type\": [\"string\", \"null\"],\n      \"description\": \"R3: the counsel or ruling record whose text this attempt was handed, or null\"\n    },\n    \"product_version\": {\"type\": \"string\", \"minLength\": 1},\n    \"product_pin\": {\"type\": [\"string\", \"null\"]}\n  }\n}\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-g28vwhJm' (errno=Operation not permitted)\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-lvoN48hI' (errno=Operation not permitted)\ncommit 7fb8a9b913f3f9937ce198715a533f5d7f8ad13e\nAuthor:     attavo executor (claude-code) <executor+claude-code@attavo.invalid>\nAuthorDate: Fri Sep 25 22:58:59 2026 -0600\nCommit:     attavo executor (claude-code) <executor+claude-code@attavo.invalid>\nCommitDate: Fri Sep 25 22:58:59 2026 -0600\n\n    attavo: build #219, the reconciler's R3 -- retries, budgets, ceilings\n    \n    Four retryable families -- died, hung, transient (new: a vendor's\n    capacity, rate, or 5xx refusal, classed on the adapter's own report\n    line), and returned (new: a required check a passed build's head\n    rejected, or a review's own blocking finding) -- retry with no\n    operator, no counsel, inside one shared [drive].attempts budget per\n    stage; a transient waits [drive].retry_after_s first. Every other\n    non-pass record still reaches counsel as before, and an \"answer\"\n    verdict now starts the next attempt steered by it (retry_of and steer\n    on the record); \"patch\" and \"person\" stay the operator's, and a\n    question, a claims-boundary stop, a gate refusal, and an environment\n    refusal are never retried by this item regardless of what counsel\n    rules.\n    \n    Two attempts of one stage ending with the identical stop.signature\n    (a class's own detail or last event, digits stripped) stop the stage\n    early. A stopped, exhausted stage's report carries every attempt's\n    class, signature, bound, wall clock, and cost side by side, whether\n    the last two signatures match, and the rulings available -- --again\n    (retired inside the budget to a no-op that says the pass retries on\n    its own; forces the next attempt, marked again_by, once the budget or\n    the early stop has closed it) and amending the spec.\n    \n    [drive.build].ceiling_s and [drive.verify].ceiling_s bound a stage's\n    wall clock from its own marker; alive past it is hung by the ceiling\n    whatever event age says, and an adapter whose conformance.json\n    declares \"streams_events\": false is judged by the ceiling alone. The\n    doctor refuses a manifest that sets [drive] without both ceilings and\n    attempts, as it already refuses one without stall_after_s.\n    \n    A concluded red required check on a passed build's head is now a\n    returned review record the report writes on its own, not the\n    blocked-on-checks level with nothing behind it (#206's own build-01);\n    the next build is handed the check's log through\n    [forge].check_log_command. tests/test_drive.py's two tests that\n    encoded that level are rewritten to the record; #194's own verify-01,\n    a counsel run on a vendor's capacity error, is retired by the\n    transient family it would be classed as today.\n    \n    Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-MdKPcTZT' (errno=Operation not permitted)\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-3wiSBNay' (errno=Operation not permitted)\nA\tattest/records/219/spec-01.json\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_7","type":"agent_message","text":"{\"findings\":[{\"title\":\"Ceiling recovery targets the pass PID, not the over-ceiling worker\",\"specimen\":\"attavo/doctor.py::write_invocation_marker records os.getpid() before attavo/drive.py::_start_stage spawns the detached worker; attavo/drive.py::_recover_one later sends SIGTERM to that marker PID. The worker can therefore survive a ceiling recovery and subsequently write a competing record.\",\"retires\":\"The claim that stage ceilings terminate workers, rather than merely recording them as hung while their work continues.\",\"rejection_test\":\"tests/test_retry.py::test_ceiling_recovery_terminates_the_actual_worker_and_it_cannot_write_a_late_record\",\"severity\":\"Harmless only when the worker has already exited independently; blocking when an alive worker crosses its ceiling and continues running after recovery.\"},{\"title\":\"Recovered retry attempts lose retry_of and steer provenance\",\"specimen\":\"attavo/drive.py::_recover_one unconditionally writes \\\"retry_of\\\": null and \\\"steer\\\": null, including for build-02/verify-02 markers started as retries. This contradicts the required record shape for every retried attempt.\",\"retires\":\"Ambiguous recovered records that cannot identify the prior attempt or the counsel steer whose input they consumed.\",\"rejection_test\":\"tests/test_retry.py::test_a_recovered_retried_attempt_records_retry_of_and_steer\",\"severity\":\"Harmless for a first attempt; blocking when attempt 02 or later dies or hangs and its recovered record omits its retry lineage.\"},{\"title\":\"Exhaustion caused by recovery never receives the required final counsel read\",\"specimen\":\"attavo/drive.py::_stage_body invokes counsel after an ordinarily completed non-pass record exhausts the budget, but attavo/drive.py::_recover_one commits died/hung records directly and never invokes counsel. Two identical recovered failures therefore stop early without the exhaustion sentence required beside the comparison.\",\"retires\":\"Exhaustion reports that present only mechanical attempt comparison and omit counsel’s final interpretation.\",\"rejection_test\":\"tests/test_retry.py::test_two_identical_recovered_failures_run_counsel_once_at_exhaustion_and_report_its_sentence\",\"severity\":\"Harmless while recovery leaves retry budget available; blocking when a recovered died or hung record spends the budget or triggers the identical-signature early stop.\"},{\"title\":\"Questions are retried after counsel answer despite being explicitly non-retryable\",\"specimen\":\"attavo/drive.py::NEVER_RETRIED_CLASSES omits question, and retry_state consequently starts another attempt when counsel answers one. tests/test_retry.py::test_counsels_verdict_routes_the_next_pass positively encodes this divergence even though the approved spec and build commit both say a question is never retried by this item.\",\"retires\":\"Automatic reruns after a stop whose answer may alter or interpret the definition of done.\",\"rejection_test\":\"tests/test_retry.py::test_a_question_is_never_retried_even_when_counsel_verdict_is_answer\",\"severity\":\"Harmless when no counsel answer exists; blocking when a question receives an answer and the next pass automatically starts another attempt.\"},{\"title\":\"--again bypasses person-only stops, not just exhausted retry budgets\",\"specimen\":\"attavo/drive.py::_pass_once calls _advance_again for every stopped state that is neither presently eligible nor waiting. Thus --again can restart claims-boundary, environment, gate, unanswered/person-ruled question, and patch stops, although the approved narrowing permits it only after a stage’s retry budget or early stop is spent.\",\"retires\":\"The old broad --again escape hatch inside states reserved for an operator or later breaker behavior.\",\"rejection_test\":\"tests/test_retry.py::test_again_refuses_person_patch_claims_boundary_gate_and_environment_stops\",\"severity\":\"Harmless without --again; blocking when --again is issued against a person-only or never-retried stop and creates a new marker.\"}],\"tests_named\":[\"tests/test_retry.py::test_ceiling_recovery_terminates_the_actual_worker_and_it_cannot_write_a_late_record\",\"tests/test_retry.py::test_a_recovered_retried_attempt_records_retry_of_and_steer\",\"tests/test_retry.py::test_two_identical_recovered_failures_run_counsel_once_at_exhaustion_and_report_its_sentence\",\"tests/test_retry.py::test_a_question_is_never_retried_even_when_counsel_verdict_is_answer\",\"tests/test_retry.py::test_again_refuses_person_patch_claims_boundary_gate_and_environment_stops\"]}"}}

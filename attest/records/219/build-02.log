 | None\n    stop: Stop | None\n    product_version: str\n    product_pin: str | None\n\n\nclass _BuildOptional(TypedDict, total=False):\n    retry_of: str | None\n    steer: str | None\n\n\nclass BuildRecord(_BuildRequired, _BuildOptional):\n    \"\"\"build-NN.json (issue #60): retry_of and steer (R3) are optional --\n    absent on a record written before this release.\"\"\"","originalFile":"\"\"\"The record kinds, typed. Each TypedDict here mirrors one JSON schema: its\nkeys are that schema's `properties` and its required keys are that schema's\n`required`, and tests/test_types_mirror_schemas.py asserts both, so the type\ncannot drift from the contract. The schema stays the contract; this is its\nmirror (issue #189).\n\nEvery key each schema lists is required, so no class here is total=False; a\nkey the schema someday makes optional goes in a total=False base. A value the\nschema declares as an object with fixed properties but this module does not\nyet name is a dict[str, Any] (or a list of them), no tighter than the schema's\nown `additionalProperties` allows for the adapter-owned ones.\n\"\"\"\nfrom __future__ import annotations\n\nfrom typing import Any, Literal, TypedDict\n\n# The stage names a record file's <stage>-NN.json prefix can carry, one per\n# schema under schema/records/.\nStage = Literal[\"spec\", \"approval\", \"build\", \"verify\", \"counsel\"]\n\n# \"class\" is a Python keyword, so the record kinds that carry it are built\n# with the functional syntax. signature and bound are R3's own additions,\n# optional (a record older than record_version 8/7 carries neither).\n_StopRequired = TypedDict(\"_StopRequired\", {\n    \"class\": str,\n    \"provenance\": str,\n    \"detail\": str | None,\n})\n_StopOptional = TypedDict(\"_StopOptional\", {\n    \"signature\": str | None,\n    \"bound\": str | None,\n}, total=False)\n\n\nclass Stop(_StopRequired, _StopOptional):\n    \"\"\"build-NN.json's and verify-NN.json's `stop`: the class of a stop and whose\n    it is. The two schemas enumerate different classes; the shape is the same.\"\"\"\n\n\nclass SpecRecord(TypedDict):\n    record_version: int\n    item: str\n    sha: str\n    spec_sha: str | None\n    at: str\n    status: str\n    approval_sha: str | None\n    criteria: list[dict[str, Any]]\n    refusal: str | None\n    product_version: str\n    product_pin: str | None\n\n\nclass ApprovalRecord(TypedDict):\n    record_version: int\n    item: str\n    sha: str\n    spec_sha: str | None\n    approved_by: str\n    at: str\n    product_version: str\n    product_pin: str | None\n\n\nclass BuildRecord(TypedDict):\n    record_version: int\n    item: str\n    sha: str\n    start_sha: str\n    spec_sha: str | None\n    approval_sha: str | None\n    at: str\n    adapter: str\n    adapter_config: dict[str, Any]\n    executor_identity: dict[str, str]\n    reports: list[str]\n    adapter_version: str | None\n    model: str | None\n    model_version: str | None\n    iterations: int\n    criteria: list[dict[str, Any]]\n    selected_tests: dict[str, Any] | None\n    checks: dict[str, Any] | None\n    tokens: dict[str, int]\n    cost_usd: float | None\n    wall_clock_s: float\n    status: str\n    refusal: str | None\n    halted: dict[str, Any] | None\n    stop: Stop | None\n    product_version: str\n    product_pin: str | None\n\n\nclass VerifyRecord(TypedDict):\n    record_version: int\n    item: str\n    sha: str\n    build_sha: str\n    build_record: str | None\n    approval_sha: str | None\n    at: str\n    adapter: str | None\n    adapter_config: dict[str, Any]\n    adapter_version: str | None\n    model: str | None\n    model_version: str | None\n    reports: list[str]\n    forge_checks: dict[str, Any]\n    findings: list[dict[str, Any]] | None\n    tests_named: list[str]\n    commits: list[str]\n    stub_ratio: float | None\n    tokens: dict[str, int]\n    cost_usd: float | None\n    wall_clock_s: float\n    status: str\n    stop: Stop | None\n    product_version: str\n    product_pin: str | None\n\n\nCounselRecord = TypedDict(\"CounselRecord\", {\n    \"record_version\": int,\n    \"item\": str,\n    \"sha\": str,\n    \"record_stage\": str,\n    \"record\": str,\n    \"at\": str,\n    \"adapter\": str | None,\n    \"adapter_config\": dict[str, Any],\n    \"adapter_version\": str | None,\n    \"model\": str | None,\n    \"model_version\": str | None,\n    \"reports\": list[str],\n    \"tokens\": dict[str, int],\n    \"cost_usd\": float | None,\n    \"wall_clock_s\": float,\n    \"status\": str,\n    \"class\": str | None,\n    \"verdict\": str | None,\n    \"citations\": list[dict[str, Any]],\n    \"proposal\": dict[str, Any],\n    \"forge\": dict[str, Any],\n    \"question\": str | None,\n    \"product_version\": str,\n    \"product_pin\": str | None,\n})\n\n\nclass StageTime(TypedDict):\n    \"\"\"One stage's invocations summed (the statement's `time` block).\"\"\"\n    attempts: int\n    invocation_s: float\n    partial: bool\n\n\nclass ItemTime(TypedDict):\n    \"\"\"Every invocation's wall_clock_s, per stage and for the item, beside\n    the item's lead time -- summed from the records by `attavo attest`, so\n    a view renders it and never derives it.\"\"\"\n    build: StageTime\n    verify: StageTime\n    counsel: StageTime\n    invocation_s: float\n    lead_s: float | None\n    waiting_s: float | None\n    partial: bool\n    not_read: list[str]\n\n\nclass ItemCost(TypedDict):\n    \"\"\"Every record's cost_usd summed: the item's total across stages and\n    executors, with a subtotal per stage and per adapter. A record with no\n    cost_usd is named in not_read and makes every sum it belongs to\n    partial -- absent is never zero.\"\"\"\n    usd: float\n    by_stage_usd: dict[str, float]\n    by_adapter_usd: dict[str, float]\n    partial: bool\n    not_read: list[str]\n\n\nclass AttestRecord(TypedDict):\n    \"\"\"The statement `attavo attest` prints (schema/attestation.schema.json).\"\"\"\n    sha: str\n    merge_sha: str\n    item: str\n    spec: str | None\n    spec_sha: str | None\n    approval: str | None\n    approval_sha: str | None\n    build: str | None\n    build_sha: str | None\n    verify: str | None\n    verify_sha: str | None\n    at: str\n    interventions: list[dict[str, str]]\n    acts: list[dict[str, str]]\n    tokens_by_stage: dict[str, dict[str, Any] | None]\n    cost_by_stage_usd: dict[str, float | None]\n    wall_clock_by_stage_s: dict[str, float | None]\n    time: ItemTime\n    cost: ItemCost\n    product_version: str\n    product_pin: str | None\n\n\n# What counsel reads a stop from: a build or verify record, or a refused\n# spec-gate record (issue #133).\nStageRecord = SpecRecord | BuildRecord | VerifyRecord\n\n\nclass DriveReport(TypedDict):\n    \"\"\"What `attavo drive N --report` prints (schema/drive-report.schema.json):\n    the item's level, read from its records, its markers, and the forge.\"\"\"\n    item: str\n    state: str\n    kind: str\n    says: str\n    stage: str | None\n    attempt: int | None\n    record: str | None\n    stop_class: str | None\n    counsel: str | None\n    filed: str | None\n    head: str | None\n    checks: list[dict[str, str]] | None\n    since: str | None\n    last_event_age_s: int | None\n","structuredPatch":[{"oldStart":62,"oldLines":7,"newStart":62,"newLines":7,"lines":["     product_pin: str | None"," "," ","-class BuildRecord(TypedDict):","+class _BuildRequired(TypedDict):","     record_version: int","     item: str","     sha: str"]},{"oldStart":92,"oldLines":6,"newStart":92,"newLines":16,"lines":["     product_pin: str | None"," "," ","+class _BuildOptional(TypedDict, total=False):","+    retry_of: str | None","+    steer: str | None","+","+","+class BuildRecord(_BuildRequired, _BuildOptional):","+    \"\"\"build-NN.json (issue #60): retry_of and steer (R3) are optional --","+    absent on a record written before this release.\"\"\"","+","+"," class VerifyRecord(TypedDict):","     record_version: int","     item: str"
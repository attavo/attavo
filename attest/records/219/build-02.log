concept at all (confirmed against codex-cli 0.153.4) -- codex drives sandboxed shell commands as a single agent, with no tool of its own that could spawn work outliving this invocation the way issue #88's claude-code specimen did\"\n  },\n  \"success_script\": \"#!/bin/sh\\ngit commit -q --allow-empty -m 'adapter commit'\\nout=\\\"\\\"\\nprev=\\\"\\\"\\nfor arg in \\\"$@\\\"; do\\n  if [ \\\"$prev\\\" = \\\"--output-last-message\\\" ] || [ \\\"$prev\\\" = \\\"-o\\\" ]; then\\n    out=\\\"$arg\\\"\\n  fi\\n  prev=\\\"$arg\\\"\\ndone\\nif [ -n \\\"$out\\\" ]; then\\n  printf '{\\\"status\\\":\\\"done\\\",\\\"question\\\":null}' > \\\"$out\\\"\\nfi\\nprintf '{\\\"type\\\":\\\"turn.completed\\\",\\\"usage\\\":{\\\"input_tokens\\\":1,\\\"output_tokens\\\":1,\\\"cached_input_tokens\\\":0,\\\"cache_write_input_tokens\\\":0,\\\"reasoning_output_tokens\\\":0}}\\\\n'\\n\",\n  \"situations\": {\n    \"done\": {\n      \"events\": [\n        {\"type\": \"thread.started\", \"thread_id\": \"conformance-done\"},\n        {\"type\": \"turn.started\"},\n        {\"type\": \"item.completed\", \"item\": {\"id\": \"item_0\", \"type\": \"agent_message\", \"text\": \"ok\"}},\n        {\"type\": \"turn.completed\", \"usage\": {\"input_tokens\": 15272, \"cached_input_tokens\": 12160, \"cache_write_input_tokens\": 0, \"output_tokens\": 5, \"reasoning_output_tokens\": 0}}\n      ],\n      \"final\": {\"status\": \"done\", \"question\": null},\n      \"exit_code\": 0\n    },\n    \"is_error\": {\n      \"events\": [\n        {\"type\": \"thread.started\", \"thread_id\": \"conformance-is-error\"},\n        {\"type\": \"turn.started\"},\n        {\"type\": \"error\", \"message\": \"Reconnecting... 5/5 (unexpected status 401 Unauthorized)\"},\n        {\"type\": \"turn.failed\", \"error\": {\"message\": \"unexpected status 401 Unauthorized: Missing bearer or basic authentication in header\"}}\n      ],\n      \"final\": null,\n      \"exit_code\": 1\n    },\n    \"no_structured_output\": {\n    
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GeX3vEuxp1KHdGkRk5DfD3","type":"tool_result","content":"460\t    assert record_files(root, \"verify\") == []\n461\t    assert remote_head(bare, branch) == head_of(root)\n462\t\n463\t\n464\t\n465\tdef test_drive_until_ready_stops_when_the_forge_goes_red_after_a_build(tmp_path: Path) -> None:\n466\t    \"\"\"A build that passes, then a forge that concludes red on its head,\n467\t    stops the loop there with exit 1 -- the loop gave up short of ready\n468\t    -- one record written (the pass), no review record, no retry of the\n469\t    forge read.\"\"\"\n470\t    root = make_tenant(tmp_path, \"build_valid\")\n471\t    add_forge(root, RED_FORGE)\n472\t    add_bare_remote(root, tmp_path)\n473\t    approve_item(root)\n474\t\n475\t    run = run_attavo(root, \"drive\", \"1\", \"--until-ready\")\n476\t    assert run.returncode == 1, run.stdout + run.stderr\n477\t    assert \"ci\" in run.stdout and \"failure\" in run.stdout\n478\t\n479\t    assert len(record_files(root, \"build\")) == 1\n480\t    assert latest_record(root, \"build\")[\"status\"] == \"pass\"\n481\t    assert record_files(root, \"verify\") == []\n482\t\n483\t\n484\t\n485\tdef test_drive_line_buffers_stdout_so_a_pipe_reader_sees_the_start_line_before_the_stage_ends(tmp_path: Path) -> None:\n486\t    \"\"\"Issue #145, kept under R2. A pipe reader of `attavo drive` saw\n487\t    every line arrive as one burst when the process ended -- Python\n488\t    block-buffers stdout when it is not a tty. With --until-ready the\n489\t    process now outlives a slow stage; a pipe reader with a timeout well\n490\t    under the stage's own sleep must already see the \"started\" line the\n491\t    pass printed before that sleep ends -- unreachable if stdout is\n492\t    still block-buffered. The worker reconfigures its own stdout the same\n493\t    way, so its log is readable while it runs.\n494\t    \"\"\"\n495\t    root = make_tenant(tmp_path, \"build_valid\")\n496\t    add_forge(root, GREEN_FORGE)\n497\t    add_bare_remote(root, tmp_path)\n498\t    approve_item(root)\n499\t\n500\t    sleep_s = 3.0\n501\t    adapter_dir = root / \"attavo\" / \"adapters\" / \"slow\"\n502\t    adapter_dir.mkdir(parents=True)\n503\t    adapter_run = adapter_dir / \"run\"\n504\t    adapter_run.write_text(\n505\t        \"#!/bin/sh\\n\"\n506\t        \"set -eu\\n\"\n507\t        'if [ \"${ATTAVO_STAGE:-build}\" = \"verify\" ]; then\\n'\n508\t        '  printf \\'{\"model\":\"slow\",\"model_version\":null,\"adapter_version\":\"slow-1\",'\n509\t        '\"tokens\":{\"input\":1,\"output\":1},\"cost_usd\":0.0,\"findings\":[],\"tests_named\":[]}\\\\n\\'\\n'\n510\t        \"  exit 0\\n\"\n511\t        \"fi\\n\"\n512\t        f\"sleep {sleep_s}\\n\"\n513\t        \"echo built > built.txt\\n\"\n514\t        \"git add built.txt\\n\"\n515\t        \"git commit -q -m 'slow: write built.txt'\\n\"\n516\t        'echo \\'{\"status\":\"done\",\"question\":null,\"model\":\"slow\",\"model_version\":null,'\n517\t        '\"adapter_version\":\"slow-1\",\"tokens\":{\"input\":1,\"output\":1},\"cost_usd\":0.0}\\'\\n'\n518\t    )\n519\t    adapter_run.chmod(0o755)\n520\t    toml = root / \"attavo.toml\"\n521\t    toml.write_text(toml.read_text().replace('build = \"fixture\"', 'build = \"slow\"'))\n522\t    commit_all(root, \"use a slow adapter for build\")\n523\t\n524\t    full_env = dict(os.environ)\n525\t    full_env.update(FAST_POLL_ENV)\n526\t    proc = subprocess.Popen(\n527\t        [sys.executable, str(ATTAVO), \"drive\", \"1\", \"--until-ready\"],\n528\t        cwd=str(root), stdout=subprocess.PIPE, stderr=subprocess.STDOUT,\n529\t        text=True, env=full_env)\n530\t\n531\t    lines: \"queue.Queue[str | None]\" = queue.Queue()\n532\t\n533\t    def reader() -> None:\n534\t        for raw in cast(IO[str], proc.stdout):\n535\t            lines.put(raw)\n536\t        lines.put(None)\n537\t\n538\t    thread = threading.Thread(target=reader, daemon=True)\n539\t    thread.start()\n540\t\n541\t    try:\n542\t        first_line = lines.get(timeout=sleep_s / 2)\n543\t    except queue.Empty:\n544\t        proc.kill()\n545\t        raise\n546\t    assert first_line is not None and \"Build started\" in first_line, first_line\n547\t\n548\t    collected = [first_line]\n549\t    while True:\n550\t        line = lines.get(timeout=sleep_s + 30)\n551\t        if line is None:\n552\t            break\n553\t        collected.append(line)\n554\t    thread.join(timeout=5)\n555\t    proc.wait(timeout=5)\n556\t\n557\t    output = \"\".join(collected)\n558\t    assert proc.returncode == 0, output\n559\t    assert \"ready to merge\" in output.lower()\n560\t\n561\t\n562\t\n563\tdef test_drive_pass_reads_a_red_forge_as_blocked_and_starts_nothing(tmp_path: Path) -> None:\n564\t    \"\"\"Acceptance row 4, as a level. A forge read where the one check has\n565\t    already concluded and failed is not polled at all -- the pass reads\n566\t    the forge once, says Blocked naming the check, exits 0, and starts\n567\t    no review: no marker, no verify record, no new commit, no sleep.\"\"\"\n568\t    root = make_tenant(tmp_path, \"build_valid\")\n569\t    add_forge(root, RED_FORGE)\n570\t    add_bare_remote(root, tmp_path)\n571\t    approve_item(root)\n572\t\n573\t    assert drive(root, \"1\").returncode == 0  # builds\n574\t    pre_head = head_of(root)\n575\t\n576\t    started = time.monotonic()\n577\t    run = drive(root, \"1\")\n578\t    elapsed = time.monotonic() - started\n579\t    assert run.returncode == 0, run.stdout + run.stderr\n580\t    assert \"Blocked\" in run.stdout and \"ci failure\" in run.stdout\n581\t    assert \"worker pid\" not in run.stdout\n582\t    assert elapsed < 0.4, (\n583\t        f\"a concluded, red forge check is read once with no poll interval slept \"\n584\t        f\"-- took {elapsed:.2f}s\")\n585\t\n586\t    assert record_files(root, \"verify\") == []\n587\t    assert not (records_dir(root) / \"verify-01.started\").exists()\n588\t    assert head_of(root) == pre_head\n589\t\n590\t    # Idempotence (row 8): a pass in the same red state says the same,\n591\t    # still nothing written.\n592\t    run2 = drive(root, \"1\")\n593\t    assert run2.returncode == 0\n594\t    assert \"Blocked\" in run2.stdout\n595\t    assert record_files(root, \"verify\") == []\n596\t    assert head_of(root) == pre_head\n597\t\n598\t\n599\t"}]},"parent_tool_use_id":null,"session_id":"ae622d81-efb9-4dda-92a0-5ebf75b0d73f","uuid":"23cab968-01cb-47a0-a7d2-e28f2028e73d","timestamp":"2026-09-26T03:43:12.438Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-219/tests/test_drive.py","content":"    assert record_files(root, \"verify\") == []\n    assert remote_head(bare, branch) == head_of(root)\n\n\n\ndef test_drive_until_ready_stops_when_the_forge_goes_red_after_a_build(tmp_path: Path) -> None:\n    \"\"\"A build that passes, then a forge that concludes red on its head,\n    stops the loop there with exit 1 -- the loop gave up short of ready\n    -- one record written (the pass), no review record, no retry of the\n    forge read.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, RED_FORGE)\n    add_bare_remote(root, tmp_path)\n    approve_item(root)\n\n    run = run_attavo(root, \"drive\", \"1\", \"--until-ready\")\n    assert run.returncode == 1, run.stdout + run.stderr\n    assert \"ci\" in run.stdout and \"failure\" in run.stdout\n\n    assert len(record_files(root, \"build\")) == 1\n    assert latest_record(root, \"build\")[\"status\"] == \"pass\"\n    assert record_files(root, \"verify\") == []\n\n\n\ndef test_drive_line_buffers_stdout_so_a_pipe_reader_sees_the_start_line_before_the_stage_ends(tmp_path: Path) -> None:\n    \"\"\"Issue #145, kept under R2. A pipe reader of `attavo drive` saw\n    every line arrive as one burst when the process ended -- Python\n    block-buffers stdout when it is not a tty. With --until-ready the\n    process now outlives a slow stage; a pipe reader with a timeout well\n    under the stage's own sleep must already see the \"started\" line the\n    pass printed before that sleep ends -- unreachable if stdout is\n    still block-buffered. The worker reconfigures its own stdout the same\n    way, so its log is readable while it runs.\n    \"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    add_bare_remote(root, tmp_path)\n    approve_item(root)\n\n    sleep_s = 3.0\n    adapter_dir = root / \"attavo\" / \"adapters\" / \"slow\"\n    adapter_dir.mkdir(parents=True)\n    adapter_run = adapter_dir / \"run\"\n    adapter_run.write_text(\n        \"#!/bin/sh\\n\"\n        \"set -eu\\n\"\n        'if [ \"${ATTAVO_STAGE:-build}\" = \"verify\" ]; then\\n'\n        '  printf \\'{\"model\":\"slow\",\"model_version\":null,\"adapter_version\":\"slow-1\",'\n        '\"tokens\":{\"input\":1,\"output\":1},\"cost_usd\":0.0,\"findings\":[],\"tests_named\":[]}\\\\n\\'\\n'\n        \"  exit 0\\n\"\n        \"fi\\n\"\n        f\"sleep {sleep_s}\\n\"\n        \"echo built > built.txt\\n\"\n        \"git add built.txt\\n\"\n        \"git commit -q -m 'slow: write built.txt'\\n\"\n        'echo \\'{\"status\":\"done\",\"question\":null,\"model\":\"slow\",\"model_version\":null,'\n        '\"adapter_version\":\"slow-1\",\"tokens\":{\"input\":1,\"output\":1},\"cost_usd\":0.0}\\'\\n'\n    )\n    adapter_run.chmod(0o755)\n    toml = root / \"attavo.toml\"\n    toml.write_text(toml.read_text().replace('build = \"fixture\"', 'build = \"slow\"'))\n    commit_all(root, \"use a slow adapter for build\")\n\n    full_env = dict(os.environ)\n    full_env.update(FAST_POLL_ENV)\n    proc = subprocess.Popen(\n        [sys.executable, str(ATTAVO), \"drive\", \"1\", \"--until-ready\"],\n        cwd=str(root), stdout=subprocess.PIPE, stderr=subprocess.STDOUT,\n        text=True, env=full_env)\n\n    lines: \"queue.Queue[str | None]\" = queue.Queue()\n\n    def reader() -> None:\n        for raw in cast(IO[str], proc.stdout):\n            lines.put(raw)\n        lines.put(None)\n\n    thread = threading.Thread(target=reader, daemon=True)\n    thread.start()\n\n    try:\n        first_line = lines.get(timeout=sleep_s / 2)\n    except queue.Empty:\n        proc.kill()\n        raise\n    assert first_line is not None and \"Build started\" in first_line, first_line\n\n    collected = [first_line]\n    while True:\n        line = lines.get(timeout=sleep_s + 30)\n        if line is None:\n            break\n        collected.append(line)\n    thread.join(timeout=5)\n    proc.wait(timeout=5)\n\n    output = \"\".join(collected)\n    assert proc.returncode == 0, output\n    assert \"ready to merge\" in output.lower()\n\n\n\ndef test_drive_pass_reads_a_red_forge_as_blocked_and_starts_nothing(tmp_path: Path) -> None:\n    \"\"\"Acceptance row 4, as a level. A forge read where the one check has\n    already concluded and failed is not polled at all -- the pass reads\n    the forge once, says Blocked naming the check, exits 0, and starts\n    no review: no marker, no verify record, no new commit, no sleep.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, RED_FORGE)\n    add_bare_remote(root, tmp_path)\n    approve_item(root)\n\n    assert drive(root, \"1\").returncode == 0  # builds\n    pre_head = head_of(root)\n\n    started = time.monotonic()\n    run = drive(root, \"1\")\n    elapsed = time.monotonic() - started\n    assert run.returncode == 0, run.stdout + run.stderr\n    assert \"Blocked\" in run.stdout and \"ci failure\" in run.stdout\n    assert \"worker pid\" not in run.stdout\n    assert elapsed < 0.4, (\n        f\"a concluded, red forge check is read once with no poll interval slept \"\n        f\"-- took {elapsed:.2f}s\")\n\n    assert record_files(root, \"verify\") == []\n    assert not (records_dir(root) / \"verify-01.started\").exists()\n    assert head_of(root) == pre_head\n\n    # Idempotence (row 8): a pass in the same red state says the same,\n    # still nothing written.\n    run2 = drive(root, \"1\")\n    assert run2.returncode == 0\n    assert \"Blocked\" in run2.stdout\n    assert record_files(root, \"verify\") == []\n    assert head_of(root) == pre_head\n\n\n","numLines":140,"startLine":460,"totalLines":1099}}}

PROVENANCES = (\"product\", \"tenant\", \"executor\", \"spec\")\n42\t\n43\t# Beyond the enum spelling itself, the prose issue #88 actually shipped\n44\t# (adapters/claude-code/run and adapters/codex/run, on main since\n45\t# v0.16.0) once put a class's own name, or a real specimen's wording of\n46\t# it, in the transcript for the generic match below to find. Issue #94\n47\t# moves non-question and outlived-invocation onto report_class instead\n48\t# (below): non-question's own halt line (\"halted: class non-question\")\n49\t# would otherwise still satisfy the bare-name match here with no adapter\n50\t# report-line field involved at all, and outlived-invocation's refusal"}]},"parent_tool_use_id":null,"session_id":"ae622d81-efb9-4dda-92a0-5ebf75b0d73f","uuid":"51459942-2348-4e2e-acf4-65e86dcf5dc9","timestamp":"2026-09-26T03:27:49.570Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-219/attavo/stops.py","content":"from __future__ import annotations\n\nimport json\nimport re\nimport sys\nfrom pathlib import Path\nfrom typing import Any\n\nfrom attavo.common import MANIFEST, read_manifest\nfrom attavo.records import parse_attempts, stage_schema\nfrom attavo.types import CounselRecord, Stop\n\n# --- stop: every non-pass build or verify record's class and cause (issue\n# #89) -- derived here, at write time, from the refusal, halted, and log\n# the caller already has. Never a fresh read of anything: the tenant zero\n# specimens this retires (#576 build-11, #659 build-01 and verify-01) are\n# exactly a stop the product wrote with nothing beside it to explain\n# itself after the fact. ---\n\nSTOP_CLASSES = (\"non-question\", \"outlived-invocation\", \"no-cause\", \"forge-unconcluded\",\n               \"ceiling\", \"claims-boundary\", \"repeated-act\", \"unclassed\", \"question\",\n               \"environment\", \"gate\", \"died\", \"hung\", \"transient\", \"returned\")\n\n# R3: the four families a pass retries with no person involved -- every\n# other class is counsel's to read first, and a person's when counsel says\n# so (or when counsel is not configured at all).\nRETRYABLE_CLASSES = (\"died\", \"hung\", \"transient\", \"returned\")\n\n\ndef signature_of(text: str | None) -> str | None:\n    \"\"\"R3: a failure's signature, compared between attempts by plain string\n    equality -- text with every run of digits removed, so two stops that\n    differ only in a pid, a timestamp, or a retry-after count still match.\n    None for no text at all (nothing to sign).\"\"\"\n    if not text:\n        return None\n    stripped = re.sub(r\"[0-9]+\", \"\", text).strip()\n    return stripped or None\n\n\nSTOP_PROVENANCES = (\"product\", \"tenant\", \"executor\", \"spec\")\n\n# Beyond the enum spelling itself, the prose issue #88 actually shipped\n# (adapters/claude-code/run and adapters/codex/run, on main since\n# v0.16.0) once put a class's own name, or a real specimen's wording of\n# it, in the transcript for the generic match below to find. Issue #94\n# moves non-question and outlived-invocation onto report_class instead\n# (below): non-question's own halt line (\"halted: class non-question\")\n# would otherwise still satisfy the bare-name match here with no adapter\n# report-line field involved at all, and outlived-invocation's refusal","numLines":50,"startLine":1,"totalLines":380}}}

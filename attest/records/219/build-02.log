{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RkAbT27LcNJ5Y78zNphESm","type":"tool_result","content":"1\tfrom __future__ import annotations\n2\t\n3\timport json\n4\tfrom pathlib import Path\n5\tfrom typing import Any\n6\t\n7\tfrom attavo.common import STAGES, ShallowCheckoutError, git\n8\tfrom attavo.doctor import invocations_without_record, merge_introducing_records, stall_bound_s\n9\tfrom attavo.drive import InvocationReading, drive_state, read_invocation, uncommitted_record\n10\tfrom attavo.records import next_attempt_number, parse_attempts\n11\tfrom attavo.types import CounselRecord, DriveReport\n12\tfrom attavo.verify import FORGE_OK_CONCLUSIONS, FORGE_UNCONCLUDED_STATUSES, read_forge_checks\n13\t\n14\t# --- drive --report (reconciler R1, rulings A and G): what one item is\n15\t# waiting on, and for whom -- drive's own decision (drive_state, the\n16\t# invocation readers recovery uses, read_forge_checks) read without acting\n17\t# on it. It writes nothing, starts nothing, and reads the forge once and\n18\t# never polls it, so a refusal is a level anyone can read again rather than\n19\t# a line drive printed once. `says` speaks the operator's words: a stage is\n20\t# \"build\" or \"review\", never the command that runs it. ---\n21\t\n22\t_WORD = {\"build\": \"build\", \"verify\": \"review\"}\n23\t\n24\t_COUNSEL_SAYS = {\"answer\": \"has an answer\", \"patch\": \"found a product defect\",\n25\t                 \"person\": \"says it is a person's call\"}\n26\t\n27\t\n28\tdef _head(root: Path) -> str | None:\n29\t    try:\n30\t        return git(root, \"rev-parse\", \"HEAD\").strip() or None\n31\t    except RuntimeError:\n32\t        return None\n33\t\n34\t\n35\tdef _latest(records_dir: Path, stage: str) -> tuple[str, dict[str, Any]] | None:\n36\t    \"\"\"(stem, record) of the highest-numbered <stage>-NN.json, or None.\"\"\"\n37\t    attempts = parse_attempts(records_dir, stage)\n38\t    if not attempts:\n39\t        return None\n40\t    nn = max(attempts)\n41\t    return f\"{stage}-{nn:02d}\", attempts[nn]\n42\t\n43\t\n44\tdef _filed(records_dir: Path, stem: str) -> str | None:\n45\t    marker = records_dir / f\"{stem}.filed\"\n46\t    try:\n47\t        text = marker.read_text().strip()\n48\t    except OSError:\n49\t        return None\n50\t    return text or None\n51\t\n52\t\n53\tdef _counsel_of(records_dir: Path, stem: str) -> tuple[str, CounselRecord] | None:\n54\t    \"\"\"The latest counsel record that read the stop named stem.\"\"\"\n55\t    attempts = parse_attempts(records_dir, \"counsel\")\n56\t    for nn in sorted(attempts, reverse=True):\n57\t        if attempts[nn].get(\"record\") == stem:\n58\t            return f\"counsel-{nn:02d}\", attempts[nn]\n59\t    return None\n60\t\n61\t\n62\tdef _stopped(r: DriveReport, records_dir: Path, stage: str, stem: str, record: dict[str, Any]) -> DriveReport:\n63\t    stop = record.get(\"stop\") or {}\n64\t    stop_class = stop.get(\"class\")\n65\t    r[\"state\"], r[\"kind\"], r[\"stage\"] = \"stopped\", \"yours\", stage\n66\t    r[\"attempt\"], r[\"record\"], r[\"stop_class\"] = int(stem.rsplit(\"-\", 1)[1]), stem, stop_class\n67\t    r[\"filed\"] = _filed(records_dir, stem)\n68\t    how = f\"as {stop_class}\" if stop_class else f\"({record.get('status')})\"\n69\t    says = f\"Needs you: {_WORD[stage]} attempt {stem.rsplit('-', 1)[1]} stopped {how}\"\n70\t    counsel = _counsel_of(records_dir, stem)\n71\t    if counsel:\n72\t        r[\"counsel\"] = counsel[0]\n73\t        verdict = _COUNSEL_SAYS.get(str(counsel[1].get(\"verdict\")))\n74\t        says += f\"; {counsel[0]} {verdict or 'could not read it'}\"\n75\t    if r[\"filed\"]:\n76\t        says += f\"; filed as {r['filed']}\"\n77\t    r[\"says\"] = says\n78\t    return r\n79\t\n80\t\n81\tdef _invocation(r: DriveReport, reading: InvocationReading, info: dict[str, Any],\n82\t                bound: int | None) -> DriveReport:\n83\t    stage, nn, _log, _last_at, age, cls = reading\n84\t    r[\"stage\"], r[\"attempt\"], r[\"stop_class\"] = stage, nn, None if cls == \"running\" else cls\n85\t    r[\"since\"] = info.get(\"at\") if isinstance(info.get(\"at\"), str) else None\n86\t    r[\"last_event_age_s\"] = None if age is None else int(age)\n87\t    word = _WORD[stage]\n88\t    if cls == \"running\":\n89\t        r[\"state\"], r[\"kind\"] = \"running\", \"waits\"\n90\t        r[\"says\"] = (f\"{word.capitalize()} running since {r['since'] or 'an unknown time'}; \"\n91\t                     f\"nothing to do until it finishes\")\n92\t    else:\n93\t        r[\"state\"], r[\"kind\"] = \"owes-recovery\", \"acts\"\n94\t        if cls == \"hung\":\n95\t            r[\"says\"] = (f\"{word.capitalize()} attempt {nn:02d} is alive but has had no event for \"\n96\t                         f\"{r['last_event_age_s']} s (bound {bound} s); recovery would end it and \"\n97\t                         f\"record it as hung\")\n98\t        else:\n99\t            r[\"says\"] = (f\"{word.capitalize()} attempt {nn:02d} is gone and wrote no record; \"\n100\t                         f\"recovery would record it as died\")\n101\t    return r\n102\t\n103\t\n104\tdef _pending(root: Path, m: dict[str, Any], records_dir: Path, r: DriveReport) -> DriveReport | None:\n105\t    \"\"\"The report for an invocation that began and wrote no record, or None\n106\t    when every invocation has its record. One that needs recovery reads\n107\t    before one still running: it is the one the next move is about. R2:\n108\t    a bound is no longer required to read this at all -- read_invocation\n109\t    reads alive from the heartbeat first, and needs a stall bound only to\n110\t    call a live, heartbeat-less invocation hung rather than running.\"\"\"\n111\t    pending = invocations_without_record(records_dir)\n112\t    if not pending:\n113\t        return None\n114\t    bound = stall_bound_s(m)\n115\t    readings = [(read_invocation(root, bound, marker, info), info) for marker, info in pending]\n116\t    reading, info = next(((rd, i) for rd, i in readings if rd.cls != \"running\"), readings[0])\n117\t    if reading.stage not in _WORD:\n118\t        r[\"state\"], r[\"kind\"] = \"refused\", \"yours\"\n119\t        r[\"says\"] = f\"Found an invocation marker for an unknown stage, {reading.stage}\"\n120\t        return r\n121\t    if reading.cls != \"running\" and next_attempt_number(records_dir, reading.stage) != reading.nn:\n122\t        r[\"state\"], r[\"kind\"], r[\"stage\"], r[\"attempt\"] = \"refused\", \"yours\", reading.stage, reading.nn\n123\t        r[\"says\"] = (f\"{_WORD[reading.stage].capitalize()} attempt {reading.nn:02d} wrote no record, but a \"\n124\t                     f\"later one exists; read the records before recovering\")\n125\t        return r\n126\t    return _invocation(r, reading, info, bound)\n127\t\n128\t\n129\tdef _uncommitted(root: Path, m: dict[str, Any], records_dir: Path, r: DriveReport,\n130\t                 stage: str) -> DriveReport | None:\n131\t    \"\"\"R2: a record the working tree carries but git has no commit for yet\n132\t    -- the moment between a worker's write and its own commit -- reads as\n133\t    running for as long as the invocation it belongs to still touches its\n134\t    heartbeat; one a stale heartbeat left behind is a refusal naming the\n135\t    file, not a silent read of a record that was never actually\n136\t    transported. None when the latest record for stage is already\n137\t    committed (the ordinary case).\"\"\"\n138\t    path = uncommitted_record(root, records_dir, stage)\n139\t    if path is None:\n140\t        return None\n141\t    nn = int(path.stem.rsplit(\"-\", 1)[1])\n142\t    marker = records_dir / f\"{stage}-{nn:02d}.started\"\n143\t    info: dict[str, Any] = {}\n144\t    if marker.is_file():\n145\t        try:\n146\t            with marker.open() as fh:\n147\t                loaded = json.load(fh)\n148\t            info = loaded if isinstance(loaded, dict) else {}\n149\t        except (OSError, ValueError):\n150\t            info = {}\n151\t    bound = stall_bound_s(m)\n152\t    reading = read_invocation(root, bound, marker, info) if marker.is_file() else None\n153\t    word = _WORD[stage]\n154\t    if reading is not None and reading.cls == \"running\":\n155\t        r[\"state\"], r[\"kind\"], r[\"stage\"], r[\"attempt\"] = \"running\", \"waits\", stage, nn\n156\t        r[\"since\"] = info.get(\"at\") if isinstance(info.get(\"at\"), str) else None\n157\t        r[\"says\"] = (f\"{word.capitalize()} running; its {stage}-{nn:02d}.json is written but \"\n158\t                     f\"not yet committed\")\n159\t        return r\n160\t    r[\"state\"], r[\"kind\"] = \"refused\", \"yours\"\n161\t    r[\"says\"] = f\"{path.name} exists but was never committed; its worker's heartbeat went stale first\"\n162\t    return r\n163\t\n164\t\n165\tdef _checks(r: DriveReport, forge_checks: dict[str, Any], ok: bool, ready: bool) -> DriveReport:\n166\t    \"\"\"Read the forge's answer on the head as a level: green, still\n167\t    running, or done and not green.\"\"\"\n168\t    conclusions: list[dict[str, str]] = forge_checks[\"conclusions\"]\n169\t    r[\"checks\"] = [{\"name\": c[\"name\"], \"conclusion\": c[\"conclusion\"]} for c in conclusions]\n170\t    head7 = (r[\"head\"] or \"\")[:7]\n171\t    if ok:\n172\t        if ready:\n173\t            r[\"state\"], r[\"kind\"], r[\"says\"] = \"ready-to-merge\", \"yours\", \"Ready to merge\"\n174\t        else:\n175\t            r[\"state\"], r[\"kind\"], r[\"stage\"] = \"next-review\", \"acts\", \"verify\"\n176\t            r[\"says\"] = f\"Review is next; the checks are green on {head7}\"\n177\t        return r\n178\t    unconcluded = [c for c in conclusions if c[\"conclusion\"] in FORGE_UNCONCLUDED_STATUSES]\n179\t    if unconcluded or not conclusions:\n180\t        named = \", \".join(f\"{c['name']} {c['conclusion']}\" for c in unconcluded) or \"no checks reported\"\n181\t        r[\"state\"], r[\"kind\"], r[\"stage\"] = \"waiting-on-checks\", \"waits\", None if ready else \"verify\"\n182\t        r[\"says\"] = f\"Waiting on the checks: {named} on {head7}\"\n183\t        return r\n184\t    named = (\", \".join(f\"{c['name']} {c['conclusion']}\" for c in conclusions\n185\t                       if c[\"conclusion\"] not in FORGE_OK_CONCLUSIONS)\n186\t             or \"the checks command did not succeed\")\n187\t    r[\"state\"], r[\"kind\"], r[\"stage\"] = \"blocked-on-checks\", \"waits\", None if ready else \"verify\"\n188\t    after = \"the item is ready to merge\" if ready else \"review starts\"\n189\t    r[\"says\"] = f\"Blocked: {named} on {head7}; {after} once the checks are green\"\n190\t    return r\n191\t\n192\t\n193\tdef drive_report(root: Path, m: dict[str, Any], item_id: str) -> DriveReport:\n194\t    \"\"\"The item's level, from the same reads `attavo drive` decides on --\n195\t    drive_state over its records, the markers recovery reads, one read of\n196\t    the forge -- and never an act: no record written, nothing started, no\n197\t    poll. A state for every item the records directory carries.\"\"\"\n198\t    records_dir = root / m[\"paths\"][\"records\"] / item_id\n199\t    r: DriveReport = {\"item\": item_id, \"state\": \"refused\", \"kind\": \"yours\", \"says\": \"\", \"stage\": None,\n200\t                      \"attempt\": None, \"record\": None, \"stop_class\": None, \"counsel\": None,\n201\t                      \"filed\": None, \"head\": _head(root), \"checks\": None, \"since\": None,\n202\t                      \"last_event_age_s\": None}\n203\t\n204\t    merge, _ = merge_introducing_records(root, m[\"paths\"][\"records\"], item_id, STAGES)\n205\t    if merge:\n206\t        r[\"state\"], r[\"kind\"], r[\"says\"] = \"merged\", \"done\", f\"Merged in {merge[:7]}\"\n207\t        return r\n208\t\n209\t    try:\n210\t        step, why, _ = drive_state(root, m, item_id)\n211\t    except ShallowCheckoutError as exc:\n212\t        r[\"says\"] = f\"Cannot read this item: {exc}\"\n213\t        return r\n214\t    if step == \"no-approval\":\n215\t        r[\"state\"], r[\"kind\"] = \"waiting-on-approval\", \"yours\"\n216\t        r[\"says\"] = (\"Waiting on you: approve the spec\" if why == \"absent\" else\n217\t                     \"Waiting on you: the approval expired because the spec changed after it; \"\n218\t                     \"approve the spec again\")\n219\t        return r\n220\t\n221\t    pending = _pending(root, m, records_dir, r)\n222\t    if pending:\n223\t        return pending\n224\t\n225\t    if step in (\"build\", \"verify\"):\n226\t        held = _uncommitted(root, m, records_dir, r, step)\n227\t        if held:\n228\t            return held\n229\t\n230\t    build = _latest(records_dir, \"build\")\n231\t    if step == \"build\":\n232\t        approval = _latest(records_dir, \"approval\")\n233\t        if (build and build[1].get(\"status\") != \"pass\"\n234\t                and build[1].get(\"approval_sha\") == (approval[1].get(\"sha\") if approval else None)):\n235\t            return _stopped(r, records_dir, \"build\", build[0], build[1])\n236\t        r[\"state\"], r[\"kind\"], r[\"stage\"] = \"next-build\", \"acts\", \"build\"\n237\t        r[\"says\"] = \"Build is next\"\n238\t        return r\n239\t\n240\t    review = _latest(records_dir, \"verify\")\n241\t    if (step == \"verify\" and review and review[1].get(\"status\") != \"pass\"\n242\t            and build and review[1].get(\"build_sha\") == build[1].get(\"sha\")):\n243\t        return _stopped(r, records_dir, \"verify\", review[0], review[1])\n244\t\n245\t    checks_command = (m.get(\"forge\") or {}).get(\"checks_command\")\n246\t    if not checks_command:\n247\t        r[\"says\"] = \"No checks command is set in the manifest, so nothing can say whether the checks are green\"\n248\t        return r\n249\t    forge_checks, ok = read_forge_checks(root, checks_command, r[\"head\"] or \"\")\n250\t    return _checks(r, forge_checks, ok, ready=step == \"ready\")\n251\t"}]},"parent_tool_use_id":null,"session_id":"ae622d81-efb9-4dda-92a0-5ebf75b0d73f","uuid":"8b2f383f-6661-43e1-ba35-5778fbd986b7","timestamp":"2026-09-26T03:16:48.132Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-219/attavo/report.py","content":"from __future__ import annotations\n\nimport json\nfrom pathlib import Path\nfrom typing import Any\n\nfrom attavo.common import STAGES, ShallowCheckoutError, git\nfrom attavo.doctor import invocations_without_record, merge_introducing_records, stall_bound_s\nfrom attavo.drive import InvocationReading, drive_state, read_invocation, uncommitted_record\nfrom attavo.records import next_attempt_number, parse_attempts\nfrom attavo.types import CounselRecord, DriveReport\nfrom attavo.verify import FORGE_OK_CONCLUSIONS, FORGE_UNCONCLUDED_STATUSES, read_forge_checks\n\n# --- drive --report (reconciler R1, rulings A and G): what one item is\n# waiting on, and for whom -- drive's own decision (drive_state, the\n# invocation readers recovery uses, read_forge_checks) read without acting\n# on it. It writes nothing, starts nothing, and reads the forge once and\n# never polls it, so a refusal is a level anyone can read again rather than\n# a line drive printed once. `says` speaks the operator's words: a stage is\n# \"build\" or \"review\", never the command that runs it. ---\n\n_WORD = {\"build\": \"build\", \"verify\": \"review\"}\n\n_COUNSEL_SAYS = {\"answer\": \"has an answer\", \"patch\": \"found a product defect\",\n                 \"person\": \"says it is a person's call\"}\n\n\ndef _head(root: Path) -> str | None:\n    try:\n        return git(root, \"rev-parse\", \"HEAD\").strip() or None\n    except RuntimeError:\n        return None\n\n\ndef _latest(records_dir: Path, stage: str) -> tuple[str, dict[str, Any]] | None:\n    \"\"\"(stem, record) of the highest-numbered <stage>-NN.json, or None.\"\"\"\n    attempts = parse_attempts(records_dir, stage)\n    if not attempts:\n        return None\n    nn = max(attempts)\n    return f\"{stage}-{nn:02d}\", attempts[nn]\n\n\ndef _filed(records_dir: Path, stem: str) -> str | None:\n    marker = records_dir / f\"{stem}.filed\"\n    try:\n        text = marker.read_text().strip()\n    except OSError:\n        return None\n    return text or None\n\n\ndef _counsel_of(records_dir: Path, stem: str) -> tuple[str, CounselRecord] | None:\n    \"\"\"The latest counsel record that read the stop named stem.\"\"\"\n    attempts = parse_attempts(records_dir, \"counsel\")\n    for nn in sorted(attempts, reverse=True):\n        if attempts[nn].get(\"record\") == stem:\n            return f\"counsel-{nn:02d}\", attempts[nn]\n    return None\n\n\ndef _stopped(r: DriveReport, records_dir: Path, stage: str, stem: str, record: dict[str, Any]) -> DriveReport:\n    stop = record.get(\"stop\") or {}\n    stop_class = stop.get(\"class\")\n    r[\"state\"], r[\"kind\"], r[\"stage\"] = \"stopped\", \"yours\", stage\n    r[\"attempt\"], r[\"record\"], r[\"stop_class\"] = int(stem.rsplit(\"-\", 1)[1]), stem, stop_class\n    r[\"filed\"] = _filed(records_dir, stem)\n    how = f\"as {stop_class}\" if stop_class else f\"({record.get('status')})\"\n    says = f\"Needs you: {_WORD[stage]} attempt {stem.rsplit('-', 1)[1]} stopped {how}\"\n    counsel = _counsel_of(records_dir, stem)\n    if counsel:\n        r[\"counsel\"] = counsel[0]\n        verdict = _COUNSEL_SAYS.get(str(counsel[1].get(\"verdict\")))\n        says += f\"; {counsel[0]} {verdict or 'could not read it'}\"\n    if r[\"filed\"]:\n        says += f\"; filed as {r['filed']}\"\n    r[\"says\"] = says\n    return r\n\n\ndef _invocation(r: DriveReport, reading: InvocationReading, info: dict[str, Any],\n                bound: int | None) -> DriveReport:\n    stage, nn, _log, _last_at, age, cls = reading\n    r[\"stage\"], r[\"attempt\"], r[\"stop_class\"] = stage, nn, None if cls == \"running\" else cls\n    r[\"since\"] = info.get(\"at\") if isinstance(info.get(\"at\"), str) else None\n    r[\"last_event_age_s\"] = None if age is None else int(age)\n    word = _WORD[stage]\n    if cls == \"running\":\n        r[\"state\"], r[\"kind\"] = \"running\", \"waits\"\n        r[\"says\"] = (f\"{word.capitalize()} running since {r['since'] or 'an unknown time'}; \"\n                     f\"nothing to do until it finishes\")\n    else:\n        r[\"state\"], r[\"kind\"] = \"owes-recovery\", \"acts\"\n        if cls == \"hung\":\n            r[\"says\"] = (f\"{word.capitalize()} attempt {nn:02d} is alive but has had no event for \"\n                         f\"{r['last_event_age_s']} s (bound {bound} s); recovery would end it and \"\n                         f\"record it as hung\")\n        else:\n            r[\"says\"] = (f\"{word.capitalize()} attempt {nn:02d} is gone and wrote no record; \"\n                         f\"recovery would record it as died\")\n    return r\n\n\ndef _pending(root: Path, m: dict[str, Any], records_dir: Path, r: DriveReport) -> DriveReport | None:\n    \"\"\"The report for an invocation that began and wrote no record, or None\n    when every invocation has its record. One that needs recovery reads\n    before one still running: it is the one the next move is about. R2:\n    a bound is no longer required to read this at all -- read_invocation\n    reads alive from the heartbeat first, and needs a stall bound only to\n    call a live, heartbeat-less invocation hung rather than running.\"\"\"\n    pending = invocations_without_record(records_dir)\n    if not pending:\n        return None\n    bound = stall_bound_s(m)\n    readings = [(read_invocation(root, bound, marker, info), info) for marker, info in pending]\n    reading, info = next(((rd, i) for rd, i in readings if rd.cls != \"running\"), readings[0])\n    if reading.stage not in _WORD:\n        r[\"state\"], r[\"kind\"] = \"refused\", \"yours\"\n        r[\"says\"] = f\"Found an invocation marker for an unknown stage, {reading.stage}\"\n        return r\n    if reading.cls != \"running\" and next_attempt_number(records_dir, reading.stage) != reading.nn:\n        r[\"state\"], r[\"kind\"], r[\"stage\"], r[\"attempt\"] = \"refused\", \"yours\", reading.stage, reading.nn\n        r[\"says\"] = (f\"{_WORD[reading.stage].capitalize()} attempt {reading.nn:02d} wrote no record, but a \"\n                     f\"later one exists; read the records before recovering\")\n        return r\n    return _invocation(r, reading, info, bound)\n\n\ndef _uncommitted(root: Path, m: dict[str, Any], records_dir: Path, r: DriveReport,\n                 stage: str) -> DriveReport | None:\n    \"\"\"R2: a record the working tree carries but git has no commit for yet\n    -- the moment between a worker's write and its own commit -- reads as\n    running for as long as the invocation it belongs to still touches its\n    heartbeat; one a stale heartbeat left behind is a refusal naming the\n    file, not a silent read of a record that was never actually\n    transported. None when the latest record for stage is already\n    committed (the ordinary case).\"\"\"\n    path = uncommitted_record(root, records_dir, stage)\n    if path is None:\n        return None\n    nn = int(path.stem.rsplit(\"-\", 1)[1])\n    marker = records_dir / f\"{stage}-{nn:02d}.started\"\n    info: dict[str, Any] = {}\n    if marker.is_file():\n        try:\n            with marker.open() as fh:\n                loaded = json.load(fh)\n            info = loaded if isinstance(loaded, dict) else {}\n        except (OSError, ValueError):\n            info = {}\n    bound = stall_bound_s(m)\n    reading = read_invocation(root, bound, marker, info) if marker.is_file() else None\n    word = _WORD[stage]\n    if reading is not None and reading.cls == \"running\":\n        r[\"state\"], r[\"kind\"], r[\"stage\"], r[\"attempt\"] = \"running\", \"waits\", stage, nn\n        r[\"since\"] = info.get(\"at\") if isinstance(info.get(\"at\"), str) else None\n        r[\"says\"] = (f\"{word.capitalize()} running; its {stage}-{nn:02d}.json is written but \"\n                     f\"not yet committed\")\n        return r\n    r[\"state\"], r[\"kind\"] = \"refused\", \"yours\"\n    r[\"says\"] = f\"{path.name} exists but was never committed; its worker's heartbeat went stale first\"\n    return r\n\n\ndef _checks(r: DriveReport, forge_checks: dict[str, Any], ok: bool, ready: bool) -> DriveReport:\n    \"\"\"Read the forge's answer on the head as a level: green, still\n    running, or done and not green.\"\"\"\n    conclusions: list[dict[str, str]] = forge_checks[\"conclusions\"]\n    r[\"checks\"] = [{\"name\": c[\"name\"], \"conclusion\": c[\"conclusion\"]} for c in conclusions]\n    head7 = (r[\"head\"] or \"\")[:7]\n    if ok:\n        if ready:\n            r[\"state\"], r[\"kind\"], r[\"says\"] = \"ready-to-merge\", \"yours\", \"Ready to merge\"\n        else:\n            r[\"state\"], r[\"kind\"], r[\"stage\"] = \"next-review\", \"acts\", \"verify\"\n            r[\"says\"] = f\"Review is next; the checks are green on {head7}\"\n        return r\n    unconcluded = [c for c in conclusions if c[\"conclusion\"] in FORGE_UNCONCLUDED_STATUSES]\n    if unconcluded or not conclusions:\n        named = \", \".join(f\"{c['name']} {c['conclusion']}\" for c in unconcluded) or \"no checks reported\"\n        r[\"state\"], r[\"kind\"], r[\"stage\"] = \"waiting-on-checks\", \"waits\", None if ready else \"verify\"\n        r[\"says\"] = f\"Waiting on the checks: {named} on {head7}\"\n        return r\n    named = (\", \".join(f\"{c['name']} {c['conclusion']}\" for c in conclusions\n                       if c[\"conclusion\"] not in FORGE_OK_CONCLUSIONS)\n             or \"the checks command did not succeed\")\n    r[\"state\"], r[\"kind\"], r[\"stage\"] = \"blocked-on-checks\", \"waits\", None if ready else \"verify\"\n    after = \"the item is ready to merge\" if ready else \"review starts\"\n    r[\"says\"] = f\"Blocked: {named} on {head7}; {after} once the checks are green\"\n    return r\n\n\ndef drive_report(root: Path, m: dict[str, Any], item_id: str) -> DriveReport:\n    \"\"\"The item's level, from the same reads `attavo drive` decides on --\n    drive_state over its records, the markers recovery reads, one read of\n    the forge -- and never an act: no record written, nothing started, no\n    poll. A state for every item the records directory carries.\"\"\"\n    records_dir = root / m[\"paths\"][\"records\"] / item_id\n    r: DriveReport = {\"item\": item_id, \"state\": \"refused\", \"kind\": \"yours\", \"says\": \"\", \"stage\": None,\n                      \"attempt\": None, \"record\": None, \"stop_class\": None, \"counsel\": None,\n                      \"filed\": None, \"head\": _head(root), \"checks\": None, \"since\": None,\n                      \"last_event_age_s\": None}\n\n    merge, _ = merge_introducing_records(root, m[\"paths\"][\"records\"], item_id, STAGES)\n    if merge:\n        r[\"state\"], r[\"kind\"], r[\"says\"] = \"merged\", \"done\", f\"Merged in {merge[:7]}\"\n        return r\n\n    try:\n        step, why, _ = drive_state(root, m, item_id)\n    except ShallowCheckoutError as exc:\n        r[\"says\"] = f\"Cannot read this item: {exc}\"\n        return r\n    if step == \"no-approval\":\n        r[\"state\"], r[\"kind\"] = \"waiting-on-approval\", \"yours\"\n        r[\"says\"] = (\"Waiting on you: approve the spec\" if why == \"absent\" else\n                     \"Waiting on you: the approval expired because the spec changed after it; \"\n                     \"approve the spec again\")\n        return r\n\n    pending = _pending(root, m, records_dir, r)\n    if pending:\n        return pending\n\n    if step in (\"build\", \"verify\"):\n        held = _uncommitted(root, m, records_dir, r, step)\n        if held:\n            return held\n\n    build = _latest(records_dir, \"build\")\n    if step == \"build\":\n        approval = _latest(records_dir, \"approval\")\n        if (build and build[1].get(\"status\") != \"pass\"\n                and build[1].get(\"approval_sha\") == (approval[1].get(\"sha\") if approval else None)):\n            return _stopped(r, records_dir, \"build\", build[0], build[1])\n        r[\"state\"], r[\"kind\"], r[\"stage\"] = \"next-build\", \"acts\", \"build\"\n        r[\"says\"] = \"Build is next\"\n        return r\n\n    review = _latest(records_dir, \"verify\")\n    if (step == \"verify\" and review and review[1].get(\"status\") != \"pass\"\n            and build and review[1].get(\"build_sha\") == build[1].get(\"sha\")):\n        return _stopped(r, records_dir, \"verify\", review[0], review[1])\n\n    checks_command = (m.get(\"forge\") or {}).get(\"checks_command\")\n    if not checks_command:\n        r[\"says\"] = \"No checks command is set in the manifest, so nothing can say whether the checks are green\"\n        return r\n    forge_checks, ok = read_forge_checks(root, checks_command, r[\"head\"] or \"\")\n    return _checks(r, forge_checks, ok, ready=step == \"ready\")\n","numLines":251,"startLine":1,"totalLines":251}}}

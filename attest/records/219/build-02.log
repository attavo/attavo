{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01AzdYdMYc1GEiX1SzzKe3Cm","type":"tool_result","content":"185\tdef invocation_alive(info: dict[str, Any]) -> bool:\n186\t    \"\"\"Whether the marker's pid is a live process on this host. Another\n187\t    host's pid is unknowable from here and reads as not alive: a drive\n188\t    that ran elsewhere and wrote no record is died by absence.\"\"\"\n189\t    import os\n190\t    import socket\n191\t    if info.get(\"host\") != socket.gethostname():\n192\t        return False\n193\t    pid = info.get(\"pid\")\n194\t    if not isinstance(pid, int) or isinstance(pid, bool) or pid <= 0:\n195\t        return False\n196\t    try:\n197\t        os.kill(pid, 0)\n198\t    except ProcessLookupError:\n199\t        return False\n200\t    except PermissionError:\n201\t        return True\n202\t    return True\n203\t\n204\t\n205\tdef invocation_age_s(info: dict[str, Any]) -> float | None:\n206\t    \"\"\"Seconds since the marker's own `at` timestamp -- how long ago the\n207\t    invocation it names began, whatever host wrote it. None when `at` is\n208\t    missing or does not parse.\"\"\"\n209\t    from datetime import datetime, timezone\n210\t    at = info.get(\"at\")\n211\t    if not isinstance(at, str):\n212\t        return None\n213\t    try:\n214\t        stamp = datetime.strptime(at, \"%Y-%m-%dT%H:%M:%SZ\").replace(tzinfo=timezone.utc)\n215\t    except ValueError:\n216\t        return None\n217\t    return (datetime.now(timezone.utc) - stamp).total_seconds()\n218\t\n219\t\n220\tdef invocations_without_record(item_records_dir: Path) -> list[tuple[Path, dict[str, Any]]]:\n221\t    \"\"\"Every <stage>-NN.started under one item whose <stage>-NN.json has\n222\t    not arrived, with the marker's own dict ({} when unreadable).\"\"\"\n223\t    out: list[tuple[Path, dict[str, Any]]] = []\n224\t    if not item_records_dir.is_dir():\n225\t        return out\n226\t    for marker in sorted(item_records_dir.glob(f\"*{INVOCATION_MARKER_SUFFIX}\")):\n227\t        if (item_records_dir / f\"{marker.stem}.json\").is_file():\n228\t            continue\n229\t        try:\n230\t            with marker.open() as fh:\n231\t                info = json.load(fh)\n232\t        except (OSError, ValueError):\n233\t            info = {}\n234\t        out.append((marker, info if isinstance(info, dict) else {}))\n235\t    return out\n236\t\n237\t\n238\tdef stall_bound_s(m: dict[str, Any]) -> int | None:\n239\t    \"\"\"[drive].stall_after_s: the tenant's own bound past which a live\n240\t    invocation with no new event is hung. A bound the tenant did not\n241\t    write is a forecast, so there is no default.\"\"\"\n242\t    bound = (m.get(\"drive\") or {}).get(\"stall_after_s\")\n243\t    if isinstance(bound, bool) or not isinstance(bound, (int, float)) or bound <= 0:\n244\t        return None\n245\t    return int(bound)\n246\t\n247\t\n248\tdef ceiling_s(m: dict[str, Any], stage: str) -> int | None:\n249\t    \"\"\"R3: [drive.<stage>].ceiling_s, the wall clock past which a live\n250\t    invocation of that stage is hung by its ceiling, whatever event age\n251\t    says (or does not say, for an adapter that streams none). No\n252\t    default: a ceiling the tenant did not declare is not assumed.\"\"\"\n253\t    value = ((m.get(\"drive\") or {}).get(stage) or {}).get(\"ceiling_s\")\n254\t    if isinstance(value, bool) or not isinstance(value, (int, float)) or value <= 0:\n255\t        return None\n256\t    return int(value)\n257\t\n258\t\n259\tdef attempts_budget(m: dict[str, Any]) -> int:\n260\t    \"\"\"R3: [drive].attempts, the attempts a stage may spend -- across a\n261\t    plain retry, a returned retry, and a steered one alike -- before the\n262\t    item is a person's; 3 when the manifest does not say.\"\"\"\n263\t    value = (m.get(\"drive\") or {}).get(\"attempts\")\n264\t    if isinstance(value, bool) or not isinstance(value, int) or value < 1:\n265\t        return 3\n266\t    return value\
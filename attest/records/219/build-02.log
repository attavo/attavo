root, bound, marker, info)) for marker, info in pending]\n590\t    candidate = next(((mk, i, rd) for mk, i, rd in readings if rd.cls != \"running\"), None)\n591\t    if candidate is None:\n592\t        # The report read this a moment ago; nothing owed recovery by the\n593\t        # time this pass got here (another pass recovered it, or it\n594\t        # finished on its own).\n595\t        return 0\n596\t    marker, info, reading = candidate\n597\t    stage, nn, log, last_at, age, cls, crossed = reading\n598\t    pid, host = info.get(\"pid\"), info.get(\"host\")\n599\t\n600\t    if next_attempt_number(records_dir, stage) != nn:\n601\t        print(f\"attavo drive: stopped: {marker.name} names attempt {nn} but the next \"\n602\t              f\"{stage} record would be {next_attempt_number(records_dir, stage):02d}; \"\n603\t              f\"a later record already exists, read the records before recovering\")\n604\t        return 1\n605\t\n606\t    if cls == \"hung\":\n607\t        try:\n608\t            os.kill(cast(int, pid), signal.SIGTERM)\n609\t            ended = \"terminated\"\n610\t        except OSError as exc:\n611\t            ended = f\"not terminated ({exc})\"\n612\t        if crossed == \"ceiling\":\n613\t            detail = (f\"pid {pid} on {host} alive {int(cast(float, age))} s after its marker, \"\n614\t                      f\"past the {stage} ceiling of {ceiling_s(m, stage)} s; {ended}\")\n615\t        else:\n616\t            detail = (f\"pid {pid} on {host} alive with no event for {int(cast(float, age))} s \"\n617\t                      f\"(bound {bound} s); {ended}\")\n618\t    else:\n619\t        detail = (f\"pid {pid} on {host} is not running and wrote no {marker.stem}.json; \"\n620\t                  f\"started {info.get('at')}, last event {last_at or 'none'}\")\n621\t\n622\t    signature_text = log.strip().splitlines()[-1] if log.strip() else detail\n623\t\n624\t    schema = stage_schema(stage)\n625\t    record: dict[str, Any] = {k: None for k in schema.get(\"required\", [])}\n626\t    approval = latest_record(records_dir, \"approval\")\n627\t    record.update({\"sha\": info.get(\"sha\"), \"start_sha\": info.get(\"sha\"),\n628\t                   \"approval_sha\": approval.get(\"sha\") if approval else None,\n629\t                   \"at\": info.get(\"at\"),\n630\t                   \"adapter\": (m.get(\"executor\") or {}).get(stage),\n631\t                   \"status\": \"failed\", \"refusal\": None, \"halted\": None,\n632\t                   \"retry_of\": None, \"steer\": None,\n633\t                   \"stop\": {\"class\": cls, \"provenance\": \"product\", \"detail\": detail,\n634\t                            \"signature\": signature_of(signature_text), \"bound\": crossed}})\n635\t    if \"wall_clock_s\" in record:\n636\t        record[\"wall_clock_s\"] = None if age is None else int(age)\n637\t    record = {k: v for k, v in record.items() if k in schema.get(\"properties\", {})}\n638\t    try:\n639\t        path = write_record(records_dir, stage, record, m, item_id, log=log)\n640\t    except ValueError as exc:\n641\t        print(f\"attavo drive: stopped: could not write the {cls} record for {marker.stem}: {exc}\")\n642\t        return 1\n643\t    try:\n644\t        commit_record(root, [path], f\"attavo: {stage} record for item {item_id} \"\n645\t                                    f\"({path.stem}), recovered as {cls}\")\n646\t    except RuntimeError as exc:\n647\t        print(f\"attavo drive: stopped: could not commit the {cls} record: {exc}\")\n648\t        return 1\n649\t    if has_origin(root):\n650\t        ok, err = push_record_commit(root, branch)\n651\t        if not ok:\n652\t            print(f\"attavo drive: stopped: could not push the {cls} record: {err}\")\n653\t            return 1\n654\t    else:\n655\t        print(f\"attavo drive: note: no origin remote; {path.name} is committed, not pushed\")\n656\t    print(f\"attavo drive: recovered {marker.stem} as {cls}: {detail}\")\n657\t    return 0\n658\t\n659\t\n660\tdef _advance_again(root: Path, m: dict[str, Any], item_id: str, stage: str, head: str | None,\n661\t                   again_by: bool = False) -> int:\n662\t    \"\"\"The next attempt of a stopped stage, bypassing the level a plain\n663\t    pass leaves alone for the operator: what a plain retry (R3, inside\n664\t    the budget) starts on its own, and what `--again` starts by force\n665\t    once the budget is spent or an early stop fired. A review reads the\n666\t    forge fresh here -- once, since the report's own stopped reading\n667\t    never touched it -- rather than reusing a read that was never taken.\"\"\"\n668\t    if stage == \"build\":\n669\t        return _start_stage(root, m, item_id, \"build\", None, again_by=again_by)\n670\t    checks_command = (m.get(\"forge\") or {}).get(\"checks_command\")\n671\t    if not checks_command:\n672\t        print(\"attavo drive: refused: no [forge].checks_command in the manifest\")\n673\t        return 1\n674\t    forge_checks, ok = read_forge_checks(root, checks_command, cast(str, head))\n675\t    if not ok:\n676\t        conclusions = forge_checks[\"conclusions\"]\n677\t        named = \", \".join(f\"{c['name']} {c['conclusion']}\" for c in conclusions) or \"no checks reported\"\n678\t        print(f\"attavo drive: forge checks not green on {cast(str, head)[:12]}: {named}\")\n679\t        return 0\n680\t    return _start_stage(root, m, item_id, \"verify\", forge_checks, again_by=again_by)\n681\t\n682\t\n683\t# --- R3: the retry decision, shared by the report's own kind/says and the\n684\t# pass's own act (retry_state) so the two cannot drift. ---\n685\t\n686\t# Never retried by this item, whatever counsel might rule: a\n687\t# claims-boundary stop is a person's; a tenant's gate refusal is the\n688\t# spec-gate's own, earlier than any of this; an environment refusal is\n689\t# recorded here and acted on by R4's breaker. A question is not in this\n690\t# tuple -- counsel reads it exactly like any other non-pass record, and\n691\t# an \"answer\" verdict starts the next attempt steered by it, the same as\n692\t# any class counsel can rule on; a question nobody answers (no counsel\n693\t# configured, or its own verdict is \"person\") simply never becomes\n694\t# eligible, with no exclusion needed to keep it that way.\n695\tNEVER_RETRIED_CLASSES = (\"claims-boundary\", \"gate\", \"environment\")\n696\t\n697\t\n698\tdef _budget_stage(stage: str, stop_class: str | None) -> str:\n699\t    \"\"\"The stage whose [drive].attempts budget a stop spends -- build for"}]},"parent_tool_use_id":null,"session_id":"061dd881-711c-41db-8604-438f84ab7c7d","uuid":"7821153a-b13d-4569-b446-b074e6990f2b","timestamp":"2026-09-26T05:09:11.905Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-219/attavo/drive.py","content":"    env = dict(os.environ)\n    if forge_checks is not None:\n        checks_file = forge_checks_path(root, stage, nn)\n        checks_file.write_text(json.dumps(forge_checks))\n        env[\"ATTAVO_FORGE_CHECKS\"] = str(checks_file)\n    log = worker_log_path(root, stage, nn)\n    with log.open(\"ab\") as fh, open(os.devnull, \"rb\") as devnull:\n        proc = subprocess.Popen(\n            [sys.executable, str(PRODUCT_ROOT / \"bin\" / \"attavo\"), \"worker\", item_id, stage, f\"{nn:02d}\"],\n            cwd=str(root), env=env, stdin=devnull, stdout=fh, stderr=subprocess.STDOUT,\n            start_new_session=True)\n    word = \"Build\" if stage == \"build\" else \"Review\"\n    print(f\"attavo drive: {word} started (attempt {nn:02d}, worker pid {proc.pid})\")\n    return 0\n\n\ndef _recover_one(root: Path, m: dict[str, Any], item_id: str, records_dir: Path) -> int:\n    \"\"\"The pass's own recovery act (what `--recover` did): exactly the one\n    invocation the report just read as owing one -- died or hung -- ends\n    here. class died when the heartbeat is stale (or absent and the pid\n    is gone), class hung
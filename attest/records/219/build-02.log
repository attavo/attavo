{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0173xSf6tHPvtgnm1YcijWhb","type":"tool_result","content":"232\t    return r\n233\t\n234\t\n235\tdef drive_report(root: Path, m: dict[str, Any], item_id: str) -> DriveReport:\n236\t    \"\"\"The item's level, from the same reads `attavo drive` decides on --\n237\t    drive_state over its records, the markers recovery reads, one read of\n238\t    the forge -- and never an act: no record written, nothing started, no\n239\t    poll. A state for every item the records directory carries.\"\"\"\n240\t    records_dir = root / m[\"paths\"][\"records\"] / item_id\n241\t    r: DriveReport = {\"item\": item_id, \"state\": \"refused\", \"kind\": \"yours\", \"says\": \"\", \"stage\": None,\n242\t                      \"attempt\": None, \"record\": None, \"stop_class\": None, \"counsel\": None,\n243\t                      \"filed\": None, \"head\": _head(root), \"checks\": None, \"since\": None,\n244\t                      \"last_event_age_s\": None}\n245\t\n246\t    merge, _ = merge_introducing_records(root, m[\"paths\"][\"records\"], item_id, STAGES)\n247\t    if merge:\n248\t        r[\"state\"], r[\"kind\"], r[\"says\"] = \"merged\", \"done\", f\"Merged in {merge[:7]}\"\n249\t        return r\n250\t\n251\t    try:\n252\t        step, why, _ = drive_state(root, m, item_id)\n253\t    except ShallowCheckoutError as exc:\n254\t        r[\"says\"] = f\"Cannot read this item: {exc}\"\n255\t        return r\n256\t    if step == \"no-approval\":\n257\t        r[\"state\"], r[\"kind\"] = \"waiting-on-approval\", \"yours\"\n258\t        r[\"says\"] = (\"Waiting on you: approve the spec\" if why == \"absent\" else\n259\t                     \"Waiting on you: the approval expired because the spec changed after it; \"\n260\t                     \"approve the spec again\")\n261\t        return r\n262\t\n263\t    pending = _pending(root, m, records_dir, r)\n264\t    if pending:\n265\t        return pending\n266\t\n267\t    if step in (\"build\", \"verify\"):\n268\t        held = _uncommitted(root, m, records_dir, r, step)\n269\t        if held:\n270\t            return held\n271\t\n272\t    build = _latest(records_dir, \"build\")\n273\t    if step == \"build\":\n274\t        approval = _latest(records_dir, \"approval\")\n275\t        if (build and build[1].get(\"status\") != \"pass\"\n276\t                and build[1].get(\"approval_sha\") == (approval[1].get(\"sha\") if approval else None)):\n277\t            return _stopped(r, records_dir, \"build\", build[0], build[1])\n278\t        r[\"state\"], r[\"kind\"], r[\"stage\"] = \"next-build\", \"acts\", \"build\"\n279\t        r[\"says\"] = \"Build is next\"\n280\t        return r\n281\t\n282\t    review = _latest(records_dir, \"verify\")\n283\t    if (step == \"verify\" and review and review[1].get(\"status\") != \"pass\"\n284\t            and build and review[1].get(\"build_sha\") == build[1].get(\"sha\")):\n285\t        return _stopped(r, records_dir, \"verify\", review[0], review[1])\n286\t\n287\t    checks_command = (m.get(\"forge\") or {}).get(\"checks_command\")\n288\t    if not checks_command:\n289\t        r[\"says\"] = \"No checks command is set in the manifest, so nothing can say whether the checks are green\"\n290\t        return r\n291\t    forge_checks, ok = read_forge_checks(root, checks_command, r[\"head\"] or \"\")\n292\t    return _checks(r, forge_checks, ok, ready=step == \"ready\")\n293\t"}]},"parent_tool_use_id":null,"session_id":"ae622d81-efb9-4dda-92a0-5ebf75b0d73f","uuid":"c9a53cce-a694-4ff2-be33-810a258502a0","timestamp":"2026-09-26T03:39:26.846Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-219/attavo/report.py","content":"    return r\n\n\ndef drive_report(root: Path, m: dict[str, Any], item_id: str) -> DriveReport:\n    \"\"\"The item's level, from the same reads `attavo drive` decides on --\n    drive_state over its records, the markers recovery reads, one read of\n    the forge -- and never an act: no record written, nothing started, no\n    poll. A state for every item the records directory carries.\"\"\"\n    records_dir = root / m[\"paths\"][\"records\"] / item_id\n    r: DriveReport = {\"item\": item_id, \"state\": \"refused\", \"kind\": \"yours\", \"says\": \"\", \"stage\": None,\n                      \"attempt\": None, \"record\": None, \"stop_class\": None, \"counsel\": None,\n                      \"filed\": None, \"head\": _head(root), \"checks\": None, \"since\": None,\n                      \"last_event_age_s\": None}\n\n    merge, _ = merge_introducing_records(root, m[\"paths\"][\"records\"], item_id, STAGES)\n    if merge:\n        r[\"state\"], r[\"kind\"], r[\"says\"] = \"merged\", \"done\", f\"Merged in {merge[:7]}\"\n        return r\n\n    try:\n        step, why, _ = drive_state(root, m, item_id)\n    except ShallowCheckoutError as exc:\n        r[\"says\"] = f\"Cannot read this item: {exc}\"\n        return r\n    if step == \"no-approval\":\n        r[\"state\"], r[\"kind\"] = \"waiting-on-approval\", \"yours\"\n        r[\"says\"] = (\"Waiting on you: approve the spec\" if why == \"absent\" else\n                     \"Waiting on you: the approval expired because the spec changed after it; \"\n                     \"approve the spec again\")\n        return r\n\n    pending = _pending(root, m, records_dir, r)\n    if pending:\n        return pending\n\n    if step in (\"build\", \"verify\"):\n        held = _uncommitted(root, m, records_dir, r, step)\n        if held:\n            return held\n\n    build = _latest(records_dir, \"build\")\n    if step == \"build\":\n        approval = _latest(records_dir, \"approval\")\n        if (build and build[1].get(\"status\") != \"pass\"\n                and build[1].get(\"approval_sha\") == (approval[1].get(\"sha\") if approval else None)):\n            return _stopped(r, records_dir, \"build\", build[0], build[1])\n        r[\"state\"], r[\"kind\"], r[\"stage\"] = \"next-build\", \"acts\", \"build\"\n        r[\"says\"] = \"Build is next\"\n        return r\n\n    review = _latest(records_dir, \"verify\")\n    if (step == \"verify\" and review and review[1].get(\"status\") != \"pass\"\n            and build and review[1].get(\"build_sha\") == build[1].get(\"sha\")):\n        return _stopped(r, records_dir, \"verify\", review[0], review[1])\n\n    checks_command = (m.get(\"forge\") or {}).get(\"checks_command\")\n    if not checks_command:\n        r[\"says\"] = \"No checks command is set in the manifest, so nothing can say whether the checks are green\"\n        return r\n    forge_checks, ok = read_forge_checks(root, checks_command, r[\"head\"] or \"\")\n    return _checks(r, forge_checks, ok, ready=step == \"ready\")\n","numLines":62,"startLine":232,"totalLines":293}}}

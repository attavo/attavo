{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PG6gtjwKgabVruwKShZhC6","type":"tool_result","content":"1\tfrom __future__ import annotations\n2\t\n3\timport json\n4\timport sys\n5\tfrom pathlib import Path\n6\tfrom typing import Any\n7\t\n8\tfrom attavo.common import MANIFEST, read_manifest\n9\tfrom attavo.records import parse_attempts, stage_schema\n10\tfrom attavo.types import CounselRecord, Stop\n11\t\n12\t# --- stop: every non-pass build or verify record's class and cause (issue\n13\t# #89) -- derived here, at write time, from the refusal, halted, and log\n14\t# the caller already has. Never a fresh read of anything: the tenant zero\n15\t# specimens this retires (#576 build-11, #659 build-01 and verify-01) are\n16\t# exactly a stop the product wrote with nothing beside it to explain\n17\t# itself after the fact. ---\n18\t\n19\tSTOP_CLASSES = (\"non-question\", \"outlived-invocation\", \"no-cause\", \"forge-unconcluded\",\n20\t               \"ceiling\", \"claims-boundary\", \"repeated-act\", \"unclassed\", \"question\",\n21\t               \"environment\", \"gate\", \"died\", \"hung\")\n22\t\n23\tSTOP_PROVENANCES = (\"product\", \"tenant\", \"executor\", \"spec\")\n24\t\n25\t# Beyond the enum spelling itself, the prose issue #88 actually shipped\n26\t# (adapters/claude-code/run and adapters/codex/run, on main since\n27\t# v0.16.0) once put a class's own name, or a real specimen's wording of\n28\t# it, in the transcript for the generic match below to find. Issue #94\n29\t# moves non-question and outlived-invocation onto report_class instead\n30\t# (below): non-question's own halt line (\"halted: class non-question\")\n31\t# would otherwise still satisfy the bare-name match here with no adapter\n32\t# report-line field involved at all, and outlived-invocation's refusal\n33\t# never named its class in text to begin with, so both are disabled here\n34\t# -- the same pattern issue #93 established for ceiling, just below,\n35\t# rather than removed outright.\n36\tCLASS_TEXT_MARKERS: dict[str, tuple[str, ...]] = {\n37\t    \"non-question\": (),\n38\t    \"outlived-invocation\": (),\n39\t    # Issue #93: ceiling's own text-based check is CEILING_MARKERS, below,\n40\t    # with provenance \"product\" -- a fact about the tool, not an executor\n41\t    # judgment like non-question/outlived-invocation are. Left at the\n42\t    # default (the class's own name, \"ceiling\"), the generic match above\n43\t    # would instead catch adapters/codex/run's and\n44\t    # adapters/claude-code/run's own pre-emptive refusal -- which must\n45\t    # carry the word \"ceiling\" by the same issue's own brief -- as\n46\t    # provenance \"executor\", before CEILING_MARKERS is ever consulted.\n47\t    \"ceiling\": (),\n48\t    # A genuine question (issue #100's own followups) is read structurally\n49\t    # -- status \"halted\" carrying a non-empty halted.question -- not by\n50\t    # scanning for the literal word \"question\", which the question's own\n51\t    # text very often contains regardless of what it is actually asking.\n52\t    # Left at the default, the generic match above would misclassify any\n53\t    # question that happens to use the word \"question\" as executor\n54\t    # provenance, before the structural check in derive_stop is reached.\n55\t    \"question\": (),\n56\t    # environment/tenant (issue #115) is set directly by cmd_build's own\n57\t    # preflight -- the one caller who knows a [checks].command exited 2\n58\t    # on the approved tree -- never derived from adapter text. Left at\n59\t    # the default, the generic match above would catch the word\n60\t    # \"environment\" anywhere in a log or refusal (e.g. codex's own\n61\t    # OPENAI_API_KEY auth-mismatch refusal, adapters/codex/run's\n62\t    # check_auth) as an environment/executor stop that never happened.\n63\t    \"environment\": (),\n64\t}\n65\t\n66\t# Known tool error text for a declared ceiling -- issue #86's own specimen\n67\t# (codex's \"Input exceeds...\" line on a diff too large to judge) is\n68\t# \"input_too_large\"; a matching line anywhere in the log, not only its\n69\t# last line, since cmd_build and cmd_verify both append \"[adapter exited\n70\t# N]\" after whatever the tool itself printed. \"ceiling exceeded\" is issue\n71\t# #93's own addition: both adapters now refuse pre-emptively, before the\n72\t# tool is ever invoked, against a declared or fixed input limit, and\n73\t# their refusal text is not caught by any of the three markers above.\n74\tCEILING_MARKERS = (\"input_too_large\", \"exceeds the maximum context length\",\n75\t                  \"context_length_exceeded\", \"ceiling exceeded\")\n76\t\n77\t\n78\t# Issue #100's followups: an unclassed detail is the log's last line\n79\t# verbatim, and that line is sometimes an adapter's own event JSON or a\n80\t# tool's full error text -- thousands of characters wide. Capped here,\n81\t# at write time, so a filed issue's own summary of it (file-stops'\n82\t# log_tail already carries the full picture) stays short; the class\n83\t# itself, \"unclassed\", already says the full explanation lives in the\n84\t# log, not in this field.\n85\tUNCLASSED_DETAIL_MAX_CHARS = 200\n86\t\n87\t\n88\tdef _log_last_line(log: str | None) -> str:\n89\t    lines = [l for l in (log or \"\").splitlines() if l.strip()]\n90\t    last = lines[-1] if lines else \"\"\n91\t    return last[:UNCLASSED_DETAIL_MAX_CHARS]\n92\t\n93\t\n94\tdef _carries_a_known_class(text: str | None) -> str | None:\n95\t    \"\"\"Whichever of STOP_CLASSES this text names -- its own spelling, or\n96\t    one of CLASS_TEXT_MARKERS' real-world phrasings of it, when that\n97\t    class is not disabled there -- or None. Issue #88 is where an\n98\t    adapter's own halt or refusal first named its class this way; issue\n99\t    #93 added ceiling's own pre-emptive refusal to that set and disabled\n100\t    its bare-name match (CEILING_MARKERS covers it instead); issue #94\n101\t    disables non-question and outlived-invocation the same way, reading\n102\t    both from the adapter's own report line (derive_stop's report_class)\n103\t    now instead.\"\"\"\n104\t    text = text or \"\"\n105\t    for name in STOP_CLASSES:\n106\t        markers = CLASS_TEXT_MARKERS.get(name, (name,))\n107\t        if any(marker in text for marker in markers):\n108\t            return name\n109\t    return None\n110\t\n111\t\n112\tdef derive_stop(status: str, *, refusal: str | None = None, halted: dict[str, Any] | None = None,\n113\t                log: str | None = None, report_class: str | None = None,\n114\t                refusal_provenance: str | None = None) -> Stop | None:\n115\t    \"\"\"The stop field for a build or verify record: None for status \"pass\",\n116\t    else {class, provenance, detail} from what the caller already knows.\n117\t\n118\t      - report_class -- payload.get(\"class\") off the adapter's own report\n119\t        line (issue #88, #94), when it names a STOP_CLASSES member -- is\n120\t        that class, provenance \"executor\". build.schema.json and\n121\t        verify.schema.json stay untouched by issue #88 on purpose, so the\n122\t        class lives only on the report line, never a structured field\n123\t        cmd_build or cmd_verify forwards on its own account; the caller\n124\t        reads payload itself and passes this in, since only it still has\n125\t        payload once an iteration ends. This is non-question's and\n126\t        outlived-invocation's only path to a record now (issue #94):\n127\t        CLASS_TEXT_MARKERS disables both for the text scan below, the\n128\t        same way issue #93 disabled ceiling's bare-name match there. A\n129\t        class an adapter does not yet put on its report line --\n130\t        outlived-invocation today, since that refusal path prints no\n131\t        report line at all -- falls to unclassed below, same as any\n132\t        other unnamed cause, until the adapter that raises it puts a\n133\t        class on the line the way non-question already does.\n134\t      - a halt carrying a non-empty halted.question, once it is not a\n135\t        non-question caught above, is a genuine question -- question/spec,\n136\t        with the question's own first line as detail (issue #100's\n137\t        followups). This is the specimen issue #100 itself was built to\n138\t        retire: tenant zero's #663 build-01, a proper question, classed\n139\t        unclassed/product and filed as a product defect with the wrong\n140\t        provenance -- a question is about the definition of done, which is\n141\t        a person's or a ruling's to answer, never the product's own\n142\t        mechanism.\n143\t      - failing that, a refusal or the log itself that already names its\n144\t        class in text (issue #88, #93 for ceiling's own pre-emptive\n145\t        refusal) is that class, provenance \"executor\" -- the log is\n146\t        checked because neither adapter's refusal *field* carries the\n147\t        class today; the class-naming line each adapter prints reaches\n148\t        only the transcript\n149\t      - a refusal that is not that -- the write-outside-claims path\n150\t        itself, not the \"commit ... not authored by the executor\" shape\n151\t        -- is claims-boundary/spec, unless the caller already knows this\n152\t        refusal touched paths.records or paths.specs (issue #140:\n153\t        protected_path_touched, checked ahead of the ordinary claims\n154\t        match in cmd_build) and passes refusal_provenance=\"executor\" --\n155\t        the product's own directories are not a claim a spec makes, so a\n156\t        refusal there is not the spec's boundary to answer for\n157\t      - a returned verify (the forge was not green; no adapter ran) is\n158\t        forge-unconcluded/tenant\n159\t      - an adapter exit whose log carries a declared-ceiling error line is\n160\t        ceiling/product\n161\t      - anything else is unclassed/product, with the log's last line\n162\t        (capped at UNCLASSED_DETAIL_MAX_CHARS) as its detail -- the other\n163\t        class that carries a detail, since every remaining class's\n164\t        evidence already lives in refusal, halted, forge_checks, or the\n165\t        log itself.\n166\t    \"\"\"\n167\t    if status == \"pass\":\n168\t        return None\n169\t    if status == \"returned\":\n170\t        return {\"class\": \"forge-unconcluded\", \"provenance\": \"tenant\", \"detail\": None}\n171\t    if report_class in STOP_CLASSES:\n172\t        return {\"class\": report_class, \"provenance\": \"executor\", \"detail\": None}\n173\t    question = (halted or {}).get(\"question\")\n174\t    if status == \"halted\" and question:\n175\t        return {\"class\": \"question\", \"provenance\": \"spec\",\n176\t               \"detail\": question.splitlines()[0]}\n177\t    known = _carries_a_known_class(refusal) or _carries_a_known_class(log)\n178\t    if known:\n179\t        return {\"class\": known, \"provenance\": \"executor\", \"detail\": None}\n180\t    if status == \"refused\" and refusal is not None and not refusal.startswith(\"commit \"):\n181\t        return {\"class\": \"claims-boundary\", \"provenance\": refusal_provenance or \"spec\",\n182\t               \"detail\": None}\n183\t    if log and any(marker in log.lower() for marker in CEILING_MARKERS):\n184\t        return {\"class\": \"ceiling\", \"provenance\": \"product\", \"detail\": None}\n185\t    return {\"class\": \"unclassed\", \"provenance\": \"product\", \"detail\": _log_last_line(log)}\n186\t\n187\t\n188\tdef gate_stop(refusal: str | None) -> Stop:\n189\t    \"\"\"The stop for a refused spec-gate record: class \"gate\", provenance\n190\t    \"spec\", the refusal string itself as cause (issue #137) -- not\n191\t    derive_stop's generic claims-boundary/spec fallback issue #133\n192\t    reused, which named a boundary the record never crossed: \"criterion\n193\t    fails against the tree plus stub: doctor-template-absent.sh\" is not\n194\t    a write outside claims. cmd_spec_gate is untouched by this lane, so\n195\t    a spec record still carries no stop field of its own; this is\n196\t    synthesized wherever a refused one is read (item_stops,\n197\t    cmd_file_stops, proof_no_stop_lacks_cause), never persisted.\"\"\"\n198\t    return {\"class\": \"gate\", \"provenance\": \"spec\", \"detail\": refusal}\n199\t\n200\t\n201\t# --- stops: every non-pass record by class, provenance, and answerer\n202\t# (issue #129) ---\n203\t\n204\tdef item_stops(root: Path, m: dict[str, Any], item_id: str) -> dict[str, Any]:\n205\t    \"\"\"{\"item\", \"rows\", \"totals\"}: one row per non-pass build or verify\n206\t    record (STOP_STAGES), plus every refused spec-gate record (issue\n207\t    #133), class \"gate\" (issue #137) -- read from status and refusal\n208\t    rather than a stop field spec-gate records never carry (gate_stop\n209\t    synthesizes it) -- under item_id, whatever the record's own\n210\t    record_version -- a record too old to carry stop at all still gets\n211\t    a row, its class printed as the doctor's own phrase for it.\n212\t\n213\t    The answerer, a closed choice: \"counsel:<verdict>\" when\n214\t    counsel_record_for finds a counsel record naming this exact stage and\n215\t    number -- the product's own answer, which wins over whatever the stop\n216\t    itself says, since a counseled stop was already read once; failing\n217\t    that, \"person\" for class question (a person's to answer, not a\n218\t    guard's); failing that, \"guard\" for a class in GUARDED_STOP_CLASSES\n219\t    (a guard's own rejection needed no further reading); anything else\n220\t    -- no-cause, unclassed, or no stop at all -- is \"none\": nobody has\n221\t    answered it yet.\"\"\"\n222\t    records_rel = m[\"paths\"][\"records\"]\n223\t    item_records_dir = root / records_rel / item_id\n224\t    by_class = {c: 0 for c in stop_class_enum()}\n225\t    by_answerer: dict[str, int] = {}\n226\t    before_stop_was_recorded = 0\n227\t    rows: list[dict[str, Any]] = []\n228\t\n229\t    def add_row(stage: str, n: int, stop: Stop | None) -> None:\n230\t        nonlocal before_stop_was_recorded\n231\t        name = f\"{stage}-{n:02d}\"\n232\t        marker = item_records_dir / f\"{name}.filed\"\n233\t        filed_issue = marker.read_text() if marker.is_file() else None\n234\t        counsel = counsel_record_for(item_records_dir, stage, n)\n235\t\n236\t        if counsel is not None:\n237\t            answerer = f\"counsel:{counsel.get('verdict')}\"\n238\t        elif stop and stop.get(\"class\") == \"question\":\n239\t            answerer = \"person\"\n240\t        elif stop and stop.get(\"class\") in GUARDED_STOP_CLASSES:\n241\t            answerer = \"guard\"\n242\t        else:\n243\t            answerer = \"none\"\n244\t\n245\t        if stop:\n246\t            cls, provenance, detail = (stop.get(\"class\"), stop.get(\"provenance\"),\n247\t                                      stop.get(\"detail\"))\n248\t            if cls in by_class:\n249\t                by_class[cls] += 1\n250\t        else:\n251\t            cls, provenance, detail = \"before stop was recorded\", None, None\n252\t            before_stop_was_recorded += 1\n253\t\n254\t        by_answerer[answerer] = by_answerer.get(answerer, 0) + 1\n255\t        rows.append({\"item\": item_id, \"record\": name, \"class\": cls,\n256\t                    \"provenance\": provenance, \"detail\": detail,\n257\t                    \"answerer\": answerer, \"filed_issue\": filed_issue})\n258\t\n259\t    if item_records_dir.is_dir():\n260\t        for stage in STOP_STAGES:\n261\t            for n, rec in sorted(parse_attempts(item_records_dir, stage).items()):\n262\t                if rec.get(\"status\") == \"pass\":\n263\t                    continue\n264\t                add_row(stage, n, rec.get(\"stop\"))\n265\t        for n, rec in sorted(parse_attempts(item_records_dir, \"spec\").items()):\n266\t            if rec.get(\"status\") != \"refused\":\n267\t                continue\n268\t            add_row(\"spec\", n, gate_stop(rec.get(\"refusal\")))\n269\t\n270\t    totals = {\"by_class\": by_class, \"by_answerer\": by_answerer,\n271\t             \"before_stop_was_recorded\": before_stop_was_recorded}\n272\t    return {\"item\": item_id, \"rows\": rows, \"totals\": totals}\n273\t\n274\t\n275\tdef cmd_stops(argv: list[str]) -> int:\n276\t    as_json = \"--json\" in argv\n277\t    positional = [a for a in argv if a != \"--json\"]\n278\t    root = Path(\".\").resolve()\n279\t    m = read_manifest(root)\n280\t    if m is None:\n281\t        print(f\"attavo stops: no {MANIFEST} at {root}\", file=sys.stderr)\n282\t        return 2\n283\t\n284\t    records_rel = m[\"paths\"][\"records\"]\n285\t    if positional:\n286\t        item_ids = [positional[0]]\n287\t    else:\n288\t        records_root = root / records_rel\n289\t        item_ids = (sorted((p.name for p in records_root.iterdir() if p.is_dir()))\n290\t                   if records_root.is_dir() else [])\n291\t\n292\t    reports = [item_stops(root, m, item_id) for item_id in item_ids]\n293\t\n294\t    if as_json:\n295\t        if positional:\n296\t            print(json.dumps(reports[0], indent=2))\n297\t        else:\n298\t            print(json.dumps({\"items\": reports}, indent=2))\n299\t        return 0\n300\t\n301\t    for entry in reports:\n302\t        print(f\"attavo stops: item {entry['item']}\")\n303\t        for row in entry[\"rows\"]:\n304\t            filed = f\"  filed: {row['filed_issue'].strip()}\" if row[\"filed_issue\"] else \"\"\n305\t            print(f\"  {row['record']:<10} {row['class']:<24} {row['provenance'] or '-':<10} \"\n306\t                 f\"{row['answerer']:<16}{filed}\")\n307\t        t = entry[\"totals\"]\n308\t        print(f\"  by class: {t['by_class']}\")\n309\t        print(f\"  by answerer: {t['by_answerer']}\")\n310\t        print(f\"  before stop was recorded: {t['before_stop_was_recorded']}\")\n311\t    if not reports:\n312\t        print(f\"attavo stops: no item found under {records_rel}\")\n313\t    return 0\n314\t\n315\t\n316\t# The stop classes issue #89 gave no code of their own beyond the guard\n317\t# that raised them -- non-question and outlived-invocation from an\n318\t# adapter's own pre-emptive refusal, forge-unconcluded from a returned\n319\t# verify, ceiling from a declared-input-limit error, claims-boundary from\n320\t# the write-outside-claims refusal, repeated-act from... the same shape,\n321\t# environment from cmd_build's own [checks].command preflight (issue\n322\t# #115). question (a person's to answer) and the residual (no-cause,\n323\t# unclassed -- nobody has looked yet) are not in this tuple; attavo stops\n324\t# (issue #129) is the one reader, so it lives beside driver_identity,\n325\t# not beside derive_stop, which never needs to tell a guard from any\n326\t# other class once it has already named one.\n327\tGUARDED_STOP_CLASSES = (\"non-question\", \"outlived-invocation\", \"forge-unconcluded\", \"ceiling\",\n328\t                        \"claims-boundary\", \"repeated-act\", \"environment\")\n329\t\n330\t\n331\tdef stop_class_enum() -> tuple[str, ...]:\n332\t    \"\"\"Every class a stop can name, read from the build record schema's own\n333\t    enum (issue #129) rather than retyped -- STOP_CLASSES already drifted\n334\t    once (environment arrived in the schema before anything but derive_stop\n335\t    read it); a second copy is a second place to forget. build's schema is\n336\t    read, not verify's: verify's own enum is a strict subset (it never\n337\t    raises environment, cmd_build's own preflight alone).\"\"\"\n338\t    schema = stage_schema(\"build\")\n339\t    return tuple(schema[\"properties\"][\"stop\"][\"properties\"][\"class\"][\"enum\"])\n340\t\n341\t\n342\tSTOP_STAGES = (\"build\", \"verify\")\n343\t\n344\t\n345\tdef counsel_record_for(item_records_dir: Path, stage: str, n: int) -> CounselRecord | None:\n346\t    \"\"\"The latest counsel-NN.json (issue #100) whose own \"record\" field\n347\t    names f\"{stage}-{n:02d}\" -- the counsel invocation, if any, that read\n348\t    this exact stage record -- or None when counsel never ran against it\n349\t    (e.g. file-stops run standalone, outside drive).\"\"\"\n350\t    target = f\"{stage}-{n:02d}\"\n351\t    attempts = parse_attempts(item_records_dir, \"counsel\")\n352\t    matches = [rec for _, rec in sorted(attempts.items()) if rec.get(\"record\") == target]\n353\t    return matches[-1] if matches else None\n354\t"}]},"parent_tool_use_id":null,"session_id":"ae622d81-efb9-4dda-92a0-5ebf75b0d73f","uuid":"86f8ef33-7824-4544-9e9c-2da566689204","timestamp":"2026-09-26T03:16:45.119Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-219/attavo/stops.py","content":"from __future__ import annotations\n\nimport json\nimport sys\nfrom pathlib import Path\nfrom typing import Any\n\nfrom attavo.common import MANIFEST, read_manifest\nfrom attavo.records import parse_attempts, stage_schema\nfrom attavo.types import CounselRecord, Stop\n\n# --- stop: every non-pass build or verify record's class and cause (issue\n# #89) -- derived here, at write time, from the refusal, halted, and log\n# the caller already has. Never a fresh read of anything: the tenant zero\n# specimens this retires (#576 build-11, #659 build-01 and verify-01) are\n# exactly a stop the product wrote with nothing beside it to explain\n# itself after the fact. ---\n\nSTOP_CLASSES = (\"non-question\", \"outlived-invocation\", \"no-cause\", \"forge-unconcluded\",\n               \"ceiling\", \"claims-boundary\", \"repeated-act\", \"unclassed\", \"question\",\n               \"environment\", \"gate\", \"died\", \"hung\")\n\nSTOP_PROVENANCES = (\"product\", \"tenant\", \"executor\", \"spec\")\n\n# Beyond the enum spelling itself, the prose issue #88 actually shipped\n# (adapters/claude-code/run and adapters/codex/run, on main since\n# v0.16.0) once put a class's own name, or a real specimen's wording of\n# it, in the transcript for the generic match below to find. Issue #94\n# moves non-question and outlived-invocation onto report_class instead\n# (below): non-question's own halt line (\"halted: class non-question\")\n# would otherwise still satisfy the bare-name match here with no adapter\n# report-line field involved at all, and outlived-invocation's refusal\n# never named its class in text to begin with, so both are disabled here\n# -- the same pattern issue #93 established for ceiling, just below,\n# rather than removed outright.\nCLASS_TEXT_MARKERS: dict[str, tuple[str, ...]] = {\n    \"non-question\": (),\n    \"outlived-invocation\": (),\n    # Issue #93: ceiling's own text-based check is CEILING_MARKERS, below,\n    # with provenance \"product\" -- a fact about the tool, not an executor\n    # judgment like non-question/outlived-invocation are. Left at the\n    # default (the class's own name, \"ceiling\"), the generic match above\n    # would instead catch adapters/codex/run's and\n    # adapters/claude-code/run's own pre-emptive refusal -- which must\n    # carry the word \"ceiling\" by the same issue's own brief -- as\n    # provenance \"executor\", before CEILING_MARKERS is ever consulted.\n    \"ceiling\": (),\n    # A genuine question (issue #100's own followups) is read structurally\n    # -- status \"halted\" carrying a non-empty halted.question -- not by\n    # scanning for the literal word \"question\", which the question's own\n    # text very often contains regardless of what it is actually asking.\n    # Left at the default, the generic match above would misclassify any\n    # question that happens to use the word \"question\" as executor\n    # provenance, before the structural check in derive_stop is reached.\n    \"question\": (),\n    # environment/tenant (issue #115) is set directly by cmd_build's own\n    # preflight -- the one caller who knows a [checks].command exited 2\n    # on the approved tree -- never derived from adapter text. Left at\n    # the default, the generic match above would catch the word\n    # \"environment\" anywhere in a log or refusal (e.g. codex's own\n    # OPENAI_API_KEY auth-mismatch refusal, adapters/codex/run's\n    # check_auth) as an environment/executor stop that never happened.\n    \"environment\": (),\n}\n\n# Known tool error text for a declared ceiling -- issue #86's own specimen\n# (codex's \"Input exceeds...\" line on a diff too large to judge) is\n# \"input_too_large\"; a matching line anywhere in the log, not only its\n# last line, since cmd_build and cmd_verify both append \"[adapter exited\n# N]\" after whatever the tool itself printed. \"ceiling exceeded\" is issue\n# #93's own addition: both adapters now refuse pre-emptively, before the\n# tool is ever invoked, against a declared or fixed input limit, and\n# their refusal text is not caught by any of the three markers above.\nCEILING_MARKERS = (\"input_too_large\", \"exceeds the maximum context length\",\n                  \"context_length_exceeded\", \"ceiling exceeded\")\n\n\n# Issue #100's followups: an unclassed detail is the log's last line\n# verbatim, and that line is sometimes an adapter's own event JSON or a\n# tool's full error text -- thousands of characters wide. Capped here,\n# at write time, so a filed issue's own summary of it (file-stops'\n# log_tail already carries the full picture) stays short; the class\n# itself, \"unclassed\", already says the full explanation lives in the\n# log, not in this field.\nUNCLASSED_DETAIL_MAX_CHARS = 200\n\n\ndef _log_last_line(log: str | None) -> str:\n    lines = [l for l in (log or \"\").splitlines() if l.strip()]\n    last = lines[-1] if lines else \"\"\n    return last[:UNCLASSED_DETAIL_MAX_CHARS]\n\n\ndef _carries_a_known_class(text: str | None) -> str | None:\n    \"\"\"Whichever of STOP_CLASSES this text names -- its own spelling, or\n    one of CLASS_TEXT_MARKERS' real-world phrasings of it, when that\n    class is not disabled there -- or None. Issue #88 is where an\n    adapter's own halt or refusal first named its class this way; issue\n    #93 added ceiling's own pre-emptive refusal to that set and disabled\n    its bare-name match (CEILING_MARKERS covers it instead); issue #94\n    disables non-question and outlived-invocation the same way, reading\n    both from the adapter's own report line (derive_stop's report_class)\n    now instead.\"\"\"\n    text = text or \"\"\n    for name in STOP_CLASSES:\n        markers = CLASS_TEXT_MARKERS.get(name, (name,))\n        if any(marker in text for marker in markers):\n            return name\n    return None\n\n\ndef derive_stop(status: str, *, refusal: str | None = None, halted: dict[str, Any] | None = None,\n                log: str | None = None, report_class: str | None = None,\n                refusal_provenance: str | None = None) -> Stop | None:\n    \"\"\"The stop field for a build or verify record: None for status \"pass\",\n    else {class, provenance, detail} from what the caller already knows.\n\n      - report_class -- payload.get(\"class\") off the adapter's own report\n        line (issue #88, #94), when it names a STOP_CLASSES member -- is\n        that class, provenance \"executor\". build.schema.json and\n        verify.schema.json stay untouched by issue #88 on purpose, so the\n        class lives only on the report line, never a structured field\n        cmd_build or cmd_verify forwards on its own account; the caller\n        reads payload itself and passes this in, since only it still has\n        payload once an iteration ends. This is non-question's and\n        outlived-invocation's only path to a record now (issue #94):\n        CLASS_TEXT_MARKERS disables both for the text scan below, the\n        same way issue #93 disabled ceiling's bare-name match there. A\n        class an adapter does not yet put on its report line --\n        outlived-invocation today, since that refusal path prints no\n        report line at all -- falls to unclassed below, same as any\n        other unnamed cause, until the adapter that raises it puts a\n        class on the line the way non-question already does.\n      - a halt carrying a non-empty halted.question, once it is not a\n        non-question caught above, is a genuine question -- question/spec,\n        with the question's own first line as detail (issue #100's\n        followups). This is the specimen issue #100 itself was built to\n        retire: tenant zero's #663 build-01, a proper question, classed\n        unclassed/product and filed as a product defect with the wrong\n        provenance -- a question is about the definition of done, which is\n        a person's or a ruling's to answer, never the product's own\n        mechanism.\n      - failing that, a refusal or the log itself that already names its\n        class in text (issue #88, #93 for ceiling's own pre-emptive\n        refusal) is that class, provenance \"executor\" -- the log is\n        checked because neither adapter's refusal *field* carries the\n        class today; the class-naming line each adapter prints reaches\n        only the transcript\n      - a refusal that is not that -- the write-outside-claims path\n        itself, not the \"commit ... not authored by the executor\" shape\n        -- is claims-boundary/spec, unless the caller already knows this\n        refusal touched paths.records or paths.specs (issue #140:\n        protected_path_touched, checked ahead of the ordinary claims\n        match in cmd_build) and passes refusal_provenance=\"executor\" --\n        the product's own directories are not a claim a spec makes, so a\n        refusal there is not the spec's boundary to answer for\n      - a returned verify (the forge was not green; no adapter ran) is\n        forge-unconcluded/tenant\n      - an adapter exit whose log carries a declared-ceiling error line is\n        ceiling/product\n      - anything else is unclassed/product, with the log's last line\n        (capped at UNCLASSED_DETAIL_MAX_CHARS) as its detail -- the other\n        class that carries a detail, since every remaining class's\n        evidence already lives in refusal, halted, forge_checks, or the\n        log itself.\n    \"\"\"\n    if status == \"pass\":\n        return None\n    if status == \"returned\":\n        return {\"class\": \"forge-unconcluded\", \"provenance\": \"tenant\", \"detail\": None}\n    if report_class in STOP_CLASSES:\n        return {\"class\": report_class, \"provenance\": \"executor\", \"detail\": None}\n    question = (halted or {}).get(\"question\")\n    if status == \"halted\" and question:\n        return {\"class\": \"question\", \"provenance\": \"spec\",\n               \"detail\": question.splitlines()[0]}\n    known = _carries_a_known_class(refusal) or _carries_a_known_class(log)\n    if known:\n        return {\"class\": known, \"provenance\": \"executor\", \"detail\": None}\n    if status == \"refused\" and refusal is not None and not refusal.startswith(\"commit \"):\n        return {\"class\": \"claims-boundary\", \"provenance\": refusal_provenance or \"spec\",\n               \"detail\": None}\n    if log and any(marker in log.lower() for marker in CEILING_MARKERS):\n        return {\"class\": \"ceiling\", \"provenance\": \"product\", \"detail\": None}\n    return {\"class\": \"unclassed\", \"provenance\": \"product\", \"detail\": _log_last_line(log)}\n\n\ndef gate_stop(refusal: str | None) -> Stop:\n    \"\"\"The stop for a refused spec-gate record: class \"gate\", provenance\n    \"spec\", the refusal string itself as cause (issue #137) -- not\n    derive_stop's generic claims-boundary/spec fallback issue #133\n    reused, which named a boundary the record never crossed: \"criterion\n    fails against the tree plus stub: doctor-template-absent.sh\" is not\n    a write outside claims. cmd_spec_gate is untouched by this lane, so\n    a spec record still carries no stop field of its own; this is\n    synthesized wherever a refused one is read (item_stops,\n    cmd_file_stops, proof_no_stop_lacks_cause), never persisted.\"\"\"\n    return {\"class\": \"gate\", \"provenance\": \"spec\", \"detail\": refusal}\n\n\n# --- stops: every non-pass record by class, provenance, and answerer\n# (issue #129) ---\n\ndef item_stops(root: Path, m: dict[str, Any], item_id: str) -> dict[str, Any]:\n    \"\"\"{\"item\", \"rows\", \"totals\"}: one row per non-pass build or verify\n    record (STOP_STAGES), plus every refused spec-gate record (issue\n    #133), class \"gate\" (issue #137) -- read from status and refusal\n    rather than a stop field spec-gate records never carry (gate_stop\n    synthesizes it) -- under item_id, whatever the record's own\n    record_version -- a record too old to carry stop at all still gets\n    a row, its class printed as the doctor's own phrase for it.\n\n    The answerer, a closed choice: \"counsel:<verdict>\" when\n    counsel_record_for finds a counsel record naming this exact stage and\n    number -- the product's own answer, which wins over whatever the stop\n    itself says, since a counseled stop was already read once; failing\n    that, \"person\" for class question (a person's to answer, not a\n    guard's); failing that, \"guard\" for a class in GUARDED_STOP_CLASSES\n    (a guard's own rejection needed no further reading); anything else\n    -- no-cause, unclassed, or no stop at all -- is \"none\": nobody has\n    answered it yet.\"\"\"\n    records_rel = m[\"paths\"][\"records\"]\n    item_records_dir = root / records_rel / item_id\n    by_class = {c: 0 for c in stop_class_enum()}\n    by_answerer: dict[str, int] = {}\n    before_stop_was_recorded = 0\n    rows: list[dict[str, Any]] = []\n\n    def add_row(stage: str, n: int, stop: Stop | None) -> None:\n        nonlocal before_stop_was_recorded\n        name = f\"{stage}-{n:02d}\"\n        marker = item_records_dir / f\"{name}.filed\"\n        filed_issue = marker.read_text() if marker.is_file() else None\n        counsel = counsel_record_for(item_records_dir, stage, n)\n\n        if counsel is not None:\n            answerer = f\"counsel:{counsel.get('verdict')}\"\n        elif stop and stop.get(\"class\") == \"question\":\n            answerer = \"person\"\n        elif stop and stop.get(\"class\") in GUARDED_STOP_CLASSES:\n            answerer = \"guard\"\n        else:\n            answerer = \"none\"\n\n        if stop:\n            cls, provenance, detail = (stop.get(\"class\"), stop.get(\"provenance\"),\n                                      stop.get(\"detail\"))\n            if cls in by_class:\n                by_class[cls] += 1\n        else:\n            cls, provenance, detail = \"before stop was recorded\", None, None\n            before_stop_was_recorded += 1\n\n        by_answerer[answerer] = by_answerer.get(answerer, 0) + 1\n        rows.append({\"item\": item_id, \"record\": name, \"class\": cls,\n                    \"provenance\": provenance, \"detail\": detail,\n                    \"answerer\": answerer, \"filed_issue\": filed_issue})\n\n    if item_records_dir.is_dir():\n        for stage in STOP_STAGES:\n            for n, rec in sorted(parse_attempts(item_records_dir, stage).items()):\n                if rec.get(\"status\") == \"pass\":\n                    continue\n                add_row(stage, n, rec.get(\"stop\"))\n        for n, rec in sorted(parse_attempts(item_records_dir, \"spec\").items()):\n            if rec.get(\"status\") != \"refused\":\n                continue\n            add_row(\"spec\", n, gate_stop(rec.get(\"refusal\")))\n\n    totals = {\"by_class\": by_class, \"by_answerer\": by_answerer,\n             \"before_stop_was_recorded\": before_stop_was_recorded}\n    return {\"item\": item_id, \"rows\": rows, \"totals\": totals}\n\n\ndef cmd_stops(argv: list[str]) -> int:\n    as_json = \"--json\" in argv\n    positional = [a for a in argv if a != \"--json\"]\n    root = Path(\".\").resolve()\n    m = read_manifest(root)\n    if m is None:\n        print(f\"attavo stops: no {MANIFEST} at {root}\", file=sys.stderr)\n        return 2\n\n    records_rel = m[\"paths\"][\"records\"]\n    if positional:\n        item_ids = [positional[0]]\n    else:\n        records_root = root / records_rel\n        item_ids = (sorted((p.name for p in records_root.iterdir() if p.is_dir()))\n                   if records_root.is_dir() else [])\n\n    reports = [item_stops(root, m, item_id) for item_id in item_ids]\n\n    if as_json:\n        if positional:\n            print(json.dumps(reports[0], indent=2))\n        else:\n            print(json.dumps({\"items\": reports}, indent=2))\n        return 0\n\n    for entry in reports:\n        print(f\"attavo stops: item {entry['item']}\")\n        for row in entry[\"rows\"]:\n            filed = f\"  filed: {row['filed_issue'].strip()}\" if row[\"filed_issue\"] else \"\"\n            print(f\"  {row['record']:<10} {row['class']:<24} {row['provenance'] or '-':<10} \"\n                 f\"{row['answerer']:<16}{filed}\")\n        t = entry[\"totals\"]\n        print(f\"  by class: {t['by_class']}\")\n        print(f\"  by answerer: {t['by_answerer']}\")\n        print(f\"  before stop was recorded: {t['before_stop_was_recorded']}\")\n    if not reports:\n        print(f\"attavo stops: no item found under {records_rel}\")\n    return 0\n\n\n# The stop classes issue #89 gave no code of their own beyond the guard\n# that raised them -- non-question and outlived-invocation from an\n# adapter's own pre-emptive refusal, forge-unconcluded from a returned\n# verify, ceiling from a declared-input-limit error, claims-boundary from\n# the write-outside-claims refusal, repeated-act from... the same shape,\n# environment from cmd_build's own [checks].command preflight (issue\n# #115). question (a person's to answer) and the residual (no-cause,\n# unclassed -- nobody has looked yet) are not in this tuple; attavo stops\n# (issue #129) is the one reader, so it lives beside driver_identity,\n# not beside derive_stop, which never needs to tell a guard from any\n# other class once it has already named one.\nGUARDED_STOP_CLASSES = (\"non-question\", \"outlived-invocation\", \"forge-unconcluded\", \"ceiling\",\n                        \"claims-boundary\", \"repeated-act\", \"environment\")\n\n\ndef stop_class_enum() -> tuple[str, ...]:\n    \"\"\"Every class a stop can name, read from the build record schema's own\n    enum (issue #129) rather than retyped -- STOP_CLASSES already drifted\n    once (environment arrived in the schema before anything but derive_stop\n    read it); a second copy is a second place to forget. build's schema is\n    read, not verify's: verify's own enum is a strict subset (it never\n    raises environment, cmd_build's own preflight alone).\"\"\"\n    schema = stage_schema(\"build\")\n    return tuple(schema[\"properties\"][\"stop\"][\"properties\"][\"class\"][\"enum\"])\n\n\nSTOP_STAGES = (\"build\", \"verify\")\n\n\ndef counsel_record_for(item_records_dir: Path, stage: str, n: int) -> CounselRecord | None:\n    \"\"\"The latest counsel-NN.json (issue #100) whose own \"record\" field\n    names f\"{stage}-{n:02d}\" -- the counsel invocation, if any, that read\n    this exact stage record -- or None when counsel never ran against it\n    (e.g. file-stops run standalone, outside drive).\"\"\"\n    target = f\"{stage}-{n:02d}\"\n    attempts = parse_attempts(item_records_dir, \"counsel\")\n    matches = [rec for _, rec in sorted(attempts.items()) if rec.get(\"record\") == target]\n    return matches[-1] if matches else None\n","numLines":354,"startLine":1,"totalLines":354}}}

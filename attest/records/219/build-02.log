) -- [] when no adapter was called or it declares no conformance.json. Dollars are never summed across adapters; a field absent here renders as not reported by this executor, never zero or blank.\",\n33\t      \"items\": {\"type\": \"string\", \"minLength\": 1}\n34\t    },\n35\t    \"forge_checks\": {\n36\t      \"type\": \"object\",\n37\t      \"additionalProperties\": false,\n38\t      \"required\": [\"command\", \"sha\", \"conclusions\"],\n39\t      \"properties\": {\n40\t        \"command\": {\"type\": \"string\", \"minLength\": 1},\n41\t        \"sha\": {\"type\": \"string\", \"minLength\": 1},\n42\t        \"conclusions\": {\n43\t          \"type\": \"array\",\n44\t          \"items\": {\n45\t            \"type\": \"object\",\n46\t            \"additionalProperties\": false,\n47\t            \"required\": [\"name\", \"conclusion\"],\n48\t            \"properties\": {\n49\t              \"name\": {\"type\": \"string\", \"minLength\": 1},\n50\t              \"conclusion\": {\"type\": \"string\", \"minLength\": 1}\n51\t            }\n52\t          }\n53\t        }\n54\t      }\n55\t    },\n56\t    \"findings\": {\n57\t      \"type\": [\"array\", \"null\"],\n58\t      \"description\": \"null when no adapter was called (the forge checks were not green), or when the adapter ran but reported no findings key at all -- distinct from an explicit empty list, which is a clean report, not a missing channel.\",\n59\t      \"items\": {\n60\t        \"type\": \"object\",\n61\t        \"additionalProperties\": false,\n62\t        \"required\": [\"title\", \"specimen\", \"retires\", \"rejection_test\", \"severity\"],\n63\t        \"properties\": {\n64\t          \"title\": {\"type\": \"string\", \"minLength\": 1},\n65\t          \"specimen\": {\"type\": \"string\", \"minLength\": 1},\n66\t          \"retires\": {\"type\": \"string\", \"minLength\": 1},\n67\t          \"rejection_test\": {\"type\": \"string\", \"minLength\": 1},\n68\t          \"severity\": {\"type\": \"string\", \"minLength\": 1}\n69\t        }\n70\t      }\n71\t    },\n72\t    \"tests_named\": {\n73\t      \"type\": \"array\",\n74\t      \"items\": {\"type\": \"string\", \"minLength\": 1}\n75\t    },\n76\t    \"commits\": {\n77\t      \"type\": \"array\",\n78\t      \"description\": \"Empty unless the adapter moved the branch head during verify -- a report, not a commit; a non-empty list here always accompanies status: \\\"failed\\\", naming exactly what the adapter should not have created.\",\n79\t      \"items\": {\"type\": \"string\", \"minLength\": 1}\n80\t    },\n81\t    \"stub_ratio\": {\n82\t      \"type\": [\"number\", \"null\"], \"minimum\": 0, \"maximum\": 1,\n83\t      \"description\": \"The share of the lines the item's diff adds (outside the specs and records directories, blank lines aside) that are a line of the spec's stub at the same path. Near 1 the build shipped the stub; near 0 the builder wrote the change. Null when the spec carries no stub or the diff adds no counted line. Version 5 carried two further fields that no release ever computed; they are gone.\"\n84\t    },\n85\t    \"tokens\": {\n86\t      \"type\": \"object\",\n87\t      \"additionalProperties\": false,\n88\t      \"required\": [\"input\", \"output\"],\n89\t      \"properties\": {\n90\t        \"input\": {\"type\": \"integer\", \"minimum\": 0},\n91\t        \"output\": {\"type\": \"integer\", \"minimum\": 0}\n92\t      }\n93\t    },\n94\t    \"cost_usd\": {\"type\": [\"number\", \"null\"]},\n95\t    \"wall_clock_s\": {\"type\": \"number\", \"minimum\": 0},\n96\t    \"status\": {\"type\": \"string\", \"enum\": [\"pass\", \"returned\", \"failed\"]},\n97\t    \"stop\": {\n98\t      \"type\": [\"object\", \"null\"],\n99\t      \"description\": \"Non-null exactly when status is not \\\"pass\\\" (issue #89): what class of stop this is and whose it is, derived by the record writer from the forge_checks and log it already has -- never a fresh read of anything.\",\n100\t      \"additionalProperties\": false,\n101\t      \"required\": [\"class\", \"provenance\", \"detail\"],\n102\t      \"properties\": {\n103\t        \"class\": {\n104\t          \"type\": \"string\",\n105\t          \"enum\": [\"non-question\", \"outlived-invocation\", \"no-cause\", \"forge-unconcluded\",\n106\t                   \"ceiling\", \"claims-boundary\", \"repeated-act\", \"unclassed\", \"question\",\n107\t                   \"died\", \"hung\", \"transient\", \"returned\"]\n108\t        },\n109\t        \"signature\": {\n110\t          \"type\": [\"string\", \"null\"],\n111\t          \"description\": \"R3: the failure's signature, the detail or last event with every run of digits removed; equal between two attempts means the same failure\"\n112\t        },\n113\t        \"bound\": {\n114\t          \"type\": [\"string\", \"null\"],\n115\t          \"enum\": [\"stall\", \"ceiling\", null],\n116\t          \"description\": \"R3: the bound a hung invocation crossed, or null\"\n117\t        },\n118\t        \"provenance\": {\"type\": \"string\", \"enum\": [\"product\", \"tenant\", \"executor\", \"spec\"]},\n119\t        \"detail\": {\n120\t          \"type\": [\"string\", \"null\"],\n121\t          \"description\": \"Populated for class \\\"unclassed\\\" (the log's last line, capped at 200 characters) and class \\\"question\\\" (the halt's own question, its first line only); null for every other class, whose evidence already lives in forge_checks or the log itself.\"\n122\t        }\n123\t      }\n124\t    },\n125\t    \"retry_of\": {\n126\t      \"type\": [\"string\", \"null\"],\n127\t      \"description\": \"R3: the stem of the attempt this one retries, or null on a first attempt\"\n128\t    },\n129\t    \"steer\": {\n130\t      \"type\": [\"string\", \"null\"],\n131\t      \"description\": \"R3: the counsel or ruling record whose text this attempt was handed, or null\"\n132\t    },\n133\t    \"product_version\": {\"type\": \"string\", \"minLength\": 1},\n134\t    \"product_pin\": {\"type\": [\"string\", \"null\"]}\n135\t  }\n136\t}\n137\t"}]},"parent_tool_use_id":null,"session_id":"ae622d81-efb9-4dda-92a0-5ebf75b0d73f","uuid":"7cd4345a-931e-4341-ad57-850c321058b0","timestamp":"2026-09-26T03:18:07.427Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-219/attest/specs/219/stub/schema/records/verify.schema.json","content":"{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"$id\": \"https://attavo.dev/schema/records/verify/7\",\n  \"title\": \"attavo verify record (verify-NN.json)\",\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"required\": [\n    \"record_version\", \"item\", \"sha\", \"build_sha\", \"build_record\", \"approval_sha\", \"at\", \"adapter\",\n    \"adapter_config\", \"adapter_version\", \"model\", \"model_version\", \"reports\",\n    \"forge_checks\", \"findings\", \"tests_named\", \"commits\",\n    \"stub_ratio\", \"tokens\", \"cost_usd\", \"wall_clock_s\", \"status\",\n    \"stop\", \"product_version\", \"product_pin\"\n  ],\n  \"properties\": {\n    \"record_version\": {\"type\": \"integer\", \"minimum\": 1},\n    \"item\": {\"type\": \"string\", \"minLength\": 1},\n    \"sha\": {\"type\": \"string\", \"minLength\": 1},\n    \"build_sha\": {\"type\": \"string\", \"minLength\": 1},\n    \"build_record\": {\"type\": [\"string\", \"null\"]},\n    \"approval_sha\": {\"type\": [\"string\", \"null\"]},\n    \"at\": {\"type\": \"string\", \"minLength\": 1},\n    \"adapter\": {\"type\": [\"string\", \"null\"]},\n    \"adapter_config\": {\n      \"type\": \"object\",\n      \"description\": \"Copied verbatim from [executor.<adapter>] merged with [executor.<adapter>.verify]; {} when no adapter was called.\"\n    },\n    \"adapter_version\": {\"type\": [\"string\", \"null\"]},\n    \"model\": {\"type\": [\"string\", \"null\"]},\n    \"model_version\": {\"type\": [\"string\", \"null\"]},\n    \"reports\": {\n      \"type\": \"array\",\n      \"description\": \"Field names adapters/<name>/conformance.json declares this adapter can supply with a real value (vendor independence, 2026-09-09 ruling) -- [] when no adapter was called or it declares no conformance.json. Dollars are never summed across adapters; a field absent here renders as not reported by this executor, never zero or blank.\",\n      \"items\": {\"type\": \"string\", \"minLength\": 1}\n    },\n    \"forge_checks\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\"command\", \"sha\", \"conclusions\"],\n      \"properties\": {\n        \"command\": {\"type\": \"string\", \"minLength\": 1},\n        \"sha\": {\"type\": \"string\", \"minLength\": 1},\n        \"conclusions\": {\n          \"type\": \"array\",\n          \"items\": {\n            \"type\": \"object\",\n            \"additionalProperties\": false,\n            \"required\": [\"name\", \"conclusion\"],\n            \"properties\": {\n              \"name\": {\"type\": \"string\", \"minLength\": 1},\n              \"conclusion\": {\"type\": \"string\", \"minLength\": 1}\n            }\n          }\n        }\n      }\n    },\n    \"findings\": {\n      \"type\": [\"array\", \"null\"],\n      \"description\": \"null when no adapter was called (the forge checks were not green), or when the adapter ran but reported no findings key at all -- distinct from an explicit empty list, which is a clean report, not a missing channel.\",\n      \"items\": {\n        \"type\": \"object\",\n        \"additionalProperties\": false,\n        \"required\": [\"title\", \"specimen\", \"retires\", \"rejection_test\", \"severity\"],\n        \"properties\": {\n          \"title\": {\"type\": \"string\", \"minLength\": 1},\n          \"specimen\": {\"type\": \"string\", \"minLength\": 1},\n          \"retires\": {\"type\": \"string\", \"minLength\": 1},\n          \"rejection_test\": {\"type\": \"string\", \"minLength\": 1},\n          \"severity\": {\"type\": \"string\", \"minLength\": 1}\n        }\n      }\n    },\n    \"tests_named\": {\n      \"type\": \"array\",\n      \"items\": {\"type\": \"string\", \"minLength\": 1}\n    },\n    \"commits\": {\n      \"type\": \"array\",\n      \"description\": \"Empty unless the adapter moved the branch head during verify -- a report, not a commit; a non-empty list here always accompanies status: \\\"failed\\\", naming exactly what the adapter should not have created.\",\n      \"items\": {\"type\": \"string\", \"minLength\": 1}\n    },\n    \"stub_ratio\": {\n      \"type\": [\"number\", \"null\"], \"minimum\": 0, \"maximum\": 1,\n      \"description\": \"The share of the lines the item's diff adds (outside the specs and records directories, blank lines aside) that are a line of the spec's stub at the same path. Near 1 the build shipped the stub; near 0 the builder wrote the change. Null when the spec carries no stub or the diff adds no counted line. Version 5 carried two further fields that no release ever computed; they are gone.\"\n    },\n    \"tokens\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\"input\", \"output\"],\n      \"properties\": {\n        \"input\": {\"type\": \"integer\", \"minimum\": 0},\n        \"output\": {\"type\": \"integer\", \"minimum\": 0}\n      }\n    },\n    \"cost_usd\": {\"type\": [\"number\", \"null\"]},\n    \"wall_clock_s\": {\"type\": \"number\", \"minimum\": 0},\n    \"status\": {\"type\": \"string\", \"enum\": [\"pass\", \"returned\", \"failed\"]},\n    \"stop\": {\n      \"type\": [\"object\", \"null\"],\n      \"description\": \"Non-null exactly when status is not \\\"pass\\\" (issue #89): what class of stop this is and whose it is, derived by the record writer from the forge_checks and log it already has -- never a fresh read of anything.\",\n      \"additionalProperties\": false,\n      \"required\": [\"class\", \"provenance\", \"detail\"],\n      \"properties\": {\n        \"class\": {\n          \"type\": \"string\",\n          \"enum\": [\"non-question\", \"outlived-invocation\", \"no-cause\", \"forge-unconcluded\",\n                   \"ceiling\", \"claims-boundary\", \"repeated-act\", \"unclassed\", \"question\",\n                   \"died\", \"hung\", \"transient\", \"returned\"]\n        },\n        \"signature\": {\n          \"type\": [\"string\", \"null\"],\n          \"description\": \"R3: the failure's signature, the detail or last event with every run of digits removed; equal between two attempts means the same failure\"\n        },\n        \"bound\": {\n          \"type\": [\"string\", \"null\"],\n          \"enum\": [\"stall\", \"ceiling\", null],\n          \"description\": \"R3: the bound a hung invocation crossed, or null\"\n        },\n        \"provenance\": {\"type\": \"string\", \"enum\": [\"product\", \"tenant\", \"executor\", \"spec\"]},\n        \"detail\": {\n          \"type\": [\"string\", \"null\"],\n          \"description\": \"Populated for class \\\"unclassed\\\" (the log's last line, capped at 200 characters) and class \\\"question\\\" (the halt's own question, its first line only); null for every other class, whose evidence already lives in forge_checks or the log itself.\"\n        }\n      }\n    },\n    \"retry_of\": {\n      \"type\": [\"string\", \"null\"],\n      \"description\": \"R3: the stem of the attempt this one retries, or null on a first attempt\"\n    },\n    \"steer\": {\n      \"type\": [\"string\", \"null\"],\n      \"description\": \"R3: the counsel or ruling record whose text this attempt was handed, or null\"\n    },\n    \"product_version\": {\"type\": \"string\", \"minLength\": 1},\n    \"product_pin\": {\"type\": [\"string\", \"null\"]}\n  }\n}\n","numLines":137,"startLine":1,"totalLines":137}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XWo8kcL1iZUrF4Hk26AyNt","type":"tool_result","content":"257\tclass InvocationReading(NamedTuple):\n258\t    \"\"\"What one marker with no record reads as, from here and now.\"\"\"\n259\t    stage: str\n260\t    nn: int\n261\t    log: str\n262\t    last_at: str | None\n263\t    age: float | None\n264\t    cls: str  # \"running\" | \"hung\" | \"died\"\n265\t    bound: str | None = None  # R3: \"stall\" or \"ceiling\" when cls is \"hung\"\n266\t\n267\t\n268\tdef _manifest_of(root: Path) -> dict[str, Any]:\n269\t    m = read_manifest(root)\n270\t    return m if m is not None else {}\n271\t\n272\t\n273\tdef _streams_events(root: Path, m: dict[str, Any], stage: str) -> bool:\n274\t    \"\"\"R3: whether stage's adapter declares it streams events at all\n275\t    (adapters/<name>/conformance.json, \"streams_events\") -- one that does\n276\t    not is judged by its ceiling alone, and never called hung by event\n277\t    age it never produces. True (the ordinary case) when the adapter\n278\t    declares nothing, or none is configured to ask.\"\"\"\n279\t    name = (m.get(\"executor\") or {}).get(stage) or (m.get(\"executor\") or {}).get(\"build\")\n280\t    if not name:\n281\t        return True\n282\t    for base in (root / \"attavo\" / \"adapters\", PRODUCT_ROOT / \"adapters\"):\n283\t        conf = base / name / \"conformance.json\"\n284\t        if conf.is_file():\n285\t            try:\n286\t                return bool(json.loads(conf.read_text()).get(\"streams_events\", True))\n287\t            except (OSError, ValueError):\n288\t                return True\n289\t    return True\n290\t\n291\t\n292\tdef read_invocation(root: Path, bound: int | None, marker: Path, info: dict[str, Any]) -> InvocationReading:\n293\t    \"\"\"Whether an invocation that began and wrote no record is running,\n294\t    hung, or died -- read from its own heartbeat first (R2): a heartbeat\n295\t    file fresh within three beats of ATTAVO_HEARTBEAT_S is alive; a stale\n296\t    one is died, whether or not the pid still lives -- a worker stuck\n297\t    somewhere that never reaches its own heartbeat loop again is exactly\n298\t    what this is for. Only with no heartbeat file at all -- an invocation\n299\t    from before this release, or one that died before touching its\n300\t    first beat -- does this fall back to the pid: alive and, with a\n301\t    stall bound declared, past it is hung; alive with no bound, or\n302\t    within it, is running for as long as it lives; not alive is died.\n303\t    The stall bound decides hung, never died.\n304\t\n305\t    R3: the stage's own ceiling (wall clock from the marker's own `at`)\n306\t    is judged first, before any of that -- alive past it is hung by the\n307\t    ceiling whatever event age says, and an adapter that declares it\n308\t    streams no events is judged by the ceiling alone: bound is read as\n309\t    None for it, so the stall check below never fires on an event age it\n310\t    never had.\"\"\"\n311\t    stage, nn_text = marker.stem.rsplit(\"-\", 1)\n312\t    nn = int(nn_text)\n313\t    log, last_at = _events_tail(_events_path_for(root, stage, nn))\n314\t    m = _manifest_of(root)\n315\t    ceiling = ceiling_s(m, stage)\n316\t    since_start = _seconds_since(info.get(\"at\"))\n317\t    if ceiling is not None and since_start is not None and since_start > ceiling:\n318\t        return InvocationReading(stage, nn, log, last_at, since_start, \"hung\", \"ceiling\")\n319\t    if not _streams_events(root, m, stage):\n320\t        bound = None\n321\t    beat = heartbeat_path(root, stage, nn)\n322\t    if beat.is_file():\n323\t        try:\n324\t            beat_age = time.time() - beat.stat().st_mtime\n325\t        except OSError:\n326\t            beat_age = None\n327\t        cls = \"running\" if beat_age is not None and beat_age <= heartbeat_s() * 3 else \"died\"\n328\t        return InvocationReading(stage, nn, log, last_at, beat_age, cls)\n329\t    age = _seconds_since(last_at or info.get(\"at\"))\n330\t    if not invocation_alive(info):\n331\t        return InvocationReading(stage, nn, log, last_at, age, \"died\")"}]},"parent_tool_use_id":null,"session_id":"061dd881-711c-41db-8604-438f84ab7c7d","uuid":"54e5a826-0901-4f83-8fda-04ac5467fd0f","timestamp":"2026-09-26T05:11:44.053Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-219/attavo/drive.py","content":"class InvocationReading(NamedTuple):\n    \"\"\"What one marker with no record reads as, from here and now.\"\"\"\n    stage: str\n    nn: int\n    log: str\n    last_at: str | None\n    age: float | None\n    cls: str  # \"running\" | \"hung\" | \"died\"\n    bound: str | None = None  # R3: \"stall\" or \"ceiling\" when cls is \"hung\"\n\n\ndef _manifest_of(root: Path) -> dict[str, Any]:\n    m = read_manifest(root)\n    return m if m is not None else {}\n\n\ndef _streams_events(root: Path, m: dict[str, Any], stage: str) -> bool:\n    \"\"\"R3: whether stage's adapter declares it streams events at all\n    (adapters/<name>/conformance.json, \"streams_events\") -- one that does\n    not is judged by its ceiling alone, and never called hung by event\n    age it never produces. True (the ordinary case) when the adapter\n    declares nothing, or none is configured to ask.\"\"\"\n    name = (m.get(\"executor\") or {}).get(stage) or (m.get(\"executor\") or {}).get(\"build\")\n    if not name:\n        return True\n    for base in (root / \"attavo\" / \"adapters\", PRODUCT_ROOT / \"adapters\"):\n        conf = base / name / \"conformance.json\"\n        if conf.is_file():\n            try:\n                return bool(json.loads(conf.read_text()).get(\"streams_events\", True))\n            except (OSError, ValueError):\n                return True\n    return True\n\n\ndef read_invocation(root: Path, bound: int | None, marker: Path, info: dict[str, Any]) -> InvocationReading:\n    \"\"\"Whether an invocation that began and wrote no record is running,\n    hung, or died -- read from its own heartbeat first (R2): a heartbeat\n    file fresh within three beats of ATTAVO_HEARTBEAT_S is alive; a stale\n    one is died, whether or not the pid still lives -- a worker stuck\n    somewhere that never reaches its own heartbeat loop again is exactly\n    what this is for. Only with no heartbeat file at all -- an invocation\n    from before this release, or one that died before touching its\n    first beat -- does this fall back to the pid: alive and, with a\n    stall bound declared, past it is hung; alive with no bound, or\n    within it, is running for as long as it lives; not alive is died.\n    The stall bound decides hung, never died.\n\n    R3: the stage's own ceiling (wall clock from the marker's own `at`)\n    is judged first, before any of that -- alive past it is hung by the\n    ceiling whatever event age says, and an adapter that declares it\n    streams no events is judged by the ceiling alone: bound is read as\n    None for it, so the stall check below never fires on an event age it\n    never had.\"\"\"\n    stage, nn_text = marker.stem.rsplit(\"-\", 1)\n    nn = int(nn_text)\n    log, last_at = _events_tail(_events_path_for(root, stage, nn))\n    m = _manifest_of(root)\n    ceiling = ceiling_s(m, stage)\n    since_start = _seconds_since(info.get(\"at\"))\n    if ceiling is not None and since_start is not None and since_start > ceiling:\n        return InvocationReading(stage, nn, log, last_at, since_start, \"hung\", \"ceiling\")\n    if not _streams_events(root, m, stage):\n        bound = None\n    beat = heartbeat_path(root, stage, nn)\n    if beat.is_file():\n        try:\n            beat_age = time.time() - beat.stat().st_mtime\n        except OSError:\n            beat_age = None\n        cls = \"running\" if beat_age is not None and beat_age <= heartbeat_s() * 3 else \"died\"\n        return InvocationReading(stage, nn, log, last_at, beat_age, cls)\n    age = _seconds_since(last_at or info.get(\"at\"))\n    if not invocation_alive(info):\n        return InvocationReading(stage, nn, log, last_at, age, \"died\")","numLines":75,"startLine":257,"totalLines":929}}}

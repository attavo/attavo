lect-tests\"\ncall_timeout_s = 240\nrun = \"xargs -r python3 -m pytest -q --deselect tests/test_doctor.py::test_every_gate_rejects --deselect tests/test_doctor.py::test_one_item_traversed_every_stage --deselect tests/test_doctor.py::test_no_commit_lacks_a_record --deselect tests/test_doctor.py::test_no_stop_lacks_cause --deselect tests/test_doctor.py::test_every_attested_item_is_sealed\"\n\n[paths]\nspecs = \"attest/specs\"\nrecords = \"attest/records\"\nrulings = \"attest/rulings.md\"\nrejections = \"attest/rejections\"\n\n[operators]\napprovers = [\"dbean10\"]\n\n[checks]\ncommand = \"python3 -m mypy\"\nprobe = \"python3 -c 'import pytest, mypy, jsonschema'\"\nprobe_timeout_s = 60\n\n[drive]\nstall_after_s = 1800\n","structuredPatch":[{"oldStart":55,"oldLines":3,"newStart":55,"newLines":11,"lines":[" "," [drive]"," stall_after_s = 1800","+attempts = 3","+retry_after_s = 300","+","+[drive.build]","+ceiling_s = 2400","+","+[drive.verify]","+ceiling_s = 1200"]}],"userModified":false,"replaceAll":false}}

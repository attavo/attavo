{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FTsR9kH6w38SXMTUWitKoY","type":"tool_result","content":"804\t    (exit 1). A stage running in its own worker is not bounded by this --\n805\t    only time spent waiting on the forge is.\"\"\"\n806\t    from attavo.verify import drive_forge_poll_bound_s, drive_forge_poll_interval_s\n807\t    bound = drive_forge_poll_bound_s()\n808\t    interval = drive_forge_poll_interval_s()\n809\t    waiting_since: float | None = None\n810\t    while True:\n811\t        rc, r = _pass_once(root, m, item_id, again)\n812\t        state = r[\"state\"]\n813\t\n814\t        if state == \"waiting-on-checks\":\n815\t            if waiting_since is None:\n816\t                waiting_since = time.monotonic()\n817\t            elif time.monotonic() - waiting_since >= bound:\n818\t                print(f\"attavo drive: stopped: the checks did not conclude within {bound:.0f}s\")\n819\t                return 1\n820\t        else:\n821\t            waiting_since = None\n822\t\n823\t        if rc != 0:\n824\t            return rc\n825\t        if state in _TERMINAL_STATES:\n826\t            return 0\n827\t        if state == \"blocked-on-checks\":\n828\t            return 1\n829\t        time.sleep(interval)\n830\t\n831\t\n832\tdef _drive_all() -> int:\n833\t    \"\"\"--all: one pass, in its own process, in every ../attavo-worktree-N\n834\t    beside this checkout -- each one derives its own item from its own\n835\t    attavo/N-* branch. Every line either prints is prefixed with the\n836\t    worktree's own directory name, so an operator reading them together\n837\t    can tell which item each line is about.\"\"\"\n838\t    root = Path(\".\").resolve()\n839\t    siblings = sorted(p for p in root.parent.glob(\"attavo-worktree-*\") if p.is_dir())\n840\t    if not siblings:\n841\t        print(\"attavo drive: --all found no ../attavo-worktree-N beside this checkout\")\n842\t        return 0\n843\t    worst = 0"}]},"parent_too
n850\t    (records / \"build-01.started\").write_text(json.dumps({\n851\t        \"at\": \"2026-09-17T13:16:08Z\", \"host\": socket.gethostname(), \"pid\": _dead_pid(),\n852\t        \"sha\": \"0\" * 40, \"product_version\": \"fixture\"}))\n853\t    (records / \"build-01.json\").write_text(json.dumps({\"status\": \"pass\"}))\n854\t    commit_all(root, \"invocation marker and its record for item 1\")\n855\t\n856\t    p = run_doctor(root)[\"no-invocation-lacks-record\"]\n857\t    assert p[\"holds\"], p[\"reason\"]\n858\t\n859\t\n860\tdef test_doctor_proof_five_reports_a_live_invocation_as_running_not_failed(tmp_path: Path) -> None:\n861\t    \"\"\"A marker naming this test's own pid, on this host, with no\n862\t    record: alive, so proof five holds and names it running rather than\n863\t    failing the tenant for a drive that has not had the chance to finish\n864\t    yet.\"\"\"\n865\t    root = tmp_path / \"live_invocation\"\n866\t    root.mkdir()\n867\t    (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n\\n'\n868\t                                      '[drive]\\nstall_after_s = 60\\n')\n869\t    init_repo(root, \"install\")\n870\t\n871\t    records = root / \"records\" / \"1\"\n872\t    records.mkdir(parents=True)\n873\t    (records / \"build-01.started\").write_text(json.dumps({\n874\t        \"at\": \"2026-09-17T13:16:08Z\", \"host\": socket.gethostname(), \"pid\": os.getpid(),\n875\t        \"sha\": \"0\" * 40, \"product_version\": \"fixture\"}))\n876\t    commit_all(root, \"invocation marker for a still-running invocation\")\n877\t\n878\t    p = run_doctor(root)[\"no-invocation-lacks-record\"]\n879\t    assert p[\"holds\"], p[\"reason\"]\n880\t    assert len(p[\"running_invocations\"]) == 1\n881\t    assert \"build-01\" in p[\"running_invocations\"][0]\n882\t\n883\t"}]},"parent_tool_use_id":null,"session_id":"ae622d81-efb9-4dda-92a0-5ebf75b0d73f","uuid":"871eb86e-3c79-43da-8309-0e85985b536f","timestamp":"2026-09-26T03:28:45.693Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-219/tests/test_doctor.py","content":"\n\ndef test_doctor_proof_five_fails_on_a_dead_invocation_with_no_record(tmp_path: Path) -> None:\n    \"\"\"Issue #151: a build-01.started marker naming a dead pid on this\n    host, with no build-01.json to retire it, is exactly the silence two\n    build attempts of item #148 left behind -- proof five names it.\"\"\"\n    root = tmp_path / \"dead_invocation\"\n    root.mkdir()\n    (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n\\n'\n                                      '[drive]\\nstall_after_s = 60\\n')\n    init_repo(root, \"install\")\n\n    records = root / \"records\" / \"1\"\n    records.mkdir(parents=True)\n    (records / \"build-01.started\").write_text(json.dumps({\n        \"at\": \"2026-09-17T13:16:08Z\", \"host\": socket.gethostname(), \"pid\": _dead_pid(),\n        \"sha\": \"0\" * 40, \"product_version\": \"fixture\"}))\n    commit_all(root, \"invocation marker for item 1\")\n\n    p = run_doctor(root)[\"no-invocation-lacks-record\"]\n    assert not p[\"holds\"]\n    assert \"build-01\" in p[\"reason\"] and \"never wrote its record\" in p[\"reason\"]\n\n\ndef test_doctor_proof_five_holds_once_the_record_arrives(tmp_path: Path) -> None:\n    \"\"\"The same marker, retired by its own build-01.json: proof five\n    holds -- the record's arrival is what retires a marker, not its\n    removal.\"\"\"\n    root = tmp_path / \"recorded_invocation\"\n    root.mkdir()\n    (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n\\n'\n                                      '[drive]\\nstall_after_s = 60\\n')\n    init_repo(root, \"install\")\n\n    records = root / \"records\" / \"1\"\n    records.mkdir(parents=True)\n    (records / \"build-01.started\").write_text(json.dumps({\n        \"at\": \"2026-09-17T13:16:08Z\", \"host\": socket.gethostname(), \"pid\": _dead_pid(),\n        \"sha\": \"0\" * 40, \"product_version\": \"fixture\"}))\n    (records / \"build-01.json\").write_text(json.dumps({\"status\": \"pass\"}))\n    commit_all(root, \"invocation marker and its record for item 1\")\n\n    p = run_doctor(root)[\"no-invocation-lacks-record\"]\n    assert p[\"holds\"], p[\"reason\"]\n\n\ndef test_doctor_proof_five_reports_a_live_invocation_as_running_not_failed(tmp_path: Path) -> None:\n    \"\"\"A marker naming this test's own pid, on this host, with no\n    record: alive, so proof five holds and names it running rather than\n    failing the tenant for a drive that has not had the chance to finish\n    yet.\"\"\"\n    root = tmp_path / \"live_invocation\"\n    root.mkdir()\n    (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n\\n'\n                                      '[drive]\\nstall_after_s = 60\\n')\n    init_repo(root, \"install\")\n\n    records = root / \"records\" / \"1\"\n    records.mkdir(parents=True)\n    (records / \"build-01.started\").write_text(json.dumps({\n        \"at\": \"2026-09-17T13:16:08Z\", \"host\": socket.gethostname(), \"pid\": os.getpid(),\n        \"sha\": \"0\" * 40, \"product_version\": \"fixture\"}))\n    commit_all(root, \"invocation marker for a still-running invocation\")\n\n    p = run_doctor(root)[\"no-invocation-lacks-record\"]\n    assert p[\"holds\"], p[\"reason\"]\n    assert len(p[\"running_invocations\"]) == 1\n    assert \"build-01\" in p[\"running_invocations\"][0]\n\n","numLines":70,"startLine":814,"totalLines":901}}}

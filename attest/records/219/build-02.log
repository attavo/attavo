heartbeat\n    file fresh within three beats of ATTAVO_HEARTBEAT_S is alive; a stale\n    one is died, whether or not the pid still lives -- a worker stuck\n    somewhere that never reaches its own heartbeat loop again is exactly\n    what this is for. Only with no heartbeat file at all -- an invocation\n    from before this release, or one that died before touching its\n    first beat -- does this fall back to the pid: alive and, with a\n    stall bound declared, past it is hung; alive with no bound, or\n    within it, is running for as long as it lives; not alive is died.\n    The stall bound decides hung, never died.\n\n    R3: the stage's own ceiling (wall clock from the marker's own `at`)\n    is judged first, before any of that -- alive past it is hung by the\n    ceiling whatever event age says, and an adapter that declares it\n    streams no events is judged by the ceiling alone: bound is read as\n    None for it, so the stall check below never fires on an event age it\n    never had.\"\"\"\n    stage, nn_text = marker.stem.rsplit(\"-\", 1)\n    nn = int(nn_text)\n    log, last_at = _events_tail(_events_path_for(root, stage, nn))\n    m = _manifest_of(root)\n    ceiling = ceiling_s(m, stage)\n    since_start = _seconds_since(info.get(\"at\"))\n    if ceiling is not None and since_start is not None and since_start > ceiling:\n        return InvocationReading(stage, nn, log, last_at, since_start, \"hung\", \"ceiling\")\n    if not _streams_events(root, m, stage):\n        bound = None\n    beat = heartbeat_path(root, stage, nn)\n    if beat.is_file():\n        try:\n            beat_age = time.time() - beat.stat().st_mtime\n        except OSError:\n            beat_age = None\n        cls = \"running\" if beat_age is not None and beat_age <= heartbeat_s() * 3 else \"died\"\n        return InvocationReading(stage, nn, log, last_at, beat_age, cls)\n    age = _seconds_since(last_at or info.get(\"at\"))\n    if not invocation_alive(info):\n        return InvocationReading(stage, nn, log, last_at, age, \"died\")\n    if bound is None or age is None or age <= bound:\n        return InvocationReading(stage, nn, log, last_at, age, \"running\")\n    return InvocationReading(stage, nn, log, last_at, age, \"hung\", \"stall\")"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":875,"cache_read_input_tokens":358379,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":875},"output_tokens":5,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"ae622d81-efb9-4dda-92a0-5ebf75b0d73f","uuid":"4ca7d460-b210-47ca-a4fa-fb681210a7df","timestamp":"2026-09-26T03:36:21.062Z","request_id":"req_011CfRMK55882bvodQRHxFkd","wire_tool_inputs":{"toolu_0187Xd9TgG3JaKrffnKHn4ep":{"file_path":"/Users/davidbean/Projects/attavo-worktree-219/attavo/drive.py","old_string":"class InvocationReading(NamedTuple):\n    \"\"\"What one marker with no record reads as, from here and now.\"\"\"\n    stage: str\n    nn: int\n    log: str\n    last_at: str | None\n    age: float | None\n    cls: str  # \"running\" | \"hung\" | \"died\"\n\n\ndef read_invocation(root: Path, bound: int | None, marker: Path, info: dict[str, Any]) -> InvocationReading:\n    \"\"\"Whether an invocation that began and wrote no record is running,\n    hung, or died -- read from its own heartbeat first (R2): a heartbeat\n    file fresh within three beats of ATTAVO_HEARTBEAT_S is alive; a stale\n    one is died, whether or not the pid still lives -- a worker stuck\n    somewhere that never reaches its own heartbeat loop again is exactly\n    what this is for. Only with no heartbeat file at all -- an invocation\n    from before this release, or one that died before touching its\n    first beat -- does this fall back to the pid: alive and, with a\n    stall bound declared, past it is hung; alive with no bound, or\n    within it, is running for as long as it lives; not alive is died.\n    The stall bound decides hung, never died.\"\"\"\n    stage, nn_text = marker.stem.rsplit(\"-\", 1)\n    nn = int(nn_text)\n    log, last_at = _events_tail(_events_path_for(root, stage, nn))\n    beat = heartbeat_path(root, stage, nn)\n    if beat.is_file():\n        try:\n            beat_age = time.time() - beat.stat().st_mtime\n        except OSError:\n            beat_age = None\n        cls = \"running\" if beat_age is not None and beat_age <= heartbeat_s() * 3 else \"died\"\n        return InvocationReading(stage, nn, log, last_at, beat_age, cls)\n    age = _seconds_since(last_at or info.get(\"at\"))\n    if not invocation_alive(info):\n        return InvocationReading(stage, nn, log, last_at, age, \"died\")\n    if bound is None or age is None or age <= bound:\n        return InvocationReading(stage, nn, log, last_at, age, \"running\")\n    return InvocationReading(stage, nn, log, last_at, age, \"hung\")","new_string":"class InvocationReading(NamedTuple):\n    \"\"\"What one marker with no record reads as, from here and now.\"\"\"\n    stage: str\n    nn: int\n    log: str\n    last_at: str | None\n    age: float | None\n    cls: str  # \"running\" | \"hung\" | \"died\"\n    bound: str | None = None  # R3: \"stall\" or \"ceiling\" when cls is \"hung\"\n\n\ndef _manifest_of(root: Path) -> dict[str, Any]:\n    m = read_manifest(root)\n    return m if m is not None else {}\n\n\ndef _streams_events(root: Path, m: dict[str, Any], stage: str) -> bool:\n    \"\"\"R3: whether stage's adapter declares it streams events at all\n    (adapters/<name>/conformance.json, \"streams_events\") -- one that does\n    not is judged by its ceiling alone, and never called hung by event\n    age it never produces. True (the ordinary case) when the adapter\n    declares nothing, or none is configured to ask.\"\"\"\n    name = (m.get(\"executor\") or {}).get(stage) or (m.get(\"executor\") or {}).get(\"build\")\n    if not name:\n        return True\n    for base in (root / \"attavo\" / \"adapters\", PRODUCT_ROOT / \"adapters\"):\n        conf = base / name / \"conformance.json\"\n        if conf.is_file():\n            try:\n                return bool(json.loads(conf.read_text()).get(\"streams_events\", True))\n            except (OSError, ValueError):\n                return True\n    return True\n\n\ndef read_invocation(root: Path, bound: int | None, marker: Path, info: dict[str, Any]) -> InvocationReading:\n    \"\"\"Whether an invocation that began and wrote no record is running,\n    hung, or died -- read from its own heartbeat first (R2): a heartbeat\n    file fresh within three beats of ATTAVO_HEARTBEAT_S is alive; a stale\n    one is died, whether or not the pid still lives -- a worker stuck\n    somewhere that never reaches its own heartbeat loop again is exactly\n    what this is for. Only with no heartbeat file at all -- an invocation\n    from before this release, or one that died before touching its\n    first beat -- does this fall back to the pid: alive and, with a\n    stall bound declared, past it is hung; alive with no bound, or\n    within it, is running for as long as it lives; not alive is died.\n    The stall bound decides hung, never died.\n\n    R3: the stage's own ceiling (wall clock from the marker's own `at`)\n    is judged first, before any of that -- alive past it is hung by the\n    ceiling whatever event age says, and an adapter that declares it\n    streams no events is judged by the ceiling alone: bound is read as\n    None for it, so the stall check below never fires on an event age it\n    never had.\"\"\"\n    stage, nn_text = marker.stem.rsplit(\"-\", 1)\n    nn = int(nn_text)\n    log, last_at = _events_tail(_events_path_for(root, stage, nn))\n    m = _manifest_of(root)\n    ceiling = ceiling_s(m, stage)\n    since_start = _seconds_since(info.get(\"at\"))\n    if ceiling is not None and since_start is not None and since_start > ceiling:\n        return InvocationReading(stage, nn, log, last_at, since_start, \"hung\", \"ceiling\")\n    if not _streams_events(root, m, stage):\n        bound = None\n    beat = heartbeat_path(root, stage, nn)\n    if beat.is_file():\n        try:\n            beat_age = time.time() - beat.stat().st_mtime\n        except OSError:\n            beat_age = None\n        cls = \"running\" if beat_age is not None and beat_age <= heartbeat_s() * 3 else \"died\"\n        return InvocationReading(stage, nn, log, last_at, beat_age, cls)\n    age = _seconds_since(last_at or info.get(\"at\"))\n    if not invocation_alive(info):\n        return InvocationReading(stage, nn, log, last_at, age, \"died\")\n    if bound is None or age is None or age <= bound:\n        return InvocationReading(stage, nn, log, last_at, age, \"running\")\n    return InvocationReading(stage, nn, log, last_at, age, \"hung\", \"stall\")"}}}

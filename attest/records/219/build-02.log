{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016zAfRcAiBJ3Y6seKfE1Kyd","type":"tool_result","content":"1\t#!/bin/sh\n2\t# adapters/fixture/run -- see ../README.md for the contract. Exists for the\n3\t# tests and the doctor; it is not an executor, and it never writes a record.\n4\tset -eu\n5\t\n6\twrite_name=\"${ATTAVO_FIXTURE_WRITE:-built.txt}\"\n7\t\n8\tif [ -n \"${ATTAVO_FIXTURE_CEILING_ERROR:-}\" ]; then\n9\t  # issue #89: a tool error line matching a declared ceiling (the\n10\t  # specimen is codex's own \"input_too_large\" on a diff too large to\n11\t  # judge, issue #86) -- for the ceiling/product rejection test only; a\n12\t  # real adapter's own tool prints this, never the adapter itself.\n13\t  echo \"Error: input_too_large: request exceeds the maximum context length\"\n14\t  exit 1\n15\tfi\n16\t\n17\techo \"ATTAVO_ADAPTER_CONFIG=${ATTAVO_ADAPTER_CONFIG:-}\"\n18\techo \"--- ATTAVO_FEEDBACK ---\"\n19\tcat \"${ATTAVO_FEEDBACK:-/dev/null}\" 2>/dev/null || true\n20\techo \"--- end feedback ---\"\n21\t\n22\tif [ -n \"${ATTAVO_EVENTS:-}\" ]; then\n23\t  # issue #26: three canned events, one of each executor kind, so the\n24\t  # conformance suite can assert the shape a real adapter's own mapping\n25\t  # must also produce -- this fixture has no real executor stream to map.\n26\t  at=\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"\n27\t  printf '{\"at\":\"%s\",\"kind\":\"message\",\"text\":\"fixture: starting\"}\\n' \"$at\" >> \"$ATTAVO_EVENTS\"\n28\t  printf '{\"at\":\"%s\",\"kind\":\"tool_call\",\"text\":\"fixture-tool arg1\"}\\n' \"$at\" >> \"$ATTAVO_EVENTS\"\n29\t  printf '{\"at\":\"%s\",\"kind\":\"tool_result\",\"text\":\"ok\"}\\n' \"$at\" >> \"$ATTAVO_EVENTS\"\n30\tfi\n31\t\n32\tif [ \"${ATTAVO_STAGE:-build}\" = \"counsel\" ]; then\n33\t  # issue #100: a read-only reading of a stop -- the record, its log, and\n34\t  # the diff, all handed by path, plus the tenant manifest and this\n35\t  # product's own root. Answers from a canned file\n36\t  # (ATTAVO_FIXTURE_COUNSEL_RESPONSE) when one is set, so a test controls\n37\t  # class/verdict/citations/proposal exactly; otherwise a canned \"person\"\n38\t  # verdict, since a fixture has no rules of its own to answer from.\n39\t  echo \"--- ATTAVO_COUNSEL_RECORD ---\"\n40\t  cat \"${ATTAVO_COUNSEL_RECORD:-/dev/null}\" 2>/dev/null || true\n41\t  echo \"--- end record ---\"\n42\t  echo \"--- ATTAVO_COUNSEL_LOG ---\"\n43\t  cat \"${ATTAVO_COUNSEL_LOG:-/dev/null}\" 2>/dev/null || true\n44\t  echo \"--- end log ---\"\n45\t  echo \"--- ATTAVO_COUNSEL_DIFF ---\"\n46\t  cat \"${ATTAVO_COUNSEL_DIFF:-/dev/null}\" 2>/dev/null || true\n47\t  echo \"--- end diff ---\"\n48\t  echo \"manifest: ${ATTAVO_MANIFEST:-}\"\n49\t  echo \"product root: ${ATTAVO_PRODUCT_ROOT:-}\"\n50\t  if [ -n \"${ATTAVO_FIXTURE_COUNSEL_RESPONSE:-}\" ]; then\n51\t    cat \"${ATTAVO_FIXTURE_COUNSEL_RESPONSE}\"\n52\t    echo\n53\t  else\n54\t    printf '{\"model\":\"fixture\",\"model_version\":null,\"adapter_version\":\"fixture-1\",\"tokens\":{\"input\":1,\"output\":1},\"cost_usd\":0.0,\"class\":\"unclassed\",\"verdict\":\"person\",\"citations\":[],\"proposal\":{\"ruling_text\":null,\"patch\":null,\"question\":\"what should we do about this stop?\"}}\\n'\n55\t  fi\n56\t  exit 0\n57\tfi\n58\t\n59\tif [ \"${ATTAVO_STAGE:-build}\" = \"verify\" ]; then\n60\t  echo \"--- ATTAVO_DIFF ---\"\n61\t  cat \"${ATTAVO_DIFF:-/dev/null}\" 2>/dev/null || true\n62\t  echo \"--- end diff ---\"\n63\t  if [ -n \"${ATTAVO_FIXTURE_COMMIT_DURING_VERIFY:-}\" ]; then\n64\t    # a verifier that commits anyway (issue #46) -- for the rejection\n65\t    # test only; a real adapter must never do this.\n66\t    echo \"should not exist\" > verify-side-effect.txt\n67\t    git add verify-side-effect.txt\n68\t    git commit -q -m \"fixture: illegitimate commit during verify\"\n69\t  fi\n70\t  if [ -n \"${ATTAVO_FIXTURE_OMIT_FINDINGS:-}\" ]; then\n71\t    # no findings key at all -- the absent-channel case issue #46 fixes,\n72\t    # disti
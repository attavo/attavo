{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LVCSyR4KKEeqJknyDf9Np1","type":"tool_result","content":"1\tfrom __future__ import annotations\n2\t\n3\timport fnmatch\n4\timport json\n5\timport os\n6\timport re\n7\timport subprocess\n8\tfrom pathlib import Path\n9\tfrom typing import Any\n10\t\n11\tfrom attavo.attest import check_attest_chain, item_time_and_cost\n12\tfrom attavo.common import (\n13\t    MANIFEST,\n14\t    Proof,\n15\t    STAGES,\n16\t    fixture_item_id,\n17\t    git,\n18\t    product_version,\n19\t    read_manifest,\n20\t)\n21\tfrom attavo.records import RECORD_RE, load_records, parse_attempts\n22\tfrom attavo.stops import STOP_CLASSES, STOP_PROVENANCES, STOP_STAGES, gate_stop\n23\t\n24\t# --- doctor's three proofs ---\n25\t\n26\tdef proof_every_gate_rejects(root: Path, m: dict[str, Any] | None) -> Proof:\n27\t    p = Proof(\"every-gate-rejects\", \"every gate rejects its fixture\")\n28\t    if m is None:\n29\t        return p.fail(f\"no {MANIFEST} at {root}; no gate is registered\")\n30\t    gates = m.get(\"gates\") or {}\n31\t    if not gates:\n32\t        return p.fail(\"[gates] is empty; a gate that has rejected nothing does not exist\")\n33\t    fixtures = root / m.get(\"paths\", {}).get(\"rejections\", \"\")\n34\t    # Proposal, not yet ruled on (issue #54): a gate that retires nothing\n35\t    # only adds, so proof one reports it here rather than waiting on the\n36\t    # schema alone -- read_manifest never validates against the manifest\n37\t    # schema at runtime, so a schema requirement is not an enforced one.\n38\t    no_retires = [name for name, gate in sorted(gates.items()) if not gate.get(\"retires\")]\n39\t    missing, accepted = [], []\n40\t    for name, gate in sorted(gates.items()):\n41\t        fixture = fixtures / name\n42\t        if not fixture.is_dir():\n43\t            missing.append(name)\n44\t            continue\n45\t        env = dict(os.environ)\n46\t        item = fixture_item_id(fixture)\n47\t        if item is not None:\n48\t            env[\"ATTAVO_ITEM\"] = item\n49\t        run = subprocess.run(gate[\"command\"], shell=True, cwd=str(fixture),\n50\t                             capture_output=True, text=True, check=False, env=env)\n51\t        if run.returncode == 0:\n52\t            accepted.append(name)\n53\t    if missing:\n54\t        return p.fail(f\"gate(s) with no rejection fixture: {', '.join(missing)}\")\n55\t    if accepted:\n56\t        return p.fail(f\"gate(s) that accepted their rejection fixture: {', '.join(accepted)}\")\n57\t    if no_retires:\n58\t        return p.fail(f\"gate(s) with no retires: {', '.join(no_retires)}\")\n59\t    return p.hold(f\"{len(gates)} gate(s) rejected their fixture\")\n60\t\n61\t\n62\tdef _merges_reachable(root: Path) -> tuple[list[dict[str, Any]], str | None]:\n63\t    \"\"\"(merges, refusal): every merge commit on the default branch's own\n64\t    first-parent line -- sha, parents, and its own first-parent diff --\n65\t    read by one process rather than the git log plus one git diff per\n66\t    merge merge_introducing_records used to pay walking toward the one\n67\t    it wants (issue #153). refs/remotes/origin/HEAD names the default\n68\t    branch without hard-coding \"main\", the same primitive\n69\t    diff_since_approval already uses (issue #52); walking from it rather\n70\t    than from HEAD is what keeps a transport merge on an item branch, a\n71\t    pull_request checkout's own synthetic test merge, and a merge_group's\n72\t    temporary merge from ever being mistaken for an item's merge (issue\n73\t    #169) -- none of those is reachable from the default branch's first-\n74\t    parent line by definition. When refs/remotes/origin/HEAD is not set,\n75\t    this refuses by name rather than guess, exactly as diff_since_approval\n76\t    does.\n77\t\n78\t    The walk starts at HEAD itself when the current checkout is literally\n79\t    on the branch refs/remotes/origin/HEAD names (an ordinary checkout of\n80\t    the default branch, on push or on a developer's own machine) and at\n81\t    the remote-tracking ref's own value otherwise (any other branch, or\n82\t    the detached HEAD a pull_request or merge_group checkout leaves\n83\t    behind) -- HEAD only ever *is* the default branch's first-parent line\n84\t    in the former case; in the latter, only the remote-tracking ref names\n85\t    it. --diff-merges=first-parent gives each merge's diff against its\n86\t    first parent in the same pass git log --merges already makes to list\n87\t    them, in the same order, newest first.\"\"\"\n88\t    symref = subprocess.run(\n89\t        [\"git\", \"-C\", str(root), \"symbolic-ref\", \"-q\", \"refs/remotes/origin/HEAD\"],\n90\t        capture_output=True, text=True, check=False)\n91\t    if symref.returncode != 0:\n92\t        return [], \"refs/remotes/origin/HEAD is not set; run `git remote set-head origin -a`\"\n93\t    default_remote_ref = symref.stdout.strip()\n94\t    default_branch = default_remote_ref.rsplit(\"/\", 1)[-1]\n95\t    current_branch = subprocess.run(\n96\t        [\"git\", \"-C\", str(root), \"symbolic-ref\", \"-q\", \"--short\", \"HEAD\"],\n97\t        capture_output=True, text=True, check=False)\n98\t    default_ref = (\"HEAD\" if current_branch.returncode == 0\n99\t                   and current_branch.stdout.strip() == default_branch\n100\t                   else default_remote_ref)\n101\t    try:\n102\t        out = git(root, \"log\", default_ref, \"--first-parent\", \"--merges\",\n103\t                 \"--diff-merges=first-parent\", \"--name-only\",\n104\t                 \"--format=\\x01%H\\x1f%P\")\n105\t    except RuntimeError:\n106\t        return [], None\n107\t    merges = []\n108\t    for block in out.split(\"\\x01\")[1:]:\n109\t        header, _, rest = block.partition(\"\\n\")\n110\t        sha, parents = header.split(\"\\x1f\")\n111\t        merges.append({\"sha\": sha, \"parents\": parents.split(),\n112\t                       \"touched\": [line for line in rest.splitlines() if line.strip()]})\n113\t    return merges, None\n114\t\n115\t\n116\tdef merge_introducing_records(root: Path, records_rel: str, item: str,\n117\t                              stages: tuple[str, ...],\n118\t                              merges: list[dict[str, Any]] | None = None) -> tuple[str | None, str | None]:\n119\t    \"\"\"(merge_sha, refusal): the merge commit on the default branch's own\n120\t    first-parent line whose first-parent diff introduces a record for\n121\t    every one of stages, under records_rel/item/ -- the same derivation\n122\t    attest itself uses (derive_attest_items), read here so proof two\n123\t    requires an item's stage records to have arrived by an actual merge\n124\t    on the default branch, not merely to sit in the tree, and not by a\n125\t    transport merge, a pull_request checkout's synthetic test merge, or a\n126\t    merge_group's temporary merge (issue #69 acceptance row 4; issue\n127\t    #169). merge_sha is None with no refusal when no such merge exists\n128\t    yet -- the item is not merged, not that the walk failed.\n129\t\n130\t    merges, when given, is _merges_reachable's own result -- ledger's\n131\t    cmd_ledger computes it once and passes it to every item rather than\n132\t    walking the default branch's merges again for each (issue #153); a\n133\t    caller that already has merges has also already handled\n134\t    _merges_reachable's refusal, so this never re-derives one. Left\n135\t    None, a caller with just the one item to ask (doctor's proof two)\n136\t    gets merges computed here, refusal and all.\"\"\"\n137\t    if merges is None:\n138\t        merges, refusal = _merges_reachable(root)\n139\t        if refusal:\n140\t            return None, refusal\n141\t    prefix = f\"{records_rel.rstrip('/')}/{item}/\"\n142\t    for merge in merges:\n143\t        found: set[str] = set()\n144\t        for p in merge[\"touched\"]:\n145\t            if p.startswith(prefix):\n146\t                m = RECORD_RE.match(Path(p).name)\n147\t                if m:\n148\t                    found.add(m.group(1))\n149\t        if all(s in found for s in stages):\n150\t            return merge[\"sha\"], None\n151\t    return None, None\n152\t\n153\t\n154\tINVOCATION_MARKER_SUFFIX = \".started\"\n155\t\n156\t\n157\tdef invocation_marker_path(records_dir: Path, stage: str, nn: int) -> Path:\n158\t    return records_dir / f\"{stage}-{nn:02d}{INVOCATION_MARKER_SUFFIX}\"\n159\t\n160\t\n161\tdef write_invocation_marker(root: Path, records_dir: Path, stage: str, nn: int) -> Path:\n162\t    \"\"\"The fact that an invocation began, written before it does: at,\n163\t    host, pid, the sha it starts on, and the product that started it.\n164\t    Its record's arrival is what retires it; a marker with no record is\n165\t    an invocation that died or hangs, and proof five names it.\"\"\"\n166\t    import os\n167\t    import socket\n168\t    from datetime import datetime, timezone\n169\t    records_dir.mkdir(parents=True, exist_ok=True)\n170\t    path = invocation_marker_path(records_dir, stage, nn)\n171\t    sha = git(root, \"rev-parse\", \"HEAD\").strip()\n172\t    info = {\"at\": datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\"),\n173\t            \"host\": socket.gethostname(), \"pid\": os.getpid(), \"sha\": sha,\n174\t            \"product_version\": product_version()}\n175\t    path.write_text(json.dumps(info, indent=2) + \"\\n\")\n176\t    return path\n177\t\n178\t\n179\tdef invocation_alive(info: dict[str, Any]) -> bool:\n180\t    \"\"\"Whether the marker's pid is a live process on this host. Another\n181\t    host's pid is unknowable from here and reads as not alive: a drive\n182\t    that ran elsewhere and wrote no record is died by absence.\"\"\"\n183\t    import os\n184\t    import socket\n185\t    if info.get(\"host\") != socket.gethostname():\n186\t        return False\n187\t    pid = info.get(\"pid\")\n188\t    if not isinstance(pid, int) or isinstance(pid, bool) or pid <= 0:\n189\t        return False\n190\t    try:\n191\t        os.kill(pid, 0)\n192\t    except ProcessLookupError:\n193\t        return False\n194\t    except PermissionError:\n195\t        return True\n196\t    return True\n197\t\n198\t\n199\tdef invocation_age_s(info: dict[str, Any]) -> float | None:\n200\t    \"\"\"Seconds since the marker's own `at` timestamp -- how long ago the\n201\t    invocation it names began, whatever host wrote it. None when `at` is\n202\t    missing or does not parse.\"\"\"\n203\t    from datetime import datetime, timezone\n204\t    at = info.get(\"at\")\n205\t    if not isinstance(at, str):\n206\t        return None\n207\t    try:\n208\t        stamp = datetime.strptime(at, \"%Y-%m-%dT%H:%M:%SZ\").replace(tzinfo=timezone.utc)\n209\t    except ValueError:\n210\t        return None\n211\t    return (datetime.now(timezone.utc) - stamp).total_seconds()\n212\t\n213\t\n214\tdef invocations_without_record(item_records_dir: Path) -> list[tuple[Path, dict[str, Any]]]:\n215\t    \"\"\"Every <stage>-NN.started under one item whose <stage>-NN.json has\n216\t    not arrived, with the marker's own dict ({} when unreadable).\"\"\"\n217\t    out: list[tuple[Path, dict[str, Any]]] = []\n218\t    if not item_records_dir.is_dir():\n219\t        return out\n220\t    for marker in sorted(item_records_dir.glob(f\"*{INVOCATION_MARKER_SUFFIX}\")):\n221\t        if (item_records_dir / f\"{marker.stem}.json\").is_file():\n222\t            continue\n223\t        try:\n224\t            with marker.open() as fh:\n225\t                info = json.load(fh)\n226\t        except (OSError, ValueError):\n227\t            info = {}\n228\t        out.append((marker, info if isinstance(info, dict) else {}))\n229\t    return out\n230\t\n231\t\n232\tdef stall_bound_s(m: dict[str, Any]) -> int | None:\n233\t    \"\"\"[drive].stall_after_s: the tenant's own bound past which a live\n234\t    invocation with no new event is hung. A bound the tenant did not\n235\t    write is a forecast, so there is no default.\"\"\"\n236\t    bound = (m.get(\"drive\") or {}).get(\"stall_after_s\")\n237\t    if isinstance(bound, bool) or not isinstance(bound, (int, float)) or bound <= 0:\n238\t        return None\n239\t    return int(bound)\n240\t\n241\t\n242\tdef proof_no_invocation_lacks_record(root: Path, m: dict[str, Any] | None) -> Proof:\n243\t    import socket\n244\t    p = Proof(\"no-invocation-lacks-record\", \"no invocation lacks its record\")\n245\t    if m is None:\n246\t        return p.fail(f\"no {MANIFEST} at {root}; no records directory is declared\")\n247\t    records_rel = m.get(\"paths\", {}).get(\"records\", \"\")\n248\t    records_dir = root / records_rel\n249\t    if not records_dir.is_dir():\n250\t        return p.fail(f\"no records directory under {records_dir}\")\n251\t    bound = stall_bound_s(m)\n252\t    if bound is None:\n253\t        return p.fail(\"no [drive].stall_after_s in the manifest; a hung invocation cannot be \"\n254\t                      \"told from a running one\")\n255\t    this_host = socket.gethostname()\n256\t    recorded = 0\n257\t    running: list[str] = []\n258\t    in_flight: list[str] = []\n259\t    problems: list[str] = []\n260\t    for item_dir in sorted(d for d in records_dir.iterdir() if d.is_dir()):\n261\t        for marker in item_dir.glob(f\"*{INVOCATION_MARKER_SUFFIX}\"):\n262\t            if (item_dir / f\"{marker.stem}.json\").is_file():\n263\t                recorded += 1\n264\t        for marker, info in invocations_without_record(item_dir):\n265\t            name = f\"item {item_dir.name} {marker.stem}\"\n266\t            if invocation_alive(info):\n267\t                running.append(f\"{name} (pid {info.get('pid')} since {info.get('at')})\")\n268\t                continue\n269\t            # A marker from another host is not alive by invocation_alive's\n270\t            # own reckoning (its pid is unknowable from here) but is not\n271\t            # yet a failure either: an invocation younger than the tenant's\n272\t            # own stall bound may simply be running elsewhere, still\n273\t            # writing toward its own record.\n274\t            if info.get(\"host\") != this_host:\n275\t                age = invocation_age_s(info)\n276\t                if age is not None and age < bound:\n277\t                    in_flight.append(f\"{name} (host {info.get('host')} since {info.get('at')})\")\n278\t                    continue\n279\t            problems.append(f\"{name} started {info.get('at')} on {info.get('host')} \"\n280\t                            f\"pid {info.get('pid')} and never wrote its record\")\n281\t    if problems:\n282\t        return p.fail(\"; \".join(problems), unrecorded_invocations=len(problems),\n283\t                      running_invocations=running, in_flight=in_flight)\n284\t    return p.hold(f\"{recorded} invocation(s) recorded, {len(running)} running, \"\n285\t                  f\"{len(in_flight)} in flight elsewhere\",\n286\t                  unrecorded_invocations=0, running_invocations=running, in_flight=in_flight)\n287\t\n288\t\n289\tdef proof_one_item_every_stage(root: Path, m: dict[str, Any] | None) -> Proof:\n290\t    p = Proof(\"one-item-every-stage\", \"one item has traversed every stage\")\n291\t    if m is None:\n292\t        return p.fail(f\"no {MANIFEST} at {root}; no records directory is declared\")\n293\t    records_rel = m.get(\"paths\", {}).get(\"records\", \"\")\n294\t    records_dir = root / records_rel\n295\t    items = load_records(records_dir)\n296\t    if not items:\n297\t        return p.fail(f\"no work item under {records_dir.relative_to(root)}\")\n298\t    complete = [item for item, stages in items.items() if all(s in stages for s in STAGES)]\n299\t    if not complete:\n300\t        best = max(items.items(), key=lambda kv: len(kv[1]))\n301\t        lacking = [s for s in STAGES if s not in best[1]]\n302\t        return p.fail(f\"no item carries every stage; item {best[0]} lacks {', '.join(lacking)}\")\n303\t\n304\t    # issue #74: a complete item is counted only when its chain holds --\n305\t    # attavo attest refuses a build re-approved after the fact or a\n306\t    # verify whose build went stale, and the coherence gate refuses the\n307\t    # merge group on exactly that; a proof that never asked would call a\n308\t    # traversal the gate itself would not let through. The refusal text\n309\t    # is check_attest_chain's own, never re-typed here.\n310\t    refused, held, unmerged = [], [], []\n311\t    for item in complete:\n312\t        chain, message = check_attest_chain(records_dir / item, item)\n313\t        if chain is None:\n314\t            refused.append(f\"item {item}: {message}\")\n315\t            continue\n316\t        merge_sha, merge_refusal = merge_introducing_records(root, records_rel, item, STAGES)\n317\t        if merge_refusal:\n318\t            return p.fail(merge_refusal)\n319\t        if merge_sha:\n320\t            held.append((item, merge_sha))\n321\t        else:\n322\t            unmerged.append(item)\n323\t\n324\t    if held:\n325\t        names = \", \".join(item for item, _ in held)\n326\t        shas = \", \".join(sha[:12] for _, sha in held)\n327\t        return p.hold(f\"item(s) {names} carry {', '.join(STAGES)} with the chain held, \"\n328\t                      f\"merged at {shas}\")\n329\t    if refused:\n330\t        return p.fail(\"; \".join(refused))\n331\t    return p.fail(f\"item(s) {', '.join(unmerged)} carry every stage with the chain held but no \"\n332\t                  f\"merge commit's first-parent diff introduces all of them\")\n333\t\n334\t\n335\tdef commit_subject(root: Path, sha: str) -> str:\n336\t    return git(root, \"log\", \"-1\", \"--format=%s\", sha).strip()\n337\t\n338\t\n339\tdef touches_boundary(root: Path, sha: str, boundary_paths: list[str]) -> bool:\n340\t    \"\"\"Whether sha's first-parent diff touches a path [spec.boundary].paths\n341\t    declares governed -- an ordinary merge that does is a boundary\n342\t    evasion (issue #72): the tenant carried a governed change around the\n343\t    path the manifest itself names.\"\"\"\n344\t    diff = git(root, \"diff\", \"--name-only\", f\"{sha}^1\", sha).splitlines()\n345\t    return any(fnmatch.fnmatch(path, pattern) for path in diff for pattern in boundary_paths)\n346\t\n347\t\n348\tclass WindowRefused(Exception):\n349\t    \"\"\"The window start cannot be computed; str(exc) is the refusal.\"\"\"\n350\t\n351\t\n352\tdef proof_window_start(root: Path, m: dict[str, Any]) -> tuple[str, str, list[str]]:\n353\t    \"\"\"(install commit, window start, first-parent chain after the install\n354\t    commit): where proofs three and six start reading. The start is\n355\t    [doctor].from if the tenant set it, otherwise the commit that\n356\t    introduced the manifest (issue #192: proof six reads this too, so the\n357\t    two proofs cannot disagree).\"\"\"\n358\t    try:\n359\t        install = git(root, \"log\", \"--diff-filter=A\", \"--format=%H\",\n360\t                      \"--reverse\", \"--\", MANIFEST).split()\n361\t    except RuntimeError as exc:\n362\t        raise WindowRefused(f\"git: {exc}\") from exc\n363\t    if not install:\n364\t        raise WindowRefused(f\"{MANIFEST} is not committed; the tenant has no record boundary\")\n365\t    install_sha = install[0]\n366\t    full_chain = git(root, \"rev-list\", f\"{install_sha}..HEAD\", \"--first-parent\").split()\n367\t\n368\t    # issue #74: [doctor] from lets a tenant declare the doctor's read to\n369\t    # start at a later commit on main's first-parent line -- the point\n370\t    # after which every push arrived through the queue -- rather than the\n371\t    # install commit, which on a repository that adopted the product\n372\t    # after its history began is a boundary the doctor cannot otherwise\n373\t    # see. Any spelling git resolves is accepted (a short sha, a tag, a\n374\t    # ref) -- resolved with rev-parse --verify before the first-parent\n375\t    # check runs, so the two failure modes stay distinct: a spelling that\n376\t    # names no commit at all, and a commit that names one off the line.\n377\t    # Checked, not trusted: neither is silently forgiven back to install.\n378\t    declared_from = (m.get(\"doctor\") or {}).get(\"from\")\n379\t    window_start = install_sha\n380\t    if declared_from is not None:\n381\t        try:\n382\t            resolved_from = git(root, \"rev-parse\", \"--verify\", f\"{declared_from}^{{commit}}\").strip()\n383\t        except RuntimeError:\n384\t            raise WindowRefused(f\"[doctor] from {declared_from} does not resolve to a commit\") from None\n385\t        if resolved_from != install_sha and resolved_from not in full_chain:\n386\t            raise WindowRefused(f\"[doctor] from {declared_from} is not on main's first-parent \"\n387\t                                f\"line after the install commit {install_sha[:12]}\")\n388\t        window_start = resolved_from\n389\t    return install_sha, window_start, full_chain\n390\t\n391\t\n392\tdef proof_no_commit_lacks_record(root: Path, m: dict[str, Any] | None) -> Proof:\n393\t    p = Proof(\"no-commit-lacks-record\", \"no commit lacks a record\")\n394\t    if m is None:\n395\t        return p.fail(f\"no {MANIFEST} at {root}; the tenant has no record boundary\")\n396\t    try:\n397\t        install_sha, window_start, full_chain = proof_window_start(root, m)\n398\t    except WindowRefused as exc:\n399\t        return p.fail(str(exc))\n400\t    if not full_chain:\n401\t        return p.fail(f\"no commit after the install commit {install_sha[:12]}; nothing has been recorded\")\n402\t\n403\t    if window_start == install_sha:\n404\t        window_spec = f\"{install_sha}..HEAD\"\n405\t        commits = full_chain\n406\t    else:\n407\t        window_spec = f\"{window_start}^..HEAD\"\n408\t        commits = git(root, \"rev-list\", window_spec, \"--first-parent\").split()\n409\t    before_window = len(full_chain) - len(commits)\n410\t\n411\t    records_rel = m.get(\"paths\", {}).get(\"records\", \"\")\n412\t    records_dir = root / records_rel\n413\t    named: set[str] = set()\n414\t    for stages in load_records(records_dir).values():\n415\t        for rec in stages.values():\n416\t            sha = rec.get(\"sha\")\n417\t            if isinstance(sha, str):\n418\t                named.add(sha)\n419\t            for c in rec.get(\"commits\", []) or []:\n420\t                if isinstance(c, str):\n421\t                    named.add(c)\n422\t    record_commits = set(git(root, \"rev-list\", window_spec, \"--first-parent\",\n423\t                             \"--\", records_rel).split()) if records_rel else set()\n424\t    merges = set(git(root, \"rev-list\", window_spec, \"--first-parent\", \"--merges\").split())\n425\t    boundary_paths = ((m.get(\"spec\") or {}).get(\"boundary\") or {}).get(\"paths\") or []\n426\t\n427\t    # Every first-parent commit in the window is exactly one of three\n428\t    # (issue #72): recorded (a record names it, or its diff touches\n429\t    # paths.records), ordinary (a merge that doesn't), or unrecorded\n430\t    # (anything else -- on a protected main with a queue, a non-merge\n431\t    # commit is the only way a change arrives without the forge).\n432\t    recorded, ordinary, unrecorded = [], [], []\n433\t    ordinary_commits, unrecorded_commits = [], []\n434\t    boundary_evasions = 0\n435\t    for c in commits:\n436\t        if c in named or c in record_commits:\n437\t            recorded.append(c)\n438\t        elif c in merges:\n439\t            ordinary.append(c)\n440\t            evasion = bool(boundary_paths and touches_boundary(root, c, boundary_paths))\n441\t            if evasion:\n442\t                boundary_evasions += 1\n443\t            ordinary_commits.append({\"sha\": c, \"subject\": commit_subject(root, c),\n444\t                                     \"boundary_evasion\": evasion})\n445\t        else:\n446\t            unrecorded.append(c)\n447\t            unrecorded_commits.append({\"sha\": c, \"subject\": commit_subject(root, c)})\n448\t\n449\t    counts = f\"{len(recorded)} recorded, {len(ordinary)} ordinary, {len(unrecorded)} unrecorded\"\n450\t    evasions = boundary_evasions if boundary_paths else \"n/a\"\n451\t    extra = {\"recorded\": len(recorded), \"ordinary\": len(ordinary),\n452\t             \"unrecorded\": len(unrecorded), \"boundary_evasions\": evasions,\n453\t             \"before_window\": before_window,\n454\t             \"ordinary_commits\": ordinary_commits, \"unrecorded_commits\": unrecorded_commits}\n455\t    if unrecorded:\n456\t        return p.fail(f\"{unrecorded[-1][:12]} lacks a record; {counts}; boundary evasions: \"\n457\t                      f\"{evasions}; before the window: {before_window}\", **extra)\n458\t    return p.hold(f\"{counts}; boundary evasions: {evasions}; before the window: {before_window}\",\n459\t                  **extra)\n460\t\n461\t\n462\tADAPTER_EXIT_RE = re.compile(r\"^\\[adapter exited \\d+\\]$\")\n463\t\n464\t_JSON_LINE_PARSE_FAILED = object()\n465\t\n466\t\n467\tdef _parse_json_line(text: str) -> Any:\n468\t    \"\"\"A line's own parsed JSON value, or the sentinel\n469\t    _JSON_LINE_PARSE_FAILED when it does not parse -- the one call site\n470\t    in this file for a defensive, line-at-a-time JSON parse, shared by\n471\t    proof four's own tool-error check below (any valid JSON satisfies\n472\t    it) and an events line's own `at` read (issue #151, which further\n473\t    requires a dict). A dedicated sentinel, not None: a line that is\n474\t    the literal JSON value null parses successfully and must read as\n475\t    such, not as a failure.\"\"\"\n476\t    try:\n477\t        return json.loads(text)\n478\t    except ValueError:\n479\t        return _JSON_LINE_PARSE_FAILED\n480\t\n481\t\n482\tdef _log_owes_tool_error(log: str | None) -> bool:\n483\t    \"\"\"True when a log's last non-empty line is exactly an adapter-exit\n484\t    marker and every line before it parses as JSON -- an adapter's own\n485\t    event stream, never a tool's own words (issue #94's own specimen,\n486\t    tenant zero's attest/records/659/verify-01.log: codex's\n487\t    \"thread.started\" event, then nothing but \"[adapter exited 1]\" -- the\n488\t    tool's real error line dropped before this reached the log, issue\n489\t    #86's own bug in split_adapter_stdout). A log that is only the exit\n490\t    marker, nothing before it at all, still owes the same line. An\n491\t    `error` event with a non-empty string `message` is the tool's own\n492\t    error delivered as an event (issue #200: \"Selected model is at\n493\t    capacity\"), so it owes nothing.\"\"\"\n494\t    if not log:\n495\t        return False\n496\t    lines = [l for l in log.splitlines() if l.strip()]\n497\t    if not lines or not ADAPTER_EXIT_RE.match(lines[-1]):\n498\t        return False\n499\t    for l in lines[:-1]:\n500\t        parsed = _parse_json_line(l)\n501\t        if parsed is _JSON_LINE_PARSE_FAILED:\n502\t            return False\n503\t        if isinstance(parsed, dict) and parsed.get(\"type\") == \"error\":\n504\t            message = parsed.get(\"message\")\n505\t            if isinstance(message, str) and message:\n506\t                return False\n507\t    return True\n508\t\n509\t\n510\tdef proof_no_stop_lacks_cause(root: Path, m: dict[str, Any] | None) -> Proof:\n511\t    p = Proof(\"no-stop-lacks-cause\", \"no stop lacks its cause\")\n512\t    if m is None:\n513\t        return p.fail(f\"no {MANIFEST} at {root}; no records directory is declared\")\n514\t    records_rel = m.get(\"paths\", {}).get(\"records\", \"\")\n515\t    records_dir = root / records_rel\n516\t    if not records_dir.is_dir():\n517\t        return p.fail(f\"no records directory under {records_dir}\")\n518\t\n519\t    # issue #89's own window lesson, proof three's already: a record\n520\t    # before record_version 3 has no stop by construction (schema\n521\t    # versions 1 and 2 predate it) -- counted here, never refused.\n522\t    older = 0\n523\t    checked = 0\n524\t    problems: list[str] = []\n525\t    for item_dir in sorted(d for d in records_dir.iterdir() if d.is_dir()):\n526\t        for stage in STOP_STAGES:\n527\t            for n, rec in sorted(parse_attempts(item_dir, stage).items()):\n528\t                if rec.get(\"record_version\", 1) < 3:\n529\t                    older += 1\n530\t                    continue\n531\t                if rec.get(\"status\") == \"pass\":\n532\t                    continue\n533\t                checked += 1\n534\t                name = f\"{stage}-{n:02d}\"\n535\t                stop = rec.get(\"stop\")\n536\t                if not stop:\n537\t                    problems.append(f\"item {item_dir.name} {name} carries no stop\")\n538\t                    continue\n539\t                cls, provenance = stop.get(\"class\"), stop.get(\"provenance\")\n540\t                if cls not in STOP_CLASSES:\n541\t                    problems.append(f\"item {item_dir.name} {name} stop.class {cls!r} names \"\n542\t                                    f\"no enumerated class\")\n543\t                    continue\n544\t                if provenance not in STOP_PROVENANCES:\n545\t                    problems.append(f\"item {item_dir.name} {name} stop.provenance \"\n546\t                                    f\"{provenance!r} names no enumerated provenance\")\n547\t                    continue\n548\t                if cls == \"unclassed\" and not stop.get(\"detail\"):\n549\t                    problems.append(f\"item {item_dir.name} {name} is unclassed with no detail\")\n550\t                    continue\n551\t                log_path = item_dir / f\"{name}.log\"\n552\t                log = log_path.read_text() if log_path.is_file() else None\n553\t                # Issue #89, rejection test 1's own specimen (tenant\n554\t                # zero's #659 build-01): a failed build that actually ran\n555\t                # the gates -- selected_tests is set only once cmd_build\n556\t                # reaches them -- owes their heading in the log, whatever\n557\t                # else stop already says.\n558\t                if (stage == \"build\" and rec.get(\"status\") == \"failed\"\n559\t                        and rec.get(\"selected_tests\") is not None\n560\t                        and \"--- attavo gates, iteration\" not in (log or \"\")):\n561\t                    problems.append(f\"item {item_dir.name} {name} failed after the gates ran \"\n562\t                                    f\"but its log carries no gates heading\")\n563\t                    continue\n564\t                if _log_owes_tool_error(log):\n565\t                    problems.append(f\"item {item_dir.name} {name}'s log ends in an adapter \"\n566\t                                    f\"exit with nothing before it but event lines; the tool's \"\n567\t                                    f\"own error line is owed\")\n568\t\n569\t        # issue #137: a refused spec-gate record is a stop too, class\n570\t        # \"gate\" -- synthesized the same way item_stops and\n571\t        # cmd_file_stops already read it, since cmd_spec_gate itself\n572\t        # carries no stop field to check for one. No record_version\n573\t        # gate here: unlike build/verify's own stop field, gate is never\n574\t        # persisted, so there is no older shape that predates it.\n575\t        for n, rec in sorted(parse_attempts(item_dir, \"spec\").items()):\n576\t            if rec.get(\"status\") != \"refused\":\n577\t                continue\n578\t            checked += 1\n579\t            name = f\"spec-{n:02d}\"\n580\t            stop = gate_stop(rec.get(\"refusal\"))\n581\t            cls, provenance = stop[\"class\"], stop[\"provenance\"]\n582\t            if cls not in STOP_CLASSES:\n583\t                problems.append(f\"item {item_dir.name} {name} stop.class {cls!r} names \"\n584\t                                f\"no enumerated class\")\n585\t                continue\n586\t            if provenance not in STOP_PROVENANCES:\n587\t                problems.append(f\"item {item_dir.name} {name} stop.provenance \"\n588\t                                f\"{provenance!r} names no enumerated provenance\")\n589\t                continue\n590\t            if not stop.get(\"detail\"):\n591\t                problems.append(f\"item {item_dir.name} {name} is a gate stop with no cause\")\n592\t\n593\t    older_note = f\"{older} record(s) before stop was recorded\"\n594\t    if problems:\n595\t        return p.fail(\"; \".join(problems), older_records=older)\n596\t    return p.hold(f\"{checked} checked ({older_note})\" if checked == 0\n597\t                 else f\"{checked} non-pass record(s) carry stop with a cause ({older_note})\",\n598\t                 older_records=older)\n599\t\n600\t\n601\tdef attestation_command(m: dict[str, Any]) -> str | None:\n602\t    \"\"\"[forge].attestation_command: the tenant's own read of the store,\n603\t    given a merge sha on stdin, printing the statement as JSON on exit 0\n604\t    and nothing on a non-zero exit. Absent is not passing (issue #158:\n605\t    the doctor said done while #106, #148, #153 had no statement in the\n606\t    store at all -- there was no key to read one through).\"\"\"\n607\t    cmd = (m.get(\"forge\") or {}).get(\"attestation_command\")\n608\t    return cmd if isinstance(cmd, str) and cmd.strip() else None\n609\t\n610\t\n611\tdef statement_for(root: Path, cmd: str, merge_sha: str) -> tuple[dict[str, Any] | None, int]:\n612\t    \"\"\"The statement the forge holds for merge_sha and the command's exit\n613\t    code. The statement is None when the command exits non-zero or prints\n614\t    anything but a JSON object -- exit 2 means the store itself could not\n615\t    be read (issue #158, amended after build-05: distinct from exit 1,\n616\t    the store read fine and simply held no statement).\"\"\"\n617\t    run = subprocess.run(cmd, shell=True, cwd=str(root), input=merge_sha + \"\\n\",\n618\t                         capture_output=True, text=True, check=False)\n619\t    if run.returncode != 0:\n620\t        return None, run.returncode\n621\t    try:\n622\t        parsed = json.loads(run.stdout)\n623\t    except ValueError:\n624\t        return None, run.returncode\n625\t    return (parsed if isinstance(parsed, dict) else None), run.returncode\n626\t\n627\t\n628\tdef _is_ancestor(root: Path, earlier: str, later: str) -> bool:\n629\t    run = subprocess.run([\"git\", \"-C\", str(root), \"merge-base\", \"--is-ancestor\", earlier, later],\n630\t                         capture_output=True, check=False)\n631\t    return run.returncode == 0\n632\t\n633\t\n634\t# Maps whose keys are the records' data (a stage or an adapter that cost\n635\t# something), not a release's fields: a key missing from one is a difference.\n636\tDATA_KEYED = (\"by_stage_usd\", \"by_adapter_usd\")\n637\t\n638\t\n639\tdef _same(stated: Any, summed: Any) -> bool:\n640\t    \"\"\"Equal as the accounting means it: a number equals a number of the\n641\t    same value (a store may print 40.0 as 40), a bool equals only a bool,\n642\t    and a list is equal member by member. No tolerance and no conversion:\n643\t    both sides are the same function's rounding of the same records, and an\n644\t    int one past 2**53 is not the float beside it.\"\"\"\n645\t    if isinstance(stated, bool) or isinstance(summed, bool):\n646\t        return isinstance(stated, bool) and isinstance(summed, bool) and stated == summed\n647\t    if isinstance(stated, (int, float)) and isinstance(summed, (int, float)):\n648\t        return bool(stated == summed)\n649\t    if isinstance(stated, list) and isinstance(summed, list):\n650\t        return len(stated) == len(summed) and all(_same(a, b) for a, b in zip(stated, summed))\n651\t    return type(stated) is type(summed) and bool(stated == summed)\n652\t\n653\t\n654\tdef _differences(path: str, stated: Any, summed: Any, keyed_by_data: bool = False) -> list[str]:\n655\t    \"\"\"Every field of `stated` that is not what its records sum to, named by\n656\t    its path. Only the keys the statement carries are compared, at every\n657\t    depth, so a field a later release adds is not demanded of a statement\n658\t    sealed before it; a key it carries that the function does not produce\n659\t    is a difference.\"\"\"\n660\t    if not (isinstance(stated, dict) and isinstance(summed, dict)):\n661\t        return [] if _same(stated, summed) else [f\"{path} {stated!r} is not its records' {summed!r}\"]\n662\t    found: list[str] = []\n663\t    for key in sorted(stated):\n664\t        if key not in summed:\n665\t            found.append(f\"{path}.{key} {stated[key]!r} is not a field its records sum to\")\n666\t        else:\n667\t            found += _differences(f\"{path}.{key}\", stated[key], summed[key], key in DATA_KEYED)\n668\t    if keyed_by_data:\n669\t        found += [f\"{path}.{key} is absent; its records sum to {summed[key]!r}\"\n670\t                  for key in sorted(summed.keys() - stated.keys())]\n671\t    return found\n672\t\n673\t\n674\tdef _carried(predicate: dict[str, Any], key: str) -> str:\n675\t    return repr(predicate[key]) if key in predicate else \"absent\"\n676\t\n677\t\n678\tdef _accounting_disagrees(root: Path, item_records_dir: Path, item: str, merge_sha: str,\n679\t                          statement: dict[str, Any]) -> str | None:\n680\t    \"\"\"A sealed statement that carries `time` and `cost` says what its\n681\t    records sum to, field by field -- the same function attest summed them\n682\t    with, over the same records (none is written after a merge), sealed at\n683\t    the same commit (the statement is computed at the merge, so lead_s and\n684\t    waiting_s are recomputed from its committer time, not excepted). Exact:\n685\t    #202 retired the one-second tolerance. A statement sealed before `time`\n686\t    existed carries neither key and is not checked; a key that is present\n687\t    holds a block, so a null one, or one block without the other, is a\n688\t    disagreement. No new read of the store.\"\"\"\n689\t    inner = statement.get(\"predicate\")\n690\t    predicate = inner if isinstance(inner, dict) else statement\n691\t    if \"time\" not in predicate and \"cost\" not in predicate:\n692\t        return None\n693\t    stated_time, stated_cost = predicate.get(\"time\"), predicate.get(\"cost\")\n694\t    where = f\"item {item} merged at {merge_sha[:12]}\"\n695\t    if not isinstance(stated_time, dict) or not isinstance(stated_cost, dict):\n696\t        return (f\"{where}: the statement's time and cost are not both blocks \"\n697\t                f\"(time is {_carried(predicate, 'time')}, cost is {_carried(predicate, 'cost')})\")\n698\t    try:\n699\t        sealed_at: int | None = int(git(root, \"show\", \"-s\", \"--format=%ct\", merge_sha).strip())\n700\t    except (RuntimeError, ValueError):\n701\t        sealed_at = None\n702\t    summed_time, summed_cost = item_time_and_cost(item_records_dir, sealed_at)\n703\t    differing = (_differences(\"time\", stated_time, dict(summed_time))\n704\t                 + _differences(\"cost\", stated_cost, dict(summed_cost)))\n705\t    if differing:\n706\t        return f\"{where}: the statement's \" + \"; \".join(differing)\n707\t    return None\n708\t\n709\t\n710\tdef proof_every_attested_item_is_sealed(root: Path, m: dict[str, Any] | None) -> Proof:\n711\t    p = Proof(\"every-attested-item-is-sealed\", \"every attested item has its statement in the store\")\n712\t    if m is None:\n713\t        return p.fail(f\"no {MANIFEST} at {root}; no records directory is declared\")\n714\t    cmd = attestation_command(m)\n715\t    if cmd is None:\n716\t        return p.fail(\"no [forge].attestation_command in the manifest; the store cannot be read\")\n717\t    records_rel = m.get(\"paths\", {}).get(\"records\", \"\")\n718\t    records_dir = root / records_rel\n719\t    if not records_dir.is_dir():\n720\t        return p.fail(f\"no records directory under {records_dir}\")\n721\t    items = load_records(records_dir)\n722\t    complete = [item for item, stages in sorted(items.items()) if all(s in stages for s in STAGES)]\n723\t\n724\t    # [forge].sealed_since: merges at or before this commit are before the\n725\t    # window -- the tenant could not seal them (no queue, no signing\n726\t    # workflow, or a store that held nothing yet). They are named, never\n727\t    # failed. Absent, the window starts where proof three's does: the\n728\t    # install commit, or [doctor].from (issue #192).\n729\t    since = (m.get(\"forge\") or {}).get(\"sealed_since\")\n730\t    if not (isinstance(since, str) and since.strip()):\n731\t        try:\n732\t            since = proof_window_start(root, m)[1]\n733\t        except WindowRefused as exc:\n734\t            return p.fail(str(exc))\n735\t    merges, refusal = _merges_reachable(root)\n736\t    if refusal:\n737\t        return p.fail(refusal)\n738\t    sealed: list[str] = []\n739\t    before_window: list[str] = []\n740\t    unsealed: list[str] = []\n741\t    not_merged: list[str] = []\n742\t    not_read: list[str] = []\n743\t    reasons: list[str] = []\n744\t    for item in complete:\n745\t        merge_sha, _ = merge_introducing_records(root, records_rel, item, STAGES, merges=merges)\n746\t        if merge_sha is None:\n747\t            not_merged.append(item)\n748\t            continue\n749\t        if _is_ancestor(root, merge_sha, since):\n750\t            before_window.append(item)\n751\t            continue\n752\t        statement, exit_code = statement_for(root, cmd, merge_sha)\n753\t        if statement is not None:\n754\t            sealed.append(item)\n755\t            disagreement = _accounting_disagrees(root, records_dir / item, item, merge_sha,\n756\t                                                 statement)\n757\t            if disagreement:\n758\t                reasons.append(disagreement)\n759\t        elif exit_code == 2:\n760\t            not_read.append(item)\n761\t            reasons.append(f\"item {item} merged at {merge_sha[:12]}: not read -- \"\n762\t                           f\"the store could not be read; {cmd!r} exited 2\")\n763\t        else:\n764\t            unsealed.append(item)\n765\t            reasons.append(f\"item {item} merged at {merge_sha[:12]} has no statement in the store\")\n766\t    if reasons:\n767\t        return p.fail(\"; \".join(reasons), sealed=sealed, before_window=before_window,\n768\t                      unsealed=unsealed, not_merged=not_merged, not_read=not_read)\n769\t    window = f\" at {since[:12]}\" if before_window else \"\"\n770\t    return p.hold(f\"{len(sealed)} sealed, {len(before_window)} before the window{window}, \"\n771\t                 f\"{len(not_merged)} not merged\",\n772\t                 sealed=sealed, before_window=before_window, unsealed=unsealed,\n773\t                 not_merged=not_merged, not_read=not_read)\n774\t\n775\t\n776\tdef doctor(root: Path) -> list[Proof]:\n777\t    m = read_manifest(root)\n778\t    return [proof_every_gate_rejects(root, m),\n779\t            proof_one_item_every_stage(root, m),\n780\t            proof_no_commit_lacks_record(root, m),\n781\t            proof_no_stop_lacks_cause(root, m),\n782\t            proof_no_invocation_lacks_record(root, m),\n783\t            proof_every_attested_item_is_sealed(root, m)]\n784\t\n785\t\n786\tdef cmd_doctor(argv: list[str]) -> int:\n787\t    as_json = \"--json\" in argv\n788\t    args = [a for a in argv if a != \"--json\"]\n789\t    root = Path(args[0] if args else \".\").resolve()\n790\t    proofs = doctor(root)\n791\t    if as_json:\n792\t        print(json.dumps({\"root\": str(root), \"done\": all(p.holds for p in proofs),\n793\t                          \"proofs\": [p.as_dict() for p in proofs]}, indent=2))\n794\t    else:\n795\t        for i, p in enumerate(proofs, 1):\n796\t            print(f\"proof {i} {p.key}: {'HOLDS' if p.holds else 'FAILS'}: {p.reason}\")\n797\t        print(\"doctor: done\" if all(p.holds for p in proofs)\n798\t              else f\"doctor: not done ({sum(not p.holds for p in proofs)} of \"\n799\t                   f\"{len(proofs)} proofs fail)\")\n800\t    return 0 if all(p.holds for p in proofs) else 1\n801\t"}]},"parent_tool_use_id":null,"session_id":"ae622d81-efb9-4dda-92a0-5ebf75b0d73f","uuid":"42e7a381-5bd1-4e48-9990-15f6e841eddf","timestamp":"2026-09-26T03:18:43.198Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-219/attavo/doctor.py","content":"from __future__ import annotations\n\nimport fnmatch\nimport json\nimport os\nimport re\nimport subprocess\nfrom pathlib import Path\nfrom typing import Any\n\nfrom attavo.attest import check_attest_chain, item_time_and_cost\nfrom attavo.common import (\n    MANIFEST,\n    Proof,\n    STAGES,\n    fixture_item_id,\n    git,\n    product_version,\n    read_manifest,\n)\nfrom attavo.records import RECORD_RE, load_records, parse_attempts\nfrom attavo.stops import STOP_CLASSES, STOP_PROVENANCES, STOP_STAGES, gate_stop\n\n# --- doctor's three proofs ---\n\ndef proof_every_gate_rejects(root: Path, m: dict[str, Any] | None) -> Proof:\n    p = Proof(\"every-gate-rejects\", \"every gate rejects its fixture\")\n    if m is None:\n        return p.fail(f\"no {MANIFEST} at {root}; no gate is registered\")\n    gates = m.get(\"gates\") or {}\n    if not gates:\n        return p.fail(\"[gates] is empty; a gate that has rejected nothing does not exist\")\n    fixtures = root / m.get(\"paths\", {}).get(\"rejections\", \"\")\n    # Proposal, not yet ruled on (issue #54): a gate that retires nothing\n    # only adds, so proof one reports it here rather than waiting on the\n    # schema alone -- read_manifest never validates against the manifest\n    # schema at runtime, so a schema requirement is not an enforced one.\n    no_retires = [name for name, gate in sorted(gates.items()) if not gate.get(\"retires\")]\n    missing, accepted = [], []\n    for name, gate in sorted(gates.items()):\n        fixture = fixtures / name\n        if not fixture.is_dir():\n            missing.append(name)\n            continue\n        env = dict(os.environ)\n        item = fixture_item_id(fixture)\n        if item is not None:\n            env[\"ATTAVO_ITEM\"] = item\n        run = subprocess.run(gate[\"command\"], shell=True, cwd=str(fixture),\n                             capture_output=True, text=True, check=False, env=env)\n        if run.returncode == 0:\n            accepted.append(name)\n    if missing:\n        return p.fail(f\"gate(s) with no rejection fixture: {', '.join(missing)}\")\n    if accepted:\n        return p.fail(f\"gate(s) that accepted their rejection fixture: {', '.join(accepted)}\")\n    if no_retires:\n        return p.fail(f\"gate(s) with no retires: {', '.join(no_retires)}\")\n    return p.hold(f\"{len(gates)} gate(s) rejected their fixture\")\n\n\ndef _merges_reachable(root: Path) -> tuple[list[dict[str, Any]], str | None]:\n    \"\"\"(merges, refusal): every merge commit on the default branch's own\n    first-parent line -- sha, parents, and its own first-parent diff --\n    read by one process rather than the git log plus one git diff per\n    merge merge_introducing_records used to pay walking toward the one\n    it wants (issue #153). refs/remotes/origin/HEAD names the default\n    branch without hard-coding \"main\", the same primitive\n    diff_since_approval already uses (issue #52); walking from it rather\n    than from HEAD is what keeps a transport merge on an item branch, a\n    pull_request checkout's own synthetic test merge, and a merge_group's\n    temporary merge from ever being mistaken for an item's merge (issue\n    #169) -- none of those is reachable from the default branch's first-\n    parent line by definition. When refs/remotes/origin/HEAD is not set,\n    this refuses by name rather than guess, exactly as diff_since_approval\n    does.\n\n    The walk starts at HEAD itself when the current checkout is literally\n    on the branch refs/remotes/origin/HEAD names (an ordinary checkout of\n    the default branch, on push or on a developer's own machine) and at\n    the remote-tracking ref's own value otherwise (any other branch, or\n    the detached HEAD a pull_request or merge_group checkout leaves\n    behind) -- HEAD only ever *is* the default branch's first-parent line\n    in the former case; in the latter, only the remote-tracking ref names\n    it. --diff-merges=first-parent gives each merge's diff against its\n    first parent in the same pass git log --merges already makes to list\n    them, in the same order, newest first.\"\"\"\n    symref = subprocess.run(\n        [\"git\", \"-C\", str(root), \"symbolic-ref\", \"-q\", \"refs/remotes/origin/HEAD\"],\n        capture_output=True, text=True, check=False)\n    if symref.returncode != 0:\n        return [], \"refs/remotes/origin/HEAD is not set; run `git remote set-head origin -a`\"\n    default_remote_ref = symref.stdout.strip()\n    default_branch = default_remote_ref.rsplit(\"/\", 1)[-1]\n    current_branch = subprocess.run(\n        [\"git\", \"-C\", str(root), \"symbolic-ref\", \"-q\", \"--short\", \"HEAD\"],\n        capture_output=True, text=True, check=False)\n    default_ref = (\"HEAD\" if current_branch.returncode == 0\n                   and current_branch.stdout.strip() == default_branch\n                   else default_remote_ref)\n    try:\n        out = git(root, \"log\", default_ref, \"--first-parent\", \"--merges\",\n                 \"--diff-merges=first-parent\", \"--name-only\",\n                 \"--format=\\x01%H\\x1f%P\")\n    except RuntimeError:\n        return [], None\n    merges = []\n    for block in out.split(\"\\x01\")[1:]:\n        header, _, rest = block.partition(\"\\n\")\n        sha, parents = header.split(\"\\x1f\")\n        merges.append({\"sha\": sha, \"parents\": parents.split(),\n                       \"touched\": [line for line in rest.splitlines() if line.strip()]})\n    return merges, None\n\n\ndef merge_introducing_records(root: Path, records_rel: str, item: str,\n                              stages: tuple[str, ...],\n                              merges: list[dict[str, Any]] | None = None) -> tuple[str | None, str | None]:\n    \"\"\"(merge_sha, refusal): the merge commit on the default branch's own\n    first-parent line whose first-parent diff introduces a record for\n    every one of stages, under records_rel/item/ -- the same derivation\n    attest itself uses (derive_attest_items), read here so proof two\n    requires an item's stage records to have arrived by an actual merge\n    on the default branch, not merely to sit in the tree, and not by a\n    transport merge, a pull_request checkout's synthetic test merge, or a\n    merge_group's temporary merge (issue #69 acceptance row 4; issue\n    #169). merge_sha is None with no refusal when no such merge exists\n    yet -- the item is not merged, not that the walk failed.\n\n    merges, when given, is _merges_reachable's own result -- ledger's\n    cmd_ledger computes it once and passes it to every item rather than\n    walking the default branch's merges again for each (issue #153); a\n    caller that already has merges has also already handled\n    _merges_reachable's refusal, so this never re-derives one. Left\n    None, a caller with just the one item to ask (doctor's proof two)\n    gets merges computed here, refusal and all.\"\"\"\n    if merges is None:\n        merges, refusal = _merges_reachable(root)\n        if refusal:\n            return None, refusal\n    prefix = f\"{records_rel.rstrip('/')}/{item}/\"\n    for merge in merges:\n        found: set[str] = set()\n        for p in merge[\"touched\"]:\n            if p.startswith(prefix):\n                m = RECORD_RE.match(Path(p).name)\n                if m:\n                    found.add(m.group(1))\n        if all(s in found for s in stages):\n            return merge[\"sha\"], None\n    return None, None\n\n\nINVOCATION_MARKER_SUFFIX = \".started\"\n\n\ndef invocation_marker_path(records_dir: Path, stage: str, nn: int) -> Path:\n    return records_dir / f\"{stage}-{nn:02d}{INVOCATION_MARKER_SUFFIX}\"\n\n\ndef write_invocation_marker(root: Path, records_dir: Path, stage: str, nn: int) -> Path:\n    \"\"\"The fact that an invocation began, written before it does: at,\n    host, pid, the sha it starts on, and the product that started it.\n    Its record's arrival is what retires it; a marker with no record is\n    an invocation that died or hangs, and proof five names it.\"\"\"\n    import os\n    import socket\n    from datetime import datetime, timezone\n    records_dir.mkdir(parents=True, exist_ok=True)\n    path = invocation_marker_path(records_dir, stage, nn)\n    sha = git(root, \"rev-parse\", \"HEAD\").strip()\n    info = {\"at\": datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\"),\n            \"host\": socket.gethostname(), \"pid\": os.getpid(), \"sha\": sha,\n            \"product_version\": product_version()}\n    path.write_text(json.dumps(info, indent=2) + \"\\n\")\n    return path\n\n\ndef invocation_alive(info: dict[str, Any]) -> bool:\n    \"\"\"Whether the marker's pid is a live process on this host. Another\n    host's pid is unknowable from here and reads as not alive: a drive\n    that ran elsewhere and wrote no record is died by absence.\"\"\"\n    import os\n    import socket\n    if info.get(\"host\") != socket.gethostname():\n        return False\n    pid = info.get(\"pid\")\n    if not isinstance(pid, int) or isinstance(pid, bool) or pid <= 0:\n        return False\n    try:\n        os.kill(pid, 0)\n    except ProcessLookupError:\n        return False\n    except PermissionError:\n        return True\n    return True\n\n\ndef invocation_age_s(info: dict[str, Any]) -> float | None:\n    \"\"\"Seconds since the marker's own `at` timestamp -- how long ago the\n    invocation it names began, whatever host wrote it. None when `at` is\n    missing or does not parse.\"\"\"\n    from datetime import datetime, timezone\n    at = info.get(\"at\")\n    if not isinstance(at, str):\n        return None\n    try:\n        stamp = datetime.strptime(at, \"%Y-%m-%dT%H:%M:%SZ\").replace(tzinfo=timezone.utc)\n    except ValueError:\n        return None\n    return (datetime.now(timezone.utc) - stamp).total_seconds()\n\n\ndef invocations_without_record(item_records_dir: Path) -> list[tuple[Path, dict[str, Any]]]:\n    \"\"\"Every <stage>-NN.started under one item whose <stage>-NN.json has\n    not arrived, with the marker's own dict ({} when unreadable).\"\"\"\n    out: list[tuple[Path, dict[str, Any]]] = []\n    if not item_records_dir.is_dir():\n        return out\n    for marker in sorted(item_records_dir.glob(f\"*{INVOCATION_MARKER_SUFFIX}\")):\n        if (item_records_dir / f\"{marker.stem}.json\").is_file():\n            continue\n        try:\n            with marker.open() as fh:\n                info = json.load(fh)\n        except (OSError, ValueError):\n            info = {}\n        out.append((marker, info if isinstance(info, dict) else {}))\n    return out\n\n\ndef stall_bound_s(m: dict[str, Any]) -> int | None:\n    \"\"\"[drive].stall_after_s: the tenant's own bound past which a live\n    invocation with no new event is hung. A bound the tenant did not\n    write is a forecast, so there is no default.\"\"\"\n    bound = (m.get(\"drive\") or {}).get(\"stall_after_s\")\n    if isinstance(bound, bool) or not isinstance(bound, (int, float)) or bound <= 0:\n        return None\n    return int(bound)\n\n\ndef proof_no_invocation_lacks_record(root: Path, m: dict[str, Any] | None) -> Proof:\n    import socket\n    p = Proof(\"no-invocation-lacks-record\", \"no invocation lacks its record\")\n    if m is None:\n        return p.fail(f\"no {MANIFEST} at {root}; no records directory is declared\")\n    records_rel = m.get(\"paths\", {}).get(\"records\", \"\")\n    records_dir = root / records_rel\n    if not records_dir.is_dir():\n        return p.fail(f\"no records directory under {records_dir}\")\n    bound = stall_bound_s(m)\n    if bound is None:\n        return p.fail(\"no [drive].stall_after_s in the manifest; a hung invocation cannot be \"\n                      \"told from a running one\")\n    this_host = socket.gethostname()\n    recorded = 0\n    running: list[str] = []\n    in_flight: list[str] = []\n    problems: list[str] = []\n    for item_dir in sorted(d for d in records_dir.iterdir() if d.is_dir()):\n        for marker in item_dir.glob(f\"*{INVOCATION_MARKER_SUFFIX}\"):\n            if (item_dir / f\"{marker.stem}.json\").is_file():\n                recorded += 1\n        for marker, info in invocations_without_record(item_dir):\n            name = f\"item {item_dir.name} {marker.stem}\"\n            if invocation_alive(info):\n                running.append(f\"{name} (pid {info.get('pid')} since {info.get('at')})\")\n                continue\n            # A marker from another host is not alive by invocation_alive's\n            # own reckoning (its pid is unknowable from here) but is not\n            # yet a failure either: an invocation younger than the tenant's\n            # own stall bound may simply be running elsewhere, still\n            # writing toward its own record.\n            if info.get(\"host\") != this_host:\n                age = invocation_age_s(info)\n                if age is not None and age < bound:\n                    in_flight.append(f\"{name} (host {info.get('host')} since {info.get('at')})\")\n                    continue\n            problems.append(f\"{name} started {info.get('at')} on {info.get('host')} \"\n                            f\"pid {info.get('pid')} and never wrote its record\")\n    if problems:\n        return p.fail(\"; \".join(problems), unrecorded_invocations=len(problems),\n                      running_invocations=running, in_flight=in_flight)\n    return p.hold(f\"{recorded} invocation(s) recorded, {len(running)} running, \"\n                  f\"{len(in_flight)} in flight elsewhere\",\n                  unrecorded_invocations=0, running_invocations=running, in_flight=in_flight)\n\n\ndef proof_one_item_every_stage(root: Path, m: dict[str, Any] | None) -> Proof:\n    p = Proof(\"one-item-every-stage\", \"one item has traversed every stage\")\n    if m is None:\n        return p.fail(f\"no {MANIFEST} at {root}; no records directory is declared\")\n    records_rel = m.get(\"paths\", {}).get(\"records\", \"\")\n    records_dir = root / records_rel\n    items = load_records(records_dir)\n    if not items:\n        return p.fail(f\"no work item under {records_dir.relative_to(root)}\")\n    complete = [item for item, stages in items.items() if all(s in stages for s in STAGES)]\n    if not complete:\n        best = max(items.items(), key=lambda kv: len(kv[1]))\n        lacking = [s for s in STAGES if s not in best[1]]\n        return p.fail(f\"no item carries every stage; item {best[0]} lacks {', '.join(lacking)}\")\n\n    # issue #74: a complete item is counted only when its chain holds --\n    # attavo attest refuses a build re-approved after the fact or a\n    # verify whose build went stale, and the coherence gate refuses the\n    # merge group on exactly that; a proof that never asked would call a\n    # traversal the gate itself would not let through. The refusal text\n    # is check_attest_chain's own, never re-typed here.\n    refused, held, unmerged = [], [], []\n    for item in complete:\n        chain, message = check_attest_chain(records_dir / item, item)\n        if chain is None:\n            refused.append(f\"item {item}: {message}\")\n            continue\n        merge_sha, merge_refusal = merge_introducing_records(root, records_rel, item, STAGES)\n        if merge_refusal:\n            return p.fail(merge_refusal)\n        if merge_sha:\n            held.append((item, merge_sha))\n        else:\n            unmerged.append(item)\n\n    if held:\n        names = \", \".join(item for item, _ in held)\n        shas = \", \".join(sha[:12] for _, sha in held)\n        return p.hold(f\"item(s) {names} carry {', '.join(STAGES)} with the chain held, \"\n                      f\"merged at {shas}\")\n    if refused:\n        return p.fail(\"; \".join(refused))\n    return p.fail(f\"item(s) {', '.join(unmerged)} carry every stage with the chain held but no \"\n                  f\"merge commit's first-parent diff introduces all of them\")\n\n\ndef commit_subject(root: Path, sha: str) -> str:\n    return git(root, \"log\", \"-1\", \"--format=%s\", sha).strip()\n\n\ndef touches_boundary(root: Path, sha: str, boundary_paths: list[str]) -> bool:\n    \"\"\"Whether sha's first-parent diff touches a path [spec.boundary].paths\n    declares governed -- an ordinary merge that does is a boundary\n    evasion (issue #72): the tenant carried a governed change around the\n    path the manifest itself names.\"\"\"\n    diff = git(root, \"diff\", \"--name-only\", f\"{sha}^1\", sha).splitlines()\n    return any(fnmatch.fnmatch(path, pattern) for path in diff for pattern in boundary_paths)\n\n\nclass WindowRefused(Exception):\n    \"\"\"The window start cannot be computed; str(exc) is the refusal.\"\"\"\n\n\ndef proof_window_start(root: Path, m: dict[str, Any]) -> tuple[str, str, list[str]]:\n    \"\"\"(install commit, window start, first-parent chain after the install\n    commit): where proofs three and six start reading. The start is\n    [doctor].from if the tenant set it, otherwise the commit that\n    introduced the manifest (issue #192: proof six reads this too, so the\n    two proofs cannot disagree).\"\"\"\n    try:\n        install = git(root, \"log\", \"--diff-filter=A\", \"--format=%H\",\n                      \"--reverse\", \"--\", MANIFEST).split()\n    except RuntimeError as exc:\n        raise WindowRefused(f\"git: {exc}\") from exc\n    if not install:\n        raise WindowRefused(f\"{MANIFEST} is not committed; the tenant has no record boundary\")\n    install_sha = install[0]\n    full_chain = git(root, \"rev-list\", f\"{install_sha}..HEAD\", \"--first-parent\").split()\n\n    # issue #74: [doctor] from lets a tenant declare the doctor's read to\n    # start at a later commit on main's first-parent line -- the point\n    # after which every push arrived through the queue -- rather than the\n    # install commit, which on a repository that adopted the product\n    # after its history began is a boundary the doctor cannot otherwise\n    # see. Any spelling git resolves is accepted (a short sha, a tag, a\n    # ref) -- resolved with rev-parse --verify before the first-parent\n    # check runs, so the two failure modes stay distinct: a spelling that\n    # names no commit at all, and a commit that names one off the line.\n    # Checked, not trusted: neither is silently forgiven back to install.\n    declared_from = (m.get(\"doctor\") or {}).get(\"from\")\n    window_start = install_sha\n    if declared_from is not None:\n        try:\n            resolved_from = git(root, \"rev-parse\", \"--verify\", f\"{declared_from}^{{commit}}\").strip()\n        except RuntimeError:\n            raise WindowRefused(f\"[doctor] from {declared_from} does not resolve to a commit\") from None\n        if resolved_from != install_sha and resolved_from not in full_chain:\n            raise WindowRefused(f\"[doctor] from {declared_from} is not on main's first-parent \"\n                                f\"line after the install commit {install_sha[:12]}\")\n        window_start = resolved_from\n    return install_sha, window_start, full_chain\n\n\ndef proof_no_commit_lacks_record(root: Path, m: dict[str, Any] | None) -> Proof:\n    p = Proof(\"no-commit-lacks-record\", \"no commit lacks a record\")\n    if m is None:\n        return p.fail(f\"no {MANIFEST} at {root}; the tenant has no record boundary\")\n    try:\n        install_sha, window_start, full_chain = proof_window_start(root, m)\n    except WindowRefused as exc:\n        return p.fail(str(exc))\n    if not full_chain:\n        return p.fail(f\"no commit after the install commit {install_sha[:12]}; nothing has been recorded\")\n\n    if window_start == install_sha:\n        window_spec = f\"{install_sha}..HEAD\"\n        commits = full_chain\n    else:\n        window_spec = f\"{window_start}^..HEAD\"\n        commits = git(root, \"rev-list\", window_spec, \"--first-parent\").split()\n    before_window = len(full_chain) - len(commits)\n\n    records_rel = m.get(\"paths\", {}).get(\"records\", \"\")\n    records_dir = root / records_rel\n    named: set[str] = set()\n    for stages in load_records(records_dir).values():\n        for rec in stages.values():\n            sha = rec.get(\"sha\")\n            if isinstance(sha, str):\n                named.add(sha)\n            for c in rec.get(\"commits\", []) or []:\n                if isinstance(c, str):\n                    named.add(c)\n    record_commits = set(git(root, \"rev-list\", window_spec, \"--first-parent\",\n                             \"--\", records_rel).split()) if records_rel else set()\n    merges = set(git(root, \"rev-list\", window_spec, \"--first-parent\", \"--merges\").split())\n    boundary_paths = ((m.get(\"spec\") or {}).get(\"boundary\") or {}).get(\"paths\") or []\n\n    # Every first-parent commit in the window is exactly one of three\n    # (issue #72): recorded (a record names it, or its diff touches\n    # paths.records), ordinary (a merge that doesn't), or unrecorded\n    # (anything else -- on a protected main with a queue, a non-merge\n    # commit is the only way a change arrives without the forge).\n    recorded, ordinary, unrecorded = [], [], []\n    ordinary_commits, unrecorded_commits = [], []\n    boundary_evasions = 0\n    for c in commits:\n        if c in named or c in record_commits:\n            recorded.append(c)\n        elif c in merges:\n            ordinary.append(c)\n            evasion = bool(boundary_paths and touches_boundary(root, c, boundary_paths))\n            if evasion:\n                boundary_evasions += 1\n            ordinary_commits.append({\"sha\": c, \"subject\": commit_subject(root, c),\n                                     \"boundary_evasion\": evasion})\n        else:\n            unrecorded.append(c)\n            unrecorded_commits.append({\"sha\": c, \"subject\": commit_subject(root, c)})\n\n    counts = f\"{len(recorded)} recorded, {len(ordinary)} ordinary, {len(unrecorded)} unrecorded\"\n    evasions = boundary_evasions if boundary_paths else \"n/a\"\n    extra = {\"recorded\": len(recorded), \"ordinary\": len(ordinary),\n             \"unrecorded\": len(unrecorded), \"boundary_evasions\": evasions,\n             \"before_window\": before_window,\n             \"ordinary_commits\": ordinary_commits, \"unrecorded_commits\": unrecorded_commits}\n    if unrecorded:\n        return p.fail(f\"{unrecorded[-1][:12]} lacks a record; {counts}; boundary evasions: \"\n                      f\"{evasions}; before the window: {before_window}\", **extra)\n    return p.hold(f\"{counts}; boundary evasions: {evasions}; before the window: {before_window}\",\n                  **extra)\n\n\nADAPTER_EXIT_RE = re.compile(r\"^\\[adapter exited \\d+\\]$\")\n\n_JSON_LINE_PARSE_FAILED = object()\n\n\ndef _parse_json_line(text: str) -> Any:\n    \"\"\"A line's own parsed JSON value, or the sentinel\n    _JSON_LINE_PARSE_FAILED when it does not parse -- the one call site\n    in this file for a defensive, line-at-a-time JSON parse, shared by\n    proof four's own tool-error check below (any valid JSON satisfies\n    it) and an events line's own `at` read (issue #151, which further\n    requires a dict). A dedicated sentinel, not None: a line that is\n    the literal JSON value null parses successfully and must read as\n    such, not as a failure.\"\"\"\n    try:\n        return json.loads(text)\n    except ValueError:\n        return _JSON_LINE_PARSE_FAILED\n\n\ndef _log_owes_tool_error(log: str | None) -> bool:\n    \"\"\"True when a log's last non-empty line is exactly an adapter-exit\n    marker and every line before it parses as JSON -- an adapter's own\n    event stream, never a tool's own words (issue #94's own specimen,\n    tenant zero's attest/records/659/verify-01.log: codex's\n    \"thread.started\" event, then nothing but \"[adapter exited 1]\" -- the\n    tool's real error line dropped before this reached the log, issue\n    #86's own bug in split_adapter_stdout). A log that is only the exit\n    marker, nothing before it at all, still owes the same line. An\n    `error` event with a non-empty string `message` is the tool's own\n    error delivered as an event (issue #200: \"Selected model is at\n    capacity\"), so it owes nothing.\"\"\"\n    if not log:\n        return False\n    lines = [l for l in log.splitlines() if l.strip()]\n    if not lines or not ADAPTER_EXIT_RE.match(lines[-1]):\n        return False\n    for l in lines[:-1]:\n        parsed = _parse_json_line(l)\n        if parsed is _JSON_LINE_PARSE_FAILED:\n            return False\n        if isinstance(parsed, dict) and parsed.get(\"type\") == \"error\":\n            message = parsed.get(\"message\")\n            if isinstance(message, str) and message:\n                return False\n    return True\n\n\ndef proof_no_stop_lacks_cause(root: Path, m: dict[str, Any] | None) -> Proof:\n    p = Proof(\"no-stop-lacks-cause\", \"no stop lacks its cause\")\n    if m is None:\n        return p.fail(f\"no {MANIFEST} at {root}; no records directory is declared\")\n    records_rel = m.get(\"paths\", {}).get(\"records\", \"\")\n    records_dir = root / records_rel\n    if not records_dir.is_dir():\n        return p.fail(f\"no records directory under {records_dir}\")\n\n    # issue #89's own window lesson, proof three's already: a record\n    # before record_version 3 has no stop by construction (schema\n    # versions 1 and 2 predate it) -- counted here, never refused.\n    older = 0\n    checked = 0\n    problems: list[str] = []\n    for item_dir in sorted(d for d in records_dir.iterdir() if d.is_dir()):\n        for stage in STOP_STAGES:\n            for n, rec in sorted(parse_attempts(item_dir, stage).items()):\n                if rec.get(\"record_version\", 1) < 3:\n                    older += 1\n                    continue\n                if rec.get(\"status\") == \"pass\":\n                    continue\n                checked += 1\n                name = f\"{stage}-{n:02d}\"\n                stop = rec.get(\"stop\")\n                if not stop:\n                    problems.append(f\"item {item_dir.name} {name} carries no stop\")\n                    continue\n                cls, provenance = stop.get(\"class\"), stop.get(\"provenance\")\n                if cls not in STOP_CLASSES:\n                    problems.append(f\"item {item_dir.name} {name} stop.class {cls!r} names \"\n                                    f\"no enumerated class\")\n                    continue\n                if provenance not in STOP_PROVENANCES:\n                    problems.append(f\"item {item_dir.name} {name} stop.provenance \"\n                                    f\"{provenance!r} names no enumerated provenance\")\n                    continue\n                if cls == \"unclassed\" and not stop.get(\"detail\"):\n                    problems.append(f\"item {item_dir.name} {name} is unclassed with no detail\")\n                    continue\n                log_path = item_dir / f\"{name}.log\"\n                log = log_path.read_text() if log_path.is_file() else None\n                # Issue #89, rejection test 1's own specimen (tenant\n                # zero's #659 build-01): a failed build that actually ran\n                # the gates -- selected_tests is set only once cmd_build\n                # reaches them -- owes their heading in the log, whatever\n                # else stop already says.\n                if (stage == \"build\" and rec.get(\"status\") == \"failed\"\n                        and rec.get(\"selected_tests\") is not None\n                        and \"--- attavo gates, iteration\" not in (log or \"\")):\n                    problems.append(f\"item {item_dir.name} {name} failed after the gates ran \"\n                                    f\"but its log carries no gates heading\")\n                    continue\n                if _log_owes_tool_error(log):\n                    problems.append(f\"item {item_dir.name} {name}'s log ends in an adapter \"\n                                    f\"exit with nothing before it but event lines; the tool's \"\n                                    f\"own error line is owed\")\n\n        # issue #137: a refused spec-gate record is a stop too, class\n        # \"gate\" -- synthesized the same way item_stops and\n        # cmd_file_stops already read it, since cmd_spec_gate itself\n        # carries no stop field to check for one. No record_version\n        # gate here: unlike build/verify's own stop field, gate is never\n        # persisted, so there is no older shape that predates it.\n        for n, rec in sorted(parse_attempts(item_dir, \"spec\").items()):\n            if rec.get(\"status\") != \"refused\":\n                continue\n            checked += 1\n            name = f\"spec-{n:02d}\"\n            stop = gate_stop(rec.get(\"refusal\"))\n            cls, provenance = stop[\"class\"], stop[\"provenance\"]\n            if cls not in STOP_CLASSES:\n                problems.append(f\"item {item_dir.name} {name} stop.class {cls!r} names \"\n                                f\"no enumerated class\")\n                continue\n            if provenance not in STOP_PROVENANCES:\n                problems.append(f\"item {item_dir.name} {name} stop.provenance \"\n                                f\"{provenance!r} names no enumerated provenance\")\n                continue\n            if not stop.get(\"detail\"):\n                problems.append(f\"item {item_dir.name} {name} is a gate stop with no cause\")\n\n    older_note = f\"{older} record(s) before stop was recorded\"\n    if problems:\n        return p.fail(\"; \".join(problems), older_records=older)\n    return p.hold(f\"{checked} checked ({older_note})\" if checked == 0\n                 else f\"{checked} non-pass record(s) carry stop with a cause ({older_note})\",\n                 older_records=older)\n\n\ndef attestation_command(m: dict[str, Any]) -> str | None:\n    \"\"\"[forge].attestation_command: the tenant's own read of the store,\n    given a merge sha on stdin, printing the statement as JSON on exit 0\n    and nothing on a non-zero exit. Absent is not passing (issue #158:\n    the doctor said done while #106, #148, #153 had no statement in the\n    store at all -- there was no key to read one through).\"\"\"\n    cmd = (m.get(\"forge\") or {}).get(\"attestation_command\")\n    return cmd if isinstance(cmd, str) and cmd.strip() else None\n\n\ndef statement_for(root: Path, cmd: str, merge_sha: str) -> tuple[dict[str, Any] | None, int]:\n    \"\"\"The statement the forge holds for merge_sha and the command's exit\n    code. The statement is None when the command exits non-zero or prints\n    anything but a JSON object -- exit 2 means the store itself could not\n    be read (issue #158, amended after build-05: distinct from exit 1,\n    the store read fine and simply held no statement).\"\"\"\n    run = subprocess.run(cmd, shell=True, cwd=str(root), input=merge_sha + \"\\n\",\n                         capture_output=True, text=True, check=False)\n    if run.returncode != 0:\n        return None, run.returncode\n    try:\n        parsed = json.loads(run.stdout)\n    except ValueError:\n        return None, run.returncode\n    return (parsed if isinstance(parsed, dict) else None), run.returncode\n\n\ndef _is_ancestor(root: Path, earlier: str, later: str) -> bool:\n    run = subprocess.run([\"git\", \"-C\", str(root), \"merge-base\", \"--is-ancestor\", earlier, later],\n                         capture_output=True, check=False)\n    return run.returncode == 0\n\n\n# Maps whose keys are the records' data (a stage or an adapter that cost\n# something), not a release's fields: a key missing from one is a difference.\nDATA_KEYED = (\"by_stage_usd\", \"by_adapter_usd\")\n\n\ndef _same(stated: Any, summed: Any) -> bool:\n    \"\"\"Equal as the accounting means it: a number equals a number of the\n    same value (a store may print 40.0 as 40), a bool equals only a bool,\n    and a list is equal member by member. No tolerance and no conversion:\n    both sides are the same function's rounding of the same records, and an\n    int one past 2**53 is not the float beside it.\"\"\"\n    if isinstance(stated, bool) or isinstance(summed, bool):\n        return isinstance(stated, bool) and isinstance(summed, bool) and stated == summed\n    if isinstance(stated, (int, float)) and isinstance(summed, (int, float)):\n        return bool(stated == summed)\n    if isinstance(stated, list) and isinstance(summed, list):\n        return len(stated) == len(summed) and all(_same(a, b) for a, b in zip(stated, summed))\n    return type(stated) is type(summed) and bool(stated == summed)\n\n\ndef _differences(path: str, stated: Any, summed: Any, keyed_by_data: bool = False) -> list[str]:\n    \"\"\"Every field of `stated` that is not what its records sum to, named by\n    its path. Only the keys the statement carries are compared, at every\n    depth, so a field a later release adds is not demanded of a statement\n    sealed before it; a key it carries that the function does not produce\n    is a difference.\"\"\"\n    if not (isinstance(stated, dict) and isinstance(summed, dict)):\n        return [] if _same(stated, summed) else [f\"{path} {stated!r} is not its records' {summed!r}\"]\n    found: list[str] = []\n    for key in sorted(stated):\n        if key not in summed:\n            found.append(f\"{path}.{key} {stated[key]!r} is not a field its records sum to\")\n        else:\n            found += _differences(f\"{path}.{key}\", stated[key], summed[key], key in DATA_KEYED)\n    if keyed_by_data:\n        found += [f\"{path}.{key} is absent; its records sum to {summed[key]!r}\"\n                  for key in sorted(summed.keys() - stated.keys())]\n    return found\n\n\ndef _carried(predicate: dict[str, Any], key: str) -> str:\n    return repr(predicate[key]) if key in predicate else \"absent\"\n\n\ndef _accounting_disagrees(root: Path, item_records_dir: Path, item: str, merge_sha: str,\n                          statement: dict[str, Any]) -> str | None:\n    \"\"\"A sealed statement that carries `time` and `cost` says what its\n    records sum to, field by field -- the same function attest summed them\n    with, over the same records (none is written after a merge), sealed at\n    the same commit (the statement is computed at the merge, so lead_s and\n    waiting_s are recomputed from its committer time, not excepted). Exact:\n    #202 retired the one-second tolerance. A statement sealed before `time`\n    existed carries neither key and is not checked; a key that is present\n    holds a block, so a null one, or one block without the other, is a\n    disagreement. No new read of the store.\"\"\"\n    inner = statement.get(\"predicate\")\n    predicate = inner if isinstance(inner, dict) else statement\n    if \"time\" not in predicate and \"cost\" not in predicate:\n        return None\n    stated_time, stated_cost = predicate.get(\"time\"), predicate.get(\"cost\")\n    where = f\"item {item} merged at {merge_sha[:12]}\"\n    if not isinstance(stated_time, dict) or not isinstance(stated_cost, dict):\n        return (f\"{where}: the statement's time and cost are not both blocks \"\n                f\"(time is {_carried(predicate, 'time')}, cost is {_carried(predicate, 'cost')})\")\n    try:\n        sealed_at: int | None = int(git(root, \"show\", \"-s\", \"--format=%ct\", merge_sha).strip())\n    except (RuntimeError, ValueError):\n        sealed_at = None\n    summed_time, summed_cost = item_time_and_cost(item_records_dir, sealed_at)\n    differing = (_differences(\"time\", stated_time, dict(summed_time))\n                 + _differences(\"cost\", stated_cost, dict(summed_cost)))\n    if differing:\n        return f\"{where}: the statement's \" + \"; \".join(differing)\n    return None\n\n\ndef proof_every_attested_item_is_sealed(root: Path, m: dict[str, Any] | None) -> Proof:\n    p = Proof(\"every-attested-item-is-sealed\", \"every attested item has its statement in the store\")\n    if m is None:\n        return p.fail(f\"no {MANIFEST} at {root}; no records directory is declared\")\n    cmd = attestation_command(m)\n    if cmd is None:\n        return p.fail(\"no [forge].attestation_command in the manifest; the store cannot be read\")\n    records_rel = m.get(\"paths\", {}).get(\"records\", \"\")\n    records_dir = root / records_rel\n    if not records_dir.is_dir():\n        return p.fail(f\"no records directory under {records_dir}\")\n    items = load_records(records_dir)\n    complete = [item for item, stages in sorted(items.items()) if all(s in stages for s in STAGES)]\n\n    # [forge].sealed_since: merges at or before this commit are before the\n    # window -- the tenant could not seal them (no queue, no signing\n    # workflow, or a store that held nothing yet). They are named, never\n    # failed. Absent, the window starts where proof three's does: the\n    # install commit, or [doctor].from (issue #192).\n    since = (m.get(\"forge\") or {}).get(\"sealed_since\")\n    if not (isinstance(since, str) and since.strip()):\n        try:\n            since = proof_window_start(root, m)[1]\n        except WindowRefused as exc:\n            return p.fail(str(exc))\n    merges, refusal = _merges_reachable(root)\n    if refusal:\n        return p.fail(refusal)\n    sealed: list[str] = []\n    before_window: list[str] = []\n    unsealed: list[str] = []\n    not_merged: list[str] = []\n    not_read: list[str] = []\n    reasons: list[str] = []\n    for item in complete:\n        merge_sha, _ = merge_introducing_records(root, records_rel, item, STAGES, merges=merges)\n        if merge_sha is None:\n            not_merged.append(item)\n            continue\n        if _is_ancestor(root, merge_sha, since):\n            before_window.append(item)\n            continue\n        statement, exit_code = statement_for(root, cmd, merge_sha)\n        if statement is not None:\n            sealed.append(item)\n            disagreement = _accounting_disagrees(root, records_dir / item, item, merge_sha,\n                                                 statement)\n            if disagreement:\n                reasons.append(disagreement)\n        elif exit_code == 2:\n            not_read.append(item)\n            reasons.append(f\"item {item} merged at {merge_sha[:12]}: not read -- \"\n                           f\"the store could not be read; {cmd!r} exited 2\")\n        else:\n            unsealed.append(item)\n            reasons.append(f\"item {item} merged at {merge_sha[:12]} has no statement in the store\")\n    if reasons:\n        return p.fail(\"; \".join(reasons), sealed=sealed, before_window=before_window,\n                      unsealed=unsealed, not_merged=not_merged, not_read=not_read)\n    window = f\" at {since[:12]}\" if before_window else \"\"\n    return p.hold(f\"{len(sealed)} sealed, {len(before_window)} before the window{window}, \"\n                 f\"{len(not_merged)} not merged\",\n                 sealed=sealed, before_window=before_window, unsealed=unsealed,\n                 not_merged=not_merged, not_read=not_read)\n\n\ndef doctor(root: Path) -> list[Proof]:\n    m = read_manifest(root)\n    return [proof_every_gate_rejects(root, m),\n            proof_one_item_every_stage(root, m),\n            proof_no_commit_lacks_record(root, m),\n            proof_no_stop_lacks_cause(root, m),\n            proof_no_invocation_lacks_record(root, m),\n            proof_every_attested_item_is_sealed(root, m)]\n\n\ndef cmd_doctor(argv: list[str]) -> int:\n    as_json = \"--json\" in argv\n    args = [a for a in argv if a != \"--json\"]\n    root = Path(args[0] if args else \".\").resolve()\n    proofs = doctor(root)\n    if as_json:\n        print(json.dumps({\"root\": str(root), \"done\": all(p.holds for p in proofs),\n                          \"proofs\": [p.as_dict() for p in proofs]}, indent=2))\n    else:\n        for i, p in enumerate(proofs, 1):\n            print(f\"proof {i} {p.key}: {'HOLDS' if p.holds else 'FAILS'}: {p.reason}\")\n        print(\"doctor: done\" if all(p.holds for p in proofs)\n              else f\"doctor: not done ({sum(not p.holds for p in proofs)} of \"\n                   f\"{len(proofs)} proofs fail)\")\n    return 0 if all(p.holds for p in proofs) else 1\n","numLines":801,"startLine":1,"totalLines":801}}}

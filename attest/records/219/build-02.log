ot-pass build record and a returned verify record naming that\n    same build never coexist. (\"\", \"\", \"\") on a first attempt -- nothing\n    to retry, nothing to seed.\"\"\"\n    from attavo.stops import counsel_record_for\n    latest_build = cast(\"dict[str, Any] | None\", latest_record(records_dir, \"build\"))\n    latest_verify = cast(\"dict[str, Any] | None\", latest_record(records_dir, \"verify\"))\n    prior_stem = f\"build-{next_attempt_number(records_dir, 'build') - 1:02d}\"\n    prior: dict[str, Any] | None = None\n    prior_verify_stem: str | None = None\n    if (latest_verify and (latest_verify.get(\"stop\") or {}).get(\"class\") == \"returned\"\n            and latest_build and latest_verify.get(\"build_sha\") == latest_build.get(\"sha\")):\n        prior = latest_verify\n        verify_attempts = parse_attempts(records_dir, \"verify\")\n        prior_verify_stem = f\"verify-{max(verify_attempts):02d}\" if verify_attempts else None\n    elif latest_build and latest_build.get(\"status\") != \"pass\":\n        prior = latest_build\n    if prior is None:\n        return None, None, \"\"\n\n    stop: dict[str, Any] = prior.get(\"stop\") or {}\n    lines = [f\"attempt {prior_verify_stem or prior_stem} stopped as {stop.get('class')}: \"\n            f\"{stop.get('detail') or ''}\",\n            f\"signature: {stop.get('signature') or ''}\", \"\"]\n\n    forge = m.get(\"forge\") or {}\n    if stop.get(\"class\") == \"returned\":\n        findings = prior.get(\"findings\")\n        if findings:\n            lines.append(\"blocking findings:\")\n            for finding in findings:\n                if str(finding.get(\"severity\")) != \"blocking\":\n                    continue\n                lines.append(f\"- {finding.get('title')}: {finding.get('specimen')} \"\n                             f\"(retires: {finding.get('retires')})\")\n            lines.append(\"\")\n        elif forge.get(\"check_log_command\"):\n            for c in (prior.get(\"forge_checks\") or {}).get(\"conclusions\") or []:\n                if c.get(\"conclusion\") in (\"success\", \"neutral\", \"skipped\"):\n                    continue\n                run = subprocess.run(\n                    f\"{forge['check_log_command']} {shlex.quote(str(prior.get('sha')))} \"\n                    f\"{shlex.quote(c['name'])}\", shell=True, cwd=str(root),\n                    capture_output=True, text=True, check=False)\n                lines += [f\"--- check {c['name']} {c['conclusion']} ---\",\n                         run.stdout.strip(), \"\"]\n\n    steer_stem: str | None = None\n    counsel = counsel_record_for(records_dir, \"build\" if prior_verify_stem is None else \"verify\",\n                                 int((prior_verify_stem or prior_stem).rsplit(\"-\", 1)[1]))\n    if counsel is not None and counsel.get(\"verdict\") == \"answer\":\n        counsel_attempts = parse_attempts(records_dir, \"counsel\")\n        nn = max((n for n, rec in counsel_attempts.items() if rec is counsel), default=None)\n        if nn is not None:\n            steer_stem = f\"counsel-{nn:02d}\"\n            answer = (counsel.get(\"proposal\") or {}).get(\"ruling_text\")\n            if answer:\n                lines += [f\"steer from {steer_stem}:\", answer.strip(), \"\"]\n\n    retry_of = prior_verify_stem if prior_verify_stem is not None else prior_stem\n    return retry_of, steer_stem, \"\\n\".join(lines) + \"\\n\""},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":2130,"cache_read_input_tokens":319234,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":2130},"output_tokens":15,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"ae622d81-efb9-4dda-92a0-5ebf75b0d73f","uuid":"757fdd2e-ebe3-4fdf-a3b2-a1f5d7248234","t
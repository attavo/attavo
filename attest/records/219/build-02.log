stem.rsplit('-', 1)[1]} stopped {how}\"","+    if state.waiting_s is not None:","+        r[\"kind\"] = \"waits\"","+        says = (f\"{_WORD[stage].capitalize()} attempt {attempt:02d} stopped {how}; retrying \"","+                f\"{_WORD[stage]} in {int(state.waiting_s)} s\")","+    elif state.eligible:","+        r[\"kind\"] = \"acts\"","+        says = f\"{_WORD[stage].capitalize()} attempt {attempt:02d} stopped {how}; the next pass retries it\"","+    else:","+        says = f\"Needs you: {_WORD[stage]} attempt {attempt:02d} stopped {how}\"","     counsel = _counsel_of(records_dir, stem)","     if counsel:","         r[\"counsel\"] = counsel[0]","-        verdict = _COUNSEL_SAYS.get(str(counsel[1].get(\"verdict\")))","-        says += f\"; {counsel[0]} {verdict or 'could not read it'}\"","-    if r[\"filed\"]:","+        verdict = str(counsel[1].get(\"verdict\"))","+        verdict_says = _COUNSEL_SAYS.get(verdict)","+        says += f\"; {counsel[0]} {verdict_says or 'could not read it'}\"","+        if verdict == \"patch\" and r[\"filed\"]:","+            says += f\"; waiting on {r['filed']}\"","+    if r[\"filed\"] and \"waiting on\" not in says:","         says += f\"; filed as {r['filed']}\"","     r[\"says\"] = says","     return r"]}],"userModified":false,"replaceAll":false}}

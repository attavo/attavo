y <stage>-NN.started under one item whose <stage>-NN.json has\\n222\\t    not arrived, with the marker's own dict ({} when unreadable).\\\"\\\"\\\"\\n223\\t    out: list[tuple[Path, dict[str, Any]]] = []\\n224\\t    if not item_records_dir.is_dir():\\n225\\t        return out\\n226\\t    for marker in sorted(item_records_dir.glob(f\\\"*{INVOCATION_MARKER_SUFFIX}\\\")):\\n227\\t        if (item_records_dir / f\\\"{marker.stem}.json\\\").is_file():\\n228\\t            continue\\n229\\t        try:\\n230\\t            with marker.open() as fh:\\n231\\t                info = json.load(fh)\\n232\\t        except (OSError, ValueError):\\n233\\t            info = {}\\n234\\t        out.append((marker, info if isinstance(info, dict) else {}))\\n235\\t    return out\\n236\\t\\n237\\t\\n238\\tdef stall_bound_s(m: dict[str, Any]) -> int | None:\\n239\\t    \\\"\\\"\\\"[drive].stall_after_s: the tenant's own bound past which a live\\n240\\t    invocation with no new event is hung. A bound the tenant did not\\n241\\t    write is a forecast, so there is no default.\\\"\\\"\\\"\\n242\\t    bound = (m.get(\\\"drive\\\") or {}).get(\\\"stall_after_s\\\")\\n243\\t    if isinstance(bound, bool) or not isinstance(bound, (int, float)) or bound <= 0:\\n244\\t        return None\\n245\\t    return int(bound)\\n246\\t\\n247\\t\\n248\\tdef ceiling_s(m: dict[str, Any], stage: str) -> int | None:\\n249\\t    \\\"\\\"\\\"R3: [drive.<stage>].ceiling_s, the wall clock past which a live\\n250\\t    invocation of that stage is hung by its ceiling, whatever event age\\n251\\t    says (or does not say, for an adapter that streams none). No\\n252\\t    default: a ceiling the tenant did not declare is not assumed.\\\"\\\"\\\"\\n253\\t    value = ((m.get(\\\"drive\\\") or {}).get(stage) or {}).get(\\\"ceiling_s\\\")\\n254\\t    if isinstance(value, bool) or not isinstance(value, (int, float)) or value <= 0:\\n255\\t        return None\\n256\\t    return int(value)\\n257\\t\\n258\\t\\n259\\tdef attempts_budget(m: dict[str, Any]) -> int:\\n260\\t    \\\"\\\"\\\"R3: [drive].attempts, the attempts a stage may spend -- across a\\n261\\t    plain retry, a returned retry, and a steered one alike -- before the\\n262\\t    item is a person's; 3 when the manifest does not say.\\\"\\\"\\\"\\n263\\t    value = (m.get(\\\"drive\\\") or {}).get(\\\"attempts\\\")\\n264\\t    if isinstance(value, bool) or not isinstance(value, int) or value < 1:\\n265\\t        return 3\\n266\\t    return value\\n267\\t\\n268\\t\\n269\\tdef retry_after_s(m: dict[str, Any]) -> int:\\n270\\t    \\\"\\\"\\\"R3: [drive].retry_after_s, the wait a transient stop's record sits\\n271\\t    through before its next attempt starts; 300 when the manifest does\\n272\\t    not say.\\\"\\\"\\\"\\n273\\t    value = (m.get(\\\"drive\\\") or {}).get(\\\"retry_after_s\\\")\\n274\\t    if isinstance(value, bool) or not isinstance(value, (int, float)) or value < 0:\\n275\\t        return 300\\n276\\t    return int(value)\\n277\\t\\n278\\t\\n279\\tdef proof_no_invocation_lacks_record(root: Path, m: dict[str, Any] | None) -> Proof:\\n280\\t    import socket\\n281\\t    p = Proof(\\\"no-invocation-lacks-record\\\", \\\"no invocation lacks its record\\\")\\n282\\t    if m is None:\\n283\\t        return p.fail(f\\\"no {MANIFEST} at {root}; no records directory is declared\\\")\\n284\\t    records_rel = m.get(\\\"paths\\\", {}).get(\\\"records\\\", \\\"\\\")\\n285\\t    records_dir = root / records_rel\\n286\\t    if not records_dir.is_dir():\\n287\\t        return p.fail(f\\\"no records directory under {records_dir}\\\")\\n288\\t    bound = stall_bound_s(m)\\n289\\t    if bound is None:\\n290\\t        return p.fail(\\\"no [drive].stall_after_s in the manifest; a hung invocation cannot be \\\"\\n291\\t                      \\\"told from a running one\\\")\\n292\\t    # R3: a stage with no ceiling can run forever unjudged even when\\n293\\t    # stall_after_s is set (an adapter that streams no events trips no\\n294\\t   
ld}}\\\" = build ]; then sleep {seconds}; fi\\\\n'\\n47\\t                   f'exec sh {ROOT / \\\"adapters\\\" / \\\"fixture\\\" / \\\"run\\\"}\\\\n')\\n48\\t    run.chmod(0o755)\\n49\\t    commit_all(root, \\\"a slow tenant-side adapter\\\")\\n50\\t\\n51\\t\\n52\\tdef git_dir(root: Path) -> Path:\\n53\\t    return Path(git(root, \\\"rev-parse\\\", \\\"--absolute-git-dir\\\").strip())\\n54\\t\\n55\\t\\n56\\tdef report(root: Path) -> dict[str, Any]:\\n57\\t    run = run_attavo(root, \\\"drive\\\", \\\"1\\\", \\\"--report\\\", env=FAST)\\n58\\t    assert run.returncode == 0, run.stdout + run.stderr\\n59\\t    out: dict[str, Any] = json.loads(run.stdout)\\n60\\t    return out\\n61\\t\\n62\\t\\n63\\tdef pushed(bare: Path, subject: str) -> bool:\\n64\\t    log = subprocess.run([\\\"git\\\", \\\"-C\\\", str(bare), \\\"log\\\", \\\"--format=%s\\\", \\\"main\\\"], capture_output=True, text=True).stdout\\n65\\t    return subject in log\\n66\\t\\n67\\t\\n68\\tdef wait_for(pred: Any, seconds: float = 20) -> None:\\n69\\t    deadline = time.monotonic() + seconds\\n70\\t    while time.monotonic() < deadline:\\n71\\t        if pred():\\n72\\t            return\\n73\\t        time.sleep(0.2)\\n74\\t    raise AssertionError(\\\"condition not met in time\\\")\\n75\\t\\n76\\t\\n77\\tdef built_tenant(tmp_path: Path, seconds: float = 3) -> tuple[Path, Path]:\\n78\\t    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n79\\t    add_forge(root, GREEN_FORGE)\\n80\\t    add_drive_stall_bound(root)\\n81\\t    slow_adapter(root, seconds)\\n82\\t    bare = add_bare_remote(root, tmp_path)\\n83\\t    approve_item(root)\\n84\\t    return root, bare\\n85\\t\\n86\\t\\n87\\tdef test_a_pass_returns_while_the_worker_runs_and_the_worker_outlives_it(tmp_path: Path) -> None:\\n88\\t    root, bare = built_tenant(tmp_path, seconds=3)\\n89\\t    started = time.monotonic()\\n90\\t    run = run_attavo(root, \\\"drive\\\", \\\"1\\\", env=FAST)\\n91\\t    elapsed = time.monotonic() - started\\n92\\t    assert run.returncode == 0, run.stdout + run.stderr\\n93\\t    assert elapsed < 2.5, f\\\"the pass took {elapsed:.1f}s: it waited for the stage\\\"\\n94\\t    assert \\\"Build started\\\" in run.stdout, run.stdout\\n95\\t    assert (records_dir(root) / \\\"build-01.started\\\").exists()\\n96\\t    assert remote_head(bare, \\\"main\\\") == head_of(root), \\\"the marker was not pushed before the pass returned\\\"\\n97\\t    assert record_files(root, \\\"build\\\") == [], \\\"the record existed before the worker could have written it\\\"\\n98\\t    wait_for(lambda: record_files(root, \\\"build\\\") != [])\\n99\\t    wait_for(lambda: remote_head(bare, \\\"main\\\") == head_of(root))\\n100\\t    assert latest_record(root, \\\"build\\\")[\\\"status\\\"] == \\\"pass\\\"\\n101\\t\\n102\\t\\n103\\tdef test_the_worker_touches_its_heartbeat_and_the_report_reads_running_by_it(tmp_path: Path) -> None:\\n104\\t    root, _ = built_tenant(tmp_path, seconds=3)\\n105\\t    assert run_attavo(root, \\\"drive\\\", \\\"1\\\", env=FAST).returncode == 0\\n106\\t    beat = git_dir(root) / \\\"attavo\\\" / \\\"build-01.heartbeat\\\"\\n107\\t    wait_for(beat.exists, 5)\\n108\\t    first = beat.stat().st_mtime\\n109\\t    time.sleep(0.6)\\n110\\t    assert beat.stat().st_mtime > first, \\\"the heartbeat did not move\\\"\\n111\\t    r = report(root)\\n112\\t    assert (r[\\\"state\\\"], r[\\\"kind\\\"]) == (\\\"running\\\", \\\"waits\\\"), r\\n113\\t    wait_for(lambda: record_files(root, \\\"build\\\") != [])\\n114\\t\\n115\\t\\n116\\tdef test_a_stale_heartbeat_reads_died_though_the_pid_lives_and_a_fresh_one_reads_alive(tmp_path: Path) -> None:\\n117\\t    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n118\\t    add_forge(root, GREEN_FORGE)\\n119\\t    add_drive_stall_bound(root, 600)\\n120\\t    approve_item(root)\\n121\\t    d = records_dir(root)\\n122\\t    d.mkdir(parents=True, exist_ok=True)\\n123\\t    marker = d / \\\"build-01.started\\\"\\n124\\t    now = time.strftime(\\\"%Y-%m-%dT%
lif status_out != \"pass\":\n+        reason = record.get(\"refusal\") or status_out\n+        print(f\"attavo drive: stopped: {stage} {status_out}: {reason} ({after.name}); \"\n+              f\"pushed to {branch}\")\n+    else:\n+        print(f\"attavo drive: pushed {after.name} to {branch}\")\n+    return rc\n+\n+\n+def cmd_worker(argv: list[str]) -> int:\n+    \"\"\"`attavo worker N <build|verify> NN`: the detached child a pass\n+    starts once its marker is pushed -- the lease held, the attempt is\n+    this worker's to run. Its own session (start_new_session, set by the\n+    pass that spawns it); its stdout and stderr are the pass's own\n+    redirect, to <git-dir>/attavo/<stage>-NN.worker.log.\"\"\"\n+    cast(io.TextIOWrapper, sys.stdout).reconfigure(line_buffering=True)\n+    if len(argv) != 3:\n+        print(\"attavo worker: usage: attavo worker N <build|verify> NN\", file=sys.stderr)\n+        return 2\n+    item_id, stage, nn_text = argv\n+    if stage not in (\"build\", \"verify\"):\n+        print(f\"attavo worker: {stage!r} is not build or verify\", file=sys.stderr)\n+        return 2\n+    try:\n+        nn = int(nn_text)\n+    except ValueError:\n+        print(f\"attavo worker: {nn_text!r} is not an attempt number\", file=sys.stderr)\n+        return 2\n+    return _stage_body(item_id, stage, nn)\n+\n+\n+# --- the pass's own two acts: start a stage (the lease), and recover\n+# exactly the one invocation the report names owed one. ---\n+\n+def _start_stage(root: Path, m: dict[str, Any], item_id: str, stage: str,\n+                 forge_checks: dict[str, Any] | None) -> int:\n+    \"\"\"The lease (ruling A): the marker, committed and pushed as a plain\n+    fast-forward with no merge and no retry (push_lease). Lost to another\n+    pass, or refused outright by the remote, both undo the marker commit\n+    here (git reset --hard) so this checkout carries no half-taken\n+    attempt either way; only a pushed lease starts the worker. On a\n+    review, forge_checks is the checks this same pass already read on\n+    the pre-marker head (ruling B) -- written to\n+    <git-dir>/attavo/verify-NN.forge-checks.json and named in\n+    ATTAVO_FORGE_CHECKS, so the worker's own `attavo verify` reads it\n+    instead of polling.\"\"\"\n+    records_dir = root / m[\"paths\"][\"records\"] / item_id\n+    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n+    nn = next_attempt_number(records_dir, stage)\n+    marker = write_invocation_marker(root, records_dir, stage, nn)\n+    try:\n+        commit_record(root, [marker], f\"attavo: {stage} invocation {nn:02d} started for item {item_id}\")\n+    except RuntimeError as exc:\n+        print(f\"attavo drive: stopped: could not commit the {stage} invocation marker: {exc}\")\n+        return 1\n+\n+    if has_origin(root):\n+        outcome, err = push_lease(root, branch)\n+        if outcome != \"pushed\":\n+            git(root, \"reset\", \"--hard\", \"HEAD^\")\n+            if outcome == \"lost-race\":\n+                print(f\"attavo drive: another pass holds this attempt ({marker.name}); nothing started\")\n+                return 0\n+            print(f\"attavo drive: stopped: could not push the {stage} invocation marker: {err}\")\n+            return 1\n+\n+    env = dict(os.environ)\n+    if forge_checks is not None:\n+        checks_file = forge_checks_path(root, stage, nn)\n+        checks_file.write_text(json.dumps(forge_checks))\n+        env[\"ATTAVO_FORGE_CHECKS\"] = str(checks_file)\n+    log = worker_log_path(root, stage, nn)\n+    with log.open(\"ab\") as fh, open(os.devnull, \"rb\") as devnull:\n+        proc = subprocess.Popen(\n+            [sys.executable, str(PRODUCT_ROOT / \"bin\" / \"attavo\"), \"worker\", item_id, stage, f\"{nn:02d}\"],\n+            cwd=str(root), env=env, stdin=devnull, stdout=fh, stderr=subprocess.STDOUT,\n+            start_new_session=True)\n+    word = \"Build\" if stage == \"build\" else \"Review\"\n+    print(f\"attavo drive: {word} started (attempt {nn:02d}, worker pid {proc.pid})\")\n+    return 0\n+\n+\n+def _recover_one(root: Path, m: dict[str, Any], item_id: str, records_dir: Path) -> int:\n+    \"\"\"The pass's own recovery act (what `--recover` did): exactly the one\n+    invocation the report just read as owing one -- died or hung -- ends\n+    here. class died when the heartbeat is stale (or absent and the pid\n+    is gone), class hung when there is no heartbeat, the pid lives, and a\n+    declared [drive].stall_after_s has passed with no newer event, and\n+    terminated. Provenance product; the events tail as the log. Committed\n+    and pushed the way any stage record is (push_record_commit, with its\n+    own merge retry) -- this is not a race for a lease, since no new\n+    attempt marker is written.\"\"\"\n+    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n+    bound = stall_bound_s(m)\n+    pending = invocations_without_record(records_dir)\n+    readings = [(marker, info, read_invocation(root, bound, marker, info)) for marker, info in pending]\ndiff --git a/tests/test_drive.py b/tests/test_drive.py\nindex e66ac68..430be0f 100644\n--- a/tests/test_drive.py\n+++ b/tests/test_drive.py\n@@ -462,23 +462,53 @@ def test_drive_until_ready_stops_on_a_halt(tmp_path: Path) -> None:\n \n \n \n-def test_drive_until_ready_stops_when_the_forge_goes_red_after_a_build(tmp_path: Path) -> None:\n-    \"\"\"A build that passes, then a forge that concludes red on its head,\n-    stops the loop there with exit 1 -- the loop gave up short of ready\n-    -- one record written (the pass), no review record, no retry of the\n-    forge read.\"\"\"\n+def retry_friendly_adapter(root: Path) -> None:\n+    \"\"\"R3: a build the fixture adapter already passed once carries\n+    built.txt already; a plain retry of that same build must still have\n+    something to commit, so this tenant-side wrapper rewrites built.txt\n+    with a fresh timestamp before delegating to the product's own\n+    fixture adapter.\"\"\"\n+    d = root / \"attavo\" / \"adapters\" / \"fixture\"\n+    d.mkdir(parents=True, exist_ok=True)\n+    (d / \"run\").write_text(\n+        \"#!/bin/sh\\n\"\n+        'if [ \"${ATTAVO_STAGE:-build}\" = build ] && [ -f built.txt ]; then\\n'\n+        '  echo \"built again $(date +%s%N)\" > built.txt\\n'\n+        \"  git add built.txt\\n\"\n+        \"  git commit -q -m 'fixture: write built.txt again'\\n\"\n+        f'  echo \\'{{\"status\":\"done\",\"question\":null,\"model\":\"fixture\",\"model_version\":null,'\n+        '\"adapter_version\":\"fixture-1\",\"tokens\":{\"input\":1,\"output\":1},\"cost_usd\":0.0}\\'\\n'\n+        \"  exit 0\\n\"\n+        \"fi\\n\"\n+        f\"exec sh {ROOT / 'adapters' / 'fixture' / 'run'}\\n\")\n+    (d / \"run\").chmod(0o755)\n+    commit_all(root, \"a retry-friendly tenant adapter\")\n+\n+\n+def test_drive_until_ready_stops_after_two_matching_returned_reviews(tmp_path: Path) -> None:\n+    \"\"\"R3 (ruling C amended): a build that passes, then a forge that\n+    concludes red on its head every time, is no longer a dead end the\n+    loop gives up on -- the pass converts it into a returned record and\n+    retries the build on its own, inside the budget. Two returned\n+    reviews with the identical signature then stop the stage: the loop\n+    reads that as done (a person's to look at, not a forge it never\n+    finished reading), and exits 0.\"\"\"\n     root = make_tenant(tmp_path, \"build_valid\")\n     add_forge(root, RED_FORGE)\n+    retry_friendly_adapter(root)\n     add_bare_remote(root, tmp_path)\n     approve_item(root)\n \n     run = run_attavo(root, \"drive\", \"1\", \"--until-ready\")\n-    assert run.returncode == 1, run.stdout + run.stderr\n-    assert \"ci\" in run.stdout and \"failure\" in run.stdout\n+    assert run.returncode == 0, run.stdout + run.stderr\n \n-    assert len(record_files(root, \"build\")) == 1\n-    assert latest_record(root, \"build\")[\"status\"] == \"pass\"\n-    assert record_files(root, \"verify\") == []\n+    assert len(record_files(root, \"build\")) == 2\n+    assert [r[\"status\"] for r in (latest_record(root, \"build\"),)] == [\"pass\"]\n+    assert len(record_files(root, \"verify\")) == 2\n+    for rec in (json.loads(p.read_text()) for p in record_files(root, \"verify\")):\n+        assert rec[\"status\"] == \"returned\" and rec[\"stop\"][\"class\"] == \"returned\"\n+    out = json.loads(run_attavo(root, \"drive\", \"1\", \"--report\").stdout)\n+    assert out[\"state\"] == \"stopped\" and out[\"signatures_match\"] is True, out\n \n \n \n@@ -560,40 +590,36 @@ def test_drive_line_buffers_stdout_so_a_pipe_reader_sees_the_start_line_before_t\n \n \n \n-def test_drive_pass_reads_a_red_forge_as_blocked_and_starts_nothing(tmp_path: Path) -> None:\n-    \"\"\"Acceptance row 4, as a level. A forge read where the one check has\n-    already concluded and failed is not polled at all -- the pass reads\n-    the forge once, says Blocked naming the check, exits 0, and starts\n-    no review: no marker, no verify record, no new commit, no sleep.\"\"\"\n+def test_drive_pass_turns_a_red_forge_on_a_passed_build_into_a_returned_record(tmp_path: Path) -> None:\n+    \"\"\"R3 (ruling C amended, #206's own build-01): a forge read where the\n+    one required check has already concluded and failed is a record now,\n+    not a level with nothing behind it -- the pass starts the review,\n+    which writes verify-01 status returned, class returned, naming the\n+    check in its signature. Inside the budget, the very next pass\n+    retries the build on its own -- no operator act, no counsel run.\"\"\"\n     root = make_tenant(tmp_path, \"build_valid\")\n     add_forge(root, RED_FORGE)\n+    retry_friendly_adapter(root)\n     add_bare_remote(root, tmp_path)\n     approve_item(root)\n \n     assert drive(root, \"1\").returncode == 0  # builds\n     pre_head = head_of(root)\n \n-    started = time.monotonic()\n     
{}).get(\\\"checks_command\\\")\\n686\\t        forge_checks = {\\\"command\\\": checks_command, \\\"sha\\\": r[\\\"head\\\"], \\\"conclusions\\\": r[\\\"checks\\\"] or []}\\n687\\t        return _start_stage(root, m, item_id, \\\"verify\\\", forge_checks), r\"}]},\"parent_tool_use_id\":null,\"session_id\":\"ae622d81-efb9-4dda-92a0-5ebf75b0d73f\",\"uuid\":\"086b2f95-0732-4d2c-a453-3208ddd65e7e\",\"timestamp\":\"2026-09-26T03:37:00.972Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/davidbean/Projects/attavo-worktree-219/attavo/drive.py\",\"content\":\"    next-review would do, bypassing the level a plain pass leaves alone\\n    for the operator. A review reads the forge fresh here -- once, since\\n    the report's own stopped reading never touched it -- rather than\\n    reusing a read that was never taken.\\\"\\\"\\\"\\n    if stage == \\\"build\\\":\\n        return _start_stage(root, m, item_id, \\\"build\\\", None)\\n    checks_command = (m.get(\\\"forge\\\") or {}).get(\\\"checks_command\\\")\\n    if not checks_command:\\n        print(\\\"attavo drive: refused: no [forge].checks_command in the manifest\\\")\\n        return 1\\n    forge_checks, ok = read_forge_checks(root, checks_command, cast(str, head))\\n    if not ok:\\n        conclusions = forge_checks[\\\"conclusions\\\"]\\n        named = \\\", \\\".join(f\\\"{c['name']} {c['conclusion']}\\\" for c in conclusions) or \\\"no checks reported\\\"\\n        print(f\\\"attavo drive: forge checks not green on {cast(str, head)[:12]}: {named}\\\")\\n        return 0\\n    return _start_stage(root, m, item_id, \\\"verify\\\", forge_checks)\\n\\n\\ndef _pass_once(root: Path, m: dict[str, Any], it\n1013 {\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01AA3hzx68dspNq5hxqSGDB5\",\"type\":\"tool_result\",\"content\":\"514\\tdef _start_stage(root: Path, m: dict[str, Any], item_id: str, stage: str,\\n515\\t                 forge_checks: dict[str, Any]
\n    head; blocked-on-checks on a review (R3) starts it too -- the same\\n    act as next-review, since a concluded red check on a passed build's\\n    head is now a returned record, not a level a pass leaves alone. A\\n    stopped stage inside its budget (RetryState.eligible) retries itself,\\n    with no flag needed; `--again` is a no-op that says so when the plain\\n    mechanism would already act or is only waiting out retry_after_s, and\\n    forces the next attempt, named again_by in its marker, when it would\\n    not. Every other level is printed in the report's own words and left.\\\"\\\"\\\"\\n    from attavo.report import drive_report\\n    fast_forward_to_origin(root, m, item_id)\\n    r = drive_report(root, m, item_id)\\n    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n\\n    if r[\\\"state\\\"] == \\\"owes-recovery\\\":\\n        return _recover_one(root, m, item_id, records_dir), r\\n    if r[\\\"state\\\"] == \\\"next-build\\\":\\n        return _start_stage(root, m, item_id, \\\"build\\\", None), r\\n    if r[\\\"state\\\"] in (\\\"next-review\\\", \\\"blocked-on-checks\\\") and r[\\\"stage\\\"] == \\\"verify\\\":\\n        checks_command = (m.get(\\\"forge\\\") or {}).get(\\\"checks_command\\\")\\n        forge_checks = {\\\"command\\\": checks_command, \\\"sha\\\": r[\\\"head\\\"], \\\"conclusions\\\": r[\\\"checks\\\"] or []}\\n        return _start_stage(root, m, item_id, \\\"verify\\\", forge_checks), r\\n    if r[\\\"state\\\"] == \\\"stopped\\\" and r[\\\"stage\\\"]:\\n        state = retry_state(root, m, records_dir, r[\\\"stage\\\"], r[\\\"stop_class\\\"], r[\\\"attempt\\\"])\\n      \n1028 {\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01FTsR9kH6w38SXMTUWitKoY\",\"type\":\"tool_result\",\"content\":\"804\\t    (exit 1). A stage running in its own worker is not bounded by this --\\n805\\t    only time spent waiting on the forge is.\\\"\\\"\\\"\\n806\\t    from attavo.verify import drive_forge_poll_bound_s, drive_forge_poll_interval_s\\n807\\t    bound = drive_forge_poll_bound_s()\\n808\\t    interval = drive_forge_poll_interval_s()\\n809\\t    waiting_since: float | None = None\\n810\\t    while True:\\n811\\t        rc, r = _pass_once(root, m, item_id, again)\\n812\\t        state = r[\\\"state\\\"]\\n813\\t\\n814\\t        if state == \\\"waiting-on-checks\\\":\\n815\\t            if waiting_since is None:\\n816\\t                waiting_since = time.monotonic()\\n817\\t            elif time.monotonic() - waiting_since >= bound:\\n818\\t                print(f\\\"attavo drive: stopped: the checks did not conclude within {bound:.0f}s\\\")\\n819\\t                return 1\\n820\\t        else:\\n821\\t            waiting_since = None\\n822\\t\\n823\\t        if rc != 0:\\n824\\t            return rc\\n825\\t        if state in _TERMINAL_STATES:\\n826\\t            return 0\\n827\\t        if state == \\\"blocked-on-checks\\\":\\n828\\t            return 1\\n829\\t        time.sleep(interval)\\n830\\t\\n831\\t\\n832\\tdef _drive_all() -> int:\\n833\\t    \\\"\\\"\\\"--all: one pass, in its own process, in every ../attavo-worktree-N\\n834\\t    beside this checkout -- each one derives its own item from its own\\n835\\t    attavo/N-* branch. Every line either prints is prefixed with the\\n836\\t    worktree's own directory name, so an operator reading them together\\n837\\t    can tell which item each line is about.\\\"\\\"\\\"\\n838\\t    root = Path(\\\".\\\").resolve()\\n839\\t    siblings = sorted(p for p in root.parent.glob(\\\"attavo-worktree-*\\\") if p.is_dir())\\n840\\t    if not siblings:\\n841\\t        print(\\\"attavo drive: --all found no ../attavo-worktree-N beside this checkout\\\")\\n842\\t        return 0\\n843\\t    worst = 0\"}]},\"parent_tool_use_id\":null,\"session_id\":\"ae622d81-efb9-4dda-92a0-5ebf75b0d73f\",\"uuid\":\"428bbfc5-7952-4dcb-9116-56b6b28eaabf\",\"timestamp\":\"2026-09-26T03:38:10.503Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/davidbean/Projects/attavo-worktree-219/attavo/drive.py\",\"content\":\"    (exit 1). A stage running in its own worker is not bounded by this --\\n    only time spent waiting on the forge is.\\\"\\\"\\\"\\n    from attavo.verify import drive_forge_poll_bound_s, drive_forge_poll_interval_s\\n    bound = drive_forge_poll_bound_s()\\n    interval = drive_forge_poll_interval_s()\\n    waiting_since: float | None = None\\n    while True:\\n        rc, r = _pass_once(root, m, item_id, again)\\n        state = r[\\\"state\\\"]\\n\\n        if state == \\\"waiting-on-checks\\\":\\n            if waiting_since is None:\\n                waiting_since = time.monotonic()\\n            elif time.monotonic() - waiting_since >= bound:\\n                print(f\\\"attavo drive: stopped: the checks did not conclude within {bound:.0f}s\\\")\\n                return 1\\n        else:\\n            waiting_since = None\\n\\n        if rc != 0:\\n            return rc\\n        if state in _TERMINAL_STATES:\\n            return 0\\n        if state == \\\"blocked-on-checks\\\":\\n            return 1\\n        time.sleep(interval)\\n\\n\\ndef _drive_all() -> int:\\n    \\\"\\\"\\\"--all: one pass, in its own process, in every ../attavo-worktree-N\\n    beside this checkout -- each one derives its own item from its own\\n    attavo/N-* branch. Every line either prints is prefixed with the\\n    worktree's own directory name, so an operator reading them together\\n    can tell which item each line is about.\\\"\\\"\\\"\\n    root = Path(\\\".\\\").resolve()\\n    siblings = sorted(p for p in root.parent.glob(\\\"attavo-worktree-*\\\") if p.is_dir())\\n    if not siblings:\\n        print(\\\"attavo drive: --all found no ../attavo-worktree-N beside this checkout\\\")\\n        return 0\\n    worst = 0\",\"numLines\":40,\"startLine\":804,\"totalLines\":905}}}\n1033 {\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_014aCTd47gvJ6iQ3UUqyd79G\",\"type\":\"tool_result\",\"content\":\"The file /Users/davidbean/Projects/attavo-worktree-219/attavo/drive.py has been updated successfully.\"}]},\"parent_tool_use_id\":null,\"session_id\":\"ae622d81-efb9-4dda-92a0-5ebf75b0d73f\",\"uuid\":\"77557f8b-c24e-4820-a03c-05e52e80fd69\",\"timestamp\":\"2026-09-26T03:38:17.309Z\",\"tool_use_result\":{\"filePath\":\"/Users/davidbean/Projects/attavo-worktree-219/attavo/drive.py\",\"oldString\":\"        if rc != 0:\\n            return rc\\n        if state in _TERMINAL_STATES:\\n            return 0\\n        if state == \\\"blocked-on-checks\\\":\\n            return 1\\n        time.sleep(interval)\",\"newString\":\"        if rc != 0:\\n            return rc\\n        if state in _TERMINAL_STATES:\\n            return 0\\n        # R3: blocked-on-checks on a review is no longer a dead end -- the\\n        # pass just converted it into a returned record and, inside its\\n        # budget, a build retry follows on its own. Only the post-verify\\n        # case (the checks went red after a passing review, stage None)\\n        # is still the level with nothing left to do but give up.\\n        if state == \\\"blocked-on-checks\\\" and r[\\\"stage\\\"] is None:\\n            return 1\\n        time.sleep(interval)\",\"originalFile\":\"from __future__ import annotations\\n\\nimport io\\nimport json\\nimport os\\nimport signal\\nimport subprocess\\nimport sys\\nimport threading\\nimport time\\nfrom pathlib import Path\\nfrom typing import TYPE_CHECKING, Any, NamedTuple, cast\\n\\nfrom attavo.approval import approval_status\\nfrom attavo.build import cmd_build, driver_identity\\nfrom attavo.common import MANIFEST, PRODUCT_ROOT, derive_item_id, git, read_manifest\\nfrom attavo.counsel import cmd_counsel\\nfrom attavo.doctor import (\\n    _parse_json_line,\\n    attempts_budget,\\n    ceiling_s,\\n    invocation_alive,\\n    invocations_without_record,\\n    retry_after_s,\\n    stall_bound_s,\\n    write_invocation_marker,\\n)\\nfrom attavo.events import stage_events_dir\\nfrom attavo.filing import cmd_file_stops\\nfrom attavo.records import (\\n    latest_attempt_path,\\n    latest_record,\\n    next_attempt_number,\\n    parse_attempts,\\n    stage_schema,\\n    write_record,\\n)\\nfrom attavo.stops import RETRYABLE_CLASSES, counsel_record_for, signature_of\\nfrom attavo.verify import cmd_verify, read_forge_checks\\n\\nif TYPE_CHECKING:\\n    from attavo.types import DriveReport\\n\\n# --- drive: the mechanical transitions between approval and ready-to-merge\\n# (issue #84), under the reconciler's R2 (rulings A, B, C's recovery half,\\n# F, G, H): `attavo drive N` is one short pass. It reads the report\\n# (attavo.report), acts at most once -- recovers a dead or hung\\n# invocation, or starts the next stage in a detached worker -- and\\n# returns within seconds; the stage itself runs in `attavo worker`, a\\n# child of the pass's own session, which outlives it. Writes no record of\\n# its own: the stage records already on disk, and the invocation markers\\n# and heartbeats beside them, are the only state a pass or a worker\\n# reads. ---\\n\\n\\ndef commit_record(root: Path, record_paths: Path | list[Path], message: str) -> None:\\n    \\\"\\\"\\\"`git commit --only` on every record path given, and each one's .log\\n    and .filed, each if one exists -- never the whole index. A transport\\n    commit that sweeps the index is exactly the regression issue #46\\n    already guards build and verify against on the adapter side; drive\\n    must not reintroduce it on the transport side. The .filed marker\\n    (issue #89) is committed alongside the record it names, in the same\\n    commit and the same push, so a second worktree or a fresh clone reads\\n    the same filed fact rather than refiling every stop it finds with no\\n    marker of its own. A single Path is accepted for the common one-record\\n    case; issue #100 passes a list so the counsel record lands in the same\\n    commit as the stage record it counsels. Authored and c\n1038 {\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01FdecmwHQbjCJV6nQebvoqj\",\"type\":\"tool_result\",\"content\":\"407\\t    \\\"\\\"\\\"Runs build or verify in-process -- the same command `attavo build`\\n408\\t    or `attavo verify` would run -- while touching heartbeat_path every\\n409\\t    heartbeat_s() seconds, then transports whatever it wrote: counsel and\\n410\\t    file-stops on a non-pass record (issue #100, #89), one `git commit\\n411\\t    --only`, one push with the record push's own merge retry. The\\n412\\t    marker is the pass's, already committed and pushed before this\\n413\\t    starts; this writes and transports only the stage's own record (and,\\n414\\t    on a stop, its counsel record).\\\"\\\"\\\"\\n415\\t    root = Path(\\\".\\\").resolve()\\n416\\t    m = read_manifest(root)\\n417\\t    if m is None:\\n418\\t        return 2\\n419\\t    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n420\\t    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n421\\t    before = latest_attempt_path(records_dir, stage)\\n422\\t\\n423\\t    beat = heartbeat_path(root, stage, nn)\\n424\\t    beat.parent.mkdir(parents=True, exist_ok=True)\\n425\\t    beat.touch()\\n426\\t    stop_beat = threading.Event()\\n427\\t\\n428\\t    def _tick() -> None:\\n429\\t        while not stop_beat.wait(heartbeat_s()):\\n430\\t            beat.touch()\\n431\\t\\n432\\t    beat_thread = threading.Thread(target=_tick, daemon=True)\\n433\\t    beat_thread.start()\\n434\\t    try:\\n435\\t        rc = cmd_build([item_id]) if stage == \\\"build\\\" else cmd_verify([item_id])\\n436\\t    finally:\\n437\\t        stop_beat.set()\\n438\\t        beat_thread.join()\\n439\\t\\n440\\t    after = latest_attempt_path(records_dir, stage)\\n441\\t    if after is None or after == before:\\n442\\t        # Refused before writing anything at all (e.g. no adapter\\n443\\t        # configured) -- the stage command already printed why.\\n444\\t        return rc if rc != 0 else 1\\n445\\t\\n446\\t    record = cast(dict[str, Any], latest_record(records_dir, stage))\\n447\\t    status_out = record.get(\\\"status\\\")\\n448\\t    to_commit = [after]\\n449\\t    if status_out != \\\"pass\\\":\\n450\\t        counsel_before = latest_attempt_path(records_dir, \\\"counsel\\\")\\n451\\t        cmd_counsel([item_id])\\n452\\t        counsel_after = latest_attempt_path(records_dir, \\\"counsel\\\")\\n453\\t        if counsel_after is not None and counsel_after != counsel_before:\\n454\\t            to_commit.append(counsel_after)\\n455\\t        # file-stops is its own idempotent read of the item's records, so\\n456\\t        # calling it here on every run that wrote a non-pass record is\\n457\\t        # safe to call again on a later run: an already-filed stop's own\\n458\\t        # marker is what stops it from being filed twice.\\n459\\t        cmd_file_stops([item_id])\\n460\\t\\n461\\t    message = f\\\"attavo: {stage} record for item {item_id} ({after.stem})\\\"\\n462\\t    try:\\n463\\t        commit_record(root, to_commit, message)\\n464\\t    except RuntimeError as exc:\\n465\\t        print(f\\\"attavo drive: stopped: could not commit the {stage} record: {exc}\\\")\\n466\\t        return 1\"}]},\"parent_tool_use_id\":null,\"session_id\":\"ae622d81-efb9-4dda-92a0-5ebf75b0d73f\",\"uuid\":\"4dcb6a30-3eb9-4cd6-b6a6-23a2bffcd1a1\",\"timestamp\":\"2026-09-26T03:38:21.220Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/davidbean/Projects/attavo-worktree-219/attavo/drive.py\",\"content\":\"    \\\"\\\"\\\"Runs build or verify in-process -- the same command `attavo build`\\n    or `attavo verify` would run -- while touching heartbeat_path every\\n    heartbeat_s() seconds, then transports whatever it wrote: counsel and\\n    file-stops on a non-pass record (issue #10
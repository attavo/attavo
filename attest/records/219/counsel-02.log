umbered <stage>-NN.json, or None.\\\"\\\"\\\"\\n    attempts = parse_attempts(records_dir, stage)\\n    if not attempts:\\n        return None\\n    nn = max(attempts)\\n    return f\\\"{stage}-{nn:02d}\\\", attempts[nn]\\n\\n\\ndef _filed(records_dir: Path, stem: str) -> str | None:\\n    marker = records_dir / f\\\"{stem}.filed\\\"\\n    try:\\n        text = marker.read_text().strip()\\n    except OSError:\\n        return None\\n    return text or None\\n\\n\\ndef _counsel_of(records_dir: Path, stem: str) -> tuple[str, CounselRecord] | None:\\n    \\\"\\\"\\\"The latest counsel record that read the stop named stem.\\\"\\\"\\\"\\n    attempts = parse_attempts(records_dir, \\\"counsel\\\")\\n    for nn in sorted(attempts, reverse=True):\\n        if attempts[nn].get(\\\"record\\\") == stem:\\n            return f\\\"counsel-{nn:02d}\\\", attempts[nn]\\n    return None\\n\\n\\ndef _stopped(root: Path, m: dict[str, Any], r: DriveReport, records_dir: Path, stage: str,\\n            stem: str, record: dict[str, Any]) -> DriveReport:\\n    stop = record.get(\\\"stop\\\") or {}\\n    s\n1077 {\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01BMzRgYja5i2iJWomeFYShv\",\"type\":\"tool_result\",\"content\":\"The file /Users/davidbean/Projects/attavo-worktree-219/attavo/report.py has been updated successfully.\"}]},\"parent_tool_use_id\":null,\"session_id\":\"ae622d81-efb9-4dda-92a0-5ebf75b0d73f\",\"uuid\":\"4de5c219-2882-4a63-b4d4-0dd08a8d00f3\",\"timestamp\":\"2026-09-26T03:39:34.851Z\",\"tool_use_result\":{\"filePath\":\"/Users/davidbean/Projects/attavo-worktree-219/attavo/report.py\",\"oldString\":\"            return _stopped(r, records_dir, \\\"build\\\", build[0], build[1])\",\"newString\":\"            return _stopped(root, m, r, records_dir, \\\"build\\\", build[0], build[1])\",\"originalFile\":\"from __future__ import annotations\\n\\nimport json\\nfrom pathlib import Path\\nfrom typing import Any\\n\\nfrom attavo.common impor
ss\\\": \\\"ceiling\\\", \\\"provenance\\\": \\\"product\\\", \\\"detail\\\": None,\\\\n'\\n     '                       \\\"signature\\\": None, \\\"bound\\\": None}'),\\n    ('assert rec[\\\"stop\\\"] == {\\\"class\\\": \\\"question\\\", \\\"provenance\\\": \\\"spec\\\",\\\\n'\\n     '                           \\\"detail\\\": \\\"which overlay wins?\\\"}',\\n     'assert rec[\\\"stop\\\"] == {\\\"class\\\": \\\"question\\\", \\\"provenance\\\": \\\"spec\\\",\\\\n'\\n     '                           \\\"detail\\\": \\\"which overlay wins?\\\", \\\"signature\\\": \\\"which overlay wins?\\\",\\\\n'\\n     '                           \\\"bound\\\": None}'),\\n    ('assert rec[\\\"stop\\\"] == {\\\"class\\\": \\\"question\\\", \\\"provenance\\\": \\\"spec\\\",\\\\n'\\n     '                           \\\"detail\\\": \\\"Which overlay wins here?\\\"}',\\n     'assert rec[\\\"stop\\\"] == {\\\"class\\\": \\\"question\\\", \\\"provenance\\\": \\\"spec\\\",\\\\n'\\n     '                           \\\"detail\\\": \\\"Which overlay wins here?\\\",\\\\n'\\n     '                           \\\"signature\\\": \\\"Which overlay wins here?\\\", \\\"bound\\\": None}'),\\n    ('assert rec[\\\"stop\\\"] == {\\\"class\\\": \\\"non-question\\\", \\\"provenance\\\": \\\"executor\\\", \\\"detail\\\": None}',\\n     'assert rec[\\\"stop\\\"] == {\\\"class\\\": \\\"non-question\\\", \\\"provenance\\\": \\\"executor\\\", \\\"detail\\\": None,\\\\n'\\n     '                       \\\"signature\\\": None, \\\"bound\\\": None}'),\\n    ('assert rec[\\\"stop\\\"] == {\\\"class\\\": \\\"environment\\\", \\\"provenance\\\": \\\"tenant\\\",\\\\n'\\n     '                           \\\"detail\\\": \\\"no jsonschema\\\"}',\\n     'assert rec[\\\"stop\\\"] == {\\\"class\\\": \\\"environment\\\", \\\"provenance\\\": \\\"tenant\\\",\\\\n'\\n     '                           \\\"detail\\\": \\\"no jsonschema\\\", \\\"signature\\\": \\\"no jsonschema\\\",\\\\n'\\n     '                           \\\"bo
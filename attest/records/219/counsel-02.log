 # every other non-pass class signs off its own detail (None for\\n622\\t        # most, so signature is None too -- the class alone, or the log\\n623\\t        # itself for unclassed, is the specimen's own cause).\\n624\\t        detail = ((payload or {}).get(\\\"detail\\\") if stop_out[\\\"class\\\"] == \\\"transient\\\"\\n625\\t                 else stop_out.get(\\\"detail\\\"))\\n626\\t        record[\\\"stop\\\"] = {**stop_out, \\\"detail\\\": detail, \\\"signature\\\": signature_of(detail),\\n627\\t                          \\\"bound\\\": None}\\n628\\t    record_path = write_record(item_records_dir, \\\"build\\\", record, m, item_id,\\n629\\t                               log=\\\"\\\\n\\\".join(transcripts))\\n630\\t\\n631\\t    print(f\\\"attavo build: {status_out} ({record_path.name})\\\")\\n632\\t    if status_out == \\\"halted\\\":\\n633\\t        return BUILD_HALT_EXIT\\n634\\t    return 0 if status_out == \\\"pass\\\" else 1\\n635\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"ae622d81-efb9-4dda-92a0-5ebf75b0d73f\",\"uuid\":\"92525ae6-2f68-4f3b-8dcc-764babe4deb0\",\"timestamp\":\"2026-09-26T04:11:30.230Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/davidbean/Projects/attavo-worktree-219/attavo/build.py\",\"content\":\"        \\\"steer\\\": steer,\\n        \\\"stop\\\": derive_stop(status_out, refusal=refusal, halted=halted,\\n                            log=\\\"\\\\n\\\".join(transcripts),\\n                            report_class=(payload or {}).get(\\\"class\\\"),\\n                            refusal_provenance=refusal_provenance),\\n    }\\n    if record[\\\"stop\\\"] is not None:\\n        stop_out: dict[str, Any] = record[\\\"stop\\\"]\\n        # R3: transient's own signature is the adapter's stop detail\\n        # (payload.get(\\\"detail\\\")), not derive_stop's detail (which is\\n        # None for every class but unclassed/question/environment/gate);\\n        # every other non-pass class signs off its own detail (None for\\n        # most, so signature is None too -- the class alone, or the log\\n        # itself for unclassed, is the specimen's own cause).\\n        detail = ((payload or {}).get(\\\"detail\\\") if stop_out[\\\"class\\\"] == \\\"transient\\\"\\n                 else stop_out.get(\\\"detail\\\"))\\n        record[\\\"stop\\\"] = {**stop_out, \\\"detail\\\": detail, \\\"signature\\\": signature_of(detail),\\n                          \\\"bound\\\": None}\\n    record_path = write_record(item_records_dir, \\\"build\\\", record, m, item_id,\\n                               log=\\\"\\\\n\\\".join(transcripts))\\n\\n    print(f\\\"attavo build: {status_out} ({record_path.name})\\\")\\n    if status_out == \\\"halted\\\":\\n        return BUILD_HALT_EXIT\\n    return 0 if status_out == \\\"pass\\\" else 1\\n\",\"numLines\":26,\"startLine\":610,\"totalLines\":635}}}\n1653:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_0189cMYV6pgSVCYCaHVTPukN\",\"type\":\"tool_result\",\"content\":\"The file /Users/davidbean/Projects/attavo-worktree-219/attavo/build.py has been updated successfully.\"}]},\"parent_tool_use_id\":null,\"session_id\":\"ae622d81-efb9-4dda-92a0-5ebf75b0d73f\",\"uuid\":\"59c6c6ff-de25-495f-aa29-033b6cbacec5\",\"timestamp\":\"2026-09-26T04:11:35.557Z\",\"tool_use_result\":{\"filePath\":\"/Users/davidbean/Projects/attavo-worktree-219/attavo/build.py\",\"oldString\":\"        detail = ((payload or {}).get(\\\"detail\\\") if stop_out[\\\"class\\\"] == \\\"transient\\\"\\n                 else stop_out.get(\\\"detail\\\"))\\n        record[\\\"stop\\\"] = {**stop_out, \\\"detail\\\": detail, \\\"signature\\\": signature_of(detail),\\n                          \\\"bound\\\": None}\",\"newString\":\"        detail: str | None = ((payload or {}).get(\\\"detail\\\") if stop_out[\\\"class\\\"] == \\\"transient\\\"\\n                              else stop_out.get(\\\"detail\\\"))\\n        record[\\\"stop\\\"] = {**stop_out, \\\"detail\\\": detail, \\\"signature\\\": signature_of(detail),\\n                          \\\"bound\\\": None}\",\"originalFile\":\"from __future__ import annotations\\n\\nimport fnmatch\\nimport json\\nimport os\\nimport shlex\\nimport subprocess\\nimport sys\\nimport tempfile\\nimport time\\nfrom pathlib import Path\\nfrom typing import Any, cast\\n\\nfrom attavo.approval import approval_status\\nfrom attavo.common import (\\n    MANIFEST,\\n    PRODUCT_ROOT,\\n    ShallowCheckoutError,\\n    derive_item_id,\\n    git,\\n    last_commit_touching,\\n    now_iso,\\n    read_manifest,\\n)\\nfrom attavo.events import append_event, stage_events_dir\\nfrom attavo.records import latest_record, next_attempt_number, parse_attempts, write_record\\nfrom attavo.spec import parse_spec, run_criterion\\nfrom attavo.stops import _log_last_line, derive_stop, signature_of\\nfrom attavo.testtool import run_bounded, without_records\\n\\n# --- build: adapter, claims boundary, criteria, and the tenant's tests ---\\n\\nSTAGE_NAMES = (\\\"build\\\", \\\"verify\\\", \\\"counsel\\\")\\n\\n\\ndef merge_adapter_config(m: dict[str, Any], adapter_name: str, stage: str) -> dict[str, Any]:\\n    \\\"\\\"\\\"[executor.<adapter>] merged with [executor.<adapter>.<stage>], the\\n    stage table shadowing the parent for that stage only. Both build and\\n    verify call this before setting ATTAVO_ADAPTER_CONFIG, and the\\n    record's adapter_config is the merged result.\\\"\\\"\\\"\\n    parent = (m.get(\\\"executor\\\") or {}).get(adapter_name) or {}\\n    if not isinstance(parent, dict):\\n        return {}\\n    merged = {k: v for k, v in parent.items() if k not in STAGE_NAMES}\\n    stage_table = parent.get(stage)\\n    if isinstance(stage_table, dict):\\n        merged.update(stage_table)\\n    return merged\\n\\n\\ndef resolve_adapter(root: Path, name: str) -> Path | None:\\n    \\\"\\\"\\\"adapters/<name>/run, resolved first under the tenant's own\\n    attavo/adapters/, then under this product's adapters/.\\\"\\\"\\\"\\n    for base in (root / \\\"attavo\\\" / \\\"adapters\\\", PRODUCT_ROOT / \\\"adapters\\\"):\\n        candidate = base / name / \\\"run\\\"\\n        if candidate.is_file():\\n            return candidate\\n    return None\\n\\n\\ndef adapter_reports(adapter_path: Path) -> list[str]:\\n    \\\"\\\"\\\"Field names adapters/<name>/conformance.json declares this adapter\\n    can supply with a real value -- vendor independence (2026-09-09\\n    ruling): the record carries the declaration, so an adapter claiming\\n    a field and returning null for it fails the conformance suite\\n    instead of writing a silent, uncomparable null. [] when the\\n    resolved adapter (a tenant override included) declares no\\n    conformance.json at all -- an absent declaration, not a refusal.\\\"\\\"\\\"\\n    manifest_path = adapter_path.parent / \\\"conformance.json\\\"\\n    if not manifest_path.is_file():\\n        return []\\n    try:\\n        manifest = json.loads(manifest_path.read_text())\\n    except json.JSONDecodeError:\\n        return []\\n    reports: list[str] = manifest.get(\\\"reports\\\", [])\\n    return reports\\n\\n\\ndef changed_paths(root: Path, start_sha: str, records_rel: str) -> list[str]:\\n    \\\"\\\"\\\"Paths changed between start_sha and HEAD, other than paths.records --\\n    the records directory is where build itself writes, not a claim.\\\"\\\"\\\"\\n    return without_records(git(root, \\\"diff\\\", \\\"--name-only\\\", start_sha, \\\"HEAD\\\").splitlines(),\\n                           records_rel)\\n\\n\\ndef matches_a_claim(path: str, claims: list[str]) -> bool:\\n    return any(fnmatch.fnmatch(path, pattern) for pattern in claims)\\n\\n\\ndef protected_path_touched(root: Path, start_sha: str, records_rel: str,\\n                           specs_rel: str) -> str | None:\\n    \\\"\\\"\\\"The first path an executor's own commits touched under\\n    paths.records or paths.specs since start_sha, or None (issue #140).\\n    Neither directory is a claim a spec can make -- paths.records is\\n    where the product itself writes, paths.specs is the definition of\\n    done -- yet changed_paths above excludes paths.records from the\\n    ordinary claims check entirely, so a path there never even reached\\n    matches_a_claim to be refused: tenant zero's own item #688 committed\\n    its own events file this way, under its records directory, on a\\n    build that then passed. Checked directly against the raw diff, not\\n    changed_paths's already-filtered list.\\\"\\\"\\\"\\n    touched = git(root, \\\"diff\\\", \\\"--name-only\\\", start_sha, \\\"HEAD\\\").splitlines()\\n    protected = []\\n    for rel in (records_rel, specs_rel):\\n        stripped = rel.rstrip(\\\"/\\\")\\n        protected.append((stripped, stripped + \\\"/\\\"))\\n    for p in touched:\\n        if not p:\\n            continue\\n        for exact, prefix in protected:\\n            if p == exact or p.startswith(prefix):\\n                return p\\n    return None\\n\\n\\ndef executor_identity(adapter_name: str) -> dict[str, Any]:\\n    \\\"\\\"\\\"The executor's identity (issue #33): set by the product, never the\\n    tenant's git config, so an executor commit is never indistinguishable\\n    from an operator's own -- the specimen is attavo/code-factory@e22fa85.\\n    A reserved, undeliverable domain (.invalid) so no mailbox is implied.\\n    Distinct from the records app identity: the app says the product\\n    pushed this, this says an invocation authored this -- different\\n    facts, neither borrows the other's name.\\\"\\\"\\\"\\n    return {\\\"name\\\": f\\\"attavo executor ({adapter_name})\\\",\\n            \\\"email\\\": f\\\"executor+{adapter_name}@attavo.invalid\\\"}\\n\\n\\ndef driver_identity() -> dict[str, Any]:\\n    \\\"\\\"\\\"The driver's identity: set by the product, never the tenant's git\\n    config, so a driver's own transport commit -- a record commit\\n    `commit_record` makes on the driver's behalf -- is never\\n    indistinguishable from an operator's own; `git log --author='attavo\\n    driver'` on a driven item lists exactly those commits. Distinct from\\n    executor_identity: that names an adapter invocation's own commits,\\n    this names the transport that carries a stage's record.\\\"\\\"\\\"\\n    return {\\\"name\\\": \\\"attavo driver\\\", \\\"email\\\": \\\"driver@attavo.invalid\\\"}\\n\\n\\ndef commits_since(root: Path, start_sha: str, end: str = \\\"HEAD\\\") -> list[dict[str, Any]]:\\n    \\\"\\\"\\\"(sha, name, email) for every commit after start_sha up to and\\n    including end, first-parent only, oldest first. cmd_build's own call\\n    (start_sha at the invocation, end left at the default HEAD) never sees\\n    a merge in that window, so --first-parent changes nothing there;\\n    issue #128's ledger is the caller that needs it, to walk one branch's\\n    own line without a concurrent merge to main expanding into every\\n    commit main gained meanwhile.\\\"\\\"\\\"\\n    out = git(root, \\\"log\\\", \\\"--first-parent\\\", \\\"--reverse\\\",\\n             \\\"--format=%H\\\\x1f%an\\\\x1f%ae\\\", f\\\"{start_sha}..{end}\\\")\\n    commits = []\\n    for line in out.splitlines():\\n        if not line.strip():\\n            continue\\n        sha, name, email = line.split(\\\"\\\\x1f\\\")\\n        commits.append({\\\"sha\\\": sha, \\\"name\\\": name, \\\"email\\\": email})\\n    return commits\\n\\n\\ndef commits_with_diffs(root: Path, start_sha: str, end: str = \\\"HEAD\\\") -> list[dict[str, Any]]:\\n    \\\"\\\"\\\"commits_since's own (sha, name, email), each with its own\\n    first-parent diff already attached as \\\"touched\\\" -- one process for the\\n    whole range rather than commits_since's list plus a git diff per\\n    commit (issue #153, the cost item_ledger's own walk paid per commit).\\\"\\\"\\\"\\n    out = git(root, \\\"log\\\", \\\"--first-parent\\\", \\\"--reverse\\\", \\\"--diff-merges=first-parent\\\",\\n             \\\"--name-only\\\", \\\"--format=\\\\x01%H\\\\x1f%an\\\\x1f%ae\\\", f\\\"{start_sha}..{end}\\\")\\n    commits = []\\n    for block in out.split(\\\"\\\\x01\\\")[1:]:\\n        header, _, rest = block.partition(\\\"\\\\n\\\")\\n        sha, name, email = header.split(\\\"\\\\x1f\\\")\\n        commits.append({\\\"sha\\\": sha, \\\"name\\\": name, \\\"email\\\": email,\\n                        \\\"touched\\\": [line for line in rest.splitlines() if line.strip()]})\\n    return commits\\n\\n\\ndef split_adapter_stdout(stdout: str) -> tuple[str, dict[str, Any] | None]:\\n    \\\"\\\"\\\"(transcript, payload): the adapter's last non-empty stdout line is\\n    its JSON report, and everything before it is transcript, only when\\n    that last line actually parses as JSON. When it does not -- a tool's\\n    own error line printed last on a non-zero exit (issue #86: tenant\\n    zero attest/records/659/verify-01.log, codex's own \\\"Input exceeds...\\\"\\n    line, dropped because it was mistaken for an attempted payload) --\\n    nothing here is a report, and the whole stdout is the transcript, so\\n    that last line is not silently lost.\\n    \\\"\\\"\\\"\\n    lines = stdout.splitlines()\\n    non_empty = [i for i, l in enumerate(lines) if l.strip()]\\n    if not non_empty:\\n        return stdout, None\\n    last = non_empty[-1]\\n    try:\\n        payload = json.loads(lines[last])\\n    except ValueError:\\n        return stdout, None\\n    transcript = \\\"\\\\n\\\".join(lines[:last])\\n    return transcript, payload\\n\\n\\nBUILD_ITERATION_BUDGET = 3\\n\\nBUILD_HALT_EXIT = 3\\n\\nCHECKS_FEEDBACK_TAIL_LINES = 200\\n\\n\\ndef _retry_seed(root: Path, m: dict[str, Any], records_dir: Path\\n                ) -> tuple[str | None, str | None, str]:\\n    \\\"\\\"\\\"(retry_of, steer, feedback): what a retried build's first iteration\\n    is handed (R3), in this order -- the prior attempt's own class and\\n    signature; the evidence a returned review carries (a red required\\n    check's log, read through [forge].check_log_command, or a review's\\n    own blocking findings); and the newest steer newer than the blocking\\n    record (counsel's answer text, named by the record it came from). A\\n    build retries the latest build record that is not a pass, or --\\n    retry_of still naming that same build attempt, the one a required\\n    check rejected or a review returned -- the latest verify record that\\n    returned it (class returned, its own build_sha matching the latest\\n    build's): the two never coexist, since a returned review is read\\n    only once its own build has already passed. (None, None, \\\"\\\") on a\\n    first attempt -- nothing to retry, nothing to seed.\\\"\\\"\\\"\\n    latest_build = cast(\\\"dict[str, Any] | None\\\", latest_record(records_dir, \\\"build\\\"))\\n    latest_verify = cast(\\\"dict[str, Any] | None\\\", latest_record(records_dir, \\\"verify\\\"))\\n    prior_stem = f\\\"build-{next_attempt_number(records_dir, 'build') - 1:02d}\\\"\\n    prior: dict[str, Any] | None = None\\n    counsel_stage, counsel_n = \\\"build\\\", next_attempt_number(records_dir, \\\"build\\\") - 1\\n    if (latest_verify and (latest_verify.get(\\\"stop\\\") or {}).get(\\\"class\\\") == \\\"returned\\\"\\n            and latest_build and latest_verify.get(\\\"build_sha\\\") == latest_build.get(\\\"sha\\\")):\\n        prior = latest_verify\\n        verify_attempts = parse_attempts(records_dir, \\\"verify\\\")\\n        counsel_stage = \\\"verify\\\"\\n        counsel_n = max(verify_attempts) if verify_attempts else 0\\n    elif latest_build and latest_build.get(\\\"status\\\") != \\\"pass\\\":\\n        prior = latest_build\\n    if prior is None:\\n        return None, None, \\\"\\\"\\n\\n    stop: dict[str, Any] = prior.get(\\\"stop\\\") or {}\\n    lines = [f\\\"attempt {prior_stem} stopped as {stop.get('class')}: {stop.get('detail') or ''}\\\",\\n            f\\\"signature: {stop.get('signature') or ''}\\\", \\\"\\\"]\\n\\n    forge = m.get(\\\"forge\\\") or {}\\n    if stop.get(\\\"class\\\") == \\\"returned\\\":\\n        findings = [f for f in (prior.get(\\\"findings\\\") or [])\\n                   if str(f.get(\\\"severity\\\")) == \\\"blocking\\\"]\\n        if findings:\\n            lines.append(\\\"blocking findings:\\\")\\n            for finding in findings:\\n                lines.append(f\\\"- {finding.get('title')}: {finding.get('specimen')} \\\"\\n                             f\\\"(retires: {finding.get('retires')})\\\")\\n            lines.append(\\\"\\\")\\n        elif forge.get(\\\"check_log_command\\\"):\\n            for c in (prior.get(\\\"forge_checks\\\") or {}).get(\\\"conclusions\\\") or []:\\n                if c.get(\\\"conclusion\\\") in (\\\"success\\\", \\\"neutral\\\", \\\"skipped\\\"):\\n                    continue\\n                run = subprocess.run(\\n                    f\\\"{forge['check_log_command']} {shlex.quote(str(prior.get('sha')))} \\\"\\n                    f\\\"{shlex.quote(c['name'])}\\\", shell=True, cwd=str(root),\\n                    capture_output=True, text=True, check=False)\\n                lines += [f\\\"--- check {c['name']} {c['conclusion']} ---\\\",\\n                         run.stdout.strip(), \\\"\\\"]\\n\\n    steer_stem: str | None = None\\n    if counsel_n:\\n        target = f\\\"{counsel_stage}-{counsel_n:02d}\\\"\\n        counsel_attempts = parse_attempts(records_dir, \\\"counsel\\\")\\n        matches = [(n, rec) for n, rec in sorted(counsel_attempts.items())\\n                  if rec.get(\\\"record\\\") == target]\\n        if matches:\\n            nn, counsel = matches[-1]\\n            if counsel.get(\\\"verdict\\\") == \\\"answer\\\":\\n                steer_stem = f\\\"counsel-{nn:02d}\\\"\\n                answer = (counsel.get(\\\"proposal\\\") or {}).get(\\\"ruling_text\\\")\\n                if answer:\\n                    lines += [f\\\"steer from {steer_stem}:\\\", answer.strip(), \\\"\\\"]\\n\\n    return prior_stem, steer_stem, \\\"\\\\n\\\".join(lines) + \\\"\\\\n\\\"\\n\\n\\ndef cmd_build(argv: list[str]) -> int:\\n    root = Path(\\\".\\\").resolve()\\n    item_id = argv[0] if argv else derive_item_id(root)\\n    if not item_id:\\n        print(\\\"attavo build: cannot derive item id; pass N or run on an attavo/N-* branch\\\",\\n              file=sys.stderr)\\n        return 2\\n    m = read_manifest(root)\\n    if m is None:\\n        print(f\\\"attavo build: no {MANIFEST} at {root}\\\", file=sys.stderr)\\n        return 2\\n\\n    adapter_name = (m.get(\\\"executor\\\") or {}).get(\\\"build\\\")\\n    if not adapter_name:\\n        print(\\\"attavo build: refused: no [executor].build in the manifest\\\")\\n        return 1\\n\\n    tests_cfg = m.get(\\\"tests\\\") or {}\\n    if not tests_cfg.get(\\\"select\\\") or not tests_cfg.get(\\\"run\\\"):\\n        print(\\\"attavo build: refused: no [tests] table in the manifest \\\"\\n              \\\"([tests].select and [tests].run are both required)\\\")\\n        return 1\\n\\n    if (m.get(\\\"checks\\\") or {}).get(\\\"probe\\\") and not (m.get(\\\"checks\\\") or {}).get(\\\"probe_timeout_s\\\"):\\n        print(\\\"attavo build: refused: [checks].probe is declared without \\\"\\n              \\\"[checks].probe_timeout_s (a probe with no bound is not asked)\\\")\\n        return 1\\n\\n    try:\\n        status = approval_status(root, m, item_id)\\n    except ShallowCheckoutError as exc:\\n        print(f\\\"attavo build: refused: {exc}\\\", file=sys.stderr)\\n        return 2\\n    if status != \\\"valid\\\":\\n        print(f\\\"attavo build: refused: approval is {status}\\\")\\n        return 1\\n\\n    adapter_path = resolve_adapter(root, adapter_name)\\n    if adapter_path is None:\\n        print(f\\\"attavo build: refused: no adapter named {adapter_name!r}\\\")\\n        return 1\\n\\n    specs_rel = m[\\\"paths\\\"][\\\"specs\\\"]\\n    records_rel = m[\\\"paths\\\"][\\\"records\\\"]\\n    spec_dir = root / specs_rel / item_id\\n    item_records_dir = root / records_rel / item_id\\n    spec_sha = last_commit_touching(root, str(Path(specs_rel) / item_id))\\n    latest_approval = latest_record(item_records_dir, \\\"approval\\\")\\n    parsed, _ = parse_spec(spec_dir / \\\"spec.md\\\")\\n    claims = parsed[\\\"claims\\\"] if parsed else []\\n    criteria_names = parsed[\\\"criteria\\\"] if parsed else []\\n    adapter_config = merge_adapter_config(m, adapter_name, \\\"build\\\")\\n    checks_cfg = m.get(\\\"checks\\\") or {}\\n    checks_command = checks_cfg.get(\\\"command\\\")\\n    probe = checks_cfg.get(\\\"probe\\\")\\n    probe_timeout_s = checks_cfg.get(\\\"probe_timeout_s\\\")\\n    identity = executor_identity(adapter_name)\\n    reports = adapter_reports(adapter_path)\\n\\n    start_sha = git(root, \\\"rev-parse\\\", \\\"HEAD\\\").strip()\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n    started = time.monotonic()\\n\\n    events_path = stage_events_dir(root) / f\\\"build-{next_attempt_number(item_records_dir, 'build'):02d}.events.jsonl\\\"\\n\\n    # Issue #115, then issue #212: whether this machine can run the tenant's\\n    # checks at all is asked once here, on the approved tree, before the\\n    # adapter is ever invoked -- a missing import at test collection (item\\n    # #106's build-01) is not a failing check, and no build could have\\n    # passed against it. A tenant that declares [checks].probe is asked by\\n    # the probe, inside [checks].probe_timeout_s: exit 0 yes, anything else\\n    # or the bound no. A tenant that does not is asked the old way, by\\n    # running [checks].command whole -- exit 2 no, exit 0 or 1 (the checks\\n    # ran and passed or failed, the expected states before a build) yes --\\n    # which is the run #194's build-01 spent 215 s on. Either way the feed\\n    # says what is being asked and what the answer was.\\n    if checks_command:\\n        append_event(events_path, \\\"gate\\\", \\\"checking this machine can run the checks\\\")\\n        asked = checks_command\\n        if probe:\\n            asked = probe\\n            code, out, err, timed_out = run_bounded(probe, root, \\\"\\\", probe_timeout_s)\\n            refusal_text = (f\\\"[checks].probe did not finish within {probe_timeout_s} s\\\" if timed_out\\n                            else f\\\"[checks].probe exited {code} on the approved tree\\\"\\n                            if code != 0 else None)\\n        else:\\n            preflight = subprocess.run(checks_command, shell=True, cwd=str(root),\\n                                       capture_output=True, text=True, check=False)\\n            code, out, err = preflight.returncode, preflight.stdout, preflight.stderr\\n            refusal_text = (\\\"[checks].command exited 2 on the approved tree\\\" if code == 2 else None)\\n        if refusal_text:\\n            append_event(events_path, \\\"gate\\\", f\\\"this machine cannot run the checks: {refusal_text}\\\")\\n            log = out + err\\n            detail = _log_last_line(out + \\\"\\\\n\\\" + err) or refusal_text\\n            record = {\\n                \\\"sha\\\": start_sha,\\n                \\\"start_sha\\\": start_sha,\\n                \\\"spec_sha\\\": spec_sha,\\n                \\\"approval_sha\\\": latest_approval.get(\\\"sha\\\") if latest_approval else None,\\n                \\\"at\\\": now_iso(),\\n                \\\"adapter\\\": adapter_name,\\n                \\\"adapter_config\\\": adapter_config,\\n                \\\"executor_identity\\\": identity,\\n                \\\"reports\\\": reports,\\n                \\\"adapter_version\\\": None,\\n                \\\"model\\\": None,\\n                \\\"model_version\\\": None,\\n                \\\"iterations\\\": 1,\\n                \\\"criteria\\\": [],\\n                \\\"selected_tests\\\": None,\\n                \\\"checks\\\": {\\\"command\\\": asked, \\\"exit\\\": code},\\n                \\\"tokens\\\": {\\\"input\\\": 0, \\\"output\\\": 0},\\n                \\\"cost_usd\\\": None,\\n                \\\"wall_clock_s\\\": round(time.monotonic() - started, 3),\\n                \\\"status\\\": \\\"refused\\\",\\n                \\\"refusal\\\": refusal_text,\\n                \\\"halted\\\": None,\\n                \\\"retry_of\\\": None,\\n                \\\"steer\\\": None,\\n                # R3: environment is never retried by this item (recorded\\n                # here, acted on by R4's breaker) -- signed anyway for\\n                # the exhaustion report's own side-by-side, on the\\n                # remote chance a person retries by hand.\\n                \\\"stop\\\": {\\\"class\\\": \\\"environment\\\", \\\"provenance\\\": \\\"tenant\\\", \\\"detail\\\": detail,\\n                        \\\"signature\\\": signature_of(detail), \\\"bound\\\": None},\\n            }\\n            record_path = write_record(item_records_dir, \\\"build\\\", record, m, item_id,\\n                                       log=log or refusal_text + \\\"\\\\n\\\")\\n            print(f\\\"attavo build: refused ({record_path.name})\\\")\\n            return 1\\n        append_event(events_path, \\\"gate\\\", \\\"this machine can run the checks\\\")\\n\\n    adapter_version = model = model_version = None\\n    tokens = {\\\"input\\\": 0, \\\"output\\\": 0}\\n    cost_usd = None\\n    transcripts: list[str] = []\\n    criteria_results: list[dict[str, Any]] = []\\n    selected_tests: dict[str, Any] | None = None\\n    checks_result: dict[str, Any] | None = None\\n    status_out = \\\"failed\\\"\\n    refusal = None\\n    refusal_provenance = None\\n    halted = None\\n    iterations_used = 0\\n\\n    with tempfile.TemporaryDirectory() as tmp:\\n        feedback_path = Path(tmp) / \\\"feedback.txt\\\"\\n        feedback_path.write_text(\\\"\\\")\\n        # R3: a retried attempt's first iteration starts with the prior\\n        # attempt's class and signature, its evidence, and the newest\\n        # steer newer than the blocking record -- the one file the\\n        # contract already passes, no new adapter input at all.\\n        retry_of, steer, seed = _retry_seed(root, m, item_records_dir)\\n        if seed:\\n            feedback_path.write_text(seed)\\n\\n        for iteration in range(1, BUILD_ITERATION_BUDGET + 1):\\n            iterations_used = iteration\\n            append_event(events_path, \\\"iteration\\\", f\\\"iteration {iteration} of {BUILD_ITERATION_BUDGET}\\\")\\n            env = dict(os.environ)\\n            # #212 retired the checks command reaching the executor; an\\n            # ATTAVO_CHECKS_COMMAND exported by whoever launched `attavo\\n            # build` must not reach it by inheritance either.\\n            env.pop(\\\"ATTAVO_CHECKS_COMMAND\\\", None)\\n            env[\\\"ATTAVO_SPEC_DIR\\\"] = str(spec_dir)\\n            env[\\\"ATTAVO_RECORDS_DIR\\\"] = str(item_records_dir)\\n            env[\\\"ATTAVO_RULINGS\\\"] = str(root / m[\\\"paths\\\"][\\\"rulings\\\"])\\n            env[\\\"ATTAVO_BRANCH\\\"] = branch\\n            env[\\\"ATTAVO_ITERATION\\\"] = str(iteration)\\n            env[\\\"ATTAVO_FEEDBACK\\\"] = str(feedback_path)\\n            env[\\\"ATTAVO_ADAPTER_CONFIG\\\"] = json.dumps(adapter_config)\\n            env[\\\"ATTAVO_STAGE\\\"] = \\\"build\\\"\\n            env[\\\"ATTAVO_EVENTS\\\"] = str(events_path)\\n            env[\\\"ATTAVO_TEST_COMMAND\\\"] = f\\\"python3 {PRODUCT_ROOT / 'bin' / 'attavo'} test {item_id}\\\"\\n            if tests_cfg.get(\\\"call_timeout_s\\\"):\\n                env[\\\"ATTAVO_TEST_TIMEOUT_S\\\"] = str(tests_cfg[\\\"call_timeout_s\\\"])\\n            else:\\n                env.pop(\\\"ATTAVO_TEST_TIMEOUT_S\\\", None)\\n            env[\\\"GIT_AUTHOR_NAME\\\"] = identity[\\\"name\\\"]\\n            env[\\\"GIT_AUTHOR_EMAIL\\\"] = identity[\\\"email\\\"]\\n            env[\\\"GIT_COMMITTER_NAME\\\"] = identity[\\\"name\\\"]\\n            env[\\\"GIT_COMMITTER_EMAIL\\\"] = identity[\\\"email\\\"]\\n\\n            run = subprocess.run([str(adapter_path)], cwd=str(root), env=env,\\n                                 capture_output=True, text=True, check=False)\\n            transcript, payload = split_adapter_stdout(run.stdout)\\n            if run.returncode != 0:\\n                # The guarantee behind issue #53's refusal: an adapter that\\n                # exits non-zero always leaves a non-empty log, even one\\n                # that printed nothing at all on stderr.\\n                detail = f\\\"[adapter exited {run.returncode}]\\\"\\n                if run.stderr.strip():\\n                    detail += \\\"\\\\n\\\" + run.stderr.rstrip(\\\"\\\\n\\\")\\n                transcript = (transcript + \\\"\\\\n\\\" if transcript else \\\"\\\") + detail\\n            transcripts.append(transcript)\\n\\n            if run.returncode != 0 or payload is None or not payload.get(\\\"model\\\"):\\n                status_out = \\\"failed\\\"\\n                break\\n\\n            adapter_version = payload.get(\\\"adapter_version\\\")\\n            model = payload.get(\\\"model\\\")\\n            model_version = payload.get(\\\"model_version\\\")\\n            tok = payload.get(\\\"tokens\\\") or {}\\n            tokens[\\\"input\\\"] += tok.get(\\\"input\\\", 0) or 0\\n            tokens[\\\"output\\\"] += tok.get(\\\"output\\\", 0) or 0\\n            iter_cost = payload.get(\\\"cost_usd\\\")\\n            if iter_cost is not None:\\n                cost_usd = (cost_usd or 0) + iter_cost\\n\\n            if payload.get(\\\"status\\\") == \\\"question\\\":\\n                status_out = \\\"halted\\\"\\n                halted = {\\\"question\\\": payload.get(\\\"question\\\")}\\n                break\\n\\n            foreign = next((c for c in commits_since(root, start_sha)\\n                           if c[\\\"name\\\"] != identity[\\\"name\\\"] or c[\\\"email\\\"] != identity[\\\"email\\\"]),\\n                          None)\\n            if foreign:\\n                status_out = \\\"refused\\\"\\n                refusal = f\\\"commit {foreign['sha']} not authored by the executor\\\"\\n                break\\n\\n            protected = protected_path_touched(root, start_sha, records_rel, specs_rel)\\n            if protected:\\n                status_out = \\\"refused\\\"\\n                refusal = protected\\n                refusal_provenance = \\\"executor\\\"\\n                break\\n\\n            touched = sorted(changed_paths(root, start_sha, records_rel))\\n            bad_path = next((p for p in touched if not matches_a_claim(p, claims)), None)\\n            if bad_path:\\n                status_out = \\\"refused\\\"\\n                refusal = bad_path\\n                break\\n\\n            criteria_results = [\\n                {\\\"name\\\": name, \\\"exit\\\": run_criterion(spec_dir / \\\"criteria\\\" / name, root)}\\n                for name in criteria_names]\\n            for c in criteria_results:\\n                append_event(events_path, \\\"gate\\\", f\\\"{c['name']}: exit {c['exit']}\\\")\\n\\n            select_in = \\\"\\\".join(p + \\\"\\\\n\\\" for p in touched)\\n            select_run = subprocess.run(tests_cfg[\\\"select\\\"], shell=True, cwd=str(root),\\n                                        input=select_in, capture_output=True,\\n                                        text=True, check=False)\\n            identifiers = [l for l in select_run.stdout.splitlines() if l.strip()]\\n            run_in = \\\"\\\".join(i + \\\"\\\\n\\\" for i in identifiers)\\n            test_run = subprocess.run(tests_cfg[\\\"run\\\"], shell=True, cwd=str(root),\\n                                      input=run_in, capture_output=True,\\n                                      text=True, check=False)\\n            selected_tests = {\\\"select\\\": tests_cfg[\\\"select\\\"], \\\"run\\\": tests_cfg[\\\"run\\\"],\\n                              \\\"count\\\": len(identifiers), \\\"exit\\\": test_run.returncode}\\n\\n            checks_run = None\\n            if checks_command:\\n                checks_run = subprocess.run(checks_command, shell=True, cwd=str(root),\\n                                            capture_output=True, text=True, check=False)\\n                checks_result = {\\\"command\\\": checks_command, \\\"exit\\\": checks_run.returncode}\\n\\n            # Issue #89, rejection test 1: the gate output that decides pass\\n            # or fail is appended to the build log itself, under a heading\\n            # per iteration, before this temporary directory goes away --\\n            # tenant zero's #576 build-11 and #659 build-01 are a failed\\n            # record with nothing beside it to say what was red, because\\n            # this output previously lived only in feedback.txt, in a\\n            # tempfile.TemporaryDirectory() cmd_build deletes on return.\\n            gate_lines = [f\\\"criterion {c['name']}: exit {c['exit']}\\\" for c in criteria_results]\\n            gate_lines.append(f\\\"selected tests ({selected_tests['count']}): exit \\\"\\n                              f\\\"{selected_tests['exit']}\\\")\\n            if test_run.stdout.strip():\\n                gate_lines += [\\\"--- selected tests stdout ---\\\", test_run.stdout.rstrip(\\\"\\\\n\\\")]\\n            if test_run.stderr.strip():\\n                gate_lines += [\\\"--- selected tests stderr ---\\\", test_run.stderr.rstrip(\\\"\\\\n\\\")]\\n            if checks_run is not None:\\n                tail = (checks_run.stdout.splitlines() + checks_run.stderr.splitlines())\\n                tail = tail[-CHECKS_FEEDBACK_TAIL_LINES:]\\n                gate_lines.append(f\\\"tenant checks: exit {checks_run.returncode}\\\")\\n                gate_lines += [\\\"--- checks output (tail) ---\\\", *tail]\\n            transcripts[-1] += (f\\\"\\\\n--- attavo gates, iteration {iteration} ---\\\\n\\\"\\n                               + \\\"\\\\n\\\".join(gate_lines))\\n\\n            failing = [c for c in criteria_results if c[\\\"exit\\\"] != 0]\\n            checks_ok = checks_run is None or checks_run.returncode == 0\\n            if not failing and test_run.returncode == 0 and checks_ok:\\n                status_out = \\\"pass\\\"\\n                break\\n\\n            if iteration == BUILD_ITERATION_BUDGET:\\n                status_out = \\\"failed\\\"\\n                break\\n\\n            feedback_lines = []\\n            if failing:\\n                feedback_lines.append(\\\"criteria failing:\\\")\\n                feedback_lines += [f\\\"- {c['name']}: exit {c['exit']}\\\" for c in failing]\\n            if test_run.returncode != 0:\\n                feedback_lines += [f\\\"test run exit {test_run.returncode}\\\",\\n                                   \\\"--- stdout ---\\\", test_run.stdout,\\n                                   \\\"--- stderr ---\\\", test_run.stderr]\\n            if checks_run is not None and checks_run.returncode != 0:\\n                tail = (checks_run.stdout.splitlines() + checks_run.stderr.splitlines())\\n                tail = tail[-CHECKS_FEEDBACK_TAIL_LINES:]\\n                feedback_lines += [f\\\"checks exit {checks_run.returncode}\\\",\\n                                   \\\"--- checks output (tail) ---\\\", *tail]\\n            feedback_path.write_text(\\\"\\\\n\\\".join(feedback_lines) + \\\"\\\\n\\\")\\n\\n    record = {\\n        \\\"sha\\\": git(root, \\\"rev-parse\\\", \\\"HEAD\\\").strip(),\\n        \\\"start_sha\\\": start_sha,\\n        \\\"spec_sha\\\": spec_sha,\\n        \\\"approval_sha\\\": latest_approval.get(\\\"sha\\\") if latest_approval else None,\\n        \\\"at\\\": now_iso(),\\n        \\\"adapter\\\": adapter_name,\\n        \\\"adapter_config\\\": adapter_config,\\n        \\\"executor_identity\\\": identity,\\n        \\\"reports\\\": reports,\\n        \\\"adapter_version\\\": adapter_version,\\n        \\\"model\\\": model,\\n        \\\"model_version\\\": model_version,\\n        \\\"iterations\\\": iterations_used,\\n        \\\"criteria\\\": criteria_results,\\n        \\\"selected_tests\\\": selected_tests,\\n        \\\"checks\\\": checks_result,\\n        \\\"tokens\\\": tokens,\\n        \\\"cost_usd\\\": cost_usd,\\n        \\\"wall_clock_s\\\": round(time.monotonic() - started, 3),\\n        \\\"status\\\": status_out,\\n        \\\"refusal\\\": refusal,\\n        \\\"halted\\\": halted,\\n        \\\"retry_of\\\": retry_of,\\n        \\\"steer\\\": steer,\\n        \\\"stop\\\": derive_stop(status_out, refusal=refusal, halted=halted,\\n                            log=\\\"\\\\n\\\".join(transcripts),\\n                            report_class=(payload or {}).get(\\\"class\\\"),\\n                            refusal_provenance=refusal_provenance),\\n    }\\n    if record[\\\"stop\\\"] is not None:\\n        stop_out: dict[str, Any] = record[\\\"stop\\\"]\\n        # R3: transient's own signature is the adapter's stop detail\\n        # (payload.get(\\\"detail\\\")), not derive_stop's detail (which is\\n        # None for every class but unclassed/question/environment/gate);\\n        # every other non-pass class signs off its own detail (None for\\n        # most, so signature is None too -- the class alone, or the log\\n        # itself for unclassed, is the specimen's own cause).\\n        detail = ((payload or {}).get(\\\"detail\\\") if stop_out[\\\"class\\\"] == \\\"transient\\\"\\n                 else stop_out.get(\\\"detail\\\"))\\n        record[\\\"stop\\\"] = {**stop_out, \\\"detail\\\": detail, \\\"signature\\\": signature_of(detail),\\n                          \\\"bound\\\": None}\\n    record_path = write_record(item_records_dir, \\\"build\\\", record, m, item_id,\\n                               log=\\\"\\\\n\\\".join(transcripts))\\n\\n    print(f\\\"attavo build: {status_out} ({record_path.name})\\\")\\n    if status_out == \\\"halted\\\":\\n        return BUILD_HALT_EXIT\\n    return 0 if status_out == \\\"pass\\\" else 1\\n\",\"structuredPatch\":[{\"oldStart\":621,\"oldLines\":8,\"newStart\":621,\"newLines\":8,\"lines\":[\"         # every other non-pass class signs off its own detail (None for\",\"         # most, so signature is None too -- the class alone, or the log\",\"         # itself for unclassed, is the specimen's own cause).\",\"-        detail = ((payload or {}).get(\\\"detail\\\") if stop_out[\\\"class\\\"] == \\\"transient\\\"\",\"-                 else stop_out.get(\\\"detail\\\"))\",\"+        detail: str | None = ((payload or {}).get(\\\"detail\\\") if stop_out[\\\"class\\\"] == \\\"transient\\\"\",\"+                              else stop_out.get(\\\"detail\\\"))\",\"         record[\\\"stop\\\"] = {**stop_out, \\\"detail\\\": detail, \\\"signature\\\": signature_of(detail),\",\"                           \\\"bound\\\": None}\",\"     record_path = write_record(item_records_dir, \\\"build\\\", record, m, item_id,\"]}],\"userModified\":false,\"replaceAll\":false,\"contentNotInModelContext\":true}}\n1681:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01T6HtUGzRHu292ncJn5goCS\",\"type\":\"tool_result\",\"content\":\"The file /Users/davidbean/Projects/attavo-worktree-219/attavo/build.py has been updated successfully.\"}]},\"parent_tool_use_id\":null,\"session_id\":\"ae622d81-efb9-4dda-92a0-5ebf75b0d73f\",\"uuid\":\"8095d5c3-f0df-498a-af6f-90256fd6a50f\",\"timestamp\":\"2026-09-26T04:12:15.278Z\",\"tool_use_result\":{\"filePath\":\"/Users/davidbean/Projects/attavo-worktree-219/attavo/build.py\",\"oldString\":\"        detail: str | None = ((payload or {}).get(\\\"detail\\\") if stop_out[\\\"class\\\"] == \\\"transient\\\"\\n                              else stop_out.get(\\\"detail\\\"))\\n        record[\\\"stop\\\"] = {**stop_out, \\\"detail\\\": detail, \\\"signature\\\": signature_of(detail),\\n                          \\\"bound\\\": None}\",\"newString\":\"        stop_detail: str | None = ((payload or {}).get(\\\"detail\\\") if stop_out[\\\"class\\\"] == \\\"transient\\\"\\n                                   else stop_out.get(\\\"detail\\\"))\\n        record[\\\"stop\\\"] = {**stop_out, \\\"detail\\\": stop_detail, \\\"signature\\\": signature_of(stop_detail),\\n                          \\\"bound\\\": None}\",\"originalFile\":\"from __future__ import annotations\\n\\nimport fnmatch\\nimport json\\nimport os\\nimport shlex\\nimport subprocess\\nimport sys\\nimport tempfile\\nimport time\\nfrom pathlib import Path\\nfrom typing import Any, cast\\n\\nfrom attavo.approval import approval_status\\nfrom attavo.common import (\\n    MANIFEST,\\n    PRODUCT_ROOT,\\n    ShallowCheckoutError,\\n    derive_item_id,\\n    git,\\n    last_commit_touching,\\n    now_iso,\\n    read_manifest,\\n)\\nfrom attavo.events import append_event, stage_events_dir\\nfrom attavo.records import latest_record, next_attempt_number, parse_attempts, write_record\\nfrom attavo.spec import parse_spec, run_criterion\\nfrom attavo.stops import _log_last_line, derive_stop, signature_of\\nfrom attavo.testtool import run_bounded, without_records\\n\\n# --- build: adapter, claims boundary, criteria, and the tenant's tests ---\\n\\nSTAGE_NAMES = (\\\"build\\\", \\\"verify\\\", \\\"counsel\\\")\\n\\n\\ndef merge_adapter_config(m: dict[str, Any], adapter_name: str, stage: str) -> dict[str, Any]:\\n    \\\"\\\"\\\"[executor.<adapter>] merged with [executor.<adapter>.<stage>], the\\n    stage table shadowing the parent for that stage only. Both build and\\n    verify call this before setting ATTAVO_ADAPTER_CONFIG, and the\\n    record's adapter_config is the merged result.\\\"\\\"\\\"\\n    parent = (m.get(\\\"executor\\\") or {}).get(adapter_name) or {}\\n    if not isinstance(parent, dict):\\n        return {}\\n    merged = {k: v for k, v in parent.items() if k not in STAGE_NAMES}\\n    stage_table = parent.get(stage)\\n    if isinstance(stage_table, dict):\\n        merged.update(stage_table)\\n    return merged\\n\\n\\ndef resolve_adapter(root: Path, name: str) -> Path | None:\\n    \\\"\\\"\\\"adapters/<name>/run, resolved first under the tenant's own\\n    attavo/adapters/, then under this product's adapters/.\\\"\\\"\\\"\\n    for base in (root / \\\"attavo\\\" / \\\"adapters\\\", PRODUCT_ROOT / \\\"adapters\\\"):\\n        candidate = base / name / \\\"run\\\"\\n        if candidate.is_file():\\n            return candidate\\n    return None\\n\\n\\ndef adapter_reports(adapter_path: Path) -> list[str]:\\n    \\\"\\\"\\\"Field names adapters/<name>/conformance.json declares this adapter\\n    can supply with a real value -- vendor independence (2026-09-09\\n    ruling): the record carries the declaration, so an adapter claiming\\n    a field and returning null for it fails the conformance suite\\n    instead of writing a silent, uncomparable null. [] when the\\n    resolved adapter (a tenant override included) declares no\\n    conformance.json at all -- an absent declaration, not a refusal.\\\"\\\"\\\"\\n    manifest_path = adapter_path.parent / \\\"conformance.json\\\"\\n    if not manifest_path.is_file():\\n        return []\\n    try:\\n        manifest = json.loads(manifest_path.read_text())\\n    except json.JSONDecodeError:\\n        return []\\n    reports: list[str] = manifest.get(\\\"reports\\\", [])\\n    return reports\\n\\n\\ndef changed_paths(root: Path, start_sha: str, records_rel: str) -> list[str]:\\n    \\\"\\\"\\\"Paths changed between start_sha and HEAD, other than paths.records --\\n    the records directory is where build itself writes, not a claim.\\\"\\\"\\\"\\n    return without_records(git(root, \\\"diff\\\", \\\"--name-only\\\", start_sha, \\\"HEAD\\\").splitlines(),\\n                           records_rel)\\n\\n\\ndef matches_a_claim(path: str, claims: list[str]) -> bool:\\n    return any(fnmatch.fnmatch(path, pattern) for pattern in claims)\\n\\n\\ndef protected_path_touched(root: Path, start_sha: str, records_rel: str,\\n                           specs_rel: str) -> str | None:\\n    \\\"\\\"\\\"The first path an executor's own commits touched under\\n    paths.records or paths.specs since start_sha, or None (issue #140).\\n    Neither directory is a claim a spec can make -- paths.records is\\n    where the product itself writes, paths.specs is the definition of\\n    done -- yet changed_paths above excludes paths.records from the\\n    ordinary claims check entirely, so a path there never even reached\\n    matches_a_claim to be refused: tenant zero's own item #688 committed\\n    its own events file this way, under its records directory, on a\\n    build that then passed. Checked directly against the raw diff, not\\n    changed_paths's already-filtered list.\\\"\\\"\\\"\\n    touched = git(root, \\\"diff\\\", \\\"--name-only\\\", start_sha, \\\"HEAD\\\").splitlines()\\n    protected = []\\n    for rel in (records_rel, specs_rel):\\n        stripped = rel.rstrip(\\\"/\\\")\\n        protected.append((stripped, stripped + \\\"/\\\"))\\n    for p in touched:\\n        if not p:\\n            continue\\n        for exact, prefix in protected:\\n            if p == exact or p.startswith(prefix):\\n                return p\\n    return None\\n\\n\\ndef executor_identity(adapter_name: str) -> dict[str, Any]:\\n    \\\"\\\"\\\"The executor's identity (issue #33): set by the product, never the\\n    tenant's git config, so an executor commit is never indistinguishable\\n    from an operator's own -- the specimen is attavo/code-factory@e22fa85.\\n    A reserved, undeliverable domain (.invalid) so no mailbox is implied.\\n    Distinct from the records app identity: the app says the product\\n    pushed this, this says an invocation authored this -- different\\n    facts, neither borrows the other's name.\\\"\\\"\\\"\\n    return {\\\"name\\\": f\\\"attavo executor ({adapter_name})\\\",\\n            \\\"email\\\": f\\\"executor+{adapter_name}@attavo.invalid\\\"}\\n\\n\\ndef driver_identity() -> dict[str, Any]:\\n    \\\"\\\"\\\"The driver's identity: set by the product, never the tenant's git\\n    config, so a driver's own transport commit -- a record commit\\n    `commit_record` makes on the driver's behalf -- is never\\n    indistinguishable from an operator's own; `git log --author='attavo\\n    driver'` on a driven item lists exactly those commits. Distinct from\\n    executor_identity: that names an adapter invocation's own commits,\\n    this names the transport that carries a stage's record.\\\"\\\"\\\"\\n    return {\\\"name\\\": \\\"attavo driver\\\", \\\"email\\\": \\\"driver@attavo.invalid\\\"}\\n\\n\\ndef commits_since(root: Path, start_sha: str, end: str = \\\"HEAD\\\") -> list[dict[str, Any]]:\\n    \\\"\\\"\\\"(sha, name, email) for every commit after start_sha up to and\\n    including end, first-parent only, oldest first. cmd_build's own call\\n    (start_sha at the invocation, end left at the default HEAD) never sees\\n    a merge in that window, so --first-parent changes nothing there;\\n    issue #128's ledger is the caller that needs it, to walk one branch's\\n    own line without a concurrent merge to main expanding into every\\n    commit main gained meanwhile.\\\"\\\"\\\"\\n    out = git(root, \\\"log\\\", \\\"--first-parent\\\", \\\"--reverse\\\",\\n             \\\"--format=%H\\\\x1f%an\\\\x1f%ae\\\", f\\\"{start_sha}..{end}\\\")\\n    commits = []\\n    for line in out.splitlines():\\n        if not line.strip():\\n            continue\\n        sha, name, email = line.split(\\\"\\\\x1f\\\")\\n        commits.append({\\\"sha\\\": sha, \\\"name\\\": name, \\\"email\\\": email})\\n    return commits\\n\\n\\ndef commits_with_diffs(root: Path, start_sha: str, end: str = \\\"HEAD\\\") -> list[dict[str, Any]]:\\n    \\\"\\\"\\\"commits_since's own (sha, name, email), each with its own\\n    first-parent diff already attached as \\\"touched\\\" -- one process for the\\n    whole range rather than commits_since's list plus a git diff per\\n    commit (issue #153, the cost item_ledger's own walk paid per commit).\\\"\\\"\\\"\\n    out = git(root, \\\"log\\\", \\\"--first-parent\\\", \\\"--reverse\\\", \\\"--diff-merges=first-parent\\\",\\n             \\\"--name-only\\\", \\\"--format=\\\\x01%H\\\\x1f%an\\\\x1f%ae\\\", f\\\"{start_sha}..{end}\\\")\\n    commits = []\\n    for block in out.split(\\\"\\\\x01\\\")[1:]:\\n        header, _, rest = block.partition(\\\"\\\\n\\\")\\n        sha, name, email = header.split(\\\"\\\\x1f\\\")\\n        commits.append({\\\"sha\\\": sha, \\\"name\\\": name, \\\"email\\\": email,\\n                        \\\"touched\\\": [line for line in rest.splitlines() if line.strip()]})\\n    return commits\\n\\n\\ndef split_adapter_stdout(stdout: str) -> tuple[str, dict[str, Any] | None]:\\n    \\\"\\\"\\\"(transcript, payload): the adapter's last non-empty stdout line is\\n    its JSON report, and everything before it is transcript, only when\\n    that last line actually parses as JSON. When it does not -- a tool's\\n    own error line printed last on a non-zero exit (issue #86: tenant\\n    zero attest/records/659/verify-01.log, codex's own \\\"Input exceeds...\\\"\\n    line, dropped because it was mistaken for an attempted payload) --\\n    nothing here is a report, and the whole stdout is the transcript, so\\n    that last line is not silently lost.\\n    \\\"\\\"\\\"\\n    lines = stdout.splitlines()\\n    non_empty = [i for i, l in enumerate(lines) if l.strip()]\\n    if not non_empty:\\n        return stdout, None\\n    last = non_empty[-1]\\n    try:\\n        payload = json.loads(lines[last])\\n    except ValueError:\\n        return stdout, None\\n    transcript = \\\"\\\\n\\\".join(lines[:last])\\n    return transcript, payload\\n\\n\\nBUILD_ITERATION_BUDGET = 3\\n\\nBUILD_HALT_EXIT = 3\\n\\nCHECKS_FEEDBACK_TAIL_LINES = 200\\n\\n\\ndef _retry_seed(root: Path, m: dict[str, Any], records_dir: Path\\n                ) -> tuple[str | None, str | None, str]:\\n    \\\"\\\"\\\"(retry_of, steer, feedback): what a retried build's first iteration\\n    is handed (R3), in this order -- the prior attempt's own class and\\n    signature; the evidence a returned review carries (a red required\\n    check's log, read through [forge].check_log_command, or a review's\\n    own blocking findings); and the newest steer newer than the blocking\\n    record (counsel's answer text, named by the record it came from). A\\n    build retries the latest build record that is not a pass, or --\\n    retry_of still naming that same build attempt, the one a required\\n    check rejected or a review returned -- the latest verify record that\\n    returned it (class returned, its own build_sha matching the latest\\n    build's): the two never coexist, since a returned review is read\\n    only once its own build has already passed. (None, None, \\\"\\\") on a\\n    first attempt -- nothing to retry, nothing to seed.\\\"\\\"\\\"\\n    latest_build = cast(\\\"dict[str, Any] | None\\\", latest_record(records_dir, \\\"build\\\"))\\n    latest_verify = cast(\\\"dict[str, Any] | None\\\", latest_record(records_dir, \\\"verify\\\"))\\n    prior_stem = f\\\"build-{next_attempt_number(records_dir, 'build') - 1:02d}\\\"\\n    prior: dict[str, Any] | None = None\\n    counsel_stage, counsel_n = \\\"build\\\", next_attempt_number(records_dir, \\\"build\\\") - 1\\n    if (latest_verify and (latest_verify.get(\\\"stop\\\") or {}).get(\\\"class\\\") == \\\"returned\\\"\\n            and latest_build and latest_verify.get(\\\"build_sha\\\") == latest_build.get(\\\"sha\\\")):\\n        prior = latest_verify\\n        verify_attempts = parse_attempts(records_dir, \\\"verify\\\")\\n        counsel_stage = \\\"verify\\\"\\n        counsel_n = max(verify_attempts) if verify_attempts else 0\\n    elif latest_build and latest_build.get(\\\"status\\\") != \\\"pass\\\":\\n        prior = latest_build\\n    if prior is None:\\n        return None, None, \\\"\\\"\\n\\n    stop: dict[str, Any] = prior.get(\\\"stop\\\") or {}\\n    lines = [f\\\"attempt {prior_stem} stopped as {stop.get('class')}: {stop.get('detail') or ''}\\\",\\n            f\\\"signature: {stop.get('signature') or ''}\\\", \\\"\\\"]\\n\\n    forge = m.get(\\\"forge\\\") or {}\\n    if stop.get(\\\"class\\\") == \\\"returned\\\":\\n        findings = [f for f in (prior.get(\\\"findings\\\") or [])\\n                   if str(f.get(\\\"severity\\\")) == \\\"blocking\\\"]\\n        if findings:\\n            lines.append(\\\"blocking findings:\\\")\\n            for finding in findings:\\n                lines.append(f\\\"- {finding.get('title')}: {finding.get('specimen')} \\\"\\n                             f\\\"(retires: {finding.get('retires')})\\\")\\n            lines.append(\\\"\\\")\\n        elif forge.get(\\\"check_log_command\\\"):\\n            for c in (prior.get(\\\"forge_checks\\\") or {}).get(\\\"conclusions\\\") or []:\\n                if c.get(\\\"conclusion\\\") in (\\\"success\\\", \\\"neutral\\\", \\\"skipped\\\"):\\n                    continue\\n                run = subprocess.run(\\n                    f\\\"{forge['check_log_command']} {shlex.quote(str(prior.get('sha')))} \\\"\\n                    f\\\"{shlex.quote(c['name'])}\\\", shell=True, cwd=str(root),\\n                    capture_output=True, text=True, check=False)\\n                lines += [f\\\"--- check {c['name']} {c['conclusion']} ---\\\",\\n                         run.stdout.strip(), \\\"\\\"]\\n\\n    steer_stem: str | None = None\\n    if counsel_n:\\n        target = f\\\"{counsel_stage}-{counsel_n:02d}\\\"\\n        counsel_attempts = parse_attempts(records_dir, \\\"counsel\\\")\\n        matches = [(n, rec) for n, rec in sorted(counsel_attempts.items())\\n                  if rec.get(\\\"record\\\") == target]\\n        if matches:\\n            nn, counsel = matches[-1]\\n            if counsel.get(\\\"verdict\\\") == \\\"answer\\\":\\n                steer_stem = f\\\"counsel-{nn:02d}\\\"\\n                answer = (counsel.get(\\\"proposal\\\") or {}).get(\\\"ruling_text\\\")\\n                if answer:\\n                    lines += [f\\\"steer from {steer_stem}:\\\", answer.strip(), \\\"\\\"]\\n\\n    return prior_stem, steer_stem, \\\"\\\\n\\\".join(lines) + \\\"\\\\n\\\"\\n\\n\\ndef cmd_build(argv: list[str]) -> int:\\n    root = Path(\\\".\\\").resolve()\\n    item_id = argv[0] if argv else derive_item_id(root)\\n    if not item_id:\\n        print(\\\"attavo build: cannot derive item id; pass N or run on an attavo/N-* branch\\\",\\n              file=sys.stderr)\\n        return 2\\n    m = read_manifest(root)\\n    if m is None:\\n        print(f\\\"attavo build: no {MANIFEST} at {root}\\\", file=sys.stderr)\\n        return 2\\n\\n    adapter_name = (m.get(\\\"executor\\\") or {}).get(\\\"build\\\")\\n    if not adapter_name:\\n        print(\\\"attavo build: refused: no [executor].build in the manifest\\\")\\n        return 1\\n\\n    tests_cfg = m.get(\\\"tests\\\") or {}\\n    if not tests_cfg.get(\\\"select\\\") or not tests_cfg.get(\\\"run\\\"):\\n        print(\\\"attavo build: refused: no [tests] table in the manifest \\\"\\n              \\\"([tests].select and [tests].run are both required)\\\")\\n        return 1\\n\\n    if (m.get(\\\"checks\\\") or {}).get(\\\"probe\\\") and not (m.get(\\\"checks\\\") or {}).get(\\\"probe_timeout_s\\\"):\\n        print(\\\"attavo build: refused: [checks].probe is declared without \\\"\\n              \\\"[checks].probe_timeout_s (a probe with no bound is not asked)\\\")\\n        return 1\\n\\n    try:\\n        status = approval_status(root, m, item_id)\\n    except ShallowCheckoutError as exc:\\n        print(f\\\"attavo build: refused: {exc}\\\", file=sys.stderr)\\n        return 2\\n    if status != \\\"valid\\\":\\n        print(f\\\"attavo build: refused: approval is {status}\\\")\\n        return 1\\n\\n    adapter_path = resolve_adapter(root, adapter_name)\\n    if adapter_path is None:\\n        print(f\\\"attavo build: refused: no adapter named {adapter_name!r}\\\")\\n        return 1\\n\\n    specs_rel = m[\\\"paths\\\"][\\\"specs\\\"]\\n    records_rel = m[\\\"paths\\\"][\\\"records\\\"]\\n    spec_dir = root / specs_rel / item_id\\n    item_records_dir = root / records_rel / item_id\\n    spec_sha = last_commit_touching(root, str(Path(specs_rel) / item_id))\\n    latest_approval = latest_record(item_records_dir, \\\"approval\\\")\\n    parsed, _ = parse_spec(spec_dir / \\\"spec.md\\\")\\n    claims = parsed[\\\"claims\\\"] if parsed else []\\n    criteria_names = parsed[\\\"criteria\\\"] if parsed else []\\n    adapter_config = merge_adapter_config(m, adapter_name, \\\"build\\\")\\n    checks_cfg = m.get(\\\"checks\\\") or {}\\n    checks_command = checks_cfg.get(\\\"command\\\")\\n    probe = checks_cfg.get(\\\"probe\\\")\\n    probe_timeout_s = checks_cfg.get(\\\"probe_timeout_s\\\")\\n    identity = executor_identity(adapter_name)\\n    reports = adapter_reports(adapter_path)\\n\\n    start_sha = git(root, \\\"rev-parse\\\", \\\"HEAD\\\").strip()\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n    started = time.monotonic()\\n\\n    events_path = stage_events_dir(root) / f\\\"build-{next_attempt_number(item_records_dir, 'build'):02d}.events.jsonl\\\"\\n\\n    # Issue #115, then issue #212: whether this machine can run the tenant's\\n    # checks at all is asked once here, on the approved tree, before the\\n    # adapter is ever invoked -- a missing import at test collection (item\\n    # #106's build-01) is not a failing check, and no build could have\\n    # passed against it. A tenant that declares [checks].probe is asked by\\n    # the probe, inside [checks].probe_timeout_s: exit 0 yes, anything else\\n    # or the bound no. A tenant that does not is asked the old way, by\\n    # running [checks].command whole -- exit 2 no, exit 0 or 1 (the checks\\n    # ran and passed or failed, the expected states before a build) yes --\\n    # which is the run #194's build-01 spent 215 s on. Either way the feed\\n    # says what is being asked and what the answer was.\\n    if checks_command:\\n        append_event(events_path, \\\"gate\\\", \\\"checking this machine can run the checks\\\")\\n        asked = checks_command\\n        if probe:\\n            asked = probe\\n            code, out, err, timed_out = run_bounded(probe, root, \\\"\\\", probe_timeout_s)\\n            refusal_text = (f\\\"[checks].probe did not finish within {probe_timeout_s} s\\\" if timed_out\\n                            else f\\\"[checks].probe exited {code} on the approved tree\\\"\\n                            if code != 0 else None)\\n        else:\\n            preflight = subprocess.run(checks_command, shell=True, cwd=str(root),\\n                                       capture_output=True, text=True, check=False)\\n            code, out, err = preflight.returncode, preflight.stdout, preflight.stderr\\n            refusal_text = (\\\"[checks].command exited 2 on the approved tree\\\" if code == 2 else None)\\n        if refusal_text:\\n            append_event(events_path, \\\"gate\\\", f\\\"this machine cannot run the checks: {refusal_text}\\\")\\n            log = out + err\\n            detail = _log_last_line(out + \\\"\\\\n\\\" + err) or refusal_text\\n            record = {\\n                \\\"sha\\\": start_sha,\\n                \\\"start_sha\\\": start_sha,\\n                \\\"spec_sha\\\": spec_sha,\\n                \\\"approval_sha\\\": latest_approval.get(\\\"sha\\\") if latest_approval else None,\\n                \\\"at\\\": now_iso(),\\n                \\\"adapter\\\": adapter_name,\\n                \\\"adapter_config\\\": adapter_config,\\n                \\\"executor_identity\\\": identity,\\n                \\\"reports\\\": reports,\\n                \\\"adapter_version\\\": None,\\n                \\\"model\\\": None,\\n                \\\"model_version\\\": None,\\n                \\\"iterations\\\": 1,\\n                \\\"criteria\\\": [],\\n                \\\"selected_tests\\\": None,\\n                \\\"checks\\\": {\\\"command\\\": asked, \\\"exit\\\": code},\\n                \\\"tokens\\\": {\\\"input\\\": 0, \\\"output\\\": 0},\\n                \\\"cost_usd\\\": None,\\n                \\\"wall_clock_s\\\": round(time.monotonic() - started, 3),\\n                \\\"status\\\": \\\"refused\\\",\\n                \\\"refusal\\\": refusal_text,\\n                \\\"halted\\\": None,\\n                \\\"retry_of\\\": None,\\n                \\\"steer\\\": None,\\n                # R3: environment is never retried by this item (recorded\\n                # here, acted on by R4's breaker) -- signed anyway for\\n                # the exhaustion report's own side-by-side, on the\\n                # remote chance a person retries by hand.\\n                \\\"stop\\\": {\\\"class\\\": \\\"environment\\\", \\\"provenance\\\": \\\"tenant\\\", \\\"detail\\\": detail,\\n                        \\\"signature\\\": signature_of(detail), \\\"bound\\\": None},\\n            }\\n            record_path = write_record(item_records_dir, \\\"build\\\", record, m, item_id,\\n                                       log=log or refusal_text + \\\"\\\\n\\\")\\n            print(f\\\"attavo build: refused ({record_path.name})\\\")\\n            return 1\\n        append_event(events_path, \\\"gate\\\", \\\"this machine can run the checks\\\")\\n\\n    adapter_version = model = model_version = None\\n    tokens = {\\\"input\\\": 0, \\\"output\\\": 0}\\n    cost_usd = None\\n    transcripts: list[str] = []\\n    criteria_results: list[dict[str, Any]] = []\\n    selected_tests: dict[str, Any] | None = None\\n    checks_result: dict[str, Any] | None = None\\n    status_out = \\\"failed\\\"\\n    refusal = None\\n    refusal_provenance = None\\n    halted = None\\n    iterations_used = 0\\n\\n    with tempfile.TemporaryDirectory() as tmp:\\n        feedback_path = Path(tmp) / \\\"feedback.txt\\\"\\n        feedback_path.write_text(\\\"\\\")\\n        # R3: a retried attempt's first iteration starts with the prior\\n        # attempt's class and signature, its evidence, and the newest\\n        # steer newer than the blocking record -- the one file the\\n        # contract already passes, no new adapter input at all.\\n        retry_of, steer, seed = _retry_seed(root, m, item_records_dir)\\n        if seed:\\n            feedback_path.write_text(seed)\\n\\n        for iteration in range(1, BUILD_ITERATION_BUDGET + 1):\\n            iterations_used = iteration\\n            append_event(events_path, \\\"iteration\\\", f\\\"iteration {iteration} of {BUILD_ITERATION_BUDGET}\\\")\\n            env = dict(os.environ)\\n            # #212 retired the checks command reaching the executor; an\\n            # ATTAVO_CHECKS_COMMAND exported by whoever launched `attavo\\n            # build` must not reach it by inheritance either.\\n            env.pop(\\\"ATTAVO_CHECKS_COMMAND\\\", None)\\n            env[\\\"ATTAVO_SPEC_DIR\\\"] = str(spec_dir)\\n            env[\\\"ATTAVO_RECORDS_DIR\\\"] = str(item_records_dir)\\n            env[\\\"ATTAVO_RULINGS\\\"] = str(root / m[\\\"paths\\\"][\\\"rulings\\\"])\\n            env[\\\"ATTAVO_BRANCH\\\"] = branch\\n            env[\\\"ATTAVO_ITERATION\\\"] = str(iteration)\\n            env[\\\"ATTAVO_FEEDBACK\\\"] = str(feedback_path)\\n            env[\\\"ATTAVO_ADAPTER_CONFIG\\\"] = json.dumps(adapter_config)\\n            env[\\\"ATTAVO_STAGE\\\"] = \\\"build\\\"\\n            env[\\\"ATTAVO_EVENTS\\\"] = str(events_path)\\n            env[\\\"ATTAVO_TEST_COMMAND\\\"] = f\\\"python3 {PRODUCT_ROOT / 'bin' / 'attavo'} test {item_id}\\\"\\n            if tests_cfg.get(\\\"call_timeout_s\\\"):\\n                env[\\\"ATTAVO_TEST_TIMEOUT_S\\\"] = str(tests_cfg[\\\"call_timeout_s\\\"])\\n            else:\\n                env.pop(\\\"ATTAVO_TEST_TIMEOUT_S\\\", None)\\n            env[\\\"GIT_AUTHOR_NAME\\\"] = identity[\\\"name\\\"]\\n            env[\\\"GIT_AUTHOR_EMAIL\\\"] = identity[\\\"email\\\"]\\n            env[\\\"GIT_COMMITTER_NAME\\\"] = identity[\\\"name\\\"]\\n            env[\\\"GIT_COMMITTER_EMAIL\\\"] = identity[\\\"email\\\"]\\n\\n            run = subprocess.run([str(adapter_path)], cwd=str(root), env=env,\\n                                 capture_output=True, text=True, check=False)\\n            transcript, payload = split_adapter_stdout(run.stdout)\\n            if run.returncode != 0:\\n                # The guarantee behind issue #53's refusal: an adapter that\\n                # exits non-zero always leaves a non-empty log, even one\\n                # that printed nothing at all on stderr.\\n                detail = f\\\"[adapter exited {run.returncode}]\\\"\\n                if run.stderr.strip():\\n                    detail += \\\"\\\\n\\\" + run.stderr.rstrip(\\\"\\\\n\\\")\\n                transcript = (transcript + \\\"\\\\n\\\" if transcript else \\\"\\\") + detail\\n            transcripts.append(transcript)\\n\\n            if run.returncode != 0 or payload is None or not payload.get(\\\"model\\\"):\\n                status_out = \\\"failed\\\"\\n                break\\n\\n            adapter_version = payload.get(\\\"adapter_version\\\")\\n            model = payload.get(\\\"model\\\")\\n            model_version = payload.get(\\\"model_version\\\")\\n            tok = payload.get(\\\"tokens\\\") or {}\\n            tokens[\\\"input\\\"] += tok.get(\\\"input\\\", 0) or 0\\n            tokens[\\\"output\\\"] += tok.get(\\\"output\\\", 0) or 0\\n            iter_cost = payload.get(\\\"cost_usd\\\")\\n            if iter_cost is not None:\\n                cost_usd = (cost_usd or 0) + iter_cost\\n\\n            if payload.get(\\\"status\\\") == \\\"question\\\":\\n                status_out = \\\"halted\\\"\\n                halted = {\\\"question\\\": payload.get(\\\"question\\\")}\\n                break\\n\\n            foreign = next((c for c in commits_since(root, start_sha)\\n                           if c[\\\"name\\\"] != identity[\\\"name\\\"] or c[\\\"email\\\"] != identity[\\\"email\\\"]),\\n                          None)\\n            if foreign:\\n                status_out = \\\"refused\\\"\\n                refusal = f\\\"commit {foreign['sha']} not authored by the executor\\\"\\n                break\\n\\n            protected = protected_path_touched(root, start_sha, records_rel, specs_rel)\\n            if protected:\\n                status_out = \\\"refused\\\"\\n                refusal = protected\\n                refusal_provenance = \\\"executor\\\"\\n                break\\n\\n            touched = sorted(changed_paths(root, start_sha, records_rel))\\n            bad_path = next((p for p in touched if not matches_a_claim(p, claims)), None)\\n            if bad_path:\\n                status_out = \\\"refused\\\"\\n                refusal = bad_path\\n                break\\n\\n            criteria_results = [\\n                {\\\"name\\\": name, \\\"exit\\\": run_criterion(spec_dir / \\\"criteria\\\" / name, root)}\\n                for name in criteria_names]\\n            for c in criteria_results:\\n                append_event(events_path, \\\"gate\\\", f\\\"{c['name']}: exit {c['exit']}\\\")\\n\\n            select_in = \\\"\\\".join(p + \\\"\\\\n\\\" for p in touched)\\n            select_run = subprocess.run(tests_cfg[\\\"select\\\"], shell=True, cwd=str(root),\\n                                        input=select_in, capture_output=True,\\n                                        text=True, check=False)\\n            identifiers = [l for l in select_run.stdout.splitlines() if l.strip()]\\n            run_in = \\\"\\\".join(i + \\\"\\\\n\\\" for i in identifiers)\\n            test_run = subprocess.run(tests_cfg[\\\"run\\\"], shell=True, cwd=str(root),\\n                                      input=run_in, capture_output=True,\\n                                      text=True, check=False)\\n            selected_tests = {\\\"select\\\": tests_cfg[\\\"select\\\"], \\\"run\\\": tests_cfg[\\\"run\\\"],\\n                              \\\"count\\\": len(identifiers), \\\"exit\\\": test_run.returncode}\\n\\n            checks_run = None\\n            if checks_command:\\n                checks_run = subprocess.run(checks_command, shell=True, cwd=str(root),\\n                                            capture_output=True, text=True, check=False)\\n                checks_result = {\\\"command\\\": checks_command, \\\"exit\\\": checks_run.returncode}\\n\\n            # Issue #89, rejection test 1: the gate output that decides pass\\n            # or fail is appended to the build log itself, under a heading\\n            # per iteration, before this temporary directory goes away --\\n            # tenant zero's #576 build-11 and #659 build-01 are a failed\\n            # record with nothing beside it to say what was red, because\\n            # this output previously lived only in feedback.txt, in a\\n            # tempfile.TemporaryDirectory() cmd_build deletes on return.\\n            gate_lines = [f\\\"criterion {c['name']}: exit {c['exit']}\\\" for c in criteria_results]\\n            gate_lines.append(f\\\"selected tests ({selected_tests['count']}): exit \\\"\\n                              f\\\"{selected_tests['exit']}\\\")\\n            if test_run.stdout.strip():\\n                gate_lines += [\\\"--- selected tests stdout ---\\\", test_run.stdout.rstrip(\\\"\\\\n\\\")]\\n            if test_run.stderr.strip():\\n                gate_lines += [\\\"--- selected tests stderr ---\\\", test_run.stderr.rstrip(\\\"\\\\n\\\")]\\n            if checks_run is not None:\\n                tail = (checks_run.stdout.splitlines() + checks_run.stderr.splitlines())\\n                tail = tail[-CHECKS_FEEDBACK_TAIL_LINES:]\\n                gate_lines.append(f\\\"tenant checks: exit {checks_run.returncode}\\\")\\n                gate_lines += [\\\"--- checks output (tail) ---\\\", *tail]\\n            transcripts[-1] += (f\\\"\\\\n--- attavo gates, iteration {iteration} ---\\\\n\\\"\\n                               + \\\"\\\\n\\\".join(gate_lines))\\n\\n            failing = [c for c in criteria_results if c[\\\"exit\\\"] != 0]\\n            checks_ok = checks_run is None or checks_run.returncode == 0\\n            if not failing and test_run.returncode == 0 and checks_ok:\\n                status_out = \\\"pass\\\"\\n                break\\n\\n            if iteration == BUILD_ITERATION_BUDGET:\\n                status_out = \\\"failed\\\"\\n                break\\n\\n            feedback_lines = []\\n            if failing:\\n                feedback_lines.append(\\\"criteria failing:\\\")\\n                feedback_lines += [f\\\"- {c['name']}: exit {c['exit']}\\\" for c in failing]\\n            if test_run\n... 563023 bytes omitted ...\nown process, in every ../attavo-worktree-N\\n    beside this checkout -- each one derives its own item from its own\\n    attavo/N-* branch. Every line either prints is prefixed with the\\n    worktree's own directory name, so an operator reading them together\\n    can tell which item each line is about.\\\"\\\"\\\"\\n    root = Path(\\\".\\\").resolve()\\n    siblings = sorted(p for p in root.parent.glob(\\\"attavo-worktree-*\\\") if p.is_dir())\\n    if not siblings:\\n        print(\\\"attavo drive: --all found no ../attavo-worktree-N beside this checkout\\\")\\n        return 0\\n    worst = 0\\n    for copy in siblings:\\n        run = subprocess.run([sys.executable, str(PRODUCT_ROOT / \\\"bin\\\" / \\\"attavo\\\"), \\\"drive\\\"],\\n                             cwd=str(copy), capture_output=True, text=True, check=False)\\n        for line in (run.stdout + run.stderr).splitlines():\\n            print(f\\\"{copy.name}: {line}\\\")\\n        worst = max(worst, run.returncode)\\n    return worst\\n\\n\\ndef cmd_drive(argv: list[str]) -> int:\\n    # Issue #145: Python block-buffers stdout when it is not a tty (a\\n    # pipe, e.g. a screen reading this process live), so every line this\\n    # prints would otherwise sit unflushed until the process exits.\\n    # Line-buffering makes a pipe reader see each line the moment it is\\n    # printed, the same as a terminal already does; `attavo worker`\\n    # reconfigures its own stdout the same way.\\n    cast(io.TextIOWrapper, sys.stdout).reconfigure(line_buffering=True)\\n\\n    if \\\"--recover\\\" in argv:\\n        print(\\\"attavo drive: --recover is gone; a pass recovers a dead or hung invocation \\\"\\n              \\\"itself, as soon as the report owes one\\\", file=sys.stderr)\\n        return 2\\n\\n    until_ready = \\\"--until-ready\\\" in argv\\n    report = \\\"--report\\\" in argv\\n    again = \\\"--again\\\" in argv\\n    all_flag = \\\"--all\\\" in argv\\n    positional = [a for a in argv if not a.startswith(\\\"--\\\")]\\n\\n    if all_flag:\\n        if until_ready or report or again or positional:\\n            print(\\\"attavo drive: --all runs one pass in every worktree beside this checkout; \\\"\\n                  \\\"drop N and every other flag\\\", file=sys.stderr)\\n            return 2\\n        return _drive_all()\\n\\n    root = Path(\\\".\\\").resolve()\\n    item_id = positional[0] if positional else derive_item_id(root)\\n    if not item_id:\\n        print(\\\"attavo drive: cannot derive item id; pass N or run on an attavo/N-* branch\\\",\\n              file=sys.stderr)\\n        return 2\\n    m = read_manifest(root)\\n    if m is None:\\n        print(f\\\"attavo drive: no {MANIFEST} at {root}\\\", file=sys.stderr)\\n        return 2\\n\\n    if report:\\n        if until_ready or again:\\n            print(\\\"attavo drive: --report reads and does nothing else; drop --until-ready \\\"\\n                  \\\"and --again\\\", file=sys.stderr)\\n            return 2\\n        fast_forward_to_origin(root, m, item_id)\\n        from attavo.report import drive_report\\n        print(json.dumps(drive_report(root, m, item_id), indent=2))\\n        return 0\\n\\n    if until_ready:\\n        return _until_ready(root, m, item_id, again)\\n    rc, _ = _pass_once(root, m, item_id, again)\\n    return rc\\n\",\"structuredPatch\":[{\"oldStart\":262,\"oldLines\":6,\"newStart\":262,\"newLines\":7,\"lines\":[\"     last_at: str | None\",\"     age: float | None\",\"     cls: str  # \\\"running\\\" | \\\"hung\\\" | \\\"died\\\"\",\"+    bound: str | None = None  # R3: \\\"stall\\\" or \\\"ceiling\\\" when cls is \\\"hung\\\"\",\" \",\" \",\" def read_invocation(root: Path, bound: int | None, marker: Path, info: dict[str, Any]) -> InvocationReading:\"]}],\"userModified\":false,\"replaceAll\":false}}\n2312:+{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_017rcexzSN7FGXH1tcjL3tZM\",\"type\":\"tool_result\",\"content\":\"The file /Users/davidbean/Projects/attavo-worktree-219/attavo/drive.py has been updated successfully. (file state is current in your context — no need to Read it back)\"}]},\"parent_tool_use_id\":null,\"session_id\":\"0dd7ed4f-100c-4188-9a34-077aa0b6aa25\",\"uuid\":\"0fa0ccc4-c810-4da8-a185-253cd4ee7498\",\"timestamp\":\"2026-09-26T02:26:24.963Z\",\"tool_use_result\":{\"filePath\":\"/Users/davidbean/Projects/attavo-worktree-219/attavo/drive.py\",\"oldString\":\"    stage, nn_text = marker.stem.rsplit(\\\"-\\\", 1)\\n    nn = int(nn_text)\\n    log, last_at = _events_tail(_events_path_for(root, stage, nn))\\n    beat = heartbeat_path(root, stage, nn)\\n    if beat.is_file():\\n        try:\\n            beat_age = time.time() - beat.stat().st_mtime\\n        except OSError:\\n            beat_age = None\\n        cls = \\\"running\\\" if beat_age is not None and beat_age <= heartbeat_s() * 3 else \\\"died\\\"\\n        return InvocationReading(stage, nn, log, last_at, beat_age, cls)\\n    age = _seconds_since(last_at or info.get(\\\"at\\\"))\\n    if not invocation_alive(info):\\n        return InvocationReading(stage, nn, log, last_at, age, \\\"died\\\")\\n    if bound is None or age is None or age <= bound:\\n        return InvocationReading(stage, nn, log, last_at, age, \\\"running\\\")\\n    return InvocationReading(stage, nn, log, last_at, age, \\\"hung\\\")\",\"newString\":\"    stage, nn_text = marker.stem.rsplit(\\\"-\\\", 1)\\n    nn = int(nn_text)\\n    log, last_at = _events_tail(_events_path_for(root, stage, nn))\\n    # R3: the stage ceiling, wall clock from the marker's own `at`, judged\\n    # before any liveness signal -- alive past it is hung by the ceiling,\\n    # whatever its event age (or absence of one) says.\\n    m = read_manifest(root) or {}\\n    ceiling = ceiling_s(m, stage)\\n    since_start = _seconds_since(info.get(\\\"at\\\"))\\n    if ceiling is not None and since_start is not None and since_start > ceiling:\\n        return InvocationReading(stage, nn, log, last_at, since_start, \\\"hung\\\", \\\"ceiling\\\")\\n    if not _streams_events(root, m, stage):\\n        # An adapter that declares it streams no events is judged by the\\n        # ceiling alone; the stall bound it can never trip is not asked.\\n        bound = None\\n    beat = heartbeat_path(root, stage, nn)\\n    if beat.is_file():\\n        try:\\n            beat_age = time.time() - beat.stat().st_mtime\\n        except OSError:\\n            beat_age = None\\n        cls = \\\"running\\\" if beat_age is not None and beat_age <= heartbeat_s() * 3 else \\\"died\\\"\\n        return InvocationReading(stage, nn, log, last_at, beat_age, cls)\\n    age = _seconds_since(last_at or info.get(\\\"at\\\"))\\n    if not invocation_alive(info):\\n        return InvocationReading(stage, nn, log, last_at, age, \\\"died\\\")\\n    if bound is None or age is None or age <= bound:\\n        return InvocationReading(stage, nn, log, last_at, age, \\\"running\\\")\\n    return InvocationReading(stage, nn, log, last_at, age, \\\"hung\\\", \\\"stall\\\")\\n\\n\\ndef _streams_events(root: Path, m: dict[str, Any], stage: str) -> bool:\\n    \\\"\\\"\\\"R3: whether the stage's adapter declares it streams events\\n    (adapters/<name>/conformance.json, \\\"streams_events\\\"); true when the\\n    adapter names none, or its conformance.json does not say.\\\"\\\"\\\"\\n    name = (m.get(\\\"executor\\\") or {}).get(stage) or (m.get(\\\"executor\\\") or {}).get(\\\"build\\\")\\n    if not name:\\n        return True\\n    for base in (root / \\\"attavo\\\" / \\\"adapters\\\", PRODUCT_ROOT / \\\"adapters\\\"):\\n        conf = base / name / \\\"conformance.json\\\"\\n        if conf.is_file():\\n            try:\\n                return bool(json.loads(conf.read_text()).get(\\\"streams_events\\\", True))\\n            except (OSError, ValueError):\\n                return True\\n    return True\",\"originalFile\":\"from __future__ import annotations\\n\\nimport io\\nimport json\\nimport os\\nimport signal\\nimport subprocess\\nimport sys\\nimport threading\\nimport time\\nfrom pathlib import Path\\nfrom typing import TYPE_CHECKING, Any, NamedTuple, cast\\n\\nfrom attavo.approval import approval_status\\nfrom attavo.build import cmd_build, driver_identity\\nfrom attavo.common import MANIFEST, PRODUCT_ROOT, derive_item_id, git, read_manifest\\nfrom attavo.counsel import cmd_counsel\\nfrom attavo.doctor import (\\n    _parse_json_line,\\n    attempts_budget,\\n    ceiling_s,\\n    invocation_alive,\\n    invocations_without_record,\\n    retry_after_s,\\n    stall_bound_s,\\n    write_invocation_marker,\\n)\\nfrom attavo.events import stage_events_dir\\nfrom attavo.filing import cmd_file_stops\\nfrom attavo.records import (\\n    latest_attempt_path,\\n    latest_record,\\n    next_attempt_number,\\n    parse_attempts,\\n    stage_schema,\\n    write_record,\\n)\\nfrom attavo.stops import RETRYABLE_CLASSES, counsel_record_for, signature_of, stage_exhausted\\nfrom attavo.verify import cmd_verify, read_forge_checks\\n\\nif TYPE_CHECKING:\\n    from attavo.types import DriveReport\\n\\n# --- drive: the mechanical transitions between approval and ready-to-merge\\n# (issue #84), under the reconciler's R2 (rulings A, B, C's recovery half,\\n# F, G, H): `attavo drive N` is one short pass. It reads the report\\n# (attavo.report), acts at most once -- recovers a dead or hung\\n# invocation, or starts the next stage in a detached worker -- and\\n# returns within seconds; the stage itself runs in `attavo worker`, a\\n# child of the pass's own session, which outlives it. Writes no record of\\n# its own: the stage records already on disk, and the invocation markers\\n# and heartbeats beside them, are the only state a pass or a worker\\n# reads. ---\\n\\n\\ndef commit_record(root: Path, record_paths: Path | list[Path], message: str) -> None:\\n    \\\"\\\"\\\"`git commit --only` on every record path given, and each one's .log\\n    and .filed, each if one exists -- never the whole index. A transport\\n    commit that sweeps the index is exactly the regression issue #46\\n    already guards build and verify against on the adapter side; drive\\n    must not reintroduce it on the transport side. The .filed marker\\n    (issue #89) is committed alongside the record it names, in the same\\n    commit and the same push, so a second worktree or a fresh clone reads\\n    the same filed fact rather than refiling every stop it finds with no\\n    marker of its own. A single Path is accepted for the common one-record\\n    case; issue #100 passes a list so the counsel record lands in the same\\n    commit as the stage record it counsels. Authored and committed as\\n    driver_identity(), set by the product and never the tenant's git\\n    config, so a driven item's record commits are never indistinguishable\\n    from an operator's own.\\\"\\\"\\\"\\n    if isinstance(record_paths, Path):\\n        record_paths = [record_paths]\\n    paths: list[str] = []\\n    for record_path in record_paths:\\n        paths.append(str(record_path.relative_to(root)))\\n        log_path = record_path.with_suffix(\\\".log\\\")\\n        if log_path.is_file():\\n            paths.append(str(log_path.relative_to(root)))\\n        marker_path = record_path.with_suffix(\\\".filed\\\")\\n        if marker_path.is_file():\\n            paths.append(str(marker_path.relative_to(root)))\\n    identity = driver_identity()\\n    env = dict(os.environ)\\n    env[\\\"GIT_AUTHOR_NAME\\\"] = identity[\\\"name\\\"]\\n    env[\\\"GIT_AUTHOR_EMAIL\\\"] = identity[\\\"email\\\"]\\n    env[\\\"GIT_COMMITTER_NAME\\\"] = identity[\\\"name\\\"]\\n    env[\\\"GIT_COMMITTER_EMAIL\\\"] = identity[\\\"email\\\"]\\n    git(root, \\\"add\\\", *paths)\\n    git(root, \\\"commit\\\", \\\"--only\\\", \\\"-m\\\", message, *paths, env=env)\\n\\n\\ndef push_record_commit(root: Path, branch: str) -> tuple[bool, str | None]:\\n    \\\"\\\"\\\"Push HEAD to branch on origin. A push a divergent remote rejects is\\n    retried once after `git pull --no-rebase --no-edit origin branch` -- a\\n    merge, never a rebase, because a rebase would change the sha the record\\n    commit just wrote already names. This is the record push's own retry\\n    -- the worker's, once it has the lease -- distinct from push_lease\\n    below, which never retries.\\\"\\\"\\\"\\n    def attempt() -> tuple[bool, str]:\\n        run = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"push\\\", \\\"origin\\\", f\\\"HEAD:{branch}\\\"],\\n                             capture_output=True, text=True, check=False)\\n        return run.returncode == 0, run.stderr.strip()\\n\\n    ok, err = attempt()\\n    if ok:\\n        return True, None\\n    pull = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"pull\\\", \\\"--no-rebase\\\", \\\"--no-edit\\\",\\n                           \\\"origin\\\", branch], capture_output=True, text=True, check=False)\\n    if pull.returncode != 0:\\n        return False, f\\\"push rejected and the retry merge failed: {pull.stderr.strip() or err}\\\"\\n    ok, err = attempt()\\n    if not ok:\\n        return False, f\\\"push rejected again after merging {branch}: {err}\\\"\\n    return True, None\\n\\n\\n_RACE_MARKERS = (\\\"non-fast-forward\\\", \\\"fetch first\\\", \\\"stale info\\\", \\\"cannot lock ref\\\",\\n                 \\\"failed to update ref\\\")\\n\\n\\ndef push_lease(root: Path, branch: str) -> tuple[str, str | None]:\\n    \\\"\\\"\\\"Push HEAD to branch on origin as a plain fast-forward -- no merge,\\n    no retry: this is the lease the marker commit takes on the attempt it\\n    names (ruling A). (\\\"pushed\\\", None) on success.\\n\\n    (\\\"lost-race\\\", stderr) when git's own ref check is what rejected it --\\n    the branch moved since this pass fast-forwarded to it (a sequential\\n    \\\"[rejected] ... (fetch first)\\\"), or the remote's own ref transaction\\n    lost a genuine simultaneous push (\\\"[remote rejected] ... (failed to\\n    update ref)\\\", \\\"cannot lock ref\\\"): either way, another pass's own\\n    marker (or record) landed there first. The pass that reads this is\\n    the loser: it says so, resets its own marker commit, and starts\\n    nothing.\\n\\n    (\\\"refused\\\", stderr) for every other rejection -- a remote that\\n    refuses the push outright (a hook, a permission, an unreachable\\n    remote). This is not a race for the lease; it is a refusal, and ends\\n    the pass with exit 1.\\\"\\\"\\\"\\n    run = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"push\\\", \\\"origin\\\", f\\\"HEAD:{branch}\\\"],\\n                         capture_output=True, text=True, check=False)\\n    if run.returncode == 0:\\n        return \\\"pushed\\\", None\\n    stderr = run.stderr\\n    if any(marker in stderr for marker in _RACE_MARKERS):\\n        return \\\"lost-race\\\", stderr.strip()\\n    return \\\"refused\\\", stderr.strip()\\n\\n\\ndef has_origin(root: Path) -> bool:\\n    \\\"\\\"\\\"Whether this checkout carries an origin remote at all -- a fixture\\n    or a scratch checkout with none is not a refusal; a pass commits\\n    locally and skips the push, the way recovery always has.\\\"\\\"\\\"\\n    try:\\n        git(root, \\\"remote\\\", \\\"get-url\\\", \\\"origin\\\")\\n        return True\\n    except RuntimeError:\\n        return False\\n\\n\\ndef drive_state(root: Path, m: dict[str, Any], item_id: str) -> tuple[str, str | None, Path]:\\n    \\\"\\\"\\\"(\\\"no-approval\\\" | \\\"build\\\" | \\\"verify\\\" | \\\"ready\\\", detail, records_dir):\\n    the next mechanical step for item_id, read from its latest records\\n    alone. A build only counts as current when it is a pass bound to the\\n    valid approval's own sha; a verify only counts as current when it is a\\n    pass bound to that build's own sha -- the same staleness a re-approval\\n    or a re-build must force, attest's own chain check already enforces\\n    (check_attest_chain), read here rather than re-typed.\\\"\\\"\\\"\\n    records_rel = m[\\\"paths\\\"][\\\"records\\\"]\\n    records_dir = root / records_rel / item_id\\n\\n    status = approval_status(root, m, item_id)\\n    if status != \\\"valid\\\":\\n        return \\\"no-approval\\\", status, records_dir\\n\\n    latest_approval = latest_record(records_dir, \\\"approval\\\")\\n    latest_build = latest_record(records_dir, \\\"build\\\")\\n    build_current = (latest_build is not None and latest_build.get(\\\"status\\\") == \\\"pass\\\"\\n                     and latest_build.get(\\\"approval_sha\\\")\\n                     == (latest_approval.get(\\\"sha\\\") if latest_approval else None))\\n    if latest_build is None or not build_current:\\n        return \\\"build\\\", None, records_dir\\n\\n    latest_verify = latest_record(records_dir, \\\"verify\\\")\\n    verify_current = (latest_verify is not None and latest_verify.get(\\\"status\\\") == \\\"pass\\\"\\n                      and latest_verify.get(\\\"build_sha\\\") == latest_build.get(\\\"sha\\\"))\\n    if not verify_current:\\n        return \\\"verify\\\", None, records_dir\\n\\n    return \\\"ready\\\", None, records_dir\\n\\n\\n# --- the heartbeat, the worker log, and the forge-checks handoff: local\\n# facts under the checkout's own git directory (issue #140's precedent),\\n# never committed and never among the paths commit_record ever names. ---\\n\\ndef heartbeat_s() -> float:\\n    return float(os.environ.get(\\\"ATTAVO_HEARTBEAT_S\\\", 15))\\n\\n\\ndef heartbeat_path(root: Path, stage: str, nn: int) -> Path:\\n    return stage_events_dir(root) / f\\\"{stage}-{nn:02d}.heartbeat\\\"\\n\\n\\ndef worker_log_path(root: Path, stage: str, nn: int) -> Path:\\n    return stage_events_dir(root) / f\\\"{stage}-{nn:02d}.worker.log\\\"\\n\\n\\ndef forge_checks_path(root: Path, stage: str, nn: int) -> Path:\\n    return stage_events_dir(root) / f\\\"{stage}-{nn:02d}.forge-checks.json\\\"\\n\\n\\ndef _events_path_for(root: Path, stage: str, nn: int) -> Path | None:\\n    \\\"\\\"\\\"The adapter's own events file for this invocation, under the\\n    checkout's git dir (a worktree's own dir when the checkout is one).\\\"\\\"\\\"\\n    try:\\n        gitdir = Path(git(root, \\\"rev-parse\\\", \\\"--git-dir\\\").strip())\\n    except RuntimeError:\\n        return None\\n    if not gitdir.is_absolute():\\n        gitdir = root / gitdir\\n    path = gitdir / \\\"attavo\\\" / f\\\"{stage}-{nn:02d}.events.jsonl\\\"\\n    return path if path.is_file() else None\\n\\n\\ndef _events_tail(path: Path | None, lines: int = 20) -> tuple[str, str | None]:\\n    \\\"\\\"\\\"(the last lines as a log, the last event's own at).\\\"\\\"\\\"\\n    if path is None:\\n        return \\\"no events file for this invocation\\\\n\\\", None\\n    try:\\n        text = path.read_text()\\n    except OSError:\\n        return \\\"events file unreadable\\\\n\\\", None\\n    tail = text.splitlines()[-lines:]\\n    last_at = None\\n    for line in reversed(tail):\\n        parsed = _parse_json_line(line)\\n        if not isinstance(parsed, dict):\\n            continue\\n        at = parsed.get(\\\"at\\\")\\n        if isinstance(at, str):\\n            last_at = at\\n            break\\n    return \\\"\\\\n\\\".join(tail) + \\\"\\\\n\\\", last_at\\n\\n\\ndef _seconds_since(at: str | None) -> float | None:\\n    from datetime import datetime, timezone\\n    if not at:\\n        return None\\n    try:\\n        then = datetime.strptime(at, \\\"%Y-%m-%dT%H:%M:%SZ\\\").replace(tzinfo=timezone.utc)\\n    except ValueError:\\n        return None\\n    return (datetime.now(timezone.utc) - then).total_seconds()\\n\\n\\nclass InvocationReading(NamedTuple):\\n    \\\"\\\"\\\"What one marker with no record reads as, from here and now.\\\"\\\"\\\"\\n    stage: str\\n    nn: int\\n    log: str\\n    last_at: str | None\\n    age: float | None\\n    cls: str  # \\\"running\\\" | \\\"hung\\\" | \\\"died\\\"\\n    bound: str | None = None  # R3: \\\"stall\\\" or \\\"ceiling\\\" when cls is \\\"hung\\\"\\n\\n\\ndef read_invocation(root: Path, bound: int | None, marker: Path, info: dict[str, Any]) -> InvocationReading:\\n    \\\"\\\"\\\"Whether an invocation that began and wrote no record is running,\\n    hung, or died -- read from its own heartbeat first (R2): a heartbeat\\n    file fresh within three beats of ATTAVO_HEARTBEAT_S is alive; a stale\\n    one is died, whether or not the pid still lives -- a worker stuck\\n    somewhere that never reaches its own heartbeat loop again is exactly\\n    what this is for. Only with no heartbeat file at all -- an invocation\\n    from before this release, or one that died before touching its\\n    first beat -- does this fall back to the pid: alive and, with a\\n    stall bound declared, past it is hung; alive with no bound, or\\n    within it, is running for as long as it lives; not alive is died.\\n    The stall bound decides hung, never died.\\\"\\\"\\\"\\n    stage, nn_text = marker.stem.rsplit(\\\"-\\\", 1)\\n    nn = int(nn_text)\\n    log, last_at = _events_tail(_events_path_for(root, stage, nn))\\n    beat = heartbeat_path(root, stage, nn)\\n    if beat.is_file():\\n        try:\\n            beat_age = time.time() - beat.stat().st_mtime\\n        except OSError:\\n            beat_age = None\\n        cls = \\\"running\\\" if beat_age is not None and beat_age <= heartbeat_s() * 3 else \\\"died\\\"\\n        return InvocationReading(stage, nn, log, last_at, beat_age, cls)\\n    age = _seconds_since(last_at or info.get(\\\"at\\\"))\\n    if not invocation_alive(info):\\n        return InvocationReading(stage, nn, log, last_at, age, \\\"died\\\")\\n    if bound is None or age is None or age <= bound:\\n        return InvocationReading(stage, nn, log, last_at, age, \\\"running\\\")\\n    return InvocationReading(stage, nn, log, last_at, age, \\\"hung\\\")\\n\\n\\ndef uncommitted_record(root: Path, records_dir: Path, stage: str) -> Path | None:\\n    \\\"\\\"\\\"The latest <stage>-NN.json this working tree carries that git has\\n    no commit for yet -- the moment between a worker's write and its own\\n    commit. None when the latest record is already committed, or there\\n    is none at all.\\\"\\\"\\\"\\n    path = latest_attempt_path(records_dir, stage)\\n    if path is None or not path.is_file():\\n        return None\\n    status = subprocess.run(\\n        [\\\"git\\\", \\\"-C\\\", str(root), \\\"status\\\", \\\"--porcelain\\\", \\\"--\\\", str(path.relative_to(root))],\\n        capture_output=True, text=True, check=False)\\n    return path if status.stdout.strip() else None\\n\\n\\ndef worker_holds_copy(root: Path, records_dir: Path) -> bool:\\n    \\\"\\\"\\\"True when this checkout's own working tree cannot safely be moved\\n    -- an invocation marker with no record yet (a worker, here or\\n    elsewhere, still holds this attempt), or a build or verify record the\\n    working tree carries that git has not committed yet. Scoped to the\\n    stage records a pass or a worker itself ever transports -- an\\n    operator's own spec-gate or approve, routinely uncommitted between\\n    their own act and the next pass, is not this. A pass never\\n    fast-forwards while this holds (never while a worker holds the\\n    copy).\\\"\\\"\\\"\\n    if invocations_without_record(records_dir):\\n        return True\\n    return (uncommitted_record(root, records_dir, \\\"build\\\") is not None\\n           or uncommitted_record(root, records_dir, \\\"verify\\\") is not None)\\n\\n\\ndef fast_forward_to_origin(root: Path, m: dict[str, Any], item_id: str) -> None:\\n    \\\"\\\"\\\"The pass's own read of origin's branch, taken before it reads\\n    anything else -- a commit landed there from elsewhere (an approval\\n    from the screen, a ruling, another pass's own record) is not a race\\n    for the lease, it is exactly what the lease is for. Never while a\\n    worker holds this copy (worker_holds_copy): resetting a working tree\\n    a detached child is still writing into would corrupt its own commits.\\n    A plain fast-forward when origin is simply ahead; when this checkout\\n    also carries its own commits origin has not seen yet (an operator's\\n    approval, not yet pushed), those are replayed on top of origin's own\\n    tip instead -- no merge commit, and the marker this pass is about to\\n    write still lands as a fast-forward when it pushes. Silent about\\n    everything short of that -- a real conflict, or an absent origin, is\\n    left for the ordinary read (and the marker push, for the lease) to\\n    sort out.\\\"\\\"\\\"\\n    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n    if worker_holds_copy(root, records_dir) or not has_origin(root):\\n        return\\n    try:\\n        branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n        git(root, \\\"fetch\\\", \\\"origin\\\", branch)\\n    except RuntimeError:\\n        return\\n    try:\\n        git(root, \\\"merge\\\", \\\"--ff-only\\\", \\\"FETCH_HEAD\\\")\\n        return\\n    except RuntimeError:\\n        pass\\n    try:\\n        git(root, \\\"rebase\\\", \\\"FETCH_HEAD\\\")\\n    except RuntimeError:\\n        subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"rebase\\\", \\\"--abort\\\"],\\n                       capture_output=True, text=True, check=False)\\n\\n\\n# --- the worker: a detached child of the pass's own session, running the\\n# stage exactly as the pass used to inline, touching its own heartbeat\\n# while it does (R2). ---\\n\\ndef _stage_body(item_id: str, stage: str, nn: int) -> int:\\n    \\\"\\\"\\\"Runs build or verify in-process -- the same command `attavo build`\\n    or `attavo verify` would run -- while touching heartbeat_path every\\n    heartbeat_s() seconds, then transports whatever it wrote: counsel and\\n    file-stops on a non-pass record (issue #100, #89), one `git commit\\n    --only`, one push with the record push's own merge retry. The\\n    marker is the pass's, already committed and pushed before this\\n    starts; this writes and transports only the stage's own record (and,\\n    on a stop, its counsel record).\\\"\\\"\\\"\\n    root = Path(\\\".\\\").resolve()\\n    m = read_manifest(root)\\n    if m is None:\\n        return 2\\n    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n    before = latest_attempt_path(records_dir, stage)\\n\\n    beat = heartbeat_path(root, stage, nn)\\n    beat.parent.mkdir(parents=True, exist_ok=True)\\n    beat.touch()\\n    stop_beat = threading.Event()\\n\\n    def _tick() -> None:\\n        while not stop_beat.wait(heartbeat_s()):\\n            beat.touch()\\n\\n    beat_thread = threading.Thread(target=_tick, daemon=True)\\n    beat_thread.start()\\n    try:\\n        rc = cmd_build([item_id]) if stage == \\\"build\\\" else cmd_verify([item_id])\\n    finally:\\n        stop_beat.set()\\n        beat_thread.join()\\n\\n    after = latest_attempt_path(records_dir, stage)\\n    if after is None or after == before:\\n        # Refused before writing anything at all (e.g. no adapter\\n        # configured) -- the stage command already printed why.\\n        return rc if rc != 0 else 1\\n\\n    record = cast(dict[str, Any], latest_record(records_dir, stage))\\n    status_out = record.get(\\\"status\\\")\\n    to_commit = [after]\\n    if status_out != \\\"pass\\\":\\n        counsel_before = latest_attempt_path(records_dir, \\\"counsel\\\")\\n        cmd_counsel([item_id])\\n        counsel_after = latest_attempt_path(records_dir, \\\"counsel\\\")\\n        if counsel_after is not None and counsel_after != counsel_before:\\n            to_commit.append(counsel_after)\\n        # file-stops is its own idempotent read of the item's records, so\\n        # calling it here on every run that wrote a non-pass record is\\n        # safe to call again on a later run: an already-filed stop's own\\n        # marker is what stops it from being filed twice.\\n        cmd_file_stops([item_id])\\n\\n    message = f\\\"attavo: {stage} record for item {item_id} ({after.stem})\\\"\\n    try:\\n        commit_record(root, to_commit, message)\\n    except RuntimeError as exc:\\n        print(f\\\"attavo drive: stopped: could not commit the {stage} record: {exc}\\\")\\n        return 1\\n\\n    if has_origin(root):\\n        ok, err = push_record_commit(root, branch)\\n        if not ok:\\n            print(f\\\"attavo drive: stopped: could not push the {stage} record: {err}\\\")\\n            return 1\\n    else:\\n        print(f\\\"attavo drive: note: no origin remote; {after.name} is committed, not pushed\\\")\\n\\n    if status_out == \\\"halted\\\":\\n        question = (record.get(\\\"halted\\\") or {}).get(\\\"question\\\")\\n        print(f\\\"attavo drive: stopped: {stage} halted: {question} ({after.name}); \\\"\\n              f\\\"pushed to {branch}\\\")\\n    elif status_out != \\\"pass\\\":\\n        reason = record.get(\\\"refusal\\\") or status_out\\n        print(f\\\"attavo drive: stopped: {stage} {status_out}: {reason} ({after.name}); \\\"\\n              f\\\"pushed to {branch}\\\")\\n    else:\\n        print(f\\\"attavo drive: pushed {after.name} to {branch}\\\")\\n    return rc\\n\\n\\ndef cmd_worker(argv: list[str]) -> int:\\n    \\\"\\\"\\\"`attavo worker N <build|verify> NN`: the detached child a pass\\n    starts once its marker is pushed -- the lease held, the attempt is\\n    this worker's to run. Its own session (start_new_session, set by the\\n    pass that spawns it); its stdout and stderr are the pass's own\\n    redirect, to <git-dir>/attavo/<stage>-NN.worker.log.\\\"\\\"\\\"\\n    cast(io.TextIOWrapper, sys.stdout).reconfigure(line_buffering=True)\\n    if len(argv) != 3:\\n        print(\\\"attavo worker: usage: attavo worker N <build|verify> NN\\\", file=sys.stderr)\\n        return 2\\n    item_id, stage, nn_text = argv\\n    if stage not in (\\\"build\\\", \\\"verify\\\"):\\n        print(f\\\"attavo worker: {stage!r} is not build or verify\\\", file=sys.stderr)\\n        return 2\\n    try:\\n        nn = int(nn_text)\\n    except ValueError:\\n        print(f\\\"attavo worker: {nn_text!r} is not an attempt number\\\", file=sys.stderr)\\n        return 2\\n    return _stage_body(item_id, stage, nn)\\n\\n\\n# --- the pass's own two acts: start a stage (the lease), and recover\\n# exactly the one invocation the report names owed one. ---\\n\\ndef _start_stage(root: Path, m: dict[str, Any], item_id: str, stage: str,\\n                 forge_checks: dict[str, Any] | None) -> int:\\n    \\\"\\\"\\\"The lease (ruling A): the marker, committed and pushed as a plain\\n    fast-forward with no merge and no retry (push_lease). Lost to another\\n    pass, or refused outright by the remote, both undo the marker commit\\n    here (git reset --hard) so this checkout carries no half-taken\\n    attempt either way; only a pushed lease starts the worker. On a\\n    review, forge_checks is the checks this same pass already read on\\n    the pre-marker head (ruling B) -- written to\\n    <git-dir>/attavo/verify-NN.forge-checks.json and named in\\n    ATTAVO_FORGE_CHECKS, so the worker's own `attavo verify` reads it\\n    instead of polling.\\\"\\\"\\\"\\n    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n    nn = next_attempt_number(records_dir, stage)\\n    marker = write_invocation_marker(root, records_dir, stage, nn)\\n    try:\\n        commit_record(root, [marker], f\\\"attavo: {stage} invocation {nn:02d} started for item {item_id}\\\")\\n    except RuntimeError as exc:\\n        print(f\\\"attavo drive: stopped: could not commit the {stage} invocation marker: {exc}\\\")\\n        return 1\\n\\n    if has_origin(root):\\n        outcome, err = push_lease(root, branch)\\n        if outcome != \\\"pushed\\\":\\n            git(root, \\\"reset\\\", \\\"--hard\\\", \\\"HEAD^\\\")\\n            if outcome == \\\"lost-race\\\":\\n                print(f\\\"attavo drive: another pass holds this attempt ({marker.name}); nothing started\\\")\\n                return 0\\n            print(f\\\"attavo drive: stopped: could not push the {stage} invocation marker: {err}\\\")\\n            return 1\\n\\n    env = dict(os.environ)\\n    if forge_checks is not None:\\n        checks_file = forge_checks_path(root, stage, nn)\\n        checks_file.write_text(json.dumps(forge_checks))\\n        env[\\\"ATTAVO_FORGE_CHECKS\\\"] = str(checks_file)\\n    log = worker_log_path(root, stage, nn)\\n    with log.open(\\\"ab\\\") as fh, open(os.devnull, \\\"rb\\\") as devnull:\\n        proc = subprocess.Popen(\\n            [sys.executable, str(PRODUCT_ROOT / \\\"bin\\\" / \\\"attavo\\\"), \\\"worker\\\", item_id, stage, f\\\"{nn:02d}\\\"],\\n            cwd=str(root), env=env, stdin=devnull, stdout=fh, stderr=subprocess.STDOUT,\\n            start_new_session=True)\\n    word = \\\"Build\\\" if stage == \\\"build\\\" else \\\"Review\\\"\\n    print(f\\\"attavo drive: {word} started (attempt {nn:02d}, worker pid {proc.pid})\\\")\\n    return 0\\n\\n\\ndef _recover_one(root: Path, m: dict[str, Any], item_id: str, records_dir: Path) -> int:\\n    \\\"\\\"\\\"The pass's own recovery act (what `--recover` did): exactly the one\\n    invocation the report just read as owing one -- died or hung -- ends\\n    here. class died when the heartbeat is stale (or absent and the pid\\n    is gone), class hung when there is no heartbeat, the pid lives, and a\\n    declared [drive].stall_after_s has passed with no newer event, and\\n    terminated. Provenance product; the events tail as the log. Committed\\n    and pushed the way any stage record is (push_record_commit, with its\\n    own merge retry) -- this is not a race for a lease, since no new\\n    attempt marker is written.\\\"\\\"\\\"\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n    bound = stall_bound_s(m)\\n    pending = invocations_without_record(records_dir)\\n    readings = [(marker, info, read_invocation(root, bound, marker, info)) for marker, info in pending]\\n    candidate = next(((mk, i, rd) for mk, i, rd in readings if rd.cls != \\\"running\\\"), None)\\n    if candidate is None:\\n        # The report read this a moment ago; nothing owed recovery by the\\n        # time this pass got here (another pass recovered it, or it\\n        # finished on its own).\\n        return 0\\n    marker, info, reading = candidate\\n    stage, nn, log, last_at, age, cls = reading\\n    pid, host = info.get(\\\"pid\\\"), info.get(\\\"host\\\")\\n\\n    if next_attempt_number(records_dir, stage) != nn:\\n        print(f\\\"attavo drive: stopped: {marker.name} names attempt {nn} but the next \\\"\\n              f\\\"{stage} record would be {next_attempt_number(records_dir, stage):02d}; \\\"\\n              f\\\"a later record already exists, read the records before recovering\\\")\\n        return 1\\n\\n    if cls == \\\"hung\\\":\\n        try:\\n            os.kill(cast(int, pid), signal.SIGTERM)\\n            ended = \\\"terminated\\\"\\n        except OSError as exc:\\n            ended = f\\\"not terminated ({exc})\\\"\\n        detail = (f\\\"pid {pid} on {host} alive with no event for {int(cast(float, age))} s \\\"\\n                  f\\\"(bound {bound} s); {ended}\\\")\\n    else:\\n        detail = (f\\\"pid {pid} on {host} is not running and wrote no {marker.stem}.json; \\\"\\n                  f\\\"started {info.get('at')}, last event {last_at or 'none'}\\\")\\n\\n    schema = stage_schema(stage)\\n    record: dict[str, Any] = {k: None for k in schema.get(\\\"required\\\", [])}\\n    approval = latest_record(records_dir, \\\"approval\\\")\\n    record.update({\\\"sha\\\": info.get(\\\"sha\\\"), \\\"start_sha\\\": info.get(\\\"sha\\\"),\\n                   \\\"approval_sha\\\": approval.get(\\\"sha\\\") if approval else None,\\n                   \\\"at\\\": info.get(\\\"at\\\"),\\n                   \\\"adapter\\\": (m.get(\\\"executor\\\") or {}).get(stage),\\n                   \\\"status\\\": \\\"failed\\\", \\\"refusal\\\": None, \\\"halted\\\": None,\\n                   \\\"stop\\\": {\\\"class\\\": cls, \\\"provenance\\\": \\\"product\\\", \\\"detail\\\": detail}})\\n    if \\\"wall_clock_s\\\" in record:\\n        record[\\\"wall_clock_s\\\"] = None if age is None else int(age)\\n    record = {k: v for k, v in record.items() if k in schema.get(\\\"properties\\\", {})}\\n    try:\\n        path = write_record(records_dir, stage, record, m, item_id, log=log)\\n    except ValueError as exc:\\n        print(f\\\"attavo drive: stopped: could not write the {cls} record for {marker.stem}: {exc}\\\")\\n        return 1\\n    try:\\n        commit_record(root, [path], f\\\"attavo: {stage} record for item {item_id} \\\"\\n                                    f\\\"({path.stem}), recovered as {cls}\\\")\\n    except RuntimeError as exc:\\n        print(f\\\"attavo drive: stopped: could not commit the {cls} record: {exc}\\\")\\n        return 1\\n    if has_origin(root):\\n        ok, err = push_record_commit(root, branch)\\n        if not ok:\\n            print(f\\\"attavo drive: stopped: could not push the {cls} record: {err}\\\")\\n            return 1\\n    else:\\n        print(f\\\"attavo drive: note: no origin remote; {path.name} is committed, not pushed\\\")\\n    print(f\\\"attavo drive: recovered {marker.stem} as {cls}: {detail}\\\")\\n    return 0\\n\\n\\ndef _advance_again(root: Path, m: dict[str, Any], item_id: str, stage: str, head: str | None) -> int:\\n    \\\"\\\"\\\"`--again`'s own act on a stopped stage: exactly what next-build or\\n    next-review would do, bypassing the level a plain pass leaves alone\\n    for the operator. A review reads the forge fresh here -- once, since\\n    the report's own stopped reading never touched it -- rather than\\n    reusing a read that was never taken.\\\"\\\"\\\"\\n    if stage == \\\"build\\\":\\n        return _start_stage(root, m, item_id, \\\"build\\\", None)\\n    checks_command = (m.get(\\\"forge\\\") or {}).get(\\\"checks_command\\\")\\n    if not checks_command:\\n        print(\\\"attavo drive: refused: no [forge].checks_command in the manifest\\\")\\n        return 1\\n    forge_checks, ok = read_forge_checks(root, checks_command, cast(str, head))\\n    if not ok:\\n        conclusions = forge_checks[\\\"conclusions\\\"]\\n        named = \\\", \\\".join(f\\\"{c['name']} {c['conclusion']}\\\" for c in conclusions) or \\\"no checks reported\\\"\\n        print(f\\\"attavo drive: forge checks not green on {cast(str, head)[:12]}: {named}\\\")\\n        return 0\\n    return _start_stage(root, m, item_id, \\\"verify\\\", forge_checks)\\n\\n\\ndef _pass_once(root: Path, m: dict[str, Any], item_id: str, again: bool) -> tuple[int, \\\"DriveReport\\\"]:\\n    \\\"\\\"\\\"One pass: fast-forward to origin (never while a worker holds the\\n    copy), read the report, act at most once, return. The three acts,\\n    one per report state that is the product's move: owes-recovery\\n    recovers; next-build and next-review start their stage, handing a\\n    review the checks the report already read once on the pre-marker\\n    head. --again starts the next attempt of a stopped stage. Every\\n    other level is printed in the report's own words and left.\\\"\\\"\\\"\\n    from attavo.report import drive_report\\n    fast_forward_to_origin(root, m, item_id)\\n    r = drive_report(root, m, item_id)\\n\\n    if r[\\\"state\\\"] == \\\"owes-recovery\\\":\\n        records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n        return _recover_one(root, m, item_id, records_dir), r\\n    if r[\\\"state\\\"] == \\\"next-build\\\":\\n        return _start_stage(root, m, item_id, \\\"build\\\", None), r\\n    if r[\\\"state\\\"] == \\\"next-review\\\":\\n        checks_command = (m.get(\\\"forge\\\") or {}).get(\\\"checks_command\\\")\\n        forge_checks = {\\\"command\\\": checks_command, \\\"sha\\\": r[\\\"head\\\"], \\\"conclusions\\\": r[\\\"checks\\\"] or []}\\n        return _start_stage(root, m, item_id, \\\"verify\\\", forge_checks), r\\n    if again and r[\\\"state\\\"] == \\\"stopped\\\" and r[\\\"stage\\\"]:\\n        return _advance_again(root, m, item_id, r[\\\"stage\\\"], r[\\\"head\\\"]), r\\n\\n    print(f\\\"attavo drive: {r['says']}\\\")\\n    return (1 if r[\\\"state\\\"] == \\\"refused\\\" else 0), r\\n\\n\\n_TERMINAL_STATES = (\\\"waiting-on-approval\\\", \\\"stopped\\\", \\\"ready-to-merge\\\", \\\"merged\\\")\\n\\n\\ndef _until_ready(root: Path, m: dict[str, Any], item_id: str, again: bool) -> int:\\n    \\\"\\\"\\\"--until-ready: the pass, repeated in one process, sleeping\\n    ATTAVO_DRIVE_POLL_INTERVAL_S between passes, until the level is the\\n    operator's or done (exit 0), a concluded check is red (exit 1), or\\n    an unconcluded one has not concluded within ATTAVO_DRIVE_POLL_BOUND_S\\n    (exit 1). A stage running in its own worker is not bounded by this --\\n    only time spent waiting on the forge is.\\\"\\\"\\\"\\n    from attavo.verify import drive_forge_poll_bound_s, drive_forge_poll_interval_s\\n    bound = drive_forge_poll_bound_s()\\n    interval = drive_forge_poll_interval_s()\\n    waiting_since: float | None = None\\n    while True:\\n        rc, r = _pass_once(root, m, item_id, again)\\n        state = r[\\\"state\\\"]\\n\\n        if state == \\\"waiting-on-checks\\\":\\n            if waiting_since is None:\\n                waiting_since = time.monotonic()\\n            elif time.monotonic() - waiting_since >= bound:\\n                print(f\\\"attavo drive: stopped: the checks did not conclude within {bound:.0f}s\\\")\\n                return 1\\n        else:\\n            waiting_since = None\\n\\n        if rc != 0:\\n            return rc\\n        if state in _TERMINAL_STATES:\\n            return 0\\n        if state == \\\"blocked-on-checks\\\":\\n            return 1\\n        time.sleep(interval)\\n\\n\\ndef _drive_all() -> int:\\n    \\\"\\\"\\\"--all: one pass, in its own process, in every ../attavo-worktree-N\\n    beside this checkout -- each one derives its own item from its own\\n    attavo/N-* branch. Every line either prints is prefixed with the\\n    worktree's own directory name, so an operator reading them together\\n    can tell which item each line is about.\\\"\\\"\\\"\\n    root = Path(\\\".\\\").resolve()\\n    siblings = sorted(p for p in root.parent.glob(\\\"attavo-worktree-*\\\") if p.is_dir())\\n    if not siblings:\\n        print(\\\"attavo drive: --all found no ../attavo-worktree-N beside this checkout\\\")\\n        return 0\\n    worst = 0\\n    for copy in siblings:\\n        run = subprocess.run([sys.executable, str(PRODUCT_ROOT / \\\"bin\\\" / \\\"attavo\\\"), \\\"drive\\\"],\\n                             cwd=str(copy), capture_output=True, text=True, check=False)\\n        for line in (run.stdout + run.stderr).splitlines():\\n            print(f\\\"{copy.name}: {line}\\\")\\n        worst = max(worst, run.returncode)\\n    return worst\\n\\n\\ndef cmd_drive(argv: list[str]) -> int:\\n    # Issue #145: Python block-buffers stdout when it is not a tty (a\\n    # pipe, e.g. a screen reading this process live), so every line this\\n    # prints would otherwise sit unflushed until the process exits.\\n    # Line-buffering makes a pipe reader see each line the moment it is\\n    # printed, the same as a terminal already does; `attavo worker`\\n    # reconfigures its own stdout the same way.\\n    cast(io.TextIOWrapper, sys.stdout).reconfigure(line_buffering=True)\\n\\n    if \\\"--recover\\\" in argv:\\n        print(\\\"attavo drive: --recover is gone; a pass recovers a dead or hung invocation \\\"\\n              \\\"itself, as soon as the report owes one\\\", file=sys.stderr)\\n        return 2\\n\\n    until_ready = \\\"--until-ready\\\" in argv\\n    report = \\\"--report\\\" in argv\\n    again = \\\"--again\\\" in argv\\n    all_flag = \\\"--all\\\" in argv\\n    positional = [a for a in argv if not a.startswith(\\\"--\\\")]\\n\\n    if all_flag:\\n        if until_ready or report or again or positional:\\n            print(\\\"attavo drive: --all runs one pass in every worktree beside this checkout; \\\"\\n                  \\\"drop N and every other flag\\\", file=sys.stderr)\\n            return 2\\n        return _drive_all()\\n\\n    root = Path(\\\".\\\").resolve()\\n    item_id = positional[0] if positional else derive_item_id(root)\\n    if not item_id:\\n        print(\\\"attavo drive: cannot derive item id; pass N or run on an attavo/N-* branch\\\",\\n              file=sys.stderr)\\n        return 2\\n    m = read_manifest(root)\\n    if m is None:\\n        print(f\\\"attavo drive: no {MANIFEST} at {root}\\\", file=sys.stderr)\\n        return 2\\n\\n    if report:\\n        if until_ready or again:\\n            print(\\\"attavo drive: --report reads and does nothing else; drop --until-ready \\\"\\n                  \\\"and --again\\\", file=sys.stderr)\\n            return 2\\n        fast_forward_to_origin(root, m, item_id)\\n        from attavo.report import drive_report\\n        print(json.dumps(drive_report(root, m, item_id), indent=2))\\n        return 0\\n\\n    if until_ready:\\n        return _until_ready(root, m, item_id, again)\\n    rc, _ = _pass_once(root, m, item_id, again)\\n    return rc\\n\",\"structuredPatch\":[{\"oldStart\":280,\"oldLines\":6,\"newStart\":280,\"newLines\":18,\"lines\":[\"     stage, nn_text = marker.stem.rsplit(\\\"-\\\", 1)\",\"     nn = int(nn_text)\",\"     log, last_at = _events_tail(_events_path_for(root, stage, nn))\",\"+    # R3: the stage ceiling, wall clock from the marker's own `at`, judged\",\"+    # before any liveness signal -- alive past it is hung by the ceiling,\",\"+    # whatever its event age (or absence of one) says.\",\"+    m = read_manifest(root) or {}\",\"+    ceiling = ceiling_s(m, stage)\",\"+    since_start = _seconds_since(info.get(\\\"at\\\"))\",\"+    if ceiling is not None and since_start is not None and since_start > ceiling:\",\"+        return InvocationReading(stage, nn, log, last_at, since_start, \\\"hung\\\", \\\"ceiling\\\")\",\"+    if not _streams_events(root, m, stage):\",\"+        # An adapter that declares it streams no events is judged by the\",\"+        # ceiling alone; the stall bound it can never trip is not asked.\",\"+        bound = None\",\"     beat = heartbeat_path(root, stage, nn)\",\"     if beat.is_file():\",\"         try:\"]},{\"oldStart\":293,\"oldLines\":9,\"newStart\":305,\"newLines\":26,\"lines\":[\"         return InvocationReading(stage, nn, log, last_at, age, \\\"died\\\")\",\"     if bound is None or age is None or age <= bound:\",\"         return InvocationReading(stage, nn, log, last_at, age, \\\"running\\\")\",\"-    return InvocationReading(stage, nn, log, last_at, age, \\\"hung\\\")\",\"+    return InvocationReading(stage, nn, log, last_at, age, \\\"hung\\\", \\\"stall\\\")\",\" \",\" \",\"+def _streams_events(root: Path, m: dict[str, Any], stage: str) -> bool:\",\"+    \\\"\\\"\\\"R3: whether the stage's adapter declares it streams events\",\"+    (adapters/<name>/conformance.json, \\\"streams_events\\\"); true when the\",\"+    adapter names none, or its conformance.json does not say.\\\"\\\"\\\"\",\"+    name = (m.get(\\\"executor\\\") or {}).get(stage) or (m.get(\\\"executor\\\") or {}).get(\\\"build\\\")\",\"+    if not name:\",\"+        return True\",\"+    for base in (root / \\\"attavo\\\" / \\\"adapters\\\", PRODUCT_ROOT / \\\"adapters\\\"):\",\"+        conf = base / name / \\\"conformance.json\\\"\",\"+        if conf.is_file():\",\"+            try:\",\"+                return bool(json.loads(conf.read_text()).get(\\\"streams_events\\\", True))\",\"+            except (OSError, ValueError):\",\"+                return True\",\"+    return True\",\"+\",\"+\",\" def uncommitted_record(root: Path, records_dir: Path, stage: str) -> Path | None:\",\"     \\\"\\\"\\\"The latest <stage>-NN.json this working tree carries that git has\",\"     no commit for yet -- the moment between a worker's write and its own\"]}],\"userModified\":false,\"replaceAll\":false}}\n2317:+{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01PkmNN8nrbcGR6yrJJMFw2W\",\"type\":\"tool_result\",\"content\":\"The file /Users/davidbean/Projects/attavo-worktree-219/attavo/drive.py has been updated successfully.\"}]},\"parent_tool_use_id\":null,\"session_id\":\"0dd7ed4f-100c-4188-9a34-077aa0b6aa25\",\"uuid\":\"6d649640-cefd-4381-8cf7-c0e46ac293f9\",\"timestamp\":\"2026-09-26T02:26:41.566Z\",\"tool_use_result\":{\"filePath\":\"/Users/davidbean/Projects/attavo-worktree-219/attavo/drive.py\",\"oldString\":\"    marker, info, reading = candidate\\n    stage, nn, log, last_at, age, cls = reading\\n    pid, host = info.get(\\\"pid\\\"), info.get(\\\"host\\\")\\n\\n    if next_attempt_number(records_dir, stage) != nn:\\n        print(f\\\"attavo drive: stopped: {marker.name} names attempt {nn} but the next \\\"\\n              f\\\"{stage} record would be {next_attempt_number(records_dir, stage):02d}; \\\"\\n              f\\\"a later record already exists, read the records before recovering\\\")\\n        return 1\\n\\n    if cls == \\\"hung\\\":\\n        try:\\n            os.kill(cast(int, pid), signal.SIGTERM)\\n            ended = \\\"terminated\\\"\\n        except OSError as exc:\\n            ended = f\\\"not terminated ({exc})\\\"\\n        detail = (f\\\"pid {pid} on {host} alive with no event for {int(cast(float, age))} s \\\"\\n                  f\\\"(bound {bound} s); {ended}\\\")\\n    else:\\n        detail = (f\\\"pid {pid} on {host} is not running and wrote no {marker.stem}.json; \\\"\\n                  f\\\"started {info.get('at')}, last event {last_at or 'none'}\\\")\\n\\n    schema = stage_schema(stage)\\n    record: dict[str, Any] = {k: None for k in schema.get(\\\"required\\\", [])}\\n    approval = latest_record(records_dir, \\\"approval\\\")\\n    record.update({\\\"sha\\\": info.get(\\\"sha\\\"), \\\"start_sha\\\": info.get(\\\"sha\\\"),\\n                   \\\"approval_sha\\\": approval.get(\\\"sha\\\") if approval else None,\\n                   \\\"at\\\": info.get(\\\"at\\\"),\\n                   \\\"adapter\\\": (m.get(\\\"executor\\\") or {}).get(stage),\\n                   \\\"status\\\": \\\"failed\\\", \\\"refusal\\\": None, \\\"halted\\\": None,\\n                   \\\"stop\\\": {\\\"class\\\": cls, \\\"provenance\\\": \\\"product\\\", \\\"detail\\\": detail}})\",\"newString\":\"    marker, info, reading = candidate\\n    stage, nn, log, last_at, age, cls, crossed = reading\\n    pid, host = info.get(\\\"pid\\\"), info.get(\\\"host\\\")\\n\\n    if next_attempt_number(records_dir, stage) != nn:\\n        print(f\\\"attavo drive: stopped: {marker.name} names attempt {nn} but the next \\\"\\n              f\\\"{stage} record would be {next_attempt_number(records_dir, stage):02d}; \\\"\\n              f\\\"a later record already exists, read the records before recovering\\\")\\n        return 1\\n\\n    if cls == \\\"hung\\\":\\n        try:\\n            os.kill(cast(int, pid), signal.SIGTERM)\\n            ended = \\\"terminated\\\"\\n        except OSError as exc:\\n            ended = f\\\"not terminated ({exc})\\\"\\n        if crossed == \\\"ceiling\\\":\\n            detail = (f\\\"pid {pid} on {host} alive {int(cast(float, age))} s after its marker, past \\\"\\n                      f\\\"the {stage} ceiling of {ceiling_s(m, stage)} s; {ended}\\\")\\n        else:\\n            detail = (f\\\"pid {pid} on {host} alive with no event for {int(cast(float, age))} s \\\"\\n                      f\\\"(bound {bound} s); {ended}\\\")\\n    else:\\n        detail = (f\\\"pid {pid} on {host} is not running and wrote no {marker.stem}.json; \\\"\\n                  f\\\"started {info.get('at')}, last event {last_at or 'none'}\\\")\\n\\n    schema = stage_schema(stage)\\n    record: dict[str, Any] = {k: None for k in schema.get(\\\"required\\\", [])}\\n    approval = latest_record(records_dir, \\\"approval\\\")\\n    signature_source = log.strip().splitlines()[-1] if log.strip() else detail\\n    record.update({\\\"sha\\\": info.get(\\\"sha\\\"), \\\"start_sha\\\": info.get(\\\"sha\\\"),\\n                   \\\"approval_sha\\\": approval.get(\\\"sha\\\") if approval else None,\\n                   \\\"at\\\": info.get(\\\"at\\\"),\\n                   \\\"adapter\\\": (m.get(\\\"executor\\\") or {}).get(stage),\\n                   \\\"status\\\": \\\"failed\\\", \\\"refusal\\\": None, \\\"halted\\\": None,\\n                   \\\"retry_of\\\": None, \\\"steer\\\": None,\\n                   \\\"stop\\\": {\\\"class\\\": cls, \\\"provenance\\\": \\\"product\\\", \\\"detail\\\": detail,\\n                            \\\"signature\\\": signature_of(signature_source), \\\"bound\\\": crossed}})\",\"originalFile\":\"from __future__ import annotations\\n\\nimport io\\nimport json\\nimport os\\nimport signal\\nimport subprocess\\nimport sys\\nimport threading\\nimport time\\nfrom pathlib import Path\\nfrom typing import TYPE_CHECKING, Any, NamedTuple, cast\\n\\nfrom attavo.approval import approval_status\\nfrom attavo.build import cmd_build, driver_identity\\nfrom attavo.common import MANIFEST, PRODUCT_ROOT, derive_item_id, git, read_manifest\\nfrom attavo.counsel import cmd_counsel\\nfrom attavo.doctor import (\\n    _parse_json_line,\\n    attempts_budget,\\n    ceiling_s,\\n    invocation_alive,\\n    invocations_without_record,\\n    retry_after_s,\\n    stall_bound_s,\\n    write_invocation_marker,\\n)\\nfrom attavo.events import stage_events_dir\\nfrom attavo.filing import cmd_file_stops\\nfrom attavo.records import (\\n    latest_attempt_path,\\n    latest_record,\\n    next_attempt_number,\\n    parse_attempts,\\n    stage_schema,\\n    write_record,\\n)\\nfrom attavo.stops import RETRYABLE_CLASSES, counsel_record_for, signature_of, stage_exhausted\\nfrom attavo.verify import cmd_verify, read_forge_checks\\n\\nif TYPE_CHECKING:\\n    from attavo.types import DriveReport\\n\\n# --- drive: the mechanical transitions between approval and ready-to-merge\\n# (issue #84), under the reconciler's R2 (rulings A, B, C's recovery half,\\n# F, G, H): `attavo drive N` is one short pass. It reads the report\\n# (attavo.report), acts at most once -- recovers a dead or hung\\n# invocation, or starts the next stage in a detached worker -- and\\n# returns within seconds; the stage itself runs in `attavo worker`, a\\n# child of the pass's own session, which outlives it. Writes no record of\\n# its own: the stage records already on disk, and the invocation markers\\n# and heartbeats beside them, are the only state a pass or a worker\\n# reads. ---\\n\\n\\ndef commit_record(root: Path, record_paths: Path | list[Path], message: str) -> None:\\n    \\\"\\\"\\\"`git commit --only` on every record path given, and each one's .log\\n    and .filed, each if one exists -- never the whole index. A transport\\n    commit that sweeps the index is exactly the regression issue #46\\n    already guards build and verify against on the adapter side; drive\\n    must not reintroduce it on the transport side. The .filed marker\\n    (issue #89) is committed alongside the record it names, in the same\\n    commit and the same push, so a second worktree or a fresh clone reads\\n    the same filed fact rather than refiling every stop it finds with no\\n    marker of its own. A single Path is accepted for the common one-record\\n    case; issue #100 passes a list so the counsel record lands in the same\\n    commit as the stage record it counsels. Authored and committed as\\n    driver_identity(), set by the product and never the tenant's git\\n    config, so a driven item's record commits are never indistinguishable\\n    from an operator's own.\\\"\\\"\\\"\\n    if isinstance(record_paths, Path):\\n        record_paths = [record_paths]\\n    paths: list[str] = []\\n    for record_path in record_paths:\\n        paths.append(str(record_path.relative_to(root)))\\n        log_path = record_path.with_suffix(\\\".log\\\")\\n        if log_path.is_file():\\n            paths.append(str(log_path.relative_to(root)))\\n        marker_path = record_path.with_suffix(\\\".filed\\\")\\n        if marker_path.is_file():\\n            paths.append(str(marker_path.relative_to(root)))\\n    identity = driver_identity()\\n    env = dict(os.environ)\\n    env[\\\"GIT_AUTHOR_NAME\\\"] = identity[\\\"name\\\"]\\n    env[\\\"GIT_AUTHOR_EMAIL\\\"] = identity[\\\"email\\\"]\\n    env[\\\"GIT_COMMITTER_NAME\\\"] = identity[\\\"name\\\"]\\n    env[\\\"GIT_COMMITTER_EMAIL\\\"] = identity[\\\"email\\\"]\\n    git(root, \\\"add\\\", *paths)\\n    git(root, \\\"commit\\\", \\\"--only\\\", \\\"-m\\\", message, *paths, env=env)\\n\\n\\ndef push_record_commit(root: Path, branch: str) -> tuple[bool, str | None]:\\n    \\\"\\\"\\\"Push HEAD to branch on origin. A push a divergent remote rejects is\\n    retried once after `git pull --no-rebase --no-edit origin branch` -- a\\n    merge, never a rebase, because a rebase would change the sha the record\\n    commit just wrote already names. This is the record push's own retry\\n    -- the worker's, once it has the lease -- distinct from push_lease\\n    below, which never retries.\\\"\\\"\\\"\\n    def attempt() -> tuple[bool, str]:\\n        run = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"push\\\", \\\"origin\\\", f\\\"HEAD:{branch}\\\"],\\n                             capture_output=True, text=True, check=False)\\n        return run.returncode == 0, run.stderr.strip()\\n\\n    ok, err = attempt()\\n    if ok:\\n        return True, None\\n    pull = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"pull\\\", \\\"--no-rebase\\\", \\\"--no-edit\\\",\\n                           \\\"origin\\\", branch], capture_output=True, text=True, check=False)\\n    if pull.returncode != 0:\\n        return False, f\\\"push rejected and the retry merge failed: {pull.stderr.strip() or err}\\\"\\n    ok, err = attempt()\\n    if not ok:\\n        return False, f\\\"push rejected again after merging {branch}: {err}\\\"\\n    return True, None\\n\\n\\n_RACE_MARKERS = (\\\"non-fast-forward\\\", \\\"fetch first\\\", \\\"stale info\\\", \\\"cannot lock ref\\\",\\n                 \\\"failed to update ref\\\")\\n\\n\\ndef push_lease(root: Path, branch: str) -> tuple[str, str | None]:\\n    \\\"\\\"\\\"Push HEAD to branch on origin as a plain fast-forward -- no merge,\\n    no retry: this is the lease the marker commit takes on the attempt it\\n    names (ruling A). (\\\"pushed\\\", None) on success.\\n\\n    (\\\"lost-race\\\", stderr) when git's own ref check is what rejected it --\\n    the branch moved since this pass fast-forwarded to it (a sequential\\n    \\\"[rejected] ... (fetch first)\\\"), or the remote's own ref transaction\\n    lost a genuine simultaneous push (\\\"[remote rejected] ... (failed to\\n    update ref)\\\", \\\"cannot lock ref\\\"): either way, another pass's own\\n    marker (or record) landed there first. The pass that reads this is\\n    the loser: it says so, resets its own marker commit, and starts\\n    nothing.\\n\\n    (\\\"refused\\\", stderr) for every other rejection -- a remote that\\n    refuses the push outright (a hook, a permission, an unreachable\\n    remote). This is not a race for the lease; it is a refusal, and ends\\n    the pass with exit 1.\\\"\\\"\\\"\\n    run = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"push\\\", \\\"origin\\\", f\\\"HEAD:{branch}\\\"],\\n                         capture_output=True, text=True, check=False)\\n    if run.returncode == 0:\\n        return \\\"pushed\\\", None\\n    stderr = run.stderr\\n    if any(marker in stderr for marker in _RACE_MARKERS):\\n        return \\\"lost-race\\\", stderr.strip()\\n    return \\\"refused\\\", stderr.strip()\\n\\n\\ndef has_origin(root: Path) -> bool:\\n    \\\"\\\"\\\"Whether this checkout carries an origin remote at all -- a fixture\\n    or a scratch checkout with none is not a refusal; a pass commits\\n    locally and skips the push, the way recovery always has.\\\"\\\"\\\"\\n    try:\\n        git(root, \\\"remote\\\", \\\"get-url\\\", \\\"origin\\\")\\n        return True\\n    except RuntimeError:\\n        return False\\n\\n\\ndef drive_state(root: Path, m: dict[str, Any], item_id: str) -> tuple[str, str | None, Path]:\\n    \\\"\\\"\\\"(\\\"no-approval\\\" | \\\"build\\\" | \\\"verify\\\" | \\\"ready\\\", detail, records_dir):\\n    the next mechanical step for item_id, read from its latest records\\n    alone. A build only counts as current when it is a pass bound to the\\n    valid approval's own sha; a verify only counts as current when it is a\\n    pass bound to that build's own sha -- the same staleness a re-approval\\n    or a re-build must force, attest's own chain check already enforces\\n    (check_attest_chain), read here rather than re-typed.\\\"\\\"\\\"\\n    records_rel = m[\\\"paths\\\"][\\\"records\\\"]\\n    records_dir = root / records_rel / item_id\\n\\n    status = approval_status(root, m, item_id)\\n    if status != \\\"valid\\\":\\n        return \\\"no-approval\\\", status, records_dir\\n\\n    latest_approval = latest_record(records_dir, \\\"approval\\\")\\n    latest_build = latest_record(records_dir, \\\"build\\\")\\n    build_current = (latest_build is not None and latest_build.get(\\\"status\\\") == \\\"pass\\\"\\n                     and latest_build.get(\\\"approval_sha\\\")\\n                     == (latest_approval.get(\\\"sha\\\") if latest_approval else None))\\n    if latest_build is None or not build_current:\\n        return \\\"build\\\", None, records_dir\\n\\n    latest_verify = latest_record(records_dir, \\\"verify\\\")\\n    verify_current = (latest_verify is not None and latest_verify.get(\\\"status\\\") == \\\"pass\\\"\\n                      and latest_verify.get(\\\"build_sha\\\") == latest_build.get(\\\"sha\\\"))\\n    if not verify_current:\\n        return \\\"verify\\\", None, records_dir\\n\\n    return \\\"ready\\\", None, records_dir\\n\\n\\n# --- the heartbeat, the worker log, and the forge-checks handoff: local\\n# facts under the checkout's own git directory (issue #140's precedent),\\n# never committed and never among the paths commit_record ever names. ---\\n\\ndef heartbeat_s() -> float:\\n    return float(os.environ.get(\\\"ATTAVO_HEARTBEAT_S\\\", 15))\\n\\n\\ndef heartbeat_path(root: Path, stage: str, nn: int) -> Path:\\n    return stage_events_dir(root) / f\\\"{stage}-{nn:02d}.heartbeat\\\"\\n\\n\\ndef worker_log_path(root: Path, stage: str, nn: int) -> Path:\\n    return stage_events_dir(root) / f\\\"{stage}-{nn:02d}.worker.log\\\"\\n\\n\\ndef forge_checks_path(root: Path, stage: str, nn: int) -> Path:\\n    return stage_events_dir(root) / f\\\"{stage}-{nn:02d}.forge-checks.json\\\"\\n\\n\\ndef _events_path_for(root: Path, stage: str, nn: int) -> Path | None:\\n    \\\"\\\"\\\"The adapter's own events file for this invocation, under the\\n    checkout's git dir (a worktree's own dir when the checkout is one).\\\"\\\"\\\"\\n    try:\\n        gitdir = Path(git(root, \\\"rev-parse\\\", \\\"--git-dir\\\").strip())\\n    except RuntimeError:\\n        return None\\n    if not gitdir.is_absolute():\\n        gitdir = root / gitdir\\n    path = gitdir / \\\"attavo\\\" / f\\\"{stage}-{nn:02d}.events.jsonl\\\"\\n    return path if path.is_file() else None\\n\\n\\ndef _events_tail(path: Path | None, lines: int = 20) -> tuple[str, str | None]:\\n    \\\"\\\"\\\"(the last lines as a log, the last event's own at).\\\"\\\"\\\"\\n    if path is None:\\n        return \\\"no events file for this invocation\\\\n\\\", None\\n    try:\\n        text = path.read_text()\\n    except OSError:\\n        return \\\"events file unreadable\\\\n\\\", None\\n    tail = text.splitlines()[-lines:]\\n    last_at = None\\n    for line in reversed(tail):\\n        parsed = _parse_json_line(line)\\n        if not isinstance(parsed, dict):\\n            continue\\n        at = parsed.get(\\\"at\\\")\\n        if isinstance(at, str):\\n            last_at = at\\n            break\\n    return \\\"\\\\n\\\".join(tail) + \\\"\\\\n\\\", last_at\\n\\n\\ndef _seconds_since(at: str | None) -> float | None:\\n    from datetime import datetime, timezone\\n    if not at:\\n        return None\\n    try:\\n        then = datetime.strptime(at, \\\"%Y-%m-%dT%H:%M:%SZ\\\").replace(tzinfo=timezone.utc)\\n    except ValueError:\\n        return None\\n    return (datetime.now(timezone.utc) - then).total_seconds()\\n\\n\\nclass InvocationReading(NamedTuple):\\n    \\\"\\\"\\\"What one marker with no record reads as, from here and now.\\\"\\\"\\\"\\n    stage: str\\n    nn: int\\n    log: str\\n    last_at: str | None\\n    age: float | None\\n    cls: str  # \\\"running\\\" | \\\"hung\\\" | \\\"died\\\"\\n    bound: str | None = None  # R3: \\\"stall\\\" or \\\"ceiling\\\" when cls is \\\"hung\\\"\\n\\n\\ndef read_invocation(root: Path, bound: int | None, marker: Path, info: dict[str, Any]) -> InvocationReading:\\n    \\\"\\\"\\\"Whether an invocation that began and wrote no record is running,\\n    hung, or died -- read from its own heartbeat first (R2): a heartbeat\\n    file fresh within three beats of ATTAVO_HEARTBEAT_S is alive; a stale\\n    one is died, whether or not the pid still lives -- a worker stuck\\n    somewhere that never reaches its own heartbeat loop again is exactly\\n    what this is for. Only with no heartbeat file at all -- an invocation\\n    from before this release, or one that died before touching its\\n    first beat -- does this fall back to the pid: alive and, with a\\n    stall bound declared, past it is hung; alive with no bound, or\\n    within it, is running for as long as it lives; not alive is died.\\n    The stall bound decides hung, never died.\\\"\\\"\\\"\\n    stage, nn_text = marker.stem.rsplit(\\\"-\\\", 1)\\n    nn = int(nn_text)\\n    log, last_at = _events_tail(_events_path_for(root, stage, nn))\\n    # R3: the stage ceiling, wall clock from the marker's own `at`, judged\\n    # before any liveness signal -- alive past it is hung by the ceiling,\\n    # whatever its event age (or absence of one) says.\\n    m = read_manifest(root) or {}\\n    ceiling = ceiling_s(m, stage)\\n    since_start = _seconds_since(info.get(\\\"at\\\"))\\n    if ceiling is not None and since_start is not None and since_start > ceiling:\\n        return InvocationReading(stage, nn, log, last_at, since_start, \\\"hung\\\", \\\"ceiling\\\")\\n    if not _streams_events(root, m, stage):\\n        # An adapter that declares it streams no events is judged by the\\n        # ceiling alone; the stall bound it can never trip is not asked.\\n        bound = None\\n    beat = heartbeat_path(root, stage, nn)\\n    if beat.is_file():\\n        try:\\n            beat_age = time.time() - beat.stat().st_mtime\\n        except OSError:\\n            beat_age = None\\n        cls = \\\"running\\\" if beat_age is not None and beat_age <= heartbeat_s() * 3 else \\\"died\\\"\\n        return InvocationReading(stage, nn, log, last_at, beat_age, cls)\\n    age = _seconds_since(last_at or info.get(\\\"at\\\"))\\n    if not invocation_alive(info):\\n        return InvocationReading(stage, nn, log, last_at, age, \\\"died\\\")\\n    if bound is None or age is None or age <= bound:\\n        return InvocationReading(stage, nn, log, last_at, age, \\\"running\\\")\\n    return InvocationReading(stage, nn, log, last_at, age, \\\"hung\\\", \\\"stall\\\")\\n\\n\\ndef _streams_events(root: Path, m: dict[str, Any], stage: str) -> bool:\\n    \\\"\\\"\\\"R3: whether the stage's adapter declares it streams events\\n    (adapters/<name>/conformance.json, \\\"streams_events\\\"); true when the\\n    adapter names none, or its conformance.json does not say.\\\"\\\"\\\"\\n    name = (m.get(\\\"executor\\\") or {}).get(stage) or (m.get(\\\"executor\\\") or {}).get(\\\"build\\\")\\n    if not name:\\n        return True\\n    for base in (root / \\\"attavo\\\" / \\\"adapters\\\", PRODUCT_ROOT / \\\"adapters\\\"):\\n        conf = base / name / \\\"conformance.json\\\"\\n        if conf.is_file():\\n            try:\\n                return bool(json.loads(conf.read_text()).get(\\\"streams_events\\\", True))\\n            except (OSError, ValueError):\\n                return True\\n    return True\\n\\n\\ndef uncommitted_record(root: Path, records_dir: Path, stage: str) -> Path | None:\\n    \\\"\\\"\\\"The latest <stage>-NN.json this working tree carries that git has\\n    no commit for yet -- the moment between a worker's write and its own\\n    commit. None when the latest record is already committed, or there\\n    is none at all.\\\"\\\"\\\"\\n    path = latest_attempt_path(records_dir, stage)\\n    if path is None or not path.is_file():\\n        return None\\n    status = subprocess.run(\\n        [\\\"git\\\", \\\"-C\\\", str(root), \\\"status\\\", \\\"--porcelain\\\", \\\"--\\\", str(path.relative_to(root))],\\n        capture_output=True, text=True, check=False)\\n    return path if status.stdout.strip() else None\\n\\n\\ndef worker_holds_copy(root: Path, records_dir: Path) -> bool:\\n    \\\"\\\"\\\"True when this checkout's own working tree cannot safely be moved\\n    -- an invocation marker with no record yet (a worker, here or\\n    elsewhere, still holds this attempt), or a build or verify record the\\n    working tree carries that git has not committed yet. Scoped to the\\n    stage records a pass or a worker itself ever transports -- an\\n    operator's own spec-gate or approve, routinely uncommitted between\\n    their own act and the next pass, is not this. A pass never\\n    fast-forwards while this holds (never while a worker holds the\\n    copy).\\\"\\\"\\\"\\n    if invocations_without_record(records_dir):\\n        return True\\n    return (uncommitted_record(root, records_dir, \\\"build\\\") is not None\\n           or uncommitted_record(root, records_dir, \\\"verify\\\") is not None)\\n\\n\\ndef fast_forward_to_origin(root: Path, m: dict[str, Any], item_id: str) -> None:\\n    \\\"\\\"\\\"The pass's own read of origin's branch, taken before it reads\\n    anything else -- a commit landed there from elsewhere (an approval\\n    from the screen, a ruling, another pass's own record) is not a race\\n    for the lease, it is exactly what the lease is for. Never while a\\n    worker holds this copy (worker_holds_copy): resetting a working tree\\n    a detached child is still writing into would corrupt its own commits.\\n    A plain fast-forward when origin is simply ahead; when this checkout\\n    also carries its own commits origin has not seen yet (an operator's\\n    approval, not yet pushed), those are replayed on top of origin's own\\n    tip instead -- no merge commit, and the marker this pass is about to\\n    write still lands as a fast-forward when it pushes. Silent about\\n    everything short of that -- a real conflict, or an absent origin, is\\n    left for the ordinary read (and the marker push, for the lease) to\\n    sort out.\\\"\\\"\\\"\\n    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n    if worker_holds_copy(root, records_dir) or not has_origin(root):\\n        return\\n    try:\\n        branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n        git(root, \\\"fetch\\\", \\\"origin\\\", branch)\\n    except RuntimeError:\\n        return\\n    try:\\n        git(root, \\\"merge\\\", \\\"--ff-only\\\", \\\"FETCH_HEAD\\\")\\n        return\\n    except RuntimeError:\\n        pass\\n    try:\\n        git(root, \\\"rebase\\\", \\\"FETCH_HEAD\\\")\\n    except RuntimeError:\\n        subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"rebase\\\", \\\"--abort\\\"],\\n                       capture_output=True, text=True, check=False)\\n\\n\\n# --- the worker: a detached child of the pass's own session, running the\\n# stage exactly as the pass used to inline, touching its own heartbeat\\n# while it does (R2). ---\\n\\ndef _stage_body(item_id: str, stage: str, nn: int) -> int:\\n    \\\"\\\"\\\"Runs build or verify in-process -- the same command `attavo build`\\n    or `attavo verify` would run -- while touching heartbeat_path every\\n    heartbeat_s() seconds, then transports whatever it wrote: counsel and\\n    file-stops on a non-pass record (issue #100, #89), one `git commit\\n    --only`, one push with the record push's own merge retry. The\\n    marker is the pass's, already committed and pushed before this\\n    starts; this writes and transports only the stage's own record (and,\\n    on a stop, its counsel record).\\\"\\\"\\\"\\n    root = Path(\\\".\\\").resolve()\\n    m = read_manifest(root)\\n    if m is None:\\n        return 2\\n    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n    before = latest_attempt_path(records_dir, stage)\\n\\n    beat = heartbeat_path(root, stage, nn)\\n    beat.parent.mkdir(parents=True, exist_ok=True)\\n    beat.touch()\\n    stop_beat = threading.Event()\\n\\n    def _tick() -> None:\\n        while not stop_beat.wait(heartbeat_s()):\\n            beat.touch()\\n\\n    beat_thread = threading.Thread(target=_tick, daemon=True)\\n    beat_thread.start()\\n    try:\\n        rc = cmd_build([item_id]) if stage == \\\"build\\\" else cmd_verify([item_id])\\n    finally:\\n        stop_beat.set()\\n        beat_thread.join()\\n\\n    after = latest_attempt_path(records_dir, stage)\\n    if after is None or after == before:\\n        # Refused before writing anything at all (e.g. no adapter\\n        # configured) -- the stage command already printed why.\\n        return rc if rc != 0 else 1\\n\\n    record = cast(dict[str, Any], latest_record(records_dir, stage))\\n    status_out = record.get(\\\"status\\\")\\n    to_commit = [after]\\n    if status_out != \\\"pass\\\":\\n        counsel_before = latest_attempt_path(records_dir, \\\"counsel\\\")\\n        cmd_counsel([item_id])\\n        counsel_after = latest_attempt_path(records_dir, \\\"counsel\\\")\\n        if counsel_after is not None and counsel_after != counsel_before:\\n            to_commit.append(counsel_after)\\n        # file-stops is its own idempotent read of the item's records, so\\n        # calling it here on every run that wrote a non-pass record is\\n        # safe to call again on a later run: an already-filed stop's own\\n        # marker is what stops it from being filed twice.\\n        cmd_file_stops([item_id])\\n\\n    message = f\\\"attavo: {stage} record for item {item_id} ({after.stem})\\\"\\n    try:\\n        commit_record(root, to_commit, message)\\n    except RuntimeError as exc:\\n        print(f\\\"attavo drive: stopped: could not commit the {stage} record: {exc}\\\")\\n        return 1\\n\\n    if has_origin(root):\\n        ok, err = push_record_commit(root, branch)\\n        if not ok:\\n            print(f\\\"attavo drive: stopped: could not push the {stage} record: {err}\\\")\\n            return 1\\n    else:\\n        print(f\\\"attavo drive: note: no origin remote; {after.name} is committed, not pushed\\\")\\n\\n    if status_out == \\\"halted\\\":\\n        question = (record.get(\\\"halted\\\") or {}).get(\\\"question\\\")\\n        print(f\\\"attavo drive: stopped: {stage} halted: {question} ({after.name}); \\\"\\n              f\\\"pushed to {branch}\\\")\\n    elif status_out != \\\"pass\\\":\\n        reason = record.get(\\\"refusal\\\") or status_out\\n        print(f\\\"attavo drive: stopped: {stage} {status_out}: {reason} ({after.name}); \\\"\\n              f\\\"pushed to {branch}\\\")\\n    else:\\n        print(f\\\"attavo drive: pushed {after.name} to {branch}\\\")\\n    return rc\\n\\n\\ndef cmd_worker(argv: list[str]) -> int:\\n    \\\"\\\"\\\"`attavo worker N <build|verify> NN`: the detached child a pass\\n    starts once its marker is pushed -- the lease held, the attempt is\\n    this worker's to run. Its own session (start_new_session, set by the\\n    pass that spawns it); its stdout and stderr are the pass's own\\n    redirect, to <git-dir>/attavo/<stage>-NN.worker.log.\\\"\\\"\\\"\\n    cast(io.TextIOWrapper, sys.stdout).reconfigure(line_buffering=True)\\n    if len(argv) != 3:\\n        print(\\\"attavo worker: usage: attavo worker N <build|verify> NN\\\", file=sys.stderr)\\n        return 2\\n    item_id, stage, nn_text = argv\\n    if stage not in (\\\"build\\\", \\\"verify\\\"):\\n        print(f\\\"attavo worker: {stage!r} is not build or verify\\\", file=sys.stderr)\\n        return 2\\n    try:\\n        nn = int(nn_text)\\n    except ValueError:\\n        print(f\\\"attavo worker: {nn_text!r} is not an attempt number\\\", file=sys.stderr)\\n        return 2\\n    return _stage_body(item_id, stage, nn)\\n\\n\\n# --- the pass's own two acts: start a stage (the lease), and recover\\n# exactly the one invocation the report names owed one. ---\\n\\ndef _start_stage(root: Path, m: dict[str, Any], item_id: str, stage: str,\\n                 forge_checks: dict[str, Any] | None) -> int:\\n    \\\"\\\"\\\"The lease (ruling A): the marker, committed and pushed as a plain\\n    fast-forward with no merge and no retry (push_lease). Lost to another\\n    pass, or refused outright by the remote, both undo the marker commit\\n    here (git reset --hard) so this checkout carries no half-taken\\n    attempt either way; only a pushed lease starts the worker. On a\\n    review, forge_checks is the checks this same pass already read on\\n    the pre-marker head (ruling B) -- written to\\n    <git-dir>/attavo/verify-NN.forge-checks.json and named in\\n    ATTAVO_FORGE_CHECKS, so the worker's own `attavo verify` reads it\\n    instead of polling.\\\"\\\"\\\"\\n    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n    nn = next_attempt_number(records_dir, stage)\\n    marker = write_invocation_marker(root, records_dir, stage, nn)\\n    try:\\n        commit_record(root, [marker], f\\\"attavo: {stage} invocation {nn:02d} started for item {item_id}\\\")\\n    except RuntimeError as exc:\\n        print(f\\\"attavo drive: stopped: could not commit the {stage} invocation marker: {exc}\\\")\\n        return 1\\n\\n    if has_origin(root):\\n        outcome, err = push_lease(root, branch)\\n        if outcome != \\\"pushed\\\":\\n            git(root, \\\"reset\\\", \\\"--hard\\\", \\\"HEAD^\\\")\\n            if outcome == \\\"lost-race\\\":\\n                print(f\\\"attavo drive: another pass holds this attempt ({marker.name}); nothing started\\\")\\n                return 0\\n            print(f\\\"attavo drive: stopped: could not push the {stage} invocation marker: {err}\\\")\\n            return 1\\n\\n    env = dict(os.environ)\\n    if forge_checks is not None:\\n        checks_file = forge_checks_path(root, stage, nn)\\n        checks_file.write_text(json.dumps(forge_checks))\\n        env[\\\"ATTAVO_FORGE_CHECKS\\\"] = str(checks_file)\\n    log = worker_log_path(root, stage, nn)\\n    with log.open(\\\"ab\\\") as fh, open(os.devnull, \\\"rb\\\") as devnull:\\n        proc = subprocess.Popen(\\n            [sys.executable, str(PRODUCT_ROOT / \\\"bin\\\" / \\\"attavo\\\"), \\\"worker\\\", item_id, stage, f\\\"{nn:02d}\\\"],\\n            cwd=str(root), env=env, stdin=devnull, stdout=fh, stderr=subprocess.STDOUT,\\n            start_new_session=True)\\n    word = \\\"Build\\\" if stage == \\\"build\\\" else \\\"Review\\\"\\n    print(f\\\"attavo drive: {word} started (attempt {nn:02d}, worker pid {proc.pid})\\\")\\n    return 0\\n\\n\\ndef _recover_one(root: Path, m: dict[str, Any], item_id: str, records_dir: Path) -> int:\\n    \\\"\\\"\\\"The pass's own recovery act (what `--recover` did): exactly the one\\n    invocation the report just read as owing one -- died or hung -- ends\\n    here. class died when the heartbeat is stale (or absent and the pid\\n    is gone), class hung when there is no heartbeat, the pid lives, and a\\n    declared [drive].stall_after_s has passed with no newer event, and\\n    terminated. Provenance product; the events tail as the log. Committed\\n    and pushed the way any stage record is (push_record_commit, with its\\n    own merge retry) -- this is not a race for a lease, since no new\\n    attempt marker is written.\\\"\\\"\\\"\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n    bound = stall_bound_s(m)\\n    pending = invocations_without_record(records_dir)\\n    readings = [(marker, info, read_invocation(root, bound, marker, info)) for marker, info in pending]\\n    candidate = next(((mk, i, rd) for mk, i, rd in readings if rd.cls != \\\"running\\\"), None)\\n    if candidate is None:\\n        # The report read this a moment ago; nothing owed recovery by the\\n        # time this pass got here (another pass recovered it, or it\\n        # finished on its own).\\n        return 0\\n    marker, info, reading = candidate\\n    stage, nn, log, last_at, age, cls = reading\\n    pid, host = info.get(\\\"pid\\\"), info.get(\\\"host\\\")\\n\\n    if next_attempt_number(records_dir, stage) != nn:\\n        print(f\\\"attavo drive: stopped: {marker.name} names attempt {nn} but the next \\\"\\n              f\\\"{stage} record would be {next_attempt_number(records_dir, stage):02d}; \\\"\\n              f\\\"a later record already exists, read the records before recovering\\\")\\n        return 1\\n\\n    if cls == \\\"hung\\\":\\n        try:\\n            os.kill(cast(int, pid), signal.SIGTERM)\\n            ended = \\\"terminated\\\"\\n        except OSError as exc:\\n            ended = f\\\"not terminated ({exc})\\\"\\n        detail = (f\\\"pid {pid} on {host} alive with no event for {int(cast(float, age))} s \\\"\\n                  f\\\"(bound {bound} s); {ended}\\\")\\n    else:\\n        detail = (f\\\"pid {pid} on {host} is not running and wrote no {marker.stem}.json; \\\"\\n                  f\\\"started {info.get('at')}, last event {last_at or 'none'}\\\")\\n\\n    schema = stage_schema(stage)\\n    record: dict[str, Any] = {k: None for k in schema.get(\\\"required\\\", [])}\\n    approval = latest_record(records_dir, \\\"approval\\\")\\n    record.update({\\\"sha\\\": info.get(\\\"sha\\\"), \\\"start_sha\\\": info.get(\\\"sha\\\"),\\n                   \\\"approval_sha\\\": approval.get(\\\"sha\\\") if approval else None,\\n                   \\\"at\\\": info.get(\\\"at\\\"),\\n                   \\\"adapter\\\": (m.get(\\\"executor\\\") or {}).get(stage),\\n                   \\\"status\\\": \\\"failed\\\", \\\"refusal\\\": None, \\\"halted\\\": None,\\n                   \\\"stop\\\": {\\\"class\\\": cls, \\\"provenance\\\": \\\"product\\\", \\\"detail\\\": detail}})\\n    if \\\"wall_clock_s\\\" in record:\\n        record[\\\"wall_clock_s\\\"] = None if age is None else int(age)\\n    record = {k: v for k, v in record.items() if k in schema.get(\\\"properties\\\", {})}\\n    try:\\n        path = write_record(records_dir, stage, record, m, item_id, log=log)\\n    except ValueError as exc:\\n        print(f\\\"attavo drive: stopped: could not write the {cls} record for {marker.stem}: {exc}\\\")\\n        return 1\\n    try:\\n        commit_record(root, [path], f\\\"attavo: {stage} record for item {item_id} \\\"\\n                                    f\\\"({path.stem}), recovered as {cls}\\\")\\n    except RuntimeError as exc:\\n        print(f\\\"attavo drive: stopped: could not commit the {cls} record: {exc}\\\")\\n        return 1\\n    if has_origin(root):\\n        ok, err = push_record_commit(root, branch)\\n        if not ok:\\n            print(f\\\"attavo drive: stopped: could not push the {cls} record: {err}\\\")\\n            return 1\\n    else:\\n        print(f\\\"attavo drive: note: no origin remote; {path.name} is committed, not pushed\\\")\\n    print(f\\\"attavo drive: recovered {marker.stem} as {cls}: {detail}\\\")\\n    return 0\\n\\n\\ndef _advance_again(root: Path, m: dict[str, Any], item_id: str, stage: str, head: str | None) -> int:\\n    \\\"\\\"\\\"`--again`'s own act on a stopped stage: exactly what next-build or\\n    next-review would do, bypassing the level a plain pass leaves alone\\n    for the operator. A review reads the forge fresh here -- once, since\\n    the report's own stopped reading never touched it -- rather than\\n    reusing a read that was never taken.\\\"\\\"\\\"\\n    if stage == \\\"build\\\":\\n        return _start_stage(root, m, item_id, \\\"build\\\", None)\\n    checks_command = (m.get(\\\"forge\\\") or {}).get(\\\"checks_command\\\")\\n    if not checks_command:\\n        print(\\\"attavo drive: refused: no [forge].checks_command in the manifest\\\")\\n        return 1\\n    forge_checks, ok = read_forge_checks(root, checks_command, cast(str, head))\\n    if not ok:\\n        conclusions = forge_checks[\\\"conclusions\\\"]\\n        named = \\\", \\\".join(f\\\"{c['name']} {c['conclusion']}\\\" for c in conclusions) or \\\"no checks reported\\\"\\n        print(f\\\"attavo drive: forge checks not green on {cast(str, head)[:12]}: {named}\\\")\\n        return 0\\n    return _start_stage(root, m, item_id, \\\"verify\\\", forge_checks)\\n\\n\\ndef _pass_once(root: Path, m: dict[str, Any], item_id: str, again: bool) -> tuple[int, \\\"DriveReport\\\"]:\\n    \\\"\\\"\\\"One pass: fast-forward to origin (never while a worker holds the\\n    copy), read the report, act at most once, return. The three acts,\\n    one per report state that is the product's move: owes-recovery\\n    recovers; next-build and next-review start their stage, handing a\\n    review the checks the report already read once on the pre-marker\\n    head. --again starts the next attempt of a stopped stage. Every\\n    other level is printed in the report's own words and left.\\\"\\\"\\\"\\n    from attavo.report import drive_report\\n    fast_forward_to_origin(root, m, item_id)\\n    r = drive_report(root, m, item_id)\\n\\n    if r[\\\"state\\\"] == \\\"owes-recovery\\\":\\n        records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n        return _recover_one(root, m, item_id, records_dir), r\\n    if r[\\\"state\\\"] == \\\"next-build\\\":\\n        return _start_stage(root, m, item_id, \\\"build\\\", None), r\\n    if r[\\\"state\\\"] == \\\"next-review\\\":\\n        checks_command = (m.get(\\\"forge\\\") or {}).get(\\\"checks_command\\\")\\n        forge_checks = {\\\"command\\\": checks_command, \\\"sha\\\": r[\\\"head\\\"], \\\"conclusions\\\": r[\\\"checks\\\"] or []}\\n        return _start_stage(root, m, item_id, \\\"verify\\\", forge_checks), r\\n    if again and r[\\\"state\\\"] == \\\"stopped\\\" and r[\\\"stage\\\"]:\\n        return _advance_again(root, m, item_id, r[\\\"stage\\\"], r[\\\"head\\\"]), r\\n\\n    print(f\\\"attavo drive: {r['says']}\\\")\\n    return (1 if r[\\\"state\\\"] == \\\"refused\\\" else 0), r\\n\\n\\n_TERMINAL_STATES = (\\\"waiting-on-approval\\\", \\\"stopped\\\", \\\"ready-to-merge\\\", \\\"merged\\\")\\n\\n\\ndef _until_ready(root: Path, m: dict[str, Any], item_id: str, again: bool) -> int:\\n    \\\"\\\"\\\"--until-ready: the pass, repeated in one process, sleeping\\n    ATTAVO_DRIVE_POLL_INTERVAL_S between passes, until the level is the\\n    operator's or done (exit 0), a concluded check is red (exit 1), or\\n    an unconcluded one has not concluded within ATTAVO_DRIVE_POLL_BOUND_S\\n    (exit 1). A stage running in its own worker is not bounded by this --\\n    only time spent waiting on the forge is.\\\"\\\"\\\"\\n    from attavo.verify import drive_forge_poll_bound_s, drive_forge_poll_interval_s\\n    bound = drive_forge_poll_bound_s()\\n    interval = drive_forge_poll_interval_s()\\n    waiting_since: float | None = None\\n    while True:\\n        rc, r = _pass_once(root, m, item_id, again)\\n        state = r[\\\"state\\\"]\\n\\n        if state == \\\"waiting-on-checks\\\":\\n            if waiting_since is None:\\n                waiting_since = time.monotonic()\\n            elif time.monotonic() - waiting_since >= bound:\\n                print(f\\\"attavo drive: stopped: the checks did not conclude within {bound:.0f}s\\\")\\n                return 1\\n        else:\\n            waiting_since = None\\n\\n        if rc != 0:\\n            return rc\\n        if state in _TERMINAL_STATES:\\n            return 0\\n        if state == \\\"blocked-on-checks\\\":\\n            return 1\\n        time.sleep(interval)\\n\\n\\ndef _drive_all() -> int:\\n    \\\"\\\"\\\"--all: one pass, in its own process, in every ../attavo-worktree-N\\n    beside this checkout -- each one derives its own item from its own\\n    attavo/N-* branch. Every line either prints is prefixed with the\\n    worktree's own directory name, so an operator reading them together\\n    can tell which item each line is about.\\\"\\\"\\\"\\n    root = Path(\\\".\\\").resolve()\\n    siblings = sorted(p for p in root.parent.glob(\\\"attavo-worktree-*\\\") if p.is_dir())\\n    if not siblings:\\n        print(\\\"attavo drive: --all found no ../attavo-worktree-N beside this checkout\\\")\\n        return 0\\n    worst = 0\\n    for copy in siblings:\\n        run = subprocess.run([sys.executable, str(PRODUCT_ROOT / \\\"bin\\\" / \\\"attavo\\\"), \\\"drive\\\"],\\n                             cwd=str(copy), capture_output=True, text=True, check=False)\\n        for line in (run.stdout + run.stderr).splitlines():\\n            print(f\\\"{copy.name}: {line}\\\")\\n        worst = max(worst, run.returncode)\\n    return worst\\n\\n\\ndef cmd_drive(argv: list[str]) -> int:\\n    # Issue #145: Python block-buffers stdout when it is not a tty (a\\n    # pipe, e.g. a screen reading this process live), so every line this\\n    # prints would otherwise sit unflushed until the process exits.\\n    # Line-buffering makes a pipe reader see each line the moment it is\\n    # printed, the same as a terminal already does; `attavo worker`\\n    # reconfigures its own stdout the same way.\\n    cast(io.TextIOWrapper, sys.stdout).reconfigure(line_buffering=True)\\n\\n    if \\\"--recover\\\" in argv:\\n        print(\\\"attavo drive: --recover is gone; a pass recovers a dead or hung invocation \\\"\\n              \\\"itself, as soon as the report owes one\\\", file=sys.stderr)\\n        return 2\\n\\n    until_ready = \\\"--until-ready\\\" in argv\\n    report = \\\"--report\\\" in argv\\n    again = \\\"--again\\\" in argv\\n    all_flag = \\\"--all\\\" in argv\\n    positional = [a for a in argv if not a.startswith(\\\"--\\\")]\\n\\n    if all_flag:\\n        if until_ready or report or again or positional:\\n            print(\\\"attavo drive: --all runs one pass in every worktree beside this checkout; \\\"\\n                  \\\"drop N and every other flag\\\", file=sys.stderr)\\n            return 2\\n        return _drive_all()\\n\\n    root = Path(\\\".\\\").resolve()\\n    item_id = positional[0] if positional else derive_item_id(root)\\n    if not item_id:\\n        print(\\\"attavo drive: cannot derive item id; pass N or run on an attavo/N-* branch\\\",\\n              file=sys.stderr)\\n        return 2\\n    m = read_manifest(root)\\n    if m is None:\\n        print(f\\\"attavo drive: no {MANIFEST} at {root}\\\", file=sys.stderr)\\n        return 2\\n\\n    if report:\\n        if until_ready or again:\\n            print(\\\"attavo drive: --report reads and does nothing else; drop --until-ready \\\"\\n                  \\\"and --again\\\", file=sys.stderr)\\n            return 2\\n        fast_forward_to_origin(root, m, item_id)\\n        from attavo.report import drive_report\\n        print(json.dumps(drive_report(root, m, item_id), indent=2))\\n        return 0\\n\\n    if until_ready:\\n        return _until_ready(root, m, item_id, again)\\n    rc, _ = _pass_once(root, m, item_id, again)\\n    return rc\\n\",\"structuredPatch\":[{\"oldStart\":571,\"oldLines\":7,\"newStart\":571,\"newLines\":7,\"lines\":[\"         # finished on its own).\",\"         return 0\",\"     marker, info, reading = candidate\",\"-    stage, nn, log, last_at, age, cls = reading\",\"+    stage, nn, log, last_at, age, cls, crossed = reading\",\"     pid, host = info.get(\\\"pid\\\"), info.get(\\\"host\\\")\",\" \",\"     if next_attempt_number(records_dir, stage) != nn:\"]},{\"oldStart\":586,\"oldLines\":8,\"newStart\":586,\"newLines\":12,\"lines\":[\"             ended = \\\"terminated\\\"\",\"         except OSError as exc:\",\"             ended = f\\\"not terminated ({exc})\\\"\",\"-        detail = (f\\\"pid {pid} on {host} alive with no event for {int(cast(float, age))} s \\\"\",\"-                  f\\\"(bound {bound} s); {ended}\\\")\",\"+        if crossed == \\\"ceiling\\\":\",\"+            detail = (f\\\"pid {pid} on {host} alive {int(cast(float, age))} s after its marker, past \\\"\",\"+                      f\\\"the {stage} ceiling of {ceiling_s(m, stage)} s; {ended}\\\")\",\"+        else:\",\"+            detail = (f\\\"pid {pid} on {host} alive with no event for {int(cast(float, age))} s \\\"\",\"+                      f\\\"(bound {bound} s); {ended}\\\")\",\"     else:\",\"         detail = (f\\\"pid {pid} on {host} is not running and wrote no {marker.stem}.json; \\\"\",\"                   f\\\"started {info.get('at')}, last event {last_at or 'none'}\\\")\"]},{\"oldStart\":595,\"oldLines\":12,\"newStart\":599,\"newLines\":15,\"lines\":[\"     schema = stage_schema(stage)\",\"     record: dict[str, Any] = {k: None for k in schema.get(\\\"required\\\", [])}\",\"     approval = latest_record(records_dir, \\\"approval\\\")\",\"+    signature_source = log.strip().splitlines()[-1] if log.strip() else detail\",\"     record.update({\\\"sha\\\": info.get(\\\"sha\\\"), \\\"start_sha\\\": info.get(\\\"sha\\\"),\",\"                    \\\"approval_sha\\\": approval.get(\\\"sha\\\") if approval else None,\",\"                    \\\"at\\\": info.get(\\\"at\\\"),\",\"                    \\\"adapter\\\": (m.get(\\\"executor\\\") or {}).get(stage),\",\"                    \\\"status\\\": \\\"failed\\\", \\\"refusal\\\": None, \\\"halted\\\": None,\",\"-                   \\\"stop\\\": {\\\"class\\\": cls, \\\"provenance\\\": \\\"product\\\", \\\"detail\\\": detail}})\",\"+                   \\\"retry_of\\\": None, \\\"steer\\\": None,\",\"+                   \\\"stop\\\": {\\\"class\\\": cls, \\\"provenance\\\": \\\"product\\\", \\\"detail\\\": detail,\",\"+                            \\\"signature\\\": signature_of(signature_source), \\\"bound\\\": crossed}})\",\"     if \\\"wall_clock_s\\\" in record:\",\"         record[\\\"wall_clock_s\\\"] = None if age is None else int(age)\",\"     record = {k: v for k, v in record.items() if k in schema.get(\\\"properties\\\", {})}\"]}],\"userModified\":false,\"replaceAll\":false,\"contentNotInModelContext\":true}}\n2330:+{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01Ry1gvpwPyPZpaWk7fWEufr\",\"type\":\"tool_result\",\"content\":\"495\\t        nn = int(nn_text)\\n496\\t    except ValueError:\\n497\\t        print(f\\\"attavo worker: {nn_text!r} is not an attempt number\\\", file=sys.stderr)\\n498\\t        return 2\\n499\\t    return _stage_body(item_id, stage, nn)\\n500\\t\\n501\\t\\n502\\t# --- the pass's own two acts: start a stage (the lease), and recover\\n503\\t# exactly the one invocation the report names owed one. ---\\n504\\t\\n505\\tdef _start_stage(root: Path, m: dict[str, Any], item_id: str, stage: str,\\n506\\t                 forge_checks: dict[str, Any] | None) -> int:\\n507\\t    \\\"\\\"\\\"The lease (ruling A): the marker, committed and pushed as a plain\\n508\\t    fast-forward with no merge and no retry (push_lease). Lost to another\\n509\\t    pass, or refused outright by the remote, both undo the marker commit\\n510\\t    here (git reset --hard) so this checkout carries no half-taken\\n511\\t    attempt either way; only a pushed lease starts the worker. On a\\n512\\t    review, forge_checks is the checks this same pass already read on\\n513\\t    the pre-marker head (ruling B) -- written to\\n514\\t    <git-dir>/attavo/verify-NN.forge-checks.json and named in\\n515\\t    ATTAVO_FORGE_CHECKS, so the worker's own `attavo verify` reads it\\n516\\t    instead of polling.\\\"\\\"\\\"\\n517\\t    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n518\\t    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n519\\t    nn = next_attempt_number(records_dir, stage)\\n520\\t    marker = write_invocation_marker(root, records_dir, stage, nn)\\n521\\t    try:\\n522\\t        commit_record(root, [marker], f\\\"attavo: {stage} invocation {nn:02d} started for item {item_id}\\\")\\n523\\t    except RuntimeError as exc:\\n524\\t        print(f\\\"attavo drive: stopped: could not commit the {stage} invocation marker: {exc}\\\")\\n525\\t        return 1\\n526\\t\\n527\\t    if has_origin(root):\\n528\\t        outcome, err = push_lease(root, branch)\\n529\\t        if outcome != \\\"pushed\\\":\\n530\\t            git(root, \\\"reset\\\", \\\"--hard\\\", \\\"HEAD^\\\")\\n531\\t            if outcome == \\\"lost-race\\\":\\n532\\t                print(f\\\"attavo drive: another pass holds this attempt ({marker.name}); nothing started\\\")\\n533\\t                return 0\\n534\\t            print(f\\\"attavo drive: stopped: could not push the {stage} invocation marker: {err}\\\")\\n535\\t            return 1\\n536\\t\\n537\\t    env = dict(os.environ)\\n538\\t    if forge_checks is not None:\\n539\\t        checks_file = forge_checks_path(root, stage, nn)\\n540\\t        checks_file.write_text(json.dumps(forge_checks))\\n541\\t        env[\\\"ATTAVO_FORGE_CHECKS\\\"] = str(checks_file)\\n542\\t    log = worker_log_path(root, stage, nn)\\n543\\t    with log.open(\\\"ab\\\") as fh, open(os.devnull, \\\"rb\\\") as devnull:\\n544\\t        proc = subprocess.Popen(\\n545\\t            [sys.executable, str(PRODUCT_ROOT / \\\"bin\\\" / \\\"attavo\\\"), \\\"worker\\\", item_id, stage, f\\\"{nn:02d}\\\"],\\n546\\t            cwd=str(root), env=env, stdin=devnull, stdout=fh, stderr=subprocess.STDOUT,\\n547\\t            start_new_session=True)\\n548\\t    word = \\\"Build\\\" if stage == \\\"build\\\" else \\\"Review\\\"\\n549\\t    print(f\\\"attavo drive: {word} started (attempt {nn:02d}, worker pid {proc.pid})\\\")\"}]},\"parent_tool_use_id\":null,\"session_id\":\"0dd7ed4f-100c-4188-9a34-077aa0b6aa25\",\"uuid\":\"70a53e6f-1969-4f25-ad6a-3f1f690e4fba\",\"timestamp\":\"2026-09-26T02:26:59.505Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/davidbean/Projects/attavo-worktree-219/attavo/drive.py\",\"content\":\"        nn = int(nn_text)\\n    except ValueError:\\n        print(f\\\"attavo worker: {nn_text!r} is not an attempt number\\\", file=sys.stderr)\\n        return 2\\n    return _stage_body(item_id, stage, nn)\\n\\n\\n# --- the pass's own two acts: start a stage (the lease), and recover\\n# exactly the one invocation the report names owed one. ---\\n\\ndef _start_stage(root: Path, m: dict[str, Any], item_id: str, stage: str,\\n                 forge_checks: dict[str, Any] | None) -> int:\\n    \\\"\\\"\\\"The lease (ruling A): the marker, committed and pushed as a plain\\n    fast-forward with no merge and no retry (push_lease). Lost to another\\n    pass, or refused outright by the remote, both undo the marker commit\\n    here (git reset --hard) so this checkout carries no half-taken\\n    attempt either way; only a pushed lease starts the worker. On a\\n    review, forge_checks is the checks this same pass already read on\\n    the pre-marker head (ruling B) -- written to\\n    <git-dir>/attavo/verify-NN.forge-checks.json and named in\\n    ATTAVO_FORGE_CHECKS, so the worker's own `attavo verify` reads it\\n    instead of polling.\\\"\\\"\\\"\\n    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n    nn = next_attempt_number(records_dir, stage)\\n    marker = write_invocation_marker(root, records_dir, stage, nn)\\n    try:\\n        commit_record(root, [marker], f\\\"attavo: {stage} invocation {nn:02d} started for item {item_id}\\\")\\n    except RuntimeError as exc:\\n        print(f\\\"attavo drive: stopped: could not commit the {stage} invocation marker: {exc}\\\")\\n        return 1\\n\\n    if has_origin(root):\\n        outcome, err = push_lease(root, branch)\\n        if outcome != \\\"pushed\\\":\\n            git(root, \\\"reset\\\", \\\"--hard\\\", \\\"HEAD^\\\")\\n            if outcome == \\\"lost-race\\\":\\n                print(f\\\"attavo drive: another pass holds this attempt ({marker.name}); nothing started\\\")\\n                return 0\\n            print(f\\\"attavo drive: stopped: could not push the {stage} invocation marker: {err}\\\")\\n            return 1\\n\\n    env = dict(os.environ)\\n    if forge_checks is not None:\\n        checks_file = forge_checks_path(root, stage, nn)\\n        checks_file.write_text(json.dumps(forge_checks))\\n        env[\\\"ATTAVO_FORGE_CHECKS\\\"] = str(checks_file)\\n    log = worker_log_path(root, stage, nn)\\n    with log.open(\\\"ab\\\") as fh, open(os.devnull, \\\"rb\\\") as devnull:\\n        proc = subprocess.Popen(\\n            [sys.executable, str(PRODUCT_ROOT / \\\"bin\\\" / \\\"attavo\\\"), \\\"worker\\\", item_id, stage, f\\\"{nn:02d}\\\"],\\n            cwd=str(root), env=env, stdin=devnull, stdout=fh, stderr=subprocess.STDOUT,\\n            start_new_session=True)\\n    word = \\\"Build\\\" if stage == \\\"build\\\" else \\\"Review\\\"\\n    print(f\\\"attavo drive: {word} started (attempt {nn:02d}, worker pid {proc.pid})\\\")\",\"numLines\":55,\"startLine\":495,\"totalLines\":794}}}\n2331:+{\"type\":\"assistant\",\"message\":{\"model\":\"claude-sonnet-5\",\"id\":\"msg_011CfRG3hAFUNFndDoLo2uva\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_017yYkp4ja1iP8w8qyUuP2bG\",\"name\":\"Edit\",\"input\":{\"replace_all\":false,\"file_path\":\"/Users/davidbean/Projects/attavo-worktree-219/attavo/drive.py\",\"old_string\":\"def _start_stage(root: Path, m: dict[str, Any], item_id: str, stage: str,\\n                 forge_checks: dict[str, Any] | None) -> int:\\n    \\\"\\\"\\\"The lease (ruling A): the marker, committed and pushed as a plain\\n    fast-forward with no merge and no retry (push_lease). Lost to another\\n    pass, or refused outright by the remote, both undo the marker commit\\n    here (git reset --hard) so this checkout carries no half-taken\\n    attempt either way; only a pushed lease starts the worker. On a\\n    review, forge_checks is the checks this same pass already read on\\n    the pre-marker head (ruling B) -- written to\\n    <git-dir>/attavo/verify-NN.forge-checks.json and named in\\n    ATTAVO_FORGE_CHECKS, so the worker's own `attavo verify` reads it\\n    instead of polling.\\\"\\\"\\\"\\n    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n    nn = next_attempt_number(records_dir, stage)\\n    marker = write_invocation_marker(root, records_dir, stage, nn)\",\"new_string\":\"def _start_stage(root: Path, m: dict[str, Any], item_id: str, stage: str,\\n                 forge_checks: dict[str, Any] | None, *, again_by: bool = False) -> int:\\n    \\\"\\\"\\\"The lease (ruling A): the marker, committed and pushed as a plain\\n    fast-forward with no merge and no retry (push_lease). Lost to another\\n    pass, or refused outright by the remote, both undo the marker commit\\n    here (git reset --hard) so this checkout carries no half-taken\\n    attempt either way; only a pushed lease starts the worker. On a\\n    review, forge_checks is the checks this same pass already read on\\n    the pre-marker head (ruling B) -- written to\\n    <git-dir>/attavo/verify-NN.forge-checks.json and named in\\n    ATTAVO_FORGE_CHECKS, so the worker's own `attavo verify` reads it\\n    instead of polling. R3: again_by names the marker as `--again`'s own\\n    act on a stage whose budget was already spent.\\\"\\\"\\\"\\n    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n    nn = next_attempt_number(records_dir, stage)\\n    marker = write_invocation_marker(root, records_dir, stage, nn, again_by=again_by)\"},\"caller\":{\"type\":\"direct\"}}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":1541,\"cache_read_input_tokens\":385736,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":1541},\"output_tokens\":20,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"0dd7ed4f-100c-4188-9a34-077aa0b6aa25\",\"uuid\":\"badb9047-0eff-4ce6-8cfc-86d6a656d035\",\"timestamp\":\"2026-09-26T02:27:08.857Z\",\"request_id\":\"req_011CfRG3gYYW61DD2tnVfSDK\",\"wire_tool_inputs\":{\"toolu_017yYkp4ja1iP8w8qyUuP2bG\":{\"file_path\":\"/Users/davidbean/Projects/attavo-worktree-219/attavo/drive.py\",\"old_string\":\"def _start_stage(root: Path, m: dict[str, Any], item_id: str, stage: str,\\n                 forge_checks: dict[str, Any] | None) -> int:\\n    \\\"\\\"\\\"The lease (ruling A): the marker, committed and pushed as a plain\\n    fast-forward with no merge and no retry (push_lease). Lost to another\\n    pass, or refused outright by the remote, both undo the marker commit\\n    here (git reset --hard) so this checkout carries no half-taken\\n    attempt either way; only a pushed lease starts the worker. On a\\n    review, forge_checks is the checks this same pass already read on\\n    the pre-marker head (ruling B) -- written to\\n    <git-dir>/attavo/verify-NN.forge-checks.json and named in\\n    ATTAVO_FORGE_CHECKS, so the worker's own `attavo verify` reads it\\n    instead of polling.\\\"\\\"\\\"\\n    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n    nn = next_attempt_number(records_dir, stage)\\n    marker = write_invocation_marker(root, records_dir, stage, nn)\",\"new_string\":\"def _start_stage(root: Path, m: dict[str, Any], item_id: str, stage: str,\\n                 forge_checks: dict[str, Any] | None, *, again_by: bool = False) -> int:\\n    \\\"\\\"\\\"The lease (ruling A): the marker, committed and pushed as a plain\\n    fast-forward with no merge and no retry (push_lease). Lost to another\\n    pass, or refused outright by the remote, both undo the marker commit\\n    here (git reset --hard) so this checkout carries no half-taken\\n    attempt either way; only a pushed lease starts the worker. On a\\n    review, forge_checks is the checks this same pass already read on\\n    the pre-marker head (ruling B) -- written to\\n    <git-dir>/attavo/verify-NN.forge-checks.json and named in\\n    ATTAVO_FORGE_CHECKS, so the worker's own `attavo verify` reads it\\n    instead of polling. R3: again_by names the marker as `--again`'s own\\n    act on a stage whose budget was already spent.\\\"\\\"\\\"\\n    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n    nn = next_attempt_number(records_dir, stage)\\n    marker = write_invocation_marker(root, records_dir, stage, nn, again_by=again_by)\"}}}\n2332:+{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_017yYkp4ja1iP8w8qyUuP2bG\",\"type\":\"tool_result\",\"content\":\"The file /Users/davidbean/Projects/attavo-worktree-219/attavo/drive.py has been updated successfully.\"}]},\"parent_tool_use_id\":null,\"session_id\":\"0dd7ed4f-100c-4188-9a34-077aa0b6aa25\",\"uuid\":\"ba353b1f-a13f-432d-91ed-e74acca14344\",\"timestamp\":\"2026-09-26T02:27:08.863Z\",\"tool_use_result\":{\"filePath\":\"/Users/davidbean/Projects/attavo-worktree-219/attavo/drive.py\",\"oldString\":\"def _start_stage(root: Path, m: dict[str, Any], item_id: str, stage: str,\\n                 forge_checks: dict[str, Any] | None) -> int:\\n    \\\"\\\"\\\"The lease (ruling A): the marker, committed and pushed as a plain\\n    fast-forward with no merge and no retry (push_lease). Lost to another\\n    pass, or refused outright by the remote, both undo the marker commit\\n    here (git reset --hard) so this checkout carries no half-taken\\n    attempt either way; only a pushed lease starts the worker. On a\\n    review, forge_checks is the checks this same pass already read on\\n    the pre-marker head (ruling B) -- written to\\n    <git-dir>/attavo/verify-NN.forge-checks.json and named in\\n    ATTAVO_FORGE_CHECKS, so the worker's own `attavo verify` reads it\\n    instead of polling.\\\"\\\"\\\"\\n    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n    nn = next_attempt_number(records_dir, stage)\\n    marker = write_invocation_marker(root, records_dir, stage, nn)\",\"newString\":\"def _start_stage(root: Path, m: dict[str, Any], item_id: str, stage: str,\\n                 forge_checks: dict[str, Any] | None, *, again_by: bool = False) -> int:\\n    \\\"\\\"\\\"The lease (ruling A): the marker, committed and pushed as a plain\\n    fast-forward with no merge and no retry (push_lease). Lost to another\\n    pass, or refused outright by the remote, both undo the marker commit\\n    here (git reset --hard) so this checkout carries no half-taken\\n    attempt either way; only a pushed lease starts the worker. On a\\n    review, forge_checks is the checks this same pass already read on\\n    the pre-marker head (ruling B) -- written to\\n    <git-dir>/attavo/verify-NN.forge-checks.json and named in\\n    ATTAVO_FORGE_CHECKS, so the worker's own `attavo verify` reads it\\n    instead of polling. R3: again_by names the marker as `--again`'s own\\n    act on a stage whose budget was already spent.\\\"\\\"\\\"\\n    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n    nn = next_attempt_number(records_dir, stage)\\n    marker = write_invocation_marker(root, records_dir, stage, nn, again_by=again_by)\",\"originalFile\":\"from __future__ import annotations\\n\\nimport io\\nimport json\\nimport os\\nimport signal\\nimport subprocess\\nimport sys\\nimport threading\\nimport time\\nfrom pathlib import Path\\nfrom typing import TYPE_CHECKING, Any, NamedTuple, cast\\n\\nfrom attavo.approval import approval_status\\nfrom attavo.build import cmd_build, driver_identity\\nfrom attavo.common import MANIFEST, PRODUCT_ROOT, derive_item_id, git, read_manifest\\nfrom attavo.counsel import cmd_counsel\\nfrom attavo.doctor import (\\n    _parse_json_line,\\n    attempts_budget,\\n    ceiling_s,\\n    invocation_alive,\\n    invocations_without_record,\\n    retry_after_s,\\n    stall_bound_s,\\n    write_invocation_marker,\\n)\\nfrom attavo.events import stage_events_dir\\nfrom attavo.filing import cmd_file_stops\\nfrom attavo.records import (\\n    latest_attempt_path,\\n    latest_record,\\n    next_attempt_number,\\n    parse_attempts,\\n    stage_schema,\\n    write_record,\\n)\\nfrom attavo.stops import RETRYABLE_CLASSES, counsel_record_for, signature_of, stage_exhausted\\nfrom attavo.verify import cmd_verify, read_forge_checks\\n\\nif TYPE_CHECKING:\\n    from attavo.types import DriveReport\\n\\n# --- drive: the mechanical transitions between approval and ready-to-merge\\n# (issue #84), under the reconciler's R2 (rulings A, B, C's recovery half,\\n# F, G, H): `attavo drive N` is one short pass. It reads the report\\n# (attavo.report), acts at most once -- recovers a dead or hung\\n# invocation, or starts the next stage in a detached worker -- and\\n# returns within seconds; the stage itself runs in `attavo worker`, a\\n# child of the pass's own session, which outlives it. Writes no record of\\n# its own: the stage records already on disk, and the invocation markers\\n# and heartbeats beside them, are the only state a pass or a worker\\n# reads. ---\\n\\n\\ndef commit_record(root: Path, record_paths: Path | list[Path], message: str) -> None:\\n    \\\"\\\"\\\"`git commit --only` on every record path given, and each one's .log\\n    and .filed, each if one exists -- never the whole index. A transport\\n    commit that sweeps the index is exactly the regression issue #46\\n    already guards build and verify against on the adapter side; drive\\n    must not reintroduce it on the transport side. The .filed marker\\n    (issue #89) is committed alongside the record it names, in the same\\n    commit and the same push, so a second worktree or a fresh clone reads\\n    the same filed fact rather than refiling every stop it finds with no\\n    marker of its own. A single Path is accepted for the common one-record\\n    case; issue #100 passes a list so the counsel record lands in the same\\n    commit as the stage record it counsels. Authored and committed as\\n    driver_identity(), set by the product and never the tenant's git\\n    config, so a driven item's record commits are never indistinguishable\\n    from an operator's own.\\\"\\\"\\\"\\n    if isinstance(record_paths, Path):\\n        record_paths = [record_paths]\\n    paths: list[str] = []\\n    for record_path in record_paths:\\n        paths.append(str(record_path.relative_to(root)))\\n        log_path = record_path.with_suffix(\\\".log\\\")\\n        if log_path.is_file():\\n            paths.append(str(log_path.relative_to(root)))\\n        marker_path = record_path.with_suffix(\\\".filed\\\")\\n        if marker_path.is_file():\\n            paths.append(str(marker_path.relative_to(root)))\\n    identity = driver_identity()\\n    env = dict(os.environ)\\n    env[\\\"GIT_AUTHOR_NAME\\\"] = identity[\\\"name\\\"]\\n    env[\\\"GIT_AUTHOR_EMAIL\\\"] = identity[\\\"email\\\"]\\n    env[\\\"GIT_COMMITTER_NAME\\\"] = identity[\\\"name\\\"]\\n    env[\\\"GIT_COMMITTER_EMAIL\\\"] = identity[\\\"email\\\"]\\n    git(root, \\\"add\\\", *paths)\\n    git(root, \\\"commit\\\", \\\"--only\\\", \\\"-m\\\", message, *paths, env=env)\\n\\n\\ndef push_record_commit(root: Path, branch: str) -> tuple[bool, str | None]:\\n    \\\"\\\"\\\"Push HEAD to branch on origin. A push a divergent remote rejects is\\n    retried once after `git pull --no-rebase --no-edit origin branch` -- a\\n    merge, never a rebase, because a rebase would change the sha the record\\n    commit just wrote already names. This is the record push's own retry\\n    -- the worker's, once it has the lease -- distinct from push_lease\\n    below, which never retries.\\\"\\\"\\\"\\n    def attempt() -> tuple[bool, str]:\\n        run = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"push\\\", \\\"origin\\\", f\\\"HEAD:{branch}\\\"],\\n                             capture_output=True, text=True, check=False)\\n        return run.returncode == 0, run.stderr.strip()\\n\\n    ok, err = attempt()\\n    if ok:\\n        return True, None\\n    pull = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"pull\\\", \\\"--no-rebase\\\", \\\"--no-edit\\\",\\n                           \\\"origin\\\", branch], capture_output=True, text=True, check=False)\\n    if pull.returncode != 0:\\n        return False, f\\\"push rejected and the retry merge failed: {pull.stderr.strip() or err}\\\"\\n    ok, err = attempt()\\n    if not ok:\\n        return False, f\\\"push rejected again after merging {branch}: {err}\\\"\\n    return True, None\\n\\n\\n_RACE_MARKERS = (\\\"non-fast-forward\\\", \\\"fetch first\\\", \\\"stale info\\\", \\\"cannot lock ref\\\",\\n                 \\\"failed to update ref\\\")\\n\\n\\ndef push_lease(root: Path, branch: str) -> tuple[str, str | None]:\\n    \\\"\\\"\\\"Push HEAD to branch on origin as a plain fast-forward -- no merge,\\n    no retry: this is the lease the marker commit takes on the attempt it\\n    names (ruling A). (\\\"pushed\\\", None) on success.\\n\\n    (\\\"lost-race\\\", stderr) when git's own ref check is what rejected it --\\n    the branch moved since this pass fast-forwarded to it (a sequential\\n    \\\"[rejected] ... (fetch first)\\\"), or the remote's own ref transaction\\n    lost a genuine simultaneous push (\\\"[remote rejected] ... (failed to\\n    update ref)\\\", \\\"cannot lock ref\\\"): either way, another pass's own\\n    marker (or record) landed there first. The pass that reads this is\\n    the loser: it says so, resets its own marker commit, and starts\\n    nothing.\\n\\n    (\\\"refused\\\", stderr) for every other rejection -- a remote that\\n    refuses the push outright (a hook, a permission, an unreachable\\n    remote). This is not a race for the lease; it is a refusal, and ends\\n    the pass with exit 1.\\\"\\\"\\\"\\n    run = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"push\\\", \\\"origin\\\", f\\\"HEAD:{branch}\\\"],\\n                         capture_output=True, text=True, check=False)\\n    if run.returncode == 0:\\n        return \\\"pushed\\\", None\\n    stderr = run.stderr\\n    if any(marker in stderr for marker in _RACE_MARKERS):\\n        return \\\"lost-race\\\", stderr.strip()\\n    return \\\"refused\\\", stderr.strip()\\n\\n\\ndef has_origin(root: Path) -> bool:\\n    \\\"\\\"\\\"Whether this checkout carries an origin remote at all -- a fixture\\n    or a scratch checkout with none is not a refusal; a pass commits\\n    locally and skips the push, the way recovery always has.\\\"\\\"\\\"\\n    try:\\n        git(root, \\\"remote\\\", \\\"get-url\\\", \\\"origin\\\")\\n        return True\\n    except RuntimeError:\\n        return False\\n\\n\\ndef drive_state(root: Path, m: dict[str, Any], item_id: str) -> tuple[str, str | None, Path]:\\n    \\\"\\\"\\\"(\\\"no-approval\\\" | \\\"build\\\" | \\\"verify\\\" | \\\"ready\\\", detail, records_dir):\\n    the next mechanical step for item_id, read from its latest records\\n    alone. A build only counts as current when it is a pass bound to the\\n    valid approval's own sha; a verify only counts as current when it is a\\n    pass bound to that build's own sha -- the same staleness a re-approval\\n    or a re-build must force, attest's own chain check already enforces\\n    (check_attest_chain), read here rather than re-typed.\\\"\\\"\\\"\\n    records_rel = m[\\\"paths\\\"][\\\"records\\\"]\\n    records_dir = root / records_rel / item_id\\n\\n    status = approval_status(root, m, item_id)\\n    if status != \\\"valid\\\":\\n        return \\\"no-approval\\\", status, records_dir\\n\\n    latest_approval = latest_record(records_dir, \\\"approval\\\")\\n    latest_build = latest_record(records_dir, \\\"build\\\")\\n    build_current = (latest_build is not None and latest_build.get(\\\"status\\\") == \\\"pass\\\"\\n                     and latest_build.get(\\\"approval_sha\\\")\\n                     == (latest_approval.get(\\\"sha\\\") if latest_approval else None))\\n    if latest_build is None or not build_current:\\n        return \\\"build\\\", None, records_dir\\n\\n    latest_verify = latest_record(records_dir, \\\"verify\\\")\\n    verify_current = (latest_verify is not None and latest_verify.get(\\\"status\\\") == \\\"pass\\\"\\n                      and latest_verify.get(\\\"build_sha\\\") == latest_build.get(\\\"sha\\\"))\\n    if not verify_current:\\n        return \\\"verify\\\", None, records_dir\\n\\n    return \\\"ready\\\", None, records_dir\\n\\n\\n# --- the heartbeat, the worker log, and the forge-checks handoff: local\\n# facts under the checkout's own git directory (issue #140's precedent),\\n# never committed and never among the paths commit_record ever names. ---\\n\\ndef heartbeat_s() -> float:\\n    return float(os.environ.get(\\\"ATTAVO_HEARTBEAT_S\\\", 15))\\n\\n\\ndef heartbeat_path(root: Path, stage: str, nn: int) -> Path:\\n    return stage_events_dir(root) / f\\\"{stage}-{nn:02d}.heartbeat\\\"\\n\\n\\ndef worker_log_path(root: Path, stage: str, nn: int) -> Path:\\n    return stage_events_dir(root) / f\\\"{stage}-{nn:02d}.worker.log\\\"\\n\\n\\ndef forge_checks_path(root: Path, stage: str, nn: int) -> Path:\\n    return stage_events_dir(root) / f\\\"{stage}-{nn:02d}.forge-checks.json\\\"\\n\\n\\ndef _events_path_for(root: Path, stage: str, nn: int) -> Path | None:\\n    \\\"\\\"\\\"The adapter's own events file for this invocation, under the\\n    checkout's git dir (a worktree's own dir when the checkout is one).\\\"\\\"\\\"\\n    try:\\n        gitdir = Path(git(root, \\\"rev-parse\\\", \\\"--git-dir\\\").strip())\\n    except RuntimeError:\\n        return None\\n    if not gitdir.is_absolute():\\n        gitdir = root / gitdir\\n    path = gitdir / \\\"attavo\\\" / f\\\"{stage}-{nn:02d}.events.jsonl\\\"\\n    return path if path.is_file() else None\\n\\n\\ndef _events_tail(path: Path | None, lines: int = 20) -> tuple[str, str | None]:\\n    \\\"\\\"\\\"(the last lines as a log, the last event's own at).\\\"\\\"\\\"\\n    if path is None:\\n        return \\\"no events file for this invocation\\\\n\\\", None\\n    try:\\n        text = path.read_text()\\n    except OSError:\\n        return \\\"events file unreadable\\\\n\\\", None\\n    tail = text.splitlines()[-lines:]\\n    last_at = None\\n    for line in reversed(tail):\\n        parsed = _parse_json_line(line)\\n        if not isinstance(parsed, dict):\\n            continue\\n        at = parsed.get(\\\"at\\\")\\n        if isinstance(at, str):\\n            last_at = at\\n            break\\n    return \\\"\\\\n\\\".join(tail) + \\\"\\\\n\\\", last_at\\n\\n\\ndef _seconds_since(at: str | None) -> float | None:\\n    from datetime import datetime, timezone\\n    if not at:\\n        return None\\n    try:\\n        then = datetime.strptime(at, \\\"%Y-%m-%dT%H:%M:%SZ\\\").replace(tzinfo=timezone.utc)\\n    except ValueError:\\n        return None\\n    return (datetime.now(timezone.utc) - then).total_seconds()\\n\\n\\nclass InvocationReading(NamedTuple):\\n    \\\"\\\"\\\"What one marker with no record reads as, from here and now.\\\"\\\"\\\"\\n    stage: str\\n    nn: int\\n    log: str\\n    last_at: str | None\\n    age: float | None\\n    cls: str  # \\\"running\\\" | \\\"hung\\\" | \\\"died\\\"\\n    bound: str | None = None  # R3: \\\"stall\\\" or \\\"ceiling\\\" when cls is \\\"hung\\\"\\n\\n\\ndef read_invocation(root: Path, bound: int | None, marker: Path, info: dict[str, Any]) -> InvocationReading:\\n    \\\"\\\"\\\"Whether an invocation that began and wrote no record is running,\\n    hung, or died -- read from its own heartbeat first (R2): a heartbeat\\n    file fresh within three beats of ATTAVO_HEARTBEAT_S is alive; a stale\\n    one is died, whether or not the pid still lives -- a worker stuck\\n    somewhere that never reaches its own heartbeat loop again is exactly\\n    what this is for. Only with no heartbeat file at all -- an invocation\\n    from before this release, or one that died before touching its\\n    first beat -- does this fall back to the pid: alive and, with a\\n    stall bound declared, past it is hung; alive with no bound, or\\n    within it, is running for as long as it lives; not alive is died.\\n    The stall bound decides hung, never died.\\\"\\\"\\\"\\n    stage, nn_text = marker.stem.rsplit(\\\"-\\\", 1)\\n    nn = int(nn_text)\\n    log, last_at = _events_tail(_events_path_for(root, stage, nn))\\n    # R3: the stage ceiling, wall clock from the marker's own `at`, judged\\n    # before any liveness signal -- alive past it is hung by the ceiling,\\n    # whatever its event age (or absence of one) says.\\n    m = read_manifest(root) or {}\\n    ceiling = ceiling_s(m, stage)\\n    since_start = _seconds_since(info.get(\\\"at\\\"))\\n    if ceiling is not None and since_start is not None and since_start > ceiling:\\n        return InvocationReading(stage, nn, log, last_at, since_start, \\\"hung\\\", \\\"ceiling\\\")\\n    if not _streams_events(root, m, stage):\\n        # An adapter that declares it streams no events is judged by the\\n        # ceiling alone; the stall bound it can never trip is not asked.\\n        bound = None\\n    beat = heartbeat_path(root, stage, nn)\\n    if beat.is_file():\\n        try:\\n            beat_age = time.time() - beat.stat().st_mtime\\n        except OSError:\\n            beat_age = None\\n        cls = \\\"running\\\" if beat_age is not None and beat_age <= heartbeat_s() * 3 else \\\"died\\\"\\n        return InvocationReading(stage, nn, log, last_at, beat_age, cls)\\n    age = _seconds_since(last_at or info.get(\\\"at\\\"))\\n    if not invocation_alive(info):\\n        return InvocationReading(stage, nn, log, last_at, age, \\\"died\\\")\\n    if bound is None or age is None or age <= bound:\\n        return InvocationReading(stage, nn, log, last_at, age, \\\"running\\\")\\n    return InvocationReading(stage, nn, log, last_at, age, \\\"hung\\\", \\\"stall\\\")\\n\\n\\ndef _streams_events(root: Path, m: dict[str, Any], stage: str) -> bool:\\n    \\\"\\\"\\\"R3: whether the stage's adapter declares it streams events\\n    (adapters/<name>/conformance.json, \\\"streams_events\\\"); true when the\\n    adapter names none, or its conformance.json does not say.\\\"\\\"\\\"\\n    name = (m.get(\\\"executor\\\") or {}).get(stage) or (m.get(\\\"executor\\\") or {}).get(\\\"build\\\")\\n    if not name:\\n        return True\\n    for base in (root / \\\"attavo\\\" / \\\"adapters\\\", PRODUCT_ROOT / \\\"adapters\\\"):\\n        conf = base / name / \\\"conformance.json\\\"\\n        if conf.is_file():\\n            try:\\n                return bool(json.loads(conf.read_text()).get(\\\"streams_events\\\", True))\\n            except (OSError, ValueError):\\n                return True\\n    return True\\n\\n\\ndef uncommitted_record(root: Path, records_dir: Path, stage: str) -> Path | None:\\n    \\\"\\\"\\\"The latest <stage>-NN.json this working tree carries that git has\\n    no commit for yet -- the moment between a worker's write and its own\\n    commit. None when the latest record is already committed, or there\\n    is none at all.\\\"\\\"\\\"\\n    path = latest_attempt_path(records_dir, stage)\\n    if path is None or not path.is_file():\\n        return None\\n    status = subprocess.run(\\n        [\\\"git\\\", \\\"-C\\\", str(root), \\\"status\\\", \\\"--porcelain\\\", \\\"--\\\", str(path.relative_to(root))],\\n        capture_output=True, text=True, check=False)\\n    return path if status.stdout.strip() else None\\n\\n\\ndef worker_holds_copy(root: Path, records_dir: Path) -> bool:\\n    \\\"\\\"\\\"True when this checkout's own working tree cannot safely be moved\\n    -- an invocation marker with no record yet (a worker, here or\\n    elsewhere, still holds this attempt), or a build or verify record the\\n    working tree carries that git has not committed yet. Scoped to the\\n    stage records a pass or a worker itself ever transports -- an\\n    operator's own spec-gate or approve, routinely uncommitted between\\n    their own act and the next pass, is not this. A pass never\\n    fast-forwards while this holds (never while a worker holds the\\n    copy).\\\"\\\"\\\"\\n    if invocations_without_record(records_dir):\\n        return True\\n    return (uncommitted_record(root, records_dir, \\\"build\\\") is not None\\n           or uncommitted_record(root, records_dir, \\\"verify\\\") is not None)\\n\\n\\ndef fast_forward_to_origin(root: Path, m: dict[str, Any], item_id: str) -> None:\\n    \\\"\\\"\\\"The pass's own read of origin's branch, taken before it reads\\n    anything else -- a commit landed there from elsewhere (an approval\\n    from the screen, a ruling, another pass's own record) is not a race\\n    for the lease, it is exactly what the lease is for. Never while a\\n    worker holds this copy (worker_holds_copy): resetting a working tree\\n    a detached child is still writing into would corrupt its own commits.\\n    A plain fast-forward when origin is simply ahead; when this checkout\\n    also carries its own commits origin has not seen yet (an operator's\\n    approval, not yet pushed), those are replayed on top of origin's own\\n    tip instead -- no merge commit, and the marker this pass is about to\\n    write still lands as a fast-forward when it pushes. Silent about\\n    everything short of that -- a real conflict, or an absent origin, is\\n    left for the ordinary read (and the marker push, for the lease) to\\n    sort out.\\\"\\\"\\\"\\n    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n    if worker_holds_copy(root, records_dir) or not has_origin(root):\\n        return\\n    try:\\n        branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n        git(root, \\\"fetch\\\", \\\"origin\\\", branch)\\n    except RuntimeError:\\n        return\\n    try:\\n        git(root, \\\"merge\\\", \\\"--ff-only\\\", \\\"FETCH_HEAD\\\")\\n        return\\n    except RuntimeError:\\n        pass\\n    try:\\n        git(root, \\\"rebase\\\", \\\"FETCH_HEAD\\\")\\n    except RuntimeError:\\n        subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"rebase\\\", \\\"--abort\\\"],\\n                       capture_output=True, text=True, check=False)\\n\\n\\n# --- the worker: a detached child of the pass's own session, running the\\n# stage exactly as the pass used to inline, touching its own heartbeat\\n# while it does (R2). ---\\n\\ndef _stage_body(item_id: str, stage: str, nn: int) -> int:\\n    \\\"\\\"\\\"Runs build or verify in-process -- the same command `attavo build`\\n    or `attavo verify` would run -- while touching heartbeat_path every\\n    heartbeat_s() seconds, then transports whatever it wrote: counsel and\\n    file-stops on a non-pass record (issue #100, #89), one `git commit\\n    --only`, one push with the record push's own merge retry. The\\n    marker is the pass's, already committed and pushed before this\\n    starts; this writes and transports only the stage's own record (and,\\n    on a stop, its counsel record).\\\"\\\"\\\"\\n    root = Path(\\\".\\\").resolve()\\n    m = read_manifest(root)\\n    if m is None:\\n        return 2\\n    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n    before = latest_attempt_path(records_dir, stage)\\n\\n    beat = heartbeat_path(root, stage, nn)\\n    beat.parent.mkdir(parents=True, exist_ok=True)\\n    beat.touch()\\n    stop_beat = threading.Event()\\n\\n    def _tick() -> None:\\n        while not stop_beat.wait(heartbeat_s()):\\n            beat.touch()\\n\\n    beat_thread = threading.Thread(target=_tick, daemon=True)\\n    beat_thread.start()\\n    try:\\n        rc = cmd_build([item_id]) if stage == \\\"build\\\" else cmd_verify([item_id])\\n    finally:\\n        stop_beat.set()\\n        beat_thread.join()\\n\\n    after = latest_attempt_path(records_dir, stage)\\n    if after is None or after == before:\\n        # Refused before writing anything at all (e.g. no adapter\\n        # configured) -- the stage command already printed why.\\n        return rc if rc != 0 else 1\\n\\n    record = cast(dict[str, Any], latest_record(records_dir, stage))\\n    status_out = record.get(\\\"status\\\")\\n    to_commit = [after]\\n    if status_out != \\\"pass\\\":\\n        counsel_before = latest_attempt_path(records_dir, \\\"counsel\\\")\\n        cmd_counsel([item_id])\\n        counsel_after = latest_attempt_path(records_dir, \\\"counsel\\\")\\n        if counsel_after is not None and counsel_after != counsel_before:\\n            to_commit.append(counsel_after)\\n        # file-stops is its own idempotent read of the item's records, so\\n        # calling it here on every run that wrote a non-pass record is\\n        # safe to call again on a later run: an already-filed stop's own\\n        # marker is what stops it from being filed twice.\\n        cmd_file_stops([item_id])\\n\\n    message = f\\\"attavo: {stage} record for item {item_id} ({after.stem})\\\"\\n    try:\\n        commit_record(root, to_commit, message)\\n    except RuntimeError as exc:\\n        print(f\\\"attavo drive: stopped: could not commit the {stage} record: {exc}\\\")\\n        return 1\\n\\n    if has_origin(root):\\n        ok, err = push_record_commit(root, branch)\\n        if not ok:\\n            print(f\\\"attavo drive: stopped: could not push the {stage} record: {err}\\\")\\n            return 1\\n    else:\\n        print(f\\\"attavo drive: note: no origin remote; {after.name} is committed, not pushed\\\")\\n\\n    if status_out == \\\"halted\\\":\\n        question = (record.get(\\\"halted\\\") or {}).get(\\\"question\\\")\\n        print(f\\\"attavo drive: stopped: {stage} halted: {question} ({after.name}); \\\"\\n              f\\\"pushed to {branch}\\\")\\n    elif status_out != \\\"pass\\\":\\n        reason = record.get(\\\"refusal\\\") or status_out\\n        print(f\\\"attavo drive: stopped: {stage} {status_out}: {reason} ({after.name}); \\\"\\n              f\\\"pushed to {branch}\\\")\\n    else:\\n        print(f\\\"attavo drive: pushed {after.name} to {branch}\\\")\\n    return rc\\n\\n\\ndef cmd_worker(argv: list[str]) -> int:\\n    \\\"\\\"\\\"`attavo worker N <build|verify> NN`: the detached child a pass\\n    starts once its marker is pushed -- the lease held, the attempt is\\n    this worker's to run. Its own session (start_new_session, set by the\\n    pass that spawns it); its stdout and stderr are the pass's own\\n    redirect, to <git-dir>/attavo/<stage>-NN.worker.log.\\\"\\\"\\\"\\n    cast(io.TextIOWrapper, sys.stdout).reconfigure(line_buffering=True)\\n    if len(argv) != 3:\\n        print(\\\"attavo worker: usage: attavo worker N <build|verify> NN\\\", file=sys.stderr)\\n        return 2\\n    item_id, stage, nn_text = argv\\n    if stage not in (\\\"build\\\", \\\"verify\\\"):\\n        print(f\\\"attavo worker: {stage!r} is not build or verify\\\", file=sys.stderr)\\n        return 2\\n    try:\\n        nn = int(nn_text)\\n    except ValueError:\\n        print(f\\\"attavo worker: {nn_text!r} is not an attempt number\\\", file=sys.stderr)\\n        return 2\\n    return _stage_body(item_id, stage, nn)\\n\\n\\n# --- the pass's own two acts: start a stage (the lease), and recover\\n# exactly the one invocation the report names owed one. ---\\n\\ndef _start_stage(root: Path, m: dict[str, Any], item_id: str, stage: str,\\n                 forge_checks: dict[str, Any] | None) -> int:\\n    \\\"\\\"\\\"The lease (ruling A): the marker, committed and pushed as a plain\\n    fast-forward with no merge and no retry (push_lease). Lost to another\\n    pass, or refused outright by the remote, both undo the marker commit\\n    here (git reset --hard) so this checkout carries no half-taken\\n    attempt either way; only a pushed lease starts the worker. On a\\n    review, forge_checks is the checks this same pass already read on\\n    the pre-marker head (ruling B) -- written to\\n    <git-dir>/attavo/verify-NN.forge-checks.json and named in\\n    ATTAVO_FORGE_CHECKS, so the worker's own `attavo verify` reads it\\n    instead of polling.\\\"\\\"\\\"\\n    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n    nn = next_attempt_number(records_dir, stage)\\n    marker = write_invocation_marker(root, records_dir, stage, nn)\\n    try:\\n        commit_record(root, [marker], f\\\"attavo: {stage} invocation {nn:02d} started for item {item_id}\\\")\\n    except RuntimeError as exc:\\n        print(f\\\"attavo drive: stopped: could not commit the {stage} invocation marker: {exc}\\\")\\n        return 1\\n\\n    if has_origin(root):\\n        outcome, err = push_lease(root, branch)\\n        if outcome != \\\"pushed\\\":\\n            git(root, \\\"reset\\\", \\\"--hard\\\", \\\"HEAD^\\\")\\n            if outcome == \\\"lost-race\\\":\\n                print(f\\\"attavo drive: another pass holds this attempt ({marker.name}); nothing started\\\")\\n                return 0\\n            print(f\\\"attavo drive: stopped: could not push the {stage} invocation marker: {err}\\\")\\n            return 1\\n\\n    env = dict(os.environ)\\n    if forge_checks is not None:\\n        checks_file = forge_checks_path(root, stage, nn)\\n        checks_file.write_text(json.dumps(forge_checks))\\n        env[\\\"ATTAVO_FORGE_CHECKS\\\"] = str(checks_file)\\n    log = worker_log_path(root, stage, nn)\\n    with log.open(\\\"ab\\\") as fh, open(os.devnull, \\\"rb\\\") as devnull:\\n        proc = subprocess.Popen(\\n            [sys.executable, str(PRODUCT_ROOT / \\\"bin\\\" / \\\"attavo\\\"), \\\"worker\\\", item_id, stage, f\\\"{nn:02d}\\\"],\\n            cwd=str(root), env=env, stdin=devnull, stdout=fh, stderr=subprocess.STDOUT,\\n            start_new_session=True)\\n    word = \\\"Build\\\" if stage == \\\"build\\\" else \\\"Review\\\"\\n    print(f\\\"attavo drive: {word} started (attempt {nn:02d}, worker pid {proc.pid})\\\")\\n    return 0\\n\\n\\ndef _recover_one(root: Path, m: dict[str, Any], item_id: str, records_dir: Path) -> int:\\n    \\\"\\\"\\\"The pass's own recovery act (what `--recover` did): exactly the one\\n    invocation the report just read as owing one -- died or hung -- ends\\n    here. class died when the heartbeat is stale (or absent and the pid\\n    is gone), class hung when there is no heartbeat, the pid lives, and a\\n    declared [drive].stall_after_s has passed with no newer event, and\\n    terminated. Provenance product; the events tail as the log. Committed\\n    and pushed the way any stage record is (push_record_commit, with its\\n    own merge retry) -- this is not a race for a lease, since no new\\n    attempt marker is written.\\\"\\\"\\\"\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n    bound = stall_bound_s(m)\\n    pending = invocations_without_record(records_dir)\\n    readings = [(marker, info, read_invocation(root, bound, marker, info)) for marker, info in pending]\\n    candidate = next(((mk, i, rd) for mk, i, rd in readings if rd.cls != \\\"running\\\"), None)\\n    if candidate is None:\\n        # The report read this a moment ago; nothing owed recovery by the\\n        # time this pass got here (another pass recovered it, or it\\n        # finished on its own).\\n        return 0\\n    marker, info, reading = candidate\\n    stage, nn, log, last_at, age, cls, crossed = reading\\n    pid, host = info.get(\\\"pid\\\"), info.get(\\\"host\\\")\\n\\n    if next_attempt_number(records_dir, stage) != nn:\\n        print(f\\\"attavo drive: stopped: {marker.name} names attempt {nn} but the next \\\"\\n              f\\\"{stage} record would be {next_attempt_number(records_dir, stage):02d}; \\\"\\n              f\\\"a later record already exists, read the records before recovering\\\")\\n        return 1\\n\\n    if cls == \\\"hung\\\":\\n        try:\\n            os.kill(cast(int, pid), signal.SIGTERM)\\n            ended = \\\"terminated\\\"\\n        except OSError as exc:\\n            ended = f\\\"not terminated ({exc})\\\"\\n        if crossed == \\\"ceiling\\\":\\n            detail = (f\\\"pid {pid} on {host} alive {int(cast(float, age))} s after its marker, past \\\"\\n                      f\\\"the {stage} ceiling of {ceiling_s(m, stage)} s; {ended}\\\")\\n        else:\\n            detail = (f\\\"pid {pid} on {host} alive with no event for {int(cast(float, age))} s \\\"\\n                      f\\\"(bound {bound} s); {ended}\\\")\\n    else:\\n        detail = (f\\\"pid {pid} on {host} is not running and wrote no {marker.stem}.json; \\\"\\n                  f\\\"started {info.get('at')}, last event {last_at or 'none'}\\\")\\n\\n    schema = stage_schema(stage)\\n    record: dict[str, Any] = {k: None for k in schema.get(\\\"required\\\", [])}\\n    approval = latest_record(records_dir, \\\"approval\\\")\\n    signature_source = log.strip().splitlines()[-1] if log.strip() else detail\\n    record.update({\\\"sha\\\": info.get(\\\"sha\\\"), \\\"start_sha\\\": info.get(\\\"sha\\\"),\\n                   \\\"approval_sha\\\": approval.get(\\\"sha\\\") if approval else None,\\n                   \\\"at\\\": info.get(\\\"at\\\"),\\n                   \\\"adapter\\\": (m.get(\\\"executor\\\") or {}).get(stage),\\n                   \\\"status\\\": \\\"failed\\\", \\\"refusal\\\": None, \\\"halted\\\": None,\\n                   \\\"retry_of\\\": None, \\\"steer\\\": None,\\n                   \\\"stop\\\": {\\\"class\\\": cls, \\\"provenance\\\": \\\"product\\\", \\\"detail\\\": detail,\\n                            \\\"signature\\\": signature_of(signature_source), \\\"bound\\\": crossed}})\\n    if \\\"wall_clock_s\\\" in record:\\n        record[\\\"wall_clock_s\\\"] = None if age is None else int(age)\\n    record = {k: v for k, v in record.items() if k in schema.get(\\\"properties\\\", {})}\\n    try:\\n        path = write_record(records_dir, stage, record, m, item_id, log=log)\\n    except ValueError as exc:\\n        print(f\\\"attavo drive: stopped: could not write the {cls} record for {marker.stem}: {exc}\\\")\\n        return 1\\n    try:\\n        commit_record(root, [path], f\\\"attavo: {stage} record for item {item_id} \\\"\\n                                    f\\\"({path.stem}), recovered as {cls}\\\")\\n    except RuntimeError as exc:\\n        print(f\\\"attavo drive: stopped: could not commit the {cls} record: {exc}\\\")\\n        return 1\\n    if has_origin(root):\\n        ok, err = push_record_commit(root, branch)\\n        if not ok:\\n            print(f\\\"attavo drive: stopped: could not push the {cls} record: {err}\\\")\\n            return 1\\n    else:\\n        print(f\\\"attavo drive: note: no origin remote; {path.name} is committed, not pushed\\\")\\n    print(f\\\"attavo drive: recovered {marker.stem} as {cls}: {detail}\\\")\\n    return 0\\n\\n\\ndef _advance_again(root: Path, m: dict[str, Any], item_id: str, stage: str, head: str | None) -> int:\\n    \\\"\\\"\\\"`--again`'s own act on a stopped stage: exactly what next-build or\\n    next-review would do, bypassing the level a plain pass leaves alone\\n    for the operator. A review reads the forge fresh here -- once, since\\n    the report's own stopped reading never touched it -- rather than\\n    reusing a read that was never taken.\\\"\\\"\\\"\\n    if stage == \\\"build\\\":\\n        return _start_stage(root, m, item_id, \\\"build\\\", None)\\n    checks_command = (m.get(\\\"forge\\\") or {}).get(\\\"checks_command\\\")\\n    if not checks_command:\\n        print(\\\"attavo drive: refused: no [forge].checks_command in the manifest\\\")\\n        return 1\\n    forge_checks, ok = read_forge_checks(root, checks_command, cast(str, head))\\n    if not ok:\\n        conclusions = forge_checks[\\\"conclusions\\\"]\\n        named = \\\", \\\".join(f\\\"{c['name']} {c['conclusion']}\\\" for c in conclusions) or \\\"no checks reported\\\"\\n        print(f\\\"attavo drive: forge checks not green on {cast(str, head)[:12]}: {named}\\\")\\n        return 0\\n    return _start_stage(root, m, item_id, \\\"verify\\\", forge_checks)\\n\\n\\ndef _pass_once(root: Path, m: dict[str, Any], item_id: str, again: bool) -> tuple[int, \\\"DriveReport\\\"]:\\n    \\\"\\\"\\\"One pass: fast-forward to origin (never while a worker holds the\\n    copy), read the report, act at most once, return. The three acts,\\n    one per report state that is the product's move: owes-recovery\\n    recovers; next-build and next-review start their stage, handing a\\n    review the checks the report already read once on the pre-marker\\n    head. --again starts the next attempt of a stopped stage. Every\\n    other level is printed in the report's own words and left.\\\"\\\"\\\"\\n    from attavo.report import drive_report\\n    fast_forward_to_origin(root, m, item_id)\\n    r = drive_report(root, m, item_id)\\n\\n    if r[\\\"state\\\"] == \\\"owes-recovery\\\":\\n        records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n        return _recover_one(root, m, item_id, records_dir), r\\n    if r[\\\"state\\\"] == \\\"next-build\\\":\\n        return _start_stage(root, m, item_id, \\\"build\\\", None), r\\n    if r[\\\"state\\\"] == \\\"next-review\\\":\\n        checks_command = (m.get(\\\"forge\\\") or {}).get(\\\"checks_command\\\")\\n        forge_checks = {\\\"command\\\": checks_command, \\\"sha\\\": r[\\\"head\\\"], \\\"conclusions\\\": r[\\\"checks\\\"] or []}\\n        return _start_stage(root, m, item_id, \\\"verify\\\", forge_checks), r\\n    if again and r[\\\"state\\\"] == \\\"stopped\\\" and r[\\\"stage\\\"]:\\n        return _advance_again(root, m, item_id, r[\\\"stage\\\"], r[\\\"head\\\"]), r\\n\\n    print(f\\\"attavo drive: {r['says']}\\\")\\n    return (1 if r[\\\"state\\\"] == \\\"refused\\\" else 0), r\\n\\n\\n_TERMINAL_STATES = (\\\"waiting-on-approval\\\", \\\"stopped\\\", \\\"ready-to-merge\\\", \\\"merged\\\")\\n\\n\\ndef _until_ready(root: Path, m: dict[str, Any], item_id: str, again: bool) -> int:\\n    \\\"\\\"\\\"--until-ready: the pass, repeated in one process, sleeping\\n    ATTAVO_DRIVE_POLL_INTERVAL_S between passes, until the level is the\\n    operator's or done (exit 0), a concluded check is red (exit 1), or\\n    an unconcluded one has not concluded within ATTAVO_DRIVE_POLL_BOUND_S\\n    (exit 1). A stage running in its own worker is not bounded by this --\\n    only time spent waiting on the forge is.\\\"\\\"\\\"\\n    from attavo.verify import drive_forge_poll_bound_s, drive_forge_poll_interval_s\\n    bound = drive_forge_poll_bound_s()\\n    interval = drive_forge_poll_interval_s()\\n    waiting_since: float | None = None\\n    while True:\\n        rc, r = _pass_once(root, m, item_id, again)\\n        state = r[\\\"state\\\"]\\n\\n        if state == \\\"waiting-on-checks\\\":\\n            if waiting_since is None:\\n                waiting_since = time.monotonic()\\n            elif time.monotonic() - waiting_since >= bound:\\n                print(f\\\"attavo drive: stopped: the checks did not conclude within {bound:.0f}s\\\")\\n                return 1\\n        else:\\n            waiting_since = None\\n\\n        if rc != 0:\\n            return rc\\n        if state in _TERMINAL_STATES:\\n            return 0\\n        if state == \\\"blocked-on-checks\\\":\\n            return 1\\n        time.sleep(interval)\\n\\n\\ndef _drive_all() -> int:\\n    \\\"\\\"\\\"--all: one pass, in its own process, in every ../attavo-worktree-N\\n    beside this checkout -- each one derives its own item from its own\\n    attavo/N-* branch. Every line either prints is prefixed with the\\n    worktree's own directory name, so an operator reading them together\\n    can tell which item each line is about.\\\"\\\"\\\"\\n    root = Path(\\\".\\\").resolve()\\n    siblings = sorted(p for p in root.parent.glob(\\\"attavo-worktree-*\\\") if p.is_dir())\\n    if not siblings:\\n        print(\\\"attavo drive: --all found no ../attavo-worktree-N beside this checkout\\\")\\n        return 0\\n    worst = 0\\n    for copy in siblings:\\n        run = subprocess.run([sys.executable, str(PRODUCT_ROOT / \\\"bin\\\" / \\\"attavo\\\"), \\\"drive\\\"],\\n                             cwd=str(copy), capture_output=True, text=True, check=False)\\n        for line in (run.stdout + run.stderr).splitlines():\\n            print(f\\\"{copy.name}: {line}\\\")\\n        worst = max(worst, run.returncode)\\n    return worst\\n\\n\\ndef cmd_drive(argv: list[str]) -> int:\\n    # Issue #145: Python block-buffers stdout when it is not a tty (a\\n    # pipe, e.g. a screen reading this process live), so every line this\\n    # prints would otherwise sit unflushed until the process exits.\\n    # Line-buffering makes a pipe reader see each line the moment it is\\n    # printed, the same as a terminal already does; `attavo worker`\\n    # reconfigures its own stdout the same way.\\n    cast(io.TextIOWrapper, sys.stdout).reconfigure(line_buffering=True)\\n\\n    if \\\"--recover\\\" in argv:\\n        print(\\\"attavo drive: --recover is gone; a pass recovers a dead or hung invocation \\\"\\n              \\\"itself, as soon as the report owes one\\\", file=sys.stderr)\\n        return 2\\n\\n    until_ready = \\\"--until-ready\\\" in argv\\n    report = \\\"--report\\\" in argv\\n    again = \\\"--again\\\" in argv\\n    all_flag = \\\"--all\\\" in argv\\n    positional = [a for a in argv if not a.startswith(\\\"--\\\")]\\n\\n    if all_flag:\\n        if until_ready or report or again or positional:\\n            print(\\\"attavo drive: --all runs one pass in every worktree beside this checkout; \\\"\\n                  \\\"drop N and every other flag\\\", file=sys.stderr)\\n            return 2\\n        return _drive_all()\\n\\n    root = Path(\\\".\\\").resolve()\\n    item_id = positional[0] if positional else derive_item_id(root)\\n    if not item_id:\\n        print(\\\"attavo drive: cannot derive item id; pass N or run on an attavo/N-* branch\\\",\\n              file=sys.stderr)\\n        return 2\\n    m = read_manifest(root)\\n    if m is None:\\n        print(f\\\"attavo drive: no {MANIFEST} at {root}\\\", file=sys.stderr)\\n        return 2\\n\\n    if report:\\n        if until_ready or again:\\n            print(\\\"attavo drive: --report reads and does nothing else; drop --until-ready \\\"\\n                  \\\"and --again\\\", file=sys.stderr)\\n            return 2\\n        fast_forward_to_origin(root, m, item_id)\\n        from attavo.report import drive_report\\n        print(json.dumps(drive_report(root, m, item_id), indent=2))\\n        return 0\\n\\n    if until_ready:\\n        return _until_ready(root, m, item_id, again)\\n    rc, _ = _pass_once(root, m, item_id, again)\\n    return rc\\n\",\"structuredPatch\":[{\"oldStart\":503,\"oldLines\":7,\"newStart\":503,\"newLines\":7,\"lines\":[\" # exactly the one invocation the report names owed one. ---\",\" \",\" def _start_stage(root: Path, m: dict[str, Any], item_id: str, stage: str,\",\"-                 forge_checks: dict[str, Any] | None) -> int:\",\"+                 forge_checks: dict[str, Any] | None, *, again_by: bool = False) -> int:\",\"     \\\"\\\"\\\"The lease (ruling A): the marker, committed and pushed as a plain\",\"     fast-forward with no merge and no retry (push_lease). Lost to another\",\"     pass, or refused outright by the remote, both undo the marker commit\"]},{\"oldStart\":513,\"oldLines\":11,\"newStart\":513,\"newLines\":12,\"lines\":[\"     the pre-marker head (ruling B) -- written to\",\"     <git-dir>/attavo/verify-NN.forge-checks.json and named in\",\"     ATTAVO_FORGE_CHECKS, so the worker's own `attavo verify` reads it\",\"-    instead of polling.\\\"\\\"\\\"\",\"+    instead of polling. R3: again_by names the marker as `--again`'s own\",\"+    act on a stage whose budget was already spent.\\\"\\\"\\\"\",\"     records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\",\"     branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\",\"     nn = next_attempt_number(records_dir, stage)\",\"-    marker = write_invocation_marker(root, records_dir, stage, nn)\",\"+    marker = write_invocation_marker(root, records_dir, stage, nn, again_by=again_by)\",\"     try:\",\"         commit_record(root, [marker], f\\\"attavo: {stage} invocation {nn:02d} started for item {item_id}\\\")\",\"     except RuntimeError as exc:\"]}],\"userModified\":false,\"replaceAll\":false,\"contentNotInModelContext\":true}}\n2338:+{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01CxXc6wLprj2e7trqwzZu6f\",\"type\":\"tool_result\",\"content\":\"The file /Users/davidbean/Projects/attavo-worktree-219/attavo/drive.py has been updated successfully.\"}]},\"parent_tool_use_id\":null,\"session_id\":\"0dd7ed4f-100c-4188-9a34-077aa0b6aa25\",\"uuid\":\"7872f559-ef63-4f02-a642-7f082925559a\",\"timestamp\":\"2026-09-26T02:27:42.519Z\",\"tool_use_result\":{\"filePath\":\"/Users/davidbean/Projects/attavo-worktree-219/attavo/drive.py\",\"oldString\":\"def _advance_again(root: Path, m: dict[str, Any], item_id: str, stage: str, head: str | None) -> int:\\n    \\\"\\\"\\\"`--again`'s own act on a stopped stage: exactly what next-build or\\n    next-review would do, bypassing the level a plain pass leaves alone\\n    for the operator. A review reads the forge fresh here -- once, since\\n    the report's own stopped reading never touched it -- rather than\\n    reusing a read that was never taken.\\\"\\\"\\\"\\n    if stage == \\\"build\\\":\\n        return _start_stage(root, m, item_id, \\\"build\\\", None)\\n    checks_command = (m.get(\\\"forge\\\") or {}).get(\\\"checks_command\\\")\\n    if not checks_command:\\n        print(\\\"attavo drive: refused: no [forge].checks_command in the manifest\\\")\\n        return 1\\n    forge_checks, ok = read_forge_checks(root, checks_command, cast(str, head))\\n    if not ok:\\n        conclusions = forge_checks[\\\"conclusions\\\"]\\n        named = \\\", \\\".join(f\\\"{c['name']} {c['conclusion']}\\\" for c in conclusions) or \\\"no checks reported\\\"\\n        print(f\\\"attavo drive: forge checks not green on {cast(str, head)[:12]}: {named}\\\")\\n        return 0\\n    return _start_stage(root, m, item_id, \\\"verify\\\", forge_checks)\\n\\n\\ndef _pass_once(root: Path, m: dict[str, Any], item_id: str, again: bool) -> tuple[int, \\\"DriveReport\\\"]:\\n    \\\"\\\"\\\"One pass: fast-forward to origin (never while a worker holds the\\n    copy), read the report, act at most once, return. The three acts,\\n    one per report state that is the product's move: owes-recovery\\n    recovers; next-build and next-review start their stage, handing a\\n    review the checks the report already read once on the pre-marker\\n    head. --again starts the next attempt of a stopped stage. Every\\n    other level is printed in the report's own words and left.\\\"\\\"\\\"\\n    from attavo.report import drive_report\\n    fast_forward_to_origin(root, m, item_id)\\n    r = drive_report(root, m, item_id)\\n\\n    if r[\\\"state\\\"] == \\\"owes-recovery\\\":\\n        records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n        return _recover_one(root, m, item_id, records_dir), r\\n    if r[\\\"state\\\"] == \\\"next-build\\\":\\n        return _start_stage(root, m, item_id, \\\"build\\\", None), r\\n    if r[\\\"state\\\"] == \\\"next-review\\\":\\n        checks_command = (m.get(\\\"forge\\\") or {}).get(\\\"checks_command\\\")\\n        forge_checks = {\\\"command\\\": checks_command, \\\"sha\\\": r[\\\"head\\\"], \\\"conclusions\\\": r[\\\"checks\\\"] or []}\\n        return _start_stage(root, m, item_id, \\\"verify\\\", forge_checks), r\\n    if again and r[\\\"state\\\"] == \\\"stopped\\\" and r[\\\"stage\\\"]:\\n        return _advance_again(root, m, item_id, r[\\\"stage\\\"], r[\\\"head\\\"]), r\\n\\n    print(f\\\"attavo drive: {r['says']}\\\")\\n    return (1 if r[\\\"state\\\"] == \\\"refused\\\" else 0), r\",\"newString\":\"def _advance_again(root: Path, m: dict[str, Any], item_id: str, stage: str, head: str | None, *,\\n                   again_by: bool = False) -> int:\\n    \\\"\\\"\\\"The next attempt of a stopped stage: exactly what next-build or\\n    next-review would do, bypassing the level a plain pass leaves alone\\n    for the operator -- the pass's own automatic retry of a retryable\\n    family, or `--again`'s act once a budget is spent (again_by). A\\n    review reads the forge fresh here -- once, since the report's own\\n    stopped reading never touched it -- rather than reusing a read that\\n    was never taken.\\\"\\\"\\\"\\n    if stage == \\\"build\\\":\\n        return _start_stage(root, m, item_id, \\\"build\\\", None, again_by=again_by)\\n    checks_command = (m.get(\\\"forge\\\") or {}).get(\\\"checks_command\\\")\\n    if not checks_command:\\n        print(\\\"attavo drive: refused: no [forge].checks_command in the manifest\\\")\\n        return 1\\n    forge_checks, ok = read_forge_checks(root, checks_command, cast(str, head))\\n    if not ok:\\n        conclusions = forge_checks[\\\"conclusions\\\"]\\n        named = \\\", \\\".join(f\\\"{c['name']} {c['conclusion']}\\\" for c in conclusions) or \\\"no checks reported\\\"\\n        print(f\\\"attavo drive: forge checks not green on {cast(str, head)[:12]}: {named}\\\")\\n        return 0\\n    return _start_stage(root, m, item_id, \\\"verify\\\", forge_checks, again_by=again_by)\\n\\n\\ndef _retry_target(r: \\\"DriveReport\\\") -> str:\\n    \\\"\\\"\\\"The stage the next attempt actually starts: class \\\"returned\\\" (a\\n    build's head a check rejected, or a review's own blocking finding) is\\n    always the verify record's own stop, but the retry it starts is the\\n    next build.\\\"\\\"\\\"\\n    return \\\"build\\\" if r[\\\"stop_class\\\"] == \\\"returned\\\" else cast(str, r[\\\"stage\\\"])\\n\\n\\ndef _retry_due(root: Path, m: dict[str, Any], item_id: str, r: \\\"DriveReport\\\") -> bool:\\n    \\\"\\\"\\\"R3: a stopped stage whose class is one of the four retryable\\n    families, whose budget is not spent, whose last two signatures\\n    differ, and -- for transient -- whose record has aged past\\n    [drive].retry_after_s, is retried by the next plain pass, no\\n    counsel, no operator act.\\\"\\\"\\\"\\n    if r[\\\"stop_class\\\"] not in RETRYABLE_CLASSES:\\n        return False\\n    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n    sig_stage = cast(str, r[\\\"stage\\\"])\\n    budget_stage = _retry_target(r)\\n    if stage_exhausted(records_dir, m, sig_stage, budget_stage):\\n        return False\\n    if r[\\\"stop_class\\\"] == \\\"transient\\\":\\n        attempts = parse_attempts(records_dir, sig_stage)\\n        latest = attempts[max(attempts)] if attempts else {}\\n        age = _seconds_since(latest.get(\\\"at\\\"))\\n        if age is None or age < retry_after_s(m):\\n            return False\\n    return True\\n\\n\\ndef _handle_again(root: Path, m: dict[str, Any], item_id: str, r: \\\"DriveReport\\\") -> int:\\n    \\\"\\\"\\\"`--again`'s own act on a stopped stage (R3): a retryable family\\n    whose budget is not spent is left to the pass's own automatic retry\\n    -- a no-op here, saying so -- since starting it twice would spend two\\n    attempts on one press. A retryable family whose budget is spent, or\\n    any other stopped class, starts the next attempt at once, its marker\\n    naming --again as what started it.\\\"\\\"\\\"\\n    stage = _retry_target(r)\\n    if r[\\\"stop_class\\\"] in RETRYABLE_CLASSES:\\n        records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n        if not stage_exhausted(records_dir, m, cast(str, r[\\\"stage\\\"]), stage):\\n            print(\\\"attavo drive: --again is a no-op inside the budget; the pass retries on its own\\\")\\n            return 0\\n    return _advance_again(root, m, item_id, stage, r[\\\"head\\\"], again_by=True)\\n\\n\\ndef _counsel_answered(records_dir: Path, r: \\\"DriveReport\\\") -> bool:\\n    \\\"\\\"\\\"R3: whether the stop this report just read as \\\"stopped\\\" already\\n    carries counsel's own \\\"answer\\\" verdict -- every non-retryable class\\n    is counsel's to read (as before this item), and `answer` starts the\\n    next attempt with the answer as its steer, read from the feedback\\n    file the retried attempt's own first iteration is handed\\n    (attavo.build._retry_seed).\\\"\\\"\\\"\\n    if r[\\\"stop_class\\\"] in RETRYABLE_CLASSES or not r[\\\"stage\\\"] or r[\\\"attempt\\\"] is None:\\n        return False\\n    counsel = counsel_record_for(records_dir, cast(str, r[\\\"stage\\\"]), cast(int, r[\\\"attempt\\\"]))\\n    return counsel is not None and counsel.get(\\\"verdict\\\") == \\\"answer\\\"\\n\\n\\ndef _pass_once(root: Path, m: dict[str, Any], item_id: str, again: bool) -> tuple[int, \\\"DriveReport\\\"]:\\n    \\\"\\\"\\\"One pass: fast-forward to origin (never while a worker holds the\\n    copy), read the report, act at most once, return. The three acts,\\n    one per report state that is the product's move: owes-recovery\\n    recovers; next-build and next-review start their stage, handing a\\n    review the checks the report already read once on the pre-marker\\n    head; a concluded red check on a passed build's head (R3) is a\\n    returned review record, not a level, so the review starts the same\\n    way. On a stopped stage, `--again` always wins (a no-op inside the\\n    budget, the next attempt once it is spent); absent it, a retryable\\n    family retries on its own, and any other stop counsel has already\\n    answered starts the next attempt steered by that answer. Every other\\n    level is printed in the report's own words and left.\\\"\\\"\\\"\\n    from attavo.report import drive_report\\n    fast_forward_to_origin(root, m, item_id)\\n    r = drive_report(root, m, item_id)\\n\\n    if r[\\\"state\\\"] == \\\"owes-recovery\\\":\\n        records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n        return _recover_one(root, m, item_id, records_dir), r\\n    if r[\\\"state\\\"] == \\\"next-build\\\":\\n        return _start_stage(root, m, item_id, \\\"build\\\", None), r\\n    if r[\\\"state\\\"] == \\\"next-review\\\":\\n        checks_command = (m.get(\\\"forge\\\") or {}).get(\\\"checks_command\\\")\\n        forge_checks = {\\\"command\\\": checks_command, \\\"sha\\\": r[\\\"head\\\"], \\\"conclusions\\\": r[\\\"checks\\\"] or []}\\n        return _start_stage(root, m, item_id, \\\"verify\\\", forge_checks), r\\n    if r[\\\"state\\\"] == \\\"blocked-on-checks\\\" and r[\\\"stage\\\"] == \\\"verify\\\":\\n        # R3: the rejection is a record, not a level with nothing behind\\n        # it (#206's build-01) -- the review starts, reading the same\\n        # forge checks this pass just read, and writes the check\\n        # rejection itself as a returned record (attavo.verify.cmd_verify).\\n        checks_command = (m.get(\\\"forge\\\") or {}).get(\\\"checks_command\\\")\\n        forge_checks = {\\\"command\\\": checks_command, \\\"sha\\\": r[\\\"head\\\"], \\\"conclusions\\\": r[\\\"checks\\\"] or []}\\n        return _start_stage(root, m, item_id, \\\"verify\\\", forge_checks), r\\n    if r[\\\"state\\\"] == \\\"stopped\\\" and r[\\\"stage\\\"]:\\n        if again:\\n            return _handle_again(root, m, item_id, r), r\\n        records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n        if _retry_due(root, m, item_id, r):\\n            return _advance_again(root, m, item_id, _retry_target(r), r[\\\"head\\\"]), r\\n        if _counsel_answered(records_dir, r):\\n            return _advance_again(root, m, item_id, _retry_target(r), r[\\\"head\\\"]), r\\n\\n    print(f\\\"attavo drive: {r['says']}\\\")\\n    return (1 if r[\\\"state\\\"] == \\\"refused\\\" else 0), r\",\"originalFile\":\"from __future__ import annotations\\n\\nimport io\\nimport json\\nimport os\\nimport signal\\nimport subprocess\\nimport sys\\nimport threading\\nimport time\\nfrom pathlib import Path\\nfrom typing import TYPE_CHECKING, Any, NamedTuple, cast\\n\\nfrom attavo.approval import approval_status\\nfrom attavo.build import cmd_build, driver_identity\\nfrom attavo.common import MANIFEST, PRODUCT_ROOT, derive_item_id, git, read_manifest\\nfrom attavo.counsel import cmd_counsel\\nfrom attavo.doctor import (\\n    _parse_json_line,\\n    attempts_budget,\\n    ceiling_s,\\n    invocation_alive,\\n    invocations_without_record,\\n    retry_after_s,\\n    stall_bound_s,\\n    write_invocation_marker,\\n)\\nfrom attavo.events import stage_events_dir\\nfrom attavo.filing import cmd_file_stops\\nfrom attavo.records import (\\n    latest_attempt_path,\\n    latest_record,\\n    next_attempt_number,\\n    parse_attempts,\\n    stage_schema,\\n    write_record,\\n)\\nfrom attavo.stops import RETRYABLE_CLASSES, counsel_record_for, signature_of, stage_exhausted\\nfrom attavo.verify import cmd_verify, read_forge_checks\\n\\nif TYPE_CHECKING:\\n    from attavo.types import DriveReport\\n\\n# --- drive: the mechanical transitions between approval and ready-to-merge\\n# (issue #84), under the reconciler's R2 (rulings A, B, C's recovery half,\\n# F, G, H): `attavo drive N` is one short pass. It reads the report\\n# (attavo.report), acts at most once -- recovers a dead or hung\\n# invocation, or starts the next stage in a detached worker -- and\\n# returns within seconds; the stage itself runs in `attavo worker`, a\\n# child of the pass's own session, which outlives it. Writes no record of\\n# its own: the stage records already on disk, and the invocation markers\\n# and heartbeats beside them, are the only state a pass or a worker\\n# reads. ---\\n\\n\\ndef commit_record(root: Path, record_paths: Path | list[Path], message: str) -> None:\\n    \\\"\\\"\\\"`git commit --only` on every record path given, and each one's .log\\n    and .filed, each if one exists -- never the whole index. A transport\\n    commit that sweeps the index is exactly the regression issue #46\\n    already guards build and verify against on the adapter side; drive\\n    must not reintroduce it on the transport side. The .filed marker\\n    (issue #89) is committed alongside the record it names, in the same\\n    commit and the same push, so a second worktree or a fresh clone reads\\n    the same filed fact rather than refiling every stop it finds with no\\n    marker of its own. A single Path is accepted for the common one-record\\n    case; issue #100 passes a list so the counsel record lands in the same\\n    commit as the stage record it counsels. Authored and committed as\\n    driver_identity(), set by the product and never the tenant's git\\n    config, so a driven item's record commits are never indistinguishable\\n    from an operator's own.\\\"\\\"\\\"\\n    if isinstance(record_paths, Path):\\n        record_paths = [record_paths]\\n    paths: list[str] = []\\n    for record_path in record_paths:\\n        paths.append(str(record_path.relative_to(root)))\\n        log_path = record_path.with_suffix(\\\".log\\\")\\n        if log_path.is_file():\\n            paths.append(str(log_path.relative_to(root)))\\n        marker_path = record_path.with_suffix(\\\".filed\\\")\\n        if marker_path.is_file():\\n            paths.append(str(marker_path.relative_to(root)))\\n    identity = driver_identity()\\n    env = dict(os.environ)\\n    env[\\\"GIT_AUTHOR_NAME\\\"] = identity[\\\"name\\\"]\\n    env[\\\"GIT_AUTHOR_EMAIL\\\"] = identity[\\\"email\\\"]\\n    env[\\\"GIT_COMMITTER_NAME\\\"] = identity[\\\"name\\\"]\\n    env[\\\"GIT_COMMITTER_EMAIL\\\"] = identity[\\\"email\\\"]\\n    git(root, \\\"add\\\", *paths)\\n    git(root, \\\"commit\\\", \\\"--only\\\", \\\"-m\\\", message, *paths, env=env)\\n\\n\\ndef push_record_commit(root: Path, branch: str) -> tuple[bool, str | None]:\\n    \\\"\\\"\\\"Push HEAD to branch on origin. A push a divergent remote rejects is\\n    retried once after `git pull --no-rebase --no-edit origin branch` -- a\\n    merge, never a rebase, because a rebase would change the sha the record\\n    commit just wrote already names. This is the record push's own retry\\n    -- the worker's, once it has the lease -- distinct from push_lease\\n    below, which never retries.\\\"\\\"\\\"\\n    def attempt() -> tuple[bool, str]:\\n        run = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"push\\\", \\\"origin\\\", f\\\"HEAD:{branch}\\\"],\\n                             capture_output=True, text=True, check=False)\\n        return run.returncode == 0, run.stderr.strip()\\n\\n    ok, err = attempt()\\n    if ok:\\n        return True, None\\n    pull = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"pull\\\", \\\"--no-rebase\\\", \\\"--no-edit\\\",\\n                           \\\"origin\\\", branch], capture_output=True, text=True, check=False)\\n    if pull.returncode != 0:\\n        return False, f\\\"push rejected and the retry merge failed: {pull.stderr.strip() or err}\\\"\\n    ok, err = attempt()\\n    if not ok:\\n        return False, f\\\"push rejected again after merging {branch}: {err}\\\"\\n    return True, None\\n\\n\\n_RACE_MARKERS = (\\\"non-fast-forward\\\", \\\"fetch first\\\", \\\"stale info\\\", \\\"cannot lock ref\\\",\\n                 \\\"failed to update ref\\\")\\n\\n\\ndef push_lease(root: Path, branch: str) -> tuple[str, str | None]:\\n    \\\"\\\"\\\"Push HEAD to branch on origin as a plain fast-forward -- no merge,\\n    no retry: this is the lease the marker commit takes on the attempt it\\n    names (ruling A). (\\\"pushed\\\", None) on success.\\n\\n    (\\\"lost-race\\\", stderr) when git's own ref check is what rejected it --\\n    the branch moved since this pass fast-forwarded to it (a sequential\\n    \\\"[rejected] ... (fetch first)\\\"), or the remote's own ref transaction\\n    lost a genuine simultaneous push (\\\"[remote rejected] ... (failed to\\n    update ref)\\\", \\\"cannot lock ref\\\"): either way, another pass's own\\n    marker (or record) landed there first. The pass that reads this is\\n    the loser: it says so, resets its own marker commit, and starts\\n    nothing.\\n\\n    (\\\"refused\\\", stderr) for every other rejection -- a remote that\\n    refuses the push outright (a hook, a permission, an unreachable\\n    remote). This is not a race for the lease; it is a refusal, and ends\\n    the pass with exit 1.\\\"\\\"\\\"\\n    run = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"push\\\", \\\"origin\\\", f\\\"HEAD:{branch}\\\"],\\n                         capture_output=True, text=True, check=False)\\n    if run.returncode == 0:\\n        return \\\"pushed\\\", None\\n    stderr = run.stderr\\n    if any(marker in stderr for marker in _RACE_MARKERS):\\n        return \\\"lost-race\\\", stderr.strip()\\n    return \\\"refused\\\", stderr.strip()\\n\\n\\ndef has_origin(root: Path) -> bool:\\n    \\\"\\\"\\\"Whether this checkout carries an origin remote at all -- a fixture\\n    or a scratch checkout with none is not a refusal; a pass commits\\n    locally and skips the push, the way recovery always has.\\\"\\\"\\\"\\n    try:\\n        git(root, \\\"remote\\\", \\\"get-url\\\", \\\"origin\\\")\\n        return True\\n    except RuntimeError:\\n        return False\\n\\n\\ndef drive_state(root: Path, m: dict[str, Any], item_id: str) -> tuple[str, str | None, Path]:\\n    \\\"\\\"\\\"(\\\"no-approval\\\" | \\\"build\\\" | \\\"verify\\\" | \\\"ready\\\", detail, records_dir):\\n    the next mechanical step for item_id, read from its latest records\\n    alone. A build only counts as current when it is a pass bound to the\\n    valid approval's own sha; a verify only counts as current when it is a\\n    pass bound to that build's own sha -- the same staleness a re-approval\\n    or a re-build must force, attest's own chain check already enforces\\n    (check_attest_chain), read here rather than re-typed.\\\"\\\"\\\"\\n    records_rel = m[\\\"paths\\\"][\\\"records\\\"]\\n    records_dir = root / records_rel / item_id\\n\\n    status = approval_status(root, m, item_id)\\n    if status != \\\"valid\\\":\\n        return \\\"no-approval\\\", status, records_dir\\n\\n    latest_approval = latest_record(records_dir, \\\"approval\\\")\\n    latest_build = latest_record(records_dir, \\\"build\\\")\\n    build_current = (latest_build is not None and latest_build.get(\\\"status\\\") == \\\"pass\\\"\\n                     and latest_build.get(\\\"approval_sha\\\")\\n                     == (latest_approval.get(\\\"sha\\\") if latest_approval else None))\\n    if latest_build is None or not build_current:\\n        return \\\"build\\\", None, records_dir\\n\\n    latest_verify = latest_record(records_dir, \\\"verify\\\")\\n    verify_current = (latest_verify is not None and latest_verify.get(\\\"status\\\") == \\\"pass\\\"\\n                      and latest_verify.get(\\\"build_sha\\\") == latest_build.get(\\\"sha\\\"))\\n    if not verify_current:\\n        return \\\"verify\\\", None, records_dir\\n\\n    return \\\"ready\\\", None, records_dir\\n\\n\\n# --- the heartbeat, the worker log, and the forge-checks handoff: local\\n# facts under the checkout's own git directory (issue #140's precedent),\\n# never committed and never among the paths commit_record ever names. ---\\n\\ndef heartbeat_s() -> float:\\n    return float(os.environ.get(\\\"ATTAVO_HEARTBEAT_S\\\", 15))\\n\\n\\ndef heartbeat_path(root: Path, stage: str, nn: int) -> Path:\\n    return stage_events_dir(root) / f\\\"{stage}-{nn:02d}.heartbeat\\\"\\n\\n\\ndef worker_log_path(root: Path, stage: str, nn: int) -> Path:\\n    return stage_events_dir(root) / f\\\"{stage}-{nn:02d}.worker.log\\\"\\n\\n\\ndef forge_checks_path(root: Path, stage: str, nn: int) -> Path:\\n    return stage_events_dir(root) / f\\\"{stage}-{nn:02d}.forge-checks.json\\\"\\n\\n\\ndef _events_path_for(root: Path, stage: str, nn: int) -> Path | None:\\n    \\\"\\\"\\\"The adapter's own events file for this invocation, under the\\n    checkout's git dir (a worktree's own dir when the checkout is one).\\\"\\\"\\\"\\n    try:\\n        gitdir = Path(git(root, \\\"rev-parse\\\", \\\"--git-dir\\\").strip())\\n    except RuntimeError:\\n        return None\\n    if not gitdir.is_absolute():\\n        gitdir = root / gitdir\\n    path = gitdir / \\\"attavo\\\" / f\\\"{stage}-{nn:02d}.events.jsonl\\\"\\n    return path if path.is_file() else None\\n\\n\\ndef _events_tail(path: Path | None, lines: int = 20) -> tuple[str, str | None]:\\n    \\\"\\\"\\\"(the last lines as a log, the last event's own at).\\\"\\\"\\\"\\n    if path is None:\\n        return \\\"no events file for this invocation\\\\n\\\", None\\n    try:\\n        text = path.read_text()\\n    except OSError:\\n        return \\\"events file unreadable\\\\n\\\", None\\n    tail = text.splitlines()[-lines:]\\n    last_at = None\\n    for line in reversed(tail):\\n        parsed = _parse_json_line(line)\\n        if not isinstance(parsed, dict):\\n            continue\\n        at = parsed.get(\\\"at\\\")\\n        if isinstance(at, str):\\n            last_at = at\\n            break\\n    return \\\"\\\\n\\\".join(tail) + \\\"\\\\n\\\", last_at\\n\\n\\ndef _seconds_since(at: str | None) -> float | None:\\n    from datetime import datetime, timezone\\n    if not at:\\n        return None\\n    try:\\n        then = datetime.strptime(at, \\\"%Y-%m-%dT%H:%M:%SZ\\\").replace(tzinfo=timezone.utc)\\n    except ValueError:\\n        return None\\n    return (datetime.now(timezone.utc) - then).total_seconds()\\n\\n\\nclass InvocationReading(NamedTuple):\\n    \\\"\\\"\\\"What one marker with no record reads as, from here and now.\\\"\\\"\\\"\\n    stage: str\\n    nn: int\\n    log: str\\n    last_at: str | None\\n    age: float | None\\n    cls: str  # \\\"running\\\" | \\\"hung\\\" | \\\"died\\\"\\n    bound: str | None = None  # R3: \\\"stall\\\" or \\\"ceiling\\\" when cls is \\\"hung\\\"\\n\\n\\ndef read_invocation(root: Path, bound: int | None, marker: Path, info: dict[str, Any]) -> InvocationReading:\\n    \\\"\\\"\\\"Whether an invocation that began and wrote no record is running,\\n    hung, or died -- read from its own heartbeat first (R2): a heartbeat\\n    file fresh within three beats of ATTAVO_HEARTBEAT_S is alive; a stale\\n    one is died, whether or not the pid still lives -- a worker stuck\\n    somewhere that never reaches its own heartbeat loop again is exactly\\n    what this is for. Only with no heartbeat file at all -- an invocation\\n    from before this release, or one that died before touching its\\n    first beat -- does this fall back to the pid: alive and, with a\\n    stall bound declared, past it is hung; alive with no bound, or\\n    within it, is running for as long as it lives; not alive is died.\\n    The stall bound decides hung, never died.\\\"\\\"\\\"\\n    stage, nn_text = marker.stem.rsplit(\\\"-\\\", 1)\\n    nn = int(nn_text)\\n    log, last_at = _events_tail(_events_path_for(root, stage, nn))\\n    # R3: the stage ceiling, wall clock from the marker's own `at`, judged\\n    # before any liveness signal -- alive past it is hung by the ceiling,\\n    # whatever its event age (or absence of one) says.\\n    m = read_manifest(root) or {}\\n    ceiling = ceiling_s(m, stage)\\n    since_start = _seconds_since(info.get(\\\"at\\\"))\\n    if ceiling is not None and since_start is not None and since_start > ceiling:\\n        return InvocationReading(stage, nn, log, last_at, since_start, \\\"hung\\\", \\\"ceiling\\\")\\n    if not _streams_events(root, m, stage):\\n        # An adapter that declares it streams no events is judged by the\\n        # ceiling alone; the stall bound it can never trip is not asked.\\n        bound = None\\n    beat = heartbeat_path(root, stage, nn)\\n    if beat.is_file():\\n        try:\\n            beat_age = time.time() - beat.stat().st_mtime\\n        except OSError:\\n            beat_age = None\\n        cls = \\\"running\\\" if beat_age is not None and beat_age <= heartbeat_s() * 3 else \\\"died\\\"\\n        return InvocationReading(stage, nn, log, last_at, beat_age, cls)\\n    age = _seconds_since(last_at or info.get(\\\"at\\\"))\\n    if not invocation_alive(info):\\n        return InvocationReading(stage, nn, log, last_at, age, \\\"died\\\")\\n    if bound is None or age is None or age <= bound:\\n        return InvocationReading(stage, nn, log, last_at, age, \\\"running\\\")\\n    return InvocationReading(stage, nn, log, last_at, age, \\\"hung\\\", \\\"stall\\\")\\n\\n\\ndef _streams_events(root: Path, m: dict[str, Any], stage: str) -> bool:\\n    \\\"\\\"\\\"R3: whether the stage's adapter declares it streams events\\n    (adapters/<name>/conformance.json, \\\"streams_events\\\"); true when the\\n    adapter names none, or its conformance.json does not say.\\\"\\\"\\\"\\n    name = (m.get(\\\"executor\\\") or {}).get(stage) or (m.get(\\\"executor\\\") or {}).get(\\\"build\\\")\\n    if not name:\\n        return True\\n    for base in (root / \\\"attavo\\\" / \\\"adapters\\\", PRODUCT_ROOT / \\\"adapters\\\"):\\n        conf = base / name / \\\"conformance.json\\\"\\n        if conf.is_file():\\n            try:\\n                return bool(json.loads(conf.read_text()).get(\\\"streams_events\\\", True))\\n            except (OSError, ValueError):\\n                return True\\n    return True\\n\\n\\ndef uncommitted_record(root: Path, records_dir: Path, stage: str) -> Path | None:\\n    \\\"\\\"\\\"The latest <stage>-NN.json this working tree carries that git has\\n    no commit for yet -- the moment between a worker's write and its own\\n    commit. None when the latest record is already committed, or there\\n    is none at all.\\\"\\\"\\\"\\n    path = latest_attempt_path(records_dir, stage)\\n    if path is None or not path.is_file():\\n        return None\\n    status = subprocess.run(\\n        [\\\"git\\\", \\\"-C\\\", str(root), \\\"status\\\", \\\"--porcelain\\\", \\\"--\\\", str(path.relative_to(root))],\\n        capture_output=True, text=True, check=False)\\n    return path if status.stdout.strip() else None\\n\\n\\ndef worker_holds_copy(root: Path, records_dir: Path) -> bool:\\n    \\\"\\\"\\\"True when this checkout's own working tree cannot safely be moved\\n    -- an invocation marker with no record yet (a worker, here or\\n    elsewhere, still holds this attempt), or a build or verify record the\\n    working tree carries that git has not committed yet. Scoped to the\\n    stage records a pass or a worker itself ever transports -- an\\n    operator's own spec-gate or approve, routinely uncommitted between\\n    their own act and the next pass, is not this. A pass never\\n    fast-forwards while this holds (never while a worker holds the\\n    copy).\\\"\\\"\\\"\\n    if invocations_without_record(records_dir):\\n        return True\\n    return (uncommitted_record(root, records_dir, \\\"build\\\") is not None\\n           or uncommitted_record(root, records_dir, \\\"verify\\\") is not None)\\n\\n\\ndef fast_forward_to_origin(root: Path, m: dict[str, Any], item_id: str) -> None:\\n    \\\"\\\"\\\"The pass's own read of origin's branch, taken before it reads\\n    anything else -- a commit landed there from elsewhere (an approval\\n    from the screen, a ruling, another pass's own record) is not a race\\n    for the lease, it is exactly what the lease is for. Never while a\\n    worker holds this copy (worker_holds_copy): resetting a working tree\\n    a detached child is still writing into would corrupt its own commits.\\n    A plain fast-forward when origin is simply ahead; when this checkout\\n    also carries its own commits origin has not seen yet (an operator's\\n    approval, not yet pushed), those are replayed on top of origin's own\\n    tip instead -- no merge commit, and the marker this pass is about to\\n    write still lands as a fast-forward when it pushes. Silent about\\n    everything short of that -- a real conflict, or an absent origin, is\\n    left for the ordinary read (and the marker push, for the lease) to\\n    sort out.\\\"\\\"\\\"\\n    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n    if worker_holds_copy(root, records_dir) or not has_origin(root):\\n        return\\n    try:\\n        branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n        git(root, \\\"fetch\\\", \\\"origin\\\", branch)\\n    except RuntimeError:\\n        return\\n    try:\\n        git(root, \\\"merge\\\", \\\"--ff-only\\\", \\\"FETCH_HEAD\\\")\\n        return\\n    except RuntimeError:\\n        pass\\n    try:\\n        git(root, \\\"rebase\\\", \\\"FETCH_HEAD\\\")\\n    except RuntimeError:\\n        subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"rebase\\\", \\\"--abort\\\"],\\n                       capture_output=True, text=True, check=False)\\n\\n\\n# --- the worker: a detached child of the pass's own session, running the\\n# stage exactly as the pass used to inline, touching its own heartbeat\\n# while it does (R2). ---\\n\\ndef _stage_body(item_id: str, stage: str, nn: int) -> int:\\n    \\\"\\\"\\\"Runs build or verify in-process -- the same command `attavo build`\\n    or `attavo verify` would run -- while touching heartbeat_path every\\n    heartbeat_s() seconds, then transports whatever it wrote: counsel and\\n    file-stops on a non-pass record (issue #100, #89), one `git commit\\n    --only`, one push with the record push's own merge retry. The\\n    marker is the pass's, already committed and pushed before this\\n    starts; this writes and transports only the stage's own record (and,\\n    on a stop, its counsel record).\\\"\\\"\\\"\\n    root = Path(\\\".\\\").resolve()\\n    m = read_manifest(root)\\n    if m is None:\\n        return 2\\n    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n    before = latest_attempt_path(records_dir, stage)\\n\\n    beat = heartbeat_path(root, stage, nn)\\n    beat.parent.mkdir(parents=True, exist_ok=True)\\n    beat.touch()\\n    stop_beat = threading.Event()\\n\\n    def _tick() -> None:\\n        while not stop_beat.wait(heartbeat_s()):\\n            beat.touch()\\n\\n    beat_thread = threading.Thread(target=_tick, daemon=True)\\n    beat_thread.start()\\n    try:\\n        rc = cmd_build([item_id]) if stage == \\\"build\\\" else cmd_verify([item_id])\\n    finally:\\n        stop_beat.set()\\n        beat_thread.join()\\n\\n    after = latest_attempt_path(records_dir, stage)\\n    if after is None or after == before:\\n        # Refused before writing anything at all (e.g. no adapter\\n        # configured) -- the stage command already printed why.\\n        return rc if rc != 0 else 1\\n\\n    record = cast(dict[str, Any], latest_record(records_dir, stage))\\n    status_out = record.get(\\\"status\\\")\\n    to_commit = [after]\\n    if status_out != \\\"pass\\\":\\n        counsel_before = latest_attempt_path(records_dir, \\\"counsel\\\")\\n        cmd_counsel([item_id])\\n        counsel_after = latest_attempt_path(records_dir, \\\"counsel\\\")\\n        if counsel_after is not None and counsel_after != counsel_before:\\n            to_commit.append(counsel_after)\\n        # file-stops is its own idempotent read of the item's records, so\\n        # calling it here on every run that wrote a non-pass record is\\n        # safe to call again on a later run: an already-filed stop's own\\n        # marker is what stops it from being filed twice.\\n        cmd_file_stops([item_id])\\n\\n    message = f\\\"attavo: {stage} record for item {item_id} ({after.stem})\\\"\\n    try:\\n        commit_record(root, to_commit, message)\\n    except RuntimeError as exc:\\n        print(f\\\"attavo drive: stopped: could not commit the {stage} record: {exc}\\\")\\n        return 1\\n\\n    if has_origin(root):\\n        ok, err = push_record_commit(root, branch)\\n        if not ok:\\n            print(f\\\"attavo drive: stopped: could not push the {stage} record: {err}\\\")\\n            return 1\\n    else:\\n        print(f\\\"attavo drive: note: no origin remote; {after.name} is committed, not pushed\\\")\\n\\n    if status_out == \\\"halted\\\":\\n        question = (record.get(\\\"halted\\\") or {}).get(\\\"question\\\")\\n        print(f\\\"attavo drive: stopped: {stage} halted: {question} ({after.name}); \\\"\\n              f\\\"pushed to {branch}\\\")\\n    elif status_out != \\\"pass\\\":\\n        reason = record.get(\\\"refusal\\\") or status_out\\n        print(f\\\"attavo drive: stopped: {stage} {status_out}: {reason} ({after.name}); \\\"\\n              f\\\"pushed to {branch}\\\")\\n    else:\\n        print(f\\\"attavo drive: pushed {after.name} to {branch}\\\")\\n    return rc\\n\\n\\ndef cmd_worker(argv: list[str]) -> int:\\n    \\\"\\\"\\\"`attavo worker N <build|verify> NN`: the detached child a pass\\n    starts once its marker is pushed -- the lease held, the attempt is\\n    this worker's to run. Its own session (start_new_session, set by the\\n    pass that spawns it); its stdout and stderr are the pass's own\\n    redirect, to <git-dir>/attavo/<stage>-NN.worker.log.\\\"\\\"\\\"\\n    cast(io.TextIOWrapper, sys.stdout).reconfigure(line_buffering=True)\\n    if len(argv) != 3:\\n        print(\\\"attavo worker: usage: attavo worker N <build|verify> NN\\\", file=sys.stderr)\\n        return 2\\n    item_id, stage, nn_text = argv\\n    if stage not in (\\\"build\\\", \\\"verify\\\"):\\n        print(f\\\"attavo worker: {stage!r} is not build or verify\\\", file=sys.stderr)\\n        return 2\\n    try:\\n        nn = int(nn_text)\\n    except ValueError:\\n        print(f\\\"attavo worker: {nn_text!r} is not an attempt number\\\", file=sys.stderr)\\n        return 2\\n    return _stage_body(item_id, stage, nn)\\n\\n\\n# --- the pass's own two acts: start a stage (the lease), and recover\\n# exactly the one invocation the report names owed one. ---\\n\\ndef _start_stage(root: Path, m: dict[str, Any], item_id: str, stage: str,\\n                 forge_checks: dict[str, Any] | None, *, again_by: bool = False) -> int:\\n    \\\"\\\"\\\"The lease (ruling A): the marker, committed and pushed as a plain\\n    fast-forward with no merge and no retry (push_lease). Lost to another\\n    pass, or refused outright by the remote, both undo the marker commit\\n    here (git reset --hard) so this checkout carries no half-taken\\n    attempt either way; only a pushed lease starts the worker. On a\\n    review, forge_checks is the checks this same pass already read on\\n    the pre-marker head (ruling B) -- written to\\n    <git-dir>/attavo/verify-NN.forge-checks.json and named in\\n    ATTAVO_FORGE_CHECKS, so the worker's own `attavo verify` reads it\\n    instead of polling. R3: again_by names the marker as `--again`'s own\\n    act on a stage whose budget was already spent.\\\"\\\"\\\"\\n    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n    nn = next_attempt_number(records_dir, stage)\\n    marker = write_invocation_marker(root, records_dir, stage, nn, again_by=again_by)\\n    try:\\n        commit_record(root, [marker], f\\\"attavo: {stage} invocation {nn:02d} started for item {item_id}\\\")\\n    except RuntimeError as exc:\\n        print(f\\\"attavo drive: stopped: could not commit the {stage} invocation marker: {exc}\\\")\\n        return 1\\n\\n    if has_origin(root):\\n        outcome, err = push_lease(root, branch)\\n        if outcome != \\\"pushed\\\":\\n            git(root, \\\"reset\\\", \\\"--hard\\\", \\\"HEAD^\\\")\\n            if outcome == \\\"lost-race\\\":\\n                print(f\\\"attavo drive: another pass holds this attempt ({marker.name}); nothing started\\\")\\n                return 0\\n            print(f\\\"attavo drive: stopped: could not push the {stage} invocation marker: {err}\\\")\\n            return 1\\n\\n    env = dict(os.environ)\\n    if forge_checks is not None:\\n        checks_file = forge_checks_path(root, stage, nn)\\n        checks_file.write_text(json.dumps(forge_checks))\\n        env[\\\"ATTAVO_FORGE_CHECKS\\\"] = str(checks_file)\\n    log = worker_log_path(root, stage, nn)\\n    with log.open(\\\"ab\\\") as fh, open(os.devnull, \\\"rb\\\") as devnull:\\n        proc = subprocess.Popen(\\n            [sys.executable, str(PRODUCT_ROOT / \\\"bin\\\" / \\\"attavo\\\"), \\\"worker\\\", item_id, stage, f\\\"{nn:02d}\\\"],\\n            cwd=str(root), env=env, stdin=devnull, stdout=fh, stderr=subprocess.STDOUT,\\n            start_new_session=True)\\n    word = \\\"Build\\\" if stage == \\\"build\\\" else \\\"Review\\\"\\n    print(f\\\"attavo drive: {word} started (attempt {nn:02d}, worker pid {proc.pid})\\\")\\n    return 0\\n\\n\\ndef _recover_one(root: Path, m: dict[str, Any], item_id: str, records_dir: Path) -> int:\\n    \\\"\\\"\\\"The pass's own recovery act (what `--recover` did): exactly the one\\n    invocation the report just read as owing one -- died or hung -- ends\\n    here. class died when the heartbeat is stale (or absent and the pid\\n    is gone), class hung when there is no heartbeat, the pid lives, and a\\n    declared [drive].stall_after_s has passed with no newer event, and\\n    terminated. Provenance product; the events tail as the log. Committed\\n    and pushed the way any stage record is (push_record_commit, with its\\n    own merge retry) -- this is not a race for a lease, since no new\\n    attempt marker is written.\\\"\\\"\\\"\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n    bound = stall_bound_s(m)\\n    pending = invocations_without_record(records_dir)\\n    readings = [(marker, info, read_invocation(root, bound, marker, info)) for marker, info in pending]\\n    candidate = next(((mk, i, rd) for mk, i, rd in readings if rd.cls != \\\"running\\\"), None)\\n    if candidate is None:\\n        # The report read this a moment ago; nothing owed recovery by the\\n        # time this pass got here (another pass recovered it, or it\\n        # finished on its own).\\n        return 0\\n    marker, info, reading = candidate\\n    stage, nn, log, last_at, age, cls, crossed = reading\\n    pid, host = info.get(\\\"pid\\\"), info.get(\\\"host\\\")\\n\\n    if next_attempt_number(records_dir, stage) != nn:\\n        print(f\\\"attavo drive: stopped: {marker.name} names attempt {nn} but the next \\\"\\n              f\\\"{stage} record would be {next_attempt_number(records_dir, stage):02d}; \\\"\\n              f\\\"a later record already exists, read the records before recovering\\\")\\n        return 1\\n\\n    if cls == \\\"hung\\\":\\n        try:\\n            os.kill(cast(int, pid), signal.SIGTERM)\\n            ended = \\\"terminated\\\"\\n        except OSError as exc:\\n            ended = f\\\"not terminated ({exc})\\\"\\n        if crossed == \\\"ceiling\\\":\\n            detail = (f\\\"pid {pid} on {host} alive {int(cast(float, age))} s after its marker, past \\\"\\n                      f\\\"the {stage} ceiling of {ceiling_s(m, stage)} s; {ended}\\\")\\n        else:\\n            detail = (f\\\"pid {pid} on {host} alive with no event for {int(cast(float, age))} s \\\"\\n                      f\\\"(bound {bound} s); {ended}\\\")\\n    else:\\n        detail = (f\\\"pid {pid} on {host} is not running and wrote no {marker.stem}.json; \\\"\\n                  f\\\"started {info.get('at')}, last event {last_at or 'none'}\\\")\\n\\n    schema = stage_schema(stage)\\n    record: dict[str, Any] = {k: None for k in schema.get(\\\"required\\\", [])}\\n    approval = latest_record(records_dir, \\\"approval\\\")\\n    signature_source = log.strip().splitlines()[-1] if log.strip() else detail\\n    record.update({\\\"sha\\\": info.get(\\\"sha\\\"), \\\"start_sha\\\": info.get(\\\"sha\\\"),\\n                   \\\"approval_sha\\\": approval.get(\\\"sha\\\") if approval else None,\\n                   \\\"at\\\": info.get(\\\"at\\\"),\\n                   \\\"adapter\\\": (m.get(\\\"executor\\\") or {}).get(stage),\\n                   \\\"status\\\": \\\"failed\\\", \\\"refusal\\\": None, \\\"halted\\\": None,\\n                   \\\"retry_of\\\": None, \\\"steer\\\": None,\\n                   \\\"stop\\\": {\\\"class\\\": cls, \\\"provenance\\\": \\\"product\\\", \\\"detail\\\": detail,\\n                            \\\"signature\\\": signature_of(signature_source), \\\"bound\\\": crossed}})\\n    if \\\"wall_clock_s\\\" in record:\\n        record[\\\"wall_clock_s\\\"] = None if age is None else int(age)\\n    record = {k: v for k, v in record.items() if k in schema.get(\\\"properties\\\", {})}\\n    try:\\n        path = write_record(records_dir, stage, record, m, item_id, log=log)\\n    except ValueError as exc:\\n        print(f\\\"attavo drive: stopped: could not write the {cls} record for {marker.stem}: {exc}\\\")\\n        return 1\\n    try:\\n        commit_record(root, [path], f\\\"attavo: {stage} record for item {item_id} \\\"\\n                                    f\\\"({path.stem}), recovered as {cls}\\\")\\n    except RuntimeError as exc:\\n        print(f\\\"attavo drive: stopped: could not commit the {cls} record: {exc}\\\")\\n        return 1\\n    if has_origin(root):\\n        ok, err = push_record_commit(root, branch)\\n        if not ok:\\n            print(f\\\"attavo drive: stopped: could not push the {cls} record: {err}\\\")\\n            return 1\\n    else:\\n        print(f\\\"attavo drive: note: no origin remote; {path.name} is committed, not pushed\\\")\\n    print(f\\\"attavo drive: recovered {marker.stem} as {cls}: {detail}\\\")\\n    return 0\\n\\n\\ndef _advance_again(root: Path, m: dict[str, Any], item_id: str, stage: str, head: str | None) -> int:\\n    \\\"\\\"\\\"`--again`'s own act on a stopped stage: exactly what next-build or\\n    next-review would do, bypassing the level a plain pass leaves alone\\n    for the operator. A review reads the forge fresh here -- once, since\\n    the report's own stopped reading never touched it -- rather than\\n    reusing a read that was never taken.\\\"\\\"\\\"\\n    if stage == \\\"build\\\":\\n        return _start_stage(root, m, item_id, \\\"build\\\", None)\\n    checks_command = (m.get(\\\"forge\\\") or {}).get(\\\"checks_command\\\")\\n    if not checks_command:\\n        print(\\\"attavo drive: refused: no [forge].checks_command in the manifest\\\")\\n        return 1\\n    forge_checks, ok = read_forge_checks(root, checks_command, cast(str, head))\\n    if not ok:\\n        conclusions = forge_checks[\\\"conclusions\\\"]\\n        named = \\\", \\\".join(f\\\"{c['name']} {c['conclusion']}\\\" for c in conclusions) or \\\"no checks reported\\\"\\n        print(f\\\"attavo drive: forge checks not green on {cast(str, head)[:12]}: {named}\\\")\\n        return 0\\n    return _start_stage(root, m, item_id, \\\"verify\\\", forge_checks)\\n\\n\\ndef _pass_once(root: Path, m: dict[str, Any], item_id: str, again: bool) -> tuple[int, \\\"DriveReport\\\"]:\\n    \\\"\\\"\\\"One pass: fast-forward to origin (never while a worker holds the\\n    copy), read the report, act at most once, return. The three acts,\\n    one per report state that is the product's move: owes-recovery\\n    recovers; next-build and next-review start their stage, handing a\\n    review the checks the report already read once on the pre-marker\\n    head. --again starts the next attempt of a stopped stage. Every\\n    other level is printed in the report's own words and left.\\\"\\\"\\\"\\n    from attavo.report import drive_report\\n    fast_forward_to_origin(root, m, item_id)\\n    r = drive_report(root, m, item_id)\\n\\n    if r[\\\"state\\\"] == \\\"owes-recovery\\\":\\n        records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n        return _recover_one(root, m, item_id, records_dir), r\\n    if r[\\\"state\\\"] == \\\"next-build\\\":\\n        return _start_stage(root, m, item_id, \\\"build\\\", None), r\\n    if r[\\\"state\\\"] == \\\"next-review\\\":\\n        checks_command = (m.get(\\\"forge\\\") or {}).get(\\\"checks_command\\\")\\n        forge_checks = {\\\"command\\\": checks_command, \\\"sha\\\": r[\\\"head\\\"], \\\"conclusions\\\": r[\\\"checks\\\"] or []}\\n        return _start_stage(root, m, item_id, \\\"verify\\\", forge_checks), r\\n    if again and r[\\\"state\\\"] == \\\"stopped\\\" and r[\\\"stage\\\"]:\\n        return _advance_again(root, m, item_id, r[\\\"stage\\\"], r[\\\"head\\\"]), r\\n\\n    print(f\\\"attavo drive: {r['says']}\\\")\\n    return (1 if r[\\\"state\\\"] == \\\"refused\\\" else 0), r\\n\\n\\n_TERMINAL_STATES = (\\\"waiting-on-approval\\\", \\\"stopped\\\", \\\"ready-to-merge\\\", \\\"merged\\\")\\n\\n\\ndef _until_ready(root: Path, m: dict[str, Any], item_id: str, again: bool) -> int:\\n    \\\"\\\"\\\"--until-ready: the pass, repeated in one process, sleeping\\n    ATTAVO_DRIVE_POLL_INTERVAL_S between passes, until the level is the\\n    operator's or done (exit 0), a concluded check is red (exit 1), or\\n    an unconcluded one has not concluded within ATTAVO_DRIVE_POLL_BOUND_S\\n    (exit 1). A stage running in its own worker is not bounded by this --\\n    only time spent waiting on the forge is.\\\"\\\"\\\"\\n    from attavo.verify import drive_forge_poll_bound_s, drive_forge_poll_interval_s\\n    bound = drive_forge_poll_bound_s()\\n    interval = drive_forge_poll_interval_s()\\n    waiting_since: float | None = None\\n    while True:\\n        rc, r = _pass_once(root, m, item_id, again)\\n        state = r[\\\"state\\\"]\\n\\n        if state == \\\"waiting-on-checks\\\":\\n            if waiting_since is None:\\n                waiting_since = time.monotonic()\\n            elif time.monotonic() - waiting_since >= bound:\\n                print(f\\\"attavo drive: stopped: the checks did not conclude within {bound:.0f}s\\\")\\n                return 1\\n        else:\\n            waiting_since = None\\n\\n        if rc != 0:\\n            return rc\\n        if state in _TERMINAL_STATES:\\n            return 0\\n        if state == \\\"blocked-on-checks\\\":\\n            return 1\\n        time.sleep(interval)\\n\\n\\ndef _drive_all() -> int:\\n    \\\"\\\"\\\"--all: one pass, in its own process, in every ../attavo-worktree-N\\n    beside this checkout -- each one derives its own item from its own\\n    attavo/N-* branch. Every line either prints is prefixed with the\\n    worktree's own directory name, so an operator reading them together\\n    can tell which item each line is about.\\\"\\\"\\\"\\n    root = Path(\\\".\\\").resolve()\\n    siblings = sorted(p for p in root.parent.glob(\\\"attavo-worktree-*\\\") if p.is_dir())\\n    if not siblings:\\n        print(\\\"attavo drive: --all found no ../attavo-worktree-N beside this checkout\\\")\\n        return 0\\n    worst = 0\\n    for copy in siblings:\\n        run = subprocess.run([sys.executable, str(PRODUCT_ROOT / \\\"bin\\\" / \\\"attavo\\\"), \\\"drive\\\"],\\n                             cwd=str(copy), capture_output=True, text=True, check=False)\\n        for line in (run.stdout + run.stderr).splitlines():\\n            print(f\\\"{copy.name}: {line}\\\")\\n        worst = max(worst, run.returncode)\\n    return worst\\n\\n\\ndef cmd_drive(argv: list[str]) -> int:\\n    # Issue #145: Python block-buffers stdout when it is not a tty (a\\n    # pipe, e.g. a screen reading this process live), so every line this\\n    # prints would otherwise sit unflushed until the process exits.\\n    # Line-buffering makes a pipe reader see each line the moment it is\\n    # printed, the same as a terminal already does; `attavo worker`\\n    # reconfigures its own stdout the same way.\\n    cast(io.TextIOWrapper, sys.stdout).reconfigure(line_buffering=True)\\n\\n    if \\\"--recover\\\" in argv:\\n        print(\\\"attavo drive: --recover is gone; a pass recovers a dead or hung invocation \\\"\\n              \\\"itself, as soon as the report owes one\\\", file=sys.stderr)\\n        return 2\\n\\n    until_ready = \\\"--until-ready\\\" in argv\\n    report = \\\"--report\\\" in argv\\n    again = \\\"--again\\\" in argv\\n    all_flag = \\\"--all\\\" in argv\\n    positional = [a for a in argv if not a.startswith(\\\"--\\\")]\\n\\n    if all_flag:\\n        if until_ready or report or again or positional:\\n            print(\\\"attavo drive: --all runs one pass in every worktree beside this checkout; \\\"\\n                  \\\"drop N and every other flag\\\", file=sys.stderr)\\n            return 2\\n        return _drive_all()\\n\\n    root = Path(\\\".\\\").resolve()\\n    item_id = positional[0] if positional else derive_item_id(root)\\n    if not item_id:\\n        print(\\\"attavo drive: cannot derive item id; pass N or run on an attavo/N-* branch\\\",\\n              file=sys.stderr)\\n        return 2\\n    m = read_manifest(root)\\n    if m is None:\\n        print(f\\\"attavo drive: no {MANIFEST} at {root}\\\", file=sys.stderr)\\n        return 2\\n\\n    if report:\\n        if until_ready or again:\\n            print(\\\"attavo drive: --report reads and does nothing else; drop --until-ready \\\"\\n                  \\\"and --again\\\", file=sys.stderr)\\n            return 2\\n        fast_forward_to_origin(root, m, item_id)\\n        from attavo.report import drive_report\\n        print(json.dumps(drive_report(root, m, item_id), indent=2))\\n        return 0\\n\\n    if until_ready:\\n        return _until_ready(root, m, item_id, again)\\n    rc, _ = _pass_once(root, m, item_id, again)\\n    return rc\\n\",\"structuredPatch\":[{\"oldStart\":634,\"oldLines\":14,\"newStart\":634,\"newLines\":17,\"lines\":[\"     return 0\",\" \",\" \",\"-def _advance_again(root: Path, m: dict[str, Any], item_id: str, stage: str, head: str | None) -> int:\",\"-    \\\"\\\"\\\"`--again`'s own act on a stopped stage: exactly what next-build or\",\"+def _advance_again(root: Path, m: dict[str, Any], item_id: str, stage: str, head: str | None, *,\",\"+                   again_by: bool = False) -> int:\",\"+    \\\"\\\"\\\"The next attempt of a stopped stage: exactly what next-build or\",\"     next-review would do, bypassing the level a plain pass leaves alone\",\"-    for the operator. A review reads the forge fresh here -- once, since\",\"-    the report's own stopped reading never touched it -- rather than\",\"-    reusing a read that was never taken.\\\"\\\"\\\"\",\"+    for the operator -- the pass's own automatic retry of a retryable\",\"+    family, or `--again`'s act once a budget is spent (again_by). A\",\"+    review reads the forge fresh here -- once, since the report's own\",\"+    stopped reading never touched it -- rather than reusing a read that\",\"+    was never taken.\\\"\\\"\\\"\",\"     if stage == \\\"build\\\":\",\"-        return _start_stage(root, m, item_id, \\\"build\\\", None)\",\"+        return _start_stage(root, m, item_id, \\\"build\\\", None, again_by=again_by)\",\"     checks_command = (m.get(\\\"forge\\\") or {}).get(\\\"checks_command\\\")\",\"     if not checks_command:\",\"         print(\\\"attavo drive: refused: no [forge].checks_command in the manifest\\\")\"]},{\"oldStart\":652,\"oldLines\":17,\"newStart\":655,\"newLines\":81,\"lines\":[\"         named = \\\", \\\".join(f\\\"{c['name']} {c['conclusion']}\\\" for c in conclusions) or \\\"no checks reported\\\"\",\"         print(f\\\"attavo drive: forge checks not green on {cast(str, head)[:12]}: {named}\\\")\",\"         return 0\",\"-    return _start_stage(root, m, item_id, \\\"verify\\\", forge_checks)\",\"+    return _start_stage(root, m, item_id, \\\"verify\\\", forge_checks, again_by=again_by)\",\" \",\" \",\"+def _retry_target(r: \\\"DriveReport\\\") -> str:\",\"+    \\\"\\\"\\\"The stage the next attempt actually starts: class \\\"returned\\\" (a\",\"+    build's head a check rejected, or a review's own blocking finding) is\",\"+    always the verify record's own stop, but the retry it starts is the\",\"+    next build.\\\"\\\"\\\"\",\"+    return \\\"build\\\" if r[\\\"stop_class\\\"] == \\\"returned\\\" else cast(str, r[\\\"stage\\\"])\",\"+\",\"+\",\"+def _retry_due(root: Path, m: dict[str, Any], item_id: str, r: \\\"DriveReport\\\") -> bool:\",\"+    \\\"\\\"\\\"R3: a stopped stage whose class is one of the four retryable\",\"+    families, whose budget is not spent, whose last two signatures\",\"+    differ, and -- for transient -- whose record has aged past\",\"+    [drive].retry_after_s, is retried by the next plain pass, no\",\"+    counsel, no operator act.\\\"\\\"\\\"\",\"+    if r[\\\"stop_class\\\"] not in RETRYABLE_CLASSES:\",\"+        return False\",\"+    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\",\"+    sig_stage = cast(str, r[\\\"stage\\\"])\",\"+    budget_stage = _retry_target(r)\",\"+    if stage_exhausted(records_dir, m, sig_stage, budget_stage):\",\"+        return False\",\"+    if r[\\\"stop_class\\\"] == \\\"transient\\\":\",\"+        attempts = parse_attempts(records_dir, sig_stage)\",\"+        latest = attempts[max(attempts)] if attempts else {}\",\"+        age = _seconds_since(latest.get(\\\"at\\\"))\",\"+        if age is None or age < retry_after_s(m):\",\"+            return False\",\"+    return True\",\"+\",\"+\",\"+def _handle_again(root: Path, m: dict[str, Any], item_id: str, r: \\\"DriveReport\\\") -> int:\",\"+    \\\"\\\"\\\"`--again`'s own act on a stopped stage (R3): a retryable family\",\"+    whose budget is not spent is left to the pass's own automatic retry\",\"+    -- a no-op here, saying so -- since starting it twice would spend two\",\"+    attempts on one press. A retryable family whose budget is spent, or\",\"+    any other stopped class, starts the next attempt at once, its marker\",\"+    naming --again as what started it.\\\"\\\"\\\"\",\"+    stage = _retry_target(r)\",\"+    if r[\\\"stop_class\\\"] in RETRYABLE_CLASSES:\",\"+        records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\",\"+        if not stage_exhausted(records_dir, m, cast(str, r[\\\"stage\\\"]), stage):\",\"+            print(\\\"attavo drive: --again is a no-op inside the budget; the pass retries on its own\\\")\",\"+            return 0\",\"+    return _advance_again(root, m, item_id, stage, r[\\\"head\\\"], again_by=True)\",\"+\",\"+\",\"+def _counsel_answered(records_dir: Path, r: \\\"DriveReport\\\") -> bool:\",\"+    \\\"\\\"\\\"R3: whether the stop this report just read as \\\"stopped\\\" already\",\"+    carries counsel's own \\\"answer\\\" verdict -- every non-retryable class\",\"+    is counsel's to read (as before this item), and `answer` starts the\",\"+    next attempt with the answer as its steer, read from the feedback\",\"+    file the retried attempt's own first iteration is handed\",\"+    (attavo.build._retry_seed).\\\"\\\"\\\"\",\"+    if r[\\\"stop_class\\\"] in RETRYABLE_CLASSES or not r[\\\"stage\\\"] or r[\\\"attempt\\\"] is None:\",\"+        return False\",\"+    counsel = counsel_record_for(records_dir, cast(str, r[\\\"stage\\\"]), cast(int, r[\\\"attempt\\\"]))\",\"+    return counsel is not None and counsel.get(\\\"verdict\\\") == \\\"answer\\\"\",\"+\",\"+\",\" def _pass_once(root: Path, m: dict[str, Any], item_id: str, again: bool) -> tuple[int, \\\"DriveReport\\\"]:\",\"     \\\"\\\"\\\"One pass: fast-forward to origin (never while a worker holds the\",\"     copy), read the report, act at most once, return. The three acts,\",\"     one per report state that is the product's move: owes-recovery\",\"     recovers; next-build and next-review start their stage, handing a\",\"     review the checks the report already read once on the pre-marker\",\"-    head. --again starts the next attempt of a stopped stage. Every\",\"-    other level is printed in the report's own words and left.\\\"\\\"\\\"\",\"+    head; a concluded red check on a passed build's head (R3) is a\",\"+    returned review record, not a level, so the review starts the same\",\"+    way. On a stopped stage, `--again` always wins (a no-op inside the\",\"+    budget, the next attempt once it is spent); absent it, a retryable\",\"+    family retries on its own, and any other stop counsel has already\",\"+    answered starts the next attempt steered by that answer. Every other\",\"+    level is printed in the report's own words and left.\\\"\\\"\\\"\",\"     from attavo.report import drive_report\",\"     fast_forward_to_origin(root, m, item_id)\",\"     r = drive_report(root, m, item_id)\"]},{\"oldStart\":676,\"oldLines\":8,\"newStart\":743,\"newLines\":22,\"lines\":[\"         checks_command = (m.get(\\\"forge\\\") or {}).get(\\\"checks_command\\\")\",\"         forge_checks = {\\\"command\\\": checks_command, \\\"sha\\\": r[\\\"head\\\"], \\\"conclusions\\\": r[\\\"checks\\\"] or []}\",\"         return _start_stage(root, m, item_id, \\\"verify\\\", forge_checks), r\",\"-    if again and r[\\\"state\\\"] == \\\"stopped\\\" and r[\\\"stage\\\"]:\",\"-        return _advance_again(root, m, item_id, r[\\\"stage\\\"], r[\\\"head\\\"]), r\",\"+    if r[\\\"state\\\"] == \\\"blocked-on-checks\\\" and r[\\\"stage\\\"] == \\\"verify\\\":\",\"+        # R3: the rejection is a record, not a level with nothing behind\",\"+        # it (#206's build-01) -- the review starts, reading the same\",\"+        # forge checks this pass just read, and writes the check\",\"+        # rejection itself as a returned record (attavo.verify.cmd_verify).\",\"+        checks_command = (m.get(\\\"forge\\\") or {}).get(\\\"checks_command\\\")\",\"+        forge_checks = {\\\"command\\\": checks_command, \\\"sha\\\": r[\\\"head\\\"], \\\"conclusions\\\": r[\\\"checks\\\"] or []}\",\"+        return _start_stage(root, m, item_id, \\\"verify\\\", forge_checks), r\",\"+    if r[\\\"state\\\"] == \\\"stopped\\\" and r[\\\"stage\\\"]:\",\"+        if again:\",\"+            return _handle_again(root, m, item_id, r), r\",\"+        records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\",\"+        if _retry_due(root, m, item_id, r):\",\"+            return _advance_again(root, m, item_id, _retry_target(r), r[\\\"head\\\"]), r\",\"+        if _counsel_answered(records_dir, r):\",\"+            return _advance_again(root, m, item_id, _retry_target(r), r[\\\"head\\\"]), r\",\" \",\"     print(f\\\"attavo drive: {r['says']}\\\")\",\"     return (1 if r[\\\"state\\\"] == \\\"refused\\\" else 0), r\"]}],\"userModified\":false,\"replaceAll\":false,\"contentNotInModelContext\":true}}\n2347:+{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01GD7PkoF4CuFvsVG6oiWE1M\",\"type\":\"tool_result\",\"content\":\"The file /Users/davidbean/Projects/attavo-worktree-219/attavo/drive.py has been updated successfully.\"}]},\"parent_tool_use_id\":null,\"session_id\":\"0dd7ed4f-100c-4188-9a34-077aa0b6aa25\",\"uuid\":\"aafe3abe-18c8-4bfe-9b77-84d18df82294\",\"timestamp\":\"2026-09-26T02:27:54.163Z\",\"tool_use_result\":{\"filePath\":\"/Users/davidbean/Projects/attavo-worktree-219/attavo/drive.py\",\"oldString\":\"        if rc != 0:\\n            return rc\\n        if state in _TERMINAL_STATES:\\n            return 0\\n        if state == \\\"blocked-on-checks\\\":\\n            return 1\\n        time.sleep(interval)\",\"newString\":\"        if rc != 0:\\n            return rc\\n        if state in _TERMINAL_STATES:\\n            return 0\\n        if state == \\\"blocked-on-checks\\\" and r[\\\"stage\\\"] != \\\"verify\\\":\\n            # R3: stage \\\"verify\\\" here is the pass's own act, just taken --\\n            # a concluded red check on a passed build's head is now a\\n            # returned review record (attavo.verify.cmd_verify), not a\\n            # level the loop gives up on with nothing behind it.\\n            return 1\\n        time.sleep(interval)\",\"originalFile\":\"from __future__ import annotations\\n\\nimport io\\nimport json\\nimport os\\nimport signal\\nimport subprocess\\nimport sys\\nimport threading\\nimport time\\nfrom pathlib import Path\\nfrom typing import TYPE_CHECKING, Any, NamedTuple, cast\\n\\nfrom attavo.approval import approval_status\\nfrom attavo.build import cmd_build, driver_identity\\nfrom attavo.common import MANIFEST, PRODUCT_ROOT, derive_item_id, git, read_manifest\\nfrom attavo.counsel import cmd_counsel\\nfrom attavo.doctor import (\\n    _parse_json_line,\\n    attempts_budget,\\n    ceiling_s,\\n    invocation_alive,\\n    invocations_without_record,\\n    retry_after_s,\\n    stall_bound_s,\\n    write_invocation_marker,\\n)\\nfrom attavo.events import stage_events_dir\\nfrom attavo.filing import cmd_file_stops\\nfrom attavo.records import (\\n    latest_attempt_path,\\n    latest_record,\\n    next_attempt_number,\\n    parse_attempts,\\n    stage_schema,\\n    write_record,\\n)\\nfrom attavo.stops import RETRYABLE_CLASSES, counsel_record_for, signature_of, stage_exhausted\\nfrom attavo.verify import cmd_verify, read_forge_checks\\n\\nif TYPE_CHECKING:\\n    from attavo.types import DriveReport\\n\\n# --- drive: the mechanical transitions between approval and ready-to-merge\\n# (issue #84), under the reconciler's R2 (rulings A, B, C's recovery half,\\n# F, G, H): `attavo drive N` is one short pass. It reads the report\\n# (attavo.report), acts at most once -- recovers a dead or hung\\n# invocation, or starts the next stage in a detached worker -- and\\n# returns within seconds; the stage itself runs in `attavo worker`, a\\n# child of the pass's own session, which outlives it. Writes no record of\\n# its own: the stage records already on disk, and the invocation markers\\n# and heartbeats beside them, are the only state a pass or a worker\\n# reads. ---\\n\\n\\ndef commit_record(root: Path, record_paths: Path | list[Path], message: str) -> None:\\n    \\\"\\\"\\\"`git commit --only` on every record path given, and each one's .log\\n    and .filed, each if one exists -- never the whole index. A transport\\n    commit that sweeps the index is exactly the regression issue #46\\n    already guards build and verify against on the adapter side; drive\\n    must not reintroduce it on the transport side. The .filed marker\\n    (issue #89) is committed alongside the record it names, in the same\\n    commit and the same push, so a second worktree or a fresh clone reads\\n    the same filed fact rather than refiling every stop it finds with no\\n    marker of its own. A single Path is accepted for the common one-record\\n    case; issue #100 passes a list so the counsel record lands in the same\\n    commit as the stage record it counsels. Authored and committed as\\n    driver_identity(), set by the product and never the tenant's git\\n    config, so a driven item's record commits are never indistinguishable\\n    from an operator's own.\\\"\\\"\\\"\\n    if isinstance(record_paths, Path):\\n        record_paths = [record_paths]\\n    paths: list[str] = []\\n    for record_path in record_paths:\\n        paths.append(str(record_path.relative_to(root)))\\n        log_path = record_path.with_suffix(\\\".log\\\")\\n        if log_path.is_file():\\n            paths.append(str(log_path.relative_to(root)))\\n        marker_path = record_path.with_suffix(\\\".filed\\\")\\n        if marker_path.is_file():\\n            paths.append(str(marker_path.relative_to(root)))\\n    identity = driver_identity()\\n    env = dict(os.environ)\\n    env[\\\"GIT_AUTHOR_NAME\\\"] = identity[\\\"name\\\"]\\n    env[\\\"GIT_AUTHOR_EMAIL\\\"] = identity[\\\"email\\\"]\\n    env[\\\"GIT_COMMITTER_NAME\\\"] = identity[\\\"name\\\"]\\n    env[\\\"GIT_COMMITTER_EMAIL\\\"] = identity[\\\"email\\\"]\\n    git(root, \\\"add\\\", *paths)\\n    git(root, \\\"commit\\\", \\\"--only\\\", \\\"-m\\\", message, *paths, env=env)\\n\\n\\ndef push_record_commit(root: Path, branch: str) -> tuple[bool, str | None]:\\n    \\\"\\\"\\\"Push HEAD to branch on origin. A push a divergent remote rejects is\\n    retried once after `git pull --no-rebase --no-edit origin branch` -- a\\n    merge, never a rebase, because a rebase would change the sha the record\\n    commit just wrote already names. This is the record push's own retry\\n    -- the worker's, once it has the lease -- distinct from push_lease\\n    below, which never retries.\\\"\\\"\\\"\\n    def attempt() -> tuple[bool, str]:\\n        run = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"push\\\", \\\"origin\\\", f\\\"HEAD:{branch}\\\"],\\n                             capture_output=True, text=True, check=False)\\n        return run.returncode == 0, run.stderr.strip()\\n\\n    ok, err = attempt()\\n    if ok:\\n        return True, None\\n    pull = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"pull\\\", \\\"--no-rebase\\\", \\\"--no-edit\\\",\\n                           \\\"origin\\\", branch], capture_output=True, text=True, check=False)\\n    if pull.returncode != 0:\\n        return False, f\\\"push rejected and the retry merge failed: {pull.stderr.strip() or err}\\\"\\n    ok, err = attempt()\\n    if not ok:\\n        return False, f\\\"push rejected again after merging {branch}: {err}\\\"\\n    return True, None\\n\\n\\n_RACE_MARKERS = (\\\"non-fast-forward\\\", \\\"fetch first\\\", \\\"stale info\\\", \\\"cannot lock ref\\\",\\n                 \\\"failed to update ref\\\")\\n\\n\\ndef push_lease(root: Path, branch: str) -> tuple[str, str | None]:\\n    \\\"\\\"\\\"Push HEAD to branch on origin as a plain fast-forward -- no merge,\\n    no retry: this is the lease the marker commit takes on the attempt it\\n    names (ruling A). (\\\"pushed\\\", None) on success.\\n\\n    (\\\"lost-race\\\", stderr) when git's own ref check is what rejected it --\\n    the branch moved since this pass fast-forwarded to it (a sequential\\n    \\\"[rejected] ... (fetch first)\\\"), or the remote's own ref transaction\\n    lost a genuine simultaneous push (\\\"[remote rejected] ... (failed to\\n    update ref)\\\", \\\"cannot lock ref\\\"): either way, another pass's own\\n    marker (or record) landed there first. The pass that reads this is\\n    the loser: it says so, resets its own marker commit, and starts\\n    nothing.\\n\\n    (\\\"refused\\\", stderr) for every other rejection -- a remote that\\n    refuses the push outright (a hook, a permission, an unreachable\\n    remote). This is not a race for the lease; it is a refusal, and ends\\n    the pass with exit 1.\\\"\\\"\\\"\\n    run = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"push\\\", \\\"origin\\\", f\\\"HEAD:{branch}\\\"],\\n                         capture_output=True, text=True, check=False)\\n    if run.returncode == 0:\\n        return \\\"pushed\\\", None\\n    stderr = run.stderr\\n    if any(marker in stderr for marker in _RACE_MARKERS):\\n        return \\\"lost-race\\\", stderr.strip()\\n    return \\\"refused\\\", stderr.strip()\\n\\n\\ndef has_origin(root: Path) -> bool:\\n    \\\"\\\"\\\"Whether this checkout carries an origin remote at all -- a fixture\\n    or a scratch checkout with none is not a refusal; a pass commits\\n    locally and skips the push, the way recovery always has.\\\"\\\"\\\"\\n    try:\\n        git(root, \\\"remote\\\", \\\"get-url\\\", \\\"origin\\\")\\n        return True\\n    except RuntimeError:\\n        return False\\n\\n\\ndef drive_state(root: Path, m: dict[str, Any], item_id: str) -> tuple[str, str | None, Path]:\\n    \\\"\\\"\\\"(\\\"no-approval\\\" | \\\"build\\\" | \\\"verify\\\" | \\\"ready\\\", detail, records_dir):\\n    the next mechanical step for item_id, read from its latest records\\n    alone. A build only counts as current when it is a pass bound to the\\n    valid approval's own sha; a verify only counts as current when it is a\\n    pass bound to that build's own sha -- the same staleness a re-approval\\n    or a re-build must force, attest's own chain check already enforces\\n    (check_attest_chain), read here rather than re-typed.\\\"\\\"\\\"\\n    records_rel = m[\\\"paths\\\"][\\\"records\\\"]\\n    records_dir = root / records_rel / item_id\\n\\n    status = approval_status(root, m, item_id)\\n    if status != \\\"valid\\\":\\n        return \\\"no-approval\\\", status, records_dir\\n\\n    latest_approval = latest_record(records_dir, \\\"approval\\\")\\n    latest_build = latest_record(records_dir, \\\"build\\\")\\n    build_current = (latest_build is not None and latest_build.get(\\\"status\\\") == \\\"pass\\\"\\n                     and latest_build.get(\\\"approval_sha\\\")\\n                     == (latest_approval.get(\\\"sha\\\") if latest_approval else None))\\n    if latest_build is None or not build_current:\\n        return \\\"build\\\", None, records_dir\\n\\n    latest_verify = latest_record(records_dir, \\\"verify\\\")\\n    verify_current = (latest_verify is not None and latest_verify.get(\\\"status\\\") == \\\"pass\\\"\\n                      and latest_verify.get(\\\"build_sha\\\") == latest_build.get(\\\"sha\\\"))\\n    if not verify_current:\\n        return \\\"verify\\\", None, records_dir\\n\\n    return \\\"ready\\\", None, records_dir\\n\\n\\n# --- the heartbeat, the worker log, and the forge-checks handoff: local\\n# facts under the checkout's own git directory (issue #140's precedent),\\n# never committed and never among the paths commit_record ever names. ---\\n\\ndef heartbeat_s() -> float:\\n    return float(os.environ.get(\\\"ATTAVO_HEARTBEAT_S\\\", 15))\\n\\n\\ndef heartbeat_path(root: Path, stage: str, nn: int) -> Path:\\n    return stage_events_dir(root) / f\\\"{stage}-{nn:02d}.heartbeat\\\"\\n\\n\\ndef worker_log_path(root: Path, stage: str, nn: int) -> Path:\\n    return stage_events_dir(root) / f\\\"{stage}-{nn:02d}.worker.log\\\"\\n\\n\\ndef forge_checks_path(root: Path, stage: str, nn: int) -> Path:\\n    return stage_events_dir(root) / f\\\"{stage}-{nn:02d}.forge-checks.json\\\"\\n\\n\\ndef _events_path_for(root: Path, stage: str, nn: int) -> Path | None:\\n    \\\"\\\"\\\"The adapter's own events file for this invocation, under the\\n    checkout's git dir (a worktree's own dir when the checkout is one).\\\"\\\"\\\"\\n    try:\\n        gitdir = Path(git(root, \\\"rev-parse\\\", \\\"--git-dir\\\").strip())\\n    except RuntimeError:\\n        return None\\n    if not gitdir.is_absolute():\\n        gitdir = root / gitdir\\n    path = gitdir / \\\"attavo\\\" / f\\\"{stage}-{nn:02d}.events.jsonl\\\"\\n    return path if path.is_file() else None\\n\\n\\ndef _events_tail(path: Path | None, lines: int = 20) -> tuple[str, str | None]:\\n    \\\"\\\"\\\"(the last lines as a log, the last event's own at).\\\"\\\"\\\"\\n    if path is None:\\n        return \\\"no events file for this invocation\\\\n\\\", None\\n    try:\\n        text = path.read_text()\\n    except OSError:\\n        return \\\"events file unreadable\\\\n\\\", None\\n    tail = text.splitlines()[-lines:]\\n    last_at = None\\n    for line in reversed(tail):\\n        parsed = _parse_json_line(line)\\n        if not isinstance(parsed, dict):\\n            continue\\n        at = parsed.get(\\\"at\\\")\\n        if isinstance(at, str):\\n            last_at = at\\n            break\\n    return \\\"\\\\n\\\".join(tail) + \\\"\\\\n\\\", last_at\\n\\n\\ndef _seconds_since(at: str | None) -> float | None:\\n    from datetime import datetime, timezone\\n    if not at:\\n        return None\\n    try:\\n        then = datetime.strptime(at, \\\"%Y-%m-%dT%H:%M:%SZ\\\").replace(tzinfo=timezone.utc)\\n    except ValueError:\\n        return None\\n    return (datetime.now(timezone.utc) - then).total_seconds()\\n\\n\\nclass InvocationReading(NamedTuple):\\n    \\\"\\\"\\\"What one marker with no record reads as, from here and now.\\\"\\\"\\\"\\n    stage: str\\n    nn: int\\n    log: str\\n    last_at: str | None\\n    age: float | None\\n    cls: str  # \\\"running\\\" | \\\"hung\\\" | \\\"died\\\"\\n    bound: str | None = None  # R3: \\\"stall\\\" or \\\"ceiling\\\" when cls is \\\"hung\\\"\\n\\n\\ndef read_invocation(root: Path, bound: int | None, marker: Path, info: dict[str, Any]) -> InvocationReading:\\n    \\\"\\\"\\\"Whether an invocation that began and wrote no record is running,\\n    hung, or died -- read from its own heartbeat first (R2): a heartbeat\\n    file fresh within three beats of ATTAVO_HEARTBEAT_S is alive; a stale\\n    one is died, whether or not the pid still lives -- a worker stuck\\n    somewhere that never reaches its own heartbeat loop again is exactly\\n    what this is for. Only with no heartbeat file at all -- an invocation\\n    from before this release, or one that died before touching its\\n    first beat -- does this fall back to the pid: alive and, with a\\n    stall bound declared, past it is hung; alive with no bound, or\\n    within it, is running for as long as it lives; not alive is died.\\n    The stall bound decides hung, never died.\\\"\\\"\\\"\\n    stage, nn_text = marker.stem.rsplit(\\\"-\\\", 1)\\n    nn = int(nn_text)\\n    log, last_at = _events_tail(_events_path_for(root, stage, nn))\\n    # R3: the stage ceiling, wall clock from the marker's own `at`, judged\\n    # before any liveness signal -- alive past it is hung by the ceiling,\\n    # whatever its event age (or absence of one) says.\\n    m = read_manifest(root) or {}\\n    ceiling = ceiling_s(m, stage)\\n    since_start = _seconds_since(info.get(\\\"at\\\"))\\n    if ceiling is not None and since_start is not None and since_start > ceiling:\\n        return InvocationReading(stage, nn, log, last_at, since_start, \\\"hung\\\", \\\"ceiling\\\")\\n    if not _streams_events(root, m, stage):\\n        # An adapter that declares it streams no events is judged by the\\n        # ceiling alone; the stall bound it can never trip is not asked.\\n        bound = None\\n    beat = heartbeat_path(root, stage, nn)\\n    if beat.is_file():\\n        try:\\n            beat_age = time.time() - beat.stat().st_mtime\\n        except OSError:\\n            beat_age = None\\n        cls = \\\"running\\\" if beat_age is not None and beat_age <= heartbeat_s() * 3 else \\\"died\\\"\\n        return InvocationReading(stage, nn, log, last_at, beat_age, cls)\\n    age = _seconds_since(last_at or info.get(\\\"at\\\"))\\n    if not invocation_alive(info):\\n        return InvocationReading(stage, nn, log, last_at, age, \\\"died\\\")\\n    if bound is None or age is None or age <= bound:\\n        return InvocationReading(stage, nn, log, last_at, age, \\\"running\\\")\\n    return InvocationReading(stage, nn, log, last_at, age, \\\"hung\\\", \\\"stall\\\")\\n\\n\\ndef _streams_events(root: Path, m: dict[str, Any], stage: str) -> bool:\\n    \\\"\\\"\\\"R3: whether the stage's adapter declares it streams events\\n    (adapters/<name>/conformance.json, \\\"streams_events\\\"); true when the\\n    adapter names none, or its conformance.json does not say.\\\"\\\"\\\"\\n    name = (m.get(\\\"executor\\\") or {}).get(stage) or (m.get(\\\"executor\\\") or {}).get(\\\"build\\\")\\n    if not name:\\n        return True\\n    for base in (root / \\\"attavo\\\" / \\\"adapters\\\", PRODUCT_ROOT / \\\"adapters\\\"):\\n        conf = base / name / \\\"conformance.json\\\"\\n        if conf.is_file():\\n            try:\\n                return bool(json.loads(conf.read_text()).get(\\\"streams_events\\\", True))\\n            except (OSError, ValueError):\\n                return True\\n    return True\\n\\n\\ndef uncommitted_record(root: Path, records_dir: Path, stage: str) -> Path | None:\\n    \\\"\\\"\\\"The latest <stage>-NN.json this working tree carries that git has\\n    no commit for yet -- the moment between a worker's write and its own\\n    commit. None when the latest record is already committed, or there\\n    is none at all.\\\"\\\"\\\"\\n    path = latest_attempt_path(records_dir, stage)\\n    if path is None or not path.is_file():\\n        return None\\n    status = subprocess.run(\\n        [\\\"git\\\", \\\"-C\\\", str(root), \\\"status\\\", \\\"--porcelain\\\", \\\"--\\\", str(path.relative_to(root))],\\n        capture_output=True, text=True, check=False)\\n    return path if status.stdout.strip() else None\\n\\n\\ndef worker_holds_copy(root: Path, records_dir: Path) -> bool:\\n    \\\"\\\"\\\"True when this checkout's own working tree cannot safely be moved\\n    -- an invocation marker with no record yet (a worker, here or\\n    elsewhere, still holds this attempt), or a build or verify record the\\n    working tree carries that git has not committed yet. Scoped to the\\n    stage records a pass or a worker itself ever transports -- an\\n    operator's own spec-gate or approve, routinely uncommitted between\\n    their own act and the next pass, is not this. A pass never\\n    fast-forwards while this holds (never while a worker holds the\\n    copy).\\\"\\\"\\\"\\n    if invocations_without_record(records_dir):\\n        return True\\n    return (uncommitted_record(root, records_dir, \\\"build\\\") is not None\\n           or uncommitted_record(root, records_dir, \\\"verify\\\") is not None)\\n\\n\\ndef fast_forward_to_origin(root: Path, m: dict[str, Any], item_id: str) -> None:\\n    \\\"\\\"\\\"The pass's own read of origin's branch, taken before it reads\\n    anything else -- a commit landed there from elsewhere (an approval\\n    from the screen, a ruling, another pass's own record) is not a race\\n    for the lease, it is exactly what the lease is for. Never while a\\n    worker holds this copy (worker_holds_copy): resetting a working tree\\n    a detached child is still writing into would corrupt its own commits.\\n    A plain fast-forward when origin is simply ahead; when this checkout\\n    also carries its own commits origin has not seen yet (an operator's\\n    approval, not yet pushed), those are replayed on top of origin's own\\n    tip instead -- no merge commit, and the marker this pass is about to\\n    write still lands as a fast-forward when it pushes. Silent about\\n    everything short of that -- a real conflict, or an absent origin, is\\n    left for the ordinary read (and the marker push, for the lease) to\\n    sort out.\\\"\\\"\\\"\\n    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n    if worker_holds_copy(root, records_dir) or not has_origin(root):\\n        return\\n    try:\\n        branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n        git(root, \\\"fetch\\\", \\\"origin\\\", branch)\\n    except RuntimeError:\\n        return\\n    try:\\n        git(root, \\\"merge\\\", \\\"--ff-only\\\", \\\"FETCH_HEAD\\\")\\n        return\\n    except RuntimeError:\\n        pass\\n    try:\\n        git(root, \\\"rebase\\\", \\\"FETCH_HEAD\\\")\\n    except RuntimeError:\\n        subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"rebase\\\", \\\"--abort\\\"],\\n                       capture_output=True, text=True, check=False)\\n\\n\\n# --- the worker: a detached child of the pass's own session, running the\\n# stage exactly as the pass used to inline, touching its own heartbeat\\n# while it does (R2). ---\\n\\ndef _stage_body(item_id: str, stage: str, nn: int) -> int:\\n    \\\"\\\"\\\"Runs build or verify in-process -- the same command `attavo build`\\n    or `attavo verify` would run -- while touching heartbeat_path every\\n    heartbeat_s() seconds, then transports whatever it wrote: counsel and\\n    file-stops on a non-pass record (issue #100, #89), one `git commit\\n    --only`, one push with the record push's own merge retry. The\\n    marker is the pass's, already committed and pushed before this\\n    starts; this writes and transports only the stage's own record (and,\\n    on a stop, its counsel record).\\\"\\\"\\\"\\n    root = Path(\\\".\\\").resolve()\\n    m = read_manifest(root)\\n    if m is None:\\n        return 2\\n    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n    before = latest_attempt_path(records_dir, stage)\\n\\n    beat = heartbeat_path(root, stage, nn)\\n    beat.parent.mkdir(parents=True, exist_ok=True)\\n    beat.touch()\\n    stop_beat = threading.Event()\\n\\n    def _tick() -> None:\\n        while not stop_beat.wait(heartbeat_s()):\\n            beat.touch()\\n\\n    beat_thread = threading.Thread(target=_tick, daemon=True)\\n    beat_thread.start()\\n    try:\\n        rc = cmd_build([item_id]) if stage == \\\"build\\\" else cmd_verify([item_id])\\n    finally:\\n        stop_beat.set()\\n        beat_thread.join()\\n\\n    after = latest_attempt_path(records_dir, stage)\\n    if after is None or after == before:\\n        # Refused before writing anything at all (e.g. no adapter\\n        # configured) -- the stage command already printed why.\\n        return rc if rc != 0 else 1\\n\\n    record = cast(dict[str, Any], latest_record(records_dir, stage))\\n    status_out = record.get(\\\"status\\\")\\n    to_commit = [after]\\n    if status_out != \\\"pass\\\":\\n        counsel_before = latest_attempt_path(records_dir, \\\"counsel\\\")\\n        cmd_counsel([item_id])\\n        counsel_after = latest_attempt_path(records_dir, \\\"counsel\\\")\\n        if counsel_after is not None and counsel_after != counsel_before:\\n            to_commit.append(counsel_after)\\n        # file-stops is its own idempotent read of the item's records, so\\n        # calling it here on every run that wrote a non-pass record is\\n        # safe to call again on a later run: an already-filed stop's own\\n        # marker is what stops it from being filed twice.\\n        cmd_file_stops([item_id])\\n\\n    message = f\\\"attavo: {stage} record for item {item_id} ({after.stem})\\\"\\n    try:\\n        commit_record(root, to_commit, message)\\n    except RuntimeError as exc:\\n        print(f\\\"attavo drive: stopped: could not commit the {stage} record: {exc}\\\")\\n        return 1\\n\\n    if has_origin(root):\\n        ok, err = push_record_commit(root, branch)\\n        if not ok:\\n            print(f\\\"attavo drive: stopped: could not push the {stage} record: {err}\\\")\\n            return 1\\n    else:\\n        print(f\\\"attavo drive: note: no origin remote; {after.name} is committed, not pushed\\\")\\n\\n    if status_out == \\\"halted\\\":\\n        question = (record.get(\\\"halted\\\") or {}).get(\\\"question\\\")\\n        print(f\\\"attavo drive: stopped: {stage} halted: {question} ({after.name}); \\\"\\n              f\\\"pushed to {branch}\\\")\\n    elif status_out != \\\"pass\\\":\\n        reason = record.get(\\\"refusal\\\") or status_out\\n        print(f\\\"attavo drive: stopped: {stage} {status_out}: {reason} ({after.name}); \\\"\\n              f\\\"pushed to {branch}\\\")\\n    else:\\n        print(f\\\"attavo drive: pushed {after.name} to {branch}\\\")\\n    return rc\\n\\n\\ndef cmd_worker(argv: list[str]) -> int:\\n    \\\"\\\"\\\"`attavo worker N <build|verify> NN`: the detached child a pass\\n    starts once its marker is pushed -- the lease held, the attempt is\\n    this worker's to run. Its own session (start_new_session, set by the\\n    pass that spawns it); its stdout and stderr are the pass's own\\n    redirect, to <git-dir>/attavo/<stage>-NN.worker.log.\\\"\\\"\\\"\\n    cast(io.TextIOWrapper, sys.stdout).reconfigure(line_buffering=True)\\n    if len(argv) != 3:\\n        print(\\\"attavo worker: usage: attavo worker N <build|verify> NN\\\", file=sys.stderr)\\n        return 2\\n    item_id, stage, nn_text = argv\\n    if stage not in (\\\"build\\\", \\\"verify\\\"):\\n        print(f\\\"attavo worker: {stage!r} is not build or verify\\\", file=sys.stderr)\\n        return 2\\n    try:\\n        nn = int(nn_text)\\n    except ValueError:\\n        print(f\\\"attavo worker: {nn_text!r} is not an attempt number\\\", file=sys.stderr)\\n        return 2\\n    return _stage_body(item_id, stage, nn)\\n\\n\\n# --- the pass's own two acts: start a stage (the lease), and recover\\n# exactly the one invocation the report names owed one. ---\\n\\ndef _start_stage(root: Path, m: dict[str, Any], item_id: str, stage: str,\\n                 forge_checks: dict[str, Any] | None, *, again_by: bool = False) -> int:\\n    \\\"\\\"\\\"The lease (ruling A): the marker, committed and pushed as a plain\\n    fast-forward with no merge and no retry (push_lease). Lost to another\\n    pass, or refused outright by the remote, both undo the marker commit\\n    here (git reset --hard) so this checkout carries no half-taken\\n    attempt either way; only a pushed lease starts the worker. On a\\n    review, forge_checks is the checks this same pass already read on\\n    the pre-marker head (ruling B) -- written to\\n    <git-dir>/attavo/verify-NN.forge-checks.json and named in\\n    ATTAVO_FORGE_CHECKS, so the worker's own `attavo verify` reads it\\n    instead of polling. R3: again_by names the marker as `--again`'s own\\n    act on a stage whose budget was already spent.\\\"\\\"\\\"\\n    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n    nn = next_attempt_number(records_dir, stage)\\n    marker = write_invocation_marker(root, records_dir, stage, nn, again_by=again_by)\\n    try:\\n        commit_record(root, [marker], f\\\"attavo: {stage} invocation {nn:02d} started for item {item_id}\\\")\\n    except RuntimeError as exc:\\n        print(f\\\"attavo drive: stopped: could not commit the {stage} invocation marker: {exc}\\\")\\n        return 1\\n\\n    if has_origin(root):\\n        outcome, err = push_lease(root, branch)\\n        if outcome != \\\"pushed\\\":\\n            git(root, \\\"reset\\\", \\\"--hard\\\", \\\"HEAD^\\\")\\n            if outcome == \\\"lost-race\\\":\\n                print(f\\\"attavo drive: another pass holds this attempt ({marker.name}); nothing started\\\")\\n                return 0\\n            print(f\\\"attavo drive: stopped: could not push the {stage} invocation marker: {err}\\\")\\n            return 1\\n\\n    env = dict(os.environ)\\n    if forge_checks is not None:\\n        checks_file = forge_checks_path(root, stage, nn)\\n        checks_file.write_text(json.dumps(forge_checks))\\n        env[\\\"ATTAVO_FORGE_CHECKS\\\"] = str(checks_file)\\n    log = worker_log_path(root, stage, nn)\\n    with log.open(\\\"ab\\\") as fh, open(os.devnull, \\\"rb\\\") as devnull:\\n        proc = subprocess.Popen(\\n            [sys.executable, str(PRODUCT_ROOT / \\\"bin\\\" / \\\"attavo\\\"), \\\"worker\\\", item_id, stage, f\\\"{nn:02d}\\\"],\\n            cwd=str(root), env=env, stdin=devnull, stdout=fh, stderr=subprocess.STDOUT,\\n            start_new_session=True)\\n    word = \\\"Build\\\" if stage == \\\"build\\\" else \\\"Review\\\"\\n    print(f\\\"attavo drive: {word} started (attempt {nn:02d}, worker pid {proc.pid})\\\")\\n    return 0\\n\\n\\ndef _recover_one(root: Path, m: dict[str, Any], item_id: str, records_dir: Path) -> int:\\n    \\\"\\\"\\\"The pass's own recovery act (what `--recover` did): exactly the one\\n    invocation the report just read as owing one -- died or hung -- ends\\n    here. class died when the heartbeat is stale (or absent and the pid\\n    is gone), class hung when there is no heartbeat, the pid lives, and a\\n    declared [drive].stall_after_s has passed with no newer event, and\\n    terminated. Provenance product; the events tail as the log. Committed\\n    and pushed the way any stage record is (push_record_commit, with its\\n    own merge retry) -- this is not a race for a lease, since no new\\n    attempt marker is written.\\\"\\\"\\\"\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n    bound = stall_bound_s(m)\\n    pending = invocations_without_record(records_dir)\\n    readings = [(marker, info, read_invocation(root, bound, marker, info)) for marker, info in pending]\\n    candidate = next(((mk, i, rd) for mk, i, rd in readings if rd.cls != \\\"running\\\"), None)\\n    if candidate is None:\\n        # The report read this a moment ago; nothing owed recovery by the\\n        # time this pass got here (another pass recovered it, or it\\n        # finished on its own).\\n        return 0\\n    marker, info, reading = candidate\\n    stage, nn, log, last_at, age, cls, crossed = reading\\n    pid, host = info.get(\\\"pid\\\"), info.get(\\\"host\\\")\\n\\n    if next_attempt_number(records_dir, stage) != nn:\\n        print(f\\\"attavo drive: stopped: {marker.name} names attempt {nn} but the next \\\"\\n              f\\\"{stage} record would be {next_attempt_number(records_dir, stage):02d}; \\\"\\n              f\\\"a later record already exists, read the records before recovering\\\")\\n        return 1\\n\\n    if cls == \\\"hung\\\":\\n        try:\\n            os.kill(cast(int, pid), signal.SIGTERM)\\n            ended = \\\"terminated\\\"\\n        except OSError as exc:\\n            ended = f\\\"not terminated ({exc})\\\"\\n        if crossed == \\\"ceiling\\\":\\n            detail = (f\\\"pid {pid} on {host} alive {int(cast(float, age))} s after its marker, past \\\"\\n                      f\\\"the {stage} ceiling of {ceiling_s(m, stage)} s; {ended}\\\")\\n        else:\\n            detail = (f\\\"pid {pid} on {host} alive with no event for {int(cast(float, age))} s \\\"\\n                      f\\\"(bound {bound} s); {ended}\\\")\\n    else:\\n        detail = (f\\\"pid {pid} on {host} is not running and wrote no {marker.stem}.json; \\\"\\n                  f\\\"started {info.get('at')}, last event {last_at or 'none'}\\\")\\n\\n    schema = stage_schema(stage)\\n    record: dict[str, Any] = {k: None for k in schema.get(\\\"required\\\", [])}\\n    approval = latest_record(records_dir, \\\"approval\\\")\\n    signature_source = log.strip().splitlines()[-1] if log.strip() else detail\\n    record.update({\\\"sha\\\": info.get(\\\"sha\\\"), \\\"start_sha\\\": info.get(\\\"sha\\\"),\\n                   \\\"approval_sha\\\": approval.get(\\\"sha\\\") if approval else None,\\n                   \\\"at\\\": info.get(\\\"at\\\"),\\n                   \\\"adapter\\\": (m.get(\\\"executor\\\") or {}).get(stage),\\n                   \\\"status\\\": \\\"failed\\\", \\\"refusal\\\": None, \\\"halted\\\": None,\\n                   \\\"retry_of\\\": None, \\\"steer\\\": None,\\n                   \\\"stop\\\": {\\\"class\\\": cls, \\\"provenance\\\": \\\"product\\\", \\\"detail\\\": detail,\\n                            \\\"signature\\\": signature_of(signature_source), \\\"bound\\\": crossed}})\\n    if \\\"wall_clock_s\\\" in record:\\n        record[\\\"wall_clock_s\\\"] = None if age is None else int(age)\\n    record = {k: v for k, v in record.items() if k in schema.get(\\\"properties\\\", {})}\\n    try:\\n        path = write_record(records_dir, stage, record, m, item_id, log=log)\\n    except ValueError as exc:\\n        print(f\\\"attavo drive: stopped: could not write the {cls} record for {marker.stem}: {exc}\\\")\\n        return 1\\n    try:\\n        commit_record(root, [path], f\\\"attavo: {stage} record for item {item_id} \\\"\\n                                    f\\\"({path.stem}), recovered as {cls}\\\")\\n    except RuntimeError as exc:\\n        print(f\\\"attavo drive: stopped: could not commit the {cls} record: {exc}\\\")\\n        return 1\\n    if has_origin(root):\\n        ok, err = push_record_commit(root, branch)\\n        if not ok:\\n            print(f\\\"attavo drive: stopped: could not push the {cls} record: {err}\\\")\\n            return 1\\n    else:\\n        print(f\\\"attavo drive: note: no origin remote; {path.name} is committed, not pushed\\\")\\n    print(f\\\"attavo drive: recovered {marker.stem} as {cls}: {detail}\\\")\\n    return 0\\n\\n\\ndef _advance_again(root: Path, m: dict[str, Any], item_id: str, stage: str, head: str | None, *,\\n                   again_by: bool = False) -> int:\\n    \\\"\\\"\\\"The next attempt of a stopped stage: exactly what next-build or\\n    next-review would do, bypassing the level a plain pass leaves alone\\n    for the operator -- the pass's own automatic retry of a retryable\\n    family, or `--again`'s act once a budget is spent (again_by). A\\n    review reads the forge fresh here -- once, since the report's own\\n    stopped reading never touched it -- rather than reusing a read that\\n    was never taken.\\\"\\\"\\\"\\n    if stage == \\\"build\\\":\\n        return _start_stage(root, m, item_id, \\\"build\\\", None, again_by=again_by)\\n    checks_command = (m.get(\\\"forge\\\") or {}).get(\\\"checks_command\\\")\\n    if not checks_command:\\n        print(\\\"attavo drive: refused: no [forge].checks_command in the manifest\\\")\\n        return 1\\n    forge_checks, ok = read_forge_checks(root, checks_command, cast(str, head))\\n    if not ok:\\n        conclusions = forge_checks[\\\"conclusions\\\"]\\n        named = \\\", \\\".join(f\\\"{c['name']} {c['conclusion']}\\\" for c in conclusions) or \\\"no checks reported\\\"\\n        print(f\\\"attavo drive: forge checks not green on {cast(str, head)[:12]}: {named}\\\")\\n        return 0\\n    return _start_stage(root, m, item_id, \\\"verify\\\", forge_checks, again_by=again_by)\\n\\n\\ndef _retry_target(r: \\\"DriveReport\\\") -> str:\\n    \\\"\\\"\\\"The stage the next attempt actually starts: class \\\"returned\\\" (a\\n    build's head a check rejected, or a review's own blocking finding) is\\n    always the verify record's own stop, but the retry it starts is the\\n    next build.\\\"\\\"\\\"\\n    return \\\"build\\\" if r[\\\"stop_class\\\"] == \\\"returned\\\" else cast(str, r[\\\"stage\\\"])\\n\\n\\ndef _retry_due(root: Path, m: dict[str, Any], item_id: str, r: \\\"DriveReport\\\") -> bool:\\n    \\\"\\\"\\\"R3: a stopped stage whose class is one of the four retryable\\n    families, whose budget is not spent, whose last two signatures\\n    differ, and -- for transient -- whose record has aged past\\n    [drive].retry_after_s, is retried by the next plain pass, no\\n    counsel, no operator act.\\\"\\\"\\\"\\n    if r[\\\"stop_class\\\"] not in RETRYABLE_CLASSES:\\n        return False\\n    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n    sig_stage = cast(str, r[\\\"stage\\\"])\\n    budget_stage = _retry_target(r)\\n    if stage_exhausted(records_dir, m, sig_stage, budget_stage):\\n        return False\\n    if r[\\\"stop_class\\\"] == \\\"transient\\\":\\n        attempts = parse_attempts(records_dir, sig_stage)\\n        latest = attempts[max(attempts)] if attempts else {}\\n        age = _seconds_since(latest.get(\\\"at\\\"))\\n        if age is None or age < retry_after_s(m):\\n            return False\\n    return True\\n\\n\\ndef _handle_again(root: Path, m: dict[str, Any], item_id: str, r: \\\"DriveReport\\\") -> int:\\n    \\\"\\\"\\\"`--again`'s own act on a stopped stage (R3): a retryable family\\n    whose budget is not spent is left to the pass's own automatic retry\\n    -- a no-op here, saying so -- since starting it twice would spend two\\n    attempts on one press. A retryable family whose budget is spent, or\\n    any other stopped class, starts the next attempt at once, its marker\\n    naming --again as what started it.\\\"\\\"\\\"\\n    stage = _retry_target(r)\\n    if r[\\\"stop_class\\\"] in RETRYABLE_CLASSES:\\n        records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n        if not stage_exhausted(records_dir, m, cast(str, r[\\\"stage\\\"]), stage):\\n            print(\\\"attavo drive: --again is a no-op inside the budget; the pass retries on its own\\\")\\n            return 0\\n    return _advance_again(root, m, item_id, stage, r[\\\"head\\\"], again_by=True)\\n\\n\\ndef _counsel_answered(records_dir: Path, r: \\\"DriveReport\\\") -> bool:\\n    \\\"\\\"\\\"R3: whether the stop this report just read as \\\"stopped\\\" already\\n    carries counsel's own \\\"answer\\\" verdict -- every non-retryable class\\n    is counsel's to read (as before this item), and `answer` starts the\\n    next attempt with the answer as its steer, read from the feedback\\n    file the retried attempt's own first iteration is handed\\n    (attavo.build._retry_seed).\\\"\\\"\\\"\\n    if r[\\\"stop_class\\\"] in RETRYABLE_CLASSES or not r[\\\"stage\\\"] or r[\\\"attempt\\\"] is None:\\n        return False\\n    counsel = counsel_record_for(records_dir, cast(str, r[\\\"stage\\\"]), cast(int, r[\\\"attempt\\\"]))\\n    return counsel is not None and counsel.get(\\\"verdict\\\") == \\\"answer\\\"\\n\\n\\ndef _pass_once(root: Path, m: dict[str, Any], item_id: str, again: bool) -> tuple[int, \\\"DriveReport\\\"]:\\n    \\\"\\\"\\\"One pass: fast-forward to origin (never while a worker holds the\\n    copy), read the report, act at most once, return. The three acts,\\n    one per report state that is the product's move: owes-recovery\\n    recovers; next-build and next-review start their stage, handing a\\n    review the checks the report already read once on the pre-marker\\n    head; a concluded red check on a passed build's head (R3) is a\\n    returned review record, not a level, so the review starts the same\\n    way. On a stopped stage, `--again` always wins (a no-op inside the\\n    budget, the next attempt once it is spent); absent it, a retryable\\n    family retries on its own, and any other stop counsel has already\\n    answered starts the next attempt steered by that answer. Every other\\n    level is printed in the report's own words and left.\\\"\\\"\\\"\\n    from attavo.report import drive_report\\n    fast_forward_to_origin(root, m, item_id)\\n    r = drive_report(root, m, item_id)\\n\\n    if r[\\\"state\\\"] == \\\"owes-recovery\\\":\\n        records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n        return _recover_one(root, m, item_id, records_dir), r\\n    if r[\\\"state\\\"] == \\\"next-build\\\":\\n        return _start_stage(root, m, item_id, \\\"build\\\", None), r\\n    if r[\\\"state\\\"] == \\\"next-review\\\":\\n        checks_command = (m.get(\\\"forge\\\") or {}).get(\\\"checks_command\\\")\\n        forge_checks = {\\\"command\\\": checks_command, \\\"sha\\\": r[\\\"head\\\"], \\\"conclusions\\\": r[\\\"checks\\\"] or []}\\n        return _start_stage(root, m, item_id, \\\"verify\\\", forge_checks), r\\n    if r[\\\"state\\\"] == \\\"blocked-on-checks\\\" and r[\\\"stage\\\"] == \\\"verify\\\":\\n        # R3: the rejection is a record, not a level with nothing behind\\n        # it (#206's build-01) -- the review starts, reading the same\\n        # forge checks this pass just read, and writes the check\\n        # rejection itself as a returned record (attavo.verify.cmd_verify).\\n        checks_command = (m.get(\\\"forge\\\") or {}).get(\\\"checks_command\\\")\\n        forge_checks = {\\\"command\\\": checks_command, \\\"sha\\\": r[\\\"head\\\"], \\\"conclusions\\\": r[\\\"checks\\\"] or []}\\n        return _start_stage(root, m, item_id, \\\"verify\\\", forge_checks), r\\n    if r[\\\"state\\\"] == \\\"stopped\\\" and r[\\\"stage\\\"]:\\n        if again:\\n            return _handle_again(root, m, item_id, r), r\\n        records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n        if _retry_due(root, m, item_id, r):\\n            return _advance_again(root, m, item_id, _retry_target(r), r[\\\"head\\\"]), r\\n        if _counsel_answered(records_dir, r):\\n            return _advance_again(root, m, item_id, _retry_target(r), r[\\\"head\\\"]), r\\n\\n    print(f\\\"attavo drive: {r['says']}\\\")\\n    return (1 if r[\\\"state\\\"] == \\\"refused\\\" else 0), r\\n\\n\\n_TERMINAL_STATES = (\\\"waiting-on-approval\\\", \\\"stopped\\\", \\\"ready-to-merge\\\", \\\"merged\\\")\\n\\n\\ndef _until_ready(root: Path, m: dict[str, Any], item_id: str, again: bool) -> int:\\n    \\\"\\\"\\\"--until-ready: the pass, repeated in one process, sleeping\\n    ATTAVO_DRIVE_POLL_INTERVAL_S between passes, until the level is the\\n    operator's or done (exit 0), a concluded check is red (exit 1), or\\n    an unconcluded one has not concluded within ATTAVO_DRIVE_POLL_BOUND_S\\n    (exit 1). A stage running in its own worker is not bounded by this --\\n    only time spent waiting on the forge is.\\\"\\\"\\\"\\n    from attavo.verify import drive_forge_poll_bound_s, drive_forge_poll_interval_s\\n    bound = drive_forge_poll_bound_s()\\n    interval = drive_forge_poll_interval_s()\\n    waiting_since: float | None = None\\n    while True:\\n        rc, r = _pass_once(root, m, item_id, again)\\n        state = r[\\\"state\\\"]\\n\\n        if state == \\\"waiting-on-checks\\\":\\n            if waiting_since is None:\\n                waiting_since = time.monotonic()\\n            elif time.monotonic() - waiting_since >= bound:\\n                print(f\\\"attavo drive: stopped: the checks did not conclude within {bound:.0f}s\\\")\\n                return 1\\n        else:\\n            waiting_since = None\\n\\n        if rc != 0:\\n            return rc\\n        if state in _TERMINAL_STATES:\\n            return 0\\n        if state == \\\"blocked-on-checks\\\":\\n            return 1\\n        time.sleep(interval)\\n\\n\\ndef _drive_all() -> int:\\n    \\\"\\\"\\\"--all: one pass, in its own process, in every ../attavo-worktree-N\\n    beside this checkout -- each one derives its own item from its own\\n    attavo/N-* branch. Every line either prints is prefixed with the\\n    worktree's own directory name, so an operator reading them together\\n    can tell which item each line is about.\\\"\\\"\\\"\\n    root = Path(\\\".\\\").resolve()\\n    siblings = sorted(p for p in root.parent.glob(\\\"attavo-worktree-*\\\") if p.is_dir())\\n    if not siblings:\\n        print(\\\"attavo drive: --all found no ../attavo-worktree-N beside this checkout\\\")\\n        return 0\\n    worst = 0\\n    for copy in siblings:\\n        run = subprocess.run([sys.executable, str(PRODUCT_ROOT / \\\"bin\\\" / \\\"attavo\\\"), \\\"drive\\\"],\\n                             cwd=str(copy), capture_output=True, text=True, check=False)\\n        for line in (run.stdout + run.stderr).splitlines():\\n            print(f\\\"{copy.name}: {line}\\\")\\n        worst = max(worst, run.returncode)\\n    return worst\\n\\n\\ndef cmd_drive(argv: list[str]) -> int:\\n    # Issue #145: Python block-buffers stdout when it is not a tty (a\\n    # pipe, e.g. a screen reading this process live), so every line this\\n    # prints would otherwise sit unflushed until the process exits.\\n    # Line-buffering makes a pipe reader see each line the moment it is\\n    # printed, the same as a terminal already does; `attavo worker`\\n    # reconfigures its own stdout the same way.\\n    cast(io.TextIOWrapper, sys.stdout).reconfigure(line_buffering=True)\\n\\n    if \\\"--recover\\\" in argv:\\n        print(\\\"attavo drive: --recover is gone; a pass recovers a dead or hung invocation \\\"\\n              \\\"itself, as soon as the report owes one\\\", file=sys.stderr)\\n        return 2\\n\\n    until_ready = \\\"--until-ready\\\" in argv\\n    report = \\\"--report\\\" in argv\\n    again = \\\"--again\\\" in argv\\n    all_flag = \\\"--all\\\" in argv\\n    positional = [a for a in argv if not a.startswith(\\\"--\\\")]\\n\\n    if all_flag:\\n        if until_ready or report or again or positional:\\n            print(\\\"attavo drive: --all runs one pass in every worktree beside this checkout; \\\"\\n                  \\\"drop N and every other flag\\\", file=sys.stderr)\\n            return 2\\n        return _drive_all()\\n\\n    root = Path(\\\".\\\").resolve()\\n    item_id = positional[0] if positional else derive_item_id(root)\\n    if not item_id:\\n        print(\\\"attavo drive: cannot derive item id; pass N or run on an attavo/N-* branch\\\",\\n              file=sys.stderr)\\n        return 2\\n    m = read_manifest(root)\\n    if m is None:\\n        print(f\\\"attavo drive: no {MANIFEST} at {root}\\\", file=sys.stderr)\\n        return 2\\n\\n    if report:\\n        if until_ready or again:\\n            print(\\\"attavo drive: --report reads and does nothing else; drop --until-ready \\\"\\n                  \\\"and --again\\\", file=sys.stderr)\\n            return 2\\n        fast_forward_to_origin(root, m, item_id)\\n        from attavo.report import drive_report\\n        print(json.dumps(drive_report(root, m, item_id), indent=2))\\n        return 0\\n\\n    if until_ready:\\n        return _until_ready(root, m, item_id, again)\\n    rc, _ = _pass_once(root, m, item_id, again)\\n    return rc\\n\",\"structuredPatch\":[{\"oldStart\":795,\"oldLines\":7,\"newStart\":795,\"newLines\":11,\"lines\":[\"             return rc\",\"         if state in _TERMINAL_STATES:\",\"             return 0\",\"-        if state == \\\"blocked-on-checks\\\":\",\"+        if state == \\\"blocked-on-checks\\\" and r[\\\"stage\\\"] != \\\"verify\\\":\",\"+            # R3: stage \\\"verify\\\" here is the pass's own act, just taken --\",\"+            # a concluded red check on a passed build's head is now a\",\"+            # returned review record (attavo.verify.cmd_verify), not a\",\"+            # level the loop gives up on with nothing behind it.\",\"             return 1\",\"         time.sleep(interval)\",\" \"]}],\"userModified\":false,\"replaceAll\":false,\"contentNotInModelContext\":true}}\n2352:+{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01C1nc7LsUKrou3TQKu6wHG8\",\"type\":\"tool_result\",\"content\":\"The file /Users/davidbean/Projects/attavo-worktree-219/attavo/drive.py has been updated successfully.\"}]},\"parent_tool_use_id\":null,\"session_id\":\"0dd7ed4f-100c-4188-9a34-077aa0b6aa25\",\"uuid\":\"fcee8d37-c0b6-40a4-9fe6-8a6c11f23673\",\"timestamp\":\"2026-09-26T02:28:04.283Z\",\"tool_use_result\":{\"filePath\":\"/Users/davidbean/Projects/attavo-worktree-219/attavo/drive.py\",\"oldString\":\"    record = cast(dict[str, Any], latest_record(records_dir, stage))\\n    status_out = record.get(\\\"status\\\")\\n    to_commit = [after]\\n    if status_out != \\\"pass\\\":\\n        counsel_before = latest_attempt_path(records_dir, \\\"counsel\\\")\\n        cmd_counsel([item_id])\\n        counsel_after = latest_attempt_path(records_dir, \\\"counsel\\\")\\n        if counsel_after is not None and counsel_after != counsel_before:\",\"newString\":\"    record = cast(dict[str, Any], latest_record(records_dir, stage))\\n    status_out = record.get(\\\"status\\\")\\n    to_commit = [after]\\n    if status_out != \\\"pass\\\":\\n        # R3: a retryable family (died, hung, transient, returned) asks\\n        # counsel nothing while its budget still has an attempt to\\n        # spend -- the next pass retries it plainly. Once its budget is\\n        # spent, or its last two signatures match, counsel is read once\\n        # more, its sentence carried beside the exhaustion report, never\\n        # instead of it. Every other class is counsel's to read on every\\n        # stop, as before this item.\\n        stop_class = (record.get(\\\"stop\\\") or {}).get(\\\"class\\\")\\n        budget_stage = \\\"build\\\" if stop_class == \\\"returned\\\" else stage\\n        ask_counsel = (stop_class not in RETRYABLE_CLASSES\\n                      or stage_exhausted(records_dir, m, stage, budget_stage))\\n        counsel_before = latest_attempt_path(records_dir, \\\"counsel\\\")\\n        if ask_counsel:\\n            cmd_counsel([item_id])\\n        counsel_after = latest_attempt_path(records_dir, \\\"counsel\\\")\\n        if counsel_after is not None and counsel_after != counsel_before:\",\"originalFile\":\"from __future__ import annotations\\n\\nimport io\\nimport json\\nimport os\\nimport signal\\nimport subprocess\\nimport sys\\nimport threading\\nimport time\\nfrom pathlib import Path\\nfrom typing import TYPE_CHECKING, Any, NamedTuple, cast\\n\\nfrom attavo.approval import approval_status\\nfrom attavo.build import cmd_build, driver_identity\\nfrom attavo.common import MANIFEST, PRODUCT_ROOT, derive_item_id, git, read_manifest\\nfrom attavo.counsel import cmd_counsel\\nfrom attavo.doctor import (\\n    _parse_json_line,\\n    attempts_budget,\\n    ceiling_s,\\n    invocation_alive,\\n    invocations_without_record,\\n    retry_after_s,\\n    stall_bound_s,\\n    write_invocation_marker,\\n)\\nfrom attavo.events import stage_events_dir\\nfrom attavo.filing import cmd_file_stops\\nfrom attavo.records import (\\n    latest_attempt_path,\\n    latest_record,\\n    next_attempt_number,\\n    parse_attempts,\\n    stage_schema,\\n    write_record,\\n)\\nfrom attavo.stops import RETRYABLE_CLASSES, counsel_record_for, signature_of, stage_exhausted\\nfrom attavo.verify import cmd_verify, read_forge_checks\\n\\nif TYPE_CHECKING:\\n    from attavo.types import DriveReport\\n\\n# --- drive: the mechanical transitions between approval and ready-to-merge\\n# (issue #84), under the reconciler's R2 (rulings A, B, C's recovery half,\\n# F, G, H): `attavo drive N` is one short pass. It reads the report\\n# (attavo.report), acts at most once -- recovers a dead or hung\\n# invocation, or starts the next stage in a detached worker -- and\\n# returns within seconds; the stage itself runs in `attavo worker`, a\\n# child of the pass's own session, which outlives it. Writes no record of\\n# its own: the stage records already on disk, and the invocation markers\\n# and heartbeats beside them, are the only state a pass or a worker\\n# reads. ---\\n\\n\\ndef commit_record(root: Path, record_paths: Path | list[Path], message: str) -> None:\\n    \\\"\\\"\\\"`git commit --only` on every record path given, and each one's .log\\n    and .filed, each if one exists -- never the whole index. A transport\\n    commit that sweeps the index is exactly the regression issue #46\\n    already guards build and verify against on the adapter side; drive\\n    must not reintroduce it on the transport side. The .filed marker\\n    (issue #89) is committed alongside the record it names, in the same\\n    commit and the same push, so a second worktree or a fresh clone reads\\n    the same filed fact rather than refiling every stop it finds with no\\n    marker of its own. A single Path is accepted for the common one-record\\n    case; issue #100 passes a list so the counsel record lands in the same\\n    commit as the stage record it counsels. Authored and committed as\\n    driver_identity(), set by the product and never the tenant's git\\n    config, so a driven item's record commits are never indistinguishable\\n    from an operator's own.\\\"\\\"\\\"\\n    if isinstance(record_paths, Path):\\n        record_paths = [record_paths]\\n    paths: list[str] = []\\n    for record_path in record_paths:\\n        paths.append(str(record_path.relative_to(root)))\\n        log_path = record_path.with_suffix(\\\".log\\\")\\n        if log_path.is_file():\\n            paths.append(str(log_path.relative_to(root)))\\n        marker_path = record_path.with_suffix(\\\".filed\\\")\\n        if marker_path.is_file():\\n            paths.append(str(marker_path.relative_to(root)))\\n    identity = driver_identity()\\n    env = dict(os.environ)\\n    env[\\\"GIT_AUTHOR_NAME\\\"] = identity[\\\"name\\\"]\\n    env[\\\"GIT_AUTHOR_EMAIL\\\"] = identity[\\\"email\\\"]\\n    env[\\\"GIT_COMMITTER_NAME\\\"] = identity[\\\"name\\\"]\\n    env[\\\"GIT_COMMITTER_EMAIL\\\"] = identity[\\\"email\\\"]\\n    git(root, \\\"add\\\", *paths)\\n    git(root, \\\"commit\\\", \\\"--only\\\", \\\"-m\\\", message, *paths, env=env)\\n\\n\\ndef push_record_commit(root: Path, branch: str) -> tuple[bool, str | None]:\\n    \\\"\\\"\\\"Push HEAD to branch on origin. A push a divergent remote rejects is\\n    retried once after `git pull --no-rebase --no-edit origin branch` -- a\\n    merge, never a rebase, because a rebase would change the sha the record\\n    commit just wrote already names. This is the record push's own retry\\n    -- the worker's, once it has the lease -- distinct from push_lease\\n    below, which never retries.\\\"\\\"\\\"\\n    def attempt() -> tuple[bool, str]:\\n        run = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"push\\\", \\\"origin\\\", f\\\"HEAD:{branch}\\\"],\\n                             capture_output=True, text=True, check=False)\\n        return run.returncode == 0, run.stderr.strip()\\n\\n    ok, err = attempt()\\n    if ok:\\n        return True, None\\n    pull = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"pull\\\", \\\"--no-rebase\\\", \\\"--no-edit\\\",\\n                           \\\"origin\\\", branch], capture_output=True, text=True, check=False)\\n    if pull.returncode != 0:\\n        return False, f\\\"push rejected and the retry merge failed: {pull.stderr.strip() or err}\\\"\\n    ok, err = attempt()\\n    if not ok:\\n        return False, f\\\"push rejected again after merging {branch}: {err}\\\"\\n    return True, None\\n\\n\\n_RACE_MARKERS = (\\\"non-fast-forward\\\", \\\"fetch first\\\", \\\"stale info\\\", \\\"cannot lock ref\\\",\\n                 \\\"failed to update ref\\\")\\n\\n\\ndef push_lease(root: Path, branch: str) -> tuple[str, str | None]:\\n    \\\"\\\"\\\"Push HEAD to branch on origin as a plain fast-forward -- no merge,\\n    no retry: this is the lease the marker commit takes on the attempt it\\n    names (ruling A). (\\\"pushed\\\", None) on success.\\n\\n    (\\\"lost-race\\\", stderr) when git's own ref check is what rejected it --\\n    the branch moved since this pass fast-forwarded to it (a sequential\\n    \\\"[rejected] ... (fetch first)\\\"), or the remote's own ref transaction\\n    lost a genuine simultaneous push (\\\"[remote rejected] ... (failed to\\n    update ref)\\\", \\\"cannot lock ref\\\"): either way, another pass's own\\n    marker (or record) landed there first. The pass that reads this is\\n    the loser: it says so, resets its own marker commit, and starts\\n    nothing.\\n\\n    (\\\"refused\\\", stderr) for every other rejection -- a remote that\\n    refuses the push outright (a hook, a permission, an unreachable\\n    remote). This is not a race for the lease; it is a refusal, and ends\\n    the pass with exit 1.\\\"\\\"\\\"\\n    run = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"push\\\", \\\"origin\\\", f\\\"HEAD:{branch}\\\"],\\n                         capture_output=True, text=True, check=False)\\n    if run.returncode == 0:\\n        return \\\"pushed\\\", None\\n    stderr = run.stderr\\n    if any(marker in stderr for marker in _RACE_MARKERS):\\n        return \\\"lost-race\\\", stderr.strip()\\n    return \\\"refused\\\", stderr.strip()\\n\\n\\ndef has_origin(root: Path) -> bool:\\n    \\\"\\\"\\\"Whether this checkout carries an origin remote at all -- a fixture\\n    or a scratch checkout with none is not a refusal; a pass commits\\n    locally and skips the push, the way recovery always has.\\\"\\\"\\\"\\n    try:\\n        git(root, \\\"remote\\\", \\\"get-url\\\", \\\"origin\\\")\\n        return True\\n    except RuntimeError:\\n        return False\\n\\n\\ndef drive_state(root: Path, m: dict[str, Any], item_id: str) -> tuple[str, str | None, Path]:\\n    \\\"\\\"\\\"(\\\"no-approval\\\" | \\\"build\\\" | \\\"verify\\\" | \\\"ready\\\", detail, records_dir):\\n    the next mechanical step for item_id, read from its latest records\\n    alone. A build only counts as current when it is a pass bound to the\\n    valid approval's own sha; a verify only counts as current when it is a\\n    pass bound to that build's own sha -- the same staleness a re-approval\\n    or a re-build must force, attest's own chain check already enforces\\n    (check_attest_chain), read here rather than re-typed.\\\"\\\"\\\"\\n    records_rel = m[\\\"paths\\\"][\\\"records\\\"]\\n    records_dir = root / records_rel / item_id\\n\\n    status = approval_status(root, m, item_id)\\n    if status != \\\"valid\\\":\\n        return \\\"no-approval\\\", status, records_dir\\n\\n    latest_approval = latest_record(records_dir, \\\"approval\\\")\\n    latest_build = latest_record(records_dir, \\\"build\\\")\\n    build_current = (latest_build is not None and latest_build.get(\\\"status\\\") == \\\"pass\\\"\\n                     and latest_build.get(\\\"approval_sha\\\")\\n                     == (latest_approval.get(\\\"sha\\\") if latest_approval else None))\\n    if latest_build is None or not build_current:\\n        return \\\"build\\\", None, records_dir\\n\\n    latest_verify = latest_record(records_dir, \\\"verify\\\")\\n    verify_current = (latest_verify is not None and latest_verify.get(\\\"status\\\") == \\\"pass\\\"\\n                      and latest_verify.get(\\\"build_sha\\\") == latest_build.get(\\\"sha\\\"))\\n    if not verify_current:\\n        return \\\"verify\\\", None, records_dir\\n\\n    return \\\"ready\\\", None, records_dir\\n\\n\\n# --- the heartbeat, the worker log, and the forge-checks handoff: local\\n# facts under the checkout's own git directory (issue #140's precedent),\\n# never committed and never among the paths commit_record ever names. ---\\n\\ndef heartbeat_s() -> float:\\n    return float(os.environ.get(\\\"ATTAVO_HEARTBEAT_S\\\", 15))\\n\\n\\ndef heartbeat_path(root: Path, stage: str, nn: int) -> Path:\\n    return stage_events_dir(root) / f\\\"{stage}-{nn:02d}.heartbeat\\\"\\n\\n\\ndef worker_log_path(root: Path, stage: str, nn: int) -> Path:\\n    return stage_events_dir(root) / f\\\"{stage}-{nn:02d}.worker.log\\\"\\n\\n\\ndef forge_checks_path(root: Path, stage: str, nn: int) -> Path:\\n    return stage_events_dir(root) / f\\\"{stage}-{nn:02d}.forge-checks.json\\\"\\n\\n\\ndef _events_path_for(root: Path, stage: str, nn: int) -> Path | None:\\n    \\\"\\\"\\\"The adapter's own events file for this invocation, under the\\n    checkout's git dir (a worktree's own dir when the checkout is one).\\\"\\\"\\\"\\n    try:\\n        gitdir = Path(git(root, \\\"rev-parse\\\", \\\"--git-dir\\\").strip())\\n    except RuntimeError:\\n        return None\\n    if not gitdir.is_absolute():\\n        gitdir = root / gitdir\\n    path = gitdir / \\\"attavo\\\" / f\\\"{stage}-{nn:02d}.events.jsonl\\\"\\n    return path if path.is_file() else None\\n\\n\\ndef _events_tail(path: Path | None, lines: int = 20) -> tuple[str, str | None]:\\n    \\\"\\\"\\\"(the last lines as a log, the last event's own at).\\\"\\\"\\\"\\n    if path is None:\\n        return \\\"no events file for this invocation\\\\n\\\", None\\n    try:\\n        text = path.read_text()\\n    except OSError:\\n        return \\\"events file unreadable\\\\n\\\", None\\n    tail = text.splitlines()[-lines:]\\n    last_at = None\\n    for line in reversed(tail):\\n        parsed = _parse_json_line(line)\\n        if not isinstance(parsed, dict):\\n            continue\\n        at = parsed.get(\\\"at\\\")\\n        if isinstance(at, str):\\n            last_at = at\\n            break\\n    return \\\"\\\\n\\\".join(tail) + \\\"\\\\n\\\", last_at\\n\\n\\ndef _seconds_since(at: str | None) -> float | None:\\n    from datetime import datetime, timezone\\n    if not at:\\n        return None\\n    try:\\n        then = datetime.strptime(at, \\\"%Y-%m-%dT%H:%M:%SZ\\\").replace(tzinfo=timezone.utc)\\n    except ValueError:\\n        return None\\n    return (datetime.now(timezone.utc) - then).total_seconds()\\n\\n\\nclass InvocationReading(NamedTuple):\\n    \\\"\\\"\\\"What one marker with no record reads as, from here and now.\\\"\\\"\\\"\\n    stage: str\\n    nn: int\\n    log: str\\n    last_at: str | None\\n    age: float | None\\n    cls: str  # \\\"running\\\" | \\\"hung\\\" | \\\"died\\\"\\n    bound: str | None = None  # R3: \\\"stall\\\" or \\\"ceiling\\\" when cls is \\\"hung\\\"\\n\\n\\ndef read_invocation(root: Path, bound: int | None, marker: Path, info: dict[str, Any]) -> InvocationReading:\\n    \\\"\\\"\\\"Whether an invocation that began and wrote no record is running,\\n    hung, or died -- read from its own heartbeat first (R2): a heartbeat\\n    file fresh within three beats of ATTAVO_HEARTBEAT_S is alive; a stale\\n    one is died, whether or not the pid still lives -- a worker stuck\\n    somewhere that never reaches its own heartbeat loop again is exactly\\n    what this is for. Only with no heartbeat file at all -- an invocation\\n    from before this release, or one that died before touching its\\n    first beat -- does this fall back to the pid: alive and, with a\\n    stall bound declared, past it is hung; alive with no bound, or\\n    within it, is running for as long as it lives; not alive is died.\\n    The stall bound decides hung, never died.\\\"\\\"\\\"\\n    stage, nn_text = marker.stem.rsplit(\\\"-\\\", 1)\\n    nn = int(nn_text)\\n    log, last_at = _events_tail(_events_path_for(root, stage, nn))\\n    # R3: the stage ceiling, wall clock from the marker's own `at`, judged\\n    # before any liveness signal -- alive past it is hung by the ceiling,\\n    # whatever its event age (or absence of one) says.\\n    m = read_manifest(root) or {}\\n    ceiling = ceiling_s(m, stage)\\n    since_start = _seconds_since(info.get(\\\"at\\\"))\\n    if ceiling is not None and since_start is not None and since_start > ceiling:\\n        return InvocationReading(stage, nn, log, last_at, since_start, \\\"hung\\\", \\\"ceiling\\\")\\n    if not _streams_events(root, m, stage):\\n        # An adapter that declares it streams no events is judged by the\\n        # ceiling alone; the stall bound it can never trip is not asked.\\n        bound = None\\n    beat = heartbeat_path(root, stage, nn)\\n    if beat.is_file():\\n        try:\\n            beat_age = time.time() - beat.stat().st_mtime\\n        except OSError:\\n            beat_age = None\\n        cls = \\\"running\\\" if beat_age is not None and beat_age <= heartbeat_s() * 3 else \\\"died\\\"\\n        return InvocationReading(stage, nn, log, last_at, beat_age, cls)\\n    age = _seconds_since(last_at or info.get(\\\"at\\\"))\\n    if not invocation_alive(info):\\n        return InvocationReading(stage, nn, log, last_at, age, \\\"died\\\")\\n    if bound is None or age is None or age <= bound:\\n        return InvocationReading(stage, nn, log, last_at, age, \\\"running\\\")\\n    return InvocationReading(stage, nn, log, last_at, age, \\\"hung\\\", \\\"stall\\\")\\n\\n\\ndef _streams_events(root: Path, m: dict[str, Any], stage: str) -> bool:\\n    \\\"\\\"\\\"R3: whether the stage's adapter declares it streams events\\n    (adapters/<name>/conformance.json, \\\"streams_events\\\"); true when the\\n    adapter names none, or its conformance.json does not say.\\\"\\\"\\\"\\n    name = (m.get(\\\"executor\\\") or {}).get(stage) or (m.get(\\\"executor\\\") or {}).get(\\\"build\\\")\\n    if not name:\\n        return True\\n    for base in (root / \\\"attavo\\\" / \\\"adapters\\\", PRODUCT_ROOT / \\\"adapters\\\"):\\n        conf = base / name / \\\"conformance.json\\\"\\n        if conf.is_file():\\n            try:\\n                return bool(json.loads(conf.read_text()).get(\\\"streams_events\\\", True))\\n            except (OSError, ValueError):\\n                return True\\n    return True\\n\\n\\ndef uncommitted_record(root: Path, records_dir: Path, stage: str) -> Path | None:\\n    \\\"\\\"\\\"The latest <stage>-NN.json this working tree carries that git has\\n    no commit for yet -- the moment between a worker's write and its own\\n    commit. None when the latest record is already committed, or there\\n    is none at all.\\\"\\\"\\\"\\n    path = latest_attempt_path(records_dir, stage)\\n    if path is None or not path.is_file():\\n        return None\\n    status = subprocess.run(\\n        [\\\"git\\\", \\\"-C\\\", str(root), \\\"status\\\", \\\"--porcelain\\\", \\\"--\\\", str(path.relative_to(root))],\\n        capture_output=True, text=True, check=False)\\n    return path if status.stdout.strip() else None\\n\\n\\ndef worker_holds_copy(root: Path, records_dir: Path) -> bool:\\n    \\\"\\\"\\\"True when this checkout's own working tree cannot safely be moved\\n    -- an invocation marker with no record yet (a worker, here or\\n    elsewhere, still holds this attempt), or a build or verify record the\\n    working tree carries that git has not committed yet. Scoped to the\\n    stage records a pass or a worker itself ever transports -- an\\n    operator's own spec-gate or approve, routinely uncommitted between\\n    their own act and the next pass, is not this. A pass never\\n    fast-forwards while this holds (never while a worker holds the\\n    copy).\\\"\\\"\\\"\\n    if invocations_without_record(records_dir):\\n        return True\\n    return (uncommitted_record(root, records_dir, \\\"build\\\") is not None\\n           or uncommitted_record(root, records_dir, \\\"verify\\\") is not None)\\n\\n\\ndef fast_forward_to_origin(root: Path, m: dict[str, Any], item_id: str) -> None:\\n    \\\"\\\"\\\"The pass's own read of origin's branch, taken before it reads\\n    anything else -- a commit landed there from elsewhere (an approval\\n    from the screen, a ruling, another pass's own record) is not a race\\n    for the lease, it is exactly what the lease is for. Never while a\\n    worker holds this copy (worker_holds_copy): resetting a working tree\\n    a detached child is still writing into would corrupt its own commits.\\n    A plain fast-forward when origin is simply ahead; when this checkout\\n    also carries its own commits origin has not seen yet (an operator's\\n    approval, not yet pushed), those are replayed on top of origin's own\\n    tip instead -- no merge commit, and the marker this pass is about to\\n    write still lands as a fast-forward when it pushes. Silent about\\n    everything short of that -- a real conflict, or an absent origin, is\\n    left for the ordinary read (and the marker push, for the lease) to\\n    sort out.\\\"\\\"\\\"\\n    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n    if worker_holds_copy(root, records_dir) or not has_origin(root):\\n        return\\n    try:\\n        branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n        git(root, \\\"fetch\\\", \\\"origin\\\", branch)\\n    except RuntimeError:\\n        return\\n    try:\\n        git(root, \\\"merge\\\", \\\"--ff-only\\\", \\\"FETCH_HEAD\\\")\\n        return\\n    except RuntimeError:\\n        pass\\n    try:\\n        git(root, \\\"rebase\\\", \\\"FETCH_HEAD\\\")\\n    except RuntimeError:\\n        subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"rebase\\\", \\\"--abort\\\"],\\n                       capture_output=True, text=True, check=False)\\n\\n\\n# --- the worker: a detached child of the pass's own session, running the\\n# stage exactly as the pass used to inline, touching its own heartbeat\\n# while it does (R2). ---\\n\\ndef _stage_body(item_id: str, stage: str, nn: int) -> int:\\n    \\\"\\\"\\\"Runs build or verify in-process -- the same command `attavo build`\\n    or `attavo verify` would run -- while touching heartbeat_path every\\n    heartbeat_s() seconds, then transports whatever it wrote: counsel and\\n    file-stops on a non-pass record (issue #100, #89), one `git commit\\n    --only`, one push with the record push's own merge retry. The\\n    marker is the pass's, already committed and pushed before this\\n    starts; this writes and transports only the stage's own record (and,\\n    on a stop, its counsel record).\\\"\\\"\\\"\\n    root = Path(\\\".\\\").resolve()\\n    m = read_manifest(root)\\n    if m is None:\\n        return 2\\n    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n    before = latest_attempt_path(records_dir, stage)\\n\\n    beat = heartbeat_path(root, stage, nn)\\n    beat.parent.mkdir(parents=True, exist_ok=True)\\n    beat.touch()\\n    stop_beat = threading.Event()\\n\\n    def _tick() -> None:\\n        while not stop_beat.wait(heartbeat_s()):\\n            beat.touch()\\n\\n    beat_thread = threading.Thread(target=_tick, daemon=True)\\n    beat_thread.start()\\n    try:\\n        rc = cmd_build([item_id]) if stage == \\\"build\\\" else cmd_verify([item_id])\\n    finally:\\n        stop_beat.set()\\n        beat_thread.join()\\n\\n    after = latest_attempt_path(records_dir, stage)\\n    if after is None or after == before:\\n        # Refused before writing anything at all (e.g. no adapter\\n        # configured) -- the stage command already printed why.\\n        return rc if rc != 0 else 1\\n\\n    record = cast(dict[str, Any], latest_record(records_dir, stage))\\n    status_out = record.get(\\\"status\\\")\\n    to_commit = [after]\\n    if status_out != \\\"pass\\\":\\n        counsel_before = latest_attempt_path(records_dir, \\\"counsel\\\")\\n        cmd_counsel([item_id])\\n        counsel_after = latest_attempt_path(records_dir, \\\"counsel\\\")\\n        if counsel_after is not None and counsel_after != counsel_before:\\n            to_commit.append(counsel_after)\\n        # file-stops is its own idempotent read of the item's records, so\\n        # calling it here on every run that wrote a non-pass record is\\n        # safe to call again on a later run: an already-filed stop's own\\n        # marker is what stops it from being filed twice.\\n        cmd_file_stops([item_id])\\n\\n    message = f\\\"attavo: {stage} record for item {item_id} ({after.stem})\\\"\\n    try:\\n        commit_record(root, to_commit, message)\\n    except RuntimeError as exc:\\n        print(f\\\"attavo drive: stopped: could not commit the {stage} record: {exc}\\\")\\n        return 1\\n\\n    if has_origin(root):\\n        ok, err = push_record_commit(root, branch)\\n        if not ok:\\n            print(f\\\"attavo drive: stopped: could not push the {stage} record: {err}\\\")\\n            return 1\\n    else:\\n        print(f\\\"attavo drive: note: no origin remote; {after.name} is committed, not pushed\\\")\\n\\n    if status_out == \\\"halted\\\":\\n        question = (record.get(\\\"halted\\\") or {}).get(\\\"question\\\")\\n        print(f\\\"attavo drive: stopped: {stage} halted: {question} ({after.name}); \\\"\\n              f\\\"pushed to {branch}\\\")\\n    elif status_out != \\\"pass\\\":\\n        reason = record.get(\\\"refusal\\\") or status_out\\n        print(f\\\"attavo drive: stopped: {stage} {status_out}: {reason} ({after.name}); \\\"\\n              f\\\"pushed to {branch}\\\")\\n    else:\\n        print(f\\\"attavo drive: pushed {after.name} to {branch}\\\")\\n    return rc\\n\\n\\ndef cmd_worker(argv: list[str]) -> int:\\n    \\\"\\\"\\\"`attavo worker N <build|verify> NN`: the detached child a pass\\n    starts once its marker is pushed -- the lease held, the attempt is\\n    this worker's to run. Its own session (start_new_session, set by the\\n    pass that spawns it); its stdout and stderr are the pass's own\\n    redirect, to <git-dir>/attavo/<stage>-NN.worker.log.\\\"\\\"\\\"\\n    cast(io.TextIOWrapper, sys.stdout).reconfigure(line_buffering=True)\\n    if len(argv) != 3:\\n        print(\\\"attavo worker: usage: attavo worker N <build|verify> NN\\\", file=sys.stderr)\\n        return 2\\n    item_id, stage, nn_text = argv\\n    if stage not in (\\\"build\\\", \\\"verify\\\"):\\n        print(f\\\"attavo worker: {stage!r} is not build or verify\\\", file=sys.stderr)\\n        return 2\\n    try:\\n        nn = int(nn_text)\\n    except ValueError:\\n        print(f\\\"attavo worker: {nn_text!r} is not an attempt number\\\", file=sys.stderr)\\n        return 2\\n    return _stage_body(item_id, stage, nn)\\n\\n\\n# --- the pass's own two acts: start a stage (the lease), and recover\\n# exactly the one invocation the report names owed one. ---\\n\\ndef _start_stage(root: Path, m: dict[str, Any], item_id: str, stage: str,\\n                 forge_checks: dict[str, Any] | None, *, again_by: bool = False) -> int:\\n    \\\"\\\"\\\"The lease (ruling A): the marker, committed and pushed as a plain\\n    fast-forward with no merge and no retry (push_lease). Lost to another\\n    pass, or refused outright by the remote, both undo the marker commit\\n    here (git reset --hard) so this checkout carries no half-taken\\n    attempt either way; only a pushed lease starts the worker. On a\\n    review, forge_checks is the checks this same pass already read on\\n    the pre-marker head (ruling B) -- written to\\n    <git-dir>/attavo/verify-NN.forge-checks.json and named in\\n    ATTAVO_FORGE_CHECKS, so the worker's own `attavo verify` reads it\\n    instead of polling. R3: again_by names the marker as `--again`'s own\\n    act on a stage whose budget was already spent.\\\"\\\"\\\"\\n    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n    nn = next_attempt_number(records_dir, stage)\\n    marker = write_invocation_marker(root, records_dir, stage, nn, again_by=again_by)\\n    try:\\n        commit_record(root, [marker], f\\\"attavo: {stage} invocation {nn:02d} started for item {item_id}\\\")\\n    except RuntimeError as exc:\\n        print(f\\\"attavo drive: stopped: could not commit the {stage} invocation marker: {exc}\\\")\\n        return 1\\n\\n    if has_origin(root):\\n        outcome, err = push_lease(root, branch)\\n        if outcome != \\\"pushed\\\":\\n            git(root, \\\"reset\\\", \\\"--hard\\\", \\\"HEAD^\\\")\\n            if outcome == \\\"lost-race\\\":\\n                print(f\\\"attavo drive: another pass holds this attempt ({marker.name}); nothing started\\\")\\n                return 0\\n            print(f\\\"attavo drive: stopped: could not push the {stage} invocation marker: {err}\\\")\\n            return 1\\n\\n    env = dict(os.environ)\\n    if forge_checks is not None:\\n        checks_file = forge_checks_path(root, stage, nn)\\n        checks_file.write_text(json.dumps(forge_checks))\\n        env[\\\"ATTAVO_FORGE_CHECKS\\\"] = str(checks_file)\\n    log = worker_log_path(root, stage, nn)\\n    with log.open(\\\"ab\\\") as fh, open(os.devnull, \\\"rb\\\") as devnull:\\n        proc = subprocess.Popen(\\n            [sys.executable, str(PRODUCT_ROOT / \\\"bin\\\" / \\\"attavo\\\"), \\\"worker\\\", item_id, stage, f\\\"{nn:02d}\\\"],\\n            cwd=str(root), env=env, stdin=devnull, stdout=fh, stderr=subprocess.STDOUT,\\n            start_new_session=True)\\n    word = \\\"Build\\\" if stage == \\\"build\\\" else \\\"Review\\\"\\n    print(f\\\"attavo drive: {word} started (attempt {nn:02d}, worker pid {proc.pid})\\\")\\n    return 0\\n\\n\\ndef _recover_one(root: Path, m: dict[str, Any], item_id: str, records_dir: Path) -> int:\\n    \\\"\\\"\\\"The pass's own recovery act (what `--recover` did): exactly the one\\n    invocation the report just read as owing one -- died or hung -- ends\\n    here. class died when the heartbeat is stale (or absent and the pid\\n    is gone), class hung when there is no heartbeat, the pid lives, and a\\n    declared [drive].stall_after_s has passed with no newer event, and\\n    terminated. Provenance product; the events tail as the log. Committed\\n    and pushed the way any stage record is (push_record_commit, with its\\n    own merge retry) -- this is not a race for a lease, since no new\\n    attempt marker is written.\\\"\\\"\\\"\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n    bound = stall_bound_s(m)\\n    pending = invocations_without_record(records_dir)\\n    readings = [(marker, info, read_invocation(root, bound, marker, info)) for marker, info in pending]\\n    candidate = next(((mk, i, rd) for mk, i, rd in readings if rd.cls != \\\"running\\\"), None)\\n    if candidate is None:\\n        # The report read this a moment ago; nothing owed recovery by the\\n        # time this pass got here (another pass recovered it, or it\\n        # finished on its own).\\n        return 0\\n    marker, info, reading = candidate\\n    stage, nn, log, last_at, age, cls, crossed = reading\\n    pid, host = info.get(\\\"pid\\\"), info.get(\\\"host\\\")\\n\\n    if next_attempt_number(records_dir, stage) != nn:\\n        print(f\\\"attavo drive: stopped: {marker.name} names attempt {nn} but the next \\\"\\n              f\\\"{stage} record would be {next_attempt_number(records_dir, stage):02d}; \\\"\\n              f\\\"a later record already exists, read the records before recovering\\\")\\n        return 1\\n\\n    if cls == \\\"hung\\\":\\n        try:\\n            os.kill(cast(int, pid), signal.SIGTERM)\\n            ended = \\\"terminated\\\"\\n        except OSError as exc:\\n            ended = f\\\"not terminated ({exc})\\\"\\n        if crossed == \\\"ceiling\\\":\\n            detail = (f\\\"pid {pid} on {host} alive {int(cast(float, age))} s after its marker, past \\\"\\n                      f\\\"the {stage} ceiling of {ceiling_s(m, stage)} s; {ended}\\\")\\n        else:\\n            detail = (f\\\"pid {pid} on {host} alive with no event for {int(cast(float, age))} s \\\"\\n                      f\\\"(bound {bound} s); {ended}\\\")\\n    else:\\n        detail = (f\\\"pid {pid} on {host} is not running and wrote no {marker.stem}.json; \\\"\\n                  f\\\"started {info.get('at')}, last event {last_at or 'none'}\\\")\\n\\n    schema = stage_schema(stage)\\n    record: dict[str, Any] = {k: None for k in schema.get(\\\"required\\\", [])}\\n    approval = latest_record(records_dir, \\\"approval\\\")\\n    signature_source = log.strip().splitlines()[-1] if log.strip() else detail\\n    record.update({\\\"sha\\\": info.get(\\\"sha\\\"), \\\"start_sha\\\": info.get(\\\"sha\\\"),\\n                   \\\"approval_sha\\\": approval.get(\\\"sha\\\") if approval else None,\\n                   \\\"at\\\": info.get(\\\"at\\\"),\\n                   \\\"adapter\\\": (m.get(\\\"executor\\\") or {}).get(stage),\\n                   \\\"status\\\": \\\"failed\\\", \\\"refusal\\\": None, \\\"halted\\\": None,\\n                   \\\"retry_of\\\": None, \\\"steer\\\": None,\\n                   \\\"stop\\\": {\\\"class\\\": cls, \\\"provenance\\\": \\\"product\\\", \\\"detail\\\": detail,\\n                            \\\"signature\\\": signature_of(signature_source), \\\"bound\\\": crossed}})\\n    if \\\"wall_clock_s\\\" in record:\\n        record[\\\"wall_clock_s\\\"] = None if age is None else int(age)\\n    record = {k: v for k, v in record.items() if k in schema.get(\\\"properties\\\", {})}\\n    try:\\n        path = write_record(records_dir, stage, record, m, item_id, log=log)\\n    except ValueError as exc:\\n        print(f\\\"attavo drive: stopped: could not write the {cls} record for {marker.stem}: {exc}\\\")\\n        return 1\\n    try:\\n        commit_record(root, [path], f\\\"attavo: {stage} record for item {item_id} \\\"\\n                                    f\\\"({path.stem}), recovered as {cls}\\\")\\n    except RuntimeError as exc:\\n        print(f\\\"attavo drive: stopped: could not commit the {cls} record: {exc}\\\")\\n        return 1\\n    if has_origin(root):\\n        ok, err = push_record_commit(root, branch)\\n        if not ok:\\n            print(f\\\"attavo drive: stopped: could not push the {cls} record: {err}\\\")\\n            return 1\\n    else:\\n        print(f\\\"attavo drive: note: no origin remote; {path.name} is committed, not pushed\\\")\\n    print(f\\\"attavo drive: recovered {marker.stem} as {cls}: {detail}\\\")\\n    return 0\\n\\n\\ndef _advance_again(root: Path, m: dict[str, Any], item_id: str, stage: str, head: str | None, *,\\n                   again_by: bool = False) -> int:\\n    \\\"\\\"\\\"The next attempt of a stopped stage: exactly what next-build or\\n    next-review would do, bypassing the level a plain pass leaves alone\\n    for the operator -- the pass's own automatic retry of a retryable\\n    family, or `--again`'s act once a budget is spent (again_by). A\\n    review reads the forge fresh here -- once, since the report's own\\n    stopped reading never touched it -- rather than reusing a read that\\n    was never taken.\\\"\\\"\\\"\\n    if stage == \\\"build\\\":\\n        return _start_stage(root, m, item_id, \\\"build\\\", None, again_by=again_by)\\n    checks_command = (m.get(\\\"forge\\\") or {}).get(\\\"checks_command\\\")\\n    if not checks_command:\\n        print(\\\"attavo drive: refused: no [forge].checks_command in the manifest\\\")\\n        return 1\\n    forge_checks, ok = read_forge_checks(root, checks_command, cast(str, head))\\n    if not ok:\\n        conclusions = forge_checks[\\\"conclusions\\\"]\\n        named = \\\", \\\".join(f\\\"{c['name']} {c['conclusion']}\\\" for c in conclusions) or \\\"no checks reported\\\"\\n        print(f\\\"attavo drive: forge checks not green on {cast(str, head)[:12]}: {named}\\\")\\n        return 0\\n    return _start_stage(root, m, item_id, \\\"verify\\\", forge_checks, again_by=again_by)\\n\\n\\ndef _retry_target(r: \\\"DriveReport\\\") -> str:\\n    \\\"\\\"\\\"The stage the next attempt actually starts: class \\\"returned\\\" (a\\n    build's head a check rejected, or a review's own blocking finding) is\\n    always the verify record's own stop, but the retry it starts is the\\n    next build.\\\"\\\"\\\"\\n    return \\\"build\\\" if r[\\\"stop_class\\\"] == \\\"returned\\\" else cast(str, r[\\\"stage\\\"])\\n\\n\\ndef _retry_due(root: Path, m: dict[str, Any], item_id: str, r: \\\"DriveReport\\\") -> bool:\\n    \\\"\\\"\\\"R3: a stopped stage whose class is one of the four retryable\\n    families, whose budget is not spent, whose last two signatures\\n    differ, and -- for transient -- whose record has aged past\\n    [drive].retry_after_s, is retried by the next plain pass, no\\n    counsel, no operator act.\\\"\\\"\\\"\\n    if r[\\\"stop_class\\\"] not in RETRYABLE_CLASSES:\\n        return False\\n    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n    sig_stage = cast(str, r[\\\"stage\\\"])\\n    budget_stage = _retry_target(r)\\n    if stage_exhausted(records_dir, m, sig_stage, budget_stage):\\n        return False\\n    if r[\\\"stop_class\\\"] == \\\"transient\\\":\\n        attempts = parse_attempts(records_dir, sig_stage)\\n        latest = attempts[max(attempts)] if attempts else {}\\n        age = _seconds_since(latest.get(\\\"at\\\"))\\n        if age is None or age < retry_after_s(m):\\n            return False\\n    return True\\n\\n\\ndef _handle_again(root: Path, m: dict[str, Any], item_id: str, r: \\\"DriveReport\\\") -> int:\\n    \\\"\\\"\\\"`--again`'s own act on a stopped stage (R3): a retryable family\\n    whose budget is not spent is left to the pass's own automatic retry\\n    -- a no-op here, saying so -- since starting it twice would spend two\\n    attempts on one press. A retryable family whose budget is spent, or\\n    any other stopped class, starts the next attempt at once, its marker\\n    naming --again as what started it.\\\"\\\"\\\"\\n    stage = _retry_target(r)\\n    if r[\\\"stop_class\\\"] in RETRYABLE_CLASSES:\\n        records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n        if not stage_exhausted(records_dir, m, cast(str, r[\\\"stage\\\"]), stage):\\n            print(\\\"attavo drive: --again is a no-op inside the budget; the pass retries on its own\\\")\\n            return 0\\n    return _advance_again(root, m, item_id, stage, r[\\\"head\\\"], again_by=True)\\n\\n\\ndef _counsel_answered(records_dir: Path, r: \\\"DriveReport\\\") -> bool:\\n    \\\"\\\"\\\"R3: whether the stop this report just read as \\\"stopped\\\" already\\n    carries counsel's own \\\"answer\\\" verdict -- every non-retryable class\\n    is counsel's to read (as before this item), and `answer` starts the\\n    next attempt with the answer as its steer, read from the feedback\\n    file the retried attempt's own first iteration is handed\\n    (attavo.build._retry_seed).\\\"\\\"\\\"\\n    if r[\\\"stop_class\\\"] in RETRYABLE_CLASSES or not r[\\\"stage\\\"] or r[\\\"attempt\\\"] is None:\\n        return False\\n    counsel = counsel_record_for(records_dir, cast(str, r[\\\"stage\\\"]), cast(int, r[\\\"attempt\\\"]))\\n    return counsel is not None and counsel.get(\\\"verdict\\\") == \\\"answer\\\"\\n\\n\\ndef _pass_once(root: Path, m: dict[str, Any], item_id: str, again: bool) -> tuple[int, \\\"DriveReport\\\"]:\\n    \\\"\\\"\\\"One pass: fast-forward to origin (never while a worker holds the\\n    copy), read the report, act at most once, return. The three acts,\\n    one per report state that is the product's move: owes-recovery\\n    recovers; next-build and next-review start their stage, handing a\\n    review the checks the report already read once on the pre-marker\\n    head; a concluded red check on a passed build's head (R3) is a\\n    returned review record, not a level, so the review starts the same\\n    way. On a stopped stage, `--again` always wins (a no-op inside the\\n    budget, the next attempt once it is spent); absent it, a retryable\\n    family retries on its own, and any other stop counsel has already\\n    answered starts the next attempt steered by that answer. Every other\\n    level is printed in the report's own words and left.\\\"\\\"\\\"\\n    from attavo.report import drive_report\\n    fast_forward_to_origin(root, m, item_id)\\n    r = drive_report(root, m, item_id)\\n\\n    if r[\\\"state\\\"] == \\\"owes-recovery\\\":\\n        records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n        return _recover_one(root, m, item_id, records_dir), r\\n    if r[\\\"state\\\"] == \\\"next-build\\\":\\n        return _start_stage(root, m, item_id, \\\"build\\\", None), r\\n    if r[\\\"state\\\"] == \\\"next-review\\\":\\n        checks_command = (m.get(\\\"forge\\\") or {}).get(\\\"checks_command\\\")\\n        forge_checks = {\\\"command\\\": checks_command, \\\"sha\\\": r[\\\"head\\\"], \\\"conclusions\\\": r[\\\"checks\\\"] or []}\\n        return _start_stage(root, m, item_id, \\\"verify\\\", forge_checks), r\\n    if r[\\\"state\\\"] == \\\"blocked-on-checks\\\" and r[\\\"stage\\\"] == \\\"verify\\\":\\n        # R3: the rejection is a record, not a level with nothing behind\\n        # it (#206's build-01) -- the review starts, reading the same\\n        # forge checks this pass just read, and writes the check\\n        # rejection itself as a returned record (attavo.verify.cmd_verify).\\n        checks_command = (m.get(\\\"forge\\\") or {}).get(\\\"checks_command\\\")\\n        forge_checks = {\\\"command\\\": checks_command, \\\"sha\\\": r[\\\"head\\\"], \\\"conclusions\\\": r[\\\"checks\\\"] or []}\\n        return _start_stage(root, m, item_id, \\\"verify\\\", forge_checks), r\\n    if r[\\\"state\\\"] == \\\"stopped\\\" and r[\\\"stage\\\"]:\\n        if again:\\n            return _handle_again(root, m, item_id, r), r\\n        records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n        if _retry_due(root, m, item_id, r):\\n            return _advance_again(root, m, item_id, _retry_target(r), r[\\\"head\\\"]), r\\n        if _counsel_answered(records_dir, r):\\n            return _advance_again(root, m, item_id, _retry_target(r), r[\\\"head\\\"]), r\\n\\n    print(f\\\"attavo drive: {r['says']}\\\")\\n    return (1 if r[\\\"state\\\"] == \\\"refused\\\" else 0), r\\n\\n\\n_TERMINAL_STATES = (\\\"waiting-on-approval\\\", \\\"stopped\\\", \\\"ready-to-merge\\\", \\\"merged\\\")\\n\\n\\ndef _until_ready(root: Path, m: dict[str, Any], item_id: str, again: bool) -> int:\\n    \\\"\\\"\\\"--until-ready: the pass, repeated in one process, sleeping\\n    ATTAVO_DRIVE_POLL_INTERVAL_S between passes, until the level is the\\n    operator's or done (exit 0), a concluded check is red (exit 1), or\\n    an unconcluded one has not concluded within ATTAVO_DRIVE_POLL_BOUND_S\\n    (exit 1). A stage running in its own worker is not bounded by this --\\n    only time spent waiting on the forge is.\\\"\\\"\\\"\\n    from attavo.verify import drive_forge_poll_bound_s, drive_forge_poll_interval_s\\n    bound = drive_forge_poll_bound_s()\\n    interval = drive_forge_poll_interval_s()\\n    waiting_since: float | None = None\\n    while True:\\n        rc, r = _pass_once(root, m, item_id, again)\\n        state = r[\\\"state\\\"]\\n\\n        if state == \\\"waiting-on-checks\\\":\\n            if waiting_since is None:\\n                waiting_since = time.monotonic()\\n            elif time.monotonic() - waiting_since >= bound:\\n                print(f\\\"attavo drive: stopped: the checks did not conclude within {bound:.0f}s\\\")\\n                return 1\\n        else:\\n            waiting_since = None\\n\\n        if rc != 0:\\n            return rc\\n        if state in _TERMINAL_STATES:\\n            return 0\\n        if state == \\\"blocked-on-checks\\\" and r[\\\"stage\\\"] != \\\"verify\\\":\\n            # R3: stage \\\"verify\\\" here is the pass's own act, just taken --\\n            # a concluded red check on a passed build's head is now a\\n            # returned review record (attavo.verify.cmd_verify), not a\\n            # level the loop gives up on with nothing behind it.\\n            return 1\\n        time.sleep(interval)\\n\\n\\ndef _drive_all() -> int:\\n    \\\"\\\"\\\"--all: one pass, in its own process, in every ../attavo-worktree-N\\n    beside this checkout -- each one derives its own item from its own\\n    attavo/N-* branch. Every line either prints is prefixed with the\\n    worktree's own directory name, so an operator reading them together\\n    can tell which item each line is about.\\\"\\\"\\\"\\n    root = Path(\\\".\\\").resolve()\\n    siblings = sorted(p for p in root.parent.glob(\\\"attavo-worktree-*\\\") if p.is_dir())\\n    if not siblings:\\n        print(\\\"attavo drive: --all found no ../attavo-worktree-N beside this checkout\\\")\\n        return 0\\n    worst = 0\\n    for copy in siblings:\\n        run = subprocess.run([sys.executable, str(PRODUCT_ROOT / \\\"bin\\\" / \\\"attavo\\\"), \\\"drive\\\"],\\n                             cwd=str(copy), capture_output=True, text=True, check=False)\\n        for line in (run.stdout + run.stderr).splitlines():\\n            print(f\\\"{copy.name}: {line}\\\")\\n        worst = max(worst, run.returncode)\\n    return worst\\n\\n\\ndef cmd_drive(argv: list[str]) -> int:\\n    # Issue #145: Python block-buffers stdout when it is not a tty (a\\n    # pipe, e.g. a screen reading this process live), so every line this\\n    # prints would otherwise sit unflushed until the process exits.\\n    # Line-buffering makes a pipe reader see each line the moment it is\\n    # printed, the same as a terminal already does; `attavo worker`\\n    # reconfigures its own stdout the same way.\\n    cast(io.TextIOWrapper, sys.stdout).reconfigure(line_buffering=True)\\n\\n    if \\\"--recover\\\" in argv:\\n        print(\\\"attavo drive: --recover is gone; a pass recovers a dead or hung invocation \\\"\\n              \\\"itself, as soon as the report owes one\\\", file=sys.stderr)\\n        return 2\\n\\n    until_ready = \\\"--until-ready\\\" in argv\\n    report = \\\"--report\\\" in argv\\n    again = \\\"--again\\\" in argv\\n    all_flag = \\\"--all\\\" in argv\\n    positional = [a for a in argv if not a.startswith(\\\"--\\\")]\\n\\n    if all_flag:\\n        if until_ready or report or again or positional:\\n            print(\\\"attavo drive: --all runs one pass in every worktree beside this checkout; \\\"\\n                  \\\"drop N and every other flag\\\", file=sys.stderr)\\n            return 2\\n        return _drive_all()\\n\\n    root = Path(\\\".\\\").resolve()\\n    item_id = positional[0] if positional else derive_item_id(root)\\n    if not item_id:\\n        print(\\\"attavo drive: cannot derive item id; pass N or run on an attavo/N-* branch\\\",\\n              file=sys.stderr)\\n        return 2\\n    m = read_manifest(root)\\n    if m is None:\\n        print(f\\\"attavo drive: no {MANIFEST} at {root}\\\", file=sys.stderr)\\n        return 2\\n\\n    if report:\\n        if until_ready or again:\\n            print(\\\"attavo drive: --report reads and does nothing else; drop --until-ready \\\"\\n                  \\\"and --again\\\", file=sys.stderr)\\n            return 2\\n        fast_forward_to_origin(root, m, item_id)\\n        from attavo.report import drive_report\\n        print(json.dumps(drive_report(root, m, item_id), indent=2))\\n        return 0\\n\\n    if until_ready:\\n        return _until_ready(root, m, item_id, again)\\n    rc, _ = _pass_once(root, m, item_id, again)\\n    return rc\\n\",\"structuredPatch\":[{\"oldStart\":438,\"oldLines\":8,\"newStart\":438,\"newLines\":20,\"lines\":[\"     status_out = record.get(\\\"status\\\")\",\"     to_commit = [after]\",\"     if status_out != \\\"pass\\\":\",\"+        # R3: a retryable family (died, hung, transient, returned) asks\",\"+        # counsel nothing while its budget still has an attempt to\",\"+        # spend -- the next pass retries it plainly. Once its budget is\",\"+        # spent, or its last two signatures match, counsel is read once\",\"+        # more, its sentence carried beside the exhaustion report, never\",\"+        # instead of it. Every other class is counsel's to read on every\",\"+        # stop, as before this item.\",\"+        stop_class = (record.get(\\\"stop\\\") or {}).get(\\\"class\\\")\",\"+        budget_stage = \\\"build\\\" if stop_class == \\\"returned\\\" else stage\",\"+        ask_counsel = (stop_class not in RETRYABLE_CLASSES\",\"+                      or stage_exhausted(records_dir, m, stage, budget_stage))\",\"         counsel_before = latest_attempt_path(records_dir, \\\"counsel\\\")\",\"-        cmd_counsel([item_id])\",\"+        if ask_counsel:\",\"+            cmd_counsel([item_id])\",\"         counsel_after = latest_attempt_path(records_dir, \\\"counsel\\\")\",\"         if counsel_after is not None and counsel_after != counsel_before:\",\"             to_commit.append(counsel_after)\"]}],\"userModified\":false,\"replaceAll\":false,\"contentNotInModelContext\":true}}\n2361:+{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01Gnog5vm3x9EN2iWAmxt3aV\",\"type\":\"tool_result\",\"content\":\"The file /Users/davidbean/Projects/attavo-worktree-219/attavo/drive.py has been updated successfully.\"}]},\"parent_tool_use_id\":null,\"session_id\":\"0dd7ed4f-100c-4188-9a34-077aa0b6aa25\",\"uuid\":\"8acc1e77-1056-44e2-b014-baf14af4ff89\",\"timestamp\":\"2026-09-26T02:28:13.932Z\",\"tool_use_result\":{\"filePath\":\"/Users/davidbean/Projects/attavo-worktree-219/attavo/drive.py\",\"oldString\":\"from attavo.doctor import (\\n    _parse_json_line,\\n    attempts_budget,\\n    ceiling_s,\\n    invocation_alive,\\n    invocations_without_record,\\n    retry_after_s,\\n    stall_bound_s,\\n    write_invocation_marker,\\n)\",\"newString\":\"from attavo.doctor import (\\n    _parse_json_line,\\n    ceiling_s,\\n    invocation_alive,\\n    invocations_without_record,\\n    retry_after_s,\\n    stall_bound_s,\\n    write_invocation_marker,\\n)\",\"originalFile\":\"from __future__ import annotations\\n\\nimport io\\nimport json\\nimport os\\nimport signal\\nimport subprocess\\nimport sys\\nimport threading\\nimport time\\nfrom pathlib import Path\\nfrom typing import TYPE_CHECKING, Any, NamedTuple, cast\\n\\nfrom attavo.approval import approval_status\\nfrom attavo.build import cmd_build, driver_identity\\nfrom attavo.common import MANIFEST, PRODUCT_ROOT, derive_item_id, git, read_manifest\\nfrom attavo.counsel import cmd_counsel\\nfrom attavo.doctor import (\\n    _parse_json_line,\\n    attempts_budget,\\n    ceiling_s,\\n    invocation_alive,\\n    invocations_without_record,\\n    retry_after_s,\\n    stall_bound_s,\\n    write_invocation_marker,\\n)\\nfrom attavo.events import stage_events_dir\\nfrom attavo.filing import cmd_file_stops\\nfrom attavo.records import (\\n    latest_attempt_path,\\n    latest_record,\\n    next_attempt_number,\\n    parse_attempts,\\n    stage_schema,\\n    write_record,\\n)\\nfrom attavo.stops import RETRYABLE_CLASSES, counsel_record_for, signature_of, stage_exhausted\\nfrom attavo.verify import cmd_verify, read_forge_checks\\n\\nif TYPE_CHECKING:\\n    from attavo.types import DriveReport\\n\\n# --- drive: the mechanical transitions between approval and ready-to-merge\\n# (issue #84), under the reconciler's R2 (rulings A, B, C's recovery half,\\n# F, G, H): `attavo drive N` is one short pass. It reads the report\\n# (attavo.report), acts at most once -- recovers a dead or hung\\n# invocation, or starts the next stage in a detached worker -- and\\n# returns within seconds; the stage itself runs in `attavo worker`, a\\n# child of the pass's own session, which outlives it. Writes no record of\\n# its own: the stage records already on disk, and the invocation markers\\n# and heartbeats beside them, are the only state a pass or a worker\\n# reads. ---\\n\\n\\ndef commit_record(root: Path, record_paths: Path | list[Path], message: str) -> None:\\n    \\\"\\\"\\\"`git commit --only` on every record path given, and each one's .log\\n    and .filed, each if one exists -- never the whole index. A transport\\n    commit that sweeps the index is exactly the regression issue #46\\n    already guards build and verify against on the adapter side; drive\\n    must not reintroduce it on the transport side. The .filed marker\\n    (issue #89) is committed alongside the record it names, in the same\\n    commit and the same push, so a second worktree or a fresh clone reads\\n    the same filed fact rather than refiling every stop it finds with no\\n    marker of its own. A single Path is accepted for the common one-record\\n    case; issue #100 passes a list so the counsel record lands in the same\\n    commit as the stage record it counsels. Authored and committed as\\n    driver_identity(), set by the product and never the tenant's git\\n    config, so a driven item's record commits are never indistinguishable\\n    from an operator's own.\\\"\\\"\\\"\\n    if isinstance(record_paths, Path):\\n        record_paths = [record_paths]\\n    paths: list[str] = []\\n    for record_path in record_paths:\\n        paths.append(str(record_path.relative_to(root)))\\n        log_path = record_path.with_suffix(\\\".log\\\")\\n        if log_path.is_file():\\n            paths.append(str(log_path.relative_to(root)))\\n        marker_path = record_path.with_suffix(\\\".filed\\\")\\n        if marker_path.is_file():\\n            paths.append(str(marker_path.relative_to(root)))\\n    identity = driver_identity()\\n    env = dict(os.environ)\\n    env[\\\"GIT_AUTHOR_NAME\\\"] = identity[\\\"name\\\"]\\n    env[\\\"GIT_AUTHOR_EMAIL\\\"] = identity[\\\"email\\\"]\\n    env[\\\"GIT_COMMITTER_NAME\\\"] = identity[\\\"name\\\"]\\n    env[\\\"GIT_COMMITTER_EMAIL\\\"] = identity[\\\"email\\\"]\\n    git(root, \\\"add\\\", *paths)\\n    git(root, \\\"commit\\\", \\\"--only\\\", \\\"-m\\\", message, *paths, env=env)\\n\\n\\ndef push_record_commit(root: Path, branch: str) -> tuple[bool, str | None]:\\n    \\\"\\\"\\\"Push HEAD to branch on origin. A push a divergent remote rejects is\\n    retried once after `git pull --no-rebase --no-edit origin branch` -- a\\n    merge, never a rebase, because a rebase would change the sha the record\\n    commit just wrote already names. This is the record push's own retry\\n    -- the worker's, once it has the lease -- distinct from push_lease\\n    below, which never retries.\\\"\\\"\\\"\\n    def attempt() -> tuple[bool, str]:\\n        run = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"push\\\", \\\"origin\\\", f\\\"HEAD:{branch}\\\"],\\n                             capture_output=True, text=True, check=False)\\n        return run.returncode == 0, run.stderr.strip()\\n\\n    ok, err = attempt()\\n    if ok:\\n        return True, None\\n    pull = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"pull\\\", \\\"--no-rebase\\\", \\\"--no-edit\\\",\\n                           \\\"origin\\\", branch], capture_output=True, text=True, check=False)\\n    if pull.returncode != 0:\\n        return False, f\\\"push rejected and the retry merge failed: {pull.stderr.strip() or err}\\\"\\n    ok, err = attempt()\\n    if not ok:\\n        return False, f\\\"push rejected again after merging {branch}: {err}\\\"\\n    return True, None\\n\\n\\n_RACE_MARKERS = (\\\"non-fast-forward\\\", \\\"fetch first\\\", \\\"stale info\\\", \\\"cannot lock ref\\\",\\n                 \\\"failed to update ref\\\")\\n\\n\\ndef push_lease(root: Path, branch: str) -> tuple[str, str | None]:\\n    \\\"\\\"\\\"Push HEAD to branch on origin as a plain fast-forward -- no merge,\\n    no retry: this is the lease the marker commit takes on the attempt it\\n    names (ruling A). (\\\"pushed\\\", None) on success.\\n\\n    (\\\"lost-race\\\", stderr) when git's own ref check is what rejected it --\\n    the branch moved since this pass fast-forwarded to it (a sequential\\n    \\\"[rejected] ... (fetch first)\\\"), or the remote's own ref transaction\\n    lost a genuine simultaneous push (\\\"[remote rejected] ... (failed to\\n    update ref)\\\", \\\"cannot lock ref\\\"): either way, another pass's own\\n    marker (or record) landed there first. The pass that reads this is\\n    the loser: it says so, resets its own marker commit, and starts\\n    nothing.\\n\\n    (\\\"refused\\\", stderr) for every other rejection -- a remote that\\n    refuses the push outright (a hook, a permission, an unreachable\\n    remote). This is not a race for the lease; it is a refusal, and ends\\n    the pass with exit 1.\\\"\\\"\\\"\\n    run = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"push\\\", \\\"origin\\\", f\\\"HEAD:{branch}\\\"],\\n                         capture_output=True, text=True, check=False)\\n    if run.returncode == 0:\\n        return \\\"pushed\\\", None\\n    stderr = run.stderr\\n    if any(marker in stderr for marker in _RACE_MARKERS):\\n        return \\\"lost-race\\\", stderr.strip()\\n    return \\\"refused\\\", stderr.strip()\\n\\n\\ndef has_origin(root: Path) -> bool:\\n    \\\"\\\"\\\"Whether this checkout carries an origin remote at all -- a fixture\\n    or a scratch checkout with none is not a refusal; a pass commits\\n    locally and skips the push, the way recovery always has.\\\"\\\"\\\"\\n    try:\\n        git(root, \\\"remote\\\", \\\"get-url\\\", \\\"origin\\\")\\n        return True\\n    except RuntimeError:\\n        return False\\n\\n\\ndef drive_state(root: Path, m: dict[str, Any], item_id: str) -> tuple[str, str | None, Path]:\\n    \\\"\\\"\\\"(\\\"no-approval\\\" | \\\"build\\\" | \\\"verify\\\" | \\\"ready\\\", detail, records_dir):\\n    the next mechanical step for item_id, read from its latest records\\n    alone. A build only counts as current when it is a pass bound to the\\n    valid approval's own sha; a verify only counts as current when it is a\\n    pass bound to that build's own sha -- the same staleness a re-approval\\n    or a re-build must force, attest's own chain check already enforces\\n    (check_attest_chain), read here rather than re-typed.\\\"\\\"\\\"\\n    records_rel = m[\\\"paths\\\"][\\\"records\\\"]\\n    records_dir = root / records_rel / item_id\\n\\n    status = approval_status(root, m, item_id)\\n    if status != \\\"valid\\\":\\n        return \\\"no-approval\\\", status, records_dir\\n\\n    latest_approval = latest_record(records_dir, \\\"approval\\\")\\n    latest_build = latest_record(records_dir, \\\"build\\\")\\n    build_current = (latest_build is not None and latest_build.get(\\\"status\\\") == \\\"pass\\\"\\n                     and latest_build.get(\\\"approval_sha\\\")\\n                     == (latest_approval.get(\\\"sha\\\") if latest_approval else None))\\n    if latest_build is None or not build_current:\\n        return \\\"build\\\", None, records_dir\\n\\n    latest_verify = latest_record(records_dir, \\\"verify\\\")\\n    verify_current = (latest_verify is not None and latest_verify.get(\\\"status\\\") == \\\"pass\\\"\\n                      and latest_verify.get(\\\"build_sha\\\") == latest_build.get(\\\"sha\\\"))\\n    if not verify_current:\\n        return \\\"verify\\\", None, records_dir\\n\\n    return \\\"ready\\\", None, records_dir\\n\\n\\n# --- the heartbeat, the worker log, and the forge-checks handoff: local\\n# facts under the checkout's own git directory (issue #140's precedent),\\n# never committed and never among the paths commit_record ever names. ---\\n\\ndef heartbeat_s() -> float:\\n    return float(os.environ.get(\\\"ATTAVO_HEARTBEAT_S\\\", 15))\\n\\n\\ndef heartbeat_path(root: Path, stage: str, nn: int) -> Path:\\n    return stage_events_dir(root) / f\\\"{stage}-{nn:02d}.heartbeat\\\"\\n\\n\\ndef worker_log_path(root: Path, stage: str, nn: int) -> Path:\\n    return stage_events_dir(root) / f\\\"{stage}-{nn:02d}.worker.log\\\"\\n\\n\\ndef forge_checks_path(root: Path, stage: str, nn: int) -> Path:\\n    return stage_events_dir(root) / f\\\"{stage}-{nn:02d}.forge-checks.json\\\"\\n\\n\\ndef _events_path_for(root: Path, stage: str, nn: int) -> Path | None:\\n    \\\"\\\"\\\"The adapter's own events file for this invocation, under the\\n    checkout's git dir (a worktree's own dir when the checkout is one).\\\"\\\"\\\"\\n    try:\\n        gitdir = Path(git(root, \\\"rev-parse\\\", \\\"--git-dir\\\").strip())\\n    except RuntimeError:\\n        return None\\n    if not gitdir.is_absolute():\\n        gitdir = root / gitdir\\n    path = gitdir / \\\"attavo\\\" / f\\\"{stage}-{nn:02d}.events.jsonl\\\"\\n    return path if path.is_file() else None\\n\\n\\ndef _events_tail(path: Path | None, lines: int = 20) -> tuple[str, str | None]:\\n    \\\"\\\"\\\"(the last lines as a log, the last event's own at).\\\"\\\"\\\"\\n    if path is None:\\n        return \\\"no events file for this invocation\\\\n\\\", None\\n    try:\\n        text = path.read_text()\\n    except OSError:\\n        return \\\"events file unreadable\\\\n\\\", None\\n    tail = text.splitlines()[-lines:]\\n    last_at = None\\n    for line in reversed(tail):\\n        parsed = _parse_json_line(line)\\n        if not isinstance(parsed, dict):\\n            continue\\n        at = parsed.get(\\\"at\\\")\\n        if isinstance(at, str):\\n            last_at = at\\n            break\\n    return \\\"\\\\n\\\".join(tail) + \\\"\\\\n\\\", last_at\\n\\n\\ndef _seconds_since(at: str | None) -> float | None:\\n    from datetime import datetime, timezone\\n    if not at:\\n        return None\\n    try:\\n        then = datetime.strptime(at, \\\"%Y-%m-%dT%H:%M:%SZ\\\").replace(tzinfo=timezone.utc)\\n    except ValueError:\\n        return None\\n    return (datetime.now(timezone.utc) - then).total_seconds()\\n\\n\\nclass InvocationReading(NamedTuple):\\n    \\\"\\\"\\\"What one marker with no record reads as, from here and now.\\\"\\\"\\\"\\n    stage: str\\n    nn: int\\n    log: str\\n    last_at: str | None\\n    age: float | None\\n    cls: str  # \\\"running\\\" | \\\"hung\\\" | \\\"died\\\"\\n    bound: str | None = None  # R3: \\\"stall\\\" or \\\"ceiling\\\" when cls is \\\"hung\\\"\\n\\n\\ndef read_invocation(root: Path, bound: int | None, marker: Path, info: dict[str, Any]) -> InvocationReading:\\n    \\\"\\\"\\\"Whether an invocation that began and wrote no record is running,\\n    hung, or died -- read from its own heartbeat first (R2): a heartbeat\\n    file fresh within three beats of ATTAVO_HEARTBEAT_S is alive; a stale\\n    one is died, whether or not the pid still lives -- a worker stuck\\n    somewhere that never reaches its own heartbeat loop again is exactly\\n    what this is for. Only with no heartbeat file at all -- an invocation\\n    from before this release, or one that died before touching its\\n    first beat -- does this fall back to the pid: alive and, with a\\n    stall bound declared, past it is hung; alive with no bound, or\\n    within it, is running for as long as it lives; not alive is died.\\n    The stall bound decides hung, never died.\\\"\\\"\\\"\\n    stage, nn_text = marker.stem.rsplit(\\\"-\\\", 1)\\n    nn = int(nn_text)\\n    log, last_at = _events_tail(_events_path_for(root, stage, nn))\\n    # R3: the stage ceiling, wall clock from the marker's own `at`, judged\\n    # before any liveness signal -- alive past it is hung by the ceiling,\\n    # whatever its event age (or absence of one) says.\\n    m = read_manifest(root) or {}\\n    ceiling = ceiling_s(m, stage)\\n    since_start = _seconds_since(info.get(\\\"at\\\"))\\n    if ceiling is not None and since_start is not None and since_start > ceiling:\\n        return InvocationReading(stage, nn, log, last_at, since_start, \\\"hung\\\", \\\"ceiling\\\")\\n    if not _streams_events(root, m, stage):\\n        # An adapter that declares it streams no events is judged by the\\n        # ceiling alone; the stall bound it can never trip is not asked.\\n        bound = None\\n    beat = heartbeat_path(root, stage, nn)\\n    if beat.is_file():\\n        try:\\n            beat_age = time.time() - beat.stat().st_mtime\\n        except OSError:\\n            beat_age = None\\n        cls = \\\"running\\\" if beat_age is not None and beat_age <= heartbeat_s() * 3 else \\\"died\\\"\\n        return InvocationReading(stage, nn, log, last_at, beat_age, cls)\\n    age = _seconds_since(last_at or info.get(\\\"at\\\"))\\n    if not invocation_alive(info):\\n        return InvocationReading(stage, nn, log, last_at, age, \\\"died\\\")\\n    if bound is None or age is None or age <= bound:\\n        return InvocationReading(stage, nn, log, last_at, age, \\\"running\\\")\\n    return InvocationReading(stage, nn, log, last_at, age, \\\"hung\\\", \\\"stall\\\")\\n\\n\\ndef _streams_events(root: Path, m: dict[str, Any], stage: str) -> bool:\\n    \\\"\\\"\\\"R3: whether the stage's adapter declares it streams events\\n    (adapters/<name>/conformance.json, \\\"streams_events\\\"); true when the\\n    adapter names none, or its conformance.json does not say.\\\"\\\"\\\"\\n    name = (m.get(\\\"executor\\\") or {}).get(stage) or (m.get(\\\"executor\\\") or {}).get(\\\"build\\\")\\n    if not name:\\n        return True\\n    for base in (root / \\\"attavo\\\" / \\\"adapters\\\", PRODUCT_ROOT / \\\"adapters\\\"):\\n        conf = base / name / \\\"conformance.json\\\"\\n        if conf.is_file():\\n            try:\\n                return bool(json.loads(conf.read_text()).get(\\\"streams_events\\\", True))\\n            except (OSError, ValueError):\\n                return True\\n    return True\\n\\n\\ndef uncommitted_record(root: Path, records_dir: Path, stage: str) -> Path | None:\\n    \\\"\\\"\\\"The latest <stage>-NN.json this working tree carries that git has\\n    no commit for yet -- the moment between a worker's write and its own\\n    commit. None when the latest record is already committed, or there\\n    is none at all.\\\"\\\"\\\"\\n    path = latest_attempt_path(records_dir, stage)\\n    if path is None or not path.is_file():\\n        return None\\n    status = subprocess.run(\\n        [\\\"git\\\", \\\"-C\\\", str(root), \\\"status\\\", \\\"--porcelain\\\", \\\"--\\\", str(path.relative_to(root))],\\n        capture_output=True, text=True, check=False)\\n    return path if status.stdout.strip() else None\\n\\n\\ndef worker_holds_copy(root: Path, records_dir: Path) -> bool:\\n    \\\"\\\"\\\"True when this checkout's own working tree cannot safely be moved\\n    -- an invocation marker with no record yet (a worker, here or\\n    elsewhere, still holds this attempt), or a build or verify record the\\n    working tree carries that git has not committed yet. Scoped to the\\n    stage records a pass or a worker itself ever transports -- an\\n    operator's own spec-gate or approve, routinely uncommitted between\\n    their own act and the next pass, is not this. A pass never\\n    fast-forwards while this holds (never while a worker holds the\\n    copy).\\\"\\\"\\\"\\n    if invocations_without_record(records_dir):\\n        return True\\n    return (uncommitted_record(root, records_dir, \\\"build\\\") is not None\\n           or uncommitted_record(root, records_dir, \\\"verify\\\") is not None)\\n\\n\\ndef fast_forward_to_origin(root: Path, m: dict[str, Any], item_id: str) -> None:\\n    \\\"\\\"\\\"The pass's own read of origin's branch, taken before it reads\\n    anything else -- a commit landed there from elsewhere (an approval\\n    from the screen, a ruling, another pass's own record) is not a race\\n    for the lease, it is exactly what the lease is for. Never while a\\n    worker holds this copy (worker_holds_copy): resetting a working tree\\n    a detached child is still writing into would corrupt its own commits.\\n    A plain fast-forward when origin is simply ahead; when this checkout\\n    also carries its own commits origin has not seen yet (an operator's\\n    approval, not yet pushed), those are replayed on top of origin's own\\n    tip instead -- no merge commit, and the marker this pass is about to\\n    write still lands as a fast-forward when it pushes. Silent about\\n    everything short of that -- a real conflict, or an absent origin, is\\n    left for the ordinary read (and the marker push, for the lease) to\\n    sort out.\\\"\\\"\\\"\\n    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n    if worker_holds_copy(root, records_dir) or not has_origin(root):\\n        return\\n    try:\\n        branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n        git(root, \\\"fetch\\\", \\\"origin\\\", branch)\\n    except RuntimeError:\\n        return\\n    try:\\n        git(root, \\\"merge\\\", \\\"--ff-only\\\", \\\"FETCH_HEAD\\\")\\n        return\\n    except RuntimeError:\\n        pass\\n    try:\\n        git(root, \\\"rebase\\\", \\\"FETCH_HEAD\\\")\\n    except RuntimeError:\\n        subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"rebase\\\", \\\"--abort\\\"],\\n                       capture_output=True, text=True, check=False)\\n\\n\\n# --- the worker: a detached child of the pass's own session, running the\\n# stage exactly as the pass used to inline, touching its own heartbeat\\n# while it does (R2). ---\\n\\ndef _stage_body(item_id: str, stage: str, nn: int) -> int:\\n    \\\"\\\"\\\"Runs build or verify in-process -- the same command `attavo build`\\n    or `attavo verify` would run -- while touching heartbeat_path every\\n    heartbeat_s() seconds, then transports whatever it wrote: counsel and\\n    file-stops on a non-pass record (issue #100, #89), one `git commit\\n    --only`, one push with the record push's own merge retry. The\\n    marker is the pass's, already committed and pushed before this\\n    starts; this writes and transports only the stage's own record (and,\\n    on a stop, its counsel record).\\\"\\\"\\\"\\n    root = Path(\\\".\\\").resolve()\\n    m = read_manifest(root)\\n    if m is None:\\n        return 2\\n    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n    before = latest_attempt_path(records_dir, stage)\\n\\n    beat = heartbeat_path(root, stage, nn)\\n    beat.parent.mkdir(parents=True, exist_ok=True)\\n    beat.touch()\\n    stop_beat = threading.Event()\\n\\n    def _tick() -> None:\\n        while not stop_beat.wait(heartbeat_s()):\\n            beat.touch()\\n\\n    beat_thread = threading.Thread(target=_tick, daemon=True)\\n    beat_thread.start()\\n    try:\\n        rc = cmd_build([item_id]) if stage == \\\"build\\\" else cmd_verify([item_id])\\n    finally:\\n        stop_beat.set()\\n        beat_thread.join()\\n\\n    after = latest_attempt_path(records_dir, stage)\\n    if after is None or after == before:\\n        # Refused before writing anything at all (e.g. no adapter\\n        # configured) -- the stage command already printed why.\\n        return rc if rc != 0 else 1\\n\\n    record = cast(dict[str, Any], latest_record(records_dir, stage))\\n    status_out = record.get(\\\"status\\\")\\n    to_commit = [after]\\n    if status_out != \\\"pass\\\":\\n        # R3: a retryable family (died, hung, transient, returned) asks\\n        # counsel nothing while its budget still has an attempt to\\n        # spend -- the next pass retries it plainly. Once its budget is\\n        # spent, or its last two signatures match, counsel is read once\\n        # more, its sentence carried beside the exhaustion report, never\\n        # instead of it. Every other class is counsel's to read on every\\n        # stop, as before this item.\\n        stop_class = (record.get(\\\"stop\\\") or {}).get(\\\"class\\\")\\n        budget_stage = \\\"build\\\" if stop_class == \\\"returned\\\" else stage\\n        ask_counsel = (stop_class not in RETRYABLE_CLASSES\\n                      or stage_exhausted(records_dir, m, stage, budget_stage))\\n        counsel_before = latest_attempt_path(records_dir, \\\"counsel\\\")\\n        if ask_counsel:\\n            cmd_counsel([item_id])\\n        counsel_after = latest_attempt_path(records_dir, \\\"counsel\\\")\\n        if counsel_after is not None and counsel_after != counsel_before:\\n            to_commit.append(counsel_after)\\n        # file-stops is its own idempotent read of the item's records, so\\n        # calling it here on every run that wrote a non-pass record is\\n        # safe to call again on a later run: an already-filed stop's own\\n        # marker is what stops it from being filed twice.\\n        cmd_file_stops([item_id])\\n\\n    message = f\\\"attavo: {stage} record for item {item_id} ({after.stem})\\\"\\n    try:\\n        commit_record(root, to_commit, message)\\n    except RuntimeError as exc:\\n        print(f\\\"attavo drive: stopped: could not commit the {stage} record: {exc}\\\")\\n        return 1\\n\\n    if has_origin(root):\\n        ok, err = push_record_commit(root, branch)\\n        if not ok:\\n            print(f\\\"attavo drive: stopped: could not push the {stage} record: {err}\\\")\\n            return 1\\n    else:\\n        print(f\\\"attavo drive: note: no origin remote; {after.name} is committed, not pushed\\\")\\n\\n    if status_out == \\\"halted\\\":\\n        question = (record.get(\\\"halted\\\") or {}).get(\\\"question\\\")\\n        print(f\\\"attavo drive: stopped: {stage} halted: {question} ({after.name}); \\\"\\n              f\\\"pushed to {branch}\\\")\\n    elif status_out != \\\"pass\\\":\\n        reason = record.get(\\\"refusal\\\") or status_out\\n        print(f\\\"attavo drive: stopped: {stage} {status_out}: {reason} ({after.name}); \\\"\\n              f\\\"pushed to {branch}\\\")\\n    else:\\n        print(f\\\"attavo drive: pushed {after.name} to {branch}\\\")\\n    return rc\\n\\n\\ndef cmd_worker(argv: list[str]) -> int:\\n    \\\"\\\"\\\"`attavo worker N <build|verify> NN`: the detached child a pass\\n    starts once its marker is pushed -- the lease held, the attempt is\\n    this worker's to run. Its own session (start_new_session, set by the\\n    pass that spawns it); its stdout and stderr are the pass's own\\n    redirect, to <git-dir>/attavo/<stage>-NN.worker.log.\\\"\\\"\\\"\\n    cast(io.TextIOWrapper, sys.stdout).reconfigure(line_buffering=True)\\n    if len(argv) != 3:\\n        print(\\\"attavo worker: usage: attavo worker N <build|verify> NN\\\", file=sys.stderr)\\n        return 2\\n    item_id, stage, nn_text = argv\\n    if stage not in (\\\"build\\\", \\\"verify\\\"):\\n        print(f\\\"attavo worker: {stage!r} is not build or verify\\\", file=sys.stderr)\\n        return 2\\n    try:\\n        nn = int(nn_text)\\n    except ValueError:\\n        print(f\\\"attavo worker: {nn_text!r} is not an attempt number\\\", file=sys.stderr)\\n        return 2\\n    return _stage_body(item_id, stage, nn)\\n\\n\\n# --- the pass's own two acts: start a stage (the lease), and recover\\n# exactly the one invocation the report names owed one. ---\\n\\ndef _start_stage(root: Path, m: dict[str, Any], item_id: str, stage: str,\\n                 forge_checks: dict[str, Any] | None, *, again_by: bool = False) -> int:\\n    \\\"\\\"\\\"The lease (ruling A): the marker, committed and pushed as a plain\\n    fast-forward with no merge and no retry (push_lease). Lost to another\\n    pass, or refused outright by the remote, both undo the marker commit\\n    here (git reset --hard) so this checkout carries no half-taken\\n    attempt either way; only a pushed lease starts the worker. On a\\n    review, forge_checks is the checks this same pass already read on\\n    the pre-marker head (ruling B) -- written to\\n    <git-dir>/attavo/verify-NN.forge-checks.json and named in\\n    ATTAVO_FORGE_CHECKS, so the worker's own `attavo verify` reads it\\n    instead of polling. R3: again_by names the marker as `--again`'s own\\n    act on a stage whose budget was already spent.\\\"\\\"\\\"\\n    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n    nn = next_attempt_number(records_dir, stage)\\n    marker = write_invocation_marker(root, records_dir, stage, nn, again_by=again_by)\\n    try:\\n        commit_record(root, [marker], f\\\"attavo: {stage} invocation {nn:02d} started for item {item_id}\\\")\\n    except RuntimeError as exc:\\n        print(f\\\"attavo drive: stopped: could not commit the {stage} invocation marker: {exc}\\\")\\n        return 1\\n\\n    if has_origin(root):\\n        outcome, err = push_lease(root, branch)\\n        if outcome != \\\"pushed\\\":\\n            git(root, \\\"reset\\\", \\\"--hard\\\", \\\"HEAD^\\\")\\n            if outcome == \\\"lost-race\\\":\\n                print(f\\\"attavo drive: another pass holds this attempt ({marker.name}); nothing started\\\")\\n                return 0\\n            print(f\\\"attavo drive: stopped: could not push the {stage} invocation marker: {err}\\\")\\n            return 1\\n\\n    env = dict(os.environ)\\n    if forge_checks is not None:\\n        checks_file = forge_checks_path(root, stage, nn)\\n        checks_file.write_text(json.dumps(forge_checks))\\n        env[\\\"ATTAVO_FORGE_CHECKS\\\"] = str(checks_file)\\n    log = worker_log_path(root, stage, nn)\\n    with log.open(\\\"ab\\\") as fh, open(os.devnull, \\\"rb\\\") as devnull:\\n        proc = subprocess.Popen(\\n            [sys.executable, str(PRODUCT_ROOT / \\\"bin\\\" / \\\"attavo\\\"), \\\"worker\\\", item_id, stage, f\\\"{nn:02d}\\\"],\\n            cwd=str(root), env=env, stdin=devnull, stdout=fh, stderr=subprocess.STDOUT,\\n            start_new_session=True)\\n    word = \\\"Build\\\" if stage == \\\"build\\\" else \\\"Review\\\"\\n    print(f\\\"attavo drive: {word} started (attempt {nn:02d}, worker pid {proc.pid})\\\")\\n    return 0\\n\\n\\ndef _recover_one(root: Path, m: dict[str, Any], item_id: str, records_dir: Path) -> int:\\n    \\\"\\\"\\\"The pass's own recovery act (what `--recover` did): exactly the one\\n    invocation the report just read as owing one -- died or hung -- ends\\n    here. class died when the heartbeat is stale (or absent and the pid\\n    is gone), class hung when there is no heartbeat, the pid lives, and a\\n    declared [drive].stall_after_s has passed with no newer event, and\\n    terminated. Provenance product; the events tail as the log. Committed\\n    and pushed the way any stage record is (push_record_commit, with its\\n    own merge retry) -- this is not a race for a lease, since no new\\n    attempt marker is written.\\\"\\\"\\\"\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n    bound = stall_bound_s(m)\\n    pending = invocations_without_record(records_dir)\\n    readings = [(marker, info, read_invocation(root, bound, marker, info)) for marker, info in pending]\\n    candidate = next(((mk, i, rd) for mk, i, rd in readings if rd.cls != \\\"running\\\"), None)\\n    if candidate is None:\\n        # The report read this a moment ago; nothing owed recovery by the\\n        # time this pass got here (another pass recovered it, or it\\n        # finished on its own).\\n        return 0\\n    marker, info, reading = candidate\\n    stage, nn, log, last_at, age, cls, crossed = reading\\n    pid, host = info.get(\\\"pid\\\"), info.get(\\\"host\\\")\\n\\n    if next_attempt_number(records_dir, stage) != nn:\\n        print(f\\\"attavo drive: stopped: {marker.name} names attempt {nn} but the next \\\"\\n              f\\\"{stage} record would be {next_attempt_number(records_dir, stage):02d}; \\\"\\n              f\\\"a later record already exists, read the records before recovering\\\")\\n        return 1\\n\\n    if cls == \\\"hung\\\":\\n        try:\\n            os.kill(cast(int, pid), signal.SIGTERM)\\n            ended = \\\"terminated\\\"\\n        except OSError as exc:\\n            ended = f\\\"not terminated ({exc})\\\"\\n        if crossed == \\\"ceiling\\\":\\n            detail = (f\\\"pid {pid} on {host} alive {int(cast(float, age))} s after its marker, past \\\"\\n                      f\\\"the {stage} ceiling of {ceiling_s(m, stage)} s; {ended}\\\")\\n        else:\\n            detail = (f\\\"pid {pid} on {host} alive with no event for {int(cast(float, age))} s \\\"\\n                      f\\\"(bound {bound} s); {ended}\\\")\\n    else:\\n        detail = (f\\\"pid {pid} on {host} is not running and wrote no {marker.stem}.json; \\\"\\n                  f\\\"started {info.get('at')}, last event {last_at or 'none'}\\\")\\n\\n    schema = stage_schema(stage)\\n    record: dict[str, Any] = {k: None for k in schema.get(\\\"required\\\", [])}\\n    approval = latest_record(records_dir, \\\"approval\\\")\\n    signature_source = log.strip().splitlines()[-1] if log.strip() else detail\\n    record.update({\\\"sha\\\": info.get(\\\"sha\\\"), \\\"start_sha\\\": info.get(\\\"sha\\\"),\\n                   \\\"approval_sha\\\": approval.get(\\\"sha\\\") if approval else None,\\n                   \\\"at\\\": info.get(\\\"at\\\"),\\n                   \\\"adapter\\\": (m.get(\\\"executor\\\") or {}).get(stage),\\n                   \\\"status\\\": \\\"failed\\\", \\\"refusal\\\": None, \\\"halted\\\": None,\\n                   \\\"retry_of\\\": None, \\\"steer\\\": None,\\n                   \\\"stop\\\": {\\\"class\\\": cls, \\\"provenance\\\": \\\"product\\\", \\\"detail\\\": detail,\\n                            \\\"signature\\\": signature_of(signature_source), \\\"bound\\\": crossed}})\\n    if \\\"wall_clock_s\\\" in record:\\n        record[\\\"wall_clock_s\\\"] = None if age is None else int(age)\\n    record = {k: v for k, v in record.items() if k in schema.get(\\\"properties\\\", {})}\\n    try:\\n        path = write_record(records_dir, stage, record, m, item_id, log=log)\\n    except ValueError as exc:\\n        print(f\\\"attavo drive: stopped: could not write the {cls} record for {marker.stem}: {exc}\\\")\\n        return 1\\n    try:\\n        commit_record(root, [path], f\\\"attavo: {stage} record for item {item_id} \\\"\\n                                    f\\\"({path.stem}), recovered as {cls}\\\")\\n    except RuntimeError as exc:\\n        print(f\\\"attavo drive: stopped: could not commit the {cls} record: {exc}\\\")\\n        return 1\\n    if has_origin(root):\\n        ok, err = push_record_commit(root, branch)\\n        if not ok:\\n            print(f\\\"attavo drive: stopped: could not push the {cls} record: {err}\\\")\\n            return 1\\n    else:\\n        print(f\\\"attavo drive: note: no origin remote; {path.name} is committed, not pushed\\\")\\n    print(f\\\"attavo drive: recovered {marker.stem} as {cls}: {detail}\\\")\\n    return 0\\n\\n\\ndef _advance_again(root: Path, m: dict[str, Any], item_id: str, stage: str, head: str | None, *,\\n                   again_by: bool = False) -> int:\\n    \\\"\\\"\\\"The next attempt of a stopped stage: exactly what next-build or\\n    next-review would do, bypassing the level a plain pass leaves alone\\n    for the operator -- the pass's own automatic retry of a retryable\\n    family, or `--again`'s act once a budget is spent (again_by). A\\n    review reads the forge fresh here -- once, since the report's own\\n    stopped reading never touched it -- rather than reusing a read that\\n    was never taken.\\\"\\\"\\\"\\n    if stage == \\\"build\\\":\\n        return _start_stage(root, m, item_id, \\\"build\\\", None, again_by=again_by)\\n    checks_command = (m.get(\\\"forge\\\") or {}).get(\\\"checks_command\\\")\\n    if not checks_command:\\n        print(\\\"attavo drive: refused: no [forge].checks_command in the manifest\\\")\\n        return 1\\n    forge_checks, ok = read_forge_checks(root, checks_command, cast(str, head))\\n    if not ok:\\n        conclusions = forge_checks[\\\"conclusions\\\"]\\n        named = \\\", \\\".join(f\\\"{c['name']} {c['conclusion']}\\\" for c in conclusions) or \\\"no checks reported\\\"\\n        print(f\\\"attavo drive: forge checks not green on {cast(str, head)[:12]}: {named}\\\")\\n        return 0\\n    return _start_stage(root, m, item_id, \\\"verify\\\", forge_checks, again_by=again_by)\\n\\n\\ndef _retry_target(r: \\\"DriveReport\\\") -> str:\\n    \\\"\\\"\\\"The stage the next attempt actually starts: class \\\"returned\\\" (a\\n    build's head a check rejected, or a review's own blocking finding) is\\n    always the verify record's own stop, but the retry it starts is the\\n    next build.\\\"\\\"\\\"\\n    return \\\"build\\\" if r[\\\"stop_class\\\"] == \\\"returned\\\" else cast(str, r[\\\"stage\\\"])\\n\\n\\ndef _retry_due(root: Path, m: dict[str, Any], item_id: str, r: \\\"DriveReport\\\") -> bool:\\n    \\\"\\\"\\\"R3: a stopped stage whose class is one of the four retryable\\n    families, whose budget is not spent, whose last two signatures\\n    differ, and -- for transient -- whose record has aged past\\n    [drive].retry_after_s, is retried by the next plain pass, no\\n    counsel, no operator act.\\\"\\\"\\\"\\n    if r[\\\"stop_class\\\"] not in RETRYABLE_CLASSES:\\n        return False\\n    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n    sig_stage = cast(str, r[\\\"stage\\\"])\\n    budget_stage = _retry_target(r)\\n    if stage_exhausted(records_dir, m, sig_stage, budget_stage):\\n        return False\\n    if r[\\\"stop_class\\\"] == \\\"transient\\\":\\n        attempts = parse_attempts(records_dir, sig_stage)\\n        latest = attempts[max(attempts)] if attempts else {}\\n        age = _seconds_since(latest.get(\\\"at\\\"))\\n        if age is None or age < retry_after_s(m):\\n            return False\\n    return True\\n\\n\\ndef _handle_again(root: Path, m: dict[str, Any], item_id: str, r: \\\"DriveReport\\\") -> int:\\n    \\\"\\\"\\\"`--again`'s own act on a stopped stage (R3): a retryable family\\n    whose budget is not spent is left to the pass's own automatic retry\\n    -- a no-op here, saying so -- since starting it twice would spend two\\n    attempts on one press. A retryable family whose budget is spent, or\\n    any other stopped class, starts the next attempt at once, its marker\\n    naming --again as what started it.\\\"\\\"\\\"\\n    stage = _retry_target(r)\\n    if r[\\\"stop_class\\\"] in RETRYABLE_CLASSES:\\n        records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n        if not stage_exhausted(records_dir, m, cast(str, r[\\\"stage\\\"]), stage):\\n            print(\\\"attavo drive: --again is a no-op inside the budget; the pass retries on its own\\\")\\n            return 0\\n    return _advance_again(root, m, item_id, stage, r[\\\"head\\\"], again_by=True)\\n\\n\\ndef _counsel_answered(records_dir: Path, r: \\\"DriveReport\\\") -> bool:\\n    \\\"\\\"\\\"R3: whether the stop this report just read as \\\"stopped\\\" already\\n    carries counsel's own \\\"answer\\\" verdict -- every non-retryable class\\n    is counsel's to read (as before this item), and `answer` starts the\\n    next attempt with the answer as its steer, read from the feedback\\n    file the retried attempt's own first iteration is handed\\n    (attavo.build._retry_seed).\\\"\\\"\\\"\\n    if r[\\\"stop_class\\\"] in RETRYABLE_CLASSES or not r[\\\"stage\\\"] or r[\\\"attempt\\\"] is None:\\n        return False\\n    counsel = counsel_record_for(records_dir, cast(str, r[\\\"stage\\\"]), cast(int, r[\\\"attempt\\\"]))\\n    return counsel is not None and counsel.get(\\\"verdict\\\") == \\\"answer\\\"\\n\\n\\ndef _pass_once(root: Path, m: dict[str, Any], item_id: str, again: bool) -> tuple[int, \\\"DriveReport\\\"]:\\n    \\\"\\\"\\\"One pass: fast-forward to origin (never while a worker holds the\\n    copy), read the report, act at most once, return. The three acts,\\n    one per report state that is the product's move: owes-recovery\\n    recovers; next-build and next-review start their stage, handing a\\n    review the checks the report already read once on the pre-marker\\n    head; a concluded red check on a passed build's head (R3) is a\\n    returned review record, not a level, so the review starts the same\\n    way. On a stopped stage, `--again` always wins (a no-op inside the\\n    budget, the next attempt once it is spent); absent it, a retryable\\n    family retries on its own, and any other stop counsel has already\\n    answered starts the next attempt steered by that answer. Every other\\n    level is printed in the report's own words and left.\\\"\\\"\\\"\\n    from attavo.report import drive_report\\n    fast_forward_to_origin(root, m, item_id)\\n    r = drive_report(root, m, item_id)\\n\\n    if r[\\\"state\\\"] == \\\"owes-recovery\\\":\\n        records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n        return _recover_one(root, m, item_id, records_dir), r\\n    if r[\\\"state\\\"] == \\\"next-build\\\":\\n        return _start_stage(root, m, item_id, \\\"build\\\", None), r\\n    if r[\\\"state\\\"] == \\\"next-review\\\":\\n        checks_command = (m.get(\\\"forge\\\") or {}).get(\\\"checks_command\\\")\\n        forge_checks = {\\\"command\\\": checks_command, \\\"sha\\\": r[\\\"head\\\"], \\\"conclusions\\\": r[\\\"checks\\\"] or []}\\n        return _start_stage(root, m, item_id, \\\"verify\\\", forge_checks), r\\n    if r[\\\"state\\\"] == \\\"blocked-on-checks\\\" and r[\\\"stage\\\"] == \\\"verify\\\":\\n        # R3: the rejection is a record, not a level with nothing behind\\n        # it (#206's build-01) -- the review starts, reading the same\\n        # forge checks this pass just read, and writes the check\\n        # rejection itself as a returned record (attavo.verify.cmd_verify).\\n        checks_command = (m.get(\\\"forge\\\") or {}).get(\\\"checks_command\\\")\\n        forge_checks = {\\\"command\\\": checks_command, \\\"sha\\\": r[\\\"head\\\"], \\\"conclusions\\\": r[\\\"checks\\\"] or []}\\n        return _start_stage(root, m, item_id, \\\"verify\\\", forge_checks), r\\n    if r[\\\"state\\\"] == \\\"stopped\\\" and r[\\\"stage\\\"]:\\n        if again:\\n            return _handle_again(root, m, item_id, r), r\\n        records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n        if _retry_due(root, m, item_id, r):\\n            return _advance_again(root, m, item_id, _retry_target(r), r[\\\"head\\\"]), r\\n        if _counsel_answered(records_dir, r):\\n            return _advance_again(root, m, item_id, _retry_target(r), r[\\\"head\\\"]), r\\n\\n    print(f\\\"attavo drive: {r['says']}\\\")\\n    return (1 if r[\\\"state\\\"] == \\\"refused\\\" else 0), r\\n\\n\\n_TERMINAL_STATES = (\\\"waiting-on-approval\\\", \\\"stopped\\\", \\\"ready-to-merge\\\", \\\"merged\\\")\\n\\n\\ndef _until_ready(root: Path, m: dict[str, Any], item_id: str, again: bool) -> int:\\n    \\\"\\\"\\\"--until-ready: the pass, repeated in one process, sleeping\\n    ATTAVO_DRIVE_POLL_INTERVAL_S between passes, until the level is the\\n    operator's or done (exit 0), a concluded check is red (exit 1), or\\n    an unconcluded one has not concluded within ATTAVO_DRIVE_POLL_BOUND_S\\n    (exit 1). A stage running in its own worker is not bounded by this --\\n    only time spent waiting on the forge is.\\\"\\\"\\\"\\n    from attavo.verify import drive_forge_poll_bound_s, drive_forge_poll_interval_s\\n    bound = drive_forge_poll_bound_s()\\n    interval = drive_forge_poll_interval_s()\\n    waiting_since: float | None = None\\n    while True:\\n        rc, r = _pass_once(root, m, item_id, again)\\n        state = r[\\\"state\\\"]\\n\\n        if state == \\\"waiting-on-checks\\\":\\n            if waiting_since is None:\\n                waiting_since = time.monotonic()\\n            elif time.monotonic() - waiting_since >= bound:\\n                print(f\\\"attavo drive: stopped: the checks did not conclude within {bound:.0f}s\\\")\\n                return 1\\n        else:\\n            waiting_since = None\\n\\n        if rc != 0:\\n            return rc\\n        if state in _TERMINAL_STATES:\\n            return 0\\n        if state == \\\"blocked-on-checks\\\" and r[\\\"stage\\\"] != \\\"verify\\\":\\n            # R3: stage \\\"verify\\\" here is the pass's own act, just taken --\\n            # a concluded red check on a passed build's head is now a\\n            # returned review record (attavo.verify.cmd_verify), not a\\n            # level the loop gives up on with nothing behind it.\\n            return 1\\n        time.sleep(interval)\\n\\n\\ndef _drive_all() -> int:\\n    \\\"\\\"\\\"--all: one pass, in its own process, in every ../attavo-worktree-N\\n    beside this checkout -- each one derives its own item from its own\\n    attavo/N-* branch. Every line either prints is prefixed with the\\n    worktree's own directory name, so an operator reading them together\\n    can tell which item each line is about.\\\"\\\"\\\"\\n    root = Path(\\\".\\\").resolve()\\n    siblings = sorted(p for p in root.parent.glob(\\\"attavo-worktree-*\\\") if p.is_dir())\\n    if not siblings:\\n        print(\\\"attavo drive: --all found no ../attavo-worktree-N beside this checkout\\\")\\n        return 0\\n    worst = 0\\n    for copy in siblings:\\n        run = subprocess.run([sys.executable, str(PRODUCT_ROOT / \\\"bin\\\" / \\\"attavo\\\"), \\\"drive\\\"],\\n                             cwd=str(copy), capture_output=True, text=True, check=False)\\n        for line in (run.stdout + run.stderr).splitlines():\\n            print(f\\\"{copy.name}: {line}\\\")\\n        worst = max(worst, run.returncode)\\n    return worst\\n\\n\\ndef cmd_drive(argv: list[str]) -> int:\\n    # Issue #145: Python block-buffers stdout when it is not a tty (a\\n    # pipe, e.g. a screen reading this process live), so every line this\\n    # prints would otherwise sit unflushed until the process exits.\\n    # Line-buffering makes a pipe reader see each line the moment it is\\n    # printed, the same as a terminal already does; `attavo worker`\\n    # reconfigures its own stdout the same way.\\n    cast(io.TextIOWrapper, sys.stdout).reconfigure(line_buffering=True)\\n\\n    if \\\"--recover\\\" in argv:\\n        print(\\\"attavo drive: --recover is gone; a pass recovers a dead or hung invocation \\\"\\n              \\\"itself, as soon as the report owes one\\\", file=sys.stderr)\\n        return 2\\n\\n    until_ready = \\\"--until-ready\\\" in argv\\n    report = \\\"--report\\\" in argv\\n    again = \\\"--again\\\" in argv\\n    all_flag = \\\"--all\\\" in argv\\n    positional = [a for a in argv if not a.startswith(\\\"--\\\")]\\n\\n    if all_flag:\\n        if until_ready or report or again or positional:\\n            print(\\\"attavo drive: --all runs one pass in every worktree beside this checkout; \\\"\\n                  \\\"drop N and every other flag\\\", file=sys.stderr)\\n            return 2\\n        return _drive_all()\\n\\n    root = Path(\\\".\\\").resolve()\\n    item_id = positional[0] if positional else derive_item_id(root)\\n    if not item_id:\\n        print(\\\"attavo drive: cannot derive item id; pass N or run on an attavo/N-* branch\\\",\\n              file=sys.stderr)\\n        return 2\\n    m = read_manifest(root)\\n    if m is None:\\n        print(f\\\"attavo drive: no {MANIFEST} at {root}\\\", file=sys.stderr)\\n        return 2\\n\\n    if report:\\n        if until_ready or again:\\n            print(\\\"attavo drive: --report reads and does nothing else; drop --until-ready \\\"\\n                  \\\"and --again\\\", file=sys.stderr)\\n            return 2\\n        fast_forward_to_origin(root, m, item_id)\\n        from attavo.report import drive_report\\n        print(json.dumps(drive_report(root, m, item_id), indent=2))\\n        return 0\\n\\n    if until_ready:\\n        return _until_ready(root, m, item_id, again)\\n    rc, _ = _pass_once(root, m, item_id, again)\\n    return rc\\n\",\"structuredPatch\":[{\"oldStart\":17,\"oldLines\":7,\"newStart\":17,\"newLines\":6,\"lines\":[\" from attavo.counsel import cmd_counsel\",\" from attavo.doctor import (\",\"     _parse_json_line,\",\"-    attempts_budget,\",\"     ceiling_s,\",\"     invocation_alive,\",\"     invocations_without_record,\"]}],\"userModified\":false,\"replaceAll\":false,\"contentNotInModelContext\":true}}\n2639:+{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_012V6xA6TeptryFvhjLDfngx\",\"type\":\"tool_result\",\"content\":\"The file /Users/davidbean/Projects/attavo-worktree-219/attavo/drive.py has been updated successfully.\"}]},\"parent_tool_use_id\":null,\"session_id\":\"0dd7ed4f-100c-4188-9a34-077aa0b6aa25\",\"uuid\":\"23ae712d-5628-48a7-a05d-07e131ed89d7\",\"timestamp\":\"2026-09-26T02:34:49.338Z\",\"tool_use_result\":{\"filePath\":\"/Users/davidbean/Projects/attavo-worktree-219/attavo/drive.py\",\"oldString\":\"    if r[\\\"stop_class\\\"] in RETRYABLE_CLASSES or not r[\\\"stage\\\"] or r[\\\"attempt\\\"] is None:\\n        return False\\n    counsel = counsel_record_for(records_dir, cast(str, r[\\\"stage\\\"]), cast(int, r[\\\"attempt\\\"]))\\n    return counsel is not None and counsel.get(\\\"verdict\\\") == \\\"answer\\\"\",\"newString\":\"    if r[\\\"stop_class\\\"] in RETRYABLE_CLASSES or not r[\\\"stage\\\"] or r[\\\"attempt\\\"] is None:\\n        return False\\n    counsel = counsel_record_for(records_dir, r[\\\"stage\\\"], r[\\\"attempt\\\"])\\n    return counsel is not None and counsel.get(\\\"verdict\\\") == \\\"answer\\\"\",\"originalFile\":\"from __future__ import annotations\\n\\nimport io\\nimport json\\nimport os\\nimport signal\\nimport subprocess\\nimport sys\\nimport threading\\nimport time\\nfrom pathlib import Path\\nfrom typing import TYPE_CHECKING, Any, NamedTuple, cast\\n\\nfrom attavo.approval import approval_status\\nfrom attavo.build import cmd_build, driver_identity\\nfrom attavo.common import MANIFEST, PRODUCT_ROOT, derive_item_id, git, read_manifest\\nfrom attavo.counsel import cmd_counsel\\nfrom attavo.doctor import (\\n    _parse_json_line,\\n    ceiling_s,\\n    invocation_alive,\\n    invocations_without_record,\\n    retry_after_s,\\n    stall_bound_s,\\n    write_invocation_marker,\\n)\\nfrom attavo.events import stage_events_dir\\nfrom attavo.filing import cmd_file_stops\\nfrom attavo.records import (\\n    latest_attempt_path,\\n    latest_record,\\n    next_attempt_number,\\n    parse_attempts,\\n    stage_schema,\\n    write_record,\\n)\\nfrom attavo.stops import RETRYABLE_CLASSES, counsel_record_for, signature_of, stage_exhausted\\nfrom attavo.verify import cmd_verify, read_forge_checks\\n\\nif TYPE_CHECKING:\\n    from attavo.types import DriveReport\\n\\n# --- drive: the mechanical transitions between approval and ready-to-merge\\n# (issue #84), under the reconciler's R2 (rulings A, B, C's recovery half,\\n# F, G, H): `attavo drive N` is one short pass. It reads the report\\n# (attavo.report), acts at most once -- recovers a dead or hung\\n# invocation, or starts the next stage in a detached worker -- and\\n# returns within seconds; the stage itself runs in `attavo worker`, a\\n# child of the pass's own session, which outlives it. Writes no record of\\n# its own: the stage records already on disk, and the invocation markers\\n# and heartbeats beside them, are the only state a pass or a worker\\n# reads. ---\\n\\n\\ndef commit_record(root: Path, record_paths: Path | list[Path], message: str) -> None:\\n    \\\"\\\"\\\"`git commit --only` on every record path given, and each one's .log\\n    and .filed, each if one exists -- never the whole index. A transport\\n    commit that sweeps the index is exactly the regression issue #46\\n    already guards build and verify against on the adapter side; drive\\n    must not reintroduce it on the transport side. The .filed marker\\n    (issue #89) is committed alongside the record it names, in the same\\n    commit and the same push, so a second worktree or a fresh clone reads\\n    the same filed fact rather than refiling every stop it finds with no\\n    marker of its own. A single Path is accepted for the common one-record\\n    case; issue #100 passes a list so the counsel record lands in the same\\n    commit as the stage record it counsels. Authored and committed as\\n    driver_identity(), set by the product and never the tenant's git\\n    config, so a driven item's record commits are never indistinguishable\\n    from an operator's own.\\\"\\\"\\\"\\n    if isinstance(record_paths, Path):\\n        record_paths = [record_paths]\\n    paths: list[str] = []\\n    for record_path in record_paths:\\n        paths.append(str(record_path.relative_to(root)))\\n        log_path = record_path.with_suffix(\\\".log\\\")\\n        if log_path.is_file():\\n            paths.append(str(log_path.relative_to(root)))\\n        marker_path = record_path.with_suffix(\\\".filed\\\")\\n        if marker_path.is_file():\\n            paths.append(str(marker_path.relative_to(root)))\\n    identity = driver_identity()\\n    env = dict(os.environ)\\n    env[\\\"GIT_AUTHOR_NAME\\\"] = identity[\\\"name\\\"]\\n    env[\\\"GIT_AUTHOR_EMAIL\\\"] = identity[\\\"email\\\"]\\n    env[\\\"GIT_COMMITTER_NAME\\\"] = identity[\\\"name\\\"]\\n    env[\\\"GIT_COMMITTER_EMAIL\\\"] = identity[\\\"email\\\"]\\n    git(root, \\\"add\\\", *paths)\\n    git(root, \\\"commit\\\", \\\"--only\\\", \\\"-m\\\", message, *paths, env=env)\\n\\n\\ndef push_record_commit(root: Path, branch: str) -> tuple[bool, str | None]:\\n    \\\"\\\"\\\"Push HEAD to branch on origin. A push a divergent remote rejects is\\n    retried once after `git pull --no-rebase --no-edit origin branch` -- a\\n    merge, never a rebase, because a rebase would change the sha the record\\n    commit just wrote already names. This is the record push's own retry\\n    -- the worker's, once it has the lease -- distinct from push_lease\\n    below, which never retries.\\\"\\\"\\\"\\n    def attempt() -> tuple[bool, str]:\\n        run = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"push\\\", \\\"origin\\\", f\\\"HEAD:{branch}\\\"],\\n                             capture_output=True, text=True, check=False)\\n        return run.returncode == 0, run.stderr.strip()\\n\\n    ok, err = attempt()\\n    if ok:\\n        return True, None\\n    pull = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"pull\\\", \\\"--no-rebase\\\", \\\"--no-edit\\\",\\n                           \\\"origin\\\", branch], capture_output=True, text=True, check=False)\\n    if pull.returncode != 0:\\n        return False, f\\\"push rejected and the retry merge failed: {pull.stderr.strip() or err}\\\"\\n    ok, err = attempt()\\n    if not ok:\\n        return False, f\\\"push rejected again after merging {branch}: {err}\\\"\\n    return True, None\\n\\n\\n_RACE_MARKERS = (\\\"non-fast-forward\\\", \\\"fetch first\\\", \\\"stale info\\\", \\\"cannot lock ref\\\",\\n                 \\\"failed to update ref\\\")\\n\\n\\ndef push_lease(root: Path, branch: str) -> tuple[str, str | None]:\\n    \\\"\\\"\\\"Push HEAD to branch on origin as a plain fast-forward -- no merge,\\n    no retry: this is the lease the marker commit takes on the attempt it\\n    names (ruling A). (\\\"pushed\\\", None) on success.\\n\\n    (\\\"lost-race\\\", stderr) when git's own ref check is what rejected it --\\n    the branch moved since this pass fast-forwarded to it (a sequential\\n    \\\"[rejected] ... (fetch first)\\\"), or the remote's own ref transaction\\n    lost a genuine simultaneous push (\\\"[remote rejected] ... (failed to\\n    update ref)\\\", \\\"cannot lock ref\\\"): either way, another pass's own\\n    marker (or record) landed there first. The pass that reads this is\\n    the loser: it says so, resets its own marker commit, and starts\\n    nothing.\\n\\n    (\\\"refused\\\", stderr) for every other rejection -- a remote that\\n    refuses the push outright (a hook, a permission, an unreachable\\n    remote). This is not a race for the lease; it is a refusal, and ends\\n    the pass with exit 1.\\\"\\\"\\\"\\n    run = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"push\\\", \\\"origin\\\", f\\\"HEAD:{branch}\\\"],\\n                         capture_output=True, text=True, check=False)\\n    if run.returncode == 0:\\n        return \\\"pushed\\\", None\\n    stderr = run.stderr\\n    if any(marker in stderr for marker in _RACE_MARKERS):\\n        return \\\"lost-race\\\", stderr.strip()\\n    return \\\"refused\\\", stderr.strip()\\n\\n\\ndef has_origin(root: Path) -> bool:\\n    \\\"\\\"\\\"Whether this checkout carries an origin remote at all -- a fixture\\n    or a scratch checkout with none is not a refusal; a pass commits\\n    locally and skips the push, the way recovery always has.\\\"\\\"\\\"\\n    try:\\n        git(root, \\\"remote\\\", \\\"get-url\\\", \\\"origin\\\")\\n        return True\\n    except RuntimeError:\\n        return False\\n\\n\\ndef drive_state(root: Path, m: dict[str, Any], item_id: str) -> tuple[str, str | None, Path]:\\n    \\\"\\\"\\\"(\\\"no-approval\\\" | \\\"build\\\" | \\\"verify\\\" | \\\"ready\\\", detail, records_dir):\\n    the next mechanical step for item_id, read from its latest records\\n    alone. A build only counts as current when it is a pass bound to the\\n    valid approval's own sha; a verify only counts as current when it is a\\n    pass bound to that build's own sha -- the same staleness a re-approval\\n    or a re-build must force, attest's own chain check already enforces\\n    (check_attest_chain), read here rather than re-typed.\\\"\\\"\\\"\\n    records_rel = m[\\\"paths\\\"][\\\"records\\\"]\\n    records_dir = root / records_rel / item_id\\n\\n    status = approval_status(root, m, item_id)\\n    if status != \\\"valid\\\":\\n        return \\\"no-approval\\\", status, records_dir\\n\\n    latest_approval = latest_record(records_dir, \\\"approval\\\")\\n    latest_build = latest_record(records_dir, \\\"build\\\")\\n    build_current = (latest_build is not None and latest_build.get(\\\"status\\\") == \\\"pass\\\"\\n                     and latest_build.get(\\\"approval_sha\\\")\\n                     == (latest_approval.get(\\\"sha\\\") if latest_approval else None))\\n    if latest_build is None or not build_current:\\n        return \\\"build\\\", None, records_dir\\n\\n    latest_verify = latest_record(records_dir, \\\"verify\\\")\\n    verify_current = (latest_verify is not None and latest_verify.get(\\\"status\\\") == \\\"pass\\\"\\n                      and latest_verify.get(\\\"build_sha\\\") == latest_build.get(\\\"sha\\\"))\\n    if not verify_current:\\n        return \\\"verify\\\", None, records_dir\\n\\n    return \\\"ready\\\", None, records_dir\\n\\n\\n# --- the heartbeat, the worker log, and the forge-checks handoff: local\\n# facts under the checkout's own git directory (issue #140's precedent),\\n# never committed and never among the paths commit_record ever names. ---\\n\\ndef heartbeat_s() -> float:\\n    return float(os.environ.get(\\\"ATTAVO_HEARTBEAT_S\\\", 15))\\n\\n\\ndef heartbeat_path(root: Path, stage: str, nn: int) -> Path:\\n    return stage_events_dir(root) / f\\\"{stage}-{nn:02d}.heartbeat\\\"\\n\\n\\ndef worker_log_path(root: Path, stage: str, nn: int) -> Path:\\n    return stage_events_dir(root) / f\\\"{stage}-{nn:02d}.worker.log\\\"\\n\\n\\ndef forge_checks_path(root: Path, stage: str, nn: int) -> Path:\\n    return stage_events_dir(root) / f\\\"{stage}-{nn:02d}.forge-checks.json\\\"\\n\\n\\ndef _events_path_for(root: Path, stage: str, nn: int) -> Path | None:\\n    \\\"\\\"\\\"The adapter's own events file for this invocation, under the\\n    checkout's git dir (a worktree's own dir when the checkout is one).\\\"\\\"\\\"\\n    try:\\n        gitdir = Path(git(root, \\\"rev-parse\\\", \\\"--git-dir\\\").strip())\\n    except RuntimeError:\\n        return None\\n    if not gitdir.is_absolute():\\n        gitdir = root / gitdir\\n    path = gitdir / \\\"attavo\\\" / f\\\"{stage}-{nn:02d}.events.jsonl\\\"\\n    return path if path.is_file() else None\\n\\n\\ndef _events_tail(path: Path | None, lines: int = 20) -> tuple[str, str | None]:\\n    \\\"\\\"\\\"(the last lines as a log, the last event's own at).\\\"\\\"\\\"\\n    if path is None:\\n        return \\\"no events file for this invocation\\\\n\\\", None\\n    try:\\n        text = path.read_text()\\n    except OSError:\\n        return \\\"events file unreadable\\\\n\\\", None\\n    tail = text.splitlines()[-lines:]\\n    last_at = None\\n    for line in reversed(tail):\\n        parsed = _parse_json_line(line)\\n        if not isinstance(parsed, dict):\\n            continue\\n        at = parsed.get(\\\"at\\\")\\n        if isinstance(at, str):\\n            last_at = at\\n            break\\n    return \\\"\\\\n\\\".join(tail) + \\\"\\\\n\\\", last_at\\n\\n\\ndef _seconds_since(at: str | None) -> float | None:\\n    from datetime import datetime, timezone\\n    if not at:\\n        return None\\n    try:\\n        then = datetime.strptime(at, \\\"%Y-%m-%dT%H:%M:%SZ\\\").replace(tzinfo=timezone.utc)\\n    except ValueError:\\n        return None\\n    return (datetime.now(timezone.utc) - then).total_seconds()\\n\\n\\nclass InvocationReading(NamedTuple):\\n    \\\"\\\"\\\"What one marker with no record reads as, from here and now.\\\"\\\"\\\"\\n    stage: str\\n    nn: int\\n    log: str\\n    last_at: str | None\\n    age: float | None\\n    cls: str  # \\\"running\\\" | \\\"hung\\\" | \\\"died\\\"\\n    bound: str | None = None  # R3: \\\"stall\\\" or \\\"ceiling\\\" when cls is \\\"hung\\\"\\n\\n\\ndef read_invocation(root: Path, bound: int | None, marker: Path, info: dict[str, Any]) -> InvocationReading:\\n    \\\"\\\"\\\"Whether an invocation that began and wrote no record is running,\\n    hung, or died -- read from its own heartbeat first (R2): a heartbeat\\n    file fresh within three beats of ATTAVO_HEARTBEAT_S is alive; a stale\\n    one is died, whether or not the pid still lives -- a worker stuck\\n    somewhere that never reaches its own heartbeat loop again is exactly\\n    what this is for. Only with no heartbeat file at all -- an invocation\\n    from before this release, or one that died before touching its\\n    first beat -- does this fall back to the pid: alive and, with a\\n    stall bound declared, past it is hung; alive with no bound, or\\n    within it, is running for as long as it lives; not alive is died.\\n    The stall bound decides hung, never died.\\\"\\\"\\\"\\n    stage, nn_text = marker.stem.rsplit(\\\"-\\\", 1)\\n    nn = int(nn_text)\\n    log, last_at = _events_tail(_events_path_for(root, stage, nn))\\n    # R3: the stage ceiling, wall clock from the marker's own `at`, judged\\n    # before any liveness signal -- alive past it is hung by the ceiling,\\n    # whatever its event age (or absence of one) says.\\n    m = read_manifest(root) or {}\\n    ceiling = ceiling_s(m, stage)\\n    since_start = _seconds_since(info.get(\\\"at\\\"))\\n    if ceiling is not None and since_start is not None and since_start > ceiling:\\n        return InvocationReading(stage, nn, log, last_at, since_start, \\\"hung\\\", \\\"ceiling\\\")\\n    if not _streams_events(root, m, stage):\\n        # An adapter that declares it streams no events is judged by the\\n        # ceiling alone; the stall bound it can never trip is not asked.\\n        bound = None\\n    beat = heartbeat_path(root, stage, nn)\\n    if beat.is_file():\\n        try:\\n            beat_age = time.time() - beat.stat().st_mtime\\n        except OSError:\\n            beat_age = None\\n        cls = \\\"running\\\" if beat_age is not None and beat_age <= heartbeat_s() * 3 else \\\"died\\\"\\n        return InvocationReading(stage, nn, log, last_at, beat_age, cls)\\n    age = _seconds_since(last_at or info.get(\\\"at\\\"))\\n    if not invocation_alive(info):\\n        return InvocationReading(stage, nn, log, last_at, age, \\\"died\\\")\\n    if bound is None or age is None or age <= bound:\\n        return InvocationReading(stage, nn, log, last_at, age, \\\"running\\\")\\n    return InvocationReading(stage, nn, log, last_at, age, \\\"hung\\\", \\\"stall\\\")\\n\\n\\ndef _streams_events(root: Path, m: dict[str, Any], stage: str) -> bool:\\n    \\\"\\\"\\\"R3: whether the stage's adapter declares it streams events\\n    (adapters/<name>/conformance.json, \\\"streams_events\\\"); true when the\\n    adapter names none, or its conformance.json does not say.\\\"\\\"\\\"\\n    name = (m.get(\\\"executor\\\") or {}).get(stage) or (m.get(\\\"executor\\\") or {}).get(\\\"build\\\")\\n    if not name:\\n        return True\\n    for base in (root / \\\"attavo\\\" / \\\"adapters\\\", PRODUCT_ROOT / \\\"adapters\\\"):\\n        conf = base / name / \\\"conformance.json\\\"\\n        if conf.is_file():\\n            try:\\n                return bool(json.loads(conf.read_text()).get(\\\"streams_events\\\", True))\\n            except (OSError, ValueError):\\n                return True\\n    return True\\n\\n\\ndef uncommitted_record(root: Path, records_dir: Path, stage: str) -> Path | None:\\n    \\\"\\\"\\\"The latest <stage>-NN.json this working tree carries that git has\\n    no commit for yet -- the moment between a worker's write and its own\\n    commit. None when the latest record is already committed, or there\\n    is none at all.\\\"\\\"\\\"\\n    path = latest_attempt_path(records_dir, stage)\\n    if path is None or not path.is_file():\\n        return None\\n    status = subprocess.run(\\n        [\\\"git\\\", \\\"-C\\\", str(root), \\\"status\\\", \\\"--porcelain\\\", \\\"--\\\", str(path.relative_to(root))],\\n        capture_output=True, text=True, check=False)\\n    return path if status.stdout.strip() else None\\n\\n\\ndef worker_holds_copy(root: Path, records_dir: Path) -> bool:\\n    \\\"\\\"\\\"True when this checkout's own working tree cannot safely be moved\\n    -- an invocation marker with no record yet (a worker, here or\\n    elsewhere, still holds this attempt), or a build or verify record the\\n    working tree carries that git has not committed yet. Scoped to the\\n    stage records a pass or a worker itself ever transports -- an\\n    operator's own spec-gate or approve, routinely uncommitted between\\n    their own act and the next pass, is not this. A pass never\\n    fast-forwards while this holds (never while a worker holds the\\n    copy).\\\"\\\"\\\"\\n    if invocations_without_record(records_dir):\\n        return True\\n    return (uncommitted_record(root, records_dir, \\\"build\\\") is not None\\n           or uncommitted_record(root, records_dir, \\\"verify\\\") is not None)\\n\\n\\ndef fast_forward_to_origin(root: Path, m: dict[str, Any], item_id: str) -> None:\\n    \\\"\\\"\\\"The pass's own read of origin's branch, taken before it reads\\n    anything else -- a commit landed there from elsewhere (an approval\\n    from the screen, a ruling, another pass's own record) is not a race\\n    for the lease, it is exactly what the lease is for. Never while a\\n    worker holds this copy (worker_holds_copy): resetting a working tree\\n    a detached child is still writing into would corrupt its own commits.\\n    A plain fast-forward when origin is simply ahead; when this checkout\\n    also carries its own commits origin has not seen yet (an operator's\\n    approval, not yet pushed), those are replayed on top of origin's own\\n    tip instead -- no merge commit, and the marker this pass is about to\\n    write still lands as a fast-forward when it pushes. Silent about\\n    everything short of that -- a real conflict, or an absent origin, is\\n    left for the ordinary read (and the marker push, for the lease) to\\n    sort out.\\\"\\\"\\\"\\n    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n    if worker_holds_copy(root, records_dir) or not has_origin(root):\\n        return\\n    try:\\n        branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n        git(root, \\\"fetch\\\", \\\"origin\\\", branch)\\n    except RuntimeError:\\n        return\\n    try:\\n        git(root, \\\"merge\\\", \\\"--ff-only\\\", \\\"FETCH_HEAD\\\")\\n        return\\n    except RuntimeError:\\n        pass\\n    try:\\n        git(root, \\\"rebase\\\", \\\"FETCH_HEAD\\\")\\n    except RuntimeError:\\n        subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"rebase\\\", \\\"--abort\\\"],\\n                       capture_output=True, text=True, check=False)\\n\\n\\n# --- the worker: a detached child of the pass's own session, running the\\n# stage exactly as the pass used to inline, touching its own heartbeat\\n# while it does (R2). ---\\n\\ndef _stage_body(item_id: str, stage: str, nn: int) -> int:\\n    \\\"\\\"\\\"Runs build or verify in-process -- the same command `attavo build`\\n    or `attavo verify` would run -- while touching heartbeat_path every\\n    heartbeat_s() seconds, then transports whatever it wrote: counsel and\\n    file-stops on a non-pass record (issue #100, #89), one `git commit\\n    --only`, one push with the record push's own merge retry. The\\n    marker is the pass's, already committed and pushed before this\\n    starts; this writes and transports only the stage's own record (and,\\n    on a stop, its counsel record).\\\"\\\"\\\"\\n    root = Path(\\\".\\\").resolve()\\n    m = read_manifest(root)\\n    if m is None:\\n        return 2\\n    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n    before = latest_attempt_path(records_dir, stage)\\n\\n    beat = heartbeat_path(root, stage, nn)\\n    beat.parent.mkdir(parents=True, exist_ok=True)\\n    beat.touch()\\n    stop_beat = threading.Event()\\n\\n    def _tick() -> None:\\n        while not stop_beat.wait(heartbeat_s()):\\n            beat.touch()\\n\\n    beat_thread = threading.Thread(target=_tick, daemon=True)\\n    beat_thread.start()\\n    try:\\n        rc = cmd_build([item_id]) if stage == \\\"build\\\" else cmd_verify([item_id])\\n    finally:\\n        stop_beat.set()\\n        beat_thread.join()\\n\\n    after = latest_attempt_path(records_dir, stage)\\n    if after is None or after == before:\\n        # Refused before writing anything at all (e.g. no adapter\\n        # configured) -- the stage command already printed why.\\n        return rc if rc != 0 else 1\\n\\n    record = cast(dict[str, Any], latest_record(records_dir, stage))\\n    status_out = record.get(\\\"status\\\")\\n    to_commit = [after]\\n    if status_out != \\\"pass\\\":\\n        # R3: a retryable family (died, hung, transient, returned) asks\\n        # counsel nothing while its budget still has an attempt to\\n        # spend -- the next pass retries it plainly. Once its budget is\\n        # spent, or its last two signatures match, counsel is read once\\n        # more, its sentence carried beside the exhaustion report, never\\n        # instead of it. Every other class is counsel's to read on every\\n        # stop, as before this item.\\n        stop_class = (record.get(\\\"stop\\\") or {}).get(\\\"class\\\")\\n        budget_stage = \\\"build\\\" if stop_class == \\\"returned\\\" else stage\\n        ask_counsel = (stop_class not in RETRYABLE_CLASSES\\n                      or stage_exhausted(records_dir, m, stage, budget_stage))\\n        counsel_before = latest_attempt_path(records_dir, \\\"counsel\\\")\\n        if ask_counsel:\\n            cmd_counsel([item_id])\\n        counsel_after = latest_attempt_path(records_dir, \\\"counsel\\\")\\n        if counsel_after is not None and counsel_after != counsel_before:\\n            to_commit.append(counsel_after)\\n        # file-stops is its own idempotent read of the item's records, so\\n        # calling it here on every run that wrote a non-pass record is\\n        # safe to call again on a later run: an already-filed stop's own\\n        # marker is what stops it from being filed twice.\\n        cmd_file_stops([item_id])\\n\\n    message = f\\\"attavo: {stage} record for item {item_id} ({after.stem})\\\"\\n    try:\\n        commit_record(root, to_commit, message)\\n    except RuntimeError as exc:\\n        print(f\\\"attavo drive: stopped: could not commit the {stage} record: {exc}\\\")\\n        return 1\\n\\n    if has_origin(root):\\n        ok, err = push_record_commit(root, branch)\\n        if not ok:\\n            print(f\\\"attavo drive: stopped: could not push the {stage} record: {err}\\\")\\n            return 1\\n    else:\\n        print(f\\\"attavo drive: note: no origin remote; {after.name} is committed, not pushed\\\")\\n\\n    if status_out == \\\"halted\\\":\\n        question = (record.get(\\\"halted\\\") or {}).get(\\\"question\\\")\\n        print(f\\\"attavo drive: stopped: {stage} halted: {question} ({after.name}); \\\"\\n              f\\\"pushed to {branch}\\\")\\n    elif status_out != \\\"pass\\\":\\n        reason = record.get(\\\"refusal\\\") or status_out\\n        print(f\\\"attavo drive: stopped: {stage} {status_out}: {reason} ({after.name}); \\\"\\n              f\\\"pushed to {branch}\\\")\\n    else:\\n        print(f\\\"attavo drive: pushed {after.name} to {branch}\\\")\\n    return rc\\n\\n\\ndef cmd_worker(argv: list[str]) -> int:\\n    \\\"\\\"\\\"`attavo worker N <build|verify> NN`: the detached child a pass\\n    starts once its marker is pushed -- the lease held, the attempt is\\n    this worker's to run. Its own session (start_new_session, set by the\\n    pass that spawns it); its stdout and stderr are the pass's own\\n    redirect, to <git-dir>/attavo/<stage>-NN.worker.log.\\\"\\\"\\\"\\n    cast(io.TextIOWrapper, sys.stdout).reconfigure(line_buffering=True)\\n    if len(argv) != 3:\\n        print(\\\"attavo worker: usage: attavo worker N <build|verify> NN\\\", file=sys.stderr)\\n        return 2\\n    item_id, stage, nn_text = argv\\n    if stage not in (\\\"build\\\", \\\"verify\\\"):\\n        print(f\\\"attavo worker: {stage!r} is not build or verify\\\", file=sys.stderr)\\n        return 2\\n    try:\\n        nn = int(nn_text)\\n    except ValueError:\\n        print(f\\\"attavo worker: {nn_text!r} is not an attempt number\\\", file=sys.stderr)\\n        return 2\\n    return _stage_body(item_id, stage, nn)\\n\\n\\n# --- the pass's own two acts: start a stage (the lease), and recover\\n# exactly the one invocation the report names owed one. ---\\n\\ndef _start_stage(root: Path, m: dict[str, Any], item_id: str, stage: str,\\n                 forge_checks: dict[str, Any] | None, *, again_by: bool = False) -> int:\\n    \\\"\\\"\\\"The lease (ruling A): the marker, committed and pushed as a plain\\n    fast-forward with no merge and no retry (push_lease). Lost to another\\n    pass, or refused outright by the remote, both undo the marker commit\\n    here (git reset --hard) so this checkout carries no half-taken\\n    attempt either way; only a pushed lease starts the worker. On a\\n    review, forge_checks is the checks this same pass already read on\\n    the pre-marker head (ruling B) -- written to\\n    <git-dir>/attavo/verify-NN.forge-checks.json and named in\\n    ATTAVO_FORGE_CHECKS, so the worker's own `attavo verify` reads it\\n    instead of polling. R3: again_by names the marker as `--again`'s own\\n    act on a stage whose budget was already spent.\\\"\\\"\\\"\\n    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n    nn = next_attempt_number(records_dir, stage)\\n    marker = write_invocation_marker(root, records_dir, stage, nn, again_by=again_by)\\n    try:\\n        commit_record(root, [marker], f\\\"attavo: {stage} invocation {nn:02d} started for item {item_id}\\\")\\n    except RuntimeError as exc:\\n        print(f\\\"attavo drive: stopped: could not commit the {stage} invocation marker: {exc}\\\")\\n        return 1\\n\\n    if has_origin(root):\\n        outcome, err = push_lease(root, branch)\\n        if outcome != \\\"pushed\\\":\\n            git(root, \\\"reset\\\", \\\"--hard\\\", \\\"HEAD^\\\")\\n            if outcome == \\\"lost-race\\\":\\n                print(f\\\"attavo drive: another pass holds this attempt ({marker.name}); nothing started\\\")\\n                return 0\\n            print(f\\\"attavo drive: stopped: could not push the {stage} invocation marker: {err}\\\")\\n            return 1\\n\\n    env = dict(os.environ)\\n    if forge_checks is not None:\\n        checks_file = forge_checks_path(root, stage, nn)\\n        checks_file.write_text(json.dumps(forge_checks))\\n        env[\\\"ATTAVO_FORGE_CHECKS\\\"] = str(checks_file)\\n    log = worker_log_path(root, stage, nn)\\n    with log.open(\\\"ab\\\") as fh, open(os.devnull, \\\"rb\\\") as devnull:\\n        proc = subprocess.Popen(\\n            [sys.executable, str(PRODUCT_ROOT / \\\"bin\\\" / \\\"attavo\\\"), \\\"worker\\\", item_id, stage, f\\\"{nn:02d}\\\"],\\n            cwd=str(root), env=env, stdin=devnull, stdout=fh, stderr=subprocess.STDOUT,\\n            start_new_session=True)\\n    word = \\\"Build\\\" if stage == \\\"build\\\" else \\\"Review\\\"\\n    print(f\\\"attavo drive: {word} started (attempt {nn:02d}, worker pid {proc.pid})\\\")\\n    return 0\\n\\n\\ndef _recover_one(root: Path, m: dict[str, Any], item_id: str, records_dir: Path) -> int:\\n    \\\"\\\"\\\"The pass's own recovery act (what `--recover` did): exactly the one\\n    invocation the report just read as owing one -- died or hung -- ends\\n    here. class died when the heartbeat is stale (or absent and the pid\\n    is gone), class hung when there is no heartbeat, the pid lives, and a\\n    declared [drive].stall_after_s has passed with no newer event, and\\n    terminated. Provenance product; the events tail as the log. Committed\\n    and pushed the way any stage record is (push_record_commit, with its\\n    own merge retry) -- this is not a race for a lease, since no new\\n    attempt marker is written.\\\"\\\"\\\"\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n    bound = stall_bound_s(m)\\n    pending = invocations_without_record(records_dir)\\n    readings = [(marker, info, read_invocation(root, bound, marker, info)) for marker, info in pending]\\n    candidate = next(((mk, i, rd) for mk, i, rd in readings if rd.cls != \\\"running\\\"), None)\\n    if candidate is None:\\n        # The report read this a moment ago; nothing owed recovery by the\\n        # time this pass got here (another pass recovered it, or it\\n        # finished on its own).\\n        return 0\\n    marker, info, reading = candidate\\n    stage, nn, log, last_at, age, cls, crossed = reading\\n    pid, host = info.get(\\\"pid\\\"), info.get(\\\"host\\\")\\n\\n    if next_attempt_number(records_dir, stage) != nn:\\n        print(f\\\"attavo drive: stopped: {marker.name} names attempt {nn} but the next \\\"\\n              f\\\"{stage} record would be {next_attempt_number(records_dir, stage):02d}; \\\"\\n              f\\\"a later record already exists, read the records before recovering\\\")\\n        return 1\\n\\n    if cls == \\\"hung\\\":\\n        try:\\n            os.kill(cast(int, pid), signal.SIGTERM)\\n            ended = \\\"terminated\\\"\\n        except OSError as exc:\\n            ended = f\\\"not terminated ({exc})\\\"\\n        if crossed == \\\"ceiling\\\":\\n            detail = (f\\\"pid {pid} on {host} alive {int(cast(float, age))} s after its marker, past \\\"\\n                      f\\\"the {stage} ceiling of {ceiling_s(m, stage)} s; {ended}\\\")\\n        else:\\n            detail = (f\\\"pid {pid} on {host} alive with no event for {int(cast(float, age))} s \\\"\\n                      f\\\"(bound {bound} s); {ended}\\\")\\n    else:\\n        detail = (f\\\"pid {pid} on {host} is not running and wrote no {marker.stem}.json; \\\"\\n                  f\\\"started {info.get('at')}, last event {last_at or 'none'}\\\")\\n\\n    schema = stage_schema(stage)\\n    record: dict[str, Any] = {k: None for k in schema.get(\\\"required\\\", [])}\\n    approval = latest_record(records_dir, \\\"approval\\\")\\n    signature_source = log.strip().splitlines()[-1] if log.strip() else detail\\n    record.update({\\\"sha\\\": info.get(\\\"sha\\\"), \\\"start_sha\\\": info.get(\\\"sha\\\"),\\n                   \\\"approval_sha\\\": approval.get(\\\"sha\\\") if approval else None,\\n                   \\\"at\\\": info.get(\\\"at\\\"),\\n                   \\\"adapter\\\": (m.get(\\\"executor\\\") or {}).get(stage),\\n                   \\\"status\\\": \\\"failed\\\", \\\"refusal\\\": None, \\\"halted\\\": None,\\n                   \\\"retry_of\\\": None, \\\"steer\\\": None,\\n                   \\\"stop\\\": {\\\"class\\\": cls, \\\"provenance\\\": \\\"product\\\", \\\"detail\\\": detail,\\n                            \\\"signature\\\": signature_of(signature_source), \\\"bound\\\": crossed}})\\n    if \\\"wall_clock_s\\\" in record:\\n        record[\\\"wall_clock_s\\\"] = None if age is None else int(age)\\n    record = {k: v for k, v in record.items() if k in schema.get(\\\"properties\\\", {})}\\n    try:\\n        path = write_record(records_dir, stage, record, m, item_id, log=log)\\n    except ValueError as exc:\\n        print(f\\\"attavo drive: stopped: could not write the {cls} record for {marker.stem}: {exc}\\\")\\n        return 1\\n    try:\\n        commit_record(root, [path], f\\\"attavo: {stage} record for item {item_id} \\\"\\n                                    f\\\"({path.stem}), recovered as {cls}\\\")\\n    except RuntimeError as exc:\\n        print(f\\\"attavo drive: stopped: could not commit the {cls} record: {exc}\\\")\\n        return 1\\n    if has_origin(root):\\n        ok, err = push_record_commit(root, branch)\\n        if not ok:\\n            print(f\\\"attavo drive: stopped: could not push the {cls} record: {err}\\\")\\n            return 1\\n    else:\\n        print(f\\\"attavo drive: note: no origin remote; {path.name} is committed, not pushed\\\")\\n    print(f\\\"attavo drive: recovered {marker.stem} as {cls}: {detail}\\\")\\n    return 0\\n\\n\\ndef _advance_again(root: Path, m: dict[str, Any], item_id: str, stage: str, head: str | None, *,\\n                   again_by: bool = False) -> int:\\n    \\\"\\\"\\\"The next attempt of a stopped stage: exactly what next-build or\\n    next-review would do, bypassing the level a plain pass leaves alone\\n    for the operator -- the pass's own automatic retry of a retryable\\n    family, or `--again`'s act once a budget is spent (again_by). A\\n    review reads the forge fresh here -- once, since the report's own\\n    stopped reading never touched it -- rather than reusing a read that\\n    was never taken.\\\"\\\"\\\"\\n    if stage == \\\"build\\\":\\n        return _start_stage(root, m, item_id, \\\"build\\\", None, again_by=again_by)\\n    checks_command = (m.get(\\\"forge\\\") or {}).get(\\\"checks_command\\\")\\n    if not checks_command:\\n        print(\\\"attavo drive: refused: no [forge].checks_command in the manifest\\\")\\n        return 1\\n    forge_checks, ok = read_forge_checks(root, checks_command, cast(str, head))\\n    if not ok:\\n        conclusions = forge_checks[\\\"conclusions\\\"]\\n        named = \\\", \\\".join(f\\\"{c['name']} {c['conclusion']}\\\" for c in conclusions) or \\\"no checks reported\\\"\\n        print(f\\\"attavo drive: forge checks not green on {cast(str, head)[:12]}: {named}\\\")\\n        return 0\\n    return _start_stage(root, m, item_id, \\\"verify\\\", forge_checks, again_by=again_by)\\n\\n\\ndef _retry_target(r: \\\"DriveReport\\\") -> str:\\n    \\\"\\\"\\\"The stage the next attempt actually starts: class \\\"returned\\\" (a\\n    build's head a check rejected, or a review's own blocking finding) is\\n    always the verify record's own stop, but the retry it starts is the\\n    next build.\\\"\\\"\\\"\\n    return \\\"build\\\" if r[\\\"stop_class\\\"] == \\\"returned\\\" else cast(str, r[\\\"stage\\\"])\\n\\n\\ndef _retry_due(root: Path, m: dict[str, Any], item_id: str, r: \\\"DriveReport\\\") -> bool:\\n    \\\"\\\"\\\"R3: a stopped stage whose class is one of the four retryable\\n    families, whose budget is not spent, whose last two signatures\\n    differ, and -- for transient -- whose record has aged past\\n    [drive].retry_after_s, is retried by the next plain pass, no\\n    counsel, no operator act.\\\"\\\"\\\"\\n    if r[\\\"stop_class\\\"] not in RETRYABLE_CLASSES:\\n        return False\\n    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n    sig_stage = cast(str, r[\\\"stage\\\"])\\n    budget_stage = _retry_target(r)\\n    if stage_exhausted(records_dir, m, sig_stage, budget_stage):\\n        return False\\n    if r[\\\"stop_class\\\"] == \\\"transient\\\":\\n        attempts = parse_attempts(records_dir, sig_stage)\\n        latest = attempts[max(attempts)] if attempts else {}\\n        age = _seconds_since(latest.get(\\\"at\\\"))\\n        if age is None or age < retry_after_s(m):\\n            return False\\n    return True\\n\\n\\ndef _handle_again(root: Path, m: dict[str, Any], item_id: str, r: \\\"DriveReport\\\") -> int:\\n    \\\"\\\"\\\"`--again`'s own act on a stopped stage (R3): a retryable family\\n    whose budget is not spent is left to the pass's own automatic retry\\n    -- a no-op here, saying so -- since starting it twice would spend two\\n    attempts on one press. A retryable family whose budget is spent, or\\n    any other stopped class, starts the next attempt at once, its marker\\n    naming --again as what started it.\\\"\\\"\\\"\\n    stage = _retry_target(r)\\n    if r[\\\"stop_class\\\"] in RETRYABLE_CLASSES:\\n        records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n        if not stage_exhausted(records_dir, m, cast(str, r[\\\"stage\\\"]), stage):\\n            print(\\\"attavo drive: --again is a no-op inside the budget; the pass retries on its own\\\")\\n            return 0\\n    return _advance_again(root, m, item_id, stage, r[\\\"head\\\"], again_by=True)\\n\\n\\ndef _counsel_answered(records_dir: Path, r: \\\"DriveReport\\\") -> bool:\\n    \\\"\\\"\\\"R3: whether the stop this report just read as \\\"stopped\\\" already\\n    carries counsel's own \\\"answer\\\" verdict -- every non-retryable class\\n    is counsel's to read (as before this item), and `answer` starts the\\n    next attempt with the answer as its steer, read from the feedback\\n    file the retried attempt's own first iteration is handed\\n    (attavo.build._retry_seed).\\\"\\\"\\\"\\n    if r[\\\"stop_class\\\"] in RETRYABLE_CLASSES or not r[\\\"stage\\\"] or r[\\\"attempt\\\"] is None:\\n        return False\\n    counsel = counsel_record_for(records_dir, cast(str, r[\\\"stage\\\"]), cast(int, r[\\\"attempt\\\"]))\\n    return counsel is not None and counsel.get(\\\"verdict\\\") == \\\"answer\\\"\\n\\n\\ndef _pass_once(root: Path, m: dict[str, Any], item_id: str, again: bool) -> tuple[int, \\\"DriveReport\\\"]:\\n    \\\"\\\"\\\"One pass: fast-forward to origin (never while a worker holds the\\n    copy), read the report, act at most once, return. The three acts,\\n    one per report state that is the product's move: owes-recovery\\n    recovers; next-build and next-review start their stage, handing a\\n    review the checks the report already read once on the pre-marker\\n    head; a concluded red check on a passed build's head (R3) is a\\n    returned review record, not a level, so the review starts the same\\n    way. On a stopped stage, `--again` always wins (a no-op inside the\\n    budget, the next attempt once it is spent); absent it, a retryable\\n    family retries on its own, and any other stop counsel has already\\n    answered starts the next attempt steered by that answer. Every other\\n    level is printed in the report's own words and left.\\\"\\\"\\\"\\n    from attavo.report import drive_report\\n    fast_forward_to_origin(root, m, item_id)\\n    r = drive_report(root, m, item_id)\\n\\n    if r[\\\"state\\\"] == \\\"owes-recovery\\\":\\n        records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n        return _recover_one(root, m, item_id, records_dir), r\\n    if r[\\\"state\\\"] == \\\"next-build\\\":\\n        return _start_stage(root, m, item_id, \\\"build\\\", None), r\\n    if r[\\\"state\\\"] == \\\"next-review\\\":\\n        checks_command = (m.get(\\\"forge\\\") or {}).get(\\\"checks_command\\\")\\n        forge_checks = {\\\"command\\\": checks_command, \\\"sha\\\": r[\\\"head\\\"], \\\"conclusions\\\": r[\\\"checks\\\"] or []}\\n        return _start_stage(root, m, item_id, \\\"verify\\\", forge_checks), r\\n    if r[\\\"state\\\"] == \\\"blocked-on-checks\\\" and r[\\\"stage\\\"] == \\\"verify\\\":\\n        # R3: the rejection is a record, not a level with nothing behind\\n        # it (#206's build-01) -- the review starts, reading the same\\n        # forge checks this pass just read, and writes the check\\n        # rejection itself as a returned record (attavo.verify.cmd_verify).\\n        checks_command = (m.get(\\\"forge\\\") or {}).get(\\\"checks_command\\\")\\n        forge_checks = {\\\"command\\\": checks_command, \\\"sha\\\": r[\\\"head\\\"], \\\"conclusions\\\": r[\\\"checks\\\"] or []}\\n        return _start_stage(root, m, item_id, \\\"verify\\\", forge_checks), r\\n    if r[\\\"state\\\"] == \\\"stopped\\\" and r[\\\"stage\\\"]:\\n        if again:\\n            return _handle_again(root, m, item_id, r), r\\n        records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n        if _retry_due(root, m, item_id, r):\\n            return _advance_again(root, m, item_id, _retry_target(r), r[\\\"head\\\"]), r\\n        if _counsel_answered(records_dir, r):\\n            return _advance_again(root, m, item_id, _retry_target(r), r[\\\"head\\\"]), r\\n\\n    print(f\\\"attavo drive: {r['says']}\\\")\\n    return (1 if r[\\\"state\\\"] == \\\"refused\\\" else 0), r\\n\\n\\n_TERMINAL_STATES = (\\\"waiting-on-approval\\\", \\\"stopped\\\", \\\"ready-to-merge\\\", \\\"merged\\\")\\n\\n\\ndef _until_ready(root: Path, m: dict[str, Any], item_id: str, again: bool) -> int:\\n    \\\"\\\"\\\"--until-ready: the pass, repeated in one process, sleeping\\n    ATTAVO_DRIVE_POLL_INTERVAL_S between passes, until the level is the\\n    operator's or done (exit 0), a concluded check is red (exit 1), or\\n    an unconcluded one has not concluded within ATTAVO_DRIVE_POLL_BOUND_S\\n    (exit 1). A stage running in its own worker is not bounded by this --\\n    only time spent waiting on the forge is.\\\"\\\"\\\"\\n    from attavo.verify import drive_forge_poll_bound_s, drive_forge_poll_interval_s\\n    bound = drive_forge_poll_bound_s()\\n    interval = drive_forge_poll_interval_s()\\n    waiting_since: float | None = None\\n    while True:\\n        rc, r = _pass_once(root, m, item_id, again)\\n        state = r[\\\"state\\\"]\\n\\n        if state == \\\"waiting-on-checks\\\":\\n            if waiting_since is None:\\n                waiting_since = time.monotonic()\\n            elif time.monotonic() - waiting_since >= bound:\\n                print(f\\\"attavo drive: stopped: the checks did not conclude within {bound:.0f}s\\\")\\n                return 1\\n        else:\\n            waiting_since = None\\n\\n        if rc != 0:\\n            return rc\\n        if state in _TERMINAL_STATES:\\n            return 0\\n        if state == \\\"blocked-on-checks\\\" and r[\\\"stage\\\"] != \\\"verify\\\":\\n            # R3: stage \\\"verify\\\" here is the pass's own act, just taken --\\n            # a concluded red check on a passed build's head is now a\\n            # returned review record (attavo.verify.cmd_verify), not a\\n            # level the loop gives up on with nothing behind it.\\n            return 1\\n        time.sleep(interval)\\n\\n\\ndef _drive_all() -> int:\\n    \\\"\\\"\\\"--all: one pass, in its own process, in every ../attavo-worktree-N\\n    beside this checkout -- each one derives its own item from its own\\n    attavo/N-* branch. Every line either prints is prefixed with the\\n    worktree's own directory name, so an operator reading them together\\n    can tell which item each line is about.\\\"\\\"\\\"\\n    root = Path(\\\".\\\").resolve()\\n    siblings = sorted(p for p in root.parent.glob(\\\"attavo-worktree-*\\\") if p.is_dir())\\n    if not siblings:\\n        print(\\\"attavo drive: --all found no ../attavo-worktree-N beside this checkout\\\")\\n        return 0\\n    worst = 0\\n    for copy in siblings:\\n        run = subprocess.run([sys.executable, str(PRODUCT_ROOT / \\\"bin\\\" / \\\"attavo\\\"), \\\"drive\\\"],\\n                             cwd=str(copy), capture_output=True, text=True, check=False)\\n        for line in (run.stdout + run.stderr).splitlines():\\n            print(f\\\"{copy.name}: {line}\\\")\\n        worst = max(worst, run.returncode)\\n    return worst\\n\\n\\ndef cmd_drive(argv: list[str]) -> int:\\n    # Issue #145: Python block-buffers stdout when it is not a tty (a\\n    # pipe, e.g. a screen reading this process live), so every line this\\n    # prints would otherwise sit unflushed until the process exits.\\n    # Line-buffering makes a pipe reader see each line the moment it is\\n    # printed, the same as a terminal already does; `attavo worker`\\n    # reconfigures its own stdout the same way.\\n    cast(io.TextIOWrapper, sys.stdout).reconfigure(line_buffering=True)\\n\\n    if \\\"--recover\\\" in argv:\\n        print(\\\"attavo drive: --recover is gone; a pass recovers a dead or hung invocation \\\"\\n              \\\"itself, as soon as the report owes one\\\", file=sys.stderr)\\n        return 2\\n\\n    until_ready = \\\"--until-ready\\\" in argv\\n    report = \\\"--report\\\" in argv\\n    again = \\\"--again\\\" in argv\\n    all_flag = \\\"--all\\\" in argv\\n    positional = [a for a in argv if not a.startswith(\\\"--\\\")]\\n\\n    if all_flag:\\n        if until_ready or report or again or positional:\\n            print(\\\"attavo drive: --all runs one pass in every worktree beside this checkout; \\\"\\n                  \\\"drop N and every other flag\\\", file=sys.stderr)\\n            return 2\\n        return _drive_all()\\n\\n    root = Path(\\\".\\\").resolve()\\n    item_id = positional[0] if positional else derive_item_id(root)\\n    if not item_id:\\n        print(\\\"attavo drive: cannot derive item id; pass N or run on an attavo/N-* branch\\\",\\n              file=sys.stderr)\\n        return 2\\n    m = read_manifest(root)\\n    if m is None:\\n        print(f\\\"attavo drive: no {MANIFEST} at {root}\\\", file=sys.stderr)\\n        return 2\\n\\n    if report:\\n        if until_ready or again:\\n            print(\\\"attavo drive: --report reads and does nothing else; drop --until-ready \\\"\\n                  \\\"and --again\\\", file=sys.stderr)\\n            return 2\\n        fast_forward_to_origin(root, m, item_id)\\n        from attavo.report import drive_report\\n        print(json.dumps(drive_report(root, m, item_id), indent=2))\\n        return 0\\n\\n    if until_ready:\\n        return _until_ready(root, m, item_id, again)\\n    rc, _ = _pass_once(root, m, item_id, again)\\n    return rc\\n\",\"structuredPatch\":[{\"oldStart\":724,\"oldLines\":7,\"newStart\":724,\"newLines\":7,\"lines\":[\"     (attavo.build._retry_seed).\\\"\\\"\\\"\",\"     if r[\\\"stop_class\\\"] in RETRYABLE_CLASSES or not r[\\\"stage\\\"] or r[\\\"attempt\\\"] is None:\",\"         return False\",\"-    counsel = counsel_record_for(records_dir, cast(str, r[\\\"stage\\\"]), cast(int, r[\\\"attempt\\\"]))\",\"+    counsel = counsel_record_for(records_dir, r[\\\"stage\\\"], r[\\\"attempt\\\"])\",\"     return counsel is not None and counsel.get(\\\"verdict\\\") == \\\"answer\\\"\",\" \",\" \"]}],\"userModified\":false,\"replaceAll\":false,\"contentNotInModelContext\":true}}\n2770:+{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01LFkDVD16oAQqZFpKJAMYpD\",\"type\":\"tool_result\",\"content\":\"The file /Users/davidbean/Projects/attavo-worktree-219/attavo/drive.py has been updated successfully. (note: the file had been modified on disk since you last read it — the edit applied cleanly, but the file contains other changes not in your context. Read it before edits that depend on surrounding content.)\"}]},\"parent_tool_use_id\":null,\"session_id\":\"0dd7ed4f-100c-4188-9a34-077aa0b6aa25\",\"uuid\":\"076d09bd-a46c-412d-8163-e2f024d19157\",\"timestamp\":\"2026-09-26T02:38:18.580Z\",\"tool_use_result\":{\"filePath\":\"/Users/davidbean/Projects/attavo-worktree-219/attavo/drive.py\",\"oldString\":\"from attavo.approval import approval_status\\nfrom attavo.build import cmd_build, driver_identity\",\"newString\":\"from attavo.approval import approval_status\\nfrom attavo.build import adapter_conformance, cmd_build, driver_identity, resolve_adapter\",\"originalFile\":\"from __future__ import annotations\\n\\nimport io\\nimport json\\nimport os\\nimport signal\\nimport subprocess\\nimport sys\\nimport threading\\nimport time\\nfrom pathlib import Path\\nfrom typing import TYPE_CHECKING, Any, NamedTuple, cast\\n\\nfrom attavo.approval import approval_status\\nfrom attavo.build import cmd_build, driver_identity\\nfrom attavo.common import MANIFEST, PRODUCT_ROOT, derive_item_id, git, read_manifest\\nfrom attavo.counsel import cmd_counsel\\nfrom attavo.doctor import (\\n    _parse_json_line,\\n    ceiling_s,\\n    invocation_alive,\\n    invocations_without_record,\\n    retry_after_s,\\n    stall_bound_s,\\n    write_invocation_marker,\\n)\\nfrom attavo.events import stage_events_dir\\nfrom attavo.filing import cmd_file_stops\\nfrom attavo.records import (\\n    latest_attempt_path,\\n    latest_record,\\n    next_attempt_number,\\n    parse_attempts,\\n    stage_schema,\\n    write_record,\\n)\\nfrom attavo.stops import RETRYABLE_CLASSES, counsel_record_for, signature_of, stage_exhausted\\nfrom attavo.verify import cmd_verify, read_forge_checks\\n\\nif TYPE_CHECKING:\\n    from attavo.types import DriveReport\\n\\n# --- drive: the mechanical transitions between approval and ready-to-merge\\n# (issue #84), under the reconciler's R2 (rulings A, B, C's recovery half,\\n# F, G, H): `attavo drive N` is one short pass. It reads the report\\n# (attavo.report), acts at most once -- recovers a dead or hung\\n# invocation, or starts the next stage in a detached worker -- and\\n# returns within seconds; the stage itself runs in `attavo worker`, a\\n# child of the pass's own session, which outlives it. Writes no record of\\n# its own: the stage records already on disk, and the invocation markers\\n# and heartbeats beside them, are the only state a pass or a worker\\n# reads. ---\\n\\n\\ndef commit_record(root: Path, record_paths: Path | list[Path], message: str) -> None:\\n    \\\"\\\"\\\"`git commit --only` on every record path given, and each one's .log\\n    and .filed, each if one exists -- never the whole index. A transport\\n    commit that sweeps the index is exactly the regression issue #46\\n    already guards build and verify against on the adapter side; drive\\n    must not reintroduce it on the transport side. The .filed marker\\n    (issue #89) is committed alongside the record it names, in the same\\n    commit and the same push, so a second worktree or a fresh clone reads\\n    the same filed fact rather than refiling every stop it finds with no\\n    marker of its own. A single Path is accepted for the common one-record\\n    case; issue #100 passes a list so the counsel record lands in the same\\n    commit as the stage record it counsels. Authored and committed as\\n    driver_identity(), set by the product and never the tenant's git\\n    config, so a driven item's record commits are never indistinguishable\\n    from an operator's own.\\\"\\\"\\\"\\n    if isinstance(record_paths, Path):\\n        record_paths = [record_paths]\\n    paths: list[str] = []\\n    for record_path in record_paths:\\n        paths.append(str(record_path.relative_to(root)))\\n        log_path = record_path.with_suffix(\\\".log\\\")\\n        if log_path.is_file():\\n            paths.append(str(log_path.relative_to(root)))\\n        marker_path = record_path.with_suffix(\\\".filed\\\")\\n        if marker_path.is_file():\\n            paths.append(str(marker_path.relative_to(root)))\\n    identity = driver_identity()\\n    env = dict(os.environ)\\n    env[\\\"GIT_AUTHOR_NAME\\\"] = identity[\\\"name\\\"]\\n    env[\\\"GIT_AUTHOR_EMAIL\\\"] = identity[\\\"email\\\"]\\n    env[\\\"GIT_COMMITTER_NAME\\\"] = identity[\\\"name\\\"]\\n    env[\\\"GIT_COMMITTER_EMAIL\\\"] = identity[\\\"email\\\"]\\n    git(root, \\\"add\\\", *paths)\\n    git(root, \\\"commit\\\", \\\"--only\\\", \\\"-m\\\", message, *paths, env=env)\\n\\n\\ndef push_record_commit(root: Path, branch: str) -> tuple[bool, str | None]:\\n    \\\"\\\"\\\"Push HEAD to branch on origin. A push a divergent remote rejects is\\n    retried once after `git pull --no-rebase --no-edit origin branch` -- a\\n    merge, never a rebase, because a rebase would change the sha the record\\n    commit just wrote already names. This is the record push's own retry\\n    -- the worker's, once it has the lease -- distinct from push_lease\\n    below, which never retries.\\\"\\\"\\\"\\n    def attempt() -> tuple[bool, str]:\\n        run = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"push\\\", \\\"origin\\\", f\\\"HEAD:{branch}\\\"],\\n                             capture_output=True, text=True, check=False)\\n        return run.returncode == 0, run.stderr.strip()\\n\\n    ok, err = attempt()\\n    if ok:\\n        return True, None\\n    pull = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"pull\\\", \\\"--no-rebase\\\", \\\"--no-edit\\\",\\n                           \\\"origin\\\", branch], capture_output=True, text=True, check=False)\\n    if pull.returncode != 0:\\n        return False, f\\\"push rejected and the retry merge failed: {pull.stderr.strip() or err}\\\"\\n    ok, err = attempt()\\n    if not ok:\\n        return False, f\\\"push rejected again after merging {branch}: {err}\\\"\\n    return True, None\\n\\n\\n_RACE_MARKERS = (\\\"non-fast-forward\\\", \\\"fetch first\\\", \\\"stale info\\\", \\\"cannot lock ref\\\",\\n                 \\\"failed to update ref\\\")\\n\\n\\ndef push_lease(root: Path, branch: str) -> tuple[str, str | None]:\\n    \\\"\\\"\\\"Push HEAD to branch on origin as a plain fast-forward -- no merge,\\n    no retry: this is the lease the marker commit takes on the attempt it\\n    names (ruling A). (\\\"pushed\\\", None) on success.\\n\\n    (\\\"lost-race\\\", stderr) when git's own ref check is what rejected it --\\n    the branch moved since this pass fast-forwarded to it (a sequential\\n    \\\"[rejected] ... (fetch first)\\\"), or the remote's own ref transaction\\n    lost a genuine simultaneous push (\\\"[remote rejected] ... (failed to\\n    update ref)\\\", \\\"cannot lock ref\\\"): either way, another pass's own\\n    marker (or record) landed there first. The pass that reads this is\\n    the loser: it says so, resets its own marker commit, and starts\\n    nothing.\\n\\n    (\\\"refused\\\", stderr) for every other rejection -- a remote that\\n    refuses the push outright (a hook, a permission, an unreachable\\n    remote). This is not a race for the lease; it is a refusal, and ends\\n    the pass with exit 1.\\\"\\\"\\\"\\n    run = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"push\\\", \\\"origin\\\", f\\\"HEAD:{branch}\\\"],\\n                         capture_output=True, text=True, check=False)\\n    if run.returncode == 0:\\n        return \\\"pushed\\\", None\\n    stderr = run.stderr\\n    if any(marker in stderr for marker in _RACE_MARKERS):\\n        return \\\"lost-race\\\", stderr.strip()\\n    return \\\"refused\\\", stderr.strip()\\n\\n\\ndef has_origin(root: Path) -> bool:\\n    \\\"\\\"\\\"Whether this checkout carries an origin remote at all -- a fixture\\n    or a scratch checkout with none is not a refusal; a pass commits\\n    locally and skips the push, the way recovery always has.\\\"\\\"\\\"\\n    try:\\n        git(root, \\\"remote\\\", \\\"get-url\\\", \\\"origin\\\")\\n        return True\\n    except RuntimeError:\\n        return False\\n\\n\\ndef drive_state(root: Path, m: dict[str, Any], item_id: str) -> tuple[str, str | None, Path]:\\n    \\\"\\\"\\\"(\\\"no-approval\\\" | \\\"build\\\" | \\\"verify\\\" | \\\"ready\\\", detail, records_dir):\\n    the next mechanical step for item_id, read from its latest records\\n    alone. A build only counts as current when it is a pass bound to the\\n    valid approval's own sha; a verify only counts as current when it is a\\n    pass bound to that build's own sha -- the same staleness a re-approval\\n    or a re-build must force, attest's own chain check already enforces\\n    (check_attest_chain), read here rather than re-typed.\\\"\\\"\\\"\\n    records_rel = m[\\\"paths\\\"][\\\"records\\\"]\\n    records_dir = root / records_rel / item_id\\n\\n    status = approval_status(root, m, item_id)\\n    if status != \\\"valid\\\":\\n        return \\\"no-approval\\\", status, records_dir\\n\\n    latest_approval = latest_record(records_dir, \\\"approval\\\")\\n    latest_build = latest_record(records_dir, \\\"build\\\")\\n    build_current = (latest_build is not None and latest_build.get(\\\"status\\\") == \\\"pass\\\"\\n                     and latest_build.get(\\\"approval_sha\\\")\\n                     == (latest_approval.get(\\\"sha\\\") if latest_approval else None))\\n    if latest_build is None or not build_current:\\n        return \\\"build\\\", None, records_dir\\n\\n    latest_verify = latest_record(records_dir, \\\"verify\\\")\\n    verify_current = (latest_verify is not None and latest_verify.get(\\\"status\\\") == \\\"pass\\\"\\n                      and latest_verify.get(\\\"build_sha\\\") == latest_build.get(\\\"sha\\\"))\\n    if not verify_current:\\n        return \\\"verify\\\", None, records_dir\\n\\n    return \\\"ready\\\", None, records_dir\\n\\n\\n# --- the heartbeat, the worker log, and the forge-checks handoff: local\\n# facts under the checkout's own git directory (issue #140's precedent),\\n# never committed and never among the paths commit_record ever names. ---\\n\\ndef heartbeat_s() -> float:\\n    return float(os.environ.get(\\\"ATTAVO_HEARTBEAT_S\\\", 15))\\n\\n\\ndef heartbeat_path(root: Path, stage: str, nn: int) -> Path:\\n    return stage_events_dir(root) / f\\\"{stage}-{nn:02d}.heartbeat\\\"\\n\\n\\ndef worker_log_path(root: Path, stage: str, nn: int) -> Path:\\n    return stage_events_dir(root) / f\\\"{stage}-{nn:02d}.worker.log\\\"\\n\\n\\ndef forge_checks_path(root: Path, stage: str, nn: int) -> Path:\\n    return stage_events_dir(root) / f\\\"{stage}-{nn:02d}.forge-checks.json\\\"\\n\\n\\ndef _events_path_for(root: Path, stage: str, nn: int) -> Path | None:\\n    \\\"\\\"\\\"The adapter's own events file for this invocation, under the\\n    checkout's git dir (a worktree's own dir when the checkout is one).\\\"\\\"\\\"\\n    try:\\n        gitdir = Path(git(root, \\\"rev-parse\\\", \\\"--git-dir\\\").strip())\\n    except RuntimeError:\\n        return None\\n    if not gitdir.is_absolute():\\n        gitdir = root / gitdir\\n    path = gitdir / \\\"attavo\\\" / f\\\"{stage}-{nn:02d}.events.jsonl\\\"\\n    return path if path.is_file() else None\\n\\n\\ndef _events_tail(path: Path | None, lines: int = 20) -> tuple[str, str | None]:\\n    \\\"\\\"\\\"(the last lines as a log, the last event's own at).\\\"\\\"\\\"\\n    if path is None:\\n        return \\\"no events file for this invocation\\\\n\\\", None\\n    try:\\n        text = path.read_text()\\n    except OSError:\\n        return \\\"events file unreadable\\\\n\\\", None\\n    tail = text.splitlines()[-lines:]\\n    last_at = None\\n    for line in reversed(tail):\\n        parsed = _parse_json_line(line)\\n        if not isinstance(parsed, dict):\\n            continue\\n        at = parsed.get(\\\"at\\\")\\n        if isinstance(at, str):\\n            last_at = at\\n            break\\n    return \\\"\\\\n\\\".join(tail) + \\\"\\\\n\\\", last_at\\n\\n\\ndef _seconds_since(at: str | None) -> float | None:\\n    from datetime import datetime, timezone\\n    if not at:\\n        return None\\n    try:\\n        then = datetime.strptime(at, \\\"%Y-%m-%dT%H:%M:%SZ\\\").replace(tzinfo=timezone.utc)\\n    except ValueError:\\n        return None\\n    return (datetime.now(timezone.utc) - then).total_seconds()\\n\\n\\nclass InvocationReading(NamedTuple):\\n    \\\"\\\"\\\"What one marker with no record reads as, from here and now.\\\"\\\"\\\"\\n    stage: str\\n    nn: int\\n    log: str\\n    last_at: str | None\\n    age: float | None\\n    cls: str  # \\\"running\\\" | \\\"hung\\\" | \\\"died\\\"\\n    bound: str | None = None  # R3: \\\"stall\\\" or \\\"ceiling\\\" when cls is \\\"hung\\\"\\n\\n\\ndef read_invocation(root: Path, bound: int | None, marker: Path, info: dict[str, Any]) -> InvocationReading:\\n    \\\"\\\"\\\"Whether an invocation that began and wrote no record is running,\\n    hung, or died -- read from its own heartbeat first (R2): a heartbeat\\n    file fresh within three beats of ATTAVO_HEARTBEAT_S is alive; a stale\\n    one is died, whether or not the pid still lives -- a worker stuck\\n    somewhere that never reaches its own heartbeat loop again is exactly\\n    what this is for. Only with no heartbeat file at all -- an invocation\\n    from before this release, or one that died before touching its\\n    first beat -- does this fall back to the pid: alive and, with a\\n    stall bound declared, past it is hung; alive with no bound, or\\n    within it, is running for as long as it lives; not alive is died.\\n    The stall bound decides hung, never died.\\\"\\\"\\\"\\n    stage, nn_text = marker.stem.rsplit(\\\"-\\\", 1)\\n    nn = int(nn_text)\\n    log, last_at = _events_tail(_events_path_for(root, stage, nn))\\n    # R3: the stage ceiling, wall clock from the marker's own `at`, judged\\n    # before any liveness signal -- alive past it is hung by the ceiling,\\n    # whatever its event age (or absence of one) says.\\n    m = read_manifest(root) or {}\\n    ceiling = ceiling_s(m, stage)\\n    since_start = _seconds_since(info.get(\\\"at\\\"))\\n    if ceiling is not None and since_start is not None and since_start > ceiling:\\n        return InvocationReading(stage, nn, log, last_at, since_start, \\\"hung\\\", \\\"ceiling\\\")\\n    if not _streams_events(root, m, stage):\\n        # An adapter that declares it streams no events is judged by the\\n        # ceiling alone; the stall bound it can never trip is not asked.\\n        bound = None\\n    beat = heartbeat_path(root, stage, nn)\\n    if beat.is_file():\\n        try:\\n            beat_age = time.time() - beat.stat().st_mtime\\n        except OSError:\\n            beat_age = None\\n        cls = \\\"running\\\" if beat_age is not None and beat_age <= heartbeat_s() * 3 else \\\"died\\\"\\n        return InvocationReading(stage, nn, log, last_at, beat_age, cls)\\n    age = _seconds_since(last_at or info.get(\\\"at\\\"))\\n    if not invocation_alive(info):\\n        return InvocationReading(stage, nn, log, last_at, age, \\\"died\\\")\\n    if bound is None or age is None or age <= bound:\\n        return InvocationReading(stage, nn, log, last_at, age, \\\"running\\\")\\n    return InvocationReading(stage, nn, log, last_at, age, \\\"hung\\\", \\\"stall\\\")\\n\\n\\ndef _streams_events(root: Path, m: dict[str, Any], stage: str) -> bool:\\n    \\\"\\\"\\\"R3: whether the stage's adapter declares it streams events\\n    (adapters/<name>/conformance.json, \\\"streams_events\\\"); true when the\\n    adapter names none, or its conformance.json does not say.\\\"\\\"\\\"\\n    name = (m.get(\\\"executor\\\") or {}).get(stage) or (m.get(\\\"executor\\\") or {}).get(\\\"build\\\")\\n    if not name:\\n        return True\\n    for base in (root / \\\"attavo\\\" / \\\"adapters\\\", PRODUCT_ROOT / \\\"adapters\\\"):\\n        conf = base / name / \\\"conformance.json\\\"\\n        if conf.is_file():\\n            try:\\n                return bool(json.loads(conf.read_text()).get(\\\"streams_events\\\", True))\\n            except (OSError, ValueError):\\n                return True\\n    return True\\n\\n\\ndef uncommitted_record(root: Path, records_dir: Path, stage: str) -> Path | None:\\n    \\\"\\\"\\\"The latest <stage>-NN.json this working tree carries that git has\\n    no commit for yet -- the moment between a worker's write and its own\\n    commit. None when the latest record is already committed, or there\\n    is none at all.\\\"\\\"\\\"\\n    path = latest_attempt_path(records_dir, stage)\\n    if path is None or not path.is_file():\\n        return None\\n    status = subprocess.run(\\n        [\\\"git\\\", \\\"-C\\\", str(root), \\\"status\\\", \\\"--porcelain\\\", \\\"--\\\", str(path.relative_to(root))],\\n        capture_output=True, text=True, check=False)\\n    return path if status.stdout.strip() else None\\n\\n\\ndef worker_holds_copy(root: Path, records_dir: Path) -> bool:\\n    \\\"\\\"\\\"True when this checkout's own working tree cannot safely be moved\\n    -- an invocation marker with no record yet (a worker, here or\\n    elsewhere, still holds this attempt), or a build or verify record the\\n    working tree carries that git has not committed yet. Scoped to the\\n    stage records a pass or a worker itself ever transports -- an\\n    operator's own spec-gate or approve, routinely uncommitted between\\n    their own act and the next pass, is not this. A pass never\\n    fast-forwards while this holds (never while a worker holds the\\n    copy).\\\"\\\"\\\"\\n    if invocations_without_record(records_dir):\\n        return True\\n    return (uncommitted_record(root, records_dir, \\\"build\\\") is not None\\n           or uncommitted_record(root, records_dir, \\\"verify\\\") is not None)\\n\\n\\ndef fast_forward_to_origin(root: Path, m: dict[str, Any], item_id: str) -> None:\\n    \\\"\\\"\\\"The pass's own read of origin's branch, taken before it reads\\n    anything else -- a commit landed there from elsewhere (an approval\\n    from the screen, a ruling, another pass's own record) is not a race\\n    for the lease, it is exactly what the lease is for. Never while a\\n    worker holds this copy (worker_holds_copy): resetting a working tree\\n    a detached child is still writing into would corrupt its own commits.\\n    A plain fast-forward when origin is simply ahead; when this checkout\\n    also carries its own commits origin has not seen yet (an operator's\\n    approval, not yet pushed), those are replayed on top of origin's own\\n    tip instead -- no merge commit, and the marker this pass is about to\\n    write still lands as a fast-forward when it pushes. Silent about\\n    everything short of that -- a real conflict, or an absent origin, is\\n    left for the ordinary read (and the marker push, for the lease) to\\n    sort out.\\\"\\\"\\\"\\n    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n    if worker_holds_copy(root, records_dir) or not has_origin(root):\\n        return\\n    try:\\n        branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n        git(root, \\\"fetch\\\", \\\"origin\\\", branch)\\n    except RuntimeError:\\n        return\\n    try:\\n        git(root, \\\"merge\\\", \\\"--ff-only\\\", \\\"FETCH_HEAD\\\")\\n        return\\n    except RuntimeError:\\n        pass\\n    try:\\n        git(root, \\\"rebase\\\", \\\"FETCH_HEAD\\\")\\n    except RuntimeError:\\n        subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"rebase\\\", \\\"--abort\\\"],\\n                       capture_output=True, text=True, check=False)\\n\\n\\n# --- the worker: a detached child of the pass's own session, running the\\n# stage exactly as the pass used to inline, touching its own heartbeat\\n# while it does (R2). ---\\n\\ndef _stage_body(item_id: str, stage: str, nn: int) -> int:\\n    \\\"\\\"\\\"Runs build or verify in-process -- the same command `attavo build`\\n    or `attavo verify` would run -- while touching heartbeat_path every\\n    heartbeat_s() seconds, then transports whatever it wrote: counsel and\\n    file-stops on a non-pass record (issue #100, #89), one `git commit\\n    --only`, one push with the record push's own merge retry. The\\n    marker is the pass's, already committed and pushed before this\\n    starts; this writes and transports only the stage's own record (and,\\n    on a stop, its counsel record).\\\"\\\"\\\"\\n    root = Path(\\\".\\\").resolve()\\n    m = read_manifest(root)\\n    if m is None:\\n        return 2\\n    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n    before = latest_attempt_path(records_dir, stage)\\n\\n    beat = heartbeat_path(root, stage, nn)\\n    beat.parent.mkdir(parents=True, exist_ok=True)\\n    beat.touch()\\n    stop_beat = threading.Event()\\n\\n    def _tick() -> None:\\n        while not stop_beat.wait(heartbeat_s()):\\n            beat.touch()\\n\\n    beat_thread = threading.Thread(target=_tick, daemon=True)\\n    beat_thread.start()\\n    try:\\n        rc = cmd_build([item_id]) if stage == \\\"build\\\" else cmd_verify([item_id])\\n    finally:\\n        stop_beat.set()\\n        beat_thread.join()\\n\\n    after = latest_attempt_path(records_dir, stage)\\n    if after is None or after == before:\\n        # Refused before writing anything at all (e.g. no adapter\\n        # configured) -- the stage command already printed why.\\n        return rc if rc != 0 else 1\\n\\n    record = cast(dict[str, Any], latest_record(records_dir, stage))\\n    status_out = record.get(\\\"status\\\")\\n    to_commit = [after]\\n    if status_out != \\\"pass\\\":\\n        # R3: a retryable family (died, hung, transient, returned) asks\\n        # counsel nothing while its budget still has an attempt to\\n        # spend -- the next pass retries it plainly. Once its budget is\\n        # spent, or its last two signatures match, counsel is read once\\n        # more, its sentence carried beside the exhaustion report, never\\n        # instead of it. Every other class is counsel's to read on every\\n        # stop, as before this item.\\n        stop_class = (record.get(\\\"stop\\\") or {}).get(\\\"class\\\")\\n        budget_stage = \\\"build\\\" if stop_class == \\\"returned\\\" else stage\\n        ask_counsel = (stop_class not in RETRYABLE_CLASSES\\n                      or stage_exhausted(records_dir, m, stage, budget_stage))\\n        counsel_before = latest_attempt_path(records_dir, \\\"counsel\\\")\\n        if ask_counsel:\\n            cmd_counsel([item_id])\\n        counsel_after = latest_attempt_path(records_dir, \\\"counsel\\\")\\n        if counsel_after is not None and counsel_after != counsel_before:\\n            to_commit.append(counsel_after)\\n        # file-stops is its own idempotent read of the item's records, so\\n        # calling it here on every run that wrote a non-pass record is\\n        # safe to call again on a later run: an already-filed stop's own\\n        # marker is what stops it from being filed twice.\\n        cmd_file_stops([item_id])\\n\\n    message = f\\\"attavo: {stage} record for item {item_id} ({after.stem})\\\"\\n    try:\\n        commit_record(root, to_commit, message)\\n    except RuntimeError as exc:\\n        print(f\\\"attavo drive: stopped: could not commit the {stage} record: {exc}\\\")\\n        return 1\\n\\n    if has_origin(root):\\n        ok, err = push_record_commit(root, branch)\\n        if not ok:\\n            print(f\\\"attavo drive: stopped: could not push the {stage} record: {err}\\\")\\n            return 1\\n    else:\\n        print(f\\\"attavo drive: note: no origin remote; {after.name} is committed, not pushed\\\")\\n\\n    if status_out == \\\"halted\\\":\\n        question = (record.get(\\\"halted\\\") or {}).get(\\\"question\\\")\\n        print(f\\\"attavo drive: stopped: {stage} halted: {question} ({after.name}); \\\"\\n              f\\\"pushed to {branch}\\\")\\n    elif status_out != \\\"pass\\\":\\n        reason = record.get(\\\"refusal\\\") or status_out\\n        print(f\\\"attavo drive: stopped: {stage} {status_out}: {reason} ({after.name}); \\\"\\n              f\\\"pushed to {branch}\\\")\\n    else:\\n        print(f\\\"attavo drive: pushed {after.name} to {branch}\\\")\\n    return rc\\n\\n\\ndef cmd_worker(argv: list[str]) -> int:\\n    \\\"\\\"\\\"`attavo worker N <build|verify> NN`: the detached child a pass\\n    starts once its marker is pushed -- the lease held, the attempt is\\n    this worker's to run. Its own session (start_new_session, set by the\\n    pass that spawns it); its stdout and stderr are the pass's own\\n    redirect, to <git-dir>/attavo/<stage>-NN.worker.log.\\\"\\\"\\\"\\n    cast(io.TextIOWrapper, sys.stdout).reconfigure(line_buffering=True)\\n    if len(argv) != 3:\\n        print(\\\"attavo worker: usage: attavo worker N <build|verify> NN\\\", file=sys.stderr)\\n        return 2\\n    item_id, stage, nn_text = argv\\n    if stage not in (\\\"build\\\", \\\"verify\\\"):\\n        print(f\\\"attavo worker: {stage!r} is not build or verify\\\", file=sys.stderr)\\n        return 2\\n    try:\\n        nn = int(nn_text)\\n    except ValueError:\\n        print(f\\\"attavo worker: {nn_text!r} is not an attempt number\\\", file=sys.stderr)\\n        return 2\\n    return _stage_body(item_id, stage, nn)\\n\\n\\n# --- the pass's own two acts: start a stage (the lease), and recover\\n# exactly the one invocation the report names owed one. ---\\n\\ndef _start_stage(root: Path, m: dict[str, Any], item_id: str, stage: str,\\n                 forge_checks: dict[str, Any] | None, *, again_by: bool = False) -> int:\\n    \\\"\\\"\\\"The lease (ruling A): the marker, committed and pushed as a plain\\n    fast-forward with no merge and no retry (push_lease). Lost to another\\n    pass, or refused outright by the remote, both undo the marker commit\\n    here (git reset --hard) so this checkout carries no half-taken\\n    attempt either way; only a pushed lease starts the worker. On a\\n    review, forge_checks is the checks this same pass already read on\\n    the pre-marker head (ruling B) -- written to\\n    <git-dir>/attavo/verify-NN.forge-checks.json and named in\\n    ATTAVO_FORGE_CHECKS, so the worker's own `attavo verify` reads it\\n    instead of polling. R3: again_by names the marker as `--again`'s own\\n    act on a stage whose budget was already spent.\\\"\\\"\\\"\\n    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n    nn = next_attempt_number(records_dir, stage)\\n    marker = write_invocation_marker(root, records_dir, stage, nn, again_by=again_by)\\n    try:\\n        commit_record(root, [marker], f\\\"attavo: {stage} invocation {nn:02d} started for item {item_id}\\\")\\n    except RuntimeError as exc:\\n        print(f\\\"attavo drive: stopped: could not commit the {stage} invocation marker: {exc}\\\")\\n        return 1\\n\\n    if has_origin(root):\\n        outcome, err = push_lease(root, branch)\\n        if outcome != \\\"pushed\\\":\\n            git(root, \\\"reset\\\", \\\"--hard\\\", \\\"HEAD^\\\")\\n            if outcome == \\\"lost-race\\\":\\n                print(f\\\"attavo drive: another pass holds this attempt ({marker.name}); nothing started\\\")\\n                return 0\\n            print(f\\\"attavo drive: stopped: could not push the {stage} invocation marker: {err}\\\")\\n            return 1\\n\\n    env = dict(os.environ)\\n    if forge_checks is not None:\\n        checks_file = forge_checks_path(root, stage, nn)\\n        checks_file.write_text(json.dumps(forge_checks))\\n        env[\\\"ATTAVO_FORGE_CHECKS\\\"] = str(checks_file)\\n    log = worker_log_path(root, stage, nn)\\n    with log.open(\\\"ab\\\") as fh, open(os.devnull, \\\"rb\\\") as devnull:\\n        proc = subprocess.Popen(\\n            [sys.executable, str(PRODUCT_ROOT / \\\"bin\\\" / \\\"attavo\\\"), \\\"worker\\\", item_id, stage, f\\\"{nn:02d}\\\"],\\n            cwd=str(root), env=env, stdin=devnull, stdout=fh, stderr=subprocess.STDOUT,\\n            start_new_session=True)\\n    word = \\\"Build\\\" if stage == \\\"build\\\" else \\\"Review\\\"\\n    print(f\\\"attavo drive: {word} started (attempt {nn:02d}, worker pid {proc.pid})\\\")\\n    return 0\\n\\n\\ndef _recover_one(root: Path, m: dict[str, Any], item_id: str, records_dir: Path) -> int:\\n    \\\"\\\"\\\"The pass's own recovery act (what `--recover` did): exactly the one\\n    invocation the report just read as owing one -- died or hung -- ends\\n    here. class died when the heartbeat is stale (or absent and the pid\\n    is gone), class hung when there is no heartbeat, the pid lives, and a\\n    declared [drive].stall_after_s has passed with no newer event, and\\n    terminated. Provenance product; the events tail as the log. Committed\\n    and pushed the way any stage record is (push_record_commit, with its\\n    own merge retry) -- this is not a race for a lease, since no new\\n    attempt marker is written.\\\"\\\"\\\"\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n    bound = stall_bound_s(m)\\n    pending = invocations_without_record(records_dir)\\n    readings = [(marker, info, read_invocation(root, bound, marker, info)) for marker, info in pending]\\n    candidate = next(((mk, i, rd) for mk, i, rd in readings if rd.cls != \\\"running\\\"), None)\\n    if candidate is None:\\n        # The report read this a moment ago; nothing owed recovery by the\\n        # time this pass got here (another pass recovered it, or it\\n        # finished on its own).\\n        return 0\\n    marker, info, reading = candidate\\n    stage, nn, log, last_at, age, cls, crossed = reading\\n    pid, host = info.get(\\\"pid\\\"), info.get(\\\"host\\\")\\n\\n    if next_attempt_number(records_dir, stage) != nn:\\n        print(f\\\"attavo drive: stopped: {marker.name} names attempt {nn} but the next \\\"\\n              f\\\"{stage} record would be {next_attempt_number(records_dir, stage):02d}; \\\"\\n              f\\\"a later record already exists, read the records before recovering\\\")\\n        return 1\\n\\n    if cls == \\\"hung\\\":\\n        try:\\n            os.kill(cast(int, pid), signal.SIGTERM)\\n            ended = \\\"terminated\\\"\\n        except OSError as exc:\\n            ended = f\\\"not terminated ({exc})\\\"\\n        if crossed == \\\"ceiling\\\":\\n            detail = (f\\\"pid {pid} on {host} alive {int(cast(float, age))} s after its marker, past \\\"\\n                      f\\\"the {stage} ceiling of {ceiling_s(m, stage)} s; {ended}\\\")\\n        else:\\n            detail = (f\\\"pid {pid} on {host} alive with no event for {int(cast(float, age))} s \\\"\\n                      f\\\"(bound {bound} s); {ended}\\\")\\n    else:\\n        detail = (f\\\"pid {pid} on {host} is not running and wrote no {marker.stem}.json; \\\"\\n                  f\\\"started {info.get('at')}, last event {last_at or 'none'}\\\")\\n\\n    schema = stage_schema(stage)\\n    record: dict[str, Any] = {k: None for k in schema.get(\\\"required\\\", [])}\\n    approval = latest_record(records_dir, \\\"approval\\\")\\n    signature_source = log.strip().splitlines()[-1] if log.strip() else detail\\n    record.update({\\\"sha\\\": info.get(\\\"sha\\\"), \\\"start_sha\\\": info.get(\\\"sha\\\"),\\n                   \\\"approval_sha\\\": approval.get(\\\"sha\\\") if approval else None,\\n                   \\\"at\\\": info.get(\\\"at\\\"),\\n                   \\\"adapter\\\": (m.get(\\\"executor\\\") or {}).get(stage),\\n                   \\\"status\\\": \\\"failed\\\", \\\"refusal\\\": None, \\\"halted\\\": None,\\n                   \\\"retry_of\\\": None, \\\"steer\\\": None,\\n                   \\\"stop\\\": {\\\"class\\\": cls, \\\"provenance\\\": \\\"product\\\", \\\"detail\\\": detail,\\n                            \\\"signature\\\": signature_of(signature_source), \\\"bound\\\": crossed}})\\n    if \\\"wall_clock_s\\\" in record:\\n        record[\\\"wall_clock_s\\\"] = None if age is None else int(age)\\n    record = {k: v for k, v in record.items() if k in schema.get(\\\"properties\\\", {})}\\n    try:\\n        path = write_record(records_dir, stage, record, m, item_id, log=log)\\n    except ValueError as exc:\\n        print(f\\\"attavo drive: stopped: could not write the {cls} record for {marker.stem}: {exc}\\\")\\n        return 1\\n    try:\\n        commit_record(root, [path], f\\\"attavo: {stage} record for item {item_id} \\\"\\n                                    f\\\"({path.stem}), recovered as {cls}\\\")\\n    except RuntimeError as exc:\\n        print(f\\\"attavo drive: stopped: could not commit the {cls} record: {exc}\\\")\\n        return 1\\n    if has_origin(root):\\n        ok, err = push_record_commit(root, branch)\\n        if not ok:\\n            print(f\\\"attavo drive: stopped: could not push the {cls} record: {err}\\\")\\n            return 1\\n    else:\\n        print(f\\\"attavo drive: note: no origin remote; {path.name} is committed, not pushed\\\")\\n    print(f\\\"attavo drive: recovered {marker.stem} as {cls}: {detail}\\\")\\n    return 0\\n\\n\\ndef _advance_again(root: Path, m: dict[str, Any], item_id: str, stage: str, head: str | None, *,\\n                   again_by: bool = False) -> int:\\n    \\\"\\\"\\\"The next attempt of a stopped stage: exactly what next-build or\\n    next-review would do, bypassing the level a plain pass leaves alone\\n    for the operator -- the pass's own automatic retry of a retryable\\n    family, or `--again`'s act once a budget is spent (again_by). A\\n    review reads the forge fresh here -- once, since the report's own\\n    stopped reading never touched it -- rather than reusing a read that\\n    was never taken.\\\"\\\"\\\"\\n    if stage == \\\"build\\\":\\n        return _start_stage(root, m, item_id, \\\"build\\\", None, again_by=again_by)\\n    checks_command = (m.get(\\\"forge\\\") or {}).get(\\\"checks_command\\\")\\n    if not checks_command:\\n        print(\\\"attavo drive: refused: no [forge].checks_command in the manifest\\\")\\n        return 1\\n    forge_checks, ok = read_forge_checks(root, checks_command, cast(str, head))\\n    if not ok:\\n        conclusions = forge_checks[\\\"conclusions\\\"]\\n        named = \\\", \\\".join(f\\\"{c['name']} {c['conclusion']}\\\" for c in conclusions) or \\\"no checks reported\\\"\\n        print(f\\\"attavo drive: forge checks not green on {cast(str, head)[:12]}: {named}\\\")\\n        return 0\\n    return _start_stage(root, m, item_id, \\\"verify\\\", forge_checks, again_by=again_by)\\n\\n\\ndef _retry_target(r: \\\"DriveReport\\\") -> str:\\n    \\\"\\\"\\\"The stage the next attempt actually starts: class \\\"returned\\\" (a\\n    build's head a check rejected, or a review's own blocking finding) is\\n    always the verify record's own stop, but the retry it starts is the\\n    next build.\\\"\\\"\\\"\\n    return \\\"build\\\" if r[\\\"stop_class\\\"] == \\\"returned\\\" else cast(str, r[\\\"stage\\\"])\\n\\n\\ndef _retry_due(root: Path, m: dict[str, Any], item_id: str, r: \\\"DriveReport\\\") -> bool:\\n    \\\"\\\"\\\"R3: a stopped stage whose class is one of the four retryable\\n    families, whose budget is not spent, whose last two signatures\\n    differ, and -- for transient -- whose record has aged past\\n    [drive].retry_after_s, is retried by the next plain pass, no\\n    counsel, no operator act.\\\"\\\"\\\"\\n    if r[\\\"stop_class\\\"] not in RETRYABLE_CLASSES:\\n        return False\\n    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n    sig_stage = cast(str, r[\\\"stage\\\"])\\n    budget_stage = _retry_target(r)\\n    if stage_exhausted(records_dir, m, sig_stage, budget_stage):\\n        return False\\n    if r[\\\"stop_class\\\"] == \\\"transient\\\":\\n        attempts = parse_attempts(records_dir, sig_stage)\\n        latest = attempts[max(attempts)] if attempts else {}\\n        age = _seconds_since(latest.get(\\\"at\\\"))\\n        if age is None or age < retry_after_s(m):\\n            return False\\n    return True\\n\\n\\ndef _handle_again(root: Path, m: dict[str, Any], item_id: str, r: \\\"DriveReport\\\") -> int:\\n    \\\"\\\"\\\"`--again`'s own act on a stopped stage (R3): a retryable family\\n    whose budget is not spent is left to the pass's own automatic retry\\n    -- a no-op here, saying so -- since starting it twice would spend two\\n    attempts on one press. A retryable family whose budget is spent, or\\n    any other stopped class, starts the next attempt at once, its marker\\n    naming --again as what started it.\\\"\\\"\\\"\\n    stage = _retry_target(r)\\n    if r[\\\"stop_class\\\"] in RETRYABLE_CLASSES:\\n        records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n        if not stage_exhausted(records_dir, m, cast(str, r[\\\"stage\\\"]), stage):\\n            print(\\\"attavo drive: --again is a no-op inside the budget; the pass retries on its own\\\")\\n            return 0\\n    return _advance_again(root, m, item_id, stage, r[\\\"head\\\"], again_by=True)\\n\\n\\ndef _counsel_answered(records_dir: Path, r: \\\"DriveReport\\\") -> bool:\\n    \\\"\\\"\\\"R3: whether the stop this report just read as \\\"stopped\\\" already\\n    carries counsel's own \\\"answer\\\" verdict -- every non-retryable class\\n    is counsel's to read (as before this item), and `answer` starts the\\n    next attempt with the answer as its steer, read from the feedback\\n    file the retried attempt's own first iteration is handed\\n    (attavo.build._retry_seed).\\\"\\\"\\\"\\n    if r[\\\"stop_class\\\"] in RETRYABLE_CLASSES or not r[\\\"stage\\\"] or r[\\\"attempt\\\"] is None:\\n        return False\\n    counsel = counsel_record_for(records_dir, r[\\\"stage\\\"], r[\\\"attempt\\\"])\\n    return counsel is not None and counsel.get(\\\"verdict\\\") == \\\"answer\\\"\\n\\n\\ndef _pass_once(root: Path, m: dict[str, Any], item_id: str, again: bool) -> tuple[int, \\\"DriveReport\\\"]:\\n    \\\"\\\"\\\"One pass: fast-forward to origin (never while a worker holds the\\n    copy), read the report, act at most once, return. The three acts,\\n    one per report state that is the product's move: owes-recovery\\n    recovers; next-build and next-review start their stage, handing a\\n    review the checks the report already read once on the pre-marker\\n    head; a concluded red check on a passed build's head (R3) is a\\n    returned review record, not a level, so the review starts the same\\n    way. On a stopped stage, `--again` always wins (a no-op inside the\\n    budget, the next attempt once it is spent); absent it, a retryable\\n    family retries on its own, and any other stop counsel has already\\n    answered starts the next attempt steered by that answer. Every other\\n    level is printed in the report's own words and left.\\\"\\\"\\\"\\n    from attavo.report import drive_report\\n    fast_forward_to_origin(root, m, item_id)\\n    r = drive_report(root, m, item_id)\\n\\n    if r[\\\"state\\\"] == \\\"owes-recovery\\\":\\n        records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n        return _recover_one(root, m, item_id, records_dir), r\\n    if r[\\\"state\\\"] == \\\"next-build\\\":\\n        return _start_stage(root, m, item_id, \\\"build\\\", None), r\\n    if r[\\\"state\\\"] == \\\"next-review\\\":\\n        checks_command = (m.get(\\\"forge\\\") or {}).get(\\\"checks_command\\\")\\n        forge_checks = {\\\"command\\\": checks_command, \\\"sha\\\": r[\\\"head\\\"], \\\"conclusions\\\": r[\\\"checks\\\"] or []}\\n        return _start_stage(root, m, item_id, \\\"verify\\\", forge_checks), r\\n    if r[\\\"state\\\"] == \\\"blocked-on-checks\\\" and r[\\\"stage\\\"] == \\\"verify\\\":\\n        # R3: the rejection is a record, not a level with nothing behind\\n        # it (#206's build-01) -- the review starts, reading the same\\n        # forge checks this pass just read, and writes the check\\n        # rejection itself as a returned record (attavo.verify.cmd_verify).\\n        checks_command = (m.get(\\\"forge\\\") or {}).get(\\\"checks_command\\\")\\n        forge_checks = {\\\"command\\\": checks_command, \\\"sha\\\": r[\\\"head\\\"], \\\"conclusions\\\": r[\\\"checks\\\"] or []}\\n        return _start_stage(root, m, item_id, \\\"verify\\\", forge_checks), r\\n    if r[\\\"state\\\"] == \\\"stopped\\\" and r[\\\"stage\\\"]:\\n        if again:\\n            return _handle_again(root, m, item_id, r), r\\n        records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n        if _retry_due(root, m, item_id, r):\\n            return _advance_again(root, m, item_id, _retry_target(r), r[\\\"head\\\"]), r\\n        if _counsel_answered(records_dir, r):\\n            return _advance_again(root, m, item_id, _retry_target(r), r[\\\"head\\\"]), r\\n\\n    print(f\\\"attavo drive: {r['says']}\\\")\\n    return (1 if r[\\\"state\\\"] == \\\"refused\\\" else 0), r\\n\\n\\n_TERMINAL_STATES = (\\\"waiting-on-approval\\\", \\\"stopped\\\", \\\"ready-to-merge\\\", \\\"merged\\\")\\n\\n\\ndef _until_ready(root: Path, m: dict[str, Any], item_id: str, again: bool) -> int:\\n    \\\"\\\"\\\"--until-ready: the pass, repeated in one process, sleeping\\n    ATTAVO_DRIVE_POLL_INTERVAL_S between passes, until the level is the\\n    operator's or done (exit 0), a concluded check is red (exit 1), or\\n    an unconcluded one has not concluded within ATTAVO_DRIVE_POLL_BOUND_S\\n    (exit 1). A stage running in its own worker is not bounded by this --\\n    only time spent waiting on the forge is.\\\"\\\"\\\"\\n    from attavo.verify import drive_forge_poll_bound_s, drive_forge_poll_interval_s\\n    bound = drive_forge_poll_bound_s()\\n    interval = drive_forge_poll_interval_s()\\n    waiting_since: float | None = None\\n    while True:\\n        rc, r = _pass_once(root, m, item_id, again)\\n        state = r[\\\"state\\\"]\\n\\n        if state == \\\"waiting-on-checks\\\":\\n            if waiting_since is None:\\n                waiting_since = time.monotonic()\\n            elif time.monotonic() - waiting_since >= bound:\\n                print(f\\\"attavo drive: stopped: the checks did not conclude within {bound:.0f}s\\\")\\n                return 1\\n        else:\\n            waiting_since = None\\n\\n        if rc != 0:\\n            return rc\\n        if state in _TERMINAL_STATES:\\n            return 0\\n        if state == \\\"blocked-on-checks\\\" and r[\\\"stage\\\"] != \\\"verify\\\":\\n            # R3: stage \\\"verify\\\" here is the pass's own act, just taken --\\n            # a concluded red check on a passed build's head is now a\\n            # returned review record (attavo.verify.cmd_verify), not a\\n            # level the loop gives up on with nothing behind it.\\n            return 1\\n        time.sleep(interval)\\n\\n\\ndef _drive_all() -> int:\\n    \\\"\\\"\\\"--all: one pass, in its own process, in every ../attavo-worktree-N\\n    beside this checkout -- each one derives its own item from its own\\n    attavo/N-* branch. Every line either prints is prefixed with the\\n    worktree's own directory name, so an operator reading them together\\n    can tell which item each line is about.\\\"\\\"\\\"\\n    root = Path(\\\".\\\").resolve()\\n    siblings = sorted(p for p in root.parent.glob(\\\"attavo-worktree-*\\\") if p.is_dir())\\n    if not siblings:\\n        print(\\\"attavo drive: --all found no ../attavo-worktree-N beside this checkout\\\")\\n        return 0\\n    worst = 0\\n    for copy in siblings:\\n        run = subprocess.run([sys.executable, str(PRODUCT_ROOT / \\\"bin\\\" / \\\"attavo\\\"), \\\"drive\\\"],\\n                             cwd=str(copy), capture_output=True, text=True, check=False)\\n        for line in (run.stdout + run.stderr).splitlines():\\n            print(f\\\"{copy.name}: {line}\\\")\\n        worst = max(worst, run.returncode)\\n    return worst\\n\\n\\ndef cmd_drive(argv: list[str]) -> int:\\n    # Issue #145: Python block-buffers stdout when it is not a tty (a\\n    # pipe, e.g. a screen reading this process live), so every line this\\n    # prints would otherwise sit unflushed until the process exits.\\n    # Line-buffering makes a pipe reader see each line the moment it is\\n    # printed, the same as a terminal already does; `attavo worker`\\n    # reconfigures its own stdout the same way.\\n    cast(io.TextIOWrapper, sys.stdout).reconfigure(line_buffering=True)\\n\\n    if \\\"--recover\\\" in argv:\\n        print(\\\"attavo drive: --recover is gone; a pass recovers a dead or hung invocation \\\"\\n              \\\"itself, as soon as the report owes one\\\", file=sys.stderr)\\n        return 2\\n\\n    until_ready = \\\"--until-ready\\\" in argv\\n    report = \\\"--report\\\" in argv\\n    again = \\\"--again\\\" in argv\\n    all_flag = \\\"--all\\\" in argv\\n    positional = [a for a in argv if not a.startswith(\\\"--\\\")]\\n\\n    if all_flag:\\n        if until_ready or report or again or positional:\\n            print(\\\"attavo drive: --all runs one pass in every worktree beside this checkout; \\\"\\n                  \\\"drop N and every other flag\\\", file=sys.stderr)\\n            return 2\\n        return _drive_all()\\n\\n    root = Path(\\\".\\\").resolve()\\n    item_id = positional[0] if positional else derive_item_id(root)\\n    if not item_id:\\n        print(\\\"attavo drive: cannot derive item id; pass N or run on an attavo/N-* branch\\\",\\n              file=sys.stderr)\\n        return 2\\n    m = read_manifest(root)\\n    if m is None:\\n        print(f\\\"attavo drive: no {MANIFEST} at {root}\\\", file=sys.stderr)\\n        return 2\\n\\n    if report:\\n        if until_ready or again:\\n            print(\\\"attavo drive: --report reads and does nothing else; drop --until-ready \\\"\\n                  \\\"and --again\\\", file=sys.stderr)\\n            return 2\\n        fast_forward_to_origin(root, m, item_id)\\n        from attavo.report import drive_report\\n        print(json.dumps(drive_report(root, m, item_id), indent=2))\\n        return 0\\n\\n    if until_ready:\\n        return _until_ready(root, m, item_id, again)\\n    rc, _ = _pass_once(root, m, item_id, again)\\n    return rc\\n\",\"structuredPatch\":[{\"oldStart\":12,\"oldLines\":7,\"newStart\":12,\"newLines\":7,\"lines\":[\" from typing import TYPE_CHECKING, Any, NamedTuple, cast\",\" \",\" from attavo.approval import approval_status\",\"-from attavo.build import cmd_build, driver_identity\",\"+from attavo.build import adapter_conformance, cmd_build, driver_identity, resolve_adapter\",\" from attavo.common import MANIFEST, PRODUCT_ROOT, derive_item_id, git, read_manifest\",\" from attavo.counsel import cmd_counsel\",\" from attavo.doctor import (\"]}],\"userModified\":false,\"replaceAll\":false,\"staleRecovered\":true,\"contentNotInModelContext\":true}}\n2772:+{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01EjxxWBLw4ZJazxUyMAReGt\",\"type\":\"tool_result\",\"content\":\"The file /Users/davidbean/Projects/attavo-worktree-219/attavo/drive.py has been updated successfully.\"}]},\"parent_tool_use_id\":null,\"session_id\":\"0dd7ed4f-100c-4188-9a34-077aa0b6aa25\",\"uuid\":\"ea982f04-f56f-43f6-a231-49e1859ee358\",\"timestamp\":\"2026-09-26T02:38:24.476Z\",\"tool_use_result\":{\"filePath\":\"/Users/davidbean/Projects/attavo-worktree-219/attavo/drive.py\",\"oldString\":\"def _streams_events(root: Path, m: dict[str, Any], stage: str) -> bool:\\n    \\\"\\\"\\\"R3: whether the stage's adapter declares it streams events\\n    (adapters/<name>/conformance.json, \\\"streams_events\\\"); true when the\\n    adapter names none, or its conformance.json does not say.\\\"\\\"\\\"\\n    name = (m.get(\\\"executor\\\") or {}).get(stage) or (m.get(\\\"executor\\\") or {}).get(\\\"build\\\")\\n    if not name:\\n        return True\\n    for base in (root / \\\"attavo\\\" / \\\"adapters\\\", PRODUCT_ROOT / \\\"adapters\\\"):\\n        conf = base / name / \\\"conformance.json\\\"\\n        if conf.is_file():\\n            try:\\n                return bool(json.loads(conf.read_text()).get(\\\"streams_events\\\", True))\\n            except (OSError, ValueError):\\n                return True\\n    return True\",\"newString\":\"def _streams_events(root: Path, m: dict[str, Any], stage: str) -> bool:\\n    \\\"\\\"\\\"R3: whether the stage's adapter declares it streams events\\n    (adapters/<name>/conformance.json, \\\"streams_events\\\"); true when the\\n    adapter names none, or its conformance.json does not say.\\\"\\\"\\\"\\n    name = (m.get(\\\"executor\\\") or {}).get(stage) or (m.get(\\\"executor\\\") or {}).get(\\\"build\\\")\\n    if not name:\\n        return True\\n    adapter_path = resolve_adapter(root, name)\\n    if adapter_path is None:\\n        return True\\n    return bool(adapter_conformance(adapter_path).get(\\\"streams_events\\\", True))\",\"originalFile\":\"from __future__ import annotations\\n\\nimport io\\nimport json\\nimport os\\nimport signal\\nimport subprocess\\nimport sys\\nimport threading\\nimport time\\nfrom pathlib import Path\\nfrom typing import TYPE_CHECKING, Any, NamedTuple, cast\\n\\nfrom attavo.approval import approval_status\\nfrom attavo.build import adapter_conformance, cmd_build, driver_identity, resolve_adapter\\nfrom attavo.common import MANIFEST, PRODUCT_ROOT, derive_item_id, git, read_manifest\\nfrom attavo.counsel import cmd_counsel\\nfrom attavo.doctor import (\\n    _parse_json_line,\\n    ceiling_s,\\n    invocation_alive,\\n    invocations_without_record,\\n    retry_after_s,\\n    stall_bound_s,\\n    write_invocation_marker,\\n)\\nfrom attavo.events import stage_events_dir\\nfrom attavo.filing import cmd_file_stops\\nfrom attavo.records import (\\n    latest_attempt_path,\\n    latest_record,\\n    next_attempt_number,\\n    parse_attempts,\\n    stage_schema,\\n    write_record,\\n)\\nfrom attavo.stops import RETRYABLE_CLASSES, counsel_record_for, signature_of, stage_exhausted\\nfrom attavo.verify import cmd_verify, read_forge_checks\\n\\nif TYPE_CHECKING:\\n    from attavo.types import DriveReport\\n\\n# --- drive: the mechanical transitions between approval and ready-to-merge\\n# (issue #84), under the reconciler's R2 (rulings A, B, C's recovery half,\\n# F, G, H): `attavo drive N` is one short pass. It reads the report\\n# (attavo.report), acts at most once -- recovers a dead or hung\\n# invocation, or starts the next stage in a detached worker -- and\\n# returns within seconds; the stage itself runs in `attavo worker`, a\\n# child of the pass's own session, which outlives it. Writes no record of\\n# its own: the stage records already on disk, and the invocation markers\\n# and heartbeats beside them, are the only state a pass or a worker\\n# reads. ---\\n\\n\\ndef commit_record(root: Path, record_paths: Path | list[Path], message: str) -> None:\\n    \\\"\\\"\\\"`git commit --only` on every record path given, and each one's .log\\n    and .filed, each if one exists -- never the whole index. A transport\\n    commit that sweeps the index is exactly the regression issue #46\\n    already guards build and verify against on the adapter side; drive\\n    must not reintroduce it on the transport side. The .filed marker\\n    (issue #89) is committed alongside the record it names, in the same\\n    commit and the same push, so a second worktree or a fresh clone reads\\n    the same filed fact rather than refiling every stop it finds with no\\n    marker of its own. A single Path is accepted for the common one-record\\n    case; issue #100 passes a list so the counsel record lands in the same\\n    commit as the stage record it counsels. Authored and committed as\\n    driver_identity(), set by the product and never the tenant's git\\n    config, so a driven item's record commits are never indistinguishable\\n    from an operator's own.\\\"\\\"\\\"\\n    if isinstance(record_paths, Path):\\n        record_paths = [record_paths]\\n    paths: list[str] = []\\n    for record_path in record_paths:\\n        paths.append(str(record_path.relative_to(root)))\\n        log_path = record_path.with_suffix(\\\".log\\\")\\n        if log_path.is_file():\\n            paths.append(str(log_path.relative_to(root)))\\n        marker_path = record_path.with_suffix(\\\".filed\\\")\\n        if marker_path.is_file():\\n            paths.append(str(marker_path.relative_to(root)))\\n    identity = driver_identity()\\n    env = dict(os.environ)\\n    env[\\\"GIT_AUTHOR_NAME\\\"] = identity[\\\"name\\\"]\\n    env[\\\"GIT_AUTHOR_EMAIL\\\"] = identity[\\\"email\\\"]\\n    env[\\\"GIT_COMMITTER_NAME\\\"] = identity[\\\"name\\\"]\\n    env[\\\"GIT_COMMITTER_EMAIL\\\"] = identity[\\\"email\\\"]\\n    git(root, \\\"add\\\", *paths)\\n    git(root, \\\"commit\\\", \\\"--only\\\", \\\"-m\\\", message, *paths, env=env)\\n\\n\\ndef push_record_commit(root: Path, branch: str) -> tuple[bool, str | None]:\\n    \\\"\\\"\\\"Push HEAD to branch on origin. A push a divergent remote rejects is\\n    retried once after `git pull --no-rebase --no-edit origin branch` -- a\\n    merge, never a rebase, because a rebase would change the sha the record\\n    commit just wrote already names. This is the record push's own retry\\n    -- the worker's, once it has the lease -- distinct from push_lease\\n    below, which never retries.\\\"\\\"\\\"\\n    def attempt() -> tuple[bool, str]:\\n        run = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"push\\\", \\\"origin\\\", f\\\"HEAD:{branch}\\\"],\\n                             capture_output=True, text=True, check=False)\\n        return run.returncode == 0, run.stderr.strip()\\n\\n    ok, err = attempt()\\n    if ok:\\n        return True, None\\n    pull = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"pull\\\", \\\"--no-rebase\\\", \\\"--no-edit\\\",\\n                           \\\"origin\\\", branch], capture_output=True, text=True, check=False)\\n    if pull.returncode != 0:\\n        return False, f\\\"push rejected and the retry merge failed: {pull.stderr.strip() or err}\\\"\\n    ok, err = attempt()\\n    if not ok:\\n        return False, f\\\"push rejected again after merging {branch}: {err}\\\"\\n    return True, None\\n\\n\\n_RACE_MARKERS = (\\\"non-fast-forward\\\", \\\"fetch first\\\", \\\"stale info\\\", \\\"cannot lock ref\\\",\\n                 \\\"failed to update ref\\\")\\n\\n\\ndef push_lease(root: Path, branch: str) -> tuple[str, str | None]:\\n    \\\"\\\"\\\"Push HEAD to branch on origin as a plain fast-forward -- no merge,\\n    no retry: this is the lease the marker commit takes on the attempt it\\n    names (ruling A). (\\\"pushed\\\", None) on success.\\n\\n    (\\\"lost-race\\\", stderr) when git's own ref check is what rejected it --\\n    the branch moved since this pass fast-forwarded to it (a sequential\\n    \\\"[rejected] ... (fetch first)\\\"), or the remote's own ref transaction\\n    lost a genuine simultaneous push (\\\"[remote rejected] ... (failed to\\n    update ref)\\\", \\\"cannot lock ref\\\"): either way, another pass's own\\n    marker (or record) landed there first. The pass that reads this is\\n    the loser: it says so, resets its own marker commit, and starts\\n    nothing.\\n\\n    (\\\"refused\\\", stderr) for every other rejection -- a remote that\\n    refuses the push outright (a hook, a permission, an unreachable\\n    remote). This is not a race for the lease; it is a refusal, and ends\\n    the pass with exit 1.\\\"\\\"\\\"\\n    run = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"push\\\", \\\"origin\\\", f\\\"HEAD:{branch}\\\"],\\n                         capture_output=True, text=True, check=False)\\n    if run.returncode == 0:\\n        return \\\"pushed\\\", None\\n    stderr = run.stderr\\n    if any(marker in stderr for marker in _RACE_MARKERS):\\n        return \\\"lost-race\\\", stderr.strip()\\n    return \\\"refused\\\", stderr.strip()\\n\\n\\ndef has_origin(root: Path) -> bool:\\n    \\\"\\\"\\\"Whether this checkout carries an origin remote at all -- a fixture\\n    or a scratch checkout with none is not a refusal; a pass commits\\n    locally and skips the push, the way recovery always has.\\\"\\\"\\\"\\n    try:\\n        git(root, \\\"remote\\\", \\\"get-url\\\", \\\"origin\\\")\\n        return True\\n    except RuntimeError:\\n        return False\\n\\n\\ndef drive_state(root: Path, m: dict[str, Any], item_id: str) -> tuple[str, str | None, Path]:\\n    \\\"\\\"\\\"(\\\"no-approval\\\" | \\\"build\\\" | \\\"verify\\\" | \\\"ready\\\", detail, records_dir):\\n    the next mechanical step for item_id, read from its latest records\\n    alone. A build only counts as current when it is a pass bound to the\\n    valid approval's own sha; a verify only counts as current when it is a\\n    pass bound to that build's own sha -- the same staleness a re-approval\\n    or a re-build must force, attest's own chain check already enforces\\n    (check_attest_chain), read here rather than re-typed.\\\"\\\"\\\"\\n    records_rel = m[\\\"paths\\\"][\\\"records\\\"]\\n    records_dir = root / records_rel / item_id\\n\\n    status = approval_status(root, m, item_id)\\n    if status != \\\"valid\\\":\\n        return \\\"no-approval\\\", status, records_dir\\n\\n    latest_approval = latest_record(records_dir, \\\"approval\\\")\\n    latest_build = latest_record(records_dir, \\\"build\\\")\\n    build_current = (latest_build is not None and latest_build.get(\\\"status\\\") == \\\"pass\\\"\\n                     and latest_build.get(\\\"approval_sha\\\")\\n                     == (latest_approval.get(\\\"sha\\\") if latest_approval else None))\\n    if latest_build is None or not build_current:\\n        return \\\"build\\\", None, records_dir\\n\\n    latest_verify = latest_record(records_dir, \\\"verify\\\")\\n    verify_current = (latest_verify is not None and latest_verify.get(\\\"status\\\") == \\\"pass\\\"\\n                      and latest_verify.get(\\\"build_sha\\\") == latest_build.get(\\\"sha\\\"))\\n    if not verify_current:\\n        return \\\"verify\\\", None, records_dir\\n\\n    return \\\"ready\\\", None, records_dir\\n\\n\\n# --- the heartbeat, the worker log, and the forge-checks handoff: local\\n# facts under the checkout's own git directory (issue #140's precedent),\\n# never committed and never among the paths commit_record ever names. ---\\n\\ndef heartbeat_s() -> float:\\n    return float(os.environ.get(\\\"ATTAVO_HEARTBEAT_S\\\", 15))\\n\\n\\ndef heartbeat_path(root: Path, stage: str, nn: int) -> Path:\\n    return stage_events_dir(root) / f\\\"{stage}-{nn:02d}.heartbeat\\\"\\n\\n\\ndef worker_log_path(root: Path, stage: str, nn: int) -> Path:\\n    return stage_events_dir(root) / f\\\"{stage}-{nn:02d}.worker.log\\\"\\n\\n\\ndef forge_checks_path(root: Path, stage: str, nn: int) -> Path:\\n    return stage_events_dir(root) / f\\\"{stage}-{nn:02d}.forge-checks.json\\\"\\n\\n\\ndef _events_path_for(root: Path, stage: str, nn: int) -> Path | None:\\n    \\\"\\\"\\\"The adapter's own events file for this invocation, under the\\n    checkout's git dir (a worktree's own dir when the checkout is one).\\\"\\\"\\\"\\n    try:\\n        gitdir = Path(git(root, \\\"rev-parse\\\", \\\"--git-dir\\\").strip())\\n    except RuntimeError:\\n        return None\\n    if not gitdir.is_absolute():\\n        gitdir = root / gitdir\\n    path = gitdir / \\\"attavo\\\" / f\\\"{stage}-{nn:02d}.events.jsonl\\\"\\n    return path if path.is_file() else None\\n\\n\\ndef _events_tail(path: Path | None, lines: int = 20) -> tuple[str, str | None]:\\n    \\\"\\\"\\\"(the last lines as a log, the last event's own at).\\\"\\\"\\\"\\n    if path is None:\\n        return \\\"no events file for this invocation\\\\n\\\", None\\n    try:\\n        text = path.read_text()\\n    except OSError:\\n        return \\\"events file unreadable\\\\n\\\", None\\n    tail = text.splitlines()[-lines:]\\n    last_at = None\\n    for line in reversed(tail):\\n        parsed = _parse_json_line(line)\\n        if not isinstance(parsed, dict):\\n            continue\\n        at = parsed.get(\\\"at\\\")\\n        if isinstance(at, str):\\n            last_at = at\\n            break\\n    return \\\"\\\\n\\\".join(tail) + \\\"\\\\n\\\", last_at\\n\\n\\ndef _seconds_since(at: str | None) -> float | None:\\n    from datetime import datetime, timezone\\n    if not at:\\n        return None\\n    try:\\n        then = datetime.strptime(at, \\\"%Y-%m-%dT%H:%M:%SZ\\\").replace(tzinfo=timezone.utc)\\n    except ValueError:\\n        return None\\n    return (datetime.now(timezone.utc) - then).total_seconds()\\n\\n\\nclass InvocationReading(NamedTuple):\\n    \\\"\\\"\\\"What one marker with no record reads as, from here and now.\\\"\\\"\\\"\\n    stage: str\\n    nn: int\\n    log: str\\n    last_at: str | None\\n    age: float | None\\n    cls: str  # \\\"running\\\" | \\\"hung\\\" | \\\"died\\\"\\n    bound: str | None = None  # R3: \\\"stall\\\" or \\\"ceiling\\\" when cls is \\\"hung\\\"\\n\\n\\ndef read_invocation(root: Path, bound: int | None, marker: Path, info: dict[str, Any]) -> InvocationReading:\\n    \\\"\\\"\\\"Whether an invocation that began and wrote no record is running,\\n    hung, or died -- read from its own heartbeat first (R2): a heartbeat\\n    file fresh within three beats of ATTAVO_HEARTBEAT_S is alive; a stale\\n    one is died, whether or not the pid still lives -- a worker stuck\\n    somewhere that never reaches its own heartbeat loop again is exactly\\n    what this is for. Only with no heartbeat file at all -- an invocation\\n    from before this release, or one that died before touching its\\n    first beat -- does this fall back to the pid: alive and, with a\\n    stall bound declared, past it is hung; alive with no bound, or\\n    within it, is running for as long as it lives; not alive is died.\\n    The stall bound decides hung, never died.\\\"\\\"\\\"\\n    stage, nn_text = marker.stem.rsplit(\\\"-\\\", 1)\\n    nn = int(nn_text)\\n    log, last_at = _events_tail(_events_path_for(root, stage, nn))\\n    # R3: the stage ceiling, wall clock from the marker's own `at`, judged\\n    # before any liveness signal -- alive past it is hung by the ceiling,\\n    # whatever its event age (or absence of one) says.\\n    m = read_manifest(root) or {}\\n    ceiling = ceiling_s(m, stage)\\n    since_start = _seconds_since(info.get(\\\"at\\\"))\\n    if ceiling is not None and since_start is not None and since_start > ceiling:\\n        return InvocationReading(stage, nn, log, last_at, since_start, \\\"hung\\\", \\\"ceiling\\\")\\n    if not _streams_events(root, m, stage):\\n        # An adapter that declares it streams no events is judged by the\\n        # ceiling alone; the stall bound it can never trip is not asked.\\n        bound = None\\n    beat = heartbeat_path(root, stage, nn)\\n    if beat.is_file():\\n        try:\\n            beat_age = time.time() - beat.stat().st_mtime\\n        except OSError:\\n            beat_age = None\\n        cls = \\\"running\\\" if beat_age is not None and beat_age <= heartbeat_s() * 3 else \\\"died\\\"\\n        return InvocationReading(stage, nn, log, last_at, beat_age, cls)\\n    age = _seconds_since(last_at or info.get(\\\"at\\\"))\\n    if not invocation_alive(info):\\n        return InvocationReading(stage, nn, log, last_at, age, \\\"died\\\")\\n    if bound is None or age is None or age <= bound:\\n        return InvocationReading(stage, nn, log, last_at, age, \\\"running\\\")\\n    return InvocationReading(stage, nn, log, last_at, age, \\\"hung\\\", \\\"stall\\\")\\n\\n\\ndef _streams_events(root: Path, m: dict[str, Any], stage: str) -> bool:\\n    \\\"\\\"\\\"R3: whether the stage's adapter declares it streams events\\n    (adapters/<name>/conformance.json, \\\"streams_events\\\"); true when the\\n    adapter names none, or its conformance.json does not say.\\\"\\\"\\\"\\n    name = (m.get(\\\"executor\\\") or {}).get(stage) or (m.get(\\\"executor\\\") or {}).get(\\\"build\\\")\\n    if not name:\\n        return True\\n    for base in (root / \\\"attavo\\\" / \\\"adapters\\\", PRODUCT_ROOT / \\\"adapters\\\"):\\n        conf = base / name / \\\"conformance.json\\\"\\n        if conf.is_file():\\n            try:\\n                return bool(json.loads(conf.read_text()).get(\\\"streams_events\\\", True))\\n            except (OSError, ValueError):\\n                return True\\n    return True\\n\\n\\ndef uncommitted_record(root: Path, records_dir: Path, stage: str) -> Path | None:\\n    \\\"\\\"\\\"The latest <stage>-NN.json this working tree carries that git has\\n    no commit for yet -- the moment between a worker's write and its own\\n    commit. None when the latest record is already committed, or there\\n    is none at all.\\\"\\\"\\\"\\n    path = latest_attempt_path(records_dir, stage)\\n    if path is None or not path.is_file():\\n        return None\\n    status = subprocess.run(\\n        [\\\"git\\\", \\\"-C\\\", str(root), \\\"status\\\", \\\"--porcelain\\\", \\\"--\\\", str(path.relative_to(root))],\\n        capture_output=True, text=True, check=False)\\n    return path if status.stdout.strip() else None\\n\\n\\ndef worker_holds_copy(root: Path, records_dir: Path) -> bool:\\n    \\\"\\\"\\\"True when this checkout's own working tree cannot safely be moved\\n    -- an invocation marker with no record yet (a worker, here or\\n    elsewhere, still holds this attempt), or a build or verify record the\\n    working tree carries that git has not committed yet. Scoped to the\\n    stage records a pass or a worker itself ever transports -- an\\n    operator's own spec-gate or approve, routinely uncommitted between\\n    their own act and the next pass, is not this. A pass never\\n    fast-forwards while this holds (never while a worker holds the\\n    copy).\\\"\\\"\\\"\\n    if invocations_without_record(records_dir):\\n        return True\\n    return (uncommitted_record(root, records_dir, \\\"build\\\") is not None\\n           or uncommitted_record(root, records_dir, \\\"verify\\\") is not None)\\n\\n\\ndef fast_forward_to_origin(root: Path, m: dict[str, Any], item_id: str) -> None:\\n    \\\"\\\"\\\"The pass's own read of origin's branch, taken before it reads\\n    anything else -- a commit landed there from elsewhere (an approval\\n    from the screen, a ruling, another pass's own record) is not a race\\n    for the lease, it is exactly what the lease is for. Never while a\\n    worker holds this copy (worker_holds_copy): resetting a working tree\\n    a detached child is still writing into would corrupt its own commits.\\n    A plain fast-forward when origin is simply ahead; when this checkout\\n    also carries its own commits origin has not seen yet (an operator's\\n    approval, not yet pushed), those are replayed on top of origin's own\\n    tip instead -- no merge commit, and the marker this pass is about to\\n    write still lands as a fast-forward when it pushes. Silent about\\n    everything short of that -- a real conflict, or an absent origin, is\\n    left for the ordinary read (and the marker push, for the lease) to\\n    sort out.\\\"\\\"\\\"\\n    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n    if worker_holds_copy(root, records_dir) or not has_origin(root):\\n        return\\n    try:\\n        branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n        git(root, \\\"fetch\\\", \\\"origin\\\", branch)\\n    except RuntimeError:\\n        return\\n    try:\\n        git(root, \\\"merge\\\", \\\"--ff-only\\\", \\\"FETCH_HEAD\\\")\\n        return\\n    except RuntimeError:\\n        pass\\n    try:\\n        git(root, \\\"rebase\\\", \\\"FETCH_HEAD\\\")\\n    except RuntimeError:\\n        subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"rebase\\\", \\\"--abort\\\"],\\n                       capture_output=True, text=True, check=False)\\n\\n\\n# --- the worker: a detached child of the pass's own session, running the\\n# stage exactly as the pass used to inline, touching its own heartbeat\\n# while it does (R2). ---\\n\\ndef _stage_body(item_id: str, stage: str, nn: int) -> int:\\n    \\\"\\\"\\\"Runs build or verify in-process -- the same command `attavo build`\\n    or `attavo verify` would run -- while touching heartbeat_path every\\n    heartbeat_s() seconds, then transports whatever it wrote: counsel and\\n    file-stops on a non-pass record (issue #100, #89), one `git commit\\n    --only`, one push with the record push's own merge retry. The\\n    marker is the pass's, already committed and pushed before this\\n    starts; this writes and transports only the stage's own record (and,\\n    on a stop, its counsel record).\\\"\\\"\\\"\\n    root = Path(\\\".\\\").resolve()\\n    m = read_manifest(root)\\n    if m is None:\\n        return 2\\n    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n    before = latest_attempt_path(records_dir, stage)\\n\\n    beat = heartbeat_path(root, stage, nn)\\n    beat.parent.mkdir(parents=True, exist_ok=True)\\n    beat.touch()\\n    stop_beat = threading.Event()\\n\\n    def _tick() -> None:\\n        while not stop_beat.wait(heartbeat_s()):\\n            beat.touch()\\n\\n    beat_thread = threading.Thread(target=_tick, daemon=True)\\n    beat_thread.start()\\n    try:\\n        rc = cmd_build([item_id]) if stage == \\\"build\\\" else cmd_verify([item_id])\\n    finally:\\n        stop_beat.set()\\n        beat_thread.join()\\n\\n    after = latest_attempt_path(records_dir, stage)\\n    if after is None or after == before:\\n        # Refused before writing anything at all (e.g. no adapter\\n        # configured) -- the stage command already printed why.\\n        return rc if rc != 0 else 1\\n\\n    record = cast(dict[str, Any], latest_record(records_dir, stage))\\n    status_out = record.get(\\\"status\\\")\\n    to_commit = [after]\\n    if status_out != \\\"pass\\\":\\n        # R3: a retryable family (died, hung, transient, returned) asks\\n        # counsel nothing while its budget still has an attempt to\\n        # spend -- the next pass retries it plainly. Once its budget is\\n        # spent, or its last two signatures match, counsel is read once\\n        # more, its sentence carried beside the exhaustion report, never\\n        # instead of it. Every other class is counsel's to read on every\\n        # stop, as before this item.\\n        stop_class = (record.get(\\\"stop\\\") or {}).get(\\\"class\\\")\\n        budget_stage = \\\"build\\\" if stop_class == \\\"returned\\\" else stage\\n        ask_counsel = (stop_class not in RETRYABLE_CLASSES\\n                      or stage_exhausted(records_dir, m, stage, budget_stage))\\n        counsel_before = latest_attempt_path(records_dir, \\\"counsel\\\")\\n        if ask_counsel:\\n            cmd_counsel([item_id])\\n        counsel_after = latest_attempt_path(records_dir, \\\"counsel\\\")\\n        if counsel_after is not None and counsel_after != counsel_before:\\n            to_commit.append(counsel_after)\\n        # file-stops is its own idempotent read of the item's records, so\\n        # calling it here on every run that wrote a non-pass record is\\n        # safe to call again on a later run: an already-filed stop's own\\n        # marker is what stops it from being filed twice.\\n        cmd_file_stops([item_id])\\n\\n    message = f\\\"attavo: {stage} record for item {item_id} ({after.stem})\\\"\\n    try:\\n        commit_record(root, to_commit, message)\\n    except RuntimeError as exc:\\n        print(f\\\"attavo drive: stopped: could not commit the {stage} record: {exc}\\\")\\n        return 1\\n\\n    if has_origin(root):\\n        ok, err = push_record_commit(root, branch)\\n        if not ok:\\n            print(f\\\"attavo drive: stopped: could not push the {stage} record: {err}\\\")\\n            return 1\\n    else:\\n        print(f\\\"attavo drive: note: no origin remote; {after.name} is committed, not pushed\\\")\\n\\n    if status_out == \\\"halted\\\":\\n        question = (record.get(\\\"halted\\\") or {}).get(\\\"question\\\")\\n        print(f\\\"attavo drive: stopped: {stage} halted: {question} ({after.name}); \\\"\\n              f\\\"pushed to {branch}\\\")\\n    elif status_out != \\\"pass\\\":\\n        reason = record.get(\\\"refusal\\\") or status_out\\n        print(f\\\"attavo drive: stopped: {stage} {status_out}: {reason} ({after.name}); \\\"\\n              f\\\"pushed to {branch}\\\")\\n    else:\\n        print(f\\\"attavo drive: pushed {after.name} to {branch}\\\")\\n    return rc\\n\\n\\ndef cmd_worker(argv: list[str]) -> int:\\n    \\\"\\\"\\\"`attavo worker N <build|verify> NN`: the detached child a pass\\n    starts once its marker is pushed -- the lease held, the attempt is\\n    this worker's to run. Its own session (start_new_session, set by the\\n    pass that spawns it); its stdout and stderr are the pass's own\\n    redirect, to <git-dir>/attavo/<stage>-NN.worker.log.\\\"\\\"\\\"\\n    cast(io.TextIOWrapper, sys.stdout).reconfigure(line_buffering=True)\\n    if len(argv) != 3:\\n        print(\\\"attavo worker: usage: attavo worker N <build|verify> NN\\\", file=sys.stderr)\\n        return 2\\n    item_id, stage, nn_text = argv\\n    if stage not in (\\\"build\\\", \\\"verify\\\"):\\n        print(f\\\"attavo worker: {stage!r} is not build or verify\\\", file=sys.stderr)\\n        return 2\\n    try:\\n        nn = int(nn_text)\\n    except ValueError:\\n        print(f\\\"attavo worker: {nn_text!r} is not an attempt number\\\", file=sys.stderr)\\n        return 2\\n    return _stage_body(item_id, stage, nn)\\n\\n\\n# --- the pass's own two acts: start a stage (the lease), and recover\\n# exactly the one invocation the report names owed one. ---\\n\\ndef _start_stage(root: Path, m: dict[str, Any], item_id: str, stage: str,\\n                 forge_checks: dict[str, Any] | None, *, again_by: bool = False) -> int:\\n    \\\"\\\"\\\"The lease (ruling A): the marker, committed and pushed as a plain\\n    fast-forward with no merge and no retry (push_lease). Lost to another\\n    pass, or refused outright by the remote, both undo the marker commit\\n    here (git reset --hard) so this checkout carries no half-taken\\n    attempt either way; only a pushed lease starts the worker. On a\\n    review, forge_checks is the checks this same pass already read on\\n    the pre-marker head (ruling B) -- written to\\n    <git-dir>/attavo/verify-NN.forge-checks.json and named in\\n    ATTAVO_FORGE_CHECKS, so the worker's own `attavo verify` reads it\\n    instead of polling. R3: again_by names the marker as `--again`'s own\\n    act on a stage whose budget was already spent.\\\"\\\"\\\"\\n    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n    nn = next_attempt_number(records_dir, stage)\\n    marker = write_invocation_marker(root, records_dir, stage, nn, again_by=again_by)\\n    try:\\n        commit_record(root, [marker], f\\\"attavo: {stage} invocation {nn:02d} started for item {item_id}\\\")\\n    except RuntimeError as exc:\\n        print(f\\\"attavo drive: stopped: could not commit the {stage} invocation marker: {exc}\\\")\\n        return 1\\n\\n    if has_origin(root):\\n        outcome, err = push_lease(root, branch)\\n        if outcome != \\\"pushed\\\":\\n            git(root, \\\"reset\\\", \\\"--hard\\\", \\\"HEAD^\\\")\\n            if outcome == \\\"lost-race\\\":\\n                print(f\\\"attavo drive: another pass holds this attempt ({marker.name}); nothing started\\\")\\n                return 0\\n            print(f\\\"attavo drive: stopped: could not push the {stage} invocation marker: {err}\\\")\\n            return 1\\n\\n    env = dict(os.environ)\\n    if forge_checks is not None:\\n        checks_file = forge_checks_path(root, stage, nn)\\n        checks_file.write_text(json.dumps(forge_checks))\\n        env[\\\"ATTAVO_FORGE_CHECKS\\\"] = str(checks_file)\\n    log = worker_log_path(root, stage, nn)\\n    with log.open(\\\"ab\\\") as fh, open(os.devnull, \\\"rb\\\") as devnull:\\n        proc = subprocess.Popen(\\n            [sys.executable, str(PRODUCT_ROOT / \\\"bin\\\" / \\\"attavo\\\"), \\\"worker\\\", item_id, stage, f\\\"{nn:02d}\\\"],\\n            cwd=str(root), env=env, stdin=devnull, stdout=fh, stderr=subprocess.STDOUT,\\n            start_new_session=True)\\n    word = \\\"Build\\\" if stage == \\\"build\\\" else \\\"Review\\\"\\n    print(f\\\"attavo drive: {word} started (attempt {nn:02d}, worker pid {proc.pid})\\\")\\n    return 0\\n\\n\\ndef _recover_one(root: Path, m: dict[str, Any], item_id: str, records_dir: Path) -> int:\\n    \\\"\\\"\\\"The pass's own recovery act (what `--recover` did): exactly the one\\n    invocation the report just read as owing one -- died or hung -- ends\\n    here. class died when the heartbeat is stale (or absent and the pid\\n    is gone), class hung when there is no heartbeat, the pid lives, and a\\n    declared [drive].stall_after_s has passed with no newer event, and\\n    terminated. Provenance product; the events tail as the log. Committed\\n    and pushed the way any stage record is (push_record_commit, with its\\n    own merge retry) -- this is not a race for a lease, since no new\\n    attempt marker is written.\\\"\\\"\\\"\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n    bound = stall_bound_s(m)\\n    pending = invocations_without_record(records_dir)\\n    readings = [(marker, info, read_invocation(root, bound, marker, info)) for marker, info in pending]\\n    candidate = next(((mk, i, rd) for mk, i, rd in readings if rd.cls != \\\"running\\\"), None)\\n    if candidate is None:\\n        # The report read this a moment ago; nothing owed recovery by the\\n        # time this pass got here (another pass recovered it, or it\\n        # finished on its own).\\n        return 0\\n    marker, info, reading = candidate\\n    stage, nn, log, last_at, age, cls, crossed = reading\\n    pid, host = info.get(\\\"pid\\\"), info.get(\\\"host\\\")\\n\\n    if next_attempt_number(records_dir, stage) != nn:\\n        print(f\\\"attavo drive: stopped: {marker.name} names attempt {nn} but the next \\\"\\n              f\\\"{stage} record would be {next_attempt_number(records_dir, stage):02d}; \\\"\\n              f\\\"a later record already exists, read the records before recovering\\\")\\n        return 1\\n\\n    if cls == \\\"hung\\\":\\n        try:\\n            os.kill(cast(int, pid), signal.SIGTERM)\\n            ended = \\\"terminated\\\"\\n        except OSError as exc:\\n            ended = f\\\"not terminated ({exc})\\\"\\n        if crossed == \\\"ceiling\\\":\\n            detail = (f\\\"pid {pid} on {host} alive {int(cast(float, age))} s after its marker, past \\\"\\n                      f\\\"the {stage} ceiling of {ceiling_s(m, stage)} s; {ended}\\\")\\n        else:\\n            detail = (f\\\"pid {pid} on {host} alive with no event for {int(cast(float, age))} s \\\"\\n                      f\\\"(bound {bound} s); {ended}\\\")\\n    else:\\n        detail = (f\\\"pid {pid} on {host} is not running and wrote no {marker.stem}.json; \\\"\\n                  f\\\"started {info.get('at')}, last event {last_at or 'none'}\\\")\\n\\n    schema = stage_schema(stage)\\n    record: dict[str, Any] = {k: None for k in schema.get(\\\"required\\\", [])}\\n    approval = latest_record(records_dir, \\\"approval\\\")\\n    signature_source = log.strip().splitlines()[-1] if log.strip() else detail\\n    record.update({\\\"sha\\\": info.get(\\\"sha\\\"), \\\"start_sha\\\": info.get(\\\"sha\\\"),\\n                   \\\"approval_sha\\\": approval.get(\\\"sha\\\") if approval else None,\\n                   \\\"at\\\": info.get(\\\"at\\\"),\\n                   \\\"adapter\\\": (m.get(\\\"executor\\\") or {}).get(stage),\\n                   \\\"status\\\": \\\"failed\\\", \\\"refusal\\\": None, \\\"halted\\\": None,\\n                   \\\"retry_of\\\": None, \\\"steer\\\": None,\\n                   \\\"stop\\\": {\\\"class\\\": cls, \\\"provenance\\\": \\\"product\\\", \\\"detail\\\": detail,\\n                            \\\"signature\\\": signature_of(signature_source), \\\"bound\\\": crossed}})\\n    if \\\"wall_clock_s\\\" in record:\\n        record[\\\"wall_clock_s\\\"] = None if age is None else int(age)\\n    record = {k: v for k, v in record.items() if k in schema.get(\\\"properties\\\", {})}\\n    try:\\n        path = write_record(records_dir, stage, record, m, item_id, log=log)\\n    except ValueError as exc:\\n        print(f\\\"attavo drive: stopped: could not write the {cls} record for {marker.stem}: {exc}\\\")\\n        return 1\\n    try:\\n        commit_record(root, [path], f\\\"attavo: {stage} record for item {item_id} \\\"\\n                                    f\\\"({path.stem}), recovered as {cls}\\\")\\n    except RuntimeError as exc:\\n        print(f\\\"attavo drive: stopped: could not commit the {cls} record: {exc}\\\")\\n        return 1\\n    if has_origin(root):\\n        ok, err = push_record_commit(root, branch)\\n        if not ok:\\n            print(f\\\"attavo drive: stopped: could not push the {cls} record: {err}\\\")\\n            return 1\\n    else:\\n        print(f\\\"attavo drive: note: no origin remote; {path.name} is committed, not pushed\\\")\\n    print(f\\\"attavo drive: recovered {marker.stem} as {cls}: {detail}\\\")\\n    return 0\\n\\n\\ndef _advance_again(root: Path, m: dict[str, Any], item_id: str, stage: str, head: str | None, *,\\n                   again_by: bool = False) -> int:\\n    \\\"\\\"\\\"The next attempt of a stopped stage: exactly what next-build or\\n    next-review would do, bypassing the level a plain pass leaves alone\\n    for the operator -- the pass's own automatic retry of a retryable\\n    family, or `--again`'s act once a budget is spent (again_by). A\\n    review reads the forge fresh here -- once, since the report's own\\n    stopped reading never touched it -- rather than reusing a read that\\n    was never taken.\\\"\\\"\\\"\\n    if stage == \\\"build\\\":\\n        return _start_stage(root, m, item_id, \\\"build\\\", None, again_by=again_by)\\n    checks_command = (m.get(\\\"forge\\\") or {}).get(\\\"checks_command\\\")\\n    if not checks_command:\\n        print(\\\"attavo drive: refused: no [forge].checks_command in the manifest\\\")\\n        return 1\\n    forge_checks, ok = read_forge_checks(root, checks_command, cast(str, head))\\n    if not ok:\\n        conclusions = forge_checks[\\\"conclusions\\\"]\\n        named = \\\", \\\".join(f\\\"{c['name']} {c['conclusion']}\\\" for c in conclusions) or \\\"no checks reported\\\"\\n        print(f\\\"attavo drive: forge checks not green on {cast(str, head)[:12]}: {named}\\\")\\n        return 0\\n    return _start_stage(root, m, item_id, \\\"verify\\\", forge_checks, again_by=again_by)\\n\\n\\ndef _retry_target(r: \\\"DriveReport\\\") -> str:\\n    \\\"\\\"\\\"The stage the next attempt actually starts: class \\\"returned\\\" (a\\n    build's head a check rejected, or a review's own blocking finding) is\\n    always the verify record's own stop, but the retry it starts is the\\n    next build.\\\"\\\"\\\"\\n    return \\\"build\\\" if r[\\\"stop_class\\\"] == \\\"returned\\\" else cast(str, r[\\\"stage\\\"])\\n\\n\\ndef _retry_due(root: Path, m: dict[str, Any], item_id: str, r: \\\"DriveReport\\\") -> bool:\\n    \\\"\\\"\\\"R3: a stopped stage whose class is one of the four retryable\\n    families, whose budget is not spent, whose last two signatures\\n    differ, and -- for transient -- whose record has aged past\\n    [drive].retry_after_s, is retried by the next plain pass, no\\n    counsel, no operator act.\\\"\\\"\\\"\\n    if r[\\\"stop_class\\\"] not in RETRYABLE_CLASSES:\\n        return False\\n    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n    sig_stage = cast(str, r[\\\"stage\\\"])\\n    budget_stage = _retry_target(r)\\n    if stage_exhausted(records_dir, m, sig_stage, budget_stage):\\n        return False\\n    if r[\\\"stop_class\\\"] == \\\"transient\\\":\\n        attempts = parse_attempts(records_dir, sig_stage)\\n        latest = attempts[max(attempts)] if attempts else {}\\n        age = _seconds_since(latest.get(\\\"at\\\"))\\n        if age is None or age < retry_after_s(m):\\n            return False\\n    return True\\n\\n\\ndef _handle_again(root: Path, m: dict[str, Any], item_id: str, r: \\\"DriveReport\\\") -> int:\\n    \\\"\\\"\\\"`--again`'s own act on a stopped stage (R3): a retryable family\\n    whose budget is not spent is left to the pass's own automatic retry\\n    -- a no-op here, saying so -- since starting it twice would spend two\\n    attempts on one press. A retryable family whose budget is spent, or\\n    any other stopped class, starts the next attempt at once, its marker\\n    naming --again as what started it.\\\"\\\"\\\"\\n    stage = _retry_target(r)\\n    if r[\\\"stop_class\\\"] in RETRYABLE_CLASSES:\\n        records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n        if not stage_exhausted(records_dir, m, cast(str, r[\\\"stage\\\"]), stage):\\n            print(\\\"attavo drive: --again is a no-op inside the budget; the pass retries on its own\\\")\\n            return 0\\n    return _advance_again(root, m, item_id, stage, r[\\\"head\\\"], again_by=True)\\n\\n\\ndef _counsel_answered(records_dir: Path, r: \\\"DriveReport\\\") -> bool:\\n    \\\"\\\"\\\"R3: whether the stop this report just read as \\\"stopped\\\" already\\n    carries counsel's own \\\"answer\\\" verdict -- every non-retryable class\\n    is counsel's to read (as before this item), and `answer` starts the\\n    next attempt with the answer as its steer, read from the feedback\\n    file the retried attempt's own first iteration is handed\\n    (attavo.build._retry_seed).\\\"\\\"\\\"\\n    if r[\\\"stop_class\\\"] in RETRYABLE_CLASSES or not r[\\\"stage\\\"] or r[\\\"attempt\\\"] is None:\\n        return False\\n    counsel = counsel_record_for(records_dir, r[\\\"stage\\\"], r[\\\"attempt\\\"])\\n    return counsel is not None and counsel.get(\\\"verdict\\\") == \\\"answer\\\"\\n\\n\\ndef _pass_once(root: Path, m: dict[str, Any], item_id: str, again: bool) -> tuple[int, \\\"DriveReport\\\"]:\\n    \\\"\\\"\\\"One pass: fast-forward to origin (never while a worker holds the\\n    copy), read the report, act at most once, return. The three acts,\\n    one per report state that is the product's move: owes-recovery\\n    recovers; next-build and next-review start their stage, handing a\\n    review the checks the report already read once on the pre-marker\\n    head; a concluded red check on a passed build's head (R3) is a\\n    returned review record, not a level, so the review starts the same\\n    way. On a stopped stage, `--again` always wins (a no-op inside the\\n    budget, the next attempt once it is spent); absent it, a retryable\\n    family retries on its own, and any other stop counsel has already\\n    answered starts the next attempt steered by that answer. Every other\\n    level is printed in the report's own words and left.\\\"\\\"\\\"\\n    from attavo.report import drive_report\\n    fast_forward_to_origin(root, m, item_id)\\n    r = drive_report(root, m, item_id)\\n\\n    if r[\\\"state\\\"] == \\\"owes-recovery\\\":\\n        records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n        return _recover_one(root, m, item_id, records_dir), r\\n    if r[\\\"state\\\"] == \\\"next-build\\\":\\n        return _start_stage(root, m, item_id, \\\"build\\\", None), r\\n    if r[\\\"state\\\"] == \\\"next-review\\\":\\n        checks_command = (m.get(\\\"forge\\\") or {}).get(\\\"checks_command\\\")\\n        forge_checks = {\\\"command\\\": checks_command, \\\"sha\\\": r[\\\"head\\\"], \\\"conclusions\\\": r[\\\"checks\\\"] or []}\\n        return _start_stage(root, m, item_id, \\\"verify\\\", forge_checks), r\\n    if r[\\\"state\\\"] == \\\"blocked-on-checks\\\" and r[\\\"stage\\\"] == \\\"verify\\\":\\n        # R3: the rejection is a record, not a level with nothing behind\\n        # it (#206's build-01) -- the review starts, reading the same\\n        # forge checks this pass just read, and writes the check\\n        # rejection itself as a returned record (attavo.verify.cmd_verify).\\n        checks_command = (m.get(\\\"forge\\\") or {}).get(\\\"checks_command\\\")\\n        forge_checks = {\\\"command\\\": checks_command, \\\"sha\\\": r[\\\"head\\\"], \\\"conclusions\\\": r[\\\"checks\\\"] or []}\\n        return _start_stage(root, m, item_id, \\\"verify\\\", forge_checks), r\\n    if r[\\\"state\\\"] == \\\"stopped\\\" and r[\\\"stage\\\"]:\\n        if again:\\n            return _handle_again(root, m, item_id, r), r\\n        records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n        if _retry_due(root, m, item_id, r):\\n            return _advance_again(root, m, item_id, _retry_target(r), r[\\\"head\\\"]), r\\n        if _counsel_answered(records_dir, r):\\n            return _advance_again(root, m, item_id, _retry_target(r), r[\\\"head\\\"]), r\\n\\n    print(f\\\"attavo drive: {r['says']}\\\")\\n    return (1 if r[\\\"state\\\"] == \\\"refused\\\" else 0), r\\n\\n\\n_TERMINAL_STATES = (\\\"waiting-on-approval\\\", \\\"stopped\\\", \\\"ready-to-merge\\\", \\\"merged\\\")\\n\\n\\ndef _until_ready(root: Path, m: dict[str, Any], item_id: str, again: bool) -> int:\\n    \\\"\\\"\\\"--until-ready: the pass, repeated in one process, sleeping\\n    ATTAVO_DRIVE_POLL_INTERVAL_S between passes, until the level is the\\n    operator's or done (exit 0), a concluded check is red (exit 1), or\\n    an unconcluded one has not concluded within ATTAVO_DRIVE_POLL_BOUND_S\\n    (exit 1). A stage running in its own worker is not bounded by this --\\n    only time spent waiting on the forge is.\\\"\\\"\\\"\\n    from attavo.verify import drive_forge_poll_bound_s, drive_forge_poll_interval_s\\n    bound = drive_forge_poll_bound_s()\\n    interval = drive_forge_poll_interval_s()\\n    waiting_since: float | None = None\\n    while True:\\n        rc, r = _pass_once(root, m, item_id, again)\\n        state = r[\\\"state\\\"]\\n\\n        if state == \\\"waiting-on-checks\\\":\\n            if waiting_since is None:\\n                waiting_since = time.monotonic()\\n            elif time.monotonic() - waiting_since >= bound:\\n                print(f\\\"attavo drive: stopped: the checks did not conclude within {bound:.0f}s\\\")\\n                return 1\\n        else:\\n            waiting_since = None\\n\\n        if rc != 0:\\n            return rc\\n        if state in _TERMINAL_STATES:\\n            return 0\\n        if state == \\\"blocked-on-checks\\\" and r[\\\"stage\\\"] != \\\"verify\\\":\\n            # R3: stage \\\"verify\\\" here is the pass's own act, just taken --\\n            # a concluded red check on a passed build's head is now a\\n            # returned review record (attavo.verify.cmd_verify), not a\\n            # level the loop gives up on with nothing behind it.\\n            return 1\\n        time.sleep(interval)\\n\\n\\ndef _drive_all() -> int:\\n    \\\"\\\"\\\"--all: one pass, in its own process, in every ../attavo-worktree-N\\n    beside this checkout -- each one derives its own item from its own\\n    attavo/N-* branch. Every line either prints is prefixed with the\\n    worktree's own directory name, so an operator reading them together\\n    can tell which item each line is about.\\\"\\\"\\\"\\n    root = Path(\\\".\\\").resolve()\\n    siblings = sorted(p for p in root.parent.glob(\\\"attavo-worktree-*\\\") if p.is_dir())\\n    if not siblings:\\n        print(\\\"attavo drive: --all found no ../attavo-worktree-N beside this checkout\\\")\\n        return 0\\n    worst = 0\\n    for copy in siblings:\\n        run = subprocess.run([sys.executable, str(PRODUCT_ROOT / \\\"bin\\\" / \\\"attavo\\\"), \\\"drive\\\"],\\n                             cwd=str(copy), capture_output=True, text=True, check=False)\\n        for line in (run.stdout + run.stderr).splitlines():\\n            print(f\\\"{copy.name}: {line}\\\")\\n        worst = max(worst, run.returncode)\\n    return worst\\n\\n\\ndef cmd_drive(argv: list[str]) -> int:\\n    # Issue #145: Python block-buffers stdout when it is not a tty (a\\n    # pipe, e.g. a screen reading this process live), so every line this\\n    # prints would otherwise sit unflushed until the process exits.\\n    # Line-buffering makes a pipe reader see each line the moment it is\\n    # printed, the same as a terminal already does; `attavo worker`\\n    # reconfigures its own stdout the same way.\\n    cast(io.TextIOWrapper, sys.stdout).reconfigure(line_buffering=True)\\n\\n    if \\\"--recover\\\" in argv:\\n        print(\\\"attavo drive: --recover is gone; a pass recovers a dead or hung invocation \\\"\\n              \\\"itself, as soon as the report owes one\\\", file=sys.stderr)\\n        return 2\\n\\n    until_ready = \\\"--until-ready\\\" in argv\\n    report = \\\"--report\\\" in argv\\n    again = \\\"--again\\\" in argv\\n    all_flag = \\\"--all\\\" in argv\\n    positional = [a for a in argv if not a.startswith(\\\"--\\\")]\\n\\n    if all_flag:\\n        if until_ready or report or again or positional:\\n            print(\\\"attavo drive: --all runs one pass in every worktree beside this checkout; \\\"\\n                  \\\"drop N and every other flag\\\", file=sys.stderr)\\n            return 2\\n        return _drive_all()\\n\\n    root = Path(\\\".\\\").resolve()\\n    item_id = positional[0] if positional else derive_item_id(root)\\n    if not item_id:\\n        print(\\\"attavo drive: cannot derive item id; pass N or run on an attavo/N-* branch\\\",\\n              file=sys.stderr)\\n        return 2\\n    m = read_manifest(root)\\n    if m is None:\\n        print(f\\\"attavo drive: no {MANIFEST} at {root}\\\", file=sys.stderr)\\n        return 2\\n\\n    if report:\\n        if until_ready or again:\\n            print(\\\"attavo drive: --report reads and does nothing else; drop --until-ready \\\"\\n                  \\\"and --again\\\", file=sys.stderr)\\n            return 2\\n        fast_forward_to_origin(root, m, item_id)\\n        from attavo.report import drive_report\\n        print(json.dumps(drive_report(root, m, item_id), indent=2))\\n        return 0\\n\\n    if until_ready:\\n        return _until_ready(root, m, item_id, again)\\n    rc, _ = _pass_once(root, m, item_id, again)\\n    return rc\\n\",\"structuredPatch\":[{\"oldStart\":314,\"oldLines\":14,\"newStart\":314,\"newLines\":10,\"lines\":[\"     name = (m.get(\\\"executor\\\") or {}).get(stage) or (m.get(\\\"executor\\\") or {}).get(\\\"build\\\")\",\"     if not name:\",\"         return True\",\"-    for base in (root / \\\"attavo\\\" / \\\"adapters\\\", PRODUCT_ROOT / \\\"adapters\\\"):\",\"-        conf = base / name / \\\"conformance.json\\\"\",\"-        if conf.is_file():\",\"-            try:\",\"-                return bool(json.loads(conf.read_text()).get(\\\"streams_events\\\", True))\",\"-            except (OSError, ValueError):\",\"-                return True\",\"-    return True\",\"+    adapter_path = resolve_adapter(root, name)\",\"+    if adapter_path is None:\",\"+        return True\",\"+    return bool(adapter_conformance(adapter_path).get(\\\"streams_events\\\", True))\",\" \",\" \",\" def uncommitted_record(root: Path, records_dir: Path, stage: str) -> Path | None:\"]}],\"userModified\":false,\"replaceAll\":false,\"contentNotInModelContext\":true}}\n3114:+{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01MtNxrx7SGSE6hnsWjhfCjX\",\"type\":\"tool_result\",\"content\":\"The file /Users/davidbean/Projects/attavo-worktree-219/attavo/drive.py has been updated successfully.\"}]},\"parent_tool_use_id\":null,\"session_id\":\"0dd7ed4f-100c-4188-9a34-077aa0b6aa25\",\"uuid\":\"a2df83b6-8576-42dd-861c-88cf9ff2f777\",\"timestamp\":\"2026-09-26T02:47:58.455Z\",\"tool_use_result\":{\"filePath\":\"/Users/davidbean/Projects/attavo-worktree-219/attavo/drive.py\",\"oldString\":\"        # R3: a retryable family (died, hung, transient, returned) asks\\n        # counsel nothing while its budget still has an attempt to\\n        # spend -- the next pass retries it plainly. Once its budget is\\n        # spent, or its last two signatures match, counsel is read once\\n        # more, its sentence carried beside the exhaustion report, never\\n        # instead of it. Every other class is counsel's to read on every\\n        # stop, as before this item.\\n        stop_class = (record.get(\\\"stop\\\") or {}).get(\\\"class\\\")\\n        budget_stage = \\\"build\\\" if stop_class == \\\"returned\\\" else stage\\n        ask_counsel = (stop_class not in RETRYABLE_CLASSES\\n                      or stage_exhausted(records_dir, m, stage, budget_stage))\\n        counsel_before = latest_attempt_path(records_dir, \\\"counsel\\\")\",\"newString\":\"        # R3: a retryable family (died, hung, transient, returned) asks\\n        # counsel nothing while its budget still has an attempt to\\n        # spend -- the next pass retries it plainly. Once its budget is\\n        # spent, or its last two signatures match, counsel is read once\\n        # more, its sentence carried beside the exhaustion report, never\\n        # instead of it. Every other class is counsel's to read on every\\n        # stop, as before this item -- unless the immediately preceding\\n        # attempt of this stage already carried the identical detail and\\n        # was already counseled: asking counsel the same question twice\\n        # in a row would only spend a second invocation on the same\\n        # answer, so this one is a person's now, not counsel's again.\\n        stop_class = (record.get(\\\"stop\\\") or {}).get(\\\"class\\\")\\n        budget_stage = \\\"build\\\" if stop_class == \\\"returned\\\" else stage\\n        if stop_class in RETRYABLE_CLASSES:\\n            ask_counsel = stage_exhausted(records_dir, m, stage, budget_stage)\\n        else:\\n            detail = (record.get(\\\"stop\\\") or {}).get(\\\"detail\\\")\\n            prior = parse_attempts(records_dir, stage).get(nn - 1) if nn > 1 else None\\n            already_read = (prior is not None and signature_of(detail) is not None\\n                           and signature_of(detail) == signature_of((prior.get(\\\"stop\\\") or {}).get(\\\"detail\\\"))\\n                           and counsel_record_for(records_dir, stage, nn - 1) is not None)\\n            ask_counsel = not already_read\\n        counsel_before = latest_attempt_path(records_dir, \\\"counsel\\\")\",\"originalFile\":\"from __future__ import annotations\\n\\nimport io\\nimport json\\nimport os\\nimport signal\\nimport subprocess\\nimport sys\\nimport threading\\nimport time\\nfrom pathlib import Path\\nfrom typing import TYPE_CHECKING, Any, NamedTuple, cast\\n\\nfrom attavo.approval import approval_status\\nfrom attavo.build import adapter_conformance, cmd_build, driver_identity, resolve_adapter\\nfrom attavo.common import MANIFEST, PRODUCT_ROOT, derive_item_id, git, read_manifest\\nfrom attavo.counsel import cmd_counsel\\nfrom attavo.doctor import (\\n    _parse_json_line,\\n    ceiling_s,\\n    invocation_alive,\\n    invocations_without_record,\\n    retry_after_s,\\n    stall_bound_s,\\n    write_invocation_marker,\\n)\\nfrom attavo.events import stage_events_dir\\nfrom attavo.filing import cmd_file_stops\\nfrom attavo.records import (\\n    latest_attempt_path,\\n    latest_record,\\n    next_attempt_number,\\n    parse_attempts,\\n    stage_schema,\\n    write_record,\\n)\\nfrom attavo.stops import RETRYABLE_CLASSES, counsel_record_for, signature_of, stage_exhausted\\nfrom attavo.verify import cmd_verify, read_forge_checks\\n\\nif TYPE_CHECKING:\\n    from attavo.types import DriveReport\\n\\n# --- drive: the mechanical transitions between approval and ready-to-merge\\n# (issue #84), under the reconciler's R2 (rulings A, B, C's recovery half,\\n# F, G, H): `attavo drive N` is one short pass. It reads the report\\n# (attavo.report), acts at most once -- recovers a dead or hung\\n# invocation, or starts the next stage in a detached worker -- and\\n# returns within seconds; the stage itself runs in `attavo worker`, a\\n# child of the pass's own session, which outlives it. Writes no record of\\n# its own: the stage records already on disk, and the invocation markers\\n# and heartbeats beside them, are the only state a pass or a worker\\n# reads. ---\\n\\n\\ndef commit_record(root: Path, record_paths: Path | list[Path], message: str) -> None:\\n    \\\"\\\"\\\"`git commit --only` on every record path given, and each one's .log\\n    and .filed, each if one exists -- never the whole index. A transport\\n    commit that sweeps the index is exactly the regression issue #46\\n    already guards build and verify against on the adapter side; drive\\n    must not reintroduce it on the transport side. The .filed marker\\n    (issue #89) is committed alongside the record it names, in the same\\n    commit and the same push, so a second worktree or a fresh clone reads\\n    the same filed fact rather than refiling every stop it finds with no\\n    marker of its own. A single Path is accepted for the common one-record\\n    case; issue #100 passes a list so the counsel record lands in the same\\n    commit as the stage record it counsels. Authored and committed as\\n    driver_identity(), set by the product and never the tenant's git\\n    config, so a driven item's record commits are never indistinguishable\\n    from an operator's own.\\\"\\\"\\\"\\n    if isinstance(record_paths, Path):\\n        record_paths = [record_paths]\\n    paths: list[str] = []\\n    for record_path in record_paths:\\n        paths.append(str(record_path.relative_to(root)))\\n        log_path = record_path.with_suffix(\\\".log\\\")\\n        if log_path.is_file():\\n            paths.append(str(log_path.relative_to(root)))\\n        marker_path = record_path.with_suffix(\\\".filed\\\")\\n        if marker_path.is_file():\\n            paths.append(str(marker_path.relative_to(root)))\\n    identity = driver_identity()\\n    env = dict(os.environ)\\n    env[\\\"GIT_AUTHOR_NAME\\\"] = identity[\\\"name\\\"]\\n    env[\\\"GIT_AUTHOR_EMAIL\\\"] = identity[\\\"email\\\"]\\n    env[\\\"GIT_COMMITTER_NAME\\\"] = identity[\\\"name\\\"]\\n    env[\\\"GIT_COMMITTER_EMAIL\\\"] = identity[\\\"email\\\"]\\n    git(root, \\\"add\\\", *paths)\\n    git(root, \\\"commit\\\", \\\"--only\\\", \\\"-m\\\", message, *paths, env=env)\\n\\n\\ndef push_record_commit(root: Path, branch: str) -> tuple[bool, str | None]:\\n    \\\"\\\"\\\"Push HEAD to branch on origin. A push a divergent remote rejects is\\n    retried once after `git pull --no-rebase --no-edit origin branch` -- a\\n    merge, never a rebase, because a rebase would change the sha the record\\n    commit just wrote already names. This is the record push's own retry\\n    -- the worker's, once it has the lease -- distinct from push_lease\\n    below, which never retries.\\\"\\\"\\\"\\n    def attempt() -> tuple[bool, str]:\\n        run = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"push\\\", \\\"origin\\\", f\\\"HEAD:{branch}\\\"],\\n                             capture_output=True, text=True, check=False)\\n        return run.returncode == 0, run.stderr.strip()\\n\\n    ok, err = attempt()\\n    if ok:\\n        return True, None\\n    pull = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"pull\\\", \\\"--no-rebase\\\", \\\"--no-edit\\\",\\n                           \\\"origin\\\", branch], capture_output=True, text=True, check=False)\\n    if pull.returncode != 0:\\n        return False, f\\\"push rejected and the retry merge failed: {pull.stderr.strip() or err}\\\"\\n    ok, err = attempt()\\n    if not ok:\\n        return False, f\\\"push rejected again after merging {branch}: {err}\\\"\\n    return True, None\\n\\n\\n_RACE_MARKERS = (\\\"non-fast-forward\\\", \\\"fetch first\\\", \\\"stale info\\\", \\\"cannot lock ref\\\",\\n                 \\\"failed to update ref\\\")\\n\\n\\ndef push_lease(root: Path, branch: str) -> tuple[str, str | None]:\\n    \\\"\\\"\\\"Push HEAD to branch on origin as a plain fast-forward -- no merge,\\n    no retry: this is the lease the marker commit takes on the attempt it\\n    names (ruling A). (\\\"pushed\\\", None) on success.\\n\\n    (\\\"lost-race\\\", stderr) when git's own ref check is what rejected it --\\n    the branch moved since this pass fast-forwarded to it (a sequential\\n    \\\"[rejected] ... (fetch first)\\\"), or the remote's own ref transaction\\n    lost a genuine simultaneous push (\\\"[remote rejected] ... (failed to\\n    update ref)\\\", \\\"cannot lock ref\\\"): either way, another pass's own\\n    marker (or record) landed there first. The pass that reads this is\\n    the loser: it says so, resets its own marker commit, and starts\\n    nothing.\\n\\n    (\\\"refused\\\", stderr) for every other rejection -- a remote that\\n    refuses the push outright (a hook, a permission, an unreachable\\n    remote). This is not a race for the lease; it is a refusal, and ends\\n    the pass with exit 1.\\\"\\\"\\\"\\n    run = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"push\\\", \\\"origin\\\", f\\\"HEAD:{branch}\\\"],\\n                         capture_output=True, text=True, check=False)\\n    if run.returncode == 0:\\n        return \\\"pushed\\\", None\\n    stderr = run.stderr\\n    if any(marker in stderr for marker in _RACE_MARKERS):\\n        return \\\"lost-race\\\", stderr.strip()\\n    return \\\"refused\\\", stderr.strip()\\n\\n\\ndef has_origin(root: Path) -> bool:\\n    \\\"\\\"\\\"Whether this checkout carries an origin remote at all -- a fixture\\n    or a scratch checkout with none is not a refusal; a pass commits\\n    locally and skips the push, the way recovery always has.\\\"\\\"\\\"\\n    try:\\n        git(root, \\\"remote\\\", \\\"get-url\\\", \\\"origin\\\")\\n        return True\\n    except RuntimeError:\\n        return False\\n\\n\\ndef drive_state(root: Path, m: dict[str, Any], item_id: str) -> tuple[str, str | None, Path]:\\n    \\\"\\\"\\\"(\\\"no-approval\\\" | \\\"build\\\" | \\\"verify\\\" | \\\"ready\\\", detail, records_dir):\\n    the next mechanical step for item_id, read from its latest records\\n    alone. A build only counts as current when it is a pass bound to the\\n    valid approval's own sha; a verify only counts as current when it is a\\n    pass bound to that build's own sha -- the same staleness a re-approval\\n    or a re-build must force, attest's own chain check already enforces\\n    (check_attest_chain), read here rather than re-typed.\\\"\\\"\\\"\\n    records_rel = m[\\\"paths\\\"][\\\"records\\\"]\\n    records_dir = root / records_rel / item_id\\n\\n    status = approval_status(root, m, item_id)\\n    if status != \\\"valid\\\":\\n        return \\\"no-approval\\\", status, records_dir\\n\\n    latest_approval = latest_record(records_dir, \\\"approval\\\")\\n    latest_build = latest_record(records_dir, \\\"build\\\")\\n    build_current = (latest_build is not None and latest_build.get(\\\"status\\\") == \\\"pass\\\"\\n                     and latest_build.get(\\\"approval_sha\\\")\\n                     == (latest_approval.get(\\\"sha\\\") if latest_approval else None))\\n    if latest_build is None or not build_current:\\n        return \\\"build\\\", None, records_dir\\n\\n    latest_verify = latest_record(records_dir, \\\"verify\\\")\\n    verify_current = (latest_verify is not None and latest_verify.get(\\\"status\\\") == \\\"pass\\\"\\n                      and latest_verify.get(\\\"build_sha\\\") == latest_build.get(\\\"sha\\\"))\\n    if not verify_current:\\n        return \\\"verify\\\", None, records_dir\\n\\n    return \\\"ready\\\", None, records_dir\\n\\n\\n# --- the heartbeat, the worker log, and the forge-checks handoff: local\\n# facts under the checkout's own git directory (issue #140's precedent),\\n# never committed and never among the paths commit_record ever names. ---\\n\\ndef heartbeat_s() -> float:\\n    return float(os.environ.get(\\\"ATTAVO_HEARTBEAT_S\\\", 15))\\n\\n\\ndef heartbeat_path(root: Path, stage: str, nn: int) -> Path:\\n    return stage_events_dir(root) / f\\\"{stage}-{nn:02d}.heartbeat\\\"\\n\\n\\ndef worker_log_path(root: Path, stage: str, nn: int) -> Path:\\n    return stage_events_dir(root) / f\\\"{stage}-{nn:02d}.worker.log\\\"\\n\\n\\ndef forge_checks_path(root: Path, stage: str, nn: int) -> Path:\\n    return stage_events_dir(root) / f\\\"{stage}-{nn:02d}.forge-checks.json\\\"\\n\\n\\ndef _events_path_for(root: Path, stage: str, nn: int) -> Path | None:\\n    \\\"\\\"\\\"The adapter's own events file for this invocation, under the\\n    checkout's git dir (a worktree's own dir when the checkout is one).\\\"\\\"\\\"\\n    try:\\n        gitdir = Path(git(root, \\\"rev-parse\\\", \\\"--git-dir\\\").strip())\\n    except RuntimeError:\\n        return None\\n    if not gitdir.is_absolute():\\n        gitdir = root / gitdir\\n    path = gitdir / \\\"attavo\\\" / f\\\"{stage}-{nn:02d}.events.jsonl\\\"\\n    return path if path.is_file() else None\\n\\n\\ndef _events_tail(path: Path | None, lines: int = 20) -> tuple[str, str | None]:\\n    \\\"\\\"\\\"(the last lines as a log, the last event's own at).\\\"\\\"\\\"\\n    if path is None:\\n        return \\\"no events file for this invocation\\\\n\\\", None\\n    try:\\n        text = path.read_text()\\n    except OSError:\\n        return \\\"events file unreadable\\\\n\\\", None\\n    tail = text.splitlines()[-lines:]\\n    last_at = None\\n    for line in reversed(tail):\\n        parsed = _parse_json_line(line)\\n        if not isinstance(parsed, dict):\\n            continue\\n        at = parsed.get(\\\"at\\\")\\n        if isinstance(at, str):\\n            last_at = at\\n            break\\n    return \\\"\\\\n\\\".join(tail) + \\\"\\\\n\\\", last_at\\n\\n\\ndef _seconds_since(at: str | None) -> float | None:\\n    from datetime import datetime, timezone\\n    if not at:\\n        return None\\n    try:\\n        then = datetime.strptime(at, \\\"%Y-%m-%dT%H:%M:%SZ\\\").replace(tzinfo=timezone.utc)\\n    except ValueError:\\n        return None\\n    return (datetime.now(timezone.utc) - then).total_seconds()\\n\\n\\nclass InvocationReading(NamedTuple):\\n    \\\"\\\"\\\"What one marker with no record reads as, from here and now.\\\"\\\"\\\"\\n    stage: str\\n    nn: int\\n    log: str\\n    last_at: str | None\\n    age: float | None\\n    cls: str  # \\\"running\\\" | \\\"hung\\\" | \\\"died\\\"\\n    bound: str | None = None  # R3: \\\"stall\\\" or \\\"ceiling\\\" when cls is \\\"hung\\\"\\n\\n\\ndef read_invocation(root: Path, bound: int | None, marker: Path, info: dict[str, Any]) -> InvocationReading:\\n    \\\"\\\"\\\"Whether an invocation that began and wrote no record is running,\\n    hung, or died -- read from its own heartbeat first (R2): a heartbeat\\n    file fresh within three beats of ATTAVO_HEARTBEAT_S is alive; a stale\\n    one is died, whether or not the pid still lives -- a worker stuck\\n    somewhere that never reaches its own heartbeat loop again is exactly\\n    what this is for. Only with no heartbeat file at all -- an invocation\\n    from before this release, or one that died before touching its\\n    first beat -- does this fall back to the pid: alive and, with a\\n    stall bound declared, past it is hung; alive with no bound, or\\n    within it, is running for as long as it lives; not alive is died.\\n    The stall bound decides hung, never died.\\\"\\\"\\\"\\n    stage, nn_text = marker.stem.rsplit(\\\"-\\\", 1)\\n    nn = int(nn_text)\\n    log, last_at = _events_tail(_events_path_for(root, stage, nn))\\n    # R3: the stage ceiling, wall clock from the marker's own `at`, judged\\n    # before any liveness signal -- alive past it is hung by the ceiling,\\n    # whatever its event age (or absence of one) says.\\n    m = read_manifest(root) or {}\\n    ceiling = ceiling_s(m, stage)\\n    since_start = _seconds_since(info.get(\\\"at\\\"))\\n    if ceiling is not None and since_start is not None and since_start > ceiling:\\n        return InvocationReading(stage, nn, log, last_at, since_start, \\\"hung\\\", \\\"ceiling\\\")\\n    if not _streams_events(root, m, stage):\\n        # An adapter that declares it streams no events is judged by the\\n        # ceiling alone; the stall bound it can never trip is not asked.\\n        bound = None\\n    beat = heartbeat_path(root, stage, nn)\\n    if beat.is_file():\\n        try:\\n            beat_age = time.time() - beat.stat().st_mtime\\n        except OSError:\\n            beat_age = None\\n        cls = \\\"running\\\" if beat_age is not None and beat_age <= heartbeat_s() * 3 else \\\"died\\\"\\n        return InvocationReading(stage, nn, log, last_at, beat_age, cls)\\n    age = _seconds_since(last_at or info.get(\\\"at\\\"))\\n    if not invocation_alive(info):\\n        return InvocationReading(stage, nn, log, last_at, age, \\\"died\\\")\\n    if bound is None or age is None or age <= bound:\\n        return InvocationReading(stage, nn, log, last_at, age, \\\"running\\\")\\n    return InvocationReading(stage, nn, log, last_at, age, \\\"hung\\\", \\\"stall\\\")\\n\\n\\ndef _streams_events(root: Path, m: dict[str, Any], stage: str) -> bool:\\n    \\\"\\\"\\\"R3: whether the stage's adapter declares it streams events\\n    (adapters/<name>/conformance.json, \\\"streams_events\\\"); true when the\\n    adapter names none, or its conformance.json does not say.\\\"\\\"\\\"\\n    name = (m.get(\\\"executor\\\") or {}).get(stage) or (m.get(\\\"executor\\\") or {}).get(\\\"build\\\")\\n    if not name:\\n        return True\\n    adapter_path = resolve_adapter(root, name)\\n    if adapter_path is None:\\n        return True\\n    return bool(adapter_conformance(adapter_path).get(\\\"streams_events\\\", True))\\n\\n\\ndef uncommitted_record(root: Path, records_dir: Path, stage: str) -> Path | None:\\n    \\\"\\\"\\\"The latest <stage>-NN.json this working tree carries that git has\\n    no commit for yet -- the moment between a worker's write and its own\\n    commit. None when the latest record is already committed, or there\\n    is none at all.\\\"\\\"\\\"\\n    path = latest_attempt_path(records_dir, stage)\\n    if path is None or not path.is_file():\\n        return None\\n    status = subprocess.run(\\n        [\\\"git\\\", \\\"-C\\\", str(root), \\\"status\\\", \\\"--porcelain\\\", \\\"--\\\", str(path.relative_to(root))],\\n        capture_output=True, text=True, check=False)\\n    return path if status.stdout.strip() else None\\n\\n\\ndef worker_holds_copy(root: Path, records_dir: Path) -> bool:\\n    \\\"\\\"\\\"True when this checkout's own working tree cannot safely be moved\\n    -- an invocation marker with no record yet (a worker, here or\\n    elsewhere, still holds this attempt), or a build or verify record the\\n    working tree carries that git has not committed yet. Scoped to the\\n    stage records a pass or a worker itself ever transports -- an\\n    operator's own spec-gate or approve, routinely uncommitted between\\n    their own act and the next pass, is not this. A pass never\\n    fast-forwards while this holds (never while a worker holds the\\n    copy).\\\"\\\"\\\"\\n    if invocations_without_record(records_dir):\\n        return True\\n    return (uncommitted_record(root, records_dir, \\\"build\\\") is not None\\n           or uncommitted_record(root, records_dir, \\\"verify\\\") is not None)\\n\\n\\ndef fast_forward_to_origin(root: Path, m: dict[str, Any], item_id: str) -> None:\\n    \\\"\\\"\\\"The pass's own read of origin's branch, taken before it reads\\n    anything else -- a commit landed there from elsewhere (an approval\\n    from the screen, a ruling, another pass's own record) is not a race\\n    for the lease, it is exactly what the lease is for. Never while a\\n    worker holds this copy (worker_holds_copy): resetting a working tree\\n    a detached child is still writing into would corrupt its own commits.\\n    A plain fast-forward when origin is simply ahead; when this checkout\\n    also carries its own commits origin has not seen yet (an operator's\\n    approval, not yet pushed), those are replayed on top of origin's own\\n    tip instead -- no merge commit, and the marker this pass is about to\\n    write still lands as a fast-forward when it pushes. Silent about\\n    everything short of that -- a real conflict, or an absent origin, is\\n    left for the ordinary read (and the marker push, for the lease) to\\n    sort out.\\\"\\\"\\\"\\n    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n    if worker_holds_copy(root, records_dir) or not has_origin(root):\\n        return\\n    try:\\n        branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n        git(root, \\\"fetch\\\", \\\"origin\\\", branch)\\n    except RuntimeError:\\n        return\\n    try:\\n        git(root, \\\"merge\\\", \\\"--ff-only\\\", \\\"FETCH_HEAD\\\")\\n        return\\n    except RuntimeError:\\n        pass\\n    try:\\n        git(root, \\\"rebase\\\", \\\"FETCH_HEAD\\\")\\n    except RuntimeError:\\n        subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"rebase\\\", \\\"--abort\\\"],\\n                       capture_output=True, text=True, check=False)\\n\\n\\n# --- the worker: a detached child of the pass's own session, running the\\n# stage exactly as the pass used to inline, touching its own heartbeat\\n# while it does (R2). ---\\n\\ndef _stage_body(item_id: str, stage: str, nn: int) -> int:\\n    \\\"\\\"\\\"Runs build or verify in-process -- the same command `attavo build`\\n    or `attavo verify` would run -- while touching heartbeat_path every\\n    heartbeat_s() seconds, then transports whatever it wrote: counsel and\\n    file-stops on a non-pass record (issue #100, #89), one `git commit\\n    --only`, one push with the record push's own merge retry. The\\n    marker is the pass's, already committed and pushed before this\\n    starts; this writes and transports only the stage's own record (and,\\n    on a stop, its counsel record).\\\"\\\"\\\"\\n    root = Path(\\\".\\\").resolve()\\n    m = read_manifest(root)\\n    if m is None:\\n        return 2\\n    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n    before = latest_attempt_path(records_dir, stage)\\n\\n    beat = heartbeat_path(root, stage, nn)\\n    beat.parent.mkdir(parents=True, exist_ok=True)\\n    beat.touch()\\n    stop_beat = threading.Event()\\n\\n    def _tick() -> None:\\n        while not stop_beat.wait(heartbeat_s()):\\n            beat.touch()\\n\\n    beat_thread = threading.Thread(target=_tick, daemon=True)\\n    beat_thread.start()\\n    try:\\n        rc = cmd_build([item_id]) if stage == \\\"build\\\" else cmd_verify([item_id])\\n    finally:\\n        stop_beat.set()\\n        beat_thread.join()\\n\\n    after = latest_attempt_path(records_dir, stage)\\n    if after is None or after == before:\\n        # Refused before writing anything at all (e.g. no adapter\\n        # configured) -- the stage command already printed why.\\n        return rc if rc != 0 else 1\\n\\n    record = cast(dict[str, Any], latest_record(records_dir, stage))\\n    status_out = record.get(\\\"status\\\")\\n    to_commit = [after]\\n    if status_out != \\\"pass\\\":\\n        # R3: a retryable family (died, hung, transient, returned) asks\\n        # counsel nothing while its budget still has an attempt to\\n        # spend -- the next pass retries it plainly. Once its budget is\\n        # spent, or its last two signatures match, counsel is read once\\n        # more, its sentence carried beside the exhaustion report, never\\n        # instead of it. Every other class is counsel's to read on every\\n        # stop, as before this item.\\n        stop_class = (record.get(\\\"stop\\\") or {}).get(\\\"class\\\")\\n        budget_stage = \\\"build\\\" if stop_class == \\\"returned\\\" else stage\\n        ask_counsel = (stop_class not in RETRYABLE_CLASSES\\n                      or stage_exhausted(records_dir, m, stage, budget_stage))\\n        counsel_before = latest_attempt_path(records_dir, \\\"counsel\\\")\\n        if ask_counsel:\\n            cmd_counsel([item_id])\\n        counsel_after = latest_attempt_path(records_dir, \\\"counsel\\\")\\n        if counsel_after is not None and counsel_after != counsel_before:\\n            to_commit.append(counsel_after)\\n        # file-stops is its own idempotent read of the item's records, so\\n        # calling it here on every run that wrote a non-pass record is\\n        # safe to call again on a later run: an already-filed stop's own\\n        # marker is what stops it from being filed twice.\\n        cmd_file_stops([item_id])\\n\\n    message = f\\\"attavo: {stage} record for item {item_id} ({after.stem})\\\"\\n    try:\\n        commit_record(root, to_commit, message)\\n    except RuntimeError as exc:\\n        print(f\\\"attavo drive: stopped: could not commit the {stage} record: {exc}\\\")\\n        return 1\\n\\n    if has_origin(root):\\n        ok, err = push_record_commit(root, branch)\\n        if not ok:\\n            print(f\\\"attavo drive: stopped: could not push the {stage} record: {err}\\\")\\n            return 1\\n    else:\\n        print(f\\\"attavo drive: note: no origin remote; {after.name} is committed, not pushed\\\")\\n\\n    if status_out == \\\"halted\\\":\\n        question = (record.get(\\\"halted\\\") or {}).get(\\\"question\\\")\\n        print(f\\\"attavo drive: stopped: {stage} halted: {question} ({after.name}); \\\"\\n              f\\\"pushed to {branch}\\\")\\n    elif status_out != \\\"pass\\\":\\n        reason = record.get(\\\"refusal\\\") or status_out\\n        print(f\\\"attavo drive: stopped: {stage} {status_out}: {reason} ({after.name}); \\\"\\n              f\\\"pushed to {branch}\\\")\\n    else:\\n        print(f\\\"attavo drive: pushed {after.name} to {branch}\\\")\\n    return rc\\n\\n\\ndef cmd_worker(argv: list[str]) -> int:\\n    \\\"\\\"\\\"`attavo worker N <build|verify> NN`: the detached child a pass\\n    starts once its marker is pushed -- the lease held, the attempt is\\n    this worker's to run. Its own session (start_new_session, set by the\\n    pass that spawns it); its stdout and stderr are the pass's own\\n    redirect, to <git-dir>/attavo/<stage>-NN.worker.log.\\\"\\\"\\\"\\n    cast(io.TextIOWrapper, sys.stdout).reconfigure(line_buffering=True)\\n    if len(argv) != 3:\\n        print(\\\"attavo worker: usage: attavo worker N <build|verify> NN\\\", file=sys.stderr)\\n        return 2\\n    item_id, stage, nn_text = argv\\n    if stage not in (\\\"build\\\", \\\"verify\\\"):\\n        print(f\\\"attavo worker: {stage!r} is not build or verify\\\", file=sys.stderr)\\n        return 2\\n    try:\\n        nn = int(nn_text)\\n    except ValueError:\\n        print(f\\\"attavo worker: {nn_text!r} is not an attempt number\\\", file=sys.stderr)\\n        return 2\\n    return _stage_body(item_id, stage, nn)\\n\\n\\n# --- the pass's own two acts: start a stage (the lease), and recover\\n# exactly the one invocation the report names owed one. ---\\n\\ndef _start_stage(root: Path, m: dict[str, Any], item_id: str, stage: str,\\n                 forge_checks: dict[str, Any] | None, *, again_by: bool = False) -> int:\\n    \\\"\\\"\\\"The lease (ruling A): the marker, committed and pushed as a plain\\n    fast-forward with no merge and no retry (push_lease). Lost to another\\n    pass, or refused outright by the remote, both undo the marker commit\\n    here (git reset --hard) so this checkout carries no half-taken\\n    attempt either way; only a pushed lease starts the worker. On a\\n    review, forge_checks is the checks this same pass already read on\\n    the pre-marker head (ruling B) -- written to\\n    <git-dir>/attavo/verify-NN.forge-checks.json and named in\\n    ATTAVO_FORGE_CHECKS, so the worker's own `attavo verify` reads it\\n    instead of polling. R3: again_by names the marker as `--again`'s own\\n    act on a stage whose budget was already spent.\\\"\\\"\\\"\\n    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n    nn = next_attempt_number(records_dir, stage)\\n    marker = write_invocation_marker(root, records_dir, stage, nn, again_by=again_by)\\n    try:\\n        commit_record(root, [marker], f\\\"attavo: {stage} invocation {nn:02d} started for item {item_id}\\\")\\n    except RuntimeError as exc:\\n        print(f\\\"attavo drive: stopped: could not commit the {stage} invocation marker: {exc}\\\")\\n        return 1\\n\\n    if has_origin(root):\\n        outcome, err = push_lease(root, branch)\\n        if outcome != \\\"pushed\\\":\\n            git(root, \\\"reset\\\", \\\"--hard\\\", \\\"HEAD^\\\")\\n            if outcome == \\\"lost-race\\\":\\n                print(f\\\"attavo drive: another pass holds this attempt ({marker.name}); nothing started\\\")\\n                return 0\\n            print(f\\\"attavo drive: stopped: could not push the {stage} invocation marker: {err}\\\")\\n            return 1\\n\\n    env = dict(os.environ)\\n    if forge_checks is not None:\\n        checks_file = forge_checks_path(root, stage, nn)\\n        checks_file.write_text(json.dumps(forge_checks))\\n        env[\\\"ATTAVO_FORGE_CHECKS\\\"] = str(checks_file)\\n    log = worker_log_path(root, stage, nn)\\n    with log.open(\\\"ab\\\") as fh, open(os.devnull, \\\"rb\\\") as devnull:\\n        proc = subprocess.Popen(\\n            [sys.executable, str(PRODUCT_ROOT / \\\"bin\\\" / \\\"attavo\\\"), \\\"worker\\\", item_id, stage, f\\\"{nn:02d}\\\"],\\n            cwd=str(root), env=env, stdin=devnull, stdout=fh, stderr=subprocess.STDOUT,\\n            start_new_session=True)\\n    word = \\\"Build\\\" if stage == \\\"build\\\" else \\\"Review\\\"\\n    print(f\\\"attavo drive: {word} started (attempt {nn:02d}, worker pid {proc.pid})\\\")\\n    return 0\\n\\n\\ndef _recover_one(root: Path, m: dict[str, Any], item_id: str, records_dir: Path) -> int:\\n    \\\"\\\"\\\"The pass's own recovery act (what `--recover` did): exactly the one\\n    invocation the report just read as owing one -- died or hung -- ends\\n    here. class died when the heartbeat is stale (or absent and the pid\\n    is gone), class hung when there is no heartbeat, the pid lives, and a\\n    declared [drive].stall_after_s has passed with no newer event, and\\n    terminated. Provenance product; the events tail as the log. Committed\\n    and pushed the way any stage record is (push_record_commit, with its\\n    own merge retry) -- this is not a race for a lease, since no new\\n    attempt marker is written.\\\"\\\"\\\"\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n    bound = stall_bound_s(m)\\n    pending = invocations_without_record(records_dir)\\n    readings = [(marker, info, read_invocation(root, bound, marker, info)) for marker, info in pending]\\n    candidate = next(((mk, i, rd) for mk, i, rd in readings if rd.cls != \\\"running\\\"), None)\\n    if candidate is None:\\n        # The report read this a moment ago; nothing owed recovery by the\\n        # time this pass got here (another pass recovered it, or it\\n        # finished on its own).\\n        return 0\\n    marker, info, reading = candidate\\n    stage, nn, log, last_at, age, cls, crossed = reading\\n    pid, host = info.get(\\\"pid\\\"), info.get(\\\"host\\\")\\n\\n    if next_attempt_number(records_dir, stage) != nn:\\n        print(f\\\"attavo drive: stopped: {marker.name} names attempt {nn} but the next \\\"\\n              f\\\"{stage} record would be {next_attempt_number(records_dir, stage):02d}; \\\"\\n              f\\\"a later record already exists, read the records before recovering\\\")\\n        return 1\\n\\n    if cls == \\\"hung\\\":\\n        try:\\n            os.kill(cast(int, pid), signal.SIGTERM)\\n            ended = \\\"terminated\\\"\\n        except OSError as exc:\\n            ended = f\\\"not terminated ({exc})\\\"\\n        if crossed == \\\"ceiling\\\":\\n            detail = (f\\\"pid {pid} on {host} alive {int(cast(float, age))} s after its marker, past \\\"\\n                      f\\\"the {stage} ceiling of {ceiling_s(m, stage)} s; {ended}\\\")\\n        else:\\n            detail = (f\\\"pid {pid} on {host} alive with no event for {int(cast(float, age))} s \\\"\\n                      f\\\"(bound {bound} s); {ended}\\\")\\n    else:\\n        detail = (f\\\"pid {pid} on {host} is not running and wrote no {marker.stem}.json; \\\"\\n                  f\\\"started {info.get('at')}, last event {last_at or 'none'}\\\")\\n\\n    schema = stage_schema(stage)\\n    record: dict[str, Any] = {k: None for k in schema.get(\\\"required\\\", [])}\\n    approval = latest_record(records_dir, \\\"approval\\\")\\n    signature_source = log.strip().splitlines()[-1] if log.strip() else detail\\n    record.update({\\\"sha\\\": info.get(\\\"sha\\\"), \\\"start_sha\\\": info.get(\\\"sha\\\"),\\n                   \\\"approval_sha\\\": approval.get(\\\"sha\\\") if approval else None,\\n                   \\\"at\\\": info.get(\\\"at\\\"),\\n                   \\\"adapter\\\": (m.get(\\\"executor\\\") or {}).get(stage),\\n                   \\\"status\\\": \\\"failed\\\", \\\"refusal\\\": None, \\\"halted\\\": None,\\n                   \\\"retry_of\\\": None, \\\"steer\\\": None,\\n                   \\\"stop\\\": {\\\"class\\\": cls, \\\"provenance\\\": \\\"product\\\", \\\"detail\\\": detail,\\n                            \\\"signature\\\": signature_of(signature_source), \\\"bound\\\": crossed}})\\n    if \\\"wall_clock_s\\\" in record:\\n        record[\\\"wall_clock_s\\\"] = None if age is None else int(age)\\n    record = {k: v for k, v in record.items() if k in schema.get(\\\"properties\\\", {})}\\n    try:\\n        path = write_record(records_dir, stage, record, m, item_id, log=log)\\n    except ValueError as exc:\\n        print(f\\\"attavo drive: stopped: could not write the {cls} record for {marker.stem}: {exc}\\\")\\n        return 1\\n    try:\\n        commit_record(root, [path], f\\\"attavo: {stage} record for item {item_id} \\\"\\n                                    f\\\"({path.stem}), recovered as {cls}\\\")\\n    except RuntimeError as exc:\\n        print(f\\\"attavo drive: stopped: could not commit the {cls} record: {exc}\\\")\\n        return 1\\n    if has_origin(root):\\n        ok, err = push_record_commit(root, branch)\\n        if not ok:\\n            print(f\\\"attavo drive: stopped: could not push the {cls} record: {err}\\\")\\n            return 1\\n    else:\\n        print(f\\\"attavo drive: note: no origin remote; {path.name} is committed, not pushed\\\")\\n    print(f\\\"attavo drive: recovered {marker.stem} as {cls}: {detail}\\\")\\n    return 0\\n\\n\\ndef _advance_again(root: Path, m: dict[str, Any], item_id: str, stage: str, head: str | None, *,\\n                   again_by: bool = False) -> int:\\n    \\\"\\\"\\\"The next attempt of a stopped stage: exactly what next-build or\\n    next-review would do, bypassing the level a plain pass leaves alone\\n    for the operator -- the pass's own automatic retry of a retryable\\n    family, or `--again`'s act once a budget is spent (again_by). A\\n    review reads the forge fresh here -- once, since the report's own\\n    stopped reading never touched it -- rather than reusing a read that\\n    was never taken.\\\"\\\"\\\"\\n    if stage == \\\"build\\\":\\n        return _start_stage(root, m, item_id, \\\"build\\\", None, again_by=again_by)\\n    checks_command = (m.get(\\\"forge\\\") or {}).get(\\\"checks_command\\\")\\n    if not checks_command:\\n        print(\\\"attavo drive: refused: no [forge].checks_command in the manifest\\\")\\n        return 1\\n    forge_checks, ok = read_forge_checks(root, checks_command, cast(str, head))\\n    if not ok:\\n        conclusions = forge_checks[\\\"conclusions\\\"]\\n        named = \\\", \\\".join(f\\\"{c['name']} {c['conclusion']}\\\" for c in conclusions) or \\\"no checks reported\\\"\\n        print(f\\\"attavo drive: forge checks not green on {cast(str, head)[:12]}: {named}\\\")\\n        return 0\\n    return _start_stage(root, m, item_id, \\\"verify\\\", forge_checks, again_by=again_by)\\n\\n\\ndef _retry_target(r: \\\"DriveReport\\\") -> str:\\n    \\\"\\\"\\\"The stage the next attempt actually starts: class \\\"returned\\\" (a\\n    build's head a check rejected, or a review's own blocking finding) is\\n    always the verify record's own stop, but the retry it starts is the\\n    next build.\\\"\\\"\\\"\\n    return \\\"build\\\" if r[\\\"stop_class\\\"] == \\\"returned\\\" else cast(str, r[\\\"stage\\\"])\\n\\n\\ndef _retry_due(root: Path, m: dict[str, Any], item_id: str, r: \\\"DriveReport\\\") -> bool:\\n    \\\"\\\"\\\"R3: a stopped stage whose class is one of the four retryable\\n    families, whose budget is not spent, whose last two signatures\\n    differ, and -- for transient -- whose record has aged past\\n    [drive].retry_after_s, is retried by the next plain pass, no\\n    counsel, no operator act.\\\"\\\"\\\"\\n    if r[\\\"stop_class\\\"] not in RETRYABLE_CLASSES:\\n        return False\\n    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n    sig_stage = cast(str, r[\\\"stage\\\"])\\n    budget_stage = _retry_target(r)\\n    if stage_exhausted(records_dir, m, sig_stage, budget_stage):\\n        return False\\n    if r[\\\"stop_class\\\"] == \\\"transient\\\":\\n        attempts = parse_attempts(records_dir, sig_stage)\\n        latest = attempts[max(attempts)] if attempts else {}\\n        age = _seconds_since(latest.get(\\\"at\\\"))\\n        if age is None or age < retry_after_s(m):\\n            return False\\n    return True\\n\\n\\ndef _handle_again(root: Path, m: dict[str, Any], item_id: str, r: \\\"DriveReport\\\") -> int:\\n    \\\"\\\"\\\"`--again`'s own act on a stopped stage (R3): a retryable family\\n    whose budget is not spent is left to the pass's own automatic retry\\n    -- a no-op here, saying so -- since starting it twice would spend two\\n    attempts on one press. A retryable family whose budget is spent, or\\n    any other stopped class, starts the next attempt at once, its marker\\n    naming --again as what started it.\\\"\\\"\\\"\\n    stage = _retry_target(r)\\n    if r[\\\"stop_class\\\"] in RETRYABLE_CLASSES:\\n        records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n        if not stage_exhausted(records_dir, m, cast(str, r[\\\"stage\\\"]), stage):\\n            print(\\\"attavo drive: --again is a no-op inside the budget; the pass retries on its own\\\")\\n            return 0\\n    return _advance_again(root, m, item_id, stage, r[\\\"head\\\"], again_by=True)\\n\\n\\ndef _counsel_answered(records_dir: Path, r: \\\"DriveReport\\\") -> bool:\\n    \\\"\\\"\\\"R3: whether the stop this report just read as \\\"stopped\\\" already\\n    carries counsel's own \\\"answer\\\" verdict -- every non-retryable class\\n    is counsel's to read (as before this item), and `answer` starts the\\n    next attempt with the answer as its steer, read from the feedback\\n    file the retried attempt's own first iteration is handed\\n    (attavo.build._retry_seed).\\\"\\\"\\\"\\n    if r[\\\"stop_class\\\"] in RETRYABLE_CLASSES or not r[\\\"stage\\\"] or r[\\\"attempt\\\"] is None:\\n        return False\\n    counsel = counsel_record_for(records_dir, r[\\\"stage\\\"], r[\\\"attempt\\\"])\\n    return counsel is not None and counsel.get(\\\"verdict\\\") == \\\"answer\\\"\\n\\n\\ndef _pass_once(root: Path, m: dict[str, Any], item_id: str, again: bool) -> tuple[int, \\\"DriveReport\\\"]:\\n    \\\"\\\"\\\"One pass: fast-forward to origin (never while a worker holds the\\n    copy), read the report, act at most once, return. The three acts,\\n    one per report state that is the product's move: owes-recovery\\n    recovers; next-build and next-review start their stage, handing a\\n    review the checks the report already read once on the pre-marker\\n    head; a concluded red check on a passed build's head (R3) is a\\n    returned review record, not a level, so the review starts the same\\n    way. On a stopped stage, `--again` always wins (a no-op inside the\\n    budget, the next attempt once it is spent); absent it, a retryable\\n    family retries on its own, and any other stop counsel has already\\n    answered starts the next attempt steered by that answer. Every other\\n    level is printed in the report's own words and left.\\\"\\\"\\\"\\n    from attavo.report import drive_report\\n    fast_forward_to_origin(root, m, item_id)\\n    r = drive_report(root, m, item_id)\\n\\n    if r[\\\"state\\\"] == \\\"owes-recovery\\\":\\n        records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n        return _recover_one(root, m, item_id, records_dir), r\\n    if r[\\\"state\\\"] == \\\"next-build\\\":\\n        return _start_stage(root, m, item_id, \\\"build\\\", None), r\\n    if r[\\\"state\\\"] == \\\"next-review\\\":\\n        checks_command = (m.get(\\\"forge\\\") or {}).get(\\\"checks_command\\\")\\n        forge_checks = {\\\"command\\\": checks_command, \\\"sha\\\": r[\\\"head\\\"], \\\"conclusions\\\": r[\\\"checks\\\"] or []}\\n        return _start_stage(root, m, item_id, \\\"verify\\\", forge_checks), r\\n    if r[\\\"state\\\"] == \\\"blocked-on-checks\\\" and r[\\\"stage\\\"] == \\\"verify\\\":\\n        # R3: the rejection is a record, not a level with nothing behind\\n        # it (#206's build-01) -- the review starts, reading the same\\n        # forge checks this pass just read, and writes the check\\n        # rejection itself as a returned record (attavo.verify.cmd_verify).\\n        checks_command = (m.get(\\\"forge\\\") or {}).get(\\\"checks_command\\\")\\n        forge_checks = {\\\"command\\\": checks_command, \\\"sha\\\": r[\\\"head\\\"], \\\"conclusions\\\": r[\\\"checks\\\"] or []}\\n        return _start_stage(root, m, item_id, \\\"verify\\\", forge_checks), r\\n    if r[\\\"state\\\"] == \\\"stopped\\\" and r[\\\"stage\\\"]:\\n        if again:\\n            return _handle_again(root, m, item_id, r), r\\n        records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n        if _retry_due(root, m, item_id, r):\\n            return _advance_again(root, m, item_id, _retry_target(r), r[\\\"head\\\"]), r\\n        if _counsel_answered(records_dir, r):\\n            return _advance_again(root, m, item_id, _retry_target(r), r[\\\"head\\\"]), r\\n\\n    print(f\\\"attavo drive: {r['says']}\\\")\\n    return (1 if r[\\\"state\\\"] == \\\"refused\\\" else 0), r\\n\\n\\n_TERMINAL_STATES = (\\\"waiting-on-approval\\\", \\\"stopped\\\", \\\"ready-to-merge\\\", \\\"merged\\\")\\n\\n\\ndef _until_ready(root: Path, m: dict[str, Any], item_id: str, again: bool) -> int:\\n    \\\"\\\"\\\"--until-ready: the pass, repeated in one process, sleeping\\n    ATTAVO_DRIVE_POLL_INTERVAL_S between passes, until the level is the\\n    operator's or done (exit 0), a concluded check is red (exit 1), or\\n    an unconcluded one has not concluded within ATTAVO_DRIVE_POLL_BOUND_S\\n    (exit 1). A stage running in its own worker is not bounded by this --\\n    only time spent waiting on the forge is.\\\"\\\"\\\"\\n    from attavo.verify import drive_forge_poll_bound_s, drive_forge_poll_interval_s\\n    bound = drive_forge_poll_bound_s()\\n    interval = drive_forge_poll_interval_s()\\n    waiting_since: float | None = None\\n    while True:\\n        rc, r = _pass_once(root, m, item_id, again)\\n        state = r[\\\"state\\\"]\\n\\n        if state == \\\"waiting-on-checks\\\":\\n            if waiting_since is None:\\n                waiting_since = time.monotonic()\\n            elif time.monotonic() - waiting_since >= bound:\\n                print(f\\\"attavo drive: stopped: the checks did not conclude within {bound:.0f}s\\\")\\n                return 1\\n        else:\\n            waiting_since = None\\n\\n        if rc != 0:\\n            return rc\\n        if state in _TERMINAL_STATES:\\n            return 0\\n        if state == \\\"blocked-on-checks\\\" and r[\\\"stage\\\"] != \\\"verify\\\":\\n            # R3: stage \\\"verify\\\" here is the pass's own act, just taken --\\n            # a concluded red check on a passed build's head is now a\\n            # returned review record (attavo.verify.cmd_verify), not a\\n            # level the loop gives up on with nothing behind it.\\n            return 1\\n        time.sleep(interval)\\n\\n\\ndef _drive_all() -> int:\\n    \\\"\\\"\\\"--all: one pass, in its own process, in every ../attavo-worktree-N\\n    beside this checkout -- each one derives its own item from its own\\n    attavo/N-* branch. Every line either prints is prefixed with the\\n    worktree's own directory name, so an operator reading them together\\n    can tell which item each line is about.\\\"\\\"\\\"\\n    root = Path(\\\".\\\").resolve()\\n    siblings = sorted(p for p in root.parent.glob(\\\"attavo-worktree-*\\\") if p.is_dir())\\n    if not siblings:\\n        print(\\\"attavo drive: --all found no ../attavo-worktree-N beside this checkout\\\")\\n        return 0\\n    worst = 0\\n    for copy in siblings:\\n        run = subprocess.run([sys.executable, str(PRODUCT_ROOT / \\\"bin\\\" / \\\"attavo\\\"), \\\"drive\\\"],\\n                             cwd=str(copy), capture_output=True, text=True, check=False)\\n        for line in (run.stdout + run.stderr).splitlines():\\n            print(f\\\"{copy.name}: {line}\\\")\\n        worst = max(worst, run.returncode)\\n    return worst\\n\\n\\ndef cmd_drive(argv: list[str]) -> int:\\n    # Issue #145: Python block-buffers stdout when it is not a tty (a\\n    # pipe, e.g. a screen reading this process live), so every line this\\n    # prints would otherwise sit unflushed until the process exits.\\n    # Line-buffering makes a pipe reader see each line the moment it is\\n    # printed, the same as a terminal already does; `attavo worker`\\n    # reconfigures its own stdout the same way.\\n    cast(io.TextIOWrapper, sys.stdout).reconfigure(line_buffering=True)\\n\\n    if \\\"--recover\\\" in argv:\\n        print(\\\"attavo drive: --recover is gone; a pass recovers a dead or hung invocation \\\"\\n              \\\"itself, as soon as the report owes one\\\", file=sys.stderr)\\n        return 2\\n\\n    until_ready = \\\"--until-ready\\\" in argv\\n    report = \\\"--report\\\" in argv\\n    again = \\\"--again\\\" in argv\\n    all_flag = \\\"--all\\\" in argv\\n    positional = [a for a in argv if not a.startswith(\\\"--\\\")]\\n\\n    if all_flag:\\n        if until_ready or report or again or positional:\\n            print(\\\"attavo drive: --all runs one pass in every worktree beside this checkout; \\\"\\n                  \\\"drop N and every other flag\\\", file=sys.stderr)\\n            return 2\\n        return _drive_all()\\n\\n    root = Path(\\\".\\\").resolve()\\n    item_id = positional[0] if positional else derive_item_id(root)\\n    if not item_id:\\n        print(\\\"attavo drive: cannot derive item id; pass N or run on an attavo/N-* branch\\\",\\n              file=sys.stderr)\\n        return 2\\n    m = read_manifest(root)\\n    if m is None:\\n        print(f\\\"attavo drive: no {MANIFEST} at {root}\\\", file=sys.stderr)\\n        return 2\\n\\n    if report:\\n        if until_ready or again:\\n            print(\\\"attavo drive: --report reads and does nothing else; drop --until-ready \\\"\\n                  \\\"and --again\\\", file=sys.stderr)\\n            return 2\\n        fast_forward_to_origin(root, m, item_id)\\n        from attavo.report import drive_report\\n        print(json.dumps(drive_report(root, m, item_id), indent=2))\\n        return 0\\n\\n    if until_ready:\\n        return _until_ready(root, m, item_id, again)\\n    rc, _ = _pass_once(root, m, item_id, again)\\n    return rc\\n\",\"structuredPatch\":[{\"oldStart\":439,\"oldLines\":11,\"newStart\":439,\"newLines\":22,\"lines\":[\"         # spent, or its last two signatures match, counsel is read once\",\"         # more, its sentence carried beside the exhaustion report, never\",\"         # instead of it. Every other class is counsel's to read on every\",\"-        # stop, as before this item.\",\"+        # stop, as before this item -- unless the immediately preceding\",\"+        # attempt of this stage already carried the identical detail and\",\"+        # was already counseled: asking counsel the same question twice\",\"+        # in a row would only spend a second invocation on the same\",\"+        # answer, so this one is a person's now, not counsel's again.\",\"         stop_class = (record.get(\\\"stop\\\") or {}).get(\\\"class\\\")\",\"         budget_stage = \\\"build\\\" if stop_class == \\\"returned\\\" else stage\",\"-        ask_counsel = (stop_class not in RETRYABLE_CLASSES\",\"-                      or stage_exhausted(records_dir, m, stage, budget_stage))\",\"+        if stop_class in RETRYABLE_CLASSES:\",\"+            ask_counsel = stage_exhausted(records_dir, m, stage, budget_stage)\",\"+        else:\",\"+            detail = (record.get(\\\"stop\\\") or {}).get(\\\"detail\\\")\",\"+            prior = parse_attempts(records_dir, stage).get(nn - 1) if nn > 1 else None\",\"+            already_read = (prior is not None and signature_of(detail) is not None\",\"+                           and signature_of(detail) == signature_of((prior.get(\\\"stop\\\") or {}).get(\\\"detail\\\"))\",\"+                           and counsel_record_for(records_dir, stage, nn - 1) is not None)\",\"+            ask_counsel = not already_read\",\"         counsel_before = latest_attempt_path(records_dir, \\\"counsel\\\")\",\"         if ask_counsel:\",\"             cmd_counsel([item_id])\"]}],\"userModified\":false,\"replaceAll\":false,\"contentNotInModelContext\":true}}\n6184:+def _start_stage(root: Path, m: dict[str, Any], item_id: str, stage: str,\n6189:+    here (git reset --hard) so this checkout carries no half-taken\n10479:diff --git a/tests/test_drive.py b/tests/test_drive.py\n10605:diff --git a/tests/test_pass.py b/tests/test_pass.py\n{\n  \"at\": \"2026-09-26T03:15:09Z\",\n  \"host\": \"Davids-MacBook-Pro.local\",\n  \"pid\": 92012,\n  \"sha\": \"947869a9bc83e049a17ccf5419bc58f2c3564f10\",\n  \"product_version\": \"v0.27.0-11-gd20fdea\"\n}\n{\n  \"sha\": \"ae4fe380a038cc8d040c16486430a060997ff5c5\",\n  \"start_sha\": \"ae4fe380a038cc8d040c16486430a060997ff5c5\",\n  \"spec_sha\": \"52f3e3d77cbe9cc4fee25c30e92e5f1e5c1eeb22\",\n  \"approval_sha\": \"ba497297b4c828eed70a3d7190674051c77bc4e8\",\n  \"at\": \"2026-09-26T03:06:01Z\",\n  \"adapter\": \"claude-code\",\n  \"adapter_config\": {\n    \"auth\": \"subscription\",\n    \"model\": \"claude-sonnet-5\"\n  },\n  \"executor_identity\": {\n    \"name\": \"attavo executor (claude-code)\",\n    \"email\": \"executor+claude-code@attavo.invalid\"\n  },\n  \"reports\": [\n    \"tokens\",\n    \"cost_usd\"\n  ],\n  \"adapter_version\": \"2.1.283 (Claude Code)\",\n  \"model\": \"claude-sonnet-5\",\n  \"model_version\": \"claude-sonnet-5\",\n  \"iterations\": 1,\n  \"criteria\": [],\n  \"selected_tests\": null,\n  \"checks\": null,\n  \"tokens\": {\n    \"input\": 89849566,\n    \"output\": 211010\n  },\n  \"cost_usd\": 22.269941,\n  \"wall_clock_s\": 3509.641,\n  \"status\": \"halted\",\n  \"refusal\": null,\n  \"halted\": {\n    \"question\": null\n  },\n  \"stop\": {\n    \"class\": \"non-question\",\n    \"provenance\": \"executor\",\n    \"detail\": null\n  },\n  \"record_version\": 7,\n  \"item\": \"219\",\n  \"product_version\": \"v0.27.0-11-gd20fdea\",\n  \"product_pin\": \"v0.27.0\"\n}\n{\n  \"sha\": \"ae4fe380a038cc8d040c16486430a060997ff5c5\",\n  \"record_stage\": \"build\",\n  \"record\": \"build-01\",\n  \"at\": \"2026-09-26T03:07:14Z\",\n  \"adapter\": \"codex\
ccepted:\\n56\\t        return p.fail(f\\\"gate(s) that accepted their rejection fixture: {', '.join(accepted)}\\\")\\n57\\t    if no_retires:\\n58\\t        return p.fail(f\\\"gate(s) with no retires: {', '.join(no_retires)}\\\")\\n59\\t    return p.hold(f\\\"{len(gates)} gate(s) rejected their fixture\\\")\\n60\\t\\n61\\t\\n62\\tdef _merges_reachable(root: Path) -> tuple[list[dict[str, Any]], str | None]:\\n63\\t    \\\"\\\"\\\"(merges, refusal): every merge commit on the default branch's own\\n64\\t    first-parent line -- sha, parents, and its own first-parent diff --\\n65\\t    read by one process rather than the git log plus one git diff per\\n66\\t    merge merge_introducing_records used to pay walking toward the one\\n67\\t    it wants (issue #153). refs/remotes/origin/HEAD names the default\\n68\\t    branch without hard-coding \\\"main\\\", the same primitive\\n69\\t    diff_since_approval already uses (issue #52); walking from it rather\\n70\\t    than from HEAD is what keeps a transport merge on an item branch, a\\n71\\t    pull_request checkout's own synthetic test merge, and a merge_group's\\n72\\t    temporary merge from ever being mistaken for an item's merge (issue\\n73\\t    #169) -- none of those is reachable from the default branch's first-\\n74\\t    parent line by definition. When refs/remotes/origin/HEAD is not set,\\n75\\t    this refuses by name rather than guess, exactly as diff_since_approval\\n76\\t    does.\\n77\\t\\n78\\t    The walk starts at HEAD itself when the current checkout is literally\\n79\\t    on the branch refs/remotes/origin/HEAD names (an ordinary checko\n235 {\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01JWNPmFuq7TQmPjq3WRt9s5\",\"type\":\"tool_result\",\"content\":\"1\\tfrom __future__ import annotations\\n2\\t\\n3\\timport json\\n4\\tfrom pathlib import Path\\n5\\tfrom typing import Any\\n6\\t\\n7\\tfrom attavo.common import STAGES, ShallowCheckoutError, git\\n8\\tfrom attavo.doctor import invocations_without_record, merge_introducing_records, stall_bound_s\\n9\\tfrom attavo.drive import InvocationReading, drive_state, read_invocation, uncommitted_record\\n10\\tfrom attavo.records import next_attempt_number, parse_attempts\\n11\\tfrom attavo.types import CounselRecord, DriveReport\\n12\\tfrom attavo.verify import FORGE_OK_CONCLUSIONS, FORGE_UNCONCLUDED_STATUSES, read_forge_checks\\n13\\t\\n14\\t# --- drive --report (reconciler R1, rulings A and G): what one item is\\n15\\t# waiting on, and for whom -- drive's own decision (drive_state, the\\n16\\t# invocation readers recovery uses, read_forge_checks) read without acting\\n17\\t# on it. It writes nothing, starts nothing, and reads the forge once and\\n18\\t# never polls it, so a refusal is a level anyone can read again rather than\\n19\\t# a line drive printed once. `says` speaks the operator's words: a stage is\\n20\\t# \\\"build\\\" or \\\"review\\\", never the command that runs it. ---\\n21\\t\\n22\\t_WORD = {\\\"build\\\": \\\"build\\\", \\\"verify\\\": \\\"review\\\"}\\n23\\t\\n24\\t_COUNSEL_SAYS = {\\\"answer\\\": \\\"has an answer\\\", \\\"patch\\\": \\\"found a product defect\\\",\\n25\\t                 \\\"person\\\": \\\"says it is a person's call\\\"}\\n26\\t\\n27\\t\\n28\\tdef _head(root: Path) -> str | None:\\n29\\t    try:\\n30\\t        return git(root, \\\"rev-parse\\\", \\\"HEAD\\\").strip() or None\\n31\\t    except RuntimeError:\\n32\\t        return None\\n33\\t\\n34\\t\\n35\\tdef _latest(records_dir: Path, stage: str) -> tuple[str, dict[str, Any]] | None:\\n36\\t    \\\"\\\"\\\"(stem, record) of the highest-numbered <stage>-NN.json, or None.\\\"\\\"\\\"\\n37\\t    attempts = parse_attempts(records_dir, stage)\\n38\\t    if not attempts:\\n39\\t        return None\\n40\\t    nn = max(attempts)\\n41\\t    return f\\\"{stage}-{nn:02d}\\\", attempts[nn]\\n42\\t\\n43\\t\\n44\\tdef _filed(records_dir: Path, stem: str) -> str | None:\\n45\\t    marker = records_dir / f\\\"{stem}.filed\\\"\\n46\\t    try:\\n47\\t        text = marker.read_text().strip()\\n48\\t    except OSError:\\n49\\t        return None\\n50\\t    return text or None\\n51\\t\\n52\\t\\n53\\tdef _counsel_of(records_dir: Path, stem: str) -> tuple[str, CounselRecord] | None:\\n54\\t    \\\"\\\"\\\"The latest counsel record that read the stop named stem.\\\"\\\"\\\"\\n55\\t    attempts = parse_attempts(records_dir, \\\"counsel\\\")\\n56\\t    for nn in sorted(attempts, reverse=True):\\n57\\t        if attempts[nn].get(\\\"record\\\") == stem:\\n58\\t            return f\\\"counsel-{nn:02d}\\\", attempts[nn]\\n59\\t    return None\\n60\\t\\n61\\t\\n62\\tdef _stopped(r: DriveReport, records_dir: Path, stage: str, stem: str, record: dict[str, Any]) -> DriveReport:\\n63\\t    stop = record.get(\\\"stop\\\") or {}\\n64\\t    stop_class = stop.get(\\\"class\\\")\\n65\\t    r[\\\"state\\\"], r[\\\"kind\\\"], r[\\\"stage\\\"] = \\\"stopped\\\", \\\"yours\\\", stage\\n66\\t    r[\\\"attempt\\\"], r[\\\"record\\\"], r[\\\"stop_class\\\"] = int(stem.rsplit(\\\"-\\\", 1)[1]), stem, stop_class\\n67\\t    r[\\\"filed\\\"] = _filed(records_dir, stem)\\n68\\t    how = f\\\"as {stop_class}\\\" if stop_class else f\\\"({record.get('status')})\\\"\\n69\\t    says = f\\\"Needs you: {_WORD[stage]} attempt {stem.rsplit('-', 1)[1]} stopped {how}\\\"\\n70\\t    counsel = _counsel_of(records_dir, stem)\\n71\\t    if counsel:\\n72\\t        r[\\\"counsel\\\"] = counsel[0]\\n73\\t        verdict = _COUNSEL_SAYS.get(str(counsel[1].get(\\\"verdict\\\")))\\n74\\t        says += f\\\"; {counsel[0]} {verdict or 'could not read it'}\\\"\\n75\\t    if r[\\\"filed\\\"]:\\n76\\t        says += f\\\"; filed as {r['filed']}\\\"\\n77\\t    attempts = parse_attempts(records_dir, stage)\\n78\\t    rows: list[dict[str, Any]] = [\\n79\\t        {\\\"attempt\\\": nn, \\\"class\\\": ((rec.get(\\\"stop\\\") or {}).get(\\\"class\\\")),\\n80\\t         \\\"signature\\\": ((rec.get(\\\"stop\\\") or {}).get(\\\"signature
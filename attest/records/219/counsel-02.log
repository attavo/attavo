eads it exactly like any other non-pass record, and\\n# an \\\"answer\\\" verdict starts the next attempt steered by it, the same as\\n# any class counsel can rule on; a question nobody answers (no counsel\\n# configured, or its own verdict is \\\"person\\\") simply never becomes\\n# eligible, with no exclusion needed to keep it that way.\\nNEVER_RETRIED_CLASSES = (\\\"claims-boundary\\\", \\\"gate\\\", \\\"environment\\\")\",\"originalFile\":\"from __future__ import annotations\\n\\nimport io\\nimport json\\nimport os\\nimport signal\\nimport subprocess\\nimport sys\\nimport threading\\nimport time\\nfrom pathlib import Path\\nfrom typing import TYPE_CHECKING, Any, NamedTuple, cast\\n\\nfrom attavo.approval import approval_status\\nfrom attavo.build import cmd_build, driver_identity\\nfrom attavo.common import MANIFEST, PRODUCT_ROOT, derive_item_id, git, read_manifest\\nfrom attavo.counsel import cmd_counsel\\nfrom attavo.doctor import (\\n    _parse_json_line,\\n    attempts_budget,\\n    ceiling_s,\\n    invocation_alive,\\n    invocations_without_record,\\n    retry_after_s,\\n    stall_bound_s,\\n    write_invocation_marker,\\n)\\nfrom attavo.events import stage_events_dir\\nfrom attavo.filing import cmd_file_stops\\nfrom attavo.records import (\\n    latest_attempt_path,\\n    latest_record,\\n    next_attempt_number,\\n    parse_attempts,\\n    stage_schema,\\n    write_record,\\n)\\nfrom attavo.stops import RETRYABLE_CLASSES, counsel_record_for, signature_of\\nfrom attavo.verify import cmd_verify, read_forge_checks\\n\\nif TYPE_CHECKING:\\n    from attavo.types import DriveReport\\n\\n# --- drive: the mechanical transitions between approval and ready-to-merge\\n# (issue #84), under the reconciler's R2 (rulings A, B, C's recovery half,\\n# F, G, H): `attavo drive N` is one short pass. It reads the report\\n# (attavo.report), acts at most once -- recovers a dead or hung\\n# invocation, or starts the next stage in a detached worker -- and\\n# returns within seconds; the stage itself runs in `attavo worker`, a\\n# child of the pass's own session, which outlives it. Writes no record of\\n# its own: the stage records already on disk, and the invocation markers\\n# and heartbeats beside them, are the only state a pass or a worker\\n# reads. ---\\n\\n\\ndef commit_record(root: Path, record_paths: Path | list[Path], message: str) -> None:\\n    \\\"\\\"\\\"`git commit --only` on every record path given, and each one's .log\\n    and .filed, each if one exists -- never the whole index. A transport\\n    commit that sweeps the index is exactly the regression issue #46\\n    already guards build and verify against on the adapter side; drive\\n    must not reintroduce it on the transport side. The .filed marker\\n    (issue #89) is committed alongside the record it names, in the same\\n   \n1393 {\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_015F4Zv4B9naYxo5NJjsXXms\",\"type\":\"tool_result\",\"content\":\"The file /Users/davidbean/Projects/attavo-worktree-219/attavo/report.py has been updated successfully.\"}]},\"parent_tool_use_id\":null,\"session_id\":\"ae622d81-efb9-4dda-92a0-5ebf75b0d73f\",\"uuid\":\"354f3444-cfeb-4b40-932f-cf4f4115e0bf\",\"timestamp\":\"2026-09-26T03:51:35.892Z\",\"tool_use_result\":{\"filePath\":\"/Users/davidbean/Projects/attavo-worktree-219/attavo/report.py\",\"oldString\":\"        says += f\\\"; {counsel[0]} {verdict_says or 'could not read it'}\\\"\\n        if verdict == \\\"patch\\\" and r[\\\"filed\\\"]:\\n            says += f\\\"; waiting on {r['filed']}\\\"\\n    if r[\\\"filed\\\"] and \\\"waiting on\\\" not in says:\\n        says += f\\\"; filed as {r['filed']}\\\"\",\"newString\":\"        says += f\\\"; {counsel[0]} {verdict_says or 'could not read it'}\\\"\\n        if verdict == \\\"patch\\\":\\n            says += f\\\"; waiting on {r['filed'] or 'the issue counsel filed'}\\\"\\n    if r[\\\"filed\\\"] and \\\"waiting on\\\" not in says:\\n        says += f\\\"; filed as {r['filed']}\\\"\",\"originalFile\":\"from __future__ import annotations\\n\\nimport json\\nfrom pathlib import Path\\nfrom typing import Any\\n\\nfrom attavo.common import STAGES, ShallowCheckoutError, git\\nfrom attavo.doctor import invocations_without_record, merge_introducing_records, stall_bound_s\\nfrom attavo.drive import InvocationReading, drive_state, read_invocation, retry_state, uncommitted_record\\nfrom attavo.records import next_attempt_number, parse_attempts\\nfrom attavo.types import CounselRecord, DriveReport\\nfrom attavo.verify import FORGE_OK_CONCLUSIONS, FORGE_UNCONCLUDED_STATUSES, read_forge_checks\\n\\n# --- drive --report (reconciler R1, rulings A and G): what one item is\\n# waiting on, and for whom -- drive's own decision (drive_state, the\\n# invocation readers recovery uses, read_forge_checks) read without acting\\n# on it. It writes nothing, starts nothing, and reads the forge once and\\n# never polls it, so a refusal is a level anyone can read again rather than\\n# a line drive printed once. `says` speaks the operator's words: a stage is\\n# \\\"build\\\" or \\\"review\\\", never the command that runs it. ---\\n\\n_WORD = {\\\"build\\\": \\\"build\\\", \\\"verify\\\": \\\"review\\\"}\\n\\n_COUNSEL_SAYS = {\\\"answer\\\": \\\"has an answer\\\", \\\"patch\\\": \\\"found a product defect\\\",\\n                 \\\"person\\\": \\\"says it is a person's call\\\"}\\n\\n\\ndef _head(root: Path) -> str | None:\\n    try:\\n        return git(root, \\\"rev-parse\\\", \\\"HEAD\\\").strip() or None\\n    except RuntimeError:\\n        return None\\n\\n\\ndef _latest(records_dir: Path, stage: str) -> tuple[str, dict[str, Any]] | None:\\n    \\\"\\\"\\\"(stem, record) of the highest-numbered <stage>-NN.json, or None.\\\"\\\"\\\"\\n    attempts = parse_attempts(records_dir, stage)\\n    if not attempts:\\n        return None\\n    nn = max(attempts)\\n    return f\\\"{stage}-{nn:02d}\\\", attempts[nn]\\n\\n\\ndef _filed(records_dir: Path, stem: str) -> str | None:\\n    marker = records_dir / f\\\"{stem}.filed\\\"\\n    try:\\n        text = marker.read_text().strip()\\n    except OSError:\\n        return None\\n    return text or None\\n\\n\\ndef _counsel_of(records_dir: Path, stem: str) -> tuple[str, CounselRecord] | None:\\n    \\\"\\\"\\\"The latest counsel record that read the stop named stem.\\\"\\\"\\\"\\n    attempts = parse_attempts(records_dir, \\\"counsel\\\")\\n    for nn in sorted(attempts, reverse=True):\\n        if attempts[nn].get(\\\"record\\\") == stem:\\n            return f\\\"counsel-{nn:02d}\\\", attempts[nn]\\n    return None\\n\\n\\ndef _stopped(root: Path, m: dict[str, Any], r: DriveReport, records_dir: Path, stage: str,\\n            stem: str, record: dict[str, Any]) -> DriveReport:\\n    stop = record.get(\\\"stop\\\") or {}\\n    stop_class = stop.get(\\\"class\\\")\\n    attempt = int(stem.rsplit(\\\"-\\\", 1)[1])\\n    r[\\\"state\\\"], r[\\\"kind\\\"], r[\\\"stage\\\"] = \\\"stopped\\\", \\\"yours\\\", stage\\n    r[\\\"attempt\\\"], r[\\\"record\\\"], r[\\\"stop_class\\\"] = attempt, stem, stop_class\\n    r[\\\"filed\\\"] = _filed(records_dir\n1456 {\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01LXxsjjF6tR6SoiwGJvYQcq\",\"type\":\"tool_result\",\"content\":\"The file /Users/davidbean/Projects/attavo-worktree-219/tests/test_report.py has been updated successfully.\"}]},\"parent_tool_use_id\":null,\"session_id\":\"ae622d81-efb9-4dda-92a0-5ebf75b0d73f\",\"uuid\":\"b1fca018-55b4-4e9e-a68b-46f0fa7e8495\",\"timestamp\":\"2026-09-26T03:57:00.796Z\",\"tool_use_result\":{\"filePath\":\"/Users/davidbean/Projects/attavo-worktree-219/tests/test_report.py\",\"oldString\":\"def test_report_names_the_stopped_record_its_class_its_counsel_and_its_issue(tmp_path: Path) -> None:\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    add_drive_stall_bound(root)\\n    approve_item(root)\\n    write_dead_marker(root, \\\"build\\\", 1)\\n    assert drive(root, \\\"1\\\").returncode == 0\\n    d = records_dir(root)\\n    (d / \\\"build-01.filed\\\").write_text(\\\"https://example.invalid/issues/9\\\\n\\\")\\n    commit_all(root, \\\"the stop is filed\\\")\\n    out = report(root)\\n    assert (out[\\\"state\\\"], out[\\\"kind\\\"], out[\\\"record\\\"], out[\\\"stop_class\\\"], out[\\\"filed\\\"]) == (\\n        \\\"stopped\\\", \\\"yours\\\", \\\"build-01\\\", \\\"died\\\", \\\"https://example.invalid/issues/9\\\"), out\\n    assert out[\\\"says\\\"].startswith(\\\"Needs you: build attempt 01 stopped as died\\\"), out\",\"newString\":\"def test_report_names_the_stopped_record_its_class_its_counsel_and_its_issue(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"R3: died is one of the four plain retryable families -- inside its\\n    budget, the report reads it as \\\"acts\\\" (the next pass retries it on\\n    its own), not \\\"yours\\\"; a filed issue is still named regardless.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    add_drive_stall_bound(root)\\n    approve_item(root)\\n    write_dead_marker(root, \\\"build\\\", 1)\\n    assert drive(root, \\\"1\\\").returncode == 0\\n    d = records_dir(root)\\n    (d / \\\"build-01.filed\\\").write_text(\\\"https://example.invalid/issues/9\\\\n\\\")\\n    commit_all(root, \\\"the stop is filed\\\")\\n    out = report(root)\\n    assert (out[\\\"state\\\"], out[\\\"kind\\\"], out[\\\"record\\\"], out[\\\"stop_class\\\"], out[\\\"filed\\\"]) == (\\n        \\\"stopped\\\", \\\"acts\\\", \\\"build-01\\\", \\\"died\\\", \\\"https://example.invalid/issues/9\\\"), out\\n    assert out[\\\"says\\\"].startswith(\\\"Build attempt 01 stopped as died\\\"), out\",\"originalFile\":\"\\\"\\\"\\\"`attavo drive N --report`: what one item is waiting on and for whom, as a\\npure function of its records, its markers, and one read of the forge. It\\nwrites nothing, starts nothi
enance\\\": \\\"tenant\\\",\\n                           \\\"detail\\\": \\\"no jsonschema\\\"}\\n    assert rec[\\\"checks\\\"] == {\\\"command\\\": \\\"echo no jsonschema; exit 2\\\", \\\"exit\\\": 2}\\n    # the adapter never ran: no commit, no model, the stub file untouched\\n    assert rec[\\\"sha\\\"] == rec[\\\"start_sha\\\"]\\n    assert rec[\\\"model\\\"] is None\\n    assert not (root / \\\"built.txt\\\").is_file()\\n\\n    schema = json.loads((ROOT / \\\"schema\\\" / \\\"records\\\" / \\\"build.schema.json\\\").read_text())\\n    jsonschema.validate(rec, schema)\",\"stderr\":\"\",\"interrupted\":false,\"isImage\":false,\"noOutputExpected\":false}}\n1512:{\"type\":\"assistant\",\"message\":{\"model\":\"claude-sonnet-5\",\"id\":\"msg_011CfRPC1jF4yipMD4vJJ1LS\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_018MjHUop9pfFkg68Pg8WGUj\",\"name\":\"Bash\",\"input\":{\"command\":\"python3 - <<'EOF'\\nimport re\\npath = \\\"tests/test_build.py\\\"\\ntext = open(path).read()\\n\\nreplacements = [\\n    ('assert rec[\\\"stop\\\"] == {\\\"class\\\": \\\"claims-boundary\\\", \\\"provenance\\\": \\\"executor\\\", \\\"detail\\\": None}',\\n     'assert rec[\\\"stop\\\"] == {\\\"class\\\": \\\"claims-boundary\\\", \\\"provenance\\\": \\\"executor\\\", \\\"detail\\\": None,\\\\n'\\n     '                       \\\"signature\\\": None, \\\"bound\\\": None}'),\\n    ('assert rec[\\\"stop\\\"] == {\\\"class\\\": \\\"claims-boundary\\\", \\\"provenance\\\": \\\"spec\\\", \\\"detail\\\": None}',\\n     'assert rec[\\\"stop\\\"] == {\\\"class\\\": \\\"claims-boundary\\\", \\\"provenance\\\": \\\"spec\\\", \\\"detail\\\": None,\\\\n'\\n     '                       \\\"signature\\\": None, \\\"bound\\\": None}'),\\n    ('assert rec[\\\"stop\\\"] == {\\\"class\\\": \\\"ceiling\\\", \\\"provenance\\\": \\\"product\\\", \\\"detail\\\": None}',\\n     'assert rec[\\\"stop\\\"] == {\\\"class\\\": \\\"ceiling\\\", \\\"provenance\\\": \\\"
y] | None, again_by: bool = False) -> int:\\n527\\t    \\\"\\\"\\\"The lease (ruling A): the marker, committed and pushed as a plain\\n528\\t    fast-forward with no merge and no retry (push_lease). Lost to another\\n529\\t    pass, or refused outright by the remote, both undo the marker commit\\n530\\t    here (git reset --hard) so this checkout carries no half-taken\\n531\\t    attempt either way; only a pushed lease starts the worker. On a\\n532\\t    review, forge_checks is the checks this same pass already read on\\n533\\t    the pre-marker head (ruling B) -- written to\\n534\\t    <git-dir>/attavo/verify-NN.forge-checks.json and named in\\n535\\t    ATTAVO_FORGE_CHECKS, so the worker's own `attavo verify` reads it\\n536\\t    instead of polling. again_by (R3) is true only when `--again` is what\\n537\\t    started this attempt, past a budget already spent or an early stop\\n538\\t    -- named in the marker, never on an ordinary or plainly-retried\\n539\\t    attempt.\\\"\\\"\\\"\\n540\\t    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n541\\t    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n542\\t    nn = next_attempt_number(records_dir, stage)\\n543\\t    marker = write_invocation_marker(root, records_dir, stage, nn, again_by=again_by)\\n544\\t    try:\\n545\\t        commit_record(root, [marker], f\\\"attavo: {stage} invocation {nn:02d} started for item {item_id}\\\")\\n546\\t    except RuntimeError as exc:\\n547\\t        print(f\\\"attavo drive: stopped: could not commit the {stage} invocation marker: {exc}\\\")\\n548\\t        return 1\\n549\\t\\n550\\t    if has_origin(root):\\n551\\t        outcome, err = push_lease(root, branch)\\n552\\t        if outcome != \\\"pushed\\\":\\n553\\t            git(root, \\\"reset\\\", \\\"--hard\\\", \\\"HEAD^\\\")\\n554\\t            if outcome == \\\"lost-race\\\":\\n555\\t                print(f\\\"attavo drive: another pass holds this attempt ({marker.name}); nothing started\\\")\\n556\\t                return 0\\n557\\t            print(f\\\"attavo drive: stopped: could not push the {stage} invocation marker: {err}\\\")\\n558\\t            return 1\\n559\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"061dd881-711c-41db-8604-438f84ab7c7d\",\"uuid\":\"684f5374-90aa-4d55-a230-c2ce418e5be9\",\"timestamp\":\"2026-09-26T05:21:17.363Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/davidbean/Projects/attavo-worktree-219/attavo/drive.py\",\"content\":\"def _start_stage(root: Path, m: dict[str, Any], item_id: str, stage: str,\\n                 forge_checks: dict[str, Any] | None, again_by: bool = False) -> int:\\n    \\\"\\\"\\\"The lease (ruling A): the marker, committed and pushed as a plain\\n    fast-forward with no merge and no retry (push_lease). Lost to another\\n    pass, or refused outright by the remote, both undo the marker commit\\n    here (git reset --hard) so this checkout carries no half-taken\\n    attempt either way; only a pushed lease starts the worker. On a\\n    review, forge_checks is the checks this same pass already read on\\n    the pre-marker head (ruling B) -- written to\\n    <git-dir>/attavo/verify-NN.forge-checks.json and named in\\n    ATTAVO_FORGE_CHECKS, so the worker's own `attavo verify` reads it\\n    instead of polling. again_by (R3) is true only when `--again` is what\\n    started this attempt, past a budget already spent or an early stop\\n    -- named in the marker, never on an ordinary or plainly-retried\\n    attempt.\\\"\\\"\\\"\\n    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n    nn = next_attempt_number(records_dir, stage)\\n    marker = write_invocation_marker(root, records_dir, stage, nn, again_by=again_by)\\n    try:\\n        commit_record(root, [marker], f\\\"attavo: {stage} invocation {nn:02d\n2808 {\"type\":\"assistant\",\"message\":{\"model\":\"claude-sonnet-5\",\"id\":\"msg_011CfRVLarUJmKCzn7CDhEYz\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"I dug into the situation before making any further changes. Here's what I found:\\n\\n**The actual code for item 219 is already complete.** Commit `7fb8a9b` (already on this branch) implements the full R3 spec \\u2014 retry families, budget, signatures, ceilings, the returned-record path \\u2014 matching the spec and criteria. Nothing in the working tree is uncommitted; there's no new code work to commit.\\n\\n**The one residual gate failure** (`test_no_invocation_lacks_record`) is caused by a stray `attest/records/219/build-02.started` marker whose worker process (pid 92012) is dead but never wrote `build-02.json`. This is self-hosting bookkeeping, not part of item 219's claimed files. I used the product's own sanctioned recovery path (`attavo drive 219`, a single pass) to recover it as `hung`/`ceiling` \\u2014 that's exactly the mechanism this build adds, and it committed cleanly under the `attavo driver` identity (push to `origin` was refused by the sandbox's network policy, harmlessly, since GitHub isn't reachable from here).\\n\\n**Then something destructive happened:** running `python3 bin/attavo test 219` (as instructed) selected the whole suite, because `attavo/stops.py` is deliberately unmapped in `select-tests` (it's a widely-imported core module, by design). Somewhere in that run, `git reset --hard HEAD^` executed against *this real worktree* \\u2014 the same line in `attavo/drive.py:553` that `_start_stage` uses to undo a lease commit whose push failed. It silently wiped out my recovery commit, landing HEAD back at `7fb8a9b`. I did not run this deliberately; it happened as a side effect of the test run in an environment with no network access to `origin`. The repo is now back to its exact starting state (clean, `7fb8a9b`), so no work was lost, but I don't want to blindly repeat the recovery step and retrigger the same reset, and I don't think re-diagnosing which specific test/fixture leaks the real repo as `cwd` for that git call is in scope for item 219.\\n\\nGiven the code is done and the only open item is this self-hosting bookkeeping artifact (which looks like the driver/harness's job in its own networked environment, not the build executor's), how do you want me to proceed \\u2014 leave it for the driver to recover, or do you want me to chase down the test that's issuing that unscoped `git reset --hard HEAD^`?\"}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":973,\"cache_read_input_tokens\":108220,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":973},\"output_tokens\":4,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"061dd881-711c-41db-8604-438f84ab7c7d\",\"uuid\":\"4b478e38-d96b-4261-b1b6-5a64473b7217\",\"timestamp\":\"2026-09-26T05:22:55.581Z\",\"request_id\":\"req_011CfRVLaRB4CXQvCCVohP3f\"}\n2809 {\"type\":\"assistant\",\"message\":{\"model\":\"claude-sonnet-5\",\"id\":\"msg_011CfRVLarUJmKCzn7CDhEYz\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_0138je4ZFn4TZSp93BFb55ph\",\"name\":\"StructuredOutput\",\"input\":{\"status\":\"question\",\"question\":\"Item 219's code is already complete and committed (7fb8a9b matches the spec/criteria). The only remaining gate failure is a stray attest/records/219/build-02.started marker with a dead worker pid and no record. I recovered it once using the product's own `attavo drive` recovery pass, but a subsequent `attavo test 219` run (which falls back to the whole suite because attavo/stops.py is intentionally unmapped in select-tests) triggered a `git reset --hard HEAD^` inside attavo/drive.py's own lease-push-failure path, silently destroying that recovery commit (push failed because this sandbox has no network to github.com). The repo is back to its clean starting state at 7fb8a9b, no work lost. Should I: (a) leave the stray build-02 marker for the driver/harness to recover in its own networked environment (since that's its role, not the executor's), or (b) track down which test/fixture is leaking the real repo as cwd into that git reset call so it can't clobber real history when run in a no-network sandbox?\"},\"caller\":{\"type\":\"direct\"}}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":973,\"cache_read_input_tokens\":108220,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":973},\"output_tokens\":4,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"061dd881-711c-41db-8604-438f84ab7c7d\",\"uuid\":\"3407a61a-8c9a-47f3-a13b-0f7dcdbecc34\",\"timestamp\":\"2026-09-26T05:22:59.125Z\",\"request_id\":\"req_011CfRVLaRB4CXQvCCVohP3f\",\"wire_tool_inputs\":{\"toolu_0138je4ZFn4TZSp93BFb55ph\":{\"status\":\"question\",\"question\":\"Item 219's code is already complete and committed (7fb8a9b matches the spec/criteria). The only remaining gate failure is a stray attest/records/219/build-02.started marker with a dead worker pid and no record. I recovered it once using the product's own `attavo drive` recovery pass, but a subsequent `attavo test 219` run (which falls back to the whole suite because attavo/stops.py is intentionally unmapped in select-tests) triggered a `git reset --hard HEAD^` inside attavo/drive.py's own lease-push-failure path, silently destroying that recovery commit (push failed because this sandbox has no network to github.com). The repo is back to its clean starting state at 7fb8a9b, no work lost. Should I: (a) leave the stray build-02 marker for the driver/harness to recover in its own networked environment (since that's its role, not the executor's), or (b) track down which test/fixture is leaking the real repo as cwd into that git reset call so it can't clobber real history when run in a no-network sandbox?\"}}}\n2811 {\"duration_api_ms\":699640,\"stop_reason\":\"tool_use\",\"session_id\":\"061dd881-711c-41db-8604-438f84ab7c7d\",\"total_cost_usd\":1.5361046,\"usage\":{\"input_tokens\":94,\"cache_creation_input_tokens\":89792,\"cache_read_input_tokens\":3283843,\"output_tokens\":51998,\"output_tokens_details\":{\"thinking_tokens\":45370},\"server_tool_use\":{\"web_search_requests\":0,\"web_fetch_requests\":0},\"service_tier\":\"standard\",\"cache_creation\":{\"ephemeral_1h_input_tokens\":89792,\"ephemeral_5m_input_tokens\":0},\"inference_geo\":\"not_available\",\"iterations\":[{\"input_tokens\":2,\"output_tokens\":8793,\"cache_read_input_tokens\":108220,\"cache_creation_input_tokens\":973,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":973},\"type\":\"message\"}],\"speed\":\"standard\"},\"modelUsage\":{\"claude-sonnet-5\":{\"inputTokens\":94,\"outputTokens\":51998,\"cacheReadInputTokens\":3283843,\"cacheCreationInputTokens\":89792,\"webSearchRequests\":0,\"costUSD\":1.5361046,\"contextWindow\":1000000,\"maxOutputTokens\":64000,\"thinkingTokens\":45370,\"canonicalModel\":\"claude-sonnet-5\",\"provider\":\"firstParty\",\"costBasis\":\"list\"}},\"permission_denials\":[],\"terminal_reason\":\"completed\",\"fast_mode_state\":\"off\",\"fast_mode_disabled_reason\":\"sdk_opt_in_required\",\"subagent_stats\":{\"spawned\":0,\"requested\":{\"background\":0,\"foreground\":0,\"unset\":0},\"started_in_background\":0,\"max_depth\":0,\"spawned_by_subagents\":0,\"completed\":0,\"failed\":0,\"killed\":{\"parent\":0,\"user\":0,\"system\":0},\"refused\":{\"depth_limit\":0,\"concurrency_limit\":0,\"budget\":0},\"by_type\":{}},\"is_error\":false,\"num_turns\":49,\"subtype\":\"success\",\"api_error_status\":null,\"result\":\"{\\\"status\\\":\\\"question\\\",\\\"question\\\":\\\"Item 219's code is already complete and committed (7fb8a9b matches the spec/criteria). The only remaining gate failure is a stray attest/records/219/build-02.started marker with a dead worker pid and no record. I recovered it once using the product's own `attavo drive` recovery pass, but a subsequent `attavo test 219` run (which falls back to the whole suite because attavo/stops.py is intentionally unmapped in select-tests) triggered a `git reset --hard HEAD^` inside attavo/drive.py's own lease-push-failure path, silently destroying that recovery commit (push failed because this sandbox has no network to github.com). The repo is back to its clean starting state at 7fb8a9b, no work lost. Should I: (a) leave the stray build-02 marker for the driver/harness to recover in its own networked environment (since that's its role, not the executor's), or (b) track down which test/fixture is leaking the real repo as cwd into that git reset call so it can't clobber real history when run in a no-network sandbox?\\\"}\",\"structured_output\":{\"status\":\"question\",\"question\":\"Item 219's code is already complete and committed (7fb8a9b matches the spec/criteria). The only remaining gate failure is a stray attest/records/219/build-02.started marker with a dead worker pid and no record. I recovered it once using the product's own `attavo drive` recovery pass, but a subsequent `attavo test 219` run (which falls back to the whole suite because attavo/stops.py is intentionally unmapped in select-tests) triggered a `git reset --hard HEAD^` inside attavo/drive.py's own lease-push-failure path, silently destroying that recovery commit (push failed because this sandbox has no network to github.com). The repo is back to its clean starting state at 7fb8a9b, no work lost. Should I: (a) leave the stray build-02 marker for the driver/harness to recover in its own networked environment (since that's its role, not the executor's), or (b) track down which test/fixture is leaking the real repo as cwd into that git reset call so it can't clobber real history when run in a no-network sandbox?\"},\"ttft_ms\":4534,\"type\":\"result\",\"duration_ms\":950620,\"uuid\":\"0c2ba3fe-2d93-4d17-ade0-771c141cae5f\",\"ttft_stream_ms\":4141,\"time_to_request_ms\":58,\"first_content_frame_ms\":4142,\"queued_turn_count\":0,\"result_index\":0}\n        return False, f\"push rejected and the retry merge failed: {pull.stderr.strip() or err}\"\n    ok, err = attempt()\n    if not ok:\n        return False, f\"push rejected again after merging {branch}: {err}\"\n    return True, None\n\n\n_RACE_MARKERS = (\"non-fast-forward\", \"fetch first\", \"stale info\", \"cannot lock ref\",\n                 \"failed to update ref\")\n\n\ndef push_lease(root: Path, branch: str) -> tuple[str, str | None]:\n    \"\"\"Push HEAD to branch on origin as a plain fast-forward -- no merge,\n    no retry: this is the lease the marker commit takes on the attempt it\n    names (ruling A). (\"pushed\", None) on success.\n\n    (\"lost-race\", stderr) when git's own ref check is what rejected it --\n    the branch moved since this pass fast-forwarded to it (a sequential\n    \"[rejected] ... (fetch first)\"), or the remote's own ref transaction\n    lost a genuine simultaneous push (\"[remote rejected] ... (failed to\n    update ref)\", \"cannot lock ref\"): either way, another pass's own\n    marker (or record) landed there first. The pass that reads this is\n    the loser: it says so, resets its own marker commit, and starts\n    nothing.\n\n    (\"refused\", stderr) for every other rejection -- a remote that\n    refuses the push outright (a hook, a permission, an unreachable\n    remote). This is not a race for the lease; it is a refusal, and ends\n    the pass with exit 1.\"\"\"\n    run = subprocess.run([\"git\", \"-C\", str(root), \"push\", \"origin\", f\"HEAD:{branch}\"],\n                         capture_output=True, text=True, check=False)\n    if run.returncode == 0:\n        return \"pushed\", None\n    stderr = run.stderr\n    if any(marker in stderr for marker in _RACE_MARKERS):\n        return \"lost-race\", stderr.strip()\n    return \"refused\", stderr.strip()\n\n\ndef has_origin(root: Path) -> bool:\n    \"\"\"Whether this checkout carries an origin remote at all -- a fixture\n    or a scratch checkout with none is not a refusal; a pass commits\n    locally and skips the push, the way recovery always has.\"\"\"\n    try:\n        git(root, \"remote\", \"get-url\", \"origin\")\n        return True\n    except RuntimeError:\n        return False\n\n\ndef drive_state(root: Path, m: dict[str, Any], item_id: str) -> tuple[str, str | None, Path]:\n    if not name:\n        return True\n    for base in (root / \"attavo\" / \"adapters\", PRODUCT_ROOT / \"adapters\"):\n        conf = base / name / \"conformance.json\"\n        if conf.is_file():\n            try:\n                return bool(json.loads(conf.read_text()).get(\"streams_events\", True))\n            except (OSError, ValueError):\n                return True\n    return True\n\n\ndef read_invocation(root: Path, bound: int | None, marker: Path, info: dict[str, Any]) -> InvocationReading:\n    \"\"\"Whether an invocation that began and wrote no record is running,\n    hung, or died -- read from its own heartbeat first (R2): a heartbeat\n    file fresh within three beats of ATTAVO_HEARTBEAT_S is alive; a stale\n    one is died, whether or not the pid still lives -- a worker stuck\n    somewhere that never reaches its own heartbeat loop again is exactly\n    what this is for. Only with no heartbeat file at all -- an invocation\n    from before this release, or one that died before touching its\n    first beat -- does this fall back to the pid: alive and, with a\n    stall bound declared, past it is hung; alive with no bound, or\n    within it, is running for as long as it lives; not alive is died.\n    The stall bound decides hung, never died.\n\n    R3: the stage's own ceiling (wall clock from the marker's own `at`)\n    is judged first, before any of that -- alive past it is hung by the\n    ceiling whatever event age says, and an adapter that declares it\n    streams no events is judged by the ceiling alone: bound is read as\n    None for it, so the stall check below never fires on an event age it\n    never had.\"\"\"\n    stage, nn_text = marker.stem.rsplit(\"-\", 1)\n    nn = int(nn_text)\n    log, last_at = _events_tail(_events_path_for(root, stage, nn))\n    m = _manifest_of(root)\n    ceiling = ceiling_s(m, stage)\n    since_start = _seconds_since(info.get(\"at\"))\n    if ceiling is not None and since_start is not None and since_start > ceiling:\n        return InvocationReading(stage, nn, log, last_at, since_start, \"hung\", \"ceiling\")\n    if not _streams_events(root, m, stage):\n        bound = None\n    beat = heartbeat_path(root, stage, nn)\n    if beat.is_file():\n        try:\n            beat_age = time.time() - beat.stat().st_mtime\n        except OSError:\n            beat_age = None\n        cls = \"running\" if beat_age is not None and beat_age <= heartbeat_s() * 3 else \"died\"\n        return InvocationReading(stage, nn, log, last_at, beat_age, cls)\n    age = _seconds_since(last_at or info.get(\"at\"))\n    if not invocation_alive(info):\n        return InvocationReading(stage, nn, log, last_at, age, \"died\")\n    if bound is None or age is None or age <= bound:\n        return InvocationReading(stage, nn, log, last_at, age, \"running\")\n    return InvocationReading(stage, nn, log, last_at, age, \"hung\", \"stall\")\n\n\ndef uncommitted_record(root: Path, records_dir: Path, stage: str) -> Path | None:\n    \"\"\"The latest <stage>-NN.json this working tree carries that git has\n    no commit for yet -- the moment between a worker's write and its own\n    commit. None when the latest record is already committed, or there\n    is none at all.\"\"\"\n    path = latest_attempt_path(records_dir, stage)\n    if path is None or not path.is_file():\n        return None\n    status = subprocess.run(\n        [\"git\", \"-C\", str(root), \"status\", \"--porcelain\", \"--\", str(path.relative_to(root))],\n        capture_output=True, text=True, check=False)\n    return path if status.stdout.strip() else None\n\n\ndef worker_holds_copy(root: Path, records_dir: Path) -> bool:\n    \"\"\"True when this checkout's own working tree cannot safely be moved\n    -- an invocation marker with no record yet (a worker, here or\n    elsewhere, still holds this attempt), or a build or verify record the\n    working tree carries that git has not committed yet. Scoped to the\n    stage records a pass or a worker itself ever transports -- an\n    operator's own spec-gate or approve, routinely uncommitted between\n    their own act and the next pass, is not this. A pass never\n    fast-forwards while this holds (never while a worker holds the\n    copy).\"\"\"\n    if invocations_without_record(records_dir):\n        return True\n    return (uncommitted_record(root, records_dir, \"build\") is not None\n           or uncommitted_record(root, records_dir, \"verify\") is not None)\n\n\ndef fast_forward_to_origin(root: Path, m: dict[str, Any], item_id: str) -> None:\n    \"\"\"The pass's own read of origin's branch, taken before it reads\n    anything else -- a commit landed there from elsewhere (an approval\n    from the screen, a ruling, another pass's own record) is not a race\n    for the lease, it is exactly what the lease is for. Never while a\n    worker holds this copy (worker_holds_copy): resetting a working tree\n    a detached child is still writing into would corrupt its own commits.\n    A plain fast-forward when origin is simply ahead; when this checkout\n    also carries its own commits origin has not seen yet (an operator's\n    approval, not yet pushed), those are replayed on top of origin's own\n    tip instead -- no merge commit, and the marker this pass is about to\n    write still lands as a fast-forward when it pushes. Silent about\n    everything short of that -- a real conflict, or an absent origin, is\n    left for the ordinary read (and the marker push, for the lease) to\n    sort out.\"\"\"\n    records_dir = root / m[\"paths\"][\"records\"] / item_id\n    if worker_holds_copy(root, records_dir) or not has_origin(root):\n        return\n    try:\n        branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n        git(root, \"fetch\", \"origin\", branch)\n    except RuntimeError:\n        return\n    try:\n        git(root, \"merge\", \"--ff-only\", \"FETCH_HEAD\")\n        return\n    except RuntimeError:\n        pass\n    try:\n        git(root, \"rebase\", \"FETCH_HEAD\")\n    except RuntimeError:\n        subprocess.run([\"git\", \"-C\", str(root), \"rebase\", \"--abort\"],\n                       capture_output=True, text=True, check=False)\n\n\n# --- the worker: a detached child of the pass's own session, running the\n# stage exactly as the pass used to inline, touching its own heartbeat\n# while it does (R2). ---\n\ndef _stage_body(item_id: str, stage: str, nn: int) -> int:\n    \"\"\"Runs build or verify in-process -- the same command `attavo build`\n    or `attavo verify` would run -- while touching heartbeat_path every\n    heartbeat_s() seconds, then transports whatever it wrote: counsel and\n    file-stops on a non-pass record (issue #100, #89), one `git commit\ntests/test_drive.py:930:def test_drive_worker_retries_a_rejected_record_push_with_a_merge_never_a_rebase(tmp_path: Path) -> None:\ntests/test_drive.py:986:def test_drive_a_refused_marker_push_ends_the_pass_with_exit_1(tmp_path: Path) -> None:\ntests/test_drive.py:1003:    assert \"could not push the build invocation marker\" in run.stdout, run.stdout\ntests/test_drive.py:1010:def test_drive_commits_and_pushes_an
topped: the checks did not conclude within {bound:.0f}s\\\")\\n834\\t                return 1\\n835\\t        else:\\n836\\t            waiting_since = None\\n837\\t\\n838\\t        if rc != 0:\\n839\\t            return rc\\n840\\t        if state in _TERMINAL_STATES:\\n841\\t            return 0\\n842\\t        # R3: blocked-on-checks on a review is no longer a dead end -- the\\n843\\t        # pass just converted it into a returned record and, inside its\\n844\\t        # budget, a build retry follows on its own. Only the post-verify\\n845\\t        # case (the checks went red after a passing review, stage None)\\n846\\t        # is still the level with nothing left to do but give up.\\n847\\t        if state == \\\"blocked-on-checks\\\" and r[\\\"stage\\\"] is None:\\n848\\t            return 1\\n849\\t        time.sleep(interval)\\n850\\t\\n851\\t\\n852\\tdef _drive_all() -> int:\\n853\\t    \\\"\\\"\\\"--all: one pass, in its own process, in every ../attavo-worktree-N\\n854\\t    beside this checkout -- each one derives its own item from its own\\n855\\t    attavo/N-* branch. Every line either prints is prefixed with the\\n856\\t    worktree's own directory name, so an operator reading them together\\n857\\t    can tell which item each line is about.\\\"\\\"\\\"\"}]},\"parent_tool_use_id\":null,\"session_id\":\"ae622d81-efb9-4dda-92a0-5ebf75b0d73f\",\"uuid\":\"2ad9d723-f5b6-4e95-ba57-536362a6b9cc\",\"timestamp\":\"2026-09-26T04:04:43.902Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/davidbean/Projects/attavo-worktree-219/attavo/drive.py\",\"content\":\"def _until_ready(root: Path, m: dict[str, Any], item_id: str, again: bool) -> int:\\n    \\\"\\\"\\\"--until-ready: the pass, repeated in one process, sleeping\\n    ATTAVO_DRIVE_POLL_INTERVAL_S between passes, until the level is the\\n    operator's or done (exit 0), a concluded check is red (exit 1), or\\n    an unconcluded one has not concluded within ATTAVO_DRIVE_POLL_BOUND_S\\n  
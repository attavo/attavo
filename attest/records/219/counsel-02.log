cks_file)\\n565\\t    log = worker_log_path(root, stage, nn)\\n566\\t    with log.open(\\\"ab\\\") as fh, open(os.devnull, \\\"rb\\\") as devnull:\\n567\\t        proc = subprocess.Popen(\\n568\\t            [sys.executable, str(PRODUCT_ROOT / \\\"bin\\\" / \\\"attavo\\\"), \\\"worker\\\", item_id, stage, f\\\"{nn:02d}\\\"],\\n569\\t            cwd=str(root), env=env, stdin=devnull, stdout=fh, stderr=subprocess.STDOUT,\\n570\\t            start_new_session=True)\\n571\\t    word = \\\"Build\\\" if stage == \\\"build\\\" else \\\"Review\\\"\\n572\\t    print(f\\\"attavo drive: {word} started (attempt {nn:02d}, worker pid {proc.pid})\\\")\\n573\\t    return 0\\n574\\t\\n575\\t\\n576\\tdef _recover_one(root: Path, m: dict[str, Any], item_id: str, records_dir: Path) -> int:\\n577\\t    \\\"\\\"\\\"The pass's own recovery act (what `--recover` did): exactly the one\\n578\\t    invocation the report just read as owing one -- died or hung -- ends\\n579\\t    here. class died when the heartbeat is stale (or absent and the pid\\n580\\t    is gone), class hung when there is no heartbeat, the pid lives, and a\\n581\\t    declared [drive].stall_after_s has passed with no newer event, and\\n582\\t    terminated. Provenance product; the events tail as the log. Committed\\n583\\t    and pushed the way any stage record is (push_record_commit, with its\\n584\\t    own merge retry) -- this is not a race for a lease, since no new\\n585\\t    attempt marker is written.\\\"\\\"\\\"\\n586\\t    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n587\\t    bound = stall_bound_s(m)\\n588\\t    pending = invocations_without_record(records_dir)\\n589\\t    readings = [(marker, info, read_invocation(root, bound, marker, info)) for marker, info in pending]\\n590\\t    candidate = next(((mk, i, rd) for mk, i, rd in readings if rd.cls != \\\"running\\\"), None)\\n591\\t    if candidate is None:\\n592\\t        # The report read this a moment ago; nothing owed recovery by the\\n593\\t        # time this pass got here (another pass recovered it, or it\\n594\\t        # finished on its own).\\n595\\t        return 0\\n596\\t    marker, info, reading = candidate\\n597\\t    stage, nn, log, last_at, age, cls, crossed = reading\\n598\\t    pid, host = info.get(\\\"pid\\\"), info.get(\\\"host\\\")\\n599\\t\\n600\\t    if next_attempt_number(records_dir, stage) != nn:\\n601\\t        print(f\\\"attavo drive: stopped: {marker.name} names attempt {nn} but the next \\\"\\n602\\t              f\\\"{stage} record would be {next_attempt_number(records_dir, stage):02d}; \\\"\\n603\\t              f\\\"a later record already exists, read the records before recovering\\\")\\n604\\t        return 1\\n605\\t\\n606\\t    if cls == \\\"hung\\\":\\n607\\t        try:\\n608\\t            os.kill(cast(int, pid), signal.SIGTERM)\\n609\\t            ended = \\\"terminated\\\"\\n610\\t        except OSError as exc:\\n611\\t            ended = f\\\"not terminated ({exc})\\\"\\n612\\t        if crossed == \\\"ceiling\\\":\\n613\\t            detail = (f\\\"pid {pid} on {host} alive {int(cast(float, age))} s after its marker, \\\"\\n614\\t                      f\\\"past the {stage} ceiling of {ceiling_s(m, stage)} s; {ended}\\\")\\n615\\t        else:\\n616\\t            detail = (f\\\"pid {pid} on {host} alive with no event for {int(cast(float, age))} s \\\"\\n617\\t                      f\\\"(bound {bound} s); {ended}\\\")\\n618\\t    else:\\n619\\t        detail = (f\\\"pid {pid} on {host} is not running and wrote no {marker.stem}.json; \\\"\\n620\\t                  f\\\"started {info.get('at')}, last event {last_at or 'none'}\\\")\\n621\\t\\n622\\t    signature_text = log.strip().splitlines()[-1] if log.strip() else detail\\n623\\t\\n624\\t    schema = stage_schema(stage)\\n625\\t    record: dict[str, Any] = {k: None for \n2317 {\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01AGs8thXgBtQAU7QKY8UkqS\",\"type\":\"tool_result\",\"content\":\"def _pass_once(root: Path, m: dict[str, Any], item_id: str, again: bool) -> tuple[int, \\\"DriveReport\\\"]:\\n    \\\"\\\"\\\"One pass: fast-forward to origin (never while a worker holds the\\n    copy), read the report, act at most once, return. owes-recovery\\n    recovers; next-build and next-review start their stage, handing a\\n    review the checks the report already read once on the pre-marker\\n    head; blocked-on-checks on a review (R3) starts it too -- the same\\n    act as next-review, since a concluded red check on a passed build's\\n    head is now a returned record, not a level a pass leaves alone. A\\n    stopped stage inside its budget (RetryState.eligible) retries itself,\\n    with no flag needed; `--again` is a no-op that says so when the plain\\n    mechanism would already act or is only waiting out retry_after_s, and\\n    forces the next attempt, named again_by in its marker, when it would\\n    not. Every other level is printed in the report's own words and left.\\\"\\\"\\\"\\n    from attavo.report import drive_report\\n    fast_forward_to_origin(root, m, item_id)\\n    r = drive_report(root, m, item_id)\\n    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n\\n    if r[\\\"state\\\"] == \\\"owes-recovery\\\":\\n        return _recover_one(root, m, item_id, records_dir), r\\n    if r[\\\"state\\\"] == \\\"next-build\\\":\\n        return _start_stage(root, m, item_id, \\\"build\\\", None), r\\n    if r[\\\"state\\\"] in (\\\"next-review\\\", \\\"blocked-on-checks\\\") and r[\\\"stage\\\"] == \\\"verify\\\":\\n        checks_command = (m.get(\\\"forge\\\") or {}).get(\\\"checks_command\\\")\\n        forge_checks = {\\\"command\\\": checks_command, \\\"sha\\\": r[\\\"head\\\"], \\\"conclusions\\\": r[\\\"checks\\\"] or []}\\n        return _start_stage(root, m, item_id, \\\"verify\\\", forge_checks), r\\n    if r[\\\"state\\\"] == \\\"stopped\\\" and r[\\\"stage\\\"]:\\n        state = retry_s
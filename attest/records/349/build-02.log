e\")\n+INTERVENTION_CLASSES = (\"amend\", \"launch\", \"transport\")\n+\n+\n+def _committer_time_iso(root: Path, shas: list[str]) -> dict[str, str]:\n+    \"\"\"Each sha's own committer time, in the same shape attest's own `at`\n+    fields already carry -- one `git show` process for every sha an\n+    item's acts and interventions need, not one git call per row.\"\"\"\n+    if not shas:\n+        return {}\n+    out = git(root, \"show\", \"-s\", \"--format=%H\\x1f%ct\", *shas)\n+    times: dict[str, str] = {}\n+    for line in out.splitlines():\n+        if not line.strip():\n+            continue\n+        sha, epoch = line.split(\"\\x1f\")\n+        times[sha] = datetime.fromtimestamp(int(epoch), timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n+    return times\n+\n+\n+def item_acts_and_interventions(root: Path, m: dict[str, Any], item_id: str,\n+                                merges: list[dict[str, Any]] | None = None\n+                                ) -> tuple[list[dict[str, Any]], list[dict[str, Any]]]:\n+    \"\"\"(acts, interventions): the statement's own two lists, read from\n+    item_ledger's own rows between the item's first spec commit and its\n+    merge -- each commit classed exactly once there, never classified\n+    twice. acts carries every approve and merge row as {act, sha, by, at};\n+    interventions carries every amend, launch, and transport row as\n+    {class, sha, by, at}. `by` is the commit's own author name\n+    (item_ledger's `identity`); `at` is its committer time.\"\"\"\n+    rows = item_ledger(root, m, item_id, merges=merges)[\"rows\"]\n+    act_rows = [r for r in rows if r[\"class\"] in ACT_CLASSES]\n+    intervention_rows = [r for r in rows if r[\"class\"] in INTERVENTION_CLASSES]\n+    times = _committer_time_iso(root, [r[\"sha\"] for r in act_rows + intervention_rows])\n+    acts = [{\"act\": r[\"class\"], \"sha\": r[\"sha\"], \"by\": r[\"identity\"], \"at\": times[r[\"sha\"]]}\n+           for r in act_rows]\n+    interventions = [{\"class\": r[\"class\"], \"sha\": r[\"sha\"], \"by\": r[\"identity\"], \"at\": times[r[\"sha\"]]}\n+                     for r in intervention_rows]\n+    return acts, interventions\n+\n+\n def cmd_ledger(argv: list[str]) -> int:\n     as_json = \"--json\" in argv\n     positional = [a for a in argv if a != \"--json\"]\ndiff --git a/schema/attestation.schema.json b/schema/attestation.schema.json\nindex 65b7c8e..0ffc4f8 100644\n--- a/schema/attestation.schema.json\n+++ b/schema/attestation.schema.json\n@@ -1,7 +1,7 @@\n {\n   \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n-  \"$id\": \"https://attavo.dev/attestation/v5\",\n-  \"title\": \"The attestation statement `attavo attest` prints on a coherent chain (v5: `cost` also prices, from the tenant's published rates, a record whose adapter reported none, and says so; v4: `time`, `cost` and `tokens` are the only accounting, summed over every attempt; v3 statements sealed earlier also carry cost_by_stage_usd, wall_clock_by_stage_s and tokens_by_stage, the final attempt of each stage)\",\n+  \"$id\": \"https://attavo.dev/attestation/v6\",\n+  \"title\": \"The attestation statement `attavo attest` prints on a coherent chain (v6: `interventions` and `acts` are read from the item's own commits between its first spec commit and its merge, each one classed exactly once by attavo/ledger.py::item_ledger -- sha is now required in both; v5: `cost` also prices, from the tenant's published rates, a record whose adapter reported none, and says so; v4: `time`, `cost` and `tokens` are the only accounting, summed over every attempt; v3 statements sealed earlier also carry cost_by_stage_usd, wall_clock_by_stage_s and tokens_by_stage, the final attempt of each stage)\",\n   \"type\": \"object\",\n   \"additionalProperties\": false,\n   \"required\": [\n@@ -25,29 +25,31 @@\n     \"at\": {\"type\": \"string\", \"minLength\": 1},\n     \"interventions\": {\n       \"type\": \"array\",\n-      \"description\": \"Corrections or amendments made during the item's traversal. Nothing populates this yet.\",\n+      \"description\": \"Every operator row on the item other than approve and merge -- amend, launch, transport -- read from attavo/ledger.py::item_ledger's own rows between the item's first spec commit and its merge (issue #349): the row's class, its sha, the commit's own author name, and its committer time.\",\n       \"items\": {\n         \"type\": \"object\",\n         \"additionalProperties\": false,\n-        \"required\": [\"at\", \"class\", \"by\"],\n+        \"required\": [\"at\", \"class\", \"by\", \"sha\"],\n         \"properties\": {\n           \"at\": {\"type\": \"string\", \"minLength\": 1},\n           \"class\": {\"type\": \"string\", \"minLength\": 1},\n-          \"by\": {\"type\": \"string\", \"minLength\": 1}\n+          \"by\": {\"type\": \"string\", \"minLength\": 1},\n+          \"sha\": {\"type\": \"string\", \"minLength\": 1}\n         }\n       }\n     },\n     \"acts\": {\n       \"type\": \"array\",\n-      \"description\": \"Operator acts on the item: approve, rule, merge. Nothing populates this yet.\",\n+      \"description\": \"The operator's ruled acts on the item: each approve row and the merge row, read the same way (issue #349). rule stays in this enum for the ruling record (#276) and is never produced here.\",\n       \"items\": {\n         \"type\": \"object\",\n         \"additionalProperties\": false,\n-        \"required\": [\"at\", \"act\", \"by\"],\n+        \"required\": [\"at\", \"act\", \"by\", \"sha\"],\n         \"properties\": {\n           \"at\": {\"type\": \"string\", \"minLength\": 1},\n           \"act\": {\"type\": \"string\", \"enum\": [\"approve\", \"rule\", \"merge\"]},\n-          \"by\": {\"type\": \"string\", \"minLength\": 1}\n+          \"by\": {\"type\": \"string\", \"minLength\": 1},\n+          \"sha\": {\"type\": \"string\", \"minLength\": 1}\n         }\n       }\n     },","is_error":false}]},"parent_tool_use_id":null,"session_id":"44605ed1-3fc4-4682-88b2-6e65d0286b58","uuid":"81e05429-01af-4afe-81cc-a9395d36dd60","timestamp":"2026-10-07T21:48:11.694Z","tool_use_result":{"stdout":"commit e7d61a75ad5f6c4db97e69bc4c57ffc02793377f\nAuthor: attavo executor (claude-code) <executor+claude-code@attavo.invalid>\nDate:   Wed Oct 7 15:30:41 2026 -0600\n\n    build invocation 01 for item 349: the statement's acts and interventions are read from the item's commits\n    \n    Deletes the hard-coded `\"interventions\": []` and `\"acts\": []` attest.py\n    wrote into every statement and reads both from attavo/ledger.py's own\n    per-commit classification instead: acts carries each approve and merge\n    row as {act, sha, by, at}, interventions every amend, launch, and\n    transport row as {class, sha, by, at}. sha is now required in both\n    item shapes, and the predicate moves to attestation/v6; v3, v4 and v5\n    statements still read as sealed. Doctor's sixth proof recomputes both\n    lists for a v6 statement the same way it already does time and cost,\n    failing by name when they differ. item_ledger's own commit walk is\n    fixed to include a first spec commit that has no parent -- a fixture's\n    or a squash merge's root commit, which `^` cannot name and which `A..B`\n    would otherwise silently drop.\n    \n    Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>\n\ndiff --git a/attavo/attest.py b/attavo/attest.py\nindex c2d6c3b..bfd4712 100644\n--- a/attavo/attest.py\n+++ b/attavo/attest.py\n@@ -357,6 +357,12 @@ def cmd_attest(argv: list[str]) -> int:\n     item_time, item_cost, item_tokens_ = item_accounting(\n         records_dir, sealed_at, (m.get(\"cost\") or {}).get(\"rates\"))\n \n+    # Imported here, not at module level: attavo.ledger imports from\n+    # attavo.doctor, which imports from this module -- a cycle resolved by\n+    # deferring to call time, when every module is already loaded.\n+    from attavo.ledger import item_acts_and_interventions\n+    acts,
{"type":"assistant","message":{"model":"claude-sonnet-5","id":"msg_011CfocUpMwXvVE3NJ55453P","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_0153nckUcvBRtDR6rkCG4UPJ","name":"Bash","input":{"command":"git show e7d61a7 -- attavo/attest.py attavo/ledger.py attavo/doctor.py schema/attestation.schema.json"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1763,"cache_read_input_tokens":29911,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1763},"output_tokens":2,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"44605ed1-3fc4-4682-88b2-6e65d0286b58","uuid":"432c89fc-cb8d-4671-8b94-be5d13188dcf","timestamp":"2026-10-07T21:48:11.614Z","request_id":"req_011CfocUp8oVSsBZ2ubd3XZv","wire_tool_inputs":{"toolu_0153nckUcvBRtDR6rkCG4UPJ":{"command":"cd /Users/davidbean/Projects/attavo-worktree-349 && git show e7d61a7 -- attavo/attest.py attavo/ledger.py attavo/doctor.py schema/attestation.schema.json"}},"wire_ingest_context":{"toolu_0153nckUcvBRtDR6rkCG4UPJ":{"cwd":"/Users/davidbean/Projects/attavo-worktree-349"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0153nckUcvBRtDR6rkCG4UPJ","type":"tool_result","content":"commit e7d61a75ad5f6c4db97e69bc4c57ffc02793377f\nAuthor: attavo executor (claude-code) <executor+claude-code@attavo.invalid>\nDate:   Wed Oct 7 15:30:41 2026 -0600\n\n    build invocation 01 for item 349: the statement's acts and interventions are read from the item's commits\n    \n    Deletes the hard-coded `\"interventions\": []` and `\"acts\": []` attest.py\n    wrote into every statement and reads both from attavo/ledger.py's own\n    per-commit classification instead: acts carries each approve and merge\n    row as {act, sha, by, at}, interventions every amend, launch, and\n    transport row as {class, sha, by, at}. sha is now required in both\n    item shapes, and the predicate moves to attestation/v6; v3, v4 and v5\n    statements still read as sealed. Doctor's sixth proof recomputes both\n    lists for a v6 statement the same way it already does time and cost,\n    failing by name when they differ. item_ledger's own commit walk is\n    fixed to include a first spec commit that has no parent -- a fixture's\n    or a squash merge's root commit, which `^` cannot name and which `A..B`\n    would otherwise silently drop.\n    \n    Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>\n\ndiff --git a/attavo/attest.py b/attavo/attest.py\nindex c2d6c3b..bfd4712 100644\n--- a/attavo/attest.py\n+++ b/attavo/attest.py\n@@ -357,6 +357,12 @@ def cmd_attest(argv: list[str]) -> int:\n     item_time, item_cost, item_tokens_ = item_accounting(\n         records_dir, sealed_at, (m.get(\"cost\") or {}).get(\"rates\"))\n \n+    # Imported here, not at module level: attavo.ledger imports from\n+    # attavo.doctor, which imports from this module -- a cycle resolved by\n+    # deferring to call time, when every module is already loaded.\n+    from attavo.ledger import item_acts_and_interventions\n+    acts, interventions = item_acts_and_interventions(root, m, item_id)\n+\n     statement: AttestRecord = {\n         \"sha\": head_sha,\n         \"merge_sha\": head_sha,\n@@ -370,11 +376,10 @@ def cmd_attest(argv: list[str]) -> int:\n         \"verify\": verify_path.stem if verify_path else None,\n         \"verify_sha\": latest_verify.get(\"sha\"),\n         \"at\": now_iso(),\n-        # Neither is populated by anything today -- no ruling or amendment\n-        # log exists yet for either to read from. Carried as empty rather\n-        # than omitted, since the schema names them.\n-        \"interventions\": [],\n-        \"acts\": [],\n+        # Read from the item's own commits (issue #349), the same\n+        # classification attavo ledger makes -- nothing classified twice.\n+        \"interventions\": interventions,\n+        \"acts\": acts,\n         # The only accounting: every attempt, summed (the sum across\n         # executors was ruled 2026-09-19). v3's final-attempt fields are\n         # retired (issue #309).\ndiff --git a/attavo/doctor.py b/attavo/doctor.py\nindex 72e5203..77d59ec 100644\n--- a/attavo/doctor.py\n+++ b/attavo/doctor.py\n@@ -865,33 +865,48 @@ V3_ONLY_FIELDS = (\"cost_by_stage_usd\", \"wall_clock_by_stage_s\", \"tokens_by_stage\n V5_COST_FIELDS = (\"reported_usd\", \"estimated_usd\", \"basis_by_stage\", \"rates\", \"estimate_note\")\n \n \n+def _carries_act_sha(rows: Any) -> bool:\n+    \"\"\"True when `rows` is a non-empty list whose entries already carry\n+    `sha` -- v6's own shape for `acts` and `interventions` (issue #349);\n+    v5 and earlier wrote both as `[]`, never a sha.\"\"\"\n+    return isinstance(rows, list) and any(isinstance(r, dict) and \"sha\" in r for r in rows)\n+\n+\n def _predicate_version(statement: dict[str, Any], predicate: dict[str, Any]) -> int:\n     \"\"\"The attestation version a statement was sealed under (issues #309,\n-    #307): named by its envelope's predicateType, else known by what it\n-    carries -- v3 by the final-attempt fields v4 retired, v5 by the rates\n-    its cost block carries, v4 otherwise. Each is judged by its own rules;\n-    nothing sealed is rewritten.\"\"\"\n+    #307, #349): named by its envelope's predicateType, else known by what\n+    it carries -- v3 by the final-attempt fields v4 retired, v6 by a sha\n+    on an act or intervention row, v5 by the rates its cost block carries,\n+    v4 otherwise. Each is judged by its own rules; nothing sealed is\n+    rewritten.\"\"\"\n     declared = statement.get(\"predicateType\")\n     named = re.search(r\"/attestation/v(\\d+)$\", declared) if isinstance(declared, str) else None\n     if named:\n         return int(named.group(1))\n     if any(key in predicate for key in V3_ONLY_FIELDS):\n         return 3\n+    if _carries_act_sha(predicate.get(\"acts\")) or _carries_act_sha(predicate.get(\"interventions\")):\n+        return 6\n     cost = predicate.get(\"cost\")\n     return 5 if isinstance(cost, dict) and \"rates\" in cost else 4\n \n \n def _accounting_disagrees(root: Path, item_records_dir: Path, item: str, merge_sha: str,\n-                          statement: dict[str, Any]) -> str | None:\n+                          statement: dict[str, Any],\n+                          merges: list[dict[str, Any]] | None = None) -> str | None:\n     \"\"\"A sealed statement that carries `time` and `cost` (and, from v4,\n-    `tokens`) says what its records sum to, field by field -- the same function attest summed them\n-    with, over the same records (none is written after a merge), sealed at\n-    the same commit (the statement is computed at the merge, so lead_s and\n+    `tokens`; from v6, `acts` and `interventions`) says what its records sum\n+    to, field by field -- the same function attest summed them with, over\n+    the same records (none is written after a merge), sealed at the same\n+    commit (the statement is computed at the merge, so lead_s and\n     waiting_s are recomputed from its committer time, not excepted). Exact:\n     #202 retired the one-second tolerance. A statement sealed before `time`\n     existed carries neither key and is not checked; a key that is present\n     holds a block, so a null one, or one block without the other, is a\n-    disagreement. No new read of the store.\"\"\"\n+    disagreement. No new read of the store. merges, when given, is\n+    _merges_reachable's own result -- the caller's loop over every item\n+    computes it once rather than each item's acts and interventions\n+    walking the default branch's merges again.\"\"\"\n     inner = statement.get(\"predicate\")\n     predicate = inner if isinstance(inner, dict) else statement\n     if \"time\" not in predicate and \"cost\" not in predicate:\n@@ -933,6 +948,18 @@ def _accounting_disagrees(root: Path, item_records_dir: Path, item: str, merge_s\n         else:\n             differing.append(f\"tokens is {_carried(predicate, 'tokens')}, not a block \"\n                              f\"its records sum to {dict(summed_tokens)!r}\")\n+    if version >= 6:\n+        # Imported here, not at module level: attavo.ledger imports from\n+        # this module, a cycle resolved by deferring to call time.\n+        from attavo.ledger import item_acts_and_interventions\n+        summed_acts, summed_interventions = item_acts_and_interventions(\n+            root, declared, item, merges=merges)\n+        stated_acts, stated_interventions = predicate.get(\"acts\"), predicate.get(\"interventions\")\n+        if not (isinstance(stated_acts, list) and _same(stated_acts, summed_acts)):\n+            differing.append(f\"acts {stated_acts!r} is not its records' {summed_acts!r}\")\n+        if not (isinstance(stated_interventions, list) and _same(stated_interventions, summed_interventions)):\n+            differing.append(f\"interventions {stated_interventions!r} is not its \"\n+                             f\"records' {summed_interventions!r}\")\n     if differing:\n         return f\"{where}: the statement's \" + \"; \".join(differing)\n     return None\n@@ -984,7 +1011,7 @@ def proof_every_attested_item_is_sealed(root: Path, m: dict[str, Any] | None) ->\n         if statement is not None:\n             sealed.append(item)\n             disagreement = _accounting_disagrees(root, records_dir / item, item, merge_sha,\n-                                                 statement)\n+                                                 statement, merges=merges)\n             if disagreement:\n                 reasons.append(disagreement)\n         elif exit_code == 2:\ndiff --git a/attavo/ledger.py b/attavo/ledger.py\nindex 9bdffa5..4be17d5 100644\n--- a/attavo/ledger.py\n+++ b/attavo/ledger.py\n@@ -5,6 +5,7 @@ import re\n import subprocess\n import sys\n import tempfile\n+from datetime import datetime, timezone\n from pathlib import Path\n from typing import Any\n \n@@ -52,6 +53,32 @@ def first_commit_touching(root: Path, relpath: str) -> str | None:\n     return lines[0] if lines else None\n \n \n+def _single_commit_with_diff(root: Path, sha: str) -> dict[str, Any]:\n+    \"\"\"commits_with_diffs's own shape, for one commit read directly rather\n+    than by a range -- the one case `_commits_from` needs it for: a\n+    commit with no parent, which `^` cannot name.\"\"\"\n+    out = git(root, \"show\", \"--diff-merges=first-parent\", \"--name-only\",\n+             \"--format=\\x01%H\\x1f%an\\x1f%ae\", sha)\n+    header, _, rest = out.split(\"\\x01\")[1].partition(\"\\n\")\n+    c_sha, name, email = header.split(\"\\x1f\")\n+    return {\"sha\": c_sha, \"name\": name, \"email\": email,\n+           \"touched\": [line for line in rest.splitlines() if line.strip()]}\n+\n+\n+def _commits_from(root: Path, first_sha: str, end: str) -> list[dict[str, Any]]:\n+    \"\"\"commits_with_diffs's own range, from first_sha up to and including\n+    end: first_sha^..end, the ordinary case. `^` cannot name the parent of\n+    a commit that has none -- the repository's own root commit, which a\n+    fixture or a squa
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014YzYESS1o4P73AgLhhcDDv","type":"tool_result","content":"858\tdef _carried(predicate: dict[str, Any], key: str) -> str:\n859\t    return repr(predicate[key]) if key in predicate else \"absent\"\n860\t\n861\t\n862\tV3_ONLY_FIELDS = (\"cost_by_stage_usd\", \"wall_clock_by_stage_s\", \"tokens_by_stage\")\n863\t\n864\t\n865\tV5_COST_FIELDS = (\"reported_usd\", \"estimated_usd\", \"basis_by_stage\", \"rates\", \"estimate_note\")\n866\t\n867\t\n868\tdef _carries_act_sha(rows: Any) -> bool:\n869\t    \"\"\"True when `rows` is a non-empty list whose entries already carry\n870\t    `sha` -- v6's own shape for `acts` and `interventions` (issue #349);\n871\t    v5 and earlier wrote both as `[]`, never a sha.\"\"\"\n872\t    return isinstance(rows, list) and any(isinstance(r, dict) and \"sha\" in r for r in rows)\n873\t\n874\t\n875\tdef _predicate_version(statement: dict[str, Any], predicate: dict[str, Any]) -> int:\n876\t    \"\"\"The attestation version a statement was sealed under (issues #309,\n877\t    #307, #349): named by its envelope's predicateType, else known by what\n878\t    it carries -- v3 by the final-attempt fields v4 retired, v6 by a sha\n879\t    on an act or intervention row, v5 by the rates its cost block carries,\n880\t    v4 otherwise. Each is judged by its own rules; nothing sealed is\n881\t    rewritten.\"\"\"\n882\t    declared = statement.get(\"predicateType\")\n883\t    named = re.search(r\"/attestation/v(\\d+)$\", declared) if isinstance(declared, str) else None\n884\t    if named:\n885\t        return int(named.group(1))\n886\t    if any(key in predicate for key in V3_ONLY_FIELDS):\n887\t        return 3\n888\t    if _carries_act_sha(predicate.get(\"acts\")) or _carries_act_sha(predicate.get(\"interventions\")):\n889\t        return 6\n890\t    cost = predicate.get(\"cost\")\n891\t    return 5 if isinstance(cost, dict) and \"rates\" in cost else 4\n892\t\n893\t\n894\tdef _accounting_disagrees(root: Path, item_records_dir: Path, item: str, merge_sha: str,\n895\t                          statement: dict[str, Any],\n896\t                          merges: list[dict[str, Any]] | None = None) -> str | None:\n897\t    \"\"\"A sealed statement that carries `time` and `cost` (and, from v4,\n898\t    `tokens`; from v6, `acts` and `interventions`) says what its records sum\n899\t    to, field by field -- the same function attest summed them with, over\n900\t    the same records (none is written after a merge), sealed at the same\n901\t    commit (the statement is computed at the merge, so lead_s and\n902\t    waiting_s are recomputed from its committer time, not excepted). Exact:\n903\t    #202 retired the one-second tolerance. A statement sealed before `time`\n904\t    existed carries neither key and is not checked; a key that is present\n905\t    holds a block, so a null one, or one block without the other, is a\n906\t    disagreement. No new read of the store. merges, when given, is\n907\t    _merges_reachable's own result -- the caller's loop over every item\n908\t    computes it once rather than each item's acts and interventions\n909\t    walking the default branch's merges again.\"\"\"\n910\t    inner = statement.get(\"predicate\")\n911\t    predicate = inner if isinstance(inner, dict) else statement\n912\t    if \"time\" not in predicate and \"cost\" not in predicate:\n913\t        return None\n914\t    stated_time, stated_cost = predicate.get(\"time\"), predicate.get(\"cost\")\n915\t    where = f\"item {item} merged at {merge_sha[:12]}\"\n916\t    if not isinstance(stated_time, dict) or not isinstance(stated_cost, dict):\n917\t        return (f\"{where}: the statement's time and cost are not both blocks \"\n918\t                f\"(time is {_carried(predicate, 'time')}, cost is {_carried(predicate, 'cost')})\")\n919\t    try:\n920\t        sealed_at: int | None = int(git(root, \"show\", \"-s\", \"--format=%ct\", merge_sha).strip())\n921\t    except (RuntimeError, ValueError):\n922\t        sealed_at = None\n923\t    version = _predicate_version(statement, predicate)\n924\t    # v5 prices a record by the [cost.rates] the tenant's manifest declared\n925\t    # at the sealed commit, never by the rates the statement carries: the\n926\t    # carried block is then compared like any field, and a later edit to the\n927\t    # manifest cannot unseal anything. v3 and v4 priced nothing.\n928\t    rates: dict[str, Any] | None = None\n929\t    if version >= 5:\n930\t        try:\n931\t            declared = parse_manifest(git(root, \"show\", f\"{merge_sha}:{MANIFEST}\"))\n932\t        except (RuntimeError, ValueError) as exc:\n933\t            return (f\"{where}: the manifest {MANIFEST} cannot be read at the sealed commit, \"\n934\t                    f\"so a v5 statement's estimate cannot be checked ({exc})\")\n935\t        found = (declared.get(\"cost\") or {}).get(\"rates\")\n936\t        rates = found if isinstance(found, dict) else {}\n937\t    summed_time, summed_cost, summed_tokens = item_accounting(\n938\t        item_records_dir, sealed_at, rates)\n939\t    cost_now = {k: v for k, v in summed_cost.items() if version >= 5 or k not in V5_COST_FIELDS}\n940\t    if version < 5:  # v3 and v4 named the record, never the missing rate\n941\t        cost_now[\"not_read\"] = [n.split(\" (no [cost.rates]\")[0] for n in summed_cost[\"not_read\"]]\n942\t    differing = (_differences(\"time\", stated_time, dict(summed_time))\n943\t                 + _differences(\"cost\", stated_cost, cost_now))\n944\t    if version >= 4:\n945\t        stated_tokens = predicate.get(\"tokens\")\n946\t        if isinstance(stated_tokens, dict):\n947\t            differing += _differences(\"tokens\", stated_tokens, dict(summed_tokens))\n948\t        else:\n949\t            differing.append(f\"tokens is {_carried(predicate, 'tokens')}, not a block \"\n950\t                             f\"its records sum to {dict(summed_tokens)!r}\")\n951\t    if version >= 6:\n952\t        # Imported here, not at module level: attavo.ledger imports from\n953\t        # this module, a cycle resolved by deferring to call time.\n954\t        from attavo.ledger import item_acts_and_interventions\n955\t        summed_acts, summed_interventions = item_acts_and_interventions(\n956\t            root, declared, item, merges=merges)\n957\t        stated_acts, stated_interventions = predicate.get(\"acts\"), predicate.get(\"interventions\")\n958\t        if not (isinstance(stated_acts, list) and _same(stated_acts, summed_acts)):\n959\t            differing.append(f\"acts {stated_acts!r} is not its records' {summed_acts!r}\")\n960\t        if not (isinstance(stated_interventions, list) and _same(stated_interventions, summed_interventions)):\n961\t            differing.append(f\"interventions {stated_interventions!r} is not its \"\n962\t                             f\"records' {summed_interventions!r}\")"}]},"parent_tool_use_id":null,"session_id":"6f72eeed-ce9e-4916-937c-8eb7f16a3662","uuid":"74317735-24b0-4a41-906b-e5f2b4da6cf0","timestamp":"2026-10-07T20:48:31.288Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-349/attavo/doctor.py","content":"def _carried(predicate: dict[str, Any], key: str) -> str:\n    return repr(predicate[key]) if key in predicate else \"absent\"\n\n\nV3_ONLY_FIELDS = (\"cost_by_stage_usd\", \"wall_clock_by_stage_s\", \"tokens_by_stage\")\n\n\nV5_COST_FIELDS = (\"reported_usd\", \"estimated_usd\", \"basis_by_stage\", \"rates\", \"estimate_note\")\n\n\ndef _carries_act_sha(rows: Any) -> bool:\n    \"\"\"True when `rows` is a non-empty list whose entries already carry\n    `sha` -- v6's own shape for `acts` and `interventions` (issue #349);\n    v5 and earlier wrote both as `[]`, never a sha.\"\"\"\n    return isinstance(rows, list) and any(isinstance(r, dict) and \"sha\" in r for r in rows)\n\n\ndef _predicate_version(statement: dict[str, Any], predicate: dict[str, Any]) -> int:\n    \"\"\"The attestation version a statement was sealed under (issues #309,\n    #307, #349): named by its envelope's predicateType, else known by what\n    it carries -- v3 by the final-attempt fields v4 retired, v6 by a sha\n    on an act or intervention row, v5 by the rates its cost block carries,\n    v4 otherwise. Each is judged by its own rules; nothing sealed is\n    rewritten.\"\"\"\n    declared = statement.get(\"predicateType\")\n    named = re.search(r\"/attestation/v(\\d+)$\", declared) if isinstance(declared, str) else None\n    if named:\n        return int(named.group(1))\n    if any(key in predicate for key in V3_ONLY_FIELDS):\n        return 3\n    if _carries_act_sha(predicate.get(\"acts\")) or _carries_act_sha(predicate.get(\"interventions\")):\n        return 6\n    cost = predicate.get(\"cost\")\n    return 5 if isinstance(cost, dict) and \"rates\" in cost else 4\n\n\ndef _accounting_disagrees(root: Path, item_records_dir: Path, item: str, merge_sha: str,\n                          statement: dict[str, Any],\n                          merges: list[dict[str, Any]] | None = None) -> str | None:\n    \"\"\"A sealed statement that carries `time` and `cost` (and, from v4,\n    `tokens`; from v6, `acts` and `interventions`) says what its records sum\n    to, field by field -- the same function attest summed them with, over\n    the same records (none is written after a merge), sealed at the same\n    commit (the statement is computed at the merge, so lead_s and\n    waiting_s are recomputed from its committer time, not excepted). Exact:\n    #202 retired the one-second tolerance. A statement sealed before `time`\n    existed carries neither key and is not checked; a key that is present\n    holds a block, so a null one, or one block without the other, is a\n    disagreement. No new read of the store. merges, when given, is\n    _merges_reachable's own result -- the caller's loop over every item\n    computes it once rather than each item's acts and interventions\n    walking the default branch's merges again.\"\"\"\n    inner = statement.get(\"predicate\")\n    predicate = inner if isinstance(inner, dict) else statement\n    if \"time\" not in predicate and \"cost\" not in predicate:\n        return None\n    stated_time, stated_cost = predicate.get(\"time\"), predicate.get(\"cost\")\n    where = f\"item {item} merged at {merge_sha[:12]}\"\n    if not isinstance(stated_time, dict) or not isinstance(stated_cost, dict):\n        return (f\"{where}: the statement's time and cost are not both blocks \"\n                f\"(time is {_carried(predicate, 'time')}, cost is {_carried(predicate, 'cost')})\")\n    try:\n        sealed_at: int | None = int(git(root, \"show\", \"-s\", \"--format=%ct\", merge_sha).strip())\n    except (RuntimeError, ValueError):\n        sealed_at = None\n    version = _predicate_version(statement, predicate)\n    # v5 prices a record by the [cost.rates] the tenant's manifest declared\n    # at the sealed commit, never by the rates the statement carries: the\n    # carried block is then compared like any field, and a later edit to the\n    # manifest cannot unseal anything. v3 and v4 priced nothing.\n    rates: dict[str, Any] | None = None\n    if version >= 5:\n        try:\n            declared = parse_manifest(git(root, \"show\", f\"{merge_sha}:{MANIFEST}\"))\n        except (RuntimeError, ValueError) as exc:\n            return (f\"{where}: the manifest {MANIFEST} cannot be read at the sealed commit, \"\n                    f\"so a v5 statement's estimate cannot be checked ({exc})\")\n        found = (declared.get(\"cost\") or {}).get(\"rates\")\n        rates = found if isinstance(found, dict) else {}\n    summed_time, summed_cost, summed_tokens = item_accounting(\n        item_records_dir, sealed_at, rates)\n    cost_now = {k: v for k, v in summed_cost.items() if version >= 5 or k not in V5_COST_FIELDS}\n    if version < 5:  # v3 and v4 named the record, never the missing rate\n        cost_now[\"not_read\"] = [n.split(\" (no [cost.rates]\")[0] for n in summed_cost[\"not_read\"]]\n    differing = (_differences(\"time\", stated_time, dict(summed_time))\n                 + _differences(\"cost\", stated_cost, cost_now))\n    if version >= 4:\n        stated_tokens = predicate.get(\"tokens\")\n        if isinstance(stated_tokens, dict):\n            differing += _differences(\"tokens\", stated_tokens, dict(summed_tokens))\n        else:\n            differing.append(f\"tokens is {_carried(predicate, 'tokens')}, not a block \"\n                             f\"its records sum to {dict(summed_tokens)!r}\")\n    if version >= 6:\n        # Imported here, not at module level: attavo.ledger imports from\n        # this module, a cycle resolved by deferring to call time.\n        from attavo.ledger import item_acts_and_interventions\n        summed_acts, summed_interventions = item_acts_and_interventions(\n            root, declared, item, merges=merges)\n        stated_acts, stated_interventions = predicate.get(\"acts\"), predicate.get(\"interventions\")\n        if not (isinstance(stated_acts, list) and _same(stated_acts, summed_acts)):\n            differing.append(f\"acts {stated_acts!r} is not its records' {summed_acts!r}\")\n        if not (isinstance(stated_interventions, list) and _same(stated_interventions, summed_interventions)):\n            differing.append(f\"interventions {stated_interventions!r} is not its \"\n                             f\"records' {summed_interventions!r}\")","numLines":105,"startLine":858,"totalLines":1212}},"tool_result_meta":[{"id":"toolu_014YzYESS1o4P73AgLhhcDDv","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}

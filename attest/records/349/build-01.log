{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JtNWrLStub4aWJ3BDvqVum","type":"tool_result","content":"1\t\"\"\"The statement's acts and interventions are read from the item's own\n2\tcommits, the same classification `attavo ledger` makes (issue #349).\n3\t\n4\tSpecimen: #344's v5 statement (merged as PR #345, d2354e27) carried\n5\t`acts: []` and `interventions: []`, hard-coded in attavo/attest.py. Its\n6\tledger showed four operator acts: an approval, two merges of main into the\n7\titem's branch made mid-run (8d4fd15, 19c384f), and the merge.\n8\t\n9\tRun: python3 -m pytest tests/test_attest_interventions.py -q\n10\t\"\"\"\n11\tfrom __future__ import annotations\n12\t\n13\timport json\n14\tfrom pathlib import Path\n15\t\n16\tfrom helpers import commit_all, git, make_tenant\n17\tfrom test_attest import configure_forge, merge_into_main, run_attavo\n18\t\n19\t\n20\tdef traverse_with_a_transport(root: Path) -> str:\n21\t    \"\"\"spec-gate and approve on the item's branch; then a person merges\n22\t    main into it, as the operator did twice on #344; then build and\n23\t    verify. Returns the sha of that transport merge.\"\"\"\n24\t    git(root, \"checkout\", \"-b\", \"attavo/1-x\")\n25\t    assert run_attavo(root, \"spec-gate\", \"1\").returncode == 0\n26\t    commit_all(root, \"attavo: spec-gate record for #1\")\n27\t    assert run_attavo(root, \"approve\", \"1\", \"--by\", \"alice\").returncode == 0\n28\t    commit_all(root, \"attavo: approval record for #1\")\n29\t    git(root, \"checkout\", \"main\")\n30\t    (root / \"OTHER.md\").write_text(\"landed on main while the item was in flight\\n\")\n31\t    commit_all(root, \"an unrelated change on main\")\n32\t    git(root, \"checkout\", \"attavo/1-x\")\n33\t    git(root, \"merge\", \"--no-ff\", \"-m\", \"Merge main into attavo/1-x\", \"main\")\n34\t    transport = git(root, \"rev-parse\", \"HEAD\").strip()\n35\t    assert run_attavo(root, \"build\", \"1\").returncode == 0\n36\t    commit_all(root, \"attavo: build record for #1\")\n37\t    assert run_attavo(root, \"verify\", \"1\").returncode == 0\n38\t    commit_all(root, \"attavo: verify record for #1\")\n39\t    merge_into_main(root, \"attavo/1-x\")\n40\t    return transport\n41\t\n42\t\n43\tdef test_a_transport_between_approval_and_merge_is_an_intervention(tmp_path: Path) -> None:\n44\t    root = make_tenant(tmp_path, \"build_valid\")\n45\t    configure_forge(root)\n46\t    transport = traverse_with_a_transport(root)\n47\t    run = run_attavo(root, \"attest\")\n48\t    assert run.returncode == 0, run.stdout + run.stderr\n49\t    statement = json.loads(run.stdout)\n50\t    interventions = statement[\"interventions\"]\n51\t    assert any(i[\"sha\"] == transport and i[\"class\"] == \"transport\" for i in interventions), interventions\n52\t    acts = {a[\"act\"] for a in statement[\"acts\"]}\n53\t    assert {\"approve\", \"merge\"} <= acts, statement[\"acts\"]\n54\t"}]},"parent_tool_use_id":null,"session_id":"6f72eeed-ce9e-4916-937c-8eb7f16a3662","uuid":"1f18098a-2d17-4254-ac52-a95e5551b5ed","timestamp":"2026-10-07T20:58:13.012Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-349/tests/test_attest_interventions.py","content":"\"\"\"The statement's acts and interventions are read from the item's own\ncommits, the same classification `attavo ledger` makes (issue #349).\n\nSpecimen: #344's v5 statement (merged as PR #345, d2354e27) carried\n`acts: []` and `interventions: []`, hard-coded in attavo/attest.py. Its\nledger showed four operator acts: an approval, two merges of main into the\nitem's branch made mid-run (8d4fd15, 19c384f), and the merge.\n\nRun: python3 -m pytest tests/test_attest_interventions.py -q\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nfrom pathlib import Path\n\nfrom helpers import commit_all, git, make_tenant\nfrom test_attest import configure_forge, merge_into_main, run_attavo\n\n\ndef traverse_with_a_transport(root: Path) -> str:\n    \"\"\"spec-gate and approve on the item's branch; then a person merges\n    main into it, as the operator did twice on #344; then build and\n    verify. Returns the sha of that transport merge.\"\"\"\n    git(root, \"checkout\", \"-b\", \"attavo/1-x\")\n    assert run_attavo(root, \"spec-gate\", \"1\").returncode == 0\n    commit_all(root, \"attavo: spec-gate record for #1\")\n    assert run_attavo(root, \"approve\", \"1\", \"--by\", \"alice\").returncode == 0\n    commit_all(root, \"attavo: approval record for #1\")\n    git(root, \"checkout\", \"main\")\n    (root / \"OTHER.md\").write_text(\"landed on main while the item was in flight\\n\")\n    commit_all(root, \"an unrelated change on main\")\n    git(root, \"checkout\", \"attavo/1-x\")\n    git(root, \"merge\", \"--no-ff\", \"-m\", \"Merge main into attavo/1-x\", \"main\")\n    transport = git(root, \"rev-parse\", \"HEAD\").strip()\n    assert run_attavo(root, \"build\", \"1\").returncode == 0\n    commit_all(root, \"attavo: build record for #1\")\n    assert run_attavo(root, \"verify\", \"1\").returncode == 0\n    commit_all(root, \"attavo: verify record for #1\")\n    merge_into_main(root, \"attavo/1-x\")\n    return transport\n\n\ndef test_a_transport_between_approval_and_merge_is_an_intervention(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"build_valid\")\n    configure_forge(root)\n    transport = traverse_with_a_transport(root)\n    run = run_attavo(root, \"attest\")\n    assert run.returncode == 0, run.stdout + run.stderr\n    statement = json.loads(run.stdout)\n    interventions = statement[\"interventions\"]\n    assert any(i[\"sha\"] == transport and i[\"class\"] == \"transport\" for i in interventions), interventions\n    acts = {a[\"act\"] for a in statement[\"acts\"]}\n    assert {\"approve\", \"merge\"} <= acts, statement[\"acts\"]\n","numLines":54,"startLine":1,"totalLines":54}},"tool_result_meta":[{"id":"toolu_01JtNWrLStub4aWJ3BDvqVum","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}

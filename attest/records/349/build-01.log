{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PwD7ZSk8UQuuaNXnUiWdAn","type":"tool_result","content":"1\t\"\"\"attavo attest: refuse unless the latest spec, approval, build, and\n2\tverify records for an item all exist and chain, derive the item from the\n3\tmerge commit's own record paths rather than a branch name, and print the\n4\tattestation statement to stdout. Never writes -- the four stage records\n5\tare the evidence; a forge-specific template signs the printed statement\n6\ton the merge group (issue #69, section \"The lane\").\n7\t\n8\tMerges tests/test_attest_dry_run.py into this file (issue #69, change 5):\n9\tattest itself is now always a read, so there is nothing left for a\n10\t--dry-run mode to do differently.\n11\t\n12\tRegression tests, written and run red first: on `main` before this lane\n13\t`attavo attest` wrote an attestation-NN.json record and accepted\n14\t--dry-run; every test here that expects nothing written, a printed\n15\tstatement, or --dry-run refused fails against that shape.\n16\t\n17\tRun: python3 -m pytest tests -q\n18\t\"\"\"\n19\timport json\n20\timport subprocess\n21\timport sys\n22\tfrom collections.abc import Callable\n23\tfrom pathlib import Path\n24\tfrom typing import Any\n25\t\n26\timport jsonschema\n27\timport pytest\n28\t\n29\tfrom helpers import commit_all, git, init_repo, make_tenant\n30\t\n31\tROOT = Path(__file__).resolve().parent.parent\n32\tATTAVO = ROOT / \"bin\" / \"attavo\"\n33\tSTATEMENT_SCHEMA = json.loads((ROOT / \"schema\" / \"attestation.schema.json\").read_text())\n34\t\n35\t\n36\tdef run_attavo(root: Path, *args: str) -> subprocess.CompletedProcess[str]:\n37\t    return subprocess.run([sys.executable, str(ATTAVO), *args], cwd=str(root),\n38\t                          capture_output=True, text=True, check=False)\n39\t\n40\t\n41\tdef configure_forge(root: Path) -> None:\n42\t    toml = root / \"attavo.toml\"\n43\t    toml.write_text(toml.read_text()\n44\t                    + '\\n[executor.fixture]\\ny = 2\\n'\n45\t                    + '\\n[checks]\\ncommand = \"true\"\\n'\n46\t                    + \"\"\"\\n[forge]\\nchecks_command = \"printf 'ci success\\\\n'\"\\n\"\"\")\n47\t    commit_all(root, \"configure the fixture adapter, the tenant's checks, and the forge read\")\n48\t\n49\t\n50\tdef traverse_item(root: Path, item: str = \"1\") -> None:\n51\t    \"\"\"spec-gate, approve, build, verify, each committed -- the shape a\n52\t    real workflow template leaves on the item's branch before it merges.\"\"\"\n53\t    assert run_attavo(root, \"spec-gate\", item).returncode == 0\n54\t    commit_all(root, f\"attavo: spec-gate record for #{item}\")\n55\t    assert run_attavo(root, \"approve\", item, \"--by\", \"alice\").returncode == 0\n56\t    commit_all(root, f\"attavo: approval record for #{item}\")\n57\t    assert run_attavo(root, \"build\", item).returncode == 0\n58\t    commit_all(root, f\"attavo: build record for #{item}\")\n59\t    assert run_attavo(root, \"verify\", item).returncode == 0\n60\t    commit_all(root, f\"attavo: verify record for #{item}\")\n61\t\n62\t\n63\tdef merge_into_main(root: Path, branch: str) -> None:\n64\t    git(root, \"checkout\", \"main\")\n65\t    git(root, \"merge\", \"--no-ff\", \"-m\", f\"Merge branch '{branch}' into main\", branch)\n66\t\n67\t\n68\tdef records_snapshot(root: Path) -> list[Any]:\n69\t    records_dir = root / \"records\"\n70\t    return sorted(records_dir.rglob(\"*\")) if records_dir.is_dir() else []\n71\t\n72\t\n73\t# --- row 1: a coherent chain prints a valid statement and writes nothing ---\n74\t\n75\tdef test_attest_prints_a_valid_statement_on_a_coherent_chain_and_writes_nothing(tmp_path: Path) -> None:\n76\t    \"\"\"Acceptance row 1: the merge commit carries no attavo/N-* branch\n77\t    information at all -- 'improve-thing' names nothing about item 1 --\n78\t    proving the derivation reads record paths, not the branch name.\"\"\"\n79\t    root = make_tenant(tmp_path, \"build_valid\")\n80\t    configure_forge(root)\n81\t    git(root, \"checkout\", \"-b\", \"improve-thing\")\n82\t    traverse_item(root, \"1\")\n83\t    merge_into_main(root, \"improve-thing\")\n84\t\n85\t    before = records_snapshot(root)\n86\t    run = run_attavo(root, \"attest\")\n87\t    assert run.returncode == 0, run.stdout + run.stderr\n88\t\n89\t    statement = json.loads(run.stdout)\n90\t    jsonschema.validate(statement, STATEMENT_SCHEMA)\n91\t    assert statement[\"item\"] == \"1\"\n92\t    assert statement[\"sha\"] == statement[\"merge_sha\"]\n93\t    assert statement[\"tokens\"].keys() >= {\"build\", \"verify\", \"counsel\", \"input\", \"output\"}\n94\t\n95\t    assert records_snapshot(root) == before\n96\t    assert git(root, \"status\", \"--porcelain\") == \"\"\n97\t\n98\t\n99\t# --- row 2: every refusal and the --partial not-yet path, same as before ---\n100\t\n101\tdef test_attest_refuses_a_chain_with_a_missing_verify_record(tmp_path: Path) -> None:\n102\t    root = make_tenant(tmp_path, \"build_valid\")\n103\t    configure_forge(root)\n104\t    git(root, \"checkout\", \"-b\", \"attavo/1-x\")\n105\t    assert run_attavo(root, \"spec-gate\", \"1\").returncode == 0\n106\t    commit_all(root, \"attavo: spec-gate record for #1\")\n107\t    assert run_attavo(root, \"approve\", \"1\", \"--by\", \"alice\").returncode == 0\n108\t    commit_all(root, \"attavo: approval record for #1\")\n109\t    assert run_attavo(root, \"build\", \"1\").returncode == 0\n110\t    commit_all(root, \"attavo: build record for #1\")\n111\t    merge_into_main(root, \"attavo/1-x\")\n112\t\n113\t    before = records_snapshot(root)\n114\t    run = run_attavo(root, \"attest\")\n115\t    assert run.returncode == 1\n116\t    assert \"verify\" in run.stderr\n117\t    assert records_snapshot(root) == before\n118\t\n119\t\n120\tdef test_attest_refuses_a_build_whose_approval_sha_is_not_the_latest_approval(tmp_path: Path) -> None:\n121\t    \"\"\"A re-approval after the build must force a re-run.\"\"\"\n122\t    root = make_tenant(tmp_path, \"build_valid\")\n123\t    configure_forge(root)\n124\t    git(root, \"checkout\", \"-b\", \"attavo/1-x\")\n125\t    traverse_item(root, \"1\")\n126\t\n127\t    assert run_attavo(root, \"approve\", \"1\", \"--by\", \"alice\").returncode == 0\n128\t    commit_all(root, \"attavo: second approval record for #1\")\n129\t    merge_into_main(root, \"attavo/1-x\")\n130\t\n131\t    run = run_attavo(root, \"attest\")\n132\t    assert run.returncode == 1\n133\t    assert \"approval_sha\" in run.stderr\n134\t\n135\t\n136\tdef test_attest_exits_0_and_writes_nothing_when_the_merge_commit_names_zero_items(tmp_path: Path) -> None:\n137\t    \"\"\"Issue #58: not every merge is an item merge. The coherence\n138\t    template's signing steps rely on stdout not being JSON here -- a\n139\t    merge group can carry no item exactly as easily as a pull request\n140\t    can -- so this is asserted directly, not just inferred from the\n141\t    printed line's wording.\"\"\"\n142\t    root = make_tenant(tmp_path, \"build_valid\")\n143\t    git(root, \"checkout\", \"-b\", \"chore/unrelated\")\n144\t    (root / \"README-CHORE.md\").write_text(\"nothing to do with any item\\n\")\n145\t    commit_all(root, \"chore: unrelated change\")\n146\t    merge_into_main(root, \"chore/unrelated\")\n147\t\n148\t    before = records_snapshot(root)\n149\t    run = run_attavo(root, \"attest\")\n150\t    assert run.returncode == 0, run.stderr\n151\t    assert records_snapshot(root) == before\n152\t    with pytest.raises(json.JSONDecodeError):\n153\t        json.loads(run.stdout)\n154\t\n155\t\n156\tdef test_attest_refuses_when_the_merge_commit_names_two_items(tmp_path: Path) -> None:\n157\t    root = make_tenant(tmp_path, \"build_valid\")\n158\t    git(root, \"checkout\", \"-b\", \"multi\")\n159\t    (root / \"records\" / \"1\").mkdir(parents=True)\n160\t    (root / \"records\" / \"1\" / \"spec-01.json\").write_text(\"{}\\n\")\n161\t    (root / \"records\" / \"2\").mkdir(parents=True)\n162\t    (root / \"records\" / \"2\" / \"spec-01.json\").write_text(\"{}\\n\")\n163\t    commit_all(root, \"two items' records in one commit\")\n164\t    merge_into_main(root, \"multi\")\n165\t\n166\t    run = run_attavo(root, \"attest\")\n167\t    assert run.returncode == 1\n168\t    assert \"1\" in run.stderr and \"2\" in run.stderr\n169\t\n170\t\n171\tdef test_attest_exits_2_with_no_manifest(tmp_path: Path) -> None:\n172\t    root = tmp_path / \"no_manifest\"\n173\t    root.mkdir()\n174\t    (root / \"f.txt\").write_text(\"x\\n\")\n175\t    init_repo(root, \"initial\")\n176\t\n177\t    run = run_attavo(root, \"attest\")\n178\t    assert run.returncode == 2\n179\t\n180\t\n181\tdef build_missing_verify_record(root: Path) -> None:\n182\t    git(root, \"checkout\", \"-b\", \"attavo/1-x\")\n183\t    assert run_attavo(root, \"spec-gate\", \"1\").returncode == 0\n184\t    commit_all(root, \"attavo: spec-gate record for #1\")\n185\t    assert run_attavo(root, \"approve\", \"1\", \"--by\", \"alice\").returncode == 0\n186\t    commit_all(root, \"attavo: approval record for #1\")\n187\t    assert run_attavo(root, \"build\", \"1\").returncode == 0\n188\t    commit_all(root, \"attavo: build record for #1\")\n189\t    merge_into_main(root, \"attavo/1-x\")\n190\t\n191\t\n192\tdef build_stale_verify_build_sha(root: Path) -> None:\n193\t    \"\"\"A second build record, minted by hand rather than a real re-run --\n194\t    the fixture adapter's build is not idempotent against its own tree --\n195\t    naming a sha the existing verify record does not: verify-01 names\n196\t    build-01, and build-02 then passes, so verify-01 is superseded.\"\"\"\n197\t    git(root, \"checkout\", \"-b\", \"attavo/1-x\")\n198\t    traverse_item(root, \"1\")\n199\t    records_dir = root / \"records\" / \"1\"\n200\t    build_01 = json.loads((records_dir / \"build-01.json\").read_text())\n201\t    build_01[\"sha\"] = \"f\" * 40\n202\t    (records_dir / \"build-02.json\").write_text(json.dumps(build_01))\n203\t    commit_all(root, \"attavo: second build record for #1\")\n204\t    merge_into_main(root, \"attavo/1-x\")\n205\t\n206\t\n207\tdef build_second_verify_names_second_build(root: Path, monkeypatch: pytest.MonkeyPatch) -> None:\n208\t    \"\"\"A real re-approval, re-build, and re-verify: build-02 names the\n209\t    second approval, verify-02 names build-02, and the chain holds --\n210\t    the ordinary case a superseded verify must never be confused with.\n211\t    ATTAVO_FIXTURE_WRITE points the second build at a second file, its\n212\t    path added to the tenant's own boundary, since the fixture adapter's\n213\t    build is not idempotent against its own tree -- a second real build\n214\t    committing the same file as the first has nothing left to commit.\"\"\"\n215\t    git(root, \"checkout\", \"-b\", \"attavo/1-x\")\n216\t    traverse_item(root, \"1\")\n217\t    assert run_attavo(root, \"approve\", \"1\", \"--by\", \"alice\").returncode == 0\n218\t    commit_all(root, \"attavo: second approval record for #1\")\n219\t    spec = root / \"specs\" / \"1\" / \"spec.md\"\n220\t    spec.write_text(spec.read_text().replace(\"- built.txt\", \"- built.txt\\n- built2.txt\"))\n221\t    monkeypatch.setenv(\"ATTAVO_FIXTURE_WRITE\", \"built2.txt\")\n222\t    assert run_attavo(root, \"build\", \"1\").returncode == 0\n223\t    commit_all(root, \"attavo: second build record for #1\")\n224\t    assert run_attavo(root, \"verify\", \"1\").returncode == 0\n225\t    commit_all(root, \"attavo: second verify record for #1\")\n226\t    merge_into_main(root, \"attavo/1-x\")\n227\t\n228\t\n229\tdef build_two_items(root: Path) -> None:\n230\t    git(root, \"checkout\", \"-b\", \"multi\")\n231\t    (root / \"records\" / \"1\").mkdir(parents=True)\n232\t    (root / \"records\" / \"1\" / \"spec-01.json\").write_text(\"{}\\n\")\n233\t    (root / \"records\" / \"2\").mkdir(parents=True)\n234\t    (root / \"records\" / \"2\" / \"spec-01.json\").write_text(\"{}\\n\")\n235\t    commit_all(root, \"two items' records in one commit\")\n236\t    merge_into_main(root, \"multi\")\n237\t\n238\t\n239\tdef build_missing_verify_after_reapproval(root: Path) -> None:\n240\t    \"\"\"Spec, approval, build present, then a second approval after the\n241\t    build -- the shape that broke the chain in issue #62 -- verify\n242\t    absent.\"\"\"\n243\t    git(root, \"checkout\", \"-b\", \"attavo/1-x\")\n244\t    assert run_attavo(root, \"spec-gate\", \"1\").returncode == 0\n245\t    commit_all(root, \"attavo: spec-gate record for #1\")\n246\t    assert run_attavo(root, \"approve\", \"1\", \"--by\", \"alice\").returncode == 0\n247\t    commit_all(root, \"attavo: approval record for #1\")\n248\t    assert run_attavo(root, \"build\", \"1\").returncode == 0\n249\t    commit_all(root, \"attavo: build record for #1\")\n250\t    assert run_attavo(root, \"approve\", \"1\", \"--by\", \"alice\").returncode == 0\n251\t    commit_all(root, \"attavo: second approval record for #1\")\n252\t    merge_into_main(root, \"attavo/1-x\")\n253\t\n254\t\n255\tOTHER_REFUSALS = [\n256\t    pytest.param(build_two_items, None, id=\"two-items\"),\n257\t]\n258\t\n259\t\n260\t@pytest.mark.parametrize(\"build, needle\", OTHER_REFUSALS)\n261\tdef test_attest_refusals_are_unaffected_by_partial(\n262\t        tmp_path: Path, build: Callable[[Path], object], needle: str | None) -> None:\n263\t    \"\"\"--partial only forgives a missing (or superseded-verify) record;\n264\t    every other refusal -- a stale approval_sha, or two items in the\n265\t    merge diff -- is identical with or without it.\"\"\"\n266\t    root = make_tenant(tmp_path, \"build_valid\")\n267\t    configure_forge(root)\n268\t    build(root)\n269\t\n270\t    plain = run_attavo(root, \"attest\")\n271\t    partial = run_attavo(root, \"attest\", \"--partial\")\n272\t\n273\t    assert plain.returncode == partial.returncode\n274\t    assert plain.stderr == partial.stderr\n275\t    if needle:\n276\t        assert needle in plain.stderr\n277\t\n278\t\n279\tdef test_partial_exits_0_naming_verify_absent_and_writes_nothing(tmp_path: Path) -> None:\n280\t    \"\"\"spec, approval, build present, verify absent, on a no-fast-forward\n281\t    merge -- attest --partial exits 0, names the item and the stages\n282\t    present and absent, and writes nothing.\"\"\"\n283\t    root = make_tenant(tmp_path, \"build_valid\")\n284\t    configure_forge(root)\n285\t    build_missing_verify_record(root)\n286\t\n287\t    before = records_snapshot(root)\n288\t    run = run_attavo(root, \"attest\", \"--partial\")\n289\t\n290\t    assert run.returncode == 0, run.stdout + run.stderr\n291\t    assert \"1\" in run.stdout\n292\t    assert \"verify\" in run.stdout\n293\t    assert records_snapshot(root) == before\n294\t    assert git(root, \"status\", \"--porcelain\") == \"\"\n295\t\n296\t\n297\tdef test_partial_still_refuses_a_stale_approval_sha(tmp_path: Path) -> None:\n298\t    \"\"\"The same fixture with a re-approval after the build -- --partial\n299\t    does not bypass the approval_sha chain assertion.\"\"\"\n300\t    root = make_tenant(tmp_path, \"build_valid\")\n301\t    configure_forge(root)\n302\t    build_missing_verify_after_reapproval(root)\n303\t\n304\t    run = run_attavo(root, \"attest\", \"--partial\")\n305\t\n306\t    assert run.returncode == 1\n307\t    assert \"approval_sha\" in run.stderr\n308\t\n309\t\n310\tdef test_without_partial_the_missing_verify_fixture_still_refuses(tmp_path: Path) -> None:\n311\t    root = make_tenant(tmp_path, \"build_valid\")\n312\t    configure_forge(root)\n313\t    build_missing_verify_record(root)\n314\t\n315\t    run = run_attavo(root, \"attest\")\n316\t\n317\t    assert run.returncode == 1\n318\t    assert \"no verify record\" in run.stderr\n319\t\n320\t\n321\tdef test_partial_exits_0_naming_the_superseded_verify_and_the_build_it_named(tmp_path: Path) -> None:\n322\t    \"\"\"Acceptance row 1, issue #109: spec, approval, build-01 pass,\n323\t    verify-01 (naming build-01), build-02 pass. A verify record can only\n324\t    name a build that existed when it was written, so verify-01 is\n325\t    superseded by build-02, not a mismatch -- --partial exits 0 with the\n326\t    not-yet line naming verify-01 and build-02, and writes nothing.\n327\t\n328\t    Regression: on main before this lane, this fixture makes --partial\n329\t    refuse with 'verify's build_sha does not name the latest build'.\"\"\"\n330\t    root = make_tenant(tmp_path, \"build_valid\")\n331\t    configure_forge(root)\n332\t    build_stale_verify_build_sha(root)\n333\t\n334\t    before = records_snapshot(root)\n335\t    run = run_attavo(root, \"attest\", \"--partial\")\n336\t\n337\t    assert run.returncode == 0, run.stdout + run.stderr\n338\t    assert \"item 1 not yet\" in run.stdout\n339\t    assert \"verify-01 names build-01, superseded by build-02\" in run.stdout\n340\t    assert records_snapshot(root) == before\n341\t    assert git(root, \"status\", \"--porcelain\") == \"\"\n342\t\n343\t\n344\tdef test_attest_full_refuses_the_same_records_naming_the_superseded_verify(tmp_path: Path) -> None:\n345\t    \"\"\"Acceptance row 2, issue #109: the same records without --partial\n346\t    refuse -- a superseded verify is still not a verify for the latest\n347\t    build -- with the new message, never the retired mismatch wording.\n348\t\n349\t    Regression: on main before this lane, this exits 1 with\n350\t    'verify's build_sha does not name the latest build' instead.\"\"\"\n351\t    root = make_tenant(tmp_path, \"build_valid\")\n352\t    configure_forge(root)\n353\t    build_stale_verify_build_sha(root)\n354\t\n355\t    run = run_attavo(root, \"attest\")\n356\t\n357\t    assert run.returncode == 1\n358\t    assert \"no verify names the latest build\" in run.stderr\n359\t    assert \"verify-01 names\" in run.stderr\n360\t    assert \"verify's build_sha does not name the latest build\" not in run.stderr\n361\t\n362\t\n363\tdef test_attest_and_partial_agree_when_verify_two_names_build_two(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:\n364\t    \"\"\"Acceptance row 3, issue #109: verify-02 names build-02 and passes\n365\t    -- the chain holds, so attest and attest --partial behave exactly as\n366\t    they did before this lane, both printing the same statement.\"\"\"\n367\t    root = make_tenant(tmp_path, \"build_valid\")\n368\t    configure_forge(root)\n369\t    build_second_verify_names_second_build(root, monkeypatch)\n370\t\n371\t    plain = run_attavo(root, \"attest\")\n372\t    partial = run_attavo(root, \"attest\", \"--partial\")\n373\t\n374\t    assert plain.returncode == 0, plain.stdout + plain.stderr\n375\t    assert partial.returncode == 0, partial.stdout + partial.stderr\n376\t    plain_statement = json.loads(plain.stdout)\n377\t    partial_statement = json.loads(partial.stdout)\n378\t    # \"at\" is generated fresh on each call, so it alone may differ between\n379\t    # the two invocations; every other field must still agree.\n380\t    assert {**plain_statement, \"at\": None} == {**partial_statement, \"at\": None}\n381\t    jsonschema.validate(plain_statement, STATEMENT_SCHEMA)\n382\t\n383\t\n384\tdef test_statement_carries_no_ci_runs_key(tmp_path: Path) -> None:\n385\t    \"\"\"The product does not count a forge's own CI runs; a forge-read\n386\t    producer for the number is Phase 4's, if a decision ever needs it.\"\"\"\n387\t    root = make_tenant(tmp_path, \"build_valid\")\n388\t    configure_forge(root)\n389\t    git(root, \"checkout\", \"-b\", \"improve-thing\")\n390\t    traverse_item(root, \"1\")\n391\t    merge_into_main(root, \"improve-thing\")\n392\t\n393\t    run = run_attavo(root, \"attest\")\n394\t    assert run.returncode == 0, run.stdout + run.stderr\n395\t\n396\t    statement = json.loads(run.stdout)\n397\t    assert \"ci_runs\" not in statement\n398\t\n399\t\n400\t# --- row 3: --dry-run no longer exists ---\n401\t\n402\tdef test_dash_dash_dry_run_is_refused_as_an_unknown_argument(tmp_path: Path) -> None:\n403\t    root = make_tenant(tmp_path, \"build_valid\")\n404\t    configure_forge(root)\n405\t    git(root, \"checkout\", \"-b\", \"attavo/1-x\")\n406\t    traverse_item(root, \"1\")\n407\t    merge_into_main(root, \"attavo/1-x\")\n408\t\n409\t    before = records_snapshot(root)\n410\t    run = run_attavo(root, \"attest\", \"--dry-run\")\n411\t\n412\t    assert run.returncode == 2\n413\t    assert \"--dry-run\" in run.stderr\n414\t    assert records_snapshot(root) == before\n415\t"}]},"parent_tool_use_id":null,"session_id":"6f72eeed-ce9e-4916-937c-8eb7f16a3662","uuid":"e0fc6c4a-8dc7-4c82-afb4-a9dd63ac310a","timestamp":"2026-10-07T20:40:48.916Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-349/tests/test_attest.py","content":"\"\"\"attavo attest: refuse unless the latest spec, approval, build, and\nverify records for an item all exist and chain, derive the item from the\nmerge commit's own record paths rather than a branch name, and print the\nattestation statement to stdout. Never writes -- the four stage records\nare the evidence; a forge-specific template signs the printed statement\non the merge group (issue #69, section \"The lane\").\n\nMerges tests/test_attest_dry_run.py into this file (issue #69, change 5):\nattest itself is now always a read, so there is nothing left for a\n--dry-run mode to do differently.\n\nRegression tests, written and run red first: on `main` before this lane\n`attavo attest` wrote an attestation-NN.json record and accepted\n--dry-run; every test here that expects nothing written, a printed\nstatement, or --dry-run refused fails against that shape.\n\nRun: python3 -m pytest tests -q\n\"\"\"\nimport json\nimport subprocess\nimport sys\nfrom collections.abc import Callable\nfrom pathlib import Path\nfrom typing import Any\n\nimport jsonschema\nimport pytest\n\nfrom helpers import commit_all, git, init_repo, make_tenant\n\nROOT = Path(__file__).resolve().parent.parent\nATTAVO = ROOT / \"bin\" / \"attavo\"\nSTATEMENT_SCHEMA = json.loads((ROOT / \"schema\" / \"attestation.schema.json\").read_text())\n\n\ndef run_attavo(root: Path, *args: str) -> subprocess.CompletedProcess[str]:\n    return subprocess.run([sys.executable, str(ATTAVO), *args], cwd=str(root),\n                          capture_output=True, text=True, check=False)\n\n\ndef configure_forge(root: Path) -> None:\n    toml = root / \"attavo.toml\"\n    toml.write_text(toml.read_text()\n                    + '\\n[executor.fixture]\\ny = 2\\n'\n                    + '\\n[checks]\\ncommand = \"true\"\\n'\n                    + \"\"\"\\n[forge]\\nchecks_command = \"printf 'ci success\\\\n'\"\\n\"\"\")\n    commit_all(root, \"configure the fixture adapter, the tenant's checks, and the forge read\")\n\n\ndef traverse_item(root: Path, item: str = \"1\") -> None:\n    \"\"\"spec-gate, approve, build, verify, each committed -- the shape a\n    real workflow template leaves on the item's branch before it merges.\"\"\"\n    assert run_attavo(root, \"spec-gate\", item).returncode == 0\n    commit_all(root, f\"attavo: spec-gate record for #{item}\")\n    assert run_attavo(root, \"approve\", item, \"--by\", \"alice\").returncode == 0\n    commit_all(root, f\"attavo: approval record for #{item}\")\n    assert run_attavo(root, \"build\", item).returncode == 0\n    commit_all(root, f\"attavo: build record for #{item}\")\n    assert run_attavo(root, \"verify\", item).returncode == 0\n    commit_all(root, f\"attavo: verify record for #{item}\")\n\n\ndef merge_into_main(root: Path, branch: str) -> None:\n    git(root, \"checkout\", \"main\")\n    git(root, \"merge\", \"--no-ff\", \"-m\", f\"Merge branch '{branch}' into main\", branch)\n\n\ndef records_snapshot(root: Path) -> list[Any]:\n    records_dir = root / \"records\"\n    return sorted(records_dir.rglob(\"*\")) if records_dir.is_dir() else []\n\n\n# --- row 1: a coherent chain prints a valid statement and writes nothing ---\n\ndef test_attest_prints_a_valid_statement_on_a_coherent_chain_and_writes_nothing(tmp_path: Path) -> None:\n    \"\"\"Acceptance row 1: the merge commit carries no attavo/N-* branch\n    information at all -- 'improve-thing' names nothing about item 1 --\n    proving the derivation reads record paths, not the branch name.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    configure_forge(root)\n    git(root, \"checkout\", \"-b\", \"improve-thing\")\n    traverse_item(root, \"1\")\n    merge_into_main(root, \"improve-thing\")\n\n    before = records_snapshot(root)\n    run = run_attavo(root, \"attest\")\n    assert run.returncode == 0, run.stdout + run.stderr\n\n    statement = json.loads(run.stdout)\n    jsonschema.validate(statement, STATEMENT_SCHEMA)\n    assert statement[\"item\"] == \"1\"\n    assert statement[\"sha\"] == statement[\"merge_sha\"]\n    assert statement[\"tokens\"].keys() >= {\"build\", \"verify\", \"counsel\", \"input\", \"output\"}\n\n    assert records_snapshot(root) == before\n    assert git(root, \"status\", \"--porcelain\") == \"\"\n\n\n# --- row 2: every refusal and the --partial not-yet path, same as before ---\n\ndef test_attest_refuses_a_chain_with_a_missing_verify_record(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"build_valid\")\n    configure_forge(root)\n    git(root, \"checkout\", \"-b\", \"attavo/1-x\")\n    assert run_attavo(root, \"spec-gate\", \"1\").returncode == 0\n    commit_all(root, \"attavo: spec-gate record for #1\")\n    assert run_attavo(root, \"approve\", \"1\", \"--by\", \"alice\").returncode == 0\n    commit_all(root, \"attavo: approval record for #1\")\n    assert run_attavo(root, \"build\", \"1\").returncode == 0\n    commit_all(root, \"attavo: build record for #1\")\n    merge_into_main(root, \"attavo/1-x\")\n\n    before = records_snapshot(root)\n    run = run_attavo(root, \"attest\")\n    assert run.returncode == 1\n    assert \"verify\" in run.stderr\n    assert records_snapshot(root) == before\n\n\ndef test_attest_refuses_a_build_whose_approval_sha_is_not_the_latest_approval(tmp_path: Path) -> None:\n    \"\"\"A re-approval after the build must force a re-run.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    configure_forge(root)\n    git(root, \"checkout\", \"-b\", \"attavo/1-x\")\n    traverse_item(root, \"1\")\n\n    assert run_attavo(root, \"approve\", \"1\", \"--by\", \"alice\").returncode == 0\n    commit_all(root, \"attavo: second approval record for #1\")\n    merge_into_main(root, \"attavo/1-x\")\n\n    run = run_attavo(root, \"attest\")\n    assert run.returncode == 1\n    assert \"approval_sha\" in run.stderr\n\n\ndef test_attest_exits_0_and_writes_nothing_when_the_merge_commit_names_zero_items(tmp_path: Path) -> None:\n    \"\"\"Issue #58: not every merge is an item merge. The coherence\n    template's signing steps rely on stdout not being JSON here -- a\n    merge group can carry no item exactly as easily as a pull request\n    can -- so this is asserted directly, not just inferred from the\n    printed line's wording.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    git(root, \"checkout\", \"-b\", \"chore/unrelated\")\n    (root / \"README-CHORE.md\").write_text(\"nothing to do with any item\\n\")\n    commit_all(root, \"chore: unrelated change\")\n    merge_into_main(root, \"chore/unrelated\")\n\n    before = records_snapshot(root)\n    run = run_attavo(root, \"attest\")\n    assert run.returncode == 0, run.stderr\n    assert records_snapshot(root) == before\n    with pytest.raises(json.JSONDecodeError):\n        json.loads(run.stdout)\n\n\ndef test_attest_refuses_when_the_merge_commit_names_two_items(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"build_valid\")\n    git(root, \"checkout\", \"-b\", \"multi\")\n    (root / \"records\" / \"1\").mkdir(parents=True)\n    (root / \"records\" / \"1\" / \"spec-01.json\").write_text(\"{}\\n\")\n    (root / \"records\" / \"2\").mkdir(parents=True)\n    (root / \"records\" / \"2\" / \"spec-01.json\").write_text(\"{}\\n\")\n    commit_all(root, \"two items' records in one commit\")\n    merge_into_main(root, \"multi\")\n\n    run = run_attavo(root, \"attest\")\n    assert run.returncode == 1\n    assert \"1\" in run.stderr and \"2\" in run.stderr\n\n\ndef test_attest_exits_2_with_no_manifest(tmp_path: Path) -> None:\n    root = tmp_path / \"no_manifest\"\n    root.mkdir()\n    (root / \"f.txt\").write_text(\"x\\n\")\n    init_repo(root, \"initial\")\n\n    run = run_attavo(root, \"attest\")\n    assert run.returncode == 2\n\n\ndef build_missing_verify_record(root: Path) -> None:\n    git(root, \"checkout\", \"-b\", \"attavo/1-x\")\n    assert run_attavo(root, \"spec-gate\", \"1\").returncode == 0\n    commit_all(root, \"attavo: spec-gate record for #1\")\n    assert run_attavo(root, \"approve\", \"1\", \"--by\", \"alice\").returncode == 0\n    commit_all(root, \"attavo: approval record for #1\")\n    assert run_attavo(root, \"build\", \"1\").returncode == 0\n    commit_all(root, \"attavo: build record for #1\")\n    merge_into_main(root, \"attavo/1-x\")\n\n\ndef build_stale_verify_build_sha(root: Path) -> None:\n    \"\"\"A second build record, minted by hand rather than a real re-run --\n    the fixture adapter's build is not idempotent against its own tree --\n    naming a sha the existing verify record does not: verify-01 names\n    build-01, and build-02 then passes, so verify-01 is superseded.\"\"\"\n    git(root, \"checkout\", \"-b\", \"attavo/1-x\")\n    traverse_item(root, \"1\")\n    records_dir = root / \"records\" / \"1\"\n    build_01 = json.loads((records_dir / \"build-01.json\").read_text())\n    build_01[\"sha\"] = \"f\" * 40\n    (records_dir / \"build-02.json\").write_text(json.dumps(build_01))\n    commit_all(root, \"attavo: second build record for #1\")\n    merge_into_main(root, \"attavo/1-x\")\n\n\ndef build_second_verify_names_second_build(root: Path, monkeypatch: pytest.MonkeyPatch) -> None:\n    \"\"\"A real re-approval, re-build, and re-verify: build-02 names the\n    second approval, verify-02 names build-02, and the chain holds --\n    the ordinary case a superseded verify must never be confused with.\n    ATTAVO_FIXTURE_WRITE points the second build at a second file, its\n    path added to the tenant's own boundary, since the fixture adapter's\n    build is not idempotent against its own tree -- a second real build\n    committing the same file as the first has nothing left to commit.\"\"\"\n    git(root, \"checkout\", \"-b\", \"attavo/1-x\")\n    traverse_item(root, \"1\")\n    assert run_attavo(root, \"approve\", \"1\", \"--by\", \"alice\").returncode == 0\n    commit_all(root, \"attavo: second approval record for #1\")\n    spec = root / \"specs\" / \"1\" / \"spec.md\"\n    spec.write_text(spec.read_text().replace(\"- built.txt\", \"- built.txt\\n- built2.txt\"))\n    monkeypatch.setenv(\"ATTAVO_FIXTURE_WRITE\", \"built2.txt\")\n    assert run_attavo(root, \"build\", \"1\").returncode == 0\n    commit_all(root, \"attavo: second build record for #1\")\n    assert run_attavo(root, \"verify\", \"1\").returncode == 0\n    commit_all(root, \"attavo: second verify record for #1\")\n    merge_into_main(root, \"attavo/1-x\")\n\n\ndef build_two_items(root: Path) -> None:\n    git(root, \"checkout\", \"-b\", \"multi\")\n    (root / \"records\" / \"1\").mkdir(parents=True)\n    (root / \"records\" / \"1\" / \"spec-01.json\").write_text(\"{}\\n\")\n    (root / \"records\" / \"2\").mkdir(parents=True)\n    (root / \"records\" / \"2\" / \"spec-01.json\").write_text(\"{}\\n\")\n    commit_all(root, \"two items' records in one commit\")\n    merge_into_main(root, \"multi\")\n\n\ndef build_missing_verify_after_reapproval(root: Path) -> None:\n    \"\"\"Spec, approval, build present, then a second approval after the\n    build -- the shape that broke the chain in issue #62 -- verify\n    absent.\"\"\"\n    git(root, \"checkout\", \"-b\", \"attavo/1-x\")\n    assert run_attavo(root, \"spec-gate\", \"1\").returncode == 0\n    commit_all(root, \"attavo: spec-gate record for #1\")\n    assert run_attavo(root, \"approve\", \"1\", \"--by\", \"alice\").returncode == 0\n    commit_all(root, \"attavo: approval record for #1\")\n    assert run_attavo(root, \"build\", \"1\").returncode == 0\n    commit_all(root, \"attavo: build record for #1\")\n    assert run_attavo(root, \"approve\", \"1\", \"--by\", \"alice\").returncode == 0\n    commit_all(root, \"attavo: second approval record for #1\")\n    merge_into_main(root, \"attavo/1-x\")\n\n\nOTHER_REFUSALS = [\n    pytest.param(build_two_items, None, id=\"two-items\"),\n]\n\n\n@pytest.mark.parametrize(\"build, needle\", OTHER_REFUSALS)\ndef test_attest_refusals_are_unaffected_by_partial(\n        tmp_path: Path, build: Callable[[Path], object], needle: str | None) -> None:\n    \"\"\"--partial only forgives a missing (or superseded-verify) record;\n    every other refusal -- a stale approval_sha, or two items in the\n    merge diff -- is identical with or without it.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    configure_forge(root)\n    build(root)\n\n    plain = run_attavo(root, \"attest\")\n    partial = run_attavo(root, \"attest\", \"--partial\")\n\n    assert plain.returncode == partial.returncode\n    assert plain.stderr == partial.stderr\n    if needle:\n        assert needle in plain.stderr\n\n\ndef test_partial_exits_0_naming_verify_absent_and_writes_nothing(tmp_path: Path) -> None:\n    \"\"\"spec, approval, build present, verify absent, on a no-fast-forward\n    merge -- attest --partial exits 0, names the item and the stages\n    present and absent, and writes nothing.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    configure_forge(root)\n    build_missing_verify_record(root)\n\n    before = records_snapshot(root)\n    run = run_attavo(root, \"attest\", \"--partial\")\n\n    assert run.returncode == 0, run.stdout + run.stderr\n    assert \"1\" in run.stdout\n    assert \"verify\" in run.stdout\n    assert records_snapshot(root) == before\n    assert git(root, \"status\", \"--porcelain\") == \"\"\n\n\ndef test_partial_still_refuses_a_stale_approval_sha(tmp_path: Path) -> None:\n    \"\"\"The same fixture with a re-approval after the build -- --partial\n    does not bypass the approval_sha chain assertion.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    configure_forge(root)\n    build_missing_verify_after_reapproval(root)\n\n    run = run_attavo(root, \"attest\", \"--partial\")\n\n    assert run.returncode == 1\n    assert \"approval_sha\" in run.stderr\n\n\ndef test_without_partial_the_missing_verify_fixture_still_refuses(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"build_valid\")\n    configure_forge(root)\n    build_missing_verify_record(root)\n\n    run = run_attavo(root, \"attest\")\n\n    assert run.returncode == 1\n    assert \"no verify record\" in run.stderr\n\n\ndef test_partial_exits_0_naming_the_superseded_verify_and_the_build_it_named(tmp_path: Path) -> None:\n    \"\"\"Acceptance row 1, issue #109: spec, approval, build-01 pass,\n    verify-01 (naming build-01), build-02 pass. A verify record can only\n    name a build that existed when it was written, so verify-01 is\n    superseded by build-02, not a mismatch -- --partial exits 0 with the\n    not-yet line naming verify-01 and build-02, and writes nothing.\n\n    Regression: on main before this lane, this fixture makes --partial\n    refuse with 'verify's build_sha does not name the latest build'.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    configure_forge(root)\n    build_stale_verify_build_sha(root)\n\n    before = records_snapshot(root)\n    run = run_attavo(root, \"attest\", \"--partial\")\n\n    assert run.returncode == 0, run.stdout + run.stderr\n    assert \"item 1 not yet\" in run.stdout\n    assert \"verify-01 names build-01, superseded by build-02\" in run.stdout\n    assert records_snapshot(root) == before\n    assert git(root, \"status\", \"--porcelain\") == \"\"\n\n\ndef test_attest_full_refuses_the_same_records_naming_the_superseded_verify(tmp_path: Path) -> None:\n    \"\"\"Acceptance row 2, issue #109: the same records without --partial\n    refuse -- a superseded verify is still not a verify for the latest\n    build -- with the new message, never the retired mismatch wording.\n\n    Regression: on main before this lane, this exits 1 with\n    'verify's build_sha does not name the latest build' instead.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    configure_forge(root)\n    build_stale_verify_build_sha(root)\n\n    run = run_attavo(root, \"attest\")\n\n    assert run.returncode == 1\n    assert \"no verify names the latest build\" in run.stderr\n    assert \"verify-01 names\" in run.stderr\n    assert \"verify's build_sha does not name the latest build\" not in run.stderr\n\n\ndef test_attest_and_partial_agree_when_verify_two_names_build_two(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:\n    \"\"\"Acceptance row 3, issue #109: verify-02 names build-02 and passes\n    -- the chain holds, so attest and attest --partial behave exactly as\n    they did before this lane, both printing the same statement.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    configure_forge(root)\n    build_second_verify_names_second_build(root, monkeypatch)\n\n    plain = run_attavo(root, \"attest\")\n    partial = run_attavo(root, \"attest\", \"--partial\")\n\n    assert plain.returncode == 0, plain.stdout + plain.stderr\n    assert partial.returncode == 0, partial.stdout + partial.stderr\n    plain_statement = json.loads(plain.stdout)\n    partial_statement = json.loads(partial.stdout)\n    # \"at\" is generated fresh on each call, so it alone may differ between\n    # the two invocations; every other field must still agree.\n    assert {**plain_statement, \"at\": None} == {**partial_statement, \"at\": None}\n    jsonschema.validate(plain_statement, STATEMENT_SCHEMA)\n\n\ndef test_statement_carries_no_ci_runs_key(tmp_path: Path) -> None:\n    \"\"\"The product does not count a forge's own CI runs; a forge-read\n    producer for the number is Phase 4's, if a decision ever needs it.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    configure_forge(root)\n    git(root, \"checkout\", \"-b\", \"improve-thing\")\n    traverse_item(root, \"1\")\n    merge_into_main(root, \"improve-thing\")\n\n    run = run_attavo(root, \"attest\")\n    assert run.returncode == 0, run.stdout + run.stderr\n\n    statement = json.loads(run.stdout)\n    assert \"ci_runs\" not in statement\n\n\n# --- row 3: --dry-run no longer exists ---\n\ndef test_dash_dash_dry_run_is_refused_as_an_unknown_argument(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"build_valid\")\n    configure_forge(root)\n    git(root, \"checkout\", \"-b\", \"attavo/1-x\")\n    traverse_item(root, \"1\")\n    merge_into_main(root, \"attavo/1-x\")\n\n    before = records_snapshot(root)\n    run = run_attavo(root, \"attest\", \"--dry-run\")\n\n    assert run.returncode == 2\n    assert \"--dry-run\" in run.stderr\n    assert records_snapshot(root) == before\n","numLines":415,"startLine":1,"totalLines":415}},"tool_result_meta":[{"id":"toolu_01PwD7ZSk8UQuuaNXnUiWdAn","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}

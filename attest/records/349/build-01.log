s not set,\n91\t    this refuses by name rather than guess, exactly as diff_since_approval\n92\t    does.\n93\t\n94\t    The walk starts at HEAD itself when the current checkout is literally\n95\t    on the branch refs/remotes/origin/HEAD names (an ordinary checkout of\n96\t    the default branch, on push or on a developer's own machine) and at\n97\t    the remote-tracking ref's own value otherwise (any other branch, or\n98\t    the detached HEAD a pull_request or merge_group checkout leaves\n99\t    behind) -- HEAD only ever *is* the default branch's first-parent line\n100\t    in the former case; in the latter, only the remote-tracking ref names\n101\t    it. --diff-merges=first-parent gives each merge's diff against its\n102\t    first parent in the same pass git log --merges already makes to list\n103\t    them, in the same order, newest first.\"\"\"\n104\t    symref = subprocess.run(\n105\t        [\"git\", \"-C\", str(root), \"symbolic-ref\", \"-q\", \"refs/remotes/origin/HEAD\"],\n106\t        capture_output=True, text=True, check=False, env=git_env())\n107\t    if symref.returncode != 0:\n108\t        return [], \"refs/remotes/origin/HEAD is not set; run `git remote set-head origin -a`\"\n109\t    default_remote_ref = symref.stdout.strip()\n110\t    default_branch = default_remote_ref.rsplit(\"/\", 1)[-1]\n111\t    current_branch = subprocess.run(\n112\t        [\"git\", \"-C\", str(root), \"symbolic-ref\", \"-q\", \"--short\", \"HEAD\"],\n113\t        capture_output=True, text=True, check=False, env=git_env())\n114\t    default_ref = ref or (\"HEAD\" if current_branch.returncode == 0\n115\t                          and current_branch.stdout.strip() == default_branch\n116\t                          else default_remote_ref)\n117\t    try:\n118\t        out = git(root, \"log\", default_ref, \"--first-parent\", \"--merges\",\n119\t                 \"--diff-merges=first-parent\", \"--name-only\",\n120\t                 \"--format=\\x01%H\\x1f%P\")\n121\t    except RuntimeError:\n122\t        return [], None\n123\t    merges = []\n124\t    for block in out.split(\"\\x01\")[1:]:\n125\t        header, _, rest = block.partition(\"\\n\")\n126\t        sha, parents = header.split(\"\\x1f\")\n127\t        merges.append({\"sha\": sha, \"parents\": parents.split(),\n128\t                       \"touched\": [line for line in rest.splitlines() if line.strip()]})\n129\t    return merges, None\n130\t\n131\t\n132\tdef merge_introducing_records(root: Path, records_rel: str, item: str,\n133\t                              stages: tuple[str, ...],\n134\t                              merges: list[dict[str, Any]] | None = None) -> tuple[str | None, str | None]:\n135\t    \"\"\"(merge_sha, refusal): the merge commit on the default branch's own\n136\t    first-parent line whose first-parent diff introduces a record for\n137\t    every one of stages, under records_rel/item/ -- the same derivation\n138\t    attest itself uses (derive_attest_items), read here so proof two\n139\t    requires an item's stage records to have arrived by an actual merge\n140\t    on the default branch, not merely to sit in the tree, and not by a\n141\t    transport merge, a pull_request checkout's synthetic test merge, or a\n142\t    merge_group's temporary merge (issue #69 acceptance row 4; issue\n143\t    #169). merge_sha is None with no refusal when no such merge exists\n144\t    yet -- the item is not merged, not that the walk failed.\n145\t\n146\t    merges, when given, is _merges_reachable's own result -- ledger's\n147\t    cmd_ledger computes it once and passes it to every item rather than\n148\t    walking the default branch's merges again for each (issue #153); a\n149\t    caller that already has merges has also already handled\n150\t    _merges_reachable's refusal, so this never re-derives one. Left\n151\t    None, a caller with just the one item to ask (doctor's proof two)\n152\t    gets merges computed here, refusal and all.\"\"\"\n153\t    if merges is None:\n154\t        merges, refusal = _merges_reachable(root)\n155\t        if refusal:\n156\t            return None, refusal\n157\t    prefix = f\"{records_rel.rstrip('/')}/{item}/\"\n158\t    for merge in merges:\n159\t        found: set[str] = set()\n160\t        for p in merge[\"touched\"]:\n161\t            if p.startswith(prefix):\n162\t                m = RECORD_RE.match(Path(p).name)\n163\t                if m:\n164\t                    found.add(m.group(1))\n165\t        if all(s in found for s in stages):\n166\t            return merge[\"sha\"], None\n167\t    return None, None\n168\t\n169\t\n170\tINVOCATION_MARKER_SUFFIX = \".started\"\n171\t\n172\t\n173\tdef invocation_marker_path(records_dir: Path, stage: str, nn: int) -> Path:\n174\t    return records_dir / f\"{stage}-{nn:02d}{INVOCATION_MARKER_SUFFIX}\"\n175\t\n176\t\n177\tdef heartbeat_s() -> float:\n178\t    return float(os.environ.get(\"ATTAVO_HEARTBEAT_S\", 15))\n179\t\n180\t\n181\tdef heartbeat_path(root: Path, stage: str, nn: int) -> Path:\n182\t    return stage_events_dir(root) / f\"{stage}-{nn:02d}.heartbeat\"\n183\t\n184\t\n185\tdef holder_heartbeat_path(root: Path, info: dict[str, Any], stage: str, nn: int) -> Path | None:\n186\t    \"\"\"Where the holder of an invocation writes its heartbeat, as far as\n187\t    this host can read it: the directory its marker names, when the\n188\t    marker is from this host and names one; this checkout's own, for a\n189\t    marker from this host written before markers named it; None for a\n190\t    marker from another host, whose heartbeat no file here holds.\"\"\"\n191\t    import socket\n192\t    if info.get(\"host\") != socket.gethostname():\n193\t        return None\n194\t    events = info.get(\"events\")\n195\t    if isinstance(events, str) and events:\n196\t        return Path(events) / f\"{stage}-{nn:02d}.heartbeat\"\n197\t    return heartbeat_path(root, stage, nn)\n198\t\n199\t\n200\tdef heartbeat_pid(path: Path) -> int | None:\n201\t    \"\"\"The pid the worker wrote as its heartbeat file's one line on its\n202\t    first beat -- the holder's own, the only pid anyone signals. None when\n203\t    the file is absent, unreadable, empty (a worker from before this\n204\t    release touched it and wrote nothing), or not a positive integer.\"\"\"\n205\t    try:\n206\t        text = path.read_text().strip()\n207\t    except OSError:\n208\t        return None\n209\t    if not text.isdigit() or int(text) <= 0:\n210\t        return None\n211\t    return int(text)\n212\t\n213\t\n214\tdef heartbeat_age_s(path: Path) -> float | None:\n215\t    \"\"\"Seconds since the heartbeat file was last touched; None when there\n216\t    is no such file.\"\"\"\n217\t    try:\n218\t        return clock.now() - path.stat().st_mtime\n219\t    except OSError:\n220\t        return None\n221\t\n222\t\n223\tdef write_invocation_marker(root: Path, records_dir: Path, stage: str, nn: int,\n224\t                            again_by: str | None = None, events_dir: Path | None = None) -> Path:\n225\t    \"\"\"The fact that an invocation began, written before it does: at,\n226\t    host, the sha it starts on, and the product that started it. No pid:\n227\t    the writer is `attavo drive`, which returns seconds later, and the\n228\t    process that holds the stage is the worker, whose own heartbeat is\n229\t    the fact of holding it. Its record's arrival is what retires a\n230\t    marker; a marker with no record is an invocation that died or hangs,\n231\t    and proof five names it. again_by is the login that pressed `--again`\n232\t    to reset a stage whose budget was spent (or whose last two signatures\n233\t    matched) -- absent on every ordinary marker, never a bare false.\n234\t    events names the directory the holder's heartbeat will be written in\n235\t    (the checkout's own <git-dir>/attavo, events_dir when the marker is\n236\t    written from a detached worktree for another checkout): two checkouts\n237\t    on one host each keep their own, so the host alone never says where\n238\t    the holder's heartbeat can be read.\"\"\"\n239\t    import socket\n240\t    from datetime import datetime, timezone\n241\t    records_dir.mkdir(parents=True, exist_ok=True)\n242\t    path = invocation_marker_path(records_dir, stage, nn)\n243\t    sha = git(root, \"rev-parse\", \"HEAD\").strip()\n244\t    info: dict[str, Any] = {\"at\": datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\"),\n245\t                            \"host\": socket.gethostname(), \"sha\": sha,\n246\t                            \"product_version\": product_version(),\n247\t                            \"events\": str(events_dir or stage_events_dir(root))}\n248\t    if again_by:\n249\t        info[\"again_by\"] = again_by\n250\t    path.write_text(json.dumps(info, indent=2) + \"\\n\")\n251\t    return path\n252\t\n253\t\n254\tdef invocation_age_s(info: dict[str, Any]) -> float | None:\n255\t    \"\"\"Seconds since the marker's own `at` timestamp -- how long ago the\n256\t    invocation it names began, whatever host wrote it. None when `at` is\n257\t    missing or does not parse.\"\"\"\n258\t    from datetime import datetime, timezone\n259\t    at = info.get(\"at\")"}]},"parent_tool_use_id":null,"session_id":"6f72eeed-ce9e-4916-937c-8eb7f16a3662","uuid":"014f7ff1-8dfb-48c6-973b-d55485449df9","timestamp":"2026-10-07T20:39:16.800Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-349/attavo/doctor.py","content":"            continue\n        env = dict(os.environ)\n        item = fixture_item_id(fixture)\n        if item is not None:\n            env[\"ATTAVO_ITEM\"] = item\n        run = subprocess.run(gate[\"command\"], shell=True, cwd=str(fixture),\n                             capture_output=True, text=True, check=False, env=env)\n        if run.returncode == 0:\n            accepted.append(name)\n    if missing:\n        return p.fail(f\"gate(s) with no rejection fixture: {', '.join(missing
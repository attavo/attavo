{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TuEszneVmTrB6ghfuc1WhT","type":"tool_result","content":"820\tDATA_KEYED = (\"by_stage_usd\", \"by_adapter_usd\")\n821\t\n822\t\n823\tdef _same(stated: Any, summed: Any) -> bool:\n824\t    \"\"\"Equal as the accounting means it: a number equals a number of the\n825\t    same value (a store may print 40.0 as 40), a bool equals only a bool,\n826\t    and a list is equal member by member. No tolerance and no conversion:\n827\t    both sides are the same function's rounding of the same records, and an\n828\t    int one past 2**53 is not the float beside it.\"\"\"\n829\t    if isinstance(stated, bool) or isinstance(summed, bool):\n830\t        return isinstance(stated, bool) and isinstance(summed, bool) and stated == summed\n831\t    if isinstance(stated, (int, float)) and isinstance(summed, (int, float)):\n832\t        return bool(stated == summed)\n833\t    if isinstance(stated, list) and isinstance(summed, list):\n834\t        return len(stated) == len(summed) and all(_same(a, b) for a, b in zip(stated, summed))\n835\t    return type(stated) is type(summed) and bool(stated == summed)\n836\t\n837\t\n838\tdef _differences(path: str, stated: Any, summed: Any, keyed_by_data: bool = False) -> list[str]:\n839\t    \"\"\"Every field of `stated` that is not what its records sum to, named by\n840\t    its path. Only the keys the statement carries are compared, at every\n841\t    depth, so a field a later release adds is not demanded of a statement\n842\t    sealed before it; a key it carries that the function does not produce\n843\t    is a difference.\"\"\"\n844\t    if not (isinstance(stated, dict) and isinstance(summed, dict)):\n845\t        return [] if _same(stated, summed) else [f\"{path} {stated!r} is not its records' {summed!r}\"]\n846\t    found: list[str] = []\n847\t    for key in sorted(stated):\n848\t        if key not in summed:\n849\t            found.append(f\"{path}.{key} {stated[key]!r} is not a field its records sum to\")\n850\t        else:\n851\t            found += _differences(f\"{path}.{key}\", stated[key], summed[key], key in DATA_KEYED)\n852\t    if keyed_by_data:\n853\t        found += [f\"{path}.{key} is absent; its records sum to {summed[key]!r}\"\n854\t                  for key in sorted(summed.keys() - stated.keys())]\n855\t    return found\n856\t\n857\t\n858\tdef _carried(predicate: dict[str, Any], key: str) -> str:\n859\t    return repr(predicate[key]) if key in predicate else \"absent\"\n860\t\n861\t\n862\tV3_ONLY_FIELDS = (\"cost_by_stage_usd\", \"wall_clock_by_stage_s\", \"tokens_by_stage\")\n863\t\n864\t\n865\tV5_COST_FIELDS = (\"reported_usd\", \"estimated_usd\", \"basis_by_stage\", \"rates\", \"estimate_note\")\n866\t\n867\t\n868\tdef _predicate_version(statement: dict[str, Any], predicate: dict[str, Any]) -> int:\n869\t    \"\"\"The attestation version a statement was sealed under (issues #309,\n870\t    #307): named by its envelope's predicateType, else known by what it\n871\t    carries -- v3 by the final-attempt fields v4 retired, v5 by the rates\n872\t    its cost block carries, v4 otherwise. Each is judged by its own rules;\n873\t    nothing sealed is rewritten.\"\"\"\n874\t    declared = statement.get(\"predicateType\")\n875\t    named = re.search(r\"/attestation/v(\\d+)$\", declared) if isinstance(declared, str) else None\n876\t    if named:\n877\t        return int(named.group(1))\n878\t    if any(key in predicate for key in V3_ONLY_FIELDS):\n879\t        return 3\n880\t    cost = predicate.get(\"cost\")\n881\t    return 5 if isinstance(cost, dict) and \"rates\" in cost else 4\n882\t\n883\t\n884\tdef _accounting_disagrees(root: Path, item_records_dir: Path, item: str, merge_sha: str,\n885\t                          statement: dict[str, Any]) -> str | None:\n886\t    \"\"\"A sealed statement that carries `time` and `cost` (and, from v4,\n887\t    `tokens`) says what its records sum to, field by field -- the same function attest summed them\n888\t    with, over the same records (none is written after a merge), sealed at\n889\t    the same commit (the statement is computed at the merge, so lead_s and\n890\t    waiting_s are recomputed from its committer time, not excepted). Exact:\n891\t    #202 retired the one-second tolerance. A statement sealed before `time`\n892\t    existed carries neither key and is not checked; a key that is present\n893\t    holds a block, so a null one, or one block without the other, is a\n894\t    disagreement. No new read of the store.\"\"\"\n895\t    inner = statement.get(\"predicate\")\n896\t    predicate = inner if isinstance(inner, dict) else statement\n897\t    if \"time\" not in predicate and \"cost\" not in predicate:\n898\t        return None\n899\t    stated_time, stated_cost = predicate.get(\"time\"), predicate.get(\"cost\")\n900\t    where = f\"item {item} merged at {merge_sha[:12]}\"\n901\t    if not isinstance(stated_time, dict) or not isinstance(stated_cost, dict):\n902\t        return (f\"{where}: the statement's time and cost are not both blocks \"\n903\t                f\"(time is {_carried(predicate, 'time')}, cost is {_carried(predicate, 'cost')})\")\n904\t    try:\n905\t        sealed_at: int | None = int(git(root, \"show\", \"-s\", \"--format=%ct\", merge_sha).strip())\n906\t    except (RuntimeError, ValueError):\n907\t        sealed_at = None\n908\t    version = _predicate_version(statement, predicate)\n909\t    # v5 prices a record by the [cost.rates] the tenant's manifest declared\n910\t    # at the sealed commit, never by the rates the statement carries: the\n911\t    # carried block is then compared like any field, and a later edit to the\n912\t    # manifest cannot unseal anything. v3 and v4 priced nothing.\n913\t    rates: dict[str, Any] | None = None\n914\t    if version >= 5:\n915\t        try:\n916\t            declared = parse_manifest(git(root, \"show\", f\"{merge_sha}:{MANIFEST}\"))\n917\t        except (RuntimeError, ValueError) as exc:\n918\t            return (f\"{where}: the manifest {MANIFEST} cannot be read at the sealed commit, \"\n919\t                    f\"so a v5 statement's estimate cannot be checked ({exc})\")\n920\t        found = (declared.get(\"cost\") or {}).get(\"rates\")\n921\t        rates = found if isinstance(found, dict) else {}\n922\t    summed_time, summed_cost, summed_tokens = item_accounting(\n923\t        item_records_dir, sealed_at, rates)\n924\t    cost_now = {k: v for k, v in summed_cost.items() if version >= 5 or k not in V5_COST_FIELDS}\n925\t    if version < 5:  # v3 and v4 named the record, never the missing rate\n926\t        cost_now[\"not_read\"] = [n.split(\" (no [cost.rates]\")[0] for n in summed_cost[\"not_read\"]]\n927\t    differing = (_differences(\"time\", stated_time, dict(summed_time))\n928\t                 + _differences(\"cost\", stated_cost, cost_now))\n929\t    if version >= 4:\n930\t        stated_tokens = predicate.get(\"tokens\")\n931\t        if isinstance(stated_tokens, dict):\n932\t            differing += _differences(\"tokens\", stated_tokens, dict(summed_tokens))\n933\t        else:\n934\t            differing.append(f\"tokens is {_carried(predicate, 'tokens')}, not a block \"\n935\t                             f\"its records sum to {dict(summed_tokens)!r}\")\n936\t    if differing:\n937\t        return f\"{where}: the statement's \" + \"; \".join(differing)\n938\t    return None\n939\t\n940\t\n941\tdef proof_every_attested_item_is_sealed(root: Path, m: dict[str, Any] | None) -> Proof:\n942\t    p = Proof(\"every-attested-item-is-sealed\", \"every attested item has its statement in the store\")\n943\t    if m is None:\n944\t        return p.fail(f\"no {MANIFEST} at {root}; no records directory is declared\")\n945\t    cmd = attestation_command(m)\n946\t    if cmd is None:\n947\t        return p.fail(\"no [forge].attestation_command in the manifest; the store cannot be read\")\n948\t    records_rel = m.get(\"paths\", {}).get(\"records\", \"\")\n949\t    records_dir = root / records_rel\n950\t    if not records_dir.is_dir():\n951\t        return p.fail(f\"no records directory under {records_dir}\")\n952\t    items = load_records(records_dir)\n953\t    complete = [item for item, stages in sorted(items.items()) if all(s in stages for s in STAGES)]\n954\t\n955\t    # [forge].sealed_since: merges at or before this commit are before the\n956\t    # window -- the tenant could not seal them (no queue, no signing\n957\t    # workflow, or a store that held nothing yet). They are named, never\n958\t    # failed. Absent, the window starts where proof three's does: the\n959\t    # install commit, or [doctor].from (issue #192).\n960\t    since = (m.get(\"forge\") or {}).get(\"sealed_since\")\n961\t    if not (isinstance(since, str) and since.strip()):\n962\t        try:\n963\t            since = proof_window_start(root, m)[1]\n964\t        except WindowRefused as exc:\n965\t            return p.fail(str(exc))\n966\t    merges, refusal = _merges_reachable(root)\n967\t    if refusal:\n968\t        return p.fail(refusal)\n969\t    sealed: list[str] = []\n970\t    before_window: list[str] = []\n971\t    unsealed: list[str] = []\n972\t    not_merged: list[str] = []\n973\t    not_read: list[str] = []\n974\t    reasons: list[str] = []\n975\t    for item in complete:\n976\t        merge_sha, _ = merge_introducing_records(root, records_rel, item, STAGES, merges=merges)\n977\t        if merge_sha is None:\n978\t            not_merged.append(item)\n979\t            continue\n980\t        if _is_ancestor(root, merge_sha, since):\n981\t            before_window.append(item)\n982\t            continue\n983\t        statement, exit_code = statement_for(root, cmd, merge_sha)\n984\t        if statement is not None:\n985\t            sealed.append(item)\n986\t            disagreement = _accounting_disagrees(root, records_dir / item, item, merge_sha,\n987\t                                                 statement)\n988\t            if disagreement:\n989\t                reasons.append(disagreement)\n990\t        elif exit_code == 2:\n991\t            not_read.append(item)\n992\t            reasons.append(f\"item {item} merged at {merge_sha[:12]}: not read -- \"\n993\t                           f\"the store could not be read; {cmd!r} exited 2\")\n994\t        else:\n995\t            unsealed.append(item)\n996\t            reasons.append(f\"item {item} merged at {merge_sha[:12]} has no statement in the store\")\n997\t    if reasons:\n998\t        return p.fail(\"; \".join(reasons), sealed=sealed, before_window=before_window,\n999\t                      unsealed=unsealed, not_merged=not_merged, not_read=not_read)\n1000\t    window = f\" at {since[:12]}\" if before_window else \"\"\n1001\t    return p.hold(f\"{len(sealed)} sealed, {len(before_window)} before the window{window}, \"\n1002\t                 f\"{len(not_merged)} not merged\",\n1003\t                 sealed=sealed, before_window=before_window, unsealed=unsealed,\n1004\t                 not_merged=not_merged, not_read=not_read)\n1005\t\n1006\t\n1007\tdef proof_no_attested_item_is_empty(root: Path, m: dict[str, Any] | None) -> Proof:\n1008\t    \"\"\"Proof seven (item 227). Every merged, fully-staged item's passing\n1009\t    build names a change: its tree, restricted to the item's own spec\n1010\t    claims, differs from the approved tree there (item 229 -- asked\n1011\t    against the approval, not the build's own start_sha, so a build\n1012\t    that adopted a prior attempt's valid commits is not empty just\n1013\t    because that attempt owed no commit of its own; scoped to claims,\n1014\t    not \"everything outside paths.records\", so a commit that lands\n1015\t    between approval and a later attempt's start but touches no\n1016\t    claimed path never rescues or defeats the comparison on its own\n1017\t    account). Item 227 was specified, approved, built by one\n1018\t    invocation, judged by another, merged and sealed, and its build\n1019\t    committed nothing -- the executor left the stub in the working tree,\n1020\t    the gate read the tree, and main received the spec and none of the\n1021\t    change. Six proofs held over it.\n1022\t\n1023\t    [doctor].built_since: merges at or before this commit are before the\n1024\t    window -- named, never failed -- so the specimen stands on every\n1025\t    doctor run without failing the tenant forever. Absent, the window is\n1026\t    proof three's. A build record whose approval cannot be resolved\n1027\t    (no approval_sha at all, or one this repository cannot read) is\n1028\t    named as not readable, not failed.\"\"\"\n1029\t    p = Proof(\"no-attested-item-is-empty\", \"every attested item's build names a change\")\n1030\t    if m is None:\n1031\t        return p.fail(f\"no {MANIFEST} at {root}; no records directory is declared\")\n1032\t    records_rel = m.get(\"paths\", {}).get(\"records\", \"\")\n1033\t    specs_rel = m.get(\"paths\", {}).get(\"specs\", \"\")\n1034\t    records_dir = root / records_rel\n1035\t    if not records_dir.is_dir():\n1036\t        return p.fail(f\"no records directory under {records_dir}\")\n1037\t    items = load_records(records_dir)\n1038\t    complete = [item for item, stages in sorted(items.items()) if all(s in stages for s in STAGES)]\n1039\t    since = (m.get(\"doctor\") or {}).get(\"built_since\")\n1040\t    if not (isinstance(since, str) and since.strip()):\n1041\t        try:\n1042\t            since = proof_window_start(root, m)[1]\n1043\t        except WindowRefused as exc:\n1044\t            return p.fail(str(exc))\n1045\t    else:\n1046\t        try:\n1047\t            since = git(root, \"rev-parse\", \"--verify\", f\"{since}^{{commit}}\").strip()\n1048\t        except RuntimeError:\n1049\t            return p.fail(f\"[doctor] built_since {since} does not resolve to a commit\")"}]},"parent_tool_use_id":null,"session_id":"6f72eeed-ce9e-4916-937c-8eb7f16a3662","uuid":"bed83c29-8a
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Dv1LMTfUpyE988Vt7bQ88n","type":"tool_result","content":"1\t\"\"\"The record kinds, typed. Each TypedDict here mirrors one JSON schema: its\n2\tkeys are that schema's `properties` and its required keys are that schema's\n3\t`required`, and tests/test_types_mirror_schemas.py asserts both, so the type\n4\tcannot drift from the contract. The schema stays the contract; this is its\n5\tmirror (issue #189).\n6\t\n7\tEvery key each schema lists is required, so no class here is total=False; a\n8\tkey the schema someday makes optional goes in a total=False base. A value the\n9\tschema declares as an object with fixed properties but this module does not\n10\tyet name is a dict[str, Any] (or a list of them), no tighter than the schema's\n11\town `additionalProperties` allows for the adapter-owned ones.\n12\t\"\"\"\n13\tfrom __future__ import annotations\n14\t\n15\tfrom typing import Any, Literal, NotRequired, TypedDict\n16\t\n17\t# The stage names a record file's <stage>-NN.json prefix can carry, one per\n18\t# schema under schema/records/.\n19\tStage = Literal[\"spec\", \"approval\", \"build\", \"verify\", \"counsel\"]\n20\t\n21\t# \"class\" is a Python keyword, so the record kinds that carry it are built\n22\t# with the functional syntax. signature and bound are R3's own additions,\n23\t# optional (a record older than record_version 8/7 carries neither).\n24\t_StopRequired = TypedDict(\"_StopRequired\", {\n25\t    \"class\": str,\n26\t    \"provenance\": str,\n27\t    \"detail\": str | None,\n28\t})\n29\t_StopOptional = TypedDict(\"_StopOptional\", {\n30\t    \"signature\": str | None,\n31\t    \"bound\": str | None,\n32\t}, total=False)\n33\t\n34\t\n35\tclass Stop(_StopRequired, _StopOptional):\n36\t    \"\"\"build-NN.json's and verify-NN.json's `stop`: the class of a stop and whose\n37\t    it is. The two schemas enumerate different classes; the shape is the same.\"\"\"\n38\t\n39\t\n40\tclass _SpecOptional(TypedDict, total=False):\n41\t    # Written from spec/3 on (ruled 2026-09-27); records before it carry neither.\n42\t    # Each entry of `criteria` carries `kind` (\"behavioural\" | \"structural\")\n43\t    # from spec/4 on; an older entry carries none and was structural.\n44\t    # \"class\" is a Python keyword, hence the functional form below.\n45\t    research: str\n46\t\n47\t\n48\t_SpecClass = TypedDict(\"_SpecClass\", {\"class\": str | None}, total=False)\n49\t\n50\t\n51\tclass SpecRecord(_SpecOptional, _SpecClass):\n52\t    record_version: int\n53\t    item: str\n54\t    sha: str\n55\t    spec_sha: str | None\n56\t    at: str\n57\t    status: str\n58\t    approval_sha: str | None\n59\t    criteria: list[dict[str, Any]]\n60\t    refusal: str | None\n61\t    product_version: str\n62\t    product_pin: str | None\n63\t\n64\t\n65\tclass ApprovalRecord(TypedDict):\n66\t    record_version: int\n67\t    item: str\n68\t    sha: str\n69\t    spec_sha: str | None\n70\t    approved_by: str\n71\t    at: str\n72\t    product_version: str\n73\t    product_pin: str | None\n74\t\n75\t\n76\tclass _BuildRequired(TypedDict):\n77\t    record_version: int\n78\t    item: str\n79\t    sha: str\n80\t    start_sha: str\n81\t    spec_sha: str | None\n82\t    approval_sha: str | None\n83\t    at: str\n84\t    adapter: str\n85\t    adapter_config: dict[str, Any]\n86\t    executor_identity: dict[str, str]\n87\t    reports: list[str]\n88\t    adapter_version: str | None\n89\t    model: str | None\n90\t    model_version: str | None\n91\t    iterations: int\n92\t    criteria: list[dict[str, Any]]\n93\t    selected_tests: dict[str, Any] | None\n94\t    checks: dict[str, Any] | None\n95\t    tokens: dict[str, int]\n96\t    cost_usd: float | None\n97\t    wall_clock_s: float\n98\t    status: str\n99\t    refusal: str | None\n100\t    halted: dict[str, Any] | None\n101\t    refusal_kind: str | None\n102\t    report_class: str | None\n103\t    stop: Stop | None\n104\t    product_version: str\n105\t    product_pin: str | None\n106\t\n107\t\n108\tclass _BuildOptional(TypedDict, total=False):\n109\t    retry_of: str | None\n110\t    steer: str | None\n111\t\n112\t\n113\tclass BuildRecord(_BuildRequired, _BuildOptional):\n114\t    \"\"\"build-NN.json (issue #60): retry_of and steer (R3) are optional --\n115\t    absent on a record written before this release.\"\"\"\n116\t\n117\t\n118\tclass _VerifyRequired(TypedDict):\n119\t    record_version: int\n120\t    item: str\n121\t    sha: str\n122\t    build_sha: str\n123\t    build_record: str | None\n124\t    approval_sha: str | None\n125\t    at: str\n126\t    adapter: str | None\n127\t    adapter_config: dict[str, Any]\n128\t    adapter_version: str | None\n129\t    model: str | None\n130\t    model_version: str | None\n131\t    reports: list[str]\n132\t    forge_checks: dict[str, Any]\n133\t    findings: list[dict[str, Any]] | None\n134\t    tests_named: list[str]\n135\t    commits: list[str]\n136\t    stub_ratio: float | None\n137\t    tokens: dict[str, int]\n138\t    cost_usd: float | None\n139\t    wall_clock_s: float\n140\t    status: str\n141\t    report_class: str | None\n142\t    stop: Stop | None\n143\t    product_version: str\n144\t    product_pin: str | None\n145\t\n146\t\n147\tclass _VerifyOptional(TypedDict, total=False):\n148\t    retry_of: str | None\n149\t    steer: str | None\n150\t\n151\t\n152\tclass VerifyRecord(_VerifyRequired, _VerifyOptional):\n153\t    \"\"\"verify-NN.json (issue #60): retry_of and steer (R3) are optional --\n154\t    absent on a record written before this release.\"\"\"\n155\t\n156\t\n157\tclass CounselCitation(TypedDict):\n158\t    \"\"\"One counsel citation (#328): `resolution` is absent for a repository\n159\t    file at the record's sha.\"\"\"\n160\t    kind: str\n161\t    path: str | None\n162\t    symbol: str | None\n163\t    ruling_id: str | None\n164\t    resolution: NotRequired[Literal[\"input\", \"not_in_repository\", \"not_found_at_sha\"]]\n165\t\n166\t\n167\tCounselRecord = TypedDict(\"CounselRecord\", {\n168\t    \"record_version\": int,\n169\t    \"item\": str,\n170\t    \"sha\": str,\n171\t    \"record_stage\": str,\n172\t    \"record\": str,\n173\t    \"at\": str,\n174\t    \"adapter\": str | None,\n175\t    \"adapter_config\": dict[str, Any],\n176\t    \"adapter_version\": str | None,\n177\t    \"model\": str | None,\n178\t    \"model_version\": str | None,\n179\t    \"reports\": list[str],\n180\t    \"tokens\": dict[str, int],\n181\t    \"cost_usd\": float | None,\n182\t    \"wall_clock_s\": float,\n183\t    \"status\": str,\n184\t    \"class\": str | None,\n185\t    \"verdict\": str | None,\n186\t    \"citations\": list[CounselCitation],\n187\t    \"proposal\": dict[str, Any],\n188\t    \"forge\": dict[str, Any],\n189\t    \"question\": str | None,\n190\t    \"answers\": str | None,\n191\t    \"turn\": dict[str, Any] | None,\n192\t    \"product_version\": str,\n193\t    \"product_pin\": str | None,\n194\t})\n195\t\n196\t\n197\tclass StageTime(TypedDict):\n198\t    \"\"\"One stage's invocations summed (the statement's `time` block).\"\"\"\n199\t    attempts: int\n200\t    invocation_s: float\n201\t    partial: bool\n202\t\n203\t\n204\tclass ItemTime(TypedDict):\n205\t    \"\"\"Every invocation's wall_clock_s, per stage and for the item, beside\n206\t    the item's lead time -- summed from the records by `attavo attest`, so\n207\t    a view renders it and never derives it.\"\"\"\n208\t    build: StageTime\n209\t    verify: StageTime\n210\t    counsel: StageTime\n211\t    invocation_s: float\n212\t    lead_s: float | None\n213\t    waiting_s: float | None\n214\t    partial: bool\n215\t    not_read: list[str]\n216\t\n217\t\n218\tclass CostRate(TypedDict):\n219\t    \"\"\"A tenant's published price for one model ([cost.rates.\"<model>\"]).\"\"\"\n220\t    input_usd_per_mtok: float\n221\t    output_usd_per_mtok: float\n222\t    as_of: str\n223\t    source: str\n224\t\n225\t\n226\tclass ItemCost(TypedDict):\n227\t    \"\"\"Every record's cost summed: the item's total across stages and\n228\t    executors, with a subtotal per stage and per adapter. A reported\n229\t    cost_usd is taken as it stands; a null one whose model has a tenant\n230\t    rate is priced as tokens times that rate (issue #307), and the basis\n231\t    says which. A record neither reported nor priceable is named in\n232\t    not_read and makes every sum it belongs to partial -- absent is never\n233\t    zero.\"\"\"\n234\t    usd: float\n235\t    reported_usd: float\n236\t    estimated_usd: float\n237\t    by_stage_usd: dict[str, float]\n238\t    basis_by_stage: dict[str, str]\n239\t    by_adapter_usd: dict[str, float]\n240\t    rates: dict[str, CostRate]\n241\t    estimate_note: str\n242\t    partial: bool\n243\t    not_read: list[str]\n244\t\n245\t\n246\tclass StageTokens(TypedDict):\n247\t    \"\"\"One stage's tokens summed over every attempt (the statement's `tokens` block).\"\"\"\n248\t    input: int\n249\t    output: int\n250\t    partial: bool\n251\t\n252\t\n253\tclass ItemTokens(TypedDict):\n254\t    \"\"\"Every record's tokens summed, per stage and for the item. A record\n255\t    that carries no tokens is named in not_read and makes every sum it\n256\t    belongs to partial -- absent is never zero.\"\"\"\n257\t    build: StageTokens\n258\t    verify: StageTokens\n259\t    counsel: StageTokens\n260\t    input: int\n261\t    output: int\n262\t    partial: bool\n263\t    not_read: list[str]\n264\t\n265\t\n266\tclass AttestRecord(TypedDict):\n267\t    \"\"\"The statement `attavo attest` prints (schema/attestation.schema.json).\"\"\"\n268\t    sha: str\n269\t    merge_sha: str\n270\t    item: str\n271\t    spec: str | None\n272\t    spec_sha: str | None\n273\t    approval: str | None\n274\t    approval_sha: str | None\n275\t    build: str | None\n276\t    build_sha: str | None\n277\t    verify: str | None\n278\t    verify_sha: str | None\n279\t    at: str\n280\t    interventions: list[dict[str, str]]\n281\t    acts: list[dict[str, str]]\n282\t    time: ItemTime\n283\t    cost: ItemCost\n284\t    tokens: ItemTokens\n285\t    product_version: str\n286\t    product_pin: str | None\n287\t\n288\t\n289\t# What counsel reads a stop from: a build or verify record, or a refused\n290\t# spec-gate record (issue #133).\n291\tStageRecord = SpecRecord | BuildRecord | VerifyRecord\n292\t\n293\t\n294\tclass DriveReport(TypedDict):\n295\t    \"\"\"What `attavo drive N --report` prints (schema/drive-report.schema.json):\n296\t    the item's level, read from its records, its markers, and the forge.\"\"\"\n297\t    item: str\n298\t    state: str\n299\t    kind: str\n300\t    says: str\n301\t    stage: str | None\n302\t    attempt: int | None\n303\t    record: str | None\n304\t    stop_class: str | None\n305\t    counsel: str | None\n306\t    filed: str | None\n307\t    head: str | None\n308\t    checks: list[dict[str, str]] | None\n309\t    since: str | None\n310\t    last_event_age_s: int | None\n311\t    attempts: list[dict[str, Any]] | None\n312\t    signatures_match: bool | None\n313\t    rulings_available: list[str] | None\n314\t"}]},"parent_tool_use_id":null,"session_id":"6f72eeed-ce9e-4916-937c-8eb7f16a3662","uuid":"bb9825ff-ce01-4639-8046-78a75cbeede7","timestamp":"2026-10-07T20:38:51.490Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-349/attavo/types.py","content":"\"\"\"The record kinds, typed. Each TypedDict here mirrors one JSON schema: its\nkeys are that schema's `properties` and its required keys are that schema's\n`required`, and tests/test_types_mirror_schemas.py asserts both, so the type\ncannot drift from the contract. The schema stays the contract; this is its\nmirror (issue #189).\n\nEvery key each schema lists is required, so no class here is total=False; a\nkey the schema someday makes optional goes in a total=False base. A value the\nschema declares as an object with fixed properties but this module does not\nyet
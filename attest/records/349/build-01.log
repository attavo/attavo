{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01BXPeE3hopaxT9ZRteY9jE5","type":"tool_result","content":"1\tfrom __future__ import annotations\n2\t\n3\timport json\n4\timport re\n5\timport subprocess\n6\timport sys\n7\timport tempfile\n8\tfrom pathlib import Path\n9\tfrom typing import Any\n10\t\n11\tfrom attavo.build import commits_with_diffs, driver_identity\n12\tfrom attavo.common import MANIFEST, STAGES, git, read_manifest, git_env\n13\tfrom attavo.doctor import INVOCATION_MARKER_SUFFIX, _merges_reachable, merge_introducing_records\n14\tfrom attavo.records import RECORD_RE, _load_record\n15\tfrom attavo.stops import item_stops\n16\tfrom attavo import Command\n17\t\n18\t# --- ledger: every act on an item by identity and class (issue #128) ---\n19\t\n20\t# operator acts (a person's own decisions and transport) vs. product acts\n21\t# (the driver's or the records app's own automated commits) vs. the\n22\t# executor's own code changes -- the three totals the plan's status table\n23\t# and every reviewing session used to count by hand. record-or-launch\n24\t# (below) contributes to neither: an honest count never guesses which\n25\t# side of that line a pre-v0.18.0 commit falls on.\n26\tLEDGER_OPERATOR_CLASSES = (\"approve\", \"amend\", \"launch\", \"transport\", \"merge\")\n27\t\n28\tLEDGER_V018_CUTOFF = (0, 18, 0)\n29\t\n30\t\n31\tdef _semver_tuple(version: str | None) -> tuple[int, int, int] | None:\n32\t    m = re.match(r\"^v(\\d+)\\.(\\d+)\\.(\\d+)\", version or \"\")\n33\t    return (int(m.group(1)), int(m.group(2)), int(m.group(3))) if m else None\n34\t\n35\t\n36\tdef _is_records_app(name: str) -> bool:\n37\t    \"\"\"The forge's own app-bot login -- exactly the identity the\n38\t    attavo-spec-gate and attavo-approve templates commit spec-gate and\n39\t    approval records as (an app-token step mints it at run time from the\n40\t    tenant's own app credentials): \"<app-slug>[bot]\". Never a name this\n41\t    product can name in advance, so the one fact it can check is the\n42\t    shape the forge itself gives every app identity, not a specific one.\"\"\"\n43\t    return name.endswith(\"[bot]\")\n44\t\n45\t\n46\tdef first_commit_touching(root: Path, relpath: str) -> str | None:\n47\t    \"\"\"The earliest commit touching relpath -- the mirror of\n48\t    last_commit_touching, which answers the latest. Ledger's own walk\n49\t    starts here: the item's first spec commit.\"\"\"\n50\t    out = git(root, \"log\", \"--reverse\", \"--format=%H\", \"--\", relpath)\n51\t    lines = out.split()\n52\t    return lines[0] if lines else None\n53\t\n54\t\n55\tdef _record_blobs_at(root: Path, specs: list[tuple[str, str]], item_id: str) -> dict[tuple[str, str], dict[str, Any]]:\n56\t    \"\"\"{(sha, relpath): record dict} for every (sha, relpath) pair, read by\n57\t    one `git cat-file --batch` process for the whole list rather than one\n58\t    `git show` per record (issue #153, ledger's only need for a record at a\n59\t    past commit rather than the working tree -- issue #128). Each blob is\n60\t    still spilled to a throwaway file and read through _load_record (issue\n61\t    #60, acceptance 6: the one place a record's bytes become a dict),\n62\t    rather than a second json.loads of its own. A pair git cannot resolve,\n63\t    or whose blob is not valid JSON, is simply absent from the result --\n64\t    the same silence _record_at once gave a missing blob.\"\"\"\n65\t    if not specs:\n66\t        return {}\n67\t    stdin = \"\".join(f\"{sha}:{relpath}\\n\" for sha, relpath in specs)\n68\t    out = subprocess.run([\"git\", \"-C\", str(root), \"cat-file\", \"--batch\"],\n69\t                         input=stdin.encode(), capture_output=True, check=False, env=git_env())\n70\t    data = out.stdout\n71\t    pos = 0\n72\t    result: dict[tuple[str, str], dict[str, Any]] = {}\n73\t    for key in specs:\n74\t        newline = data.index(b\"\\n\", pos)\n75\t        header = data[pos:newline].decode()\n76\t        pos = newline + 1\n77\t        parts = header.split(\" \")\n78\t        if parts[-1] == \"missing\":\n79\t            continue\n80\t        size = int(parts[-1])\n81\t        content = data[pos:pos + size]\n82\t        pos += size + 1\n83\t        with tempfile.NamedTemporaryFile(\"wb\", suffix=\".json\", delete=False) as fh:\n84\t            fh.write(content)\n85\t            blob_path = Path(fh.name)\n86\t        try:\n87\t            result[key] = _load_record(blob_path, item_id)\n88\t        except json.JSONDecodeError:\n89\t            continue\n90\t        finally:\n91\t            blob_path.unlink(missing_ok=True)\n92\t    return result\n93\t\n94\t\n95\tdef item_ledger(root: Path, m: dict[str, Any], item_id: str, merges: list[dict[str, Any]] | None = None) -> dict[str, Any]:\n96\t    \"\"\"{\"item\", \"rows\", \"summary\"}: one row per act between item_id's first\n97\t    spec commit and its merge (merge_introducing_records, the same\n98\t    derivation doctor's proof two and attest both already read) or HEAD\n99\t    when the item has not merged yet.\n100\t\n101\t    merges, when given, is _merges_reachable's own result -- cmd_ledger\n102\t    computes it once and passes it here for every item, rather than each\n103\t    item walking HEAD's merges again (issue #153).\n104\t\n105\t    Each commit gets exactly one class, in this order: the merge commit\n106\t    itself is \"merge\"; a commit authored by the executor identity\n107\t    (executor_identity) is \"change\"; a commit introducing an approval\n108\t    record is \"approve\", whoever committed it -- an operator's decision,\n109\t    however it reached git; a commit introducing a spec-gate, build, or\n110\t    verify record, authored by the driver identity (driver_identity) or\n111\t    the records app, is \"record\"; the same, authored by a person, is\n112\t    \"launch\" for build or verify (spec-gate records the app always\n113\t    commits, in every template this product ships) -- unless that\n114\t    record's own product_version predates v0.18.0, when driver_identity\n115\t    did not yet exist to tell the two apart, and the row is\n116\t    \"record-or-launch\" with a note, counted in neither summary total\n117\t    rather than guessed; a person's commit touching the spec is \"spec\"\n118\t    before the first approval record and \"amend\" after; anything else by\n119\t    a person is \"transport\" (a merge of main among them).\"\"\"\n120\t    specs_rel = m[\"paths\"][\"specs\"]\n121\t    records_rel = m[\"paths\"][\"records\"]\n122\t    specs_prefix = f\"{specs_rel.rstrip('/')}/{item_id}/\"\n123\t    records_prefix = f\"{records_rel.rstrip('/')}/{item_id}/\"\n124\t    empty_summary = {\"operator_acts\": 0, \"product_acts\": 0, \"executor_commits\": 0,\n125\t                     \"stops\": 0, \"since\": None}\n126\t\n127\t    first_spec_sha = first_commit_touching(root, str(Path(specs_rel) / item_id))\n128\t    if first_spec_sha is None:\n129\t        return {\"item\": item_id, \"rows\": [], \"summary\": empty_summary}\n130\t\n131\t    if merges is None:\n132\t        merges, refusal = _merges_reachable(root)\n133\t        if refusal:\n134\t            return {\"item\": item_id, \"rows\": [], \"summary\": empty_summary}\n135\t    merge_sha, _ = merge_introducing_records(root, records_rel, item_id, STAGES, merges=merges)\n136\t    if merge_sha is not None:\n137\t        branch_tip = next(mrg[\"parents\"][1] for mrg in merges if mrg[\"sha\"] == merge_sha)\n138\t        commits = commits_with_diffs(root, f\"{first_spec_sha}^\", end=branch_tip)\n139\t        commits += commits_with_diffs(root, f\"{merge_sha}^1\", end=merge_sha)\n140\t    else:\n141\t        commits = commits_with_diffs(root, f\"{first_spec_sha}^\", end=\"HEAD\")\n142\t\n143\t    driver = driver_identity()\n144\t\n145\t    # Every record a walked commit touches, read by one batched process\n146\t    # for the whole item rather than one `git show` per record (issue\n147\t    # #153): a first pass over the already-fetched diffs finds which\n148\t    # commits touch a record, then _record_blobs_at fetches them all.\n149\t    record_touches: dict[str, tuple[str, str]] = {}\n150\t    for c in commits:\n151\t        if merge_sha is not None and c[\"sha\"] == merge_sha:\n152\t            continue\n153\t        if c[\"email\"].startswith(\"executor+\") and c[\"email\"].endswith(\"@attavo.invalid\"):\n154\t            continue\n155\t        for p in c[\"touched\"]:\n156\t            if not p.startswith(records_prefix):\n157\t                continue\n158\t            rm = RECORD_RE.match(Path(p).name)\n159\t            if rm and rm.group(1) in STAGES:\n160\t                record_touches[c[\"sha\"]] = (rm.group(1), p)\n161\t                break\n162\t    record_content = _record_blobs_at(\n163\t        root, [(sha, relpath) for sha, (_, relpath) in record_touches.items()], item_id)\n164\t\n165\t    rows: list[dict[str, Any]] = []\n166\t    operator_acts = product_acts = executor_commits = 0\n167\t    since = None\n168\t    approval_seen = False\n169\t\n170\t    for c in commits:\n171\t        sha, name, email = c[\"sha\"], c[\"name\"], c[\"email\"]\n172\t\n173\t        if merge_sha is not None and sha == merge_sha:\n174\t            rows.append({\"sha\": sha, \"identity\": name, \"class\": \"merge\"})\n175\t            operator_acts += 1\n176\t            continue\n177\t\n178\t        if email.startswith(\"executor+\") and email.endswith(\"@attavo.invalid\"):\n179\t            rows.append({\"sha\": sha, \"identity\": name, \"class\": \"change\"})\n180\t            executor_commits += 1\n181\t            continue\n182\t\n183\t        record_touch = record_touches.get(sha)\n184\t\n185\t        if record_touch is not None:\n186\t            stage, relpath = record_touch\n187\t            content = record_content.get((sha, relpath), {})\n188\t            if since is None:\n189\t                since = content.get(\"product_version\")\n190\t\n191\t            if stage == \"approval\":\n192\t                rows.append({\"sha\": sha, \"identity\": name, \"class\": \"approve\"})\n193\t                operator_acts += 1\n194\t                approval_seen = True\n195\t                continue\n196\t\n197\t            is_driver = name == driver[\"name\"] and email == driver[\"email\"]\n198\t            is_records_app = _is_records_app(name)\n199\t            if stage == \"spec\" or is_driver or is_records_app:\n200\t                rows.append({\"sha\": sha, \"identity\": name, \"class\": \"record\"})\n201\t                product_acts += 1\n202\t                continue\n203\t\n204\t            version = _semver_tuple(content.get(\"product_version\"))\n205\t            if version is not None and version < LEDGER_V018_CUTOFF:\n206\t                rows.append({\"sha\": sha, \"identity\": name, \"class\": \"record-or-launch\",\n207\t                            \"note\": \"not distinguishable before v0.18.0\"})\n208\t                continue\n209\t\n210\t            rows.append({\"sha\": sha, \"identity\": name, \"class\": \"launch\"})\n211\t            operator_acts += 1\n212\t            continue\n213\t\n214\t        # An invocation marker's own commit (proof five): the product's\n215\t        # act, never the operator's.\n216\t        if any(p.startswith(records_prefix) and p.endswith(INVOCATION_MARKER_SUFFIX)\n217\t               for p in c[\"touched\"]):\n218\t            rows.append({\"sha\": sha, \"identity\": name, \"class\": \"record\"})\n219\t            product_acts += 1\n220\t            continue\n221\t\n222\t        if any(p.startswith(specs_prefix) for p in c[\"touched\"]):\n223\t            cls = \"amend\" if approval_seen else \"spec\"\n224\t            rows.append({\"sha\": sha, \"identity\": name, \"class\": cls})\n225\t            if cls == \"amend\":\n226\t                operator_acts += 1\n227\t            continue\n228\t\n229\t        rows.append({\"sha\": sha, \"identity\": name, \"class\": \"transport\"})\n230\t        operator_acts += 1\n231\t\n232\t    # issue #137: the same set attavo stops counts, from the same reader\n233\t    # (item_stops) -- not a second, independent count kept in sync by\n234\t    # hand. One non-pass record per row, whatever its stage; a gate\n235\t    # refusal is included the same as a non-pass build or verify record.\n236\t    stops = len(item_stops(root, m, item_id)[\"rows\"])\n237\t\n238\t    summary = {\"operator_acts\": operator_acts, \"product_acts\": product_acts,\n239\t              \"executor_commits\": executor_commits, \"stops\": stops, \"since\": since}\n240\t    return {\"item\": item_id, \"rows\": rows, \"summary\": summary}\n241\t\n242\t\n243\tdef cmd_ledger(argv: list[str]) -> int:\n244\t    as_json = \"--json\" in argv\n245\t    positional = [a for a in argv if a != \"--json\"]\n246\t    root = Path(\".\").resolve()\n247\t    m = read_manifest(root)\n248\t    if m is None:\n249\t        print(f\"attavo ledger: no {MANIFEST} at {root}\", file=sys.stderr)\n250\t        return 2\n251\t\n252\t    records_rel = m[\"paths\"][\"records\"]\n253\t    if positional:\n254\t        item_ids = [positional[0]]\n255\t    else:\n256\t        records_root = root / records_rel\n257\t        item_ids = (sorted((p.name for p in records_root.iterdir() if p.is_dir()))\n258\t                   if records_root.is_dir() else [])\n259\t\n260\t    # Computed once for every item in this read, not once per item (issue\n261\t    # #153): the default branch's merges do not depend on which item is\n262\t    # being asked about.\n263\t    merges, refusal = _merges_reachable(root)\n264\t    if refusal:\n265\t        print(f\"attavo ledger: refused: {refusal}\", file=sys.stderr)\n266\t        return 2\n267\t    ledgers = [item_ledger(root, m, item_id, merges=merges) for item_id in item_ids]\n268\t\n269\t    if as_json:\n270\t        if positional:\n271\t            print(json.dumps(ledgers[0], indent=2))\n272\t        else:\n273\t            print(json.dumps({\"items\": ledgers}, indent=2))\n274\t        return 0\n275\t\n276\t    for entry in ledgers:\n277\t        print(f\"attavo ledger: item {entry['item']}\")\n278\t        for row in entry[\"rows\"]:\n279\t            note = f\"  ({row['note']})\" if \"note\" in row else \"\"\n280\t            print(f\"  {row['sha'][:12]}  {row['identity']:<32}  {row['class']}{note}\")\n281\t        s = entry[\"summary\"]\n282\t        print(f\"  operator acts: {s['operator_acts']}  product acts: {s['product_acts']}  \"\n283\t             f\"executor commits: {s['executor_commits']}  stops: {s['stops']}  \"\n284\t             f\"since: {s['since']}\")\n285\t    if not ledgers:\n286\t        print(f\"attavo ledger: no item found under {records_rel}\")\n287\t    return 0\n288\t\n289\t\n290\tCOMMANDS = (\n291\t    Command(\n292\t        name='ledger',\n293\t        run=cmd_ledger,\n294\t        usage=('attavo ledger [N] [--json]',),\n295\t        rank=140,\n296\t        help=(\n297\t            (250, \"\"\"\\\n298\tledger reads, never writes. For item N (or every item under\n299\tpaths.records when N is omitted), it walks the commits from the item's\n300\tfirst spec commit to its merge (the same derivation doctor's proof two\n301\tand attest use) or to HEAD when the item has not merged, and prints one\n302\trow per act: the sha, the identity as git names it, and a class from a\n303\tclosed list -- spec, amend, approve, launch, record, change, transport,\n304\tmerge -- derived from who committed it and, for an approval, build, or\n305\tverify record, what the record itself says. A summary line follows:\n306\toperator acts (approve, amend, launch, transport, merge), product acts\n307\t(record), executor commits (change), stops (non-pass records), and\n308\tsince (the product version on the first record). A build or verify\n309\trecord's own commit, from before v0.18.0 gave the driver and the\n310\texecutor their own identities, prints as record-or-launch with a note,\n311\tcounted toward neither total, rather than guessed. --json prints the\n312\trows and the summary as one object. See issue #128's lane for the full\n313\trules it enforces.\"\"\"),\n314\t        ),\n315\t    ),\n316\t)\n317\t"}]},"parent_tool_use_id":null,"session_id":"6f72eeed-ce9e-4916-937c-8eb7f16a3662","uuid":"ee71ff35-858c-405b-a149-eacae93434d5","timestamp":"2026-10-07T20:38:46.820Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-349/attavo/ledger.py","content":"from __future__ import annotations\n\nimport json\nimport re\nimport subprocess\nimport sys\nimport tempfile\nfrom pathlib import Path\nfrom typing import Any\n\nfrom attavo.build import commits_with_diffs, driver_identity\nfrom attavo.common import MANIFEST, STAGES, git, read_manifest, git_env\nfrom attavo.doctor import INVOCATION_MARKER_SUFFIX, _merges_reachable, merge_introducing_records\nfrom attavo.records import RECORD_RE, _load_record\nfrom attavo.stops import item_stops\nfrom attavo import Command\n\n# --- ledger: every act on an item by identity and class (issue #128) ---\n\n# operator acts (a person's own decisions and transport) vs. product acts\n# (the driver's or the records app's own automated commits) vs. the\n# executor's own code changes -- the three totals the plan's status table\n# and every reviewing session used to count by hand. record-or-launch\n# (below) contributes to neither: an honest count never guesses which\n# side of that line a pre-v0.18.0 commit falls on.\nLEDGER_OPERATOR_CLASSES = (\"approve\", \"amend\", \"launch\", \"transport\", \"merge\")\n\nLEDGER_V018_CUTOFF = (0, 18, 0)\n\n\ndef _semver_tuple(version: str | None) -> tuple[int, int, int] | None:\n    m = re.match(r\"^v(\\d+)\\.(\\d+)\\.(\\d+)\", version or \"\")\n    return (int(m.group(1)), int(m.group(2)), int(m.group(3))) if m else None\n\n\ndef _is_records_app(name: str) -> bool:\n    \"\"\"The forge's own app-bot login -- exactly the identity the\n    attavo-spec-gate and attavo-approve templates commit spec-gate and\n    approval records as (an app-token step mints it at run time from the\n    tenant's own app credentials): \"<app-slug>[bot]\". Never a name this\n    product can name in advance, so the one fact it can check is the\n    shape the forge itself gives every app identity, not a specific one.\"\"\"\n    return name.endswith(\"[bot]\")\n\n\ndef first_commit_touching(root: Path, relpath: str) -> str | None:\n    \"\"\"The earliest commit touching relpath -- the mirror of\n    last_commit_touching, which answers the latest. Ledger's own walk\n    starts here: the item's first spec commit.\"\"\"\n    out = git(root, \"log\", \"--reverse\", \"--format=%H\", \"--\", relpath)\n    lines = out.split()\n    return lines[0] if lines else None\n\n\ndef _record_blobs_at(root: Path, specs: list[tuple[str, str]], item_id: str) -> dict[tuple[str, str], dict[str, Any]]:\n    \"\"\"{(sha, relpath): record dict} for every (sha, relpath) pair, read by\n    one `git cat-file --batch` process for the whole list rather than one\n    `git show` per record (issue #153, ledger's only need for a record at a\n    past commit rather than the working tree -- issue #128). Each blob is\n    still spilled to a throwaway file and read through _load_record (issue\n    #60, acceptance 6: the one place a record's bytes become a dict),\n    rather than a second json.loads of its own. A pair git cannot resolve,\n    or whose blob is not valid JSON, is simply absent from the result --\n    the same silence _record_at once gave a missing blob.\"\"\"\n    if not specs:\n        return {}\n    stdin = \"\".join(f\"{sha}:{relpath}\\n\" for sha, relpath in specs)\n    out = subprocess.run([\"git\", \"-C\", str(root), \"cat-file\", \"--batch\"],\n                         input=stdin.encode(), capture_output=True, check=False, env=git_env())\n    data = out.stdout\n    pos = 0\n    result: dict[tuple[str, str], dict[str, Any]] = {}\n    for key in specs:\n        newline = data.index(b\"\\n\", pos)\n        header = data[pos:newline].decode()\n        pos = newline + 1\n        parts = header.split(\" \")\n        if parts[-1] == \"missing\":\n            continue\n        size = int(parts[-1])\n        content = data[pos:pos + size]\n        pos += size + 1\n        with tempfile.NamedTemporaryFile(\"wb\", suffix=\".json\", delete=False) as fh:\n            fh.write(content)\n            blob_path = Path(fh.name)\n        try:\n            result[key] = _load_record(blob_path, item_id)\n        except json.JSONDecodeError:\n            continue\n        finally:\n            blob_path.unlink(missing_ok=True)\n    return result\n\n\ndef item_ledger(root: Path, m: dict[str, Any], item_id: str, merges: list[dict[str, Any]] | None = None) -> dict[str, Any]:\n    \"\"\"{\"item\", \"rows\", \"summary\"}: one row per act between item_id's first\n    spec commit and its merge (merge_introducing_records, the same\n    derivation doctor's proof two and attest both already read) or HEAD\n    when the item has not merged yet.\n\n    merges, when given, is _merges_reachable's own result -- cmd_ledger\n    computes it once and passes it here for every item, rather than each\n    item walking HEAD's merges again (issue #153).\n\n    Each commit gets exactly one class, in this order: the merge commit\n    itself is \"merge\"; a commit authored by the executor identity\n    (executor_identity) is \"change\"; a commit introducing an approval\n    record is \"approve\", whoever committed it -- an operator's decision,\n    however it reached git; a commit introducing a spec-gate, build, or\n    verify record, authored by the driver identity (driver_identity) or\n    the records app, is \"record\"; the same, authored by a person, is\n    \"launch\" for build or verify (spec-gate records the app always\n    commits, in every template this product ships) -- unless that\n    record's own product_version predates v0.18.0, when driver_identity\n    did not yet exist to tell the two apart, and the row is\n    \"record-or-launch\" with a note, counted in neither summary total\n    rather than guessed; a person's commit touching the spec is \"spec\"\n    before the first approval record and \"amend\" after; anything else by\n    a person is \"transport\" (a merge of main among them).\"\"\"\n    specs_rel = m[\"paths\"][\"specs\"]\n    records_rel = m[\"paths\"][\"records\"]\n    specs_prefix = f\"{specs_rel.rstrip('/')}/{item_id}/\"\n    records_prefix = f\"{records_rel.rstrip('/')}/{item_id}/\"\n    empty_summary = {\"operator_acts\": 0, \"product_acts\": 0, \"executor_commits\": 0,\n                     \"stops\": 0, \"since\": None}\n\n    first_spec_sha = first_commit_touching(root, str(Path(specs_rel) / item_id))\n    if first_spec_sha is None:\n        return {\"item\": item_id, \"rows\": [], \"summary\": empty_summary}\n\n    if merges is None:\n        merges, refusal = _merges_reachable(root)\n        if refusal:\n            return {\"item\": item_id, \"rows\": [], \"summary\": empty_summary}\n    merge_sha, _ = merge_introducing_records(root, records_rel, item_id, STAGES, merges=merges)\n    if merge_sha is not None:\n        branch_tip = next(mrg[\"parents\"][1] for mrg in merges if mrg[\"sha\"] == merge_sha)\n        commits = commits_with_diffs(root, f\"{first_spec_sha}^\", end=branch_tip)\n        commits += commits_with_diffs(root, f\"{merge_sha}^1\", end=merge_sha)\n    else:\n        commits = commits_with_diffs(root, f\"{first_spec_sha}^\", end=\"HEAD\")\n\n    driver = driver_identity()\n\n    # Every record a walked commit touches, read by one batched process\n    # for the whole item rather than one `git show` per record (issue\n    # #153): a first pass over the already-fetched diffs finds which\n    # commits touch a record, then _record_blobs_at fetches them all.\n    record_touches: dict[str, tuple[str, str]] = {}\n    for c in commits:\n        if merge_sha is not None and c[\"sha\"] == merge_sha:\n            continue\n        if c[\"email\"].startswith(\"executor+\") and c[\"email\"].endswith(\"@attavo.invalid\"):\n            continue\n        for p in c[\"touched\"]:\n            if not p.startswith(records_prefix):\n                continue\n            rm = RECORD_RE.match(Path(p).name)\n            if rm and rm.group(1) in STAGES:\n                record_touches[c[\"sha\"]] = (rm.group(1), p)\n                break\n    record_content = _record_blobs_at(\n        root, [(sha, relpath) for sha, (_, relpath) in record_touches.items()], item_id)\n\n    rows: list[dict[str, Any]] = []\n    operator_acts = product_acts = executor_commits = 0\n    since = None\n    approval_seen = False\n\n    for c in commits:\n        sha, name, email = c[\"sha\"], c[\"name\"], c[\"email\"]\n\n        if merge_sha is not None and sha == merge_sha:\n            rows.append({\"sha\": sha, \"identity\": name, \"class\": \"merge\"})\n            operator_acts += 1\n            continue\n\n        if email.startswith(\"executor+\") and email.endswith(\"@attavo.invalid\"):\n            rows.append({\"sha\": sha, \"identity\": name, \"class\": \"change\"})\n            executor_commits += 1\n            continue\n\n        record_touch = record_touches.get(sha)\n\n        if record_touch is not None:\n            stage, relpath = record_touch\n            content = record_content.get((sha, relpath), {})\n            if since is None:\n                since = content.get(\"product_version\")\n\n            if stage == \"approval\":\n                rows.append({\"sha\": sha, \"identity\": name, \"class\": \"approve\"})\n                operator_acts += 1\n                approval_seen = True\n                continue\n\n            is_driver = name == driver[\"name\"] and email == driver[\"email\"]\n            is_records_app = _is_records_app(name)\n            if stage == \"spec\" or is_driver or is_records_app:\n                rows.append({\"sha\": sha, \"identity\": name, \"class\": \"record\"})\n                product_acts += 1\n                continue\n\n            version = _semver_tuple(content.get(\"product_version\"))\n            if version is not None and version < LEDGER_V018_CUTOFF:\n                rows.append({\"sha\": sha, \"identity\": name, \"class\": \"record-or-launch\",\n                            \"note\": \"not distinguishable before v0.18.0\"})\n                continue\n\n            rows.append({\"sha\": sha, \"identity\": name, \"class\": \"launch\"})\n            operator_acts += 1\n            continue\n\n        # An invocation marker's own commit (proof five): the product's\n        # act, never the operator's.\n        if any(p.startswith(records_prefix) and p.endswith(INVOCATION_MARKER_SUFFIX)\n               for p in c[\"touched\"]):\n            rows.append({\"sha\": sha, \"identity\": name, \"class\": \"record\"})\n            product_acts += 1\n            continue\n\n        if any(p.startswith(specs_prefix) for p in c[\"touched\"]):\n            cls = \"amend\" if approval_seen else \"spec\"\n            rows.append({\"sha\": sha, \"identity\": name, \"class\": cls})\n            if cls == \"amend\":\n                operator_acts += 1\n            continue\n\n        rows.append({\"sha\": sha, \"identity\": name, \"class\": \"transport\"})\n        operator_acts += 1\n\n    # issue #137: the same set attavo stops counts, from the same reader\n    # (item_stops) -- not a second, independent count kept in sync by\n    # hand. One non-pass record per row, whatever its stage; a gate\n    # refusal is included the same as a non-pass build or verify record.\n    stops = len(item_stops(root, m, item_id)[\"rows\"])\n\n    summary = {\"operator_acts\": operator_acts, \"product_acts\": product_acts,\n              \"executor_commits\": executor_commits, \"stops\": stops, \"since\": since}\n    return {\"item\": item_id, \"rows\": rows, \"summary\": summary}\n\n\ndef cmd_ledger(argv: list[str]) -> int:\n    as_json = \"--json\" in argv\n    positional = [a for a in argv if a != \"--json\"]\n    root = Path(\".\").resolve()\n    m = read_manifest(root)\n    if m is None:\n        print(f\"attavo ledger: no {MANIFEST} at {root}\", file=sys.stderr)\n        return 2\n\n    records_rel = m[\"paths\"][\"records\"]\n    if positional:\n        item_ids = [positional[0]]\n    else:\n        records_root = root / records_rel\n        item_ids = (sorted((p.name for p in records_root.iterdir() if p.is_dir()))\n                   if records_root.is_dir() else [])\n\n    # Computed once for every item in this read, not once per item (issue\n    # #153): the default branch's merges do not depend on which item is\n    # being asked about.\n    merges, refusal = _merges_reachable(root)\n    if refusal:\n        print(f\"attavo ledger: refused: {refusal}\", file=sys.stderr)\n        return 2\n    ledgers = [item_ledger(root, m, item_id, merges=merges) for item_id in item_ids]\n\n    if as_json:\n        if positional:\n            print(json.dumps(ledgers[0], indent=2))\n        else:\n            print(json.dumps({\"items\": ledgers}, indent=2))\n        return 0\n\n    for entry in ledgers:\n        print(f\"attavo ledger: item {entry['item']}\")\n        for row in entry[\"rows\"]:\n            note = f\"  ({row['note']})\" if \"note\" in row else \"\"\n            print(f\"  {row['sha'][:12]}  {row['identity']:<32}  {row['class']}{note}\")\n        s = entry[\"summary\"]\n        print(f\"  operator acts: {s['operator_acts']}  product acts: {s['product_acts']}  \"\n             f\"executor commits: {s['executor_commits']}  stops: {s['stops']}  \"\n             f\"since: {s['since']}\")\n    if not ledgers:\n        print(f\"attavo ledger: no item found under {records_rel}\")\n    return 0\n\n\nCOMMANDS = (\n    Command(\n        name='ledger',\n        run=cmd_ledger,\n        usage=('attavo ledger [N] [--json]',),\n        rank=140,\n        help=(\n            (250, \"\"\"\\\nledger reads, never writes. For item N (or every item under\npaths.records when N is omitted), it walks the commits from the item's\nfirst spec commit to its merge (the same derivation doctor's proof two\nand attest use) or to HEAD when the item has not merged, and prints one\nrow per act: the sha, the identity as git names it, and a class from a\nclosed list -- spec, amend, approve, launch, record, change, transport,\nmerge -- derived from who committed it and, for an approval, build, or\nverify record, what the record itself says. A summary line follows:\noperator acts (approve, amend, launch, transport, merge), product acts\n(record), executor commits (change), stops (non-pass records), and\nsince (the product version on the first record). A build or verify\nrecord's own commit, from before v0.18.0 gave the driver and the\nexecutor their own identities, prints as record-or-launch with a note,\ncounted toward neither total, rather than guessed. --json prints the\nrows and the summary as one object. See issue #128's lane for the full\nrules it enforces.\"\"\"),\n        ),\n    ),\n)\n","numLines":317,"startLine":1,"totalLines":317}},"tool_result_meta":[{"id":"toolu_01BXPeE3hopaxT9ZRteY9jE5","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}

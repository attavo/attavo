{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HV25PHPZxFDr9etkYoUyjm","type":"tool_result","content":"diff --git a/schema/attestation.schema.json b/schema/attestation.schema.json\nindex 65b7c8e..0ffc4f8 100644\n--- a/schema/attestation.schema.json\n+++ b/schema/attestation.schema.json\n@@ -1,7 +1,7 @@\n {\n   \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n-  \"$id\": \"https://attavo.dev/attestation/v5\",\n-  \"title\": \"The attestation statement `attavo attest` prints on a coherent chain (v5: `cost` also prices, from the tenant's published rates, a record whose adapter reported none, and says so; v4: `time`, `cost` and `tokens` are the only accounting, summed over every attempt; v3 statements sealed earlier also carry cost_by_stage_usd, wall_clock_by_stage_s and tokens_by_stage, the final attempt of each stage)\",\n+  \"$id\": \"https://attavo.dev/attestation/v6\",\n+  \"title\": \"The attestation statement `attavo attest` prints on a coherent chain (v6: `interventions` and `acts` are read from the item's own commits between its first spec commit and its merge, each one classed exactly once by attavo/ledger.py::item_ledger -- sha is now required in both; v5: `cost` also prices, from the tenant's published rates, a record whose adapter reported none, and says so; v4: `time`, `cost` and `tokens` are the only accounting, summed over every attempt; v3 statements sealed earlier also carry cost_by_stage_usd, wall_clock_by_stage_s and tokens_by_stage, the final attempt of each stage)\",\n   \"type\": \"object\",\n   \"additionalProperties\": false,\n   \"required\": [\n@@ -25,29 +25,31 @@\n     \"at\": {\"type\": \"string\", \"minLength\": 1},\n     \"interventions\": {\n       \"type\": \"array\",\n-      \"description\": \"Corrections or amendments made during the item's traversal. Nothing populates this yet.\",\n+      \"description\": \"Every operator row on the item other than approve and merge -- amend, launch, transport -- read from attavo/ledger.py::item_ledger's own rows between the item's first spec commit and its merge (issue #349): the row's class, its sha, the commit's own author name, and its committer time.\",\n       \"items\": {\n         \"type\": \"object\",\n         \"additionalProperties\": false,\n-        \"required\": [\"at\", \"class\", \"by\"],\n+        \"required\": [\"at\", \"class\", \"by\", \"sha\"],\n         \"properties\": {\n           \"at\": {\"type\": \"string\", \"minLength\": 1},\n           \"class\": {\"type\": \"string\", \"minLength\": 1},\n-          \"by\": {\"type\": \"string\", \"minLength\": 1}\n+          \"by\": {\"type\": \"string\", \"minLength\": 1},\n+          \"sha\": {\"type\": \"string\", \"minLength\": 1}\n         }\n       }\n     },\n     \"acts\": {\n       \"type\": \"array\",\n-      \"description\": \"Operator acts on the item: approve, rule, merge. Nothing populates this yet.\",\n+      \"description\": \"The operator's ruled acts on the item: each approve row and the merge row, read the same way (issue #349). rule stays in this enum for the ruling record (#276) and is never produced here.\",\n       \"items\": {\n         \"type\": \"object\",\n         \"additionalProperties\": false,\n-        \"required\": [\"at\", \"act\", \"by\"],\n+        \"required\": [\"at\", \"act\", \"by\", \"sha\"],\n         \"properties\": {\n           \"at\": {\"type\": \"string\", \"minLength\": 1},\n           \"act\": {\"type\": \"string\", \"enum\": [\"approve\", \"rule\", \"merge\"]},\n-          \"by\": {\"type\": \"string\", \"minLength\": 1}\n+          \"by\": {\"type\": \"string\", \"minLength\": 1},\n+          \"sha\": {\"type\": \"string\", \"minLength\": 1}\n         }\n       }\n     },\ndiff --git a/tests/test_attest.py b/tests/test_attest.py\nindex 9886395..c887892 100644\n--- a/tests/test_attest.py\n+++ b/tests/test_attest.py\n@@ -92,6 +92,12 @@ def test_attest_prints_a_valid_statement_on_a_coherent_chain_and_writes_nothing(\n     assert statement[\"sha\"] == statement[\"merge_sha\"]\n     assert statement[\"tokens\"].keys() >= {\"build\", \"verify\", \"counsel\", \"input\", \"output\"}\n \n+    # issue #349: acts is read from the item's own commits, never the\n+    # hard-coded [] the schema used to carry regardless -- the approval and\n+    # the merge are always among them.\n+    assert {\"approve\", \"merge\"} <= {a[\"act\"] for a in statement[\"acts\"]}\n+    assert all(a[\"sha\"] for a in statement[\"acts\"])\n+\n     assert records_snapshot(root) == before\n     assert git(root, \"status\", \"--porcelain\") == \"\"\n \ndiff --git a/tests/test_attest_time.py b/tests/test_attest_time.py\nindex a0adf45..97dfc46 100644\n--- a/tests/test_attest_time.py\n+++ b/tests/test_attest_time.py\n@@ -321,10 +321,10 @@ def test_statement_carries_only_the_summed_accounting(tmp_path: Path) -> None:\n     assert statement[\"tokens\"][\"partial\"] is False and statement[\"tokens\"][\"not_read\"] == []\n \n \n-def test_schema_is_v5_and_names_no_retired_field() -> None:\n+def test_schema_is_v6_and_names_no_retired_field() -> None:\n     \"\"\"#309: the predicate type moved to v4 with the three fields gone; #307\n-    moves it to v5, and they stay gone.\"\"\"\n-    assert SCHEMA[\"$id\"] == \"https://attavo.dev/attestation/v5\"\n+    moved it to v5, and #349 to v6; they stay gone.\"\"\"\n+    assert SCHEMA[\"$id\"] == \"https://attavo.dev/attestation/v6\"\n     for field in RETIRED:\n         assert field not in SCHEMA[\"properties\"] and field not in SCHEMA[\"required\"]\n     assert \"tokens\" in SCHEMA[\"required\"]","is_error":false}]},"parent_tool_use_id":null,"session_id":"6f72eeed-ce9e-4916-937c-8eb7f16a3662","uuid":"9e3cd4d9-cf81-484c-a3b2-ffba554350bc","timestamp":"2026-10-07T21:23:59.513Z","tool_use_result":{"stdout":"diff --git a/schema/attestation.schema.json b/schema/attestation.schema.json\nindex 65b7c8e..0ffc4f8 100644\n--- a/schema/attestation.schema.json\n+++ b/schema/attestation.schema.json\n@@ -1,7 +1,7 @@\n {\n   \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n-  \"$id\": \"https://attavo.dev/attestation/v5\",\n-  \"title\": \"The attestation statement `attavo attest` prints on a coherent chain (v5: `cost` also prices, from the tenant's published rates, a record whose adapter reported none, and says so; v4: `time`, `cost` and `tokens` are the only accounting, summed over every attempt; v3 statements sealed earlier also carry cost_by_stage_usd, wall_clock_by_stage_s and tokens_by_stage, the final attempt of each stage)\",\n+  \"$id\": \"https://attavo.dev/attestation/v6\",\n+  \"title\": \"The attestation statement `attavo attest` prints on a coherent chain (v6: `interventions` and `acts` are read from the item's own commits between its first spec commit and its merge, each one classed exactly once by attavo/ledger.py::item_ledger -- sha is now required in both; v5: `cost` also prices, from the tenant's published rates, a record whose adapter reported none, and says so; v4: `time`, `cost` and `tokens` are the only accounting, summed over every attempt; v3 statements sealed earlier also carry cost_by_stage_usd, wall_clock_by_stage_s and tokens_by_stage, the final attempt of each stage)\",\n   \"type\": \"object\",\n   \"additionalProperties\": false,\n   \"required\": [\n@@ -25,29 +25,31 @@\n     \"at\": {\"type\": \"string\", \"minLength\": 1},\n     \"interventions\": {\n       \"type\": \"array\",\n-      \"description\": \"Corrections or amendments made during the item's traversal. Nothing populates this yet.\",\n+      \"description\": \"Every operator row on the item other than approve and merge -- amend, launch, transport -- read from attavo/ledger.py::item_ledger's own rows between the item's first spec commit and its merge (issue #349): the row's class, its sha, the commit's own author name, and its committer time.\",\n       \"items\": {\n         \"type\": \"object\",\n         \"additionalProperties\": false,\n-        \"required\": [\"at\", \"class\", \"by\"],\n+        \"required\": [\"at\", \"class\", \"by\", \"sha\"],\n         \"properties\": {\n           \"at\": {\"type\": \"string\", \"minLength\": 1},\n           \"class\": {\"type\": \"string\", \"minLength\": 1},\n-          \"by\": {\"type\": \"string\", \"minLength\": 1}\n+          \"by\": {\"type\": \"string\", \"minLength\": 1},\n+          \"sha\": {\"type\": \"string\", \"minLength\": 1}\n         }\n       }\n     },\n     \"acts\": {\n       \"type\": \"array\",\n-      \"description\": \"Operator acts on the item: approve, rule, merge. Nothing populates this yet.\",\n+      \"description\": \"The operator's ruled acts on the item: each approve row and the merge row, read the same way (issue #349). rule stays in this enum for the ruling record (#276) and is never produced here.\",\n       \"items\": {\n         \"type\": \"object\",\n         \"additionalProperties\": false,\n-        \"required\": [\"at\", \"act\", \"by\"],\n+        \"required\": [\"at\", \"act\", \"by\", \"sha\"],\n         \"properties\": {\n           \"at\": {\"type\": \"string\", \"minLength\": 1},\n           \"act\": {\"type\": \"string\", \"enum\": [\"approve\", \"rule\", \"merge\"]},\n-          \"by\": {\"type\": \"string\", \"minLength\": 1}\n+          \"by\": {\"type\": \"string\", \"minLength\": 1},\n+          \"sha\": {\"type\": \"string\", \"minLength\": 1}\n         }\n       }\n     },\ndiff --git a/tests/test_attest.py b/tests/test_attest.py\nindex 9886395..c887892 100644\n--- a/tests/test_attest.py\n+++ b/tests/test_attest.py\n@@ -92,6 +92,12 @@ def test_attest_prints_a_valid_statement_on_a_coherent_chain_and_writes_nothing(\n     assert statement[\"sha\"] == statement[\"merge_sha\"]\n     assert statement[\"tokens\"].keys() >= {\"build\", \"verify\", \"counsel\", \"input\", \"output\"}\n \n+    # issue #349: acts is read from the item's own commits, never the\n+    # hard-coded [] the schema used to carry regardless -- the approval and\n+    # the merge are always among them.\n+    assert {\"approve\", \"merge\"} <= {a[\"act\"] for a in statement[\"acts\"]}\n+    assert all(a[\"sha\"] for a in statement[\"acts\"])\n+\n     assert records_snapshot(root) == before\n     assert git(root, \"status\", \"--porcelain\") == \"\"\n \ndiff --git a/tests/test_attest_time.py b/tests/test_attest_time.py\nindex a0adf45..97dfc46 100644\n--- a/tests/test_attest_time.py\n+++ b/tests/test_attest_time.py\n@@ -321,10 +321,10 @@ def test_statement_carries_only_the_summed_accounting(tmp_path: Path) -> None:\n     assert statement[\"tokens\"][\"partial\"] is False and statement[\"tokens\"][\"not_read\"] == []\n \n \n-def test_schema_is_v5_and_names_no_retired_field() -> None:\n+def test_schema_is_v6_and_names_no_retired_field() -> None:\n     \"\"\"#309: the predicate type moved to v4 with the three fields gone; #307\n-    moves it to v5, and they stay gone.\"\"\"\n-    assert SCHEMA[\"$id\"] == \"https://attavo.dev/attestation/v5\"\n+    moved it to v5, and #349 to v6; they stay gone.\"\"\"\n+    assert SCHEMA[\"$id\"] == \"https://attavo.dev/attestation/v6\"\n     for field in RETIRED:\n         assert field not in SCHEMA[\"properties\"] and field not in SCHEMA[\"required\"]\n     assert \"tokens\" in SCHEMA[\"required\"]","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01HV25PHPZxFDr9etkYoUyjm","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}

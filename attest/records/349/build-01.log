(m.get(\"forge\") or {}).get(\"sealed_since\")\n983\t    if not (isinstance(since, str) and since.strip()):\n984\t        try:\n985\t            since = proof_window_start(root, m)[1]\n986\t        except WindowRefused as exc:\n987\t            return p.fail(str(exc))\n988\t    merges, refusal = _merges_reachable(root)\n989\t    if refusal:\n990\t        return p.fail(refusal)\n991\t    sealed: list[str] = []\n992\t    before_window: list[str] = []\n993\t    unsealed: list[str] = []\n994\t    not_merged: list[str] = []\n995\t    not_read: list[str] = []\n996\t    reasons: list[str] = []\n997\t    for item in complete:"}]},"parent_tool_use_id":null,"session_id":"6f72eeed-ce9e-4916-937c-8eb7f16a3662","uuid":"2ce94f79-5ee5-4e4e-a94d-f4855de75d29","timestamp":"2026-10-07T20:48:08.819Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-349/attavo/doctor.py","content":"        if not (isinstance(stated_acts, list) and _same(stated_acts, summed_acts)):\n            differing.append(f\"acts {stated_acts!r} is not its records' {summed_acts!r}\")\n        if not (isinstance(stated_interventions, list) and _same(stated_interventions, summed_interventions)):\n            differing.append(f\"interventions {stated_interventions!r} is not its \"\n                             f\"records' {summed_interventions!r}\")\n    if differing:\n        return f\"{where}: the statement's \" + \"; \".join(differing)\n    return None\n\n\ndef proof_every_attested_item_is_sealed(root: Path, m: dict[str, Any] | None) -> Proof:\n    p = Proof(\"every-attested-item-is-sealed\", \"every attested item has its statement in the store\")\n    if m is None:\n        return p.fail(f\"no {MANIFEST} at {root}; no records directory is declared\")\n    cmd = attestation_command(m)\n    if cmd is None:\n        return p.fail(\"no [forge].attestation_command in the manifest; the store cannot be read\")\n    records_rel = m.get(\"paths\", {}).get(\"records\", \"\")\n    records_dir = root / records_rel\n    if not records_dir.is_dir():\n        return p.fail(f\"no records directory under {records_dir}\")\n    items = load_records(records_dir)\n    complete = [item for item, stages in sorted(items.items()) if all(s in stages for s in STAGES)]\n\n    # [forge].sealed_since: merges at or before this commit are before the\n    # window -- the tenant could not seal them (no queue, no signing\n    # workflow, or a store that held nothing yet). They are named, never\n    # failed. Absent, the window starts where proof three's does: the\n    # install commit, or [doctor].from (issue #192).\n    since = (m.get(\"forge\") or {}).get(\"sealed_since\")\n    if not (isinstance(since, str) and since.strip()):\n        try:\n            since = proof_window_start(root, m)[1]\n        except WindowRefused as exc:\n            return p.fail(str(exc))\n    merges, refusal = _merges_reachable(root)\n    if refusal:\n        return p.fail(refusal)\n    sealed: list[str] = []\n    before_window: list[str] = []\n    unsealed: list[str] = []\n    not_merged: list[str] = []\n    not_read: list[str] = []\n    reasons: list[str] = []\n    for item in complete:","numLines":45,"startLine":953,"totalLines":1207}},"tool_result_meta":[{"id":"toolu_01CzysypsKiEKKF9qpHUcz9q","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01F4viV2bhDaBedAipgjj9dy","type":"tool_result","content":"1\t\"\"\"The statement's estimated cost (issue #307): a record whose adapter\n2\treported no price is priced at attest time as tokens times the tenant's\n3\tpublished rate, never written into a record, and doctor's sixth proof\n4\tholding the statement to the same function.\n5\t\n6\tSpecimen: #277's verify-01, gpt-5.6-sol, 184,076 input and 1,884 output\n7\ttokens, `cost_usd` null -- read as permanently \"not read\" until now.\n8\t\n9\tRegression, run red first on origin/main at ffd1208: every test below\n10\tfailed there (no `[cost.rates]` in the manifest schema, no basis, no\n11\testimate, predicate v4), except the one that asserts no record is written,\n12\twhich holds on both sides and guards the ruling.\n13\t\n14\tRun: python3 -m pytest tests -q\n15\t\"\"\"\n16\tfrom __future__ import annotations\n17\t\n18\timport json\n19\tfrom pathlib import Path\n20\tfrom typing import Any\n21\t\n22\timport jsonschema\n23\timport pytest\n24\t\n25\tfrom attavo.doctor import _accounting_disagrees\n26\tfrom helpers import git\n27\tfrom test_attest_time import (INVOCATIONS, V5_COST_FIELDS, attest, make_item, proof_six, seal)\n28\t\n29\tROOT = Path(__file__).resolve().parent.parent\n30\tMANIFEST_SCHEMA = json.loads((ROOT / \"schema\" / \"manifest.schema.json\").read_text())\n31\tATTESTATION_SCHEMA = json.loads((ROOT / \"schema\" / \"attestation.schema.json\").read_text())\n32\t\n33\tCODEX = \"gpt-5.6-sol\"\n34\tCLAUDE = \"claude-opus-5-5\"\n35\tRATE_TABLE = f\"\"\"\n36\t[cost.rates.\"{CODEX}\"]\n37\tinput_usd_per_mtok = 1.25\n38\toutput_usd_per_mtok = 10.0\n39\tas_of = \"2026-10-05\"\n40\tsource = \"https://example.invalid/pricing\"\n41\t\n42\t[cost.rates.\"{CLAUDE}\"]\n43\tinput_usd_per_mtok = 15.0\n44\toutput_usd_per_mtok = 75.0\n45\tas_of = \"2026-10-05\"\n46\tsource = \"https://example.invalid/pricing\"\n47\t\"\"\"\n48\tCODEX_RATE = {\"input_usd_per_mtok\": 1.25, \"output_usd_per_mtok\": 10.0,\n49\t              \"as_of\": \"2026-10-05\", \"source\": \"https://example.invalid/pricing\"}\n50\t# 184076 * 1.25 / 1e6 + 1884 * 10 / 1e6\n51\tVERIFY_ESTIMATE = 0.248935\n52\tSPECIMEN_TOKENS = {\"verify-01\": {\"input\": 184076, \"output\": 1884}}\n53\t\n54\t# A Claude Code build that reported its cost; a Codex verify that did not.\n55\tSPECIMEN: list[tuple[str, int, float | None, float | None, str]] = [\n56\t    (\"build\", 1, 100.0, 0.5, \"claude-code\"),\n57\t    (\"verify\", 1, 50.0, None, \"codex\"),\n58\t]\n59\tMODELS = {\"build-01\": CLAUDE, \"verify-01\": CODEX}\n60\t\n61\t\n62\tdef specimen(tmp_path: Path, manifest_extra: str,\n63\t             invocations: list[tuple[str, int, float | None, float | None, str]] = SPECIMEN,\n64\t             models: dict[str, str] = MODELS) -> tuple[Path, str]:\n65\t    return make_item(tmp_path, invocations, manifest_extra=manifest_extra, models=models,\n66\t                     tokens=SPECIMEN_TOKENS)\n67\t\n68\t\n69\tdef test_a_codex_record_is_priced_from_the_tenants_rate_and_the_totals_add_up(\n70\t        tmp_path: Path) -> None:\n71\t    \"\"\"#277's verify-01 (gpt-5.6-sol, 184,076 input, 1,884 output, cost_usd\n72\t    null) reads as tokens times the manifest's rate, basis `estimated`; the\n73\t    Claude Code build keeps what it reported; usd is the two together.\"\"\"\n74\t    root, _ = specimen(tmp_path, RATE_TABLE)\n75\t    statement = attest(root)\n76\t    jsonschema.validate(statement, ATTESTATION_SCHEMA)\n77\t    cost = statement[\"cost\"]\n78\t    assert cost[\"basis_by_stage\"] == {\"build\": \"reported\", \"verify\": \"estimated\"}\n79\t    assert cost[\"by_stage_usd\"] == {\"build\": 0.5, \"verify\": VERIFY_ESTIMATE}\n80\t    assert cost[\"by_adapter_usd\"] == {\"claude-code\": 0.5, \"codex\": VERIFY_ESTIMATE}\n81\t    assert cost[\"reported_usd\"] == 0.5 and cost[\"estimated_usd\"] == VERIFY_ESTIMATE\n82\t    assert cost[\"usd\"] == round(0.5 + VERIFY_ESTIMATE, 6)\n83\t    assert cost[\"partial\"] is False and cost[\"not_read\"] == []\n84\t    assert cost[\"rates\"] == {CODEX: CODEX_RATE}, \"only the rate a record was priced by\"\n85\t\n86\t\n87\tdef test_the_estimate_is_computed_in_the_statement_and_written_into_no_record(\n88\t        tmp_path: Path) -> None:\n89\t    \"\"\"The 2026-10-05 ruling: verify-01 keeps cost_usd null on disk.\"\"\"\n90\t    root, _ = specimen(tmp_path, RATE_TABLE)\n91\t    attest(root)\n92\t    record = json.loads((root / \"records\" / \"1\" / \"verify-01.json\").read_text())\n93\t    assert record[\"cost_usd\"] is None\n94\t\n95\t\n96\tdef test_the_statement_says_what_an_estimate_is(tmp_path: Path) -> None:\n97\t    \"\"\"Estimated amounts are tokens times the tenant's published rates, a\n98\t    meter at API prices, not a bill.\"\"\"\n99\t    root, _ = specimen(tmp_path, RATE_TABLE)\n100\t    note = attest(root)[\"cost\"][\"estimate_note\"]\n101\t    assert note == (\"Estimated amounts are tokens times the tenant's published rates: \"\n102\t                    \"a meter at API prices, not a bill.\")\n103\t\n104\t\n105\tdef test_without_a_rate_the_record_stays_not_read_and_names_the_missing_rate(\n106\t        tmp_path: Path) -> None:\n107\t    \"\"\"#277's verify-01 with no [cost.rates] table: not priced, named, partial.\"\"\"\n108\t    root, _ = specimen(tmp_path, \"\")\n109\t    cost = attest(root)[\"cost\"]\n110\t    assert cost[\"not_read\"] == [f\"verify-01 (no [cost.rates] for {CODEX})\"]\n111\t    assert cost[\"partial\"] is True\n112\t    assert cost[\"usd\"] == 0.5 and cost[\"reported_usd\"] == 0.5 and cost[\"estimated_usd\"] == 0.0\n113\t    assert cost[\"basis_by_stage\"] == {\"build\": \"reported\"}\n114\t    assert cost[\"rates\"] == {}\n115\t\n116\t\n117\tdef test_a_claude_code_record_stays_reported_and_a_stage_with_both_reads_mixed(\n118\t        tmp_path: Path) -> None:\n119\t    \"\"\"A stage whose attempts include #277's verify-01 (priced) and a verify\n120\t    that reported its own cost reads `mixed`; a reported cost is never\n121\t    re-priced, though its model has a rate.\"\"\"\n122\t    invocations = SPECIMEN + [(\"verify\", 2, 20.0, 0.1, \"claude-code\")]\n123\t    root, _ = specimen(tmp_path, RATE_TABLE, invocations, {**MODELS, \"verify-02\": CLAUDE})\n124\t    cost = attest(root)[\"cost\"]\n125\t    assert cost[\"basis_by_stage\"] == {\"build\": \"reported\", \"verify\": \"mixed\"}\n126\t    assert cost[\"by_stage_usd\"][\"verify\"] == round(VERIFY_ESTIMATE + 0.1, 6)\n127\t    assert cost[\"reported_usd\"] == 0.6 and cost[\"estimated_usd\"] == VERIFY_ESTIMATE\n128\t    assert CLAUDE not in cost[\"rates\"]\n129\t\n130\t\n131\tdef test_doctor_proof_six_holds_a_v5_estimate_and_fails_one_that_differs(tmp_path: Path) -> None:\n132\t    \"\"\"#277's verify-01 priced in a v5 statement holds; an estimate, a sum,\n133\t    a basis or a carried rate that is not what the records and rates give\n134\t    fails, naming the item and the cost field.\"\"\"\n135\t    root, merge = specimen(tmp_path, RATE_TABLE)\n136\t    statement = attest(root)\n137\t    seal(root, merge, statement, \"https://attavo.dev/attestation/v5\")\n138\t    held = proof_six(root)\n139\t    assert held[\"holds\"] is True and held[\"sealed\"] == [\"1\"], held\n140\t\n141\t    edits: list[tuple[tuple[str, ...], Any]] = [\n142\t        ((\"estimated_usd\",), 0.25), ((\"usd\",), 0.75), ((\"by_stage_usd\", \"verify\"), 0.3),\n143\t        ((\"basis_by_stage\", \"verify\"), \"reported\"), ((\"rates\", CODEX, \"input_usd_per_mtok\"), 2.0),\n144\t        ((\"estimate_note\",), \"A bill.\")]\n145\t    for path, value in edits:\n146\t        forged: dict[str, Any] = json.loads(json.dumps(statement))\n147\t        node = forged[\"cost\"]\n148\t        for key in path[:-1]:\n149\t            node = node[key]\n150\t        node[path[-1]] = value\n151\t        seal(root, merge, forged, \"https://attavo.dev/attestation/v5\")\n152\t        failed = proof_six(root)\n153\t        assert failed[\"holds\"] is False, (path, failed)\n154\t        assert \"item 1\" in failed[\"reason\"] and \"cost\" in failed[\"reason\"], failed\n155\t\n156\t\n157\tdef test_doctor_proof_six_still_holds_v4_and_v3_statements_by_their_own_rules(\n158\t        tmp_path: Path) -> None:\n159\t    \"\"\"A statement sealed before #307 priced nothing: #277's verify-01 stays\n160\t    unread in it, though the manifest has a rate now, and it holds. v4 by\n161\t    its predicateType and, with none declared, by carrying no v5 field.\"\"\"\n162\t    root, merge = specimen(tmp_path, RATE_TABLE)\n163\t    statement = attest(root)\n164\t    v4: dict[str, Any] = json.loads(json.dumps(statement))\n165\t    for field in V5_COST_FIELDS:\n166\t        v4[\"cost\"].pop(field)\n167\t    v4[\"cost\"][\"usd\"] = 0.5\n168\t    v4[\"cost\"][\"by_stage_usd\"] = {\"build\": 0.5}\n169\t    v4[\"cost\"][\"by_adapter_usd\"] = {\"claude-code\": 0.5}\n170\t    v4[\"cost\"][\"partial\"] = True\n171\t    v4[\"cost\"][\"not_read\"] = [\"verify-01\"]\n172\t    for declared in (\"https://attavo.dev/attestation/v4\", None):\n173\t        seal(root, merge, v4, declared)\n174\t        held = proof_six(root)\n175\t        assert held[\"holds\"] is True and held[\"sealed\"] == [\"1\"], (declared, held)\n176\t    v4[\"cost\"][\"usd\"] = 0.75\n177\t    seal(root, merge, v4, \"https://attavo.dev/attestation/v4\")\n178\t    assert proof_six(root)[\"holds\"] is False, \"v4's cost is still checked\"\n179\t\n180\t    v3: dict[str, Any] = json.loads(json.dumps(statement))\n181\t    for field in V5_COST_FIELDS:\n182\t        v3[\"cost\"].pop(field)\n183\t    v3[\"cost\"].update({\"usd\": 0.5, \"by_stage_usd\": {\"build\": 0.5},\n184\t                       \"by_adapter_usd\": {\"claude-code\": 0.5},\n185\t                       \"partial\": True, \"not_read\": [\"verify-01\"]})\n186\t    v3.pop(\"tokens\")\n187\t    v3[\"cost_by_stage_usd\"] = {\"build\": 0.5, \"verify\": None}\n188\t    seal(root, merge, v3, \"https://attavo.dev/attestation/v3\")\n189\t    held = proof_six(root)\n190\t    assert held[\"holds\"] is True and held[\"sealed\"] == [\"1\"], held\n191\t\n192\t\n193\tdef test_the_manifest_schema_accepts_the_rate_table_and_refuses_a_rate_with_no_as_of() -> None:\n194\t    \"\"\"The product carries no rate of its own: the tenant's table, each\n195\t    rate dated and sourced.\"\"\"\n196\t    cost = MANIFEST_SCHEMA[\"properties\"][\"cost\"]\n197\t    jsonschema.validate({\"rates\": {CODEX: CODEX_RATE}}, cost)\n198\t    undated = {k: v for k, v in CODEX_RATE.items() if k != \"as_of\"}\n199\t    with pytest.raises(jsonschema.ValidationError):\n200\t        jsonschema.validate({\"rates\": {CODEX: undated}}, cost)\n201\t    unsourced = {k: v for k, v in CODEX_RATE.items() if k != \"source\"}\n202\t    with pytest.raises(jsonschema.ValidationError):\n203\t        jsonschema.validate({\"rates\": {CODEX: unsourced}}, cost)\n204\t    with pytest.raises(jsonschema.ValidationError):\n205\t        jsonschema.validate({\"rates\": {CODEX: {**CODEX_RATE, \"input_usd_per_mtok\": -1}}}, cost)\n206\t\n207\t\n208\tdef test_an_item_with_no_priced_record_keeps_the_v4_totals(tmp_path: Path) -> None:\n209\t    \"\"\"INVOCATIONS carry no model: nothing is priced, nothing is renamed in not_read.\"\"\"\n210\t    root, _ = make_item(tmp_path, INVOCATIONS, manifest_extra=RATE_TABLE)\n211\t    cost = attest(root)[\"cost\"]\n212\t    assert cost[\"usd\"] == 0.875 and cost[\"estimated_usd\"] == 0.0\n213\t    assert cost[\"not_read\"] == [\"verify-01\", \"verify-02\", \"counsel-01\"]\n214\t\n215\t\n216\tdef test_a_v5_statement_whose_carried_rate_differs_from_the_manifest_at_its_sealed_commit_fails(\n217\t        tmp_path: Path) -> None:\n218\t    \"\"\"#277's verify-01 priced at a rate the manifest never declared at the\n219\t    sealed commit: the statement's own arithmetic is consistent, but the\n220\t    rate it quotes is not the tenant's, so proof six fails, naming cost.rates.\"\"\"\n221\t    root, merge = specimen(tmp_path, RATE_TABLE)\n222\t    statement = attest(root)\n223\t    quoted = {**CODEX_RATE, \"input_usd_per_mtok\": 0.01, \"output_usd_per_mtok\": 0.01}\n224\t    statement[\"cost\"][\"rates\"] = {CODEX: quoted}\n225\t    statement[\"cost\"][\"estimated_usd\"] = 0.003604\n226\t    statement[\"cost\"][\"by_stage_usd\"][\"verify\"] = 0.003604\n227\t    statement[\"cost\"][\"by_adapter_usd\"][\"codex\"] = 0.003604\n228\t    statement[\"cost\"][\"usd\"] = 0.503604\n229\t    seal(root, merge, statement, \"https://attavo.dev/attestation/v5\")\n230\t    failed = proof_six(root)\n231\t    assert failed[\"holds\"] is False, failed\n232\t    assert \"item 1\" in failed[\"reason\"] and \"cost.rates\" in failed[\"reason\"], failed\n233\t\n234\t\n235\tdef test_a_v5_statement_still_holds_after_the_manifests_rate_changes_in_a_later_commit(\n236\t        tmp_path: Path) -> None:\n237\t    \"\"\"The sealed commit does not move: a rate edited afterwards unseals nothing.\"\"\"\n238\t    root, merge = specimen(tmp_path, RATE_TABLE)\n239\t    seal(root, merge, attest(root), \"https://attavo.dev/attestation/v5\")\n240\t    manifest = root / \"attavo.toml\"\n241\t    manifest.write_text(manifest.read_text().replace(\"input_usd_per_mtok = 1.25\",\n242\t                                                     \"input_usd_per_mtok = 9.99\"))\n243\t    git(root, \"commit\", \"-q\", \"-am\", \"reprice\")\n244\t    held = proof_six(root)\n245\t    assert held[\"holds\"] is True and held[\"sealed\"] == [\"1\"], held\n246\t\n247\t\n248\tdef test_a_v5_statement_fails_when_the_manifest_cannot_be_read_at_its_sealed_commit(\n249\t        tmp_path: Path) -> None:\n250\t    \"\"\"No fallback to the carried rates: a sealed commit that holds no\n251\t    manifest fails the proof and names that.\"\"\"\n252\t    root, _ = specimen(tmp_path, RATE_TABLE)\n253\t    statement = attest(root)\n254\t    empty = git(root, \"hash-object\", \"-t\", \"tree\", \"/dev/null\").strip()\n255\t    bare = git(root, \"commit-tree\", empty, \"-m\", \"no manifest\").strip()\n256\t    envelope = {\"predicateType\": \"https://attavo.dev/attestation/v5\", \"predicate\": statement}\n257\t    reason = _accounting_disagrees(root, root / \"records\" / \"1\", \"1\", bare, envelope)\n258\t    assert reason is not None and \"item 1\" in reason, reason\n259\t    assert \"attavo.toml cannot be read at the sealed commit\" in reason, reason\n260\t"}]},"parent_tool_use_id":null,"session_id":"6f72eeed-ce9e-4916-937c-8eb7f16a3662","uuid":"030e2fd8-3018-4c83-9c6b-8b079bd4d521","timestamp":"2026-10-07T20:42:03.086Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-349/tests/test_estimated_cost.py","content":"\"\"\"The statement's estimated cost (issue #307): a record whose adapter\nreported no price is priced at attest time as tokens times the tenant's\npublished rate, never written into a record, and doctor's sixth proof\nholding the statement to the same function.\n\nSpecimen: #277's verify-01, gpt-5.6-sol, 184,076 input and 1,884 output\ntokens, `cost_usd` null -- read as permanently \"not read\" until now.\n\nRegression, run red first on origin/main at ffd1208: every test below\nfailed there (no `[cost.rates]` in the manifest schema, no basis, no\nestimate, predicate v4), except the one that asserts no record is written,\nwhich holds on both sides and guards the ruling.\n\nRun: python3 -m pytest tests -q\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nfrom pathlib import Path\nfrom typing import Any\n\nimport jsonschema\nimport pytest\n\nfrom attavo.doctor import _accounting_disagrees\nfrom helpers import git\nfrom test_attest_time import (INVOCATIONS, V5_COST_FIELDS, attest, make_item, proof_six, seal)\n\nROOT = Path(__file__).resolve().parent.parent\nMANIFEST_SCHEMA = json.loads((ROOT / \"schema\" / \"manifest.schema.json\").read_text())\nATTESTATION_SCHEMA = json.loads((ROOT / \"schema\" / \"attestation.schema.json\").read_text())\n\nCODEX = \"gpt-5.6-sol\"\nCLAUDE = \"claude-opus-5-5\"\nRATE_TABLE = f\"\"\"\n[cost.rates.\"{CODEX}\"]\ninput_usd_per_mtok = 1.25\noutput_usd_per_mtok = 10.0\nas_of = \"2026-10-05\"\nsource = \"https://example.invalid/pricing\"\n\n[cost.rates.\"{CLAUDE}\"]\ninput_usd_per_mtok = 15.0\noutput_usd_per_mtok = 75.0\nas_of = \"2026-10-05\"\nsource = \"https://example.invalid/pricing\"\n\"\"\"\nCODEX_RATE = {\"input_usd_per_mtok\": 1.25, \"output_usd_per_mtok\": 10.0,\n              \"as_of\": \"2026-10-05\", \"source\": \"https://example.invalid/pricing\"}\n# 184076 * 1.25 / 1e6 + 1884 * 10 / 1e6\nVERIFY_ESTIMATE = 0.248935\nSPECIMEN_TOKENS = {\"verify-01\": {\"input\": 184076, \"output\": 1884}}\n\n# A Claude Code build that reported its cost; a Codex verify that did not.\nSPECIMEN: list[tuple[str, int, float | None, float | None, str]] = [\n    (\"build\", 1, 100.0, 0.5, \"claude-code\"),\n    (\"verify\", 1, 50.0, None, \"codex\"),\n]\nMODELS = {\"build-01\": CLAUDE, \"verify-01\": CODEX}\n\n\ndef specimen(tmp_path: Path, manifest_extra: str,\n             invocations: list[tuple[str, int, float | None, float | None, str]] = SPECIMEN,\n             models: dict[str, str] = MODELS) -> tuple[Path, str]:\n    return make_item(tmp_path, invocations, manifest_extra=manifest_extra, models=models,\n                     tokens=SPECIMEN_TOKENS)\n\n\ndef test_a_codex_record_is_priced_from_the_tenants_rate_and_the_totals_add_up(\n        tmp_path: Path) -> None:\n    \"\"\"#277's verify-01 (gpt-5.6-sol, 184,076 input, 1,884 output, cost_usd\n    null) reads as tokens times the manifest's rate, basis `estimated`; the\n    Claude Code build keeps what it reported; usd is the two together.\"\"\"\n    root, _ = specimen(tmp_path, RATE_TABLE)\n    statement = attest(root)\n    jsonschema.validate(statement, ATTESTATION_SCHEMA)\n    cost = statement[\"cost\"]\n    assert cost[\"basis_by_stage\"] == {\"build\": \"reported\", \"verify\": \"estimated\"}\n    assert cost[\"by_stage_usd\"] == {\"build\": 0.5, \"verify\": VERIFY_ESTIMATE}\n    assert cost[\"by_adapter_usd\"] == {\"claude-code\": 0.5, \"codex\": VERIFY_ESTIMATE}\n    assert cost[\"reported_usd\"] == 0.5 and cost[\"estimated_usd\"] == VERIFY_ESTIMATE\n    assert cost[\"usd\"] == round(0.5 + VERIFY_ESTIMATE, 6)\n    assert cost[\"partial\"] is False and cost[\"not_read\"] == []\n    assert cost[\"rates\"] == {CODEX: CODEX_RATE}, \"only the rate a record was priced by\"\n\n\ndef test_the_estimate_is_computed_in_the_statement_and_written_into_no_record(\n        tmp_path: Path) -> None:\n    \"\"\"The 2026-10-05 ruling: verify-01 keeps cost_usd null on disk.\"\"\"\n    root, _ = specimen(tmp_path, RATE_TABLE)\n    attest(root)\n    record = json.loads((root / \"records\" / \"1\" / \"verify-01.json\").read_text())\n    assert record[\"cost_usd\"] is None\n\n\ndef test_the_statement_says_what_an_estimate_is(tmp_path: Path) -> None:\n    \"\"\"Estimated amounts are tokens times the tenant's published rates, a\n    meter at API prices, not a bill.\"\"\"\n    root, _ = specimen(tmp_path, RATE_TABLE)\n    note = attest(root)[\"cost\"][\"estimate_note\"]\n    assert note == (\"Estimated amounts are tokens times the tenant's published rates: \"\n                    \"a meter at API prices, not a bill.\")\n\n\ndef test_without_a_rate_the_record_stays_not_read_and_names_the_missing_rate(\n        tmp_path: Path) -> None:\n    \"\"\"#277's verify-01 with no [cost.rates] table: not priced, named, partial.\"\"\"\n    root, _ = specimen(tmp_path, \"\")\n    cost = attest(root)[\"cost\"]\n    assert cost[\"not_read\"] == [f\"verify-01 (no [cost.rates] for {CODEX})\"]\n    assert cost[\"partial\"] is True\n    assert cost[\"usd\"] == 0.5 and cost[\"reported_usd\"] == 0.5 and cost[\"estimated_usd\"] == 0.0\n    assert cost[\"basis_by_stage\"] == {\"build\": \"reported\"}\n    assert cost[\"rates\"] == {}\n\n\ndef test_a_claude_code_record_stays_reported_and_a_stage_with_both_reads_mixed(\n        tmp_path: Path) -> None:\n    \"\"\"A stage whose attempts include #277's verify-01 (priced) and a verify\n    that reported its own cost reads `mixed`; a reported cost is never\n    re-priced, though its model has a rate.\"\"\"\n    invocations = SPECIMEN + [(\"verify\", 2, 20.0, 0.1, \"claude-code\")]\n    root, _ = specimen(tmp_path, RATE_TABLE, invocations, {**MODELS, \"verify-02\": CLAUDE})\n    cost = attest(root)[\"cost\"]\n    assert cost[\"basis_by_stage\"] == {\"build\": \"reported\", \"verify\": \"mixed\"}\n    assert cost[\"by_stage_usd\"][\"verify\"] == round(VERIFY_ESTIMATE + 0.1, 6)\n    assert cost[\"reported_usd\"] == 0.6 and cost[\"estimated_usd\"] == VERIFY_ESTIMATE\n    assert CLAUDE not in cost[\"rates\"]\n\n\ndef test_doctor_proof_six_holds_a_v5_estimate_and_fails_one_that_differs(tmp_path: Path) -> None:\n    \"\"\"#277's verify-01 priced in a v5 statement holds; an estimate, a sum,\n    a basis or a carried rate that is not what the records and rates give\n    fails, naming the item and the cost field.\"\"\"\n    root, merge = specimen(tmp_path, RATE_TABLE)\n    statement = attest(root)\n    seal(root, merge, statement, \"https://attavo.dev/attestation/v5\")\n    held = proof_six(root)\n    assert held[\"holds\"] is True and held[\"sealed\"] == [\"1\"], held\n\n    edits: list[tuple[tuple[str, ...], Any]] = [\n        ((\"estimated_usd\",), 0.25), ((\"usd\",), 0.75), ((\"by_stage_usd\", \"verify\"), 0.3),\n        ((\"basis_by_stage\", \"verify\"), \"reported\"), ((\"rates\", CODEX, \"input_usd_per_mtok\"), 2.0),\n        ((\"estimate_note\",), \"A bill.\")]\n    for path, value in edits:\n        forged: dict[str, Any] = json.loads(json.dumps(statement))\n        node = forged[\"cost\"]\n        for key in path[:-1]:\n            node = node[key]\n        node[path[-1]] = value\n        seal(root, merge, forged, \"https://attavo.dev/attestation/v5\")\n        failed = proof_six(root)\n        assert failed[\"holds\"] is False, (path, failed)\n        assert \"item 1\" in failed[\"reason\"] and \"cost\" in failed[\"reason\"], failed\n\n\ndef test_doctor_proof_six_still_holds_v4_and_v3_statements_by_their_own_rules(\n        tmp_path: Path) -> None:\n    \"\"\"A statement sealed before #307 priced nothing: #277's verify-01 stays\n    unread in it, though the manifest has a rate now, and it holds. v4 by\n    its predicateType and, with none declared, by carrying no v5 field.\"\"\"\n    root, merge = specimen(tmp_path, RATE_TABLE)\n    statement = attest(root)\n    v4: dict[str, Any] = json.loads(json.dumps(statement))\n    for field in V5_COST_FIELDS:\n        v4[\"cost\"].pop(field)\n    v4[\"cost\"][\"usd\"] = 0.5\n    v4[\"cost\"][\"by_stage_usd\"] = {\"build\": 0.5}\n    v4[\"cost\"][\"by_adapter_usd\"] = {\"claude-code\": 0.5}\n    v4[\"cost\"][\"partial\"] = True\n    v4[\"cost\"][\"not_read\"] = [\"verify-01\"]\n    for declared in (\"https://attavo.dev/attestation/v4\", None):\n        seal(root, merge, v4, declared)\n        held = proof_six(root)\n        assert held[\"holds\"] is True and held[\"sealed\"] == [\"1\"], (declared, held)\n    v4[\"cost\"][\"usd\"] = 0.75\n    seal(root, merge, v4, \"https://attavo.dev/attestation/v4\")\n    assert proof_six(root)[\"holds\"] is False, \"v4's cost is still checked\"\n\n    v3: dict[str, Any] = json.loads(json.dumps(statement))\n    for field in V5_COST_FIELDS:\n        v3[\"cost\"].pop(field)\n    v3[\"cost\"].update({\"usd\": 0.5, \"by_stage_usd\": {\"build\": 0.5},\n                       \"by_adapter_usd\": {\"claude-code\": 0.5},\n                       \"partial\": True, \"not_read\": [\"verify-01\"]})\n    v3.pop(\"tokens\")\n    v3[\"cost_by_stage_usd\"] = {\"build\": 0.5, \"verify\": None}\n    seal(root, merge, v3, \"https://attavo.dev/attestation/v3\")\n    held = proof_six(root)\n    assert held[\"holds\"] is True and held[\"sealed\"] == [\"1\"], held\n\n\ndef test_the_manifest_schema_accepts_the_rate_table_and_refuses_a_rate_with_no_as_of() -> None:\n    \"\"\"The product carries no rate of its own: the tenant's table, each\n    rate dated and sourced.\"\"\"\n    cost = MANIFEST_SCHEMA[\"properties\"][\"cost\"]\n    jsonschema.validate({\"rates\": {CODEX: CODEX_RATE}}, cost)\n    undated = {k: v for k, v in CODEX_RATE.items() if k != \"as_of\"}\n    with pytest.raises(jsonschema.ValidationError):\n        jsonschema.validate({\"rates\": {CODEX: undated}}, cost)\n    unsourced = {k: v for k, v in CODEX_RATE.items() if k != \"source\"}\n    with pytest.raises(jsonschema.ValidationError):\n        jsonschema.validate({\"rates\": {CODEX: unsourced}}, cost)\n    with pytest.raises(jsonschema.ValidationError):\n        jsonschema.validate({\"rates\": {CODEX: {**CODEX_RATE, \"input_usd_per_mtok\": -1}}}, cost)\n\n\ndef test_an_item_with_no_priced_record_keeps_the_v4_totals(tmp_path: Path) -> None:\n    \"\"\"INVOCATIONS carry no model: nothing is priced, nothing is renamed in not_read.\"\"\"\n    root, _ = make_item(tmp_path, INVOCATIONS, manifest_extra=RATE_TABLE)\n    cost = attest(root)[\"cost\"]\n    assert cost[\"usd\"] == 0.875 and cost[\"estimated_usd\"] == 0.0\n    assert cost[\"not_read\"] == [\"verify-01\", \"verify-02\", \"counsel-01\"]\n\n\ndef test_a_v5_statement_whose_carried_rate_differs_from_the_manifest_at_its_sealed_commit_fails(\n        tmp_path: Path) -> None:\n    \"\"\"#277's verify-01 priced at a rate the manifest never declared at the\n    sealed commit: the statement's own arithmetic is consistent, but the\n    rate it quotes is not the tenant's, so proof six fails, naming cost.rates.\"\"\"\n    root, merge = specimen(tmp_path, RATE_TABLE)\n    statement = attest(root)\n    quoted = {**CODEX_RATE, \"input_usd_per_mtok\": 0.01, \"output_usd_per_mtok\": 0.01}\n    statement[\"cost\"][\"rates\"] = {CODEX: quoted}\n    statement[\"cost\"][\"estimated_usd\"] = 0.003604\n    statement[\"cost\"][\"by_stage_usd\"][\"verify\"] = 0.003604\n    statement[\"cost\"][\"by_adapter_usd\"][\"codex\"] = 0.003604\n    statement[\"cost\"][\"usd\"] = 0.503604\n    seal(root, merge, statement, \"https://attavo.dev/attestation/v5\")\n    failed = proof_six(root)\n    assert failed[\"holds\"] is False, failed\n    assert \"item 1\" in failed[\"reason\"] and \"cost.rates\" in failed[\"reason\"], failed\n\n\ndef test_a_v5_statement_still_holds_after_the_manifests_rate_changes_in_a_later_commit(\n        tmp_path: Path) -> None:\n    \"\"\"The sealed commit does not move: a rate edited afterwards unseals nothing.\"\"\"\n    root, merge = specimen(tmp_path, RATE_TABLE)\n    seal(root, merge, attest(root), \"https://attavo.dev/attestation/v5\")\n    manifest = root / \"attavo.toml\"\n    manifest.write_text(manifest.read_text().replace(\"input_usd_per_mtok = 1.25\",\n                                                     \"input_usd_per_mtok = 9.99\"))\n    git(root, \"commit\", \"-q\", \"-am\", \"reprice\")\n    held = proof_six(root)\n    assert held[\"holds\"] is True and held[\"sealed\"] == [\"1\"], held\n\n\ndef test_a_v5_statement_fails_when_the_manifest_cannot_be_read_at_its_sealed_commit(\n        tmp_path: Path) -> None:\n    \"\"\"No fallback to the carried rates: a sealed commit that holds no\n    manifest fails the proof and names that.\"\"\"\n    root, _ = specimen(tmp_path, RATE_TABLE)\n    statement = attest(root)\n    empty = git(root, \"hash-object\", \"-t\", \"tree\", \"/dev/null\").strip()\n    bare = git(root, \"commit-tree\", empty, \"-m\", \"no manifest\").strip()\n    envelope = {\"predicateType\": \"https://attavo.dev/attestation/v5\", \"predicate\": statement}\n    reason = _accounting_disagrees(root, root / \"records\" / \"1\", \"1\", bare, envelope)\n    assert reason is not None and \"item 1\" in reason, reason\n    assert \"attavo.toml cannot be read at the sealed commit\" in reason, reason\n","numLines":260,"startLine":1,"totalLines":260}},"tool_result_meta":[{"id":"toolu_01F4viV2bhDaBedAipgjj9dy","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}

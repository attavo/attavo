{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013fLSq64uzcuK3yUvZ11Vbn","type":"tool_result","content":"1\tfrom __future__ import annotations\n2\t\n3\timport json\n4\timport sys\n5\tfrom datetime import datetime\n6\tfrom pathlib import Path\n7\tfrom typing import Any, cast\n8\t\n9\tfrom attavo.common import MANIFEST, git, now_iso, product_version, read_manifest\n10\tfrom attavo.records import latest_attempt_path, latest_record, parse_attempts\n11\tfrom attavo.types import (ApprovalRecord, AttestRecord, BuildRecord, CostRate, ItemCost, ItemTime,\n12\t                          ItemTokens, SpecRecord, StageTime, StageTokens, VerifyRecord)\n13\tfrom attavo import Command\n14\t\n15\t# --- attest: the signed envelope over one item's whole traversal ---\n16\t\n17\tdef derive_attest_items(root: Path, records_rel: str) -> tuple[set[str], str | None]:\n18\t    \"\"\"The item ids from the merge commit's own first-parent diff -- record\n19\t    paths under records_rel/<N>/, not a branch name, which a squash merge\n20\t    discards and which names a forge's convention the product does not\n21\t    know. Returns (items, None), else (empty set, reason) only when the\n22\t    diff itself could not be read -- zero items found is not an error\n23\t    here (issue #58): not every merge is an item merge, and the caller\n24\t    decides what zero, one, or more than one means.\"\"\"\n25\t    try:\n26\t        changed = git(root, \"diff\", \"--name-only\", \"HEAD^1\", \"HEAD\").splitlines()\n27\t    except RuntimeError as exc:\n28\t        return set(), f\"git: {exc}\"\n29\t    prefix = records_rel.rstrip(\"/\") + \"/\"\n30\t    items: set[str] = set()\n31\t    for p in changed:\n32\t        if p.startswith(prefix):\n33\t            rest = p[len(prefix):]\n34\t            item = rest.split(\"/\", 1)[0]\n35\t            if item:\n36\t                items.add(item)\n37\t    return items, None\n38\t\n39\t\n40\tINVOCATION_STAGES = (\"build\", \"verify\", \"counsel\")\n41\t\n42\t\n43\tdef _is_number(value: Any) -> bool:\n44\t    return isinstance(value, (int, float)) and not isinstance(value, bool)\n45\t\n46\t\n47\tdef item_tokens(records_dir: Path) -> ItemTokens:\n48\t    \"\"\"The item's tokens, summed from the records attest already reads\n49\t    (issue #309): every build, verify, and counsel attempt's input and\n50\t    output, per stage and for the item, never the final attempt alone. A\n51\t    record whose tokens are not two numbers is named in not_read and makes\n52\t    each sum it belongs to partial -- absent is never zero.\"\"\"\n53\t    stages: dict[str, StageTokens] = {}\n54\t    not_read: list[str] = []\n55\t    for stage in INVOCATION_STAGES:\n56\t        total_in = total_out = 0\n57\t        partial = False\n58\t        for n, rec in sorted(parse_attempts(records_dir, stage).items()):\n59\t            tok = rec.get(\"tokens\")\n60\t            tok = tok if isinstance(tok, dict) else {}\n61\t            read_in, read_out = tok.get(\"input\"), tok.get(\"output\")\n62\t            if isinstance(read_in, (int, float)) and isinstance(read_out, (int, float)) \\\n63\t                    and not isinstance(read_in, bool) and not isinstance(read_out, bool):\n64\t                total_in += int(read_in)\n65\t                total_out += int(read_out)\n66\t            else:\n67\t                partial = True\n68\t                not_read.append(f\"{stage}-{n:02d}\")\n69\t        stages[stage] = {\"input\": total_in, \"output\": total_out, \"partial\": partial}\n70\t    return {\n71\t        \"build\": stages[\"build\"], \"verify\": stages[\"verify\"], \"counsel\": stages[\"counsel\"],\n72\t        \"input\": sum(st[\"input\"] for st in stages.values()),\n73\t        \"output\": sum(st[\"output\"] for st in stages.values()),\n74\t        \"partial\": bool(not_read),\n75\t        \"not_read\": not_read,\n76\t    }\n77\t\n78\t\n79\tdef item_accounting(records_dir: Path, sealed_at_epoch: int | None,\n80\t                    rates: dict[str, Any] | None = None\n81\t                    ) -> tuple[ItemTime, ItemCost, ItemTokens]:\n82\t    \"\"\"The item's `time`, `cost` and `tokens`: the statement's whole\n83\t    accounting, from one call doctor's sixth proof repeats. `rates` is the\n84\t    tenant's [cost.rates] table, by model; with none, nothing is priced.\"\"\"\n85\t    item_time, item_cost = item_time_and_cost(records_dir, sealed_at_epoch, rates)\n86\t    return item_time, item_cost, item_tokens(records_dir)\n87\t\n88\t\n89\tESTIMATE_NOTE = (\"Estimated amounts are tokens times the tenant's published rates: \"\n90\t                 \"a meter at API prices, not a bill.\")\n91\t\n92\t\n93\tdef read_cost_rate(rates: dict[str, Any] | None, model: Any) -> CostRate | None:\n94\t    \"\"\"The tenant's rate for `model`, as the statement carries it, or None\n95\t    when the table has no complete one -- a rate that cannot price both\n96\t    directions, or that names no date or source, prices nothing.\"\"\"\n97\t    entry = (rates or {}).get(model) if isinstance(model, str) else None\n98\t    if not isinstance(entry, dict):\n99\t        return None\n100\t    in_rate, out_rate = entry.get(\"input_usd_per_mtok\"), entry.get(\"output_usd_per_mtok\")\n101\t    as_of, source = entry.get(\"as_of\"), entry.get(\"source\")\n102\t    if not (_is_number(in_rate) and _is_number(out_rate) and as_of and isinstance(source, str)):\n103\t        return None\n104\t    return {\"input_usd_per_mtok\": float(cast(float, in_rate)),\n105\t            \"output_usd_per_mtok\": float(cast(float, out_rate)),\n106\t            \"as_of\": str(as_of), \"source\": source}\n107\t\n108\t\n109\tdef item_time_and_cost(records_dir: Path, sealed_at_epoch: int | None,\n110\t                       rates: dict[str, Any] | None = None) -> tuple[ItemTime, ItemCost]:\n111\t    \"\"\"The item's accounting, summed from the records attest already reads\n112\t    (issue: a view showed #158 as 20 minutes, its final build plus its final\n113\t    verify, where its nineteen invocations ran 115): every build, verify,\n114\t    and counsel attempt's wall_clock_s and cost_usd, per stage and for the\n115\t    item, never the final attempt alone. A record that carries no number\n116\t    is named in not_read and makes each sum it belongs to partial --\n117\t    absent is never zero. A record with no cost_usd but numeric tokens and\n118\t    a model in `rates` is priced here as tokens times the rate (issue #307:\n119\t    computed, never written into a record), its basis `estimated`; with no\n120\t    rate for its model it is named in not_read with the missing rate.\n121\t    lead_s runs from the first approval record's\n122\t    `at` to sealed_at_epoch (the committer time of the commit the statement\n123\t    is computed at); both it and waiting_s are None when either end cannot\n124\t    be read. doctor's sixth proof calls this same function over the same\n125\t    records, sealed at the same commit, and fails a sealed statement any\n126\t    field of whose time or cost is not what this returns.\"\"\"\n127\t    stages: dict[str, StageTime] = {}\n128\t    time_not_read: list[str] = []\n129\t    cost_not_read: list[str] = []\n130\t    by_stage: dict[str, float] = {}\n131\t    by_adapter: dict[str, float] = {}\n132\t    bases: dict[str, set[str]] = {}\n133\t    used_rates: dict[str, CostRate] = {}\n134\t    reported_usd = estimated_usd = 0.0\n135\t    for stage in INVOCATION_STAGES:\n136\t        attempts = parse_attempts(records_dir, stage)\n137\t        seconds = 0.0\n138\t        partial = False\n139\t        for n, rec in sorted(attempts.items()):\n140\t            name = f\"{stage}-{n:02d}\"\n141\t            wall = rec.get(\"wall_clock_s\")\n142\t            if _is_number(wall):\n143\t                seconds += float(wall)\n144\t            else:\n145\t                partial = True\n146\t                time_not_read.append(name)\n147\t            cost = rec.get(\"cost_usd\")\n148\t            basis = \"reported\"\n149\t            if not _is_number(cost):\n150\t                cost, basis = None, \"estimated\"\n151\t                tok = rec.get(\"tokens\")\n152\t                tok = tok if isinstance(tok, dict) else {}\n153\t                model = rec.get(\"model\")\n154\t                if _is_number(tok.get(\"input\")) and _is_number(tok.get(\"output\")) \\\n155\t                        and isinstance(model, str) and model:\n156\t                    rate = read_cost_rate(rates, model)\n157\t                    if rate is None:\n158\t                        cost_not_read.append(f\"{name} (no [cost.rates] for {model})\")\n159\t                        continue\n160\t                    cost = (tok[\"input\"] * rate[\"input_usd_per_mtok\"]\n161\t                            + tok[\"output\"] * rate[\"output_usd_per_mtok\"]) / 1_000_000\n162\t                    used_rates[model] = rate\n163\t            if cost is None:\n164\t                cost_not_read.append(name)\n165\t                continue\n166\t            by_stage[stage] = by_stage.get(stage, 0.0) + float(cost)\n167\t            bases.setdefault(stage, set()).add(basis)\n168\t            if basis == \"reported\":\n169\t                reported_usd += float(cost)\n170\t            else:\n171\t                estimated_usd += float(cost)\n172\t            adapter = rec.get(\"adapter\")\n173\t            key = adapter if isinstance(adapter, str) and adapter else \"not read\"\n174\t            by_adapter[key] = by_adapter.get(key, 0.0) + float(cost)\n175\t        stages[stage] = {\"attempts\": len(attempts), \"invocation_s\": round(seconds, 3),\n176\t                         \"partial\": partial}\n177\t\n178\t    invocation_s = round(sum(st[\"invocation_s\"] for st in stages.values()), 3)\n179\t    lead_s: float | None = None\n180\t    first_approval = parse_attempts(records_dir, \"approval\")\n181\t    if first_approval and sealed_at_epoch is not None:\n182\t        at = first_approval[min(first_approval)].get(\"at\")\n183\t        try:\n184\t            approved = datetime.fromisoformat(str(at).replace(\"Z\", \"+00:00\"))\n185\t            lead_s = round(sealed_at_epoch - approved.timestamp(), 3)\n186\t        except ValueError:\n187\t            time_not_read.append(f\"approval-{min(first_approval):02d}\")\n188\t    item_time: ItemTime = {\n189\t        \"build\": stages[\"build\"], \"verify\": stages[\"verify\"], \"counsel\": stages[\"counsel\"],\n190\t        \"invocation_s\": invocation_s,\n191\t        \"lead_s\": lead_s,\n192\t        \"waiting_s\": None if lead_s is None else round(lead_s - invocation_s, 3),\n193\t        \"partial\": any(st[\"partial\"] for st in stages.values()),\n194\t        \"not_read\": time_not_read,\n195\t    }\n196\t    item_cost: ItemCost = {\n197\t        \"usd\": round(sum(by_stage.values()), 6),\n198\t        \"reported_usd\": round(reported_usd, 6),\n199\t        \"estimated_usd\": round(estimated_usd, 6),\n200\t        \"by_stage_usd\": {k: round(v, 6) for k, v in by_stage.items()},\n201\t        \"basis_by_stage\": {k: next(iter(b)) if len(b) == 1 else \"mixed\"\n202\t                           for k, b in bases.items()},\n203\t        \"by_adapter_usd\": {k: round(v, 6) for k, v in by_adapter.items()},\n204\t        \"rates\": used_rates,\n205\t        \"estimate_note\": ESTIMATE_NOTE,\n206\t        \"partial\": bool(cost_not_read),\n207\t        \"not_read\": cost_not_read,\n208\t    }\n209\t    return item_time, item_cost\n210\t\n211\t\n212\tNOT_YET = object()\n213\t\n214\tChainRecords = tuple[SpecRecord, ApprovalRecord, BuildRecord, VerifyRecord]\n215\t\n216\t\n217\tdef check_attest_chain(records_dir: Path, item_id: str, partial: bool = False\n218\t                       ) -> tuple[ChainRecords | object | None, str | None]:\n219\t    \"\"\"The two assertions attavo attest refuses on: the latest spec,\n220\t    approval, build, and verify records for item_id all exist, and\n221\t    build's approval_sha names the latest approval -- a re-approval after\n222\t    a build must force a re-run of what changed. Returns (None, message)\n223\t    on either of them, the message being the same text attest prints, not\n224\t    a copy of it a caller re-types (issue #74: proof two reuses it);\n225\t    returns ((spec, approval, build, verify), None) when the chain holds.\n226\t\n227\t    A verify record can only name a build that existed when it was\n228\t    written (issue #109), so a latest verify whose build_sha is not the\n229\t    latest build's sha is never a corrupt chain -- it is a verify\n230\t    superseded by a later build, and is treated as absent: the next\n231\t    stage is verify, not a refusal, exactly as if no verify record\n232\t    existed yet.\n233\t\n234\t    partial (issue #67) is for a pull request, where a later stage's\n235\t    record cannot exist yet because the stage that would produce it is\n236\t    itself waiting on this check. Under partial, a missing (or\n237\t    superseded) record is not a refusal -- the chain assertion still\n238\t    runs over whatever records exist, and (NOT_YET, message) is\n239\t    returned, the message naming the item and the stages present and\n240\t    absent -- or, for a superseded verify, the superseded record and the\n241\t    build it named -- when a stage is still missing once that assertion\n242\t    holds.\"\"\"\n243\t    latest_spec = latest_record(records_dir, \"spec\")\n244\t    latest_approval = latest_record(records_dir, \"approval\")\n245\t    latest_build = latest_record(records_dir, \"build\")\n246\t    latest_verify = latest_record(records_dir, \"verify\")\n247\t\n248\t    # A verify naming a sha other than the latest build's is superseded:\n249\t    # treated as absent for the chain, never as a mismatch.\n250\t    superseded = None\n251\t    if latest_build is not None and latest_verify is not None:\n252\t        named_sha = latest_verify.get(\"build_sha\")\n253\t        if named_sha != latest_build.get(\"sha\"):\n254\t            verify_n = max(parse_attempts(records_dir, \"verify\"))\n255\t            build_attempts = parse_attempts(records_dir, \"build\")\n256\t            named_build_n = next((n for n, rec in build_attempts.items()\n257\t                                  if rec.get(\"sha\") == named_sha), None)\n258\t            named_build = f\"build-{named_build_n:02d}\" if named_build_n is not None else named_sha\n259\t            superseded = (verify_n, named_sha, named_build, max(build_attempts))\n260\t            latest_verify = None\n261\t\n262\t    stages = ((\"spec\", latest_spec), (\"approval\", latest_approval),\n263\t              (\"build\", latest_build), (\"verify\", latest_verify))\n264\t\n265\t    if not partial:\n266\t        for stage, rec in stages:\n267\t            if rec is None:\n268\t                if stage == \"verify\" and superseded is not None:\n269\t                    verify_n, named_sha, _, _ = superseded\n270\t                    return None, (f\"no verify names the latest build \"\n271\t                                 f\"(verify-{verify_n:02d} names {named_sha})\")\n272\t                return None, f\"no {stage} record for item {item_id}\"\n273\t\n274\t    if latest_approval is not None and latest_build is not None:\n275\t        if latest_build.get(\"approval_sha\") != latest_approval.get(\"sha\"):\n276\t            return None, (\"build's approval_sha does not name the latest approval; a \"\n277\t                          \"re-approval after the build must force a re-run\")\n278\t\n279\t    missing = [stage for stage, rec in stages if rec is None]\n280\t    if partial and missing:\n281\t        present = [stage for stage, rec in stages if rec is not None]\n282\t        if missing == [\"verify\"] and superseded is not None:\n283\t            verify_n, _, named_build, latest_build_n = superseded\n284\t            return NOT_YET, (f\"item {item_id} not yet (present: {', '.join(present) or 'none'}; \"\n285\t                             f\"verify-{verify_n:02d} names {named_build}, \"\n286\t                             f\"superseded by build-{latest_build_n:02d})\")\n287\t        return NOT_YET, (f\"item {item_id} not yet (present: {', '.join(present) or 'none'}; \"\n288\t                         f\"absent: {', '.join(missing)})\")\n289\t\n290\t    # Every record is present here: without partial, the loop above refused on\n291\t    # a missing one; with partial, `missing` non-empty returned NOT_YET.\n292\t    return cast(ChainRecords, (latest_spec, latest_approval, latest_build, latest_verify)), None\n293\t\n294\t\n295\tdef cmd_attest(argv: list[str]) -> int:\n296\t    partial = \"--partial\" in argv\n297\t    positional = [a for a in argv if not a.startswith(\"--\")]\n298\t    unknown = [a for a in argv if a.startswith(\"--\") and a != \"--partial\"]\n299\t    if unknown:\n300\t        print(f\"attavo attest: unknown argument {unknown[0]!r}\", file=sys.stderr)\n301\t        return 2\n302\t\n303\t    root = Path(\".\").resolve()\n304\t    m = read_manifest(root)\n305\t    if m is None:\n306\t        print(f\"attavo attest: no {MANIFEST} at {root}\", file=sys.stderr)\n307\t        return 2\n308\t\n309\t    records_rel = m[\"paths\"][\"records\"]\n310\t    item_id = positional[0] if positional else None\n311\t    if item_id is None:\n312\t        items, err = derive_attest_items(root, records_rel)\n313\t        if err:\n314\t            print(f\"attavo attest: refused: {err}\", file=sys.stderr)\n315\t            return 1\n316\t        # Not every merge is an item merge -- a merge that carries no item\n317\t        # at all is an ordinary fact, not a defect (issue #58); the\n318\t        # attest template runs this on every push and has nothing to\n319\t        # sign or commit when nothing was attested, and its existing\n320\t        # `if:` guards already read this step's own exit code.\n321\t        if not items:\n322\t            print(\"attavo attest: no item derived from the merge commit's record paths; \"\n323\t                  \"nothing to attest\")\n324\t            return 0\n325\t        if len(items) > 1:\n326\t            print(f\"attavo attest: refused: {len(items)} items derived from the merge \"\n327\t                  f\"commit's record paths: {', '.join(sorted(items))}\", file=sys.stderr)\n328\t            return 1\n329\t        item_id = next(iter(items))\n330\t\n331\t    records_dir = root / records_rel / item_id\n332\t    chain, message = check_attest_chain(records_dir, item_id, partial=partial)\n333\t    if chain is None:\n334\t        print(f\"attavo attest: refused: {message}\", file=sys.stderr)\n335\t        return 1\n336\t    if chain is NOT_YET:\n337\t        print(f\"attavo attest --partial: {message}\")\n338\t        return 0\n339\t    latest_spec, latest_approval, latest_build, latest_verify = cast(ChainRecords, chain)\n340\t\n341\t    spec_path = latest_attempt_path(records_dir, \"spec\")\n342\t    approval_path = latest_attempt_path(records_dir, \"approval\")\n343\t    build_path = latest_attempt_path(records_dir, \"build\")\n344\t    verify_path = latest_attempt_path(records_dir, \"verify\")\n345\t\n346\t    # sha and merge_sha are the same commit here -- the one this statement\n347\t    # was computed at. On the merge group that commit is the one main will\n348\t    # hold; kept as two fields because a forge-specific template signs\n349\t    # this statement against \"the commit that lands\", naming it merge_sha\n350\t    # is what makes that unambiguous to a reader who has never seen attest\n351\t    # run anywhere but the merge group.\n352\t    head_sha = git(root, \"rev-parse\", \"HEAD\").strip()\n353\t    try:\n354\t        sealed_at: int | None = int(git(root, \"show\", \"-s\", \"--format=%ct\", \"HEAD\").strip())\n355\t    except (RuntimeError, ValueError):\n356\t        sealed_at = None\n357\t    item_time, item_cost, item_tokens_ = item_accounting(\n358\t        records_dir, sealed_at, (m.get(\"cost\") or {}).get(\"rates\"))\n359\t\n360\t    statement: AttestRecord = {\n361\t        \"sha\": head_sha,\n362\t        \"merge_sha\": head_sha,\n363\t        \"item\": item_id,\n364\t        \"spec\": spec_path.stem if spec_path else None,\n365\t        \"spec_sha\": latest_spec.get(\"sha\"),\n366\t        \"approval\": approval_path.stem if approval_path else None,\n367\t        \"approval_sha\": latest_approval.get(\"sha\"),\n368\t        \"build\": build_path.stem if build_path else None,\n369\t        \"build_sha\": latest_build.get(\"sha\"),\n370\t        \"verify\": verify_path.stem if verify_path else None,\n371\t        \"verify_sha\": latest_verify.get(\"sha\"),\n372\t        \"at\": now_iso(),\n373\t        # Neither is populated by anything today -- no ruling or amendment\n374\t        # log exists yet for either to read from. Carried as empty rather\n375\t        # than omitted, since the schema names them.\n376\t        \"interventions\": [],\n377\t        \"acts\": [],\n378\t        # The only accounting: every attempt, summed (the sum across\n379\t        # executors was ruled 2026-09-19). v3's final-attempt fields are\n380\t        # retired (issue #309).\n381\t        \"time\": item_time,\n382\t        \"cost\": item_cost,\n383\t        \"tokens\": item_tokens_,\n384\t        \"product_version\": product_version(),\n385\t        \"product_pin\": (m.get(\"attavo\") or {}).get(\"version\"),\n386\t    }\n387\t    print(json.dumps(statement, indent=2))\n388\t    return 0\n389\t\n390\t\n391\tCOMMANDS = (\n392\t    Command(\n393\t        name='attest',\n394\t        run=cmd_attest,\n395\t        usage=('attavo attest [--partial] [N]',),\n396\t        rank=110,\n397\t        help=(\n398\t            (160, \"\"\"\\\n399\tattest refuses (exit 1) unless the latest spec, approval, build, and\n400\tverify records for an item all exist and chain: the build's approval_sha\n401\tnames the latest approval, and the verify's build_sha names that build --\n402\ta re-approval after a build must force a re-run of what changed. With no\n403\tN given it derives the item from the record paths HEAD's merge commit\n404\ttouched under paths.records/<N>/, not from a branch name, which a squash\n405\tmerge discards and which names a forge's convention the product does not\n406\tknow; more than one item derived is a refusal naming what it found. Zero\n407\tis not a defect -- not every merge is an item merge -- exit 0, nothing\n408\tprinted but a line saying so.\n409\t\n410\tattest never writes. On a coherent chain it prints the attestation\n411\tstatement -- validating against schema/attestation.schema.json -- to\n412\tstdout as JSON and exits 0: the item, its four records and their shas,\n413\tand the commit the statement was computed at (sha and merge_sha are the\n414\tsame commit here; on the merge group that commit is the one that lands).\n415\t`time`, `cost` and `tokens` are the statement's only accounting, each\n416\tsummed over every build, verify and counsel attempt; a record that\n417\tcarries no figure is named in not_read, never counted as zero. A record\n418\twhose adapter reported no cost is priced, in the statement and never in the\n419\trecord, as tokens times the tenant's [cost.rates] for its model; `cost`\n420\tsays which amounts are estimated and carries the rates it used.\n421\tThe four stage records already under paths.records are the evidence for\n422\tthat statement; a forge-specific template signs the printed JSON,\n423\tunmodified, as the predicate, against the commit that lands, on the merge\n424\tgroup -- and the signed bundle in the forge's attestation store is the\n425\tseal over it. attest itself never signs anything and never talks to a\n426\tsigning service. --partial (issue #67) is for a pull request, where the\n427\trecord a complete chain would need is the output of a later stage that is\n428\titself waiting on this check: a missing later record is \"not yet\" (exit\n429\t0, naming the item and the stages present and absent, no statement\n430\tprinted) rather than a refusal, while the two chain assertions -- build's\n431\tapproval_sha names the latest approval, verify's build_sha names the\n432\tlatest build -- still run over whatever records exist. merge_group and a\n433\tpush to main still demand the whole chain. See issue #69's lane for the\n434\tfull rules it enforces.\"\"\"),\n435\t        ),\n436\t    ),\n437\t)\n438\t"}]},"parent_tool_use_id":null,"session_id":"6f72eeed-ce9e-4916-937c-8eb7f16a3662","uuid":"2fd4f943-7a2a-45dc-836a-5a227a93888f","timestamp":"2026-10-07T20:38:49.038Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-349/attavo/attest.py","content":"from __future__ import annotations\n\nimport json\nimport sys\nfrom datetime import datetime\nfrom pathlib import Path\nfrom typing import Any, cast\n\nfrom attavo.common import MANIFEST, git, now_iso, product_version, read_manifest\nfrom attavo.records import latest_attempt_path, latest_record, parse_attempts\nfrom attavo.types import (ApprovalRecord, AttestRecord, BuildRecord, CostRate, ItemCost, ItemTime,\n                          ItemTokens, SpecRecord, StageTime, StageTokens, VerifyRecord)\nfrom attavo import Command\n\n# --- attest: the signed envelope over one item's whole traversal ---\n\ndef derive_attest_items(root: Path, records_rel: str) -> tuple[set[str], str | None]:\n    \"\"\"The item ids from the merge commit's own first-parent diff -- record\n    paths under records_rel/<N>/, not a branch name, which a squash merge\n    discards and which names a forge's convention the product does not\n    know. Returns (items, None), else (empty set, reason) only when the\n    diff itself could not be read -- zero items found is not an error\n    here (issue #58): not every merge is an item merge, and the caller\n    decides what zero, one, or more than one means.\"\"\"\n    try:\n        changed = git(root, \"diff\", \"--name-only\", \"HEAD^1\", \"HEAD\").splitlines()\n    except RuntimeError as exc:\n        return set(), f\"git: {exc}\"\n    prefix = records_rel.rstrip(\"/\") + \"/\"\n    items: set[str] = set()\n    for p in changed:\n        if p.startswith(prefix):\n            rest = p[len(prefix):]\n            item = rest.split(\"/\", 1)[0]\n            if item:\n                items.add(item)\n    return items, None\n\n\nINVOCATION_STAGES = (\"build\", \"verify\", \"counsel\")\n\n\ndef _is_number(value: Any) -> bool:\n    return isinstance(value, (int, float)) and not isinstance(value, bool)\n\n\ndef item_tokens(records_dir: Path) -> ItemTokens:\n    \"\"\"The item's tokens, summed from the records attest already reads\n    (issue #309): every build, verify, and counsel attempt's input and\n    output, per stage and for the item, never the final attempt alone. A\n    record whose tokens are not two numbers is named in not_read and makes\n    each sum it belongs to partial -- absent is never zero.\"\"\"\n    stages: dict[str, StageTokens] = {}\n    not_read: list[str] = []\n    for stage in INVOCATION_STAGES:\n        total_in = total_out = 0\n        partial = False\n        for n, rec in sorted(parse_attempts(records_dir, stage).items()):\n            tok = rec.get(\"tokens\")\n            tok = tok if isinstance(tok, dict) else {}\n            read_in, read_out = tok.get(\"input\"), tok.get(\"output\")\n            if isinstance(read_in, (int, float)) and isinstance(read_out, (int, float)) \\\n                    and not isinstance(read_in, bool) and not isinstance(read_out, bool):\n                total_in += int(read_in)\n                total_out += int(read_out)\n            else:\n                partial = True\n                not_read.append(f\"{stage}-{n:02d}\")\n        stages[stage] = {\"input\": total_in, \"output\": total_out, \"partial\": partial}\n    return {\n        \"build\": stages[\"build\"], \"verify\": stages[\"verify\"], \"counsel\": stages[\"counsel\"],\n        \"input\": sum(st[\"input\"] for st in stages.values()),\n        \"output\": sum(st[\"output\"] for st in stages.values()),\n        \"partial\": bool(not_read),\n        \"not_read\": not_read,\n    }\n\n\ndef item_accounting(records_dir: Path, sealed_at_epoch: int | None,\n                    rates: dict[str, Any] | None = None\n                    ) -> tuple[ItemTime, ItemCost, ItemTokens]:\n    \"\"\"The item's `time`, `cost` and `tokens`: the statement's whole\n    accounting, from one call doctor's sixth proof repeats. `rates` is the\n    tenant's [cost.rates] table, by model; with none, nothing is priced.\"\"\"\n    item_time, item_cost = item_time_and_cost(records_dir, sealed_at_epoch, rates)\n    return item_time, item_cost, item_tokens(records_dir)\n\n\nESTIMATE_NOTE = (\"Estimated amounts are tokens times the tenant's published rates: \"\n                 \"a meter at API prices, not a bill.\")\n\n\ndef read_cost_rate(rates: dict[str, Any] | None, model: Any) -> CostRate | None:\n    \"\"\"The tenant's rate for `model`, as the statement carries it, or None\n    when the table has no complete one -- a rate that cannot price both\n    directions, or that names no date or source, prices nothing.\"\"\"\n    entry = (rates or {}).get(model) if isinstance(model, str) else None\n    if not isinstance(entry, dict):\n        return None\n    in_rate, out_rate = entry.get(\"input_usd_per_mtok\"), entry.get(\"output_usd_per_mtok\")\n    as_of, source = entry.get(\"as_of\"), entry.get(\"source\")\n    if not (_is_number(in_rate) and _is_number(out_rate) and as_of and isinstance(source, str)):\n        return None\n    return {\"input_usd_per_mtok\": float(cast(float, in_rate)),\n            \"output_usd_per_mtok\": float(cast(float, out_rate)),\n            \"as_of\": str(as_of), \"source\": source}\n\n\ndef item_time_and_cost(records_dir: Path, sealed_at_epoch: int | None,\n                       rates: dict[str, Any] | None = None) -> tuple[ItemTime, ItemCost]:\n    \"\"\"The item's accounting, summed from the records attest already reads\n    (issue: a view showed #158 as 20 minutes, its final build plus its final\n    verify, where its nineteen invocations ran 115): every build, verify,\n    and counsel attempt's wall_clock_s and cost_usd, per stage and for the\n    item, never the final attempt alone. A record that carries no number\n    is named in not_read and makes each sum it belongs to partial --\n    absent is never zero. A record with no cost_usd but numeric tokens and\n    a model in `rates` is priced here as tokens times the rate (issue #307:\n    computed, never written into a record), its basis `estimated`; with no\n    rate for its model it is named in not_read with the missing rate.\n    lead_s runs from the first approval record's\n    `at` to sealed_at_epoch (the committer time of the commit the statement\n    is computed at); both it and waiting_s are None when either end cannot\n    be read. doctor's sixth proof calls this same function over the same\n    records, sealed at the same commit, and fails a sealed statement any\n    field of whose time or cost is not what this returns.\"\"\"\n    stages: dict[str, StageTime] = {}\n    time_not_read: list[str] = []\n    cost_not_read: list[str] = []\n    by_stage: dict[str, float] = {}\n    by_adapter: dict[str, float] = {}\n    bases: dict[str, set[str]] = {}\n    used_rates: dict[str, CostRate] = {}\n    reported_usd = estimated_usd = 0.0\n    for stage in INVOCATION_STAGES:\n        attempts = parse_attempts(records_dir, stage)\n        seconds = 0.0\n        partial = False\n        for n, rec in sorted(attempts.items()):\n            name = f\"{stage}-{n:02d}\"\n            wall = rec.get(\"wall_clock_s\")\n            if _is_number(wall):\n                seconds += float(wall)\n            else:\n                partial = True\n                time_not_read.append(name)\n            cost = rec.get(\"cost_usd\")\n            basis = \"reported\"\n            if not _is_number(cost):\n                cost, basis = None, \"estimated\"\n                tok = rec.get(\"tokens\")\n                tok = tok if isinstance(tok, dict) else {}\n                model = rec.get(\"model\")\n                if _is_number(tok.get(\"input\")) and _is_number(tok.get(\"output\")) \\\n                        and isinstance(model, str) and model:\n                    rate = read_cost_rate(rates, model)\n                    if rate is None:\n                        cost_not_read.append(f\"{name} (no [cost.rates] for {model})\")\n                        continue\n                    cost = (tok[\"input\"] * rate[\"input_usd_per_mtok\"]\n                            + tok[\"output\"] * rate[\"output_usd_per_mtok\"]) / 1_000_000\n                    used_rates[model] = rate\n            if cost is None:\n                cost_not_read.append(name)\n                continue\n            by_stage[stage] = by_stage.get(stage, 0.0) + float(cost)\n            bases.setdefault(stage, set()).add(basis)\n            if basis == \"reported\":\n                reported_usd += float(cost)\n            else:\n                estimated_usd += float(cost)\n            adapter = rec.get(\"adapter\")\n            key = adapter if isinstance(adapter, str) and adapter else \"not read\"\n            by_adapter[key] = by_adapter.get(key, 0.0) + float(cost)\n        stages[stage] = {\"attempts\": len(attempts), \"invocation_s\": round(seconds, 3),\n                         \"partial\": partial}\n\n    invocation_s = round(sum(st[\"invocation_s\"] for st in stages.values()), 3)\n    lead_s: float | None = None\n    first_approval = parse_attempts(records_dir, \"approval\")\n    if first_approval and sealed_at_epoch is not None:\n        at = first_approval[min(first_approval)].get(\"at\")\n        try:\n            approved = datetime.fromisoformat(str(at).replace(\"Z\", \"+00:00\"))\n            lead_s = round(sealed_at_epoch - approved.timestamp(), 3)\n        except ValueError:\n            time_not_read.append(f\"approval-{min(first_approval):02d}\")\n    item_time: ItemTime = {\n        \"build\": stages[\"build\"], \"verify\": stages[\"verify\"], \"counsel\": stages[\"counsel\"],\n        \"invocation_s\": invocation_s,\n        \"lead_s\": lead_s,\n        \"waiting_s\": None if lead_s is None else round(lead_s - invocation_s, 3),\n        \"partial\": any(st[\"partial\"] for st in stages.values()),\n        \"not_read\": time_not_read,\n    }\n    item_cost: ItemCost = {\n        \"usd\": round(sum(by_stage.values()), 6),\n        \"reported_usd\": round(reported_usd, 6),\n        \"estimated_usd\": round(estimated_usd, 6),\n        \"by_stage_usd\": {k: round(v, 6) for k, v in by_stage.items()},\n        \"basis_by_stage\": {k: next(iter(b)) if len(b) == 1 else \"mixed\"\n                           for k, b in bases.items()},\n        \"by_adapter_usd\": {k: round(v, 6) for k, v in by_adapter.items()},\n        \"rates\": used_rates,\n        \"estimate_note\": ESTIMATE_NOTE,\n        \"partial\": bool(cost_not_read),\n        \"not_read\": cost_not_read,\n    }\n    return item_time, item_cost\n\n\nNOT_YET = object()\n\nChainRecords = tuple[SpecRecord, ApprovalRecord, BuildRecord, VerifyRecord]\n\n\ndef check_attest_chain(records_dir: Path, item_id: str, partial: bool = False\n                       ) -> tuple[ChainRecords | object | None, str | None]:\n    \"\"\"The two assertions attavo attest refuses on: the latest spec,\n    approval, build, and verify records for item_id all exist, and\n    build's approval_sha names the latest approval -- a re-approval after\n    a build must force a re-run of what changed. Returns (None, message)\n    on either of them, the message being the same text attest prints, not\n    a copy of it a caller re-types (issue #74: proof two reuses it);\n    returns ((spec, approval, build, verify), None) when the chain holds.\n\n    A verify record can only name a build that existed when it was\n    written (issue #109), so a latest verify whose build_sha is not the\n    latest build's sha is never a corrupt chain -- it is a verify\n    superseded by a later build, and is treated as absent: the next\n    stage is verify, not a refusal, exactly as if no verify record\n    existed yet.\n\n    partial (issue #67) is for a pull request, where a later stage's\n    record cannot exist yet because the stage that would produce it is\n    itself waiting on this check. Under partial, a missing (or\n    superseded) record is not a refusal -- the chain assertion still\n    runs over whatever records exist, and (NOT_YET, message) is\n    returned, the message naming the item and the stages present and\n    absent -- or, for a superseded verify, the superseded record and the\n    build it named -- when a stage is still missing once that assertion\n    holds.\"\"\"\n    latest_spec = latest_record(records_dir, \"spec\")\n    latest_approval = latest_record(records_dir, \"approval\")\n    latest_build = latest_record(records_dir, \"build\")\n    latest_verify = latest_record(records_dir, \"verify\")\n\n    # A verify naming a sha other than the latest build's is superseded:\n    # treated as absent for the chain, never as a mismatch.\n    superseded = None\n    if latest_build is not None and latest_verify is not None:\n        named_sha = latest_verify.get(\"build_sha\")\n        if named_sha != latest_build.get(\"sha\"):\n            verify_n = max(parse_attempts(records_dir, \"verify\"))\n            build_attempts = parse_attempts(records_dir, \"build\")\n            named_build_n = next((n for n, rec in build_attempts.items()\n                                  if rec.get(\"sha\") == named_sha), None)\n            named_build = f\"build-{named_build_n:02d}\" if named_build_n is not None else named_sha\n            superseded = (verify_n, named_sha, named_build, max(build_attempts))\n            latest_verify = None\n\n    stages = ((\"spec\", latest_spec), (\"approval\", latest_approval),\n              (\"build\", latest_build), (\"verify\", latest_verify))\n\n    if not partial:\n        for stage, rec in stages:\n            if rec is None:\n                if stage == \"verify\" and superseded is not None:\n                    verify_n, named_sha, _, _ = superseded\n                    return None, (f\"no verify names the latest build \"\n                                 f\"(verify-{verify_n:02d} names {named_sha})\")\n                return None, f\"no {stage} record for item {item_id}\"\n\n    if latest_approval is not None and latest_build is not None:\n        if latest_build.get(\"approval_sha\") != latest_approval.get(\"sha\"):\n            return None, (\"build's approval_sha does not name the latest approval; a \"\n                          \"re-approval after the build must force a re-run\")\n\n    missing = [stage for stage, rec in stages if rec is None]\n    if partial and missing:\n        present = [stage for stage, rec in stages if rec is not None]\n        if missing == [\"verify\"] and superseded is not None:\n            verify_n, _, named_build, latest_build_n = superseded\n            return NOT_YET, (f\"item {item_id} not yet (present: {', '.join(present) or 'none'}; \"\n                             f\"verify-{verify_n:02d} names {named_build}, \"\n                             f\"superseded by build-{latest_build_n:02d})\")\n        return NOT_YET, (f\"item {item_id} not yet (present: {', '.join(present) or 'none'}; \"\n                         f\"absent: {', '.join(missing)})\")\n\n    # Every record is present here: without partial, the loop above refused on\n    # a missing one; with partial, `missing` non-empty returned NOT_YET.\n    return cast(ChainRecords, (latest_spec, latest_approval, latest_build, latest_verify)), None\n\n\ndef cmd_attest(argv: list[str]) -> int:\n    partial = \"--partial\" in argv\n    positional = [a for a in argv if not a.startswith(\"--\")]\n    unknown = [a for a in argv if a.startswith(\"--\") and a != \"--partial\"]\n    if unknown:\n        print(f\"attavo attest: unknown argument {unknown[0]!r}\", file=sys.stderr)\n        return 2\n\n    root = Path(\".\").resolve()\n    m = read_manifest(root)\n    if m is None:\n        print(f\"attavo attest: no {MANIFEST} at {root}\", file=sys.stderr)\n        return 2\n\n    records_rel = m[\"paths\"][\"records\"]\n    item_id = positional[0] if positional else None\n    if item_id is None:\n        items, err = derive_attest_items(root, records_rel)\n        if err:\n            print(f\"attavo attest: refused: {err}\", file=sys.stderr)\n            return 1\n        # Not every merge is an item merge -- a merge that carries no item\n        # at all is an ordinary fact, not a defect (issue #58); the\n        # attest template runs this on every push and has nothing to\n        # sign or commit when nothing was attested, and its existing\n        # `if:` guards already read this step's own exit code.\n        if not items:\n            print(\"attavo attest: no item derived from the merge commit's record paths; \"\n                  \"nothing to attest\")\n            return 0\n        if len(items) > 1:\n            print(f\"attavo attest: refused: {len(items)} items derived from the merge \"\n                  f\"commit's record paths: {', '.join(sorted(items))}\", file=sys.stderr)\n            return 1\n        item_id = next(iter(items))\n\n    records_dir = root / records_rel / item_id\n    chain, message = check_attest_chain(records_dir, item_id, partial=partial)\n    if chain is None:\n        print(f\"attavo attest: refused: {message}\", file=sys.stderr)\n        return 1\n    if chain is NOT_YET:\n        print(f\"attavo attest --partial: {message}\")\n        return 0\n    latest_spec, latest_approval, latest_build, latest_verify = cast(ChainRecords, chain)\n\n    spec_path = latest_attempt_path(records_dir, \"spec\")\n    approval_path = latest_attempt_path(records_dir, \"approval\")\n    build_path = latest_attempt_path(records_dir, \"build\")\n    verify_path = latest_attempt_path(records_dir, \"verify\")\n\n    # sha and merge_sha are the same commit here -- the one this statement\n    # was computed at. On the merge group that commit is the one main will\n    # hold; kept as two fields because a forge-specific template signs\n    # this statement against \"the commit that lands\", naming it merge_sha\n    # is what makes that unambiguous to a reader who has never seen attest\n    # run anywhere but the merge group.\n    head_sha = git(root, \"rev-parse\", \"HEAD\").strip()\n    try:\n        sealed_at: int | None = int(git(root, \"show\", \"-s\", \"--format=%ct\", \"HEAD\").strip())\n    except (RuntimeError, ValueError):\n        sealed_at = None\n    item_time, item_cost, item_tokens_ = item_accounting(\n        records_dir, sealed_at, (m.get(\"cost\") or {}).get(\"rates\"))\n\n    statement: AttestRecord = {\n        \"sha\": head_sha,\n        \"merge_sha\": head_sha,\n        \"item\": item_id,\n        \"spec\": spec_path.stem if spec_path else None,\n        \"spec_sha\": latest_spec.get(\"sha\"),\n        \"approval\": approval_path.stem if approval_path else None,\n        \"approval_sha\": latest_approval.get(\"sha\"),\n        \"build\": build_path.stem if build_path else None,\n        \"build_sha\": latest_build.get(\"sha\"),\n        \"verify\": verify_path.stem if verify_path else None,\n        \"verify_sha\": latest_verify.get(\"sha\"),\n        \"at\": now_iso(),\n        # Neither is populated by anything today -- no ruling or amendment\n        # log exists yet for either to read from. Carried as empty rather\n        # than omitted, since the schema names them.\n        \"interventions\": [],\n        \"acts\": [],\n        # The only accounting: every attempt, summed (the sum across\n        # executors was ruled 2026-09-19). v3's final-attempt fields are\n        # retired (issue #309).\n        \"time\": item_time,\n        \"cost\": item_cost,\n        \"tokens\": item_tokens_,\n        \"product_version\": product_version(),\n        \"product_pin\": (m.get(\"attavo\") or {}).get(\"version\"),\n    }\n    print(json.dumps(statement, indent=2))\n    return 0\n\n\nCOMMANDS = (\n    Command(\n        name='attest',\n        run=cmd_attest,\n        usage=('attavo attest [--partial] [N]',),\n        rank=110,\n        help=(\n            (160, \"\"\"\\\nattest refuses (exit 1) unless the latest spec, approval, build, and\nverify records for an item all exist and chain: the build's approval_sha\nnames the latest approval, and the verify's build_sha names that build --\na re-approval after a build must force a re-run of what changed. With no\nN given it derives the item from the record paths HEAD's merge commit\ntouched under paths.records/<N>/, not from a branch name, which a squash\nmerge discards and which names a forge's convention the product does not\nknow; more than one item derived is a refusal naming what it found. Zero\nis not a defect -- not every merge is an item merge -- exit 0, nothing\nprinted but a line saying so.\n\nattest never writes. On a coherent chain it prints the attestation\nstatement -- validating against schema/attestation.schema.json -- to\nstdout as JSON and exits 0: the item, its four records and their shas,\nand the commit the statement was computed at (sha and merge_sha are the\nsame commit here; on the merge group that commit is the one that lands).\n`time`, `cost` and `tokens` are the statement's only accounting, each\nsummed over every build, verify and counsel attempt; a record that\ncarries no figure is named in not_read, never counted as zero. A record\nwhose adapter reported no cost is priced, in the statement and never in the\nrecord, as tokens times the tenant's [cost.rates] for its model; `cost`\nsays which amounts are estimated and carries the rates it used.\nThe four stage records already under paths.records are the evidence for\nthat statement; a forge-specific template signs the printed JSON,\nunmodified, as the predicate, against the commit that lands, on the merge\ngroup -- and the signed bundle in the forge's attestation store is the\nseal over it. attest itself never signs anything and never talks to a\nsigning service. --partial (issue #67) is for a pull request, where the\nrecord a complete chain would need is the output of a later stage that is\nitself waiting on this check: a missing later record is \"not yet\" (exit\n0, naming the item and the stages present and absent, no statement\nprinted) rather than a refusal, while the two chain assertions -- build's\napproval_sha names the latest approval, verify's build_sha names the\nlatest build -- still run over whatever records exist. merge_group and a\npush to main still demand the whole chain. See issue #69's lane for the\nfull rules it enforces.\"\"\"),\n        ),\n    ),\n)\n","numLines":438,"startLine":1,"totalLines":438}},"tool_result_meta":[{"id":"toolu_013fLSq64uzcuK3yUvZ11Vbn","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}

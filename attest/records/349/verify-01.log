ives each commit between the item's first spec commit and its merge exactly one class. The statement reads those same rows; nothing classifies twice.\n\n- `acts` lists the operator's ruled acts on the item: each `approve` row and the `merge` row, as `{act, sha, by, at}`. `rule` stays in the schema's enum for the ruling record (#276) and is not produced here.\n- `interventions` lists every other operator row (`amend`, `launch`, `transport`) as `{class, sha, by, at}`, with `by` the commit's author name and `at` its committer time.\n- `sha` becomes required in both item shapes. The predicate moves to `attestation/v6`. v3, v4 and v5 statements read as sealed, and nothing sealed is rewritten.\n- Doctor proof six recomputes both lists for a v6 statement from the commits at the sealed commit, as it does for time and cost. A statement whose lists differ fails by name.\n\nThe stub is thin: it adds `tests/test_attest_interventions.py`, the rejection test, which builds the specimen's shape on the `build_valid` fixture (a merge of main into the item's branch between approval and build) and is red on the stub. The build writes the logic.\n\nRetires: an attestation that states there were no interventions without reading for any.\n\n## Claims\n\n- attavo/attest.py\n- attavo/doctor.py\n- attavo/ledger.py\n- attavo/types.py\n- schema/attestation.schema.json\n- tests/test_attest_interventions.py\n- tests/test_attest.py\n- tests/test_attest_time.py\n- tests/test_estimated_cost.py\n- tests/test_doctor.py\n\n## Criteria\n\n- [structural] the-rejection-test-exists.sh: tests/test_attest_interventions.py carries test_a_transport_between_approval_and_merge_is_an_intervention\n- [behavioural] a-transport-mid-run-is-on-the-statement.sh: on the build_valid fixture, a merge of main into the item's branch made between approval and build is listed in the statement's interventions by its sha with class transport, and acts carry approve and merge\n    partial: bool\n\n\nclass ItemTokens(TypedDict):\n    \"\"\"Every record's tokens summed, per stage and for the item. A record\n    that carries no tokens is named in not_read and makes every sum it\n    belongs to partial -- absent is never zero.\"\"\"\n    build: StageTokens\n    verify: StageTokens\n    counsel: StageTokens\n    input: int\n    output: int\n    partial: bool\n    not_read: list[str]\n\n\nclass AttestRecord(TypedDict):\n    \"\"\"The statement `attavo attest` prints (schema/attestation.schema.json).\"\"\"\n    sha: str\n    merge_sha: str\n    item: str\n    spec: str | None\n    spec_sha: str | None\n    approval: str | None\n    approval_sha: str | None\n    build: str | None\n    build_sha: str | None\n    verify: str | None\n    verify_sha: str | None\n    at: str\n    interventions: list[dict[str, str]]\n    acts: list[dict[str, str]]\n    time: ItemTime\n    cost: ItemCost\n    tokens: ItemTokens\n    product_version: str\n    product_pin: str | None\n\n\n# What counsel reads a stop from: a build or verify record, or a refused\n# spec-gate record (issue #133).\nStageRecord = SpecRecord | BuildRecord | VerifyRecord\n\n\nclass DriveReport(TypedDict):\n    \"\"\"What `attavo drive N --report` prints (schema/drive-report.schema.json):\nfrom __future__ import annotations\n\nimport json\nimport sys\nfrom datetime import datetime\nfrom pathlib import Path\nfrom typing import Any, cast\n\nfrom attavo.common import MANIFEST, git, now_iso, product_version, read_manifest\nfrom attavo.records import latest_attempt_path, latest_record, parse_attempts\nfrom attavo.types import (ApprovalRecord, AttestRecord, BuildRecord, CostRate, ItemCost, ItemTime,\n                          ItemTokens, SpecRecord, StageTime, StageTokens, VerifyRecord)\nfrom attavo import Command\n\n# --- attest: the signed envelope over one item's whole traversal ---\n\ndef derive_attest_items(root: Path, records_rel: str) -> tuple[set[str], str | None]:\n    \"\"\"The item ids from the merge commit's own first-parent diff -- record\n    paths under records_rel/<N>/, not a branch name, which a squash merge\n    discards and which names a forge's convention the product does not\n    know. Returns (items, None), else (empty set, reason) only when the\n    diff itself could not be read -- zero items found is not an error\n    here (issue #58): not every merge is an item merge, and the caller\n    decides what zero, one, or more than one means.\"\"\"\n    try:\n        changed = git(root, \"diff\", \"--name-only\", \"HEAD^1\", \"HEAD\").splitlines()\n    except RuntimeError as exc:\n        return set(), f\"git: {exc}\"\n    prefix = records_rel.rstrip(\"/\") + \"/\"\n    items: set[str] = set()\n    for p in changed:\n        if p.startswith(prefix):\n            rest = p[len(prefix):]\n            item = rest.split(\"/\", 1)[0]\n            if item:\n                items.add(item)\n    return items, None\n\n\nINVOCATION_STAGES = (\"build\", \"verify\", \"counsel\")\n\n\ndef _is_number(value: Any) -> bool:\n    return isinstance(value, (int, float)) and not isinstance(value, bool)\n\n\ndef item_tokens(records_dir: Path) -> ItemTokens:\n    \"\"\"The item's tokens, summed from the records attest already reads\n    (issue #309): every build, verify, and counsel attempt's input and\n    output, per stage and for the item, never the final attempt alone. A\n    record whose tokens are not two numbers is named in not_read and makes\n    each sum it belongs to partial -- absent is never zero.\"\"\"\n    stages: dict[str, StageTokens] = {}\n    not_read: list[str] = []\n    for stage in INVOCATION_STAGES:\n        total_in = total_out = 0\n        partial = False\n        for n, rec in sorted(parse_attempts(records_dir, stage).items()):\n            tok = rec.get(\"tokens\")\n            tok = tok if isinstance(tok, dict) else {}\n            read_in, read_out = tok.get(\"input\"), tok.get(\"output\")\n            if isinstance(read_in, (int, float)) and isinstance(read_out, (int, float)) \\\n                    and not isinstance(read_in, bool) and not isinstance(read_out, bool):\n                total_in += int(read_in)\n                total_out += int(read_out)\n            else:\n                partial = True\n                not_read.append(f\"{stage}-{n:02d}\")\n        stages[stage] = {\"input\": total_in, \"output\": total_out, \"partial\": partial}\n    return {\n        \"build\": stages[\"build\"], \"verify\": stages[\"verify\"], \"counsel\": stages[\"counsel\"],\n        \"input\": sum(st[\"input\"] for st in stages.values()),\n        \"output\": sum(st[\"output\"] for st in stages.values()),\n        \"partial\": bool(not_read),\n        \"not_read\": not_read,\n    }\n\n\ndef item_accounting(records_dir: Path, sealed_at_epoch: int | None,\n                    rates: dict[str, Any] | None = None\n                    ) -> tuple[ItemTime, ItemCost, ItemTokens]:\n    \"\"\"The item's `time`, `cost` and `tokens`: the statement's whole\n    accounting, from one call doctor's sixth proof repeats. `rates` is the\n    tenant's [cost.rates] table, by model; with none, nothing is priced.\"\"\"\n    item_time, item_cost = item_time_and_cost(records_dir, sealed_at_epoch, rates)\n    return item_time, item_cost, item_tokens(records_dir)\n\n\nESTIMATE_NOTE = (\"Estimated amounts are tokens times the tenant's published rates: \"\n                 \"a meter at API prices, not a bill.\")\n\n\ndef read_cost_rate(rates: dict[str, Any] | None, model: Any) -> CostRate | None:\n    \"\"\"The tenant's rate for `model`, as the statement carries it, or None\n    when the table has no complete one -- a rate that cannot price both\n    directions, or that names no date or source, prices nothing.\"\"\"\n    entry = (rates or {}).get(model) if isinstance(model, str) else None\n    if not isinstance(entry, dict):\n        return None\n    in_rate, out_rate = entry.get(\"input_usd_per_mtok\"), entry.get(\"output_usd_per_mtok\")\n    as_of, source = entry.get(\"as_of\"), entry.get(\"source\")\n    if not (_is_number(in_rate) and _is_number(out_rate) and as_of and isinstance(source, str)):\n        return None\n    return {\"input_usd_per_mtok\": float(cast(float, in_rate)),\n            \"output_usd_per_mtok\": float(cast(float, out_rate)),\n            \"as_of\": str(as_of), \"source\": source}\n\n\ndef item_time_and_cost(records_dir: Path, sealed_at_epoch: int | None,\n                       rates: dict[str, Any] | None = None) -> tuple[ItemTime, ItemCost]:\n    \"\"\"The item's accounting, summed from the records attest already reads\n    (issue: a view showed #158 as 20 minutes, its final build plus its final\n    verify, where its nineteen invocations ran 115): every build, verify,\n    and counsel attempt's wall_clock_s and cost_usd, per stage and for the\n    item, never the final attempt alone. A record that carries no number\n    is named in not_read and makes each sum it belongs to partial --\n    absent is never zero. A record with no cost_usd but numeric tokens and\n    a model in `rates` is priced here as tokens times the rate (issue #307:\n    computed, never written into a record), its basis `estimated`; with no\n    rate for its model it is named in not_read with the missing rate.\nattavo/doctor.py:870:    `sha` -- v6's own shape for `acts` and `interventions` (issue #349);\nattavo/doctor.py:871:    v5 and earlier wrote both as `[]`, never a sha.\"\"\"\nattavo/doctor.py:877:    #307, #349): named by its envelope's predicateType, else known by what\nattavo/doctor.py:878:    it carries -- v3 by the final-attempt fields v4 retired, v6 by a sha\nattavo/doctor.py:879:    on an act or intervention row, v5 by the rates its cost block carries,\nattavo/doctor.py:882:    declared = statement.get(\"predicateType\")\nattavo/doctor.py:898:    `tokens`; from v6, `acts` and `interventions`) says what its records sum\nattavo/doctor.py:924:    # v5 prices a record by the [cost.rates] the tenant's manifest declared\nattavo/doctor.py:934:                    f\"so a v5 statement's estimate cannot be checked ({exc})\")\ntests/test_record_schemas.py:96:                        json.loads((ROOT / \"schema\" / \"attestation.schema.json\").read_text()))\nattavo/attest.py:416:statement -- validating against schema/attestation.schema.json -- to\nattavo/types.py:267:    \"\"\"The statement `attavo attest` prints (schema/attestation.schema.json).\"\"\"\n.github/workflows/ci.yml:35:      - uses: actions/setup-python@v5\n.github/workflows/ci.yml:93:      - uses: actions/setup-python@v5\n.github/workflows/ci.yml:139:      - uses: actions/setup-python@v5\n.github/workflows/ci.yml:154:      - run: test \"$ATTAVO_ATTESTATION_PREDICATE_TYPE\" = \"$(python3 -c \"import json; print(json.load(open('schema/attestation.schema.json'))['\\$id'])\")\"\n.github/workflows/ci.yml:173:      - uses: actions/setup-python@v5\ntests/test_attest.py:33:STATEMENT_SCHEMA = json.loads((ROOT / \"schema\" / \"attestation.schema.json\").read_text())\ntests/test_estimated_cost.py:31:ATTESTATION_SCHEMA = json.loads((ROOT / \"schema\" / \"attestation.schema.json\").read_text())\ntests/test_estimated_cost.py:131:def test_doctor_proof_six_holds_a_v5_estimate_and_fails_one_that_differs(tmp_path: Path) -> None:\ntests/test_estimated_cost.py:132:    \"\"\"#277's verify-01 priced in a v5 statement holds; an estimate, a sum,\ntests/test_estimated_cost.py:137:    seal(root, merge, statement, \"https://attavo.dev/attestation/v5\")\ntests/test_estimated_cost.py:151:        seal(root, merge, forged, \"https://attavo.dev/attestation/v5\")\ntests/test_estimated_cost.py:161:    its predicateType and, with none declared, by carrying no v5 field.\"\"\"\ntests/test_estimated_cost.py:216:def test_a_v5_statement_whose_carried_rate_differs_from_the_manifest_at_its_sealed_commit_fails(\ntests/test_estimated_cost.py:229:    seal(root, merge, statement, \"https://attavo.dev/attestation/v5\")\ntests/test_estimated_cost.py:235:def test_a_v5_statement_still_holds_after_the_manifests_rate_changes_in_a_later_commit(\ntests/test_estimated_cost.py:239:    seal(root, merge, attest(root), \"https://attavo.dev/attestation/v5\")\ntests/test_estimated_cost.py:248:def test_a_v5_statement_fails_when_the_manifest_cannot_be_read_at_its_sealed_commit(\ntests/test_estimated_cost.py:256:    envelope = {\"predicateType\": \"https://attavo.dev/attestation/v5\", \"predicate\": statement}\ntests/test_coherence_template.py:137:    \"\"\"Issue #117: v0.18.0 moved schema/attestation.schema.json's $id from\ntests/test_coherence_template.py:160:    schema/attestation.schema.json's own $id with python3 -c, never\ntests/test_coherence_template.py:196:    schema_id = json.loads((ROOT / \"schema\" / \"attestation.schema.json\").read_text())[\"$id\"]\ntests/test_types_mirror_schemas.py:2:and schema/attestation.schema.json. The schema stays the contract; each\ntests/test_types_mirror_schemas.py:28:    \"AttestRecord\": \"attestation.schema.json\",\ntests/test_attest_time.py:26:SCHEMA = json.loads((ROOT / \"schema\" / \"attestation.schema.json\").read_text())\ntests/test_attest_time.py:190:        envelope[\"predicateType\"] = predicate_type\ntests/test_attest_time.py:324:def test_schema_is_v6_and_names_no_retired_field() -> None:\ntests/test_attest_time.py:326:    moved it to v5, and #349 to v6; they stay gone.\"\"\"\ntests/test_attest_time.py:327:    assert SCHEMA[\"$id\"] == \"https://attavo.dev/attestation/v6\"\ntests/test_attest_interventions.py:4:Specimen: #344's v5 statement (merged as PR #345, d2354e27) carried\ntests/test_attest_interventions.py:62:def test_doctor_proof_six_recomputes_acts_and_interventions_for_a_v6_statement(\ntests/test_attest_interventions.py:64:    \"\"\"Proof six holds a true v6 statement's acts and interventions, the\ntests/test_attest_interventions.py:69:    declared explicitly as v6, since the heuristic that sniffs it from a\ntests/test_attest_interventions.py:74:    seal(root, merge, statement, \"https://attavo.dev/attestation/v6\")\ntests/test_attest_interventions.py:81:    seal(root, merge, forged_acts, \"https://attavo.dev/attestation/v6\")\ntests/test_attest_interventions.py:89:    seal(root, merge, forged_interventions, \"https://attavo.dev/attestation/v6\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,125p' attavo/ledger.py\nsed -n '330,430p' attavo/attest.py\nsed -n '1,110p' tests/test_attest.py\nsed -n '130,210p' tests/test_estimated_cost.py\nrg -n 'def commits_with_diffs|--reverse|diff-merges' attavo\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,125p' attavo/ledger.py\nsed -n '330,430p' attavo/attest.py\nsed -n '1,110p' tests/test_attest.py\nsed -n '130,210p' tests/test_estimated_cost.py\nrg -n 'def commits_with_diffs|--reverse|diff-merges' attavo\"","aggregated_output":"from __future__ import annotations\n\nimport json\nimport re\nimport subprocess\nimport sys\nimport tempfile\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom typing import Any\n\nfrom attavo.build import commits_with_diffs, driver_identity\nfrom attavo.common import MANIFEST, STAGES, git, read_manifest, git_env\nfrom attavo.doctor import INVOCATION_MARKER_SUFFIX, _merges_reachable, merge_introducing_records\nfrom attavo.records import RECORD_RE, _load_record\nfrom attavo.stops import item_stops\nfrom attavo import Command\n\n# --- ledger: every act on an item by identity and class (issue #128) ---\n\n# operator acts (a person's own decisions and transport) vs. product acts\n# (the driver's or the records app's own automated commits) vs. the\n# executor's own code changes -- the three totals the plan's status table\n# and every reviewing session used to count by hand. record-or-launch\n# (below) contributes to neither: an honest count never guesses which\n# side of that line a pre-v0.18.0 commit falls on.\nLEDGER_OPERATOR_CLASSES = (\"approve\", \"amend\", \"launch\", \"transport\", \"merge\")\n\nLEDGER_V018_CUTOFF = (0, 18, 0)\n\n\ndef _semver_tuple(version: str | None) -> tuple[int, int, int] | None:\n    m = re.match(r\"^v(\\d+)\\.(\\d+)\\.(\\d+)\", version or \"\")\n    return (int(m.group(1)), int(m.group(2)), int(m.group(3))) if m else None\n\n\ndef _is_records_app(name: str) -> bool:\n    \"\"\"The forge's own app-bot login -- exactly the identity the\n    attavo-spec-gate and attavo-approve templates commit spec-gate and\n    approval records as (an app-token step mints it at run time from the\n    tenant's own app credentials): \"<app-slug>[bot]\". Never a name this\n    product can name in advance, so the one fact it can check is the\n    shape the forge itself gives every app identity, not a specific one.\"\"\"\n    return name.endswith(\"[bot]\")\n\n\ndef first_commit_touching(root: Path, relpath: str) -> str | None:\n    \"\"\"The earliest commit touching relpath -- the mirror of\n    last_commit_touching, which answers the latest. Ledger's own walk\n    starts here: the item's first spec commit.\"\"\"\n    out = git(root, \"log\", \"--reverse\", \"--format=%H\", \"--\", relpath)\n    lines = out.split()\n    return lines[0] if lines else None\n\n\ndef _single_commit_with_diff(root: Path, sha: str) -> dict[str, Any]:\n    \"\"\"commits_with_diffs's own shape, for one commit read directly rather\n    than by a range -- the one case `_commits_from` needs it for: a\n    commit with no parent, which `^` cannot name.\"\"\"\n    out = git(root, \"show\", \"--diff-merges=first-parent\", \"--name-only\",\n             \"--format=\\x01%H\\x1f%an\\x1f%ae\", sha)\n    header, _, rest = out.split(\"\\x01\")[1].partition(\"\\n\")\n    c_sha, name, email = header.split(\"\\x1f\")\n    return {\"sha\": c_sha, \"name\": name, \"email\": email,\n           \"touched\": [line for line in rest.splitlines() if line.strip()]}\n\n\ndef _commits_from(root: Path, first_sha: str, end: str) -> list[dict[str, Any]]:\n    \"\"\"commits_with_diffs's own range, from first_sha up to and including\n    end: first_sha^..end, the ordinary case. `^` cannot name the parent of\n    a commit that has none -- the repository's own root commit, which a\n    fixture or a squash merge can leave as an item's first spec commit --\n    and `A..B` always excludes A regardless, root or not; here, first_sha's\n    own diff is read directly and put first.\"\"\"\n    try:\n        git(root, \"rev-parse\", \"--verify\", f\"{first_sha}^\")\n    except RuntimeError:\n        return [_single_commit_with_diff(root, first_sha)] + commits_with_diffs(root, first_sha, end=end)\n    return commits_with_diffs(root, f\"{first_sha}^\", end=end)\n\n\ndef _record_blobs_at(root: Path, specs: list[tuple[str, str]], item_id: str) -> dict[tuple[str, str], dict[str, Any]]:\n    \"\"\"{(sha, relpath): record dict} for every (sha, relpath) pair, read by\n    one `git cat-file --batch` process for the whole list rather than one\n    `git show` per record (issue #153, ledger's only need for a record at a\n    past commit rather than the working tree -- issue #128). Each blob is\n    still spilled to a throwaway file and read through _load_record (issue\n    #60, acceptance 6: the one place a record's bytes become a dict),\n    rather than a second json.loads of its own. A pair git cannot resolve,\n    or whose blob is not valid JSON, is simply absent from the result --\n    the same silence _record_at once gave a missing blob.\"\"\"\n    if not specs:\n        return {}\n    stdin = \"\".join(f\"{sha}:{relpath}\\n\" for sha, relpath in specs)\n    out = subprocess.run([\"git\", \"-C\", str(root), \"cat-file\", \"--batch\"],\n                         input=stdin.encode(), capture_output=True, check=False, env=git_env())\n    data = out.stdout\n    pos = 0\n    result: dict[tuple[str, str], dict[str, Any]] = {}\n    for key in specs:\n        newline = data.index(b\"\\n\", pos)\n        header = data[pos:newline].decode()\n        pos = newline + 1\n        parts = header.split(\" \")\n        if parts[-1] == \"missing\":\n            continue\n        size = int(parts[-1])\n        content = data[pos:pos + size]\n        pos += size + 1\n        with tempfile.NamedTemporaryFile(\"wb\", suffix=\".json\", delete=False) as fh:\n            fh.write(content)\n            blob_path = Path(fh.name)\n        try:\n            result[key] = _load_record(blob_path, item_id)\n        except json.JSONDecodeError:\n            continue\n        finally:\n            blob_path.unlink(missing_ok=True)\n    return result\n\n\ndef item_ledger(root: Path, m: dict[str, Any], item_id: str, merges: list[dict[str, Any]] | None = None) -> dict[str, Any]:\n    \"\"\"{\"item\", \"rows\", \"summary\"}: one row per act between item_id's first\n    spec commit and its merge (merge_introducing_records, the same\n    derivation doctor's proof two and attest both already read) or HEAD\n\n    records_dir = root / records_rel / item_id\n    chain, message = check_attest_chain(records_dir, item_id, partial=partial)\n    if chain is None:\n        print(f\"attavo attest: refused: {message}\", file=sys.stderr)\n        return 1\n    if chain is NOT_YET:\n        print(f\"attavo attest --partial: {message}\")\n        return 0\n    latest_spec, latest_approval, latest_build, latest_verify = cast(ChainRecords, chain)\n\n    spec_path = latest_attempt_path(records_dir, \"spec\")\n    approval_path = latest_attempt_path(records_dir, \"approval\")\n    build_path = latest_attempt_path(records_dir, \"build\")\n    verify_path = latest_attempt_path(records_dir, \"verify\")\n\n    # sha and merge_sha are the same commit here -- the one this statement\n    # was computed at. On the merge group that commit is the one main will\n    # hold; kept as two fields because a forge-specific template signs\n    # this statement against \"the commit that lands\", naming it merge_sha\n    # is what makes that unambiguous to a reader who has never seen attest\n    # run anywhere but the merge group.\n    head_sha = git(root, \"rev-parse\", \"HEAD\").strip()\n    try:\n        sealed_at: int | None = int(git(root, \"show\", \"-s\", \"--format=%ct\", \"HEAD\").strip())\n    except (RuntimeError, ValueError):\n        sealed_at = None\n    item_time, item_cost, item_tokens_ = item_accounting(\n        records_dir, sealed_at, (m.get(\"cost\") or {}).get(\"rates\"))\n\n    # Imported here, not at module level: attavo.ledger imports from\n    # attavo.doctor, which imports from this module -- a cycle resolved by\n    # deferring to call time, when every module is already loaded.\n    from attavo.ledger import item_acts_and_interventions\n    acts, interventions = item_acts_and_interventions(root, m, item_id)\n\n    statement: AttestRecord = {\n        \"sha\": head_sha,\n        \"merge_sha\": head_sha,\n        \"item\": item_id,\n        \"spec\": spec_path.stem if spec_path else None,\n        \"spec_sha\": latest_spec.get(\"sha\"),\n        \"approval\": approval_path.stem if approval_path else None,\n        \"approval_sha\": latest_approval.get(\"sha\"),\n        \"build\": build_path.stem if build_path else None,\n        \"build_sha\": latest_build.get(\"sha\"),\n        \"verify\": verify_path.stem if verify_path else None,\n        \"verify_sha\": latest_verify.get(\"sha\"),\n        \"at\": now_iso(),\n        # Read from the item's own commits (issue #349), the same\n        # classification attavo ledger makes -- nothing classified twice.\n        \"interventions\": interventions,\n        \"acts\": acts,\n        # The only accounting: every attempt, summed (the sum across\n        # executors was ruled 2026-09-19). v3's final-attempt fields are\n        # retired (issue #309).\n        \"time\": item_time,\n        \"cost\": item_cost,\n        \"tokens\": item_tokens_,\n        \"product_version\": product_version(),\n        \"product_pin\": (m.get(\"attavo\") or {}).get(\"version\"),\n    }\n    print(json.dumps(statement, indent=2))\n    return 0\n\n\nCOMMANDS = (\n    Command(\n        name='attest',\n        run=cmd_attest,\n        usage=('attavo attest [--partial] [N]',),\n        rank=110,\n        help=(\n            (160, \"\"\"\\\nattest refuses (exit 1) unless the latest spec, approval, build, and\nverify records for an item all exist and chain: the build's approval_sha\nnames the latest approval, and the verify's build_sha names that build --\na re-approval after a build must force a re-run of what changed. With no\nN given it derives the item from the record paths HEAD's merge commit\ntouched under paths.records/<N>/, not from a branch name, which a squash\nmerge discards and which names a forge's convention the product does not\nknow; more than one item derived is a refusal naming what it found. Zero\nis not a defect -- not every merge is an item merge -- exit 0, nothing\nprinted but a line saying so.\n\nattest never writes. On a coherent chain it prints the attestation\nstatement -- validating against schema/attestation.schema.json -- to\nstdout as JSON and exits 0: the item, its four records and their shas,\nand the commit the statement was computed at (sha and merge_sha are the\nsame commit here; on the merge group that commit is the one that lands).\n`time`, `cost` and `tokens` are the statement's only accounting, each\nsummed over every build, verify and counsel attempt; a record that\ncarries no figure is named in not_read, never counted as zero. A record\nwhose adapter reported no cost is priced, in the statement and never in the\nrecord, as tokens times the tenant's [cost.rates] for its model; `cost`\nsays which amounts are estimated and carries the rates it used.\nThe four stage records already under paths.records are the evidence for\nthat statement; a forge-specific template signs the printed JSON,\nunmodified, as the predicate, against the commit that lands, on the merge\ngroup -- and the signed bundle in the forge's attestation store is the\nseal over it. attest itself never signs anything and never talks to a\n\"\"\"attavo attest: refuse unless the latest spec, approval, build, and\nverify records for an item all exist and chain, derive the item from the\nmerge commit's own record paths rather than a branch name, and print the\nattestation statement to stdout. Never writes -- the four stage records\nare the evidence; a forge-specific template signs the printed statement\non the merge group (issue #69, section \"The lane\").\n\nMerges tests/test_attest_dry_run.py into this file (issue #69, change 5):\nattest itself is now always a read, so there is nothing left for a\n--dry-run mode to do differently.\n\nRegression tests, written and run red first: on `main` before this lane\n`attavo attest` wrote an attestation-NN.json record and accepted\n--dry-run; every test here that expects nothing written, a printed\nstatement, or --dry-run refused fails against that shape.\n\nRun: python3 -m pytest tests -q\n\"\"\"\nimport json\nimport subprocess\nimport sys\nfrom collections.abc import Callable\nfrom pathlib import Path\nfrom typing import Any\n\nimport jsonschema\nimport pytest\n\nfrom helpers import commit_all, git, init_repo, make_tenant\n\nROOT = Path(__file__).resolve().parent.parent\nATTAVO = ROOT / \"bin\" / \"attavo\"\nSTATEMENT_SCHEMA = json.loads((ROOT / \"schema\" / \"attestation.schema.json\").read_text())\n\n\ndef run_attavo(root: Path, *args: str) -> subprocess.CompletedProcess[str]:\n    return subprocess.run([sys.executable, str(ATTAVO), *args], cwd=str(root),\n                          capture_output=True, text=True, check=False)\n\n\ndef configure_forge(root: Path) -> None:\n    toml = root / \"attavo.toml\"\n    toml.write_text(toml.read_text()\n                    + '\\n[executor.fixture]\\ny = 2\\n'\n                    + '\\n[checks]\\ncommand = \"true\"\\n'\n                    + \"\"\"\\n[forge]\\nchecks_command = \"printf 'ci success\\\\n'\"\\n\"\"\")\n    commit_all(root, \"configure the fixture adapter, the tenant's checks, and the forge read\")\n\n\ndef traverse_item(root: Path, item: str = \"1\") -> None:\n    \"\"\"spec-gate, approve, build, verify, each committed -- the shape a\n    real workflow template leaves on the item's branch before it merges.\"\"\"\n    assert run_attavo(root, \"spec-gate\", item).returncode == 0\n    commit_all(root, f\"attavo: spec-gate record for #{item}\")\n    assert run_attavo(root, \"approve\", item, \"--by\", \"alice\").returncode == 0\n    commit_all(root, f\"attavo: approval record for #{item}\")\n    assert run_attavo(root, \"build\", item).returncode == 0\n    commit_all(root, f\"attavo: build record for #{item}\")\n    assert run_attavo(root, \"verify\", item).returncode == 0\n    commit_all(root, f\"attavo: verify record for #{item}\")\n\n\ndef merge_into_main(root: Path, branch: str) -> None:\n    git(root, \"checkout\", \"main\")\n    git(root, \"merge\", \"--no-ff\", \"-m\", f\"Merge branch '{branch}' into main\", branch)\n\n\ndef records_snapshot(root: Path) -> list[Any]:\n    records_dir = root / \"records\"\n    return sorted(records_dir.rglob(\"*\")) if records_dir.is_dir() else []\n\n\n# --- row 1: a coherent chain prints a valid statement and writes nothing ---\n\ndef test_attest_prints_a_valid_statement_on_a_coherent_chain_and_writes_nothing(tmp_path: Path) -> None:\n    \"\"\"Acceptance row 1: the merge commit carries no attavo/N-* branch\n    information at all -- 'improve-thing' names nothing about item 1 --\n    proving the derivation reads record paths, not the branch name.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    configure_forge(root)\n    git(root, \"checkout\", \"-b\", \"improve-thing\")\n    traverse_item(root, \"1\")\n    merge_into_main(root, \"improve-thing\")\n\n    before = records_snapshot(root)\n    run = run_attavo(root, \"attest\")\n    assert run.returncode == 0, run.stdout + run.stderr\n\n    statement = json.loads(run.stdout)\n    jsonschema.validate(statement, STATEMENT_SCHEMA)\n    assert statement[\"item\"] == \"1\"\n    assert statement[\"sha\"] == statement[\"merge_sha\"]\n    assert statement[\"tokens\"].keys() >= {\"build\", \"verify\", \"counsel\", \"input\", \"output\"}\n\n    # issue #349: acts is read from the item's own commits, never the\n    # hard-coded [] the schema used to carry regardless -- the approval and\n    # the merge are always among them.\n    assert {\"approve\", \"merge\"} <= {a[\"act\"] for a in statement[\"acts\"]}\n    assert all(a[\"sha\"] for a in statement[\"acts\"])\n\n    assert records_snapshot(root) == before\n    assert git(root, \"status\", \"--porcelain\") == \"\"\n\n\n# --- row 2: every refusal and the --partial not-yet path, same as before ---\n\ndef test_attest_refuses_a_chain_with_a_missing_verify_record(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"build_valid\")\n    configure_forge(root)\n    git(root, \"checkout\", \"-b\", \"attavo/1-x\")\n\ndef test_doctor_proof_six_holds_a_v5_estimate_and_fails_one_that_differs(tmp_path: Path) -> None:\n    \"\"\"#277's verify-01 priced in a v5 statement holds; an estimate, a sum,\n    a basis or a carried rate that is not what the records and rates give\n    fails, naming the item and the cost field.\"\"\"\n    root, merge = specimen(tmp_path, RATE_TABLE)\n    statement = attest(root)\n    seal(root, merge, statement, \"https://attavo.dev/attestation/v5\")\n    held = proof_six(root)\n    assert held[\"holds\"] is True and held[\"sealed\"] == [\"1\"], held\n\n    edits: list[tuple[tuple[str, ...], Any]] = [\n        ((\"estimated_usd\",), 0.25), ((\"usd\",), 0.75), ((\"by_stage_usd\", \"verify\"), 0.3),\n        ((\"basis_by_stage\", \"verify\"), \"reported\"), ((\"rates\", CODEX, \"input_usd_per_mtok\"), 2.0),\n        ((\"estimate_note\",), \"A bill.\")]\n    for path, value in edits:\n        forged: dict[str, Any] = json.loads(json.dumps(statement))\n        node = forged[\"cost\"]\n        for key in path[:-1]:\n            node = node[key]\n        node[path[-1]] = value\n        seal(root, merge, forged, \"https://attavo.dev/attestation/v5\")\n        failed = proof_six(root)\n        assert failed[\"holds\"] is False, (path, failed)\n        assert \"item 1\" in failed[\"reason\"] and \"cost\" in failed[\"reason\"], failed\n\n\ndef test_doctor_proof_six_still_holds_v4_and_v3_statements_by_their_own_rules(\n        tmp_path: Path) -> None:\n    \"\"\"A statement sealed before #307 priced nothing: #277's verify-01 stays\n    unread in it, though the manifest has a rate now, and it holds. v4 by\n    its predicateType and, with none declared, by carrying no v5 field.\"\"\"\n    root, merge = specimen(tmp_path, RATE_TABLE)\n    statement = attest(root)\n    v4: dict[str, Any] = json.loads(json.dumps(statement))\n    for field in V5_COST_FIELDS:\n        v4[\"cost\"].pop(field)\n    v4[\"cost\"][\"usd\"] = 0.5\n    v4[\"cost\"][\"by_stage_usd\"] = {\"build\": 0.5}\n    v4[\"cost\"][\"by_adapter_usd\"] = {\"claude-code\": 0.5}\n    v4[\"cost\"][\"partial\"] = True\n    v4[\"cost\"][\"not_read\"] = [\"verify-01\"]\n    for declared in (\"https://attavo.dev/attestation/v4\", None):\n        seal(root, merge, v4, declared)\n        held = proof_six(root)\n        assert held[\"holds\"] is True and held[\"sealed\"] == [\"1\"], (declared, held)\n    v4[\"cost\"][\"usd\"] = 0.75\n    seal(root, merge, v4, \"https://attavo.dev/attestation/v4\")\n    assert proof_six(root)[\"holds\"] is False, \"v4's cost is still checked\"\n\n    v3: dict[str, Any] = json.loads(json.dumps(statement))\n    for field in V5_COST_FIELDS:\n        v3[\"cost\"].pop(field)\n    v3[\"cost\"].update({\"usd\": 0.5, \"by_stage_usd\": {\"build\": 0.5},\n                       \"by_adapter_usd\": {\"claude-code\": 0.5},\n                       \"partial\": True, \"not_read\": [\"verify-01\"]})\n    v3.pop(\"tokens\")\n    v3[\"cost_by_stage_usd\"] = {\"build\": 0.5, \"verify\": None}\n    seal(root, merge, v3, \"https://attavo.dev/attestation/v3\")\n    held = proof_six(root)\n    assert held[\"holds\"] is True and held[\"sealed\"] == [\"1\"], held\n\n\ndef test_the_manifest_schema_accepts_the_rate_table_and_refuses_a_rate_with_no_as_of() -> None:\n    \"\"\"The product carries no rate of its own: the tenant's table, each\n    rate dated and sourced.\"\"\"\n    cost = MANIFEST_SCHEMA[\"properties\"][\"cost\"]\n    jsonschema.validate({\"rates\": {CODEX: CODEX_RATE}}, cost)\n    undated = {k: v for k, v in CODEX_RATE.items() if k != \"as_of\"}\n    with pytest.raises(jsonschema.ValidationError):\n        jsonschema.validate({\"rates\": {CODEX: undated}}, cost)\n    unsourced = {k: v for k, v in CODEX_RATE.items() if k != \"source\"}\n    with pytest.raises(jsonschema.ValidationError):\n        jsonschema.validate({\"rates\": {CODEX: unsourced}}, cost)\n    with pytest.raises(jsonschema.ValidationError):\n        jsonschema.validate({\"rates\": {CODEX: {**CODEX_RATE, \"input_usd_per_mtok\": -1}}}, cost)\n\n\ndef test_an_item_with_no_priced_record_keeps_the_v4_totals(tmp_path: Path) -> None:\n    \"\"\"INVOCATIONS carry no model: nothing is priced, nothing is renamed in not_read.\"\"\"\n    root, _ = make_item(tmp_path, INVOCATIONS, manifest_extra=RATE_TABLE)\nattavo/doctor.py:101:    it. --diff-merges=first-parent gives each merge's diff against its\nattavo/doctor.py:119:                 \"--diff-merges=first-parent\", \"--name-only\",\nattavo/doctor.py:469:                      \"--reverse\", \"--\", MANIFEST).split()\nattavo/verify.py:362:        commits = git(root, \"rev-list\", f\"{head_sha}..{post_adapter_head}\", \"--reverse\").split()\nattavo/ledger.py:51:    out = git(root, \"log\", \"--reverse\", \"--format=%H\", \"--\", relpath)\nattavo/ledger.py:60:    out = git(root, \"show\", \"--diff-merges=first-parent\", \"--name-only\",\nattavo/build.py:183:    out = git(root, \"log\", \"--first-parent\", \"--reverse\",\nattavo/build.py:194:def commits_with_diffs(root: Path, start_sha: str, end: str = \"HEAD\") -> list[dict[str, Any]]:\nattavo/build.py:199:    out = git(root, \"log\", \"--first-parent\", \"--reverse\", \"--diff-merges=first-parent\",\n","exit_code":0,"status":"completed"}}

{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc \"sed -n '120,330p' attavo/ledger.py && sed -n '820,1030p' attavo/doctor.py && sed -n '1,130p' schema/attestation.schema.json && sed -n '1,130p' tests/test_attest_interventions.py && sed -n '300,345p' tests/test_attest_time.py && git diff --stat f1417b677294b44344e56ea6943b5930a08db37c..ed1690a419622b23d25ebb945de750e252c794cd && git diff --name-status f1417b677294b44344e56ea6943b5930a08db37c..ed1690a419622b23d25ebb945de750e252c794cd\"","aggregated_output":"\n\ndef item_ledger(root: Path, m: dict[str, Any], item_id: str, merges: list[dict[str, Any]] | None = None) -> dict[str, Any]:\n    \"\"\"{\"item\", \"rows\", \"summary\"}: one row per act between item_id's first\n    spec commit and its merge (merge_introducing_records, the same\n    derivation doctor's proof two and attest both already read) or HEAD\n    when the item has not merged yet.\n\n    merges, when given, is _merges_reachable's own result -- cmd_ledger\n    computes it once and passes it here for every item, rather than each\n    item walking HEAD's merges again (issue #153).\n\n    Each commit gets exactly one class, in this order: the merge commit\n    itself is \"merge\"; a commit authored by the executor identity\n    (executor_identity) is \"change\"; a commit introducing an approval\n    record is \"approve\", whoever committed it -- an operator's decision,\n    however it reached git; a commit introducing a spec-gate, build, or\n    verify record, authored by the driver identity (driver_identity) or\n    the records app, is \"record\"; the same, authored by a person, is\n    \"launch\" for build or verify (spec-gate records the app always\n    commits, in every template this product ships) -- unless that\n    record's own product_version predates v0.18.0, when driver_identity\n    did not yet exist to tell the two apart, and the row is\n    \"record-or-launch\" with a note, counted in neither summary total\n    rather than guessed; a person's commit touching the spec is \"spec\"\n    before the first approval record and \"amend\" after; anything else by\n    a person is \"transport\" (a merge of main among them).\"\"\"\n    specs_rel = m[\"paths\"][\"specs\"]\n    records_rel = m[\"paths\"][\"records\"]\n    specs_prefix = f\"{specs_rel.rstrip('/')}/{item_id}/\"\n    records_prefix = f\"{records_rel.rstrip('/')}/{item_id}/\"\n    empty_summary = {\"operator_acts\": 0, \"product_acts\": 0, \"executor_commits\": 0,\n                     \"stops\": 0, \"since\": None}\n\n    first_spec_sha = first_commit_touching(root, str(Path(specs_rel) / item_id))\n    if first_spec_sha is None:\n        return {\"item\": item_id, \"rows\": [], \"summary\": empty_summary}\n\n    if merges is None:\n        merges, refusal = _merges_reachable(root)\n        if refusal:\n            return {\"item\": item_id, \"rows\": [], \"summary\": empty_summary}\n    merge_sha, _ = merge_introducing_records(root, records_rel, item_id, STAGES, merges=merges)\n    if merge_sha is not None:\n        branch_tip = next(mrg[\"parents\"][1] for mrg in merges if mrg[\"sha\"] == merge_sha)\n        commits = _commits_from(root, first_spec_sha, branch_tip)\n        commits += commits_with_diffs(root, f\"{merge_sha}^1\", end=merge_sha)\n    else:\n        commits = _commits_from(root, first_spec_sha, \"HEAD\")\n\n    driver = driver_identity()\n\n    # Every record a walked commit touches, read by one batched process\n    # for the whole item rather than one `git show` per record (issue\n    # #153): a first pass over the already-fetched diffs finds which\n    # commits touch a record, then _record_blobs_at fetches them all.\n    record_touches: dict[str, tuple[str, str]] = {}\n    for c in commits:\n        if merge_sha is not None and c[\"sha\"] == merge_sha:\n            continue\n        if c[\"email\"].startswith(\"executor+\") and c[\"email\"].endswith(\"@attavo.invalid\"):\n            continue\n        for p in c[\"touched\"]:\n            if not p.startswith(records_prefix):\n                continue\n            rm = RECORD_RE.match(Path(p).name)\n            if rm and rm.group(1) in STAGES:\n                record_touches[c[\"sha\"]] = (rm.group(1), p)\n                break\n    record_content = _record_blobs_at(\n        root, [(sha, relpath) for sha, (_, relpath) in record_touches.items()], item_id)\n\n    rows: list[dict[str, Any]] = []\n    operator_acts = product_acts = executor_commits = 0\n    since = None\n    approval_seen = False\n\n    for c in commits:\n        sha, name, email = c[\"sha\"], c[\"name\"], c[\"email\"]\n\n        if merge_sha is not None and sha == merge_sha:\n            rows.append({\"sha\": sha, \"identity\": name, \"class\": \"merge\"})\n            operator_acts += 1\n            continue\n\n        if email.startswith(\"executor+\") and email.endswith(\"@attavo.invalid\"):\n            rows.append({\"sha\": sha, \"identity\": name, \"class\": \"change\"})\n            executor_commits += 1\n            continue\n\n        record_touch = record_touches.get(sha)\n\n        if record_touch is not None:\n            stage, relpath = record_touch\n            content = record_content.get((sha, relpath), {})\n            if since is None:\n                since = content.get(\"product_version\")\n\n            if stage == \"approval\":\n                rows.append({\"sha\": sha, \"identity\": name, \"class\": \"approve\"})\n                operator_acts += 1\n                approval_seen = True\n                continue\n\n            is_driver = name == driver[\"name\"] and email == driver[\"email\"]\n            is_records_app = _is_records_app(name)\n            if stage == \"spec\" or is_driver or is_records_app:\n                rows.append({\"sha\": sha, \"identity\": name, \"class\": \"record\"})\n                product_acts += 1\n                continue\n\n            version = _semver_tuple(content.get(\"product_version\"))\n            if version is not None and version < LEDGER_V018_CUTOFF:\n                rows.append({\"sha\": sha, \"identity\": name, \"class\": \"record-or-launch\",\n                            \"note\": \"not distinguishable before v0.18.0\"})\n                continue\n\n            rows.append({\"sha\": sha, \"identity\": name, \"class\": \"launch\"})\n            operator_acts += 1\n            continue\n\n        # An invocation marker's own commit (proof five): the product's\n        # act, never the operator's.\n        if any(p.startswith(records_prefix) and p.endswith(INVOCATION_MARKER_SUFFIX)\n               for p in c[\"touched\"]):\n            rows.append({\"sha\": sha, \"identity\": name, \"class\": \"record\"})\n            product_acts += 1\n            continue\n\n        if any(p.startswith(specs_prefix) for p in c[\"touched\"]):\n            cls = \"amend\" if approval_seen else \"spec\"\n            rows.append({\"sha\": sha, \"identity\": name, \"class\": cls})\n            if cls == \"amend\":\n                operator_acts += 1\n            continue\n\n        rows.append({\"sha\": sha, \"identity\": name, \"class\": \"transport\"})\n        operator_acts += 1\n\n    # issue #137: the same set attavo stops counts, from the same reader\n    # (item_stops) -- not a second, independent count kept in sync by\n    # hand. One non-pass record per row, whatever its stage; a gate\n    # refusal is included the same as a non-pass build or verify record.\n    stops = len(item_stops(root, m, item_id)[\"rows\"])\n\n    summary = {\"operator_acts\": operator_acts, \"product_acts\": product_acts,\n              \"executor_commits\": executor_commits, \"stops\": stops, \"since\": since}\n    return {\"item\": item_id, \"rows\": rows, \"summary\": summary}\n\n\n# The statement's own two lists (issue #349): acts is the operator's ruled\n# acts (approve, merge); rule stays in the schema's enum for the ruling\n# record (#276) and is never produced here. interventions is every other\n# operator row -- amend, launch, transport.\nACT_CLASSES = (\"approve\", \"merge\")\nINTERVENTION_CLASSES = (\"amend\", \"launch\", \"transport\")\n\n\ndef _committer_time_iso(root: Path, shas: list[str]) -> dict[str, str]:\n    \"\"\"Each sha's own committer time, in the same shape attest's own `at`\n    fields already carry -- one `git show` process for every sha an\n    item's acts and interventions need, not one git call per row.\"\"\"\n    if not shas:\n        return {}\n    out = git(root, \"show\", \"-s\", \"--format=%H\\x1f%ct\", *shas)\n    times: dict[str, str] = {}\n    for line in out.splitlines():\n        if not line.strip():\n            continue\n        sha, epoch = line.split(\"\\x1f\")\n        times[sha] = datetime.fromtimestamp(int(epoch), timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n    return times\n\n\ndef item_acts_and_interventions(root: Path, m: dict[str, Any], item_id: str,\n                                merges: list[dict[str, Any]] | None = None\n                                ) -> tuple[list[dict[str, Any]], list[dict[str, Any]]]:\n    \"\"\"(acts, interventions): the statement's own two lists, read from\n    item_ledger's own rows between the item's first spec commit and its\n    merge -- each commit classed exactly once there, never classified\n    twice. acts carries every approve and merge row as {act, sha, by, at};\n    interventions carries every amend, launch, and transport row as\n    {class, sha, by, at}. `by` is the commit's own author name\n    (item_ledger's `identity`); `at` is its committer time.\"\"\"\n    rows = item_ledger(root, m, item_id, merges=merges)[\"rows\"]\n    act_rows = [r for r in rows if r[\"class\"] in ACT_CLASSES]\n    intervention_rows = [r for r in rows if r[\"class\"] in INTERVENTION_CLASSES]\n    times = _committer_time_iso(root, [r[\"sha\"] for r in act_rows + intervention_rows])\n    acts = [{\"act\": r[\"class\"], \"sha\": r[\"sha\"], \"by\": r[\"identity\"], \"at\": times[r[\"sha\"]]}\n           for r in act_rows]\n    interventions = [{\"class\": r[\"class\"], \"sha\": r[\"sha\"], \"by\": r[\"identity\"], \"at\": times[r[\"sha\"]]}\n                     for r in intervention_rows]\n    return acts, interventions\n\n\ndef cmd_ledger(argv: list[str]) -> int:\n    as_json = \"--json\" in argv\n    positional = [a for a in argv if a != \"--json\"]\n    root = Path(\".\").resolve()\n    m = read_manifest(root)\n    if m is None:\n        print(f\"attavo ledger: no {MANIFEST} at {root}\", file=sys.stderr)\n        return 2\n\n    records_rel = m[\"paths\"][\"records\"]\n    if positional:\n        item_ids = [positional[0]]\n    else:\n        records_root = root / records_rel\n        item_ids = (sorted((p.name for p in records_root.iterdir() if p.is_dir()))\n                   if records_root.is_dir() else [])\nDATA_KEYED = (\"by_stage_usd\", \"by_adapter_usd\")\n\n\ndef _same(stated: Any, summed: Any) -> bool:\n    \"\"\"Equal as the accounting means it: a number equals a number of the\n    same value (a store may print 40.0 as 40), a bool equals only a bool,\n    and a list is equal member by member. No tolerance and no conversion:\n    both sides are the same function's rounding of the same records, and an\n    int one past 2**53 is not the float beside it.\"\"\"\n    if isinstance(stated, bool) or isinstance(summed, bool):\n        return isinstance(stated, bool) and isinstance(summed, bool) and stated == summed\n    if isinstance(stated, (int, float)) and isinstance(summed, (int, float)):\n        return bool(stated == summed)\n    if isinstance(stated, list) and isinstance(summed, list):\n        return len(stated) == len(summed) and all(_same(a, b) for a, b in zip(stated, summed))\n    return type(stated) is type(summed) and bool(stated == summed)\n\n\ndef _differences(path: str, stated: Any, summed: Any, keyed_by_data: bool = False) -> list[str]:\n    \"\"\"Every field of `stated` that is not what its records sum to, named by\n    its path. Only the keys the statement carries are compared, at every\n    depth, so a field a later release adds is not demanded of a statement\n    sealed before it; a key it carries that the function does not produce\n    is a difference.\"\"\"\n    if not (isinstance(stated, dict) and isinstance(summed, dict)):\n        return [] if _same(stated, summed) else [f\"{path} {stated!r} is not its records' {summed!r}\"]\n    found: list[str] = []\n    for key in sorted(stated):\n        if key not in summed:\n            found.append(f\"{path}.{key} {stated[key]!r} is not a field its records sum to\")\n        else:\n            found += _differences(f\"{path}.{key}\", stated[key], summed[key], key in DATA_KEYED)\n    if keyed_by_data:\n        found += [f\"{path}.{key} is absent; its records sum to {summed[key]!r}\"\n                  for key in sorted(summed.keys() - stated.keys())]\n    return found\n\n\ndef _carried(predicate: dict[str, Any], key: str) -> str:\n    return repr(predicate[key]) if key in predicate else \"absent\"\n\n\nV3_ONLY_FIELDS = (\"cost_by_stage_usd\", \"wall_clock_by_stage_s\", \"tokens_by_stage\")\n\n\nV5_COST_FIELDS = (\"reported_usd\", \"estimated_usd\", \"basis_by_stage\", \"rates\", \"estimate_note\")\n\n\ndef _carries_act_sha(rows: Any) -> bool:\n    \"\"\"True when `rows` is a non-empty list whose entries already carry\n    `sha` -- v6's own shape for `acts` and `interventions` (issue #349);\n    v5 and earlier wrote both as `[]`, never a sha.\"\"\"\n    return isinstance(rows, list) and any(isinstance(r, dict) and \"sha\" in r for r in rows)\n\n\ndef _predicate_version(statement: dict[str, Any], predicate: dict[str, Any]) -> int:\n    \"\"\"The attestation version a statement was sealed under (issues #309,\n    #307, #349): named by its envelope's predicateType, else known by what\n    it carries -- v3 by the final-attempt fields v4 retired, v6 by a sha\n    on an act or intervention row, v5 by the rates its cost block carries,\n    v4 otherwise. Each is judged by its own rules; nothing sealed is\n    rewritten.\"\"\"\n    declared = statement.get(\"predicateType\")\n    named = re.search(r\"/attestation/v(\\d+)$\", declared) if isinstance(declared, str) else None\n    if named:\n        return int(named.group(1))\n    if any(key in predicate for key in V3_ONLY_FIELDS):\n        return 3\n    if _carries_act_sha(predicate.get(\"acts\")) or _carries_act_sha(predicate.get(\"interventions\")):\n        return 6\n    cost = predicate.get(\"cost\")\n    return 5 if isinstance(cost, dict) and \"rates\" in cost else 4\n\n\ndef _accounting_disagrees(root: Path, item_records_dir: Path, item: str, merge_sha: str,\n                          statement: dict[str, Any],\n                          merges: list[dict[str, Any]] | None = None) -> str | None:\n    \"\"\"A sealed statement that carries `time` and `cost` (and, from v4,\n    `tokens`; from v6, `acts` and `interventions`) says what its records sum\n    to, field by field -- the same function attest summed them with, over\n    the same records (none is written after a merge), sealed at the same\n    commit (the statement is computed at the merge, so lead_s and\n    waiting_s are recomputed from its committer time, not excepted). Exact:\n    #202 retired the one-second tolerance. A statement sealed before `time`\n    existed carries neither key and is not checked; a key that is present\n    holds a block, so a null one, or one block without the other, is a\n    disagreement. No new read of the store. merges, when given, is\n    _merges_reachable's own result -- the caller's loop over every item\n    computes it once rather than each item's acts and interventions\n    walking the default branch's merges again.\"\"\"\n    inner = statement.get(\"predicate\")\n    predicate = inner if isinstance(inner, dict) else statement\n    if \"time\" not in predicate and \"cost\" not in predicate:\n        return None\n    stated_time, stated_cost = predicate.get(\"time\"), predicate.get(\"cost\")\n    where = f\"item {item} merged at {merge_sha[:12]}\"\n    if not isinstance(stated_time, dict) or not isinstance(stated_cost, dict):\n        return (f\"{where}: the statement's time and cost are not both blocks \"\n                f\"(time is {_carried(predicate, 'time')}, cost is {_carried(predicate, 'cost')})\")\n    try:\n        sealed_at: int | None = int(git(root, \"show\", \"-s\", \"--format=%ct\", merge_sha).strip())\n    except (RuntimeError, ValueError):\n        sealed_at = None\n    version = _predicate_version(statement, predicate)\n    # v5 prices a record by the [cost.rates] the tenant's manifest declared\n    # at the sealed commit, never by the rates the statement carries: the\n    # carried block is then compared like any field, and a later edit to the\n    # manifest cannot unseal anything. v3 and v4 priced nothing.\n    rates: dict[str, Any] | None = None\n    if version >= 5:\n        try:\n            declared = parse_manifest(git(root, \"show\", f\"{merge_sha}:{MANIFEST}\"))\n        except (RuntimeError, ValueError) as exc:\n            return (f\"{where}: the manifest {MANIFEST} cannot be read at the sealed commit, \"\n                    f\"so a v5 statement's estimate cannot be checked ({exc})\")\n        found = (declared.get(\"cost\") or {}).get(\"rates\")\n        rates = found if isinstance(found, dict) else {}\n    summed_time, summed_cost, summed_tokens = item_accounting(\n        item_records_dir, sealed_at, rates)\n    cost_now = {k: v for k, v in summed_cost.items() if version >= 5 or k not in V5_COST_FIELDS}\n    if version < 5:  # v3 and v4 named the record, never the missing rate\n        cost_now[\"not_read\"] = [n.split(\" (no [cost.rates]\")[0] for n in summed_cost[\"not_read\"]]\n    differing = (_differences(\"time\", stated_time, dict(summed_time))\n                 + _differences(\"cost\", stated_cost, cost_now))\n    if version >= 4:\n        stated_tokens = predicate.get(\"tokens\")\n        if isinstance(stated_tokens, dict):\n            differing += _differences(\"tokens\", stated_tokens, dict(summed_tokens))\n        else:\n            differing.append(f\"tokens is {_carried(predicate, 'tokens')}, not a block \"\n                             f\"its records sum to {dict(summed_tokens)!r}\")\n    if version >= 6:\n        # Imported here, not at module level: attavo.ledger imports from\n        # this module, a cycle resolved by deferring to call time.\n        from attavo.ledger import item_acts_and_interventions\n        summed_acts, summed_interventions = item_acts_and_interventions(\n            root, declared, item, merges=merges)\n        stated_acts, stated_interventions = predicate.get(\"acts\"), predicate.get(\"interventions\")\n        if not (isinstance(stated_acts, list) and _same(stated_acts, summed_acts)):\n            differing.append(f\"acts {stated_acts!r} is not its records' {summed_acts!r}\")\n        if not (isinstance(stated_interventions, list) and _same(stated_interventions, summed_interventions)):\n            differing.append(f\"interventions {stated_interventions!r} is not its \"\n                             f\"records' {summed_interventions!r}\")\n    if differing:\n        return f\"{where}: the statement's \" + \"; \".join(differing)\n    return None\n\n\ndef proof_every_attested_item_is_sealed(root: Path, m: dict[str, Any] | None) -> Proof:\n    p = Proof(\"every-attested-item-is-sealed\", \"every attested item has its statement in the store\")\n    if m is None:\n        return p.fail(f\"no {MANIFEST} at {root}; no records directory is declared\")\n    cmd = attestation_command(m)\n    if cmd is None:\n        return p.fail(\"no [forge].attestation_command in the manifest; the store cannot be read\")\n    records_rel = m.get(\"paths\", {}).get(\"records\", \"\")\n    records_dir = root / records_rel\n    if not records_dir.is_dir():\n        return p.fail(f\"no records directory under {records_dir}\")\n    items = load_records(records_dir)\n    complete = [item for item, stages in sorted(items.items()) if all(s in stages for s in STAGES)]\n\n    # [forge].sealed_since: merges at or before this commit are before the\n    # window -- the tenant could not seal them (no queue, no signing\n    # workflow, or a store that held nothing yet). They are named, never\n    # failed. Absent, the window starts where proof three's does: the\n    # install commit, or [doctor].from (issue #192).\n    since = (m.get(\"forge\") or {}).get(\"sealed_since\")\n    if not (isinstance(since, str) and since.strip()):\n        try:\n            since = proof_window_start(root, m)[1]\n        except WindowRefused as exc:\n            return p.fail(str(exc))\n    merges, refusal = _merges_reachable(root)\n    if refusal:\n        return p.fail(refusal)\n    sealed: list[str] = []\n    before_window: list[str] = []\n    unsealed: list[str] = []\n    not_merged: list[str] = []\n    not_read: list[str] = []\n    reasons: list[str] = []\n    for item in complete:\n        merge_sha, _ = merge_introducing_records(root, records_rel, item, STAGES, merges=merges)\n        if merge_sha is None:\n            not_merged.append(item)\n            continue\n        if _is_ancestor(root, merge_sha, since):\n            before_window.append(item)\n            continue\n        statement, exit_code = statement_for(root, cmd, merge_sha)\n        if statement is not None:\n            sealed.append(item)\n            disagreement = _accounting_disagrees(root, records_dir / item, item, merge_sha,\n                                                 statement, merges=merges)\n            if disagreement:\n                reasons.append(disagreement)\n        elif exit_code == 2:\n            not_read.append(item)\n            reasons.append(f\"item {item} merged at {merge_sha[:12]}: not read -- \"\n                           f\"the store could not be read; {cmd!r} exited 2\")\n        else:\n            unsealed.append(item)\n            reasons.append(f\"item {item} merged at {merge_sha[:12]} has no statement in the store\")\n    if reasons:\n        return p.fail(\"; \".join(reasons), sealed=sealed, before_window=before_window,\n                      unsealed=unsealed, not_merged=not_merged, not_read=not_read)\n    window = f\" at {since[:12]}\" if before_window else \"\"\n    return p.hold(f\"{len(sealed)} sealed, {len(before_window)} before the window{window}, \"\n                 f\"{len(not_merged)} not merged\",\n                 sealed=sealed, before_window=before_window, unsealed=unsealed,\n{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"$id\": \"https://attavo.dev/attestation/v6\",\n  \"title\": \"The attestation statement `attavo attest` prints on a coherent chain (v6: `interventions` and `acts` are read from the item's own commits between its first spec commit and its merge, each one classed exactly once by attavo/ledger.py::item_ledger -- sha is now required in both; v5: `cost` also prices, from the tenant's published rates, a record whose adapter reported none, and says so; v4: `time`, `cost` and `tokens` are the only accounting, summed over every attempt; v3 statements sealed earlier also carry cost_by_stage_usd, wall_clock_by_stage_s and tokens_by_stage, the final attempt of each stage)\",\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"required\": [\n    \"sha\", \"merge_sha\", \"item\", \"spec\", \"spec_sha\", \"approval\", \"approval_sha\",\n    \"build\", \"build_sha\", \"verify\", \"verify_sha\", \"at\", \"interventions\", \"acts\",\n    \"time\", \"cost\", \"tokens\",\n    \"product_version\", \"product_pin\"\n  ],\n  \"properties\": {\n    \"sha\": {\"type\": \"string\", \"minLength\": 1},\n    \"merge_sha\": {\"type\": \"string\", \"minLength\": 1},\n    \"item\": {\"type\": \"string\", \"minLength\": 1},\n    \"spec\": {\"type\": [\"string\", \"null\"]},\n    \"spec_sha\": {\"type\": [\"string\", \"null\"]},\n    \"approval\": {\"type\": [\"string\", \"null\"]},\n    \"approval_sha\": {\"type\": [\"string\", \"null\"]},\n    \"build\": {\"type\": [\"string\", \"null\"]},\n    \"build_sha\": {\"type\": [\"string\", \"null\"]},\n    \"verify\": {\"type\": [\"string\", \"null\"]},\n    \"verify_sha\": {\"type\": [\"string\", \"null\"]},\n    \"at\": {\"type\": \"string\", \"minLength\": 1},\n    \"interventions\": {\n      \"type\": \"array\",\n      \"description\": \"Every operator row on the item other than approve and merge -- amend, launch, transport -- read from attavo/ledger.py::item_ledger's own rows between the item's first spec commit and its merge (issue #349): the row's class, its sha, the commit's own author name, and its committer time.\",\n      \"items\": {\n        \"type\": \"object\",\n        \"additionalProperties\": false,\n        \"required\": [\"at\", \"class\", \"by\", \"sha\"],\n        \"properties\": {\n          \"at\": {\"type\": \"string\", \"minLength\": 1},\n          \"class\": {\"type\": \"string\", \"minLength\": 1},\n          \"by\": {\"type\": \"string\", \"minLength\": 1},\n          \"sha\": {\"type\": \"string\", \"minLength\": 1}\n        }\n      }\n    },\n    \"acts\": {\n      \"type\": \"array\",\n      \"description\": \"The operator's ruled acts on the item: each approve row and the merge row, read the same way (issue #349). rule stays in this enum for the ruling record (#276) and is never produced here.\",\n      \"items\": {\n        \"type\": \"object\",\n        \"additionalProperties\": false,\n        \"required\": [\"at\", \"act\", \"by\", \"sha\"],\n        \"properties\": {\n          \"at\": {\"type\": \"string\", \"minLength\": 1},\n          \"act\": {\"type\": \"string\", \"enum\": [\"approve\", \"rule\", \"merge\"]},\n          \"by\": {\"type\": \"string\", \"minLength\": 1},\n          \"sha\": {\"type\": \"string\", \"minLength\": 1}\n        }\n      }\n    },\n    \"time\": {\n      \"type\": \"object\",\n      \"description\": \"Every invocation of the item, summed by attest from its stage records' wall_clock_s: per stage and for the item, every attempt and not the final one alone. lead_s runs from the first approval record's `at` to the committer time of the commit the statement is computed at; waiting_s is lead_s minus invocation_s. A record with no wall_clock_s is named in not_read and its sums are partial, never smaller in silence.\",\n      \"additionalProperties\": false,\n      \"required\": [\"build\", \"verify\", \"counsel\", \"invocation_s\", \"lead_s\", \"waiting_s\", \"partial\", \"not_read\"],\n      \"properties\": {\n        \"build\": {\"$ref\": \"#/$defs/stage_time\"},\n        \"verify\": {\"$ref\": \"#/$defs/stage_time\"},\n        \"counsel\": {\"$ref\": \"#/$defs/stage_time\"},\n        \"invocation_s\": {\"type\": \"number\", \"minimum\": 0},\n        \"lead_s\": {\"type\": [\"number\", \"null\"]},\n        \"waiting_s\": {\"type\": [\"number\", \"null\"]},\n        \"partial\": {\"type\": \"boolean\"},\n        \"not_read\": {\"type\": \"array\", \"items\": {\"type\": \"string\", \"minLength\": 1}}\n      }\n    },\n    \"cost\": {\n      \"type\": \"object\",\n      \"description\": \"Every record's cost summed by attest: the item's total across stages and executors (ruled 2026-09-19), with a subtotal per stage and per adapter. A record's cost_usd is taken as the adapter reported it; a record that reported none, with numeric tokens and a model the tenant's manifest has a [cost.rates] entry for, is priced as tokens times that rate (ruled 2026-10-05: computed here, never written into a record). usd is reported_usd plus estimated_usd. A record neither reported nor priceable is named in not_read, naming the missing rate, and makes usd and the subtotals it belongs to partial: absent is never zero, and a partial total says so.\",\n      \"additionalProperties\": false,\n      \"required\": [\"usd\", \"reported_usd\", \"estimated_usd\", \"by_stage_usd\", \"basis_by_stage\", \"by_adapter_usd\", \"rates\", \"estimate_note\", \"partial\", \"not_read\"],\n      \"properties\": {\n        \"usd\": {\"type\": \"number\", \"minimum\": 0},\n        \"reported_usd\": {\"type\": \"number\", \"minimum\": 0},\n        \"estimated_usd\": {\"type\": \"number\", \"minimum\": 0},\n        \"by_stage_usd\": {\"type\": \"object\", \"additionalProperties\": {\"type\": \"number\", \"minimum\": 0}},\n        \"basis_by_stage\": {\n          \"type\": \"object\",\n          \"description\": \"For each stage with an amount: reported (every amount the adapter's), estimated (every amount priced here) or mixed.\",\n          \"additionalProperties\": {\"enum\": [\"reported\", \"estimated\", \"mixed\"]}\n        },\n        \"by_adapter_usd\": {\"type\": \"object\", \"additionalProperties\": {\"type\": \"number\", \"minimum\": 0}},\n        \"rates\": {\n          \"type\": \"object\",\n          \"description\": \"The tenant's rates this statement priced a record by, per model, as the manifest carried them: empty when nothing was priced.\",\n          \"additionalProperties\": {\n            \"type\": \"object\",\n            \"additionalProperties\": false,\n            \"required\": [\"input_usd_per_mtok\", \"output_usd_per_mtok\", \"as_of\", \"source\"],\n            \"properties\": {\n              \"input_usd_per_mtok\": {\"type\": \"number\", \"minimum\": 0},\n              \"output_usd_per_mtok\": {\"type\": \"number\", \"minimum\": 0},\n              \"as_of\": {\"type\": \"string\", \"minLength\": 1},\n              \"source\": {\"type\": \"string\", \"minLength\": 1}\n            }\n          }\n        },\n        \"estimate_note\": {\"type\": \"string\", \"const\": \"Estimated amounts are tokens times the tenant's published rates: a meter at API prices, not a bill.\"},\n        \"partial\": {\"type\": \"boolean\"},\n        \"not_read\": {\"type\": \"array\", \"items\": {\"type\": \"string\", \"minLength\": 1}}\n      }\n    },\n    \"tokens\": {\n      \"type\": \"object\",\n      \"description\": \"Every record's tokens summed by attest: per stage and for the item, input and output over every attempt and not the final one alone. With `time` and `cost`, the statement's only accounting. A record with no tokens is named in not_read and makes the sums it belongs to partial: absent is never zero.\",\n      \"additionalProperties\": false,\n      \"required\": [\"build\", \"verify\", \"counsel\", \"input\", \"output\", \"partial\", \"not_read\"],\n      \"properties\": {\n        \"build\": {\"$ref\": \"#/$defs/stage_tokens\"},\n        \"verify\": {\"$ref\": \"#/$defs/stage_tokens\"},\n        \"counsel\": {\"$ref\": \"#/$defs/stage_tokens\"},\n        \"input\": {\"type\": \"integer\", \"minimum\": 0},\n        \"output\": {\"type\": \"integer\", \"minimum\": 0},\n        \"partial\": {\"type\": \"boolean\"},\n        \"not_read\": {\"type\": \"array\", \"items\": {\"type\": \"string\", \"minLength\": 1}}\n      }\n    },\n    \"product_version\": {\"type\": \"string\", \"minLength\": 1},\n    \"product_pin\": {\"type\": [\"string\", \"null\"]}\n  },\n  \"$defs\": {\n    \"stage_tokens\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\"input\", \"output\", \"partial\"],\n\"\"\"The statement's acts and interventions are read from the item's own\ncommits, the same classification `attavo ledger` makes (issue #349).\n\nSpecimen: #344's v5 statement (merged as PR #345, d2354e27) carried\n`acts: []` and `interventions: []`, hard-coded in attavo/attest.py. Its\nledger showed four operator acts: an approval, two merges of main into the\nitem's branch made mid-run (8d4fd15, 19c384f), and the merge.\n\nRun: python3 -m pytest tests/test_attest_interventions.py -q\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nfrom pathlib import Path\nfrom typing import Any\n\nimport jsonschema\n\nfrom helpers import commit_all, git, make_tenant\nfrom test_attest import STATEMENT_SCHEMA, configure_forge, merge_into_main, run_attavo\nfrom test_attest_time import INVOCATIONS, attest, make_item, proof_six, seal\n\n\ndef traverse_with_a_transport(root: Path) -> str:\n    \"\"\"spec-gate and approve on the item's branch; then a person merges\n    main into it, as the operator did twice on #344; then build and\n    verify. Returns the sha of that transport merge.\"\"\"\n    git(root, \"checkout\", \"-b\", \"attavo/1-x\")\n    assert run_attavo(root, \"spec-gate\", \"1\").returncode == 0\n    commit_all(root, \"attavo: spec-gate record for #1\")\n    assert run_attavo(root, \"approve\", \"1\", \"--by\", \"alice\").returncode == 0\n    commit_all(root, \"attavo: approval record for #1\")\n    git(root, \"checkout\", \"main\")\n    (root / \"OTHER.md\").write_text(\"landed on main while the item was in flight\\n\")\n    commit_all(root, \"an unrelated change on main\")\n    git(root, \"checkout\", \"attavo/1-x\")\n    git(root, \"merge\", \"--no-ff\", \"-m\", \"Merge main into attavo/1-x\", \"main\")\n    transport = git(root, \"rev-parse\", \"HEAD\").strip()\n    assert run_attavo(root, \"build\", \"1\").returncode == 0\n    commit_all(root, \"attavo: build record for #1\")\n    assert run_attavo(root, \"verify\", \"1\").returncode == 0\n    commit_all(root, \"attavo: verify record for #1\")\n    merge_into_main(root, \"attavo/1-x\")\n    return transport\n\n\ndef test_a_transport_between_approval_and_merge_is_an_intervention(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"build_valid\")\n    configure_forge(root)\n    transport = traverse_with_a_transport(root)\n    run = run_attavo(root, \"attest\")\n    assert run.returncode == 0, run.stdout + run.stderr\n    statement = json.loads(run.stdout)\n    jsonschema.validate(statement, STATEMENT_SCHEMA)\n    interventions = statement[\"interventions\"]\n    assert any(i[\"sha\"] == transport and i[\"class\"] == \"transport\" for i in interventions), interventions\n    acts = {a[\"act\"] for a in statement[\"acts\"]}\n    assert {\"approve\", \"merge\"} <= acts, statement[\"acts\"]\n    assert all(row[\"sha\"] and row[\"by\"] and row[\"at\"] for row in statement[\"acts\"] + interventions)\n\n\ndef test_doctor_proof_six_recomputes_acts_and_interventions_for_a_v6_statement(\n        tmp_path: Path) -> None:\n    \"\"\"Proof six holds a true v6 statement's acts and interventions, the\n    same way it already holds time and cost, and fails one whose lists are\n    not what the item's own commits give, naming the field. make_item's\n    fixture carries no specs/ tree at all, so both lists are legitimately\n    `[]` here (item_ledger finds no first spec commit to walk from) --\n    declared explicitly as v6, since the heuristic that sniffs it from a\n    sha-bearing row has nothing to find in an empty list.\"\"\"\n    root, merge = make_item(tmp_path, INVOCATIONS)\n    statement = attest(root)\n    assert statement[\"acts\"] == [] and statement[\"interventions\"] == []\n    seal(root, merge, statement, \"https://attavo.dev/attestation/v6\")\n    held = proof_six(root)\n    assert held[\"holds\"] is True and held[\"sealed\"] == [\"1\"], held\n\n    forged_acts: dict[str, Any] = json.loads(json.dumps(statement))\n    forged_acts[\"acts\"] = [{\"act\": \"approve\", \"sha\": \"f\" * 40, \"by\": \"nobody\",\n                           \"at\": \"2026-01-01T00:00:00Z\"}]\n    seal(root, merge, forged_acts, \"https://attavo.dev/attestation/v6\")\n    failed = proof_six(root)\n    assert failed[\"holds\"] is False, failed\n    assert \"item 1\" in failed[\"reason\"] and \"acts\" in failed[\"reason\"], failed\n\n    forged_interventions: dict[str, Any] = json.loads(json.dumps(statement))\n    forged_interventions[\"interventions\"] = [\n        {\"class\": \"transport\", \"sha\": \"f\" * 40, \"by\": \"nobody\", \"at\": \"2026-01-01T00:00:00Z\"}]\n    seal(root, merge, forged_interventions, \"https://attavo.dev/attestation/v6\")\n    failed = proof_six(root)\n    assert failed[\"holds\"] is False, failed\n    assert \"item 1\" in failed[\"reason\"] and \"interventions\" in failed[\"reason\"], failed\n\n\ndef test_statement_carries_only_the_summed_accounting(tmp_path: Path) -> None:\n    \"\"\"#309, specimen #289: the screen read the three final-attempt fields\n    and showed $1.13 and ~14 minutes against a true $2.93 and ~26.5 minutes.\n    Two build attempts and one verify: the statement carries none of the\n    three fields, and time, cost and tokens are the sums over all three\n    records.\"\"\"\n    root, _ = make_item(tmp_path, [(\"build\", 1, 752.0, 1.8, \"alpha\"),\n                                   (\"build\", 2, 777.0, 1.13, \"alpha\"),\n                                   (\"verify\", 1, 58.0, None, \"alpha\")])\n    statement = attest(root)\n    jsonschema.validate(statement, SCHEMA)\n    for field in RETIRED:\n        assert field not in statement, field\n    assert statement[\"time\"][\"invocation_s\"] == 1587.0\n    assert statement[\"cost\"][\"usd\"] == 2.93\n    assert statement[\"tokens\"][\"build\"] == {\"input\": 3000, \"output\": 30, \"partial\": False}\n    assert statement[\"tokens\"][\"verify\"] == {\"input\": 500, \"output\": 5, \"partial\": False}\n    assert statement[\"tokens\"][\"counsel\"] == {\"input\": 0, \"output\": 0, \"partial\": False}\n    assert statement[\"tokens\"][\"input\"] == 3500 and statement[\"tokens\"][\"output\"] == 35\n    assert statement[\"tokens\"][\"partial\"] is False and statement[\"tokens\"][\"not_read\"] == []\n\n\ndef test_schema_is_v6_and_names_no_retired_field() -> None:\n    \"\"\"#309: the predicate type moved to v4 with the three fields gone; #307\n    moved it to v5, and #349 to v6; they stay gone.\"\"\"\n    assert SCHEMA[\"$id\"] == \"https://attavo.dev/attestation/v6\"\n    for field in RETIRED:\n        assert field not in SCHEMA[\"properties\"] and field not in SCHEMA[\"required\"]\n    assert \"tokens\" in SCHEMA[\"required\"]\n\n\ndef test_a_record_without_tokens_makes_tokens_partial_and_is_named(tmp_path: Path) -> None:\n    \"\"\"#309, as #289's verify-01 had no cost: a record with no tokens is\n    named in not_read and its sums are partial, never counted as zero.\"\"\"\n    root, _ = make_item(tmp_path, INVOCATIONS, tokenless=frozenset({\"build-02\"}))\n    tokens = attest(root)[\"tokens\"]\n    assert tokens[\"not_read\"] == [\"build-02\"]\n    assert tokens[\"partial\"] is True and tokens[\"build\"][\"partial\"] is True\n    assert tokens[\"verify\"][\"partial\"] is False\n    assert tokens[\"build\"][\"input\"] == 1000 + 3000\n    assert tokens[\"input\"] == 4000 + 500 + 1000 + 200\n\n\ndef test_doctor_proof_six_checks_tokens_of_a_v4_statement(tmp_path: Path) -> None:\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-A3gt0lm2' (errno=Operation not permitted)\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-1IQuhpax' (errno=Operation not permitted)\n attavo/attest.py                    |   15 +-\n attavo/doctor.py                    |   47 +-\n attavo/ledger.py                    |   76 ++-\n attest/records/349/approval-01.json |   10 +\n attest/records/349/build-01.json    |   51 ++\n attest/records/349/build-01.log     | 1157 +++++++++++++++++++++++++++++++++++\n attest/records/349/build-01.started |    7 +\n attest/records/349/build-02.started |    7 +\n attest/records/349/spec-01.json     |   28 +\n schema/attestation.schema.json      |   18 +-\n tests/test_attest.py                |    6 +\n tests/test_attest_interventions.py  |   92 +++\n tests/test_attest_time.py           |    6 +-\n 13 files changed, 1492 insertions(+), 28 deletions(-)\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-0zohh3KW' (errno=Operation not permitted)\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-I5Q85btu' (errno=Operation not permitted)\nM\tattavo/attest.py\nM\tattavo/doctor.py\nM\tattavo/ledger.py\nA\tattest/records/349/approval-01.json\nA\tattest/records/349/build-01.json\nA\tattest/records/349/build-01.log\nA\tattest/records/349/build-01.started\nA\tattest/records/349/build-02.started\nA\tattest/records/349/spec-01.json\nM\tschema/attestation.schema.json\nM\ttests/test_attest.py\nA\ttests/test_attest_interventions.py\nM\ttests/test_attest_time.py\n","exit_code":0,"status":"completed"}}

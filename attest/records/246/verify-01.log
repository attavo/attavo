ifier under it such as\\n<     path::name). The product never names a test directory or a file\\n<     pattern. None when it cannot be known -- no selector declared, or the\\n<     selector exits non-zero or outlasts its bound -- which the ratio\\n<     reports as not measured.\\\"\\\"\\\"\\n<     if not stub_dir.is_dir():\\n<         return frozenset()\\n<     if not select_command:\\n<         return None\\n<     tests: set[str] = set()\\n<     for f in sorted(stub_dir.rglob(\\\"*\\\")):\\n<         if not f.is_file() or f.name == \\\".removed\\\":\\n<             continue\\n<         rel = f.relative_to(stub_dir).as_posix()\\n<         code, out, _err, _timed_out = run_bounded(select_command, root, rel + \\\"\\\\n\\\",\\n<                                                   STUB_TEST_SELECT_TIMEOUT_S)\\n<         if code != 0:\\n<             return None\\n<         if any(line.strip().split(\\\"::\\\")[0] == rel for line in out.splitlines()):\\n<             tests.add(rel)\\n<     return frozenset(tests)\\n128,129c97\\n< def stub_ratio(diff_text: str, stub_dir: Path, excluded: tuple[str, ...],\\n<                tests: frozenset[str] | None = frozenset()) -> float | None:\\n---\\n> def stub_ratio(diff_text: str, stub_dir: Path, excluded: tuple[str, ...]) -> float | None:\\n136,142c104\\n<     measured, which is not 0.0.\\n< \\n<     The stub's own test files (tests, from stub_test_paths) are not\\n<     counted on either side: the build is expected to ship them as they\\n<     are, so copying them is not the build choosing the stub's code. None\\n<     for tests means the tests could not be told apart, and the ratio is\\n<     not measured.\\\"\\\"\\\"\\n---\\n>     measured, which is not 0.0.\\\"\\\"\\\"\\n145,146d106\\n<     if tests is None:\\n<         return None\\n162,163c122\\n<             if path is not None and (any(path == e or path.startswith(e + \\\"/\\\") for e in skipped)\\n<                                      or path in tests):\\n---\\n>             if path is not None and any(path == e or path.startswith(e + \\\"/\\\") for e in skipped):\\n275d233\\n<     select_command = (m.get(\\\"tests\\\") or {}).get(\\\"select\\\")\\n322,323c280\\n<             \\\"stub_ratio\\\": stub_ratio(diff_text, spec_dir / \\\"stub\\\", (specs_rel, records_rel),\\n<                                   stub_test_paths(root, spec_dir / \\\"stub\\\", select_command)),\\n---\\n>             \\\"stub_ratio\\\": stub_ratio(diff_text, spec_dir / \\\"stub\\\", (specs_rel, records_rel)),\\n454,455c411\\n<         \\\"stub_ratio\\\": stub_ratio(diff_text, spec_dir / \\\"stub\\\", (specs_rel, records_rel),\\n<                                   stub_test_paths(root, spec_dir / \\\"stub\\\", select_command)),\\n---\\n>         \\\"stub_ratio\\\": stub_ratio(diff_text, spec_dir / \\\"stub\\\", (specs_rel, records_rel)),\\n12c12\\n< from attavo.verify import stub_ratio, stub_test_paths\\n---\\n> from attavo.verify import stub_ratio\\n18d17\\n< SELECT_TESTS_DIR = \\\"select = \\\\\\\"grep '^tests/' || true\\\\\\\"\\\"\\n26,34d24\\n< def select_only_tests_dir(root: Path) -> None:\\n<     \\\"\\\"\\\"The fixture's selector is `cat`, which declares every path a test of\\n<     itself, so every stub file would be left out of the ratio. A selector\\n<     that selects only tests/ keeps built.txt counted, as it was.\\\"\\\"\\\"\\n<     manifest = root / \\\"attavo.toml\\\"\\n<     manifest.write_text(manifest.read_text().replace('select = \\\"cat\\\"', SELECT_TESTS_DIR))\\n<     commit_all(root, \\\"a selector that selects tests/ only\\\")\\n< \\n< \\n75d64\\n<     select_only_tests_dir(root)\\n96d84\\n<     select_only_tests_dir(root)\\n111,138d98\\n< \\n< \\n< def test_stub_ratio_leaves_out_the_stubs_test_files_on_both_sides(tmp_path: Path) -> None:\\n<     # #214 read 0.75 with its test file counted as code the build copied\\n<     s = stub(tmp_path, {\\\"pkg/a.py\\\": \\\"x = 1\\\\n\\\", \\\"tests/test_a.py\\\": \\\"def test_a():\\\\n    assert True\\\\n\\\"})\\n<     text = diff(\\\"pkg/a.py\\\", \\\"x = 1\\\", \\\"y = 2\\\") + diff(\\\"tests/test_a.py\\\", \\\"def test_a():\\\", \\\"    assert True\\\")\\n<     assert stub_ratio(text, s, EXCLUDED) == 0.75\\n<     assert stub_ratio(text, s, EXCLUDED, frozenset({\\\"tests/test_a.py\\\"})) == 0.5\\n<     assert stub_ratio(diff(\\\"tests/test_a.py\\\", \\\"def test_a():\\\"), s, EXCLUDED, frozenset({\\\"tests/test_a.py\\\"})) is None\\n< \\n< \\n< def test_stub_ratio_is_null_when_the_stubs_tests_cannot_be_told_apart(tmp_path: Path) -> None:\\n<     s = stub(tmp_path, {\\\"pkg/a.py\\\": \\\"x = 1\\\\n\\\"})\\n<     assert stub_ratio(diff(\\\"pkg/a.py\\\", \\\"x = 1\\\"), s, EXCLUDED, None) is None\\n< \\n< \\n< def test_stub_test_paths_are_the_stub_files_the_tenants_selector_selects_for_themselves(tmp_path: Path) -> None:\\n<     s = stub(tmp_path, {\\\"pkg/a.py\\\": \\\"x = 1\\\\n\\\", \\\"tests/test_a.py\\\": \\\"def test_a(): pass\\\\n\\\",\\n<                         \\\"tests/helpers.py\\\": \\\"\\\", \\\".removed\\\": \\\"pkg/gone.py\\\\n\\\"})\\n<     select = \\\"while read p; do case $p in tests/test_*) echo \\\\\\\"$p::test_a\\\\\\\";; *) echo tests;; esac; done\\\"\\n<     assert stub_test_paths(tmp_path, s, select) == frozenset({\\\"tests/test_a.py\\\"})\\n<     assert stub_test_paths(tmp_path, tmp_path / \\\"absent\\\", select) == frozenset()\\n< \\n< \\n< def test_stub_test_paths_are_unknown_without_a_selector_or_when_it_fails(tmp_path: Path) -> None:\\n<     s = stub(tmp_path, {\\\"tests/test_a.py\\\": \\\"def test_a(): pass\\\\n\\\"})\\n<     assert stub_test_paths(tmp_path, s, None) is None\\n<     assert stub_test_paths(tmp_path, s, \\\"exit 3\\\") is None\\n\\n\\ndef _signal_group(proc: \\\"subprocess.Popen[str]\\\", sig: int) -> None:\\n    try:\\n        os.killpg(proc.pid, sig)\\n    except ProcessLookupError:\\n        pass\\n\\n\\ndef run_bounded(command: str, root: Path, stdin: str, timeout_s: int | None\\n                ) -> tuple[int, str, str, bool]:\\n    \\\"\\\"\\\"(exit, stdout, stderr, timed_out) of `command` run through the shell\\n    from root. The command is its own process group's leader, so a run past\\n    timeout_s is ended with everything it started -- a test runner's\\n    workers and a shell's background jobs alike -- rather than only the\\n    shell, which would leave them holding the pipes and the machine. A run\\n    that outlasts its bound exits 124, as timeout(1) does.\\\"\\\"\\\"\\n    proc = subprocess.Popen(command, shell=True, cwd=str(root), stdin=subprocess.PIPE,\\n                            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,\\n                            start_new_session=True)\\n    try:\\n        out, err = proc.communicate(stdin, timeout=timeout_s)\\n    except subprocess.TimeoutExpired:\\n        _signal_group(proc, signal.SIGTERM)\\n        try:\\n            out, err = proc.communicate(timeout=END_GRACE_S)\\n        except subprocess.TimeoutExpired:\\n            _signal_group(proc, signal.SIGKILL)\\n            try:\\n                out, err = proc.communicate(timeout=END_GRACE_S)\\n            except subprocess.TimeoutExpired:\\n                # something the run started left its group and holds the pipes\\n                out, err = \\\"\\\", \\\"\\\"\\n        _signal_group(proc, signal.SIGKILL)\\n        return TIMED_OUT_EXIT, out, err, True\\n    _signal_group(proc, signal.SIGKILL)\",\"is_error\":false}]},\"parent_tool_use_id\":null,\"session_id\":\"60ea13b2-1eaa-4692-8da6-dd4de75f1c99\",\"uuid\":\"d9470d22-6082-4202-a5f9-a394d790525c\",\"timestamp\":\"2026-09-28T16:33:52.929Z\",\"tool_use_result\":{\"stdout\":\"attest/specs/246/spec.md\\nattest/specs/246/criteria/the-stubs-tests-are-left-out-of-the-ratio.sh\\nattest/specs/246/stub/tests/test_stub_ratio.py\\nattest/specs/246/stub/attavo/verify.py\\n21d20\\n< from attavo.testtool import run_bounded\\n96,125d94\\n< \\n< \\n< STUB_TEST_SELECT_TIMEOUT_S = 60\\n< \\n< \\n< def stub_t
(\"records/1/build-01.json\", \"{}\"), s, EXCLUDED) is None\nattest/records/208/build-01.log:18:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01S9zcX9u6iYr2umxB7izj2g\",\"type\":\"tool_result\",\"content\":\"\\\"\\\"\\\"verify's stub_ratio: whose code the review judged. On #194 and #204 the\\nbuild shipped the spec author's stub almost line for line and every record\\nsaid weak_stub false, stub_ratio null: three fields no release computed.\\n\\nRun: python3 -m pytest tests -q\\n\\\"\\\"\\\"\\nfrom __future__ import annotations\\n\\nimport json\\nfrom pathlib import Path\\n\\nfrom attavo.verify import stub_ratio\\nfrom helpers import git, make_tenant\\nfrom test_drive import GREEN_FORGE, add_bare_remote, add_forge, approve_item, latest_record, run_attavo\\n\\nROOT = Path(__file__).resolve().parent.parent\\nEXCLUDED = (\\\"specs\\\", \\\"records\\\")\\n\\n\\ndef diff(path: str, *added: str) -> str:\\n    body = \\\"\\\".join(f\\\"+{line}\\\\n\\\" for line in added)\\n    return f\\\"diff --git a/{path} b/{path}\\\\n--- a/{path}\\\\n+++ b/{path}\\\\n@@ -0,0 +1,{len(added)} @@\\\\n{body}\\\"\\n\\n\\ndef stub(tmp_path: Path, files: dict[str, str]) -> Path:\\n    root = tmp_path / \\\"stub\\\"\\n    for rel, text in files.items():\\n        (root / rel).parent.mkdir(parents=True, exist_ok=True)\\n        (root / rel).write_text(text)\\n    root.mkdir(exist_ok=True)\\n    return root\\n\\n\\ndef test_stub_ratio_is_one_when_every_added_line_is_the_stubs(tmp_path: Path) -> None:\\n    s = stub(tmp_path, {\\\"pkg/a.py\\\": \\\"def f():\\\\n    return 1\\\\n\\\"})\\n    assert stub_ratio(diff(\\\"pkg/a.py\\\", \\\"def f():\\\", \\\"    return 1\\\"), s, EXCLUDED) == 1.0\\n\\n\\ndef test_stub_ratio_is_the_share_across_files_and_ignores_blank_lines(tmp_path: Path) -> None:\\n    s = stub(tmp_path, {\\\"pkg/a.py\\\": \\\"def f():\\\\n    return 1\\\\n\\\"})\\n    text = diff(\\\"pkg/a.py\\\", \\\"def f():\\\", \\\"\\\", \\\"    return 2\\\") + diff(\\\"pkg/b.py\\\", \\\"x = 1\\\", \\\"y = 2\\\")\\n    assert stub_ratio(text, s, EXCLUDED) == 0.25\\n\\n\\ndef test_stub_ratio_matches_a_line_only_against_the_stubs_file_at_the_same_path(tmp_path: Path) -> None:\\n    s = stub(tmp_path, {\\\"pkg/a.py\\\": \\\"x = 1\\\\n\\\"})\\n    assert stub_ratio(diff(\\\"pkg/b.py\\\", \\\"x = 1\\\"), s, EXCLUDED) == 0.0\\n\\n\\ndef test_stub_ratio_does_not_count_the_specs_or_the_records_directory(tmp_path: Path) -> None:\\n    s = stub(tmp_path, {\\\"pkg/a.py\\\": \\\"x = 1\\\\n\\\"})\\n    text = diff(\\\"specs/1/stub/pkg/a.py\\\", \\\"x = 1\\\") + diff(\\\"records/1/build-01.json\\\", \\\"{}\\\") + diff(\\\"pkg/a.py\\\", \\\"x = 1\\\")\\n    assert stub_ratio(text, s, EXCLUDED) == 1.0\\n\\n\\ndef test_stub_ratio_is_null_with_no_stub_or_no_added_line_and_never_zero(tmp_path: Path) -> None:\\n    assert stub_ratio(diff(\\\"pkg/a.py\\\", \\\"x = 1\\\"), tmp_path / \\\"absent\\\", EXCLUDED) is None\\n    s = stub(tmp_path, {\\\"pkg/a.py\\\": \\\"x = 1\\\\n\\\"})\\n    assert stub_ratio(\\\"\\\", s, EXCLUDED) is None\\n    assert stub_ratio(diff(\\\"records/1/build-01.json\\\", \\\"{}\\\"), s, EXCLUDED) is None\\n\\n\\ndef test_verify_records_the_ratio_and_no_longer_carries_the_two_fields_nothing_computed(tmp_path: Path) -> None:\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    add_bare_remote(root, tmp_path)\\n    # on the item's own branch, as a real item is: the diff under review is\\n    # the branch's work against the default branch, and drive pushes as it goes\\n    git(root, \\\"checkout\\\", \\\"-q\\\", \\\"-b\\\", \\\"attavo/1-x\\\")\\n    approve_item(root)\\n    assert run_attavo(root, \\\"drive\\\", \\\"1\\\").returncode == 0\\n    assert run_attavo(root, \\\"drive\\\", \\\"1\\\").returncode == 0\\n    record = latest_record(root, \\\"verify\\\")\\n    assert record[\\\"stub_ratio\\\"] == 0.0, record[\\\"stub_ratio\\\"]\\n    assert \\\"weak_stub\\\" not in record and \\\"mutation\\\" not in record, sorted(record)\\n    schema = json.loads((ROOT / \\\"schema\\\" / \\\"records\\\" / \\\"verify.schema.json\\\").read_text())\\n    assert schema[\\\"$id\\\"].endswith(\\\"/verify/6\\\"), schema[\\\"$id\\\"]\\n    assert \\\"weak_stub\\\" not in schema[\\\"properties\\\"] and \\\"mutation\\\" not in schema[\\\"properties\\\"]\\n63,71d62\\n< def stub_ratio(diff_text: str, stub_dir: Path, excluded: tuple[str, ...]) -> float | None:\\n<     \\\"\\\"\\\"STUB, not the implementation and not to be shipped: it answers 0.0\\n<     whenever the spec carries a stub and never reads the diff, so the\\n<     criteria can be shown to run. tests/test_stub_ratio.py fails on it by\\n<     design; the build computes the share of the diff's added lines that are\\n<     the stub's line at the same path.\\\"\\\"\\\"\\n<     return 0.0 if stub_dir.is_dir() else None\\n< \\n< \\n159c150\\n<             \\\"stub_ratio\\\": None,\\n---\\n>             \\\"mutation\\\": None, \\\"weak_stub\\\": False, \\\"stub_ratio\\\": None,\\n266c257\\n<         \\\"stub_ratio\\\": stub_ratio(diff_text, spec_dir / \\\"stub\\\", (specs_rel, m[\\\"paths\\\"][\\\"records\\\"])),\\n---\\n>         \\\"mutation\\\": None, \\\"weak_stub\\\": False, \\\"stub_ratio\\\": None,\\n104a105,106\\n>     mutation: dict[str, Any] | None\\n>     weak_stub: bool\\n3c3\\n<   \\\"$id\\\": \\\"https://attavo.dev/schema/records/verify/6\\\",\\n---\\n>   \\\"$id\\\": \\\"https://attavo.dev/schema/records/verify/5\\\",\\n10,11c10,11\\n<     \\\"forge_checks\\\", \\\"findings\\\", \\\"tests_named\\\", \\\"commits\\\",\\n<     \\\"stub_ratio\\\", \\\"tokens\\\", \\\"cost_usd\\\", \\\"wall_clock_s\\\", \\\"status\\\",\\n---\\n>     \\\"forge_checks\\\", \\\"findings\\\", \\\"tests_named\\\", \\\"commits\\\", \\\"mutation\\\",\\n>     \\\"weak_stub\\\", \\\"stub_ratio\\\", \\\"tokens\\\", \\\"cost_usd\\\", \\\"wall_clock_s\\\", \\\"status\\\",\\n81,83c81,89\\n<     \\\"stub_ratio\\\": {\\n<       \\\"type\\\": [\\\"number\\\", \\\"null\\\"], \\\"minimum\\\": 0, \\\"maximum\\\": 1,\\n<       \\\"description\\\": \\\"The share of the lines the item's diff adds (outside the specs and records directories, blank lines aside) that are a line of the spec's stub at the same path. Near 1 the build shipped the stub; near 0 the builder wrote the change. Null when the spec carries no stub or the diff adds no counted line. Version 5 carried two further fields that no release ever computed; they are gone.\\\"\\n---\\n>     \\\"mutation\\\": {\\n>       \\\"type\\\": [\\\"object\\\", \\\"null\\\"],\\n>       \\\"additionalProperties\\\": false,\\n>       \\\"required\\\": [\\\"command\\\", \\\"score\\\", \\\"modules\\\"],\\n>       \\\"properties\\\": {\\n>         \\\"command\\\": {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1},\\n>         \\\"score\\\": {\\\"type\\\": \\\"number\\\", \\\"minimum\\\": 0, \\\"maximum\\\": 1},\\n>         \\\"modules\\\": {\\\"type\\\": \\\"array\\\", \\\"items\\\": {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1}}\\n>       }\\n84a91,92\\n>     \\\"weak_stub\\\": {\\\"type\\\": \\\"boolean\\\"},\\n>     \\\"stub_ratio\\\": {\\\"type\\\": [\\\"number\\\", \\\"null\\\"]},\\n249,281d248\\n< \\n< \\n< def test_doctor_rejects_null_time_without_cost(tmp_path: Path) -> None:\\n<     \\\"\\\"\\\"#204's review: `\\\"time\\\": null` with no cost read as a statement sealed\\n<     before the accounting existed, and was not checked at all.\\\"\\\"\\\"\\n<     root, merge = make_item(tmp_path, INVOCATIONS)\\n<     statement = attest(root)\\n<     statement[\\\"time\\\"] = None\\n<     del statement[\\\"cost\\\"]\\n<     seal(root, merge, statement)\\n<     failed = proof_six(root)\\n<     assert failed[\\\"holds\\\"] is False, failed\\n<     assert \\\"item 1\\\" in failed[\\\"reason\\\"] and \\\"time\\\" in failed[\\\"reason\\\"], failed\\n< \\n<     statement[\\\"cost\\\"] = None\\n<     seal(root, merge, statement)\\n<     assert proof_six(root)[\\\"holds\\\"] is False, \\\"both blocks null is carried, not absent\\\"\\n< \\n< \\n< def test_doctor_rejects_large_integer_that_rounds_to_summed_float(tmp_path: Path) -> None:\\n<     \\\"\\\"\\\"#204's review: both sides were converted to float, so an integer one\\n<     past 2**53 equalled the float beside it.\\\"\\\"\\\"\\n<     big = 9007199254740992.0\\n<     root, merge = make_item(tmp_path, [(\\\"build\\\", 1, big, 0.25, \\\"alpha\\\"), (\\\"verify\\\", 1, 0.0, None, \\\"beta\\\")])\\n<     statement = attest(root)\\n<     assert statement[\\\"time\\\"][\\\"build\\\"][\\\"invocation_s\\\"] == big\\n<     seal(root, merge, statement)\\n<     assert proof_six(root)[\\\"holds\\\"] is True\\n<     statement[\\\"time\\\"][\\\"build\\\"][\\\"invocation_s\\\"] = 9007199254740993\\n<     seal(root, merge, statement)\\n<     failed = proof_six(root)\\n<     assert failed[\\\"holds\\\"] is False, failed\\n<     assert \\\"item 1\\\" in failed[\\\"reason\\\"] and \\\"time.build\\\" in failed[\\\"reason\\\"], failed\\n48c48\\n<         \\\"stub_ratio\\\": None,\\n---\\n>         \\\"mutation\\\": None, \\\"weak_stub\\\": False, \\\"stub_ratio\\\": None,\",\"is_error\":false}]},\"parent_tool_use_id\":null,\"session_id\":\"ddda30aa-ff57-411f-acdd-b09e05ffc0c2\",\"uuid\":\"ba9984e5-3045-460b-ba3c-d56fb7032632\",\"timestamp\":\"2026-09-20T21:38:43.656Z\",\"tool_use_result\":{\"stdout\":\"\\\"\\\"\\\"verify's stub_ratio: whose code the review judged. On #194 and #204 the\\nbuild shipped the spec author's stub almost line for line and every record\\nsaid weak_stub false, stub_ratio null: three fields no release computed.\\n\\nRun: python3 -m pytest tests -q\\n\\\"\\\"\\\"\\nfrom __future__ import annotations\\n\\nimport json\\nfrom pathlib import Path\\n\\nfrom attavo.verify import stub_ratio\\nfrom helpers import git, make_tenant\\nfrom test_drive import GREEN_FORGE, add_bare_remote, add_forge, approve_item, latest_record, run_attavo\\n\\nROOT = Path(__file__).reso
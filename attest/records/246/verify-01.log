\\\\\\", \\\\\\\"--absolute-git-dir\\\\\\\").strip())\\\\n54\\\\t\\\\n55\\\\t\\\\n56\\\\tdef report(root: Path) -> dict[str, Any]:\\\\n57\\\\t    run = run_attavo(root, \\\\\\\"drive\\\\\\\", \\\\\\\"1\\\\\\\", \\\\\\\"--report\\\\\\\", env=FAST)\\\\n58\\\\t    assert run.returncode == 0, run.stdout + run.stderr\\\\n59\\\\t    out: dict[str, Any] = json.loads(run.stdout)\\\\n60\\\\t    return out\\\\n61\\\\t\\\\n62\\\\t\\\\n63\\\\tdef pushed(bare: Path, subject: str) -> bool:\\\\n64\\\\t    log = subprocess.run([\\\\\\\"git\\\\\\\", \\\\\\\"-C\\\\\\\", str(bare), \\\\\\\"log\\\\\\\", \\\\\\\"--format=%s\\\\\\\", \\\\\\\"main\\\\\\\"], capture_output=True, text=True).stdout\\\\n65\\\\t    return subject in log\\\\n66\\\\t\\\\n67\\\\t\\\\n68\\\\tdef wait_for(pred: Any, seconds: float = 20) -> None:\\\\n69\\\\t    deadline = time.monotonic() + seconds\\\\n70\\\\t    while time.monotonic() < deadline:\\\\n71\\\\t        if pred():\\\\n72\\\\t            return\\\\n73\\\\t        time.sleep(0.2)\\\\n74\\\\t    raise AssertionError(\\\\\\\"condition not met in time\\\\\\\")\\\\n75\\\\t\\\\n76\\\\t\\\\n77\\\\tdef built_tenant(tmp_path: Path, seconds: float = 3) -> tuple[Path, Path]:\\\\n78\\\\t    root = make_tenant(tmp_path, \\\\\\\"build_valid\\\\\\\")\\\\n79\\\\t    add_forge(root, GREEN_FORGE)\\\\n80\\\\t    add_drive_stall_bound(root)\\\\n81\\\\t    slow_adapter(root, seconds)\\\\n82\\\\t    bare = add_bare_remote(root, tmp_path)\\\\n83\\\\t    approve_item(root)\\\\n84\\\\t    return root, bare\\\\n85\\\\t\\\\n86\\\\t\\\\n87\\\\tdef test_a_pass_returns_while_the_worker_runs_and_the_worker_outlives_it(tmp_path: Path) -> None:\\\\n88\\\\t    root, bare = built_tenant(tmp_path, seconds=3)\\\\n89\\\\t    started = time.monotonic()\\\\n90\\\\t    run = run_attavo(root, \\\\\\\"drive\\\\\\\", \\\\\\\"1\\\\\\\", env=FAST)\\\\n91\\\\t    elapsed = time.monotonic() - started\\\\n92\\\\t    assert run.returncode == 0, run.stdout + run.stderr\\\\n93\\\\t    assert elapsed < 2.5
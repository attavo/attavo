(root, tmp_path)\n     git(root, \"checkout\", \"-q\", \"-b\", \"attavo/1-x\")\n@@ -96,3 +108,31 @@ def test_a_returned_review_carries_the_ratio_too(tmp_path: Path) -> None:\n     record = latest_record(root, \"verify\")\n     assert record[\"status\"] == \"returned\", record[\"status\"]\n     assert record[\"stub_ratio\"] == 1.0, record[\"stub_ratio\"]\n+\n+\n+def test_stub_ratio_leaves_out_the_stubs_test_files_on_both_sides(tmp_path: Path) -> None:\n+    # #214 read 0.75 with its test file counted as code the build copied\n+    s = stub(tmp_path, {\"pkg/a.py\": \"x = 1\\n\", \"tests/test_a.py\": \"def test_a():\\n    assert True\\n\"})\n+    text = diff(\"pkg/a.py\", \"x = 1\", \"y = 2\") + diff(\"tests/test_a.py\", \"def test_a():\", \"    assert True\")\n+    assert stub_ratio(text, s, EXCLUDED) == 0.75\n+    assert stub_ratio(text, s, EXCLUDED, frozenset({\"tests/test_a.py\"})) == 0.5\n+    assert stub_ratio(diff(\"tests/test_a.py\", \"def test_a():\"), s, EXCLUDED, frozenset({\"tests/test_a.py\"})) is None\n+\n+\n+def test_stub_ratio_is_null_when_the_stubs_tests_cannot_be_told_apart(tmp_path: Path) -> None:\n+    s = stub(tmp_path, {\"pkg/a.py\": \"x = 1\\n\"})\n+    assert stub_ratio(diff(\"pkg/a.py\", \"x = 1\"), s, EXCLUDED, None) is None\n+\n+\n+def test_stub_test_paths_are_the_stub_files_the_tenants_selector_selects_for_themselves(tmp_path: Path) -> None:\n+    s = stub(tmp_path, {\"pkg/a.py\": \"x = 1\\n\", \"tests/test_a.py\": \"def test_a(): pass\\n\",\n+                        \"tests/helpers.py\": \"\", \".removed\": \"pkg/gone.py\\n\"})\n+    select = \"while read p; do case $p in tests/test_*) echo \\\"$p::test_a\\\";; *) echo tests;; esac; done\"\n+    assert stub_test_paths(tmp_path, s, select) == frozenset({\"tests/test_a.py\"})\n+    assert stub_test_paths(tmp_path, tmp_path / \"absent\", select) == frozenset()\n+\n+\n+def test_stub_test_paths_are_unknown_without_a_selector_or_when_it_fails(tmp_path: Path) -> None:\n+    s = stub(tmp_path, {\"tests/test_a.py\": \"def test_a(): pass\\n\"})\n+    assert stub_test_paths(tmp_path, s, None) is None\n+    assert stub_test_paths(tmp_path, s, \"exit 3\") is None\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-ka8jDU9n' (errno=Operation not permitted)\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-2aPEm4i2' (errno=Operation not permitted)\n6580f80 spec for #246: the stub ratio leaves out the stub's tests\n .../the-stubs-tests-are-left-out-of-the-ratio.sh   |  32 ++\n attest/specs/246/spec.md                           |  39 ++\n attest/specs/246/stub/attavo/verify.py             | 524 +++++++++++++++++++++\n attest/specs/246/stub/tests/test_stub_ratio.py     | 138 ++++++\n 4 files changed, 733 insertions(+)\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-Ek7BGCuI' (errno=Operation not permitted)\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-xQeKxHZq' (errno=Operation not permitted)\n attest/records/246/spec-01.json | 19 +++++++++++++++++++\n 1 file changed, 19 insertions(+)\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_3","type":"agent_message","text":"{\"findings\":[{\"title\":\"Core implementation matches the requested data flow so far\",\"specimen\":\"attavo/verify.py\",\"retires\":\"Concern that only one verification-record write site was updated\",\"rejection_test\":\"A command-level test should exercise both the returned-review and completed-review paths and assert each records the ratio using discovered stub test paths.\",\"severity\":\"Progress update; final severity pending complete review\"}],\"tests_named\":[\"test_verify_records_the_ratio_and_no_longer_carries_the_two_fields_nothing_computed\",\"test_a_returned_review_carries_the_ratio_too\"]}"}}
{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc 'cmp -s attavo/verify.py attest/specs/246/stub/attavo/verify.py; echo verify_cmp=$?; cmp -s tests/test_stub_ratio.py attest/specs/246/stub/tests/test_stub_ratio.py; echo tests_cmp=$?; sed -n '\"'1,220p' attest/specs/246/spec.md; sed -n '1,180p' attavo/testtool.py; rg \\\"stub_ratio\\\\(\\\" -n; git log --oneline --decorate -8\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc 'cmp -s attavo/verify.py attest/specs/246/stub/attavo/verify.py; echo verify_cmp=$?; cmp -s tests/test_stub_ratio.py attest/specs/246/stub/tests/test_stub_ratio.py; echo tests_cmp=$?; sed -n '\"'1,220p' attest/specs/246/spec.md; sed -n '1,180p' attavo/testtool.py; rg \\\"stub_ratio\\\\(\\\" -n; git log --oneline --decorate -8\"","aggregated_output":"verify_cmp=0\ntests_cmp=0\n## Problem\n\nClass: fix\n\nThe stub ratio is the share of the lines a build adds that are lines of the spec's stub at the same path. It exists to say whether the build wrote the change or shipped the spec author's prototype. It counts the stub's own test files, and a build is expected to ship those as they are: they are the item's red tests, carried into the tree. Every item whose stub carries tests reads high for a reason that says nothing about who wrote the code. Readings recomputed from the recorded diffs with this repository's selector (read on `dae6d76`; the selector and `stub_ratio` are unchanged on `3f1bd57`):\n\n| item | recorded | today's function | with this change | test files left out |\n|---|---|---|---|---|\n| #206 | null (before the ratio) | 0.652 | 0.466 | `tests/test_report.py`, `tests/test_types_mirror_schemas.py` |\n| #214 | 0.75 | 0.75 | 0.286 | `tests/test_stub_ratio.py`, `tests/test_testtool.py` |\n| #217 | 0.546 | 0.546 | 0.218 | `tests/test_drive.py`, `tests/test_pass.py` |\n| #224 | 0.926 | 0.926 | 0.859 | four test files |\n\nThe recomputed column matches every recorded value, so the reconstruction is the record's. #224 stays high with its tests left out because its stub was the change, which is the reading the ratio is for.\n\nThe product must not name a test directory or a file pattern: a tenant says what a test is through `[tests].select`. A stub file is a test when the tenant's selector, given that path alone, selects it: the path itself, or an identifier under it such as `path::name`. This repository's selector does exactly that for `tests/test_*.py` and answers `tests` (the whole suite) for anything else, including `tests/helpers.py`, which is therefore counted as code. Checked in the session on `dae6d76`: `attavo/verify.py` selects three test files and not itself; `tests/test_stub_ratio.py` selects itself; `README.md` selects nothing.\n\nThis item adds `stub_test_paths(root, stub_dir, select_command)`, which runs the selector once per stub file (bounded at 60 s each, through `run_bounded`), and gives `stub_ratio` a `tests` argument whose paths are left out on both sides of the ratio, as the specs and records directories already are. When the tests cannot be told apart (no `[tests].select`, or the selector exits non-zero or times out) the ratio is null: not measured, which is not a number. Both write sites in `cmd_verify` pass the stub's test paths.\n\nThe 2026-09-25 bridge ruling says the stub's tests are excluded from the ratio's numerator. This spec leaves them out of both sides. Left out of the numerator alone, the shipped tests would still count in the denominator as lines the build wrote, and the ratio would understate the build's copying by the size of the test files. That is a reading of the ruling, stated for the operator to confirm at approval.\n\nTwo fixture corrections. The fixture tenant's selector is `cat`, which declares every path a test of itself. Under this change every file in its stub is left out and the ratio reads null. `tests/test_stub_ratio.py`'s two verify tests now set a selector that selects only `tests/` before they run, and they assert what they asserted before (0.0 and 1.0).\n\nNot in this item, split on 2026-09-27: freezing the stub's test bodies so a build cannot weaken a red test. Which unit is frozen (file or test function) and how a tenant-generic product finds a test body is a design question, so it is an item of its own, proposed core. Also not here: a record field naming the files left out (a schema bump for a value a re-run reproduces), and tenant zero, which files no new items and whose ratio is computed only at verify.\n\nThe stub under `stub/` is the change: `attavo/verify.py` and `tests/test_stub_ratio.py`, four tests red on `3f1bd57`. `python3 -m mypy` exits 0 on the stub, and the full suite passes on it.\n\nSequencing, from the Plan frontier: nothing in flight claims `attavo/verify.py` or `tests/test_stub_ratio.py`. #229 (merged) made a build pass only on committed work; this item's merge block still checks that the branch carries `stub_test_paths` before it merges.\n\nRetires: the stub's red tests read as prototype code the build chose to copy; #214's 0.75 and #217's 0.546 as readings of anchoring.\n\n## Claims\n\n- attavo/verify.py\n- tests/test_stub_ratio.py\n\n## Criteria\n\n- the-stubs-tests-are-left-out-of-the-ratio.sh: with a stub of one module and one test file and a selector that selects `tests/test_*` for themselves, `stub_test_paths` answers the test file alone; the ratio over a diff adding both files at the stub's lines plus one line of the builder's is 0.5 with the tests left out; it is null when the tests cannot be told apart, with no selector, or with a selector that exits 3; and `tests/test_stub_ratio.py` carries the four tests named\nfrom __future__ import annotations\n\nimport os\nimport signal\nimport subprocess\nimport sys\nfrom pathlib import Path\nfrom typing import Any\n\nfrom attavo.common import MANIFEST, derive_item_id, git, read_manifest\n\n# --- test: the executor's one test command (issue #212) --\n# The tests [tests].select names for every path the item has changed since\n# it left the default branch, run through [tests].run, bounded by\n# [tests].call_timeout_s. The executor is given this and not the tenant's\n# whole-tree checks: given a checks command it ran it (#194's 590 s wait;\n# #204 and #206 ran the suite twice inside one build), and the gate runs\n# them after every commit whatever the executor does. ---\n\nTIMED_OUT_EXIT = 124\n\n# What an ended run is given to leave on its own after SIGTERM, before its\n# whole process group is sent SIGKILL.\nEND_GRACE_S = 2\n\n\ndef _signal_group(proc: \"subprocess.Popen[str]\", sig: int) -> None:\n    try:\n        os.killpg(proc.pid, sig)\n    except ProcessLookupError:\n        pass\n\n\ndef run_bounded(command: str, root: Path, stdin: str, timeout_s: int | None\n                ) -> tuple[int, str, str, bool]:\n    \"\"\"(exit, stdout, stderr, timed_out) of `command` run through the shell\n    from root. The command is its own process group's leader, so a run past\n    timeout_s is ended with everything it started -- a test runner's\n    workers and a shell's background jobs alike -- rather than only the\n    shell, which would leave them holding the pipes and the machine. A run\n    that outlasts its bound exits 124, as timeout(1) does.\"\"\"\n    proc = subprocess.Popen(command, shell=True, cwd=str(root), stdin=subprocess.PIPE,\n                            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,\n                            start_new_session=True)\n    try:\n        out, err = proc.communicate(stdin, timeout=timeout_s)\n    except subprocess.TimeoutExpired:\n        _signal_group(proc, signal.SIGTERM)\n        try:\n            out, err = proc.communicate(timeout=END_GRACE_S)\n        except subprocess.TimeoutExpired:\n            _signal_group(proc, signal.SIGKILL)\n            try:\n                out, err = proc.communicate(timeout=END_GRACE_S)\n            except subprocess.TimeoutExpired:\n                # something the run started left its group and holds the pipes\n                out, err = \"\", \"\"\n        _signal_group(proc, signal.SIGKILL)\n        return TIMED_OUT_EXIT, out, err, True\n    _signal_group(proc, signal.SIGKILL)\n    return proc.returncode, out, err, False\n\n\ndef without_records(paths: list[str], records_rel: str) -> list[str]:\n    \"\"\"paths other than paths.records itself and what is under it -- the\n    records directory is where the product writes, not the item's work.\"\"\"\n    prefix = records_rel.rstrip(\"/\") + \"/\"\n    return [p for p in paths if p and p != records_rel and not p.startswith(prefix)]\n\n\ndef changed_since_default_branch(root: Path, records_rel: str) -> list[str]:\n    \"\"\"Every path the item has changed since it left the default branch,\n    committed or not: tracked paths whose content differs from the\n    merge-base with what refs/remotes/origin/HEAD names -- deleted and\n    renamed-from paths included, staged or not -- and untracked paths that\n    are not ignored. Sorted; the records directory left aside.\n    RuntimeError when the default branch cannot be named.\"\"\"\n    default = git(root, \"symbolic-ref\", \"-q\", \"refs/remotes/origin/HEAD\").strip()\n    base = git(root, \"merge-base\", default, \"HEAD\").strip()\n    tracked = git(root, \"diff\", \"--name-only\", \"--no-renames\", \"-z\", base).split(\"\\0\")\n    untracked = git(root, \"ls-files\", \"--others\", \"--exclude-standard\", \"-z\").split(\"\\0\")\n    return sorted(set(without_records(tracked + untracked, records_rel)))\n\n\ndef _fingerprint(root: Path) -> str:\n    \"\"\"What the tree is right now: HEAD, the tracked diff against it, and\n    every untracked, unignored file's name and content hash.\"\"\"\n    import hashlib\n    h = hashlib.sha256()\n    h.update(git(root, \"rev-parse\", \"HEAD\").encode())\n    h.update(git(root, \"diff\", \"HEAD\", \"--no-color\").encode())\n    for name in git(root, \"ls-files\", \"--others\", \"--exclude-standard\", \"-z\").split(\"\\0\"):\n        if not name:\n            continue\n        h.update(name.encode() + b\"\\0\")\n        try:\n            h.update(hashlib.sha256((root / name).read_bytes()).digest())\n        except OSError:\n            pass\n    return h.hexdigest()\n\n\ndef _cache_path(root: Path) -> Path:\n    from attavo.events import stage_events_dir\n    return stage_events_dir(root) / \"test-cache.json\"\n\n\ndef _event(text: str) -> None:\n    events = os.environ.get(\"ATTAVO_EVENTS\")\n    if events:\n        from attavo.events import append_event\n        append_event(Path(events), \"test\", text)\n\n\ndef cmd_test(argv: list[str]) -> int:\n    root = Path(\".\").resolve()\n    flags = {\"--all\", \"--fresh\"}\n    positional = [a for a in argv if a not in flags]\n    whole, fresh = \"--all\" in argv, \"--fresh\" in argv\n    item_id = positional[0] if positional else derive_item_id(root)\n    named = positional[1:]\n    if not item_id:\n        print(\"attavo test: cannot derive item id; pass N or run on an attavo/N-* branch\",\n              file=sys.stderr)\n        return 2\n    m = read_manifest(root)\n    if m is None:\n        print(f\"attavo test: no {MANIFEST} at {root}\", file=sys.stderr)\n        return 2\n    tests_cfg: dict[str, Any] = m.get(\"tests\") or {}\n    if not tests_cfg.get(\"select\") or not tests_cfg.get(\"run\"):\n        print(\"attavo test: no [tests] table in the manifest \"\n              \"([tests].select and [tests].run are both required)\", file=sys.stderr)\n        return 2\n    import json\n    import time\n    if named and whole:\n        print(\"attavo test: name tests or pass --all, not both\", file=sys.stderr)\n        return 2\n    if named:\n        mode, identifiers = \"named\", named\n    elif whole:\n        mode, identifiers = \"all\", [\"tests\"]\n    else:\n        mode = \"mapped\"\n        try:\n            changed = changed_since_default_branch(root, m[\"paths\"][\"records\"])\n        except RuntimeError as exc:\n            print(f\"attavo test: cannot name what item {item_id} has changed: {exc}; \"\n                  \"run `git remote set-head origin -a`\", file=sys.stderr)\n            return 2\n        select_run = subprocess.run(tests_cfg[\"select\"], shell=True, cwd=str(root),\n                                    input=\"\".join(p + \"\\n\" for p in changed),\n                                    capture_output=True, text=True, check=False)\n        if select_run.returncode != 0:\n            # Nothing selected because the selector failed is not nothing to run.\n            sys.stderr.write(select_run.stderr)\n            print(f\"attavo test: [tests].select exited {select_run.returncode}; nothing was run\",\n                  file=sys.stderr)\n            return 2\n        identifiers = [line for line in select_run.stdout.splitlines() if line.strip()]\n        if not identifiers:\n            print(f\"attavo test {item_id}: no test is selected for the {len(changed)} \"\n                  \"path(s) changed since the default branch\")\n            _event(f\"attavo test {item_id}: mode mapped, 0 selected, exit 0, 0 s\")\n            return 0\n\n    inside = bool(os.environ.get(\"ATTAVO_STAGE\"))\n    excluded = [x for x in (tests_cfg.get(\"exclude_in_executor\") or []) if x in identifiers] if inside else []\n    if excluded:\n        identifiers = [i for i in identifiers if i not in excluded]\n        print(f\"attavo test {item_id}: left out inside an executor: {', '.join(excluded)}\")\n\n    key = _fingerprint(root) + \"|\" + mode + \"|\" + \"\\n\".join(identifiers)\n    cache_file = _cache_path(root)\n    cache: dict[str, Any] = {}\n    if cache_file.is_file():\n        try:\n            cache = json.loads(cache_file.read_text())\n        except ValueError:\nattavo/verify.py:128:def stub_ratio(diff_text: str, stub_dir: Path, excluded: tuple[str, ...],\nattavo/verify.py:322:            \"stub_ratio\": stub_ratio(diff_text, spec_dir / \"stub\", (specs_rel, records_rel),\nattavo/verify.py:454:        \"stub_ratio\": stub_ratio(diff_text, spec_dir / \"stub\", (specs_rel, records_rel),\nattest/specs/217/stub/attavo/verify.py:89:def stub_ratio(diff_text: str, stub_dir: Path, excluded: tuple[str, ...]) -> float | None:\nattest/specs/217/stub/attavo/verify.py:204:            \"stub_ratio\": stub_ratio(diff_text, spec_dir / \"stub\", (spec
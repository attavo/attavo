d\\\"\\n+    assert git(bare, \\\"rev-parse\\\", branch).strip() == before, \\\"the pass pushed\\\"\\n+    commit_approval(root)\\n+    assert (report(root)[\\\"state\\\"], report(root)[\\\"kind\\\"]) == (\\\"next-build\\\", \\\"acts\\\")\\n=== test_spec_gate ===\\n--- tests/test_spec_gate.py\\t2026-09-27 07:38:18\\n+++ attest/specs/227/stub/tests/test_spec_gate.py\\t2026-09-27 07:38:18\\n@@ -13,7 +13,7 @@\\n from pathlib import Path\\n from typing import Any, cast\\n \\n-from helpers import commit_all, git, make_tenant\\n+from helpers import commit_all, commit_approval, git, make_tenant\\n \\n ROOT = Path(__file__).resolve().parent.parent\\n ATTAVO = ROOT / \\\"bin\\\" / \\\"attavo\\\"\\n@@ -105,6 +105,7 @@\\n def approve_valid(root: Path) -> None:\\n     assert run_attavo(root, \\\"spec-gate\\\", \\\"1\\\").returncode == 0\\n     assert run_attavo(root, \\\"approve\\\", \\\"1\\\", \\\"--by\\\", \\\"alice\\\").returncode == 0\\n+    commit_approval(root)\\n \\n \\n def complete_the_build(root: Path) -> None:\\n@@ -414,7 +415,7 @@\\n     \\\"\\\"\\\"\\n     root = make_tenant(tmp_path, \\\"valid\\\")\\n     approve_valid(root)\\n-    approval_sha = git(root, \\\"rev-parse\\\", \\\"HEAD\\\").strip()\\n+    approval_sha = latest_record(root, \\\"1\\\", \\\"approval\\\")[\\\"sha\\\"]\\n     write_build_record(root, \\\"1\\\", sha=approval_sha, status=\\\"halted\\\")\\n \\n     amend_problem(root)\\n=== test_verify ===\\n--- tests/test_verify.py\\t2026-09-27 07:38:18\\n+++ attest/specs/227/stub/tests/test_verify.py\\t2026-09-27 07:38:18\\n@@ -15,7 +15,7 @@\\n from pathlib import Path\\n from typing import Any, cast\\n \\n-from helpers import commit_all, git, make_tenant\\n+from helpers import commit_all, commit_approval, git, make_tenant\\n \\n ROOT = Path(__file__).resolve().parent.parent\\n ATTAVO = ROOT / \\\"bin\\\" / \\\"attavo\\\"\\n@@ -43,6 +43,7 @@\\n def approve_item(root: Path, item: str = \\\"1\\\") -> None:\\n     assert run_attavo(root, \\\"spec-gate\\\", i
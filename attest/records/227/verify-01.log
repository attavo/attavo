                     \"Waiting on you: the approval expired because the spec changed after it; \"\n-                     \"approve the spec again\")\n+        if why == \"absent\":\n+            r[\"says\"] = \"Waiting on you: approve the spec\"\n+        elif why == \"uncommitted\":\n+            r[\"says\"] = (\"Waiting on you: the approval record is not committed; commit \"\n+                         f\"{m['paths']['records']}/{item_id}/approval-NN.json to the item's branch \"\n+                         \"before anything runs on it\")\n+        else:\n+            r[\"says\"] = (\"Waiting on you: the approval expired because the spec changed after it; \"\n+                         \"approve the spec again\")\n         return r\n \n     pending = _pending(root, m, records_dir, r)\ndiff --git a/tests/helpers.py b/tests/helpers.py\nindex 9aa88cd..ff04482 100644\n--- a/tests/helpers.py\n+++ b/tests/helpers.py\n@@ -150,3 +150,14 @@ def extract_step_run(yaml_text: str, step_name: str) -> str:\n             block_indent = indent\n         block.append(line[block_indent:])\n     return \"\\n\".join(block).rstrip(\"\\n\")\n+\n+\n+def commit_approval(root: Path, item: str = \"1\", records_rel: str = \"records\") -> None:\n+    \"\"\"Commit the item's approval record(s) and nothing else -- the shape\n+    the tenant's approve workflow gives an approval in production, where\n+    the record is always a commit on the item's branch. A stage refuses an\n+    approval that is only in the working tree.\"\"\"\n+    paths = sorted(str(p.relative_to(root)) for p in (root / records_rel / item).glob(\"approval-*.json\"))\n+    assert paths, f\"no approval record under {records_rel}/{item}\"\n+    git(root, \"add\", *paths)\n+    git(root, \"commit\", \"-q\", \"--only\", *paths, \"-m\", f\"attavo: approval record for item {item}\")\ndiff --git a/tests/test_approve.py b/tests/test_approve.py\nindex a096ba8..540cd32 100644\n--- a/tests/test_approve.py\n+++ b/tests/test_approve.py\n@@ -13,7 +13,7 @@ import sys\n from pathlib import Path\n from typing import Any\n \n-from helpers import clone_shallow, commit_all, make_tenant\n+from helpers import clone_shallow, commit_all, commit_approval, make_tenant\n \n ROOT = Path(__file__).resolve().parent.parent\n ATTAVO = ROOT / \"bin\" / \"attavo\"\n@@ -71,6 +71,7 @@ def test_amendment_above_line_costs_one_act(tmp_path: Path) -> None:\n \n     assert run_attavo(root, \"spec-gate\", \"1\").returncode == 0\n     assert run_attavo(root, \"approve\", \"1\", \"--by\", \"alice\").returncode == 0\n+    commit_approval(root)\n     assert run_attavo(root, \"approval-status\", \"1\").stdout.strip() == \"valid\"\n \n     amend_problem(root)\n@@ -81,6 +82,7 @@ def test_amendment_above_line_costs_one_act(tmp_path: Path) -> None:\n     # the next gate run CI performs on every push\n     assert run_attavo(root, \"spec-gate\", \"1\").returncode == 0\n     assert run_attavo(root, \"approve\", \"1\", \"--by\", \"alice\").returncode == 0\n+    commit_approval(root)\n \n     valid_again = run_attavo(root, \"approval-status\", \"1\")\n     assert valid_again.returncode == 0\n@@ -97,6 +99,7 @@ def test_approve_accepts_built(tmp_path: Path) -> None:\n     root = make_tenant(tmp_path, \"valid\")\n     assert run_attavo(root, \"spec-gate\", \"1\").returncode == 0\n     assert run_attavo(root, \"approve\", \"1\", \"--by\", \"alice\").returncode == 0\n+    commit_approval(root)\n \n     build = run_attavo(root, \"build\", \"1\", env={\"ATTAVO_FIXTURE_WRITE\": \"src/marker.txt\"})\n     assert build.returncode == 0\n@@ -144,3 +147,48 @@ def test_approval_status_refuses_shallow_checkout(tmp_path: Path) -> None:\n     run = run_attavo(shallow, \"approval-status\", \"1\")\n     assert run.returncode == 2\n     assert \"shallow checkout\" in run.stderr\n+\n+\n+# --- an approval that is only in the working tree is nobody's act (item 224:\n+# build and verify ran on an approval record that had never been committed,\n+# and the merge queue's attest refused it as absent). Written red first\n+# against v0.29.0, where approval-status read the working-tree record as\n+# valid. ---\n+\n+\n+def test_approval_status_reads_uncommitted_until_the_record_is_in_head(tmp_path: Path) -> None:\n+    root = make_tenant(tmp_path, \"valid\")\n+    assert run_attavo(root, \"spec-gate\", \"1\").returncode == 0\n+    assert run_attavo(root, \"approve\", \"1\", \"--by\", \"alice\").returncode == 0\n+    before = run_attavo(root, \"approval-status\", \"1\")\n+    assert (before.returncode, before.stdout.strip()) == (1, \"uncommitted\"), before.stdout + before.stderr\n+    commit_approval(root)\n+    after = run_attavo(root, \"approval-status\", \"1\")\n+    assert (after.returncode, after.stdout.strip()) == (0, \"valid\"), after.stdout + after.stderr\n+    record = approvals(root)[-1]\n+    record.write_text(record.read_text().replace(\"alice\", \"mallory\"))\n+    edited = run_attavo(root, \"approval-status\", \"1\")\n+    assert edited.stdout.strip() == \"uncommitted\", \"a committed record edited in the tree read as valid\"\n+\n+\n+def test_build_refuses_an_uncommitted_approval_and_writes_no_record(tmp_path: Path) -> None:\n+    root = make_tenant(tmp_path, \"build_valid\")\n+    assert run_attavo(root, \"spec-gate\", \"1\").returncode == 0\n+    assert run_attavo(root, \"approve\", \"1\", \"--by\", \"alice\").returncode == 0\n+    build = run_attavo(root, \"build\", \"1\")\n+    assert build.returncode == 1, build.stdout + build.stderr\n+    assert \"attavo build: refused: approval is uncommitted\" in build.stdout, build.stdout\n+    assert not list((root / \"records\" / \"1\").glob(\"build-*\")), \"a build record was written\"\n+    commit_approval(root)\n+    assert run_attavo(root, \"build\", \"1\").returncode == 0\n+\n+\n+def test_approve_says_the_record_must_be_committed(tmp_path: Path) -> None:\n+    \"\"\"Red on the stub by design: the sentence is the build's. The command\n+    that writes the one record no script transports says so as it writes.\"\"\"\n+    root = make_tenant(tmp_path, \"valid\")\n+    assert run_attavo(root, \"spec-gate\", \"1\").returncode == 0\n+    run = run_attavo(root, \"approve\", \"1\", \"--by\", \"alice\")\n+    assert run.returncode == 0\n+    assert \"commit records/1/approval-01.json\" in run.stdout, run.stdout\n+    assert \"nothing runs on it until then\" in run.stdout, run.stdout\ndiff --git a/tests/test_build.py b/tests/test_build.py\nindex 9fa2e3b..a0c6a84 100644\n--- a/tests/test_build.py\n+++ b/tests/test_build.py\n@@ -16,7 +16,7 @@ from typing import Any, cast\n \n import jsonschema\n \n-from helpers import commit_all, make_tenant\n+from helpers import commit_all, commit_approval, make_tenant\n \n ROOT = Path(__file__).resolve().parent.parent\n ATTAVO = ROOT / \"bin\" / \"attavo\"\n@@ -44,6 +44,7 @@ def latest_build(root: Path, item: str = \"1\") -> dict[str, Any]:\n def approve_item(root: Path, item: str = \"1\") -> None:\n     assert run_attavo(root, \"spec-gate\", item).returncode == 0\n     assert run_attavo(root, \"approve\", item, \"--by\", \"alice\").returncode == 0\n+    commit_approval(root, item)\n \n \n def events_dir(root: Path) -> Path:\ndiff --git a/tests/test_drive.py b/tests/test_drive.py\nindex 430be0f..b4b363e 100644\n--- a/tests/test_drive.py\n+++ b/tests/test_drive.py\n@@ -24,7 +24,7 @@ import time\n from pathlib import Path\n from typing import IO, Any, cast\n \n-from helpers import commit_all, git, make_tenant\n+from helpers import commit_all, commit_approval, git, make_tenant\n \n ROOT = Path(__file__).resolve().parent.parent\n ATTAVO = ROOT / \"bin\" / \"attavo\"\n@@ -96,6 +96,7 @@ def add_forge(root: Path, checks_command: str) -> None:\n def approve_item(root: Path, item: str = \"1\") -> None:\n     assert run_attavo(root, \"spec-gate\", item).returncode == 0\n     assert run_attavo(root, \"approve\", item, \"--by\", \"alice\").returncode == 0\n+    commit_approval(root, item)\n \n \n def add_bare_remote(root: Path, tmp_path: Path) -> Path:\ndiff --git a/tests/test_report.py b/tests/test_report.py\nindex 9ccd74f..7c55d65 100644\n--- a/tests/test_report.py\n+++ b/tests/test_report.py\n@@ -16,7 +16,7 @@ from pathlib import Path\n from typing import Any\n \n import pytest\n-from helpers import commit_all, git, make_tenant\n+from helpers import commit_all, commit_approval, git, make_tenant\n from test_attest_time import INVOCATIONS, make_item\n from test_drive import (\n     GREEN_FORGE,\n@@ -274,3 +274,25 @@ def test_report_reads_every_item_this_repository_carries(tmp_path: Path) -> None\n     for item in items:\n         out = drive_report(ROOT, m, item)\n         assert out[\"state\"] in SCHEMA[\"properties\"][\"state\"][\"enum\"], (item, out)\n+\n+\n+def test_a_pass_starts_nothing_on_an_uncommitted_approval_and_the_report_says_what_to_commit(tmp_path: Path) -> None:\n+    \"\"\"Item 224: the operator approved by hand, never committed the record,\n+    and a pass started the build on it; the merge queue's attest was the\n+    first thing to refuse. Red first against v0.29.0.\"\"\"\n+    root = make_tenant(tmp_path, \"build_valid\")\n+    add_forge(root, GREEN_FORGE)\n+    bare = add_bare_remote(root, tmp_path)\n+    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n+    assert run_attavo(root, \"spec-gate\", \"1\").returncode == 0\n+    assert run_attavo(root, \"approve\", \"1\", \"--by\", \"alice\").returncode == 0\n+    before = git(root, \"rev-parse\", \"HEAD\").strip()\n+    out = report(root)\n+    assert (out[\"state\"], out[\"kind\"]) == (\"waiting-on-approval\", \"yours\"), out\n+    assert \"not committed\" in out[\"says\"] and \"records/1/approval-NN.json\" in out[\"says\"], out[\"says\"]\n+    assert drive(root, \"1\").returncode == 0\n+    assert git(root, \"rev-parse\", \"HEAD\").strip() == before, \"the pass committed something\"\n+    assert not list((root / \"records\" / \"1\").glob(\"build-*\")), \"the pass started a build\"\n+    assert git(bare, \"rev-parse\", branch).strip() == before, \"the pass pushed\"\n+    commit_approval(root)\n+    assert (report(root)[\"state\"], report(root)[\"kind\"]) == (\"next-build\", \"acts\")\ndiff --git a/tests/test_spec_gate.py b/tests/test_spec_gate.py\nindex 0dfc44e..a4ae4bf 100644\n--- a/tests/test_spec_gate.py\n+++ b/tests/test_spec_gate.py\n@@ -13,7 +13,7 @@ import sys\n from pathlib import Path\n from typing import Any, cast\n \n-from helpers import commit_all, git, make_tenant\n+from helpers import commit_all, commit_approval, git, make_tenant\n \n ROOT = Path(__file__).resolve().parent.parent\n ATTAVO = ROOT / \"bin\" / \"attavo\"\n@@ -105,6 +105,7 @@ def amend_problem(root: Path) -> None:\n def approve_valid(root: Path) -> None:\n     assert run_attavo(root, \"spec-gate\", \"1\").returncode == 0\n     assert run_attavo(root, \"approve\", \"1\", \"--by\", \"alice\").returncode == 0\n+    commit_approval(root)\n \n \n def complete_the_build(root: Path) -> None:\n@@ -414,7 +415,7 @@ def test_spec_gate_stub_verdict_after_halted_build_that_committed_nothing(tmp_pa\n     \"\"\"\n     root = make_tenant(tmp_path, \"valid\")\n     approve_valid(root)\n-    approval_sha = git(root, \"rev-parse\", \"HEAD\").strip()\n+    approval_sha = latest_record(root, \"1\", \"approval\")[\"sha\"]\n     write_build_record(root, \"1\", sha=approval_sha, status=\"halted\")\n \n     amend_problem(root)\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmpjx6j98fk/diff.patch:48:+      \"name\": \"an-uncommitted-approval-runs-nothing.sh\",\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmpjx6j98fk/diff.patch:96:+{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01TmjVNR9f6aFz3HB3UQg39v\",\"type\":\"tool_result\",\"content\":\"./attest/records/227/approval-01.json\\n./attest/records/227/build-01.started\\n./attest/records/227/spec-01.json\\n./attest/specs/227/criteria/an-uncommitted-approval-runs-nothing.sh\\n./attest/specs/227/spec.md\\n./attest/specs/227/stub/attavo/approval.py\\n./attest/specs/227/stub/attavo/report.py\\n./attest/specs/227/stub/tests/helpers.py\\n./attest/specs/227/stub/tests/test_approve.py\\n./attest/specs/227/stub/tests/test_build.py\\n./attest/specs/227/stub/tests/test_counsel.py\\n./attest/specs/227/stub/tests/test_drive.py\\n./attest/specs/227/stub/tests/test_record_schemas.py\\n./attest/specs/227/stub/tests/test_report.py\\n./attest/specs/227/stub/tests/test_spec_gate.py\\n./attest/specs/227/stub/tests/test_verify_codex_proof.py\\n./attest/specs/227/stub/tests/test_verify_polls.py\\n./attest/specs/227/stub/tests/test_verify.py\",\"is_error\":false}]},\"parent_tool_use_id\":null,\"session_id\":\"c800e014-139e-45d2-ac41-2aa13e2f1485\",\"uuid\":\"72eeeb44-b483-4ed4-bb95-6284c796b916\",\"timestamp\":\"2026-09-27T13:38:34.055Z\",\"tool_use_result\":{\"stdout\":\"./attest/records/227/approval-01.json\\n./attest/records/227/build-01.started\\n./attest/records/227/spec-01.json\\n./attest/specs/227/criteria/an-uncommitted-approval-runs-nothing.sh\\n./attest/specs/227/spec.md\\n./attest/specs/227/stub/attavo/approval.py\\n./attest/specs/227/stub/attavo/report.py\\n./attest/specs/227/stub/tests/helpers.py\\n./attest/specs/227/stub/tests/test_approve.py\\n./attest/specs/227/stub/tests/test_build.py\\n./attest/specs/227/stub/tests/test_counsel.py\\n./attest/specs/227/stub/tests/test_drive.py\\n./attest/specs/227/stub/tests/test_record_schemas.py\\n./attest/specs/227/stub/tests/test_report.py\\n./attest/specs/227/stub/tests/test_spec_gate.py\\n./attest/specs/227/stub/tests/test_verify_codex_proof.py\\n./attest/specs/227/stub/tests/test_verify_polls.py\\n./attest/specs/227/stub/tests/test_verify.py\",\"stderr\":\"\",\"interrupted\":false,\"isImage\":false,\"noOutputExpected\":false}}\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmpjx6j98fk/diff.patch:102:+{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_012yBCAhokb2cUrwwhXFvmu4\",\"type\":\"tool_result\",\"content\":\"## Problem\\n\\nApproval binds to the spec's commit and is the operator's act; the product's rule is that a stage runs on that act and on nothing less. On #224 the approval was written by hand (`attavo approve` from the item's working copy, 2026-09-26) and never committed; `attavo approval-status` read it as `valid`, the pass started the build on it, the build passed, the review passed, and the merge queue's `attavo attest` was the first thing to refuse: \\\"no approval record for item 224\\\". Two stages ran on an act that was on no branch, and the record that would have let anyone audit them from git did not exist until the operator committed it afterwards.\\n\\nThe product's own path never does this: the screen posts `/approve`, the tenant's `attavo-approve.yml` runs `attavo approve` and commits and pushes the record. The hole is in the reader, not the writer. `approval_status` reads the latest approval record from the working tree and asks only whether its `spec_sha` is current; a record that exists only in the tree, or that differs in the tree from what `HEAD` carries, answers `valid`.\\n\\nThis item gives `approval_status` a fourth answer. `uncommitted`: the latest approval record is not in `HEAD` byte for byte, either because it was never committed or because the tree's copy has been edited. Everything that reads the function inherits the refusal with no further code: `attavo approval-status` prints `uncommitted` and exits 1; `attavo build` refuses (\\\"approval is uncommitted\\\") and writes no record; the pass's `drive_state` reads `no-approval` and starts nothing; the report's state is `waiting-on-approval`, kind `yours`, and its sentence says what to commit and where. The one new sentence is the report's. `attavo approve` also says, as it writes, that the record must be committed and that nothing runs on it until then.\\n\\nNot in this item: `attavo approve` committing on its own (the approve workflow commits after it, and would then have nothing to commit; changing the template changes every tenant at the next pin); reading any other record from `HEAD` rather than the tree (that is the working-copy reconciler item, R5, where every stage's reads move to the branch's facts); a doctor proof.\\n\\nThe fixtures. 116 of the suite's tests approve an item and never commit the record, which is untrue to production, where the approval is always a commit on the branch. The stub adds `tests/helpers.py::commit_approval` (the approval record alone, `git commit --only`, the approve workflow's own shape) and calls it after each of the fifteen `approve` calls in twelve test files; `tests/test_spec_gate.py`'s halted-build fixture reads the approval's `sha` from the record instead of `HEAD`. That is the bulk of the diff and it is a fixture correction, not a behaviour change: every one of those tests asserts what it asserted before.\\n\\nThe stub under `stub/` is the change: `approval_status`, the report's sentence, the helper, the fixture lines, and three tests red on the tree (v0.29.0). `tests/test_approve.py::test_approve_says_the_record_must_be_committed` is red on the stub by design; the sentence is the build's. `python3 -m mypy` exits 0 on the stub.\\n\\nRetires: `valid` as the answer for an approval that is on no branch; the merge queue as the first place an uncommitted approval is refused.\\n\\n## Claims\\n\\n- attavo/approval.py\\n- attavo/report.py\\n- tests/helpers.py\\n- tests/test_approve.py\\n- tests/test_report.py\\n- tests/test_build.py\\n- tests/test_verify.py\\n- tests/test_verify_polls.py\\n- tests/test_verify_codex_proof.py\\n- tests/test_drive.py\\n- tests/test_counsel.py\\n- tests/test_spec_gate.py\\n- tests/test_record_schemas.py\\n\\n## Criteria\\n\\n- an-uncommitted-approval-runs-nothing.sh: on a fixture tenant with a passing gate and an approval written but not committed, `attavo approval-status 1` prints `uncommitted` and exits 1, `attavo build 1` refuses with \\\"approval is uncommitted\\\" and writes no record, `attavo drive 1 --report` reads `waiting-on-approval` with a sentence naming the record to commit, a pass commits nothing and starts nothing; once the record is committed the status is `valid` and the report reads `next-build`; and the four tests named exist\",\"is_error\":false}]},\"parent_tool_use_id\":null,\"session_id\":\"c800e014-139e-45d2-ac41-2aa13e2f1485\",\"uuid\":\"6c0c0a06-d8fe-43f0-b447-cb9fea25773d\",\"timestamp\":\"2026-09-27T13:38:37.361Z\",\"tool_use_result\":{\"stdout\":\"## Problem\\n\\nApproval binds to the spec's commit and is the operator's act; the product's rule is that a stage runs on that act and on nothing less. On #224 the approval was written by hand (`attavo approve` from the item's working copy, 2026-09-26) and never committed; `attavo approval-status` read it as `valid`, the pass started the build on it, the build passed, the review passed, and the merge queue's `attavo attest` was the first thing to refuse: \\\"no approval record for item 224\\\". Two stages ran on an act that was on no branch, and the record that would have let anyone audit them from git did not exist until the operator committed it afterwards.\\n\\nThe product's own path never does this: the screen posts `/approve`, the tenant's `attavo-approve.yml` runs `attavo approve` and commits and pushes the record. The hole is in the reader, not the writer. `approval_status` reads the latest approval record from the working tree and asks only whether its `spec_sha` is current; a record that exists only in the tree, or that differs in the tree from what `HEAD` carries, answers `valid`.\\n\\nThis item gives `approval_status` a fourth answer. `uncommitted`: the latest approval record is not in `HEAD` byte for byte, either because it was never committed or because the tree's copy has been edited. Everything that reads the function inherits the refusal with no further code: `attavo approval-status` prints `uncommitted` and exits 1; `attavo build` refuses (\\\"approval is uncommitted\\\") and writes no record; the pass's `drive_state` reads `no-approval` and starts nothing; the report's state is `waiting-on-approval`, kind `yours`, and its sentence says what to commit and where. The one new sentence is the report's. `attavo approve` also says, as it writes, that the record must be committed and that nothing runs on it until then.\\n\\nNot in this item: `attavo approve` committing on its own (the approve workflow commits after it, and would then have nothing to commit; changing the template changes every tenant at the next pin); reading any other record from `HEAD` rather than the tree (that is the working-copy reconciler item, R5, where every stage's reads move to the branch's facts); a doctor proof.\\n\\nThe fixtures. 116 of the suite's tests approve an item and never commit the record, which is untrue to production, where the approval is always a commit on the branch. The stub adds `tests/helpers.py::commit_approval` (the approval record alone, `git commit --only`, the approve workflow's own shape) and calls it after each of the fifteen `approve` calls in twelve test files; `tests/test_spec_gate.py`'s halted-build fixture reads the approval's `sha` from the record instead of `HEAD`. That is the bulk of the diff and it is a fixture correction, not a behaviour change: every one of those tests asserts what it asserted before.\\n\\nThe stub under `stub/` is the change: `approval_status`, the report's sentence, the helper, the fixture lines, and three tests red on the tree (v0.29.0). `tests/test_approve.py::test_approve_says_the_record_must_be_committed` is red on the stub by design; the sentence is the build's. `python3 -m mypy` exits 0 on the stub.\\n\\nRetires: `valid` as the answer for an approval that is on no branch; the merge queue as the first place an uncommitted approval is refused.\\n\\n## Claims\\n\\n- attavo/approval.py\\n- attavo/report.py\\n- tests/helpers.py\\n- tests/test_approve.py\\n- tests/test_report.py\\n- tests/test_build.py\\n- tests/test_verify.py\\n- tests/test_verify_polls.py\\n- tests/test_verify_codex_proof.py\\n- tests/test_drive.py\\n- tests/test_counsel.py\\n- tests/test_spec_gate.py\\n- tests/test_record_schemas.py\\n\\n## Criteria\\n\\n- an-uncommitted-approval-runs-nothing.sh: on a fixture tenant with a passing gate and an approval written but not committed, `attavo approval-status 1` prints `uncommitted` and exits 1, `attavo build 1` refuses with \\\"approval is uncommitted\\\" and writes no record, `attavo drive 1 --report` reads `waiting-on-approval` with a sentence naming the record to commit, a pass commits nothing and starts nothing; once the record is committed the status is `valid` and the report reads `next-build`; and the four tests named exist\",\"stderr\":\"\",\"interrupted\":false,\"isImage\":false,\"noOutputExpected\":false}}\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmpjx6j98fk/diff.patch:105:+{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01NCD1xdSzy7pqdTW63oW6WA\",\"type\":\"tool_result\",\"content\":\"from __future__ import annotations\\n\\nimport sys\\nfrom pathlib import Path\\nfrom typing import Any\\n\\nfrom attavo.common import (\\n    MANIFEST,\\n    ShallowCheckoutError,\\n    derive_item_id,\\n    git,\\n    last_commit_touching,\\n    now_iso,\\n    read_manifest,\\n)\\nfrom attavo.records import latest_attempt_path, latest_record, write_record\\n\\n# --- approval, bound to a commit ---\\n\\ndef cmd_approve(argv: list[str]) -> int:\\n    root = Path(\\\".\\\").resolve()\\n    by = None\\n    positional: list[str] = []\\n    i = 0\\n    while i < len(argv):\\n        if argv[i] == \\\"--by\\\":\\n            by = argv[i + 1] if i + 1 < len(argv) else None\\n            i += 2\\n        else:\\n            positional.append(argv[i])\\n            i += 1\\n    item_id = positional[0] if positional else derive_item_id(root)\\n    if not item_id:\\n        print(\\\"attavo approve: cannot derive item id; pass N or run on an attavo/N-* branch\\\",\\n              file=sys.stderr)\\n        return 2\\n    if not by:\\n        print(\\\"attavo approve: --by LOGIN is required\\\", file=sys.stderr)\\n        return 2\\n    m = read_manifest(root)\\n    if m is None:\\n        print(f\\\"attavo approve: no {MANIFEST} at {root}\\\", file=sys.stderr)\\n        return 2\\n\\n    specs_rel = m[\\\"paths\\\"][\\\"specs\\\"]\\n    records_rel = m[\\\"paths\\\"][\\\"records\\\"]\\n    spec_rel = str(Path(specs_rel) / item_id)\\n    try:\\n        spec_sha_now = last_commit_touching(root, spec_rel)\\n    except ShallowCheckoutError as exc:\\n        print(f\\\"attavo approve: refused: {exc}\\\", file=sys.stderr)\\n        return 2\\n    records_dir = root / records_rel / item_id\\n    latest_spec = latest_record(records_dir, \\\"spec\\\")\\n    approvers = ((m.get(\\\"operators\\\") or {}).get(\\\"approvers\\\")) or []\\n\\n    refusal = None\\n    if latest_spec is None or latest_spec.get(\\\"status\\\") not in (\\\"pass\\\", \\\"built\\\"):\\n        refusal = f\\\"no passing spec-gate record for item {item_id}\\\"\\n    elif latest_spec.get(\\\"spec_sha\\\") != spec_sha_now:\\n        refusal = (f\\\"spec-gate record is stale: recorded {latest_spec.get('spec_sha')}, \\\"\\n                   f\\\"spec now at {spec_sha_now}\\\")\\n    elif by not in approvers:\\n        refusal = f\\\"{by} is not in [operators].approvers\\\"\\n\\n    if refusal:\\n        print(f\\\"attavo approve: refused: {refusal}\\\")\\n        return 1\\n\\n    record = {\\\"sha\\\": git(root, \\\"rev-parse\\\", \\\"HEAD\\\").strip(), \\\"spec_sha\\\": spec_sha_now,\\n              \\\"approved_by\\\": by, \\\"at\\\": now_iso()}\\n    write_record(records_dir, \\\"approval\\\", record, m, item_id)\\n    print(f\\\"attavo approve: item {item_id} approved by {by}\\\")\\n    return 0\\n\\n\\ndef approval_status(root: Path, m: dict[str, Any], item_id: str) -> str:\\n    \\\"\\\"\\\"\\\"absent\\\", \\\"expired\\\", or \\\"valid\\\": whether the latest approval record\\n    for item_id still binds to the spec's current commit. Raises\\n    ShallowCheckoutError on a shallow checkout, same as last_commit_touching.\\n    Shared by cmd_approval_status and cmd_build so build refuses on exactly\\n    what `attavo approval-status` would print.\\n    \\\"\\\"\\\"\\n    specs_rel = m[\\\"paths\\\"][\\\"specs\\\"]\\n    records_rel = m[\\\"paths\\\"][\\\"records\\\"]\\n    spec_rel = str(Path(specs_rel) / item_id)\\n    spec_sha_now = last_commit_touching(root, spec_rel)\\n    records_dir = root / records_rel / item_id\\n    latest_approval = latest_record(records_dir, \\\"approval\\\")\\n\\n    if latest_approval is None:\\n        return \\\"absent\\\"\\n    if not record_is_committed(root, latest_attempt_path(records_dir, \\\"approval\\\")):\\n        return \\\"uncommitted\\\"\\n    if latest_approval.get(\\\"spec_sha\\\") == spec_sha_now:\\n        return \\\"valid\\\"\\n    return \\\"expired\\\"\\n\\n\\ndef record_is_committed(root: Path, path: Path | None) -> bool:\\n    \\\"\\\"\\\"Whether the record at path is in HEAD byte for byte. A record that\\n    exists only in the working tree -- written by hand, or by a script\\n    whose transport never ran -- is not the operator's act on the branch,\\n    and no stage may run on it (item 224: build and verify ran on an\\n    approval the merge queue's attest then refused as absent).\\\"\\\"\\\"\\n    if path is None:\\n        return False\\n    rel = path.resolve().relative_to(root.resolve()).as_posix()\\n    try:\\n        return git(root, \\\"show\\\", f\\\"HEAD:{rel}\\\") == path.read_text()\\n    except (RuntimeError, OSError):\\n        return False\\n\\n\\ndef cmd_approval_status(argv: list[str]) -> int:\\n    root = Path(\\\".\\\").resolve()\\n    item_id = argv[0] if argv else derive_item_id(root)\\n    if not item_id:\\n        print(\\\"attavo approval-status: cannot derive item id; pass N or run on an attavo/N-* branch\\\",\\n              file=sys.stderr)\\n        return 2\\n    m = read_manifest(root)\\n    if m is None:\\n        print(f\\\"attavo approval-status: no {MANIFEST} at {root}\\\", file=sys.stderr)\\n        return 2\\n\\n    try:\\n        status = approval_status(root, m, item_id)\\n    except ShallowCheckoutError as exc:\\n        print(f\\\"attavo approval-status: refused: {exc}\\\", file=sys.stderr)\\n        return 2\\n\\n    print(status)\\n    return 0 if status == \\\"valid\\\" else 1\",\"is_error\":false}]},\"parent_tool_use_id\":null,\"session_id\":\"c800e014-139e-45d2-ac41-2aa13e2f1485\",\"uuid\":\"007ba3b0-06fd-4d29-b279-9793918e7dd2\",\"timestamp\":\"2026-09-27T13:38:38.823Z\",\"tool_use_result\":{\"stdout\":\"from __future__ import annotations\\n\\nimport sys\\nfrom pathlib import Path\\nfrom typing import Any\\n\\nfrom attavo.common import (\\n    MANIFEST,\\n    ShallowCheckoutError,\\n    derive_item_id,\\n    git,\\n    last_commit_touching,\\n    now_iso,\\n    read_manifest,\\n)\\nfrom attavo.records import latest_attempt_path, latest_record, write_record\\n\\n# --- approval, bound to a commit ---\\n\\ndef cmd_approve(argv: list[str]) -> int:\\n    root = Path(\\\".\\\").resolve()\\n    by = None\\n    positional: list[str] = []\\n    i = 0\\n    while i < len(argv):\\n        if argv[i] == \\\"--by\\\":\\n            by = argv[i + 1] if i + 1 < len(argv) else None\\n            i += 2\\n        else:\\n            positional.append(argv[i])\\n            i += 1\\n    item_id = positional[0] if positional else derive_item_id(root)\\n    if not item_id:\\n        print(\\\"attavo approve: cannot derive item id; pass N or run on an attavo/N-* branch\\\",\\n              file=sys.stderr)\\n        return 2\\n    if not by:\\n        print(\\\"attavo approve: --by LOGIN is required\\\", file=sys.stderr)\\n        return 2\\n    m = read_manifest(root)\\n    if m is None:\\n        print(f\\\"attavo approve: no {MANIFEST} at {root}\\\", file=sys.stderr)\\n        return 2\\n\\n    specs_rel = m[\\\"paths\\\"][\\\"specs\\\"]\\n    records_rel = m[\\\"paths\\\"][\\\"records\\\"]\\n    spec_rel = str(Path(specs_rel) / item_id)\\n    try:\\n        spec_sha_now = last_commit_touching(root, spec_rel)\\n    except ShallowCheckoutError as exc:\\n        print(f\\\"attavo approve: refused: {exc}\\\", file=sys.stderr)\\n        return 2\\n    records_dir = root / records_rel / item_id\\n    latest_spec = latest_record(records_dir, \\\"spec\\\")\\n    approvers = ((m.get(\\\"operators\\\") or {}).get(\\\"approvers\\\")) or []\\n\\n    refusal = None\\n    if latest_spec is None or latest_spec.get(\\\"status\\\") not in (\\\"pass\\\", \\\"built\\\"):\\n        refusal = f\\\"no passing spec-gate record for item {item_id}\\\"\\n    elif latest_spec.get(\\\"spec_sha\\\") != spec_sha_now:\\n        refusal = (f\\\"spec-gate record is stale: recorded {latest_spec.get('spec_sha')}, \\\"\\n                   f\\\"spec now at {spec_sha_now}\\\")\\n    elif by not in approvers:\\n        refusal = f\\\"{by} is not in [operators].approvers\\\"\\n\\n    if refusal:\\n        print(f\\\"attavo approve: refused: {refusal}\\\")\\n        return 1\\n\\n    record = {\\\"sha\\\": git(root, \\\"rev-parse\\\", \\\"HEAD\\\").strip(), \\\"spec_sha\\\": spec_sha_now,\\n              \\\"approved_by\\\": by, \\\"at\\\": now_iso()}\\n    write_record(records_dir, \\\"approval\\\", record, m, item_id)\\n    print(f\\\"attavo approve: item {item_id} approved by {by}\\\")\\n    return 0\\n\\n\\ndef approval_status(root: Path, m: dict[str, Any], item_id: str) -> str:\\n    \\\"\\\"\\\"\\\"absent\\\", \\\"expired\\\", or \\\"valid\\\": whether the latest approval record\\n    for item_id still binds to the spec's current commit. Raises\\n    ShallowCheckoutError on a shallow checkout, same as last_commit_touching.\\n    Shared by cmd_approval_status and cmd_build so build refuses on exactly\\n    what `attavo approval-status` would print.\\n    \\\"\\\"\\\"\\n    specs_rel = m[\\\"paths\\\"][\\\"specs\\\"]\\n    records_rel = m[\\\"paths\\\"][\\\"records\\\"]\\n    spec_rel = str(Path(specs_rel) / item_id)\\n    spec_sha_now = last_commit_touching(root, spec_rel)\\n    records_dir = root / records_rel / item_id\\n    latest_approval = latest_record(records_dir, \\\"approval\\\")\\n\\n    if latest_approval is None:\\n        return \\\"absent\\\"\\n    if not record_is_committed(root, latest_attempt_path(records_dir, \\\"approval\\\")):\\n        return \\\"uncommitted\\\"\\n    if latest_approval.get(\\\"spec_sha\\\") == spec_sha_now:\\n        return \\\"valid\\\"\\n    return \\\"expired\\\"\\n\\n\\ndef record_is_committed(root: Path, path: Path | None) -> bool:\\n    \\\"\\\"\\\"Whether the record at path is in HEAD byte for byte. A record that\\n    exists only in the working tree -- written by hand, or by a script\\n    whose transport never ran -- is not the operator's act on the branch,\\n    and no stage may run on it (item 224: build and verify ran on an\\n    approval the merge queue's attest then refused as absent).\\\"\\\"\\\"\\n    if path is None:\\n        return False\\n    rel = path.resolve().relative_to(root.resolve()).as_posix()\\n    try:\\n        return git(root, \\\"show\\\", f\\\"HEAD:{rel}\\\") == path.read_text()\\n    except (RuntimeError, OSError):\\n        return False\\n\\n\\ndef cmd_approval_status(argv: list[str]) -> int:\\n    root = Path(\\\".\\\").resolve()\\n    item_id = argv[0] if argv else derive_item_id(root)\\n    if not item_id:\\n        print(\\\"attavo approval-status: cannot derive item id; pass N or run on an attavo/N-* branch\\\",\\n              file=sys.stderr)\\n        return 2\\n    m = read_manifest(root)\\n    if m is None:\\n        print(f\\\"attavo approval-status: no {MANIFEST} at {root}\\\", file=sys.stderr)\\n        return 2\\n\\n    try:\\n        status = approval_status(root, m, item_id)\\n    except ShallowCheckoutError as exc:\\n        print(f\\\"attavo approval-status: refused: {exc}\\\", file=sys.stderr)\\n        return 2\\n\\n    print(status)\\n    return 0 if status == \\\"valid\\\" else 1\",\"stderr\":\"\",\"interrupted\":false,\"isImage\":false,\"noOutputExpected\":false}}\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmpjx6j98fk/diff.patch:110:+{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01KQCv3Z5ftUode236chcCWY\",\"type\":\"tool_result\",\"content\":\"\\\"\\\"\\\"Approval bound to a commit: attavo approve N --by LOGIN, attavo approval-status N.\\n\\nRejection tests, written and run red before the capability existed: on\\n`main` at commit 22ca1e1 there was no `approve` or `approval-status`\\nsubcommand, so every one of these failed with \\\"unknown subcommand\\\".\\n\\nRun: python3 -m pytest tests -q\\n\\\"\\\"\\\"\\nimport json\\nimport os\\nimport subprocess\\nimport sys\\nfrom pathlib import Path\\nfrom typing import Any\\n\\nfrom helpers import clone_shallow, commit_all, commit_approval, make_tenant\\n\\nROOT = Path(__file__).resolve().parent.parent\\nATTAVO = ROOT / \\\"bin\\\" / \\\"attavo\\\"\\n\\n\\ndef run_attavo(root: Path, *args: str, env: dict[str, Any] | None = None) -> subprocess.CompletedProcess[str]:\\n    full_env = dict(os.environ)\\n    if env:\\n        full_env.update(env)\\n    return subprocess.run([sys.executable, str(ATTAVO), *args], cwd=str(root),\\n                          capture_output=True, text=True, check=False, env=full_env)\\n\\n\\ndef approvals(root: Path, item: str = \\\"1\\\") -> list[Path]:\\n    return sorted((root / \\\"records\\\" / item).glob(\\\"approval-*.json\\\"))\\n\\n\\ndef amend_problem(root: Path) -> None:\\n    spec_md = root / \\\"specs\\\" / \\\"1\\\" / \\\"spec.md\\\"\\n    spec_md.write_text(spec_md.read_text().replace(\\n        \\\"does not emit\\\", \\\"used to not emit\\\"))\\n    commit_all(root, \\\"amend problem prose\\\")\\n\\n\\ndef test_approve_refuses_without_current_pass(tmp_path: Path) -> None:\\n    root = make_tenant(tmp_path, \\\"valid\\\")\\n\\n    # no spec-gate has run at all yet\\n    run = run_attavo(root, \\\"approve\\\", \\\"1\\\", \\\"--by\\\", \\\"alice\\\")\\n    assert run.returncode == 1\\n    assert approvals(root) == []\\n\\n    # a pass exists, but the spec has since moved without a fresh gate run\\n    assert run_attavo(root, \\\"spec-gate\\\", \\\"1\\\").returncode == 0\\n    amend_problem(root)\\n\\n    stale = run_attavo(root, \\\"approve\\\", \\\"1\\\", \\\"--by\\\", \\\"alice\\\")\\n    assert stale.returncode == 1\\n    assert \\\"stale\\\" in stale.stdout\\n    assert approvals(root) == []\\n\\n\\ndef test_approve_refuses_unlisted_login(tmp_path: Path) -> None:\\n    root = make_tenant(tmp_path, \\\"valid\\\")\\n    assert run_attavo(root, \\\"spec-gate\\\", \\\"1\\\").returncode == 0\\n\\n    run = run_attavo(root, \\\"approve\\\", \\\"1\\\", \\\"--by\\\", \\\"mallory\\\")\\n    assert run.returncode == 1\\n    assert \\\"mallory\\\" in run.stdout\\n    assert approvals(root) == []\\n\\n\\ndef test_amendment_above_line_costs_one_act(tmp_path: Path) -> None:\\n    root = make_tenant(tmp_path, \\\"valid\\\")\\n\\n    assert run_attavo(root, \\\"spec-gate\\\", \\\"1\\\").returncode == 0\\n    assert run_attavo(root, \\\"approve\\\", \\\"1\\\", \\\"--by\\\", \\\"alice\\\").returncode == 0\\n    commit_approval(root)\\n    assert run_attavo(root, \\\"approval-status\\\", \\\"1\\\").stdout.strip() == \\\"valid\\\"\\n\\n    amend_problem(root)\\n    expired = run_attavo(root, \\\"approval-status\\\", \\\"1\\\")\\n    assert expired.returncode == 1\\n    assert expired.stdout.strip() == \\\"expired\\\"\\n\\n    # the next gate run CI performs on every push\\n    assert run_attavo(root, \\\"spec-gate\\\", \\\"1\\\").returncode == 0\\n    assert run_attavo(root, \\\"approve\\\", \\\"1\\\", \\\"--by\\\", \\\"alice\\\").returncode == 0\\n    commit_approval(root)\\n\\n    valid_again = run_attavo(root, \\\"approval-status\\\", \\\"1\\\")\\n    assert valid_again.returncode == 0\\n    assert valid_again.stdout.strip() == \\\"valid\\\"\\n\\n    assert [p.name for p in approvals(root)] == [\\\"approval-01.json\\\", \\\"approval-02.json\\\"]\\n\\n\\ndef test_approve_accepts_built(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Issue #28, acceptance 4. approve succeeds on a latest spec-gate\\n    record of status built -- the re-approval path after an amendment\\n    that landed above the line after a real build.\\n    \\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"valid\\\")\\n    assert run_attavo(root, \\\"spec-gate\\\", \\\"1\\\").returncode == 0\\n    assert run_attavo(root, \\\"approve\\\", \\\"1\\\", \\\"--by\\\", \\\"alice\\\").returncode == 0\\n    commit_approval(root)\\n\\n    build = run_attavo(root, \\\"build\\\", \\\"1\\\", env={\\\"ATTAVO_FIXTURE_WRITE\\\": \\\"src/marker.txt\\\"})\\n    assert build.returncode == 0\\n\\n    amend_problem(root)\\n    built = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert built.returncode == 0\\n    latest_spec = sorted((root / \\\"records\\\" / \\\"1\\\").glob(\\\"spec-*.json\\\"))[-1]\\n    assert json.loads(latest_spec.read_text())[\\\"status\\\"] == \\\"built\\\"\\n\\n    run = run_attavo(root, \\\"approve\\\", \\\"1\\\", \\\"--by\\\", \\\"alice\\\")\\n    assert run.returncode == 0\\n    assert [p.name for p in approvals(root)] == [\\\"approval-01.json\\\", \\\"approval-02.json\\\"]\\n\\n\\ndef test_approve_refuses_shallow_checkout(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"On a --depth 1 clone, `git log -1 -- <path>` returns HEAD for every\\n    path (there is no history to prove otherwise), so a shallow checkout\\n    would compute a spec_sha that always matches HEAD and pass approval\\n    for a spec that may have moved. attavo approve must refuse instead of\\n    trusting that number: exit 2, naming the cause, not \\\"stale\\\".\\n    \\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"valid\\\")\\n    assert run_attavo(root, \\\"spec-gate\\\", \\\"1\\\").returncode == 0\\n    commit_all(root, \\\"spec-gate record\\\")\\n\\n    shallow = tmp_path / \\\"shallow\\\"\\n    clone_shallow(root, shallow)\\n\\n    run = run_attavo(shallow, \\\"approve\\\", \\\"1\\\", \\\"--by\\\", \\\"alice\\\")\\n    assert run.returncode == 2\\n    assert \\\"shallow checkout\\\" in run.stderr\\n    assert approvals(shallow) == []\\n\\n\\ndef test_approval_status_refuses_shallow_checkout(tmp_path: Path) -> None:\\n    root = make_tenant(tmp_path, \\\"valid\\\")\\n    assert run_attavo(root, \\\"spec-gate\\\", \\\"1\\\").returncode == 0\\n    assert run_attavo(root, \\\"approve\\\", \\\"1\\\", \\\"--by\\\", \\\"alice\\\").returncode == 0\\n    commit_all(root, \\\"spec-gate and approval records\\\")\\n\\n    shallow = tmp_path / \\\"shallow\\\"\\n    clone_shallow(root, shallow)\\n\\n    run = run_attavo(shallow, \\\"approval-status\\\", \\\"1\\\")\\n    assert run.returncode == 2\\n    assert \\\"shallow checkout\\\" in run.stderr\\n\\n\\n# --- an approval that is only in the working tree is nobody's act (item 224:\\n# build and verify ran on an approval record that had never been committed,\\n# and the merge queue's attest refused it as absent). Written red first\\n# against v0.29.0, where approval-status read the working-tree record as\\n# valid. ---\\n\\n\\ndef test_approval_status_reads_uncommitted_until_the_record_is_in_head(tmp_path: Path) -> None:\\n    root = make_tenant(tmp_path, \\\"valid\\\")\\n    assert run_attavo(root, \\\"spec-gate\\\", \\\"1\\\").returncode == 0\\n    assert run_attavo(root, \\\"approve\\\", \\\"1\\\", \\\"--by\\\", \\\"alice\\\").returncode == 0\\n    before = run_attavo(root, \\\"approval-status\\\", \\\"1\\\")\\n    assert (before.returncode, before.stdout.strip()) == (1, \\\"uncommitted\\\"), before.stdout + before.stderr\\n    commit_approval(root)\\n    after = run_attavo(root, \\\"approval-status\\\", \\\"1\\\")\\n    assert (after.returncode, after.stdout.strip()) == (0, \\\"valid\\\"), after.stdout + after.stderr\\n    record = approvals(root)[-1]\\n    record.write_text(record.read_text().replace(\\\"alice\\\", \\\"mallory\\\"))\\n    edited = run_attavo(root, \\\"approval-status\\\", \\\"1\\\")\\n    assert edited.stdout.strip() == \\\"uncommitted\\\", \\\"a committed record edited in the tree read as valid\\\"\\n\\n\\ndef test_build_refuses_an_uncommitted_approval_and_writes_no_record(tmp_path: Path) -> None:\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    assert run_attavo(root, \\\"spec-gate\\\", \\\"1\\\").returncode == 0\\n    assert run_attavo(root, \\\"approve\\\", \\\"1\\\", \\\"--by\\\", \\\"alice\\\").returncode == 0\\n    build = run_attavo(root, \\\"build\\\", \\\"1\\\")\\n    assert build.returncode == 1, build.stdout + build.stderr\\n    assert \\\"attavo build: refused: approval is uncommitted\\\" in build.stdout, build.stdout\\n    assert not list((root / \\\"records\\\" / \\\"1\\\").glob(\\\"build-*\\\")), \\\"a build record was written\\\"\\n    commit_approval(root)\\n    assert run_attavo(root, \\\"build\\\", \\\"1\\\").returncode == 0\\n\\n\\ndef test_approve_says_the_record_must_be_committed(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Red on the stub by design: the sentence is the build's. The command\\n    that writes the one record no script transports says so as it writes.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"valid\\\")\\n    assert run_attavo(root, \\\"spec-gate\\\", \\\"1\\\").returncode == 0\\n    run = run_attavo(root, \\\"approve\\\", \\\"1\\\", \\\"--by\\\", \\\"alice\\\")\\n    assert run.returncode == 0\\n    assert \\\"commit records/1/approval-01.json\\\" in run.stdout, run.stdout\\n    assert \\\"nothing runs on it until then\\\" in run.stdout, run.stdout\",\"is_error\":false}]},\"parent_tool_use_id\":null,\"session_id\":\"c800e014-139e-45d2-ac41-2aa13e2f1485\",\"uuid\":\"8d4226f9-4a17-4e4f-b731-3e2e02cb0269\",\"timestamp\":\"2026-09-27T13:38:40.596Z\",\"tool_use_result\":{\"stdout\":\"\\\"\\\"\\\"Approval bound to a commit: attavo approve N --by LOGIN, attavo approval-status N.\\n\\nRejection tests, written and run red before the capability existed: on\\n`main` at commit 22ca1e1 there was no `approve` or `approval-status`\\nsubcommand, so every one of these failed with \\\"unknown subcommand\\\".\\n\\nRun: python3 -m pytest tests -q\\n\\\"\\\"\\\"\\nimport json\\nimport os\\nimport subprocess\\nimport sys\\nfrom pathlib import Path\\nfrom typing import Any\\n\\nfrom helpers import clone_shallow, commit_all, commit_approval, make_tenant\\n\\nROOT = Path(__file__).resolve().parent.parent\\nATTAVO = ROOT / \\\"bin\\\" / \\\"attavo\\\"\\n\\n\\ndef run_attavo(root: Path, *args: str, env: dict[str, Any] | None = None) -> subprocess.CompletedProcess[str]:\\n    full_env = dict(os.environ)\\n    if env:\\n        full_env.update(env)\\n    return subprocess.run([sys.executable, str(ATTAVO), *args], cwd=str(root),\\n                          capture_output=True, text=True, check=False, env=full_env)\\n\\n\\ndef approvals(root: Path, item: str = \\\"1\\\") -> list[Path]:\\n    return sorted((root / \\\"records\\\" / item).glob(\\\"approval-*.json\\\"))\\n\\n\\ndef amend_problem(root: Path) -> None:\\n    spec_md = root / \\\"specs\\\" / \\\"1\\\" / \\\"spec.md\\\"\\n    spec_md.write_text(spec_md.read_text().replace(\\n        \\\"does not emit\\\", \\\"used to not emit\\\"))\\n    commit_all(root, \\\"amend problem prose\\\")\\n\\n\\ndef test_approve_refuses_without_current_pass(tmp_path: Path) -> None:\\n    root = make_tenant(tmp_path, \\\"valid\\\")\\n\\n    # no spec-gate has run at all yet\\n    run = run_attavo(root, \\\"approve\\\", \\\"1\\\", \\\"--by\\\", \\\"alice\\\")\\n    assert run.returncode == 1\\n    assert approvals(root) == []\\n\\n    # a pass exists, but the spec has since moved without a fresh gate run\\n    assert run_attavo(root, \\\"spec-gate\\\", \\\"1\\\").returncode == 0\\n    amend_problem(root)\\n\\n    stale = run_attavo(root, \\\"approve\\\", \\\"1\\\", \\\"--by\\\", \\\"alice\\\")\\n    assert stale.returncode == 1\\n    assert \\\"stale\\\" in stale.stdout\\n    assert approvals(root) == []\\n\\n\\ndef test_approve_refuses_unlisted_login(tmp_path: Path) -> None:\\n    root = make_tenant(tmp_path, \\\"valid\\\")\\n    assert run_attavo(root, \\\"spec-gate\\\", \\\"1\\\").returncode == 0\\n\\n    run = run_attavo(root, \\\"approve\\\", \\\"1\\\", \\\"--by\\\", \\\"mallory\\\")\\n    assert run.returncode == 1\\n    assert \\\"mallory\\\" in run.stdout\\n    assert approvals(root) == []\\n\\n\\ndef test_amendment_above_line_costs_one_act(tmp_path: Path) -> None:\\n    root = make_tenant(tmp_path, \\\"valid\\\")\\n\\n    assert run_attavo(root, \\\"spec-gate\\\", \\\"1\\\").returncode == 0\\n    assert run_attavo(root, \\\"approve\\\", \\\"1\\\", \\\"--by\\\", \\\"alice\\\").returncode == 0\\n    commit_approval(root)\\n    assert run_attavo(root, \\\"approval-status\\\", \\\"1\\\").stdout.strip() == \\\"valid\\\"\\n\\n    amend_problem(root)\\n    expired = run_attavo(root, \\\"approval-status\\\", \\\"1\\\")\\n    assert expired.returncode == 1\\n    assert expired.stdout.strip() == \\\"expired\\\"\\n\\n    # the next gate run CI performs on every push\\n    assert run_attavo(root, \\\"spec-gate\\\", \\\"1\\\").returncode == 0\\n    assert run_attavo(root, \\\"approve\\\", \\\"1\\\", \\\"--by\\\", \\\"alice\\\").returncode == 0\\n    commit_approval(root)\\n\\n    valid_again = run_attavo(root, \\\"approval-status\\\", \\\"1\\\")\\n    assert valid_again.returncode == 0\\n    assert valid_again.stdout.strip() == \\\"valid\\\"\\n\\n    assert [p.name for p in approvals(root)] == [\\\"approval-01.json\\\", \\\"approval-02.json\\\"]\\n\\n\\ndef test_approve_accepts_built(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Issue #28, acceptance 4. approve succeeds on a latest spec-gate\\n    record of status built -- the re-approval path after an amendment\\n    that landed above the line after a real build.\\n    \\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"valid\\\")\\n    assert run_attavo(root, \\\"spec-gate\\\", \\\"1\\\").returncode == 0\\n    assert run_attavo(root, \\\"approve\\\", \\\"1\\\", \\\"--by\\\", \\\"alice\\\").returncode == 0\\n    commit_approval(root)\\n\\n    build = run_attavo(root, \\\"build\\\", \\\"1\\\", env={\\\"ATTAVO_FIXTURE_WRITE\\\": \\\"src/marker.txt\\\"})\\n    assert build.returncode == 0\\n\\n    amend_problem(root)\\n    built = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert built.returncode == 0\\n    latest_spec = sorted((root / \\\"records\\\" / \\\"1\\\").glob(\\\"spec-*.json\\\"))[-1]\\n    assert json.loads(latest_spec.read_text())[\\\"status\\\"] == \\\"built\\\"\\n\\n    run = run_attavo(root, \\\"approve\\\", \\\"1\\\", \\\"--by\\\", \\\"alice\\\")\\n    assert run.returncode == 0\\n    assert [p.name for p in approvals(root)] == [\\\"approval-01.json\\\", \\\"approval-02.json\\\"]\\n\\n\\ndef test_approve_refuses_shallow_checkout(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"On a --depth 1 clone, `git log -1 -- <path>` returns HEAD for every\\n    path (there is no history to prove otherwise), so a shallow checkout\\n    would compute a spec_sha that always matches HEAD and pass approval\\n    for a spec that may have moved. attavo approve must refuse instead of\\n    trusting that number: exit 2, naming the cause, not \\\"stale\\\".\\n    \\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"valid\\\")\\n    assert run_attavo(root, \\\"spec-gate\\\", \\\"1\\\").returncode == 0\\n    commit_all(root, \\\"spec-gate record\\\")\\n\\n    shallow = tmp_path / \\\"shallow\\\"\\n    clone_shallow(root, shallow)\\n\\n    run = run_attavo(shallow, \\\"approve\\\", \\\"1\\\", \\\"--by\\\", \\\"alice\\\")\\n    assert run.returncode == 2\\n    assert \\\"shallow checkout\\\" in run.stderr\\n    assert approvals(shallow) == []\\n\\n\\ndef test_approval_status_refuses_shallow_checkout(tmp_path: Path) -> None:\\n    root = make_tenant(tmp_path, \\\"valid\\\")\\n    assert run_attavo(root, \\\"spec-gate\\\", \\\"1\\\").returncode == 0\\n    assert run_attavo(root, \\\"approve\\\", \\\"1\\\", \\\"--by\\\", \\\"alice\\\").returncode == 0\\n    commit_all(root, \\\"spec-gate and approval records\\\")\\n\\n    shallow = tmp_path / \\\"shallow\\\"\\n    clone_shallow(root, shallow)\\n\\n    run = run_attavo(shallow, \\\"approval-status\\\", \\\"1\\\")\\n    assert run.returncode == 2\\n    assert \\\"shallow checkout\\\" in run.stderr\\n\\n\\n# --- an approval that is only in the working tree is nobody's act (item 224:\\n# build and verify ran on an approval record that had never been committed,\\n# and the merge queue's attest refused it as absent). Written red first\\n# against v0.29.0, where approval-status read the working-tree record as\\n# valid. ---\\n\\n\\ndef test_approval_status_reads_uncommitted_until_the_record_is_in_head(tmp_path: Path) -> None:\\n    root = make_tenant(tmp_path, \\\"valid\\\")\\n    assert run_attavo(root, \\\"spec-gate\\\", \\\"1\\\").returncode == 0\\n    assert run_attavo(root, \\\"approve\\\", \\\"1\\\", \\\"--by\\\", \\\"alice\\\").returncode == 0\\n    before = run_attavo(root, \\\"approval-status\\\", \\\"1\\\")\\n    assert (before.returncode, before.stdout.strip()) == (1, \\\"uncommitted\\\"), before.stdout + before.stderr\\n    commit_approval(root)\\n    after = run_attavo(root, \\\"approval-status\\\", \\\"1\\\")\\n    assert (after.returncode, after.stdout.strip()) == (0, \\\"valid\\\"), after.stdout + after.stderr\\n    record = approvals(root)[-1]\\n    record.write_text(record.read_text().replace(\\\"alice\\\", \\\"mallory\\\"))\\n    edited = run_attavo(root, \\\"approval-status\\\", \\\"1\\\")\\n    assert edited.stdout.strip() == \\\"uncommitted\\\", \\\"a committed record edited in the tree read as valid\\\"\\n\\n\\ndef test_build_refuses_an_uncommitted_approval_and_writes_no_record(tmp_path: Path) -> None:\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    assert run_attavo(root, \\\"spec-gate\\\", \\\"1\\\").returncode == 0\\n    assert run_attavo(root, \\\"approve\\\", \\\"1\\\", \\\"--by\\\", \\\"alice\\\").returncode == 0\\n    build = run_attavo(root, \\\"build\\\", \\\"1\\\")\\n    assert build.returncode == 1, build.stdout + build.stderr\\n    assert \\\"attavo build: refused: approval is uncommitted\\\" in build.stdout, build.stdout\\n    assert not list((root / \\\"records\\\" / \\\"1\\\").glob(\\\"build-*\\\")), \\\"a build record was written\\\"\\n    commit_approval(root)\\n    assert run_attavo(root, \\\"build\\\", \\\"1\\\").returncode == 0\\n\\n\\ndef test_approve_says_the_record_must_be_committed(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Red on the stub by design: the sentence is the build's. The command\\n    that writes the one record no script transports says so as it writes.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"valid\\\")\\n    assert run_attavo(root, \\\"spec-gate\\\", \\\"1\\\").returncode == 0\\n    run = run_attavo(root, \\\"approve\\\", \\\"1\\\", \\\"--by\\\", \\\"alice\\\")\\n    assert run.returncode == 0\\n    assert \\\"commit records/1/approval-01.json\\\" in run.stdout, run.stdout\\n    assert \\\"nothing runs on it until then\\\" in run.stdout, run.stdout\",\"stderr\":\"\",\"interrupted\":false,\"isImage\":false,\"noOutputExpected\":false}}\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmpjx6j98fk/diff.patch:113:+{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_017huXBYjgnT9aB8mvYr34zf\",\"type\":\"tool_result\",\"content\":\"from __future__ import annotations\\n\\nimport json\\nfrom pathlib import Path\\nfrom typing import Any\\n\\nfrom attavo.common import STAGES, ShallowCheckoutError, git\\nfrom attavo.doctor import invocations_without_record, merge_introducing_records, stall_bound_s\\nfrom attavo.drive import InvocationReading, drive_state, read_invocation, retry_state, uncommitted_record\\nfrom attavo.records import next_attempt_number, parse_attempts\\nfrom attavo.types import CounselRecord, DriveReport\\nfrom attavo.verify import FORGE_OK_CONCLUSIONS, FORGE_UNCONCLUDED_STATUSES, read_forge_checks\\n\\n# --- drive --report (reconciler R1, rulings A and G): what one item is\\n# waiting on, and for whom -- drive's own decision (drive_state, the\\n# invocation readers recovery uses, read_forge_checks) read without acting\\n# on it. It writes nothing, starts nothing, and reads the forge once and\\n# never polls it, so a refusal is a level anyone can read again rather than\\n# a line drive printed once. `says` speaks the operator's words: a stage is\\n# \\\"build\\\" or \\\"review\\\", never the command that runs it. ---\\n\\n_WORD = {\\\"build\\\": \\\"build\\\", \\\"verify\\\": \\\"review\\\"}\\n\\n_COUNSEL_SAYS = {\\\"answer\\\": \\\"has an answer\\\", \\\"patch\\\": \\\"found a product defect\\\",\\n                 \\\"person\\\": \\\"says it is a person's call\\\"}\\n\\n\\ndef _head(root: Path) -> str | None:\\n    try:\\n        return git(root, \\\"rev-parse\\\", \\\"HEAD\\\").strip() or None\\n    except RuntimeError:\\n        return None\\n\\n\\ndef _latest(records_dir: Path, stage: str) -> tuple[str, dict[str, Any]] | None:\\n    \\\"\\\"\\\"(stem, record) of the highest-numbered <stage>-NN.json, or None.\\\"\\\"\\\"\\n    attempts = parse_attempts(records_dir, stage)\\n    if not attempts:\\n        return None\\n    nn = max(attempts)\\n    return f\\\"{stage}-{nn:02d}\\\", attempts[nn]\\n\\n\\ndef _filed(records_dir: Path, stem: str) -> str | None:\\n    marker = records_dir / f\\\"{stem}.filed\\\"\\n    try:\\n        text = marker.read_text().strip()\\n    except OSError:\\n        return None\\n    return text or None\\n\\n\\ndef _counsel_of(records_dir: Path, stem: str) -> tuple[str, CounselRecord] | None:\\n    \\\"\\\"\\\"The latest counsel record that read the stop named stem.\\\"\\\"\\\"\\n    attempts = parse_attempts(records_dir, \\\"counsel\\\")\\n    for nn in sorted(attempts, reverse=True):\\n        if attempts[nn].get(\\\"record\\\") == stem:\\n            return f\\\"counsel-{nn:02d}\\\", attempts[nn]\\n    return None\\n\\n\\ndef _stopped(root: Path, m: dict[str, Any], r: DriveReport, records_dir: Path, stage: str,\\n            stem: str, record: dict[str, Any]) -> DriveReport:\\n    stop = record.get(\\\"stop\\\") or {}\\n    stop_class = stop.get(\\\"class\\\")\\n    attempt = int(stem.rsplit(\\\"-\\\", 1)[1])\\n    r[\\\"state\\\"], r[\\\"kind\\\"], r[\\\"stage\\\"] = \\\"stopped\\\", \\\"yours\\\", stage\\n    r[\\\"attempt\\\"], r[\\\"record\\\"], r[\\\"stop_class\\\"] = attempt, stem, stop_class\\n    r[\\\"filed\\\"] = _filed(records_dir, stem)\\n\\n    # R3: every attempt of this stage, side by side -- the exhaustion\\n    # report's own comparison, printed whether or not the budget is\\n    # actually spent yet, since a person reading --report wants the same\\n    # picture drive itself would act on.\\n    attempts = parse_attempts(records_dir, stage)\\n    rows: list[dict[str, Any]] = [\\n        {\\\"attempt\\\": nn, \\\"class\\\": (rec.get(\\\"stop\\\") or {}).get(\\\"class\\\"),\\n         \\\"signature\\\": (rec.get(\\\"stop\\\") or {}).get(\\\"signature\\\"),\\n         \\\"bound\\\": (rec.get(\\\"stop\\\") or {}).get(\\\"bound\\\"),\\n         \\\"wall_clock_s\\\": rec.get(\\\"wall_clock_s\\\"), \\\"cost_usd\\\": rec.get(\\\"cost_usd\\\")}\\n        for nn, rec in sorted(attempts.items())]\\n    r[\\\"attempts\\\"] = rows\\n    last_two = [row[\\\"signature\\\"] for row in rows[-2:]]\\n    signatures_match = bool(len(last_two) == 2 and last_two[0] is not None and last_two[0] == last_two[1])\\n    r[\\\"signatures_match\\\"] = signatures_match\\n    r[\\\"rulings_available\\\"] = [\\n        \\\"attavo drive N --again: reset the budget and start the next attempt\\\"\\n        + (\\\" (unlikely to help: the last two attempts failed the same way)\\\" if signatures_match else \\\"\\\"),\\n        \\\"amend the spec (moves the approval)\\\"]\\n\\n    state = retry_state(root, m, records_dir, stage, stop_class, attempt)\\n    how = f\\\"as {stop_class}\\\" if stop_class else f\\\"({record.get('status')})\\\"\\n    if state.waiting_s is not None:\\n        r[\\\"kind\\\"] = \\\"waits\\\"\\n        says = (f\\\"{_WORD[stage].capitalize()} attempt {attempt:02d} stopped {how}; retrying \\\"\\n                f\\\"{_WORD[stage]} in {int(state.waiting_s)} s\\\")\\n    elif state.eligible:\\n        r[\\\"kind\\\"] = \\\"acts\\\"\\n        says = f\\\"{_WORD[stage].capitalize()} attempt {attempt:02d} stopped {how}; the next pass retries it\\\"\\n    else:\\n        says = f\\\"Needs you: {_WORD[stage]} attempt {attempt:02d} stopped {how}\\\"\\n    counsel = _counsel_of(records_dir, stem)\\n    if counsel:\\n        r[\\\"counsel\\\"] = counsel[0]\\n        verdict = str(counsel[1].get(\\\"verdict\\\"))\\n        verdict_says = _COUNSEL_SAYS.get(verdict)\\n        says += f\\\"; {counsel[0]} {verdict_says or 'could not read it'}\\\"\\n        if verdict == \\\"patch\\\":\\n            says += f\\\"; waiting on {r['filed'] or 'the issue counsel filed'}\\\"\\n    if r[\\\"filed\\\"] and \\\"waiting on\\\" not in says:\\n        says += f\\\"; filed as {r['filed']}\\\"\\n    r[\\\"says\\\"] = says\\n    return r\\n\\n\\ndef _invocation(r: DriveReport, reading: InvocationReading, info: dict[str, Any],\\n                bound: int | None) -> DriveReport:\\n    stage, nn, _log, _last_at, age, cls, crossed = reading\\n    r[\\\"stage\\\"], r[\\\"attempt\\\"], r[\\\"stop_class\\\"] = stage, nn, None if cls == \\\"running\\\" else cls\\n    r[\\\"since\\\"] = info.get(\\\"at\\\") if isinstance(info.get(\\\"at\\\"), str) else None\\n    r[\\\"last_event_age_s\\\"] = None if age is None else int(age)\\n    word = _WORD[stage]\\n    if cls == \\\"running\\\":\\n        r[\\\"state\\\"], r[\\\"kind\\\"] = \\\"running\\\", \\\"waits\\\"\\n        r[\\\"says\\\"] = (f\\\"{word.capitalize()} running since {r['since'] or 'an unknown time'}; \\\"\\n                     f\\\"nothing to do until it finishes\\\")\\n    else:\\n        r[\\\"state\\\"], r[\\\"kind\\\"] = \\\"owes-recovery\\\", \\\"acts\\\"\\n        if cls == \\\"hung\\\" and crossed == \\\"ceiling\\\":\\n            # R3: a stage past its own ceiling is hung by wall clock\\n            # alone -- never worded in terms of event age, which an\\n            # adapter that streams no events never had to begin with.\\n            r[\\\"says\\\"] = (f\\\"{word.capitalize()} attempt {nn:02d} is alive {r['last_event_age_s']} s \\\"\\n                         f\\\"after it began, past its ceiling; recovery would end it and record it \\\"\\n                         f\\\"as hung\\\")\\n        elif cls == \\\"hung\\\":\\n            r[\\\"says\\\"] = (f\\\"{word.capitalize()} attempt {nn:02d} is alive but has had no event for \\\"\\n                         f\\\"{r['last_event_age_s']} s (bound {bound} s); recovery would end it and \\\"\\n                         f\\\"record it as hung\\\")\\n        else:\\n            r[\\\"says\\\"] = (f\\\"{word.capitalize()} attempt {nn:02d} is gone and wrote no record; \\\"\\n                         f\\\"recovery would record it as died\\\")\\n    return r\\n\\n\\ndef _pending(root: Path, m: dict[str, Any], records_dir: Path, r: DriveReport) -> DriveReport | None:\\n    \\\"\\\"\\\"The report for an invocation that began and wrote no record, or None\\n    when every invocation has its record. One that needs recovery reads\\n    before one still running: it is the one the next move is about. R2:\\n    a bound is no longer required to read this at all -- read_invocation\\n    reads alive from the heartbeat first, and needs a stall bound only to\\n    call a live, heartbeat-less invocation hung rather than running.\\\"\\\"\\\"\\n    pending = invocations_without_record(records_dir)\\n    if not pending:\\n        return None\\n    bound = stall_bound_s(m)\\n    readings = [(read_invocation(root, bound, marker, info), info) for marker, info in pending]\\n    reading, info = next(((rd, i) for rd, i in readings if rd.cls != \\\"running\\\"), readings[0])\\n    if reading.stage not in _WORD:\\n        r[\\\"state\\\"], r[\\\"kind\\\"] = \\\"refused\\\", \\\"yours\\\"\\n        r[\\\"says\\\"] = f\\\"Found an invocation marker for an unknown stage, {reading.stage}\\\"\\n        return r\\n    if reading.cls != \\\"running\\\" and next_attempt_number(records_dir, reading.stage) != reading.nn:\\n        r[\\\"state\\\"], r[\\\"kind\\\"], r[\\\"stage\\\"], r[\\\"attempt\\\"] = \\\"refused\\\", \\\"yours\\\", reading.stage, reading.nn\\n        r[\\\"says\\\"] = (f\\\"{_WORD[reading.stage].capitalize()} attempt {reading.nn:02d} wrote no record, but a \\\"\\n                     f\\\"later one exists; read the records before recovering\\\")\\n        return r\\n    return _invocation(r, reading, info, bound)\\n\\n\\ndef _uncommitted(root: Path, m: dict[str, Any], records_dir: Path, r: DriveReport,\\n                 stage: str) -> DriveReport | None:\\n    \\\"\\\"\\\"R2: a record the working tree carries but git has no commit for yet\\n    -- the moment between a worker's write and its own commit -- reads as\\n    running for as long as the invocation it belongs to still touches its\\n    heartbeat; one a stale heartbeat left behind is a refusal naming the\\n    file, not a silent read of a record that was never actually\\n    transported. None when the latest record for stage is already\\n    committed (the ordinary case).\\\"\\\"\\\"\\n    path = uncommitted_record(root, records_dir, stage)\\n    if path is None:\\n        return None\\n    nn = int(path.stem.rsplit(\\\"-\\\", 1)[1])\\n    marker = records_dir / f\\\"{stage}-{nn:02d}.started\\\"\\n    info: dict[str, Any] = {}\\n    if marker.is_file():\\n        try:\\n            with marker.open() as fh:\\n                loaded = json.load(fh)\\n            info = loaded if isinstance(loaded, dict) else {}\\n        except (OSError, ValueError):\\n            info = {}\\n    bound = stall_bound_s(m)\\n    reading = read_invocation(root, bound, marker, info) if marker.is_file() else None\\n    word = _WORD[stage]\\n    if reading is not None and reading.cls == \\\"running\\\":\\n        r[\\\"state\\\"], r[\\\"kind\\\"], r[\\\"stage\\\"], r[\\\"attempt\\\"] = \\\"running\\\", \\\"waits\\\", stage, nn\\n        r[\\\"since\\\"] = info.get(\\\"at\\\") if isinstance(info.get(\\\"at\\\"), str) else None\\n        r[\\\"says\\\"] = (f\\\"{word.capitalize()} running; its {stage}-{nn:02d}.json is written but \\\"\\n                     f\\\"not yet committed\\\")\\n        return r\\n    r[\\\"state\\\"], r[\\\"kind\\\"] = \\\"refused\\\", \\\"yours\\\"\\n    r[\\\"says\\\"] = f\\\"{path.name} exists but was never committed; its worker's heartbeat went stale first\\\"\\n    return r\\n\\n\\ndef _checks(r: DriveReport, forge_checks: dict[str, Any], ok: bool, ready: bool) -> DriveReport:\\n    \\\"\\\"\\\"Read the forge's answer on the head as a level: green, still\\n    running, or done and not green.\\\"\\\"\\\"\\n    conclusions: list[dict[str, str]] = forge_checks[\\\"conclusions\\\"]\\n    r[\\\"checks\\\"] = [{\\\"name\\\": c[\\\"name\\\"], \\\"conclusion\\\": c[\\\"conclusion\\\"]} for c in conclusions]\\n    head7 = (r[\\\"head\\\"] or \\\"\\\")[:7]\\n    if ok:\\n        if ready:\\n            r[\\\"state\\\"], r[\\\"kind\\\"], r[\\\"says\\\"] = \\\"ready-to-merge\\\", \\\"yours\\\", \\\"Ready to merge\\\"\\n        else:\\n            r[\\\"state\\\"], r[\\\"kind\\\"], r[\\\"stage\\\"] = \\\"next-review\\\", \\\"acts\\\", \\\"verify\\\"\\n            r[\\\"says\\\"] = f\\\"Review is next; the checks are green on {head7}\\\"\\n        return r\\n    unconcluded = [c for c in conclusions if c[\\\"conclusion\\\"] in FORGE_UNCONCLUDED_STATUSES]\\n    if unconcluded or not conclusions:\\n        named = \\\", \\\".join(f\\\"{c['name']} {c['conclusion']}\\\" for c in unconcluded) or \\\"no checks reported\\\"\\n        r[\\\"state\\\"], r[\\\"kind\\\"], r[\\\"stage\\\"] = \\\"waiting-on-checks\\\", \\\"waits\\\", None if ready else \\\"verify\\\"\\n        r[\\\"says\\\"] = f\\\"Waiting on the checks: {named} on {head7}\\\"\\n        return r\\n    named = (\\\", \\\".join(f\\\"{c['name']} {c['conclusion']}\\\" for c in conclusions\\n                       if c[\\\"conclusion\\\"] not in FORGE_OK_CONCLUSIONS)\\n             or \\\"the checks command did not succeed\\\")\\n    r[\\\"state\\\"], r[\\\"kind\\\"], r[\\\"stage\\\"] = \\\"blocked-on-checks\\\", \\\"waits\\\", None if ready else \\\"verify\\\"\\n    after = \\\"the item is ready to merge\\\" if ready else \\\"review starts\\\"\\n    r[\\\"says\\\"] = f\\\"Blocked: {named} on {head7}; {after} once the checks are green\\\"\\n    return r\\n\\n\\ndef drive_report(root: Path, m: dict[str, Any], item_id: str) -> DriveReport:\\n    \\\"\\\"\\\"The item's level, from the same reads `attavo drive` decides on --\\n    drive_state over its records, the markers recovery reads, one read of\\n    the forge -- and never an act: no record written, nothing started, no\\n    poll. A state for every item the records directory carries.\\\"\\\"\\\"\\n    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n    r: DriveReport = {\\\"item\\\": item_id, \\\"state\\\": \\\"refused\\\", \\\"kind\\\": \\\"yours\\\", \\\"says\\\": \\\"\\\", \\\"stage\\\": None,\\n                      \\\"attempt\\\": None, \\\"record\\\": None, \\\"stop_class\\\": None, \\\"counsel\\\": None,\\n                      \\\"filed\\\": None, \\\"head\\\": _head(root), \\\"checks\\\": None, \\\"since\\\": None,\\n                      \\\"last_event_age_s\\\": None, \\\"attempts\\\": None, \\\"signatures_match\\\": None,\\n                      \\\"rulings_available\\\": None}\\n\\n    merge, _ = merge_introducing_records(root, m[\\\"paths\\\"][\\\"records\\\"], item_id, STAGES)\\n    if merge:\\n        r[\\\"state\\\"], r[\\\"kind\\\"], r[\\\"says\\\"] = \\\"merged\\\", \\\"done\\\", f\\\"Merged in {merge[:7]}\\\"\\n        return r\\n\\n    try:\\n        step, why, _ = drive_state(root, m, item_id)\\n    except ShallowCheckoutError as exc:\\n        r[\\\"says\\\"] = f\\\"Cannot read this item: {exc}\\\"\\n        return r\\n    if step == \\\"no-approval\\\":\\n        r[\\\"state\\\"], r[\\\"kind\\\"] = \\\"waiting-on-approval\\\", \\\"yours\\\"\\n        if why == \\\"absent\\\":\\n            r[\\\"says\\\"] = \\\"Waiting on you: approve the spec\\\"\\n        elif why == \\\"uncommitted\\\":\\n            r[\\\"says\\\"] = (\\\"Waiting on you: the approval record is not committed; commit \\\"\\n                         f\\\"{m['paths']['records']}/{item_id}/approval-NN.json to the item's branch \\\"\\n                         \\\"before anything runs on it\\\")\\n        else:\\n            r[\\\"says\\\"] = (\\\"Waiting on you: the approval expired because the spec changed after it; \\\"\\n                         \\\"approve the spec again\\\")\\n        return r\\n\\n    pending = _pending(root, m, records_dir, r)\\n    if pending:\\n        return pending\\n\\n    if step in (\\\"build\\\", \\\"verify\\\"):\\n        held = _uncommitted(root, m, records_dir, r, step)\\n        if held:\\n            return held\\n\\n    build = _latest(records_dir, \\\"build\\\")\\n    if step == \\\"build\\\":\\n        approval = _latest(records_dir, \\\"approval\\\")\\n        if (build and build[1].get(\\\"status\\\") != \\\"pass\\\"\\n                and build[1].get(\\\"approval_sha\\\") == (approval[1].get(\\\"sha\\\") if approval else None)):\\n            return _stopped(root, m, r, records_dir, \\\"build\\\", build[0], build[1])\\n        r[\\\"state\\\"], r[\\\"kind\\\"], r[\\\"stage\\\"] = \\\"next-build\\\", \\\"acts\\\", \\\"build\\\"\\n        r[\\\"says\\\"] = \\\"Build is next\\\"\\n        return r\\n\\n    review = _latest(records_dir, \\\"verify\\\")\\n    if (step == \\\"verify\\\" and review and review[1].get(\\\"status\\\") != \\\"pass\\\"\\n            and build and review[1].get(\\\"build_sha\\\") == build[1].get(\\\"sha\\\")):\\n        return _stopped(root, m, r, records_dir, \\\"verify\\\", review[0], review[1])\\n\\n    checks_command = (m.get(\\\"forge\\\") or {}).get(\\\"checks_command\\\")\\n    if not checks_command:\\n        r[\\\"says\\\"] = \\\"No checks command is set in the manifest, so nothing can say whether the checks are green\\\"\\n        return r\\n    forge_checks, ok = read_forge_checks(root, checks_command, r[\\\"head\\\"] or \\\"\\\")\\n    return _checks(r, forge_checks, ok, ready=step == \\\"ready\\\")\",\"is_error\":false}]},\"parent_tool_use_id\":null,\"session_id\":\"c800e014-139e-45d2-ac41-2aa13e2f1485\",\"uuid\":\"41f2aedc-d1a9-4cac-9c7b-4571ef5583de\",\"timestamp\":\"2026-09-27T13:38:42.116Z\",\"tool_use_result\":{\"stdout\":\"from __future__ import annotations\\n\\nimport json\\nfrom pathlib import Path\\nfrom typing import Any\\n\\nfrom attavo.common import STAGES, ShallowCheckoutError, git\\nfrom attavo.doctor import invocations_without_record, merge_introducing_records, stall_bound_s\\nfrom attavo.drive import InvocationReading, drive_state, read_invocation, retry_state, uncommitted_record\\nfrom attavo.records import next_attempt_number, parse_attempts\\nfrom attavo.types import CounselRecord, DriveReport\\nfrom attavo.verify import FORGE_OK_CONCLUSIONS, FORGE_UNCONCLUDED_STATUSES, read_forge_checks\\n\\n# --- drive --report (reconciler R1, rulings A and G): what one item is\\n# waiting on, and for whom -- drive's own decision (drive_state, the\\n# invocation readers recovery uses, read_forge_checks) read without acting\\n# on it. It writes nothing, starts nothing, and reads the forge once and\\n# never polls it, so a refusal is a level anyone can read again rather than\\n# a line drive printed once. `says` speaks the operator's words: a stage is\\n# \\\"build\\\" or \\\"review\\\", never the command that runs it. ---\\n\\n_WORD = {\\\"build\\\": \\\"build\\\", \\\"verify\\\": \\\"review\\\"}\\n\\n_COUNSEL_SAYS = {\\\"answer\\\": \\\"has an answer\\\", \\\"patch\\\": \\\"found a product defect\\\",\\n                 \\\"person\\\": \\\"says it is a person's call\\\"}\\n\\n\\ndef _head(root: Path) -> str | None:\\n    try:\\n        return git(root, \\\"rev-parse\\\", \\\"HEAD\\\").strip() or None\\n    except RuntimeError:\\n        return None\\n\\n\\ndef _latest(records_dir: Path, stage: str) -> tuple[str, dict[str, Any]] | None:\\n    \\\"\\\"\\\"(stem, record) of the highest-numbered <stage>-NN.json, or None.\\\"\\\"\\\"\\n    attempts = parse_attempts(records_dir, stage)\\n    if not attempts:\\n        return None\\n    nn = max(attempts)\\n    return f\\\"{stage}-{nn:02d}\\\", attempts[nn]\\n\\n\\ndef _filed(records_dir: Path, stem: str) -> str | None:\\n    marker = records_dir / f\\\"{stem}.filed\\\"\\n    try:\\n        text = marker.read_text().strip()\\n    except OSError:\\n        return None\\n    return text or None\\n\\n\\ndef _counsel_of(records_dir: Path, stem: str) -> tuple[str, CounselRecord] | None:\\n    \\\"\\\"\\\"The latest counsel record that read the stop named stem.\\\"\\\"\\\"\\n    attempts = parse_attempts(records_dir, \\\"counsel\\\")\\n    for nn in sorted(attempts, reverse=True):\\n        if attempts[nn].get(\\\"record\\\") == stem:\\n            return f\\\"counsel-{nn:02d}\\\", attempts[nn]\\n    return None\\n\\n\\ndef _stopped(root: Path, m: dict[str, Any], r: DriveReport, records_dir: Path, stage: str,\\n            stem: str, record: dict[str, Any]) -> DriveReport:\\n    stop = record.get(\\\"stop\\\") or {}\\n    stop_class = stop.get(\\\"class\\\")\\n    attempt = int(stem.rsplit(\\\"-\\\", 1)[1])\\n    r[\\\"state\\\"], r[\\\"kind\\\"], r[\\\"stage\\\"] = \\\"stopped\\\", \\\"yours\\\", stage\\n    r[\\\"attempt\\\"], r[\\\"record\\\"], r[\\\"stop_class\\\"] = attempt, stem, stop_class\\n    r[\\\"filed\\\"] = _filed(records_dir, stem)\\n\\n    # R3: every attempt of this stage, side by side -- the exhaustion\\n    # report's own comparison, printed whether or not the budget is\\n    # actually spent yet, since a person reading --report wants the same\\n    # picture drive itself would act on.\\n    attempts = parse_attempts(records_dir, stage)\\n    rows: list[dict[str, Any]] = [\\n        {\\\"attempt\\\": nn, \\\"class\\\": (rec.get(\\\"stop\\\") or {}).get(\\\"class\\\"),\\n         \\\"signature\\\": (rec.get(\\\"stop\\\") or {}).get(\\\"signature\\\"),\\n         \\\"bound\\\": (rec.get(\\\"stop\\\") or {}).get(\\\"bound\\\"),\\n         \\\"wall_clock_s\\\": rec.get(\\\"wall_clock_s\\\"), \\\"cost_usd\\\": rec.get(\\\"cost_usd\\\")}\\n        for nn, rec in sorted(attempts.items())]\\n    r[\\\"attempts\\\"] = rows\\n    last_two = [row[\\\"signature\\\"] for row in rows[-2:]]\\n    signatures_match = bool(len(last_two) == 2 and last_two[0] is not None and last_two[0] == last_two[1])\\n    r[\\\"signatures_match\\\"] = signatures_match\\n    r[\\\"rulings_available\\\"] = [\\n        \\\"attavo drive N --again: reset the budget and start the next attempt\\\"\\n        + (\\\" (unlikely to help: the last two attempts failed the same way)\\\" if signatures_match else \\\"\\\"),\\n        \\\"amend the spec (moves the approval)\\\"]\\n\\n    state = retry_state(root, m, records_dir, stage, stop_class, attempt)\\n    how = f\\\"as {stop_class}\\\" if stop_class else f\\\"({record.get('status')})\\\"\\n    if state.waiting_s is not None:\\n        r[\\\"kind\\\"] = \\\"waits\\\"\\n        says = (f\\\"{_WORD[stage].capitalize()} attempt {attempt:02d} stopped {how}; retrying \\\"\\n                f\\\"{_WORD[stage]} in {int(state.waiting_s)} s\\\")\\n    elif state.eligible:\\n        r[\\\"kind\\\"] = \\\"acts\\\"\\n        says = f\\\"{_WORD[stage].capitalize()} attempt {attempt:02d} stopped {how}; the next pass retries it\\\"\\n    else:\\n        says = f\\\"Needs you: {_WORD[stage]} attempt {attempt:02d} stopped {how}\\\"\\n    counsel = _counsel_of(records_dir, stem)\\n    if counsel:\\n        r[\\\"counsel\\\"] = counsel[0]\\n        verdict = str(counsel[1].get(\\\"verdict\\\"))\\n        verdict_says = _COUNSEL_SAYS.get(verdict)\\n        says += f\\\"; {counsel[0]} {verdict_says or 'could not read it'}\\\"\\n        if verdict == \\\"patch\\\":\\n            says += f\\\"; waiting on {r['filed'] or 'the issue counsel filed'}\\\"\\n    if r[\\\"filed\\\"] and \\\"waiting on\\\" not in says:\\n        says += f\\\"; filed as {r['filed']}\\\"\\n    r[\\\"says\\\"] = says\\n    return r\\n\\n\\ndef _invocation(r: DriveReport, reading: InvocationReading, info: dict[str, Any],\\n                bound: int | None) -> DriveReport:\\n    stage, nn, _log, _last_at, age, cls, crossed = reading\\n    r[\\\"stage\\\"], r[\\\"attempt\\\"], r[\\\"stop_class\\\"] = stage, nn, None if cls == \\\"running\\\" else cls\\n    r[\\\"since\\\"] = info.get(\\\"at\\\") if isinstance(info.get(\\\"at\\\"), str) else None\\n    r[\\\"last_event_age_s\\\"] = None if age is None else int(age)\\n    word = _WORD[stage]\\n    if cls == \\\"running\\\":\\n        r[\\\"state\\\"], r[\\\"kind\\\"] = \\\"running\\\", \\\"waits\\\"\\n        r[\\\"says\\\"] = (f\\\"{word.capitalize()} running since {r['since'] or 'an unknown time'}; \\\"\\n                     f\\\"nothing to do until it finishes\\\")\\n    else:\\n        r[\\\"state\\\"], r[\\\"kind\\\"] = \\\"owes-recovery\\\", \\\"acts\\\"\\n        if cls == \\\"hung\\\" and crossed == \\\"ceiling\\\":\\n            # R3: a stage past its own ceiling is hung by wall clock\\n            # alone -- never worded in terms of event age, which an\\n            # adapter that streams no events never had to begin with.\\n            r[\\\"says\\\"] = (f\\\"{word.capitalize()} attempt {nn:02d} is alive {r['last_event_age_s']} s \\\"\\n                         f\\\"after it began, past its ceiling; recovery would end it and record it \\\"\\n                         f\\\"as hung\\\")\\n        elif cls == \\\"hung\\\":\\n            r[\\\"says\\\"] = (f\\\"{word.capitalize()} attempt {nn:02d} is alive but has had no event for \\\"\\n                         f\\\"{r['last_event_age_s']} s (bound {bound} s); recovery would end it and \\\"\\n                         f\\\"record it as hung\\\")\\n        else:\\n            r[\\\"says\\\"] = (f\\\"{word.capitalize()} attempt {nn:02d} is gone and wrote no record; \\\"\\n                         f\\\"recovery would record it as died\\\")\\n    return r\\n\\n\\ndef _pending(root: Path, m: dict[str, Any], records_dir: Path, r: DriveReport) -> DriveReport | None:\\n    \\\"\\\"\\\"The report for an invocation that began and wrote no record, or None\\n    when every invocation has its record. One that needs recovery reads\\n    before one still running: it is the one the next move is about. R2:\\n    a bound is no longer required to read this at all -- read_invocation\\n    reads alive from the heartbeat first, and needs a stall bound only to\\n    call a live, heartbeat-less invocation hung rather than running.\\\"\\\"\\\"\\n    pending = invocations_without_record(records_dir)\\n    if not pending:\\n        return None\\n    bound = stall_bound_s(m)\\n    readings = [(read_invocation(root, bound, marker, info), info) for marker, info in pending]\\n    reading, info = next(((rd, i) for rd, i in readings if rd.cls != \\\"running\\\"), readings[0])\\n    if reading.stage not in _WORD:\\n        r[\\\"state\\\"], r[\\\"kind\\\"] = \\\"refused\\\", \\\"yours\\\"\\n        r[\\\"says\\\"] = f\\\"Found an invocation marker for an unknown stage, {reading.stage}\\\"\\n        return r\\n    if reading.cls != \\\"running\\\" and next_attempt_number(records_dir, reading.stage) != reading.nn:\\n        r[\\\"state\\\"], r[\\\"kind\\\"], r[\\\"stage\\\"], r[\\\"attempt\\\"] = \\\"refused\\\", \\\"yours\\\", reading.stage, reading.nn\\n        r[\\\"says\\\"] = (f\\\"{_WORD[reading.stage].capitalize()} attempt {reading.nn:02d} wrote no record, but a \\\"\\n                     f\\\"later one exists; read the records before recovering\\\")\\n        return r\\n    return _invocation(r, reading, info, bound)\\n\\n\\ndef _uncommitted(root: Path, m: dict[str, Any], records_dir: Path, r: DriveReport,\\n                 stage: str) -> DriveReport | None:\\n    \\\"\\\"\\\"R2: a record the working tree carries but git has no commit for yet\\n    -- the moment between a worker's write and its own commit -- reads as\\n    running for as long as the invocation it belongs to still touches its\\n    heartbeat; one a stale heartbeat left behind is a refusal naming the\\n    file, not a silent read of a record that was never actually\\n    transported. None when the latest record for stage is already\\n    committed (the ordinary case).\\\"\\\"\\\"\\n    path = uncommitted_record(root, records_dir, stage)\\n    if path is None:\\n        return None\\n    nn = int(path.stem.rsplit(\\\"-\\\", 1)[1])\\n    marker = records_dir / f\\\"{stage}-{nn:02d}.started\\\"\\n    info: dict[str, Any] = {}\\n    if marker.is_file():\\n        try:\\n            with marker.open() as fh:\\n                loaded = json.load(fh)\\n            info = loaded if isinstance(loaded, dict) else {}\\n        except (OSError, ValueError):\\n            info = {}\\n    bound = stall_bound_s(m)\\n    reading = read_invocation(root, bound, marker, info) if marker.is_file() else None\\n    word = _WORD[stage]\\n    if reading is not None and reading.cls == \\\"running\\\":\\n        r[\\\"state\\\"], r[\\\"kind\\\"], r[\\\"stage\\\"], r[\\\"attempt\\\"] = \\\"running\\\", \\\"waits\\\", stage, nn\\n        r[\\\"since\\\"] = info.get(\\\"at\\\") if isinstance(info.get(\\\"at\\\"), str) else None\\n        r[\\\"says\\\"] = (f\\\"{word.capitalize()} running; its {stage}-{nn:02d}.json is written but \\\"\\n                     f\\\"not yet committed\\\")\\n        return r\\n    r[\\\"state\\\"], r[\\\"kind\\\"] = \\\"refused\\\", \\\"yours\\\"\\n    r[\\\"says\\\"] = f\\\"{path.name} exists but was never committed; its worker's heartbeat went stale first\\\"\\n    return r\\n\\n\\ndef _checks(r: DriveReport, forge_checks: dict[str, Any], ok: bool, ready: bool) -> DriveReport:\\n    \\\"\\\"\\\"Read the forge's answer on the head as a level: green, still\\n    running, or done and not green.\\\"\\\"\\\"\\n    conclusions: list[dict[str, str]] = forge_checks[\\\"conclusions\\\"]\\n    r[\\\"checks\\\"] = [{\\\"name\\\": c[\\\"name\\\"], \\\"conclusion\\\": c[\\\"conclusion\\\"]} for c in conclusions]\\n    head7 = (r[\\\"head\\\"] or \\\"\\\")[:7]\\n    if ok:\\n        if ready:\\n            r[\\\"state\\\"], r[\\\"kind\\\"], r[\\\"says\\\"] = \\\"ready-to-merge\\\", \\\"yours\\\", \\\"Ready to merge\\\"\\n        else:\\n            r[\\\"state\\\"], r[\\\"kind\\\"], r[\\\"stage\\\"] = \\\"next-review\\\", \\\"acts\\\", \\\"verify\\\"\\n            r[\\\"says\\\"] = f\\\"Review is next; the checks are green on {head7}\\\"\\n        return r\\n    unconcluded = [c for c in conclusions if c[\\\"conclusion\\\"] in FORGE_UNCONCLUDED_STATUSES]\\n    if unconcluded or not conclusions:\\n        named = \\\", \\\".join(f\\\"{c['name']} {c['conclusion']}\\\" for c in unconcluded) or \\\"no checks reported\\\"\\n        r[\\\"state\\\"], r[\\\"kind\\\"], r[\\\"stage\\\"] = \\\"waiting-on-checks\\\", \\\"waits\\\", None if ready else \\\"verify\\\"\\n        r[\\\"says\\\"] = f\\\"Waiting on the checks: {named} on {head7}\\\"\\n        return r\\n    named = (\\\", \\\".join(f\\\"{c['name']} {c['conclusion']}\\\" for c in conclusions\\n                       if c[\\\"conclusion\\\"] not in FORGE_OK_CONCLUSIONS)\\n             or \\\"the checks command did not succeed\\\")\\n    r[\\\"state\\\"], r[\\\"kind\\\"], r[\\\"stage\\\"] = \\\"blocked-on-checks\\\", \\\"waits\\\", None if ready else \\\"verify\\\"\\n    after = \\\"the item is ready to merge\\\" if ready else \\\"review starts\\\"\\n    r[\\\"says\\\"] = f\\\"Blocked: {named} on {head7}; {after} once the checks are green\\\"\\n    return r\\n\\n\\ndef drive_report(root: Path, m: dict[str, Any], item_id: str) -> DriveReport:\\n    \\\"\\\"\\\"The item's level, from the same reads `attavo drive` decides on --\\n    drive_state over its records, the markers recovery reads, one read of\\n    the forge -- and never an act: no record written, nothing started, no\\n    poll. A state for every item the records directory carries.\\\"\\\"\\\"\\n    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n    r: DriveReport = {\\\"item\\\": item_id, \\\"state\\\": \\\"refused\\\", \\\"kind\\\": \\\"yours\\\", \\\"says\\\": \\\"\\\", \\\"stage\\\": None,\\n                      \\\"attempt\\\": None, \\\"record\\\": None, \\\"stop_class\\\": None, \\\"counsel\\\": None,\\n                      \\\"filed\\\": None, \\\"head\\\": _head(root), \\\"checks\\\": None, \\\"since\\\": None,\\n                      \\\"last_event_age_s\\\": None, \\\"attempts\\\": None, \\\"signatures_match\\\": None,\\n                      \\\"rulings_available\\\": None}\\n\\n    merge, _ = merge_introducing_records(root, m[\\\"paths\\\"][\\\"records\\\"], item_id, STAGES)\\n    if merge:\\n        r[\\\"state\\\"], r[\\\"kind\\\"], r[\\\"says\\\"] = \\\"merged\\\", \\\"done\\\", f\\\"Merged in {merge[:7]}\\\"\\n        return r\\n\\n    try:\\n        step, why, _ = drive_state(root, m, item_id)\\n    except ShallowCheckoutError as exc:\\n        r[\\\"says\\\"] = f\\\"Cannot read this item: {exc}\\\"\\n        return r\\n    if step == \\\"no-approval\\\":\\n        r[\\\"state\\\"], r[\\\"kind\\\"] = \\\"waiting-on-approval\\\", \\\"yours\\\"\\n        if why == \\\"absent\\\":\\n            r[\\\"says\\\"] = \\\"Waiting on you: approve the spec\\\"\\n        elif why == \\\"uncommitted\\\":\\n            r[\\\"says\\\"] = (\\\"Waiting on you: the approval record is not committed; commit \\\"\\n                         f\\\"{m['paths']['records']}/{item_id}/approval-NN.json to the item's branch \\\"\\n                         \\\"before anything runs on it\\\")\\n        else:\\n            r[\\\"says\\\"] = (\\\"Waiting on you: the approval expired because the spec changed after it; \\\"\\n                         \\\"approve the spec again\\\")\\n        return r\\n\\n    pending = _pending(root, m, records_dir, r)\\n    if pending:\\n        return pending\\n\\n    if step in (\\\"build\\\", \\\"verify\\\"):\\n        held = _uncommitted(root, m, records_dir, r, step)\\n        if held:\\n            return held\\n\\n    build = _latest(records_dir, \\\"build\\\")\\n    if step == \\\"build\\\":\\n        approval = _latest(records_dir, \\\"approval\\\")\\n        if (build and build[1].get(\\\"status\\\") != \\\"pass\\\"\\n                and build[1].get(\\\"approval_sha\\\") == (approval[1].get(\\\"sha\\\") if approval else None)):\\n            return _stopped(root, m, r, records_dir, \\\"build\\\", build[0], build[1])\\n        r[\\\"state\\\"], r[\\\"kind\\\"], r[\\\"stage\\\"] = \\\"next-build\\\", \\\"acts\\\", \\\"build\\\"\\n        r[\\\"says\\\"] = \\\"Build is next\\\"\\n        return r\\n\\n    review = _latest(records_dir, \\\"verify\\\")\\n    if (step == \\\"verify\\\" and review and review[1].get(\\\"status\\\") != \\\"pass\\\"\\n            and build and review[1].get(\\\"build_sha\\\") == build[1].get(\\\"sha\\\")):\\n        return _stopped(root, m, r, records_dir, \\\"verify\\\", review[0], review[1])\\n\\n    checks_command = (m.get(\\\"forge\\\") or {}).get(\\\"checks_command\\\")\\n    if not checks_command:\\n        r[\\\"says\\\"] = \\\"No checks command is set in the manifest, so nothing can say whether the checks are green\\\"\\n        return r\\n    forge_checks, ok = read_forge_checks(root, checks_command, r[\\\"head\\\"] or \\\"\\\")\\n    return _checks(r, forge_checks, ok, ready=step == \\\"ready\\\")\",\"stderr\":\"\",\"interrupted\":false,\"isImage\":false,\"noOutputExpected\":false}}\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmpjx6j98fk/diff.patch:116:+{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01Q2DgfEUThj74ytBhjMsgXn\",\"type\":\"tool_result\",\"content\":\"--- attavo/approval.py\\t2026-09-27 07:38:18\\n+++ attest/specs/227/stub/attavo/approval.py\\t2026-09-27 07:38:18\\n@@ -13,7 +13,7 @@\\n     now_iso,\\n     read_manifest,\\n )\\n-from attavo.records import latest_record, write_record\\n+from attavo.records import latest_attempt_path, latest_record, write_record\\n \\n # --- approval, bound to a commit ---\\n \\n@@ -90,11 +90,28 @@\\n \\n     if latest_approval is None:\\n         return \\\"absent\\\"\\n+    if not record_is_committed(root, latest_attempt_path(records_dir, \\\"approval\\\")):\\n+        return \\\"uncommitted\\\"\\n     if latest_approval.get(\\\"spec_sha\\\") == spec_sha_now:\\n         return \\\"valid\\\"\\n     return \\\"expired\\\"\\n \\n \\n+def record_is_committed(root: Path, path: Path | None) -> bool:\\n+    \\\"\\\"\\\"Whether the record at path is in HEAD byte for byte. A record that\\n+    exists only in the working tree -- written by hand, or by a script\\n+    whose transport never ran -- is not the operator's act on the branch,\\n+    and no stage may run on it (item 224: build and verify ran on an\\n+    approval the merge queue's attest then refused as absent).\\\"\\\"\\\"\\n+    if path is None:\\n+        return False\\n+    rel = path.resolve().relative_to(root.resolve()).as_posix()\\n+    try:\\n+        return git(root, \\\"show\\\", f\\\"HEAD:{rel}\\\") == path.read_text()\\n+    except (RuntimeError, OSError):\\n+        return False\\n+\\n+\\n def cmd_approval_stat
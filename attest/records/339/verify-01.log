{\"model\":\"claude-sonnet-5\",\"id\":\"msg_011Cg2imNuy7F5bvqf2gte39\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_015bN8wxwAPPm3UA7xYz3BFb\",\"name\":\"Edit\",\"input\":{\"replace_all\":false,\"file_path\":\"/Users/davidbean/Projects/attavo-worktree-339/attavo/store.py\",\"old_string\":\"def put(root: Path, name: str, body: Any, base: int, by: str,\\n        check: Callable[[Any], list[str]] | None = None) -> dict[str, Any]:\\n    \\\"\\\"\\\"Write version base+1 of name, or refuse: a stale base, an empty\\n    author, a body the check refuses, or a writer that landed first.\\\"\\\"\\\"\\n    if not by.strip():\\n        raise StoreRefusal(\\\"a write names its author (--by)\\\")\\n    if check is not None:\\n        errors = check(body)\\n        if errors:\\n            raise StoreRefusal(f\\\"the {name} body is refused: \\\" + \\\"; \\\".join(errors))\\n    current = latest(root, name)\\n    if base != current:\\n        raise StoreRefusal(_moved(root, name, base, current))\\n    d = _doc_dir(root, name)\\n    d.mkdir(parents=True, exist_ok=True)\\n    envelope = {\\\"name\\\": name, \\\"version\\\": base + 1, \\\"base\\\": base, \\\"sha256\\\": body_sha256(body),\\n                \\\"by\\\": by, \\\"at\\\": now_iso(), \\\"body\\\": body}\",\"new_string\":\"def put(root: Path, name: str, body: Any, base: int, by: str,\\n        check: Callable[[Any], list[str]] | None = None, at: str | None = None) -> dict[str, Any]:\\n    \\\"\\\"\\\"Write version base+1 of name, or refuse: a stale base, an empty\\n    author, a body the check refuses, or a writer that landed first. at\\n    stamps the version; the default reads the clock, but a caller that\\n    already stamped part of the body (e.g. a plan claim) passes that same\\n    stamp here so the two agree by construction rather than by chance.\\\"\\\"\\\"\\n    if not by.strip():\\n        raise StoreRefusal(\\\"a write names its author (--by)\\\")\\n    if check is not None:\\n        errors = check(body)\\n        if errors:\\n            raise StoreRefusal(f\\\"the {name} body is refused: \\\" + \\\"; \\\".join(errors))\\n    current = latest(root, name)\\n    if base != current:\\n        raise StoreRefusal(_moved(root, name, base, current))\\n    d = _doc_dir(root, name)\\n    d.mkdir(parents=True, exist_ok=True)\\n    envelope = {\\\"name\\\": name, \\\"version\\\": base + 1, \\\"base\\\": base, \\\"sha256\\\": body_sha256(body),\\n                \\\"by\\\": by, \\\"at\\\": at if at is not None else now_iso(), \\\"body\\\": body}\"},\"caller\":{\"type\":\"direct\"}}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":331,\"cache_read_input_tokens\":43951,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":331},\"output_tokens\":8,\"service_tier\":\"standard\",\"inference_geo\":\"global\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"4eecc161-6573-44a2-80b2-9b0f791072cd\",\"uuid\":\"2087809b-4b03-42d1-95e2-f537a87b1bd2\",\"timestamp\":\"2026-10-14T19:58:34.240Z\",\"request_id\":\"req_011Cg2imNgqHPCatS1PKQoPr\",\"wire_tool_inputs\":{\"toolu_015bN8wxwAPPm3UA7xYz3BFb\":{\"file_path\":\"/Users/davidbean/Projects/attavo-worktree-339/attavo/store.py\",\"old_string\":\"def put(root: Path, name: str, body: Any, base: int, by: str,\\n        check: Callable[[Any], list[str]] | None = None) -> dict[str, Any]:\\n    \\\"\\\"\\\"Write version base+1 of name, or refuse: a stale base, an empty\\n    author, a body the check refuses, or a writer that landed first.\\\"\\\"\\\"\\n    if not by.strip():\\n        raise StoreRefusal(\\\"a write names its author (--by)\\\")\\n    if check is not None:\\n        errors = check(body)\\n        if errors:\\n            raise StoreRefusal(f\\\"the {name} body is refused: \\\" + \\\"; \\\".join(errors))\\n    current = latest(root, name)\\n    if base != current:\\n        raise StoreRefusal(_moved(root, name, base, current))\\n    d = _doc_dir(root, name)\\n    d.mkdir(parents=True, exist_ok=True)\\n    envelope = {\\\"name\\\": name, \\\"version\\\": base + 1, \\\"base\\\": base, \\\"sha256\\\": body_sha256(body),\\n                \\\"by\\\": by, \\\"at\\\": now_iso(), \\\"body\\\": body}\",\"new_string\":\"def put(root: Path, name: str, body: Any, base: int, by: str,\\n        check: Callable[[Any], list[str]] | None = None, at: str | None = None) -> dict[str, Any]:\\n    \\\"\\\"\\\"Write version base+1 of name, or refuse: a stale base, an empty\\n    author, a body the check refuses, or a writer that landed first. at\\n    stamps the version; the default reads the clock, but a caller that\\n    already stamped part of the body (e.g. a plan claim) passes that same\\n    stamp here so the two agree by construction rather than by chance.\\\"\\\"\\\"\\n    if not by.strip():\\n        raise StoreRefusal(\\\"a write names its author (--by)\\\")\\n    if check is not None:\\n        errors = check(body)\\n        if errors:\\n            raise StoreRefusal(f\\\"the {name} body is refused: \\\" + \\\"; \\\".join(errors))\\n    current = latest(root, name)\\n    if base != current:\\n        raise StoreRefusal(_moved(root, name, base, current))\\n    d = _doc_dir(root, name)\\n    d.mkdir(parents=True, exist_ok=True)\\n    envelope = {\\\"name\\\": name, \\\"version\\\": base + 1, \\\"base\\\": base, \\\"sha256\\\": body_sha256(body),\\n                \\\"by\\\": by, \\\"at\\\": at if at is not None else now_iso(), \\\"body\\\": body}\"}}}\n+{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_015bN8wxwAPPm3UA7xYz3BFb\",\"type\":\"tool_result\",\"content\":\"The file /Users/davidbean/Projects/attavo-worktree-339/attavo/store.py has been updated successfully.\"}]},\"parent_tool_use_id\":null,\"session_id\":\"4eecc161-6573-44a2-80b2-9b0f791072cd\",\"uuid\":\"d508bdd1-9c99-4f2a-a245-df16582f2e97\",\"timestamp\":\"2026-10-14T19:58:34.248Z\",\"tool_use_result\":{\"filePath\":\"/Users/davidbean/Projects/attavo-worktree-339/attavo/store.py\",\"oldString\":\"def put(root: Path, name: str, body: Any, base: int, by: str,\\n        check: Callable[[Any], list[str]] | None = None) -> dict[str, Any]:\\n    \\\"\\\"\\\"Write version base+1 of name, or refuse: a stale base, an empty\\n    author, a body the check refuses, or a writer that landed first.\\\"\\\"\\\"\\n    if not by.strip():\\n        raise StoreRefusal(\\\"a write names its author (--by)\\\")\\n    if check is not None:\\n        errors = check(body)\\n        if errors:\\n            raise StoreRefusal(f\\\"the {name} body is refused: \\\" + \\\"; \\\".join(errors))\\n    current = latest(root, name)\\n    if base != current:\\n        raise StoreRefusal(_moved(root, name, base, current))\\n    d = _doc_dir(root, name)\\n    d.mkdir(parents=True, exist_ok=True)\\n    envelope = {\\\"name\\\": name, \\\"version\\\": base + 1, \\\"base\\\": base, \\\"sha256\\\": body_sha256(body),\\n                \\\"by\\\": by, \\\"at\\\": now_iso(), \\\"body\\\": body}\",\"newString\":\"def put(root: Path, name: str, body: Any, base: int, by: str,\\n        check: Callable[[Any], list[str]] | None = None, at: str | None = None) -> dict[str, Any]:\\n    \\\"\\\"\\\"Write version base+1 of name, or refuse: a stale base, an empty\\n    author, a body the check refuses, or a writer that landed first. at\\n    stamps the version; the default reads the clock, but a caller that\\n    already stamped part of the body (e.g. a plan claim) passes that same\\n    stamp here so the two agree by construction rather than by chance.\\\"\\\"\\\"\\n    if not by.strip():\\n        raise StoreRefusal(\\\"a write names its author (--by)\\\")\\n    if check is not None:\\n        errors = check(body)\\n        if errors:\\n            raise StoreRefusal(f\\\"the {name} body is refused: \\\" + \\\"; \\\".join(errors))\\n    current = latest(root, name)\\n    if base != current:\\n        raise StoreRefusal(_moved(root, name, base, current))\\n    d = _doc_dir(root, name)\\n    d.mkdir(parents=True, exist_ok=True)\\n    envelope = {\\\"name\\\": name, \\\"version\\\": base + 1, \\\"base\\\": base, \\\"sha256\\\": body_sha256(body),\\n                \\\"by\\\": by, \\\"at\\\": at if at is not None else now_iso(), \\\"body\\\": body}\",\"originalFile\":\"\\\"\\\"\\\"The product's datastore: versioned documents keyed to the tenant.\\n\\nThe storage ruling (2026-09-25) splits what the product keeps in three:\\ngit holds the facts the attestation binds to; this store holds working\\nmaterial it does not bind to -- first the Plan's documents -- and never a\\nrecord; content-addressed bulk holds the bytes a record points at by hash.\\n\\nA document is a folder <store>/<name>/ with one file per version,\\n<n>.json: {\\\"name\\\", \\\"version\\\", \\\"base\\\", \\\"sha256\\\", \\\"by\\\", \\\"at\\\", \\\"body\\\"}. A\\nwrite names the version it read (its base) and creates <base+1>.json\\nthrough a hard link from a finished temporary file, which fails when that\\nversion already exists: two writers from the same base cannot both land,\\nthe loser is refused by name, and a reader never sees a half-written file.\\nNo database, no lock, and the same behaviour on a mounted folder.\\n\\nThe store lives under the clone's git common dir, <common>/attavo/store/,\\nso every worktree of a clone reads the same store and nothing in it is\\never staged; ATTAVO_STORE overrides the location. It is per clone and per\\nmachine: sharing across people is the multi-user step, and a hosted engine\\nreplaces this module then without changing a caller of get, put or log.\\n\\\"\\\"\\\"\\nfrom __future__ import annotations\\n\\nimport hashlib\\nimport json\\nimport os\\nimport re\\nimport subprocess\\nimport tempfile\\nfrom pathlib import Path\\nfrom typing import Any, Callable\\n\\nfrom attavo.common import now_iso, git_env\\n\\nNAME = re.compile(r\\\"^[a-z][a-z0-9-]*$\\\")\\nVERSION_FILE = re.compile(r\\\"^([0-9]+)\\\\.json$\\\")\\n\\n\\nclass StoreRefusal(Exception):\\n    \\\"\\\"\\\"A write or read the store refuses, with the reason as its message.\\\"\\\"\\\"\\n\\n\\ndef store_root(root: Path) -> Path:\\n    \\\"\\\"\\\"<git common dir>/attavo/store for the clone holding root, or\\n    ATTAVO_STORE when it is set.\\\"\\\"\\\"\\n    env = os.environ.get(\\\"ATTAVO_STORE\\\")\\n    if env:\\n        return Path(env).expanduser().resolve()\\n    run = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"rev-parse\\\", \\\"--git-common-dir\\\"],\\n                         capture_output=True, text=True, check=False, env=git_env())\\n    common = run.stdout.strip()\\n    if run.returncode != 0 or not common:\\n        raise StoreRefusal(f\\\"{root} is not in a git clone and ATTAVO_STORE is not set\\\")\\n    return (root / common).resolve() / \\\"attavo\\\" / \\\"store\\\"\\n\\n\\ndef _doc_dir(root: Path, name: str) -> Path:\\n    if not NAME.match(name):\\n        raise StoreRefusal(f\\\"{name!r} is not a document name\\\")\\n    return store_root(root) / name\\n\\n\\ndef body_sha256(body: Any) -> str:\\n    canonical = json.dumps(body, sort_keys=True, separators=(\\\",\\\", \\\":\\\"), ensure_ascii=False)\\n    return hashlib.sha256(canonical.encode()).hexdigest()\\n\\n\\ndef versions(root: Path, name: str) -> list[int]:\\n    d = _doc_dir(root, name)\\n    if not d.is_dir():\\n        return []\\n    found = (VERSION_FILE.match(p.name) for p in d.iterdir())\\n    return sorted(int(m.group(1)) for m in found if m)\\n\\n\\ndef latest(root: Path, name: str) -> int:\\n    \\\"\\\"\\\"The latest version, 0 when the document has none.\\\"\\\"\\\"\\n    vs = versions(root, name)\\n    return vs[-1] if vs else 0\\n\\n\\ndef get(root: Path, name: str, version: int | None = None) -> dict[str, Any] | None:\\n    \\\"\\\"\\\"The envelope of one version (the latest by default), None when absent.\\\"\\\"\\\"\\n    v = latest(root, name) if version is None else version\\n    if v <= 0:\\n        return None\\n    path = _doc_dir(root, name) / f\\\"{v}.json\\\"\\n    if not path.is_file():\\n        return None\\n    envelope: dict[str, Any] = json.loads(path.read_text())\\n    return envelope\\n\\n\\ndef log(root: Path, name: str) -> list[dict[str, Any]]:\\n    \\\"\\\"\\\"Every version's envelope without its body, oldest first.\\\"\\\"\\\"\\n    out = []\\n    for v in versions(root, name):\\n        env = get(root, name, v)\\n        if env is not None:\\n            out.append({k: env[k] for k in (\\\"version\\\", \\\"base\\\", \\\"sha256\\\", \\\"by\\\", \\\"at\\\")})\\n    return out\\n\\n\\ndef put(root: Path, name: str, body: Any, base: int, by: str,\\n        check: Callable[[Any], list[str]] | None = None) -> dict[str, Any]:\\n    \\\"\\\"\\\"Write version base+1 of name, or refuse: a stale base, an empty\\n    author, a body the check refuses, or a writer that landed first.\\\"\\\"\\\"\\n    if not by.strip():\\n        raise StoreRefusal(\\\"a write names its author (--by)\\\")\\n    if check is not None:\\n        errors = check(body)\\n        if errors:\\n            raise StoreRefusal(f\\\"the {name} body is refused: \\\" + \\\"; \\\".join(errors))\\n    current = latest(root, name)\\n    if base != current:\\n        raise StoreRefusal(_moved(root, name, base, current))\\n    d = _doc_dir(root, name)\\n    d.mkdir(parents=True, exist_ok=True)\\n    envelope = {\\\"name\\\": name, \\\"version\\\": base + 1, \\\"base\\\": base, \\\"sha256\\\": body_sha256(body),\\n                \\\"by\\\": by, \\\"at\\\": now_iso(), \\\"body\\\": body}\\n    fd, tmp = tempfile.mkstemp(dir=d, prefix=\\\".put-\\\", suffix=\\\".json\\\")\\n    try:\\n        with os.fdopen(fd, \\\"w\\\") as f:\\n            f.write(json.dumps(envelope, indent=2, ensure_ascii=False) + \\\"\\\\n\\\")\\n        try:\\n            os.link(tmp, d / f\\\"{base + 1}.json\\\")\\n        except FileExistsError:\\n            raise StoreRefusal(_moved(root, name, base, latest(root, name))) from None\\n    finally:\\n        os.unlink(tmp)\\n    return envelope\\n\\n\\ndef _moved(root: Path, name: str, base: int, current: int) -> str:\\n    if current == 0:\\n        return f\\\"the {name} document has no version yet; write it with base 0, not {base}\\\"\\n    env = get(root, name, current) or {}\\n    return (f\\\"the {name} document moved: base {base} is not the latest; the latest is \\\"\\n            f\\\"version {current}, written by {env.get('by')} at {env.get('at')}\\\")\\n\",\"structuredPatch\":[{\"oldStart\":102,\"oldLines\":9,\"newStart\":102,\"newLines\":12,\"lines\":[\" \",\" \",\" def put(root: Path, name: str, body: Any, base: int, by: str,\",\"-        check: Callable[[Any], list[str]] | None = None) -> dict[str, Any]:\",\"+        check: Callable[[Any], list[str]] | None = None, at: str | None = None) -> dict[str, Any]:\",\"     \\\"\\\"\\\"Write version base+1 of name, or refuse: a stale base, an empty\",\"-    author, a body the check refuses, or a writer that landed first.\\\"\\\"\\\"\",\"+    author, a body the check refuses, or a writer that landed first. at\",\"+    stamps the version; the default reads the clock, but a caller that\",\"+    already stamped part of the body (e.g. a plan claim) passes that same\",\"+    stamp here so the two agree by construction rather than by chance.\\\"\\\"\\\"\",\"     if not by.strip():\",\"         raise StoreRefusal(\\\"a write names its author (--by)\\\")\",\"     if check is not None:\"]},{\"oldStart\":117,\"oldLines\":7,\"newStart\":120,\"newLines\":7,\"lines\":[\"     d = _doc_dir(root, name)\",\"     d.mkdir(parents=True, exist_ok=True)\",\"     envelope = {\\\"name\\\": name, \\\"version\\\": base + 1, \\\"base\\\": base, \\\"sha256\\\": body_sha256(body),\",\"-                \\\"by\\\": by, \\\"at\\\": now_iso(), \\\"body\\\": body}\",\"+                \\\"by\\\": by, \\\"at\\\": at if at is not None else now_iso(), \\\"body\\\": body}\",\"     fd, tmp = tempfile.mkstemp(dir=d, prefix=\\\".put-\\\", suffix=\\\".json\\\")\",\"     try:\",\"         with os.fdopen(fd, \\\"w\\\") as f:\"]}],\"userModified\":false,\"replaceAll\":false,\"contentNotInModelContext\":true},\"tool_result_meta\":[{\"id\":\"toolu_015bN8wxwAPPm3UA7xYz3BFb\",\"permission_decision\":{\"decision\":\"accept\",\"source\":\"config\",\"reason_type\":\"rule\"}}]}\n+{\"type\":\"assistant\",\"message\":{\"model\":\"claude-sonnet-5\",\"id\":\"msg_011Cg2ioA66uh7SqC396Y1vo\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"Now update plan.py's `set_claims` to take `at`, and thread it through `_write`/`cmd_plan`.\"}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":2894,\"cache_read_input_tokens\":44282,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":2894},\"output_tokens\":8,\"service_tier\":\"standard\",\"inference_geo\":\"global\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"4eecc161-6573-44a2-80b2-9b0f791072cd\",\"uuid\":\"010af0e0-ea49-4173-a8bb-34699d8245ee\",\"timestamp\":\"2026-10-14T19:58:35.275Z\",\"request_id\":\"req_011Cg2io9sxHdTKtJK6Xs1S9\"}\n+{\"type\":\"assistant\",\"message\":{\"model\":\"claude-sonnet-5\",\"id\":\"msg_011Cg2ioA66uh7SqC396Y1vo\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_01DWc9BkccazqHzT4rXhRJez\",\"name\":\"Edit\",\"input\":{\"replace_all\":false,\"file_path\":\"/Users/davidbean/Projects/attavo-worktree-339/attavo/plan.py\",\"old_string\":\"def set_claims(body: dict[str, Any], what: str, paths: list[str], by: str) -> dict[str, Any]:\\n    \\\"\\\"\\\"A copy of body with issue what's draft claims set to paths, who set\\n    them and when. Raises StoreRefusal.\\\"\\\"\\\"\\n    n = _issue_arg(what)\\n    if n is None:\\n        raise store.StoreRefusal(f\\\"{what} is not an issue number\\\")\\n    if _epic_of(body, n) is None:\\n        raise store.StoreRefusal(f\\\"#{n} is not in the plan; place it with `attavo plan move #{n} --epic E`\\\")\\n    bad = [e for e in map(path_error, paths) if e]\\n    if not paths or bad:\\n        raise store.StoreRefusal(bad[0] if bad else \\\"claims names at least one path\\\")\\n    new: dict[str, Any] = copy.deepcopy(body)\\n    new.setdefault(\\\"claims\\\", {})[str(n)] = {\\\"paths\\\": list(paths), \\\"by\\\": by, \\\"at\\\": now_iso()}\\n    return new\",\"new_string\":\"def set_claims(body: dict[str, Any], what: str, paths: list[str], by: str, at: str) -> dict[str, Any]:\\n    \\\"\\\"\\\"A copy of body with issue what's draft claims set to paths, who set\\n    them and when (at, read once by the caller and also given to the\\n    store write, so the claim and its version agree). Raises StoreRefusal.\\\"\\\"\\\"\\n    n = _issue_arg(what)\\n    if n is None:\\n        raise store.StoreRefusal(f\\\"{what} is not an issue number\\\")\\n    if _epic_of(body, n) is None:\\n        raise store.StoreRefusal(f\\\"#{n} is not in the plan; place it with `attavo plan move #{n} --epic E`\\\")\\n    bad = [e for e in map(path_error, paths) if e]\\n    if not paths or bad:\\n        raise store.StoreRefusal(bad[0] if bad else \\\"claims names at least one path\\\")\\n    new: dict[str, Any] = copy.deepcopy(body)\\n    new.setdefault(\\\"claims\\\", {})[str(n)] = {\\\"paths\\\": list(paths), \\\"by\\\": by, \\\"at\\\": at}\\n    return new\"},\"caller\":{\"type\":\"direct\"}}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":2894,\"cache_read_input_tokens\":44282,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":2894},\"output_tokens\":8,\"service_tier\":\"standard\",\"inference_geo\":\"global\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"4eecc161-6573-44a2-80b2-9b0f791072cd\",\"uuid\":\"79358a72-60ee-4e61-9820-cdcd32f099d2\",\"timestamp\":\"2026-10-14T19:58:40.518Z\",\"request_id\":\"req_011Cg2io9sxHdTKtJK6Xs1S9\",\"wire_tool_inputs\":{\"toolu_01DWc9BkccazqHzT4rXhRJez\":{\"file_path\":\"/Users/davidbean/Projects/attavo-worktree-339/attavo/plan.py\",\"old_string\":\"def set_claims(body: dict[str, Any], what: str, paths: list[str], by: str) -> dict[str, Any]:\\n    \\\"\\\"\\\"A copy of body with issue what's draft claims set to paths, who set\\n    them and when. Raises StoreRefusal.\\\"\\\"\\\"\\n    n = _issue_arg(what)\\n    if n is None:\\n        raise store.StoreRefusal(f\\\"{what} is not an issue number\\\")\\n    if _epic_of(body, n) is None:\\n        raise store.StoreRefusal(f\\\"#{n} is not in the plan; place it with `attavo plan move #{n} --epic E`\\\")\\n    bad = [e for e in map(path_error, paths) if e]\\n    if not paths or bad:\\n        raise store.StoreRefusal(bad[0] if bad else \\\"claims names at least one path\\\")\\n    new: dict[str, Any] = copy.deepcopy(body)\\n    new.setdefault(\\\"claims\\\", {})[str(n)] = {\\\"paths\\\": list(paths), \\\"by\\\": by, \\\"at\\\": now_iso()}\\n    return new\",\"new_string\":\"def set_claims(body: dict[str, Any], what: str, paths: list[str], by: str, at: str) -> dict[str, Any]:\\n    \\\"\\\"\\\"A copy of body with issue what's draft claims set to paths, who set\\n    them and when (at, read once by the caller and also given to the\\n    store write, so the claim and its version agree). Raises StoreRefusal.\\\"\\\"\\\"\\n    n = _issue_arg(what)\\n    if n is None:\\n        raise store.StoreRefusal(f\\\"{what} is not an issue number\\\")\\n    if _epic_of(body, n) is None:\\n        raise store.StoreRefusal(f\\\"#{n} is not in the plan; place it with `attavo plan move #{n} --epic E`\\\")\\n    bad = [e for e in map(path_error, paths) if e]\\n    if not paths or bad:\\n        raise store.StoreRefusal(bad[0] if bad else \\\"claims names at least one path\\\")\\n    new: dict[str, Any] = copy.deepcopy(body)\\n    new.setdefault(\\\"claims\\\", {})[str(n)] = {\\\"paths\\\": list(paths), \\\"by\\\": by, \\\"at\\\": at}\\n    return new\"}}}\n+{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01DWc9BkccazqHzT4rXhRJez\",\"type\":\"tool_result\",\"content\":\"The file /Users/davidbean/Projects/attavo-worktree-339/attavo/plan.py has been updated successfully.\"}]},\"parent_tool_use_id\":null,\"session_id\":\"4eecc161-6573-44a2-80b2-9b0f791072cd\",\"uuid\":\"4fe685ee-9d09-4fdf-a0f9-96ea46ca9ab8\",\"timestamp\":\"2026-10-14T19:58:40.555Z\",\"tool_use_result\":{\"filePath\":\"/Users/davidbean/Projects/attavo-worktree-339/attavo/plan.py\",\"oldString\":\"def set_claims(body: dict[str, Any], what: str, paths: list[str], by: str) -> dict[str, Any]:\\n    \\\"\\\"\\\"A copy of body with issue what's draft claims set to paths, who set\\n    them and when. Raises StoreRefusal.\\\"\\\"\\\"\\n    n = _issue_arg(what)\\n    if n is None:\\n        raise store.StoreRefusal(f\\\"{what} is not an issue number\\\")\\n    if _epic_of(body, n) is None:\\n        raise store.StoreRefusal(f\\\"#{n} is not in the plan; place it with `attavo plan move #{n} --epic E`\\\")\\n    bad = [e for e in map(path_error, paths) if e]\\n    if not paths or bad:\\n        raise store.StoreRefusal(bad[0] if bad else \\\"claims names at least one path\\\")\\n    new: dict[str, Any] = copy.deepcopy(body)\\n    new.setdefault(\\\"claims\\\", {})[str(n)] = {\\\"paths\\\": list(paths), \\\"by\\\": by, \\\"at\\\": now_iso()}\\n    return new\",\"newString\":\"def set_claims(body: dict[str, Any], what: str, paths: list[str], by: str, at: str) -> dict[str, Any]:\\n    \\\"\\\"\\\"A copy of body with issue what's draft claims set to paths, who set\\n    them and when (at, read once by the caller and also given to the\\n    store write, so the claim and its version agree). Raises StoreRefusal.\\\"\\\"\\\"\\n    n = _issue_arg(what)\\n    if n is None:\\n        raise store.StoreRefusal(f\\\"{what} is not an issue number\\\")\\n    if _epic_of(body, n) is None:\\n        raise store.StoreRefusal(f\\\"#{n} is not in the plan; place it with `attavo plan move #{n} --epic E`\\\")\\n    bad = [e for e in map(path_error, paths) if e]\\n    if not paths or bad:\\n        raise store.StoreRefusal(bad[0] if bad else \\\"claims names at least one path\\\")\\n    new: dict[str, Any] = copy.deepcopy(body)\\n    new.setdefault(\\\"claims\\\", {})[str(n)] = {\\\"paths\\\": list(paths), \\\"by\\\": by, \\\"at\\\": at}\\n    return new\",\"originalFile\":\"\\\"\\\"\\\"attavo plan: the Plan's order, kept in the product's datastore.\\n\\nThe plan is one document in the store (attavo/store.py), named \\\"plan\\\":\\nthe epics in rank order, each with its issues in rank order; the edges\\nbetween issues (\\\"depends\\\", and \\\"ruled\\\" with who ruled it and when); the\\ndraft claims of issues that have no spec yet (who set them and when); and\\nthe policy lines. It holds no issue text or state -- the forge holds\\nthose -- and it is never committed: priority is working\\nmaterial the attestation does not bind to (the storage ruling), so a\\nre-rank is a new version of this document, not a commit, a pull request\\nor a merge. Git takes over when an issue becomes a spec.\\n\\nThe global order is epic rank, then issue rank within the epic. Backlog\\nis an epic like any other and must exist, so an issue always has a home.\\n\\n    attavo plan get [--version V]\\n    attavo plan put FILE --base V --by LOGIN\\n    attavo plan log\\n    attavo plan rank <EPIC|#N> (--before <EPIC|#M> | --last) --by LOGIN\\n    attavo plan move #N --epic EPIC --by LOGIN\\n    attavo plan claims #N (<PATH>... | --clear) --by LOGIN\\n\\nget prints the body as JSON on stdout and its version, author and time on\\nstderr, so `get > f`, an edit, and `put f --base V` round-trip. put writes\\nthe next version or refuses: a stale base (naming the latest version and\\nits author), a body that fails the plan's shape, or a writer that landed\\nfirst. rank and move read the latest version, change one position or one\\nmembership, and write the next. claims sets, or with --clear removes, the\\npaths an issue will change before it has a spec; once its branch exists\\nthe branch's own claims govern (attavo/claims.py) and these are not read.\\nNothing here writes to git.\\n\\\"\\\"\\\"\\nfrom __future__ import annotations\\n\\nimport copy\\nimport json\\nimport re\\nimport sys\\nfrom pathlib import Path\\nfrom typing import Any\\n\\nfrom attavo import store\\nfrom attavo.common import MANIFEST, now_iso, read_manifest\\nfrom attavo import Command\\n\\nDOC = \\\"plan\\\"\\nSCHEMA = \\\"plan/1\\\"\\nBACKLOG = \\\"backlog\\\"\\nEPIC_ID = re.compile(r\\\"^[A-Za-z][A-Za-z0-9_-]*$\\\")\\nEDGE_TYPES = (\\\"depends\\\", \\\"ruled\\\")\\nEPIC_KEYS = {\\\"id\\\", \\\"title\\\", \\\"outcome\\\", \\\"proof\\\", \\\"issues\\\"}\\nEDGE_KEYS = {\\\"type\\\", \\\"from\\\", \\\"to\\\", \\\"by\\\", \\\"at\\\", \\\"why\\\", \\\"evidence\\\", \\\"applies\\\"}\\nTOP_KEYS = {\\\"schema\\\", \\\"epics\\\", \\\"edges\\\", \\\"policy\\\", \\\"claims\\\"}\\nCLAIM_KEYS = {\\\"paths\\\", \\\"by\\\", \\\"at\\\"}\\n\\n\\ndef _is_issue(x: Any) -> bool:\\n    return isinstance(x, int) and not isinstance(x, bool) and x > 0\\n\\n\\ndef path_error(p: Any) -> str | None:\\n    \\\"\\\"\\\"Why p is not a repository-relative claim (a path or a glob), None when it is.\\\"\\\"\\\"\\n    if not isinstance(p, str) or not p.strip() or p.startswith(\\\"/\\\") or \\\"\\\\\\\\\\\" in p or \\\"..\\\" in p.split(\\\"/\\\"):\\n        return f\\\"{p!r} is not a repository-relative path\\\"\\n    return None\\n\\n\\ndef shape_errors(body: Any) -> list[str]:\\n    \\\"\\\"\\\"What is wrong with a plan body, [] when nothing is. The contract is\\n    schema/plan.schema.json; this is its check with the standard library,\\n    as records.py checks records, because bin/attavo takes no dependency.\\\"\\\"\\\"\\n    if not isinstance(body, dict):\\n        return [\\\"the plan is not an object\\\"]\\n    errs = [f\\\"unknown key {k!r}\\\" for k in sorted(set(body) - TOP_KEYS)]\\n    if body.get(\\\"schema\\\") != SCHEMA:\\n        errs.append(f\\\"schema is not {SCHEMA!r}\\\")\\n    epics = body.get(\\\"epics\\\")\\n    if not isinstance(epics, list):\\n        return errs + [\\\"epics is not a list\\\"]\\n    seen_epics: set[str] = set()\\n    placed: dict[int, str] = {}\\n    for e in epics:\\n        if not isinstance(e, dict):\\n            errs.append(\\\"an epic is not an object\\\")\\n            continue\\n        eid = e.get(\\\"id\\\")\\n        errs += [f\\\"epic {eid}: unknown key {k!r}\\\" for k in sorted(set(e) - EPIC_KEYS)]\\n        if not isinstance(eid, str) or not EPIC_ID.match(eid):\\n            errs.append(f\\\"epic id {eid!r} is not a name\\\")\\n            continue\\n        if eid in seen_epics:\\n            errs.append(f\\\"epic {eid} appears twice\\\")\\n        seen_epics.add(eid)\\n        if not isinstance(e.get(\\\"title\\\"), str) or not e[\\\"title\\\"].strip():\\n            errs.append(f\\\"epic {eid} has no title\\\")\\n        for k in (\\\"outcome\\\", \\\"proof\\\"):\\n            if k in e and not isinstance(e[k], str):\\n                errs.append(f\\\"epic {eid}: {k} is not text\\\")\\n        issues = e.get(\\\"issues\\\")\\n        if not isinstance(issues, list):\\n            errs.append(f\\\"epic {eid}: issues is not a list\\\")\\n            continue\\n        for n in issues:\\n            if not _is_issue(n):\\n                errs.append(f\\\"epic {eid}: {n!r} is not an issue number\\\")\\n            elif n in placed:\\n                errs.append(f\\\"#{n} is in both {placed[n]} and {eid}\\\")\\n            else:\\n                placed[n] = eid\\n    if BACKLOG not in seen_epics:\\n        errs.append(f\\\"there is no {BACKLOG} epic\\\")\\n    edges = body.get(\\\"edges\\\")\\n    if not isinstance(edges, list):\\n        return errs + [\\\"edges is not a list\\\"]\\n    for i, g in enumerate(edges):\\n        if not isinstance(g, dict):\\n            errs.append(f\\\"edge {i} is not an object\\\")\\n            continue\\n        errs += [f\\\"edge {i}: unknown key {k!r}\\\" for k in sorted(set(g) - EDGE_KEYS)]\\n        if g.get(\\\"type\\\") not in EDGE_TYPES:\\n            errs.append(f\\\"edge {i}: type is not one of {', '.join(EDGE_TYPES)}\\\")\\n        if not _is_issue(g.get(\\\"from\\\")) or not _is_issue(g.get(\\\"to\\\")):\\n            errs.append(f\\\"edge {i}: from and to are not issue numbers\\\")\\n        elif g[\\\"from\\\"] == g[\\\"to\\\"]:\\n            errs.append(f\\\"edge {i}: #{g['from']} depends on itself\\\")\\n        if g.get(\\\"type\\\") == \\\"ruled\\\" and not (isinstance(g.get(\\\"by\\\"), str) and isinstance(g.get(\\\"at\\\"), str)):\\n            errs.append(f\\\"edge {i}: a ruled edge names who ruled it and when (by, at)\\\")\\n        if \\\"applies\\\" in g and g[\\\"applies\\\"] != \\\"spec\\\":\\n            errs.append(f\\\"edge {i}: applies is only \\\\\\\"spec\\\\\\\"\\\")\\n    policy = body.get(\\\"policy\\\", {})\\n    if not isinstance(policy, dict):\\n        errs.append(\\\"policy is not an object\\\")\\n    claims = body.get(\\\"claims\\\", {})\\n    if not isinstance(claims, dict):\\n        return errs + [\\\"claims is not an object\\\"]\\n    for key, c in claims.items():\\n        if not (key.isdigit() and int(key) > 0):\\n            errs.append(f\\\"claims key {key!r} is not an issue number\\\")\\n        if not isinstance(c, dict):\\n            errs.append(f\\\"claims {key} is not an object\\\")\\n            continue\\n        errs += [f\\\"claims {key}: unknown key {k!r}\\\" for k in sorted(set(c) - CLAIM_KEYS)]\\n        if not (isinstance(c.get(\\\"by\\\"), str) and isinstance(c.get(\\\"at\\\"), str)):\\n            errs.append(f\\\"claims {key}: names who set them and when (by and at)\\\")\\n        paths = c.get(\\\"paths\\\")\\n        if not isinstance(paths, list):\\n            errs.append(f\\\"claims {key}: paths is not a list\\\")\\n        elif not paths:\\n            errs.append(f\\\"claims {key} has no paths; clear them instead\\\")\\n        else:\\n            errs += [f\\\"claims {key}: {e}\\\" for e in filter(None, map(path_error, paths))]\\n    return errs\\n\\n\\ndef global_order(body: dict[str, Any]) -> list[tuple[str, int]]:\\n    \\\"\\\"\\\"(epic, issue) for every placed issue: epic rank, then issue rank.\\\"\\\"\\\"\\n    return [(e[\\\"id\\\"], n) for e in body[\\\"epics\\\"] for n in e[\\\"issues\\\"]]\\n\\n\\ndef _issue_arg(s: str) -> int | None:\\n    t = s[1:] if s.startswith(\\\"#\\\") else s\\n    return int(t) if t.isdigit() and int(t) > 0 else None\\n\\n\\ndef _epic_of(body: dict[str, Any], n: int) -> dict[str, Any] | None:\\n    return next((e for e in body[\\\"epics\\\"] if n in e[\\\"issues\\\"]), None)\\n\\n\\ndef rank(body: dict[str, Any], what: str, before: str | None) -> dict[str, Any]:\\n    \\\"\\\"\\\"A copy of body with one epic, or one issue within its epic, moved\\n    before another (or last when before is None). Raises StoreRefusal.\\\"\\\"\\\"\\n    new: dict[str, Any] = copy.deepcopy(body)\\n    n = _issue_arg(what)\\n    if n is None:\\n        ids = [e[\\\"id\\\"] for e in new[\\\"epics\\\"]]\\n        if what not in ids:\\n            raise store.StoreRefusal(f\\\"no epic {what} in the plan\\\")\\n        epic = new[\\\"epics\\\"].pop(ids.index(what))\\n        if before is None:\\n            new[\\\"epics\\\"].append(epic)\\n        else:\\n            ids = [e[\\\"id\\\"] for e in new[\\\"epics\\\"]]\\n            if before not in ids:\\n                raise store.StoreRefusal(f\\\"no epic {before} in the plan to rank {what} before\\\")\\n            new[\\\"epics\\\"].insert(ids.index(before), epic)\\n        return new\\n    home = _epic_of(new, n)\\n    if home is None:\\n        raise store.StoreRefusal(f\\\"#{n} is not in the plan; place it with `attavo plan move #{n} --epic E`\\\")\\n    home[\\\"issues\\\"].remove(n)\\n    if before is None:\\n        home[\\\"issues\\\"].append(n)\\n        return new\\n    m = _issue_arg(before)\\n    if m is None or m not in home[\\\"issues\\\"]:\\n        raise store.StoreRefusal(f\\\"#{n} ranks only within its epic ({home['id']}); \\\"\\n                                 f\\\"{before} is not an issue there -- move it first\\\")\\n    home[\\\"issues\\\"].insert(home[\\\"issues\\\"].index(m), n)\\n    return new\\n\\n\\ndef move(body: dict[str, Any], what: str, epic: str) -> dict[str, Any]:\\n    \\\"\\\"\\\"A copy of body with issue what placed last in epic, taken out of\\n    whichever epic held it. Raises StoreRefusal.\\\"\\\"\\\"\\n    n = _issue_arg(what)\\n    if n is None:\\n        raise store.StoreRefusal(f\\\"{what} is not an issue number\\\")\\n    new: dict[str, Any] = copy.deepcopy(body)\\n    target = next((e for e in new[\\\"epics\\\"] if e[\\\"id\\\"] == epic), None)\\n    if target is None:\\n        raise store.StoreRefusal(f\\\"no epic {epic} in the plan\\\")\\n    home = _epic_of(new, n)\\n    if home is not None:\\n        home[\\\"issues\\\"].remove(n)\\n    target[\\\"issues\\\"].append(n)\\n    return new\\n\\n\\ndef set_claims(body: dict[str, Any], what: str, paths: list[str], by: str) -> dict[str, Any]:\\n    \\\"\\\"\\\"A copy of body with issue what's draft claims set to paths, who set\\n    them and when. Raises StoreRefusal.\\\"\\\"\\\"\\n    n = _issue_arg(what)\\n    if n is None:\\n        raise store.StoreRefusal(f\\\"{what} is not an issue number\\\")\\n    if _epic_of(body, n) is None:\\n        raise store.StoreRefusal(f\\\"#{n} is not in the plan; place it with `attavo plan move #{n} --epic E`\\\")\\n    bad = [e for e in map(path_error, paths) if e]\\n    if not paths or bad:\\n        raise store.StoreRefusal(bad[0] if bad else \\\"claims names at least one path\\\")\\n    new: dict[str, Any] = copy.deepcopy(body)\\n    new.setdefault(\\\"claims\\\", {})[str(n)] = {\\\"paths\\\": list(paths), \\\"by\\\": by, \\\"at\\\": now_iso()}\\n    return new\\n\\n\\ndef clear_claims(body: dict[str, Any], what: str) -> dict[str, Any]:\\n    \\\"\\\"\\\"A copy of body without issue what's draft claims. Raises StoreRefusal.\\\"\\\"\\\"\\n    n = _issue_arg(what)\\n    if n is None:\\n        raise store.StoreRefusal(f\\\"{what} is not an issue number\\\")\\n    if _epic_of(body, n) is None:\\n        raise store.StoreRefusal(f\\\"#{n} is not in the plan; place it with `attavo plan move #{n} --epic E`\\\")\\n    if str(n) not in body.get(\\\"claims\\\", {}):\\n        raise store.StoreRefusal(f\\\"#{n} has no claims to clear\\\")\\n    new: dict[str, Any] = copy.deepcopy(body)\\n    del new[\\\"claims\\\"][str(n)]\\n    return new\\n\\n\\ndef _opt(args: list[str], flag: str) -> str | None:\\n    if flag in args:\\n        i = args.index(flag)\\n        if i + 1 < len(args):\\n            return args[i + 1]\\n    return None\\n\\n\\ndef _refuse(msg: str) -> int:\\n    print(f\\\"attavo plan: refused: {msg}\\\", file=sys.stderr)\\n    return 2\\n\\n\\ndef _write(root: Path, body: dict[str, Any], base: int, by: str | None) -> int:\\n    if not by:\\n        return _refuse(\\\"a write names its author (--by LOGIN)\\\")\\n    try:\\n        env = store.put(root, DOC, body, base, by, check=shape_errors)\\n    except store.StoreRefusal as r:\\n        return _refuse(str(r))\\n    print(f\\\"plan version {env['version']} written by {env['by']} at {env['at']} (sha256 {env['sha256'][:12]})\\\")\\n    return 0\\n\\n\\ndef cmd_plan(argv: list[str]) -> int:\\n    root = Path(\\\".\\\").resolve()\\n    if read_manifest(root) is None:\\n        print(f\\\"attavo plan: no {MANIFEST} at {root}\\\", file=sys.stderr)\\n        return 2\\n    if not argv or argv[0] not in (\\\"get\\\", \\\"put\\\", \\\"log\\\", \\\"rank\\\", \\\"move\\\", \\\"claims\\\"):\\n        print(\\\"usage: attavo plan get [--version V] | put FILE --base V --by LOGIN | log | \\\"\\n              \\\"rank <EPIC|#N> (--before <EPIC|#M> | --last) --by LOGIN | move #N --epic EPIC --by LOGIN | \\\"\\n              \\\"claims #N (<PATH>... | --clear) --by LOGIN\\\",\\n              file=sys.stderr)\\n        return 2\\n    verb, args = argv[0], argv[1:]\\n    try:\\n        if verb == \\\"get\\\":\\n            v = _opt(args, \\\"--version\\\")\\n            env = store.get(root, DOC, int(v) if v and v.isdigit() else None)\\n            if env is None:\\n                return _refuse(\\\"no plan in the store\\\" + (f\\\" at version {v}\\\" if v else \\\"\\\"))\\n            print(json.dumps(env[\\\"body\\\"], indent=2, ensure_ascii=False))\\n            print(f\\\"plan version {env['version']} by {env['by']} at {env['at']}\\\", file=sys.stderr)\\n            return 0\\n        if verb == \\\"log\\\":\\n            entries = store.log(root, DOC)\\n            if not entries:\\n                return _refuse(\\\"no plan in the store\\\")\\n            for e in entries:\\n                print(f\\\"{e['version']}\\\\tbase {e['base']}\\\\t{e['by']}\\\\t{e['at']}\\\\t{e['sha256'][:12]}\\\")\\n            return 0\\n        by = _opt(args, \\\"--by\\\")\\n        if verb == \\\"put\\\":\\n            base = _opt(args, \\\"--base\\\")\\n            if not args or args[0].startswith(\\\"--\\\") or base is None or not base.isdigit():\\n                return _refuse(\\\"put FILE --base V --by LOGIN\\\")\\n            try:\\n                body = json.loads(Path(args[0]).read_text())\\n            except (OSError, json.JSONDecodeError) as e:\\n                return _refuse(f\\\"{args[0]} is not a readable JSON file: {e}\\\")\\n            return _write(root, body, int(base), by)\\n        current = store.get(root, DOC)\\n        if current is None:\\n            return _refuse(\\\"no plan in the store; put the first version with base 0\\\")\\n        if verb == \\\"rank\\\":\\n            before = _opt(args, \\\"--before\\\")\\n            if not args or args[0].startswith(\\\"--\\\") or (before is None and \\\"--last\\\" not in args):\\n                return _refuse(\\\"rank <EPIC|#N> (--before <EPIC|#M> | --last) --by LOGIN\\\")\\n            return _write(root, rank(current[\\\"body\\\"], args[0], before), current[\\\"version\\\"], by)\\n        if verb == \\\"claims\\\":\\n            words = [w for i, w in enumerate(args) if w != \\\"--by\\\" and not (i and args[i - 1] == \\\"--by\\\")]\\n            clear = \\\"--clear\\\" in words\\n            paths = [w for w in words[1:] if w != \\\"--clear\\\"]\\n            if not words or words[0].startswith(\\\"--\\\") or clear == bool(paths):\\n                return _refuse(\\\"plan claims '#N' <path>... --by LOGIN, or plan claims '#N' --clear --by LOGIN\\\")\\n            if not by:\\n                return _refuse(\\\"a write names its author (--by LOGIN)\\\")\\n            new = (clear_claims(current[\\\"body\\\"], words[0]) if clear\\n                   else set_claims(current[\\\"body\\\"], words[0], paths, by))\\n            return _write(root, new, current[\\\"version\\\"], by)\\n        epic = _opt(args, \\\"--epic\\\")\\n        if not args or args[0].startswith(\\\"--\\\") or epic is None:\\n            return _refuse(\\\"move #N --epic EPIC --by LOGIN\\\")\\n        return _write(root, move(current[\\\"body\\\"], args[0], epic), current[\\\"version\\\"], by)\\n    except store.StoreRefusal as r:\\n        return _refuse(str(r))\\n\\n\\nCOMMANDS = (\\n    Command(\\n        name='plan',\\n        run=cmd_plan,\\n        usage=('attavo plan get [--version V] | put FILE --base V --by LOGIN | log', 'attavo plan rank <EPIC|#N> (--before <EPIC|#M> | --last) --by LOGIN', 'attavo plan move #N --epic EPIC --by LOGIN', 'attavo plan claims #N (<PATH>... | --clear) --by LOGIN'),\\n        rank=160,\\n        help=(\\n            (80, \\\"\\\"\\\"\\\\\\nplan keeps the Plan's order in the product's datastore, never in git:\\nthe epics in rank order, each with its issues in rank order, the edges\\nbetween issues, and policy. The store is <git common dir>/attavo/store/\\n(ATTAVO_STORE overrides it): shared by every worktree of the clone, never\\nstaged, one file per version. get prints the plan and its version; put\\nwrites the next version from a file and refuses a stale --base by naming\\nthe latest version and its author; log lists versions; rank and move\\nchange one position or one membership and write the next version; claims\\nsets (or --clear removes) the repository paths an issue will change before\\nit has a spec, with who set them and when, and refuses an issue the plan\\ndoes not place. A re-rank is a new version, not a commit: priority is\\nworking material the attestation does not bind to.\\\"\\\"\\\"),\\n        ),\\n    ),\\n)\\n\",\"structuredPatch\":[{\"oldStart\":216,\"oldLines\":9,\"newStart\":216,\"newLines\":10,\"lines\":[\"     return new\",\" \",\" \",\"-def set_claims(body: dict[str, Any], what: str, paths: list[str], by: str) -> dict[str, Any]:\",\"+def set_claims(body: dict[str, Any], what: str, paths: list[str], by: str, at: str) -> dict[str, Any]:\",\"     \\\"\\\"\\\"A copy of body with issue what's draft claims set to paths, who set\",\"-    them and when. Raises StoreRefusal.\\\"\\\"\\\"\",\"+    them and when (at, read once by the caller and also given to the\",\"+    store write, so the claim and its version agree). Raises StoreRefusal.\\\"\\\"\\\"\",\"     n = _issue_arg(what)\",\"     if n is None:\",\"         raise store.StoreRefusal(f\\\"{what} is not an issue number\\\")\"]},{\"oldStart\":228,\"oldLines\":7,\"newStart\":229,\"newLines\":7,\"lines\":[\"     if not paths or bad:\",\"         raise store.StoreRefusal(bad[0] if bad else \\\"claims names at least one path\\\")\",\"     new: dict[str, Any] = copy.deepcopy(body)\",\"-    new.setdefault(\\\"claims\\\", {})[str(n)] = {\\\"paths\\\": list(paths), \\\"by\\\": by, \\\"at\\\": now_iso()}\",\"+    new.setdefault(\\\"claims\\\", {})[str(n)] = {\\\"paths\\\": list(paths), \\\"by\\\": by, \\\"at\\\": at}\",\"     return new\",\" \",\" \"]}],\"userModified\":false,\"replaceAll\":false,\"contentNotInModelContext\":true},\"tool_result_meta\":[{\"id\":\"toolu_01DWc9BkccazqHzT4rXhRJez\",\"permission_decision\":{\"decision\":\"accept\",\"source\":\"config\",\"reason_type\":\"rule\"}}]}\n+{\"type\":\"assistant\",\"message\":{\"model\":\"claude-sonnet-5\",\"id\":\"msg_011Cg2iod5KVbEwUoA6vNWST\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_01LVhMrzE4uktxTKGcuUUMFf\",\"name\":\"Edit\",\"input\":{\"replace_all\":false,\"file_path\":\"/Users/davidbean/Projects/attavo-worktree-339/attavo/plan.py\",\"old_string\":\"def _write(root: Path, body: dict[str, Any], base: int, by: str | None) -> int:\\n    if not by:\\n        return _refuse(\\\"a write names its author (--by LOGIN)\\\")\\n    try:\\n        env = store.put(root, DOC, body, base, by, check=shape_errors)\",\"new_string\":\"def _write(root: Path, body: dict[str, Any], base: int, by: str | None, at: str | None = None) -> int:\\n    if not by:\\n        return _refuse(\\\"a write names its author (--by LOGIN)\\\")\\n    try:\\n        env = store.put(root, DOC, body, base, by, check=shape_errors, at=at)\"},\"caller\":{\"type\":\"direct\"}}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":937,\"cache_read_input_tokens\":47176,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":937},\"output_tokens\":16,\"service_tier\":\"standard\",\"inference_geo\":\"global\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"4eecc161-6573-44a2-80b2-9b0f791072cd\",\"uuid\":\"efd15114-6ab7-41db-a278-5588a462d2a8\",\"timestamp\":\"2026-10-14T19:58:43.197Z\",\"request_id\":\"req_011Cg2iocrRH5pDNqSNkQKBW\",\"wire_tool_inputs\":{\"toolu_01LVhMrzE4uktxTKGcuUUMFf\":{\"file_path\":\"/Users/davidbean/Projects/attavo-worktree-339/attavo/plan.py\",\"old_string\":\"def _write(root: Path, body: dict[str, Any], base: int, by: str | None) -> int:\\n    if not by:\\n        return _refuse(\\\"a write names its author (--by LOGIN)\\\")\\n    try:\\n        env = store.put(root, DOC, body, base, by, check=shape_errors)\",\"new_string\":\"def _write(root: Path, body: dict[str, Any], base: int, by: str | None, at: str | None = None) -> int:\\n    if not by:\\n        return _refuse(\\\"a write names its author (--by LOGIN)\\\")\\n    try:\\n        env = store.put(root, DOC, body, base, by, check=shape_errors, at=at)\"}}}\n+{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01LVhMrzE4uktxTKGcuUUMFf\",\"type\":\"tool_result\",\"content\":\"The file /Users/davidbean/Projects/attavo-worktree-339/attavo/plan.py has been updated successfully.\"}]},\"parent_tool_use_id\":null,\"session_id\":\"4eecc161-6573-44a2-80b2-9b0f791072cd\",\"uuid\":\"28a7d003-ead4-4050-a0d6-704d9b1521aa\",\"timestamp\":\"2026-10-14T19:58:43.206Z\",\"tool_use_result\":{\"filePath\":\"/Users/davidbean/Projects/attavo-worktree-339/attavo/plan.py\",\"oldString\":\"def _write(root: Path, body: dict[str, Any], base: int, by: str | None) -> int:\\n    if not by:\\n        return _refuse(\\\"a write names its author (--by LOGIN)\\\")\\n    try:\\n        env = store.put(root, DOC, body, base, by, check=shape_errors)\",\"newString\":\"def _write(root: Path, body: dict[str, Any], base: int, by: str | None, at: str | None = None) -> int:\\n    if not by:\\n        return _refuse(\\\"a write names its author (--by LOGIN)\\\")\\n    try:\\n        env = store.put(root, DOC, body, base, by, check=shape_errors, at=at)\",\"originalFile\":\"\\\"\\\"\\\"attavo plan: the Plan's order, kept in the product's datastore.\\n\\nThe plan is one document in the store (attavo/store.py), named \\\"plan\\\":\\nthe epics in rank order, each with its issues in rank order; the edges\\nbetween issues (\\\"depends\\\", and \\\"ruled\\\" with who ruled it and when); the\\ndraft claims of issues that have no spec yet (who set them and when); and\\nthe policy lines. It holds no issue text or state -- the forge holds\\nthose -- and it is never committed: priority is working\\nmaterial the attestation does not bind to (the storage ruling), so a\\nre-rank is a new version of this document, not a commit, a pull request\\nor a merge. Git takes over when an issue becomes a spec.\\n\\nThe global order is epic rank, then issue rank within the epic. Backlog\\nis an epic like any other and must exist, so an issue always has a home.\\n\\n    attavo plan get [--version V]\\n    attavo plan put FILE --base V --by LOGIN\\n    attavo plan log\\n    attavo plan rank <EPIC|#N> (--before <EPIC|#M> | --last) --by LOGIN\\n    attavo plan move #N --epic EPIC --by LOGIN\\n    attavo plan claims #N (<PATH>... | --clear) --by LOGIN\\n\\nget prints the body as JSON on stdout and its version, author and time on\\nstderr, so `get > f`, an edit, and `put f --base V` round-trip. put writes\\nthe next version or refuses: a stale base (naming the latest version and\\nits author), a body that fails the plan's shape, or a writer that landed\\nfirst. rank and move read the latest version, change one position or one\\nmembership, and write the next. claims sets, or with --clear removes, the\\npaths an issue will change before it has a spec; once its branch exists\\nthe branch's own claims govern (attavo/claims.py) and these are not read.\\nNothing here writes to git.\\n\\\"\\\"\\\"\\nfrom __future__ import annotations\\n\\nimport copy\\nimport json\\nimport re\\nimport sys\\nfrom pathlib import Path\\nfrom typing import Any\\n\\nfrom attavo import store\\nfrom attavo.common import MANIFEST, now_iso, read_manifest\\nfrom attavo import Command\\n\\nDOC = \\\"plan\\\"\\nSCHEMA = \\\"plan/1\\\"\\nBACKLOG = \\\"backlog\\\"\\nEPIC_ID = re.compile(r\\\"^[A-Za-z][A-Za-z0-9_-]*$\\\")\\nEDGE_TYPES = (\\\"depends\\\", \\\"ruled\\\")\\nEPIC_KEYS = {\\\"id\\\", \\\"title\\\", \\\"outcome\\\", \\\"proof\\\", \\\"issues\\\"}\\nEDGE_KEYS = {\\\"type\\\", \\\"from\\\", \\\"to\\\", \\\"by\\\", \\\"at\\\", \\\"why\\\", \\\"evidence\\\", \\\"applies\\\"}\\nTOP_KEYS = {\\\"schema\\\", \\\"epics\\\", \\\"edges\\\", \\\"policy\\\", \\\"claims\\\"}\\nCLAIM_KEYS = {\\\"paths\\\", \\\"by\\\", \\\"at\\\"}\\n\\n\\ndef _is_issue(x: Any) -> bool:\\n    return isinstance(x, int) and not isinstance(x, bool) and x > 0\\n\\n\\ndef path_error(p: Any) -> str | None:\\n    \\\"\\\"\\\"Why p is not a repository-relative claim (a path or a glob), None when it is.\\\"\\\"\\\"\\n    if not isinstance(p, str) or not p.strip() or p.startswith(\\\"/\\\") or \\\"\\\\\\\\\\\" in p or \\\"..\\\" in p.split(\\\"/\\\"):\\n        return f\\\"{p!r} is not a repository-relative path\\\"\\n    return None\\n\\n\\ndef shape_errors(body: Any) -> list[str]:\\n    \\\"\\\"\\\"What is wrong with a plan body, [] when nothing is. The contract is\\n    schema/plan.schema.json; this is its check with the standard library,\\n    as records.py checks records, because bin/attavo takes no dependency.\\\"\\\"\\\"\\n    if not isinstance(body, dict):\\n        return [\\\"the plan is not an object\\\"]\\n    errs = [f\\\"unknown key {k!r}\\\" for k in sorted(set(body) - TOP_KEYS)]\\n    if body.get(\\\"schema\\\") != SCHEMA:\\n        errs.append(f\\\"schema is not {SCHEMA!r}\\\")\\n    epics = body.get(\\\"epics\\\")\\n    if not isinstance(epics, list):\\n        return errs + [\\\"epics is not a list\\\"]\\n    seen_epics: set[str] = set()\\n    placed: dict[int, str] = {}\\n    for e in epics:\\n        if not isinstance(e, dict):\\n            errs.append(\\\"an epic is not an object\\\")\\n            continue\\n        eid = e.get(\\\"id\\\")\\n        errs += [f\\\"epic {eid}: unknown key {k!r}\\\" for k in sorted(set(e) - EPIC_KEYS)]\\n        if not isinstance(eid, str) or not EPIC_ID.match(eid):\\n            errs.append(f\\\"epic id {eid!r} is not a name\\\")\\n            continue\\n        if eid in seen_epics:\\n            errs.append(f\\\"epic {eid} appears twice\\\")\\n        seen_epics.add(eid)\\n        if not isinstance(e.get(\\\"title\\\"), str) or not e[\\\"title\\\"].strip():\\n            errs.append(f\\\"epic {eid} has no title\\\")\\n        for k in (\\\"outcome\\\", \\\"proof\\\"):\\n            if k in e and not isinstance(e[k], str):\\n                errs.append(f\\\"epic {eid}: {k} is not text\\\")\\n        issues = e.get(\\\"issues\\\")\\n        if not isinstance(issues, list):\\n            errs.append(f\\\"epic {eid}: issues is not a list\\\")\\n            continue\\n        for n in issues:\\n            if not _is_issue(n):\\n                errs.append(f\\\"epic {eid}: {n!r} is not an issue number\\\")\\n            elif n in placed:\\n                errs.append(f\\\"#{n} is in both {placed[n]} and {eid}\\\")\\n            else:\\n                placed[n] = eid\\n    if BACKLOG not in seen_epics:\\n        errs.append(f\\\"there is no {BACKLOG} epic\\\")\\n    edges = body.get(\\\"edges\\\")\\n    if not isinstance(edges, list):\\n        return errs + [\\\"edges is not a list\\\"]\\n    for i, g in enumerate(edges):\\n        if not isinstance(g, dict):\\n            errs.append(f\\\"edge {i} is not an object\\\")\\n            continue\\n        errs += [f\\\"edge {i}: unknown key {k!r}\\\" for k in sorted(set(g) - EDGE_KEYS)]\\n        if g.get(\\\"type\\\") not in EDGE_TYPES:\\n            errs.append(f\\\"edge {i}: type is not one of {', '.join(EDGE_TYPES)}\\\")\\n        if not _is_issue(g.get(\\\"from\\\")) or not _is_issue(g.get(\\\"to\\\")):\\n            errs.append(f\\\"edge {i}: from and to are not issue numbers\\\")\\n        elif g[\\\"from\\\"] == g[\\\"to\\\"]:\\n            errs.append(f\\\"edge {i}: #{g['from']} depends on itself\\\")\\n        if g.get(\\\"type\\\") == \\\"ruled\\\" and not (isinstance(g.get(\\\"by\\\"), str) and isinstance(g.get(\\\"at\\\"), str)):\\n            errs.append(f\\\"edge {i}: a ruled edge names who ruled it and when (by, at)\\\")\\n        if \\\"applies\\\" in g and g[\\\"applies\\\"] != \\\"spec\\\":\\n            errs.append(f\\\"edge {i}: applies is only \\\\\\\"spec\\\\\\\"\\\")\\n    policy = body.get(\\\"policy\\\", {})\\n    if not isinstance(policy, dict):\\n        errs.append(\\\"policy is not an object\\\")\\n    claims = body.get(\\\"claims\\\", {})\\n    if not isinstance(claims, dict):\\n        return errs + [\\\"claims is not an object\\\"]\\n    for key, c in claims.items():\\n        if not (key.isdigit() and int(key) > 0):\\n            errs.append(f\\\"claims key {key!r} is not an issue number\\\")\\n        if not isinstance(c, dict):\\n            errs.append(f\\\"claims {key} is not an object\\\")\\n            continue\\n        errs += [f\\\"claims {key}: unknown key {k!r}\\\" for k in sorted(set(c) - CLAIM_KEYS)]\\n        if not (isinstance(c.get(\\\"by\\\"), str) and isinstance(c.get(\\\"at\\\"), str)):\\n            errs.append(f\\\"claims {key}: names who set them and when (by and at)\\\")\\n        paths = c.get(\\\"paths\\\")\\n        if not isinstance(paths, list):\\n            errs.append(f\\\"claims {key}: paths is not a list\\\")\\n        elif not paths:\\n            errs.append(f\\\"claims {key} has no paths; clear them instead\\\")\\n        else:\\n            errs += [f\\\"claims {key}: {e}\\\" for e in filter(None, map(path_error, paths))]\\n    return errs\\n\\n\\ndef global_order(body: dict[str, Any]) -> list[tuple[str, int]]:\\n    \\\"\\\"\\\"(epic, issue) for every placed issue: epic rank, then issue rank.\\\"\\\"\\\"\\n    return [(e[\\\"id\\\"], n) for e in body[\\\"epics\\\"] for n in e[\\\"issues\\\"]]\\n\\n\\ndef _issue_arg(s: str) -> int | None:\\n    t = s[1:] if s.startswith(\\\"#\\\") else s\\n    return int(t) if t.isdigit() and int(t) > 0 else None\\n\\n\\ndef _epic_of(body: dict[str, Any], n: int) -> dict[str, Any] | None:\\n    return next((e for e in body[\\\"epics\\\"] if n in e[\\\"issues\\\"]), None)\\n\\n\\ndef rank(body: dict[str, Any], what: str, before: str | None) -> dict[str, Any]:\\n    \\\"\\\"\\\"A copy of body with one epic, or one issue within its epic, moved\\n    before another (or last when before is None). Raises StoreRefusal.\\\"\\\"\\\"\\n    new: dict[str, Any] = copy.deepcopy(body)\\n    n = _issue_arg(what)\\n    if n is None:\\n        ids = [e[\\\"id\\\"] for e in new[\\\"epics\\\"]]\\n        if what not in ids:\\n            raise store.StoreRefusal(f\\\"no epic {what} in the plan\\\")\\n        epic = new[\\\"epics\\\"].pop(ids.index(what))\\n        if before is None:\\n            new[\\\"epics\\\"].append(epic)\\n        else:\\n            ids = [e[\\\"id\\\"] for e in new[\\\"epics\\\"]]\\n            if before not in ids:\\n                raise store.StoreRefusal(f\\\"no epic {before} in the plan to rank {what} before\\\")\\n            new[\\\"epics\\\"].insert(ids.index(before), epic)\\n        return new\\n    home = _epic_of(new, n)\\n    if home is None:\\n        raise store.StoreRefusal(f\\\"#{n} is not in the plan; place it with `attavo plan move #{n} --epic E`\\\")\\n    home[\\\"issues\\\"].remove(n)\\n    if before is None:\\n        home[\\\"issues\\\"].append(n)\\n        return new\\n    m = _issue_arg(before)\\n    if m is None or m not in home[\\\"issues\\\"]:\\n        raise store.StoreRefusal(f\\\"#{n} ranks only within its epic ({home['id']}); \\\"\\n                                 f\\\"{before} is not an issue there -- move it first\\\")\\n    home[\\\"issues\\\"].insert(home[\\\"issues\\\"].index(m), n)\\n    return new\\n\\n\\ndef move(body: dict[str, Any], what: str, epic: str) -> dict[str, Any]:\\n    \\\"\\\"\\\"A copy of body with issue what placed last in epic, taken out of\\n    whichever epic held it. Raises StoreRefusal.\\\"\\\"\\\"\\n    n = _issue_arg(what)\\n    if n is None:\\n        raise store.StoreRefusal(f\\\"{what} is not an issue number\\\")\\n    new: dict[str, Any] = copy.deepcopy(body)\\n    target = next((e for e in new[\\\"epics\\\"] if e[\\\"id\\\"] == epic), None)\\n    if target is None:\\n        raise store.StoreRefusal(f\\\"no epic {epic} in the plan\\\")\\n    home = _epic_of(new, n)\\n    if home is not None:\\n        home[\\\"issues\\\"].remove(n)\\n    target[\\\"issues\\\"].append(n)\\n    return new\\n\\n\\ndef set_claims(body: dict[str, Any], what: str, paths: list[str], by: str, at: str) -> dict[str, Any]:\\n    \\\"\\\"\\\"A copy of body with issue what's draft claims set to paths, who set\\n    them and when (at, read once by the caller and also given to the\\n    store write, so the claim and its version agree). Raises StoreRefusal.\\\"\\\"\\\"\\n    n = _issue_arg(what)\\n    if n is None:\\n        raise store.StoreRefusal(f\\\"{what} is not an issue number\\\")\\n    if _epic_of(body, n) is None:\\n        raise store.StoreRefusal(f\\\"#{n} is not in the plan; place it with `attavo plan move #{n} --epic E`\\\")\\n    bad = [e for e in map(path_error, paths) if e]\\n    if not paths or bad:\\n        raise store.StoreRefusal(bad[0] if bad else \\\"claims names at least one path\\\")\\n    new: dict[str, Any] = copy.deepcopy(body)\\n    new.setdefault(\\\"claims\\\", {})[str(n)] = {\\\"paths\\\": list(paths), \\\"by\\\": by, \\\"at\\\": at}\\n    return new\\n\\n\\ndef clear_claims(body: dict[str, Any], what: str) -> dict[str, Any]:\\n    \\\"\\\"\\\"A copy of body without issue what's draft claims. Raises StoreRefusal.\\\"\\\"\\\"\\n    n = _issue_arg(what)\\n    if n is None:\\n        raise store.StoreRefusal(f\\\"{what} is not an issue number\\\")\\n    if _epic_of(body, n) is None:\\n        raise store.StoreRefusal(f\\\"#{n} is not in the plan; place it with `attavo plan move #{n} --epic E`\\\")\\n    if str(n) not in body.get(\\\"claims\\\", {}):\\n        raise store.StoreRefusal(f\\\"#{n} has no claims to clear\\\")\\n    new: dict[str, Any] = copy.deepcopy(body)\\n    del new[\\\"claims\\\"][str(n)]\\n    return new\\n\\n\\ndef _opt(args: list[str], flag: str) -> str | None:\\n    if flag in args:\\n        i = args.index(flag)\\n        if i + 1 < len(args):\\n            return args[i + 1]\\n    return None\\n\\n\\ndef _refuse(msg: str) -> int:\\n    print(f\\\"attavo plan: refused: {msg}\\\", file=sys.stderr)\\n    return 2\\n\\n\\ndef _write(root: Path, body: dict[str, Any], base: int, by: str | None) -> int:\\n    if not by:\\n        return _refuse(\\\"a write names its author (--by LOGIN)\\\")\\n    try:\\n        env = store.put(root, DOC, body, base, by, check=shape_errors)\\n    except store.StoreRefusal as r:\\n        return _refuse(str(r))\\n    print(f\\\"plan version {env['version']} written by {env['by']} at {env['at']} (sha256 {env['sha256'][:12]})\\\")\\n    return 0\\n\\n\\ndef cmd_plan(argv: list[str]) -> int:\\n    root = Path(\\\".\\\").resolve()\\n    if read_manifest(root) is None:\\n        print(f\\\"attavo plan: no {MANIFEST} at {root}\\\", file=sys.stderr)\\n        return 2\\n    if not argv or argv[0] not in (\\\"get\\\", \\\"put\\\", \\\"log\\\", \\\"rank\\\", \\\"move\\\", \\\"claims\\\"):\\n        print(\\\"usage: attavo plan get [--version V] | put FILE --base V --by LOGIN | log | \\\"\\n              \\\"rank <EPIC|#N> (--before <EPIC|#M> | --last) --by LOGIN | move #N --epic EPIC --by LOGIN | \\\"\\n              \\\"claims #N (<PATH>... | --clear) --by LOGIN\\\",\\n              file=sys.stderr)\\n        return 2\\n    verb, args = argv[0], argv[1:]\\n    try:\\n        if verb == \\\"get\\\":\\n            v = _opt(args, \\\"--version\\\")\\n            env = store.get(root, DOC, int(v) if v and v.isdigit() else None)\\n            if env is None:\\n                return _refuse(\\\"no plan in the store\\\" + (f\\\" at version {v}\\\" if v else \\\"\\\"))\\n            print(json.dumps(env[\\\"body\\\"], indent=2, ensure_ascii=False))\\n            print(f\\\"plan version {env['version']} by {env['by']} at {env['at']}\\\", file=sys.stderr)\\n            return 0\\n        if verb == \\\"log\\\":\\n            entries = store.log(root, DOC)\\n            if not entries:\\n                return _refuse(\\\"no plan in the store\\\")\\n            for e in entries:\\n                print(f\\\"{e['version']}\\\\tbase {e['base']}\\\\t{e['by']}\\\\t{e['at']}\\\\t{e['sha256'][:12]}\\\")\\n            return 0\\n        by = _opt(args, \\\"--by\\\")\\n        if verb == \\\"put\\\":\\n            base = _opt(args, \\\"--base\\\")\\n            if not args or args[0].startswith(\\\"--\\\") or base is None or not base.isdigit():\\n                return _refuse(\\\"put FILE --base V --by LOGIN\\\")\\n            try:\\n                body = json.loads(Path(args[0]).read_text())\\n            except (OSError, json.JSONDecodeError) as e:\\n                return _refuse(f\\\"{args[0]} is not a readable JSON file: {e}\\\")\\n            return _write(root, body, int(base), by)\\n        current = store.get(root, DOC)\\n        if current is None:\\n            return _refuse(\\\"no plan in the store; put the first version with base 0\\\")\\n        if verb == \\\"rank\\\":\\n            before = _opt(args, \\\"--before\\\")\\n            if not args or args[0].startswith(\\\"--\\\") or (before is None and \\\"--last\\\" not in args):\\n                return _refuse(\\\"rank <EPIC|#N> (--before <EPIC|#M> | --last) --by LOGIN\\\")\\n            return _write(root, rank(current[\\\"body\\\"], args[0], before), current[\\\"version\\\"], by)\\n        if verb == \\\"claims\\\":\\n            words = [w for i, w in enumerate(args) if w != \\\"--by\\\" and not (i and args[i - 1] == \\\"--by\\\")]\\n            clear = \\\"--clear\\\" in words\\n            paths = [w for w in words[1:] if w != \\\"--clear\\\"]\\n            if not words or words[0].startswith(\\\"--\\\") or clear == bool(paths):\\n                return _refuse(\\\"plan claims '#N' <path>... --by LOGIN, or plan claims '#N' --clear --by LOGIN\\\")\\n            if not by:\\n                return _refuse(\\\"a write names its author (--by LOGIN)\\\")\\n            new = (clear_claims(current[\\\"body\\\"], words[0]) if clear\\n                   else set_claims(current[\\\"body\\\"], words[0], paths, by))\\n            return _write(root, new, current[\\\"version\\\"], by)\\n        epic = _opt(args, \\\"--epic\\\")\\n        if not args or args[0].startswith(\\\"--\\\") or epic is None:\\n            return _refuse(\\\"move #N --epic EPIC --by LOGIN\\\")\\n        return _write(root, move(current[\\\"body\\\"], args[0], epic), current[\\\"version\\\"], by)\\n    except store.StoreRefusal as r:\\n        return _refuse(str(r))\\n\\n\\nCOMMANDS = (\\n    Command(\\n        name='plan',\\n        run=cmd_plan,\\n        usage=('attavo plan get [--version V] | put FILE --base V --by LOGIN | log', 'attavo plan rank <EPIC|#N> (--before <EPIC|#M> | --last) --by LOGIN', 'attavo plan move #N --epic EPIC --by LOGIN', 'attavo plan claims #N (<PATH>... | --clear) --by LOGIN'),\\n        rank=160,\\n        help=(\\n            (80, \\\"\\\"\\\"\\\\\\nplan keeps the Plan's order in the product's datastore, never in git:\\nthe epics in rank order, each with its issues in rank order, the edges\\nbetween issues, and policy. The store is <git common dir>/attavo/store/\\n(ATTAVO_STORE overrides it): shared by every worktree of the clone, never\\nstaged, one file per version. get prints the plan and its version; put\\nwrites the next version from a file and refuses a stale --base by naming\\nthe latest version and its author; log lists versions; rank and move\\nchange one position or one membership and write the next version; claims\\nsets (or --clear removes) the repository paths an issue will change before\\nit has a spec, with who set them and when, and refuses an issue the plan\\ndoes not place. A re-rank is a new version, not a commit: priority is\\nworking material the attestation does not bind to.\\\"\\\"\\\"),\\n        ),\\n    ),\\n)\\n\",\"structuredPatch\":[{\"oldStart\":260,\"oldLines\":11,\"newStart\":260,\"newLines\":11,\"lines\":[\"     return 2\",\" \",\" \",\"-def _write(root: Path, body: dict[str, Any], base: int, by: str | None) -> int:\",\"+def _write(root: Path, body: dict[str, Any], base: int, by: str | None, at: str | None = None) -> int:\",\"     if not by:\",\"         return _refuse(\\\"a write names its author (--by LOGIN)\\\")\",\"     try:\",\"-        env = store.put(root, DOC, body, base, by, check=shape_errors)\",\"+        env = store.put(root, DOC, body, base, by, check=shape_errors, at=at)\",\"     except store.StoreRefusal as r:\",\"         return _refuse(str(r))\",\"     print(f\\\"plan version {env['version']} written by {env['by']} at {env['at']} (sha256 {env['sha256'][:12]})\\\")\"]}],\"userModified\":false,\"replaceAll\":false,\"contentNotInModelContext\":true},\"tool_result_meta\":[{\"id\":\"toolu_01LVhMrzE4uktxTKGcuUUMFf\",\"permission_decision\":{\"decision\":\"accept\",\"source\":\"config\",\"reason_type\":\"rule\"}}]}\n","exit_code":0,"status":"completed"}}

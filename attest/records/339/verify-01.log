y]:\n     \"\"\"A copy of body with issue what's draft claims set to paths, who set\n-    them and when. Raises StoreRefusal.\"\"\"\n+    them and when (at, read once by the caller and also given to the\n+    store write, so the claim and its version agree). Raises StoreRefusal.\"\"\"\n     n = _issue_arg(what)\n     if n is None:\n         raise store.StoreRefusal(f\"{what} is not an issue number\")\n@@ -228,7 +229,7 @@ def set_claims(body: dict[str, Any], what: str, paths: list[str], by: str) -> di\n     if not paths or bad:\n         raise store.StoreRefusal(bad[0] if bad else \"claims names at least one path\")\n     new: dict[str, Any] = copy.deepcopy(body)\n-    new.setdefault(\"claims\", {})[str(n)] = {\"paths\": list(paths), \"by\": by, \"at\": now_iso()}\n+    new.setdefault(\"claims\", {})[str(n)] = {\"paths\": list(paths), \"by\": by, \"at\": at}\n     return new\n \n \n@@ -259,11 +260,11 @@ def _refuse(msg: str) -> int:\n     return 2\n \n \n-def _write(root: Path, body: dict[str, Any], base: int, by: str | None) -> int:\n+def _write(root: Path, body: dict[str, Any], base: int, by: str | None, at: str | None = None) -> int:\n     if not by:\n         return _refuse(\"a write names its author (--by LOGIN)\")\n     try:\n-        env = store.put(root, DOC, body, base, by, check=shape_errors)\n+        env = store.put(root, DOC, body, base, by, check=shape_errors, at=at)\n     except store.StoreRefusal as r:\n         return _refuse(str(r))\n     print(f\"plan version {env['version']} written by {env['by']} at {env['at']} (sha256 {env['sha256'][:12]})\")\n@@ -324,9 +325,11 @@ def cmd_plan(argv: list[str]) -> int:\n                 return _refuse(\"plan claims '#N' <path>... --by LOGIN, or plan claims '#N' --clear --by LOGIN\")\n             if not by:\n                 return _refuse(\"a write names its author (--by LOGIN)\")\n-            new = (clear_claims(current[\"body\"], words[0]) if clear\n-                   else set_claims(current[\"body\"], words[0], paths, by))\n-            return _write(root, new, current[\"version\"], by)\n+            if clear:\n+                return _write(root, clear_claims(current[\"body\"], words[0]), current[\"version\"], by)\n+            at = now_iso()\n+            return _write(root, set_claims(current[\"body\"], words[0], paths, by, at),\n+                           current[\"version\"], by, at=at)\n         epic = _opt(args, \"--epic\")\n         if not args or args[0].startswith(\"--\") or epic is None:\n             return _refuse(\"move #N --epic EPIC --by LOGIN\")\ndiff --git a/attavo/store.py b/attavo/store.py\nindex c99640f..d3bfc23 100644\n--- a/attavo/store.py\n+++ b/attavo/store.py\n@@ -102,9 +102,12 @@ def log(root: Path, name: str) -> list[dict[str, Any]]:\n \n \n def put(root: Path, name: str, body: Any, base: int, by: str,\n-        check: Callable[[Any], list[str]] | None = None) -> dict[str, Any]:\n+        check: Callable[[Any], list[str]] | None = None, at: str | None = None) -> dict[str, Any]:\n     \"\"\"Write version base+1 of name, or refuse: a stale base, an empty\n-    author, a body the check refuses, or a writer that landed first.\"\"\"\n+    author, a body the check refuses, or a writer that landed first. at\n+    stamps the version; the default reads the clock, but a caller that\n+    already stamped part of the body (e.g. a plan claim) passes that same\n+    stamp here so the two agree by construction rather than by chance.\"\"\"\n     if not by.strip():\n         raise StoreRefusal(\"a write names its author (--by)\")\n     if check is not None:\n@@ -117,7 +120,7 @@ def put(root: Path, name: str, body: Any, base: int, by: str,\n     d = _doc_dir(root, name)\n     d.mkdir(parents=True, exist_ok=True)\n     envelope = {\"name\": name, \"version\": base + 1, \"base\": base, \"sha256\": body_sha256(body),\n-                \"by\": by, \"at\": now_iso(), \"body\": body}\n+                \"by\": by, \"at\": at if at is not None else now_iso(), \"body\": body}\n     fd, tmp = tempfile.mkstemp(dir=d, prefix=\".put-\", suffix=\".json\")\n     try:\n         with os.fdopen(fd, \"w\") as f:\ndiff --git a/tests/test_plan.py b/tests/test_plan.py\nindex 7e5c63b..2a8b4fe 100644\n--- a/tests/test_plan.py\n+++ b/tests/test_plan.py\n@@ -265,3 +265,30 @@ def test_plan_claims_refuses_a_stale_base_naming_the_writer_that_landed_first(\n     err = capsys.readouterr().err\n     assert \"moved\" in err and \"version 2\" in err and \"bob\" in err\n     assert \"claims\" not in store.get(root, \"plan\")[\"body\"]  # type: ignore[index]\n+\n+\n+# Issue #339: one plan write reads the clock once.\n+\n+def test_a_plan_write_stamps_the_claim_and_the_version_from_one_clock_read(\n+        tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:\n+    \"\"\"Specimen: lane orange's full run for #336 at 14dc209 failed\n+    test_plan_claims_writes_the_draft_claims_beside_the_order_and_clear_removes_them\n+    under load, because set_claims and store.put each called now_iso() and\n+    the two calls straddled a second. With the clock forced to a different\n+    second on every read, the claim's `at` and the version's `at` must\n+    still agree.\"\"\"\n+    from attavo import plan as plan_mod\n+    from attavo import store as store_mod\n+    ticks = iter(range(1, 1000))\n+\n+    def ticking() -> str:\n+        return f\"2026-01-01T00:00:{next(ticks):02d}Z\"\n+\n+    monkeypatch.setattr(plan_mod, \"now_iso\", ticking, raising=False)\n+    monkeypatch.setattr(store_mod, \"now_iso\", ticking, raising=False)\n+    root = tenant_with_plan(tmp_path)\n+    monkeypatch.chdir(root)\n+    assert plan_mod.cmd_plan([\"claims\", \"#262\", \"attavo/frontier.py\", \"--by\", \"bob\"]) == 0\n+    doc = store.get(root, \"plan\")\n+    assert doc is not None\n+    assert doc[\"body\"][\"claims\"][\"262\"][\"at\"] == doc[\"at\"]\n","exit_code":0,"status":"completed"}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UZrRLewV9j8FMFskVahXep","type":"tool_result","content":"1\t\"\"\"attavo plan: the Plan's order in the product's datastore (attavo/plan.py).\n2\tWritten red first: on d4c0bc1 there is no plan subcommand and no\n3\tattavo.plan module.\n4\t\n5\tRun: python3 -m pytest tests/test_plan.py -q\n6\t\"\"\"\n7\tfrom __future__ import annotations\n8\t\n9\timport copy\n10\timport json\n11\timport subprocess\n12\timport sys\n13\tfrom pathlib import Path\n14\tfrom typing import Any\n15\t\n16\timport jsonschema\n17\timport pytest\n18\t\n19\tfrom attavo import plan, store\n20\tfrom helpers import git, make_tenant\n21\t\n22\tROOT = Path(__file__).resolve().parent.parent\n23\tATTAVO = ROOT / \"bin\" / \"attavo\"\n24\tSCHEMA = json.loads((ROOT / \"schema\" / \"plan.schema.json\").read_text())\n25\t\n26\tPLAN: dict[str, Any] = {\n27\t    \"schema\": \"plan/1\",\n28\t    \"epics\": [\n29\t        {\"id\": \"E4\", \"title\": \"Plan on the screen\", \"outcome\": \"waves on the screen\", \"issues\": [262, 263]},\n30\t        {\"id\": \"backlog\", \"title\": \"Backlog\", \"issues\": [231, 232]},\n31\t        {\"id\": \"E5\", \"title\": \"Claims arbitration\", \"issues\": [264]},\n32\t    ],\n33\t    \"edges\": [\n34\t        {\"type\": \"depends\", \"from\": 262, \"to\": 263, \"evidence\": \"reads its JSON\"},\n35\t        {\"type\": \"ruled\", \"from\": 231, \"to\": 264, \"by\": \"dbean10\", \"at\": \"2026-09-29\", \"why\": \"order\"},\n36\t    ],\n37\t    \"policy\": {\"research\": \"not required\"},\n38\t}\n39\t\n40\t\n41\t@pytest.fixture(autouse=True)\n42\tdef no_store_override(monkeypatch: pytest.MonkeyPatch) -> None:\n43\t    monkeypatch.delenv(\"ATTAVO_STORE\", raising=False)\n44\t\n45\t\n46\tdef run_attavo(root: Path, *args: str) -> subprocess.CompletedProcess[str]:\n47\t    return subprocess.run([sys.executable, str(ATTAVO), *args], cwd=str(root),\n48\t                          capture_output=True, text=True, check=False)\n49\t\n50\t\n51\tdef broken(**change: Any) -> dict[str, Any]:\n52\t    body = copy.deepcopy(PLAN)\n53\t    body.update(change)\n54\t    return body\n55\t\n56\t\n57\tdef test_a_plan_passes_its_own_check_and_its_schema() -> None:\n58\t    assert plan.shape_errors(PLAN) == []\n59\t    jsonschema.validate(PLAN, SCHEMA)\n60\t\n61\t\n62\t@pytest.mark.parametrize(\"body,needle\", [\n63\t    (broken(epics=[e for e in PLAN[\"epics\"] if e[\"id\"] != \"backlog\"]), \"no backlog epic\"),\n64\t    (broken(extra=1), \"unknown key\"),\n65\t    (broken(schema=\"plan/0\"), \"schema\"),\n66\t    (broken(edges=[{\"type\": \"ruled\", \"from\": 1, \"to\": 2}]), \"names who ruled it\"),\n67\t    (broken(edges=[{\"type\": \"blocks\", \"from\": 1, \"to\": 2}]), \"type is not\"),\n68\t    (broken(epics=[{\"id\": \"backlog\", \"title\": \"Backlog\", \"issues\": [\"#1\"]}]), \"not an issue number\"),\n69\t])\n70\tdef test_the_check_and_the_schema_refuse_the_same_bodies(body: dict[str, Any], needle: str) -> None:\n71\t    assert any(needle in e for e in plan.shape_errors(body)), plan.shape_errors(body)\n72\t    with pytest.raises(jsonschema.ValidationError):\n73\t        jsonschema.validate(body, SCHEMA)\n74\t\n75\t\n76\tdef test_the_check_refuses_what_a_schema_cannot_say() -> None:\n77\t    twice = broken(epics=[{\"id\": \"backlog\", \"title\": \"Backlog\", \"issues\": [5]},\n78\t                          {\"id\": \"E1\", \"title\": \"One\", \"issues\": [5]}])\n79\t    assert any(\"#5 is in both backlog and E1\" in e for e in plan.shape_errors(twice))\n80\t    loop = broken(edges=[{\"type\": \"depends\", \"from\": 7, \"to\": 7}])\n81\t    assert any(\"depends on itself\" in e for e in plan.shape_errors(loop))\n82\t\n83\t\n84\tdef test_the_global_order_is_epic_rank_then_issue_rank() -> None:\n85\t    assert plan.global_order(PLAN) == [(\"E4\", 262), (\"E4\", 263), (\"backlog\", 231),\n86\t                                       (\"backlog\", 232), (\"E5\", 264)]\n87\t\n88\t\n89\tdef test_rank_moves_one_epic_or_one_issue_within_its_epic_and_nothing_else() -> None:\n90\t    by_epic = plan.rank(PLAN, \"backlog\", \"E4\")\n91\t    assert [e[\"id\"] for e in by_epic[\"epics\"]] == [\"backlog\", \"E4\", \"E5\"]\n92\t    assert [e[\"id\"] for e in plan.rank(PLAN, \"E4\", None)[\"epics\"]] == [\"backlog\", \"E5\", \"E4\"]\n93\t    by_issue = plan.rank(PLAN, \"#263\", \"#262\")\n94\t    assert by_issue[\"epics\"][0][\"issues\"] == [263, 262]\n95\t    assert by_issue[\"epics\"][1:] == PLAN[\"epics\"][1:] and by_issue[\"edges\"] == PLAN[\"edges\"]\n96\t    assert plan.rank(PLAN, \"231\", None)[\"epics\"][1][\"issues\"] == [232, 231]\n97\t    with pytest.raises(store.StoreRefusal, match=\"ranks only within its epic\"):\n98\t        plan.rank(PLAN, \"#264\", \"#262\")\n99\t    with pytest.raises(store.StoreRefusal, match=\"not in the plan\"):\n100\t        plan.rank(PLAN, \"#999\", None)\n101\t    assert PLAN[\"epics\"][0][\"issues\"] == [262, 263], \"rank returns a copy\"\n102\t\n103\t\n104\tdef test_move_places_an_issue_last_in_an_epic_and_takes_it_out_of_its_old_one() -> None:\n105\t    moved = plan.move(PLAN, \"#262\", \"backlog\")\n106\t    assert moved[\"epics\"][0][\"issues\"] == [263]\n107\t    assert moved[\"epics\"][1][\"issues\"] == [231, 232, 262]\n108\t    placed = plan.move(PLAN, \"#300\", \"E5\")\n109\t    assert placed[\"epics\"][2][\"issues\"] == [264, 300]\n110\t    assert plan.shape_errors(moved) == [] and plan.shape_errors(placed) == []\n111\t    with pytest.raises(store.StoreRefusal, match=\"no epic E9\"):\n112\t        plan.move(PLAN, \"#262\", \"E9\")\n113\t\n114\t\n115\tdef test_the_command_puts_gets_ranks_and_refuses_a_stale_base_with_nothing_in_git(tmp_path: Path) -> None:\n116\t    root = make_tenant(tmp_path, \"valid\")\n117\t    f = tmp_path / \"plan.json\"\n118\t    f.write_text(json.dumps(PLAN))\n119\t    put = run_attavo(root, \"plan\", \"put\", str(f), \"--base\", \"0\", \"--by\", \"alice\")\n120\t    assert put.returncode == 0 and \"plan version 1 written by alice\" in put.stdout, put.stdout + put.stderr\n121\t    got = run_attavo(root, \"plan\", \"get\")\n122\t    assert got.returncode == 0 and json.loads(got.stdout) == PLAN and \"plan version 1 by alice\" in got.stderr\n123\t    ranked = run_attavo(root, \"plan\", \"rank\", \"#263\", \"--before\", \"#262\", \"--by\", \"bob\")\n124\t    assert ranked.returncode == 0 and \"plan version 2 written by bob\" in ranked.stdout, ranked.stderr\n125\t    assert json.loads(run_attavo(root, \"plan\", \"get\").stdout)[\"epics\"][0][\"issues\"] == [263, 262]\n126\t    moved = run_attavo(root, \"plan\", \"move\", \"#232\", \"--epic\", \"E5\", \"--by\", \"bob\")\n127\t    assert moved.returncode == 0, moved.stderr\n128\t    stale = run_attavo(root, \"plan\", \"put\", str(f), \"--base\", \"1\", \"--by\", \"carol\")\n129\t    assert stale.returncode == 2\n130\t    assert \"moved\" in stale.stderr and \"version 3\" in stale.stderr and \"bob\" in stale.stderr\n131\t    log = run_attavo(root, \"plan\", \"log\")\n132\t    assert [line.split(\"\\t\")[0] for line in log.stdout.splitlines()] == [\"1\", \"2\", \"3\"]\n133\t    first = run_attavo(root, \"plan\", \"get\", \"--version\", \"1\")\n134\t    assert json.loads(first.stdout) == PLAN\n135\t    assert git(root, \"status\", \"--porcelain\") == \"\"\n136\t\n137\t\n138\tdef test_the_command_refuses_a_bad_body_a_missing_author_and_an_empty_store(tmp_path: Path) -> None:\n139\t    root = make_tenant(tmp_path, \"valid\")\n140\t    assert \"no plan in the store\" in run_attavo(root, \"plan\", \"get\").stderr\n141\t    assert run_attavo(root, \"plan\", \"rank\", \"E4\", \"--last\", \"--by\", \"x\").returncode == 2\n142\t    bad = tmp_path / \"bad.json\"\n143\t    bad.write_text(json.dumps(broken(epics=[])))\n144\t    r = run_attavo(root, \"plan\", \"put\", str(bad), \"--base\", \"0\", \"--by\", \"alice\")\n145\t    assert r.returncode == 2 and \"no backlog epic\" in r.stderr, r.stderr\n146\t    good = tmp_path / \"good.json\"\n147\t    good.write_text(json.dumps(PLAN))\n148\t    r = run_attavo(root, \"plan\", \"put\", str(good), \"--base\", \"0\")\n149\t    assert r.returncode == 2 and \"--by\" in r.stderr\n150\t    assert store.latest(root, \"plan\") == 0\n151\t\n152\t\n153\tCLAIMED: dict[str, Any] = {\n154\t    **PLAN,\n155\t    \"claims\": {\"262\": {\"paths\": [\"attavo/frontier.py\", \"docs/**\"], \"by\": \"dbean10\", \"at\": \"2026-10-01T09:00:00Z\"}},\n156\t}\n157\t\n158\t\n159\tdef claims_in(root: Path) -> dict[str, Any]:\n160\t    env = store.get(root, \"plan\")\n161\t    assert env is not None\n162\t    claims: dict[str, Any] = env[\"body\"].get(\"claims\", {})\n163\t    return claims\n164\t\n165\t\n166\tdef tenant_with_plan(tmp_path: Path) -> Path:\n167\t    root = make_tenant(tmp_path, \"valid\")\n168\t    store.put(root, \"plan\", PLAN, 0, \"alice\")\n169\t    return root\n170\t\n171\t\n172\t@pytest.mark.parametrize(\"entry,needle\", [\n173\t    ({\"paths\": [], \"by\": \"a\", \"at\": \"t\"}, \"no paths\"),\n174\t    ({\"paths\": \"a.py\", \"by\": \"a\", \"at\": \"t\"}, \"paths is not a list\"),\n175\t    ({\"paths\": [\"a.py\"], \"at\": \"t\"}, \"by and at\"),\n176\t    ({\"paths\": [\"a.py\"], \"by\": \"a\"}, \"by and at\"),\n177\t    ({\"paths\": [\"a.py\"], \"by\": \"a\", \"at\": \"t\", \"why\": \"x\"}, \"claims 262: unknown key\"),\n178\t    ({\"paths\": [\"/etc/passwd\"], \"by\": \"a\", \"at\": \"t\"}, \"repository-relative\"),\n179\t    ({\"paths\": [\"\"], \"by\": \"a\", \"at\": \"t\"}, \"repository-relative\"),\n180\t])\n181\tdef test_the_check_and_the_schema_refuse_the_same_malformed_claims_entry(entry: dict[str, Any], needle: str) -> None:\n182\t    \"\"\"Ruled 2026-10-01 (#313): claims for an issue with no spec are\n183\t    tool-kept structured data in the plan, so the plan's shape refuses a\n184\t    malformed entry, in the schema and in the check alike.\"\"\"\n185\t    body = {**PLAN, \"claims\": {\"262\": entry}}\n186\t    assert any(needle in e for e in plan.shape_errors(body)), plan.shape_errors(body)\n187\t    with pytest.raises(jsonschema.ValidationError):\n188\t        jsonschema.validate(body, SCHEMA)\n189\t\n190\t\n191\tdef test_the_schema_and_the_check_accept_the_claims_map_and_the_check_refuses_what_a_schema_cannot_say() -> None:\n192\t    \"\"\"Ruled 2026-10-01 (#313): the plan's optional `claims` map.\"\"\"\n193\t    assert plan.shape_errors(CLAIMED) == []\n194\t    jsonschema.validate(CLAIMED, SCHEMA)\n195\t    jsonschema.validate(PLAN, SCHEMA)\n196\t    for body, needle in [({**PLAN, \"claims\": {\"x\": CLAIMED[\"claims\"][\"262\"]}}, \"not an issue number\"),\n197\t                         ({**PLAN, \"claims\": []}, \"claims is not an object\"),\n198\t                         ({**PLAN, \"claims\": {\"262\": {**CLAIMED[\"claims\"][\"262\"], \"paths\": [\"a/../b.py\"]}}},\n199\t                          \"repository-relative\")]:\n200\t        assert any(needle in e for e in plan.shape_errors(body)), (needle, plan.shape_errors(body))\n201\t\n202\t\n203\tdef test_plan_claims_writes_the_draft_claims_beside_the_order_and_clear_removes_them(tmp_path: Path) -> None:\n204\t    \"\"\"Ruled 2026-10-01 (#313): `attavo plan claims '#N' <path>... --by`\n205\t    writes {paths, by, at} through the store's base-checked write.\"\"\"\n206\t    root = tenant_with_plan(tmp_path)\n207\t    r = run_attavo(root, \"plan\", \"claims\", \"#262\", \"attavo/frontier.py\", \"docs/**\", \"--by\", \"bob\")\n208\t    assert r.returncode == 0 and \"plan version 2 written by bob\" in r.stdout, r.stdout + r.stderr\n209\t    entry = claims_in(root)[\"262\"]\n210\t    assert entry[\"paths\"] == [\"attavo/frontier.py\", \"docs/**\"] and entry[\"by\"] == \"bob\"\n211\t    assert entry[\"at\"] == store.get(root, \"plan\")[\"at\"]  # type: ignore[index]\n212\t    again = run_attavo(root, \"plan\", \"claims\", \"#262\", \"attavo/other.py\", \"--by\", \"carol\")\n213\t    assert again.returncode == 0, again.stderr\n214\t    assert claims_in(root)[\"262\"][\"paths\"] == [\"attavo/other.py\"] and claims_in(root)[\"262\"][\"by\"] == \"carol\"\n215\t    got = run_attavo(root, \"plan\", \"get\")\n216\t    assert json.loads(got.stdout)[\"claims\"][\"262\"][\"paths\"] == [\"attavo/other.py\"], \"plan get shows the claims\"\n217\t    cleared = run_attavo(root, \"plan\", \"claims\", \"#262\", \"--clear\", \"--by\", \"bob\")\n218\t    assert cleared.returncode == 0 and \"262\" not in claims_in(root), cleared.stderr\n219\t    assert [line.split(\"\\t\")[0] for line in run_attavo(root, \"plan\", \"log\").stdout.splitlines()] == [\"1\", \"2\", \"3\", \"4\"]\n220\t    assert plan.shape_errors(store.get(root, \"plan\")[\"body\"]) == []  # type: ignore[index]\n221\t    assert git(root, \"status\", \"--porcelain\") == \"\"\n222\t\n223\t\n224\tdef test_plan_claims_refuses_an_unplaced_issue_by_name_and_changes_nothing(tmp_path: Path) -> None:\n225\t    \"\"\"Ruled 2026-10-01 (#313): refuses an issue the plan does not place,\n226\t    by name, the way rank does.\"\"\"\n227\t    root = tenant_with_plan(tmp_path)\n228\t    r = run_attavo(root, \"plan\", \"claims\", \"#999\", \"a.py\", \"--by\", \"bob\")\n229\t    assert r.returncode == 2 and \"#999 is not in the plan\" in r.stderr, r.stderr\n230\t    assert store.latest(root, \"plan\") == 1\n231\t    r = run_attavo(root, \"plan\", \"claims\", \"#999\", \"--clear\", \"--by\", \"bob\")\n232\t    assert r.returncode == 2 and \"#999 is not in the plan\" in r.stderr\n233\t    r = run_attavo(root, \"plan\", \"claims\", \"#262\", \"--clear\", \"--by\", \"bob\")\n234\t    assert r.returncode == 2 and \"#262 has no claims to clear\" in r.stderr\n235\t    assert store.latest(root, \"plan\") == 1\n236\t\n237\t\n238\tdef test_plan_claims_requires_by_and_paths_that_are_repository_relative(tmp_path: Path) -> None:\n239\t    \"\"\"Ruled 2026-10-01 (#313): a write names its author; paths are\n240\t    repository-relative.\"\"\"\n241\t    root = tenant_with_plan(tmp_path)\n242\t    r = run_attavo(root, \"plan\", \"claims\", \"#262\", \"a.py\")\n243\t    assert r.returncode == 2 and \"--by\" in r.stderr\n244\t    for argv, needle in [([\"#262\"], \"plan claims '#N' <path>...\"),\n245\t                         ([\"#262\", \"a.py\", \"--clear\"], \"plan claims '#N' <path>...\"),\n246\t                         ([\"#262\", \"/abs/a.py\"], \"repository-relative\"),\n247\t                         ([\"#262\", \"../out.py\"], \"repository-relative\"),\n248\t                         ([\"#262\", \"\"], \"repository-relative\")]:\n249\t        r = run_attavo(root, \"plan\", \"claims\", *argv, \"--by\", \"bob\")\n250\t        assert r.returncode == 2 and needle in r.stderr, (argv, r.stderr)\n251\t    assert store.latest(root, \"plan\") == 1\n252\t\n253\t\n254\tdef test_plan_claims_refuses_a_stale_base_naming_the_writer_that_landed_first(\n255\t        tmp_path: Path, monkeypatch: pytest.MonkeyPatch, capsys: pytest.CaptureFixture[str]) -> None:\n256\t    \"\"\"Ruled 2026-10-01 (#313): a claims write names its base, like every\n257\t    store write. The read is made stale by a version landing after it.\"\"\"\n258\t    root = tenant_with_plan(tmp_path)\n259\t    read = store.get(root, \"plan\")\n260\t    store.put(root, \"plan\", plan.move(PLAN, \"#262\", \"backlog\"), 1, \"bob\")\n261\t    real, reads = store.get, iter([read])\n262\t    monkeypatch.setattr(store, \"get\", lambda *a, **k: next(reads, None) or real(*a, **k))\n263\t    monkeypatch.chdir(root)\n264\t    assert plan.cmd_plan([\"claims\", \"#262\", \"a.py\", \"--by\", \"carol\"]) == 2\n265\t    err = capsys.readouterr().err\n266\t    assert \"moved\" in err and \"version 2\" in err and \"bob\" in err\n267\t    assert \"claims\" not in store.get(root, \"plan\")[\"body\"]  # type: ignore[index]\n268\t\n269\t\n270\t# Issue #339: one plan write reads the clock once.\n271\t\n272\tdef test_a_plan_write_stamps_the_claim_and_the_version_from_one_clock_read(\n273\t        tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:\n274\t    \"\"\"Specimen: lane orange's full run for #336 at 14dc209 failed\n275\t    test_plan_claims_writes_the_draft_claims_beside_the_order_and_clear_removes_them\n276\t    under load, because set_claims and store.put each called now_iso() and\n277\t    the two calls straddled a second. With the clock forced to a different\n278\t    second on every read, the claim's `at` and the version's `at` must\n279\t    still agree.\"\"\"\n280\t    from attavo import plan as plan_mod\n281\t    from attavo import store as store_mod\n282\t    ticks = iter(range(1, 1000))\n283\t\n284\t    def ticking() -> str:\n285\t        return f\"2026-01-01T00:00:{next(ticks):02d}Z\"\n286\t\n287\t    monkeypatch.setattr(plan_mod, \"now_iso\", ticking, raising=False)\n288\t    monkeypatch.setattr(store_mod, \"now_iso\", ticking, raising=False)\n289\t    root = tenant_with_plan(tmp_path)\n290\t    monkeypatch.chdir(root)\n291\t    assert plan_mod.cmd_plan([\"claims\", \"#262\", \"attavo/frontier.py\", \"--by\", \"bob\"]) == 0\n292\t    doc = store.get(root, \"plan\")\n293\t    assert doc is not None\n294\t    assert doc[\"body\"][\"claims\"][\"262\"][\"at\"] == doc[\"at\"]\n295\t"}]},"parent_tool_use_id":null,"session_id":"4eecc161-6573-44a2-80b2-9b0f791072cd","uuid":"a0f17f49-2a54-425f-9808-6bae968a5fe8","timestamp":"2026-10-14T19:58:54.978Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-339/attest/specs/339/stub/tests/test_plan.py","content":"\"\"\"attavo plan: the Plan's order in the product's datastore (attavo/plan.py).\nWritten red first: on d4c0bc1 there is no plan subcommand and no\nattavo.plan module.\n\nRun: python3 -m pytest tests/test_plan.py -q\n\"\"\"\nfrom __future__ import annotations\n\nimport copy\nimport json\nimport subprocess\nimport sys\nfrom pathlib import Path\nfrom typing import Any\n\nimport jsonschema\nimport pytest\n\nfrom attavo import plan, store\nfrom helpers import git, make_tenant\n\nROOT = Path(__file__).resolve().parent.parent\nATTAVO = ROOT / \"bin\" / \"attavo\"\nSCHEMA = json.loads((ROOT / \"schema\" / \"plan.schema.json\").read_text())\n\nPLAN: dict[str, Any] = {\n    \"schema\": \"plan/1\",\n    \"epics\": [\n        {\"id\": \"E4\", \"title\": \"Plan on the screen\", \"outcome\": \"waves on the screen\", \"issues\": [262, 263]},\n        {\"id\": \"backlog\", \"title\": \"Backlog\", \"issues\": [231, 232]},\n        {\"id\": \"E5\", \"title\": \"Claims arbitration\", \"issues\": [264]},\n    ],\n    \"edges\": [\n        {\"type\": \"depends\", \"from\": 262, \"to\": 263, \"evidence\": \"reads its JSON\"},\n        {\"type\": \"ruled\", \"from\": 231, \"to\": 264, \"by\": \"dbean10\", \"at\": \"2026-09-29\", \"why\": \"order\"},\n    ],\n    \"policy\": {\"research\": \"not required\"},\n}\n\n\n@pytest.fixture(autouse=True)\ndef no_store_override(monkeypatch: pytest.MonkeyPatch) -> None:\n    monkeypatch.delenv(\"ATTAVO_STORE\", raising=False)\n\n\ndef run_attavo(root: Path, *args: str) -> subprocess.CompletedProcess[str]:\n    return subprocess.run([sys.executable, str(ATTAVO), *args], cwd=str(root),\n                          capture_output=True, text=True, check=False)\n\n\ndef broken(**change: Any) -> dict[str, Any]:\n    body = copy.deepcopy(PLAN)\n    body.update(change)\n    return body\n\n\ndef test_a_plan_passes_its_own_check_and_its_schema() -> None:\n    assert plan.shape_errors(PLAN) == []\n    jsonschema.validate(PLAN, SCHEMA)\n\n\n@pytest.mark.parametrize(\"body,needle\", [\n    (broken(epics=[e for e in PLAN[\"epics\"] if e[\"id\"] != \"backlog\"]), \"no backlog epic\"),\n    (broken(extra=1), \"unknown key\"),\n    (broken(schema=\"plan/0\"), \"schema\"),\n    (broken(edges=[{\"type\": \"ruled\", \"from\": 1, \"to\": 2}]), \"names who ruled it\"),\n    (broken(edges=[{\"type\": \"blocks\", \"from\": 1, \"to\": 2}]), \"type is not\"),\n    (broken(epics=[{\"id\": \"backlog\", \"title\": \"Backlog\", \"issues\": [\"#1\"]}]), \"not an issue number\"),\n])\ndef test_the_check_and_the_schema_refuse_the_same_bodies(body: dict[str, Any], needle: str) -> None:\n    assert any(needle in e for e in plan.shape_errors(body)), plan.shape_errors(body)\n    with pytest.raises(jsonschema.ValidationError):\n        jsonschema.validate(body, SCHEMA)\n\n\ndef test_the_check_refuses_what_a_schema_cannot_say() -> None:\n    twice = broken(epics=[{\"id\": \"backlog\", \"title\": \"Backlog\", \"issues\": [5]},\n                          {\"id\": \"E1\", \"title\": \"One\", \"issues\": [5]}])\n    assert any(\"#5 is in both backlog and E1\" in e for e in plan.shape_errors(twice))\n    loop = broken(edges=[{\"type\": \"depends\", \"from\": 7, \"to\": 7}])\n    assert any(\"depends on itself\" in e for e in plan.shape_errors(loop))\n\n\ndef test_the_global_order_is_epic_rank_then_issue_rank() -> None:\n    assert plan.global_order(PLAN) == [(\"E4\", 262), (\"E4\", 263), (\"backlog\", 231),\n                                       (\"backlog\", 232), (\"E5\", 264)]\n\n\ndef test_rank_moves_one_epic_or_one_issue_within_its_epic_and_nothing_else() -> None:\n    by_epic = plan.rank(PLAN, \"backlog\", \"E4\")\n    assert [e[\"id\"] for e in by_epic[\"epics\"]] == [\"backlog\", \"E4\", \"E5\"]\n    assert [e[\"id\"] for e in plan.rank(PLAN, \"E4\", None)[\"epics\"]] == [\"backlog\", \"E5\", \"E4\"]\n    by_issue = plan.rank(PLAN, \"#263\", \"#262\")\n    assert by_issue[\"epics\"][0][\"issues\"] == [263, 262]\n    assert by_issue[\"epics\"][1:] == PLAN[\"epics\"][1:] and by_issue[\"edges\"] == PLAN[\"edges\"]\n    assert plan.rank(PLAN, \"231\", None)[\"epics\"][1][\"issues\"] == [232, 231]\n    with pytest.raises(store.StoreRefusal, match=\"ranks only within its epic\"):\n        plan.rank(PLAN, \"#264\", \"#262\")\n    with pytest.raises(store.StoreRefusal, match=\"not in the plan\"):\n        plan.rank(PLAN, \"#999\", None)\n    assert PLAN[\"epics\"][0][\"issues\"] == [262, 263], \"rank returns a copy\"\n\n\ndef test_move_places_an_issue_last_in_an_epic_and_takes_it_out_of_its_old_one() -> None:\n    moved = plan.move(PLAN, \"#262\", \"backlog\")\n    assert moved[\"epics\"][0][\"issues\"] == [263]\n    assert moved[\"epics\"][1][\"issues\"] == [231, 232, 262]\n    placed = plan.move(PLAN, \"#300\", \"E5\")\n    assert placed[\"epics\"][2][\"issues\"] == [264, 300]\n    assert plan.shape_errors(moved) == [] and plan.shape_errors(placed) == []\n    with pytest.raises(store.StoreRefusal, match=\"no epic E9\"):\n        plan.move(PLAN, \"#262\", \"E9\")\n\n\ndef test_the_command_puts_gets_ranks_and_refuses_a_stale_base_with_nothing_in_git(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"valid\")\n    f = tmp_path / \"plan.json\"\n    f.write_text(json.dumps(PLAN))\n    put = run_attavo(root, \"plan\", \"put\", str(f), \"--base\", \"0\", \"--by\", \"alice\")\n    assert put.returncode == 0 and \"plan version 1 written by alice\" in put.stdout, put.stdout + put.stderr\n    got = run_attavo(root, \"plan\", \"get\")\n    assert got.returncode == 0 and json.loads(got.stdout) == PLAN and \"plan version 1 by alice\" in got.stderr\n    ranked = run_attavo(root, \"plan\", \"rank\", \"#263\", \"--before\", \"#262\", \"--by\", \"bob\")\n    assert ranked.returncode == 0 and \"plan version 2 written by bob\" in ranked.stdout, ranked.stderr\n    assert json.loads(run_attavo(root, \"plan\", \"get\").stdout)[\"epics\"][0][\"issues\"] == [263, 262]\n    moved = run_attavo(root, \"plan\", \"move\", \"#232\", \"--epic\", \"E5\", \"--by\", \"bob\")\n    assert moved.returncode == 0, moved.stderr\n    stale = run_attavo(root, \"plan\", \"put\", str(f), \"--base\", \"1\", \"--by\", \"carol\")\n    assert stale.returncode == 2\n    assert \"moved\" in stale.stderr and \"version 3\" in stale.stderr and \"bob\" in stale.stderr\n    log = run_attavo(root, \"plan\", \"log\")\n    assert [line.split(\"\\t\")[0] for line in log.stdout.splitlines()] == [\"1\", \"2\", \"3\"]\n    first = run_attavo(root, \"plan\", \"get\", \"--version\", \"1\")\n    assert json.loads(first.stdout) == PLAN\n    assert git(root, \"status\", \"--porcelain\") == \"\"\n\n\ndef test_the_command_refuses_a_bad_body_a_missing_author_and_an_empty_store(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"valid\")\n    assert \"no plan in the store\" in run_attavo(root, \"plan\", \"get\").stderr\n    assert run_attavo(root, \"plan\", \"rank\", \"E4\", \"--last\", \"--by\", \"x\").returncode == 2\n    bad = tmp_path / \"bad.json\"\n    bad.write_text(json.dumps(broken(epics=[])))\n    r = run_attavo(root, \"plan\", \"put\", str(bad), \"--base\", \"0\", \"--by\", \"alice\")\n    assert r.returncode == 2 and \"no backlog epic\" in r.stderr, r.stderr\n    good = tmp_path / \"good.json\"\n    good.write_text(json.dumps(PLAN))\n    r = run_attavo(root, \"plan\", \"put\", str(good), \"--base\", \"0\")\n    assert r.returncode == 2 and \"--by\" in r.stderr\n    assert store.latest(root, \"plan\") == 0\n\n\nCLAIMED: dict[str, Any] = {\n    **PLAN,\n    \"claims\": {\"262\": {\"paths\": [\"attavo/frontier.py\", \"docs/**\"], \"by\": \"dbean10\", \"at\": \"2026-10-01T09:00:00Z\"}},\n}\n\n\ndef claims_in(root: Path) -> dict[str, Any]:\n    env = store.get(root, \"plan\")\n    assert env is not None\n    claims: dict[str, Any] = env[\"body\"].get(\"claims\", {})\n    return claims\n\n\ndef tenant_with_plan(tmp_path: Path) -> Path:\n    root = make_tenant(tmp_path, \"valid\")\n    store.put(root, \"plan\", PLAN, 0, \"alice\")\n    return root\n\n\n@pytest.mark.parametrize(\"entry,needle\", [\n    ({\"paths\": [], \"by\": \"a\", \"at\": \"t\"}, \"no paths\"),\n    ({\"paths\": \"a.py\", \"by\": \"a\", \"at\": \"t\"}, \"paths is not a list\"),\n    ({\"paths\": [\"a.py\"], \"at\": \"t\"}, \"by and at\"),\n    ({\"paths\": [\"a.py\"], \"by\": \"a\"}, \"by and at\"),\n    ({\"paths\": [\"a.py\"], \"by\": \"a\", \"at\": \"t\", \"why\": \"x\"}, \"claims 262: unknown key\"),\n    ({\"paths\": [\"/etc/passwd\"], \"by\": \"a\", \"at\": \"t\"}, \"repository-relative\"),\n    ({\"paths\": [\"\"], \"by\": \"a\", \"at\": \"t\"}, \"repository-relative\"),\n])\ndef test_the_check_and_the_schema_refuse_the_same_malformed_claims_entry(entry: dict[str, Any], needle: str) -> None:\n    \"\"\"Ruled 2026-10-01 (#313): claims for an issue with no spec are\n    tool-kept structured data in the plan, so the plan's shape refuses a\n    malformed entry, in the schema and in the check alike.\"\"\"\n    body = {**PLAN, \"claims\": {\"262\": entry}}\n    assert any(needle in e for e in plan.shape_errors(body)), plan.shape_errors(body)\n    with pytest.raises(jsonschema.ValidationError):\n        jsonschema.validate(body, SCHEMA)\n\n\ndef test_the_schema_and_the_check_accept_the_claims_map_and_the_check_refuses_what_a_schema_cannot_say() -> None:\n    \"\"\"Ruled 2026-10-01 (#313): the plan's optional `claims` map.\"\"\"\n    assert plan.shape_errors(CLAIMED) == []\n    jsonschema.validate(CLAIMED, SCHEMA)\n    jsonschema.validate(PLAN, SCHEMA)\n    for body, needle in [({**PLAN, \"claims\": {\"x\": CLAIMED[\"claims\"][\"262\"]}}, \"not an issue number\"),\n                         ({**PLAN, \"claims\": []}, \"claims is not an object\"),\n                         ({**PLAN, \"claims\": {\"262\": {**CLAIMED[\"claims\"][\"262\"], \"paths\": [\"a/../b.py\"]}}},\n                          \"repository-relative\")]:\n        assert any(needle in e for e in plan.shape_errors(body)), (needle, plan.shape_errors(body))\n\n\ndef test_plan_claims_writes_the_draft_claims_beside_the_order_and_clear_removes_them(tmp_path: Path) -> None:\n    \"\"\"Ruled 2026-10-01 (#313): `attavo plan claims '#N' <path>... --by`\n    writes {paths, by, at} through the store's base-checked write.\"\"\"\n    root = tenant_with_plan(tmp_path)\n    r = run_attavo(root, \"plan\", \"claims\", \"#262\", \"attavo/frontier.py\", \"docs/**\", \"--by\", \"bob\")\n    assert r.returncode == 0 and \"plan version 2 written by bob\" in r.stdout, r.stdout + r.stderr\n    entry = claims_in(root)[\"262\"]\n    assert entry[\"paths\"] == [\"attavo/frontier.py\", \"docs/**\"] and entry[\"by\"] == \"bob\"\n    assert entry[\"at\"] == store.get(root, \"plan\")[\"at\"]  # type: ignore[index]\n    again = run_attavo(root, \"plan\", \"claims\", \"#262\", \"attavo/other.py\", \"--by\", \"carol\")\n    assert again.returncode == 0, again.stderr\n    assert claims_in(root)[\"262\"][\"paths\"] == [\"attavo/other.py\"] and claims_in(root)[\"262\"][\"by\"] == \"carol\"\n    got = run_attavo(root, \"plan\", \"get\")\n    assert json.loads(got.stdout)[\"claims\"][\"262\"][\"paths\"] == [\"attavo/other.py\"], \"plan get shows the claims\"\n    cleared = run_attavo(root, \"plan\", \"claims\", \"#262\", \"--clear\", \"--by\", \"bob\")\n    assert cleared.returncode == 0 and \"262\" not in claims_in(root), cleared.stderr\n    assert [line.split(\"\\t\")[0] for line in run_attavo(root, \"plan\", \"log\").stdout.splitlines()] == [\"1\", \"2\", \"3\", \"4\"]\n    assert plan.shape_errors(store.get(root, \"plan\")[\"body\"]) == []  # type: ignore[index]\n    assert git(root, \"status\", \"--porcelain\") == \"\"\n\n\ndef test_plan_claims_refuses_an_unplaced_issue_by_name_and_changes_nothing(tmp_path: Path) -> None:\n    \"\"\"Ruled 2026-10-01 (#313): refuses an issue the plan does not place,\n    by name, the way rank does.\"\"\"\n    root = tenant_with_plan(tmp_path)\n    r = run_attavo(root, \"plan\", \"claims\", \"#999\", \"a.py\", \"--by\", \"bob\")\n    assert r.returncode == 2 and \"#999 is not in the plan\" in r.stderr, r.stderr\n    assert store.latest(root, \"plan\") == 1\n    r = run_attavo(root, \"plan\", \"claims\", \"#999\", \"--clear\", \"--by\", \"bob\")\n    assert r.returncode == 2 and \"#999 is not in the plan\" in r.stderr\n    r = run_attavo(root, \"plan\", \"claims\", \"#262\", \"--clear\", \"--by\", \"bob\")\n    assert r.returncode == 2 and \"#262 has no claims to clear\" in r.stderr\n    assert store.latest(root, \"plan\") == 1\n\n\ndef test_plan_claims_requires_by_and_paths_that_are_repository_relative(tmp_path: Path) -> None:\n    \"\"\"Ruled 2026-10-01 (#313): a write names its author; paths are\n    repository-relative.\"\"\"\n    root = tenant_with_plan(tmp_path)\n    r = run_attavo(root, \"plan\", \"claims\", \"#262\", \"a.py\")\n    assert r.returncode == 2 and \"--by\" in r.stderr\n    for argv, needle in [([\"#262\"], \"plan claims '#N' <path>...\"),\n                         ([\"#262\", \"a.py\", \"--clear\"], \"plan claims '#N' <path>...\"),\n                         ([\"#262\", \"/abs/a.py\"], \"repository-relative\"),\n                         ([\"#262\", \"../out.py\"], \"repository-relative\"),\n                         ([\"#262\", \"\"], \"repository-relative\")]:\n        r = run_attavo(root, \"plan\", \"claims\", *argv, \"--by\", \"bob\")\n        assert r.returncode == 2 and needle in r.stderr, (argv, r.stderr)\n    assert store.latest(root, \"plan\") == 1\n\n\ndef test_plan_claims_refuses_a_stale_base_naming_the_writer_that_landed_first(\n        tmp_path: Path, monkeypatch: pytest.MonkeyPatch, capsys: pytest.CaptureFixture[str]) -> None:\n    \"\"\"Ruled 2026-10-01 (#313): a claims write names its base, like every\n    store write. The read is made stale by a version landing after it.\"\"\"\n    root = tenant_with_plan(tmp_path)\n    read = store.get(root, \"plan\")\n    store.put(root, \"plan\", plan.move(PLAN, \"#262\", \"backlog\"), 1, \"bob\")\n    real, reads = store.get, iter([read])\n    monkeypatch.setattr(store, \"get\", lambda *a, **k: next(reads, None) or real(*a, **k))\n    monkeypatch.chdir(root)\n    assert plan.cmd_plan([\"claims\", \"#262\", \"a.py\", \"--by\", \"carol\"]) == 2\n    err = capsys.readouterr().err\n    assert \"moved\" in err and \"version 2\" in err and \"bob\" in err\n    assert \"claims\" not in store.get(root, \"plan\")[\"body\"]  # type: ignore[index]\n\n\n# Issue #339: one plan write reads the clock once.\n\ndef test_a_plan_write_stamps_the_claim_and_the_version_from_one_clock_read(\n        tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:\n    \"\"\"Specimen: lane orange's full run for #336 at 14dc209 failed\n    test_plan_claims_writes_the_draft_claims_beside_the_order_and_clear_removes_them\n    under load, because set_claims and store.put each called now_iso() and\n    the two calls straddled a second. With the clock forced to a different\n    second on every read, the claim's `at` and the version's `at` must\n    still agree.\"\"\"\n    from attavo import plan as plan_mod\n    from attavo import store as store_mod\n    ticks = iter(range(1, 1000))\n\n    def ticking() -> str:\n        return f\"2026-01-01T00:00:{next(ticks):02d}Z\"\n\n    monkeypatch.setattr(plan_mod, \"now_iso\", ticking, raising=False)\n    monkeypatch.setattr(store_mod, \"now_iso\", ticking, raising=False)\n    root = tenant_with_plan(tmp_path)\n    monkeypatch.chdir(root)\n    assert plan_mod.cmd_plan([\"claims\", \"#262\", \"attavo/frontier.py\", \"--by\", \"bob\"]) == 0\n    doc = store.get(root, \"plan\")\n    assert doc is not None\n    assert doc[\"body\"][\"claims\"][\"262\"][\"at\"] == doc[\"at\"]\n","numLines":295,"startLine":1,"totalLines":295}},"tool_result_meta":[{"id":"toolu_01UZrRLewV9j8FMFskVahXep","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JNUkDJY4adbjMx28dNGkpZ","type":"tool_result","content":"1\t\"\"\"attavo plan: the Plan's order, kept in the product's datastore.\n2\t\n3\tThe plan is one document in the store (attavo/store.py), named \"plan\":\n4\tthe epics in rank order, each with its issues in rank order; the edges\n5\tbetween issues (\"depends\", and \"ruled\" with who ruled it and when); the\n6\tdraft claims of issues that have no spec yet (who set them and when); and\n7\tthe policy lines. It holds no issue text or state -- the forge holds\n8\tthose -- and it is never committed: priority is working\n9\tmaterial the attestation does not bind to (the storage ruling), so a\n10\tre-rank is a new version of this document, not a commit, a pull request\n11\tor a merge. Git takes over when an issue becomes a spec.\n12\t\n13\tThe global order is epic rank, then issue rank within the epic. Backlog\n14\tis an epic like any other and must exist, so an issue always has a home.\n15\t\n16\t    attavo plan get [--version V]\n17\t    attavo plan put FILE --base V --by LOGIN\n18\t    attavo plan log\n19\t    attavo plan rank <EPIC|#N> (--before <EPIC|#M> | --last) --by LOGIN\n20\t    attavo plan move #N --epic EPIC --by LOGIN\n21\t    attavo plan claims #N (<PATH>... | --clear) --by LOGIN\n22\t\n23\tget prints the body as JSON on stdout and its version, author and time on\n24\tstderr, so `get > f`, an edit, and `put f --base V` round-trip. put writes\n25\tthe next version or refuses: a stale base (naming the latest version and\n26\tits author), a body that fails the plan's shape, or a writer that landed\n27\tfirst. rank and move read the latest version, change one position or one\n28\tmembership, and write the next. claims sets, or with --clear removes, the\n29\tpaths an issue will change before it has a spec; once its branch exists\n30\tthe branch's own claims govern (attavo/claims.py) and these are not read.\n31\tNothing here writes to git.\n32\t\"\"\"\n33\tfrom __future__ import annotations\n34\t\n35\timport copy\n36\timport json\n37\timport re\n38\timport sys\n39\tfrom pathlib import Path\n40\tfrom typing import Any\n41\t\n42\tfrom attavo import store\n43\tfrom attavo.common import MANIFEST, now_iso, read_manifest\n44\tfrom attavo import Command\n45\t\n46\tDOC = \"plan\"\n47\tSCHEMA = \"plan/1\"\n48\tBACKLOG = \"backlog\"\n49\tEPIC_ID = re.compile(r\"^[A-Za-z][A-Za-z0-9_-]*$\")\n50\tEDGE_TYPES = (\"depends\", \"ruled\")\n51\tEPIC_KEYS = {\"id\", \"title\", \"outcome\", \"proof\", \"issues\"}\n52\tEDGE_KEYS = {\"type\", \"from\", \"to\", \"by\", \"at\", \"why\", \"evidence\", \"applies\"}\n53\tTOP_KEYS = {\"schema\", \"epics\", \"edges\", \"policy\", \"claims\"}\n54\tCLAIM_KEYS = {\"paths\", \"by\", \"at\"}\n55\t\n56\t\n57\tdef _is_issue(x: Any) -> bool:\n58\t    return isinstance(x, int) and not isinstance(x, bool) and x > 0\n59\t\n60\t\n61\tdef path_error(p: Any) -> str | None:\n62\t    \"\"\"Why p is not a repository-relative claim (a path or a glob), None when it is.\"\"\"\n63\t    if not isinstance(p, str) or not p.strip() or p.startswith(\"/\") or \"\\\\\" in p or \"..\" in p.split(\"/\"):\n64\t        return f\"{p!r} is not a repository-relative path\"\n65\t    return None\n66\t\n67\t\n68\tdef shape_errors(body: Any) -> list[str]:\n69\t    \"\"\"What is wrong with a plan body, [] when nothing is. The contract is\n70\t    schema/plan.schema.json; this is its check with the standard library,\n71\t    as records.py checks records, because bin/attavo takes no dependency.\"\"\"\n72\t    if not isinstance(body, dict):\n73\t        return [\"the plan is not an object\"]\n74\t    errs = [f\"unknown key {k!r}\" for k in sorted(set(body) - TOP_KEYS)]\n75\t    if body.get(\"schema\") != SCHEMA:\n76\t        errs.append(f\"schema is not {SCHEMA!r}\")\n77\t    epics = body.get(\"epics\")\n78\t    if not isinstance(epics, list):\n79\t        return errs + [\"epics is not a list\"]\n80\t    seen_epics: set[str] = set()\n81\t    placed: dict[int, str] = {}\n82\t    for e in epics:\n83\t        if not isinstance(e, dict):\n84\t            errs.append(\"an epic is not an object\")\n85\t            continue\n86\t        eid = e.get(\"id\")\n87\t        errs += [f\"epic {eid}: unknown key {k!r}\" for k in sorted(set(e) - EPIC_KEYS)]\n88\t        if not isinstance(eid, str) or not EPIC_ID.match(eid):\n89\t            errs.append(f\"epic id {eid!r} is not a name\")\n90\t            continue\n91\t        if eid in seen_epics:\n92\t            errs.append(f\"epic {eid} appears twice\")\n93\t        seen_epics.add(eid)\n94\t        if not isinstance(e.get(\"title\"), str) or not e[\"title\"].strip():\n95\t            errs.append(f\"epic {eid} has no title\")\n96\t        for k in (\"outcome\", \"proof\"):\n97\t            if k in e and not isinstance(e[k], str):\n98\t                errs.append(f\"epic {eid}: {k} is not text\")\n99\t        issues = e.get(\"issues\")\n100\t        if not isinstance(issues, list):\n101\t            errs.append(f\"epic {eid}: issues is not a list\")\n102\t            continue\n103\t        for n in issues:\n104\t            if not _is_issue(n):\n105\t                errs.append(f\"epic {eid}: {n!r} is not an issue number\")\n106\t            elif n in placed:\n107\t                errs.append(f\"#{n} is in both {placed[n]} and {eid}\")\n108\t            else:\n109\t                placed[n] = eid\n110\t    if BACKLOG not in seen_epics:\n111\t        errs.append(f\"there is no {BACKLOG} epic\")\n112\t    edges = body.get(\"edges\")\n113\t    if not isinstance(edges, list):\n114\t        return errs + [\"edges is not a list\"]\n115\t    for i, g in enumerate(edges):\n116\t        if not isinstance(g, dict):\n117\t            errs.append(f\"edge {i} is not an object\")\n118\t            continue\n119\t        errs += [f\"edge {i}: unknown key {k!r}\" for k in sorted(set(g) - EDGE_KEYS)]\n120\t        if g.get(\"type\") not in EDGE_TYPES:\n121\t            errs.append(f\"edge {i}: type is not one of {', '.join(EDGE_TYPES)}\")\n122\t        if not _is_issue(g.get(\"from\")) or not _is_issue(g.get(\"to\")):\n123\t            errs.append(f\"edge {i}: from and to are not issue numbers\")\n124\t        elif g[\"from\"] == g[\"to\"]:\n125\t            errs.append(f\"edge {i}: #{g['from']} depends on itself\")\n126\t        if g.get(\"type\") == \"ruled\" and not (isinstance(g.get(\"by\"), str) and isinstance(g.get(\"at\"), str)):\n127\t            errs.append(f\"edge {i}: a ruled edge names who ruled it and when (by, at)\")\n128\t        if \"applies\" in g and g[\"applies\"] != \"spec\":\n129\t            errs.append(f\"edge {i}: applies is only \\\"spec\\\"\")\n130\t    policy = body.get(\"policy\", {})\n131\t    if not isinstance(policy, dict):\n132\t        errs.append(\"policy is not an object\")\n133\t    claims = body.get(\"claims\", {})\n134\t    if not isinstance(claims, dict):\n135\t        return errs + [\"claims is not an object\"]\n136\t    for key, c in claims.items():\n137\t        if not (key.isdigit() and int(key) > 0):\n138\t            errs.append(f\"claims key {key!r} is not an issue number\")\n139\t        if not isinstance(c, dict):\n140\t            errs.append(f\"claims {key} is not an object\")\n141\t            continue\n142\t        errs += [f\"claims {key}: unknown key {k!r}\" for k in sorted(set(c) - CLAIM_KEYS)]\n143\t        if not (isinstance(c.get(\"by\"), str) and isinstance(c.get(\"at\"), str)):\n144\t            errs.append(f\"claims {key}: names who set them and when (by and at)\")\n145\t        paths = c.get(\"paths\")\n146\t        if not isinstance(paths, list):\n147\t            errs.append(f\"claims {key}: paths is not a list\")\n148\t        elif not paths:\n149\t            errs.append(f\"claims {key} has no paths; clear them instead\")\n150\t        else:\n151\t            errs += [f\"claims {key}: {e}\" for e in filter(None, map(path_error, paths))]\n152\t    return errs\n153\t\n154\t\n155\tdef global_order(body: dict[str, Any]) -> list[tuple[str, int]]:\n156\t    \"\"\"(epic, issue) for every placed issue: epic rank, then issue rank.\"\"\"\n157\t    return [(e[\"id\"], n) for e in body[\"epics\"] for n in e[\"issues\"]]\n158\t\n159\t\n160\tdef _issue_arg(s: str) -> int | None:\n161\t    t = s[1:] if s.startswith(\"#\") else s\n162\t    return int(t) if t.isdigit() and int(t) > 0 else None\n163\t\n164\t\n165\tdef _epic_of(body: dict[str, Any], n: int) -> dict[str, Any] | None:\n166\t    return next((e for e in body[\"epics\"] if n in e[\"issues\"]), None)\n167\t\n168\t\n169\tdef rank(body: dict[str, Any], what: str, before: str | None) -> dict[str, Any]:\n170\t    \"\"\"A copy of body with one epic, or one issue within its epic, moved\n171\t    before another (or last when before is None). Raises StoreRefusal.\"\"\"\n172\t    new: dict[str, Any] = copy.deepcopy(body)\n173\t    n = _issue_arg(what)\n174\t    if n is None:\n175\t        ids = [e[\"id\"] for e in new[\"epics\"]]\n176\t        if what not in ids:\n177\t            raise store.StoreRefusal(f\"no epic {what} in the plan\")\n178\t        epic = new[\"epics\"].pop(ids.index(what))\n179\t        if before is None:\n180\t            new[\"epics\"].append(epic)\n181\t        else:\n182\t            ids = [e[\"id\"] for e in new[\"epics\"]]\n183\t            if before not in ids:\n184\t                raise store.StoreRefusal(f\"no epic {before} in the plan to rank {what} before\")\n185\t            new[\"epics\"].insert(ids.index(before), epic)\n186\t        return new\n187\t    home = _epic_of(new, n)\n188\t    if home is None:\n189\t        raise store.StoreRefusal(f\"#{n} is not in the plan; place it with `attavo plan move #{n} --epic E`\")\n190\t    home[\"issues\"].remove(n)\n191\t    if before is None:\n192\t        home[\"issues\"].append(n)\n193\t        return new\n194\t    m = _issue_arg(before)\n195\t    if m is None or m not in home[\"issues\"]:\n196\t        raise store.StoreRefusal(f\"#{n} ranks only within its epic ({home['id']}); \"\n197\t                                 f\"{before} is not an issue there -- move it first\")\n198\t    home[\"issues\"].insert(home[\"issues\"].index(m), n)\n199\t    return new\n200\t\n201\t\n202\tdef move(body: dict[str, Any], what: str, epic: str) -> dict[str, Any]:\n203\t    \"\"\"A copy of body with issue what placed last in epic, taken out of\n204\t    whichever epic held it. Raises StoreRefusal.\"\"\"\n205\t    n = _issue_arg(what)\n206\t    if n is None:\n207\t        raise store.StoreRefusal(f\"{what} is not an issue number\")\n208\t    new: dict[str, Any] = copy.deepcopy(body)\n209\t    target = next((e for e in new[\"epics\"] if e[\"id\"] == epic), None)\n210\t    if target is None:\n211\t        raise store.StoreRefusal(f\"no epic {epic} in the plan\")\n212\t    home = _epic_of(new, n)\n213\t    if home is not None:\n214\t        home[\"issues\"].remove(n)\n215\t    target[\"issues\"].append(n)\n216\t    return new\n217\t\n218\t\n219\tdef set_claims(body: dict[str, Any], what: str, paths: list[str], by: str, at: str) -> dict[str, Any]:\n220\t    \"\"\"A copy of body with issue what's draft claims set to paths, who set\n221\t    them and when (at, read once by the caller and also given to the\n222\t    store write, so the claim and its version agree). Raises StoreRefusal.\"\"\"\n223\t    n = _issue_arg(what)\n224\t    if n is None:\n225\t        raise store.StoreRefusal(f\"{what} is not an issue number\")\n226\t    if _epic_of(body, n) is None:\n227\t        raise store.StoreRefusal(f\"#{n} is not in the plan; place it with `attavo plan move #{n} --epic E`\")\n228\t    bad = [e for e in map(path_error, paths) if e]\n229\t    if not paths or bad:\n230\t        raise store.StoreRefusal(bad[0] if bad else \"claims names at least one path\")\n231\t    new: dict[str, Any] = copy.deepcopy(body)\n232\t    new.setdefault(\"claims\", {})[str(n)] = {\"paths\": list(paths), \"by\": by, \"at\": at}\n233\t    return new\n234\t\n235\t\n236\tdef clear_claims(body: dict[str, Any], what: str) -> dict[str, Any]:\n237\t    \"\"\"A copy of body without issue what's draft claims. Raises StoreRefusal.\"\"\"\n238\t    n = _issue_arg(what)\n239\t    if n is None:\n240\t        raise store.StoreRefusal(f\"{what} is not an issue number\")\n241\t    if _epic_of(body, n) is None:\n242\t        raise store.StoreRefusal(f\"#{n} is not in the plan; place it with `attavo plan move #{n} --epic E`\")\n243\t    if str(n) not in body.get(\"claims\", {}):\n244\t        raise store.StoreRefusal(f\"#{n} has no claims to clear\")\n245\t    new: dict[str, Any] = copy.deepcopy(body)\n246\t    del new[\"claims\"][str(n)]\n247\t    return new\n248\t\n249\t\n250\tdef _opt(args: list[str], flag: str) -> str | None:\n251\t    if flag in args:\n252\t        i = args.index(flag)\n253\t        if i + 1 < len(args):\n254\t            return args[i + 1]\n255\t    return None\n256\t\n257\t\n258\tdef _refuse(msg: str) -> int:\n259\t    print(f\"attavo plan: refused: {msg}\", file=sys.stderr)\n260\t    return 2\n261\t\n262\t\n263\tdef _write(root: Path, body: dict[str, Any], base: int, by: str | None, at: str | None = None) -> int:\n264\t    if not by:\n265\t        return _refuse(\"a write names its author (--by LOGIN)\")\n266\t    try:\n267\t        env = store.put(root, DOC, body, base, by, check=shape_errors, at=at)\n268\t    except store.StoreRefusal as r:\n269\t        return _refuse(str(r))\n270\t    print(f\"plan version {env['version']} written by {env['by']} at {env['at']} (sha256 {env['sha256'][:12]})\")\n271\t    return 0\n272\t\n273\t\n274\tdef cmd_plan(argv: list[str]) -> int:\n275\t    root = Path(\".\").resolve()\n276\t    if read_manifest(root) is None:\n277\t        print(f\"attavo plan: no {MANIFEST} at {root}\", file=sys.stderr)\n278\t        return 2\n279\t    if not argv or argv[0] not in (\"get\", \"put\", \"log\", \"rank\", \"move\", \"claims\"):\n280\t        print(\"usage: attavo plan get [--version V] | put FILE --base V --by LOGIN | log | \"\n281\t              \"rank <EPIC|#N> (--before <EPIC|#M> | --last) --by LOGIN | move #N --epic EPIC --by LOGIN | \"\n282\t              \"claims #N (<PATH>... | --clear) --by LOGIN\",\n283\t              file=sys.stderr)\n284\t        return 2\n285\t    verb, args = argv[0], argv[1:]\n286\t    try:\n287\t        if verb == \"get\":\n288\t            v = _opt(args, \"--version\")\n289\t            env = store.get(root, DOC, int(v) if v and v.isdigit() else None)\n290\t            if env is None:\n291\t                return _refuse(\"no plan in the store\" + (f\" at version {v}\" if v else \"\"))\n292\t            print(json.dumps(env[\"body\"], indent=2, ensure_ascii=False))\n293\t            print(f\"plan version {env['version']} by {env['by']} at {env['at']}\", file=sys.stderr)\n294\t            return 0\n295\t        if verb == \"log\":\n296\t            entries = store.log(root, DOC)\n297\t            if not entries:\n298\t                return _refuse(\"no plan in the store\")\n299\t            for e in entries:\n300\t                print(f\"{e['version']}\\tbase {e['base']}\\t{e['by']}\\t{e['at']}\\t{e['sha256'][:12]}\")\n301\t            return 0\n302\t        by = _opt(args, \"--by\")\n303\t        if verb == \"put\":\n304\t            base = _opt(args, \"--base\")\n305\t            if not args or args[0].startswith(\"--\") or base is None or not base.isdigit():\n306\t                return _refuse(\"put FILE --base V --by LOGIN\")\n307\t            try:\n308\t                body = json.loads(Path(args[0]).read_text())\n309\t            except (OSError, json.JSONDecodeError) as e:\n310\t                return _refuse(f\"{args[0]} is not a readable JSON file: {e}\")\n311\t            return _write(root, body, int(base), by)\n312\t        current = store.get(root, DOC)\n313\t        if current is None:\n314\t            return _refuse(\"no plan in the store; put the first version with base 0\")\n315\t        if verb == \"rank\":\n316\t            before = _opt(args, \"--before\")\n317\t            if not args or args[0].startswith(\"--\") or (before is None and \"--last\" not in args):\n318\t                return _refuse(\"rank <EPIC|#N> (--before <EPIC|#M> | --last) --by LOGIN\")\n319\t            return _write(root, rank(current[\"body\"], args[0], before), current[\"version\"], by)\n320\t        if verb == \"claims\":\n321\t            words = [w for i, w in enumerate(args) if w != \"--by\" and not (i and args[i - 1] == \"--by\")]\n322\t            clear = \"--clear\" in words\n323\t            paths = [w for w in words[1:] if w != \"--clear\"]\n324\t            if not words or words[0].startswith(\"--\") or clear == bool(paths):\n325\t                return _refuse(\"plan claims '#N' <path>... --by LOGIN, or plan claims '#N' --clear --by LOGIN\")\n326\t            if not by:\n327\t                return _refuse(\"a write names its author (--by LOGIN)\")\n328\t            if clear:\n329\t                return _write(root, clear_claims(current[\"body\"], words[0]), current[\"version\"], by)\n330\t            at = now_iso()\n331\t            return _write(root, set_claims(current[\"body\"], words[0], paths, by, at),\n332\t                           current[\"version\"], by, at=at)\n333\t        epic = _opt(args, \"--epic\")\n334\t        if not args or args[0].startswith(\"--\") or epic is None:\n335\t            return _refuse(\"move #N --epic EPIC --by LOGIN\")\n336\t        return _write(root, move(current[\"body\"], args[0], epic), current[\"version\"], by)\n337\t    except store.StoreRefusal as r:\n338\t        return _refuse(str(r))\n339\t\n340\t\n341\tCOMMANDS = (\n342\t    Command(\n343\t        name='plan',\n344\t        run=cmd_plan,\n345\t        usage=('attavo plan get [--version V] | put FILE --base V --by LOGIN | log', 'attavo plan rank <EPIC|#N> (--before <EPIC|#M> | --last) --by LOGIN', 'attavo plan move #N --epic EPIC --by LOGIN', 'attavo plan claims #N (<PATH>... | --clear) --by LOGIN'),\n346\t        rank=160,\n347\t        help=(\n348\t            (80, \"\"\"\\\n349\tplan keeps the Plan's order in the product's datastore, never in git:\n350\tthe epics in rank order, each with its issues in rank order, the edges\n351\tbetween issues, and policy. The store is <git common dir>/attavo/store/\n352\t(ATTAVO_STORE overrides it): shared by every worktree of the clone, never\n353\tstaged, one file per version. get prints the plan and its version; put\n354\twrites the next version from a file and refuses a stale --base by naming\n355\tthe latest version and its author; log lists versions; rank and move\n356\tchange one position or one membership and write the next version; claims\n357\tsets (or --clear removes) the repository paths an issue will change before\n358\tit has a spec, with who set them and when, and refuses an issue the plan\n359\tdoes not place. A re-rank is a new version, not a commit: priority is\n360\tworking material the attestation does not bind to.\"\"\"),\n361\t        ),\n362\t    ),\n363\t)\n364\t"}]},"parent_tool_use_id":null,"session_id":"3394fcef-7256-4223-aca1-9021ad0ae8e1","uuid":"7ba32452-cfea-4337-97ec-1ed6471962bc","timestamp":"2026-10-14T20:09:45.642Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-339/attavo/plan.py","content":"\"\"\"attavo plan: the Plan's order, kept in the product's datastore.\n\nThe plan is one document in the store (attavo/store.py), named \"plan\":\nthe epics in rank order, each with its issues in rank order; the edges\nbetween issues (\"depends\", and \"ruled\" with who ruled it and when); the\ndraft claims of issues that have no spec yet (who set them and when); and\nthe policy lines. It holds no issue text or state -- the forge holds\nthose -- and it is never committed: priority is working\nmaterial the attestation does not bind to (the storage ruling), so a\nre-rank is a new version of this document, not a commit, a pull request\nor a merge. Git takes over when an issue becomes a spec.\n\nThe global order is epic rank, then issue rank within the epic. Backlog\nis an epic like any other and must exist, so an issue always has a home.\n\n    attavo plan get [--version V]\n    attavo plan put FILE --base V --by LOGIN\n    attavo plan log\n    attavo plan rank <EPIC|#N> (--before <EPIC|#M> | --last) --by LOGIN\n    attavo plan move #N --epic EPIC --by LOGIN\n    attavo plan claims #N (<PATH>... | --clear) --by LOGIN\n\nget prints the body as JSON on stdout and its version, author and time on\nstderr, so `get > f`, an edit, and `put f --base V` round-trip. put writes\nthe next version or refuses: a stale base (naming the latest version and\nits author), a body that fails the plan's shape, or a writer that landed\nfirst. rank and move read the latest version, change one position or one\nmembership, and write the next. claims sets, or with --clear removes, the\npaths an issue will change before it has a spec; once its branch exists\nthe branch's own claims govern (attavo/claims.py) and these are not read.\nNothing here writes to git.\n\"\"\"\nfrom __future__ import annotations\n\nimport copy\nimport json\nimport re\nimport sys\nfrom pathlib import Path\nfrom typing import Any\n\nfrom attavo import store\nfrom attavo.common import MANIFEST, now_iso, read_manifest\nfrom attavo import Command\n\nDOC = \"plan\"\nSCHEMA = \"plan/1\"\nBACKLOG = \"backlog\"\nEPIC_ID = re.compile(r\"^[A-Za-z][A-Za-z0-9_-]*$\")\nEDGE_TYPES = (\"depends\", \"ruled\")\nEPIC_KEYS = {\"id\", \"title\", \"outcome\", \"proof\", \"issues\"}\nEDGE_KEYS = {\"type\", \"from\", \"to\", \"by\", \"at\", \"why\", \"evidence\", \"applies\"}\nTOP_KEYS = {\"schema\", \"epics\", \"edges\", \"policy\", \"claims\"}\nCLAIM_KEYS = {\"paths\", \"by\", \"at\"}\n\n\ndef _is_issue(x: Any) -> bool:\n    return isinstance(x, int) and not isinstance(x, bool) and x > 0\n\n\ndef path_error(p: Any) -> str | None:\n    \"\"\"Why p is not a repository-relative claim (a path or a glob), None when it is.\"\"\"\n    if not isinstance(p, str) or not p.strip() or p.startswith(\"/\") or \"\\\\\" in p or \"..\" in p.split(\"/\"):\n        return f\"{p!r} is not a repository-relative path\"\n    return None\n\n\ndef shape_errors(body: Any) -> list[str]:\n    \"\"\"What is wrong with a plan body, [] when nothing is. The contract is\n    schema/plan.schema.json; this is its check with the standard library,\n    as records.py checks records, because bin/attavo takes no dependency.\"\"\"\n    if not isinstance(body, dict):\n        return [\"the plan is not an object\"]\n    errs = [f\"unknown key {k!r}\" for k in sorted(set(body) - TOP_KEYS)]\n    if body.get(\"schema\") != SCHEMA:\n        errs.append(f\"schema is not {SCHEMA!r}\")\n    epics = body.get(\"epics\")\n    if not isinstance(epics, list):\n        return errs + [\"epics is not a list\"]\n    seen_epics: set[str] = set()\n    placed: dict[int, str] = {}\n    for e in epics:\n        if not isinstance(e, dict):\n            errs.append(\"an epic is not an object\")\n            continue\n        eid = e.get(\"id\")\n        errs += [f\"epic {eid}: unknown key {k!r}\" for k in sorted(set(e) - EPIC_KEYS)]\n        if not isinstance(eid, str) or not EPIC_ID.match(eid):\n            errs.append(f\"epic id {eid!r} is not a name\")\n            continue\n        if eid in seen_epics:\n            errs.append(f\"epic {eid} appears twice\")\n        seen_epics.add(eid)\n        if not isinstance(e.get(\"title\"), str) or not e[\"title\"].strip():\n            errs.append(f\"epic {eid} has no title\")\n        for k in (\"outcome\", \"proof\"):\n            if k in e and not isinstance(e[k], str):\n                errs.append(f\"epic {eid}: {k} is not text\")\n        issues = e.get(\"issues\")\n        if not isinstance(issues, list):\n            errs.append(f\"epic {eid}: issues is not a list\")\n            continue\n        for n in issues:\n            if not _is_issue(n):\n                errs.append(f\"epic {eid}: {n!r} is not an issue number\")\n            elif n in placed:\n                errs.append(f\"#{n} is in both {placed[n]} and {eid}\")\n            else:\n                placed[n] = eid\n    if BACKLOG not in seen_epics:\n        errs.append(f\"there is no {BACKLOG} epic\")\n    edges = body.get(\"edges\")\n    if not isinstance(edges, list):\n        return errs + [\"edges is not a list\"]\n    for i, g in enumerate(edges):\n        if not isinstance(g, dict):\n            errs.append(f\"edge {i} is not an object\")\n            continue\n        errs += [f\"edge {i}: unknown key {k!r}\" for k in sorted(set(g) - EDGE_KEYS)]\n        if g.get(\"type\") not in EDGE_TYPES:\n            errs.append(f\"edge {i}: type is not one of {', '.join(EDGE_TYPES)}\")\n        if not _is_issue(g.get(\"from\")) or not _is_issue(g.get(\"to\")):\n            errs.append(f\"edge {i}: from and to are not issue numbers\")\n        elif g[\"from\"] == g[\"to\"]:\n            errs.append(f\"edge {i}: #{g['from']} depends on itself\")\n        if g.get(\"type\") == \"ruled\" and not (isinstance(g.get(\"by\"), str) and isinstance(g.get(\"at\"), str)):\n            errs.append(f\"edge {i}: a ruled edge names who ruled it and when (by, at)\")\n        if \"applies\" in g and g[\"applies\"] != \"spec\":\n            errs.append(f\"edge {i}: applies is only \\\"spec\\\"\")\n    policy = body.get(\"policy\", {})\n    if not isinstance(policy, dict):\n        errs.append(\"policy is not an object\")\n    claims = body.get(\"claims\", {})\n    if not isinstance(claims, dict):\n        return errs + [\"claims is not an object\"]\n    for key, c in claims.items():\n        if not (key.isdigit() and int(key) > 0):\n            errs.append(f\"claims key {key!r} is not an issue number\")\n        if not isinstance(c, dict):\n            errs.append(f\"claims {key} is not an object\")\n            continue\n        errs += [f\"claims {key}: unknown key {k!r}\" for k in sorted(set(c) - CLAIM_KEYS)]\n        if not (isinstance(c.get(\"by\"), str) and isinstance(c.get(\"at\"), str)):\n            errs.append(f\"claims {key}: names who set them and when (by and at)\")\n        paths = c.get(\"paths\")\n        if not isinstance(paths, list):\n            errs.append(f\"claims {key}: paths is not a list\")\n        elif not paths:\n            errs.append(f\"claims {key} has no paths; clear them instead\")\n        else:\n            errs += [f\"claims {key}: {e}\" for e in filter(None, map(path_error, paths))]\n    return errs\n\n\ndef global_order(body: dict[str, Any]) -> list[tuple[str, int]]:\n    \"\"\"(epic, issue) for every placed issue: epic rank, then issue rank.\"\"\"\n    return [(e[\"id\"], n) for e in body[\"epics\"] for n in e[\"issues\"]]\n\n\ndef _issue_arg(s: str) -> int | None:\n    t = s[1:] if s.startswith(\"#\") else s\n    return int(t) if t.isdigit() and int(t) > 0 else None\n\n\ndef _epic_of(body: dict[str, Any], n: int) -> dict[str, Any] | None:\n    return next((e for e in body[\"epics\"] if n in e[\"issues\"]), None)\n\n\ndef rank(body: dict[str, Any], what: str, before: str | None) -> dict[str, Any]:\n    \"\"\"A copy of body with one epic, or one issue within its epic, moved\n    before another (or last when before is None). Raises StoreRefusal.\"\"\"\n    new: dict[str, Any] = copy.deepcopy(body)\n    n = _issue_arg(what)\n    if n is None:\n        ids = [e[\"id\"] for e in new[\"epics\"]]\n        if what not in ids:\n            raise store.StoreRefusal(f\"no epic {what} in the plan\")\n        epic = new[\"epics\"].pop(ids.index(what))\n        if before is None:\n            new[\"epics\"].append(epic)\n        else:\n            ids = [e[\"id\"] for e in new[\"epics\"]]\n            if before not in ids:\n                raise store.StoreRefusal(f\"no epic {before} in the plan to rank {what} before\")\n            new[\"epics\"].insert(ids.index(before), epic)\n        return new\n    home = _epic_of(new, n)\n    if home is None:\n        raise store.StoreRefusal(f\"#{n} is not in the plan; place it with `attavo plan move #{n} --epic E`\")\n    home[\"issues\"].remove(n)\n    if before is None:\n        home[\"issues\"].append(n)\n        return new\n    m = _issue_arg(before)\n    if m is None or m not in home[\"issues\"]:\n        raise store.StoreRefusal(f\"#{n} ranks only within its epic ({home['id']}); \"\n                                 f\"{before} is not an issue there -- move it first\")\n    home[\"issues\"].insert(home[\"issues\"].index(m), n)\n    return new\n\n\ndef move(body: dict[str, Any], what: str, epic: str) -> dict[str, Any]:\n    \"\"\"A copy of body with issue what placed last in epic, taken out of\n    whichever epic held it. Raises StoreRefusal.\"\"\"\n    n = _issue_arg(what)\n    if n is None:\n        raise store.StoreRefusal(f\"{what} is not an issue number\")\n    new: dict[str, Any] = copy.deepcopy(body)\n    target = next((e for e in new[\"epics\"] if e[\"id\"] == epic), None)\n    if target is None:\n        raise store.StoreRefusal(f\"no epic {epic} in the plan\")\n    home = _epic_of(new, n)\n    if home is not None:\n        home[\"issues\"].remove(n)\n    target[\"issues\"].append(n)\n    return new\n\n\ndef set_claims(body: dict[str, Any], what: str, paths: list[str], by: str, at: str) -> dict[str, Any]:\n    \"\"\"A copy of body with issue what's draft claims set to paths, who set\n    them and when (at, read once by the caller and also given to the\n    store write, so the claim and its version agree). Raises StoreRefusal.\"\"\"\n    n = _issue_arg(what)\n    if n is None:\n        raise store.StoreRefusal(f\"{what} is not an issue number\")\n    if _epic_of(body, n) is None:\n        raise store.StoreRefusal(f\"#{n} is not in the plan; place it with `attavo plan move #{n} --epic E`\")\n    bad = [e for e in map(path_error, paths) if e]\n    if not paths or bad:\n        raise store.StoreRefusal(bad[0] if bad else \"claims names at least one path\")\n    new: dict[str, Any] = copy.deepcopy(body)\n    new.setdefault(\"claims\", {})[str(n)] = {\"paths\": list(paths), \"by\": by, \"at\": at}\n    return new\n\n\ndef clear_claims(body: dict[str, Any], what: str) -> dict[str, Any]:\n    \"\"\"A copy of body without issue what's draft claims. Raises StoreRefusal.\"\"\"\n    n = _issue_arg(what)\n    if n is None:\n        raise store.StoreRefusal(f\"{what} is not an issue number\")\n    if _epic_of(body, n) is None:\n        raise store.StoreRefusal(f\"#{n} is not in the plan; place it with `attavo plan move #{n} --epic E`\")\n    if str(n) not in body.get(\"claims\", {}):\n        raise store.StoreRefusal(f\"#{n} has no claims to clear\")\n    new: dict[str, Any] = copy.deepcopy(body)\n    del new[\"claims\"][str(n)]\n    return new\n\n\ndef _opt(args: list[str], flag: str) -> str | None:\n    if flag in args:\n        i = args.index(flag)\n        if i + 1 < len(args):\n            return args[i + 1]\n    return None\n\n\ndef _refuse(msg: str) -> int:\n    print(f\"attavo plan: refused: {msg}\", file=sys.stderr)\n    return 2\n\n\ndef _write(root: Path, body: dict[str, Any], base: int, by: str | None, at: str | None = None) -> int:\n    if not by:\n        return _refuse(\"a write names its author (--by LOGIN)\")\n    try:\n        env = store.put(root, DOC, body, base, by, check=shape_errors, at=at)\n    except store.StoreRefusal as r:\n        return _refuse(str(r))\n    print(f\"plan version {env['version']} written by {env['by']} at {env['at']} (sha256 {env['sha256'][:12]})\")\n    return 0\n\n\ndef cmd_plan(argv: list[str]) -> int:\n    root = Path(\".\").resolve()\n    if read_manifest(root) is None:\n        print(f\"attavo plan: no {MANIFEST} at {root}\", file=sys.stderr)\n        return 2\n    if not argv or argv[0] not in (\"get\", \"put\", \"log\", \"rank\", \"move\", \"claims\"):\n        print(\"usage: attavo plan get [--version V] | put FILE --base V --by LOGIN | log | \"\n              \"rank <EPIC|#N> (--before <EPIC|#M> | --last) --by LOGIN | move #N --epic EPIC --by LOGIN | \"\n              \"claims #N (<PATH>... | --clear) --by LOGIN\",\n              file=sys.stderr)\n        return 2\n    verb, args = argv[0], argv[1:]\n    try:\n        if verb == \"get\":\n            v = _opt(args, \"--version\")\n            env = store.get(root, DOC, int(v) if v and v.isdigit() else None)\n            if env is None:\n                return _refuse(\"no plan in the store\" + (f\" at version {v}\" if v else \"\"))\n            print(json.dumps(env[\"body\"], indent=2, ensure_ascii=False))\n            print(f\"plan version {env['version']} by {env['by']} at {env['at']}\", file=sys.stderr)\n            return 0\n        if verb == \"log\":\n            entries = store.log(root, DOC)\n            if not entries:\n                return _refuse(\"no plan in the store\")\n            for e in entries:\n                print(f\"{e['version']}\\tbase {e['base']}\\t{e['by']}\\t{e['at']}\\t{e['sha256'][:12]}\")\n            return 0\n        by = _opt(args, \"--by\")\n        if verb == \"put\":\n            base = _opt(args, \"--base\")\n            if not args or args[0].startswith(\"--\") or base is None or not base.isdigit():\n                return _refuse(\"put FILE --base V --by LOGIN\")\n            try:\n                body = json.loads(Path(args[0]).read_text())\n            except (OSError, json.JSONDecodeError) as e:\n                return _refuse(f\"{args[0]} is not a readable JSON file: {e}\")\n            return _write(root, body, int(base), by)\n        current = store.get(root, DOC)\n        if current is None:\n            return _refuse(\"no plan in the store; put the first version with base 0\")\n        if verb == \"rank\":\n            before = _opt(args, \"--before\")\n            if not args or args[0].startswith(\"--\") or (before is None and \"--last\" not in args):\n                return _refuse(\"rank <EPIC|#N> (--before <EPIC|#M> | --last) --by LOGIN\")\n            return _write(root, rank(current[\"body\"], args[0], before), current[\"version\"], by)\n        if verb == \"claims\":\n            words = [w for i, w in enumerate(args) if w != \"--by\" and not (i and args[i - 1] == \"--by\")]\n            clear = \"--clear\" in words\n            paths = [w for w in words[1:] if w != \"--clear\"]\n            if not words or words[0].startswith(\"--\") or clear == bool(paths):\n                return _refuse(\"plan claims '#N' <path>... --by LOGIN, or plan claims '#N' --clear --by LOGIN\")\n            if not by:\n                return _refuse(\"a write names its author (--by LOGIN)\")\n            if clear:\n                return _write(root, clear_claims(current[\"body\"], words[0]), current[\"version\"], by)\n            at = now_iso()\n            return _write(root, set_claims(current[\"body\"], words[0], paths, by, at),\n                           current[\"version\"], by, at=at)\n        epic = _opt(args, \"--epic\")\n        if not args or args[0].startswith(\"--\") or epic is None:\n            return _refuse(\"move #N --epic EPIC --by LOGIN\")\n        return _write(root, move(current[\"body\"], args[0], epic), current[\"version\"], by)\n    except store.StoreRefusal as r:\n        return _refuse(str(r))\n\n\nCOMMANDS = (\n    Command(\n        name='plan',\n        run=cmd_plan,\n        usage=('attavo plan get [--version V] | put FILE --base V --by LOGIN | log', 'attavo plan rank <EPIC|#N> (--before <EPIC|#M> | --last) --by LOGIN', 'attavo plan move #N --epic EPIC --by LOGIN', 'attavo plan claims #N (<PATH>... | --clear) --by LOGIN'),\n        rank=160,\n        help=(\n            (80, \"\"\"\\\nplan keeps the Plan's order in the product's datastore, never in git:\nthe epics in rank order, each with its issues in rank order, the edges\nbetween issues, and policy. The store is <git common dir>/attavo/store/\n(ATTAVO_STORE overrides it): shared by every worktree of the clone, never\nstaged, one file per version. get prints the plan and its version; put\nwrites the next version from a file and refuses a stale --base by naming\nthe latest version and its author; log lists versions; rank and move\nchange one position or one membership and write the next version; claims\nsets (or --clear removes) the repository paths an issue will change before\nit has a spec, with who set them and when, and refuses an issue the plan\ndoes not place. A re-rank is a new version, not a commit: priority is\nworking material the attestation does not bind to.\"\"\"),\n        ),\n    ),\n)\n","numLines":364,"startLine":1,"totalLines":364}},"tool_result_meta":[{"id":"toolu_01JNUkDJY4adbjMx28dNGkpZ","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
{"type":"assistant","message":{"model":"claude-sonnet-5","id":"msg_011Cg2jeNTrs33AGCfZVVgk7","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_016vSRUBL9HBz6p6Nq2ykJBZ","name":"Read","input":{"file_path":"/Users/davidbean/Projects/attavo-worktree-339/attavo/store.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":358,"cache_read_input_tokens":28653,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":358},"output_tokens":2,"service_tier":"standard","inference_geo":"global"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"3394fcef-7256-4223-aca1-9021ad0ae8e1","uuid":"22ed7adc-1a79-42f9-855c-ebe880577f81","timestamp":"2026-10-14T20:09:45.995Z","request_id":"req_011Cg2jeNEU5NLC1pUMBTSrG","wire_tool_inputs":{"toolu_016vSRUBL9HBz6p6Nq2ykJBZ":{"file_path":"/Users/davidbean/Projects/attavo-worktree-339/attavo/store.py"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016vSRUBL9HBz6p6Nq2ykJBZ","type":"tool_result","content":"1\t\"\"\"The product's datastore: versioned documents keyed to the tenant.\n2\t\n3\tThe storage ruling (2026-09-25) splits what the product keeps in three:\n4\tgit holds the facts the attestation binds to; this store holds working\n5\tmaterial it does not bind to -- first the Plan's documents -- and never a\n6\trecord; content-addressed bulk holds the bytes a record points at by hash.\n7\t\n8\tA document is a folder <store>/<name>/ with one file per version,\n9\t<n>.json: {\"name\", \"version\", \"base\", \"sha256\", \"by\", \"at\", \"body\"}. A\n10\twrite names the version it read (its base) and creates <base+1>.json\n11\tthrough a hard link from a finished temporary file, which fails when that\n12\tversion already exists: two writers from the same base cannot both land,\n13\tthe loser is refused by name, and a reader never sees a half-written file.\n14\tNo database, no lock, and the same behaviour on a mounted folder.\n15\t\n16\tThe store lives under the clone's git common dir, <common>/attavo/store/,\n17\tso every worktree of a clone reads the same store and nothing in it is\n18\tever staged; ATTAVO_STORE overrides the location. It is per clone and per\n19\tmachine: sharing across people is the multi-user step, and a hosted engine\n20\treplaces this module then without changing a caller of get, put or log.\n21\t\"\"\"\n22\tfrom __future__ import annotations\n23\t\n24\timport hashlib\n25\timport json\n26\timport os\n27\timport re\n28\timport subprocess\n29\timport tempfile\n30\tfrom pathlib import Path\n31\tfrom typing import Any, Callable\n32\t\n33\tfrom attavo.common import now_iso, git_env\n34\t\n35\tNAME = re.compile(r\"^[a-z][a-z0-9-]*$\")\n36\tVERSION_FILE = re.compile(r\"^([0-9]+)\\.json$\")\n37\t\n38\t\n39\tclass StoreRefusal(Exception):\n40\t    \"\"\"A write or read the store refuses, with the reason as its message.\"\"\"\n41\t\n42\t\n43\tdef store_root(root: Path) -> Path:\n44\t    \"\"\"<git common dir>/attavo/store for the clone holding root, or\n45\t    ATTAVO_STORE when it is set.\"\"\"\n46\t    env = os.environ.get(\"ATTAVO_STORE\")\n47\t    if env:\n48\t        return Path(env).expanduser().resolve()\n49\t    run = subprocess.run([\"git\", \"-C\", str(root), \"rev-parse\", \"--git-common-dir\"],\n50\t                         capture_output=True, text=True, check=False, env=git_env())\n51\t    common = run.stdout.strip()\n52\t    if run.returncode != 0 or not common:\n53\t        raise StoreRefusal(f\"{root} is not in a git clone and ATTAVO_STORE is not set\")\n54\t    return (root / common).resolve() / \"attavo\" / \"store\"\n55\t\n56\t\n57\tdef _doc_dir(root: Path, name: str) -> Path:\n58\t    if not NAME.match(name):\n59\t        raise StoreRefusal(f\"{name!r} is not a document name\")\n60\t    return store_root(root) / name\n61\t\n62\t\n63\tdef body_sha256(body: Any) -> str:\n64\t    canonical = json.dumps(body, sort_keys=True, separators=(\",\", \":\"), ensure_ascii=False)\n65\t    return hashlib.sha256(canonical.encode()).hexdigest()\n66\t\n67\t\n68\tdef versions(root: Path, name: str) -> list[int]:\n69\t    d = _doc_dir(root, name)\n70\t    if not d.is_dir():\n71\t        return []\n72\t    found = (VERSION_FILE.match(p.name) for p in d.iterdir())\n73\t    return sorted(int(m.group(1)) for m in found if m)\n74\t\n75\t\n76\tdef latest(root: Path, name: str) -> int:\n77\t    \"\"\"The latest version, 0 when the document has none.\"\"\"\n78\t    vs = versions(root, name)\n79\t    return vs[-1] if vs else 0\n80\t\n81\t\n82\tdef get(root: Path, name: str, version: int | None = None) -> dict[str, Any] | None:\n83\t    \"\"\"The envelope of one version (the latest by default), None when absent.\"\"\"\n84\t    v = latest(root, name) if version is None else version\n85\t    if v <= 0:\n86\t        return None\n87\t    path = _doc_dir(root, name) / f\"{v}.json\"\n88\t    if not path.is_file():\n89\t        return None\n90\t    envelope: dict[str, Any] = json.loads(path.read_text())\n91\t    return envelope\n92\t\n93\t\n94\tdef log(root: Path, name: str) -> list[dict[str, Any]]:\n95\t    \"\"\"Every version's envelope without its body, oldest first.\"\"\"\n96\t    out = []\n97\t    for v in versions(root, name):\n98\t        env = get(root, name, v)\n99\t        if env is not None:\n100\t            out.append({k: env[k] for k in (\"version\", \"base\", \"sha256\", \"by\", \"at\")})\n101\t    return out\n102\t\n103\t\n104\tdef put(root: Path, name: str, body: Any, base: int, by: str,\n105\t        check: Callable[[Any], list[str]] | None = None, at: str | None = None) -> dict[str, Any]:\n106\t    \"\"\"Write version base+1 of name, or refuse: a stale base, an empty\n107\t    author, a body the check refuses, or a writer that landed first. at\n108\t    stamps the version; the default reads the clock, but a caller that\n109\t    already stamped part of the body (e.g. a plan claim) passes that same\n110\t    stamp here so the two agree by construction rather than by chance.\"\"\"\n111\t    if not by.strip():\n112\t        raise StoreRefusal(\"a write names its author (--by)\")\n113\t    if check is not None:\n114\t        errors = check(body)\n115\t        if errors:\n116\t            raise StoreRefusal(f\"the {name} body is refused: \" + \"; \".join(errors))\n117\t    current = latest(root, name)\n118\t    if base != current:\n119\t        raise StoreRefusal(_moved(root, name, base, current))\n120\t    d = _doc_dir(root, name)\n121\t    d.mkdir(parents=True, exist_ok=True)\n122\t    envelope = {\"name\": name, \"version\": base + 1, \"base\": base, \"sha256\": body_sha256(body),\n123\t                \"by\": by, \"at\": at if at is not None else now_iso(), \"body\": body}\n124\t    fd, tmp = tempfile.mkstemp(dir=d, prefix=\".put-\", suffix=\".json\")\n125\t    try:\n126\t        with os.fdopen(fd, \"w\") as f:\n127\t            f.write(json.dumps(envelope, indent=2, ensure_ascii=False) + \"\\n\")\n128\t        try:\n129\t            os.link(tmp, d / f\"{base + 1}.json\")\n130\t        except FileExistsError:\n131\t            raise StoreRefusal(_moved(root, name, base, latest(root, name))) from None\n132\t    finally:\n133\t        os.unlink(tmp)\n134\t    return envelope\n135\t\n136\t\n137\tdef _moved(root: Path, name: str, base: int, current: int) -> str:\n138\t    if current == 0:\n139\t        return f\"the {name} document has no version yet; write it with base 0, not {base}\"\n140\t    env = get(root, name, current) or {}\n141\t    return (f\"the {name} document moved: base {base} is not the latest; the latest is \"\n142\t            f\"version {current}, written by {env.get('by')} at {env.get('at')}\")\n143\t"}]},"parent_tool_use_id":null,"session_id":"3394fcef-7256-4223-aca1-9021ad0ae8e1","uuid":"e2e2aef7-9add-4378-b358-931bc5247164","timestamp":"2026-10-14T20:09:46.045Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-339/attavo/store.py","content":"\"\"\"The product's datastore: versioned documents keyed to the tenant.\n\nThe storage ruling (2026-09-25) splits what the product keeps in three:\ngit holds the facts the attestation binds to; this store holds working\nmaterial it does not bind to -- first the Plan's documents -- and never a\nrecord; content-addressed bulk holds the bytes a record points at by hash.\n\nA document is a folder <store>/<name>/ with one file per version,\n<n>.json: {\"name\", \"version\", \"base\", \"sha256\", \"by\", \"at\", \"body\"}. A\nwrite names the version it read (its base) and creates <base+1>.json\nthrough a hard link from a finished temporary file, which fails when that\nversion already exists: two writers from the same base cannot both land,\nthe loser is refused by name, and a reader never sees a half-written file.\nNo database, no lock, and the same behaviour on a mounted folder.\n\nThe store lives under the clone's git common dir, <common>/attavo/store/,\nso every worktree of a clone reads the same store and nothing in it is\never staged; ATTAVO_STORE overrides the location. It is per clone and per\nmachine: sharing across people is the multi-user step, and a hosted engine\nreplaces this module then without changing a caller of get, put or log.\n\"\"\"\nfrom __future__ import annotations\n\nimport hashlib\nimport json\nimport os\nimport re\nimport subprocess\nimport tempfile\nfrom pathlib import Path\nfrom typing import Any, Callable\n\nfrom attavo.common import now_iso, git_env\n\nNAME = re.compile(r\"^[a-z][a-z0-9-]*$\")\nVERSION_FILE = re.compile(r\"^([0-9]+)\\.json$\")\n\n\nclass StoreRefusal(Exception):\n    \"\"\"A write or read the store refuses, with the reason as its message.\"\"\"\n\n\ndef store_root(root: Path) -> Path:\n    \"\"\"<git common dir>/attavo/store for the clone holding root, or\n    ATTAVO_STORE when it is set.\"\"\"\n    env = os.environ.get(\"ATTAVO_STORE\")\n    if env:\n        return Path(env).expanduser().resolve()\n    run = subprocess.run([\"git\", \"-C\", str(root), \"rev-parse\", \"--git-common-dir\"],\n                         capture_output=True, text=True, check=False, env=git_env())\n    common = run.stdout.strip()\n    if run.returncode != 0 or not common:\n        raise StoreRefusal(f\"{root} is not in a git clone and ATTAVO_STORE is not set\")\n    return (root / common).resolve() / \"attavo\" / \"store\"\n\n\ndef _doc_dir(root: Path, name: str) -> Path:\n    if not NAME.match(name):\n        raise StoreRefusal(f\"{name!r} is not a document name\")\n    return store_root(root) / name\n\n\ndef body_sha256(body: Any) -> str:\n    canonical = json.dumps(body, sort_keys=True, separators=(\",\", \":\"), ensure_ascii=False)\n    return hashlib.sha256(canonical.encode()).hexdigest()\n\n\ndef versions(root: Path, name: str) -> list[int]:\n    d = _doc_dir(root, name)\n    if not d.is_dir():\n        return []\n    found = (VERSION_FILE.match(p.name) for p in d.iterdir())\n    return sorted(int(m.group(1)) for m in found if m)\n\n\ndef latest(root: Path, name: str) -> int:\n    \"\"\"The latest version, 0 when the document has none.\"\"\"\n    vs = versions(root, name)\n    return vs[-1] if vs else 0\n\n\ndef get(root: Path, name: str, version: int | None = None) -> dict[str, Any] | None:\n    \"\"\"The envelope of one version (the latest by default), None when absent.\"\"\"\n    v = latest(root, name) if version is None else version\n    if v <= 0:\n        return None\n    path = _doc_dir(root, name) / f\"{v}.json\"\n    if not path.is_file():\n        return None\n    envelope: dict[str, Any] = json.loads(path.read_text())\n    return envelope\n\n\ndef log(root: Path, name: str) -> list[dict[str, Any]]:\n    \"\"\"Every version's envelope without its body, oldest first.\"\"\"\n    out = []\n    for v in versions(root, name):\n        env = get(root, name, v)\n        if env is not None:\n            out.append({k: env[k] for k in (\"version\", \"base\", \"sha256\", \"by\", \"at\")})\n    return out\n\n\ndef put(root: Path, name: str, body: Any, base: int, by: str,\n        check: Callable[[Any], list[str]] | None = None, at: str | None = None) -> dict[str, Any]:\n    \"\"\"Write version base+1 of name, or refuse: a stale base, an empty\n    author, a body the check refuses, or a writer that landed first. at\n    stamps the version; the default reads the clock, but a caller that\n    already stamped part of the body (e.g. a plan claim) passes that same\n    stamp here so the two agree by construction rather than by chance.\"\"\"\n    if not by.strip():\n        raise StoreRefusal(\"a write names its author (--by)\")\n    if check is not None:\n        errors = check(body)\n        if errors:\n            raise StoreRefusal(f\"the {name} body is refused: \" + \"; \".join(errors))\n    current = latest(root, name)\n    if base != current:\n        raise StoreRefusal(_moved(root, name, base, current))\n    d = _doc_dir(root, name)\n    d.mkdir(parents=True, exist_ok=True)\n    envelope = {\"name\": name, \"version\": base + 1, \"base\": base, \"sha256\": body_sha256(body),\n                \"by\": by, \"at\": at if at is not None else now_iso(), \"body\": body}\n    fd, tmp = tempfile.mkstemp(dir=d, prefix=\".put-\", suffix=\".json\")\n    try:\n        with os.fdopen(fd, \"w\") as f:\n            f.write(json.dumps(envelope, indent=2, ensure_ascii=False) + \"\\n\")\n        try:\n            os.link(tmp, d / f\"{base + 1}.json\")\n        except FileExistsError:\n            raise StoreRefusal(_moved(root, name, base, latest(root, name))) from None\n    finally:\n        os.unlink(tmp)\n    return envelope\n\n\ndef _moved(root: Path, name: str, base: int, current: int) -> str:\n    if current == 0:\n        return f\"the {name} document has no version yet; write it with base 0, not {base}\"\n    env = get(root, name, current) or {}\n    return (f\"the {name} document moved: base {base} is not the latest; the latest is \"\n            f\"version {current}, written by {env.get('by')} at {env.get('at')}\")\n","numLines":143,"startLine":1,"totalLines":143}},"tool_result_meta":[{"id":"toolu_016vSRUBL9HBz6p6Nq2ykJBZ","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}

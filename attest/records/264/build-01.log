{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01KjySW34qsp5ydcYvYWkQ2L","type":"tool_result","content":"1\t\"\"\"The product's datastore (attavo/store.py): versioned documents keyed to\n2\tthe tenant, outside git. Written red first: on d4c0bc1 there is no\n3\tattavo.store module.\n4\t\n5\tRun: python3 -m pytest tests/test_store.py -q\n6\t\"\"\"\n7\tfrom __future__ import annotations\n8\t\n9\timport json\n10\timport os\n11\timport subprocess\n12\timport sys\n13\tfrom pathlib import Path\n14\tfrom typing import Any\n15\t\n16\timport pytest\n17\t\n18\tfrom attavo import store\n19\tfrom helpers import git, make_tenant\n20\t\n21\tROOT = Path(__file__).resolve().parent.parent\n22\t\n23\t\n24\t@pytest.fixture(autouse=True)\n25\tdef no_store_override(monkeypatch: pytest.MonkeyPatch) -> None:\n26\t    monkeypatch.delenv(\"ATTAVO_STORE\", raising=False)\n27\t\n28\t\n29\tdef test_a_put_from_the_latest_base_writes_the_next_version_and_get_and_log_read_it(tmp_path: Path) -> None:\n30\t    root = make_tenant(tmp_path, \"valid\")\n31\t    env = store.put(root, \"plan\", {\"a\": 1}, 0, \"alice\")\n32\t    assert (env[\"version\"], env[\"base\"], env[\"by\"]) == (1, 0, \"alice\")\n33\t    assert env[\"sha256\"] == store.body_sha256({\"a\": 1}) and env[\"at\"]\n34\t    env2 = store.put(root, \"plan\", {\"a\": 2}, 1, \"bob\")\n35\t    assert env2[\"version\"] == 2\n36\t    got = store.get(root, \"plan\")\n37\t    assert got is not None and got[\"body\"] == {\"a\": 2}\n38\t    first = store.get(root, \"plan\", 1)\n39\t    assert first is not None and first[\"body\"] == {\"a\": 1}\n40\t    assert [(e[\"version\"], e[\"by\"]) for e in store.log(root, \"plan\")] == [(1, \"alice\"), (2, \"bob\")]\n41\t    assert \"body\" not in store.log(root, \"plan\")[0]\n42\t\n43\t\n44\tdef test_a_stale_base_is_refused_by_name_with_the_latest_version_and_its_author(tmp_path: Path) -> None:\n45\t    root = make_tenant(tmp_path, \"valid\")\n46\t    store.put(root, \"plan\", {\"a\": 1}, 0, \"alice\")\n47\t    store.put(root, \"plan\", {\"a\": 2}, 1, \"bob\")\n48\t    with pytest.raises(store.StoreRefusal) as r:\n49\t        store.put(root, \"plan\", {\"a\": 3}, 1, \"carol\")\n50\t    assert \"moved\" in str(r.value) and \"version 2\" in str(r.value) and \"bob\" in str(r.value)\n51\t    assert store.latest(root, \"plan\") == 2\n52\t\n53\t\n54\tdef test_two_writers_from_one_base_leave_one_version_and_one_refusal(tmp_path: Path) -> None:\n55\t    root = make_tenant(tmp_path, \"valid\")\n56\t    store.put(root, \"plan\", {\"a\": 0}, 0, \"alice\")\n57\t    script = (\"import sys; sys.path.insert(0, sys.argv[1]); from pathlib import Path; from attavo import store\\n\"\n58\t              \"try:\\n    store.put(Path(sys.argv[2]), 'plan', {'w': sys.argv[3]}, 1, sys.argv[3]); print('landed')\\n\"\n59\t              \"except store.StoreRefusal as r:\\n    print('refused', r)\\n\")\n60\t    procs = [subprocess.Popen([sys.executable, \"-c\", script, str(ROOT), str(root), f\"w{i}\"],\n61\t                              stdout=subprocess.PIPE, text=True) for i in range(6)]\n62\t    outs = [p.communicate()[0] for p in procs]\n63\t    assert sum(o.startswith(\"landed\") for o in outs) == 1, outs\n64\t    assert sum(o.startswith(\"refused\") for o in outs) == 5, outs\n65\t    assert store.versions(root, \"plan\") == [1, 2]\n66\t\n67\t\n68\tdef test_a_writer_that_loses_the_link_race_is_refused_naming_the_winner(tmp_path: Path,\n69\t                                                                         monkeypatch: pytest.MonkeyPatch) -> None:\n70\t    root = make_tenant(tmp_path, \"valid\")\n71\t    store.put(root, \"plan\", {\"a\": 1}, 0, \"alice\")\n72\t    real_latest = store.latest\n73\t    calls = {\"n\": 0}\n74\t\n75\t    def stale_once(r: Path, name: str) -> int:\n76\t        calls[\"n\"] += 1\n77\t        return 0 if calls[\"n\"] == 1 else real_latest(r, name)\n78\t\n79\t    monkeypatch.setattr(store, \"latest\", stale_once)\n80\t    with pytest.raises(store.StoreRefusal) as r:\n81\t        store.put(root, \"plan\", {\"a\": 9}, 0, \"bob\")\n82\t    assert \"version 1\" in str(r.value) and \"alice\" in str(r.value)\n83\t    monkeypatch.setattr(store, \"latest\", real_latest)\n84\t    got = store.get(root, \"plan\")\n85\t    assert got is not None and got[\"body\"] == {\"a\": 1}\n86\t    assert not [p for p in (store.store_root(root) / \"plan\").iterdir() if p.name.startswith(\".put-\")]\n87\t\n88\t\n89\tdef test_a_body_the_check_refuses_and_a_missing_author_write_nothing(tmp_path: Path) -> None:\n90\t    root = make_tenant(tmp_path, \"valid\")\n91\t\n92\t    def check(body: Any) -> list[str]:\n93\t        return [] if isinstance(body, dict) and \"ok\" in body else [\"no ok key\"]\n94\t\n95\t    with pytest.raises(store.StoreRefusal, match=\"no ok key\"):\n96\t        store.put(root, \"plan\", {\"bad\": 1}, 0, \"alice\", check=check)\n97\t    with pytest.raises(store.StoreRefusal, match=\"author\"):\n98\t        store.put(root, \"plan\", {\"ok\": 1}, 0, \"  \", check=check)\n99\t    assert store.latest(root, \"plan\") == 0\n100\t\n101\t\n102\tdef test_the_store_is_under_the_git_common_dir_shared_by_a_worktree_and_never_staged(tmp_path: Path) -> None:\n103\t    root = make_tenant(tmp_path, \"valid\")\n104\t    common = Path(git(root, \"rev-parse\", \"--git-common-dir\").strip())\n105\t    common = (root / common).resolve()\n106\t    assert store.store_root(root) == common / \"attavo\" / \"store\"\n107\t    wt = tmp_path / \"wt\"\n108\t    git(root, \"worktree\", \"add\", \"-q\", \"-b\", \"lane/x\", str(wt))\n109\t    assert store.store_root(wt) == store.store_root(root)\n110\t    store.put(wt, \"plan\", {\"from\": \"worktree\"}, 0, \"alice\")\n111\t    got = store.get(root, \"plan\")\n112\t    assert got is not None and got[\"body\"] == {\"from\": \"worktree\"}\n113\t    assert git(root, \"status\", \"--porcelain\") == \"\"\n114\t    assert git(wt, \"status\", \"--porcelain\") == \"\"\n115\t\n116\t\n117\tdef test_attavo_store_overrides_the_location_and_a_directory_outside_git_is_refused(\n118\t        tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:\n119\t    plain = tmp_path / \"plain\"\n120\t    plain.mkdir()\n121\t    with pytest.raises(store.StoreRefusal, match=\"not in a git clone\"):\n122\t        store.store_root(plain)\n123\t    monkeypatch.setenv(\"ATTAVO_STORE\", str(tmp_path / \"elsewhere\"))\n124\t    assert store.store_root(plain) == (tmp_path / \"elsewhere\").resolve()\n125\t    store.put(plain, \"plan\", {\"x\": 1}, 0, \"alice\")\n126\t    written = json.loads((tmp_path / \"elsewhere\" / \"plan\" / \"1.json\").read_text())\n127\t    assert written[\"body\"] == {\"x\": 1} and written[\"version\"] == 1\n128\t\n129\t\n130\tdef test_a_document_name_that_is_not_a_name_is_refused(tmp_path: Path) -> None:\n131\t    root = make_tenant(tmp_path, \"valid\")\n132\t    for bad in (\"../x\", \"Plan\", \"\", \"a/b\"):\n133\t        with pytest.raises(store.StoreRefusal):\n134\t            store.put(root, bad, {}, 0, \"alice\")\n135\t    assert not os.path.exists(tmp_path / \"x\")\n136\t"}]},"parent_tool_use_id":null,"session_id":"e85505ef-5bc6-4673-8ea8-d33ff59437af","uuid":"6fdcad89-51ed-472f-81f5-a036ad3dbc8f","timestamp":"2026-09-29T19:21:31.704Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-264/attest/specs/264/stub/tests/test_store.py","content":"\"\"\"The product's datastore (attavo/store.py): versioned documents keyed to\nthe tenant, outside git. Written red first: on d4c0bc1 there is no\nattavo.store module.\n\nRun: python3 -m pytest tests/test_store.py -q\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport os\nimport subprocess\nimport sys\nfrom pathlib import Path\nfrom typing import Any\n\nimport pytest\n\nfrom attavo import store\nfrom helpers import git, make_tenant\n\nROOT = Path(__file__).resolve().parent.parent\n\n\n@pytest.fixture(autouse=True)\ndef no_store_override(monkeypatch: pytest.MonkeyPatch) -> None:\n    monkeypatch.delenv(\"ATTAVO_STORE\", raising=False)\n\n\ndef test_a_put_from_the_latest_base_writes_the_next_version_and_get_and_log_read_it(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"valid\")\n    env = store.put(root, \"plan\", {\"a\": 1}, 0, \"alice\")\n    assert (env[\"version\"], env[\"base\"], env[\"by\"]) == (1, 0, \"alice\")\n    assert env[\"sha256\"] == store.body_sha256({\"a\": 1}) and env[\"at\"]\n    env2 = store.put(root, \"plan\", {\"a\": 2}, 1, \"bob\")\n    assert env2[\"version\"] == 2\n    got = store.get(root, \"plan\")\n    assert got is not None and got[\"body\"] == {\"a\": 2}\n    first = store.get(root, \"plan\", 1)\n    assert first is not None and first[\"body\"] == {\"a\": 1}\n    assert [(e[\"version\"], e[\"by\"]) for e in store.log(root, \"plan\")] == [(1, \"alice\"), (2, \"bob\")]\n    assert \"body\" not in store.log(root, \"plan\")[0]\n\n\ndef test_a_stale_base_is_refused_by_name_with_the_latest_version_and_its_author(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"valid\")\n    store.put(root, \"plan\", {\"a\": 1}, 0, \"alice\")\n    store.put(root, \"plan\", {\"a\": 2}, 1, \"bob\")\n    with pytest.raises(store.StoreRefusal) as r:\n        store.put(root, \"plan\", {\"a\": 3}, 1, \"carol\")\n    assert \"moved\" in str(r.value) and \"version 2\" in str(r.value) and \"bob\" in str(r.value)\n    assert store.latest(root, \"plan\") == 2\n\n\ndef test_two_writers_from_one_base_leave_one_version_and_one_refusal(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"valid\")\n    store.put(root, \"plan\", {\"a\": 0}, 0, \"alice\")\n    script = (\"import sys; sys.path.insert(0, sys.argv[1]); from pathlib import Path; from attavo import store\\n\"\n              \"try:\\n    store.put(Path(sys.argv[2]), 'plan', {'w': sys.argv[3]}, 1, sys.argv[3]); print('landed')\\n\"\n              \"except store.StoreRefusal as r:\\n    print('refused', r)\\n\")\n    procs = [subprocess.Popen([sys.executable, \"-c\", script, str(ROOT), str(root), f\"w{i}\"],\n                              stdout=subprocess.PIPE, text=True) for i in range(6)]\n    outs = [p.communicate()[0] for p in procs]\n    assert sum(o.startswith(\"landed\") for o in outs) == 1, outs\n    assert sum(o.startswith(\"refused\") for o in outs) == 5, outs\n    assert store.versions(root, \"plan\") == [1, 2]\n\n\ndef test_a_writer_that_loses_the_link_race_is_refused_naming_the_winner(tmp_path: Path,\n                                                                         monkeypatch: pytest.MonkeyPatch) -> None:\n    root = make_tenant(tmp_path, \"valid\")\n    store.put(root, \"plan\", {\"a\": 1}, 0, \"alice\")\n    real_latest = store.latest\n    calls = {\"n\": 0}\n\n    def stale_once(r: Path, name: str) -> int:\n        calls[\"n\"] += 1\n        return 0 if calls[\"n\"] == 1 else real_latest(r, name)\n\n    monkeypatch.setattr(store, \"latest\", stale_once)\n    with pytest.raises(store.StoreRefusal) as r:\n        store.put(root, \"plan\", {\"a\": 9}, 0, \"bob\")\n    assert \"version 1\" in str(r.value) and \"alice\" in str(r.value)\n    monkeypatch.setattr(store, \"latest\", real_latest)\n    got = store.get(root, \"plan\")\n    assert got is not None and got[\"body\"] == {\"a\": 1}\n    assert not [p for p in (store.store_root(root) / \"plan\").iterdir() if p.name.startswith(\".put-\")]\n\n\ndef test_a_body_the_check_refuses_and_a_missing_author_write_nothing(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"valid\")\n\n    def check(body: Any) -> list[str]:\n        return [] if isinstance(body, dict) and \"ok\" in body else [\"no ok key\"]\n\n    with pytest.raises(store.StoreRefusal, match=\"no ok key\"):\n        store.put(root, \"plan\", {\"bad\": 1}, 0, \"alice\", check=check)\n    with pytest.raises(store.StoreRefusal, match=\"author\"):\n        store.put(root, \"plan\", {\"ok\": 1}, 0, \"  \", check=check)\n    assert store.latest(root, \"plan\") == 0\n\n\ndef test_the_store_is_under_the_git_common_dir_shared_by_a_worktree_and_never_staged(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"valid\")\n    common = Path(git(root, \"rev-parse\", \"--git-common-dir\").strip())\n    common = (root / common).resolve()\n    assert store.store_root(root) == common / \"attavo\" / \"store\"\n    wt = tmp_path / \"wt\"\n    git(root, \"worktree\", \"add\", \"-q\", \"-b\", \"lane/x\", str(wt))\n    assert store.store_root(wt) == store.store_root(root)\n    store.put(wt, \"plan\", {\"from\": \"worktree\"}, 0, \"alice\")\n    got = store.get(root, \"plan\")\n    assert got is not None and got[\"body\"] == {\"from\": \"worktree\"}\n    assert git(root, \"status\", \"--porcelain\") == \"\"\n    assert git(wt, \"status\", \"--porcelain\") == \"\"\n\n\ndef test_attavo_store_overrides_the_location_and_a_directory_outside_git_is_refused(\n        tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:\n    plain = tmp_path / \"plain\"\n    plain.mkdir()\n    with pytest.raises(store.StoreRefusal, match=\"not in a git clone\"):\n        store.store_root(plain)\n    monkeypatch.setenv(\"ATTAVO_STORE\", str(tmp_path / \"elsewhere\"))\n    assert store.store_root(plain) == (tmp_path / \"elsewhere\").resolve()\n    store.put(plain, \"plan\", {\"x\": 1}, 0, \"alice\")\n    written = json.loads((tmp_path / \"elsewhere\" / \"plan\" / \"1.json\").read_text())\n    assert written[\"body\"] == {\"x\": 1} and written[\"version\"] == 1\n\n\ndef test_a_document_name_that_is_not_a_name_is_refused(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"valid\")\n    for bad in (\"../x\", \"Plan\", \"\", \"a/b\"):\n        with pytest.raises(store.StoreRefusal):\n            store.put(root, bad, {}, 0, \"alice\")\n    assert not os.path.exists(tmp_path / \"x\")\n","numLines":136,"startLine":1,"totalLines":136}}}

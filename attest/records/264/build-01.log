{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015gXqexUFrMDc9Xb1fPs4yJ","type":"tool_result","content":"1\t\"\"\"attavo plan: the Plan's order, kept in the product's datastore.\n2\t\n3\tThe plan is one document in the store (attavo/store.py), named \"plan\":\n4\tthe epics in rank order, each with its issues in rank order; the edges\n5\tbetween issues (\"depends\", and \"ruled\" with who ruled it and when); and\n6\tthe policy lines. It holds no issue text, state or claims -- the forge\n7\tand git hold those -- and it is never committed: priority is working\n8\tmaterial the attestation does not bind to (the storage ruling), so a\n9\tre-rank is a new version of this document, not a commit, a pull request\n10\tor a merge. Git takes over when an issue becomes a spec.\n11\t\n12\tThe global order is epic rank, then issue rank within the epic. Backlog\n13\tis an epic like any other and must exist, so an issue always has a home.\n14\t\n15\t    attavo plan get [--version V]\n16\t    attavo plan put FILE --base V --by LOGIN\n17\t    attavo plan log\n18\t    attavo plan rank <EPIC|#N> (--before <EPIC|#M> | --last) --by LOGIN\n19\t    attavo plan move #N --epic EPIC --by LOGIN\n20\t\n21\tget prints the body as JSON on stdout and its version, author and time on\n22\tstderr, so `get > f`, an edit, and `put f --base V` round-trip. put writes\n23\tthe next version or refuses: a stale base (naming the latest version and\n24\tits author), a body that fails the plan's shape, or a writer that landed\n25\tfirst. rank and move read the latest version, change one position or one\n26\tmembership, and write the next. Nothing here writes to git.\n27\t\"\"\"\n28\tfrom __future__ import annotations\n29\t\n30\timport copy\n31\timport json\n32\timport re\n33\timport sys\n34\tfrom pathlib import Path\n35\tfrom typing import Any\n36\t\n37\tfrom attavo import store\n38\tfrom attavo.common import MANIFEST, read_manifest\n39\t\n40\tDOC = \"plan\"\n41\tSCHEMA = \"plan/1\"\n42\tBACKLOG = \"backlog\"\n43\tEPIC_ID = re.compile(r\"^[A-Za-z][A-Za-z0-9_-]*$\")\n44\tEDGE_TYPES = (\"depends\", \"ruled\")\n45\tEPIC_KEYS = {\"id\", \"title\", \"outcome\", \"proof\", \"issues\"}\n46\tEDGE_KEYS = {\"type\", \"from\", \"to\", \"by\", \"at\", \"why\", \"evidence\", \"applies\"}\n47\tTOP_KEYS = {\"schema\", \"epics\", \"edges\", \"policy\"}\n48\t\n49\t\n50\tdef _is_issue(x: Any) -> bool:\n51\t    return isinstance(x, int) and not isinstance(x, bool) and x > 0\n52\t\n53\t\n54\tdef shape_errors(body: Any) -> list[str]:\n55\t    \"\"\"What is wrong with a plan body, [] when nothing is. The contract is\n56\t    schema/plan.schema.json; this is its check with the standard library,\n57\t    as records.py checks records, because bin/attavo takes no dependency.\"\"\"\n58\t    if not isinstance(body, dict):\n59\t        return [\"the plan is not an object\"]\n60\t    errs = [f\"unknown key {k!r}\" for k in sorted(set(body) - TOP_KEYS)]\n61\t    if body.get(\"schema\") != SCHEMA:\n62\t        errs.append(f\"schema is not {SCHEMA!r}\")\n63\t    epics = body.get(\"epics\")\n64\t    if not isinstance(epics, list):\n65\t        return errs + [\"epics is not a list\"]\n66\t    seen_epics: set[str] = set()\n67\t    placed: dict[int, str] = {}\n68\t    for e in epics:\n69\t        if not isinstance(e, dict):\n70\t            errs.append(\"an epic is not an object\")\n71\t            continue\n72\t        eid = e.get(\"id\")\n73\t        errs += [f\"epic {eid}: unknown key {k!r}\" for k in sorted(set(e) - EPIC_KEYS)]\n74\t        if not isinstance(eid, str) or not EPIC_ID.match(eid):\n75\t            errs.append(f\"epic id {eid!r} is not a name\")\n76\t            continue\n77\t        if eid in seen_epics:\n78\t            errs.append(f\"epic {eid} appears twice\")\n79\t        seen_epics.add(eid)\n80\t        if not isinstance(e.get(\"title\"), str) or not e[\"title\"].strip():\n81\t            errs.append(f\"epic {eid} has no title\")\n82\t        for k in (\"outcome\", \"proof\"):\n83\t            if k in e and not isinstance(e[k], str):\n84\t                errs.append(f\"epic {eid}: {k} is not text\")\n85\t        issues = e.get(\"issues\")\n86\t        if not isinstance(issues, list):\n87\t            errs.append(f\"epic {eid}: issues is not a list\")\n88\t            continue\n89\t        for n in issues:\n90\t            if not _is_issue(n):\n91\t                errs.append(f\"epic {eid}: {n!r} is not an issue number\")\n92\t            elif n in placed:\n93\t                errs.append(f\"#{n} is in both {placed[n]} and {eid}\")\n94\t            else:\n95\t                placed[n] = eid\n96\t    if BACKLOG not in seen_epics:\n97\t        errs.append(f\"there is no {BACKLOG} epic\")\n98\t    edges = body.get(\"edges\")\n99\t    if not isinstance(edges, list):\n100\t        return errs + [\"edges is not a list\"]\n101\t    for i, g in enumerate(edges):\n102\t        if not isinstance(g, dict):\n103\t            errs.append(f\"edge {i} is not an object\")\n104\t            continue\n105\t        errs += [f\"edge {i}: unknown key {k!r}\" for k in sorted(set(g) - EDGE_KEYS)]\n106\t        if g.get(\"type\") not in EDGE_TYPES:\n107\t            errs.append(f\"edge {i}: type is not one of {', '.join(EDGE_TYPES)}\")\n108\t        if not _is_issue(g.get(\"from\")) or not _is_issue(g.get(\"to\")):\n109\t            errs.append(f\"edge {i}: from and to are not issue numbers\")\n110\t        elif g[\"from\"] == g[\"to\"]:\n111\t            errs.append(f\"edge {i}: #{g['from']} depends on itself\")\n112\t        if g.get(\"type\") == \"ruled\" and not (isinstance(g.get(\"by\"), str) and isinstance(g.get(\"at\"), str)):\n113\t            errs.append(f\"edge {i}: a ruled edge names who ruled it and when (by, at)\")\n114\t        if \"applies\" in g and g[\"applies\"] != \"spec\":\n115\t            errs.append(f\"edge {i}: applies is only \\\"spec\\\"\")\n116\t    policy = body.get(\"policy\", {})\n117\t    if not isinstance(policy, dict):\n118\t        errs.append(\"policy is not an object\")\n119\t    return errs\n120\t\n121\t\n122\tdef global_order(body: dict[str, Any]) -> list[tuple[str, int]]:\n123\t    \"\"\"(epic, issue) for every placed issue: epic rank, then issue rank.\"\"\"\n124\t    return [(e[\"id\"], n) for e in body[\"epics\"] for n in e[\"issues\"]]\n125\t\n126\t\n127\tdef _issue_arg(s: str) -> int | None:\n128\t    t = s[1:] if s.startswith(\"#\") else s\n129\t    return int(t) if t.isdigit() and int(t) > 0 else None\n130\t\n131\t\n132\tdef _epic_of(body: dict[str, Any], n: int) -> dict[str, Any] | None:\n133\t    return next((e for e in body[\"epics\"] if n in e[\"issues\"]), None)\n134\t\n135\t\n136\tdef rank(body: dict[str, Any], what: str, before: str | None) -> dict[str, Any]:\n137\t    \"\"\"A copy of body with one epic, or one issue within its epic, moved\n138\t    before another (or last when before is None). Raises StoreRefusal.\"\"\"\n139\t    new: dict[str, Any] = copy.deepcopy(body)\n140\t    n = _issue_arg(what)\n141\t    if n is None:\n142\t        ids = [e[\"id\"] for e in new[\"epics\"]]\n143\t        if what not in ids:\n144\t            raise store.StoreRefusal(f\"no epic {what} in the plan\")\n145\t        epic = new[\"epics\"].pop(ids.index(what))\n146\t        if before is None:\n147\t            new[\"epics\"].append(epic)\n148\t        else:\n149\t            ids = [e[\"id\"] for e in new[\"epics\"]]\n150\t            if before not in ids:\n151\t                raise store.StoreRefusal(f\"no epic {before} in the plan to rank {what} before\")\n152\t            new[\"epics\"].insert(ids.index(before), epic)\n153\t        return new\n154\t    home = _epic_of(new, n)\n155\t    if home is None:\n156\t        raise store.StoreRefusal(f\"#{n} is not in the plan; place it with `attavo plan move #{n} --epic E`\")\n157\t    home[\"issues\"].remove(n)\n158\t    if before is None:\n159\t        home[\"issues\"].append(n)\n160\t        return new\n161\t    m = _issue_arg(before)\n162\t    if m is None or m not in home[\"issues\"]:\n163\t        raise store.StoreRefusal(f\"#{n} ranks only within its epic ({home['id']}); \"\n164\t                                 f\"{before} is not an issue there -- move it first\")\n165\t    home[\"issues\"].insert(home[\"issues\"].index(m), n)\n166\t    return new\n167\t\n168\t\n169\tdef move(body: dict[str, Any], what: str, epic: str) -> dict[str, Any]:\n170\t    \"\"\"A copy of body with issue what placed last in epic, taken out of\n171\t    whichever epic held it. Raises StoreRefusal.\"\"\"\n172\t    n = _issue_arg(what)\n173\t    if n is None:\n174\t        raise store.StoreRefusal(f\"{what} is not an issue number\")\n175\t    new: dict[str, Any] = copy.deepcopy(body)\n176\t    target = next((e for e in new[\"epics\"] if e[\"id\"] == epic), None)\n177\t    if target is None:\n178\t        raise store.StoreRefusal(f\"no epic {epic} in the plan\")\n179\t    home = _epic_of(new, n)\n180\t    if home is not None:\n181\t        home[\"issues\"].remove(n)\n182\t    target[\"issues\"].append(n)\n183\t    return new\n184\t\n185\t\n186\tdef _opt(args: list[str], flag: str) -> str | None:\n187\t    if flag in args:\n188\t        i = args.index(flag)\n189\t        if i + 1 < len(args):\n190\t            return args[i + 1]\n191\t    return None\n192\t\n193\t\n194\tdef _refuse(msg: str) -> int:\n195\t    print(f\"attavo plan: refused: {msg}\", file=sys.stderr)\n196\t    return 2\n197\t\n198\t\n199\tdef _write(root: Path, body: dict[str, Any], base: int, by: str | None) -> int:\n200\t    if not by:\n201\t        return _refuse(\"a write names its author (--by LOGIN)\")\n202\t    try:\n203\t        env = store.put(root, DOC, body, base, by, check=shape_errors)\n204\t    except store.StoreRefusal as r:\n205\t        return _refuse(str(r))\n206\t    print(f\"plan version {env['version']} written by {env['by']} at {env['at']} (sha256 {env['sha256'][:12]})\")\n207\t    return 0\n208\t\n209\t\n210\tdef cmd_plan(argv: list[str]) -> int:\n211\t    root = Path(\".\").resolve()\n212\t    if read_manifest(root) is None:\n213\t        print(f\"attavo plan: no {MANIFEST} at {root}\", file=sys.stderr)\n214\t        return 2\n215\t    if not argv or argv[0] not in (\"get\", \"put\", \"log\", \"rank\", \"move\"):\n216\t        print(\"usage: attavo plan get [--version V] | put FILE --base V --by LOGIN | log | \"\n217\t              \"rank <EPIC|#N> (--before <EPIC|#M> | --last) --by LOGIN | move #N --epic EPIC --by LOGIN\",\n218\t              file=sys.stderr)\n219\t        return 2\n220\t    verb, args = argv[0], argv[1:]\n221\t    try:\n222\t        if verb == \"get\":\n223\t            v = _opt(args, \"--version\")\n224\t            env = store.get(root, DOC, int(v) if v and v.isdigit() else None)\n225\t            if env is None:\n226\t                return _refuse(\"no plan in the store\" + (f\" at version {v}\" if v else \"\"))\n227\t            print(json.dumps(env[\"body\"], indent=2, ensure_ascii=False))\n228\t            print(f\"plan version {env['version']} by {env['by']} at {env['at']}\", file=sys.stderr)\n229\t            return 0\n230\t        if verb == \"log\":\n231\t            entries = store.log(root, DOC)\n232\t            if not entries:\n233\t                return _refuse(\"no plan in the store\")\n234\t            for e in entries:\n235\t                print(f\"{e['version']}\\tbase {e['base']}\\t{e['by']}\\t{e['at']}\\t{e['sha256'][:12]}\")\n236\t            return 0\n237\t        by = _opt(args, \"--by\")\n238\t        if verb == \"put\":\n239\t            base = _opt(args, \"--base\")\n240\t            if not args or args[0].startswith(\"--\") or base is None or not base.isdigit():\n241\t                return _refuse(\"put FILE --base V --by LOGIN\")\n242\t            try:\n243\t                body = json.loads(Path(args[0]).read_text())\n244\t            except (OSError, json.JSONDecodeError) as e:\n245\t                return _refuse(f\"{args[0]} is not a readable JSON file: {e}\")\n246\t            return _write(root, body, int(base), by)\n247\t        current = store.get(root, DOC)\n248\t        if current is None:\n249\t            return _refuse(\"no plan in the store; put the first version with base 0\")\n250\t        if verb == \"rank\":\n251\t            before = _opt(args, \"--before\")\n252\t            if not args or args[0].startswith(\"--\") or (before is None and \"--last\" not in args):\n253\t                return _refuse(\"rank <EPIC|#N> (--before <EPIC|#M> | --last) --by LOGIN\")\n254\t            return _write(root, rank(current[\"body\"], args[0], before), current[\"version\"], by)\n255\t        epic = _opt(args, \"--epic\")\n256\t        if not args or args[0].startswith(\"--\") or epic is None:\n257\t            return _refuse(\"move #N --epic EPIC --by LOGIN\")\n258\t        return _write(root, move(current[\"body\"], args[0], epic), current[\"version\"], by)\n259\t    except store.StoreRefusal as r:\n260\t        return _refuse(str(r))\n261\t"}]},"parent_tool_use_id":null,"session_id":"e85505ef-5bc6-4673-8ea8-d33ff59437af","uuid":"32c2dfb4-07bd-4e3d-8a71-9735fbe305ef","timestamp":"2026-09-29T19:21:19.605Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-264/attest/specs/264/stub/attavo/plan.py","content":"\"\"\"attavo plan: the Plan's order, kept in the product's datastore.\n\nThe plan is one document in the store (attavo/store.py), named \"plan\":\nthe epics in rank order, each with its issues in rank order; the edges\nbetween issues (\"depends\", and \"ruled\" with who ruled it and when); and\nthe policy lines. It holds no issue text, state or claims -- the forge\nand git hold those -- and it is never committed: priority is working\nmaterial the attestation does not bind to (the storage ruling), so a\nre-rank is a new version of this document, not a commit, a pull request\nor a merge. Git takes over when an issue becomes a spec.\n\nThe global order is epic rank, then issue rank within the epic. Backlog\nis an epic like any other and must exist, so an issue always has a home.\n\n    attavo plan get [--version V]\n    attavo plan put FILE --base V --by LOGIN\n    attavo plan log\n    attavo plan rank <EPIC|#N> (--before <EPIC|#M> | --last) --by LOGIN\n    attavo plan move #N --epic EPIC --by LOGIN\n\nget prints the body as JSON on stdout and its version, author and time on\nstderr, so `get > f`, an edit, and `put f --base V` round-trip. put writes\nthe next version or refuses: a stale base (naming the latest version and\nits author), a body that fails the plan's shape, or a writer that landed\nfirst. rank and move read the latest version, change one position or one\nmembership, and write the next. Nothing here writes to git.\n\"\"\"\nfrom __future__ import annotations\n\nimport copy\nimport json\nimport re\nimport sys\nfrom pathlib import Path\nfrom typing import Any\n\nfrom attavo import store\nfrom attavo.common import MANIFEST, read_manifest\n\nDOC = \"plan\"\nSCHEMA = \"plan/1\"\nBACKLOG = \"backlog\"\nEPIC_ID = re.compile(r\"^[A-Za-z][A-Za-z0-9_-]*$\")\nEDGE_TYPES = (\"depends\", \"ruled\")\nEPIC_KEYS = {\"id\", \"title\", \"outcome\", \"proof\", \"issues\"}\nEDGE_KEYS = {\"type\", \"from\", \"to\", \"by\", \"at\", \"why\", \"evidence\", \"applies\"}\nTOP_KEYS = {\"schema\", \"epics\", \"edges\", \"policy\"}\n\n\ndef _is_issue(x: Any) -> bool:\n    return isinstance(x, int) and not isinstance(x, bool) and x > 0\n\n\ndef shape_errors(body: Any) -> list[str]:\n    \"\"\"What is wrong with a plan body, [] when nothing is. The contract is\n    schema/plan.schema.json; this is its check with the standard library,\n    as records.py checks records, because bin/attavo takes no dependency.\"\"\"\n    if not isinstance(body, dict):\n        return [\"the plan is not an object\"]\n    errs = [f\"unknown key {k!r}\" for k in sorted(set(body) - TOP_KEYS)]\n    if body.get(\"schema\") != SCHEMA:\n        errs.append(f\"schema is not {SCHEMA!r}\")\n    epics = body.get(\"epics\")\n    if not isinstance(epics, list):\n        return errs + [\"epics is not a list\"]\n    seen_epics: set[str] = set()\n    placed: dict[int, str] = {}\n    for e in epics:\n        if not isinstance(e, dict):\n            errs.append(\"an epic is not an object\")\n            continue\n        eid = e.get(\"id\")\n        errs += [f\"epic {eid}: unknown key {k!r}\" for k in sorted(set(e) - EPIC_KEYS)]\n        if not isinstance(eid, str) or not EPIC_ID.match(eid):\n            errs.append(f\"epic id {eid!r} is not a name\")\n            continue\n        if eid in seen_epics:\n            errs.append(f\"epic {eid} appears twice\")\n        seen_epics.add(eid)\n        if not isinstance(e.get(\"title\"), str) or not e[\"title\"].strip():\n            errs.append(f\"epic {eid} has no title\")\n        for k in (\"outcome\", \"proof\"):\n            if k in e and not isinstance(e[k], str):\n                errs.append(f\"epic {eid}: {k} is not text\")\n        issues = e.get(\"issues\")\n        if not isinstance(issues, list):\n            errs.append(f\"epic {eid}: issues is not a list\")\n            continue\n        for n in issues:\n            if not _is_issue(n):\n                errs.append(f\"epic {eid}: {n!r} is not an issue number\")\n            elif n in placed:\n                errs.append(f\"#{n} is in both {placed[n]} and {eid}\")\n            else:\n                placed[n] = eid\n    if BACKLOG not in seen_epics:\n        errs.append(f\"there is no {BACKLOG} epic\")\n    edges = body.get(\"edges\")\n    if not isinstance(edges, list):\n        return errs + [\"edges is not a list\"]\n    for i, g in enumerate(edges):\n        if not isinstance(g, dict):\n            errs.append(f\"edge {i} is not an object\")\n            continue\n        errs += [f\"edge {i}: unknown key {k!r}\" for k in sorted(set(g) - EDGE_KEYS)]\n        if g.get(\"type\") not in EDGE_TYPES:\n            errs.append(f\"edge {i}: type is not one of {', '.join(EDGE_TYPES)}\")\n        if not _is_issue(g.get(\"from\")) or not _is_issue(g.get(\"to\")):\n            errs.append(f\"edge {i}: from and to are not issue numbers\")\n        elif g[\"from\"] == g[\"to\"]:\n            errs.append(f\"edge {i}: #{g['from']} depends on itself\")\n        if g.get(\"type\") == \"ruled\" and not (isinstance(g.get(\"by\"), str) and isinstance(g.get(\"at\"), str)):\n            errs.append(f\"edge {i}: a ruled edge names who ruled it and when (by, at)\")\n        if \"applies\" in g and g[\"applies\"] != \"spec\":\n            errs.append(f\"edge {i}: applies is only \\\"spec\\\"\")\n    policy = body.get(\"policy\", {})\n    if not isinstance(policy, dict):\n        errs.append(\"policy is not an object\")\n    return errs\n\n\ndef global_order(body: dict[str, Any]) -> list[tuple[str, int]]:\n    \"\"\"(epic, issue) for every placed issue: epic rank, then issue rank.\"\"\"\n    return [(e[\"id\"], n) for e in body[\"epics\"] for n in e[\"issues\"]]\n\n\ndef _issue_arg(s: str) -> int | None:\n    t = s[1:] if s.startswith(\"#\") else s\n    return int(t) if t.isdigit() and int(t) > 0 else None\n\n\ndef _epic_of(body: dict[str, Any], n: int) -> dict[str, Any] | None:\n    return next((e for e in body[\"epics\"] if n in e[\"issues\"]), None)\n\n\ndef rank(body: dict[str, Any], what: str, before: str | None) -> dict[str, Any]:\n    \"\"\"A copy of body with one epic, or one issue within its epic, moved\n    before another (or last when before is None). Raises StoreRefusal.\"\"\"\n    new: dict[str, Any] = copy.deepcopy(body)\n    n = _issue_arg(what)\n    if n is None:\n        ids = [e[\"id\"] for e in new[\"epics\"]]\n        if what not in ids:\n            raise store.StoreRefusal(f\"no epic {what} in the plan\")\n        epic = new[\"epics\"].pop(ids.index(what))\n        if before is None:\n            new[\"epics\"].append(epic)\n        else:\n            ids = [e[\"id\"] for e in new[\"epics\"]]\n            if before not in ids:\n                raise store.StoreRefusal(f\"no epic {before} in the plan to rank {what} before\")\n            new[\"epics\"].insert(ids.index(before), epic)\n        return new\n    home = _epic_of(new, n)\n    if home is None:\n        raise store.StoreRefusal(f\"#{n} is not in the plan; place it with `attavo plan move #{n} --epic E`\")\n    home[\"issues\"].remove(n)\n    if before is None:\n        home[\"issues\"].append(n)\n        return new\n    m = _issue_arg(before)\n    if m is None or m not in home[\"issues\"]:\n        raise store.StoreRefusal(f\"#{n} ranks only within its epic ({home['id']}); \"\n                                 f\"{before} is not an issue there -- move it first\")\n    home[\"issues\"].insert(home[\"issues\"].index(m), n)\n    return new\n\n\ndef move(body: dict[str, Any], what: str, epic: str) -> dict[str, Any]:\n    \"\"\"A copy of body with issue what placed last in epic, taken out of\n    whichever epic held it. Raises StoreRefusal.\"\"\"\n    n = _issue_arg(what)\n    if n is None:\n        raise store.StoreRefusal(f\"{what} is not an issue number\")\n    new: dict[str, Any] = copy.deepcopy(body)\n    target = next((e for e in new[\"epics\"] if e[\"id\"] == epic), None)\n    if target is None:\n        raise store.StoreRefusal(f\"no epic {epic} in the plan\")\n    home = _epic_of(new, n)\n    if home is not None:\n        home[\"issues\"].remove(n)\n    target[\"issues\"].append(n)\n    return new\n\n\ndef _opt(args: list[str], flag: str) -> str | None:\n    if flag in args:\n        i = args.index(flag)\n        if i + 1 < len(args):\n            return args[i + 1]\n    return None\n\n\ndef _refuse(msg: str) -> int:\n    print(f\"attavo plan: refused: {msg}\", file=sys.stderr)\n    return 2\n\n\ndef _write(root: Path, body: dict[str, Any], base: int, by: str | None) -> int:\n    if not by:\n        return _refuse(\"a write names its author (--by LOGIN)\")\n    try:\n        env = store.put(root, DOC, body, base, by, check=shape_errors)\n    except store.StoreRefusal as r:\n        return _refuse(str(r))\n    print(f\"plan version {env['version']} written by {env['by']} at {env['at']} (sha256 {env['sha256'][:12]})\")\n    return 0\n\n\ndef cmd_plan(argv: list[str]) -> int:\n    root = Path(\".\").resolve()\n    if read_manifest(root) is None:\n        print(f\"attavo plan: no {MANIFEST} at {root}\", file=sys.stderr)\n        return 2\n    if not argv or argv[0] not in (\"get\", \"put\", \"log\", \"rank\", \"move\"):\n        print(\"usage: attavo plan get [--version V] | put FILE --base V --by LOGIN | log | \"\n              \"rank <EPIC|#N> (--before <EPIC|#M> | --last) --by LOGIN | move #N --epic EPIC --by LOGIN\",\n              file=sys.stderr)\n        return 2\n    verb, args = argv[0], argv[1:]\n    try:\n        if verb == \"get\":\n            v = _opt(args, \"--version\")\n            env = store.get(root, DOC, int(v) if v and v.isdigit() else None)\n            if env is None:\n                return _refuse(\"no plan in the store\" + (f\" at version {v}\" if v else \"\"))\n            print(json.dumps(env[\"body\"], indent=2, ensure_ascii=False))\n            print(f\"plan version {env['version']} by {env['by']} at {env['at']}\", file=sys.stderr)\n            return 0\n        if verb == \"log\":\n            entries = store.log(root, DOC)\n            if not entries:\n                return _refuse(\"no plan in the store\")\n            for e in entries:\n                print(f\"{e['version']}\\tbase {e['base']}\\t{e['by']}\\t{e['at']}\\t{e['sha256'][:12]}\")\n            return 0\n        by = _opt(args, \"--by\")\n        if verb == \"put\":\n            base = _opt(args, \"--base\")\n            if not args or args[0].startswith(\"--\") or base is None or not base.isdigit():\n                return _refuse(\"put FILE --base V --by LOGIN\")\n            try:\n                body = json.loads(Path(args[0]).read_text())\n            except (OSError, json.JSONDecodeError) as e:\n                return _refuse(f\"{args[0]} is not a readable JSON file: {e}\")\n            return _write(root, body, int(base), by)\n        current = store.get(root, DOC)\n        if current is None:\n            return _refuse(\"no plan in the store; put the first version with base 0\")\n        if verb == \"rank\":\n            before = _opt(args, \"--before\")\n            if not args or args[0].startswith(\"--\") or (before is None and \"--last\" not in args):\n                return _refuse(\"rank <EPIC|#N> (--before <EPIC|#M> | --last) --by LOGIN\")\n            return _write(root, rank(current[\"body\"], args[0], before), current[\"version\"], by)\n        epic = _opt(args, \"--epic\")\n        if not args or args[0].startswith(\"--\") or epic is None:\n            return _refuse(\"move #N --epic EPIC --by LOGIN\")\n        return _write(root, move(current[\"body\"], args[0], epic), current[\"version\"], by)\n    except store.StoreRefusal as r:\n        return _refuse(str(r))\n","numLines":261,"startLine":1,"totalLines":261}}}

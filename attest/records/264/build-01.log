{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0176wpPY7twSWn4QCSwaTVFe","type":"tool_result","content":"1\t\"\"\"attavo plan: the Plan's order in the product's datastore (attavo/plan.py).\n2\tWritten red first: on d4c0bc1 there is no plan subcommand and no\n3\tattavo.plan module.\n4\t\n5\tRun: python3 -m pytest tests/test_plan.py -q\n6\t\"\"\"\n7\tfrom __future__ import annotations\n8\t\n9\timport copy\n10\timport json\n11\timport subprocess\n12\timport sys\n13\tfrom pathlib import Path\n14\tfrom typing import Any\n15\t\n16\timport jsonschema\n17\timport pytest\n18\t\n19\tfrom attavo import plan, store\n20\tfrom helpers import git, make_tenant\n21\t\n22\tROOT = Path(__file__).resolve().parent.parent\n23\tATTAVO = ROOT / \"bin\" / \"attavo\"\n24\tSCHEMA = json.loads((ROOT / \"schema\" / \"plan.schema.json\").read_text())\n25\t\n26\tPLAN: dict[str, Any] = {\n27\t    \"schema\": \"plan/1\",\n28\t    \"epics\": [\n29\t        {\"id\": \"E4\", \"title\": \"Plan on the screen\", \"outcome\": \"waves on the screen\", \"issues\": [262, 263]},\n30\t        {\"id\": \"backlog\", \"title\": \"Backlog\", \"issues\": [231, 232]},\n31\t        {\"id\": \"E5\", \"title\": \"Claims arbitration\", \"issues\": [264]},\n32\t    ],\n33\t    \"edges\": [\n34\t        {\"type\": \"depends\", \"from\": 262, \"to\": 263, \"evidence\": \"reads its JSON\"},\n35\t        {\"type\": \"ruled\", \"from\": 231, \"to\": 264, \"by\": \"dbean10\", \"at\": \"2026-09-29\", \"why\": \"order\"},\n36\t    ],\n37\t    \"policy\": {\"research\": \"not required\"},\n38\t}\n39\t\n40\t\n41\t@pytest.fixture(autouse=True)\n42\tdef no_store_override(monkeypatch: pytest.MonkeyPatch) -> None:\n43\t    monkeypatch.delenv(\"ATTAVO_STORE\", raising=False)\n44\t\n45\t\n46\tdef run_attavo(root: Path, *args: str) -> subprocess.CompletedProcess[str]:\n47\t    return subprocess.run([sys.executable, str(ATTAVO), *args], cwd=str(root),\n48\t                          capture_output=True, text=True, check=False)\n49\t\n50\t\n51\tdef broken(**change: Any) -> dict[str, Any]:\n52\t    body = copy.deepcopy(PLAN)\n53\t    body.update(change)\n54\t    return body\n55\t\n56\t\n57\tdef test_a_plan_passes_its_own_check_and_its_schema() -> None:\n58\t    assert plan.shape_errors(PLAN) == []\n59\t    jsonschema.validate(PLAN, SCHEMA)\n60\t\n61\t\n62\t@pytest.mark.parametrize(\"body,needle\", [\n63\t    (broken(epics=[e for e in PLAN[\"epics\"] if e[\"id\"] != \"backlog\"]), \"no backlog epic\"),\n64\t    (broken(extra=1), \"unknown key\"),\n65\t    (broken(schema=\"plan/0\"), \"schema\"),\n66\t    (broken(edges=[{\"type\": \"ruled\", \"from\": 1, \"to\": 2}]), \"names who ruled it\"),\n67\t    (broken(edges=[{\"type\": \"blocks\", \"from\": 1, \"to\": 2}]), \"type is not\"),\n68\t    (broken(epics=[{\"id\": \"backlog\", \"title\": \"Backlog\", \"issues\": [\"#1\"]}]), \"not an issue number\"),\n69\t])\n70\tdef test_the_check_and_the_schema_refuse_the_same_bodies(body: dict[str, Any], needle: str) -> None:\n71\t    assert any(needle in e for e in plan.shape_errors(body)), plan.shape_errors(body)\n72\t    with pytest.raises(jsonschema.ValidationError):\n73\t        jsonschema.validate(body, SCHEMA)\n74\t\n75\t\n76\tdef test_the_check_refuses_what_a_schema_cannot_say() -> None:\n77\t    twice = broken(epics=[{\"id\": \"backlog\", \"title\": \"Backlog\", \"issues\": [5]},\n78\t                          {\"id\": \"E1\", \"title\": \"One\", \"issues\": [5]}])\n79\t    assert any(\"#5 is in both backlog and E1\" in e for e in plan.shape_errors(twice))\n80\t    loop = broken(edges=[{\"type\": \"depends\", \"from\": 7, \"to\": 7}])\n81\t    assert any(\"depends on itself\" in e for e in plan.shape_errors(loop))\n82\t\n83\t\n84\tdef test_the_global_order_is_epic_rank_then_issue_rank() -> None:\n85\t    assert plan.global_order(PLAN) == [(\"E4\", 262), (\"E4\", 263), (\"backlog\", 231),\n86\t                                       (\"backlog\", 232), (\"E5\", 264)]\n87\t\n88\t\n89\tdef test_rank_moves_one_epic_or_one_issue_within_its_epic_and_nothing_else() -> None:\n90\t    by_epic = plan.rank(PLAN, \"backlog\", \"E4\")\n91\t    assert [e[\"id\"] for e in by_epic[\"epics\"]] == [\"backlog\", \"E4\", \"E5\"]\n92\t    assert [e[\"id\"] for e in plan.rank(PLAN, \"E4\", None)[\"epics\"]] == [\"backlog\", \"E5\", \"E4\"]\n93\t    by_issue = plan.rank(PLAN, \"#263\", \"#262\")\n94\t    assert by_issue[\"epics\"][0][\"issues\"] == [263, 262]\n95\t    assert by_issue[\"epics\"][1:] == PLAN[\"epics\"][1:] and by_issue[\"edges\"] == PLAN[\"edges\"]\n96\t    assert plan.rank(PLAN, \"231\", None)[\"epics\"][1][\"issues\"] == [232, 231]\n97\t    with pytest.raises(store.StoreRefusal, match=\"ranks only within its epic\"):\n98\t        plan.rank(PLAN, \"#264\", \"#262\")\n99\t    with pytest.raises(store.StoreRefusal, match=\"not in the plan\"):\n100\t        plan.rank(PLAN, \"#999\", None)\n101\t    assert PLAN[\"epics\"][0][\"issues\"] == [262, 263], \"rank returns a copy\"\n102\t\n103\t\n104\tdef test_move_places_an_issue_last_in_an_epic_and_takes_it_out_of_its_old_one() -> None:\n105\t    moved = plan.move(PLAN, \"#262\", \"backlog\")\n106\t    assert moved[\"epics\"][0][\"issues\"] == [263]\n107\t    assert moved[\"epics\"][1][\"issues\"] == [231, 232, 262]\n108\t    placed = plan.move(PLAN, \"#300\", \"E5\")\n109\t    assert placed[\"epics\"][2][\"issues\"] == [264, 300]\n110\t    assert plan.shape_errors(moved) == [] and plan.shape_errors(placed) == []\n111\t    with pytest.raises(store.StoreRefusal, match=\"no epic E9\"):\n112\t        plan.move(PLAN, \"#262\", \"E9\")\n113\t\n114\t\n115\tdef test_the_command_puts_gets_ranks_and_refuses_a_stale_base_with_nothing_in_git(tmp_path: Path) -> None:\n116\t    root = make_tenant(tmp_path, \"valid\")\n117\t    f = tmp_path / \"plan.json\"\n118\t    f.write_text(json.dumps(PLAN))\n119\t    put = run_attavo(root, \"plan\", \"put\", str(f), \"--base\", \"0\", \"--by\", \"alice\")\n120\t    assert put.returncode == 0 and \"plan version 1 written by alice\" in put.stdout, put.stdout + put.stderr\n121\t    got = run_attavo(root, \"plan\", \"get\")\n122\t    assert got.returncode == 0 and json.loads(got.stdout) == PLAN and \"plan version 1 by alice\" in got.stderr\n123\t    ranked = run_attavo(root, \"plan\", \"rank\", \"#263\", \"--before\", \"#262\", \"--by\", \"bob\")\n124\t    assert ranked.returncode == 0 and \"plan version 2 written by bob\" in ranked.stdout, ranked.stderr\n125\t    assert json.loads(run_attavo(root, \"plan\", \"get\").stdout)[\"epics\"][0][\"issues\"] == [263, 262]\n126\t    moved = run_attavo(root, \"plan\", \"move\", \"#232\", \"--epic\", \"E5\", \"--by\", \"bob\")\n127\t    assert moved.returncode == 0, moved.stderr\n128\t    stale = run_attavo(root, \"plan\", \"put\", str(f), \"--base\", \"1\", \"--by\", \"carol\")\n129\t    assert stale.returncode == 2\n130\t    assert \"moved\" in stale.stderr and \"version 3\" in stale.stderr and \"bob\" in stale.stderr\n131\t    log = run_attavo(root, \"plan\", \"log\")\n132\t    assert [line.split(\"\\t\")[0] for line in log.stdout.splitlines()] == [\"1\", \"2\", \"3\"]\n133\t    first = run_attavo(root, \"plan\", \"get\", \"--version\", \"1\")\n134\t    assert json.loads(first.stdout) == PLAN\n135\t    assert git(root, \"status\", \"--porcelain\") == \"\"\n136\t\n137\t\n138\tdef test_the_command_refuses_a_bad_body_a_missing_author_and_an_empty_store(tmp_path: Path) -> None:\n139\t    root = make_tenant(tmp_path, \"valid\")\n140\t    assert \"no plan in the store\" in run_attavo(root, \"plan\", \"get\").stderr\n141\t    assert run_attavo(root, \"plan\", \"rank\", \"E4\", \"--last\", \"--by\", \"x\").returncode == 2\n142\t    bad = tmp_path / \"bad.json\"\n143\t    bad.write_text(json.dumps(broken(epics=[])))\n144\t    r = run_attavo(root, \"plan\", \"put\", str(bad), \"--base\", \"0\", \"--by\", \"alice\")\n145\t    assert r.returncode == 2 and \"no backlog epic\" in r.stderr, r.stderr\n146\t    good = tmp_path / \"good.json\"\n147\t    good.write_text(json.dumps(PLAN))\n148\t    r = run_attavo(root, \"plan\", \"put\", str(good), \"--base\", \"0\")\n149\t    assert r.returncode == 2 and \"--by\" in r.stderr\n150\t    assert store.latest(root, \"plan\") == 0\n151\t"}]},"parent_tool_use_id":null,"session_id":"e85505ef-5bc6-4673-8ea8-d33ff59437af","uuid":"9e42576e-c28e-4458-b228-d409e4b28934","timestamp":"2026-09-29T19:21:32.832Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-264/attest/specs/264/stub/tests/test_plan.py","content":"\"\"\"attavo plan: the Plan's order in the product's datastore (attavo/plan.py).\nWritten red first: on d4c0bc1 there is no plan subcommand and no\nattavo.plan module.\n\nRun: python3 -m pytest tests/test_plan.py -q\n\"\"\"\nfrom __future__ import annotations\n\nimport copy\nimport json\nimport subprocess\nimport sys\nfrom pathlib import Path\nfrom typing import Any\n\nimport jsonschema\nimport pytest\n\nfrom attavo import plan, store\nfrom helpers import git, make_tenant\n\nROOT = Path(__file__).resolve().parent.parent\nATTAVO = ROOT / \"bin\" / \"attavo\"\nSCHEMA = json.loads((ROOT / \"schema\" / \"plan.schema.json\").read_text())\n\nPLAN: dict[str, Any] = {\n    \"schema\": \"plan/1\",\n    \"epics\": [\n        {\"id\": \"E4\", \"title\": \"Plan on the screen\", \"outcome\": \"waves on the screen\", \"issues\": [262, 263]},\n        {\"id\": \"backlog\", \"title\": \"Backlog\", \"issues\": [231, 232]},\n        {\"id\": \"E5\", \"title\": \"Claims arbitration\", \"issues\": [264]},\n    ],\n    \"edges\": [\n        {\"type\": \"depends\", \"from\": 262, \"to\": 263, \"evidence\": \"reads its JSON\"},\n        {\"type\": \"ruled\", \"from\": 231, \"to\": 264, \"by\": \"dbean10\", \"at\": \"2026-09-29\", \"why\": \"order\"},\n    ],\n    \"policy\": {\"research\": \"not required\"},\n}\n\n\n@pytest.fixture(autouse=True)\ndef no_store_override(monkeypatch: pytest.MonkeyPatch) -> None:\n    monkeypatch.delenv(\"ATTAVO_STORE\", raising=False)\n\n\ndef run_attavo(root: Path, *args: str) -> subprocess.CompletedProcess[str]:\n    return subprocess.run([sys.executable, str(ATTAVO), *args], cwd=str(root),\n                          capture_output=True, text=True, check=False)\n\n\ndef broken(**change: Any) -> dict[str, Any]:\n    body = copy.deepcopy(PLAN)\n    body.update(change)\n    return body\n\n\ndef test_a_plan_passes_its_own_check_and_its_schema() -> None:\n    assert plan.shape_errors(PLAN) == []\n    jsonschema.validate(PLAN, SCHEMA)\n\n\n@pytest.mark.parametrize(\"body,needle\", [\n    (broken(epics=[e for e in PLAN[\"epics\"] if e[\"id\"] != \"backlog\"]), \"no backlog epic\"),\n    (broken(extra=1), \"unknown key\"),\n    (broken(schema=\"plan/0\"), \"schema\"),\n    (broken(edges=[{\"type\": \"ruled\", \"from\": 1, \"to\": 2}]), \"names who ruled it\"),\n    (broken(edges=[{\"type\": \"blocks\", \"from\": 1, \"to\": 2}]), \"type is not\"),\n    (broken(epics=[{\"id\": \"backlog\", \"title\": \"Backlog\", \"issues\": [\"#1\"]}]), \"not an issue number\"),\n])\ndef test_the_check_and_the_schema_refuse_the_same_bodies(body: dict[str, Any], needle: str) -> None:\n    assert any(needle in e for e in plan.shape_errors(body)), plan.shape_errors(body)\n    with pytest.raises(jsonschema.ValidationError):\n        jsonschema.validate(body, SCHEMA)\n\n\ndef test_the_check_refuses_what_a_schema_cannot_say() -> None:\n    twice = broken(epics=[{\"id\": \"backlog\", \"title\": \"Backlog\", \"issues\": [5]},\n                          {\"id\": \"E1\", \"title\": \"One\", \"issues\": [5]}])\n    assert any(\"#5 is in both backlog and E1\" in e for e in plan.shape_errors(twice))\n    loop = broken(edges=[{\"type\": \"depends\", \"from\": 7, \"to\": 7}])\n    assert any(\"depends on itself\" in e for e in plan.shape_errors(loop))\n\n\ndef test_the_global_order_is_epic_rank_then_issue_rank() -> None:\n    assert plan.global_order(PLAN) == [(\"E4\", 262), (\"E4\", 263), (\"backlog\", 231),\n                                       (\"backlog\", 232), (\"E5\", 264)]\n\n\ndef test_rank_moves_one_epic_or_one_issue_within_its_epic_and_nothing_else() -> None:\n    by_epic = plan.rank(PLAN, \"backlog\", \"E4\")\n    assert [e[\"id\"] for e in by_epic[\"epics\"]] == [\"backlog\", \"E4\", \"E5\"]\n    assert [e[\"id\"] for e in plan.rank(PLAN, \"E4\", None)[\"epics\"]] == [\"backlog\", \"E5\", \"E4\"]\n    by_issue = plan.rank(PLAN, \"#263\", \"#262\")\n    assert by_issue[\"epics\"][0][\"issues\"] == [263, 262]\n    assert by_issue[\"epics\"][1:] == PLAN[\"epics\"][1:] and by_issue[\"edges\"] == PLAN[\"edges\"]\n    assert plan.rank(PLAN, \"231\", None)[\"epics\"][1][\"issues\"] == [232, 231]\n    with pytest.raises(store.StoreRefusal, match=\"ranks only within its epic\"):\n        plan.rank(PLAN, \"#264\", \"#262\")\n    with pytest.raises(store.StoreRefusal, match=\"not in the plan\"):\n        plan.rank(PLAN, \"#999\", None)\n    assert PLAN[\"epics\"][0][\"issues\"] == [262, 263], \"rank returns a copy\"\n\n\ndef test_move_places_an_issue_last_in_an_epic_and_takes_it_out_of_its_old_one() -> None:\n    moved = plan.move(PLAN, \"#262\", \"backlog\")\n    assert moved[\"epics\"][0][\"issues\"] == [263]\n    assert moved[\"epics\"][1][\"issues\"] == [231, 232, 262]\n    placed = plan.move(PLAN, \"#300\", \"E5\")\n    assert placed[\"epics\"][2][\"issues\"] == [264, 300]\n    assert plan.shape_errors(moved) == [] and plan.shape_errors(placed) == []\n    with pytest.raises(store.StoreRefusal, match=\"no epic E9\"):\n        plan.move(PLAN, \"#262\", \"E9\")\n\n\ndef test_the_command_puts_gets_ranks_and_refuses_a_stale_base_with_nothing_in_git(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"valid\")\n    f = tmp_path / \"plan.json\"\n    f.write_text(json.dumps(PLAN))\n    put = run_attavo(root, \"plan\", \"put\", str(f), \"--base\", \"0\", \"--by\", \"alice\")\n    assert put.returncode == 0 and \"plan version 1 written by alice\" in put.stdout, put.stdout + put.stderr\n    got = run_attavo(root, \"plan\", \"get\")\n    assert got.returncode == 0 and json.loads(got.stdout) == PLAN and \"plan version 1 by alice\" in got.stderr\n    ranked = run_attavo(root, \"plan\", \"rank\", \"#263\", \"--before\", \"#262\", \"--by\", \"bob\")\n    assert ranked.returncode == 0 and \"plan version 2 written by bob\" in ranked.stdout, ranked.stderr\n    assert json.loads(run_attavo(root, \"plan\", \"get\").stdout)[\"epics\"][0][\"issues\"] == [263, 262]\n    moved = run_attavo(root, \"plan\", \"move\", \"#232\", \"--epic\", \"E5\", \"--by\", \"bob\")\n    assert moved.returncode == 0, moved.stderr\n    stale = run_attavo(root, \"plan\", \"put\", str(f), \"--base\", \"1\", \"--by\", \"carol\")\n    assert stale.returncode == 2\n    assert \"moved\" in stale.stderr and \"version 3\" in stale.stderr and \"bob\" in stale.stderr\n    log = run_attavo(root, \"plan\", \"log\")\n    assert [line.split(\"\\t\")[0] for line in log.stdout.splitlines()] == [\"1\", \"2\", \"3\"]\n    first = run_attavo(root, \"plan\", \"get\", \"--version\", \"1\")\n    assert json.loads(first.stdout) == PLAN\n    assert git(root, \"status\", \"--porcelain\") == \"\"\n\n\ndef test_the_command_refuses_a_bad_body_a_missing_author_and_an_empty_store(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"valid\")\n    assert \"no plan in the store\" in run_attavo(root, \"plan\", \"get\").stderr\n    assert run_attavo(root, \"plan\", \"rank\", \"E4\", \"--last\", \"--by\", \"x\").returncode == 2\n    bad = tmp_path / \"bad.json\"\n    bad.write_text(json.dumps(broken(epics=[])))\n    r = run_attavo(root, \"plan\", \"put\", str(bad), \"--base\", \"0\", \"--by\", \"alice\")\n    assert r.returncode == 2 and \"no backlog epic\" in r.stderr, r.stderr\n    good = tmp_path / \"good.json\"\n    good.write_text(json.dumps(PLAN))\n    r = run_attavo(root, \"plan\", \"put\", str(good), \"--base\", \"0\")\n    assert r.returncode == 2 and \"--by\" in r.stderr\n    assert store.latest(root, \"plan\") == 0\n","numLines":151,"startLine":1,"totalLines":151}}}

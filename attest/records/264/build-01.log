{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UMcRTdMEfYpDhcpTun7Uy7","type":"tool_result","content":"1\t\"\"\"The product's datastore: versioned documents keyed to the tenant.\n2\t\n3\tThe storage ruling (2026-09-25) splits what the product keeps in three:\n4\tgit holds the facts the attestation binds to; this store holds working\n5\tmaterial it does not bind to -- first the Plan's documents -- and never a\n6\trecord; content-addressed bulk holds the bytes a record points at by hash.\n7\t\n8\tA document is a folder <store>/<name>/ with one file per version,\n9\t<n>.json: {\"name\", \"version\", \"base\", \"sha256\", \"by\", \"at\", \"body\"}. A\n10\twrite names the version it read (its base) and creates <base+1>.json\n11\tthrough a hard link from a finished temporary file, which fails when that\n12\tversion already exists: two writers from the same base cannot both land,\n13\tthe loser is refused by name, and a reader never sees a half-written file.\n14\tNo database, no lock, and the same behaviour on a mounted folder.\n15\t\n16\tThe store lives under the clone's git common dir, <common>/attavo/store/,\n17\tso every worktree of a clone reads the same store and nothing in it is\n18\tever staged; ATTAVO_STORE overrides the location. It is per clone and per\n19\tmachine: sharing across people is the multi-user step, and a hosted engine\n20\treplaces this module then without changing a caller of get, put or log.\n21\t\"\"\"\n22\tfrom __future__ import annotations\n23\t\n24\timport hashlib\n25\timport json\n26\timport os\n27\timport re\n28\timport subprocess\n29\timport tempfile\n30\tfrom pathlib import Path\n31\tfrom typing import Any, Callable\n32\t\n33\tfrom attavo.common import now_iso\n34\t\n35\tNAME = re.compile(r\"^[a-z][a-z0-9-]*$\")\n36\tVERSION_FILE = re.compile(r\"^([0-9]+)\\.json$\")\n37\t\n38\t\n39\tclass StoreRefusal(Exception):\n40\t    \"\"\"A write or read the store refuses, with the reason as its message.\"\"\"\n41\t\n42\t\n43\tdef store_root(root: Path) -> Path:\n44\t    \"\"\"<git common dir>/attavo/store for the clone holding root, or\n45\t    ATTAVO_STORE when it is set.\"\"\"\n46\t    env = os.environ.get(\"ATTAVO_STORE\")\n47\t    if env:\n48\t        return Path(env).expanduser().resolve()\n49\t    run = subprocess.run([\"git\", \"-C\", str(root), \"rev-parse\", \"--git-common-dir\"],\n50\t                         capture_output=True, text=True, check=False)\n51\t    common = run.stdout.strip()\n52\t    if run.returncode != 0 or not common:\n53\t        raise StoreRefusal(f\"{root} is not in a git clone and ATTAVO_STORE is not set\")\n54\t    return (root / common).resolve() / \"attavo\" / \"store\"\n55\t\n56\t\n57\tdef _doc_dir(root: Path, name: str) -> Path:\n58\t    if not NAME.match(name):\n59\t        raise StoreRefusal(f\"{name!r} is not a document name\")\n60\t    return store_root(root) / name\n61\t\n62\t\n63\tdef body_sha256(body: Any) -> str:\n64\t    canonical = json.dumps(body, sort_keys=True, separators=(\",\", \":\"), ensure_ascii=False)\n65\t    return hashlib.sha256(canonical.encode()).hexdigest()\n66\t\n67\t\n68\tdef versions(root: Path, name: str) -> list[int]:\n69\t    d = _doc_dir(root, name)\n70\t    if not d.is_dir():\n71\t        return []\n72\t    found = (VERSION_FILE.match(p.name) for p in d.iterdir())\n73\t    return sorted(int(m.group(1)) for m in found if m)\n74\t\n75\t\n76\tdef latest(root: Path, name: str) -> int:\n77\t    \"\"\"The latest version, 0 when the document has none.\"\"\"\n78\t    vs = versions(root, name)\n79\t    return vs[-1] if vs else 0\n80\t\n81\t\n82\tdef get(root: Path, name: str, version: int | None = None) -> dict[str, Any] | None:\n83\t    \"\"\"The envelope of one version (the latest by default), None when absent.\"\"\"\n84\t    v = latest(root, name) if version is None else version\n85\t    if v <= 0:\n86\t        return None\n87\t    path = _doc_dir(root, name) / f\"{v}.json\"\n88\t    if not path.is_file():\n89\t        return None\n90\t    envelope: dict[str, Any] = json.loads(path.read_text())\n91\t    return envelope\n92\t\n93\t\n94\tdef log(root: Path, name: str) -> list[dict[str, Any]]:\n95\t    \"\"\"Every version's envelope without its body, oldest first.\"\"\"\n96\t    out = []\n97\t    for v in versions(root, name):\n98\t        env = get(root, name, v)\n99\t        if env is not None:\n100\t            out.append({k: env[k] for k in (\"version\", \"base\", \"sha256\", \"by\", \"at\")})\n101\t    return out\n102\t\n103\t\n104\tdef put(root: Path, name: str, body: Any, base: int, by: str,\n105\t        check: Callable[[Any], list[str]] | None = None) -> dict[str, Any]:\n106\t    \"\"\"Write version base+1 of name, or refuse: a stale base, an empty\n107\t    author, a body the check refuses, or a writer that landed first.\"\"\"\n108\t    if not by.strip():\n109\t        raise StoreRefusal(\"a write names its author (--by)\")\n110\t    if check is not None:\n111\t        errors = check(body)\n112\t        if errors:\n113\t            raise StoreRefusal(f\"the {name} body is refused: \" + \"; \".join(errors))\n114\t    current = latest(root, name)\n115\t    if base != current:\n116\t        raise StoreRefusal(_moved(root, name, base, current))\n117\t    d = _doc_dir(root, name)\n118\t    d.mkdir(parents=True, exist_ok=True)\n119\t    envelope = {\"name\": name, \"version\": base + 1, \"base\": base, \"sha256\": body_sha256(body),\n120\t                \"by\": by, \"at\": now_iso(), \"body\": body}\n121\t    fd, tmp = tempfile.mkstemp(dir=d, prefix=\".put-\", suffix=\".json\")\n122\t    try:\n123\t        with os.fdopen(fd, \"w\") as f:\n124\t            f.write(json.dumps(envelope, indent=2, ensure_ascii=False) + \"\\n\")\n125\t        try:\n126\t            os.link(tmp, d / f\"{base + 1}.json\")\n127\t        except FileExistsError:\n128\t            raise StoreRefusal(_moved(root, name, base, latest(root, name))) from None\n129\t    finally:\n130\t        os.unlink(tmp)\n131\t    return envelope\n132\t\n133\t\n134\tdef _moved(root: Path, name: str, base: int, current: int) -> str:\n135\t    if current == 0:\n136\t        return f\"the {name} document has no version yet; write it with base 0, not {base}\"\n137\t    env = get(root, name, current) or {}\n138\t    return (f\"the {name} document moved: base {base} is not the latest; the latest is \"\n139\t            f\"version {current}, written by {env.get('by')} at {env.get('at')}\")\n140\t"}]},"parent_tool_use_id":null,"session_id":"e85505ef-5bc6-4673-8ea8-d33ff59437af","uuid":"1a7f4073-d692-420d-8697-3e754c2efd65","timestamp":"2026-09-29T19:21:18.214Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-264/attest/specs/264/stub/attavo/store.py","content":"\"\"\"The product's datastore: versioned documents keyed to the tenant.\n\nThe storage ruling (2026-09-25) splits what the product keeps in three:\ngit holds the facts the attestation binds to; this store holds working\nmaterial it does not bind to -- first the Plan's documents -- and never a\nrecord; content-addressed bulk holds the bytes a record points at by hash.\n\nA document is a folder <store>/<name>/ with one file per version,\n<n>.json: {\"name\", \"version\", \"base\", \"sha256\", \"by\", \"at\", \"body\"}. A\nwrite names the version it read (its base) and creates <base+1>.json\nthrough a hard link from a finished temporary file, which fails when that\nversion already exists: two writers from the same base cannot both land,\nthe loser is refused by name, and a reader never sees a half-written file.\nNo database, no lock, and the same behaviour on a mounted folder.\n\nThe store lives under the clone's git common dir, <common>/attavo/store/,\nso every worktree of a clone reads the same store and nothing in it is\never staged; ATTAVO_STORE overrides the location. It is per clone and per\nmachine: sharing across people is the multi-user step, and a hosted engine\nreplaces this module then without changing a caller of get, put or log.\n\"\"\"\nfrom __future__ import annotations\n\nimport hashlib\nimport json\nimport os\nimport re\nimport subprocess\nimport tempfile\nfrom pathlib import Path\nfrom typing import Any, Callable\n\nfrom attavo.common import now_iso\n\nNAME = re.compile(r\"^[a-z][a-z0-9-]*$\")\nVERSION_FILE = re.compile(r\"^([0-9]+)\\.json$\")\n\n\nclass StoreRefusal(Exception):\n    \"\"\"A write or read the store refuses, with the reason as its message.\"\"\"\n\n\ndef store_root(root: Path) -> Path:\n    \"\"\"<git common dir>/attavo/store for the clone holding root, or\n    ATTAVO_STORE when it is set.\"\"\"\n    env = os.environ.get(\"ATTAVO_STORE\")\n    if env:\n        return Path(env).expanduser().resolve()\n    run = subprocess.run([\"git\", \"-C\", str(root), \"rev-parse\", \"--git-common-dir\"],\n                         capture_output=True, text=True, check=False)\n    common = run.stdout.strip()\n    if run.returncode != 0 or not common:\n        raise StoreRefusal(f\"{root} is not in a git clone and ATTAVO_STORE is not set\")\n    return (root / common).resolve() / \"attavo\" / \"store\"\n\n\ndef _doc_dir(root: Path, name: str) -> Path:\n    if not NAME.match(name):\n        raise StoreRefusal(f\"{name!r} is not a document name\")\n    return store_root(root) / name\n\n\ndef body_sha256(body: Any) -> str:\n    canonical = json.dumps(body, sort_keys=True, separators=(\",\", \":\"), ensure_ascii=False)\n    return hashlib.sha256(canonical.encode()).hexdigest()\n\n\ndef versions(root: Path, name: str) -> list[int]:\n    d = _doc_dir(root, name)\n    if not d.is_dir():\n        return []\n    found = (VERSION_FILE.match(p.name) for p in d.iterdir())\n    return sorted(int(m.group(1)) for m in found if m)\n\n\ndef latest(root: Path, name: str) -> int:\n    \"\"\"The latest version, 0 when the document has none.\"\"\"\n    vs = versions(root, name)\n    return vs[-1] if vs else 0\n\n\ndef get(root: Path, name: str, version: int | None = None) -> dict[str, Any] | None:\n    \"\"\"The envelope of one version (the latest by default), None when absent.\"\"\"\n    v = latest(root, name) if version is None else version\n    if v <= 0:\n        return None\n    path = _doc_dir(root, name) / f\"{v}.json\"\n    if not path.is_file():\n        return None\n    envelope: dict[str, Any] = json.loads(path.read_text())\n    return envelope\n\n\ndef log(root: Path, name: str) -> list[dict[str, Any]]:\n    \"\"\"Every version's envelope without its body, oldest first.\"\"\"\n    out = []\n    for v in versions(root, name):\n        env = get(root, name, v)\n        if env is not None:\n            out.append({k: env[k] for k in (\"version\", \"base\", \"sha256\", \"by\", \"at\")})\n    return out\n\n\ndef put(root: Path, name: str, body: Any, base: int, by: str,\n        check: Callable[[Any], list[str]] | None = None) -> dict[str, Any]:\n    \"\"\"Write version base+1 of name, or refuse: a stale base, an empty\n    author, a body the check refuses, or a writer that landed first.\"\"\"\n    if not by.strip():\n        raise StoreRefusal(\"a write names its author (--by)\")\n    if check is not None:\n        errors = check(body)\n        if errors:\n            raise StoreRefusal(f\"the {name} body is refused: \" + \"; \".join(errors))\n    current = latest(root, name)\n    if base != current:\n        raise StoreRefusal(_moved(root, name, base, current))\n    d = _doc_dir(root, name)\n    d.mkdir(parents=True, exist_ok=True)\n    envelope = {\"name\": name, \"version\": base + 1, \"base\": base, \"sha256\": body_sha256(body),\n                \"by\": by, \"at\": now_iso(), \"body\": body}\n    fd, tmp = tempfile.mkstemp(dir=d, prefix=\".put-\", suffix=\".json\")\n    try:\n        with os.fdopen(fd, \"w\") as f:\n            f.write(json.dumps(envelope, indent=2, ensure_ascii=False) + \"\\n\")\n        try:\n            os.link(tmp, d / f\"{base + 1}.json\")\n        except FileExistsError:\n            raise StoreRefusal(_moved(root, name, base, latest(root, name))) from None\n    finally:\n        os.unlink(tmp)\n    return envelope\n\n\ndef _moved(root: Path, name: str, base: int, current: int) -> str:\n    if current == 0:\n        return f\"the {name} document has no version yet; write it with base 0, not {base}\"\n    env = get(root, name, current) or {}\n    return (f\"the {name} document moved: base {base} is not the latest; the latest is \"\n            f\"version {current}, written by {env.get('by')} at {env.get('at')}\")\n","numLines":140,"startLine":1,"totalLines":140}}}

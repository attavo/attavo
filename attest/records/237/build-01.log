h(__file__).resolve().parent.parent\nATTAVO = ROOT / \"bin\" / \"attavo\"\n\n\ndef run_doctor(root: Path) -> dict[str, Any]:\n    out = subprocess.run([sys.executable, str(ATTAVO), \"doctor\", str(root), \"--json\"],\n                         capture_output=True, text=True, check=False)\n    report = json.loads(out.stdout)\n    assert out.returncode == (0 if report[\"done\"] else 1)","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}

riteria(root, spec_dir, listed)\n                    fail_tree = next((c for c in results if c[\"on_tree\"] == 0), None)\n                    if fail_tree:\n                        refusal = f\"criterion passes against the tree: {fail_tree['name']}\"\n                    else:\n                        fail_stub = next((c for c in results if c[\"on_stub\"] != 0), None)\n                        if fail_stub:\n                            refusal = f\"criterion fails against the tree plus stub: {fail_stub['name']}\"\n\n    status = \"refused\" if refusal else (\"built\" if built else \"pass\")\n    record = {\"sha\": git(root, \"rev-parse\", \"HEAD\").strip(),\n              \"spec_sha\": spec_sha,\n              \"at\": now_iso(), \"status\": status, \"approval_sha\": None,\n              \"criteria\": results, \"refusal\": refusal}\n    write_record(records_dir, \"spec\", record, m, item_id)\n\n    if refusal:\n        print(f\"attavo spec-gate: refused: {refusal}\")\n        return 1\n    print(f\"attavo spec-gate: {status} ({len(results)} criterion/criteria)\")\n    return 0\n\n\nCRITERION_TIMEOUT = 120","is_error":false}]},"parent_tool_use_id":null,"session_id":"5a752ff7-c430-4cfd-9b9a-21883129b5e6","uuid":"d1a1bcc1-7fc2-47c8-a9be-0480250d1f40","timestamp":"2026-09-27T20:32:38.632Z","tool_use_result":{"stdout":"from __future__ import annotations\n\nimport os\nimport re\nimport shutil\nimport subprocess\nimport sys\nimport tempfile\nfrom pathlib import Path\nfrom typing import Any, cast\n\nfrom attavo.approval import approval_status\nfrom attavo.common import (\n    MANIFEST,\n    ShallowCheckoutError,\n    derive_item_id,\n    git,\n    last_commit_touching,\n    now_iso,\n    read_manifest,\n)\nfrom attavo.records import latest_record, write_record\n\n# --- the spec contract ---\n\nBUCKET_LINE = re.compile(r\"^Bucket:\\s*([a-z0-9][a-z0-9-]*)\\s*$\")\nBUCKET_ENTRY = re.compile(r\"^- ([a-z0-9][a-z0-9-]*):\\s+\\S\")\n\n\ndef parse_spec(spec_md: Path) -> tuple[dict[str, Any] | None, str | None]:\n    lines = spec_md.read_text().splitlines()\n    heading_idx = [i for i, l in enumerate(lines) if l.startswith(\"## \")]\n    headings = [lines[i].rstrip() for i in heading_idx]\n    expected = [\"## Problem\", \"## Claims\", \"## Criteria\"]\n    if headings != expected:\n        bad = next((h for h in headings if h not in expected), None)\n        if bad is None:\n            missing = [h for h in expected if h not in headings]\n            bad = missing[0] if missing else \"heading order\"\n        return None, f\"headings: found {headings or ['(none)']}, expected {expected} ({bad})\"\n    idx_problem, idx_claims, idx_criteria = heading_idx\n    claims = [l.strip()[2:].strip() for l in lines[idx_claims + 1:idx_criteria]\n              if l.strip().startswith(\"- \")]\n    # A fix item names the root-cause bucket its change closes, as one\n    # line in the problem: \"Bucket: <slug>\". Optional; when present the\n    # gate checks it against the tenant's closed list (bucket_refusal).\n    bucket = None\n    for l in lines[idx_problem + 1:idx_claims]:\n        m = BUCKET_LINE.match(l)\n        if m:\n            bucket = m.group(1)\n            break\n    criteria = []\n    for l in lines[idx_criteria + 1:]:\n        s = l.strip()\n        if not s.startswith(\"- \") or \":\" not in s:\n            continue\n        name = s[2:].split(\":\", 1)[0].strip()\n        criteria.append(name)\n    return {\"claims\": claims, \"criteria\": criteria, \"bucket\": bucket}, None\n\n\ndef buckets_path(root: Path, m: dict[str, Any]) -> Path:\n    \"\"\"The tenant's closed list of root-cause buckets: buckets.md beside\n    the specs directory (attest/buckets.md when specs live in attest/specs).\n    One bucket per line, \"- <slug>: <one sentence>\".\"\"\"\n    return root / Path(m[\"paths\"][\"specs\"]).parent / \"buckets.md\"\n\n\ndef listed_buckets(path: Path) -> list[str]:\n    if not path.is_file():\n        return []\n    return [mm.group(1) for mm in (BUCKET_ENTRY.match(l) for l in path.read_text().splitlines()) if mm]\n\n\ndef bucket_refusal(root: Path, m: dict[str, Any], bucket: str | None) -> str | None:\n    \"\"\"A spec that names a bucket must name one the tenant lists. Symptom\n    counts do not converge; bucket counts can, and only if every bucket a\n    fix item names is one the list already carries or an item added on\n    purpose. No bucket line, no check: a capability item has no bucket.\"\"\"\n    if bucket is None:\n        return None\n    path = buckets_path(root, m)\n    if not path.is_file():\n        return f\"bucket: {bucket} named but {path.relative_to(root)} does not exist\"\n    if bucket not in listed_buckets(path):\n        return f\"bucket: {bucket} is not listed in {path.relative_to(root)}\"\n    return None\n\n\ndef run_criterion(exe: Path, cwd: Path) -> int:\n    try:\n        run = subprocess.run([str(exe)], cwd=str(cwd), capture_output=True,\n                             timeout=CRITERION_TIMEOUT, check=False)\n        return run.returncode\n    except subprocess.TimeoutExpired:\n        return 124\n    except OSError:\n        return 126\n\n\ndef parse_removed(stub_dir: Path) -> list[str]:\n    \"\"\"The paths listed in stub/.removed, one per line, comments (lines\n    starting with #) and blank lines ignored. [] when the stub carries no\n    .removed at all.\n    \"\"\"\n    removed_file = stub_dir / \".removed\"\n    if not removed_file.is_file():\n        return []\n    paths = []\n    for line in removed_file.read_text().splitlines():\n        s = line.strip()\n        if not s or s.startswith(\"#\"):\n            continue\n        paths.append(s)\n    return paths\n\n\ndef removed_path_refusal(root: Path, stub_dir: Path, rel: str) -> str | None:\n    p = Path(rel)\n    if p.is_absolute() or \"..\" in p.parts:\n        return f\"stub/.removed names a path outside the tree: {rel}\"\n    if not (root / p).exists():\n        return f\"stub/.removed names a path not in the
e's own command needs no argument\n even while the enclosing repository sits on a real item's attavo/N-*\n branch. Every run of spec-gate or approve writes the next numbered attempt\n-file under paths.records/N/ and never overwrites one already written. See\n-the spec contract in the project's Phase 1 issue for the full rules each\n-one enforces.\n+file under paths.records/N/ and never overwrites one already written. A\n+fix item's spec names the root-cause bucket its change closes as one line\n+in the problem, \"Bucket: <slug>\"; spec-gate refuses a bucket the tenant's\n+buckets.md (beside paths.specs) does not list, or any bucket when that\n+file does not exist, before any criterion runs -- a spec with no bucket\n+line is not asked for one. See the spec contract in the project's Phase 1\n+issue for the full rules each one enforces.\n \n build refuses (exit 1, naming the cause, no record) unless the manifest\n declares [executor].build and [tests].select and [tests].run, and unless\n@@ -154,7 +158,11 @@ selected, the exit code, and the seconds spent (or that the answer came\n from the cache). It is the one test command an executor is given (issue\n #212); the product's own transport -- drive, worker, build, verify,\n counsel, file-stops -- refuses to run at all when ATTAVO_STAGE is set,\n-since the transport is the pass's, not the executor's.\n+since the transport is the pass's, not the executor's. The tests that\n+read this repository's own records carry @pytest.mark.own_records, the\n+only vocabulary that tells them apart from the rest of the suite;\n+[tests].run and CI's full-suite step exclude them (-m 'not own_records')\n+and the doctor job and CI's inherit path run only them (-m own_records).\n \n verify refuses (exit 1) unless the item's latest build record has\n status pass, and unless the manifest declares [forge].checks_command --\ndiff --git a/tests/test_ci_inherit.py b/tests/test_ci_inherit.py\nindex a1570ad..37067fa 100644\n--- a/tests/test_ci_inherit.py\n+++ b/tests/test_ci_inherit.py\n@@ -439,7 +439,11 @@ def test_test_runs_only_the_own_records_tests_on_its_inherit_path() -> None:\n     assert \"python3 -m pytest tests -q -m own_records\" in own[0]\n     full = [step for step in steps if \"python3 -m pytest tests -q --durations=5\" in step]\n     assert len(full) == 1 and SKIP_WHEN_INHERITED in full[0]\n-    assert \"-m \" not in full[0].replace(\"-m pytest\", \"\"), \"the full path runs every test\"\n+    # The two paths partition the suite by one marker: the inherit path\n+    # runs the own-records tests and the full path runs everything else.\n+    # Together they are the whole suite; no test is named in either.\n+    assert \"-m 'not own_records'\" in full[0], full[0]\n+    assert \"--deselect\" not in full[0], \"a test named by hand is a list that goes stale (#229 build-04)\"\n \n \n def test_the_queue_has_no_path_to_the_script() -> None:\ndiff --git a/tests/test_cli_help.py b/tests/test_cli_help.py\nindex 6994db3..7c191b8 100644\n--- a/tests/test_cli_help.py\n+++ b/tests/test_cli_help.py\n@@ -94,3 +94,14 @@ def test_help_names_the_seventh_proof_and_the_empty_stop() -> None:\n     assert run.returncode == 0\n     for phrase in (\"no attested item is empty\", \"built_since\", \"committed nothing\", \"reads the commit\"):\n         assert phrase in run.stdout, phrase\n+\n+\n+def test_help_names_the_bucket_line_and_the_marker() -> None:\n+    \"\"\"Item 229's fix: the spec gate's bucket refusal and the own_records\n+    marker as the only way a tenant's dogfood tests are told apart. Red on\n+    the tree and on the stub: the words are the build's.\"\"\"\n+    run = subprocess.run([sys.executable, str(ATTAVO), \"--help\"],\n+                         capture_output=True, text=True, check=False)\n+    assert run.returncode == 0\n+    for phrase in (\"Bucket:\", \"buckets.md\", \"own_records\"):\n+        assert phrase in run.stdout, phrase\ndiff --git a/tests/test_spec_gate.py b/tests/test_spec_gate.py\nindex 0dfc44e..63af307 100644\n--- a/tests/test_spec_gate.py\n+++ b/tests/test_spec_gate.py\n@@ -426,3 +426,51 @@ def test_spec_gate_stub_verdict_after_halted_build_that_committed_nothing(tmp_pa\n     assert rec[\"status\"] == \"pass\"\n     assert rec[\"criteria\"] == [{\"name\": \"checks_marker.sh\", \"on_tree\": 1, \"on_stub\": 0}]\n     assert rec[\"refusal\"] is None\n+\n+\n+def add_bucket_line(root: Path, bucket: str) -> None:\n+    spec_md = root / \"specs\" / \"1\" / \"spec.md\"\n+    text = spec_md.read_text().replace(\"## Problem\\n\", f\"## Problem\\n\\nBucket: {bucket}\\n\", 1)\n+    spec_md.write_text(text)\n+    commit_all(root, f\"name bucket {bucket}\")\n+\n+\n+def test_spec_gate_refuses_a_bucket_the_tenant_does_not_list_and_passes_a_listed_one(tmp_path: Path) -> None:\n+    \"\"\"Root-cause buckets (#229 build-04 and the convergence ruling of\n+    2026-09-27): a fix item names the bucket its change closes as one\n+    'Bucket: <slug>' line in its problem, and the gate refuses a slug the\n+    tenant's buckets.md (beside the specs directory) does not list, or a\n+    line with no such file. Written red first: on v0.30.0 the line is\n+    prose and the gate passes it.\"\"\"\n+    root = make_tenant(tmp_path, \"valid\")\n+    add_bucket_line(root, \"shared-working-copy\")\n+    run = run_attavo(root, \"spec-gate\", \"1\")\n+    assert run.returncode == 1, run.stdout + run.stderr\n+    rec = latest_record(root, \"1\", \"spec\")\n+    assert rec[\"status\"] == \"refused\"\n+    assert rec[\"refusal\"] == \"bucket: shared-working-copy named but buckets.md does not exist\", rec[\"refusal\"]\n+    assert rec[\"criteria\"] == [], \"refused before any criterion ran\"\n+\n+    (root / \"buckets.md\").write_text(\n+        \"# buckets\\n\\n- liveness-by-proxy: a pid stood in for the holder\\n\")\n+    commit_all(root, \"list one bucket\")\n+    run = run_attavo(root, \"spec-gate\", \"1\")\n+    assert run.returncode == 1\n+    assert latest_record(root, \"1\", \"spec\")[\"refusal\"] == \"bucket: shared-working-copy is not listed in buckets.md\"\n+\n+    (root / \"buckets.md\").write_text(\n+        \"# buckets\\n\\n- liveness-by-proxy: a pid stood in for the holder\\n\"\n+        \"- shared-working-copy: one checkout, many writers\\n\")\n+    commit_all(root, \"list the bucket\")\n+    run = run_attavo(root, \"spec-gate\", \"1\")\n+    assert run.returncode == 0, run.stdout + run.stderr\n+    rec = latest_record(root, \"1\", \"spec\")\n+    assert rec[\"status\"] == \"pass\" and rec[\"refusal\"] is None\n+\n+\n+def test_spec_gate_leaves_a_spec_with_no_bucket_line_alone(tmp_path: Path) -> None:\n+    \"\"\"A capability item has no bucket; the check is on the line, not on\n+    every spec, and a tenant with no buckets.md is not asked for one.\"\"\"\n+    root = make_tenant(tmp_path, \"valid\")\n+    assert not (root / \"buckets.md\").exists()\n+    assert run_attavo(root, \"spec-gate\", \"1\").returncode == 0","is_error":false}]},"parent_tool_use_id":null,"session_id":"7ff7b485-8759-4f05-8eef-e2bfffd293b8","uuid":"a8bfa446-621a-4135-84a3-4213bfa48608","timestamp":"2026-09-27T20:56:24.829Z","tool_use_result":{"stdout":"commit 3418772d643654b00471e767969242c88a42c314\nAuthor: attavo executor (claude-code) <executor+claude-code@attavo.invalid>\nDate:   Sun Sep 27 14:42:36 2026 -0600\n\n    own_records marker replaces the three hand-copied deselect lists (#237)\n    \n    Item #229 build-04's fourth attempt failed because select-tests mapped a\n    common.py/build.py change to the whole suite and the gate ran\n    test_no_invocation_lacks_record, which read build-04's own .started\n    marker as a dead invocation. That test was one of the seven doctor tests\n    that read this repository's own records, told apart from the rest of the\n    suite by three hand-copied --deselect lists that stayed in sync only by\n    convention -- and the list was missing it.\n    \n    @pytest.mark.own_records already existed and already had a guard\n 
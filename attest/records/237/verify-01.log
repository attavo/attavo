own_records_guard.py) enforcing that every test reading this\n    repository's own records carries it. This closes the gap: the six\n    doctor tests gain the marker, [tests].run and ci.yml's full-suite step\n    become `-m 'not own_records'`, the doctor job and the inherit path run\n    `-m own_records`, every --deselect and DESELECT_FLAGS list is gone, and\n    the guard's exemption for the doctor tests goes with it.\n    \n    Also lands the bucket line: a fix item's spec names the root-cause\n    bucket it closes with `Bucket: <slug>`, and spec-gate refuses a slug\n    attest/buckets.md does not list before any criterion runs. buckets.md\n    lists the five buckets from the 2026-09-27 convergence ruling.\n    \n    Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>\n\ndiff --git a/attavo/spec.py b/attavo/spec.py\nindex 8cf623c..e263ca5 100644\n--- a/attavo/spec.py\n+++ b/attavo/spec.py\n@@ -1,6 +1,7 @@\n from __future__ import annotations\n \n import os\n+import re\n import shutil\n import subprocess\n import sys\n@@ -22,6 +23,10 @@ from attavo.records import latest_record, write_record\n \n # --- the spec contract ---\n \n+BUCKET_LINE = re.compile(r\"^Bucket:\\s*([a-z0-9][a-z0-9-]*)\\s*$\")\n+BUCKET_ENTRY = re.compile(r\"^- ([a-z0-9][a-z0-9-]*):\\s+\\S\")\n+\n+\n def parse_spec(spec_md: Path) -> tuple[dict[str, Any] | None, str | None]:\n     lines = spec_md.read_text().splitlines()\n     heading_idx = [i for i, l in enumerate(lines) if l.startswith(\"## \")]\n@@ -36,6 +41,15 @@ def parse_spec(spec_md: Path) -> tuple[dict[str, Any] | None, str | None]:\n     idx_problem, idx_claims, idx_criteria = heading_idx\n     claims = [l.strip()[2:].strip() for l in lines[idx_claims + 1:idx_criteria]\n               if l.strip().startswith(\"- \")]\n+    # A fix item names the root-cause bucket its change closes, as one\n+    # line in the problem: \"Bucket: <slug>\". Optional; when present the\n+    # gate checks it against the tenant's closed list (bucket_refusal).\n+    bucket = None\n+    for l in lines[idx_problem + 1:idx_claims]:\n+        m = BUCKET_LINE.match(l)\n+        if m:\n+            bucket = m.group(1)\n+            break\n     criteria = []\n     for l in lines[idx_criteria + 1:]:\n         s = l.strip()\n@@ -43,7 +57,35 @@ def parse_spec(spec_md: Path) -> tuple[dict[str, Any] | None, str | None]:\n             continue\n         name = s[2:].split(\":\", 1)[0].strip()\n         criteria.append(name)\n-    return {\"claims\": claims, \"criteria\": criteria}, None\n+    return {\"claims\": claims, \"criteria\": criteria, \"bucket\": bucket}, None\n+\n+\n+def buckets_path(root: Path, m: dict[str, Any]) -> Path:\n+    \"\"\"The tenant's closed list of root-cause buckets: buckets.md beside\n+    the specs directory (attest/buckets.md when specs live in attest/specs).\n+    One bucket per line, \"- <slug>: <one sentence>\".\"\"\"\n+    return root / Path(m[\"paths\"][\"specs\"]).parent / \"buckets.md\"\n+\n+\n+def listed_buckets(path: Path) -> list[str]:\n+    if not path.is_file():\n+        return []\n+    return [mm.group(1) for mm in (BUCKET_ENTRY.match(l) for l in path.read_text().splitlines()) if mm]\n+\n+\n+def bucket_refusal(root: Path, m: dict[str, Any], bucket: str | None) -> str | None:\n+    \"\"\"A spec that names a bucket must name one the tenant lists. Symptom\n+    counts do not converge; bucket counts can, and only if every bucket a\n+    fix item names is one the list already carries or an item added on\n+    purpose. No bucket line, no check: a capability item has no bucket.\"\"\"\n+    if bucket is None:\n+        return None\n+    path = buckets_path(root, m)\n+    if not path.is_file():\n+        return f\"bucket: {bucket} named but {path.relative_to(root)} does not exist\"\n+    if bucket not in listed_buckets(path):\n+        return f\"bucket: {bucket} is not listed in {path.relative_to(root)}\"\n+    return None\n \n \n def run_criterion(exe: Path, cwd: Path) -> int:\n@@ -194,6 +236,9 @@ def cmd_spec_gate(argv: list[str]) -> int:\n     results: list[dict[str, Any]] = []\n     if refusal is None:\n         # parse_spec returns a refusal exactly when it returns no spec.\n+        parsed = cast(dict[str, Any], parsed)\n+        refusal = bucket_refusal(root, m, parsed.get(\"bucket\"))\n+    if refusal is None:\n         parsed = cast(dict[str, Any], parsed)\n         if built:\n             refusal = stub_removed_refusal(root, spec_dir)\ndiff --git a/tests/test_spec_gate.py b/tests/test_spec_gate.py\nindex 0dfc44e..63af307 100644\n--- a/tests/test_spec_gate.py\n+++ b/tests/test_spec_gate.py\n@@ -426,3 +426,51 @@ def test_spec_gate_stub_verdict_after_halted_build_that_committed_nothing(tmp_pa\n     assert rec[\"status\"] == \"pass\"\n     assert rec[\"criteria\"] == [{\"name\": \"checks_marker.sh\", \"on_tree\": 1, \"on_stub\": 0}]\n     assert rec[\"refusal\"] is None\n+\n+\n+def add_bucket_line(root: Path, bucket: str) -> None:\n+    spec_md = root / \"specs\" / \"1\" / \"spec.md\"\n+    text = spec_md.read_text().replace(\"## Problem\\n\", f\"## Problem\\n\\nBucket: {bucket}\\n\", 1)\n+    spec_md.write_text(text)\n+    commit_all(root, f\"name bucket {bucket}\")\n+\n+\n+def test_spec_gate_refuses_a_bucket_the_tenant_does_not_list_and_passes_a_listed_one(tmp_path: Path) -> None:\n+    \"\"\"Root-cause buckets (#229 build-04 and the convergence ruling of\n+    2026-09-27): a fix item names the bucket its change closes as one\n+    'Bucket: <slug>' line in its problem, and the gate refuses a slug the\n+    tenant's buckets.md (beside the specs directory) does not list, or a\n+    line with no such file. Written red first: on v0.30.0 the line is\n+    prose and the gate passes it.\"\"\"\n+    root = make_tenant(tmp_path, \"valid\")\n+    add_bucket_line(root, \"shared-working-copy\")\n+    run = run_attavo(root, \"spec-gate\", \"1\")\n+    assert run.returncode == 1, run.stdout + run.stderr\n+    rec = latest_record(root, \"1\", \"spec\")\n+    assert rec[\"status\"] == \"refused\"\n+    assert rec[\"refusal\"] == \"bucket: shared-working-copy named but buckets.md does not exist\", rec[\"refusal\"]\n+    assert rec[\"criteria\"] == [], \"refused before any criterion ran\"\n+\n+    (root / \"buckets.md\").write_text(\n+        \"# buckets\\n\\n- liveness-by-proxy: a pid stood in for the holder\\n\")\n+    commit_all(root, \"list one bucket\")\n+    run = run_attavo(root, \"spec-gate\", \"1\")\n+    assert run.returncode == 1\n+    assert latest_record(root, \"1\", \"spec\")[\"refusal\"] == \"bucket: shared-working-copy is not listed in buckets.md\"\n+\n+    (root / \"buckets.md\").write_text(\n+        \"# buckets\\n\\n- liveness-by-proxy: a pid stood in for the holder\\n\"\n+        \"- shared-working-copy: one checkout, many writers\\n\")\n+    commit_all(root, \"list the bucket\")\n+    run = run_attavo(root, \"spec-gate\", \"1\")\n+    assert run.returncode == 0, run.stdout + run.stderr\n+    rec = latest_record(root, \"1\", \"spec\")\n+    assert rec[\"status\"] == \"pass\" and rec[\"refusal\"] is None\n+\n+\n+def test_spec_gate_leaves_a_spec_with_no_bucket_line_alone(tmp_path: Path) -> None:\n+    \"\"\"A capability item has no bucket; the check is on the line, not on\n+    every spec, and a tenant with no buckets.md is not asked for one.\"\"\"\n+    root = make_tenant(tmp_path, \"valid\")\n+    assert not (root / \"buckets.md\").exists()\n+    assert run_attavo(root, \"spec-gate\", \"1\").returncode == 0\n","exit_code":0,"status":"completed"}}

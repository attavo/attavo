s.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n+    run = subprocess.run([sys.executable, str(ATTAVO), \\\\\\\"--help\\\\\\\"],\\\\n+                         capture_output=True, text=True, check=False)\\\\n+    assert run.returncode == 0\\\\n+    for phrase in (\\\\\\\"Bucket:\\\\\\\", \\\\\\\"buckets.md\\\\\\\", \\\\\\\"own_records\\\\\\\"):\\\\n+        assert phrase in run.stdout, phrase\\\\ndiff --git a/tests/test_spec_gate.py b/tests/test_spec_gate.py\\\\nindex 0dfc44e..63af307 100644\\\\n--- a/tests/test_spec_gate.py\\\\n+++ b/tests/test_spec_gate.py\\\\n@@ -426,3 +426,51 @@ def test_spec_gate_stub_verdict_after_halted_build_that_committed_nothing(tmp_pa\\\\n     assert rec[\\\\\\\"status\\\\\\\"] == \\\\\\\"pass\\\\\\\"\\\\n     assert rec[\\\\\\\"criteria\\\\\\\"] == [{\\\\\\\"name\\\\\\\": \\\\\\\"checks_marker.sh\\\\\\\", \\\\\\\"on_tree\\\\\\\": 1, \\\\\\\"on_stub\\\\\\\": 0}]\\\\n     assert rec[\\\\\\\"refusal\\\\\\\"] is None\\\\n+\\\\n+\\\\n+def add_bucket_line(root: Path, bucket: str) -> None:\\\\n+    spec_md = root / \\\\\\\"specs\\\\\\\" / \\\\\\\"1\\\\\\\" / \\\\\\\"spec.md\\\\\\\"\\\\n+    text = spec_md.read_text().replace(\\\\\\\"## Problem\\\\\\\\n\\\\\\\", f\\\\\\\"## Problem\\\\\\\\n\\\\\\\\nBucket: {bucket}\\\\\\\\n\\\\\\\", 1)\\\\n+    spec_md.write_text(text)\\\\n+    commit_all(root, f\\\\\\\"name bucket {bucket}\\\\\\\")\\\\n+\\\\n+\\\\n+def test_spec_gate_refuses_a_bucket_the_tenant_does_not_list_and_passes_a_listed_one(tmp_path: Path) -> None:\\\\n+    \\\\\\\"\\\\\\\"\\\\\\\"Root-cause buckets (#229 build-04 and the convergence ruling of\\\\n+    2026-09-27): a fix item names the bucket its change closes as one\\\\n+    'Bucket: <slug>' line in its problem, and the gate refuses a slug the\\\\n+    tenant's buckets.md (beside the specs directory) does not list, or a\\\\n+    line with no such file. Written red first: on v0.30.0 the line is\\\\n+    prose and the gate passes it.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n+    root = make_tenant(tmp_path, \\\\\\\"valid\\\\\\\")\\\\n+    add_bucket_line(root, \\\\\\\"shared-working-copy\\\\\\\")\\\\n+    run = run_attavo(root, \\\\\\\"spec-gate\\\\\\\", \\\\\\\"1\\\\\\\")\\\\n+    assert run.returncode == 1, run.stdout + run.stderr\\\\n+    rec = latest_record(root, \\\\\\\"1\\\\\\\", \\\\\\\"spec\\\\\\\")\\\\n+    assert rec[\\\\\\\"status\\\\\\\"] == \\\\\\\"refused\\\\\\\"\\\\n+    assert rec[\\\\\\\"refusal\\\\\\\"] == \\\\\\\"bucket: shared-working-copy named but buckets.md does not exist\\\\\\\", rec[\\\\\\\"refusal\\\\\\\"]\\\\n+    assert rec[\\\\\\\"criteria\\\\\\\"] == [], \\\\\\\"refused before any criterion ran\\\\\\\"\\\\n+\\\\n+    (root / \\\\\\\"buckets.md\\\\\\\").write_text(\\\\n+        \\\\\\\"# buckets\\\\\\\\n\\\\\\\\n- liveness-by-proxy: a pid stood in for the holder\\\\\\\\n\\\\\\\")\\\\n+    commit_all(root, \\\\\\\"list one bucket\\\\\\\")\\\\n+    run = run_attavo(root, \\\\\\\"spec-gate\\\\\\\", \\\\\\\"1\\\\\\\")\\\\n+    assert run.returncode == 1\\\\n+    assert latest_record(root, \\\\\\\"1\\\\\\\", \\\\\\\"spec\\\\\\\")[\\\\\\\"refusal\\\\\\\"] == \\\\\\\"bucket: shared-working-copy is not listed in buckets.md\\\\\\\"\\\\n+\\\\n+    (root / \\\\\\\"buckets.md\\\\\\\").write_text(\\\\n+        \\\\\\\"# buckets\\\\\\\\n\\\\\\\\n- liveness-by-proxy: a pid stood in for the holder\\\\\\\\n\\\\\\\"\\\\n+        \\\\\\\"- shared-working-copy: one checkout, many writers\\\\\\\\n\\\\\\\")\\\\n+    commit_all(root, \\\\\\\"list the bucket\\\\\\\")\\\\n+    run = run_attavo(root, \\\\\\\"spec-gate\\\\\\\", \\\\\\\"1\\\\\\\")\\\\n+    assert run.returncode == 0, run.stdout + run.stderr\\\\n+    rec = latest_record(root, \\\\\\\"1\\\\\\\", \\\\\\\"spec\\\\\\\")\\\\n+    assert rec[\\\\\\\"status\\\\\\\"] == \\\\\\\"pass\\\\\\\" and rec[\\\\\\\"refusal\\\\\\\"] is None\\\\n+\\\\n+\\\\n+def test_spec_gate_leaves_a_spec_with_no_bucket_line_alone(tmp_path: Path) -> None:\\\\n+    \\\\\\\"\\\\\\\"\\\\\\\"A capability item has no bucket; the check is on the line, not on\\\\n+    every spec, and a tenant with no buckets.md is not asked for one.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n+    root = make_tenant(tmp_path, \\\\\\\"valid\\\\\\\")\\\\n+    assert not (root / \\\\\\\"buckets.md\\\\\\\").exists()\\\\n+    assert run_attavo(root, \\\\\\\"spec-gate\\\\\\\", \\\\\\\"1\\\\\\\").returncode == 0\\\",\\\"stderr\\\":\\\"\\\",\\\"interrupted\\\":false,\\\"isImage\\\":false,\\\"noOutputExpected\\\":false}}\\n563:{\\\"type\\\":\\\"user\\\",\\\"message\\\":{\\\"role\\\":\\\"user\\\",\\\"content\\\":[{\\\"tool_use_id\\\":\\\"toolu_0172DEuc2sjpMLGjCTBLXSkk\\\",\\\"type\\\":\\\"tool_result\\\",\\\"content\\\":\\\"#!/usr/bin/env python3\\\\n\\\\\\\"\\\\\\\"\\\\\\\"select-tests: [tests].select for attavo build/verify/test (issue #103,\\\\nmade fail-safe by issue #212).\\\\n\\\\nReads changed paths on stdin, one per line, and prints test identifiers\\\\non stdout, one per line, for this repository's own test suite:\\\\n\\\\n  - prose (*.md, LICENSE) and this repository's own specs and records\\\\n    (attest/specs/**, attest/records/**) select nothing;\\\\n  - a test file (tests/test_*.py) selects itself, and the whole suite\\\\n    when it no longer exists -- a deletion cannot select itself, and the\\\\n    fail-safe rule below applies to it rather than exempting it (issue\\\\n    #212's review);\\\\n  - a path in MODULE_TESTS (a module of attavo/, and the few files that\\\\n    are one thing's own) selects the tests written for it, and a prefix in\\\\n    PREFIX_TESTS (adapters/, schema/, templates/) the tests written for\\\\n    that directory;\\\\n  - a path this selector does not know -- a module nobody mapped,\\\\n    bin/attavo, scripts/, tests/helpers.py and the fixtures every test\\\\n    stands on, the fixture adapter every build test invokes -- selects the\\\\n    whole suite (\\\\\\\"tests\\\\\\\", the one path pytest needs to run everything),\\\\n    and one such path is enough to make that the whole answer.\\\\n\\\\nA module that most of the others import (common, records, spec, ...) is\\\\nleft out of MODULE_TESTS on purpose: no table of tests-per-module can know\\\\nwhat it breaks, so it is the whole suite. The forge runs the whole suite\\\\nonce, as the required `test` check, in any case.\\\\n\\\\nUsage: <changed paths> | select-tests\\\\n\\\\\\\"\\\\\\\"\\\\\\\"\\\\nfrom __future__ import annotations\\\\n\\\\nimport sys\\\\nfrom pathlib import Path\\\\n\\\\nWHOLE_SUITE = \\\\\\\"tests\\\\\\\"\\\\n\\\\nSILENT_PREFIXES = (\\\\\\\"attest/specs/\\\\\\\", \\\\\\\"attest/records/\\\\\\\")\\\\n\\\\nWHOLE_SUITE_PREFIXES = (\\\\\\\"adapters/fixture/\\\\\\\",)\\\\n\\\\nMODULE_TESTS: dict[str, tuple[str, ...]] = {\\\\n    \\\\\\\"attavo/attest.py\\\\\\\": (\\\\\\\"tests/test_attest.py\\\\\\\", \\\\\\\"tests/test_attest_time.py\\\\\\\"),\\\\n    \\\\\\\"attavo/build.py\\\\\\\": (\\\\\\\"tests/test_build.py\\\\\\\", \\\\\\\"tests/test_testtool.py\\\\\\\"),\\\\n    \\\\\\\"attavo/cli.py\\\\\\\": (\\\\\\\"tests/test_cli_help.py\\\\\\\", \\\\\\\"tests/test_testtool.py\\\\\\\"),\\\\n    \\\\\\\"attavo/counsel.py\\\\\\\": (\\\\\\\"tests/test_counsel.py\\\\\\\",),\\\\n    \\\\\\\"attavo/doctor.py\\\\\\\": (\\\\\\\"tests/test_doctor.py\\\\\\\", \\\\\\\"tests/test_doctor_sealed.py\\\\\\\",\\\\n                         \\\\\\\"tests/test_proof_five_elsewhere.py\\\\\\\",\\\\n                         \\\\\\\"tests/test_sealed_since_default.py\\\\\\\"),\\\\n    \\\\\\\"attavo/drive.py\\\\\\\": (\\\\\\\"tests/test_drive.py\\\\\\\",),\\\\n    \\\\\\\"attavo/filing.py\\\\\\\": (\\\\\\\"tests/test_file_findings.py\\\\\\\", \\\\\\\"tests/test_file_stops.py\\\\\\\"),\\\\n    \\\\\\\"attavo/ledger.py\\\\\\\": (\\\\\\\"tests/test_ledger.py\\\\\\\",),\\\\n    \\\\\\\"attavo/record_only.py\\\\\\\": (\\\\\\\"tests/test_record_only.py\\\\\\\",),\\\\n    \\\\\\\"attavo/report.py\\\\\\\": (\\\\\\\"tests/test_report.py\\\\\\\",),\\\\n    \\\\\\\"attavo/testtool.py\\\\\\\": (\\\\\\\"tests/test_testtool.py\\\\\\\",),\\\\n    \\\\\
:diff --git a/attest/records/237/spec-01.json b/attest/records/237/spec-01.json\\n220:@@ -0,0 +1,19 @@\\n240:diff --git a/attest/specs/237/criteria/the-own-records-tests-are-told-apart-by-the-marker-and-the-gate-refuses-an-unlisted-bucket.sh b/attest/specs/237/criteria/the-own-records-tests-are-told-apart-by-the-marker-and-the-gate-refuses-an-unlisted-bucket.sh\\n245:@@ -0,0 +1,65 @@\\n256:+assert \\\"-m 'not own_records'\\\" in run and \\\"--deselect\\\" not in run, run\\n257:+assert \\\"--deselect\\\" not in m[\\\"checks\\\"][\\\"command\\\"], m[\\\"checks\\\"][\\\"command\\\"]\\n259:+assert \\\"--deselect\\\" not in ci, \\\"ci.yml still names a test by hand\\\"\\n260:+assert \\\"python3 -m pytest tests -q --durations=5 -m 'not own_records'\\\" in ci\\n261:+assert ci.count(\\\"python3 -m pytest tests -q -m own_records\\\") == 2, \\\"the inherit path and the doctor job\\\"\\n266:+        assert any(ast.unparse(d) == \\\"pytest.mark.own_records\\\" for d in n.decorator_list), n.name\\n267:+guard = (root / \\\"tests/test_own_records_guard.py\\\").read_text()\\n268:+assert \\\"deselected_by_the_test_job\\\" not in guard, \\\"the guard still reads a deselect list\\\"\\n270:+assert \\\"def test_tests_run_and_the_test_job_exclude_the_own_records_tests_by_marker\\\" in (root / \\\"tests/test_self_tenancy.py\\\").read_text()\\n272:+buckets = (root / \\\"attest/buckets.md\\\").read_text()\\n283:+s = open(p).read().replace(\\\"## Problem\\\\n\\\", \\\"## Problem\\\\n\\\\nBucket: liveness-by-proxy\\\\n\\\", 1)\\n290:+grep -q \\\"bucket: liveness-by-proxy named but buckets.md does not exist\\\" \\\"$tmp/gate1.out\\\"\\n291:+printf '# buckets\\\\n\\\\n- shared-working-copy: one checkout, many writers\\\\n' > buckets.md\\n292:+git add buckets.md\\n295:+grep -q \\\"bucket: liveness-by-proxy is not listed in buckets.md\\\" \\\"$tmp/gate2.out\\\"\\n296:+printf -- '- liveness-by-proxy: a pid stood in for the holder\\\\n' >> buckets.md\\n297:+git add buckets.md\\n311:diff --git a/attest/specs/237/spec.md b/attest/specs/237/spec.md\\n316:@@ -0,0 +1,35 @@\\n319:+Bucket: dogfood-tests-told-apart-by-a-list\\n321:+Item #229's fourth attempt ran 3,375 s and cost $2.62 to fail on one test. The executor's change touched `attavo/common.py` and `attavo/build.py`, `select-tests` mapped that to the whole suite, and the gate ran `tests/test_doctor.py::test_no_invocation_lacks_record` in its worktree, where that test read build-04's own `.started` marker as a dead invocation. The test is one of the seven that read this repository's own records and belong to the doctor job alone. It was the one the deselect lists did not name.\\n323:+There were three of those lists: `[tests].run` in the manifest, the `test` job in `ci.yml`, and `DESELECT_FLAGS` in `tests/test_self_tenancy.py`, each naming six tests by hand, kept equal by a test that counted them, and a fourth in the doctor job's `-k` expression naming five. Meanwhile the marker that says what these tests are, `@pytest.mark.own_records`, already existed: the inherit path runs `-m own_records` alone, and `tests/test_own_records_guard.py` fails any unmarked test that reads the repository's own records, with the six listed tests exempted precisely because the list stood in for the marker. Two mechanisms, disjoint sets, and the list was the one that went stale. A list a person copies is prose; a marker on the test is the fact.\\n327:+One marker, no list. The six doctor tests gain `@pytest.mark.own_records` beside the one that had it. `[tests].run` becomes `xargs -r python3 -m pytest -q -m 'not own_records'`, `ci.yml`'s full-suite step carries the same expression, and the doctor job's step becomes `python3 -m pytest tests -q -m own_records`, the same step the inherit path already runs. Every `--deselect` in the manifest and the workflow goes, `DESELECT_FLAGS` and its test go, the guard's exemption and the test that counted the list go. What remains is the guard, which now exempts nothing, and one new test naming the set: every test in `test_doctor.py` that calls `run_doctor(ROOT)` carries the marker. `attavo test` uses `[tests].run` and so inherits the expression; an executor that names a marked test by hand gets nothing run, which is right.\\n329:+The bucket line. A fix item's spec names its bucket as one line in the problem, `Bucket: <slug>`. The tenant's closed list is `buckets.md` beside its specs directory (`attest/buckets.md` here), one bucket per line, `- <slug>: <one sentence>`. `attavo spec-gate` refuses a spec whose bucket line names a slug the file does not list, or names any slug when the file does not exist, before any criterion runs; a spec with no bucket line is not asked for one, since a capability item has no bucket. Adding a bucket is an item's own act in the same change as its fix. The count is read with `grep -h '^Bucket:' attest/specs/*/spec.md | sort | uniq -c`; it becomes a subcommand when it moves a decision and not before. This repository's `attest/buckets.md` lists the five buckets the ruling named, with their specimens.\\n333:+Retires: three hand-copied deselect lists and the test that counted them; the doctor job's `-k` list; the guard's exemption; symptom-grain fix items without a named bucket.\\n341:+- attest/buckets.md\\n343:+- tests/test_own_records_guard.py\\n351:+- the-own-records-tests-are-told-apart-by-the-marker-and-the-gate-refuses-an-unlisted-bucket.sh: `[tests].run` and `ci.yml`'s full-suite step carry `-m 'not own_records'` and no `--deselect`; the doctor job and the inherit path run `-m own_records`; every `run_doctor(ROOT)` test in `test_doctor.py` carries the marker; the guard reads no deselect list; `attest/buckets.md` lists the five buckets; on a fixture tenant a spec with `Bucket: liveness-by-proxy` is refused naming the missing `buckets.md`, refused again naming the unlisted slug once the file lists another bucket, and passes once the slug is listed, with the refusals written before any criterion ran\\n352:diff --git a/attest/specs/237/stub/.github/workflows/ci.yml b/attest/specs/237/stub/.github/workflows/ci.yml\\n357:@@ -0,0 +1,180 @@\\n373:+  # records (@pytest.mark.own_records) still run. scripts/ci_inherit.py\\n400:+        run: python3 -m pytest tests -q -m own_records\\n411:+          python3 -m pytest tests -q --durations=5 -m 'not own_records'\\n494:+        run: python3 -m pytest tests -q -m own_records\\n538:diff --git a/attest/specs/237/stub/attavo.toml b/attest/specs/237/stub/attavo.toml\\n543:@@ -0,0 +1,68 @@\\n583:+run = \\\"xargs -r python3 -m pytest -q -m 'not own_records'\\\"\\n612:diff --git a/attest/specs/237/stub/attavo/spec.py b/attest/specs/237/stub/attavo/spec.py\\n617:@@ -0,0 +1,304 @@\\n643:+BUCKET_LINE = re.compile(r\\\"^Bucket:\\\\s*([a-z0-9][a-z0-9-]*)\\\\s*$\\\")\\n662:+    # line in the problem: \\\"Bucket: <slug>\\\". Optional; when present the\\n681:+    \\\"\\\"\\\"The tenant's closed list of root-cause buckets: buckets.md beside\\n682:+    the specs directory (attest/buckets.md when specs live in attest/specs).\\n684:+    return root / Path(m[\\\"paths\\\"][\\\"specs\\\"]).parent / \\\"buckets.md\\\"\\n922:diff --git a/attest/specs/237/stub/attest/buckets.md b/attest/specs/237/stub/attest/buckets.md\\n926:+++ b/attest/specs/237/stub/attest/buckets.md\\n927:@@ -0,0 +1,16 @@\\n930:+The closed list a fix item names with a `Bucket:` line in its spec's\\n937:+Read it with: grep -h '^Bucket:' attest/specs/*/spec.md | sort | uniq -c\\n944:diff --git a/attest/specs/237/stub/tests/test_ci_inherit.py b/attest/specs/237/stub/tests/test_ci_inherit.py\\n949:@@ -0,0 +1,476 @@\\n1374:+        \\\"test\\\": (\\\"pip install pytest jsonschema\\\", \\\"-m own_records\\\"),\\n1383:+def test_test_runs_only_the_own_records_tests_on_its_inherit_path() -> None:\\n1385:+    own = [step for step in steps if \\\"-m own_records\\\" in step]\\n1388:+    assert \\\"python3 -m pytest tests -q -m own_records\\\" in own[0]\\n1394:+    assert \\\"-m 'not own_records'\\\" in full[0], full
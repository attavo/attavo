in m[\\\"checks\\\"][\\\"command\\\"], m[\\\"checks\\\"][\\\"command\\\"]\\n+        assert \\\"-m 'not own_records'\\\" in m[\\\"checks\\\"][\\\"command\\\"], m[\\\"checks\\\"][\\\"command\\\"]\\n+    ci = (ROOT / \\\".github\\\" / \\\"workflows\\\" / \\\"ci.yml\\\").read_text()\\n+    assert \\\"--deselect\\\" not in ci\\n+    assert \\\"python3 -m pytest tests -q --durations=5 -m 'not own_records'\\\" in ci\\n+    assert ci.count(\\\"python3 -m pytest tests -q -m own_records\\\") == 2, \\\"the inherit path and the doctor job\\\"\\n \\n \\n def run_select_tests(stdin_text: str) -> list[str]:\",\"stderr\":\"\",\"interrupted\":false,\"isImage\":false,\"returnCodeInterpretation\":\"Files differ\",\"noOutputExpected\":false}}\n+{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01BSUUx8n4aiH87tGKAGbBso\",\"type\":\"tool_result\",\"content\":\"--- tests/test_ci_inherit.py\\t2026-09-27 14:31:51\\n+++ attest/specs/237/stub/tests/test_ci_inherit.py\\t2026-09-27 14:31:51\\n@@ -439,7 +439,11 @@\\n     assert \\\"python3 -m pytest tests -q -m own_records\\\" in own[0]\\n     full = [step for step in steps if \\\"python3 -m pytest tests -q --durations=5\\\" in step]\\n     assert len(full) == 1 and SKIP_WHEN_INHERITED in full[0]\\n-    assert \\\"-m \\\" not in full[0].replace(\\\"-m pytest\\\", \\\"\\\"), \\\"the full path runs every test\\\"\\n+    # The two paths partition the suite by one marker: the inherit path\\n+    # runs the own-records tests and the full path runs everything else.\\n+    # Together they are the whole suite; no test is named in either.\\n+    assert \\\"-m 'not own_records'\\\" in full[0], full[0]\\n+    assert \\\"--deselect\\\" not in full[0], \\\"a test named by hand is a list that goes stale (#229 build-04)\\\"\\n \\n \\n def test_the_queue_has_no_path_to_the_script() -> None:\",\"is_error\":false}]},\"parent_tool_use_id\":null,\"session_id\":\"5a752ff7-c430-4cfd-9b9a-21883129b5e6\",\"uuid\":\"35335fdc-9319-4
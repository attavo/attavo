default branch after the manifest was\\n    introduced is named by a record's sha or commits list.\\\"\\\"\\\"\\n    p = run_doctor(ROOT)[\\\"no-commit-lacks-record\\\"]\\n    assert p[\\\"holds\\\"], p[\\\"reason\\\"]\\n\\n\\ndef test_no_stop_lacks_cause() -> None:\\n    \\\"\\\"\\\"Proof 4, issue #94. Every non-pass build or verify record at\\n    record_version 3 or later carries a stop naming its class and cause.\\\"\\\"\\\"\\n    p = run_doctor(ROOT)[\\\"no-stop-lacks-cause\\\"]\\n    assert p[\\\"holds\\\"], p[\\\"reason\\\"]\\n\\n\\n@pytest.mark.own_records\\ndef test_no_invocation_lacks_record() -> None:\\n    \\\"\\\"\\\"Proof 5, issue #151. Every <stage>-NN.started marker under\\n    paths.records has arrived at its own <stage>-NN.json, or is still a\\n    live process on this host.\\\"\\\"\\\"\\n    p = run_doctor(ROOT)[\\\"no-invocation-lacks-record\\\"]\\n    assert p[\\\"holds\\\"], p[\\\"reason\\\"]\\n\\n\\ndef test_every_attested_item_is_sealed() -> None:\\n    \\\"\\\"\\\"Proof 5, issue #158. Every merged, fully-staged item has a\\n    statement in the forge's attestation store for its merge commit --\\n    #106, #148, #153 predate [forge].sealed_since and are named before the\\n    window instead.\\\"\\\"\\\"\\n    p = run_doctor(ROOT)[\\\"every-attested-item-is-sealed\\\"]\\n    assert p[\\\"holds\\\"], p[\\\"reason\\\"]\\n\\n\\ndef test_record_loader_uses_highest_attempt_number(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Acceptance 2a. <stage>-NN.json files are one stage's attempts; the\\n    doctor treats the highest NN as latest, and STAGES is unchanged.\\n\\n    spec-01.json names a commit that isn't on the branch at all; spec-02.json\\n    names the real code commit. Proof 3 holds only if the loader reads\\n    spec-02, not spec-01 -- i.e. only if it picks the highest attempt.\\n    \\\"\\\"\\\"\\n    root = tmp_path / \\\"attempts\\\"\\n    root.mkdir()\\n    (root / \\\"attavo.toml\\\").write_text('[paths]\\\\nrecords = \\\"records\\\"\\\\n')\\n    init_repo(root, \\\"install\\\")\\n\\n    (root / \\\"src.txt\\\").write_text(\\\"code\\\\n\\\")\\n    commit_all(root, \\\"code change\\\")\\n    code_sha = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"rev-parse\\\", \\\"HEAD\\\"],\\n                              capture_output=True, text=True, check=True).stdout.strip()\\n\\n    records = root / \\\"records\\\" / \\\"1\\\"\\n    records.mkdir(parents=True)\\n    (records / \\\"spec-01.json\\\").write_text(json.dumps({\\\"sha\\\": \\\"0\\\" * 40}))\\n    (records / \\\"spec-02.json\\\").write_text(json.dumps({\\\"sha\\\": code_sha}))\\n    commit_all(root, \\\"spec records\\\")\\n\\n    p = run_doctor(root)[\\\"no-commit-lacks-record\\\"]\\n    assert p[\\\"holds\\\"], p[\\\"reason\\\"]\\n\\n\\ndef test_doctor_proof_two_counts_three_of_four_stages_still_red(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Acceptance 8. A work item carrying spec, approval, and build records\\n    is three of the four STAGES proof two names; verify doesn't exist\\n    yet, so the proof stays red and names exactly that one as lacking.\\n    \\\"\\\"\\\"\\n    root = tmp_path / \\\"three_stages\\\"\\n    root.mkdir()\\n    (root / \\\"attavo.toml\\\").write_text('[paths]\\\\nrecords = \\\"records\\\"\\\\n')\\n    init_repo(root, \\\"install\\\")\\n\\n    records = root / \\\"records\\\" / \\\"1\\\"\\n    records.mkdir(parents=True)\\n    (records / \\\"spec-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\"}))\\n    (records / \\\"approval-01.json\\\").write_text(json.dumps({\\\"approved_by\\\": \\\"alice\\\"}))\\n    (records / \\\"build-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\"}))\\n    commit_all(root, \\\"spec, approval, and build records\\\")\\n\\n    p = run_doctor(root)[\\\"one-item-every-stage\\\"]\\n    assert not p[\\\"holds\\\"]\\n    assert \\\"verify\\\" in p[\\\"reason\\\"]\\n    assert \\\"build\\\" not in p[\\\"reason\\\"]\\n\\n\\ndef test_doctor_proof_two_holds_on_a_fixture_carrying_all_four_stages_merged(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Acceptance row 4, issue #69: attestation is retired as a record\\n    type -- STAGES is four stages, not five -- and proof two now also\\n    requires the four records to have reached HEAD by an actual merge\\n    commit, whose first-parent diff introduces all four, the same\\n    derivation attest itself uses. A fixture with one record per stage,\\n    landed on a branch and merged --no-ff, is enough to prove the\\n    mechanism.\\\"\\\"\\\"\\n    root = tmp_path / \\\"four_stages_merged\\\"\\n    root.mkdir()\\n    (root / \\\"attavo.toml\\\").write_text('[paths]\\\\nrecords = \\\"records\\\"\\\\n')\\n    init_repo(root, \\\"install\\\")\\n\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"-b\\\", \\\"attavo/1-x\\\"], check=True)\\n    records = root / \\\"records\\\" / \\\"1\\\"\\n    records.mkdir(parents=True)\\n    (records / \\\"spec-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\"}))\\n    (records / \\\"approval-01.json\\\").write_text(json.dumps({\\\"approved_by\\\": \\\"alice\\\"}))\\n    (records / \\\"build-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\"}))\\n    (records / \\\"verify-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\"}))\\n    commit_all(root, \\\"spec, approval, build, and verify records\\\")\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"main\\\"], check=True)\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"merge\\\", \\\"--no-ff\\\", \\\"-m\\\",\\n                    \\\"Merge branch 'attavo/1-x'\\\", \\\"attavo/1-x\\\"], check=True)\\n\\n    p = run_doctor(root)[\\\"one-item-every-stage\\\"]\\n    assert p[\\\"holds\\\"], p[\\\"reason\\\"]\\n\\n\\ndef test_doctor_proof_two_fails_when_four_stage_records_are_never_merged(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Acceptance row 4's other half, issue #69: the same four records,\\n    committed straight to main with no merge at all -- proof two fails,\\n    naming the missing merge rather than a lacking stage.\\\"\\\"\\\"\\n    root = tmp_path / \\\"four_stages_unmerged\\\"\\n    root.mkdir()\\n    (root / \\\"attavo.toml\\\").write_text('[paths]\\\\nrecords = \\\"records\\\"\\\\n')\\n    init_repo(root, \\\"install\\\")\\n\\n    records = root / \\\"records\\\" / \\\"1\\\"\\n    records.mkdir(parents=True)\\n    (records / \\\"spec-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\"}))\\n    (records / \\\"approval-01.json\\\").write_text(json.dumps({\\\"approved_by\\\": \\\"alice\\\"}))\\n    (records / \\\"build-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\"}))\\n    (records / \\\"verify-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\"}))\\n    commit_all(root, \\\"spec, approval, build, and verify records, committed directly\\\")\\n\\n    p = run_doctor(root)[\\\"one-item-every-stage\\\"]\\n    assert not p[\\\"holds\\\"]\\n    assert \\\"merge\\\" in p[\\\"reason\\\"]\\n\\n\\ndef test_proof_two_fails_naming_the_item_and_refusal_text_on_approval_sha_mismatch(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Acceptance row 1, issue #74. build-01's approval_sha does not name\\n    the latest approval's sha -- attavo attest would refuse exactly this\\n    chain, and from v0.11.0 the coherence gate refuses the merge group on\\n    it. Proof two must refuse it too, not just find the four stages\\n    present: fails naming the item and check_attest_chain's own refusal\\n    text, never a re-typed copy of it.\\\"\\\"\\\"\\n    root = tmp_path / \\\"approval_sha_mismatch\\\"\\n    root.mkdir()\\n    (root / \\\"attavo.toml\\\").write_text('[paths]\\\\nrecords = \\\"records\\\"\\\\n')\\n    init_repo(root, \\\"install\\\")\\n\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"-b\\\", \\\"attavo/1-x\\\"], check=True)\\n    records = root / \\\"records\\\" / \\\"1\\\"\\n    records.mkdir(parents=True)\\n    (records / \\\"spec-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\"}))\\n    (records / \\\"approval-01.json\\\").write_text(json.dumps({\\\"approved_by\\\": \\\"alice\\\", \\\"sha\\\": \\\"1\\\" * 40}))\\n    (records / \\\"build-01.json\\\").write_text(\\n        json.dumps({\\\"status\\\": \\\"pass\\\", \\\"approval_sha\\\": \\\"2\\\" * 40, \\\"sha\\\": \\\"3\\\" * 40}))\\n    (records / \\\"verify-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\", \\\"build_sha\\\": \\\"3\\\" * 40}))\\n    commit_all(root, \\\"spec, approval, build, and verify records with a stale approval_sha\\\")\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"main\\\"], check=True)\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"merge\\\", \\\"--no-ff\\\", \\\"-m\\\",\\n                    \\\"Merge branch 'attavo/1-x'\\\", \\\"attavo/1-x\\\"], check=True)\\n\\n    p = run_doctor(root)[\\\"one-item-every-stage\\\"]\\n    assert not p[\\\"holds\\\"]\\n    assert \\\"item 1\\\" in p[\\\"reason\\\"]\\n    assert \\\"approval_sha does not name the latest approval\\\" in p[\\\"reason\\\"]\\n\\n\\ndef test_proof_two_fails_naming_the_item_and_the_superseded_verify(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Acceptance row 5, issue #109. verify-01's build_sha does not name\\n    the latest build's sha, so verify-01 is superseded by that later\\n    build, not a mismatch -- proof two fails, naming it, with the new\\n    message, never the retired mismatch wording.\\\"\\\"\\\"\\n    root = tmp_path / \\\"build_sha_mismatch\\\"\\n    root.mkdir()\\n    (root / \\\"attavo.toml\\\").write_text('[paths]\\\\nrecords = \\\"records\\\"\\\\n')\\n    init_repo(root, \\\"install\\\")\\n\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"-b\\\", \\\"attavo/1-x\\\"], check=True)\\n    records = root / \\\"records\\\" / \\\"1\\\"\\n    records.mkdir(parents=True)\\n    (records / \\\"spec-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\"}))\\n    (records / \\\"approval-01.json\\\").write_text(json.dumps({\\\"approved_by\\\": \\\"alice\\\", \\\"sha\\\": \\\"1\\\" * 40}))\\n    (records / \\\"build-01.json\\\").write_text(\\n        json.dumps({\\\"status\\\": \\\"pass\\\", \\\"approval_sha\\\": \\\"1\\\" * 40, \\\"sha\\\": \\\"3\\\" * 40}))\\n    (records / \\\"verify-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\", \\\"build_sha\\\": \\\"9\\\" * 40}))\\n    commit_all(root, \\\"spec, approval, build, and verify records with a stale build_sha\\\")\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"main\\\"], check=True)\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"merge\\\", \\\"--no-ff\\\", \\\"-m\\\",\\n                    \\\"Merge branch 'attavo/1-x'\\\", \\\"attavo/1-x\\\"], check=True)\\n\\n    p = run_doctor(root)[\\\"one-item-every-stage\\\"]\\n    assert not p[\\\"holds\\\"]\\n    assert \\\"item 1\\\" in p[\\\"reason\\\"]\\n    assert \\\"no verify names the latest build\\\" in p[\\\"reason\\\"]\\n    assert \\\"verify-01 names\\\" in p[\\\"reason\\\"]\\n    assert \\\"verify's build_sha does not name the latest build\\\" not in p[\\\"reason\\\"]\\n\\n\\ndef test_proof_two_holds_naming_only_the_held_item_when_another_is_refused(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Acceptance row 3, issue #74. Item 1 carries every stage but a\\n    stale approval_sha; item 2's chain holds cleanly. Proof two holds,\\n    naming only item 2 -- item 1's refusal never leaks into a passing\\n    reason.\\\"\\\"\\\"\\n    root = tmp_path / \\\"two_items_one_refused\\\"\\n    root.mkdir()\\n    (root / \\\"attavo.toml\\\").write_text('[paths]\\\\nrecords = \\\"records\\\"\\\\n')\\n    init_repo(root, \\\"install\\\")\\n\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"-b\\\", \\\"attavo/1-x\\\"], check=True)\\n    records1 = root / \\\"records\\\" / \\\"1\\\"\\n    records1.mkdir(parents=True)\\n    (records1 / \\\"spec-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\"}))\\n    (records1 / \\\"approval-01.json\\\").write_text(json.dumps({\\\"approved_by\\\": \\\"alice\\\", \\\"sha\\\": \\\"1\\\" * 40}))\\n    (records1 / \\\"build-01.json\\\").write_text(\\n        json.dumps({\\\"status\\\": \\\"pass\\\", \\\"approval_sha\\\": \\\"2\\\" * 40, \\\"sha\\\": \\\"3\\\" * 40}))\\n    (records1 / \\\"verify-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\", \\\"build_sha\\\": \\\"3\\\" * 40}))\\n    commit_all(root, \\\"spec, approval, build, and verify records for item 1, chain refused\\\")\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"main\\\"], check=True)\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"merge\\\", \\\"--no-ff\\\", \\\"-m\\\",\\n                    \\\"Merge branch 'attavo/1-x'\\\", \\\"attavo/1-x\\\"], check=True)\\n\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"-b\\\", \\\"attavo/2-x\\\"], check=True)\\n    records2 = root / \\\"records\\\" / \\\"2\\\"\\n    records2.mkdir(parents=True)\\n    (records2 / \\\"spec-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\"}))\\n    (records2 / \\\"approval-01.json\\\").write_text(json.dumps({\\\"approved_by\\\": \\\"alice\\\", \\\"sha\\\": \\\"9\\\" * 40}))\\n    (records2 / \\\"build-01.json\\\").write_text(\\n        json.dumps({\\\"status\\\": \\\"pass\\\", \\\"approval_sha\\\": \\\"9\\\" * 40, \\\"sha\\\": \\\"8\\\" * 40}))\\n    (records2 / \\\"verify-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\", \\\"build_sha\\\": \\\"8\\\" * 40}))\\n    commit_all(root, \\\"spec, approval, build, and verify records for item 2, chain holds\\\")\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"main\\\"], check=True)\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"merge\\\", \\\"--no-ff\\\", \\\"-m\\\",\\n                    \\\"Merge branch 'attavo/2-x'\\\", \\\"attavo/2-x\\\"], check=True)\\n    merge2_sha = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"rev-parse\\\", \\\"HEAD\\\"],\\n                                capture_output=True, text=True, check=True).stdout.strip()\\n\\n    p = run_doctor(root)[\\\"one-item-every-stage\\\"]\\n    assert p[\\\"holds\\\"], p[\\\"reason\\\"]\\n    assert p[\\\"reason\\\"] == (\\n        \\\"item(s) 2 carry spec, approval, build, verify with the chain held, \\\"\\n        f\\\"merged at {merge2_sha[:12]}\\\")\\n\\n\\ndef test_proof_three_holds_on_an_item_merge_with_no_attestation_record(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Acceptance row 5, issue #69: an item's merge commit carries its\\n    record paths in its own first-parent diff, so it is a record commit\\n    by the rule that already exists -- no merge_sha field is needed, and\\n    there is no attestation record at all now that attest never writes\\n    (replaces test_merge_sha_covers_the_merge_commit_for_proof_three,\\n    deleted alongside the merge_sha special case it exercised).\\\"\\\"\\\"\\n    root = tmp_path / \\\"item_merge\\\"\\n    root.mkdir()\\n    (root / \\\"attavo.toml\\\").write_text('[paths]\\\\nrecords = \\\"records\\\"\\\\n')\\n    init_repo(root, \\\"install\\\")\\n\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"-b\\\", \\\"attavo/1-x\\\"], check=True)\\n    records = root / \\\"records\\\" / \\\"1\\\"\\n    records.mkdir(parents=True)\\n    (records / \\\"spec-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\"}))\\n    (records / \\\"approval-01.json\\\").write_text(json.dumps({\\\"approved_by\\\": \\\"alice\\\"}))\\n    (records / \\\"build-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\"}))\\n    (records / \\\"verify-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\"}))\\n    commit_all(root, \\\"spec, approval, build, and verify records for item 1\\\")\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"main\\\"], check=True)\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"merge\\\", \\\"--no-ff\\\", \\\"-m\\\",\\n                    \\\"Merge branch 'attavo/1-x'\\\", \\\"attavo/1-x\\\"], check=True)\\n\\n    p = run_doctor(root)[\\\"no-commit-lacks-record\\\"]\\n    assert p[\\\"holds\\\"], p[\\\"reason\\\"]\\n    assert not (records / \\\"attestation-01.json\\\").exists()\\n\\n\\ndef _three_way_fixture(tmp_path: Path, name: str, *, boundary_paths: list[str] | None,\\n                       ordinary_touches: str, include_direct_commit: bool) -> Path:\\n    \\\"\\\"\\\"A tenant history carrying one commit of each of proof three's three\\n    kinds (issue #72): an item merge (recorded, by the records-path rule\\n    proof two's fixtures already exercise), a --no-ff merge touching only\\n    `ordinary_touches` (ordinary), and, when asked, one commit made\\n    straight to main naming no record (unrecorded -- on a protected main\\n    with a queue, the only way a change arrives without the forge).\\n    \\\"\\\"\\\"\\n    root = tmp_path / name\\n    root.mkdir()\\n    manifest = '[paths]\\\\nrecords = \\\"records\\\"\\\\n'\\n    if boundary_paths is not None:\\n        patterns = \\\", \\\".join(f'\\\"{path}\\\"' for path in boundary_paths)\\n        manifest += f'\\\\n[spec.boundary]\\\\npaths = [{patterns}]\\\\n'\\n    (root / \\\"attavo.toml\\\").write_text(manifest)\\n    init_repo(root, \\\"install\\\")\\n\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"-b\\\", \\\"attavo/1-x\\\"], check=True)\\n    records = root / \\\"records\\\" / \\\"1\\\"\\n    records.mkdir(parents=True)\\n    (records / \\\"spec-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\"}))\\n    commit_all(root, \\\"spec record for item 1\\\")\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"main\\\"], check=True)\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"merge\\\", \\\"--no-ff\\\", \\\"-m\\\",\\n                    \\\"Merge branch 'attavo/1-x'\\\", \\\"attavo/1-x\\\"], check=True)\\n\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"-b\\\", \\\"ordinary-change\\\"], check=True)\\n    touched = root / ordinary_touches\\n    touched.parent.mkdir(parents=True, exist_ok=True)\\n    touched.write_text(\\\"v2\\\\n\\\")\\n    commit_all(root, \\\"an ordinary change\\\")\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"main\\\"], check=True)\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"merge\\\", \\\"--no-ff\\\", \\\"-m\\\",\\n                    \\\"Merge branch 'ordinary-change'\\\", \\\"ordinary-change\\\"], check=True)\\n\\n    if include_direct_commit:\\n        (root / \\\"direct.txt\\\").write_text(\\\"direct\\\\n\\\")\\n        commit_all(root, \\\"a change committed straight to main\\\")\\n\\n    return root\\n\\n\\ndef test_proof_three_fails_naming_the_direct_commit_with_the_three_counts(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Acceptance row 1, issue #72. The three-way fixture with its direct\\n    commit included: proof three fails, naming the direct commit and\\n    reporting all three counts in the reason.\\\"\\\"\\\"\\n    root = _three_way_fixture(tmp_path, \\\"direct_commit\\\", boundary_paths=[\\\"boundary/**\\\"],\\n                              ordinary_touches=\\\"pins/version.txt\\\", include_direct_commit=True)\\n    direct_sha = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"rev-parse\\\", \\\"HEAD\\\"],\\n                                capture_output=True, text=True, check=True).stdout.strip()\\n\\n    p = run_doctor(root)[\\\"no-commit-lacks-record\\\"]\\n    assert not p[\\\"holds\\\"]\\n    assert \\\"1 recorded, 1 ordinary, 1 unrecorded\\\" in p[\\\"reason\\\"]\\n    assert direct_sha[:12] in p[\\\"reason\\\"]\\n\\n\\ndef test_proof_three_holds_with_zero_unrecorded_once_the_direct_commit_is_gone(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Acceptance row 2, issue #72. The same fixture with the direct commit\\n    removed: proof three holds, reporting `0 unrecorded`.\\\"\\\"\\\"\\n    root = _three_way_fixture(tmp_path, \\\"no_direct_commit\\\", boundary_paths=[\\\"boundary/**\\\"],\\n                              ordinary_touches=\\\"pins/version.txt\\\", include_direct_commit=False)\\n\\n    p = run_doctor(root)[\\\"no-commit-lacks-record\\\"]\\n    assert p[\\\"holds\\\"], p[\\\"reason\\\"]\\n    assert \\\"1 recorded, 1 ordinary, 0 unrecorded\\\" in p[\\\"reason\\\"]\\n\\n\\ndef test_proof_three_reports_boundary_evasions_and_still_holds(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Acceptance row 3, issue #72. The ordinary merge touches a path\\n    inside [spec.boundary].paths: the reason carries `boundary evasions:\\n    1`, and the proof still holds -- evasions are reported, never\\n    refused.\\\"\\\"\\\"\\n    root = _three_way_fixture(tmp_path, \\\"boundary_evasion\\\", boundary_paths=[\\\"boundary/**\\\"],\\n                              ordinary_touches=\\\"boundary/thing.txt\\\", include_direct_commit=False)\\n\\n    p = run_doctor(root)[\\\"no-commit-lacks-record\\\"]\\n    assert p[\\\"holds\\\"], p[\\\"reason\\\"]\\n    assert \\\"boundary evasions: 1\\\" in p[\\\"reason\\\"]\\n\\n\\ndef test_proof_three_reports_boundary_evasions_as_not_available_with_no_boundary_paths(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Acceptance row 4, issue #72. A tenant declaring no [spec.boundary]\\n    paths at all: evasions are reported as `n/a`, not `0` -- an absent\\n    read is not the same measurement as zero evasions found.\\\"\\\"\\\"\\n    root = _three_way_fixture(tmp_path, \\\"no_boundary\\\", boundary_paths=None,\\n                              ordinary_touches=\\\"pins/version.txt\\\", include_direct_commit=False)\\n\\n    p = run_doctor(root)[\\\"no-commit-lacks-record\\\"]\\n    assert p[\\\"holds\\\"], p[\\\"reason\\\"]\\n    assert \\\"boundary evasions: n/a\\\" in p[\\\"reason\\\"]\\n    assert p[\\\"boundary_evasions\\\"] == \\\"n/a\\\"\\n\\n\\ndef test_proof_three_json_carries_the_path_ratio_fields(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Acceptance row 5, issue #72. `attavo doctor --json` carries\\n    `recorded`, `ordinary`, `unrecorded`, and `boundary_evasions` on\\n    proof three's own entry -- the path-ratio primitive Phase 4 names,\\n    produced now because a decision depends on it.\\\"\\\"\\\"\\n    root = _three_way_fixture(tmp_path, \\\"json_fields\\\", boundary_paths=[\\\"boundary/**\\\"],\\n                              ordinary_touches=\\\"pins/version.txt\\\", include_direct_commit=False)\\n\\n    p = run_doctor(root)[\\\"no-commit-lacks-record\\\"]\\n    assert p[\\\"recorded\\\"] == 1\\n    assert p[\\\"ordinary\\\"] == 1\\n    assert p[\\\"unrecorded\\\"] == 0\\n    assert p[\\\"boundary_evasions\\\"] == 0\\n\\n\\ndef test_proof_three_json_lists_the_ordinary_and_unrecorded_commits(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Issue #148. Proof three's JSON entry carries `ordinary_commits` and\\n    `unrecorded_commits`, each commit with sha and subject, so a reader\\n    can name the commits behind the counts without re-running the\\n    classification by hand. The ordinary merge that touches a boundary\\n    path is flagged `boundary_evasion: true`.\\\"\\\"\\\"\\n    root = _three_way_fixture(tmp_path, \\\"commit_lists\\\", boundary_paths=[\\\"boundary/**\\\"],\\n                              ordinary_touches=\\\"boundary/thing.txt\\\", include_direct_commit=True)\\n    direct_sha = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"rev-parse\\\", \\\"HEAD\\\"],\\n                                capture_output=True, text=True, check=True).stdout.strip()\\n\\n    p = run_doctor(root)[\\\"no-commit-lacks-record\\\"]\\n    ordinary_commits = p[\\\"ordinary_commits\\\"]\\n    unrecorded_commits = p[\\\"unrecorded_commits\\\"]\\n    assert [c[\\\"subject\\\"] for c in ordinary_commits] == [\\\"Merge branch 'ordinary-change'\\\"]\\n    assert len(ordinary_commits[0][\\\"sha\\\"]) == 40\\n    assert ordinary_commits[0][\\\"boundary_evasion\\\"] is True\\n    assert [c[\\\"subject\\\"] for c in unrecorded_commits] == [\\\"a change committed straight to main\\\"]\\n    assert unrecorded_commits[0][\\\"sha\\\"] == direct_sha\\n\\n\\ndef _window_fixture(tmp_path: Path, name: str) -> tuple[Path, str, str]:\\n    \\\"\\\"\\\"Two commits made straight to main, then a branch carrying item 1's\\n    spec record, merged --no-ff. Returns (root, merge_sha, branch_sha) --\\n    merge_sha is on main's first-parent line and is the only sha issue\\n    #74's [doctor] from tests declare as valid; branch_sha is the branch\\n    commit itself, reachable only as the merge's second parent and never\\n    on that line, the sha the invalid-from test declares instead.\\\"\\\"\\\"\\n    root = tmp_path / name\\n    root.mkdir()\\n    (root / \\\"attavo.toml\\\").write_text('[paths]\\\\nrecords = \\\"records\\\"\\\\n')\\n    init_repo(root, \\\"install\\\")\\n\\n    (root / \\\"pre1.txt\\\").write_text(\\\"1\\\\n\\\")\\n    commit_all(root, \\\"a change committed straight to main\\\")\\n    (root / \\\"pre2.txt\\\").write_text(\\\"2\\\\n\\\")\\n    commit_all(root, \\\"another change committed straight to main\\\")\\n\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"-b\\\", \\\"attavo/1-x\\\"], check=True)\\n    records = root / \\\"records\\\" / \\\"1\\\"\\n    records.mkdir(parents=True)\\n    (records / \\\"spec-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\"}))\\n    commit_all(root, \\\"spec record for item 1\\\")\\n    branch_sha = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"rev-parse\\\", \\\"HEAD\\\"],\\n                                capture_output=True, text=True, check=True).stdout.strip()\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"main\\\"], check=True)\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"merge\\\", \\\"--no-ff\\\", \\\"-m\\\",\\n                    \\\"Merge branch 'attavo/1-x'\\\", \\\"attavo/1-x\\\"], check=True)\\n    merge_sha = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"rev-parse\\\", \\\"HEAD\\\"],\\n                               capture_output=True, text=True, check=True).stdout.strip()\\n    return root, merge_sha, branch_sha\\n\\n\\ndef _declare_doctor_from(root: Path, from_sha: str) -> None:\\n    \\\"\\\"\\\"Names [doctor] from via its own merge, not a direct commit to\\n    main -- declaring the window must never itself read as an unrecorded\\n    commit inside it.\\\"\\\"\\\"\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"-b\\\", \\\"declare-window\\\"], check=True)\\n    toml = root / \\\"attavo.toml\\\"\\n    toml.write_text(toml.read_text() + f'\\\\n[doctor]\\\\nfrom = \\\"{from_sha}\\\"\\\\n')\\n    commit_all(root, \\\"declare the doctor's window\\\")\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"main\\\"], check=True)\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"merge\\\", \\\"--no-ff\\\", \\\"-m\\\",\\n                    \\\"Merge branch 'declare-window'\\\", \\\"declare-window\\\"], check=True)\\n\\n\\ndef test_proof_three_holds_reporting_before_the_window_with_doctor_from(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Acceptance row 4, issue #74. [doctor] from names the item merge:\\n    the two commits made straight to main before it fall before the\\n    window, not into unrecorded -- proof three holds, `before the\\n    window: 2`, and the window's own counts, 1 recorded (the item merge)\\n    and 1 ordinary (the merge that declares the window itself).\\\"\\\"\\\"\\n    root, merge_sha, _ = _window_fixture(tmp_path, \\\"window_holds\\\")\\n    _declare_doctor_from(root, merge_sha)\\n\\n    p = run_doctor(root)[\\\"no-commit-lacks-record\\\"]\\n    assert p[\\\"holds\\\"], p[\\\"reason\\\"]\\n    assert \\\"before the window: 2\\\" in p[\\\"reason\\\"]\\n    assert \\\"1 recorded, 1 ordinary, 0 unrecorded\\\" in p[\\\"reason\\\"]\\n    assert p[\\\"before_window\\\"] == 2\\n\\n\\ndef test_proof_three_holds_when_doctor_from_names_a_seven_character_prefix(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Acceptance row 5 (amendment), issue #74. [doctor] from need not be\\n    a full sha -- any spelling git rev-parse --verify resolves is\\n    accepted, resolved before the first-parent check runs. A\\n    seven-character prefix of the item merge holds with the same counts\\n    as the full-sha case.\\\"\\\"\\\"\\n    root, merge_sha, _ = _window_fixture(tmp_path, \\\"window_holds_short_sha\\\")\\n    _declare_doctor_from(root, merge_sha[:7])\\n\\n    p = run_doctor(root)[\\\"no-commit-lacks-record\\\"]\\n    assert p[\\\"holds\\\"], p[\\\"reason\\\"]\\n    assert \\\"before the window: 2\\\" in p[\\\"reason\\\"]\\n    assert \\\"1 recorded, 1 ordinary, 0 unrecorded\\\" in p[\\\"reason\\\"]\\n    assert p[\\\"before_window\\\"] == 2\\n\\n\\ndef test_proof_three_fails_naming_the_key_when_doctor_from_is_off_the_first_parent_line(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Acceptance row 5, issue #74. [doctor] from names the item branch's\\n    own commit -- reachable only as a merge's second parent, never on\\n    main's first-parent line -- proof three fails naming the key rather\\n    than silently falling back to the install commit.\\\"\\\"\\\"\\n    root, _, branch_sha = _window_fixture(tmp_path, \\\"window_off_line\\\")\\n    _declare_doctor_from(root, branch_sha)\\n\\n    p = run_doctor(root)[\\\"no-commit-lacks-record\\\"]\\n    assert not p[\\\"holds\\\"]\\n    assert \\\"[doctor] from\\\" in p[\\\"reason\\\"]\\n    assert branch_sha[:12] in p[\\\"reason\\\"]\\n\\n\\ndef test_proof_three_defaults_to_the_install_commit_when_doctor_key_is_absent(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Acceptance row 6, issue #74. No [doctor] table at all: the window\\n    defaults to the install commit exactly as before this issue -- both\\n    commits made straight to main are still read as unrecorded, and\\n    before_window is 0 -- the read every existing proof-three test\\n    exercises is unaffected by the key's addition.\\\"\\\"\\\"\\n    root, _merge_sha, _branch_sha = _window_fixture(tmp_path, \\\"window_absent\\\")\\n\\n    p = run_doctor(root)[\\\"no-commit-lacks-record\\\"]\\n    assert not p[\\\"holds\\\"]\\n    assert \\\"1 recorded, 0 ordinary, 2 unrecorded\\\" in p[\\\"reason\\\"]\\n    assert \\\"before the window: 0\\\" in p[\\\"reason\\\"]\\n    assert p[\\\"before_window\\\"] == 0\\n\\n\\ndef test_doctor_proof_one_refuses_a_gate_with_empty_retires(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Residual, issue #54 -- proposed, not yet ruled on: a gate that\\n    retires nothing only adds. The manifest schema has required\\n    [gates.<name>].retires to be non-empty since Phase 1, but read_manifest\\n    never validates against that schema, so nothing enforced it at\\n    runtime until this proof read it directly.\\\"\\\"\\\"\\n    root = tmp_path / \\\"empty_retires\\\"\\n    root.mkdir()\\n    (root / \\\"attavo.toml\\\").write_text(\\n        '[paths]\\\\nrejections = \\\"rejections\\\"\\\\n\\\\n'\\n        '[gates.spec]\\\\ncommand = \\\"false\\\"\\\\nretires = []\\\\n')\\n    (root / \\\"rejections\\\" / \\\"spec\\\").mkdir(parents=True)\\n    init_repo(root, \\\"install\\\")\\n\\n    p = run_doctor(root)[\\\"every-gate-rejects\\\"]\\n    assert not p[\\\"holds\\\"]\\n    assert \\\"retires\\\" in p[\\\"reason\\\"] and \\\"spec\\\" in p[\\\"reason\\\"]\\n\\n\\ndef test_doctor_proof_one_runs_the_gate_without_an_item_argument(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Issue #7, and its regression test. [gates.spec].command is a bare\\n    `attavo spec-gate`, no item argument, and its rejections/spec/ fixture\\n    carries no attavo/N-* branch at all (init_repo leaves it on `main`) --\\n    so before the doctor exported the fixture's item as ATTAVO_ITEM, the\\n    gate command would exit 2 (cannot derive item id) without ever writing\\n    a record, which still counts as \\\"rejected\\\" but proves nothing about the\\n    prose criterion this fixture means to test.\\n\\n    Red at the merge base: no ATTAVO_ITEM export existed, so no\\n    spec-01.json was ever written and reading it raised FileNotFoundError.\\n    Green once the doctor exports it: the record exists and names the\\n    prose criterion by name, which is the actual thing proof one asserts.\\n    \\\"\\\"\\\"\\n    outer = tmp_path / \\\"gate_rejection\\\"\\n    shutil.copytree(FIXTURES / \\\"gate_rejection\\\", outer)\\n    cmd = f\\\"{sys.executable} {ATTAVO}\\\"\\n    toml = outer / \\\"attavo.toml\\\"\\n    toml.write_text(toml.read_text().replace(\\\"ATTAVO_CMD\\\", cmd))\\n    init_repo(outer / \\\"rejections\\\" / \\\"spec\\\")\\n\\n    p = run_doctor(outer)[\\\"every-gate-rejects\\\"]\\n    assert p[\\\"holds\\\"], p[\\\"reason\\\"]\\n\\n    record = json.loads(\\n        (outer / \\\"rejections\\\" / \\\"spec\\\" / \\\"records\\\" / \\\"1\\\" / \\\"spec-01.json\\\").read_text())\\n    assert record[\\\"refusal\\\"] == \\\"criterion is prose: missing.sh\\\"\\n\\n\\ndef test_doctor_proof_four_fails_on_a_failed_record_with_no_stop(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Acceptance row 1, issue #94: a\",\"stderr\":\"\",\"interrupted\":false,\"isImage\":false,\"noOutputExpected\":false,\"persistedOutputPath\":\"/Users/davidbean/.claude/projects/-Users-davidbean-Projects-attavo-worktree-237/5a752ff7-c430-4cfd-9b9a-21883129b5e6/tool-results/b6yk0qz6c.txt\",\"persistedOutputSize\":52418}}\n+{\"type\":\"assistant\",\"message\":{\"model\":\"claude-sonnet-5\",\"id\":\"msg_011CfUabiTdLcn69xqzSS6Dq\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_019jm5qTZBzkGGPSMZJHKuiv\",\"name\":\"Bash\",\"input\":{\"command\":\"cat tests/test_own_records_guard.py\"},\"caller\":{\"type\":\"direct\"}}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":1523,\"cache_read_input_tokens\":29589,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":1523},\"output_tokens\":5,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"5a752ff7-c430-4cfd-9b9a-21883129b5e6\",\"uuid\":\"75a6dddb-a66e-4c49-9bf9-a24ad4c13bd4\",\"timestamp\":\"2026-09-27T20:32:07.510Z\",\"request_id\":\"req_011CfUabi82uNiBTcHhDzVNy\",\"wire_tool_inputs\":{\"toolu_019jm5qTZBzkGGPSMZJHKuiv\":{\"command\":\"cd /Users/davidbean/Projects/attavo-worktree-237 && cat tests/test_own_records_guard.py\"}},\"wire_ingest_context\":{\"toolu_019jm5qTZBzkGGPSMZJHKuiv\":{\"cwd\":\"/Users/davidbean/Projects/attavo-worktree-237\"}}}\n+{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_019jm5qTZBzkGGPSMZJHKuiv\",\"type\":\"tool_result\",\"content\":\"\\\"\\\"\\\"Issue #210: `test` inherits a records-only commit's result only because\\nno test in the ordinary suite reads this repository's own records\\ndirectory, the one thing such a commit changes. The tests that do are\\nmarked @pytest.mark.own_records and are the only ones `test` runs on the\\ninherit path. This guard is what keeps that list true: an unmarked test\\nthat names this repository as the tenant a product reader is pointed at,\\nor joins ROOT to the records directory, fails here. The doctor tests the\\n`test` job deselects are exempt: they never run in `test`, they run for\\nreal in the `doctor` job, which does not inherit.\\n\\nThe guard reads test source for the vocabulary by which a test in this\\nsuite reaches the repository's own tree (ROOT handed to a product reader,\\nROOT joined to \\\"attest\\\" or to the manifest's paths). It cannot follow a\\nhelper that hides ROOT; a new way of reaching the records adds a pattern\\nhere. The property behind the list was also checked directly when this\\nguard was written: the suite run on a copy of the repository with\\nattest/records removed, unmarked tests only, passed.\\n\\nRun: python3 -m pytest tests -q\\n\\\"\\\"\\\"\\nfrom __future__ import annotations\\n\\nimport ast\\nimport re\\nfrom pathlib import Path\\n\\nimport pytest\\n\\nTESTS = Path(__file__).resolve().parent\\nCI_YML = TESTS.parent / \\\".github\\\" / \\\"workflows\\\" / \\\"ci.yml\\\"\\nMARK = \\\"pytest.mark.own_records\\\"\\nDESELECT = re.compile(r\\\"--deselect\\\\s+tests/(test_\\\\w+\\\\.py::test_\\\\w+)\\\")\\nREADERS = (\\n    re.compile(r\\\"\\\\b(?:run_doctor|drive_report|read_manifest|run_attavo)\\\\(\\\\s*ROOT\\\\b\\\"),\\n    re.compile(r\\\"\\\\bROOT\\\\s*/\\\\s*[\\\\\\\"']attest[\\\\\\\"']\\\"),\\n    re.compile(r\\\"\\\\bROOT\\\\b[^\\\\n]*\\\\bpaths\\\\b\\\"),\\n)\\n\\n\\ndef _is_marked(node: ast.AST) -> bool:\\n    decorators = getattr(node, \\\"decorator_list\\\", [])\\n    return any(ast.unparse(d) == MARK for d in decorators)\\n\\n\\ndef deselected_by_the_test_job() -> frozenset[str]:\\n    \\\"\\\"\\\"`file::test` for each test ci.yml's `test` job deselects.\\\"\\\"\\\"\\n    lines = CI_YML.read_text().splitlines()\\n    start = lines.index(\\\"  test:\\\")\\n    end = next((i for i in range(start + 1, len(lines))\\n                if lines[i].startswith(\\\"  \\\") and not lines[i].startswith(\\\"    \\\")\\n                and lines[i].strip().endswith(\\\":\\\") and lines[i].strip() != \\\"test:\\\"), len(lines))\\n    return frozenset(DESELECT.findall(\\\"\\\\n\\\".join(lines[start:end])))\\n\\n\\ndef unmarked_own_records_readers(tests_dir: Path, skip: str,\\n                                 exempt: frozenset[str] = frozenset()) -> list[str]:\\n    \\\"\\\"\\\"`file::test` for every test in tests_dir that reads the repository's\\n    own records without the marker. `skip` is a file name not scanned: this\\n    file states the patterns as strings and would name itself. `exempt`\\n    names tests, as `file::test`, that never run where the marker matters.\\\"\\\"\\\"\\n    found: list[str] = []\\n    for path in sorted(tests_dir.glob(\\\"test_*.py\\\")):\\n        if path.name == skip:\\n            continue\\n        source = path.read_text()\\n        tree = ast.parse(source)\\n        if MARK in source and any(\\n                isinstance(n, ast.Assign) and any(isinstance(t, ast.Name) and t.id == \\\"pytestmark\\\"\\n                                                  for t in n.targets) and MARK in ast.unparse(n.value)\\n                for n in tree.body):\\n            continue\\n        for node in ast.walk(tree):\\n            if not isinstance(node, ast.FunctionDef) or not node.name.startswith(\\\"test_\\\"):\\n                continue\\n            if _is_marked(node):\\n                continue\\n            body = ast.get_source_segment(source, node) or \\\"\\\"\\n            name = f\\\"{path.name}::{node.name}\\\"\\n            if name not in exempt and any(pattern.search(body) for pattern in READERS):\\n                found.append(name)\\n    return found\\n\\n\\ndef test_the_test_job_deselects_the_doctor_tests_the_doctor_job_runs() -> None:\\n    assert len(deselected_by_the_test_job()) == 6, deselected_by_the_test_job()\\n\\n\\ndef test_no_unmarked_test_reads_this_repositorys_own_records() -> None:\\n    assert unmarked_own_records_readers(\\n        TESTS, skip=Path(__file__).name, exempt=deselected_by_the_test_job()) == []\\n\\n\\n@pytest.mark.parametrize(\\\"reader\\\", [\\n    \\\"run_doctor(ROOT)\\\",\\n    \\\"drive_report(ROOT, m, item)\\\",\\n    \\\"read_manifest(ROOT)\\\",\\n    \\\"run_attavo(ROOT, 'report')\\\",\\n    \\\"list((ROOT / 'attest').rglob('*.json'))\\\",\\n    \\\"sorted((ROOT / m['paths']['records']).iterdir())\\\",\\n])\\ndef test_the_guard_names_a_planted_reader_and_not_a_marked_one(tmp_path: Path, reader: str) -> None:\\n    (tmp_path / \\\"test_planted.py\\\").write_text(\\n        f\\\"def test_reads() -> None:\\\\n    {reader}\\\\n\\\")\\n    (tmp_path / \\\"test_marked.py\\\").write_text(\\n        f\\\"import pytest\\\\n\\\\n\\\\n@pytest.mark.own_records\\\\ndef test_reads() -> None:\\\\n    {reader}\\\\n\\\")\\n    (tmp_path / \\\"test_module_marked.py\\\").write_text(\\n        f\\\"import pytest\\\\n\\\\npytestmark = pytest.mark.own_records\\\\n\\\\n\\\\ndef test_reads() -> None:\\\\n    {reader}\\\\n\\\")\\n    assert unmarked_own_records_readers(tmp_path, skip=\\\"\\\") == [\\\"test_planted.py::test_reads\\\"]\\n\\n\\ndef test_the_guard_leaves_a_test_that_builds_its_own_tenant_alone(tmp_path: Path) -> None:\\n    (tmp_path / \\\"test_own.py\\\").write_text(\\n        \\\"def test_builds(tmp_path):\\\\n    root = make_tenant(tmp_path, 'valid')\\\\n    run_doctor(root)\\\\n\\\")\\n    assert unmarked_own_records_readers(tmp_path, skip=\\\"\\\") == []\",\"is_error\":false}]},\"parent_tool_use_id\":null,\"session_id\":\"5a752ff7-c430-4cfd-9b9a-21883129b5e6\",\"uuid\":\"f99ba890-c4d8-432a-b1f6-026234d83b78\",\"timestamp\":\"2026-09-27T20:32:07.608Z\",\"tool_use_result\":{\"stdout\":\"\\\"\\\"\\\"Issue #210: `test` inherits a records-only commit's result only because\\nno test in the ordinary suite reads this repository's own records\\ndirectory, the one thing such a commit changes. The tests that do are\\nmarked @pytest.mark.own_records and are the only ones `test` runs on the\\ninherit path. This guard is what keeps that list true: an unmarked test\\nthat names this repository as the tenant a product reader is pointed at,\\nor joins ROOT to the records directory, fails here. The doctor tests the\\n`test` job deselects are exempt: they never run in `test`, they run for\\nreal in the `doctor` job, which does not inherit.\\n\\nThe guard reads test source for the vocabulary by which a test in this\\nsuite reaches the repository's own tree (ROOT handed to a product reader,\\nROOT joined to \\\"attest\\\" or to the manifest's paths). It cannot follow a\\nhelper that hides ROOT; a new way of reaching the records adds a pattern\\nhere. The property behind the list was also checked directly when this\\nguard was written: the suite run on a copy of the repository with\\nattest/records removed, unmarked tests only, passed.\\n\\nRun: python3 -m pytest tests -q\\n\\\"\\\"\\\"\\nfrom __future__ import annotations\\n\\nimport ast\\nimport re\\nfrom pathlib import Path\\n\\nimport pytest\\n\\nTESTS = Path(__file__).resolve().parent\\nCI_YML = TESTS.parent / \\\".github\\\" / \\\"workflows\\\" / \\\"ci.yml\\\"\\nMARK = \\\"pytest.mark.own_records\\\"\\nDESELECT = re.compile(r\\\"--deselect\\\\s+tests/(test_\\\\w+\\\\.py::test_\\\\w+)\\\")\\nREADERS = (\\n    re.compile(r\\\"\\\\b(?:run_doctor|drive_report|read_manifest|run_attavo)\\\\(\\\\s*ROOT\\\\b\\\"),\\n    re.compile(r\\\"\\\\bROOT\\\\s*/\\\\s*[\\\\\\\"']attest[\\\\\\\"']\\\"),\\n    re.compile(r\\\"\\\\bROOT\\\\b[^\\\\n]*\\\\bpaths\\\\b\\\"),\\n)\\n\\n\\ndef _is_marked(node: ast.AST) -> bool:\\n    decorators = getattr(node, \\\"decorator_list\\\", [])\\n    return any(ast.unparse(d) == MARK for d in decorators)\\n\\n\\ndef deselected_by_the_test_job() -> frozenset[str]:\\n    \\\"\\\"\\\"`file::test` for each test ci.yml's `test` job deselects.\\\"\\\"\\\"\\n    lines = CI_YML.read_text().splitlines()\\n    start = lines.index(\\\"  test:\\\")\\n    end = next((i for i in range(start + 1, len(lines))\\n                if lines[i].startswith(\\\"  \\\") and not lines[i].startswith(\\\"    \\\")\\n                and lines[i].strip().endswith(\\\":\\\") and lines[i].strip() != \\\"test:\\\"), len(lines))\\n    return frozenset(DESELECT.findall(\\\"\\\\n\\\".join(lines[start:end])))\\n\\n\\ndef unmarked_own_records_readers(tests_dir: Path, skip: str,\\n                                 exempt: frozenset[str] = frozenset()) -> list[str]:\\n    \\\"\\\"\\\"`file::test` for every test in tests_dir that reads the repository's\\n    own records without the marker. `skip` is a file name not scanned: this\\n    file states the patterns as strings and would name itself. `exempt`\\n    names tests, as `file::test`, that never run where the marker matters.\\\"\\\"\\\"\\n    found: list[str] = []\\n    for path in sorted(tests_dir.glob(\\\"test_*.py\\\")):\\n        if path.name == skip:\\n            continue\\n        source = path.read_text()\\n        tree = ast.parse(source)\\n        if MARK in source and any(\\n                isinstance(n, ast.Assign) and any(isinstance(t, ast.Name) and t.id == \\\"pytestmark\\\"\\n                                                  for t in n.targets) and MARK in ast.unparse(n.value)\\n                for n in tree.body):\\n            continue\\n        for node in ast.walk(tree):\\n            if not isinstance(node, ast.FunctionDef) or not node.name.startswith(\\\"test_\\\"):\\n                continue\\n            if _is_marked(node):\\n                continue\\n            body = ast.get_source_segment(source, node) or \\\"\\\"\\n            name = f\\\"{path.name}::{node.name}\\\"\\n            if name not in exempt and any(pattern.search(body) for pattern in READERS):\\n                found.append(name)\\n    return found\\n\\n\\ndef test_the_test_job_deselects_the_doctor_tests_the_doctor_job_runs() -> None:\\n    assert len(deselected_by_the_test_job()) == 6, deselected_by_the_test_job()\\n\\n\\ndef test_no_unmarked_test_reads_this_repositorys_own_records() -> None:\\n    assert unmarked_own_records_readers(\\n        TESTS, skip=Path(__file__).name, exempt=deselected_by_the_test_job()) == []\\n\\n\\n@pytest.mark.parametrize(\\\"reader\\\", [\\n    \\\"run_doctor(ROOT)\\\",\\n    \\\"drive_report(ROOT, m, item)\\\",\\n    \\\"read_manifest(ROOT)\\\",\\n    \\\"run_attavo(ROOT, 'report')\\\",\\n    \\\"list((ROOT / 'attest').rglob('*.json'))\\\",\\n    \\\"sorted((ROOT / m['paths']['records']).iterdir())\\\",\\n])\\ndef test_the_guard_names_a_planted_reader_and_not_a_marked_one(tmp_path: Path, reader: str) -> None:\\n    (tmp_path / \\\"test_planted.py\\\").write_text(\\n        f\\\"def test_reads() -> None:\\\\n    {reader}\\\\n\\\")\\n    (tmp_path / \\\"test_marked.py\\\").write_text(\\n        f\\\"import pytest\\\\n\\\\n\\\\n@pytest.mark.own_records\\\\ndef test_reads() -> None:\\\\n    {reader}\\\\n\\\")\\n    (tmp_path / \\\"test_module_marked.py\\\").write_text(\\n        f\\\"import pytest\\\\n\\\\npytestmark = pytest.mark.own_records\\\\n\\\\n\\\\ndef test_reads() -> None:\\\\n    {reader}\\\\n\\\")\\n    assert unmarked_own_records_readers(tmp_path, skip=\\\"\\\") == [\\\"test_planted.py::test_reads\\\"]\\n\\n\\ndef test_the_guard_leaves_a_test_that_builds_its_own_tenant_alone(tmp_path: Path) -> None:\\n    (tmp_path / \\\"test_own.py\\\").write_text(\\n        \\\"def test_builds(tmp_path):\\\\n    root = make_tenant(tmp_path, 'valid')\\\\n    run_doctor(root)\\\\n\\\")\\n    assert unmarked_own_records_readers(tmp_path, skip=\\\"\\\") == []\",\"stderr\":\"\",\"interrupted\":false,\"isImage\":false,\"noOutputExpected\":false}}\n+{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01Ga9QxHmY3WHatFYMu97x6i\",\"type\":\"tool_result\",\"content\":\"\\\"\\\"\\\"Issue #103: this repository installs Attavo on itself, pinned at\\nv0.17.1 -- the product's second tenant, and the last product change to\\nland by the lane rather than the product it builds. Nothing under\\nbin/, adapters/, schema/, templates/, or action.yml changes for this\\nissue; every assertion here is about the tenancy files added beside\\nthem: attavo.toml, .attavo/bin/*, the three copied workflows, and\\nci.yml's schema-version job.\\n\\nRun: python3 -m pytest tests -q\\n\\\"\\\"\\\"\\nfrom __future__ import annotations\\n\\nimport re\\nfrom typing import Any\\n\\nimport subprocess\\nimport sys\\nimport tomllib\\nfrom pathlib import Path\\n\\nimport jsonschema\\n\\nfrom helpers import job_if_condition\\n\\nROOT = Path(__file__).resolve().parent.parent\\nMANIFEST_SCHEMA = ROOT / \\\"schema\\\" / \\\"manifest.schema.json\\\"\\nMANIFEST = ROOT / \\\"attavo.toml\\\"\\nSELECT_TESTS = ROOT / \\\".attavo\\\" / \\\"bin\\\" / \\\"select-tests\\\"\\nCI_YML = ROOT / \\\".github\\\" / \\\"workflows\\\" / \\\"ci.yml\\\"\\nCOPIED_WORKFLOWS = [\\n    ROOT / \\\".github\\\" / \\\"workflows\\\" / \\\"attavo-spec-gate.yml\\\",\\n    ROOT / \\\".github\\\" / \\\"workflows\\\" / \\\"attavo-approve.yml\\\",\\n    ROOT / \\\".github\\\" / \\\"workflows\\\" / \\\"attavo-coherence.yml\\\",\\n]\\nBOUNDARY_DIRS = [\\\"bin\\\", \\\"adapters\\\", \\\"schema\\\", \\\"templates\\\"]\\nBOUNDARY_FILES = [ROOT / \\\"action.yml\\\"]\\nTENANCY_STRINGS = (\\\".attavo/\\\", \\\"attavo.toml\\\", \\\"attest/records\\\")\\n\\n\\ndef load_manifest() -> dict[str, Any]:\\n    return tomllib.loads(MANIFEST.read_text())\\n\\n\\ndef test_manifest_validates_against_schema() -> None:\\n    schema = __import__(\\\"json\\\").loads(MANIFEST_SCHEMA.read_text())\\n    jsonschema.validate(load_manifest(), schema)\\n\\n\\ndef test_manifest_declares_every_key_issue_103_lists() -> None:\\n    m = load_manifest()\\n    assert re.fullmatch(r\\\"v\\\\d+\\\\.\\\\d+\\\\.\\\\d+\\\", m[\\\"attavo\\\"][\\\"version\\\"]), m[\\\"attavo\\\"][\\\"version\\\"]\\n    # No [doctor].from: proof_no_commit_lacks_record only accepts a\\n    # declared from equal to, or on the first-parent line strictly\\n    # after, the install commit (schema: \\\"at or after the install\\n    # commit\\\") -- never a commit before it, which is what \\\"the last\\n    # ungoverned commit\\\" would have to name. Left absent, proof three's\\n    # window starts at the install commit itself (the schema's own\\n    # default), which already holds: the one first-parent commit after\\n    # it is this issue's own merge, an ordinary merge touching no\\n    # boundary path. Verified by simulating the merge locally.\\n    # Item 227 added [doctor].built_since, the window for proof seven; [doctor].from\\n    # stays absent for the reason above.\\n    assert set(m.get(\\\"doctor\\\") or {}) == {\\\"built_since\\\"}, m.get(\\\"doctor\\\")\\n    assert m[\\\"forge\\\"][\\\"checks_command\\\"]\\n    assert m[\\\"forge\\\"][\\\"file_issue_command\\\"]\\n    paths = m[\\\"spec\\\"][\\\"boundary\\\"][\\\"paths\\\"]\\n    assert \\\"bin/**\\\" in paths and \\\"attavo/**\\\" in paths, paths\\n    assert \\\"spec\\\" in m[\\\"gates\\\"]\\n    assert m[\\\"gates\\\"][\\\"spec\\\"][\\\"retires\\\"]\\n    assert m[\\\"tests\\\"][\\\"select\\\"]\\n    assert m[\\\"tests\\\"][\\\"run\\\"]\\n    assert m[\\\"operators\\\"][\\\"approvers\\\"]\\n    assert m[\\\"checks\\\"][\\\"command\\\"]\\n\\n\\nDESELECT_FLAGS = (\\n    \\\"--deselect tests/test_doctor.py::test_every_gate_rejects\\\",\\n    \\\"--deselect tests/test_doctor.py::test_one_item_traversed_every_stage\\\",\\n    \\\"--deselect tests/test_doctor.py::test_no_commit_lacks_a_record\\\",\\n    \\\"--deselect tests/test_doctor.py::test_no_stop_lacks_cause\\\",\\n    \\\"--deselect tests/test_doctor.py::test_every_attested_item_is_sealed\\\",\\n    \\\"--deselect tests/test_doctor.py::test_no_attested_item_is_empty\\\",\\n)\\n\\n\\ndef test_checks_and_tests_run_deselect_the_four_dogfood_doctor_tests() -> None:\\n    \\\"\\\"\\\"[checks].command and [tests].run must never run the four doctor\\n    tests that fail until an item has traversed every stage: the first\\n    item's own build would fail its own checks on a doctor proof no\\n    item has satisfied yet. [checks].command is ci.yml's test job\\n    command verbatim, deselects included; [tests].run carries the same\\n    four flags after `python3 -m pytest -q`. The doctor job in ci.yml is\\n    the only place the four run without them. Written and run red once\\n    by dropping one flag from [checks].command, confirmed it failed,\\n    then restored.\\\"\\\"\\\"\\n    m = load_manifest()\\n    for flag in DESELECT_FLAGS:\\n        assert flag in m[\\\"tests\\\"][\\\"run\\\"], m[\\\"tests\\\"][\\\"run\\\"]\\n    # Since the calibration item the gate's [checks].command runs the type\\n    # check and no test at all; the whole suite is ci.yml's test job, which\\n    # carries the same flags. A gate command that names pytest again must\\n    # carry them too.\\n    if \\\"pytest\\\" in m[\\\"checks\\\"][\\\"command\\\"]:\\n        for flag in DESELECT_FLAGS:\\n            assert flag in m[\\\"checks\\\"][\\\"command\\\"], m[\\\"checks\\\"][\\\"command\\\"]\\n\\n\\ndef run_select_tests(stdin_text: str) -> list[str]:\\n    run = subprocess.run([sys.executable, str(SELECT_TESTS)], input=stdin_text,\\n                         capture_output=True, text=True, check=True)\\n    return [line for line in run.stdout.splitlines() if line]\\n\\n\\ndef test_select_tests_maps_bin_attavo_to_the_whole_suite() -> None:\\n    assert run_select_tests(\\\"bin/attavo\\\\n\\\") == [\\\"tests\\\"]\\n\\n\\ndef test_select_tests_maps_an_adapter_path_to_the_adapter_tests() -> None:\\n    selected = run_select_tests(\\\"adapters/example/run\\\\n\\\")\\n    assert \\\"tests/test_adapters.py\\\" in selected and \\\"tests/test_executor_conformance.py\\\" in selected\\n    assert \\\"tests\\\" not in selected, \\\"an adapter path selected the whole suite\\\"\\n\\n\\ndef test_select_tests_maps_a_schema_path_to_the_record_and_attest_tests() -> None:\\n    selected = run_select_tests(\\\"schema/records/build.schema.json\\\\n\\\")\\n    assert \\\"tests/test_record_schemas.py\\\" in selected and \\\"tests/test_attest.py\\\" in selected\\n    assert \\\"tests\\\" not in selected, \\\"a schema path selected the whole suite\\\"\\n\\n\\ndef test_select_tests_maps_an_unrelated_path_to_nothing() -> None:\\n    assert run_select_tests(\\\"README.md\\\\n\\\") == []\\n\\n\\ndef test_copied_workflows_pin_the_release_the_manifest_declares() -> None:\\n    pin = load_manifest()[\\\"attavo\\\"][\\\"version\\\"]\\n    for path in COPIED_WORKFLOWS:\\n        assert f\\\"uses: attavo/attavo@{pin}\\\" in path.read_text(), (path.name, pin)\\n\\n\\ndef test_schema_version_job_reports_on_merge_group() -> None:\\n    text = CI_YML.read_text()\\n    lines = text.splitlines()\\n    on_idx = next(i for i, l in enumerate(lines) if l.strip() == \\\"on:\\\")\\n    jobs_idx = next(i for i, l in enumerate(lines) if l.strip() == \\\"jobs:\\\")\\n    on_body = \\\"\\\\n\\\".join(lines[on_idx + 1:jobs_idx])\\n    assert \\\"merge_group:\\\" in on_body\\n\\n    condition = job_if_condition(text, \\\"schema-version\\\")\\n    assert condition is not None\\n    assert \\\"github.event_name == 'merge_group'\\\" in condition\\n    assert \\\"github.event_name == 'pull_request'\\\" in condition\\n\\n\\ndef test_doctor_job_reports_on_pull_request_and_merge_group() -> None:\\n    \\\"\\\"\\\"Issue #113: the doctor job's #106 condition, main-only, hid it from\\n    pull requests and merge groups -- the events where a refusal is\\n    cheap. It must name both, and never reduce to the main-only shape a\\n    later edit could reintroduce.\\\"\\\"\\\"\\n    condition = job_if_condition(CI_YML.read_text(), \\\"doctor\\\")\\n    assert condition is not None\\n    assert \\\"github.event_name == 'pull_request'\\\" in condition\\n    assert \\\"github.event_name == 'merge_group'\\\" in condition\\n    assert condition != \\\"github.ref == 'refs/heads/main'\\\"\\n\\n\\n# The product's own pre-existing, generic vocabulary that a blind grep for\\n# TENANCY_STRINGS would otherwise flag: \\\"attavo.toml\\\" is the manifest\\n# filename every tenant uses, named by the schema itself, not a fact\\n# about this repository's own installation (adapters/README.md's\\n# ATTAVO_MANIFEST doc line, bin/attavo's own MANIFEST constant, the\\n# schema's own title, and the two template workflows' own tomllib read of\\n# whatever tenant copies them in -- theirs, never this repository's).\\n# Each entry is\\n# (path relative to ROOT, the exact line's stripped text) so a genuinely\\n# new occurrence -- anywhere else, or a changed line here -- still fails\\n# the test.\\nBASELINE = {\\n    (\\\"adapters/README.md\\\",\\n     \\\"- `ATTAVO_MANIFEST` — counsel only: the path to the tenant's own `attavo.toml`.\\\"),\\n    (\\\"bin/attavo\\\", 'MANIFEST = \\\"attavo.toml\\\"'),\\n    (\\\"schema/manifest.schema.json\\\", '\\\"title\\\": \\\"Attavo tenant manifest (attavo.toml)\\\",'),\\n    (\\\"templates/workflows/attavo-approve.yml\\\",\\n     'records_rel=\\\"$(python3 -c \\\"import tomllib; print(tomllib.load(open(\\\\'attavo.toml\\\\',\\\\'rb\\\\'))[\\\\'paths\\\\'][\\\\'records\\\\'])\\\")\\\"'),\\n    (\\\"templates/workflows/attavo-spec-gate.yml\\\",\\n     'records_rel=\\\"$(python3 -c \\\"import tomllib; print(tomllib.load(open(\\\\'attavo.toml\\\\',\\\\'rb\\\\'))[\\\\'paths\\\\'][\\\\'records\\\\'])\\\")\\\"'),\\n}\\n\\n\\ndef test_rejection_no_product_file_names_a_tenancy_path() -> None:\\n    \\\"\\\"\\\"The product does not know it is a tenant: no file under bin/,\\n    adapters/, schema/, templates/, or action.yml mentions .attavo/,\\n    attavo.toml, or attest/records as a path, beyond the pre-existing\\n    generic mentions in BASELINE. Written and run red once by planting\\n    \\\"attest/records\\\" in a scratch line under bin/ during development;\\n    removed once this test caught it.\\\"\\\"\\\"\\n    offenders = []\\n    paths = list(BOUNDARY_FILES)\\n    for d in BOUNDARY_DIRS:\\n        paths.extend(p for p in (ROOT / d).rglob(\\\"*\\\") if p.is_file())\\n    for path in paths:\\n        try:\\n            lines = path.read_text().splitlines()\\n        except (UnicodeDecodeError, OSError):\\n            continue\\n        relpath = str(path.relative_to(ROOT))\\n        for line in lines:\\n            stripped = line.strip()\\n            if (relpath, stripped) in BASELINE:\\n                continue\\n            for needle in TENANCY_STRINGS:\\n                if needle in line:\\n                    offenders.append(f\\\"{relpath}: {needle!r} in {stripped!r}\\\")\\n    assert not offenders, offenders\",\"is_error\":false}]},\"parent_tool_use_id\":null,\"session_id\":\"5a752ff7-c430-4cfd-9b9a-21883129b5e6\",\"uuid\":\"2d244d1c-c125-4021-b4b0-4826084e4760\",\"timestamp\":\"2026-09-27T20:32:09.026Z\",\"tool_use_result\":{\"stdout\":\"\\\"\\\"\\\"Issue #103: this repository installs Attavo on itself, pinned at\\nv0.17.1 -- the product's second tenant, and the last product change to\\nland by the lane rather than the product it builds. Nothing under\\nbin/, adapters/, schema/, templates/, or action.yml changes for this\\nissue; every assertion here is about the tenancy files added beside\\nthem: attavo.toml, .attavo/bin/*, the three copied workflows, and\\nci.yml's schema-version job.\\n\\nRun: python3 -m pytest tests -q\\n\\\"\\\"\\\"\\nfrom __future__ import annotations\\n\\nimport re\\nfrom typing import Any\\n\\nimport subprocess\\nimport sys\\nimport tomllib\\nfrom pathlib import Path\\n\\nimport jsonschema\\n\\nfrom helpers import job_if_condition\\n\\nROOT = Path(__file__).resolve().parent.parent\\nMANIFEST_SCHEMA = ROOT / \\\"schema\\\" / \\\"manifest.schema.json\\\"\\nMANIFEST = ROOT / \\\"attavo.toml\\\"\\nSELECT_TESTS = ROOT / \\\".attavo\\\" / \\\"bin\\\" / \\\"select-tests\\\"\\nCI_YML = ROOT / \\\".github\\\" / \\\"workflows\\\" / \\\"ci.yml\\\"\\nCOPIED_WORKFLOWS = [\\n    ROOT / \\\".github\\\" / \\\"workflows\\\" / \\\"attavo-spec-gate.yml\\\",\\n    ROOT / \\\".github\\\" / \\\"workflows\\\" / \\\"attavo-approve.yml\\\",\\n    ROOT / \\\".github\\\" / \\\"workflows\\\" / \\\"attavo-coherence.yml\\\",\\n]\\nBOUNDARY_DIRS = [\\\"bin\\\", \\\"adapters\\\", \\\"schema\\\", \\\"templates\\\"]\\nBOUNDARY_FILES = [ROOT / \\\"action.yml\\\"]\\nTENANCY_STRINGS = (\\\".attavo/\\\", \\\"attavo.toml\\\", \\\"attest/records\\\")\\n\\n\\ndef load_manifest() -> dict[str, Any]:\\n    return tomllib.loads(MANIFEST.read_text())\\n\\n\\ndef test_manifest_validates_against_schema() -> None:\\n    schema = __import__(\\\"json\\\").loads(MANIFEST_SCHEMA.read_text())\\n    jsonschema.validate(load_manifest(), schema)\\n\\n\\ndef test_manifest_declares_every_key_issue_103_lists() -> None:\\n    m = load_manifest()\\n    assert re.fullmatch(r\\\"v\\\\d+\\\\.\\\\d+\\\\.\\\\d+\\\", m[\\\"attavo\\\"][\\\"version\\\"]), m[\\\"attavo\\\"][\\\"version\\\"]\\n    # No [doctor].from: proof_no_commit_lacks_record only accepts a\\n    # declared from equal to, or on the first-parent line strictly\\n    # after, the install commit (schema: \\\"at or after the install\\n    # commit\\\") -- never a commit before it, which is what \\\"the last\\n    # ungoverned commit\\\" would have to name. Left absent, proof three's\\n    # window starts at the install commit itself (the schema's own\\n    # default), which already holds: the one first-parent commit after\\n    # it is this issue's own merge, an ordinary merge touching no\\n    # boundary path. Verified by simulating the merge locally.\\n    # Item 227 added [doctor].built_since, the window for proof seven; [doctor].from\\n    # stays absent for the reason above.\\n    assert set(m.get(\\\"doctor\\\") or {}) == {\\\"built_since\\\"}, m.get(\\\"doctor\\\")\\n    assert m[\\\"forge\\\"][\\\"checks_command\\\"]\\n    assert m[\\\"forge\\\"][\\\"file_issue_command\\\"]\\n    paths = m[\\\"spec\\\"][\\\"boundary\\\"][\\\"paths\\\"]\\n    assert \\\"bin/**\\\" in paths and \\\"attavo/**\\\" in paths, paths\\n    assert \\\"spec\\\" in m[\\\"gates\\\"]\\n    assert m[\\\"gates\\\"][\\\"spec\\\"][\\\"retires\\\"]\\n    assert m[\\\"tests\\\"][\\\"select\\\"]\\n    assert m[\\\"tests\\\"][\\\"run\\\"]\\n    assert m[\\\"operators\\\"][\\\"approvers\\\"]\\n    assert m[\\\"checks\\\"][\\\"command\\\"]\\n\\n\\nDESELECT_FLAGS = (\\n    \\\"--deselect tests/test_doctor.py::test_every_gate_rejects\\\",\\n    \\\"--deselect tests/test_doctor.py::test_one_item_traversed_every_stage\\\",\\n    \\\"--deselect tests/test_doctor.py::test_no_commit_lacks_a_record\\\",\\n    \\\"--deselect tests/test_doctor.py::test_no_stop_lacks_cause\\\",\\n    \\\"--deselect tests/test_doctor.py::test_every_attested_item_is_sealed\\\",\\n    \\\"--deselect tests/test_doctor.py::test_no_attested_item_is_empty\\\",\\n)\\n\\n\\ndef test_checks_and_tests_run_deselect_the_four_dogfood_doctor_tests() -> None:\\n    \\\"\\\"\\\"[checks].command and [tests].run must never run the four doctor\\n    tests that fail until an item has traversed every stage: the first\\n    item's own build would fail its own checks on a doctor proof no\\n    item has satisfied yet. [checks].command is ci.yml's test job\\n    command verbatim, deselects included; [tests].run carries the same\\n    four flags after `python3 -m pytest -q`. The doctor job in ci.yml is\\n    the only place the four run without them. Written and run red once\\n    by dropping one flag from [checks].command, confirmed it failed,\\n    then restored.\\\"\\\"\\\"\\n    m = load_manifest()\\n    for flag in DESELECT_FLAGS:\\n        assert flag in m[\\\"tests\\\"][\\\"run\\\"], m[\\\"tests\\\"][\\\"run\\\"]\\n    # Since the calibration item the gate's [checks].command runs the type\\n    # check and no test at all; the whole suite is ci.yml's test job, which\\n    # carries the same flags. A gate command that names pytest again must\\n    # carry them too.\\n    if \\\"pytest\\\" in m[\\\"checks\\\"][\\\"command\\\"]:\\n        for flag in DESELECT_FLAGS:\\n            assert flag in m[\\\"checks\\\"][\\\"command\\\"], m[\\\"checks\\\"][\\\"command\\\"]\\n\\n\\ndef run_select_tests(stdin_text: str) -> list[str]:\\n    run = subprocess.run([sys.executable, str(SELECT_TESTS)], input=stdin_text,\\n                         capture_output=True, text=True, check=True)\\n    return [line for line in run.stdout.splitlines() if line]\\n\\n\\ndef test_select_tests_maps_bin_attavo_to_the_whole_suite() -> None:\\n    assert run_select_tests(\\\"bin/attavo\\\\n\\\") == [\\\"tests\\\"]\\n\\n\\ndef test_select_tests_maps_an_adapter_path_to_the_adapter_tests() -> None:\\n    selected = run_select_tests(\\\"adapters/example/run\\\\n\\\")\\n    assert \\\"tests/test_adapters.py\\\" in selected and \\\"tests/test_executor_conformance.py\\\" in selected\\n    assert \\\"tests\\\" not in selected, \\\"an adapter path selected the whole suite\\\"\\n\\n\\ndef test_select_tests_maps_a_schema_path_to_the_record_and_attest_tests() -> None:\\n    selected = run_select_tests(\\\"schema/records/build.schema.json\\\\n\\\")\\n    assert \\\"tests/test_record_schemas.py\\\" in selected and \\\"tests/test_attest.py\\\" in selected\\n    assert \\\"tests\\\" not in selected, \\\"a schema path selected the whole suite\\\"\\n\\n\\ndef test_select_tests_maps_an_unrelated_path_to_nothing() -> None:\\n    assert run_select_tests(\\\"README.md\\\\n\\\") == []\\n\\n\\ndef test_copied_workflows_pin_the_release_the_manifest_declares() -> None:\\n    pin = load_manifest()[\\\"attavo\\\"][\\\"version\\\"]\\n    for path in COPIED_WORKFLOWS:\\n        assert f\\\"uses: attavo/attavo@{pin}\\\" in path.read_text(), (path.name, pin)\\n\\n\\ndef test_schema_version_job_reports_on_merge_group() -> None:\\n    text = CI_YML.read_text()\\n    lines = text.splitlines()\\n    on_idx = next(i for i, l in enumerate(lines) if l.strip() == \\\"on:\\\")\\n    jobs_idx = next(i for i, l in enumerate(lines) if l.strip() == \\\"jobs:\\\")\\n    on_body = \\\"\\\\n\\\".join(lines[on_idx + 1:jobs_idx])\\n    assert \\\"merge_group:\\\" in on_body\\n\\n    condition = job_if_condition(text, \\\"schema-version\\\")\\n    assert condition is not None\\n    assert \\\"github.event_name == 'merge_group'\\\" in condition\\n    assert \\\"github.event_name == 'pull_request'\\\" in condition\\n\\n\\ndef test_doctor_job_reports_on_pull_request_and_merge_group() -> None:\\n    \\\"\\\"\\\"Issue #113: the doctor job's #106 condition, main-only, hid it from\\n    pull requests and merge groups -- the events where a refusal is\\n    cheap. It must name both, and never reduce to the main-only shape a\\n    later edit could reintroduce.\\\"\\\"\\\"\\n    condition = job_if_condition(CI_YML.read_text(), \\\"doctor\\\")\\n    assert condition is not None\\n    assert \\\"github.event_name == 'pull_request'\\\" in condition\\n    assert \\\"github.event_name == 'merge_group'\\\" in condition\\n    assert condition != \\\"github.ref == 'refs/heads/main'\\\"\\n\\n\\n# The product's own pre-existing, generic vocabulary that a blind grep for\\n# TENANCY_STRINGS would otherwise flag: \\\"attavo.toml\\\" is the manifest\\n# filename every tenant uses, named by the schema itself, not a fact\\n# about this repository's own installation (adapters/README.md's\\n# ATTAVO_MANIFEST doc line, bin/attavo's own MANIFEST constant, the\\n# schema's own title, and the two template workflows' own tomllib read of\\n# whatever tenant copies them in -- theirs, never this repository's).\\n# Each entry is\\n# (path relative to ROOT, the exact line's stripped text) so a genuinely\\n# new occurrence -- anywhere else, or a changed line here -- still fails\\n# the test.\\nBASELINE = {\\n    (\\\"adapters/README.md\\\",\\n     \\\"- `ATTAVO_MANIFEST` — counsel only: the path to the tenant's own `attavo.toml`.\\\"),\\n    (\\\"bin/attavo\\\", 'MANIFEST = \\\"attavo.toml\\\"'),\\n    (\\\"schema/manifest.schema.json\\\", '\\\"title\\\": \\\"Attavo tenant manifest (attavo.toml)\\\",'),\\n    (\\\"templates/workflows/attavo-approve.yml\\\",\\n     'records_rel=\\\"$(python3 -c \\\"import tomllib; print(tomllib.load(open(\\\\'attavo.toml\\\\',\\\\'rb\\\\'))[\\\\'paths\\\\'][\\\\'records\\\\'])\\\")\\\"'),\\n    (\\\"templates/workflows/attavo-spec-gate.yml\\\",\\n     'records_rel=\\\"$(python3 -c \\\"import tomllib; print(tomllib.load(open(\\\\'attavo.toml\\\\',\\\\'rb\\\\'))[\\\\'paths\\\\'][\\\\'records\\\\'])\\\")\\\"'),\\n}\\n\\n\\ndef test_rejection_no_product_file_names_a_tenancy_path() -> None:\\n    \\\"\\\"\\\"The product does not know it is a tenant: no file under bin/,\\n    adapters/, schema/, templates/, or action.yml mentions .attavo/,\\n    attavo.toml, or attest/records as a path, beyond the pre-existing\\n    generic mentions in BASELINE. Written and run red once by planting\\n    \\\"attest/records\\\" in a scratch line under bin/ during development;\\n    removed once this test caught it.\\\"\\\"\\\"\\n    offenders = []\\n    paths = list(BOUNDARY_FILES)\\n    for d in BOUNDARY_DIRS:\\n        paths.extend(p for p in (ROOT / d).rglob(\\\"*\\\") if p.is_file())\\n    for path in paths:\\n        try:\\n            lines = path.read_text().splitlines()\\n        except (UnicodeDecodeError, OSError):\\n            continue\\n        relpath = str(path.relative_to(ROOT))\\n        for line in lines:\\n            stripped = line.strip()\\n            if (relpath, stripped) in BASELINE:\\n                continue\\n            for needle in TENANCY_STRINGS:\\n                if needle in line:\\n                    offenders.append(f\\\"{relpath}: {needle!r} in {stripped!r}\\\")\\n    assert not offenders, offenders\",\"stderr\":\"\",\"interrupted\":false,\"isImage\":false,\"noOutputExpected\":false}}\n+{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01YNShQqfnYWCdnRB9Rt5F92\",\"type\":\"tool_result\",\"content\":\"1\\t\\\"\\\"\\\"The doctor's five proofs, as tests written before the capability.\\n2\\t\\n3\\tEach test asserts that one proof holds against this repository. All five\\n4\\tfail at the first commit and must fail: that is the definition of done,\\n5\\tstated before anything exists to satisfy it. A test here turns green only\\n6\\twhen the capability it names has landed and been used for real.\\n7\\t\\n8\\tRun: python3 -m pytest tests -q\\n9\\t\\\"\\\"\\\"\\n10\\timport json\\n11\\timport os\\n12\\timport shutil\\n13\\timport socket\\n14\\timport subprocess\\n15\\timport sys\\n16\\tfrom pathlib import Path\\n17\\tfrom typing import Any\\n18\\t\\n19\\timport pytest\\n20\\tfrom helpers import FIXTURES, commit_all, init_repo, make_tenant\\n21\\t\\n22\\tROOT = Path(__file__).resolve().parent.parent\\n23\\tATTAVO = ROOT / \\\"bin\\\" / \\\"attavo\\\"\\n24\\t\\n25\\t\\n26\\tdef run_doctor(root: Path) -> dict[str, Any]:\\n27\\t    out = subprocess.run([sys.executable, str(ATTAVO), \\\"doctor\\\", str(root), \\\"--json\\\"],\\n28\\t                         capture_output=True, text=True, check=False)\\n29\\t    report = json.loads(out.stdout)\\n30\\t    assert out.returncode == (0 if report[\\\"done\\\"] else 1)\\n31\\t    return {p[\\\"proof\\\"]: p for p in report[\\\"proofs\\\"]}\\n32\\t\\n33\\t\\n34\\tdef test_every_gate_rejects() -> None:\\n35\\t    \\\"\\\"\\\"Proof 1. Every gate in the manifest rejects its rejection fixture.\\n36\\t\\n37\\t    Holds when: a manifest exists, [gates] names at least one gate, each gate\\n38\\t    has a fixture under paths.rejections, and each gate exits non-zero on it.\\n39\\t    \\\"\\\"\\\"\\n40\\t    p = run_doctor(ROOT)[\\\"every-gate-rejects\\\"]\\n41\\t    assert p[\\\"holds\\\"], p[\\\"reason\\\"]\\n42\\t\\n43\\t\\n44\\tdef test_one_item_traversed_every_stage() -> None:\\n45\\t    \\\"\\\"\\\"Proof 2. One work item carries a record for spec, approval, build,\\n46\\t    verify, and attestation, every one written by a script.\\\"\\\"\\\"\\n47\\t    p = run_doctor(ROOT)[\\\"one-item-every-stage\\\"]\\n48\\t    assert p[\\\"holds\\\"], p[\\\"reason\\\"]\\n49\\t\\n50\\t\\n51\\tdef test_no_commit_lacks_a_record() -> None:\\n52\\t    \\\"\\\"\\\"Proof 3. Every commit on the default branch after the manifest was\\n53\\t    introduced is named by a record's sha or commits list.\\\"\\\"\\\"\\n54\\t    p = run_doctor(ROOT)[\\\"no-commit-lacks-record\\\"]\\n55\\t    assert p[\\\"holds\\\"], p[\\\"reason\\\"]\\n56\\t\\n57\\t\\n58\\tdef test_no_stop_lacks_cause() -> None:\\n59\\t    \\\"\\\"\\\"Proof 4, issue #94. Every non-pass build or verify record at\\n60\\t    record_version 3 or later carries a stop naming its class and cause.\\\"\\\"\\\"\\n61\\t    p = run_doctor(ROOT)[\\\"no-stop-lacks-cause\\\"]\\n62\\t    assert p[\\\"holds\\\"], p[\\\"reason\\\"]\\n63\\t\\n64\\t\\n65\\t@pytest.mark.own_records\\n66\\tdef test_no_invocation_lacks_record() -> None:\\n67\\t    \\\"\\\"\\\"Proof 5, issue #151. Every <stage>-NN.started marker under\\n68\\t    paths.records has arrived at its own <stage>-NN.json, or is still a\\n69\\t    live process on this host.\\\"\\\"\\\"\\n70\\t    p = run_doctor(ROOT)[\\\"no-invocation-lacks-record\\\"]\\n71\\t    assert p[\\\"holds\\\"], p[\\\"reason\\\"]\\n72\\t\\n73\\t\\n74\\tdef test_every_attested_item_is_sealed() -> None:\\n75\\t    \\\"\\\"\\\"Proof 5, issue #158. Every merged, fully-staged item has a\\n76\\t    statement in the forge's attestation store for its merge commit --\\n77\\t    #106, #148, #153 predate [forge].sealed_since and are named before the\\n78\\t    window instead.\\\"\\\"\\\"\\n79\\t    p = run_doctor(ROOT)[\\\"every-attested-item-is-sealed\\\"]\\n80\\t    assert p[\\\"holds\\\"], p[\\\"reason\\\"]\\n81\\t\\n82\\t\\n83\\tdef test_record_loader_uses_highest_attempt_number(tmp_path: Path) -> None:\\n84\\t    \\\"\\\"\\\"Acceptance 2a. <stage>-NN.json files are one stage's attempts; the\\n85\\t    doctor treats the highest NN as latest, and STAGES is unchanged.\\n86\\t\\n87\\t    spec-01.json names a commit that isn't on the branch at all; spec-02.json\\n88\\t    names the real code commit. Proof 3 holds only if the loader reads\\n89\\t    spec-02, not spec-01 -- i.e. only if it picks the highest attempt.\\n90\\t    \\\"\\\"\\\"\\n91\\t    root = tmp_path / \\\"attempts\\\"\\n92\\t    root.mkdir()\\n93\\t    (root / \\\"attavo.toml\\\").write_text('[paths]\\\\nrecords = \\\"records\\\"\\\\n')\\n94\\t    init_repo(root, \\\"install\\\")\\n95\\t\\n96\\t    (root / \\\"src.txt\\\").write_text(\\\"code\\\\n\\\")\\n97\\t    commit_all(root, \\\"code change\\\")\\n98\\t    code_sha = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"rev-parse\\\", \\\"HEAD\\\"],\\n99\\t                              capture_output=True, text=True, check=True).stdout.strip()\\n100\\t\\n101\\t    records = root / \\\"records\\\" / \\\"1\\\"\\n102\\t    records.mkdir(parents=True)\\n103\\t    (records / \\\"spec-01.json\\\").write_text(json.dumps({\\\"sha\\\": \\\"0\\\" * 40}))\\n104\\t    (records / \\\"spec-02.json\\\").write_text(json.dumps({\\\"sha\\\": code_sha}))\\n105\\t    commit_all(root, \\\"spec records\\\")\\n106\\t\\n107\\t    p = run_doctor(root)[\\\"no-commit-lacks-record\\\"]\\n108\\t    assert p[\\\"holds\\\"], p[\\\"reason\\\"]\\n109\\t\\n110\\t\\n111\\tdef test_doctor_proof_two_counts_three_of_four_stages_still_red(tmp_path: Path) -> None:\\n112\\t    \\\"\\\"\\\"Acceptance 8. A work item carrying spec, approval, and build records\\n113\\t    is three of the four STAGES proof two names; verify doesn't exist\\n114\\t    yet, so the proof stays red and names exactly that one as lacking.\\n115\\t    \\\"\\\"\\\"\\n116\\t    root = tmp_path / \\\"three_stages\\\"\\n117\\t    root.mkdir()\\n118\\t    (root / \\\"attavo.toml\\\").write_text('[paths]\\\\nrecords = \\\"records\\\"\\\\n')\\n119\\t    init_repo(root, \\\"install\\\")\\n120\\t\\n121\\t    records = root / \\\"records\\\" / \\\"1\\\"\\n122\\t    records.mkdir(parents=True)\\n123\\t    (records / \\\"spec-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\"}))\\n124\\t    (records / \\\"approval-01.json\\\").write_text(json.dumps({\\\"approved_by\\\": \\\"alice\\\"}))\\n125\\t    (records / \\\"build-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\"}))\\n126\\t    commit_all(root, \\\"spec, approval, and build records\\\")\\n127\\t\\n128\\t    p = run_doctor(root)[\\\"one-item-every-stage\\\"]\\n129\\t    assert not p[\\\"holds\\\"]\\n130\\t    assert \\\"verify\\\" in p[\\\"reason\\\"]\\n131\\t    assert \\\"build\\\" not in p[\\\"reason\\\"]\\n132\\t\\n133\\t\\n134\\tdef test_doctor_proof_two_holds_on_a_fixture_carrying_all_four_stages_merged(tmp_path: Path) -> None:\\n135\\t    \\\"\\\"\\\"Acceptance row 4, issue #69: attestation is retired as a record\\n136\\t    type -- STAGES is four stages, not five -- and proof two now also\\n137\\t    requires the four records to have reached HEAD by an actual merge\\n138\\t    commit, whose first-parent diff introduces all four, the same\\n139\\t    derivation attest itself uses. A fixture with one record per stage,\\n140\\t    landed on a branch and merged --no-ff, is enough to prove the\\n141\\t    mechanism.\\\"\\\"\\\"\\n142\\t    root = tmp_path / \\\"four_stages_merged\\\"\\n143\\t    root.mkdir()\\n144\\t    (root / \\\"attavo.toml\\\").write_text('[paths]\\\\nrecords = \\\"records\\\"\\\\n')\\n145\\t    init_repo(root, \\\"install\\\")\\n146\\t\\n147\\t    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"-b\\\", \\\"attavo/1-x\\\"], check=True)\\n148\\t    records = root / \\\"records\\\" / \\\"1\\\"\\n149\\t    records.mkdir(parents=True)\\n150\\t    (records / \\\"spec-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\"}))\\n151\\t    (records / \\\"approval-01.json\\\").write_text(json.dumps({\\\"approved_by\\\": \\\"alice\\\"}))\\n152\\t    (records / \\\"build-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\"}))\\n153\\t    (records / \\\"verify-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\"}))\\n154\\t    commit_all(root, \\\"spec, approval, build, and verify records\\\")\\n155\\t    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"main\\\"], check=True)\\n156\\t    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"merge\\\", \\\"--no-ff\\\", \\\"-m\\\",\\n157\\t                    \\\"Merge branch 'attavo/1-x'\\\", \\\"attavo/1-x\\\"], check=True)\\n158\\t\\n159\\t    p = run_doctor(root)[\\\"one-item-every-stage\\\"]\\n160\\t    assert p[\\\"holds\\\"], p[\\\"reason\\\"]\\n161\\t\\n162\\t\\n163\\tdef test_doctor_proof_two_fails_when_four_stage_records_are_never_merged(tmp_path: Path) -> None:\\n164\\t    \\\"\\\"\\\"Acceptance row 4's other half, issue #69: the same four records,\\n165\\t    committed straight to main with no merge at all -- proof two fails,\\n166\\t    naming the missing merge rather than a lacking stage.\\\"\\\"\\\"\\n167\\t    root = tmp_path / \\\"four_stages_unmerged\\\"\\n168\\t    root.mkdir()\\n169\\t    (root / \\\"attavo.toml\\\").write_text('[paths]\\\\nrecords = \\\"records\\\"\\\\n')\\n170\\t    init_repo(root, \\\"install\\\")\\n171\\t\\n172\\t    records = root / \\\"records\\\" / \\\"1\\\"\\n173\\t    records.mkdir(parents=True)\\n174\\t    (records / \\\"spec-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\"}))\\n175\\t    (records / \\\"approval-01.json\\\").write_text(json.dumps({\\\"approved_by\\\": \\\"alice\\\"}))\\n176\\t    (records / \\\"build-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\"}))\\n177\\t    (records / \\\"verify-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\"}))\\n178\\t    commit_all(root, \\\"spec, approval, build, and verify records, committed directly\\\")\\n179\\t\\n180\\t    p = run_doctor(root)[\\\"one-item-every-stage\\\"]\\n181\\t    assert not p[\\\"holds\\\"]\\n182\\t    assert \\\"merge\\\" in p[\\\"reason\\\"]\\n183\\t\\n184\\t\\n185\\tdef test_proof_two_fails_naming_the_item_and_refusal_text_on_approval_sha_mismatch(tmp_path: Path) -> None:\\n186\\t    \\\"\\\"\\\"Acceptance row 1, issue #74. build-01's approval_sha does not name\\n187\\t    the latest approval's sha -- attavo attest would refuse exactly this\\n188\\t    chain, and from v0.11.0 the coherence gate refuses the merge group on\\n189\\t    it. Proof two must refuse it too, not just find the four stages\\n190\\t    present: fails naming the item and check_attest_chain's own refusal\\n191\\t    text, never a re-typed copy of it.\\\"\\\"\\\"\\n192\\t    root = tmp_path / \\\"approval_sha_mismatch\\\"\\n193\\t    root.mkdir()\\n194\\t    (root / \\\"attavo.toml\\\").write_text('[paths]\\\\nrecords = \\\"records\\\"\\\\n')\\n195\\t    init_repo(root, \\\"install\\\")\\n196\\t\\n197\\t    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"-b\\\", \\\"attavo/1-x\\\"], check=True)\\n198\\t    records = root / \\\"records\\\" / \\\"1\\\"\\n199\\t    records.mkdir(parents=True)\\n200\\t    (records / \\\"spec-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\"}))\\n201\\t    (records / \\\"approval-01.json\\\").write_text(json.dumps({\\\"approved_by\\\": \\\"alice\\\", \\\"sha\\\": \\\"1\\\" * 40}))\\n202\\t    (records / \\\"build-01.json\\\").write_text(\\n203\\t        json.dumps({\\\"status\\\": \\\"pass\\\", \\\"approval_sha\\\": \\\"2\\\" * 40, \\\"sha\\\": \\\"3\\\" * 40}))\\n204\\t    (records / \\\"verify-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\", \\\"build_sha\\\": \\\"3\\\" * 40}))\\n205\\t    commit_all(root, \\\"spec, approval, build, and verify records with a stale approval_sha\\\")\\n206\\t    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"main\\\"], check=True)\\n207\\t    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"merge\\\", \\\"--no-ff\\\", \\\"-m\\\",\\n208\\t                    \\\"Merge branch 'attavo/1-x'\\\", \\\"attavo/1-x\\\"], check=True)\\n209\\t\\n210\\t    p = run_doctor(root)[\\\"one-item-every-stage\\\"]\\n211\\t    assert not p[\\\"holds\\\"]\\n212\\t    assert \\\"item 1\\\" in p[\\\"reason\\\"]\\n213\\t    assert \\\"approval_sha does not name the latest approval\\\" in p[\\\"reason\\\"]\\n214\\t\\n215\\t\\n216\\tdef test_proof_two_fails_naming_the_item_and_the_superseded_verify(tmp_path: Path) -> None:\\n217\\t    \\\"\\\"\\\"Acceptance row 5, issue #109. verify-01's build_sha does not name\\n218\\t    the latest build's sha, so verify-01 is superseded by that later\\n219\\t    build, not a mismatch -- proof two fails, naming it, with the new\\n220\\t    message, never the retired mismatch wording.\\\"\\\"\\\"\\n221\\t    root = tmp_path / \\\"build_sha_mismatch\\\"\\n222\\t    root.mkdir()\\n223\\t    (root / \\\"attavo.toml\\\").write_text('[paths]\\\\nrecords = \\\"records\\\"\\\\n')\\n224\\t    init_repo(root, \\\"install\\\")\\n225\\t\\n226\\t    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"-b\\\", \\\"attavo/1-x\\\"], check=True)\\n227\\t    records = root / \\\"records\\\" / \\\"1\\\"\\n228\\t    records.mkdir(parents=True)\\n229\\t    (records / \\\"spec-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\"}))\\n230\\t    (records / \\\"approval-01.json\\\").write_text(json.dumps({\\\"approved_by\\\": \\\"alice\\\", \\\"sha\\\": \\\"1\\\" * 40}))\\n231\\t    (records / \\\"build-01.json\\\").write_text(\\n232\\t        json.dumps({\\\"status\\\": \\\"pass\\\", \\\"approval_sha\\\": \\\"1\\\" * 40, \\\"sha\\\": \\\"3\\\" * 40}))\\n233\\t    (records / \\\"verify-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\", \\\"build_sha\\\": \\\"9\\\" * 40}))\\n234\\t    commit_all(root, \\\"spec, approval, build, and verify records with a stale build_sha\\\")\\n235\\t    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"main\\\"], check=True)\\n236\\t    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"merge\\\", \\\"--no-ff\\\", \\\"-m\\\",\\n237\\t                    \\\"Merge branch 'attavo/1-x'\\\", \\\"attavo/1-x\\\"], check=True)\\n238\\t\\n239\\t    p = run_doctor(root)[\\\"one-item-every-stage\\\"]\\n240\\t    assert not p[\\\"holds\\\"]\\n241\\t    assert \\\"item 1\\\" in p[\\\"reason\\\"]\\n242\\t    assert \\\"no verify names the latest build\\\" in p[\\\"reason\\\"]\\n243\\t    assert \\\"verify-01 names\\\" in p[\\\"reason\\\"]\\n244\\t    assert \\\"verify's build_sha does not name the latest build\\\" not in p[\\\"reason\\\"]\\n245\\t\\n246\\t\\n247\\tdef test_proof_two_holds_naming_only_the_held_item_when_another_is_refused(tmp_path: Path) -> None:\\n248\\t    \\\"\\\"\\\"Acceptance row 3, issue #74. Item 1 carries every stage but a\\n249\\t    stale approval_sha; item 2's chain holds cleanly. Proof two holds,\\n250\\t    naming only item 2 -- item 1's refusal never leaks into a passing\\n251\\t    reason.\\\"\\\"\\\"\\n252\\t    root = tmp_path / \\\"two_items_one_refused\\\"\\n253\\t    root.mkdir()\\n254\\t    (root / \\\"attavo.toml\\\").write_text('[paths]\\\\nrecords = \\\"records\\\"\\\\n')\\n255\\t    init_repo(root, \\\"install\\\")\\n256\\t\\n257\\t    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"-b\\\", \\\"attavo/1-x\\\"], check=True)\\n258\\t    records1 = root / \\\"records\\\" / \\\"1\\\"\\n259\\t    records1.mkdir(parents=True)\\n260\\t    (records1 / \\\"spec-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\"}))\\n261\\t    (records1 / \\\"approval-01.json\\\").write_text(json.dumps({\\\"approved_by\\\": \\\"alice\\\", \\\"sha\\\": \\\"1\\\" * 40}))\\n262\\t    (records1 / \\\"build-01.json\\\").write_text(\\n263\\t        json.dumps({\\\"status\\\": \\\"pass\\\", \\\"approval_sha\\\": \\\"2\\\" * 40, \\\"sha\\\": \\\"3\\\" * 40}))\\n264\\t    (records1 / \\\"verify-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\", \\\"build_sha\\\": \\\"3\\\" * 40}))\\n265\\t    commit_all(root, \\\"spec, approval, build, and verify records for item 1, chain refused\\\")\\n266\\t    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"main\\\"], check=True)\\n267\\t    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"merge\\\", \\\"--no-ff\\\", \\\"-m\\\",\\n268\\t                    \\\"Merge branch 'attavo/1-x'\\\", \\\"attavo/1-x\\\"], check=True)\\n269\\t\\n270\\t    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"-b\\\", \\\"attavo/2-x\\\"], check=True)\\n271\\t    records2 = root / \\\"records\\\" / \\\"2\\\"\\n272\\t    records2.mkdir(parents=True)\\n273\\t    (records2 / \\\"spec-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\"}))\\n274\\t    (records2 / \\\"approval-01.json\\\").write_text(json.dumps({\\\"approved_by\\\": \\\"alice\\\", \\\"sha\\\": \\\"9\\\" * 40}))\\n275\\t    (records2 / \\\"build-01.json\\\").write_text(\\n276\\t        json.dumps({\\\"status\\\": \\\"pass\\\", \\\"approval_sha\\\": \\\"9\\\" * 40, \\\"sha\\\": \\\"8\\\" * 40}))\\n277\\t    (records2 / \\\"verify-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\", \\\"build_sha\\\": \\\"8\\\" * 40}))\\n278\\t    commit_all(root, \\\"spec, approval, build, and verify records for item 2, chain holds\\\")\\n279\\t    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"main\\\"], check=True)\\n280\\t    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"merge\\\", \\\"--no-ff\\\", \\\"-m\\\",\\n281\\t                    \\\"Merge branch 'attavo/2-x'\\\", \\\"attavo/2-x\\\"], check=True)\\n282\\t    merge2_sha = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"rev-parse\\\", \\\"HEAD\\\"],\\n283\\t                                capture_output=True, text=True, check=True).stdout.strip()\\n284\\t\\n285\\t    p = run_doctor(root)[\\\"one-item-every-stage\\\"]\\n286\\t    assert p[\\\"holds\\\"], p[\\\"reason\\\"]\\n287\\t    assert p[\\\"reason\\\"] == (\\n288\\t        \\\"item(s) 2 carry spec, approval, build, verify with the chain held, \\\"\\n289\\t        f\\\"merged at {merge2_sha[:12]}\\\")\\n290\\t\\n291\\t\\n292\\tdef test_proof_three_holds_on_an_item_merge_with_no_attestation_record(tmp_path: Path) -> None:\\n293\\t    \\\"\\\"\\\"Acceptance row 5, issue #69: an item's merge commit carries its\\n294\\t    record paths in its own first-parent diff, so it is a record commit\\n295\\t    by the rule that already exists -- no merge_sha field is needed, and\\n296\\t    there is no attestation record at all now that attest never writes\\n297\\t    (replaces test_merge_sha_covers_the_merge_commit_for_proof_three,\\n298\\t    deleted alongside the merge_sha special case it exercised).\\\"\\\"\\\"\\n299\\t    root = tmp_path / \\\"item_merge\\\"\\n300\\t    root.mkdir()\\n301\\t    (root / \\\"attavo.toml\\\").write_text('[paths]\\\\nrecords = \\\"records\\\"\\\\n')\\n302\\t    init_repo(root, \\\"install\\\")\\n303\\t\\n304\\t    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"-b\\\", \\\"attavo/1-x\\\"], check=True)\\n305\\t    records = root / \\\"records\\\" / \\\"1\\\"\\n306\\t    records.mkdir(parents=True)\\n307\\t    (records / \\\"spec-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\"}))\\n308\\t    (records / \\\"approval-01.json\\\").write_text(json.dumps({\\\"approved_by\\\": \\\"alice\\\"}))\\n309\\t    (records / \\\"build-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\"}))\\n310\\t    (records / \\\"verify-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\"}))\\n311\\t    commit_all(root, \\\"spec, approval, build, and verify records for item 1\\\")\\n312\\t    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"main\\\"], check=True)\\n313\\t    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"merge\\\", \\\"--no-ff\\\", \\\"-m\\\",\\n314\\t                    \\\"Merge branch 'attavo/1-x'\\\", \\\"attavo/1-x\\\"], check=True)\\n315\\t\\n316\\t    p = run_doctor(root)[\\\"no-commit-lacks-record\\\"]\\n317\\t    assert p[\\\"holds\\\"], p[\\\"reason\\\"]\\n318\\t    assert not (records / \\\"attestation-01.json\\\").exists()\\n319\\t\\n320\\t\\n321\\tdef _three_way_fixture(tmp_path: Path, name: str, *, boundary_paths: list[str] | None,\\n322\\t                       ordinary_touches: str, include_direct_commit: bool) -> Path:\\n323\\t    \\\"\\\"\\\"A tenant history carrying one commit of each of proof three's three\\n324\\t    kinds (issue #72): an item merge (recorded, by the records-path rule\\n325\\t    proof two's fixtures already exercise), a --no-ff merge touching only\\n326\\t    `ordinary_touches` (ordinary), and, when asked, one commit made\\n327\\t    straight to main naming no record (unrecorded -- on a protected main\\n328\\t    with a queue, the only way a change arrives without the forge).\\n329\\t    \\\"\\\"\\\"\\n330\\t    root = tmp_path / name\\n331\\t    root.mkdir()\\n332\\t    manifest = '[paths]\\\\nrecords = \\\"records\\\"\\\\n'\\n333\\t    if boundary_paths is not None:\\n334\\t        patterns = \\\", \\\".join(f'\\\"{path}\\\"' for path in boundary_paths)\\n335\\t        manifest += f'\\\\n[spec.boundary]\\\\npaths = [{patterns}]\\\\n'\\n336\\t    (root / \\\"attavo.toml\\\").write_text(manifest)\\n337\\t    init_repo(root, \\\"install\\\")\\n338\\t\\n339\\t    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"-b\\\", \\\"attavo/1-x\\\"], check=True)\\n340\\t    records = root / \\\"records\\\" / \\\"1\\\"\\n341\\t    records.mkdir(parents=True)\\n342\\t    (records / \\\"spec-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\"}))\\n343\\t    commit_all(root, \\\"spec record for item 1\\\")\\n344\\t    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"main\\\"], check=True)\\n345\\t    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"merge\\\", \\\"--no-ff\\\", \\\"-m\\\",\\n346\\t                    \\\"Merge branch 'attavo/1-x'\\\", \\\"attavo/1-x\\\"], check=True)\\n347\\t\\n348\\t    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"-b\\\", \\\"ordinary-change\\\"], check=True)\\n349\\t    touched = root / ordinary_touches\\n350\\t    touched.parent.mkdir(parents=True, exist_ok=True)\\n351\\t    touched.write_text(\\\"v2\\\\n\\\")\\n352\\t    commit_all(root, \\\"an ordinary change\\\")\\n353\\t    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"main\\\"], check=True)\\n354\\t    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"merge\\\", \\\"--no-ff\\\", \\\"-m\\\",\\n355\\t                    \\\"Merge branch 'ordinary-change'\\\", \\\"ordinary-change\\\"], check=True)\\n356\\t\\n357\\t    if include_direct_commit:\\n358\\t        (root / \\\"direct.txt\\\").write_text(\\\"direct\\\\n\\\")\\n359\\t        commit_all(root, \\\"a change committed straight to main\\\")\\n360\\t\\n361\\t    return root\\n362\\t\\n363\\t\\n364\\tdef test_proof_three_fails_naming_the_direct_commit_with_the_three_counts(tmp_path: Path) -> None:\\n365\\t    \\\"\\\"\\\"Acceptance row 1, issue #72. The three-way fixture with its direct\\n366\\t    commit included: proof three fails, naming the direct commit and\\n367\\t    reporting all three counts in the reason.\\\"\\\"\\\"\\n368\\t    root = _three_way_fixture(tmp_path, \\\"direct_commit\\\", boundary_paths=[\\\"boundary/**\\\"],\\n369\\t                              ordinary_touches=\\\"pins/version.txt\\\", include_direct_commit=True)\\n370\\t    direct_sha = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"rev-parse\\\", \\\"HEAD\\\"],\\n371\\t                                capture_output=True, text=True, check=True).stdout.strip()\\n372\\t\\n373\\t    p = run_doctor(root)[\\\"no-commit-lacks-record\\\"]\\n374\\t    assert not p[\\\"holds\\\"]\\n375\\t    assert \\\"1 recorded, 1 ordinary, 1 unrecorded\\\" in p[\\\"reason\\\"]\\n376\\t    assert direct_sha[:12] in p[\\\"reason\\\"]\\n377\\t\\n378\\t\\n379\\tdef test_proof_three_holds_with_zero_unrecorded_once_the_direct_commit_is_gone(tmp_path: Path) -> None:\\n380\\t    \\\"\\\"\\\"Acceptance row 2, issue #72. The same fixture with the direct commit\\n381\\t    removed: proof three holds, reporting `0 unrecorded`.\\\"\\\"\\\"\\n382\\t    root = _three_way_fixture(tmp_path, \\\"no_direct_commit\\\", boundary_paths=[\\\"boundary/**\\\"],\\n383\\t                              ordinary_touches=\\\"pins/version.txt\\\", include_direct_commit=False)\\n384\\t\\n385\\t    p = run_doctor(root)[\\\"no-commit-lacks-record\\\"]\\n386\\t    assert p[\\\"holds\\\"], p[\\\"reason\\\"]\\n387\\t    assert \\\"1 recorded, 1 ordinary, 0 unrecorded\\\" in p[\\\"reason\\\"]\\n388\\t\\n389\\t\\n390\\tdef test_proof_three_reports_boundary_evasions_and_still_holds(tmp_path: Path) -> None:\\n391\\t    \\\"\\\"\\\"Acceptance row 3, issue #72. The ordinary merge touches a path\\n392\\t    inside [spec.boundary].paths: the reason carries `boundary evasions:\\n393\\t    1`, and the proof still holds -- evasions are reported, never\\n394\\t    refused.\\\"\\\"\\\"\\n395\\t    root = _three_way_fixture(tmp_path, \\\"boundary_evasion\\\", boundary_paths=[\\\"boundary/**\\\"],\\n396\\t                              ordinary_touches=\\\"boundary/thing.txt\\\", include_direct_commit=False)\\n397\\t\\n398\\t    p = run_doctor(root)[\\\"no-commit-lacks-record\\\"]\\n399\\t    assert p[\\\"holds\\\"], p[\\\"reason\\\"]\\n400\\t    assert \\\"boundary evasions: 1\\\" in p[\\\"reason\\\"]\\n401\\t\\n402\\t\\n403\\tdef test_proof_three_reports_boundary_evasions_as_not_available_with_no_boundary_paths(tmp_path: Path) -> None:\\n404\\t    \\\"\\\"\\\"Acceptance row 4, issue #72. A tenant declaring no [spec.boundary]\\n405\\t    paths at all: evasions are reported as `n/a`, not `0` -- an absent\\n406\\t    read is not the same measurement as zero evasions found.\\\"\\\"\\\"\\n407\\t    root = _three_way_fixture(tmp_path, \\\"no_boundary\\\", boundary_paths=None,\\n408\\t                              ordinary_touches=\\\"pins/version.txt\\\", include_direct_commit=False)\\n409\\t\\n410\\t    p = run_doctor(root)[\\\"no-commit-lacks-record\\\"]\\n411\\t    assert p[\\\"holds\\\"], p[\\\"reason\\\"]\\n412\\t    assert \\\"boundary evasions: n/a\\\" in p[\\\"reason\\\"]\\n413\\t    assert p[\\\"boundary_evasions\\\"] == \\\"n/a\\\"\\n414\\t\\n415\\t\\n416\\tdef test_proof_three_json_carries_the_path_ratio_fields(tmp_path: Path) -> None:\\n417\\t    \\\"\\\"\\\"Acceptance row 5, issue #72. `attavo doctor --json` carries\\n418\\t    `recorded`, `ordinary`, `unrecorded`, and `boundary_evasions` on\\n419\\t    proof three's own entry -- the path-ratio primitive Phase 4 names,\\n420\\t    produced now because a decision depends on it.\\\"\\\"\\\"\\n421\\t    root = _three_way_fixture(tmp_path, \\\"json_fields\\\", boundary_paths=[\\\"boundary/**\\\"],\\n422\\t                              ordinary_touches=\\\"pins/version.txt\\\", include_direct_commit=False)\\n423\\t\\n424\\t    p = run_doctor(root)[\\\"no-commit-lacks-record\\\"]\\n425\\t    assert p[\\\"recorded\\\"] == 1\\n426\\t    assert p[\\\"ordinary\\\"] == 1\\n427\\t    assert p[\\\"unrecorded\\\"] == 0\\n428\\t    assert p[\\\"boundary_evasions\\\"] == 0\\n429\\t\\n430\\t\\n431\\tdef test_proof_three_json_lists_the_ordinary_and_unrecorded_commits(tmp_path: Path) -> None:\\n432\\t    \\\"\\\"\\\"Issue #148. Proof three's JSON entry carries `ordinary_commits` and\\n433\\t    `unrecorded_commits`, each commit with sha and subject, so a reader\\n434\\t    can name the commits behind the counts without re-running the\\n435\\t    classification by hand. The ordinary merge that touches a boundary\\n436\\t    path is flagged `boundary_evasion: true`.\\\"\\\"\\\"\\n437\\t    root = _three_way_fixture(tmp_path, \\\"commit_lists\\\", boundary_paths=[\\\"boundary/**\\\"],\\n438\\t                              ordinary_touches=\\\"boundary/thing.txt\\\", include_direct_commit=True)\\n439\\t    direct_sha = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"rev-parse\\\", \\\"HEAD\\\"],\\n440\\t                                capture_output=True, text=True, check=True).stdout.strip()\\n441\\t\\n442\\t    p = run_doctor(root)[\\\"no-commit-lacks-record\\\"]\\n443\\t    ordinary_commits = p[\\\"ordinary_commits\\\"]\\n444\\t    unrecorded_commits = p[\\\"unrecorded_commits\\\"]\\n445\\t    assert [c[\\\"subject\\\"] for c in ordinary_commits] == [\\\"Merge branch 'ordinary-change'\\\"]\\n446\\t    assert len(ordinary_commits[0][\\\"sha\\\"]) == 40\\n447\\t    assert ordinary_commits[0][\\\"boundary_evasion\\\"] is True\\n448\\t    assert [c[\\\"subject\\\"] for c in unrecorded_commits] == [\\\"a change committed straight to main\\\"]\\n449\\t    assert unrecorded_commits[0][\\\"sha\\\"] == direct_sha\\n450\\t\\n451\\t\\n452\\tdef _window_fixture(tmp_path: Path, name: str) -> tuple[Path, str, str]:\\n453\\t    \\\"\\\"\\\"Two commits made straight to main, then a branch carrying item 1's\\n454\\t    spec record, merged --no-ff. Returns (root, merge_sha, branch_sha) --\\n455\\t    merge_sha is on main's first-parent line and is the only sha issue\\n456\\t    #74's [doctor] from tests declare as valid; branch_sha is the branch\\n457\\t    commit itself, reachable only as the merge's second parent and never\\n458\\t    on that line, the sha the invalid-from test declares instead.\\\"\\\"\\\"\\n459\\t    root = tmp_path / name\\n460\\t    root.mkdir()\\n461\\t    (root / \\\"attavo.toml\\\").write_text('[paths]\\\\nrecords = \\\"records\\\"\\\\n')\\n462\\t    init_repo(root, \\\"install\\\")\\n463\\t\\n464\\t    (root / \\\"pre1.txt\\\").write_text(\\\"1\\\\n\\\")\\n465\\t    commit_all(root, \\\"a change committed straight to main\\\")\\n466\\t    (root / \\\"pre2.txt\\\").write_text(\\\"2\\\\n\\\")\\n467\\t    commit_all(root, \\\"another change committed straight to main\\\")\\n468\\t\\n469\\t    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"-b\\\", \\\"attavo/1-x\\\"], check=True)\\n470\\t    records = root / \\\"records\\\" / \\\"1\\\"\\n471\\t    records.mkdir(parents=True)\\n472\\t    (records / \\\"spec-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\"}))\\n473\\t    commit_all(root, \\\"spec record for item 1\\\")\\n474\\t    branch_sha = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"rev-parse\\\", \\\"HEAD\\\"],\\n475\\t                                capture_output=True, text=True, check=True).stdout.strip()\\n476\\t    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"main\\\"], check=True)\\n477\\t    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"merge\\\", \\\"--no-ff\\\", \\\"-m\\\",\\n478\\t                    \\\"Merge branch 'attavo/1-x'\\\", \\\"attavo/1-x\\\"], check=True)\\n479\\t    merge_sha = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"rev-parse\\\", \\\"HEAD\\\"],\\n480\\t                               capture_output=True, text=True, check=True).stdout.strip()\\n481\\t    return root, merge_sha, branch_sha\\n482\\t\\n483\\t\\n484\\tdef _declare_doctor_from(root: Path, from_sha: str) -> None:\\n485\\t    \\\"\\\"\\\"Names [doctor] from via its own merge, not a direct commit to\\n486\\t    main -- declaring the window must never itself read as an unrecorded\\n487\\t    commit inside it.\\\"\\\"\\\"\\n488\\t    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"-b\\\", \\\"declare-window\\\"], check=True)\\n489\\t    toml = root / \\\"attavo.toml\\\"\\n490\\t    toml.write_text(toml.read_text() + f'\\\\n[doctor]\\\\nfrom = \\\"{from_sha}\\\"\\\\n')\\n491\\t    commit_all(root, \\\"declare the doctor's window\\\")\\n492\\t    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"main\\\"], check=True)\\n493\\t    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"merge\\\", \\\"--no-ff\\\", \\\"-m\\\",\\n494\\t                    \\\"Merge branch 'declare-window'\\\", \\\"declare-window\\\"], check=True)\\n495\\t\\n496\\t\\n497\\tdef test_proof_three_holds_reporting_before_the_window_with_doctor_from(tmp_path: Path) -> None:\\n498\\t    \\\"\\\"\\\"Acceptance row 4, issue #74. [doctor] from names the item merge:\\n499\\t    the two commits made straight to main before it fall before the\\n500\\t    window, not into unrecorded -- proof three holds, `before the\\n501\\t    window: 2`, and the window's own counts, 1 recorded (the item merge)\\n502\\t    and 1 ordinary (the merge that declares the window itself).\\\"\\\"\\\"\\n503\\t    root, merge_sha, _ = _window_fixture(tmp_path, \\\"window_holds\\\")\\n504\\t    _declare_doctor_from(root, merge_sha)\\n505\\t\\n506\\t    p = run_doctor(root)[\\\"no-commit-lacks-record\\\"]\\n507\\t    assert p[\\\"holds\\\"], p[\\\"reason\\\"]\\n508\\t    assert \\\"before the window: 2\\\" in p[\\\"reason\\\"]\\n509\\t    assert \\\"1 recorded, 1 ordinary, 0 unrecorded\\\" in p[\\\"reason\\\"]\\n510\\t    assert p[\\\"before_window\\\"] == 2\\n511\\t\\n512\\t\\n513\\tdef test_proof_three_holds_when_doctor_from_names_a_seven_character_prefix(tmp_path: Path) -> None:\\n514\\t    \\\"\\\"\\\"Acceptance row 5 (amendment), issue #74. [doctor] from need not be\\n515\\t    a full sha -- any spelling git rev-parse --verify resolves is\\n516\\t    accepted, resolved before the first-parent check runs. A\\n517\\t    seven-character prefix of the item merge holds with the same counts\\n518\\t    as the full-sha case.\\\"\\\"\\\"\\n519\\t    root, merge_sha, _ = _window_fixture(tmp_path, \\\"window_holds_short_sha\\\")\\n520\\t    _declare_doctor_from(root, merge_sha[:7])\\n521\\t\\n522\\t    p = run_doctor(root)[\\\"no-commit-lacks-record\\\"]\\n523\\t    assert p[\\\"holds\\\"], p[\\\"reason\\\"]\\n524\\t    assert \\\"before the window: 2\\\" in p[\\\"reason\\\"]\\n525\\t    assert \\\"1 recorded, 1 ordinary, 0 unrecorded\\\" in p[\\\"reason\\\"]\\n526\\t    assert p[\\\"before_window\\\"] == 2\\n527\\t\\n528\\t\\n529\\tdef test_proof_three_fails_naming_the_key_when_doctor_from_is_off_the_first_parent_line(tmp_path: Path) -> None:\\n530\\t    \\\"\\\"\\\"Acceptance row 5, issue #74. [doctor] from names the item branch's\\n531\\t    own commit -- reachable only as a merge's second parent, never on\\n532\\t    main's first-parent line -- proof three fails naming the key rather\\n533\\t    than silently falling back to the install commit.\\\"\\\"\\\"\\n534\\t    root, _, branch_sha = _window_fixture(tmp_path, \\\"window_off_line\\\")\\n535\\t    _declare_doctor_from(root, branch_sha)\\n536\\t\\n537\\t    p = run_doctor(root)[\\\"no-commit-lacks-record\\\"]\\n538\\t    assert not p[\\\"holds\\\"]\\n539\\t    assert \\\"[doctor] from\\\" in p[\\\"reason\\\"]\\n540\\t    assert branch_sha[:12] in p[\\\"reason\\\"]\\n541\\t\\n542\\t\\n543\\tdef test_proof_three_defaults_to_the_install_commit_when_doctor_key_is_absent(tmp_path: Path) -> None:\\n544\\t    \\\"\\\"\\\"Acceptance row 6, issue #74. No [doctor] table at all: the window\\n545\\t    defaults to the install commit exactly as before this issue -- both\\n546\\t    commits made straight to main are still read as unrecorded, and\\n547\\t    before_window is 0 -- the read every existing proof-three test\\n548\\t    exercises is unaffected by the key's addition.\\\"\\\"\\\"\\n549\\t    root, _merge_sha, _branch_sha = _window_fixture(tmp_path, \\\"window_absent\\\")\\n550\\t\\n551\\t    p = run_doctor(root)[\\\"no-commit-lacks-record\\\"]\\n552\\t    assert not p[\\\"holds\\\"]\\n553\\t    assert \\\"1 recorded, 0 ordinary, 2 unrecorded\\\" in p[\\\"reason\\\"]\\n554\\t    assert \\\"before the window: 0\\\" in p[\\\"reason\\\"]\\n555\\t    assert p[\\\"before_window\\\"] == 0\\n556\\t\\n557\\t\\n558\\tdef test_doctor_proof_one_refuses_a_gate_with_empty_retires(tmp_path: Path) -> None:\\n559\\t    \\\"\\\"\\\"Residual, issue #54 -- proposed, not yet ruled on: a gate that\\n560\\t    retires nothing only adds. The manifest schema has required\\n561\\t    [gates.<name>].retires to be non-empty since Phase 1, but read_manifest\\n562\\t    never validates against that schema, so nothing enforced it at\\n563\\t    runtime until this proof read it directly.\\\"\\\"\\\"\\n564\\t    root = tmp_path / \\\"empty_retires\\\"\\n565\\t    root.mkdir()\\n566\\t    (root / \\\"attavo.toml\\\").write_text(\\n567\\t        '[paths]\\\\nrejections = \\\"rejections\\\"\\\\n\\\\n'\\n568\\t        '[gates.spec]\\\\ncommand = \\\"false\\\"\\\\nretires = []\\\\n')\\n569\\t    (root / \\\"rejections\\\" / \\\"spec\\\").mkdir(parents=True)\\n570\\t    init_repo(root, \\\"install\\\")\\n571\\t\\n572\\t    p = run_doctor(root)[\\\"every-gate-rejects\\\"]\\n573\\t    assert not p[\\\"holds\\\"]\\n574\\t    assert \\\"retires\\\" in p[\\\"reason\\\"] and \\\"spec\\\" in p[\\\"reason\\\"]\\n575\\t\\n576\\t\\n577\\tdef test_doctor_proof_one_runs_the_gate_without_an_item_argument(tmp_path: Path) -> None:\\n578\\t    \\\"\\\"\\\"Issue #7, and its regression test. [gates.spec].command is a bare\\n579\\t    `attavo spec-gate`, no item argument, and its rejections/spec/ fixture\\n580\\t    carries no attavo/N-* branch at all (init_repo leaves it on `main`) --\\n581\\t    so before the doctor exported the fixture's item as ATTAVO_ITEM, the\\n582\\t    gate command would exit 2 (cannot derive item id) without ever writing\\n583\\t    a record, which still counts as \\\"rejected\\\" but proves nothing about the\\n584\\t    prose criterion this fixture means to test.\\n585\\t\\n586\\t    Red at the merge base: no ATTAVO_ITEM export existed, so no\\n587\\t    spec-01.json was ever written and reading it raised FileNotFoundError.\\n588\\t    Green once the doctor exports it: the record exists and names the\\n589\\t    prose criterion by name, which is the actual thing proof one asserts.\\n590\\t    \\\"\\\"\\\"\\n591\\t    outer = tmp_path / \\\"gate_rejection\\\"\\n592\\t    shutil.copytree(FIXTURES / \\\"gate_rejection\\\", outer)\\n593\\t    cmd = f\\\"{sys.executable} {ATTAVO}\\\"\\n594\\t    toml = outer / \\\"attavo.toml\\\"\\n595\\t    toml.write_text(toml.read_text().replace(\\\"ATTAVO_CMD\\\", cmd))\\n596\\t    init_repo(outer / \\\"rejections\\\" / \\\"spec\\\")\\n597\\t\\n598\\t    p = run_doctor(outer)[\\\"every-gate-rejects\\\"]\\n599\\t    assert p[\\\"holds\\\"], p[\\\"reason\\\"]\\n600\\t\\n601\\t    record = json.loads(\\n602\\t        (outer / \\\"rejections\\\" / \\\"spec\\\" / \\\"records\\\" / \\\"1\\\" / \\\"spec-01.json\\\").read_text())\\n603\\t    assert record[\\\"refusal\\\"] == \\\"criterion is prose: missing.sh\\\"\\n604\\t\\n605\\t\\n606\\tdef test_doctor_proof_four_fails_on_a_failed_record_with_no_stop(tmp_path: Path) -> None:\\n607\\t    \\\"\\\"\\\"Acceptance row 1, issue #94: a failed build record at\\n608\\t    record_version 3 with a two-line log and no stop at all -- a stop\\n609\\t    the product forgot to write, the way tenant zero's #576 build-11\\n610\\t    (before record_version 3 existed) was diagnosed only by a person\\n611\\t    rerunning it by hand. Fails today: no proof four exists.\\\"\\\"\\\"\\n612\\t    root = make_tenant(tmp_path, \\\"no_stop_lacks_cause\\\")\\n613\\t\\n614\\t    p = run_doctor(root)[\\\"no-stop-lacks-cause\\\"]\\n615\\t    assert not p[\\\"holds\\\"]\\n616\\t    assert \\\"build-01\\\" in p[\\\"reason\\\"]\\n617\\t    assert \\\"no stop\\\" in p[\\\"reason\\\"]\\n618\\t\\n619\\t\\n620\\tdef test_doctor_proof_four_holds_on_a_fixture_with_stop_and_gates_heading(tmp_path: Path) -> None:\\n621\\t    \\\"\\\"\\\"Acceptance row 2, issue #94: a failed build record whose stop is\\n622\\t    present and valid, and whose log carries the gates heading since\\n623\\t    gates actually ran (selected_tests is set) -- proof four holds.\\\"\\\"\\\"\\n624\\t    root = tmp_path / \\\"stop_holds\\\"\\n625\\t    root.mkdir()\\n626\\t    (root / \\\"attavo.toml\\\").write_text('[paths]\\\\nrecords = \\\"records\\\"\\\\n')\\n627\\t    init_repo(root, \\\"install\\\")\\n628\\t\\n629\\t    records = root / \\\"records\\\" / \\\"1\\\"\\n630\\t    records.mkdir(parents=True)\\n631\\t    build = {\\n632\\t        \\\"status\\\": \\\"failed\\\", \\\"record_version\\\": 3,\\n633\\t        \\\"selected_tests\\\": {\\\"select\\\": \\\"cat\\\", \\\"run\\\": \\\"cat\\\", \\\"count\\\": 1, \\\"exit\\\": 1},\\n634\\t        \\\"stop\\\": {\\\"class\\\": \\\"unclassed\\\", \\\"provenance\\\": \\\"product\\\", \\\"detail\\\": \\\"1 failed, 0 passed\\\"},\\n635\\t    }\\n636\\t    (records / \\\"build-01.json\\\").write_text(json.dumps(build))\\n637\\t    (records / \\\"build-01.log\\\").write_text(\\n638\\t        \\\"--- attavo gates, iteration 1 ---\\\\ncriterion x: exit 1\\\\n1 failed, 0 passed\\\")\\n639\\t    commit_all(root, \\\"a failed build record with a proper stop and gates heading\\\")\\n640\\t\\n641\\t    p = run_doctor(root)[\\\"no-stop-lacks-cause\\\"]\\n642\\t    assert p[\\\"holds\\\"], p[\\\"reason\\\"]\\n643\\t\\n644\\t\\n645\\tdef test_doctor_proof_four_reports_older_records_mixing_versions_2_and_3(tmp_path: Path) -> None:\\n646\\t    \\\"\\\"\\\"Acceptance row 3, issue #94: a record_version 2 record predates\\n647\\t    stop by construction (proof three's own window lesson) and is\\n648\\t    counted, never refused; a record_version 3 record alongside it is\\n649\\t    checked as usual. Proof four holds, reporting the older count.\\\"\\\"\\\"\\n650\\t    root = tmp_path / \\\"mixed_versions\\\"\\n651\\t    root.mkdir()\\n652\\t    (root / \\\"attavo.toml\\\").write_text('[paths]\\\\nrecords = \\\"records\\\"\\\\n')\\n653\\t    init_repo(root, \\\"install\\\")\\n654\\t\\n655\\t    records = root / \\\"records\\\" / \\\"1\\\"\\n656\\t    records.mkdir(parents=True)\\n657\\t    (records / \\\"build-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"failed\\\", \\\"record_version\\\": 2}))\\n658\\t    (records / \\\"verify-01.json\\\").write_text(json.dumps({\\n659\\t        \\\"status\\\": \\\"returned\\\", \\\"record_version\\\": 3,\\n660\\t        \\\"stop\\\": {\\\"class\\\": \\\"forge-unconcluded\\\", \\\"provenance\\\": \\\"tenant\\\", \\\"detail\\\": None}}))\\n661\\t    commit_all(root, \\\"one older record before stop, one current record with a stop\\\")\\n662\\t\\n663\\t    p = run_doctor(root)[\\\"no-stop-lacks-cause\\\"]\\n664\\t    assert p[\\\"holds\\\"], p[\\\"reason\\\"]\\n665\\t    assert \\\"1 record(s) before stop was recorded\\\" in p[\\\"reason\\\"]\\n666\\t    assert p[\\\"older_records\\\"] == 1\\n667\\t\\n668\\t\\n669\\tdef test_doctor_proof_four_holds_with_no_non_pass_records_to_check(tmp_path: Path) -> None:\\n670\\t    \\\"\\\"\\\"A tenant found on a real v0.16.3 pin: no non-pass build or verify\\n671\\t    record at record_version 3 or later exists to check -- every item\\n672\\t    passed. The clause is \\\"every failed or refused record carries its\\n673\\t    cause\\\", which holds vacuously on an empty set, the way proof three\\n674\\t    holds when nothing is unrecorded. Proof four must hold, reporting\\n675\\t    0 checked and the older-record count, not fail the tenant for having\\n676\\t    nothing to check.\\\"\\\"\\\"\\n677\\t    root = tmp_path / \\\"all_pass\\\"\\n678\\t    root.mkdir()\\n679\\t    (root / \\\"attavo.toml\\\").write_text('[paths]\\\\nrecords = \\\"records\\\"\\\\n')\\n680\\t    init_repo(root, \\\"install\\\")\\n681\\t\\n682\\t    records = root / \\\"records\\\" / \\\"1\\\"\\n683\\t    records.mkdir(parents=True)\\n684\\t    (records / \\\"build-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"failed\\\", \\\"record_version\\\": 2}))\\n685\\t    (records / \\\"verify-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\", \\\"record_version\\\": 3}))\\n686\\t    commit_all(root, \\\"one older record before stop, one current record that passed\\\")\\n687\\t\\n688\\t    p = run_doctor(root)[\\\"no-stop-lacks-cause\\\"]\\n689\\t    assert p[\\\"holds\\\"], p[\\\"reason\\\"]\\n690\\t    assert \\\"0 checked\\\" in p[\\\"reason\\\"]\\n691\\t    assert \\\"1 record(s) before stop was recorded\\\" in p[\\\"reason\\\"]\\n692\\t    assert p[\\\"older_records\\\"] == 1\\n693\\t\\n694\\t\\n695\\tdef test_doctor_proof_four_fails_when_gates_ran_but_the_log_lacks_their_heading(tmp_path: Path) -> None:\\n696\\t    \\\"\\\"\\\"Issue #94's own proposed fix: a failed build whose selected_tests\\n697\\t    is set -- gates definitely ran that iteration -- but whose log\\n698\\t    carries no gates heading at all. Tenant zero's #659 build-01 was\\n699\\t    exactly this before issue #89's own fix landed: the gate output that\\n700\\t    failed it lived only in a temporary directory the product deleted.\\\"\\\"\\\"\\n701\\t    root = tmp_path / \\\"missing_gates_heading\\\"\\n702\\t    root.mkdir()\\n703\\t    (root / \\\"attavo.toml\\\").write_text('[paths]\\\\nrecords = \\\"records\\\"\\\\n')\\n704\\t    init_repo(root, \\\"install\\\")\\n705\\t\\n706\\t    records = root / \\\"records\\\" / \\\"1\\\"\\n707\\t    records.mkdir(parents=True)\\n708\\t    build = {\\n709\\t        \\\"status\\\": \\\"failed\\\", \\\"record_version\\\": 3,\\n710\\t        \\\"selected_tests\\\": {\\\"select\\\": \\\"cat\\\", \\\"run\\\": \\\"cat\\\", \\\"count\\\": 1, \\\"exit\\\": 1},\\n711\\t        \\\"stop\\\": {\\\"class\\\": \\\"unclassed\\\", \\\"provenance\\\": \\\"product\\\", \\\"detail\\\": \\\"1 failed, 0 passed\\\"},\\n712\\t    }\\n713\\t    (records / \\\"build-01.json\\\").write_text(json.dumps(build))\\n714\\t    (records / \\\"build-01.log\\\").write_text(\\\"1 failed, 0 passed\\\")\\n715\\t    commit_all(root, \\\"a failed build with gates run but no gates heading in the log\\\")\\n716\\t\\n717\\t    p = run_doctor(root)[\\\"no-stop-lacks-cause\\\"]\\n718\\t    assert not p[\\\"holds\\\"]\\n719\\t    assert \\\"gates heading\\\" in p[\\\"reason\\\"]\\n720\\t\\n721\\t\\n722\\tdef test_doctor_proof_four_fails_when_a_log_ends_in_an_adapter_exit_after_only_event_lines(\\n723\\t        tmp_path: Path) -> None:\\n724\\t    \\\"\\\"\\\"Issue #94's own proposed fix, tenant zero's #659 verify-01\\n725\\t    specimen: a log whose last line is a bare adapter-exit marker with\\n726\\t    nothing before it but the adapter's own JSON event stream -- the\\n727\\t    tool's real error line never reached it (issue #86's own\\n728\\t    split_adapter_stdout bug, now guarded against at read time too).\\\"\\\"\\\"\\n729\\t    root = tmp_path / \\\"owed_tool_error\\\"\\n730\\t    root.mkdir()\\n731\\t    (root / \\\"attavo.toml\\\").write_text('[paths]\\\\nrecords = \\\"records\\\"\\\\n')\\n732\\t    init_repo(root, \\\"install\\\")\\n733\\t\\n734\\t    records = root / \\\"records\\\" / \\\"1\\\"\\n735\\t    records.mkdir(parents=True)\\n736\\t    verify = {\\n737\\t        \\\"status\\\": \\\"failed\\\", \\\"record_version\\\": 3,\\n738\\t        \\\"stop\\\": {\\\"class\\\": \\\"unclassed\\\", \\\"provenance\\\": \\\"product\\\", \\\"detail\\\": \\\"[adapter exited 1]\\\"},\\n739\\t    }\\n740\\t    (records / \\\"verify-01.json\\\").write_text(json.dumps(verify))\\n741\\t    (records / \\\"verify-01.log\\\").write_text(\\n742\\t        '{\\\"type\\\":\\\"thread.started\\\",\\\"thread_id\\\":\\\"x\\\"}\\\\n[adapter exited 1]')\\n743\\t    commit_all(root, \\\"a failed verify whose tool error line was dropped\\\")\\n744\\t\\n745\\t    p = run_doctor(root)[\\\"no-stop-lacks-cause\\\"]\\n746\\t    assert not p[\\\"holds\\\"]\\n747\\t    assert \\\"tool's own error line is owed\\\" in p[\\\"reason\\\"]\\n748\\t\\n749\\t\\n750\\tdef test_proof_four_reads_an_error_event_as_the_tools_own_words(tmp_path: Path) -> None:\\n751\\t    \\\"\\\"\\\"Issue #200: a review the vendor refused (\\\"Selected model is at\\n752\\t    capacity\\\") logs the tool's own error as an `error` event, then the\\n753\\t    exit marker. The cause is in the log, in the tool's words, so proof\\n754\\t    four does not owe a line. An `error` event with an empty or missing\\n755\\t    message says nothing and still owes it.\\\"\\\"\\\"\\n756\\t    event_lines = ('{\\\"type\\\":\\\"thread.started\\\",\\\"thread_id\\\":\\\"x\\\"}\\\\n'\\n757\\t                   '{\\\"type\\\":\\\"turn.started\\\"}\\\\n')\\n758\\t    exit_line = \\\"[adapter exited 1]\\\"\\n759\\t    verify = {\\n760\\t        \\\"status\\\": \\\"failed\\\", \\\"record_version\\\": 3,\\n761\\t        \\\"stop\\\": {\\\"class\\\": \\\"unclassed\\\", \\\"provenance\\\": \\\"product\\\", \\\"detail\\\": exit_line},\\n762\\t    }\\n763\\t    cases = {\\n764\\t        \\\"with_message\\\": (\\n765\\t            '{\\\"type\\\":\\\"error\\\",\\\"message\\\":\\\"Selected model is at capacity. '\\n766\\t            'Please try a different model.\\\"}\\\\n', True),\\n767\\t        \\\"empty_message\\\": ('{\\\"type\\\":\\\"error\\\",\\\"message\\\":\\\"\\\"}\\\\n', False),\\n768\\t        \\\"missing_message\\\": ('{\\\"type\\\":\\\"error\\\"}\\\\n', False),\\n769\\t    }\\n770\\t    for name, (error_line, holds) in cases.items():\\n771\\t        root = tmp_path / name\\n772\\t        root.mkdir()\\n773\\t        (root / \\\"attavo.toml\\\").write_text('[paths]\\\\nrecords = \\\"records\\\"\\\\n')\\n774\\t        init_repo(root, \\\"install\\\")\\n775\\t\\n776\\t        records = root / \\\"records\\\" / \\\"1\\\"\\n777\\t        records.mkdir(parents=True)\\n778\\t        (records / \\\"verify-01.json\\\").write_text(json.dumps(verify))\\n779\\t        (records / \\\"verify-01.log\\\").write_text(event_lines + error_line + exit_line)\\n780\\t        commit_all(root, f\\\"a failed verify whose log has an error event: {name}\\\")\\n781\\t\\n782\\t        p = run_doctor(root)[\\\"no-stop-lacks-cause\\\"]\\n783\\t        assert p[\\\"holds\\\"] is holds, (name, p[\\\"reason\\\"])\\n784\\t        if not holds:\\n785\\t            assert \\\"tool's own error line is owed\\\" in p[\\\"reason\\\"], name\\n786\\t\\n787\\t\\n788\\tdef test_doctor_proof_four_fails_on_an_unclassed_stop_with_no_detail(tmp_path: Path) -> None:\\n789\\t    \\\"\\\"\\\"An unclassed stop's whole contract is its detail (issue #89):\\n790\\t    with none, the record is exactly as unexplained as no stop at all.\\\"\\\"\\\"\\n791\\t    root = tmp_path / \\\"unclassed_no_detail\\\"\\n792\\t    root.mkdir()\\n793\\t    (root / \\\"attavo.toml\\\").write_text('[paths]\\\\nrecords = \\\"records\\\"\\\\n')\\n794\\t    init_repo(root, \\\"install\\\")\\n795\\t\\n796\\t    records = root / \\\"records\\\" / \\\"1\\\"\\n797\\t    records.mkdir(parents=True)\\n798\\t    build = {\\\"status\\\": \\\"failed\\\", \\\"record_version\\\": 3,\\n799\\t            \\\"stop\\\": {\\\"class\\\": \\\"unclassed\\\", \\\"provenance\\\": \\\"product\\\", \\\"detail\\\": None}}\\n800\\t    (records / \\\"build-01.json\\\").write_text(json.dumps(build))\\n801\\t    commit_all(root, \\\"an unclassed stop with no detail\\\")\\n802\\t\\n803\\t    p = run_doctor(root)[\\\"no-stop-lacks-cause\\\"]\\n804\\t    assert not p[\\\"holds\\\"]\\n805\\t    assert \\\"unclassed with no detail\\\" in p[\\\"reason\\\"]\\n806\\t\\n807\\t\\n808\\tFULL_DRIVE_TABLE = ('[drive]\\\\nstall_after_s = 60\\\\nattempts = 3\\\\n\\\\n'\\n809\\t                    '[drive.build]\\\\nceiling_s = 600\\\\n\\\\n[drive.verify]\\\\nceiling_s = 600\\\\n')\\n810\\t\\n811\\t\\n812\\tdef _dead_pid() -> int:\\n813\\t    \\\"\\\"\\\"A pid guaranteed not to be running: a real child, spawned and\\n814\\t    reaped, on this host.\\\"\\\"\\\"\\n815\\t    proc = subprocess.Popen([sys.executable, \\\"-c\\\", \\\"pass\\\"])\\n816\\t    proc.wait()\\n817\\t    return proc.pid\\n818\\t\\n819\\t\\n820\\tdef test_doctor_proof_five_fails_on_a_dead_invocation_with_no_record(tmp_path: Path) -> None:\\n821\\t    \\\"\\\"\\\"Issue #151: a build-01.started marker naming a dead pid on this\\n822\\t    host, with no build-01.json to retire it, is exactly the silence two\\n823\\t    build attempts of item #148 left behind -- proof five names it.\\\"\\\"\\\"\\n824\\t    root = tmp_path / \\\"dead_invocation\\\"\\n825\\t    root.mkdir()\\n826\\t    (root / \\\"attavo.toml\\\").write_text('[paths]\\\\nrecords = \\\"records\\\"\\\\n\\\\n' + FULL_DRIVE_TABLE)\\n827\\t    init_repo(root, \\\"install\\\")\\n828\\t\\n829\\t    records = root / \\\"records\\\" / \\\"1\\\"\\n830\\t    records.mkdir(parents=True)\\n831\\t    (records / \\\"build-01.started\\\").write_text(json.dumps({\\n832\\t        \\\"at\\\": \\\"2026-09-17T13:16:08Z\\\", \\\"host\\\": socket.gethostname(), \\\"pid\\\": _dead_pid(),\\n833\\t        \\\"sha\\\": \\\"0\\\" * 40, \\\"product_version\\\": \\\"fixture\\\"}))\\n834\\t    commit_all(root, \\\"invocation marker for item 1\\\")\\n835\\t\\n836\\t    p = run_doctor(root)[\\\"no-invocation-lacks-record\\\"]\\n837\\t    assert not p[\\\"holds\\\"]\\n838\\t    assert \\\"build-01\\\" in p[\\\"reason\\\"] and \\\"never wrote its record\\\" in p[\\\"reason\\\"]\\n839\\t\\n840\\t\\n841\\tdef test_doctor_proof_five_holds_once_the_record_arrives(tmp_path: Path) -> None:\\n842\\t    \\\"\\\"\\\"The same marker, retired by its own build-01.json: proof five\\n843\\t    holds -- the record's arrival is what retires a marker, not its\\n844\\t    removal.\\\"\\\"\\\"\\n845\\t    root = tmp_path / \\\"recorded_invocation\\\"\\n846\\t    root.mkdir()\\n847\\t    (root / \\\"attavo.toml\\\").write_text('[paths]\\\\nrecords = \\\"records\\\"\\\\n\\\\n' + FULL_DRIVE_TABLE)\\n848\\t    init_repo(root, \\\"install\\\")\\n849\\t\\n850\\t    records = root / \\\"records\\\" / \\\"1\\\"\\n851\\t    records.mkdir(parents=True)\\n852\\t    (records / \\\"build-01.started\\\").write_text(json.dumps({\\n853\\t        \\\"at\\\": \\\"2026-09-17T13:16:08Z\\\", \\\"host\\\": socket.gethostname(), \\\"pid\\\": _dead_pid(),\\n854\\t        \\\"sha\\\": \\\"0\\\" * 40, \\\"product_version\\\": \\\"fixture\\\"}))\\n855\\t    (records / \\\"build-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\"}))\\n856\\t    commit_all(root, \\\"invocation marker and its record for item 1\\\")\\n857\\t\\n858\\t    p = run_doctor(root)[\\\"no-invocation-lacks-record\\\"]\\n859\\t    assert p[\\\"holds\\\"], p[\\\"reason\\\"]\\n860\\t\\n861\\t\\n862\\tdef test_doctor_proof_five_reports_a_live_invocation_as_running_not_failed(tmp_path: Path) -> None:\\n863\\t    \\\"\\\"\\\"A marker naming this test's own pid, on this host, with no\\n864\\t    record: alive, so proof five holds and names it running rather than\\n865\\t    failing the tenant for a drive that has not had the chance to finish\\n866\\t    yet.\\\"\\\"\\\"\\n867\\t    root = tmp_path / \\\"live_invocation\\\"\\n868\\t    root.mkdir()\\n869\\t    (root / \\\"attavo.toml\\\").write_text('[paths]\\\\nrecords = \\\"records\\\"\\\\n\\\\n' + FULL_DRIVE_TABLE)\\n870\\t    init_repo(root, \\\"install\\\")\\n871\\t\\n872\\t    records = root / \\\"records\\\" / \\\"1\\\"\\n873\\t    records.mkdir(parents=True)\\n874\\t    (records / \\\"build-01.started\\\").write_text(json.dumps({\\n875\\t        \\\"at\\\": \\\"2026-09-17T13:16:08Z\\\", \\\"host\\\": socket.gethostname(), \\\"pid\\\": os.getpid(),\\n876\\t        \\\"sha\\\": \\\"0\\\" * 40, \\\"product_version\\\": \\\"fixture\\\"}))\\n877\\t    commit_all(root, \\\"invocation marker for a still-running invocation\\\")\\n878\\t\\n879\\t    p = run_doctor(root)[\\\"no-invocation-lacks-record\\\"]\\n880\\t    assert p[\\\"holds\\\"], p[\\\"reason\\\"]\\n881\\t    assert len(p[\\\"running_invocations\\\"]) == 1\\n882\\t    assert \\\"build-01\\\" in p[\\\"running_invocations\\\"][0]\\n883\\t\\n884\\t\\n885\\tdef test_doctor_proof_five_fails_without_stall_after_s_in_the_manifest(tmp_path: Path) -> None:\\n886\\t    \\\"\\\"\\\"A tenant with no [drive].stall_after_s carries no bound past which\\n887\\t    a live invocation is hung -- proof five cannot tell a hung drive from\\n888\\t    a running one, and refuses to guess a default.\\\"\\\"\\\"\\n889\\t    root = tmp_path / \\\"no_stall_bound\\\"\\n890\\t    root.mkdir()\\n891\\t    (root / \\\"attavo.toml\\\").write_text('[paths]\\\\nrecords = \\\"records\\\"\\\\n')\\n892\\t    init_repo(root, \\\"install\\\")\\n893\\t\\n894\\t    records = root / \\\"records\\\" / \\\"1\\\"\\n895\\t    records.mkdir(parents=True)\\n896\\t    (records / \\\"build-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\"}))\\n897\\t    commit_all(root, \\\"a record with no [drive].stall_after_s declared\\\")\\n898\\t\\n899\\t    p = run_doctor(root)[\\\"no-invocation-lacks-record\\\"]\\n900\\t    assert not p[\\\"holds\\\"]\\n901\\t    assert \\\"stall_after_s\\\" in p[\\\"reason\\\"]\\n902\\t\\n903\\t\\n904\\tdef test_doctor_refuses_a_drive_table_without_ceilings(tmp_path: Path) -> None:\\n905\\t    \\\"\\\"\\\"R3: a [drive] table that declares a stall bound and no\\n906\\t    [drive.build].ceiling_s or [drive.verify].ceiling_s carries no bound\\n907\\t    past which a live stage is hung by wall clock -- proof five refuses\\n908\\t    to guess one, as it refuses to guess the stall bound.\\\"\\\"\\\"\\n909\\t    root = tmp_path / \\\"no_ceilings\\\"\\n910\\t    root.mkdir()\\n911\\t    (root / \\\"attavo.toml\\\").write_text(\\n912\\t        '[paths]\\\\nrecords = \\\"records\\\"\\\\n\\\\n[drive]\\\\nstall_after_s = 60\\\\nattempts = 3\\\\n')\\n913\\t    init_repo(root, \\\"install\\\")\\n914\\t\\n915\\t    records = root / \\\"records\\\" / \\\"1\\\"\\n916\\t    records.mkdir(parents=True)\\n917\\t    (records / \\\"build-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\"}))\\n918\\t    commit_all(root, \\\"a drive table with no ceilings\\\")\\n919\\t\\n920\\t    p = run_doctor(root)[\\\"no-invocation-lacks-record\\\"]\\n921\\t    assert not p[\\\"holds\\\"]\\n922\\t    assert \\\"ceiling\\\" in p[\\\"reason\\\"]\\n923\\t\\n924\\t\\n925\\tdef test_doctor_refuses_a_drive_table_without_attempts(tmp_path: Path) -> None:\\n926\\t    \\\"\\\"\\\"R3: a [drive] table with both ceilings and a stall bound but no\\n927\\t    [drive].attempts carries no bound on how many attempts a retryable\\n928\\t    stop may spend -- proof five refuses to guess a default here too.\\\"\\\"\\\"\\n929\\t    root = tmp_path / \\\"no_attempts\\\"\\n930\\t    root.mkdir()\\n931\\t    (root / \\\"attavo.toml\\\").write_text(\\n932\\t        '[paths]\\\\nrecords = \\\"records\\\"\\\\n\\\\n[drive]\\\\nstall_after_s = 60\\\\n\\\\n'\\n933\\t        '[drive.build]\\\\nceiling_s = 600\\\\n\\\\n[drive.verify]\\\\nceiling_s = 600\\\\n')\\n934\\t    init_repo(root, \\\"install\\\")\\n935\\t\\n936\\t    records = root / \\\"records\\\" / \\\"1\\\"\\n937\\t    records.mkdir(parents=True)\\n938\\t    (records / \\\"build-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\"}))\\n939\\t    commit_all(root, \\\"a drive table with no attempts budget\\\")\\n940\\t\\n941\\t    p = run_doctor(root)[\\\"no-invocation-lacks-record\\\"]\\n942\\t    assert not p[\\\"holds\\\"]\\n943\\t    assert \\\"attempts\\\" in p[\\\"reason\\\"]\\n944\\t\\n945\\t\\n946\\t# --- proof seven: no attested item is empty (item 227). Rejection tests,\\n947\\t# written red first against v0.29.0, whose doctor had six proofs and held\\n948\\t# over an attested item whose build committed nothing. ---\\n949\\t\\n950\\t\\n951\\tdef _head(root: Path) -> str:\\n952\\t    return subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"rev-parse\\\", \\\"HEAD\\\"], capture_output=True,\\n953\\t                          text=True, check=True).stdout.strip()\\n954\\t\\n955\\t\\n956\\tdef _four_stage_item(root: Path, approval_sha: str, *, change: bool) -> tuple[str, str]:\\n957\\t    \\\"\\\"\\\"One item, four records, merged --no-ff; returns (merge_sha, build_sha).\\n958\\t    change=True lands a real content commit before the records, so the\\n959\\t    tree genuinely differs from approval_sha outside records/; change=False\\n960\\t    leaves the tree exactly as approval_sha left it -- item 227's own\\n961\\t    build, and item 229's own fix for a retried attempt that adds no\\n962\\t    commit of its own but already carries one.\\\"\\\"\\\"\\n963\\t    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"-q\\\", \\\"-b\\\", \\\"attavo/1-x\\\"], check=True)\\n964\\t    if change:\\n965\\t        (root / \\\"changed.txt\\\").write_text(\\\"the item's own change\\\\n\\\")\\n966\\t        commit_all(root, \\\"the item's own change\\\")\\n967\\t    build_sha = _head(root)\\n968\\t    records = root / \\\"records\\\" / \\\"1\\\"\\n969\\t    records.mkdir(parents=True)\\n970\\t    (records / \\\"spec-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\"}))\\n971\\t    (records / \\\"approval-01.json\\\").write_text(json.dumps({\\\"approved_by\\\": \\\"alice\\\"}))\\n972\\t    (records / \\\"build-01.json\\\").write_text(json.dumps(\\n973\\t        {\\\"status\\\": \\\"pass\\\", \\\"sha\\\": build_sha, \\\"start_sha\\\": approval_sha,\\n974\\t         \\\"approval_sha\\\": approval_sha}))\\n975\\t    (records / \\\"verify-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\"}))\\n976\\t    commit_all(root, \\\"spec, approval, build, and verify records\\\")\\n977\\t    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"-q\\\", \\\"main\\\"], check=True)\\n978\\t    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"merge\\\", \\\"-q\\\", \\\"--no-ff\\\", \\\"-m\\\",\\n979\\t                    \\\"Merge branch 'attavo/1-x'\\\", \\\"attavo/1-x\\\"], check=True)\\n980\\t    return _head(root), build_sha\\n981\\t\\n982\\t\\n983\\tdef test_doctor_proof_seven_fails_on_an_attested_item_whose_build_committed_nothing(tmp_path: Path) -> None:\\n984\\t    root = tmp_path / \\\"empty_item\\\"\\n985\\t    root.mkdir()\\n986\\t    (root / \\\"attavo.toml\\\").write_text('[paths]\\\\nrecords = \\\"records\\\"\\\\n')\\n987\\t    init_repo(root, \\\"install\\\")\\n988\\t    approval_sha = _head(root)\\n989\\t    merge, _ = _four_stage_item(root, approval_sha, change=False)\\n990\\t    report = run_doctor(root)\\n991\\t    assert \\\"no-attested-item-is-empty\\\" in report, sorted(report)\\n992\\t    p = report[\\\"no-attested-item-is-empty\\\"]\\n993\\t    assert not p[\\\"holds\\\"], p\\n994\\t    assert \\\"item 1\\\" in p[\\\"reason\\\"] and \\\"nothing was built\\\" in p[\\\"reason\\\"] and merge[:12] in p[\\\"reason\\\"], p[\\\"reason\\\"]\\n995\\t\\n996\\t\\n997\\tdef test_doctor_proof_seven_holds_on_a_build_that_names_a_change_and_names_the_specimen_before_its_window(tmp_path: Path) -> None:\\n998\\t    built = tmp_path / \\\"built_item\\\"\\n999\\t    built.mkdir()\\n1000\\t    (built / \\\"attavo.toml\\\").write_text('[paths]\\\\nrecords = \\\"records\\\"\\\\n')\\n1001\\t    init_repo(built, \\\"install\\\")\\n1002\\t    _four_stage_item(built, _head(built), change=True)\\n1003\\t    p = run_doctor(built)[\\\"no-attested-item-is-empty\\\"]\\n1004\\t    assert p[\\\"holds\\\"], p[\\\"reason\\\"]\\n1005\\t    assert p[\\\"built\\\"] == [\\\"1\\\"], p\\n1006\\t\\n1007\\t    windowed = tmp_path / \\\"windowed_item\\\"\\n1008\\t    windowed.mkdir()\\n1009\\t    (windowed / \\\"attavo.toml\\\").write_text('[paths]\\\\nrecords = \\\"records\\\"\\\\n')\\n1010\\t    init_repo(windowed, \\\"install\\\")\\n1011\\t    approval_sha = _head(windowed)\\n1012\\t    merge, _ = _four_stage_item(windowed, approval_sha, change=False)\\n1013\\t    toml = windowed / \\\"attavo.toml\\\"\\n1014\\t    toml.write_text(toml.read_text() + f'\\\\n[doctor]\\\\nbuilt_since = \\\"{merge[:12]}\\\"\\\\n')\\n1015\\t    commit_all(windowed, \\\"declare the window after the specimen\\\")\\n1016\\t    p = run_doctor(windowed)[\\\"no-attested-item-is-empty\\\"]\\n1017\\t    assert p[\\\"holds\\\"], p[\\\"reason\\\"]\\n1018\\t    assert p[\\\"before_window\\\"] == [\\\"1\\\"] and \\\"before the window\\\" in p[\\\"reason\\\"], p\\n1019\\t\\n1020\\t\\n1021\\tdef test_doctor_proof_seven_treats_a_retried_attempt_that_adopts_a_prior_commit_as_not_empty(\\n1022\\t        tmp_path: Path) -> None:\\n1023\\t    \\\"\\\"\\\"Item 229: a build record whose sha equals its own start_sha is not\\n1024\\t    empty when that tree already differs from the approval -- a retried\\n1025\\t    attempt whose head already carries a prior attempt's valid commit\\n1026\\t    owes no commit of its own (item 227's own counsel question).\\\"\\\"\\\"\\n1027\\t    root = tmp_path / \\\"adopted_item\\\"\\n1028\\t    root.mkdir()\\n1029\\t    (root / \\\"attavo.toml\\\").write_text('[paths]\\\\nrecords = \\\"records\\\"\\\\n')\\n1030\\t    init_repo(root, \\\"install\\\")\\n1031\\t    approval_sha = _head(root)\\n1032\\t    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"-q\\\", \\\"-b\\\", \\\"attavo/1-x\\\"], check=True)\\n1033\\t    (root / \\\"changed.txt\\\").write_text(\\\"a prior attempt's own valid commit\\\\n\\\")\\n1034\\t    commit_all(root, \\\"a prior attempt's own valid commit\\\")\\n1035\\t    retry_start_sha = _head(root)\\n1036\\t    records = root / \\\"records\\\" / \\\"1\\\"\\n1037\\t    records.mkdir(parents=True)\\n1038\\t    (records / \\\"spec-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\"}))\\n1039\\t    (records / \\\"approval-01.json\\\").write_text(json.dumps({\\\"approved_by\\\": \\\"alice\\\"}))\\n1040\\t    (records / \\\"build-02.json\\\").write_text(json.dumps(\\n1041\\t        {\\\"status\\\": \\\"pass\\\", \\\"sha\\\": retry_start_sha, \\\"start_sha\\\": retry_start_sha,\\n1042\\t         \\\"approval_sha\\\": approval_sha}))\\n1043\\t    (records / \\\"verify-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\"}))\\n1044\\t    commit_all(root, \\\"spec, approval, build, and verify records\\\")\\n1045\\t    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"-q\\\", \\\"main\\\"], check=True)\\n1046\\t    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"merge\\\", \\\"-q\\\", \\\"--no-ff\\\", \\\"-m\\\",\\n1047\\t                    \\\"Merge branch 'attavo/1-x'\\\", \\\"attavo/1-x\\\"], check=True)\\n1048\\t    p = run_doctor(root)[\\\"no-attested-item-is-empty\\\"]\\n1049\\t    assert p[\\\"holds\\\"], p[\\\"reason\\\"]\\n1050\\t    assert p[\\\"built\\\"] == [\\\"1\\\"], p\\n1051\\t\\n1052\\t\\n1053\\tdef test_doctor_proof_seven_names_a_build_with_no_readable_approval_as_not_read(tmp_path: Path) -> None:\\n1054\\t    \\\"\\\"\\\"Item 229: a build record whose approval_sha does not resolve in this\\n1055\\t    repository is counted as not readable, not failed -- an unprovable\\n1056\\t    build is not asserted empty.\\\"\\\"\\\"\\n1057\\t    root = tmp_path / \\\"unreadable_item\\\"\\n1058\\t    root.mkdir()\\n1059\\t    (root / \\\"attavo.toml\\\").write_text('[paths]\\\\nrecords = \\\"records\\\"\\\\n')\\n1060\\t    init_repo(root, \\\"install\\\")\\n1061\\t    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"-q\\\", \\\"-b\\\", \\\"attavo/1-x\\\"], check=True)\\n1062\\t    build_sha = _head(root)\\n1063\\t    records = root / \\\"records\\\" / \\\"1\\\"\\n1064\\t    records.mkdir(parents=True)\\n1065\\t    (records / \\\"spec-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\"}))\\n1066\\t    (records / \\\"approval-01.json\\\").write_text(json.dumps({\\\"approved_by\\\": \\\"alice\\\"}))\\n1067\\t    (records / \\\"build-01.json\\\").write_text(json.dumps(\\n1068\\t        {\\\"status\\\": \\\"pass\\\", \\\"sha\\\": build_sha, \\\"start_sha\\\": build_sha, \\\"approval_sha\\\": \\\"f\\\" * 40}))\\n1069\\t    (records / \\\"verify-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\"}))\\n1070\\t    commit_all(root, \\\"spec, approval, build, and verify records\\\")\\n1071\\t    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"-q\\\", \\\"main\\\"], check=True)\\n1072\\t    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"merge\\\", \\\"-q\\\", \\\"--no-ff\\\", \\\"-m\\\",\\n1073\\t                    \\\"Merge branch 'attavo/1-x'\\\", \\\"attavo/1-x\\\"], check=True)\\n1074\\t    p = run_doctor(root)[\\\"no-attested-item-is-empty\\\"]\\n1075\\t    assert p[\\\"holds\\\"], p[\\\"reason\\\"]\\n1076\\t    assert p[\\\"not_read\\\"] == [\\\"1\\\"], p\\n1077\\t\\n1078\\t\\n1079\\tdef test_no_attested_item_is_empty() -> None:\\n1080\\t    \\\"\\\"\\\"Proof 7, item 227. On this repository the specimen, #227, is named\\n1081\\t    before the window ([doctor].built_since) and every later attested\\n1082\\t    item's build names a change.\\\"\\\"\\\"\\n1083\\t    p = run_doctor(ROOT)[\\\"no-attested-item-is-empty\\\"]\\n1084\\t    assert p[\\\"holds\\\"], p[\\\"reason\\\"]\\n1085\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"5a752ff7-c430-4cfd-9b9a-21883129b5e6\",\"uuid\":\"250201e1-c858-4d33-9f7b-9824ca6f64f9\",\"timestamp\":\"2026-09-27T20:32:13.100Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/davidbean/Projects/attavo-worktree-237/tests/test_doctor.py\",\"content\":\"\\\"\\\"\\\"The doctor's five proofs, as tests written before the capability.\\n\\nEach test asserts that one proof holds against this repository. All five\\nfail at the first commit and must fail: that is the definition of done,\\nstated before anything exists to satisfy it. A test here turns green only\\nwhen the capability it names has landed and been used for real.\\n\\nRun: python3 -m pytest tests -q\\n\\\"\\\"\\\"\\nimport json\\nimport os\\nimport shutil\\nimport socket\\nimport subprocess\\nimport sys\\nfrom pathlib import Path\\nfrom typing import Any\\n\\nimport pytest\\nfrom helpers import FIXTURES, commit_all, init_repo, make_tenant\\n\\nROOT = Path(__file__).resolve().parent.parent\\nATTAVO = ROOT / \\\"bin\\\" / \\\"attavo\\\"\\n\\n\\ndef run_doctor(root: Path) -> dict[str, Any]:\\n    out = subprocess.run([sys.executable, str(ATTAVO), \\\"doctor\\\", str(root), \\\"--json\\\"],\\n                         capture_output=True, text=True, check=False)\\n    report = json.loads(out.stdout)\\n    assert out.returncode == (0 if report[\\\"done\\\"] else 1)\\n    return {p[\\\"proof\\\"]: p for p in report[\\\"proofs\\\"]}\\n\\n\\ndef test_every_gate_rejects() -> None:\\n    \\\"\\\"\\\"Proof 1. Every gate in the manifest rejects its rejection fixture.\\n\\n    Holds when: a manifest exists, [gates] names at least one gate, each gate\\n    has a fixture under paths.rejections, and each gate exits non-zero on it.\\n    \\\"\\\"\\\"\\n    p = run_doctor(ROOT)[\\\"every-gate-rejects\\\"]\\n    assert p[\\\"holds\\\"], p[\\\"reason\\\"]\\n\\n\\ndef test_one_item_traversed_every_stage() -> None:\\n    \\\"\\\"\\\"Proof 2. One work item carries a record for spec, approval, build,\\n    verify, and attestation, every one written by a script.\\\"\\\"\\\"\\n    p = run_doctor(ROOT)[\\\"one-item-every-stage\\\"]\\n    assert p[\\\"holds\\\"], p[\\\"reason\\\"]\\n\\n\\ndef test_no_commit_lacks_a_record() -> None:\\n    \\\"\\\"\\\"Proof 3. Every commit on the default branch after the manifest was\\n    introduced is named by a record's sha or commits list.\\\"\\\"\\\"\\n    p = run_doctor(ROOT)[\\\"no-commit-lacks-record\\\"]\\n    assert p[\\\"holds\\\"], p[\\\"reason\\\"]\\n\\n\\ndef test_no_stop_lacks_cause() -> None:\\n    \\\"\\\"\\\"Proof 4, issue #94. Every non-pass build or verify record at\\n    record_version 3 or later carries a stop naming its class and cause.\\\"\\\"\\\"\\n    p = run_doctor(ROOT)[\\\"no-stop-lacks-cause\\\"]\\n    assert p[\\\"holds\\\"], p[\\\"reason\\\"]\\n\\n\\n@pytest.mark.own_records\\ndef test_no_invocation_lacks_record() -> None:\\n    \\\"\\\"\\\"Proof 5, issue #151. Every <stage>-NN.started marker under\\n    paths.records has arrived at its own <stage>-NN.json, or is still a\\n    live process on this host.\\\"\\\"\\\"\\n    p = run_doctor(ROOT)[\\\"no-invocation-lacks-record\\\"]\\n    assert p[\\\"holds\\\"], p[\\\"reason\\\"]\\n\\n\\ndef test_every_attested_item_is_sealed() -> None:\\n    \\\"\\\"\\\"Proof 5, issue #158. Every merged, fully-staged item has a\\n    statement in the forge's attestation store for its merge commit --\\n    #106, #148, #153 predate [forge].sealed_since and are named before the\\n    window instead.\\\"\\\"\\\"\\n    p = run_doctor(ROOT)[\\\"every-attested-item-is-sealed\\\"]\\n    assert p[\\\"holds\\\"], p[\\\"reason\\\"]\\n\\n\\ndef test_record_loader_uses_highest_attempt_number(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Acceptance 2a. <stage>-NN.json files are one stage's attempts; the\\n    doctor treats the highest NN as latest, and STAGES is unchanged.\\n\\n    spec-01.json names a commit that isn't on the branch at all; spec-02.json\\n    names the real code commit. Proof 3 holds only if the loader reads\\n    spec-02, not spec-01 -- i.e. only if it picks the highest attempt.\\n    \\\"\\\"\\\"\\n    root = tmp_path / \\\"attempts\\\"\\n    root.mkdir()\\n    (root / \\\"attavo.toml\\\").write_text('[paths]\\\\nrecords = \\\"records\\\"\\\\n')\\n    init_repo(root, \\\"install\\\")\\n\\n    (root / \\\"src.txt\\\").write_text(\\\"code\\\\n\\\")\\n    commit_all(root, \\\"code change\\\")\\n    code_sha = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"rev-parse\\\", \\\"HEAD\\\"],\\n                              capture_output=True, text=True, check=True).stdout.strip()\\n\\n    records = root / \\\"records\\\" / \\\"1\\\"\\n    records.mkdir(parents=True)\\n    (records / \\\"spec-01.json\\\").write_text(json.dumps({\\\"sha\\\": \\\"0\\\" * 40}))\\n    (records / \\\"spec-02.json\\\").write_text(json.dumps({\\\"sha\\\": code_sha}))\\n    commit_all(root, \\\"spec records\\\")\\n\\n    p = run_doctor(root)[\\\"no-commit-lacks-record\\\"]\\n    assert p[\\\"holds\\\"], p[\\\"reason\\\"]\\n\\n\\ndef test_doctor_proof_two_counts_three_of_four_stages_still_red(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Acceptance 8. A work item carrying spec, approval, and build records\\n    is three of the four STAGES proof two names; verify doesn't exist\\n    yet, so the proof stays red and names exactly that one as lacking.\\n    \\\"\\\"\\\"\\n    root = tmp_path / \\\"three_stages\\\"\\n    root.mkdir()\\n    (root / \\\"attavo.toml\\\").write_text('[paths]\\\\nrecords = \\\"records\\\"\\\\n')\\n    init_repo(root, \\\"install\\\")\\n\\n    records = root / \\\"records\\\" / \\\"1\\\"\\n    records.mkdir(parents=True)\\n    (records / \\\"spec-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\"}))\\n    (records / \\\"approval-01.json\\\").write_text(json.dumps({\\\"approved_by\\\": \\\"alice\\\"}))\\n    (records / \\\"build-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\"}))\\n    commit_all(root, \\\"spec, approval, and build records\\\")\\n\\n    p = run_doctor(root)[\\\"one-item-every-stage\\\"]\\n    assert not p[\\\"holds\\\"]\\n    assert \\\"verify\\\" in p[\\\"reason\\\"]\\n    assert \\\"build\\\" not in p[\\\"reason\\\"]\\n\\n\\ndef test_doctor_proof_two_holds_on_a_fixture_carrying_all_four_stages_merged(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Acceptance row 4, issue #69: attestation is retired as a record\\n    type -- STAGES is four stages, not five -- and proof two now also\\n    requires the four records to have reached HEAD by an actual merge\\n    commit, whose first-parent diff introduces all four, the same\\n    derivation attest itself uses. A fixture with one record per stage,\\n    landed on a branch and merged --no-ff, is enough to prove the\\n    mechanism.\\\"\\\"\\\"\\n    root = tmp_path / \\\"four_stages_merged\\\"\\n    root.mkdir()\\n    (root / \\\"attavo.toml\\\").write_text('[paths]\\\\nrecords = \\\"records\\\"\\\\n')\\n    init_repo(root, \\\"install\\\")\\n\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"-b\\\", \\\"attavo/1-x\\\"], check=True)\\n    records = root / \\\"records\\\" / \\\"1\\\"\\n    records.mkdir(parents=True)\\n    (records / \\\"spec-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\"}))\\n    (records / \\\"approval-01.json\\\").write_text(json.dumps({\\\"approved_by\\\": \\\"alice\\\"}))\\n    (records / \\\"build-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\"}))\\n    (records / \\\"verify-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\"}))\\n    commit_all(root, \\\"spec, approval, build, and verify records\\\")\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"main\\\"], check=True)\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"merge\\\", \\\"--no-ff\\\", \\\"-m\\\",\\n                    \\\"Merge branch 'attavo/1-x'\\\", \\\"attavo/1-x\\\"], check=True)\\n\\n    p = run_doctor(root)[\\\"one-item-every-stage\\\"]\\n    assert p[\\\"holds\\\"], p[\\\"reason\\\"]\\n\\n\\ndef test_doctor_proof_two_fails_when_four_stage_records_are_never_merged(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Acceptance row 4's other half, issue #69: the same four records,\\n    committed straight to main with no merge at all -- proof two fails,\\n    naming the missing merge rather than a lacking stage.\\\"\\\"\\\"\\n    root = tmp_path / \\\"four_stages_unmerged\\\"\\n    root.mkdir()\\n    (root / \\\"attavo.toml\\\").write_text('[paths]\\\\nrecords = \\\"records\\\"\\\\n')\\n    init_repo(root, \\\"install\\\")\\n\\n    records = root / \\\"records\\\" / \\\"1\\\"\\n    records.mkdir(parents=True)\\n    (records / \\\"spec-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\"}))\\n    (records / \\\"approval-01.json\\\").write_text(json.dumps({\\\"approved_by\\\": \\\"alice\\\"}))\\n    (records / \\\"build-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\"}))\\n    (records / \\\"verify-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\"}))\\n    commit_all(root, \\\"spec, approval, build, and verify records, committed directly\\\")\\n\\n    p = run_doctor(root)[\\\"one-item-every-stage\\\"]\\n    assert not p[\\\"holds\\\"]\\n    assert \\\"merge\\\" in p[\\\"reason\\\"]\\n\\n\\ndef test_proof_two_fails_naming_the_item_and_refusal_text_on_approval_sha_mismatch(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Acceptance row 1, issue #74. build-01's approval_sha does not name\\n    the latest approval's sha -- attavo attest would refuse exactly this\\n    chain, and from v0.11.0 the coherence gate refuses the merge group on\\n    it. Proof two must refuse it too, not just find the four stages\\n    present: fails naming the item and check_attest_chain's own refusal\\n    text, never a re-typed copy of it.\\\"\\\"\\\"\\n    root = tmp_path / \\\"approval_sha_mismatch\\\"\\n    root.mkdir()\\n    (root / \\\"attavo.toml\\\").write_text('[paths]\\\\nrecords = \\\"records\\\"\\\\n')\\n    init_repo(root, \\\"install\\\")\\n\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"-b\\\", \\\"attavo/1-x\\\"], check=True)\\n    records = root / \\\"records\\\" / \\\"1\\\"\\n    records.mkdir(parents=True)\\n    (records / \\\"spec-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\"}))\\n    (records / \\\"approval-01.json\\\").write_text(json.dumps({\\\"approved_by\\\": \\\"alice\\\", \\\"sha\\\": \\\"1\\\" * 40}))\\n    (records / \\\"build-01.json\\\").write_text(\\n        json.dumps({\\\"status\\\": \\\"pass\\\", \\\"approval_sha\\\": \\\"2\\\" * 40, \\\"sha\\\": \\\"3\\\" * 40}))\\n    (records / \\\"verify-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\", \\\"build_sha\\\": \\\"3\\\" * 40}))\\n    commit_all(root, \\\"spec, approval, build, and verify records with a stale approval_sha\\\")\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"main\\\"], check=True)\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"merge\\\", \\\"--no-ff\\\", \\\"-m\\\",\\n                    \\\"Merge branch 'attavo/1-x'\\\", \\\"attavo/1-x\\\"], check=True)\\n\\n    p = run_doctor(root)[\\\"one-item-every-stage\\\"]\\n    assert not p[\\\"holds\\\"]\\n    assert \\\"item 1\\\" in p[\\\"reason\\\"]\\n    assert \\\"approval_sha does not name the latest approval\\\" in p[\\\"reason\\\"]\\n\\n\\ndef test_proof_two_fails_naming_the_item_and_the_superseded_verify(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Acceptance row 5, issue #109. verify-01's build_sha does not name\\n    the latest build's sha, so verify-01 is superseded by that later\\n    build, not a mismatch -- proof two fails, naming it, with the new\\n    message, never the retired mismatch wording.\\\"\\\"\\\"\\n    root = tmp_path / \\\"build_sha_mismatch\\\"\\n    root.mkdir()\\n    (root / \\\"attavo.toml\\\").write_text('[paths]\\\\nrecords = \\\"records\\\"\\\\n')\\n    init_repo(root, \\\"install\\\")\\n\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"-b\\\", \\\"attavo/1-x\\\"], check=True)\\n    records = root / \\\"records\\\" / \\\"1\\\"\\n    records.mkdir(parents=True)\\n    (records / \\\"spec-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\"}))\\n    (records / \\\"approval-01.json\\\").write_text(json.dumps({\\\"approved_by\\\": \\\"alice\\\", \\\"sha\\\": \\\"1\\\" * 40}))\\n    (records / \\\"build-01.json\\\").write_text(\\n        json.dumps({\\\"status\\\": \\\"pass\\\", \\\"approval_sha\\\": \\\"1\\\" * 40, \\\"sha\\\": \\\"3\\\" * 40}))\\n    (records / \\\"verify-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\", \\\"build_sha\\\": \\\"9\\\" * 40}))\\n    commit_all(root, \\\"spec, approval, build, and verify records with a stale build_sha\\\")\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"main\\\"], check=True)\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"merge\\\", \\\"--no-ff\\\", \\\"-m\\\",\\n                    \\\"Merge branch 'attavo/1-x'\\\", \\\"attavo/1-x\\\"], check=True)\\n\\n    p = run_doctor(root)[\\\"one-item-every-stage\\\"]\\n    assert not p[\\\"holds\\\"]\\n    assert \\\"item 1\\\" in p[\\\"reason\\\"]\\n    assert \\\"no verify names the latest build\\\" in p[\\\"reason\\\"]\\n    assert \\\"verify-01 names\\\" in p[\\\"reason\\\"]\\n    assert \\\"verify's build_sha does not name the latest build\\\" not in p[\\\"reason\\\"]\\n\\n\\ndef test_proof_two_holds_naming_only_the_held_item_when_another_is_refused(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Acceptance row 3, issue #74. Item 1 carries every stage but a\\n    stale approval_sha; item 2's chain holds cleanly. Proof two holds,\\n    naming only item 2 -- item 1's refusal never leaks into a passing\\n    reason.\\\"\\\"\\\"\\n    root = tmp_path / \\\"two_items_one_refused\\\"\\n    root.mkdir()\\n    (root / \\\"attavo.toml\\\").write_text('[paths]\\\\nrecords = \\\"records\\\"\\\\n')\\n    init_repo(root, \\\"install\\\")\\n\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"-b\\\", \\\"attavo/1-x\\\"], check=True)\\n    records1 = root / \\\"records\\\" / \\\"1\\\"\\n    records1.mkdir(parents=True)\\n    (records1 / \\\"spec-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\"}))\\n    (records1 / \\\"approval-01.json\\\").write_text(json.dumps({\\\"approved_by\\\": \\\"alice\\\", \\\"sha\\\": \\\"1\\\" * 40}))\\n    (records1 / \\\"build-01.json\\\").write_text(\\n        json.dumps({\\\"status\\\": \\\"pass\\\", \\\"approval_sha\\\": \\\"2\\\" * 40, \\\"sha\\\": \\\"3\\\" * 40}))\\n    (records1 / \\\"verify-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\", \\\"build_sha\\\": \\\"3\\\" * 40}))\\n    commit_all(root, \\\"spec, approval, build, and verify records for item 1, chain refused\\\")\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"main\\\"], check=True)\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"merge\\\", \\\"--no-ff\\\", \\\"-m\\\",\\n                    \\\"Merge branch 'attavo/1-x'\\\", \\\"attavo/1-x\\\"], check=True)\\n\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"-b\\\", \\\"attavo/2-x\\\"], check=True)\\n    records2 = root / \\\"records\\\" / \\\"2\\\"\\n    records2.mkdir(parents=True)\\n    (records2 / \\\"spec-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\"}))\\n    (records2 / \\\"approval-01.json\\\").write_text(json.dumps({\\\"approved_by\\\": \\\"alice\\\", \\\"sha\\\": \\\"9\\\" * 40}))\\n    (records2 / \\\"build-01.json\\\").write_text(\\n        json.dumps({\\\"status\\\": \\\"pass\\\", \\\"approval_sha\\\": \\\"9\\\" * 40, \\\"sha\\\": \\\"8\\\" * 40}))\\n    (records2 / \\\"verify-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\", \\\"build_sha\\\": \\\"8\\\" * 40}))\\n    commit_all(root, \\\"spec, approval, build, and verify records for item 2, chain holds\\\")\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"main\\\"], check=True)\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"merge\\\", \\\"--no-ff\\\", \\\"-m\\\",\\n                    \\\"Merge branch 'attavo/2-x'\\\", \\\"attavo/2-x\\\"], check=True)\\n    merge2_sha = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"rev-parse\\\", \\\"HEAD\\\"],\\n                                capture_output=True, text=True, check=True).stdout.strip()\\n\\n    p = run_doctor(root)[\\\"one-item-every-stage\\\"]\\n    assert p[\\\"holds\\\"], p[\\\"reason\\\"]\\n    assert p[\\\"reason\\\"] == (\\n        \\\"item(s) 2 carry spec, approval, build, verify with the chain held, \\\"\\n        f\\\"merged at {merge2_sha[:12]}\\\")\\n\\n\\ndef test_proof_three_holds_on_an_item_merge_with_no_attestation_record(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Acceptance row 5, issue #69: an item's merge commit carries its\\n    record paths in its own first-parent diff, so it is a record commit\\n    by the rule that already exists -- no merge_sha field is needed, and\\n    there is no attestation record at all now that attest never writes\\n    (replaces test_merge_sha_covers_the_merge_commit_for_proof_three,\\n    deleted alongside the merge_sha special case it exercised).\\\"\\\"\\\"\\n    root = tmp_path / \\\"item_merge\\\"\\n    root.mkdir()\\n    (root / \\\"attavo.toml\\\").write_text('[paths]\\\\nrecords = \\\"records\\\"\\\\n')\\n    init_repo(root, \\\"install\\\")\\n\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"-b\\\", \\\"attavo/1-x\\\"], check=True)\\n    records = root / \\\"records\\\" / \\\"1\\\"\\n    records.mkdir(parents=True)\\n    (records / \\\"spec-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\"}))\\n    (records / \\\"approval-01.json\\\").write_text(json.dumps({\\\"approved_by\\\": \\\"alice\\\"}))\\n    (records / \\\"build-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\"}))\\n    (records / \\\"verify-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\"}))\\n    commit_all(root, \\\"spec, approval, build, and verify records for item 1\\\")\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"main\\\"], check=True)\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"merge\\\", \\\"--no-ff\\\", \\\"-m\\\",\\n                    \\\"Merge branch 'attavo/1-x'\\\", \\\"attavo/1-x\\\"], check=True)\\n\\n    p = run_doctor(root)[\\\"no-commit-lacks-record\\\"]\\n    assert p[\\\"holds\\\"], p[\\\"reason\\\"]\\n    assert not (records / \\\"attestation-01.json\\\").exists()\\n\\n\\ndef _three_way_fixture(tmp_path: Path, name: str, *, boundary_paths: list[str] | None,\\n                       ordinary_touches: str, include_direct_commit: bool) -> Path:\\n    \\\"\\\"\\\"A tenant history carrying one commit of each of proof three's three\\n    kinds (issue #72): an item merge (recorded, by the records-path rule\\n    proof two's fixtures already exercise), a --no-ff merge touching only\\n    `ordinary_touches` (ordinary), and, when asked, one commit made\\n    straight to main naming no record (unrecorded -- on a protected main\\n    with a queue, the only way a change arrives without the forge).\\n    \\\"\\\"\\\"\\n    root = tmp_path / name\\n    root.mkdir()\\n    manifest = '[paths]\\\\nrecords = \\\"records\\\"\\\\n'\\n    if boundary_paths is not None:\\n        patterns = \\\", \\\".join(f'\\\"{path}\\\"' for path in boundary_paths)\\n        manifest += f'\\\\n[spec.boundary]\\\\npaths = [{patterns}]\\\\n'\\n    (root / \\\"attavo.toml\\\").write_text(manifest)\\n    init_repo(root, \\\"install\\\")\\n\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"-b\\\", \\\"attavo/1-x\\\"], check=True)\\n    records = root / \\\"records\\\" / \\\"1\\\"\\n    records.mkdir(parents=True)\\n    (records / \\\"spec-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\"}))\\n    commit_all(root, \\\"spec record for item 1\\\")\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"main\\\"], check=True)\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"merge\\\", \\\"--no-ff\\\", \\\"-m\\\",\\n                    \\\"Merge branch 'attavo/1-x'\\\", \\\"attavo/1-x\\\"], check=True)\\n\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"-b\\\", \\\"ordinary-change\\\"], check=True)\\n    touched = root / ordinary_touches\\n    touched.parent.mkdir(parents=True, exist_ok=True)\\n    touched.write_text(\\\"v2\\\\n\\\")\\n    commit_all(root, \\\"an ordinary change\\\")\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"main\\\"], check=True)\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"merge\\\", \\\"--no-ff\\\", \\\"-m\\\",\\n                    \\\"Merge branch 'ordinary-change'\\\", \\\"ordinary-change\\\"], check=True)\\n\\n    if include_direct_commit:\\n        (root / \\\"direct.txt\\\").write_text(\\\"direct\\\\n\\\")\\n        commit_all(root, \\\"a change committed straight to main\\\")\\n\\n    return root\\n\\n\\ndef test_proof_three_fails_naming_the_direct_commit_with_the_three_counts(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Acceptance row 1, issue #72. The three-way fixture with its direct\\n    commit included: proof three fails, naming the direct commit and\\n    reporting all three counts in the reason.\\\"\\\"\\\"\\n    root = _three_way_fixture(tmp_path, \\\"direct_commit\\\", boundary_paths=[\\\"boundary/**\\\"],\\n                              ordinary_touches=\\\"pins/version.txt\\\", include_direct_commit=True)\\n    direct_sha = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"rev-parse\\\", \\\"HEAD\\\"],\\n                                capture_output=True, text=True, check=True).stdout.strip()\\n\\n    p = run_doctor(root)[\\\"no-commit-lacks-record\\\"]\\n    assert not p[\\\"holds\\\"]\\n    assert \\\"1 recorded, 1 ordinary, 1 unrecorded\\\" in p[\\\"reason\\\"]\\n    assert direct_sha[:12] in p[\\\"reason\\\"]\\n\\n\\ndef test_proof_three_holds_with_zero_unrecorded_once_the_direct_commit_is_gone(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Acceptance row 2, issue #72. The same fixture with the direct commit\\n    removed: proof three holds, reporting `0 unrecorded`.\\\"\\\"\\\"\\n    root = _three_way_fixture(tmp_path, \\\"no_direct_commit\\\", boundary_paths=[\\\"boundary/**\\\"],\\n                              ordinary_touches=\\\"pins/version.txt\\\", include_direct_commit=False)\\n\\n    p = run_doctor(root)[\\\"no-commit-lacks-record\\\"]\\n    assert p[\\\"holds\\\"], p[\\\"reason\\\"]\\n    assert \\\"1 recorded, 1 ordinary, 0 unrecorded\\\" in p[\\\"reason\\\"]\\n\\n\\ndef test_proof_three_reports_boundary_evasions_and_still_holds(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Acceptance row 3, issue #72. The ordinary merge touches a path\\n    inside [spec.boundary].paths: the reason carries `boundary evasions:\\n    1`, and the proof still holds -- evasions are reported, never\\n    refused.\\\"\\\"\\\"\\n    root = _three_way_fixture(tmp_path, \\\"boundary_evasion\\\", boundary_paths=[\\\"boundary/**\\\"],\\n                              ordinary_touches=\\\"boundary/thing.txt\\\", include_direct_commit=False)\\n\\n    p = run_doctor(root)[\\\"no-commit-lacks-record\\\"]\\n    assert p[\\\"holds\\\"], p[\\\"reason\\\"]\\n    assert \\\"boundary evasions: 1\\\" in p[\\\"reason\\\"]\\n\\n\\ndef test_proof_three_reports_boundary_evasions_as_not_available_with_no_boundary_paths(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Acceptance row 4, issue #72. A tenant declaring no [spec.boundary]\\n    paths at all: evasions are reported as `n/a`, not `0` -- an absent\\n    read is not the same measurement as zero evasions found.\\\"\\\"\\\"\\n    root = _three_way_fixture(tmp_path, \\\"no_boundary\\\", boundary_paths=None,\\n                              ordinary_touches=\\\"pins/version.txt\\\", include_direct_commit=False)\\n\\n    p = run_doctor(root)[\\\"no-commit-lacks-record\\\"]\\n    assert p[\\\"holds\\\"], p[\\\"reason\\\"]\\n    assert \\\"boundary evasions: n/a\\\" in p[\\\"reason\\\"]\\n    assert p[\\\"boundary_evasions\\\"] == \\\"n/a\\\"\\n\\n\\ndef test_proof_three_json_carries_the_path_ratio_fields(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Acceptance row 5, issue #72. `attavo doctor --json` carries\\n    `recorded`, `ordinary`, `unrecorded`, and `boundary_evasions` on\\n    proof three's own entry -- the path-ratio primitive Phase 4 names,\\n    produced now because a decision depends on it.\\\"\\\"\\\"\\n    root = _three_way_fixture(tmp_path, \\\"json_fields\\\", boundary_paths=[\\\"boundary/**\\\"],\\n                              ordinary_touches=\\\"pins/version.txt\\\", include_direct_commit=False)\\n\\n    p = run_doctor(root)[\\\"no-commit-lacks-record\\\"]\\n    assert p[\\\"recorded\\\"] == 1\\n    assert p[\\\"ordinary\\\"] == 1\\n    assert p[\\\"unrecorded\\\"] == 0\\n    assert p[\\\"boundary_evasions\\\"] == 0\\n\\n\\ndef test_proof_three_json_lists_the_ordinary_and_unrecorded_commits(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Issue #148. Proof three's JSON entry carries `ordinary_commits` and\\n    `unrecorded_commits`, each commit with sha and subject, so a reader\\n    can name the commits behind the counts without re-running the\\n    classification by hand. The ordinary merge that touches a boundary\\n    path is flagged `boundary_evasion: true`.\\\"\\\"\\\"\\n    root = _three_way_fixture(tmp_path, \\\"commit_lists\\\", boundary_paths=[\\\"boundary/**\\\"],\\n                              ordinary_touches=\\\"boundary/thing.txt\\\", include_direct_commit=True)\\n    direct_sha = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"rev-parse\\\", \\\"HEAD\\\"],\\n                                capture_output=True, text=True, check=True).stdout.strip()\\n\\n    p = run_doctor(root)[\\\"no-commit-lacks-record\\\"]\\n    ordinary_commits = p[\\\"ordinary_commits\\\"]\\n    unrecorded_commits = p[\\\"unrecorded_commits\\\"]\\n    assert [c[\\\"subject\\\"] for c in ordinary_commits] == [\\\"Merge branch 'ordinary-change'\\\"]\\n    assert len(ordinary_commits[0][\\\"sha\\\"]) == 40\\n    assert ordinary_commits[0][\\\"boundary_evasion\\\"] is True\\n    assert [c[\\\"subject\\\"] for c in unrecorded_commits] == [\\\"a change committed straight to main\\\"]\\n    assert unrecorded_commits[0][\\\"sha\\\"] == direct_sha\\n\\n\\ndef _window_fixture(tmp_path: Path, name: str) -> tuple[Path, str, str]:\\n    \\\"\\\"\\\"Two commits made straight to main, then a branch carrying item 1's\\n    spec record, merged --no-ff. Returns (root, merge_sha, branch_sha) --\\n    merge_sha is on main's first-parent line and is the only sha issue\\n    #74's [doctor] from tests declare as valid; branch_sha is the branch\\n    commit itself, reachable only as the merge's second parent and never\\n    on that line, the sha the invalid-from test declares instead.\\\"\\\"\\\"\\n    root = tmp_path / name\\n    root.mkdir()\\n    (root / \\\"attavo.toml\\\").write_text('[paths]\\\\nrecords = \\\"records\\\"\\\\n')\\n    init_repo(root, \\\"install\\\")\\n\\n    (root / \\\"pre1.txt\\\").write_text(\\\"1\\\\n\\\")\\n    commit_all(root, \\\"a change committed straight to main\\\")\\n    (root / \\\"pre2.txt\\\").write_text(\\\"2\\\\n\\\")\\n    commit_all(root, \\\"another change committed straight to main\\\")\\n\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"-b\\\", \\\"attavo/1-x\\\"], check=True)\\n    records = root / \\\"records\\\" / \\\"1\\\"\\n    records.mkdir(parents=True)\\n    (records / \\\"spec-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\"}))\\n    commit_all(root, \\\"spec record for item 1\\\")\\n    branch_sha = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"rev-parse\\\", \\\"HEAD\\\"],\\n                                capture_output=True, text=True, check=True).stdout.strip()\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"main\\\"], check=True)\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"merge\\\", \\\"--no-ff\\\", \\\"-m\\\",\\n                    \\\"Merge branch 'attavo/1-x'\\\", \\\"attavo/1-x\\\"], check=True)\\n    merge_sha = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"rev-parse\\\", \\\"HEAD\\\"],\\n                               capture_output=True, text=True, check=True).stdout.strip()\\n    return root, merge_sha, branch_sha\\n\\n\\ndef _declare_doctor_from(root: Path, from_sha: str) -> None:\\n    \\\"\\\"\\\"Names [doctor] from via its own merge, not a direct commit to\\n    main -- declaring the window must never itself read as an unrecorded\\n    commit inside it.\\\"\\\"\\\"\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"-b\\\", \\\"declare-window\\\"], check=True)\\n    toml = root / \\\"attavo.toml\\\"\\n    toml.write_text(toml.read_text() + f'\\\\n[doctor]\\\\nfrom = \\\"{from_sha}\\\"\\\\n')\\n    commit_all(root, \\\"declare the doctor's window\\\")\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"main\\\"], check=True)\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"merge\\\", \\\"--no-ff\\\", \\\"-m\\\",\\n                    \\\"Merge branch 'declare-window'\\\", \\\"declare-window\\\"], check=True)\\n\\n\\ndef test_proof_three_holds_reporting_before_the_window_with_doctor_from(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Acceptance row 4, issue #74. [doctor] from names the item merge:\\n    the two commits made straight to main before it fall before the\\n    window, not into unrecorded -- proof three holds, `before the\\n    window: 2`, and the window's own counts, 1 recorded (the item merge)\\n    and 1 ordinary (the merge that declares the window itself).\\\"\\\"\\\"\\n    root, merge_sha, _ = _window_fixture(tmp_path, \\\"window_holds\\\")\\n    _declare_doctor_from(root, merge_sha)\\n\\n    p = run_doctor(root)[\\\"no-commit-lacks-record\\\"]\\n    assert p[\\\"holds\\\"], p[\\\"reason\\\"]\\n    assert \\\"before the window: 2\\\" in p[\\\"reason\\\"]\\n    assert \\\"1 recorded, 1 ordinary, 0 unrecorded\\\" in p[\\\"reason\\\"]\\n    assert p[\\\"before_window\\\"] == 2\\n\\n\\ndef test_proof_three_holds_when_doctor_from_names_a_seven_character_prefix(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Acceptance row 5 (amendment), issue #74. [doctor] from need not be\\n    a full sha -- any spelling git rev-parse --verify resolves is\\n    accepted, resolved before the first-parent check runs. A\\n    seven-character prefix of the item merge holds with the same counts\\n    as the full-sha case.\\\"\\\"\\\"\\n    root, merge_sha, _ = _window_fixture(tmp_path, \\\"window_holds_short_sha\\\")\\n    _declare_doctor_from(root, merge_sha[:7])\\n\\n    p = run_doctor(root)[\\\"no-commit-lacks-record\\\"]\\n    assert p[\\\"holds\\\"], p[\\\"reason\\\"]\\n    assert \\\"before the window: 2\\\" in p[\\\"reason\\\"]\\n    assert \\\"1 recorded, 1 ordinary, 0 unrecorded\\\" in p[\\\"reason\\\"]\\n    assert p[\\\"before_window\\\"] == 2\\n\\n\\ndef test_proof_three_fails_naming_the_key_when_doctor_from_is_off_the_first_parent_line(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Acceptance row 5, issue #74. [doctor] from names the item branch's\\n    own commit -- reachable only as a merge's second parent, never on\\n    main's first-parent line -- proof three fails naming the key rather\\n    than silently falling back to the install commit.\\\"\\\"\\\"\\n    root, _, branch_sha = _window_fixture(tmp_path, \\\"window_off_line\\\")\\n    _declare_doctor_from(root, branch_sha)\\n\\n    p = run_doctor(root)[\\\"no-commit-lacks-record\\\"]\\n    assert not p[\\\"holds\\\"]\\n    assert \\\"[doctor] from\\\" in p[\\\"reason\\\"]\\n    assert branch_sha[:12] in p[\\\"reason\\\"]\\n\\n\\ndef test_proof_three_defaults_to_the_install_commit_when_doctor_key_is_absent(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Acceptance row 6, issue #74. No [doctor] table at all: the window\\n    defaults to the install commit exactly as before this issue -- both\\n    commits made straight to main are still read as unrecorded, and\\n    before_window is 0 -- the read every existing proof-three test\\n    exercises is unaffected by the key's addition.\\\"\\\"\\\"\\n    root, _merge_sha, _branch_sha = _window_fixture(tmp_path, \\\"window_absent\\\")\\n\\n    p = run_doctor(root)[\\\"no-commit-lacks-record\\\"]\\n    assert not p[\\\"holds\\\"]\\n    assert \\\"1 recorded, 0 ordinary, 2 unrecorded\\\" in p[\\\"reason\\\"]\\n    assert \\\"before the window: 0\\\" in p[\\\"reason\\\"]\\n    assert p[\\\"before_window\\\"] == 0\\n\\n\\ndef test_doctor_proof_one_refuses_a_gate_with_empty_retires(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Residual, issue #54 -- proposed, not yet ruled on: a gate that\\n    retires nothing only adds. The manifest schema has required\\n    [gates.<name>].retires to be non-empty since Phase 1, but read_manifest\\n    never validates against that schema, so nothing enforced it at\\n    runtime until this proof read it directly.\\\"\\\"\\\"\\n    root = tmp_path / \\\"empty_retires\\\"\\n    root.mkdir()\\n    (root / \\\"attavo.toml\\\").write_text(\\n        '[paths]\\\\nrejections = \\\"rejections\\\"\\\\n\\\\n'\\n        '[gates.spec]\\\\ncommand = \\\"false\\\"\\\\nretires = []\\\\n')\\n    (root / \\\"rejections\\\" / \\\"spec\\\").mkdir(parents=True)\\n    init_repo(root, \\\"install\\\")\\n\\n    p = run_doctor(root)[\\\"every-gate-rejects\\\"]\\n    assert not p[\\\"holds\\\"]\\n    assert \\\"retires\\\" in p[\\\"reason\\\"] and \\\"spec\\\" in p[\\\"reason\\\"]\\n\\n\\ndef test_doctor_proof_one_runs_the_gate_without_an_item_argument(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Issue #7, and its regression test. [gates.spec].command is a bare\\n    `attavo spec-gate`, no item argument, and its rejections/spec/ fixture\\n    carries no attavo/N-* branch at all (init_repo leaves it on `main`) --\\n    so before the doctor exported the fixture's item as ATTAVO_ITEM, the\\n    gate command would exit 2 (cannot derive item id) without ever writing\\n    a record, which still counts as \\\"rejected\\\" but proves nothing about the\\n    prose criterion this fixture means to test.\\n\\n    Red at the merge base: no ATTAVO_ITEM export existed, so no\\n    spec-01.json was ever written and reading it raised FileNotFoundError.\\n    Green once the doctor exports it: the record exists and names the\\n    prose criterion by name, which is the actual thing proof one asserts.\\n    \\\"\\\"\\\"\\n    outer = tmp_path / \\\"gate_rejection\\\"\\n    shutil.copytree(FIXTURES / \\\"gate_rejection\\\", outer)\\n    cmd = f\\\"{sys.executable} {ATTAVO}\\\"\\n    toml = outer / \\\"attavo.toml\\\"\\n    toml.write_text(toml.read_text().replace(\\\"ATTAVO_CMD\\\", cmd))\\n    init_repo(outer / \\\"rejections\\\" / \\\"spec\\\")\\n\\n    p = run_doctor(outer)[\\\"every-gate-rejects\\\"]\\n    assert p[\\\"holds\\\"], p[\\\"reason\\\"]\\n\\n    record = json.loads(\\n        (outer / \\\"rejections\\\" / \\\"spec\\\" / \\\"records\\\" / \\\"1\\\" / \\\"spec-01.json\\\").read_text())\\n    assert record[\\\"refusal\\\"] == \\\"criterion is prose: missing.sh\\\"\\n\\n\\ndef test_doctor_proof_four_fails_on_a_failed_record_with_no_stop(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Acceptance row 1, issue #94: a failed build record at\\n    record_version 3 with a two-line log and no stop at all -- a stop\\n    the product forgot to write, the way tenant zero's #576 build-11\\n    (before record_version 3 existed) was diagnosed only by a person\\n    rerunning it by hand. Fails today: no proof four exists.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"no_stop_lacks_cause\\\")\\n\\n    p = run_doctor(root)[\\\"no-stop-lacks-cause\\\"]\\n    assert not p[\\\"holds\\\"]\\n    assert \\\"build-01\\\" in p[\\\"reason\\\"]\\n    assert \\\"no stop\\\" in p[\\\"reason\\\"]\\n\\n\\ndef test_doctor_proof_four_holds_on_a_fixture_with_stop_and_gates_heading(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Acceptance row 2, issue #94: a failed build record whose stop is\\n    present and valid, and whose log carries the gates heading since\\n    gates actually ran (selected_tests is set) -- proof four holds.\\\"\\\"\\\"\\n    root = tmp_path / \\\"stop_holds\\\"\\n    root.mkdir()\\n    (root / \\\"attavo.toml\\\").write_text('[paths]\\\\nrecords = \\\"records\\\"\\\\n')\\n    init_repo(root, \\\"install\\\")\\n\\n    records = root / \\\"records\\\" / \\\"1\\\"\\n    records.mkdir(parents=True)\\n    build = {\\n        \\\"status\\\": \\\"failed\\\", \\\"record_version\\\": 3,\\n        \\\"selected_tests\\\": {\\\"select\\\": \\\"cat\\\", \\\"run\\\": \\\"cat\\\", \\\"count\\\": 1, \\\"exit\\\": 1},\\n        \\\"stop\\\": {\\\"class\\\": \\\"unclassed\\\", \\\"provenance\\\": \\\"product\\\", \\\"detail\\\": \\\"1 failed, 0 passed\\\"},\\n    }\\n    (records / \\\"build-01.json\\\").write_text(json.dumps(build))\\n    (records / \\\"build-01.log\\\").write_text(\\n        \\\"--- attavo gates, iteration 1 ---\\\\ncriterion x: exit 1\\\\n1 failed, 0 passed\\\")\\n    commit_all(root, \\\"a failed build record with a proper stop and gates heading\\\")\\n\\n    p = run_doctor(root)[\\\"no-stop-lacks-cause\\\"]\\n    assert p[\\\"holds\\\"], p[\\\"reason\\\"]\\n\\n\\ndef test_doctor_proof_four_reports_older_records_mixing_versions_2_and_3(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Acceptance row 3, issue #94: a record_version 2 record predates\\n    stop by construction (proof three's own window lesson) and is\\n    counted, never refused; a record_version 3 record alongside it is\\n    checked as usual. Proof four holds, reporting the older count.\\\"\\\"\\\"\\n    root = tmp_path / \\\"mixed_versions\\\"\\n    root.mkdir()\\n    (root / \\\"attavo.toml\\\").write_text('[paths]\\\\nrecords = \\\"records\\\"\\\\n')\\n    init_repo(root, \\\"install\\\")\\n\\n    records = root / \\\"records\\\" / \\\"1\\\"\\n    records.mkdir(parents=True)\\n    (records / \\\"build-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"failed\\\", \\\"record_version\\\": 2}))\\n    (records / \\\"verify-01.json\\\").write_text(json.dumps({\\n        \\\"status\\\": \\\"returned\\\", \\\"record_version\\\": 3,\\n        \\\"stop\\\": {\\\"class\\\": \\\"forge-unconcluded\\\", \\\"provenance\\\": \\\"tenant\\\", \\\"detail\\\": None}}))\\n    commit_all(root, \\\"one older record before stop, one current record with a stop\\\")\\n\\n    p = run_doctor(root)[\\\"no-stop-lacks-cause\\\"]\\n    assert p[\\\"holds\\\"], p[\\\"reason\\\"]\\n    assert \\\"1 record(s) before stop was recorded\\\" in p[\\\"reason\\\"]\\n    assert p[\\\"older_records\\\"] == 1\\n\\n\\ndef test_doctor_proof_four_holds_with_no_non_pass_records_to_check(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"A tenant found on a real v0.16.3 pin: no non-pass build or verify\\n    record at record_version 3 or later exists to check -- every item\\n    passed. The clause is \\\"every failed or refused record carries its\\n    cause\\\", which holds vacuously on an empty set, the way proof three\\n    holds when nothing is unrecorded. Proof four must hold, reporting\\n    0 checked and the older-record count, not fail the tenant for having\\n    nothing to check.\\\"\\\"\\\"\\n    root = tmp_path / \\\"all_pass\\\"\\n    root.mkdir()\\n    (root / \\\"attavo.toml\\\").write_text('[paths]\\\\nrecords = \\\"records\\\"\\\\n')\\n    init_repo(root, \\\"install\\\")\\n\\n    records = root / \\\"records\\\" / \\\"1\\\"\\n    records.mkdir(parents=True)\\n    (records / \\\"build-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"failed\\\", \\\"record_version\\\": 2}))\\n    (records / \\\"verify-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\", \\\"record_version\\\": 3}))\\n    commit_all(root, \\\"one older record before stop, one current record that passed\\\")\\n\\n    p = run_doctor(root)[\\\"no-stop-lacks-cause\\\"]\\n    assert p[\\\"holds\\\"], p[\\\"reason\\\"]\\n    assert \\\"0 checked\\\" in p[\\\"reason\\\"]\\n    assert \\\"1 record(s) before stop was recorded\\\" in p[\\\"reason\\\"]\\n    assert p[\\\"older_records\\\"] == 1\\n\\n\\ndef test_doctor_proof_four_fails_when_gates_ran_but_the_log_lacks_their_heading(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Issue #94's own proposed fix: a failed build whose selected_tests\\n    is set -- gates definitely ran that iteration -- but whose log\\n    carries no gates heading at all. Tenant zero's #659 build-01 was\\n    exactly this before issue #89's own fix landed: the gate output that\\n    failed it lived only in a temporary directory the product deleted.\\\"\\\"\\\"\\n    root = tmp_path / \\\"missing_gates_heading\\\"\\n    root.mkdir()\\n    (root / \\\"attavo.toml\\\").write_text('[paths]\\\\nrecords = \\\"records\\\"\\\\n')\\n    init_repo(root, \\\"install\\\")\\n\\n    records = root / \\\"records\\\" / \\\"1\\\"\\n    records.mkdir(parents=True)\\n    build = {\\n        \\\"status\\\": \\\"failed\\\", \\\"record_version\\\": 3,\\n        \\\"selected_tests\\\": {\\\"select\\\": \\\"cat\\\", \\\"run\\\": \\\"cat\\\", \\\"count\\\": 1, \\\"exit\\\": 1},\\n        \\\"stop\\\": {\\\"class\\\": \\\"unclassed\\\", \\\"provenance\\\": \\\"product\\\", \\\"detail\\\": \\\"1 failed, 0 passed\\\"},\\n    }\\n    (records / \\\"build-01.json\\\").write_text(json.dumps(build))\\n    (records / \\\"build-01.log\\\").write_text(\\\"1 failed, 0 passed\\\")\\n    commit_all(root, \\\"a failed build with gates run but no gates heading in the log\\\")\\n\\n    p = run_doctor(root)[\\\"no-stop-lacks-cause\\\"]\\n    assert not p[\\\"holds\\\"]\\n    assert \\\"gates heading\\\" in p[\\\"reason\\\"]\\n\\n\\ndef test_doctor_proof_four_fails_when_a_log_ends_in_an_adapter_exit_after_only_event_lines(\\n        tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Issue #94's own proposed fix, tenant zero's #659 verify-01\\n    specimen: a log whose last line is a bare adapter-exit marker with\\n    nothing before it but the adapter's own JSON event stream -- the\\n    tool's real error line never reached it (issue #86's own\\n    split_adapter_stdout bug, now guarded against at read time too).\\\"\\\"\\\"\\n    root = tmp_path / \\\"owed_tool_error\\\"\\n    root.mkdir()\\n    (root / \\\"attavo.toml\\\").write_text('[paths]\\\\nrecords = \\\"records\\\"\\\\n')\\n    init_repo(root, \\\"install\\\")\\n\\n    records = root / \\\"records\\\" / \\\"1\\\"\\n    records.mkdir(parents=True)\\n    verify = {\\n        \\\"status\\\": \\\"failed\\\", \\\"record_version\\\": 3,\\n        \\\"stop\\\": {\\\"class\\\": \\\"unclassed\\\", \\\"provenance\\\": \\\"product\\\", \\\"detail\\\": \\\"[adapter exited 1]\\\"},\\n    }\\n    (records / \\\"verify-01.json\\\").write_text(json.dumps(verify))\\n    (records / \\\"verify-01.log\\\").write_text(\\n        '{\\\"type\\\":\\\"thread.started\\\",\\\"thread_id\\\":\\\"x\\\"}\\\\n[adapter exited 1]')\\n    commit_all(root, \\\"a failed verify whose tool error line was dropped\\\")\\n\\n    p = run_doctor(root)[\\\"no-stop-lacks-cause\\\"]\\n    assert not p[\\\"holds\\\"]\\n    assert \\\"tool's own error line is owed\\\" in p[\\\"reason\\\"]\\n\\n\\ndef test_proof_four_reads_an_error_event_as_the_tools_own_words(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Issue #200: a review the vendor refused (\\\"Selected model is at\\n    capacity\\\") logs the tool's own error as an `error` event, then the\\n    exit marker. The cause is in the log, in the tool's words, so proof\\n    four does not owe a line. An `error` event with an empty or missing\\n    message says nothing and still owes it.\\\"\\\"\\\"\\n    event_lines = ('{\\\"type\\\":\\\"thread.started\\\",\\\"thread_id\\\":\\\"x\\\"}\\\\n'\\n                   '{\\\"type\\\":\\\"turn.started\\\"}\\\\n')\\n    exit_line = \\\"[adapter exited 1]\\\"\\n    verify = {\\n        \\\"status\\\": \\\"failed\\\", \\\"record_version\\\": 3,\\n        \\\"stop\\\": {\\\"class\\\": \\\"unclassed\\\", \\\"provenance\\\": \\\"product\\\", \\\"detail\\\": exit_line},\\n    }\\n    cases = {\\n        \\\"with_message\\\": (\\n            '{\\\"type\\\":\\\"error\\\",\\\"message\\\":\\\"Selected model is at capacity. '\\n            'Please try a different model.\\\"}\\\\n', True),\\n        \\\"empty_message\\\": ('{\\\"type\\\":\\\"error\\\",\\\"message\\\":\\\"\\\"}\\\\n', False),\\n        \\\"missing_message\\\": ('{\\\"type\\\":\\\"error\\\"}\\\\n', False),\\n    }\\n    for name, (error_line, holds) in cases.items():\\n        root = tmp_path / name\\n        root.mkdir()\\n        (root / \\\"attavo.toml\\\").write_text('[paths]\\\\nrecords = \\\"records\\\"\\\\n')\\n        init_repo(root, \\\"install\\\")\\n\\n        records = root / \\\"records\\\" / \\\"1\\\"\\n        records.mkdir(parents=True)\\n        (records / \\\"verify-01.json\\\").write_text(json.dumps(verify))\\n        (records / \\\"verify-01.log\\\").write_text(event_lines + error_line + exit_line)\\n        commit_all(root, f\\\"a failed verify whose log has an error event: {name}\\\")\\n\\n        p = run_doctor(root)[\\\"no-stop-lacks-cause\\\"]\\n        assert p[\\\"holds\\\"] is holds, (name, p[\\\"reason\\\"])\\n        if not holds:\\n            assert \\\"tool's own error line is owed\\\" in p[\\\"reason\\\"], name\\n\\n\\ndef test_doctor_proof_four_fails_on_an_unclassed_stop_with_no_detail(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"An unclassed stop's whole contract is its detail (issue #89):\\n    with none, the record is exactly as unexplained as no stop at all.\\\"\\\"\\\"\\n    root = tmp_path / \\\"unclassed_no_detail\\\"\\n    root.mkdir()\\n    (root / \\\"attavo.toml\\\").write_text('[paths]\\\\nrecords = \\\"records\\\"\\\\n')\\n    init_repo(root, \\\"install\\\")\\n\\n    records = root / \\\"records\\\" / \\\"1\\\"\\n    records.mkdir(parents=True)\\n    build = {\\\"status\\\": \\\"failed\\\", \\\"record_version\\\": 3,\\n            \\\"stop\\\": {\\\"class\\\": \\\"unclassed\\\", \\\"provenance\\\": \\\"product\\\", \\\"detail\\\": None}}\\n    (records / \\\"build-01.json\\\").write_text(json.dumps(build))\\n    commit_all(root, \\\"an unclassed stop with no detail\\\")\\n\\n    p = run_doctor(root)[\\\"no-stop-lacks-cause\\\"]\\n    assert not p[\\\"holds\\\"]\\n    assert \\\"unclassed with no detail\\\" in p[\\\"reason\\\"]\\n\\n\\nFULL_DRIVE_TABLE = ('[drive]\\\\nstall_after_s = 60\\\\nattempts = 3\\\\n\\\\n'\\n                    '[drive.build]\\\\nceiling_s = 600\\\\n\\\\n[drive.verify]\\\\nceiling_s = 600\\\\n')\\n\\n\\ndef _dead_pid() -> int:\\n    \\\"\\\"\\\"A pid guaranteed not to be running: a real child, spawned and\\n    reaped, on this host.\\\"\\\"\\\"\\n    proc = subprocess.Popen([sys.executable, \\\"-c\\\", \\\"pass\\\"])\\n    proc.wait()\\n    return proc.pid\\n\\n\\ndef test_doctor_proof_five_fails_on_a_dead_invocation_with_no_record(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Issue #151: a build-01.started marker naming a dead pid on this\\n    host, with no build-01.json to retire it, is exactly the silence two\\n    build attempts of item #148 left behind -- proof five names it.\\\"\\\"\\\"\\n    root = tmp_path / \\\"dead_invocation\\\"\\n    root.mkdir()\\n    (root / \\\"attavo.toml\\\").write_text('[paths]\\\\nrecords = \\\"records\\\"\\\\n\\\\n' + FULL_DRIVE_TABLE)\\n    init_repo(root, \\\"install\\\")\\n\\n    records = root / \\\"records\\\" / \\\"1\\\"\\n    records.mkdir(parents=True)\\n    (records / \\\"build-01.started\\\").write_text(json.dumps({\\n        \\\"at\\\": \\\"2026-09-17T13:16:08Z\\\", \\\"host\\\": socket.gethostname(), \\\"pid\\\": _dead_pid(),\\n        \\\"sha\\\": \\\"0\\\" * 40, \\\"product_version\\\": \\\"fixture\\\"}))\\n    commit_all(root, \\\"invocation marker for item 1\\\")\\n\\n    p = run_doctor(root)[\\\"no-invocation-lacks-record\\\"]\\n    assert not p[\\\"holds\\\"]\\n    assert \\\"build-01\\\" in p[\\\"reason\\\"] and \\\"never wrote its record\\\" in p[\\\"reason\\\"]\\n\\n\\ndef test_doctor_proof_five_holds_once_the_record_arrives(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"The same marker, retired by its own build-01.json: proof five\\n    holds -- the record's arrival is what retires a marker, not its\\n    removal.\\\"\\\"\\\"\\n    root = tmp_path / \\\"recorded_invocation\\\"\\n    root.mkdir()\\n    (root / \\\"attavo.toml\\\").write_text('[paths]\\\\nrecords = \\\"records\\\"\\\\n\\\\n' + FULL_DRIVE_TABLE)\\n    init_repo(root, \\\"install\\\")\\n\\n    records = root / \\\"records\\\" / \\\"1\\\"\\n    records.mkdir(parents=True)\\n    (records / \\\"build-01.started\\\").write_text(json.dumps({\\n        \\\"at\\\": \\\"2026-09-17T13:16:08Z\\\", \\\"host\\\": socket.gethostname(), \\\"pid\\\": _dead_pid(),\\n        \\\"sha\\\": \\\"0\\\" * 40, \\\"product_version\\\": \\\"fixture\\\"}))\\n    (records / \\\"build-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\"}))\\n    commit_all(root, \\\"invocation marker and its record for item 1\\\")\\n\\n    p = run_doctor(root)[\\\"no-invocation-lacks-record\\\"]\\n    assert p[\\\"holds\\\"], p[\\\"reason\\\"]\\n\\n\\ndef test_doctor_proof_five_reports_a_live_invocation_as_running_not_failed(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"A marker naming this test's own pid, on this host, with no\\n    record: alive, so proof five holds and names it running rather than\\n    failing the tenant for a drive that has not had the chance to finish\\n    yet.\\\"\\\"\\\"\\n    root = tmp_path / \\\"live_invocation\\\"\\n    root.mkdir()\\n    (root / \\\"attavo.toml\\\").write_text('[paths]\\\\nrecords = \\\"records\\\"\\\\n\\\\n' + FULL_DRIVE_TABLE)\\n    init_repo(root, \\\"install\\\")\\n\\n    records = root / \\\"records\\\" / \\\"1\\\"\\n    records.mkdir(parents=True)\\n    (records / \\\"build-01.started\\\").write_text(json.dumps({\\n        \\\"at\\\": \\\"2026-09-17T13:16:08Z\\\", \\\"host\\\": socket.gethostname(), \\\"pid\\\": os.getpid(),\\n        \\\"sha\\\": \\\"0\\\" * 40, \\\"product_version\\\": \\\"fixture\\\"}))\\n    commit_all(root, \\\"invocation marker for a still-running invocation\\\")\\n\\n    p = run_doctor(root)[\\\"no-invocation-lacks-record\\\"]\\n    assert p[\\\"holds\\\"], p[\\\"reason\\\"]\\n    assert len(p[\\\"running_invocations\\\"]) == 1\\n    assert \\\"build-01\\\" in p[\\\"running_invocations\\\"][0]\\n\\n\\ndef test_doctor_proof_five_fails_without_stall_after_s_in_the_manifest(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"A tenant with no [drive].stall_after_s carries no bound past which\\n    a live invocation is hung -- proof five cannot tell a hung drive from\\n    a running one, and refuses to guess a default.\\\"\\\"\\\"\\n    root = tmp_path / \\\"no_stall_bound\\\"\\n    root.mkdir()\\n    (root / \\\"attavo.toml\\\").write_text('[paths]\\\\nrecords = \\\"records\\\"\\\\n')\\n    init_repo(root, \\\"install\\\")\\n\\n    records = root / \\\"records\\\" / \\\"1\\\"\\n    records.mkdir(parents=True)\\n    (records / \\\"build-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\"}))\\n    commit_all(root, \\\"a record with no [drive].stall_after_s declared\\\")\\n\\n    p = run_doctor(root)[\\\"no-invocation-lacks-record\\\"]\\n    assert not p[\\\"holds\\\"]\\n    assert \\\"stall_after_s\\\" in p[\\\"reason\\\"]\\n\\n\\ndef test_doctor_refuses_a_drive_table_without_ceilings(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"R3: a [drive] table that declares a stall bound and no\\n    [drive.build].ceiling_s or [drive.verify].ceiling_s carries no bound\\n    past which a live stage is hung by wall clock -- proof five refuses\\n    to guess one, as it refuses to guess the stall bound.\\\"\\\"\\\"\\n    root = tmp_path / \\\"no_ceilings\\\"\\n    root.mkdir()\\n    (root / \\\"attavo.toml\\\").write_text(\\n        '[paths]\\\\nrecords = \\\"records\\\"\\\\n\\\\n[drive]\\\\nstall_after_s = 60\\\\nattempts = 3\\\\n')\\n    init_repo(root, \\\"install\\\")\\n\\n    records = root / \\\"records\\\" / \\\"1\\\"\\n    records.mkdir(parents=True)\\n    (records / \\\"build-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\"}))\\n    commit_all(root, \\\"a drive table with no ceilings\\\")\\n\\n    p = run_doctor(root)[\\\"no-invocation-lacks-record\\\"]\\n    assert not p[\\\"holds\\\"]\\n    assert \\\"ceiling\\\" in p[\\\"reason\\\"]\\n\\n\\ndef test_doctor_refuses_a_drive_table_without_attempts(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"R3: a [drive] table with both ceilings and a stall bound but no\\n    [drive].attempts carries no bound on how many attempts a retryable\\n    stop may spend -- proof five refuses to guess a default here too.\\\"\\\"\\\"\\n    root = tmp_path / \\\"no_attempts\\\"\\n    root.mkdir()\\n    (root / \\\"attavo.toml\\\").write_text(\\n        '[paths]\\\\nrecords = \\\"records\\\"\\\\n\\\\n[drive]\\\\nstall_after_s = 60\\\\n\\\\n'\\n        '[drive.build]\\\\nceiling_s = 600\\\\n\\\\n[drive.verify]\\\\nceiling_s = 600\\\\n')\\n    init_repo(root, \\\"install\\\")\\n\\n    records = root / \\\"records\\\" / \\\"1\\\"\\n    records.mkdir(parents=True)\\n    (records / \\\"build-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\"}))\\n    commit_all(root, \\\"a drive table with no attempts budget\\\")\\n\\n    p = run_doctor(root)[\\\"no-invocation-lacks-record\\\"]\\n    assert not p[\\\"holds\\\"]\\n    assert \\\"attempts\\\" in p[\\\"reason\\\"]\\n\\n\\n# --- proof seven: no attested item is empty (item 227). Rejection tests,\\n# written red first against v0.29.0, whose doctor had six proofs and held\\n# over an attested item whose build committed nothing. ---\\n\\n\\ndef _head(root: Path) -> str:\\n    return subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"rev-parse\\\", \\\"HEAD\\\"], capture_output=True,\\n                          text=True, check=True).stdout.strip()\\n\\n\\ndef _four_stage_item(root: Path, approval_sha: str, *, change: bool) -> tuple[str, str]:\\n    \\\"\\\"\\\"One item, four records, merged --no-ff; returns (merge_sha, build_sha).\\n    change=True lands a real content commit before the records, so the\\n    tree genuinely differs from approval_sha outside records/; change=False\\n    leaves the tree exactly as approval_sha left it -- item 227's own\\n    build, and item 229's own fix for a retried attempt that adds no\\n    commit of its own but already carries one.\\\"\\\"\\\"\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"-q\\\", \\\"-b\\\", \\\"attavo/1-x\\\"], check=True)\\n    if change:\\n        (root / \\\"changed.txt\\\").write_text(\\\"the item's own change\\\\n\\\")\\n        commit_all(root, \\\"the item's own change\\\")\\n    build_sha = _head(root)\\n    records = root / \\\"records\\\" / \\\"1\\\"\\n    records.mkdir(parents=True)\\n    (records / \\\"spec-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\"}))\\n    (records / \\\"approval-01.json\\\").write_text(json.dumps({\\\"approved_by\\\": \\\"alice\\\"}))\\n    (records / \\\"build-01.json\\\").write_text(json.dumps(\\n        {\\\"status\\\": \\\"pass\\\", \\\"sha\\\": build_sha, \\\"start_sha\\\": approval_sha,\\n         \\\"approval_sha\\\": approval_sha}))\\n    (records / \\\"verify-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\"}))\\n    commit_all(root, \\\"spec, approval, build, and verify records\\\")\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"-q\\\", \\\"main\\\"], check=True)\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"merge\\\", \\\"-q\\\", \\\"--no-ff\\\", \\\"-m\\\",\\n                    \\\"Merge branch 'attavo/1-x'\\\", \\\"attavo/1-x\\\"], check=True)\\n    return _head(root), build_sha\\n\\n\\ndef test_doctor_proof_seven_fails_on_an_attested_item_whose_build_committed_nothing(tmp_path: Path) -> None:\\n    root = tmp_path / \\\"empty_item\\\"\\n    root.mkdir()\\n    (root / \\\"attavo.toml\\\").write_text('[paths]\\\\nrecords = \\\"records\\\"\\\\n')\\n    init_repo(root, \\\"install\\\")\\n    approval_sha = _head(root)\\n    merge, _ = _four_stage_item(root, approval_sha, change=False)\\n    report = run_doctor(root)\\n    assert \\\"no-attested-item-is-empty\\\" in report, sorted(report)\\n    p = report[\\\"no-attested-item-is-empty\\\"]\\n    assert not p[\\\"holds\\\"], p\\n    assert \\\"item 1\\\" in p[\\\"reason\\\"] and \\\"nothing was built\\\" in p[\\\"reason\\\"] and merge[:12] in p[\\\"reason\\\"], p[\\\"reason\\\"]\\n\\n\\ndef test_doctor_proof_seven_holds_on_a_build_that_names_a_change_and_names_the_specimen_before_its_window(tmp_path: Path) -> None:\\n    built = tmp_path / \\\"built_item\\\"\\n    built.mkdir()\\n    (built / \\\"attavo.toml\\\").write_text('[paths]\\\\nrecords = \\\"records\\\"\\\\n')\\n    init_repo(built, \\\"install\\\")\\n    _four_stage_item(built, _head(built), change=True)\\n    p = run_doctor(built)[\\\"no-attested-item-is-empty\\\"]\\n    assert p[\\\"holds\\\"], p[\\\"reason\\\"]\\n    assert p[\\\"built\\\"] == [\\\"1\\\"], p\\n\\n    windowed = tmp_path / \\\"windowed_item\\\"\\n    windowed.mkdir()\\n    (windowed / \\\"attavo.toml\\\").write_text('[paths]\\\\nrecords = \\\"records\\\"\\\\n')\\n    init_repo(windowed, \\\"install\\\")\\n    approval_sha = _head(windowed)\\n    merge, _ = _four_stage_item(windowed, approval_sha, change=False)\\n    toml = windowed / \\\"attavo.toml\\\"\\n    toml.write_text(toml.read_text() + f'\\\\n[doctor]\\\\nbuilt_since = \\\"{merge[:12]}\\\"\\\\n')\\n    commit_all(windowed, \\\"declare the window after the specimen\\\")\\n    p = run_doctor(windowed)[\\\"no-attested-item-is-empty\\\"]\\n    assert p[\\\"holds\\\"], p[\\\"reason\\\"]\\n    assert p[\\\"before_window\\\"] == [\\\"1\\\"] and \\\"before the window\\\" in p[\\\"reason\\\"], p\\n\\n\\ndef test_doctor_proof_seven_treats_a_retried_attempt_that_adopts_a_prior_commit_as_not_empty(\\n        tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Item 229: a build record whose sha equals its own start_sha is not\\n    empty when that tree already differs from the approval -- a retried\\n    attempt whose head already carries a prior attempt's valid commit\\n    owes no commit of its own (item 227's own counsel question).\\\"\\\"\\\"\\n    root = tmp_path / \\\"adopted_item\\\"\\n    root.mkdir()\\n    (root / \\\"attavo.toml\\\").write_text('[paths]\\\\nrecords = \\\"records\\\"\\\\n')\\n    init_repo(root, \\\"install\\\")\\n    approval_sha = _head(root)\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"-q\\\", \\\"-b\\\", \\\"attavo/1-x\\\"], check=True)\\n    (root / \\\"changed.txt\\\").write_text(\\\"a prior attempt's own valid commit\\\\n\\\")\\n    commit_all(root, \\\"a prior attempt's own valid commit\\\")\\n    retry_start_sha = _head(root)\\n    records = root / \\\"records\\\" / \\\"1\\\"\\n    records.mkdir(parents=True)\\n    (records / \\\"spec-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\"}))\\n    (records / \\\"approval-01.json\\\").write_text(json.dumps({\\\"approved_by\\\": \\\"alice\\\"}))\\n    (records / \\\"build-02.json\\\").write_text(json.dumps(\\n        {\\\"status\\\": \\\"pass\\\", \\\"sha\\\": retry_start_sha, \\\"start_sha\\\": retry_start_sha,\\n         \\\"approval_sha\\\": approval_sha}))\\n    (records / \\\"verify-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\"}))\\n    commit_all(root, \\\"spec, approval, build, and verify records\\\")\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"-q\\\", \\\"main\\\"], check=True)\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"merge\\\", \\\"-q\\\", \\\"--no-ff\\\", \\\"-m\\\",\\n                    \\\"Merge branch 'attavo/1-x'\\\", \\\"attavo/1-x\\\"], check=True)\\n    p = run_doctor(root)[\\\"no-attested-item-is-empty\\\"]\\n    assert p[\\\"holds\\\"], p[\\\"reason\\\"]\\n    assert p[\\\"built\\\"] == [\\\"1\\\"], p\\n\\n\\ndef test_doctor_proof_seven_names_a_build_with_no_readable_approval_as_not_read(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Item 229: a build record whose approval_sha does not resolve in this\\n    repository is counted as not readable, not failed -- an unprovable\\n    build is not asserted empty.\\\"\\\"\\\"\\n    root = tmp_path / \\\"unreadable_item\\\"\\n    root.mkdir()\\n    (root / \\\"attavo.toml\\\").write_text('[paths]\\\\nrecords = \\\"records\\\"\\\\n')\\n    init_repo(root, \\\"install\\\")\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"-q\\\", \\\"-b\\\", \\\"attavo/1-x\\\"], check=True)\\n    build_sha = _head(root)\\n    records = root / \\\"records\\\" / \\\"1\\\"\\n    records.mkdir(parents=True)\\n    (records / \\\"spec-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\"}))\\n    (records / \\\"approval-01.json\\\").write_text(json.dumps({\\\"approved_by\\\": \\\"alice\\\"}))\\n    (records / \\\"build-01.json\\\").write_text(json.dumps(\\n        {\\\"status\\\": \\\"pass\\\", \\\"sha\\\": build_sha, \\\"start_sha\\\": build_sha, \\\"approval_sha\\\": \\\"f\\\" * 40}))\\n    (records / \\\"verify-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\"}))\\n    commit_all(root, \\\"spec, approval, build, and verify records\\\")\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"-q\\\", \\\"main\\\"], check=True)\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"merge\\\", \\\"-q\\\", \\\"--no-ff\\\", \\\"-m\\\",\\n                    \\\"Merge branch 'attavo/1-x'\\\", \\\"attavo/1-x\\\"], check=True)\\n    p = run_doctor(root)[\\\"no-attested-item-is-empty\\\"]\\n    assert p[\\\"holds\\\"], p[\\\"reason\\\"]\\n    assert p[\\\"not_read\\\"] == [\\\"1\\\"], p\\n\\n\\ndef test_no_attested_item_is_empty() -> None:\\n    \\\"\\\"\\\"Proof 7, item 227. On this repository the specimen, #227, is named\\n    before the window ([doctor].built_since) and every later attested\\n    item's build names a change.\\\"\\\"\\\"\\n    p = run_doctor(ROOT)[\\\"no-attested-item-is-empty\\\"]\\n    assert p[\\\"holds\\\"], p[\\\"reason\\\"]\\n\",\"numLines\":1085,\"startLine\":1,\"totalLines\":1085}}}\n+{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01D6skmfQhfJ1xiAi5yCcFFc\",\"type\":\"tool_result\",\"content\":\"name: CI\\n\\n# issue #210: push runs on main only. An item's branch always has an open\\n# pull request, so every branch push was a second run of what pull_request\\n# already ran. A branch with no pull request gets no CI.\\non:\\n  push:\\n    branches: [main]\\n  pull_request:\\n  merge_group:\\n\\njobs:\\n  # issue #210: on a pull request, a head whose commits since a green run\\n  # touch only the records directory inherits that run's `test` instead of\\n  # running the suite again; the tests that read the repository's own\\n  # records (@pytest.mark.own_records) still run. scripts/ci_inherit.py\\n  # decides, and every doubt (no concluded success to inherit, an API read\\n  # that fails, a shallow clone, a merge commit) is run-in-full. merge_group\\n  # never reaches the script: the queue's run is the law and is never\\n  # inherited. The inherit step's output is 'true' only when the script\\n  # says so; anything else, including the step not running, runs the suite.\\n  test:\\n    runs-on: ubuntu-latest\\n    permissions:\\n      contents: read\\n      checks: read\\n    steps:\\n      - uses: actions/checkout@v4\\n        with:\\n          fetch-depth: 0\\n      - uses: actions/setup-python@v5\\n        with:\\n          python-version: \\\"3.11\\\"\\n      - name: inherit test from a records-only head\\n        id: inherit\\n        if: github.event_name == 'pull_request'\\n        run: python3 scripts/ci_inherit.py test\\n        env:\\n          GH_TOKEN: ${{ github.token }}\\n      - run: pip install pytest jsonschema\\n      - name: pytest, only the tests that read this repository's own records\\n        if: steps.inherit.outputs.inherit == 'true'\\n        run: python3 -m pytest tests -q -m own_records\\n      # issue #181: the suite's own clock is bounded. --durations=5 puts the\\n      # five slowest tests on every run's log; the last step fails the job\\n      # when the pytest step took more than 180 s (the suite's baseline is\\n      # about 65 s), naming the elapsed seconds.\\n      - name: pytest start\\n        if: steps.inherit.outputs.inherit != 'true'\\n        run: echo \\\"PYTEST_START=$(date +%s)\\\" >> \\\"$GITHUB_ENV\\\"\\n      - name: pytest\\n        if: steps.inherit.outputs.inherit != 'true'\\n        run: >\\n          python3 -m pytest tests -q --durations=5\\n          --deselect tests/test_doctor.py::test_every_gate_rejects\\n          --deselect tests/test_doctor.py::test_one_item_traversed_every_stage\\n          --deselect tests/test_doctor.py::test_no_commit_lacks_a_record\\n          --deselect tests/test_doctor.py::test_no_stop_lacks_cause\\n          --deselect tests/test_doctor.py::test_every_attested_item_is_sealed\\n          --deselect tests/test_doctor.py::test_no_attested_item_is_empty\\n      - name: pytest end\\n        if: steps.inherit.outputs.inherit != 'true'\\n        run: echo \\\"PYTEST_END=$(date +%s)\\\" >> \\\"$GITHUB_ENV\\\"\\n      - name: the suite's wall clock is at most 180 s\\n        if: steps.inherit.outputs.inherit != 'true'\\n        run: |\\n          elapsed=$((PYTEST_END - PYTEST_START))\\n          echo \\\"pytest step took ${elapsed} s\\\"\\n          if [ \\\"$elapsed\\\" -gt 180 ]; then\\n            echo \\\"::error::the pytest step took ${elapsed} s, over the 180 s bound\\\"\\n            exit 1\\n          fi\\n\\n  # issue #189: mypy --strict over attavo/, bin/attavo, and tests/\\n  # (pyproject.toml's [tool.mypy] names the files and the interpreter; pytest\\n  # and jsonschema are installed for the tests' own imports). setup-python pins the\\n  # same python_version that table names; tests/test_typecheck_pin.py fails\\n  # when the two disagree. mypy itself is pinned so a new release's checks\\n  # never turn a required context red on a commit that did not change.\\n  # issue #210: the type check reads attavo/, bin/attavo, and tests/, never\\n  # the records directory, so a records-only pull request head inherits a\\n  # concluded success of it the way `test` does (see the note above `test`).\\n  typecheck:\\n    runs-on: ubuntu-latest\\n    permissions:\\n      contents: read\\n      checks: read\\n    steps:\\n      - uses: actions/checkout@v4\\n        with:\\n          fetch-depth: 0\\n      - uses: actions/setup-python@v5\\n        with:\\n          python-version: \\\"3.11\\\"\\n      - name: inherit typecheck from a records-only head\\n        id: inherit\\n        if: github.event_name == 'pull_request'\\n        run: python3 scripts/ci_inherit.py typecheck\\n        env:\\n          GH_TOKEN: ${{ github.token }}\\n      - name: install mypy and the tests' own imports\\n        if: steps.inherit.outputs.inherit != 'true'\\n        run: pip install mypy==2.3.1 pytest jsonschema types-jsonschema==4.26.0.20260518\\n      - name: mypy\\n        if: steps.inherit.outputs.inherit != 'true'\\n        run: python3 -m mypy\\n\\n  # Since #103, this repository is Attavo's own second tenant (attavo.toml\\n  # at the root) and the doctor's five proofs run for real, not under\\n  # || true. #106's first item merged (fdd1981, v0.18.0), so the five\\n  # proofs hold on main and this job reports on pull requests and merge\\n  # groups too -- where a refusal is cheap. It does not report on a\\n  # branch push: a branch's own boundary commits precede their records,\\n  # so proof three (no commit lacks a record) cannot hold there (#113).\\n  doctor:\\n    if: github.event_name == 'pull_request' || github.event_name == 'merge_group' || github.ref == 'refs/heads/main'\\n    runs-on: ubuntu-latest\\n    permissions:\\n      contents: read\\n      attestations: read\\n    env:\\n      # issue #158, amended after build-05: every step that runs the\\n      # doctor -- the pytest step and the bin/attavo invocation both --\\n      # reads the attestation store through [forge].attestation_command,\\n      # which shells out to `gh`. A token scoped to only the last step\\n      # left the pytest step reading an unauthenticated store, which\\n      # exits 2 (not read), not the 404 (unsealed) the proof expects.\\n      GH_TOKEN: ${{ github.token }}\\n    steps:\\n      - uses: actions/checkout@v4\\n        with:\\n          fetch-depth: 0\\n      # issue #169: _merges_reachable reads refs/remotes/origin/HEAD to\\n      # name the default branch without hard-coding \\\"main\\\"; actions/checkout\\n      # does not set it, so every trigger this job runs on -- pull_request,\\n      # merge_group, and push -- needs it set explicitly, after the fetch.\\n      - run: git remote set-head origin -a\\n      - uses: actions/setup-python@v5\\n        with:\\n          python-version: \\\"3.11\\\"\\n      - run: pip install pytest jsonschema\\n      - name: doctor's five proofs\\n        run: python3 -m pytest tests/test_doctor.py -q -k \\\"every_gate_rejects or one_item_traversed_every_stage or no_commit_lacks_a_record or no_stop_lacks_cause or every_attested_item_is_sealed\\\"\\n      - run: python3 bin/attavo doctor .\\n\\n  action-self-check:\\n    runs-on: ubuntu-latest\\n    steps:\\n      - uses: actions/checkout@v4\\n        with:\\n          fetch-depth: 0\\n      - uses: ./\\n      - run: test \\\"$ATTAVO_ATTESTATION_PREDICATE_TYPE\\\" = \\\"$(python3 -c \\\"import json; print(json.load(open('schema/attestation.schema.json'))['\\\\$id'])\\\")\\\"\\n      - run: attavo spec-gate\\n        working-directory: tests/fixtures/valid\\n        env:\\n          ATTAVO_ITEM: \\\"1\\\"\\n\\n  # merge_group added alongside pull_request (#103): the merge queue\\n  # requires every required check to report on the merge group, not only\\n  # on the pull request that entered it (tenant zero's #662 was the same\\n  # class of miss, on pull_request only). github.base_ref is empty on a\\n  # merge_group event; the target branch comes from\\n  # github.event.merge_group.base_ref there instead.\\n  schema-version:\\n    if: github.event_name == 'pull_request' || github.event_name == 'merge_group'\\n    runs-on: ubuntu-latest\\n    steps:\\n      - uses: actions/checkout@v4\\n        with:\\n          fetch-depth: 0\\n      - uses: actions/setup-python@v5\\n        with:\\n          python-version: \\\"3.11\\\"\\n      - name: Resolve the target branch\\n        id: base\\n        run: |\\n          if [ \\\"${{ github.event_name }}\\\" = \\\"merge_group\\\" ]; then\\n            branch=\\\"${{ github.event.merge_group.base_ref }}\\\"\\n            branch=\\\"${branch#refs/heads/}\\\"\\n          else\\n            branch=\\\"${{ github.base_ref }}\\\"\\n          fi\\n          echo \\\"branch=$branch\\\" >> \\\"$GITHUB_OUTPUT\\\"\\n      - run: git fetch --no-tags origin \\\"${{ steps.base.outputs.branch }}\\\"\\n      - run: python3 scripts/check_record_schema_version.py \\\"origin/${{ steps.base.outputs.branch }}\\\"\",\"is_error\":false}]},\"parent_tool_use_id\":null,\"session_id\":\"5a752ff7-c430-4cfd-9b9a-21883129b5e6\",\"uuid\":\"4b6f519c-5cda-493b-85c8-d2f67cff0a88\",\"timestamp\":\"2026-09-27T20:32:13.445Z\",\"tool_use_result\":{\"stdout\":\"name: CI\\n\\n# issue #210: push runs on main only. An item's branch always has an open\\n# pull request, so every branch push was a second run of what pull_request\\n# already ran. A branch with no pull request gets no CI.\\non:\\n  push:\\n    branches: [main]\\n  pull_request:\\n  merge_group:\\n\\njobs:\\n  # issue #210: on a pull request, a head whose commits since a green run\\n  # touch only the records directory inherits that run's `test` instead of\\n  # running the suite again; the tests that read the repository's own\\n  # records (@pytest.mark.own_records) still run. scripts/ci_inherit.py\\n  # decides, and every doubt (no concluded success to inherit, an API read\\n  # that fails, a shallow clone, a merge commit) is run-in-full. merge_group\\n  # never reaches the script: the queue's run is the law and is never\\n  # inherited. The inherit step's output is 'true' only when the script\\n  # says so; anything else, including the step not running, runs the suite.\\n  test:\\n    runs-on: ubuntu-latest\\n    permissions:\\n      contents: read\\n      checks: read\\n    steps:\\n      - uses: actions/checkout@v4\\n        with:\\n          fetch-depth: 0\\n      - uses: actions/setup-python@v5\\n        with:\\n          python-version: \\\"3.11\\\"\\n      - name: inherit test from a records-only head\\n        id: inherit\\n        if: github.event_name == 'pull_request'\\n        run: python3 scripts/ci_inherit.py test\\n        env:\\n          GH_TOKEN: ${{ github.token }}\\n      - run: pip install pytest jsonschema\\n      - name: pytest, only the tests that read this repository's own records\\n        if: steps.inherit.outputs.inherit == 'true'\\n        run: python3 -m pytest tests -q -m own_records\\n      # issue #181: the suite's own clock is bounded. --durations=5 puts the\\n      # five slowest tests on every run's log; the last step fails the job\\n      # when the pytest step took more than 180 s (the suite's baseline is\\n      # about 65 s), naming the elapsed seconds.\\n      - name: pytest start\\n        if: steps.inherit.outputs.inherit != 'true'\\n        run: echo \\\"PYTEST_START=$(date +%s)\\\" >> \\\"$GITHUB_ENV\\\"\\n      - name: pytest\\n        if: steps.inherit.outputs.inherit != 'true'\\n        run: >\\n          python3 -m pytest tests -q --durations=5\\n          --deselect tests/test_doctor.py::test_every_gate_rejects\\n          --deselect tests/test_doctor.py::test_one_item_traversed_every_stage\\n          --deselect tests/test_doctor.py::test_no_commit_lacks_a_record\\n          --deselect tests/test_doctor.py::test_no_stop_lacks_cause\\n          --deselect tests/test_doctor.py::test_every_attested_item_is_sealed\\n          --deselect tests/test_doctor.py::test_no_attested_item_is_empty\\n      - name: pytest end\\n        if: steps.inherit.outputs.inherit != 'true'\\n        run: echo \\\"PYTEST_END=$(date +%s)\\\" >> \\\"$GITHUB_ENV\\\"\\n      - name: the suite's wall clock is at most 180 s\\n        if: steps.inherit.outputs.inherit != 'true'\\n        run: |\\n          elapsed=$((PYTEST_END - PYTEST_START))\\n          echo \\\"pytest step took ${elapsed} s\\\"\\n          if [ \\\"$elapsed\\\" -gt 180 ]; then\\n            echo \\\"::error::the pytest step took ${elapsed} s, over the 180 s bound\\\"\\n            exit 1\\n          fi\\n\\n  # issue #189: mypy --strict over attavo/, bin/attavo, and tests/\\n  # (pyproject.toml's [tool.mypy] names the files and the interpreter; pytest\\n  # and jsonschema are installed for the tests' own imports). setup-python pins the\\n  # same python_version that table names; tests/test_typecheck_pin.py fails\\n  # when the two disagree. mypy itself is pinned so a new release's checks\\n  # never turn a required context red on a commit that did not change.\\n  # issue #210: the type check reads attavo/, bin/attavo, and tests/, never\\n  # the records directory, so a records-only pull request head inherits a\\n  # concluded success of it the way `test` does (see the note above `test`).\\n  typecheck:\\n    runs-on: ubuntu-latest\\n    permissions:\\n      contents: read\\n      checks: read\\n    steps:\\n      - uses: actions/checkout@v4\\n        with:\\n          fetch-depth: 0\\n      - uses: actions/setup-python@v5\\n        with:\\n          python-version: \\\"3.11\\\"\\n      - name: inherit typecheck from a records-only head\\n        id: inherit\\n        if: github.event_name == 'pull_request'\\n        run: python3 scripts/ci_inherit.py typecheck\\n        env:\\n          GH_TOKEN: ${{ github.token }}\\n      - name: install mypy and the tests' own imports\\n        if: steps.inherit.outputs.inherit != 'true'\\n        run: pip install mypy==2.3.1 pytest jsonschema types-jsonschema==4.26.0.20260518\\n      - name: mypy\\n        if: steps.inherit.outputs.inherit != 'true'\\n        run: python3 -m mypy\\n\\n  # Since #103, this repository is Attavo's own second tenant (attavo.toml\\n  # at the root) and the doctor's five proofs run for real, not under\\n  # || true. #106's first item merged (fdd1981, v0.18.0), so the five\\n  # proofs hold on main and this job reports on pull requests and merge\\n  # groups too -- where a refusal is cheap. It does not report on a\\n  # branch push: a branch's own boundary commits precede their records,\\n  # so proof three (no commit lacks a record) cannot hold there (#113).\\n  doctor:\\n    if: github.event_name == 'pull_request' || github.event_name == 'merge_group' || github.ref == 'refs/heads/main'\\n    runs-on: ubuntu-latest\\n    permissions:\\n      contents: read\\n      attestations: read\\n    env:\\n      # issue #158, amended after build-05: every step that runs the\\n      # doctor -- the pytest step and the bin/attavo invocation both --\\n      # reads the attestation store through [forge].attestation_command,\\n      # which shells out to `gh`. A token scoped to only the last step\\n      # left the pytest step reading an unauthenticated store, which\\n      # exits 2 (not read), not the 404 (unsealed) the proof expects.\\n      GH_TOKEN: ${{ github.token }}\\n    steps:\\n      - uses: actions/checkout@v4\\n        with:\\n          fetch-depth: 0\\n      # issue #169: _merges_reachable reads refs/remotes/origin/HEAD to\\n      # name the default branch without hard-coding \\\"main\\\"; actions/checkout\\n      # does not set it, so every trigger this job runs on -- pull_request,\\n      # merge_group, and push -- needs it set explicitly, after the fetch.\\n      - run: git remote set-head origin -a\\n      - uses: actions/setup-python@v5\\n        with:\\n          python-version: \\\"3.11\\\"\\n      - run: pip install pytest jsonschema\\n      - name: doctor's five proofs\\n        run: python3 -m pytest tests/test_doctor.py -q -k \\\"every_gate_rejects or one_item_traversed_every_stage or no_commit_lacks_a_record or no_stop_lacks_cause or every_attested_item_is_sealed\\\"\\n      - run: python3 bin/attavo doctor .\\n\\n  action-self-check:\\n    runs-on: ubuntu-latest\\n    steps:\\n      - uses: actions/checkout@v4\\n        with:\\n          fetch-depth: 0\\n      - uses: ./\\n      - run: test \\\"$ATTAVO_ATTESTATION_PREDICATE_TYPE\\\" = \\\"$(python3 -c \\\"import json; print(json.load(open('schema/attestation.schema.json'))['\\\\$id'])\\\")\\\"\\n      - run: attavo spec-gate\\n        working-directory: tests/fixtures/valid\\n        env:\\n          ATTAVO_ITEM: \\\"1\\\"\\n\\n  # merge_group added alongside pull_request (#103): the merge queue\\n  # requires every required check to report on the merge group, not only\\n  # on the pull request that entered it (tenant zero's #662 was the same\\n  # class of miss, on pull_request only). github.base_ref is empty on a\\n  # merge_group event; the target branch comes from\\n  # github.event.merge_group.base_ref there instead.\\n  schema-version:\\n    if: github.event_name == 'pull_request' || github.event_name == 'merge_group'\\n    runs-on: ubuntu-latest\\n    steps:\\n      - uses: actions/checkout@v4\\n        with:\\n          fetch-depth: 0\\n      - uses: actions/setup-python@v5\\n        with:\\n          python-version: \\\"3.11\\\"\\n      - name: Resolve the target branch\\n        id: base\\n        run: |\\n          if [ \\\"${{ github.event_name }}\\\" = \\\"merge_group\\\" ]; then\\n            branch=\\\"${{ github.event.merge_group.base_ref }}\\\"\\n            branch=\\\"${branch#refs/heads/}\\\"\\n          else\\n            branch=\\\"${{ github.base_ref }}\\\"\\n          fi\\n          echo \\\"branch=$branch\\\" >> \\\"$GITHUB_OUTPUT\\\"\\n      - run: git fetch --no-tags origin \\\"${{ steps.base.outputs.branch }}\\\"\\n      - run: python3 scripts/check_record_schema_version.py \\\"origin/${{ steps.base.outputs.branch }}\\\"\",\"stderr\":\"\",\"interrupted\":false,\"isImage\":false,\"noOutputExpected\":false}}\n+{\"type\":\"assistant\",\"message\":{\"model\":\"claude-sonnet-5\",\"id\":\"msg_011CfUac7ELuX2dV7wxVPLW7\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_017XpGCmBn6nffaYerxbrtbm\",\"name\":\"Bash\",\"input\":{\"command\":\"ls attest/ && cat attest/buckets.md 2>/dev/null; echo \\\"---rulings---\\\"; cat attest/rulings.md 2>/dev/null | tail -100\"},\"caller\":{\"type\":\"direct\"}}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":7406,\"cache_read_input_tokens\":31112,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":7406},\"output
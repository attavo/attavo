\\\\\"-m pytest\\\\\\\", \\\\\\\"\\\\\\\"), \\\\\\\"the full path runs every test\\\\\\\"\\\\n+    # The two paths partition the suite by one marker: the inherit path\\\\n+    # runs the own-records tests and the full path runs everything else.\\\\n+    # Together they are the whole suite; no test is named in either.\\\\n+    assert \\\\\\\"-m 'not own_records'\\\\\\\" in full[0], full[0]\\\\n+    assert \\\\\\\"--deselect\\\\\\\" not in full[0], \\\\\\\"a test named by hand is a list that goes stale (#229 build-04)\\\\\\\"\\\\n \\\\n \\\\n def test_the_queue_has_no_path_to_the_script() -> None:\\\\ndiff --git a/tests/test_cli_help.py b/tests/test_cli_help.py\\\\nindex 6994db3..7c191b8 100644\\\\n--- a/tests/test_cli_help.py\\\\n+++ b/tests/test_cli_help.py\\\\n@@ -94,3 +94,14 @@ def test_help_names_the_seventh_proof_and_the_empty_stop() -> None:\\\\n     assert run.returncode == 0\\\\n     for phrase in (\\\\\\\"no attested item is empty\\\\\\\", \\\\\\\"built_since\\\\\\\", \\\\\\\"committed nothing\\\\\\\", \\\\\\\"reads the commit\\\\\\\"):\\\\n         assert phrase in run.stdout, phrase\\\\n+\\\\n+\\\\n+def test_help_names_the_bucket_line_and_the_marker() -> None:\\\\n+    \\\\\\\"\\\\\\\"\\\\\\\"Item 229's fix: the spec gate's bucket refusal and the own_records\\\\n+    marker as the only way a tenant's dogfood tests are told apart. Red on\\\\n+    the tree and on the stub: the words are the build's.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n+    run = subprocess.run([sys.executable, str(ATTAVO), \\\\\\\"--help\\\\\\\"],\\\\n+                         capture_output=True, text=True, check=False)\\\\n+    assert run.returncode == 0\\\\n+    for phrase in (\\\\\\\"Bucket:\\\\\\\", \\\\\\\"buckets.md\\\\\\\", \\\\\\\"own_records\\\\\\\"):\\\\n+        assert phrase in run.stdout, phrase\\\\ndiff --git a/tests/test_spec_gate.py b/tests/test_spec_gate.py\\\\nindex 0dfc44e..63af307 100644\\\\n--- a/tests/test_spec_gate.py\\\\n+++ b/tests/test_spec_gate.py\\\\n@@ -426,3 +426,51 @@
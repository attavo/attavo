octor .\\n \\n   action-self-check:\\ndiff --git a/attavo.toml b/attavo.toml\\nindex 47c5df5..231e157 100644\\n--- a/attavo.toml\\n+++ b/attavo.toml\\n@@ -37,7 +37,7 @@ retires = [\\n [tests]\\n select = \\\"python3 .attavo/bin/select-tests\\\"\\n call_timeout_s = 240\\n-run = \\\"xargs -r python3 -m pytest -q --deselect tests/test_doctor.py::test_every_gate_rejects --deselect tests/test_doctor.py::test_one_item_traversed_every_stage --deselect tests/test_doctor.py::test_no_commit_lacks_a_record --deselect tests/test_doctor.py::test_no_stop_lacks_cause --deselect tests/test_doctor.py::test_every_attested_item_is_sealed --deselect tests/test_doctor.py::test_no_attested_item_is_empty\\\"\\n+run = \\\"xargs -r python3 -m pytest -q -m 'not own_records'\\\"\\n \\n [paths]\\n specs = \\\"attest/specs\\\"\\ndiff --git a/attavo/cli.py b/attavo/cli.py\\nindex 3d27b84..4b467dd 100644\\n--- a/attavo/cli.py\\n+++ b/attavo/cli.py\\n@@ -78,9 +78,13 @@ branch (attavo/N-*). The doctor's first proof sets ATTAVO_ITEM for a\\n rejection fixture's own item, so a gate's own command needs no argument\\n even while the enclosing repository sits on a real item's attavo/N-*\\n branch. Every run of spec-gate or approve writes the next numbered attempt\\n-file under paths.records/N/ and never overwrites one already written. See\\n-the spec contract in the project's Phase 1 issue for the full rules each\\n-one enforces.\\n+file under paths.records/N/ and never overwrites one already written. A\\n+fix item's spec names the root-cause bucket its change closes as one line\\n+in the problem, \\\"Bucket: <slug>\\\"; spec-gate refuses a bucket the tenant's\\n+buckets.md (beside paths.specs) does not list, or any bucket when that\\n+file does not exist, before any criterion runs -- a spec with no bucket\\n+line is not asked for one. See the spec contract in the project's Phase 1\\n+issue for the full rules each one enforces.\\n \\n build refuses (exit 1, naming the cause, no record) unless the manifest\\n declares [executor].build and [tests].select and [tests].run, and unless\\n@@ -154,7 +158,11 @@ selected, the exit code, and the seconds spent (or that the answer came\\n from the cache). It is the one test command an executor is given (issue\\n #212); the product's own transport -- drive, worker, build, verify,\\n counsel, file-stops -- refuses to run at all when ATTAVO_STAGE is set,\\n-since the transport is the pass's, not the executor's.\\n+since the transport is the pass's, not the executor's. The tests that\\n+read this repository's own records carry @pytest.mark.own_records, the\\n+only vocabulary that tells them apart from the rest of the suite;\\n+[tests].run and CI's full-suite step exclude them (-m 'not own_records')\\n+and the doctor job and CI's inherit path run only them (-m own_records).\\n \\n verify refuses (exit 1) unless the item's latest build record has\\n status pass, and unless the manifest declares [forge].checks_command --\\ndiff --git a/attavo/spec.py b/attavo/spec.py\\nindex 8cf623c..e263ca5 100644\\n--- a/attavo/spec.py\\n+++ b/attavo/spec.py\\n@@ -1,6 +1,7 @@\\n from __future__ import annotations\\n \\n import os\\n+import re\\n import shutil\\n import subprocess\\n import sys\\n@@ -22,6 +23,10 @@ from attavo.records import latest_record, write_record\\n \\n # --- the spec contract ---\\n \\n+BUCKET_LINE = re.compile(r\\\"^Bucket:\\\\s*([a-z0-9][a-z0-9-]*)\\\\s*$\\\")\\n+BUCKET_ENTRY = re.compile(r\\\"^- ([a-z0-9][a-z0-9-]*):\\\\s+\\\\S\\\")\\n+\\n+\\n def parse_spec(spec_md: Path) -> tuple[dict[str, Any] | None, str | None]:\\n     lines = spec_md.read_text().splitlines()\\n     heading_idx = [i for i, l in enumerate(lines) if l.startswith(\\\"## \\\")]\\n@@ -36,6 +41,15 @@ def parse_spec(spec_md: Path) -> tuple[dict[str, Any] | None, str | None]:\\n     idx_problem, idx_claims, idx_criteria = heading_idx\\n     claims = [l.strip()[2:].strip() for l in lines[idx_claims + 1:idx_criteria]\\n               if l.strip().startswith(\\\"- \\\")]\\n+    # A fix item names the root-cause bucket its change closes, as one\\n+    # line in the problem: \\\"Bucket: <slug>\\\". Optional; when present the\\n+    # gate checks it against the tenant's closed list (bucket_refusal).\\n+    bucket = None\\n+    for l in lines[idx_problem + 1:idx_claims]:\\n+        m = BUCKET_LINE.match(l)\\n+        if m:\\n+            bucket = m.group(1)\\n+            break\\n     criteria = []\\n     for l in lines[idx_criteria + 1:]:\\n         s = l.strip()\\n@@ -43,7 +57,35 @@ def parse_spec(spec_md: Path) -> tuple[dict[str, Any] | None, str | None]:\\n             continue\\n         name = s[2:].split(\\\":\\\", 1)[0].strip()\\n         criteria.append(name)\\n-    return {\\\"claims\\\": claims, \\\"criteria\\\": criteria}, None\\n+    return {\\\"claims\\\": claims, \\\"criteria\\\": criteria, \\\"bucket\\\": bucket}, None\\n+\\n+\\n+def buckets_path(root: Path, m: dict[str, Any]) -> Path:\\n+    \\\"\\\"\\\"The tenant's closed list of root-cause buckets: buckets.md beside\\n+    the specs directory (attest/buckets.md when specs live in attest/specs).\\n+    One bucket per line, \\\"- <slug>: <one sentence>\\\".\\\"\\\"\\\"\\n+    return root / Path(m[\\\"paths\\\"][\\\"specs\\\"]).parent / \\\"buckets.md\\\"\\n+\\n+\\n+def listed_buckets(path: Path) -> list[str]:\\n+    if not path.is_file():\\n+        return []\\n+    return [mm.group(1) for mm in (BUCKET_ENTRY.match(l) for l in path.read_text().splitlines()) if mm]\\n+\\n+\\n+def bucket_refusal(root: Path, m: dict[str, Any], bucket: str | None) -> str | None:\\n+    \\\"\\\"\\\"A spec that names a bucket must name one the tenant lists. Symptom\\n+    counts do not converge; bucket counts can, and only if every bucket a\\n+    fix item names is one the list already carries or an item added on\\n+    purpose. No bucket line, no check: a capability item has no bucket.\\\"\\\"\\\"\\n+    if bucket is None:\\n+        return None\\n+    path = buckets_path(root, m)\\n+    if not path.is_file():\\n+        return f\\\"bucket: {bucket} named but {path.relative_to(root)} does not exist\\\"\\n+    if bucket not in listed_buckets(path):\\n+        return f\\\"bucket: {bucket} is not listed in {path.relative_to(root)}\\\"\\n+    return None\\n \\n \\n def run_criterion(exe: Path, cwd: Path) -> int:\\n@@ -194,6 +236,9 @@ def cmd_spec_gate(argv: list[str]) -> int:\\n     results: list[dict[str, Any]] = []\\n     if refusal is None:\\n         # parse_spec returns a refusal exactly when it returns no spec.\\n+        parsed = cast(dict[str, Any], parsed)\\n+        refusal = bucket_refusal(root, m, parsed.get(\\\"bucket\\\"))\\n+    if refusal is None:\\n         parsed = cast(dict[str, Any], parsed)\\n         if built:\\n             refusal = stub_removed_refusal(root, spec_dir)\\ndiff --git a/tests/test_ci_inherit.py b/tests/test_ci_inherit.py\\nindex a1570ad..37067fa 100644\\n--- a/tests/test_ci_inherit.py\\n+++ b/tests/test_ci_inherit.py\\n@@ -439,7 +439,11 @@ def test_test_runs_only_the_own_records_tests_on_its_inherit_path() -> None:\\n     assert \\\"python3 -m pytest tests -q -m own_records\\\" in own[0]\\n     full = [step for step in steps if \\\"python3 -m pytest tests -q --durations=5\\\" in step]\\n     assert len(full) == 1 and SKIP_WHEN_INHERITED in full[0]\\n-    assert \\\"-m \\\" not in full[0].replace(\\\"-m pytest\\\", \\\"\\\"), \\\"the full path runs every test\\\"\\n+    # The two paths partition the suite by one marker: the inherit path\\n+    # runs the own-records tests and the full path runs everything else.\\n+    # Together they are the whole suite; no test is named in either.\\n+    assert \\\"-m 'not own_records'\\\" in full[0], full[0]\\n+    assert \\\"--deselect\\\" not in full[0], \\\"a test named by hand is a list that goes stale (#229 build-04)\\\"\\n \\n \\n def test_the_queue_has_no_path_to_the_script() -> None:\\ndiff --git a/tests/test_cli_help.py b/tests/test_cli_help.py\\nindex 6994db3..7c191b8 100644\\n--- a/tests/test_cli_help.py\\n+++ b/tests/test_cli_help.py\\n@@ -94,3 +94,14 @@ def test_help_names_the_seventh_proof_and_the_empty_stop() -> None:\\n     assert run.returncode == 0\\n     for phrase in (\\\"no attested item is empty\\\", \\\"built_since\\\", \\\"committed nothing\\\", \\\"reads the commit\\\"):\\n         assert phrase in run.stdout, phrase\\n+\\n+\\n+def test_help_names_the_bucket_line_and_the_marker() -> None:\\n+    \\\"\\\"\\\"Item 229's fix: the spec gate's bucket refusal and the own_records\\n+    marker as the only way a tenant's dogfood tests are told apart. Red on\\n+    the tree and on the stub: the words are the build's.\\\"\\\"\\\"\\n+    run = subprocess.run([sys.executable, str(ATTAVO), \\\"--help\\\"],\\n+                         capture_output=True, text=True, check=False)\\n+    assert run.returncode == 0\\n+    for phrase in (\\\"Bucket:\\\", \\\"buckets.md\\\", \\\"own_records\\\"):\\n+        assert phrase in run.stdout, phrase\\ndiff --git a/tests/test_doctor.py b/tests/test_doctor.py\\nindex e00f518..19fd76c 100644\\n--- a/tests/test_doctor.py\\n+++ b/tests/test_doctor.py\\n@@ -31,6 +31,7 @@ def run_doctor(root: Path) -> dict[str, Any]:\\n     return {p[\\\"proof\\\"]: p for p in report[\\\"proofs\\\"]}\\n \\n \\n+@pytest.mark.own_records\\n def test_every_gate_rejects() -> None:\\n     \\\"\\\"\\\"Proof 1. Every gate in the manifest rejects its rejection fixture.\\n \\n@@ -41,6 +42,7 @@ def test_every_gate_rejects() -> None:\\n     assert p[\\\"holds\\\"], p[\\\"reason\\\"]\\n \\n \\n+@pytest.mark.own_records\\n def test_one_item_traversed_every_stage() -> None:\\n     \\\"\\\"\\\"Proof 2. One work item carries a record for spec, approval, build,\\n     verify, and attestation, every one written by a script.\\\"\\\"\\\"\\n@@ -48,6 +50,7 @@ def test_one_item_traversed_every_stage() -> None:\\n     assert p[\\\"holds\\\"], p[\\\"reason\\\"]\\n \\n \\n+@pytest.mark.own_records\\n def test_no_commit_lacks_a_record()
) or \\\"\\\")]\\n+    assert len(proofs) >= 7, proofs\\n+    unmarked = [n.name for n in tree.body if isinstance(n, ast.FunctionDef) and n.name in proofs and not _is_marked(n)]\\n+    assert unmarked == [], unmarked\\n \\n \\n @pytest.mark.parametrize(\\\"reader\\\", [\\ndiff --git a/tests/test_self_tenancy.py b/tests/test_self_tenancy.py\\nindex a1ce3fc..a3ef093 100644\\n--- a/tests/test_self_tenancy.py\\n+++ b/tests/test_self_tenancy.py\\n@@ -73,36 +73,28 @@ def test_manifest_declares_every_key_issue_103_lists() -> None:\\n     assert m[\\\"checks\\\"][\\\"command\\\"]\\n \\n \\n-DESELECT_FLAGS = (\\n-    \\\"--deselect tests/test_doctor.py::test_every_gate_rejects\\\",\\n-    \\\"--deselect tests/test_doctor.py::test_one_item_traversed_every_stage\\\",\\n-    \\\"--deselect tests/test_doctor.py::test_no_commit_lacks_a_record\\\",\\n-    \\\"--deselect tests/test_doctor.py::test_no_stop_lacks_cause\\\",\\n-    \\\"--deselect tests/test_doctor.py::test_every_attested_item_is_sealed\\\",\\n-    \\\"--deselect tests/test_doctor.py::test_no_attested_item_is_empty\\\",\\n-)\\n-\\n-\\n-def test_checks_and_tests_run_deselect_the_four_dogfood_doctor_tests() -> None:\\n-    \\\"\\\"\\\"[checks].command and [tests].run must never run the four doctor\\n-    tests that fail until an item has traversed every stage: the first\\n-    item's own build would fail its own checks on a doctor proof no\\n-    item has satisfied yet. [checks].command is ci.yml's test job\\n-    command verbatim, deselects included; [tests].run carries the same\\n-    four flags after `python3 -m pytest -q`. The doctor job in ci.yml is\\n-    the only place the four run without them. Written and run red once\\n-    by dropping one flag from [checks].command, confirmed it failed,\\n-    then restored.\\\"\\\"\\\"\\n+def test_tests_run_and_the_test_job_exclude_the_own_records_tests_by_marker() -> None:\\n+    \\\"\\\"\\\"The tests that read this repository's own records -- the doctor's\\n+    proofs among them -- must never run inside an item's gate or the\\n+    test job: a proof no item has satisfied yet, or one that reads the\\n+    running build's own marker, fails a build for nothing (#229\\n+    build-04: the gate ran the whole suite and\\n+    test_no_invocation_lacks_record read build-04's own .started marker\\n+    as a dead invocation). They are told apart by @pytest.mark.own_records\\n+    and by nothing else: [tests].run and ci.yml's test job carry\\n+    -m 'not own_records', the doctor job and the inherit path carry\\n+    -m own_records, and no --deselect names a test anywhere. Three\\n+    hand-copied lists did this before and one was missing a test.\\\"\\\"\\\"\\n     m = load_manifest()\\n-    for flag in DESELECT_FLAGS:\\n-        assert flag in m[\\\"tests\\\"][\\\"run\\\"], m[\\\"tests\\\"][\\\"run\\\"]\\n-    # Since the calibration item the gate's [checks].command runs the type\\n-    # check and no test at all; the whole suite is ci.yml's test job, which\\n-    # carries the same flags. A gate command that names pytest again must\\n-    # carry them too.\\n+    assert \\\"-m 'not own_records'\\\" in m[\\\"tests\\\"][\\\"run\\\"], m[\\\"tests\\\"][\\\"run\\\"]\\n+    assert \\\"--deselect\\\" not in m[\\\"tests\\\"][\\\"run\\\"], m[\\\"tests\\\"][\\\"run\\\"]\\n+    assert \\\"--deselect\\\" not in m[\\\"checks\\\"][\\\"command\\\"], m[\\\"checks\\\"][\\\"command\\\"]\\n     if \\\"pytest\\\" in m[\\\"checks\\\"][\\\"command\\\"]:\\n-        for flag in DESELECT_FLAGS:\\n-            assert flag in m[\\\"checks\\\"][\\\"command\\\"], m[\\\"checks\\\"][\\\"command\\\"]\\n+        assert \\\"-m 'not own_records'\\\" in m[\\\"checks\\\"][\\\"command\\\"], m[\\\"checks\\\"][\\\"command\\\"]\\n+    ci = (ROOT / \\\".github\\\" / \\\"workflows\\\" / \\\"ci.yml\\\").read_text()\\n+    assert \\\"--deselect\\\" not in ci\\n+    assert \\\"python3 -m pytest tests -q --durations=5 -m 'not own_records'\\\" in ci\\n+    assert ci.count(\\\"python3 -m pytest tests -q -m own_records\\\") == 2, \\\"the inherit path and the doctor job\\\"\\n \\n \\n def run_select_tests(stdin_text: str) -> list[str]:\\ndiff --git a/tests/test_spec_gate.py b/tests/test_spec_gate.py\\nindex 0dfc44e..63af307 100644\\n--- a/tests/test_spec_gate.py\\n+++ b/tests/test_spec_gate.py\\n@@ -426,3 +426,51 @@ def test_spec_gate_stub_verdict_after_halted_build_that_committed_nothing(tmp_pa\\n     assert rec[\\\"status\\\"] == \\\"pass\\\"\\n     assert rec[\\\"criteria\\\"] == [{\\\"name\\\": \\\"checks_marker.sh\\\", \\\"on_tree\\\": 1, \\\"on_stub\\\": 0}]\\n     assert rec[\\\"refusal\\\"] is None\\n+\\n+\\n+def add_bucket_line(root: Path, bucket: str) -> None:\\n+    spec_md = root / \\\"specs\\\" / \\\"1\\\" / \\\"spec.md\\\"\\n+    text = spec_md.read_text().replace(\\\"## Problem\\\\n\\\", f\\\"## Problem\\\\n\\\\nBucket: {bucket}\\\\n\\\", 1)\\n+    spec_md.write_text(text)\\n+    commit_all(root, f\\\"name bucket {bucket}\\\")\\n+\\n+\\n+def test_spec_gate_refuses_a_bucket_the_tenant_does_not_list_and_passes_a_listed_one(tmp_path: Path) -> None:\\n+    \\\"\\\"\\\"Root-cause buckets (#229 build-04 and the convergence ruling of\\n+    2026-09-27): a fix item names the bucket its change closes as one\\n+    'Bucket: <slug>' line in its problem, and the gate refuses a slug the\\n+    tenant's buckets.md (beside the specs directory) does not list, or a\\n+    line with no such file. Written red first: on v0.30.0 the line is\\n+    prose and the gate passes it.\\\"\\\"\\\"\\n+    root = make_tenant(tmp_path, \\\"valid\\\")\\n+    add_bucket_line(root, \\\"shared-working-copy\\\")\\n+    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n+    assert run.returncode == 1, run.stdout + run.stderr\\n+    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n+    assert rec[\\\"status\\\"] == \\\"refused\\\"\\n+    assert rec[\\\"refusal\\\"] == \\\"bucket: shared-working-copy named but buckets.md does not exist\\\", rec[\\\"refusal\\\"]\\n+    assert rec[\\\"criteria\\\"] == [], \\\"refused before any criterion ran\\\"\\n+\\n+    (root / \\\"buckets.md\\\").write_text(\\n+        \\\"# buckets\\\\n\\\\n- liveness-by-proxy: a pid stood in for the holder\\\\n\\\")\\n+    commit_all(root, \\\"list one bucket\\\")\\n+    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n+    assert run.returncode == 1\\n+    assert latest_record(root, \\\"1\\\", \\\"spec\\\")[\\\"refusal\\\"] == \\\"bucket: shared-working-copy is not listed in buckets.md\\\"\\n+\\n+    (root / \\\"buckets.md\\\").write_text(\\n+        \\\"# buckets\\\\n\\\\n- liveness-by-proxy: a pid stood in for the holder\\\\n\\\"\\n+        \\\"- shared-working-copy: one checkout, many writers\\\\n\\\")\\n+    commit_all(root, \\\"list the bucket\\\")\\n+    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n+    assert run.returncode == 0, run.stdout + run.stderr\\n+    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n+    assert rec[\\\"status\\\"] == \\\"pass\\\" and rec[\\\"refusal\\\"] is None\\n+\\n+\\n+def test_spec_gate_leaves_a_spec_with_no_bucket_line_alone(tmp_path: Path) -> None:\\n+    \\\"\\\"\\\"A capability item has no bucket; the check is on the line, not on\\n+    every spec, and a tenant with no buckets.md is not asked for one.\\\"\\\"\\\"\\n+    root = make_tenant(tmp_path, \\\"valid\\\")\\n+    assert not (root / \\\"buckets.md\\\").exists()\\n+    assert run_attavo(root, \\\"spec-gate\\\", \\\"1\\\").returncode == 0\",\"stderr\":\"\",\"interrupted\":false,\"isImage\":false,\"noOutputExpected\":false}}\n+{\"type\":\"assistant\",\"message\":{\"model\":\"claude-sonnet-5\",\"id\":\"msg_011CfUawgpUJrUVjypzpeDzM\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_01VEFYQwHZ9GPTJmxk6dygmh\",\"name\":\"Read\",\"input\":{\"file_path\":\"/Users/davidbean/Projects/attavo-worktree-237/attest/buckets.md\"},\"caller\":{\"type\":\"direct\"}}],\"container\":null,\"stop_reason\":null,\"stop_sequ
are not green\\\")\\n/Users/davidbean/Projects/attest/attavo/verify.py:336:    # already read above for the forge) against the head after it.\\n/Users/davidbean/Projects/attest/attavo/verify.py:366:    # this review's status failed with class returned -- retryable, the\\n/Users/davidbean/Projects/attest/attavo/verify.py:383:        stop: dict[str, Any] | None = {\\\"class\\\": \\\"returned\\\", \\\"provenance\\\": \\\"tenant\\\",\\n/Users/davidbean/Projects/attest/attavo/verify.py:388:                   derive_stop(status_out, log=transcript, report_class=(payload or {}).get(\\\"class\\\")))\\n/Users/davidbean/Projects/attest/attavo/verify.py:390:            stop_detail: str | None = ((payload or {}).get(\\\"detail\\\") if stop[\\\"class\\\"] == \\\"transient\\\"\\n/Users/davidbean/Projects/attest/attavo/verify.py:406:        \\\"forge_checks\\\": forge_checks,\\n/Users/davidbean/Projects/attest/attavo/verify.py:426:# disagrees -- how long drive gives a forge's checks room to conclude\\n/Users/davidbean/Projects/attest/attavo/verify.py:428:# forge has not yet finished reading. Tenant zero's own checks conclude\\n/Users/davidbean/Projects/attest/attavo/verify.py:440:def drive_forge_poll_bound_s() -> float:\\n/Users/davidbean/Projects/attest/attavo/verify.py:444:def drive_forge_poll_interval_s() -> float:\\n/Users/davidbean/Projects/attest/attavo/verify.py:448:def forge_checks_unconcluded(forge_checks: dict[str, Any]) -> bool:\\n/Users/davidbean/Projects/attest/attavo/verify.py:449:    \\\"\\\"\\\"Whether poll_forge_checks should keep waiting rather than stop at\\n/Users/davidbean/Projects/attest/attavo/verify.py:450:    once: an empty read (the forge has not attached any check to this sha\\n/Users/davidbean/Projects/attest/attavo/verify.py:454:    anything else read_forge_checks did not recognize as ok) is not this\\n/Users/davidbean/Projects/attest/attavo/verify.py:456:    conclusions = forge_checks[\\\"conclusions\\\"]\\n/Users/davidbean/Projects/attest/attavo/verify.py:462:def poll_forge_checks(root: Path, checks_command: str, sha: str) -> tuple[dict[str, Any], bool]:\\n/Users/davidbean/Projects/attest/attavo/verify.py:463:    \\\"\\\"\\\"read_forge_checks, retried within drive_forge_poll_bound_s() while\\n/Users/davidbean/Projects/attest/attavo/verify.py:464:    some check is still unconcluded (forge_checks_unconcluded) -- a check\\n/Users/davidbean/Projects/attest/attavo/verify.py:472:    bound = drive_forge_poll_bound_s()\\n/Users/davidbean/Projects/attest/attavo/verify.py:473:    interval = drive_forge_poll_interval_s()\\n/Users/davidbean/Projects/attest/attavo/verify.py:475:    forge_checks, ok = read_forge_checks(root, checks_command, sha)\\n/Users/davidbean/Projects/attest/attavo/verify.py:476:    while not ok and forge_checks_unconcluded(forge_checks) and time.monotonic() < deadline:\\n/Users/davidbean/Projects/attest/attavo/verify.py:478:        forge_checks, ok = read_forge_checks(root, checks_command, sha)\\n/Users/davidbean/Projects/attest/attavo/verify.py:479:    return forge_checks, ok\\n/Users/davidbean/Projects/attest/attavo/build.py:240:    is handed (R3), in this order -- the prior attempt's own class and\\n/Users/davidbean/Projects/attest/attavo/build.py:242:    check's log, read through [forge].check_log_command, or a review's\\n/Users/davidbean/Projects/attest/attavo/build.py:244:    record (counsel's answer text, named by the record it came from). A\\n/Users/davidbean/Projects/attest/attavo/build.py:248:    returned it (class returned, its own build_sha matching the latest\\n/Users/davidbean/Projects/attest/attavo/build.py:257:    if (latest_verify and (latest_verify.get(\\\"stop\\\") or {}).get(\\\"class\\\") == \\\"returned\\\"\\n/Users/davidbean/Projects/attest/attavo/build.py:269:    lines = [f\\\"attempt {prior_stem} stopped as {stop.get('class')}: {stop.get('detail') or ''}\\\",\\n/Users/davidbean/Projects/attest/attavo/build.py:272:    forge = m.get(\\\"forge\\\") or {}\\n/Users/davidbean/Projects/attest/attavo/build.py:273:    if stop.get(\\\"class\\\") == \\\"returned\\\":\\n/Users/davidbean/Projects/attest/attavo/build.py:282:        elif forge.get(\\\"check_log_command\\\"):\\n/Users/davidbean/Projects/attest/attavo/build.py:283:            for c in (prior.get(\\\"forge_checks\\\") or {}).get(\\\"conclusions\\\") or []:\\n/Users/davidbean/Projects/attest/attavo/build.py:287:                    f\\\"{forge['check_log_command']} {shlex.quote(str(prior.get('sha')))} \\\"\\n/Users/davidbean/Projects/attest/attavo/build.py:301:            if counsel.get(\\\"verdict\\\") == \\\"answer\\\":\\n/Users/davidbean/Projects/attest/attavo/build.py:303:                answer = (counsel.get(\\\"proposal\\\") or {}).get(\\\"ruling_text\\\")\\n/Users/davidbean/Projects/attest/attavo/build.py:304:                if answer:\\n/Users/davidbean/Projects/attest/attavo/build.py:305:                    lines += [f\\\"steer from {steer_stem}:\\\", answer.strip(), \\\"\\\"]\\n/Users/davidbean/Projects/attest/attavo/build.py:413:    # says what is being asked and what the answer was.\\n/Users/davidbean/Projects/attest/attavo/build.py:461:                \\\"stop\\\": {\\\"class\\\": \\\"environment\\\", \\\"provenance\\\": \\\"tenant\\\", \\\"detail\\\": detail,\\n/Users/davidbean/Projects/attest/attavo/build.py:488:        # attempt's class and signature, its evidence, and the newest\\n/Users/davidbean/Projects/attest/attavo/build.py:720:                            report_class=\\\"empty\\\" if empty_detail else (payload or {}).get(\\\"class\\\"),\\n/Users/davidbean/Projects/attest/attavo/build.py:729:        # None for every class but unclassed/question/environment/gate);\\n/Users/davidbean/Projects/attest/attavo/build.py:730:        # every other non-pass class signs off its own detail (None for\\n/Users/davidbean/Projects/attest/attavo/build.py:731:        # most, so signature is None too -- the class alone, or the log\\n/Users/davidbean/Projects/attest/attavo/build.py:732:        # itself for unclassed, is the specimen's own cause).\\n/Users/davidbean/Projects/attest/attavo/build.py:733:        stop_detail: str | None = ((payload or {}).get(\\\"detail\\\") if stop_out[\\\"class\\\"] == \\\"transient\\\"\\n/Users/davidbean/Projects/attest/attavo/counsel.py:22:from attavo.verify import diff_since_approval, read_forge_checks\\n/Users/davidbean/Projects/attest/attavo/counsel.py:27:# or names the one-line question a person must answer. ---\\n/Users/davidbean/Projects/attest/attavo/counsel.py:87:def counsel_forge_evidence(root: Path, forge_cfg: dict[str, Any], sha: str | None, tmp: Path\\n/Users/davidbean/Projects/attest/attavo/counsel.py:89:    \\\"\\\"\\\"(forge, checks_path) -- issue #175. forge is the summary counsel's\\n/Users/davidbean/Projects/attest/attavo/counsel.py:96:    [forge].check_log_command for every check not \\\"success\\\". Absent\\n/Users/davidbean/Projects/attest/attavo/counsel.py:97:    [forge].checks_command, absent [forge].check_log_command, or a\\n/Users/davidbean/Projects/attest/attavo/counsel.py:102:    checks_command = forge_cfg.get(\\\"checks_command\\\")\\n/Users/davidbean/Projects/attest/attavo/counsel.py:103:    check_log_command = forge_cfg.get(\\\"check_log_command\\\")\\n/Users/davidbean/Projects/attest/attavo/counsel.py:107:        reason = \\\"not read: no [forge].checks_command\\\"\\n/Users/davidbean/Projects/attest/attavo/counsel.py:109:        reason = \\\"not read: no [forge].check_log_command\\\"\\n/Users/davidbean/Projects/attest/attavo/counsel.py:122:    raw_checks, _ok = read_forge_checks(root, checks_command, sha)\\n/Users/davidbean/Projects/attest/attavo/counsel.py:195:            checks, _ = read_forge_checks(root, checks_command, s)\\n/Users/davidbean/Projects/attest/attavo/counsel.py:197:            lines.append(f\\\"{s}: {line or '(no checks)'}\\\")\\n/Users/davidbean/Projects/attest/attavo/counsel.py:270:    forge_cfg = m.get(\\\"forge\\\") or {}\\n/Users/davidbean/Projects/attest/attavo/counsel.py:280:        forge, checks_path = counsel_forge_evidence(root, forge_cfg, stop_sha, tmp_path)\\n/Users/davidbean/Projects/attest/attavo/counsel.py:284:            root, m, item_id, stop_sha, forge_cfg.get(\\\"checks_command\\\")))\\n/Users/davidbean/Projects/attest/attavo/counsel.py:320:            and payload.get(\\\"verdict\\\") in (\\\"answer\\\", \\\"patch\\\", \\\"person\\\")):\\n/Users/davidbean/Projects/attest/attavo/counsel.py:328:        cls = payload.get(\\\"class\\\")\\n/Users/davidbean/Projects/attest/attavo/counsel.py:348:        \\\"class\\\": cls,\\n/Users/davidbean/Projects/attest/attavo/counsel.py:352:        \\\"forge\\\": forge,\\nfrom __future__ import annotations\\n\\nimport json\\nimport os\\nimport shlex\\nimport subprocess\\nimport sys\\nimport tempfile\\nimport time\\nfrom pathlib import Path\\nfrom typing import Any, cast\\n\\nfrom attavo.build import (\\n    adapter_reports,\\n    merge_adapter_config,\\n    resolve_adapter,\\n    split_adapter_stdout,\\n)\\nfrom attavo.common import MANIFEST, PRODUCT_ROOT, derive_item_id, git, now_iso, read_manifest\\nfrom attavo.records import latest_attempt_path, latest_record, write_record\\nfrom attavo.types import SpecRecord, StageRecord\\nfrom attavo.verify import diff_since_approval, read_forge_checks\\n\\n# --- counsel: a stop is read inside the product first, before a person\\n# (issue #100). Read-only -- it commits nothing and writes nothing outside\\n# paths.records/<N>/ -- and it never acts: it proposes a ruling, a patch,\\n# or names the one-line question a person must answer. ---\\n\\nCOUNSEL_STAGES = (\\\"build\\\", \\\"verify\\\")\\n\\n\\ndef latest_non_pass_stage_record(records_dir: Path) -> tuple[str | None, StageRecord | None, Path | None]:\\n    \\\"\\\"\\\"(stage, record, path) for the item's most recent non-pass build or\\n    verify record, by its own \\\"at\\\" timestamp -- or, when neither stage\\n    carries one, the item's latest refused spec-gate record (issue #133):\\n    a refused gate is the same shape of stop, earlier, and it is read only\\n    once a build or verify record exists to counsel first, since either\\n    one already implies the gate that produced it passed. (None, None,\\n    None) when none of the three exists. \\\"Most recent\\\" rather than\\n    \\\"build, else verify\\\" so a stop on the stage that ran later (typically\\n    verify, bound to a build that already passed) is the one counseled.\\\"\\\"\\\"\\n    candidates: list[tuple[str, StageRecord, Path]] = []\\n    for stage in COUNSEL_STAGES:\\n        path = latest_attempt_path(records_dir, stage)\\n        if path is None:\\n            continue\\n        # A path exists, so the record read from the same files does too.\\n        rec = cast(StageRecord, latest_record(records_dir, stage))\\n        if rec.get(\\\"status\\\") == \\\"pass\\\":\\n            continue\\n        candidates.append((stage, rec, path))\\n    if candidates:\\n        candidates.sort(key=lambda c: c[1].get(\\\"at\\\") or \\\"\\\")\\n        return candidates[-1]\\n    spec_path = latest_attempt_path(records_dir, \\\"spec\\\")\\n    if spec_path is not None:\\n        spec_rec = cast(SpecRecord, latest_record(records_dir, \\\"spec\\\"))\\n        if spec_rec.get(\\\"status\\\") == \\\"refused\\\":\\n            return \\\"spec\\\", spec_rec, spec_path\\n    return None, None, None\\n\\n\\ndef latest_stage_record(records_dir: Path) -> tuple[str | None, StageRecord | None, Path | None]:\\n    \\\"\\\"\\\"(stage, record, path) for the item's most recent build or verify\\n    record regardless of status, by its own \\\"at\\\" timestamp -- or, when\\n    neither stage carries one, the item's latest spec-gate record,\\n    regardless of status. The evidence set `attavo counsel --ask` reads\\n    over (issue #175): a question is not bound to a stop, so the pass\\n    filter latest_non_pass_stage_record applies does not apply here.\\n    (None, None, None) when the item carries no record of any of the\\n    three stages yet.\\\"\\\"\\\"\\n    candidates: list[tuple[str, StageRecord, Path]] = []\\n    for stage in COUNSEL_STAGES:\\n        path = latest_attempt_path(records_dir, stage)\\n        if path is None:\\n            continue\\n        candidates.append((stage, cast(StageRecord, latest_record(records_dir, stage)), path))\\n    if candidates:\\n        candidates.sort(key=lambda c: c[1].get(\\\"at\\\") or \\\"\\\")\\n        return candidates[-1]\\n    spec_path = latest_attempt_path(records_dir, \\\"spec\\\")\\n    if spec_path is not None:\\n        return \\\"spec\\\", cast(SpecRecord, latest_record(records_dir, \\\"spec\\\")), spec_path\\n    return None, None, None\\n\\n\\ndef counsel_forge_evidence(root: Path, forge_cfg: dict[str, Any], sha: str | None, tmp: Path\\n                          ) -> tuple[dict[str, Any], Path]:\\n    \\\"\\\"\\\"(forge, checks_path) -- issue #175. forge is the summary counsel's\\n    own record carries: {\\\"read\\\", \\\"reason\\\", \\\"checks\\\"}, \\\"checks\\\" a list of\\n    {\\\"name\\\", \\\"conclusion\\\"} pairs. checks_path is always written, under\\n    tmp, as ATTAVO_COUNSEL_CHECKS: a JSON {\\\"read\\\", \\\"reason\\\", \\\"checks\\\"}\\n    envelope whose own \\\"checks\\\" carry the richer {\\\"name\\\", \\\"conclusion\\\",\\n    \\\"run_url\\\", \\\"log\\\"} shape the adapter reads -- \\\"log\\\" naming a sibling\\n    file under tmp with that check's own failed-step log, fetched through\\n    [forge].check_log_command for every check not \\\"success\\\". Absent\\n    [forge].checks_command, absent [forge].check_log_command, or a\\n    counseled record with no sha of its own: read is false and reason\\n    names exactly which is missing -- never a checks list a reader could\\n    mistake for \\\"all clear\\\" (an empty list from a real, successful read\\n    is not this; that is read: true, checks: []).\\\"\\\"\\\"\\n    checks_command = forge_cfg.get(\\\"checks_command\\\")\\n    check_log_command = forge_cfg.get(\\\"check_log_command\\\")\\n    checks_path = tmp / \\\"checks.json\\\"\\n\\n    if not checks_command:\\n        reason = \\\"not read: no [forge].checks_command\\\"\\n    elif not check_log_command:\\n        reason = \\\"not read: no [forge].check_log_command\\\"\\n    elif not sha:\\n        reason = \\\"not read: the counseled record carries no sha\\\"\\n    else:\\n        reason = None\\n\\n    if reason is not None:\\n        envelope = {\\\"read\\\": False, \\\"reason\\\": reason, \\\"checks\\\": []}\\n        checks_path.write_text(json.dumps(envelope, indent=2) + \\\"\\\\n\\\")\\n        return envelope, checks_path\\n\\n    # reason is None only when checks_command, check_log_command, and sha are all set.\\n    checks_command, sha = cast(str, checks_command), cast(str, sha)\\n    raw_checks, _ok = read_forge_checks(root, checks_command, sha)\\n    payload_checks: list[dict[str, Any]] = []\\n    record_checks: list[dict[str, Any]] = []\\n    for i, c in enumerate(raw_checks[\\\"conclusions\\\"]):\\n        name, conclusion = c[\\\"name\\\"], c[\\\"conclusion\\\"]\\n        log_path = None\\n        if conclusion != \\\"success\\\":\\n            log_run = subprocess.run(\\n                f\\\"{check_log_command} {shlex.quote(sha)} {shlex.quote(name)}\\\",\\n                shell=True, cwd=str(root), capture_output=True, text=True, check=False)\\n            if log_run.returncode == 0 and log_run.stdout.strip():\\n                log_file = tmp / f\\\"check-{i:02d}.log\\\"\\n                log_file.write_text(log_run.stdout)\\n                log_path = str(log_file)\\n        payload_checks.append({\\\"name\\\": name, \\\"conclusion\\\": conclusion,\\n                               \\\"run_url\\\": None, \\\"log\\\": log_path})\\n        record_checks.append({\\\"name\\\": name, \\\"conclusion\\\": conclusion})\\n\\n    checks_path.write_text(json.dumps(\\n        {\\\"read\\\": True, \\\"reason\\\": None, \\\"checks\\\": payload_checks}, indent=2) + \\\"\\\\n\\\")\\n    return {\\\"read\\\": True, \\\"reason\\\": None, \\\"checks\\\": record_checks}, checks_path\\n\\n\\ndef counsel_graph_text(root: Path, m: dict[str, Any], item_id: str, sha: str | None,\\n                       checks_command: str | None) -> str:\\n    \\\"\\\"\\\"A text report of the item's own place on the branch (issue #175):\\n    the default branch's first-parent log since the item's own branch\\n    point, this branch's own commits (sha, author, subject), the markers\\n    and records present at the counseled sha, and the check runs on the\\n    last three shas on this branch -- so a stop whose cause is \\\"the\\n    checks are on the record commit, not the code commit\\\" is readable\\n    without a terminal. Best-effort: a git read that fails (a shallow\\n    checkout, an unset refs/remotes/origin/HEAD) is noted in the text\\n    rather than raised, since the graph is evidence, not a gate.\\\"\\\"\\\"\\n    records_rel = m[\\\"paths\\\"][\\\"records\\\"]\\n    parts: list[str] = []\\n\\n    symref = subprocess.run(\\n        [\\\"git\\\", \\\"-C\\\", str(root), \\\"symbolic-ref\\\", \\\"-q\\\", \\\"refs/remotes/origin/HEAD\\\"],\\n        capture_output=True, text=True, check=False)\\n    default_ref = symref.stdout.strip() if symref.returncode == 0 else None\\n\\n    if default_ref:\\n        try:\\n            branch_point = git(root, \\\"merge-base\\\", default_ref, \\\"HEAD\\\").strip()\\n            parts.append(\\n                \\\"## the default branch, first-parent, since this item's branch point\\\\n\\\\n\\\" +\\n                (git(root, \\\"log\\\", \\\"--first-parent\\\", \\\"--oneline\\\",\\n                    f\\\"{branch_point}..{default_ref}\\\").strip() or \\\"(nothing new)\\\"))\\n            parts.append(\\n                \\\"## this branch's own commits since the branch point\\\\n\\\\n\\\" +\\n                (git(root, \\\"log\\\", \\\"--first-parent\\\", \\\"--format=%H %an %s\\\",\\n                    f\\\"{branch_point}..HEAD\\\").strip() or \\\"(no commits yet)\\\"))\\n        except RuntimeError as exc:\\n            parts.append(f\\\"## the default branch\\\\n\\\\n(could not be read: {exc})\\\")\\n    else:\\n        parts.append(\\\"## the default branch\\\\n\\\\n(refs/remotes/origin/HEAD is not set)\\\")\\n\\n    if sha:\\n        try:\\n            tree = git(root, \\\"ls-tree\\\", \\\"-r\\\", \\\"--name-only\\\", sha, \\\"--\\\",\\n                      f\\\"{records_rel.rstrip('/')}/{item_id}/\\\").strip()\\n            parts.append(f\\\"## markers and records present at {sha}\\\\n\\\\n\\\" + (tree or \\\"(none)\\\"))\\n        except RuntimeError as exc:\\n            parts.append(f\\\"## markers and records present at {sha}\\\\n\\\\n(could not be read: {exc})\\\")\\n\\n    if checks_command:\\n        try:\\n            recent = git(root, \\\"log\\\", \\\"--first-parent\\\", \\\"-3\\\", \\\"--format=%H\\\", \\\"HEAD\\\").split()\\n        except RuntimeError:\\n            recent = []\\n        lines = []\\n        for s in recent:\\n            checks, _ = read_forge_checks(root, checks_command, s)\\n            line = \\\", \\\".join(f\\\"{c['name']}={c['conclusion']}\\\" for c in checks[\\\"conclusions\\\"])\\n            lines.append(f\\\"{s}: {line or '(no checks)'}\\\")\\n        if lines:\\n            parts.append(\\\"## check runs for the last three shas on this branch\\\\n\\\\n\\\" +\\n                         \\\"\\\\n\\\".join(lines))\\n\\n    return \\\"\\\\n\\\\n\\\".join(parts)\\n\\n\\ndef cmd_counsel(argv: list[str]) -> int:\\n    root = Path(\\\".\\\").resolve()\\n    ask: str | None = None\\n    positional: list[str] = []\\n    i = 0\\n    while i < len(argv):\\n        if argv[i] == \\\"--ask\\\":\\n            ask = argv[i + 1] if i + 1 < len(argv) else None\\n            i += 2\\n        else:\\n            positional.append(argv[i])\\n            i += 1\\n    item_id = positional[0] if positional else derive_item_id(root)\\n    if not item_id:\\n        print(\\\"attavo counsel: cannot derive item id; pass N or run on an attavo/N-* branch\\\",\\n              file=sys.stderr)\\n        return 2\\n    if ask is not None and not ask.strip():\\n        print(\\\"attavo counsel: --ask requires non-empty text\\\", file=sys.stderr)\\n        return 2\\n    m = read_manifest(root)\\n    if m is None:\\n        print(f\\\"attavo counsel: no {MANIFEST} at {root}\\\", file=sys.stderr)\\n        return 2\\n\\n    specs_rel = m[\\\"paths\\\"][\\\"specs\\\"]\\n    records_rel = m[\\\"paths\\\"][\\\"records\\\"]\\n    item_records_dir = root / records_rel / item_id\\n\\n    # issue #175: --ask reads the item's latest records regardless of\\n    # status -- a question is not bound to a stop -- everything else\\n    # about the evidence set and the write is shared with the stop path.\\n    if ask is not None:\\n        stage, stop_record, record_path = latest_stage_record(item_records_dir)\\n        no_record_msg = f\\\"no build, verify, or spec-gate record for item {item_id}\\\"\\n    else:\\n        stage, stop_record, record_path = latest_non_pass_stage_record(item_records_dir)\\n        no_record_msg = f\\\"no non-pass build, verify, or spec-gate record for item {item_id}\\\"\\n    if stop_record is None:\\n        print(f\\\"attavo counsel: refused: {no_record_msg}\\\")\\n        return 1\\n    # latest_*_stage_record returns all three of (stage, record, path) or none.\\n    stage, record_path = cast(str, stage), cast(Path, record_path)\\n\\n    executor = m.get(\\\"executor\\\") or {}\\n    adapter_name = executor.get(\\\"counsel\\\") or executor.get(\\\"verify\\\")\\n    if not adapter_name:\\n        print(\\\"attavo counsel: refused: no [executor].counsel or [executor].verify \\\"\\n              \\\"in the manifest\\\")\\n        return 1\\n    adapter_path = resolve_adapter(root, adapter_name)\\n    if adapter_path is None:\\n        print(f\\\"attavo counsel: refused: no adapter named {adapter_name!r}\\\")\\n        return 1\\n\\n    adapter_config = merge_adapter_config(m, adapter_name, \\\"counsel\\\")\\n    reports = adapter_reports(adapter_path)\\n    spec_dir = root / specs_rel / item_id\\n    log_path = record_path.with_suffix(\\\".log\\\")\\n\\n    diff_text, diff_refusal = diff_since_approval(root, stop_record.get(\\\"approval_sha\\\"))\\n    if diff_refusal:\\n        print(f\\\"attavo counsel: refused: {diff_refusal}\\\")\\n        return 1\\n\\n    forge_cfg = m.get(\\\"forge\\\") or {}\\n    stop_sha = stop_record.get(\\\"sha\\\")\\n\\n    started = time.monotonic()\\n\\n    with tempfile.TemporaryDirectory() as tmp:\\n        tmp_path = Path(tmp)\\n        diff_path = tmp_path / \\\"diff.patch\\\"\\n        diff_path.write_text(diff_text)\\n\\n        forge, checks_path = counsel_forge_evidence(root, forge_cfg, stop_sha, tmp_path)\\nfrom __future__ import annotations\\n\\nimport json\\nimport re\\nimport sys\\nfrom pathlib import Path\\nfrom typing import Any\\n\\nfrom attavo.common import MANIFEST, read_manifest\\nfrom attavo.records import parse_attempts, stage_schema\\nfrom attavo.types import CounselRecord, Stop\\n\\n# --- stop: every non-pass build or verify record's class and cause (issue\\n# #89) -- derived here, at write time, from the refusal, halted, and log\\n# the caller already has. Never a fresh read of anything: the tenant zero\\n# specimens this retires (#576 build-11, #659 build-01 and verify-01) are\\n# exactly a stop the product wrote with nothing beside it to explain\\n# itself after the fact. ---\\n\\nSTOP_CLASSES = (\\\"non-question\\\", \\\"outlived-invocation\\\", \\\"no-cause\\\", \\\"forge-unconcluded\\\",\\n               \\\"ceiling\\\", \\\"claims-boundary\\\", \\\"repeated-act\\\", \\\"unclassed\\\", \\\"question\\\",\\n               \\\"environment\\\", \\\"gate\\\", \\\"died\\\", \\\"hung\\\", \\\"transient\\\", \\\"returned\\\", \\\"empty\\\")\\n\\n# R3: the four families a pass retries with no person involved -- every\\n# other class is counsel's to read first, and a person's when counsel says\\n# so (or when counsel is not configured at all).\\nRETRYABLE_CLASSES = (\\\"died\\\", \\\"hung\\\", \\\"transient\\\", \\\"returned\\\")\\n\\n\\ndef signature_of(text: str | None) -> str | None:\\n    \\\"\\\"\\\"R3: a failure's signature, compared between attempts by plain string\\n    equality -- text with every run of digits removed, so two stops that\\n    differ only in a pid, a timestamp, or a retry-after count still match.\\n    None for no text at all (nothing to sign).\\\"\\\"\\\"\\n    if not text:\\n        return None\\n    stripped = re.sub(r\\\"[0-9]+\\\", \\\"\\\", text).strip()\\n    return stripped or None\\n\\n\\nSTOP_PROVENANCES = (\\\"product\\\", \\\"tenant\\\", \\\"executor\\\", \\\"spec\\\")\\n\\n# Beyond the enum spelling itself, the prose issue #88 actually shipped\\n# (adapters/claude-code/run and adapters/codex/run, on main since\\n# v0.16.0) once put a class's own name, or a real specimen's wording of\\n# it, in the transcript for the generic match below to find. Issue #94\\n# moves non-question and outlived-invocation onto report_class instead\\n# (below): non-question's own halt line (\\\"halted: class non-question\\\")\\n# would otherwise still satisfy the bare-name match here with no adapter\\n# report-line field involved at all, and outlived-invocation's refusal\\n# never named its class in text to begin with, so both are disabled here\\n# -- the same pattern issue #93 established for ceiling, just below,\\n# rather than removed outright.\\nCLASS_TEXT_MARKERS: dict[str, tuple[str, ...]] = {\\n    \\\"non-question\\\": (),\\n    \\\"outlived-invocation\\\": (),\\n    # R3: transient is read from the adapter's own report line\\n    # (report_class) below; returned is written directly by the pass or\\n    # cmd_verify, never derived from a log's text -- a retried attempt's\\n    # feedback file names the prior stop's class in prose, and that text\\n    # reaches the next attempt's own transcript, which must not then be\\n    # misread as a fresh instance of either class.\\n    \\\"transient\\\": (),\\n    \\\"returned\\\": (),\\n    # Issue #93: ceiling's own text-based check is CEILING_MARKERS, below,\\n    # with provenance \\\"product\\\" -- a fact about the tool, not an executor\\n    # judgment like non-question/outlived-invocation are. Left at the\\n    # default (the class's own name, \\\"ceiling\\\"), the generic match above\\n    # would instead catch adapters/codex/run's and\\n    # adapters/claude-code/run's own pre-emptive refusal -- which must\\n    # carry the word \\\"ceiling\\\" by the same issue's own brief -- as\\n    # provenance \\\"executor\\\", before CEILING_MARKERS is ever consulted.\\n    \\\"ceiling\\\": (),\\n    # A genuine question (issue #100's own followups) is read structurally\\n    # -- status \\\"halted\\\" carrying a non-empty halted.question -- not by\\n    # scanning for the literal word \\\"question\\\", which the question's own\\n    # text very often contains regardless of what it is actually asking.\\n    # Left at the default, the generic match above would misclassify any\\n    # question that happens to use the word \\\"question\\\" as executor\\n    # provenance, before the structural check in derive_stop is reached.\\n    \\\"question\\\": (),\\n    # environment/tenant (issue #115) is set directly by cmd_build's own\\n    # preflight -- the one caller who knows a [checks].command exited 2\\n    # on the approved tree -- never derived from adapter text. Left at\\n    # the default, the generic match above would catch the word\\n    # \\\"environment\\\" anywhere in a log or refusal (e.g. codex's own\\n    # OPENAI_API_KEY auth-mismatch refusal, adapters/codex/run's\\n    # check_auth) as an environment/executor stop that never happened.\\n    \\\"environment\\\": (),\\n}\\n\\n# Known tool error text for a declared ceiling -- issue #86's own specimen\\n# (codex's \\\"Input exceeds...\\\" line on a diff too large to judge) is\\n# \\\"input_too_large\\\"; a matching line anywhere in the log, not only its\\n# last line, since cmd_build and cmd_verify both append \\\"[adapter exited\\n# N]\\\" after whatever the tool itself printed. \\\"ceiling exceeded\\\" is issue\\n# #93's own addition: both adapters now refuse pre-emptively, before the\\n# tool is ever invoked, against a declared or fixed input limit, and\\n# their refusal text is not caught by any of the three markers above.\\nCEILING_MARKERS = (\\\"input_too_large\\\", \\\"exceeds the maximum context length\\\",\\n                  \\\"context_length_exceeded\\\", \\\"ceiling exceeded\\\")\\n\\n\\n# Issue #100's followups: an unclassed detail is the log's last line\\n# verbatim, and that line is sometimes an adapter's own event JSON or a\\n# tool's full error text -- thousands of characters wide. Capped here,\\n# at write time, so a filed issue's own summary of it (file-stops'\\n# log_tail already carries the full picture) stays short; the class\\n# itself, \\\"unclassed\\\", already says the full explanation lives in the\\n# log, not in this field.\\nUNCLASSED_DETAIL_MAX_CHARS = 200\\n\\n\\ndef _log_last_line(log: str | None) -> str:\\n    lines = [l for l in (log or \\\"\\\").splitlines() if l.strip()]\\n    last = lines[-1] if lines else \\\"\\\"\\n    return last[:UNCLASSED_DETAIL_MAX_CHARS]\\n\\n\\ndef _carries_a_known_class(text: str | None) -> str | None:\\n    \\\"\\\"\\\"Whichever of STOP_CLASSES this text names -- its own spelling, or\\n    one of CLASS_TEXT_MARKERS' real-world phrasings of it, when that\\n    class is not disabled there -- or None. Issue #88 is where an\\n    adapter's own halt or refusal first named its class this way; issue\\n    #93 added ceiling's own pre-emptive refusal to that set and disabled\\n    its bare-name match (CEILING_MARKERS covers it instead); issue #94\\n    disables non-question and outlived-invocation the same way, reading\\n    both from the adapter's own report line (derive_stop's report_class)\\n    now instead.\\\"\\\"\\\"\\n    text = text or \\\"\\\"\\n    for name in STOP_CLASSES:\\n        markers = CLASS_TEXT_MARKERS.get(name, (name,))\\n        if any(marker in text for marker in markers):\\n            return name\\n    return None\\n\\n\\ndef derive_stop(status: str, *, refusal: str | None = None, halted: dict[str, Any] | None = None,\\n                log: str | None = None, report_class: str | None = None,\\n                refusal_provenance: str | None = None) -> Stop | None:\\n    \\\"\\\"\\\"The stop field for a build or verify record: None for status \\\"pass\\\",\\n    else {class, provenance, detail} from what the caller already knows.\\n\\n      - report_class -- payload.get(\\\"class\\\") off the adapter's own report\\n        line (issue #88, #94), when it names a STOP_CLASSES member -- is\\n        that class, provenance \\\"executor\\\". build.schema.json and\\n        verify.schema.json stay untouched by issue #88 on purpose, so the\\n        class lives only on the report line, never a structured field\\n        cmd_build or cmd_verify forwards on its own account; the caller\\n        reads payload itself and passes this in, since only it still has\\n        payload once an iteration ends. This is non-question's and\\n        outlived-invocation's only path to a record now (issue #94):\\n        CLASS_TEXT_MARKERS disables both for the text scan below, the\\n        same way issue #93 disabled ceiling's bare-name match there. A\\n        class an adapter does not yet put on its report line --\\n        outlived-invocation today, since that refusal path prints no\\n        report line at all -- falls to unclassed below, same as any\\n        other unnamed cause, until the adapter that raises it puts a\\n        class on the line the way non-question already does.\\n      - a halt carrying a non-empty halted.question, once it is not a\\n        non-question caught above, is a genuine question -- question/spec,\\n        with the question's own first line as detail (issue #100's\\n        followups). This is the specimen issue #100 itself was built to\\n        retire: tenant zero's #663 build-01, a proper question, classed\\n        unclassed/product and filed as a product defect with the wrong\\n        provenance -- a question is about the definition of done, which is\\n        a person's or a ruling's to answer, never the product's own\\n        mechanism.\\n      - failing that, a refusal or the log itself that already names its\\n        class in text (issue #88, #93 for ceiling's own pre-emptive\\n        refusal) is that class, provenance \\\"executor\\\" -- the log is\\n        checked because neither adapter's refusal *field* carries the\\n        class today; the class-naming line each adapter prints reaches\\n        only the transcript\\n      - a refusal that is not that -- the write-outside-claims path\\n        itself, not the \\\"commit ... not authored by the executor\\\" shape\\n        -- is claims-boundary/spec, unless the caller already knows this\\n        refusal touched paths.records or paths.specs (issue #140:\\n        protected_path_touched, checked ahead of the ordinary claims\\n        match in cmd_build) and passes refusal_provenance=\\\"executor\\\" --\\n        the product's own directories are not a claim a spec makes, so a\\n        refusal there is not the spec's boundary to answer for\\n      - a returned verify (the forge was not green; no adapter ran) is\\n        forge-unconcluded/tenant\\n      - an adapter exit whose log carries a declared-ceiling error line is\\n        ceiling/product\\n      - anything else is unclassed/product, with the log's last line\\n        (capped at UNCLASSED_DETAIL_MAX_CHARS) as its detail -- the other\\n        class that carries a detail, since every remaining class's\\n        evidence already lives in refusal, halted, forge_checks, or the\\n        log itself.\\n    \\\"\\\"\\\"\\n    if status == \\\"pass\\\":\\n        return None\\n    if status == \\\"returned\\\":\\n        return {\\\"class\\\": \\\"forge-unconcluded\\\", \\\"provenance\\\": \\\"tenant\\\", \\\"detail\\\": None}\\n    if report_class in STOP_CLASSES:\\n        return {\\\"class\\\": report_class, \\\"provenance\\\": \\\"executor\\\", \\\"detail\\\": None}\\n    question = (halted or {}).get(\\\"question\\\")\\n    if status == \\\"halted\\\" and question:\\n        return {\\\"class\\\": \\\"question\\\", \\\"provenance\\\": \\\"spec\\\",\\n               \\\"detail\\\": question.splitlines()[0]}\\n    known = _carries_a_known_class(refusal) or _carries_a_known_class(log)\\n    if known:\\n        return {\\\"class\\\": known, \\\"provenance\\\": \\\"executor\\\", \\\"detail\\\": None}\\n    if status == \\\"refused\\\" and refusal is not None and not refusal.startswith(\\\"commit \\\"):\\n        return {\\\"class\\\": \\\"claims-boundary\\\", \\\"provenance\\\": refusal_provenance or \\\"spec\\\",\\n               \\\"detail\\\": None}\\n    if log and any(marker in log.lower() for marker in CEILING_MARKERS):\\n        return {\\\"class\\\": \\\"ceiling\\\", \\\"provenance\\\": \\\"product\\\", \\\"detail\\\": None}\\n    return {\\\"class\\\": \\\"unclassed\\\", \\\"provenance\\\": \\\"product\\\", \\\"detail\\\": _log_last_line(log)}\\n\\n\\ndef gate_stop(refusal: str | None) -> Stop:\\n    \\\"\\\"\\\"The stop for a refused spec-gate record: class \\\"gate\\\", provenance\\n    \\\"spec\\\", the refusal string itself as cause (issue #137) -- not\\n    derive_stop's generic claims-boundary/spec fallback issue #133\\n    reused, which named a boundary the record never crossed: \\\"criterion\\n    fails against the tree plus stub: doctor-template-absent.sh\\\" is not\\n    a write outside claims. cmd_spec_gate is untouched by this lane, so\\n    a spec record still carries no stop field of its own; this is\\n    synthesized wherever a refused one is read (item_stops,\\n    cmd_file_stops, proof_no_stop_lacks_cause), never persisted.\\\"\\\"\\\"\\n    return {\\\"class\\\": \\\"gate\\\", \\\"provenance\\\": \\\"spec\\\", \\\"detail\\\": refusal}\\n\\n\\n# --- stops: every non-pass record by class, provenance, and answerer\\n# (issue #129) ---\\n\\ndef item_stops(root: Path, m: dict[str, Any], item_id: str) -> dict[str, Any]:\\n    \\\"\\\"\\\"{\\\"item\\\", \\\"rows\\\", \\\"totals\\\"}: one row per non-pass build or verify\\n    record (STOP_STAGES), plus every refused spec-gate record (issue\\n    #133), class \\\"gate\\\" (issue #137) -- read from status and refusal\\n    rather than a stop field spec-gate records never carry (gate_stop\\n    synthesizes it) -- under item_id, whatever the record's own\\n    record_version -- a record too old to carry stop at all still gets\\n    a row, its class printed as the doctor's own phrase for it.\\n\\n    The answerer, a closed choice: \\\"counsel:<verdict>\\\" when\\n    counsel_record_for finds a counsel record naming this exact stage and\\n    number -- the product's own answer, which wins over whatever the stop\\n    itself says, since a counseled stop was already read once; failing\\n    that, \\\"person\\\" for class question (a person's to answer, not a\\n    guard's); failing that, \\\"guard\\\" for a class in GUARDED_STOP_CLASSES\\n    (a guard's own rejection needed no further reading); anything else\\n    -- no-cause, unclassed, or no stop at all -- is \\\"none\\\": nobody has\\n    answered it yet.\\\"\\\"\\\"\\n    records_rel = m[\\\"paths\\\"][\\\"records\\\"]\\n    item_records_dir = root / records_rel / item_id\\n    by_class = {c: 0 for c in stop_class_enum()}\\n    by_answerer: dict[str, int] = {}\\n    before_stop_was_recorded = 0\\n    rows: list[dict[str, Any]] = []\\n\\n    def add_row(stage: str, n: int, stop: Stop | None) -> None:\\n        nonlocal before_stop_was_recorded\\n        name = f\\\"{stage}-{n:02d}\\\"\\n        marker = item_records_dir / f\\\"{name}.filed\\\"\\n        filed_issue = marker.read_text() if marker.is_file() else None\\n        counsel = counsel_record_for(item_records_dir, stage, n)\\n\\n        if counsel is not None:\\n            answerer = f\\\"counsel:{counsel.get('verdict')}\\\"\\n        elif stop and stop.get(\\\"class\\\") == \\\"question\\\":\\n            answerer = \\\"person\\\"\\n        elif stop and stop.get(\\\"class\\\") in GUARDED_STOP_CLASSES:\\n            answerer = \\\"guard\\\"\\n        else:\\n            answerer = \\\"none\\\"\\n\\n        if stop:\\n            cls, provenance, detail = (stop.get(\\\"class\\\"), stop.get(\\\"provenance\\\"),\\n                                      stop.get(\\\"detail\\\"))\\n            if cls in by_class:\\n                by_class[cls] += 1\\n        else:\\n            cls, provenance, detail = \\\"before stop was recorded\\\", None, None\\n            before_stop_was_recorded += 1\\n\\n        by_answerer[answerer] = by_answerer.get(answerer, 0) + 1\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n+{\"type\":\"item.completed\",\"item\":{\"id\":\"item_4\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"rg -n '\\\"'^## |''^### '\\\"' attest/rulings.md /Users/davidbean/Projects/attest/attest/rulings.md\\nrg -n \\\\\\\"forge-unconcluded|forge.*green|no checks|checks.*empty|returned verify|selected tests|executor\\\\\\\" attest/rulings.md /Users/davidbean/Projects/attest/attest/rulings.md\\nrg -n \\\\\\\"forge-unconcluded|status.*failed|selected_tests.*exit|stop.*executor|forge_checks|checks.*conclusions\\\\\\\" /Users/davidbean/Projects/attest/attavo/*.py\\nsed -n '600,704p' attest/records/237/build-01.log | cut -c1-500\\\"\",\"aggregated_output\":\"/Users/davidbean/Projects/attest/attavo/doctor.py:610:                if (stage == \\\"build\\\" and rec.get(\\\"status\\\") == \\\"failed\\\"\\n/Users/davidbean/Projects/attest/attavo/drive.py:39:from attavo.verify import cmd_
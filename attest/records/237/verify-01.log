iteria.append(name)\n-    return {\"claims\": claims, \"criteria\": criteria}, None\n+    return {\"claims\": claims, \"criteria\": criteria, \"bucket\": bucket}, None\n+\n+\n+def buckets_path(root: Path, m: dict[str, Any]) -> Path:\n+    \"\"\"The tenant's closed list of root-cause buckets: buckets.md beside\n+    the specs directory (attest/buckets.md when specs live in attest/specs).\n+    One bucket per line, \"- <slug>: <one sentence>\".\"\"\"\n+    return root / Path(m[\"paths\"][\"specs\"]).parent / \"buckets.md\"\n+\n+\n+def listed_buckets(path: Path) -> list[str]:\n+    if not path.is_file():\n+        return []\n+    return [mm.group(1) for mm in (BUCKET_ENTRY.match(l) for l in path.read_text().splitlines()) if mm]\n+\n+\n+def bucket_refusal(root: Path, m: dict[str, Any], bucket: str | None) -> str | None:\n+    \"\"\"A spec that names a bucket must name one the tenant lists. Symptom\n+    counts do not converge; bucket counts can, and only if every bucket a\n+    fix item names is one the list already carries or an item added on\n+    purpose. No bucket line, no check: a capability item has no bucket.\"\"\"\n+    if bucket is None:\n+        return None\n+    path = buckets_path(root, m)\n+    if not path.is_file():\n+        return f\"bucket: {bucket} named but {path.relative_to(root)} does not exist\"\n+    if bucket not in listed_buckets(path):\n+        return f\"bucket: {bucket} is not listed in {path.relative_to(root)}\"\n+    return None\n \n \n def run_criterion(exe: Path, cwd: Path) -> int:\n@@ -194,6 +236,9 @@ def cmd_spec_gate(argv: list[str]) -> int:\n     results: list[dict[str, Any]] = []\n     if refusal is None:\n         # parse_spec returns a refusal exactly when it returns no spec.\n+        parsed = cast(dict[str, Any], parsed)\n+        refusal = bucket_refusal(root, m, parsed.get(\"bucket\"))\n+    if refusal is None:\n         parsed = cast(dict[str, Any], parsed)\n         if built:\n             refusal = stub_removed_refusal(root, spec_dir)\ndiff --git a/attest/buckets.md b/attest/buckets.md\nnew file mode 100644\nindex 0000000..55a5967\n--- /dev/null\n+++ b/attest/buckets.md\n@@ -0,0 +1,16 @@\n+# Root-cause buckets\n+\n+The closed list a fix item names with a `Bucket:` line in its spec's\n+problem. `attavo spec-gate` refuses a bucket that is not listed here;\n+adding one is an item's deliberate act, in the same change as the fix.\n+Symptom counts do not converge. The number to read is the count of\n+distinct buckets named by the fix items merged over the last N items:\n+flat while items merge is convergence; growing names the next invariant.\n+\n+Read it with: grep -h '^Bucket:' attest/specs/*/spec.md | sort | uniq -c\n+\n+- shared-working-copy: the executor, the driver, the screen and counsel wrote into one checkout; the invariant is that while a build runs the checkout is the executor's and every other actor writes records from a detached worktree (#227; #229 build-01, build-04's marker in the gate worktree; the driver's records-only commits)\n+- deny-list-tool-surface: the executor's tools were removed one at a time as each one hurt; the invariant is a boundary told at the edit and a foreground long enough for one test run (#227 build-01; #229 build-01, build-05)\n+- dogfood-tests-told-apart-by-a-list: the tests that read this repository's own records were named in hand-copied lists instead of by their marker; the invariant is one marker and no list (#229 build-04)\n+- liveness-by-proxy: a stage's liveness was read from a pid and a host name written by a process that is not the holder; the invariant is a heartbeat written by the holder (#229 build-04, build-05)\n+- classification-by-reading-prose: a stop's class and provenance were derived by scanning the transcript for words; the invariant is that class and provenance come from structured output and gate results (#219; #229 build-01, build-03, build-04, build-05)\ndiff --git a/attest/records/237/approval-01.json b/attest/records/237/ap
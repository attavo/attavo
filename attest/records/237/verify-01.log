 yet, or one that reads the\\\\n    running build's own marker, fails a build for nothing (#229\\\\n    build-04: the gate ran the whole suite and\\\\n    test_no_invocation_lacks_record read build-04's own .started marker\\\\n    as a dead invocation). They are told apart by @pytest.mark.own_records\\\\n    and by nothing else: [tests].run and ci.yml's test job carry\\\\n    -m 'not own_records', the doctor job and the inherit path carry\\\\n    -m own_records, and no --deselect names a test anywhere. Three\\\\n    hand-copied lists did this before and one was missing a test.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n    m = load_manifest()\\\\n    assert \\\\\\\"-m 'not own_records'\\\\\\\" in m[\\\\\\\"tests\\\\\\\"][\\\\\\\"run\\\\\\\"], m[\\\\\\\"tests\\\\\\\"][\\\\\\\"run\\\\\\\"]\\\\n    assert \\\\\\\"--deselect\\\\\\\" not in m[\\\\\\\"tests\\\\\\\"][\\\\\\\"run\\\\\\\"], m[\\\\\\\"tests\\\\\\\"][\\\\\\\"run\\\\\\\"]\\\\n    assert \\\\\\\"--deselect\\\\\\\" not in m[\\\\\\\"checks\\\\\\\"][\\\\\\\"command\\\\\\\"], m[\\\\\\\"checks\\\\\\\"][\\\\\\\"command\\\\\\\"]\\\\n    if \\\\\\\"pytest\\\\\\\" in m[\\\\\\\"checks\\\\\\\"][\\\\\\\"command\\\\\\\"]:\\\\n        assert \\\\\\\"-m 'not own_records'\\\\\\\" in m[\\\\\\\"checks\\\\\\\"][\\\\\\\"command\\\\\\\"], m[\\\\\\\"checks\\\\\\\"][\\\\\\\"command\\\\\\\"]\\\\n    ci = (ROOT / \\\\\\\".github\\\\\\\" / \\\\\\\"workflows\\\\\\\" / \\\\\\\"ci.yml\\\\\\\").read_text()\\\\n    assert \\\\\\\"--deselect\\\\\\\" not in ci\\\\n    assert \\\\\\\"python3 -m pytest tests -q --durations=5 -m 'not own_records'\\\\\\\" in ci\\\\n    assert ci.count(\\\\\\\"python3 -m pytest tests -q -m own_records\\\\\\\") == 2, \\\\\\\"the inherit path and the doctor job\\\\\\\"\\\\n\\\\n\\\\ndef run_select_tests(stdin_text: str) -> list[str]:\\\\n    run = subprocess.run([sys.executable, str(SELECT_TESTS)], input=stdin_text,\\\\n                         capture_output=True, text=True, check=True)\\\\n    return [line for line in run.stdout.splitlines() if line]\\\\n\\\\n\\\\ndef test_select_tests_maps_bin_attavo_to_the_whole_suite() -> None:\\\\n    assert run_select_tests(\\\\\\\"bin/attavo\\\\\\\\n\\\\\\\") == [\\\\\\\"tests\\\\\\\"]\\\\n\\\\n\\\\ndef test_select_tests_maps_an_adapter_path_to_the_adapter_tests() -> None:\\\\n    selected = run_select_tests(\\\\\\\"adapters/example/run\\\\\\\\n\\\\\\\")\\\\n    assert \\\\\\\"tests/test_adapters.py\\\\\\\" in selected and \\\\\\\"tests/test_executor_conformance.py\\\\\\\" in selected\\\\n    assert \\\\\\\"tests\\\\\\\" not in selected, \\\\\\\"an adapter path selected the whole suite\\\\\\\"\\\\n\\\\n\\\\ndef test_select_tests_maps_a_schema_path_to_the_record_and_attest_tests() -> None:\\\\n    selected = run_select_tests(\\\\\\\"schema/records/build.schema.json\\\\\\\\n\\\\\\\")\\\\n    assert \\\\\\\"tests/test_record_schemas.py\\\\\\\" in selected and \\\\\\\"tests/test_attest.py\\\\\\\" in selected\\\\n    assert \\\\\\\"tests\\\\\\\" not in selected, \\\\\\\"a schema path selected the whole suite\\\\\\\"\\\\n\\\\n\\\\ndef test_select_tests_maps_an_unrelated_path_to_nothing() -> None:\\\\n    assert run_select_tests(\\\\\\\"README.md\\\\\\\\n\\\\\\\") == []\\\\n\\\\n\\\\ndef test_copied_workflows_pin_the_release_the_manifest_declares() -> None:\\\\n    pin = load_manifest()[\\\\\\\"attavo\\\\\\\"][\\\\\\\"version\\\\\\\"]\\\\n    for path in COPIED_WORKFLOWS:\\\\n        assert f\\\\\\\"uses: attavo/attavo@{pin}\\\\\\\" in path.read_text(), (path.name, pin)\\\\n\\\\n\\\\ndef test_schema_version_job_reports_on_merge_group() -> None:\\\\n    text = CI_YML.read_text()\\\\n    lines = text.splitlines()\\\\n    on_idx = next(i for i, l in enumerate(lines) if l.strip() == \\\\\\\"on:\\\\\\\")\\\\n    jobs_idx = next(i for i, l in enumerate(lines) if l.strip() == \\\\\\\"jobs:\\\\\\\")\\\\n    on_body = \\\\\\\"\\\\\\\\n\\\\\\\".join(lines[on_idx + 1:jobs_idx])\\\\n    assert \\\\\\\"merge_group:\\\\\\\" in on_body\\\\n\\\\n    condition = job_if_condition(text, \\\\\\\"schema-version\\\\\\\")\\\\n    assert condition is not None\\\\n    assert \\\\\\\"github.event_name == 'merge_group'\\\\\\\" in condition\\\\n    assert \\\\\\\"github.event_name == 'pull_request'\\\\\\\" in condition\\\\n\\\\n\\\\ndef test_doctor_job_reports_on_pull_request_and_merge_group() -> None:\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"Issue #113: the doctor job's #106 condition, main-only, hid it from\\\\n    pull requests and merge groups -- the events where a refusal is\\\\n    cheap. It must name both, and never reduce to the main-only shape a\\\\n    later edit could reintroduce.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n    condition = job_if_condition(CI_YML.read_text(), \\\\\\\"doctor\\\\\\\")\\\\n    assert condition is not None\\\\n    assert \\\\\\\"github.event_name == 'pull_request'\\\\\\\" in condition\\\\n    assert \\\\\\\"github.event_name == 'merge_group'\\\\\\\" in condition\\\\n    assert condition != \\\\\\\"github.ref == 'refs/heads/main'\\\\\\\"\\\\n\\\\n\\\\n# The product's own pre-existing, generic vocabulary that a blind grep for\\\\n# TENANCY_STRINGS would otherwise flag: \\\\\\\"attavo.toml\\\\\\\" is the manifest\\\\n# filename every tenant uses, named by the schema itself, not a fact\\\\n# about this repository's own installation (adapters/README.md's\\\\n# ATTAVO_MANIFEST doc line, bin/attavo's own MANIFEST constant, the\\\\n# schema's own title, and the two template workflows' own tomllib read of\\\\n# whatever tenant copies them in -- theirs, never this repository's).\\\\n# Each entry is\\\\n# (path relative to ROOT, the exact line's stripped text) so a genuinely\\\\n# new occurrence -- anywhere else, or a changed line here -- still fails\\\\n# the test.\\\\nBASELINE = {\\\\n    (\\\\\\\"adapters/README.md\\\\\\\",\\\\n     \\\\\\\"- `ATTAVO_MANIFEST` — counsel only: the path to the tenant's own `attavo.toml`.\\\\\\\"),\\\\n    (\\\\\\\"bin/attavo\\\\\\\", 'MANIFEST = \\\\\\\"attavo.toml\\\\\\\"'),\\\\n    (\\\\\\\"schema/manifest.schema.json\\\\\\\", '\\\\\\\"title\\\\\\\": \\\\\\\"Attavo tenant manifest (attavo.toml)\\\\\\\",'),\\\\n    (\\\\\\\"templates/workflows/attavo-approve.yml\\\\\\\",\\\\n     'records_rel=\\\\\\\"$(python3 -c \\\\\\\"import tomllib; print(tomllib.load(open(\\\\\\\\'attavo.toml\\\\\\\\',\\\\\\\\'rb\\\\\\\\'))[\\\\\\\\'paths\\\\\\\\'][\\\\\\\\'records\\\\\\\\'])\\\\\\\")\\\\\\\"'),\\\\n    (\\\\\\\"templates/workflows/attavo-spec-gate.yml\\\\\\\",\\\\n     'records_rel=\\\\\\\"$(python3 -c \\\\\\\"import tomllib; print(tomllib.load(open(\\\\\\\\'attavo.toml\\\\\\\\',\\\\\\\\'rb\\\\\\\\'))[\\\\\\\\'paths\\\\\\\\'][\\\\\\\\'records\\\\\\\\'])\\\\\\\")\\\\\\\"'),\\\\n}\\\\n\\\\n\\\\ndef test_rejection_no_product_file_names_a_tenancy_path() -> None:\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"The product does not know it is a tenant: no file under bin/,\\\\n    adapters/, schema/, templates/, or action.yml mentions .attavo/,\\\\n    attavo.toml, or attest/records as a path, beyond the pre-existing\\\\n    generic mentions in BASELINE. Written and run red once by planting\\\\n    \\\\\\\"attest/records\\\\\\\" in a scratch line under bin/ during development;\\\\n    removed once this test caught it.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n    offenders = []\\\\n    paths = list(BOUNDARY_FILES)\\\\n    for d in BOUNDARY_DIRS:\\\\n        paths.extend(p for p in (ROOT / d).rglob(\\\\\\\"*\\\\\\\") if p.is_file())\\\\n    for path in paths:\\\\n        try:\\\\n            lines = path.read_text().splitlines()\\\\n        except (UnicodeDecodeError, OSError):\\\\n            continue\\\\n        relpath = str(path.relative_to(ROOT))\\\\n        for line in lines:\\\\n            stripped = line.strip()\\\\n            if (relpath, stripped) in BASELINE:\\\\n                continue\\\\n            for needle in TENANCY_STRINGS:\\\\n                if needle in line:\\\\n                    offenders.append(f\\\\\\\"{relpath}: {needle!r} in {stripped!r}\\\\\\\")\\\\n    assert not offenders, offenders\\\",\\\"stderr\\\":\\\"\\\",\\\"interrupted\\\":false,\\\"isImage\\\":false,\\\"noOutputExpected\\\":false}}\\n544:{\\\"type\\\":\\\"system\\\",\\\"subtype\\\":\\\"task_notification\\\",\\\"task_id\\\":\\\"bdw4ssa38\\\",\\\"tool_use_id\\\":\\\"toolu_01PAW5uXGomtMDvhjxdwUbWJ\\\",\\\"status\\\":\\\"completed\\\",\\\"output_file\\\":\\\"/private/tmp/claude-501/-Users-davidbean-Projects-attavo-worktree-237/7ff7b485-8759-4f05-8eef-e2bfffd293b8/tasks/bdw4ssa38.output\\\",\\\"summary\\\":\\\"Background command \\\\\\\"ls bin 2>/dev/null; python3 /Users/davidbean/Projects/attest/bin/attavo test 237 2>&1 | tail -100\\\\\\\" completed (exit code 0)\\\",\\\"uuid\\\":\\\"5dcf3618-586e-434c-9112-d902384c1247\\\",\\\"session_id\\\":\\\"7ff7b485-8759-4f05-8eef-e2bfffd293b8\\\"}\\n551:{\\\"type\\\":\\\"user\\\",\\\"message\\\":{\\\"role\\\":\\\"user\\\",\\\"content\\\":[{\\\"tool_use_id\\\":\\\"toolu_01DQ8zLyoEAEBtxb2i3TsZfd\\\",\\\"type\\\":\\\"tool_result\\\",\\\"content\\\":\\\"commit 3418772d643654b00471e767969242c88a42c314\\\\nAuthor: attavo executor (claude-code) <executor+claude-code@attavo.invalid>\\\\nDate:   Sun Sep 27 14:42:36 2026 -0600\\\\n\\\\n    own_records marker replaces the three hand-copied deselect lists (#237)\\\\n    \\\\n    Item #229 build-04's fourth attempt failed because select-tests mapped a\\\\n    common.py/build.py change to the whole suite and the gate ran\\\\n    test_no_invocation_lacks_record, which read build-04's own .started\\\\n    marker as a dead invocation. That test was one of the seven doctor tests\\\\n    that read this repository's own records, told apart from the rest of the\\\\n    suite by three hand-copied --deselect lists that stayed in sync only by\\\\n    convention -- and the list was missing it.\\\\n    \\\\n    @pytest.mark.own_records already existed and already had a guard\\\\n    (test_own_records_guard.py) enforcing that every test reading this\\\\n    repository's own records carries it. This closes the gap: the six\\\\n    doctor tests gain the marker, [tests].run and ci.yml's full-suite step\\\\n    become `-m 'not own_records'`, the doctor job and the inherit path run\\\\n    `-m own_records`, every --deselect and DESELECT_FLAGS list is gone, and\\\\n    the guard's exemption for the doctor tests goes with it.\\\\n    \\\\n    Also lands the bucket line: a fix item's spec names the root-cause\\\\n    bucket it closes with `Bucket: <slug>`, and spec-gate refuses a slug\\\\n    attest/buckets.md does not list before any criterion runs. buckets.md\\\\n    lists the five buckets from the 2026-09-27 convergence ruling.\\\\n    \\\\n    Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>\\\\n\\\\ndiff --git a/attavo/spec.py b/attavo/spec.py\\\\nindex 8cf623c..e263ca5 100644\\\\n--- a/attavo/spec.py\\\\n+++ b/attavo/spec.py\\\\n@@ -1,6 +1,7 @@\\\\n from __future__ import annotations\\\\n \\\\n import os\\\\n+import re\\\\n import shutil\\\\n import subprocess\\\\n import sys\\\\n@@ -22,6 +23,10 @@ from attavo.records import latest_record, write_record\\\\n \\\\n # --- the spec contract ---\\\\n \\\\n+BUCKET_LINE = re.compile(r\\\\\\\"^Bucket:\\\\\\\\s*([a-z0-9][a-z0-9-]*)\\\\\\\\s*$\\\\\\\")\\\\n+BUCKET_ENTRY = re.compile(r\\\\\\\"^- ([a-z0-9][a-z0-9-]*):\\\\\\\\s+\\\\\\\\S\\\\\\\")\\\\n+\\\\n+\\\\n def parse_spec(spec_md: Path) -> tuple[dict[str, Any] | None, str | None]:\\\\n     lines = spec_md.read_text().splitlines()\\\\n     heading_idx = [i for i, l in enumerate(lines) if l.startswith(\\\\\\\"## \\\\\\\")]\\\\n@@ -36,6 +41,15 @@ def parse_spec(spec_md: Path) -> tuple[dict[str, Any] | None, str | None]:\\\\n     idx_problem, idx_claims, idx_criteria = heading_idx\\\\n     claims = [l.strip()[2:].strip() for l in lines[idx_claims + 1:idx_criteria]\\\\n               if l.strip().startswith(\\\\\\\"- \\\\\\\")]\\\\n+    # A fix item names the root-cause bucket its change closes, as one\\\\n+    # line in the problem: \\\\\\\"Bucket: <slug>\\\\\\\". Optional; when present the\\\\n+    # gate checks it against the tenant's closed list (bucket_refusal).\\\\n+    bucket = None\\\\n+    for l in lines[idx_problem + 1:idx_claims]:\\\\n+        m = BUCKET_LINE.match(l)\\\\n+        if m:\\\\n+            bucket = m.group(1)\\\\n+            break\\\\n     criteria = []\\\\n     for l in lines[idx_criteria + 1:]:\\\\n         s = l.strip()\\\\n@@ -43,7 +57,35 @@ def parse_spec(spec_md: Path) -> tuple[dict[str, Any] | None, str | None]:\\\\n             continue\\\\n         name = s[2:].split(\\\\\\\":\\\\\\\", 1)[0].strip()\\\\n         criteria.append(name)\\\\n-    return {\\\\\\\"claims\\\\\\\": claims, \\\\\\\"criteria\\\\\\\": criteria}, None\\\\n+    return {\\\\\\\"claims\\\\\\\": claims, \\\\\\\"criteria\\\\\\\": criteria, \\\\\\\"bucket\\\\\\\": bucket}, None\\\\n+\\\\n+\\\\n+def buckets_path(root: Path, m: dict[str, Any]) -> Path:\\\\n+    \\\\\\\"\\\\\\\"\\\\\\\"The tenant's closed list of root-cause buckets: buckets.md beside\\\\n+    the specs directory (attest/buckets.md when specs live in attest/specs).\\\\n+    One bucket per line, \\\\\\\"- <slug>: <one sentence>\\\\\\\".\\\\\\\"\\\\\\\"\\\\\\\"\\\\n+    return root / Path(m[\\\\\\\"paths\\\\\\\"][\\\\\\\"specs\\\\\\\"]).parent / \\\\\\\"buckets.md\\\\\\\"\\\\n+\\\\n+\\\\n+def listed_buckets(path: Path) -> list[str]:\\\\n+    if not path.is_file():\\\\n+        return []\\\\n+    return [mm.group(1) for mm in (BUCKET_ENTRY.match(l) for l in path.read_text().splitlines()) if mm]\\\\n+\\\\n+\\\\n+def bucket_refusal(root: Path, m: dict[str, Any], bucket: str | None) -> str | None:\\\\n+    \\\\\\\"\\\\\\\"\\\\\\\"A spec that names a bucket must name one the tenant lists. Symptom\\\\n+    counts do not converge; bucket counts can, and only if every bucket a\\\\n+    fix item names is one the list already carries or an item added on\\\\n+    purpose. No bucket line, no check: a capability item has no bucket.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n+    if bucket is None:\\\\n+        return None\\\\n+    path = buckets_path(root, m)\\\\n+    if not path.is_file():\\\\n+        return f\\\\\\\"bucket: {bucket} named but {path.relative_to(root)} does not exist\\\\\\\"\\\\n+    if bucket not in listed_buckets(path):\\\\n+        return f\\\\\\\"bucket: {bucket} is not listed in {path.relative_to(root)}\\\\\\\"\\\\n+    return None\\\\n \\\\n \\\\n def run_criterion(exe: Path, cwd: Path) -> int:\\\\n@@ -194,6 +236,9 @@ def cmd_spec_gate(argv: list[str]) -> int:\\\\n     results: list[dict[str, Any]] = []\\\\n     if refusal is None:\\\\n         # parse_spec returns a refusal exactly when it returns no spec.\\\\n+        parsed = cast(dict[str, Any], parsed)\\\\n+        refusal = bucket_refusal(root, m, parsed.get(\\\\\\\"bucket\\\\\\\"))\\\\n+    if refusal is None:\\\\n         parsed = cast(dict[str, Any], parsed)\\\\n         if built:\\\\n             refusal = stub_removed_refusal(root, spec_dir)\\\",\\\"is_error\\\":false}]},\\\"parent_tool_use_id\\\":null,\\\"session_id\\\":\\\"7ff7b485-8759-4f05-8eef-e2bfffd293b8\\\",\\\"uuid\\\":\\\"7596d4d0-8620-4178-a143-5aca8174c9a5\\\",\\\"timestamp\\\":\\\"2026-09-27T20:56:24.200Z\\\",\\\"tool_use_result\\\":{\\\"stdout\\\":\\\"commit 3418772d643654b00471e767969242c88a42c314\\\\nAuthor: attavo executor (claude-code) <executor+claude-code@attavo.invalid>\\\\nDate:   Sun Sep 27 14:42:36 2026 -0600\\\\n\\\\n    own_records marker replaces the three hand-copied deselect lists (#237)\\\\n    \\\\n    Item #229 build-04's fourth attempt failed because select-tests mapped a\\\\n    common.py/build.py change to the whole suite and the gate ran\\\\n    test_no_invocation_lacks_record, which read build-04's own .started\\\\n    marker as a dead invocation. That test was one of the seven doctor tests\\\\n    that read this repository's own records, told apart from the rest of the\\\\n    suite by three hand-copied --deselect lists that stayed in sync only by\\\\n    convention -- and the list was missing it.\\\\n    \
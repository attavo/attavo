idx_problem, idx_claims, idx_criteria = heading_idx\\\\n     claims = [l.strip()[2:].strip() for l in lines[idx_claims + 1:idx_criteria]\\\\n               if l.strip().startswith(\\\\\\\"- \\\\\\\")]\\\\n+    # A fix item names the root-cause bucket its change closes, as one\\\\n+    # line in the problem: \\\\\\\"Bucket: <slug>\\\\\\\". Optional; when present the\\\\n+    # gate checks it against the tenant's closed list (bucket_refusal).\\\\n+    bucket = None\\\\n+    for l in lines[idx_problem + 1:idx_claims]:\\\\n+        m = BUCKET_LINE.match(l)\\\\n+        if m:\\\\n+            bucket = m.group(1)\\\\n+            break\\\\n     criteria = []\\\\n     for l in lines[idx_criteria + 1:]:\\\\n         s = l.strip()\\\\n@@ -43,7 +57,35 @@ def parse_spec(spec_md: Path) -> tuple[dict[str, Any] | None, str | None]:\\\\n             continue\\\\n         name = s[2:].split(\\\\\\\":\\\\\\\", 1)[0].strip()\\\\n         criteria.append(name)\\\\n-    return {\\\\\\\"claims\\\\\\\": claims, \\\\\\\"criteria\\\\\\\": criteria}, None\\\\n+    return {\\\\\\\"claims\\\\\\\": claims, \\\\\\\"criteria\\\\\\\": criteria, \\\\\\\"bucket\\\\\\\": bucket}, None\\\\n+\\\\n+\\\\n+def buckets_path(root: Path, m: dict[str, Any]) -> Path:\\\\n+    \\\\\\\"\\\\\\\"\\\\\\\"The tenant's closed list of root-cause buckets: buckets.md beside\\\\n+    the specs directory (attest/buckets.md when specs live in attest/specs).\\\\n+    One bucket per line, \\\\\\\"- <slug>: <one sentence>\\\\\\\".\\\\\\\"\\\\\\\"\\\\\\\"\\\\n+    return root / Path(m[\\\\\\\"paths\\\\\\\"][\\\\\\\"specs\\\\\\\"]).parent / \\\\\\\"buckets.md\\\\\\\"\\\\n+\\\\n+\\\\n+def listed_buckets(path: Path) -> list[str]:\\\\n+    if not path.is_file():\\\\n+        return []\\\\n+    return [mm.group(1) for mm in (BUCKET_ENTRY.match(l) for l in path.read_text().splitlines()) if mm]\\\\n+\\\\n+\\\\n+def bucket_refusal(root: Path, m: dict[str, Any], bucket: str | None) -> str | None:\\\\n+    \\\\\\\"\\\\\\\"\\\\\\\"A spec that names a bucket must name one the tenant lists. Symptom\\\\n+    counts do not converge; bucket counts can, and only if every bucket a\\\\n+    fix item names is one the list already carries or an item added on\\\\n+    purpose. No bucket line, no check: a capability item has no bucket.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n+    if bucket is None:\\\\n+        return None\\\\n+    path = buckets_path(root, m)\\\\n+    if not path.is_file():\\\\n+        return f\\\\\\\"bucket: {bucket} named but {path.relative_to(root)} does not exist\\\\\\\"\\\\n+    if bucket not in listed_buckets(path):\\\\n+        return f\\\\\\\"bucket: {bucket} is not listed in {path.relative_to(root)}\\\\\\\"\\\\n+    return None\\\\n \\\\n \\\\n def run_criterion(exe: Path, cwd: Path) -> int:\\\\n@@ -194,6 +236,9 @@ def cmd_spec_gate(argv: list[str]) -> int:\\\\n     results: list[dict[str, Any]] = []\\\\n     if refusal is None:\\\\n         # parse_spec returns a refusal exactly when it returns no spec.\\\\n+        parsed = cast(dict[str, Any], parsed)\\\\n+        refusal = bucket_refusal(root, m, parsed.get(\\\\\\\"bucket\\\\\\\"))\\\\n+    if refusal is None:\\\\n         parsed = cast(dict[str, Any], parsed)\\\\n         if built:\\\\n             refusal = stub_removed_refusal(root, spec_dir)\\\\ndiff --git a/tests/test_ci_inherit.py b/tests/test_ci_inherit.py\\\\nindex a1570ad..37067fa 100644\\\\n--- a/tests/test_ci_inherit.py\\\\n+++ b/tests/test_ci_inherit.py\\\\n@@ -439,7 +439,11 @@ def test_test_runs_only_the_own_records_tests_on_its_inherit_path() -> None:\\\\n     assert \\\\\\\"python3 -m pytest tests -q -m own_records\\\\\\\" in own[0]\\\\n     full = [step for step in steps if \\\\\\\"python3 -m pytest tests -q --durations=5\\\\\\\" in step]\\\\n     assert len(full) == 1 and SKIP_WHEN_INHERITED in full[0]\\\\n-    assert \\\\\\\"-m \\\\\\\" not in full[0].replace(\\\\\\\"-m pytest\\\\\\\", \\\\\\\"\\\\\\\"), \\\\\\\"the full path runs every test\\\\\\\"\\\\n+    # The two paths partition the suite by one marker: the inherit path\\\\n+    # runs the own-records tests and the full path runs everything else.\\\\n+    # Together they are the whole suite; no test is named in either.\\\\n+    assert \\\\\\\"-m 'not own_records'\\\\\\\" in full[0], full[0]\\\\n+    assert \\\\\\\"--deselect\\\\\\\" not in full[0], \\\\\\\"a test named by hand is a list that goes stale (#229 build-04)\\\\\\\"\\\\n \\\\n \\\\n def test_the_queue_has_no_path_to_the_script() -> None:\\\\ndiff --git a/tests/test_cli_help.py b/tests/test_cli_help.py\\\\nindex 6994db3..7c191b8 100644\\\\n--- a/tests/test_cli_help.py\\\\n+++ b/tests/test_cli_help.py\\\\n@@ -94,3 +94,14 @@ def test_help_names_the_seventh_proof_and_the_empty_stop() -> None:\\\\n     assert run.returncode == 0\\\\n     for phrase in (\\\\\\\"no attested item is empty\\\\\\\", \\\\\\\"built_since\\\\\\\", \\\\\\\"committed nothing\\\\\\\", \\\\\\\"reads the commit\\\\\\\"):\\\\n         assert phrase in run.stdout, phrase\\\\n+\\\\n+\\\\n+def test_help_names_the_bucket_line_and_the_marker() -> None:\\\\n+    \\\\\\\"\\\\\\\"\\\\\\\"Item 229's fix: the spec gate's bucket refusal and the own_records\\\\n+    marker as the only way a tenant's dogfood tests are told apart. Red on\\\\n+    the tree and on the stub: the words are the build's.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n+    run = subprocess.run([sys.executable, str(ATTAVO), \\\\\\\"--help\\\\\\\"],\\\\n+                         capture_output=True, text=True, check=False)\\\\n+    assert run.returncode == 0\\\\n+    for phrase in (\\\\\\\"Bucket:\\\\\\\", \\\\\\\"buckets.md\\\\\\\", \\\\\\\"own_records\\\\\\\"):\\\\n+        assert phrase in run.stdout, phrase\\\\ndiff --git a/tests/test_doctor.py b/tests/test_doctor.py\\\\nindex e00f518..19fd76c 100644\\\\n--- a/tests/test_doctor.py\\\\n+++ b/tests/test_doctor.py\\\\n@@ -31,6 +31,7 @@ def run_doctor(root: Path) -> dict[str, Any]:\\\\n     return {p[\\\\\\\"proof\\\\\\\"]: p for p in report[\\\\\\\"proofs\\\\\
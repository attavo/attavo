 rec[\\\"status\\\"] == \\\"pass\\\"\\n     assert rec[\\\"criteria\\\"] == [{\\\"name\\\": \\\"checks_marker.sh\\\", \\\"on_tree\\\": 1, \\\"on_stub\\\": 0}]\\n     assert rec[\\\"refusal\\\"] is None\\n+\\n+\\n+def add_bucket_line(root: Path, bucket: str) -> None:\\n+    spec_md = root / \\\"specs\\\" / \\\"1\\\" / \\\"spec.md\\\"\\n+    text = spec_md.read_text().replace(\\\"## Problem\\\\n\\\", f\\\"## Problem\\\\n\\\\nBucket: {bucket}\\\\n\\\", 1)\\n+    spec_md.write_text(text)\\n+    commit_all(root, f\\\"name bucket {bucket}\\\")\\n+\\n+\\n+def test_spec_gate_refuses_a_bucket_the_tenant_does_not_list_and_passes_a_listed_one(tmp_path: Path) -> None:\\n+    \\\"\\\"\\\"Root-cause buckets (#229 build-04 and the convergence ruling of\\n+    2026-09-27): a fix item names the bucket its change closes as one\\n+    'Bucket: <slug>' line in its problem, and the gate refuses a slug the\\n+    tenant's buckets.md (beside the specs directory) does not list, or a\\n+    line with no such file. Written red first: on v0.30.0 the line is\\n+    prose and the gate passes it.\\\"\\\"\\\"\\n+    root = make_tenant(tmp_path, \\\"valid\\\")\\n+    add_bucket_line(root, \\\"shared-working-copy\\\")\\n+    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n+    assert run.returncode == 1, run.stdout + run.stderr\\n+    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n+    assert rec[\\\"status\\\"] == \\\"refused\\\"\\n+    assert rec[\\\"refusal\\\"] == \\\"bucket: shared-working-copy named but buckets.md does not exist\\\", rec[\\\"refusal\\\"]\\n+    assert rec[\\\"criteria\\\"] == [], \\\"refused before any criterion ran\\\"\\n+\\n+    (root / \\\"buckets.md\\\").write_text(\\n+        \\\"# buckets\\\\n\\\\n- liveness-by-proxy: a pid stood in for the holder\\\\n\\\")\\n+    commit_all(root, \\\"list one bucket\\\")\\n+    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n+    assert run.returncode == 1\\n+    assert latest_record(root, \\\"1\\\", \\\"spec\\\")[\\\"refusal\\\"] == \\\"bucket: shared-working-copy is not listed in buckets.md\\\"\\n+\\n+    (root / \\\"buckets.md\\\").write_text(\\n+        \\\"# buckets\\\\n\\\\n- liveness-by-proxy: a pid stood in for the holder\\\\n\\\"\\n+        \\\"- shared-working-copy: one checkout, many writers\\\\n\\\")\\n+    commit_all(root, \\\"list the bucket\\\")\\n+    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n+    assert run.returncode == 0, run.stdout + run.stderr\\n+    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n+    assert rec[\\\"status\\\"] == \\\"pass\\\" and rec[\\\"refusal\\\"] is None\\n+\\n+\\n+def test_spec_gate_leaves_a_spec_with_no_bucket_line_alone(tmp_path: Path) -> None:\\n+    \\\"\\\"\\\"A capability item has no bucket; the check is on the line, not on\\n+    every spec, and a tenant with no buckets.md is not asked for one.\\\"\\\"\\\"\\n+    root = make_tenant(tmp_path, \\\"valid\\\")\\n+    assert not (root / \\\"buckets.md\\\").exists()\\n+    assert run_attavo(root, \\\"spec-gate\\\", \\\"1\\\").returncode == 0\",\"is_error\":false}]},\"parent_tool_use_id\":null,\"session_id\":\"5a752ff7-c430-4cfd-9b9a-21883129b5e6\",\"uuid\":\"b92e59ba-b77a-4f53-8c76-4144c2fd5a1a\",\"timestamp\":\"2026-09-27T20:32:56.015Z\",\"tool_use_result\":{\"stdout\":\"--- tests/test_spec_gate.py\\t2026-09-27 14:31:51\\n+++ attest/specs/237/stub/tests/test_spec_gate.py\\t2026-09-27 14:31:51\\n@@ -426,3 +426,51 @@\\n     assert rec[\\\"status\\\"] == \\\"pass\\\"\\n     assert rec[\\\"criteria\\\"] == [{\\\"name\\\": \\\"checks_marker.sh\\\", \\\"on_tree\\\": 1, \\\"on_stub\\\": 0}]\\n     assert rec[\\\"refusal\\\"] is None\\n+\\n+\\n+def add_bucket_line(root: Path, bucket: str) -> None:\\n+    spec_md = root / \\\"specs\\\" / \\\"1\\\" / \\\"spec.md\\\"\\n+    text = spec_md.read_text().replace(\\\"## Problem\\\\n\\\", f\\\"## Problem\\\\n\\\\nBucket: {bucket}\\\\n\\\", 1)\\n+    spec_md.write_text(text)\\n+    commit_all(root, f\\\"name bucket {bucket}\\\")\\n+\\n+\\n+def test_spec_gate_refuses_a_bucket_the_tenant_does_not_list_and_passes_a_listed_one(tmp_path: Path) -> None:\\n+    \\\"\\\"\\\"Root-cause buckets (#229 build-04 and the convergence ruling of\\n+    2026-09-27): a fix item names the bucket its change closes as one\\n+    'Bucket: <slug>' line in its problem, and the gate refuses a slug the\\n+    tenant's buckets.md (beside the specs directory) does not list, or a\\n+    line with no such file. Written red first: on v0.30.0 the line is\\n+    prose and the gate passes it.\\\"\\\"\\\"\\n+    root = make_tenant(tmp_path, \\\"valid\\\")\\n+    add_bucket_line(root, \\\"shared-working-copy\\\")\\n+    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n+    assert run.returncode == 1, run.stdout + run.stderr\\n+    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n+    assert rec[\\\"status\\\"] == \\\"refused\\\"\\n+    assert rec[\\\"refusal\\\"] == \\\"bucket: shared-working-copy named but buckets.md does not exist\\\", rec[\\\"refusal\\\"]\\n+    assert rec[\\\"criteria\\\"] == [], \\\"refused before any criterion ran\\\"\\n+\\n+    (root / \\\"buckets.md\\\").write_text(\\n+        \\\"# buckets\\\\n\\\\n- liveness-by-proxy: a pid stood in for the holder\\\\n\\\")\\n+    commit_all(root, \\\"list one bucket\\\")\\n+    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n+    assert run.returncode == 1\\n+    assert latest_record(root, \\\"1\\\", \\\"spec\\\")[\\\"refusal\\\"] == \\\"bucket: shared-working-copy is not listed in buckets.md\\\"\\n+\\n+    (root / \\\"buckets.md\\\").write_text(\\n+        \\\"# buckets\\\\n\\\\n- liveness-by-proxy: a pid stood in for the holder\\\\n\\\"\\n+        \\\"- shared-working-copy: one checkout, many writers\\\\n\\\")\\n+    commit_all(root, \\\"list the bucket\\\")\\n+    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n+    assert run.returncode == 0, run.stdout + run.stderr\\n+    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n+    assert rec[\\\"status\\\"] == \\\"pass\\\" and rec[\\\"refusal\\\"] is None\\n+\\n+\\n+def test_spec_gate_leaves_a_spec_with_no_bucket_line_alone(tmp_path: Path) -> None:\\n+    \\\"\\\"\\\"A capability item has no bucket; the check is on the line, not on\\n+    every spec, and a tenant with no buckets.md is not asked for one.\\\"\\\"\\\"\\n+    root = make_tenant(tmp_path, \\\"valid\\\")\\n+    assert not (root / \\\"buckets.md\\\").exists()\\n+    assert run_attavo(root, \\\"spec-gate\\\", \\\"1\\\").returncode == 0\",\"stderr\":\"\",\"interrupted\":false,\"isImage\":false,\"returnCodeInterpretation\":\"Files differ\",\"noOutputExpected\":false}}\n+{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_016DFWa89SXdXias1avEsFFV\",\"type\":\"tool_result\",\"content\":\"1\\t\\\"\\\"\\\"attavo: the command.\\n2\\t\\n3\\t    attavo doctor [TENANT_ROOT] [--json]\\n4\\t    attavo spec-gate [N]\\n5\\t    attavo approve [N] --by LOGIN\\n6\\t    attavo approval-status [N]\\n7\\t    attavo build [N]\\n8\\t    attavo verify [N]\\n9\\t    attavo file-findings [N]\\n10\\t    attavo file-stops [N]\\n11\\t    attavo counsel [N]\\n12\\t    attavo record-only\\n13\\t    attavo attest [--partial] [N]\\n14\\t    attavo drive [N] [--until-ready] [--again] [--report]\\n15\\t    attavo drive --all\\n16\\t    attavo worker N <build|verify> NN\\n17\\t    attavo ledger [N] [--json]\\n18\\t    attavo stops [N] [--json]\\n19\\t    attavo test [N] [--all | <test>...] [--fresh]\\n20\\t\\n21\\tThe doctor is the definition of done. It asserts five proofs against a\\n22\\ttenant root and exits 1 until every proof holds:\\n23\\t\\n24\\t  1. every-gate-rejects      every gate in the manifest's [gates] table,\\n25\\t                             run against its rejection fixture, exits non-zero,\\n26\\t                             and carries a non-empty retires\\n27\\t  2. one-item-every-stage    one work item under paths.records carries a\\n28\\t                             record for every stage -- spec, approval,\\n29\\t                             build, verify -- all four introduced by one\\n30\\t                             merge commit reachable from HEAD\\n31\\t  3. no-commit-lacks-record  every commit on the default branch after the\\n32\\t                             manifest was introduced is named by a record's\\n33\\t                             sha or commits list, or itself writes under\\n34\\t                             paths.records (a record is committed with the\\n35\\t                             code it describes; an item's merge commit\\n36\\t                             carries its own record paths this way)\\n37\\t  4. no-stop-lacks-cause     every build or verify record under\\n38\\t                             paths.records at record_version 3 or later,\\n39\\t                             with a status other than pass, carries a stop\\n40\\t                             naming an enumerated class and provenance, a\\n41\\t                             non-empty detail when unclassed, the gates\\n42\\t                             heading when a build failed after running\\n43\\t                             them, and the tool's own error line when an\\n44\\t                             adapter exit ended the log -- records before\\n45\\t                             record_version 3 are counted and reported,\\n46\\t                             never refused\\n47\\t  5. every-attested-item-is-sealed\\n48\\t                             every merged item that carries a record for\\n49\\t                             every stage has a statement in the forge's\\n50\\t                             attestation store for its merge commit, read\\n51\\t                             through [forge].attestation_command -- a\\n52\\t                             merge at or before [forge].sealed_since is\\n53\\t                             named as before the window instead of failed.\\n54\\t                             [forge].attestation_command exiting 2 means\\n55\\t                             the store itself could not be read, reported\\n56\\t                             as not_read by item and never as unsealed\\n57\\t  6. no-attested-item-is-empty\\n58\\t                             no attested item is empty: every merged,\\n59\\t                             fully-staged item's passing build record\\n60\\t                             names a change, sha not equal to start_sha.\\n61\\t                             [doctor].built_since names a commit at or\\n62\\t                             before which merges are named as before the\\n63\\t                             window instead of failed, so the specimen\\n64\\t                             that motivated this proof stands on the\\n65\\t                             record without failing the tenant forever;\\n66\\t                             absent, the window is proof three's. A build\\n67\\t                             record with no start_sha is counted as not\\n68\\t                             readable, never as failed.\\n69\\t\\n70\\tNothing in doctor is a gate. The doctor reads; it never writes and it never\\n71\\tblocks a merge by itself. It is what CI runs to say whether the product\\n72\\tis done.\\n73\\t\\n74\\tspec-gate, approve, and approval-status are gates and writers. They run\\n75\\tfrom the tenant root (the current working directory); N, the work item id,\\n76\\tis read from the ATTAVO_ITEM environment variable when set, else from the\\n77\\tbranch (attavo/N-*). The doctor's first proof sets ATTAVO_ITEM for a\\n78\\trejection fixture's own item, so a gate's own command needs no argument\\n79\\teven while the enclosing repository sits on a real item's attavo/N-*\\n80\\tbranch. Every run of spec-gate or approve writes the next numbered attempt\\n81\\tfile under paths.records/N/ and never overwrites one already written. See\\n82\\tthe spec contract in the project's Phase 1 issue for the full rules each\\n83\\tone enforces.\\n84\\t\\n85\\tbuild refuses (exit 1, naming the cause, no record) unless the manifest\\n86\\tdeclares [executor].build and [tests].select and [tests].run, and unless\\n87\\tapproval-status would print valid. It exports the executor's identity\\n88\\t(issue #33) into the adapter's environment as GIT_AUTHOR_NAME/EMAIL and\\n89\\tGIT_COMMITTER_NAME/EMAIL, set by the product and never the tenant's git\\n90\\tconfig, then invokes the named adapter (adapters/<name>/run) with the\\n91\\tspec, the corpus, and the branch. It refuses (status refused) a commit\\n92\\tbetween start_sha and HEAD not authored by that identity, checks that\\n93\\tevery path touched matches a spec claim, records the adapter's own\\n94\\tdeclared \\\"reports\\\" -- the fields adapters/<name>/conformance.json says\\n95\\tit can supply with a real value (issue #41), so a field it claims and\\n96\\tnever supplies is a defect the conformance suite catches rather than a\\n97\\tsilent null -- then runs the criteria, the\\n98\\ttests [tests].select and [tests].run name for the touched paths, and --\\n99\\twhen the manifest declares [checks].command -- the tenant's own\\n100\\twhole-tree check, all three run in a detached worktree of HEAD and\\n101\\tnever in the executor's own directory: the gate reads the commit, not\\n102\\tthe tree, so a path written and never committed cannot pass a\\n103\\tcriterion, a test, or a check on the executor's behalf. An iteration\\n104\\tthat ends with HEAD unchanged since start_sha is told, in the feed and\\n105\\tthe log, that the executor committed nothing and that the gate reads\\n106\\tthe commit, and iterates; the last iteration ending that way halts the\\n107\\tbuild instead of failing it, stop class empty, provenance executor,\\n108\\tdetail naming that the executor committed nothing and how many paths\\n109\\tit left modified or untracked. pass requires every criterion,\\n110\\tthe test run, and the tenant's checks (if declared) to exit 0, and HEAD\\n111\\tto have moved since start_sha; any non-zero exit iterates, with the\\n112\\tfailure as feedback, up to a fixed budget. [checks] is optional; a\\n113\\ttenant that declares none is not refused. Before the adapter is invoked\\n114\\tit asks whether this machine can\\n115\\trun the checks -- of [checks].probe, run once inside [checks].probe_timeout_s\\n116\\t(exit 0 yes; anything else, or the bound, an environment refusal), or,\\n117\\tfor a tenant that declares no probe, by running [checks].command whole\\n118\\t(exit 2 no) -- and says both the question and the answer in the feed\\n119\\t(issue #212). The adapter is given ATTAVO_TEST_COMMAND, `attavo test N`,\\n120\\tand ATTAVO_TEST_TIMEOUT_S when [tests].call_timeout_s is declared; it\\n121\\tis not given the tenant's checks. It writes the next build-NN.json under paths.records/N/, with\\n122\\tthe adapter's transcript -- each iteration's gate output (criteria\\n123\\texits, the selected tests' stdout, the tenant's checks' tail) appended\\n124\\tunder an \\\"--- attavo gates, iteration N ---\\\" heading, issue #89 -- beside\\n125\\tit as build-NN.log. Every record whose status is not pass carries stop:\\n126\\t{class, provenance, detail}, derived from the refusal, halted, and log\\n127\\talready on hand (issue #89); a pass record carries stop: null. See the\\n128\\tbuild contract in the project's Phase 2 issue for the full rules it\\n129\\tenforces.\\n130\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"5a752ff7-c430-4cfd-9b9a-21883129b5e6\",\"uuid\":\"2be4d28c-586e-4b7b-a650-247a3d5484c5\",\"timestamp\":\"2026-09-27T20:33:02.585Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/davidbean/Projects/attavo-worktree-237/attavo/cli.py\",\"content\":\"\\\"\\\"\\\"attavo: the command.\\n\\n    attavo doctor [TENANT_ROOT] [--json]\\n    attavo spec-gate [N]\\n    attavo approve [N] --by LOGIN\\n    attavo approval-status [N]\\n    attavo build [N]\\n    attavo verify [N]\\n    attavo file-findings [N]\\n    attavo file-stops [N]\\n    attavo counsel [N]\\n    attavo record-only\\n    attavo attest [--partial] [N]\\n    attavo drive [N] [--until-ready] [--again] [--report]\\n    attavo drive --all\\n    attavo worker N <build|verify> NN\\n    attavo ledger [N] [--json]\\n    attavo stops [N] [--json]\\n    attavo test [N] [--all | <test>...] [--fresh]\\n\\nThe doctor is the definition of done. It asserts five proofs against a\\ntenant root and exits 1 until every proof holds:\\n\\n  1. every-gate-rejects      every gate in the manifest's [gates] table,\\n                             run against its rejection fixture, exits non-zero,\\n                             and carries a non-empty retires\\n  2. one-item-every-stage    one work item under paths.records carries a\\n                             record for every stage -- spec, approval,\\n                             build, verify -- all four introduced by one\\n                             merge commit reachable from HEAD\\n  3. no-commit-lacks-record  every commit on the default branch after the\\n                             manifest was introduced is named by a record's\\n                             sha or commits list, or itself writes under\\n                             paths.records (a record is committed with the\\n                             code it describes; an item's merge commit\\n                             carries its own record paths this way)\\n  4. no-stop-lacks-cause     every build or verify record under\\n                             paths.records at record_version 3 or later,\\n                             with a status other than pass, carries a stop\\n                             naming an enumerated class and provenance, a\\n                             non-empty detail when unclassed, the gates\\n                             heading when a build failed after running\\n                             them, and the tool's own error line when an\\n                             adapter exit ended the log -- records before\\n                             record_version 3 are counted and reported,\\n                             never refused\\n  5. every-attested-item-is-sealed\\n                             every merged item that carries a record for\\n                             every stage has a statement in the forge's\\n                             attestation store for its merge commit, read\\n                             through [forge].attestation_command -- a\\n                             merge at or before [forge].sealed_since is\\n                             named as before the window instead of failed.\\n                             [forge].attestation_command exiting 2 means\\n                             the store itself could not be read, reported\\n                             as not_read by item and never as unsealed\\n  6. no-attested-item-is-empty\\n                             no attested item is empty: every merged,\\n                             fully-staged item's passing build record\\n                             names a change, sha not equal to start_sha.\\n                             [doctor].built_since names a commit at or\\n                             before which merges are named as before the\\n                             window instead of failed, so the specimen\\n                             that motivated this proof stands on the\\n                             record without failing the tenant forever;\\n                             absent, the window is proof three's. A build\\n                             record with no start_sha is counted as not\\n                             readable, never as failed.\\n\\nNothing in doctor is a gate. The doctor reads; it never writes and it never\\nblocks a merge by itself. It is what CI runs to say whether the product\\nis done.\\n\\nspec-gate, approve, and approval-status are gates and writers. They run\\nfrom the tenant root (the current working directory); N, the work item id,\\nis read from the ATTAVO_ITEM environment variable when set, else from the\\nbranch (attavo/N-*). The doctor's first proof sets ATTAVO_ITEM for a\\nrejection fixture's own item, so a gate's own command needs no argument\\neven while the enclosing repository sits on a real item's attavo/N-*\\nbranch. Every run of spec-gate or approve writes the next numbered attempt\\nfile under paths.records/N/ and never overwrites one already written. See\\nthe spec contract in the project's Phase 1 issue for the full rules each\\none enforces.\\n\\nbuild refuses (exit 1, naming the cause, no record) unless the manifest\\ndeclares [executor].build and [tests].select and [tests].run, and unless\\napproval-status would print valid. It exports the executor's identity\\n(issue #33) into the adapter's environment as GIT_AUTHOR_NAME/EMAIL and\\nGIT_COMMITTER_NAME/EMAIL, set by the product and never the tenant's git\\nconfig, then invokes the named adapter (adapters/<name>/run) with the\\nspec, the corpus, and the branch. It refuses (status refused) a commit\\nbetween start_sha and HEAD not authored by that identity, checks that\\nevery path touched matches a spec claim, records the adapter's own\\ndeclared \\\"reports\\\" -- the fields adapters/<name>/conformance.json says\\nit can supply with a real value (issue #41), so a field it claims and\\nnever supplies is a defect the conformance suite catches rather than a\\nsilent null -- then runs the criteria, the\\ntests [tests].select and [tests].run name for the touched paths, and --\\nwhen the manifest declares [checks].command -- the tenant's own\\nwhole-tree check, all three run in a detached worktree of HEAD and\\nnever in the executor's own directory: the gate reads the commit, not\\nthe tree, so a path written and never committed cannot pass a\\ncriterion, a test, or a check on the executor's behalf. An iteration\\nthat ends with HEAD unchanged since start_sha is told, in the feed and\\nthe log, that the executor committed nothing and that the gate reads\\nthe commit, and iterates; the last iteration ending that way halts the\\nbuild instead of failing it, stop class empty, provenance executor,\\ndetail naming that the executor committed nothing and how many paths\\nit left modified or untracked. pass requires every criterion,\\nthe test run, and the tenant's checks (if declared) to exit 0, and HEAD\\nto have moved since start_sha; any non-zero exit iterates, with the\\nfailure as feedback, up to a fixed budget. [checks] is optional; a\\ntenant that declares none is not refused. Before the adapter is invoked\\nit asks whether this machine can\\nrun the checks -- of [checks].probe, run once inside [checks].probe_timeout_s\\n(exit 0 yes; anything else, or the bound, an environment refusal), or,\\nfor a tenant that declares no probe, by running [checks].command whole\\n(exit 2 no) -- and says both the question and the answer in the feed\\n(issue #212). The adapter is given ATTAVO_TEST_COMMAND, `attavo test N`,\\nand ATTAVO_TEST_TIMEOUT_S when [tests].call_timeout_s is declared; it\\nis not given the tenant's checks. It writes the next build-NN.json under paths.records/N/, with\\nthe adapter's transcript -- each iteration's gate output (criteria\\nexits, the selected tests' stdout, the tenant's checks' tail) appended\\nunder an \\\"--- attavo gates, iteration N ---\\\" heading, issue #89 -- beside\\nit as build-NN.log. Every record whose status is not pass carries stop:\\n{class, provenance, detail}, derived from the refusal, halted, and log\\nalready on hand (issue #89); a pass record carries stop: null. See the\\nbuild contract in the project's Phase 2 issue for the full rules it\\nenforces.\\n\",\"numLines\":130,\"startLine\":1,\"totalLines\":417}}}\n+{\"type\":\"assistant\",\"message\":{\"model\":\"claude-sonnet-5\",\"id\":\"msg_011CfUag4F7suXLYuwoTvDnF\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_01HM4GVx393KVHfv7bH27Tmi\",\"name\":\"Bash\",\"input\":{\"command\":\"grep -n \\\"spec-gate\\\\|criteria\\\\|criterion\\\\|stub\\\\|claims\\\" attavo/cli.py | head -40\"},\"caller\":{\"type\":\"direct\"}}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":2821,\"cache_read_input_tokens\":89913,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":2821},\"output_tokens\":2,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"5a752ff7-c430-4cfd-9b9a-21883129b5e6\",\"uuid\":\"b55e634d-8b98-4d83-84dc-63e71495559e\",\"timestamp\":\"2026-09-27T20:33:07.044Z\",\"request_id\":\"req_011CfUag3pKirx7mrJBdEUbH\",\"wire_tool_inputs\":{\"toolu_01HM4GVx393KVHfv7bH27Tmi\":{\"command\":\"cd /Users/davidbean/Projects/attavo-worktree-237 && grep -n \\\"spec-gate\\\\|criteria\\\\|criterion\\\\|stub\\\\|claims\\\" attavo/cli.py | head -40\"}},\"wire_ingest_context\":{\"toolu_01HM4GVx393KVHfv7bH27Tmi\":{\"cwd\":\"/Users/davidbean/Projects/attavo-worktree-237\"}}}\n+{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01HM4GVx393KVHfv7bH27Tmi\",\"type\":\"tool_result\",\"content\":\"4:    attavo spec-gate [N]\\n74:spec-gate, approve, and approval-status are gates and writers. They run\\n80:branch. Every run of spec-gate or approve writes the next numbered attempt\\n95:it can supply with a real value (issue #41), so a field it claims and\\n97:silent null -- then runs the criteria, the\\n103:criterion, a test, or a check on the executor's behalf. An iteration\\n109:it left modified or untracked. pass requires every criterion,\\n122:the adapter's transcript -- each iteration's gate output (criteria\\n193:when neither exists, its latest refused spec-gate record, the earliest\\n198:claims, criteria, stub, including stub/.removed), paths.rulings, the\\n210:written) when the item carries no non-pass build, verify, or spec-gate\\n212:enforces, and issue #133's for the spec-gate fallback.\\n383:    if argv[0] == \\\"spec-gate\\\":\\n413:    print(f\\\"attavo: unknown subcommand {argv[0]!r}; only doctor, spec-gate, approve, \\\"\",\"is_error\":false}]},\"parent_tool_use_id\":null,\"session_id\":\"5a752ff7-c430-4cfd-9b9a-21883129b5e6\",\"uuid\":\"b40edb95-cae9-49db-b8cd-6f6252105eca\",\"timestamp\":\"2026-09-27T20:33:07.162Z\",\"tool_use_result\":{\"stdout\":\"4:    attavo spec-gate [N]\\n74:spec-gate, approve, and approval-status are gates and writers. They run\\n80:branch. Every run of spec-gate or approve writes the next numbered attempt\\n95:it can supply with a real value (issue #41), so a field it claims and\\n97:silent null -- then runs the criteria, the\\n103:criterion, a test, or a check on the executor's behalf. An iteration\\n109:it left modified or untracked. pass requires every criterion,\\n122:the adapter's transcript -- each iteration's gate output (criteria\\n193:when neither exists, its latest refused spec-gate record, the earliest\\n198:claims, criteria, stub, including stub/.removed), paths.rulings, the\\n210:written) when the item carries no non-pass build, verify, or spec-gate\\n212:enforces, and issue #133's for the spec-gate fallback.\\n383:    if argv[0] == \\\"spec-gate\\\":\\n413:    print(f\\\"attavo: unknown subcommand {argv[0]!r}; only doctor, spec-gate, approve, \\\"\",\"stderr\":\"\",\"interrupted\":false,\"isImage\":false,\"noOutputExpected\":false}}\n+{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01E8NEHpC3C2X6CnnBFkRAFd\",\"type\":\"tool_result\",\"content\":\"test [N] runs the tests [tests].select names for every path the item has\\nchanged since it left the default branch (refs/remotes/origin/HEAD),\\ncommitted or not and untracked included, paths.records aside, through\\n[tests].run (mode mapped, the default). test N <test>... runs exactly the\\nnamed tests instead (mode named), so an executor working on one test runs\\none test; test N --all runs the whole suite through [tests].run with\\n\\\"tests\\\" as the one identifier (mode all), the same bound, event, and\\nexclusion as the other two. Naming tests and --all together is refused\\n(exit 2). It prints how many were selected (or that none was, and runs\\nnothing), exits as the run does, and, when [tests].call_timeout_s is\\ndeclared and the run outlasts it, ends the run and everything it started\\nand exits 124. It exits 2 when it cannot name the changes or the selector\\nfails. A run that exits 0 is cached against a fingerprint of the tree\\n(HEAD, the diff against it, and every untracked unignored file's name and\\ncontent hash, together with the mode and the identifiers); asked again on\\nan unchanged tree it says so -- unchanged since the earlier run, not\\nrerun -- without spending a second on it; --fresh reruns anyway. A\\nfailing run is never cached, since the next question after one is always\\nwhether an edit fixed it. [tests].exclude_in_executor names test\\nidentifiers left out, and said so, when ATTAVO_STAGE is set (inside an\\nexecutor); they run outside one and in CI. When ATTAVO_EVENTS is set, one\\nevent of kind test is written per invocation, naming the mode, the count\\nselected, the exit code, and the seconds spent (or that the answer came\\nfrom the cache). It is the one test command an executor is given (issue\\n#212); the product's own transport -- drive, worker, build, verify,\\ncounsel, file-stops -- refuses to run at all when ATTAVO_STAGE is set,\\nsince the transport is the pass's, not the executor's.\\n\\nverify refuses (exit 1) unless the item's latest build record has\\nstatus pass, and unless the manifest declares [forge].checks_command --\\na tenant command, taking a full commit sha on argv, that prints one\\nline per check as \\\"<name> <conclusion>\\\". verify runs it on the build\\nrecord's sha first: any conclusion other than success, neutral, or\\nskipped writes verify-NN.json with status returned and calls no\\nadapter, because a judge is never spent on a tree the forge already\\ncalled red. With the forge green, verify calls the adapter named by\\n[executor].verify (defaulting to [executor].build) with the diff since\\nthe build's approval, the spec, and the build record, and records its\\nfindings and its declared \\\"reports\\\" (issue #41). [executor.<adapter>.<stage>] shadows [executor.<adapter>] for\\nbuild or verify alone; both merge parent then stage before setting\\nATTAVO_ADAPTER_CONFIG, and the record's adapter_config is the merged\\nresult. Like build, every verify record whose status is not pass\\ncarries stop: {class, provenance, detail} (issue #89); a pass record\\ncarries stop: null. file-findings opens one tenant issue per finding in\\nthe item's latest verify record via [forge].file_issue_command, and\\nrefuses (exit 1, nothing filed) a record carrying a finding with no\\nretires. See the verify contract in the project's Phase 2 issue for the\\nfull rules both enforce.\\n\\nfile-stops opens one tenant issue per stop record of the item with no\\nissue filed for it yet, through [forge].file_issue_command, naming the\\nclass, the provenance, the record path, and the log's last twenty\\nlines; a record it has already filed carries a <stage>-NN.filed marker\\nbeside it, holding the filing command's own stdout, so a second run\\nfiles nothing new. Like a build or verify record, this command writes\\nthe marker and leaves it uncommitted -- drive commits it, in the same\\ncommit as the record it names (issue #89). It refuses (exit 1,\\nnothing filed) a stop whose class is unclassed and whose detail is\\nempty -- a stop the product cannot even describe is not filed as if it\\ncould. See issue #89's lane for the full rules it enforces.\\n\\ncounsel reads the item's latest non-pass build or verify record -- or,\\nwhen neither exists, its latest refused spec-gate record, the earliest\\npoint a question can be answered inside the product, before any\\napproval or executor spend (issue #133) -- and asks the tenant's\\n[executor].counsel adapter (defaulting to [executor].verify) a\\nread-only question about it: the record, its log, the spec (problem,\\nclaims, criteria, stub, including stub/.removed), paths.rulings, the\\nitem's diff since approval, the tenant manifest, and this product's own\\nroot (bin/attavo, adapters/, schema/, templates/) by path, under the\\nsame sandbox verify runs under. The adapter answers with class (the\\nstop enumeration, or unclassed), verdict (answer: a ruling text with\\ncitations; patch: a product defect's file, symbol, rejection test, and\\ndiff; person: a one-line question no rule covers), citations\\n(instruction, mechanism, guard, each a path and symbol or a ruling id),\\nand proposal (the ruling text, the patch, or the question). It writes\\nthe next counsel-NN.json under paths.records/N/, with the adapter's\\ntranscript beside it as counsel-NN.log, and commits nothing -- the\\ncaller commits, as with every stage. It refuses (exit 1, nothing\\nwritten) when the item carries no non-pass build, verify, or spec-gate\\nrecord to counsel. See issue #100's lane for the full rules it\\nenforces, and issue #133's for the spec-gate fallback.\\n\\nrecord-only exits 0 when HEAD, against its first parent, touches only\\npaths.records; 1 otherwise; 2 with no manifest. Core logic about a git\\ncheckout, not a forge's shell -- a workflow template's push-and-retrigger\\nguard is one line reading this exit code instead of carrying its own\\ncopy of the check.\\n\\nattest refuses (exit 1) unless the latest spec, approval, build, and\\nverify records for an item all exist and chain: the build's approval_sha\\nnames the latest approval, and the verify's build_sha names that build --\\na re-approval after a build must force a re-run of what changed. With no\\nN given it derives the item from the record paths HEAD's merge commit\\ntouched under paths.records/<N>/, not from a branch name, which a squash\\nmerge discards and which names a forge's convention the product does not\\nknow; more than one item derived is a refusal naming what it found. Zero\\nis not a defect -- not every merge is an item merge -- exit 0, nothing\\nprinted but a line saying so.\\n\\nattest never writes. On a coherent chain it prints the attestation\\nstatement -- validating against schema/attestation.schema.json -- to\\nstdout as JSON and exits 0: the item, its four records and their shas,\\nand the commit the statement was computed at (sha and merge_sha are the\\nsame commit here; on the merge group that commit is the one that lands).\\nThe four stage records already under paths.records are the evidence for\\nthat statement; a forge-specific template signs the printed JSON,\\nunmodified, as the predicate, against the commit that lands, on the merge\\ngroup -- and the signed bundle in the forge's attestation store is the\\nseal over it. attest itself never signs anything and never talks to a\\nsigning service. --partial (issue #67) is for a pull request, where the\\nrecord a complete chain would need is the output of a later stage that is\\nitself waiting on this check: a missing later record is \\\"not yet\\\" (exit\\n0, naming the item and the stages present and absent, no statement\\nprinted) rather than a refusal, while the two chain assertions -- build's\\napproval_sha names the latest approval, verify's build_sha names the\\nlatest build -- still run over whatever records exist. merge_group and a\\npush to main still demand the whole chain. See issue #69's lane for the\\nfull rules it enforces.\\n\\ndrive (reconciler R2) is one short pass: it fast-forwards its working copy\\nto origin's branch (never while a worker holds it), reads the item's\\nreport (attavo.report, issue #206) exactly as --report would, and acts at\\nmost once -- one of the three states that are the product's own move --\\nbefore returning, almost always within seconds. owes-recovery writes the\\ndied or hung record for the one invocation the report named (what\\n--recover used to do, by hand); next-build and next-review start their\\nstage. Starting a stage is the lease: drive writes the invocation marker,\\ncommits it, and pushes that one commit as a plain fast-forward, no merge\\nand no retry -- a rejection that is not a fast-forward, or a ref another\",\"is_error\":false}]},\"parent_tool_use_id\":null,\"session_id\":\"5a752ff7-c430-4cfd-9b9a-21883129b5e6\",\"uuid\":\"8097e823-8b77-4598-b28b-bcc231477176\",\"timestamp\":\"2026-09-27T20:33:10.858Z\",\"tool_use_result\":{\"stdout\":\"test [N] runs the tests [tests].select names for every path the item has\\nchanged since it left the default branch (refs/remotes/origin/HEAD),\\ncommitted or not and untracked included, paths.records aside, through\\n[tests].run (mode mapped, the default). test N <test>... runs exactly the\\nnamed tests instead (mode named), so an executor working on one test runs\\none test; test N --all runs the whole suite through [tests].run with\\n\\\"tests\\\" as the one identifier (mode all), the same bound, event, and\\nexclusion as the other two. Naming tests and --all together is refused\\n(exit 2). It prints how many were selected (or that none was, and runs\\nnothing), exits as the run does, and, when [tests].call_timeout_s is\\ndeclared and the run outlasts it, ends the run and everything it started\\nand exits 124. It exits 2 when it cannot name the changes or the selector\\nfails. A run that exits 0 is cached against a fingerprint of the tree\\n(HEAD, the diff against it, and every untracked unignored file's name and\\ncontent hash, together with the mode and the identifiers); asked again on\\nan unchanged tree it says so -- unchanged since the earlier run, not\\nrerun -- without spending a second on it; --fresh reruns anyway. A\\nfailing run is never cached, since the next question after one is always\\nwhether an edit fixed it. [tests].exclude_in_executor names test\\nidentifiers left out, and said so, when ATTAVO_STAGE is set (inside an\\nexecutor); they run outside one and in CI. When ATTAVO_EVENTS is set, one\\nevent of kind test is written per invocation, naming the mode, the count\\nselected, the exit code, and the seconds spent (or that the answer came\\nfrom the cache). It is the one test command an executor is given (issue\\n#212); the product's own transport -- drive, worker, build, verify,\\ncounsel, file-stops -- refuses to run at all when ATTAVO_STAGE is set,\\nsince the transport is the pass's, not the executor's.\\n\\nverify refuses (exit 1) unless the item's latest build record has\\nstatus pass, and unless the manifest declares [forge].checks_command --\\na tenant command, taking a full commit sha on argv, that prints one\\nline per check as \\\"<name> <conclusion>\\\". verify runs it on the build\\nrecord's sha first: any conclusion other than success, neutral, or\\nskipped writes verify-NN.json with status returned and calls no\\nadapter, because a judge is never spent on a tree the forge already\\ncalled red. With the forge green, verify calls the adapter named by\\n[executor].verify (defaulting to [executor].build) with the diff since\\nthe build's approval, the spec, and the build record, and records its\\nfindings and its declared \\\"reports\\\" (issue #41). [executor.<adapter>.<stage>] shadows [executor.<adapter>] for\\nbuild or verify alone; both merge parent then stage before setting\\nATTAVO_ADAPTER_CONFIG, and the record's adapter_config is the merged\\nresult. Like build, every verify record whose status is not pass\\ncarries stop: {class, provenance, detail} (issue #89); a pass record\\ncarries stop: null. file-findings opens one tenant issue per finding in\\nthe item's latest verify record via [forge].file_issue_command, and\\nrefuses (exit 1, nothing filed) a record carrying a finding with no\\nretires. See the verify contract in the project's Phase 2 issue for the\\nfull rules both enforce.\\n\\nfile-stops opens one tenant issue per stop record of the item with no\\nissue filed for it yet, through [forge].file_issue_command, naming the\\nclass, the provenance, the record path, and the log's last twenty\\nlines; a record it has already filed carries a <stage>-NN.filed marker\\nbeside it, holding the filing command's own stdout, so a second run\\nfiles nothing new. Like a build or verify record, this command writes\\nthe marker and leaves it uncommitted -- drive commits it, in the same\\ncommit as the record it names (issue #89). It refuses (exit 1,\\nnothing filed) a stop whose class is unclassed and whose detail is\\nempty -- a stop the product cannot even describe is not filed as if it\\ncould. See issue #89's lane for the full rules it enforces.\\n\\ncounsel reads the item's latest non-pass build or verify record -- or,\\nwhen neither exists, its latest refused spec-gate record, the earliest\\npoint a question can be answered inside the product, before any\\napproval or executor spend (issue #133) -- and asks the tenant's\\n[executor].counsel adapter (defaulting to [executor].verify) a\\nread-only question about it: the record, its log, the spec (problem,\\nclaims, criteria, stub, including stub/.removed), paths.rulings, the\\nitem's diff since approval, the tenant manifest, and this product's own\\nroot (bin/attavo, adapters/, schema/, templates/) by path, under the\\nsame sandbox verify runs under. The adapter answers with class (the\\nstop enumeration, or unclassed), verdict (answer: a ruling text with\\ncitations; patch: a product defect's file, symbol, rejection test, and\\ndiff; person: a one-line question no rule covers), citations\\n(instruction, mechanism, guard, each a path and symbol or a ruling id),\\nand proposal (the ruling text, the patch, or the question). It writes\\nthe next counsel-NN.json under paths.records/N/, with the adapter's\\ntranscript beside it as counsel-NN.log, and commits nothing -- the\\ncaller commits, as with every stage. It refuses (exit 1, nothing\\nwritten) when the item carries no non-pass build, verify, or spec-gate\\nrecord to counsel. See issue #100's lane for the full rules it\\nenforces, and issue #133's for the spec-gate fallback.\\n\\nrecord-only exits 0 when HEAD, against its first parent, touches only\\npaths.records; 1 otherwise; 2 with no manifest. Core logic about a git\\ncheckout, not a forge's shell -- a workflow template's push-and-retrigger\\nguard is one line reading this exit code instead of carrying its own\\ncopy of the check.\\n\\nattest refuses (exit 1) unless the latest spec, approval, build, and\\nverify records for an item all exist and chain: the build's approval_sha\\nnames the latest approval, and the verify's build_sha names that build --\\na re-approval after a build must force a re-run of what changed. With no\\nN given it derives the item from the record paths HEAD's merge commit\\ntouched under paths.records/<N>/, not from a branch name, which a squash\\nmerge discards and which names a forge's convention the product does not\\nknow; more than one item derived is a refusal naming what it found. Zero\\nis not a defect -- not every merge is an item merge -- exit 0, nothing\\nprinted but a line saying so.\\n\\nattest never writes. On a coherent chain it prints the attestation\\nstatement -- validating against schema/attestation.schema.json -- to\\nstdout as JSON and exits 0: the item, its four records and their shas,\\nand the commit the statement was computed at (sha and merge_sha are the\\nsame commit here; on the merge group that commit is the one that lands).\\nThe four stage records already under paths.records are the evidence for\\nthat statement; a forge-specific template signs the printed JSON,\\nunmodified, as the predicate, against the commit that lands, on the merge\\ngroup -- and the signed bundle in the forge's attestation store is the\\nseal over it. attest itself never signs anything and never talks to a\\nsigning service. --partial (issue #67) is for a pull request, where the\\nrecord a complete chain would need is the output of a later stage that is\\nitself waiting on this check: a missing later record is \\\"not yet\\\" (exit\\n0, naming the item and the stages present and absent, no statement\\nprinted) rather than a refusal, while the two chain assertions -- build's\\napproval_sha names the latest approval, verify's build_sha names the\\nlatest build -- still run over whatever records exist. merge_group and a\\npush to main still demand the whole chain. See issue #69's lane for the\\nfull rules it enforces.\\n\\ndrive (reconciler R2) is one short pass: it fast-forwards its working copy\\nto origin's branch (never while a worker holds it), reads the item's\\nreport (attavo.report, issue #206) exactly as --report would, and acts at\\nmost once -- one of the three states that are the product's own move --\\nbefore returning, almost always within seconds. owes-recovery writes the\\ndied or hung record for the one invocation the report named (what\\n--recover used to do, by hand); next-build and next-review start their\\nstage. Starting a stage is the lease: drive writes the invocation marker,\\ncommits it, and pushes that one commit as a plain fast-forward, no merge\\nand no retry -- a rejection that is not a fast-forward, or a ref another\",\"stderr\":\"\",\"interrupted\":false,\"isImage\":false,\"noOutputExpected\":false}}\n+{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01K8VyQ2mDGvisSwbDcZ7dzZ\",\"type\":\"tool_result\",\"content\":\"74\\tspec-gate, approve, and approval-status are gates and writers. They run\\n75\\tfrom the tenant root (the current working directory); N, the work item id,\\n76\\tis read from the ATTAVO_ITEM environment variable when set, else from the\\n77\\tbranch (attavo/N-*). The doctor's first proof sets ATTAVO_ITEM for a\\n78\\trejection fixture's own item, so a gate's own command needs no argument\\n79\\teven while the enclosing repository sits on a real item's attavo/N-*\\n80\\tbranch. Every run of spec-gate or approve writes the next numbered attempt\\n81\\tfile under paths.records/N/ and never overwrites one already written. See\\n82\\tthe spec contract in the project's Phase 1 issue for the full rules each\\n83\\tone enforces.\"}]},\"parent_tool_use_id\":null,\"session_id\":\"5a752ff7-c430-4cfd-9b9a-21883129b5e6\",\"uuid\":\"f78cf2ea-ae35-44a1-8481-4141606804c0\",\"timestamp\":\"2026-09-27T20:33:19.948Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/davidbean/Projects/attavo-worktree-237/attavo/cli.py\",\"content\":\"spec-gate, approve, and approval-status are gates and writers. They run\\nfrom the tenant root (the current working directory); N, the work item id,\\nis read from the ATTAVO_ITEM environment variable when set, else from the\\nbranch (attavo/N-*). The doctor's first proof sets ATTAVO_ITEM for a\\nrejection fixture's own item, so a gate's own command needs no argument\\neven while the enclosing repository sits on a real item's attavo/N-*\\nbranch. Every run of spec-gate or approve writes the next numbered attempt\\nfile under paths.records/N/ and never overwrites one already written. See\\nthe spec contract in the project's Phase 1 issue for the full rules each\\none enforces.\",\"numLines\":10,\"startLine\":74,\"totalLines\":417}}}\n+{\"type\":\"assistant\",\"message\":{\"model\":\"claude-sonnet-5\",\"id\":\"msg_011CfUahLWgxPyyo1QiGSzT3\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_01Ed2J1MM2KdKkU5WdfG2B6z\",\"name\":\"Edit\",\"input\":{\"replace_all\":false,\"file_path\":\"/Users/davidbean/Projects/attavo-worktree-237/attavo/cli.py\",\"old_string\":\"branch. Every run of spec-gate or approve writes the next numbered attempt\\nfile under paths.records/N/ and never overwrites one already written. See\\nthe spec contract in the project's Phase 1 issue for the full rules each\\none enforces.\",\"new_string\":\"branch. Every run of spec-gate or approve writes the next numbered attempt\\nfile under paths.records/N/ and never overwrites one already written. A\\nfix item's spec names the root-cause bucket its change closes as one line\\nin the problem, \\\"Bucket: <slug>\\\"; spec-gate refuses a bucket the tenant's\\nbuckets.md (beside paths.specs) does not list, or any bucket when that\\nfile does not exist, before any criterion runs -- a spec with no bucket\\nline is not asked for one. See the spec contract in the project's Phase 1\\nissue for the full rules each one enforces.\"},\"caller\":{\"type\":\"direct\"}}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":881,\"cache_read_input_tokens\":96413,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":881},\"output_tokens\":2,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"5a752ff7-c430-4cfd-9b9a-21883129b5e6\",\"uuid\":\"5a548fcd-70b8-4d93-badb-e8f7adfcadb3\",\"timestamp\":\"2026-09-27T20:33:30.038Z\",\"request_id\":\"req_011CfUahL6PRPU3V2aoWZcd6\",\"wire_tool_inputs\":{\"toolu_01Ed2J1MM2KdKkU5WdfG2B6z\":{\"file_path\":\"/Users/davidbean/Projects/attavo-worktree-237/attavo/cli.py\",\"old_string\":\"branch. Every run of spec-gate or approve writes the next numbered attempt\\nfile under paths.records/N/ and never overwrites one already written. See\\nthe spec contract in the project's Phase 1 issue for the full rules each\\none enforces.\",\"new_string\":\"branch. Every run of spec-gate or approve writes the next numbered attempt\\nfile under paths.records/N/ and never overwrites one already written. A\\nfix item's spec names the root-cause bucket its change closes as one line\\nin the problem, \\\"Bucket: <slug>\\\"; spec-gate refuses a bucket the tenant's\\nbuckets.md (beside paths.specs) does not list, or any bucket when that\\nfile does not exist, before any criterion runs -- a spec with no bucket\\nline is not asked for one. See the spec contract in the project's Phase 1\\nissue for the full rules each one enforces.\"}}}\n+{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01Ed2J1MM2KdKkU5WdfG2B6z\",\"type\":\"tool_result\",\"content\":\"The file /Users/davidbean/Projects/attavo-worktree-237/attavo/cli.py has been updated successfully.\"}]},\"parent_tool_use_id\":null,\"session_id\":\"5a752ff7-c430-4cfd-9b9a-21883129b5e6\",\"uuid\":\"b38ef2a9-3e80-489a-93d9-953468620a32\",\"timestamp\":\"2026-09-27T20:33:30.118Z\",\"tool_use_result\":{\"filePath\":\"/Users/davidbean/Projects/attavo-worktree-237/attavo/cli.py\",\"oldString\":\"branch. Every run of spec-gate or approve writes the next numbered attempt\\nfile under paths.records/N/ and never overwrites one already written. See\\nthe spec contract in the project's Phase 1 issue for the full rules each\\none enforces.\",\"newString\":\"branch. Every run of spec-gate or approve writes the next numbered attempt\\nfile under paths.records/N/ and never overwrites one already written. A\\nfix item's spec names the root-cause bucket its change closes as one line\\nin the problem, \\\"Bucket: <slug>\\\"; spec-gate refuses a bucket the tenant's\\nbuckets.md (beside paths.specs) does not list, or any bucket when that\\nfile does not exist, before any criterion runs -- a spec with no bucket\\nline is not asked for one. See the spec contract in the project's Phase 1\\nissue for the full rules each one enforces.\",\"originalFile\":\"\\\"\\\"\\\"attavo: the command.\\n\\n    attavo doctor [TENANT_ROOT] [--json]\\n    attavo spec-gate [N]\\n    attavo approve [N] --by LOGIN\\n    attavo approval-status [N]\\n    attavo build [N]\\n    attavo verify [N]\\n    attavo file-findings [N]\\n    attavo file-stops [N]\\n    attavo counsel [N]\\n    attavo record-only\\n    attavo attest [--partial] [N]\\n    attavo drive [N] [--until-ready] [--again] [--report]\\n    attavo drive --all\\n    attavo worker N <build|verify> NN\\n    attavo ledger [N] [--json]\\n    attavo stops [N] [--json]\\n    attavo test [N] [--all | <test>...] [--fresh]\\n\\nThe doctor is the definition of done. It asserts five proofs against a\\ntenant root and exits 1 until every proof holds:\\n\\n  1. every-gate-rejects      every gate in the manifest's [gates] table,\\n                             run against its rejection fixture, exits non-zero,\\n                             and carries a non-empty retires\\n  2. one-item-every-stage    one work item under paths.records carries a\\n                             record for every stage -- spec, approval,\\n                             build, verify -- all four introduced by one\\n                             merge commit reachable from HEAD\\n  3. no-commit-lacks-record  every commit on the default branch after the\\n                             manifest was introduced is named by a record's\\n                             sha or commits list, or itself writes under\\n                             paths.records (a record is committed with the\\n                             code it describes; an item's merge commit\\n                             carries its own record paths this way)\\n  4. no-stop-lacks-cause     every build or verify record under\\n                             paths.records at record_version 3 or later,\\n                             with a status other than pass, carries a stop\\n                             naming an enumerated class and provenance, a\\n                             non-empty detail when unclassed, the gates\\n                             heading when a build failed after running\\n                             them, and the tool's own error line when an\\n                             adapter exit ended the log -- records before\\n                             record_version 3 are counted and reported,\\n                             never refused\\n  5. every-attested-item-is-sealed\\n                             every merged item that carries a record for\\n                             every stage has a statement in the forge's\\n                             attestation store for its merge commit, read\\n                             through [forge].attestation_command -- a\\n                             merge at or before [forge].sealed_since is\\n                             named as before the window instead of failed.\\n                             [forge].attestation_command exiting 2 means\\n                             the store itself could not be read, reported\\n                             as not_read by item and never as unsealed\\n  6. no-attested-item-is-empty\\n                             no attested item is empty: every merged,\\n                             fully-staged item's passing build record\\n                             names a change, sha not equal to start_sha.\\n                             [doctor].built_since names a commit at or\\n                             before which merges are named as before the\\n                             window instead of failed, so the specimen\\n                             that motivated this proof stands on the\\n                             record without failing the tenant forever;\\n                             absent, the window is proof three's. A build\\n                             record with no start_sha is counted as not\\n                             readable, never as failed.\\n\\nNothing in doctor is a gate. The doctor reads; it never writes and it never\\nblocks a merge by itself. It is what CI runs to say whether the product\\nis done.\\n\\nspec-gate, approve, and approval-status are gates and writers. They run\\nfrom the tenant root (the current working directory); N, the work item id,\\nis read from the ATTAVO_ITEM environment variable when set, else from the\\nbranch (attavo/N-*). The doctor's first proof sets ATTAVO_ITEM for a\\nrejection fixture's own item, so a gate's own command needs no argument\\neven while the enclosing repository sits on a real item's attavo/N-*\\nbranch. Every run of spec-gate or approve writes the next numbered attempt\\nfile under paths.records/N/ and never overwrites one already written. See\\nthe spec contract in the project's Phase 1 issue for the full rules each\\none enforces.\\n\\nbuild refuses (exit 1, naming the cause, no record) unless the manifest\\ndeclares [executor].build and [tests].select and [tests].run, and unless\\napproval-status would print valid. It exports the executor's identity\\n(issue #33) into the adapter's environment as GIT_AUTHOR_NAME/EMAIL and\\nGIT_COMMITTER_NAME/EMAIL, set by the product and never the tenant's git\\nconfig, then invokes the named adapter (adapters/<name>/run) with the\\nspec, the corpus, and the branch. It refuses (status refused) a commit\\nbetween start_sha and HEAD not authored by that identity, checks that\\nevery path touched matches a spec claim, records the adapter's own\\ndeclared \\\"reports\\\" -- the fields adapters/<name>/conformance.json says\\nit can supply with a real value (issue #41), so a field it claims and\\nnever supplies is a defect the conformance suite catches rather than a\\nsilent null -- then runs the criteria, the\\ntests [tests].select and [tests].run name for the touched paths, and --\\nwhen the manifest declares [checks].command -- the tenant's own\\nwhole-tree check, all three run in a detached worktree of HEAD and\\nnever in the executor's own directory: the gate reads the commit, not\\nthe tree, so a path written and never committed cannot pass a\\ncriterion, a test, or a check on the executor's behalf. An iteration\\nthat ends with HEAD unchanged since start_sha is told, in the feed and\\nthe log, that the executor committed nothing and that the gate reads\\nthe commit, and iterates; the last iteration ending that way halts the\\nbuild instead of failing it, stop class empty, provenance executor,\\ndetail naming that the executor committed nothing and how many paths\\nit left modified or untracked. pass requires every criterion,\\nthe test run, and the tenant's checks (if declared) to exit 0, and HEAD\\nto have moved since start_sha; any non-zero exit iterates, with the\\nfailure as feedback, up to a fixed budget. [checks] is optional; a\\ntenant that declares none is not refused. Before the adapter is invoked\\nit asks whether this machine can\\nrun the checks -- of [checks].probe, run once inside [checks].probe_timeout_s\\n(exit 0 yes; anything else, or the bound, an environment refusal), or,\\nfor a tenant that declares no probe, by running [checks].command whole\\n(exit 2 no) -- and says both the question and the answer in the feed\\n(issue #212). The adapter is given ATTAVO_TEST_COMMAND, `attavo test N`,\\nand ATTAVO_TEST_TIMEOUT_S when [tests].call_timeout_s is declared; it\\nis not given the tenant's checks. It writes the next build-NN.json under paths.records/N/, with\\nthe adapter's transcript -- each iteration's gate output (criteria\\nexits, the selected tests' stdout, the tenant's checks' tail) appended\\nunder an \\\"--- attavo gates, iteration N ---\\\" heading, issue #89 -- beside\\nit as build-NN.log. Every record whose status is not pass carries stop:\\n{class, provenance, detail}, derived from the refusal, halted, and log\\nalready on hand (issue #89); a pass record carries stop: null. See the\\nbuild contract in the project's Phase 2 issue for the full rules it\\nenforces.\\n\\ntest [N] runs the tests [tests].select names for every path the item has\\nchanged since it left the default branch (refs/remotes/origin/HEAD),\\ncommitted or not and untracked included, paths.records aside, through\\n[tests].run (mode mapped, the default). test N <test>... runs exactly the\\nnamed tests instead (mode named), so an executor working on one test runs\\none test; test N --all runs the whole suite through [tests].run with\\n\\\"tests\\\" as the one identifier (mode all), the same bound, event, and\\nexclusion as the other two. Naming tests and --all together is refused\\n(exit 2). It prints how many were selected (or that none was, and runs\\nnothing), exits as the run does, and, when [tests].call_timeout_s is\\ndeclared and the run outlasts it, ends the run and everything it started\\nand exits 124. It exits 2 when it cannot name the changes or the selector\\nfails. A run that exits 0 is cached against a fingerprint of the tree\\n(HEAD, the diff against it, and every untracked unignored file's name and\\ncontent hash, together with the mode and the identifiers); asked again on\\nan unchanged tree it says so -- unchanged since the earlier run, not\\nrerun -- without spending a second on it; --fresh reruns anyway. A\\nfailing run is never cached, since the next question after one is always\\nwhether an edit fixed it. [tests].exclude_in_executor names test\\nidentifiers left out, and said so, when ATTAVO_STAGE is set (inside an\\nexecutor); they run outside one and in CI. When ATTAVO_EVENTS is set, one\\nevent of kind test is written per invocation, naming the mode, the count\\nselected, the exit code, and the seconds spent (or that the answer came\\nfrom the cache). It is the one test command an executor is given (issue\\n#212); the product's own transport -- drive, worker, build, verify,\\ncounsel, file-stops -- refuses to run at all when ATTAVO_STAGE is set,\\nsince the transport is the pass's, not the executor's.\\n\\nverify refuses (exit 1) unless the item's latest build record has\\nstatus pass, and unless the manifest declares [forge].checks_command --\\na tenant command, taking a full commit sha on argv, that prints one\\nline per check as \\\"<name> <conclusion>\\\". verify runs it on the build\\nrecord's sha first: any conclusion other than success, neutral, or\\nskipped writes verify-NN.json with status returned and calls no\\nadapter, because a judge is never spent on a tree the forge already\\ncalled red. With the forge green, verify calls the adapter named by\\n[executor].verify (defaulting to [executor].build) with the diff since\\nthe build's approval, the spec, and the build record, and records its\\nfindings and its declared \\\"reports\\\" (issue #41). [executor.<adapter>.<stage>] shadows [executor.<adapter>] for\\nbuild or verify alone; both merge parent then stage before setting\\nATTAVO_ADAPTER_CONFIG, and the record's adapter_config is the merged\\nresult. Like build, every verify record whose status is not pass\\ncarries stop: {class, provenance, detail} (issue #89); a pass record\\ncarries stop: null. file-findings opens one tenant issue per finding in\\nthe item's latest verify record via [forge].file_issue_command, and\\nrefuses (exit 1, nothing filed) a record carrying a finding with no\\nretires. See the verify contract in the project's Phase 2 issue for the\\nfull rules both enforce.\\n\\nfile-stops opens one tenant issue per stop record of the item with no\\nissue filed for it yet, through [forge].file_issue_command, naming the\\nclass, the provenance, the record path, and the log's last twenty\\nlines; a record it has already filed carries a <stage>-NN.filed marker\\nbeside it, holding the filing command's own stdout, so a second run\\nfiles nothing new. Like a build or verify record, this command writes\\nthe marker and leaves it uncommitted -- drive commits it, in the same\\ncommit as the record it names (issue #89). It refuses (exit 1,\\nnothing filed) a stop whose class is unclassed and whose detail is\\nempty -- a stop the product cannot even describe is not filed as if it\\ncould. See issue #89's lane for the full rules it enforces.\\n\\ncounsel reads the item's latest non-pass build or verify record -- or,\\nwhen neither exists, its latest refused spec-gate record, the earliest\\npoint a question can be answered inside the product, before any\\napproval or executor spend (issue #133) -- and asks the tenant's\\n[executor].counsel adapter (defaulting to [executor].verify) a\\nread-only question about it: the record, its log, the spec (problem,\\nclaims, criteria, stub, including stub/.removed), paths.rulings, the\\nitem's diff since approval, the tenant manifest, and this product's own\\nroot (bin/attavo, adapters/, schema/, templates/) by path, under the\\nsame sandbox verify runs under. The adapter answers with class (the\\nstop enumeration, or unclassed), verdict (answer: a ruling text with\\ncitations; patch: a product defect's file, symbol, rejection test, and\\ndiff; person: a one-line question no rule covers), citations\\n(instruction, mechanism, guard, each a path and symbol or a ruling id),\\nand proposal (the ruling text, the patch, or the question). It writes\\nthe next counsel-NN.json under paths.records/N/, with the adapter's\\ntranscript beside it as counsel-NN.log, and commits nothing -- the\\ncaller commits, as with every stage. It refuses (exit 1, nothing\\nwritten) when the item carries no non-pass build, verify, or spec-gate\\nrecord to counsel. See issue #100's lane for the full rules it\\nenforces, and issue #133's for the spec-gate fallback.\\n\\nrecord-only exits 0 when HEAD, against its first parent, touches only\\npaths.records; 1 otherwise; 2 with no manifest. Core logic about a git\\ncheckout, not a forge's shell -- a workflow template's push-and-retrigger\\nguard is one line reading this exit code instead of carrying its own\\ncopy of the check.\\n\\nattest refuses (exit 1) unless the latest spec, approval, build, and\\nverify records for an item all exist and chain: the build's approval_sha\\nnames the latest approval, and the verify's build_sha names that build --\\na re-approval after a build must force a re-run of what changed. With no\\nN given it derives the item from the record paths HEAD's merge commit\\ntouched under paths.records/<N>/, not from a branch name, which a squash\\nmerge discards and which names a forge's convention the product does not\\nknow; more than one item derived is a refusal naming what it found. Zero\\nis not a defect -- not every merge is an item merge -- exit 0, nothing\\nprinted but a line saying so.\\n\\nattest never writes. On a coherent chain it prints the attestation\\nstatement -- validating against schema/attestation.schema.json -- to\\nstdout as JSON and exits 0: the item, its four records and their shas,\\nand the commit the statement was computed at (sha and merge_sha are the\\nsame commit here; on the merge group that commit is the one that lands).\\nThe four stage records already under paths.records are the evidence for\\nthat statement; a forge-specific template signs the printed JSON,\\nunmodified, as the predicate, against the commit that lands, on the merge\\ngroup -- and the signed bundle in the forge's attestation store is the\\nseal over it. attest itself never signs anything and never talks to a\\nsigning service. --partial (issue #67) is for a pull request, where the\\nrecord a complete chain would need is the output of a later stage that is\\nitself waiting on this check: a missing later record is \\\"not yet\\\" (exit\\n0, naming the item and the stages present and absent, no statement\\nprinted) rather than a refusal, while the two chain assertions -- build's\\napproval_sha names the latest approval, verify's build_sha names the\\nlatest build -- still run over whatever records exist. merge_group and a\\npush to main still demand the whole chain. See issue #69's lane for the\\nfull rules it enforces.\\n\\ndrive (reconciler R2) is one short pass: it fast-forwards its working copy\\nto origin's branch (never while a worker holds it), reads the item's\\nreport (attavo.report, issue #206) exactly as --report would, and acts at\\nmost once -- one of the three states that are the product's own move --\\nbefore returning, almost always within seconds. owes-recovery writes the\\ndied or hung record for the one invocation the report named (what\\n--recover used to do, by hand); next-build and next-review start their\\nstage. Starting a stage is the lease: drive writes the invocation marker,\\ncommits it, and pushes that one commit as a plain fast-forward, no merge\\nand no retry -- a rejection that is not a fast-forward, or a ref another\\npush already holds, means another pass started this attempt first, and\\nthis one says so, resets its own marker commit, and starts nothing; a\\npush the remote refuses outright is exit 1 and starts nothing either way.\\nOn a pushed marker drive spawns `attavo worker N <build|verify> NN` in\\nits own session, its stdout and stderr appended to\\n<git-dir>/attavo/<stage>-NN.worker.log, and returns -- the worker\\noutlives the pass. Every other level is printed in the report's own\\nwords and left alone, exit 0; exit 1 is a refusal. See issue #217's lane\\n(the reconciler's R2) for the full rules it enforces.\\n\\nworker N <build|verify> NN is the stage itself, run in the detached child\\na pass just started: build or verify in-process, exactly as the pass used\\nto run it inline before R2, touching\\n<git-dir>/attavo/<stage>-NN.heartbeat every ATTAVO_HEARTBEAT_S seconds\\n(15) while it runs -- what a report or a pass reads first to tell a\\nrunning invocation from a died one, falling back to the pid only when\\nthere is no heartbeat file at all. A record the stage writes that is not\\npass is counseled (counsel, issue #100) and filed (file-stops, issue #89)\\nbefore it is transported, so its .filed marker exists in time to be\\ncommitted alongside it; the worker then commits the stage record and the\\ncounsel record together -- each with its own log and marker -- with\\n`git commit --only`, never sweeping the index, and pushes, with the\\nrecord push's own retry: a push a divergent remote rejects is retried\\nonce after `git pull --no-rebase --no-edit`, never a rebase, since the\\nrecord already names the commit's sha. On a review, ATTAVO_FORGE_CHECKS\\nnames the file the pass already wrote the forge's own read into (the\\nchecks it saw on the head before its marker, reconciler ruling B); verify\\nreads that file instead of polling when it is set.\\n\\n--until-ready repeats the pass in this same process, sleeping\\nATTAVO_DRIVE_POLL_INTERVAL_S between passes, until the level is the\\noperator's or done (exit 0), a concluded check reads red (exit 1), or an\\nunconcluded one has not concluded within ATTAVO_DRIVE_POLL_BOUND_S (exit\\n1) -- a stage running in its own worker is not bounded by either\\nconstant, only time spent waiting on the forge is. Without the flag,\\ndrive is one pass, then stop.\\n\\n--again starts the next attempt of a stopped stage -- the operator's own\\nresume, until a later reconciler ruling drives a retry itself. --recover\\nis gone: `attavo drive --recover` now exits 2 saying so; recovery is\\nwhat a pass does on its own, the moment the report owes one.\\n\\n--all runs one pass, in its own process, in every ../attavo-worktree-N\\nbeside this checkout -- each line either prints is prefixed with the\\nworktree's own directory name.\\n\\n--report prints, as JSON against schema/drive-report.schema.json, what\\nitem N is waiting on: its state, whose move it is (yours, waits, acts,\\ndone), and one sentence in the operator's words. It reads exactly what a\\npass reads -- the item's records, its invocation markers and heartbeats,\\none read of the forge -- and does nothing else: it writes no record,\\nstarts nothing, terminates nothing, and does not poll, so a concluded\\nred check reads as blocked-on-checks for as long as it is red. It exits\\n0 on every state. See issue #206's lane for the states.\\n\\nledger reads, never writes. For item N (or every item under\\npaths.records when N is omitted), it walks the commits from the item's\\nfirst spec commit to its merge (the same derivation doctor's proof two\\nand attest use) or to HEAD when the item has not merged, and prints one\\nrow per act: the sha, the identity as git names it, and a class from a\\nclosed list -- spec, amend, approve, launch, record, change, transport,\\nmerge -- derived from who committed it and, for an approval, build, or\\nverify record, what the record itself says. A summary line follows:\\noperator acts (approve, amend, launch, transport, merge), product acts\\n(record), executor commits (change), stops (non-pass records), and\\nsince (the product version on the first record). A build or verify\\nrecord's own commit, from before v0.18.0 gave the driver and the\\nexecutor their own identities, prints as record-or-launch with a note,\\ncounted toward neither total, rather than guessed. --json prints the\\nrows and the summary as one object. See issue #128's lane for the full\\nrules it enforces.\\n\\nstops reads, never writes. For item N (or every item under\\npaths.records when N is omitted), one row per non-pass build or verify\\nrecord: the record, its stop's class, provenance, and detail, and the\\nanswerer -- \\\"counsel:<verdict>\\\" when a counsel record read this exact\\nstop, else \\\"person\\\" for a question, else \\\"guard\\\" for a class a guard\\nalone raised (GUARDED_STOP_CLASSES), else \\\"none\\\". A record too old to\\ncarry stop at all prints the doctor's own phrase for it, \\\"before stop\\nwas recorded\\\", and is counted there rather than by class. Totals per\\nclass (read from the build record schema's own enum, never retyped) and\\nper answerer, plus the before-stop count, follow the rows. --json prints\\nthe rows and the totals as one object. See issue #129's lane for the\\nfull rules it enforces.\\n\\\"\\\"\\\"\\n\\nfrom __future__ import annotations\\n\\nimport os\\nimport sys\\n\\nfrom attavo.approval import cmd_approval_status, cmd_approve\\nfrom attavo.attest import cmd_attest\\nfrom attavo.build import cmd_build\\nfrom attavo.counsel import cmd_counsel\\nfrom attavo.doctor import cmd_doctor\\nfrom attavo.drive import cmd_drive, cmd_worker\\nfrom attavo.filing import cmd_file_findings, cmd_file_stops\\nfrom attavo.ledger import cmd_ledger\\nfrom attavo.record_only import cmd_record_only\\nfrom attavo.spec import cmd_spec_gate\\nfrom attavo.stops import cmd_stops\\nfrom attavo.testtool import cmd_test\\nfrom attavo.verify import cmd_verify\\n\\n\\nTRANSPORT = (\\\"drive\\\", \\\"worker\\\", \\\"build\\\", \\\"verify\\\", \\\"counsel\\\", \\\"file-stops\\\")\\n\\n\\ndef main(argv: list[str]) -> int:\\n    if not argv or argv[0] in (\\\"-h\\\", \\\"--help\\\"):\\n        print(__doc__.strip())\\n        return 0 if argv else 2\\n    if argv[0] in TRANSPORT and os.environ.get(\\\"ATTAVO_STAGE\\\"):\\n        # The product's transport is never the executor's tool: a stage\\n        # runs inside an invocation whose environment names the stage,\\n        # and nothing under it may start, judge, or record another.\\n        print(f\\\"attavo {argv[0]}: refused inside an executor (ATTAVO_STAGE is set); \\\"\\n              f\\\"the transport is the pass's, not the executor's\\\", file=sys.stderr)\\n        return 2\\n    if argv[0] == \\\"doctor\\\":\\n        return cmd_doctor(argv[1:])\\n    if argv[0] == \\\"spec-gate\\\":\\n        return cmd_spec_gate(argv[1:])\\n    if argv[0] == \\\"approve\\\":\\n        return cmd_approve(argv[1:])\\n    if argv[0] == \\\"approval-status\\\":\\n        return cmd_approval_status(argv[1:])\\n    if argv[0] == \\\"build\\\":\\n        return cmd_build(argv[1:])\\n    if argv[0] == \\\"verify\\\":\\n        return cmd_verify(argv[1:])\\n    if argv[0] == \\\"file-findings\\\":\\n        return cmd_file_findings(argv[1:])\\n    if argv[0] == \\\"file-stops\\\":\\n        return cmd_file_stops(argv[1:])\\n    if argv[0] == \\\"counsel\\\":\\n        return cmd_counsel(argv[1:])\\n    if argv[0] == \\\"record-only\\\":\\n        return cmd_record_only(argv[1:])\\n    if argv[0] == \\\"attest\\\":\\n        return cmd_attest(argv[1:])\\n    if argv[0] == \\\"drive\\\":\\n        return cmd_drive(argv[1:])\\n    if argv[0] == \\\"worker\\\":\\n        return cmd_worker(argv[1:])\\n    if argv[0] == \\\"ledger\\\":\\n        return cmd_ledger(argv[1:])\\n    if argv[0] == \\\"stops\\\":\\n        return cmd_stops(argv[1:])\\n    if argv[0] == \\\"test\\\":\\n        return cmd_test(argv[1:])\\n    print(f\\\"attavo: unknown subcommand {argv[0]!r}; only doctor, spec-gate, approve, \\\"\\n          f\\\"approval-status, build, verify, file-findings, file-stops, counsel, record-only, \\\"\\n          f\\\"attest, drive, worker, ledger, stops, test exist at this commit\\\", file=sys.stderr)\\n    return 2\\n\",\"structuredPatch\":[{\"oldStart\":78,\"oldLines\":9,\"newStart\":78,\"newLines\":13,\"lines\":[\" rejection fixture's own item, so a gate's own command needs no argument\",\" even while the enclosing repository sits on a real item's attavo/N-*\",\" branch. Every run of spec-gate or approve writes the next numbered attempt\",\"-file under paths.records/N/ and never overwrites one already written. See\",\"-the spec contract in the project's Phase 1 issue for the full rules each\",\"-one enforces.\",\"+file under paths.records/N/ and never overwrites one already written. A\",\"+fix item's spec names the root-cause bucket its change closes as one line\",\"+in the problem, \\\"Bucket: <slug>\\\"; spec-gate refuses a bucket the tenant's\",\"+buckets.md (beside paths.specs) does not list, or any bucket when that\",\"+file does not exist, before any criterion runs -- a spec with no bucket\",\"+line is not asked for one. See the spec contract in the project's Phase 1\",\"+issue for the full rules each one enforces.\",\" \",\" build refuses (exit 1, naming the cause, no record) unless the manifest\",\" declares [executor].build and [tests].select and [tests].run, and unless\"]}],\"userModified\":false,\"replaceAll\":false,\"contentNotInModelContext\":true}}\n+{\"type\":\"assistant\",\"message\":{\"model\":\"claude-sonnet-5\",\"id\":\"msg_011CfUai5udkvq2AzBkrmVSP\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"Now add \\\"own_records\\\" mention in the test paragraph.\"}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":936,\"cache_read_input_tokens\":97294,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":936},\"output_tokens\":4,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"5a752ff7-c430-4cfd-9b9a-21883129b5e6\",\"uuid\":\"a00277e4-655a-4855-be93-6d6de839c540\",\"timestamp\":\"2026-09-27T20:33:32.623Z\",\"request_id\":\"req_011CfUai5a3N7hZ1s7URCsGu\"}\n+{\"type\":\"assistant\",\"message\":{\"model\":\"claude-sonnet-5\",\"id\":\"msg_011CfUai5udkvq2AzBkrmVSP\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_01RFE5RyBV54ZyPtEnNfYC65\",\"name\":\"Edit\",\"input\":{\"replace_all\":false,\"file_path\":\"/Users/davidbean/Projects/attavo-worktree-237/attavo/cli.py\",\"old_string\":\"counsel, file-stops -- refuses to run at all when ATTAVO_STAGE is set,\\nsince the transport is the pass's, not the executor's.\",\"new_string\":\"counsel, file-stops -- refuses to run at all when ATTAVO_STAGE is set,\\nsince the transport is the pass's, not the executor's. The tests that\\nread this repository's own records carry @pytest.mark.own_records, the\\nonly vocabulary that tells them apart from the rest of the suite;\\n[tests].run and CI's full-suite step exclude them (-m 'not own_records')\\nand the doctor job and CI's inherit path run only them (-m own_records).\"},\"caller\":{\"type\":\"direct\"}}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":936,\"cache_read_input_tokens\":97294,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":936},\"output_tokens\":4,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"5a752ff7-c430-4cfd-9b9a-21883129b5e6\",\"uuid\":\"5d154483-ffbc-42fd-9a79-8df7dae0b38d\",\"timestamp\":\"2026-09-27T20:33:34.903Z\",\"request_id\":\"req_011CfUai5a3N7hZ1s7URCsGu\",\"wire_tool_inputs\":{\"toolu_01RFE5RyBV54ZyPtEnNfYC65\":{\"file_path\":\"/Users/davidbean/Projects/attavo-worktree-237/attavo/cli.py\",\"old_string\":\"counsel, file-stops -- refuses to run at all when ATTAVO_STAGE is set,\\nsince the transport is the pass's, not the executor's.\",\"new_string\":\"counsel, file-stops -- refuses to run at all when ATTAVO_STAGE is set,\\nsince the transport is the pass's, not the executor's. The tests that\\nread this repository's own records carry @pytest.mark.own_records, the\\nonly vocabulary that tells them apart from the rest of the suite;\\n[tests].run and CI's full-suite step exclude them (-m 'not own_records')\\nand the doctor job and CI's inherit path run only them (-m own_records).\"}}}\n+{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01RFE5RyBV54ZyPtEnNfYC65\",\"type\":\"tool_result\",\"content\":\"The file /Users/davidbean/Projects/attavo-worktree-237/attavo/cli.py has been updated successfully.\"}]},\"parent_tool_use_id\":null,\"session_id\":\"5a752ff7-c430-4cfd-9b9a-21883129b5e6\",\"uuid\":\"43510e73-57c8-4cb6-bb26-b5e279d6240e\",\"timestamp\":\"2026-09-27T20:33:34.908Z\",\"tool_use_result\":{\"filePath\":\"/Users/davidbean/Projects/attavo-worktree-237/attavo/cli.py\",\"oldString\":\"counsel, file-stops -- refuses to run at all when ATTAVO_STAGE is set,\\nsince the transport is the pass's, not the executor's.\",\"newString\":\"counsel, file-stops -- refuses to run at all when ATTAVO_STAGE is set,\\nsince the transport is the pass's, not the executor's. The tests that\\nread this repository's own records carry @pytest.mark.own_records, the\\nonly vocabulary that tells them apart from the rest of the suite;\\n[tests].run and CI's full-suite step exclude them (-m 'not own_records')\\nand the doctor job and CI's inherit path run only them (-m own_records).\",\"originalFile\":\"\\\"\\\"\\\"attavo: the command.\\n\\n    attavo doctor [TENANT_ROOT] [--json]\\n    attavo spec-gate [N]\\n    attavo approve [N] --by LOGIN\\n    attavo approval-status [N]\\n    attavo build [N]\\n    attavo verify [N]\\n    attavo file-findings [N]\\n    attavo file-stops [N]\\n    attavo counsel [N]\\n    attavo record-only\\n    attavo attest [--partial] [N]\\n    attavo drive [N] [--until-ready] [--again] [--report]\\n    attavo drive --all\\n    attavo worker N <build|verify> NN\\n    attavo ledger [N] [--json]\\n    attavo stops [N] [--json]\\n    attavo test [N] [--all | <test>...] [--fresh]\\n\\nThe doctor is the definition of done. It asserts five proofs against a\\ntenant root and exits 1 until every proof holds:\\n\\n  1. every-gate-rejects      every gate in the manifest's [gates] table,\\n                             run against its rejection fixture, exits non-zero,\\n                             and carries a non-empty retires\\n  2. one-item-every-stage    one work item under paths.records carries a\\n                             record for every stage -- spec, approval,\\n                             build, verify -- all four introduced by one\\n                             merge commit reachable from HEAD\\n  3. no-commit-lacks-record  every commit on the default branch after the\\n                             manifest was introduced is named by a record's\\n                             sha or commits list, or itself writes under\\n                             paths.records (a record is committed with the\\n                             code it describes; an item's merge commit\\n                             carries its own record paths this way)\\n  4. no-stop-lacks-cause     every build or verify record under\\n                             paths.records at record_version 3 or later,\\n                             with a status other than pass, carries a stop\\n                             naming an enumerated class and provenance, a\\n                             non-empty detail when unclassed, the gates\\n                             heading when a build failed after running\\n                             them, and the tool's own error line when an\\n                             adapter exit ended the log -- records before\\n                             record_version 3 are counted and reported,\\n                             never refused\\n  5. every-attested-item-is-sealed\\n                             every merged item that carries a record for\\n                             every stage has a statement in the forge's\\n                             attestation store for its merge commit, read\\n                             through [forge].attestation_command -- a\\n                             merge at or before [forge].sealed_since is\\n                             named as before the window instead of failed.\\n                             [forge].attestation_command exiting 2 means\\n                             the store itself could not be read, reported\\n                             as not_read by item and never as unsealed\\n  6. no-attested-item-is-empty\\n                             no attested item is empty: every merged,\\n                             fully-staged item's passing build record\\n                             names a change, sha not equal to start_sha.\\n                             [doctor].built_since names a commit at or\\n                             before which merges are named as before the\\n                             window instead of failed, so the specimen\\n                             that motivated this proof stands on the\\n                             record without failing the tenant forever;\\n                             absent, the window is proof three's. A build\\n                             record with no start_sha is counted as not\\n                             readable, never as failed.\\n\\nNothing in doctor is a gate. The doctor reads; it never writes and it never\\nblocks a merge by itself. It is what CI runs to say whether the product\\nis done.\\n\\nspec-gate, approve, and approval-status are gates and writers. They run\\nfrom the tenant root (the current working directory); N, the work item id,\\nis read from the ATTAVO_ITEM environment variable when set, else from the\\nbranch (attavo/N-*). The doctor's first proof sets ATTAVO_ITEM for a\\nrejection fixture's own item, so a gate's own command needs no argument\\neven while the enclosing repository sits on a real item's attavo/N-*\\nbranch. Every run of spec-gate or approve writes the next numbered attempt\\nfile under paths.records/N/ and never overwrites one already written. A\\nfix item's spec names the root-cause bucket its change closes as one line\\nin the problem, \\\"Bucket: <slug>\\\"; spec-gate refuses a bucket the tenant's\\nbuckets.md (beside paths.specs) does not list, or any bucket when that\\nfile does not exist, before any criterion runs -- a spec with no bucket\\nline is not asked for one. See the spec contract in the project's Phase 1\\nissue for the full rules each one enforces.\\n\\nbuild refuses (exit 1, naming the cause, no record) unless the manifest\\ndeclares [executor].build and [tests].select and [tests].run, and unless\\napproval-status would print valid. It exports the executor's identity\\n(issue #33) into the adapter's environment as GIT_AUTHOR_NAME/EMAIL and\\nGIT_COMMITTER_NAME/EMAIL, set by the product and never the tenant's git\\nconfig, then invokes the named adapter (adapters/<name>/run) with the\\nspec, the corpus, and the branch. It refuses (status refused) a commit\\nbetween start_sha and HEAD not authored by that identity, checks that\\nevery path touched matches a spec claim, records the adapter's own\\ndeclared \\\"reports\\\" -- the fields adapters/<name>/conformance.json says\\nit can supply with a real value (issue #41), so a field it claims and\\nnever supplies is a defect the conformance suite catches rather than a\\nsilent null -- then runs the criteria, the\\ntests [tests].select and [tests].run name for the touched paths, and --\\nwhen the manifest declares [checks].command -- the tenant's own\\nwhole-tree check, all three run in a detached worktree of HEAD and\\nnever in the executor's own directory: the gate reads the commit, not\\nthe tree, so a path written and never committed cannot pass a\\ncriterion, a test, or a check on the executor's behalf. An iteration\\nthat ends with HEAD unchanged since start_sha is told, in the feed and\\nthe log, that the executor committed nothing and that the gate reads\\nthe commit, and iterates; the last iteration ending that way halts the\\nbuild instead of failing it, stop class empty, provenance executor,\\ndetail naming that the executor committed nothing and how many paths\\nit left modified or untracked. pass requires every criterion,\\nthe test run, and the tenant's checks (if declared) to exit 0, and HEAD\\nto have moved since start_sha; any non-zero exit iterates, with the\\nfailure as feedback, up to a fixed budget. [checks] is optional; a\\ntenant that declares none is not refused. Before the adapter is invoked\\nit asks whether this machine can\\nrun the checks -- of [checks].probe, run once inside [checks].probe_timeout_s\\n(exit 0 yes; anything else, or the bound, an environment refusal), or,\\nfor a tenant that declares no probe, by running [checks].command whole\\n(exit 2 no) -- and says both the question and the answer in the feed\\n(issue #212). The adapter is given ATTAVO_TEST_COMMAND, `attavo test N`,\\nand ATTAVO_TEST_TIMEOUT_S when [tests].call_timeout_s is declared; it\\nis not given the tenant's checks. It writes the next build-NN.json under paths.records/N/, with\\nthe adapter's transcript -- each iteration's gate output (criteria\\nexits, the selected tests' stdout, the tenant's checks' tail) appended\\nunder an \\\"--- attavo gates, iteration N ---\\\" heading, issue #89 -- beside\\nit as build-NN.log. Every record whose status is not pass carries stop:\\n{class, provenance, detail}, derived from the refusal, halted, and log\\nalready on hand (issue #89); a pass record carries stop: null. See the\\nbuild contract in the project's Phase 2 issue for the full rules it\\nenforces.\\n\\ntest [N] runs the tests [tests].select names for every path the item has\\nchanged since it left the default branch (refs/remotes/origin/HEAD),\\ncommitted or not and untracked included, paths.records aside, through\\n[tests].run (mode mapped, the default). test N <test>... runs exactly the\\nnamed tests instead (mode named), so an executor working on one test runs\\none test; test N --all runs the whole suite through [tests].run with\\n\\\"tests\\\" as the one identifier (mode all), the same bound, event, and\\nexclusion as the other two. Naming tests and --all together is refused\\n(exit 2). It prints how many were selected (or that none was, and runs\\nnothing), exits as the run does, and, when [tests].call_timeout_s is\\ndeclared and the run outlasts it, ends the run and everything it started\\nand exits 124. It exits 2 when it cannot name the changes or the selector\\nfails. A run that exits 0 is cached against a fingerprint of the tree\\n(HEAD, the diff against it, and every untracked unignored file's name and\\ncontent hash, together with the mode and the identifiers); asked again on\\nan unchanged tree it says so -- unchanged since the earlier run, not\\nrerun -- without spending a second on it; --fresh reruns anyway. A\\nfailing run is never cached, since the next question after one is always\\nwhether an edit fixed it. [tests].exclude_in_executor names test\\nidentifiers left out, and said so, when ATTAVO_STAGE is set (inside an\\nexecutor); they run outside one and in CI. When ATTAVO_EVENTS is set, one\\nevent of kind test is written per invocation, naming the mode, the count\\nselected, the exit code, and the seconds spent (or that the answer came\\nfrom the cache). It is the one test command an executor is given (issue\\n#212); the product's own transport -- drive, worker, build, verify,\\ncounsel, file-stops -- refuses to run at all when ATTAVO_STAGE is set,\\nsince the transport is the pass's, not the executor's.\\n\\nverify refuses (exit 1) unless the item's latest build record has\\nstatus pass, and unless the manifest declares [forge].checks_command --\\na tenant command, taking a full commit sha on argv, that prints one\\nline per check as \\\"<name> <conclusion>\\\". verify runs it on the build\\nrecord's sha first: any conclusion other than success, neutral, or\\nskipped writes verify-NN.json with status returned and calls no\\nadapter, because a judge is never spent on a tree the forge already\\ncalled red. With the forge green, verify calls the adapter named by\\n[executor].verify (defaulting to [executor].build) with the diff since\\nthe build's approval, the spec, and the build record, and records its\\nfindings and its declared \\\"reports\\\" (issue #41). [executor.<adapter>.<stage>] shadows [executor.<adapter>] for\\nbuild or verify alone; both merge parent then stage before setting\\nATTAVO_ADAPTER_CONFIG, and the record's adapter_config is the merged\\nresult. Like build, every verify record whose status is not pass\\ncarries stop: {class, provenance, detail} (issue #89); a pass record\\ncarries stop: null. file-findings opens one tenant issue per finding in\\nthe item's latest verify record via [forge].file_issue_command, and\\nrefuses (exit 1, nothing filed) a record carrying a finding with no\\nretires. See the verify contract in the project's Phase 2 issue for the\\nfull rules both enforce.\\n\\nfile-stops opens one tenant issue per stop record of the item with no\\nissue filed for it yet, through [forge].file_issue_command, naming the\\nclass, the provenance, the record path, and the log's last twenty\\nlines; a record it has already filed carries a <stage>-NN.filed marker\\nbeside it, holding the filing command's own stdout, so a second run\\nfiles nothing new. Like a build or verify record, this command writes\\nthe marker and leaves it uncommitted -- drive commits it, in the same\\ncommit as the record it names (issue #89). It refuses (exit 1,\\nnothing filed) a stop whose class is unclassed and whose detail is\\nempty -- a stop the product cannot even describe is not filed as if it\\ncould. See issue #89's lane for the full rules it enforces.\\n\\ncounsel reads the item's latest non-pass build or verify record -- or,\\nwhen neither exists, its latest refused spec-gate record, the earliest\\npoint a question can be answered inside the product, before any\\napproval or executor spend (issue #133) -- and asks the tenant's\\n[executor].counsel adapter (defaulting to [executor].verify) a\\nread-only question about it: the record, its log, the spec (problem,\\nclaims, criteria, stub, including stub/.removed), paths.rulings, the\\nitem's diff since approval, the tenant manifest, and this product's own\\nroot (bin/attavo, adapters/, schema/, templates/) by path, under the\\nsame sandbox verify runs under. The adapter answers with class (the\\nstop enumeration, or unclassed), verdict (answer: a ruling text with\\ncitations; patch: a product defect's file, symbol, rejection test, and\\ndiff; person: a one-line question no rule covers), citations\\n(instruction, mechanism, guard, each a path and symbol or a ruling id),\\nand proposal (the ruling text, the patch, or the question). It writes\\nthe next counsel-NN.json under paths.records/N/, with the adapter's\\ntranscript beside it as counsel-NN.log, and commits nothing -- the\\ncaller commits, as with every stage. It refuses (exit 1, nothing\\nwritten) when the item carries no non-pass build, verify, or spec-gate\\nrecord to counsel. See issue #100's lane for the full rules it\\nenforces, and issue #133's for the spec-gate fallback.\\n\\nrecord-only exits 0 when HEAD, against its first parent, touches only\\npaths.records; 1 otherwise; 2 with no manifest. Core logic about a git\\ncheckout, not a forge's shell -- a workflow template's push-and-retrigger\\nguard is one line reading this exit code instead of carrying its own\\ncopy of the check.\\n\\nattest refuses (exit 1) unless the latest spec, approval, build, and\\nverify records for an item all exist and chain: the build's approval_sha\\nnames the latest approval, and the verify's build_sha names that build --\\na re-approval after a build must force a re-run of what changed. With no\\nN given it derives the item from the record paths HEAD's merge commit\\ntouched under paths.records/<N>/, not from a branch name, which a squash\\nmerge discards and which names a forge's convention the product does not\\nknow; more than one item derived is a refusal naming what it found. Zero\\nis not a defect -- not every merge is an item merge -- exit 0, nothing\\nprinted but a line saying so.\\n\\nattest never writes. On a coherent chain it prints the attestation\\nstatement -- validating against schema/attestation.schema.json -- to\\nstdout as JSON and exits 0: the item, its four records and their shas,\\nand the commit the statement was computed at (sha and merge_sha are the\\nsame commit here; on the merge group that commit is the one that lands).\\nThe four stage records already under paths.records are the evidence for\\nthat statement; a forge-specific template signs the printed JSON,\\nunmodified, as the predicate, against the commit that lands, on the merge\\ngroup -- and the signed bundle in the forge's attestation store is the\\nseal over it. attest itself never signs anything and never talks to a\\nsigning service. --partial (issue #67) is for a pull request, where the\\nrecord a complete chain would need is the output of a later stage that is\\nitself waiting on this check: a missing later record is \\\"not yet\\\" (exit\\n0, naming the item and the stages present and absent, no statement\\nprinted) rather than a refusal, while the two chain assertions -- build's\\napproval_sha names the latest approval, verify's build_sha names the\\nlatest build -- still run over whatever records exist. merge_group and a\\npush to main still demand the whole chain. See issue #69's lane for the\\nfull rules it enforces.\\n\\ndrive (reconciler R2) is one short pass: it fast-forwards its working copy\\nto origin's branch (never while a worker holds it), reads the item's\\nreport (attavo.report, issue #206) exactly as --report would, and acts at\\nmost once -- one of the three states that are the product's own move --\\nbefore returning, almost always within seconds. owes-recovery writes the\\ndied or hung record for the one invocation the report named (what\\n--recover used to do, by hand); next-build and next-review start their\\nstage. Starting a stage is the lease: drive writes the invocation marker,\\ncommits it, and pushes that one commit as a plain fast-forward, no merge\\nand no retry -- a rejection that is not a fast-forward, or a ref another\\npush already holds, means another pass started this attempt first, and\\nthis one says so, resets its own marker commit, and starts nothing; a\\npush the remote refuses outright is exit 1 and starts nothing either way.\\nOn a pushed marker drive spawns `attavo worker N <build|verify> NN` in\\nits own session, its stdout and stderr appended to\\n<git-dir>/attavo/<stage>-NN.worker.log, and returns -- the worker\\noutlives the pass. Every other level is printed in the report's own\\nwords and left alone, exit 0; exit 1 is a refusal. See issue #217's lane\\n(the reconciler's R2) for the full rules it enforces.\\n\\nworker N <build|verify> NN is the stage itself, run in the detached child\\na pass just started: build or verify in-process, exactly as the pass used\\nto run it inline before R2, touching\\n<git-dir>/attavo/<stage>-NN.heartbeat every ATTAVO_HEARTBEAT_S seconds\\n(15) while it runs -- what a report or a pass reads first to tell a\\nrunning invocation from a died one, falling back to the pid only when\\nthere is no heartbeat file at all. A record the stage writes that is not\\npass is counseled (counsel, issue #100) and filed (file-stops, issue #89)\\nbefore it is transported, so its .filed marker exists in time to be\\ncommitted alongside it; the worker then commits the stage record and the\\ncounsel record together -- each with its own log and marker -- with\\n`git commit --only`, never sweeping the index, and pushes, with the\\nrecord push's own retry: a push a divergent remote rejects is retried\\nonce after `git pull --no-rebase --no-edit`, never a rebase, since the\\nrecord already names the commit's sha. On a review, ATTAVO_FORGE_CHECKS\\nnames the file the pass already wrote the forge's own read into (the\\nchecks it saw on the head before its marker, reconciler ruling B); verify\\nreads that file instead of polling when it is set.\\n\\n--until-ready repeats the pass in this same process, sleeping\\nATTAVO_DRIVE_POLL_INTERVAL_S between passes, until the level is the\\noperator's or done (exit 0), a concluded check reads red (exit 1), or an\\nunconcluded one has not concluded within ATTAVO_DRIVE_POLL_BOUND_S (exit\\n1) -- a stage running in its own worker is not bounded by either\\nconstant, only time spent waiting on the forge is. Without the flag,\\ndrive is one pass, then stop.\\n\\n--again starts the next attempt of a stopped stage -- the operator's own\\nresume, until a later reconciler ruling drives a retry itself. --recover\\nis gone: `attavo drive --recover` now exits 2 saying so; recovery is\\nwhat a pass does on its own, the moment the report owes one.\\n\\n--all runs one pass, in its own process, in every ../attavo-worktree-N\\nbeside this checkout -- each line either prints is prefixed with the\\nworktree's own directory name.\\n\\n--report prints, as JSON against schema/drive-report.schema.json, what\\nitem N is waiting on: its state, whose move it is (yours, waits, acts,\\ndone), and one sentence in the operator's words. It reads exactly what a\\npass reads -- the item's records, its invocation markers and heartbeats,\\none read of the forge -- and does nothing else: it writes no record,\\nstarts nothing, terminates nothing, and does not poll, so a concluded\\nred check reads as blocked-on-checks for as long as it is red. It exits\\n0 on every state. See issue #206's lane for the states.\\n\\nledger reads, never writes. For item N (or every item under\\npaths.records when N is omitted), it walks the commits from the item's\\nfirst spec commit to its merge (the same derivation doctor's proof two\\nand attest use) or to HEAD when the item has not merged, and prints one\\nrow per act: the sha, the identity as git names it, and a class from a\\nclosed list -- spec, amend, approve, launch, record, change, transport,\\nmerge -- derived from who committed it and, for an approval, build, or\\nverify record, what the record itself says. A summary line follows:\\noperator acts (approve, amend, launch, transport, merge), product acts\\n(record), executor commits (change), stops (non-pass records), and\\nsince (the product version on the first record). A build or verify\\nrecord's own commit, from before v0.18.0 gave the driver and the\\nexecutor their own identities, prints as record-or-launch with a note,\\ncounted toward neither total, rather than guessed. --json prints the\\nrows and the summary as one object. See issue #128's lane for the full\\nrules it enforces.\\n\\nstops reads, never writes. For item N (or every item under\\npaths.records when N is omitted), one row per non-pass build or verify\\nrecord: the record, its stop's class, provenance, and detail, and the\\nanswerer -- \\\"counsel:<verdict>\\\" when a counsel record read this exact\\nstop, else \\\"person\\\" for a question, else \\\"guard\\\" for a class a guard\\nalone raised (GUARDED_STOP_CLASSES), else \\\"none\\\". A record too old to\\ncarry stop at all prints the doctor's own phrase for it, \\\"before stop\\nwas recorded\\\", and is counted there rather than by class. Totals per\\nclass (read from the build record schema's own enum, never retyped) and\\nper answerer, plus the before-stop count, follow the rows. --json prints\\nthe rows and the totals as one object. See issue #129's lane for the\\nfull rules it enforces.\\n\\\"\\\"\\\"\\n\\nfrom __future__ import annotations\\n\\nimport os\\nimport sys\\n\\nfrom attavo.approval import cmd_approval_status, cmd_approve\\nfrom attavo.attest import cmd_attest\\nfrom attavo.build import cmd_build\\nfrom attavo.counsel import cmd_counsel\\nfrom attavo.doctor import cmd_doctor\\nfrom attavo.drive import cmd_drive, cmd_worker\\nfrom attavo.filing import cmd_file_findings, cmd_file_stops\\nfrom attavo.ledger import cmd_ledger\\nfrom attavo.record_only import cmd_record_only\\nfrom attavo.spec import cmd_spec_gate\\nfrom attavo.stops import cmd_stops\\nfrom attavo.testtool import cmd_test\\nfrom attavo.verify import cmd_verify\\n\\n\\nTRANSPORT = (\\\"drive\\\", \\\"worker\\\", \\\"build\\\", \\\"verify\\\", \\\"counsel\\\", \\\"file-stops\\\")\\n\\n\\ndef main(argv: list[str]) -> int:\\n    if not argv or argv[0] in (\\\"-h\\\", \\\"--help\\\"):\\n        print(__doc__.strip())\\n        return 0 if argv else 2\\n    if argv[0] in TRANSPORT and os.environ.get(\\\"ATTAVO_STAGE\\\"):\\n        # The product's transport is never the executor's tool: a stage\\n        # runs inside an invocation whose environment names the stage,\\n        # and nothing under it may start, judge, or record another.\\n        print(f\\\"attavo {argv[0]}: refused inside an executor (ATTAVO_STAGE is set); \\\"\\n              f\\\"the transport is the pass's, not the executor's\\\", file=sys.stderr)\\n        return 2\\n    if argv[0] == \\\"doctor\\\":\\n        return cmd_doctor(argv[1:])\\n    if argv[0] == \\\"spec-gate\\\":\\n        return cmd_spec_gate(argv[1:])\\n    if argv[0] == \\\"approve\\\":\\n        return cmd_approve(argv[1:])\\n    if argv[0] == \\\"approval-status\\\":\\n        return cmd_approval_status(argv[1:])\\n    if argv[0] == \\\"build\\\":\\n        return cmd_build(argv[1:])\\n    if argv[0] == \\\"verify\\\":\\n        return cmd_verify(argv[1:])\\n    if argv[0] == \\\"file-findings\\\":\\n        return cmd_file_findings(argv[1:])\\n    if argv[0] == \\\"file-stops\\\":\\n        return cmd_file_stops(argv[1:])\\n    if argv[0] == \\\"counsel\\\":\\n        return cmd_counsel(argv[1:])\\n    if argv[0] == \\\"record-only\\\":\\n        return cmd_record_only(argv[1:])\\n    if argv[0] == \\\"attest\\\":\\n        return cmd_attest(argv[1:])\\n    if argv[0] == \\\"drive\\\":\\n        return cmd_drive(argv[1:])\\n    if argv[0] == \\\"worker\\\":\\n        return cmd_worker(argv[1:])\\n    if argv[0] == \\\"ledger\\\":\\n        return cmd_ledger(argv[1:])\\n    if argv[0] == \\\"stops\\\":\\n        return cmd_stops(argv[1:])\\n    if argv[0] == \\\"test\\\":\\n        return cmd_test(argv[1:])\\n    print(f\\\"attavo: unknown subcommand {argv[0]!r}; only doctor, spec-gate, approve, \\\"\\n          f\\\"approval-status, build, verify, file-findings, file-stops, counsel, record-only, \\\"\\n          f\\\"attest, drive, worker, ledger, stops, test exist at this commit\\\", file=sys.stderr)\\n    return 2\\n\",\"structuredPatch\":[{\"oldStart\":158,\"oldLines\":7,\"newStart\":158,\"newLines\":11,\"lines\":[\" from the cache). It is the one test command an executor 
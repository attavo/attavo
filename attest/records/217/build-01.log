","+        return 2","+    return _stage_body(item_id, stage, nn)"," ","-    if stage == \"no-approval\":","-        print(f\"attavo drive: refused: approval is {extra}\")","-        return 1, True"," ","+# --- the pass's own two acts: start a stage (the lease), and recover","+# exactly the one invocation the report names owed one. ---","+","+def _start_stage(root: Path, m: dict[str, Any], item_id: str, stage: str,","+                 forge_checks: dict[str, Any] | None) -> int:","+    \"\"\"The lease (ruling A): the marker, committed and pushed as a plain","+    fast-forward with no merge and no retry (push_lease). Lost to another","+    pass, or refused outright by the remote, both undo the marker commit","+    here (git reset --hard) so this checkout carries no half-taken","+    attempt either way; only a pushed lease starts the worker. On a","+    review, forge_checks is the checks this same pass already read on","+    the pre-marker head (ruling B) -- written to","+    <git-dir>/attavo/verify-NN.forge-checks.json and named in","+    ATTAVO_FORGE_CHECKS, so the worker's own `attavo verify` reads it","+    instead of polling.\"\"\"","+    records_dir = root / m[\"paths\"][\"records\"] / item_id","     branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()","+    nn = next_attempt_number(records_dir, stage)","+    marker = write_invocation_marker(root, records_dir, stage, nn)","+    try:","+        commit_record(root, [marker], f\"attavo: {stage} invocation {nn:02d} started for item {item_id}\")","+    except RuntimeError as exc:","+        print(f\"attavo drive: stopped: could not commit the {stage} invocation marker: {exc}\")","+        return 1"," ","-    if stage == \"build\":","-        return _drive_run_stage(root, records_dir, branch, \"build\", item_id)","+    outcome, err = push_lease(root, branch)","+    if outcome != \"pushed\":","+        git(root, \"reset\", \"--hard\", \"HEAD^\")","+        if outcome == \"lost-race\":","+            print(f\"attavo drive: another pass holds this attempt ({marker.name}); nothing started\")","+            return 0","+        print(f\"attavo drive: stopped: could not push the {stage} invocation marker: {err}\")","+        return 1"," ","+    env = dict(os.environ)","+    if forge_checks is not None:","+        checks_file = forge_checks_path(root, stage, nn)","+        checks_file.write_text(json.dumps(forge_checks))","+        env[\"ATTAVO_FORGE_CHECKS\"] = str(checks_file)","+    log = worker_log_path(root, stage, nn)","+    with log.open(\"ab\") as fh, open(os.devnull, \"rb\") as devnull:","+        proc = subprocess.Popen(","+            [sys.executable, str(PRODUCT_ROOT / \"bin\" / \"attavo\"), \"worker\", item_id, stage, f\"{nn:02d}\"],","+            cwd=str(root), env=env, stdin=devnull, stdout=fh, stderr=subprocess.STDOUT,","+            start_new_session=True)","+    word = \"Build\" if stage == \"build\" else \"Review\"","+    print(f\"attavo drive: {word} started (attempt {nn:02d}, worker pid {proc.pid})\")","+    return 0","+","+","+def _recover_one(root: Path, m: dict[str, Any], item_id: str, records_dir: Path) -> int:","+    \"\"\"The pass's own recovery act (what `--recover` did): exactly the one","+    invocation the report just read as owing one -- died or hung -- ends","+    here. class died when the heartbeat is stale (or absent and the pid","+    is gone), class hung when there is no heartbeat, the pid lives, and a","+    declared [drive].stall_after_s has passed with no newer event, and","+    terminated. Provenance product; the events tail as the log. Committed","+    and pushed the way any stage record is (push_record_commit, with its","+    own merge retry) -- this is not a race for a lease, since no new","+    attempt marker is written.\"\"\"","+    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()","+    bound = stall_bound_s(m)","+    pending = invocations_without_record(records_dir)","+    readings = [(marker, info, read_invocation(root, bound, marker, info)) for marker, info in pending]","+    candidate = next(((mk, i, rd) for mk, i, rd in readings if rd.cls != \"running\"), None)","+    if candidate is None:","+        # The report read this a moment ago; nothing owed recovery by the","+        # time this pass got here (another pass recovered it, or it","+        # finished on its own).","+        return 0","+    marker, info, reading = candidate","+    stage, nn, log, last_at, age, cls = reading","+    pid, host = info.get(\"pid\"), info.get(\"host\")","+","+    if next_attempt_number(records_dir, stage) != nn:","+        print(f\"attavo drive: stopped: {marker.name} names attempt {nn} but the next \"","+              f\"{stage} record would be {next_attempt_number(records_dir, stage):02d}; \"","+              f\"a later record already exists, read the records before recovering\")","+        return 1","+","+    if cls == \"hung\":","+        try:","+            os.kill(cast(int, pid), signal.SIGTERM)","+            ended = \"terminated\"","+        except OSError as exc:","+            ended = f\"not terminated ({exc})\"","+        detail = (f\"pid {pid} on {host} alive with no event for {int(cast(float, age))} s \"","+                  f\"(bound {bound} s); {ended}\")","+    else:","+        detail = (f\"pid {pid} on {host} is not running and wrote no {marker.stem}.json; \"","+                  f\"started {info.get('at')}, last event {last_at or 'none'}\")","+","+    schema = stage_schema(stage)","+    record: dict[str, Any] = {k: None for k in schema.get(\"required\", [])}","+    approval = latest_record(records_dir, \"approval\")","+    record.update({\"sha\": info.get(\"sha\"), \"start_sha\": info.get(\"sha\"),","+                   \"approval_sha\": approval.get(\"sha\") if approval else None,","+                   \"at\": info.get(\"at\"),","+                   \"adapter\": (m.get(\"executor\") or {}).get(stage),","+                   \"status\": \"failed\", \"refusal\": None, \"halted\": None,","+                   \"stop\": {\"class\": cls, \"provenance\": \"product\", \"detail\": detail}})","+    if \"wall_clock_s\" in record:","+        record[\"wall_clock_s\"] = None if age is None else int(age)","+    record = {k: v for k, v in record.items() if k in schema.get(\"properties\", {})}","+    try:","+        path = write_record(records_dir, stage, record, m, item_id, log=log)","+    except ValueError as exc:","+        print(f\"attavo drive: stopped: could not write the {cls} record for {marker.stem}: {exc}\")","+        return 1","+    try:","+        commit_record(root, [path], f\"attavo: {stage} record for item {item_id} \"","+                                    f\"({path.stem}), recovered as {cls}\")","+    except RuntimeError as exc:","+        print(f\"attavo drive: stopped: could not commit the {cls} record: {exc}\")","+        return 1","+    ok, err = push_record_commit(root, branch)","+    if not ok:","+        print(f\"attavo drive: stopped: could not push the {cls} record: {err}\")","+        return 1","+    print(f\"attavo drive: recovered {marker.stem} as {cls}: {detail}\")","+    return 0","+","+","+def _advance_again(root: Path, m: dict[str, Any], item_id: str, stage: str, head: str | None) -> int:","+    \"\"\"`--again`'s own act on a stopped stage: exactly what next-build or","+    next-review would do, bypassing the level a plain pass leaves alone","+    for the operator. A review reads the forge fresh here -- once, since","+    the report's own stopped reading never touched it -- rather than","+    reusing a read that was never taken.\"\"\"","+    if stage == \"build\":","+        return _start_stage(root, m, item_id, \"build\", None)","     checks_command = (m.get(\"forge\") or {}).get(\"checks_command\")","     if not checks_command:","         print(\"attavo drive: refused: no [forge].checks_command in the manifest\")","-        return 1, True","-    head_sha = git(root, \"rev-parse\", \"HEAD\").strip()
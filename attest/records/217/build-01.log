{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_018K3UUJq43JHtxCqtAKEYRd","type":"tool_result","content":"1\tfrom __future__ import annotations\n2\t\n3\timport fnmatch\n4\timport json\n5\timport os\n6\timport re\n7\timport subprocess\n8\tfrom pathlib import Path\n9\tfrom typing import Any\n10\t\n11\tfrom attavo.attest import check_attest_chain, item_time_and_cost\n12\tfrom attavo.common import (\n13\t    MANIFEST,\n14\t    Proof,\n15\t    STAGES,\n16\t    fixture_item_id,\n17\t    git,\n18\t    product_version,\n19\t    read_manifest,\n20\t)\n21\tfrom attavo.records import RECORD_RE, load_records, parse_attempts\n22\tfrom attavo.stops import STOP_CLASSES, STOP_PROVENANCES, STOP_STAGES, gate_stop\n23\t\n24\t# --- doctor's three proofs ---\n25\t\n26\tdef proof_every_gate_rejects(root: Path, m: dict[str, Any] | None) -> Proof:\n27\t    p = Proof(\"every-gate-rejects\", \"every gate rejects its fixture\")\n28\t    if m is None:\n29\t        return p.fail(f\"no {MANIFEST} at {root}; no gate is registered\")\n30\t    gates = m.get(\"gates\") or {}\n31\t    if not gates:\n32\t        return p.fail(\"[gates] is empty; a gate that has rejected nothing does not exist\")\n33\t    fixtures = root / m.get(\"paths\", {}).get(\"rejections\", \"\")\n34\t    # Proposal, not yet ruled on (issue #54): a gate that retires nothing\n35\t    # only adds, so proof one reports it here rather than waiting on the\n36\t    # schema alone -- read_manifest never validates against the manifest\n37\t    # schema at runtime, so a schema requirement is not an enforced one.\n38\t    no_retires = [name for name, gate in sorted(gates.items()) if not gate.get(\"retires\")]\n39\t    missing, accepted = [], []\n40\t    for name, gate in sorted(gates.items()):\n41\t        fixture = fixtures / name\n42\t        if not fixture.is_dir():\n43\t            missing.append(name)\n44\t            continue\n45\t        env = dict(os.environ)\n46\t        item = fixture_item_id(fixture)\n47\t        if item is not None:\n48\t            env[\"ATTAVO_ITEM\"] = item\n49\t        run = subprocess.run(gate[\"command\"], shell=True, cwd=str(fixture),\n50\t                             capture_output=True, text=True, check=False, env=env)\n51\t        if run.returncode == 0:\n52\t            accepted.append(name)\n53\t    if missing:\n54\t        return p.fail(f\"gate(s) with no rejection fixture: {', '.join(missing)}\")\n55\t    if accepted:\n56\t        return p.fail(f\"gate(s) that accepted their rejection fixture: {', '.join(accepted)}\")\n57\t    if no_retires:\n58\t        return p.fail(f\"gate(s) with no retires: {', '.join(no_retires)}\")\n59\t    return p.hold(f\"{len(gates)} gate(s) rejected their fixture\")\n60\t\n61\t\n62\tdef _merges_reachable(root: Path) -> tuple[list[dict[str, Any]], str | None]:\n63\t    \"\"\"(merges, refusal): every merge commit on the default branch's own\n64\t    first-parent line -- sha, parents, and its own first-parent diff --\n65\t    read by one process rather than the git log plus one git diff per\n66\t    merge merge_introducing_records used to pay walking toward the one\n67\t    it wants (issue #153). refs/remotes/origin/HEAD names the default\n68\t    branch without hard-coding \"main\", the same primitive\n69\t    diff_since_approval already uses (issue #52); walking from it rather\n70\t    than from HEAD is what keeps a transport merge on an item branch, a\n71\t    pull_request checkout's own synthetic test merge, and a merge_group's\n72\t    temporary merge from ever being mistaken for an item's merge (issue\n73\t    #169) -- none of those is reachable from the default branch's first-\n74\t    parent line by definition. When refs/remotes/origin/HEAD is not set,\n75\t    this refuses by name rather than guess, exactly as diff_since_approval\n76\t    does.\n77\t\n78\t    The walk starts at HEAD itself when the current checkout is literally\n79\t    on the branch refs/remotes/origin/HEAD names (an ordinary checkout of\n80\t    the default branch, on push or on a developer's own machine) and at\n81\t    the remote-tracking ref's own value otherwise (any other branch, or\n82\t    the detached HEAD a pull_request or merge_group checkout leaves\n83\t    behind) -- HEAD only ever *is* the default branch's first-parent line\n84\t    in the former case; in the latter, only the remote-tracking ref names\n85\t    it. --diff-merges=first-parent gives each merge's diff against its\n86\t    first parent in the same pass git log --merges already makes to list\n87\t    them, in the same order, newest first.\"\"\"\n88\t    symref = subprocess.run(\n89\t        [\"git\", \"-C\", str(root), \"symbolic-ref\", \"-q\", \"refs/remotes/origin/HEAD\"],\n90\t        capture_output=True, text=True, check=False)\n91\t    if symref.returncode != 0:\n92\t        return [], \"refs/remotes/origin/HEAD is not set; run `git remote set-head origin -a`\"\n93\t    default_remote_ref = symref.stdout.strip()\n94\t    default_branch = default_remote_ref.rsplit(\"/\", 1)[-1]\n95\t    current_branch = subprocess.run(\n96\t        [\"git\", \"-C\", str(root), \"symbolic-ref\", \"-q\", \"--short\", \"HEAD\"],\n97\t        capture_output=True, text=True, check=False)\n98\t    default_ref = (\"HEAD\" if current_branch.returncode == 0\n99\t                   and current_branch.stdout.strip() == default_branch\n100\t                   else default_remote_ref)\n101\t    try:\n102\t        out = git(root, \"log\", default_ref, \"--first-parent\", \"--merges\",\n103\t                 \"--diff-merges=first-parent\", \"--name-only\",\n104\t                 \"--format=\\x01%H\\x1f%P\")\n105\t    except RuntimeError:\n106\t        return [], None\n107\t    merges = []\n108\t    for block in out.split(\"\\x01\")[1:]:\n109\t        header, _, rest = block.partition(\"\\n\")\n110\t        sha, parents = header.split(\"\\x1f\")\n111\t        merges.append({\"sha\": sha, \"parents\": parents.split(),\n112\t                       \"touched\": [line for line in rest.splitlines() if line.strip()]})\n113\t    return merges, None\n114\t\n115\t\n116\tdef merge_introducing_records(root: Path, records_rel: str, item: str,\n117\t                              stages: tuple[str, ...],\n118\t                              merges: list[dict[str, Any]] | None = None) -> tuple[str | None, str | None]:\n119\t    \"\"\"(merge_sha, refusal): the merge commit on the default branch's own\n120\t    first-parent line whose first-parent diff introduces a record for\n121\t    every one of stages, under records_rel/item/ -- the same derivation\n122\t    attest itself uses (derive_attest_items), read here so proof two\n123\t    requires an item's stage records to have arrived by an actual merge\n124\t    on the default branch, not merely to sit in the tree, and not by a\n125\t    transport merge, a pull_request checkout's synthetic test merge, or a\n126\t    merge_group's temporary merge (issue #69 acceptance row 4; issue\n127\t    #169). merge_sha is None with no refusal when no such merge exists\n128\t    yet -- the item is not merged, not that the walk failed.\n129\t\n130\t    merges, when given, is _merges_reachable's own result -- ledger's\n131\t    cmd_ledger computes it once and passes it to every item rather than\n132\t    walking the default branch's merges again for each (issue #153); a\n133\t    caller that already has merges has also already handled\n134\t    _merges_reachable's refusal, so this never re-derives one. Left\n135\t    None, a caller with just the one item to ask (doctor's proof two)\n136\t    gets merges computed here, refusal and all.\"\"\"\n137\t    if merges is None:\n138\t        merges, refusal = _merges_reachable(root)\n139\t        if refusal:\n140\t            return None, refusal\n141\t    prefix = f\"{records_rel.rstrip('/')}/{item}/\"\n142\t    for merge in merges:\n143\t        found: set[str] = set()\n144\t        for p in merge[\"touched\"]:\n145\t            if p.startswith(prefix):\n146\t                m = RECORD_RE.match(Path(p).name)\n147\t                if m:\n148\t                    found.add(m.group(1))\n149\t        if all(s in found for s in stages):\n150\t            return merge[\"sha\"], None\n151\t    return None, None\n152\t\n153\t\n154\tINVOCATION_MARKER_SUFFIX = \".started\"\n155\t\n156\t\n157\tdef invocation_marker_path(records_dir: Path, stage: str, nn: int) -> Path:\n158\t    return records_dir / f\"{stage}-{nn:02d}{INVOCATION_MARKER_SUFFIX}\"\n159\t\n160\t\n161\tdef write_invocation_marker(root: Path, records_dir: Path, stage: str, nn: int) -> Path:\n162\t    \"\"\"The fact that an invocation began, written before it does: at,\n163\t    host, pid, the sha it starts on, and the product that started it.\n164\t    Its record's arrival is what retires it; a marker with no record is\n165\t    an invocation that died or hangs, and proof five names it.\"\"\"\n166\t    import os\n167\t    import socket\n168\t    from datetime import datetime, timezone\n169\t    records_dir.mkdir(parents=True, exist_ok=True)\n170\t    path = invocation_marker_path(records_dir, stage, nn)\n171\t    sha = git(root, \"rev-parse\", \"HEAD\").strip()\n172\t    info = {\"at\": datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\"),\n173\t            \"host\": socket.gethostname(), \"pid\": os.getpid(), \"sha\": sha,\n174\t            \"product_version\": product_version()}\n175\t    path.write_text(json.dumps(info, indent=2) + \"\\n\")\n176\t    return path\n177\t\n178\t\n179\tdef invocation_alive(info: dict[str, Any]) -> bool:\n180\t    \"\"\"Whether the marker's pid is a live process on this host. Another\n181\t    host's pid is unknowable from here and reads as not alive: a drive\n182\t    that ran elsewhere and wrote no record is died by absence.\"\"\"\n183\t    import os\n184\t    import socket\n185\t    if info.get(\"host\") != socket.gethostname():\n186\t        return False\n187\t    pid = info.get(\"pid\")\n188\t    if not isinstance(pid, int) or isinstance(pid, bool) or pid <= 0:\n189\t        return False\n190\t    try:\n191\t        os.kill(pid, 0)\n192\t    except ProcessLookupError:\n193\t        return False\n194\t    except PermissionError:\n195\t        return True\n196\t    return True\n197\t\n198\t\n199\tdef invocation_age_s(info: dict[str, Any]) -> float | None:\n200\t    \"\"\"Seconds since the marker's own `at` timestamp -- how long ago the\n201\t    invocation it names began, whatever host wrote it. None when `at` is\n202\t    missing or does not parse.\"\"\"\n203\t    from datetime import datetime, timezone\n204\t    at = info.get(\"at\")\n205\t    if not isinstance(at, str):\n206\t        return None\n207\t    try:\n208\t        stamp = datetime.strptime(at, \"%Y-%m-%dT%H:%M:%SZ\").replace(tzinfo=timezone.utc)\n209\t    except ValueError:\n210\t        return None\n211\t    return (datetime.now(timezone.utc) - stamp).total_seconds()\n212\t\n213\t\n214\tdef invocations_without_record(item_records_dir: Path) -> list[tuple[Path, dict[str, Any]]]:\n215\t    \"\"\"Every <stage>-NN.started under one item whose <stage>-NN.json has\n216\t    not arrived, with the marker's own dict ({} when unreadable).\"\"\"\n217\t    out: list[tuple[Path, dict[str, Any]]] = []\n218\t    if not item_records_dir.is_dir():\n219\t        return out\n220\t    for marker in sorted(item_records_dir.glob(f\"*{INVOCATION_MARKER_SUFFIX}\")):\n221\t        if (item_records_dir / f\"{marker.stem}.json\").is_file():\n222\t            continue\n223\t        try:\n224\t            with marker.open() as fh:\n225\t                info = json.load(fh)\n226\t        except (OSError, ValueError):\n227\t            info = {}\n228\t        out.append((marker, info if isinstance(info, dict) else {}))\n229\t    return out\n230\t\n231\t\n232\tdef stall_bound_s(m: dict[str, Any]) -> int | None:\n233\t    \"\"\"[drive].stall_after_s: the tenant's own bound past which a live\n234\t    invocation with no new event is hung. A bound the tenant did not\n235\t    write is a forecast, so there is no default.\"\"\"\n236\t    bound = (m.get(\"drive\") or {}).get(\"stall_after_s\")\n237\t    if isinstance(bound, bool) or not isinstance(bound, (int, float)) or bound <= 0:\n238\t        return None\n239\t    return int(bound)\n240\t\n241\t\n242\tdef proof_no_invocation_lacks_record(root: Path, m: dict[str, Any] | None) -> Proof:\n243\t    import socket\n244\t    p = Proof(\"no-invocation-lacks-record\", \"no invocation lacks its record\")\n245\t    if m is None:\n246\t        return p.fail(f\"no {MANIFEST} at {root}; no records directory is declared\")\n247\t    records_rel = m.get(\"paths\", {}).get(\"records\", \"\")\n248\t    records_dir = root / records_rel\n249\t    if not records_dir.is_dir():\n250\t        return p.fail(f\"no records directory under {records_dir}\")\n251\t    bound = stall_bound_s(m)\n252\t    if bound is None:\n253\t        return p.fail(\"no [drive].stall_after_s in the manifest; a hung invocation cannot be \"\n254\t                      \"told from a running one\")\n255\t    this_host = socket.gethostname()\n256\t    recorded = 0\n257\t    running: list[str] = []\n258\t    in_flight: list[str] = []\n259\t    problems: list[str] = []\n260\t    for item_dir in sorted(d for d in records_dir.iterdir() if d.is_dir()):\n261\t        for marker in item_dir.glob(f\"*{INVOCATION_MARKER_SUFFIX}\"):\n262\t            if (item_dir / f\"{marker.stem}.json\").is_file():\n263\t                recorded += 1\n264\t        for marker, info in invocations_without_record(item_dir):\n265\t            name = f\"item {item_dir.name} {marker.stem}\"\n266\t            if invocation_alive(info):\n267\t                running.append(f\"{name} (pid {info.get('pid')} since {info.get('at')})\")\n268\t                continue\n269\t            # A marker from another host is not alive by invocation_alive's\n270\t            # own reckoning (its pid is unknowable from here) but is not\n271\t            # yet a failure either: an invocation younger than the tenant's\n272\t            # own stall bound may simply be running elsewhere, still\n273\t            # writing toward its own record.\n274\t            if info.get(\"host\") != this_host:\n275\t                age = invocation_age_s(info)\n276\t                if age is not None and age < bound:\n277\t                    in_flight.append(f\"{name} (host {info.get('host')} since {info.get('at')})\")\n278\t                    continue\n279\t            problems.append(f\"{name} started {info.get('at')} on {info.get('host')} \"\n280\t                            f\"pid {info.get('pid')} and never wrote its record\")\n281\t    if problems:\n282\t        return p.fail(\"; \".join(problems), unrecorded_invocations=len(problems),\n283\t                      running_invocations=running, in_flight=in_flight)\n284\t    return p.hold(f\"{recorded} invocation(s) recorded, {len(running)} running, \"\n285\t                  f\"{len(in_flight)} in flight elsewhere\",\n286\t                  unrecorded_invocations=0, running_invocations=running, in_flight=in_flight)\n287\t\n288\t\n289\tdef proof_one_item_every_stage(root: Path, m: dict[str, Any] | None) -> Proof:\n290\t    p = Proof(\"one-item-every-stage\", \"one item has traversed every stage\")\n291\t    if m is None:\n292\t        return p.fail(f\"no {MANIFEST} at {root}; no records directory is declared\")\n293\t    records_rel = m.get(\"paths\", {}).get(\"records\", \"\")\n294\t    records_dir = root / records_rel\n295\t    items = load_records(records_dir)\n296\t    if not items:\n297\t        return p.fail(f\"no work item under {records_dir.relative_to(root)}\")\n298\t    complete = [item for item, stages in items.items() if all(s in stages for s in STAGES)]\n299\t    if not complete:\n300\t        best = max(items.items(), key=lambda kv: len(kv[1]))"}]},"parent_tool_use_id":null,"session_id":"041a92ee-b14a-4832-b613-6f5a12b6a373","uuid":"15954f3b-b4e6-42bb-90d2-7926ac2cfe8e","timestamp":"2026-09-25T18:05:13.001Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-217/attavo/doctor.py","content":"from __future__ import annotations\n\nimport fnmatch\nimport json\nimport os\nimport re\nimport subprocess\nfrom pathlib import Path\nfrom typing import Any\n\nfrom attavo.attest import check_attest_chain, item_time_and_cost\nfrom attavo.common import (\n    MANIFEST,\n    Proof,\n    STAGES,\n    fixture_item_id,\n    git,\n    product_version,\n    read_manifest,\n)\nfrom attavo.records import RECORD_RE, load_records, parse_attempts\nfrom attavo.stops import STOP_CLASSES, STOP_PROVENANCES, STOP_STAGES, gate_stop\n\n# --- doctor's three proofs ---\n\ndef proof_every_gate_rejects(root: Path, m: dict[str, Any] | None) -> Proof:\n    p = Proof(\"every-gate-rejects\", \"every gate rejects its fixture\")\n    if m is None:\n        return p.fail(f\"no {MANIFEST} at {root}; no gate is registered\")\n    gates = m.get(\"gates\") or {}\n    if not gates:\n        return p.fail(\"[gates] is empty; a gate that has rejected nothing does not exist\")\n    fixtures = root / m.get(\"paths\", {}).get(\"rejections\", \"\")\n    # Proposal, not yet ruled on (issue #54): a gate that retires nothing\n    # only adds, so proof one reports it here rather than waiting on the\n    # schema alone -- read_manifest never validates against the manifest\n    # schema at runtime, so a schema requirement is not an enforced one.\n    no_retires = [name for name, gate in sorted(gates.items()) if not gate.get(\"retires\")]\n    missing, accepted = [], []\n    for name, gate in sorted(gates.items()):\n        fixture = fixtures / name\n        if not fixture.is_dir():\n            missing.append(name)\n            continue\n        env = dict(os.environ)\n        item = fixture_item_id(fixture)\n        if item is not None:\n            env[\"ATTAVO_ITEM\"] = item\n        run = subprocess.run(gate[\"command\"], shell=True, cwd=str(fixture),\n                             capture_output=True, text=True, check=False, env=env)\n        if run.returncode == 0:\n            accepted.append(name)\n    if missing:\n        return p.fail(f\"gate(s) with no rejection fixture: {', '.join(missing)}\")\n    if accepted:\n        return p.fail(f\"gate(s) that accepted their rejection fixture: {', '.join(accepted)}\")\n    if no_retires:\n        return p.fail(f\"gate(s) with no retires: {', '.join(no_retires)}\")\n    return p.hold(f\"{len(gates)} gate(s) rejected their fixture\")\n\n\ndef _merges_reachable(root: Path) -> tuple[list[dict[str, Any]], str | None]:\n    \"\"\"(merges, refusal): every merge commit on the default branch's own\n    first-parent line -- sha, parents, and its own first-parent diff --\n    read by one process rather than the git log plus one git diff per\n    merge merge_introducing_records used to pay walking toward the one\n    it wants (issue #153). refs/remotes/origin/HEAD names the default\n    branch without hard-coding \"main\", the same primitive\n    diff_since_approval already uses (issue #52); walking from it rather\n    than from HEAD is what keeps a transport merge on an item branch, a\n    pull_request checkout's own synthetic test merge, and a merge_group's\n    temporary merge from ever being mistaken for an item's merge (issue\n    #169) -- none of those is reachable from the default branch's first-\n    parent line by definition. When refs/remotes/origin/HEAD is not set,\n    this refuses by name rather than guess, exactly as diff_since_approval\n    does.\n\n    The walk starts at HEAD itself when the current checkout is literally\n    on the branch refs/remotes/origin/HEAD names (an ordinary checkout of\n    the default branch, on push or on a developer's own machine) and at\n    the remote-tracking ref's own value otherwise (any other branch, or\n    the detached HEAD a pull_request or merge_group checkout leaves\n    behind) -- HEAD only ever *is* the default branch's first-parent line\n    in the former case; in the latter, only the remote-tracking ref names\n    it. --diff-merges=first-parent gives each merge's diff against its\n    first parent in the same pass git log --merges already makes to list\n    them, in the same order, newest first.\"\"\"\n    symref = subprocess.run(\n        [\"git\", \"-C\", str(root), \"symbolic-ref\", \"-q\", \"refs/remotes/origin/HEAD\"],\n        capture_output=True, text=True, check=False)\n    if symref.returncode != 0:\n        return [], \"refs/remotes/origin/HEAD is not set; run `git remote set-head origin -a`\"\n    default_remote_ref = symref.stdout.strip()\n    default_branch = default_remote_ref.rsplit(\"/\", 1)[-1]\n    current_branch = subprocess.run(\n        [\"git\", \"-C\", str(root), \"symbolic-ref\", \"-q\", \"--short\", \"HEAD\"],\n        capture_output=True, text=True, check=False)\n    default_ref = (\"HEAD\" if current_branch.returncode == 0\n                   and current_branch.stdout.strip() == default_branch\n                   else default_remote_ref)\n    try:\n        out = git(root, \"log\", default_ref, \"--first-parent\", \"--merges\",\n                 \"--diff-merges=first-parent\", \"--name-only\",\n                 \"--format=\\x01%H\\x1f%P\")\n    except RuntimeError:\n        return [], None\n    merges = []\n    for block in out.split(\"\\x01\")[1:]:\n        header, _, rest = block.partition(\"\\n\")\n        sha, parents = header.split(\"\\x1f\")\n        merges.append({\"sha\": sha, \"parents\": parents.split(),\n                       \"touched\": [line for line in rest.splitlines() if line.strip()]})\n    return merges, None\n\n\ndef merge_introducing_records(root: Path, records_rel: str, item: str,\n                              stages: tuple[str, ...],\n                              merges: list[dict[str, Any]] | None = None) -> tuple[str | None, str | None]:\n    \"\"\"(merge_sha, refusal): the merge commit on the default branch's own\n    first-parent line whose first-parent diff introduces a record for\n    every one of stages, under records_rel/item/ -- the same derivation\n    attest itself uses (derive_attest_items), read here so proof two\n    requires an item's stage records to have arrived by an actual merge\n    on the default branch, not merely to sit in the tree, and not by a\n    transport merge, a pull_request checkout's synthetic test merge, or a\n    merge_group's temporary merge (issue #69 acceptance row 4; issue\n    #169). merge_sha is None with no refusal when no such merge exists\n    yet -- the item is not merged, not that the walk failed.\n\n    merges, when given, is _merges_reachable's own result -- ledger's\n    cmd_ledger computes it once and passes it to every item rather than\n    walking the default branch's merges again for each (issue #153); a\n    caller that already has merges has also already handled\n    _merges_reachable's refusal, so this never re-derives one. Left\n    None, a caller with just the one item to ask (doctor's proof two)\n    gets merges computed here, refusal and all.\"\"\"\n    if merges is None:\n        merges, refusal = _merges_reachable(root)\n        if refusal:\n            return None, refusal\n    prefix = f\"{records_rel.rstrip('/')}/{item}/\"\n    for merge in merges:\n        found: set[str] = set()\n        for p in merge[\"touched\"]:\n            if p.startswith(prefix):\n                m = RECORD_RE.match(Path(p).name)\n                if m:\n                    found.add(m.group(1))\n        if all(s in found for s in stages):\n            return merge[\"sha\"], None\n    return None, None\n\n\nINVOCATION_MARKER_SUFFIX = \".started\"\n\n\ndef invocation_marker_path(records_dir: Path, stage: str, nn: int) -> Path:\n    return records_dir / f\"{stage}-{nn:02d}{INVOCATION_MARKER_SUFFIX}\"\n\n\ndef write_invocation_marker(root: Path, records_dir: Path, stage: str, nn: int) -> Path:\n    \"\"\"The fact that an invocation began, written before it does: at,\n    host, pid, the sha it starts on, and the product that started it.\n    Its record's arrival is what retires it; a marker with no record is\n    an invocation that died or hangs, and proof five names it.\"\"\"\n    import os\n    import socket\n    from datetime import datetime, timezone\n    records_dir.mkdir(parents=True, exist_ok=True)\n    path = invocation_marker_path(records_dir, stage, nn)\n    sha = git(root, \"rev-parse\", \"HEAD\").strip()\n    info = {\"at\": datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\"),\n            \"host\": socket.gethostname(), \"pid\": os.getpid(), \"sha\": sha,\n            \"product_version\": product_version()}\n    path.write_text(json.dumps(info, indent=2) + \"\\n\")\n    return path\n\n\ndef invocation_alive(info: dict[str, Any]) -> bool:\n    \"\"\"Whether the marker's pid is a live process on this host. Another\n    host's pid is unknowable from here and reads as not alive: a drive\n    that ran elsewhere and wrote no record is died by absence.\"\"\"\n    import os\n    import socket\n    if info.get(\"host\") != socket.gethostname():\n        return False\n    pid = info.get(\"pid\")\n    if not isinstance(pid, int) or isinstance(pid, bool) or pid <= 0:\n        return False\n    try:\n        os.kill(pid, 0)\n    except ProcessLookupError:\n        return False\n    except PermissionError:\n        return True\n    return True\n\n\ndef invocation_age_s(info: dict[str, Any]) -> float | None:\n    \"\"\"Seconds since the marker's own `at` timestamp -- how long ago the\n    invocation it names began, whatever host wrote it. None when `at` is\n    missing or does not parse.\"\"\"\n    from datetime import datetime, timezone\n    at = info.get(\"at\")\n    if not isinstance(at, str):\n        return None\n    try:\n        stamp = datetime.strptime(at, \"%Y-%m-%dT%H:%M:%SZ\").replace(tzinfo=timezone.utc)\n    except ValueError:\n        return None\n    return (datetime.now(timezone.utc) - stamp).total_seconds()\n\n\ndef invocations_without_record(item_records_dir: Path) -> list[tuple[Path, dict[str, Any]]]:\n    \"\"\"Every <stage>-NN.started under one item whose <stage>-NN.json has\n    not arrived, with the marker's own dict ({} when unreadable).\"\"\"\n    out: list[tuple[Path, dict[str, Any]]] = []\n    if not item_records_dir.is_dir():\n        return out\n    for marker in sorted(item_records_dir.glob(f\"*{INVOCATION_MARKER_SUFFIX}\")):\n        if (item_records_dir / f\"{marker.stem}.json\").is_file():\n            continue\n        try:\n            with marker.open() as fh:\n                info = json.load(fh)\n        except (OSError, ValueError):\n            info = {}\n        out.append((marker, info if isinstance(info, dict) else {}))\n    return out\n\n\ndef stall_bound_s(m: dict[str, Any]) -> int | None:\n    \"\"\"[drive].stall_after_s: the tenant's own bound past which a live\n    invocation with no new event is hung. A bound the tenant did not\n    write is a forecast, so there is no default.\"\"\"\n    bound = (m.get(\"drive\") or {}).get(\"stall_after_s\")\n    if isinstance(bound, bool) or not isinstance(bound, (int, float)) or bound <= 0:\n        return None\n    return int(bound)\n\n\ndef proof_no_invocation_lacks_record(root: Path, m: dict[str, Any] | None) -> Proof:\n    import socket\n    p = Proof(\"no-invocation-lacks-record\", \"no invocation lacks its record\")\n    if m is None:\n        return p.fail(f\"no {MANIFEST} at {root}; no records directory is declared\")\n    records_rel = m.get(\"paths\", {}).get(\"records\", \"\")\n    records_dir = root / records_rel\n    if not records_dir.is_dir():\n        return p.fail(f\"no records directory under {records_dir}\")\n    bound = stall_bound_s(m)\n    if bound is None:\n        return p.fail(\"no [drive].stall_after_s in the manifest; a hung invocation cannot be \"\n                      \"told from a running one\")\n    this_host = socket.gethostname()\n    recorded = 0\n    running: list[str] = []\n    in_flight: list[str] = []\n    problems: list[str] = []\n    for item_dir in sorted(d for d in records_dir.iterdir() if d.is_dir()):\n        for marker in item_dir.glob(f\"*{INVOCATION_MARKER_SUFFIX}\"):\n            if (item_dir / f\"{marker.stem}.json\").is_file():\n                recorded += 1\n        for marker, info in invocations_without_record(item_dir):\n            name = f\"item {item_dir.name} {marker.stem}\"\n            if invocation_alive(info):\n                running.append(f\"{name} (pid {info.get('pid')} since {info.get('at')})\")\n                continue\n            # A marker from another host is not alive by invocation_alive's\n            # own reckoning (its pid is unknowable from here) but is not\n            # yet a failure either: an invocation younger than the tenant's\n            # own stall bound may simply be running elsewhere, still\n            # writing toward its own record.\n            if info.get(\"host\") != this_host:\n                age = invocation_age_s(info)\n                if age is not None and age < bound:\n                    in_flight.append(f\"{name} (host {info.get('host')} since {info.get('at')})\")\n                    continue\n            problems.append(f\"{name} started {info.get('at')} on {info.get('host')} \"\n                            f\"pid {info.get('pid')} and never wrote its record\")\n    if problems:\n        return p.fail(\"; \".join(problems), unrecorded_invocations=len(problems),\n                      running_invocations=running, in_flight=in_flight)\n    return p.hold(f\"{recorded} invocation(s) recorded, {len(running)} running, \"\n                  f\"{len(in_flight)} in flight elsewhere\",\n                  unrecorded_invocations=0, running_invocations=running, in_flight=in_flight)\n\n\ndef proof_one_item_every_stage(root: Path, m: dict[str, Any] | None) -> Proof:\n    p = Proof(\"one-item-every-stage\", \"one item has traversed every stage\")\n    if m is None:\n        return p.fail(f\"no {MANIFEST} at {root}; no records directory is declared\")\n    records_rel = m.get(\"paths\", {}).get(\"records\", \"\")\n    records_dir = root / records_rel\n    items = load_records(records_dir)\n    if not items:\n        return p.fail(f\"no work item under {records_dir.relative_to(root)}\")\n    complete = [item for item, stages in items.items() if all(s in stages for s in STAGES)]\n    if not complete:\n        best = max(items.items(), key=lambda kv: len(kv[1]))","numLines":300,"startLine":1,"totalLines":801}}}

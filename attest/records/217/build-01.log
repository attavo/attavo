{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DpFqCtkGoihrFhDWG4ayW9","type":"tool_result","content":"1\tfrom __future__ import annotations\n2\t\n3\timport io\n4\timport json\n5\timport os\n6\timport signal\n7\timport subprocess\n8\timport sys\n9\timport threading\n10\timport time\n11\tfrom pathlib import Path\n12\tfrom typing import TYPE_CHECKING, Any, NamedTuple, cast\n13\t\n14\tfrom attavo.approval import approval_status\n15\tfrom attavo.build import cmd_build, driver_identity\n16\tfrom attavo.common import MANIFEST, PRODUCT_ROOT, derive_item_id, git, read_manifest\n17\tfrom attavo.counsel import cmd_counsel\n18\tfrom attavo.doctor import (\n19\t    _parse_json_line,\n20\t    invocation_alive,\n21\t    invocations_without_record,\n22\t    stall_bound_s,\n23\t    write_invocation_marker,\n24\t)\n25\tfrom attavo.events import stage_events_dir\n26\tfrom attavo.filing import cmd_file_stops\n27\tfrom attavo.records import (\n28\t    latest_attempt_path,\n29\t    latest_record,\n30\t    next_attempt_number,\n31\t    stage_schema,\n32\t    write_record,\n33\t)\n34\tfrom attavo.verify import cmd_verify, read_forge_checks\n35\t\n36\tif TYPE_CHECKING:\n37\t    from attavo.types import DriveReport\n38\t\n39\t# --- drive: the mechanical transitions between approval and ready-to-merge\n40\t# (issue #84), under the reconciler's R2 (rulings A, B, C's recovery half,\n41\t# F, G, H): `attavo drive N` is one short pass. It reads the report\n42\t# (attavo.report), acts at most once -- recovers a dead or hung\n43\t# invocation, or starts the next stage in a detached worker -- and\n44\t# returns within seconds; the stage itself runs in `attavo worker`, a\n45\t# child of the pass's own session, which outlives it. Writes no record of\n46\t# its own: the stage records already on disk, and the invocation markers\n47\t# and heartbeats beside them, are the only state a pass or a worker\n48\t# reads. ---\n49\t\n50\t\n51\tdef commit_record(root: Path, record_paths: Path | list[Path], message: str) -> None:\n52\t    \"\"\"`git commit --only` on every record path given, and each one's .log\n53\t    and .filed, each if one exists -- never the whole index. A transport\n54\t    commit that sweeps the index is exactly the regression issue #46\n55\t    already guards build and verify against on the adapter side; drive\n56\t    must not reintroduce it on the transport side. The .filed marker\n57\t    (issue #89) is committed alongside the record it names, in the same\n58\t    commit and the same push, so a second worktree or a fresh clone reads\n59\t    the same filed fact rather than refiling every stop it finds with no\n60\t    marker of its own. A single Path is accepted for the common one-record\n61\t    case; issue #100 passes a list so the counsel record lands in the same\n62\t    commit as the stage record it counsels. Authored and committed as\n63\t    driver_identity(), set by the product and never the tenant's git\n64\t    config, so a driven item's record commits are never indistinguishable\n65\t    from an operator's own.\"\"\"\n66\t    if isinstance(record_paths, Path):\n67\t        record_paths = [record_paths]\n68\t    paths: list[str] = []\n69\t    for record_path in record_paths:\n70\t        paths.append(str(record_path.relative_to(root)))\n71\t        log_path = record_path.with_suffix(\".log\")\n72\t        if log_path.is_file():\n73\t            paths.append(str(log_path.relative_to(root)))\n74\t        marker_path = record_path.with_suffix(\".filed\")\n75\t        if marker_path.is_file():\n76\t            paths.append(str(marker_path.relative_to(root)))\n77\t    identity = driver_identity()\n78\t    env = dict(os.environ)\n79\t    env[\"GIT_AUTHOR_NAME\"] = identity[\"name\"]\n80\t    env[\"GIT_AUTHOR_EMAIL\"] = identity[\"email\"]\n81\t    env[\"GIT_COMMITTER_NAME\"] = identity[\"name\"]\n82\t    env[\"GIT_COMMITTER_EMAIL\"] = identity[\"email\"]\n83\t    git(root, \"add\", *paths)\n84\t    git(root, \"commit\", \"--only\", \"-m\", message, *paths, env=env)\n85\t\n86\t\n87\tdef push_record_commit(root: Path, branch: str) -> tuple[bool, str | None]:\n88\t    \"\"\"Push HEAD to branch on origin. A push a divergent remote rejects is\n89\t    retried once after `git pull --no-rebase --no-edit origin branch` -- a\n90\t    merge, never a rebase, because a rebase would change the sha the record\n91\t    commit just wrote already names. This is the record push's own retry\n92\t    -- the worker's, once it has the lease -- distinct from push_lease\n93\t    below, which never retries.\"\"\"\n94\t    def attempt() -> tuple[bool, str]:\n95\t        run = subprocess.run([\"git\", \"-C\", str(root), \"push\", \"origin\", f\"HEAD:{branch}\"],\n96\t                             capture_output=True, text=True, check=False)\n97\t        return run.returncode == 0, run.stderr.strip()\n98\t\n99\t    ok, err = attempt()\n100\t    if ok:\n101\t        return True, None\n102\t    pull = subprocess.run([\"git\", \"-C\", str(root), \"pull\", \"--no-rebase\", \"--no-edit\",\n103\t                           \"origin\", branch], capture_output=True, text=True, check=False)\n104\t    if pull.returncode != 0:\n105\t        return False, f\"push rejected and the retry merge failed: {pull.stderr.strip() or err}\"\n106\t    ok, err = attempt()\n107\t    if not ok:\n108\t        return False, f\"push rejected again after merging {branch}: {err}\"\n109\t    return True, None\n110\t\n111\t\n112\t_RACE_MARKERS = (\"non-fast-forward\", \"fetch first\", \"stale info\", \"cannot lock ref\",\n113\t                 \"failed to update ref\")\n114\t\n115\t\n116\tdef push_lease(root: Path, branch: str) -> tuple[str, str | None]:\n117\t    \"\"\"Push HEAD to branch on origin as a plain fast-forward -- no merge,\n118\t    no retry: this is the lease the marker commit takes on the attempt it\n119\t    names (ruling A). (\"pushed\", None) on success.\n120\t\n121\t    (\"lost-race\", stderr) when git's own ref check is what rejected it --\n122\t    the branch moved since this pass fast-forwarded to it (a sequential\n123\t    \"[rejected] ... (fetch first)\"), or the remote's own ref transaction\n124\t    lost a genuine simultaneous push (\"[remote rejected] ... (failed to\n125\t    update ref)\", \"cannot lock ref\"): either way, another pass's own\n126\t    marker (or record) landed there first. The pass that reads this is\n127\t    the loser: it says so, resets its own marker commit, and starts\n128\t    nothing.\n129\t\n130\t    (\"refused\", stderr) for every other rejection -- a remote that\n131\t    refuses the push outright (a hook, a permission, an unreachable\n132\t    remote). This is not a race for the lease; it is a refusal, and ends\n133\t    the pass with exit 1.\"\"\"\n134\t    run = subprocess.run([\"git\", \"-C\", str(root), \"push\", \"origin\", f\"HEAD:{branch}\"],\n135\t                         capture_output=True, text=True, check=False)\n136\t    if run.returncode == 0:\n137\t        return \"pushed\", None\n138\t    stderr = run.stderr\n139\t    if any(marker in stderr for marker in _RACE_MARKERS):\n140\t        return \"lost-race\", stderr.strip()\n141\t    return \"refused\", stderr.strip()\n142\t\n143\t\n144\tdef has_origin(root: Path) -> bool:\n145\t    \"\"\"Whether this checkout carries an origin remote at all -- a fixture\n146\t    or a scratch checkout with none is not a refusal; a pass commits\n147\t    locally and skips the push, the way recovery always has.\"\"\"\n148\t    try:\n149\t        git(root, \"remote\", \"get-url\", \"origin\")\n150\t        return True\n151\t    except RuntimeError:\n152\t        return False\n153\t\n154\t\n155\tdef drive_state(root: Path, m: dict[str, Any], item_id: str) -> tuple[str, str | None, Path]:\n156\t    \"\"\"(\"no-approval\" | \"build\" | \"verify\" | \"ready\", detail, records_dir):\n157\t    the next mechanical step for item_id, read from its latest records\n158\t    alone. A build only counts as current when it is a pass bound to the\n159\t    valid approval's own sha; a verify only counts as current when it is a\n160\t    pass bound to that build's own sha -- the same staleness a re-approval\n161\t    or a re-build must force, attest's own chain check already enforces\n162\t    (check_attest_chain), read here rather than re-typed.\"\"\"\n163\t    records_rel = m[\"paths\"][\"records\"]\n164\t    records_dir = root / records_rel / item_id\n165\t\n166\t    status = approval_status(root, m, item_id)\n167\t    if status != \"valid\":\n168\t        return \"no-approval\", status, records_dir\n169\t\n170\t    latest_approval = latest_record(records_dir, \"approval\")\n171\t    latest_build = latest_record(records_dir, \"build\")\n172\t    build_current = (latest_build is not None and latest_build.get(\"status\") == \"pass\"\n173\t                     and latest_build.get(\"approval_sha\")\n174\t                     == (latest_approval.get(\"sha\") if latest_approval else None))\n175\t    if latest_build is None or not build_current:\n176\t        return \"build\", None, records_dir\n177\t\n178\t    latest_verify = latest_record(records_dir, \"verify\")\n179\t    verify_current = (latest_verify is not None and latest_verify.get(\"status\") == \"pass\"\n180\t                      and latest_verify.get(\"build_sha\") == latest_build.get(\"sha\"))\n181\t    if not verify_current:\n182\t        return \"verify\", None, records_dir\n183\t\n184\t    return \"ready\", None, records_dir\n185\t\n186\t\n187\t# --- the heartbeat, the worker log, and the forge-checks handoff: local\n188\t# facts under the checkout's own git directory (issue #140's precedent),\n189\t# never committed and never among the paths commit_record ever names. ---\n190\t\n191\tdef heartbeat_s() -> float:\n192\t    return float(os.environ.get(\"ATTAVO_HEARTBEAT_S\", 15))\n193\t\n194\t\n195\tdef heartbeat_path(root: Path, stage: str, nn: int) -> Path:\n196\t    return stage_events_dir(root) / f\"{stage}-{nn:02d}.heartbeat\"\n197\t\n198\t\n199\tdef worker_log_path(root: Path, stage: str, nn: int) -> Path:\n200\t    return stage_events_dir(root) / f\"{stage}-{nn:02d}.worker.log\"\n201\t\n202\t\n203\tdef forge_checks_path(root: Path, stage: str, nn: int) -> Path:\n204\t    return stage_events_dir(root) / f\"{stage}-{nn:02d}.forge-checks.json\"\n205\t\n206\t\n207\tdef _events_path_for(root: Path, stage: str, nn: int) -> Path | None:\n208\t    \"\"\"The adapter's own events file for this invocation, under the\n209\t    checkout's git dir (a worktree's own dir when the checkout is one).\"\"\"\n210\t    try:\n211\t        gitdir = Path(git(root, \"rev-parse\", \"--git-dir\").strip())\n212\t    except RuntimeError:\n213\t        return None\n214\t    if not gitdir.is_absolute():\n215\t        gitdir = root / gitdir\n216\t    path = gitdir / \"attavo\" / f\"{stage}-{nn:02d}.events.jsonl\"\n217\t    return path if path.is_file() else None\n218\t\n219\t\n220\tdef _events_tail(path: Path | None, lines: int = 20) -> tuple[str, str | None]:\n221\t    \"\"\"(the last lines as a log, the last event's own at).\"\"\"\n222\t    if path is None:\n223\t        return \"no events file for this invocation\\n\", None\n224\t    try:\n225\t        text = path.read_text()\n226\t    except OSError:\n227\t        return \"events file unreadable\\n\", None\n228\t    tail = text.splitlines()[-lines:]\n229\t    last_at = None\n230\t    for line in reversed(tail):\n231\t        parsed = _parse_json_line(line)\n232\t        if not isinstance(parsed, dict):\n233\t            continue\n234\t        at = parsed.get(\"at\")\n235\t        if isinstance(at, str):\n236\t            last_at = at\n237\t            break\n238\t    return \"\\n\".join(tail) + \"\\n\", last_at\n239\t\n240\t\n241\tdef _seconds_since(at: str | None) -> float | None:\n242\t    from datetime import datetime, timezone\n243\t    if not at:\n244\t        return None\n245\t    try:\n246\t        then = datetime.strptime(at, \"%Y-%m-%dT%H:%M:%SZ\").replace(tzinfo=timezone.utc)\n247\t    except ValueError:\n248\t        return None\n249\t    return (datetime.now(timezone.utc) - then).total_seconds()\n250\t\n251\t\n252\tclass InvocationReading(NamedTuple):\n253\t    \"\"\"What one marker with no record reads as, from here and now.\"\"\"\n254\t    stage: str\n255\t    nn: int\n256\t    log: str\n257\t    last_at: str | None\n258\t    age: float | None\n259\t    cls: str  # \"running\" | \"hung\" | \"died\"\n260\t\n261\t\n262\tdef read_invocation(root: Path, bound: int | None, marker: Path, info: dict[str, Any]) -> InvocationReading:\n263\t    \"\"\"Whether an invocation that began and wrote no record is running,\n264\t    hung, or died -- read from its own heartbeat first (R2): a heartbeat\n265\t    file fresh within three beats of ATTAVO_HEARTBEAT_S is alive; a stale\n266\t    one is died, whether or not the pid still lives -- a worker stuck\n267\t    somewhere that never reaches its own heartbeat loop again is exactly\n268\t    what this is for. Only with no heartbeat file at all -- an invocation\n269\t    from before this release, or one that died before touching its\n270\t    first beat -- does this fall back to the pid: alive and, with a\n271\t    stall bound declared, past it is hung; alive with no bound, or\n272\t    within it, is running for as long as it lives; not alive is died.\n273\t    The stall bound decides hung, never died.\"\"\"\n274\t    stage, nn_text = marker.stem.rsplit(\"-\", 1)\n275\t    nn = int(nn_text)\n276\t    log, last_at = _events_tail(_events_path_for(root, stage, nn))\n277\t    beat = heartbeat_path(root, stage, nn)\n278\t    if beat.is_file():\n279\t        try:\n280\t            beat_age = time.time() - beat.stat().st_mtime\n281\t        except OSError:\n282\t            beat_age = None\n283\t        cls = \"running\" if beat_age is not None and beat_age <= heartbeat_s() * 3 else \"died\"\n284\t        return InvocationReading(stage, nn, log, last_at, beat_age, cls)\n285\t    age = _seconds_since(last_at or info.get(\"at\"))\n286\t    if not invocation_alive(info):\n287\t        return InvocationReading(stage, nn, log, last_at, age, \"died\")\n288\t    if bound is None or age is None or age <= bound:\n289\t        return InvocationReading(stage, nn, log, last_at, age, \"running\")\n290\t    return InvocationReading(stage, nn, log, last_at, age, \"hung\")\n291\t\n292\t\n293\tdef uncommitted_record(root: Path, records_dir: Path, stage: str) -> Path | None:\n294\t    \"\"\"The latest <stage>-NN.json this working tree carries that git has\n295\t    no commit for yet -- the moment between a worker's write and its own\n296\t    commit. None when the latest record is already committed, or there\n297\t    is none at all.\"\"\"\n298\t    path = latest_attempt_path(records_dir, stage)\n299\t    if path is None or not path.is_file():\n300\t        return None\n301\t    status = subprocess.run(\n302\t        [\"git\", \"-C\", str(root), \"status\", \"--porcelain\", \"--\", str(path.relative_to(root))],\n303\t        capture_output=True, text=True, check=False)\n304\t    return path if status.stdout.strip() else None\n305\t\n306\t\n307\tdef worker_holds_copy(root: Path, records_dir: Path) -> bool:\n308\t    \"\"\"True when this checkout's own working tree cannot safely be moved\n309\t    -- an invocation marker with no record yet (a worker, here or\n310\t    elsewhere, still holds this attempt), or a build or verify record the\n311\t    working tree carries that git has not committed yet. Scoped to the\n312\t    stage records a pass or a worker itself ever transports -- an\n313\t    operator's own spec-gate or approve, routinely uncommitted between\n314\t    their own act and the next pass, is not this. A pass never\n315\t    fast-forwards while this holds (never while a worker holds the\n316\t    copy).\"\"\"\n317\t    if invocations_without_record(records_dir):\n318\t        return True\n319\t    return (uncommitted_record(root, records_dir, \"build\") is not None\n320\t           or uncommitted_record(root, records_dir, \"verify\") is not None)\n321\t\n322\t\n323\tdef fast_forward_to_origin(root: Path, m: dict[str, Any], item_id: str) -> None:\n324\t    \"\"\"The pass's own read of origin's branch, taken before it reads\n325\t    anything else -- a commit landed there from elsewhere (an approval\n326\t    from the screen, a ruling, another pass's own record) is not a race\n327\t    for the lease, it is exactly what the lease is for. Never while a\n328\t    worker holds this copy (worker_holds_copy): resetting a working tree\n329\t    a detached child is still writing into would corrupt its own commits.\n330\t    A plain fast-forward when origin is simply ahead; when this checkout\n331\t    also carries its own commits origin has not seen yet (an operator's\n332\t    approval, not yet pushed), those are replayed on top of origin's own\n333\t    tip instead -- no merge commit, and the marker this pass is about to\n334\t    write still lands as a fast-forward when it pushes. Silent about\n335\t    everything short of that -- a real conflict, or an absent origin, is\n336\t    left for the ordinary read (and the marker push, for the lease) to\n337\t    sort out.\"\"\"\n338\t    records_dir = root / m[\"paths\"][\"records\"] / item_id\n339\t    if worker_holds_copy(root, records_dir) or not has_origin(root):\n340\t        return\n341\t    try:\n342\t        branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n343\t        git(root, \"fetch\", \"origin\", branch)\n344\t    except RuntimeError:\n345\t        return\n346\t    try:\n347\t        git(root, \"merge\", \"--ff-only\", \"FETCH_HEAD\")\n348\t        return\n349\t    except RuntimeError:\n350\t        pass\n351\t    try:\n352\t        git(root, \"rebase\", \"FETCH_HEAD\")\n353\t    except RuntimeError:\n354\t        subprocess.run([\"git\", \"-C\", str(root), \"rebase\", \"--abort\"],\n355\t                       capture_output=True, text=True, check=False)\n356\t\n357\t\n358\t# --- the worker: a detached child of the pass's own session, running the\n359\t# stage exactly as the pass used to inline, touching its own heartbeat\n360\t# while it does (R2). ---\n361\t\n362\tdef _stage_body(item_id: str, stage: str, nn: int) -> int:\n363\t    \"\"\"Runs build or verify in-process -- the same command `attavo build`\n364\t    or `attavo verify` would run -- while touching heartbeat_path every\n365\t    heartbeat_s() seconds, then transports whatever it wrote: counsel and\n366\t    file-stops on a non-pass record (issue #100, #89), one `git commit\n367\t    --only`, one push with the record push's own merge retry. The\n368\t    marker is the pass's, already committed and pushed before this\n369\t    starts; this writes and transports only the stage's own record (and,\n370\t    on a stop, its counsel record).\"\"\"\n371\t    root = Path(\".\").resolve()\n372\t    m = read_manifest(root)\n373\t    if m is None:\n374\t        return 2\n375\t    records_dir = root / m[\"paths\"][\"records\"] / item_id\n376\t    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n377\t    before = latest_attempt_path(records_dir, stage)\n378\t\n379\t    beat = heartbeat_path(root, stage, nn)\n380\t    beat.parent.mkdir(parents=True, exist_ok=True)\n381\t    beat.touch()\n382\t    stop_beat = threading.Event()\n383\t\n384\t    def _tick() -> None:\n385\t        while not stop_beat.wait(heartbeat_s()):\n386\t            beat.touch()\n387\t\n388\t    beat_thread = threading.Thread(target=_tick, daemon=True)\n389\t    beat_thread.start()\n390\t    try:\n391\t        rc = cmd_build([item_id]) if stage == \"build\" else cmd_verify([item_id])\n392\t    finally:\n393\t        stop_beat.set()\n394\t        beat_thread.join()\n395\t\n396\t    after = latest_attempt_path(records_dir, stage)\n397\t    if after is None or after == before:\n398\t        # Refused before writing anything at all (e.g. no adapter\n399\t        # configured) -- the stage command already printed why.\n400\t        return rc if rc != 0 else 1\n401\t\n402\t    record = cast(dict[str, Any], latest_record(records_dir, stage))\n403\t    status_out = record.get(\"status\")\n404\t    to_commit = [after]\n405\t    if status_out != \"pass\":\n406\t        counsel_before = latest_attempt_path(records_dir, \"counsel\")\n407\t        cmd_counsel([item_id])\n408\t        counsel_after = latest_attempt_path(records_dir, \"counsel\")\n409\t        if counsel_after is not None and counsel_after != counsel_before:\n410\t            to_commit.append(counsel_after)\n411\t        # file-stops is its own idempotent read of the item's records, so\n412\t        # calling it here on every run that wrote a non-pass record is\n413\t        # safe to call again on a later run: an already-filed stop's own\n414\t        # marker is what stops it from being filed twice.\n415\t        cmd_file_stops([item_id])\n416\t\n417\t    message = f\"attavo: {stage} record for item {item_id} ({after.stem})\"\n418\t    try:\n419\t        commit_record(root, to_commit, message)\n420\t    except RuntimeError as exc:\n421\t        print(f\"attavo drive: stopped: could not commit the {stage} record: {exc}\")\n422\t        return 1\n423\t\n424\t    if has_origin(root):\n425\t        ok, err = push_record_commit(root, branch)\n426\t        if not ok:\n427\t            print(f\"attavo drive: stopped: could not push the {stage} record: {err}\")\n428\t            return 1\n429\t    else:\n430\t        print(f\"attavo drive: note: no origin remote; {after.name} is committed, not pushed\")\n431\t\n432\t    if status_out == \"halted\":\n433\t        question = (record.get(\"halted\") or {}).get(\"question\")\n434\t        print(f\"attavo drive: stopped: {stage} halted: {question} ({after.name}); \"\n435\t              f\"pushed to {branch}\")\n436\t    elif status_out != \"pass\":\n437\t        reason = record.get(\"refusal\") or status_out\n438\t        print(f\"attavo drive: stopped: {stage} {status_out}: {reason} ({after.name}); \"\n439\t              f\"pushed to {branch}\")\n440\t    else:\n441\t        print(f\"attavo drive: pushed {after.name} to {branch}\")\n442\t    return rc\n443\t\n444\t\n445\tdef cmd_worker(argv: list[str]) -> int:\n446\t    \"\"\"`attavo worker N <build|verify> NN`: the detached child a pass\n447\t    starts once its marker is pushed -- the lease held, the attempt is\n448\t    this worker's to run. Its own session (start_new_session, set by the\n449\t    pass that spawns it); its stdout and stderr are the pass's own\n450\t    redirect, to <git-dir>/attavo/<stage>-NN.worker.log.\"\"\"\n451\t    cast(io.TextIOWrapper, sys.stdout).reconfigure(line_buffering=True)\n452\t    if len(argv) != 3:\n453\t        print(\"attavo worker: usage: attavo worker N <build|verify> NN\", file=sys.stderr)\n454\t        return 2\n455\t    item_id, stage, nn_text = argv\n456\t    if stage not in (\"build\", \"verify\"):\n457\t        print(f\"attavo worker: {stage!r} is not build or verify\", file=sys.stderr)\n458\t        return 2\n459\t    try:\n460\t        nn = int(nn_text)\n461\t    except ValueError:\n462\t        print(f\"attavo worker: {nn_text!r} is not an attempt number\", file=sys.stderr)\n463\t        return 2\n464\t    return _stage_body(item_id, stage, nn)\n465\t\n466\t\n467\t# --- the pass's own two acts: start a stage (the lease), and recover\n468\t# exactly the one invocation the report names owed one. ---\n469\t\n470\tdef _start_stage(root: Path, m: dict[str, Any], item_id: str, stage: str,\n471\t                 forge_checks: dict[str, Any] | None) -> int:\n472\t    \"\"\"The lease (ruling A): the marker, committed and pushed as a plain\n473\t    fast-forward with no merge and no retry (push_lease). Lost to another\n474\t    pass, or refused outright by the remote, both undo the marker commit\n475\t    here (git reset --hard) so this checkout carries no half-taken\n476\t    attempt either way; only a pushed lease starts the worker. On a\n477\t    review, forge_checks is the checks this same pass already read on\n478\t    the pre-marker head (ruling B) -- written to\n479\t    <git-dir>/attavo/verify-NN.forge-checks.json and named in\n480\t    ATTAVO_FORGE_CHECKS, so the worker's own `attavo verify` reads it\n481\t    instead of polling.\"\"\"\n482\t    records_dir = root / m[\"paths\"][\"records\"] / item_id\n483\t    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n484\t    nn = next_attempt_number(records_dir, stage)\n485\t    marker = write_invocation_marker(root, records_dir, stage, nn)\n486\t    try:\n487\t        commit_record(root, [marker], f\"attavo: {stage} invocation {nn:02d} started for item {item_id}\")\n488\t    except RuntimeError as exc:\n489\t        print(f\"attavo drive: stopped: could not commit the {stage} invocation marker: {exc}\")\n490\t        return 1\n491\t\n492\t    if has_origin(root):\n493\t        outcome, err = push_lease(root, branch)\n494\t        if outcome != \"pushed\":\n495\t            git(root, \"reset\", \"--hard\", \"HEAD^\")\n496\t            if outcome == \"lost-race\":\n497\t                print(f\"attavo drive: another pass holds this attempt ({marker.name}); nothing started\")\n498\t                return 0\n499\t            print(f\"attavo drive: stopped: could not push the {stage} invocation marker: {err}\")\n500\t            return 1\n501\t\n502\t    env = dict(os.environ)\n503\t    if forge_checks is not None:\n504\t        checks_file = forge_checks_path(root, stage, nn)\n505\t        checks_file.write_text(json.dumps(forge_checks))\n506\t        env[\"ATTAVO_FORGE_CHECKS\"] = str(checks_file)\n507\t    log = worker_log_path(root, stage, nn)\n508\t    with log.open(\"ab\") as fh, open(os.devnull, \"rb\") as devnull:\n509\t        proc = subprocess.Popen(\n510\t            [sys.executable, str(PRODUCT_ROOT / \"bin\" / \"attavo\"), \"worker\", item_id, stage, f\"{nn:02d}\"],\n511\t            cwd=str(root), env=env, stdin=devnull, stdout=fh, stderr=subprocess.STDOUT,\n512\t            start_new_session=True)\n513\t    word = \"Build\" if stage == \"build\" else \"Review\"\n514\t    print(f\"attavo drive: {word} started (attempt {nn:02d}, worker pid {proc.pid})\")\n515\t    return 0\n516\t\n517\t\n518\tdef _recover_one(root: Path, m: dict[str, Any], item_id: str, records_dir: Path) -> int:\n519\t    \"\"\"The pass's own recovery act (what `--recover` did): exactly the one\n520\t    invocation the report just read as owing one -- died or hung -- ends\n521\t    here. class died when the heartbeat is stale (or absent and the pid\n522\t    is gone), class hung when there is no heartbeat, the pid lives, and a\n523\t    declared [drive].stall_after_s has passed with no newer event, and\n524\t    terminated. Provenance product; the events tail as the log. Committed\n525\t    and pushed the way any stage record is (push_record_commit, with its\n526\t    own merge retry) -- this is not a race for a lease, since no new\n527\t    attempt marker is written.\"\"\"\n528\t    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n529\t    bound = stall_bound_s(m)\n530\t    pending = invocations_without_record(records_dir)\n531\t    readings = [(marker, info, read_invocation(root, bound, marker, info)) for marker, info in pending]\n532\t    candidate = next(((mk, i, rd) for mk, i, rd in readings if rd.cls != \"running\"), None)\n533\t    if candidate is None:\n534\t        # The report read this a moment ago; nothing owed recovery by the\n535\t        # time this pass got here (another pass recovered it, or it\n536\t        # finished on its own).\n537\t        return 0\n538\t    marker, info, reading = candidate\n539\t    stage, nn, log, last_at, age, cls = reading\n540\t    pid, host = info.get(\"pid\"), info.get(\"host\")\n541\t\n542\t    if next_attempt_number(records_dir, stage) != nn:\n543\t        print(f\"attavo drive: stopped: {marker.name} names attempt {nn} but the next \"\n544\t              f\"{stage} record would be {next_attempt_number(records_dir, stage):02d}; \"\n545\t              f\"a later record already exists, read the records before recovering\")\n546\t        return 1\n547\t\n548\t    if cls == \"hung\":\n549\t        try:\n550\t            os.kill(cast(int, pid), signal.SIGTERM)\n551\t            ended = \"terminated\"\n552\t        except OSError as exc:\n553\t            ended = f\"not terminated ({exc})\"\n554\t        detail = (f\"pid {pid} on {host} alive with no event for {int(cast(float, age))} s \"\n555\t                  f\"(bound {bound} s); {ended}\")\n556\t    else:\n557\t        detail = (f\"pid {pid} on {host} is not running and wrote no {marker.stem}.json; \"\n558\t                  f\"started {info.get('at')}, last event {last_at or 'none'}\")\n559\t\n560\t    schema = stage_schema(stage)\n561\t    record: dict[str, Any] = {k: None for k in schema.get(\"required\", [])}\n562\t    approval = latest_record(records_dir, \"approval\")\n563\t    record.update({\"sha\": info.get(\"sha\"), \"start_sha\": info.get(\"sha\"),\n564\t                   \"approval_sha\": approval.get(\"sha\") if approval else None,\n565\t                   \"at\": info.get(\"at\"),\n566\t                   \"adapter\": (m.get(\"executor\") or {}).get(stage),\n567\t                   \"status\": \"failed\", \"refusal\": None, \"halted\": None,\n568\t                   \"stop\": {\"class\": cls, \"provenance\": \"product\", \"detail\": detail}})\n569\t    if \"wall_clock_s\" in record:\n570\t        record[\"wall_clock_s\"] = None if age is None else int(age)\n571\t    record = {k: v for k, v in record.items() if k in schema.get(\"properties\", {})}\n572\t    try:\n573\t        path = write_record(records_dir, stage, record, m, item_id, log=log)\n574\t    except ValueError as exc:\n575\t        print(f\"attavo drive: stopped: could not write the {cls} record for {marker.stem}: {exc}\")\n576\t        return 1\n577\t    try:\n578\t        commit_record(root, [path], f\"attavo: {stage} record for item {item_id} \"\n579\t                                    f\"({path.stem}), recovered as {cls}\")\n580\t    except RuntimeError as exc:\n581\t        print(f\"attavo drive: stopped: could not commit the {cls} record: {exc}\")\n582\t        return 1\n583\t    if has_origin(root):\n584\t        ok, err = push_record_commit(root, branch)\n585\t        if not ok:\n586\t            print(f\"attavo drive: stopped: could not push the {cls} record: {err}\")\n587\t            return 1\n588\t    else:\n589\t        print(f\"attavo drive: note: no origin remote; {path.name} is committed, not pushed\")\n590\t    print(f\"attavo drive: recovered {marker.stem} as {cls}: {detail}\")\n591\t    return 0\n592\t\n593\t\n594\tdef _advance_again(root: Path, m: dict[str, Any], item_id: str, stage: str, head: str | None) -> int:\n595\t    \"\"\"`--again`'s own act on a stopped stage: exactly what next-build or\n596\t    next-review would do, bypassing the level a plain pass leaves alone\n597\t    for the operator. A review reads the forge fresh here -- once, since\n598\t    the report's own stopped reading never touched it -- rather than\n599\t    reusing a read that was never taken.\"\"\"\n600\t    if stage == \"build\":\n601\t        return _start_stage(root, m, item_id, \"build\", None)\n602\t    checks_command = (m.get(\"forge\") or {}).get(\"checks_command\")\n603\t    if not checks_command:\n604\t        print(\"attavo drive: refused: no [forge].checks_command in the manifest\")\n605\t        return 1\n606\t    forge_checks, ok = read_forge_checks(root, checks_command, cast(str, head))\n607\t    if not ok:\n608\t        conclusions = forge_checks[\"conclusions\"]\n609\t        named = \", \".join(f\"{c['name']} {c['conclusion']}\" for c in conclusions) or \"no checks reported\"\n610\t        print(f\"attavo drive: forge checks not green on {cast(str, head)[:12]}: {named}\")\n611\t        return 0\n612\t    return _start_stage(root, m, item_id, \"verify\", forge_checks)\n613\t\n614\t\n615\tdef _pass_once(root: Path, m: dict[str, Any], item_id: str, again: bool) -> tuple[int, \"DriveReport\"]:\n616\t    \"\"\"One pass: fast-forward to origin (never while a worker holds the\n617\t    copy), read the report, act at most once, return. The three acts,\n618\t    one per report state that is the product's move: owes-recovery\n619\t    recovers; next-build and next-review start their stage, handing a\n620\t    review the checks the report already read once on the pre-marker\n621\t    head. --again starts the next attempt of a stopped stage. Every\n622\t    other level is printed in the report's own words and left.\"\"\"\n623\t    from attavo.report import drive_report\n624\t    fast_forward_to_origin(root, m, item_id)\n625\t    r = drive_report(root, m, item_id)\n626\t\n627\t    if r[\"state\"] == \"owes-recovery\":\n628\t        records_dir = root / m[\"paths\"][\"records\"] / item_id\n629\t        return _recover_one(root, m, item_id, records_dir), r\n630\t    if r[\"state\"] == \"next-build\":\n631\t        return _start_stage(root, m, item_id, \"build\", None), r\n632\t    if r[\"state\"] == \"next-review\":\n633\t        checks_command = (m.get(\"forge\") or {}).get(\"checks_command\")\n634\t        forge_checks = {\"command\": checks_command, \"sha\": r[\"head\"], \"conclusions\": r[\"checks\"] or []}\n635\t        return _start_stage(root, m, item_id, \"verify\", forge_checks), r\n636\t    if again and r[\"state\"] == \"stopped\" and r[\"stage\"]:\n637\t        return _advance_again(root, m, item_id, r[\"stage\"], r[\"head\"]), r\n638\t\n639\t    print(f\"attavo drive: {r['says']}\")\n640\t    return (1 if r[\"state\"] == \"refused\" else 0), r\n641\t\n642\t\n643\t_TERMINAL_STATES = (\"waiting-on-approval\", \"stopped\", \"ready-to-merge\", \"merged\")\n644\t\n645\t\n646\tdef _until_ready(root: Path, m: dict[str, Any], item_id: str, again: bool) -> int:\n647\t    \"\"\"--until-ready: the pass, repeated in one process, sleeping\n648\t    ATTAVO_DRIVE_POLL_INTERVAL_S between passes, until the level is the\n649\t    operator's or done (exit 0), a concluded check is red (exit 1), or\n650\t    an unconcluded one has not concluded within ATTAVO_DRIVE_POLL_BOUND_S\n651\t    (exit 1). A stage running in its own worker is not bounded by this --\n652\t    only time spent waiting on the forge is.\"\"\"\n653\t    from attavo.verify import drive_forge_poll_bound_s, drive_forge_poll_interval_s\n654\t    bound = drive_forge_poll_bound_s()\n655\t    interval = drive_forge_poll_interval_s()\n656\t    waiting_since: float | None = None\n657\t    while True:\n658\t        rc, r = _pass_once(root, m, item_id, again)\n659\t        state = r[\"state\"]\n660\t\n661\t        if state == \"waiting-on-checks\":\n662\t            if waiting_since is None:\n663\t                waiting_since = time.monotonic()\n664\t            elif time.monotonic() - waiting_since >= bound:\n665\t                print(f\"attavo drive: stopped: the checks did not conclude within {bound:.0f}s\")\n666\t                return 1\n667\t        else:\n668\t            waiting_since = None\n669\t\n670\t        if rc != 0:\n671\t            return rc\n672\t        if state in _TERMINAL_STATES:\n673\t            return 0\n674\t        if state == \"blocked-on-checks\":\n675\t            return 1\n676\t        time.sleep(interval)\n677\t\n678\t\n679\tdef _drive_all() -> int:\n680\t    \"\"\"--all: one pass, in its own process, in every ../attavo-worktree-N\n681\t    beside this checkout -- each one derives its own item from its own\n682\t    attavo/N-* branch. Every line either prints is prefixed with the\n683\t    worktree's own directory name, so an operator reading them together\n684\t    can tell which item each line is about.\"\"\"\n685\t    root = Path(\".\").resolve()\n686\t    siblings = sorted(p for p in root.parent.glob(\"attavo-worktree-*\") if p.is_dir())\n687\t    if not siblings:\n688\t        print(\"attavo drive: --all found no ../attavo-worktree-N beside this checkout\")\n689\t        return 0\n690\t    worst = 0\n691\t    for copy in siblings:\n692\t        run = subprocess.run([sys.executable, str(PRODUCT_ROOT / \"bin\" / \"attavo\"), \"drive\"],\n693\t                             cwd=str(copy), capture_output=True, text=True, check=False)\n694\t        for line in (run.stdout + run.stderr).splitlines():\n695\t            print(f\"{copy.name}: {line}\")\n696\t        worst = max(worst, run.returncode)\n697\t    return worst\n698\t\n699\t\n700\tdef cmd_drive(argv: list[str]) -> int:\n701\t    # Issue #145: Python block-buffers stdout when it is not a tty (a\n702\t    # pipe, e.g. a screen reading this process live), so every line this\n703\t    # prints would otherwise sit unflushed until the process exits.\n704\t    # Line-buffering makes a pipe reader see each line the moment it is\n705\t    # printed, the same as a terminal already does; `attavo worker`\n706\t    # reconfigures its own stdout the same way.\n707\t    cast(io.TextIOWrapper, sys.stdout).reconfigure(line_buffering=True)\n708\t\n709\t    if \"--recover\" in argv:\n710\t        print(\"attavo drive: --recover is gone; a pass recovers a dead or hung invocation \"\n711\t              \"itself, as soon as the report owes one\", file=sys.stderr)\n712\t        return 2\n713\t\n714\t    until_ready = \"--until-ready\" in argv\n715\t    report = \"--report\" in argv\n716\t    again = \"--again\" in argv\n717\t    all_flag = \"--all\" in argv\n718\t    positional = [a for a in argv if not a.startswith(\"--\")]\n719\t\n720\t    if all_flag:\n721\t        if until_ready or report or again or positional:\n722\t            print(\"attavo drive: --all runs one pass in every worktree beside this checkout; \"\n723\t                  \"drop N and every other flag\", file=sys.stderr)\n724\t            return 2\n725\t        return _drive_all()\n726\t\n727\t    root = Path(\".\").resolve()\n728\t    item_id = positional[0] if positional else derive_item_id(root)\n729\t    if not item_id:\n730\t        print(\"attavo drive: cannot derive item id; pass N or run on an attavo/N-* branch\",\n731\t              file=sys.stderr)\n732\t        return 2\n733\t    m = read_manifest(root)\n734\t    if m is None:\n735\t        print(f\"attavo drive: no {MANIFEST} at {root}\", file=sys.stderr)\n736\t        return 2\n737\t\n738\t    if report:\n739\t        if until_ready or again:\n740\t            print(\"attavo drive: --report reads and does nothing else; drop --until-ready \"\n741\t                  \"and --again\", file=sys.stderr)\n742\t            return 2\n743\t        fast_forward_to_origin(root, m, item_id)\n744\t        from attavo.report import drive_report\n745\t        print(json.dumps(drive_report(root, m, item_id), indent=2))\n746\t        return 0\n747\t\n748\t    if until_ready:\n749\t        return _until_ready(root, m, item_id, again)\n750\t    rc, _ = _pass_once(root, m, item_id, again)\n751\t    return rc\n752\t"}]},"parent_tool_use_id":null,"session_id":"041a92ee-b14a-4832-b613-6f5a12b6a373","uuid":"9cb80a12-e758-4eb0-be6b-163bfc2004e0","timestamp":"2026-09-25T18:37:04.590Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-217/attavo/drive.py","content":"from __future__ import annotations\n\nimport io\nimport json\nimport os\nimport signal\nimport subprocess\nimport sys\nimport threading\nimport time\nfrom pathlib import Path\nfrom typing import TYPE_CHECKING, Any, NamedTuple, cast\n\nfrom attavo.approval import approval_status\nfrom attavo.build import cmd_build, driver_identity\nfrom attavo.common import MANIFEST, PRODUCT_ROOT, derive_item_id, git, read_manifest\nfrom attavo.counsel import cmd_counsel\nfrom attavo.doctor import (\n    _parse_json_line,\n    invocation_alive,\n    invocations_without_record,\n    stall_bound_s,\n    write_invocation_marker,\n)\nfrom attavo.events import stage_events_dir\nfrom attavo.filing import cmd_file_stops\nfrom attavo.records import (\n    latest_attempt_path,\n    latest_record,\n    next_attempt_number,\n    stage_schema,\n    write_record,\n)\nfrom attavo.verify import cmd_verify, read_forge_checks\n\nif TYPE_CHECKING:\n    from attavo.types import DriveReport\n\n# --- drive: the mechanical transitions between approval and ready-to-merge\n# (issue #84), under the reconciler's R2 (rulings A, B, C's recovery half,\n# F, G, H): `attavo drive N` is one short pass. It reads the report\n# (attavo.report), acts at most once -- recovers a dead or hung\n# invocation, or starts the next stage in a detached worker -- and\n# returns within seconds; the stage itself runs in `attavo worker`, a\n# child of the pass's own session, which outlives it. Writes no record of\n# its own: the stage records already on disk, and the invocation markers\n# and heartbeats beside them, are the only state a pass or a worker\n# reads. ---\n\n\ndef commit_record(root: Path, record_paths: Path | list[Path], message: str) -> None:\n    \"\"\"`git commit --only` on every record path given, and each one's .log\n    and .filed, each if one exists -- never the whole index. A transport\n    commit that sweeps the index is exactly the regression issue #46\n    already guards build and verify against on the adapter side; drive\n    must not reintroduce it on the transport side. The .filed marker\n    (issue #89) is committed alongside the record it names, in the same\n    commit and the same push, so a second worktree or a fresh clone reads\n    the same filed fact rather than refiling every stop it finds with no\n    marker of its own. A single Path is accepted for the common one-record\n    case; issue #100 passes a list so the counsel record lands in the same\n    commit as the stage record it counsels. Authored and committed as\n    driver_identity(), set by the product and never the tenant's git\n    config, so a driven item's record commits are never indistinguishable\n    from an operator's own.\"\"\"\n    if isinstance(record_paths, Path):\n        record_paths = [record_paths]\n    paths: list[str] = []\n    for record_path in record_paths:\n        paths.append(str(record_path.relative_to(root)))\n        log_path = record_path.with_suffix(\".log\")\n        if log_path.is_file():\n            paths.append(str(log_path.relative_to(root)))\n        marker_path = record_path.with_suffix(\".filed\")\n        if marker_path.is_file():\n            paths.append(str(marker_path.relative_to(root)))\n    identity = driver_identity()\n    env = dict(os.environ)\n    env[\"GIT_AUTHOR_NAME\"] = identity[\"name\"]\n    env[\"GIT_AUTHOR_EMAIL\"] = identity[\"email\"]\n    env[\"GIT_COMMITTER_NAME\"] = identity[\"name\"]\n    env[\"GIT_COMMITTER_EMAIL\"] = identity[\"email\"]\n    git(root, \"add\", *paths)\n    git(root, \"commit\", \"--only\", \"-m\", message, *paths, env=env)\n\n\ndef push_record_commit(root: Path, branch: str) -> tuple[bool, str | None]:\n    \"\"\"Push HEAD to branch on origin. A push a divergent remote rejects is\n    retried once after `git pull --no-rebase --no-edit origin branch` -- a\n    merge, never a rebase, because a rebase would change the sha the record\n    commit just wrote already names. This is the record push's own retry\n    -- the worker's, once it has the lease -- distinct from push_lease\n    below, which never retries.\"\"\"\n    def attempt() -> tuple[bool, str]:\n        run = subprocess.run([\"git\", \"-C\", str(root), \"push\", \"origin\", f\"HEAD:{branch}\"],\n                             capture_output=True, text=True, check=False)\n        return run.returncode == 0, run.stderr.strip()\n\n    ok, err = attempt()\n    if ok:\n        return True, None\n    pull = subprocess.run([\"git\", \"-C\", str(root), \"pull\", \"--no-rebase\", \"--no-edit\",\n                           \"origin\", branch], capture_output=True, text=True, check=False)\n    if pull.returncode != 0:\n        return False, f\"push rejected and the retry merge failed: {pull.stderr.strip() or err}\"\n    ok, err = attempt()\n    if not ok:\n        return False, f\"push rejected again after merging {branch}: {err}\"\n    return True, None\n\n\n_RACE_MARKERS = (\"non-fast-forward\", \"fetch first\", \"stale info\", \"cannot lock ref\",\n                 \"failed to update ref\")\n\n\ndef push_lease(root: Path, branch: str) -> tuple[str, str | None]:\n    \"\"\"Push HEAD to branch on origin as a plain fast-forward -- no merge,\n    no retry: this is the lease the marker commit takes on the attempt it\n    names (ruling A). (\"pushed\", None) on success.\n\n    (\"lost-race\", stderr) when git's own ref check is what rejected it --\n    the branch moved since this pass fast-forwarded to it (a sequential\n    \"[rejected] ... (fetch first)\"), or the remote's own ref transaction\n    lost a genuine simultaneous push (\"[remote rejected] ... (failed to\n    update ref)\", \"cannot lock ref\"): either way, another pass's own\n    marker (or record) landed there first. The pass that reads this is\n    the loser: it says so, resets its own marker commit, and starts\n    nothing.\n\n    (\"refused\", stderr) for every other rejection -- a remote that\n    refuses the push outright (a hook, a permission, an unreachable\n    remote). This is not a race for the lease; it is a refusal, and ends\n    the pass with exit 1.\"\"\"\n    run = subprocess.run([\"git\", \"-C\", str(root), \"push\", \"origin\", f\"HEAD:{branch}\"],\n                         capture_output=True, text=True, check=False)\n    if run.returncode == 0:\n        return \"pushed\", None\n    stderr = run.stderr\n    if any(marker in stderr for marker in _RACE_MARKERS):\n        return \"lost-race\", stderr.strip()\n    return \"refused\", stderr.strip()\n\n\ndef has_origin(root: Path) -> bool:\n    \"\"\"Whether this checkout carries an origin remote at all -- a fixture\n    or a scratch checkout with none is not a refusal; a pass commits\n    locally and skips the push, the way recovery always has.\"\"\"\n    try:\n        git(root, \"remote\", \"get-url\", \"origin\")\n        return True\n    except RuntimeError:\n        return False\n\n\ndef drive_state(root: Path, m: dict[str, Any], item_id: str) -> tuple[str, str | None, Path]:\n    \"\"\"(\"no-approval\" | \"build\" | \"verify\" | \"ready\", detail, records_dir):\n    the next mechanical step for item_id, read from its latest records\n    alone. A build only counts as current when it is a pass bound to the\n    valid approval's own sha; a verify only counts as current when it is a\n    pass bound to that build's own sha -- the same staleness a re-approval\n    or a re-build must force, attest's own chain check already enforces\n    (check_attest_chain), read here rather than re-typed.\"\"\"\n    records_rel = m[\"paths\"][\"records\"]\n    records_dir = root / records_rel / item_id\n\n    status = approval_status(root, m, item_id)\n    if status != \"valid\":\n        return \"no-approval\", status, records_dir\n\n    latest_approval = latest_record(records_dir, \"approval\")\n    latest_build = latest_record(records_dir, \"build\")\n    build_current = (latest_build is not None and latest_build.get(\"status\") == \"pass\"\n                     and latest_build.get(\"approval_sha\")\n                     == (latest_approval.get(\"sha\") if latest_approval else None))\n    if latest_build is None or not build_current:\n        return \"build\", None, records_dir\n\n    latest_verify = latest_record(records_dir, \"verify\")\n    verify_current = (latest_verify is not None and latest_verify.get(\"status\") == \"pass\"\n                      and latest_verify.get(\"build_sha\") == latest_build.get(\"sha\"))\n    if not verify_current:\n        return \"verify\", None, records_dir\n\n    return \"ready\", None, records_dir\n\n\n# --- the heartbeat, the worker log, and the forge-checks handoff: local\n# facts under the checkout's own git directory (issue #140's precedent),\n# never committed and never among the paths commit_record ever names. ---\n\ndef heartbeat_s() -> float:\n    return float(os.environ.get(\"ATTAVO_HEARTBEAT_S\", 15))\n\n\ndef heartbeat_path(root: Path, stage: str, nn: int) -> Path:\n    return stage_events_dir(root) / f\"{stage}-{nn:02d}.heartbeat\"\n\n\ndef worker_log_path(root: Path, stage: str, nn: int) -> Path:\n    return stage_events_dir(root) / f\"{stage}-{nn:02d}.worker.log\"\n\n\ndef forge_checks_path(root: Path, stage: str, nn: int) -> Path:\n    return stage_events_dir(root) / f\"{stage}-{nn:02d}.forge-checks.json\"\n\n\ndef _events_path_for(root: Path, stage: str, nn: int) -> Path | None:\n    \"\"\"The adapter's own events file for this invocation, under the\n    checkout's git dir (a worktree's own dir when the checkout is one).\"\"\"\n    try:\n        gitdir = Path(git(root, \"rev-parse\", \"--git-dir\").strip())\n    except RuntimeError:\n        return None\n    if not gitdir.is_absolute():\n        gitdir = root / gitdir\n    path = gitdir / \"attavo\" / f\"{stage}-{nn:02d}.events.jsonl\"\n    return path if path.is_file() else None\n\n\ndef _events_tail(path: Path | None, lines: int = 20) -> tuple[str, str | None]:\n    \"\"\"(the last lines as a log, the last event's own at).\"\"\"\n    if path is None:\n        return \"no events file for this invocation\\n\", None\n    try:\n        text = path.read_text()\n    except OSError:\n        return \"events file unreadable\\n\", None\n    tail = text.splitlines()[-lines:]\n    last_at = None\n    for line in reversed(tail):\n        parsed = _parse_json_line(line)\n        if not isinstance(parsed, dict):\n            continue\n        at = parsed.get(\"at\")\n        if isinstance(at, str):\n            last_at = at\n            break\n    return \"\\n\".join(tail) + \"\\n\", last_at\n\n\ndef _seconds_since(at: str | None) -> float | None:\n    from datetime import datetime, timezone\n    if not at:\n        return None\n    try:\n        then = datetime.strptime(at, \"%Y-%m-%dT%H:%M:%SZ\").replace(tzinfo=timezone.utc)\n    except ValueError:\n        return None\n    return (datetime.now(timezone.utc) - then).total_seconds()\n\n\nclass InvocationReading(NamedTuple):\n    \"\"\"What one marker with no record reads as, from here and now.\"\"\"\n    stage: str\n    nn: int\n    log: str\n    last_at: str | None\n    age: float | None\n    cls: str  # \"running\" | \"hung\" | \"died\"\n\n\ndef read_invocation(root: Path, bound: int | None, marker: Path, info: dict[str, Any]) -> InvocationReading:\n    \"\"\"Whether an invocation that began and wrote no record is running,\n    hung, or died -- read from its own heartbeat first (R2): a heartbeat\n    file fresh within three beats of ATTAVO_HEARTBEAT_S is alive; a stale\n    one is died, whether or not the pid still lives -- a worker stuck\n    somewhere that never reaches its own heartbeat loop again is exactly\n    what this is for. Only with no heartbeat file at all -- an invocation\n    from before this release, or one that died before touching its\n    first beat -- does this fall back to the pid: alive and, with a\n    stall bound declared, past it is hung; alive with no bound, or\n    within it, is running for as long as it lives; not alive is died.\n    The stall bound decides hung, never died.\"\"\"\n    stage, nn_text = marker.stem.rsplit(\"-\", 1)\n    nn = int(nn_text)\n    log, last_at = _events_tail(_events_path_for(root, stage, nn))\n    beat = heartbeat_path(root, stage, nn)\n    if beat.is_file():\n        try:\n            beat_age = time.time() - beat.stat().st_mtime\n        except OSError:\n            beat_age = None\n        cls = \"running\" if beat_age is not None and beat_age <= heartbeat_s() * 3 else \"died\"\n        return InvocationReading(stage, nn, log, last_at, beat_age, cls)\n    age = _seconds_since(last_at or info.get(\"at\"))\n    if not invocation_alive(info):\n        return InvocationReading(stage, nn, log, last_at, age, \"died\")\n    if bound is None or age is None or age <= bound:\n        return InvocationReading(stage, nn, log, last_at, age, \"running\")\n    return InvocationReading(stage, nn, log, last_at, age, \"hung\")\n\n\ndef uncommitted_record(root: Path, records_dir: Path, stage: str) -> Path | None:\n    \"\"\"The latest <stage>-NN.json this working tree carries that git has\n    no commit for yet -- the moment between a worker's write and its own\n    commit. None when the latest record is already committed, or there\n    is none at all.\"\"\"\n    path = latest_attempt_path(records_dir, stage)\n    if path is None or not path.is_file():\n        return None\n    status = subprocess.run(\n        [\"git\", \"-C\", str(root), \"status\", \"--porcelain\", \"--\", str(path.relative_to(root))],\n        capture_output=True, text=True, check=False)\n    return path if status.stdout.strip() else None\n\n\ndef worker_holds_copy(root: Path, records_dir: Path) -> bool:\n    \"\"\"True when this checkout's own working tree cannot safely be moved\n    -- an invocation marker with no record yet (a worker, here or\n    elsewhere, still holds this attempt), or a build or verify record the\n    working tree carries that git has not committed yet. Scoped to the\n    stage records a pass or a worker itself ever transports -- an\n    operator's own spec-gate or approve, routinely uncommitted between\n    their own act and the next pass, is not this. A pass never\n    fast-forwards while this holds (never while a worker holds the\n    copy).\"\"\"\n    if invocations_without_record(records_dir):\n        return True\n    return (uncommitted_record(root, records_dir, \"build\") is not None\n           or uncommitted_record(root, records_dir, \"verify\") is not None)\n\n\ndef fast_forward_to_origin(root: Path, m: dict[str, Any], item_id: str) -> None:\n    \"\"\"The pass's own read of origin's branch, taken before it reads\n    anything else -- a commit landed there from elsewhere (an approval\n    from the screen, a ruling, another pass's own record) is not a race\n    for the lease, it is exactly what the lease is for. Never while a\n    worker holds this copy (worker_holds_copy): resetting a working tree\n    a detached child is still writing into would corrupt its own commits.\n    A plain fast-forward when origin is simply ahead; when this checkout\n    also carries its own commits origin has not seen yet (an operator's\n    approval, not yet pushed), those are replayed on top of origin's own\n    tip instead -- no merge commit, and the marker this pass is about to\n    write still lands as a fast-forward when it pushes. Silent about\n    everything short of that -- a real conflict, or an absent origin, is\n    left for the ordinary read (and the marker push, for the lease) to\n    sort out.\"\"\"\n    records_dir = root / m[\"paths\"][\"records\"] / item_id\n    if worker_holds_copy(root, records_dir) or not has_origin(root):\n        return\n    try:\n        branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n        git(root, \"fetch\", \"origin\", branch)\n    except RuntimeError:\n        return\n    try:\n        git(root, \"merge\", \"--ff-only\", \"FETCH_HEAD\")\n        return\n    except RuntimeError:\n        pass\n    try:\n        git(root, \"rebase\", \"FETCH_HEAD\")\n    except RuntimeError:\n        subprocess.run([\"git\", \"-C\", str(root), \"rebase\", \"--abort\"],\n                       capture_output=True, text=True, check=False)\n\n\n# --- the worker: a detached child of the pass's own session, running the\n# stage exactly as the pass used to inline, touching its own heartbeat\n# while it does (R2). ---\n\ndef _stage_body(item_id: str, stage: str, nn: int) -> int:\n    \"\"\"Runs build or verify in-process -- the same command `attavo build`\n    or `attavo verify` would run -- while touching heartbeat_path every\n    heartbeat_s() seconds, then transports whatever it wrote: counsel and\n    file-stops on a non-pass record (issue #100, #89), one `git commit\n    --only`, one push with the record push's own merge retry. The\n    marker is the pass's, already committed and pushed before this\n    starts; this writes and transports only the stage's own record (and,\n    on a stop, its counsel record).\"\"\"\n    root = Path(\".\").resolve()\n    m = read_manifest(root)\n    if m is None:\n        return 2\n    records_dir = root / m[\"paths\"][\"records\"] / item_id\n    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n    before = latest_attempt_path(records_dir, stage)\n\n    beat = heartbeat_path(root, stage, nn)\n    beat.parent.mkdir(parents=True, exist_ok=True)\n    beat.touch()\n    stop_beat = threading.Event()\n\n    def _tick() -> None:\n        while not stop_beat.wait(heartbeat_s()):\n            beat.touch()\n\n    beat_thread = threading.Thread(target=_tick, daemon=True)\n    beat_thread.start()\n    try:\n        rc = cmd_build([item_id]) if stage == \"build\" else cmd_verify([item_id])\n    finally:\n        stop_beat.set()\n        beat_thread.join()\n\n    after = latest_attempt_path(records_dir, stage)\n    if after is None or after == before:\n        # Refused before writing anything at all (e.g. no adapter\n        # configured) -- the stage command already printed why.\n        return rc if rc != 0 else 1\n\n    record = cast(dict[str, Any], latest_record(records_dir, stage))\n    status_out = record.get(\"status\")\n    to_commit = [after]\n    if status_out != \"pass\":\n        counsel_before = latest_attempt_path(records_dir, \"counsel\")\n        cmd_counsel([item_id])\n        counsel_after = latest_attempt_path(records_dir, \"counsel\")\n        if counsel_after is not None and counsel_after != counsel_before:\n            to_commit.append(counsel_after)\n        # file-stops is its own idempotent read of the item's records, so\n        # calling it here on every run that wrote a non-pass record is\n        # safe to call again on a later run: an already-filed stop's own\n        # marker is what stops it from being filed twice.\n        cmd_file_stops([item_id])\n\n    message = f\"attavo: {stage} record for item {item_id} ({after.stem})\"\n    try:\n        commit_record(root, to_commit, message)\n    except RuntimeError as exc:\n        print(f\"attavo drive: stopped: could not commit the {stage} record: {exc}\")\n        return 1\n\n    if has_origin(root):\n        ok, err = push_record_commit(root, branch)\n        if not ok:\n            print(f\"attavo drive: stopped: could not push the {stage} record: {err}\")\n            return 1\n    else:\n        print(f\"attavo drive: note: no origin remote; {after.name} is committed, not pushed\")\n\n    if status_out == \"halted\":\n        question = (record.get(\"halted\") or {}).get(\"question\")\n        print(f\"attavo drive: stopped: {stage} halted: {question} ({after.name}); \"\n              f\"pushed to {branch}\")\n    elif status_out != \"pass\":\n        reason = record.get(\"refusal\") or status_out\n        print(f\"attavo drive: stopped: {stage} {status_out}: {reason} ({after.name}); \"\n              f\"pushed to {branch}\")\n    else:\n        print(f\"attavo drive: pushed {after.name} to {branch}\")\n    return rc\n\n\ndef cmd_worker(argv: list[str]) -> int:\n    \"\"\"`attavo worker N <build|verify> NN`: the detached child a pass\n    starts once its marker is pushed -- the lease held, the attempt is\n    this worker's to run. Its own session (start_new_session, set by the\n    pass that spawns it); its stdout and stderr are the pass's own\n    redirect, to <git-dir>/attavo/<stage>-NN.worker.log.\"\"\"\n    cast(io.TextIOWrapper, sys.stdout).reconfigure(line_buffering=True)\n    if len(argv) != 3:\n        print(\"attavo worker: usage: attavo worker N <build|verify> NN\", file=sys.stderr)\n        return 2\n    item_id, stage, nn_text = argv\n    if stage not in (\"build\", \"verify\"):\n        print(f\"attavo worker: {stage!r} is not build or verify\", file=sys.stderr)\n        return 2\n    try:\n        nn = int(nn_text)\n    except ValueError:\n        print(f\"attavo worker: {nn_text!r} is not an attempt number\", file=sys.stderr)\n        return 2\n    return _stage_body(item_id, stage, nn)\n\n\n# --- the pass's own two acts: start a stage (the lease), and recover\n# exactly the one invocation the report names owed one. ---\n\ndef _start_stage(root: Path, m: dict[str, Any], item_id: str, stage: str,\n                 forge_checks: dict[str, Any] | None) -> int:\n    \"\"\"The lease (ruling A): the marker, committed and pushed as a plain\n    fast-forward with no merge and no retry (push_lease). Lost to another\n    pass, or refused outright by the remote, both undo the marker commit\n    here (git reset --hard) so this checkout carries no half-taken\n    attempt either way; only a pushed lease starts the worker. On a\n    review, forge_checks is the checks this same pass already read on\n    the pre-marker head (ruling B) -- written to\n    <git-dir>/attavo/verify-NN.forge-checks.json and named in\n    ATTAVO_FORGE_CHECKS, so the worker's own `attavo verify` reads it\n    instead of polling.\"\"\"\n    records_dir = root / m[\"paths\"][\"records\"] / item_id\n    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n    nn = next_attempt_number(records_dir, stage)\n    marker = write_invocation_marker(root, records_dir, stage, nn)\n    try:\n        commit_record(root, [marker], f\"attavo: {stage} invocation {nn:02d} started for item {item_id}\")\n    except RuntimeError as exc:\n        print(f\"attavo drive: stopped: could not commit the {stage} invocation marker: {exc}\")\n        return 1\n\n    if has_origin(root):\n        outcome, err = push_lease(root, branch)\n        if outcome != \"pushed\":\n            git(root, \"reset\", \"--hard\", \"HEAD^\")\n            if outcome == \"lost-race\":\n                print(f\"attavo drive: another pass holds this attempt ({marker.name}); nothing started\")\n                return 0\n            print(f\"attavo drive: stopped: could not push the {stage} invocation marker: {err}\")\n            return 1\n\n    env = dict(os.environ)\n    if forge_checks is not None:\n        checks_file = forge_checks_path(root, stage, nn)\n        checks_file.write_text(json.dumps(forge_checks))\n        env[\"ATTAVO_FORGE_CHECKS\"] = str(checks_file)\n    log = worker_log_path(root, stage, nn)\n    with log.open(\"ab\") as fh, open(os.devnull, \"rb\") as devnull:\n        proc = subprocess.Popen(\n            [sys.executable, str(PRODUCT_ROOT / \"bin\" / \"attavo\"), \"worker\", item_id, stage, f\"{nn:02d}\"],\n            cwd=str(root), env=env, stdin=devnull, stdout=fh, stderr=subprocess.STDOUT,\n            start_new_session=True)\n    word = \"Build\" if stage == \"build\" else \"Review\"\n    print(f\"attavo drive: {word} started (attempt {nn:02d}, worker pid {proc.pid})\")\n    return 0\n\n\ndef _recover_one(root: Path, m: dict[str, Any], item_id: str, records_dir: Path) -> int:\n    \"\"\"The pass's own recovery act (what `--recover` did): exactly the one\n    invocation the report just read as owing one -- died or hung -- ends\n    here. class died when the heartbeat is stale (or absent and the pid\n    is gone), class hung when there is no heartbeat, the pid lives, and a\n    declared [drive].stall_after_s has passed with no newer event, and\n    terminated. Provenance product; the events tail as the log. Committed\n    and pushed the way any stage record is (push_record_commit, with its\n    own merge retry) -- this is not a race for a lease, since no new\n    attempt marker is written.\"\"\"\n    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n    bound = stall_bound_s(m)\n    pending = invocations_without_record(records_dir)\n    readings = [(marker, info, read_invocation(root, bound, marker, info)) for marker, info in pending]\n    candidate = next(((mk, i, rd) for mk, i, rd in readings if rd.cls != \"running\"), None)\n    if candidate is None:\n        # The report read this a moment ago; nothing owed recovery by the\n        # time this pass got here (another pass recovered it, or it\n        # finished on its own).\n        return 0\n    marker, info, reading = candidate\n    stage, nn, log, last_at, age, cls = reading\n    pid, host = info.get(\"pid\"), info.get(\"host\")\n\n    if next_attempt_number(records_dir, stage) != nn:\n        print(f\"attavo drive: stopped: {marker.name} names attempt {nn} but the next \"\n              f\"{stage} record would be {next_attempt_number(records_dir, stage):02d}; \"\n              f\"a later record already exists, read the records before recovering\")\n        return 1\n\n    if cls == \"hung\":\n        try:\n            os.kill(cast(int, pid), signal.SIGTERM)\n            ended = \"terminated\"\n        except OSError as exc:\n            ended = f\"not terminated ({exc})\"\n        detail = (f\"pid {pid} on {host} alive with no event for {int(cast(float, age))} s \"\n                  f\"(bound {bound} s); {ended}\")\n    else:\n        detail = (f\"pid {pid} on {host} is not running and wrote no {marker.stem}.json; \"\n                  f\"started {info.get('at')}, last event {last_at or 'none'}\")\n\n    schema = stage_schema(stage)\n    record: dict[str, Any] = {k: None for k in schema.get(\"required\", [])}\n    approval = latest_record(records_dir, \"approval\")\n    record.update({\"sha\": info.get(\"sha\"), \"start_sha\": info.get(\"sha\"),\n                   \"approval_sha\": approval.get(\"sha\") if approval else None,\n                   \"at\": info.get(\"at\"),\n                   \"adapter\": (m.get(\"executor\") or {}).get(stage),\n                   \"status\": \"failed\", \"refusal\": None, \"halted\": None,\n                   \"stop\": {\"class\": cls, \"provenance\": \"product\", \"detail\": detail}})\n    if \"wall_clock_s\" in record:\n        record[\"wall_clock_s\"] = None if age is None else int(age)\n    record = {k: v for k, v in record.items() if k in schema.get(\"properties\", {})}\n    try:\n        path = write_record(records_dir, stage, record, m, item_id, log=log)\n    except ValueError as exc:\n        print(f\"attavo drive: stopped: could not write the {cls} record for {marker.stem}: {exc}\")\n        return 1\n    try:\n        commit_record(root, [path], f\"attavo: {stage} record for item {item_id} \"\n                                    f\"({path.stem}), recovered as {cls}\")\n    except RuntimeError as exc:\n        print(f\"attavo drive: stopped: could not commit the {cls} record: {exc}\")\n        return 1\n    if has_origin(root):\n        ok, err = push_record_commit(root, branch)\n        if not ok:\n            print(f\"attavo drive: stopped: could not push the {cls} record: {err}\")\n            return 1\n    else:\n        print(f\"attavo drive: note: no origin remote; {path.name} is committed, not pushed\")\n    print(f\"attavo drive: recovered {marker.stem} as {cls}: {detail}\")\n    return 0\n\n\ndef _advance_again(root: Path, m: dict[str, Any], item_id: str, stage: str, head: str | None) -> int:\n    \"\"\"`--again`'s own act on a stopped stage: exactly what next-build or\n    next-review would do, bypassing the level a plain pass leaves alone\n    for the operator. A review reads the forge fresh here -- once, since\n    the report's own stopped reading never touched it -- rather than\n    reusing a read that was never taken.\"\"\"\n    if stage == \"build\":\n        return _start_stage(root, m, item_id, \"build\", None)\n    checks_command = (m.get(\"forge\") or {}).get(\"checks_command\")\n    if not checks_command:\n        print(\"attavo drive: refused: no [forge].checks_command in the manifest\")\n        return 1\n    forge_checks, ok = read_forge_checks(root, checks_command, cast(str, head))\n    if not ok:\n        conclusions = forge_checks[\"conclusions\"]\n        named = \", \".join(f\"{c['name']} {c['conclusion']}\" for c in conclusions) or \"no checks reported\"\n        print(f\"attavo drive: forge checks not green on {cast(str, head)[:12]}: {named}\")\n        return 0\n    return _start_stage(root, m, item_id, \"verify\", forge_checks)\n\n\ndef _pass_once(root: Path, m: dict[str, Any], item_id: str, again: bool) -> tuple[int, \"DriveReport\"]:\n    \"\"\"One pass: fast-forward to origin (never while a worker holds the\n    copy), read the report, act at most once, return. The three acts,\n    one per report state that is the product's move: owes-recovery\n    recovers; next-build and next-review start their stage, handing a\n    review the checks the report already read once on the pre-marker\n    head. --again starts the next attempt of a stopped stage. Every\n    other level is printed in the report's own words and left.\"\"\"\n    from attavo.report import drive_report\n    fast_forward_to_origin(root, m, item_id)\n    r = drive_report(root, m, item_id)\n\n    if r[\"state\"] == \"owes-recovery\":\n        records_dir = root / m[\"paths\"][\"records\"] / item_id\n        return _recover_one(root, m, item_id, records_dir), r\n    if r[\"state\"] == \"next-build\":\n        return _start_stage(root, m, item_id, \"build\", None), r\n    if r[\"state\"] == \"next-review\":\n        checks_command = (m.get(\"forge\") or {}).get(\"checks_command\")\n        forge_checks = {\"command\": checks_command, \"sha\": r[\"head\"], \"conclusions\": r[\"checks\"] or []}\n        return _start_stage(root, m, item_id, \"verify\", forge_checks), r\n    if again and r[\"state\"] == \"stopped\" and r[\"stage\"]:\n        return _advance_again(root, m, item_id, r[\"stage\"], r[\"head\"]), r\n\n    print(f\"attavo drive: {r['says']}\")\n    return (1 if r[\"state\"] == \"refused\" else 0), r\n\n\n_TERMINAL_STATES = (\"waiting-on-approval\", \"stopped\", \"ready-to-merge\", \"merged\")\n\n\ndef _until_ready(root: Path, m: dict[str, Any], item_id: str, again: bool) -> int:\n    \"\"\"--until-ready: the pass, repeated in one process, sleeping\n    ATTAVO_DRIVE_POLL_INTERVAL_S between passes, until the level is the\n    operator's or done (exit 0), a concluded check is red (exit 1), or\n    an unconcluded one has not concluded within ATTAVO_DRIVE_POLL_BOUND_S\n    (exit 1). A stage running in its own worker is not bounded by this --\n    only time spent waiting on the forge is.\"\"\"\n    from attavo.verify import drive_forge_poll_bound_s, drive_forge_poll_interval_s\n    bound = drive_forge_poll_bound_s()\n    interval = drive_forge_poll_interval_s()\n    waiting_since: float | None = None\n    while True:\n        rc, r = _pass_once(root, m, item_id, again)\n        state = r[\"state\"]\n\n        if state == \"waiting-on-checks\":\n            if waiting_since is None:\n                waiting_since = time.monotonic()\n            elif time.monotonic() - waiting_since >= bound:\n                print(f\"attavo drive: stopped: the checks did not conclude within {bound:.0f}s\")\n                return 1\n        else:\n            waiting_since = None\n\n        if rc != 0:\n            return rc\n        if state in _TERMINAL_STATES:\n            return 0\n        if state == \"blocked-on-checks\":\n            return 1\n        time.sleep(interval)\n\n\ndef _drive_all() -> int:\n    \"\"\"--all: one pass, in its own process, in every ../attavo-worktree-N\n    beside this checkout -- each one derives its own item from its own\n    attavo/N-* branch. Every line either prints is prefixed with the\n    worktree's own directory name, so an operator reading them together\n    can tell which item each line is about.\"\"\"\n    root = Path(\".\").resolve()\n    siblings = sorted(p for p in root.parent.glob(\"attavo-worktree-*\") if p.is_dir())\n    if not siblings:\n        print(\"attavo drive: --all found no ../attavo-worktree-N beside this checkout\")\n        return 0\n    worst = 0\n    for copy in siblings:\n        run = subprocess.run([sys.executable, str(PRODUCT_ROOT / \"bin\" / \"attavo\"), \"drive\"],\n                             cwd=str(copy), capture_output=True, text=True, check=False)\n        for line in (run.stdout + run.stderr).splitlines():\n            print(f\"{copy.name}: {line}\")\n        worst = max(worst, run.returncode)\n    return worst\n\n\ndef cmd_drive(argv: list[str]) -> int:\n    # Issue #145: Python block-buffers stdout when it is not a tty (a\n    # pipe, e.g. a screen reading this process live), so every line this\n    # prints would otherwise sit unflushed until the process exits.\n    # Line-buffering makes a pipe reader see each line the moment it is\n    # printed, the same as a terminal already does; `attavo worker`\n    # reconfigures its own stdout the same way.\n    cast(io.TextIOWrapper, sys.stdout).reconfigure(line_buffering=True)\n\n    if \"--recover\" in argv:\n        print(\"attavo drive: --recover is gone; a pass recovers a dead or hung invocation \"\n              \"itself, as soon as the report owes one\", file=sys.stderr)\n        return 2\n\n    until_ready = \"--until-ready\" in argv\n    report = \"--report\" in argv\n    again = \"--again\" in argv\n    all_flag = \"--all\" in argv\n    positional = [a for a in argv if not a.startswith(\"--\")]\n\n    if all_flag:\n        if until_ready or report or again or positional:\n            print(\"attavo drive: --all runs one pass in every worktree beside this checkout; \"\n                  \"drop N and every other flag\", file=sys.stderr)\n            return 2\n        return _drive_all()\n\n    root = Path(\".\").resolve()\n    item_id = positional[0] if positional else derive_item_id(root)\n    if not item_id:\n        print(\"attavo drive: cannot derive item id; pass N or run on an attavo/N-* branch\",\n              file=sys.stderr)\n        return 2\n    m = read_manifest(root)\n    if m is None:\n        print(f\"attavo drive: no {MANIFEST} at {root}\", file=sys.stderr)\n        return 2\n\n    if report:\n        if until_ready or again:\n            print(\"attavo drive: --report reads and does nothing else; drop --until-ready \"\n                  \"and --again\", file=sys.stderr)\n            return 2\n        fast_forward_to_origin(root, m, item_id)\n        from attavo.report import drive_report\n        print(json.dumps(drive_report(root, m, item_id), indent=2))\n        return 0\n\n    if until_ready:\n        return _until_ready(root, m, item_id, again)\n    rc, _ = _pass_once(root, m, item_id, again)\n    return rc\n","numLines":752,"startLine":1,"totalLines":752}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01777PdpteRGmsEuqw7WoMVM","type":"tool_result","content":"629\t\n630\t    assert record_files(root, \"verify\") == []\n631\t\n632\t\n633\t\n634\tdef test_drive_halts_on_a_question_and_again_resumes_at_build_after_a_ruling(tmp_path: Path) -> None:\n635\t    \"\"\"Acceptance row 5, under R2. The fixture adapter halts with a\n636\t    question: the worker writes the halted record naming it and pushes\n637\t    it, same as any other record. After a ruling is appended, a plain\n638\t    pass leaves the stopped stage alone (the level is the operator's\n639\t    until rulings are records, R4); `--again` starts the next attempt,\n640\t    which this time passes.\"\"\"\n641\t    root = make_tenant(tmp_path, \"build_valid\")\n642\t    add_forge(root, GREEN_FORGE)\n643\t    bare = add_bare_remote(root, tmp_path)\n644\t    approve_item(root)\n645\t    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n646\t\n647\t    run = drive(root, \"1\", env={\"ATTAVO_FIXTURE_QUESTION\": \"which overlay wins?\"})\n648\t    assert run.returncode == 0, run.stdout + run.stderr\n649\t\n650\t    rec = latest_record(root, \"build\")\n651\t    assert rec[\"status\"] == \"halted\"\n652\t    assert rec[\"halted\"] == {\"question\": \"which overlay wins?\"}\n653\t    record_path = record_files(root, \"build\")[-1]\n654\t    assert f\"halted ({record_path.name})\" in run.stdout\n655\t\n656\t    # The halted record was still committed and pushed.\n657\t    assert remote_head(bare, branch) == head_of(root)\n658\t\n659\t    rulings = root / \"rulings.md\"\n660\t    rulings.write_text(rulings.read_text() + \"\\n- overlay: use the base tree\\n\"\n661\t                       if rulings.exists() else \"- overlay: use the base tree\\n\")\n662\t    commit_all(root, \"rule on the overlay question\")\n663\t    git(root, \"push\", \"origin\", f\"HEAD:{branch}\")\n664\t\n665\t    left = drive(root, \"1\")\n666\t    assert left.returncode == 0, left.stdout + left.stderr\n667\t    assert \"Needs you\" in left.stdout\n668\t    assert len(record_files(root, \"build\")) == 1\n669\t\n670\t    run2 = drive(root, \"1\", \"--again\")\n671\t    assert run2.returncode == 0, run2.stdout + run2.stderr\n672\t\n673\t    assert len(record_files(root, \"build\")) == 2\n674\t    rec2 = latest_record(root, \"build\")\n675\t    assert rec2[\"status\"] == \"pass\"\n676\t    assert remote_head(bare, branch) == head_of(root)\n677\t\n678\t\n679\tdef configure_counsel(root: Path) -> None:\n680\t    \"\"\"[executor].counsel = \"fixture\" -- build_valid's own manifest\n681\t    declares [executor].build = \"fixture\" only; counsel needs its own\n682\t    adapter named (issue #100).\"\"\"\n683\t    toml = root / \"attavo.toml\"\n684\t    toml.write_text(toml.read_text().replace(\n685\t        '[executor]\\nbuild = \"fixture\"', '[executor]\\nbuild = \"fixture\"\\ncounsel = \"fixture\"'))\n686\t    commit_all(root, \"configure the counsel adapter\")\n687\t\n688\t\n689\tdef test_drive_counsels_a_stop_before_filing_it_and_commits_both_records_together(tmp_path: Path) -> None:\n690\t    \"\"\"Issue #100, acceptance row 3. On a stop, drive calls counsel\n691\t    before file-stops, and commits the counsel record with the stage\n692\t    record in one commit.\"\"\"\n693\t    root = make_tenant(tmp_path, \"build_valid\")\n694\t    add_forge(root, GREEN_FORGE)\n695\t    bare = add_bare_remote(root, tmp_path)\n696\t    configure_counsel(root)\n697\t    approve_item(root)\n698\t    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n699\t    filed = tmp_path / \"filed.jsonl\"\n700\t    configure_filing(root, filed)\n701\t\n702\t    run = drive(root, \"1\", env={\"ATTAVO_FIXTURE_QUESTION\": \"which overlay wins?\"})\n703\t    assert run.returncode == 0, run.stdout + run.stderr\n704\t\n705\t    assert record_files(root, \"counsel\")\n706\t    counsel_rec = latest_record(root, \"counsel\")\n707\t    assert counsel_rec[\"record_stage\"] == \"build\"\n708\t    assert counsel_rec[\"record\"] == \"build-01\"\n709\t    assert counsel_rec[\"verdict\"] == \"person\"\n710\t\n711\t    committed = set(last_commit_paths(root))\n712\t    assert committed == {\n713\t        \"records/1/build-01.json\", \"records/1/build-01.log\",\n714\t        \"records/1/counsel-01.json\", \"records/1/counsel-01.log\",\n715\t        \"records/1/build-01.filed\",\n716\t    }\n717\t    assert remote_head(bare, branch) == head_of(root)\n718\t\n719\t    filed_bodies = [json.loads(l) for l in filed.read_text().splitlines() if l.strip()]\n720\t    assert len(filed_bodies) == 1\n721\t    assert filed_bodies[0][\"counsel_verdict\"] == \"person\"\n722\t    assert filed_bodies[0][\"counsel_proposal\"][\"question\"]\n723\t\n724\t\n725\tdef test_drive_still_files_a_stop_with_no_counsel_adapter_configured(tmp_path: Path) -> None:\n726\t    \"\"\"counsel refuses gracefully (no [executor].counsel or\n727\t    [executor].verify) -- drive still files and transports the stage\n728\t    record; nothing new for counsel to commit.\"\"\"\n729\t    root = make_tenant(tmp_path, \"build_valid\")\n730\t    add_forge(root, GREEN_FORGE)\n731\t    bare = add_bare_remote(root, tmp_path)\n732\t    approve_item(root)\n733\t    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n734\t    filed = tmp_path / \"filed.jsonl\"\n735\t    configure_filing(root, filed)\n736\t\n737\t    run = drive(root, \"1\", env={\"ATTAVO_FIXTURE_QUESTION\": \"which overlay wins?\"})\n738\t    assert run.returncode == 0, run.stdout + run.stderr\n739\t\n740\t    assert record_files(root, \"counsel\") == []\n741\t    committed = set(last_commit_paths(root))\n742\t    assert committed == {\"records/1/build-01.json\", \"records/1/build-01.log\",\n743\t                         \"records/1/build-01.filed\"}\n744\t    assert remote_head(bare, branch) == head_of(root)\n745\t\n746\t\n747\tdef configure_filing(root: Path, filed_path: Path) -> None:\n748\t    \"\"\"Appended under the [forge] table add_forge already opened -- a\n749\t    second [forge] header in the same file is a TOML redeclaration\n750\t    error. Prints a fake issue URL on stdout, numbered by filed_path's\n751\t    own line count so far -- the fact a real file_issue_command's stdout\n752\t    would carry, and what the .filed marker beside each stop record is\n753\t    meant to hold (issue #89).\"\"\"\n754\t    toml = root / \"attavo.toml\"\n755\t    command = (f\"n=$(wc -l < {filed_path} 2>/dev/null || echo 0); \"\n756\t              f\"cat >> {filed_path}; \"\n757\t              f\"echo https://github.com/tenant/repo/issues/$((n + 1))\")\n758\t    toml.write_text(toml.read_text() + f\"\\nfile_issue_command = '{command}'\\n\")\n759\t    commit_all(root, \"configure issue filing\")\n760\t\n761\t\n762\t\n763\tdef test_drive_files_a_stop_it_reports_exactly_once(tmp_path: Path) -> None:\n764\t    \"\"\"Issue #89, acceptance row 5. A stop the worker reports -- here,\n765\t    the fixture adapter's halt -- calls file-stops once: one attempt\n766\t    files exactly one issue for the record it just wrote, not zero and\n767\t    not more than one.\"\"\"\n768\t    root = make_tenant(tmp_path, \"build_valid\")\n769\t    add_forge(root, GREEN_FORGE)\n770\t    add_bare_remote(root, tmp_path)\n771\t    approve_item(root)\n772\t    filed = tmp_path / \"filed.jsonl\"\n773\t    configure_filing(root, filed)\n774\t\n775\t    run = drive(root, \"1\", env={\"ATTAVO_FIXTURE_QUESTION\": \"which overlay wins?\"})\n776\t    assert run.returncode == 0, run.stdout + run.stderr\n777\t\n778\t    filed_bodies = [json.loads(l) for l in filed.read_text().splitlines() if l.strip()]\n779\t    assert len(filed_bodies) == 1\n780\t    assert filed_bodies[0][\"record\"] == \"records/1/build-01.json\"\n781\t\n782\t    # The next attempt (`--again`) halts again -- build-02 -- and files\n783\t    # exactly one more issue for that new record; file-stops' own .filed\n784\t    # marker means build-01's issue is never filed twice.\n785\t    run2 = drive(root, \"1\", \"--again\", env={\"ATTAVO_FIXTURE_QUESTION\": \"which overlay wins?\"})\n786\t    assert run2.returncode == 0, run2.stdout + run2.stderr\n787\t    assert len(record_files(root, \"build\")) == 2\n788\t\n789\t    filed_bodies_after = [json.loads(l) for l in filed.read_text().splitlines() if l.strip()]\n790\t    assert len(filed_bodies_after) == 2\n791\t    assert filed_bodies_after[0] == filed_bodies[0]\n792\t    assert filed_bodies_after[1][\"record\"] == \"records/1/build-02.json\"\n793\t\n794\t\n795\tdef test_drive_marker_holds_the_filing_commands_stdout_and_is_committed_with_the_record(tmp_path: Path) -> None:\n796\t    \"\"\"A stop's own .filed marker is written before the record is\n797\t    transported, so it carries the filing command's stdout (the issue it\n798\t    opened) and rides in the very same commit as the record and its log\n799\t    -- one commit, one push, as before this fix. Red before it: the\n800\t    marker was written empty, after commit_record and push_record_commit\n801\t    had already run, so it was never part of any commit at all.\n802\t    \"\"\"\n803\t    root = make_tenant(tmp_path, \"build_valid\")\n804\t    add_forge(root, GREEN_FORGE)\n805\t    bare = add_bare_remote(root, tmp_path)\n806\t    approve_item(root)\n807\t    filed = tmp_path / \"filed.jsonl\"\n808\t    configure_filing(root, filed)\n809\t\n810\t    run = drive(root, \"1\", env={\"ATTAVO_FIXTURE_QUESTION\": \"which overlay wins?\"})\n811\t    assert run.returncode == 0, run.stdout + run.stderr\n812\t\n813\t    marker_path = records_dir(root) / \"build-01.filed\"\n814\t    assert marker_path.is_file()\n815\t    assert marker_path.read_text().strip() == \"https://github.com/tenant/repo/issues/1\"\n816\t\n817\t    committed = set(last_commit_paths(root))\n818\t    assert committed == {\"records/1/build-01.json\", \"records/1/build-01.log\",\n819\t                         \"records/1/build-01.filed\"}\n820\t    assert remote_head(bare) == head_of(root)\n821\t\n822\t\n823\tdef test_drive_a_second_run_in_the_same_state_files_nothing(tmp_path: Path) -> None:\n824\t    \"\"\"Issue #89. The marker committed and pushed above is the fact a\n825\t    second worktree or a fresh clone reads too -- a second drive run\n826\t    against the same records, from a fresh clone of the remote drive\n827\t    already pushed to, files nothing for the stop that clone already\n828\t    carries a marker for. Red before this fix: the marker never reached\n829\t    the remote at all, so every clone refiled every stop it found.\n830\t    \"\"\"\n831\t    root = make_tenant(tmp_path, \"build_valid\")\n832\t    add_forge(root, GREEN_FORGE)\n833\t    bare = add_bare_remote(root, tmp_path)\n834\t    approve_item(root)\n835\t    filed = tmp_path / \"filed.jsonl\"\n836\t    configure_filing(root, filed)\n837\t\n838\t    run = drive(root, \"1\", env={\"ATTAVO_FIXTURE_QUESTION\": \"which overlay wins?\"})\n839\t    assert run.returncode == 0, run.stdout + run.stderr\n840\t    filed_after_first = filed.read_text()\n841\t    assert filed_after_first.strip() != \"\"\n842\t\n843\t    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n844\t    clone = tmp_path / \"fresh-clone\"\n845\t    subprocess.run([\"git\", \"clone\", \"--quiet\", \"--branch\", branch, str(bare), str(clone)],\n846\t                   check=True)\n847\t\n848\t    run2 = run_attavo(clone, \"file-stops\", \"1\")\n849\t    assert run2.returncode == 0\n850\t    assert \"no stops to file\" in run2.stdout\n851\t    assert filed.read_text() == filed_after_first  # nothing new was filed\n852\t\n853\t\n854\t\n855\tdef slow_build_adapter(root: Path, seconds: float) -> None:\n856\t    \"\"\"A tenant-side build adapter: the product's own fixture adapter,\n857\t    after `seconds` of sleep on the build stage -- long enough for a test\n858\t    to act between the pass's marker push and the worker's record push.\"\"\"\n859\t    d = root / \"attavo\" / \"adapters\" / \"fixture\"\n860\t    d.mkdir(parents=True, exist_ok=True)\n861\t    run = d / \"run\"\n862\t    run.write_text(f'#!/bin/sh\\nif [ \"${{ATTAVO_STAGE:-build}}\" = build ]; then sleep {seconds}; fi\\n'\n863\t                   f'exec sh {ROOT / \"adapters\" / \"fixture\" / \"run\"}\\n')\n864\t    run.chmod(0o755)\n865\t    commit_all(root, \"a slow tenant-side adapter\")\n866\t\n867\t\n868\tdef test_drive_pass_fast_forwards_to_a_branch_that_moved_before_taking_the_lease(tmp_path: Path) -> None:\n869\t    \"\"\"R2. A commit landed on the branch from elsewhere before the pass\n870\t    -- an approval from the screen, a ruling, another pass's record -- is\n871\t    not a race for the lease: the pass fast-forwards to origin first, so\n872\t    its report and its marker sit on the branch as the forge holds it,\n873\t    and the marker push is a plain fast-forward.\"\"\"\n874\t    root = make_tenant(tmp_path, \"build_valid\")\n875\t    add_forge(root, GREEN_FORGE)\n876\t    bare = add_bare_remote(root, tmp_path)\n877\t    approve_item(root)\n878\t    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n879\t\n880\t    other = tmp_path / \"other-clone\"\n881\t    subprocess.run([\"git\", \"clone\", \"--quiet\", str(bare), str(other)], check=True)\n882\t    subprocess.run([\"git\", \"-C\", str(other), \"checkout\", \"-q\", branch], check=True)\n883\t    subprocess.run([\"git\", \"-C\", str(other), \"config\", \"user.email\", \"other@example.com\"],\n884\t                   check=True)\n885\t    subprocess.run([\"git\", \"-C\", str(other), \"config\", \"user.name\", \"Other\"], check=True)\n886\t    (other / \"concurrent.txt\").write_text(\"from elsewhere\\n\")\n887\t    subprocess.run([\"git\", \"-C\", str(other), \"add\", \"-A\"], check=True)\n888\t    subprocess.run([\"git\", \"-C\", str(other), \"commit\", \"-q\", \"-m\", \"a concurrent commit\"],\n889\t                   check=True)\n890\t    subprocess.run([\"git\", \"-C\", str(other), \"push\", \"origin\", f\"HEAD:{branch}\"], check=True)\n891\t\n892\t    run = drive(root, \"1\")\n893\t    assert run.returncode == 0, run.stdout + run.stderr\n894\t    assert \"another pass holds\" not in run.stdout\n895\t    assert \"worker pid\" in run.stdout\n896\t\n897\t    rec = latest_record(root, \"build\")\n898\t    assert rec[\"status\"] == \"pass\"\n899\t    assert git(root, \"log\", \"--merges\", \"--format=%H\", \"HEAD\").split() == []\n900\t    assert remote_head(bare, branch) == head_of(root)\n901\t    assert \"concurrent.txt\" in git(root, \"ls-tree\", \"-r\", \"--name-only\", \"HEAD\")\n902\t\n903\t\n904\tdef test_drive_worker_retries_a_rejected_record_push_with_a_merge_never_a_rebase(tmp_path: Path) -> None:\n905\t    \"\"\"Acceptance row 7, under R2. The branch moves while the worker\n906\t    runs -- after the pass's marker push, before the worker's record\n907\t    push: the record push is rejected, retried after `git pull\n908\t    --no-rebase --no-edit`, never a rebase; the build record's own sha is\n909\t    unchanged (still reachable, still what the record names), and the\n910\t    retry lands a merge commit, not a rewritten one.\"\"\"\n911\t    root = make_tenant(tmp_path, \"build_valid\")\n912\t    add_forge(root, GREEN_FORGE)\n913\t    bare = add_bare_remote(root, tmp_path)\n914\t    slow_build_adapter(root, 3)\n915\t    approve_item(root)\n916\t    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n917\t\n918\t    run = run_attavo(root, \"drive\", \"1\")\n919\t    assert run.returncode == 0, run.stdout + run.stderr\n920\t    assert \"worker pid\" in run.stdout\n921\t    assert \"invocation 01 started\" in subprocess.run(\n922\t        [\"git\", \"-C\", str(bare), \"log\", \"-1\", \"--format=%s\", branch],\n923\t        capture_output=True, text=True).stdout\n924\t\n925\t    other = tmp_path / \"other-clone\"\n926\t    subprocess.run([\"git\", \"clone\", \"--quiet\", str(bare), str(other)], check=True)\n927\t    subprocess.run([\"git\", \"-C\", str(other), \"checkout\", \"-q\", branch], check=True)\n928\t    subprocess.run([\"git\", \"-C\", str(other), \"config\", \"user.email\", \"other@example.com\"],\n929\t                   check=True)\n930\t    subprocess.run([\"git\", \"-C\", str(other), \"config\", \"user.name\", \"Other\"], check=True)\n931\t    (other / \"concurrent.txt\").write_text(\"from elsewhere\\n\")\n932\t    subprocess.run([\"git\", \"-C\", str(other), \"add\", \"-A\"], check=True)\n933\t    subprocess.run([\"git\", \"-C\", str(other), \"commit\", \"-q\", \"-m\", \"a concurrent commit\"],\n934\t                   check=True)\n935\t    subprocess.run([\"git\", \"-C\", str(other), \"push\", \"origin\", f\"HEAD:{branch}\"], check=True)\n936\t\n937\t    waiting = drive(root, \"1\")  # a pass while the worker holds the copy: reads, touches nothing\n938\t    assert waiting.returncode == 0, waiting.stdout + waiting.stderr\n939\t    assert \"running\" in waiting.stdout\n940\t    assert \"concurrent.txt\" not in git(root, \"ls-tree\", \"-r\", \"--name-only\", \"HEAD\")\n941\t\n942\t    deadline = time.monotonic() + 60\n943\t    while time.monotonic() < deadline and not (\n944\t            record_files(root, \"build\") and remote_head(bare, branch) == head_of(root)):\n945\t        time.sleep(0.3)\n946\t\n947\t    rec = latest_record(root, \"build\")\n948\t    assert rec[\"status\"] == \"pass\"\n949\t    build_sha = rec[\"sha\"]\n950\t    assert build_sha in git(root, \"rev-list\", \"HEAD\").split()\n951\t\n952\t    merges = git(root, \"log\", \"--merges\", \"--format=%H\", \"HEAD\").split()\n953\t    assert merges, \"the retry should have landed a merge commit\"\n954\t\n955\t    assert remote_head(bare, branch) == head_of(root)\n956\t    assert \"concurrent.txt\" in git(root, \"ls-tree\", \"-r\", \"--name-only\", \"HEAD\")\n957\t\n958\t\n959\t\n960\tdef test_drive_a_refused_marker_push_ends_the_pass_with_exit_1(tmp_path: Path) -> None:\n961\t    \"\"\"A remote whose pre-receive hook refuses every push is a refusal,\n962\t    not a lease held by another pass: the pass says why, exits 1, raises\n963\t    nothing, starts no worker, and with --until-ready does not pass\n964\t    again. Distinct from a non-fast-forward rejection, which is the\n965\t    lease (test_pass).\"\"\"\n966\t    root = make_tenant(tmp_path, \"build_valid\")\n967\t    add_forge(root, GREEN_FORGE)\n968\t    bare = add_bare_remote(root, tmp_path)\n969\t    approve_item(root)\n970\t    hook = bare / \"hooks\" / \"pre-receive\"\n971\t    hook.write_text(\"#!/bin/sh\\necho 'refused by the fixture remote' >&2\\nexit 1\\n\")\n972\t    hook.chmod(0o755)\n973\t\n974\t    run = run_attavo(root, \"drive\", \"1\", \"--until-ready\")\n975\t    assert run.returncode == 1, run.stdout + run.stderr\n976\t    assert \"Traceback\" not in run.stderr, run.stderr\n977\t    assert \"could not push the build invocation marker\" in run.stdout, run.stdout\n978\t    assert \"another pass holds\" not in run.stdout\n979\t    assert \"worker pid\" not in run.stdout\n980\t    assert record_files(root, \"build\") == []\n981\t    assert not (records_dir(root) / \"build-01.started\").exists()\n982\t\n983\t\n984\tdef test_drive_commits_and_pushes_an_invocation_marker_before_the_stage_runs(tmp_path: Path) -> None:\n985\t    \"\"\"Issue #151: the invocation's own marker is a fact on the branch\n986\t    before the stage runs -- its own commit, authored by the driver\n987\t    identity, landing and pushed ahead of the stage record's commit.\"\"\"\n988\t    root = make_tenant(tmp_path, \"build_valid\")\n989\t    add_forge(root, GREEN_FORGE)\n990\t    bare = add_bare_remote(root, tmp_path)\n991\t    approve_item(root)\n992\t    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n993\t\n994\t    run = drive(root, \"1\")\n995\t    assert run.returncode == 0, run.stdout + run.stderr\n996\t\n997\t    marker = records_dir(root) / \"build-01.started\"\n998\t    assert marker.is_file()\n999\t    info = json.loads(marker.read_text())\n1000\t    assert info[\"host\"] == socket.gethostname()\n1001\t    assert isinstance(info[\"pid\"], int)\n1002\t\n1003\t    marker_commit = git(root, \"log\", \"--format=%H\", \"--\", str(marker.relative_to(root))).split()[-1]\n1004\t    build_commit = head_of(root)\n1005\t    assert marker_commit != build_commit\n1006\t    # the marker's own commit is an ancestor of the build record's commit\n1007\t    assert git(root, \"merge-base\", \"--is-ancestor\", marker_commit, build_commit) == \"\"\n1008\t\n1009\t    assert git(root, \"log\", \"-1\", \"--format=%an\", marker_commit).strip() == \"attavo driver\"\n1010\t    assert remote_head(bare, branch) == head_of(root)\n1011\t\n1012\t\n1013\t\n1014\tdef test_drive_pass_writes_a_died_record_for_a_dead_invocation(tmp_path: Path) -> None:\n1015\t    \"\"\"Issue #151, under R2: the pass itself retires a build-01.started\n1016\t    marker naming a dead pid with a failed record, class died,\n1017\t    provenance product -- committed by the driver identity, pushed to\n1018\t    the fixture remote. Recovery is the pass's one act that pass; it\n1019\t    starts nothing else.\"\"\"\n1020\t    root = make_tenant(tmp_path, \"build_valid\")\n1021\t    add_drive_stall_bound(root)\n1022\t    bare = add_bare_remote(root, tmp_path)\n1023\t    approve_item(root)\n1024\t    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n1025\t\n1026\t    marker = write_dead_marker(root, \"build\", 1)\n1027\t    git(root, \"push\", \"origin\", f\"HEAD:{branch}\")\n1028\t\n1029\t    run = drive(root, \"1\")\n1030\t    assert run.returncode == 0, run.stdout + run.stderr\n1031\t    assert \"recovered build-01 as died\" in run.stdout\n1032\t    assert \"worker pid\" not in run.stdout\n1033\t\n1034\t    rec = latest_record(root, \"build\")\n1035\t    assert rec[\"status\"] == \"failed\"\n1036\t    assert rec[\"stop\"][\"class\"] == \"died\"\n1037\t    assert rec[\"stop\"][\"provenance\"] == \"product\"\n1038\t    assert \"wrote no build-01.json\" in rec[\"stop\"][\"detail\"]\n1039\t\n1040\t    record_path = record_files(root, \"build\")[-1]\n1041\t    assert record_path.with_suffix(\".log\").exists()\n1042\t    assert git(root, \"log\", \"-1\", \"--format=%an\").strip() == \"attavo driver\"\n1043\t    assert git(root, \"status\", \"--porcelain\", \"--\", str(record_path),\n1044\t              str(record_path.with_suffix(\".log\")), str(marker)).strip() == \"\"\n1045\t    assert remote_head(bare, branch) == head_of(root)\n1046\t    assert marker.is_file()  # the marker itself is left in place, retired by the record\n1047\t\n1048\t\n1049\t\n1050\tdef test_drive_pass_recovers_a_dead_invocation_without_a_stall_bound(tmp_path: Path) -> None:\n1051\t    \"\"\"R2: the stall bound decides hung, not died. With no\n1052\t    [drive].stall_after_s a dead invocation (its heartbeat stale, or no\n1053\t    heartbeat and its pid gone) is still recovered as died; what the\n1054\t    missing bound forgoes is only the hung class -- alive is running for\n1055\t    as long as it lives (test_pass covers the stale heartbeat).\"\"\"\n1056\t    root = make_tenant(tmp_path, \"build_valid\")\n1057\t    add_bare_remote(root, tmp_path)\n1058\t    approve_item(root)\n1059\t\n1060\t    write_dead_marker(root, \"build\", 1)\n1061\t\n1062\t    run = drive(root, \"1\")\n1063\t    assert run.returncode == 0, run.stdout + run.stderr\n1064\t    assert \"recovered build-01 as died\" in run.stdout\n1065\t    assert latest_record(root, \"build\")[\"stop\"][\"class\"] == \"died\"\n1066\t\n1067\t\n1068\tdef test_drive_recover_flag_is_gone(tmp_path: Path) -> None:\n1069\t    \"\"\"R2 retires `attavo drive --recover`: recovery is what a pass does\n1070\t    when the report owes one. The flag is refused with exit 2 and a line\n1071\t    saying so; nothing is read or written.\"\"\"\n1072\t    root = make_tenant(tmp_path, \"build_valid\")\n1073\t    add_drive_stall_bound(root)\n1074\t    add_forge(root, GREEN_FORGE)\n1075\t    add_bare_remote(root, tmp_path)\n1076\t    approve_item(root)\n1077\t    assert drive(root, \"1\").returncode == 0\n1078\t\n1079\t    run = run_attavo(root, \"drive\", \"--recover\", \"1\")\n1080\t    assert run.returncode == 2, run.stdout + run.stderr\n1081\t    assert \"--recover is gone\" in run.stderr\n1082\t    assert len(record_files(root, \"build\")) == 1\n1083\t\n1084\t\n1085\tdef test_drive_forge_poll_defaults_are_a_real_forges_clock() -> None:\n1086\t    \"\"\"The bound and interval every other test overrides with\n1087\t    FAST_POLL_ENV default, unset, to at least five minutes and ten\n1088\t    seconds -- tenant zero's own checks conclude about five minutes after\n1089\t    a push, and a bound shorter than that would make every drive run\n1090\t    after a record push stop on 'forge checks not green', with a person\n1091\t    running it again after CI: exactly the transport act this lane\n1092\t    retires. Row 4 (a forge that never goes green) is unchanged in\n1093\t    meaning by this -- it still stops, just after waiting out a real\n1094\t    forge's own clock instead of a test's fake one.\n1095\t    \"\"\"\n1096\t    module = attavo_module()\n1097\t    assert module.DRIVE_FORGE_POLL_BOUND_DEFAULT_S >= 300\n1098\t    assert module.DRIVE_FORGE_POLL_INTERVAL_DEFAULT_S >= 10"}]},"parent_tool_use_id":null,"session_id":"041a92ee-b14a-4832-b613-6f5a12b6a373","uuid":"8c908ef9-495f-40cd-bd0d-a3ce7d52de1d","timestamp":"2026-09-25T18:06:22.737Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-217/attest/specs/217/stub/tests/test_drive.py","content":"\n    assert record_files(root, \"verify\") == []\n\n\n\ndef test_drive_halts_on_a_question_and_again_resumes_at_build_after_a_ruling(tmp_path: Path) -> None:\n    \"\"\"Acceptance row 5, under R2. The fixture adapter halts with a\n    question: the worker writes the halted record naming it and pushes\n    it, same as any other record. After a ruling is appended, a plain\n    pass leaves the stopped stage alone (the level is the operator's\n    until rulings are records, R4); `--again` starts the next attempt,\n    which this time passes.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    bare = add_bare_remote(root, tmp_path)\n    approve_item(root)\n    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n\n    run = drive(root, \"1\", env={\"ATTAVO_FIXTURE_QUESTION\": \"which overlay wins?\"})\n    assert run.returncode == 0, run.stdout + run.stderr\n\n    rec = latest_record(root, \"build\")\n    assert rec[\"status\"] == \"halted\"\n    assert rec[\"halted\"] == {\"question\": \"which overlay wins?\"}\n    record_path = record_files(root, \"build\")[-1]\n    assert f\"halted ({record_path.name})\" in run.stdout\n\n    # The halted record was still committed and pushed.\n    assert remote_head(bare, branch) == head_of(root)\n\n    rulings = root / \"rulings.md\"\n    rulings.write_text(rulings.read_text() + \"\\n- overlay: use the base tree\\n\"\n                       if rulings.exists() else \"- overlay: use the base tree\\n\")\n    commit_all(root, \"rule on the overlay question\")\n    git(root, \"push\", \"origin\", f\"HEAD:{branch}\")\n\n    left = drive(root, \"1\")\n    assert left.returncode == 0, left.stdout + left.stderr\n    assert \"Needs you\" in left.stdout\n    assert len(record_files(root, \"build\")) == 1\n\n    run2 = drive(root, \"1\", \"--again\")\n    assert run2.returncode == 0, run2.stdout + run2.stderr\n\n    assert len(record_files(root, \"build\")) == 2\n    rec2 = latest_record(root, \"build\")\n    assert rec2[\"status\"] == \"pass\"\n    assert remote_head(bare, branch) == head_of(root)\n\n\ndef configure_counsel(root: Path) -> None:\n    \"\"\"[executor].counsel = \"fixture\" -- build_valid's own manifest\n    declares [executor].build = \"fixture\" only; counsel needs its own\n    adapter named (issue #100).\"\"\"\n    toml = root / \"attavo.toml\"\n    toml.write_text(toml.read_text().replace(\n        '[executor]\\nbuild = \"fixture\"', '[executor]\\nbuild = \"fixture\"\\ncounsel = \"fixture\"'))\n    commit_all(root, \"configure the counsel adapter\")\n\n\ndef test_drive_counsels_a_stop_before_filing_it_and_commits_both_records_together(tmp_path: Path) -> None:\n    \"\"\"Issue #100, acceptance row 3. On a stop, drive calls counsel\n    before file-stops, and commits the counsel record with the stage\n    record in one commit.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    bare = add_bare_remote(root, tmp_path)\n    configure_counsel(root)\n    approve_item(root)\n    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n    filed = tmp_path / \"filed.jsonl\"\n    configure_filing(root, filed)\n\n    run = drive(root, \"1\", env={\"ATTAVO_FIXTURE_QUESTION\": \"which overlay wins?\"})\n    assert run.returncode == 0, run.stdout + run.stderr\n\n    assert record_files(root, \"counsel\")\n    counsel_rec = latest_record(root, \"counsel\")\n    assert counsel_rec[\"record_stage\"] == \"build\"\n    assert counsel_rec[\"record\"] == \"build-01\"\n    assert counsel_rec[\"verdict\"] == \"person\"\n\n    committed = set(last_commit_paths(root))\n    assert committed == {\n        \"records/1/build-01.json\", \"records/1/build-01.log\",\n        \"records/1/counsel-01.json\", \"records/1/counsel-01.log\",\n        \"records/1/build-01.filed\",\n    }\n    assert remote_head(bare, branch) == head_of(root)\n\n    filed_bodies = [json.loads(l) for l in filed.read_text().splitlines() if l.strip()]\n    assert len(filed_bodies) == 1\n    assert filed_bodies[0][\"counsel_verdict\"] == \"person\"\n    assert filed_bodies[0][\"counsel_proposal\"][\"question\"]\n\n\ndef test_drive_still_files_a_stop_with_no_counsel_adapter_configured(tmp_path: Path) -> None:\n    \"\"\"counsel refuses gracefully (no [executor].counsel or\n    [executor].verify) -- drive still files and transports the stage\n    record; nothing new for counsel to commit.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    bare = add_bare_remote(root, tmp_path)\n    approve_item(root)\n    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n    filed = tmp_path / \"filed.jsonl\"\n    configure_filing(root, filed)\n\n    run = drive(root, \"1\", env={\"ATTAVO_FIXTURE_QUESTION\": \"which overlay wins?\"})\n    assert run.returncode == 0, run.stdout + run.stderr\n\n    assert record_files(root, \"counsel\") == []\n    committed = set(last_commit_paths(root))\n    assert committed == {\"records/1/build-01.json\", \"records/1/build-01.log\",\n                         \"records/1/build-01.filed\"}\n    assert remote_head(bare, branch) == head_of(root)\n\n\ndef configure_filing(root: Path, filed_path: Path) -> None:\n    \"\"\"Appended under the [forge] table add_forge already opened -- a\n    second [forge] header in the same file is a TOML redeclaration\n    error. Prints a fake issue URL on stdout, numbered by filed_path's\n    own line count so far -- the fact a real file_issue_command's stdout\n    would carry, and what the .filed marker beside each stop record is\n    meant to hold (issue #89).\"\"\"\n    toml = root / \"attavo.toml\"\n    command = (f\"n=$(wc -l < {filed_path} 2>/dev/null || echo 0); \"\n              f\"cat >> {filed_path}; \"\n              f\"echo https://github.com/tenant/repo/issues/$((n + 1))\")\n    toml.write_text(toml.read_text() + f\"\\nfile_issue_command = '{command}'\\n\")\n    commit_all(root, \"configure issue filing\")\n\n\n\ndef test_drive_files_a_stop_it_reports_exactly_once(tmp_path: Path) -> None:\n    \"\"\"Issue #89, acceptance row 5. A stop the worker reports -- here,\n    the fixture adapter's halt -- calls file-stops once: one attempt\n    files exactly one issue for the record it just wrote, not zero and\n    not more than one.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    add_bare_remote(root, tmp_path)\n    approve_item(root)\n    filed = tmp_path / \"filed.jsonl\"\n    configure_filing(root, filed)\n\n    run = drive(root, \"1\", env={\"ATTAVO_FIXTURE_QUESTION\": \"which overlay wins?\"})\n    assert run.returncode == 0, run.stdout + run.stderr\n\n    filed_bodies = [json.loads(l) for l in filed.read_text().splitlines() if l.strip()]\n    assert len(filed_bodies) == 1\n    assert filed_bodies[0][\"record\"] == \"records/1/build-01.json\"\n\n    # The next attempt (`--again`) halts again -- build-02 -- and files\n    # exactly one more issue for that new record; file-stops' own .filed\n    # marker means build-01's issue is never filed twice.\n    run2 = drive(root, \"1\", \"--again\", env={\"ATTAVO_FIXTURE_QUESTION\": \"which overlay wins?\"})\n    assert run2.returncode == 0, run2.stdout + run2.stderr\n    assert len(record_files(root, \"build\")) == 2\n\n    filed_bodies_after = [json.loads(l) for l in filed.read_text().splitlines() if l.strip()]\n    assert len(filed_bodies_after) == 2\n    assert filed_bodies_after[0] == filed_bodies[0]\n    assert filed_bodies_after[1][\"record\"] == \"records/1/build-02.json\"\n\n\ndef test_drive_marker_holds_the_filing_commands_stdout_and_is_committed_with_the_record(tmp_path: Path) -> None:\n    \"\"\"A stop's own .filed marker is written before the record is\n    transported, so it carries the filing command's stdout (the issue it\n    opened) and rides in the very same commit as the record and its log\n    -- one commit, one push, as before this fix. Red before it: the\n    marker was written empty, after commit_record and push_record_commit\n    had already run, so it was never part of any commit at all.\n    \"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    bare = add_bare_remote(root, tmp_path)\n    approve_item(root)\n    filed = tmp_path / \"filed.jsonl\"\n    configure_filing(root, filed)\n\n    run = drive(root, \"1\", env={\"ATTAVO_FIXTURE_QUESTION\": \"which overlay wins?\"})\n    assert run.returncode == 0, run.stdout + run.stderr\n\n    marker_path = records_dir(root) / \"build-01.filed\"\n    assert marker_path.is_file()\n    assert marker_path.read_text().strip() == \"https://github.com/tenant/repo/issues/1\"\n\n    committed = set(last_commit_paths(root))\n    assert committed == {\"records/1/build-01.json\", \"records/1/build-01.log\",\n                         \"records/1/build-01.filed\"}\n    assert remote_head(bare) == head_of(root)\n\n\ndef test_drive_a_second_run_in_the_same_state_files_nothing(tmp_path: Path) -> None:\n    \"\"\"Issue #89. The marker committed and pushed above is the fact a\n    second worktree or a fresh clone reads too -- a second drive run\n    against the same records, from a fresh clone of the remote drive\n    already pushed to, files nothing for the stop that clone already\n    carries a marker for. Red before this fix: the marker never reached\n    the remote at all, so every clone refiled every stop it found.\n    \"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    bare = add_bare_remote(root, tmp_path)\n    approve_item(root)\n    filed = tmp_path / \"filed.jsonl\"\n    configure_filing(root, filed)\n\n    run = drive(root, \"1\", env={\"ATTAVO_FIXTURE_QUESTION\": \"which overlay wins?\"})\n    assert run.returncode == 0, run.stdout + run.stderr\n    filed_after_first = filed.read_text()\n    assert filed_after_first.strip() != \"\"\n\n    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n    clone = tmp_path / \"fresh-clone\"\n    subprocess.run([\"git\", \"clone\", \"--quiet\", \"--branch\", branch, str(bare), str(clone)],\n                   check=True)\n\n    run2 = run_attavo(clone, \"file-stops\", \"1\")\n    assert run2.returncode == 0\n    assert \"no stops to file\" in run2.stdout\n    assert filed.read_text() == filed_after_first  # nothing new was filed\n\n\n\ndef slow_build_adapter(root: Path, seconds: float) -> None:\n    \"\"\"A tenant-side build adapter: the product's own fixture adapter,\n    after `seconds` of sleep on the build stage -- long enough for a test\n    to act between the pass's marker push and the worker's record push.\"\"\"\n    d = root / \"attavo\" / \"adapters\" / \"fixture\"\n    d.mkdir(parents=True, exist_ok=True)\n    run = d / \"run\"\n    run.write_text(f'#!/bin/sh\\nif [ \"${{ATTAVO_STAGE:-build}}\" = build ]; then sleep {seconds}; fi\\n'\n                   f'exec sh {ROOT / \"adapters\" / \"fixture\" / \"run\"}\\n')\n    run.chmod(0o755)\n    commit_all(root, \"a slow tenant-side adapter\")\n\n\ndef test_drive_pass_fast_forwards_to_a_branch_that_moved_before_taking_the_lease(tmp_path: Path) -> None:\n    \"\"\"R2. A commit landed on the branch from elsewhere before the pass\n    -- an approval from the screen, a ruling, another pass's record -- is\n    not a race for the lease: the pass fast-forwards to origin first, so\n    its report and its marker sit on the branch as the forge holds it,\n    and the marker push is a plain fast-forward.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    bare = add_bare_remote(root, tmp_path)\n    approve_item(root)\n    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n\n    other = tmp_path / \"other-clone\"\n    subprocess.run([\"git\", \"clone\", \"--quiet\", str(bare), str(other)], check=True)\n    subprocess.run([\"git\", \"-C\", str(other), \"checkout\", \"-q\", branch], check=True)\n    subprocess.run([\"git\", \"-C\", str(other), \"config\", \"user.email\", \"other@example.com\"],\n                   check=True)\n    subprocess.run([\"git\", \"-C\", str(other), \"config\", \"user.name\", \"Other\"], check=True)\n    (other / \"concurrent.txt\").write_text(\"from elsewhere\\n\")\n    subprocess.run([\"git\", \"-C\", str(other), \"add\", \"-A\"], check=True)\n    subprocess.run([\"git\", \"-C\", str(other), \"commit\", \"-q\", \"-m\", \"a concurrent commit\"],\n                   check=True)\n    subprocess.run([\"git\", \"-C\", str(other), \"push\", \"origin\", f\"HEAD:{branch}\"], check=True)\n\n    run = drive(root, \"1\")\n    assert run.returncode == 0, run.stdout + run.stderr\n    assert \"another pass holds\" not in run.stdout\n    assert \"worker pid\" in run.stdout\n\n    rec = latest_record(root, \"build\")\n    assert rec[\"status\"] == \"pass\"\n    assert git(root, \"log\", \"--merges\", \"--format=%H\", \"HEAD\").split() == []\n    assert remote_head(bare, branch) == head_of(root)\n    assert \"concurrent.txt\" in git(root, \"ls-tree\", \"-r\", \"--name-only\", \"HEAD\")\n\n\ndef test_drive_worker_retries_a_rejected_record_push_with_a_merge_never_a_rebase(tmp_path: Path) -> None:\n    \"\"\"Acceptance row 7, under R2. The branch moves while the worker\n    runs -- after the pass's marker push, before the worker's record\n    push: the record push is rejected, retried after `git pull\n    --no-rebase --no-edit`, never a rebase; the build record's own sha is\n    unchanged (still reachable, still what the record names), and the\n    retry lands a merge commit, not a rewritten one.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    bare = add_bare_remote(root, tmp_path)\n    slow_build_adapter(root, 3)\n    approve_item(root)\n    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n\n    run = run_attavo(root, \"drive\", \"1\")\n    assert run.returncode == 0, run.stdout + run.stderr\n    assert \"worker pid\" in run.stdout\n    assert \"invocation 01 started\" in subprocess.run(\n        [\"git\", \"-C\", str(bare), \"log\", \"-1\", \"--format=%s\", branch],\n        capture_output=True, text=True).stdout\n\n    other = tmp_path / \"other-clone\"\n    subprocess.run([\"git\", \"clone\", \"--quiet\", str(bare), str(other)], check=True)\n    subprocess.run([\"git\", \"-C\", str(other), \"checkout\", \"-q\", branch], check=True)\n    subprocess.run([\"git\", \"-C\", str(other), \"config\", \"user.email\", \"other@example.com\"],\n                   check=True)\n    subprocess.run([\"git\", \"-C\", str(other), \"config\", \"user.name\", \"Other\"], check=True)\n    (other / \"concurrent.txt\").write_text(\"from elsewhere\\n\")\n    subprocess.run([\"git\", \"-C\", str(other), \"add\", \"-A\"], check=True)\n    subprocess.run([\"git\", \"-C\", str(other), \"commit\", \"-q\", \"-m\", \"a concurrent commit\"],\n                   check=True)\n    subprocess.run([\"git\", \"-C\", str(other), \"push\", \"origin\", f\"HEAD:{branch}\"], check=True)\n\n    waiting = drive(root, \"1\")  # a pass while the worker holds the copy: reads, touches nothing\n    assert waiting.returncode == 0, waiting.stdout + waiting.stderr\n    assert \"running\" in waiting.stdout\n    assert \"concurrent.txt\" not in git(root, \"ls-tree\", \"-r\", \"--name-only\", \"HEAD\")\n\n    deadline = time.monotonic() + 60\n    while time.monotonic() < deadline and not (\n            record_files(root, \"build\") and remote_head(bare, branch) == head_of(root)):\n        time.sleep(0.3)\n\n    rec = latest_record(root, \"build\")\n    assert rec[\"status\"] == \"pass\"\n    build_sha = rec[\"sha\"]\n    assert build_sha in git(root, \"rev-list\", \"HEAD\").split()\n\n    merges = git(root, \"log\", \"--merges\", \"--format=%H\", \"HEAD\").split()\n    assert merges, \"the retry should have landed a merge commit\"\n\n    assert remote_head(bare, branch) == head_of(root)\n    assert \"concurrent.txt\" in git(root, \"ls-tree\", \"-r\", \"--name-only\", \"HEAD\")\n\n\n\ndef test_drive_a_refused_marker_push_ends_the_pass_with_exit_1(tmp_path: Path) -> None:\n    \"\"\"A remote whose pre-receive hook refuses every push is a refusal,\n    not a lease held by another pass: the pass says why, exits 1, raises\n    nothing, starts no worker, and with --until-ready does not pass\n    again. Distinct from a non-fast-forward rejection, which is the\n    lease (test_pass).\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    bare = add_bare_remote(root, tmp_path)\n    approve_item(root)\n    hook = bare / \"hooks\" / \"pre-receive\"\n    hook.write_text(\"#!/bin/sh\\necho 'refused by the fixture remote' >&2\\nexit 1\\n\")\n    hook.chmod(0o755)\n\n    run = run_attavo(root, \"drive\", \"1\", \"--until-ready\")\n    assert run.returncode == 1, run.stdout + run.stderr\n    assert \"Traceback\" not in run.stderr, run.stderr\n    assert \"could not push the build invocation marker\" in run.stdout, run.stdout\n    assert \"another pass holds\" not in run.stdout\n    assert \"worker pid\" not in run.stdout\n    assert record_files(root, \"build\") == []\n    assert not (records_dir(root) / \"build-01.started\").exists()\n\n\ndef test_drive_commits_and_pushes_an_invocation_marker_before_the_stage_runs(tmp_path: Path) -> None:\n    \"\"\"Issue #151: the invocation's own marker is a fact on the branch\n    before the stage runs -- its own commit, authored by the driver\n    identity, landing and pushed ahead of the stage record's commit.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    bare = add_bare_remote(root, tmp_path)\n    approve_item(root)\n    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n\n    run = drive(root, \"1\")\n    assert run.returncode == 0, run.stdout + run.stderr\n\n    marker = records_dir(root) / \"build-01.started\"\n    assert marker.is_file()\n    info = json.loads(marker.read_text())\n    assert info[\"host\"] == socket.gethostname()\n    assert isinstance(info[\"pid\"], int)\n\n    marker_commit = git(root, \"log\", \"--format=%H\", \"--\", str(marker.relative_to(root))).split()[-1]\n    build_commit = head_of(root)\n    assert marker_commit != build_commit\n    # the marker's own commit is an ancestor of the build record's commit\n    assert git(root, \"merge-base\", \"--is-ancestor\", marker_commit, build_commit) == \"\"\n\n    assert git(root, \"log\", \"-1\", \"--format=%an\", marker_commit).strip() == \"attavo driver\"\n    assert remote_head(bare, branch) == head_of(root)\n\n\n\ndef test_drive_pass_writes_a_died_record_for_a_dead_invocation(tmp_path: Path) -> None:\n    \"\"\"Issue #151, under R2: the pass itself retires a build-01.started\n    marker naming a dead pid with a failed record, class died,\n    provenance product -- committed by the driver identity, pushed to\n    the fixture remote. Recovery is the pass's one act that pass; it\n    starts nothing else.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_drive_stall_bound(root)\n    bare = add_bare_remote(root, tmp_path)\n    approve_item(root)\n    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n\n    marker = write_dead_marker(root, \"build\", 1)\n    git(root, \"push\", \"origin\", f\"HEAD:{branch}\")\n\n    run = drive(root, \"1\")\n    assert run.returncode == 0, run.stdout + run.stderr\n    assert \"recovered build-01 as died\" in run.stdout\n    assert \"worker pid\" not in run.stdout\n\n    rec = latest_record(root, \"build\")\n    assert rec[\"status\"] == \"failed\"\n    assert rec[\"stop\"][\"class\"] == \"died\"\n    assert rec[\"stop\"][\"provenance\"] == \"product\"\n    assert \"wrote no build-01.json\" in rec[\"stop\"][\"detail\"]\n\n    record_path = record_files(root, \"build\")[-1]\n    assert record_path.with_suffix(\".log\").exists()\n    assert git(root, \"log\", \"-1\", \"--format=%an\").strip() == \"attavo driver\"\n    assert git(root, \"status\", \"--porcelain\", \"--\", str(record_path),\n              str(record_path.with_suffix(\".log\")), str(marker)).strip() == \"\"\n    assert remote_head(bare, branch) == head_of(root)\n    assert marker.is_file()  # the marker itself is left in place, retired by the record\n\n\n\ndef test_drive_pass_recovers_a_dead_invocation_without_a_stall_bound(tmp_path: Path) -> None:\n    \"\"\"R2: the stall bound decides hung, not died. With no\n    [drive].stall_after_s a dead invocation (its heartbeat stale, or no\n    heartbeat and its pid gone) is still recovered as died; what the\n    missing bound forgoes is only the hung class -- alive is running for\n    as long as it lives (test_pass covers the stale heartbeat).\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_bare_remote(root, tmp_path)\n    approve_item(root)\n\n    write_dead_marker(root, \"build\", 1)\n\n    run = drive(root, \"1\")\n    assert run.returncode == 0, run.stdout + run.stderr\n    assert \"recovered build-01 as died\" in run.stdout\n    assert latest_record(root, \"build\")[\"stop\"][\"class\"] == \"died\"\n\n\ndef test_drive_recover_flag_is_gone(tmp_path: Path) -> None:\n    \"\"\"R2 retires `attavo drive --recover`: recovery is what a pass does\n    when the report owes one. The flag is refused with exit 2 and a line\n    saying so; nothing is read or written.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_drive_stall_bound(root)\n    add_forge(root, GREEN_FORGE)\n    add_bare_remote(root, tmp_path)\n    approve_item(root)\n    assert drive(root, \"1\").returncode == 0\n\n    run = run_attavo(root, \"drive\", \"--recover\", \"1\")\n    assert run.returncode == 2, run.stdout + run.stderr\n    assert \"--recover is gone\" in run.stderr\n    assert len(record_files(root, \"build\")) == 1\n\n\ndef test_drive_forge_poll_defaults_are_a_real_forges_clock() -> None:\n    \"\"\"The bound and interval every other test overrides with\n    FAST_POLL_ENV default, unset, to at least five minutes and ten\n    seconds -- tenant zero's own checks conclude about five minutes after\n    a push, and a bound shorter than that would make every drive run\n    after a record push stop on 'forge checks not green', with a person\n    running it again after CI: exactly the transport act this lane\n    retires. Row 4 (a forge that never goes green) is unchanged in\n    meaning by this -- it still stops, just after waiting out a real\n    forge's own clock instead of a test's fake one.\n    \"\"\"\n    module = attavo_module()\n    assert module.DRIVE_FORGE_POLL_BOUND_DEFAULT_S >= 300\n    assert module.DRIVE_FORGE_POLL_INTERVAL_DEFAULT_S >= 10","numLines":470,"startLine":629,"totalLines":1099}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01L51RHugZn2jZJpV1gVxxyC","type":"tool_result","content":"1\t\"\"\"`attavo drive N --report`: what one item is waiting on and for whom, as a\n2\tpure function of its records, its markers, and one read of the forge. It\n3\twrites nothing, starts nothing, and never waits (#171: a refusal nobody\n4\tcould read, twice on #194).\n5\t\n6\tRun: python3 -m pytest tests -q\n7\t\"\"\"\n8\tfrom __future__ import annotations\n9\t\n10\timport json\n11\timport os\n12\timport socket\n13\timport time\n14\tfrom datetime import datetime, timedelta, timezone\n15\tfrom pathlib import Path\n16\tfrom typing import Any\n17\t\n18\timport pytest\n19\tfrom helpers import commit_all, git, make_tenant\n20\tfrom test_attest_time import INVOCATIONS, make_item\n21\tfrom test_drive import (\n22\t    GREEN_FORGE,\n23\t    RED_FORGE,\n24\t    UNCONCLUDED_FORGE,\n25\t    add_bare_remote,\n26\t    add_drive_stall_bound,\n27\t    add_forge,\n28\t    approve_item,\n29\t    head_of,\n30\t    record_files,\n31\t    records_dir,\n32\t    run_attavo,\n33\t    write_dead_marker,\n34\t)\n35\t\n36\tROOT = Path(__file__).resolve().parent.parent\n37\tSCHEMA = json.loads((ROOT / \"schema\" / \"drive-report.schema.json\").read_text())\n38\t\n39\t\n40\tdef report(root: Path, item: str = \"1\", env: dict[str, Any] | None = None) -> dict[str, Any]:\n41\t    before = (head_of(root), git(root, \"status\", \"--porcelain\"),\n42\t              sorted(p.name for p in records_dir(root, item).glob(\"*\")))\n43\t    run = run_attavo(root, \"drive\", item, \"--report\", env=env)\n44\t    assert run.returncode == 0, run.stdout + run.stderr\n45\t    after = (head_of(root), git(root, \"status\", \"--porcelain\"),\n46\t             sorted(p.name for p in records_dir(root, item).glob(\"*\")))\n47\t    assert before == after, \"the report wrote something\"\n48\t    out: dict[str, Any] = json.loads(run.stdout)\n49\t    assert set(out) == set(SCHEMA[\"required\"]) == set(SCHEMA[\"properties\"]), out\n50\t    assert out[\"state\"] in SCHEMA[\"properties\"][\"state\"][\"enum\"], out\n51\t    assert out[\"kind\"] in SCHEMA[\"properties\"][\"kind\"][\"enum\"], out\n52\t    assert \"drive\" not in out[\"says\"].lower() and \"verify\" not in out[\"says\"].lower(), out\n53\t    return out\n54\t\n55\t\n56\tdef test_report_names_a_red_check_and_the_head_and_writes_nothing(tmp_path: Path) -> None:\n57\t    \"\"\"#171: on a concluded red check the product printed one line into a\n58\t    log nobody read, exited 1, and wrote nothing. The report says it for as\n59\t    long as it is true.\"\"\"\n60\t    root = make_tenant(tmp_path, \"build_valid\")\n61\t    add_forge(root, RED_FORGE)\n62\t    add_bare_remote(root, tmp_path)\n63\t    approve_item(root)\n64\t    assert run_attavo(root, \"drive\", \"1\").returncode == 0\n65\t    out = report(root)\n66\t    assert (out[\"state\"], out[\"kind\"], out[\"stage\"]) == (\"blocked-on-checks\", \"waits\", \"verify\"), out\n67\t    assert out[\"checks\"] == [{\"name\": \"ci\", \"conclusion\": \"failure\"}], out\n68\t    assert \"ci failure\" in out[\"says\"] and head_of(root)[:7] in out[\"says\"], out\n69\t    assert record_files(root, \"verify\") == []\n70\t    assert report(root) == out, \"two reads of one level differ\"\n71\t\n72\t\n73\tdef test_report_never_waits_on_a_check_that_is_still_running(tmp_path: Path) -> None:\n74\t    root = make_tenant(tmp_path, \"build_valid\")\n75\t    add_forge(root, UNCONCLUDED_FORGE)\n76\t    add_bare_remote(root, tmp_path)\n77\t    approve_item(root)\n78\t    assert run_attavo(root, \"drive\", \"1\").returncode == 0\n79\t    started = time.monotonic()\n80\t    out = report(root, env={\"ATTAVO_DRIVE_POLL_BOUND_S\": \"30\", \"ATTAVO_DRIVE_POLL_INTERVAL_S\": \"5\"})\n81\t    assert time.monotonic() - started < 4, \"the report polled\"\n82\t    assert (out[\"state\"], out[\"kind\"]) == (\"waiting-on-checks\", \"waits\"), out\n83\t    assert \"ci in_progress\" in out[\"says\"], out\n84\t\n85\t\n86\tdef test_report_walks_an_item_from_approval_to_ready(tmp_path: Path) -> None:\n87\t    root = make_tenant(tmp_path, \"build_valid\")\n88\t    add_forge(root, GREEN_FORGE)\n89\t    add_bare_remote(root, tmp_path)\n90\t    assert run_attavo(root, \"spec-gate\", \"1\").returncode == 0\n91\t    out = report(root)\n92\t    assert (out[\"state\"], out[\"kind\"]) == (\"waiting-on-approval\", \"yours\"), out\n93\t    approve_item(root)\n94\t    assert (report(root)[\"state\"], report(root)[\"kind\"]) == (\"next-build\", \"acts\")\n95\t    assert run_attavo(root, \"drive\", \"1\").returncode == 0\n96\t    assert (report(root)[\"state\"], report(root)[\"stage\"]) == (\"next-review\", \"verify\")\n97\t    assert run_attavo(root, \"drive\", \"1\").returncode == 0\n98\t    out = report(root)\n99\t    assert (out[\"state\"], out[\"kind\"], out[\"says\"]) == (\"ready-to-merge\", \"yours\", \"Ready to merge\"), out\n100\t\n101\t\n102\tdef test_report_says_what_recovery_would_record_for_a_dead_invocation(tmp_path: Path) -> None:\n103\t    root = make_tenant(tmp_path, \"build_valid\")\n104\t    add_forge(root, GREEN_FORGE)\n105\t    add_drive_stall_bound(root)\n106\t    approve_item(root)\n107\t    write_dead_marker(root, \"build\", 1)\n108\t    out = report(root)\n109\t    assert (out[\"state\"], out[\"kind\"], out[\"stage\"], out[\"attempt\"], out[\"stop_class\"]) == (\n110\t        \"owes-recovery\", \"acts\", \"build\", 1, \"died\"), out\n111\t    assert not (records_dir(root) / \"build-01.json\").exists()\n112\t\n113\t\n114\tdef test_report_names_the_stopped_record_its_class_its_counsel_and_its_issue(tmp_path: Path) -> None:\n115\t    root = make_tenant(tmp_path, \"build_valid\")\n116\t    add_forge(root, GREEN_FORGE)\n117\t    add_drive_stall_bound(root)\n118\t    approve_item(root)\n119\t    write_dead_marker(root, \"build\", 1)\n120\t    assert run_attavo(root, \"drive\", \"--recover\", \"1\").returncode == 0\n121\t    d = records_dir(root)\n122\t    (d / \"build-01.filed\").write_text(\"https://example.invalid/issues/9\\n\")\n123\t    commit_all(root, \"the stop is filed\")\n124\t    out = report(root)\n125\t    assert (out[\"state\"], out[\"kind\"], out[\"record\"], out[\"stop_class\"], out[\"filed\"]) == (\n126\t        \"stopped\", \"yours\", \"build-01\", \"died\", \"https://example.invalid/issues/9\"), out\n127\t    assert out[\"says\"].startswith(\"Needs you: build attempt 01 stopped as died\"), out\n128\t\n129\t\n130\tdef write_live_marker(root: Path, stage: str, nn: int, age_s: int) -> None:\n131\t    \"\"\"A marker whose pid is this test's own process: alive, on this host,\n132\t    begun age_s seconds ago, with no events file.\"\"\"\n133\t    at = (datetime.now(timezone.utc) - timedelta(seconds=age_s)).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n134\t    marker = records_dir(root) / f\"{stage}-{nn:02d}.started\"\n135\t    marker.parent.mkdir(parents=True, exist_ok=True)\n136\t    marker.write_text(json.dumps({\"at\": at, \"host\": socket.gethostname(), \"pid\": os.getpid(),\n137\t                                  \"sha\": head_of(root), \"product_version\": \"fixture\"}))\n138\t    commit_all(root, \"invocation marker for item 1\")\n139\t\n140\t\n141\tdef test_report_reads_an_expired_approval_as_yours_and_says_why(tmp_path: Path) -> None:\n142\t    root = make_tenant(tmp_path, \"build_valid\")\n143\t    add_forge(root, GREEN_FORGE)\n144\t    approve_item(root)\n145\t    spec = root / \"specs\" / \"1\" / \"spec.md\"\n146\t    spec.write_text(spec.read_text() + \"\\n\")\n147\t    commit_all(root, \"touch the spec after approval\")\n148\t    out = report(root)\n149\t    assert (out[\"state\"], out[\"kind\"]) == (\"waiting-on-approval\", \"yours\"), out\n150\t    assert \"expired\" in out[\"says\"], out\n151\t\n152\t\n153\tdef test_report_reads_a_live_invocation_inside_the_bound_as_running(tmp_path: Path) -> None:\n154\t    \"\"\"Launch stayed on the screen while #194's build ran: a view guessed\n155\t    whose move it was.\"\"\"\n156\t    root = make_tenant(tmp_path, \"build_valid\")\n157\t    add_forge(root, GREEN_FORGE)\n158\t    add_drive_stall_bound(root, 60)\n159\t    approve_item(root)\n160\t    write_live_marker(root, \"build\", 1, age_s=5)\n161\t    out = report(root)\n162\t    assert (out[\"state\"], out[\"kind\"], out[\"stage\"], out[\"attempt\"]) == (\"running\", \"waits\", \"build\", 1), out\n163\t    assert out[\"since\"] and isinstance(out[\"last_event_age_s\"], int), out\n164\t    assert out[\"says\"].startswith(\"Build running since \"), out\n165\t\n166\t\n167\tdef test_report_reads_a_live_invocation_past_the_bound_as_hung_and_ends_nothing(tmp_path: Path) -> None:\n168\t    root = make_tenant(tmp_path, \"build_valid\")\n169\t    add_forge(root, GREEN_FORGE)\n170\t    add_drive_stall_bound(root, 60)\n171\t    approve_item(root)\n172\t    write_live_marker(root, \"build\", 1, age_s=600)\n173\t    out = report(root)\n174\t    assert (out[\"state\"], out[\"kind\"], out[\"stop_class\"]) == (\"owes-recovery\", \"acts\", \"hung\"), out\n175\t    os.kill(os.getpid(), 0)  # the report terminated nothing: this process is its \"hung\" pid\n176\t\n177\t\n178\tdef test_report_reads_a_review_of_an_earlier_build_as_review_next(tmp_path: Path) -> None:\n179\t    \"\"\"#109: a later build supersedes the latest review; the item is not\n180\t    ready and is not stopped.\"\"\"\n181\t    root = make_tenant(tmp_path, \"build_valid\")\n182\t    add_forge(root, GREEN_FORGE)\n183\t    add_bare_remote(root, tmp_path)\n184\t    approve_item(root)\n185\t    assert run_attavo(root, \"drive\", \"1\").returncode == 0\n186\t    assert run_attavo(root, \"drive\", \"1\").returncode == 0\n187\t    assert report(root)[\"state\"] == \"ready-to-merge\"\n188\t    build = json.loads(record_files(root, \"build\")[-1].read_text())\n189\t    build[\"sha\"] = \"f\" * 40\n190\t    (records_dir(root) / \"build-02.json\").write_text(json.dumps(build))\n191\t    commit_all(root, \"a second build record, minted by hand\")\n192\t    out = report(root)\n193\t    assert (out[\"state\"], out[\"kind\"], out[\"stage\"]) == (\"next-review\", \"acts\", \"verify\"), out\n194\t\n195\t\n196\tdef test_report_does_not_read_a_failed_build_of_an_earlier_approval_as_stopped(tmp_path: Path) -> None:\n197\t    root = make_tenant(tmp_path, \"build_valid\")\n198\t    add_forge(root, GREEN_FORGE)\n199\t    approve_item(root)\n200\t    (records_dir(root) / \"build-01.json\").write_text(json.dumps(\n201\t        {\"status\": \"failed\", \"sha\": \"b\" * 40, \"approval_sha\": \"0\" * 40,\n202\t         \"stop\": {\"class\": \"gate\", \"provenance\": \"tenant\", \"detail\": None}}))\n203\t    commit_all(root, \"a failed build bound to an approval that is not the current one\")\n204\t    out = report(root)\n205\t    assert (out[\"state\"], out[\"kind\"]) == (\"next-build\", \"acts\"), out\n206\t\n207\t\n208\tdef test_report_names_the_counsel_record_that_read_the_stop(tmp_path: Path) -> None:\n209\t    root = make_tenant(tmp_path, \"build_valid\")\n210\t    add_forge(root, GREEN_FORGE)\n211\t    add_drive_stall_bound(root)\n212\t    approve_item(root)\n213\t    write_dead_marker(root, \"build\", 1)\n214\t    assert run_attavo(root, \"drive\", \"--recover\", \"1\").returncode == 0\n215\t    (records_dir(root) / \"counsel-01.json\").write_text(json.dumps(\n216\t        {\"record\": \"build-01\", \"record_stage\": \"build\", \"verdict\": \"person\", \"status\": \"done\"}))\n217\t    commit_all(root, \"counsel read the stop\")\n218\t    out = report(root)\n219\t    assert (out[\"state\"], out[\"counsel\"]) == (\"stopped\", \"counsel-01\"), out\n220\t    assert \"counsel-01\" in out[\"says\"] and \"person\" in out[\"says\"], out\n221\t\n222\t\n223\tdef test_report_reads_a_merged_item_as_merged(tmp_path: Path) -> None:\n224\t    \"\"\"The screen showed #204 as waiting, its pull request \"not read\", after\n225\t    it had merged: the branch survived and no view read the history.\"\"\"\n226\t    root, merge = make_item(tmp_path, INVOCATIONS)\n227\t    run = run_attavo(root, \"drive\", \"1\", \"--report\")\n228\t    assert run.returncode == 0, run.stdout + run.stderr\n229\t    out = json.loads(run.stdout)\n230\t    assert (out[\"state\"], out[\"kind\"]) == (\"merged\", \"done\"), out\n231\t    assert merge[:7] in out[\"says\"], out\n232\t\n233\t\n234\t@pytest.mark.own_records\n235\tdef test_report_reads_every_item_this_repository_carries(tmp_path: Path) -> None:\n236\t    \"\"\"A new reader must not wedge on a record that already exists (#194's\n237\t    verify-01). Every item under this repository's own records directory\n238\t    yields a report, in-process, with no forge read of its own.\"\"\"\n239\t    from attavo.common import read_manifest\n240\t    from attavo.report import drive_report\n241\t    m = read_manifest(ROOT)\n242\t    assert m is not None\n243\t    m = {**m, \"forge\": {**(m.get(\"forge\") or {}), \"checks_command\": \"printf 'ci success\\\\n'\"}}\n244\t    items = sorted(p.name for p in (ROOT / m[\"paths\"][\"records\"]).iterdir() if p.is_dir())\n245\t    assert items\n246\t    for item in items:\n247\t        out = drive_report(ROOT, m, item)\n248\t        assert out[\"state\"] in SCHEMA[\"properties\"][\"state\"][\"enum\"], (item, out)\n249\t"}]},"parent_tool_use_id":null,"session_id":"041a92ee-b14a-4832-b613-6f5a12b6a373","uuid":"94b30599-8646-4e3d-9ca6-5429c662b394","timestamp":"2026-09-25T18:18:59.050Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-217/tests/test_report.py","content":"\"\"\"`attavo drive N --report`: what one item is waiting on and for whom, as a\npure function of its records, its markers, and one read of the forge. It\nwrites nothing, starts nothing, and never waits (#171: a refusal nobody\ncould read, twice on #194).\n\nRun: python3 -m pytest tests -q\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport os\nimport socket\nimport time\nfrom datetime import datetime, timedelta, timezone\nfrom pathlib import Path\nfrom typing import Any\n\nimport pytest\nfrom helpers import commit_all, git, make_tenant\nfrom test_attest_time import INVOCATIONS, make_item\nfrom test_drive import (\n    GREEN_FORGE,\n    RED_FORGE,\n    UNCONCLUDED_FORGE,\n    add_bare_remote,\n    add_drive_stall_bound,\n    add_forge,\n    approve_item,\n    head_of,\n    record_files,\n    records_dir,\n    run_attavo,\n    write_dead_marker,\n)\n\nROOT = Path(__file__).resolve().parent.parent\nSCHEMA = json.loads((ROOT / \"schema\" / \"drive-report.schema.json\").read_text())\n\n\ndef report(root: Path, item: str = \"1\", env: dict[str, Any] | None = None) -> dict[str, Any]:\n    before = (head_of(root), git(root, \"status\", \"--porcelain\"),\n              sorted(p.name for p in records_dir(root, item).glob(\"*\")))\n    run = run_attavo(root, \"drive\", item, \"--report\", env=env)\n    assert run.returncode == 0, run.stdout + run.stderr\n    after = (head_of(root), git(root, \"status\", \"--porcelain\"),\n             sorted(p.name for p in records_dir(root, item).glob(\"*\")))\n    assert before == after, \"the report wrote something\"\n    out: dict[str, Any] = json.loads(run.stdout)\n    assert set(out) == set(SCHEMA[\"required\"]) == set(SCHEMA[\"properties\"]), out\n    assert out[\"state\"] in SCHEMA[\"properties\"][\"state\"][\"enum\"], out\n    assert out[\"kind\"] in SCHEMA[\"properties\"][\"kind\"][\"enum\"], out\n    assert \"drive\" not in out[\"says\"].lower() and \"verify\" not in out[\"says\"].lower(), out\n    return out\n\n\ndef test_report_names_a_red_check_and_the_head_and_writes_nothing(tmp_path: Path) -> None:\n    \"\"\"#171: on a concluded red check the product printed one line into a\n    log nobody read, exited 1, and wrote nothing. The report says it for as\n    long as it is true.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, RED_FORGE)\n    add_bare_remote(root, tmp_path)\n    approve_item(root)\n    assert run_attavo(root, \"drive\", \"1\").returncode == 0\n    out = report(root)\n    assert (out[\"state\"], out[\"kind\"], out[\"stage\"]) == (\"blocked-on-checks\", \"waits\", \"verify\"), out\n    assert out[\"checks\"] == [{\"name\": \"ci\", \"conclusion\": \"failure\"}], out\n    assert \"ci failure\" in out[\"says\"] and head_of(root)[:7] in out[\"says\"], out\n    assert record_files(root, \"verify\") == []\n    assert report(root) == out, \"two reads of one level differ\"\n\n\ndef test_report_never_waits_on_a_check_that_is_still_running(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, UNCONCLUDED_FORGE)\n    add_bare_remote(root, tmp_path)\n    approve_item(root)\n    assert run_attavo(root, \"drive\", \"1\").returncode == 0\n    started = time.monotonic()\n    out = report(root, env={\"ATTAVO_DRIVE_POLL_BOUND_S\": \"30\", \"ATTAVO_DRIVE_POLL_INTERVAL_S\": \"5\"})\n    assert time.monotonic() - started < 4, \"the report polled\"\n    assert (out[\"state\"], out[\"kind\"]) == (\"waiting-on-checks\", \"waits\"), out\n    assert \"ci in_progress\" in out[\"says\"], out\n\n\ndef test_report_walks_an_item_from_approval_to_ready(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    add_bare_remote(root, tmp_path)\n    assert run_attavo(root, \"spec-gate\", \"1\").returncode == 0\n    out = report(root)\n    assert (out[\"state\"], out[\"kind\"]) == (\"waiting-on-approval\", \"yours\"), out\n    approve_item(root)\n    assert (report(root)[\"state\"], report(root)[\"kind\"]) == (\"next-build\", \"acts\")\n    assert run_attavo(root, \"drive\", \"1\").returncode == 0\n    assert (report(root)[\"state\"], report(root)[\"stage\"]) == (\"next-review\", \"verify\")\n    assert run_attavo(root, \"drive\", \"1\").returncode == 0\n    out = report(root)\n    assert (out[\"state\"], out[\"kind\"], out[\"says\"]) == (\"ready-to-merge\", \"yours\", \"Ready to merge\"), out\n\n\ndef test_report_says_what_recovery_would_record_for_a_dead_invocation(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    add_drive_stall_bound(root)\n    approve_item(root)\n    write_dead_marker(root, \"build\", 1)\n    out = report(root)\n    assert (out[\"state\"], out[\"kind\"], out[\"stage\"], out[\"attempt\"], out[\"stop_class\"]) == (\n        \"owes-recovery\", \"acts\", \"build\", 1, \"died\"), out\n    assert not (records_dir(root) / \"build-01.json\").exists()\n\n\ndef test_report_names_the_stopped_record_its_class_its_counsel_and_its_issue(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    add_drive_stall_bound(root)\n    approve_item(root)\n    write_dead_marker(root, \"build\", 1)\n    assert run_attavo(root, \"drive\", \"--recover\", \"1\").returncode == 0\n    d = records_dir(root)\n    (d / \"build-01.filed\").write_text(\"https://example.invalid/issues/9\\n\")\n    commit_all(root, \"the stop is filed\")\n    out = report(root)\n    assert (out[\"state\"], out[\"kind\"], out[\"record\"], out[\"stop_class\"], out[\"filed\"]) == (\n        \"stopped\", \"yours\", \"build-01\", \"died\", \"https://example.invalid/issues/9\"), out\n    assert out[\"says\"].startswith(\"Needs you: build attempt 01 stopped as died\"), out\n\n\ndef write_live_marker(root: Path, stage: str, nn: int, age_s: int) -> None:\n    \"\"\"A marker whose pid is this test's own process: alive, on this host,\n    begun age_s seconds ago, with no events file.\"\"\"\n    at = (datetime.now(timezone.utc) - timedelta(seconds=age_s)).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n    marker = records_dir(root) / f\"{stage}-{nn:02d}.started\"\n    marker.parent.mkdir(parents=True, exist_ok=True)\n    marker.write_text(json.dumps({\"at\": at, \"host\": socket.gethostname(), \"pid\": os.getpid(),\n                                  \"sha\": head_of(root), \"product_version\": \"fixture\"}))\n    commit_all(root, \"invocation marker for item 1\")\n\n\ndef test_report_reads_an_expired_approval_as_yours_and_says_why(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    approve_item(root)\n    spec = root / \"specs\" / \"1\" / \"spec.md\"\n    spec.write_text(spec.read_text() + \"\\n\")\n    commit_all(root, \"touch the spec after approval\")\n    out = report(root)\n    assert (out[\"state\"], out[\"kind\"]) == (\"waiting-on-approval\", \"yours\"), out\n    assert \"expired\" in out[\"says\"], out\n\n\ndef test_report_reads_a_live_invocation_inside_the_bound_as_running(tmp_path: Path) -> None:\n    \"\"\"Launch stayed on the screen while #194's build ran: a view guessed\n    whose move it was.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    add_drive_stall_bound(root, 60)\n    approve_item(root)\n    write_live_marker(root, \"build\", 1, age_s=5)\n    out = report(root)\n    assert (out[\"state\"], out[\"kind\"], out[\"stage\"], out[\"attempt\"]) == (\"running\", \"waits\", \"build\", 1), out\n    assert out[\"since\"] and isinstance(out[\"last_event_age_s\"], int), out\n    assert out[\"says\"].startswith(\"Build running since \"), out\n\n\ndef test_report_reads_a_live_invocation_past_the_bound_as_hung_and_ends_nothing(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    add_drive_stall_bound(root, 60)\n    approve_item(root)\n    write_live_marker(root, \"build\", 1, age_s=600)\n    out = report(root)\n    assert (out[\"state\"], out[\"kind\"], out[\"stop_class\"]) == (\"owes-recovery\", \"acts\", \"hung\"), out\n    os.kill(os.getpid(), 0)  # the report terminated nothing: this process is its \"hung\" pid\n\n\ndef test_report_reads_a_review_of_an_earlier_build_as_review_next(tmp_path: Path) -> None:\n    \"\"\"#109: a later build supersedes the latest review; the item is not\n    ready and is not stopped.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    add_bare_remote(root, tmp_path)\n    approve_item(root)\n    assert run_attavo(root, \"drive\", \"1\").returncode == 0\n    assert run_attavo(root, \"drive\", \"1\").returncode == 0\n    assert report(root)[\"state\"] == \"ready-to-merge\"\n    build = json.loads(record_files(root, \"build\")[-1].read_text())\n    build[\"sha\"] = \"f\" * 40\n    (records_dir(root) / \"build-02.json\").write_text(json.dumps(build))\n    commit_all(root, \"a second build record, minted by hand\")\n    out = report(root)\n    assert (out[\"state\"], out[\"kind\"], out[\"stage\"]) == (\"next-review\", \"acts\", \"verify\"), out\n\n\ndef test_report_does_not_read_a_failed_build_of_an_earlier_approval_as_stopped(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    approve_item(root)\n    (records_dir(root) / \"build-01.json\").write_text(json.dumps(\n        {\"status\": \"failed\", \"sha\": \"b\" * 40, \"approval_sha\": \"0\" * 40,\n         \"stop\": {\"class\": \"gate\", \"provenance\": \"tenant\", \"detail\": None}}))\n    commit_all(root, \"a failed build bound to an approval that is not the current one\")\n    out = report(root)\n    assert (out[\"state\"], out[\"kind\"]) == (\"next-build\", \"acts\"), out\n\n\ndef test_report_names_the_counsel_record_that_read_the_stop(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    add_drive_stall_bound(root)\n    approve_item(root)\n    write_dead_marker(root, \"build\", 1)\n    assert run_attavo(root, \"drive\", \"--recover\", \"1\").returncode == 0\n    (records_dir(root) / \"counsel-01.json\").write_text(json.dumps(\n        {\"record\": \"build-01\", \"record_stage\": \"build\", \"verdict\": \"person\", \"status\": \"done\"}))\n    commit_all(root, \"counsel read the stop\")\n    out = report(root)\n    assert (out[\"state\"], out[\"counsel\"]) == (\"stopped\", \"counsel-01\"), out\n    assert \"counsel-01\" in out[\"says\"] and \"person\" in out[\"says\"], out\n\n\ndef test_report_reads_a_merged_item_as_merged(tmp_path: Path) -> None:\n    \"\"\"The screen showed #204 as waiting, its pull request \"not read\", after\n    it had merged: the branch survived and no view read the history.\"\"\"\n    root, merge = make_item(tmp_path, INVOCATIONS)\n    run = run_attavo(root, \"drive\", \"1\", \"--report\")\n    assert run.returncode == 0, run.stdout + run.stderr\n    out = json.loads(run.stdout)\n    assert (out[\"state\"], out[\"kind\"]) == (\"merged\", \"done\"), out\n    assert merge[:7] in out[\"says\"], out\n\n\n@pytest.mark.own_records\ndef test_report_reads_every_item_this_repository_carries(tmp_path: Path) -> None:\n    \"\"\"A new reader must not wedge on a record that already exists (#194's\n    verify-01). Every item under this repository's own records directory\n    yields a report, in-process, with no forge read of its own.\"\"\"\n    from attavo.common import read_manifest\n    from attavo.report import drive_report\n    m = read_manifest(ROOT)\n    assert m is not None\n    m = {**m, \"forge\": {**(m.get(\"forge\") or {}), \"checks_command\": \"printf 'ci success\\\\n'\"}}\n    items = sorted(p.name for p in (ROOT / m[\"paths\"][\"records\"]).iterdir() if p.is_dir())\n    assert items\n    for item in items:\n        out = drive_report(ROOT, m, item)\n        assert out[\"state\"] in SCHEMA[\"properties\"][\"state\"][\"enum\"], (item, out)\n","numLines":249,"startLine":1,"totalLines":249}}}

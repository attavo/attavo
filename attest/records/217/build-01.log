{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013ce8tnMEpx2J68dgWomJSu","type":"tool_result","content":"170\t\n171\tdef test_drive_pass_waits_on_an_absent_approval(tmp_path: Path) -> None:\n172\t    \"\"\"Acceptance row 6, as a level (R2): with no approval the pass says\n173\t    the item is waiting on the operator, exits 0 because a level is not a\n174\t    refusal, and runs nothing -- no spec-gate, no build, no records.\"\"\"\n175\t    root = make_tenant(tmp_path, \"build_valid\")\n176\t    add_forge(root, GREEN_FORGE)\n177\t    add_bare_remote(root, tmp_path)\n178\t\n179\t    run = drive(root, \"1\")\n180\t    assert run.returncode == 0, run.stdout + run.stderr\n181\t    assert \"approve the spec\" in run.stdout\n182\t    assert \"worker pid\" not in run.stdout\n183\t\n184\t    assert not records_dir(root).exists() or list(records_dir(root).glob(\"*.json\")) == []\n185\t\n186\t\n187\t\n188\tdef test_drive_pass_waits_on_an_expired_approval(tmp_path: Path) -> None:\n189\t    \"\"\"Acceptance row 6, the other half: an approval bound to a spec sha\n190\t    that has since moved is expired, not absent -- the pass says so, by\n191\t    that word, exits 0, and starts nothing.\"\"\"\n192\t    root = make_tenant(tmp_path, \"build_valid\")\n193\t    add_forge(root, GREEN_FORGE)\n194\t    add_bare_remote(root, tmp_path)\n195\t    approve_item(root)\n196\t\n197\t    (root / \"specs\" / \"1\" / \"spec.md\").write_text(\n198\t        (root / \"specs\" / \"1\" / \"spec.md\").read_text() + \"\\n\")\n199\t    commit_all(root, \"touch the spec after approval\")\n200\t\n201\t    run = drive(root, \"1\")\n202\t    assert run.returncode == 0, run.stdout + run.stderr\n203\t    assert \"expired\" in run.stdout\n204\t    assert \"worker pid\" not in run.stdout\n205\t    assert record_files(root, \"build\") == []\n206\t\n207\t\n208\tdef test_drive_builds_from_an_approved_spec_with_no_build(tmp_path: Path) -> None:\n209\t    \"\"\"Acceptance row 1. One drive run produces a passing build record,\n210\t    commits only the record and its log (`git commit --only`), and pushes\n211\t    the branch; the fixture remote carries the record commit.\"\"\"\n212\t    root = make_tenant(tmp_path, \"build_valid\")\n213\t    add_forge(root, GREEN_FORGE)\n214\t    bare = add_bare_remote(root, tmp_path)\n215\t    approve_item(root)\n216\t    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n217\t\n218\t    run = drive(root, \"1\")\n219\t    assert run.returncode == 0, run.stdout + run.stderr\n220\t\n221\t    rec = latest_record(root, \"build\")\n222\t    assert rec[\"status\"] == \"pass\"\n223\t\n224\t    record_path = record_files(root, \"build\")[-1]\n225\t    log_path = record_path.with_suffix(\".log\")\n226\t    assert log_path.exists()\n227\t\n228\t    touched = set(last_commit_paths(root))\n229\t    assert touched == {\n230\t        str(record_path.relative_to(root)),\n231\t        str(log_path.relative_to(root)),\n232\t    }\n233\t\n234\t    assert remote_head(bare, branch) == head_of(root)\n235\t\n236\t\n237\tdef test_drive_leaves_the_events_file_out_of_the_record_commit(tmp_path: Path) -> None:\n238\t    \"\"\"Issue #26, acceptance row 2, strengthened by issue #140: attavo\n239\t    build always writes a stage's events file now (test_build.py's own\n240\t    row-1 tests), under the checkout's own git directory rather than\n241\t    the working tree -- so it is not merely excluded from the commit's\n242\t    file list, it is not even a path git tracks anything under. The\n243\t    commit's file list still names only the record and its log.\n244\t    \"\"\"\n245\t    root = make_tenant(tmp_path, \"build_valid\")\n246\t    add_forge(root, GREEN_FORGE)\n247\t    add_bare_remote(root, tmp_path)\n248\t    approve_item(root)\n249\t\n250\t    run = drive(root, \"1\")\n251\t    assert run.returncode == 0, run.stdout + run.stderr\n252\t\n253\t    record_path = record_files(root, \"build\")[-1]\n254\t    git_dir = git(root, \"rev-parse\", \"--absolute-git-dir\").strip()\n255\t    events_path = Path(git_dir) / \"attavo\" / \"build-01.events.jsonl\"\n256\t    assert events_path.is_file()\n257\t\n258\t    touched = set(last_commit_paths(root))\n259\t    assert touched == {\n260\t        str(record_path.relative_to(root)),\n261\t        str(record_path.with_suffix(\".log\").relative_to(root)),\n262\t    }\n263\t\n264\t\n265\tdef test_drive_commits_the_record_as_the_driver_not_the_tenants_own_identity(tmp_path: Path) -> None:\n266\t    \"\"\"The driver's identity (driver_identity, beside executor_identity):\n267\t    set by the product, never the tenant's git config, so a driven item's\n268\t    record commits are never indistinguishable from an operator's own.\n269\t    The fixture tenant's user.name is set to another value here, so a\n270\t    commit carrying it would prove commit_record fell back to the\n271\t    tenant's git config instead.\"\"\"\n272\t    root = make_tenant(tmp_path, \"build_valid\")\n273\t    git(root, \"config\", \"user.name\", \"Some Operator\")\n274\t    git(root, \"config\", \"user.email\", \"operator@example.com\")\n275\t    add_forge(root, GREEN_FORGE)\n276\t    add_bare_remote(root, tmp_path)\n277\t    approve_item(root)\n278\t\n279\t    run = drive(root, \"1\")\n280\t    assert run.returncode == 0, run.stdout + run.stderr\n281\t\n282\t    author_name = git(root, \"log\", \"-1\", \"--format=%an\").strip()\n283\t    author_email = git(root, \"log\", \"-1\", \"--format=%ae\").strip()\n284\t    committer_name = git(root, \"log\", \"-1\", \"--format=%cn\").strip()\n285\t    committer_email = git(root, \"log\", \"-1\", \"--format=%ce\").strip()\n286\t\n287\t    assert author_name == \"attavo driver\"\n288\t    assert author_email == \"driver@attavo.invalid\"\n289\t    assert committer_name == \"attavo driver\"\n290\t    assert committer_email == \"driver@attavo.invalid\"\n291\t\n292\t\n293\tdef test_drive_verifies_from_a_passed_build_with_the_forge_green(tmp_path: Path) -> None:\n294\t    \"\"\"Acceptance row 2. From a passed build with the fake forge green,\n295\t    one run produces a verify record, commits only the record and its log,\n296\t    and pushes.\"\"\"\n297\t    root = make_tenant(tmp_path, \"build_valid\")\n298\t    add_forge(root, GREEN_FORGE)\n299\t    bare = add_bare_remote(root, tmp_path)\n300\t    approve_item(root)\n301\t    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n302\t\n303\t    assert drive(root, \"1\").returncode == 0  # builds\n304\t\n305\t    run = drive(root, \"1\")\n306\t    assert run.returncode == 0, run.stdout + run.stderr\n307\t\n308\t    assert record_files(root, \"build\") and record_files(root, \"verify\")\n309\t    rec = latest_record(root, \"verify\")\n310\t    assert rec[\"status\"] == \"pass\"\n311\t\n312\t    record_path = record_files(root, \"verify\")[-1]\n313\t    log_path = record_path.with_suffix(\".log\")\n314\t    assert log_path.exists()\n315\t\n316\t    touched = set(last_commit_paths(root))\n317\t    assert touched == {\n318\t        str(record_path.relative_to(root)),\n319\t        str(log_path.relative_to(root)),\n320\t    }\n321\t\n322\t    assert remote_head(bare, branch) == head_of(root)\n323\t\n324\t\n325\tdef test_drive_verifies_again_when_the_latest_verify_is_superseded_by_a_later_build(tmp_path: Path) -> None:\n326\t    \"\"\"Acceptance row 4, issue #109. A verify record can only name a build\n327\t    that existed when it was written, so a later build makes the latest\n328\t    verify superseded, never a mismatch -- drive derives the next stage\n329\t    as verify, not build, and never refuses.\n330\t\n331\t    Regression: on main before this lane, drive_state's own inline\n332\t    staleness check already treats this as 'verify', so this test does\n333\t    not fail against current code -- it is here to lock the behavior\n334\t    check_attest_chain's fix must not disturb (the acceptance table's\n335\t    'never refuses' row).\"\"\"\n336\t    root = make_tenant(tmp_path, \"build_valid\")\n337\t    add_forge(root, GREEN_FORGE)\n338\t    add_bare_remote(root, tmp_path)\n339\t    approve_item(root)\n340\t\n341\t    assert drive(root, \"1\").returncode == 0  # builds\n342\t    assert drive(root, \"1\").returncode == 0  # verifies\n343\t\n344\t    # A second build record, minted by hand -- a real re-run of the\n345\t    # fixture adapter is not idempotent against its own tree -- naming a\n346\t    # sha the existing verify-01 does not: verify-01 is now superseded.\n347\t    build_01 = json.loads(record_files(root, \"build\")[-1].read_text())\n348\t    build_01[\"sha\"] = \"f\" * 40\n349\t    (records_dir(root) / \"build-02.json\").write_text(json.dumps(build_01))\n350\t    commit_all(root, \"attavo: second build record for #1, minted by hand\")\n351\t\n352\t    run = drive(root, \"1\")\n353\t    assert run.returncode == 0, run.stdout + run.stderr\n354\t    assert len(record_files(root, \"build\")) == 2\n355\t    assert len(record_files(root, \"verify\")) == 2\n356\t    rec = latest_record(root, \"verify\")\n357\t    assert rec[\"status\"] == \"pass\"\n358\t    assert rec[\"build_sha\"] == build_01[\"sha\"]\n359\t\n360\t\n361\t\n362\tdef test_drive_prints_ready_to_merge_from_a_passed_verify(tmp_path: Path) -> None:\n363\t    \"\"\"Acceptance row 3. From a passed verify with the forge green, one\n364\t    pass prints ready to merge, exits 0, writes nothing, enqueues nothing\n365\t    -- and, per row 8, a further pass repeats exactly the same thing.\"\"\"\n366\t    root = make_tenant(tmp_path, \"build_valid\")\n367\t    add_forge(root, GREEN_FORGE)\n368\t    add_bare_remote(root, tmp_path)\n369\t    approve_item(root)\n370\t\n371\t    assert drive(root, \"1\").returncode == 0  # builds\n372\t    assert drive(root, \"1\").returncode == 0  # verifies\n373\t\n374\t    pre_head = head_of(root)\n375\t    run = drive(root, \"1\")\n376\t    assert run.returncode == 0, run.stdout + run.stderr\n377\t    assert \"ready to merge\" in run.stdout.lower()\n378\t    assert head_of(root) == pre_head\n379\t    assert record_files(root, \"verify\") and len(record_files(root, \"verify\")) == 1\n380\t\n381\t    # Acceptance row 8: idempotence -- run it again, same result, nothing\n382\t    # new written or pushed.\n383\t    run2 = drive(root, \"1\")\n384\t    assert run2.returncode == 0\n385\t    assert \"ready to merge\" in run2.stdout.lower()\n386\t    assert head_of(root) == pre_head\n387\t    assert len(record_files(root, \"verify\")) == 1\n388\t    assert len(record_files(root, \"build\")) == 1\n389\t\n390\t\n391\t\n392\tdef test_drive_until_ready_runs_build_then_verify_to_ready_in_one_call(tmp_path: Path) -> None:\n393\t    \"\"\"Issue #100's own followups, kept under R2: --until-ready repeats\n394\t    the pass in one process until the level is the operator's or done.\n395\t    One call, from an approved item with the forge green, starts the\n396\t    build, waits it out, starts the review, waits it out, and prints\n397\t    ready to merge -- both records written and pushed.\"\"\"\n398\t    root = make_tenant(tmp_path, \"build_valid\")\n399\t    add_forge(root, GREEN_FORGE)\n400\t    bare = add_bare_remote(root, tmp_path)\n401\t    approve_item(root)\n402\t    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n403\t\n404\t    run = run_attavo(root, \"drive\", \"1\", \"--until-ready\")\n405\t    assert run.returncode == 0, run.stdout + run.stderr\n406\t    assert \"ready to merge\" in run.stdout.lower()\n407\t\n408\t    assert len(record_files(root, \"build\")) == 1\n409\t    assert len(record_files(root, \"verify\")) == 1\n410\t    assert latest_record(root, \"build\")[\"status\"] == \"pass\"\n411\t    assert latest_record(root, \"verify\")[\"status\"] == \"pass\"\n412\t    assert remote_head(bare, branch) == head_of(root)\n413\t\n414\t    # Idempotence, same as the single-pass form: a further --until-ready\n415\t    # call repeats exactly the same ready-to-merge result, writing nothing.\n416\t    run2 = run_attavo(root, \"drive\", \"1\", \"--until-ready\")\n417\t    assert run2.returncode == 0\n418\t    assert \"ready to merge\" in run2.stdout.lower()\n419\t    assert len(record_files(root, \"build\")) == 1\n420\t    assert len(record_files(root, \"verify\")) == 1\n421\t\n422\t\n423\tdef test_drive_without_the_flag_still_takes_one_step_at_a_time(tmp_path: Path) -> None:\n424\t    \"\"\"Regression: --until-ready is additive. With no flag, an approved\n425\t    item with the forge green still needs two separate calls -- build,\n426\t    then verify -- exactly as before this issue.\"\"\"\n427\t    root = make_tenant(tmp_path, \"build_valid\")\n428\t    add_forge(root, GREEN_FORGE)\n429\t    add_bare_remote(root, tmp_path)\n430\t    approve_item(root)\n431\t\n432\t    run = drive(root, \"1\")\n433\t    assert run.returncode == 0\n434\t    assert record_files(root, \"build\") and not record_files(root, \"verify\")\n435\t\n436\t    run2 = drive(root, \"1\")\n437\t    assert run2.returncode == 0\n438\t    assert record_files(root, \"verify\")\n439\t\n440\t\n441\t\n442\tdef test_drive_until_ready_stops_on_a_halt(tmp_path: Path) -> None:\n443\t    \"\"\"A stage that stops on its own account -- here, a halted build --\n444\t    ends the --until-ready loop at a level that is the operator's: the\n445\t    loop prints the stopped line the plain pass would and exits 0; it\n446\t    does not start the next attempt on its own.\"\"\"\n447\t    root = make_tenant(tmp_path, \"build_valid\")\n448\t    add_forge(root, GREEN_FORGE)\n449\t    bare = add_bare_remote(root, tmp_path)\n450\t    approve_item(root)\n451\t    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n452\t\n453\t    run = run_attavo(root, \"drive\", \"1\", \"--until-ready\",\n454\t                     env={\"ATTAVO_FIXTURE_QUESTION\": \"which overlay wins?\"})\n455\t    assert run.returncode == 0, run.stdout + run.stderr\n456\t    assert \"Needs you\" in run.stdout and \"stopped\" in run.stdout\n457\t\n458\t    assert len(record_files(root, \"build\")) == 1\n459\t    assert latest_record(root, \"build\")[\"status\"] == \"halted\"\n460\t    assert record_files(root, \"verify\") == []\n461\t    assert remote_head(bare, branch) == head_of(root)\n462\t\n463\t\n464\t\n465\tdef test_drive_until_ready_stops_when_the_forge_goes_red_after_a_build(tmp_path: Path) -> None:\n466\t    \"\"\"A build that passes, then a forge that concludes red on its head,\n467\t    stops the loop there with exit 1 -- the loop gave up short of ready\n468\t    -- one record written (the pass), no review record, no retry of the\n469\t    forge read.\"\"\"\n470\t    root = make_tenant(tmp_path, \"build_valid\")\n471\t    add_forge(root, RED_FORGE)\n472\t    add_bare_remote(root, tmp_path)\n473\t    approve_item(root)\n474\t\n475\t    run = run_attavo(root, \"drive\", \"1\", \"--until-ready\")\n476\t    assert run.returncode == 1, run.stdout + run.stderr\n477\t    assert \"ci\" in run.stdout and \"failure\" in run.stdout\n478\t\n479\t    assert len(record_files(root, \"build\")) == 1\n480\t    assert latest_record(root, \"build\")[\"status\"] == \"pass\"\n481\t    assert record_files(root, \"verify\") == []\n482\t\n483\t\n484\t\n485\tdef test_drive_line_buffers_stdout_so_a_pipe_reader_sees_the_start_line_before_the_stage_ends(tmp_path: Path) -> None:\n486\t    \"\"\"Issue #145, kept under R2. A pipe reader of `attavo drive` saw\n487\t    every line arrive as one burst when the process ended -- Python\n488\t    block-buffers stdout when it is not a tty. With --until-ready the\n489\t    process now outlives a slow stage; a pipe reader with a timeout well\n490\t    under the stage's own sleep must already see the \"started\" line the\n491\t    pass printed before that sleep ends -- unreachable if stdout is\n492\t    still block-buffered. The worker reconfigures its own stdout the same\n493\t    way, so its log is readable while it runs.\n494\t    \"\"\"\n495\t    root = make_tenant(tmp_path, \"build_valid\")\n496\t    add_forge(root, GREEN_FORGE)\n497\t    add_bare_remote(root, tmp_path)\n498\t    approve_item(root)\n499\t\n500\t    sleep_s = 3.0\n501\t    adapter_dir = root / \"attavo\" / \"adapters\" / \"slow\"\n502\t    adapter_dir.mkdir(parents=True)\n503\t    adapter_run = adapter_dir / \"run\"\n504\t    adapter_run.write_text(\n505\t        \"#!/bin/sh\\n\"\n506\t        \"set -eu\\n\"\n507\t        'if [ \"${ATTAVO_STAGE:-build}\" = \"verify\" ]; then\\n'\n508\t        '  printf \\'{\"model\":\"slow\",\"model_version\":null,\"adapter_version\":\"slow-1\",'\n509\t        '\"tokens\":{\"input\":1,\"output\":1},\"cost_usd\":0.0,\"findings\":[],\"tests_named\":[]}\\\\n\\'\\n'\n510\t        \"  exit 0\\n\"\n511\t        \"fi\\n\"\n512\t        f\"sleep {sleep_s}\\n\"\n513\t        \"echo built > built.txt\\n\"\n514\t        \"git add built.txt\\n\"\n515\t        \"git commit -q -m 'slow: write built.txt'\\n\"\n516\t        'echo \\'{\"status\":\"done\",\"question\":null,\"model\":\"slow\",\"model_version\":null,'\n517\t        '\"adapter_version\":\"slow-1\",\"tokens\":{\"input\":1,\"output\":1},\"cost_usd\":0.0}\\'\\n'\n518\t    )\n519\t    adapter_run.chmod(0o755)\n520\t    toml = root / \"attavo.toml\"\n521\t    toml.write_text(toml.read_text().replace('build = \"fixture\"', 'build = \"slow\"'))\n522\t    commit_all(root, \"use a slow adapter for build\")\n523\t\n524\t    full_env = dict(os.environ)\n525\t    full_env.update(FAST_POLL_ENV)\n526\t    proc = subprocess.Popen(\n527\t        [sys.executable, str(ATTAVO), \"drive\", \"1\", \"--until-ready\"],\n528\t        cwd=str(root), stdout=subprocess.PIPE, stderr=subprocess.STDOUT,\n529\t        text=True, env=full_env)\n530\t\n531\t    lines: \"queue.Queue[str | None]\" = queue.Queue()\n532\t\n533\t    def reader() -> None:\n534\t        for raw in cast(IO[str], proc.stdout):\n535\t            lines.put(raw)\n536\t        lines.put(None)\n537\t\n538\t    thread = threading.Thread(target=reader, daemon=True)\n539\t    thread.start()\n540\t\n541\t    try:\n542\t        first_line = lines.get(timeout=sleep_s / 2)\n543\t    except queue.Empty:\n544\t        proc.kill()\n545\t        raise\n546\t    assert first_line is not None and \"Build started\" in first_line, first_line\n547\t\n548\t    collected = [first_line]\n549\t    while True:\n550\t        line = lines.get(timeout=sleep_s + 30)\n551\t        if line is None:\n552\t            break\n553\t        collected.append(line)\n554\t    thread.join(timeout=5)\n555\t    proc.wait(timeout=5)\n556\t\n557\t    output = \"\".join(collected)\n558\t    assert proc.returncode == 0, output\n559\t    assert \"ready to merge\" in output.lower()\n560\t\n561\t\n562\t\n563\tdef test_drive_pass_reads_a_red_forge_as_blocked_and_starts_nothing(tmp_path: Path) -> None:\n564\t    \"\"\"Acceptance row 4, as a level. A forge read where the one check has\n565\t    already concluded and failed is not polled at all -- the pass reads\n566\t    the forge once, says Blocked naming the check, exits 0, and starts\n567\t    no review: no marker, no verify record, no new commit, no sleep.\"\"\"\n568\t    root = make_tenant(tmp_path, \"build_valid\")\n569\t    add_forge(root, RED_FORGE)\n570\t    add_bare_remote(root, tmp_path)\n571\t    approve_item(root)\n572\t\n573\t    assert drive(root, \"1\").returncode == 0  # builds\n574\t    pre_head = head_of(root)\n575\t\n576\t    started = time.monotonic()\n577\t    run = drive(root, \"1\")\n578\t    elapsed = time.monotonic() - started\n579\t    assert run.returncode == 0, run.stdout + run.stderr\n580\t    assert \"Blocked\" in run.stdout and \"ci failure\" in run.stdout\n581\t    assert \"worker pid\" not in run.stdout\n582\t    assert elapsed < 0.4, (\n583\t        f\"a concluded, red forge check is read once with no poll interval slept \"\n584\t        f\"-- took {elapsed:.2f}s\")\n585\t\n586\t    assert record_files(root, \"verify\") == []\n587\t    assert not (records_dir(root) / \"verify-01.started\").exists()\n588\t    assert head_of(root) == pre_head\n589\t\n590\t    # Idempotence (row 8): a pass in the same red state says the same,\n591\t    # still nothing written.\n592\t    run2 = drive(root, \"1\")\n593\t    assert run2.returncode == 0\n594\t    assert \"Blocked\" in run2.stdout\n595\t    assert record_files(root, \"verify\") == []\n596\t    assert head_of(root) == pre_head\n597\t\n598\t\n599\t\n600\tdef test_drive_until_ready_waits_out_the_bound_on_a_forge_still_running(tmp_path: Path) -> None:\n601\t    \"\"\"Acceptance row 4, the unconcluded case, under R2: a check still\n602\t    carrying a status (in_progress) is not red. The pass reads it once\n603\t    and returns at once saying Waiting on the checks; the waiting is\n604\t    --until-ready's, which repeats the pass for the forge bound and then\n605\t    gives up with exit 1, naming the check. Nothing is written either\n606\t    way.\"\"\"\n607\t    root = make_tenant(tmp_path, \"build_valid\")\n608\t    add_forge(root, UNCONCLUDED_FORGE)\n609\t    add_bare_remote(root, tmp_path)\n610\t    approve_item(root)\n611\t\n612\t    assert drive(root, \"1\").returncode == 0  # builds\n613\t\n614\t    started = time.monotonic()\n615\t    run = drive(root, \"1\")\n616\t    elapsed = time.monotonic() - started\n617\t    assert run.returncode == 0, run.stdout + run.stderr\n618\t    assert \"Waiting on the checks\" in run.stdout and \"in_progress\" in run.stdout\n619\t    assert elapsed < 0.4, f\"a pass reads the forge once and returns -- took {elapsed:.2f}s\"\n620\t\n621\t    started = time.monotonic()\n622\t    run2 = run_attavo(root, \"drive\", \"1\", \"--until-ready\")\n623\t    elapsed = time.monotonic() - started\n624\t    assert run2.returncode == 1, run2.stdout + run2.stderr\n625\t    assert \"in_progress\" in run2.stdout and \"did not conclude\" in run2.stdout\n626\t    assert elapsed >= 0.9, (\n627\t        f\"--until-ready should repeat the pass for the bound before giving up \"\n628\t        f\"-- took only {elapsed:.2f}s\")\n629\t"}]},"parent_tool_use_id":null,"session_id":"041a92ee-b14a-4832-b613-6f5a12b6a373","uuid":"08c1d6f9-7cbd-401b-b1e8-8be087650ac0","timestamp":"2026-09-25T18:06:21.043Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-217/attest/specs/217/stub/tests/test_drive.py","content":"\ndef test_drive_pass_waits_on_an_absent_approval(tmp_path: Path) -> None:\n    \"\"\"Acceptance row 6, as a level (R2): with no approval the pass says\n    the item is waiting on the operator, exits 0 because a level is not a\n    refusal, and runs nothing -- no spec-gate, no build, no records.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    add_bare_remote(root, tmp_path)\n\n    run = drive(root, \"1\")\n    assert run.returncode == 0, run.stdout + run.stderr\n    assert \"approve the spec\" in run.stdout\n    assert \"worker pid\" not in run.stdout\n\n    assert not records_dir(root).exists() or list(records_dir(root).glob(\"*.json\")) == []\n\n\n\ndef test_drive_pass_waits_on_an_expired_approval(tmp_path: Path) -> None:\n    \"\"\"Acceptance row 6, the other half: an approval bound to a spec sha\n    that has since moved is expired, not absent -- the pass says so, by\n    that word, exits 0, and starts nothing.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    add_bare_remote(root, tmp_path)\n    approve_item(root)\n\n    (root / \"specs\" / \"1\" / \"spec.md\").write_text(\n        (root / \"specs\" / \"1\" / \"spec.md\").read_text() + \"\\n\")\n    commit_all(root, \"touch the spec after approval\")\n\n    run = drive(root, \"1\")\n    assert run.returncode == 0, run.stdout + run.stderr\n    assert \"expired\" in run.stdout\n    assert \"worker pid\" not in run.stdout\n    assert record_files(root, \"build\") == []\n\n\ndef test_drive_builds_from_an_approved_spec_with_no_build(tmp_path: Path) -> None:\n    \"\"\"Acceptance row 1. One drive run produces a passing build record,\n    commits only the record and its log (`git commit --only`), and pushes\n    the branch; the fixture remote carries the record commit.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    bare = add_bare_remote(root, tmp_path)\n    approve_item(root)\n    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n\n    run = drive(root, \"1\")\n    assert run.returncode == 0, run.stdout + run.stderr\n\n    rec = latest_record(root, \"build\")\n    assert rec[\"status\"] == \"pass\"\n\n    record_path = record_files(root, \"build\")[-1]\n    log_path = record_path.with_suffix(\".log\")\n    assert log_path.exists()\n\n    touched = set(last_commit_paths(root))\n    assert touched == {\n        str(record_path.relative_to(root)),\n        str(log_path.relative_to(root)),\n    }\n\n    assert remote_head(bare, branch) == head_of(root)\n\n\ndef test_drive_leaves_the_events_file_out_of_the_record_commit(tmp_path: Path) -> None:\n    \"\"\"Issue #26, acceptance row 2, strengthened by issue #140: attavo\n    build always writes a stage's events file now (test_build.py's own\n    row-1 tests), under the checkout's own git directory rather than\n    the working tree -- so it is not merely excluded from the commit's\n    file list, it is not even a path git tracks anything under. The\n    commit's file list still names only the record and its log.\n    \"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    add_bare_remote(root, tmp_path)\n    approve_item(root)\n\n    run = drive(root, \"1\")\n    assert run.returncode == 0, run.stdout + run.stderr\n\n    record_path = record_files(root, \"build\")[-1]\n    git_dir = git(root, \"rev-parse\", \"--absolute-git-dir\").strip()\n    events_path = Path(git_dir) / \"attavo\" / \"build-01.events.jsonl\"\n    assert events_path.is_file()\n\n    touched = set(last_commit_paths(root))\n    assert touched == {\n        str(record_path.relative_to(root)),\n        str(record_path.with_suffix(\".log\").relative_to(root)),\n    }\n\n\ndef test_drive_commits_the_record_as_the_driver_not_the_tenants_own_identity(tmp_path: Path) -> None:\n    \"\"\"The driver's identity (driver_identity, beside executor_identity):\n    set by the product, never the tenant's git config, so a driven item's\n    record commits are never indistinguishable from an operator's own.\n    The fixture tenant's user.name is set to another value here, so a\n    commit carrying it would prove commit_record fell back to the\n    tenant's git config instead.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    git(root, \"config\", \"user.name\", \"Some Operator\")\n    git(root, \"config\", \"user.email\", \"operator@example.com\")\n    add_forge(root, GREEN_FORGE)\n    add_bare_remote(root, tmp_path)\n    approve_item(root)\n\n    run = drive(root, \"1\")\n    assert run.returncode == 0, run.stdout + run.stderr\n\n    author_name = git(root, \"log\", \"-1\", \"--format=%an\").strip()\n    author_email = git(root, \"log\", \"-1\", \"--format=%ae\").strip()\n    committer_name = git(root, \"log\", \"-1\", \"--format=%cn\").strip()\n    committer_email = git(root, \"log\", \"-1\", \"--format=%ce\").strip()\n\n    assert author_name == \"attavo driver\"\n    assert author_email == \"driver@attavo.invalid\"\n    assert committer_name == \"attavo driver\"\n    assert committer_email == \"driver@attavo.invalid\"\n\n\ndef test_drive_verifies_from_a_passed_build_with_the_forge_green(tmp_path: Path) -> None:\n    \"\"\"Acceptance row 2. From a passed build with the fake forge green,\n    one run produces a verify record, commits only the record and its log,\n    and pushes.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    bare = add_bare_remote(root, tmp_path)\n    approve_item(root)\n    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n\n    assert drive(root, \"1\").returncode == 0  # builds\n\n    run = drive(root, \"1\")\n    assert run.returncode == 0, run.stdout + run.stderr\n\n    assert record_files(root, \"build\") and record_files(root, \"verify\")\n    rec = latest_record(root, \"verify\")\n    assert rec[\"status\"] == \"pass\"\n\n    record_path = record_files(root, \"verify\")[-1]\n    log_path = record_path.with_suffix(\".log\")\n    assert log_path.exists()\n\n    touched = set(last_commit_paths(root))\n    assert touched == {\n        str(record_path.relative_to(root)),\n        str(log_path.relative_to(root)),\n    }\n\n    assert remote_head(bare, branch) == head_of(root)\n\n\ndef test_drive_verifies_again_when_the_latest_verify_is_superseded_by_a_later_build(tmp_path: Path) -> None:\n    \"\"\"Acceptance row 4, issue #109. A verify record can only name a build\n    that existed when it was written, so a later build makes the latest\n    verify superseded, never a mismatch -- drive derives the next stage\n    as verify, not build, and never refuses.\n\n    Regression: on main before this lane, drive_state's own inline\n    staleness check already treats this as 'verify', so this test does\n    not fail against current code -- it is here to lock the behavior\n    check_attest_chain's fix must not disturb (the acceptance table's\n    'never refuses' row).\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    add_bare_remote(root, tmp_path)\n    approve_item(root)\n\n    assert drive(root, \"1\").returncode == 0  # builds\n    assert drive(root, \"1\").returncode == 0  # verifies\n\n    # A second build record, minted by hand -- a real re-run of the\n    # fixture adapter is not idempotent against its own tree -- naming a\n    # sha the existing verify-01 does not: verify-01 is now superseded.\n    build_01 = json.loads(record_files(root, \"build\")[-1].read_text())\n    build_01[\"sha\"] = \"f\" * 40\n    (records_dir(root) / \"build-02.json\").write_text(json.dumps(build_01))\n    commit_all(root, \"attavo: second build record for #1, minted by hand\")\n\n    run = drive(root, \"1\")\n    assert run.returncode == 0, run.stdout + run.stderr\n    assert len(record_files(root, \"build\")) == 2\n    assert len(record_files(root, \"verify\")) == 2\n    rec = latest_record(root, \"verify\")\n    assert rec[\"status\"] == \"pass\"\n    assert rec[\"build_sha\"] == build_01[\"sha\"]\n\n\n\ndef test_drive_prints_ready_to_merge_from_a_passed_verify(tmp_path: Path) -> None:\n    \"\"\"Acceptance row 3. From a passed verify with the forge green, one\n    pass prints ready to merge, exits 0, writes nothing, enqueues nothing\n    -- and, per row 8, a further pass repeats exactly the same thing.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    add_bare_remote(root, tmp_path)\n    approve_item(root)\n\n    assert drive(root, \"1\").returncode == 0  # builds\n    assert drive(root, \"1\").returncode == 0  # verifies\n\n    pre_head = head_of(root)\n    run = drive(root, \"1\")\n    assert run.returncode == 0, run.stdout + run.stderr\n    assert \"ready to merge\" in run.stdout.lower()\n    assert head_of(root) == pre_head\n    assert record_files(root, \"verify\") and len(record_files(root, \"verify\")) == 1\n\n    # Acceptance row 8: idempotence -- run it again, same result, nothing\n    # new written or pushed.\n    run2 = drive(root, \"1\")\n    assert run2.returncode == 0\n    assert \"ready to merge\" in run2.stdout.lower()\n    assert head_of(root) == pre_head\n    assert len(record_files(root, \"verify\")) == 1\n    assert len(record_files(root, \"build\")) == 1\n\n\n\ndef test_drive_until_ready_runs_build_then_verify_to_ready_in_one_call(tmp_path: Path) -> None:\n    \"\"\"Issue #100's own followups, kept under R2: --until-ready repeats\n    the pass in one process until the level is the operator's or done.\n    One call, from an approved item with the forge green, starts the\n    build, waits it out, starts the review, waits it out, and prints\n    ready to merge -- both records written and pushed.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    bare = add_bare_remote(root, tmp_path)\n    approve_item(root)\n    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n\n    run = run_attavo(root, \"drive\", \"1\", \"--until-ready\")\n    assert run.returncode == 0, run.stdout + run.stderr\n    assert \"ready to merge\" in run.stdout.lower()\n\n    assert len(record_files(root, \"build\")) == 1\n    assert len(record_files(root, \"verify\")) == 1\n    assert latest_record(root, \"build\")[\"status\"] == \"pass\"\n    assert latest_record(root, \"verify\")[\"status\"] == \"pass\"\n    assert remote_head(bare, branch) == head_of(root)\n\n    # Idempotence, same as the single-pass form: a further --until-ready\n    # call repeats exactly the same ready-to-merge result, writing nothing.\n    run2 = run_attavo(root, \"drive\", \"1\", \"--until-ready\")\n    assert run2.returncode == 0\n    assert \"ready to merge\" in run2.stdout.lower()\n    assert len(record_files(root, \"build\")) == 1\n    assert len(record_files(root, \"verify\")) == 1\n\n\ndef test_drive_without_the_flag_still_takes_one_step_at_a_time(tmp_path: Path) -> None:\n    \"\"\"Regression: --until-ready is additive. With no flag, an approved\n    item with the forge green still needs two separate calls -- build,\n    then verify -- exactly as before this issue.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    add_bare_remote(root, tmp_path)\n    approve_item(root)\n\n    run = drive(root, \"1\")\n    assert run.returncode == 0\n    assert record_files(root, \"build\") and not record_files(root, \"verify\")\n\n    run2 = drive(root, \"1\")\n    assert run2.returncode == 0\n    assert record_files(root, \"verify\")\n\n\n\ndef test_drive_until_ready_stops_on_a_halt(tmp_path: Path) -> None:\n    \"\"\"A stage that stops on its own account -- here, a halted build --\n    ends the --until-ready loop at a level that is the operator's: the\n    loop prints the stopped line the plain pass would and exits 0; it\n    does not start the next attempt on its own.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    bare = add_bare_remote(root, tmp_path)\n    approve_item(root)\n    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n\n    run = run_attavo(root, \"drive\", \"1\", \"--until-ready\",\n                     env={\"ATTAVO_FIXTURE_QUESTION\": \"which overlay wins?\"})\n    assert run.returncode == 0, run.stdout + run.stderr\n    assert \"Needs you\" in run.stdout and \"stopped\" in run.stdout\n\n    assert len(record_files(root, \"build\")) == 1\n    assert latest_record(root, \"build\")[\"status\"] == \"halted\"\n    assert record_files(root, \"verify\") == []\n    assert remote_head(bare, branch) == head_of(root)\n\n\n\ndef test_drive_until_ready_stops_when_the_forge_goes_red_after_a_build(tmp_path: Path) -> None:\n    \"\"\"A build that passes, then a forge that concludes red on its head,\n    stops the loop there with exit 1 -- the loop gave up short of ready\n    -- one record written (the pass), no review record, no retry of the\n    forge read.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, RED_FORGE)\n    add_bare_remote(root, tmp_path)\n    approve_item(root)\n\n    run = run_attavo(root, \"drive\", \"1\", \"--until-ready\")\n    assert run.returncode == 1, run.stdout + run.stderr\n    assert \"ci\" in run.stdout and \"failure\" in run.stdout\n\n    assert len(record_files(root, \"build\")) == 1\n    assert latest_record(root, \"build\")[\"status\"] == \"pass\"\n    assert record_files(root, \"verify\") == []\n\n\n\ndef test_drive_line_buffers_stdout_so_a_pipe_reader_sees_the_start_line_before_the_stage_ends(tmp_path: Path) -> None:\n    \"\"\"Issue #145, kept under R2. A pipe reader of `attavo drive` saw\n    every line arrive as one burst when the process ended -- Python\n    block-buffers stdout when it is not a tty. With --until-ready the\n    process now outlives a slow stage; a pipe reader with a timeout well\n    under the stage's own sleep must already see the \"started\" line the\n    pass printed before that sleep ends -- unreachable if stdout is\n    still block-buffered. The worker reconfigures its own stdout the same\n    way, so its log is readable while it runs.\n    \"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    add_bare_remote(root, tmp_path)\n    approve_item(root)\n\n    sleep_s = 3.0\n    adapter_dir = root / \"attavo\" / \"adapters\" / \"slow\"\n    adapter_dir.mkdir(parents=True)\n    adapter_run = adapter_dir / \"run\"\n    adapter_run.write_text(\n        \"#!/bin/sh\\n\"\n        \"set -eu\\n\"\n        'if [ \"${ATTAVO_STAGE:-build}\" = \"verify\" ]; then\\n'\n        '  printf \\'{\"model\":\"slow\",\"model_version\":null,\"adapter_version\":\"slow-1\",'\n        '\"tokens\":{\"input\":1,\"output\":1},\"cost_usd\":0.0,\"findings\":[],\"tests_named\":[]}\\\\n\\'\\n'\n        \"  exit 0\\n\"\n        \"fi\\n\"\n        f\"sleep {sleep_s}\\n\"\n        \"echo built > built.txt\\n\"\n        \"git add built.txt\\n\"\n        \"git commit -q -m 'slow: write built.txt'\\n\"\n        'echo \\'{\"status\":\"done\",\"question\":null,\"model\":\"slow\",\"model_version\":null,'\n        '\"adapter_version\":\"slow-1\",\"tokens\":{\"input\":1,\"output\":1},\"cost_usd\":0.0}\\'\\n'\n    )\n    adapter_run.chmod(0o755)\n    toml = root / \"attavo.toml\"\n    toml.write_text(toml.read_text().replace('build = \"fixture\"', 'build = \"slow\"'))\n    commit_all(root, \"use a slow adapter for build\")\n\n    full_env = dict(os.environ)\n    full_env.update(FAST_POLL_ENV)\n    proc = subprocess.Popen(\n        [sys.executable, str(ATTAVO), \"drive\", \"1\", \"--until-ready\"],\n        cwd=str(root), stdout=subprocess.PIPE, stderr=subprocess.STDOUT,\n        text=True, env=full_env)\n\n    lines: \"queue.Queue[str | None]\" = queue.Queue()\n\n    def reader() -> None:\n        for raw in cast(IO[str], proc.stdout):\n            lines.put(raw)\n        lines.put(None)\n\n    thread = threading.Thread(target=reader, daemon=True)\n    thread.start()\n\n    try:\n        first_line = lines.get(timeout=sleep_s / 2)\n    except queue.Empty:\n        proc.kill()\n        raise\n    assert first_line is not None and \"Build started\" in first_line, first_line\n\n    collected = [first_line]\n    while True:\n        line = lines.get(timeout=sleep_s + 30)\n        if line is None:\n            break\n        collected.append(line)\n    thread.join(timeout=5)\n    proc.wait(timeout=5)\n\n    output = \"\".join(collected)\n    assert proc.returncode == 0, output\n    assert \"ready to merge\" in output.lower()\n\n\n\ndef test_drive_pass_reads_a_red_forge_as_blocked_and_starts_nothing(tmp_path: Path) -> None:\n    \"\"\"Acceptance row 4, as a level. A forge read where the one check has\n    already concluded and failed is not polled at all -- the pass reads\n    the forge once, says Blocked naming the check, exits 0, and starts\n    no review: no marker, no verify record, no new commit, no sleep.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, RED_FORGE)\n    add_bare_remote(root, tmp_path)\n    approve_item(root)\n\n    assert drive(root, \"1\").returncode == 0  # builds\n    pre_head = head_of(root)\n\n    started = time.monotonic()\n    run = drive(root, \"1\")\n    elapsed = time.monotonic() - started\n    assert run.returncode == 0, run.stdout + run.stderr\n    assert \"Blocked\" in run.stdout and \"ci failure\" in run.stdout\n    assert \"worker pid\" not in run.stdout\n    assert elapsed < 0.4, (\n        f\"a concluded, red forge check is read once with no poll interval slept \"\n        f\"-- took {elapsed:.2f}s\")\n\n    assert record_files(root, \"verify\") == []\n    assert not (records_dir(root) / \"verify-01.started\").exists()\n    assert head_of(root) == pre_head\n\n    # Idempotence (row 8): a pass in the same red state says the same,\n    # still nothing written.\n    run2 = drive(root, \"1\")\n    assert run2.returncode == 0\n    assert \"Blocked\" in run2.stdout\n    assert record_files(root, \"verify\") == []\n    assert head_of(root) == pre_head\n\n\n\ndef test_drive_until_ready_waits_out_the_bound_on_a_forge_still_running(tmp_path: Path) -> None:\n    \"\"\"Acceptance row 4, the unconcluded case, under R2: a check still\n    carrying a status (in_progress) is not red. The pass reads it once\n    and returns at once saying Waiting on the checks; the waiting is\n    --until-ready's, which repeats the pass for the forge bound and then\n    gives up with exit 1, naming the check. Nothing is written either\n    way.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, UNCONCLUDED_FORGE)\n    add_bare_remote(root, tmp_path)\n    approve_item(root)\n\n    assert drive(root, \"1\").returncode == 0  # builds\n\n    started = time.monotonic()\n    run = drive(root, \"1\")\n    elapsed = time.monotonic() - started\n    assert run.returncode == 0, run.stdout + run.stderr\n    assert \"Waiting on the checks\" in run.stdout and \"in_progress\" in run.stdout\n    assert elapsed < 0.4, f\"a pass reads the forge once and returns -- took {elapsed:.2f}s\"\n\n    started = time.monotonic()\n    run2 = run_attavo(root, \"drive\", \"1\", \"--until-ready\")\n    elapsed = time.monotonic() - started\n    assert run2.returncode == 1, run2.stdout + run2.stderr\n    assert \"in_progress\" in run2.stdout and \"did not conclude\" in run2.stdout\n    assert elapsed >= 0.9, (\n        f\"--until-ready should repeat the pass for the bound before giving up \"\n        f\"-- took only {elapsed:.2f}s\")\n","numLines":460,"startLine":170,"totalLines":1099}}}

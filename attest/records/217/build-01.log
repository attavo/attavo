m, item_id, records_dir), r","+    if r[\"state\"] == \"next-build\":","+        return _start_stage(root, m, item_id, \"build\", None), r","+    if r[\"state\"] == \"next-review\":","+        checks_command = (m.get(\"forge\") or {}).get(\"checks_command\")","+        forge_checks = {\"command\": checks_command, \"sha\": r[\"head\"], \"conclusions\": r[\"checks\"] or []}","+        return _start_stage(root, m, item_id, \"verify\", forge_checks), r","+    if again and r[\"state\"] == \"stopped\" and r[\"stage\"]:","+        return _advance_again(root, m, item_id, cast(str, r[\"stage\"]), r[\"head\"]), r"," ","+    print(f\"attavo drive: {r['says']}\")","+    return (1 if r[\"state\"] == \"refused\" else 0), r","+","+","+_TERMINAL_STATES = (\"waiting-on-approval\", \"stopped\", \"ready-to-merge\", \"merged\")","+","+","+def _until_ready(root: Path, m: dict[str, Any], item_id: str, again: bool) -> int:","+    \"\"\"--until-ready: the pass, repeated in one process, sleeping","+    ATTAVO_DRIVE_POLL_INTERVAL_S between passes, until the level is the","+    operator's or done (exit 0), a concluded check is red (exit 1), or","+    an unconcluded one has not concluded within ATTAVO_DRIVE_POLL_BOUND_S","+    (exit 1). A stage running in its own worker is not bounded by this --","+    only time spent waiting on the forge is.\"\"\"","+    from attavo.verify import drive_forge_poll_bound_s, drive_forge_poll_interval_s","+    bound = drive_forge_poll_bound_s()","+    interval = drive_forge_poll_interval_s()","+    waiting_since: float | None = None","+    while True:","+        rc, r = _pass_once(root, m, item_id, again)","+        state = r[\"state\"]","+","+        if state == \"waiting-on-checks\":","+            if waiting_since is None:","+                waiting_since = time.monotonic()","+            elif time.monotonic() - waiting_since >= bound:","+                print(f\"attavo drive: stopped: the checks did not conclude within {bound:.0f}s\")","+                return 1","+        else:","+            waiting_since = None","+","+        if rc != 0:","+            return rc","+        if state in _TERMINAL_STATES:","+            return 0","+        if state == \"blocked-on-checks\":","+            return 1","+        time.sleep(interval)","+","+","+def _drive_all() -> int:","+    \"\"\"--all: one pass, in its own process, in every ../attavo-worktree-N","+    beside this checkout -- each one derives its own item from its own","+    attavo/N-* branch. Every line either prints is prefixed with the","+    worktree's own directory name, so an operator reading them together","+    can tell which item each line is about.\"\"\"","+    root = Path(\".\").resolve()","+    siblings = sorted(p for p in root.parent.glob(\"attavo-worktree-*\") if p.is_dir())","+    if not siblings:","+        print(\"attavo drive: --all found no ../attavo-worktree-N beside this checkout\")","+        return 0","+    worst = 0","+    for copy in siblings:","+        run = subprocess.run([sys.executable, str(PRODUCT_ROOT / \"bin\" / \"attavo\"), \"drive\"],","+                             cwd=str(copy), capture_output=True, text=True, check=False)","+        for line in (run.stdout + run.stderr).splitlines():","+            print(f\"{copy.name}: {line}\")","+        worst = max(worst, run.returncode)","+    return worst","+","+"," def cmd_drive(argv: list[str]) -> int:","     # Issue #145: Python block-buffers stdout when it is not a tty (a","-    # pipe, e.g. a screen reading this process live), so every stage","-    # line -- attavo build:, attavo drive: pushed, attavo verify:, attavo","-    # drive: item N is ready to merge -- would otherwise sit unflushed","-    # until this process exits. Line-buffering makes a pipe reader see","-    # each line the moment it is printed, the same as a terminal already","-    # does; no other output path changes.","+    # pipe, e.g. a screen reading this process live), so every line this","+    # prints would otherwise sit unflushed until the process exits.","+    # Line-buffering makes a pipe reader see each line the moment it is","+    # printed, the same as a terminal already does; `attavo worker`","+    # reconfigures its own stdout the same way.","     cast(io.TextIOWrapper, sys.stdout).reconfigure(line_buffering=True)","+","+    if \"--recover\" in argv:","+        print(\"attavo drive: --recover is gone; a pass recovers a dead or hung invocation \"","+              \"itself, as soon as the report owes one\", file=sys.stderr)","+        return 2","+","     until_ready = \"--until-ready\" in argv","-    recover = \"--recover\" in argv","     report = \"--report\" in argv","-    positional = [a for a in argv if a not in (\"--until-ready\", \"--recover\", \"--report\")]","+    again = \"--again\" in argv","+    all_flag = \"--all\" in argv","+    positional = [a for a in argv if not a.startswith(\"--\")]","+","+    if all_flag:","+        if until_ready or report or again or positional:","+            print(\"attavo drive: --all runs one pass in every worktree beside this checkout; \"","+                  \"drop N and every other flag\", file=sys.stderr)","+            return 2","+        return _drive_all()","+","     root = Path(\".\").resolve()","     item_id = positional[0] if positional else derive_item_id(root)","     if not item_id:"]},{"oldStart":281,"oldLines":187,"newStart":705,"newLines":20,"lines":["         return 2"," ","     if report:","-        if until_ready or recover:","+        if until_ready or again:","             print(\"attavo drive: --report reads and does nothing else; drop --until-ready \"","-                  \"and --recover\", file=sys.stderr)","+                  \"and --again\", file=sys.stderr)","             return 2","-        from attavo.report import drive_report","-        print(json.dumps(drive_report(root, m, item_id), indent=2))","+        try:","+            fast_forward_to_origin(root, m, item_id)","+            from attavo.report import 
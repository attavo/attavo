{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SrsU6iriKLmVB3X78YsPgD","type":"tool_result","content":"schema/drive-report.schema.json\n---\n{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"$id\": \"https://attavo.dev/drive-report/v1\",\n  \"title\": \"attavo drive --report\",\n  \"description\": \"What one item is waiting on and for whom: a pure function of its records, its markers, and one read of the forge. Printing it changes nothing.\",\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"required\": [\n    \"item\",\n    \"state\",\n    \"kind\",\n    \"says\",\n    \"stage\",\n    \"attempt\",\n    \"record\",\n    \"stop_class\",\n    \"counsel\",\n    \"filed\",\n    \"head\",\n    \"checks\",\n    \"since\",\n    \"last_event_age_s\"\n  ],\n  \"properties\": {\n    \"item\": {\n      \"type\": \"string\"\n    },\n    \"state\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"waiting-on-approval\",\n        \"running\",\n        \"owes-recovery\",\n        \"stopped\",\n        \"next-build\",\n        \"waiting-on-checks\",\n        \"blocked-on-checks\",\n        \"next-review\",\n        \"ready-to-merge\",\n        \"merged\",\n        \"refused\"\n      ]\n    },\n    \"kind\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"yours\",\n        \"waits\",\n        \"acts\",\n        \"done\"\n      ],\n      \"description\": \"yours: a person's act is next. waits: nothing to do but wait. acts: the next drive would act. done: nothing further from here.\"\n    },\n    \"says\": {\n      \"type\": \"string\",\n      \"description\": \"One sentence in the operator's words.\"\n    },\n    \"stage\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ],\n      \"enum\": [\n        \"build\",\n        \"verify\",\n        null\n      ]\n    },\n    \"attempt\": {\n      \"type\": [\n        \"integer\",\n        \"null\"\n      ]\n    },\n    \"record\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"stop_class\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"counsel\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"filed\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"head\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"checks\": {\n      \"type\": [\n        \"array\",\n        \"null\"\n      ],\n      \"items\": {\n        \"type\": \"object\",\n        \"required\": [\n          \"name\",\n          \"conclusion\"\n        ],\n        \"properties\": {\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"conclusion\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    },\n    \"since\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"last_event_age_s\": {\n      \"type\": [\n        \"integer\",\n        \"null\"\n      ]\n    }\n  }\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"041a92ee-b14a-4832-b613-6f5a12b6a373","uuid":"67949bd5-63a0-4ecb-984f-007e08784744","timestamp":"2026-09-25T18:05:25.583Z","tool_use_result":{"stdout":"schema/drive-report.schema.json\n---\n{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"$id\": \"https://attavo.dev/drive-report/v1\",\n  \"title\": \"attavo drive --report\",\n  \"description\": \"What one item is waiting on and for whom: a pure function of its records, its markers, and one read of the forge. Printing it changes nothing.\",\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"required\": [\n    \"item\",\n    \"state\",\n    \"kind\",\n    \"says\",\n    \"stage\",\n    \"attempt\",\n    \"record\",\n    \"stop_class\",\n    \"counsel\",\n    \"filed\",\n    \"head\",\n    \"checks\",\n    \"since\",\n    \"last_event_age_s\"\n  ],\n  \"properties\": {\n    \"item\": {\n      \"type\": \"string\"\n    },\n    \"state\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"waiting-on-approval\",\n        \"running\",\n        \"owes-recovery\",\n        \"stopped\",\n        \"next-build\",\n        \"waiting-on-checks\",\n        \"blocked-on-checks\",\n        \"next-review\",\n        \"ready-to-merge\",\n        \"merged\",\n        \"refused\"\n      ]\n    },\n    \"kind\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"yours\",\n        \"waits\",\n        \"acts\",\n        \"done\"\n      ],\n      \"description\": \"yours: a person's act is next. waits: nothing to do but wait. acts: the next drive would act. done: nothing further from here.\"\n    },\n    \"says\": {\n      \"type\": \"string\",\n      \"description\": \"One sentence in the operator's words.\"\n    },\n    \"stage\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ],\n      \"enum\": [\n        \"build\",\n        \"verify\",\n        null\n      ]\n    },\n    \"attempt\": {\n      \"type\": [\n        \"integer\",\n        \"null\"\n      ]\n    },\n    \"record\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"stop_class\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"counsel\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"filed\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"head\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"checks\": {\n      \"type\": [\n        \"array\",\n        \"null\"\n      ],\n      \"items\": {\n        \"type\": \"object\",\n        \"required\": [\n          \"name\",\n          \"conclusion\"\n        ],\n        \"properties\": {\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"conclusion\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    },\n    \"since\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"last_event_age_s\": {\n      \"type\": [\n        \"integer\",\n        \"null\"\n      ]\n    }\n  }\n}","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}

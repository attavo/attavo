git config user.name \"fixture\"\nprintf '\\n[forge]\\nchecks_command = \"sh %s/forge.sh\"\\n\\n[drive]\\nstall_after_s = 60\\n' \"$tmp\" >> attavo.toml\ngit add -A\ngit commit -q -m install\ngit init -q --bare -b main \"$tmp/origin.git\"\ngit remote add origin \"$tmp/origin.git\"\ngit push -q origin HEAD:main 2>/dev/null\ngit update-ref refs/remotes/origin/main \"$(git rev-parse HEAD)\"\ngit symbolic-ref refs/remotes/origin/HEAD refs/remotes/origin/main\nexport ATTAVO_HEARTBEAT_S=1 ATTAVO_DRIVE_POLL_BOUND_S=2 ATTAVO_DRIVE_POLL_INTERVAL_S=1\nA=\"python3 $here/bin/attavo\"\n$A spec-gate 1 >/dev/null\n$A approve 1 --by alice >/dev/null\ngit add -A\ngit commit -q -m approved\ngit push -q origin HEAD:main 2>/dev/null\n$A drive 1 >\"$tmp/pass1.out\" 2>&1\ni=0\nuntil git -C \"$tmp/origin.git\" cat-file -e main:records/1/build-01.json 2>/dev/null\ndo\n  i=$((i+1))\n  test \"$i\" -lt 60\n  sleep 1\ndone\ngit pull -q --ff-only origin main\n: > \"$tmp/forge-calls.txt\"\npre_marker=$(git rev-parse HEAD)\n$A drive 1 >\"$tmp/pass2.out\" 2>&1\ni=0\nuntil git -C \"$tmp/origin.git\" cat-file -e main:records/1/verify-01.json 2>/dev/null\ndo\n  i=$((i+1))\n  test \"$i\" -lt 60\n  sleep 1\ndone\ngit -C \"$tmp/origin.git\" show main:records/1/verify-01.json | python3 -c 'import sys,json; r=json.load(sys.stdin); assert r[\"status\"] == \"pass\", r[\"status\"]; assert r[\"forge_checks\"][\"sha\"] == sys.argv[1], (r[\"forge_checks\"][\"sha\"], sys.argv[1])' \"$pre_marker\"\ntest \"$(tr -s '\\n' '\\n' < \"$tmp/forge-calls.txt\" | grep -c .)\" = 1\ntest \"$(cat \"$tmp/forge-calls.txt\")\" = \"$pre_marker\"\ncd \"$here\"\nrm -rf \"$tmp\"\n\n== attest/specs/217/criteria/the-tests-exist.sh ==\n#!/bin/sh\nset -e\nfor t in test_a_pass_returns_while_the_worker_runs_and_the_worker_outlives_it test_the_worker_touches_its_heartbeat_and_the_report_reads_running_by_it test_a_stale_heartbeat_reads_died_though_the_pid_lives_and_a_fresh_one_reads_alive test_two_passes_at_once_start_one_worker_and_the_loser_says_so test_a_pass_recovers_a_dead_invocation_and_recover_is_gone test_the_review_takes_the_checks_the_pass_read_and_never_polls test_until_ready_is_a_loop_of_passes_that_returns_at_ready test_a_stopped_stage_is_left_alone_by_a_pass_and_started_again_by_again test_all_runs_one_pass_in_every_working_copy_beside_the_checkout\ndo\n  grep -q \"^def $t(\" tests/test_pass.py\ndone\nfor t in test_drive_pass_waits_on_an_absent_approval test_drive_pass_reads_a_red_forge_as_blocked_and_starts_nothing test_drive_until_ready_waits_out_the_bound_on_a_forge_still_running test_drive_halts_on_a_question_and_again_resumes_at_build_after_a_ruling test_drive_pass_fast_forwards_to_a_branch_that_moved_before_taking_the_lease test_drive_worker_retries_a_rejected_record_push_with_a_merge_never_a_rebase test_drive_a_refused_marker_push_ends_the_pass_with_exit_1 test_drive_pass_writes_a_died_record_for_a_dead_invocation test_drive_pass_recovers_a_dead_invocation_without_a_stall_bound test_drive_recover_flag_is_gone\ndo\n  grep -q \"^def $t(\" tests/test_drive.py\ndone","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}

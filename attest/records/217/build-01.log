g verify-02\n    and verify-03 markers and records -- #158's own twenty minutes, in\n    miniature.\"\"\"\n    module, root, m, records_dir = _drive_fixture(tmp_path)\n\n    steps = 0\n    for _ in range(3):\n        steps += 1\n        rc, done = module._drive_step(root, m, \"1\")\n        if done:\n            break\n\n    assert steps == 1, f\"the loop took {steps} steps for one returned verify\"\n    assert len(list(records_dir.glob(\"verify-*.started\"))) == 1\n    assert len(list(records_dir.glob(\"verify-*.json\"))) == 1","new_string":"    assert len(p[\"running_invocations\"]) == 1\n    assert \"verify-01\" in p[\"running_invocations\"][0]\n    assert p[\"in_flight\"] == []"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":3685,"cache_read_input_tokens":245242,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":3685},"output_tokens":16,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"041a92ee-b14a-4832-b613-6f5a12b6a373","uuid":"b641e56f-a248-49ef-8daf-426d1460b63f","timestamp":"2026-09-25T18:20:56.720Z","request_id":"req_011CfQcy7t5hBcRWsx7A5CzS","wire_tool_inputs":{"toolu_01Wtpc1PtM82ZKcRuwcsHhDW":{"file_path":"/Users/davidbean/Projects/attavo-worktree-217/tests/test_proof_five_elsewhere.py","old_string":"    assert len(p[\"running_invocations\"]) == 1\n    assert \"verify-01\" in p[\"running_invocations\"][0]\n    assert p[\"in_flight\"] == []\n\n\n# --- acceptance 3: a returned verify ends --until-ready, not another marker ---\n\ndef _drive_fixture(tmp_path: Path) -> tuple[Any, Path, dict[str, Any], Path]:\n    \"\"\"A real (if minimal) repository and bare remote -- everything\n    _drive_run_stage itself touches (write_invocation_marker,\n    commit_record, push_record_commit) -- with a fake verif
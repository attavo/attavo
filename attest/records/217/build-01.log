{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016wwXeLy86BrGqz1m8Fa76H","type":"tool_result","content":"1\t\"\"\"Issue #174: proof five judged a marker from another host exactly like\n2\tone from this host with no live pid -- \"died by absence\" -- so every\n3\tverify on the forge's own runners failed the doctor and the `test` job on\n4\tthe very commit the drive then waited on, since a marker's pid is never\n5\talive there. This file is red before the change: the age judgement (a\n6\tyoung marker from elsewhere holds, in `in_flight`; an old one still\n7\tfails) does not exist yet, and `_drive_step` treats a `returned` verify\n8\tas if it had passed, so `--until-ready` writes a new marker and a new\n9\trecord every poll bound instead of stopping.\n10\t\n11\tRun: python3 -m pytest tests -q\n12\t\"\"\"\n13\timport importlib\n14\timport json\n15\timport os\n16\timport socket\n17\timport subprocess\n18\timport sys\n19\tfrom datetime import datetime, timedelta, timezone\n20\tfrom pathlib import Path\n21\tfrom typing import Any\n22\t\n23\tfrom helpers import commit_all, init_repo\n24\t\n25\tROOT = Path(__file__).resolve().parent.parent\n26\tATTAVO = ROOT / \"bin\" / \"attavo\"\n27\t\n28\tOTHER_HOST = \"elsewhere.example\"\n29\tSTALL_BOUND_S = 60\n30\t\n31\t\n32\tdef attavo_module() -> Any:\n33\t    \"\"\"attavo.drive imported in-process and fresh each call, so a test can\n34\t    monkeypatch a module-level function (drive_state, poll_forge_checks,\n35\t    cmd_verify, ...) without leaking into any other test.\"\"\"\n36\t    return importlib.reload(importlib.import_module(\"attavo.drive\"))\n37\t\n38\t\n39\tdef iso_ago(seconds: float) -> str:\n40\t    stamp = datetime.now(timezone.utc) - timedelta(seconds=seconds)\n41\t    return stamp.strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n42\t\n43\t\n44\tdef run_doctor(root: Path) -> dict[str, Any]:\n45\t    out = subprocess.run([sys.executable, str(ATTAVO), \"doctor\", str(root), \"--json\"],\n46\t                         capture_output=True, text=True, check=False)\n47\t    report = json.loads(out.stdout)\n48\t    assert out.returncode == (0 if report[\"done\"] else 1)\n49\t    return {p[\"proof\"]: p for p in report[\"proofs\"]}\n50\t\n51\t\n52\tdef _proof_five_fixture(tmp_path: Path, name: str) -> Path:\n53\t    root = tmp_path / name\n54\t    root.mkdir()\n55\t    (root / \"attavo.toml\").write_text(\n56\t        '[paths]\\nrecords = \"records\"\\n\\n'\n57\t        f'[drive]\\nstall_after_s = {STALL_BOUND_S}\\n')\n58\t    init_repo(root, \"install\")\n59\t    return root\n60\t\n61\t\n62\tdef _write_marker(root: Path, host: str, pid: int, at: str, stage: str = \"verify\",\n63\t                  nn: int = 1, item: str = \"1\") -> None:\n64\t    records = root / \"records\" / item\n65\t    records.mkdir(parents=True, exist_ok=True)\n66\t    (records / f\"{stage}-{nn:02d}.started\").write_text(json.dumps({\n67\t        \"at\": at, \"host\": host, \"pid\": pid, \"sha\": \"0\" * 40,\n68\t        \"product_version\": \"fixture\"}))\n69\t    commit_all(root, f\"invocation marker for item {item}\")\n70\t\n71\t\n72\tdef _dead_pid() -> int:\n73\t    proc = subprocess.Popen([sys.executable, \"-c\", \"pass\"])\n74\t    proc.wait()\n75\t    return proc.pid\n76\t\n77\t\n78\tdef test_proof_five_holds_a_young_marker_from_another_host_as_in_flight(tmp_path: Path) -> None:\n79\t    \"\"\"Acceptance 1 (half). A marker from a host that is not this one, and\n80\t    younger than [drive].stall_after_s, is an invocation still running\n81\t    elsewhere -- proof five holds and names it in in_flight, not among\n82\t    the failures.\"\"\"\n83\t    root = _proof_five_fixture(tmp_path, \"young_elsewhere\")\n84\t    _write_marker(root, OTHER_HOST, 4242, iso_ago(STALL_BOUND_S / 4))\n85\t\n86\t    p = run_doctor(root)[\"no-invocation-lacks-record\"]\n87\t    assert p[\"holds\"], p[\"reason\"]\n88\t    assert len(p[\"in_flight\"]) == 1\n89\t    assert \"verify-01\" in p[\"in_flight\"][0] and OTHER_HOST in p[\"in_flight\"][0]\n90\t    assert p[\"running_invocations\"] == []\n91\t\n92\t\n93\tdef test_proof_five_fails_an_old_marker_from_another_host_past_the_bound(tmp_path: Path) -> None:\n94\t    \"\"\"Acceptance 1 (other half). The same marker, older than the bound,\n95\t    is failed by absence exactly as a marker with no host at all would\n96\t    be -- naming it.\"\"\"\n97\t    root = _proof_five_fixture(tmp_path, \"old_elsewhere\")\n98\t    _write_marker(root, OTHER_HOST, 4242, iso_ago(STALL_BOUND_S * 10))\n99\t\n100\t    p = run_doctor(root)[\"no-invocation-lacks-record\"]\n101\t    assert not p[\"holds\"]\n102\t    assert \"verify-01\" in p[\"reason\"] and OTHER_HOST in p[\"reason\"]\n103\t    assert p[\"in_flight\"] == []\n104\t\n105\t\n106\tdef test_proof_five_still_fails_a_dead_invocation_on_this_host(tmp_path: Path) -> None:\n107\t    \"\"\"Acceptance 2 (half), a regression guard: a marker naming this\n108\t    host's own hostname and a dead pid fails exactly as before -- the\n109\t    age judgement is for another host only, and must not loosen the\n110\t    local reading into holding on a dead local invocation just because\n111\t    it is still young.\"\"\"\n112\t    root = _proof_five_fixture(tmp_path, \"dead_local\")\n113\t    _write_marker(root, socket.gethostname(), _dead_pid(), iso_ago(1))\n114\t\n115\t    p = run_doctor(root)[\"no-invocation-lacks-record\"]\n116\t    assert not p[\"holds\"]\n117\t    assert \"verify-01\" in p[\"reason\"] and \"never wrote its record\" in p[\"reason\"]\n118\t    assert p[\"in_flight\"] == []\n119\t\n120\t\n121\tdef test_proof_five_still_holds_a_live_invocation_on_this_host_as_running(tmp_path: Path) -> None:\n122\t    \"\"\"Acceptance 2 (other half), a regression guard: a marker naming\n123\t    this host and a live pid holds as running_invocations, not\n124\t    in_flight -- the two lists stay distinct by what invocation_alive\n125\t    itself can confirm.\"\"\"\n126\t    root = _proof_five_fixture(tmp_path, \"live_local\")\n127\t    _write_marker(root, socket.gethostname(), os.getpid(), iso_ago(1))\n128\t\n129\t    p = run_doctor(root)[\"no-invocation-lacks-record\"]\n130\t    assert p[\"holds\"], p[\"reason\"]\n131\t    assert len(p[\"running_invocations\"]) == 1\n132\t    assert \"verify-01\" in p[\"running_invocations\"][0]\n133\t    assert p[\"in_flight\"] == []\n134\t\n135\t\n136\t# --- acceptance 3: a returned verify ends --until-ready, not another marker ---\n137\t\n138\tdef _drive_fixture(tmp_path: Path) -> tuple[Any, Path, dict[str, Any], Path]:\n139\t    \"\"\"A real (if minimal) repository and bare remote -- everything\n140\t    _drive_run_stage itself touches (write_invocation_marker,\n141\t    commit_record, push_record_commit) -- with a fake verify stage\n142\t    standing in for cmd_verify: the same contract (a \"returned\" record,\n143\t    written to disk, exit code 0 -- issue #174's own point, that exit\n144\t    code says nothing about whether the record is a pass) without any\n145\t    adapter, forge, or approval machinery those functions do not touch.\n146\t    drive_state and poll_forge_checks are faked too, so this exercises\n147\t    exactly _drive_step's own done judgement -- the line this issue\n148\t    changes -- and nothing upstream of it.\"\"\"\n149\t    module = attavo_module()\n150\t    root = tmp_path / \"fake_stage\"\n151\t    root.mkdir()\n152\t    (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n')\n153\t    init_repo(root, \"install\")\n154\t    bare = tmp_path / \"origin.git\"\n155\t    subprocess.run([\"git\", \"init\", \"--quiet\", \"--bare\", \"-b\", \"main\", str(bare)], check=True)\n156\t    module.git(root, \"remote\", \"add\", \"origin\", str(bare))\n157\t    module.git(root, \"push\", \"origin\", \"HEAD:main\")\n158\t\n159\t    records_dir = root / \"records\" / \"1\"\n160\t    m = {\"paths\": {\"records\": \"records\"}, \"forge\": {\"checks_command\": \"true\"}}\n161\t\n162\t    def fake_cmd_verify(argv: list[str]) -> int:\n163\t        nn = module.next_attempt_number(records_dir, \"verify\")\n164\t        path = records_dir / f\"verify-{nn:02d}.json\"\n165\t        path.parent.mkdir(parents=True, exist_ok=True)\n166\t        path.write_text(json.dumps({\n167\t            \"status\": \"returned\", \"sha\": \"0\" * 40,\n168\t            \"stop\": {\"class\": \"forge-unconcluded\", \"provenance\": \"tenant\", \"detail\": None}}))\n169\t        return 0  # cmd_verify's own contract: exit 0 on a returned record too.\n170\t\n171\t    module.drive_state = lambda root_, m_, item_id: (\"verify\", None, records_dir)\n172\t    module.poll_forge_checks = lambda root_, checks_command, sha: ({\"conclusions\": []}, True)\n173\t    module.cmd_verify = fake_cmd_verify\n174\t    module.cmd_counsel = lambda argv: 1\n175\t    module.cmd_file_stops = lambda argv: 1\n176\t    return module, root, m, records_dir\n177\t\n178\t\n179\tdef test_drive_step_stops_on_a_returned_verify(tmp_path: Path) -> None:\n180\t    \"\"\"Acceptance 3 (half). A single _drive_step call against a fake\n181\t    verify stage that writes a \"returned\" record reports done=True --\n182\t    before this change it read done from cmd_verify's own exit code\n183\t    (0, since returning is not an operational error) and reported\n184\t    done=False instead, as if the stage had just passed.\"\"\"\n185\t    module, root, m, records_dir = _drive_fixture(tmp_path)\n186\t\n187\t    rc, done = module._drive_step(root, m, \"1\")\n188\t\n189\t    assert done, \"a returned verify must be a stop, not a pass\"\n190\t    assert len(list(records_dir.glob(\"verify-*.json\"))) == 1\n191\t    assert len(list(records_dir.glob(\"verify-*.started\"))) == 1\n192\t\n193\t\n194\tdef test_drive_until_ready_stops_after_one_step_on_a_returned_verify(tmp_path: Path) -> None:\n195\t    \"\"\"Acceptance 3 (other half). The same fake stage, driven through\n196\t    --until-ready's own loop shape (repeat while not done, bounded here\n197\t    at 3 iterations so a regression fails fast instead of hanging):\n198\t    exactly one step runs, one marker and one record are written. On\n199\t    main at 5da8b82 this loops for all 3 iterations, writing verify-02\n200\t    and verify-03 markers and records -- #158's own twenty minutes, in\n201\t    miniature.\"\"\"\n202\t    module, root, m, records_dir = _drive_fixture(tmp_path)\n203\t\n204\t    steps = 0\n205\t    for _ in range(3):\n206\t        steps += 1\n207\t        rc, done = module._drive_step(root, m, \"1\")\n208\t        if done:\n209\t            break\n210\t\n211\t    assert steps == 1, f\"the loop took {steps} steps for one returned verify\"\n212\t    assert len(list(records_dir.glob(\"verify-*.started\"))) == 1\n213\t    assert len(list(records_dir.glob(\"verify-*.json\"))) == 1\n214\t"}]},"parent_tool_use_id":null,"session_id":"041a92ee-b14a-4832-b613-6f5a12b6a373","uuid":"34d9708c-8709-4e96-b3ee-bb3eff96b89f","timestamp":"2026-09-25T18:20:12.749Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-217/tests/test_proof_five_elsewhere.py","content":"\"\"\"Issue #174: proof five judged a marker from another host exactly like\none from this host with no live pid -- \"died by absence\" -- so every\nverify on the forge's own runners failed the doctor and the `test` job on\nthe very commit the drive then waited on, since a marker's pid is never\nalive there. This file is red before the change: the age judgement (a\nyoung marker from elsewhere holds, in `in_flight`; an old one still\nfails) does not exist yet, and `_drive_step` treats a `returned` verify\nas if it had passed, so `--until-ready` writes a new marker and a new\nrecord every poll bound instead of stopping.\n\nRun: python3 -m pytest tests -q\n\"\"\"\nimport importlib\nimport json\nimport os\nimport socket\nimport subprocess\nimport sys\nfrom datetime import datetime, timedelta, timezone\nfrom pathlib import Path\nfrom typing import Any\n\nfrom helpers import commit_all, init_repo\n\nROOT = Path(__file__).resolve().parent.parent\nATTAVO = ROOT / \"bin\" / \"attavo\"\n\nOTHER_HOST = \"elsewhere.example\"\nSTALL_BOUND_S = 60\n\n\ndef attavo_module() -> Any:\n    \"\"\"attavo.drive imported in-process and fresh each call, so a test can\n    monkeypatch a module-level function (drive_state, poll_forge_checks,\n    cmd_verify, ...) without leaking into any other test.\"\"\"\n    return importlib.reload(importlib.import_module(\"attavo.drive\"))\n\n\ndef iso_ago(seconds: float) -> str:\n    stamp = datetime.now(timezone.utc) - timedelta(seconds=seconds)\n    return stamp.strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n\n\ndef run_doctor(root: Path) -> dict[str, Any]:\n    out = subprocess.run([sys.executable, str(ATTAVO), \"doctor\", str(root), \"--json\"],\n                         capture_output=True, text=True, check=False)\n    report = json.loads(out.stdout)\n    assert out.returncode == (0 if report[\"done\"] else 1)\n    return {p[\"proof\"]: p for p in report[\"proofs\"]}\n\n\ndef _proof_five_fixture(tmp_path: Path, name: str) -> Path:\n    root = tmp_path / name\n    root.mkdir()\n    (root / \"attavo.toml\").write_text(\n        '[paths]\\nrecords = \"records\"\\n\\n'\n        f'[drive]\\nstall_after_s = {STALL_BOUND_S}\\n')\n    init_repo(root, \"install\")\n    return root\n\n\ndef _write_marker(root: Path, host: str, pid: int, at: str, stage: str = \"verify\",\n                  nn: int = 1, item: str = \"1\") -> None:\n    records = root / \"records\" / item\n    records.mkdir(parents=True, exist_ok=True)\n    (records / f\"{stage}-{nn:02d}.started\").write_text(json.dumps({\n        \"at\": at, \"host\": host, \"pid\": pid, \"sha\": \"0\" * 40,\n        \"product_version\": \"fixture\"}))\n    commit_all(root, f\"invocation marker for item {item}\")\n\n\ndef _dead_pid() -> int:\n    proc = subprocess.Popen([sys.executable, \"-c\", \"pass\"])\n    proc.wait()\n    return proc.pid\n\n\ndef test_proof_five_holds_a_young_marker_from_another_host_as_in_flight(tmp_path: Path) -> None:\n    \"\"\"Acceptance 1 (half). A marker from a host that is not this one, and\n    younger than [drive].stall_after_s, is an invocation still running\n    elsewhere -- proof five holds and names it in in_flight, not among\n    the failures.\"\"\"\n    root = _proof_five_fixture(tmp_path, \"young_elsewhere\")\n    _write_marker(root, OTHER_HOST, 4242, iso_ago(STALL_BOUND_S / 4))\n\n    p = run_doctor(root)[\"no-invocation-lacks-record\"]\n    assert p[\"holds\"], p[\"reason\"]\n    assert len(p[\"in_flight\"]) == 1\n    assert \"verify-01\" in p[\"in_flight\"][0] and OTHER_HOST in p[\"in_flight\"][0]\n    assert p[\"running_invocations\"] == []\n\n\ndef test_proof_five_fails_an_old_marker_from_another_host_past_the_bound(tmp_path: Path) -> None:\n    \"\"\"Acceptance 1 (other half). The same marker, older than the bound,\n    is failed by absence exactly as a marker with no host at all would\n    be -- naming it.\"\"\"\n    root = _proof_five_fixture(tmp_path, \"old_elsewhere\")\n    _write_marker(root, OTHER_HOST, 4242, iso_ago(STALL_BOUND_S * 10))\n\n    p = run_doctor(root)[\"no-invocation-lacks-record\"]\n    assert not p[\"holds\"]\n    assert \"verify-01\" in p[\"reason\"] and OTHER_HOST in p[\"reason\"]\n    assert p[\"in_flight\"] == []\n\n\ndef test_proof_five_still_fails_a_dead_invocation_on_this_host(tmp_path: Path) -> None:\n    \"\"\"Acceptance 2 (half), a regression guard: a marker naming this\n    host's own hostname and a dead pid fails exactly as before -- the\n    age judgement is for another host only, and must not loosen the\n    local reading into holding on a dead local invocation just because\n    it is still young.\"\"\"\n    root = _proof_five_fixture(tmp_path, \"dead_local\")\n    _write_marker(root, socket.gethostname(), _dead_pid(), iso_ago(1))\n\n    p = run_doctor(root)[\"no-invocation-lacks-record\"]\n    assert not p[\"holds\"]\n    assert \"verify-01\" in p[\"reason\"] and \"never wrote its record\" in p[\"reason\"]\n    assert p[\"in_flight\"] == []\n\n\ndef test_proof_five_still_holds_a_live_invocation_on_this_host_as_running(tmp_path: Path) -> None:\n    \"\"\"Acceptance 2 (other half), a regression guard: a marker naming\n    this host and a live pid holds as running_invocations, not\n    in_flight -- the two lists stay distinct by what invocation_alive\n    itself can confirm.\"\"\"\n    root = _proof_five_fixture(tmp_path, \"live_local\")\n    _write_marker(root, socket.gethostname(), os.getpid(), iso_ago(1))\n\n    p = run_doctor(root)[\"no-invocation-lacks-record\"]\n    assert p[\"holds\"], p[\"reason\"]\n    assert len(p[\"running_invocations\"]) == 1\n    assert \"verify-01\" in p[\"running_invocations\"][0]\n    assert p[\"in_flight\"] == []\n\n\n# --- acceptance 3: a returned verify ends --until-ready, not another marker ---\n\ndef _drive_fixture(tmp_path: Path) -> tuple[Any, Path, dict[str, Any], Path]:\n    \"\"\"A real (if minimal) repository and bare remote -- everything\n    _drive_run_stage itself touches (write_invocation_marker,\n    commit_record, push_record_commit) -- with a fake verify stage\n    standing in for cmd_verify: the same contract (a \"returned\" record,\n    written to disk, exit code 0 -- issue #174's own point, that exit\n    code says nothing about whether the record is a pass) without any\n    adapter, forge, or approval machinery those functions do not touch.\n    drive_state and poll_forge_checks are faked too, so this exercises\n    exactly _drive_step's own done judgement -- the line this issue\n    changes -- and nothing upstream of it.\"\"\"\n    module = attavo_module()\n    root = tmp_path / \"fake_stage\"\n    root.mkdir()\n    (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n')\n    init_repo(root, \"install\")\n    bare = tmp_path / \"origin.git\"\n    subprocess.run([\"git\", \"init\", \"--quiet\", \"--bare\", \"-b\", \"main\", str(bare)], check=True)\n    module.git(root, \"remote\", \"add\", \"origin\", str(bare))\n    module.git(root, \"push\", \"origin\", \"HEAD:main\")\n\n    records_dir = root / \"records\" / \"1\"\n    m = {\"paths\": {\"records\": \"records\"}, \"forge\": {\"checks_command\": \"true\"}}\n\n    def fake_cmd_verify(argv: list[str]) -> int:\n        nn = module.next_attempt_number(records_dir, \"verify\")\n        path = records_dir / f\"verify-{nn:02d}.json\"\n        path.parent.mkdir(parents=True, exist_ok=True)\n        path.write_text(json.dumps({\n            \"status\": \"returned\", \"sha\": \"0\" * 40,\n            \"stop\": {\"class\": \"forge-unconcluded\", \"provenance\": \"tenant\", \"detail\": None}}))\n        return 0  # cmd_verify's own contract: exit 0 on a returned record too.\n\n    module.drive_state = lambda root_, m_, item_id: (\"verify\", None, records_dir)\n    module.poll_forge_checks = lambda root_, checks_command, sha: ({\"conclusions\": []}, True)\n    module.cmd_verify = fake_cmd_verify\n    module.cmd_counsel = lambda argv: 1\n    module.cmd_file_stops = lambda argv: 1\n    return module, root, m, records_dir\n\n\ndef test_drive_step_stops_on_a_returned_verify(tmp_path: Path) -> None:\n    \"\"\"Acceptance 3 (half). A single _drive_step call against a fake\n    verify stage that writes a \"returned\" record reports done=True --\n    before this change it read done from cmd_verify's own exit code\n    (0, since returning is not an operational error) and reported\n    done=False instead, as if the stage had just passed.\"\"\"\n    module, root, m, records_dir = _drive_fixture(tmp_path)\n\n    rc, done = module._drive_step(root, m, \"1\")\n\n    assert done, \"a returned verify must be a stop, not a pass\"\n    assert len(list(records_dir.glob(\"verify-*.json\"))) == 1\n    assert len(list(records_dir.glob(\"verify-*.started\"))) == 1\n\n\ndef test_drive_until_ready_stops_after_one_step_on_a_returned_verify(tmp_path: Path) -> None:\n    \"\"\"Acceptance 3 (other half). The same fake stage, driven through\n    --until-ready's own loop shape (repeat while not done, bounded here\n    at 3 iterations so a regression fails fast instead of hanging):\n    exactly one step runs, one marker and one record are written. On\n    main at 5da8b82 this loops for all 3 iterations, writing verify-02\n    and verify-03 markers and records -- #158's own twenty minutes, in\n    miniature.\"\"\"\n    module, root, m, records_dir = _drive_fixture(tmp_path)\n\n    steps = 0\n    for _ in range(3):\n        steps += 1\n        rc, done = module._drive_step(root, m, \"1\")\n        if done:\n            break\n\n    assert steps == 1, f\"the loop took {steps} steps for one returned verify\"\n    assert len(list(records_dir.glob(\"verify-*.started\"))) == 1\n    assert len(list(records_dir.glob(\"verify-*.json\"))) == 1\n","numLines":214,"startLine":1,"totalLines":214}}}

ks: {refusal_text}\")\n+            log = out + err\n+            detail = _log_last_line(out + \"\\n\" + err) or refusal_text\n             record = {\n                 \"sha\": start_sha,\n                 \"start_sha\": start_sha,\n@@ -285,19 +311,20 @@ def cmd_build(argv: list[str]) -> int:\n                 \"iterations\": 1,\n                 \"criteria\": [],\n                 \"selected_tests\": None,\n-                \"checks\": {\"command\": checks_command, \"exit\": preflight.returncode},\n+                \"checks\": {\"command\": asked, \"exit\": code},\n                 \"tokens\": {\"input\": 0, \"output\": 0},\n                 \"cost_usd\": None,\n                 \"wall_clock_s\": round(time.monotonic() - started, 3),\n                 \"status\": \"refused\",\n-                \"refusal\": \"[checks].command exited 2 on the approved tree\",\n+                \"refusal\": refusal_text,\n                 \"halted\": None,\n                 \"stop\": {\"class\": \"environment\", \"provenance\": \"tenant\", \"detail\": detail},\n             }\n             record_path = write_record(item_records_dir, \"build\", record, m, item_id,\n-                                       log=preflight.stdout + preflight.stderr)\n+                                       log=log or refusal_text + \"\\n\")\n             print(f\"attavo build: refused ({record_path.name})\")\n             return 1\n+        append_event(events_path, \"gate\", \"this machine can run the checks\")\n \n     adapter_version = model = model_version = None\n     tokens = {\"input\": 0, \"output\": 0}\n@@ -312,8 +339,6 @@ def cmd_build(argv: list[str]) -> int:\n     halted = None\n     iterations_used = 0\n \n-    events_path = stage_events_dir(root) / f\"build-{next_attempt_number(item_records_dir, 'build'):02d}.events.jsonl\"\n-\n     with tempfile.TemporaryDirectory() as tmp:\n         feedback_path = Path(tmp) / \"feedback.txt\"\n         feedback_path.write_text(\"\")\n@@ -331,8 +356,11 @@ def cmd_build(argv: list[str]) -> int:\n             env[\"ATTAVO_ADAPTER_CONFIG\"] = json.dumps(adapter_config)\n             env[\"ATTAVO_STAGE\"] = \"build\"\n             env[\"ATTAVO_EVENTS\"] = str(events_path)\n-            if checks_command:\n-                env[\"ATTAVO_CHECKS_COMMAND\"] = checks_command\n+            env[\"ATTAVO_TEST_COMMAND\"] = f\"python3 {PRODUCT_ROOT / 'bin' / 'attavo'} test {item_id}\"\n+            if tests_cfg.get(\"call_timeout_s\"):\n+                env[\"ATTAVO_TEST_TIMEOUT_S\"] = str(tests_cfg[\"call_timeout_s\"])\n+            else:\n+                env.pop(\"ATTAVO_TEST_TIMEOUT_S\", None)\n             env[\"GIT_AUTHOR_NAME\"] = identity[\"name\"]\n             env[\"GIT_AUTHOR_EMAIL\"] = identity[\"email\"]\n             env[\"GIT_COMMITTER_NAME\"] = identity[\"name\"]\ndiff --git a/attavo/cli.py b/attavo/cli.py\nindex d5a100a..e544b07 100644\n--- a/attavo/cli.py\n+++ b/attavo/cli.py\n@@ -14,6 +14,7 @@\n     attavo drive [N] [--until-ready | --report]\n     attavo ledger [N] [--json]\n     attavo stops [N] [--json]\n+    attavo test [N]\n \n The doctor is the definition of done. It asserts five proofs against a\n tenant root and exits 1 until every proof holds:\n@@ -86,7 +87,14 @@ whole-tree check, from the tenant root. pass requires every criterion,\n the test run, and the tenant's checks (if declared) to exit 0; any\n non-zero exit iterates, with the failure as feedback, up to a fixed\n budget. [checks] is optional; a tenant that declares none is not\n-refused. It writes the next build-NN.json under paths.records/N/, with\n+refused. Before the adapter is invoked it asks whether this machine can\n+run the checks -- of [checks].probe, run once inside [checks].probe_timeout_s\n+(exit 0 yes; anything else, or the bound, an environment refusal), or,\n+for a tenant that declares no probe, by running [checks].command whole\n+(exit 2 no) -- and says both the question and the answer in the feed\n+(issue #212). The adapter is given ATTAVO_TEST_COMMAND, `attavo test N`,\n+and ATTAVO_TEST_TIMEOUT_S when [tests].call_timeout_s is declared; it\n+is not given the tenant's checks. It writes the next build-NN.json under paths.records/N/, with\n the adapter's transcript -- each iteration's gate output (criteria\n exits, the selected tests' stdout, the tenant's checks' tail) appended\n under an \"--- attavo gates, iteration N ---\" heading, issue #89 -- beside\n@@ -96,6 +104,15 @@ already on hand (issue #89); a pass record carries stop: null. See the\n build contract in the project's Phase 2 issue for the full rules it\n enforces.\n \n+test [N] runs the tests [tests].select names for every path the item has\n+changed since it left the default branch (refs/remotes/origin/HEAD),\n+committed or not and untracked included, paths.records aside, through\n+[tests].run. It prints how many were selected (or that none was, and runs\n+nothing), exits as the run does, and, when [tests].call_timeout_s is\n+declared and the run outlasts it, ends the run and everything it started\n+and exits 124. It exits 2 when it cannot name the changes or the selector\n+fails. It is the one test command an executor is given (issue #212).\n+\n verify refuses (exit 1) unless the item's latest build record has\n status pass, and unless the manifest declares [forge].checks_command --\n a tenant command, taking a full commit sha on argv, that prints one\n@@ -272,6 +289,7 @@ from attavo.ledger import cmd_ledger\n from attavo.record_only import cmd_record_only\n from attavo.spec import cmd_spec_gate\n from attavo.stops import cmd_stops\n+from attavo.testtool import cmd_test\n from attavo.verify import cmd_verify\n \n \n@@ -307,7 +325,9 @@ def main(argv: list[str]) -> int:\n         return cmd_ledger(argv[1:])\n     if argv[0] == \"stops\":\n         return cmd_stops(argv[1:])\n+    if argv[0] == \"test\":\n+        return cmd_test(argv[1:])\n     print(f\"attavo: unknown subcommand {argv[0]!r}; only doctor, spec-gate, approve, \"\n           f\"approval-status, build, verify, file-findings, file-stops, counsel, record-only, \"\n-          f\"attest, drive, ledger, stops exist at this commit\", file=sys.stderr)\n+          f\"attest, drive, ledger, stops, test exist at this commit\", file=sys.stderr)\n     return 2\ndiff --git a/attavo/testtool.py b/attavo/testtool.py\nnew file mode 100644\nindex 0000000..3ad8cf0\n--- /dev/null\n+++ b/attavo/testtool.py\n@@ -0,0 +1,132 @@\n+from __future__ import annotations\n+\n+import os\n+import signal\n+import subprocess\n+import sys\n+from pathlib import Path\n+from typing import Any\n+\n+from attavo.common import MANIFEST, derive_item_id, git, read_manifest\n+\n+# --- test: the executor's one test command (issue #212) --\n+# The tests [tests].select names for every path the item has changed since\n+# it left the default branch, run through [tests].run, bounded by\n+# [tests].call_timeout_s. The executor is given this and not the tenant's\n+# whole-tree checks: given a checks command it ran it (#194's 590 s wait;\n+# #204 and #206 ran the suite twice inside one build), and the gate runs\n+# them after every commit whatever the executor does. ---\n+\n+TIMED_OUT_EXIT = 124\n+\n+# What an ended run is given to leave on its own after SIGTERM, before its\n+# whole process group is sent SIGKILL.\n+END_GRACE_S = 2\n+\n+\n+def _signal_group(proc: \"subprocess.Popen[str]\", sig: int) -> None:\n+    try:\n+        os.killpg(proc.pid, sig)\n+    except ProcessLookupError:\n+        pass\n+\n+\n+def run_bounded(command: str, root: Path, stdin: str, timeout_s: int | None\n+                ) -> tuple[int, str, str, bool]:\n+    \"\"\"(exit, stdout, stderr, timed_out) of `command` run through the shell\n+    from root. The command is its own process group's leader, so a run past\n+    timeout_s is ended with everything it started -- a test runner's\n+    workers and a shell's background jobs alike -- rather than only the\n+    shell, which would leave them holding the pipes and the machine. A run\n+    that outlasts its bound exits 124, as timeout(1) does.\"\"\"\n+    proc = subprocess.Popen(command, shell=True, cwd=str(root), stdin=subprocess.PIPE,\n+                            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,\n+                            start_new_session=True)\n+    try:\n+        out, err = proc.communicate(stdin, timeout=timeout_s)\n+    except subprocess.TimeoutExpired:\n+        _signal_group(proc, signal.SIGTERM)\n+        try:\n+            out, err = proc.communicate(timeout=END_GRACE_S)\n+        except subprocess.TimeoutExpired:\n+            _signal_group(proc, signal.SIGKILL)\n+            try:\n+                out, err = proc.communicate(timeout=END_GRACE_S)\n+            except subprocess.TimeoutExpired:\n+                # something the run started left its group and holds the pipes\n+                out, err = \"\", \"\"\n+        _signal_group(proc, signal.SIGKILL)\n+        return TIMED_OUT_EXIT, out, err, True\n+    _signal_group(proc, signal.SIGKILL)\n+    return proc.returncode, out, err, False\n+\n+\n+def without_records(paths: list[str], records_rel: str) -> list[str]:\n+    \"\"\"paths other than paths.records itself and what is under it -- the\n+    records directory is where the product writes, not the item's work.\"\"\"\n+    prefix = records_rel.rstrip(\"/\") + \"/\"\n+    return [p for p in paths if p and p != records_rel and not p.startswith(prefix)]\n+\n+\n+def changed_since_default_branch(root: Path, records_rel: str) -> list[str]:\n+    \"\"\"Every path the item has changed since it left the default branch,\n+    committed or not: tracked paths whose content differs from the\n+    merge-base with what refs/remotes/origin/HEAD names -- deleted and\n+    renamed-from paths included, staged or not -- and untracked paths that\n+    are not ignored. Sorted; the records directory left aside.\n+    RuntimeError when the default branch cannot be named.\"\"\"\n+    default = git(root, \"symbolic-ref\", \"-q\", \"refs/remotes/origin/HEAD\").strip()\n+    base = git(root, \"merge-base\", default, \"HEAD\").strip()\n+    tracked = git(root, \"diff\", \"--name-only\", \"--no-renames\", \"-z\", base).split(\"\\0\")\n+    untracked = git(root, \"ls-files\", \"--others\", \"--exclude-standard\", \"-z\").split(\"\\0\")\n+    return sorted(set(without_records(tracked + untracked, records_rel)))\n+\n+\n+def cmd_test(argv: list[str]) -> int:\n+    root = Path(\".\").resolve()\n+    item_id = argv[0] if argv else derive_item_id(root)\n+    if not item_id:\n+        print(\"attavo test: cannot derive item id; pass N or run on an attavo/N-* branch\",\n+              file=sys.stderr)\n+        return 2\n+    m = read_manifest(root)\n+    if m is None:\n+        print(f\"attavo test: no {MANIFEST} at {root}\", file=sys.stderr)\n+        return 2\n+    tests_cfg: dict[str, Any] = m.get(\"tests\") or {}\n+    if not tests_cfg.get(\"select\") or not tests_cfg.get(\"run\"):\n+        print(\"attavo test: no [tests] table in the manifest \"\n+              \"([tests].select and [tests].run are both required)\", file=sys.stderr)\n+        return 2\n+    try:\n+        changed = changed_since_default_branch(root, m[\"paths\"][\"records\"])\n+    except RuntimeError as exc:\n+        print(f\"attavo test: cannot name what item {item_id} has changed: {exc}; \"\n+              \"run `git remote set-head origin -a`\", file=sys.stderr)\n+        return 2\n+\n+    select_run = subprocess.run(tests_cfg[\"select\"], shell=True, cwd=str(root),\n+                                input=\"\".join(p + \"\\n\" for p in changed),\n+                                capture_output=True, text=True, check=False)\n+    if select_run.returncode != 0:\n+        # Nothing selected because the selector failed is not nothing to run.\n+        sys.stderr.write(select_run.stderr)\n+        print(f\"attavo test: [tests].select exited {select_run.returncode}; nothing was run\",\n+              file=sys.stderr)\n+        return 2\n+    identifiers = [line for line in select_run.stdout.splitlines() if line.strip()]\n+    if not identifiers:\n+        print(f\"attavo test {item_id}: no test is selected for the {len(changed)} \"\n+              \"path(s) changed since the default branch\")\n+        return 0\n+\n+    bound = tests_cfg.get(\"call_timeout_s\")\n+    print(f\"attavo test {item_id}: {len(identifiers)} selected\", flush=True)\n+    code, out, err, timed_out = run_bounded(tests_cfg[\"run\"], root,\n+                                            \"\".join(i + \"\\n\" for i in identifiers), bound)\n+    sys.stdout.write(out)\n+    sys.stderr.write(err)\n+    if timed_out:\n+        print(f\"attavo test {item_id}: the run did not finish within {bound} s; \"\n+              \"it and everything it started were ended\")\n+    return code\ndiff --git a/schema/manifest.schema.json b/schema/manifest.schema.json\nindex cfddc45..3265252 100644\n--- a/schema/manifest.schema.json\n+++ b/schema/manifest.schema.json\n@@ -58,6 +58,11 @@\n           \"type\": \"string\",\n           \"description\": \"A command that reads test identifiers on stdin, one per line; its exit code is the verdict.\",\n           \"minLength\": 1\n+        },\n+        \"call_timeout_s\": {\n+          \"type\": \"integer\",\n+          \"minimum\": 1,\n+          \"description\": \"Seconds one `attavo test` run is given before its process group is ended and it exits 124. The executor's own test runs are bounded; the gate's are not.\"\n         }\n       }\n     },\n@@ -69,10 +74,21 @@\n       \"properties\": {\n         \"command\": {\n           \"type\": \"string\",\n-          \"description\": \"The tenant's whole-tree check, run from the tenant root.\",\n+          \"description\": \"The tenant's whole-tree check at the gate, run from the tenant root once per iteration on the committed tree. What is fast and decisive belongs here; what the forge runs as a required check need not be run twice.\",\n+          \"minLength\": 1\n+        },\n+        \"probe\": {\n+          \"type\": \"string\",\n+          \"description\": \"A cheap command that answers whether this machine can run the checks at all, run once before a build's executor is invoked: exit 0 yes, anything else an environment refusal. When absent, attavo build asks by running [checks].command whole and reads exit 2 alone as cannot run.\",\n           \"minLength\": 1\n+        },\n+        \"probe_timeout_s\": {\n+          \"type\": \"integer\",\n+          \"minimum\": 1,\n+          \"description\": \"Seconds [checks].probe is given; past it the build is refused as an environment stop. Required with probe: a bound the tenant did not write is a forecast.\"\n         }\n-      }\n+      },\n+      \"dependentRequired\": {\"probe\": [\"probe_timeout_s\"]}\n     },\n     \"forge\": {\n       \"type\": \"object\",\ndiff --git a/tests/test_self_tenancy.py b/tests/test_self_tenancy.py\nindex 81225e0..8c165f7 100644\n--- a/tests/test_self_tenancy.py\n+++ b/tests/test_self_tenancy.py\n@@ -91,8 +91,14 @@ def test_checks_and_tests_run_deselect_the_four_dogfood_doctor_tests() -> None:\n     then restored.\"\"\"\n     m = load_manifest()\n     for flag in DESELECT_FLAGS:\n-        assert flag in m[\"checks\"][\"command\"], m[\"checks\"][\"command\"]\n         assert flag in m[\"tests\"][\"run\"], m[\"tests\"][\"run\"]\n+    # Since the calibration item the gate's [checks].command runs the type\n+    # check and no test at all; the whole suite is ci.yml's test job, which\n+    # carries the same flags. A gate command that names pytest again must\n+    # carry them too.\n+    if \"pytest\" in m[\"checks\"][\"command\"]:\n+        for flag in DESELECT_FLAGS:\n+            assert flag in m[\"checks\"][\"command\"], m[\"checks\"][\"command\"]\n \n \n def run_select_tests(stdin_text: str) -> list[str]:\n@@ -106,15 +112,15 @@ def test_select_tests_maps_bin_attavo_to_the_whole_suite() -> None:\n \n \n def test_select_tests_maps_an_adapter_path_to_the_adapter_tests() -> None:\n-    assert run_select_tests(\"adapters/example/run\\n\") == [\n-        \"tests/test_adapters.py\", \"tests/test_executor_conformance.py\",\n-    ]\n+    selected = run_select_tests(\"adapters/example/run\\n\")\n+    assert \"tests/test_adapters.py\" in selected and \"tests/test_executor_conformance.py\" in selected\n+    assert \"tests\" not in selected, \"an adapter path selected the whole suite\"\n \n \n def test_select_tests_maps_a_schema_path_to_the_record_and_attest_tests() -> None:\n-    assert run_select_tests(\"schema/records/build.schema.json\\n\") == [\n-        \"tests/test_record_schemas.py\", \"tests/test_attest.py\",\n-    ]\n+    selected = run_select_tests(\"schema/records/build.schema.json\\n\")\n+    assert \"tests/test_record_schemas.py\" in selected and \"tests/test_attest.py\" in selected\n+    assert \"tests\" not in selected, \"a schema path selected the whole suite\"\n \n \n def test_select_tests_maps_an_unrelated_path_to_nothing() -> None:\ndiff --git a/tests/test_testtool.py b/tests/test_testtool.py\nnew file mode 100644\nindex 0000000..4e34a6b\n--- /dev/null\n+++ b/tests/test_testtool.py\n@@ -0,0 +1,219 @@\n+\"\"\"The build's calibration (operator's rulings, 2026-09-20): a declared probe\n+in place of a whole run of the checks before the first build; one bounded\n+test command for the executor; a selector that fails safe. The specimen is\n+#194's build-01: 215 s of suite before the executor began, 241 s of it at\n+the gate, and a 590 s wait on a third run inside the executor, around 220 s\n+of work.\n+\n+Run: python3 -m pytest tests -q\n+\"\"\"\n+from __future__ import annotations\n+\n+import json\n+import subprocess\n+import sys\n+import time\n+from pathlib import Path\n+from typing import Any\n+\n+import jsonschema\n+\n+from helpers import commit_all, git, make_tenant\n+from test_drive import approve_item, record_files, run_attavo\n+\n+ROOT = Path(__file__).resolve().parent.parent\n+SELECT = ROOT / \".attavo\" / \"bin\" / \"select-tests\"\n+MANIFEST_SCHEMA = json.loads((ROOT / \"schema\" / \"manifest.schema.json\").read_text())\n+\n+\n+def tenant(tmp_path: Path, checks: str = \"\", tests: str = \"\") -> Path:\n+    root = make_tenant(tmp_path, \"build_valid\")\n+    toml = root / \"attavo.toml\"\n+    text = toml.read_text()\n+    if tests:\n+        text = text.replace('[tests]\\nselect = \"cat\"\\nrun = \"true\"', tests)\n+    toml.write_text(text + (\"\\n\" + checks + \"\\n\" if checks else \"\"))\n+    commit_all(root, \"configure\")\n+    git(root, \"checkout\", \"-q\", \"-b\", \"attavo/1-x\")\n+    return root\n+\n+\n+def events(root: Path) -> list[dict[str, Any]]:\n+    found = sorted(root.glob(\".git/**/build-01.events.jsonl\"))\n+    assert found, \"no events file for build-01\"\n+    return [json.loads(line) for line in found[-1].read_text().splitlines()]\n+\n+\n+def build_record(root: Path) -> dict[str, Any]:\n+    record: dict[str, Any] = json.loads(record_files(root, \"build\")[-1].read_text())\n+    return record\n+\n+\n+def test_build_runs_the_probe_and_not_the_whole_checks_before_the_executor(tmp_path: Path) -> None:\n+    root = tenant(tmp_path, checks='[checks]\\ncommand = \"echo ran >> checks-ran.txt\"\\n'\n+                                   'probe = \"echo probed >> probe-ran.txt\"\\nprobe_timeout_s = 30')\n+    (root / \".gitignore\").write_text(\"checks-ran.txt\\nprobe-ran.txt\\n\")\n+    commit_all(root, \"ignore the counters\")\n+    approve_item(root)\n+    assert run_attavo(root, \"build\", \"1\").returncode == 0\n+    assert (root / \"probe-ran.txt\").read_text().count(\"probed\") == 1\n+    assert (root / \"checks-ran.txt\").read_text().count(\"ran\") == 1, \"the checks ran before the build, not only at its gate\"\n+    texts = [e[\"text\"] for e in events(root) if e[\"kind\"] == \"gate\"]\n+    assert texts[0] == \"checking this machine can run the checks\", texts\n+    assert texts[1] == \"this machine can run the checks\", texts\n+\n+\n+def test_build_without_a_probe_asks_the_old_way_and_says_so_in_the_feed(tmp_path: Path) -> None:\n+    root = tenant(tmp_path, checks='[checks]\\ncommand = \"echo ran >> checks-ran.txt\"')\n+    (root / \".gitignore\").write_text(\"checks-ran.txt\\n\")\n+    commit_all(root, \"ignore the counter\")\n+    approve_item(root)\n+    assert run_attavo(root, \"build\", \"1\").returncode == 0\n+    assert (root / \"checks-ran.txt\").read_text().count(\"ran\") == 2\n+    assert [e[\"text\"] for e in events(root) if e[\"kind\"] == \"gate\"][0] == \"checking this machine can run the checks\"\n+\n+\n+def test_a_failing_probe_refuses_the_build_as_an_environment_stop_before_the_executor(tmp_path: Path) -> None:\n+    root = tenant(tmp_path, checks='[checks]\\ncommand = \"true\"\\nprobe = \"echo no pytest here; exit 3\"\\nprobe_timeout_s = 30')\n+    approve_item(root)\n+    assert run_attavo(root, \"build\", \"1\").returncode == 1\n+    record = build_record(root)\n+    assert (record[\"status\"], record[\"stop\"][\"class\"], record[\"stop\"][\"provenance\"]) == (\n+        \"refused\", \"environment\", \"tenant\"), record\n+    assert record[\"refusal\"] == \"[checks].probe exited 3 on the approved tree\", record[\"refusal\"]\n+    assert record[\"checks\"] == {\"command\": \"echo no pytest here; exit 3\", \"exit\": 3}, record[\"checks\"]\n+    assert \"no pytest here\" in record[\"stop\"][\"detail\"], record[\"stop\"]\n+    assert not (root / \"built.txt\").exists(), \"the executor ran\"\n+\n+\n+def test_a_probe_past_its_bound_is_ended_and_refuses_the_build(tmp_path: Path) -> None:\n+    root = tenant(tmp_path, checks='[checks]\\ncommand = \"true\"\\nprobe = \"sleep 30\"\\nprobe_timeout_s = 1')\n+    approve_item(root)\n+    started = time.monotonic()\n+    assert run_attavo(root, \"build\", \"1\").returncode == 1\n+    assert time.monotonic() - started < 15\n+    record = build_record(root)\n+    assert record[\"refusal\"] == \"[checks].probe did not finish within 1 s\", record[\"refusal\"]\n+    assert record[\"stop\"][\"class\"] == \"environment\", record[\"stop\"]\n+\n+\n+def test_the_manifest_schema_requires_a_bound_with_a_probe(tmp_path: Path) -> None:\n+    checks = MANIFEST_SCHEMA[\"properties\"][\"checks\"]\n+    jsonschema.validate({\"command\": \"true\", \"probe\": \"true\", \"probe_timeout_s\": 5}, checks)\n+    jsonschema.validate({\"command\": \"true\"}, checks)\n+    try:\n+        jsonschema.validate({\"command\": \"true\", \"probe\": \"true\"}, checks)\n+    except jsonschema.ValidationError:\n+        pass\n+    else:\n+        raise AssertionError(\"a probe with no bound validated\")\n+    jsonschema.validate({\"select\": \"cat\", \"run\": \"true\", \"call_timeout_s\": 240},\n+                        MANIFEST_SCHEMA[\"properties\"][\"tests\"])\n+\n+\n+SELECTING = ('[tests]\\nselect = \"sed -n \\'s#^src/\\\\\\\\(.*\\\\\\\\)[.]py$#tests/test_\\\\\\\\1.py#p\\'\"\\n'\n+             'run = \"sh -c \\'cat > selected.txt; cat selected.txt\\'\"')\n+\n+\n+def test_attavo_test_runs_what_the_tenant_selects_for_the_items_changes_committed_or_not(tmp_path: Path) -> None:\n+    root = tenant(tmp_path, tests=SELECTING)\n+    (root / \".gitignore\").write_text(\"selected.txt\\n\")\n+    (root / \"src\").mkdir()\n+    (root / \"src\" / \"committed.py\").write_text(\"x = 1\\n\")\n+    commit_all(root, \"a committed change\")\n+    (root / \"src\" / \"unstaged.py\").write_text(\"y = 2\\n\")\n+    (root / \"records\" / \"1\").mkdir(parents=True, exist_ok=True)\n+    (root / \"records\" / \"1\" / \"note.py\").write_text(\"\")\n+    run = run_attavo(root, \"test\", \"1\")\n+    assert run.returncode == 0, run.stdout + run.stderr\n+    assert (root / \"selected.txt\").read_text().split() == [\"tests/test_committed.py\", \"tests/test_unstaged.py\"]\n+    assert \"2 selected\" in run.stdout, run.stdout\n+\n+\n+def test_attavo_test_exits_as_the_run_does_and_says_when_nothing_is_selected(tmp_path: Path) -> None:\n+    failing = tenant(tmp_path, tests='[tests]\\nselect = \"cat\"\\nrun = \"sh -c \\'cat >/dev/null; exit 7\\'\"')\n+    (failing / \"anything.txt\").write_text(\"z\\n\")\n+    assert run_attavo(failing, \"test\", \"1\").returncode == 7\n+    quiet = tenant(tmp_path / \"quiet\", tests='[tests]\\nselect = \"true\"\\nrun = \"exit 9\"')\n+    (quiet / \"anything.txt\").write_text(\"z\\n\")\n+    run = run_attavo(quiet, \"test\", \"1\")\n+    assert run.returncode == 0 and \"no test is selected\" in run.stdout, run.stdout + run.stderr\n+\n+\n+def test_attavo_test_ends_a_run_past_its_bound_with_everything_it_started(tmp_path: Path) -> None:\n+    root = tenant(tmp_path, tests='[tests]\\nselect = \"cat\"\\ncall_timeout_s = 1\\n'\n+                                  'run = \"sh -c \\'cat >/dev/null; sleep 30 & echo $! > child.pid; wait\\'\"')\n+    (root / \".gitignore\").write_text(\"child.pid\\n\")\n+    (root / \"anything.txt\").write_text(\"z\\n\")\n+    started = time.monotonic()\n+    run = run_attavo(root, \"test\", \"1\")\n+    assert time.monotonic() - started < 15\n+    assert run.returncode == 124, run.stdout + run.stderr\n+    assert \"did not finish within 1 s\" in run.stdout, run.stdout\n+    child = int((root / \"child.pid\").read_text())\n+    time.sleep(0.5)\n+    # a process that was ended but not yet reaped still has a pid; its state says Z\n+    state = subprocess.run([\"ps\", \"-o\", \"stat=\", \"-p\", str(child)], capture_output=True, text=True,\n+                           check=False).stdout.strip()\n+    assert state == \"\" or state.startswith(\"Z\"), f\"the run's own child outlived the timeout (state {state!r})\"\n+\n+\n+def test_build_hands_the_executor_the_test_command_and_no_checks_command(tmp_path: Path) -> None:\n+    root = tenant(tmp_path, checks='[checks]\\ncommand = \"true\"', tests='[tests]\\nselect = \"cat\"\\nrun = \"true\"\\ncall_timeout_s = 240')\n+    (root / \"attavo\" / \"adapters\" / \"fixture\").mkdir(parents=True)\n+    probe = root / \"attavo\" / \"adapters\" / \"fixture\" / \"run\"\n+    probe.write_text('#!/bin/sh\\nenv | grep \"^ATTAVO_\" | sort > \"$PWD/seen-env.txt\"\\n'\n+                     'echo built > built.txt\\ngit add built.txt\\ngit commit -q -m built\\n'\n+                     'printf \\'{\"status\": \"done\", \"question\": null}\\\\n\\'\\n')\n+    probe.chmod(0o755)\n+    (root / \".gitignore\").write_text(\"seen-env.txt\\n\")\n+    commit_all(root, \"a tenant-side adapter that prints what it was given\")\n+    approve_item(root)\n+    run_attavo(root, \"build\", \"1\")\n+    seen = (root / \"seen-env.txt\").read_text()\n+    assert f\"ATTAVO_TEST_COMMAND=python3 {ROOT / 'bin' / 'attavo'} test 1\" in seen, seen\n+    assert \"ATTAVO_TEST_TIMEOUT_S=240\" in seen, seen\n+    assert \"ATTAVO_CHECKS_COMMAND\" not in seen, seen\n+\n+\n+def select(*paths: str) -> list[str]:\n+    run = subprocess.run([sys.executable, str(SELECT)], input=\"\".join(p + \"\\n\" for p in paths),\n+                         capture_output=True, text=True, check=True)\n+    return run.stdout.split()\n+\n+\n+def test_this_repositorys_selector_fails_safe_on_a_path_it_does_not_know() -> None:\n+    assert select(\"attavo/a_module_nobody_mapped.py\") == [\"tests\"]\n+    assert select(\"attavo/report.py\", \"attavo/a_module_nobody_mapped.py\") == [\"tests\"]\n+    assert select(\"scripts/anything.py\") == [\"tests\"]\n+    assert select(\"bin/attavo\") == [\"tests\"]\n+    assert select(\"attavo/common.py\") == [\"tests\"], \"a module every test stands on selects everything\"\n+\n+\n+def test_this_repositorys_selector_maps_a_module_to_its_own_tests_and_prose_to_nothing() -> None:\n+    assert select(\"attavo/report.py\") == [\"tests/test_report.py\"]\n+    assert select(\"tests/test_ledger.py\") == [\"tests/test_ledger.py\"]\n+    assert select(\"README.md\", \"attest/records/1/build-01.json\", \"attest/specs/9/spec.md\") == []\n+    assert \"tests/test_executor_conformance.py\" in select(\"adapters/codex/run\")\n+\n+\n+def test_every_test_file_the_selector_names_exists_and_every_module_is_mapped_or_falls_through() -> None:\n+    namespace: dict[str, Any] = {}\n+    exec(compile(SELECT.read_text(), str(SELECT), \"exec\"), {\"__name__\": \"selector\"}, namespace)\n+    named = {t for ts in namespace[\"MODULE_TESTS\"].values() for t in ts}\n+    named |= {t for _, ts in namespace[\"PREFIX_TESTS\"] for t in ts}\n+    missing = sorted(t for t in named if not (ROOT / t).is_file())\n+    assert not missing, f\"the selector names test files that do not exist: {missing}\"\n+    for module in sorted(p.relative_to(ROOT).as_posix() for p in (ROOT / \"attavo\").glob(\"*.py\")):\n+        assert select(module), f\"{module} selects nothing at all\"\n+\n+\n+def test_this_repositorys_manifest_declares_the_probe_a_gate_without_the_suite_and_a_bound() -> None:\n+    import tomllib\n+    m = tomllib.loads((ROOT / \"attavo.toml\").read_text())\n+    assert \"pytest tests\" not in m[\"checks\"][\"command\"], m[\"checks\"][\"command\"]\n+    assert \"mypy\" in m[\"checks\"][\"command\"], m[\"checks\"][\"command\"]\n+    assert m[\"checks\"][\"probe\"] and m[\"checks\"][\"probe_timeout_s\"] <= 120, m[\"checks\"]\n+    assert m[\"tests\"][\"call_timeout_s\"] <= 300, m[\"tests\"]\n+    jsonschema.validate(m[\"checks\"], MANIFEST_SCHEMA[\"properties\"][\"checks\"])\n+    jsonschema.validate(m[\"tests\"], MANIFEST_SCHEMA[\"properties\"][\"tests\"])\n","exit_code":0,"status":"completed"}}

d already closes the concrete risk\\n{\\n  \\\"dry_run_env\\\": \\\"ATTAVO_ADAPTER_DRY_RUN\\\",\\n  \\\"response_env\\\": \\\"ATTAVO_ADAPTER_RESPONSE_FILE\\\",\\n  \\\"tool_binary\\\": \\\"claude\\\",\\n  \\\"stages\\\": [\\\"build\\\", \\\"verify\\\", \\\"counsel\\\"],\\n  \\\"reports\\\": [\\\"tokens\\\", \\\"cost_usd\\\"],\\n  \\\"input_limit\\\": {\\n    \\\"unit\\\": null,\\n    \\\"value\\\": null,\\n    \\\"reason\\\": \\\"claude code documents no numeric input-size ceiling anywhere in its own surface (--help, docs, or any config file, confirmed against claude 2.1.269) -- this adapter asserts its own instruction stays under a fixed 64 KB bound instead\\\"\\n  },\\n  \\\"success_script\\\": \\\"#!/bin/sh\\\\ngit commit -q --allow-empty -m 'adapter commit'\\\\nprintf '{\\\\\\\"type\\\\\\\": \\\\\\\"result\\\\\\\", \\\\\\\"is_error\\\\\\\": false, \\\\\\\"structured_output\\\\\\\": {\\\\\\\"status\\\\\\\": \\\\\\\"done\\\\\\\", \\\\\\\"question\\\\\\\": null}, \\\\\\\"usage\\\\\\\": {\\\\\\\"input_tokens\\\\\\\": 1, \\\\\\\"output_tokens\\\\\\\": 1}, \\\\\\\"modelUsage\\\\\\\": {\\\\\\\"claude-sonnet-5\\\\\\\": {\\\\\\\"inputTokens\\\\\\\": 1, \\\\\\\"outputTokens\\\\\\\": 1}}}\\\\\\\\n'\\\\n\\\",\\n  \\\"subagent_guard\\\": {\\n    \\\"supported\\\": true,\\n    \\\"situation\\\": \\\"subagent_spawned\\\",\\n    \\\"note\\\": \\\"issue #88, class B -- checked against the tool's own subagent_stats.spawned, named in --disallowedTools by 'Agent' and 'Workflow' (confirmed live, claude 2.1.269, see adapters/claude-code/run's own docstring)\\\"\\n  },\\n  \\\"situations\\\": {\\n    \\\"done\\\": {\\n      \\\"is_error\\\": false,\\n      \\\"structured_output\\\": {\\\"status\\\": \\\"done\\\", \\\"question\\\": null},\\n      \\\"usage\\\": {\\\"input_tokens\\\": 5, \\\"output_tokens\\\": 9},\\n      \\\"total_cost_usd\\\": 0.01,\\n      \\\"modelUsage\\\": {\\\"claude-sonnet-5\\\": {\\\"inputTokens\\\": 5, \\\"outputTokens\\\": 9}}\\n    },\\n    \\\"is_error\\\":
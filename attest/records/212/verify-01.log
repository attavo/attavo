y] | None = None,\\n    must not tell the executor to run the check itself. Regression:\\n    build-10 on tenant zero, where \\\"must exit 0 before you commit\\\" made\\n    the executor the runner (146 and 123 turns, 72 of 83 executor\\n    minutes waiting on tools) of a check attavo build already runs after\\n    every commit.\\n\\n    The command's mere presence in the instruction (with it, and its\\n    absence without it) is now tests/test_executor_conformance.py's\\n    situation 7 -- general across any adapter. What stays here is the\\n    part that is an assertion about English and does not transfer.\\n    \\\"\\\"\\\"\\n    with_tool = dry_run(tmp_path, extra_env={\\n        \\\"ATTAVO_TEST_COMMAND\\\": \\\"python3 /product/bin/attavo test 7\\\"})\\n    instruction = with_tool[with_tool.index(\\\"-p\\\") + 1]\\n    assert \\\"are run for you\\\" in instruction\\n    assert \\\"before you commit\\\" not in instruction\\n    assert \\\"Do not run the whole test suite\\\" in instruction\\n\\n    without_tool = dry_run(tmp_path)\\n    instruction_without = without_tool[without_tool.index(\\\"-p\\\") + 1]\\n    assert \\\"are run for you\\\" not in instruction_without\\n\\n\\ndef test_claude_code_adapter_derives_model_from_usage_breakdown(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"The real response shape: no top-level \\\"model\\\", one modelUsage key.\\\"\\\"\\\"\\n    response = {\\n        \\\"is_error\\\": False,\\n        \\\"structured_output\\\": {\\\"status\\\": \\\"done\\\", \\\"question\\\": None},\\nfrom typing import Any, cast\\n\\nimport pytest\\n\\nfrom helpers import FIXTURES\\n\\nROOT = Path(__file__).resolve().parent.parent\\nCODEX_RUN = ROOT / \\\"adapters\\\" / \\\"codex\\\" / \\\"run\\\"\\n\\n\\ndef base_env(tmp_path: Path, config: dict[str, Any] | None = None) -> dict[str, Any]:\\n    spec_dir = FIXTURES / \\\"build_valid\\\" / \\\"specs\\\" / \\\"1\\\"\\n    env = dict(os.environ)\\n    env.pop(\\\"ATTAVO_CHECKS_COMMAND\\\", None)\\n    env.pop(\\\"OPENAI_API_KEY\\\", None)\\n    env.update({\\n        \\\"ATTAVO_SPEC_DIR\\\": str(spec_dir),\\n        \\\"ATTAVO_RECORDS_DIR\\\": str(tmp_path / \\\"records\\\"),\\n        \\\"ATTAVO_RULINGS\\\": str(tmp_path / \\\"rulings.md\\\"),\\n        \\\"ATTAVO_BRANCH\\\": \\\"attavo/1-example\\\",\\n        \\\"ATTAVO_ITERATION\\\": \\\"1\\\",\\n        \\\"ATTAVO_FEEDBACK\\\": str(tmp_path / \\\"feedback.txt\\\"),\\n        \\\"ATTAVO_ADAPTER_CONFIG\\\": json.dumps(config if config is not None else {\\\"model\\\": \\\"gpt-test\\\"}),\\n    })\\n    return env\\n\\n\\ndef run_codex(env: dict[str, Any]) -> subprocess.CompletedProcess[str]:\\n    return subprocess.run([str(CODEX_RUN)], capture_output=True, text=True,\\n                          check=False, env=env)\",\"is_error\":false}]},\"parent_tool_use_id\":null,\"session_id\":\"8327c9db-455b-4a76-8736-ba592c30dfef\",\"uuid\":\"84c03c6b-a83d-488f-b2cb-f6daba2c4f83\",\"timestamp\":\"2026-09-21T01:42:51.181Z\",\"tool_use_result\":{\"stdout\":\"adapters/codex/conformance.json:90:          \\\"ruling_text\\\": \\\"verify-02 read forge-unconcluded because the checks command found no conclusions for 7a2529ee349547a259dbd8b0b78043b39bbf63c2 at that moment, but the checks handed to counsel now show doctor and test both concluded failure on that same sha, and the doctor job's own log names proof 5 no-invocation-lacks-record: item 158 verify-02 started on Davids-MacBook-Pro.local and never wrote its record -- invocation_alive found no live process for the marker commit. Re-running verification will not help: the fix belongs in invocation_alive, not the forge.\\\",\\nadapters/claude-code/conformance.json:89:          \\\"ruling_text\\\": \\\"verify-02 read forge-unconcluded because the checks command found no conclusions for 7a2529ee349547a259dbd8b0b78043b39bbf63c2 at that moment, but the checks handed to counsel now show doctor and test both concluded failure on that same sha, and the doctor job's own log names proof 
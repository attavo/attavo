for t in ts}\\n    named |= {t for _, ts in namespace[\\\"PREFIX_TESTS\\\"] for t in ts}\\n    missing = sorted(t for t in named if not (ROOT / t).is_file())\\n    assert not missing, f\\\"the selector names test files that do not exist: {missing}\\\"\\n    for module in sorted(p.relative_to(ROOT).as_posix() for p in (ROOT / \\\"attavo\\\").glob(\\\"*.py\\\")):\\n        assert select(module), f\\\"{module} selects nothing at all\\\"\\n\\n\\ndef test_this_repositorys_manifest_declares_the_probe_a_gate_without_the_suite_and_a_bound() -> None:\\n    import tomllib\\n    m = tomllib.loads((ROOT / \\\"attavo.toml\\\").read_text())\\n    assert \\\"pytest tests\\\" not in m[\\\"checks\\\"][\\\"command\\\"], m[\\\"checks\\\"][\\\"command\\\"]\\n    assert \\\"mypy\\\" in m[\\\"checks\\\"][\\\"command\\\"], m[\\\"checks\\\"][\\\"command\\\"]\\n    assert m[\\\"checks\\\"][\\\"probe\\\"] and m[\\\"checks\\\"][\\\"probe_timeout_s\\\"] <= 120, m[\\\"checks\\\"]\\n    assert m[\\\"tests\\\"][\\\"call_timeout_s\\\"] <= 300, m[\\\"tests\\\"]\\n    jsonschema.validate(m[\\\"checks\\\"], MANIFEST_SCHEMA[\\\"properties\\\"][\\\"checks\\\"])\\n    jsonschema.validate(m[\\\"tests\\\"], MANIFEST_SCHEMA[\\\"properties\\\"][\\\"tests\\\"])\\n=== attest/specs/212/criteria/attavo-test-runs-the-selected-tests-inside-a-bound.sh\\n#!/bin/sh\\nset -e\\nhere=$(pwd)\\ntmp=$(mktemp -d \\\"${TMPDIR:-/tmp}/attavo.XXXXXX\\\")\\ncp -R \\\"$here/tests/fixtures/build_valid/.\\\" \\\"$tmp/tenant\\\"\\ncd \\\"$tmp/tenant\\\"\\ngit init -q -b main .\\ngit config user.email fixture@attavo.invalid\\ngit config user.name \\\"fixture\\\"\\nA=\\\"python3 $here/bin/attavo\\\"\\ninstall() {\\n  git add -A\\n  git commit -q -m install\\n  git update-ref refs/remotes/origin/main \\\"$(git rev-parse HEAD)\\\"\\n  git symbolic-ref refs/remotes/origin/HEAD refs/remotes/origin/main\\n  git checkout -q -b attavo/1-x\\n}\\npython3 - <<'PY'\\np = \\\"attavo.toml\\\"\\nt = open(p).read().replace('[tests]\\\\nselect = \\\"cat\\\"\\\\nrun = \\\"true\\\"',\\n    '[tests]\\\\nselect = \\\"grep ^src/\\\"\\\\ncall_timeout_s = 2\\\\nrun = \\\"sh -c \\\\'cat > selected.txt; if grep -q slow selected.txt; then sleep 30; fi; if grep -q bad selected.txt; then exit 7; fi\\\\'\\\"')\\nopen(p, \\\"w\\\").write(t)\\nPY\\nprintf 'selected.txt\\\\n' > .gitignore\\ninstall\\nmkdir src\\nprintf 'x\\\\n' > src/good.py\\ngit add -A\\ngit commit -q -m \\\"a change\\\"\\n$A test 1 >/dev/null\\ntest \\\"$(cat selected.txt)\\\" = \\\"src/good.py\\\"\\nprintf 'x\\\\n' > src/bad.py\\ngit add -A\\ngit commit -q -m \\\"a change whose tests fail\\\"\\ncode=0\\n$A test 1 >/dev/null || code=$?\\ntest \\\"$code\\\" = 7\\ngit rm -q src/bad.py\\nprintf 'x\\\\n' > src/slow.py\\ngit add -A\\ngit commit -q -m \\\"a change whose tests never end\\\"\\nstarted=$(date +%s)\\ncode=0\\n$A test 1 >/dev/null || code=$?\\ntest \\\"$code\\\" = 124\\ntest $(( $(date +%s) - started )) -lt 20\\ncd \\\"$here\\\"\\nrm -rf \\\"$tmp\\\"\\n=== attest/specs/212/criteria/build-asks-the-probe-and-not-the-whole-checks.sh\\n#!/bin/sh\\nset -e\\nhere=$(pwd)\\ntmp=$(mktemp -d \\\"${TMPDIR:-/tmp}/attavo.XXXXXX\\\")\\ncp -R \\\"$here/tests/fixtures/build_valid/.\\\" \\\"$tmp/tenant\\\"\\ncd \\\"$tmp/tenant\\\"\\ngit init -q -b main .\\ngit config user.email fixture@attavo.invalid\\ngit config user.name \\\"fixture\\\"\\nA=\\\"python3 $here/bin/attavo\\\"\\ninstall() {\\n  git add -A\\n  git commit -q -m install\\n  git update-ref refs/remotes/origin/main \\\"$(git rev-parse HEAD)\\\"\\n  git symbolic-ref refs/remotes/origin/HEAD refs/remotes/origin/main\\n  git checkout -q -b attavo/1-x\\n}\\nprintf 'checks-ran.txt\\\\nprobe-ran.txt\\\\n' > .gitignore\\nprintf '\\\\n[checks]\\\\ncommand = \\\"echo ran >> checks-ran.txt\\\"\\\\nprobe = \\\"echo probed >> probe-ran.txt\\\"\\\\nprobe_timeout_s = 30\\\\n' >> attavo.toml\\ninstall\\n$A spec-gate 1 >/dev/null\\n$A approve 1 --by alice >/dev/null\\n$A build 1 >/dev/null\\ntest \\\"$(grep -c probed probe-ran.txt)\\\" = 1\\ntest \\\"$(grep -c ran checks-ran.txt)\\\" = 1\\ncd \\\"$here\\\"\\nrm -rf \\\"$tmp\\\"\\ntmp=$(mktemp -d \\\"${TMPDIR:-/tmp}/attavo.XXXXXX\\\")\\ncp -R \\\"$here/tests/fixtures/build_valid/.\\\" \\\"$tmp/tenant\\\"\\ncd \\\"$tmp/tenant\\\"\\ngit init -q -b main .\\ngit config user.email fixture@attavo.invalid\\ngit config user.name \\\"fixture\\\"\\nprintf '\\\\n[checks]\\\\ncommand = \\\"true\\\"\\\\nprobe = \\\"exit 3\\\"\\\\nprobe_timeout_s = 30\\\\n' >> attavo.toml\\ninstall\\n$A spec-gate 1 >/dev/null\\n$A approve 1 --by alice >/dev/null\\nif $A build 1 >/dev/null; then exit 1; fi\\ntest ! -e built.txt\\npython3 - <<'PY'\\nimport json\\nr = json.load(open(\\\"records/1/build-01.json\\\"))\\nassert r[\\\"status\\\"] == \\\"refused\\\" and r[\\\"stop\\\"][\\\"class\\\"] == \\\"environment\\\", r\\nPY\\ncd \\\"$here\\\"\\nrm -rf \\\"$tmp\\\"\\n=== attest/specs/212/criteria/the-executor-is-given-one-test-command.sh\\n#!/bin/sh\\nset -e\\n! grep -q 'ATTAVO_CHECKS_COMMAND' attavo/build.py adapters/claude-code/run adapters/codex/run\\ngrep -q 'ATTAVO_TEST_COMMAND' attavo/build.py\\ngrep -q 'ATTAVO_TEST_COMMAND' adapters/claude-code/run\\ngrep -q 'ATTAVO_TEST_COMMAND' adapters/codex/run\\npython3 - <<'PY'\\nimport json\\ns = json.load(open(\\\"schema/manifest.schema.json\\\"))[\\\"properties\\\"]\\nassert \\\"probe\\\" in s[\\\"checks\\\"][\\\"properties\\\"] and s[\\\"checks\\\"][\\\"dependentRequired\\\"] == {\\\"probe\\\": [\\\"probe_timeout_s\\\"]}, s[\\\"checks\\\"]\\nassert \\\"call_timeout_s\\\" in s[\\\"tests\\\"][\\\"properties\\\"], s[\\\"tests\\\"]\\nPY\\nfor t in test_build_runs_the_probe_and_not_the_whole_checks_before_the_executor test_build_without_a_probe_asks_the_old_way_and_says_so_in_the_feed test_a_failing_probe_refuses_the_build_as_an_environment_stop_before_the_executor test_a_probe_past_its_bound_is_ended_and_refuses_the_build test_the_manifest_schema_requires_a_bound_with_a_probe test_attavo_test_runs_what_the_tenant_selects_for_the_items_changes_committed_or_not test_attavo_test_exits_as_the_run_does_and_says_when_nothing_is_selected test_attavo_test_ends_a_run_past_its_bound_with_everything_it_started test_build_hands_the_executor_the_test_command_and_no_checks_command test_this_repositorys_selector_fails_safe_on_a_path_it_does_not_know test_this_repositorys_selector_maps_a_module_to_its_own_tests_and_prose_to_nothing test_every_test_file_the_selector_names_exists_and_every_module_is_mapped_or_falls_through test_this_repositorys_manifest_declares_the_probe_a_gate_without_the_suite_and_a_bound\\ndo\\n  grep -q \\\"^def $t(\\\" tests/test_testtool.py\\ndone\\ngrep -q '^def test_situation_7_the_one_test_command_in_the_invocation(' tests/test_executor_conformance.py\\n=== attest/specs/212/criteria/the-selector-fails-safe-and-the-gate-drops-the-suite.sh\\n#!/bin/sh\\nset -e\\nS=\\\"python3 .attavo/bin/select-tests\\\"\\ntest \\\"$(printf 'attavo/a_module_nobody_mapped.py\\\\n' | $S)\\\" = \\\"tests\\\"\\ntest \\\"$(printf 'attavo/report.py\\\\n' | $S)\\\" = \\\"tests/test_report.py\\\"\\ntest -z \\\"$(printf 'README.md\\\\nattest/records/1/build-01.json\\\\n' | $S)\\\"\\npython3 - <<'PY'\\nimport tomllib\\nm = tomllib.load(open(\\\"attavo.toml\\\", \\\"rb\\\"))\\nassert \\\"pytest tests\\\" not in m[\\\"checks\\\"][\\\"command\\\"] and \\\"mypy\\\" in m[\\\"checks\\\"][\\\"command\\\"], m[\\\"checks\\\"]\\nassert m[\\\"checks\\\"][\\\"probe\\\"] and isinstance(m[\\\"checks\\\"][\\\"probe_timeout_s\\\"], int), m[\\\"checks\\\"]\\nassert isinstance(m[\\\"tests\\\"][\\\"call_timeout_s\\\"], int), m[\\\"tests\\\"]\\nPY\",\"stderr\":\"\",\"interrupted\":false,\"isImage\":false,\"noOutputExpected\":false}}\n32:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01GayViWXzXao5ZxaqJqPk6H\",\"type\":\"tool_result\",\"content\":\" M .attavo/bin/select-tests\\n M adapters/claude-code/run\\n M adapters/codex/run\\n M attavo.toml\\n M attavo/build.py\\n M attavo/cli.py\\n M schema/manifest.schema.json\\n M tests/test_adapters.py\\n M tests/test_executor_conformance.py\\n M tests/test_self_tenancy.py\\n?? attavo/testtool.py\\n?? tests/test_testtool.py\\nfrom __future__ import annotations\\n\\nimport fnmatch\\nimport json\\nimport os\\nimport subprocess\\nimport sys\\nimport tempfile\\nimport time\\nfrom pathlib import Path\\nfrom typing import Any\\n\\nfrom attavo.approval import approval_status\\nfrom attavo.common import (\\n    MANIFEST,\\n    PRODUCT_ROOT,\\n    ShallowCheckoutError,\\n    derive_item_id,\\n    git,\\n    last_commit_touching,\\n    now_iso,\\n    read_manifest,\\n)\\nfrom attavo.events import append_event, stage_events_dir\\nfrom attavo.records import latest_record, next_attempt_number, write_record\\nfrom attavo.spec import parse_spec, run_criterion\\nfrom attavo.stops import _log_last_line, derive_stop\\n\\n# --- build: adapter, claims boundary, criteria, and the tenant's tests ---\\n\\nSTAGE_NAMES = (\\\"build\\\", \\\"verify\\\", \\\"counsel\\\")\\n\\n\\ndef merge_adapter_config(m: dict[str, Any], adapter_name: str, stage: str) -> dict[str, Any]:\\n    \\\"\\\"\\\"[executor.<adapter>] merged with [executor.<adapter>.<stage>], the\\n    stage table shadowing the parent for that stage only. Both build and\\n    verify call this before setting ATTAVO_ADAPTER_CONFIG, and the\\n    record's adapter_config is the merged result.\\\"\\\"\\\"\\n    parent = (m.get(\\\"executor\\\") or {}).get(adapter_name) or {}\\n    if not isinstance(parent, dict):\\n        return {}\\n    merged = {k: v for k, v in parent.items() if k not in STAGE_NAMES}\\n    stage_table = parent.get(stage)\\n    if isinstance(stage_table, dict):\\n        merged.update(stage_table)\\n    return merged\\n\\n\\ndef resolve_adapter(root: Path, name: str) -> Path | None:\\n    \\\"\\\"\\\"adapters/<name>/run, resolved first under the tenant's own\\n    attavo/adapters/, then under this product's adapters/.\\\"\\\"\\\"\\n    for base in (root / \\\"attavo\\\" / \\\"adapters\\\", PRODUCT_ROOT / \\\"adapters\\\"):\\n        candidate = base / name / \\\"run\\\"\\n        if candidate.is_file():\\n            return candidate\\n    return None\\n\\n\\ndef adapter_reports(adapter_path: Path) -> list[str]:\\n    \\\"\\\"\\\"Field names adapters/<name>/conformance.json declares this adapter\\n    can supply with a real value -- vendor independence (2026-09-09\\n    ruling): the record carries the declaration, so an adapter claiming\\n    a field and returning null for it fails the conformance suite\\n    instead of writing a silent, uncomparable null. [] when the\\n    resolved adapter (a tenant override included) declares no\\n    conformance.json at all -- an absent declaration, not a refusal.\\\"\\\"\\\"\\n    manifest_path = adapter_path.parent / \\\"conformance.json\\\"\\n    if not manifest_path.is_file():\\n        return []\\n    try:\\n        manifest = json.loads(manifest_path.read_text())\\n    except json.JSONDecodeError:\\n        return []\\n    reports: list[str] = manifest.get(\\\"reports\\\", [])\\n    return reports\\n\\n\\ndef changed_paths(root: Path, start_sha: str, records_rel: str) -> list[str]:\\n    \\\"\\\"\\\"Paths changed between start_sha and HEAD, other than paths.records --\\n    the records directory is where build itself writes, not a claim.\\\"\\\"\\\"\\n    out = git(root, \\\"diff\\\", \\\"--name-only\\\", start_sha, \\\"HEAD\\\").splitlines()\\n    prefix = records_rel.rstrip(\\\"/\\\") + \\\"/\\\"\\n    return [p for p in out if p and p != records_rel and not p.startswith(prefix)]\\n\\n\\ndef matches_a_claim(path: str, claims: list[str]) -> bool:\\n    return any(fnmatch.fnmatch(path, pattern) for pattern in claims)\\n\\n\\ndef protected_path_touched(root: Path, start_sha: str, records_rel: str,\\n                           specs_rel: str) -> str | None:\\n    \\\"\\\"\\\"The first path an executor's own commits touched under\\n    paths.records or paths.specs since start_sha, or None (issue #140).\\n    Neither directory is a claim a spec can make -- paths.records is\\n    where the product itself writes, paths.specs is the definition of\\n    done -- yet changed_paths above excludes paths.records from the\\n    ordinary claims check entirely, so a path there never even reached\\n    matches_a_claim to be refused: tenant zero's own item #688 committed\\n    its own events file this way, under its records directory, on a\\n    build that then passed. Checked directly against the raw diff, not\\n    changed_paths's already-filtered list.\\\"\\\"\\\"\\n    touched = git(root, \\\"diff\\\", \\\"--name-only\\\", start_sha, \\\"HEAD\\\").splitlines()\\n    protected = []\\n    for rel in (records_rel, specs_rel):\\n        stripped = rel.rstrip(\\\"/\\\")\\n        protected.append((stripped, stripped + \\\"/\\\"))\\n    for p in touched:\\n        if not p:\\n            continue\\n        for exact, prefix in protected:\\n            if p == exact or p.startswith(prefix):\\n                return p\\n    return None\\n\\n\\ndef executor_identity(adapter_name: str) -> dict[str, Any]:\\n    \\\"\\\"\\\"The executor's identity (issue #33): set by the product, never the\\n    tenant's git config, so an executor commit is never indistinguishable\\n    from an operator's own -- the specimen is attavo/code-factory@e22fa85.\\n    A reserved, undeliverable domain (.invalid) so no mailbox is implied.\\n    Distinct from the records app identity: the app says the product\\n    pushed this, this says an invocation authored this -- different\\n    facts, neither borrows the other's name.\\\"\\\"\\\"\\n    return {\\\"name\\\": f\\\"attavo executor ({adapter_name})\\\",\\n            \\\"email\\\": f\\\"executor+{adapter_name}@attavo.invalid\\\"}\\n\\n\\ndef driver_identity() -> dict[str, Any]:\\n    \\\"\\\"\\\"The driver's identity: set by the product, never the tenant's git\\n    config, so a driver's own transport commit -- a record commit\\n    `commit_record` makes on the driver's behalf -- is never\\n    indistinguishable from an operator's own; `git log --author='attavo\\n    driver'` on a driven item lists exactly those commits. Distinct from\\n    executor_identity: that names an adapter invocation's own commits,\\n    this names the transport that carries a stage's record.\\\"\\\"\\\"\\n    return {\\\"name\\\": \\\"attavo driver\\\", \\\"email\\\": \\\"driver@attavo.invalid\\\"}\\n\\n\\ndef commits_since(root: Path, start_sha: str, end: str = \\\"HEAD\\\") -> list[dict[str, Any]]:\\n    \\\"\\\"\\\"(sha, name, email) for every commit after start_sha up to and\",\"is_error\":false}]},\"parent_tool_use_id\":null,\"session_id\":\"8327c9db-455b-4a76-8736-ba592c30dfef\",\"uuid\":\"99cdff4d-6312-49ce-b25f-32b447c47c50\",\"timestamp\":\"2026-09-21T01:41:49.498Z\",\"tool_use_result\":{\"stdout\":\" M .attavo/bin/select-tests\\n M adapters/claude-code/run\\n M adapters/codex/run\\n M attavo.toml\\n M attavo/build.py\\n M attavo/cli.py\\n M schema/manifest.schema.json\\n M tests/test_adapters.py\\n M tests/test_executor_conformance.py\\n M tests/test_self_tenancy.py\\n?? attavo/testtool.py\\n?? tests/test_testtool.py\\nfrom __future__ import annotations\\n\\nimport fnmatch\\nimport json\\nimport os\\nimport subprocess\\nimport sys\\nimport tempfile\\nimport time\\nfrom pathlib import Path\\nfrom typing import Any\\n\\nfrom attavo.approval import approval_status\\nfrom attavo.common import (\\n    MANIFEST,\\n    PRODUCT_ROOT,\\n    ShallowCheckoutError,\\n    derive_item_id,\\n    git,\\n    last_commit_touching,\\n    now_iso,\\n    read_manifest,\\n)\\nfrom attavo.events import append_event, stage_events_dir\\nfrom attavo.records import latest_record, next_attempt_number, write_record\\nfrom attavo.spec import parse_spec, run_criterion\\nfrom attavo.stops import _log_last_line, derive_stop\\n\\n# --- build: adapter, claims boundary, criteria, and the tenant's tests ---\\n\\nSTAGE_NAMES = (\\\"build\\\", \\\"verify\\\", \\\"counsel\\\")\\n\\n\\ndef merge_adapter_config(m: dict[str, Any], adapter_name: str, stage: str) -> dict[str, Any]:\\n    \\\"\\\"\\\"[executor.<adapter>] merged with [executor.<adapter>.<stage>], the\\n    stage table shadowing the parent for that stage only. Both build and\\n    verify call this before setting ATTAVO_ADAPTER_CONFIG, and the\\n    record's adapter_config is the merged result.\\\"\\\"\\\"\\n    parent = (m.get(\\\"executor\\\") or {}).get(adapter_name) or {}\\n    if not isinstance(parent, dict):\\n        return {}\\n    merged = {k: v for k, v in parent.items() if k not in STAGE_NAMES}\\n    stage_table = parent.get(stage)\\n    if isinstance(stage_table, dict):\\n        merged.update(stage_table)\\n    return merged\\n\\n\\ndef resolve_adapter(root: Path, name: str) -> Path | None:\\n    \\\"\\\"\\\"adapters/<name>/run, resolved first under the tenant's own\\n    attavo/adapters/, then under this product's adapters/.\\\"\\\"\\\"\\n    for base in (root / \\\"attavo\\\" / \\\"adapters\\\", PRODUCT_ROOT / \\\"adapters\\\"):\\n        candidate = base / name / \\\"run\\\"\\n        if candidate.is_file():\\n            return candidate\\n    return None\\n\\n\\ndef adapter_reports(adapter_path: Path) -> list[str]:\\n    \\\"\\\"\\\"Field names adapters/<name>/conformance.json declares this adapter\\n    can supply with a real value -- vendor independence (2026-09-09\\n    ruling): the record carries the declaration, so an adapter claiming\\n    a field and returning null for it fails the conformance suite\\n    instead of writing a silent, uncomparable null. [] when the\\n    resolved adapter (a tenant override included) declares no\\n    conformance.json at all -- an absent declaration, not a refusal.\\\"\\\"\\\"\\n    manifest_path = adapter_path.parent / \\\"conformance.json\\\"\\n    if not manifest_path.is_file():\\n        return []\\n    try:\\n        manifest = json.loads(manifest_path.read_text())\\n    except json.JSONDecodeError:\\n        return []\\n    reports: list[str] = manifest.get(\\\"reports\\\", [])\\n    return reports\\n\\n\\ndef changed_paths(root: Path, start_sha: str, records_rel: str) -> list[str]:\\n    \\\"\\\"\\\"Paths changed between start_sha and HEAD, other than paths.records --\\n    the records directory is where build itself writes, not a claim.\\\"\\\"\\\"\\n    out = git(root, \\\"diff\\\", \\\"--name-only\\\", start_sha, \\\"HEAD\\\").splitlines()\\n    prefix = records_rel.rstrip(\\\"/\\\") + \\\"/\\\"\\n    return [p for p in out if p and p != records_rel and not p.startswith(prefix)]\\n\\n\\ndef matches_a_claim(path: str, claims: list[str]) -> bool:\\n    return any(fnmatch.fnmatch(path, pattern) for pattern in claims)\\n\\n\\ndef protected_path_touched(root: Path, start_sha: str, records_rel: str,\\n                           specs_rel: str) -> str | None:\\n    \\\"\\\"\\\"The first path an executor's own commits touched under\\n    paths.records or paths.specs since start_sha, or None (issue #140).\\n    Neither directory is a claim a spec can make -- paths.records is\\n    where the product itself writes, paths.specs is the definition of\\n    done -- yet changed_paths above excludes paths.records from the\\n    ordinary claims check entirely, so a path there never even reached\\n    matches_a_claim to be refused: tenant zero's own item #688 committed\\n    its own events file this way, under its records directory, on a\\n    build that then passed. Checked directly against the raw diff, not\\n    changed_paths's already-filtered list.\\\"\\\"\\\"\\n    touched = git(root, \\\"diff\\\", \\\"--name-only\\\", start_sha, \\\"HEAD\\\").splitlines()\\n    protected = []\\n    for rel in (records_rel, specs_rel):\\n        stripped = rel.rstrip(\\\"/\\\")\\n        protected.append((stripped, stripped + \\\"/\\\"))\\n    for p in touched:\\n        if not p:\\n            continue\\n        for exact, prefix in protected:\\n            if p == exact or p.startswith(prefix):\\n                return p\\n    return None\\n\\n\\ndef executor_identity(adapter_name: str) -> dict[str, Any]:\\n    \\\"\\\"\\\"The executor's identity (issue #33): set by the product, never the\\n    tenant's git config, so an executor commit is never indistinguishable\\n    from an operator's own -- the specimen is attavo/code-factory@e22fa85.\\n    A reserved, undeliverable domain (.invalid) so no mailbox is implied.\\n    Distinct from the records app identity: the app says the product\\n    pushed this, this says an invocation authored this -- different\\n    facts, neither borrows the other's name.\\\"\\\"\\\"\\n    return {\\\"name\\\": f\\\"attavo executor ({adapter_name})\\\",\\n            \\\"email\\\": f\\\"executor+{adapter_name}@attavo.invalid\\\"}\\n\\n\\ndef driver_identity() -> dict[str, Any]:\\n    \\\"\\\"\\\"The driver's identity: set by the product, never the tenant's git\\n    config, so a driver's own transport commit -- a record commit\\n    `commit_record` makes on the driver's behalf -- is never\\n    indistinguishable from an operator's own; `git log --author='attavo\\n    driver'` on a driven item lists exactly those commits. Distinct from\\n    executor_identity: that names an adapter invocation's own commits,\\n    this names the transport that carries a stage's record.\\\"\\\"\\\"\\n    return {\\\"name\\\": \\\"attavo driver\\\", \\\"email\\\": \\\"driver@attavo.invalid\\\"}\\n\\n\\ndef commits_since(root: Path, start_sha: str, end: str = \\\"HEAD\\\") -> list[dict[str, Any]]:\\n    \\\"\\\"\\\"(sha, name, email) for every commit after start_sha up to and\",\"stderr\":\"\",\"interrupted\":false,\"isImage\":false,\"noOutputExpected\":false}}\n75:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01JUUAKsX86DYpFsRXJdYBij\",\"type\":\"tool_result\",\"content\":\"\\\"\\\"\\\"attavo: the command.\\n\\n    attavo doctor [TENANT_ROOT] [--json]\\n    attavo spec-gate [N]\\n    attavo approve [N] --by LOGIN\\n    attavo approval-status [N]\\n    attavo build [N]\\n    attavo verify [N]\\n    attavo file-findings [N]\\n    attavo file-stops [N]\\n    attavo counsel [N]\\n    attavo record-only\\n    attavo attest [--partial] [N]\\n    attavo drive [N] [--until-ready | --report]\\n    attavo ledger [N] [--json]\\n    attavo stops [N] [--json]\\n\\nThe doctor is the definition of done. It asserts five proofs against a\\ntenant root and exits 1 until every proof holds:\\n\\n  1. every-gate-rejects      every gate in the manifest's [gates] table,\\n                             run against its rejection fixture, exits non-zero,\\n                             and carries a non-empty retires\\n  2. one-item-every-stage    one work item under paths.records carries a\\n                             record for every stage -- spec, approval,\\n                             build, verify -- all four introduced by one\\n                             merge commit reachable from HEAD\\n  3. no-commit-lacks-record  every commit on the default branch after the\\n                             manifest was introduced is named by a record's\\n                             sha or commits list, or itself writes under\\n                             paths.records (a record is committed with the\\n                             code it describes; an item's merge commit\\n                             carries its own record paths this way)\\n  4. no-stop-lacks-cause     every build or verify record under\\n                             paths.records at record_version 3 or later,\\n                             with a status other than pass, carries a stop\\n                             naming an enumerated class and provenance, a\\n                             non-empty detail when unclassed, the gates\\n                             heading when a build failed after running\\n                             them, and the tool's own error line when an\\n                             adapter exit ended the log -- records before\\n                             record_version 3 are counted and reported,\\n                             never refused\\n  5. every-attested-item-is-sealed\\n                             every merged item that carries a record for\\n                             every stage has a statement in the forge's\\n                             attestation store for its merge commit, read\\n                             through [forge].attestation_command -- a\\n                             merge at or before [forge].sealed_since is\\n                             named as before the window instead of failed.\\n\\\"\\\"\\\"bin/attavo --help and its unknown-subcommand message name every\\nsubcommand that exists, and the product itself names no vendor. Issue\\n#54, acceptance 10 and 11.\\n\\nRun: python3 -m pytest tests -q\\n\\\"\\\"\\\"\\nimport subprocess\\nimport sys\\nfrom pathlib import Path\\n\\nROOT = Path(__file__).resolve().parent.parent\\nATTAVO = ROOT / \\\"bin\\\" / \\\"attavo\\\"\\n\\n\\ndef test_help_lists_attest_and_record_only() -> None:\\n    run = subprocess.run([sys.executable, str(ATTAVO), \\\"--help\\\"],\\n                         capture_output=True, text=True, check=False)\\n    assert run.returncode == 0\\n    assert \\\"attavo record-only\\\" in run.stdout\\n    assert \\\"attavo attest\\\" in run.stdout\\n\\n\\ndef test_help_names_all_four_doctor_proofs() -> None:\\n    \\\"\\\"\\\"Issue #94, acceptance row 5: the doctor's own help text names all\\n    four proofs, no-stop-lacks-cause included -- a proof the help text\\n    forgets is one a reader would never know to expect from doctor: done.\\\"\\\"\\\"\\n    run = subprocess.run([sys.executable, str(ATTAVO), \\\"--help\\\"],\\n                         capture_output=True, text=True, check=False)\\n    assert run.returncode == 0\\n    assert \\\"every-gate-rejects\\\" in run.stdout\\n    assert \\\"one-item-every-stage\\\" in run.stdout\\n    assert \\\"no-commit-lacks-record\\\" in run.stdout\\n    assert \\\"no-stop-lacks-cause\\\" in run.stdout\\n\\n\\ndef test_help_names_the_drive_report_and_the_states_it_prints() -> None:\\n    run = subprocess.run([sys.executable, str(ATTAVO), \\\"--help\\\"],\\n                         capture_output=True, text=True, check=False)\\n    assert run.returncode == 0\\n    assert \\\"attavo drive [N] [--until-ready | --report]\\\" in run.stdout\\n    assert \\\"schema/drive-report.schema.json\\\" in run.stdout\\n    assert \\\"(yours, waits, acts, done)\\\" in \\\" \\\".join(run.stdout.split())\\n\\n\\ndef test_unknown_subcommand_message_names_attest_and_record_only() -> None:\\n    run = subprocess.run([sys.executable, str(ATTAVO), \\\"not-a-real-subcommand\\\"],\\n                         capture_output=True, text=True, check=False)\\n    assert run.returncode == 2\\n    assert \\\"record-only\\\" in run.stderr\\n    assert \\\"attest\\\" in run.stderr\\n\\n\\ndef test_no_vendor_name_in_bin_attavo() -> None:\\n    \\\"\\\"\\\"Acceptance 11. The four pre-existing code-factory hits this check\\n    once had to carve out lived in test docstrings, not in bin/attavo\\n    itself; this check's own scope is bin/attavo alone, so it stays a\\n    plain empty-output assertion.\\\"\\\"\\\"\\n    run = subprocess.run(\\n        [\\\"git\\\", \\\"grep\\\", \\\"-n\\\", \\\"-i\\\", \\\"-E\\\", \\\"github|sigstore|in-toto\\\", \\\"--\\\", \\\"bin/attavo\\\"],\\n        cwd=str(ROOT), capture_output=True, text=True, check=False)\\nattavo.toml:7:checks_command = \\\"python3 .attavo/bin/forge-checks\\\"\\ntests/conftest.py:11:    \\\"\\\"\\\"The drive's forge poll reads its bound and interval from the environment at call time (issue #84) so a test never waits out the production bound; since #178 verify polls too, and a fixture whose checks_command prints nothing is unconcluded and would wait 600 s. Every test gets a sub-second clock unless it sets its own.\\\"\\\"\\\"\\ntests/test_executor_conformance
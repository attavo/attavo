exclude-dir=.git --exclude-dir=__pycache__ -l | head -30\"}},\"wire_ingest_context\":{\"toolu_01MjvA2t6iu6LrT8tGtR8P5j\":{\"cwd\":\"/Users/davidbean/Projects/attavo-worktree-212\"}}}\n20:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_018xeRtA6XCKzsipe1gdiFjc\",\"type\":\"tool_result\",\"content\":\"## Problem\\n\\nA build spends most of its time running the whole test suite, three times, around the executor's work. Read from #194's `build-01`: 215 s before the executor began, where `attavo build` runs `[checks].command` whole only to learn whether it can run at all (exit 2) and the feed shows nothing; 241 s at the gate, the whole suite again; and a 590 s wait inside the executor on a third run, because the instruction names the tenant's checks command and an executor given a command runs it (tenant zero's build-10 earned the present wording, \\\"are run for you\\\"; it did not stop #194, #204, or #206, where the suite was run twice inside one build). About 1,050 s of suite around 220 s of work, ahead of a required `test` check on the forge that runs the same suite and that the item waits on before review in any case.\\n\\nThe operator ruled four changes on 2026-09-20.\\n=== ./attavo.toml\\n38a39\\n> call_timeout_s = 240\\n51c52,54\\n< command = \\\"python3 -m pytest tests -q --deselect tests/test_doctor.py::test_every_gate_rejects --deselect tests/test_doctor.py::test_one_item_traversed_every_stage --deselect tests/test_doctor.py::test_no_commit_lacks_a_record --deselect tests/test_doctor.py::test_no_stop_lacks_cause --deselect tests/test_doctor.py::test_every_attested_item_is_sealed\\\"\\n---\\n> command = \\\"python3 -m mypy\\\"\\n> probe = \\\"python3 -c 'import pytest, mypy, jsonschema'\\\"\\n> probe_timeout_s = 60\\n=== ./tests/test_testtool.py\\nNEW\\n=== ./tests/test_executor_conformance.py\\n99a100,101\\n>     env.pop(\\\"ATTAVO_TEST_COMMAND\\\", None)\\n>     env.pop(\\\"ATTAVO_TEST_TIMEOUT_S\\\", None)\\n251,254c253,266\\n< def test_situation_7_checks_command_in_the_invocation(adapter_name: str, tmp_path: Path) -> None:\\n<     command = \\\"python3 bin/factory-lane check --base origin/main\\\"\\n<     with_checks = dry_run(adapter_name, tmp_path, extra_env={\\\"ATTAVO_CHECKS_COMMAND\\\": command})\\n<     assert command in with_checks[\\\"instruction\\\"]\\n---\\n> def test_situation_7_the_one_test_command_in_the_invocation(adapter_name: str, tmp_path: Path) -> None:\\n>     \\\"\\\"\\\"The executor is given one test command and no whole-tree command.\\n>     Naming the tenant's checks in the instruction made the executor their\\n>     runner however the sentence was worded (tenant zero build-10; #194's\\n>     590 s wait; #204 and #206, where the whole suite was run twice inside\\n>     one build), so the checks command is not in the instruction at all.\\\"\\\"\\\"\\n>     command = \\\"python3 /product/bin/attavo test 7\\\"\\n>     checks = \\\"python3 bin/factory-lane check --base origin/main\\\"\\n>     given = dry_run(adapter_name, tmp_path, extra_env={\\n>         \\\"ATTAVO_TEST_COMMAND\\\": command, \\\"ATTAVO_TEST_TIMEOUT_S\\\": \\\"240\\\",\\n>         \\\"ATTAVO_CHECKS_COMMAND\\\": checks})\\n>     assert command in given[\\\"instruction\\\"]\\n>     assert \\\"240 s\\\" in given[\\\"instruction\\\"]\\n>     assert checks not in given[\\\"instruction\\\"]\\n256,257c268,270\\n<     without_checks = dry_run(adapter_name, tmp_path)\\n<     assert command not in without_checks[\\\"instruction\\\"]\\n---\\n>     without = dry_run(adapter_name, tmp_path)\\n>     assert command not in without[\\\"instruction\\\"]\\n>     assert \\\"attavo test\\\" not in without[\\\"instruction\\\"]\\n=== ./tests/test_adapters.py\\n246,248c246,248\\n<     with_checks = dry_run(tmp_path, extra_env={\\n<         \\\"ATTAVO_CHECKS_COMMAND\\\": \\\"python3 bin/factory-lane check --base origin/main\\\"})\\n<     instruction = with_checks[with_checks.index(\\\"-p\\\") + 1]\\n---\\n>     with_tool = dry_run(tmp_path, extra_env={\\n>         \\\"ATTAVO_TEST_COMMAND\\\": \\\"python3 /product/bin/attavo test 7\\\"})\\n>     instruction = with_tool[with_tool.index(\\\"-p\\\") + 1]\\n250a251\\n>     assert \\\"Do not run the whole test suite\\\" in instruction\\n252,253c253,254\\n<     without_checks = dry_run(tmp_path)\\n<     instruction_without = without_checks[without_checks.index(\\\"-p\\\") + 1]\\n---\\n>     without_tool = dry_run(tmp_path)\\n>     instruction_without = without_tool[without_tool.index(\\\"-p\\\") + 1]\\n=== ./tests/test_self_tenancy.py\\n94d93\\n<         assert flag in m[\\\"checks\\\"][\\\"command\\\"], m[\\\"checks\\\"][\\\"command\\\"]\\n95a95,101\\n>     # Since the calibration item the gate's [checks].command runs the type\\n>     # check and no test at all; the whole suite is ci.yml's test job, which\\n>     # carries the same flags. A gate command that names pytest again must\\n>     # carry them too.\\n>     if \\\"pytest\\\" in m[\\\"checks\\\"][\\\"command\\\"]:\\n>         for flag in DESELECT_FLAGS:\\n>             assert flag in m[\\\"checks\\\"][\\\"command\\\"], m[\\\"checks\\\"][\\\"command\\\"]\\n109,111c115,117\\n<     assert run_select_tests(\\\"adapters/example/run\\\\n\\\") == [\\n<         \\\"tests/test_adapters.py\\\", \\\"tests/test_executor_conformance.py\\\",\\n<     ]\\n---\\n>     selected = run_select_tests(\\\"adapters/example/run\\\\n\\\")\\n>     assert \\\"tests/test_adapters.py\\\" in selected and \\\"tests/test_executor_conformance.py\\\" in selected\\n>     assert \\\"tests\\\" not in selected, \\\"an adapter path selected the whole suite\\\"\\n115,117c121,123\\n<     assert run_select_tests(\\\"schema/records/build.schema.json\\\\n\\\") == [\\n<         \\\"tests/test_record_schemas.py\\\", \\\"tests/test_attest.py\\\",\\n<     ]\\n---\\n>     selected = run_select_tests(\\\"schema/records/build.schema.json\\\\n\\\")\\n>     assert \\\"tests/test_record_schemas.py\\\" in selected and \\\"tests/test_attest.py\\\" in selected\\n>     assert \\\"tests\\\" not in selected, \\\"a schema path selected the whole suite\\\"\\n=== ./schema/manifest.schema.json\\n60a61,65\\n>         },\\n>         \\\"call_timeout_s\\\": {\\n>           \\\"type\\\": \\\"integer\\\",\\n>           \\\"minimum\\\": 1,\\n>           \\\"description\\\": \\\"Seconds one `attavo test` run is given before its process group is ended and it exits 124. The executor's own test runs are bounded; the gate's are not.\\\"\\n72c77\\n<           \\\"description\\\": \\\"The tenant's whole-tree check, run from the tenant root.\\\",\\n---\\n>           \\\"description\\\": \\\"The tenant's whole-tree check at the gate, run from the tenant root once per iteration on the committed tree. What is fast and decisive belongs here; what the forge runs as a required check need not be run twice.\\\",\\n73a79,88\\n>         },\\n>         \\\"probe\\\": {\\n>           \\\"type\\\": \\\"string\\\",\\n>           \\\"description\\\": \\\"A cheap command that answers whether this machine can run the checks at all, run once before a build's executor is invoked: exit 0 yes, anything else an environment refusal. When absent, attavo build asks by running [checks].command whole and reads exit 2 alone as cannot run.\\\",\\n>           \\\"minLength\\\": 1\\n>         },\\n>         \\\"probe_timeout_s\\\": {\\n>           \\\"type\\\": \\\"integer\\\",\\n>           \\\"minimum\\\": 1,\\n>           \\\"description\\\": \\\"Seconds [checks].probe is given; past it the build is refused as an environment stop. Required with probe: a bound the tenant did not write is a forecast.\\\"\\n75c90,91\\n<       }\\n---\\n>       },\\n>       \\\"dependentRequired\\\": {\\\"probe\\\": [\\\"probe_timeout_s\\\"]}\\n=== ./attavo/build.py\\n266a267,271\\n>     # STUB, not the implementation: when the tenant declares a probe it is\\n>     # run in place of the whole checks and any non-zero exit refuses; the\\n>     # bound, the refusal's own wording, the checks field, and the two feed\\n>     # lines are the build's to write. tests/test_testtool.py fails on this.\\n>     stub_probe = (m.get(\\\"checks\\\") or {}).get(\\\"probe\\\")\\n268c273\\n<         preflight = subprocess.run(checks_command, shell=True, cwd=str(root),\\n---\\n>         preflight = subprocess.run(stub_probe or checks_command, shell=True, cwd=str(root),\\n270c275\\n<         if preflight.returncode == 2:\\n---\\n>         if preflight.returncode == 2 or (stub_probe and preflight.returncode != 0):\\n334,335c339\\n<             if checks_command:\\n<                 env[\\\"ATTAVO_CHECKS_COMMAND\\\"] = checks_command\\n---\\n>             env[\\\"ATTAVO_TEST_COMMAND\\\"] = f\\\"python3 {PRODUCT_ROOT / 'bin' / 'attavo'} test {item_id}\\\"\\n=== ./attavo/testtool.py\\nNEW\\n=== ./attavo/cli.py\\n274a275\\n> from attavo.testtool import cmd_test\\n309a311,312\\n>     if argv[0] == \\\"test\\\":\\n>         return cmd_test(argv[1:])\\n312c315\\n<           f\\\"attest, drive, ledger, stops exist at this commit\\\", file=sys.stderr)\\n---\\n>           f\\\"attest, drive, ledger, stops, test exist at this commit\\\", file=sys.stderr)\\n=== ./adapters/claude-code/run\\n277,278c277,279\\n<     checks_command = os.environ.get(\\\"ATTAVO_CHECKS_COMMAND\\\")\\n<     if checks_command:\\n---\\n>     test_command = os.environ.get(\\\"ATTAVO_TEST_COMMAND\\\")\\n>     if test_command:\\n>         bound = os.environ.get(\\\"ATTAVO_TEST_TIMEOUT_S\\\")\\n280,282c281,286\\n<             f\\\"after you commit, the tenant's checks (`{checks_command}`) are run \\\"\\n<             \\\"for you and any failure is returned to you on the next iteration; \\\"\\n<             \\\"run only what you need while editing\\\")\\n---\\n>             f\\\"to run tests while you work, run `{test_command}`: it runs the tests \\\"\\n>             \\\"selected for the files you have changed\\\"\\n>             + (f\\\" and stops at {bound} s\\\" if bound else \\\"\\\")\\n>             + \\\". Do not run the whole test suite or any whole-tree check yourself: \\\"\\n>             \\\"after you commit, the gates are run for you and any failure is \\\"\\n>             \\\"returned to you on the next iteration\\\")\\n=== ./adapters/codex/run\\n272,273c272,274\\n<     checks_command = os.environ.get(\\\"ATTAVO_CHECKS_COMMAND\\\")\\n<     if checks_command:\\n---\\n>     test_command = os.environ.get(\\\"ATTAVO_TEST_COMMAND\\\")\\n>     if test_command:\\n>         bound = os.environ.get(\\\"ATTAVO_TEST_TIMEOUT_S\\\")\\n275,277c276,281\\n<             f\\\"after you commit, the tenant's checks (`{checks_command}`) are run \\\"\\n<             \\\"for you and any failure is returned to you on the next iteration; \\\"\\n<             \\\"run only what you need while editing\\\")\\n---\\n>             f\\\"to run tests while you work, run `{test_command}`: it runs the tests \\\"\\n>             \\\"selected for the files you have changed\\\"\\n>             + (f\\\" and stops at {bound} s\\\" if bound else \\\"\\\")\\n>             + \\\". Do not run the whole test suite or any whole-tree check yourself: \\\"\\n>             \\\"after you commit, the gates are run for you and any failure is \\\"\\n>             \\\"returned to you on the next iteration\\\")\\n=== ./.attavo/bin/select-tests\\n2,15c2,6\\n< \\\"\\\"\\\"select-tests: [tests].select for attavo build/verify (issue #103).\\n< \\n< Reads touched paths on stdin, one per line, and prints test identifiers\\n< on stdout, one per line, for this repository's own test suite:\\n< bin/attavo maps to the whole suite (\\\"tests\\\", handed to [tests].run as\\n< the one path pytest needs to run everything) -- the product's one\\n< script, and every test depends on it; adapters/<name>/** maps to\\n< tests/test_adapters.py and the conformance suite\\n< (tests/test_executor_conformance.py); schema/** maps to the record and\\n< attest tests (tests/test_record_schemas.py, tests/test_attest.py);\\n< anything else -- README.md among it -- maps to nothing.\\n< \\n< Usage: <touched paths> | select-tests\\n< \\\"\\\"\\\"\\n---\\n> \\\"\\\"\\\"select-tests, AS A STUB: not the selector and not to be shipped. It knows\\n> one module and sends everything else that is not prose or this repository's\\n> own specs and records to the whole suite. The table of modules and their\\n> tests, a test file selecting itself, and the adapters, schema, and templates\\n> prefixes are the build's to write. tests/test_testtool.py fails on it.\\\"\\\"\\\"\\n20,21d10\\n< ADAPTER_TESTS = (\\\"tests/test_adapters.py\\\", \\\"tests/test_executor_conformance.py\\\")\\n< SCHEMA_TESTS = (\\\"tests/test_record_schemas.py\\\", \\\"tests/test_attest.py\\\")\\n23,39d11\\n< \\n< def select(paths: list[str]) -> list[str]:\\n<     tests: list[str] = []\\n<     for path in paths:\\n<         if path == \\\"bin/attavo\\\":\\n<             return [\\\"tests\\\"]\\n<         if path.startswith(\\\"adapters/\\\"):\\n<             for t in ADAPTER_TESTS:\\n<                 if t not in tests:\\n<                     tests.append(t)\\n<         elif path.startswith(\\\"schema/\\\"):\\n<             for t in SCHEMA_TESTS:\\n<                 if t not in tests:\\n<                     tests.append(t)\\n<     return tests\\n< \\n< \\n41,42c13,21\\n<     touched = [line.strip() for line in sys.stdin.read().splitlines() if line.strip()]\\n<     for t in select(touched):\\n---\\n>     out: list[str] = []\\n>     for path in (line.strip() for line in sys.stdin.read().splitlines() if line.strip()):\\n>         if path.startswith(\\\"attest/\\\") or path.endswith(\\\".md\\\"):\\n>             continue\\n>         if path != \\\"attavo/report.py\\\":\\n>             print(\\\"tests\\\")\\n>             return 0\\n>         out.append(\\\"tests/test_report.py\\\")\\n>     for t in dict.fromkeys(out):\",\"is_error\":false}]},\"parent_tool_use_id\":null,\"session_id\":\"8327c9db-455b-4a76-8736-ba592c30dfef\",\"uuid\":\"41427d50-ca02-4d30-9a44-4842f148e1dd\",\"timestamp\":\"2026-09-21T01:41:41.795Z\",\"tool_use_result\":{\"stdout\":\"## Problem\\n\\nA build spends most of its time running the whole test suite, three times, around the executor's work. Read from #194's `build-01`: 215 s before the executor began, where `attavo build` runs `[checks].command` whole only to learn whether it can run at all (exit 2) and the feed shows nothing; 241 s at the gate, the whole suite again; and a 590 s wait inside the executor on a third run, because the instruction names the tenant's checks command and an executor given a command runs it (tenant zero's build-10 earned the present wording, \\\"are run for you\\\"; it did not stop #194, #204, or #206, where the suite was run twice inside one build). About 1,050 s of suite around 220 s of work, ahead of a required `test` check on the forge that runs the same suite and that the item waits on before review in any case.\\n\\nThe operator ruled four changes on 2026-09-20.\\n=== ./attavo.toml\\n38a39\\n> call_timeout_s = 240\\n51c52,54\\n< command = \\\"python3 -m pytest tests -q --deselect tests/test_doctor.py::test_every_gate_rejects --deselect tests/test_doctor.py::test_one_item_traversed_every_stage --deselect tests/test_doctor.py::test_no_commit_lacks_a_record --deselect tests/test_doctor.py::test_no_stop_lacks_cause --deselect tests/test_doctor.py::test_every_attested_item_is_sealed\\\"\\n---\\n> command = \\\"python3 -m mypy\\\"\\n> probe = \\\"python3 -c 'import pytest, mypy, jsonschema'\\\"\\n> probe_timeout_s = 60\\n=== ./tests/test_testtool.py\\nNEW\\n=== ./tests/test_executor_conformance.py\\n99a100,101\\n>     env.pop(\\\"ATTAVO_TEST_COMMAND\\\", None)\\n>     env.pop(\\\"ATTAVO_TEST_TIMEOUT_S\\\", None)\\n251,254c253,266\\n< def test_situation_7_checks_command_in_the_invocation(adapter_name: str, tmp_path: Path) -> None:\\n<     command = \\\"python3 bin/factory-lane check --base origin/main\\\"\\n<     with_checks = dry_run(adapter_name, tmp_path, extra_env={\\\"ATTAVO_CHECKS_COMMAND\\\": command})\\n<     assert command in with_checks[\\\"instruction\\\"]\\n---\\n> def test_situation_7_the_one_test_command_in_the_invocation(adapter_name: str, tmp_path: Path) -> None:\\n>     \\\"\\\"\\\"The executor is given one test command and no whole-tree command.\\n>     Naming the tenant's checks in the instruction made the executor their\\n>     runner however the sentence was worded (tenant zero build-10; #194's\\n>     590 s wait; #204 and #206, where the whole suite was run twice inside\\n>     one build), so the checks command is not in the instruction at all.\\\"\\\"\\\"\\n>     command = \\\"python3 /product/bin/attavo test 7\\\"\\n>     checks = \\\"python3 bin/factory-lane check --base origin/main\\\"\\n>     given = dry_run(adapter_name, tmp_path, extra_env={\\n>         \\\"ATTAVO_TEST_COMMAND\\\": command, \\\"ATTAVO_TEST_TIMEOUT_S\\\": \\\"240\\\",\\n>         \\\"ATTAVO_CHECKS_COMMAND\\\": checks})\\n>     assert command in given[\\\"instruction\\\"]\\n>     assert \\\"240 s\\\" in given[\\\"instruction\\\"]\\n>     assert checks not in given[\\\"instruction\\\"]\\n256,257c268,270\\n<     without_checks = dry_run(adapter_name, tmp_path)\\n<     assert command not in without_checks[\\\"instruction\\\"]\\n---\\n>     without = dry_run(adapter_name, tmp_path)\\n>     assert command not in without[\\\"instruction\\\"]\\n>     assert \\\"attavo test\\\" not in without[\\\"instruction\\\"]\\n=== ./tests/test_adapters.py\\n246,248c246,248\\n<     with_checks = dry_run(tmp_path, extra_env={\\n<         \\\"ATTAVO_CHECKS_COMMAND\\\": \\\"python3 bin/factory-lane check --base origin/main\\\"})\\n<     instruction = with_checks[with_checks.index(\\\"-p\\\") + 1]\\n---\\n>     with_tool = dry_run(tmp_path, extra_env={\\n>         \\\"ATTAVO_TEST_COMMAND\\\": \\\"python3 /product/bin/attavo test 7\\\"})\\n>     instruction = with_tool[with_tool.index(\\\"-p\\\") + 1]\\n250a251\\n>     assert \\\"Do not run the whole test suite\\\" in instruction\\n252,253c253,254\\n<     without_checks = dry_run(tmp_path)\\n<     instruction_without = without_checks[without_checks.index(\\\"-p\\\") + 1]\\n---\\n>     without_tool = dry_run(tmp_path)\\n>     instruction_without = without_tool[without_tool.index(\\\"-p\\\") + 1]\\n=== ./tests/test_self_tenancy.py\\n94d93\\n<         assert flag in m[\\\"checks\\\"][\\\"command\\\"], m[\\\"checks\\\"][\\\"command\\\"]\\n95a95,101\\n>     # Since the calibration item the gate's [checks].command runs the type\\n>     # check and no test at all; the whole suite is ci.yml's test job, which\\n>     # carries the same flags. A gate command that names pytest again must\\n>     # carry them too.\\n>     if \\\"pytest\\\" in m[\\\"checks\\\"][\\\"command\\\"]:\\n>         for flag in DESELECT_FLAGS:\\n>             assert flag in m[\\\"checks\\\"][\\\"command\\\"], m[\\\"checks\\\"][\\\"command\\\"]\\n109,111c115,117\\n<     assert run_select_tests(\\\"adapters/example/run\\\\n\\\") == [\\n<         \\\"tests/test_adapters.py\\\", \\\"tests/test_executor_conformance.py\\\",\\n<     ]\\n---\\n>     selected = run_select_tests(\\\"adapters/example/run\\\\n\\\")\\n>     assert \\\"tests/test_adapters.py\\\" in selected and \\\"tests/test_executor_conformance.py\\\" in selected\\n>     assert \\\"tests\\\" not in selected, \\\"an adapter path selected the whole suite\\\"\\n115,117c121,123\\n<     assert run_select_tests(\\\"schema/records/build.schema.json\\\\n\\\") == [\\n<         \\\"tests/test_record_schemas.py\\\", \\\"tests/test_attest.py\\\",\\n<     ]\\n---\\n>     selected = run_select_tests(\\\"schema/records/build.schema.json\\\\n\\\")\\n>     assert \\\"tests/test_record_schemas.py\\\" in selected and \\\"tests/test_attest.py\\\" in selected\\n>     assert \\\"tests\\\" not in selected, \\\"a schema path selected the whole suite\\\"\\n=== ./schema/manifest.schema.json\\n60a61,65\\n>         },\\n>         \\\"call_timeout_s\\\": {\\n>           \\\"type\\\": \\\"integer\\\",\\n>           \\\"minimum\\\": 1,\\n>           \\\"description\\\": \\\"Seconds one `attavo test` run is given before its process group is ended and it exits 124. The executor's own test runs are bounded; the gate's are not.\\\"\\n72c77\\n<           \\\"description\\\": \\\"The tenant's whole-tree check, run from the tenant root.\\\",\\n---\\n>           \\\"description\\\": \\\"The tenant's whole-tree check at the gate, run from the tenant root once per iteration on the committed tree. What is fast and decisive belongs here; what the forge runs as a required check need not be run twice.\\\",\\n73a79,88\\n>         },\\n>         \\\"probe\\\": {\\n>           \\\"type\\\": \\\"string\\\",\\n>           \\\"description\\\": \\\"A cheap command that answers whether this machine can run the checks at all, run once before a build's executor is invoked: exit 0 yes, anything else an environment refusal. When absent, attavo build asks by running [checks].command whole and reads exit 2 alone as cannot run.\\\",\\n>           \\\"minLength\\\": 1\\n>         },\\n>         \\\"probe_timeout_s\\\": {\\n>           \\\"type\\\": \\\"integer\\\",\\n>           \\\"minimum\\\": 1,\\n>           \\\"description\\\": \\\"Seconds [checks].probe is given; past it the build is refused as an environment stop. Required with probe: a bound the tenant did not write is a forecast.\\\"\\n75c90,91\\n<       }\\n---\\n>       },\\n>       \\\"dependentRequired\\\": {\\\"probe\\\": [\\\"probe_timeout_s\\\"]}\\n=== ./attavo/build.py\\n266a267,271\\n>     # STUB, not the implementation: when the tenant declares a probe it is\\n>     # run in place of the whole checks and any non-zero exit refuses; the\\n>     # bound, the refusal's own wording, the checks field, and the two feed\\n>     # lines are the build's to write. tests/test_testtool.py fails on this.\\n>     stub_probe = (m.get(\\\"checks\\\") or {}).get(\\\"probe\\\")\\n268c273\\n<         preflight = subprocess.run(checks_command, shell=True, cwd=str(root),\\n---\\n>         preflight = subprocess.run(stub_probe or checks_command, shell=True, cwd=str(root),\\n270c275\\n<         if preflight.returncode == 2:\\n---\\n>         if preflight.returncode == 2 or (stub_probe and preflight.returncode != 0):\\n334,335c339\\n<             if checks_command:\\n<                 env[\\\"ATTAVO_CHECKS_COMMAND\\\"] = checks_command\\n---\\n>             env[\\\"ATTAVO_TEST_COMMAND\\\"] = f\\\"python3 {PRODUCT_ROOT / 'bin' / 'attavo'} test {item_id}\\\"\\n=== ./attavo/testtool.py\\nNEW\\n=== ./attavo/cli.py\\n274a275\\n> from attavo.testtool import cmd_test\\n309a311,312\\n>     if argv[0] == \\\"test\\\":\\n>         return cmd_test(argv[1:])\\n312c315\\n<           f\\\"attest, drive, ledger, stops exist at this commit\\\", file=sys.stderr)\\n---\\n>           f\\\"attest, drive, ledger, stops, test exist at this commit\\\", file=sys.stderr)\\n=== ./adapters/claude-code/run\\n277,278c277,279\\n<     checks_command = os.environ.get(\\\"ATTAVO_CHECKS_COMMAND\\\")\\n<     if checks_command:\\n---\\n>     test_command = os.environ.get(\\\"ATTAVO_TEST_COMMAND\\\")\\n>     if test_command:\\n>         bound = os.environ.get(\\\"ATTAVO_TEST_TIMEOUT_S\\\")\\n280,282c281,286\\n<             f\\\"after you commit, the tenant's checks (`{checks_command}`) are run \\\"\\n<             \\\"for you and any failure is returned to you on the next iteration; \\\"\\n<             \\\"run only what you need while editing\\\")\\n---\\n>             f\\\"to run tests while you work, run `{test_command}`: it runs the tests \\\"\\n>             \\\"selected for the files you have changed\\\"\\n>             + (f\\\" and stops at {bound} s\\\" if bound else \\\"\\\")\\n>             + \\\". Do not run the whole test suite or any whole-tree check yourself: \\\"\\n>             \\\"after you commit, the gates are run for you and any failure is \\\"\\n>             \\\"returned to you on the next iteration\\\")\\n=== ./adapters/codex/run\\n272,273c272,274\\n<     checks_command = os.environ.get(\\\"ATTAVO_CHECKS_COMMAND\\\")\\n<     if checks_command:\\n---\\n>     test_command = os.environ.get(\\\"ATTAVO_TEST_COMMAND\\\")\\n>     if test_command:\\n>         bound = os.environ.get(\\\"ATTAVO_TEST_TIMEOUT_S\\\")\\n275,277c276,281\\n<             f\\\"after you commit, the tenant's checks (`{checks_command}`) are run \\\"\\n<             \\\"for you and any failure is returned to you on the next iteration; \\\"\\n<             \\\"run only what you need while editing\\\")\\n---\\n>             f\\\"to run tests while you work, run `{test_command}`: it runs the tests \\\"\\n>             \\\"selected for the files you have changed\\\"\\n>             + (f\\\" and stops at {bound} s\\\" if bound else \\\"\\\")\\n>             + \\\". Do not run the whole test suite or any whole-tree check yourself: \\\"\\n>             \\\"after you commit, the gates are run for you and any failure is \\\"\\n>             \\\"returned to you on the next iteration\\\")\\n=== ./.attavo/bin/select-tests\\n2,15c2,6\\n< \\\"\\\"\\\"select-tests: [tests].select for attavo build/verify (issue #103).\\n< \\n< Reads touched paths on stdin, one per line, and prints test identifiers\\n< on stdout, one per line, for this repository's own test suite:\\n< bin/attavo maps to the whole suite (\\\"tests\\\", handed to [tests].run as\\n< the one path pytest needs to run everything) -- the product's one\\n< script, and every test depends on it; adapters/<name>/** maps to\\n< tests/test_adapters.py and the conformance suite\\n< (tests/test_executor_conformance.py); schema/** maps to the record and\\n< attest tests (tests/test_record_schemas.py, tests/test_attest.py);\\n< anything else -- README.md among it -- maps to nothing.\\n< \\n< Usage: <touched paths> | select-tests\\n< \\\"\\\"\\\"\\n---\\n> \\\"\\\"\\\"select-tests, AS A STUB: not the selector and not to be shipped. It knows\\n> one module and sends everything else that is not prose or this repository's\\n> own specs and records to the whole suite. The table of modules and their\\n> tests, a test file selecting itself, and the adapters, schema, and templates\\n> prefixes are the build's to write. tests/test_testtool.py fails on it.\\\"\\\"\\\"\\n20,21d10\\n< ADAPTER_TESTS = (\\\"tests/test_adapters.py\\\", \\\"tests/test_executor_conformance.py\\\")\\n< SCHEMA_TESTS = (\\\"tests/test_record_schemas.py\\\", \\\"tests/test_attest.py\\\")\\n23,39d11\\n< \\n< def select(paths: list[str]) -> list[str]:\\n<     tests: list[str] = []\\n<     for path in paths:\\n<         if path == \\\"bin/attavo\\\":\\n<             return [\\\"tests\\\"]\\n<         if path.startswith(\\\"adapters/\\\"):\\n<             for t in ADAPTER_TESTS:\\n<                 if t not in tests:\\n<                     tests.append(t)\\n<         elif path.startswith(\\\"schema/\\\"):\\n<             for t in SCHEMA_TESTS:\\n<                 if t not in tests:\\n<                     tests.append(t)\\n<     return tests\\n< \\n< \\n41,42c13,21\\n<     touched = [line.strip() for line in sys.stdin.read().splitlines() if line.strip()]\\n<     for t in select(touched):\\n---\\n>     out: list[str] = []\\n>     for path in (line.strip() for line in sys.stdin.read().splitlines() if line.strip()):\\n>         if path.startswith(\\\"attest/\\\") or path.endswith(\\\".md\\\"):\\n>             continue\\n>         if path != \\\"attavo/report.py\\\":\\n>             print(\\\"tests\\\")\\n>             return 0\\n>         out.append(\\\"tests/test_report.py\\\")\\n>     for t in dict.fromkeys(out):\",\"stderr\":\"\",\"interrupted\":false,\"isImage\":false,\"noOutputExpected\":false}}\n25:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_019LqSFNjHX8aanXSguLWuVo\",\"type\":\"tool_result\",\"content\":\"\\\"\\\"\\\"The build's calibration (operator's rulings, 2026-09-20): a declared probe\\nin place of a whole run of the checks before the first build; one bounded\\ntest command for the executor; a selector that fails safe. The specimen is\\n#194's build-01: 215 s of suite before the executor began, 241 s of it at\\nthe gate, and a 590 s wait on a third run inside the executor, around 220 s\\nof work.\\n\\nRun: python3 -m pytest tests -q\\n\\\"\\\"\\\"\\nfrom __future__ import annotations\\n\\nimport json\\nimport subprocess\\nimport sys\\nimport time\\nfrom pathlib import Path\\nfrom typing import Any\\n\\nimport jsonschema\\n\\nfrom helpers import commit_all, git, make_tenant\\nfrom test_drive import approve_item, record_files, run_attavo\\n\\nROOT = Path(__file__).resolve().parent.parent\\nSELECT = ROOT / \\\".attavo\\\" / \\\"bin\\\" / \\\"select-tests\\\"\\nMANIFEST_SCHEMA = json.loads((ROOT / \\\"schema\\\" / \\\"manifest.schema.json\\\").read_text())\\n\\n\\ndef tenant(tmp_path: Path, checks: str = \\\"\\\", tests: str = \\\"\\\") -> Path:\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    toml = root / \\\"attavo.toml\\\"\\n    text = toml.read_text()\\n    if tests:\\n        text = text.replace('[tests]\\\\nselect = \\\"cat\\\"\\\\nrun = \\\"true\\\"', tests)\\n    toml.write_text(text + (\\\"\\\\n\\\" + checks + \\\"\\\\n\\\" if checks else \\\"\\\"))\\n    commit_all(root, \\\"configure\\\")\\n    git(root, \\\"checkout\\\", \\\"-q\\\", \\\"-b\\\", \\\"attavo/1-x\\\")\\n    return root\\n\\n\\ndef events(root: Path) -> list[dict[str, Any]]:\\n    found = sorted(root.glob(\\\".git/**/build-01.events.jsonl\\\"))\\n    assert found, \\\"no events file for build-01\\\"\\n    return [json.loads(line) for line in found[-1].read_text().splitlines()]\\n\\n\\ndef build_record(root: Path) -> dict[str, Any]:\\n    record: dict[str, Any] = json.loads(record_files(root, \\\"build\\\")[-1].read_text())\\n    return record\\n\\n\\ndef test_build_runs_the_probe_and_not_the_whole_checks_before_the_executor(tmp_path: Path) -> None:\\n    root = tenant(tmp_path, checks='[checks]\\\\ncommand = \\\"echo ran >> checks-ran.txt\\\"\\\\n'\\n                                   'probe = \\\"echo probed >> probe-ran.txt\\\"\\\\nprobe_timeout_s = 30')\\n    (root / \\\".gitignore\\\").write_text(\\\"checks-ran.txt\\\\nprobe-ran.txt\\\\n\\\")\\n    commit_all(root, \\\"ignore the counters\\\")\\n    approve_item(root)\\n    assert run_attavo(root, \\\"build\\\", \\\"1\\\").returncode == 0\\n    assert (root / \\\"probe-ran.txt\\\").read_text().count(\\\"probed\\\") == 1\\n    assert (root / \\\"checks-ran.txt\\\").read_text().count(\\\"ran\\\") == 1, \\\"the checks ran before the build, not only at its gate\\\"\\n    texts = [e[\\\"text\\\"] for e in events(root) if e[\\\"kind\\\"] == \\\"gate\\\"]\\n    assert texts[0] == \\\"checking this machine can run the checks\\\", texts\\n    assert texts[1] == \\\"this machine can run the checks\\\", texts\\n\\n\\ndef test_build_without_a_probe_asks_the_old_way_and_says_so_in_the_feed(tmp_path: Path) -> None:\\n    root = tenant(tmp_path, checks='[checks]\\\\ncommand = \\\"echo ran >> checks-ran.txt\\\"')\\n    (root / \\\".gitignore\\\").write_text(\\\"checks-ran.txt\\\\n\\\")\\n    commit_all(root, \\\"ignore the counter\\\")\\n    approve_item(root)\\n    assert run_attavo(root, \\\"build\\\", \\\"1\\\").returncode == 0\\n    assert (root / \\\"checks-ran.txt\\\").read_text().count(\\\"ran\\\") == 2\\n    assert [e[\\\"text\\\"] for e in events(root) if e[\\\"kind\\\"] == \\\"gate\\\"][0] == \\\"checking this machine can run the checks\\\"\\n\\n\\ndef test_a_failing_probe_refuses_the_build_as_an_environment_stop_before_the_executor(tmp_path: Path) -> None:\\n    root = tenant(tmp_path, checks='[checks]\\\\ncommand = \\\"true\\\"\\\\nprobe = \\\"echo no pytest here; exit 3\\\"\\\\nprobe_timeout_s = 30')\\n    approve_item(root)\\n    assert run_attavo(root, \\\"build\\\", \\\"1\\\").returncode == 1\\n    record = build_record(root)\\n    assert (record[\\\"status\\\"], record[\\\"stop\\\"][\\\"class\\\"], record[\\\"stop\\\"][\\\"provenance\\\"]) == (\\n        \\\"refused\\\", \\\"environment\\\", \\\"tenant\\\"), record\\n    assert record[\\\"refusal\\\"] == \\\"[checks].probe exited 3 on the approved tree\\\", record[\\\"refusal\\\"]\\n    assert record[\\\"checks\\\"] == {\\\"command\\\": \\\"echo no pytest here; exit 3\\\", \\\"exit\\\": 3}, record[\\\"checks\\\"]\\n    assert \\\"no pytest here\\\" in record[\\\"stop\\\"][\\\"detail\\\"], record[\\\"stop\\\"]\\n    assert not (root / \\\"built.txt\\\").exists(), \\\"the executor ran\\\"\\n\\n\\ndef test_a_probe_past_its_bound_is_ended_and_refuses_the_build(tmp_path: Path) -> None:\\n    root = tenant(tmp_path, checks='[checks]\\\\ncommand = \\\"true\\\"\\\\nprobe = \\\"sleep 30\\\"\\\\nprobe_timeout_s = 1')\\n    approve_item(root)\\n    started = time.monotonic()\\n    assert run_attavo(root, \\\"build\\\", \\\"1\\\").returncode == 1\\n    assert time.monotonic() - started < 15\\n    record = build_record(root)\\n    assert record[\\\"refusal\\\"] == \\\"[checks].probe did not finish within 1 s\\\", record[\\\"refusal\\\"]\\n    assert record[\\\"stop\\\"][\\\"class\\\"] == \\\"environment\\\", record[\\\"stop\\\"]\\n\\n\\ndef test_the_manifest_schema_requires_a_bound_with_a_probe(tmp_path: Path) -> None:\\n    checks = MANIFEST_SCHEMA[\\\"properties\\\"][\\\"checks\\\"]\\n    jsonschema.validate({\\\"command\\\": \\\"true\\\", \\\"probe\\\": \\\"true\\\", \\\"probe_timeout_s\\\": 5}, checks)\\n    jsonschema.validate({\\\"command\\\": \\\"true\\\"}, checks)\\n    try:\\n        jsonschema.validate({\\\"command\\\": \\\"true\\\", \\\"probe\\\": \\\"true\\\"}, checks)\\n    except jsonschema.ValidationError:\\n        pass\\n    else:\\n        raise AssertionError(\\\"a probe with no bound validated\\\")\\n    jsonschema.validate({\\\"select\\\": \\\"cat\\\", \\\"run\\\": \\\"true\\\", \\\"call_timeout_s\\\": 240},\\n                        MANIFEST_SCHEMA[\\\"properties\\\"][\\\"tests\\\"])\\n\\n\\nSELECTING = ('[tests]\\\\nselect = \\\"sed -n \\\\'s#^src/\\\\\\\\\\\\\\\\(.*\\\\\\\\\\\\\\\\)[.]py$#tests/test_\\\\\\\\\\\\\\\\1.py#p\\\\'\\\"\\\\n'\\n             'run = \\\"sh -c \\\\'cat > selected.txt; cat selected.txt\\\\'\\\"')\\n\\n\\ndef test_attavo_test_runs_what_the_tenant_selects_for_the_items_changes_committed_or_not(tmp_path: Path) -> None:\\n    root = tenant(tmp_path, tests=SELECTING)\\n    (root / \\\".gitignore\\\").write_text(\\\"selected.txt\\\\n\\\")\\n    (root / \\\"src\\\").mkdir()\\n    (root / \\\"src\\\" / \\\"committed.py\\\").write_text(\\\"x = 1\\\\n\\\")\\n    commit_all(root, \\\"a committed change\\\")\\n    (root / \\\"src\\\" / \\\"unstaged.py\\\").write_text(\\\"y = 2\\\\n\\\")\\n    (root / \\\"records\\\" / \\\"1\\\").mkdir(parents=True, exist_ok=True)\\n    (root / \\\"records\\\" / \\\"1\\\" / \\\"note.py\\\").write_text(\\\"\\\")\\n    run = run_attavo(root, \\\"test\\\", \\\"1\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n    assert (root / \\\"selected.txt\\\").read_text().split() == [\\\"tests/test_committed.py\\\", \\\"tests/test_unstaged.py\\\"]\\n    assert \\\"2 selected\\\" in run.stdout, run.stdout\\n\\n\\ndef test_attavo_test_exits_as_the_run_does_and_says_when_nothing_is_selected(tmp_path: Path) -> None:\\n    failing = tenant(tmp_path, tests='[tests]\\\\nselect = \\\"cat\\\"\\\\nrun = \\\"sh -c \\\\'cat >/dev/null; exit 7\\\\'\\\"')\\n    (failing / \\\"anything.txt\\\").write_text(\\\"z\\\\n\\\")\\n    assert run_attavo(failing, \\\"test\\\", \\\"1\\\").returncode == 7\\n    quiet = tenant(tmp_path / \\\"quiet\\\", tests='[tests]\\\\nselect = \\\"true\\\"\\\\nrun = \\\"exit 9\\\"')\\n    (quiet / \\\"anything.txt\\\").write_text(\\\"z\\\\n\\\")\\n    run = run_attavo(quiet, \\\"test\\\", \\\"1\\\")\\n    assert run.returncode == 0 and \\\"no test is selected\\\" in run.stdout, run.stdout + run.stderr\\n\\n\\ndef test_attavo_test_ends_a_run_past_its_bound_with_everything_it_started(tmp_path: Path) -> None:\\n    root = tenant(tmp_path, tests='[tests]\\\\nselect = \\\"cat\\\"\\\\ncall_timeout_s = 1\\\\n'\\n                                  'run = \\\"sh -c \\\\'cat >/dev/null; sleep 30 & echo $! > child.pid; wait\\\\'\\\"')\\n    (root / \\\".gitignore\\\").write_text(\\\"child.pid\\\\n\\\")\\n    (root / \\\"anything.txt\\\").write_text(\\\"z\\\\n\\\")\\n    started = time.monotonic()\\n    run = run_attavo(root, \\\"test\\\", \\\"1\\\")\\n    assert time.monotonic() - started < 15\\n    assert run.returncode == 124, run.stdout + run.stderr\\n    assert \\\"did not finish within 1 s\\\" in run.stdout, run.stdout\\n    child = int((root / \\\"child.pid\\\").read_text())\\n    time.sleep(0.5)\\n    # a process that was ended but not yet reaped still has a pid; its state says Z\\n    state = subprocess.run([\\\"ps\\\", \\\"-o\\\", \\\"stat=\\\", \\\"-p\\\", str(child)], capture_output=True, text=True,\\n                           check=False).stdout.strip()\\n    assert state == \\\"\\\" or state.startswith(\\\"Z\\\"), f\\\"the run's own child outlived the timeout (state {state!r})\\\"\\n\\n\\ndef test_build_hands_the_executor_the_test_command_and_no_checks_command(tmp_path: Path) -> None:\\n    root = tenant(tmp_path, checks='[checks]\\\\ncommand = \\\"true\\\"', tests='[tests]\\\\nselect = \\\"cat\\\"\\\\nrun = \\\"true\\\"\\\\ncall_timeout_s = 240')\\n    (root / \\\"attavo\\\" / \\\"adapters\\\" / \\\"fixture\\\").mkdir(parents=True)\\n    probe = root / \\\"attavo\\\" / \\\"adapters\\\" / \\\"fixture\\\" / \\\"run\\\"\\n    probe.write_text('#!/bin/sh\\\\nenv | grep \\\"^ATTAVO_\\\" | sort > \\\"$PWD/seen-env.txt\\\"\\\\n'\\n                     'echo built > built.txt\\\\ngit add built.txt\\\\ngit commit -q -m built\\\\n'\\n                     'printf \\\\'{\\\"status\\\": \\\"done\\\", \\\"question\\\": null}\\\\\\\\n\\\\'\\\\n')\\n    probe.chmod(0o755)\\n    (root / \\\".gitignore\\\").write_text(\\\"seen-env.txt\\\\n\\\")\\n    commit_all(root, \\\"a tenant-side adapter that prints what it was given\\\")\\n    approve_item(root)\\n    run_attavo(root, \\\"build\\\", \\\"1\\\")\\n    seen = (root / \\\"seen-env.txt\\\").read_text()\\n    assert f\\\"ATTAVO_TEST_COMMAND=python3 {ROOT / 'bin' / 'attavo'} test 1\\\" in seen, seen\\n    assert \\\"ATTAVO_TEST_TIMEOUT_S=240\\\" in seen, seen\\n    assert \\\"ATTAVO_CHECKS_COMMAND\\\" not in seen, seen\\n\\n\\ndef select(*paths: str) -> list[str]:\\n    run = subprocess.run([sys.executable, str(SELECT)], input=\\\"\\\".join(p + \\\"\\\\n\\\" for p in paths),\\n                         capture_output=True, text=True, check=True)\\n    return run.stdout.split()\\n\\n\\ndef test_this_repositorys_selector_fails_safe_on_a_path_it_does_not_know() -> None:\\n    assert select(\\\"attavo/a_module_nobody_mapped.py\\\") == [\\\"tests\\\"]\\n    assert select(\\\"attavo/report.py\\\", \\\"attavo/a_module_nobody_mapped.py\\\") == [\\\"tests\\\"]\\n    assert select(\\\"scripts/anything.py\\\") == [\\\"tests\\\"]\\n    assert select(\\\"bin/attavo\\\") == [\\\"tests\\\"]\\n    assert select(\\\"attavo/common.py\\\") == [\\\"tests\\\"], \\\"a module every test stands on selects everything\\\"\\n\\n\\ndef test_this_repositorys_selector_maps_a_module_to_its_own_tests_and_prose_to_nothing() -> None:\\n    assert select(\\\"attavo/report.py\\\") == [\\\"tests/test_report.py\\\"]\\n    assert select(\\\"tests/test_ledger.py\\\") == [\\\"tests/test_ledger.py\\\"]\\n    assert select(\\\"README.md\\\", \\\"attest/records/1/build-01.json\\\", \\\"attest/specs/9/spec.md\\\") == []\\n    assert \\\"tests/test_executor_conformance.py\\\" in select(\\\"adapters/codex/run\\\")\\n\\n\\ndef test_every_test_file_the_selector_names_exists_and_every_module_is_mapped_or_falls_through() -> None:\\n    namespace: dict[str, Any] = {}\\n    exec(compile(SELECT.read_text(), str(SELECT), \\\"exec\\\"), {\\\"__name__\\\": \\\"selector\\\"}, namespace)\\n    named = {t for ts in namespace[\\\"MODULE_TESTS\\\"].values() for t in ts}\\n    named |= {t for _, ts in namespace[\\\"PREFIX_TESTS\\\"] for t in ts}\\n    missing = sorted(t for t in named if not (ROOT / t).is_file())\\n    assert not missing, f\\\"the selector names test files that do not exist: {missing}\\\"\\n    for module in sorted(p.relative_to(ROOT).as_posix() for p in (ROOT / \\\"attavo\\\").glob(\\\"*.py\\\")):\\n        assert select(module), f\\\"{module} selects nothing at all\\\"\\n\\n\\ndef test_this_repositorys_manifest_declares_the_probe_a_gate_without_the_suite_and_a_bound() -> None:\\n    import tomllib\\n    m = tomllib.loads((ROOT / \\\"attavo.toml\\\").read_text())\\n    assert \\\"pytest tests\\\" not in m[\\\"checks\\\"][\\\"command\\\"], m[\\\"checks\\\"][\\\"command\\\"]\\n    assert \\\"mypy\\\" in m[\\\"checks\\\"][\\\"command\\\"], m[\\\"checks\\\"][\\\"command\\\"]\\n    assert m[\\\"checks\\\"][\\\"probe\\\"] and m[\\\"checks\\\"][\\\"probe_timeout_s\\\"] <= 120, m[\\\"checks\\\"]\\n    assert m[\\\"tests\\\"][\\\"call_timeout_s\\\"] <= 300, m[\\\"tests\\\"]\\n    jsonschema.validate(m[\\\"checks\\\"], MANIFEST_SCHEMA[\\\"properties\\\"][\\\"checks\\\"])\\n    jsonschema.validate(m[\\\"tests\\\"], MANIFEST_SCHEMA[\\\"properties\\\"][\\\"tests\\\"])\\n=== attest/specs/212/criteria/attavo-test-runs-the-selected-tests-inside-a-bound.sh\\n#!/bin/sh\\nset -e\\nhere=$(pwd)\\ntmp=$(mktemp -d \\\"${TMPDIR:-/tmp}/attavo.XXXXXX\\\")\\ncp -R \\\"$here/tests/fixtures/build_valid/.\\\" \\\"$tmp/tenant\\\"\\ncd \\\"$tmp/tenant\\\"\\ngit init -q -b main .\\ngit config user.email fixture@attavo.invalid\\ngit config user.name \\\"fixture\\\"\\nA=\\\"python3 $here/bin/attavo\\\"\\ninstall() {\\n  git add -A\\n  git commit -q -m install\\n  git update-ref refs/remotes/origin/main \\\"$(git rev-parse HEAD)\\\"\\n  git symbolic-ref refs/remotes/origin/HEAD refs/remotes/origin/main\\n  git checkout -q -b attavo/1-x\\n}\\npython3 - <<'PY'\\np = \\\"attavo.toml\\\"\\nt = open(p).read().replace('[tests]\\\\nselect = \\\"cat\\\"\\\\nrun = \\\"true\\\"',\\n    '[tests]\\\\nselect = \\\"grep ^src/\\\"\\\\ncall_timeout_s = 2\\\\nrun = \\\"sh -c \\\\'cat > selected.txt; if grep -q slow selected.txt; then sleep 30; fi; if grep -q bad selected.txt; then exit 7; fi\\\\'\\\"')\\nopen(p, \\\"w\\\").write(t)\\nPY\\nprintf 'selected.txt\\\\n' > .gitignore\\ninstall\\nmkdir src\\nprintf 'x\\\\n' > src/good.py\\ngit add -A\\ngit commit -q -m \\\"a change\\\"\\n$A test 1 >/dev/null\\ntest \\\"$(cat selected.txt)\\\" = \\\"src/good.py\\\"\\nprintf 'x\\\\n' > src/bad.py\\ngit add -A\\ngit commit -q -m \\\"a change whose tests fail\\\"\\ncode=0\\n$A test 1 >/dev/null || code=$?\\ntest \\\"$code\\\" = 7\\ngit rm -q src/bad.py\\nprintf 'x\\\\n' > src/slow.py\\ngit add -A\\ngit commit -q -m \\\"a change whose tests never end\\\"\\nstarted=$(date +%s)\\ncode=0\\n$A test 1 >/dev/null || code=$?\\ntest \\\"$code\\\" = 124\\ntest $(( $(date +%s) - started )) -lt 20\\ncd \\\"$here\\\"\\nrm -rf \\\"$tmp\\\"\\n=== attest/specs/212/criteria/build-asks-the-probe-and-not-the-whole-checks.sh\\n#!/bin/sh\\nset -e\\nhere=$(pwd)\\ntmp=$(mktemp -d \\\"${TMPDIR:-/tmp}/attavo.XXXXXX\\\")\\ncp -R \\\"$here/tests/fixtures/build_valid/.\\\" \\\"$tmp/tenant\\\"\\ncd \\\"$tmp/tenant\\\"\\ngit init -q -b main .\\ngit config user.email fixture@attavo.invalid\\ngit config user.name \\\"fixture\\\"\\nA=\\\"python3 $here/bin/attavo\\\"\\ninstall() {\\n  git add -A\\n  git commit -q -m install\\n  git update-ref refs/remotes/origin/main \\\"$(git rev-parse HEAD)\\\"\\n  git symbolic-ref refs/remotes/origin/HEAD refs/remotes/origin/main\\n  git checkout -q -b attavo/1-x\\n}\\nprintf 'checks-ran.txt\\\\nprobe-ran.txt\\\\n' > .gitignore\\nprintf '\\\\n[checks]\\\\ncommand = \\\"echo ran >> checks-ran.txt\\\"\\\\nprobe = \\\"echo probed >> probe-ran.txt\\\"\\\\nprobe_timeout_s = 30\\\\n' >> attavo.toml\\ninstall\\n$A spec-gate 1 >/dev/null\\n$A approve 1 --by alice >/dev/null\\n$A build 1 >/dev/null\\ntest \\\"$(grep -c probed probe-ran.txt)\\\" = 1\\ntest \\\"$(grep -c ran checks-ran.txt)\\\" = 1\\ncd \\\"$here\\\"\\nrm -rf \\\"$tmp\\\"\\ntmp=$(mktemp -d \\\"${TMPDIR:-/tmp}/attavo.XXXXXX\\\")\\ncp -R \\\"$here/tests/fixtures/build_valid/.\\\" \\\"$tmp/tenant\\\"\\ncd \\\"$tmp/tenant\\\"\\ngit init -q -b main .\\ngit config user.email fixture@attavo.invalid\\ngit config user.name \\\"fixture\\\"\\nprintf '\\\\n[checks]\\\\ncommand = \\\"true\\\"\\\\nprobe = \\\"exit 3\\\"\\\\nprobe_timeout_s = 30\\\\n' >> attavo.toml\\ninstall\\n$A spec-gate 1 >/dev/null\\n$A approve 1 --by alice >/dev/null\\nif $A build 1 >/dev/null; then exit 1; fi\\ntest ! -e built.txt\\npython3 - <<'PY'\\nimport json\\nr = json.load(open(\\\"records/1/build-01.json\\\"))\\nassert r[\\\"status\\\"] == \\\"refused\\\" and r[\\\"stop\\\"][\\\"class\\\"] == \\\"environment\\\", r\\nPY\\ncd \\\"$here\\\"\\nrm -rf \\\"$tmp\\\"\\n=== attest/specs/212/criteria/the-executor-is-given-one-test-command.sh\\n#!/bin/sh\\nset -e\\n! grep -q 'ATTAVO_CHECKS_COMMAND' attavo/build.py adapters/claude-code/run adapters/codex/run\\ngrep -q 'ATTAVO_TEST_COMMAND' attavo/build.py\\ngrep -q 'ATTAVO_TEST_COMMAND' adapters/claude-code/run\\ngrep -q 'ATTAVO_TEST_COMMAND' adapters/codex/run\\npython3 - <<'PY'\\nimport json\\ns = json.load(open(\\\"schema/manifest.schema.json\\\"))[\\\"properties\\\"]\\nassert \\\"probe\\\" in s[\\\"checks\\\"][\\\"properties\\\"] and s[\\\"checks\\\"][\\\"dependentRequired\\\"] == {\\\"probe\\\": [\\\"probe_timeout_s\\\"]}, s[\\\"checks\\\"]\\nassert \\\"call_timeout_s\\\" in s[\\\"tests\\\"][\\\"properties\\\"], s[\\\"tests\\\"]\\nPY\\nfor t in test_build_runs_the_probe_and_not_the_whole_checks_before_the_executor test_build_without_a_probe_asks_the_old_way_and_says_so_in_the_feed test_a_failing_probe_refuses_the_build_as_an_environment_stop_before_the_executor test_a_probe_past_its_bound_is_ended_and_refuses_the_build test_the_manifest_schema_requires_a_bound_with_a_probe test_attavo_test_runs_what_the_tenant_selects_for_the_items_changes_committed_or_not test_attavo_test_exits_as_the_run_does_and_says_when_nothing_is_selected test_attavo_test_ends_a_run_past_its_bound_with_everything_it_started test_build_hands_the_executor_the_test_command_and_no_checks_command test_this_repositorys_selector_fails_safe_on_a_path_it_does_not_know test_this_repositorys_selector_maps_a_module_to_its_own_tests_and_prose_to_nothing test_every_test_file_the_selector_names_exists_and_every_module_is_mapped_or_falls_through test_this_repositorys_manifest_declares_the_probe_a_gate_without_the_suite_and_a_bound\\ndo\\n  grep -q \\\"^def $t(\\\" tests/test_testtool.py\\ndone\\ngrep -q '^def test_situation_7_the_one_test_command_in_the_invocation(' tests/test_executor_conformance.py\\n=== attest/specs/212/criteria/the-selector-fails-safe-and-the-gate-drops-the-suite.sh\\n#!/bin/sh\\nset -e\\nS=\\\"python3 .attavo/bin/select-tests\\\"\\ntest \\\"$(printf 'attavo/a_module_nobody_mapped.py\\\\n' | $S)\\\" = \\\"tests\\\"\\ntest \\\"$(printf 'attavo/report.py\\\\n' | $S)\\\" = \\\"tests/test_report.py\\\"\\ntest -z \\\"$(printf 'README.md\\\\nattest/records/1/build-01.json\\\\n' | $S)\\\"\\npython3 - <<'PY'\\nimport tomllib\\nm = tomllib.load(open(\\\"attavo.toml\\\", \\\"rb\\\"))\\nassert \\\"pytest tests\\\" not in m[\\\"checks\\\"][\\\"command\\\"] and \\\"mypy\\\" in m[\\\"checks\\\"][\\\"command\\\"], m[\\\"checks\\\"]\\nassert m[\\\"checks\\\"][\\\"probe\\\"] and isinstance(m[\\\"checks\\\"][\\\"probe_timeout_s\\\"], int), m[\\\"checks\\\"]\\nassert isinstance(m[\\\"tests\\\"][\\\"call_timeout_s\\\"], int), m[\\\"tests\\\"]\\nPY\",\"is_error\":false}]},\"parent_tool_use_id\":null,\"session_id\":\"8327c9db-455b-4a76-8736-ba592c30dfef\",\"uuid\":\"6ebb4f12-259e-4b68-aaff-aa0fa3a5db90\",\"timestamp\":\"2026-09-21T01:41:44.911Z\",\"tool_use_result\":{\"stdout\":\"\\\"\\\"\\\"The build's calibration (operator's rulings, 2026-09-20): a declared probe\\nin place of a whole run of the checks before the first build; one bounded\\ntest command for the executor; a selector that fails safe. The specimen is\\n#194's build-01: 215 s of suite before the executor began, 241 s of it at\\nthe gate, and a 590 s wait on a third run inside the executor, around 220 s\\nof work.\\n\\nRun: python3 -m pytest tests -q\\n\\\"\\\"\\\"\\nfrom __future__ import annotations\\n\\nimport json\\nimport subprocess\\nimport sys\\nimport time\\nfrom pathlib import Path\\nfrom typing import Any\\n\\nimport jsonschema\\n\\nfrom helpers import commit_all, git, make_tenant\\nfrom test_drive import approve_item, record_files, run_attavo\\n\\nROOT = Path(__file__).resolve().parent.parent\\nSELECT = ROOT / \\\".attavo\\\" / \\\"bin\\\" / \\\"select-tests\\\"\\nMANIFEST_SCHEMA = json.loads((ROOT / \\\"schema\\\" / \\\"manifest.schema.json\\\").read_text())\\n\\n\\ndef tenant(tmp_path: Path, checks: str = \\\"\\\", tests: str = \\\"\\\") -> Path:\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    toml = root / \\\"attavo.toml\\\"\\n    text = toml.read_text()\\n    if tests:\\n        text = text.replace('[tests]\\\\nselect = \\\"cat\\\"\\\\nrun = \\\"true\\\"', tests)\\n    toml.write_text(text + (\\\"\\\\n\\\" + checks + \\\"\\\\n\\\" if checks else \\\"\\\"))\\n    commit_all(root, \\\"configure\\\")\\n    git(root, \\\"checkout\\\", \\\"-q\\\", \\\"-b\\\", \\\"attavo/1-x\\\")\\n    return root\\n\\n\\ndef events(root: Path) -> list[dict[str, Any]]:\\n    found = sorted(root.glob(\\\".git/**/build-01.events.jsonl\\\"))\\n    assert found, \\\"no events file for build-01\\\"\\n    return [json.loads(line) for line in found[-1].read_text().splitlines()]\\n\\n\\ndef build_record(root: Path) -> dict[str, Any]:\\n    record: dict[str, Any] = json.loads(record_files(root, \\\"build\\\")[-1].read_text())\\n    return record\\n\\n\\ndef test_build_runs_the_probe_and_not_the_whole_checks_before_the_executor(tmp_path: Path) -> None:\\n    root = tenant(tmp_path, checks='[checks]\\\\ncommand = \\\"echo ran >> checks-ran.txt\\\"\\\\n'\\n                                   'probe = \\\"echo probed >> probe-ran.txt\\\"\\\\nprobe_timeout_s = 30')\\n    (root / \\\".gitignore\\\").write_text(\\\"checks-ran.txt\\\\nprobe-ran.txt\\\\n\\\")\\n    commit_all(root, \\\"ignore the counters\\\")\\n    approve_item(root)\\n    assert run_attavo(root, \\\"build\\\", \\\"1\\\").returncode == 0\\n    assert (root / \\\"probe-ran.txt\\\").read_text().count(\\\"probed\\\") == 1\\n    assert (root / \\\"checks-ran.txt\\\").read_text().count(\\\"ran\\\") == 1, \\\"the checks ran before the build, not only at its gate\\\"\\n    texts = [e[\\\"text\\\"] for e in events(root) if e[\\\"kind\\\"] == \\\"gate\\\"]\\n    assert texts[0] == \\\"checking this machine can run the checks\\\", texts\\n    assert texts[1] == \\\"this machine can run the checks\\\", texts\\n\\n\\ndef test_build_without_a_probe_asks_the_old_way_and_says_so_in_the_feed(tmp_path: Path) -> None:\\n    root = tenant(tmp_path, checks='[checks]\\\\ncommand = \\\"echo ran >> checks-ran.txt\\\"')\\n    (root / \\\".gitignore\\\").write_text(\\\"checks-ran.txt\\\\n\\\")\\n    commit_all(root, \\\"ignore the counter\\\")\\n    approve_item(root)\\n    assert run_attavo(root, \\\"build\\\", \\\"1\\\").returncode == 0\\n    assert (root / \\\"checks-ran.txt\\\").read_text().count(\\\"ran\\\") == 2\\n    assert [e[\\\"text\\\"] for e in events(root) if e[\\\"kind\\\"] == \\\"gate\\\"][0] == \\\"checking this machine can run the checks\\\"\\n\\n\\ndef test_a_failing_probe_refuses_the_build_as_an_environment_stop_before_the_executor(tmp_path: Path) -> None:\\n    root = tenant(tmp_path, checks='[checks]\\\\ncommand = \\\"true\\\"\\\\nprobe = \\\"echo no pytest here; exit 3\\\"\\\\nprobe_timeout_s = 30')\\n    approve_item(root)\\n    assert run_attavo(root, \\\"build\\\", \\\"1\\\").returncode == 1\\n    record = build_record(root)\\n    assert (record[\\\"status\\\"], record[\\\"stop\\\"][\\\"class\\\"], record[\\\"stop\\\"][\\\"provenance\\\"]) == (\\n        \\\"refused\\\", \\\"environment\\\", \\\"tenant\\\"), record\\n    assert record[\\\"refusal\\\"] == \\\"[checks].probe exited 3 on the approved tree\\\", record[\\\"refusal\\\"]\\n    assert record[\\\"checks\\\"] == {\\\"command\\\": \\\"echo no pytest here; exit 3\\\", \\\"exit\\\": 3}, record[\\\"checks\\\"]\\n    assert \\\"no pytest here\\\" in record[\\\"stop\\\"][\\\"detail\\\"], record[\\\"stop\\\"]\\n    assert not (root / \\\"built.txt\\\").exists(), \\\"the executor ran\\\"\\n\\n\\ndef test_a_probe_past_its_bound_is_ended_and_refuses_the_build(tmp_path: Path) -> None:\\n    root = tenant(tmp_path, checks='[checks]\\\\ncommand = \\\"true\\\"\\\\nprobe = \\\"sleep 30\\\"\\\\nprobe_timeout_s = 1')\\n    approve_item(root)\\n    started = time.monotonic()\\n    assert run_attavo(root, \\\"build\\\", \\\"1\\\").returncode == 1\\n    assert time.monotonic() - started < 15\\n    record = build_record(root)\\n    assert record[\\\"refusal\\\"] == \\\"[checks].probe did not finish within 1 s\\\", record[\\\"refusal\\\"]\\n    assert record[\\\"stop\\\"][\\\"class\\\"] == \\\"environment\\\", record[\\\"stop\\\"]\\n\\n\\ndef test_the_manifest_schema_requires_a_bound_with_a_probe(tmp_path: Path) -> None:\\n    checks = MANIFEST_SCHEMA[\\\"properties\\\"][\\\"checks\\\"]\\n    jsonschema.validate({\\\"command\\\": \\\"true\\\", \\\"probe\\\": \\\"true\\\", \\\"probe_timeout_s\\\": 5}, checks)\\n    jsonschema.validate({\\\"command\\\": \\\"true\\\"}, checks)\\n    try:\\n        jsonschema.validate({\\\"command\\\": \\\"true\\\", \\\"probe\\\": \\\"true\\\"}, checks)\\n    except jsonschema.ValidationError:\\n        pass\\n    else:\\n        raise AssertionError(\\\"a probe with no bound validated\\\")\\n    jsonschema.validate({\\\"select\\\": \\\"cat\\\", \\\"run\\\": \\\"true\\\", \\\"call_timeout_s\\\": 240},\\n                        MANIFEST_SCHEMA[\\\"properties\\\"][\\\"tests\\\"])\\n\\n\\nSELECTING = ('[tests]\\\\nselect = \\\"sed -n \\\\'s#^src/\\\\\\\\\\\\\\\\(.*\\\\\\\\\\\\\\\\)[.]py$#tests/test_\\\\\\\\\\\\\\\\1.py#p\\\\'\\\"\\\\n'\\n             'run = \\\"sh -c \\\\'cat > selected.txt; cat selected.txt\\\\'\\\"')\\n\\n\\ndef test_attavo_test_runs_what_the_tenant_selects_for_the_items_changes_committed_or_not(tmp_path: Path) -> None:\\n    root = tenant(tmp_path, tests=SELECTING)\\n    (root / \\\".gitignore\\\").write_text(\\\"selected.txt\\\\n\\\")\\n    (root / \\\"src\\\").mkdir()\\n    (root / \\\"src\\\" / \\\"committed.py\\\").write_text(\\\"x = 1\\\\n\\\")\\n    commit_all(root, \\\"a committed change\\\")\\n    (root / \\\"src\\\" / \\\"unstaged.py\\\").write_text(\\\"y = 2\\\\n\\\")\\n    (root / \\\"records\\\" / \\\"1\\\").mkdir(parents=True, exist_ok=True)\\n    (root / \\\"records\\\" / \\\"1\\\" / \\\"note.py\\\").write_text(\\\"\\\")\\n    run = run_attavo(root, \\\"test\\\", \\\"1\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n    assert (root / \\\"selected.txt\\\").read_text().split() == [\\\"tests/test_committed.py\\\", \\\"tests/test_unstaged.py\\\"]\\n    assert \\\"2 selected\\\" in run.stdout, run.stdout\\n\\n\\ndef test_attavo_test_exits_as_the_run_does_and_says_when_nothing_is_selected(tmp_path: Path) -> None:\\n    failing = tenant(tmp_path, tests='[tests]\\\\nselect = \\\"cat\\\"\\\\nrun = \\\"sh -c \\\\'cat >/dev/null; exit 7\\\\'\\\"')\\n    (failing / \\\"anything.txt\\\").write_text(\\\"z\\\\n\\\")\\n    assert run_attavo(failing, \\\"test\\\", \\\"1\\\").returncode == 7\\n    quiet = tenant(tmp_path / \\\"quiet\\\", tests='[tests]\\\\nselect = \\\"true\\\"\\\\nrun = \\\"exit 9\\\"')\\n    (quiet / \\\"anything.txt\\\").write_text(\\\"z\\\\n\\\")\\n    run = run_attavo(quiet, \\\"test\\\", \\\"1\\\")\\n    assert run.returncode == 0 and \\\"no test is selected\\\" in run.stdout, run.stdout + run.stderr\\n\\n\\ndef test_attavo_test_ends_a_run_past_its_bound_with_everything_it_started(tmp_path: Path) -> None:\\n    root = tenant(tmp_path, tests='[tests]\\\\nselect = \\\"cat\\\"\\\\ncall_timeout_s = 1\\\\n'\\n                                  'run = \\\"sh -c \\\\'cat >/dev/null; sleep 30 & echo $! > child.pid; wait\\\\'\\\"')\\n    (root / \\\".gitignore\\\").write_text(\\\"child.pid\\\\n\\\")\\n    (root / \\\"anything.txt\\\").write_text(\\\"z\\\\n\\\")\\n    started = time.monotonic()\\n    run = run_attavo(root, \\\"test\\\", \\\"1\\\")\\n    assert time.monotonic() - started < 15\\n    assert run.returncode == 124, run.stdout + run.stderr\\n    assert \\\"did not finish within 1 s\\\" in run.stdout, run.stdout\\n    child = int((root / \\\"child.pid\\\").read_text())\\n    time.sleep(0.5)\\n    # a process that was ended but not yet reaped still has a pid; its state says Z\\n    state = subprocess.run([\\\"ps\\\", \\\"-o\\\", \\\"stat=\\\", \\\"-p\\\", str(child)], capture_output=True, text=True,\\n                           check=False).stdout.strip()\\n    assert state == \\\"\\\" or state.startswith(\\\"Z\\\"), f\\\"the run's own child outlived the timeout (state {state!r})\\\"\\n\\n\\ndef test_build_hands_the_executor_the_test_command_and_no_checks_command(tmp_path: Path) -> None:\\n    root = tenant(tmp_path, checks='[checks]\\\\ncommand = \\\"true\\\"', tests='[tests]\\\\nselect = \\\"cat\\\"\\\\nrun = \\\"true\\\"\\\\ncall_timeout_s = 240')\\n    (root / \\\"attavo\\\" / \\\"adapters\\\" / \\\"fixture\\\").mkdir(parents=True)\\n    probe = root / \\\"attavo\\\" / \\\"adapters\\\" / \\\"fixture\\\" / \\\"run\\\"\\n    probe.write_text('#!/bin/sh\\\\nenv | grep \\\"^ATTAVO_\\\" | sort > \\\"$PWD/seen-env.txt\\\"\\\\n'\\n                     'echo built > built.txt\\\\ngit add built.txt\\\\ngit commit -q -m built\\\\n'\\n                     'printf \\\\'{\\\"status\\\": \\\"done\\\", \\\"question\\\": null}\\\\\\\\n\\\\'\\\\n')\\n    probe.chmod(0o755)\\n    (root / \\\".gitignore\\\").write_text(\\\"seen-env.txt\\\\n\\\")\\n    commit_all(root, \\\"a tenant-side
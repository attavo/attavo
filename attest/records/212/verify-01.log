ve.py\",),\n+    \"attavo/filing.py\": (\"tests/test_file_findings.py\", \"tests/test_file_stops.py\"),\n+    \"attavo/ledger.py\": (\"tests/test_ledger.py\",),\n+    \"attavo/record_only.py\": (\"tests/test_record_only.py\",),\n+    \"attavo/report.py\": (\"tests/test_report.py\",),\n+    \"attavo/testtool.py\": (\"tests/test_testtool.py\",),\n+    \"attavo/types.py\": (\"tests/test_types_mirror_schemas.py\",),\n+    \"attavo/verify.py\": (\"tests/test_verify.py\", \"tests/test_verify_polls.py\",\n+                         \"tests/test_verify_codex_proof.py\"),\n+    \"action.yml\": (\"tests/test_action_yml.py\",),\n+    \"attavo.toml\": (\"tests/test_self_tenancy.py\", \"tests/test_testtool.py\"),\n+    \"schema/manifest.schema.json\": (\"tests/test_self_tenancy.py\", \"tests/test_record_schemas.py\",\n+                                    \"tests/test_testtool.py\"),\n+    \".attavo/bin/select-tests\": (\"tests/test_self_tenancy.py\", \"tests/test_testtool.py\"),\n+}\n+\n+PREFIX_TESTS: tuple[tuple[str, tuple[str, ...]], ...] = (\n+    (\"adapters/claude-code/\", (\"tests/test_adapters.py\", \"tests/test_adapter_claude_code.py\",\n+                               \"tests/test_executor_conformance.py\")),\n+    (\"adapters/codex/\", (\"tests/test_adapter_codex.py\", \"tests/test_adapters_codex.py\",\n+                         \"tests/test_executor_conformance.py\")),\n+    (\"adapters/\", (\"tests/test_adapters.py\", \"tests/test_executor_conformance.py\")),\n+    (\"schema/\", (\"tests/test_record_schemas.py\", \"tests/test_attest.py\",\n+                 \"tests/test_types_mirror_schemas.py\")),\n+    (\"templates/\", (\"tests/test_approve_template.py\", \"tests/test_coherence_template.py\",\n+                    \"tests/test_spec_gate_template.py\", \"tests/test_template_app_identity.py\",\n+                    \"tests/test_templates_carry_no_repository_urls.py\",\n+                    \"tests/test_self_tenancy.py\")),\n+)\n+\n+\n+def repository_root() -> Path:\n+    return Path(__file__).resolve().parent.parent.parent\n+\n+\n+def is_prose_or_record(path: str) -> bool:\n+    return path.endswith(\".md\") or path == \"LICENSE\" or path.startswith(SILENT_PREFIXES)\n+\n \n-ADAPTER_TESTS = (\"tests/test_adapters.py\", \"tests/test_executor_conformance.py\")\n-SCHEMA_TESTS = (\"tests/test_record_schemas.py\", \"tests/test_attest.py\")\n+def select_one(path: str) -> tuple[str, ...] | None:\n+    \"\"\"The tests for one changed path, () for none, None for a path this\n+    selector does not know.\"\"\"\n+    if is_prose_or_record(path):\n+        return ()\n+    if path.startswith(WHOLE_SUITE_PREFIXES):\n+        return None\n+    if path.startswith(\"tests/test_\") and path.endswith(\".py\") and \"/\" not in path[len(\"tests/\"):]:\n+        return (path,) if (repository_root() / path).is_file() else ()\n+    if path in MODULE_TESTS:\n+        return MODULE_TESTS[path]\n+    for prefix, tests in PREFIX_TESTS:\n+        if path.startswith(prefix):\n+            return tests\n+    return None\n \n \n def select(paths: list[str]) -> list[str]:\n-    tests: list[str] = []\n+    tests: dict[str, None] = {}\n     for path in paths:\n-        if path == \"bin/attavo\":\n-            return [\"tests\"]\n-        if path.startswith(\"adapters/\"):\n-            for t in ADAPTER_TESTS:\n-                if t not in tests:\n-                    tests.append(t)\n-        elif path.startswith(\"schema/\"):\n-            for t in SCHEMA_TESTS:\n-                if t not in tests:\n-                    tests.append(t)\n-    return tests\n+        found = select_one(path)\n+        if found is None:\n+            return [WHOLE_SUITE]\n+        tests.update(dict.fromkeys(found))\n+    return list(tests)\n \n \n def main() -> int:\n-    touched = [line.strip() for line in sys.stdin.read().splitlines() if line.strip()]\n-    for t in select(touched):\n+    changed = [line.strip() for line in sys.stdin.read().splitlines() if line.strip()]\n+    for t in select(changed):\n         print(t)\n     return 0\n \ndiff --git a/README.md b/README.md\nindex 8b95d0c..9261a27 100644\n--- a/README.md\n+++ b/README.md\n@@ -24,7 +24,7 @@ All three run from the tenant root; `N` is read from the branch (`attavo/N-*`) w\n \n ## Build (Phase 2)\n \n-`attavo build N` refuses (exit 1, naming the cause, no record) unless the manifest declares `[executor].build` and `[tests].select` and `[tests].run`, and unless `attavo approval-status` would print `valid`. It invokes the named adapter — `adapters/<name>/run`, resolved first under the tenant's own `attavo/adapters/`, then under this product's `adapters/` — with the spec, the corpus, and the branch. After each return it checks that every path the adapter touched matches a spec claim, then runs the criteria against the tree, the tests `[tests].select` and `[tests].run` name for the touched paths, and — when the manifest declares `[checks].command` — the tenant's own whole-tree check, from the tenant root. `pass` requires every criterion, the test run, and the tenant's checks (if declared) to exit 0; a non-zero exit anywhere iterates, with the failure as feedback, up to a fixed budget. `[checks]` is optional; a tenant that declares none is not refused, unlike `[tests]`. A `question` from the adapter halts the loop at once (exit 3); nothing answers it in Phase 2. Every run writes the next `build-NN.json`, with the adapter's transcript beside it as `build-NN.log`. Nothing dispatches build; it is typed by the operator. The full contract is in the Phase 2 issue.\n+`attavo build N` refuses (exit 1, naming the cause, no record) unless the manifest declares `[executor].build` and `[tests].select` and `[tests].run`, and unless `attavo approval-status` would print `valid`. It invokes the named adapter — `adapters/<name>/run`, resolved first under the tenant's own `attavo/adapters/`, then under this product's `adapters/` — with the spec, the corpus, and the branch. After each return it checks that every path the adapter touched matches a spec claim, then runs the criteria against the tree, the tests `[tests].select` and `[tests].run` name for the touched paths, and — when the manifest declares `[checks].command` — the tenant's own whole-tree check, from the tenant root. `pass` requires every criterion, the test run, and the tenant's checks (if declared) to exit 0; a non-zero exit anywhere iterates, with the failure as feedback, up to a fixed budget. `[checks]` is optional; a tenant that declares none is not refused, unlike `[tests]`. Before the adapter is invoked, `attavo build` asks whether this machine can run the checks at all: of `[checks].probe`, a cheap command run once inside `[checks].probe_timeout_s` (required with it; exit 0 means yes, anything else or the bound is an environment refusal), or, for a tenant that declares no probe, by running `[checks].command` whole (exit 2 means no). The feed says \"checking this machine can run the checks\" before and the answer after. `[checks].command` is what is fast and decisive at the gate; what the forge runs as its own required check need not be run twice. The adapter is given one test command, `attavo test N` (`ATTAVO_TEST_COMMAND`, with `ATTAVO_TEST_TIMEOUT_S` when the tenant declares `[tests].call_timeout_s`), not the checks: it selects, through `[tests].select`, for every path the item has changed since it left the default branch, committed or not (the records directory aside), runs them through `[tests].run`, exits as the run does, and at the bound ends the run with everything it started and exits 124. A selector that maps a path it does not know to nothing hides the tests that would have caught the change; a tenant's selector should send such a path to the whole suite. A `question` from the adapter halts the loop at once (exit 3); nothing answers it in Phase 2. Every run writes the next `build-NN.json`, with the adapter's transcript beside it as `build-NN.log`. Nothing dispatches build; it is typed by the operator. The full contract is in the Phase 2 issue.\n \n ## Layout\n \ndiff --git a/adapters/README.md b/adapters/README.md\nindex bf06683..7148371 100644\n--- a/adapters/README.md\n+++ b/adapters/README.md\n@@ -13,7 +13,8 @@ the tenant's `attavo/adapters/`, then under this product's `adapters/`.\n - `ATTAVO_ITERATION` — the 1-based attempt number within this `attavo build` invocation.\n - `ATTAVO_FEEDBACK` — a file holding the previous iteration's failing criteria, test output, and checks output; empty on the first iteration.\n - `ATTAVO_ADAPTER_CONFIG` — the tenant manifest's `[executor.<adapter-name>]` table, serialized as JSON (`{}` when the tenant declared none). The product does not know what an adapter's settings mean; each adapter documents its own keys on its own `README.md`. **Never put a secret in this table** — it is copied verbatim into `build-NN.json` as `adapter_config`, and a record is not where secrets live.\n-- `ATTAVO_CHECKS_COMMAND` — the tenant's `[checks].command`, unset when the tenant declared no `[checks]` table. The product does not know what it checks; the tenant does. An adapter should tell the executor it is part of done when set, and say nothing about checks when it is not.\n+- `ATTAVO_TEST_COMMAND` — build only: the one test command the executor is given, `attavo test <N>` (issue #212). It runs the tests the tenant's `[tests].select` names for every path the item has changed since it left the default branch, committed or not, through `[tests].run`, and exits as the run does. An adapter tells the executor to run it while working, and not to run the whole test suite or any whole-tree check: the tenant's `[checks].command` is run at the gate after every commit, and a command the executor is named is a command the executor runs (#194's build-01 waited 590 s on the suite inside the executor). The tenant's checks command is not part of the contract.\n+- `ATTAVO_TEST_TIMEOUT_S` — build only, set with `ATTAVO_TEST_COMMAND` when the tenant declares `[tests].call_timeout_s`: the seconds one `attavo test` run is given before it is ended and exits 124. An adapter says so in the same sentence; absent, it says nothing about a bound.\n - `ATTAVO_STAGE` — `\"build\"`, `\"verify\"`, or `\"counsel\"` (issue #100), which invocation this is. An adapter that supports every stage branches on it; one that only builds may ignore it.\n - `ATTAVO_EVENTS` — build and verify only: a file path an adapter may append events to while it runs (issue #26). Absent on a stage that does not set it (counsel does not); an adapter that never checks for it breaks nothing.\n - `ATTAVO_DIFF` — verify only: a file holding the diff since the build's approval.\ndiff --git a/adapters/claude-code/README.md b/adapters/claude-code/README.md\nindex 5ecd11e..fa1a9d5 100644\n--- a/adapters/claude-code/README.md\n+++ b/adapters/claude-code/README.md\n@@ -16,15 +16,18 @@ record.\n - `permission_mode` — default `\"acceptEdits\"`.\n - `allowed_tools` is retired (issue #78): a manifest that still declares `[executor.claude-code].allowed_tools` is refused by name rather than silently accepted or ignored. See below.\n \n-## The tenant's checks\n-\n-`attavo build` already runs `[checks].command` after each commit and feeds\n-a failure back on the next iteration — the executor is not the runner of\n-the tenant's checks. When `ATTAVO_CHECKS_COMMAND` is set (`../README.md`),\n-the instruction says so: \"after you commit, the tenant's checks (`<command>`)\n-are run for you and any failure is returned to you on the next iteration;\n-run only what you need while editing.\" When it is unset, the instruction\n-says nothing about checks.\n+## The tenant's tests\n+\n+`attavo build` runs the tenant's gates after each commit and feeds a\n+failure back on the next iteration — the executor is not the runner of the\n+tenant's checks, and is not told what they are. When `ATTAVO_TEST_COMMAND`\n+is set (`../README.md`), the instruction gives it: \"to run tests while you\n+work, run `<command>`: it runs the tests selected for the files you have\n+changed and stops at `<N>` s. Do not run the whole test suite or any\n+whole-tree check yourself: after you commit, the gates are run for you and\n+any failure is returned to you on the next iteration.\" The \"stops at\" clause\n+is present only when `ATTAVO_TEST_TIMEOUT_S` is set. When\n+`ATTAVO_TEST_COMMAND` is unset, the instruction says nothing about tests.\n \n ## The sandbox is the boundary, not an allowed_tools list\n \ndiff --git a/adapters/claude-code/run b/adapters/claude-code/run\nindex d39c7b5..7139899 100755\n--- a/adapters/claude-code/run\n+++ b/adapters/claude-code/run\n@@ -274,12 +274,16 @@ def build_instruction() -> str:\n         \"without a decision that changes the criteria, do not guess: \"\n         \"answer with status question\")\n \n-    checks_command = os.environ.get(\"ATTAVO_CHECKS_COMMAND\")\n-    if checks_command:\n","exit_code":0,"status":"completed"}}

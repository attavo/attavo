,\"+\",\"+def select(paths: list[str]) -> list[str]:\",\"+    tests: dict[str, None] = {}\",\"+    for path in paths:\",\"+        found = select_one(path)\",\"+        if found is None:\",\"+            return [WHOLE_SUITE]\",\"+        tests.update(dict.fromkeys(found))\",\"+    return list(tests)\",\"+\",\"+\",\" def main() -> int:\",\"-    out: list[str] = []\",\"-    for path in (line.strip() for line in sys.stdin.read().splitlines() if line.strip()):\",\"-        if path.startswith(\\\"attest/\\\") or path.endswith(\\\".md\\\"):\",\"-            continue\",\"-        if path != \\\"attavo/report.py\\\":\",\"-            print(\\\"tests\\\")\",\"-            return 0\",\"-        out.append(\\\"tests/test_report.py\\\")\",\"-    for t in dict.fromkeys(out):\",\"+    changed = [line.strip() for line in sys.stdin.read().splitlines() if line.strip()]\",\"+    for t in select(changed):\",\"         print(t)\",\"     return 0\",\" \"]}],\"originalFile\":\"#!/usr/bin/env python3\\n\\\"\\\"\\\"select-tests, AS A STUB: not the selector and not to be shipped. It knows\\none module and sends everything else that is not prose or this repository's\\nown specs and records to the whole suite. The table of modules and their\\ntests, a test file selecting itself, and the adapters, schema, and templates\\nprefixes are the build's to write. tests/test_testtool.py fails on it.\\\"\\\"\\\"\\nfrom __future__ import annotations\\n\\nimport sys\\n\\n\\ndef main() -> int:\\n    out: list[str] = []\\n    for path in (line.strip() for line in sys.stdin.read().splitlines() if line.strip()):\\n        if path.startswith(\\\"attest/\\\") or path.endswith(\\\".md\\\"):\\n            continue\\n        if path != \\\"attavo/report.py\\\":\\n            print(\\\"tests\\\")\\n            return 0\\n        out.append(\\\"tests/test_report.py\\\")\\n    for t in dict.fromkeys(out):\\n        print(t)\\n    return 0\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    sys.exit(main())\\n\",\"userModi
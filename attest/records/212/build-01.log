{"type":"assistant","message":{"model":"claude-sonnet-5","id":"msg_011CfFjsVG5JGxBXhj5CoxST","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_0112TCvqNjZHBizBPzUJ3C2R","name":"Write","input":{"file_path":"/Users/davidbean/Projects/attavo-worktree-212/.attavo/bin/select-tests","content":"#!/usr/bin/env python3\n\"\"\"select-tests: [tests].select for attavo build/verify/test (issue #103,\nmade fail-safe by issue #212).\n\nReads changed paths on stdin, one per line, and prints test identifiers\non stdout, one per line, for this repository's own test suite:\n\n  - prose (*.md, LICENSE) and this repository's own specs and records\n    (attest/specs/**, attest/records/**) select nothing;\n  - a test file (tests/test_*.py) selects itself, and nothing at all when\n    it no longer exists;\n  - a path in MODULE_TESTS (a module of attavo/, and the few files that\n    are one thing's own) selects the tests written for it, and a prefix in\n    PREFIX_TESTS (adapters/, schema/, templates/) the tests written for\n    that directory;\n  - a path this selector does not know -- a module nobody mapped,\n    bin/attavo, scripts/, tests/helpers.py and the fixtures every test\n    stands on, the fixture adapter every build test invokes -- selects the\n    whole suite (\"tests\", the one path pytest needs to run everything),\n    and one such path is enough to make that the whole answer.\n\nA module that most of the others import (common, records, spec, ...) is\nleft out of MODULE_TESTS on purpose: no table of tests-per-module can know\nwhat it breaks, so it is the whole suite. The forge runs the whole suite\nonce, as the required `test` check, in any case.\n\nUsage: <changed paths> | select-tests\n\"\"\"\nfrom __future__ import annotations\n\nimport sys\nfrom pathlib import Path\n\nROOT = Path(__file__).resolve().parent.parent.parent\n\nWHOLE_SUITE = \"tests\"\n\nSILENT_PREFIXES = (\"attest/specs/\", \"attest/records/\")\n\nWHOLE_SUITE_PREFIXES = (\"adapters/fixture/\",)\n\nMODULE_TESTS: dict[str, tuple[str, ...]] = {\n    \"attavo/attest.py\": (\"tests/test_attest.py\", \"tests/test_attest_time.py\"),\n    \"attavo/build.py\": (\"tests/test_build.py\", \"tests/test_testtool.py\"),\n    \"attavo/cli.py\": (\"tests/test_cli_help.py\", \"tests/test_testtool.py\"),\n    \"attavo/counsel.py\": (\"tests/test_counsel.py\",),\n    \"attavo/doctor.py\": (\"tests/test_doctor.py\", \"tests/test_doctor_sealed.py\",\n                         \"tests/test_proof_five_elsewhere.py\",\n                         \"tests/test_sealed_since_default.py\"),\n    \"attavo/drive.py\": (\"tests/test_drive.py\",),\n    \"attavo/filing.py\": (\"tests/test_file_findings.py\", \"tests/test_file_stops.py\"),\n    \"attavo/ledger.py\": (\"tests/test_ledger.py\",),\n    \"attavo/record_only.py\": (\"tests/test_record_only.py\",),\n    \"attavo/report.py\": (\"tests/test_report.py\",),\n    \"attavo/testtool.py\": (\"tests/test_testtool.py\",),\n    \"attavo/types.py\": (\"tests/test_types_mirror_schemas.py\",),\n    \"attavo/verify.py\": (\"tests/test_verify.py\", \"tests/test_verify_polls.py\",\n                         \"tests/test_verify_codex_proof.py\"),\n    \"action.yml\": (\"tests/test_action_yml.py\",),\n    \"attavo.toml\": (\"tests/test_self_tenancy.py\", \"tests/test_testtool.py\"),\n    \"schema/manifest.schema.json\": (\"tests/test_self_tenancy.py\", \"tests/test_record_schemas.py\",\n                                    \"tests/test_testtool.py\"),\n    \".attavo/bin/select-tests\": (\"tests/test_self_tenancy.py\", \"tests/test_testtool.py\"),\n}\n\nPREFIX_TESTS: tuple[tuple[str, tuple[str, ...]], ...] = (\n    (\"adapters/claude-code/\", (\"tests/test_adapters.py\", \"tests/test_adapter_claude_code.py\",\n                               \"tests/test_executor_conformance.py\")),\n    (\"adapters/codex/\", (\"tests/test_adapter_codex.py\", \"tests/test_adapters_codex.py\",\n                         \"tests/test_executor_conformance.py\")),\n    (\"adapters/\", (\"tests/test_adapters.py\", \"tests/test_executor_conformance.py\")),\n    (\"schema/\", (\"tests/test_record_schemas.py\", \"tests/test_attest.py\",\n                 \"tests/test_types_mirror_schemas.py\")),\n    (\"templates/\", (\"tests/test_approve_template.py\", \"tests/test_coherence_template.py\",\n                    \"tests/test_spec_gate_template.py\", \"tests/test_template_app_identity.py\",\n                    \"tests/test_templates_carry_no_repository_urls.py\",\n                    \"tests/test_self_tenancy.py\")),\n)\n\n\ndef is_prose_or_record(path: str) -> bool:\n    return path.endswith(\".md\") or path == \"LICENSE\" or path.startswith(SILENT_PREFIXES)\n\n\ndef select_one(path: str) -> tuple[str, ...] | None:\n    \"\"\"The tests for one changed path, () for none, None for a path this\n    selector does not know.\"\"\"\n    if is_prose_or_record(path):\n        return ()\n    if path.startswith(WHOLE_SUITE_PREFIXES):\n        return None\n    if path.startswith(\"tests/test_\") and path.endswith(\".py\") and \"/\" not in path[len(\"tests/\"):]:\n        return (path,) if (ROOT / path).is_file() else ()\n    if path in MODULE_TESTS:\n        return MODULE_TESTS[path]\n    for prefix, tests in PREFIX_TESTS:\n        if path.startswith(prefix):\n            return tests\n    return None\n\n\ndef select(paths: list[str]) -> list[str]:\n    tests: dict[str, None] = {}\n    for path in paths:\n        found = select_one(path)\n        if found is None:\n            return [WHOLE_SUITE]\n        tests.update(dict.fromkeys(found))\n    return list(tests)\n\n\ndef main() -> int:\n    changed = [line.strip() for line in sys.stdin.read().splitlines() if line.strip()]\n    for t in select(changed):\n        print(t)\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":5933,"cache_read_input_tokens":94305,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":5933},"output_tokens":8,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"8327c9db-455b-4a76-8736-ba592c30dfef","uuid":"c08c64de-7640-4fef-9ba8-50e86a848624","timestamp":"2026-09-21T01:46:24.266Z","request_id":"req_011CfFjsUipmzUs61WSmZAjp","wire_tool_inputs":{"toolu_0112TCvqNjZHBizBPzUJ3C2R":{"file_path":"/Users/davidbean/Projects/attavo-worktree-212/.attavo/bin/select-tests","content":"#!/usr/bin/env python3\n\"\"\"select-tests: [tests].select for attavo build/verify/test (issue #103,\nmade fail-safe by issue #212).\n\nReads changed paths on stdin, one per line, and prints test identifiers\non stdout, one per line, for this repository's own test suite:\n\n  - prose (*.md, LICENSE) and this repository's own specs and records\n    (attest/specs/**, attest/records/**) select nothing;\n  - a test file (tests/test_*.py) selects itself, and nothing at all when\n    it no longer exists;\n  - a path in MODULE_TESTS (a module of attavo/, and the few files that\n    are one thing's own) selects the tests written for it, and a prefix in\n    PREFIX_TESTS (adapters/, schema/, templates/) the tests written for\n    that directory;\n  - a path this selector does not know -- a module nobody mapped,\n    bin/attavo, scripts/, tests/helpers.py and the fixtures every test\n    stands on, the fixture adapter every build test invokes -- selects the\n    whole suite (\"tests\", the one path pytest needs to run everything),\n    and one such path is enough to make that the whole answer.\n\nA module that most of the others import (common, records, spec, ...) is\nleft out of MODULE_TESTS on purpose: no table of tests-per-module can know\nwhat it breaks, so it is the whole suite. The forge runs the whole suite\nonce, as the required `test` check, in any case.\n\nUsage: <changed paths> | select-tests\n\"\"\"\nfrom __future__ import annotations\n\nimport sys\nfrom pathlib import Path\n\nROOT = Path(__file__).resolve().parent.parent.parent\n\nWHOLE_SUITE = \"tests\"\n\nSILENT_PREFIXES = (\"attest/specs/\", \"attest/records/\")\n\nWHOLE_SUITE_PREFIXES = (\"adapters/fixture/\",)\n\nMODULE_TESTS: dict[str, tuple[str, ...]] = {\n    \"attavo/attest.py\": (\"tests/test_attest.py\", \"tests/test_attest_time.py\"),\n    \"attavo/build.py\": (\"tests/test_build.py\", \"tests/test_testtool.py\"),\n    \"attavo/cli.py\": (\"tests/test_cli_help.py\", \"tests/test_testtool.py\"),\n    \"attavo/counsel.py\": (\"tests/test_counsel.py\",),\n    \"attavo/doctor.py\": (\"tests/test_doctor.py\", \"tests/test_doctor_sealed.py\",\n                         \"tests/test_proof_five_elsewhere.py\",\n                         \"tests/test_sealed_since_default.py\"),\n    \"attavo/drive.py\": (\"tests/test_drive.py\",),\n    \"attavo/filing.py\": (\"tests/test_file_findings.py\", \"tests/test_file_stops.py\"),\n    \"attavo/ledger.py\": (\"tests/test_ledger.py\",),\n    \"attavo/record_only.py\": (\"tests/test_record_only.py\",),\n    \"attavo/report.py\": (\"tests/test_report.py\",),\n    \"attavo/testtool.py\": (\"tests/test_testtool.py\",),\n    \"attavo/types.py\": (\"tests/test_types_mirror_schemas.py\",),\n    \"attavo/verify.py\": (\"tests/test_verify.py\", \"tests/test_verify_polls.py\",\n                         \"tests/test_verify_codex_proof.py\"),\n    \"action.yml\": (\"tests/test_action_yml.py\",),\n    \"attavo.toml\": (\"tests/test_self_tenancy.py\", \"tests/test_testtool.py\"),\n    \"schema/manifest.schema.json\": (\"tests/test_self_tenancy.py\", \"tests/test_record_schemas.py\",\n                                    \"tests/test_testtool.py\"),\n    \".attavo/bin/select-tests\": (\"tests/test_self_tenancy.py\", \"tests/test_testtool.py\"),\n}\n\nPREFIX_TESTS: tuple[tuple[str, tuple[str, ...]], ...] = (\n    (\"adapters/claude-code/\", (\"tests/test_adapters.py\", \"tests/test_adapter_claude_code.py\",\n                               \"tests/test_executor_conformance.py\")),\n    (\"adapters/codex/\", (\"tests/test_adapter_codex.py\", \"tests/test_adapters_codex.py\",\n                         \"tests/test_executor_conformance.py\")),\n    (\"adapters/\", (\"tests/test_adapters.py\", \"tests/test_executor_conformance.py\")),\n    (\"schema/\", (\"tests/test_record_schemas.py\", \"tests/test_attest.py\",\n                 \"tests/test_types_mirror_schemas.py\")),\n    (\"templates/\", (\"tests/test_approve_template.py\", \"tests/test_coherence_template.py\",\n                    \"tests/test_spec_gate_template.py\", \"tests/test_template_app_identity.py\",\n                    \"tests/test_templates_carry_no_repository_urls.py\",\n                    \"tests/test_self_tenancy.py\")),\n)\n\n\ndef is_prose_or_record(path: str) -> bool:\n    return path.endswith(\".md\") or path == \"LICENSE\" or path.startswith(SILENT_PREFIXES)\n\n\ndef select_one(path: str) -> tuple[str, ...] | None:\n    \"\"\"The tests for one changed path, () for none, None for a path this\n    selector does not know.\"\"\"\n    if is_prose_or_record(path):\n        return ()\n    if path.startswith(WHOLE_SUITE_PREFIXES):\n        return None\n    if path.startswith(\"tests/test_\") and path.endswith(\".py\") and \"/\" not in path[len(\"tests/\"):]:\n        return (path,) if (ROOT / path).is_file() else ()\n    if path in MODULE_TESTS:\n        return MODULE_TESTS[path]\n    for prefix, tests in PREFIX_TESTS:\n        if path.startswith(prefix):\n            return tests\n    return None\n\n\ndef select(paths: list[str]) -> list[str]:\n    tests: dict[str, None] = {}\n    for path in paths:\n        found = select_one(path)\n        if found is None:\n            return [WHOLE_SUITE]\n        tests.update(dict.fromkeys(found))\n    return list(tests)\n\n\ndef main() -> int:\n    changed = [line.strip() for line in sys.stdin.read().splitlines() if line.strip()]\n    for t in select(changed):\n        print(t)\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n"}}}

 tests/test_doctor.py::test_one_item_traversed_every_stage --deselect tests/test_doctor.py::test_no_commit_lacks_a_record --deselect tests/test_doctor.py::test_no_stop_lacks_cause --deselect tests/test_doctor.py::test_every_attested_item_is_sealed\",\n    \"exit\": 0\n  },\n  \"tokens\": {\n    \"input\": 2020555,\n    \"output\": 17291\n  },\n  \"cost_usd\": 0.7717308,\n  \"wall_clock_s\": 1007.719,\n  \"status\": \"pass\",\n  \"refusal\": null,\n  \"halted\": null,\n  \"stop\": null,\n  \"record_version\": 7,\n  \"item\": \"158\",\n  \"product_version\": \"v0.25.0-39-g5525019\",\n  \"product_pin\": \"v0.25.0\"\n}\ndiff --git a/.attavo/bin/forge-attestation b/.attavo/bin/forge-attestation\nnew file mode 100755\nindex 0000000..46fce25\n--- /dev/null\n+++ b/.attavo/bin/forge-attestation\n@@ -0,0 +1,25 @@\n+#!/bin/sh\n+# forge-attestation: [forge].attestation_command for attavo doctor's fifth\n+# proof (issue #158).\n+#\n+# Reads a merge commit sha on stdin. actions/attest@v2, in\n+# .github/workflows/attavo-coherence.yml, signs the merge's attestation\n+# statement over a synthetic subject: the sha256 digest of the merge\n+# sha's own text (deterministic and reproducible from the sha alone, since\n+# the statement is sealed before the artifact -- the merge -- has landed\n+# anywhere to be hashed itself). This script re-derives that same digest\n+# and reads it back from the forge's attestation store, printing the\n+# statement's predicate payload as JSON on exit 0. It prints nothing and\n+# exits non-zero when the store holds no attestation for that digest, or\n+# the sha is empty, or `gh` cannot resolve this checkout's repository.\n+#\n+# Usage: read sha | forge-attestation\n+# Requires: `gh`, authenticated, run inside this repository's checkout.\n+set -e\n+read -r sha\n+test -n \"$sha\" || exit 2\n+digest=$(printf '%s' \"$sha\" | shasum -a 256 | cut -d ' ' -f 1)\n+repo=$(gh repo view --json nameWithOwner --jq .nameWithOwner 2>/dev/null) || exit 2\n+payload=$(gh api \"repos/$repo/attestations/sha256:$digest\" --jq '.attestations[0].bundle.dsseEnvelope.payload' 2>/dev/null) || exit 1\n+test -n \"$payload\" && test \"$payload\" != null || exit 1\n+printf '%s' \"$payload\" | base64 -d\ndiff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml\nindex 9c84867..2666220 100644\n--- a/.github/workflows/ci.yml\n+++ b/.github/workflows/ci.yml\n@@ -20,10 +20,11 @@ jobs:\n           --deselect tests/test_doctor.py::test_one_item_traversed_every_stage\n           --deselect tests/test_doctor.py::test_no_commit_lacks_a_record\n           --deselect tests/test_doctor.py::test_no_stop_lacks_cause\n+          --deselect tests/test_doctor.py::test_every_attested_item_is_sealed\n \n   # Since #103, this repository is Attavo's own second tenant (attavo.toml\n-  # at the root) and the doctor's four proofs run for real, not under\n-  # || true. #106's first item merged (fdd1981, v0.18.0), so the four\n+  # at the root) and the doctor's five proofs run for real, not under\n+  # || true. #106's first item merged (fdd1981, v0.18.0), so the five\n   # proofs hold on main and this job reports on pull requests and merge\n   # groups too -- where a refusal is cheap. It does not report on a\n   # branch push: a branch's own boundary commits precede their records,\n@@ -31,6 +32,9 @@ jobs:\n   doctor:\n     if: github.event_name == 'pull_request' || github.event_name == 'merge_group' || github.ref == 'refs/heads/main'\n     runs-on: ubuntu-latest\n+    permissions:\n+      contents: read\n+      attestations: read\n     steps:\n       - uses: actions/checkout@v4\n         with:\n@@ -39,9 +43,11 @@ jobs:\n         with:\n           python-version: \"3.11\"\n       - run: pip install pytest jsonschema\n-      - name: doctor's four proofs\n-        run: python3 -m pytest tests/test_doctor.py -q -k \"every_gate_rejects or one_item_traversed_every_stage or no_commit_lacks_a_record or no_stop_lacks_cause\"\n+      - name: doctor's five proofs\n+        run: python3 -m pytest tests/test_doctor.py -q -k \"every_gate_rejects or one_item_traversed_every_stage or no_commit_lacks_a_record or no_stop_lacks_cause or every_attested_item_is_sealed\"\n       - run: python3 bin/attavo doctor .\n+        env:\n+          GH_TOKEN: ${{ github.token }}\n \n   action-self-check:\n     runs-on: ubuntu-latest\ndiff --git a/attavo.toml b/attavo.toml\nindex 25f2063..cba936d 100644\n--- a/attavo.toml\n+++ b/attavo.toml\n@@ -6,6 +6,8 @@ version = \"v0.25.0\"\n [forge]\n checks_command = \"python3 .attavo/bin/forge-checks\"\n file_issue_command = \"python3 .attavo/bin/file-issue\"\n+attestation_command = \"sh .attavo/bin/forge-attestation\"\n+sealed_since = \"83fcbc6863fdb65956b77768c66c2103d221521b\"\n \n [executor]\n build = \"claude-code\"\n@@ -33,7 +35,7 @@ retires = [\n \n [tests]\n select = \"python3 .attavo/bin/select-tests\"\n-run = \"xargs -r python3 -m pytest -q --deselect tests/test_doctor.py::test_every_gate_rejects --deselect tests/test_doctor.py::test_one_item_traversed_every_stage --deselect tests/test_doctor.py::test_no_commit_lacks_a_record --deselect tests/test_doctor.py::test_no_stop_lacks_cause\"\n+run = \"xargs -r python3 -m pytest -q --deselect tests/test_doctor.py::test_every_gate_rejects --deselect tests/test_doctor.py::test_one_item_traversed_every_stage --deselect tests/test_doctor.py::test_no_commit_lacks_a_record --deselect tests/test_doctor.py::test_no_stop_lacks_cause --deselect tests/test_doctor.py::test_every_attested_item_is_sealed\"\n \n [paths]\n specs = \"attest/specs\"\n@@ -45,4 +47,4 @@ rejections = \"attest/rejections\"\n approvers = [\"dbean10\"]\n \n [checks]\n-command = \"python3 -m pytest tests -q --deselect tests/test_doctor.py::test_every_gate_rejects --deselect tests/test_doctor.py::test_one_item_traversed_every_stage --deselect tests/test_doctor.py::test_no_commit_lacks_a_record --deselect tests/test_doctor.py::test_no_stop_lacks_cause\"\n+command = \"python3 -m pytest tests -q --deselect tests
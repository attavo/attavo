{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1080,1205p' bin/attavo; sed -n '1,150p' tests/test_doctor_sealed.py; sed -n '40,85p' tests/test_doctor.py; sed -n '70,110p' schema/manifest.schema.json; git show --stat --oneline e45ed5e && git show --format=fuller --no-ext-diff e45ed5e -- bin/attavo tests/test_doctor_sealed.py .attavo/bin/forge-attestation attavo.toml .github/workflows/ci.yml schema/manifest.schema.json tests/test_doctor.py tests/test_record_schemas.py | sed -n '1,500p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1080,1205p' bin/attavo; sed -n '1,150p' tests/test_doctor_sealed.py; sed -n '40,85p' tests/test_doctor.py; sed -n '70,110p' schema/manifest.schema.json; git show --stat --oneline e45ed5e && git show --format=fuller --no-ext-diff e45ed5e -- bin/attavo tests/test_doctor_sealed.py .attavo/bin/forge-attestation attavo.toml .github/workflows/ci.yml schema/manifest.schema.json tests/test_doctor.py tests/test_record_schemas.py | sed -n '1,500p'\"","aggregated_output":"        for n, rec in sorted(parse_attempts(item_dir, \"spec\").items()):\n            if rec.get(\"status\") != \"refused\":\n                continue\n            checked += 1\n            name = f\"spec-{n:02d}\"\n            stop = gate_stop(rec.get(\"refusal\"))\n            cls, provenance = stop[\"class\"], stop[\"provenance\"]\n            if cls not in STOP_CLASSES:\n                problems.append(f\"item {item_dir.name} {name} stop.class {cls!r} names \"\n                                f\"no enumerated class\")\n                continue\n            if provenance not in STOP_PROVENANCES:\n                problems.append(f\"item {item_dir.name} {name} stop.provenance \"\n                                f\"{provenance!r} names no enumerated provenance\")\n                continue\n            if not stop.get(\"detail\"):\n                problems.append(f\"item {item_dir.name} {name} is a gate stop with no cause\")\n\n    older_note = f\"{older} record(s) before stop was recorded\"\n    if problems:\n        return p.fail(\"; \".join(problems), older_records=older)\n    return p.hold(f\"{checked} checked ({older_note})\" if checked == 0\n                 else f\"{checked} non-pass record(s) carry stop with a cause ({older_note})\",\n                 older_records=older)\n\n\ndef attestation_command(m: dict) -> str | None:\n    \"\"\"[forge].attestation_command: the tenant's own read of the store,\n    given a merge sha on stdin, printing the statement as JSON on exit 0\n    and nothing on a non-zero exit. Absent is not passing (issue #158:\n    the doctor said done while #106, #148, #153 had no statement in the\n    store at all -- there was no key to read one through).\"\"\"\n    cmd = (m.get(\"forge\") or {}).get(\"attestation_command\")\n    return cmd if isinstance(cmd, str) and cmd.strip() else None\n\n\ndef statement_for(root: Path, cmd: str, merge_sha: str) -> dict | None:\n    \"\"\"The statement the forge holds for merge_sha, or None when the\n    command exits non-zero or prints anything but a JSON object.\"\"\"\n    run = subprocess.run(cmd, shell=True, cwd=str(root), input=merge_sha + \"\\n\",\n                         capture_output=True, text=True, check=False)\n    if run.returncode != 0:\n        return None\n    try:\n        parsed = json.loads(run.stdout)\n    except ValueError:\n        return None\n    return parsed if isinstance(parsed, dict) else None\n\n\ndef _is_ancestor(root: Path, earlier: str, later: str) -> bool:\n    run = subprocess.run([\"git\", \"-C\", str(root), \"merge-base\", \"--is-ancestor\", earlier, later],\n                         capture_output=True, check=False)\n    return run.returncode == 0\n\n\ndef proof_every_attested_item_is_sealed(root: Path, m: dict | None) -> Proof:\n    p = Proof(\"every-attested-item-is-sealed\", \"every attested item has its statement in the store\")\n    if m is None:\n        return p.fail(f\"no {MANIFEST} at {root}; no records directory is declared\")\n    cmd = attestation_command(m)\n    if cmd is None:\n        return p.fail(\"no [forge].attestation_command in the manifest; the store cannot be read\")\n    records_rel = m.get(\"paths\", {}).get(\"records\", \"\")\n    records_dir = root / records_rel\n    if not records_dir.is_dir():\n        return p.fail(f\"no records directory under {records_dir}\")\n    items = load_records(records_dir)\n    complete = [item for item, stages in sorted(items.items()) if all(s in stages for s in STAGES)]\n\n    # [forge].sealed_since: merges at or before this sha predate the\n    # tenant's merge queue -- the self-tenant's own #106, #148, #153 were\n    # merged direct, with no merge_group run to seal them. They are\n    # named, never failed, the same window convention proof three keeps\n    # for commits before the manifest's own install.\n    since = (m.get(\"forge\") or {}).get(\"sealed_since\")\n    sealed: list[str] = []\n    before_window: list[str] = []\n    unsealed: list[str] = []\n    reasons: list[str] = []\n    for item in complete:\n        merge_sha = merge_introducing_records(root, records_rel, item, STAGES)\n        if merge_sha is None:\n            continue\n        if isinstance(since, str) and since.strip() and _is_ancestor(root, merge_sha, since):\n            before_window.append(item)\n        elif statement_for(root, cmd, merge_sha) is not None:\n            sealed.append(item)\n        else:\n            unsealed.append(item)\n            reasons.append(f\"item {item} merged at {merge_sha[:12]} has no statement in the store\")\n    if reasons:\n        return p.fail(\"; \".join(reasons), sealed=sealed, before_window=before_window, unsealed=unsealed)\n    return p.hold(f\"{len(sealed)} merged item(s) sealed, {len(before_window)} before the window\",\n                 sealed=sealed, before_window=before_window, unsealed=unsealed)\n\n\ndef doctor(root: Path) -> list[Proof]:\n    m = read_manifest(root)\n    return [proof_every_gate_rejects(root, m),\n            proof_one_item_every_stage(root, m),\n            proof_no_commit_lacks_record(root, m),\n            proof_no_stop_lacks_cause(root, m),\n            proof_every_attested_item_is_sealed(root, m)]\n\n\ndef cmd_doctor(argv: list[str]) -> int:\n    as_json = \"--json\" in argv\n    args = [a for a in argv if a != \"--json\"]\n    root = Path(args[0] if args else \".\").resolve()\n    proofs = doctor(root)\n    if as_json:\n        print(json.dumps({\"root\": str(root), \"done\": all(p.holds for p in proofs),\n                          \"proofs\": [p.as_dict() for p in proofs]}, indent=2))\n    else:\n        for i, p in enumerate(proofs, 1):\n            print(f\"proof {i} {p.key}: {'HOLDS' if p.holds else 'FAILS'}: {p.reason}\")\n        print(\"doctor: done\" if all(p.holds for p in proofs)\n              else f\"doctor: not done ({sum(not p.holds for p in proofs)} of \"\n                   f\"{len(proofs)} proofs fail)\")\n    return 0 if all(p.holds for p in proofs) else 1\n\n\n# --- the spec contract ---\n\ndef parse_spec(spec_md: Path) -> tuple[dict | None, str | None]:\n\"\"\"The doctor's fifth proof: every attested item has its statement in the\nstore (issue #158). This repository's own #106, #148, #153 were merged\ndirect, with no merge_group run and so no statement, and the doctor said\ndone anyway -- proof two held on the four stage records with the chain\nheld, never asking whether the merge was sealed.\n\nRun: python3 -m pytest tests -q\n\"\"\"\nimport json\nimport subprocess\nfrom pathlib import Path\n\nROOT = Path(__file__).resolve().parent.parent\nATTAVO = ROOT / \"bin\" / \"attavo\"\n\nFAKE_ATTEST = (\n    '#!/bin/sh\\nread sha\\ngrep -qx \"$sha\" sealed.txt && printf %s '\n    '\"{\\\\\"_type\\\\\": \\\\\"https://in-toto.io/Statement/v1\\\\\"}\"\\n'\n)\n\n\ndef _git(root: Path, *args: str) -> str:\n    return subprocess.run([\"git\", \"-C\", str(root), *args], capture_output=True, text=True,\n                          check=True).stdout.strip()\n\n\ndef _tenant_with_two_merged_items(tmp_path: Path) -> tuple[Path, str, str]:\n    root = tmp_path / \"sealed\"\n    root.mkdir()\n    subprocess.run([\"git\", \"init\", \"-q\", \"-b\", \"main\", \".\"], cwd=root, check=True)\n    _git(root, \"config\", \"user.email\", \"doctor@attavo.invalid\")\n    _git(root, \"config\", \"user.name\", \"doctor fixture\")\n    (root / \"attavo.toml\").write_text(\n        '[paths]\\nrecords = \"records\"\\n\\n[forge]\\nattestation_command = \"sh ./fake-attest\"\\n')\n    (root / \"fake-attest\").write_text(FAKE_ATTEST)\n    (root / \"sealed.txt\").write_text(\"\")\n    _git(root, \"add\", \".\")\n    _git(root, \"commit\", \"-q\", \"-m\", \"install\")\n    merges = []\n    for item in (\"1\", \"2\"):\n        _git(root, \"checkout\", \"-q\", \"-b\", f\"attavo/{item}-x\")\n        (root / \"records\" / item).mkdir(parents=True)\n        for stage in (\"spec\", \"approval\", \"build\", \"verify\"):\n            (root / \"records\" / item / f\"{stage}-01.json\").write_text('{\"status\": \"pass\"}')\n            _git(root, \"add\", \"records\")\n            _git(root, \"commit\", \"-q\", \"-m\", f\"{stage} record for item {item}\")\n        _git(root, \"checkout\", \"-q\", \"main\")\n        _git(root, \"merge\", \"-q\", \"--no-ff\", \"-m\", f\"Merge branch 'attavo/{item}-x'\", f\"attavo/{item}-x\")\n        merges.append(_git(root, \"rev-parse\", \"HEAD\"))\n    return root, merges[0], merges[1]\n\n\ndef _proof(root: Path) -> dict:\n    run = subprocess.run([\"python3\", str(ATTAVO), \"doctor\", \"--json\", str(root)],\n                         capture_output=True, text=True, check=False)\n    proofs = json.loads(run.stdout)[\"proofs\"]\n    return [p for p in proofs if p[\"proof\"] == \"every-attested-item-is-sealed\"][0]\n\n\ndef test_doctor_proof_six_fails_on_an_unsealed_merge(tmp_path):\n    root, m1, m2 = _tenant_with_two_merged_items(tmp_path)\n    (root / \"sealed.txt\").write_text(m1 + \"\\n\")\n    p = _proof(root)\n    assert not p[\"holds\"]\n    assert \"item 2\" in p[\"reason\"] and m2[:12] in p[\"reason\"]\n    assert p[\"sealed\"] == [\"1\"] and p[\"unsealed\"] == [\"2\"]\n\n\ndef test_doctor_proof_six_holds_when_every_merge_is_sealed(tmp_path):\n    root, m1, m2 = _tenant_with_two_merged_items(tmp_path)\n    (root / \"sealed.txt\").write_text(m1 + \"\\n\" + m2 + \"\\n\")\n    p = _proof(root)\n    assert p[\"holds\"] and p[\"sealed\"] == [\"1\", \"2\"]\n\n\ndef test_doctor_proof_six_names_a_merge_before_the_window_without_failing(tmp_path):\n    root, m1, m2 = _tenant_with_two_merged_items(tmp_path)\n    (root / \"sealed.txt\").write_text(m2 + \"\\n\")\n    (root / \"attavo.toml\").write_text(\n        '[paths]\\nrecords = \"records\"\\n\\n[forge]\\nattestation_command = \"sh ./fake-attest\"\\n'\n        f'sealed_since = \"{m1}\"\\n')\n    p = _proof(root)\n    assert p[\"holds\"] and p[\"before_window\"] == [\"1\"] and p[\"sealed\"] == [\"2\"]\n\n\ndef test_doctor_proof_six_fails_without_an_attestation_command(tmp_path):\n    root = tmp_path / \"bare\"\n    root.mkdir()\n    subprocess.run([\"git\", \"init\", \"-q\", \"-b\", \"main\", \".\"], cwd=root, check=True)\n    (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n')\n    (root / \"records\").mkdir()\n    p = _proof(root)\n    assert not p[\"holds\"] and \"attestation_command\" in p[\"reason\"]\ndef test_one_item_traversed_every_stage():\n    \"\"\"Proof 2. One work item carries a record for spec, approval, build,\n    verify, and attestation, every one written by a script.\"\"\"\n    p = run_doctor(ROOT)[\"one-item-every-stage\"]\n    assert p[\"holds\"], p[\"reason\"]\n\n\ndef test_no_commit_lacks_a_record():\n    \"\"\"Proof 3. Every commit on the default branch after the manifest was\n    introduced is named by a record's sha or commits list.\"\"\"\n    p = run_doctor(ROOT)[\"no-commit-lacks-record\"]\n    assert p[\"holds\"], p[\"reason\"]\n\n\ndef test_no_stop_lacks_cause():\n    \"\"\"Proof 4, issue #94. Every non-pass build or verify record at\n    record_version 3 or later carries a stop naming its class and cause.\"\"\"\n    p = run_doctor(ROOT)[\"no-stop-lacks-cause\"]\n    assert p[\"holds\"], p[\"reason\"]\n\n\ndef test_every_attested_item_is_sealed():\n    \"\"\"Proof 5, issue #158. Every merged, fully-staged item has a\n    statement in the forge's attestation store for its merge commit --\n    #106, #148, #153 predate [forge].sealed_since and are named before the\n    window instead.\"\"\"\n    p = run_doctor(ROOT)[\"every-attested-item-is-sealed\"]\n    assert p[\"holds\"], p[\"reason\"]\n\n\ndef test_record_loader_uses_highest_attempt_number(tmp_path):\n    \"\"\"Acceptance 2a. <stage>-NN.json files are one stage's attempts; the\n    doctor treats the highest NN as latest, and STAGES is unchanged.\n\n    spec-01.json names a commit that isn't on the branch at all; spec-02.json\n    names the real code commit. Proof 3 holds only if the loader reads\n    spec-02, not spec-01 -- i.e. only if it picks the highest attempt.\n    \"\"\"\n    root = tmp_path / \"attempts\"\n    root.mkdir()\n    (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n')\n    init_repo(root, \"install\")\n\n    (root / \"src.txt\").write_text(\"code\\n\")\n    commit_all(root, \"code change\")\n    code_sha = subprocess.run([\"git\", \"-C\", str(root), \"rev-parse\", \"HEAD\"],\n        \"command\": {\n          \"type\": \"string\",\n          \"description\": \"The tenant's whole-tree check, run from the tenant root.\",\n          \"minLength\": 1\n        }\n      }\n    },\n    \"forge\": {\n      \"type\": \"object\",\n      \"description\": \"The tenant's own commit-status and issue-tracking reads. The product names no vendor: both keys are commands the tenant supplies. Optional; attavo verify refuses without checks_command, and attavo file-findings refuses without file_issue_command, but neither key requires the other.\",\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"checks_command\": {\n          \"type\": \"string\",\n          \"description\": \"Takes a full commit sha on argv; prints one line per check as \\\"<name> <conclusion>\\\". attavo verify runs it on the item's latest build record's sha before calling any adapter.\",\n          \"minLength\": 1\n        },\n        \"file_issue_command\": {\n          \"type\": \"string\",\n          \"description\": \"Reads one finding as JSON on stdin and files it as a tenant issue. attavo file-findings runs it once per finding in the item's latest verify record.\",\n          \"minLength\": 1\n        },\n        \"attestation_command\": {\n          \"type\": \"string\",\n          \"description\": \"Reads a merge commit sha on stdin and prints that merge's attestation statement as JSON on exit 0; nothing on a non-zero exit. The doctor's fifth proof runs it once per merged, fully-staged item to require a statement in the store.\",\n          \"minLength\": 1\n        },\n        \"sealed_since\": {\n          \"type\": \"string\",\n          \"description\": \"A commit sha. A merge at or before it predates the tenant's merge queue and is named by the doctor's fifth proof as before the window rather than failed.\",\n          \"minLength\": 7\n        }\n      }\n    },\n    \"spec\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\"boundary\"],\n      \"properties\": {\n        \"boundary\": {\n          \"type\": \"object\",\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-fPqZAcaL' (errno=Operation not permitted)\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-tqDedAJB' (errno=Operation not permitted)\ne45ed5e attavo: proof five, every attested item is sealed (#158)\n .attavo/bin/forge-attestation | 25 ++++++++++++\n .github/workflows/ci.yml      | 14 +++++--\n attavo.toml                   |  6 ++-\n bin/attavo                    | 83 +++++++++++++++++++++++++++++++++++++-\n schema/manifest.schema.json   | 10 +++++\n tests/test_doctor.py          | 13 +++++-\n tests/test_doctor_sealed.py   | 93 +++++++++++++++++++++++++++++++++++++++++++\n tests/test_record_schemas.py  | 11 ++---\n 8 files changed, 240 insertions(+), 15 deletions(-)\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-nVmlf4CB' (errno=Operation not permitted)\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-dDmbuErx' (errno=Operation not permitted)\ncommit e45ed5e097c6c894e69e3cfa7033f78dce13b20f\nAuthor:     attavo executor (claude-code) <executor+claude-code@attavo.invalid>\nAuthorDate: Thu Sep 17 14:56:54 2026 -0600\nCommit:     attavo executor (claude-code) <executor+claude-code@attavo.invalid>\nCommitDate: Thu Sep 17 14:56:54 2026 -0600\n\n    attavo: proof five, every attested item is sealed (#158)\n    \n    The doctor's fifth proof reads [forge].attestation_command for a merge\n    commit's statement in the forge's attestation store, so a chain that\n    holds on its four stage records but was never sealed -- #106, #148,\n    #153, merged direct with no merge_group run -- fails instead of\n    reporting done. sealed_since names the commit before which this\n    tenant's own merges predate the merge queue; they are reported as\n    before the window rather than failed.\n    \n    forge-attestation re-derives the merge sha's synthetic subject digest\n    and reads it back via `gh api`; the doctor checks sealed_since before\n    calling it, so a merge already known to predate the window costs no\n    network round trip.\n    \n    Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>\n\ndiff --git a/.attavo/bin/forge-attestation b/.attavo/bin/forge-attestation\nnew file mode 100755\nindex 0000000..46fce25\n--- /dev/null\n+++ b/.attavo/bin/forge-attestation\n@@ -0,0 +1,25 @@\n+#!/bin/sh\n+# forge-attestation: [forge].attestation_command for attavo doctor's fifth\n+# proof (issue #158).\n+#\n+# Reads a merge commit sha on stdin. actions/attest@v2, in\n+# .github/workflows/attavo-coherence.yml, signs the merge's attestation\n+# statement over a synthetic subject: the sha256 digest of the merge\n+# sha's own text (deterministic and reproducible from the sha alone, since\n+# the statement is sealed before the artifact -- the merge -- has landed\n+# anywhere to be hashed itself). This script re-derives that same digest\n+# and reads it back from the forge's attestation store, printing the\n+# statement's predicate payload as JSON on exit 0. It prints nothing and\n+# exits non-zero when the store holds no attestation for that digest, or\n+# the sha is empty, or `gh` cannot resolve this checkout's repository.\n+#\n+# Usage: read sha | forge-attestation\n+# Requires: `gh`, authenticated, run inside this repository's checkout.\n+set -e\n+read -r sha\n+test -n \"$sha\" || exit 2\n+digest=$(printf '%s' \"$sha\" | shasum -a 256 | cut -d ' ' -f 1)\n+repo=$(gh repo view --json nameWithOwner --jq .nameWithOwner 2>/dev/null) || exit 2\n+payload=$(gh api \"repos/$repo/attestations/sha256:$digest\" --jq '.attestations[0].bundle.dsseEnvelope.payload' 2>/dev/null) || exit 1\n+test -n \"$payload\" && test \"$payload\" != null || exit 1\n+printf '%s' \"$payload\" | base64 -d\ndiff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml\nindex 9c84867..2666220 100644\n--- a/.github/workflows/ci.yml\n+++ b/.github/workflows/ci.yml\n@@ -20,10 +20,11 @@ jobs:\n           --deselect tests/test_doctor.py::test_one_item_traversed_every_stage\n           --deselect tests/test_doctor.py::test_no_commit_lacks_a_record\n           --deselect tests/test_doctor.py::test_no_stop_lacks_cause\n+          --deselect tests/test_doctor.py::test_every_attested_item_is_sealed\n \n   # Since #103, this repository is Attavo's own second tenant (attavo.toml\n-  # at the root) and the doctor's four proofs run for real, not under\n-  # || true. #106's first item merged (fdd1981, v0.18.0), so the four\n+  # at the root) and the doctor's five proofs run for real, not under\n+  # || true. #106's first item merged (fdd1981, v0.18.0), so the five\n   # proofs hold on main and this job reports on pull requests and merge\n   # groups too -- where a refusal is cheap. It does not report on a\n   # branch push: a branch's own boundary commits precede their records,\n@@ -31,6 +32,9 @@ jobs:\n   doctor:\n     if: github.event_name == 'pull_request' || github.event_name == 'merge_group' || github.ref == 'refs/heads/main'\n     runs-on: ubuntu-latest\n+    permissions:\n+      contents: read\n+      attestations: read\n     steps:\n       - uses: actions/checkout@v4\n         with:\n@@ -39,9 +43,11 @@ jobs:\n         with:\n           python-version: \"3.11\"\n       - run: pip install pytest jsonschema\n-      - name: doctor's four proofs\n-        run: python3 -m pytest tests/test_doctor.py -q -k \"every_gate_rejects or one_item_traversed_every_stage or no_commit_lacks_a_record or no_stop_lacks_cause\"\n+      - name: doctor's five proofs\n+        run: python3 -m pytest tests/test_doctor.py -q -k \"every_gate_rejects or one_item_traversed_every_stage or no_commit_lacks_a_record or no_stop_lacks_cause or every_attested_item_is_sealed\"\n       - run: python3 bin/attavo doctor .\n+        env:\n+          GH_TOKEN: ${{ github.token }}\n \n   action-self-check:\n     runs-on: ubuntu-latest\ndiff --git a/attavo.toml b/attavo.toml\nindex 25f2063..cba936d 100644\n--- a/attavo.toml\n+++ b/attavo.toml\n@@ -6,6 +6,8 @@ version = \"v0.25.0\"\n [forge]\n checks_command = \"python3 .attavo/bin/forge-checks\"\n file_issue_command = \"python3 .attavo/bin/file-issue\"\n+attestation_command = \"sh .attavo/bin/forge-attestation\"\n+sealed_since = \"83fcbc6863fdb65956b77768c66c2103d221521b\"\n \n [executor]\n build = \"claude-code\"\n@@ -33,7 +35,7 @@ retires = [\n \n [tests]\n select = \"python3 .attavo/bin/select-tests\"\n-run = \"xargs -r python3 -m pytest -q --deselect tests/test_doctor.py::test_every_gate_rejects --deselect tests/test_doctor.py::test_one_item_traversed_every_stage --deselect tests/test_doctor.py::test_no_commit_lacks_a_record --deselect tests/test_doctor.py::test_no_stop_lacks_cause\"\n+run = \"xargs -r python3 -m pytest -q --deselect tests/test_doctor.py::test_every_gate_rejects --deselect tests/test_doctor.py::test_one_item_traversed_every_stage --deselect tests/test_doctor.py::test_no_commit_lacks_a_record --deselect tests/test_doctor.py::test_no_stop_lacks_cause --deselect tests/test_doctor.py::test_every_attested_item_is_sealed\"\n \n [paths]\n specs = \"attest/specs\"\n@@ -45,4 +47,4 @@ rejections = \"attest/rejections\"\n approvers = [\"dbean10\"]\n \n [checks]\n-command = \"python3 -m pytest tests -q --deselect tests/test_doctor.py::test_every_gate_rejects --deselect tests/test_doctor.py::test_one_item_traversed_every_stage --deselect tests/test_doctor.py::test_no_commit_lacks_a_record --deselect tests/test_doctor.py::test_no_stop_lacks_cause\"\n+command = \"python3 -m pytest tests -q --deselect tests/test_doctor.py::test_every_gate_rejects --deselect tests/test_doctor.py::test_one_item_traversed_every_stage --deselect tests/test_doctor.py::test_no_commit_lacks_a_record --deselect tests/test_doctor.py::test_no_stop_lacks_cause --deselect tests/test_doctor.py::test_every_attested_item_is_sealed\"\ndiff --git a/bin/attavo b/bin/attavo\nindex b0104e4..052dde1 100755\n--- a/bin/attavo\n+++ b/bin/attavo\n@@ -16,7 +16,7 @@\n     attavo ledger [N] [--json]\n     attavo stops [N] [--json]\n \n-The doctor is the definition of done. It asserts four proofs against a\n+The doctor is the definition of done. It asserts five proofs against a\n tenant root and exits 1 until every proof holds:\n \n   1. every-gate-rejects      every gate in the manifest's [gates] table,\n@@ -42,6 +42,13 @@ tenant root and exits 1 until every proof holds:\n                              adapter exit ended the log -- records before\n                              record_version 3 are counted and reported,\n                              never refused\n+  5. every-attested-item-is-sealed\n+                             every merged item that carries a record for\n+                             every stage has a statement in the forge's\n+                             attestation store for its merge commit, read\n+                             through [forge].attestation_command -- a\n+                             merge at or before [forge].sealed_since is\n+                             named as before the window instead of failed\n \n Nothing in doctor is a gate. The doctor reads; it never writes and it never\n blocks a merge by itself. It is what CI runs to say whether the product\n@@ -1096,12 +1103,84 @@ def proof_no_stop_lacks_cause(root: Path, m: dict | None) -> Proof:\n                  older_records=older)\n \n \n+def attestation_command(m: dict) -> str | None:\n+    \"\"\"[forge].attestation_command: the tenant's own read of the store,\n+    given a merge sha on stdin, printing the statement as JSON on exit 0\n+    and nothing on a non-zero exit. Absent is not passing (issue #158:\n+    the doctor said done while #106, #148, #153 had no statement in the\n+    store at all -- there was no key to read one through).\"\"\"\n+    cmd = (m.get(\"forge\") or {}).get(\"attestation_command\")\n+    return cmd if isinstance(cmd, str) and cmd.strip() else None\n+\n+\n+def statement_for(root: Path, cmd: str, merge_sha: str) -> dict | None:\n+    \"\"\"The statement the forge holds for merge_sha, or None when the\n+    command exits non-zero or prints anything but a JSON object.\"\"\"\n+    run = subprocess.run(cmd, shell=True, cwd=str(root), input=merge_sha + \"\\n\",\n+                         capture_output=True, text=True, check=False)\n+    if run.returncode != 0:\n+        return None\n+    try:\n+        parsed = json.loads(run.stdout)\n+    except ValueError:\n+        return None\n+    return parsed if isinstance(parsed, dict) else None\n+\n+\n+def _is_ancestor(root: Path, earlier: str, later: str) -> bool:\n+    run = subprocess.run([\"git\", \"-C\", str(root), \"merge-base\", \"--is-ancestor\", earlier, later],\n+                         capture_output=True, check=False)\n+    return run.returncode == 0\n+\n+\n+def proof_every_attested_item_is_sealed(root: Path, m: dict | None) -> Proof:\n+    p = Proof(\"every-attested-item-is-sealed\", \"every attested item has its statement in the store\")\n+    if m is None:\n+        return p.fail(f\"no {MANIFEST} at {root}; no records directory is declared\")\n+    cmd = attestation_command(m)\n+    if cmd is None:\n+        return p.fail(\"no [forge].attestation_command in the manifest; the store cannot be read\")\n+    records_rel = m.get(\"paths\", {}).get(\"records\", \"\")\n+    records_dir = root / records_rel\n+    if not records_dir.is_dir():\n+        return p.fail(f\"no records directory under {records_dir}\")\n+    items = load_records(records_dir)\n+    complete = [item for item, stages in sorted(items.items()) if all(s in stages for s in STAGES)]\n+\n+    # [forge].sealed_since: merges at or before this sha predate the\n+    # tenant's merge queue -- the self-tenant's own #106, #148, #153 were\n+    # merged direct, with no merge_group run to seal them. They are\n+    # named, never failed, the same window convention proof three keeps\n+    # for commits before the manifest's own install.\n+    since = (m.get(\"forge\") or {}).get(\"sealed_since\")\n+    sealed: list[str] = []\n+    before_window: list[str] = []\n+    unsealed: list[str] = []\n+    reasons: list[str] = []\n+    for item in complete:\n+        merge_sha = merge_introducing_records(root, records_rel, item, STAGES)\n+        if merge_sha is None:\n+            continue\n+        if isinstance(since, str) and since.strip() and _is_ancestor(root, merge_sha, since):\n+            before_window.append(item)\n+        elif statement_for(root, cmd, merge_sha) is not None:\n+            sealed.append(item)\n+        else:\n+            unsealed.append(item)\n+            reasons.append(f\"item {item} merged at {merge_sha[:12]} has no statement in the store\")\n+    if reasons:\n+        return p.fail(\"; \".join(reasons), sealed=sealed, before_window=before_window, unsealed=unsealed)\n+    return p.hold(f\"{len(sealed)} merged item(s) sealed, {len(before_window)} before the window\",\n+                 sealed=sealed, before_window=before_window, unsealed=unsealed)\n+\n+\n def doctor(root: Path) -> list[Proof]:\n     m = read_manifest(root)\n     return [proof_every_gate_rejects(root, m),\n             proof_one_item_every_stage(root, m),\n             proof_no_commit_lacks_record(root, m),\n-            proof_no_stop_lacks_cause(root, m)]\n+            proof_no_stop_lacks_cause(root, m),\n+            proof_every_attested_item_is_sealed(root, m)]\n \n \n def cmd_doctor(argv: list[str]) -> int:\ndiff --git a/schema/manifest.schema.json b/schema/manifest.schema.json\nindex 6dc7c15..105b511 100644\n--- a/schema/manifest.schema.json\n+++ b/schema/manifest.schema.json\n@@ -88,6 +88,16 @@\n           \"type\": \"string\",\n           \"description\": \"Reads one finding as JSON on stdin and files it as a tenant issue. attavo file-findings runs it once per finding in the item's latest verify record.\",\n           \"minLength\": 1\n+        },\n+        \"attestation_command\": {\n+          \"type\": \"string\",\n+          \"description\": \"Reads a merge commit sha on stdin and prints that merge's attestation statement as JSON on exit 0; nothing on a non-zero exit. The doctor's fifth proof runs it once per merged, fully-staged item to require a statement in the store.\",\n+          \"minLength\": 1\n+        },\n+        \"sealed_since\": {\n+          \"type\": \"string\",\n+          \"description\": \"A commit sha. A merge at or before it predates the tenant's merge queue and is named by the doctor's fifth proof as before the window rather than failed.\",\n+          \"minLength\": 7\n         }\n       }\n     },\ndiff --git a/tests/test_doctor.py b/tests/test_doctor.py\nindex d147948..2cfcc32 100644\n--- a/tests/test_doctor.py\n+++ b/tests/test_doctor.py\n@@ -1,6 +1,6 @@\n-\"\"\"The doctor's four proofs, as tests written before the capability.\n+\"\"\"The doctor's five proofs, as tests written before the capability.\n \n-Each test asserts that one proof holds against this repository. All four\n+Each test asserts that one proof holds against this repository. All five\n fail at the first commit and must fail: that is the definition of done,\n stated before anything exists to satisfy it. A test here turns green only\n when the capability it names has landed and been used for real.\n@@ -58,6 +58,15 @@ def test_no_stop_lacks_cause():\n     assert p[\"holds\"], p[\"reason\"]\n \n \n+def test_every_attested_item_is_sealed():\n+    \"\"\"Proof 5, issue #158. Every merged, fully-staged item has a\n+    statement in the forge's attestation store for its merge commit --\n+    #106, #148, #153 predate [forge].sealed_since and are named before the\n+    window instead.\"\"\"\n+    p = run_doctor(ROOT)[\"every-attested-item-is-sealed\"]\n+    assert p[\"holds\"], p[\"reason\"]\n+\n+\n def test_record_loader_uses_highest_attempt_number(tmp_path):\n     \"\"\"Acceptance 2a. <stage>-NN.json files are one stage's attempts; the\n     doctor treats the highest NN as latest, and STAGES is unchanged.\ndiff --git a/tests/test_doctor_sealed.py b/tests/test_doctor_sealed.py\nnew file mode 100644\nindex 0000000..a454a18\n--- /dev/null\n+++ b/tests/test_doctor_sealed.py\n@@ -0,0 +1,93 @@\n+\"\"\"The doctor's fifth proof: every attested item has its statement in the\n+store (issue #158). This repository's own #106, #148, #153 were merged\n+direct, with no merge_group run and so no statement, and the doctor said\n+done anyway -- proof two held on the four stage records with the chain\n+held, never asking whether the merge was sealed.\n+\n+Run: python3 -m pytest tests -q\n+\"\"\"\n+import json\n+import subprocess\n+from pathlib import Path\n+\n+ROOT = Path(__file__).resolve().parent.parent\n+ATTAVO = ROOT / \"bin\" / \"attavo\"\n+\n+FAKE_ATTEST = (\n+    '#!/bin/sh\\nread sha\\ngrep -qx \"$sha\" sealed.txt && printf %s '\n+    '\"{\\\\\"_type\\\\\": \\\\\"https://in-toto.io/Statement/v1\\\\\"}\"\\n'\n+)\n+\n+\n+def _git(root: Path, *args: str) -> str:\n+    return subprocess.run([\"git\", \"-C\", str(root), *args], capture_output=True, text=True,\n+                          check=True).stdout.strip()\n+\n+\n+def _tenant_with_two_merged_items(tmp_path: Path) -> tuple[Path, str, str]:\n+    root = tmp_path / \"sealed\"\n+    root.mkdir()\n+    subprocess.run([\"git\", \"init\", \"-q\", \"-b\", \"main\", \".\"], cwd=root, check=True)\n+    _git(root, \"config\", \"user.email\", \"doctor@attavo.invalid\")\n+    _git(root, \"config\", \"user.name\", \"doctor fixture\")\n+    (root / \"attavo.toml\").write_text(\n+        '[paths]\\nrecords = \"records\"\\n\\n[forge]\\nattestation_command = \"sh ./fake-attest\"\\n')\n+    (root / \"fake-attest\").write_text(FAKE_ATTEST)\n+    (root / \"sealed.txt\").write_text(\"\")\n+    _git(root, \"add\", \".\")\n+    _git(root, \"commit\", \"-q\", \"-m\", \"install\")\n+    merges = []\n+    for item in (\"1\", \"2\"):\n+        _git(root, \"checkout\", \"-q\", \"-b\", f\"attavo/{item}-x\")\n+        (root / \"records\" / item).mkdir(parents=True)\n+        for stage in (\"spec\", \"approval\", \"build\", \"verify\"):\n+            (root / \"records\" / item / f\"{stage}-01.json\").write_text('{\"status\": \"pass\"}')\n+            _git(root, \"add\", \"records\")\n+            _git(root, \"commit\", \"-q\", \"-m\", f\"{stage} record for item {item}\")\n+        _git(root, \"checkout\", \"-q\", \"main\")\n+        _git(root, \"merge\", \"-q\", \"--no-ff\", \"-m\", f\"Merge branch 'attavo/{item}-x'\", f\"attavo/{item}-x\")\n+        merges.append(_git(root, \"rev-parse\", \"HEAD\"))\n+    return root, merges[0], merges[1]\n+\n+\n+def _proof(root: Path) -> dict:\n+    run = subprocess.run([\"python3\", str(ATTAVO), \"doctor\", \"--json\", str(root)],\n+                         capture_output=True, text=True, check=False)\n+    proofs = json.loads(run.stdout)[\"proofs\"]\n+    return [p for p in proofs if p[\"proof\"] == \"every-attested-item-is-sealed\"][0]\n+\n+\n+def test_doctor_proof_six_fails_on_an_unsealed_merge(tmp_path):\n+    root, m1, m2 = _tenant_with_two_merged_items(tmp_path)\n+    (root / \"sealed.txt\").write_text(m1 + \"\\n\")\n+    p = _proof(root)\n+    assert not p[\"holds\"]\n+    assert \"item 2\" in p[\"reason\"] and m2[:12] in p[\"reason\"]\n+    assert p[\"sealed\"] == [\"1\"] and p[\"unsealed\"] == [\"2\"]\n+\n+\n+def test_doctor_proof_six_holds_when_every_merge_is_sealed(tmp_path):\n+    root, m1, m2 = _tenant_with_two_merged_items(tmp_path)\n+    (root / \"sealed.txt\").write_text(m1 + \"\\n\" + m2 + \"\\n\")\n+    p = _proof(root)\n+    assert p[\"holds\"] and p[\"sealed\"] == [\"1\", \"2\"]\n+\n+\n+def test_doctor_proof_six_names_a_merge_before_the_window_without_failing(tmp_path):\n+    root, m1, m2 = _tenant_with_two_merged_items(tmp_path)\n+    (root / \"sealed.txt\").write_text(m2 + \"\\n\")\n+    (root / \"attavo.toml\").write_text(\n+        '[paths]\\nrecords = \"records\"\\n\\n[forge]\\nattestation_command = \"sh ./fake-attest\"\\n'\n+        f'sealed_since = \"{m1}\"\\n')\n+    p = _proof(root)\n+    assert p[\"holds\"] and p[\"before_window\"] == [\"1\"] and p[\"sealed\"] == [\"2\"]\n+\n+\n+def test_doctor_proof_six_fails_without_an_attestation_command(tmp_path):\n+    root = tmp_path / \"bare\"\n+    root.mkdir()\n+    subprocess.run([\"git\", \"init\", \"-q\", \"-b\", \"main\", \".\"], cwd=root, check=True)\n+    (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n')\n+    (root / \"records\").mkdir()\n+    p = _proof(root)\n+    assert not p[\"holds\"] and \"attestation_command\" in p[\"reason\"]\ndiff --git a/tests/test_record_schemas.py b/tests/test_record_schemas.py\nindex 73630c8..5f82b63 100644\n--- a/tests/test_record_schemas.py\n+++ b/tests/test_record_schemas.py\n@@ -419,13 +419,14 @@ def test_only_load_record_parses_record_file_content():\n     \"\"\"Acceptance 6: _load_record is the one place in this repository\n     that turns a <stage>-NN.json record's bytes into a dict; parse_attempts\n     and load_records both read through it rather than calling json.loads\n-    themselves. `git grep -n \"json.loads(\" bin/attavo` still finds four\n+    themselves. `git grep -n \"json.loads(\" bin/attavo` still finds five\n     other sites -- a schema file, an adapter's conformance.json, an\n-    adapter's own stdout report, and proof four's own read of one log\n-    line at a time to tell an adapter's JSON event stream from a tool's\n-    plain-text error (issue #94) -- none of them a record.\"\"\"\n+    adapter's own stdout report, proof four's own read of one log line at\n+    a time to tell an adapter's JSON event stream from a tool's plain-text\n+    error (issue #94), and proof five's own read of the forge's\n+    attestation statement (issue #158) -- none of them a record.\"\"\"\n     text = ATTAVO.read_text()\n-    assert text.count(\"json.loads(\") == 5, (\n+    assert text.count(\"json.loads(\") == 6, (\n         \"a new json.loads( site was added; review it against issue #60 acceptance 6 \"\n         \"and update this count\")\n     assert \"data = json.loads(path.read_text())\" in text\n","exit_code":0,"status":"completed"}}

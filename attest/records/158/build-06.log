{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WmZhuVreHBmnfGTQBE9qAk","type":"tool_result","content":"The file /Users/davidbean/Projects/attavo-worktree-158/tests/test_doctor_sealed.py has been updated successfully. (file state is current in your context — no need to Read it back)"}]},"parent_tool_use_id":null,"session_id":"0c30ad3c-30a7-49dd-9494-46f815109093","uuid":"7f5d6255-ced6-4ec0-a7a4-5b58091426c8","timestamp":"2026-09-18T23:31:32.985Z","tool_use_result":{"filePath":"/Users/davidbean/Projects/attavo-worktree-158/tests/test_doctor_sealed.py","oldString":"def test_doctor_proof_six_names_an_unmerged_item(tmp_path):","newString":"def test_doctor_proof_six_says_not_read_when_the_store_cannot_be_read(tmp_path):\n    root = tmp_path / \"unreadable\"\n    root.mkdir()\n    subprocess.run([\"git\", \"init\", \"-q\", \"-b\", \"main\", \".\"], cwd=root, check=True)\n    _git(root, \"config\", \"user.email\", \"doctor@attavo.invalid\")\n    _git(root, \"config\", \"user.name\", \"doctor fixture\")\n    (root / \"attavo.toml\").write_text(\n        '[paths]\\nrecords = \"records\"\\n\\n[forge]\\nattestation_command = \"sh ./unreadable-store\"\\n')\n    (root / \"unreadable-store\").write_text(\n        '#!/bin/sh\\nread sha\\necho \"gh: not logged in\" >&2\\nexit 2\\n')\n    _git(root, \"add\", \".\")\n    _git(root, \"commit\", \"-q\", \"-m\", \"install\")\n    _git(root, \"checkout\", \"-q\", \"-b\", \"attavo/1-x\")\n    (root / \"records\" / \"1\").mkdir(parents=True)\n    for stage in (\"spec\", \"approval\", \"build\", \"verify\"):\n        (root / \"records\" / \"1\" / f\"{stage}-01.json\").write_text('{\"status\": \"pass\"}')\n        _git(root, \"add\", \"records\")\n        _git(root, \"commit\", \"-q\", \"-m\", f\"{stage} record for item 1\")\n    _git(root, \"checkout\", \"-q\", \"main\")\n    _git(root, \"merge\", \"-q\", \"--no-ff\", \"-m\", \"Merge branch 'attavo/1-x'\", \"attavo/1-x\")\n    _git(root, \"update-ref\", \"refs/remotes/origin/main\", _git(root, \"rev-parse\", \"main\"))\n    _git(root, \"symbolic-ref\", \"refs/remotes/origin/HEAD\", \"refs/remotes/origin/main\")\n    p = _proof(root)\n    assert not p[\"holds\"]\n    assert \"not read\" in p[\"reason\"] and \"unreadable-store\" in p[\"reason\"] and \"exited 2\" in p[\"reason\"]\n    assert p[\"not_read\"] == [\"1\"] and p[\"unsealed\"] == [] and p[\"sealed\"] == []\n\n\ndef test_doctor_proof_six_names_an_unmerged_item(tmp_path):","originalFile":"\"\"\"The doctor's fifth proof: every attested item has its statement in the\nstore (issue #158). This repository's own #106, #148, #153 were merged\ndirect, with no merge_group run and so no statement, and the doctor said\ndone anyway -- proof two held on the four stage records with the chain\nheld, never asking whether the merge was sealed.\n\nRun: python3 -m pytest tests -q\n\"\"\"\nimport json\nimport subprocess\nfrom pathlib import Path\n\nROOT = Path(__file__).resolve().parent.parent\nATTAVO = ROOT / \"bin\" / \"attavo\"\n\nFAKE_ATTEST = (\n    '#!/bin/sh\\nread sha\\ngrep -qx \"$sha\" sealed.txt && printf %s '\n    '\"{\\\\\"_type\\\\\": \\\\\"https://in-toto.io/Statement/v1\\\\\"}\"\\n'\n)\n\n\ndef _git(root: Path, *args: str) -> str:\n    return subprocess.run([\"git\", \"-C\", str(root), *args], capture_output=True, text=True,\n                          check=True).stdout.strip()\n\n\ndef _tenant_with_two_merged_items(tmp_path: Path) -> tuple[Path, str, str]:\n    root = tmp_path / \"sealed\"\n    root.mkdir()\n    subprocess.run([\"git\", \"init\", \"-q\", \"-b\", \"main\", \".\"], cwd=root, check=True)\n    _git(root, \"config\", \"user.email\", \"doctor@attavo.invalid\")\n    _git(root, \"config\", \"user.name\", \"doctor fixture\")\n    (root / \"attavo.toml\").write_text(\n        '[paths]\\nrecords = \"records\"\\n\\n[forge]\\nattestation_command = \"sh ./fake-attest\"\\n')\n    (root / \"fake-attest\").write_text(FAKE_ATTEST)\n    (root / \"sealed.txt\").write_text(\"\")\n    _git(root, \"add\", \".\")\n    _git(root, \"commit\", \"-q\", \"-m\", \"install\")\n    merges = []\n    for item in (\"1\", \"2\"):\n        _git(root, \"checkout\", \"-q\", \"-b\", f\"attavo/{item}-x\")\n        (root / \"records\" / item).mkdir(parents=True)\n        for stage in (\"spec\", \"approval\", \"build\", \"verify\"):\n            (root / \"records\" / item / f\"{stage}-01.json\").write_text('{\"status\": \"pass\"}')\n            _git(root, \"add\", \"records\")\n            _git(root, \"commit\", \"-q\", \"-m\", f\"{stage} record for item {item}\")\n        _git(root, \"checkout\", \"-q\", \"main\")\n        _git(root, \"merge\", \"-q\", \"--no-ff\", \"-m\", f\"Merge branch 'attavo/{item}-x'\", f\"attavo/{item}-x\")\n        merges.append(_git(root, \"rev-parse\", \"HEAD\"))\n    _git(root, \"update-ref\", \"refs/remotes/origin/main\", _git(root, \"rev-parse\", \"main\"))\n    _git(root, \"symbolic-ref\", \"refs/remotes/origin/HEAD\", \"refs/remotes/origin/main\")\n    return root, merges[0], merges[1]\n\n\ndef _tenant_with_one_merged_and_one_unmerged_item(tmp_path: Path) -> Path:\n    root = tmp_path / \"unmerged\"\n    root.mkdir()\n    subprocess.run([\"git\", \"init\", \"-q\", \"-b\", \"main\", \".\"], cwd=root, check=True)\n    _git(root, \"config\", \"user.email\", \"doctor@attavo.invalid\")\n    _git(root, \"config\", \"user.name\", \"doctor fixture\")\n    (root / \"attavo.toml\").write_text(\n        '[paths]\\nrecords = \"records\"\\n\\n[forge]\\nattestation_command = \"sh ./fake-attest\"\\n')\n    (root / \"fake-attest\").write_text(FAKE_ATTEST)\n    (root / \"sealed.txt\").write_text(\"\")\n    _git(root, \"add\", \".\")\n    _git(root, \"commit\", \"-q\", \"-m\", \"install\")\n    _git(root, \"checkout\", \"-q\", \"-b\", \"attavo/1-x\")\n    (root / \"records\" / \"1\").mkdir(parents=True)\n    for stage in (\"spec\", \"approval\", \"build\", \"verify\"):\n        (root / \"records\" / \"1\" / f\"{stage}-01.json\").write_text('{\"status\": \"pass\"}')\n        _git(root, \"add\", \"records\")\n        _git(root, \"commit\", \"-q\", \"-m\", f\"{stage} record for item 1\")\n    _git(root, \"checkout\", \"-q\", \"main\")\n    _git(root, \"merge\", \"-q\", \"--no-ff\", \"-m\", \"Merge branch 'attavo/1-x'\", \"attavo/1-x\")\n    m1 = _git(root, \"rev-parse\", \"HEAD\")\n    (root / \"sealed.txt\").write_text(m1 + \"\\n\")\n    _git(root, \"add\", \"sealed.txt\")\n    _git(root, \"commit\", \"-q\", \"-m\", \"seal item 1\")\n    _git(root, \"checkout\", \"-q\", \"-b\", \"attavo/2-x\")\n    (root / \"records\" / \"2\").mkdir(parents=True)\n    for stage in (\"spec\", \"approval\", \"build\", \"verify\"):\n        (root / \"records\" / \"2\" / f\"{stage}-01.json\").write_text('{\"status\": \"pass\"}')\n        _git(root, \"add\", \"records\")\n        _git(root, \"commit\", \"-q\", \"-m\", f\"{stage} record for item 2\")\n    _git(root, \"checkout\", \"-q\", \"--detach\")\n    _git(root, \"merge\", \"-q\", \"--no-ff\", \"-m\", \"synthetic test merge of attavo/2-x into main\", \"main\")\n    return root\n\n\ndef _proof(root: Path) -> dict:\n    run = subprocess.run([\"python3\", str(ATTAVO), \"doctor\", \"--json\", str(root)],\n                         capture_output=True, text=True, check=False)\n    proofs = json.loads(run.stdout)[\"proofs\"]\n    return [p for p in proofs if p[\"proof\"] == \"every-attested-item-is-sealed\"][0]\n\n\ndef test_doctor_proof_six_fails_on_an_unsealed_merge(tmp_path):\n    root, m1, m2 = _tenant_with_two_merged_items(tmp_path)\n    (root / \"sealed.txt\").write_text(m1 + \"\\n\")\n    p = _proof(root)\n    assert not p[\"holds\"]\n    assert \"item 2\" in p[\"reason\"] and m2[:12] in p[\"reason\"]\n    assert p[\"sealed\"] == [\"1\"] and p[\"unsealed\"] == [\"2\"]\n\n\ndef test_doctor_proof_six_holds_when_every_merge_is_sealed(tmp_path):\n    root, m1, m2 = _tenant_with_two_merged_items(tmp_path)\n    (root / \"sealed.txt\").write_text(m1 + \"\\n\" + m2 + \"\\n\")\n    p = _proof(root)\n    assert p[\"holds\"] and p[\"sealed\"] == [\"1\", \"2\"]\n\n\ndef test_doctor_proof_six_names_a_merge_before_the_window_without_failing(tmp_path):\n    root, m1, m2 = _tenant_with_two_merged_items(tmp_path)\n    (root / \"sealed.txt\").write_text(m2 + \"\\n\")\n    (root / \"attavo.toml\").write_text(\n        '[paths]\\nrecords = \"records\"\\n\\n[forge]\\nattestation_command = \"sh ./fake-attest\"\\n'\n        f'sealed_since = \"{m1}\"\\n')\n    p = _proof(root)\n    assert p[\"holds\"] and p[\"before_window\"] == [\"1\"] and p[\"sealed\"] == [\"2\"]\n\n\ndef test_doctor_proof_six_fails_without_an_attestation_command(tmp_path):\n    root = tmp_path / \"bare\"\n    root.mkdir()\n    subprocess.run([\"git\", \"init\", \"-q\", \"-b\", \"main\", \".\"], cwd=root, check=True)\n    (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n')\n    (root / \"records\").mkdir()\n    p = _proof(root)\n    assert not p[\"holds\"] and \"attestation_command\" in p[\"reason\"]\n\n\ndef test_doctor_proof_six_names_an_unmerged_item(tmp_path):\n    root = _tenant_with_one_merged_and_one_unmerged_item(tmp_path)\n    noref = _proof(root)\n    assert not noref[\"holds\"] and \"refs/remotes/origin/HEAD\" in noref[\"reason\"]\n    _git(root, \"update-ref\", \"refs/remotes/origin/main\", \"main\")\n    _git(root, \"symbolic-ref\", \"refs/remotes/origin/HEAD\", \"refs/remotes/origin/main\")\n    ref = _proof(root)\n    assert ref[\"holds\"]\n    assert ref[\"sealed\"] == [\"1\"] and ref[\"not_merged\"] == [\"2\"] and ref[\"unsealed\"] == []\n","structuredPatch":[{"oldStart":130,"oldLines":6,"newStart":130,"newLines":34,"lines":["     assert not p[\"holds\"] and \"attestation_command\" in p[\"reason\"]"," "," ","+def test_doctor_proof_six_says_not_read_when_the_store_cannot_be_read(tmp_path):","+    root = tmp_path / \"unreadable\"","+    root.mkdir()","+    subprocess.run([\"git\", \"init\", \"-q\", \"-b\", \"main\", \".\"], cwd=root, check=True)","+    _git(root, \"config\", \"user.email\", \"doctor@attavo.invalid\")","+    _git(root, \"config\", \"user.name\", \"doctor fixture\")","+    (root / \"attavo.toml\").write_text(","+        '[paths]\\nrecords = \"records\"\\n\\n[forge]\\nattestation_command = \"sh ./unreadable-store\"\\n')","+    (root / \"unreadable-store\").write_text(","+        '#!/bin/sh\\nread sha\\necho \"gh: not logged in\" >&2\\nexit 2\\n')","+    _git(root, \"add\", \".\")","+    _git(root, \"commit\", \"-q\", \"-m\", \"install\")","+    _git(root, \"checkout\", \"-q\", \"-b\", \"attavo/1-x\")","+    (root / \"records\" / \"1\").mkdir(parents=True)","+    for stage in (\"spec\", \"approval\", \"build\", \"verify\"):","+        (root / \"records\" / \"1\" / f\"{stage}-01.json\").write_text('{\"status\": \"pass\"}')","+        _git(root, \"add\", \"records\")","+        _git(root, \"commit\", \"-q\", \"-m\", f\"{stage} record for item 1\")","+    _git(root, \"checkout\", \"-q\", \"main\")","+    _git(root, \"merge\", \"-q\", \"--no-ff\", \"-m\", \"Merge branch 'attavo/1-x'\", \"attavo/1-x\")","+    _git(root, \"update-ref\", \"refs/remotes/origin/main\", _git(root, \"rev-parse\", \"main\"))","+    _git(root, \"symbolic-ref\", \"refs/remotes/origin/HEAD\", \"refs/remotes/origin/main\")","+    p = _proof(root)","+    assert not p[\"holds\"]","+    assert \"not read\" in p[\"reason\"] and \"unreadable-store\" in p[\"reason\"] and \"exited 2\" in p[\"reason\"]","+    assert p[\"not_read\"] == [\"1\"] and p[\"unsealed\"] == [] and p[\"sealed\"] == []","+","+"," def test_doctor_proof_six_names_an_unmerged_item(tmp_path):","     root = _tenant_with_one_merged_and_one_unmerged_item(tmp_path)","     noref = _proof(root)"]}],"userModified":false,"replaceAll":false}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Fsmiqd6eRHRpekxi9aLxj4","type":"tool_result","content":"diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml\nindex 7a42b8c..d2051ce 100644\n--- a/.github/workflows/ci.yml\n+++ b/.github/workflows/ci.yml\n@@ -35,6 +35,14 @@ jobs:\n     permissions:\n       contents: read\n       attestations: read\n+    env:\n+      # issue #158, amended after build-05: every step that runs the\n+      # doctor -- the pytest step and the bin/attavo invocation both --\n+      # reads the attestation store through [forge].attestation_command,\n+      # which shells out to `gh`. A token scoped to only the last step\n+      # left the pytest step reading an unauthenticated store, which\n+      # exits 2 (not read), not the 404 (unsealed) the proof expects.\n+      GH_TOKEN: ${{ github.token }}\n     steps:\n       - uses: actions/checkout@v4\n         with:\n@@ -51,8 +59,6 @@ jobs:\n       - name: doctor's five proofs\n         run: python3 -m pytest tests/test_doctor.py -q -k \"every_gate_rejects or one_item_traversed_every_stage or no_commit_lacks_a_record or no_stop_lacks_cause or every_attested_item_is_sealed\"\n       - run: python3 bin/attavo doctor .\n-        env:\n-          GH_TOKEN: ${{ github.token }}\n \n   action-self-check:\n     runs-on: ubuntu-latest\ndiff --git a/bin/attavo b/bin/attavo\nindex 2e288a7..f98e465 100755\n--- a/bin/attavo\n+++ b/bin/attavo\n@@ -1415,18 +1415,21 @@ def attestation_command(m: dict) -> str | None:\n     return cmd if isinstance(cmd, str) and cmd.strip() else None\n \n \n-def statement_for(root: Path, cmd: str, merge_sha: str) -> dict | None:\n-    \"\"\"The statement the forge holds for merge_sha, or None when the\n-    command exits non-zero or prints anything but a JSON object.\"\"\"\n+def statement_for(root: Path, cmd: str, merge_sha: str) -> tuple[dict | None, int]:\n+    \"\"\"The statement the forge holds for merge_sha and the command's exit\n+    code. The statement is None when the command exits non-zero or prints\n+    anything but a JSON object -- exit 2 means the store itself could not\n+    be read (issue #158, amended after build-05: distinct from exit 1,\n+    the store read fine and simply held no statement).\"\"\"\n     run = subprocess.run(cmd, shell=True, cwd=str(root), input=merge_sha + \"\\n\",\n                          capture_output=True, text=True, check=False)\n     if run.returncode != 0:\n-        return None\n+        return None, run.returncode\n     try:\n         parsed = json.loads(run.stdout)\n     except ValueError:\n-        return None\n-    return parsed if isinstance(parsed, dict) else None\n+        return None, run.returncode\n+    return (parsed if isinstance(parsed, dict) else None), run.returncode\n \n \n def _is_ancestor(root: Path, earlier: str, later: str) -> bool:\n@@ -1462,6 +1465,7 @@ def proof_every_attested_item_is_sealed(root: Path, m: dict | None) -> Proof:\n     before_window: list[str] = []\n     unsealed: list[str] = []\n     not_merged: list[str] = []\n+    not_read: list[str] = []\n     reasons: list[str] = []\n     for item in complete:\n         merge_sha, _ = merge_introducing_records(root, records_rel, item, STAGES, merges=merges)\n@@ -1470,17 +1474,24 @@ def proof_every_attested_item_is_sealed(root: Path, m: dict | None) -> Proof:\n             continue\n         if isinstance(since, str) and since.strip() and _is_ancestor(root, merge_sha, since):\n             before_window.append(item)\n-        elif statement_for(root, cmd, merge_sha) is not None:\n+            continue\n+        statement, exit_code = statement_for(root, cmd, merge_sha)\n+        if statement is not None:\n             sealed.append(item)\n+        elif exit_code == 2:\n+            not_read.append(item)\n+            reasons.append(f\"item {item} merged at {merge_sha[:12]}: not read -- \"\n+                           f\"the store could not be read; {cmd!r} exited 2\")\n         else:\n             unsealed.append(item)\n             reasons.append(f\"item {item} merged at {merge_sha[:12]} has no statement in the store\")\n     if reasons:\n         return p.fail(\"; \".join(reasons), sealed=sealed, before_window=before_window,\n-                      unsealed=unsealed, not_merged=not_merged)\n+                      unsealed=unsealed, not_merged=not_merged, not_read=not_read)\n     return p.hold(f\"{len(sealed)} merged item(s) sealed, {len(before_window)} before the window, \"\n                  f\"{len(not_merged)} not merged\",\n-                 sealed=sealed, before_window=before_window, unsealed=unsealed, not_merged=not_merged)\n+                 sealed=sealed, before_window=before_window, unsealed=unsealed,\n+                 not_merged=not_merged, not_read=not_read)\n \n \n def doctor(root: Path) -> list[Proof]:\ndiff --git a/tests/test_doctor_sealed.py b/tests/test_doctor_sealed.py\nindex f3093bc..3a3bb25 100644\n--- a/tests/test_doctor_sealed.py\n+++ b/tests/test_doctor_sealed.py\n@@ -130,6 +130,34 @@ def test_doctor_proof_six_fails_without_an_attestation_command(tmp_path):\n     assert not p[\"holds\"] and \"attestation_command\" in p[\"reason\"]\n \n \n+def test_doctor_proof_six_says_not_read_when_the_store_cannot_be_read(tmp_path):\n+    root = tmp_path / \"unreadable\"\n+    root.mkdir()\n+    subprocess.run([\"git\", \"init\", \"-q\", \"-b\", \"main\", \".\"], cwd=root, check=True)\n+    _git(root, \"config\", \"user.email\", \"doctor@attavo.invalid\")\n+    _git(root, \"config\", \"user.name\", \"doctor fixture\")\n+    (root / \"attavo.toml\").write_text(\n+        '[paths]\\nrecords = \"records\"\\n\\n[forge]\\nattestation_command = \"sh ./unreadable-store\"\\n')\n+    (root / \"unreadable-store\").write_text(\n+        '#!/bin/sh\\nread sha\\necho \"gh: not logged in\" >&2\\nexit 2\\n')\n+    _git(root, \"add\", \".\")\n+    _git(root, \"commit\", \"-q\", \"-m\", \"install\")\n+    _git(root, \"checkout\", \"-q\", \"-b\", \"attavo/1-x\")\n+    (root / \"records\" / \"1\").mkdir(parents=True)\n+    for stage in (\"spec\", \"approval\", \"build\", \"verify\"):\n+        (root / \"records\" / \"1\" / f\"{stage}-01.json\").write_text('{\"status\": \"pass\"}')\n+        _git(root, \"add\", \"records\")\n+        _git(root, \"commit\", \"-q\", \"-m\", f\"{stage} record for item 1\")\n+    _git(root, \"checkout\", \"-q\", \"main\")\n+    _git(root, \"merge\", \"-q\", \"--no-ff\", \"-m\", \"Merge branch 'attavo/1-x'\", \"attavo/1-x\")\n+    _git(root, \"update-ref\", \"refs/remotes/origin/main\", _git(root, \"rev-parse\", \"main\"))\n+    _git(root, \"symbolic-ref\", \"refs/remotes/origin/HEAD\", \"refs/remotes/origin/main\")\n+    p = _proof(root)\n+    assert not p[\"holds\"]\n+    assert \"not read\" in p[\"reason\"] and \"unreadable-store\" in p[\"reason\"] and \"exited 2\" in p[\"reason\"]\n+    assert p[\"not_read\"] == [\"1\"] and p[\"unsealed\"] == [] and p[\"sealed\"] == []\n+\n+\n def test_doctor_proof_six_names_an_unmerged_item(tmp_path):\n     root = _tenant_with_one_merged_and_one_unmerged_item(tmp_path)\n     noref = _proof(root)","is_error":false}]},"parent_tool_use_id":null,"session_id":"0c30ad3c-30a7-49dd-9494-46f815109093","uuid":"207d857d-540e-485c-a0f8-d3c7f1e5db9e","timestamp":"2026-09-18T23:35:48.347Z","tool_use_result":{"stdout":"diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml\nindex 7a42b8c..d2051ce 100644\n--- a/.github/workflows/ci.yml\n+++ b/.github/workflows/ci.yml\n@@ -35,6 +35,14 @@ jobs:\n     permissions:\n       contents: read\n       attestations: read\n+    env:\n+      # issue #158, amended after build-05: every step that runs the\n+      # doctor -- the pytest step and the bin/attavo invocation both --\n+      # reads the attestation store through [forge].attestation_command,\n+      # which shells out to `gh`. A token scoped to only the last step\n+      # left the pytest step reading an unauthenticated store, which\n+      # exits 2 (not read
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MWFkHN2RDwU24FoyYooSca","type":"tool_result","content":"1\t#!/bin/sh\n2\t# forge-attestation: [forge].attestation_command for attavo doctor's fifth\n3\t# proof (issue #158).\n4\t#\n5\t# Reads a merge commit sha on stdin. actions/attest@v2, in\n6\t# .github/workflows/attavo-coherence.yml, signs the merge's attestation\n7\t# statement over a synthetic subject: the sha256 digest of the merge\n8\t# sha's own text (deterministic and reproducible from the sha alone, since\n9\t# the statement is sealed before the artifact -- the merge -- has landed\n10\t# anywhere to be hashed itself). This script re-derives that same digest\n11\t# and reads it back from the forge's attestation store, printing the\n12\t# statement's predicate payload as JSON on exit 0. It prints nothing and\n13\t# exits non-zero when the store holds no attestation for that digest, or\n14\t# the sha is empty, or `gh` cannot resolve this checkout's repository.\n15\t#\n16\t# Usage: read sha | forge-attestation\n17\t# Requires: `gh`, authenticated, run inside this repository's checkout.\n18\tset -e\n19\tread -r sha\n20\ttest -n \"$sha\" || exit 2\n21\tdigest=$(printf '%s' \"$sha\" | shasum -a 256 | cut -d ' ' -f 1)\n22\trepo=$(gh repo view --json nameWithOwner --jq .nameWithOwner 2>/dev/null) || exit 2\n23\tpayload=$(gh api \"repos/$repo/attestations/sha256:$digest\" --jq '.attestations[0].bundle.dsseEnvelope.payload' 2>/dev/null) || exit 1\n24\ttest -n \"$payload\" && test \"$payload\" != null || exit 1\n25\tprintf '%s' \"$payload\" | base64 -d\n26\t"}]},"parent_tool_use_id":null,"session_id":"0c30ad3c-30a7-49dd-9494-46f815109093","uuid":"6b395f52-4fa4-4f17-ad1e-0a9695379595","timestamp":"2026-09-18T23:30:09.109Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-158/.attavo/bin/forge-attestation","content":"#!/bin/sh\n# forge-attestation: [forge].attestation_command for attavo doctor's fifth\n# proof (issue #158).\n#\n# Reads a merge commit sha on stdin. actions/attest@v2, in\n# .github/workflows/attavo-coherence.yml, signs the merge's attestation\n# statement over a synthetic subject: the sha256 digest of the merge\n# sha's own text (deterministic and reproducible from the sha alone, since\n# the statement is sealed before the artifact -- the merge -- has landed\n# anywhere to be hashed itself). This script re-derives that same digest\n# and reads it back from the forge's attestation store, printing the\n# statement's predicate payload as JSON on exit 0. It prints nothing and\n# exits non-zero when the store holds no attestation for that digest, or\n# the sha is empty, or `gh` cannot resolve this checkout's repository.\n#\n# Usage: read sha | forge-attestation\n# Requires: `gh`, authenticated, run inside this repository's checkout.\nset -e\nread -r sha\ntest -n \"$sha\" || exit 2\ndigest=$(printf '%s' \"$sha\" | shasum -a 256 | cut -d ' ' -f 1)\nrepo=$(gh repo view --json nameWithOwner --jq .nameWithOwner 2>/dev/null) || exit 2\npayload=$(gh api \"repos/$repo/attestations/sha256:$digest\" --jq '.attestations[0].bundle.dsseEnvelope.payload' 2>/dev/null) || exit 1\ntest -n \"$payload\" && test \"$payload\" != null || exit 1\nprintf '%s' \"$payload\" | base64 -d\n","numLines":26,"startLine":1,"totalLines":26}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GWBPeefbjL2VW3rV3jRBAx","type":"tool_result","content":"1\t\"\"\"The doctor's fifth proof: every attested item has its statement in the\n2\tstore (issue #158). This repository's own #106, #148, #153 were merged\n3\tdirect, with no merge_group run and so no statement, and the doctor said\n4\tdone anyway -- proof two held on the four stage records with the chain\n5\theld, never asking whether the merge was sealed.\n6\t\n7\tRun: python3 -m pytest tests -q\n8\t\"\"\"\n9\timport json\n10\timport subprocess\n11\tfrom pathlib import Path\n12\t\n13\tROOT = Path(__file__).resolve().parent.parent\n14\tATTAVO = ROOT / \"bin\" / \"attavo\"\n15\t\n16\tFAKE_ATTEST = (\n17\t    '#!/bin/sh\\nread sha\\ngrep -qx \"$sha\" sealed.txt && printf %s '\n18\t    '\"{\\\\\"_type\\\\\": \\\\\"https://in-toto.io/Statement/v1\\\\\"}\"\\n'\n19\t)\n20\t\n21\t\n22\tdef _git(root: Path, *args: str) -> str:\n23\t    return subprocess.run([\"git\", \"-C\", str(root), *args], capture_output=True, text=True,\n24\t                          check=True).stdout.strip()\n25\t\n26\t\n27\tdef _tenant_with_two_merged_items(tmp_path: Path) -> tuple[Path, str, str]:\n28\t    root = tmp_path / \"sealed\"\n29\t    root.mkdir()\n30\t    subprocess.run([\"git\", \"init\", \"-q\", \"-b\", \"main\", \".\"], cwd=root, check=True)\n31\t    _git(root, \"config\", \"user.email\", \"doctor@attavo.invalid\")\n32\t    _git(root, \"config\", \"user.name\", \"doctor fixture\")\n33\t    (root / \"attavo.toml\").write_text(\n34\t        '[paths]\\nrecords = \"records\"\\n\\n[forge]\\nattestation_command = \"sh ./fake-attest\"\\n')\n35\t    (root / \"fake-attest\").write_text(FAKE_ATTEST)\n36\t    (root / \"sealed.txt\").write_text(\"\")\n37\t    _git(root, \"add\", \".\")\n38\t    _git(root, \"commit\", \"-q\", \"-m\", \"install\")\n39\t    merges = []\n40\t    for item in (\"1\", \"2\"):\n41\t        _git(root, \"checkout\", \"-q\", \"-b\", f\"attavo/{item}-x\")\n42\t        (root / \"records\" / item).mkdir(parents=True)\n43\t        for stage in (\"spec\", \"approval\", \"build\", \"verify\"):\n44\t            (root / \"records\" / item / f\"{stage}-01.json\").write_text('{\"status\": \"pass\"}')\n45\t            _git(root, \"add\", \"records\")\n46\t            _git(root, \"commit\", \"-q\", \"-m\", f\"{stage} record for item {item}\")\n47\t        _git(root, \"checkout\", \"-q\", \"main\")\n48\t        _git(root, \"merge\", \"-q\", \"--no-ff\", \"-m\", f\"Merge branch 'attavo/{item}-x'\", f\"attavo/{item}-x\")\n49\t        merges.append(_git(root, \"rev-parse\", \"HEAD\"))\n50\t    _git(root, \"update-ref\", \"refs/remotes/origin/main\", _git(root, \"rev-parse\", \"main\"))\n51\t    _git(root, \"symbolic-ref\", \"refs/remotes/origin/HEAD\", \"refs/remotes/origin/main\")\n52\t    return root, merges[0], merges[1]\n53\t\n54\t\n55\tdef _tenant_with_one_merged_and_one_unmerged_item(tmp_path: Path) -> Path:\n56\t    root = tmp_path / \"unmerged\"\n57\t    root.mkdir()\n58\t    subprocess.run([\"git\", \"init\", \"-q\", \"-b\", \"main\", \".\"], cwd=root, check=True)\n59\t    _git(root, \"config\", \"user.email\", \"doctor@attavo.invalid\")\n60\t    _git(root, \"config\", \"user.name\", \"doctor fixture\")\n61\t    (root / \"attavo.toml\").write_text(\n62\t        '[paths]\\nrecords = \"records\"\\n\\n[forge]\\nattestation_command = \"sh ./fake-attest\"\\n')\n63\t    (root / \"fake-attest\").write_text(FAKE_ATTEST)\n64\t    (root / \"sealed.txt\").write_text(\"\")\n65\t    _git(root, \"add\", \".\")\n66\t    _git(root, \"commit\", \"-q\", \"-m\", \"install\")\n67\t    _git(root, \"checkout\", \"-q\", \"-b\", \"attavo/1-x\")\n68\t    (root / \"records\" / \"1\").mkdir(parents=True)\n69\t    for stage in (\"spec\", \"approval\", \"build\", \"verify\"):\n70\t        (root / \"records\" / \"1\" / f\"{stage}-01.json\").write_text('{\"status\": \"pass\"}')\n71\t        _git(root, \"add\", \"records\")\n72\t        _git(root, \"commit\", \"-q\", \"-m\", f\"{stage} record for item 1\")\n73\t    _git(root, \"checkout\", \"-q\", \"main\")\n74\t    _git(root, \"merge\", \"-q\", \"--no-ff\", \"-m\", \"Merge branch 'attavo/1-x'\", \"attavo/1-x\")\n75\t    m1 = _git(root, \"rev-parse\", \"HEAD\")\n76\t    (root / \"sealed.txt\").write_text(m1 + \"\\n\")\n77\t    _git(root, \"add\", \"sealed.txt\")\n78\t    _git(root, \"commit\", \"-q\", \"-m\", \"seal item 1\")\n79\t    _git(root, \"checkout\", \"-q\", \"-b\", \"attavo/2-x\")\n80\t    (root / \"records\" / \"2\").mkdir(parents=True)\n81\t    for stage in (\"spec\", \"approval\", \"build\", \"verify\"):\n82\t        (root / \"records\" / \"2\" / f\"{stage}-01.json\").write_text('{\"status\": \"pass\"}')\n83\t        _git(root, \"add\", \"records\")\n84\t        _git(root, \"commit\", \"-q\", \"-m\", f\"{stage} record for item 2\")\n85\t    _git(root, \"checkout\", \"-q\", \"--detach\")\n86\t    _git(root, \"merge\", \"-q\", \"--no-ff\", \"-m\", \"synthetic test merge of attavo/2-x into main\", \"main\")\n87\t    return root\n88\t\n89\t\n90\tdef _proof(root: Path) -> dict:\n91\t    run = subprocess.run([\"python3\", str(ATTAVO), \"doctor\", \"--json\", str(root)],\n92\t                         capture_output=True, text=True, check=False)\n93\t    proofs = json.loads(run.stdout)[\"proofs\"]\n94\t    return [p for p in proofs if p[\"proof\"] == \"every-attested-item-is-sealed\"][0]\n95\t\n96\t\n97\tdef test_doctor_proof_six_fails_on_an_unsealed_merge(tmp_path):\n98\t    root, m1, m2 = _tenant_with_two_merged_items(tmp_path)\n99\t    (root / \"sealed.txt\").write_text(m1 + \"\\n\")\n100\t    p = _proof(root)\n101\t    assert not p[\"holds\"]\n102\t    assert \"item 2\" in p[\"reason\"] and m2[:12] in p[\"reason\"]\n103\t    assert p[\"sealed\"] == [\"1\"] and p[\"unsealed\"] == [\"2\"]\n104\t\n105\t\n106\tdef test_doctor_proof_six_holds_when_every_merge_is_sealed(tmp_path):\n107\t    root, m1, m2 = _tenant_with_two_merged_items(tmp_path)\n108\t    (root / \"sealed.txt\").write_text(m1 + \"\\n\" + m2 + \"\\n\")\n109\t    p = _proof(root)\n110\t    assert p[\"holds\"] and p[\"sealed\"] == [\"1\", \"2\"]\n111\t\n112\t\n113\tdef test_doctor_proof_six_names_a_merge_before_the_window_without_failing(tmp_path):\n114\t    root, m1, m2 = _tenant_with_two_merged_items(tmp_path)\n115\t    (root / \"sealed.txt\").write_text(m2 + \"\\n\")\n116\t    (root / \"attavo.toml\").write_text(\n117\t        '[paths]\\nrecords = \"records\"\\n\\n[forge]\\nattestation_command = \"sh ./fake-attest\"\\n'\n118\t        f'sealed_since = \"{m1}\"\\n')\n119\t    p = _proof(root)\n120\t    assert p[\"holds\"] and p[\"before_window\"] == [\"1\"] and p[\"sealed\"] == [\"2\"]\n121\t\n122\t\n123\tdef test_doctor_proof_six_fails_without_an_attestation_command(tmp_path):\n124\t    root = tmp_path / \"bare\"\n125\t    root.mkdir()\n126\t    subprocess.run([\"git\", \"init\", \"-q\", \"-b\", \"main\", \".\"], cwd=root, check=True)\n127\t    (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n')\n128\t    (root / \"records\").mkdir()\n129\t    p = _proof(root)\n130\t    assert not p[\"holds\"] and \"attestation_command\" in p[\"reason\"]\n131\t\n132\t\n133\tdef test_doctor_proof_six_names_an_unmerged_item(tmp_path):\n134\t    root = _tenant_with_one_merged_and_one_unmerged_item(tmp_path)\n135\t    noref = _proof(root)\n136\t    assert not noref[\"holds\"] and \"refs/remotes/origin/HEAD\" in noref[\"reason\"]\n137\t    _git(root, \"update-ref\", \"refs/remotes/origin/main\", \"main\")\n138\t    _git(root, \"symbolic-ref\", \"refs/remotes/origin/HEAD\", \"refs/remotes/origin/main\")\n139\t    ref = _proof(root)\n140\t    assert ref[\"holds\"]\n141\t    assert ref[\"sealed\"] == [\"1\"] and ref[\"not_merged\"] == [\"2\"] and ref[\"unsealed\"] == []\n142\t"}]},"parent_tool_use_id":null,"session_id":"0c30ad3c-30a7-49dd-9494-46f815109093","uuid":"f78975b5-a063-4153-8f1d-e403a275d39d","timestamp":"2026-09-18T23:31:20.585Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-158/tests/test_doctor_sealed.py","content":"\"\"\"The doctor's fifth proof: every attested item has its statement in the\nstore (issue #158). This repository's own #106, #148, #153 were merged\ndirect, with no merge_group run and so no statement, and the doctor said\ndone anyway -- proof two held on the four stage records with the chain\nheld, never asking whether the merge was sealed.\n\nRun: python3 -m pytest tests -q\n\"\"\"\nimport json\nimport subprocess\nfrom pathlib import Path\n\nROOT = Path(__file__).resolve().parent.parent\nATTAVO = ROOT / \"bin\" / \"attavo\"\n\nFAKE_ATTEST = (\n    '#!/bin/sh\\nread sha\\ngrep -qx \"$sha\" sealed.txt && printf %s '\n    '\"{\\\\\"_type\\\\\": \\\\\"https://in-toto.io/Statement/v1\\\\\"}\"\\n'\n)\n\n\ndef _git(root: Path, *args: str) -> str:\n    return subprocess.run([\"git\", \"-C\", str(root), *args], capture_output=True, text=True,\n                          check=True).stdout.strip()\n\n\ndef _tenant_with_two_merged_items(tmp_path: Path) -> tuple[Path, str, str]:\n    root = tmp_path / \"sealed\"\n    root.mkdir()\n    subprocess.run([\"git\", \"init\", \"-q\", \"-b\", \"main\", \".\"], cwd=root, check=True)\n    _git(root, \"config\", \"user.email\", \"doctor@attavo.invalid\")\n    _git(root, \"config\", \"user.name\", \"doctor fixture\")\n    (root / \"attavo.toml\").write_text(\n        '[paths]\\nrecords = \"records\"\\n\\n[forge]\\nattestation_command = \"sh ./fake-attest\"\\n')\n    (root / \"fake-attest\").write_text(FAKE_ATTEST)\n    (root / \"sealed.txt\").write_text(\"\")\n    _git(root, \"add\", \".\")\n    _git(root, \"commit\", \"-q\", \"-m\", \"install\")\n    merges = []\n    for item in (\"1\", \"2\"):\n        _git(root, \"checkout\", \"-q\", \"-b\", f\"attavo/{item}-x\")\n        (root / \"records\" / item).mkdir(parents=True)\n        for stage in (\"spec\", \"approval\", \"build\", \"verify\"):\n            (root / \"records\" / item / f\"{stage}-01.json\").write_text('{\"status\": \"pass\"}')\n            _git(root, \"add\", \"records\")\n            _git(root, \"commit\", \"-q\", \"-m\", f\"{stage} record for item {item}\")\n        _git(root, \"checkout\", \"-q\", \"main\")\n        _git(root, \"merge\", \"-q\", \"--no-ff\", \"-m\", f\"Merge branch 'attavo/{item}-x'\", f\"attavo/{item}-x\")\n        merges.append(_git(root, \"rev-parse\", \"HEAD\"))\n    _git(root, \"update-ref\", \"refs/remotes/origin/main\", _git(root, \"rev-parse\", \"main\"))\n    _git(root, \"symbolic-ref\", \"refs/remotes/origin/HEAD\", \"refs/remotes/origin/main\")\n    return root, merges[0], merges[1]\n\n\ndef _tenant_with_one_merged_and_one_unmerged_item(tmp_path: Path) -> Path:\n    root = tmp_path / \"unmerged\"\n    root.mkdir()\n    subprocess.run([\"git\", \"init\", \"-q\", \"-b\", \"main\", \".\"], cwd=root, check=True)\n    _git(root, \"config\", \"user.email\", \"doctor@attavo.invalid\")\n    _git(root, \"config\", \"user.name\", \"doctor fixture\")\n    (root / \"attavo.toml\").write_text(\n        '[paths]\\nrecords = \"records\"\\n\\n[forge]\\nattestation_command = \"sh ./fake-attest\"\\n')\n    (root / \"fake-attest\").write_text(FAKE_ATTEST)\n    (root / \"sealed.txt\").write_text(\"\")\n    _git(root, \"add\", \".\")\n    _git(root, \"commit\", \"-q\", \"-m\", \"install\")\n    _git(root, \"checkout\", \"-q\", \"-b\", \"attavo/1-x\")\n    (root / \"records\" / \"1\").mkdir(parents=True)\n    for stage in (\"spec\", \"approval\", \"build\", \"verify\"):\n        (root / \"records\" / \"1\" / f\"{stage}-01.json\").write_text('{\"status\": \"pass\"}')\n        _git(root, \"add\", \"records\")\n        _git(root, \"commit\", \"-q\", \"-m\", f\"{stage} record for item 1\")\n    _git(root, \"checkout\", \"-q\", \"main\")\n    _git(root, \"merge\", \"-q\", \"--no-ff\", \"-m\", \"Merge branch 'attavo/1-x'\", \"attavo/1-x\")\n    m1 = _git(root, \"rev-parse\", \"HEAD\")\n    (root / \"sealed.txt\").write_text(m1 + \"\\n\")\n    _git(root, \"add\", \"sealed.txt\")\n    _git(root, \"commit\", \"-q\", \"-m\", \"seal item 1\")\n    _git(root, \"checkout\", \"-q\", \"-b\", \"attavo/2-x\")\n    (root / \"records\" / \"2\").mkdir(parents=True)\n    for stage in (\"spec\", \"approval\", \"build\", \"verify\"):\n        (root / \"records\" / \"2\" / f\"{stage}-01.json\").write_text('{\"status\": \"pass\"}')\n        _git(root, \"add\", \"records\")\n        _git(root, \"commit\", \"-q\", \"-m\", f\"{stage} record for item 2\")\n    _git(root, \"checkout\", \"-q\", \"--detach\")\n    _git(root, \"merge\", \"-q\", \"--no-ff\", \"-m\", \"synthetic test merge of attavo/2-x into main\", \"main\")\n    return root\n\n\ndef _proof(root: Path) -> dict:\n    run = subprocess.run([\"python3\", str(ATTAVO), \"doctor\", \"--json\", str(root)],\n                         capture_output=True, text=True, check=False)\n    proofs = json.loads(run.stdout)[\"proofs\"]\n    return [p for p in proofs if p[\"proof\"] == \"every-attested-item-is-sealed\"][0]\n\n\ndef test_doctor_proof_six_fails_on_an_unsealed_merge(tmp_path):\n    root, m1, m2 = _tenant_with_two_merged_items(tmp_path)\n    (root / \"sealed.txt\").write_text(m1 + \"\\n\")\n    p = _proof(root)\n    assert not p[\"holds\"]\n    assert \"item 2\" in p[\"reason\"] and m2[:12] in p[\"reason\"]\n    assert p[\"sealed\"] == [\"1\"] and p[\"unsealed\"] == [\"2\"]\n\n\ndef test_doctor_proof_six_holds_when_every_merge_is_sealed(tmp_path):\n    root, m1, m2 = _tenant_with_two_merged_items(tmp_path)\n    (root / \"sealed.txt\").write_text(m1 + \"\\n\" + m2 + \"\\n\")\n    p = _proof(root)\n    assert p[\"holds\"] and p[\"sealed\"] == [\"1\", \"2\"]\n\n\ndef test_doctor_proof_six_names_a_merge_before_the_window_without_failing(tmp_path):\n    root, m1, m2 = _tenant_with_two_merged_items(tmp_path)\n    (root / \"sealed.txt\").write_text(m2 + \"\\n\")\n    (root / \"attavo.toml\").write_text(\n        '[paths]\\nrecords = \"records\"\\n\\n[forge]\\nattestation_command = \"sh ./fake-attest\"\\n'\n        f'sealed_since = \"{m1}\"\\n')\n    p = _proof(root)\n    assert p[\"holds\"] and p[\"before_window\"] == [\"1\"] and p[\"sealed\"] == [\"2\"]\n\n\ndef test_doctor_proof_six_fails_without_an_attestation_command(tmp_path):\n    root = tmp_path / \"bare\"\n    root.mkdir()\n    subprocess.run([\"git\", \"init\", \"-q\", \"-b\", \"main\", \".\"], cwd=root, check=True)\n    (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n')\n    (root / \"records\").mkdir()\n    p = _proof(root)\n    assert not p[\"holds\"] and \"attestation_command\" in p[\"reason\"]\n\n\ndef test_doctor_proof_six_names_an_unmerged_item(tmp_path):\n    root = _tenant_with_one_merged_and_one_unmerged_item(tmp_path)\n    noref = _proof(root)\n    assert not noref[\"holds\"] and \"refs/remotes/origin/HEAD\" in noref[\"reason\"]\n    _git(root, \"update-ref\", \"refs/remotes/origin/main\", \"main\")\n    _git(root, \"symbolic-ref\", \"refs/remotes/origin/HEAD\", \"refs/remotes/origin/main\")\n    ref = _proof(root)\n    assert ref[\"holds\"]\n    assert ref[\"sealed\"] == [\"1\"] and ref[\"not_merged\"] == [\"2\"] and ref[\"unsealed\"] == []\n","numLines":142,"startLine":1,"totalLines":142}}}

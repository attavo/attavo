+1103,84 @@ def proof_no_stop_lacks_cause(root: Path, m: dict | None) -> Proof:\n                  older_records=older)\n \n \n+def attestation_command(m: dict) -> str | None:\n+    \"\"\"[forge].attestation_command: the tenant's own read of the store,\n+    given a merge sha on stdin, printing the statement as JSON on exit 0\n+    and nothing on a non-zero exit. Absent is not passing (issue #158:\n+    the doctor said done while #106, #148, #153 had no statement in the\n+    store at all -- there was no key to read one through).\"\"\"\n+    cmd = (m.get(\"forge\") or {}).get(\"attestation_command\")\n+    return cmd if isinstance(cmd, str) and cmd.strip() else None\n+\n+\n+def statement_for(root: Path, cmd: str, merge_sha: str) -> dict | None:\n+    \"\"\"The statement the forge holds for merge_sha, or None when the\n+    command exits non-zero or prints anything but a JSON object.\"\"\"\n+    run = subprocess.run(cmd, shell=True, cwd=str(root), input=merge_sha + \"\\n\",\n+                         capture_output=True, text=True, check=False)\n+    if run.returncode != 0:\n+        return None\n+    try:\n+        parsed = json.loads(run.stdout)\n+    except ValueError:\n+        return None\n+    return parsed if isinstance(parsed, dict) else None\n+\n+\n+def _is_ancestor(root: Path, earlier: str, later: str) -> bool:\n+    run = subprocess.run([\"git\", \"-C\", str(root), \"merge-base\", \"--is-ancestor\", earlier, later],\n+                         capture_output=True, check=False)\n+    return run.returncode == 0\n+\n+\n+def proof_every_attested_item_is_sealed(root: Path, m: dict | None) -> Proof:\n+    p = Proof(\"every-attested-item-is-sealed\", \"every attested item has its statement in the store\")\n+    if m is None:\n+        return p.fail(f\"no {MANIFEST} at {root}; no records directory is declared\")\n+    cmd = attestation_command(m)\n+    if cmd is None:\n+        return p.fail(\"no [forge].attestation_command in the manifest; the store cannot be read\")\n+    records_rel = m.get(\"paths\", {}).get(\"records\", \"\")\n+    records_dir = root / records_rel\n+    if not records_dir.is_dir():\n+        return p.fail(f\"no records directory under {records_dir}\")\n+    items = load_records(records_dir)\n+    complete = [item for item, stages in sorted(items.items()) if all(s in stages for s in STAGES)]\n+\n+    # [forge].sealed_since: merges at or before this sha predate the\n+    # tenant's merge queue -- the self-tenant's own #106, #148, #153 were\n+    # merged direct, with no merge_group run to seal them. They are\n+    # named, never failed, the same window convention proof three keeps\n+    # for commits before the manifest's own install.\n+    since = (m.get(\"forge\") or {}).get(\"sealed_since\")\n+    sealed: list[str] = []\n+    before_window: list[str] = []\n+    unsealed: list[str] = []\n+    reasons: list[str] = []\n+    for item in complete:\n+        merge_sha = merge_introducing_records(root, records_rel, item, STAGES)\n+        if merge_sha is None:\n+            continue\n+        if statement_for(root, cmd, merge_sha) is not None:\n+            sealed.append(item)\n+        elif isinstance(since, str) and since.strip() and _is_ancestor(root, merge_sha, since):\n+            before_window.append(item)\n+        else:\n+            unsealed.append(item)\n+            reasons.append(f\"item {item} merged at {merge_sha[:12]} has no statement in the store\")\n+    if reasons:\n+        return p.fail(\"; \".join(reasons), sealed=sealed, before_window=before_window, unsealed=unsealed)\n+    return p.hold(f\"{len(sealed)} merged item(s) sealed, {len(before_window)} before the window\",\n+                 sealed=sealed, before_window=before_window, unsealed=unsealed)\n+\n+\n def doctor(root: Path) -> list[Proof]:\n     m = read_manifest(root)\n     return [proof_every_gate_rejects(root, m),\n             proof_one_item_every_stage(root, m),\n             proof_no_commit_lacks_record(root, m),\n-            proof_no_stop_lacks_cause(root, m)]\n+            proof_no_stop_lacks_cause(root, m),\n+            proof_every_attested_item_is_sealed(root, m)]\n \n \n def cmd_doctor(argv: list[str]) -> int:\ndiff --git a/schema/manifest.schema.json b/schema/manifest.schema.json\nindex 6dc7c15..105b511 100644\n--- a/schema/manifest.schema.json\n+++ b/schema/manifest.schema.json\n@@ -88,6 +88,16 @@\n           \"type\": \"string\",\n           \"description\": \"Reads one finding as JSON on stdin and files it as a tenant issue. attavo file-findings runs it once per finding in the item's latest verify record.\",\n           \"minLength\": 1\n+        },\n+        \"attestation_command\": {\n+          \"type\": \"string\",\n+          \"description\": \"Reads a merge commit sha on stdin and prints that merge's attestation statement as JSON on exit 0; nothing on a non-zero exit. The doctor's fifth proof runs it once per merged, fully-staged item to require a statement in the store.\",\n+          \"minLength\": 1\n+        },\n+        \"sealed_since\": {\n+          \"type\": \"string\",\n+          \"description\": \"A commit sha. A merge at or before it predates the tenant's merge queue and is named by the doctor's fifth proof as before the window rather than failed.\",\n+          \"minLength\": 7\n         }\n       }\n     },\ndiff --git a/tests/test_doctor.py b/tests/test_doctor.py\nindex d147948..2cfcc32 100644\n--- a/tests/test_doctor.py\n+++ b/tests/test_doctor.py\n@@ -1,6 +1,6 @@\n-\"\"\"The doctor's four proofs, as tests written before the capability.\n+\"\"\"The doctor's five proofs, as tests written before the capability.\n \n-Each test asserts that one proof holds against this repository. All four\n+Each test asserts that one proof holds against this repository. All five\n fail at the first commit and must fail: that is the definition of done,\n stated before anything exists to satisfy it. A test here turns green only\n when the capability it names has landed and been used for real.\n@@ -58,6 +58,15 @@ def test_no_stop_lacks_cause():\n     assert p[\"holds\"], p[\"reason\"]\n \n \n+def test_every_attested_item_is_sealed():\n+    \"\"\"Proof 5, issue #158. Every merged, fully-staged item has a\n+    statement in the forge's attestation store for its merge commit --\n+    #106, #148, #153 predate [forge].sealed_since and are named before the\n+    window instead.\"\"\"\n+    p = run_doctor(ROOT)[\"every-attested-item-is-sealed\"]\n+    assert p[\"holds\"], p[\"reason\"]\n+\n+\n def test_record_loader_uses_highest_attempt_number(tmp_path):\n     \"\"\"Acceptance 2a. <stage>-NN.json files are one stage's attempts; the\n     doctor treats the highest NN as latest, and STAGES is unchanged.","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}

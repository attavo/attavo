{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VttH51nXHfbAWCpb5iPGVM","type":"tool_result","content":"1\t\"\"\"Shared helpers for building tenant fixtures at test time.\n2\t\n3\tFixtures under tests/fixtures/ are plain file trees, not git repositories;\n4\teach test copies the one it needs into a tmp_path and initializes it as its\n5\town repository, so every test gets a clean, independent commit history.\n6\t\"\"\"\n7\tfrom __future__ import annotations\n8\t\n9\timport shutil\n10\timport subprocess\n11\tfrom pathlib import Path\n12\t\n13\tFIXTURES = Path(__file__).resolve().parent / \"fixtures\"\n14\t\n15\t\n16\tdef git(root: Path, *args: str) -> str:\n17\t    out = subprocess.run([\"git\", \"-C\", str(root), *args], capture_output=True,\n18\t                         text=True, check=True)\n19\t    return out.stdout\n20\t\n21\t\n22\tdef init_repo(root: Path, message: str = \"initial\") -> None:\n23\t    git(root, \"init\", \"-q\", \"-b\", \"main\")\n24\t    git(root, \"config\", \"user.email\", \"test@example.com\")\n25\t    git(root, \"config\", \"user.name\", \"Attavo Test\")\n26\t    git(root, \"add\", \"-A\")\n27\t    git(root, \"commit\", \"-q\", \"-m\", message)\n28\t    # attavo verify reads refs/remotes/origin/HEAD to diff the item's own\n29\t    # work against (issue #52); a real checkout always has this once\n30\t    # cloned, so fixtures fake it here rather than making every test set\n31\t    # up its own origin remote.\n32\t    sha = git(root, \"rev-parse\", \"HEAD\").strip()\n33\t    git(root, \"update-ref\", \"refs/remotes/origin/main\", sha)\n34\t    git(root, \"symbolic-ref\", \"refs/remotes/origin/HEAD\", \"refs/remotes/origin/main\")\n35\t\n36\t\n37\tdef commit_all(root: Path, message: str) -> None:\n38\t    git(root, \"add\", \"-A\")\n39\t    git(root, \"commit\", \"-q\", \"-m\", message)\n40\t\n41\t\n42\tdef clone_shallow(root: Path, dest: Path) -> None:\n43\t    \"\"\"A --depth 1 clone of root, the same history-truncated checkout\n44\t    actions/checkout@v4 leaves behind with no fetch-depth set.\n45\t    \"\"\"\n46\t    subprocess.run([\"git\", \"clone\", \"--quiet\", \"--depth\", \"1\", \"--branch\",\n47\t                    git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip(),\n48\t                    f\"file://{root}\", str(dest)],\n49\t                   capture_output=True, text=True, check=True)\n50\t\n51\t\n52\tdef make_tenant(tmp_path: Path, fixture: str, name: str | None = None) -> Path:\n53\t    \"\"\"Copy tests/fixtures/<fixture> to a fresh dir and git-init + commit it.\"\"\"\n54\t    dest = tmp_path / (name or fixture)\n55\t    shutil.copytree(FIXTURES / fixture, dest)\n56\t    init_repo(dest)\n57\t    return dest\n58\t\n59\t\n60\tdef job_if_condition(yaml_text: str, job_name: str) -> str | None:\n61\t    \"\"\"Pull a workflow job's top-level `if:` condition out of template YAML\n62\t    text, or None if the job has no such condition. Reads the literal file\n63\t    rather than reimplementing YAML parsing, same as extract_step_run.\n64\t    \"\"\"\n65\t    lines = yaml_text.splitlines()\n66\t    marker = f\"{job_name}:\"\n67\t    start = next(i for i, l in enumerate(lines) if l.strip() == marker)\n68\t    job_indent = len(lines[start]) - len(lines[start].lstrip(\" \"))\n69\t    body_indent = job_indent + 2\n70\t    for line in lines[start + 1:]:\n71\t        if not line.strip():\n72\t            continue\n73\t        indent = len(line) - len(line.lstrip(\" \"))\n74\t        if indent < body_indent:\n75\t            break\n76\t        if indent == body_indent and line.strip().startswith(\"if:\"):\n77\t            return line.strip()[len(\"if:\"):].strip()\n78\t    return None\n79\t\n80\t\n81\tdef step_block(yaml_text: str, marker: str) -> str:\n82\t    \"\"\"The raw lines of one workflow step, from the line matching `marker`\n83\t    exactly (its stripped text -- typically \"- name: X\" or \"- uses: X\") to\n84\t    the line before the next step at the same indent, or the file's end.\n85\t    Reads the literal file rather than reimplementing YAML parsing, same\n86\t    as job_if_condition and extract_step_run.\n87\t    \"\"\"\n88\t    lines = yaml_text.splitlines()\n89\t    start = next(i for i, l in enumerate(lines) if l.strip() == marker)\n90\t    step_indent = len(lines[start]) - len(lines[start].lstrip(\" \"))\n91\t    end = len(lines)\n92\t    for i in range(start + 1, len(lines)):\n93\t        line = lines[i]\n94\t        if not line.strip():\n95\t            continue\n96\t        indent = len(line) - len(line.lstrip(\" \"))\n97\t        if indent <= step_indent and line.lstrip().startswith(\"- \"):\n98\t            end = i\n99\t            break\n100\t    return \"\\n\".join(lines[start:end])\n101\t\n102\t\n103\tdef with_keys(step_text: str) -> list[str]:\n104\t    \"\"\"The top-level keys of a step's `with:` mapping, from a step_block's\n105\t    text. Reads the literal file rather than reimplementing YAML parsing,\n106\t    same as job_if_condition, step_block, and extract_step_run.\n107\t    \"\"\"\n108\t    lines = step_text.splitlines()\n109\t    start = next(i for i, l in enumerate(lines) if l.strip() == \"with:\")\n110\t    with_indent = len(lines[start]) - len(lines[start].lstrip(\" \"))\n111\t    keys = []\n112\t    for line in lines[start + 1:]:\n113\t        if not line.strip():\n114\t            continue\n115\t        indent = len(line) - len(line.lstrip(\" \"))\n116\t        if indent <= with_indent:\n117\t            break\n118\t        if \":\" in line.strip():\n119\t            keys.append(line.strip().split(\":\", 1)[0].strip())\n120\t    return keys\n121\t\n122\t\n123\tdef extract_step_run(yaml_text: str, step_name: str) -> str:\n124\t    \"\"\"Pull a workflow step's `run:` command out of template YAML text as-is,\n125\t    so a test exercises the literal shell the step will run rather than a\n126\t    reimplementation of it. Handles both `run: cmd` and `run: |` block forms.\n127\t    \"\"\"\n128\t    lines = yaml_text.splitlines()\n129\t    marker = f\"- name: {step_name}\"\n130\t    start = next(i for i, l in enumerate(lines) if l.strip() == marker)\n131\t    step_indent = len(lines[start]) - len(lines[start].lstrip(\" \"))\n132\t    body_indent = step_indent + 2\n133\t    run_idx = next(\n134\t        i for i in range(start + 1, len(lines))\n135\t        if lines[i].strip().startswith(\"run:\")\n136\t        and (len(lines[i]) - len(lines[i].lstrip(\" \"))) == body_indent)\n137\t    run_line = lines[run_idx].strip()[len(\"run:\"):].strip()\n138\t    if run_line and not run_line.startswith(\"|\"):\n139\t        return run_line\n140\t    block: list[str] = []\n141\t    block_indent = None\n142\t    for line in lines[run_idx + 1:]:\n143\t        if not line.strip():\n144\t            block.append(\"\")\n145\t            continue\n146\t        indent = len(line) - len(line.lstrip(\" \"))\n147\t        if indent <= body_indent:\n148\t            break\n149\t        if block_indent is None:\n150\t            block_indent = indent\n151\t        block.append(line[block_indent:])\n152\t    return \"\\n\".join(block).rstrip(\"\\n\")\n153\t"}]},"parent_tool_use_id":null,"session_id":"27622edb-2b84-4e29-a521-f056f17ac0a6","uuid":"4778f883-492c-4e07-80bc-9443536ed5bb","timestamp":"2026-09-17T20:40:19.061Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-158/tests/helpers.py","content":"\"\"\"Shared helpers for building tenant fixtures at test time.\n\nFixtures under tests/fixtures/ are plain file trees, not git repositories;\neach test copies the one it needs into a tmp_path and initializes it as its\nown repository, so every test gets a clean, independent commit history.\n\"\"\"\nfrom __future__ import annotations\n\nimport shutil\nimport subprocess\nfrom pathlib import Path\n\nFIXTURES = Path(__file__).resolve().parent / \"fixtures\"\n\n\ndef git(root: Path, *args: str) -> str:\n    out = subprocess.run([\"git\", \"-C\", str(root), *args], capture_output=True,\n                         text=True, check=True)\n    return out.stdout\n\n\ndef init_repo(root: Path, message: str = \"initial\") -> None:\n    git(root, \"init\", \"-q\", \"-b\", \"main\")\n    git(root, \"config\", \"user.email\", \"test@example.com\")\n    git(root, \"config\", \"user.name\", \"Attavo Test\")\n    git(root, \"add\", \"-A\")\n    git(root, \"commit\", \"-q\", \"-m\", message)\n    # attavo verify reads refs/remotes/origin/HEAD to diff the item's own\n    # work against (issue #52); a real checkout always has this once\n    # cloned, so fixtures fake it here rather than making every test set\n    # up its own origin remote.\n    sha = git(root, \"rev-parse\", \"HEAD\").strip()\n    git(root, \"update-ref\", \"refs/remotes/origin/main\", sha)\n    git(root, \"symbolic-ref\", \"refs/remotes/origin/HEAD\", \"refs/remotes/origin/main\")\n\n\ndef commit_all(root: Path, message: str) -> None:\n    git(root, \"add\", \"-A\")\n    git(root, \"commit\", \"-q\", \"-m\", message)\n\n\ndef clone_shallow(root: Path, dest: Path) -> None:\n    \"\"\"A --depth 1 clone of root, the same history-truncated checkout\n    actions/checkout@v4 leaves behind with no fetch-depth set.\n    \"\"\"\n    subprocess.run([\"git\", \"clone\", \"--quiet\", \"--depth\", \"1\", \"--branch\",\n                    git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip(),\n                    f\"file://{root}\", str(dest)],\n                   capture_output=True, text=True, check=True)\n\n\ndef make_tenant(tmp_path: Path, fixture: str, name: str | None = None) -> Path:\n    \"\"\"Copy tests/fixtures/<fixture> to a fresh dir and git-init + commit it.\"\"\"\n    dest = tmp_path / (name or fixture)\n    shutil.copytree(FIXTURES / fixture, dest)\n    init_repo(dest)\n    return dest\n\n\ndef job_if_condition(yaml_text: str, job_name: str) -> str | None:\n    \"\"\"Pull a workflow job's top-level `if:` condition out of template YAML\n    text, or None if the job has no such condition. Reads the literal file\n    rather than reimplementing YAML parsing, same as extract_step_run.\n    \"\"\"\n    lines = yaml_text.splitlines()\n    marker = f\"{job_name}:\"\n    start = next(i for i, l in enumerate(lines) if l.strip() == marker)\n    job_indent = len(lines[start]) - len(lines[start].lstrip(\" \"))\n    body_indent = job_indent + 2\n    for line in lines[start + 1:]:\n        if not line.strip():\n            continue\n        indent = len(line) - len(line.lstrip(\" \"))\n        if indent < body_indent:\n            break\n        if indent == body_indent and line.strip().startswith(\"if:\"):\n            return line.strip()[len(\"if:\"):].strip()\n    return None\n\n\ndef step_block(yaml_text: str, marker: str) -> str:\n    \"\"\"The raw lines of one workflow step, from the line matching `marker`\n    exactly (its stripped text -- typically \"- name: X\" or \"- uses: X\") to\n    the line before the next step at the same indent, or the file's end.\n    Reads the literal file rather than reimplementing YAML parsing, same\n    as job_if_condition and extract_step_run.\n    \"\"\"\n    lines = yaml_text.splitlines()\n    start = next(i for i, l in enumerate(lines) if l.strip() == marker)\n    step_indent = len(lines[start]) - len(lines[start].lstrip(\" \"))\n    end = len(lines)\n    for i in range(start + 1, len(lines)):\n        line = lines[i]\n        if not line.strip():\n            continue\n        indent = len(line) - len(line.lstrip(\" \"))\n        if indent <= step_indent and line.lstrip().startswith(\"- \"):\n            end = i\n            break\n    return \"\\n\".join(lines[start:end])\n\n\ndef with_keys(step_text: str) -> list[str]:\n    \"\"\"The top-level keys of a step's `with:` mapping, from a step_block's\n    text. Reads the literal file rather than reimplementing YAML parsing,\n    same as job_if_condition, step_block, and extract_step_run.\n    \"\"\"\n    lines = step_text.splitlines()\n    start = next(i for i, l in enumerate(lines) if l.strip() == \"with:\")\n    with_indent = len(lines[start]) - len(lines[start].lstrip(\" \"))\n    keys = []\n    for line in lines[start + 1:]:\n        if not line.strip():\n            continue\n        indent = len(line) - len(line.lstrip(\" \"))\n        if indent <= with_indent:\n            break\n        if \":\" in line.strip():\n            keys.append(line.strip().split(\":\", 1)[0].strip())\n    return keys\n\n\ndef extract_step_run(yaml_text: str, step_name: str) -> str:\n    \"\"\"Pull a workflow step's `run:` command out of template YAML text as-is,\n    so a test exercises the literal shell the step will run rather than a\n    reimplementation of it. Handles both `run: cmd` and `run: |` block forms.\n    \"\"\"\n    lines = yaml_text.splitlines()\n    marker = f\"- name: {step_name}\"\n    start = next(i for i, l in enumerate(lines) if l.strip() == marker)\n    step_indent = len(lines[start]) - len(lines[start].lstrip(\" \"))\n    body_indent = step_indent + 2\n    run_idx = next(\n        i for i in range(start + 1, len(lines))\n        if lines[i].strip().startswith(\"run:\")\n        and (len(lines[i]) - len(lines[i].lstrip(\" \"))) == body_indent)\n    run_line = lines[run_idx].strip()[len(\"run:\"):].strip()\n    if run_line and not run_line.startswith(\"|\"):\n        return run_line\n    block: list[str] = []\n    block_indent = None\n    for line in lines[run_idx + 1:]:\n        if not line.strip():\n            block.append(\"\")\n            continue\n        indent = len(line) - len(line.lstrip(\" \"))\n        if indent <= body_indent:\n            break\n        if block_indent is None:\n            block_indent = indent\n        block.append(line[block_indent:])\n    return \"\\n\".join(block).rstrip(\"\\n\")\n","numLines":153,"startLine":1,"totalLines":153}}}

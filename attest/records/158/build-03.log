{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01ETLjpMtNrmzRLW7cNWGMaf","type":"tool_result","content":"#!/usr/bin/env python3\n\"\"\"forge-checks: [forge].checks_command for attavo verify (issue #103).\n\nPrints one line per GitHub check-run on `sha` as \"<name> <conclusion>\";\na check that has not concluded prints its status in place of a\nconclusion -- attavo verify's own read of these lines decides whether\nthat is green, not this script. Exits non-zero, printing nothing to\nstdout, when the sha cannot be read at all (the forge does not know it,\nor the API call otherwise fails): attavo verify appends the sha to this\ncommand string and runs it under a shell, and reads a nonzero exit alone\nas \"not green.\"\n\nWritten from schema/manifest.schema.json's own description of\n[forge].checks_command and from `gh`, independently of tenant zero's\nequivalent script.\n\nUsage: forge-checks <sha>\nRequires: `gh`, authenticated, run inside this repository's checkout.\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport subprocess\nimport sys\n\n\ndef main(argv: list[str]) -> int:\n    if len(argv) != 1:\n        print(\"usage: forge-checks <sha>\", file=sys.stderr)\n        return 2\n    sha = argv[0]\n    run = subprocess.run(\n        [\"gh\", \"api\", f\"repos/{{owner}}/{{repo}}/commits/{sha}/check-runs?per_page=100\"],\n        capture_output=True, text=True, timeout=30, check=False,\n    )\n    if run.returncode != 0:\n        print(run.stderr.strip() or f\"forge-checks: sha {sha} not found\", file=sys.stderr)\n        return 1\n    try:\n        payload = json.loads(run.stdout)\n    except json.JSONDecodeError:\n        print(f\"forge-checks: unexpected response for sha {sha}\", file=sys.stderr)\n        return 1\n    for check in payload.get(\"check_runs\", []):\n        state = check.get(\"conclusion\") or check.get(\"status\")\n        print(f\"{check['name']} {state}\")\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main(sys.argv[1:]))","is_error":false}]},"parent_tool_use_id":null,"session_id":"27622edb-2b84-4e29-a521-f056f17ac0a6","uuid":"6c353dc0-c4c2-4e31-8cfe-961e313a7235","timestamp":"2026-09-17T20:37:31.593Z","tool_use_result":{"stdout":"#!/usr/bin/env python3\n\"\"\"forge-checks: [forge].checks_command for attavo verify (issue #103).\n\nPrints one line per GitHub check-run on `sha` as \"<name> <conclusion>\";\na check that has not concluded prints its status in place of a\nconclusion -- attavo verify's own read of these lines decides whether\nthat is green, not this script. Exits non-zero, printing nothing to\nstdout, when the sha cannot be read at all (the forge does not know it,\nor the API call otherwise fails): attavo verify appends the sha to this\ncommand string and runs it under a shell, and reads a nonzero exit alone\nas \"not green.\"\n\nWritten from schema/manifest.schema.json's own description of\n[forge].checks_command and from `gh`, independently of tenant zero's\nequivalent script.\n\nUsage: forge-checks <sha>\nRequires: `gh`, authenticated, run inside this repository's checkout.\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport subprocess\nimport sys\n\n\ndef main(argv: list[str]) -> int:\n    if len(argv) != 1:\n        print(\"usage: forge-checks <sha>\", file=sys.stderr)\n        return 2\n    sha = argv[0]\n    run = subprocess.run(\n        [\"gh\", \"api\", f\"repos/{{owner}}/{{repo}}/commits/{sha}/check-runs?per_page=100\"],\n        capture_output=True, text=True, timeout=30, check=False,\n    )\n    if run.returncode != 0:\n        print(run.stderr.strip() or f\"forge-checks: sha {sha} not found\", file=sys.stderr)\n        return 1\n    try:\n        payload = json.loads(run.stdout)\n    except json.JSONDecodeError:\n        print(f\"forge-checks: unexpected response for sha {sha}\", file=sys.stderr)\n        return 1\n    for check in payload.get(\"check_runs\", []):\n        state = check.get(\"conclusion\") or check.get(\"status\")\n        print(f\"{check['name']} {state}\")\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main(sys.argv[1:]))","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SxnaAC7DJPVj7kCimoqeMp","type":"tool_result","content":"1\t\"\"\"The doctor's four proofs, as tests written before the capability.\n2\t\n3\tEach test asserts that one proof holds against this repository. All four\n4\tfail at the first commit and must fail: that is the definition of done,\n5\tstated before anything exists to satisfy it. A test here turns green only\n6\twhen the capability it names has landed and been used for real.\n7\t\n8\tRun: python3 -m pytest tests -q\n9\t\"\"\"\n10\timport json\n11\timport shutil\n12\timport subprocess\n13\timport sys\n14\tfrom pathlib import Path\n15\t\n16\tfrom helpers import FIXTURES, commit_all, init_repo, make_tenant\n17\t\n18\tROOT = Path(__file__).resolve().parent.parent\n19\tATTAVO = ROOT / \"bin\" / \"attavo\"\n20\t\n21\t\n22\tdef run_doctor(root: Path) -> dict:\n23\t    out = subprocess.run([sys.executable, str(ATTAVO), \"doctor\", str(root), \"--json\"],\n24\t                         capture_output=True, text=True, check=False)\n25\t    report = json.loads(out.stdout)\n26\t    assert out.returncode == (0 if report[\"done\"] else 1)\n27\t    return {p[\"proof\"]: p for p in report[\"proofs\"]}\n28\t\n29\t\n30\tdef test_every_gate_rejects():\n31\t    \"\"\"Proof 1. Every gate in the manifest rejects its rejection fixture.\n32\t\n33\t    Holds when: a manifest exists, [gates] names at least one gate, each gate\n34\t    has a fixture under paths.rejections, and each gate exits non-zero on it.\n35\t    \"\"\"\n36\t    p = run_doctor(ROOT)[\"every-gate-rejects\"]\n37\t    assert p[\"holds\"], p[\"reason\"]\n38\t\n39\t\n40\tdef test_one_item_traversed_every_stage():\n41\t    \"\"\"Proof 2. One work item carries a record for spec, approval, build,\n42\t    verify, and attestation, every one written by a script.\"\"\"\n43\t    p = run_doctor(ROOT)[\"one-item-every-stage\"]\n44\t    assert p[\"holds\"], p[\"reason\"]\n45\t\n46\t\n47\tdef test_no_commit_lacks_a_record():\n48\t    \"\"\"Proof 3. Every commit on the default branch after the manifest was\n49\t    introduced is named by a record's sha or commits list.\"\"\"\n50\t    p = run_doctor(ROOT)[\"no-commit-lacks-record\"]\n51\t    assert p[\"holds\"], p[\"reason\"]\n52\t\n53\t\n54\tdef test_no_stop_lacks_cause():\n55\t    \"\"\"Proof 4, issue #94. Every non-pass build or verify record at\n56\t    record_version 3 or later carries a stop naming its class and cause.\"\"\"\n57\t    p = run_doctor(ROOT)[\"no-stop-lacks-cause\"]\n58\t    assert p[\"holds\"], p[\"reason\"]\n59\t\n60\t"}]},"parent_tool_use_id":null,"session_id":"27622edb-2b84-4e29-a521-f056f17ac0a6","uuid":"9b4b1da5-67f4-4336-a60c-60137650dc71","timestamp":"2026-09-17T20:41:41.812Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-158/tests/test_doctor.py","content":"\"\"\"The doctor's four proofs, as tests written before the capability.\n\nEach test asserts that one proof holds against this repository. All four\nfail at the first commit and must fail: that is the definition of done,\nstated before anything exists to satisfy it. A test here turns green only\nwhen the capability it names has landed and been used for real.\n\nRun: python3 -m pytest tests -q\n\"\"\"\nimport json\nimport shutil\nimport subprocess\nimport sys\nfrom pathlib import Path\n\nfrom helpers import FIXTURES, commit_all, init_repo, make_tenant\n\nROOT = Path(__file__).resolve().parent.parent\nATTAVO = ROOT / \"bin\" / \"attavo\"\n\n\ndef run_doctor(root: Path) -> dict:\n    out = subprocess.run([sys.executable, str(ATTAVO), \"doctor\", str(root), \"--json\"],\n                         capture_output=True, text=True, check=False)\n    report = json.loads(out.stdout)\n    assert out.returncode == (0 if report[\"done\"] else 1)\n    return {p[\"proof\"]: p for p in report[\"proofs\"]}\n\n\ndef test_every_gate_rejects():\n    \"\"\"Proof 1. Every gate in the manifest rejects its rejection fixture.\n\n    Holds when: a manifest exists, [gates] names at least one gate, each gate\n    has a fixture under paths.rejections, and each gate exits non-zero on it.\n    \"\"\"\n    p = run_doctor(ROOT)[\"every-gate-rejects\"]\n    assert p[\"holds\"], p[\"reason\"]\n\n\ndef test_one_item_traversed_every_stage():\n    \"\"\"Proof 2. One work item carries a record for spec, approval, build,\n    verify, and attestation, every one written by a script.\"\"\"\n    p = run_doctor(ROOT)[\"one-item-every-stage\"]\n    assert p[\"holds\"], p[\"reason\"]\n\n\ndef test_no_commit_lacks_a_record():\n    \"\"\"Proof 3. Every commit on the default branch after the manifest was\n    introduced is named by a record's sha or commits list.\"\"\"\n    p = run_doctor(ROOT)[\"no-commit-lacks-record\"]\n    assert p[\"holds\"], p[\"reason\"]\n\n\ndef test_no_stop_lacks_cause():\n    \"\"\"Proof 4, issue #94. Every non-pass build or verify record at\n    record_version 3 or later carries a stop naming its class and cause.\"\"\"\n    p = run_doctor(ROOT)[\"no-stop-lacks-cause\"]\n    assert p[\"holds\"], p[\"reason\"]\n\n","numLines":60,"startLine":1,"totalLines":746}}}

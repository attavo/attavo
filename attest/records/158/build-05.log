{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Rctvy1dhAEkYqCG4AvU9hE","type":"tool_result","content":"== attest/specs/158/criteria/doctor-fails-on-an-unsealed-merge.sh ==\n#!/bin/sh\nset -e\nhere=$(pwd)\ntmp=$(mktemp -d)\ncd \"$tmp\"\ngit init -q -b main .\ngit config user.email doctor@attavo.invalid\ngit config user.name \"doctor fixture\"\nprintf '[paths]\\nrecords = \"records\"\\n\\n[forge]\\nattestation_command = \"sh ./fake-attest\"\\n' > attavo.toml\nprintf '#!/bin/sh\\nread sha\\ngrep -qx \"$sha\" sealed.txt && printf %s \"{\\\\\"_type\\\\\": \\\\\"https://in-toto.io/Statement/v1\\\\\", \\\\\"subject\\\\\": [{\\\\\"digest\\\\\": {\\\\\"sha256\\\\\": \\\\\"$sha\\\\\"}}]}\"\\n' > fake-attest\nprintf '' > sealed.txt\ngit add attavo.toml fake-attest sealed.txt\ngit commit -q -m install\nfor i in 1 2\ndo\n  git checkout -q -b \"attavo/$i-x\"\n  mkdir -p \"records/$i\"\n  for stage in spec approval build verify\n  do\n    printf '{\"status\": \"pass\"}' > \"records/$i/$stage-01.json\"\n    git add records\n    git commit -q -m \"$stage record for item $i\"\n  done\n  git checkout -q main\n  git merge -q --no-ff -m \"Merge branch 'attavo/$i-x'\" \"attavo/$i-x\"\ndone\ngit update-ref refs/remotes/origin/main \"$(git rev-parse main)\"\ngit symbolic-ref refs/remotes/origin/HEAD refs/remotes/origin/main\nm1=$(git log --merges --format=%H --grep=\"attavo/1-x\" -1)\nm2=$(git log --merges --format=%H --grep=\"attavo/2-x\" -1)\nprintf '%s\\n' \"$m1\" > sealed.txt\ncd \"$here\"\npython3 bin/attavo doctor --json \"$tmp\" > \"$tmp/doctor-one.json\" || true\nprintf '%s\\n%s\\n' \"$m1\" \"$m2\" > \"$tmp/sealed.txt\"\npython3 bin/attavo doctor --json \"$tmp\" > \"$tmp/doctor-both.json\" || true\npython3 - \"$tmp/doctor-one.json\" \"$tmp/doctor-both.json\" \"$m2\" <<'PY'\nimport json, sys\ndef proof(path):\n    d = json.load(open(path))\n    return [x for x in d[\"proofs\"] if x[\"proof\"] == \"every-attested-item-is-sealed\"][0]\none = proof(sys.argv[1])\nassert one[\"holds\"] is False, one\nassert \"item 2\" in one[\"reason\"] and sys.argv[3][:12] in one[\"reason\"], one\nassert one[\"unsealed\"] == [\"2\"] and one[\"sealed\"] == [\"1\"], one\nboth = proof(sys.argv[2])\nassert both[\"holds\"] is True and both[\"sealed\"] == [\"1\", \"2\"], both\nPY\nrm -rf \"$tmp\"\n\n== attest/specs/158/criteria/doctor-fails-without-attestation-command.sh ==\n#!/bin/sh\nset -e\nhere=$(pwd)\ntmp=$(mktemp -d)\ncd \"$tmp\"\ngit init -q -b main .\ngit config user.email doctor@attavo.invalid\ngit config user.name \"doctor fixture\"\nprintf '[paths]\\nrecords = \"records\"\\n' > attavo.toml\nmkdir -p records\ngit add attavo.toml\ngit commit -q -m install\ngit update-ref refs/remotes/origin/main \"$(git rev-parse main)\"\ngit symbolic-ref refs/remotes/origin/HEAD refs/remotes/origin/main\ncd \"$here\"\npython3 bin/attavo doctor --json \"$tmp\" | python3 -c 'import json,sys; p=[x for x in json.load(sys.stdin)[\"proofs\"] if x[\"proof\"]==\"every-attested-item-is-sealed\"][0]; assert p[\"holds\"] is False and \"attestation_command\" in p[\"reason\"], p'\npython3 -c 'import json; s=json.load(open(\"schema/manifest.schema.json\")); assert \"attestation_command\" in s[\"properties\"][\"forge\"][\"properties\"], s[\"properties\"][\"forge\"]'\nrm -rf \"$tmp\"\n\n== attest/specs/158/criteria/doctor-names-an-unmerged-item.sh ==\n#!/bin/sh\nset -e\nhere=$(pwd)\ntmp=$(mktemp -d)\ncd \"$tmp\"\ngit init -q -b main .\ngit config user.email doctor@attavo.invalid\ngit config user.name \"doctor fixture\"\nprintf '[paths]\\nrecords = \"records\"\\n\\n[forge]\\nattestation_command = \"sh ./fake-attest\"\\n' > attavo.toml\nprintf '#!/bin/sh\\nread sha\\ngrep -qx \"$sha\" sealed.txt && printf %s \"{\\\\\"_type\\\\\": \\\\\"https://in-toto.io/Statement/v1\\\\\"}\"\\n' > fake-attest\nprintf '' > sealed.txt\ngit add attavo.toml fake-attest sealed.txt\ngit commit -q -m install\ngit checkout -q -b attavo/1-x\nmkdir -p records/1\nfor stage in spec approval bui
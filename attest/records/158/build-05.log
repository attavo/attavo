" sealed.txt && printf %s '\n    '\"{\\\\\"_type\\\\\": \\\\\"https://in-toto.io/Statement/v1\\\\\"}\"\\n'\n)\n\n\ndef _git(root: Path, *args: str) -> str:\n    return subprocess.run([\"git\", \"-C\", str(root), *args], capture_output=True, text=True,\n                          check=True).stdout.strip()\n\n\ndef _tenant_with_two_merged_items(tmp_path: Path) -> tuple[Path, str, str]:\n    root = tmp_path / \"sealed\"\n    root.mkdir()\n    subprocess.run([\"git\", \"init\", \"-q\", \"-b\", \"main\", \".\"], cwd=root, check=True)\n    _git(root, \"config\", \"user.email\", \"doctor@attavo.invalid\")\n    _git(root, \"config\", \"user.name\", \"doctor fixture\")\n    (root / \"attavo.toml\").write_text(\n        '[paths]\\nrecords = \"records\"\\n\\n[forge]\\nattestation_command = \"sh ./fake-attest\"\\n')\n    (root / \"fake-attest\").write_text(FAKE_ATTEST)\n    (root / \"sealed.txt\").write_text(\"\")\n    _git(root, \"add\", \".\")\n    _git(root, \"commit\", \"-q\", \"-m\", \"install\")\n    merges = []\n    for item in (\"1\", \"2\"):\n        _git(root, \"checkout\", \"-q\", \"-b\", f\"attavo/{item}-x\")\n        (root / \"records\" / item).mkdir(parents=True)\n        for stage in (\"spec\", \"approval\", \"build\", \"verify\"):\n            (root / \"records\" / item / f\"{stage}-01.json\").write_text('{\"status\": \"pass\"}')\n            _git(root, \"add\", \"records\")\n            _git(root, \"commit\", \"-q\", \"-m\", f\"{stage} record for item {item}\")\n        _git(root, \"checkout\", \"-q\", \"main\")\n        _git(root, \"merge\", \"-q\", \"--no-ff\", \"-m\", f\"Merge branch 'attavo/{item}-x'\", f\"attavo/{item}-x\")\n        merges.append(_git(root, \"rev-parse\", \"HEAD\"))\n    return root, merges[0], merges[1]\n\n\ndef _proof(root: Path) -> dict:\n    run = subprocess.run([\"python3\", str(ATTAVO), \"doctor\", \"--json\", str(root)],\n                         capture_output=True, text=True, check=False)\n    proofs = json.loads(run.stdout)[\"proofs\"]\n    return [p for p in proofs if p[\"proof\"] == \"every-attested-item-is-sealed\"][0]\n\n\ndef test_doctor_proof_six_fails_on_an_unsealed_merge(tmp_path):\n    root, m1, m2 = _tenant_with_two_merged_items(tmp_path)\n    (root / \"sealed.txt\").write_text(m1 + \"\\n\")\n    p = _proof(root)\n    assert not p[\"holds\"]\n    assert \"item 2\" in p[\"reason\"] and m2[:12] in p[\"reason\"]\n    assert p[\"sealed\"] == [\"1\"] and p[\"unsealed\"] == [\"2\"]\n\n\ndef test_doctor_proof_six_holds_when_every_merge_is_sealed(tmp_path):\n    root, m1, m2 = _tenant_with_two_merged_items(tmp_path)\n    (root / \"sealed.txt\").write_text(m1 + \"\\n\" + m2 + \"\\n\")\n    p = _proof(root)\n    assert p[\"holds\"] and p[\"sealed\"] == [\"1\", \"2\"]\n\n\ndef test_doctor_proof_six_names_a_merge_before_the_window_without_failing(tmp_path):\n    root, m1, m2 = _tenant_with_two_merged_items(tmp_path)\n    (root / \"sealed.txt\").write_text(m2 + \"\\n\")\n    (root / \"attavo.toml\").write_text(\n        '[paths]\\nrecords = \"records\"\\n\\n[forge]\\nattestation_command = \"sh ./fake-attest\"\\n'\n        f'sealed_since = \"{m1}\"\\n')\n    p = _proof(root)\n    assert p[\"holds\"] and p[\"before_window\"] == [\"1\"] and p[\"sealed\"] == [\"2\"]\n\n\ndef test_doctor_proof_six_fails_without_an_attestation_command(tmp_path):\n    root = tmp_path / \"bare\"\n    root.mkdir()\n    subprocess.run([\"git\", \"init\", \"-q\", \"-b\", \"main\", \".\"], cwd=root, check=True)\n    (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n')\n    (root / \"records\").mkdir()\n    p = _proof(root)\n    assert not p[\"holds\"] and \"attestation_command\" in p[\"reason\"]\n","structuredPatch":[{"oldStart":47,"oldLines":9,"newStart":47,"newLines":46,"lines":["         _git(root, \"checkout\", \"-q\", \"main\")","         _git(root, \"merge\", \"-q\", \"--no-ff\", \"-m\", f\"Merge branch 'attavo/{item}-x'\", f\"attavo/{item}-x\")","         merges.append(_git(root, \"rev-parse\", \"HEAD\"))","+    _git(root, \"update-ref\", \"refs/remotes/origin/main\", _git(root, \"rev-parse\", \"main\"))","+    _git(root, \"symbolic-ref\", \"refs/remotes/origin/HEAD\", \"refs/remotes/origin/main\")","     return root, merges[0], merges[1]"," "," ","+def _tenant_with_one_merged_and_one_unmerged_item(tmp_path: Path) -> Path:","+    root = tmp_path / \"unmerged\"","+    root.mkdir()","+    subprocess.run([\"git\", \"init\", \"-q\", \"-b\", \"main\", \".\"], cwd=root, check=True)","+    _git(root, \"config\", \"user.email\", \"doctor@attavo.invalid\")","+    _git(root, \"config\", \"user.name\", \"doctor fixture\")","+    (root / \"attavo.toml\").write_text(","+        '[paths]\\nrecords = \"records\"\\n\\n[forge]\\nattestation_command = \"sh ./fake-attest\"\\n')","+    (root / \"fake-attest\").write_text(FAKE_ATTEST)","+    (root / \"sealed.txt\").write_text(\"\")","+    _git(root, \"add\", \".\")","+    _git(root, \"commit\", \"-q\", \"-m\", \"install\")","+    _git(root, \"checkout\", \"-q\", \"-b\", \"attavo/1-x\")","+    (root / \"records\" / \"1\").mkdir(parents=True)","+    for stage in (\"spec\", \"approval\", \"build\", \"verify\"):","+        (root / \"records\" / \"1\" / f\"{stage}-01.json\").write_text('{\"status\": \"pass\"}')","+        _git(root, \"add\", \"records\")","+        _git(root, \"commit\", \"-q\", \"-m\", f\"{stage} record for item 1\")","+    _git(root, \"checkout\", \"-q\", \"main\")","+    _git(root, \"merge\", \"-q\", \"--no-ff\", \"-m\", \"Merge branch 'attavo/1-x'\", \"attavo/1-x\")","+    m1 = _git(root, \"rev-parse\", \"HEAD\")","+    (root / \"sealed.txt\").write_text(m1 + \"\\n\")","+    _git(root, \"add\", \"sealed.txt\")","+    _git(root, \"commit\", \"-q\", \"-m\", \"seal item 1\")","+    _git(root, \"checkout\", \"-q\", \"-b\", \"attavo/2-x\")","+    (root / \"records\" / \"2\").mkdir(parents=True)","+    for stage in (\"spec\", \"approval\", \"build\", \"verify\"):","+        (root / \"records\" / \"2\" / f\"{stage}-01.json\").write_text('{\"status\": \"pass\"}')","+        _git(root, \"add\", \"records\")","+        _git(root, \"commit\", \"-q\", \"-m\", f\"{stage} record for item 2\")","+    _git(root, \"checkout\", \"-q\", \"--detach\")","+    _git(root, \"merge\", \"-q\", \"--no-ff\", \"-m\", \"synthetic test merge of attavo/2-x into main\", \"main\")","+    return root","+","+"," def _proof(root: Path) -> dict:","     run = subprocess.run([\"python3\", str(ATTAVO), \"doctor\", \"--json\", str(root)],","                          capture_output=True, text=True, check=False)"]}],"userModified":false,"replaceAll":false}}

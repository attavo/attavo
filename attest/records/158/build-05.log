{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015TYKWi44BZb8QCFsVMjHiY","type":"tool_result","content":"1\t\"\"\"The doctor's fifth proof: every attested item has its statement in the\n2\tstore (issue #158). This repository's own #106, #148, #153 were merged\n3\tdirect, with no merge_group run and so no statement, and the doctor said\n4\tdone anyway -- proof two held on the four stage records with the chain\n5\theld, never asking whether the merge was sealed.\n6\t\n7\tRun: python3 -m pytest tests -q\n8\t\"\"\"\n9\timport json\n10\timport subprocess\n11\tfrom pathlib import Path\n12\t\n13\tROOT = Path(__file__).resolve().parent.parent\n14\tATTAVO = ROOT / \"bin\" / \"attavo\"\n15\t\n16\tFAKE_ATTEST = (\n17\t    '#!/bin/sh\\nread sha\\ngrep -qx \"$sha\" sealed.txt && printf %s '\n18\t    '\"{\\\\\"_type\\\\\": \\\\\"https://in-toto.io/Statement/v1\\\\\"}\"\\n'\n19\t)\n20\t\n21\t\n22\tdef _git(root: Path, *args: str) -> str:\n23\t    return subprocess.run([\"git\", \"-C\", str(root), *args], capture_output=True, text=True,\n24\t                          check=True).stdout.strip()\n25\t\n26\t\n27\tdef _tenant_with_two_merged_items(tmp_path: Path) -> tuple[Path, str, str]:\n28\t    root = tmp_path / \"sealed\"\n29\t    root.mkdir()\n30\t    subprocess.run([\"git\", \"init\", \"-q\", \"-b\", \"main\", \".\"], cwd=root, check=True)\n31\t    _git(root, \"config\", \"user.email\", \"doctor@attavo.invalid\")\n32\t    _git(root, \"config\", \"user.name\", \"doctor fixture\")\n33\t    (root / \"attavo.toml\").write_text(\n34\t        '[paths]\\nrecords = \"records\"\\n\\n[forge]\\nattestation_command = \"sh ./fake-attest\"\\n')\n35\t    (root / \"fake-attest\").write_text(FAKE_ATTEST)\n36\t    (root / \"sealed.txt\").write_text(\"\")\n37\t    _git(root, \"add\", \".\")\n38\t    _git(root, \"commit\", \"-q\", \"-m\", \"install\")\n39\t    merges = []\n40\t    for item in (\"1\", \"2\"):\n41\t        _git(root, \"checkout\", \"-q\", \"-b\", f\"attavo/{item}-x\")\n42\t        (root / \"records\" / item).mkdir(parents=True)\n43\t        for stage in (\"spec\", \"approval\", \"build\", \"verify\"):\n44\t            (root / \"records\" / item / f\"{stage}-01.json\").write_text('{\"status\": \"pass\"}')\n45\t            _git(root, \"add\", \"records\")\n46\t            _git(root, \"commit\", \"-q\", \"-m\", f\"{stage} record for item {item}\")\n47\t        _git(root, \"checkout\", \"-q\", \"main\")\n48\t        _git(root, \"merge\", \"-q\", \"--no-ff\", \"-m\", f\"Merge branch 'attavo/{item}-x'\", f\"attavo/{item}-x\")\n49\t        merges.append(_git(root, \"rev-parse\", \"HEAD\"))\n50\t    return root, merges[0], merges[1]\n51\t\n52\t\n53\tdef _proof(root: Path) -> dict:\n54\t    run = subprocess.run([\"python3\", str(ATTAVO), \"doctor\", \"--json\", str(root)],\n55\t                         capture_output=True, text=True, check=False)\n56\t    proofs = json.loads(run.stdout)[\"proofs\"]\n57\t    return [p for p in proofs if p[\"proof\"] == \"every-attested-item-is-sealed\"][0]\n58\t\n59\t\n60\tdef test_doctor_proof_six_fails_on_an_unsealed_merge(tmp_path):\n61\t    root, m1, m2 = _tenant_with_two_merged_items(tmp_path)\n62\t    (root / \"sealed.txt\").write_text(m1 + \"\\n\")\n63\t    p = _proof(root)\n64\t    assert not p[\"holds\"]\n65\t    assert \"item 2\" in p[\"reason\"] and m2[:12] in p[\"reason\"]\n66\t    assert p[\"sealed\"] == [\"1\"] and p[\"unsealed\"] == [\"2\"]\n67\t\n68\t\n69\tdef test_doctor_proof_six_holds_when_every_merge_is_sealed(tmp_path):\n70\t    root, m1, m2 = _tenant_with_two_merged_items(tmp_path)\n71\t    (root / \"sealed.txt\").write_text(m1 + \"\\n\" + m2 + \"\\n\")\n72\t    p = _proof(root)\n73\t    assert p[\"holds\"] and p[\"sealed\"] == [\"1\", \"2\"]\n74\t\n75\t\n76\tdef test_doctor_proof_six_names_a_merge_before_the_window_without_failing(tmp_path):\n77\t    root, m1, m2 = _tenant_with_two_merged_items(tmp_path)\n78\t    (root / \"sealed.txt\").write_text(m2 + \"\\n\")\n79\t    (root / \"attavo.toml\").write_text(\n80\t        '[paths]\\nrecords = \"records\"\\n\\n[forge]\\nattestation_command = \"sh ./fake-attest\"\\n'\n81\t        f'sealed_since = \"{m1}\"\\n')\n82\t    p = _proof(root)\n83\t    assert p[\"holds\"] and p[\"before_window\"] == [\"1\"] and p[\"sealed\"] == [\"2\"]\n84\t\n85\t\n86\tdef test_doctor_proof_six_fails_without_an_attestation_command(tmp_path):\n87\t    root = tmp_path / \"bare\"\n88\t    root.mkdir()\n89\t    subprocess.run([\"git\", \"init\", \"-q\", \"-b\", \"main\", \".\"], cwd=root, check=True)\n90\t    (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n')\n91\t    (root / \"records\").mkdir()\n92\t    p = _proof(root)\n93\t    assert not p[\"holds\"] and \"attestation_command\" in p[\"reason\"]\n94\t"}]},"parent_tool_use_id":null,"session_id":"7cfe2c70-6f2e-4c4b-ba29-a563670ee202","uuid":"faf6bfd5-03d4-4400-85e1-10e503b17e6e","timestamp":"2026-09-18T22:26:22.781Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-158/tests/test_doctor_sealed.py","content":"\"\"\"The doctor's fifth proof: every attested item has its statement in the\nstore (issue #158). This repository's own #106, #148, #153 were merged\ndirect, with no merge_group run and so no statement, and the doctor said\ndone anyway -- proof two held on the four stage records with the chain\nheld, never asking whether the merge was sealed.\n\nRun: python3 -m pytest tests -q\n\"\"\"\nimport json\nimport subprocess\nfrom pathlib import Path\n\nROOT = Path(__file__).resolve().parent.parent\nATTAVO = ROOT / \"bin\" / \"attavo\"\n\nFAKE_ATTEST = (\n    '#!/bin/sh\\nread sha\\ngrep -qx \"$sha\" sealed.txt && printf %s '\n    '\"{\\\\\"_type\\\\\": \\\\\"https://in-toto.io/Statement/v1\\\\\"}\"\\n'\n)\n\n\ndef _git(root: Path, *args: str) -> str:\n    return subprocess.run([\"git\", \"-C\", str(root), *args], capture_output=True, text=True,\n                          check=True).stdout.strip()\n\n\ndef _tenant_with_two_merged_items(tmp_path: Path) -> tuple[Path, str, str]:\n    root = tmp_path / \"sealed\"\n    root.mkdir()\n    subprocess.run([\"git\", \"init\", \"-q\", \"-b\", \"main\", \".\"], cwd=root, check=True)\n    _git(root, \"config\", \"user.email\", \"doctor@attavo.invalid\")\n    _git(root, \"config\", \"user.name\", \"doctor fixture\")\n    (root / \"attavo.toml\").write_text(\n        '[paths]\\nrecords = \"records\"\\n\\n[forge]\\nattestation_command = \"sh ./fake-attest\"\\n')\n    (root / \"fake-attest\").write_text(FAKE_ATTEST)\n    (root / \"sealed.txt\").write_text(\"\")\n    _git(root, \"add\", \".\")\n    _git(root, \"commit\", \"-q\", \"-m\", \"install\")\n    merges = []\n    for item in (\"1\", \"2\"):\n        _git(root, \"checkout\", \"-q\", \"-b\", f\"attavo/{item}-x\")\n        (root / \"records\" / item).mkdir(parents=True)\n        for stage in (\"spec\", \"approval\", \"build\", \"verify\"):\n            (root / \"records\" / item / f\"{stage}-01.json\").write_text('{\"status\": \"pass\"}')\n            _git(root, \"add\", \"records\")\n            _git(root, \"commit\", \"-q\", \"-m\", f\"{stage} record for item {item}\")\n        _git(root, \"checkout\", \"-q\", \"main\")\n        _git(root, \"merge\", \"-q\", \"--no-ff\", \"-m\", f\"Merge branch 'attavo/{item}-x'\", f\"attavo/{item}-x\")\n        merges.append(_git(root, \"rev-parse\", \"HEAD\"))\n    return root, merges[0], merges[1]\n\n\ndef _proof(root: Path) -> dict:\n    run = subprocess.run([\"python3\", str(ATTAVO), \"doctor\", \"--json\", str(root)],\n                         capture_output=True, text=True, check=False)\n    proofs = json.loads(run.stdout)[\"proofs\"]\n    return [p for p in proofs if p[\"proof\"] == \"every-attested-item-is-sealed\"][0]\n\n\ndef test_doctor_proof_six_fails_on_an_unsealed_merge(tmp_path):\n    root, m1, m2 = _tenant_with_two_merged_items(tmp_path)\n    (root / \"sealed.txt\").write_text(m1 + \"\\n\")\n    p = _proof(root)\n    assert not p[\"holds\"]\n    assert \"item 2\" in p[\"reason\"] and m2[:12] in p[\"reason\"]\n    assert p[\"sealed\"] == [\"1\"] and p[\"unsealed\"] == [\"2\"]\n\n\ndef test_doctor_proof_six_holds_when_every_merge_is_sealed(tmp_path):\n    root, m1, m2 = _tenant_with_two_merged_items(tmp_path)\n    (root / \"sealed.txt\").write_text(m1 + \"\\n\" + m2 + \"\\n\")\n    p = _proof(root)\n    assert p[\"holds\"] and p[\"sealed\"] == [\"1\", \"2\"]\n\n\ndef test_doctor_proof_six_names_a_merge_before_the_window_without_failing(tmp_path):\n    root, m1, m2 = _tenant_with_two_merged_items(tmp_path)\n    (root / \"sealed.txt\").write_text(m2 + \"\\n\")\n    (root / \"attavo.toml\").write_text(\n        '[paths]\\nrecords = \"records\"\\n\\n[forge]\\nattestation_command = \"sh ./fake-attest\"\\n'\n        f'sealed_since = \"{m1}\"\\n')\n    p = _proof(root)\n    assert p[\"holds\"] and p[\"before_window\"] == [\"1\"] and p[\"sealed\"] == [\"2\"]\n\n\ndef test_doctor_proof_six_fails_without_an_attestation_command(tmp_path):\n    root = tmp_path / \"bare\"\n    root.mkdir()\n    subprocess.run([\"git\", \"init\", \"-q\", \"-b\", \"main\", \".\"], cwd=root, check=True)\n    (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n')\n    (root / \"records\").mkdir()\n    p = _proof(root)\n    assert not p[\"holds\"] and \"attestation_command\" in p[\"reason\"]\n","numLines":94,"startLine":1,"totalLines":94}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UpoZSX8ZwFyhJqhw1BK8AX","type":"tool_result","content":"780\t    if no_retires:\n781\t        return p.fail(f\"gate(s) with no retires: {', '.join(no_retires)}\")\n782\t    return p.hold(f\"{len(gates)} gate(s) rejected their fixture\")\n783\t\n784\t\n785\tdef _merges_reachable(root: Path) -> tuple[list[dict], str | None]:\n786\t    \"\"\"(merges, refusal): every merge commit on the default branch's own\n787\t    first-parent line -- sha, parents, and its own first-parent diff --\n788\t    read by one process rather than the git log plus one git diff per\n789\t    merge merge_introducing_records used to pay walking toward the one\n790\t    it wants (issue #153). refs/remotes/origin/HEAD names the default\n791\t    branch without hard-coding \"main\", the same primitive\n792\t    diff_since_approval already uses (issue #52); walking from it rather\n793\t    than from HEAD is what keeps a transport merge on an item branch, a\n794\t    pull_request checkout's own synthetic test merge, and a merge_group's\n795\t    temporary merge from ever being mistaken for an item's merge (issue\n796\t    #169) -- none of those is reachable from the default branch's first-\n797\t    parent line by definition. When refs/remotes/origin/HEAD is not set,\n798\t    this refuses by name rather than guess, exactly as diff_since_approval\n799\t    does.\n800\t\n801\t    The walk starts at HEAD itself when the current checkout is literally\n802\t    on the branch refs/remotes/origin/HEAD names (an ordinary checkout of\n803\t    the default branch, on push or on a developer's own machine) and at\n804\t    the remote-tracking ref's own value otherwise (any other branch, or\n805\t    the detached HEAD a pull_request or merge_group checkout leaves\n806\t    behind) -- HEAD only ever *is* the default branch's first-parent line\n807\t    in the former case; in the latter, only the remote-tracking ref names\n808\t    it. --diff-merges=first-parent gives each merge's diff against its\n809\t    first parent in the same pass git log --merges already makes to list\n810\t    them, in the same order, newest first.\"\"\"\n811\t    symref = subprocess.run(\n812\t        [\"git\", \"-C\", str(root), \"symbolic-ref\", \"-q\", \"refs/remotes/origin/HEAD\"],\n813\t        capture_output=True, text=True, check=False)\n814\t    if symref.returncode != 0:\n815\t        return [], \"refs/remotes/origin/HEAD is not set; run `git remote set-head origin -a`\"\n816\t    default_remote_ref = symref.stdout.strip()\n817\t    default_branch = default_remote_ref.rsplit(\"/\", 1)[-1]\n818\t    current_branch = subprocess.run(\n819\t        [\"git\", \"-C\", str(root), \"symbolic-ref\", \"-q\", \"--short\", \"HEAD\"],\n820\t        capture_output=True, text=True, check=False)\n821\t    default_ref = (\"HEAD\" if current_branch.returncode == 0\n822\t                   and current_branch.stdout.strip() == default_branch\n823\t                   else default_remote_ref)\n824\t    try:\n825\t        out = git(root, \"log\", default_ref, \"--first-parent\", \"--merges\",\n826\t                 \"--diff-merges=first-parent\", \"--name-only\",\n827\t                 \"--format=\\x01%H\\x1f%P\")\n828\t    except RuntimeError:\n829\t        return [], None\n830\t    merges = []\n831\t    for block in out.split(\"\\x01\")[1:]:\n832\t        header, _, rest = block.partition(\"\\n\")\n833\t        sha, parents = header.split(\"\\x1f\")\n834\t        merges.append({\"sha\": sha, \"parents\": parents.split(),\n835\t                       \"touched\": [line for line in rest.splitlines() if line.strip()]})\n836\t    return merges, None\n837\t\n838\t\n839\tdef merge_introducing_records(root: Path, records_rel: str, item: str,\n840\t                              stages: tuple[str, ...],\n841\t                              merges: list[dict] | None = None) -> tuple[str | None, str | None]:\n842\t    \"\"\"(merge_sha, refusal): the merge commit on the default branch's own\n843\t    first-parent line whose first-parent diff introduces a record for\n844\t    every one of stages, under records_rel/item/ -- the same derivation\n845\t    attest itself uses (derive_attest_items), read here so proof two\n846\t    requires an item's stage records to have arrived by an actual merge\n847\t    on the default branch, not merely to sit in the tree, and not by a\n848\t    transport merge, a pull_request checkout's synthetic test merge, or a\n849\t    merge_group's temporary merge (issue #69 acceptance row 4; issue\n850\t    #169). merge_sha is None with no refusal when no such merge exists\n851\t    yet -- the item is not merged, not that the walk failed.\n852\t\n853\t    merges, when given, is _merges_reachable's own result -- ledger's\n854\t    cmd_ledger computes it once and passes it to every item rather than\n855\t    walking the default branch's merges again for each (issue #153); a\n856\t    caller that already has merges has also already handled\n857\t    _merges_reachable's refusal, so this never re-derives one. Left\n858\t    None, a caller with just the one item to ask (doctor's proof two)\n859\t    gets merges computed here, refusal and all.\"\"\"\n860\t    if merges is None:\n861\t        merges, refusal = _merges_reachable(root)\n862\t        if refusal:\n863\t            return None, refusal\n864\t    prefix = f\"{records_rel.rstrip('/')}/{item}/\"\n865\t    for merge in merges:\n866\t        found: set[str] = set()\n867\t        for p in merge[\"touched\"]:\n868\t            if p.startswith(prefix):\n869\t                m = RECORD_RE.match(Path(p).name)\n870\t                if m:\n871\t                    found.add(m.group(1))\n872\t        if all(s in found for s in stages):\n873\t            return merge[\"sha\"], None\n874\t    return None, None\n875\t\n876\t\n877\tINVOCATION_MARKER_SUFFIX = \".started\"\n878\t\n879\t\n880\tdef invocation_marker_path(records_dir: Path, stage: str, nn: int) -> Path:\n881\t    return records_dir / f\"{stage}-{nn:02d}{INVOCATION_MARKER_SUFFIX}\"\n882\t\n883\t\n884\tdef write_invocation_marker(root: Path, records_dir: Path, stage: str, nn: int) -> Path:\n885\t    \"\"\"The fact that an invocation began, written before it does: at,\n886\t    host, pid, the sha it starts on, and the product that started it.\n887\t    Its record's arrival is what retires it; a marker with no record is\n888\t    an invocation that died or hangs, and proof five names it.\"\"\"\n889\t    import os\n890\t    import socket\n891\t    from datetime import datetime, timezone\n892\t    records_dir.mkdir(parents=True, exist_ok=True)\n893\t    path = invocation_marker_path(records_dir, stage, nn)\n894\t    sha = git(root, \"rev-parse\", \"HEAD\").strip()\n895\t    info = {\"at\": datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\"),\n896\t            \"host\": socket.gethostname(), \"pid\": os.getpid(), \"sha\": sha,\n897\t            \"product_version\": product_version()}\n898\t    path.write_text(json.dumps(info, indent=2) + \"\\n\")\n899\t    return path"}]},"parent_tool_use_id":null,"session_id":"7cfe2c70-6f2e-4c4b-ba29-a563670ee202","uuid":"9749218d-ac6f-472f-a1b3-6880b51bb70a","timestamp":"2026-09-18T22:25:25.503Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-158/bin/attavo","content":"    if no_retires:\n        return p.fail(f\"gate(s) with no retires: {', '.join(no_retires)}\")\n    return p.hold(f\"{len(gates)} gate(s) rejected their fixture\")\n\n\ndef _merges_reachable(root: Path) -> tuple[list[dict], str | None]:\n    \"\"\"(merges, refusal): every merge commit on the default branch's own\n    first-parent line -- sha, parents, and its own first-parent diff --\n    read by one process rather than the git log plus one git diff per\n    merge merge_introducing_records used to pay walking toward the one\n    it wants (issue #153). refs/remotes/origin/HEAD names the default\n    branch without hard-coding \"main\", the same primitive\n    diff_since_approval already uses (issue #52); walking from it rather\n    than from HEAD is what keeps a transport merge on an item branch, a\n    pull_request checkout's own synthetic test merge, and a merge_group's\n    temporary merge from ever being mistaken for an item's merge (issue\n    #169) -- none of those is reachable from the default branch's first-\n    parent line by definition. When refs/remotes/origin/HEAD is not set,\n    this refuses by name rather than guess, exactly as diff_since_approval\n    does.\n\n    The walk starts at HEAD itself when the current checkout is literally\n    on the branch refs/remotes/origin/HEAD names (an ordinary checkout of\n    the default branch, on push or on a developer's own machine) and at\n    the remote-tracking ref's own value otherwise (any other branch, or\n    the detached HEAD a pull_request or merge_group checkout leaves\n    behind) -- HEAD only ever *is* the default branch's first-parent line\n    in the former case; in the latter, only the remote-tracking ref names\n    it. --diff-merges=first-parent gives each merge's diff against its\n    first parent in the same pass git log --merges already makes to list\n    them, in the same order, newest first.\"\"\"\n    symref = subprocess.run(\n        [\"git\", \"-C\", str(root), \"symbolic-ref\", \"-q\", \"refs/remotes/origin/HEAD\"],\n        capture_output=True, text=True, check=False)\n    if symref.returncode != 0:\n        return [], \"refs/remotes/origin/HEAD is not set; run `git remote set-head origin -a`\"\n    default_remote_ref = symref.stdout.strip()\n    default_branch = default_remote_ref.rsplit(\"/\", 1)[-1]\n    current_branch = subprocess.run(\n        [\"git\", \"-C\", str(root), \"symbolic-ref\", \"-q\", \"--short\", \"HEAD\"],\n        capture_output=True, text=True, check=False)\n    default_ref = (\"HEAD\" if current_branch.returncode == 0\n                   and current_branch.stdout.strip() == default_branch\n                   else default_remote_ref)\n    try:\n        out = git(root, \"log\", default_ref, \"--first-parent\", \"--merges\",\n                 \"--diff-merges=first-parent\", \"--name-only\",\n                 \"--format=\\x01%H\\x1f%P\")\n    except RuntimeError:\n        return [], None\n    merges = []\n    for block in out.split(\"\\x01\")[1:]:\n        header, _, rest = block.partition(\"\\n\")\n        sha, parents = header.split(\"\\x1f\")\n        merges.append({\"sha\": sha, \"parents\": parents.split(),\n                       \"touched\": [line for line in rest.splitlines() if line.strip()]})\n    return merges, None\n\n\ndef merge_introducing_records(root: Path, records_rel: str, item: str,\n                              stages: tuple[str, ...],\n                              merges: list[dict] | None = None) -> tuple[str | None, str | None]:\n    \"\"\"(merge_sha, refusal): the merge commit on the default branch's own\n    first-parent line whose first-parent diff introduces a record for\n    every one of stages, under records_rel/item/ -- the same derivation\n    attest itself uses (derive_attest_items), read here so proof two\n    requires an item's stage records to have arrived by an actual merge\n    on the default branch, not merely to sit in the tree, and not by a\n    transport merge, a pull_request checkout's synthetic test merge, or a\n    merge_group's temporary merge (issue #69 acceptance row 4; issue\n    #169). merge_sha is None with no refusal when no such merge exists\n    yet -- the item is not merged, not that the walk failed.\n\n    merges, when given, is _merges_reachable's own result -- ledger's\n    cmd_ledger computes it once and passes it to every item rather than\n    walking the default branch's merges again for each (issue #153); a\n    caller that already has merges has also already handled\n    _merges_reachable's refusal, so this never re-derives one. Left\n    None, a caller with just the one item to ask (doctor's proof two)\n    gets merges computed here, refusal and all.\"\"\"\n    if merges is None:\n        merges, refusal = _merges_reachable(root)\n        if refusal:\n            return None, refusal\n    prefix = f\"{records_rel.rstrip('/')}/{item}/\"\n    for merge in merges:\n        found: set[str] = set()\n        for p in merge[\"touched\"]:\n            if p.startswith(prefix):\n                m = RECORD_RE.match(Path(p).name)\n                if m:\n                    found.add(m.group(1))\n        if all(s in found for s in stages):\n            return merge[\"sha\"], None\n    return None, None\n\n\nINVOCATION_MARKER_SUFFIX = \".started\"\n\n\ndef invocation_marker_path(records_dir: Path, stage: str, nn: int) -> Path:\n    return records_dir / f\"{stage}-{nn:02d}{INVOCATION_MARKER_SUFFIX}\"\n\n\ndef write_invocation_marker(root: Path, records_dir: Path, stage: str, nn: int) -> Path:\n    \"\"\"The fact that an invocation began, written before it does: at,\n    host, pid, the sha it starts on, and the product that started it.\n    Its record's arrival is what retires it; a marker with no record is\n    an invocation that died or hangs, and proof five names it.\"\"\"\n    import os\n    import socket\n    from datetime import datetime, timezone\n    records_dir.mkdir(parents=True, exist_ok=True)\n    path = invocation_marker_path(records_dir, stage, nn)\n    sha = git(root, \"rev-parse\", \"HEAD\").strip()\n    info = {\"at\": datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\"),\n            \"host\": socket.gethostname(), \"pid\": os.getpid(), \"sha\": sha,\n            \"product_version\": product_version()}\n    path.write_text(json.dumps(info, indent=2) + \"\\n\")\n    return path","numLines":120,"startLine":780,"totalLines":3891}}}

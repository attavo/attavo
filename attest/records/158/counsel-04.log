s\\\", \\\"--porcelain\\\").strip() == \\\"\\\"\\n    assert remote_head(bare) == head_of(root)\\n\\n\\ndef test_drive_recover_leaves_a_live_invocation_alone(tmp_path):\\n    \\\"\\\"\\\"A marker naming this test process's own pid -- alive on this host\\n    and well inside the stall bound -- is running, not died: recover\\n    writes nothing.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_drive_stall_bound(root, 3600)\\n    approve_item(root)\\n\\n    marker = records_dir(root) / \\\"build-01.started\\\"\\n    marker.parent.mkdir(parents=True, exist_ok=True)\",\"numLines\":90,\"startLine\":747,\"totalLines\":862}}}\nattest/records/151/build-03.log:678:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01361yyT9BzpvDY7hVof9uMC\",\"type\":\"tool_result\",\"content\":\"The file /Users/davidbean/Projects/attavo-worktree-151/tests/test_drive.py has been updated successfully. (file state is current in your context — no need to Read it back)\"}]},\"parent_tool_use_id\":null,\"session_id\":\"f081a203-e2ee-47b3-8bf8-5fc3aaeb804d\",\"uuid\":\"d9d6d3df-5b0c-4c12-874f-9ee860c5fa23\",\"timestamp\":\"2026-09-17T19:59:43.172Z\",\"tool_use_result\":{\"filePath\":\"/Users/davidbean/Projects/attavo-worktree-151/tests/test_drive.py\",\"oldString\":\"    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_drive_stall_bound(root, 60)\\n    bare = add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n\\n    dead = subprocess.Popen([sys.executable, \\\"-c\\\", \\\"pass\\\"])\",\"newString\":\"    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_drive_stall_bound(root, 60)\\n    bare = add_bare_remote(root, tmp_path)\\n\\n    dead = subprocess.Popen([sys.executable, \\\"-c\\\", \\\"pass\\\"])\",\"originalFile\":\"\\\"\\\"\\\"attavo drive: the mechanical transitions between approval and\\nready-to-merge (issue #84) -- one step per invocation, and only that step,\\nuntil a state that belongs to a person. Every test uses the fixture\\nadapter and a fake `[forge].checks_command`; every record commit is\\n`git commit --only` and pushed to a real (bare) fixture remote.\\n\\nRegression tests, written and run red first: on `main` at 85f6f3b there\\nwas no `drive` subcommand, so every one of these failed with \\\"unknown\\nsubcommand\\\".\\n\\nRun: python3 -m pytest tests -q\\n\\\"\\\"\\\"\\nimport importlib.machinery\\nimport importlib.util\\nimport json\\nimport os\\nimport socket\\nimport subprocess\\nimport sys\\nimport time\\nfrom pathlib import Path\\n\\nfrom helpers import commit_all, git, make_tenant\\n\\nROOT = Path(__file__).resolve().parent.parent\\nATTAVO = ROOT / \\\"bin\\\" / \\\"attavo\\\"\\n\\nGREEN_FORGE = \\\"printf 'ci success\\\\\\\\n'\\\"\\n# A concluded conclusion -- checked and failing, not something still\\n# running. Distinct from UNCONCLUDED_FORGE below (issue #84): drive polls\\n# the one still running for the bound, but stops on the first read of a\\n# check that has already concluded, whether or not it passed.\\nRED_FORGE = \\\"printf 'ci failure\\\\\\\\n'\\\"\\nUNCONCLUDED_FORGE = \\\"printf 'ci in_progress\\\\\\\\n'\\\"\\n\\n# The real defaults (ATTAVO_DRIVE_POLL_BOUND_S=600, _INTERVAL_S=20) are a\\n# real forge's clock, not a test's -- tenant zero's own checks conclude\\n# about five minutes after a push. Every `attavo drive` call here runs\\n# against this much shorter clock instead, read at call time from the\\n# same environment variables; test_drive_forge_poll_defaults_are_a_real_\\n# forges_clock is the one test that leaves them unset, to assert the\\n# defaults themselves. The interval is kept well above typical subprocess\\n# startup overhead so a zero-sleep stop and a polled one are easy to tell\\n# apart by wall clock alone.\\nFAST_POLL_ENV = {\\\"ATTAVO_DRIVE_POLL_BOUND_S\\\": \\\"0.9\\\", \\\"ATTAVO_DRIVE_POLL_INTERVAL_S\\\": \\\"0.5\\\"}\\n\\n\\ndef run_attavo(root: Path, *args: str, env: dict | None = None) -> subprocess.CompletedProcess:\\n    full_env = dict(os.environ)\\n    full_env.update(FAST_POLL_ENV)\\n    if env:\\n        full_env.update(env)\\n    return subprocess.run([sys.executable, str(ATTAVO), *args], cwd=str(root),\\n                          capture_output=True, text=True, check=False, env=full_env)\\n\\n\\ndef attavo_module():\\n    \\\"\\\"\\\"bin/attavo imported in-process, for the default-constant assertion\\n    below that a CLI invocation cannot provoke without actually waiting\\n    out the real clock.\\\"\\\"\\\"\\n    loader = importlib.machinery.SourceFileLoader(\\\"attavo_drive_under_test\\\", str(ATTAVO))\\n    spec = importlib.util.spec_from_loader(loader.name, loader)\\n    module = importlib.util.module_from_spec(spec)\\n    loader.exec_module(module)\\n    return module\\n\\n\\ndef add_forge(root: Path, checks_command: str) -> None:\\n    toml = root / \\\"attavo.toml\\\"\\n    toml.write_text(toml.read_text() + f'\\\\n[forge]\\\\nchecks_command = \\\"{checks_command}\\\"\\\\n')\\n    commit_all(root, \\\"configure the forge read\\\")\\n\\n\\ndef approve_item(root: Path, item: str = \\\"1\\\") -> None:\\n    assert run_attavo(root, \\\"spec-gate\\\", item).returncode == 0\\n    assert run_attavo(root, \\\"approve\\\", item, \\\"--by\\\", \\\"alice\\\").returncode == 0\\n\\n\\ndef add_bare_remote(root: Path, tmp_path: Path) -> Path:\\n    \\\"\\\"\\\"A real (bare) remote named origin, seeded with the tenant's current\\n    state -- drive's own push target, distinct from the fake\\n    refs/remotes/origin/* helpers.init_repo sets up purely for verify's\\n    diff base.\\\"\\\"\\\"\\n    bare = tmp_path / \\\"origin.git\\\"\\n    subprocess.run([\\\"git\\\", \\\"init\\\", \\\"--quiet\\\", \\\"--bare\\\", \\\"-b\\\", \\\"main\\\", str(bare)], check=True)\\n    git(root, \\\"remote\\\", \\\"add\\\", \\\"origin\\\", str(bare))\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n    git(root, \\\"push\\\", \\\"origin\\\", f\\\"HEAD:{branch}\\\")\\n    return bare\\n\\n\\ndef records_dir(root: Path, item: str = \\\"1\\\") -> Path:\\n    return root / \\\"records\\\" / item\\n\\n\\ndef record_files(root: Path, stage: str, item: str = \\\"1\\\") -> list[Path]:\\n    return sorted(records_dir(root, item).glob(f\\\"{stage}-*.json\\\"))\\n\\n\\ndef latest_record(root: Path, stage: str, item: str = \\\"1\\\") -> dict:\\n    files = record_files(root, stage, item)\\n    assert files, f\\\"no {stage} record for item {item}\\\"\\n    return json.loads(files[-1].read_text())\\n\\n\\ndef head_of(root: Path) -> str:\\n    return git(root, \\\"rev-parse\\\", \\\"HEAD\\\").strip()\\n\\n\\ndef last_commit_paths(root: Path) -> list[str]:\\n    return git(root, \\\"diff\\\", \\\"--name-only\\\", \\\"HEAD^\\\", \\\"HEAD\\\").splitlines()\\n\\n\\ndef remote_head(bare: Path, branch: str = \\\"main\\\") -> str:\\n    return subprocess.run([\\\"git\\\", \\\"-C\\\", str(bare), \\\"rev-parse\\\", branch],\\n                          capture_output=True, text=True, check=True).stdout.strip()\\n\\n\\ndef test_drive_refuses_without_a_valid_approval(tmp_path):\\n    \\\"\\\"\\\"Acceptance row 6. No approval at all: refused by name, nothing run\\n    -- no spec-gate, no build, no records of any kind written.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    add_bare_remote(root, tmp_path)\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run.returncode != 0\\n    assert \\\"approval\\\" in run.stdout\\n    assert \\\"absent\\\" in run.stdout\\n\\n    assert not records_dir(root).exists() or list(records_dir(root).glob(\\\"*.json\\\")) == []\\n\\n\\ndef test_drive_refuses_with_an_expired_approval(tmp_path):\\n    \\\"\\\"\\\"Acceptance row 6, the other half: an approval bound to a spec sha\\n    that has since moved is expired, not absent -- still refused by name,\\n    nothing run.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n\\n    (root / \\\"specs\\\" / \\\"1\\\" / \\\"spec.md\\\").write_text(\\n        (root / \\\"specs\\\" / \\\"1\\\" / \\\"spec.md\\\").read_text() + \\\"\\\\n\\\")\\n    commit_all(root, \\\"touch the spec after approval\\\")\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run.returncode != 0\\n    assert \\\"expired\\\" in run.stdout\\n    assert record_files(root, \\\"build\\\") == []\\n\\n\\ndef test_drive_builds_from_an_approved_spec_with_no_build(tmp_path):\\n    \\\"\\\"\\\"Acceptance row 1. One drive run produces a passing build record,\\n    commits only the record and its log (`git commit --only`), and pushes\\n    the branch; the fixture remote carries the record commit.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    bare = add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n\\n    rec = latest_record(root, \\\"build\\\")\\n    assert rec[\\\"status\\\"] == \\\"pass\\\"\\n\\n    record_path = record_files(root, \\\"build\\\")[-1]\\n    log_path = record_path.with_suffix(\\\".log\\\")\\n    assert log_path.exists()\\n\\n    touched = set(last_commit_paths(root))\\n    assert touched == {\\n        str(record_path.relative_to(root)),\\n        str(log_path.relative_to(root)),\\n    }\\n\\n    assert remote_head(bare, branch) == head_of(root)\\n\\n\\ndef test_drive_leaves_the_events_file_out_of_the_record_commit(tmp_path):\\n    \\\"\\\"\\\"Issue #26, acceptance row 2, strengthened by issue #140: attavo\\n    build always writes a stage's events file now (test_build.py's own\\n    row-1 tests), under the checkout's own git directory rather than\\n    the working tree -- so it is not merely excluded from the commit's\\n    file list, it is not even a path git tracks anything under. The\\n    commit's file list still names only the record and its log.\\n    \\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n\\n    record_path = record_files(root, \\\"build\\\")[-1]\\n    git_dir = git(root, \\\"rev-parse\\\", \\\"--absolute-git-dir\\\").strip()\\n    events_path = Path(git_dir) / \\\"attavo\\\" / \\\"build-01.events.jsonl\\\"\\n    assert events_path.is_file()\\n\\n    touched = set(last_commit_paths(root))\\n    assert touched == {\\n        str(record_path.relative_to(root)),\\n        str(record_path.with_suffix(\\\".log\\\").relative_to(root)),\\n    }\\n\\n\\ndef test_drive_commits_the_record_as_the_driver_not_the_tenants_own_identity(tmp_path):\\n    \\\"\\\"\\\"The driver's identity (driver_identity, beside executor_identity):\\n    set by the product, never the tenant's git config, so a driven item's\\n    record commits are never indistinguishable from an operator's own.\\n    The fixture tenant's user.name is set to another value here, so a\\n    commit carrying it would prove commit_record fell back to the\\n    tenant's git config instead.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    git(root, \\\"config\\\", \\\"user.name\\\", \\\"Some Operator\\\")\\n    git(root, \\\"config\\\", \\\"user.email\\\", \\\"operator@example.com\\\")\\n    add_forge(root, GREEN_FORGE)\\n    add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n\\n    author_name = git(root, \\\"log\\\", \\\"-1\\\", \\\"--format=%an\\\").strip()\\n    author_email = git(root, \\\"log\\\", \\\"-1\\\", \\\"--format=%ae\\\").strip()\\n    committer_name = git(root, \\\"log\\\", \\\"-1\\\", \\\"--format=%cn\\\").strip()\\n    committer_email = git(root, \\\"log\\\", \\\"-1\\\", \\\"--format=%ce\\\").strip()\\n\\n    assert author_name == \\\"attavo driver\\\"\\n    assert author_email == \\\"driver@attavo.invalid\\\"\\n    assert committer_name == \\\"attavo driver\\\"\\n    assert committer_email == \\\"driver@attavo.invalid\\\"\\n\\n\\ndef test_drive_verifies_from_a_passed_build_with_the_forge_green(tmp_path):\\n    \\\"\\\"\\\"Acceptance row 2. From a passed build with the fake forge green,\\n    one run produces a verify record, commits only the record and its log,\\n    and pushes.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    bare = add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n\\n    assert run_attavo(root, \\\"drive\\\", \\\"1\\\").returncode == 0  # builds\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n\\n    assert record_files(root, \\\"build\\\") and record_files(root, \\\"verify\\\")\\n    rec = latest_record(root, \\\"verify\\\")\\n    assert rec[\\\"status\\\"] == \\\"pass\\\"\\n\\n    record_path = record_files(root, \\\"verify\\\")[-1]\\n    log_path = record_path.with_suffix(\\\".log\\\")\\n    assert log_path.exists()\\n\\n    touched = set(last_commit_paths(root))\\n    assert touched == {\\n        str(record_path.relative_to(root)),\\n        str(log_path.relative_to(root)),\\n    }\\n\\n    assert remote_head(bare, branch) == head_of(root)\\n\\n\\ndef test_drive_verifies_again_when_the_latest_verify_is_superseded_by_a_later_build(tmp_path):\\n    \\\"\\\"\\\"Acceptance row 4, issue #109. A verify record can only name a build\\n    that existed when it was written, so a later build makes the latest\\n    verify superseded, never a mismatch -- drive derives the next stage\\n    as verify, not build, and never refuses.\\n\\n    Regression: on main before this lane, drive_state's own inline\\n    staleness check already treats this as 'verify', so this test does\\n    not fail against current code -- it is here to lock the behavior\\n    check_attest_chain's fix must not disturb (the acceptance table's\\n    'never refuses' row).\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n\\n    assert run_attavo(root, \\\"drive\\\", \\\"1\\\").returncode == 0  # builds\\n    assert run_attavo(root, \\\"drive\\\", \\\"1\\\").returncode == 0  # verifies\\n\\n    # A second build record, minted by hand -- a real re-run of the\\n    # fixture adapter is not idempotent against its own tree -- naming a\\n    # sha the existing verify-01 does not: verify-01 is now superseded.\\n    build_01 = json.loads(record_files(root, \\\"build\\\")[-1].read_text())\\n    build_01[\\\"sha\\\"] = \\\"f\\\" * 40\\n    (records_dir(root) / \\\"build-02.json\\\").write_text(json.dumps(build_01))\\n    commit_all(root, \\\"attavo: second build record for #1, minted by hand\\\")\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n    assert len(record_files(root, \\\"build\\\")) == 2\\n    assert len(record_files(root, \\\"verify\\\")) == 2\\n    rec = latest_record(root, \\\"verify\\\")\\n    assert rec[\\\"status\\\"] == \\\"pass\\\"\\n    assert rec[\\\"build_sha\\\"] == build_01[\\\"sha\\\"]\\n\\n\\ndef test_drive_prints_ready_to_merge_from_a_passed_verify(tmp_path):\\n    \\\"\\\"\\\"Acceptance row 3. From a passed verify with the forge green, one\\n    run prints ready-to-merge, exits 0, writes nothing, enqueues nothing\\n    -- and, per row 8, a further run repeats exactly the same thing.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n\\n    assert run_attavo(root, \\\"drive\\\", \\\"1\\\").returncode == 0  # builds\\n    assert run_attavo(root, \\\"drive\\\", \\\"1\\\").returncode == 0  # verifies\\n\\n    pre_head = head_of(root)\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n    assert \\\"ready to merge\\\" in run.stdout\\n    assert head_of(root) == pre_head\\n    assert record_files(root, \\\"verify\\\") and len(record_files(root, \\\"verify\\\")) == 1\\n\\n    # Acceptance row 8: idempotence -- run it again, same result, nothing\\n    # new written or pushed.\\n    run2 = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run2.returncode == 0\\n    assert \\\"ready to merge\\\" in run2.stdout\\n    assert head_of(root) == pre_head\\n    assert len(record_files(root, \\\"verify\\\")) == 1\\n    assert len(record_files(root, \\\"build\\\")) == 1\\n\\n\\ndef test_drive_until_ready_runs_build_then_verify_to_ready_in_one_call(tmp_path):\\n    \\\"\\\"\\\"Issue #100's own followups. --until-ready repeats step-and-wait in\\n    the same process: one call, from an approved item with the forge\\n    green, builds, verifies, and prints ready to merge -- both records\\n    written and pushed, without the caller invoking drive again after\\n    each passing step.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    bare = add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\", \\\"--until-ready\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n    assert \\\"ready to merge\\\" in run.stdout\\n\\n    assert len(record_files(root, \\\"build\\\")) == 1\\n    assert len(record_files(root, \\\"verify\\\")) == 1\\n    assert latest_record(root, \\\"build\\\")[\\\"status\\\"] == \\\"pass\\\"\\n    assert latest_record(root, \\\"verify\\\")[\\\"status\\\"] == \\\"pass\\\"\\n    assert remote_head(bare, branch) == head_of(root)\\n\\n    # Idempotence, same as the single-step form: a further --until-ready\\n    # call repeats exactly the same ready-to-merge result, writing nothing.\\n    run2 = run_attavo(root, \\\"drive\\\", \\\"1\\\", \\\"--until-ready\\\")\\n    assert run2.returncode == 0\\n    assert \\\"ready to merge\\\" in run2.stdout\\n    assert len(record_files(root, \\\"build\\\")) == 1\\n    assert len(record_files(root, \\\"verify\\\")) == 1\\n\\n\\ndef test_drive_without_the_flag_still_takes_one_step_at_a_time(tmp_path):\\n    \\\"\\\"\\\"Regression: --until-ready is additive. With no flag, an approved\\n    item with the forge green still needs two separate calls -- build,\\n    then verify -- exactly as before this issue.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run.returncode == 0\\n    assert record_files(root, \\\"build\\\") and not record_files(root, \\\"verify\\\")\\n\\n    run2 = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run2.returncode == 0\\n    assert record_files(root, \\\"verify\\\")\\n\\n\\ndef test_drive_until_ready_stops_on_a_halt(tmp_path):\\n    \\\"\\\"\\\"A step that stops on its own account -- here, a halted build --\\n    stops the --until-ready loop exactly where the single-step form\\n    would, printing the same thing; it does not retry the halted step.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    bare = add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\", \\\"--until-ready\\\",\\n                     env={\\\"ATTAVO_FIXTURE_QUESTION\\\": \\\"which overlay wins?\\\"})\\n    assert run.returncode == 3\\n    assert \\\"which overlay wins?\\\" in run.stdout\\n\\n    assert len(record_files(root, \\\"build\\\")) == 1\\n    assert latest_record(root, \\\"build\\\")[\\\"status\\\"] == \\\"halted\\\"\\n    assert record_files(root, \\\"verify\\\") == []\\n    assert remote_head(bare, branch) == head_of(root)\\n\\n\\ndef test_drive_until_ready_stops_when_the_forge_goes_red_after_a_build(tmp_path):\\n    \\\"\\\"\\\"A build that passes, then a forge that concludes red for verify's\\n    own gate, stops the loop there -- one record written (the pass), no\\n    verify record, no retry of the forge read.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, RED_FORGE)\\n    add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\", \\\"--until-ready\\\")\\n    assert run.returncode != 0\\n    assert \\\"ci\\\" in run.stdout and \\\"failure\\\" in run.stdout\\n\\n    assert len(record_files(root, \\\"build\\\")) == 1\\n    assert latest_record(root, \\\"build\\\")[\\\"status\\\"] == \\\"pass\\\"\\n    assert record_files(root, \\\"verify\\\") == []\\n\\n\\ndef test_drive_stops_when_the_forge_is_red(tmp_path):\\n    \\\"\\\"\\\"Acceptance row 4. A forge read where the one check has already\\n    concluded and failed is not polled at all -- there is nothing left to\\n    wait on, so drive stops on the first read, naming the check, with no\\n    sleep in between. Writes nothing -- no verify record at all, no new\\n    commit.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, RED_FORGE)\\n    add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n\\n    assert run_attavo(root, \\\"drive\\\", \\\"1\\\").returncode == 0  # builds\\n    pre_head = head_of(root)\\n\\n    started = time.monotonic()\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    elapsed = time.monotonic() - started\\n    assert run.returncode != 0\\n    assert \\\"ci\\\" in run.stdout and \\\"failure\\\" in run.stdout\\n    assert elapsed < 0.4, (\\n        f\\\"a concluded, red forge check should stop on the first read with no \\\"\\n        f\\\"poll interval slept -- took {elapsed:.2f}s\\\")\\n\\n    assert record_files(root, \\\"verify\\\") == []\\n    assert head_of(root) == pre_head\\n\\n    # Idempotence (row 8): running again in the same red state stops the\\n    # same way, still nothing written.\\n    run2 = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run2.returncode != 0\\n    assert record_files(root, \\\"verify\\\") == []\\n    assert head_of(root) == pre_head\\n\\n\\ndef test_drive_polls_the_bound_while_the_forge_is_still_running(tmp_path):\\n    \\\"\\\"\\\"Acceptance row 4, the unconcluded case: a check still carrying a\\n    status (in_progress) rather than a conclusion is not yet red -- drive\\n    keeps polling it for the full bound before giving up, unlike a\\n    concluded red check, which it does not poll at all. Writes nothing.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, UNCONCLUDED_FORGE)\\n    add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n\\n    assert run_attavo(root, \\\"drive\\\", \\\"1\\\").returncode == 0  # builds\\n\\n    started = time.monotonic()\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    elapsed = time.monotonic() - started\\n    assert run.returncode != 0\\n    assert \\\"ci\\\" in run.stdout and \\\"in_progress\\\" in run.stdout\\n    assert elapsed >= 0.4, (\\n        f\\\"a check still in_progress should be polled for the bound, not \\\"\\n        f\\\"stopped on the first read -- took only {elapsed:.2f}s\\\")\\n\\n    assert record_files(root, \\\"verify\\\") == []\\n\\n\\ndef test_drive_halts_on_a_question_and_resumes_at_build_after_a_ruling(tmp_path):\\n    \\\"\\\"\\\"Acceptance row 5. The fixture adapter halts with a question: drive\\n    stops naming the question and the record (and still pushes that\\n    halted record, same as any other record build writes). After a\\n    ruling is appended, a second run resumes at build and this time\\n    passes.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    bare = add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\",\\n                     env={\\\"ATTAVO_FIXTURE_QUESTION\\\": \\\"which overlay wins?\\\"})\\n    assert run.returncode == 3\\n    assert \\\"which overlay wins?\\\" in run.stdout\\n\\n    rec = latest_record(root, \\\"build\\\")\\n    assert rec[\\\"status\\\"] == \\\"halted\\\"\\n    assert rec[\\\"halted\\\"] == {\\\"question\\\": \\\"which overlay wins?\\\"}\\n    record_path = record_files(root, \\\"build\\\")[-1]\\n    assert record_path.name in run.stdout\\n\\n    # The halted record was still committed and pushed.\\n    assert remote_head(bare, branch) == head_of(root)\\n\\n    rulings = root / \\\"rulings.md\\\"\\n    rulings.write_text(rulings.read_text() + \\\"\\\\n- overlay: use the base tree\\\\n\\\"\\n                       if rulings.exists() else \\\"- overlay: use the base tree\\\\n\\\")\\n    commit_all(root, \\\"rule on the overlay question\\\")\\n    git(root, \\\"push\\\", \\\"origin\\\", f\\\"HEAD:{branch}\\\")\\n\\n    run2 = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run2.returncode == 0, run2.stdout + run2.stderr\\n\\n    assert len(record_files(root, \\\"build\\\")) == 2\\n    rec2 = latest_record(root, \\\"build\\\")\\n    assert rec2[\\\"status\\\"] == \\\"pass\\\"\\n    assert remote_head(bare, branch) == head_of(root)\\n\\n\\ndef configure_counsel(root: Path) -> None:\\n    \\\"\\\"\\\"[executor].counsel = \\\"fixture\\\" -- build_valid's own manifest\\n    declares [executor].build = \\\"fixture\\\" only; counsel needs its own\\n    adapter named (issue #100).\\\"\\\"\\\"\\n    toml = root / \\\"attavo.toml\\\"\\n    toml.write_text(toml.read_text().replace(\\n        '[executor]\\\\nbuild = \\\"fixture\\\"', '[executor]\\\\nbuild = \\\"fixture\\\"\\\\ncounsel = \\\"fixture\\\"'))\\n    commit_all(root, \\\"configure the counsel adapter\\\")\\n\\n\\ndef test_drive_counsels_a_stop_before_filing_it_and_commits_both_records_together(tmp_path):\\n    \\\"\\\"\\\"Issue #100, acceptance row 3. On a stop, drive calls counsel\\n    before file-stops, and commits the counsel record with the stage\\n    record in one commit.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    bare = add_bare_remote(root, tmp_path)\\n    configure_counsel(root)\\n    approve_item(root)\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n    filed = tmp_path / \\\"filed.jsonl\\\"\\n    configure_filing(root, filed)\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\",\\n                     env={\\\"ATTAVO_FIXTURE_QUESTION\\\": \\\"which overlay wins?\\\"})\\n    assert run.returncode == 3\\n\\n    assert record_files(root, \\\"counsel\\\")\\n    counsel_rec = latest_record(root, \\\"counsel\\\")\\n    assert counsel_rec[\\\"record_stage\\\"] == \\\"build\\\"\\n    assert counsel_rec[\\\"record\\\"] == \\\"build-01\\\"\\n    assert counsel_rec[\\\"verdict\\\"] == \\\"person\\\"\\n\\n    committed = set(last_commit_paths(root))\\n    assert committed == {\\n        \\\"records/1/build-01.json\\\", \\\"records/1/build-01.log\\\",\\n        \\\"records/1/counsel-01.json\\\", \\\"records/1/counsel-01.log\\\",\\n        \\\"records/1/build-01.filed\\\",\\n    }\\n    assert remote_head(bare, branch) == head_of(root)\\n\\n    filed_bodies = [json.loads(l) for l in filed.read_text().splitlines() if l.strip()]\\n    assert len(filed_bodies) == 1\\n    assert filed_bodies[0][\\\"counsel_verdict\\\"] == \\\"person\\\"\\n    assert filed_bodies[0][\\\"counsel_proposal\\\"][\\\"question\\\"]\\n\\n\\ndef test_drive_still_files_a_stop_with_no_counsel_adapter_configured(tmp_path):\\n    \\\"\\\"\\\"counsel refuses gracefully (no [executor].counsel or\\n    [executor].verify) -- drive still files and transports the stage\\n    record; nothing new for counsel to commit.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    bare = add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n    filed = tmp_path / \\\"filed.jsonl\\\"\\n    configure_filing(root, filed)\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\",\\n                     env={\\\"ATTAVO_FIXTURE_QUESTION\\\": \\\"which overlay wins?\\\"})\\n    assert run.returncode == 3\\n\\n    assert record_files(root, \\\"counsel\\\") == []\\n    committed = set(last_commit_paths(root))\\n    assert committed == {\\\"records/1/build-01.json\\\", \\\"records/1/build-01.log\\\",\\n                         \\\"records/1/build-01.filed\\\"}\\n    assert remote_head(bare, branch) == head_of(root)\\n\\n\\ndef configure_filing(root: Path, filed_path: Path) -> None:\\n    \\\"\\\"\\\"Appended under the [forge] table add_forge already opened -- a\\n    second [forge] header in the same file is a TOML redeclaration\\n    error. Prints a fake issue URL on stdout, numbered by filed_path's\\n    own line count so far -- the fact a real file_issue_command's stdout\\n    would carry, and what the .filed marker beside each stop record is\\n    meant to hold (issue #89).\\\"\\\"\\\"\\n    toml = root / \\\"attavo.toml\\\"\\n    command = (f\\\"n=$(wc -l < {filed_path} 2>/dev/null || echo 0); \\\"\\n              f\\\"cat >> {filed_path}; \\\"\\n              f\\\"echo https://github.com/tenant/repo/issues/$((n + 1))\\\")\\n    toml.write_text(toml.read_text() + f\\\"\\\\nfile_issue_command = '{command}'\\\\n\\\")\\n    commit_all(root, \\\"configure issue filing\\\")\\n\\n\\ndef test_drive_files_a_stop_it_reports_exactly_once(tmp_path):\\n    \\\"\\\"\\\"Issue #89, acceptance row 5. A stop drive reports -- here, the\\n    fixture adapter's halt -- calls file-stops once: one drive run files\\n    exactly one issue for the attempt it just wrote, not zero and not\\n    more than one.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n    filed = tmp_path / \\\"filed.jsonl\\\"\\n    configure_filing(root, filed)\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\",\\n                     env={\\\"ATTAVO_FIXTURE_QUESTION\\\": \\\"which overlay wins?\\\"})\\n    assert run.returncode == 3\\n\\n    filed_bodies = [json.loads(l) for l in filed.read_text().splitlines() if l.strip()]\\n    assert len(filed_bodies) == 1\\n    assert filed_bodies[0][\\\"record\\\"] == \\\"records/1/build-01.json\\\"\\n\\n    # A second drive run halts again -- a new attempt, build-02 -- and\\n    # files exactly one more issue for that new record; file-stops' own\\n    # .filed marker means build-01's issue is never filed twice.\\n    run2 = run_attavo(root, \\\"drive\\\", \\\"1\\\",\\n                      env={\\\"ATTAVO_FIXTURE_QUESTION\\\": \\\"which overlay wins?\\\"})\\n    assert run2.returncode == 3\\n    assert len(record_files(root, \\\"build\\\")) == 2\\n\\n    filed_bodies_after = [json.loads(l) for l in filed.read_text().splitlines() if l.strip()]\\n    assert len(filed_bodies_after) == 2\\n    assert filed_bodies_after[0] == filed_bodies[0]\\n    assert filed_bodies_after[1][\\\"record\\\"] == \\\"records/1/build-02.json\\\"\\n\\n\\ndef test_drive_marker_holds_the_filing_commands_stdout_and_is_committed_with_the_record(tmp_path):\\n    \\\"\\\"\\\"A stop's own .filed marker is written before the record is\\n    transported, so it carries the filing command's stdout (the issue it\\n    opened) and rides in the very same commit as the record and its log\\n    -- one commit, one push, as before this fix. Red before it: the\\n    marker was written empty, after commit_record and push_record_commit\\n    had already run, so it was never part of any commit at all.\\n    \\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    bare = add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n    filed = tmp_path / \\\"filed.jsonl\\\"\\n    configure_filing(root, filed)\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\",\\n                     env={\\\"ATTAVO_FIXTURE_QUESTION\\\": \\\"which overlay wins?\\\"})\\n    assert run.returncode == 3\\n\\n    marker_path = records_dir(root) / \\\"build-01.filed\\\"\\n    assert marker_path.is_file()\\n    assert marker_path.read_text().strip() == \\\"https://github.com/tenant/repo/issues/1\\\"\\n\\n    committed = set(last_commit_paths(root))\\n    assert committed == {\\\"records/1/build-01.json\\\", \\\"records/1/build-01.log\\\",\\n                         \\\"records/1/build-01.filed\\\"}\\n    assert remote_head(bare) == head_of(root)\\n\\n\\ndef test_drive_a_second_run_in_the_same_state_files_nothing(tmp_path):\\n    \\\"\\\"\\\"Issue #89. The marker committed and pushed above is the fact a\\n    second worktree or a fresh clone reads too -- a second drive run\\n    against the same records, from a fresh clone of the remote drive\\n    already pushed to, files nothing for the stop that clone already\\n    carries a marker for. Red before this fix: the marker never reached\\n    the remote at all, so every clone refiled every stop it found.\\n    \\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    bare = add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n    filed = tmp_path / \\\"filed.jsonl\\\"\\n    configure_filing(root, filed)\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\",\\n                     env={\\\"ATTAVO_FIXTURE_QUESTION\\\": \\\"which overlay wins?\\\"})\\n    assert run.returncode == 3\\n    filed_after_first = filed.read_text()\\n    assert filed_after_first.strip() != \\\"\\\"\\n\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n    clone = tmp_path / \\\"fresh-clone\\\"\\n    subprocess.run([\\\"git\\\", \\\"clone\\\", \\\"--quiet\\\", \\\"--branch\\\", branch, str(bare), str(clone)],\\n                   check=True)\\n\\n    run2 = run_attavo(clone, \\\"file-stops\\\", \\\"1\\\")\\n    assert run2.returncode == 0\\n    assert \\\"no stops to file\\\" in run2.stdout\\n    assert filed.read_text() == filed_after_first  # nothing new was filed\\n\\n\\ndef test_drive_retries_a_rejected_push_with_a_merge_never_a_rebase(tmp_path):\\n    \\\"\\\"\\\"Acceptance row 7. A rejected push with a divergent remote is\\n    retried after `git pull --no-rebase --no-edit`, never a rebase; the\\n    build record's own sha is unchanged (still reachable, still what the\\n    record names), and the retry lands a merge commit, not a rewritten\\n    one.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    bare = add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n\\n    # Diverge the bare remote: another clone pushes an unrelated commit to\\n    # the same branch before drive's own push happens.\\n    other = tmp_path / \\\"other-clone\\\"\\n    subprocess.run([\\\"git\\\", \\\"clone\\\", \\\"--quiet\\\", str(bare), str(other)], check=True)\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(other), \\\"checkout\\\", \\\"-q\\\", branch], check=True)\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(other), \\\"config\\\", \\\"user.email\\\", \\\"other@example.com\\\"],\\n                   check=True)\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(other), \\\"config\\\", \\\"user.name\\\", \\\"Other\\\"], check=True)\\n    (other / \\\"concurrent.txt\\\").write_text(\\\"from elsewhere\\\\n\\\")\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(other), \\\"add\\\", \\\"-A\\\"], check=True)\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(other), \\\"commit\\\", \\\"-q\\\", \\\"-m\\\", \\\"a concurrent commit\\\"],\\n                   check=True)\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(other), \\\"push\\\", \\\"origin\\\", f\\\"HEAD:{branch}\\\"], check=True)\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n\\n    rec = latest_record(root, \\\"build\\\")\\n    assert rec[\\\"status\\\"] == \\\"pass\\\"\\n    build_sha = rec[\\\"sha\\\"]\\n\\n    # The build's own commit sha is still reachable -- a merge, not a\\n    # rebase, which would have rewritten it under a new sha.\\n    assert build_sha in git(root, \\\"rev-list\\\", \\\"HEAD\\\").split()\\n\\n    # The retry landed a merge commit somewhere in history, not\\n    # necessarily at HEAD -- the invocation marker's own push is the one\\n    # that met the divergent remote and retried; the build record's own\\n    # push, once the branches were already merged, needed no retry of\\n    # its own.\\n    assert git(root, \\\"rev-list\\\", \\\"--merges\\\", \\\"HEAD\\\").split(), \\\\\\n        \\\"the retry should have landed a merge commit\\\"\\n\\n    assert remote_head(bare, branch) == head_of(root)\\n    # the concurrent commit from the other clone is present too\\n    assert \\\"concurrent.txt\\\" in git(root, \\\"ls-tree\\\", \\\"-r\\\", \\\"--name-only\\\", \\\"HEAD\\\")\\n\\n\\ndef add_drive_stall_bound(root: Path, seconds: int) -> None:\\n    toml = root / \\\"attavo.toml\\\"\\n    toml.write_text(toml.read_text() + f\\\"\\\\n[drive]\\\\nstall_after_s = {seconds}\\\\n\\\")\\n    commit_all(root, \\\"configure the drive stall bound\\\")\\n\\n\\ndef test_drive_writes_and_pushes_an_invocation_marker_before_running_the_stage(tmp_path):\\n    \\\"\\\"\\\"Issue #151. Before running build, drive writes a build-01.started\\n    marker and commits and pushes it by itself -- the fact that this\\n    invocation began is on the branch before the adapter ever runs, so a\\n    process that dies mid-build still leaves it behind.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    bare = add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n\\n    marker_path = records_dir(root) / \\\"build-01.started\\\"\\n    assert marker_path.is_file()\\n    info = json.loads(marker_path.read_text())\\n    assert info[\\\"pid\\\"] > 0 and info[\\\"host\\\"] and info[\\\"sha\\\"]\\n\\n    # The marker's own commit precedes the record's own commit; both\\n    # reached the remote.\\n    marker_commit = git(root, \\\"log\\\", \\\"-1\\\", \\\"--format=%H\\\",\\n                        \\\"--\\\", \\\"records/1/build-01.started\\\").strip()\\n    record_commit = git(root, \\\"log\\\", \\\"-1\\\", \\\"--format=%H\\\",\\n                        \\\"--\\\", \\\"records/1/build-01.json\\\").strip()\\n    assert marker_commit != record_commit\\n    is_ancestor = subprocess.run(\\n        [\\\"git\\\", \\\"-C\\\", str(root), \\\"merge-base\\\", \\\"--is-ancestor\\\", marker_commit, record_commit],\\n        check=False)\\n    assert is_ancestor.returncode == 0, \\\"the marker's commit should precede the record's\\\"\\n    assert remote_head(bare, branch) == head_of(root)\\n\\n\\ndef test_drive_recover_writes_a_died_record_for_a_dead_marker(tmp_path):\\n    \\\"\\\"\\\"Issue #151, acceptance row 2. A marker naming a dead pid on this\\n    host, with no record beside it, is recovered as a failed record, stop\\n    class died, provenance product, committed by the driver identity with\\n    a clean tree -- the fixture #148 left behind by hand, done here by\\n    the product instead.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_drive_stall_bound(root, 60)\\n    bare = add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n\\n    dead = subprocess.Popen([sys.executable, \\\"-c\\\", \\\"pass\\\"])\\n    dead.wait()\\n    marker = records_dir(root) / \\\"build-01.started\\\"\\n    marker.parent.mkdir(parents=True, exist_ok=True)\\n    marker.write_text(json.dumps({\\\"at\\\": \\\"2026-09-17T13:16:08Z\\\", \\\"host\\\": socket.gethostname(),\\n                                  \\\"pid\\\": dead.pid, \\\"sha\\\": head_of(root),\\n                                  \\\"product_version\\\": \\\"fixture\\\"}))\\n    commit_all(root, \\\"invocation marker for item 1\\\")\\n    git(root, \\\"push\\\", \\\"origin\\\", \\\"HEAD:main\\\")\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\", \\\"--recover\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n\\n    rec = latest_record(root, \\\"build\\\")\\n    assert rec[\\\"status\\\"] == \\\"failed\\\"\\n    assert rec[\\\"stop\\\"][\\\"class\\\"] == \\\"died\\\"\\n    assert rec[\\\"stop\\\"][\\\"provenance\\\"] == \\\"product\\\"\\n    assert \\\"wrote no build-01.json\\\" in rec[\\\"stop\\\"][\\\"detail\\\"]\\n\\n    assert (records_dir(root) / \\\"build-01.log\\\").is_file()\\n    assert git(root, \\\"log\\\", \\\"-1\\\", \\\"--format=%an\\\").strip() == \\\"attavo driver\\\"\\n    assert git(root, \\\"status\\\", \\\"--porcelain\\\").strip() == \\\"\\\"\\n    assert remote_head(bare) == head_of(root)\\n\\n\\ndef test_drive_recover_leaves_a_live_invocation_alone(tmp_path):\\n    \\\"\\\"\\\"A marker naming this test process's own pid -- alive on this host\\n    and well inside the stall bound -- is running, not died: recover\\n    writes nothing.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_drive_stall_bound(root, 3600)\\n    approve_item(root)\\n\\n    marker = records_dir(root) / \\\"build-01.started\\\"\\n    marker.parent.mkdir(parents=True, exist_ok=True)\\n    marker.write_text(json.dumps({\\\"at\\\": \\\"2026-09-17T13:16:08Z\\\", \\\"host\\\": socket.gethostname(),\\n                                  \\\"pid\\\": os.getpid(), \\\"sha\\\": head_of(root),\\n                                  \\\"product_version\\\": \\\"fixture\\\"}))\\n    commit_all(root, \\\"invocation marker for a live pid\\\")\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\", \\\"--recover\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n    assert \\\"nothing to recover\\\" in run.stdout\\n    assert record_files(root, \\\"build\\\") == []\\n\\n\\ndef test_drive_forge_poll_defaults_are_a_real_forges_clock():\\n    \\\"\\\"\\\"The bound and interval every other test overrides with\\n    FAST_POLL_ENV default, unset, to at least five minutes and ten\\n    seconds -- tenant zero's own checks conclude about five minutes after\\n    a push, and a bound shorter than that would make every drive run\\n    after a record push stop on 'forge checks not green', with a person\\n    running it again after CI: exactly the transport act this lane\\n    retires. Row 4 (a forge that never goes green) is unchanged in\\n    meaning by this -- it still stops, just after waiting out a real\\n    forge's own clock instead of a test's fake one.\\n    \\\"\\\"\\\"\\n    module = attavo_module()\\n    assert module.DRIVE_FORGE_POLL_BOUND_DEFAULT_S >= 300\\n    assert module.DRIVE_FORGE_POLL_INTERVAL_DEFAULT_S >= 10\\n\",\"structuredPatch\":[{\"oldStart\":797,\"oldLines\":7,\"newStart\":797,\"newLines\":6,\"lines\":[\"     root = make_tenant(tmp_path, \\\"build_valid\\\")\",\"     add_drive_stall_bound(root, 60)\",\"     bare = add_bare_remote(root, tmp_path)\",\"-    approve_item(root)\",\" \",\"     dead = subprocess.Popen([sys.executable, \\\"-c\\\", \\\"pass\\\"])\",\"     dead.wait()\"]}],\"userModified\":false,\"replaceAll\":false}}\nattest/records/151/build-03.log:685:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01128THWNpZYS6zCKewCuahM\",\"type\":\"tool_result\",\"content\":\"The file /Users/davidbean/Projects/attavo-worktree-151/tests/test_drive.py has been updated successfully. (file state is current in your context — no need to Read it back)\"}]},\"parent_tool_use_id\":null,\"session_id\":\"f081a203-e2ee-47b3-8bf8-5fc3aaeb804d\",\"uuid\":\"aeff6d42-4243-4feb-a760-955ef2a1fa17\",\"timestamp\":\"2026-09-17T19:59:50.654Z\",\"tool_use_result\":{\"filePath\":\"/Users/davidbean/Projects/attavo-worktree-151/tests/test_drive.py\",\"oldString\":\"    commit_all(root, \\\"invocation marker for item 1\\\")\\n    git(root, \\\"push\\\", \\\"origin\\\", \\\"HEAD:main\\\")\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\", \\\"--recover\\\")\",\"newString\":\"    commit_all(root, \\\"invocation marker for item 1\\\")\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\", \\\"--recover\\\")\",\"originalFile\":\"\\\"\\\"\\\"attavo drive: the mechanical transitions between approval and\\nready-to-merge (issue #84) -- one step per invocation, and only that step,\\nuntil a state that belongs to a person. Every test uses the fixture\\nadapter and a fake `[forge].checks_command`; every record commit is\\n`git commit --only` and pushed to a real (bare) fixture remote.\\n\\nRegression tests, written and run red first: on `main` at 85f6f3b there\\nwas no `drive` subcommand, so every one of these failed with \\\"unknown\\nsubcommand\\\".\\n\\nRun: python3 -m pytest tests -q\\n\\\"\\\"\\\"\\nimport importlib.machinery\\nimport importlib.util\\nimport json\\nimport os\\nimport socket\\nimport subprocess\\nimport sys\\nimport time\\nfrom pathlib import Path\\n\\nfrom helpers import commit_all, git, make_tenant\\n\\nROOT = Path(__file__).resolve().parent.parent\\nATTAVO = ROOT / \\\"bin\\\" / \\\"attavo\\\"\\n\\nGREEN_FORGE = \\\"printf 'ci success\\\\\\\\n'\\\"\\n# A concluded conclusion -- checked and failing, not something still\\n# running. Distinct from UNCONCLUDED_FORGE below (issue #84): drive polls\\n# the one still running for the bound, but stops on the first read of a\\n# check that has already concluded, whether or not it passed.\\nRED_FORGE = \\\"printf 'ci failure\\\\\\\\n'\\\"\\nUNCONCLUDED_FORGE = \\\"printf 'ci in_progress\\\\\\\\n'\\\"\\n\\n# The real defaults (ATTAVO_DRIVE_POLL_BOUND_S=600, _INTERVAL_S=20) are a\\n# real forge's clock, not a test's -- tenant zero's own checks conclude\\n# about five minutes after a push. Every `attavo drive` call here runs\\n# against this much shorter clock instead, read at call time from the\\n# same environment variables; test_drive_forge_poll_defaults_are_a_real_\\n# forges_clock is the one test that leaves them unset, to assert the\\n# defaults themselves. The interval is kept well above typical subprocess\\n# startup overhead so a zero-sleep stop and a polled one are easy to tell\\n# apart by wall clock alone.\\nFAST_POLL_ENV = {\\\"ATTAVO_DRIVE_POLL_BOUND_S\\\": \\\"0.9\\\", \\\"ATTAVO_DRIVE_POLL_INTERVAL_S\\\": \\\"0.5\\\"}\\n\\n\\ndef run_attavo(root: Path, *args: str, env: dict | None = None) -> subprocess.CompletedProcess:\\n    full_env = dict(os.environ)\\n    full_env.update(FAST_POLL_ENV)\\n    if env:\\n        full_env.update(env)\\n    return subprocess.run([sys.executable, str(ATTAVO), *args], cwd=str(root),\\n                          capture_output=True, text=True, check=False, env=full_env)\\n\\n\\ndef attavo_module():\\n    \\\"\\\"\\\"bin/attavo imported in-process, for the default-constant assertion\\n    below that a CLI invocation cannot provoke without actually waiting\\n    out the real clock.\\\"\\\"\\\"\\n    loader = importlib.machinery.SourceFileLoader(\\\"attavo_drive_under_test\\\", str(ATTAVO))\\n    spec = importlib.util.spec_from_loader(loader.name, loader)\\n    module = importlib.util.module_from_spec(spec)\\n    loader.exec_module(module)\\n    return module\\n\\n\\ndef add_forge(root: Path, checks_command: str) -> None:\\n    toml = root / \\\"attavo.toml\\\"\\n    toml.write_text(toml.read_text() + f'\\\\n[forge]\\\\nchecks_command = \\\"{checks_command}\\\"\\\\n')\\n    commit_all(root, \\\"configure the forge read\\\")\\n\\n\\ndef approve_item(root: Path, item: str = \\\"1\\\") -> None:\\n    assert run_attavo(root, \\\"spec-gate\\\", item).returncode == 0\\n    assert run_attavo(root, \\\"approve\\\", item, \\\"--by\\\", \\\"alice\\\").returncode == 0\\n\\n\\ndef add_bare_remote(root: Path, tmp_path: Path) -> Path:\\n    \\\"\\\"\\\"A real (bare) remote named origin, seeded with the tenant's current\\n    state -- drive's own push target, distinct from the fake\\n    refs/remotes/origin/* helpers.init_repo sets up purely for verify's\\n    diff base.\\\"\\\"\\\"\\n    bare = tmp_path / \\\"origin.git\\\"\\n    subprocess.run([\\\"git\\\", \\\"init\\\", \\\"--quiet\\\", \\\"--bare\\\", \\\"-b\\\", \\\"main\\\", str(bare)], check=True)\\n    git(root, \\\"remote\\\", \\\"add\\\", \\\"origin\\\", str(bare))\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n    git(root, \\\"push\\\", \\\"origin\\\", f\\\"HEAD:{branch}\\\")\\n    return bare\\n\\n\\ndef records_dir(root: Path, item: str = \\\"1\\\") -> Path:\\n    return root / \\\"records\\\" / item\\n\\n\\ndef record_files(root: Path, stage: str, item: str = \\\"1\\\") -> list[Path]:\\n    return sorted(records_dir(root, item).glob(f\\\"{stage}-*.json\\\"))\\n\\n\\ndef latest_record(root: Path, stage: str, item: str = \\\"1\\\") -> dict:\\n    files = record_files(root, stage, item)\\n    assert files, f\\\"no {stage} record for item {item}\\\"\\n    return json.loads(files[-1].read_text())\\n\\n\\ndef head_of(root: Path) -> str:\\n    return git(root, \\\"rev-parse\\\", \\\"HEAD\\\").strip()\\n\\n\\ndef last_commit_paths(root: Path) -> list[str]:\\n    return git(root, \\\"diff\\\", \\\"--name-only\\\", \\\"HEAD^\\\", \\\"HEAD\\\").splitlines()\\n\\n\\ndef remote_head(bare: Path, branch: str = \\\"main\\\") -> str:\\n    return subprocess.run([\\\"git\\\", \\\"-C\\\", str(bare), \\\"rev-parse\\\", branch],\\n                          capture_output=True, text=True, check=True).stdout.strip()\\n\\n\\ndef test_drive_refuses_without_a_valid_approval(tmp_path):\\n    \\\"\\\"\\\"Acceptance row 6. No approval at all: refused by name, nothing run\\n    -- no spec-gate, no build, no records of any kind written.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    add_bare_remote(root, tmp_path)\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run.returncode != 0\\n    assert \\\"approval\\\" in run.stdout\\n    assert \\\"absent\\\" in run.stdout\\n\\n    assert not records_dir(root).exists() or list(records_dir(root).glob(\\\"*.json\\\")) == []\\n\\n\\ndef test_drive_refuses_with_an_expired_approval(tmp_path):\\n    \\\"\\\"\\\"Acceptance row 6, the other half: an approval bound to a spec sha\\n    that has since moved is expired, not absent -- still refused by name,\\n    nothing run.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n\\n    (root / \\\"specs\\\" / \\\"1\\\" / \\\"spec.md\\\").write_text(\\n        (root / \\\"specs\\\" / \\\"1\\\" / \\\"spec.md\\\").read_text() + \\\"\\\\n\\\")\\n    commit_all(root, \\\"touch the spec after approval\\\")\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run.returncode != 0\\n    assert \\\"expired\\\" in run.stdout\\n    assert record_files(root, \\\"build\\\") == []\\n\\n\\ndef test_drive_builds_from_an_approved_spec_with_no_build(tmp_path):\\n    \\\"\\\"\\\"Acceptance row 1. One drive run produces a passing build record,\\n    commits only the record and its log (`git commit --only`), and pushes\\n    the branch; the fixture remote carries the record commit.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    bare = add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n\\n    rec = latest_record(root, \\\"build\\\")\\n    assert rec[\\\"status\\\"] == \\\"pass\\\"\\n\\n    record_path = record_files(root, \\\"build\\\")[-1]\\n    log_path = record_path.with_suffix(\\\".log\\\")\\n    assert log_path.exists()\\n\\n    touched = set(last_commit_paths(root))\\n    assert touched == {\\n        str(record_path.relative_to(root)),\\n        str(log_path.relative_to(root)),\\n    }\\n\\n    assert remote_head(bare, branch) == head_of(root)\\n\\n\\ndef test_drive_leaves_the_events_file_out_of_the_record_commit(tmp_path):\\n    \\\"\\\"\\\"Issue #26, acceptance row 2, strengthened by issue #140: attavo\\n    build always writes a stage's events file now (test_build.py's own\\n    row-1 tests), under the checkout's own git directory rather than\\n    the working tree -- so it is not merely excluded from the commit's\\n    file list, it is not even a path git tracks anything under. The\\n    commit's file list still names only the record and its log.\\n    \\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n\\n    record_path = record_files(root, \\\"build\\\")[-1]\\n    git_dir = git(root, \\\"rev-parse\\\", \\\"--absolute-git-dir\\\").strip()\\n    events_path = Path(git_dir) / \\\"attavo\\\" / \\\"build-01.events.jsonl\\\"\\n    assert events_path.is_file()\\n\\n    touched = set(last_commit_paths(root))\\n    assert touched == {\\n        str(record_path.relative_to(root)),\\n        str(record_path.with_suffix(\\\".log\\\").relative_to(root)),\\n    }\\n\\n\\ndef test_drive_commits_the_record_as_the_driver_not_the_tenants_own_identity(tmp_path):\\n    \\\"\\\"\\\"The driver's identity (driver_identity, beside executor_identity):\\n    set by the product, never the tenant's git config, so a driven item's\\n    record commits are never indistinguishable from an operator's own.\\n    The fixture tenant's user.name is set to another value here, so a\\n    commit carrying it would prove commit_record fell back to the\\n    tenant's git config instead.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    git(root, \\\"config\\\", \\\"user.name\\\", \\\"Some Operator\\\")\\n    git(root, \\\"config\\\", \\\"user.email\\\", \\\"operator@example.com\\\")\\n    add_forge(root, GREEN_FORGE)\\n    add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n\\n    author_name = git(root, \\\"log\\\", \\\"-1\\\", \\\"--format=%an\\\").strip()\\n    author_email = git(root, \\\"log\\\", \\\"-1\\\", \\\"--format=%ae\\\").strip()\\n    committer_name = git(root, \\\"log\\\", \\\"-1\\\", \\\"--format=%cn\\\").strip()\\n    committer_email = git(root, \\\"log\\\", \\\"-1\\\", \\\"--format=%ce\\\").strip()\\n\\n    assert author_name == \\\"attavo driver\\\"\\n    assert author_email == \\\"driver@attavo.invalid\\\"\\n    assert committer_name == \\\"attavo driver\\\"\\n    assert committer_email == \\\"driver@attavo.invalid\\\"\\n\\n\\ndef test_drive_verifies_from_a_passed_build_with_the_forge_green(tmp_path):\\n    \\\"\\\"\\\"Acceptance row 2. From a passed build with the fake forge green,\\n    one run produces a verify record, commits only the record and its log,\\n    and pushes.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    bare = add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n\\n    assert run_attavo(root, \\\"drive\\\", \\\"1\\\").returncode == 0  # builds\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n\\n    assert record_files(root, \\\"build\\\") and record_files(root, \\\"verify\\\")\\n    rec = latest_record(root, \\\"verify\\\")\\n    assert rec[\\\"status\\\"] == \\\"pass\\\"\\n\\n    record_path = record_files(root, \\\"verify\\\")[-1]\\n    log_path = record_path.with_suffix(\\\".log\\\")\\n    assert log_path.exists()\\n\\n    touched = set(last_commit_paths(root))\\n    assert touched == {\\n        str(record_path.relative_to(root)),\\n        str(log_path.relative_to(root)),\\n    }\\n\\n    assert remote_head(bare, branch) == head_of(root)\\n\\n\\ndef test_drive_verifies_again_when_the_latest_verify_is_superseded_by_a_later_build(tmp_path):\\n    \\\"\\\"\\\"Acceptance row 4, issue #109. A verify record can only name a build\\n    that existed when it was written, so a later build makes the latest\\n    verify superseded, never a mismatch -- drive derives the next stage\\n    as verify, not build, and never refuses.\\n\\n    Regression: on main before this lane, drive_state's own inline\\n    staleness check already treats this as 'verify', so this test does\\n    not fail against current code -- it is here to lock the behavior\\n    check_attest_chain's fix must not disturb (the acceptance table's\\n    'never refuses' row).\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n\\n    assert run_attavo(root, \\\"drive\\\", \\\"1\\\").returncode == 0  # builds\\n    assert run_attavo(root, \\\"drive\\\", \\\"1\\\").returncode == 0  # verifies\\n\\n    # A second build record, minted by hand -- a real re-run of the\\n    # fixture adapter is not idempotent against its own tree -- naming a\\n    # sha the existing verify-01 does not: verify-01 is now superseded.\\n    build_01 = json.loads(record_files(root, \\\"build\\\")[-1].read_text())\\n    build_01[\\\"sha\\\"] = \\\"f\\\" * 40\\n    (records_dir(root) / \\\"build-02.json\\\").write_text(json.dumps(build_01))\\n    commit_all(root, \\\"attavo: second build record for #1, minted by hand\\\")\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n    assert len(record_files(root, \\\"build\\\")) == 2\\n    assert len(record_files(root, \\\"verify\\\")) == 2\\n    rec = latest_record(root, \\\"verify\\\")\\n    assert rec[\\\"status\\\"] == \\\"pass\\\"\\n    assert rec[\\\"build_sha\\\"] == build_01[\\\"sha\\\"]\\n\\n\\ndef test_drive_prints_ready_to_merge_from_a_passed_verify(tmp_path):\\n    \\\"\\\"\\\"Acceptance row 3. From a passed verify with the forge green, one\\n    run prints ready-to-merge, exits 0, writes nothing, enqueues nothing\\n    -- and, per row 8, a further run repeats exactly the same thing.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n\\n    assert run_attavo(root, \\\"drive\\\", \\\"1\\\").returncode == 0  # builds\\n    assert run_attavo(root, \\\"drive\\\", \\\"1\\\").returncode == 0  # verifies\\n\\n    pre_head = head_of(root)\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n    assert \\\"ready to merge\\\" in run.stdout\\n    assert head_of(root) == pre_head\\n    assert record_files(root, \\\"verify\\\") and len(record_files(root, \\\"verify\\\")) == 1\\n\\n    # Acceptance row 8: idempotence -- run it again, same result, nothing\\n    # new written or pushed.\\n    run2 = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run2.returncode == 0\\n    assert \\\"ready to merge\\\" in run2.stdout\\n    assert head_of(root) == pre_head\\n    assert len(record_files(root, \\\"verify\\\")) == 1\\n    assert len(record_files(root, \\\"build\\\")) == 1\\n\\n\\ndef test_drive_until_ready_runs_build_then_verify_to_ready_in_one_call(tmp_path):\\n    \\\"\\\"\\\"Issue #100's own followups. --until-ready repeats step-and-wait in\\n    the same process: one call, from an approved item with the forge\\n    green, builds, verifies, and prints ready to merge -- both records\\n    written and pushed, without the caller invoking drive again after\\n    each passing step.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    bare = add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\", \\\"--until-ready\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n    assert \\\"ready to merge\\\" in run.stdout\\n\\n    assert len(record_files(root, \\\"build\\\")) == 1\\n    assert len(record_files(root, \\\"verify\\\")) == 1\\n    assert latest_record(root, \\\"build\\\")[\\\"status\\\"] == \\\"pass\\\"\\n    assert latest_record(root, \\\"verify\\\")[\\\"status\\\"] == \\\"pass\\\"\\n    assert remote_head(bare, branch) == head_of(root)\\n\\n    # Idempotence, same as the single-step form: a further --until-ready\\n    # call repeats exactly the same ready-to-merge result, writing nothing.\\n    run2 = run_attavo(root, \\\"drive\\\", \\\"1\\\", \\\"--until-ready\\\")\\n    assert run2.returncode == 0\\n    assert \\\"ready to merge\\\" in run2.stdout\\n    assert len(record_files(root, \\\"build\\\")) == 1\\n    assert len(record_files(root, \\\"verify\\\")) == 1\\n\\n\\ndef test_drive_without_the_flag_still_takes_one_step_at_a_time(tmp_path):\\n    \\\"\\\"\\\"Regression: --until-ready is additive. With no flag, an approved\\n    item with the forge green still needs two separate calls -- build,\\n    then verify -- exactly as before this issue.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run.returncode == 0\\n    assert record_files(root, \\\"build\\\") and not record_files(root, \\\"verify\\\")\\n\\n    run2 = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run2.returncode == 0\\n    assert record_files(root, \\\"verify\\\")\\n\\n\\ndef test_drive_until_ready_stops_on_a_halt(tmp_path):\\n    \\\"\\\"\\\"A step that stops on its own account -- here, a halted build --\\n    stops the --until-ready loop exactly where the single-step form\\n    would, printing the same thing; it does not retry the halted step.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    bare = add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\", \\\"--until-ready\\\",\\n                     env={\\\"ATTAVO_FIXTURE_QUESTION\\\": \\\"which overlay wins?\\\"})\\n    assert run.returncode == 3\\n    assert \\\"which overlay wins?\\\" in run.stdout\\n\\n    assert len(record_files(root, \\\"build\\\")) == 1\\n    assert latest_record(root, \\\"build\\\")[\\\"status\\\"] == \\\"halted\\\"\\n    assert record_files(root, \\\"verify\\\") == []\\n    assert remote_head(bare, branch) == head_of(root)\\n\\n\\ndef test_drive_until_ready_stops_when_the_forge_goes_red_after_a_build(tmp_path):\\n    \\\"\\\"\\\"A build that passes, then a forge that concludes red for verify's\\n    own gate, stops the loop there -- one record written (the pass), no\\n    verify record, no retry of the forge read.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, RED_FORGE)\\n    add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\", \\\"--until-ready\\\")\\n    assert run.returncode != 0\\n    assert \\\"ci\\\" in run.stdout and \\\"failure\\\" in run.stdout\\n\\n    assert len(record_files(root, \\\"build\\\")) == 1\\n    assert latest_record(root, \\\"build\\\")[\\\"status\\\"] == \\\"pass\\\"\\n    assert record_files(root, \\\"verify\\\") == []\\n\\n\\ndef test_drive_stops_when_the_forge_is_red(tmp_path):\\n    \\\"\\\"\\\"Acceptance row 4. A forge read where the one check has already\\n    concluded and failed is not polled at all -- there is nothing left to\\n    wait on, so drive stops on the first read, naming the check, with no\\n    sleep in between. Writes nothing -- no verify record at all, no new\\n    commit.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, RED_FORGE)\\n    add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n\\n    assert run_attavo(root, \\\"drive\\\", \\\"1\\\").returncode == 0  # builds\\n    pre_head = head_of(root)\\n\\n    started = time.monotonic()\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    elapsed = time.monotonic() - started\\n    assert run.returncode != 0\\n    assert \\\"ci\\\" in run.stdout and \\\"failure\\\" in run.stdout\\n    assert elapsed < 0.4, (\\n        f\\\"a concluded, red forge check should stop on the first read with no \\\"\\n        f\\\"poll interval slept -- took {elapsed:.2f}s\\\")\\n\\n    assert record_files(root, \\\"verify\\\") == []\\n    assert head_of(root) == pre_head\\n\\n    # Idempotence (row 8): running again in the same red state stops the\\n    # same way, still nothing written.\\n    run2 = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run2.returncode != 0\\n    assert record_files(root, \\\"verify\\\") == []\\n    assert head_of(root) == pre_head\\n\\n\\ndef test_drive_polls_the_bound_while_the_forge_is_still_running(tmp_path):\\n    \\\"\\\"\\\"Acceptance row 4, the unconcluded case: a check still carrying a\\n    status (in_progress) rather than a conclusion is not yet red -- drive\\n    keeps polling it for the full bound before giving up, unlike a\\n    concluded red check, which it does not poll at all. Writes nothing.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, UNCONCLUDED_FORGE)\\n    add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n\\n    assert run_attavo(root, \\\"drive\\\", \\\"1\\\").returncode == 0  # builds\\n\\n    started = time.monotonic()\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    elapsed = time.monotonic() - started\\n    assert run.returncode != 0\\n    assert \\\"ci\\\" in run.stdout and \\\"in_progress\\\" in run.stdout\\n    assert elapsed >= 0.4, (\\n        f\\\"a check still in_progress should be polled for the bound, not \\\"\\n        f\\\"stopped on the first read -- took only {elapsed:.2f}s\\\")\\n\\n    assert record_files(root, \\\"verify\\\") == []\\n\\n\\ndef test_drive_halts_on_a_question_and_resumes_at_build_after_a_ruling(tmp_path):\\n    \\\"\\\"\\\"Acceptance row 5. The fixture adapter halts with a question: drive\\n    stops naming the question and the record (and still pushes that\\n    halted record, same as any other record build writes). After a\\n    ruling is appended, a second run resumes at build and this time\\n    passes.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    bare = add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\",\\n                     env={\\\"ATTAVO_FIXTURE_QUESTION\\\": \\\"which overlay wins?\\\"})\\n    assert run.returncode == 3\\n    assert \\\"which overlay wins?\\\" in run.stdout\\n\\n    rec = latest_record(root, \\\"build\\\")\\n    assert rec[\\\"status\\\"] == \\\"halted\\\"\\n    assert rec[\\\"halted\\\"] == {\\\"question\\\": \\\"which overlay wins?\\\"}\\n    record_path = record_files(root, \\\"build\\\")[-1]\\n    assert record_path.name in run.stdout\\n\\n    # The halted record was still committed and pushed.\\n    assert remote_head(bare, branch) == head_of(root)\\n\\n    rulings = root / \\\"rulings.md\\\"\\n    rulings.write_text(rulings.read_text() + \\\"\\\\n- overlay: use the base tree\\\\n\\\"\\n                       if rulings.exists() else \\\"- overlay: use the base tree\\\\n\\\")\\n    commit_all(root, \\\"rule on the overlay question\\\")\\n    git(root, \\\"push\\\", \\\"origin\\\", f\\\"HEAD:{branch}\\\")\\n\\n    run2 = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run2.returncode == 0, run2.stdout + run2.stderr\\n\\n    assert len(record_files(root, \\\"build\\\")) == 2\\n    rec2 = latest_record(root, \\\"build\\\")\\n    assert rec2[\\\"status\\\"] == \\\"pass\\\"\\n    assert remote_head(bare, branch) == head_of(root)\\n\\n\\ndef configure_counsel(root: Path) -> None:\\n    \\\"\\\"\\\"[executor].counsel = \\\"fixture\\\" -- build_valid's own manifest\\n    declares [executor].build = \\\"fixture\\\" only; counsel needs its own\\n    adapter named (issue #100).\\\"\\\"\\\"\\n    toml = root / \\\"attavo.toml\\\"\\n    toml.write_text(toml.read_text().replace(\\n        '[executor]\\\\nbuild = \\\"fixture\\\"', '[executor]\\\\nbuild = \\\"fixture\\\"\\\\ncounsel = \\\"fixture\\\"'))\\n    commit_all(root, \\\"configure the counsel adapter\\\")\\n\\n\\ndef test_drive_counsels_a_stop_before_filing_it_and_commits_both_records_together(tmp_path):\\n    \\\"\\\"\\\"Issue #100, acceptance row 3. On a stop, drive calls counsel\\n    before file-stops, and commits the counsel record with the stage\\n    record in one commit.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    bare = add_bare_remote(root, tmp_path)\\n    configure_counsel(root)\\n    approve_item(root)\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n    filed = tmp_path / \\\"filed.jsonl\\\"\\n    configure_filing(root, filed)\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\",\\n                     env={\\\"ATTAVO_FIXTURE_QUESTION\\\": \\\"which overlay wins?\\\"})\\n    assert run.returncode == 3\\n\\n    assert record_files(root, \\\"counsel\\\")\\n    counsel_rec = latest_record(root, \\\"counsel\\\")\\n    assert counsel_rec[\\\"record_stage\\\"] == \\\"build\\\"\\n    assert counsel_rec[\\\"record\\\"] == \\\"build-01\\\"\\n    assert counsel_rec[\\\"verdict\\\"] == \\\"person\\\"\\n\\n    committed = set(last_commit_paths(root))\\n    assert committed == {\\n        \\\"records/1/build-01.json\\\", \\\"records/1/build-01.log\\\",\\n        \\\"records/1/counsel-01.json\\\", \\\"records/1/counsel-01.log\\\",\\n        \\\"records/1/build-01.filed\\\",\\n    }\\n    assert remote_head(bare, branch) == head_of(root)\\n\\n    filed_bodies = [json.loads(l) for l in filed.read_text().splitlines() if l.strip()]\\n    assert len(filed_bodies) == 1\\n    assert filed_bodies[0][\\\"counsel_verdict\\\"] == \\\"person\\\"\\n    assert filed_bodies[0][\\\"counsel_proposal\\\"][\\\"question\\\"]\\n\\n\\ndef test_drive_still_files_a_stop_with_no_counsel_adapter_configured(tmp_path):\\n    \\\"\\\"\\\"counsel refuses gracefully (no [executor].counsel or\\n    [executor].verify) -- drive still files and transports the stage\\n    record; nothing new for counsel to commit.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    bare = add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n    filed = tmp_path / \\\"filed.jsonl\\\"\\n    configure_filing(root, filed)\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\",\\n                     env={\\\"ATTAVO_FIXTURE_QUESTION\\\": \\\"which overlay wins?\\\"})\\n    assert run.returncode == 3\\n\\n    assert record_files(root, \\\"counsel\\\") == []\\n    committed = set(last_commit_paths(root))\\n    assert committed == {\\\"records/1/build-01.json\\\", \\\"records/1/build-01.log\\\",\\n                         \\\"records/1/build-01.filed\\\"}\\n    assert remote_head(bare, branch) == head_of(root)\\n\\n\\ndef configure_filing(root: Path, filed_path: Path) -> None:\\n    \\\"\\\"\\\"Appended under the [forge] table add_forge already opened -- a\\n    second [forge] header in the same file is a TOML redeclaration\\n    error. Prints a fake issue URL on stdout, numbered by filed_path's\\n    own line count so far -- the fact a real file_issue_command's stdout\\n    would carry, and what the .filed marker beside each stop record is\\n    meant to hold (issue #89).\\\"\\\"\\\"\\n    toml = root / \\\"attavo.toml\\\"\\n    command = (f\\\"n=$(wc -l < {filed_path} 2>/dev/null || echo 0); \\\"\\n              f\\\"cat >> {filed_path}; \\\"\\n              f\\\"echo https://github.com/tenant/repo/issues/$((n + 1))\\\")\\n    toml.write_text(toml.read_text() + f\\\"\\\\nfile_issue_command = '{command}'\\\\n\\\")\\n    commit_all(root, \\\"configure issue filing\\\")\\n\\n\\ndef test_drive_files_a_stop_it_reports_exactly_once(tmp_path):\\n    \\\"\\\"\\\"Issue #89, acceptance row 5. A stop drive reports -- here, the\\n    fixture adapter's halt -- calls file-stops once: one drive run files\\n    exactly one issue for the attempt it just wrote, not zero and not\\n    more than one.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n    filed = tmp_path / \\\"filed.jsonl\\\"\\n    configure_filing(root, filed)\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\",\\n                     env={\\\"ATTAVO_FIXTURE_QUESTION\\\": \\\"which overlay wins?\\\"})\\n    assert run.returncode == 3\\n\\n    filed_bodies = [json.loads(l) for l in filed.read_text().splitlines() if l.strip()]\\n    assert len(filed_bodies) == 1\\n    assert filed_bodies[0][\\\"record\\\"] == \\\"records/1/build-01.json\\\"\\n\\n    # A second drive run halts again -- a new attempt, build-02 -- and\\n    # files exactly one more issue for that new record; file-stops' own\\n    # .filed marker means build-01's issue is never filed twice.\\n    run2 = run_attavo(root, \\\"drive\\\", \\\"1\\\",\\n                      env={\\\"ATTAVO_FIXTURE_QUESTION\\\": \\\"which overlay wins?\\\"})\\n    assert run2.returncode == 3\\n    assert len(record_files(root, \\\"build\\\")) == 2\\n\\n    filed_bodies_after = [json.loads(l) for l in filed.read_text().splitlines() if l.strip()]\\n    assert len(filed_bodies_after) == 2\\n    assert filed_bodies_after[0] == filed_bodies[0]\\n    assert filed_bodies_after[1][\\\"record\\\"] == \\\"records/1/build-02.json\\\"\\n\\n\\ndef test_drive_marker_holds_the_filing_commands_stdout_and_is_committed_with_the_record(tmp_path):\\n    \\\"\\\"\\\"A stop's own .filed marker is written before the record is\\n    transported, so it carries the filing command's stdout (the issue it\\n    opened) and rides in the very same commit as the record and its log\\n    -- one commit, one push, as before this fix. Red before it: the\\n    marker was written empty, after commit_record and push_record_commit\\n    had already run, so it was never part of any commit at all.\\n    \\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    bare = add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n    filed = tmp_path / \\\"filed.jsonl\\\"\\n    configure_filing(root, filed)\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\",\\n                     env={\\\"ATTAVO_FIXTURE_QUESTION\\\": \\\"which overlay wins?\\\"})\\n    assert run.returncode == 3\\n\\n    marker_path = records_dir(root) / \\\"build-01.filed\\\"\\n    assert marker_path.is_file()\\n    assert marker_path.read_text().strip() == \\\"https://github.com/tenant/repo/issues/1\\\"\\n\\n    committed = set(last_commit_paths(root))\\n    assert committed == {\\\"records/1/build-01.json\\\", \\\"records/1/build-01.log\\\",\\n                         \\\"records/1/build-01.filed\\\"}\\n    assert remote_head(bare) == head_of(root)\\n\\n\\ndef test_drive_a_second_run_in_the_same_state_files_nothing(tmp_path):\\n    \\\"\\\"\\\"Issue #89. The marker committed and pushed above is the fact a\\n    second worktree or a fresh clone reads too -- a second drive run\\n    against the same records, from a fresh clone of the remote drive\\n    already pushed to, files nothing for the stop that clone already\\n    carries a marker for. Red before this fix: the marker never reached\\n    the remote at all, so every clone refiled every stop it found.\\n    \\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    bare = add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n    filed = tmp_path / \\\"filed.jsonl\\\"\\n    configure_filing(root, filed)\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\",\\n                     env={\\\"ATTAVO_FIXTURE_QUESTION\\\": \\\"which overlay wins?\\\"})\\n    assert run.returncode == 3\\n    filed_after_first = filed.read_text()\\n    assert filed_after_first.strip() != \\\"\\\"\\n\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n    clone = tmp_path / \\\"fresh-clone\\\"\\n    subprocess.run([\\\"git\\\", \\\"clone\\\", \\\"--quiet\\\", \\\"--branch\\\", branch, str(bare), str(clone)],\\n                   check=True)\\n\\n    run2 = run_attavo(clone, \\\"file-stops\\\", \\\"1\\\")\\n    assert run2.returncode == 0\\n    assert \\\"no stops to file\\\" in run2.stdout\\n    assert filed.read_text() == filed_after_first  # nothing new was filed\\n\\n\\ndef test_drive_retries_a_rejected_push_with_a_merge_never_a_rebase(tmp_path):\\n    \\\"\\\"\\\"Acceptance row 7. A rejected push with a divergent remote is\\n    retried after `git pull --no-rebase --no-edit`, never a rebase; the\\n    build record's own sha is unchanged (still reachable, still what the\\n    record names), and the retry lands a merge commit, not a rewritten\\n    one.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    bare = add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n\\n    # Diverge the bare remote: another clone pushes an unrelated commit to\\n    # the same branch before drive's own push happens.\\n    other = tmp_path / \\\"other-clone\\\"\\n    subprocess.run([\\\"git\\\", \\\"clone\\\", \\\"--quiet\\\", str(bare), str(other)], check=True)\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(other), \\\"checkout\\\", \\\"-q\\\", branch], check=True)\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(other), \\\"config\\\", \\\"user.email\\\", \\\"other@example.com\\\"],\\n                   check=True)\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(other), \\\"config\\\", \\\"user.name\\\", \\\"Other\\\"], check=True)\\n    (other / \\\"concurrent.txt\\\").write_text(\\\"from elsewhere\\\\n\\\")\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(other), \\\"add\\\", \\\"-A\\\"], check=True)\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(other), \\\"commit\\\", \\\"-q\\\", \\\"-m\\\", \\\"a concurrent commit\\\"],\\n                   check=True)\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(other), \\\"push\\\", \\\"origin\\\", f\\\"HEAD:{branch}\\\"], check=True)\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n\\n    rec = latest_record(root, \\\"build\\\")\\n    assert rec[\\\"status\\\"] == \\\"pass\\\"\\n    build_sha = rec[\\\"sha\\\"]\\n\\n    # The build's own commit sha is still reachable -- a merge, not a\\n    # rebase, which would have rewritten it under a new sha.\\n    assert build_sha in git(root, \\\"rev-list\\\", \\\"HEAD\\\").split()\\n\\n    # The retry landed a merge commit somewhere in history, not\\n    # necessarily at HEAD -- the invocation marker's own push is the one\\n    # that met the divergent remote and retried; the build record's own\\n    # push, once the branches were already merged, needed no retry of\\n    # its own.\\n    assert git(root, \\\"rev-list\\\", \\\"--merges\\\", \\\"HEAD\\\").split(), \\\\\\n        \\\"the retry should have landed a merge commit\\\"\\n\\n    assert remote_head(bare, branch) == head_of(root)\\n    # the concurrent commit from the other clone is present too\\n    assert \\\"concurrent.txt\\\" in git(root, \\\"ls-tree\\\", \\\"-r\\\", \\\"--name-only\\\", \\\"HEAD\\\")\\n\\n\\ndef add_drive_stall_bound(root: Path, seconds: int) -> None:\\n    toml = root / \\\"attavo.toml\\\"\\n    toml.write_text(toml.read_text() + f\\\"\\\\n[drive]\\\\nstall_after_s = {seconds}\\\\n\\\")\\n    commit_all(root, \\\"configure the drive stall bound\\\")\\n\\n\\ndef test_drive_writes_and_pushes_an_invocation_marker_before_running_the_stage(tmp_path):\\n    \\\"\\\"\\\"Issue #151. Before running build, drive writes a build-01.started\\n    marker and commits and pushes it by itself -- the fact that this\\n    invocation began is on the branch before the adapter ever runs, so a\\n    process that dies mid-build still leaves it behind.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    bare = add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n\\n    marker_path = records_dir(root) / \\\"build-01.started\\\"\\n    assert marker_path.is_file()\\n    info = json.loads(marker_path.read_text())\\n    assert info[\\\"pid\\\"] > 0 and info[\\\"host\\\"] and info[\\\"sha\\\"]\\n\\n    # The marker's own commit precedes the record's own commit; both\\n    # reached the remote.\\n    marker_commit = git(root, \\\"log\\\", \\\"-1\\\", \\\"--format=%H\\\",\\n                        \\\"--\\\", \\\"records/1/build-01.started\\\").strip()\\n    record_commit = git(root, \\\"log\\\", \\\"-1\\\", \\\"--format=%H\\\",\\n                        \\\"--\\\", \\\"records/1/build-01.json\\\").strip()\\n    assert marker_commit != record_commit\\n    is_ancestor = subprocess.run(\\n        [\\\"git\\\", \\\"-C\\\", str(root), \\\"merge-base\\\", \\\"--is-ancestor\\\", marker_commit, record_commit],\\n        check=False)\\n    assert is_ancestor.returncode == 0, \\\"the marker's commit should precede the record's\\\"\\n    assert remote_head(bare, branch) == head_of(root)\\n\\n\\ndef test_drive_recover_writes_a_died_record_for_a_dead_marker(tmp_path):\\n    \\\"\\\"\\\"Issue #151, acceptance row 2. A marker naming a dead pid on this\\n    host, with no record beside it, is recovered as a failed record, stop\\n    class died, provenance product, committed by the driver identity with\\n    a clean tree -- the fixture #148 left behind by hand, done here by\\n    the product instead.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_drive_stall_bound(root, 60)\\n    bare = add_bare_remote(root, tmp_path)\\n\\n    dead = subprocess.Popen([sys.executable, \\\"-c\\\", \\\"pass\\\"])\\n    dead.wait()\\n    marker = records_dir(root) / \\\"build-01.started\\\"\\n    marker.parent.mkdir(parents=True, exist_ok=True)\\n    marker.write_text(json.dumps({\\\"at\\\": \\\"2026-09-17T13:16:08Z\\\", \\\"host\\\": socket.gethostname(),\\n                                  \\\"pid\\\": dead.pid, \\\"sha\\\": head_of(root),\\n                                  \\\"product_version\\\": \\\"fixture\\\"}))\\n    commit_all(root, \\\"invocation marker for item 1\\\")\\n    git(root, \\\"push\\\", \\\"origin\\\", \\\"HEAD:main\\\")\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\", \\\"--recover\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n\\n    rec = latest_record(root, \\\"build\\\")\\n    assert rec[\\\"status\\\"] == \\\"failed\\\"\\n    assert rec[\\\"stop\\\"][\\\"class\\\"] == \\\"died\\\"\\n    assert rec[\\\"stop\\\"][\\\"provenance\\\"] == \\\"product\\\"\\n    assert \\\"wrote no build-01.json\\\" in rec[\\\"stop\\\"][\\\"detail\\\"]\\n\\n    assert (records_dir(root) / \\\"build-01.log\\\").is_file()\\n    assert git(root, \\\"log\\\", \\\"-1\\\", \\\"--format=%an\\\").strip() == \\\"attavo driver\\\"\\n    assert git(root, \\\"status\\\", \\\"--porcelain\\\").strip() == \\\"\\\"\\n    assert remote_head(bare) == head_of(root)\\n\\n\\ndef test_drive_recover_leaves_a_live_invocation_alone(tmp_path):\\n    \\\"\\\"\\\"A marker naming this test process's own pid -- alive on this host\\n    and well inside the stall bound -- is running, not died: recover\\n    writes nothing.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_drive_stall_bound(root, 3600)\\n    approve_item(root)\\n\\n    marker = records_dir(root) / \\\"build-01.started\\\"\\n    marker.parent.mkdir(parents=True, exist_ok=True)\\n    marker.write_text(json.dumps({\\\"at\\\": \\\"2026-09-17T13:16:08Z\\\", \\\"host\\\": socket.gethostname(),\\n                                  \\\"pid\\\": os.getpid(), \\\"sha\\\": head_of(root),\\n                                  \\\"product_version\\\": \\\"fixture\\\"}))\\n    commit_all(root, \\\"invocation marker for a live pid\\\")\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\", \\\"--recover\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n    assert \\\"nothing to recover\\\" in run.stdout\\n    assert record_files(root, \\\"build\\\") == []\\n\\n\\ndef test_drive_forge_poll_defaults_are_a_real_forges_clock():\\n    \\\"\\\"\\\"The bound and interval every other test overrides with\\n    FAST_POLL_ENV default, unset, to at least five minutes and ten\\n    seconds -- tenant zero's own checks conclude about five minutes after\\n    a push, and a bound shorter than that would make every drive run\\n    after a record push stop on 'forge checks not green', with a person\\n    running it again after CI: exactly the transport act this lane\\n    retires. Row 4 (a forge that never goes green) is unchanged in\\n    meaning by this -- it still stops, just after waiting out a real\\n    forge's own clock instead of a test's fake one.\\n    \\\"\\\"\\\"\\n    module = attavo_module()\\n    assert module.DRIVE_FORGE_POLL_BOUND_DEFAULT_S >= 300\\n    assert module.DRIVE_FORGE_POLL_INTERVAL_DEFAULT_S >= 10\\n\",\"structuredPatch\":[{\"oldStart\":806,\"oldLines\":7,\"newStart\":806,\"newLines\":6,\"lines\":[\"                                   \\\"pid\\\": dead.pid, \\\"sha\\\": head_of(root),\",\"                                   \\\"product_version\\\": \\\"fixture\\\"}))\",\"     commit_all(root, \\\"invocation marker for item 1\\\")\",\"-    git(root, \\\"push\\\", \\\"origin\\\", \\\"HEAD:main\\\")\",\" \",\"     run = run_attavo(root, \\\"drive\\\", \\\"1\\\", \\\"--recover\\\")\",\"     assert run.returncode == 0, run.stdout + run.stderr\"]}],\"userModified\":false,\"replaceAll\":false}}\nattest/records/151/build-03.log:698:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_0155JQZfzmBhpGyDh8dUL8mR\",\"type\":\"tool_result\",\"content\":\"The file /Users/davidbean/Projects/attavo-worktree-151/tests/test_drive.py has been updated successfully. (file state is current in your context — no need to Read it back)\"}]},\"parent_tool_use_id\":null,\"session_id\":\"f081a203-e2ee-47b3-8bf8-5fc3aaeb804d\",\"uuid\":\"adae994c-a20f-4c21-abec-06da794c184d\",\"timestamp\":\"2026-09-17T20:00:05.581Z\",\"tool_use_result\":{\"filePath\":\"/Users/davidbean/Projects/attavo-worktree-151/tests/test_drive.py\",\"oldString\":\"    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_drive_stall_bound(root, 3600)\\n    approve_item(root)\\n\\n    marker = records_dir(root) / \\\"build-01.started\\\"\",\"newString\":\"    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_drive_stall_bound(root, 3600)\\n\\n    marker = records_dir(root) / \\\"build-01.started\\\"\",\"originalFile\":\"\\\"\\\"\\\"attavo drive: the mechanical transitions between approval and\\nready-to-merge (issue #84) -- one step per invocation, and only that step,\\nuntil a state that belongs to a person. Every test uses the fixture\\nadapter and a fake `[forge].checks_command`; every record commit is\\n`git commit --only` and pushed to a real (bare) fixture remote.\\n\\nRegression tests, written and run red first: on `main` at 85f6f3b there\\nwas no `drive` subcommand, so every one of these failed with \\\"unknown\\nsubcommand\\\".\\n\\nRun: python3 -m pytest tests -q\\n\\\"\\\"\\\"\\nimport importlib.machinery\\nimport importlib.util\\nimport json\\nimport os\\nimport socket\\nimport subprocess\\nimport sys\\nimport time\\nfrom pathlib import Path\\n\\nfrom helpers import commit_all, git, make_tenant\\n\\nROOT = Path(__file__).resolve().parent.parent\\nATTAVO = ROOT / \\\"bin\\\" / \\\"attavo\\\"\\n\\nGREEN_FORGE = \\\"printf 'ci success\\\\\\\\n'\\\"\\n# A concluded conclusion -- checked and failing, not something still\\n# running. Distinct from UNCONCLUDED_FORGE below (issue #84): drive polls\\n# the one still running for the bound, but stops on the first read of a\\n# check that has already concluded, whether or not it passed.\\nRED_FORGE = \\\"printf 'ci failure\\\\\\\\n'\\\"\\nUNCONCLUDED_FORGE = \\\"printf 'ci in_progress\\\\\\\\n'\\\"\\n\\n# The real defaults (ATTAVO_DRIVE_POLL_BOUND_S=600, _INTERVAL_S=20) are a\\n# real forge's clock, not a test's -- tenant zero's own checks conclude\\n# about five minutes after a push. Every `attavo drive` call here runs\\n# against this much shorter clock instead, read at call time from the\\n# same environment variables; test_drive_forge_poll_defaults_are_a_real_\\n# forges_clock is the one test that leaves them unset, to assert the\\n# defaults themselves. The interval is kept well above typical subprocess\\n# startup overhead so a zero-sleep stop and a polled one are easy to tell\\n# apart by wall clock alone.\\nFAST_POLL_ENV = {\\\"ATTAVO_DRIVE_POLL_BOUND_S\\\": \\\"0.9\\\", \\\"ATTAVO_DRIVE_POLL_INTERVAL_S\\\": \\\"0.5\\\"}\\n\\n\\ndef run_attavo(root: Path, *args: str, env: dict | None = None) -> subprocess.CompletedProcess:\\n    full_env = dict(os.environ)\\n    full_env.update(FAST_POLL_ENV)\\n    if env:\\n        full_env.update(env)\\n    return subprocess.run([sys.executable, str(ATTAVO), *args], cwd=str(root),\\n                          capture_output=True, text=True, check=False, env=full_env)\\n\\n\\ndef attavo_module():\\n    \\\"\\\"\\\"bin/attavo imported in-process, for the default-constant assertion\\n    below that a CLI invocation cannot provoke without actually waiting\\n    out the real clock.\\\"\\\"\\\"\\n    loader = importlib.machinery.SourceFileLoader(\\\"attavo_drive_under_test\\\", str(ATTAVO))\\n    spec = importlib.util.spec_from_loader(loader.name, loader)\\n    module = importlib.util.module_from_spec(spec)\\n    loader.exec_module(module)\\n    return module\\n\\n\\ndef add_forge(root: Path, checks_command: str) -> None:\\n    toml = root / \\\"attavo.toml\\\"\\n    toml.write_text(toml.read_text() + f'\\\\n[forge]\\\\nchecks_command = \\\"{checks_command}\\\"\\\\n')\\n    commit_all(root, \\\"configure the forge read\\\")\\n\\n\\ndef approve_item(root: Path, item: str = \\\"1\\\") -> None:\\n    assert run_attavo(root, \\\"spec-gate\\\", item).returncode == 0\\n    assert run_attavo(root, \\\"approve\\\", item, \\\"--by\\\", \\\"alice\\\").returncode == 0\\n\\n\\ndef add_bare_remote(root: Path, tmp_path: Path) -> Path:\\n    \\\"\\\"\\\"A real (bare) remote named origin, seeded with the tenant's current\\n    state -- drive's own push target, distinct from the fake\\n    refs/remotes/origin/* helpers.init_repo sets up purely for verify's\\n    diff base.\\\"\\\"\\\"\\n    bare = tmp_path / \\\"origin.git\\\"\\n    subprocess.run([\\\"git\\\", \\\"init\\\", \\\"--quiet\\\", \\\"--bare\\\", \\\"-b\\\", \\\"main\\\", str(bare)], check=True)\\n    git(root, \\\"remote\\\", \\\"add\\\", \\\"origin\\\", str(bare))\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n    git(root, \\\"push\\\", \\\"origin\\\", f\\\"HEAD:{branch}\\\")\\n    return bare\\n\\n\\ndef records_dir(root: Path, item: str = \\\"1\\\") -> Path:\\n    return root / \\\"records\\\" / item\\n\\n\\ndef record_files(root: Path, stage: str, item: str = \\\"1\\\") -> list[Path]:\\n    return sorted(records_dir(root, item).glob(f\\\"{stage}-*.json\\\"))\\n\\n\\ndef latest_record(root: Path, stage: str, item: str = \\\"1\\\") -> dict:\\n    files = record_files(root, stage, item)\\n    assert files, f\\\"no {stage} record for item {item}\\\"\\n    return json.loads(files[-1].read_text())\\n\\n\\ndef head_of(root: Path) -> str:\\n    return git(root, \\\"rev-parse\\\", \\\"HEAD\\\").strip()\\n\\n\\ndef last_commit_paths(root: Path) -> list[str]:\\n    return git(root, \\\"diff\\\", \\\"--name-only\\\", \\\"HEAD^\\\", \\\"HEAD\\\").splitlines()\\n\\n\\ndef remote_head(bare: Path, branch: str = \\\"main\\\") -> str:\\n    return subprocess.run([\\\"git\\\", \\\"-C\\\", str(bare), \\\"rev-parse\\\", branch],\\n                          capture_output=True, text=True, check=True).stdout.strip()\\n\\n\\ndef test_drive_refuses_without_a_valid_approval(tmp_path):\\n    \\\"\\\"\\\"Acceptance row 6. No approval at all: refused by name, nothing run\\n    -- no spec-gate, no build, no records of any kind written.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    add_bare_remote(root, tmp_path)\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run.returncode != 0\\n    assert \\\"approval\\\" in run.stdout\\n    assert \\\"absent\\\" in run.stdout\\n\\n    assert not records_dir(root).exists() or list(records_dir(root).glob(\\\"*.json\\\")) == []\\n\\n\\ndef test_drive_refuses_with_an_expired_approval(tmp_path):\\n    \\\"\\\"\\\"Acceptance row 6, the other half: an approval bound to a spec sha\\n    that has since moved is expired, not absent -- still refused by name,\\n    nothing run.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n\\n    (root / \\\"specs\\\" / \\\"1\\\" / \\\"spec.md\\\").write_text(\\n        (root / \\\"specs\\\" / \\\"1\\\" / \\\"spec.md\\\").read_text() + \\\"\\\\n\\\")\\n    commit_all(root, \\\"touch the spec after approval\\\")\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run.returncode != 0\\n    assert \\\"expired\\\" in run.stdout\\n    assert record_files(root, \\\"build\\\") == []\\n\\n\\ndef test_drive_builds_from_an_approved_spec_with_no_build(tmp_path):\\n    \\\"\\\"\\\"Acceptance row 1. One drive run produces a passing build record,\\n    commits only the record and its log (`git commit --only`), and pushes\\n    the branch; the fixture remote carries the record commit.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    bare = add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n\\n    rec = latest_record(root, \\\"build\\\")\\n    assert rec[\\\"status\\\"] == \\\"pass\\\"\\n\\n    record_path = record_files(root, \\\"build\\\")[-1]\\n    log_path = record_path.with_suffix(\\\".log\\\")\\n    assert log_path.exists()\\n\\n    touched = set(last_commit_paths(root))\\n    assert touched == {\\n        str(record_path.relative_to(root)),\\n        str(log_path.relative_to(root)),\\n    }\\n\\n    assert remote_head(bare, branch) == head_of(root)\\n\\n\\ndef test_drive_leaves_the_events_file_out_of_the_record_commit(tmp_path):\\n    \\\"\\\"\\\"Issue #26, acceptance row 2, strengthened by issue #140: attavo\\n    build always writes a stage's events file now (test_build.py's own\\n    row-1 tests), under the checkout's own git directory rather than\\n    the working tree -- so it is not merely excluded from the commit's\\n    file list, it is not even a path git tracks anything under. The\\n    commit's file list still names only the record and its log.\\n    \\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n\\n    record_path = record_files(root, \\\"build\\\")[-1]\\n    git_dir = git(root, \\\"rev-parse\\\", \\\"--absolute-git-dir\\\").strip()\\n    events_path = Path(git_dir) / \\\"attavo\\\" / \\\"build-01.events.jsonl\\\"\\n    assert events_path.is_file()\\n\\n    touched = set(last_commit_paths(root))\\n    assert touched == {\\n        str(record_path.relative_to(root)),\\n        str(record_path.with_suffix(\\\".log\\\").relative_to(root)),\\n    }\\n\\n\\ndef test_drive_commits_the_record_as_the_driver_not_the_tenants_own_identity(tmp_path):\\n    \\\"\\\"\\\"The driver's identity (driver_identity, beside executor_identity):\\n    set by the product, never the tenant's git config, so a driven item's\\n    record commits are never indistinguishable from an operator's own.\\n    The fixture tenant's user.name is set to another value here, so a\\n    commit carrying it would prove commit_record fell back to the\\n    tenant's git config instead.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    git(root, \\\"config\\\", \\\"user.name\\\", \\\"Some Operator\\\")\\n    git(root, \\\"config\\\", \\\"user.email\\\", \\\"operator@example.com\\\")\\n    add_forge(root, GREEN_FORGE)\\n    add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n\\n    author_name = git(root, \\\"log\\\", \\\"-1\\\", \\\"--format=%an\\\").strip()\\n    author_email = git(root, \\\"log\\\", \\\"-1\\\", \\\"--format=%ae\\\").strip()\\n    committer_name = git(root, \\\"log\\\", \\\"-1\\\", \\\"--format=%cn\\\").strip()\\n    committer_email = git(root, \\\"log\\\", \\\"-1\\\", \\\"--format=%ce\\\").strip()\\n\\n    assert author_name == \\\"attavo driver\\\"\\n    assert author_email == \\\"driver@attavo.invalid\\\"\\n    assert committer_name == \\\"attavo driver\\\"\\n    assert committer_email == \\\"driver@attavo.invalid\\\"\\n\\n\\ndef test_drive_verifies_from_a_passed_build_with_the_forge_green(tmp_path):\\n    \\\"\\\"\\\"Acceptance row 2. From a passed build with the fake forge green,\\n    one run produces a verify record, commits only the record and its log,\\n    and pushes.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    bare = add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n\\n    assert run_attavo(root, \\\"drive\\\", \\\"1\\\").returncode == 0  # builds\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n\\n    assert record_files(root, \\\"build\\\") and record_files(root, \\\"verify\\\")\\n    rec = latest_record(root, \\\"verify\\\")\\n    assert rec[\\\"status\\\"] == \\\"pass\\\"\\n\\n    record_path = record_files(root, \\\"verify\\\")[-1]\\n    log_path = record_path.with_suffix(\\\".log\\\")\\n    assert log_path.exists()\\n\\n    touched = set(last_commit_paths(root))\\n    assert touched == {\\n        str(record_path.relative_to(root)),\\n        str(log_path.relative_to(root)),\\n    }\\n\\n    assert remote_head(bare, branch) == head_of(root)\\n\\n\\ndef test_drive_verifies_again_when_the_latest_verify_is_superseded_by_a_later_build(tmp_path):\\n    \\\"\\\"\\\"Acceptance row 4, issue #109. A verify record can only name a build\\n    that existed when it was written, so a later build makes the latest\\n    verify superseded, never a mismatch -- drive derives the next stage\\n    as verify, not build, and never refuses.\\n\\n    Regression: on main before this lane, drive_state's own inline\\n    staleness check already treats this as 'verify', so this test does\\n    not fail against current code -- it is here to lock the behavior\\n    check_attest_chain's fix must not disturb (the acceptance table's\\n    'never refuses' row).\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n\\n    assert run_attavo(root, \\\"drive\\\", \\\"1\\\").returncode == 0  # builds\\n    assert run_attavo(root, \\\"drive\\\", \\\"1\\\").returncode == 0  # verifies\\n\\n    # A second build record, minted by hand -- a real re-run of the\\n    # fixture adapter is not idempotent against its own tree -- naming a\\n    # sha the existing verify-01 does not: verify-01 is now superseded.\\n    build_01 = json.loads(record_files(root, \\\"build\\\")[-1].read_text())\\n    build_01[\\\"sha\\\"] = \\\"f\\\" * 40\\n    (records_dir(root) / \\\"build-02.json\\\").write_text(json.dumps(build_01))\\n    commit_all(root, \\\"attavo: second build record for #1, minted by hand\\\")\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n    assert len(record_files(root, \\\"build\\\")) == 2\\n    assert len(record_files(root, \\\"verify\\\")) == 2\\n    rec = latest_record(root, \\\"verify\\\")\\n    assert rec[\\\"status\\\"] == \\\"pass\\\"\\n    assert rec[\\\"build_sha\\\"] == build_01[\\\"sha\\\"]\\n\\n\\ndef test_drive_prints_ready_to_merge_from_a_passed_verify(tmp_path):\\n    \\\"\\\"\\\"Acceptance row 3. From a passed verify with the forge green, one\\n    run prints ready-to-merge, exits 0, writes nothing, enqueues nothing\\n    -- and, per row 8, a further run repeats exactly the same thing.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n\\n    assert run_attavo(root, \\\"drive\\\", \\\"1\\\").returncode == 0  # builds\\n    assert run_attavo(root, \\\"drive\\\", \\\"1\\\").returncode == 0  # verifies\\n\\n    pre_head = head_of(root)\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n    assert \\\"ready to merge\\\" in run.stdout\\n    assert head_of(root) == pre_head\\n    assert record_files(root, \\\"verify\\\") and len(record_files(root, \\\"verify\\\")) == 1\\n\\n    # Acceptance row 8: idempotence -- run it again, same result, nothing\\n    # new written or pushed.\\n    run2 = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run2.returncode == 0\\n    assert \\\"ready to merge\\\" in run2.stdout\\n    assert head_of(root) == pre_head\\n    assert len(record_files(root, \\\"verify\\\")) == 1\\n    assert len(record_files(root, \\\"build\\\")) == 1\\n\\n\\ndef test_drive_until_ready_runs_build_then_verify_to_ready_in_one_call(tmp_path):\\n    \\\"\\\"\\\"Issue #100's own followups. --until-ready repeats step-and-wait in\\n    the same process: one call, from an approved item with the forge\\n    green, builds, verifies, and prints ready to merge -- both records\\n    written and pushed, without the caller invoking drive again after\\n    each passing step.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    bare = add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\", \\\"--until-ready\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n    assert \\\"ready to merge\\\" in run.stdout\\n\\n    assert len(record_files(root, \\\"build\\\")) == 1\\n    assert len(record_files(root, \\\"verify\\\")) == 1\\n    assert latest_record(root, \\\"build\\\")[\\\"status\\\"] == \\\"pass\\\"\\n    assert latest_record(root, \\\"verify\\\")[\\\"status\\\"] == \\\"pass\\\"\\n    assert remote_head(bare, branch) == head_of(root)\\n\\n    # Idempotence, same as the single-step form: a further --until-ready\\n    # call repeats exactly the same ready-to-merge result, writing nothing.\\n    run2 = run_attavo(root, \\\"drive\\\", \\\"1\\\", \\\"--until-ready\\\")\\n    assert run2.returncode == 0\\n    assert \\\"ready to merge\\\" in run2.stdout\\n    assert len(record_files(root, \\\"build\\\")) == 1\\n    assert len(record_files(root, \\\"verify\\\")) == 1\\n\\n\\ndef test_drive_without_the_flag_still_takes_one_step_at_a_time(tmp_path):\\n    \\\"\\\"\\\"Regression: --until-ready is additive. With no flag, an approved\\n    item with the forge green still needs two separate calls -- build,\\n    then verify -- exactly as before this issue.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run.returncode == 0\\n    assert record_files(root, \\\"build\\\") and not record_files(root, \\\"verify\\\")\\n\\n    run2 = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run2.returncode == 0\\n    assert record_files(root, \\\"verify\\\")\\n\\n\\ndef test_drive_until_ready_stops_on_a_halt(tmp_path):\\n    \\\"\\\"\\\"A step that stops on its own account -- here, a halted build --\\n    stops the --until-ready loop exactly where the single-step form\\n    would, printing the same thing; it does not retry the halted step.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    bare = add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\", \\\"--until-ready\\\",\\n                     env={\\\"ATTAVO_FIXTURE_QUESTION\\\": \\\"which overlay wins?\\\"})\\n    assert run.returncode == 3\\n    assert \\\"which overlay wins?\\\" in run.stdout\\n\\n    assert len(record_files(root, \\\"build\\\")) == 1\\n    assert latest_record(root, \\\"build\\\")[\\\"status\\\"] == \\\"halted\\\"\\n    assert record_files(root, \\\"verify\\\") == []\\n    assert remote_head(bare, branch) == head_of(root)\\n\\n\\ndef test_drive_until_ready_stops_when_the_forge_goes_red_after_a_build(tmp_path):\\n    \\\"\\\"\\\"A build that passes, then a forge that concludes red for verify's\\n    own gate, stops the loop there -- one record written (the pass), no\\n    verify record, no retry of the forge read.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, RED_FORGE)\\n    add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\", \\\"--until-ready\\\")\\n    assert run.returncode != 0\\n    assert \\\"ci\\\" in run.stdout and \\\"failure\\\" in run.stdout\\n\\n    assert len(record_files(root, \\\"build\\\")) == 1\\n    assert latest_record(root, \\\"build\\\")[\\\"status\\\"] == \\\"pass\\\"\\n    assert record_files(root, \\\"verify\\\") == []\\n\\n\\ndef test_drive_stops_when_the_forge_is_red(tmp_path):\\n    \\\"\\\"\\\"Acceptance row 4. A forge read where the one check has already\\n    concluded and failed is not polled at all -- there is nothing left to\\n    wait on, so drive stops on the first read, naming the check, with no\\n    sleep in between. Writes nothing -- no verify record at all, no new\\n    commit.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, RED_FORGE)\\n    add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n\\n    assert run_attavo(root, \\\"drive\\\", \\\"1\\\").returncode == 0  # builds\\n    pre_head = head_of(root)\\n\\n    started = time.monotonic()\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    elapsed = time.monotonic() - started\\n    assert run.returncode != 0\\n    assert \\\"ci\\\" in run.stdout and \\\"failure\\\" in run.stdout\\n    assert elapsed < 0.4, (\\n        f\\\"a concluded, red forge check should stop on the first read with no \\\"\\n        f\\\"poll interval slept -- took {elapsed:.2f}s\\\")\\n\\n    assert record_files(root, \\\"verify\\\") == []\\n    assert head_of(root) == pre_head\\n\\n    # Idempotence (row 8): running again in the same red state stops the\\n    # same way, still nothing written.\\n    run2 = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run2.returncode != 0\\n    assert record_files(root, \\\"verify\\\") == []\\n    assert head_of(root) == pre_head\\n\\n\\ndef test_drive_polls_the_bound_while_the_forge_is_still_running(tmp_path):\\n    \\\"\\\"\\\"Acceptance row 4, the unconcluded case: a check still carrying a\\n    status (in_progress) rather than a conclusion is not yet red -- drive\\n    keeps polling it for the full bound before giving up, unlike a\\n    concluded red check, which it does not poll at all. Writes nothing.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, UNCONCLUDED_FORGE)\\n    add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n\\n    assert run_attavo(root, \\\"drive\\\", \\\"1\\\").returncode == 0  # builds\\n\\n    started = time.monotonic()\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    elapsed = time.monotonic() - started\\n    assert run.returncode != 0\\n    assert \\\"ci\\\" in run.stdout and \\\"in_progress\\\" in run.stdout\\n    assert elapsed >= 0.4, (\\n        f\\\"a check still in_progress should be polled for the bound, not \\\"\\n        f\\\"stopped on the first read -- took only {elapsed:.2f}s\\\")\\n\\n    assert record_files(root, \\\"verify\\\") == []\\n\\n\\ndef test_drive_halts_on_a_question_and_resumes_at_build_after_a_ruling(tmp_path):\\n    \\\"\\\"\\\"Acceptance row 5. The fixture adapter halts with a question: drive\\n    stops naming the question and the record (and still pushes that\\n    halted record, same as any other record build writes). After a\\n    ruling is appended, a second run resumes at build and this time\\n    passes.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    bare = add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\",\\n                     env={\\\"ATTAVO_FIXTURE_QUESTION\\\": \\\"which overlay wins?\\\"})\\n    assert run.returncode == 3\\n    assert \\\"which overlay wins?\\\" in run.stdout\\n\\n    rec = latest_record(root, \\\"build\\\")\\n    assert rec[\\\"status\\\"] == \\\"halted\\\"\\n    assert rec[\\\"halted\\\"] == {\\\"question\\\": \\\"which overlay wins?\\\"}\\n    record_path = record_files(root, \\\"build\\\")[-1]\\n    assert record_path.name in run.stdout\\n\\n    # The halted record was still committed and pushed.\\n    assert remote_head(bare, branch) == head_of(root)\\n\\n    rulings = root / \\\"rulings.md\\\"\\n    rulings.write_text(rulings.read_text() + \\\"\\\\n- overlay: use the base tree\\\\n\\\"\\n                       if rulings.exists() else \\\"- overlay: use the base tree\\\\n\\\")\\n    commit_all(root, \\\"rule on the overlay question\\\")\\n    git(root, \\\"push\\\", \\\"origin\\\", f\\\"HEAD:{branch}\\\")\\n\\n    run2 = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run2.returncode == 0, run2.stdout + run2.stderr\\n\\n    assert len(record_files(root, \\\"build\\\")) == 2\\n    rec2 = latest_record(root, \\\"build\\\")\\n    assert rec2[\\\"status\\\"] == \\\"pass\\\"\\n    assert remote_head(bare, branch) == head_of(root)\\n\\n\\ndef configure_counsel(root: Path) -> None:\\n    \\\"\\\"\\\"[executor].counsel = \\\"fixture\\\" -- build_valid's own manifest\\n    declares [executor].build = \\\"fixture\\\" only; counsel needs its own\\n    adapter named (issue #100).\\\"\\\"\\\"\\n    toml = root / \\\"attavo.toml\\\"\\n    toml.write_text(toml.read_text().replace(\\n        '[executor]\\\\nbuild = \\\"fixture\\\"', '[executor]\\\\nbuild = \\\"fixture\\\"\\\\ncounsel = \\\"fixture\\\"'))\\n    commit_all(root, \\\"configure the counsel adapter\\\")\\n\\n\\ndef test_drive_counsels_a_stop_before_filing_it_and_commits_both_records_together(tmp_path):\\n    \\\"\\\"\\\"Issue #100, acceptance row 3. On a stop, drive calls counsel\\n    before file-stops, and commits the counsel record with the stage\\n    record in one commit.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    bare = add_bare_remote(root, tmp_path)\\n    configure_counsel(root)\\n    approve_item(root)\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n    filed = tmp_path / \\\"filed.jsonl\\\"\\n    configure_filing(root, filed)\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\",\\n                     env={\\\"ATTAVO_FIXTURE_QUESTION\\\": \\\"which overlay wins?\\\"})\\n    assert run.returncode == 3\\n\\n    assert record_files(root, \\\"counsel\\\")\\n    counsel_rec = latest_record(root, \\\"counsel\\\")\\n    assert counsel_rec[\\\"record_stage\\\"] == \\\"build\\\"\\n    assert counsel_rec[\\\"record\\\"] == \\\"build-01\\\"\\n    assert counsel_rec[\\\"verdict\\\"] == \\\"person\\\"\\n\\n    committed = set(last_commit_paths(root))\\n    assert committed == {\\n        \\\"records/1/build-01.json\\\", \\\"records/1/build-01.log\\\",\\n        \\\"records/1/counsel-01.json\\\", \\\"records/1/counsel-01.log\\\",\\n        \\\"records/1/build-01.filed\\\",\\n    }\\n    assert remote_head(bare, branch) == head_of(root)\\n\\n    filed_bodies = [json.loads(l) for l in filed.read_text().splitlines() if l.strip()]\\n    assert len(filed_bodies) == 1\\n    assert filed_bodies[0][\\\"counsel_verdict\\\"] == \\\"person\\\"\\n    assert filed_bodies[0][\\\"counsel_proposal\\\"][\\\"question\\\"]\\n\\n\\ndef test_drive_still_files_a_stop_with_no_counsel_adapter_configured(tmp_path):\\n    \\\"\\\"\\\"counsel refuses gracefully (no [executor].counsel or\\n    [executor].verify) -- drive still files and transports the stage\\n    record; nothing new for counsel to commit.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    bare = add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n    filed = tmp_path / \\\"filed.jsonl\\\"\\n    configure_filing(root, filed)\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\",\\n                     env={\\\"ATTAVO_FIXTURE_QUESTION\\\": \\\"which overlay wins?\\\"})\\n    assert run.returncode == 3\\n\\n    assert record_files(root, \\\"counsel\\\") == []\\n    committed = set(last_commit_paths(root))\\n    assert committed == {\\\"records/1/build-01.json\\\", \\\"records/1/build-01.log\\\",\\n                         \\\"records/1/build-01.filed\\\"}\\n    assert remote_head(bare, branch) == head_of(root)\\n\\n\\ndef configure_filing(root: Path, filed_path: Path) -> None:\\n    \\\"\\\"\\\"Appended under the [forge] table add_forge already opened -- a\\n    second [forge] header in the same file is a TOML redeclaration\\n    error. Prints a fake issue URL on stdout, numbered by filed_path's\\n    own line count so far -- the fact a real file_issue_command's stdout\\n    would carry, and what the .filed marker beside each stop record is\\n    meant to hold (issue #89).\\\"\\\"\\\"\\n    toml = root / \\\"attavo.toml\\\"\\n    command = (f\\\"n=$(wc -l < {filed_path} 2>/dev/null || echo 0); \\\"\\n              f\\\"cat >> {filed_path}; \\\"\\n              f\\\"echo https://github.com/tenant/repo/issues/$((n + 1))\\\")\\n    toml.write_text(toml.read_text() + f\\\"\\\\nfile_issue_command = '{command}'\\\\n\\\")\\n    commit_all(root, \\\"configure issue filing\\\")\\n\\n\\ndef test_drive_files_a_stop_it_reports_exactly_once(tmp_path):\\n    \\\"\\\"\\\"Issue #89, acceptance row 5. A stop drive reports -- here, the\\n    fixture adapter's halt -- calls file-stops once: one drive run files\\n    exactly one issue for the attempt it just wrote, not zero and not\\n    more than one.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n    filed = tmp_path / \\\"filed.jsonl\\\"\\n    configure_filing(root, filed)\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\",\\n                     env={\\\"ATTAVO_FIXTURE_QUESTION\\\": \\\"which overlay wins?\\\"})\\n    assert run.returncode == 3\\n\\n    filed_bodies = [json.loads(l) for l in filed.read_text().splitlines() if l.strip()]\\n    assert len(filed_bodies) == 1\\n    assert filed_bodies[0][\\\"record\\\"] == \\\"records/1/build-01.json\\\"\\n\\n    # A second drive run halts again -- a new attempt, build-02 -- and\\n    # files exactly one more issue for that new record; file-stops' own\\n    # .filed marker means build-01's issue is never filed twice.\\n    run2 = run_attavo(root, \\\"drive\\\", \\\"1\\\",\\n                      env={\\\"ATTAVO_FIXTURE_QUESTION\\\": \\\"which overlay wins?\\\"})\\n    assert run2.returncode == 3\\n    assert len(record_files(root, \\\"build\\\")) == 2\\n\\n    filed_bodies_after = [json.loads(l) for l in filed.read_text().splitlines() if l.strip()]\\n    assert len(filed_bodies_after) == 2\\n    assert filed_bodies_after[0] == filed_bodies[0]\\n    assert filed_bodies_after[1][\\\"record\\\"] == \\\"records/1/build-02.json\\\"\\n\\n\\ndef test_drive_marker_holds_the_filing_commands_stdout_and_is_committed_with_the_record(tmp_path):\\n    \\\"\\\"\\\"A stop's own .filed marker is written before the record is\\n    transported, so it carries the filing command's stdout (the issue it\\n    opened) and rides in the very same commit as the record and its log\\n    -- one commit, one push, as before this fix. Red before it: the\\n    marker was written empty, after commit_record and push_record_commit\\n    had already run, so it was never part of any commit at all.\\n    \\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    bare = add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n    filed = tmp_path / \\\"filed.jsonl\\\"\\n    configure_filing(root, filed)\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\",\\n                     env={\\\"ATTAVO_FIXTURE_QUESTION\\\": \\\"which overlay wins?\\\"})\\n    assert run.returncode == 3\\n\\n    marker_path = records_dir(root) / \\\"build-01.filed\\\"\\n    assert marker_path.is_file()\\n    assert marker_path.read_text().strip() == \\\"https://github.com/tenant/repo/issues/1\\\"\\n\\n    committed = set(last_commit_paths(root))\\n    assert committed == {\\\"records/1/build-01.json\\\", \\\"records/1/build-01.log\\\",\\n                         \\\"records/1/build-01.filed\\\"}\\n    assert remote_head(bare) == head_of(root)\\n\\n\\ndef test_drive_a_second_run_in_the_same_state_files_nothing(tmp_path):\\n    \\\"\\\"\\\"Issue #89. The marker committed and pushed above is the fact a\\n    second worktree or a fresh clone reads too -- a second drive run\\n    against the same records, from a fresh clone of the remote drive\\n    already pushed to, files nothing for the stop that clone already\\n    carries a marker for. Red before this fix: the marker never reached\\n    the remote at all, so every clone refiled every stop it found.\\n    \\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    bare = add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n    filed = tmp_path / \\\"filed.jsonl\\\"\\n    configure_filing(root, filed)\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\",\\n                     env={\\\"ATTAVO_FIXTURE_QUESTION\\\": \\\"which overlay wins?\\\"})\\n    assert run.returncode == 3\\n    filed_after_first = filed.read_text()\\n    assert filed_after_first.strip() != \\\"\\\"\\n\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n    clone = tmp_path / \\\"fresh-clone\\\"\\n    subprocess.run([\\\"git\\\", \\\"clone\\\", \\\"--quiet\\\", \\\"--branch\\\", branch, str(bare), str(clone)],\\n                   check=True)\\n\\n    run2 = run_attavo(clone, \\\"file-stops\\\", \\\"1\\\")\\n    assert run2.returncode == 0\\n    assert \\\"no stops to file\\\" in run2.stdout\\n    assert filed.read_text() == filed_after_first  # nothing new was filed\\n\\n\\ndef test_drive_retries_a_rejected_push_with_a_merge_never_a_rebase(tmp_path):\\n    \\\"\\\"\\\"Acceptance row 7. A rejected push with a divergent remote is\\n    retried after `git pull --no-rebase --no-edit`, never a rebase; the\\n    build record's own sha is unchanged (still reachable, still what the\\n    record names), and the retry lands a merge commit, not a rewritten\\n    one.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    bare = add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n\\n    # Diverge the bare remote: another clone pushes an unrelated commit to\\n    # the same branch before drive's own push happens.\\n    other = tmp_path / \\\"other-clone\\\"\\n    subprocess.run([\\\"git\\\", \\\"clone\\\", \\\"--quiet\\\", str(bare), str(other)], check=True)\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(other), \\\"checkout\\\", \\\"-q\\\", branch], check=True)\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(other), \\\"config\\\", \\\"user.email\\\", \\\"other@example.com\\\"],\\n                   check=True)\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(other), \\\"config\\\", \\\"user.name\\\", \\\"Other\\\"], check=True)\\n    (other / \\\"concurrent.txt\\\").write_text(\\\"from elsewhere\\\\n\\\")\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(other), \\\"add\\\", \\\"-A\\\"], check=True)\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(other), \\\"commit\\\", \\\"-q\\\", \\\"-m\\\", \\\"a concurrent commit\\\"],\\n                   check=True)\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(other), \\\"push\\\", \\\"origin\\\", f\\\"HEAD:{branch}\\\"], check=True)\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n\\n    rec = latest_record(root, \\\"build\\\")\\n    assert rec[\\\"status\\\"] == \\\"pass\\\"\\n    build_sha = rec[\\\"sha\\\"]\\n\\n    # The build's own commit sha is still reachable -- a merge, not a\\n    # rebase, which would have rewritten it under a new sha.\\n    assert build_sha in git(root, \\\"rev-list\\\", \\\"HEAD\\\").split()\\n\\n    # The retry landed a merge commit somewhere in history, not\\n    # necessarily at HEAD -- the invocation marker's own push is the one\\n    # that met the divergent remote and retried; the build record's own\\n    # push, once the branches were already merged, needed no retry of\\n    # its own.\\n    assert git(root, \\\"rev-list\\\", \\\"--merges\\\", \\\"HEAD\\\").split(), \\\\\\n        \\\"the retry should have landed a merge commit\\\"\\n\\n    assert remote_head(bare, branch) == head_of(root)\\n    # the concurrent commit from the other clone is present too\\n    assert \\\"concurrent.txt\\\" in git(root, \\\"ls-tree\\\", \\\"-r\\\", \\\"--name-only\\\", \\\"HEAD\\\")\\n\\n\\ndef add_drive_stall_bound(root: Path, seconds: int) -> None:\\n    toml = root / \\\"attavo.toml\\\"\\n    toml.write_text(toml.read_text() + f\\\"\\\\n[drive]\\\\nstall_after_s = {seconds}\\\\n\\\")\\n    commit_all(root, \\\"configure the drive stall bound\\\")\\n\\n\\ndef test_drive_writes_and_pushes_an_invocation_marker_before_running_the_stage(tmp_path):\\n    \\\"\\\"\\\"Issue #151. Before running build, drive writes a build-01.started\\n    marker and commits and pushes it by itself -- the fact that this\\n    invocation began is on the branch before the adapter ever runs, so a\\n    process that dies mid-build still leaves it behind.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    bare = add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n\\n    marker_path = records_dir(root) / \\\"build-01.started\\\"\\n    assert marker_path.is_file()\\n    info = json.loads(marker_path.read_text())\\n    assert info[\\\"pid\\\"] > 0 and info[\\\"host\\\"] and info[\\\"sha\\\"]\\n\\n    # The marker's own commit precedes the record's own commit; both\\n    # reached the remote.\\n    marker_commit = git(root, \\\"log\\\", \\\"-1\\\", \\\"--format=%H\\\",\\n                        \\\"--\\\", \\\"records/1/build-01.started\\\").strip()\\n    record_commit = git(root, \\\"log\\\", \\\"-1\\\", \\\"--format=%H\\\",\\n                        \\\"--\\\", \\\"records/1/build-01.json\\\").strip()\\n    assert marker_commit != record_commit\\n    is_ancestor = subprocess.run(\\n        [\\\"git\\\", \\\"-C\\\", str(root), \\\"merge-base\\\", \\\"--is-ancestor\\\", marker_commit, record_commit],\\n        check=False)\\n    assert is_ancestor.returncode == 0, \\\"the marker's commit should precede the record's\\\"\\n    assert remote_head(bare, branch) == head_of(root)\\n\\n\\ndef test_drive_recover_writes_a_died_record_for_a_dead_marker(tmp_path):\\n    \\\"\\\"\\\"Issue #151, acceptance row 2. A marker naming a dead pid on this\\n    host, with no record beside it, is recovered as a failed record, stop\\n    class died, provenance product, committed by the driver identity with\\n    a clean tree -- the fixture #148 left behind by hand, done here by\\n    the product instead.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_drive_stall_bound(root, 60)\\n    bare = add_bare_remote(root, tmp_path)\\n\\n    dead = subprocess.Popen([sys.executable, \\\"-c\\\", \\\"pass\\\"])\\n    dead.wait()\\n    marker = records_dir(root) / \\\"build-01.started\\\"\\n    marker.parent.mkdir(parents=True, exist_ok=True)\\n    marker.write_text(json.dumps({\\\"at\\\": \\\"2026-09-17T13:16:08Z\\\", \\\"host\\\": socket.gethostname(),\\n                                  \\\"pid\\\": dead.pid, \\\"sha\\\": head_of(root),\\n                                  \\\"product_version\\\": \\\"fixture\\\"}))\\n    commit_all(root, \\\"invocation marker for item 1\\\")\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\", \\\"--recover\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n\\n    rec = latest_record(root, \\\"build\\\")\\n    assert rec[\\\"status\\\"] == \\\"failed\\\"\\n    assert rec[\\\"stop\\\"][\\\"class\\\"] == \\\"died\\\"\\n    assert rec[\\\"stop\\\"][\\\"provenance\\\"] == \\\"product\\\"\\n    assert \\\"wrote no build-01.json\\\" in rec[\\\"stop\\\"][\\\"detail\\\"]\\n\\n    assert (records_dir(root) / \\\"build-01.log\\\").is_file()\\n    assert git(root, \\\"log\\\", \\\"-1\\\", \\\"--format=%an\\\").strip() == \\\"attavo driver\\\"\\n    assert git(root, \\\"status\\\", \\\"--porcelain\\\").strip() == \\\"\\\"\\n    assert remote_head(bare) == head_of(root)\\n\\n\\ndef test_drive_recover_leaves_a_live_invocation_alone(tmp_path):\\n    \\\"\\\"\\\"A marker naming this test process's own pid -- alive on this host\\n    and well inside the stall bound -- is running, not died: recover\\n    writes nothing.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_drive_stall_bound(root, 3600)\\n    approve_item(root)\\n\\n    marker = records_dir(root) / \\\"build-01.started\\\"\\n    marker.parent.mkdir(parents=True, exist_ok=True)\\n    marker.write_text(json.dumps({\\\"at\\\": \\\"2026-09-17T13:16:08Z\\\", \\\"host\\\": socket.gethostname(),\\n                                  \\\"pid\\\": os.getpid(), \\\"sha\\\": head_of(root),\\n                                  \\\"product_version\\\": \\\"fixture\\\"}))\\n    commit_all(root, \\\"invocation marker for a live pid\\\")\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\", \\\"--recover\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n    assert \\\"nothing to recover\\\" in run.stdout\\n    assert record_files(root, \\\"build\\\") == []\\n\\n\\ndef test_drive_forge_poll_defaults_are_a_real_forges_clock():\\n    \\\"\\\"\\\"The bound and interval every other test overrides with\\n    FAST_POLL_ENV default, unset, to at least five minutes and ten\\n    seconds -- tenant zero's own checks conclude about five minutes after\\n    a push, and a bound shorter than that would make every drive run\\n    after a record push stop on 'forge checks not green', with a person\\n    running it again after CI: exactly the transport act this lane\\n    retires. Row 4 (a forge that never goes green) is unchanged in\\n    meaning by this -- it still stops, just after waiting out a real\\n    forge's own clock instead of a test's fake one.\\n    \\\"\\\"\\\"\\n    module = attavo_module()\\n    assert module.DRIVE_FORGE_POLL_BOUND_DEFAULT_S >= 300\\n    assert module.DRIVE_FORGE_POLL_INTERVAL_DEFAULT_S >= 10\\n\",\"structuredPatch\":[{\"oldStart\":828,\"oldLines\":7,\"newStart\":828,\"newLines\":6,\"lines\":[\"     writes nothing.\\\"\\\"\\\"\",\"     root = make_tenant(tmp_path, \\\"build_valid\\\")\",\"     add_drive_stall_bound(root, 3600)\",\"-    approve_item(root)\",\" \",\"     marker = records_dir(root) / \\\"build-01.started\\\"\",\"     marker.parent.mkdir(parents=True, exist_ok=True)\"]}],\"userModified\":false,\"replaceAll\":false}}\nattest/records/151/build-03.log:756:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01WpJWqBsAGBhp7D9jBQyZtp\",\"type\":\"tool_result\",\"content\":\"The file /Users/davidbean/Projects/attavo-worktree-151/tests/test_drive.py has been updated successfully. (file state is current in your context — no need to Read it back)\"}]},\"parent_tool_use_id\":null,\"session_id\":\"f081a203-e2ee-47b3-8bf8-5fc3aaeb804d\",\"uuid\":\"9331eb95-40c0-475d-bca7-6b4014551a15\",\"timestamp\":\"2026-09-17T20:01:25.141Z\",\"tool_use_result\":{\"filePath\":\"/Users/davidbean/Projects/attavo-worktree-151/tests/test_drive.py\",\"oldString\":\"def test_drive_recover_leaves_a_live_invocation_alone(tmp_path):\\n    \\\"\\\"\\\"A marker naming this test process's own pid -- alive on this host\\n    and well inside the stall bound -- is running, not died: recover\\n    writes nothing.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_drive_stall_bound(root, 3600)\\n\\n    marker = records_dir(root) / \\\"build-01.started\\\"\\n    marker.parent.mkdir(parents=True, exist_ok=True)\\n    marker.write_text(json.dumps({\\\"at\\\": \\\"2026-09-17T13:16:08Z\\\", \\\"host\\\": socket.gethostname(),\\n                                  \\\"pid\\\": os.getpid(), \\\"sha\\\": head_of(root),\\n                                  \\\"product_version\\\": \\\"fixture\\\"}))\\n    commit_all(root, \\\"invocation marker for a live pid\\\")\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\", \\\"--recover\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n    assert \\\"nothing to recover\\\" in run.stdout\\n    assert record_files(root, \\\"build\\\") == []\",\"newString\":\"def test_drive_recover_leaves_a_live_invocation_alone(tmp_path):\\n    \\\"\\\"\\\"A marker naming a live, unrelated pid on this host, started just\\n    now -- well inside the stall bound -- is running, not died: recover\\n    writes nothing. A real subprocess, never this test's own pid: were it\\n    ever judged hung, recover would SIGTERM the pid the marker names.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_drive_stall_bound(root, 3600)\\n\\n    alive = subprocess.Popen([sys.executable, \\\"-c\\\", \\\"import time; time.sleep(30)\\\"])\\n    try:\\n        marker = records_dir(root) / \\\"build-01.started\\\"\\n        marker.parent.mkdir(parents=True, exist_ok=True)\\n        marker.write_text(json.dumps(\\n            {\\\"at\\\": datetime.now(timezone.utc).strftime(\\\"%Y-%m-%dT%H:%M:%SZ\\\"),\\n             \\\"host\\\": socket.gethostname(), \\\"pid\\\": alive.pid, \\\"sha\\\": head_of(root),\\n             \\\"product_version\\\": \\\"fixture\\\"}))\\n        commit_all(root, \\\"invocation marker for a live pid\\\")\\n\\n        run = run_attavo(root, \\\"drive\\\", \\\"1\\\", \\\"--recover\\\")\\n        assert run.returncode == 0, run.stdout + run.stderr\\n        assert \\\"nothing to recover\\\" in run.stdout\\n        assert record_files(root, \\\"build\\\") == []\\n    finally:\\n        alive.terminate()\\n        alive.wait()\",\"originalFile\":\"\\\"\\\"\\\"attavo drive: the mechanical transitions between approval and\\nready-to-merge (issue #84) -- one step per invocation, and only that step,\\nuntil a state that belongs to a person. Every test uses the fixture\\nadapter and a fake `[forge].checks_command`; every record commit is\\n`git commit --only` and pushed to a real (bare) fixture remote.\\n\\nRegression tests, written and run red first: on `main` at 85f6f3b there\\nwas no `drive` subcommand, so every one of these failed with \\\"unknown\\nsubcommand\\\".\\n\\nRun: python3 -m pytest tests -q\\n\\\"\\\"\\\"\\nimport importlib.machinery\\nimport importlib.util\\nimport json\\nimport os\\nimport socket\\nimport subprocess\\nimport sys\\nimport time\\nfrom pathlib import Path\\n\\nfrom helpers import commit_all, git, make_tenant\\n\\nROOT = Path(__file__).resolve().parent.parent\\nATTAVO = ROOT / \\\"bin\\\" / \\\"attavo\\\"\\n\\nGREEN_FORGE = \\\"printf 'ci success\\\\\\\\n'\\\"\\n# A concluded conclusion -- checked and failing, not something still\\n# running. Distinct from UNCONCLUDED_FORGE below (issue #84): drive polls\\n# the one still running for the bound, but stops on the first read of a\\n# check that has already concluded, whether or not it passed.\\nRED_FORGE = \\\"printf 'ci failure\\\\\\\\n'\\\"\\nUNCONCLUDED_FORGE = \\\"printf 'ci in_progress\\\\\\\\n'\\\"\\n\\n# The real defaults (ATTAVO_DRIVE_POLL_BOUND_S=600, _INTERVAL_S=20) are a\\n# real forge's clock, not a test's -- tenant zero's own checks conclude\\n# about five minutes after a push. Every `attavo drive` call here runs\\n# against this much shorter clock instead, read at call time from the\\n# same environment variables; test_drive_forge_poll_defaults_are_a_real_\\n# forges_clock is the one test that leaves them unset, to assert the\\n# defaults themselves. The interval is kept well above typical subprocess\\n# startup overhead so a zero-sleep stop and a polled one are easy to tell\\n# apart by wall clock alone.\\nFAST_POLL_ENV = {\\\"ATTAVO_DRIVE_POLL_BOUND_S\\\": \\\"0.9\\\", \\\"ATTAVO_DRIVE_POLL_INTERVAL_S\\\": \\\"0.5\\\"}\\n\\n\\ndef run_attavo(root: Path, *args: str, env: dict | None = None) -> subprocess.CompletedProcess:\\n    full_env = dict(os.environ)\\n    full_env.update(FAST_POLL_ENV)\\n    if env:\\n        full_env.update(env)\\n    return subprocess.run([sys.executable, str(ATTAVO), *args], cwd=str(root),\\n                          capture_output=True, text=True, check=False, env=full_env)\\n\\n\\ndef attavo_module():\\n    \\\"\\\"\\\"bin/attavo imported in-process, for the default-constant assertion\\n    below that a CLI invocation cannot provoke without actually waiting\\n    out the real clock.\\\"\\\"\\\"\\n    loader = importlib.machinery.SourceFileLoader(\\\"attavo_drive_under_test\\\", str(ATTAVO))\\n    spec = importlib.util.spec_from_loader(loader.name, loader)\\n    module = importlib.util.module_from_spec(spec)\\n    loader.exec_module(module)\\n    return module\\n\\n\\ndef add_forge(root: Path, checks_command: str) -> None:\\n    toml = root / \\\"attavo.toml\\\"\\n    toml.write_text(toml.read_text() + f'\\\\n[forge]\\\\nchecks_command = \\\"{checks_command}\\\"\\\\n')\\n    commit_all(root, \\\"configure the forge read\\\")\\n\\n\\ndef approve_item(root: Path, item: str = \\\"1\\\") -> None:\\n    assert run_attavo(root, \\\"spec-gate\\\", item).returncode == 0\\n    assert run_attavo(root, \\\"approve\\\", item, \\\"--by\\\", \\\"alice\\\").returncode == 0\\n\\n\\ndef add_bare_remote(root: Path, tmp_path: Path) -> Path:\\n    \\\"\\\"\\\"A real (bare) remote named origin, seeded with the tenant's current\\n    state -- drive's own push target, distinct from the fake\\n    refs/remotes/origin/* helpers.init_repo sets up purely for verify's\\n    diff base.\\\"\\\"\\\"\\n    bare = tmp_path / \\\"origin.git\\\"\\n    subprocess.run([\\\"git\\\", \\\"init\\\", \\\"--quiet\\\", \\\"--bare\\\", \\\"-b\\\", \\\"main\\\", str(bare)], check=True)\\n    git(root, \\\"remote\\\", \\\"add\\\", \\\"origin\\\", str(bare))\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n    git(root, \\\"push\\\", \\\"origin\\\", f\\\"HEAD:{branch}\\\")\\n    return bare\\n\\n\\ndef records_dir(root: Path, item: str = \\\"1\\\") -> Path:\\n    return root / \\\"records\\\" / item\\n\\n\\ndef record_files(root: Path, stage: str, item: str = \\\"1\\\") -> list[Path]:\\n    return sorted(records_dir(root, item).glob(f\\\"{stage}-*.json\\\"))\\n\\n\\ndef latest_record(root: Path, stage: str, item: str = \\\"1\\\") -> dict:\\n    files = record_files(root, stage, item)\\n    assert files, f\\\"no {stage} record for item {item}\\\"\\n    return json.loads(files[-1].read_text())\\n\\n\\ndef head_of(root: Path) -> str:\\n    return git(root, \\\"rev-parse\\\", \\\"HEAD\\\").strip()\\n\\n\\ndef last_commit_paths(root: Path) -> list[str]:\\n    return git(root, \\\"diff\\\", \\\"--name-only\\\", \\\"HEAD^\\\", \\\"HEAD\\\").splitlines()\\n\\n\\ndef remote_head(bare: Path, branch: str = \\\"main\\\") -> str:\\n    return subprocess.run([\\\"git\\\", \\\"-C\\\", str(bare), \\\"rev-parse\\\", branch],\\n                          capture_output=True, text=True, check=True).stdout.strip()\\n\\n\\ndef test_drive_refuses_without_a_valid_approval(tmp_path):\\n    \\\"\\\"\\\"Acceptance row 6. No approval at all: refused by name, nothing run\\n    -- no spec-gate, no build, no records of any kind written.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    add_bare_remote(root, tmp_path)\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run.returncode != 0\\n    assert \\\"approval\\\" in run.stdout\\n    assert \\\"absent\\\" in run.stdout\\n\\n    assert not records_dir(root).exists() or list(records_dir(root).glob(\\\"*.json\\\")) == []\\n\\n\\ndef test_drive_refuses_with_an_expired_approval(tmp_path):\\n    \\\"\\\"\\\"Acceptance row 6, the other half: an approval bound to a spec sha\\n    that has since moved is expired, not absent -- still refused by name,\\n    nothing run.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n\\n    (root / \\\"specs\\\" / \\\"1\\\" / \\\"spec.md\\\").write_text(\\n        (root / \\\"specs\\\" / \\\"1\\\" / \\\"spec.md\\\").read_text() + \\\"\\\\n\\\")\\n    commit_all(root, \\\"touch the spec after approval\\\")\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run.returncode != 0\\n    assert \\\"expired\\\" in run.stdout\\n    assert record_files(root, \\\"build\\\") == []\\n\\n\\ndef test_drive_builds_from_an_approved_spec_with_no_build(tmp_path):\\n    \\\"\\\"\\\"Acceptance row 1. One drive run produces a passing build record,\\n    commits only the record and its log (`git commit --only`), and pushes\\n    the branch; the fixture remote carries the record commit.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    bare = add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n\\n    rec = latest_record(root, \\\"build\\\")\\n    assert rec[\\\"status\\\"] == \\\"pass\\\"\\n\\n    record_path = record_files(root, \\\"build\\\")[-1]\\n    log_path = record_path.with_suffix(\\\".log\\\")\\n    assert log_path.exists()\\n\\n    touched = set(last_commit_paths(root))\\n    assert touched == {\\n        str(record_path.relative_to(root)),\\n        str(log_path.relative_to(root)),\\n    }\\n\\n    assert remote_head(bare, branch) == head_of(root)\\n\\n\\ndef test_drive_leaves_the_events_file_out_of_the_record_commit(tmp_path):\\n    \\\"\\\"\\\"Issue #26, acceptance row 2, strengthened by issue #140: attavo\\n    build always writes a stage's events file now (test_build.py's own\\n    row-1 tests), under the checkout's own git directory rather than\\n    the working tree -- so it is not merely excluded from the commit's\\n    file list, it is not even a path git tracks anything under. The\\n    commit's file list still names only the record and its log.\\n    \\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n\\n    record_path = record_files(root, \\\"build\\\")[-1]\\n    git_dir = git(root, \\\"rev-parse\\\", \\\"--absolute-git-dir\\\").strip()\\n    events_path = Path(git_dir) / \\\"attavo\\\" / \\\"build-01.events.jsonl\\\"\\n    assert events_path.is_file()\\n\\n    touched = set(last_commit_paths(root))\\n    assert touched == {\\n        str(record_path.relative_to(root)),\\n        str(record_path.with_suffix(\\\".log\\\").relative_to(root)),\\n    }\\n\\n\\ndef test_drive_commits_the_record_as_the_driver_not_the_tenants_own_identity(tmp_path):\\n    \\\"\\\"\\\"The driver's identity (driver_identity, beside executor_identity):\\n    set by the product, never the tenant's git config, so a driven item's\\n    record commits are never indistinguishable from an operator's own.\\n    The fixture tenant's user.name is set to another value here, so a\\n    commit carrying it would prove commit_record fell back to the\\n    tenant's git config instead.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    git(root, \\\"config\\\", \\\"user.name\\\", \\\"Some Operator\\\")\\n    git(root, \\\"config\\\", \\\"user.email\\\", \\\"operator@example.com\\\")\\n    add_forge(root, GREEN_FORGE)\\n    add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n\\n    author_name = git(root, \\\"log\\\", \\\"-1\\\", \\\"--format=%an\\\").strip()\\n    author_email = git(root, \\\"log\\\", \\\"-1\\\", \\\"--format=%ae\\\").strip()\\n    committer_name = git(root, \\\"log\\\", \\\"-1\\\", \\\"--format=%cn\\\").strip()\\n    committer_email = git(root, \\\"log\\\", \\\"-1\\\", \\\"--format=%ce\\\").strip()\\n\\n    assert author_name == \\\"attavo driver\\\"\\n    assert author_email == \\\"driver@attavo.invalid\\\"\\n    assert committer_name == \\\"attavo driver\\\"\\n    assert committer_email == \\\"driver@attavo.invalid\\\"\\n\\n\\ndef test_drive_verifies_from_a_passed_build_with_the_forge_green(tmp_path):\\n    \\\"\\\"\\\"Acceptance row 2. From a passed build with the fake forge green,\\n    one run produces a verify record, commits only the record and its log,\\n    and pushes.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    bare = add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n\\n    assert run_attavo(root, \\\"drive\\\", \\\"1\\\").returncode == 0  # builds\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n\\n    assert record_files(root, \\\"build\\\") and record_files(root, \\\"verify\\\")\\n    rec = latest_record(root, \\\"verify\\\")\\n    assert rec[\\\"status\\\"] == \\\"pass\\\"\\n\\n    record_path = record_files(root, \\\"verify\\\")[-1]\\n    log_path = record_path.with_suffix(\\\".log\\\")\\n    assert log_path.exists()\\n\\n    touched = set(last_commit_paths(root))\\n    assert touched == {\\n        str(record_path.relative_to(root)),\\n        str(log_path.relative_to(root)),\\n    }\\n\\n    assert remote_head(bare, branch) == head_of(root)\\n\\n\\ndef test_drive_verifies_again_when_the_latest_verify_is_superseded_by_a_later_build(tmp_path):\\n    \\\"\\\"\\\"Acceptance row 4, issue #109. A verify record can only name a build\\n    that existed when it was written, so a later build makes the latest\\n    verify superseded, never a mismatch -- drive derives the next stage\\n    as verify, not build, and never refuses.\\n\\n    Regression: on main before this lane, drive_state's own inline\\n    staleness check already treats this as 'verify', so this test does\\n    not fail against current code -- it is here to lock the behavior\\n    check_attest_chain's fix must not disturb (the acceptance table's\\n    'never refuses' row).\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n\\n    assert run_attavo(root, \\\"drive\\\", \\\"1\\\").returncode == 0  # builds\\n    assert run_attavo(root, \\\"drive\\\", \\\"1\\\").returncode == 0  # verifies\\n\\n    # A second build record, minted by hand -- a real re-run of the\\n    # fixture adapter is not idempotent against its own tree -- naming a\\n    # sha the existing verify-01 does not: verify-01 is now superseded.\\n    build_01 = json.loads(record_files(root, \\\"build\\\")[-1].read_text())\\n    build_01[\\\"sha\\\"] = \\\"f\\\" * 40\\n    (records_dir(root) / \\\"build-02.json\\\").write_text(json.dumps(build_01))\\n    commit_all(root, \\\"attavo: second build record for #1, minted by hand\\\")\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n    assert len(record_files(root, \\\"build\\\")) == 2\\n    assert len(record_files(root, \\\"verify\\\")) == 2\\n    rec = latest_record(root, \\\"verify\\\")\\n    assert rec[\\\"status\\\"] == \\\"pass\\\"\\n    assert rec[\\\"build_sha\\\"] == build_01[\\\"sha\\\"]\\n\\n\\ndef test_drive_prints_ready_to_merge_from_a_passed_verify(tmp_path):\\n    \\\"\\\"\\\"Acceptance row 3. From a passed verify with the forge green, one\\n    run prints ready-to-merge, exits 0, writes nothing, enqueues nothing\\n    -- and, per row 8, a further run repeats exactly the same thing.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n\\n    assert run_attavo(root, \\\"drive\\\", \\\"1\\\").returncode == 0  # builds\\n    assert run_attavo(root, \\\"drive\\\", \\\"1\\\").returncode == 0  # verifies\\n\\n    pre_head = head_of(root)\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n    assert \\\"ready to merge\\\" in run.stdout\\n    assert head_of(root) == pre_head\\n    assert record_files(root, \\\"verify\\\") and len(record_files(root, \\\"verify\\\")) == 1\\n\\n    # Acceptance row 8: idempotence -- run it again, same result, nothing\\n    # new written or pushed.\\n    run2 = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run2.returncode == 0\\n    assert \\\"ready to merge\\\" in run2.stdout\\n    assert head_of(root) == pre_head\\n    assert len(record_files(root, \\\"verify\\\")) == 1\\n    assert len(record_files(root, \\\"build\\\")) == 1\\n\\n\\ndef test_drive_until_ready_runs_build_then_verify_to_ready_in_one_call(tmp_path):\\n    \\\"\\\"\\\"Issue #100's own followups. --until-ready repeats step-and-wait in\\n    the same process: one call, from an approved item with the forge\\n    green, builds, verifies, and prints ready to merge -- both records\\n    written and pushed, without the caller invoking drive again after\\n    each passing step.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    bare = add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\", \\\"--until-ready\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n    assert \\\"ready to merge\\\" in run.stdout\\n\\n    assert len(record_files(root, \\\"build\\\")) == 1\\n    assert len(record_files(root, \\\"verify\\\")) == 1\\n    assert latest_record(root, \\\"build\\\")[\\\"status\\\"] == \\\"pass\\\"\\n    assert latest_record(root, \\\"verify\\\")[\\\"status\\\"] == \\\"pass\\\"\\n    assert remote_head(bare, branch) == head_of(root)\\n\\n    # Idempotence, same as the single-step form: a further --until-ready\\n    # call repeats exactly the same ready-to-merge result, writing nothing.\\n    run2 = run_attavo(root, \\\"drive\\\", \\\"1\\\", \\\"--until-ready\\\")\\n    assert run2.returncode == 0\\n    assert \\\"ready to merge\\\" in run2.stdout\\n    assert len(record_files(root, \\\"build\\\")) == 1\\n    assert len(record_files(root, \\\"verify\\\")) == 1\\n\\n\\ndef test_drive_without_the_flag_still_takes_one_step_at_a_time(tmp_path):\\n    \\\"\\\"\\\"Regression: --until-ready is additive. With no flag, an approved\\n    item with the forge green still needs two separate calls -- build,\\n    then verify -- exactly as before this issue.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run.returncode == 0\\n    assert record_files(root, \\\"build\\\") and not record_files(root, \\\"verify\\\")\\n\\n    run2 = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run2.returncode == 0\\n    assert record_files(root, \\\"verify\\\")\\n\\n\\ndef test_drive_until_ready_stops_on_a_halt(tmp_path):\\n    \\\"\\\"\\\"A step that stops on its own account -- here, a halted build --\\n    stops the --until-ready loop exactly where the single-step form\\n    would, printing the same thing; it does not retry the halted step.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    bare = add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\", \\\"--until-ready\\\",\\n                     env={\\\"ATTAVO_FIXTURE_QUESTION\\\": \\\"which overlay wins?\\\"})\\n    assert run.returncode == 3\\n    assert \\\"which overlay wins?\\\" in run.stdout\\n\\n    assert len(record_files(root, \\\"build\\\")) == 1\\n    assert latest_record(root, \\\"build\\\")[\\\"status\\\"] == \\\"halted\\\"\\n    assert record_files(root, \\\"verify\\\") == []\\n    assert remote_head(bare, branch) == head_of(root)\\n\\n\\ndef test_drive_until_ready_stops_when_the_forge_goes_red_after_a_build(tmp_path):\\n    \\\"\\\"\\\"A build that passes, then a forge that concludes red for verify's\\n    own gate, stops the loop there -- one record written (the pass), no\\n    verify record, no retry of the forge read.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, RED_FORGE)\\n    add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\", \\\"--until-ready\\\")\\n    assert run.returncode != 0\\n    assert \\\"ci\\\" in run.stdout and \\\"failure\\\" in run.stdout\\n\\n    assert len(record_files(root, \\\"build\\\")) == 1\\n    assert latest_record(root, \\\"build\\\")[\\\"status\\\"] == \\\"pass\\\"\\n    assert record_files(root, \\\"verify\\\") == []\\n\\n\\ndef test_drive_stops_when_the_forge_is_red(tmp_path):\\n    \\\"\\\"\\\"Acceptance row 4. A forge read where the one check has already\\n    concluded and failed is not polled at all -- there is nothing left to\\n    wait on, so drive stops on the first read, naming the check, with no\\n    sleep in between. Writes nothing -- no verify record at all, no new\\n    commit.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, RED_FORGE)\\n    add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n\\n    assert run_attavo(root, \\\"drive\\\", \\\"1\\\").returncode == 0  # builds\\n    pre_head = head_of(root)\\n\\n    started = time.monotonic()\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    elapsed = time.monotonic() - started\\n    assert run.returncode != 0\\n    assert \\\"ci\\\" in run.stdout and \\\"failure\\\" in run.stdout\\n    assert elapsed < 0.4, (\\n        f\\\"a concluded, red forge check should stop on the first read with no \\\"\\n        f\\\"poll interval slept -- took {elapsed:.2f}s\\\")\\n\\n    assert record_files(root, \\\"verify\\\") == []\\n    assert head_of(root) == pre_head\\n\\n    # Idempotence (row 8): running again in the same red state stops the\\n    # same way, still nothing written.\\n    run2 = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run2.returncode != 0\\n    assert record_files(root, \\\"verify\\\") == []\\n    assert head_of(root) == pre_head\\n\\n\\ndef test_drive_polls_the_bound_while_the_forge_is_still_running(tmp_path):\\n    \\\"\\\"\\\"Acceptance row 4, the unconcluded case: a check still carrying a\\n    status (in_progress) rather than a conclusion is not yet red -- drive\\n    keeps polling it for the full bound before giving up, unlike a\\n    concluded red check, which it does not poll at all. Writes nothing.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, UNCONCLUDED_FORGE)\\n    add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n\\n    assert run_attavo(root, \\\"drive\\\", \\\"1\\\").returncode == 0  # builds\\n\\n    started = time.monotonic()\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    elapsed = time.monotonic() - started\\n    assert run.returncode != 0\\n    assert \\\"ci\\\" in run.stdout and \\\"in_progress\\\" in run.stdout\\n    assert elapsed >= 0.4, (\\n        f\\\"a check still in_progress should be polled for the bound, not \\\"\\n        f\\\"stopped on the first read -- took only {elapsed:.2f}s\\\")\\n\\n    assert record_files(root, \\\"verify\\\") == []\\n\\n\\ndef test_drive_halts_on_a_question_and_resumes_at_build_after_a_ruling(tmp_path):\\n    \\\"\\\"\\\"Acceptance row 5. The fixture adapter halts with a question: drive\\n    stops naming the question and the record (and still pushes that\\n    halted record, same as any other record build writes). After a\\n    ruling is appended, a second run resumes at build and this time\\n    passes.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    bare = add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\",\\n                     env={\\\"ATTAVO_FIXTURE_QUESTION\\\": \\\"which overlay wins?\\\"})\\n    assert run.returncode == 3\\n    assert \\\"which overlay wins?\\\" in run.stdout\\n\\n    rec = latest_record(root, \\\"build\\\")\\n    assert rec[\\\"status\\\"] == \\\"halted\\\"\\n    assert rec[\\\"halted\\\"] == {\\\"question\\\": \\\"which overlay wins?\\\"}\\n    record_path = record_files(root, \\\"build\\\")[-1]\\n    assert record_path.name in run.stdout\\n\\n    # The halted record was still committed and pushed.\\n    assert remote_head(bare, branch) == head_of(root)\\n\\n    rulings = root / \\\"rulings.md\\\"\\n    rulings.write_text(rulings.read_text() + \\\"\\\\n- overlay: use the base tree\\\\n\\\"\\n                       if rulings.exists() else \\\"- overlay: use the base tree\\\\n\\\")\\n    commit_all(root, \\\"rule on the overlay question\\\")\\n    git(root, \\\"push\\\", \\\"origin\\\", f\\\"HEAD:{branch}\\\")\\n\\n    run2 = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run2.returncode == 0, run2.stdout + run2.stderr\\n\\n    assert len(record_files(root, \\\"build\\\")) == 2\\n    rec2 = latest_record(root, \\\"build\\\")\\n    assert rec2[\\\"status\\\"] == \\\"pass\\\"\\n    assert remote_head(bare, branch) == head_of(root)\\n\\n\\ndef configure_counsel(root: Path) -> None:\\n    \\\"\\\"\\\"[executor].counsel = \\\"fixture\\\" -- build_valid's own manifest\\n    declares [executor].build = \\\"fixture\\\" only; counsel needs its own\\n    adapter named (issue #100).\\\"\\\"\\\"\\n    toml = root / \\\"attavo.toml\\\"\\n    toml.write_text(toml.read_text().replace(\\n        '[executor]\\\\nbuild = \\\"fixture\\\"', '[executor]\\\\nbuild = \\\"fixture\\\"\\\\ncounsel = \\\"fixture\\\"'))\\n    commit_all(root, \\\"configure the counsel adapter\\\")\\n\\n\\ndef test_drive_counsels_a_stop_before_filing_it_and_commits_both_records_together(tmp_path):\\n    \\\"\\\"\\\"Issue #100, acceptance row 3. On a stop, drive calls counsel\\n    before file-stops, and commits the counsel record with the stage\\n    record in one commit.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    bare = add_bare_remote(root, tmp_path)\\n    configure_counsel(root)\\n    approve_item(root)\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n    filed = tmp_path / \\\"filed.jsonl\\\"\\n    configure_filing(root, filed)\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\",\\n                     env={\\\"ATTAVO_FIXTURE_QUESTION\\\": \\\"which overlay wins?\\\"})\\n    assert run.returncode == 3\\n\\n    assert record_files(root, \\\"counsel\\\")\\n    counsel_rec = latest_record(root, \\\"counsel\\\")\\n    assert counsel_rec[\\\"record_stage\\\"] == \\\"build\\\"\\n    assert counsel_rec[\\\"record\\\"] == \\\"build-01\\\"\\n    assert counsel_rec[\\\"verdict\\\"] == \\\"person\\\"\\n\\n    committed = set(last_commit_paths(root))\\n    assert committed == {\\n        \\\"records/1/build-01.json\\\", \\\"records/1/build-01.log\\\",\\n        \\\"records/1/counsel-01.json\\\", \\\"records/1/counsel-01.log\\\",\\n        \\\"records/1/build-01.filed\\\",\\n    }\\n    assert remote_head(bare, branch) == head_of(root)\\n\\n    filed_bodies = [json.loads(l) for l in filed.read_text().splitlines() if l.strip()]\\n    assert len(filed_bodies) == 1\\n    assert filed_bodies[0][\\\"counsel_verdict\\\"] == \\\"person\\\"\\n    assert filed_bodies[0][\\\"counsel_proposal\\\"][\\\"question\\\"]\\n\\n\\ndef test_drive_still_files_a_stop_with_no_counsel_adapter_configured(tmp_path):\\n    \\\"\\\"\\\"counsel refuses gracefully (no [executor].counsel or\\n    [executor].verify) -- drive still files and transports the stage\\n    record; nothing new for counsel to commit.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    bare = add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n    filed = tmp_path / \\\"filed.jsonl\\\"\\n    configure_filing(root, filed)\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\",\\n                     env={\\\"ATTAVO_FIXTURE_QUESTION\\\": \\\"which overlay wins?\\\"})\\n    assert run.returncode == 3\\n\\n    assert record_files(root, \\\"counsel\\\") == []\\n    committed = set(last_commit_paths(root))\\n    assert committed == {\\\"records/1/build-01.json\\\", \\\"records/1/build-01.log\\\",\\n                         \\\"records/1/build-01.filed\\\"}\\n    assert remote_head(bare, branch) == head_of(root)\\n\\n\\ndef configure_filing(root: Path, filed_path: Path) -> None:\\n    \\\"\\\"\\\"Appended under the [forge] table add_forge already opened -- a\\n    second [forge] header in the same file is a TOML redeclaration\\n    error. Prints a fake issue URL on stdout, numbered by filed_path's\\n    own line count so far -- the fact a real file_issue_command's stdout\\n    would carry, and what the .filed marker beside each stop record is\\n    meant to hold (issue #89).\\\"\\\"\\\"\\n    toml = root / \\\"attavo.toml\\\"\\n    command = (f\\\"n=$(wc -l < {filed_path} 2>/dev/null || echo 0); \\\"\\n              f\\\"cat >> {filed_path}; \\\"\\n              f\\\"echo https://github.com/tenant/repo/issues/$((n + 1))\\\")\\n    toml.write_text(toml.read_text() + f\\\"\\\\nfile_issue_command = '{command}'\\\\n\\\")\\n    commit_all(root, \\\"configure issue filing\\\")\\n\\n\\ndef test_drive_files_a_stop_it_reports_exactly_once(tmp_path):\\n    \\\"\\\"\\\"Issue #89, acceptance row 5. A stop drive reports -- here, the\\n    fixture adapter's halt -- calls file-stops once: one drive run files\\n    exactly one issue for the attempt it just wrote, not zero and not\\n    more than one.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n    filed = tmp_path / \\\"filed.jsonl\\\"\\n    configure_filing(root, filed)\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\",\\n                     env={\\\"ATTAVO_FIXTURE_QUESTION\\\": \\\"which overlay wins?\\\"})\\n    assert run.returncode == 3\\n\\n    filed_bodies = [json.loads(l) for l in filed.read_text().splitlines() if l.strip()]\\n    assert len(filed_bodies) == 1\\n    assert filed_bodies[0][\\\"record\\\"] == \\\"records/1/build-01.json\\\"\\n\\n    # A second drive run halts again -- a new attempt, build-02 -- and\\n    # files exactly one more issue for that new record; file-stops' own\\n    # .filed marker means build-01's issue is never filed twice.\\n    run2 = run_attavo(root, \\\"drive\\\", \\\"1\\\",\\n                      env={\\\"ATTAVO_FIXTURE_QUESTION\\\": \\\"which overlay wins?\\\"})\\n    assert run2.returncode == 3\\n    assert len(record_files(root, \\\"build\\\")) == 2\\n\\n    filed_bodies_after = [json.loads(l) for l in filed.read_text().splitlines() if l.strip()]\\n    assert len(filed_bodies_after) == 2\\n    assert filed_bodies_after[0] == filed_bodies[0]\\n    assert filed_bodies_after[1][\\\"record\\\"] == \\\"records/1/build-02.json\\\"\\n\\n\\ndef test_drive_marker_holds_the_filing_commands_stdout_and_is_committed_with_the_record(tmp_path):\\n    \\\"\\\"\\\"A stop's own .filed marker is written before the record is\\n    transported, so it carries the filing command's stdout (the issue it\\n    opened) and rides in the very same commit as the record and its log\\n    -- one commit, one push, as before this fix. Red before it: the\\n    marker was written empty, after commit_record and push_record_commit\\n    had already run, so it was never part of any commit at all.\\n    \\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    bare = add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n    filed = tmp_path / \\\"filed.jsonl\\\"\\n    configure_filing(root, filed)\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\",\\n                     env={\\\"ATTAVO_FIXTURE_QUESTION\\\": \\\"which overlay wins?\\\"})\\n    assert run.returncode == 3\\n\\n    marker_path = records_dir(root) / \\\"build-01.filed\\\"\\n    assert marker_path.is_file()\\n    assert marker_path.read_text().strip() == \\\"https://github.com/tenant/repo/issues/1\\\"\\n\\n    committed = set(last_commit_paths(root))\\n    assert committed == {\\\"records/1/build-01.json\\\", \\\"records/1/build-01.log\\\",\\n                         \\\"records/1/build-01.filed\\\"}\\n    assert remote_head(bare) == head_of(root)\\n\\n\\ndef test_drive_a_second_run_in_the_same_state_files_nothing(tmp_path):\\n    \\\"\\\"\\\"Issue #89. The marker committed and pushed above is the fact a\\n    second worktree or a fresh clone reads too -- a second drive run\\n    against the same records, from a fresh clone of the remote drive\\n    already pushed to, files nothing for the stop that clone already\\n    carries a marker for. Red before this fix: the marker never reached\\n    the remote at all, so every clone refiled every stop it found.\\n    \\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    bare = add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n    filed = tmp_path / \\\"filed.jsonl\\\"\\n    configure_filing(root, filed)\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\",\\n                     env={\\\"ATTAVO_FIXTURE_QUESTION\\\": \\\"which overlay wins?\\\"})\\n    assert run.returncode == 3\\n    filed_after_first = filed.read_text()\\n    assert filed_after_first.strip() != \\\"\\\"\\n\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n    clone = tmp_path / \\\"fresh-clone\\\"\\n    subprocess.run([\\\"git\\\", \\\"clone\\\", \\\"--quiet\\\", \\\"--branch\\\", branch, str(bare), str(clone)],\\n                   check=True)\\n\\n    run2 = run_attavo(clone, \\\"file-stops\\\", \\\"1\\\")\\n    assert run2.returncode == 0\\n    assert \\\"no stops to file\\\" in run2.stdout\\n    assert filed.read_text() == filed_after_first  # nothing new was filed\\n\\n\\ndef test_drive_retries_a_rejected_push_with_a_merge_never_a_rebase(tmp_path):\\n    \\\"\\\"\\\"Acceptance row 7. A rejected push with a divergent remote is\\n    retried after `git pull --no-rebase --no-edit`, never a rebase; the\\n    build record's own sha is unchanged (still reachable, still what the\\n    record names), and the retry lands a merge commit, not a rewritten\\n    one.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    bare = add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n\\n    # Diverge the bare remote: another clone pushes an unrelated commit to\\n    # the same branch before drive's own push happens.\\n    other = tmp_path / \\\"other-clone\\\"\\n    subprocess.run([\\\"git\\\", \\\"clone\\\", \\\"--quiet\\\", str(bare), str(other)], check=True)\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(other), \\\"checkout\\\", \\\"-q\\\", branch], check=True)\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(other), \\\"config\\\", \\\"user.email\\\", \\\"other@example.com\\\"],\\n                   check=True)\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(other), \\\"config\\\", \\\"user.name\\\", \\\"Other\\\"], check=True)\\n    (other / \\\"concurrent.txt\\\").write_text(\\\"from elsewhere\\\\n\\\")\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(other), \\\"add\\\", \\\"-A\\\"], check=True)\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(other), \\\"commit\\\", \\\"-q\\\", \\\"-m\\\", \\\"a concurrent commit\\\"],\\n                   check=True)\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(other), \\\"push\\\", \\\"origin\\\", f\\\"HEAD:{branch}\\\"], check=True)\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n\\n    rec = latest_record(root, \\\"build\\\")\\n    assert rec[\\\"status\\\"] == \\\"pass\\\"\\n    build_sha = rec[\\\"sha\\\"]\\n\\n    # The build's own commit sha is still reachable -- a merge, not a\\n    # rebase, which would have rewritten it under a new sha.\\n    assert build_sha in git(root, \\\"rev-list\\\", \\\"HEAD\\\").split()\\n\\n    # The retry landed a merge commit somewhere in history, not\\n    # necessarily at HEAD -- the invocation marker's own push is the one\\n    # that met the divergent remote and retried; the build record's own\\n    # push, once the branches were already merged, needed no retry of\\n    # its own.\\n    assert git(root, \\\"rev-list\\\", \\\"--merges\\\", \\\"HEAD\\\").split(), \\\\\\n        \\\"the retry should have landed a merge commit\\\"\\n\\n    assert remote_head(bare, branch) == head_of(root)\\n    # the concurrent commit from the other clone is present too\\n    assert \\\"concurrent.txt\\\" in git(root, \\\"ls-tree\\\", \\\"-r\\\", \\\"--name-only\\\", \\\"HEAD\\\")\\n\\n\\ndef add_drive_stall_bound(root: Path, seconds: int) -> None:\\n    toml = root / \\\"attavo.toml\\\"\\n    toml.write_text(toml.read_text() + f\\\"\\\\n[drive]\\\\nstall_after_s = {seconds}\\\\n\\\")\\n    commit_all(root, \\\"configure the drive stall bound\\\")\\n\\n\\ndef test_drive_writes_and_pushes_an_invocation_marker_before_running_the_stage(tmp_path):\\n    \\\"\\\"\\\"Issue #151. Before running build, drive writes a build-01.started\\n    marker and commits and pushes it by itself -- the fact that this\\n    invocation began is on the branch before the adapter ever runs, so a\\n    process that dies mid-build still leaves it behind.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    bare = add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n\\n    marker_path = records_dir(root) / \\\"build-01.started\\\"\\n    assert marker_path.is_file()\\n    info = json.loads(marker_path.read_text())\\n    assert info[\\\"pid\\\"] > 0 and info[\\\"host\\\"] and info[\\\"sha\\\"]\\n\\n    # The marker's own commit precedes the record's own commit; both\\n    # reached the remote.\\n    marker_commit = git(root, \\\"log\\\", \\\"-1\\\", \\\"--format=%H\\\",\\n                        \\\"--\\\", \\\"records/1/build-01.started\\\").strip()\\n    record_commit = git(root, \\\"log\\\", \\\"-1\\\", \\\"--format=%H\\\",\\n                        \\\"--\\\", \\\"records/1/build-01.json\\\").strip()\\n    assert marker_commit != record_commit\\n    is_ancestor = subprocess.run(\\n        [\\\"git\\\", \\\"-C\\\", str(root), \\\"merge-base\\\", \\\"--is-ancestor\\\", marker_commit, record_commit],\\n        check=False)\\n    assert is_ancestor.returncode == 0, \\\"the marker's commit should precede the record's\\\"\\n    assert remote_head(bare, branch) == head_of(root)\\n\\n\\ndef test_drive_recover_writes_a_died_record_for_a_dead_marker(tmp_path):\\n    \\\"\\\"\\\"Issue #151, acceptance row 2. A marker naming a dead pid on this\\n    host, with no record beside it, is recovered as a failed record, stop\\n    class died, provenance product, committed by the driver identity with\\n    a clean tree -- the fixture #148 left behind by hand, done here by\\n    the product instead.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_drive_stall_bound(root, 60)\\n    bare = add_bare_remote(root, tmp_path)\\n\\n    dead = subprocess.Popen([sys.executable, \\\"-c\\\", \\\"pass\\\"])\\n    dead.wait()\\n    marker = records_dir(root) / \\\"build-01.started\\\"\\n    marker.parent.mkdir(parents=True, exist_ok=True)\\n    marker.write_text(json.dumps({\\\"at\\\": \\\"2026-09-17T13:16:08Z\\\", \\\"host\\\": socket.gethostname(),\\n                                  \\\"pid\\\": dead.pid, \\\"sha\\\": head_of(root),\\n                                  \\\"product_version\\\": \\\"fixture\\\"}))\\n    commit_all(root, \\\"invocation marker for item 1\\\")\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\", \\\"--recover\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n\\n    rec = latest_record(root, \\\"build\\\")\\n    assert rec[\\\"status\\\"] == \\\"failed\\\"\\n    assert rec[\\\"stop\\\"][\\\"class\\\"] == \\\"died\\\"\\n    assert rec[\\\"stop\\\"][\\\"provenance\\\"] == \\\"product\\\"\\n    assert \\\"wrote no build-01.json\\\" in rec[\\\"stop\\\"][\\\"detail\\\"]\\n\\n    assert (records_dir(root) / \\\"build-01.log\\\").is_file()\\n    assert git(root, \\\"log\\\", \\\"-1\\\", \\\"--format=%an\\\").strip() == \\\"attavo driver\\\"\\n    assert git(root, \\\"status\\\", \\\"--porcelain\\\").strip() == \\\"\\\"\\n    assert remote_head(bare) == head_of(root)\\n\\n\\ndef test_drive_recover_leaves_a_live_invocation_alone(tmp_path):\\n    \\\"\\\"\\\"A marker naming this test process's own pid -- alive on this host\\n    and well inside the stall bound -- is running, not died: recover\\n    writes nothing.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_drive_stall_bound(root, 3600)\\n\\n    marker = records_dir(root) / \\\"build-01.started\\\"\\n    marker.parent.mkdir(parents=True, exist_ok=True)\\n    marker.write_text(json.dumps({\\\"at\\\": \\\"2026-09-17T13:16:08Z\\\", \\\"host\\\": socket.gethostname(),\\n                                  \\\"pid\\\": os.getpid(), \\\"sha\\\": head_of(root),\\n                                  \\\"product_version\\\": \\\"fixture\\\"}))\\n    commit_all(root, \\\"invocation marker for a live pid\\\")\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\", \\\"--recover\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n    assert \\\"nothing to recover\\\" in run.stdout\\n    assert record_files(root, \\\"build\\\") == []\\n\\n\\ndef test_drive_forge_poll_defaults_are_a_real_forges_clock():\\n    \\\"\\\"\\\"The bound and interval every other test overrides with\\n    FAST_POLL_ENV default, unset, to at least five minutes and ten\\n    seconds -- tenant zero's own checks conclude about five minutes after\\n    a push, and a bound shorter than that would make every drive run\\n    after a record push stop on 'forge checks not green', with a person\\n    running it again after CI: exactly the transport act this lane\\n    retires. Row 4 (a forge that never goes green) is unchanged in\\n    meaning by this -- it still stops, just after waiting out a real\\n    forge's own clock instead of a test's fake one.\\n    \\\"\\\"\\\"\\n    module = attavo_module()\\n    assert module.DRIVE_FORGE_POLL_BOUND_DEFAULT_S >= 300\\n    assert module.DRIVE_FORGE_POLL_INTERVAL_DEFAULT_S >= 10\\n\",\"structuredPatch\":[{\"oldStart\":823,\"oldLines\":23,\"newStart\":823,\"newLines\":30,\"lines\":[\" \",\" \",\" def test_drive_recover_leaves_a_live_invocation_alone(tmp_path):\",\"-    \\\"\\\"\\\"A marker naming this test process's own pid -- alive on this host\",\"-    and well inside the stall bound -- is running, not died: recover\",\"-    writes nothing.\\\"\\\"\\\"\",\"+    \\\"\\\"\\\"A marker naming a live, unrelated pid on this host, started just\",\"+    now -- well inside the stall bound -- is running, not died: recover\",\"+    writes nothing. A real subprocess, never this test's own pid: were it\",\"+    ever judged hung, recover would SIGTERM the pid the marker names.\\\"\\\"\\\"\",\"     root = make_tenant(tmp_path, \\\"build_valid\\\")\",\"     add_drive_stall_bound(root, 3600)\",\" \",\"-    marker = records_dir(root) / \\\"build-01.started\\\"\",\"-    marker.parent.mkdir(parents=True, exist_ok=True)\",\"-    marker.write_text(json.dumps({\\\"at\\\": \\\"2026-09-17T13:16:08Z\\\", \\\"host\\\": socket.gethostname(),\",\"-                                  \\\"pid\\\": os.getpid(), \\\"sha\\\": head_of(root),\",\"-                                  \\\"product_version\\\": \\\"fixture\\\"}))\",\"-    commit_all(root, \\\"invocation marker for a live pid\\\")\",\"+    alive = subprocess.Popen([sys.executable, \\\"-c\\\", \\\"import time; time.sleep(30)\\\"])\",\"+    try:\",\"+        marker = records_dir(root) / \\\"build-01.started\\\"\",\"+        marker.parent.mkdir(parents=True, exist_ok=True)\",\"+        marker.write_text(json.dumps(\",\"+            {\\\"at\\\": datetime.now(timezone.utc).strftime(\\\"%Y-%m-%dT%H:%M:%SZ\\\"),\",\"+             \\\"host\\\": socket.gethostname(), \\\"pid\\\": alive.pid, \\\"sha\\\": head_of(root),\",\"+             \\\"product_version\\\": \\\"fixture\\\"}))\",\"+        commit_all(root, \\\"invocation marker for a live pid\\\")\",\" \",\"-    run = run_attavo(root, \\\"drive\\\", \\\"1\\\", \\\"--recover\\\")\",\"-    assert run.returncode == 0, run.stdout + run.stderr\",\"-    assert \\\"nothing to recover\\\" in run.stdout\",\"-    assert record_files(root, \\\"build\\\") == []\",\"+        run = run_attavo(root, \\\"drive\\\", \\\"1\\\", \\\"--recover\\\")\",\"+        assert run.returncode == 0, run.stdout + run.stderr\",\"+        assert \\\"nothing to recover\\\" in run.stdout\",\"+        assert record_files(root, \\\"build\\\") == []\",\"+    finally:\",\"+        alive.terminate()\",\"+        alive.wait()\",\" \",\" \",\" def test_drive_forge_poll_defaults_are_a_real_forges_clock():\"]}],\"userModified\":false,\"replaceAll\":false}}\nattest/records/151/build-03.log:759:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01RPSDyrAycoLfuNxWFJZnUt\",\"type\":\"tool_result\",\"content\":\"The file /Users/davidbean/Projects/attavo-worktree-151/tests/test_drive.py has been updated successfully. (file state is current in your context — no need to Read it back)\"}]},\"parent_tool_use_id\":null,\"session_id\":\"f081a203-e2ee-47b3-8bf8-5fc3aaeb804d\",\"uuid\":\"7b73243b-3fa1-40fd-86ce-cacc533f2211\",\"timestamp\":\"2026-09-17T20:01:28.399Z\",\"tool_use_result\":{\"filePath\":\"/Users/davidbean/Projects/attavo-worktree-151/tests/test_drive.py\",\"oldString\":\"import subprocess\\nimport sys\\nimport time\\nfrom pathlib import Path\",\"newString\":\"import subprocess\\nimport sys\\nimport time\\nfrom datetime import datetime, timezone\\nfrom pathlib import Path\",\"originalFile\":\"\\\"\\\"\\\"attavo drive: the mechanical transitions between approval and\\nready-to-merge (issue #84) -- one step per invocation, and only that step,\\nuntil a state that belongs to a person. Every test uses the fixture\\nadapter and a fake `[forge].checks_command`; every record commit is\\n`git commit --only` and pushed to a real (bare) fixture remote.\\n\\nRegression tests, written and run red first: on `main` at 85f6f3b there\\nwas no `drive` subcommand, so every one of these failed with \\\"unknown\\nsubcommand\\\".\\n\\nRun: python3 -m pytest tests -q\\n\\\"\\\"\\\"\\nimport importlib.machinery\\nimport importlib.util\\nimport json\\nimport os\\nimport socket\\nimport subprocess\\nimport sys\\nimport time\\nfrom pathlib import Path\\n\\nfrom helpers import commit_all, git, make_tenant\\n\\nROOT = Path(__file__).resolve().parent.parent\\nATTAVO = ROOT / \\\"bin\\\" / \\\"attavo\\\"\\n\\nGREEN_FORGE = \\\"printf 'ci success\\\\\\\\n'\\\"\\n# A concluded conclusion -- checked and failing, not something still\\n# running. Distinct from UNCONCLUDED_FORGE below (issue #84): drive polls\\n# the one still running for the bound, but stops on the first read of a\\n# check that has already concluded, whether or not it passed.\\nRED_FORGE = \\\"printf 'ci failure\\\\\\\\n'\\\"\\nUNCONCLUDED_FORGE = \\\"printf 'ci in_progress\\\\\\\\n'\\\"\\n\\n# The real defaults (ATTAVO_DRIVE_POLL_BOUND_S=600, _INTERVAL_S=20) are a\\n# real forge's clock, not a test's -- tenant zero's own checks conclude\\n# about five minutes after a push. Every `attavo drive` call here runs\\n# against this much shorter clock instead, read at call time from the\\n# same environment variables; test_drive_forge_poll_defaults_are_a_real_\\n# forges_clock is the one test that leaves them unset, to assert the\\n# defaults themselves. The interval is kept well above typical subprocess\\n# startup overhead so a zero-sleep stop and a polled one are easy to tell\\n# apart by wall clock alone.\\nFAST_POLL_ENV = {\\\"ATTAVO_DRIVE_POLL_BOUND_S\\\": \\\"0.9\\\", \\\"ATTAVO_DRIVE_POLL_INTERVAL_S\\\": \\\"0.5\\\"}\\n\\n\\ndef run_attavo(root: Path, *args: str, env: dict | None = None) -> subprocess.CompletedProcess:\\n    full_env = dict(os.environ)\\n    full_env.update(FAST_POLL_ENV)\\n    if env:\\n        full_env.update(env)\\n    return subprocess.run([sys.executable, str(ATTAVO), *args], cwd=str(root),\\n                          capture_output=True, text=True, check=False, env=full_env)\\n\\n\\ndef attavo_module():\\n    \\\"\\\"\\\"bin/attavo imported in-process, for the default-constant assertion\\n    below that a CLI invocation cannot provoke without actually waiting\\n    out the real clock.\\\"\\\"\\\"\\n    loader = importlib.machinery.SourceFileLoader(\\\"attavo_drive_under_test\\\", str(ATTAVO))\\n    spec = importlib.util.spec_from_loader(loader.name, loader)\\n    module = importlib.util.module_from_spec(spec)\\n    loader.exec_module(module)\\n    return module\\n\\n\\ndef add_forge(root: Path, checks_command: str) -> None:\\n    toml = root / \\\"attavo.toml\\\"\\n    toml.write_text(toml.read_text() + f'\\\\n[forge]\\\\nchecks_command = \\\"{checks_command}\\\"\\\\n')\\n    commit_all(root, \\\"configure the forge read\\\")\\n\\n\\ndef approve_item(root: Path, item: str = \\\"1\\\") -> None:\\n    assert run_attavo(root, \\\"spec-gate\\\", item).returncode == 0\\n    assert run_attavo(root, \\\"approve\\\", item, \\\"--by\\\", \\\"alice\\\").returncode == 0\\n\\n\\ndef add_bare_remote(root: Path, tmp_path: Path) -> Path:\\n    \\\"\\\"\\\"A real (bare) remote named origin, seeded with the tenant's current\\n    state -- drive's own push target, distinct from the fake\\n    refs/remotes/origin/* helpers.init_repo sets up purely for verify's\\n    diff base.\\\"\\\"\\\"\\n    bare = tmp_path / \\\"origin.git\\\"\\n    subprocess.run([\\\"git\\\", \\\"init\\\", \\\"--quiet\\\", \\\"--bare\\\", \\\"-b\\\", \\\"main\\\", str(bare)], check=True)\\n    git(root, \\\"remote\\\", \\\"add\\\", \\\"origin\\\", str(bare))\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n    git(root, \\\"push\\\", \\\"origin\\\", f\\\"HEAD:{branch}\\\")\\n    return bare\\n\\n\\ndef records_dir(root: Path, item: str = \\\"1\\\") -> Path:\\n    return root / \\\"records\\\" / item\\n\\n\\ndef record_files(root: Path, stage: str, item: str = \\\"1\\\") -> list[Path]:\\n    return sorted(records_dir(root, item).glob(f\\\"{stage}-*.json\\\"))\\n\\n\\ndef latest_record(root: Path, stage: str, item: str = \\\"1\\\") -> dict:\\n    files = record_files(root, stage, item)\\n    assert files, f\\\"no {stage} record for item {item}\\\"\\n    return json.loads(files[-1].read_text())\\n\\n\\ndef head_of(root: Path) -> str:\\n    return git(root, \\\"rev-parse\\\", \\\"HEAD\\\").strip()\\n\\n\\ndef last_commit_paths(root: Path) -> list[str]:\\n    return git(root, \\\"diff\\\", \\\"--name-only\\\", \\\"HEAD^\\\", \\\"HEAD\\\").splitlines()\\n\\n\\ndef remote_head(bare: Path, branch: str = \\\"main\\\") -> str:\\n    return subprocess.run([\\\"git\\\", \\\"-C\\\", str(bare), \\\"rev-parse\\\", branch],\\n                          capture_output=True, text=True, check=True).stdout.strip()\\n\\n\\ndef test_drive_refuses_without_a_valid_approval(tmp_path):\\n    \\\"\\\"\\\"Acceptance row 6. No approval at all: refused by name, nothing run\\n    -- no spec-gate, no build, no records of any kind written.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    add_bare_remote(root, tmp_path)\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run.returncode != 0\\n    assert \\\"approval\\\" in run.stdout\\n    assert \\\"absent\\\" in run.stdout\\n\\n    assert not records_dir(root).exists() or list(records_dir(root).glob(\\\"*.json\\\")) == []\\n\\n\\ndef test_drive_refuses_with_an_expired_approval(tmp_path):\\n    \\\"\\\"\\\"Acceptance row 6, the other half: an approval bound to a spec sha\\n    that has since moved is expired, not absent -- still refused by name,\\n    nothing run.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n\\n    (root / \\\"specs\\\" / \\\"1\\\" / \\\"spec.md\\\").write_text(\\n        (root / \\\"specs\\\" / \\\"1\\\" / \\\"spec.md\\\").read_text() + \\\"\\\\n\\\")\\n    commit_all(root, \\\"touch the spec after approval\\\")\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run.returncode != 0\\n    assert \\\"expired\\\" in run.stdout\\n    assert record_files(root, \\\"build\\\") == []\\n\\n\\ndef test_drive_builds_from_an_approved_spec_with_no_build(tmp_path):\\n    \\\"\\\"\\\"Acceptance row 1. One drive run produces a passing build record,\\n    commits only the record and its log (`git commit --only`), and pushes\\n    the branch; the fixture remote carries the record commit.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    bare = add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n\\n    rec = latest_record(root, \\\"build\\\")\\n    assert rec[\\\"status\\\"] == \\\"pass\\\"\\n\\n    record_path = record_files(root, \\\"build\\\")[-1]\\n    log_path = record_path.with_suffix(\\\".log\\\")\\n    assert log_path.exists()\\n\\n    touched = set(last_commit_paths(root))\\n    assert touched == {\\n        str(record_path.relative_to(root)),\\n        str(log_path.relative_to(root)),\\n    }\\n\\n    assert remote_head(bare, branch) == head_of(root)\\n\\n\\ndef test_drive_leaves_the_events_file_out_of_the_record_commit(tmp_path):\\n    \\\"\\\"\\\"Issue #26, acceptance row 2, strengthened by issue #140: attavo\\n    build always writes a stage's events file now (test_build.py's own\\n    row-1 tests), under the checkout's own git directory rather than\\n    the working tree -- so it is not merely excluded from the commit's\\n    file list, it is not even a path git tracks anything under. The\\n    commit's file list still names only the record and its log.\\n    \\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n\\n    record_path = record_files(root, \\\"build\\\")[-1]\\n    git_dir = git(root, \\\"rev-parse\\\", \\\"--absolute-git-dir\\\").strip()\\n    events_path = Path(git_dir) / \\\"attavo\\\" / \\\"build-01.events.jsonl\\\"\\n    assert events_path.is_file()\\n\\n    touched = set(last_commit_paths(root))\\n    assert touched == {\\n        str(record_path.relative_to(root)),\\n        str(record_path.with_suffix(\\\".log\\\").relative_to(root)),\\n    }\\n\\n\\ndef test_drive_commits_the_record_as_the_driver_not_the_tenants_own_identity(tmp_path):\\n    \\\"\\\"\\\"The driver's identity (driver_identity, beside executor_identity):\\n    set by the product, never the tenant's git config, so a driven item's\\n    record commits are never indistinguishable from an operator's own.\\n    The fixture tenant's user.name is set to another value here, so a\\n    commit carrying it would prove commit_record fell back to the\\n    tenant's git config instead.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    git(root, \\\"config\\\", \\\"user.name\\\", \\\"Some Operator\\\")\\n    git(root, \\\"config\\\", \\\"user.email\\\", \\\"operator@example.com\\\")\\n    add_forge(root, GREEN_FORGE)\\n    add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n\\n    author_name = git(root, \\\"log\\\", \\\"-1\\\", \\\"--format=%an\\\").strip()\\n    author_email = git(root, \\\"log\\\", \\\"-1\\\", \\\"--format=%ae\\\").strip()\\n    committer_name = git(root, \\\"log\\\", \\\"-1\\\", \\\"--format=%cn\\\").strip()\\n    committer_email = git(root, \\\"log\\\", \\\"-1\\\", \\\"--format=%ce\\\").strip()\\n\\n    assert author_name == \\\"attavo driver\\\"\\n    assert author_email == \\\"driver@attavo.invalid\\\"\\n    assert committer_name == \\\"attavo driver\\\"\\n    assert committer_email == \\\"driver@attavo.invalid\\\"\\n\\n\\ndef test_drive_verifies_from_a_passed_build_with_the_forge_green(tmp_path):\\n    \\\"\\\"\\\"Acceptance row 2. From a passed build with the fake forge green,\\n    one run produces a verify record, commits only the record and its log,\\n    and pushes.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    bare = add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n\\n    assert run_attavo(root, \\\"drive\\\", \\\"1\\\").returncode == 0  # builds\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n\\n    assert record_files(root, \\\"build\\\") and record_files(root, \\\"verify\\\")\\n    rec = latest_record(root, \\\"verify\\\")\\n    assert rec[\\\"status\\\"] == \\\"pass\\\"\\n\\n    record_path = record_files(root, \\\"verify\\\")[-1]\\n    log_path = record_path.with_suffix(\\\".log\\\")\\n    assert log_path.exists()\\n\\n    touched = set(last_commit_paths(root))\\n    assert touched == {\\n        str(record_path.relative_to(root)),\\n        str(log_path.relative_to(root)),\\n    }\\n\\n    assert remote_head(bare, branch) == head_of(root)\\n\\n\\ndef test_drive_verifies_again_when_the_latest_verify_is_superseded_by_a_later_build(tmp_path):\\n    \\\"\\\"\\\"Acceptance row 4, issue #109. A verify record can only name a build\\n    that existed when it was written, so a later build makes the latest\\n    verify superseded, never a mismatch -- drive derives the next stage\\n    as verify, not build, and never refuses.\\n\\n    Regression: on main before this lane, drive_state's own inline\\n    staleness check already treats this as 'verify', so this test does\\n    not fail against current code -- it is here to lock the behavior\\n    check_attest_chain's fix must not disturb (the acceptance table's\\n    'never refuses' row).\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n\\n    assert run_attavo(root, \\\"drive\\\", \\\"1\\\").returncode == 0  # builds\\n    assert run_attavo(root, \\\"drive\\\", \\\"1\\\").returncode == 0  # verifies\\n\\n    # A second build record, minted by hand -- a real re-run of the\\n    # fixture adapter is not idempotent against its own tree -- naming a\\n    # sha the existing verify-01 does not: verify-01 is now superseded.\\n    build_01 = json.loads(record_files(root, \\\"build\\\")[-1].read_text())\\n    build_01[\\\"sha\\\"] = \\\"f\\\" * 40\\n    (records_dir(root) / \\\"build-02.json\\\").write_text(json.dumps(build_01))\\n    commit_all(root, \\\"attavo: second build record for #1, minted by hand\\\")\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n    assert len(record_files(root, \\\"build\\\")) == 2\\n    assert len(record_files(root, \\\"verify\\\")) == 2\\n    rec = latest_record(root, \\\"verify\\\")\\n    assert rec[\\\"status\\\"] == \\\"pass\\\"\\n    assert rec[\\\"build_sha\\\"] == build_01[\\\"sha\\\"]\\n\\n\\ndef test_drive_prints_ready_to_merge_from_a_passed_verify(tmp_path):\\n    \\\"\\\"\\\"Acceptance row 3. From a passed verify with the forge green, one\\n    run prints ready-to-merge, exits 0, writes nothing, enqueues nothing\\n    -- and, per row 8, a further run repeats exactly the same thing.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n\\n    assert run_attavo(root, \\\"drive\\\", \\\"1\\\").returncode == 0  # builds\\n    assert run_attavo(root, \\\"drive\\\", \\\"1\\\").returncode == 0  # verifies\\n\\n    pre_head = head_of(root)\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n    assert \\\"ready to merge\\\" in run.stdout\\n    assert head_of(root) == pre_head\\n    assert record_files(root, \\\"verify\\\") and len(record_files(root, \\\"verify\\\")) == 1\\n\\n    # Acceptance row 8: idempotence -- run it again, same result, nothing\\n    # new written or pushed.\\n    run2 = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run2.returncode == 0\\n    assert \\\"ready to merge\\\" in run2.stdout\\n    assert head_of(root) == pre_head\\n    assert len(record_files(root, \\\"verify\\\")) == 1\\n    assert len(record_files(root, \\\"build\\\")) == 1\\n\\n\\ndef test_drive_until_ready_runs_build_then_verify_to_ready_in_one_call(tmp_path):\\n    \\\"\\\"\\\"Issue #100's own followups. --until-ready repeats step-and-wait in\\n    the same process: one call, from an approved item with the forge\\n    green, builds, verifies, and prints ready to merge -- both records\\n    written and pushed, without the caller invoking drive again after\\n    each passing step.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    bare = add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\", \\\"--until-ready\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n    assert \\\"ready to merge\\\" in run.stdout\\n\\n    assert len(record_files(root, \\\"build\\\")) == 1\\n    assert len(record_files(root, \\\"verify\\\")) == 1\\n    assert latest_record(root, \\\"build\\\")[\\\"status\\\"] == \\\"pass\\\"\\n    assert latest_record(root, \\\"verify\\\")[\\\"status\\\"] == \\\"pass\\\"\\n    assert remote_head(bare, branch) == head_of(root)\\n\\n    # Idempotence, same as the single-step form: a further --until-ready\\n    # call repeats exactly the same ready-to-merge result, writing nothing.\\n    run2 = run_attavo(root, \\\"drive\\\", \\\"1\\\", \\\"--until-ready\\\")\\n    assert run2.returncode == 0\\n    assert \\\"ready to merge\\\" in run2.stdout\\n    assert len(record_files(root, \\\"build\\\")) == 1\\n    assert len(record_files(root, \\\"verify\\\")) == 1\\n\\n\\ndef test_drive_without_the_flag_still_takes_one_step_at_a_time(tmp_path):\\n    \\\"\\\"\\\"Regression: --until-ready is additive. With no flag, an approved\\n    item with the forge green still needs two separate calls -- build,\\n    then verify -- exactly as before this issue.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run.returncode == 0\\n    assert record_files(root, \\\"build\\\") and not record_files(root, \\\"verify\\\")\\n\\n    run2 = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run2.returncode == 0\\n    assert record_files(root, \\\"verify\\\")\\n\\n\\ndef test_drive_until_ready_stops_on_a_halt(tmp_path):\\n    \\\"\\\"\\\"A step that stops on its own account -- here, a halted build --\\n    stops the --until-ready loop exactly where the single-step form\\n    would, printing the same thing; it does not retry the halted step.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    bare = add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\", \\\"--until-ready\\\",\\n                     env={\\\"ATTAVO_FIXTURE_QUESTION\\\": \\\"which overlay wins?\\\"})\\n    assert run.returncode == 3\\n    assert \\\"which overlay wins?\\\" in run.stdout\\n\\n    assert len(record_files(root, \\\"build\\\")) == 1\\n    assert latest_record(root, \\\"build\\\")[\\\"status\\\"] == \\\"halted\\\"\\n    assert record_files(root, \\\"verify\\\") == []\\n    assert remote_head(bare, branch) == head_of(root)\\n\\n\\ndef test_drive_until_ready_stops_when_the_forge_goes_red_after_a_build(tmp_path):\\n    \\\"\\\"\\\"A build that passes, then a forge that concludes red for verify's\\n    own gate, stops the loop there -- one record written (the pass), no\\n    verify record, no retry of the forge read.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, RED_FORGE)\\n    add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\", \\\"--until-ready\\\")\\n    assert run.returncode != 0\\n    assert \\\"ci\\\" in run.stdout and \\\"failure\\\" in run.stdout\\n\\n    assert len(record_files(root, \\\"build\\\")) == 1\\n    assert latest_record(root, \\\"build\\\")[\\\"status\\\"] == \\\"pass\\\"\\n    assert record_files(root, \\\"verify\\\") == []\\n\\n\\ndef test_drive_stops_when_the_forge_is_red(tmp_path):\\n    \\\"\\\"\\\"Acceptance row 4. A forge read where the one check has already\\n    concluded and failed is not polled at all -- there is nothing left to\\n    wait on, so drive stops on the first read, naming the check, with no\\n    sleep in between. Writes nothing -- no verify record at all, no new\\n    commit.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, RED_FORGE)\\n    add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n\\n    assert run_attavo(root, \\\"drive\\\", \\\"1\\\").returncode == 0  # builds\\n    pre_head = head_of(root)\\n\\n    started = time.monotonic()\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    elapsed = time.monotonic() - started\\n    assert run.returncode != 0\\n    assert \\\"ci\\\" in run.stdout and \\\"failure\\\" in run.stdout\\n    assert elapsed < 0.4, (\\n        f\\\"a concluded, red forge check should stop on the first read with no \\\"\\n        f\\\"poll interval slept -- took {elapsed:.2f}s\\\")\\n\\n    assert record_files(root, \\\"verify\\\") == []\\n    assert head_of(root) == pre_head\\n\\n    # Idempotence (row 8): running again in the same red state stops the\\n    # same way, still nothing written.\\n    run2 = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run2.returncode != 0\\n    assert record_files(root, \\\"verify\\\") == []\\n    assert head_of(root) == pre_head\\n\\n\\ndef test_drive_polls_the_bound_while_the_forge_is_still_running(tmp_path):\\n    \\\"\\\"\\\"Acceptance row 4, the unconcluded case: a check still carrying a\\n    status (in_progress) rather than a conclusion is not yet red -- drive\\n    keeps polling it for the full bound before giving up, unlike a\\n    concluded red check, which it does not poll at all. Writes nothing.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, UNCONCLUDED_FORGE)\\n    add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n\\n    assert run_attavo(root, \\\"drive\\\", \\\"1\\\").returncode == 0  # builds\\n\\n    started = time.monotonic()\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    elapsed = time.monotonic() - started\\n    assert run.returncode != 0\\n    assert \\\"ci\\\" in run.stdout and \\\"in_progress\\\" in run.stdout\\n    assert elapsed >= 0.4, (\\n        f\\\"a check still in_progress should be polled for the bound, not \\\"\\n        f\\\"stopped on the first read -- took only {elapsed:.2f}s\\\")\\n\\n    assert record_files(root, \\\"verify\\\") == []\\n\\n\\ndef test_drive_halts_on_a_question_and_resumes_at_build_after_a_ruling(tmp_path):\\n    \\\"\\\"\\\"Acceptance row 5. The fixture adapter halts with a question: drive\\n    stops naming the question and the record (and still pushes that\\n    halted record, same as any other record build writes). After a\\n    ruling is appended, a second run resumes at build and this time\\n    passes.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    bare = add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\",\\n                     env={\\\"ATTAVO_FIXTURE_QUESTION\\\": \\\"which overlay wins?\\\"})\\n    assert run.returncode == 3\\n    assert \\\"which overlay wins?\\\" in run.stdout\\n\\n    rec = latest_record(root, \\\"build\\\")\\n    assert rec[\\\"status\\\"] == \\\"halted\\\"\\n    assert rec[\\\"halted\\\"] == {\\\"question\\\": \\\"which overlay wins?\\\"}\\n    record_path = record_files(root, \\\"build\\\")[-1]\\n    assert record_path.name in run.stdout\\n\\n    # The halted record was still committed and pushed.\\n    assert remote_head(bare, branch) == head_of(root)\\n\\n    rulings = root / \\\"rulings.md\\\"\\n    rulings.write_text(rulings.read_text() + \\\"\\\\n- overlay: use the base tree\\\\n\\\"\\n                       if rulings.exists() else \\\"- overlay: use the base tree\\\\n\\\")\\n    commit_all(root, \\\"rule on the overlay question\\\")\\n    git(root, \\\"push\\\", \\\"origin\\\", f\\\"HEAD:{branch}\\\")\\n\\n    run2 = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run2.returncode == 0, run2.stdout + run2.stderr\\n\\n    assert len(record_files(root, \\\"build\\\")) == 2\\n    rec2 = latest_record(root, \\\"build\\\")\\n    assert rec2[\\\"status\\\"] == \\\"pass\\\"\\n    assert remote_head(bare, branch) == head_of(root)\\n\\n\\ndef configure_counsel(root: Path) -> None:\\n    \\\"\\\"\\\"[executor].counsel = \\\"fixture\\\" -- build_valid's own manifest\\n    declares [executor].build = \\\"fixture\\\" only; counsel needs its own\\n    adapter named (issue #100).\\\"\\\"\\\"\\n    toml = root / \\\"attavo.toml\\\"\\n    toml.write_text(toml.read_text().replace(\\n        '[executor]\\\\nbuild = \\\"fixture\\\"', '[executor]\\\\nbuild = \\\"fixture\\\"\\\\ncounsel = \\\"fixture\\\"'))\\n    commit_all(root, \\\"configure the counsel adapter\\\")\\n\\n\\ndef test_drive_counsels_a_stop_before_filing_it_and_commits_both_records_together(tmp_path):\\n    \\\"\\\"\\\"Issue #100, acceptance row 3. On a stop, drive calls counsel\\n    before file-stops, and commits the counsel record with the stage\\n    record in one commit.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    bare = add_bare_remote(root, tmp_path)\\n    configure_counsel(root)\\n    approve_item(root)\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n    filed = tmp_path / \\\"filed.jsonl\\\"\\n    configure_filing(root, filed)\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\",\\n                     env={\\\"ATTAVO_FIXTURE_QUESTION\\\": \\\"which overlay wins?\\\"})\\n    assert run.returncode == 3\\n\\n    assert record_files(root, \\\"counsel\\\")\\n    counsel_rec = latest_record(root, \\\"counsel\\\")\\n    assert counsel_rec[\\\"record_stage\\\"] == \\\"build\\\"\\n    assert counsel_rec[\\\"record\\\"] == \\\"build-01\\\"\\n    assert counsel_rec[\\\"verdict\\\"] == \\\"person\\\"\\n\\n    committed = set(last_commit_paths(root))\\n    assert committed == {\\n        \\\"records/1/build-01.json\\\", \\\"records/1/build-01.log\\\",\\n        \\\"records/1/counsel-01.json\\\", \\\"records/1/counsel-01.log\\\",\\n        \\\"records/1/build-01.filed\\\",\\n    }\\n    assert remote_head(bare, branch) == head_of(root)\\n\\n    filed_bodies = [json.loads(l) for l in filed.read_text().splitlines() if l.strip()]\\n    assert len(filed_bodies) == 1\\n    assert filed_bodies[0][\\\"counsel_verdict\\\"] == \\\"person\\\"\\n    assert filed_bodies[0][\\\"counsel_proposal\\\"][\\\"question\\\"]\\n\\n\\ndef test_drive_still_files_a_stop_with_no_counsel_adapter_configured(tmp_path):\\n    \\\"\\\"\\\"counsel refuses gracefully (no [executor].counsel or\\n    [executor].verify) -- drive still files and transports the stage\\n    record; nothing new for counsel to commit.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    bare = add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n    filed = tmp_path / \\\"filed.jsonl\\\"\\n    configure_filing(root, filed)\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\",\\n                     env={\\\"ATTAVO_FIXTURE_QUESTION\\\": \\\"which overlay wins?\\\"})\\n    assert run.returncode == 3\\n\\n    assert record_files(root, \\\"counsel\\\") == []\\n    committed = set(last_commit_paths(root))\\n    assert committed == {\\\"records/1/build-01.json\\\", \\\"records/1/build-01.log\\\",\\n                         \\\"records/1/build-01.filed\\\"}\\n    assert remote_head(bare, branch) == head_of(root)\\n\\n\\ndef configure_filing(root: Path, filed_path: Path) -> None:\\n    \\\"\\\"\\\"Appended under the [forge] table add_forge already opened -- a\\n    second [forge] header in the same file is a TOML redeclaration\\n    error. Prints a fake issue URL on stdout, numbered by filed_path's\\n    own line count so far -- the fact a real file_issue_command's stdout\\n    would carry, and what the .filed marker beside each stop record is\\n    meant to hold (issue #89).\\\"\\\"\\\"\\n    toml = root / \\\"attavo.toml\\\"\\n    command = (f\\\"n=$(wc -l < {filed_path} 2>/dev/null || echo 0); \\\"\\n              f\\\"cat >> {filed_path}; \\\"\\n              f\\\"echo https://github.com/tenant/repo/issues/$((n + 1))\\\")\\n    toml.write_text(toml.read_text() + f\\\"\\\\nfile_issue_command = '{command}'\\\\n\\\")\\n    commit_all(root, \\\"configure issue filing\\\")\\n\\n\\ndef test_drive_files_a_stop_it_reports_exactly_once(tmp_path):\\n    \\\"\\\"\\\"Issue #89, acceptance row 5. A stop drive reports -- here, the\\n    fixture adapter's halt -- calls file-stops once: one drive run files\\n    exactly one issue for the attempt it just wrote, not zero and not\\n    more than one.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n    filed = tmp_path / \\\"filed.jsonl\\\"\\n    configure_filing(root, filed)\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\",\\n                     env={\\\"ATTAVO_FIXTURE_QUESTION\\\": \\\"which overlay wins?\\\"})\\n    assert run.returncode == 3\\n\\n    filed_bodies = [json.loads(l) for l in filed.read_text().splitlines() if l.strip()]\\n    assert len(filed_bodies) == 1\\n    assert filed_bodies[0][\\\"record\\\"] == \\\"records/1/build-01.json\\\"\\n\\n    # A second drive run halts again -- a new attempt, build-02 -- and\\n    # files exactly one more issue for that new record; file-stops' own\\n    # .filed marker means build-01's issue is never filed twice.\\n    run2 = run_attavo(root, \\\"drive\\\", \\\"1\\\",\\n                      env={\\\"ATTAVO_FIXTURE_QUESTION\\\": \\\"which overlay wins?\\\"})\\n    assert run2.returncode == 3\\n    assert len(record_files(root, \\\"build\\\")) == 2\\n\\n    filed_bodies_after = [json.loads(l) for l in filed.read_text().splitlines() if l.strip()]\\n    assert len(filed_bodies_after) == 2\\n    assert filed_bodies_after[0] == filed_bodies[0]\\n    assert filed_bodies_after[1][\\\"record\\\"] == \\\"records/1/build-02.json\\\"\\n\\n\\ndef test_drive_marker_holds_the_filing_commands_stdout_and_is_committed_with_the_record(tmp_path):\\n    \\\"\\\"\\\"A stop's own .filed marker is written before the record is\\n    transported, so it carries the filing command's stdout (the issue it\\n    opened) and rides in the very same commit as the record and its log\\n    -- one commit, one push, as before this fix. Red before it: the\\n    marker was written empty, after commit_record and push_record_commit\\n    had already run, so it was never part of any commit at all.\\n    \\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    bare = add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n    filed = tmp_path / \\\"filed.jsonl\\\"\\n    configure_filing(root, filed)\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\",\\n                     env={\\\"ATTAVO_FIXTURE_QUESTION\\\": \\\"which overlay wins?\\\"})\\n    assert run.returncode == 3\\n\\n    marker_path = records_dir(root) / \\\"build-01.filed\\\"\\n    assert marker_path.is_file()\\n    assert marker_path.read_text().strip() == \\\"https://github.com/tenant/repo/issues/1\\\"\\n\\n    committed = set(last_commit_paths(root))\\n    assert committed == {\\\"records/1/build-01.json\\\", \\\"records/1/build-01.log\\\",\\n                         \\\"records/1/build-01.filed\\\"}\\n    assert remote_head(bare) == head_of(root)\\n\\n\\ndef test_drive_a_second_run_in_the_same_state_files_nothing(tmp_path):\\n    \\\"\\\"\\\"Issue #89. The marker committed and pushed above is the fact a\\n    second worktree or a fresh clone reads too -- a second drive run\\n    against the same records, from a fresh clone of the remote drive\\n    already pushed to, files nothing for the stop that clone already\\n    carries a marker for. Red before this fix: the marker never reached\\n    the remote at all, so every clone refiled every stop it found.\\n    \\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    bare = add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n    filed = tmp_path / \\\"filed.jsonl\\\"\\n    configure_filing(root, filed)\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\",\\n                     env={\\\"ATTAVO_FIXTURE_QUESTION\\\": \\\"which overlay wins?\\\"})\\n    assert run.returncode == 3\\n    filed_after_first = filed.read_text()\\n    assert filed_after_first.strip() != \\\"\\\"\\n\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n    clone = tmp_path / \\\"fresh-clone\\\"\\n    subprocess.run([\\\"git\\\", \\\"clone\\\", \\\"--quiet\\\", \\\"--branch\\\", branch, str(bare), str(clone)],\\n                   check=True)\\n\\n    run2 = run_attavo(clone, \\\"file-stops\\\", \\\"1\\\")\\n    assert run2.returncode == 0\\n    assert \\\"no stops to file\\\" in run2.stdout\\n    assert filed.read_text() == filed_after_first  # nothing new was filed\\n\\n\\ndef test_drive_retries_a_rejected_push_with_a_merge_never_a_rebase(tmp_path):\\n    \\\"\\\"\\\"Acceptance row 7. A rejected push with a divergent remote is\\n    retried after `git pull --no-rebase --no-edit`, never a rebase; the\\n    build record's own sha is unchanged (still reachable, still what the\\n    record names), and the retry lands a merge commit, not a rewritten\\n    one.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    bare = add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n\\n    # Diverge the bare remote: another clone pushes an unrelated commit to\\n    # the same branch before drive's own push happens.\\n    other = tmp_path / \\\"other-clone\\\"\\n    subprocess.run([\\\"git\\\", \\\"clone\\\", \\\"--quiet\\\", str(bare), str(other)], check=True)\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(other), \\\"checkout\\\", \\\"-q\\\", branch], check=True)\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(other), \\\"config\\\", \\\"user.email\\\", \\\"other@example.com\\\"],\\n                   check=True)\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(other), \\\"config\\\", \\\"user.name\\\", \\\"Other\\\"], check=True)\\n    (other / \\\"concurrent.txt\\\").write_text(\\\"from elsewhere\\\\n\\\")\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(other), \\\"add\\\", \\\"-A\\\"], check=True)\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(other), \\\"commit\\\", \\\"-q\\\", \\\"-m\\\", \\\"a concurrent commit\\\"],\\n                   check=True)\\n    subprocess.run([\\\"git\\\", \\\"-C\\\", str(other), \\\"push\\\", \\\"origin\\\", f\\\"HEAD:{branch}\\\"], check=True)\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n\\n    rec = latest_record(root, \\\"build\\\")\\n    assert rec[\\\"status\\\"] == \\\"pass\\\"\\n    build_sha = rec[\\\"sha\\\"]\\n\\n    # The build's own commit sha is still reachable -- a merge, not a\\n    # rebase, which would have rewritten it under a new sha.\\n    assert build_sha in git(root, \\\"rev-list\\\", \\\"HEAD\\\").split()\\n\\n    # The retry landed a merge commit somewhere in history, not\\n    # necessarily at HEAD -- the invocation marker's own push is the one\\n    # that met the divergent remote and retried; the build record's own\\n    # push, once the branches were already merged, needed no retry of\\n    # its own.\\n    assert git(root, \\\"rev-list\\\", \\\"--merges\\\", \\\"HEAD\\\").split(), \\\\\\n        \\\"the retry should have landed a merge commit\\\"\\n\\n    assert remote_head(bare, branch) == head_of(root)\\n    # the concurrent commit from the other clone is present too\\n    assert \\\"concurrent.txt\\\" in git(root, \\\"ls-tree\\\", \\\"-r\\\", \\\"--name-only\\\", \\\"HEAD\\\")\\n\\n\\ndef add_drive_stall_bound(root: Path, seconds: int) -> None:\\n    toml = root / \\\"attavo.toml\\\"\\n    toml.write_text(toml.read_text() + f\\\"\\\\n[drive]\\\\nstall_after_s = {seconds}\\\\n\\\")\\n    commit_all(root, \\\"configure the drive stall bound\\\")\\n\\n\\ndef test_drive_writes_and_pushes_an_invocation_marker_before_running_the_stage(tmp_path):\\n    \\\"\\\"\\\"Issue #151. Before running build, drive writes a build-01.started\\n    marker and commits and pushes it by itself -- the fact that this\\n    invocation began is on the branch before the adapter ever runs, so a\\n    process that dies mid-build still leaves it behind.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    bare = add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n\\n    marker_path = records_dir(root) / \\\"build-01.started\\\"\\n    assert marker_path.is_file()\\n    info = json.loads(marker_path.read_text())\\n    assert info[\\\"pid\\\"] > 0 and info[\\\"host\\\"] and info[\\\"sha\\\"]\\n\\n    # The marker's own commit precedes the record's own commit; both\\n    # reached the remote.\\n    marker_commit = git(root, \\\"log\\\", \\\"-1\\\", \\\"--format=%H\\\",\\n                        \\\"--\\\", \\\"records/1/build-01.started\\\").strip()\\n    record_commit = git(root, \\\"log\\\", \\\"-1\\\", \\\"--format=%H\\\",\\n                        \\\"--\\\", \\\"records/1/build-01.json\\\").strip()\\n    assert marker_commit != record_commit\\n    is_ancestor = subprocess.run(\\n        [\\\"git\\\", \\\"-C\\\", str(root), \\\"merge-base\\\", \\\"--is-ancestor\\\", marker_commit, record_commit],\\n        check=False)\\n    assert is_ancestor.returncode == 0, \\\"the marker's commit should precede the record's\\\"\\n    assert remote_head(bare, branch) == head_of(root)\\n\\n\\ndef test_drive_recover_writes_a_died_record_for_a_dead_marker(tmp_path):\\n    \\\"\\\"\\\"Issue #151, acceptance row 2. A marker naming a dead pid on this\\n    host, with no record beside it, is recovered as a failed record, stop\\n    class died, provenance product, committed by the driver identity with\\n    a clean tree -- the fixture #148 left behind by hand, done here by\\n    the product instead.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_drive_stall_bound(root, 60)\\n    bare = add_bare_remote(root, tmp_path)\\n\\n    dead = subprocess.Popen([sys.executable, \\\"-c\\\", \\\"pass\\\"])\\n    dead.wait()\\n    marker = records_dir(root) / \\\"build-01.started\\\"\\n    marker.parent.mkdir(parents=True, exist_ok=True)\\n    marker.write_text(json.dumps({\\\"at\\\": \\\"2026-09-17T13:16:08Z\\\", \\\"host\\\": socket.gethostname(),\\n                                  \\\"pid\\\": dead.pid, \\\"sha\\\": head_of(root),\\n                                  \\\"product_version\\\": \\\"fixture\\\"}))\\n    commit_all(root, \\\"invocation marker for item 1\\\")\\n\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\", \\\"--recover\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n\\n    rec = latest_record(root, \\\"build\\\")\\n    assert rec[\\\"status\\\"] == \\\"failed\\\"\\n    assert rec[\\\"stop\\\"][\\\"class\\\"] == \\\"died\\\"\\n    assert rec[\\\"stop\\\"][\\\"provenance\\\"] == \\\"product\\\"\\n    assert \\\"wrote no build-01.json\\\" in rec[\\\"stop\\\"][\\\"detail\\\"]\\n\\n    assert (records_dir(root) / \\\"build-01.log\\\").is_file()\\n    assert git(root, \\\"log\\\", \\\"-1\\\", \\\"--format=%an\\\").strip() == \\\"attavo driver\\\"\\n    assert git(root, \\\"status\\\", \\\"--porcelain\\\").strip() == \\\"\\\"\\n    assert remote_head(bare) == head_of(root)\\n\\n\\ndef test_drive_recover_leaves_a_live_invocation_alone(tmp_path):\\n    \\\"\\\"\\\"A marker naming a live, unrelated pid on this host, started just\\n    now -- well inside the stall bound -- is running, not died: recover\\n    writes nothing. A real subprocess, never this test's own pid: were it\\n    ever judged hung, recover would SIGTERM the pid the marker names.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_drive_stall_bound(root, 3600)\\n\\n    alive = subprocess.Popen([sys.executable, \\\"-c\\\", \\\"import time; time.sleep(30)\\\"])\\n    try:\\n        marker = records_dir(root) / \\\"build-01.started\\\"\\n        marker.parent.mkdir(parents=True, exist_ok=True)\\n        marker.write_text(json.dumps(\\n            {\\\"at\\\": datetime.now(timezone.utc).strftime(\\\"%Y-%m-%dT%H:%M:%SZ\\\"),\\n             \\\"host\\\": socket.gethostname(), \\\"pid\\\": alive.pid, \\\"sha\\\": head_of(root),\\n             \\\"product_version\\\": \\\"fixture\\\"}))\\n        commit_all(root, \\\"invocation marker for a live pid\\\")\\n\\n        run = run_attavo(root, \\\"drive\\\", \\\"1\\\", \\\"--recover\\\")\\n        assert run.returncode == 0, run.stdout + run.stderr\\n        assert \\\"nothing to recover\\\" in run.stdout\\n        assert record_files(root, \\\"build\\\") == []\\n    finally:\\n        alive.terminate()\\n        alive.wait()\\n\\n\\ndef test_drive_forge_poll_defaults_are_a_real_forges_clock():\\n    \\\"\\\"\\\"The bound and interval every other test overrides with\\n    FAST_POLL_ENV default, unset, to at least five minutes and ten\\n    seconds -- tenant zero's own checks conclude about five minutes after\\n    a push, and a bound shorter than that would make every drive run\\n    after a record push stop on 'forge checks not green', with a person\\n    running it again after CI: exactly the transport act this lane\\n    retires. Row 4 (a forge that never goes green) is unchanged in\\n    meaning by this -- it still stops, just after waiting out a real\\n    forge's own clock instead of a test's fake one.\\n    \\\"\\\"\\\"\\n    module = attavo_module()\\n    assert module.DRIVE_FORGE_POLL_BOUND_DEFAULT_S >= 300\\n    assert module.DRIVE_FORGE_POLL_INTERVAL_DEFAULT_S >= 10\\n\",\"structuredPatch\":[{\"oldStart\":18,\"oldLines\":6,\"newStart\":18,\"newLines\":7,\"lines\":[\" import subprocess\",\" import sys\",\" import time\",\"+from datetime import datetime, timezone\",\" from pathlib import Path\",\" \",\" from helpers import commit_all, git, make_tenant\"]}],\"userModified\":false,\"replaceAll\":false}}\nattest/records/151/build-03.log:784:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01K5z7mXH4mr1DLtDuXBDGNa\",\"type\":\"tool_result\",\"content\":\"=== attest/specs/151/criteria/died-and-hung-are-stop-classes.sh ===\\nPASS\\n=== attest/specs/151/criteria/doctor-fails-on-an-invocation-without-record.sh ===\\nmktemp: mkdtemp failed on /var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp.dRYiWCPVoW: Operation not permitted\\nFAIL\\n=== attest/specs/151/criteria/recover-writes-a-died-record.sh ===\\nmktemp: mkdtemp failed on /var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp.2Sc1qOjSZ3: Operation not permitted\\nFAIL\",\"is_error\":false}]},\"parent_tool_use_id\":null,\"session_id\":\"f081a203-e2ee-47b3-8bf8-5fc3aaeb804d\",\"uuid\":\"c63bdd53-d6f4-4417-bce5-83dfbd036051\",\"timestamp\":\"2026-09-17T20:02:48.499Z\",\"tool_use_result\":{\"stdout\":\"=== attest/specs/151/criteria/died-and-hung-are-stop-classes.sh ===\\nPASS\\n=== attest/specs/151/criteria/doctor-fails-on-an-invocation-without-record.sh ===\\nmktemp: mkdtemp failed on /var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp.dRYiWCPVoW: Operation not 
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"shasum -a 256 /var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmpx_ny1sy5/diff.patch && sed -n '1,110p' /var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmpx_ny1sy5/diff.patch && sed -n '7910,8295p' /var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmpx_ny1sy5/diff.patch\"","aggregated_output":"8e9e76a21da40495ec0d1d8465b74115f8e373902b01ad6c321571ab1482ba66  /var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmpx_ny1sy5/diff.patch\ndiff --git a/.attavo/bin/forge-attestation b/.attavo/bin/forge-attestation\nnew file mode 100755\nindex 0000000..46fce25\n--- /dev/null\n+++ b/.attavo/bin/forge-attestation\n@@ -0,0 +1,25 @@\n+#!/bin/sh\n+# forge-attestation: [forge].attestation_command for attavo doctor's fifth\n+# proof (issue #158).\n+#\n+# Reads a merge commit sha on stdin. actions/attest@v2, in\n+# .github/workflows/attavo-coherence.yml, signs the merge's attestation\n+# statement over a synthetic subject: the sha256 digest of the merge\n+# sha's own text (deterministic and reproducible from the sha alone, since\n+# the statement is sealed before the artifact -- the merge -- has landed\n+# anywhere to be hashed itself). This script re-derives that same digest\n+# and reads it back from the forge's attestation store, printing the\n+# statement's predicate payload as JSON on exit 0. It prints nothing and\n+# exits non-zero when the store holds no attestation for that digest, or\n+# the sha is empty, or `gh` cannot resolve this checkout's repository.\n+#\n+# Usage: read sha | forge-attestation\n+# Requires: `gh`, authenticated, run inside this repository's checkout.\n+set -e\n+read -r sha\n+test -n \"$sha\" || exit 2\n+digest=$(printf '%s' \"$sha\" | shasum -a 256 | cut -d ' ' -f 1)\n+repo=$(gh repo view --json nameWithOwner --jq .nameWithOwner 2>/dev/null) || exit 2\n+payload=$(gh api \"repos/$repo/attestations/sha256:$digest\" --jq '.attestations[0].bundle.dsseEnvelope.payload' 2>/dev/null) || exit 1\n+test -n \"$payload\" && test \"$payload\" != null || exit 1\n+printf '%s' \"$payload\" | base64 -d\ndiff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml\nindex 8c56694..d2051ce 100644\n--- a/.github/workflows/ci.yml\n+++ b/.github/workflows/ci.yml\n@@ -20,10 +20,11 @@ jobs:\n           --deselect tests/test_doctor.py::test_one_item_traversed_every_stage\n           --deselect tests/test_doctor.py::test_no_commit_lacks_a_record\n           --deselect tests/test_doctor.py::test_no_stop_lacks_cause\n+          --deselect tests/test_doctor.py::test_every_attested_item_is_sealed\n \n   # Since #103, this repository is Attavo's own second tenant (attavo.toml\n-  # at the root) and the doctor's four proofs run for real, not under\n-  # || true. #106's first item merged (fdd1981, v0.18.0), so the four\n+  # at the root) and the doctor's five proofs run for real, not under\n+  # || true. #106's first item merged (fdd1981, v0.18.0), so the five\n   # proofs hold on main and this job reports on pull requests and merge\n   # groups too -- where a refusal is cheap. It does not report on a\n   # branch push: a branch's own boundary commits precede their records,\n@@ -31,6 +32,17 @@ jobs:\n   doctor:\n     if: github.event_name == 'pull_request' || github.event_name == 'merge_group' || github.ref == 'refs/heads/main'\n     runs-on: ubuntu-latest\n+    permissions:\n+      contents: read\n+      attestations: read\n+    env:\n+      # issue #158, amended after build-05: every step that runs the\n+      # doctor -- the pytest step and the bin/attavo invocation both --\n+      # reads the attestation store through [forge].attestation_command,\n+      # which shells out to `gh`. A token scoped to only the last step\n+      # left the pytest step reading an unauthenticated store, which\n+      # exits 2 (not read), not the 404 (unsealed) the proof expects.\n+      GH_TOKEN: ${{ github.token }}\n     steps:\n       - uses: actions/checkout@v4\n         with:\n@@ -44,8 +56,8 @@ jobs:\n         with:\n           python-version: \"3.11\"\n       - run: pip install pytest jsonschema\n-      - name: doctor's four proofs\n-        run: python3 -m pytest tests/test_doctor.py -q -k \"every_gate_rejects or one_item_traversed_every_stage or no_commit_lacks_a_record or no_stop_lacks_cause\"\n+      - name: doctor's five proofs\n+        run: python3 -m pytest tests/test_doctor.py -q -k \"every_gate_rejects or one_item_traversed_every_stage or no_commit_lacks_a_record or no_stop_lacks_cause or every_attested_item_is_sealed\"\n       - run: python3 bin/attavo doctor .\n \n   action-self-check:\ndiff --git a/attavo.toml b/attavo.toml\nindex 07099f7..1184e61 100644\n--- a/attavo.toml\n+++ b/attavo.toml\n@@ -6,6 +6,8 @@ version = \"v0.25.0\"\n [forge]\n checks_command = \"python3 .attavo/bin/forge-checks\"\n file_issue_command = \"python3 .attavo/bin/file-issue\"\n+attestation_command = \"sh .attavo/bin/forge-attestation\"\n+sealed_since = \"83fcbc6863fdb65956b77768c66c2103d221521b\"\n \n [executor]\n build = \"claude-code\"\n@@ -33,7 +35,7 @@ retires = [\n \n [tests]\n select = \"python3 .attavo/bin/select-tests\"\n-run = \"xargs -r python3 -m pytest -q --deselect tests/test_doctor.py::test_every_gate_rejects --deselect tests/test_doctor.py::test_one_item_traversed_every_stage --deselect tests/test_doctor.py::test_no_commit_lacks_a_record --deselect tests/test_doctor.py::test_no_stop_lacks_cause\"\n+run = \"xargs -r python3 -m pytest -q --deselect tests/test_doctor.py::test_every_gate_rejects --deselect tests/test_doctor.py::test_one_item_traversed_every_stage --deselect tests/test_doctor.py::test_no_commit_lacks_a_record --deselect tests/test_doctor.py::test_no_stop_lacks_cause --deselect tests/test_doctor.py::test_every_attested_item_is_sealed\"\n \n [paths]\n specs = \"attest/specs\"\n@@ -45,7 +47,7 @@ rejections = \"attest/rejections\"\n approvers = [\"dbean10\"]\n \n [checks]\n-command = \"python3 -m pytest tests -q --deselect tests/test_doctor.py::test_every_gate_rejects --deselect tests/test_doctor.py::test_one_item_traversed_every_stage --deselect tests/test_doctor.py::test_no_commit_lacks_a_record --deselect tests/test_doctor.py::test_no_stop_lacks_cause\"\n+command = \"python3 -m pytest tests -q --deselect tests/test_doctor.py::test_every_gate_rejects --deselect tests/test_doctor.py::test_one_item_traversed_every_stage --deselect tests/test_doctor.py::test_no_commit_lacks_a_record --deselect tests/test_doctor.py::test_no_stop_lacks_cause --deselect tests/test_doctor.py::test_every_attested_item_is_sealed\"\n \n [drive]\n stall_after_s = 1800\ndiff --git a/attest/records/158/approval-01.json b/attest/records/158/approval-01.json\n+    assert not p[\"holds\"] and \"attestation_command\" in p[\"reason\"]\ndiff --git a/bin/attavo b/bin/attavo\nindex 708972d..9f54be6 100755\n--- a/bin/attavo\n+++ b/bin/attavo\n@@ -16,7 +16,7 @@\n     attavo ledger [N] [--json]\n     attavo stops [N] [--json]\n \n-The doctor is the definition of done. It asserts four proofs against a\n+The doctor is the definition of done. It asserts five proofs against a\n tenant root and exits 1 until every proof holds:\n \n   1. every-gate-rejects      every gate in the manifest's [gates] table,\n@@ -42,6 +42,16 @@ tenant root and exits 1 until every proof holds:\n                              adapter exit ended the log -- records before\n                              record_version 3 are counted and reported,\n                              never refused\n+  5. every-attested-item-is-sealed\n+                             every merged item that carries a record for\n+                             every stage has a statement in the forge's\n+                             attestation store for its merge commit, read\n+                             through [forge].attestation_command -- a\n+                             merge at or before [forge].sealed_since is\n+                             named as before the window instead of failed.\n+                             [forge].attestation_command exiting 2 means\n+                             the store itself could not be read, reported\n+                             as not_read by item and never as unsealed\n \n Nothing in doctor is a gate. The doctor reads; it never writes and it never\n blocks a merge by itself. It is what CI runs to say whether the product\n@@ -1398,13 +1408,103 @@ def proof_no_stop_lacks_cause(root: Path, m: dict | None) -> Proof:\n                  older_records=older)\n \n \n+def attestation_command(m: dict) -> str | None:\n+    \"\"\"[forge].attestation_command: the tenant's own read of the store,\n+    given a merge sha on stdin, printing the statement as JSON on exit 0\n+    and nothing on a non-zero exit. Absent is not passing (issue #158:\n+    the doctor said done while #106, #148, #153 had no statement in the\n+    store at all -- there was no key to read one through).\"\"\"\n+    cmd = (m.get(\"forge\") or {}).get(\"attestation_command\")\n+    return cmd if isinstance(cmd, str) and cmd.strip() else None\n+\n+\n+def statement_for(root: Path, cmd: str, merge_sha: str) -> tuple[dict | None, int]:\n+    \"\"\"The statement the forge holds for merge_sha and the command's exit\n+    code. The statement is None when the command exits non-zero or prints\n+    anything but a JSON object -- exit 2 means the store itself could not\n+    be read (issue #158, amended after build-05: distinct from exit 1,\n+    the store read fine and simply held no statement).\"\"\"\n+    run = subprocess.run(cmd, shell=True, cwd=str(root), input=merge_sha + \"\\n\",\n+                         capture_output=True, text=True, check=False)\n+    if run.returncode != 0:\n+        return None, run.returncode\n+    try:\n+        parsed = json.loads(run.stdout)\n+    except ValueError:\n+        return None, run.returncode\n+    return (parsed if isinstance(parsed, dict) else None), run.returncode\n+\n+\n+def _is_ancestor(root: Path, earlier: str, later: str) -> bool:\n+    run = subprocess.run([\"git\", \"-C\", str(root), \"merge-base\", \"--is-ancestor\", earlier, later],\n+                         capture_output=True, check=False)\n+    return run.returncode == 0\n+\n+\n+def proof_every_attested_item_is_sealed(root: Path, m: dict | None) -> Proof:\n+    p = Proof(\"every-attested-item-is-sealed\", \"every attested item has its statement in the store\")\n+    if m is None:\n+        return p.fail(f\"no {MANIFEST} at {root}; no records directory is declared\")\n+    cmd = attestation_command(m)\n+    if cmd is None:\n+        return p.fail(\"no [forge].attestation_command in the manifest; the store cannot be read\")\n+    records_rel = m.get(\"paths\", {}).get(\"records\", \"\")\n+    records_dir = root / records_rel\n+    if not records_dir.is_dir():\n+        return p.fail(f\"no records directory under {records_dir}\")\n+    items = load_records(records_dir)\n+    complete = [item for item, stages in sorted(items.items()) if all(s in stages for s in STAGES)]\n+\n+    # [forge].sealed_since: merges at or before this sha predate the\n+    # tenant's merge queue -- the self-tenant's own #106, #148, #153 were\n+    # merged direct, with no merge_group run to seal them. They are\n+    # named, never failed, the same window convention proof three keeps\n+    # for commits before the manifest's own install.\n+    since = (m.get(\"forge\") or {}).get(\"sealed_since\")\n+    merges, refusal = _merges_reachable(root)\n+    if refusal:\n+        return p.fail(refusal)\n+    sealed: list[str] = []\n+    before_window: list[str] = []\n+    unsealed: list[str] = []\n+    not_merged: list[str] = []\n+    not_read: list[str] = []\n+    reasons: list[str] = []\n+    for item in complete:\n+        merge_sha, _ = merge_introducing_records(root, records_rel, item, STAGES, merges=merges)\n+        if merge_sha is None:\n+            not_merged.append(item)\n+            continue\n+        if isinstance(since, str) and since.strip() and _is_ancestor(root, merge_sha, since):\n+            before_window.append(item)\n+            continue\n+        statement, exit_code = statement_for(root, cmd, merge_sha)\n+        if statement is not None:\n+            sealed.append(item)\n+        elif exit_code == 2:\n+            not_read.append(item)\n+            reasons.append(f\"item {item} merged at {merge_sha[:12]}: not read -- \"\n+                           f\"the store could not be read; {cmd!r} exited 2\")\n+        else:\n+            unsealed.append(item)\n+            reasons.append(f\"item {item} merged at {merge_sha[:12]} has no statement in the store\")\n+    if reasons:\n+        return p.fail(\"; \".join(reasons), sealed=sealed, before_window=before_window,\n+                      unsealed=unsealed, not_merged=not_merged, not_read=not_read)\n+    return p.hold(f\"{len(sealed)} merged item(s) sealed, {len(before_window)} before the window, \"\n+                 f\"{len(not_merged)} not merged\",\n+                 sealed=sealed, before_window=before_window, unsealed=unsealed,\n+                 not_merged=not_merged, not_read=not_read)\n+\n+\n def doctor(root: Path) -> list[Proof]:\n     m = read_manifest(root)\n     return [proof_every_gate_rejects(root, m),\n             proof_one_item_every_stage(root, m),\n             proof_no_commit_lacks_record(root, m),\n             proof_no_stop_lacks_cause(root, m),\n-            proof_no_invocation_lacks_record(root, m)]\n+            proof_no_invocation_lacks_record(root, m),\n+            proof_every_attested_item_is_sealed(root, m)]\n \n \n def cmd_doctor(argv: list[str]) -> int:\ndiff --git a/schema/manifest.schema.json b/schema/manifest.schema.json\nindex 1f7fe52..b37b069 100644\n--- a/schema/manifest.schema.json\n+++ b/schema/manifest.schema.json\n@@ -88,6 +88,16 @@\n           \"type\": \"string\",\n           \"description\": \"Reads one finding as JSON on stdin and files it as a tenant issue. attavo file-findings runs it once per finding in the item's latest verify record.\",\n           \"minLength\": 1\n+        },\n+        \"attestation_command\": {\n+          \"type\": \"string\",\n+          \"description\": \"Reads a merge commit sha on stdin and prints that merge's attestation statement as JSON on exit 0; nothing on a non-zero exit. The doctor's fifth proof runs it once per merged, fully-staged item to require a statement in the store.\",\n+          \"minLength\": 1\n+        },\n+        \"sealed_since\": {\n+          \"type\": \"string\",\n+          \"description\": \"A commit sha. A merge at or before it predates the tenant's merge queue and is named by the doctor's fifth proof as before the window rather than failed.\",\n+          \"minLength\": 7\n         }\n       }\n     },\ndiff --git a/tests/test_doctor.py b/tests/test_doctor.py\nindex 37c82de..b3869ca 100644\n--- a/tests/test_doctor.py\n+++ b/tests/test_doctor.py\n@@ -1,6 +1,6 @@\n-\"\"\"The doctor's four proofs, as tests written before the capability.\n+\"\"\"The doctor's five proofs, as tests written before the capability.\n \n-Each test asserts that one proof holds against this repository. All four\n+Each test asserts that one proof holds against this repository. All five\n fail at the first commit and must fail: that is the definition of done,\n stated before anything exists to satisfy it. A test here turns green only\n when the capability it names has landed and been used for real.\n@@ -68,6 +68,15 @@ def test_no_invocation_lacks_record():\n     assert p[\"holds\"], p[\"reason\"]\n \n \n+def test_every_attested_item_is_sealed():\n+    \"\"\"Proof 5, issue #158. Every merged, fully-staged item has a\n+    statement in the forge's attestation store for its merge commit --\n+    #106, #148, #153 predate [forge].sealed_since and are named before the\n+    window instead.\"\"\"\n+    p = run_doctor(ROOT)[\"every-attested-item-is-sealed\"]\n+    assert p[\"holds\"], p[\"reason\"]\n+\n+\n def test_record_loader_uses_highest_attempt_number(tmp_path):\n     \"\"\"Acceptance 2a. <stage>-NN.json files are one stage's attempts; the\n     doctor treats the highest NN as latest, and STAGES is unchanged.\ndiff --git a/tests/test_doctor_sealed.py b/tests/test_doctor_sealed.py\nnew file mode 100644\nindex 0000000..3a3bb25\n--- /dev/null\n+++ b/tests/test_doctor_sealed.py\n@@ -0,0 +1,169 @@\n+\"\"\"The doctor's fifth proof: every attested item has its statement in the\n+store (issue #158). This repository's own #106, #148, #153 were merged\n+direct, with no merge_group run and so no statement, and the doctor said\n+done anyway -- proof two held on the four stage records with the chain\n+held, never asking whether the merge was sealed.\n+\n+Run: python3 -m pytest tests -q\n+\"\"\"\n+import json\n+import subprocess\n+from pathlib import Path\n+\n+ROOT = Path(__file__).resolve().parent.parent\n+ATTAVO = ROOT / \"bin\" / \"attavo\"\n+\n+FAKE_ATTEST = (\n+    '#!/bin/sh\\nread sha\\ngrep -qx \"$sha\" sealed.txt && printf %s '\n+    '\"{\\\\\"_type\\\\\": \\\\\"https://in-toto.io/Statement/v1\\\\\"}\"\\n'\n+)\n+\n+\n+def _git(root: Path, *args: str) -> str:\n+    return subprocess.run([\"git\", \"-C\", str(root), *args], capture_output=True, text=True,\n+                          check=True).stdout.strip()\n+\n+\n+def _tenant_with_two_merged_items(tmp_path: Path) -> tuple[Path, str, str]:\n+    root = tmp_path / \"sealed\"\n+    root.mkdir()\n+    subprocess.run([\"git\", \"init\", \"-q\", \"-b\", \"main\", \".\"], cwd=root, check=True)\n+    _git(root, \"config\", \"user.email\", \"doctor@attavo.invalid\")\n+    _git(root, \"config\", \"user.name\", \"doctor fixture\")\n+    (root / \"attavo.toml\").write_text(\n+        '[paths]\\nrecords = \"records\"\\n\\n[forge]\\nattestation_command = \"sh ./fake-attest\"\\n')\n+    (root / \"fake-attest\").write_text(FAKE_ATTEST)\n+    (root / \"sealed.txt\").write_text(\"\")\n+    _git(root, \"add\", \".\")\n+    _git(root, \"commit\", \"-q\", \"-m\", \"install\")\n+    merges = []\n+    for item in (\"1\", \"2\"):\n+        _git(root, \"checkout\", \"-q\", \"-b\", f\"attavo/{item}-x\")\n+        (root / \"records\" / item).mkdir(parents=True)\n+        for stage in (\"spec\", \"approval\", \"build\", \"verify\"):\n+            (root / \"records\" / item / f\"{stage}-01.json\").write_text('{\"status\": \"pass\"}')\n+            _git(root, \"add\", \"records\")\n+            _git(root, \"commit\", \"-q\", \"-m\", f\"{stage} record for item {item}\")\n+        _git(root, \"checkout\", \"-q\", \"main\")\n+        _git(root, \"merge\", \"-q\", \"--no-ff\", \"-m\", f\"Merge branch 'attavo/{item}-x'\", f\"attavo/{item}-x\")\n+        merges.append(_git(root, \"rev-parse\", \"HEAD\"))\n+    _git(root, \"update-ref\", \"refs/remotes/origin/main\", _git(root, \"rev-parse\", \"main\"))\n+    _git(root, \"symbolic-ref\", \"refs/remotes/origin/HEAD\", \"refs/remotes/origin/main\")\n+    return root, merges[0], merges[1]\n+\n+\n+def _tenant_with_one_merged_and_one_unmerged_item(tmp_path: Path) -> Path:\n+    root = tmp_path / \"unmerged\"\n+    root.mkdir()\n+    subprocess.run([\"git\", \"init\", \"-q\", \"-b\", \"main\", \".\"], cwd=root, check=True)\n+    _git(root, \"config\", \"user.email\", \"doctor@attavo.invalid\")\n+    _git(root, \"config\", \"user.name\", \"doctor fixture\")\n+    (root / \"attavo.toml\").write_text(\n+        '[paths]\\nrecords = \"records\"\\n\\n[forge]\\nattestation_command = \"sh ./fake-attest\"\\n')\n+    (root / \"fake-attest\").write_text(FAKE_ATTEST)\n+    (root / \"sealed.txt\").write_text(\"\")\n+    _git(root, \"add\", \".\")\n+    _git(root, \"commit\", \"-q\", \"-m\", \"install\")\n+    _git(root, \"checkout\", \"-q\", \"-b\", \"attavo/1-x\")\n+    (root / \"records\" / \"1\").mkdir(parents=True)\n+    for stage in (\"spec\", \"approval\", \"build\", \"verify\"):\n+        (root / \"records\" / \"1\" / f\"{stage}-01.json\").write_text('{\"status\": \"pass\"}')\n+        _git(root, \"add\", \"records\")\n+        _git(root, \"commit\", \"-q\", \"-m\", f\"{stage} record for item 1\")\n+    _git(root, \"checkout\", \"-q\", \"main\")\n+    _git(root, \"merge\", \"-q\", \"--no-ff\", \"-m\", \"Merge branch 'attavo/1-x'\", \"attavo/1-x\")\n+    m1 = _git(root, \"rev-parse\", \"HEAD\")\n+    (root / \"sealed.txt\").write_text(m1 + \"\\n\")\n+    _git(root, \"add\", \"sealed.txt\")\n+    _git(root, \"commit\", \"-q\", \"-m\", \"seal item 1\")\n+    _git(root, \"checkout\", \"-q\", \"-b\", \"attavo/2-x\")\n+    (root / \"records\" / \"2\").mkdir(parents=True)\n+    for stage in (\"spec\", \"approval\", \"build\", \"verify\"):\n+        (root / \"records\" / \"2\" / f\"{stage}-01.json\").write_text('{\"status\": \"pass\"}')\n+        _git(root, \"add\", \"records\")\n+        _git(root, \"commit\", \"-q\", \"-m\", f\"{stage} record for item 2\")\n+    _git(root, \"checkout\", \"-q\", \"--detach\")\n+    _git(root, \"merge\", \"-q\", \"--no-ff\", \"-m\", \"synthetic test merge of attavo/2-x into main\", \"main\")\n+    return root\n+\n+\n+def _proof(root: Path) -> dict:\n+    run = subprocess.run([\"python3\", str(ATTAVO), \"doctor\", \"--json\", str(root)],\n+                         capture_output=True, text=True, check=False)\n+    proofs = json.loads(run.stdout)[\"proofs\"]\n+    return [p for p in proofs if p[\"proof\"] == \"every-attested-item-is-sealed\"][0]\n+\n+\n+def test_doctor_proof_six_fails_on_an_unsealed_merge(tmp_path):\n+    root, m1, m2 = _tenant_with_two_merged_items(tmp_path)\n+    (root / \"sealed.txt\").write_text(m1 + \"\\n\")\n+    p = _proof(root)\n+    assert not p[\"holds\"]\n+    assert \"item 2\" in p[\"reason\"] and m2[:12] in p[\"reason\"]\n+    assert p[\"sealed\"] == [\"1\"] and p[\"unsealed\"] == [\"2\"]\n+\n+\n+def test_doctor_proof_six_holds_when_every_merge_is_sealed(tmp_path):\n+    root, m1, m2 = _tenant_with_two_merged_items(tmp_path)\n+    (root / \"sealed.txt\").write_text(m1 + \"\\n\" + m2 + \"\\n\")\n+    p = _proof(root)\n+    assert p[\"holds\"] and p[\"sealed\"] == [\"1\", \"2\"]\n+\n+\n+def test_doctor_proof_six_names_a_merge_before_the_window_without_failing(tmp_path):\n+    root, m1, m2 = _tenant_with_two_merged_items(tmp_path)\n+    (root / \"sealed.txt\").write_text(m2 + \"\\n\")\n+    (root / \"attavo.toml\").write_text(\n+        '[paths]\\nrecords = \"records\"\\n\\n[forge]\\nattestation_command = \"sh ./fake-attest\"\\n'\n+        f'sealed_since = \"{m1}\"\\n')\n+    p = _proof(root)\n+    assert p[\"holds\"] and p[\"before_window\"] == [\"1\"] and p[\"sealed\"] == [\"2\"]\n+\n+\n+def test_doctor_proof_six_fails_without_an_attestation_command(tmp_path):\n+    root = tmp_path / \"bare\"\n+    root.mkdir()\n+    subprocess.run([\"git\", \"init\", \"-q\", \"-b\", \"main\", \".\"], cwd=root, check=True)\n+    (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n')\n+    (root / \"records\").mkdir()\n+    p = _proof(root)\n+    assert not p[\"holds\"] and \"attestation_command\" in p[\"reason\"]\n+\n+\n+def test_doctor_proof_six_says_not_read_when_the_store_cannot_be_read(tmp_path):\n+    root = tmp_path / \"unreadable\"\n+    root.mkdir()\n+    subprocess.run([\"git\", \"init\", \"-q\", \"-b\", \"main\", \".\"], cwd=root, check=True)\n+    _git(root, \"config\", \"user.email\", \"doctor@attavo.invalid\")\n+    _git(root, \"config\", \"user.name\", \"doctor fixture\")\n+    (root / \"attavo.toml\").write_text(\n+        '[paths]\\nrecords = \"records\"\\n\\n[forge]\\nattestation_command = \"sh ./unreadable-store\"\\n')\n+    (root / \"unreadable-store\").write_text(\n+        '#!/bin/sh\\nread sha\\necho \"gh: not logged in\" >&2\\nexit 2\\n')\n+    _git(root, \"add\", \".\")\n+    _git(root, \"commit\", \"-q\", \"-m\", \"install\")\n+    _git(root, \"checkout\", \"-q\", \"-b\", \"attavo/1-x\")\n+    (root / \"records\" / \"1\").mkdir(parents=True)\n+    for stage in (\"spec\", \"approval\", \"build\", \"verify\"):\n+        (root / \"records\" / \"1\" / f\"{stage}-01.json\").write_text('{\"status\": \"pass\"}')\n+        _git(root, \"add\", \"records\")\n+        _git(root, \"commit\", \"-q\", \"-m\", f\"{stage} record for item 1\")\n+    _git(root, \"checkout\", \"-q\", \"main\")\n+    _git(root, \"merge\", \"-q\", \"--no-ff\", \"-m\", \"Merge branch 'attavo/1-x'\", \"attavo/1-x\")\n+    _git(root, \"update-ref\", \"refs/remotes/origin/main\", _git(root, \"rev-parse\", \"main\"))\n+    _git(root, \"symbolic-ref\", \"refs/remotes/origin/HEAD\", \"refs/remotes/origin/main\")\n+    p = _proof(root)\n+    assert not p[\"holds\"]\n+    assert \"not read\" in p[\"reason\"] and \"unreadable-store\" in p[\"reason\"] and \"exited 2\" in p[\"reason\"]\n+    assert p[\"not_read\"] == [\"1\"] and p[\"unsealed\"] == [] and p[\"sealed\"] == []\n+\n+\n+def test_doctor_proof_six_names_an_unmerged_item(tmp_path):\n+    root = _tenant_with_one_merged_and_one_unmerged_item(tmp_path)\n+    noref = _proof(root)\n+    assert not noref[\"holds\"] and \"refs/remotes/origin/HEAD\" in noref[\"reason\"]\n+    _git(root, \"update-ref\", \"refs/remotes/origin/main\", \"main\")\n+    _git(root, \"symbolic-ref\", \"refs/remotes/origin/HEAD\", \"refs/remotes/origin/main\")\n+    ref = _proof(root)\n+    assert ref[\"holds\"]\n+    assert ref[\"sealed\"] == [\"1\"] and ref[\"not_merged\"] == [\"2\"] and ref[\"unsealed\"] == []\ndiff --git a/tests/test_record_schemas.py b/tests/test_record_schemas.py\nindex 73630c8..5f82b63 100644\n--- a/tests/test_record_schemas.py\n+++ b/tests/test_record_schemas.py\n@@ -419,13 +419,14 @@ def test_only_load_record_parses_record_file_content():\n     \"\"\"Acceptance 6: _load_record is the one place in this repository\n     that turns a <stage>-NN.json record's bytes into a dict; parse_attempts\n     and load_records both read through it rather than calling json.loads\n-    themselves. `git grep -n \"json.loads(\" bin/attavo` still finds four\n+    themselves. `git grep -n \"json.loads(\" bin/attavo` still finds five\n     other sites -- a schema file, an adapter's conformance.json, an\n-    adapter's own stdout report, and proof four's own read of one log\n-    line at a time to tell an adapter's JSON event stream from a tool's\n-    plain-text error (issue #94) -- none of them a record.\"\"\"\n+    adapter's own stdout report, proof four's own read of one log line at\n+    a time to tell an adapter's JSON event stream from a tool's plain-text\n+    error (issue #94), and proof five's own read of the forge's\n+    attestation statement (issue #158) -- none of them a record.\"\"\"\n     text = ATTAVO.read_text()\n-    assert text.count(\"json.loads(\") == 5, (\n+    assert text.count(\"json.loads(\") == 6, (\n         \"a new json.loads( site was added; review it against issue #60 acceptance 6 \"\n         \"and update this count\")\n     assert \"data = json.loads(path.read_text())\" in text\n","exit_code":0,"status":"completed"}}

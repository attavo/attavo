rejects --deselect tests/test_doctor.py::test_one_item_traversed_every_stage --deselect tests/test_doctor.py::test_no_commit_lacks_a_record --deselect tests/test_doctor.py::test_no_stop_lacks_cause --deselect tests/test_doctor.py::test_every_attested_item_is_sealed\",\n    \"count\": 1,\n    \"exit\": 0\n  },\n  \"checks\": {\n    \"command\": \"python3 -m pytest tests -q --deselect tests/test_doctor.py::test_every_gate_rejects --deselect tests/test_doctor.py::test_one_item_traversed_every_stage --deselect tests/test_doctor.py::test_no_commit_lacks_a_record --deselect tests/test_doctor.py::test_no_stop_lacks_cause --deselect tests/test_doctor.py::test_every_attested_item_is_sealed\",\n    \"exit\": 0\n  },\n  \"tokens\": {\n    \"input\": 3427219,\n    \"output\": 23258\n  },\n  \"cost_usd\": 1.1503545999999996,\n  \"wall_clock_s\": 1021.19,\n  \"status\": \"pass\",\n  \"refusal\": null,\n  \"halted\": null,\n  \"stop\": null,\n  \"record_version\": 7,\n  \"item\": \"158\",\n  \"product_version\": \"v0.25.0-42-g5da8b82\",\n  \"product_pin\": \"v0.25.0\"\n}\n#!/usr/bin/env python3\n\"\"\"forge-checks: [forge].checks_command for attavo verify (issue #103).\n\nPrints one line per GitHub check-run on `sha` as \"<name> <conclusion>\";\na check that has not concluded prints its status in place of a\nconclusion -- attavo verify's own read of these lines decides whether\nthat is green, not this script. Exits non-zero, printing nothing to\nstdout, when the sha cannot be read at all (the forge does not know it,\nor the API call otherwise fails): attavo verify appends the sha to this\ncommand string and runs it under a shell, and reads a nonzero exit alone\nas \"not green.\"\n\nWritten from schema/manifest.schema.json's own description of\n[forge].checks_command and from `gh`, independently of tenant zero's\nequivalent script.\n\nUsage: forge-checks <sha>\nRequires: `gh`, authenticated, run inside this repository's checkout.\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport subprocess\nimport sys\n\n\ndef main(argv: list[str]) -> int:\n    if len(argv) != 1:\n        print(\"usage: forge-checks <sha>\", file=sys.stderr)\n        return 2\n    sha = argv[0]\n    run = subprocess.run(\n        [\"gh\", \"api\", f\"repos/{{owner}}/{{repo}}/commits/{sha}/check-runs?per_page=100\"],\n        capture_output=True, text=True, timeout=30, check=False,\n    )\n    if run.returncode != 0:\n        print(run.stderr.strip() or f\"forge-checks: sha {sha} not found\", file=sys.stderr)\n        return 1\n    try:\n        payload = json.loads(run.stdout)\n    except json.JSONDecodeError:\n        print(f\"forge-checks: unexpected response for sha {sha}\", file=sys.stderr)\n        return 1\n    for check in payload.get(\"check_runs\", []):\n        state = check.get(\"conclusion\") or check.get(\"status\")\n        print(f\"{check['name']} {state}\")\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main(sys.argv[1:]))\n#!/bin/sh\n# forge-attestation: [forge].attestation_command for attavo doctor's fifth\n# proof (issue #158).\n#\n# Reads a merge commit sha on stdin. actions/attest@v2, in\n# .github/workflows/attavo-coherence.yml, signs the merge's attestation\n# statement over a synthetic subject: the sha256 digest of the merge\n# sha's own text (deterministic and reproducible from the sha alone, since\n# the statement is sealed before the artifact -- the merge -- has landed\n# anywhere to be hashed itself). This script re-derives that same digest\n# and reads it back from the forge's attestation store, printing the\n# statement's predicate payload as JSON on exit 0. It prints nothing and\n# exits non-zero when the store holds no attestation for that digest, or\n# the sha is empty, or `gh` cannot resolve this checkout's repository.\n#\n# Usage: read sha | forge-attestation\n# Requires: `gh`, authenticated, run inside this repository's checkout.\nset -e\nread -r sha\ntest -n \"$sha\" || exit 2\ndigest=$(printf '%s' \"$sha\" | shasum -a 256 | cut -d ' ' -f 1)\nrepo=$(gh repo view --json nameWithOwner --jq .nameWithOwner 2>/dev/null) || exit 2\npayload=$(gh api \"repos/$repo/attestations/sha256:$digest\" --jq '.attestations[0].bundle.dsseEnvelope.payload' 2>/dev/null) || exit 1\ntest -n \"$payload\" && test \"$payload\" != null || exit 1\nprintf '%s' \"$payload\" | base64 -d\n  # Since #103, this repository is Attavo's own second tenant (attavo.toml\n  # at the root) and the doctor's five proofs run for real, not under\n  # || true. #106's first item merged (fdd1981, v0.18.0), so the five\n  # proofs hold on main and this job reports on pull requests and merge\n  # groups too -- where a refusal is cheap. It does not report on a\n  # branch push: a branch's own boundary commits precede their records,\n  # so proof three (no commit lacks a record) cannot hold there (#113).\n  doctor:\n    if: github.event_name == 'pull_request' || github.event_name == 'merge_group' || github.ref == 'refs/heads/main'\n    runs-on: ubuntu-latest\n    permissions:\n      contents: read\n      attestations: read\n    env:\n      # issue #158, amended after build-05: every step that runs the\n      # doctor -- the pytest step and the bin/attavo invocation both --\n      # reads the attestation store through [forge].attestation_command,\n      # which shells out to `gh`. A token scoped to only the last step\n      # left the pytest step reading an unauthenticated store, which\n      # exits 2 (not read), not the 404 (unsealed) the proof expects.\n      GH_TOKEN: ${{ github.token }}\n    steps:\n      - uses: actions/checkout@v4\n        with:\n          fetch-depth: 0\n      # issue #169: _merges_reachable reads refs/remotes/origin/HEAD to\n      # name the default branch without hard-coding \"main\"; actions/checkout\n      # does not set it, so every trigger this job runs on -- pull_request,\n      # merge_group, and push -- needs it set explicitly, after the fetch.\n      - run: git remote set-head origin -a\n      - uses: actions/setup-python@v5\n        with:\n          python-version: \"3.11\"\n      - run: pip install pytest jsonschema\n      - name: doctor's five proofs\n        run: python3 -m pytest tests/test_doctor.py -q -k \"every_gate_rejects or one_item_traversed_every_stage or no_commit_lacks_a_record or no_stop_lacks_cause or every_attested_item_is_sealed\"\n      - run: python3 bin/attavo doctor .\n\n  action-self-check:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n        with:\n          fetch-depth: 0\n      - uses: ./\n      - run: test \"$ATTAVO_ATTESTATION_PREDICATE_TYPE\" = \"$(python3 -c \"import json; print(json.load(open('schema/attestation.schema.json'))['\\$id'])\")\"\n      - run: attavo spec-gate\n        working-directory: tests/fixtures/valid\n        env:\n          ATTAVO_ITEM: \"1\"\n\n  # merge_group added alongside pull_request (#103): the merge queue\n  # requires every required check to report on the merge group, not only\n  # on the pull request that entered it (tenant zero's #662 was the same\n  # class of miss, on pull_request only). github.base_ref is empty on a\n  # merge_group event; the target branch comes from\n-rwxr-xr-x .attavo/bin/forge-attestation\nattest/specs/158/criteria/doctor-fails-on-an-unsealed-merge.sh\n#!/bin/sh\nset -e\nhere=$(pwd)\ntmp=$(mktemp -d)\ncd \"$tmp\"\ngit init -q -b main .\ngit config user.email doctor@attavo.invalid\ngit config user.name \"doctor fixture\"\nprintf '[paths]\\nrecords = \"records\"\\n\\n[forge]\\nattestation_command = \"sh ./fake-attest\"\\n' > attavo.toml\nprintf '#!/bin/sh\\nread sha\\ngrep -qx \"$sha\" sealed.txt && printf %s \"{\\\\\"_type\\\\\": \\\\\"https://in-toto.io/Statement/v1\\\\\", \\\\\"subject\\\\\": [{\\\\\"digest\\\\\": {\\\\\"sha256\\\\\": \\\\\"$sha\\\\\"}}]}\"\\n' > fake-attest\nprintf '' > sealed.txt\ngit add attavo.toml fake-attest sealed.txt\ngit commit -q -m install\nfor i in 1 2\ndo\n  git checkout -q -b \"attavo/$i-x\"\n  mkdir -p \"records/$i\"\n  for stage in spec approval build verify\n  do\n    printf '{\"status\": \"pass\"}' > \"records/$i/$stage-01.json\"\n    git add records\n    git commit -q -m \"$stage record for item $i\"\n  done\n  git checkout -q main\n  git merge -q --no-ff -m \"Merge branch 'attavo/$i-x'\" \"attavo/$i-x\"\ndone\ngit update-ref refs/remotes/origin/main \"$(git rev-parse main)\"\ngit symbolic-ref refs/remotes/origin/HEAD refs/remotes/origin/main\nm1=$(git log --merges --format=%H --grep=\"attavo/1-x\" -1)\nm2=$(git log --merges --format=%H --grep=\"attavo/2-x\" -1)\nprintf '%s\\n' \"$m1\" > sealed.txt\ncd \"$here\"\npython3 bin/attavo doctor --json \"$tmp\" > \"$tmp/doctor-one.json\" || true\nprintf '%s\\n%s\\n' \"$m1\" \"$m2\" > \"$tmp/sealed.txt\"\npython3 bin/attavo doctor --json \"$tmp\" > \"$tmp/doctor-both.json\" || true\npython3 - \"$tmp/doctor-one.json\" \"$tmp/doctor-both.json\" \"$m2\" <<'PY'\nimport json, sys\ndef proof(path):\n    d = json.load(open(path))\n    return [x for x in d[\"proofs\"] if x[\"proof\"] == \"every-attested-item-is-sealed\"][0]\none = proof(sys.argv[1])\nassert one[\"holds\"] is False, one\nassert \"item 2\" in one[\"reason\"] and sys.argv[3][:12] in one[\"reason\"], one\nassert one[\"unsealed\"] == [\"2\"] and one[\"sealed\"] == [\"1\"], one\nboth = proof(sys.argv[2])\nassert both[\"holds\"] is True and both[\"sealed\"] == [\"1\", \"2\"], both\nPY\nrm -rf \"$tmp\"\nattest/specs/158/criteria/doctor-fails-without-attestation-command.sh\n#!/bin/sh\nset -e\nhere=$(pwd)\ntmp=$(mktemp -d)\ncd \"$tmp\"\ngit init -q -b main .\ngit config user.email doctor@attavo.invalid\ngit config user.name \"doctor fixture\"\nprintf '[paths]\\nrecords = \"records\"\\n' > attavo.toml\nmkdir -p records\ngit add attavo.toml\ngit commit -q -m install\ngit update-ref refs/remotes/origin/main \"$(git rev-parse main)\"\ngit symbolic-ref refs/remotes/origin/HEAD refs/remotes/origin/main\ncd \"$here\"\npython3 bin/attavo doctor --json \"$tmp\" | python3 -c 'import json,sys; p=[x for x in json.load(sys.stdin)[\"proofs\"] if x[\"proof\"]==\"every-attested-item-is-sealed\"][0]; assert p[\"holds\"] is False and \"attestation_command\" in p[\"reason\"], p'\npython3 -c 'import json; s=json.load(open(\"schema/manifest.schema.json\")); assert \"attestation_command\" in s[\"properties\"][\"forge\"][\"properties\"], s[\"properties\"][\"forge\"]'\nrm -rf \"$tmp\"\nattest/specs/158/criteria/doctor-names-an-unmerged-item.sh\n#!/bin/sh\nset -e\nhere=$(pwd)\ntmp=$(mktemp -d)\ncd \"$tmp\"\ngit init -q -b main .\ngit config user.email doctor@attavo.invalid\ngit config user.name \"doctor fixture\"\nprintf '[paths]\\nrecords = \"records\"\\n\\n[forge]\\nattestation_command = \"sh ./fake-attest\"\\n' > attavo.toml\nprintf '#!/bin/sh\\nread sha\\ngrep -qx \"$sha\" sealed.txt && printf %s \"{\\\\\"_type\\\\\": \\\\\"https://in-toto.io/Statement/v1\\\\\"}\"\\n' > fake-attest\nprintf '' > sealed.txt\ngit add attavo.toml fake-attest sealed.txt\ngit commit -q -m install\ngit checkout -q -b attavo/1-x\nmkdir -p records/1\nfor stage in spec approval build verify\ndo\n  printf '{\"status\": \"pass\"}' > \"records/1/$stage-01.json\"\n  git add records\n  git commit -q -m \"$stage record for item 1\"\ndone\ngit checkout -q main\ngit merge -q --no-ff -m \"Merge branch 'attavo/1-x'\" attavo/1-x\nm1=$(git rev-parse HEAD)\nprintf '%s\\n' \"$m1\" > sealed.txt\ngit add sealed.txt\ngit commit -q -m \"seal item 1\"\ngit checkout -q -b attavo/2-x\nmkdir -p records/2\nfor stage in spec approval build verify\ndo\n  printf '{\"status\": \"pass\"}' > \"records/2/$stage-01.json\"\n  git add records\n  git commit -q -m \"$stage record for item 2\"\ndone\ngit checkout -q --detach\ngit merge -q --no-ff -m \"synthetic test merge of attavo/2-x into main\" main\ncd \"$here\"\npython3 bin/attavo doctor --json \"$tmp\" > \"$tmp/doctor-no-ref.json\" || true\ncd \"$tmp\"\ngit update-ref refs/remotes/origin/main \"$m1\"\ngit symbolic-ref refs/remotes/origin/HEAD refs/remotes/origin/main\ncd \"$here\"\npython3 bin/attavo doctor --json \"$tmp\" > \"$tmp/doctor-ref.json\" || true\npython3 - \"$tmp/doctor-no-ref.json\" \"$tmp/doctor-ref.json\" <<'PY'\nimport json, sys\ndef proof(path):\n    d = json.load(open(path))\n    return [x for x in d[\"proofs\"] if x[\"proof\"] == \"every-attested-item-is-sealed\"][0]\nnoref = proof(sys.argv[1])\nassert noref[\"holds\"] is False and \"refs/remotes/origin/HEAD\" in noref[\"reason\"], noref\nref = proof(sys.argv[2])\nassert ref[\"holds\"] is True, ref\nassert ref[\"sealed\"] == [\"1\"] and ref[\"not_merged\"] == [\"2\"] and ref[\"unsealed\"] == [], ref\nPY\nrm -rf \"$tmp\"\nattest/specs/158/criteria/doctor-says-not-read-when-the-store-cannot-be-read.sh\n#!/bin/sh\nset -e\nhere=$(pwd)\ntmp=$(mktemp -d)\ncd \"$tmp\"\ngit init -q -b main .\ngit config user.email doctor@attavo.invalid\ngit config user.name \"doctor fixture\"\nprintf '[paths]\\nrecords = \"records\"\\n\\n[forge]\\nattestation_command = \"sh ./unreadable-store\"\\n' > attavo.toml\nprintf '#!/bin/sh\\nread sha\\necho \"gh: not logged in\" >&2\\nexit 2\\n' > unreadable-store\ngit add attavo.toml unreadable-store\ngit commit -q -m install\ngit checkout -q -b attavo/1-x\nmkdir -p records/1\nfor stage in spec approval build verify\ndo\n  printf '{\"status\": \"pass\"}' > \"records/1/$stage-01.json\"\n  git add records\n  git commit -q -m \"$stage record for item 1\"\ndone\ngit checkout -q main\ngit merge -q --no-ff -m \"Merge branch 'attavo/1-x'\" attavo/1-x\ngit update-ref refs/remotes/origin/main \"$(git rev-parse main)\"\ngit symbolic-ref refs/remotes/origin/HEAD refs/remotes/origin/main\ncd \"$here\"\npython3 bin/attavo doctor --json \"$tmp\" > \"$tmp/doctor.json\" || true\npython3 - \"$tmp/doctor.json\" <<'PY'\nimport json, sys\nd = json.load(open(sys.argv[1]))\np = [x for x in d[\"proofs\"] if x[\"proof\"] == \"every-attested-item-is-sealed\"][0]\nassert p[\"holds\"] is False, p\nassert \"not read\" in p[\"reason\"] and \"unreadable-store\" in p[\"reason\"] and \"exited 2\" in p[\"reason\"], p\nassert p[\"not_read\"] == [\"1\"] and p[\"unsealed\"] == [] and p[\"sealed\"] == [], p\nPY\nrm -rf \"$tmp\"\nattest/specs/158/criteria/the-doctor-job-carries-the-token.sh\n#!/bin/sh\nset -e\npython3 - <<'PY'\nimport re, sys\ntext = open(\".github/workflows/ci.yml\").read()\nm = re.search(r\"^  doctor:\\n(.*?)(?=^  [A-Za-z_-]+:\\n|\\Z)\", text, re.S | re.M)\nassert m, \"no doctor job in ci.yml\"\njob = m.group(1)\nhead, _, steps = job.partition(\"    steps:\\n\")\nassert \"GH_TOKEN\" in head, \"GH_TOKEN is not set at the doctor job's level\"\nassert \"attestations: read\" in head, \"the doctor job lacks attestations: read\"\npytest_lines = [l for l in steps.splitlines() if \"pytest\" in l and \"test_doctor.py\" in l]\nassert pytest_lines, \"no pytest step over test_doctor.py in the doctor job\"\nassert all(\"every_attested_item_is_sealed\" in l for l in pytest_lines), \"the doctor job's pytest step does not select the sealed test\"\nPY\nattest/specs/158/criteria/the-proof-has-its-test.sh\n#!/bin/sh\ngrep -rq 'def test_doctor_proof_six_fails_on_an_unsealed_merge' tests/ && grep -rq 'def test_doctor_proof_six_names_an_unmerged_item' tests/ && grep -rq 'def test_doctor_proof_six_says_not_read_when_the_store_cannot_be_read' tests/ && grep -q 'attestation_command' attavo.toml && test -x .attavo/bin/forge-attestation\n","exit_code":0,"status":"completed"}}

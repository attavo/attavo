  f\"own error line is owed\")\n1066\t\n1067\t        # issue #137: a refused spec-gate record is a stop too, class\n1068\t        # \"gate\" -- synthesized the same way item_stops and\n1069\t        # cmd_file_stops already read it, since cmd_spec_gate itself\n1070\t        # carries no stop field to check for one. No record_version\n1071\t        # gate here: unlike build/verify's own stop field, gate is never\n1072\t        # persisted, so there is no older shape that predates it.\n1073\t        for n, rec in sorted(parse_attempts(item_dir, \"spec\").items()):\n1074\t            if rec.get(\"status\") != \"refused\":\n1075\t                continue\n1076\t            checked += 1\n1077\t            name = f\"spec-{n:02d}\"\n1078\t            stop = gate_stop(rec.get(\"refusal\"))\n1079\t            cls, provenance = stop[\"class\"], stop[\"provenance\"]\n1080\t            if cls not in STOP_CLASSES:\n1081\t                problems.append(f\"item {item_dir.name} {name} stop.class {cls!r} names \"\n1082\t                                f\"no enumerated class\")\n1083\t                continue\n1084\t            if provenance not in STOP_PROVENANCES:\n1085\t                problems.append(f\"item {item_dir.name} {name} stop.provenance \"\n1086\t                                f\"{provenance!r} names no enumerated provenance\")\n1087\t                continue\n1088\t            if not stop.get(\"detail\"):\n1089\t                problems.append(f\"item {item_dir.name} {name} is a gate stop with no cause\")\n1090\t\n1091\t    older_note = f\"{older} record(s) before stop was recorded\"\n1092\t    if problems:\n1093\t        return p.fail(\"; \".join(problems), older_records=older)\n1094\t    return p.hold(f\"{checked} checked ({older_note})\" if checked == 0\n1095\t                 else f\"{checked} non-pass record(s) carry stop with a cause ({older_note})\",\n1096\t                 older_records=older)\n1097\t\n1098\t\n1099\tdef doctor(root: Path) -> list[Proof]:\n11
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01PsugEVzxhBHrLFGuWv6Q6R","type":"tool_result","content":"1\t\"\"\"attavo doctor, proof six: every attested item has its statement in\n2\tthe store (the self-tenant's #106, #148, #153 were merged with no\n3\tmerge_group run and no statement, and the doctor said done).\"\"\"\n4\timport json\n5\timport subprocess\n6\tfrom pathlib import Path\n7\t\n8\tATTAVO = Path(__file__).resolve().parents[1] / \"bin\" / \"attavo\"\n9\t\n10\tFAKE_ATTEST = (\n11\t    '#!/bin/sh\\nread sha\\ngrep -qx \"$sha\" sealed.txt && printf %s '\n12\t    '\"{\\\\\"_type\\\\\": \\\\\"https://in-toto.io/Statement/v1\\\\\"}\"\\n'\n13\t)\n14\t\n15\t\n16\tdef _git(root: Path, *args: str) -> str:\n17\t    return subprocess.run([\"git\", \"-C\", str(root), *args], capture_output=True, text=True,\n18\t                          check=True).stdout.strip()\n19\t\n20\t\n21\tdef _tenant_with_two_merged_items(tmp_path: Path) -> tuple[Path, str, str]:\n22\t    root = tmp_path / \"sealed\"\n23\t    root.mkdir()\n24\t    subprocess.run([\"git\", \"init\", \"-q\", \"-b\", \"main\", \".\"], cwd=root, check=True)\n25\t    _git(root, \"config\", \"user.email\", \"doctor@attavo.invalid\")\n26\t    _git(root, \"config\", \"user.name\", \"doctor fixture\")\n27\t    (root / \"attavo.toml\").write_text(\n28\t        '[paths]\\nrecords = \"records\"\\n\\n[forge]\\nattestation_command = \"sh ./fake-attest\"\\n')\n29\t    (root / \"fake-attest\").write_text(FAKE_ATTEST)\n30\t    (root / \"sealed.txt\").write_text(\"\")\n31\t    _git(root, \"add\", \".\")\n32\t    _git(root, \"commit\", \"-q\", \"-m\", \"install\")\n33\t    merges = []\n34\t    for item in (\"1\", \"2\"):\n35\t        _git(root, \"checkout\", \"-q\", \"-b\", f\"attavo/{item}-x\")\n36\t        (root / \"records\" / item).mkdir(parents=True)\n37\t        for stage in (\"spec\", \"approval\", \"build\", \"verify\"):\n38\t            (root / \"records\" / item / f\"{stage}-01.json\").write_text('{\"status\": \"pass\"}')\n39\t            _git(root, \"add\", \"records\")\n40\t            _git(root, \"commit\", \"-q\", \"-m\", f\"{stage} record for item {item}\")\n41\t        _git(root, \"checkout\", \"-q\", \"main\")\n42\t        _git(root, \"merge\", \"-q\", \"--no-ff\", \"-m\", f\"Merge branch 'attavo/{item}-x'\", f\"attavo/{item}-x\")\n43\t        merges.append(_git(root, \"rev-parse\", \"HEAD\"))\n44\t    return root, merges[0], merges[1]\n45\t\n46\t\n47\tdef _proof(root: Path) -> dict:\n48\t    run = subprocess.run([\"python3\", str(ATTAVO), \"doctor\", \"--json\", str(root)],\n49\t                         capture_output=True, text=True, check=False)\n50\t    proofs = json.loads(run.stdout)[\"proofs\"]\n51\t    return [p for p in proofs if p[\"proof\"] == \"every-attested-item-is-sealed\"][0]\n52\t\n53\t\n54\tdef test_doctor_proof_six_fails_on_an_unsealed_merge(tmp_path):\n55\t    root, m1, m2 = _tenant_with_two_merged_items(tmp_path)\n56\t    (root / \"sealed.txt\").write_text(m1 + \"\\n\")\n57\t    p = _proof(root)\n58\t    assert not p[\"holds\"]\n59\t    assert \"item 2\" in p[\"reason\"] and m2[:12] in p[\"reason\"]\n60\t    assert p[\"sealed\"] == [\"1\"] and p[\"unsealed\"] == [\"2\"]\n61\t\n62\t\n63\tdef test_doctor_proof_six_holds_when_every_merge_is_sealed(tmp_path):\n64\t    root, m1, m2 = _tenant_with_two_merged_items(tmp_path)\n65\t    (root / \"sealed.txt\").write_text(m1 + \"\\n\" + m2 + \"\\n\")\n66\t    p = _proof(root)\n67\t    assert p[\"holds\"] and p[\"sealed\"] == [\"1\", \"2\"]\n68\t\n69\t\n70\tdef test_doctor_proof_six_names_a_merge_before_the_window_without_failing(tmp_path):\n71\t    root, m1, m2 = _tenant_with_two_merged_items(tmp_path)\n72\t    (root / \"sealed.txt\").write_text(m2 + \"\\n\")\n73\t    (root / \"attavo.toml\").write_text(\n74\t        '[paths]\\nrecords = \"records\"\\n\\n[forge]\\nattestation_command = \"sh ./fake-attest\"\\n'\n75\t        f'sealed_since = \"{m1}\"\\n')\n76\t    p = _proof(root)\n77\t   
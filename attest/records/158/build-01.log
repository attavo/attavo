{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0143DGsK6hTFE1NMsiyckMgD","type":"tool_result","content":"259\tSTAGES = (\"spec\", \"approval\", \"build\", \"verify\")\n260\tCRITERION_TIMEOUT = 120\n261\tRECORD_RE = re.compile(r\"^([a-z]+)-([0-9]{2,})\\.json$\")\n262\tBUILD_ITERATION_BUDGET = 3\n263\tBUILD_HALT_EXIT = 3\n264\tCHECKS_FEEDBACK_TAIL_LINES = 200\n265\tPRODUCT_ROOT = Path(__file__).resolve().parent.parent\n266\t# issue #84: a constant the lane names, not a manifest key, until a tenant\n267\t# disagrees -- how long drive gives a forge's checks room to conclude\n268\t# before it gives up and stops rather than call a judge on a tree the\n269\t# forge has not yet finished reading. Tenant zero's own checks conclude\n270\t# about five minutes after a push; the default bound gives them room to\n271\t# finish so a person is not the one re-running drive after CI, which is\n272\t# exactly the transport act this lane retires. ATTAVO_DRIVE_POLL_BOUND_S\n273\t# and ATTAVO_DRIVE_POLL_INTERVAL_S, read at call time rather than once at\n274\t# import, are for a test's own clock, not a tenant's -- there is no\n275\t# manifest key for either.\n276\tDRIVE_FORGE_POLL_BOUND_DEFAULT_S = 600.0\n277\tDRIVE_FORGE_POLL_INTERVAL_DEFAULT_S = 20.0\n278\t\n279\t\n280\tdef drive_forge_poll_bound_s() -> float:\n281\t    return float(os.environ.get(\"ATTAVO_DRIVE_POLL_BOUND_S\", DRIVE_FORGE_POLL_BOUND_DEFAULT_S))\n282\t\n283\t\n284\tdef drive_forge_poll_interval_s() -> float:\n285\t    return float(os.environ.get(\"ATTAVO_DRIVE_POLL_INTERVAL_S\", DRIVE_FORGE_POLL_INTERVAL_DEFAULT_S))\n286\t\n287\t\n288\tclass Proof:\n289\t    def __init__(self, key: str, title: str) -> None:\n290\t        self.key = key\n291\t        self.title = title\n292\t        self.holds = False\n293\t        self.reason = \"\"\n294\t        self.extra: dict = {}\n295\t\n296\t    def fail(self, reason: str, **extra) -> \"Proof\":\n297\t        self.holds, self.reason = False, reason\n298\t        self.extra.update(extra)\n299\t        return self\n300\t\n301\t    def hold(self, reason: str, **extra) -> \"Proof\":\n302\t        self.holds, self.reason = True, reason\n303\t        self.extra.update(extra)\n304\t        return self\n305\t\n306\t    def as_dict(self) -> dict:\n307\t        return {\"proof\": self.key, \"title\": self.title,\n308\t                \"holds\": self.holds, \"reason\": self.reason, **self.extra}"}]},"parent_tool_use_id":null,"session_id":"6a170d87-3d29-46e3-a1eb-69574ae98490","uuid":"a426feb6-3c2f-4f33-a7e8-1915a5acbc5e","timestamp":"2026-09-17T19:40:08.582Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-158/bin/attavo","content":"STAGES = (\"spec\", \"approval\", \"build\", \"verify\")\nCRITERION_TIMEOUT = 120\nRECORD_RE = re.compile(r\"^([a-z]+)-([0-9]{2,})\\.json$\")\nBUILD_ITERATION_BUDGET = 3\nBUILD_HALT_EXIT = 3\nCHECKS_FEEDBACK_TAIL_LINES = 200\nPRODUCT_ROOT = Path(__file__).resolve().parent.parent\n# issue #84: a constant the lane names, not a manifest key, until a tenant\n# disagrees -- how long drive gives a forge's checks room to conclude\n# before it gives up and stops rather than call a judge on a tree the\n# forge has not yet finished reading. Tenant zero's own checks conclude\n# about five minutes after a push; the default bound gives them room to\n# finish so a person is not the one re-running drive after CI, which is\n# exactly the transport act this lane retires. ATTAVO_DRIVE_POLL_BOUND_S\n# and ATTAVO_DRIVE_POLL_INTERVAL_S, read at call time rather than once at\n# import, are for a test's own clock, not a tenant's -- there is no\n# manifest key for either.\nDRIVE_FORGE_POLL_BOUND_DEFAULT_S = 600.0\nDRIVE_FORGE_POLL_INTERVAL_DEFAULT_S = 20.0\n\n\ndef drive_forge_poll_bound_s() -> float:\n    return float(os.environ.get(\"ATTAVO_DRIVE_POLL_BOUND_S\", DRIVE_FORGE_POLL_BOUND_DEFAULT_S))\n\n\ndef drive_forge_poll_interval_s() -> float:\n    return float(os.environ.get(\"ATTAVO_DRIVE_POLL_INTERVAL_S\", DRIVE_FORGE_POLL_INTERVAL_DEFAULT_S))\n\n\nclass Proof:\n    def __init__(self, key: str, title: str) -> None:\n        self.key = key\n        self.title = title\n        self.holds = False\n        self.reason = \"\"\n        self.extra: dict = {}\n\n    def fail(self, reason: str, **extra) -> \"Proof\":\n        self.holds, self.reason = False, reason\n        self.extra.update(extra)\n        return self\n\n    def hold(self, reason: str, **extra) -> \"Proof\":\n        self.holds, self.reason = True, reason\n        self.extra.update(extra)\n        return self\n\n    def as_dict(self) -> dict:\n        return {\"proof\": self.key, \"title\": self.title,\n                \"holds\": self.holds, \"reason\": self.reason, **self.extra}","numLines":50,"startLine":259,"totalLines":3476}}}

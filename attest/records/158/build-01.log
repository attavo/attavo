{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013C3ZP87t4D4UmB6HCQP6mF","type":"tool_result","content":"719\tdef load_records(records_dir: Path) -> dict[str, dict[str, dict]]:\n720\t    \"\"\"{item_id: {stage: latest_record}} for every <records>/<item>/<stage>-NN.json.\"\"\"\n721\t    items: dict[str, dict[str, dict]] = {}\n722\t    if not records_dir.is_dir():\n723\t        return items\n724\t    for item_dir in sorted(p for p in records_dir.iterdir() if p.is_dir()):\n725\t        by_stage: dict[str, dict[int, dict]] = {}\n726\t        for rec in sorted(item_dir.glob(\"*.json\")):\n727\t            m = RECORD_RE.match(rec.name)\n728\t            if not m:\n729\t                continue\n730\t            stage, n = m.group(1), int(m.group(2))\n731\t            try:\n732\t                data = _load_record(rec, item_dir.name)\n733\t            except json.JSONDecodeError:\n734\t                continue\n735\t            by_stage.setdefault(stage, {})[n] = data\n736\t        items[item_dir.name] = {stage: attempts[max(attempts)] for stage, attempts in by_stage.items()}\n737\t    return items\n738\t\n739\t\n740\t# --- doctor's three proofs ---\n741\t\n742\tdef proof_every_gate_rejects(root: Path, m: dict | None) -> Proof:\n743\t    p = Proof(\"every-gate-rejects\", \"every gate rejects its fixture\")\n744\t    if m is None:\n745\t        return p.fail(f\"no {MANIFEST} at {root}; no gate is registered\")\n746\t    gates = m.get(\"gates\") or {}\n747\t    if not gates:\n748\t        return p.fail(\"[gates] is empty; a gate that has rejected nothing does not exist\")\n749\t    fixtures = root / m.get(\"paths\", {}).get(\"rejections\", \"\")\n750\t    # Proposal, not yet ruled on (issue #54): a gate that retires nothing\n751\t    # only adds, so proof one reports it here rather than waiting on the\n752\t    # schema alone -- read_manifest never validates against the manifest\n753\t    # schema at runtime, so a schema requirement is not an enforced one.\n754\t    no_retires = [name for name, gate in sorted(gates.items()) if not gate.get(\"retires\")]\n755\t    missing, accepted = [], []\n756\t    for name, gate in sorted(gates.items()):\n757\t        fixture = fixtures / name\n758\t        if not fixture.is_dir():\n759\t            missing.append(name)\n760\t            continue\n761\t        env = dict(os.environ)\n762\t        item = fixture_item_id(fixture)\n763\t        if item is not None:\n764\t            env[\"ATTAVO_ITEM\"] = item\n765\t        run = subprocess.run(gate[\"command\"], shell=True, cwd=str(fixture),\n766\t                             capture_output=True, text=True, check=False, env=env)\n767\t        if run.returncode == 0:\n768\t            accepted.append(name)\n769\t    if missing:\n770\t        return p.fail(f\"gate(s) with no rejection fixture: {', '.join(missing)}\")\n771\t    if accepted:\n772\t        return p.fail(f\"gate(s) that accepted their rejection fixture: {', '.join(accepted)}\")\n773\t    if no_retires:\n774\t        return p.fail(f\"gate(s) with no retires: {', '.join(no_retires)}\")\n775\t    return p.hold(f\"{len(gates)} gate(s) rejected their fixture\")\n776\t\n777\t\n778\tdef _merges_reachable(root: Path) -> list[dict]:\n779\t    \"\"\"Every merge commit reachable from HEAD -- sha, parents, and its own\n780\t    first-parent diff -- read by one process rather than the git log plus\n781\t    one git diff per merge merge_introducing_records used to pay walking\n782\t    toward the one it wants (issue #153). --diff-merges=first-parent gives\n783\t    each merge's diff against its first parent in the same pass git log\n784\t    --merges already makes to list them, in the same order.\"\"\"\n785\t    try:\n786\t        out = git(root, \"log\", \"--merges\", \"--diff-merges=first-parent\", \"--name-only\",\n787\t                 \"--format=\\x01%H\\x1f%P\")\n788\t    except RuntimeError:\n789\t        return []\n790\t    merges = []\n791\t    for block in out.split(\"\\x01\")[1:]:\n792\t        header, _, rest = block.partition(\"\\n\")\n793\t        sha, parents = header.split(\"\\x1f\")\n794\t        merges.append({\"sha\": sha, \"parents\": parents.split(),\n795\t                       \"touched\": [line for line in rest.splitlines() if line.strip()]})\n796\t    return merges\n797\t\n798\t\n799\tdef merge_introducing_records(root: Path, records_rel: str, item: str,\n800\t                              stages: tuple[str, ...],\n801\t                              merges: list[dict] | None = None) -> str | None:\n802\t    \"\"\"The merge commit reachable from HEAD whose first-parent diff\n803\t    introduces a record for every one of stages, under\n804\t    records_rel/item/ -- the same derivation attest itself uses\n805\t    (derive_attest_items), read here so proof two requires an item's\n806\t    stage records to have arrived by an actual merge, not merely to sit\n807\t    in the tree (issue #69, acceptance row 4).\n808\t\n809\t    merges, when given, is _merges_reachable's own result -- ledger's\n810\t    cmd_ledger computes it once and passes it to every item rather than\n811\t    walking HEAD's merges again for each (issue #153); left None, a caller\n812\t    with just the one item to ask (doctor's proof two) gets it computed\n813\t    here.\"\"\"\n814\t    if merges is None:\n815\t        merges = _merges_reachable(root)\n816\t    prefix = f\"{records_rel.rstrip('/')}/{item}/\"\n817\t    for merge in merges:\n818\t        found: set[str] = set()\n819\t        for p in merge[\"touched\"]:\n820\t            if p.startswith(prefix):\n821\t                m = RECORD_RE.match(Path(p).name)\n822\t                if m:\n823\t                    found.add(m.group(1))\n824\t        if all(s in found for s in stages):\n825\t            return merge[\"sha\"]\n826\t    return None\n827\t\n828\t\n829\tdef proof_one_item_every_stage(root: Path, m: dict | None) -> Proof:\n830\t    p = Proof(\"one-item-every-stage\", \"one item has traversed every stage\")\n831\t    if m is None:\n832\t        return p.fail(f\"no {MANIFEST} at {root}; no records directory is declared\")\n833\t    records_rel = m.get(\"paths\", {}).get(\"records\", \"\")\n834\t    records_dir = root / records_rel\n835\t    items = load_records(records_dir)\n836\t    if not items:\n837\t        return p.fail(f\"no work item under {records_dir.relative_to(root)}\")\n838\t    complete = [item for item, stages in items.items() if all(s in stages for s in STAGES)]\n839\t    if not complete:\n840\t        best = max(items.items(), key=lambda kv: len(kv[1]))\n841\t        lacking = [s for s in STAGES if s not in best[1]]\n842\t        return p.fail(f\"no item carries every stage; item {best[0]} lacks {', '.join(lacking)}\")\n843\t\n844\t    # issue #74: a complete item is counted only when its chain holds --\n845\t    # attavo attest refuses a build re-approved after the fact or a\n846\t    # verify whose build went stale, and the coherence gate refuses the\n847\t    # merge group on exactly that; a proof that never asked would call a\n848\t    # traversal the gate itself would not let through. The refusal text\n849\t    # is check_attest_chain's own, never re-typed here.\n850\t    refused, held, unmerged = [], [], []\n851\t    for item in complete:\n852\t        chain, message = check_attest_chain(records_dir / item, item)\n853\t        if chain is None:\n854\t            refused.append(f\"item {item}: {message}\")\n855\t            continue\n856\t        merge_sha = merge_introducing_records(root, records_rel, item, STAGES)\n857\t        if merge_sha:\n858\t            held.append((item, merge_sha))\n859\t        else:\n860\t            unmerged.append(item)\n861\t\n862\t    if held:\n863\t        names = \", \".join(item for item, _ in held)\n864\t        shas = \", \".join(sha[:12] for _, sha in held)\n865\t        return p.hold(f\"item(s) {names} carry {', '.join(STAGES)} with the chain held, \"\n866\t                      f\"merged at {shas}\")\n867\t    if refused:\n868\t        return p.fail(\"; \".join(refused))"}]},"parent_tool_use_id":null,"session_id":"6a170d87-3d29-46e3-a1eb-69574ae98490","uuid":"c5936299-52d7-4be2-b4e3-d2b5093c8bbc","timestamp":"2026-09-17T19:40:09.484Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-158/bin/attavo","content":"def load_records(records_dir: Path) -> dict[str, dict[str, dict]]:\n    \"\"\"{item_id: {stage: latest_record}} for every <records>/<item>/<stage>-NN.json.\"\"\"\n    items: dict[str, dict[str, dict]] = {}\n    if not records_dir.is_dir():\n        return items\n    for item_dir in sorted(p for p in records_dir.iterdir() if p.is_dir()):\n        by_stage: dict[str, dict[int, dict]] = {}\n        for rec in sorted(item_dir.glob(\"*.json\")):\n            m = RECORD_RE.match(rec.name)\n            if not m:\n                continue\n            stage, n = m.group(1), int(m.group(2))\n            try:\n                data = _load_record(rec, item_dir.name)\n            except json.JSONDecodeError:\n                continue\n            by_stage.setdefault(stage, {})[n] = data\n        items[item_dir.name] = {stage: attempts[max(attempts)] for stage, attempts in by_stage.items()}\n    return items\n\n\n# --- doctor's three proofs ---\n\ndef proof_every_gate_rejects(root: Path, m: dict | None) -> Proof:\n    p = Proof(\"every-gate-rejects\", \"every gate rejects its fixture\")\n    if m is None:\n        return p.fail(f\"no {MANIFEST} at {root}; no gate is registered\")\n    gates = m.get(\"gates\") or {}\n    if not gates:\n        return p.fail(\"[gates] is empty; a gate that has rejected nothing does not exist\")\n    fixtures = root / m.get(\"paths\", {}).get(\"rejections\", \"\")\n    # Proposal, not yet ruled on (issue #54): a gate that retires nothing\n    # only adds, so proof one reports it here rather than waiting on the\n    # schema alone -- read_manifest never validates against the manifest\n    # schema at runtime, so a schema requirement is not an enforced one.\n    no_retires = [name for name, gate in sorted(gates.items()) if not gate.get(\"retires\")]\n    missing, accepted = [], []\n    for name, gate in sorted(gates.items()):\n        fixture = fixtures / name\n        if not fixture.is_dir():\n            missing.append(name)\n            continue\n        env = dict(os.environ)\n        item = fixture_item_id(fixture)\n        if item is not None:\n            env[\"ATTAVO_ITEM\"] = item\n        run = subprocess.run(gate[\"command\"], shell=True, cwd=str(fixture),\n                             capture_output=True, text=True, check=False, env=env)\n        if run.returncode == 0:\n            accepted.append(name)\n    if missing:\n        return p.fail(f\"gate(s) with no rejection fixture: {', '.join(missing)}\")\n    if accepted:\n        return p.fail(f\"gate(s) that accepted their rejection fixture: {', '.join(accepted)}\")\n    if no_retires:\n        return p.fail(f\"gate(s) with no retires: {', '.join(no_retires)}\")\n    return p.hold(f\"{len(gates)} gate(s) rejected their fixture\")\n\n\ndef _merges_reachable(root: Path) -> list[dict]:\n    \"\"\"Every merge commit reachable from HEAD -- sha, parents, and its own\n    first-parent diff -- read by one process rather than the git log plus\n    one git diff per merge merge_introducing_records used to pay walking\n    toward the one it wants (issue #153). --diff-merges=first-parent gives\n    each merge's diff against its first parent in the same pass git log\n    --merges already makes to list them, in the same order.\"\"\"\n    try:\n        out = git(root, \"log\", \"--merges\", \"--diff-merges=first-parent\", \"--name-only\",\n                 \"--format=\\x01%H\\x1f%P\")\n    except RuntimeError:\n        return []\n    merges = []\n    for block in out.split(\"\\x01\")[1:]:\n        header, _, rest = block.partition(\"\\n\")\n        sha, parents = header.split(\"\\x1f\")\n        merges.append({\"sha\": sha, \"parents\": parents.split(),\n                       \"touched\": [line for line in rest.splitlines() if line.strip()]})\n    return merges\n\n\ndef merge_introducing_records(root: Path, records_rel: str, item: str,\n                              stages: tuple[str, ...],\n                              merges: list[dict] | None = None) -> str | None:\n    \"\"\"The merge commit reachable from HEAD whose first-parent diff\n    introduces a record for every one of stages, under\n    records_rel/item/ -- the same derivation attest itself uses\n    (derive_attest_items), read here so proof two requires an item's\n    stage records to have arrived by an actual merge, not merely to sit\n    in the tree (issue #69, acceptance row 4).\n\n    merges, when given, is _merges_reachable's own result -- ledger's\n    cmd_ledger computes it once and passes it to every item rather than\n    walking HEAD's merges again for each (issue #153); left None, a caller\n    with just the one item to ask (doctor's proof two) gets it computed\n    here.\"\"\"\n    if merges is None:\n        merges = _merges_reachable(root)\n    prefix = f\"{records_rel.rstrip('/')}/{item}/\"\n    for merge in merges:\n        found: set[str] = set()\n        for p in merge[\"touched\"]:\n            if p.startswith(prefix):\n                m = RECORD_RE.match(Path(p).name)\n                if m:\n                    found.add(m.group(1))\n        if all(s in found for s in stages):\n            return merge[\"sha\"]\n    return None\n\n\ndef proof_one_item_every_stage(root: Path, m: dict | None) -> Proof:\n    p = Proof(\"one-item-every-stage\", \"one item has traversed every stage\")\n    if m is None:\n        return p.fail(f\"no {MANIFEST} at {root}; no records directory is declared\")\n    records_rel = m.get(\"paths\", {}).get(\"records\", \"\")\n    records_dir = root / records_rel\n    items = load_records(records_dir)\n    if not items:\n        return p.fail(f\"no work item under {records_dir.relative_to(root)}\")\n    complete = [item for item, stages in items.items() if all(s in stages for s in STAGES)]\n    if not complete:\n        best = max(items.items(), key=lambda kv: len(kv[1]))\n        lacking = [s for s in STAGES if s not in best[1]]\n        return p.fail(f\"no item carries every stage; item {best[0]} lacks {', '.join(lacking)}\")\n\n    # issue #74: a complete item is counted only when its chain holds --\n    # attavo attest refuses a build re-approved after the fact or a\n    # verify whose build went stale, and the coherence gate refuses the\n    # merge group on exactly that; a proof that never asked would call a\n    # traversal the gate itself would not let through. The refusal text\n    # is check_attest_chain's own, never re-typed here.\n    refused, held, unmerged = [], [], []\n    for item in complete:\n        chain, message = check_attest_chain(records_dir / item, item)\n        if chain is None:\n            refused.append(f\"item {item}: {message}\")\n            continue\n        merge_sha = merge_introducing_records(root, records_rel, item, STAGES)\n        if merge_sha:\n            held.append((item, merge_sha))\n        else:\n            unmerged.append(item)\n\n    if held:\n        names = \", \".join(item for item, _ in held)\n        shas = \", \".join(sha[:12] for _, sha in held)\n        return p.hold(f\"item(s) {names} carry {', '.join(STAGES)} with the chain held, \"\n                      f\"merged at {shas}\")\n    if refused:\n        return p.fail(\"; \".join(refused))","numLines":150,"startLine":719,"totalLines":3476}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013iDRRHcJPBDWXm3h6fnsua","type":"tool_result","content":"676:def stream_line_events(obj: dict) -> list[tuple[str, str]]:\n677-    \"\"\"[(kind, text), ...] for one parsed stream-json line -- zero, one,\n678-    or several (one assistant turn can carry a text block and a tool_use\n679-    block together, each its own event). An assistant message's text\n680-    block maps to \"message\", its tool_use blocks to \"tool_call\" (the\n681-    tool's name and its first string argument); a user message carrying\n682-    a tool_result block maps to \"tool_result\" (the result's own first\n683-    line). Everything else on the stream -- system, and \"result\" itself,\n684-    read separately for the report fields rather than rendered as a feed\n685-    line -- maps to nothing.\"\"\"\n686-    events: list[tuple[str, str]] = []\n687-    content = ((obj.get(\"message\") or {}).get(\"content\") or [])\n688-    if obj.get(\"type\") == \"assistant\":\n689-        for block in content:\n690-            if not isinstance(block, dict):\n691-                continue\n692-            if block.get(\"type\") == \"text\" and block.get(\"text\"):\n693-                events.append((\"message\", block[\"text\"]))\n694-            elif block.get(\"type\") == \"tool_use\":\n695-                name = block.get(\"name\") or \"\"\n696-                arg = first_string_arg(block.get(\"input\"))\n697-                events.append((\"tool_call\", f\"{name} {arg}\".strip()))\n698-    elif obj.get(\"type\") == \"user\":\n699-        for block in content:\n700-            if isinstance(block, dict) and block.get(\"type\") == \"tool_result\":\n701-                text = tool_result_content_text(block.get(\"content\"))\n702-                first_line = text.splitlines()[0] if text.splitlines() else \"\"\n703-                events.append((\"tool_result\", first_line))\n704-    return events\n705-\n706-","is_error":false}]},"parent_tool_use_id":null,"session_id":"8d8fb43f-35f0-4276-ae71-672938d8a56b","uuid":"afe5abdd-c12a-4b6a-b4fa-96a837d4f8d4","timestamp":"2026-09-17T20:08:25.714Z","tool_use_result":{"stdout":"676:def stream_line_events(obj: dict) -> list[tuple[str, str]]:\n677-    \"\"\"[(kind, text), ...] for one parsed stream-json line -- zero, one,\n678-    or several (one assistant turn can carry a text block and a tool_use\n679-    block together, each its own event). An assistant message's text\n680-    block maps to \"message\", its tool_use blocks to \"tool_call\" (the\n681-    tool's name and its first string argument); a user message carrying\n682-    a tool_result block maps to \"tool_result\" (the result's own first\n683-    line). Everything else on the stream -- system, and \"result\" itself,\n684-    read separately for the report fields rather than rendered as a feed\n685-    line -- maps to nothing.\"\"\"\n686-    events: list[tuple[str, str]] = []\n687-    content = ((obj.get(\"message\") or {}).get(\"content\") or [])\n688-    if obj.get(\"type\") == \"assistant\":\n689-        for block in content:\n690-            if not isinstance(block, dict):\n691-                continue\n692-            if block.get(\"type\") == \"text\" and block.get(\"text\"):\n693-                events.append((\"message\", block[\"text\"]))\n694-            elif block.get(\"type\") == \"tool_use\":\n695-                name = block.get(\"name\") or \"\"\n696-                arg = first_string_arg(block.get(\"input\"))\n697-                events.append((\"tool_call\", f\"{name} {arg}\".strip()))\n698-    elif obj.get(\"type\") == \"user\":\n699-        for block in content:\n700-            if isinstance(block, dict) and block.get(\"type\") == \"tool_result\":\n701-                text = tool_result_content_text(block.get(\"content\"))\n702-                first_line = text.splitlines()[0] if text.splitlines() else \"\"\n703-                events.append((\"tool_result\", first_line))\n704-  
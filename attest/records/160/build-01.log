{"type":"assistant","message":{"model":"claude-sonnet-5","id":"msg_011Cf9ckip8VCN7t9dQ4cs7i","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01GN5tPzk674Kxy1snuFGsH1","name":"Write","input":{"file_path":"/Users/davidbean/Projects/attavo-worktree-160/tests/test_adapter_boundary.py","content":"\"\"\"adapters/claude-code/run at its boundary with the executor's output:\nnothing on the stream makes the adapter raise, and an absent question is\na report, never an exit with no report line (issue #150 and the #151\nbuild-02 crash, 2026-09-17).\n\nRun: python3 -m pytest tests -q\n\"\"\"\nimport json\n\nfrom test_adapter_claude_code import RESULT_LINE, read_events, run_with_stream\n\n\ndef test_claude_code_ignores_a_stream_event_with_a_string_message(tmp_path):\n    \"\"\"The #151 build-02 specimen: a stream line whose \"message\" is a\n    string raised AttributeError inside stream_line_events. It now maps\n    to nothing -- stays transcript, writes no event -- and the run\n    continues to the terminal \"result\" line unaffected.\"\"\"\n    diagnostic = {\"type\": \"rate_limit_event\", \"message\": \"rate limit status\"}\n    run = run_with_stream(tmp_path, [diagnostic, RESULT_LINE])\n    assert run.returncode == 0, run.stdout + run.stderr\n    assert json.dumps(diagnostic) in run.stdout\n    assert json.loads(run.stdout.splitlines()[-1])[\"status\"] == \"done\"\n    assert read_events(tmp_path) == []\n\n\ndef test_claude_code_ignores_a_stream_event_whose_content_is_not_a_list(tmp_path):\n    \"\"\"One field guarded of many (spec for #160): a \"content\" that is not\n    a list is the same class of shape mismatch as a string \"message\",\n    and maps to nothing rather than raising.\"\"\"\n    odd = {\"type\": \"assistant\", \"message\": {\"content\": \"a bare string\"}}\n    run = run_with_stream(tmp_path, [odd, RESULT_LINE])\n    assert run.returncode == 0, run.stdout + run.stderr\n    assert json.loads(run.stdout.splitlines()[-1])[\"status\"] == \"done\"\n    assert read_events(tmp_path) == []\n\n\ndef test_claude_code_null_question_is_a_report_and_ends_as_non_question(tmp_path):\n    \"\"\"Issue #150, three specimens on 2026-09-17: a status update in the\n    question channel (status \"question\", question null) was classed\n    \"fail\" -- exit 1, no report line. It is now classed \"report\", the\n    same class issue #88 already gives a question with no \"?\" in it: the\n    adapter re-invokes once, and a second report in a row still halts,\n    but with a report line carrying class \"non-question\" and the tokens\n    both calls spent.\"\"\"\n    null_question = dict(RESULT_LINE, structured_output={\"status\": \"question\", \"question\": None})\n    run = run_with_stream(tmp_path, [null_question])\n    assert run.returncode == 0, run.stdout + run.stderr\n    line = json.loads(run.stdout.splitlines()[-1])\n    assert line[\"status\"] == \"question\"\n    assert line[\"class\"] == \"non-question\"\n    assert line[\"tokens\"][\"input\"] > 0\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1225,"cache_read_input_tokens":80209,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1225},"output_tokens":8,"service_tier":"standard","inference_geo":"not_available"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"8d8fb43f-35f0-4276-ae71-672938d8a56b","uuid":"cb1428f7-13a9-460c-88c6-cb908f0aedac","timestamp":"2026-09-17T20:09:11.050Z","request_id":"req_011Cf9ckiNpiukBMZ8CYfrkm","wire_tool_inputs":{"toolu_01GN5tPzk674Kxy1snuFGsH1":{"file_path":"/Users/davidbean/Projects/attavo-worktree-160/tests/test_adapter_boundary.py","content":"\"\"\"adapters/claude-code/run at its boundary with the executor's output:\nnothing on the stream makes the adapter raise, and an absent question is\na report, never an exit with no report line (issue #150 and the #151\nbuild-02 crash, 2026-09-17).\n\nRun: python3 -m pytest tests -q\n\"\"\"\nimport json\n\nfrom test_adapter_claude_code import RESULT_LINE, read_events, run_with_stream\n\n\ndef test_claude_code_ignores_a_stream_event_with_a_string_message(tmp_path):\n    \"\"\"The #151 build-02 specimen: a stream line whose \"message\" is a\n    string raised AttributeError inside stream_line_events. It now maps\n    to nothing -- stays transcript, writes no event -- and the run\n    continues to the terminal \"result\" line unaffected.\"\"\"\n    diagnostic = {\"type\": \"rate_limit_event\", \"message\": \"rate limit status\"}\n    run = run_with_stream(tmp_path, [diagnostic, RESULT_LINE])\n    assert run.returncode == 0, run.stdout + run.stderr\n    assert json.dumps(diagnostic) in run.stdout\n    assert json.loads(run.stdout.splitlines()[-1])[\"status\"] == \"done\"\n    assert read_events(tmp_path) == []\n\n\ndef test_claude_code_ignores_a_stream_event_whose_content_is_not_a_list(tmp_path):\n    \"\"\"One field guarded of many (spec for #160): a \"content\" that is not\n    a list is the same class of shape mismatch as a string \"message\",\n    and maps to nothing rather than raising.\"\"\"\n    odd = {\"type\": \"assistant\", \"message\": {\"content\": \"a bare string\"}}\n    run = run_with_stream(tmp_path, [odd, RESULT_LINE])\n    assert run.returncode == 0, run.stdout + run.stderr\n    assert json.loads(run.stdout.splitlines()[-1])[\"status\"] == \"done\"\n    assert read_events(tmp_path) == []\n\n\ndef test_claude_code_null_question_is_a_report_and_ends_as_non_question(tmp_path):\n    \"\"\"Issue #150, three specimens on 2026-09-17: a status update in the\n    question channel (status \"question\", question null) was classed\n    \"fail\" -- exit 1, no report line. It is now classed \"report\", the\n    same class issue #88 already gives a question with no \"?\" in it: the\n    adapter re-invokes once, and a second report in a row still halts,\n    but with a report line carrying class \"non-question\" and the tokens\n    both calls spent.\"\"\"\n    null_question = dict(RESULT_LINE, structured_output={\"status\": \"question\", \"question\": None})\n    run = run_with_stream(tmp_path, [null_question])\n    assert run.returncode == 0, run.stdout + run.stderr\n    line = json.loads(run.stdout.splitlines()[-1])\n    assert line[\"status\"] == \"question\"\n    assert line[\"class\"] == \"non-question\"\n    assert line[\"tokens\"][\"input\"] > 0\n"}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01ANHxepbxFKjvZkhZahS56S","type":"tool_result","content":"1\t\"\"\"adapters/claude-code/run's stream-json mapping (issue #26): a real\n2\tinvocation now speaks `--output-format stream-json --verbose`, read line\n3\tby line as it runs rather than buffered until the process exits.\n4\tATTAVO_ADAPTER_STREAM_FILE feeds a recorded transcript (one JSONL line\n5\tper entry, the shape a real invocation's stdout would carry) through the\n6\tsame mapping and terminal \"result\" read a live invocation gets, without\n7\trunning `claude` -- distinct from ATTAVO_ADAPTER_RESPONSE_FILE\n8\t(tests/test_adapters.py), which still feeds the final report object\n9\tdirectly and is untouched by this lane.\n10\t\n11\tRejection tests, written and run red first: on `main` before this issue\n12\t`--output-format` was \"json\", a single buffered object, and\n13\tATTAVO_ADAPTER_STREAM_FILE did not exist.\n14\t\n15\tRun: python3 -m pytest tests -q\n16\t\"\"\"\n17\timport json\n18\timport os\n19\timport subprocess\n20\tfrom pathlib import Path\n21\t\n22\tfrom helpers import FIXTURES\n23\t\n24\tROOT = Path(__file__).resolve().parent.parent\n25\tCLAUDE_CODE_RUN = ROOT / \"adapters\" / \"claude-code\" / \"run\"\n26\t\n27\tRESULT_LINE = {\n28\t    \"type\": \"result\",\n29\t    \"is_error\": False,\n30\t    \"structured_output\": {\"status\": \"done\", \"question\": None},\n31\t    \"usage\": {\"input_tokens\": 5, \"output_tokens\": 9},\n32\t    \"total_cost_usd\": 0.01,\n33\t    \"modelUsage\": {\"claude-sonnet-5\": {\"inputTokens\": 5, \"outputTokens\": 9}},\n34\t}\n35\t\n36\tSTREAM_LINES = [\n37\t    {\"type\": \"system\", \"subtype\": \"init\"},\n38\t    {\"type\": \"assistant\", \"message\": {\"content\": [\n39\t        {\"type\": \"text\", \"text\": \"Reading the spec before I start.\"}]}},\n40\t    {\"type\": \"assistant\", \"message\": {\"content\": [\n41\t        {\"type\": \"tool_use\", \"name\": \"Read\", \"input\": {\"file_path\": \"spec.md\"}}]}},\n42\t    {\"type\": \"user\", \"message\": {\"content\": [\n43\t        {\"type\": \"tool_result\", \"content\": \"## Problem\\nsecond line\\n\"}]}},\n44\t    RESULT_LINE,\n45\t]\n46\t\n47\t\n48\tdef base_env(tmp_path: Path) -> dict:\n49\t    spec_dir = FIXTURES / \"build_valid\" / \"specs\" / \"1\"\n50\t    env = dict(os.environ)\n51\t    env.pop(\"ATTAVO_CHECKS_COMMAND\", None)\n52\t    env.update({\n53\t        \"ATTAVO_SPEC_DIR\": str(spec_dir),\n54\t        \"ATTAVO_RECORDS_DIR\": str(tmp_path / \"records\"),\n55\t        \"ATTAVO_RULINGS\": str(tmp_path / \"rulings.md\"),\n56\t        \"ATTAVO_BRANCH\": \"attavo/1-example\",\n57\t        \"ATTAVO_ITERATION\": \"1\",\n58\t        \"ATTAVO_FEEDBACK\": str(tmp_path / \"feedback.txt\"),\n59\t    })\n60\t    return env\n61\t\n62\t\n63\tdef run_with_stream(tmp_path: Path, lines: list[dict], events: bool = True,\n64\t                    extra_env: dict | None = None) -> subprocess.CompletedProcess:\n65\t    stream_file = tmp_path / \"stream.jsonl\"\n66\t    stream_file.write_text(\"\\n\".join(json.dumps(l) for l in lines) + \"\\n\")\n67\t    env = base_env(tmp_path)\n68\t    env[\"ATTAVO_ADAPTER_STREAM_FILE\"] = str(stream_file)\n69\t    if events:\n70\t        env[\"ATTAVO_EVENTS\"] = str(tmp_path / \"events.jsonl\")\n71\t    if extra_env:\n72\t        env.update(extra_env)\n73\t    return subprocess.run([str(CLAUDE_CODE_RUN)], capture_output=True, text=True,\n74\t                          check=False, env=env)\n75\t\n76\t\n77\tdef read_events(tmp_path: Path) -> list[dict]:\n78\t    path = tmp_path / \"events.jsonl\"\n79\t    if not path.is_file():\n80\t        return []\n81\t    return [json.loads(l) for l in path.read_text().splitlines() if l.strip()]\n82\t\n83\t\n84\tdef test_claude_code_maps_a_recorded_stream_to_events_and_the_same_report_fields(tmp_path):\n85\t    \"\"\"Acceptance row 3. A recorded stream-json transcript maps to one\n86\t    event per assistant text block, tool_use block, and tool_result\n87\t    block, in order, each {at, kind, text}; the terminal \"result\" object\n88\t    feeds the same model/tokens/cost derivation the old --output-format\n89\t    json response did -- the record is byte-for-byte what it was.\n90\t    \"\"\"\n91\t    run = run_with_stream(tmp_path, STREAM_LINES)\n92\t    assert run.returncode == 0, run.stdout + run.stderr\n93\t\n94\t    line = json.loads(run.stdout.splitlines()[-1])\n95\t    assert line[\"model\"] == \"claude-sonnet-5\"\n96\t    assert line[\"tokens\"] == {\"input\": 5, \"output\": 9}\n97\t    assert line[\"cost_usd\"] == 0.01\n98\t    assert line[\"status\"] == \"done\"\n99\t\n100\t    events = read_events(tmp_path)\n101\t    assert [e[\"kind\"] for e in events] == [\"message\", \"tool_call\", \"tool_result\"]\n102\t    assert all(set(e) == {\"at\", \"kind\", \"text\"} for e in events)\n103\t    assert events[0][\"text\"] == \"Reading the spec before I start.\"\n104\t    assert events[1][\"text\"] == \"Read spec.md\"\n105\t    assert events[2][\"text\"] == \"## Problem\"\n106\t\n107\t\n108\tdef test_claude_code_stream_transcript_still_reaches_stdout(tmp_path):\n109\t    \"\"\"Every raw line the stream carried, mapped or not, still reaches\n110\t    stdout (and so build-NN.log) -- issue #34's guarantee, unbroken by\n111\t    the switch to reading the stream line by line.\"\"\"\n112\t    run = run_with_stream(tmp_path, STREAM_LINES)\n113\t    assert run.returncode == 0, run.stdout + run.stderr\n114\t    for raw_line in STREAM_LINES:\n115\t        assert json.dumps(raw_line) in run.stdout\n116\t\n117\t\n118\tdef test_claude_code_tool_call_event_is_one_line_and_capped_at_400_chars(tmp_path):\n119\t    \"\"\"Acceptance row 4. A tool's argument can be a whole file: the\n120\t    mapped event text is collapsed to one line and capped at 400\n121\t    characters, the feed renders lines.\"\"\"\n122\t    long_arg = \"line one\\nline two\\n\" + (\"x\" * 500)\n123\t    stream = [\n124\t        {\"type\": \"assistant\", \"message\": {\"content\": [\n125\t            {\"type\": \"tool_use\", \"name\": \"Bash\", \"input\": {\"command\": long_arg}}]}},\n126\t        RESULT_LINE,\n127\t    ]\n128\t    run = run_with_stream(tmp_path, stream)\n129\t    assert run.returncode == 0, run.stdout + run.stderr\n130\t\n131\t    events = read_events(tmp_path)\n132\t    assert len(events) == 1\n133\t    text = events[0][\"text\"]\n134\t    assert \"\\n\" not in text\n135\t    assert len(text) <= 400\n136\t\n137\t\n138\tdef test_claude_code_no_events_file_when_atavo_events_is_unset(tmp_path):\n139\t    \"\"\"An adapter invocation with no ATTAVO_EVENTS writes no events file\n140\t    -- the mapping only ever writes to a path the product handed it.\"\"\"\n141\t    run = run_with_stream(tmp_path, STREAM_LINES, events=False)\n142\t    assert run.returncode == 0, run.stdout + run.stderr\n143\t    assert not (tmp_path / \"events.jsonl\").exists()\n144\t\n145\t\n146\tdef test_claude_code_stream_missing_result_line_fails(tmp_path):\n147\t    \"\"\"A 0-exit stream that never carries a terminal \"result\" line is a\n148\t    failure, the same class build already treats a tool error or an\n149\t    absent structured_output as -- not a crash, and not a silent pass.\"\"\"\n150\t    stream = [{\"type\": \"assistant\", \"message\": {\"content\": [\n151\t        {\"type\": \"text\", \"text\": \"still working\"}]}}]\n152\t    run = run_with_stream(tmp_path, stream)\n153\t    assert run.returncode == 1\n154\t"}]},"parent_tool_use_id":null,"session_id":"8d8fb43f-35f0-4276-ae71-672938d8a56b","uuid":"343c8fcb-87ef-4e31-ba88-083f86bcd652","timestamp":"2026-09-17T20:07:37.788Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-160/tests/test_adapter_claude_code.py","content":"\"\"\"adapters/claude-code/run's stream-json mapping (issue #26): a real\ninvocation now speaks `--output-format stream-json --verbose`, read line\nby line as it runs rather than buffered until the process exits.\nATTAVO_ADAPTER_STREAM_FILE feeds a recorded transcript (one JSONL line\nper entry, the shape a real invocation's stdout would carry) through the\nsame mapping and terminal \"result\" read a live invocation gets, without\nrunning `claude` -- distinct from ATTAVO_ADAPTER_RESPONSE_FILE\n(tests/test_adapters.py), which still feeds the final report object\ndirectly and is untouched by this lane.\n\nRejection tests, written and run red first: on `main` before this issue\n`--output-format` was \"json\", a single buffered object, and\nATTAVO_ADAPTER_STREAM_FILE did not exist.\n\nRun: python3 -m pytest tests -q\n\"\"\"\nimport json\nimport os\nimport subprocess\nfrom pathlib import Path\n\nfrom helpers import FIXTURES\n\nROOT = Path(__file__).resolve().parent.parent\nCLAUDE_CODE_RUN = ROOT / \"adapters\" / \"claude-code\" / \"run\"\n\nRESULT_LINE = {\n    \"type\": \"result\",\n    \"is_error\": False,\n    \"structured_output\": {\"status\": \"done\", \"question\": None},\n    \"usage\": {\"input_tokens\": 5, \"output_tokens\": 9},\n    \"total_cost_usd\": 0.01,\n    \"modelUsage\": {\"claude-sonnet-5\": {\"inputTokens\": 5, \"outputTokens\": 9}},\n}\n\nSTREAM_LINES = [\n    {\"type\": \"system\", \"subtype\": \"init\"},\n    {\"type\": \"assistant\", \"message\": {\"content\": [\n        {\"type\": \"text\", \"text\": \"Reading the spec before I start.\"}]}},\n    {\"type\": \"assistant\", \"message\": {\"content\": [\n        {\"type\": \"tool_use\", \"name\": \"Read\", \"input\": {\"file_path\": \"spec.md\"}}]}},\n    {\"type\": \"user\", \"message\": {\"content\": [\n        {\"type\": \"tool_result\", \"content\": \"## Problem\\nsecond line\\n\"}]}},\n    RESULT_LINE,\n]\n\n\ndef base_env(tmp_path: Path) -> dict:\n    spec_dir = FIXTURES / \"build_valid\" / \"specs\" / \"1\"\n    env = dict(os.environ)\n    env.pop(\"ATTAVO_CHECKS_COMMAND\", None)\n    env.update({\n        \"ATTAVO_SPEC_DIR\": str(spec_dir),\n        \"ATTAVO_RECORDS_DIR\": str(tmp_path / \"records\"),\n        \"ATTAVO_RULINGS\": str(tmp_path / \"rulings.md\"),\n        \"ATTAVO_BRANCH\": \"attavo/1-example\",\n        \"ATTAVO_ITERATION\": \"1\",\n        \"ATTAVO_FEEDBACK\": str(tmp_path / \"feedback.txt\"),\n    })\n    return env\n\n\ndef run_with_stream(tmp_path: Path, lines: list[dict], events: bool = True,\n                    extra_env: dict | None = None) -> subprocess.CompletedProcess:\n    stream_file = tmp_path / \"stream.jsonl\"\n    stream_file.write_text(\"\\n\".join(json.dumps(l) for l in lines) + \"\\n\")\n    env = base_env(tmp_path)\n    env[\"ATTAVO_ADAPTER_STREAM_FILE\"] = str(stream_file)\n    if events:\n        env[\"ATTAVO_EVENTS\"] = str(tmp_path / \"events.jsonl\")\n    if extra_env:\n        env.update(extra_env)\n    return subprocess.run([str(CLAUDE_CODE_RUN)], capture_output=True, text=True,\n                          check=False, env=env)\n\n\ndef read_events(tmp_path: Path) -> list[dict]:\n    path = tmp_path / \"events.jsonl\"\n    if not path.is_file():\n        return []\n    return [json.loads(l) for l in path.read_text().splitlines() if l.strip()]\n\n\ndef test_claude_code_maps_a_recorded_stream_to_events_and_the_same_report_fields(tmp_path):\n    \"\"\"Acceptance row 3. A recorded stream-json transcript maps to one\n    event per assistant text block, tool_use block, and tool_result\n    block, in order, each {at, kind, text}; the terminal \"result\" object\n    feeds the same model/tokens/cost derivation the old --output-format\n    json response did -- the record is byte-for-byte what it was.\n    \"\"\"\n    run = run_with_stream(tmp_path, STREAM_LINES)\n    assert run.returncode == 0, run.stdout + run.stderr\n\n    line = json.loads(run.stdout.splitlines()[-1])\n    assert line[\"model\"] == \"claude-sonnet-5\"\n    assert line[\"tokens\"] == {\"input\": 5, \"output\": 9}\n    assert line[\"cost_usd\"] == 0.01\n    assert line[\"status\"] == \"done\"\n\n    events = read_events(tmp_path)\n    assert [e[\"kind\"] for e in events] == [\"message\", \"tool_call\", \"tool_result\"]\n    assert all(set(e) == {\"at\", \"kind\", \"text\"} for e in events)\n    assert events[0][\"text\"] == \"Reading the spec before I start.\"\n    assert events[1][\"text\"] == \"Read spec.md\"\n    assert events[2][\"text\"] == \"## Problem\"\n\n\ndef test_claude_code_stream_transcript_still_reaches_stdout(tmp_path):\n    \"\"\"Every raw line the stream carried, mapped or not, still reaches\n    stdout (and so build-NN.log) -- issue #34's guarantee, unbroken by\n    the switch to reading the stream line by line.\"\"\"\n    run = run_with_stream(tmp_path, STREAM_LINES)\n    assert run.returncode == 0, run.stdout + run.stderr\n    for raw_line in STREAM_LINES:\n        assert json.dumps(raw_line) in run.stdout\n\n\ndef test_claude_code_tool_call_event_is_one_line_and_capped_at_400_chars(tmp_path):\n    \"\"\"Acceptance row 4. A tool's argument can be a whole file: the\n    mapped event text is collapsed to one line and capped at 400\n    characters, the feed renders lines.\"\"\"\n    long_arg = \"line one\\nline two\\n\" + (\"x\" * 500)\n    stream = [\n        {\"type\": \"assistant\", \"message\": {\"content\": [\n            {\"type\": \"tool_use\", \"name\": \"Bash\", \"input\": {\"command\": long_arg}}]}},\n        RESULT_LINE,\n    ]\n    run = run_with_stream(tmp_path, stream)\n    assert run.returncode == 0, run.stdout + run.stderr\n\n    events = read_events(tmp_path)\n    assert len(events) == 1\n    text = events[0][\"text\"]\n    assert \"\\n\" not in text\n    assert len(text) <= 400\n\n\ndef test_claude_code_no_events_file_when_atavo_events_is_unset(tmp_path):\n    \"\"\"An adapter invocation with no ATTAVO_EVENTS writes no events file\n    -- the mapping only ever writes to a path the product handed it.\"\"\"\n    run = run_with_stream(tmp_path, STREAM_LINES, events=False)\n    assert run.returncode == 0, run.stdout + run.stderr\n    assert not (tmp_path / \"events.jsonl\").exists()\n\n\ndef test_claude_code_stream_missing_result_line_fails(tmp_path):\n    \"\"\"A 0-exit stream that never carries a terminal \"result\" line is a\n    failure, the same class build already treats a tool error or an\n    absent structured_output as -- not a crash, and not a silent pass.\"\"\"\n    stream = [{\"type\": \"assistant\", \"message\": {\"content\": [\n        {\"type\": \"text\", \"text\": \"still working\"}]}}]\n    run = run_with_stream(tmp_path, stream)\n    assert run.returncode == 1\n","numLines":154,"startLine":1,"totalLines":154}}}

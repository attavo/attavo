tream_event_whose_content_is_not_a_list(tmp_path):\\n    \\\"\\\"\\\"One field guarded of many (spec for #160): a \\\"content\\\" that is not\\n    a list is the same class of shape mismatch as a string \\\"message\\\",\\n    and maps to nothing rather than raising.\\\"\\\"\\\"\\n    odd = {\\\"type\\\": \\\"assistant\\\", \\\"message\\\": {\\\"content\\\": \\\"a bare string\\\"}}\\n    run = run_with_stream(tmp_path, [odd, RESULT_LINE])\\n    assert run.returncode == 0, run.stdout + run.stderr\\n    assert json.loads(run.stdout.splitlines()[-1])[\\\"status\\\"] == \\\"done\\\"\\n    assert read_events(tmp_path) == []\\n\\n\\ndef test_claude_code_null_question_is_a_report_and_ends_as_non_question(tmp_path):\\n    \\\"\\\"\\\"Issue #150, three specimens on 2026-09-17: a status update in the\\n    question channel (status \\\"question\\\", question null) was classed\\n    \\\"fail\\\" -- exit 1, no report line. It is now classed \\\"report\\\", the\\n    same class issue #88 already gives a question with no \\\"?\\\" in it: the\\n    adapter re-invokes once, and a second report in a row still halts,\\n    but with a report line carrying class \\\"non-question\\\" and the tokens\\n    both calls spent.\\\"\\\"\\\"\\n    null_question = dict(RESULT_LINE, structured_output={\\\"status\\\": \\\"question\\\", \\\"question\\\": None})\\n    run = run_with_stream(tmp_path, [null_question])\\n    assert run.returncode == 0, run.stdout + run.stderr\\n    line = json.loads(run.stdout.splitlines()[-1])\\n    assert line[\\\"status\\\"] == \\\"question\\\"\\n    assert line[\\\"class\\\"] == \\\"non-question\\\"\\n    assert line[\\\"tokens\\\"][\\\"input\\\"] > 0\\n\"},\"caller\":{\"type\":\"direct\"}}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":1225,\"cache_read_input_tokens\":80209,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":1225},\"outp
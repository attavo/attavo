tWindow\":200000,\"maxOutputTokens\":32000,\"thinkingTokens\":0,\"canonicalModel\":\"claude-haiku-4-5\",\"provider\":\"firstParty\",\"costBasis\":\"list\"},\"claude-sonnet-5\":{\"inputTokens\":110,\"outputTokens\":20313,\"cacheReadInputTokens\":3554764,\"cacheCreationInputTokens\":77631,\"webSearchRequests\":0,\"costUSD\":1.2248268000000004,\"contextWindow\":1000000,\"maxOutputTokens\":64000,\"thinkingTokens\":7920,\"canonicalModel\":\"claude-sonnet-5\",\"provider\":\"firstParty\",\"costBasis\":\"list\"}},\"permission_denials\":[],\"terminal_reason\":\"completed\",\"fast_mode_state\":\"off\",\"fast_mode_disabled_reason\":\"sdk_opt_in_required\",\"subagent_stats\":{\"spawned\":0,\"requested\":{\"background\":0,\"foreground\":0,\"unset\":0},\"started_in_background\":0,\"max_depth\":0,\"spawned_by_subagents\":0,\"completed\":0,\"failed\":0,\"killed\":{\"parent\":0,\"user\":0,\"system\":0},\"refused\":{\"depth_limit\":0,\"concurrency_limit\":0,\"budget\":0},\"by_type\":{}},\"is_error\":false,\"num_turns\":56,\"subtype\":\"success\",\"api_error_status\":null,\"result\":\"{\\\"status\\\":\\\"question\\\",\\\"question\\\":null}\",\"structured_output\":{\"status\":\"question\",\"question\":null},\"ttft_ms\":1359,\"type\":\"result\",\"duration_ms\":330113,\"uuid\":\"68043f0b-c9a8-4bdf-8333-d6ec50170c04\",\"ttft_stream_ms\":710,\"time_to_request_ms\":30,\"first_content_frame_ms\":711,\"queued_turn_count\":0,\"result_index\":0}\n259:{\"type\":\"system\",\"subtype\":\"task_notification\",\"task_id\":\"b6xu4u8qw\",\"tool_use_id\":\"toolu_016KirS6qyg3jHHokgmWQdf6\",\"status\":\"stopped\",\"output_file\":\"/private/tmp/claude-501/-Users-davidbean-Projects-attavo-worktree-160/8d8fb43f-35f0-4276-ae71-672938d8a56b/tasks/b6xu4u8qw.output\",\"summary\":\"Run the tenant's checks command with a sanitized environment matching real check invocation\",\"uuid\":\"ce925ec2-9d5f-4dce-9db6-cc1dbd3c24db\",\"session_id\":\"8d8fb43f-35f0-4276-ae71-672938d8a56b\"}\nattest/specs/160/spec.md\nattest/specs/160/criteria/a-null-question-is-a-report.sh\nattest/specs/160/criteria/a-string-message-is-transcript-not-a-crash.sh\nattest/specs/160/criteria/the-boundary-has-its-tests.sh\n## Problem\n\nThe claude-code adapter reads the executor's output as if its shapes were the adapter's to assume. Two failures on 2026-09-17, three and one specimens: an executor that ended its turn with `status: question, question: null` (a status update in the question channel, three times: #148 build-01, #151 build-01, #153 build-01) was classed `fail` by `question_class`, exit 1 with no report line, so each record is `no-cause / executor` with detail null, tokens 0, and ten minutes lost; and a stream line whose `message` was a string (#151 build-02) raised `AttributeError` inside `stream_line_events`, exit 1, `unclassed / product`, and 1064 s lost. `question_class` already has the class for the first (`report`, issue #88: a re-invocation with the nudge, then `non-question` with both results kept); the null question fell one branch short of it. The second is one field guarded of many.\n\nRetires: `fail` as the class of an absent question; the adapter raising on any shape in the executor's stream.\n\n## Claims\n\n- adapters/claude-code/run\n- tests/test_adapter_boundary.py\n- tests/test_adapters.py\n- tests/test_adapter_claude_code.py\n\n## Criteria\n\n- a-string-message-is-transcript-not-a-crash.sh: a recorded stream carrying a line whose message is a string, then a valid result, exits 0 with status done, keeps the line on stdout as transcript, and writes no event for it\n- a-null-question-is-a-report.sh: a recorded stream whose result is status question with question null exits 0 with a report line of status question and class non-question carrying the tokens spent\n- the-boundary-has-its-tests.sh: the two boundary tests exist by name under tests/\nschema_version = 1\n\n[attavo]\nversion = \"v0.25.0\"\n\n[forge]\nchecks_command = \"python3 .attavo/bin/forge-checks\"\nfile_issue_command = \"python3 .attavo/bin/file-issue\"\n\n[executor]\nbuild = \"claude-code\"\nverify = \"codex\"\n\n[executor.claude-code]\nauth = \"subscription\"\nmodel = \"claude-sonnet-5\"\n\n[executor.codex]\nmodel = \"gpt-5.6-sol\"\n\n[spec]\n[spec.boundary]\npaths = [\"bin/**\", \"adapters/**\", \"schema/**\", \"templates/**\", \"action.yml\", \"scripts/**\"]\n\n[gates]\n[gates.spec]\ncommand = \"attavo spec-gate\"\nretires = [\n  \"the lane as the product's transport: a Claude Code lane session reporting to a reviewing session, with no spec, no approval bound to a commit, no build/verify separation, and no attestation on the product's own commits\",\n  \"the || true step in ci.yml that ran the doctor's four proofs against this repository expected to still fail\",\n  \"the reviewing session as the reader of whether the lane did what the issue said\",\n]\n\n[tests]\nselect = \"python3 .attavo/bin/select-tests\"\nrun = \"xargs -r python3 -m pytest -q --deselect tests/test_doctor.py::test_every_gate_rejects --deselect tests/test_doctor.py::test_one_item_traversed_every_stage --deselect tests/test_doctor.py::test_no_commit_lacks_a_record --deselect tests/test_doctor.py::test_no_stop_lacks_cause\"\n\n[paths]\nspecs = \"attest/specs\"\nrecords = \"attest/records\"\nrulings = \"attest/rulings.md\"\nrejections = \"attest/rejections\"\n\n[operators]\napprovers = [\"dbean10\"]\n\n[checks]\ncommand = \"python3 -m pytest tests -q --deselect tests/test_doctor.py::test_every_gate_rejects --deselect tests/test_doctor.py::test_one_item_traversed_every_stage --deselect tests/test_doctor.py::test_no_commit_lacks_a_record --deselect tests/test_doctor.py::test_no_stop_lacks_cause\"\n","exit_code":0,"status":"completed"}}

 from its outcome. A turn in the conversation is working material and lives in the product's datastore with the item; a record is written only for an outcome the attestation cares about: counsel's verdict on a stop (answer, patch, person); a follow-up whose answer changes what the next attempt is told; or an operator turning a turn into an act (a ruling, a spec amendment, an issue). The record carries the question that produced it. A question that belongs to Plan is answered and routed there; in Execute the only outcomes are those above, so a tangent produces nothing in git however long it runs.\\ntests/test_claims.py:1:\\\"\\\"\\\"attavo claims: work in flight read from git, and an item's collisions\\ntests/test_claims.py:3:there is no claims subcommand and no attavo.claims module.\\ntests/test_claims.py:41:def spec_text(claims: list[str]) -> str:\\ntests/test_claims.py:42:    return (\\\"## Problem\\\\n\\\\nClass: fix\\\\n\\\\nsomething.\\\\n\\\\n## Claims\\\\n\\\\n\\\"\\ntests/test_claims.py:43:            + \\\"\\\".join(f\\\"- {c}\\\\n\\\" for c in claims)\\ntests/test_claims.py:48:    from attavo.claims import overlap\\ntests/test_claims.py:56:def test_claims_lists_unmerged_branches_with_their_spec_claims_and_skips_merged_ones(tmp_path: Path) -> None:\\ntests/test_claims.py:64:    run = run_attavo(root, \\\"claims\\\", \\\"--json\\\")\\ntests/test_claims.py:78:    run = run_attavo(root, \\\"claims\\\", \\\"1\\\")\\ntests/test_claims.py:84:def test_an_item_with_disjoint_claims_exits_zero_and_its_own_branch_is_not_a_collision(tmp_path: Path) -> None:\\ntests/test_claims.py:88:    run = run_attavo(root, \\\"claims\\\", \\\"1\\\", \\\"--json\\\")\\ntests/test_claims.py:91:    assert report[\\\"item\\\"] == \\\"1\\\" and report[\\\"claims\\\"] == [\\\"src/**\\\"], report\\ntests/test_claims.py:95:def test_claims_refuses_by_name_when_the_default_branch_is_not_set(tmp_path: Path) -> None:\\ntests/test_claims.py:98:    run = run_attavo(root, \\\"claims\\\")\\ntests/test_claims.py:107:    assert report[\\\"claims\\\"] == [] and report[\\\"collisions\\\"] == [], report\\ntests/test_claims.py:111:def test_claims_without_an_item_lists_only_even_on_an_item_branch(tmp_path: Path) -> None:\\ntests/test_claims.py:115:    _assert_lists_only(run_attavo(root, \\\"claims\\\", \\\"--json\\\"))\\ntests/test_claims.py:118:def test_claims_without_an_item_ignores_attavo_item(tmp_path: Path) -> None:\\ntests/test_claims.py:121:    _assert_lists_only(run_attavo(root, \\\"claims\\\", \\\"--json\\\", env={\\\"ATTAVO_ITEM\\\": \\\"1\\\"}))\\ndocs/findings/317-test-tool.md:71:**xdist [M].** `python3 -c 'import xdist; print(xdist.__version__)'` -> `3.8.0` (Python 3.14.6, `/opt/homebrew/bin/python3`). It is not declared anywhere on `main`: `ci.yml` installs `pytest jsonschema`, and `[checks].probe` imports `pytest, mypy, jsonschema`. #291 (\\\"pytest -n auto in CI only\\\") is closed, but `ci.yml` at `f4e9c01` does not carry it. Without xdist, `-n auto` is a usage error and the run exits non-zero (`-p no:xdist -n auto`: pytest prints its usage trailer).\\ntests/test_stops.py:75:                 \\\"stop\\\": {\\\"class\\\": \\\"claims-boundary\\\", \\\"provenance\\\": \\\"spec\\\", \\\"detail\\\": None}})\\ntests/test_stops.py:120:    assert totals[\\\"by_class\\\"][\\\"claims-boundary\\\"] == 1\\ntests/test_stops.py:175:    criterion the gate cannot express is not a write outside claims, the\\ntests/test_stops.py:176:    boundary claims-boundary used to name here) -- and a counsel record\\ntests/test_stops.py:203:    \\\"\\\"\\\"Issue #137. Unlike claims-boundary, \\\"gate\\\" is not a guarded class:\\ntests/test_stops.py:255:    pytest.param(\\\"refused\\\", {\\\"refusal_kind\\\": \\\"claims\\\", \\\"refusal\\\": \\\"attavo/common.py\\\"},\\ntests/test_stops.py:256:                 (\\\"claims-boundary\\\", \\\"spec\\\", \\\"attavo/common.py\\\"),\\ntests/test_stops.py:257:                 id=\\\"229-build-03-outside-claims\\\"),\\ntests/test_stops.py:263:                 id=\\\"229-build-05-question\\\"),\\ntests/test_stops.py:282:def test_a_protected_path_refusal_is_claims_boundary_executor() -> None:\\ntests/test_stops.py:285:    assert stop == {\\\"class\\\": \\\"claims-boundary\\\", \\\"provenance\\\": \\\"executor\\\",\\ntests/test_stops.py:291:                            \\\"selected_tests\\\": {\\\"count\\\": 2, \\\"exit\\\": 1}, \\\"checks\\\": {\\\"exit\\\": 1}}\\ntests/test_stops.py:296:def test_a_red_checks_run_alone_classes_gate_naming_the_checks_exit() -> None:\\ntests/test_stops.py:298:                            \\\"selected_tests\\\": {\\\"count\\\": 3, \\\"exit\\\": 0}, \\\"checks\\\": {\\\"exit\\\": 2}}\\ntests/test_stops.py:300:    assert stop == {\\\"class\\\": \\\"gate\\\", \\\"provenance\\\": \\\"executor\\\", \\\"detail\\\": \\\"checks: exit 2\\\"}\\ntests/test_stops.py:354:                              \\\"checks\\\": {\\\"command\\\": \\\"c\\\", \\\"exit\\\": 2}}\\ntests/test_stops.py:357:                         \\\"checks\\\": {\\\"command\\\": \\\"c\\\", \\\"exit\\\": 0}}\\ntests/test_stops.py:372:            \\\"checks\\\": {\\\"exit\\\": fields[\\\"checks\\\"][\\\"exit\\\"]} if fields[\\\"checks\\\"] else None}\\ntests/test_stops.py:383:    pytest.param(*_build_case(\\\"refused\\\", refusal_kind=\\\"claims\\\", refusal=\\\"a.py\\\"), id=\\\"build-claims\\\"),\\ntests/test_stops.py:391:    pytest.param(*_build_case(\\\"halted\\\", halted={\\\"question\\\": \\\"which one?\\\"}), id=\\\"build-question\\\"),\\ntests/test_stops.py:392:    pytest.param(*_build_case(\\\"halted\\\", halted={\\\"question\\\": \\\"\\\"}), id=\\\"build-halt-no-question\\\"),\\ntests/test_stops.py:394:    pytest.param(*_build_case(\\\"failed\\\", report_class=\\\"non-question\\\"),\\ntests/test_stops.py:395:                 id=\\\"build-report-non-question\\\"),\\ndocs/findings/299-draft.md:50:Thin mode on #3 (first filing, today's gate): **refused**, `stub touches a path the claims do not name: tests/__pycache__/test_doctor_gate_runs.cpython-314-pytest-9.1.1.pyc`. The drafter's own collect run left the file in the stub directory. I deleted it and re-ran the gate: **refused**, `criterion fails against the tree plus stub: proof-one-reads-the-gates-exit.sh`. That second refusal is the thin design working as intended (the behavioural criterion cannot pass on a thin stub), not a drafting error.\\ndocs/findings/299-draft.md:63:**The gate can tell the kinds apart mechanically [M].** `run_criteria` already records both exits. A structural criterion is `(non-zero, 0)`; a behavioural one is `(non-zero, non-zero)`. I prototyped A in 20 lines (`attavo/spec.py` in the thin worktree; the patch is `/tmp/spike-299-work/option-a-gate.patch`): a criterion that `spec.md` labels `[behavioural]` is required to fail on the thin stub; one labelled `[structural]`, or unlabelled, is required to pass on it as today. The thin #3 spec then passed (`spec-03.json`, each criterion carries its `kind`). **[P]** The label is a declaration the gate checks against the measured exits, so a mislabel is refused by name.\\ndocs/findings/299-draft.md:69:| build record | `halted`, a question: 707 passed, 6 failed, 116 not run at the 240 s bound; the change is uncommitted | `refused`, class `test-bypass`: the executor ran `git stash push -- ... && python3 -m pytest` outside `attavo test` |\\ndocs/findings/299-draft.md:78:Records: `attest/records/3/build-01.{json,log}` in each worktree. The builder reported `status: question` (thin) and `status: done` (full); the product's own refusal for the full build is a process rule, not a defect found in the diff.\\nattavo/counsel.py:254:    only way a question becomes a record and so the only way it steers.\\\"\\\"\\\"\\nattavo/counsel.py:266:    # otherwise steer build-03 with an answer about build-01.\\nattavo/counsel.py:296:        \\\"verdict\\\": answer.get(\\\"verdict\\\"),\\nattavo/counsel.py:298:        \\\"proposal\\\": {\\\"ruling_text\\\": None, \\\"patch\\\": None, \\\"question\\\": None, \\\"issue\\\": None,\\nattavo/counsel.py:495:              \\\"ruling_text\\\": (rec.get(\\\"proposal\\\") or {}).get(\\\"ruling_text\\\"),\\nattavo/counsel.py:509:                          \\\"ruling_text\\\": (a.get(\\\"proposal\\\") or {}).get(\\\"ruling_text\\\"),\\nattavo/counsel.py:593:    proposal = {\\\"ruling_text\\\": None, \\\"patch\\\": None, \\\"question\\\": None, \\\"issue\\\": None}\\nattavo/counsel.py:596:            and payload.get(\\\"verdict\\\") in (\\\"answer\\\", \\\"patch\\\", \\\"person\\\")):\\nattavo/counsel.py:690:read-only question about it: the record, the spec (problem, claims,\\nattavo/counsel.py:711:verdict (answer: a ruling text with citations; patch: a product\\nattavo/counsel.py:737:question steers nothing. The events tail is read where the product keeps\\nattavo/counsel.py:750:the only way one steers the next attempt.\\\"\\\"\\\"),\\ntests/test_verify.py:87:    toml.write_text(toml.read_text() + '\\\\n[checks]\\\\ncommand = \\\"exit 7\\\"\\\\n')\\ntests/test_record_schemas.py:59:    assert build_rec[\\\"checks\\\"] == {\\\"command\\\": \\\"true\\\", \\\"exit\\\": 0}\\ntests/test_record_schemas.py:328:    record.update({\\\"status\\\": \\\"failed\\\", \\\"refusal\\\": \\\"outside the claims boundary\\\", \\\"halted\\\": None})\\ntests/test_counsel.py:88:    build = run_attavo(root, \\\"build\\\", \\\"1\\\", env={\\\"ATTAVO_FIXTURE_QUESTION\\\": question})\\ntests/test_counsel.py:103:        \\\"citations\\\": [], \\\"proposal\\\": {\\\"ruling_text\\\": None, \\\"patch\\\": None, \\\"question\\\": None},\\ntests/test_counsel.py:163:        proposal={\\\"ruling_text\\\": \\\"checks.sh always exits zero and never fails on the tree\\\",\\ntests/test_counsel.py:175:    assert record[\\\"verdict\\\"] == \\\"answer\\\"\\ntests/test_counsel.py:176:    assert \\\"checks.sh\\\" in record[\\\"proposal\\\"][\\\"ruling_text\\\"]\\ntests/test_counsel.py:194:        proposal={\\\"ruling_text\\\": \\\"use the base tree's overlay\\\", \\\"patch\\\": None, \\\"question\\\": None}))\\ntests/test_counsel.py:211:    assert record[\\\"verdict\\\"] == \\\"answer\\\"\\ntests/test_counsel.py:213:    assert record[\\\"proposal\\\"][\\\"ruling_text\\\"] == \\\"use the base tree's overlay\\\"\\ntests/test_counsel.py:243:    one-line question; ruling_text and patch stay null.\\\"\\\"\\\"\\ntests/test_counsel.py:250:        proposal={\\\"ruling_text\\\": None, \\\"patch\\\": None,\\ntests/test_counsel.py:261:    assert record[\\\"proposal\\\"][\\\"ruling_text\\\"] is None\\ntests/test_counsel.py:265:def test_counsel_answer_verdict_carries_ruling_text_and_three_citations(tmp_path: Path) -> None:\\ntests/test_counsel.py:278:        proposal={\\\"ruling_text\\\": \\\"the overlay wins\\\", \\\"patch\\\": None, \\\"question\\\": None}))\\ntests/test_counsel.py:286:    assert record[\\\"verdict\\\"] == \\\"answer\\\"\\ntests/test_counsel.py:287:    assert record[\\\"proposal\\\"][\\\"ruling_text\\\"] == \\\"the overlay wins\\\"\\ntests/test_counsel.py:305:        \\\"patch\\\", proposal={\\\"ruling_text\\\": None, \\\"patch\\\": patch, \\\"question\\\": None}))\\ntests/test_counsel.py:433:    \\\"proposal\\\": {\\\"ruling_text\\\": None, \\\"patch\\\": None, \\\"question\\\": \\\"noted\\\", \\\"issue\\\": None},\\ntests/test_counsel.py:518:        proposal={\\\"ruling_text\\\": None, \\\"patch\\\": None, \\\"question\\\": None,\\ntests/test_counsel.py:606:    assert \\\"retry\\\" not in (record[\\\"proposal\\\"][\\\"ruling_text\\\"] or \\\"\\\").lower()\\ntests/test_counsel_citations.py:49:    \\\"  'class': 'unclassed', 'verdict': 'answer', 'citations': cites,\\\\n\\\"\\ntests/test_counsel_citations.py:50:    \\\"  'proposal': {'ruling_text': 'x', 'patch': None, 'question': None}}))\\\\n\\\"\\nattavo/plan.py:6:draft claims of issues that have no spec yet (who set them and when); and\\nattavo/plan.py:21:    attavo plan claims #N (<PATH>... | --clear) --by LOGIN\\nattavo/plan.py:28:membership, and write the next. claims sets, or with --clear removes, the\\nattavo/plan.py:30:the branch's own claims govern (attavo/claims.py) and these are not read.\\nattavo/plan.py:53:TOP_KEYS = {\\\"schema\\\", \\\"epics\\\", \\\"edges\\\", \\\"policy\\\", \\\"claims\\\"}\\nattavo/plan.py:133:    claims = body.get(\\\"claims\\\", {})\\nattavo/plan.py:134:    if not isinstance(claims, dict):\\nattavo/plan.py:135:        return errs + [\\\"claims is not an object\\\"]\\nattavo/plan.py:136:    for key, c in claims.items():\\nattavo/plan.py:138:            errs.append(f\\\"claims key {key!r} is not an issue number\\\")\\nattavo/plan.py:140:            errs.append(f\\\"claims {key} is not an object\\\")\\nattavo/plan.py:142:        errs += [f\\\"claims {key}: unknown key {k!r}\\\" for k in sorted(set(c) - CLAIM_KEYS)]\\nattavo/plan.py:144:            errs.append(f\\\"claims {key}: names who set them and when (by and at)\\\")\\nattavo/plan.py:147:            errs.append(f\\\"claims {key}: paths is not a list\\\")\\nattavo/plan.py:149:            errs.append(f\\\"claims {key} has no paths; clear them instead\\\")\\nattavo/plan.py:151:            errs += [f\\\"claims {key}: {e}\\\" for e in filter(None, map(path_error, paths))]\\nattavo/plan.py:219:def set_claims(body: dict[str, Any], what: str, paths: list[str], by: str, at: str) -> dict[str, Any]:\\nattavo/plan.py:220:    \\\"\\\"\\\"A copy of body with issue what's draft claims set to paths, who set\\nattavo/plan.py:230:        raise store.StoreRefusal(bad[0] if bad else \\\"claims names at least one path\\\")\\nattavo/plan.py:232:    new.setdefault(\\\"claims\\\", {})[str(n)] = {\\\"paths\\\": list(paths), \\\"by\\\": by, \\\"at\\\": at}\\nattavo/plan.py:236:def clear_claims(body: dict[str, Any], what: str) -> dict[str, Any]:\\nattavo/plan.py:237:    \\\"\\\"\\\"A copy of body without issue what's draft claims. Raises StoreRefusal.\\\"\\\"\\\"\\nattavo/plan.py:243:    if str(n) not in body.get(\\\"claims\\\", {}):\\nattavo/plan.py:244:        raise store.StoreRefusal(f\\\"#{n} has no claims to clear\\\")\\nattavo/plan.py:246:    del new[\\\"claims\\\"][str(n)]\\nattavo/plan.py:279:    if not argv or argv[0] not in (\\\"get\\\", \\\"put\\\", \\\"log\\\", \\\"rank\\\", \\\"move\\\", \\\"claims\\\"):\\nattavo/plan.py:282:              \\\"claims #N (<PATH>... | --clear) --by LOGIN\\\",\\nattavo/plan.py:320:        if verb == \\\"claims\\\":\\nattavo/plan.py:325:                return _refuse(\\\"plan claims '#N' <path>... --by LOGIN, or plan claims '#N' --clear --by LOGIN\\\")\\nattavo/plan.py:329:                return _write(root, clear_claims(current[\\\"body\\\"], words[0]), current[\\\"version\\\"], by)\\nattavo/plan.py:331:            return _write(root, set_claims(current[\\\"body\\\"], words[0], paths, by, at),\\nattavo/plan.py:345:        usage=('attavo plan get [--version V] | put FILE --base V --by LOGIN | log', 'attavo plan rank <EPIC|#N> (--before <EPIC|#M> | --last) --by LOGIN', 'attavo plan move #N --epic EPIC --by LOGIN', 'attavo plan claims #N (<PATH>... | --clear) --by LOGIN'),\\nattavo/plan.py:356:change one position or one membership and write the next version; claims\\nattavo/stops.py:23:               \\\"ceiling\\\", \\\"claims-boundary\\\", \\\"repeated-act\\\", \\\"unclassed\\\", \\\"question\\\",\\nattavo/stops.py:28:# #317 a fifth, test-bypass, retried with the steer \\\"run tests only with\\nattavo/stops.py:76:    if checks and checks[\\\"exit\\\"] != 0:\\nattavo/stops.py:77:        return f\\\"checks: exit {checks['exit']}\\\"\\nattavo/stops.py:94:      - refused, by refusal_kind: claims -> claims-boundary/spec; protected\\nattavo/stops.py:96:        commit, #289) -> claims-boundary/executor;\\nattavo/stops.py:117:        if refusal_kind == \\\"claims\\\":\\nattavo/stops.py:118:            return {\\\"class\\\": \\\"claims-boundary\\\", \\\"provenance\\\": \\\"spec\\\", \\\"detail\\\": refusal}\\nattavo/stops.py:120:            return {\\\"class\\\": \\\"claims-boundary\\\", \\\"provenance\\\": \\\"executor\\\", \\\"detail\\\": refusal}\\nattavo/stops.py:141:            \\\"checks\\\": {\\\"exit\\\": checks[\\\"exit\\\"]} if checks else None}\\nattavo/stops.py:242:    derive_stop's generic claims-boundary/spec fallback issue #133\\nattavo/stops.py:245:    a write outside claims. cmd_spec_gate is untouched by this lane, so\\nattavo/stops.py:370:# verify, ceiling from a declared-input-limit error, claims-boundary from\\nattavo/stops.py:371:# the write-outside-claims refusal, repeated-act from... the same shape,\\nattavo/stops.py:379:                        \\\"claims-boundary\\\", \\\"repeated-act\\\", \\\"environment\\\")\\nattavo/types.py:110:    steer: str | None\\nattavo/types.py:114:    \\\"\\\"\\\"build-NN.json (issue #60): retry_of and steer (R3) are optional --\\nattavo/types.py:149:    steer: str | None\\nattavo/types.py:153:    \\\"\\\"\\\"verify-NN.json (issue #60): retry_of and steer (R3) are optional --\\nattavo/testtool.py:24:# whole-tree checks: given a checks command it ran it (#194's 590 s wait;\\nattavo/issues.py:6:labels and its declared class. The paths an issue claims before it has a\\nattavo/issues.py:8:claims), and the body's prose is never read for them (ruled 2026-09-30\\nattavo/claims.py:1:\\\"\\\"\\\"attavo claims: what is in flight, and whether an item collides with it.\\nattavo/claims.py:6:paths.specs) and, when it carries an item's spec, that spec's Claims. The\\nattavo/claims.py:12:refusals. With an item, the item's own Claims are compared with every other branch\\nattavo/claims.py:14:is a glob (fnmatch, as build's boundary reads it); two claims overlap when\\nattavo/claims.py:50:    \\\"\\\"\\\"Whether two claims (paths or globs) may name the same path.\\\"\\\"\\\"\\nattavo/claims.py:88:            declared = _claims_of_text(_git(root, \\\"show\\\", f\\\"{ref}:{spec_md}\\\").stdout)\\nattavo/claims.py:97:def _claims_of_text(text: str) -> list[str]:\\nattavo/claims.py:98:    \\\"\\\"\\\"A spec's Claims from its text, through parse_spec itself so the\\nattavo/claims.py:104:    return list((parsed or {}).get(\\\"claims\\\") or [])\\nattavo/claims.py:107:def collisions(claims: list[str], flights: list[dict[str, Any]], item: str | None) -> list[dict[str, Any]]:\\n        \\\"findings list means you looked and found nothing to report, not \\\"\\n        \\\"that you did not look.\\\")\\n    return \\\"\\\\n\\\\n\\\".join(parts)\\n\\n\\ndef counsel_instruction() -> str:\\n    \\\"\\\"\\\"Issue #100 (extended by issue #175): a stop is read inside the\\n    product first, before a person. The record, its log, the diff, the\\n    forge's checks, the item's graph, the tenant manifest, and this\\n    product's own root are all handed by path -- named in the instruction\\n    instead of inlined, the same discipline verify_instruction already\\n    applies to the diff (issue #86), so this instruction's own size stays\\n    fixed whatever the record, log, diff, checks, or graph's size.\\\"\\\"\\\"\\n    parts = list(spec_sections())\\n\\n    rulings = read_text(\\\"ATTAVO_RULINGS\\\")\\n    if rulings.strip():\\n        parts.append(\\\"## Rulings\\\\n\\\\n\\\" + rulings.strip())\\n\\n    note = stub_note()\\n    if note:\\n        parts.append(note)\\n\\n    record_path = os.environ.get(\\\"ATTAVO_COUNSEL_RECORD\\\")\\n    record_text = read_text(\\\"ATTAVO_COUNSEL_RECORD\\\")\\n    if record_text.strip():\\n        parts.append(\\n            \\\"## The stage record\\\\n\\\\n\\\"\\n            f\\\"The record is at {describe_file(record_path, record_text, diff_like=False)}. \\\"\\n            \\\"Read it yourself with your own tools.\\\")\\n\\n    # Counsel's own earlier readings of this item come first: a follow-up\\n    # question about a stop counsel has already read is answered from that\\n    # reading. The class an earlier reading states is not re-derived.\\n    prior_path = os.environ.get(\\\"ATTAVO_COUNSEL_PRIOR\\\")\\n    prior_text = read_text(\\\"ATTAVO_COUNSEL_PRIOR\\\")\\n    if prior_text.strip():\\n        parts.append(\\n            \\\"## Counsel's earlier readings of this item\\\\n\\\\n\\\"\\n            f\\\"They are at {describe_file(prior_path, prior_text, diff_like=False)}: a JSON list, \\\"\\n            \\\"oldest first, each with the record it read, its class, verdict, ruling text, \\\"\\n            \\\"citations and any question it answered. Read them first. Do not re-derive a \\\"\\n            \\\"class an earlier reading states; a question about a stop already read is \\\"\\n            \\\"answered as a follow-up to that reading, citing it.\\\")\\n\\n    reads = [line for line in os.environ.get(\\\"ATTAVO_COUNSEL_READS\\\", \\\"\\\").splitlines() if line.strip()]\\n    if reads:\\n        parts.append(\\n            \\\"## The tenant's corpus\\\\n\\\\n\\\"\\n            \\\"The tenant names these as what counsel reads before it answers -- method rules, \\\"\\n            \\\"briefs, rulings. Read them with your own tools before answering:\\\\n\\\\n\\\" +\\n            \\\"\\\\n\\\".join(f\\\"- `{r}`\\\" for r in reads))\\n\\n    log_path = os.environ.get(\\\"ATTAVO_COUNSEL_LOG\\\")\\n    log_text = read_text(\\\"ATTAVO_COUNSEL_LOG\\\")\\n    if log_text.strip():\\n        parts.append(\\n            \\\"## The record's log\\\\n\\\\n\\\"\\n            f\\\"The log is at {describe_file(log_path, log_text, diff_like=False)}. \\\"\\n            \\\"Read it yourself with your own tools.\\\")\\n\\n    events_path = os.environ.get(\\\"ATTAVO_COUNSEL_EVENTS\\\")\\n    events_text = read_text(\\\"ATTAVO_COUNSEL_EVENTS\\\")\\n    if events_text.strip():\\n        parts.append(\\n            \\\"## The stage's last events\\\\n\\\\n\\\"\\n            f\\\"They are at {describe_file(events_path, events_text, diff_like=False)}: the last \\\"\\n            \\\"lines of the stage's own event stream (tool calls, messages, test runs, gate \\\"\\n            \\\"lines), one JSON object per line. This stands in for the whole log; when the \\\"\\n            \\\"log itself is handed above, read that instead.\\\")\\n\\n    diff_path = os.environ.get(\\\"ATTAVO_COUNSEL_DIFF\\\")\\n    diff_text = read_text(\\\"ATTAVO_COUNSEL_DIFF\\\")\\n    if diff_text.strip():\\n        parts.append(\\n            \\\"## The item's diff since approval\\\\n\\\\n\\\"\\n            f\\\"The diff is at {describe_file(diff_path, diff_text, diff_like=True)}. \\\"\\n            \\\"Read it yourself with your own tools.\\\")\\n\\n    # issue #175: the forge in the evidence set. ATTAVO_COUNSEL_CHECKS is\\n    # always written, a JSON {read, reason, checks} envelope -- read false\\n    # names the missing manifest key rather than leaving the section out,\\n    # since an unread forge must never be mistaken for a green one.\\n    checks_path = os.environ.get(\\\"ATTAVO_COUNSEL_CHECKS\\\")\\n    checks_text = read_text(\\\"ATTAVO_COUNSEL_CHECKS\\\")\\n    if checks_text.strip():\\n        parts.append(\\n            \\\"## The forge's checks on this stop's sha\\\\n\\\\n\\\"\\n            f\\\"The checks are at {describe_file(checks_path, checks_text, diff_like=False)}: \\\"\\n            \\\"a JSON object -- read: false means the forge was not read at \\\"\\n            \\\"all (reason names the missing manifest key; treat this as \\\"\\n            \\\"unknown, never as green) -- read: true carries one entry per \\\"\\n            \\\"check, each naming, for a check that did not succeed, the \\\"\\n            \\\"path of its own failed-step log. Read the failing check's \\\"\\n            \\\"log before answering about the forge; a remedy that depends \\\"\\n            \\\"on the forge's state cites the check and its log line.\\\")\\n\\n    # issue #175: the graph in the evidence set -- the default branch's\\n    # own log since this item's branch point, this branch's own commits,\\n    # the markers and records present at the stop's sha, and the check\\n    # runs on the last three shas, so \\\"the checks are on the record\\n    # commit, not the code commit\\\" is readable without a terminal.\\n    graph_path = os.environ.get(\\\"ATTAVO_COUNSEL_GRAPH\\\")\\n    graph_text = read_text(\\\"ATTAVO_COUNSEL_GRAPH\\\")\\n    if graph_text.strip():\\n        parts.append(\\n            \\\"## The item's graph\\\\n\\\\n\\\"\\n            f\\\"The graph is at {describe_file(graph_path, graph_text, diff_like=False)}. \\\"\\n            \\\"Read it yourself with your own tools.\\\")\\n\\n    manifest_path = os.environ.get(\\\"ATTAVO_MANIFEST\\\", \\\"\\\")\\n    parts.append(f\\\"## The tenant manifest\\\\n\\\\nThe manifest is at `{manifest_path}`. \\\"\\n                 \\\"Read it yourself with your own tools.\\\")\\n\\n    product_root = os.environ.get(\\\"ATTAVO_PRODUCT_ROOT\\\", \\\"\\\")\\n    parts.append(\\n        \\\"## The product's own root\\\\n\\\\n\\\"\\n        f\\\"The product that ran this stage is at `{product_root}` \\\"\\n        \\\"(`bin/attavo`, `adapters/`, `schema/`, `templates/`). A stop \\\"\\n        \\\"whose cause is the product's own mechanism, not the tenant's, \\\"\\n        \\\"is read here.\\\")\\n\\n    # issue #175: attavo counsel N --ask hands the operator's own text as\\n    # the question to answer, over the same evidence set, rather than\\n    # diagnosing a stop -- the record above is context, not necessarily a\\n    # failure.\\n    question = os.environ.get(\\\"ATTAVO_COUNSEL_QUESTION\\\", \\\"\\\")\\n    if question.strip():\\n        parts.append(\\n            \\\"## The operator's question\\\\n\\\\n\\\" + question.strip() +\\n            \\\"\\\\n\\\\nAnswer this question using the evidence above; the \\\"\\n            \\\"record named above is context, not necessarily a failure.\\\")\\n\\n    parts.append(\\n        \\\"you are counseling a stop, read-only: make no edits, write no \\\"\\n        \\\"files, commit nothing. Read the record, its log, the spec, the \\\"\\n        \\\"rulings, the diff, the forge's checks, the item's graph, the \\\"\\n        \\\"tenant manifest, and the product's own root named above with \\\"\\n        \\\"your own tools, then answer with exactly one class (the stop's \\\"\\n        \\\"class, or \\\\\\\"unclassed\\\\\\\"), one verdict -- \\\\\\\"answer\\\\\\\" (the stop is \\\"\\n        \\\"answerable inside the rules: a ruling text, in \\\"\\n        \\\"proposal.ruling_text, with three citations -- instruction, \\\"\\n        \\\"mechanism, guard, each a path and symbol or a ruling id), \\\"\\n        \\\"\\\\\\\"patch\\\\\\\" (the stop is a product defect: the mechanism's file \\\"\\n        \\\"and symbol, a rejection test, and a unified diff, in \\\"\\n        \\\"proposal.patch -- or, when the remedy is better filed as an \\\"\\n        \\\"item than shipped as a diff, a title and a body in this \\\"\\n        \\\"repository's own issue format -- a Severity/Provenance line, \\\"\\n        \\\"then Problem, Retires, Change, and Acceptance sections -- in \\\"\\n        \\\"proposal.issue), or \\\\\\\"person\\\\\\\" (the answer would touch the \\\"\\n        \\\"definition of done and no rule covers it: the question restated \\\"\\n        \\\"in one line, in proposal.question -- or, when the remedy is \\\"\\n        \\\"better filed as an item than asked as a bare question, a title \\\"\\n        \\\"and a body in the same issue format, in proposal.issue) -- and \\\"\\n        \\\"citations for whichever verdict you gave. You propose; you do \\\"\\n        \\\"not act.\\\")\\n    return \\\"\\\\n\\\\n\\\".join(parts)\\n\\n\\nBUILD_ALLOWED_TOOLS = [\\\"Read\\\", \\\"Edit\\\", \\\"Write\\\", \\\"Bash\\\"]\\n\\n# Item 229's third attempt: 2,754 s and $6.54 to write the right change and\\n# be refused at the gate for one path the spec's Claims did not name. The\\n# gate stays the law, but the boundary is told at the edit: the build's\\n# Edit and Write are allowed on the claimed paths only, as permission\\n# rules built from the spec's own Claims list, so an edit outside them is\\n# refused by the tool at the moment it is tried and the executor's recourse\\n# is the one it has for anything outside the spec -- a question.\\nBUILD_FIXED_TOOLS = [\\\"Read\\\", \\\"Bash\\\"]\\n\\n\\n\\n    state = retry_state(root, m, records_dir, stage, stop_class, attempt)\\n    how = f\\\"as {stop_class}\\\" if stop_class else f\\\"({record.get('status')})\\\"\\n    if state.waiting_s is not None:\\n        r[\\\"kind\\\"] = \\\"waits\\\"\\n        says = (f\\\"{_WORD[stage].capitalize()} attempt {attempt:02d} stopped {how}; retrying \\\"\\n                f\\\"{_WORD[stage]} in {int(state.waiting_s)} s\\\")\\n    elif state.eligible:\\n        r[\\\"kind\\\"] = \\\"acts\\\"\\n        says = f\\\"{_WORD[stage].capitalize()} attempt {attempt:02d} stopped {how}; the next pass retries it\\\"\\n    else:\\n        says = f\\\"Needs you: {_WORD[stage]} attempt {attempt:02d} stopped {how}\\\"\\n    counsel = _counsel_of(records_dir, stem)\\n    if counsel:\\n        r[\\\"counsel\\\"] = counsel[0]\\n        verdict = str(counsel[1].get(\\\"verdict\\\"))\\n        verdict_says = _COUNSEL_SAYS.get(verdict)\\n        says += f\\\"; {counsel[0]} {verdict_says or 'could not read it'}\\\"\\n        if verdict == \\\"patch\\\":\\n            says += f\\\"; waiting on {r['filed'] or 'the issue counsel filed'}\\\"\\n    if r[\\\"filed\\\"] and \\\"waiting on\\\" not in says:\\n        says += f\\\"; filed as {r['filed']}\\\"\\n    r[\\\"says\\\"] = says\\n    return r\\n\\n\\ndef _invocation(r: DriveReport, reading: InvocationReading, info: dict[str, Any],\\n                bound: int | None) -> DriveReport:\\n    stage, nn, _log, _last_at, age, cls, crossed = reading\\n    r[\\\"stage\\\"], r[\\\"attempt\\\"], r[\\\"stop_class\\\"] = stage, nn, None if cls == \\\"running\\\" else cls\\n    r[\\\"since\\\"] = info.get(\\\"at\\\") if isinstance(info.get(\\\"at\\\"), str) else None\\n    r[\\\"last_event_age_s\\\"] = None if age is None else int(age)\\n    word = _WORD[stage]\\n    if cls == \\\"running\\\":\\n        r[\\\"state\\\"], r[\\\"kind\\\"] = \\\"running\\\", \\\"waits\\\"\\n        r[\\\"says\\\"] = (f\\\"{word.capitalize()} running since {r['since'] or 'an unknown time'}; \\\"\\n                     f\\\"nothing to do until it finishes\\\")\\n    else:\\n        r[\\\"state\\\"], r[\\\"kind\\\"] = \\\"owes-recovery\\\", \\\"acts\\\"\\n        if cls == \\\"hung\\\" and crossed == \\\"ceiling\\\":\\n            # R3: a stage past its own ceiling is hung by wall clock\\nattavo/doctor.py:310:    plain retry, a returned retry, and a steered one alike -- before the\\nattavo/drive.py:772:                   \\\"retry_of\\\": None, \\\"steer\\\": None,\\nattavo/drive.py:830:# an \\\"answer\\\" verdict starts the next attempt steered by it, the same as\\nattavo/drive.py:862:    a plain pass nor `--again`'s own no-op read of the same fact; steer\\nattavo/drive.py:868:    steer: str | None\\nattavo/drive.py:900:    if counsel is not None and counsel.get(\\\"verdict\\\") == \\\"answer\\\":\\nattavo/verify.py:177:    \\\"\\\"\\\"(retry_of, steer): a plain retry of verify itself -- died, hung,\\nattavo/verify.py:193:    steer = None\\nattavo/verify.py:194:    if counsel is not None and counsel.get(\\\"verdict\\\") == \\\"answer\\\":\\nattavo/verify.py:198:            steer = f\\\"counsel-{max(matches):02d}\\\"\\nattavo/verify.py:199:    return prior_stem, steer\\nattavo/verify.py:307:            \\\"retry_of\\\": None, \\\"steer\\\": None,\\nattavo/verify.py:404:    retry_of, steer = _verify_retry_seed(item_records_dir, build_sha)\\nattavo/verify.py:446:        \\\"steer\\\": steer,\\nattavo/types.py:110:    steer: str | None\\nattavo/types.py:114:    \\\"\\\"\\\"build-NN.json (issue #60): retry_of and steer (R3) are optional --\\nattavo/types.py:149:    steer: str | None\\nattavo/types.py:153:    \\\"\\\"\\\"verify-NN.json (issue #60): retry_of and steer (R3) are optional --\\nattavo/counsel.py:254:    only way a question becomes a record and so the only way it steers.\\\"\\\"\\\"\\nattavo/counsel.py:266:    # otherwise steer build-03 with an answer about build-01.\\nattavo/counsel.py:296:        \\\"verdict\\\": answer.get(\\\"verdict\\\"),\\nattavo/counsel.py:298:        \\\"proposal\\\": {\\\"ruling_text\\\": None, \\\"patch\\\": None, \\\"question\\\": None, \\\"issue\\\": None,\\nattavo/counsel.py:495:              \\\"ruling_text\\\": (rec.get(\\\"proposal\\\") or {}).get(\\\"ruling_text\\\"),\\nattavo/counsel.py:509:                          \\\"ruling_text\\\": (a.get(\\\"proposal\\\") or {}).get(\\\"ruling_text\\\"),\\nattavo/counsel.py:593:    proposal = {\\\"ruling_text\\\": None, \\\"patch\\\": None, \\\"question\\\": None, \\\"issue\\\": None}\\nattavo/counsel.py:596:            and payload.get(\\\"verdict\\\") in (\\\"answer\\\", \\\"patch\\\", \\\"person\\\")):\\nattavo/counsel.py:711:verdict (answer: a ruling text with citations; patch: a product\\nattavo/counsel.py:714:each a path and symbol or a ruling id), and proposal (the ruling text,\\nattavo/counsel.py:737:question steers nothing. The events tail is read where the product keeps\\nattavo/counsel.py:750:the only way one steers the next attempt.\\\"\\\"\\\"),\\nattavo/stops.py:28:# #317 a fifth, test-bypass, retried with the steer \\\"run tests only with\\nattavo/build.py:242:    \\\"\\\"\\\"(retry_of, steer, feedback): what a retried build's first iteration\\nattavo/build.py:246:    own blocking findings); and the newest steer newer than the blocking\\nattavo/build.py:299:    steer_stem: str | None = None\\nattavo/build.py:307:            if counsel.get(\\\"verdict\\\") == \\\"answer\\\":\\nattavo/build.py:308:                steer_stem = f\\\"counsel-{nn:02d}\\\"\\nattavo/build.py:309:                answer = (counsel.get(\\\"proposal\\\") or {}).get(\\\"ruling_text\\\")\\nattavo/build.py:311:                    lines += [f\\\"steer from {steer_stem}:\\\", answer.strip(), \\\"\\\"]\\nattavo/build.py:313:    return prior_stem, steer_stem, \\\"\\\\n\\\".join(lines) + \\\"\\\\n\\\"\\nattavo/build.py:464:                \\\"steer\\\": None,\\nattavo/build.py:497:        # steer newer than the blocking record -- the one file the\\nattavo/build.py:499:        retry_of, steer, seed = _retry_seed(root, m, item_records_dir)\\nattavo/build.py:589:            # way returns the build, by name; the retry is steered to the tool.\\nattavo/build.py:761:        \\\"steer\\\": steer,\\nattavo/build.py:845:executor, naming the call, and its retry is steered to the tool (#317); a\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n976:+{\"type\":\"item.completed\",\"item\":{\"id\":\"item_6\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"sed -n '488,548p' adapters/claude-code/run; sed -n '1025,1070p' attavo/doctor.py; sed -n '70,125p' schema/manifest.schema.json; sed -n '220,330p' attavo/build.py; sed -n '820,915p' attavo/drive.py\\\"\",\"aggregated_output\":\"\\nBUILD_ALLOWED_TOOLS = [\\\"Read\\\", \\\"Edit\\\", \\\"Write\\\", \\\"Bash\\\"]\\n\\n# Item 229's third attempt: 2,754 s and $6.54 to write the right change and\\n# be refused at the gate for one path the spec's Claims did not name. The\\n# gate stays the law, but the boundary is told at the edit: the build's\\n# Edit and Write are allowed on the claimed paths only, as permission\\n# rules built from the spec's own Claims list, so an edit outside them is\\n# refused by the tool at the moment it is tried and the executor's recourse\\n# is the one it has for anything outside the spec -- a question.\\nBUILD_FIXED_TOOLS = [\\\"Read\\\", \\\"Bash\\\"]\\n\\n\\ndef claimed_paths() -> list[str]:\\n    \\\"\\\"\\\"The spec's Claims, one path or glob per line under '## Claims', as\\n    the spec contract writes them (attavo/spec.py's parse_spec reads the\\n    same lines).\\\"\\\"\\\"\\n    spec_dir = os.environ.get(\\\"ATTAVO_SPEC_DIR\\\")\\n    if not spec_dir:\\n        return []\\n    try:\\n        lines = (Path(spec_dir) / \\\"spec.md\\\").read_text().splitlines()\\n    except OSError:\\n        return []\\n    claims: list[str] = []\\n    inside = False\\n    for line in lines:\\n        if line.startswith(\\\"## \\\"):\\n            inside = line.strip() == \\\"## Claims\\\"\\n            continue\\n        if inside and line.strip().startswith(\\\"- \\\"):\\n            claims.append(line.strip()[2:].strip())\\n    return claims\\n\\n\\ndef claim_rule(claim: str) -> str:\\n    \\\"\\\"\\\"A claim as a permission-rule path: a directory claim (trailing\\n    slash) covers everything under it.\\\"\\\"\\\"\\n    return claim + \\\"**\\\" if claim.endswith(\\\"/\\\") else claim\\n\\n\\ndef build_allowed_tools() -> list[str]:\\n    claims = claimed_paths()\\n    if not claims:\\n        return BUILD_ALLOWED_TOOLS\\n    rules = [f\\\"{tool}({claim_rule(c)})\\\" for c in claims for tool in (\\\"Edit\\\", \\\"Write\\\")]\\n    return BUILD_FIXED_TOOLS + rules\\nVERIFY_ALLOWED_TOOLS = [\\\"Read\\\", \\\"Bash\\\"]\\n\\n# Issue #88 (class B): both tools the tool's own reply named as a way to\\n# spawn work that outlives this invocation -- confirmed live against\\n# `claude 2.1.269` (see module docstring). Named on both stages: verify's\\n# own allowed tools never included either, and did not stop the\\n# specimen either.\\nSUBAGENT_TOOLS = [\\\"Agent\\\", \\\"Workflow\\\"]\\n\\n# Items 227 and 229: the executor started `attavo test` in the background,\\n# loaded Monitor to tail its output file, scheduled wakeups to wait for it,\\n# and on 227 answered done while the wait was still open. Both let the\\n# invocation outlive its own answer, the same reason the subagent tools\\n# are denied.\\n        statement, exit_code = statement_for(root, cmd, merge_sha)\\n        if statement is not None:\\n            sealed.append(item)\\n            disagreement = _accounting_disagrees(root, records_dir / item, item, merge_sha,\\n                                                 statement, merges=merges)\\n            if disagreement:\\n                reasons.append(disagreement)\\n        elif exit_code == 2:\\n            not_read.append(item)\\n            reasons.append(f\\\"item {item} merged at {merge_sha[:12]}: not read -- \\\"\\n                           f\\\"the store could not be read; {cmd!r} exited 2\\\")\\n        else:\\n            unsealed.append(item)\\n            reasons.append(f\\\"item {item} merged at {merge_sha[:12]} has no statement in the store\\\")\\n    if reasons:\\n        return p.fail(\\\"; \\\".join(reasons), sealed=sealed, before_window=before_window,\\n                      unsealed=unsealed, not_merged=not_merged, not_read=not_read)\\n    window = f\\\" at {since[:12]}\\\" if before_window else \\\"\\\"\\n    return p.hold(f\\\"{len(sealed)} sealed, {len(before_window)} before the window{window}, \\\"\\n                 f\\\"{len(not_merged)} not merged\\\",\\n                 sealed=sealed, before_window=before_window, unsealed=unsealed,\\n                 not_merged=not_merged, not_read=not_read)\\n\\n\\ndef proof_no_attested_item_is_empty(root: Path, m: dict[str, Any] | None) -> Proof:\\n    \\\"\\\"\\\"Proof seven (item 227). Every merged, fully-staged item's passing\\n    build names a change: its tree, restricted to the item's own spec\\n    claims, differs from the approved tree there (item 229 -- asked\\n    against the approval, not the build's own start_sha, so a build\\n    that adopted a prior attempt's valid commits is not empty just\\n    because that attempt owed no commit of its own; scoped to claims,\\n    not \\\"everything outside paths.records\\\", so a commit that lands\\n    between approval and a later attempt's start but touches no\\n    claimed path never rescues or defeats the comparison on its own\\n    account). Item 227 was specified, approved, built by one\\n    invocation, judged by another, merged and sealed, and its build\\n    committed nothing -- the executor left the stub in the working tree,\\n    the gate read the tree, and main received the spec and none of the\\n    change. Six proofs held over it.\\n\\n    [doctor].built_since: merges at or before this commit are before the\\n    window -- named, never failed -- so the specimen stands on every\\n    doctor run without failing the tenant forever. Absent, the window is\\n    proof three's. A build record whose approval cannot be resolved\\n    (no approval_sha at all, or one this repository cannot read) is\\n    named as not readable, not failed.\\\"\\\"\\\"\\n      \\\"description\\\": \\\"How build finds and runs the tests for a touched path. Both keys are required together; a tenant with no [tests] table has not declared selection, and attavo build refuses to run on it.\\\",\\n      \\\"additionalProperties\\\": false,\\n      \\\"required\\\": [\\\"select\\\", \\\"run\\\"],\\n      \\\"properties\\\": {\\n        \\\"select\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"description\\\": \\\"A command that reads touched paths on stdin, one per line, and writes test identifiers on stdout, one per line.\\\",\\n          \\\"minLength\\\": 1\\n        },\\n        \\\"exclude_in_executor\\\": {\\n          \\\"type\\\": \\\"array\\\",\\n          \\\"items\\\": {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1},\\n          \\\"description\\\": \\\"Test identifiers attavo test leaves out when it runs inside an executor (ATTAVO_STAGE set): tests that need a live tenant, the network, or the process's own working directory. CI runs them.\\\"\\n        },\\n        \\\"run\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"description\\\": \\\"A command that reads test identifiers on stdin, one per line; its exit code is the verdict. `attavo test` exports ATTAVO_TEST_WORKERS to it: the workers this call takes of the machine's cores, max(1, cores // calls running at once), counted from the lock files under <common git dir>/attavo/test-slots/. A runner that can run in parallel reads it (pytest-xdist: `-n ${ATTAVO_TEST_WORKERS:-auto}`).\\\",\\n          \\\"minLength\\\": 1\\n        },\\n        \\\"call_timeout_s\\\": {\\n          \\\"type\\\": \\\"integer\\\",\\n          \\\"minimum\\\": 1,\\n          \\\"description\\\": \\\"Seconds one `attavo test` run is given before its process group is ended and it exits 124. The executor's own test runs are bounded; the gate's are not.\\\"\\n        },\\n        \\\"progress\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"enum\\\": [\\\"pytest\\\"],\\n          \\\"description\\\": \\\"The runner's kind, when `attavo test` may read its per-test results as they happen (attavo/pytest_progress.py). With it, a run that reaches call_timeout_s prints what passed, what failed and what did not run, and the command that narrows it; without it, it prints that the run was ended and the narrowing command, and nothing about what ran.\\\"\\n        }\\n      }\\n    },\\n    \\\"checks\\\": {\\n      \\\"type\\\": \\\"object\\\",\\n      \\\"description\\\": \\\"The tenant's own definition of done: a whole-tree check, as the tenant runs it locally. attavo build runs it each iteration, after the claims boundary, the criteria, and the selected tests -- pass requires its exit to be 0, and a non-zero exit reaches the executor as feedback. Optional; a tenant that declares none is not refused (unlike [tests], which build requires).\\\",\\n      \\\"additionalProperties\\\": false,\\n      \\\"required\\\": [\\\"command\\\"],\\n      \\\"properties\\\": {\\n        \\\"command\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"description\\\": \\\"The tenant's whole-tree check at the gate, run from the tenant root once per iteration on the committed tree. What is fast and decisive belongs here; what the forge runs as a required check need not be run twice.\\\",\\n          \\\"minLength\\\": 1\\n        },\\n        \\\"probe\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"description\\\": \\\"A cheap command that answers whether this machine can run the checks at all, run once before a build's executor is invoked: exit 0 yes, anything else an environment refusal. When absent, attavo build asks by running [checks].command whole and reads exit 2 alone as cannot run.\\\",\\n          \\\"minLength\\\": 1\\n        },\\n        \\\"probe_timeout_s\\\": {\\n          \\\"type\\\": \\\"integer\\\",\\n          \\\"minimum\\\": 1,\\n          \\\"description\\\": \\\"Seconds [checks].probe is given; past it the build is refused as an environment stop. Required with probe: a bound the tenant did not write is a forecast.\\\"\\n        }\\n      },\\n      \\\"dependentRequired\\\": {\\\"probe\\\": [\\\"probe_timeout_s\\\"]}\\n    },\\n    \\\"forge\\\": {\\n    lines = stdout.splitlines()\\n    non_empty = [i for i, l in enumerate(lines) if l.strip()]\\n    if not non_empty:\\n        return stdout, None\\n    last = non_empty[-1]\\n    try:\\n        payload = json.loads(lines[last])\\n    except ValueError:\\n        return stdout, None\\n    transcript = \\\"\\\\n\\\".join(lines[:last])\\n    return transcript, payload\\n\\n\\nBUILD_ITERATION_BUDGET = 3\\n\\nBUILD_HALT_EXIT = 3\\n\\nCHECKS_FEEDBACK_TAIL_LINES = 200\\n\\n\\ndef _retry_seed(root: Path, m: dict[str, Any], records_dir: Path\\n                ) -> tuple[str | None, str | None, str]:\\n    \\\"\\\"\\\"(retry_of, steer, feedback): what a retried build's first iteration\\n    is handed (R3), in this order -- the prior attempt's own class and\\n    signature; the evidence a returned review carries (a red required\\n    check's log, read through [forge].check_log_command, or a review's\\n    own blocking findings); and the newest steer newer than the blocking\\n    record (counsel's answer text, named by the record it came from). A\\n    build retries the latest build record that is not a pass, or --\\n    retry_of still naming that same build attempt, the one a required\\n    check rejected or a review returned -- the latest verify record that\\n    returned it (class returned, its own build_sha matching the latest\\n    build's): the two never coexist, since a returned review is read\\n    only once its own build has already passed. (None, None, \\\"\\\") on a\\n    first attempt -- nothing to retry, nothing to seed.\\\"\\\"\\\"\\n    latest_build = cast(\\\"dict[str, Any] | None\\\", latest_record(records_dir, \\\"build\\\"))\\n    latest_verify = cast(\\\"dict[str, Any] | None\\\", latest_record(records_dir, \\\"verify\\\"))\\n    prior_stem = f\\\"build-{next_attempt_number(records_dir, 'build') - 1:02d}\\\"\\n    prior: dict[str, Any] | None = None\\n    counsel_stage, counsel_n = \\\"build\\\", next_attempt_number(records_dir, \\\"build\\\") - 1\\n    if (latest_verify and (latest_verify.get(\\\"stop\\\") or {}).get(\\\"class\\\") == \\\"returned\\\"\\n            and latest_build and latest_verify.get(\\\"build_sha\\\") == latest_build.get(\\\"sha\\\")):\\n        prior = latest_verify\\n        verify_attempts = parse_attempts(records_dir, \\\"verify\\\")\\n        counsel_stage = \\\"verify\\\"\\n        counsel_n = max(verify_attempts) if verify_attempts else 0\\n    elif latest_build and latest_build.get(\\\"status\\\") != \\\"pass\\\":\\n        prior = latest_build\\n    if prior is None:\\n        return None, None, \\\"\\\"\\n\\n    stop: dict[str, Any] = prior.get(\\\"stop\\\") or {}\\n    lines = [f\\\"attempt {prior_stem} stopped as {stop.get('class')}: {stop.get('detail') or ''}\\\",\\n            f\\\"signature: {stop.get('signature') or ''}\\\", \\\"\\\"]\\n\\n    if stop.get(\\\"class\\\") == \\\"test-bypass\\\":\\n        lines += [TEST_BYPASS_STEER, \\\"\\\"]\\n\\n    forge = m.get(\\\"forge\\\") or {}\\n    if stop.get(\\\"class\\\") == \\\"returned\\\":\\n        findings = [f for f in (prior.get(\\\"findings\\\") or [])\\n                   if str(f.get(\\\"severity\\\")) == \\\"blocking\\\"]\\n        if findings:\\n            lines.append(\\\"blocking findings:\\\")\\n            for finding in findings:\\n                lines.append(f\\\"- {finding.get('title')}: {finding.get('specimen')} \\\"\\n                             f\\\"(retires: {finding.get('retires')})\\\")\\n            lines.append(\\\"\\\")\\n        elif forge.get(\\\"check_log_command\\\"):\\n            for c in (prior.get(\\\"forge_checks\\\") or {}).get(\\\"conclusions\\\") or []:\\n                if c.get(\\\"conclusion\\\") in (\\\"success\\\", \\\"neutral\\\", \\\"skipped\\\"):\\n                    continue\\n                run = subprocess.run(\\n                    f\\\"{forge['check_log_command']} {shlex.quote(str(prior.get('sha')))} \\\"\\n                    f\\\"{shlex.quote(c['name'])}\\\", shell=True, cwd=str(root),\\n                    capture_output=True, text=True, check=False)\\n                lines += [f\\\"--- check {c['name']} {c['conclusion']} ---\\\",\\n                         run.stdout.strip(), \\\"\\\"]\\n\\n    steer_stem: str | None = None\\n    if counsel_n:\\n        target = f\\\"{counsel_stage}-{counsel_n:02d}\\\"\\n        counsel_attempts = parse_attempts(records_dir, \\\"counsel\\\")\\n        matches = [(n, rec) for n, rec in sorted(counsel_attempts.items())\\n                  if rec.get(\\\"record\\\") == target]\\n        if matches:\\n            nn, counsel = matches[-1]\\n            if counsel.get(\\\"verdict\\\") == \\\"answer\\\":\\n                steer_stem = f\\\"counsel-{nn:02d}\\\"\\n                answer = (counsel.get(\\\"proposal\\\") or {}).get(\\\"ruling_text\\\")\\n                if answer:\\n                    lines += [f\\\"steer from {steer_stem}:\\\", answer.strip(), \\\"\\\"]\\n\\n    return prior_stem, steer_stem, \\\"\\\\n\\\".join(lines) + \\\"\\\\n\\\"\\n\\n\\n@contextlib.contextmanager\\ndef gate_checkout(root: Path) -> Iterator[Path]:\\n    \\\"\\\"\\\"A detached worktree of root's HEAD, removed on exit: the tree the\\n    build's gate reads. The executor's own directory is not it -- a file\\n    written there and never committed is not part of the change, and a\\n    gate that read it would pass work that does not exist on the branch\\n    (item 227).\\\"\\\"\\\"\\n    parent = Path(tempfile.mkdtemp(prefix=\\\"attavo-gate-\\\"))\\n    tree = parent / \\\"head\\\"\\n    git(root, \\\"worktree\\\", \\\"add\\\", \\\"--detach\\\", \\\"-q\\\", str(tree), \\\"HEAD\\\")\\n    try:\\n        yield tree\\n    finally:\\n        try:\\n            git(root, \\\"worktree\\\", \\\"remove\\\", \\\"--force\\\", str(tree))\\n\\n\\n# --- R3: the retry decision, shared by the report's own kind/says and the\\n# pass's own act (retry_state) so the two cannot drift. ---\\n\\n# Never retried by this item, whatever counsel might rule: a\\n# claims-boundary stop is a person's; a tenant's gate refusal is the\\n# spec-gate's own, earlier than any of this; an environment refusal is\\n# recorded here and acted on by R4's breaker. A question is not in this\\n# tuple -- counsel reads it exactly like any other non-pass record, and\\n# an \\\"answer\\\" verdict starts the next attempt steered by it, the same as\\n# any class counsel can rule on; a question nobody answers (no counsel\\n# configured, or its own verdict is \\\"person\\\") simply never becomes\\n# eligible, with no exclusion needed to keep it that way.\\nNEVER_RETRIED_CLASSES = (\\\"claims-boundary\\\", \\\"gate\\\", \\\"environment\\\")\\n\\n\\ndef _budget_stage(stage: str, stop_class: str | None) -> str:\\n    \\\"\\\"\\\"The stage whose [drive].attempts budget a stop spends -- build for\\n    a returned review (the check rejection or the blocking finding is the\\n    build's to answer, never the review's own to repeat), the stop's own\\n    stage for everything else.\\\"\\\"\\\"\\n    return \\\"build\\\" if stop_class == \\\"returned\\\" else stage\\n\\n\\ndef _signatures_match(records_dir: Path, stage: str) -> bool:\\n    \\\"\\\"\\\"Whether the last two attempts of stage carry the identical,\\n    non-null signature -- the early stop (R3): two attempts of one stage\\n    ending the same way spend no third.\\\"\\\"\\\"\\n    attempts = parse_attempts(records_dir, stage)\\n    if len(attempts) < 2:\\n        return False\\n    nums = sorted(attempts)\\n    sig_a = (attempts[nums[-1]].get(\\\"stop\\\") or {}).get(\\\"signature\\\")\\n    sig_b = (attempts[nums[-2]].get(\\\"stop\\\") or {}).get(\\\"signature\\\")\\n    return sig_a is not None and sig_a == sig_b\\n\\n\\nclass RetryState(NamedTuple):\\n    \\\"\\\"\\\"Whether a plain pass, right now, would start the next attempt of a\\n    stopped stage (R3) -- eligible; a transient stop still short of\\n    [drive].retry_after_s carries waiting_s instead, eligible for neither\\n    a plain pass nor `--again`'s own no-op read of the same fact; steer\\n    names the counsel record an \\\"answer\\\" verdict would hand the next\\n    attempt; target_stage is the stage the next attempt actually starts\\n    (build, for a returned review).\\\"\\\"\\\"\\n    eligible: bool\\n    waiting_s: float | None\\n    steer: str | None\\n    target_stage: str\\n\\n\\ndef retry_state(root: Path, m: dict[str, Any], records_dir: Path, stage: str,\\n                stop_class: str | None, attempt: int | None) -> RetryState:\\n    \\\"\\\"\\\"The one read behind both the report's own kind/says (a stopped\\n    stage that would retry reads as \\\"acts\\\" or \\\"waits\\\", never \\\"yours\\\") and\\n    the pass's own act, so the two cannot say different things about the\\n    same stop. died, hung, transient, and returned retry with no counsel\\n    asked, inside the shared budget and past the early stop; every other\\n    class retries only when counsel's own verdict for this exact stop is\\n    \\\"answer\\\" -- and never when the class is one of NEVER_RETRIED_CLASSES,\\n    whatever counsel might have said.\\\"\\\"\\\"\\n    target_stage = _budget_stage(stage, stop_class)\\n    if stop_class is None or stop_class in NEVER_RETRIED_CLASSES or attempt is None:\\n        return RetryState(False, None, None, target_stage)\\n    spent = next_attempt_number(records_dir, target_stage) - 1\\n    if spent >= attempts_budget(m):\\n        return RetryState(False, None, None, target_stage)\\n    if _signatures_match(records_dir, stage):\\n        return RetryState(False, None, None, target_stage)\\n    if stop_class in RETRYABLE_CLASSES:\\n        if stop_class == \\\"transient\\\":\\n            attempts = parse_attempts(records_dir, stage)\\n            rec = attempts.get(attempt)\\n            age = _seconds_since(rec.get(\\\"at\\\")) if rec else None\\n            wait = retry_after_s(m)\\n            if age is not None and age < wait:\\n                return RetryState(False, wait - age, None, target_stage)\\n        return RetryState(True, None, None, target_stage)\\n    counsel = counsel_record_for(records_dir, stage, attempt)\\n    if counsel is not None and counsel.get(\\\"verdict\\\") == \\\"answer\\\":\\n        target = f\\\"{stage}-{attempt:02d}\\\"\\n        counsel_attempts = parse_attempts(records_dir, \\\"counsel\\\")\\n        matches = [n for n, rec in counsel_attempts.items() if rec.get(\\\"record\\\") == target]\\n        if matches:\\n            return RetryState(True, None, f\\\"counsel-{max(matches):02d}\\\", target_stage)\\n    return RetryState(False, None, None, target_stage)\\n\\n\\ndef _pass_once(root: Path, m: dict[str, Any], item_id: str, again: str | None) -> tuple[int, \\\"DriveReport\\\"]:\\n    \\\"\\\"\\\"One pass: fast-forward to origin (never while a worker holds the\\n    copy), read the report, act at most once, return. owes-recovery\\n    recovers; next-build and next-review start their stage, handing a\\n    review the checks the report already read once on the pre-marker\\n    head; blocked-on-checks on a review (R3) starts it too -- the same\\n    act as next-review, since a concluded red check on a passed build's\\n\",\"exit_code\":0,\"status\":\"completed\"}}\n977:+{\"type\":\"item.completed\",\"item\":{\"id\":\"item_7\",\"type\":\"agent_message\",\"text\":\"{\\\"class\\\":\\\"question\\\",\\\"verdict\\\":\\\"person\\\",\\\"citations\\\":[{\\\"kind\\\":\\\"instruction\\\",\\\"path\\\":\\\"attest/specs/360/spec.md\\\",\\\"symbol\\\":\\\"Claims\\\",\\\"ruling_id\\\":null},{\\\"kind\\\":\\\"mechanism\\\",\\\"path\\\":\\\"/Users/davidbean/Projects/attest/adapters/claude-code/run\\\",\\\"symbol\\\":\\\"build_allowed_tools\\\",\\\"ruling_id\\\":null},{\\\"kind\\\":\\\"guard\\\",\\\"path\\\":\\\"/Users/davidbean/Projects/attest/schema/manifest.schema.json\\\",\\\"symbol\\\":\\\"checks.command\\\",\\\"ruling_id\\\":null}],\\\"proposal\\\":{\\\"ruling_text\\\":null,\\\"patch\\\":null,\\\"question\\\":\\\"May item #360’s approved Claims be amended to include attavo/ledger.py so item_acts_and_interventions can return list[StatementIntervention] and satisfy the required mypy check?\\\",\\\"issue\\\":null}}\"}}\n979:+{\"class\": \"question\", \"verdict\": \"person\", \"citations\": [{\"kind\": \"instruction\", \"path\": \"attest/specs/360/spec.md\", \"symbol\": \"Claims\", \"ruling_id\": null}, {\"kind\": \"mechanism\", \"path\": \"/Users/davidbean/Projects/attest/adapters/claude-code/run\", \"symbol\": \"build_allowed_tools\", \"ruling_id\": null}, {\"kind\": \"guard\", \"path\": \"/Users/davidbean/Projects/attest/schema/manifest.schema.json\", \"symbol\": \"checks.command\", \"ruling_id\": null}], \"proposal\": {\"ruling_text\": null, \"patch\": null, \"question\": \"May item #360\\u2019s approved Claims be amended to include attavo/ledger.py so item_acts_and_interventions can return list[StatementIntervention] and satisfy the required mypy check?\", \"issue\": null}}\n981:diff --git a/attest/records/360/spec-01.json b/attest/records/360/spec-01.json\n1015:diff --git a/attest/records/360/spec-02.json b/attest/records/360/spec-02.json\n1049:diff --git a/attest/records/360/spec-03.json b/attest/records/360/spec-03.json\n1083:diff --git a/attest/specs/360/criteria/the-intervention-class-type-is-the-schemas-enum.sh b/attest/specs/360/criteria/the-intervention-class-type-is-the-schemas-enum.sh\n1091:+# exit 2: the schema or attavo.types could not be read; exit 1: no intervention type carries the enum as a Literal.\n1112:+if found is None or typing.get_origin(found) is not typing.Literal or set(typing.get_args(found)) != enum:\n1113:+    print(\"ASSERT: the intervention class type is %r, not Literal%r\" % (found, sorted(enum))); sys.exit(1)\n1116:diff --git a/attest/specs/360/criteria/the-rejection-tests-exist.sh b/attest/specs/360/criteria/the-rejection-tests-exist.sh\n1124:+test -f tests/test_plan.py && grep -q \"^def test_a_plan_claims_write_calls_now_iso_exactly_once(\" tests/test_plan.py || ok=1\n1125:+test -f tests/test_store.py && grep -q \"^def test_put_stamps_its_own_at_when_the_caller_passes_none(\" tests/test_store.py || ok=1\n1126:+test -f tests/test_spec_gate.py && grep -q \"^def test_a_structural_criterion_that_exits_2_on_the_stub_is_refused_as_could_not_check(\" tests/test_spec_gate.py || ok=1\n1127:+test -f tests/test_types_mirror_schemas.py && grep -q \"^def test_the_intervention_class_type_mirrors_the_schemas_enum(\" tests/test_types_mirror_schemas.py || ok=1\n1129:diff --git a/attest/specs/360/spec.md b/attest/specs/360/spec.md\n1141:+1. #339's rejection test proves the claim's `at` equals the version's `at`, not that the clock is read once. A call count on `now_iso` for one `plan claims` write proves the stronger claim (the product already reads once; the test is what is missing).\n1143:+3. #351's review read the gate as judging criterion kinds before the exit-code contract. The spec's own push found the contract is already judged first: a structural criterion that exits 1 on the tree and 2 on the stub is refused \"criterion could not check (exit 2)\" on main today. The finding needs no logic; its test pins the order.\n1144:+4. `attavo/types.py` types an intervention's `class` as `str`; the schema is the enum `amend`, `launch`, `transport`. A TypedDict for an intervention carries it as a `Literal`, and the mirror test reads enums against literals.\n1155:+- tests/test_plan.py\n1156:+- tests/test_store.py\n1157:+- tests/test_spec_gate.py\n1158:+- tests/test_types_mirror_schemas.py\n1162:+- [structural] the-rejection-tests-exist.sh: the four tests exist, one per finding, in tests/test_plan.py, tests/test_store.py, tests/test_spec_gate.py and tests/test_types_mirror_schemas.py\n1163:+- [behavioural] the-intervention-class-type-is-the-schemas-enum.sh: a TypedDict in attavo.types for an intervention types class as the Literal of the schema's enum\n1164:diff --git a/attest/specs/360/stub/tests/test_plan.py b/attest/specs/360/stub/tests/test_plan.py\n1168:+++ b/attest/specs/360/stub/tests/test_plan.py\n1174:+Run: python3 -m pytest tests/test_plan.py -q\n1226:+def test_a_plan_passes_its_own_check_and_its_schema() -> None:\n1239:+def test_the_check_and_the_schema_refuse_the_same_bodies(body: dict[str, Any], needle: str) -> None:\n1245:+def test_the_check_refuses_what_a_schema_cannot_say() -> None:\n1253:+def test_the_global_order_is_epic_rank_then_issue_rank() -> None:\n1258:+def test_rank_moves_one_epic_or_one_issue_within_its_epic_and_nothing_else() -> None:\n1273:+def test_move_places_an_issue_last_in_an_epic_and_takes_it_out_of_its_old_one() -> None:\n1284:+def test_the_command_puts_gets_ranks_and_refuses_a_stale_base_with_nothing_in_git(tmp_path: Path) -> None:\n1307:+def test_the_command_refuses_a_bad_body_a_missing_author_and_an_empty_store(tmp_path: Path) -> None:\n1350:+def test_the_check_and_the_schema_refuse_the_same_malformed_claims_entry(entry: dict[str, Any], needle: str) -> None:\n1360:+def test_the_schema_and_the_check_accept_the_claims_map_and_the_check_refuses_what_a_schema_cannot_say() -> None:\n1372:+def test_plan_claims_writes_the_draft_claims_beside_the_order_and_clear_removes_them(tmp_path: Path) -> None:\n1393:+def test_plan_claims_refuses_an_unplaced_issue_by_name_and_changes_nothing(tmp_path: Path) -> None:\n1407:+def test_plan_claims_requires_by_and_paths_that_are_repository_relative(tmp_path: Path) -> None:\n1423:+def test_plan_claims_refuses_a_stale_base_naming_the_writer_that_landed_first(\n1441:+def test_a_plan_write_stamps_the_claim_and_the_version_from_one_clock_read(\n1444:+    test_plan_claims_writes_the_draft_claims_beside_the_order_and_clear_removes_them\n1445:+    under load, because set_claims and store.put each called now_iso() and\n1456:+    monkeypatch.setattr(plan_mod, \"now_iso\", ticking, raising=False)\n1457:+    monkeypatch.setattr(store_mod, \"now_iso\", ticking, raising=False)\n1468:+def test_a_plan_claims_write_calls_now_iso_exactly_once(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:\n1477:+    monkeypatch.setattr(plan_mod, \"now_iso\", counting, raising=False)\n1478:+    monkeypatch.setattr(store_mod, \"now_iso\", counting, raising=False)\n1483:diff --git a/attest/specs/360/stub/tests/test_spec_gate.py b/attest/specs/360/stub/tests/test_spec_gate.py\n1487:+++ b/attest/specs/360/stub/tests/test_spec_gate.py\n1520:+def latest_record(root: Path, item: str, stage: str) -> dict[str, Any]:\n1526:+def test_spec_gate_refuses_prose_criterion(tmp_path: Path) -> None:\n1531:+    rec = latest_record(root, \"1\", \"spec\")\n1540:+def test_spec_gate_refuses_criterion_passing_on_tree(tmp_path: Path) -> None:\n1545:+    rec = latest_record(root, \"1\", \"spec\")\n1550:+def test_spec_gate_refuses_criterion_failing_on_stub(tmp_path: Path) -> None:\n1555:+    rec = latest_record(root, \"1\", \"spec\")\n1560:+def test_spec_gate_refuses_wrong_headings(tmp_path: Path) -> None:\n1565:+    rec = latest_record(root, \"1\", \"spec\")\n1570:+def test_spec_gate_passes_and_writes_record(tmp_path: Path) -> None:\n1609:+def test_spec_gate_reports_approved_when_approval_is_valid(tmp_path: Path) -> None:\n1623:+    
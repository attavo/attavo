{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,180p' /Users/davidbean/Projects/attest/attavo/testtool.py; sed -n '400,530p' /Users/davidbean/Projects/attest/tests/test_testtool.py; rg -n -C 4 \\\"Tests|attavo test|test runner\\\" /Users/davidbean/Projects/attest/attavo/cli.py /Users/davidbean/Projects/attest/attavo/build.py /Users/davidbean/Projects/attest/adapters/claude-code/run; rg -n -C 3 'python3 -m pytest -q tests/test_plan.py' attest/records/360/build-03.log; git show --stat --oneline 4c39d3cb64641af55035d24124fa39836efc50bb; git show --format=fuller --no-ext-diff 4c39d3cb64641af55035d24124fa39836efc50bb -- attavo/types.py attavo/ledger.py tests/test_plan.py tests/test_store.py tests/test_spec_gate.py tests/test_types_mirror_schemas.py | sed -n '1,300p'\"","aggregated_output":"from __future__ import annotations\n\nimport json\nimport os\nimport re\nimport shlex\nimport signal\nimport subprocess\nimport sys\nimport uuid\nfrom collections import Counter\nfrom collections.abc import Iterator\nfrom contextlib import contextmanager\nfrom pathlib import Path\nfrom typing import Any\n\nfrom attavo.common import MANIFEST, derive_item_id, git, read_manifest\nfrom attavo import Command\n\n# --- test: the executor's one test command (issue #212) --\n# The tests [tests].select names for every path the item has changed since\n# it left the default branch, run through [tests].run, bounded by\n# [tests].call_timeout_s. The executor is given this and not the tenant's\n# whole-tree checks: given a checks command it ran it (#194's 590 s wait;\n# #204 and #206 ran the suite twice inside one build), and the gate runs\n# them after every commit whatever the executor does. ---\n\nTIMED_OUT_EXIT = 124\n\nPRODUCT_ROOT = Path(__file__).resolve().parent.parent\n\n# What an ended run is given to leave on its own after SIGTERM, before its\n# whole process group is sent SIGKILL.\nEND_GRACE_S = 2\n\n\ndef _signal_group(proc: \"subprocess.Popen[str]\", sig: int) -> None:\n    try:\n        os.killpg(proc.pid, sig)\n    except (ProcessLookupError, PermissionError):\n        # gone, or -- on macOS -- a group whose every member has already exited\n        # and is waiting to be reaped, which answers EPERM, not ESRCH (seen under\n        # load: #317's full-suite runs at -n auto)\n        pass\n\n\ndef run_bounded(command: str, root: Path, stdin: str, timeout_s: int | None,\n                env: dict[str, str] | None = None) -> tuple[int, str, str, bool]:\n    \"\"\"(exit, stdout, stderr, timed_out) of `command` run through the shell\n    from root. The command is its own process group's leader, so a run past\n    timeout_s is ended with everything it started -- a test runner's\n    workers and a shell's background jobs alike -- rather than only the\n    shell, which would leave them holding the pipes and the machine. A run\n    that outlasts its bound exits 124, as timeout(1) does.\"\"\"\n    proc = subprocess.Popen(command, shell=True, cwd=str(root), stdin=subprocess.PIPE,\n                            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,\n                            start_new_session=True, env=env)\n    try:\n        out, err = proc.communicate(stdin, timeout=timeout_s)\n    except subprocess.TimeoutExpired:\n        _signal_group(proc, signal.SIGTERM)\n        try:\n            out, err = proc.communicate(timeout=END_GRACE_S)\n        except subprocess.TimeoutExpired:\n            _signal_group(proc, signal.SIGKILL)\n            try:\n                out, err = proc.communicate(timeout=END_GRACE_S)\n            except subprocess.TimeoutExpired:\n                # something the run started left its group and holds the pipes\n                out, err = \"\", \"\"\n        _signal_group(proc, signal.SIGKILL)\n        return TIMED_OUT_EXIT, out, err, True\n    _signal_group(proc, signal.SIGKILL)\n    return proc.returncode, out, err, False\n\n\n# --- the worker budget (#317): a bulkhead, not a pool. Every `attavo test`\n# call that runs takes a slot under <common git dir>/attavo/test-slots/ (a\n# file per call, removed when the call ends) and runs with\n# max(1, cores // calls holding a slot) workers, so several items building\n# at once share the machine instead of each asking for all of it (the\n# specimen: load averages of 33 to 75 with `-n auto` per call). A holder\n# that died without removing its file is reaped by its pid. The runner\n# reads the number from ATTAVO_TEST_WORKERS. ---\n\nSLOTS_DIR = \"attavo/test-slots\"\n\n\ndef host_cores() -> int:\n    \"\"\"ATTAVO_TEST_CORES when set (a test's, or an operator holding some\n    cores back), else what the machine has.\"\"\"\n    declared = os.environ.get(\"ATTAVO_TEST_CORES\", \"\")\n    return int(declared) if declared.isdigit() and int(declared) > 0 else (os.cpu_count() or 1)\n\n\ndef _alive(pid: int) -> bool:\n    try:\n        os.kill(pid, 0)\n    except ProcessLookupError:\n        return False\n    except PermissionError:\n        return True\n    return True\n\n\ndef slots_dir(root: Path) -> Path:\n    common = Path(git(root, \"rev-parse\", \"--git-common-dir\").strip())\n    return (common if common.is_absolute() else root / common) / SLOTS_DIR\n\n\ndef workers_for(cores: int, running: int) -> int:\n    return max(1, cores // max(1, running))\n\n\n@contextmanager\ndef test_slot(root: Path) -> Iterator[tuple[int, int, int]]:\n    \"\"\"(workers, running, cores) for this call, holding its slot until the\n    block ends. running counts this call and every live holder; a slot\n    whose pid is dead is removed first.\"\"\"\n    directory = slots_dir(root)\n    directory.mkdir(parents=True, exist_ok=True)\n    mine = directory / f\"{os.getpid()}-{uuid.uuid4().hex[:8]}.slot\"\n    mine.write_text(f\"{os.getpid()}\\n\")\n    try:\n        running = 0\n        for slot in sorted(directory.glob(\"*.slot\")):\n            try:\n                holder = int(slot.read_text().split()[0])\n            except (OSError, ValueError, IndexError):\n                holder = 0\n            if slot == mine or (holder and _alive(holder)):\n                running += 1\n            else:\n                slot.unlink(missing_ok=True)\n        cores = host_cores()\n        yield workers_for(cores, running), running, cores\n    finally:\n        mine.unlink(missing_ok=True)\n\n\n# --- the answer at the bound (#317): what passed, what failed, what did not\n# run, and the command that narrows. The runner writes one line per test to\n# the file named by ATTAVO_TEST_PROGRESS as the test ends (attavo/\n# pytest_progress.py, loaded for a tenant that declares [tests].progress =\n# \"pytest\"), so a run that is ended still leaves its results behind. ---\n\nPROGRESS_PLUGIN = \"attavo.pytest_progress\"\nPROGRESS_FILES_SHOWN = 12\nPROGRESS_FAILED_SHOWN = 10\n\n\ndef read_progress(path: Path) -> tuple[list[str], dict[str, str]]:\n    \"\"\"(collected ids in the order first seen, id -> outcome) from a\n    progress file: `C <id>` a collected test, `R <outcome> <id>` a result.\"\"\"\n    collected: dict[str, None] = {}\n    results: dict[str, str] = {}\n    try:\n        lines = path.read_text().splitlines()\n    except OSError:\n        return [], {}\n    for line in lines:\n        kind, _, rest = line.partition(\" \")\n        if kind == \"C\" and rest:\n            collected[rest] = None\n        elif kind == \"R\":\n            outcome, _, test_id = rest.partition(\" \")\n            if test_id:\n                results[test_id] = outcome\n    return list(collected), results\n\n\ndef bound_report(item_id: str, bound: int | None, collected: list[str], results: dict[str, str],\n                 narrow: str) -> str:\n    \"\"\"The text printed when a run reaches its bound.\"\"\"\n    passed = sum(1 for o in results.values() if o in (\"passed\", \"skipped\", \"xfailed\", \"xpassed\"))\n    failed = sorted(i for i, o in results.items() if o == \"failed\")\n    not_run = [i for i in collected if i not in results]\n    files = Counter(i.split(\"::\")[0] for i in not_run)\n    lines = [f\"attavo test {item_id}: stopped at {bound} s with {len(not_run)} of {len(collected)} \"\n             f\"tests not run ({passed} passed, {len(failed)} failed); the run and everything it \"\n                                text=True, check=True).stdout.split()\n        if picked == [\"tests\"] or not picked:\n            whole.append(module)\n    assert not whole, f\"module(s) the selector cannot place: {whole}\"\n\n\n\n# --- #317: tests run only through the tool, and the product reads how they were run ---\n\nEVASIONS = [\"cd tests && pytest\", \"bash -c 'pytest'\", \"timeout 60 python3 -m pytest\",\n            \"python3.11 -m pytest\", \"env X=1 pytest\"]\nTHE_TOOL = \"python3 /product/bin/attavo test 1\"\n\n\ndef tool_call(command: str, at: str = \"2026-10-01T10:00:00Z\") -> list[dict[str, str]]:\n    return [{\"at\": at, \"kind\": \"tool_call\", \"text\": \"Bash \" + command},\n            {\"at\": at, \"kind\": \"tool_result\", \"text\": \"ok\"}]\n\n\n@pytest.mark.parametrize(\"command\", EVASIONS + [\"pytest -q\", \"python3 -m pytest -q tests/x.py\",\n                                                \"python3 -m unittest\", \"npm test\", \"cargo test\"])\ndef test_a_test_runner_run_outside_the_tool_is_named(command: str) -> None:\n    found = runner_calls_outside_the_tool(tool_call(command))\n    assert found == [(\"2026-10-01T10:00:00Z\", command)], found\n\n\n@pytest.mark.parametrize(\"command\", [\n    f\"{THE_TOOL} tests/test_a.py 2>&1 | tail -50\",\n    f\"for f in tests/test_*.py; do {THE_TOOL} $f; done\",\n    \"pip install pytest\", \"grep -rn pytest tests | head\", \"git commit -m 'run pytest'\",\n    \"python3 -c 'import pytest; print(pytest.__version__)'\", \"ls tests && cat tests/conftest.py\",\n])\ndef test_the_tool_and_a_mention_of_a_runner_are_not_a_runner_run(command: str) -> None:\n    assert runner_calls_outside_the_tool(tool_call(command)) == []\n\n\ndef test_a_call_the_permission_layer_denied_did_not_run() -> None:\n    events = [{\"at\": \"t\", \"kind\": \"tool_call\", \"text\": \"Bash pytest -q\"},\n              {\"at\": \"t\", \"kind\": \"tool_result\",\n               \"text\": \"Permission to use Bash with command pytest -q has been denied.\"}]\n    assert runner_calls_outside_the_tool(events) == []\n\n\ndef gated_tenant(tmp_path: Path, calls: list[str], tests: str = \"\") -> tuple[Path, dict[str, str]]:\n    \"\"\"A tenant whose build adapter appends the given Bash calls to the\n    stage's events as an executor's stream would, then commits.\"\"\"\n    root = tenant(tmp_path, checks='[checks]\\ncommand = \"true\"', tests=tests)\n    feed = tmp_path / \"executor-events.jsonl\"\n    feed.write_text(\"\".join(json.dumps(e) + \"\\n\" for c in calls for e in tool_call(c)))\n    (root / \"attavo\" / \"adapters\" / \"fixture\").mkdir(parents=True)\n    run = root / \"attavo\" / \"adapters\" / \"fixture\" / \"run\"\n    run.write_text('#!/bin/sh\\ncat \"$FIXTURE_EVENTS\" >> \"$ATTAVO_EVENTS\"\\n'\n                   'cp \"$ATTAVO_FEEDBACK\" \"$SEEN_FEEDBACK\"\\n'\n                   'if [ -f built.txt ]; then echo again >> built.txt; else echo built > built.txt; fi\\ngit add built.txt\\ngit commit -q -m built\\n'\n                   'printf \\'{\"status\": \"done\", \"question\": null, \"model\": \"fixture\"}\\\\n\\'\\n')\n    run.chmod(0o755)\n    commit_all(root, \"an adapter that streams the given calls\")\n    approve_item(root)\n    return root, {\"FIXTURE_EVENTS\": str(feed), \"SEEN_FEEDBACK\": str(tmp_path / \"seen-feedback.txt\")}\n\n\n@pytest.mark.parametrize(\"command\", EVASIONS)\ndef test_a_build_that_ran_a_runner_outside_the_tool_is_returned_by_name(tmp_path: Path, command: str) -> None:\n    root, env = gated_tenant(tmp_path, [f\"{THE_TOOL} tests/test_a.py\", command])\n    run = run_attavo(root, \"build\", \"1\", env=env)\n    assert run.returncode == 1, run.stdout + run.stderr\n    rec = build_record(root)\n    assert rec[\"status\"] == \"refused\" and rec[\"refusal_kind\"] == \"test-bypass\", rec\n    assert rec[\"stop\"][\"class\"] == \"test-bypass\" and rec[\"stop\"][\"provenance\"] == \"executor\"\n    assert command in rec[\"stop\"][\"detail\"] and \"attavo test\" in rec[\"stop\"][\"detail\"], rec[\"stop\"]\n    jsonschema.validate(rec, json.loads((ROOT / \"schema\" / \"records\" / \"build.schema.json\").read_text()))\n\n\nODD_RUN = \"xargs -r -n 4 ./bin/oddtest --fast\"\nODD_RUNNER = '[tests]\\nselect = \"cat\"\\nrun = \"xargs -r -n 4 ./bin/oddtest --fast\"'\n\n\ndef test_the_runner_the_tenants_run_line_names_is_a_runner_the_gate_recognizes() -> None:\n    from attavo.testtool import tenant_runner\n    assert tenant_runner(\"xargs -r python3 -m pytest -q -n 4\") == [\"python3\", \"-m\", \"pytest\"]\n    assert tenant_runner(\"FOO=1 xargs -r -n 4 ./bin/oddtest --fast\") == [\"./bin/oddtest\"]\n    assert runner_calls_outside_the_tool(tool_call(\"true && sh -c 'ls'\"), \"true\") == []\n    assert runner_calls_outside_the_tool(tool_call(\"bash x.sh\"), \"bash -c 'x'\") == []\n    assert tenant_runner(\"\") == [] and tenant_runner(\"xargs -r\") == []\n\n\n@pytest.mark.parametrize(\"command\", [\"./bin/oddtest tests/a\", \"cd x && ./bin/oddtest\", \"env X=1 bin/oddtest\"])\ndef test_a_runner_not_on_the_built_in_list_is_named_by_the_tenants_own_run_line(\n        tmp_path: Path, command: str) -> None:\n    root, env = gated_tenant(tmp_path, [f\"{THE_TOOL} tests/test_a.py\", command], tests=ODD_RUNNER)\n    assert runner_calls_outside_the_tool(tool_call(command)) == []  # the built-ins alone miss it\n    assert runner_calls_outside_the_tool(tool_call(command), ODD_RUN) != []\n    run = run_attavo(root, \"build\", \"1\", env=env)\n    assert run.returncode == 1, run.stdout + run.stderr\n    rec = build_record(root)\n    assert rec[\"status\"] == \"refused\" and rec[\"refusal_kind\"] == \"test-bypass\", rec\n    assert command in rec[\"stop\"][\"detail\"], rec[\"stop\"]\n\n\ndef test_a_build_that_used_only_the_tool_is_not_returned(tmp_path: Path) -> None:\n    root, env = gated_tenant(tmp_path, [f\"{THE_TOOL} tests/test_a.py 2>&1 | tail -20\", \"pip install pytest\",\n                                        \"grep -rn pytest tests\"])\n    run = run_attavo(root, \"build\", \"1\", env=env)\n    assert run.returncode == 0, run.stdout + run.stderr\n    assert build_record(root)[\"status\"] == \"pass\"\n\n\ndef test_the_retry_of_a_returned_build_is_steered_to_the_tool(tmp_path: Path) -> None:\n    from attavo.stops import RETRYABLE_CLASSES\n    assert \"test-bypass\" in RETRYABLE_CLASSES\n    root, env = gated_tenant(tmp_path, [\"cd tests && pytest -q\"])\n    assert run_attavo(root, \"build\", \"1\", env=env).returncode == 1\n    (tmp_path / \"executor-events.jsonl\").write_text(\"\")\n    assert run_attavo(root, \"build\", \"1\", env=env).returncode == 0\n    seen = (tmp_path / \"seen-feedback.txt\").read_text()\n    assert \"stopped as test-bypass\" in seen and \"cd tests && pytest -q\" in seen, seen\n    assert \"run tests only with attavo test\" in seen, seen\n\n\n# --- #317: the selector's rows and its import graph ---\n\ndef selector(*paths: str, script: Path = SELECT) -> subprocess.CompletedProcess[str]:\n    return subprocess.run([sys.executable, str(script)], input=\"\".join(p + \"\\n\" for p in paths),\n                          capture_output=True, text=True, check=True)\n\n\ndef test_workflows_bin_attavo_and_the_fixture_adapter_select_the_tests_that_name_them() -> None:\n    for path, expected in ((\".github/workflows/ci.yml\", \"tests/test_ci_inherit.py\"),\n                           (\"bin/attavo\", \"tests/test_cli_help.py\"),\n                           (\"adapters/fixture/run\", \"tests/test_executor_conformance.py\")):\n        picked = selector(path).stdout.split()\n/Users/davidbean/Projects/attest/adapters/claude-code/run-540-# own allowed tools never included either, and did not
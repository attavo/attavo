               \"grep -rn pytest tests\"])\n/Users/davidbean/Projects/attest/tests/test_testtool.py:509:    assert \"test-bypass\" in RETRYABLE_CLASSES\n/Users/davidbean/Projects/attest/tests/test_testtool.py:510:    root, env = gated_tenant(tmp_path, [\"cd tests && pytest -q\"])\n/Users/davidbean/Projects/attest/tests/test_testtool.py:515:    assert \"stopped as test-bypass\" in seen and \"cd tests && pytest -q\" in seen, seen\n/Users/davidbean/Projects/attest/tests/test_testtool.py:516:    assert \"run tests only with attavo test\" in seen, seen\n/Users/davidbean/Projects/attest/tests/test_testtool.py:544:                         (\"tests/conftest.py\", \"pytest loads it for every test\"),\n/Users/davidbean/Projects/attest/tests/test_testtool.py:658:    text = bound_report(\"9\", 240, collected, results, \"attavo test 9\")\n/Users/davidbean/Projects/attest/tests/test_testtool.py:659:    assert text.splitlines()[0] == (\"attavo test 9: stopped at 240 s with 2 of 6 tests not run \"\n/Users/davidbean/Projects/attest/tests/test_testtool.py:663:    assert text.splitlines()[-1].startswith(\"narrow it: attavo test 9 <path>\")\n/Users/davidbean/Projects/attest/tests/test_testtool.py:664:    big = bound_report(\"9\", 240, [f\"tests/test_{i:02d}.py::t\" for i in range(40)], {}, \"attavo test 9\")\n/Users/davidbean/Projects/attest/tests/test_testtool.py:675:    root = tenant(tmp_path, tests='[tests]\\nselect = \"cat\"\\ncall_timeout_s = 3\\nprogress = \"pytest\"\\n'\n/Users/davidbean/Projects/attest/tests/test_testtool.py:695:@pytest.mark.parametrize(\"workers\", [\"0\", \"2\"])\n/Users/davidbean/Projects/attest/tests/test_testtool.py:697:    \"\"\"The plugin `attavo test` loads for a pytest tenant: a line per\n/Users/davidbean/Projects/attest/tests/test_testtool.py:702:                                     \"import pytest\\n\\n\\n@pytest.mark.skip\\ndef test_skipped():\\n    pass\\n\")\n/Users/davidbean/Projects/attest/tests/test_testtool.py:705:    run = subprocess.run([sys.executable, \"-m\", \"pytest\", \"-q\", \"-p\", \"no:cacheprovider\", \"-n\", workers,\n/Users/davidbean/Projects/attest/tests/test_testtool.py:706:                          \"-p\", \"attavo.pytest_progress\", str(suite)],\n/Users/davidbean/Projects/attest/tests/test_own_records_guard.py:4:marked @pytest.mark.own_records and are the only ones `test` runs on the\n/Users/davidbean/Projects/attest/tests/test_own_records_guard.py:22:Run: python3 -m pytest tests -q\n/Users/davidbean/Projects/attest/tests/test_own_records_guard.py:30:import pytest\n/Users/davidbean/Projects/attest/tests/test_own_records_guard.py:33:MARK = \"pytest.mark.own_records\"\n/Users/davidbean/Projects/attest/tests/test_own_records_guard.py:57:                isinstance(n, ast.Assign) and any(isinstance(t, ast.Name) and t.id == \"pytestmark\"\n/Users/davidbean/Projects/attest/tests/test_own_records_guard.py:91:@pytest.mark.parametrize(\"reader\", [\n/Users/davidbean/Projects/attest/tests/test_own_records_guard.py:103:        f\"import pytest\\n\\n\\n@pytest.mark.own_records\\ndef test_reads() -> None:\\n    {reader}\\n\")\n/Users/davidbean/Projects/attest/tests/test_own_records_guard.py:105:        f\"import pytest\\n\\npytestmark = pytest.mark.own_records\\n\\n\\ndef test_reads() -> None:\\n    {reader}\\n\")\n/Users/davidbean/Projects/attest/tests/test_verify_codex_proof.py:14:Run: python3 -m pytest tests -q\n/Users/davidbean/Projects/attest/tests/conftest.py:4:import pytest\n/Users/davidbean/Projects/attest/tests/conftest.py:9:@pytest.fixture(autouse=True)\n/Users/davidbean/Projects/attest/tests/conftest.py:10:def _short_forge_poll(monkeypatch: pytest.MonkeyPatch) -> None:\n/Users/davidbean/Projects/attest/tests/conftest.py:26:@pytest.fixture(autouse=True)\n/Users/davidbean/Projects/attest/tests/conftest.py:27:def _no_inherited_git_identity(monkeypatch: pytest.MonkeyPatch) -> None:\n/Users/davidbean/Projects/attest/tests/test_sealed_since_default.py:7:Run: python3 -m pytest tests/test_sealed_since_default.py -q\n/Users/davidbean/Projects/attest/tests/test_cli_help.py:5:Run: python3 -m pytest tests -q\n/Users/davidbean/Projects/attest/tests/test_cli_help.py:24:    \"\"\"Issue #212: attavo test is the executor's one test command.\"\"\"\n/Users/davidbean/Projects/attest/tests/test_cli_help.py:28:    assert \"attavo test [N]\" in run.stdout\n/Users/davidbean/Projects/attest/tests/test_cli_help.py:93:    assert \"attavo test [N] [--all | <test>...] [--fresh]\" in run.stdout, run.stdout\n/Users/davidbean/Projects/attest/tests/test_adapters_codex.py:22:Run: python3 -m pytest tests -q\n/Users/davidbean/Projects/attest/tests/test_adapters_codex.py:32:import pytest\n/Users/davidbean/Projects/attest/tests/test_adapters_codex.py:353:@pytest.mark.parametrize(\"second_status,second_question\", [\n/Users/davidbean/Projects/attest/tests/test_working_copy.py:6:Run: python3 -m pytest tests -q\n/Users/davidbean/Projects/attest/tests/test_pass.py:7:Run: python3 -m pytest tests -q\n/Users/davidbean/Projects/attest/tests/test_doctor_sealed.py:7:Run: python3 -m pytest tests -q\n/Users/davidbean/Projects/attest/tests/test_issues.py:5:Run: python3 -m pytest tests/test_issues.py -q\n/Users/davidbean/Projects/attest/tests/test_issues.py:18:import pytest\n/Users/davidbean/Projects/attest/tests/test_issues.py:87:def test_a_command_that_runs_past_its_bound_is_not_read(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:\n/Users/davidbean/Projects/attest/tests/test_issues.py:100:    with pytest.raises(jsonschema.ValidationError):\n/Users/davidbean/Projects/attest/tests/test_coherence_template.py:17:Run: python3 -m pytest tests -q\n/Users/davidbean/Projects/attest/tests/test_plan.py:5:Run: python3 -m pytest tests/test_plan.py -q\n/Users/davidbean/Projects/attest/tests/test_plan.py:17:import pytest\n/Users/davidbean/Projects/attest/tests/test_plan.py:41:@pytest.fixture(autouse=True)\n/Users/davidbean/Projects/attest/tests/test_plan.py:42:def no_store_override(monkeypatch: pytest.Mon
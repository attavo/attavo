{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Gqoem3iVgAwzensdtQq2ef","type":"tool_result","content":"1\t\"\"\"The record kinds, typed. Each TypedDict here mirrors one JSON schema: its\n2\tkeys are that schema's `properties` and its required keys are that schema's\n3\t`required`, and tests/test_types_mirror_schemas.py asserts both, so the type\n4\tcannot drift from the contract. The schema stays the contract; this is its\n5\tmirror (issue #189).\n6\t\n7\tEvery key each schema lists is required, so no class here is total=False; a\n8\tkey the schema someday makes optional goes in a total=False base. A value the\n9\tschema declares as an object with fixed properties but this module does not\n10\tyet name is a dict[str, Any] (or a list of them), no tighter than the schema's\n11\town `additionalProperties` allows for the adapter-owned ones.\n12\t\"\"\"\n13\tfrom __future__ import annotations\n14\t\n15\tfrom typing import Any, Literal, NotRequired, TypedDict\n16\t\n17\t# The stage names a record file's <stage>-NN.json prefix can carry, one per\n18\t# schema under schema/records/.\n19\tStage = Literal[\"spec\", \"approval\", \"build\", \"verify\", \"counsel\"]\n20\t\n21\t# \"class\" is a Python keyword, so the record kinds that carry it are built\n22\t# with the functional syntax. signature and bound are R3's own additions,\n23\t# optional (a record older than record_version 8/7 carries neither).\n24\t_StopRequired = TypedDict(\"_StopRequired\", {\n25\t    \"class\": str,\n26\t    \"provenance\": str,\n27\t    \"detail\": str | None,\n28\t})\n29\t_StopOptional = TypedDict(\"_StopOptional\", {\n30\t    \"signature\": str | None,\n31\t    \"bound\": str | None,\n32\t}, total=False)\n33\t\n34\t\n35\tclass Stop(_StopRequired, _StopOptional):\n36\t    \"\"\"build-NN.json's and verify-NN.json's `stop`: the class of a stop and whose\n37\t    it is. The two schemas enumerate different classes; the shape is the same.\"\"\"\n38\t\n39\t\n40\tclass _SpecOptional(TypedDict, total=False):\n41\t    # Written from spec/3 on (ruled 2026-09-27); records before it carry neither.\n42\t    # Each entry of `criteria` carries `kind` (\"behavioural\" | \"structural\")\n43\t    # from spec/4 on; an older entry carries none and was structural.\n44\t    # \"class\" is a Python keyword, hence the functional form below.\n45\t    research: str\n46\t\n47\t\n48\t_SpecClass = TypedDict(\"_SpecClass\", {\"class\": str | None}, total=False)\n49\t\n50\t\n51\tclass SpecRecord(_SpecOptional, _SpecClass):\n52\t    record_version: int\n53\t    item: str\n54\t    sha: str\n55\t    spec_sha: str | None\n56\t    at: str\n57\t    status: str\n58\t    approval_sha: str | None\n59\t    criteria: list[dict[str, Any]]\n60\t    refusal: str | None\n61\t    product_version: str\n62\t    product_pin: str | None\n63\t\n64\t\n65\tclass ApprovalRecord(TypedDict):\n66\t    record_version: int\n67\t    item: str\n68\t    sha: str\n69\t    spec_sha: str | None\n70\t    approved_by: str\n71\t    at: str\n72\t    product_version: str\n73\t    product_pin: str | None\n74\t\n75\t\n76\tclass _BuildRequired(TypedDict):\n77\t    record_version: int\n78\t    item: str\n79\t    sha: str\n80\t    start_sha: str\n81\t    spec_sha: str | None\n82\t    approval_sha: str | None\n83\t    at: str\n84\t    adapter: str\n85\t    adapter_config: dict[str, Any]\n86\t    executor_identity: dict[str, str]\n87\t    reports: list[str]\n88\t    adapter_version: str | None\n89\t    model: str | None\n90\t    model_version: str | None\n91\t    iterations: int\n92\t    criteria: list[dict[str, Any]]\n93\t    selected_tests: dict[str, Any] | None\n94\t    checks: dict[str, Any] | None\n95\t    tokens: dict[str, int]\n96\t    cost_usd: float | None\n97\t    wall_clock_s: float\n98\t    status: str\n99\t    refusal: str | None\n100\t    halted: dict[str, Any] | None\n101\t    refusal_kind: str | None\n102\t    report_class: str | None\n103\t    stop: Stop | None\n104\t    product_version: str\n105\t    product_pin: str | None\n106\t\n107\t\n108\tclass _BuildOptional(TypedDict, total=False):\n109\t    retry_of: str | None\n110\t    steer: str | None\n111\t\n112\t\n113\tclass BuildRecord(_BuildRequired, _BuildOptional):\n114\t    \"\"\"build-NN.json (issue #60): retry_of and steer (R3) are optional --\n115\t    absent on a record written before this release.\"\"\"\n116\t\n117\t\n118\tclass _VerifyRequired(TypedDict):\n119\t    record_version: int\n120\t    item: str\n121\t    sha: str\n122\t    build_sha: str\n123\t    build_record: str | None\n124\t    approval_sha: str | None\n125\t    at: str\n126\t    adapter: str | None\n127\t    adapter_config: dict[str, Any]\n128\t    adapter_version: str | None\n129\t    model: str | None\n130\t    model_version: str | None\n131\t    reports: list[str]\n132\t    forge_checks: dict[str, Any]\n133\t    findings: list[dict[str, Any]] | None\n134\t    tests_named: list[str]\n135\t    commits: list[str]\n136\t    stub_ratio: float | None\n137\t    tokens: dict[str, int]\n138\t    cost_usd: float | None\n139\t    wall_clock_s: float\n140\t    status: str\n141\t    report_class: str | None\n142\t    stop: Stop | None\n143\t    product_version: str\n144\t    product_pin: str | None\n145\t\n146\t\n147\tclass _VerifyOptional(TypedDict, total=False):\n148\t    retry_of: str | None\n149\t    steer: str | None\n150\t\n151\t\n152\tclass VerifyRecord(_VerifyRequired, _VerifyOptional):\n153\t    \"\"\"verify-NN.json (issue #60): retry_of and steer (R3) are optional --\n154\t    absent on a record written before this release.\"\"\"\n155\t\n156\t\n157\tclass CounselCitation(TypedDict):\n158\t    \"\"\"One counsel citation (#328): `resolution` is absent for a repository\n159\t    file at the record's sha.\"\"\"\n160\t    kind: str\n161\t    path: str | None\n162\t    symbol: str | None\n163\t    ruling_id: str | None\n164\t    resolution: NotRequired[Literal[\"input\", \"not_in_repository\", \"not_found_at_sha\"]]\n165\t\n166\t\n16
 \"\"\"Every record's cost summed: the item's total across stages and\n228\t    executors, with a subtotal per stage and per adapter. A reported\n229\t    cost_usd is taken as it stands; a null one whose model has a tenant\n230\t    rate is priced as tokens times that rate (issue #307), and the basis\n231\t    says which. A record neither reported nor priceable is named in\n232\t    not_read and makes every sum it belongs to partial -- absent is never\n233\t    zero.\"\"\"\n234\t    usd: float\n235\t    reported_usd: float\n236\t    estimated_usd: float\n237\t    by_stage_usd: dict[str, float]\n238\t    basis_by_stage: dict[str, str]\n239\t    by_adapter_usd: dict[str, float]\n240\t    rates: dict[str, CostRate]\n241\t    estimate_note: str\n242\t    partial: bool\n243\t    not_read: list[str]\n244\t\n245\t\n246\tclass StageTokens(TypedDict):\n247\t    \"\"\"One stage's tokens summed over every attempt (the statement's `tokens` block).\"\"\"\n248\t    input: int\n249\t    output: int\n250\t    partial: bool\n251\t\n252\t\n253\tclass ItemTokens(TypedDict):\n254\t    \"\"\"Every record's tokens summed, per stage and for the item. A record\n255\t    that carries no tokens is named in not_read and makes every sum it\n256\t    belongs to partial -- absent is never zero.\"\"\"\n257\t    build: StageTokens\n258\t    verify: StageTokens\n259\t    counsel: StageTokens\n260\t    input: int\n261\t    output: int\n262\t    partial: bool\n263\t    not_read: list[str]\n264\t\n265\t\n266\tclass AttestRecord(TypedDict):\n267\t    \"\"\"The statement `attavo attest` prints (schema/attestation.schema.json).\"\"\"\n268\t    sha: str\n269\t    merge_sha: str\n270\t    item: str\n271\t    spec: str | None\n272\t    spec_sha: str | None\n273\t    approval: str | None\n274\t    approval_sha: str | None\n275\t    build: str | None\n276\t    build_sha: str | None\n277\t    verify: str | None\n278\t    verify_sha: str | None\n279\t    at: str\n280\t    interventions: list[dict[str, str]]\n281\t    acts: list[dict[str, str]]\n282\t    time: ItemTime\n283\t    cost: ItemCost\n284\t    tokens: ItemTokens\n285\t    product_version: str\n286\t    product_pin: str | None\n287\t\n288\t\n289\t# What counsel reads a stop from: a build or verify record, or a refused\n290\t# spec-gate record (issue #133).\n291\tStageRecord = SpecRecord | BuildRecord | VerifyRecord\n292\t\n293\t\n294\tclass DriveReport(TypedDict):\n295\t    \"\"\"What `attavo drive N --report` prints (schema/drive-report.schema.json):\n296\t    the item's level, read from its records, its markers, and the forge.\"\"\"\n297\t    item: str\n298\t    state: str\n299\t    kind: str\n300\t    says: str\n301\t    stage: str | None\n302\t    attempt: int | None\n303\t    record: str | None\n304\t    stop_class: str | None\n305\t    counsel: str | None\n306\t    filed: str | None\n307\t    head: str | None\n308\t    checks: list[dict[str, str]] | None\n309\t    since: str | None\n310\t    last_event_age_s: int | None\n311\t    attempts: list[dict[str, Any]] | None\n312\t    signatures_match: bool | None\n313\t    rulings_available: list[str] | None\n314\t"}]},"parent_tool_use_id":null,"session_id":"98798923-8d1f-4f23-9171-7d9c27508aed","uuid":"e82727a2-439a-43ce-bc5c-b44452ce7c25","timestamp":"2026-10-15T15:11:58.864Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-360/attavo/types.py","content":"\"\"\"The record kinds, typed. Each TypedDict here mirrors one JSON schema: its\nkeys are that schema's `properties` and its required keys are that schema's\n`required`, and tests/test_types_mirror_schemas.py asserts both, so the type\ncannot drift from the contract. The schema stays the contract; this is its\nmirror (issue #189).\n\nEvery key each schema lists is required, so no class here is total=False; a\nkey the schema someday makes optional goes in a total=False base. A value the\nschema declares as an object with fixed properties but this module does not\nyet name is a dict[str, Any] (or a list of them), no tighter than the schema's\nown `additionalProperties` allows for the adapter-owned ones.\n\"\"\"\nfrom __future__ import annotations\n\nfrom typing import Any, Literal, NotRequired, TypedDict\n\n# The stage names a record file's <stage>-NN.json prefix can carry, one per\n# schema under schema/records/.\nStage = Literal[\"spec\", \"approval\", \"build\", \"verify\", \"counsel\"]\n\n# \"class\" is a Python keyword, so the record kinds that carry it are built\n# with the functional syntax. signature and bound are R3's own additions,\n# optional (a record older than record_version 8/7 carries neither).\n_StopRequired = TypedDict(\"_StopRequired\", {\n    \"class\": str,\n    \"provenance\": str,\n    \"detail\": str | None,\n})\n_StopOptional = TypedDict(\"_StopOptional\", {\n    \"signature\": str | None,\n    \"bound\": str | None,\n}, total=False)\n\n\nclass Stop(_StopRequired, _StopOptional):\n    \"\"\"build-NN.json's and verify-NN.json's `stop`: the class of a stop and whose\n    it is. The two schemas enumerate different classes; the shape is the same.\"\"\"\n\n\nclass _SpecOptional(TypedDict, total=False):\n    # Written from spec/3 on (ruled 2026-09-27); records before it carry neither.\n    # Each entry of `criteria` carries `kind` (\"behavioural\" | \"structural\")\n    # from spec/4 on; an older entry carries none and was structural.\n    # \"class\" is a Python keyword, hence the functional form below.\n    research: str\n\n\n_SpecClass = TypedDict(\"_SpecClass\", {\"class\": str | None}, total=False)\n\n\nclass SpecRecord(_SpecOptional, _SpecClass):\n    record_version: int\n    item: str\n    sha: str\n    spec_sha: str | None\n    at: str\n    status: str\n    approval_sha: str | None\n    criteria: list[dict[str, Any]]\n    refusal: str | None\n    product_version: str\n    product_pin: str | None\n\n\nclass ApprovalRecord(TypedDict):\n    record_version: int\n    item: str\n    sha: str\n    spec_sha: str | None\n    approved_by: str\n    at: str\n    product_version: str\n    product_pin: str | None\n\n\nclass _BuildRequired(TypedDict):\n    record_version: int\n    item: str\n    sha: str\n    start_sha: str\n    spec_sha: str | None\n    approval_sha: str | None\n    at: str\n    adapter: str\n    adapter_config: dict[str, Any]\n    executor_identity: dict[str, str]\n    reports: list[str]\n    adapter_version: str | None\n    model: str | None\n    model_version: str | None\n    iterations: int\n    criteria: list[dict[str, Any]]\n    selected_tests: dict[str, Any] | None\n    checks: dict[str, Any] | None\n    tokens: dict[str, int]\n    cost_usd: float | None\n    wall_clock_s: float\n    status: str\n    refusal: str | None\n    halted: dict[str, Any] | None\n    refusal_kind: str | None\n    report_class: str | None\n    stop: Stop | None\n    product_version: str\n    product_pin: str | None\n\n\nclass _BuildOptional(TypedDict, total=False):\n    retry_of: str | None\n    steer: str | None\n\n\nclass BuildRecord(_BuildRequired, _BuildOptional):\n    \"\"\"build-NN.json (issue #60): retry_of and steer (R3) are optional --\n    absent on a record written before this release.\"\"\"\n\n\nclass _VerifyRequired(TypedDict):\n    record_version: int\n    item: str\n    sha: str\n    build_sha: str\n    build_record: str | None\n    approval_sha: str | None\n    at: str\n    adapter: str | None\n    adapter_config: dict[str, Any]\n    adapter_version: str | None\n    model: str | None\n    model_version: str | None\n    reports: list[str]\n    forge_checks: dict[str, Any]\n    findings: list[dict[str, Any]] | None\n    tests_named: list[str]\n    commits: list[str]\n    stub_ratio: float | None\n    tokens: dict[str, int]\n    cost_usd: float | None\n    wall_clock_s: float\n    status: str\n    report_class: str | None\n    stop: Stop | None\n    product_version: str\n    product_pin: str | None\n\n\nclass _VerifyOptional(TypedDict, total=False):\n    retry_of: str | None\n    steer: str | None\n\n\nclass VerifyRecord(_VerifyRequired, _VerifyOptional):\n    \"\"\"verify-NN.json (issue #60): retry_of and steer (R3) are optional --\n    absent on a record written before this release.\"\"\"\n\n\nclass CounselCitation(TypedDict):\n    \"\"\"One counsel citation (#328): `resolution` is absent for a repository\n    file at the record's sha.\"\"\"\n    kind: str\n    path: str | None\n    symbol: str | None\n    ruling_id: str | None\n    resolution: NotRequired[Literal[\"input\", \"not_in_repository\", \"not_found_at_sha\"]]\n\n\nCounselRecord = TypedDict(\"CounselRecord\", {\n    \"record_version\": int,\n    \"item\": str,\n    \"sha\": str,\n    \"record_stage\": str,\n    \"record\": str,\n    \"at\": str,\n    \"adapter\": str | None,\n    \"adapter_config\": dict[str, Any],\n    \"adapter_version\": str | None,\n    \"model\": str | None,\n    \"model_version\": str | None,\n    \"reports\": list[str],\n    \"tokens\": dict[str, int],\n    \"cost_usd\": float | None,\n    \"wall_clock_s\": float,\n    \"status\": str,\n    \"class\": str | None,\n    \"verdict\": str | None,\n    \"citations\": list[CounselCitation],\n    \"proposal\": dict[str, Any],\n    \"forge\": dict[str, Any],\n    \"question\": str | None,\n    \"answers\": str | None,\n    \"turn\": dict[str, Any] | None,\n    \"product_version\": str,\n    \"product_pin\": str | None,\n})\n\n\nclass StageTime(TypedDict):\n    \"\"\"One stage's invocations summed (the statement's `time` block).\"\"\"\n    attempts: int\n    invocation_s: float\n    partial: bool\n\n\nclass ItemTime(TypedDict):\n    \"\"\"Every invocation's wall_clock_s, per stage and for the item, beside\n    the item's lead time -- summed from the records by `attavo attest`, so\n    a view renders it and never derives it.\"\"\"\n    build: StageTime\n    verify: StageTime\n    counsel: StageTime\n    invocation_s: float\n    lead_s: float | None\n    waiting_s: float | None\n    partial: bool\n    not_read: list[str]\n\n\nclass CostRate(TypedDict):\n    \"\"\"A tenant's published price for one model ([cost.rates.\"<model>\"]).\"\"\"\n    input_usd_per_mtok: float\n    output_usd_per_mtok: float\n    as_of: str\n    source: str\n\n\nclass ItemCost(TypedDict):\n    \"\"\"Every record's cost summed: the item's total across stages and\n    executors, with a subtotal per stage and per adapter. A reported\n    cost_usd is taken as it stands; a null one whose model has a tenant\n    rate is priced as tokens times that rate (issue #307), and the basis\n    says which. A record neither reported nor priceable is named in\n    not_read and makes every sum it belongs to partial -- absent is never\n    zero.\"\"\"\n    usd: float\n    reported_usd: float\n    estimated_usd: float\n    by_stage_usd: dict[str, float]\n    basis_by_stage: dict[str, str]\n    by_adapter_usd: dict[str, float]\n    rates: dict[str, CostRate]\n    estimate_note: str\n    partial: bool\n    not_read: list[str]\n\n\nclass StageTokens(TypedDict):\n    \"\"\"One stage's tokens summed over every attempt (the statement's `tokens` block).\"\"\"\n    input: int\n    output: int\n    partial: bool\n\n\nclass ItemTokens(TypedDict):\n    \"\"\"Every record's tokens summed, per stage and for the item. A record\n    that carries no tokens is named in not_read and makes every sum it\n    belongs to partial -- absent is never zero.\"\"\"\n    build: StageTokens\n    verify: StageTokens\n    counsel: StageTokens\n    input: int\n    output: int\n    partial: bool\n    not_read: list[str]\n\n\nclass AttestRecord(TypedDict):\n    \"\"\"The statement `attavo attest` prints (schema/attestation.schema.json).\"\"\"\n    sha: str\n    merge_sha: str\n    item: str\n    spec: str | None\n    spec_sha: str | None\n    approval: str | None\n    approval_sha: str | None\n    build: str | None\n    build_sha: str | None\n    verify: str | None\n    verify_sha: str | None\n    at: str\n    interventions: list[dict[str, str]]\n    acts: list[dict[str, str]]\n    time: ItemTime\n    cost: ItemCost\n    tokens: ItemTokens\n    product_version: str\n    product_pin: str | None\n\n\n# What counsel reads a stop from: a build or verify record, or a refused\n# spec-gate record (issue #133).\nStageRecord = SpecRecord | BuildRecord | VerifyRecord\n\n\nclass DriveReport(TypedDict):\n    \"\"\"What `attavo drive N --report` prints (schema/drive-report.schema.json):\n    the item's level, read from its records, its markers, and the forge.\"\"\"\n    item: str\n    state: str\n    kind: str\n    says: str\n    stage: str | None\n    attempt: int | None\n    record: str | None\n    stop_class: str | None\n    counsel: str | None\n    filed: str | None\n    head: str | None\n    checks: list[dict[str, str]] | None\n    since: str | None\n    last_event_age_s: int | None\n    attempts: list[dict[str, Any]] | None\n    signatures_match: bool | None\n    rulings_available: list[str] | None\n","numLines":314,"startLine":1,"totalLines":314}},"tool_result_meta":[{"id":"toolu_01Gqoem3iVgAwzensdtQq2ef","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}

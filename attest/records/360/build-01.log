{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Y5Dr1oVYruHYeniVGG6g8o","type":"tool_result","content":"1\t\"\"\"Issue #189: attavo/types.py is the mirror of schema/records/*.schema.json\n2\tand schema/attestation.schema.json. The schema stays the contract; each\n3\trecord TypedDict's keys equal the schema's `properties` and its required\n4\tkeys equal the schema's `required`, so the type cannot drift from it.\n5\t\n6\tRun: python3 -m pytest tests -q\n7\t\"\"\"\n8\tfrom __future__ import annotations\n9\t\n10\timport json\n11\tfrom pathlib import Path\n12\tfrom typing import Any\n13\t\n14\timport pytest\n15\t\n16\tfrom attavo import types\n17\t\n18\tROOT = Path(__file__).resolve().parent.parent\n19\tSCHEMA = ROOT / \"schema\"\n20\t\n21\t# The TypedDict for each schema, by the schema's path under schema/.\n22\tRECORD_KINDS = {\n23\t    \"SpecRecord\": \"records/spec.schema.json\",\n24\t    \"ApprovalRecord\": \"records/approval.schema.json\",\n25\t    \"BuildRecord\": \"records/build.schema.json\",\n26\t    \"VerifyRecord\": \"records/verify.schema.json\",\n27\t    \"CounselRecord\": \"records/counsel.schema.json\",\n28\t    \"AttestRecord\": \"attestation.schema.json\",\n29\t    \"DriveReport\": \"drive-report.schema.json\",\n30\t}\n31\t\n32\t# The Stop sub-shape appears in build and verify records, each with its own\n33\t# class enum; the type is one shape and the schemas carry the same three keys.\n34\tSTOP_HOMES = (\"records/build.schema.json\", \"records/verify.schema.json\")\n35\t\n36\t\n37\tdef load(path: str) -> dict[str, Any]:\n38\t    schema: dict[str, Any] = json.loads((SCHEMA / path).read_text())\n39\t    return schema\n40\t\n41\t\n42\t@pytest.mark.parametrize(\"kind\", sorted(RECORD_KINDS))\n43\tdef test_the_typeddict_keys_equal_the_schemas_properties(kind: str) -> None:\n44\t    schema = load(RECORD_KINDS[kind])\n45\t    td = getattr(types, kind)\n46\t    assert set(td.__annotations__) == set(schema[\"properties\"])\n47\t\n48\t\n49\t@pytest.mark.parametrize(\"kind\", sorted(RECORD_KINDS))\n50\tdef test_the_typeddicts_required_keys_equal_the_schemas_required(kind: str) -> None:\n51\t    schema = load(RECORD_KINDS[kind])\n52\t    td = getattr(types, kind)\n53\t    assert set(td.__required_keys__) == set(schema[\"required\"])\n54\t    assert set(td.__optional_keys__) == set(schema[\"properties\"]) - set(schema[\"required\"])\n55\t\n56\t\n57\t@pytest.mark.parametrize(\"path\", STOP_HOMES)\n58\tdef test_the_stop_shape_mirrors_the_stop_in_each_schema_that_carries_one(path: str) -> None:\n59\t    stop = load(path)[\"properties\"][\"stop\"]\n60\t    assert set(types.Stop.__annotations__) == set(stop[\"properties\"])\n61\t    assert set(types.Stop.__required_keys__) == set(stop[\"required\"])\n62\t\n63\t\n64\t# Issue #360, finding 4 (verify-01 on #353): the intervention class type mirrors the schema's enum.\n65\t\n66\tdef test_the_intervention_class_type_mirrors_the_schemas_enum() -> None:\n67\t    import typing\n68\t    schema = json.loads((Path(__file__).resolve().parent.parent / \"schema\" / \"attestation.schema.json\").read_text())\n69\t    enum = set(schema[\"properties\"][\"interventions\"][\"items\"][\"properties\"][\"class\"][\"enum\"])\n70\t    found = None\n71\t    for name in dir(types):\n72\t        obj = getattr(types, name)\n73\t        hints = getattr(obj, \"__annotations__\", None)\n74\t        if isinstance(hints, dict) and \"class\" in hints and \"sha\" in hints:\n75\t            found = typing.get_type_hints(obj)[\"class\"]\n76\t    assert found is not None, \"no TypedDict for an intervention in attavo.types\"\n77\t    assert typing.get_origin(found) is typing.Literal and set(typing.get_args(found)) == enum\n78\t"}]},"parent_tool_use_id":null,"session_id":"98798923-8d1f-4f23-9171-7d9c27508aed","uuid":"bb6997ae-ac1c-4e97-b143-5bb56498da1c","timestamp":"2026-10-15T15:12:03.215Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-360/tests/test_types_mirror_schemas.py","content":"\"\"\"Issue #189: attavo/types.py is the mirror of schema/records/*.schema.json\nand schema/attestation.schema.json. The schema stays the contract; each\nrecord TypedDict's keys equal the schema's `properties` and its required\nkeys equal the schema's `required`, so the type cannot drift from it.\n\nRun: python3 -m pytest tests -q\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nfrom pathlib import Path\nfrom typing import Any\n\nimport pytest\n\nfrom attavo import types\n\nROOT = Path(__file__).resolve().parent.parent\nSCHEMA = ROOT / \"schema\"\n\n# The TypedDict for each schema, by the schema's path under schema/.\nRECORD_KINDS = {\n    \"SpecRecord\": \"records/spec.schema.json\",\n    \"ApprovalRecord\": \"records/approval.schema.json\",\n    \"BuildRecord\": \"records/build.schema.json\",\n    \"VerifyRecord\": \"records/verify.schema.json\",\n    \"CounselRecord\": \"records/counsel.schema.json\",\n    \"AttestRecord\": \"attestation.schema.json\",\n    \"DriveReport\": \"drive-report.schema.json\",\n}\n\n# The Stop sub-shape appears in build and verify records, each with its own\n# class enum; the type is one shape and the schemas carry the same three keys.\nSTOP_HOMES = (\"records/build.schema.json\", \"records/verify.schema.json\")\n\n\ndef load(path: str) -> dict[str, Any]:\n    schema: dict[str, Any] = json.loads((SCHEMA / path).read_text())\n    return schema\n\n\n@pytest.mark.parametrize(\"kind\", sorted(RECORD_KINDS))\ndef test_the_typeddict_keys_equal_the_schemas_properties(kind: str) -> None:\n    schema = load(RECORD_KINDS[kind])\n    td = getattr(types, kind)\n    assert set(td.__annotations__) == set(schema[\"properties\"])\n\n\n@pytest.mark.parametrize(\"kind\", sorted(RECORD_KINDS))\ndef test_the_typeddicts_required_keys_equal_the_schemas_required(kind: str) -> None:\n    schema = load(RECORD_KINDS[kind])\n    td = getattr(types, kind)\n    assert set(td.__required_keys__) == set(schema[\"required\"])\n    assert set(td.__optional_keys__) == set(schema[\"properties\"]) - set(schema[\"required\"])\n\n\n@pytest.mark.parametrize(\"path\", STOP_HOMES)\ndef test_the_stop_shape_mirrors_the_stop_in_each_schema_that_carries_one(path: str) -> None:\n    stop = load(path)[\"properties\"][\"stop\"]\n    assert set(types.Stop.__annotations__) == set(stop[\"properties\"])\n    assert set(types.Stop.__required_keys__) == set(stop[\"required\"])\n\n\n# Issue #360, finding 4 (verify-01 on #353): the intervention class type mirrors the schema's enum.\n\ndef test_the_intervention_class_type_mirrors_the_schemas_enum() -> None:\n    import typing\n    schema = json.loads((Path(__file__).resolve().parent.parent / \"schema\" / \"attestation.schema.json\").read_text())\n    enum = set(schema[\"properties\"][\"interventions\"][\"items\"][\"properties\"][\"class\"][\"enum\"])\n    found = None\n    for name in dir(types):\n        obj = getattr(types, name)\n        hints = getattr(obj, \"__annotations__\", None)\n        if isinstance(hints, dict) and \"class\" in hints and \"sha\" in hints:\n            found = typing.get_type_hints(obj)[\"class\"]\n    assert found is not None, \"no TypedDict for an intervention in attavo.types\"\n    assert typing.get_origin(found) is typing.Literal and set(typing.get_args(found)) == enum\n","numLines":78,"startLine":1,"totalLines":78}},"tool_result_meta":[{"id":"toolu_01Y5Dr1oVYruHYeniVGG6g8o","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01X9cwczNxEXPvD1SaCVP6t5","type":"tool_result","content":"commit e7c8d95c091bfffaffe6bce4d90e71d94ed929d8\nAuthor: attavo executor (claude-code) <executor+claude-code@attavo.invalid>\nDate:   Thu Oct 15 09:41:24 2026 -0600\n\n    build for #360: four wave findings (clock-read count, put regression, exit-code order, intervention Literal)\n    \n    Adds the four rejection tests from the wave's stub, one per finding, and\n    the one logic change the stub left red: attavo.types now carries the\n    attestation statement's intervention rows as a TypedDict typed with the\n    schema's class enum (named to sort last among the module's existing\n    \"class\"+\"sha\" TypedDicts, which the mirror test and its criterion script\n    both rely on to find it). The plan-claims clock-count test is reordered\n    so its patch starts after the fixture's own seed write, since the count\n    it asserts is per claims write, not per test.\n    \n    Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>\n\ndiff --git a/attavo/types.py b/attavo/types.py\nindex 24189c9..ddf1e24 100644\n--- a/attavo/types.py\n+++ b/attavo/types.py\n@@ -263,6 +263,17 @@ class ItemTokens(TypedDict):\n     not_read: list[str]\n \n \n+# One row of the statement's `interventions` (issue #349): an amend, launch,\n+# or transport read from the ledger. \"class\" is a Python keyword, hence the\n+# functional form below.\n+StatementIntervention = TypedDict(\"StatementIntervention\", {\n+    \"at\": str,\n+    \"class\": Literal[\"amend\", \"launch\", \"transport\"],\n+    \"by\": str,\n+    \"sha\": str,\n+})\n+\n+\n class AttestRecord(TypedDict):\n     \"\"\"The statement `attavo attest` prints (schema/attestation.schema.json).\"\"\"\n     sha: str\n@@ -277,7 +288,7 @@ class AttestRecord(TypedDict):\n     verify: str | None\n     verify_sha: str | None\n     at: str\n-    interventions: list[dict[str, str]]\n+    interventions: list[StatementIntervention]\n     acts: list[dict[str, str]]\n     time: ItemTime\n     cost: ItemCost\ndiff --git a/tests/test_plan.py b/tests/test_plan.py\nindex 2a8b4fe..ee2db03 100644\n--- a/tests/test_plan.py\n+++ b/tests/test_plan.py\n@@ -292,3 +292,22 @@ def test_a_plan_write_stamps_the_claim_and_the_version_from_one_clock_read(\n     doc = store.get(root, \"plan\")\n     assert doc is not None\n     assert doc[\"body\"][\"claims\"][\"262\"][\"at\"] == doc[\"at\"]\n+\n+\n+# Issue #360, finding 1 (verify-01 on #339): the clock is read exactly once per plan write.\n+\n+def test_a_plan_claims_write_calls_now_iso_exactly_once(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:\n+    from attavo import plan as plan_mod\n+    from attavo import store as store_mod\n+    calls: list[int] = []\n+\n+    def counting() -> str:\n+        calls.append(1)\n+        return \"2026-01-01T00:00:00Z\"\n+\n+    root = tenant_with_plan(tmp_path)\n+    monkeypatch.setattr(plan_mod, \"now_iso\", counting, raising=False)\n+    monkeypatch.setattr(store_mod, \"now_iso\", counting, raising=False)\n+    monkeypatch.chdir(root)\n+    assert plan_mod.cmd_plan([\"claims\", \"#262\", \"attavo/frontier.py\", \"--by\", \"bob\"]) == 0\n+    assert len(calls) == 1, calls\ndiff --git a/tests/test_spec_gate.py b/tests/test_spec_gate.py\nindex d90f045..cecb57e 100644\n--- a/tests/test_spec_gate.py\n+++ b/tests/test_spec_gate.py\n@@ -828,3 +828,18 @@ def test_a_thin_stub_whose_criteria_exit_exactly_1_still_passes(tmp_path: Path)\n     run = run_attavo(root, \"spec-gate\", \"1\")\n     assert run.returncode == 0, run.stdout + run.stderr\n     assert latest_record(root, \"1\", \"spec\")[\"status\"] == \"pass\"\n+\n+\n+# Issue #360, finding 3 (verify-01 on #351): the exit-code contract is judged before kinds.\n+\n+def test_a_structural_criterion_that_exits_2_on_the_stub_is_refused_as_could_not_check(tmp_path: Path) -> None:\n+    \"\"\"A structural criterion that fails on the tree (exit 1) and crashes on\n+    the stub (exit 2) was refused as \"labelled structural fails on the tree\n+    plus stub\"; the exit-code contract is the earlier fact.\"\"\"\n+    root = make_tenant(tmp_path, \"valid\")\n+    set_criteria(root, [\"- [structural] crashes_on_stub.sh: the marker file exists\"],\n+                 {\"crashes_on_stub.sh\": \"test -f src/marker.txt && exit 2; exit 1\"},\n+                 THIN_STUB)\n+    run = run_attavo(root, \"spec-gate\", \"1\")\n+    assert run.returncode == 1, run.stdout + run.stderr\n+    assert latest_record(root, \"1\", \"spec\")[\"refusal\"] == \"criterion could not check (exit 2): crashes_on_stub.sh\"\ndiff --git a/tests/test_store.py b/tests/test_store.py\nindex b378ccc..fd24344 100644\n--- a/tests/test_store.py\n+++ b/tests/test_store.py\n@@ -133,3 +133,17 @@ def test_a_document_name_that_is_not_a_name_is_refused(tmp_path: Path) -> None:\n         with pytest.raises(store.StoreRefusal):\n             store.put(root, bad, {}, 0, \"alice\")\n     assert not os.path.exists(tmp_path / \"x\")\n+\n+\n+# Issue #360, finding 2 (verify-01 on #339): put stamps its own at when the caller passes none.\n+\n+def test_put_stamps_its_own_at_when_the_caller_passes_none(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:\n+    monkeypatch.setattr(store, \"now_iso\", lambda: \"2026-02-02T02:02:02Z\", raising=False)\n+    root = make_tenant(tmp_path, \"valid\")\n+    store.put(root, \"plan\", {\"schema\": \"plan/1\", \"epics\": [], \"edges\": [], \"policy\": {}}, 0, \"alice\")\n+    doc = store.get(root, \"plan\")\n+    assert doc is not None and doc[\"at\"] == \"2026-02-02T02:02:02Z\"\n+    store.put(root, \"plan\", {\"schema\": \"plan/1\", \"epics\": [], \"edges\": [], \"policy\": {}}, 1, \"bob\",\n+              at=\"2026-03-03T03:03:03Z\")\n+    doc = store.get(root, \"plan\")\n+    assert doc is not None and doc[\"at\"] == \"2026-03-03T03:03:03Z\"\ndiff --git a/tests/test_types_mirror_schemas.py b/tests/test_types_mirror_schemas.py\nindex 91d0b70..05b3829 100644\n--- a/tests/test_types_mirror_schemas.py\n+++ b/tests/test_types_mirror_schemas.py\n@@ -59,3 +59,19 @@ def test_the_stop_shape_mirrors_the_stop_in_each_schema_that_carries_one(path: s\n     stop = load(path)[\"properties\"][\"stop\"]\n     assert set(types.Stop.__annotations__) == set(stop[\"properties\"])\n     assert set(types.Stop.__required_keys__) == set(stop[\"required\"])\n+\n+\n+# Issue #360, finding 4 (verify-01 on #353): the intervention class type mirrors the schema's enum.\n+\n+def test_the_intervention_class_type_mirrors_the_schemas_enum() -> None:\n+    import typing\n+    schema = json.loads((Path(__file__).resolve().parent.parent / \"schema\" / \"attestation.schema.json\").read_text())\n+    enum = set(schema[\"properties\"][\"interventions\"][\"items\"][\"properties\"][\"class\"][\"enum\"])\n+    found = None\n+    for name in dir(types):\n+        obj = getattr(types, name)\n+        hints = getattr(obj, \"__annotations__\", None)\n+        if isinstance(hints, dict) and \"class\" in hints and \"sha\" in hints:\n+            found = typing.get_type_hints(obj)[\"class\"]\n+    assert found is not None, \"no TypedDict for an intervention in attavo.types\"\n+    assert typing.get_origin(found) is typing.Literal and set(typing.get_args(found)) == enum","is_error":false}]},"parent_tool_use_id":null,"session_id":"d4c2c58f-1cec-4b3c-a55a-c22b496fe523","uuid":"34b5c432-575a-4dbb-a416-feac1ef2ca4a","timestamp":"2026-10-16T14:43:13.646Z","tool_use_result":{"stdout":"commit e7c8d95c091bfffaffe6bce4d90e71d94ed929d8\nAuthor: attavo executor (claude-code) <executor+claude-code@attavo.invalid>\nDate:   Thu Oct 15 09:41:24 2026 -0600\n\n    build for #360: four wave findings (clock-read count, put regression, exit-code order, intervention Literal)\n    \n    Adds the four rejection tests from the wave's stub, one per finding, and\n    the one logic change the stub left red: attavo.types now carries the\n    attestation statement's intervention 
r\n105\t    product_pin: str | None\n106\t\n107\t\n108\tclass _BuildOptional(TypedDict, total=False):\n109\t    retry_of: str | None\n110\t    steer: str | None\n111\t\n112\t\n113\tclass BuildRecord(_BuildRequired, _BuildOptional):\n114\t    \"\"\"build-NN.json (issue #60): retry_of and steer (R3) are optional --\n115\t    absent on a record written before this release.\"\"\"\n116\t\n117\t\n118\tclass _VerifyRequired(TypedDict):\n119\t    record_version: int\n120\t    item: str\n121\t    sha: str\n122\t    build_sha: str\n123\t    build_record: str | None\n124\t    approval_sha: str | None\n125\t    at: str\n126\t    adapter: str | None\n127\t    adapter_config: dict[str, Any]\n128\t    adapter_version: str | None\n129\t    model: str | None\n130\t    model_version: str | None\n131\t    reports: list[str]\n132\t    forge_checks: dict[str, Any]\n133\t    findings: list[dict[str, Any]] | None\n134\t    tests_named: list[str]\n135\t    commits: list[str]\n136\t    stub_ratio: float | None\n137\t    tokens: dict[str, int]\n138\t    cost_usd: float | None\n139\t    wall_clock_s: float\n140\t    status: str\n141\t    report_class: str | None\n142\t    stop: Stop | None\n143\t    product_version: str\n144\t    product_pin: str | None\n145\t\n146\t\n147\tclass _VerifyOptional(TypedDict, total=False):\n148\t    retry_of: str | None\n149\t    steer: str | None\n150\t\n151\t\n152\tclass VerifyRecord(_VerifyRequired, _VerifyOptional):\n153\t    \"\"\"verify-NN.json (issue #60): retry_of and steer (R3) are optional --\n154\t    absent on a record written before this release.\"\"\"\n155\t\n156\t\n157\tclass CounselCitation(TypedDict):\n158\t    \"\"\"One counsel citation (#328): `resolution` is absent for a repository\n159\t    file at the record's sha.\"\"\"\n160\t    kind: str\n161\t    path: str | None\n162\t    symbol: str | None\n163\t    ruling_id: str | None\n164\t    resolution: NotRequired[Literal[\"input\", \"not_in_repository\", \"not_found_at_sha\"]]\n165\t\n166\t\n16
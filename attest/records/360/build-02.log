 \"\"\"Every record's cost summed: the item's total across stages and\n228\t    executors, with a subtotal per stage and per adapter. A reported\n229\t    cost_usd is taken as it stands; a null one whose model has a tenant\n230\t    rate is priced as tokens times that rate (issue #307), and the basis\n231\t    says which. A record neither reported nor priceable is named in\n232\t    not_read and makes every sum it belongs to partial -- absent is never\n233\t    zero.\"\"\"\n234\t    usd: float\n235\t    reported_usd: float\n236\t    estimated_usd: float\n237\t    by_stage_usd: dict[str, float]\n238\t    basis_by_stage: dict[str, str]\n239\t    by_adapter_usd: dict[str, float]\n240\t    rates: dict[str, CostRate]\n241\t    estimate_note: str\n242\t    partial: bool\n243\t    not_read: list[str]\n244\t\n245\t\n246\tclass StageTokens(TypedDict):\n247\t    \"\"\"One stage's tokens summed over every attempt (the statement's `tokens` block).\"\"\"\n248\t    input: int\n249\t    output: int\n250\t    partial: bool\n251\t\n252\t\n253\tclass ItemTokens(TypedDict):\n254\t    \"\"\"Every record's tokens summed, per stage and for the item. A record\n255\t    that carries no tokens is named in not_read and makes every sum it\n256\t    belongs to partial -- absent is never zero.\"\"\"\n257\t    build: StageTokens\n258\t    verify: StageTokens\n259\t    counsel: StageTokens\n260\t    input: int\n261\t    output: int\n262\t    partial: bool\n263\t    not_read: list[str]\n264\t\n265\t\n266\t# One row of the statement's `interventions` (issue #349): an amend, launch,\n267\t# or transport read from the ledger. \"class\" is a Python keyword, hence the\n268\t# functional form below.\n269\tStatementIntervention = TypedDict(\"StatementIntervention\", {\n270\t    \"at\": str,\n271\t    \"class\": Literal[\"amend\", \"launch\", \"transport\"],\n272\t    \"by\": str,\n273\t    \"sha\": str,\n274\t})\n275\t\n276\t\n277\tclass AttestRecord(TypedDict):\n278\t    \"\"\"The statement `attavo attest` prints (schema/attestation.schema.json).\"\"\"\n279\t    sha: str\n280\t    merge_sha: str\n281\t    item: str\n282\t    spec: str | None\n283\t    spec_sha: str | None\n284\t    approval: str | None\n285\t    approval_sha: str | None\n286\t    build: str | None\n287\t    build_sha: str | None\n288\t    verify: str | None\n289\t    verify_sha: str | None\n290\t    at: str\n291\t    interventions: list[StatementIntervention]\n292\t    acts: list[dict[str, str]]\n293\t    time: ItemTime\n294\t    cost: ItemCost\n295\t    tokens: ItemTokens\n296\t    product_version: str\n297\t    product_pin: str | None\n298\t\n299\t\n300\t# What counsel reads a stop from: a build or verify record, or a refused\n301\t# spec-gate record (issue #133).\n302\tStageRecord = SpecRecord | BuildRecord | VerifyRecord\n303\t\n304\t\n305\tclass DriveReport(TypedDict):\n306\t    \"\"\"What `attavo drive N --report` prints (schema/drive-report.schema.json):\n307\t    the item's level, read from its records, its markers, and the forge.\"\"\"\n308\t    item: str\n309\t    state: str\n310\t    kind: str\n311\t    says: str\n312\t    stage: str | None\n313\t    attempt: int | None\n314\t    record: str | None\n315\t    stop_class: str | None\n316\t    counsel: str | None\n317\t    filed: str | None\n318\t    head: str | None\n319\t    checks: list[dict[str, str]] | None\n320\t    since: str | None\n321\t    last_event_age_s: int | None\n322\t    attempts: list[dict[str, Any]] | None\n323\t    signatures_match: bool | None\n324\t    rulings_available: list[str] | None\n325\t"}]},"parent_tool_use_id":null,"session_id":"6f026162-c8c7-40b5-b80c-3e23b8c3990f","uuid":"b12d94da-2440-45f5-9123-994a72be87f0","timestamp":"2026-10-15T15:42:06.390Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-360/attavo/types.py","content":"\"\"\"The record kinds, typed. Each TypedDict here mirrors one JSON schema: its\nkeys are that schema's `properties` and its required key
\\": 1, \\\"outputTokens\\\": 1}}}\\\\n'\\n\",\nadapters/claude-code/conformance.json:26:      \"structured_output\": {\"status\": \"done\", \"question\": null},\nadapters/claude-code/conformance.json:34:      \"structured_output\": {\"status\": \"done\", \"question\": null},\nadapters/claude-code/conformance.json:41:      \"structured_output\": {\"status\": \"done\", \"question\": null},\nadapters/claude-code/conformance.json:50:    \"question_null\": {\nadapters/claude-code/conformance.json:52:      \"structured_output\": {\"status\": \"question\", \"question\": null},\nadapters/claude-code/conformance.json:56:    \"question_empty\": {\nadapters/claude-code/conformance.json:58:      \"structured_output\": {\"status\": \"question\", \"question\": \"\"},\nadapters/claude-code/conformance.json:62:    \"question_short\": {\nadapters/claude-code/conformance.json:64:      \"structured_output\": {\"status\": \"question\", \"question\": \"placeholder\"},\nadapters/claude-code/conformance.json:68:    \"question_long\": {\nadapters/claude-code/conformance.json:71:        \"status\": \"question\",\nadapters/claude-code/conformance.json:72:        \"question\": \"The criteria do not say which of two conflicting rulings applies here.\"\nadapters/claude-code/conformance.json:79:      \"structured_output\": {\"status\": \"done\", \"question\": null},\nadapters/claude-code/conformance.json:90:    \"counsel_158_forge_evidence\": {\nadapters/claude-code/conformance.json:101:          \"ruling_text\": \"verify-02 read forge-unconcluded because the checks command found no conclusions for 7a2529ee349547a259dbd8b0b78043b39bbf63c2 at that moment, but the checks handed to counsel now show doctor and test both concluded failure on that same sha, and the doctor job's own log names proof 5 no-invocation-lacks-record: item 158 verify-02 started on Davids-MacBook-Pro.local and never wrote its record -- invocation_alive found no live process for the marker commit. Re-running verification will not help: the fix belongs in invocation_alive, not the forge.\",\nadapters/claude-code/conformance.json:103:          \"question\": null,\nadapters/codex/README.md:47:  where `findings`/`tests_named` (verify) or `status`/`question` (build)\n# The statement's own two lists (issue #349): acts is the operator's ruled\n# acts (approve, merge); rule stays in the schema's enum for the ruling\n# record (#276) and is never produced here. interventions is every other\n# operator row -- amend, launch, transport.\nACT_CLASSES = (\"approve\", \"merge\")\nINTERVENTION_CLASSES = (\"amend\", \"launch\", \"transport\")\n\n\ndef _committer_time_iso(root: Path, shas: list[str]) -> dict[str, str]:\n    \"\"\"Each sha's own committer time, in the same shape attest's own `at`\n    fields already carry -- one `git show` process for every sha an\n    item's acts and interventions need, not one git call per row.\"\"\"\n    if not shas:\n        return {}\n    out = git(root, \"show\", \"-s\", \"--format=%H\\x1f%ct\", *shas)\n    times: dict[str, str] = {}\n    for line in out.splitlines():\n        if not line.strip():\n            continue\n        sha, epoch = line.split(\"\\x1f\")\n        times[sha] = datetime.fromtimestamp(int(epoch), timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n    return times\n\n\ndef item_acts_and_interventions(root: Path, m: dict[str, Any], item_id: str,\n                                merges: list[dict[str, Any]] | None = None\n                                ) -> tuple[list[dict[str, Any]], list[dict[str, Any]]]:\n    \"\"\"(acts, interventions): the statement's own two lists, read from\n    item_ledger's own rows between the item's first spec commit and its\n    merge -- each commit classed exactly once there, never classified\n    twice. acts carries every approve and merge row as {act, sha, by, at};\n    interventions carries every amend, launch, and transport row as\n    {class, sha, by, at}. `by` is the commit's own author name\n    (item_ledger's `identity`); `at` is its committer time.\"\"\"\n    rows = item_ledger(root, m, item_id, merges=merges)[\"rows\"]\n    act_rows = [r for r in rows if r[\"class\"] in ACT_CLASSES]\n    intervention_rows = [r for r in rows if r[\"class\"] in INTERVENTION_CLASSES]\n    times = _committer_time_iso(root, [r[\"sha\"] for r in act_rows + intervention_rows])\n    acts = [{\"act\": r[\"class\"], \"sha\": r[\"sha\"], \"by\": r[\"identity\"], \"at\": times[r[\"sha\"]]}\n           for r in act_rows]\n    interventions = [{\"class\": r[\"class\"], \"sha\": r[\"sha\"], \"by\": r[\"identity\"], \"at\": times[r[\"sha\"]]}\n                     for r in intervention_rows]\n    return acts, interventions\n\n\ndef cmd_ledger(argv: list[str]) -> int:\n    as_json = \"--json\" in argv\n    positional = [a for a in argv if a != \"--json\"]\n    root = Path(\".\").resolve()\n    m = read_manifest(root)\n    if m is None:\n        print(f\"attavo ledger: no {MANIFEST} at {root}\", file=sys.stderr)\n        return 2\n\n    records_rel = m[\"paths\"][\"records\"]\n    if positional:\n        item_ids = [positional[0]]\n    else:\n        records_root = root / records_rel\n        item_ids = (sorted((p.name for p in records_root.iterdir() if p.is_dir()))\n                   if records_root.is_dir() else [])\n\n    spec_path = latest_attempt_path(records_dir, \"spec\")\n    approval_path = latest_attempt_path(records_dir, \"approval\")\n    build_path = latest_attempt_path(records_dir, \"build\")\n    verify_path = latest_attempt_path(records_dir, \"verify\")\n\n    # sha and merge_sha are the same commit here -- the one this statement\n    # was computed at. On the merge group that commit is the one main will\n    # hold; kept as two fields because a forge-specific template signs\n    # this statement against \"the commit that lands\", naming it merge_sha\n    # is what makes that unambiguous to a reader who has never seen attest\n    # run anywhere but the merge group.\n    head_sha = git(root, \"rev-parse\", \"HEAD\").strip()\n    try:\n        sealed_at: int | None = int(git(root, \"show\", \"-s\", \"--format=%ct\", \"HEAD\").strip())\n    except (RuntimeError, ValueError):\n        sealed_at = None\n    item_time, item_cost, item_tokens_ = item_accounting(\n        records_dir, sealed_at, (m.get(\"cost\") or {}).get(\"rates\"))\n\n    # Imported here, not at module level: attavo.ledger imports from\n    # attavo.doctor, which imports from this module -- a cycle resolved by\n    # deferring to call time, when every module is already loaded.\n    from attavo.ledger import item_acts_and_interventions\n    acts, interventions = item_acts_and_interventions(root, m, item_id)\n\n    statement: AttestRecord = {\n        \"sha\": head_sha,\n        \"merge_sha\": head_sha,\n        \"item\": item_id,\n        \"spec\": spec_path.stem if spec_path else None,\n        \"spec_sha\": latest_spec.get(\"sha\"),\n        \"approval\": approval_path.stem if approval_path else None,\n        \"approval_sha\": latest_approval.get(\"sha\"),\n        \"build\": build_path.stem if build_path else None,\n        \"build_sha\": latest_build.get(\"sha\"),\n        \"verify\": verify_path.stem if verify_path else None,\n        \"verify_sha\": latest_verify.get(\"sha\"),\n        \"at\": now_iso(),\n        # Read from the item's own commits (issue #349), the same\n        # classification attavo ledger makes -- nothing classified twice.\n        \"interventions\": interventions,\n        \"acts\": acts,\n        # The only accounting: every attempt, summed (the sum across\n        # executors was ruled 2026-09-19). v3's final-attempt fields are\n        # retired (issue #309).\n        \"time\": item_time,\n        \"cost\": item_cost,\n        \"tokens\": item_tokens_,\n        \"product_version\": product_version(),\n        \"product_pin\": (m.get(\"attavo\") or {}).get(\"version\"),\n    }\n    print(json.dumps(statement, indent=2))\n    return 0\n\n\n    partial: bool\n\n
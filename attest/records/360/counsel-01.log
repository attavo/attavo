":\"global\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"98798923-8d1f-4f23-9171-7d9c27508aed\",\"uuid\":\"8ff01df8-cc61-488a-9940-4fb355e3694a\",\"timestamp\":\"2026-10-15T15:17:17.358Z\",\"request_id\":\"req_011Cg4F9Fsv5hy4kj2t49eaA\",\"wire_tool_inputs\":{\"toolu_01Wg6PFJoy12J63xcLKcwvZr\":{\"file_path\":\"/Users/davidbean/Projects/attavo-worktree-360/attavo/types.py\",\"old_string\":\"# \\\"class\\\" is a Python keyword, hence the functional form below.\\nIntervention = TypedDict(\\\"Intervention\\\", {\\n    \\\"at\\\": str,\\n    \\\"class\\\": Literal[\\\"amend\\\", \\\"launch\\\", \\\"transport\\\"],\\n    \\\"by\\\": str,\\n    \\\"sha\\\": str,\\n})\\n\\n\\nclass AttestRecord(TypedDict):\\n    \\\"\\\"\\\"The statement `attavo attest` prints (schema/attestation.schema.json).\\\"\\\"\\\"\\n    sha: str\\n    merge_sha: str\\n    item: str\\n    spec: str | None\\n    spec_sha: str | None\\n    approval: str | None\\n    approval_sha: str | None\\n    build: str | None\\n    build_sha: str | None\\n    verify: str | None\\n    verify_sha: str | None\\n    at: str\\n    interventions: list[Intervention]\",\"new_string\":\"# One row of the statement's `interventions` (issue #349): an amend, launch,\\n# or transport read from the ledger. \\\"class\\\" is a Python keyword, hence the\\n# functional form below.\\nStatementIntervention = TypedDict(\\\"StatementIntervention\\\", {\\n    \\\"at\\\": str,\\n    \\\"class\\\": Literal[\\\"amend\\\", \\\"launch\\\", \\\"transport\\\"],\\n    \\\"by\\\": str,\\n    \\\"sha\\\": str,\\n})\\n\\n\\nclass AttestRecord(TypedDict):\\n    \\\"\\\"\\\"The statement `attavo attest` prints (schema/attestation.schema.json).\\\"\\\"\\\"\\n    sha: str\\n    merge_sha: str\\n    item: str\\n    spec: str | None\\n    spec_sha: str | None\\n    approval: str | None\\n    approval_sha: str | None\\n    build: str | None\\n    build_sha: str | None\\n    verify: str | None\\n    verify_sha: str | None\\n    at: str\\n    interventions: list[StatementIntervention]\"}}}\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp3644wusr/diff.patch:339:+{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01Wg6PFJoy12J63xcLKcwvZr\",\"type\":\"tool_result\",\"content\":\"The file /Users/davidbean/Projects/attavo-worktree-360/attavo/types.py has been updated successfully.\"}]},\"parent_tool_use_id\":null,\"session_id\":\"98798923-8d1f-4f23-9171-7d9c27508aed\",\"uuid\":\"fd515315-2ad5-4d01-a6f0-9eb79e8018e5\",\"timestamp\":\"2026-10-15T15:17:17.366Z\",\"tool_use_result\":{\"filePath\":\"/Users/davidbean/Projects/attavo-worktree-360/attavo/types.py\",\"oldString\":\"# \\\"class\\\" is a Python keyword, hence the functional form below.\\nIntervention = TypedDict(\\\"Intervention\\\", {\\n    \\\"at\\\": str,\\n    \\\"class\\\": Literal[\\\"amend\\\", \\\"launch\\\", \\\"transport\\\"],\\n    \\\"by\\\": str,\\n    \\\"sha\\\": str,\\n})\\n\\n\\nclass AttestRecord(TypedDict):\\n    \\\"\\\"\\\"The statement `attavo attest` prints (schema/attestation.schema.json).\\\"\\\"\\\"\\n    sha: str\\n    merge_sha: str\\n    item: str\\n    spec: str | None\\n    spec_sha: str | None\\n    approval: str | None\\n    approval_sha: str | None\\n    build: str | None\\n    build_sha: str | None\\n    verify: str | None\\n    verify_sha: str | None\\n    at: str\\n    interventions: list[Intervention]\",\"newString\":\"# One row of the statement's `interventions` (issue #349): an amend, launch,\\n# or transport read from the ledger. \\\"class\\\" is a Python keyword, hence the\\n# functional form below.\\nStatementIntervention = TypedDict(\\\"StatementIntervention\\\", {\\n    \\\"at\\\": str,\\n    \\\"class\\\": Literal[\\\"amend\\\", \\\"launch\\\", \\\"transport\\\"],\\n    \\\"by\\\": str,\\n    \\\"sha\\\": str,\\n})\\n\\n\\nclass AttestRecord(TypedDict):\\n    \\\"\\\"\\\"The statement `attavo attest` prints (schema/attestation.schema.json).\\\"\\\"\\\"\\n    sha: str\\n    merge_sha: str\\n    item: str\\n    spec: str | None\\n    spec_sha: str | None\\n    approval: str | None\\n    approval_sha: str | None\\n    build: str | None\\n    build_sha: str | None\\n    verify: str | None\\n    verify_sha: str | None\\n    at: str\\n    interventions: list[StatementIntervention]\",\"originalFile\":\"\\\"\\\"\\\"The record kinds, typed. Each TypedDict here mirrors one JSON schema: its\\nkeys are that schema's `properties` and its required keys are that schema's\\n`required`, and tests/test_types_mirror_schemas.py asserts both, so the type\\ncannot drift from the contract. The schema stays the contract; this is its\\nmirror (issue #189).\\n\\nEvery key each schema lists is required, so no class here is total=False; a\\nkey the schema someday makes optional goes in a total=False base. A value the\\nschema declares as an object with fixed properties but this module does not\\nyet name is a dict[str, Any] (or a list of them), no tighter than the schema's\\nown `additionalProperties` allows for the adapter-owned ones.\\n\\\"\\\"\\\"\\nfrom __future__ import annotations\\n\\nfrom typing import Any, Literal, NotRequired, TypedDict\\n\\n# The stage names a record file's <stage>-NN.json prefix can carry, one per\\n# schema under schema/records/.\\nStage = Literal[\\\"spec\\\", \\\"approval\\\", \\\"build\\\", \\\"verify\\\", \\\"counsel\\\"]\\n\\n# \\\"class\\\" is a Python keyword, so the record kinds that carry it are built\\n# with the functional syntax. signature and bound are R3's own additions,\\n# optional (a record older than record_version 8/7 carries neither).\\n_StopRequired = TypedDict(\\\"_StopRequired\\\", {\\n    \\\"class\\\": str,\\n    \\\"provenance\\\": str,\\n    \\\"detail\\\": str | None,\\n})\\n_StopOptional = TypedDict(\\\"_StopOptional\\\", {\\n    \\\"signature\\\": str | None,\\n    \\\"bound\\\": str | None,\\n}, total=False)\\n\\n\\nclass Stop(_StopRequired, _StopOptional):\\n    \\\"\\\"\\\"build-NN.json's and verify-NN.json's `stop`: the class of a stop and whose\\n    it is. The two schemas enumerate different classes; the shape is the same.\\\"\\\"\\\"\\n\\n\\nclass _SpecOptional(TypedDict, total=False):\\n    # Written from spec/3 on (ruled 2026-09-27); records before it carry neither.\\n    # Each entry of `criteria` carries `kind` (\\\"behavioural\\\" | \\\"structural\\\")\\n    # from spec/4 on; an older entry carries none and was structural.\\n    # \\\"class\\\" is a Python keyword, hence the functional form below.\\n    research: str\\n\\n\\n_SpecClass = TypedDict(\\\"_SpecClass\\\", {\\\"class\\\": str | None}, total=False)\\n\\n\\nclass SpecRecord(_SpecOptional, _SpecClass):\\n    record_version: int\\n    item: str\\n    sha: str\\n    spec_sha: str | None\\n    at: str\\n    status: str\\n    approval_sha: str | None\\n    criteria: list[dict[str, Any]]\\n    refusal: str | None\\n    product_version: str\\n    product_pin: str | None\\n\\n\\nclass ApprovalRecord(TypedDict):\\n    record_version: int\\n    item: str\\n    sha: str\\n    spec_sha: str | None\\n    approved_by: str\\n    at: str\\n    product_version: str\\n    product_pin: str | None\\n\\n\\nclass _BuildRequired(TypedDict):\\n    record_version: int\\n    item: str\\n    sha: str\\n    start_sha: str\\n    spec_sha: str | None\\n    approval_sha: str | None\\n    at: str\\n    adapter: str\\n    adapter_config: dict[str, Any]\\n    executor_identity: dict[str, str]\\n    reports: list[str]\\n    adapter_version: str | None\\n    model: str | None\\n    model_version: str | None\\n    iterations: int\\n    criteria: list[dict[str, Any]]\\n    selected_tests: dict[str, Any] | None\\n    checks: dict[str, Any] | None\\n    tokens: dict[str, int]\\n    cost_usd: float | None\\n    wall_clock_s: float\\n    status: str\\n    refusal: str | None\\n    halted: dict[str, Any] | None\\n    refusal_kind: str | None\\n    report_class: str | None\\n    stop: Stop | None\\n    product_version: str\\n    product_pin: str | None\\n\\n\\nclass _BuildOptional(TypedDict, total=False):\\n    retry_of: str | None\\n    steer: str | None\\n\\n\\nclass BuildRecord(_BuildRequired, _BuildOptional):\\n    \\\"\\\"\\\"build-NN.json (issue #60): retry_of and steer (R3) are optional --\\n    absent on a record written before this release.\\\"\\\"\\\"\\n\\n\\nclass _VerifyRequired(TypedDict):\\n    record_version: int\\n    item: str\\n    sha: str\\n    build_sha: str\\n    build_record: str | None\\n    approval_sha: str | None\\n    at: str\\n    adapter: str | None\\n    adapter_config: dict[str, Any]\\n    adapter_version: str | None\\n    model: str | None\\n    model_version: str | None\\n    reports: list[str]\\n    forge_checks: dict[str, Any]\\n    findings: list[dict[str, Any]] | None\\n    tests_named: list[str]\\n    commits: list[str]\\n    stub_ratio: float | None\\n    tokens: dict[str, int]\\n    cost_usd: float | None\\n    wall_clock_s: float\\n    status: str\\n    report_class: str | None\\n    stop: Stop | None\\n    product_version: str\\n    product_pin: str | None\\n\\n\\nclass _VerifyOptional(TypedDict, total=False):\\n    retry_of: str | None\\n    steer: str | None\\n\\n\\nclass VerifyRecord(_VerifyRequired, _VerifyOptional):\\n    \\\"\\\"\\\"verify-NN.json (issue #60): retry_of and steer (R3) are optional --\\n    absent on a record written before this release.\\\"\\\"\\\"\\n\\n\\nclass CounselCitation(TypedDict):\\n    \\\"\\\"\\\"One counsel citation (#328): `resolution` is absent for a repository\\n    file at the record's sha.\\\"\\\"\\\"\\n    kind: str\\n    path: str | None\\n    symbol: str | None\\n    ruling_id: str | None\\n    resolution: NotRequired[Literal[\\\"input\\\", \\\"not_in_repository\\\", \\\"not_found_at_sha\\\"]]\\n\\n\\nCounselRecord = TypedDict(\\\"CounselRecord\\\", {\\n    \\\"record_version\\\": int,\\n    \\\"item\\\": str,\\n    \\\"sha\\\": str,\\n    \\\"record_stage\\\": str,\\n    \\\"record\\\": str,\\n    \\\"at\\\": str,\\n    \\\"adapter\\\": str | None,\\n    \\\"adapter_config\\\": dict[str, Any],\\n    \\\"adapter_version\\\": str | None,\\n    \\\"model\\\": str | None,\\n    \\\"model_version\\\": str | None,\\n    \\\"reports\\\": list[str],\\n    \\\"tokens\\\": dict[str, int],\\n    \\\"cost_usd\\\": float | None,\\n    \\\"wall_clock_s\\\": float,\\n    \\\"status\\\": str,\\n    \\\"class\\\": str | None,\\n    \\\"verdict\\\": str | None,\\n    \\\"citations\\\": list[CounselCitation],\\n    \\\"proposal\\\": dict[str, Any],\\n    \\\"forge\\\": dict[str, Any],\\n    \\\"question\\\": str | None,\\n    \\\"answers\\\": str | None,\\n    \\\"turn\\\": dict[str, Any] | None,\\n    \\\"product_version\\\": str,\\n    \\\"product_pin\\\": str | None,\\n})\\n\\n\\nclass StageTime(TypedDict):\\n    \\\"\\\"\\\"One stage's invocations summed (the statement's `time` block).\\\"\\\"\\\"\\n    attempts: int\\n    invocation_s: float\\n    partial: bool\\n\\n\\nclass ItemTime(TypedDict):\\n    \\\"\\\"\\\"Every invocation's wall_clock_s, per stage and for the item, beside\\n    the item's lead time -- summed from the records by `attavo attest`, so\\n    a view renders it and never derives it.\\\"\\\"\\\"\\n    build: StageTime\\n    verify: StageTime\\n    counsel: StageTime\\n    invocation_s: float\\n    lead_s: float | None\\n    waiting_s: float | None\\n    partial: bool\\n    not_read: list[str]\\n\\n\\nclass CostRate(TypedDict):\\n    \\\"\\\"\\\"A tenant's published price for one model ([cost.rates.\\\"<model>\\\"]).\\\"\\\"\\\"\\n    input_usd_per_mtok: float\\n    output_usd_per_mtok: float\\n    as_of: str\\n    source: str\\n\\n\\nclass ItemCost(TypedDict):\\n    \\\"\\\"\\\"Every record's cost summed: the item's total across stages and\\n    executors, with a subtotal per stage and per adapter. A reported\\n    cost_usd is taken as it stands; a null one whose model has a tenant\\n    rate is priced as tokens times that rate (issue #307), and the basis\\n    says which. A record neither reported nor priceable is named in\\n    not_read and makes every sum it belongs to partial -- absent is never\\n    zero.\\\"\\\"\\\"\\n    usd: float\\n    reported_usd: float\\n    estimated_usd: float\\n    by_stage_usd: dict[str, float]\\n    basis_by_stage: dict[str, str]\\n    by_adapter_usd: dict[str, float]\\n    rates: dict[str, CostRate]\\n    estimate_note: str\\n    partial: bool\\n    not_read: list[str]\\n\\n\\nclass StageTokens(TypedDict):\\n    \\\"\\\"\\\"One stage's tokens summed over every attempt (the statement's `tokens` block).\\\"\\\"\\\"\\n    input: int\\n    output: int\\n    partial: bool\\n\\n\\nclass ItemTokens(TypedDict):\\n    \\\"\\\"\\\"Every record's tokens summed, per stage and for the item. A record\\n    that carries no tokens is named in not_read and makes every sum it\\n    belongs to partial -- absent is never zero.\\\"\\\"\\\"\\n    build: StageTokens\\n    verify: StageTokens\\n    counsel: StageTokens\\n    input: int\\n    output: int\\n    partial: bool\\n    not_read: list[str]\\n\\n\\n# \\\"class\\\" is a Python keyword, hence the functional form below.\\nIntervention = TypedDict(\\\"Intervention\\\", {\\n    \\\"at\\\": str,\\n    \\\"class\\\": Literal[\\\"amend\\\", \\\"launch\\\", \\\"transport\\\"],\\n    \\\"by\\\": str,\\n    \\\"sha\\\": str,\\n})\\n\\n\\nclass AttestRecord(TypedDict):\\n    \\\"\\\"\\\"The statement `attavo attest` prints (schema/attestation.schema.json).\\\"\\\"\\\"\\n    sha: str\\n    merge_sha: str\\n    item: str\\n    spec: str | None\\n    spec_sha: str | None\\n    approval: str | None\\n    approval_sha: str | None\\n    build: str | None\\n    build_sha: str | None\\n    verify: str | None\\n    verify_sha: str | None\\n    at: str\\n    interventions: list[Intervention]\\n    acts: list[dict[str, str]]\\n    time: ItemTime\\n    cost: ItemCost\\n    tokens: ItemTokens\\n    product_version: str\\n    product_pin: str | None\\n\\n\\n# What counsel reads a stop from: a build or verify record, or a refused\\n# spec-gate record (issue #133).\\nStageRecord = SpecRecord | BuildRecord | VerifyRecord\\n\\n\\nclass DriveReport(TypedDict):\\n    \\\"\\\"\\\"What `attavo drive N --report` prints (schema/drive-report.schema.json):\\n    the item's level, read from its records, its markers, and the forge.\\\"\\\"\\\"\\n    item: str\\n    state: str\\n    kind: str\\n    says: str\\n    stage: str | None\\n    attempt: int | None\\n    record: str | None\\n    stop_class: str | None\\n    counsel: str | None\\n    filed: str | None\\n    head: str | None\\n    checks: list[dict[str, str]] | None\\n    since: str | None\\n    last_event_age_s: int | None\\n    attempts: list[dict[str, Any]] | None\\n    signatures_match: bool | None\\n    rulings_available: list[str] | None\\n\",\"structuredPatch\":[{\"oldStart\":263,\"oldLines\":8,\"newStart\":263,\"newLines\":10,\"lines\":[\"     not_read: list[str]\",\" \",\" \",\"-# \\\"class\\\" is a Python keyword, hence the functional form below.\",\"-Intervention = TypedDict(\\\"Intervention\\\", {\",\"+# One row of the statement's `interventions` (issue #349): an amend, launch,\",\"+# or transport read from the ledger. \\\"class\\\" is a Python keyword, hence the\",\"+# functional form below.\",\"+StatementIntervention = TypedDict(\\\"StatementIntervention\\\", {\",\"     \\\"at\\\": str,\",\"     \\\"class\\\": Literal[\\\"amend\\\", \\\"launch\\\", \\\"transport\\\"],\",\"     \\\"by\\\": str,\"]},{\"oldStart\":286,\"oldLines\":7,\"newStart\":288,\"newLines\":7,\"lines\":[\"     verify: str | None\",\"     verify_sha: str | None\",\"     at: str\",\"-    interventions: list[Intervention]\",\"+    interventions: list[StatementIntervention]\",\"     acts: list[dict[str, str]]\",\"     time: ItemTime\",\"     cost: ItemCost\"]}],\"userModified\":false,\"replaceAll\":false,\"contentNotInModelContext\":true},\"tool_result_meta\":[{\"id\":\"toolu_01Wg6PFJoy12J63xcLKcwvZr\",\"permission_decision\":{\"decision\":\"accept\",\"source\":\"config\",\"reason_type\":\"rule\"}}]}\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp3644wusr/diff.patch:543:+{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01F78rZjsxonGD6Adzq3uyiv\",\"type\":\"tool_result\",\"content\":\"On branch attavo/360-wave-findings\\nYour branch is up to date with 'origin/attavo/360-wave-findings'.\\n\\nChanges not staged for commit:\\n  (use \\\"git add <file>...\\\" to update what will be committed)\\n  (use \\\"git restore <file>...\\\" to discard changes in working directory)\\n\\tmodified:   attavo/types.py\\n\\tmodified:   tests/test_plan.py\\n\\tmodified:   tests/test_spec_gate.py\\n\\tmodified:   tests/test_store.py\\n\\tmodified:   tests/test_types_mirror_schemas.py\\n\\nno changes added to commit (use \\\"git add\\\" and/or \\\"git commit -a\\\")\\ndiff --git a/attavo/types.py b/attavo/types.py\\nindex 24189c9..ddf1e24 100644\\n--- a/attavo/types.py\\n+++ b/attavo/types.py\\n@@ -263,6 +263,17 @@ class ItemTokens(TypedDict):\\n     not_read: list[str]\\n \\n \\n+# One row of the statement's `interventions` (issue #349): an amend, launch,\\n+# or transport read from the ledger. \\\"class\\\" is a Python keyword, hence the\\n+# functional form below.\\n+StatementIntervention = TypedDict(\\\"StatementIntervention\\\", {\\n+    \\\"at\\\": str,\\n+    \\\"class\\\": Literal[\\\"amend\\\", \\\"launch\\\", \\\"transport\\\"],\\n+    \\\"by\\\": str,\\n+    \\\"sha\\\": str,\\n+})\\n+\\n+\\n class AttestRecord(TypedDict):\\n     \\\"\\\"\\\"The statement `attavo attest` prints (schema/attestation.schema.json).\\\"\\\"\\\"\\n     sha: str\\n@@ -277,7 +288,7 @@ class AttestRecord(TypedDict):\\n     verify: str | None\\n     verify_sha: str | None\\n     at: str\\n-    interventions: list[dict[str, str]]\\n+    interventions: list[StatementIntervention]\\n     acts: list[dict[str, str]]\\n     time: ItemTime\\n     cost: ItemCost\\ndiff --git a/tests/test_plan.py b/tests/test_plan.py\\nindex 2a8b4fe..ee2db03 100644\\n--- a/tests/test_plan.py\\n+++ b/tests/test_plan.py\\n@@ -292,3 +292,22 @@ def test_a_plan_write_stamps_the_claim_and_the_version_from_one_clock_read(\\n     doc = store.get(root, \\\"plan\\\")\\n     assert doc is not None\\n     assert doc[\\\"body\\\"][\\\"claims\\\"][\\\"262\\\"][\\\"at\\\"] == doc[\\\"at\\\"]\\n+\\n+\\n+# Issue #360, finding 1 (verify-01 on #339): the clock is read exactly once per plan write.\\n+\\n+def test_a_plan_claims_write_calls_now_iso_exactly_once(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:\\n+    from attavo import plan as plan_mod\\n+    from attavo import store as store_mod\\n+    calls: list[int] = []\\n+\\n+    def counting() -> str:\\n+        calls.append(1)\\n+        return \\\"2026-01-01T00:00:00Z\\\"\\n+\\n+    root = tenant_with_plan(tmp_path)\\n+    monkeypatch.setattr(plan_mod, \\\"now_iso\\\", counting, raising=False)\\n+    monkeypatch.setattr(store_mod, \\\"now_iso\\\", counting, raising=False)\\n+    monkeypatch.chdir(root)\\n+    assert plan_mod.cmd_plan([\\\"claims\\\", \\\"#262\\\", \\\"attavo/frontier.py\\\", \\\"--by\\\", \\\"bob\\\"]) == 0\\n+    assert len(calls) == 1, calls\\ndiff --git a/tests/test_spec_gate.py b/tests/test_spec_gate.py\\nindex d90f045..cecb57e 100644\\n--- a/tests/test_spec_gate.py\\n+++ b/tests/test_spec_gate.py\\n@@ -828,3 +828,18 @@ def test_a_thin_stub_whose_criteria_exit_exactly_1_still_passes(tmp_path: Path)\\n     run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n     assert run.returncode == 0, run.stdout + run.stderr\\n     assert latest_record(root, \\\"1\\\", \\\"spec\\\")[\\\"status\\\"] == \\\"pass\\\"\\n+\\n+\\n+# Issue #360, finding 3 (verify-01 on #351): the exit-code contract is judged before kinds.\\n+\\n+def test_a_structural_criterion_that_exits_2_on_the_stub_is_refused_as_could_not_check(tmp_path: Path) -> None:\\n+    \\\"\\\"\\\"A structural criterion that fails on the tree (exit 1) and crashes on\\n+    the stub (exit 2) was refused as \\\"labelled structural fails on the tree\\n+    plus stub\\\"; the exit-code contract is the earlier fact.\\\"\\\"\\\"\\n+    root = make_tenant(tmp_path, \\\"valid\\\")\\n+    set_criteria(root, [\\\"- [structural] crashes_on_stub.sh: the marker file exists\\\"],\\n+                 {\\\"crashes_on_stub.sh\\\": \\\"test -f src/marker.txt && exit 2; exit 1\\\"},\\n+                 THIN_STUB)\\n+    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n+    assert run.returncode == 1, run.stdout + run.stderr\\n+    assert latest_record(root, \\\"1\\\", \\\"spec\\\")[\\\"refusal\\\"] == \\\"criterion could not check (exit 2): crashes_on_stub.sh\\\"\\ndiff --git a/tests/test_store.py b/tests/test_store.py\\nindex b378ccc..fd24344 100644\\n--- a/tests/test_store.py\\n+++ b/tests/test_store.py\\n@@ -133,3 +133,17 @@ def test_a_document_name_that_is_not_a_name_is_refused(tmp_path: Path) -> None:\\n         with pytest.raises(store.StoreRefusal):\\n             store.put(root, bad, {}, 0, \\\"alice\\\")\\n     assert not os.path.exists(tmp_path / \\\"x\\\")\\n+\\n+\\n+# Issue #360, finding 2 (verify-01 on #339): put stamps its own at when the caller passes none.\\n+\\n+def test_put_stamps_its_own_at_when_the_caller_passes_none(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:\\n+    monkeypatch.setattr(store, \\\"now_iso\\\", lambda: \\\"2026-02-02T02:02:02Z\\\", raising=False)\\n+    root = make_tenant(tmp_path, \\\"valid\\\")\\n+    store.put(root, \\\"plan\\\", {\\\"schema\\\": \\\"plan/1\\\", \\\"epics\\\": [], \\\"edges\\\": [], \\\"policy\\\": {}}, 0, \\\"alice\\\")\\n+    doc = store.get(root, \\\"plan\\\")\\n+    assert doc is not None and doc[\\\"at\\\"] == \\\"2026-02-02T02:02:02Z\\\"\\n+    store.put(root, \\\"plan\\\", {\\\"schema\\\": \\\"plan/1\\\", \\\"epics\\\": [], \\\"edges\\\": [], \\\"policy\\\": {}}, 1, \\\"bob\\\",\\n+              at=\\\"2026-03-03T03:03:03Z\\\")\\n+    doc = store.get(root, \\\"plan\\\")\\n+    assert doc is not None and doc[\\\"at\\\"] == \\\"2026-03-03T03:03:03Z\\\"\\ndiff --git a/tests/test_types_mirror_schemas.py b/tests/test_types_mirror_schemas.py\\nindex 91d0b70..05b3829 100644\\n--- a/tests/test_types_mirror_schemas.py\\n+++ b/tests/test_types_mirror_schemas.py\\n@@ -59,3 +59,19 @@ def test_the_stop_shape_mirrors_the_stop_in_each_schema_that_carries_one(path: s\\n     stop = load(path)[\\\"properties\\\"][\\\"stop\\\"]\\n     assert set(types.Stop.__annotations__) == set(stop[\\\"properties\\\"])\\n     assert set(types.Stop.__required_keys__) == set(stop[\\\"required\\\"])\\n+\\n+\\n+# Issue #360, finding 4 (verify-01 on #353): the intervention class type mirrors the schema's enum.\\n+\\n+def test_the_intervention_class_type_mirrors_the_schemas_enum() -> None:\\n+    import typing\\n+    schema = json.loads((Path(__file__).resolve().parent.parent / \\\"schema\\\" / \\\"attestation.schema.json\\\").read_text())\\n+    enum = set(schema[\\\"properties\\\"][\\\"interventions\\\"][\\\"items\\\"][\\\"properties\\\"][\\\"class\\\"][\\\"enum\\\"])\\n+    found = None\\n+    for name in dir(types):\\n+        obj = getattr(types, name)\\n+        hints = getattr(obj, \\\"__annotations__\\\", None)\\n+        if isinstance(hints, dict) and \\\"class\\\" in hints and \\\"sha\\\" in hints:\\n+            found = typing.get_type_hints(obj)[\\\"class\\\"]\\n+    assert found is not None, \\\"no TypedDict for an intervention in attavo.types\\\"\\n+    assert typing.get_origin(found) is typing.Literal and set(typing.get_args(found)) == enum\",\"is_error\":false}]},\"parent_tool_use_id\":null,\"session_id\":\"98798923-8d1f-4f23-9171-7d9c27508aed\",\"uuid\":\"0eb0b873-0f77-465d-a396-f46c683c767b\",\"timestamp\":\"2026-10-15T15:41:18.102Z\",\"tool_use_result\":{\"stdout\":\"On branch attavo/360-wave-findings\\nYour branch is up to date with 'origin/attavo/360-wave-findings'.\
may name the same path.\"\"\"\nattavo/claims.py:88:            declared = _claims_of_text(_git(root, \"show\", f\"{ref}:{spec_md}\").stdout)\nattavo/claims.py:97:def _claims_of_text(text: str) -> list[str]:\nattavo/claims.py:98:    \"\"\"A spec's Claims from its text, through parse_spec itself so the\nattavo/claims.py:104:    return list((parsed or {}).get(\"claims\") or [])\nattavo/claims.py:107:def collisions(claims: list[str], flights: list[dict[str, Any]], item: str | None) -> list[dict[str, Any]]:\n        \"findings list means you looked and found nothing to report, not \"\n        \"that you did not look.\")\n    return \"\\n\\n\".join(parts)\n\n\ndef counsel_instruction() -> str:\n    \"\"\"Issue #100 (extended by issue #175): a stop is read inside the\n    product first, before a person. The record, its log, the diff, the\n    forge's checks, the item's graph, the tenant manifest, and this\n    product's own root are all handed by path -- named in the instruction\n    instead of inlined, the same discipline verify_instruction already\n    applies to the diff (issue #86), so this instruction's own size stays\n    fixed whatever the record, log, diff, checks, or graph's size.\"\"\"\n    parts = list(spec_sections())\n\n    rulings = read_text(\"ATTAVO_RULINGS\")\n    if rulings.strip():\n        parts.append(\"## Rulings\\n\\n\" + rulings.strip())\n\n    note = stub_note()\n    if note:\n        parts.append(note)\n\n    record_path = os.environ.get(\"ATTAVO_COUNSEL_RECORD\")\n    record_text = read_text(\"ATTAVO_COUNSEL_RECORD\")\n    if record_text.strip():\n        parts.append(\n            \"## The stage record\\n\\n\"\n            f\"The record is at {describe_file(record_path, record_text, diff_like=False)}. \"\n            \"Read it yourself with your own tools.\")\n\n    # Counsel's own earlier readings of this item come first: a follow-up\n    # question about a stop counsel has already read is answered from that\n    # reading. The class an earlier reading states is not re-derived.\n    prior_path = os.environ.get(\"ATTAVO_COUNSEL_PRIOR\")\n    prior_text = read_text(\"ATTAVO_COUNSEL_PRIOR\")\n    if prior_text.strip():\n        parts.append(\n            \"## Counsel's earlier readings of this item\\n\\n\"\n            f\"They are at {describe_file(prior_path, prior_text, diff_like=False)}: a JSON list, \"\n            \"oldest first, each with the record it read, its class, verdict, ruling text, \"\n            \"citations and any question it answered. Read them first. Do not re-derive a \"\n            \"class an earlier reading states; a question about a stop already read is \"\n            \"answered as a follow-up to that reading, citing it.\")\n\n    reads = [line for line in os.environ.get(\"ATTAVO_COUNSEL_READS\", \"\").splitlines() if line.strip()]\n    if reads:\n        parts.append(\n            \"## The tenant's corpus\\n\\n\"\n            \"The tenant names these as what counsel reads before it answers -- method rules, \"\n            \"briefs, rulings. Read them with your own tools before answering:\\n\\n\" +\n            \"\\n\".join(f\"- `{r}`\" for r in reads))\n\n    log_path = os.environ.get(\"ATTAVO_COUNSEL_LOG\")\n    log_text = read_text(\"ATTAVO_COUNSEL_LOG\")\n    if log_text.strip():\n        parts.append(\n            \"## The record's log\\n\\n\"\n            f\"The log is at {describe_file(log_path, log_text, diff_like=False)}. \"\n            \"Read it yourself with your own tools.\")\n\n    events_path = os.environ.get(\"ATTAVO_COUNSEL_EVENTS\")\n    events_text = read_text(\"ATTAVO_COUNSEL_EVENTS\")\n    if events_text.strip():\n        parts.append(\n            \"## The stage's last events\\n\\n\"\n            f\"They are at {describe_file(events_path, events_text, diff_like=False)}: the last \"\n            \"lines of the stage's own event stream (tool calls, messages, test runs, gate \"\n            \"lines), one JSON object per line. This stands in for the whole log; when the \"\n            \"log itself is handed above, read that instead.\")\n\n    diff_path = os.environ.get(\"ATTAVO_COUNSEL_DIFF\")\n    diff_text = read_text(\"ATTAVO_COUNSEL_DIFF\")\n    if diff_text.strip():\n        parts.append(\n            \"## The item's diff since approval\\n\\n\"\n            f\"The diff is at {describe_file(diff_path, diff_text, diff_like=True)}. \"\n            \"Read it yourself with your own tools.\")\n\n    # issue #175: the forge in the evidence set. ATTAVO_COUNSEL_CHECKS is\n    # always written, a JSON {read, reason, checks} envelope -- read false\n    # names the missing manifest key rather than leaving the section out,\n    # since an unread forge must never be mistaken for a green one.\n    checks_path = os.environ.get(\"ATTAVO_COUNSEL_CHECKS\")\n    checks_text = read_text(\"ATTAVO_COUNSEL_CHECKS\")\n    if checks_text.strip():\n        parts.append(\n            \"## The forge's checks on this stop's sha\\n\\n\"\n            f\"The checks are at {describe_file(checks_path, checks_text, diff_like=False)}: \"\n            \"a JSON object -- read: false means the forge was not read at \"\n            \"all (reason names the missing manifest key; treat this as \"\n            \"unknown, never as green) -- read: true carries one entry per \"\n            \"check, each naming, for a check that did not succeed, the \"\n            \"path of its own failed-step log. Read the failing check's \"\n            \"log before answering about the forge; a remedy that depends \"\n            \"on the forge's state cites the check and its log line.\")\n\n    # issue #175: the graph in the evidence set -- the default branch's\n    # own log since this item's branch point, this branch's own commits,\n    # the markers and records present at the stop's sha, and the check\n    # runs on the last three shas, so \"the checks are on the record\n    # commit, not the code commit\" is readable without a terminal.\n    graph_path = os.environ.get(\"ATTAVO_COUNSEL_GRAPH\")\n    graph_text = read_text(\"ATTAVO_COUNSEL_GRAPH\")\n    if graph_text.strip():\n        parts.append(\n            \"## The item's graph\\n\\n\"\n            f\"The graph is at {describe_file(graph_path, graph_text, diff_like=False)}. \"\n            \"Read it yourself with your own tools.\")\n\n    manifest_path = os.environ.get(\"ATTAVO_MANIFEST\", \"\")\n    parts.append(f\"## The tenant manifest\\n\\nThe manifest is at `{manifest_path}`. \"\n                 \"Read it yourself with your own tools.\")\n\n    product_root = os.environ.get(\"ATTAVO_PRODUCT_ROOT\", \"\")\n    parts.append(\n        \"## The product's own root\\n\\n\"\n        f\"The product that ran this stage is at `{product_root}` \"\n        \"(`bin/attavo`, `adapters/`, `schema/`, `templates/`). A stop \"\n        \"whose cause is the product's own mechanism, not the tenant's, \"\n        \"is read here.\")\n\n    # issue #175: attavo counsel N --ask hands the operator's own text as\n    # the question to answer, over the same evidence set, rather than\n    # diagnosing a stop -- the record above is context, not necessarily a\n    # failure.\n    question = os.environ.get(\"ATTAVO_COUNSEL_QUESTION\", \"\")\n    if question.strip():\n        parts.append(\n            \"## The operator's question\\n\\n\" + question.strip() +\n            \"\\n\\nAnswer this question using the evidence above; the \"\n            \"record named above is context, not necessarily a failure.\")\n\n    parts.append(\n        \"you are counseling a stop, read-only: make no edits, write no \"\n        \"files, commit nothing. Read the record, its log, the spec, the \"\n        \"rulings, the diff, the forge's checks, the item's graph, the \"\n        \"tenant manifest, and the product's own root named above with \"\n        \"your own tools, then answer with exactly one class (the stop's \"\n        \"class, or \\\"unclassed\\\"), one verdict -- \\\"answer\\\" (the stop is \"\n        \"answerable inside the rules: a ruling text, in \"\n        \"proposal.ruling_text, with three citations -- instruction, \"\n        \"mechanism, guard, each a path and symbol or a ruling id), \"\n        \"\\\"patch\\\" (the stop is a product defect: the mechanism's file \"\n        \"and symbol, a rejection test, and a unified diff, in \"\n        \"proposal.patch -- or, when the remedy is better filed as an \"\n        \"item than shipped as a diff, a title and a body in this \"\n        \"repository's own issue format -- a Severity/Provenance line, \"\n        \"then Problem, Retires, Change, and Acceptance sections -- in \"\n        \"proposal.issue), or \\\"person\\\" (the answer would touch the \"\n        \"definition of done and no rule covers it: the question restated \"\n        \"in one line, in proposal.question -- or, when the remedy is \"\n        \"better filed as an item than asked as a bare question, a title \"\n        \"and a body in the same issue format, in proposal.issue) -- and \"\n        \"citations for whichever verdict you gave. You propose; you do \"\n        \"not act.\")\n    return \"\\n\\n\".join(parts)\n\n\nBUILD_ALLOWED_TOOLS = [\"Read\", \"Edit\", \"Write\", \"Bash\"]\n\n# Item 229's third attempt: 2,754 s and $6.54 to write the right change and\n# be refused at the gate for one path the spec's Claims did not name. The\n# gate stays the law, but the boundary is told at the edit: the build's\n# Edit and Write are allowed on the claimed paths only, as permission\n# rules built from the spec's own Claims list, so an edit outside them is\n# refused by the tool at the moment it is tried and the executor's recourse\n# is the one it has for anything outside the spec -- a question.\nBUILD_FIXED_TOOLS = [\"Read\", \"Bash\"]\n\n\n\n    state = retry_state(root, m, records_dir, stage, stop_class, attempt)\n    how = f\"as {stop_class}\" if stop_class else f\"({record.get('status')})\"\n    if state.waiting_s is not None:\n        r[\"kind\"] = \"waits\"\n        says = (f\"{_WORD[stage].capitalize()} attempt {attempt:02d} stopped {how}; retrying \"\n                f\"{_WORD[stage]} in {int(state.waiting_s)} s\")\n    elif state.eligible:\n        r[\"kind\"] = \"acts\"\n        says = f\"{_WORD[stage].capitalize()} attempt {attempt:02d} stopped {how}; the next pass retries it\"\n    else:\n        says = f\"Needs you: {_WORD[stage]} attempt {attempt:02d} stopped {how}\"\n    counsel = _counsel_of(records_dir, stem)\n    if counsel:\n        r[\"counsel\"] = counsel[0]\n        verdict = str(counsel[1].get(\"verdict\"))\n        verdict_says = _COUNSEL_SAYS.get(verdict)\n        says += f\"; {counsel[0]} {verdict_says or 'could not read it'}\"\n        if verdict == \"patch\":\n            says += f\"; waiting on {r['filed'] or 'the issue counsel filed'}\"\n    if r[\"filed\"] and \"waiting on\" not in says:\n        says += f\"; filed as {r['filed']}\"\n    r[\"says\"] = says\n    return r\n\n\ndef _invocation(r: DriveReport, reading: InvocationReading, info: dict[str, Any],\n                bound: int | None) -> DriveReport:\n    stage, nn, _log, _last_at, age, cls, crossed = reading\n    r[\"stage\"], r[\"attempt\"], r[\"stop_class\"] = stage, nn, None if cls == \"running\" else cls\n    r[\"since\"] = info.get(\"at\") if isinstance(info.get(\"at\"), str) else None\n    r[\"last_event_age_s\"] = None if age is None else int(age)\n    word = _WORD[stage]\n    if cls == \"running\":\n        r[\"state\"], r[\"kind\"] = \"running\", \"waits\"\n        r[\"says\"] = (f\"{word.capitalize()} running since {r['since'] or 'an unknown time'}; \"\n                     f\"nothing to do until it finishes\")\n    else:\n        r[\"state\"], r[\"kind\"] = \"owes-recovery\", \"acts\"\n        if cls == \"hung\" and crossed == \"ceiling\":\n            # R3: a stage past its own ceiling is hung by wall clock\nattavo/doctor.py:310:    plain retry, a returned retry, and a steered one alike -- before the\nattavo/drive.py:772:                   \"retry_of\": None, \"steer\": None,\nattavo/drive.py:830:# an \"answer\" verdict starts the next attempt steered by it, the same as\nattavo/drive.py:862:    a plain pass nor `--again`'s own no-op read of the same fact; steer\nattavo/drive.py:868:    steer: str | None\nattavo/drive.py:900:    if counsel is not None and counsel.get(\"verdict\") == \"answer\":\nattavo/verify.py:177:    \"\"\"(retry_of, steer): a plain retry of verify itself -- died, hung,\nattavo/verify.py:193:    steer = None\nattavo/verify.py:194:    if counsel is not None and counsel.get(\"verdict\") == \"answer\":\nattavo/verify.py:198:            steer = f\"counsel-{max(matches):02d}\"\nattavo/verify.py:199:    return prior_stem, steer\nattavo/verify.py:307:            \"retry_of\": None, \"steer\": None,\nattavo/verify.py:404:    retry_of, steer = _verify_retry_seed(item_records_dir, build_sha)\nattavo/verify.py:446:        \"steer\": steer,\nattavo/types.py:110:    steer: str | None\nattavo/types.py:114:    \"\"\"build-NN.json (issue #60): retry_of and steer (R3) are optional --\nattavo/types.py:149:    steer: str | None\nattavo/types.py:153:    \"\"\"verify-NN.json (issue #60): retry_of and steer (R3) are optional --\nattavo/counsel.py:254:    only way a question becomes a record and so the only way it steers.\"\"\"\nattavo/counsel.py:266:    # otherwise steer build-03 with an answer about build-01.\nattavo/counsel.py:296:        \"verdict\": answer.get(\"verdict\"),\nattavo/counsel.py:298:        \"proposal\": {\"ruling_text\": None, \"patch\": None, \"question\": None, \"issue\": None,\nattavo/counsel.py:495:              \"ruling_text\": (rec.get(\"proposal\") or {}).get(\"ruling_text\"),\nattavo/counsel.py:509:                          \"ruling_text\": (a.get(\"proposal\") or {}).get(\"ruling_text\"),\nattavo/counsel.py:593:    proposal = {\"ruling_text\": None, \"patch\": None, \"question\": None, \"issue\": None}\nattavo/counsel.py:596:            and payload.get(\"verdict\") in (\"answer\", \"patch\", \"person\")):\nattavo/counsel.py:711:verdict (answer: a ruling text with citations; patch: a product\nattavo/counsel.py:714:each a path and symbol or a ruling id), and proposal (the ruling text,\nattavo/counsel.py:737:question steers nothing. The events tail is read where the product keeps\nattavo/counsel.py:750:the only way one steers the next attempt.\"\"\"),\nattavo/stops.py:28:# #317 a fifth, test-bypass, retried with the steer \"run tests only with\nattavo/build.py:242:    \"\"\"(retry_of, steer, feedback): what a retried build's first iteration\nattavo/build.py:246:    own blocking findings); and the newest steer newer than the blocking\nattavo/build.py:299:    steer_stem: str | None = None\nattavo/build.py:307:            if counsel.get(\"verdict\") == \"answer\":\nattavo/build.py:308:                steer_stem = f\"counsel-{nn:02d}\"\nattavo/build.py:309:                answer = (counsel.get(\"proposal\") or {}).get(\"ruling_text\")\nattavo/build.py:311:                    lines += [f\"steer from {steer_stem}:\", answer.strip(), \"\"]\nattavo/build.py:313:    return prior_stem, steer_stem, \"\\n\".join(lines) + \"\\n\"\nattavo/build.py:464:                \"steer\": None,\nattavo/build.py:497:        # steer newer than the blocking record -- the one file the\nattavo/build.py:499:        retry_of, steer, seed = _retry_seed(root, m, item_records_dir)\nattavo/build.py:589:            # way returns the build, by name; the retry is steered to the tool.\nattavo/build.py:761:        \"steer\": steer,\nattavo/build.py:845:executor, naming the call, and its retry is steered to the tool (#317); a\n","exit_code":0,"status":"completed"}}

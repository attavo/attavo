 annotations\\n14\\t\\n15\\tfrom typing import Any, Literal, NotRequired, TypedDict\\n16\\t\\n17\\t# The stage names a record file's <stage>-NN.json prefix can carry, one per\\n18\\t# schema under schema/records/.\\n19\\tStage = Literal[\\\"spec\\\", \\\"approval\\\", \\\"build\\\", \\\"verify\\\", \\\"counsel\\\"]\\n20\\t\\n21\\t# \\\"class\\\" is a Python keyword, so the record kinds that carry it are built\\n22\\t# with the functional syntax. signature and bound are R3's own additions,\\n23\\t# optional (a record older than record_version 8/7 carries neither).\\n24\\t_StopRequired = TypedDict(\\\"_StopRequired\\\", {\\n25\\t    \\\"class\\\": str,\\n26\\t    \\\"provenance\\\": str,\\n27\\t    \\\"detail\\\": str | None,\\n28\\t})\\n29\\t_StopOptional = TypedDict(\\\"_StopOptional\\\", {\\n30\\t    \\\"signature\\\": str | None,\\n31\\t    \\\"bound\\\": str | None,\\n32\\t}, total=False)\\n33\\t\\n34\\t\\n35\\tclass Stop(_StopRequired, _StopOptional):\\n36\\t    \\\"\\\"\\\"build-NN.json's and verify-NN.json's `stop`: the class of a stop and whose\\n37\\t    it is. The two schemas enumerate different classes; the shape is the same.\\\"\\\"\\\"\\n38\\t\\n39\\t\\n40\\tclass _SpecOptional(TypedDict, total=False):\\n41\\t    # Written from spec/3 on (ruled 2026-09-27); records before it carry neither.\\n42\\t    # Each entry of `criteria` carries `kind` (\\\"behavioural\\\" | \\\"structural\\\")\\n43\\t    # from spec/4 on; an older entry carries none and was structural.\\n44\\t    # \\\"class\\\" is a Python keyword, hence the functional form below.\\n45\\t    research: str\\n46\\t\\n47\\t\\n48\\t_SpecClass = TypedDict(\\\"_SpecClass\\\", {\\\"class\\\": str | None}, total=False)\\n49\\t\\n50\\t\\n51\\tclass SpecRecord(_SpecOptional, _SpecClass):\\n52\\t    record_version: int\\n53\\t    item: str\\n54\\t    sha: str\\n55\\t    spec_sha: str | None\\n56\\t    at: str\\n57\\t    status: str\\n58\\t    approval_sha: str | None\\n59\\t    criteria: list[dict[str, Any]]\\n60\\t    refusal: str | None\\n61\\t    product_version: str\\n62\\t    product_pin: str | None\\n63\\t\\n64\\t\\n65\\tclass ApprovalRecord(TypedDict):\\n66\\t    record_version: int\\n67\\t    item: str\\n68\\t    sha: str\\n69\\t    spec_sha: str | None\\n70\\t    approved_by: str\\n71\\t    at: str\\n72\\t    product_version: str\\n73\\t    product_pin: str | None\\n74\\t\\n75\\t\\n76\\tclass _BuildRequired(TypedDict):\\n77\\t    record_version: int\\n78\\t    item: str\\n79\\t    sha: str\\n80\\t    start_sha: str\\n81\\t    spec_sha: str | None\\n82\\t    approval_sha: str | None\\n83\\t    at: str\\n84\\t    adapter: str\\n85\\t    adapter_config: dict[str, Any]\\n86\\t    executor_identity: dict[str, str]\\n87\\t    reports: list[str]\\n88\\t    adapter_version: str | None\\n89\\t    model: str | None\\n90\\t    model_version: str | None\\n91\\t    iterations: int\\n92\\t    criteria: list[dict[str, Any]]\\n93\\t    selected_tests: dict[str, Any] | None\\n94\\t    checks: dict[str, Any] | None\\n95\\t    tokens: dict[str, int]\\n96\\t    cost_usd: float | None\\n97\\t    wall_clock_s: float\\n98\\t    status: str\\n99\\t    refusal: str | None\\n100\\t    halted: dict[str, Any] | None\\n101\\t    refusal_kind: str | None\\n102\\t    report_class: str | None\\n103\\t    stop: Stop | None\\n104\\t    product_version: str\\n105\\t    product_pin: str | None\\n106\\t\\n107\\t\\n108\\tclass _BuildOptional(TypedDict, total=False):\\n109\\t    retry_of: str | None\\n110\\t    steer: str | None\\n111\\t\\n112\\t\\n113\\tclass BuildRecord(_BuildRequired, _BuildOptional):\\n114\\t    \\\"\\\"\\\"build-NN.json (issue #60): retry_of and steer (R3) are optional --\\n115\\t    absent on a record written before this release.\\\"\\\"\\\"\\n116\\t\\n117\\t\\n118\\tclass _VerifyRequired(TypedDict):\\n119\\t    record_version: int\\n120\\t    item: str\\n121\\t    sha: str\\n122\\t    build_sha: str\\n123\\t    build_record: str | None\\n124\\t    approval_sha: str | None\\n125\\t    at: str\\n126\\t    adapter: str | None\\n127\\t    adapter_config: dict[str, Any]\\n128\\t    adapter_version: str | None\\n129\\t    model: str | None\\n130\\t    model_version: str | None\\n131\\t    reports: list[str]\\n132\\t    forge_checks: dict[str, Any]\\n133\\t    findings: list[dict[str, Any]] | None\\n134\\t    tests_named: list[str]\\n135\\t    commits: list[str]\\n136\\t    stub_ratio: float | None\\n137\\t    tokens: dict[str, int]\\n138\\t    cost_usd: float | None\\n139\\t    wall_clock_s: float\\n140\\t    status: str\\n141\\t    report_class: str | None\\n142\\t    stop: Stop | None\\n143\\t    product_version: str\\n144\\t    product_pin: str | None\\n145\\t\\n146\\t\\n147\\tclass _VerifyOptional(TypedDict, total=False):\\n148\\t    retry_of: str | None\\n149\\t    steer: str | None\\n150\\t\\n151\\t\\n152\\tclass VerifyRecord(_VerifyRequired, _VerifyOptional):\\n153\\t    \\\"\\\"\\\"verify-NN.json (issue #60): retry_of and steer (R3) are optional --\\n154\\t    absent on a record written before this release.\\\"\\\"\\\"\\n155\\t\\n156\\t\\n157\\tclass CounselCitation(TypedDict):\\n158\\t    \\\"\\\"\\\"One counsel citation (#328): `resolution` is absent for a repository\\n159\\t    file at the record's sha.\\\"\\\"\\\"\\n160\\t    kind: str\\n161\\t    path: str | None\\n162\\t    symbol: str | None\\n163\\t    ruling_id: str | None\\n164\\t    resolution: NotRequired[Literal[\\\"input\\\", \\\"not_in_repository\\\", \\\"not_found_at_sha\\\"]]\\n165\\t\\n166\\t\\n167\\tCounselRecord = TypedDict(\\\"CounselRecord\\\", {\\n168\\t    \\\"record_version\\\": int,\\n169\\t    \\\"item\\\": str,\\n170\\t    \\\"sha\\\": str,\\n171\\t    \\\"record_stage\\\": str,\\n172\\t    \\\"record\\\": str,\\n173\\t    \\\"at\\\": str,\\n174\\t    \\\"adapter\\\": str | None,\\n175\\t    \\\"adapter_config\\\": dict[str, Any],\\n176\\t    \\\"adapter_version\\\": str | None,\\n177\\t    \\\"model\\\": str | None,\\n178\\t    \\\"model_version\\\": str | None,\\n179\\t    \\\"reports\\\": list[str],\\n180\\t    \\\"tokens\\\": dict[str, int],\\n181\\t    \\\"cost_usd\\\": float | None,\\n182\\t    \\\"wall_clock_s\\\": float,\\n183\\t    \\\"status\\\": str,\\n184\\t    \\\"class\\\": str | None,\\n185\\t    \\\"verdict\\\": str | None,\\n186\\t    \\\"citations\\\": list[CounselCitation],\\n187\\t    \\\"proposal\\\": dict[str, Any],\\n188\\t    \\\"forge\\\": dict[str, Any],\\n189\\t    \\\"question\\\": str | None,\\n190\\t    \\\"answers\\\": str | None,\\n191\\t    \\\"turn\\\": dict[str, Any] | None,\\n192\\t    \\\"product_version\\\": str,\\n193\\t    \\\"product_pin\\\": str | None,\\n194\\t})\\n195\\t\\n196\\t\\n197\\tclass StageTime(TypedDict):\\n198\\t    \\\"\\\"\\\"One stage's invocations summed (the statement's `time` block).\\\"\\\"\\\"\\n199\\t    attempts: int\\n200\\t    invocation_s: float\\n201\\t    partial: bool\\n202\\t\\n203\\t\\n204\\tclass ItemTime(TypedDict):\\n205\\t    \\\"\\\"\\\"Every invocation's wall_clock_s, per stage and for the item, beside\\n206\\t    the item's lead time -- summed from the records by `attavo attest`, so\\n207\\t    a view renders it and never derives it.\\\"\\\"\\\"\\n208\\t    build: StageTime\\n209\\t    verify: StageTime\\n210\\t    counsel: StageTime\\n211\\t    invocation_s: float\\n212\\t    lead_s: float | None\\n213\\t    waiting_s: float | None\\n214\\t    partial: bool\\n215\\t    not_read: list[str]\\n216\\t\\n217\\t\\n218\\tclass CostRate(TypedDict):\\n219\\t    \\\"\\\"\\\"A tenant's published price for one model ([cost.rates.\\\"<model>\\\"]).\\\"\\\"\\\"\\n220\\t    input_usd_per_mtok: float\\n221\\t    output_usd_per_mtok: float\\n222\\t    as_of: str\\n223\\t    source: str\\n224\\t\\n225\\t\\n226\\tclass ItemCost(TypedDict):\\n227\\t    \\\"\\\"\\\"Every record's cost summed: the item's total across stages and\\n228\\t    executors, with a subtotal per stage and per adapter. A reported\\n229\\t    cost_usd is taken as it stands; a null one whose model has a tenant\\n230\\t    rate is priced as tokens times that rate (issue #307), and the basis\\n231\\t    says which. A record neither reported nor priceable is named in\\n232\\t    not_read and makes every sum it belongs to partial -- absent is never\\n233\\t    zero.\\\"\\\"\\\"\\n234\\t    usd: float\\n235\\t    reported_usd: float\\n236\\t    estimated_usd: float\\n237\\t    by_stage_usd: dict[str, float]\\n238\\t    basis_by_stage: dict[str, str]\\n239\\t    by_adapter_usd: dict[str, float]\\n240\\t    rates: dict[str, CostRate]\\n241\\t    estimate_note: str\\n242\\t    partial: bool\\n243\\t    not_read: list[str]\\n244\\t\\n245\\t\\n246\\tclass StageTokens(TypedDict):\\n247\\t    \\\"\\\"\\\"One stage's tokens summed over every attempt (the statement's `tokens` block).\\\"\\\"\\\"\\n248\\t    input: int\\n249\\t    output: int\\n250\\t    partial: bool\\n251\\t\\n252\\t\\n253\\tclass ItemTokens(TypedDict):\\n254\\t    \\\"\\\"\\\"Every record's tokens summed, per stage and for the item. A record\\n255\\t    that carries no tokens is named in not_read and makes every sum it\\n256\\t    belongs to partial -- absent is never zero.\\\"\\\"\\\"\\n257\\t    build: StageTokens\\n258\\t    verify: StageTokens\\n259\\t    counsel: StageTokens\\n260\\t    input: int\\n261\\t    output: int\\n262\\t    partial: bool\\n263\\t    not_read: list[str]\\n264\\t\\n265\\t\\n266\\t# One row of the statement's `interventions` (issue #349): an amend, launch,\\n267\\t# or transport read from the ledger. \\\"class\\\" is a Python keyword, hence the\\n268\\t# functional form below.\\n269\\tStatementIntervention = TypedDict(\\\"StatementIntervention\\\", {\\n270\\t    \\\"at\\\": str,\\n271\\t    \\\"class\\\": Literal[\\\"amend\\\", \\\"launch\\\", \\\"transport\\\"],\\n272\\t    \\\"by\\\": str,\\n273\\t    \\\"sha\\\": str,\\n274\\t})\\n275\\t\\n276\\t\\n277\\tclass AttestRecord(TypedDict):\\n278\\t    \\\"\\\"\\\"The statement `attavo attest` prints (schema/attestation.schema.json).\\\"\\\"\\\"\\n279\\t    sha: str\\n280\\t    merge_sha: str\\n281\\t    item: str\\n282\\t    spec: str | None\\n283\\t    spec_sha: str | None\\n284\\t    approval: str | None\\n285\\t    approval_sha: str | None\\n286\\t    build: str | None\\n287\\t    build_sha: str | None\\n288\\t    verify: str | None\\n289\\t    verify_sha: str | None\\n290\\t    at: str\\n291\\t    interventions: list[StatementIntervention]\\n292\\t    acts: list[dict[str, str]]\\n293\\t    time: ItemTime\\n294\\t    cost: ItemCost\\n295\\t    tokens: ItemTokens\\n296\\t    product_version: str\\n297\\t    product_pin: str | None\\n298\\t\\n299\\t\\n300\\t# What counsel reads a stop from: a build or verify record, or a refused\\n301\\t# spec-gate record (issue #133).\\n302\\tStageRecord = SpecRecord | BuildRecord | VerifyRecord\\n303\\t\\n304\\t\\n305\\tclass DriveReport(TypedDict):\\n306\\t    \\\"\\\"\\\"What `attavo drive N --report` prints (schema/drive-report.schema.json):\\n307\\t    the item's level, read from its records, its markers, and the forge.\\\"\\\"\\\"\\n308\\t    item: str\\n309\\t    state: str\\n310\\t    kind: str\\n311\\t    says: str\\n312\\t    stage: str | None\\n313\\t    attempt: int | None\\n314\\t    record: str | None\\n315\\t    stop_class: str | None\\n316\\t    counsel: str | None\\n317\\t    filed: str | None\\n318\\t    head: str | None\\n319\\t    checks: list[dict[str, str]] | None\\n320\\t    since: str | None\\n321\\t    last_event_age_s: int | None\\n322\\t    attempts: list[dict[str, Any]] | None\\n323\\t    signatures_match: bool | None\\n324\\t    rulings_available: list[str] | None\\n325\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"2fdf7451-69ca-4099-9892-05c092db1ff4\",\"uuid\":\"337dc8f1-d023-49a2-88eb-16d2128ee23d\",\"timestamp\":\"2026-10-15T15:47:15.978Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/davidbean/Projects/attavo-worktree-360/attavo/types.py\",\"content\":\"\\\"\\\"\\\"The record kinds, typed. Each TypedDict here mirrors one JSON schema: its\\nkeys are that schema's `properties` and its required keys are that schema's\\n`required`, and tests/test_types_mirror_schemas.py asserts both, so the type\\ncannot drift from the contract. The schema stays the contract; this is its\\nmirror (issue #189).\\n\\nEvery key each schema lists is required, so no class here is total=False; a\\nkey the schema someday makes optional goes in a total=False base. A value the\\nschema declares as an object with fixed properties but this module does not\\nyet name is a dict[str, Any] (or a list of them), no tighter than the schema's\\nown `additionalProperties` allows for the adapter-owned ones.\\n\\\"\\\"\\\"\\nfrom __future__ import annotations\\n\\nfrom typing import Any, Literal, NotRequired, TypedDict\\n\\n# The stage names a record file's <stage>-NN.json prefix can carry, one per\\n# schema under schema/records/.\\nStage = Literal[\\\"spec\\\", \\\"approval\\\", \\\"build\\\", \\\"verify\\\", \\\"counsel\\\"]\\n\\n# \\\"class\\\" is a Python keyword, so the record kinds that carry it are built\\n# with the functional syntax. signature and bound are R3's own additions,\\n# optional (a record older than record_version 8/7 carries neither).\\n_StopRequired = TypedDict(\\\"_StopRequired\\\", {\\n    \\\"class\\\": str,\\n    \\\"provenance\\\": str,\\n    \\\"detail\\\": str | None,\\n})\\n_StopOptional = TypedDict(\\\"_StopOptional\\\", {\\n    \\\"signature\\\": str | None,\\n    \\\"bound\\\": str | None,\\n}, total=False)\\n\\n\\nclass Stop(_StopRequired, _StopOptional):\\n    \\\"\\\"\\\"build-NN.json's and verify-NN.json's `stop`: the class of a stop and whose\\n    it is. The two schemas enumerate different classes; the shape is the same.\\\"\\\"\\\"\\n\\n\\nclass _SpecOptional(TypedDict, total=False):\\n    # Written from spec/3 on (ruled 2026-09-27); records before it carry neither.\\n    # Each entry of `criteria` carries `kind` (\\\"behavioural\\\" | \\\"structural\\\")\\n    # from spec/4 on; an older entry carries none and was structural.\\n    # \\\"class\\\" is a Python keyword, hence the functional form below.\\n    research: str\\n\\n\\n_SpecClass = TypedDict(\\\"_SpecClass\\\", {\\\"class\\\": str | None}, total=False)\\n\\n\\nclass SpecRecord(_SpecOptional, _SpecClass):\\n    record_version: int\\n    item: str\\n    sha: str\\n    spec_sha: str | None\\n    at: str\\n    status: str\\n    approval_sha: str | None\\n    criteria: list[dict[str, Any]]\\n    refusal: str | None\\n    product_version: str\\n    product_pin: str | None\\n\\n\\nclass ApprovalRecord(TypedDict):\\n    record_version: int\\n    item: str\\n    sha: str\\n    spec_sha: str | None\\n    approved_by: str\\n    at: str\\n    product_version: str\\n    product_pin: str | None\\n\\n\\nclass _BuildRequired(TypedDict):\\n    record_version: int\\n    item: str\\n    sha: str\\n    start_sha: str\\n    spec_sha: str | None\\n    approval_sha: str | None\\n    at: str\\n    adapter: str\\n    adapter_config: dict[str, Any]\\n    executor_identity: dict[str, str]\\n    reports: list[str]\\n    adapter_version: str | None\\n    model: str | None\\n    model_version: str | None\\n    iterations: int\\n    criteria: list[dict[str, Any]]\\n    selected_tests: dict[str, Any] | None\\n    checks: dict[str, Any] | None\\n    tokens: dict[str, int]\\n    cost_usd: float | None\\n    wall_clock_s: float\\n    status: str\\n    refusal: str | None\\n    halted: dict[str, Any] | None\\n    refusal_kind: str | None\\n    report_class: str | None\\n    stop: Stop | None\\n    product_version: str\\n    product_pin: str | None\\n\\n\\nclass _BuildOptional(TypedDict, total=False):\\n    retry_of: str | None\\n    steer: str | None\\n\\n\\nclass BuildRecord(_BuildRequired, _BuildOptional):\\n    \\\"\\\"\\\"build-NN.json (issue #60): retry_of and steer (R3) are optional --\\n    absent on a record written before this release.\\\"\\\"\\\"\\n\\n\\nclass _VerifyRequired(TypedDict):\\n    record_version: int\\n    item: str\\n    sha: str\\n    build_sha: str\\n    build_record: str | None\\n    approval_sha: str | None\\n    at: str\\n    adapter: str | None\\n    adapter_config: dict[str, Any]\\n    adapter_version: str | None\\n    model: str | None\\n    model_version: str | None\\n    reports: list[str]\\n    forge_checks: dict[str, Any]\\n    findings: list[dict[str, Any]] | None\\n    tests_named: list[str]\\n    commits: list[str]\\n    stub_ratio: float | None\\n    tokens: dict[str, int]\\n    cost_usd: float | None\\n    wall_clock_s: float\\n    status: str\\n    report_class: str | None\\n    stop: Stop | None\\n    product_version: str\\n    product_pin: str | None\\n\\n\\nclass _VerifyOptional(TypedDict, total=False):\\n    retry_of: str | None\\n    steer: str | None\\n\\n\\nclass VerifyRecord(_VerifyRequired, _VerifyOptional):\\n    \\\"\\\"\\\"verify-NN.json (issue #60): retry_of and steer (R3) are optional --\\n    absent on a record written before this release.\\\"\\\"\\\"\\n\\n\\nclass CounselCitation(TypedDict):\\n    \\\"\\\"\\\"One counsel citation (#328): `resolution` is absent for a repository\\n    file at the record's sha.\\\"\\\"\\\"\\n    kind: str\\n    path: str | None\\n    symbol: str | None\\n    ruling_id: str | None\\n    resolution: NotRequired[Literal[\\\"input\\\", \\\"not_in_repository\\\", \\\"not_found_at_sha\\\"]]\\n\\n\\nCounselRecord = TypedDict(\\\"CounselRecord\\\", {\\n    \\\"record_version\\\": int,\\n    \\\"item\\\": str,\\n    \\\"sha\\\": str,\\n    \\\"record_stage\\\": str,\\n    \\\"record\\\": str,\\n    \\\"at\\\": str,\\n    \\\"adapter\\\": str | None,\\n    \\\"adapter_config\\\": dict[str, Any],\\n    \\\"adapter_version\\\": str | None,\\n    \\\"model\\\": str | None,\\n    \\\"model_version\\\": str | None,\\n    \\\"reports\\\": list[str],\\n    \\\"tokens\\\": dict[str, int],\\n    \\\"cost_usd\\\": float | None,\\n    \\\"wall_clock_s\\\": float,\\n    \\\"status\\\": str,\\n    \\\"class\\\": str | None,\\n    \\\"verdict\\\": str | None,\\n    \\\"citations\\\": list[CounselCitation],\\n    \\\"proposal\\\": dict[str, Any],\\n    \\\"forge\\\": dict[str, Any],\\n    \\\"question\\\": str | None,\\n    \\\"answers\\\": str | None,\\n    \\\"turn\\\": dict[str, Any] | None,\\n    \\\"product_version\\\": str,\\n    \\\"product_pin\\\": str | None,\\n})\\n\\n\\nclass StageTime(TypedDict):\\n    \\\"\\\"\\\"One stage's invocations summed (the statement's `time` block).\\\"\\\"\\\"\\n    attempts: int\\n    invocation_s: float\\n    partial: bool\\n\\n\\nclass ItemTime(TypedDict):\\n    \\\"\\\"\\\"Every invocation's wall_clock_s, per stage and for the item, beside\\n    the item's lead time -- summed from the records by `attavo attest`, so\\n    a view renders it and never derives it.\\\"\\\"\\\"\\n    build: StageTime\\n    verify: StageTime\\n    counsel: StageTime\\n    invocation_s: float\\n    lead_s: float | None\\n    waiting_s: float | None\\n    partial: bool\\n    not_read: list[str]\\n\\n\\nclass CostRate(TypedDict):\\n    \\\"\\\"\\\"A tenant's published price for one model ([cost.rates.\\\"<model>\\\"]).\\\"\\\"\\\"\\n    input_usd_per_mtok: float\\n    output_usd_per_mtok: float\\n    as_of: str\\n    source: str\\n\\n\\nclass ItemCost(TypedDict):\\n    \\\"\\\"\\\"Every record's cost summed: the item's total across stages and\\n    executors, with a subtotal per stage and per adapter. A reported\\n    cost_usd is taken as it stands; a null one whose model has a tenant\\n    rate is priced as tokens times that rate (issue #307), and the basis\\n    says which. A record neither reported nor priceable is named in\\n    not_read and makes every sum it belongs to partial -- absent is never\\n    zero.\\\"\\\"\\\"\\n    usd: float\\n    reported_usd: float\\n    estimated_usd: float\\n    by_stage_usd: dict[str, float]\\n    basis_by_stage: dict[str, str]\\n    by_adapter_usd: dict[str, float]\\n    rates: dict[str, CostRate]\\n    estimate_note: str\\n    partial: bool\\n    not_read: list[str]\\n\\n\\nclass StageTokens(TypedDict):\\n    \\\"\\\"\\\"One stage's tokens summed over every attempt (the statement's `tokens` block).\\\"\\\"\\\"\\n    input: int\\n    output: int\\n    partial: bool\\n\\n\\nclass ItemTokens(TypedDict):\\n    \\\"\\\"\\\"Every record's tokens summed, per stage and for the item. A record\\n    that carries no tokens is named in not_read and makes every sum it\\n    belongs to partial -- absent is never zero.\\\"\\\"\\\"\\n    build: StageTokens\\n    verify: StageTokens\\n    counsel: StageTokens\\n    input: int\\n    output: int\\n    partial: bool\\n    not_read: list[str]\\n\\n\\n# One row of the statement's `interventions` (issue #349): an amend, launch,\\n# or transport read from the ledger. \\\"class\\\" is a Python keyword, hence the\\n# functional form below.\\nStatementIntervention = TypedDict(\\\"StatementIntervention\\\", {\\n    \\\"at\\\": str,\\n    \\\"class\\\": Literal[\\\"amend\\\", \\\"launch\\\", \\\"transport\\\"],\\n    \\\"by\\\": str,\\n    \\\"sha\\\": str,\\n})\\n\\n\\nclass AttestRecord(TypedDict):\\n    \\\"\\\"\\\"The statement `attavo attest` prints (schema/attestation.schema.json).\\\"\\\"\\\"\\n    sha: str\\n    merge_sha: str\\n    item: str\\n    spec: str | None\\n    spec_sha: str | None\\n    approval: str | None\\n    approval_sha: str | None\\n    build: str | None\\n    build_sha: str | None\\n    verify: str | None\\n    verify_sha: str | None\\n    at: str\\n    interventions: list[StatementIntervention]\\n    acts: list[dict[str, str]]\\n    time: ItemTime\\n    cost: ItemCost\\n    tokens: ItemTokens\\n    product_version: str\\n    product_pin: str | None\\n\\n\\n# What counsel reads a stop from: a build or verify record, or a refused\\n# spec-gate record (issue #133).\\nStageRecord = SpecRecord | BuildRecord | VerifyRecord\\n\\n\\nclass DriveReport(TypedDict):\\n    \\\"\\\"\\\"What `attavo drive N --report` prints (schema/drive-report.schema.json):\\n    the item's level, read from its records, its markers, and the forge.\\\"\\\"\\\"\\n    item: str\\n    state: str\\n    kind: str\\n    says: str\\n    stage: str | None\\n    attempt: int | None\\n    record: str | None\\n    stop_class: str | None\\n    counsel: str | None\\n    filed: str | None\\n    head: str | None\\n    checks: list[dict[str, str]] | None\\n    since: str | None\\n    last_event_age_s: int | None\\n    attempts: list[dict[str, Any]] | None\\n    signatures_match: bool | None\\n    rulings_available: list[str] | None\\n\",\"numLines\":325,\"startLine\":1,\"totalLines\":325}},\"tool_result_meta\":[{\"id\":\"toolu_012CYttwP4VbNhBRXZ9VmbUD\",\"permission_decision\":{\"decision\":\"accept\",\"source\":\"config\",\"reason_type\":\"rule\"}}]}\n82:{\"type\":\"assistant\",\"message\":{\"model\":\"claude-sonnet-5\",\"id\":\"msg_011Cg4HSb23h4vnFaqGYMp72\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"Now let's look at attavo/attest.py around line 381 where interventions is built.\"}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":4556,\"cache_read_input_tokens\":30801,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":4556},\"output_tokens\":7,\"service_tier\":\"standard\",\"inference_geo\":\"global\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"2fdf7451-69ca-4099-9892-05c092db1ff4\",\"uuid\":\"b080d874-2b4d-4688-9840-1a91298cef99\",\"timestamp\":\"2026-10-15T15:47:18.079Z\",\"request_id\":\"req_011Cg4HSanfLsaoS7nRoLY7K\"}\n84:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01FKMbGKPBW1D6KcmaZ56viY\",\"type\":\"tool_result\",\"content\":\"330\\t\\n331\\t    records_dir = root / records_rel / item_id\\n332\\
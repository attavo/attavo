y:230:        raise store.StoreRefusal(bad[0] if bad else \"claims names at least one path\")\nattavo/plan.py:232:    new.setdefault(\"claims\", {})[str(n)] = {\"paths\": list(paths), \"by\": by, \"at\": at}\nattavo/plan.py:236:def clear_claims(body: dict[str, Any], what: str) -> dict[str, Any]:\nattavo/plan.py:237:    \"\"\"A copy of body without issue what's draft claims. Raises StoreRefusal.\"\"\"\nattavo/plan.py:243:    if str(n) not in body.get(\"claims\", {}):\nattavo/plan.py:244:        raise store.StoreRefusal(f\"#{n} has no claims to clear\")\nattavo/plan.py:246:    del new[\"claims\"][str(n)]\nattavo/plan.py:279:    if not argv or argv[0] not in (\"get\", \"put\", \"log\", \"rank\", \"move\", \"claims\"):\nattavo/plan.py:282:              \"claims #N (<PATH>... | --clear) --by LOGIN\",\nattavo/plan.py:320:        if verb == \"claims\":\nattavo/plan.py:325:                return _refuse(\"plan claims '#N' <path>... --by LOGIN, or plan claims '#N' --clear --by LOGIN\")\nattavo/plan.py:329:                return _write(root, clear_claims(current[\"body\"], words[0]), current[\"version\"], by)\nattavo/plan.py:331:            return _write(root, set_claims(current[\"body\"], words[0], paths, by, at),\nattavo/plan.py:345:        usage=('attavo plan get [--version V] | put FILE --base V --by LOGIN | log', 'attavo plan rank <EPIC|#N> (--before <EPIC|#M> | --last) --by LOGIN', 'attavo plan move #N --epic EPIC --by LOGIN', 'attavo plan claims #N (<PATH>... | --clear) --by LOGIN'),\nattavo/plan.py:356:change one position or one membership and write the next version; claims\nattavo/stops.py:23:               \"ceiling\", \"claims-boundary\", \"repeated-act\", \"unclassed\", \"question\",\nattavo/stops.py:28:# #317 a fifth, test-bypass, retried with the steer \"run tests only with\nattavo/stops.py:76:    if checks and checks[\"exit\"] != 0:\nattavo/stops.py:77:        return f\"checks: exit {checks['exit']}\"\nattavo/stops.py:94:      - refused, by refusal_kind: claims
 @@ def cmd_build(argv: list[str]) -> int:\n             iterations_used = iteration\n             append_event(events_path, \"iteration\", f\"iteration {iteration} of {BUILD_ITERATION_BUDGET}\")\n             env = dict(os.environ)\n+            # #212 retired the checks command reaching the executor; an\n+            # ATTAVO_CHECKS_COMMAND exported by whoever launched `attavo\n+            # build` must not reach it by inheritance either.\n+            env.pop(\"ATTAVO_CHECKS_COMMAND\", None)\n             env[\"ATTAVO_SPEC_DIR\"] = str(spec_dir)\n             env[\"ATTAVO_RECORDS_DIR\"] = str(item_records_dir)\n             env[\"ATTAVO_RULINGS\"] = str(root / m[\"paths\"][\"rulings\"])\ndiff --git a/attavo/verify.py b/attavo/verify.py\nindex 92a89ef..1e99e23 100644\n--- a/attavo/verify.py\n+++ b/attavo/verify.py\n@@ -156,8 +156,15 @@ def cmd_verify(argv: list[str]) -> int:\n \n     build_sha = latest_build[\"sha\"]\n     build_record_path = latest_attempt_path(item_records_dir, \"build\")\n+    approval_sha = latest_build.get(\"approval_sha\")\n+    spec_dir = root / specs_rel / item_id\n     started = time.monotonic()\n     head_sha = git(root, \"rev-parse\", \"HEAD\").strip()\n+\n+    diff_text, diff_refusal = diff_since_approval(root, approval_sha)\n+    if diff_refusal:\n+        print(f\"attavo verify: refused: {diff_refusal}\")\n+        return 1\n     # The forge attaches checks to a pull request's head, not to the\n     # executor's own commit -- that commit stops being the head the\n     # moment a record commit lands on top of it (issue #44). Reading the\n@@ -175,7 +182,7 @@ def cmd_verify(argv: list[str]) -> int:\n             \"sha\": head_sha,\n             \"build_sha\": build_sha,\n             \"build_record\": build_record_path.stem if build_record_path else None,\n-            \"approval_sha\": latest_build.get(\"approval_sha\"),\n+            \"approval_sha\": approval_sha,\n             \"at\": now_iso(),\n             \"adapter\": None, \"adapter_config\": {}, \"adapter_version\": None,\n             \"model\": None, \"model_version\": None,\n@@ -184,7 +191,7 @@ def cmd_verify(argv: list[str]) -> int:\n             \"findings\": None,\n             \"tests_named\": [],\n             \"commits\": [],\n-            \"stub_ratio\": None,\n+            \"stub_ratio\": stub_ratio(diff_text, spec_dir / \"stub\", (specs_rel, records_rel)),\n             \"tokens\": {\"input\": 0, \"output\": 0}, \"cost_usd\": None,\n             \"wall_clock_s\": round(time.monotonic() - started, 3),\n             \"status\": \"returned\",\n@@ -206,15 +213,8 @@ def cmd_verify(argv: list[str]) -> int:\n \n     adapter_config = merge_adapter_config(m, adapter_name, \"verify\")\n     reports = adapter_reports(adapter_path)\n-    approval_sha = latest_build.get(\"approval_sha\")\n-    spec_dir = root / specs_rel / item_id\n     branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n \n-    diff_text, diff_refusal = diff_since_approval(root, approval_sha)\n-    if diff_refusal:\n-        print(f\"attavo verify: refused: {diff_refusal}\")\n-        return 1\n-\n     events_path = stage_events_dir(root) / f\"verify-{next_attempt_number(item_records_dir, 'verify'):02d}.events.jsonl\"\n \n     with tempfile.TemporaryDirectory() as tmp:","is_error":false}]},"parent_tool_use_id":null,"session_id":"e315cdd6-2988-47fc-ade3-50611d672dde","uuid":"cbf8c67f-6507-4fef-985b-36a272f10457","timestamp":"2026-09-25T16:15:36.645Z","tool_use_result":{"stdout":"diff --git a/.attavo/bin/select-tests b/.attavo/bin/select-tests\nindex 37b523a..0a60262 100644\n--- a/.attavo/bin/select-tests\n+++ b/.attavo/bin/select-tests\n@@ -7,8 +7,10 @@ on stdout, one per line, for this repository's own test suite:\n \n   - prose (*.md, LICENSE) and this repository's own specs and records\n     (attest/specs/**, attest/records/**) select nothing;\n-  - a test file (tests/test_*.py) selects itself, and nothing at all when\n-    it no longer exists;\n+  
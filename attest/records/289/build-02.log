{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01W62jgmmkCmhYRDDoHMzexH","type":"tool_result","content":"1\tfrom __future__ import annotations\n2\t\n3\timport json\n4\tfrom pathlib import Path\n5\t\n6\tfrom attavo.common import git, now_iso\n7\t\n8\t# --- events: the adapter contract's one optional output (issue #26) --\n9\t# an uncommitted <stage>-NN.events.jsonl the screen tails while a stage\n10\t# runs, never a record and never committed (commit_record names only\n11\t# .json, .log, and .filed; this suffix is never among them). Written\n12\t# under the checkout's own git directory, not the working tree (issue\n13\t# #140): tenant zero's own item #688 committed its events file for\n14\t# real -- the executor's own commit staged it, because it sat inside\n15\t# the tree the executor runs `git status` against. ---\n16\t\n17\tEVENT_TEXT_MAX_CHARS = 400\n18\t\n19\t\n20\tdef stage_events_dir(root: Path) -> Path:\n21\t    \"\"\"<git-dir>/attavo, absolute -- <checkout>/.git/attavo for an\n22\t    ordinary checkout, <main-repo>/.git/worktrees/<name>/attavo for a\n23\t    linked worktree (issue #140). Outside the working tree either way,\n24\t    so a file written here never appears in `git status` in root and is\n25\t    never at risk of being staged and committed by the executor; the\n26\t    screen's seam finds it the same way, with the same command, in its\n27\t    own worktree.\"\"\"\n28\t    git_dir = Path(git(root, \"rev-parse\", \"--absolute-git-dir\").strip())\n29\t    events_dir = git_dir / \"attavo\"\n30\t    events_dir.mkdir(parents=True, exist_ok=True)\n31\t    return events_dir\n32\t\n33\t\n34\tdef append_event(events_path: Path, kind: str, text: str) -> None:\n35\t    \"\"\"One {at, kind, text} JSON line appended to events_path and flushed\n36\t    at once (open-write-close, not a kept handle) -- the screen tails\n37\t    this file while the stage is still running, so a line held in a\n38\t    buffer is a line the feed does not move on. text is collapsed to one\n39\t    line and capped at EVENT_TEXT_MAX_CHARS: a tool result can be a whole\n40\t    file, and the feed renders lines, not files.\"\"\"\n41\t    line = {\"at\": now_iso(), \"kind\": kind,\n42\t            \"text\": \" \".join(text.split())[:EVENT_TEXT_MAX_CHARS]}\n43\t    with events_path.open(\"a\") as fh:\n44\t        fh.write(json.dumps(line) + \"\\n\")\n45\t"}]},"parent_tool_use_id":null,"session_id":"f68ad510-dfe5-4e6d-98ca-88f33284a9d0","uuid":"ae78d434-fb15-46ec-96d0-c8b799457984","timestamp":"2026-10-01T13:56:19.215Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-289/attavo/events.py","content":"from __future__ import annotations\n\nimport json\nfrom pathlib import Path\n\nfrom attavo.common import git, now_iso\n\n# --- events: the adapter contract's one optional output (issue #26) --\n# an uncommitted <stage>-NN.events.jsonl the screen tails while a stage\n# runs, never a record and never committed (commit_record names only\n# .json, .log, and .filed; this suffix is never among them). Written\n# under the checkout's own git directory, not the working tree (issue\n# #140): tenant zero's own item #688 committed its events file for\n# real -- the executor's own commit staged it, because it sat inside\n# the tree the executor runs `git status` against. ---\n\nEVENT_TEXT_MAX_CHARS = 400\n\n\ndef stage_events_dir(root: Path) -> Path:\n    \"\"\"<git-dir>/attavo, absolute -- <checkout>/.git/attavo for an\n    ordinary checkout, <main-repo>/.git/worktrees/<name>/attavo for a\n    linked worktree (issue #140). Outside the working tree either way,\n    so a file written here never appears in `git status` in root and is\n    never at risk of being staged and committed by the executor; the\n    screen's seam finds it the same way, with the same command, in its\n    own worktree.\"\"\"\n    git_dir = Path(git(root, \"rev-parse\", \"--absolute-git-dir\").strip())\n    events_dir = git_dir / \"attavo\"\n    events_dir.mkdir(parents=True, exist_ok=True)\n    return events_dir\n\n\ndef append_event(events_path: Path, kind: str, text: str) -> None:\n    \"\"\"One {at, kind, text} JSON line appended to events_path and flushed\n    at once (open-write-close, not a kept handle) -- the screen tails\n    this file while the stage is still running, so a line held in a\n    buffer is a line the feed does not move on. text is collapsed to one\n    line and capped at EVENT_TEXT_MAX_CHARS: a tool result can be a whole\n    file, and the feed renders lines, not files.\"\"\"\n    line = {\"at\": now_iso(), \"kind\": kind,\n            \"text\": \" \".join(text.split())[:EVENT_TEXT_MAX_CHARS]}\n    with events_path.open(\"a\") as fh:\n        fh.write(json.dumps(line) + \"\\n\")\n","numLines":45,"startLine":1,"totalLines":45}}}

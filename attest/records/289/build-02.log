{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LMfktFeQDCTZ5E4sDV8ARn","type":"tool_result","content":"1\t\"\"\"The reconciler's R2 (claude/reconciler-brief-2026-09-20.md, rulings A, B,\n2\tH): `attavo drive N` is one short pass that reads the report, acts at most\n3\tonce, and returns; a stage runs in a detached worker with its own\n4\theartbeat; the marker's push is the lease; recovery is the pass's; the\n5\treview takes the checks the pass read on the pre-marker head.\n6\t\n7\tRun: python3 -m pytest tests -q\n8\t\"\"\"\n9\tfrom __future__ import annotations\n10\t\n11\timport json\n12\timport os\n13\timport socket\n14\timport subprocess\n15\timport sys\n16\timport time\n17\tfrom pathlib import Path\n18\tfrom typing import Any\n19\t\n20\tfrom helpers import commit_all, git, make_tenant\n21\tfrom test_drive import (\n22\t    GREEN_FORGE,\n23\t    add_bare_remote,\n24\t    add_drive_stall_bound,\n25\t    add_forge,\n26\t    approve_item,\n27\t    head_of,\n28\t    publish_approval,\n29\t    latest_record,\n30\t    record_files,\n31\t    records_dir,\n32\t    remote_head,\n33\t    run_attavo,\n34\t    write_dead_marker,\n35\t)\n36\t\n37\tROOT = Path(__file__).resolve().parent.parent\n38\tFAST = {\"ATTAVO_HEARTBEAT_S\": \"0.2\", \"ATTAVO_DRIVE_POLL_INTERVAL_S\": \"0.5\"}\n39\t\n40\t\n41\tdef slow_adapter(root: Path, seconds: float) -> None:\n42\t    \"\"\"A tenant-side build adapter: the product's own fixture adapter,\n43\t    after `seconds` of sleep on the build stage.\"\"\"\n44\t    d = root / \"attavo\" / \"adapters\" / \"fixture\"\n45\t    d.mkdir(parents=True, exist_ok=True)\n46\t    run = d / \"run\"\n47\t    run.write_text(f'#!/bin/sh\\nif [ \"${{ATTAVO_STAGE:-build}}\" = build ]; then sleep {seconds}; fi\\n'\n48\t                   f'exec sh {ROOT / \"adapters\" / \"fixture\" / \"run\"}\\n')\n49\t    run.chmod(0o755)\n50\t    commit_all(root, \"a slow tenant-side adapter\")\n51\t\n52\t\n53\tdef git_dir(root: Path) -> Path:\n54\t    return Path(git(root, \"rev-parse\", \"--absolute-git-dir\").strip())\n55\t\n56\t\n57\tdef report(root: Path, env: dict[str, str] | None = None) -> dict[str, Any]:\n58\t    run = run_attavo(root, \"drive\", \"1\", \"--report\", env={**FAST, **(env or {})})\n59\t    assert run.returncode == 0, run.stdout + run.stderr\n60\t    out: dict[str, Any] = json.loads(run.stdout)\n61\t    return out\n62\t\n63\t\n64\tdef pushed(bare: Path, subject: str) -> bool:\n65\t    log = subprocess.run([\"git\", \"-C\", str(bare), \"log\", \"--format=%s\", \"attavo/1-x\"], capture_output=True, text=True).stdout\n66\t    return subject in log\n67\t\n68\t\n69\tdef wait_for(pred: Any, seconds: float = 20) -> None:\n70\t    deadline = time.monotonic() + seconds\n71\t    while time.monotonic() < deadline:\n72\t        if pred():\n73\t            return\n74\t        time.sleep(0.2)\n75\t    raise AssertionError(\"condition not met in time\")\n76\t\n77\t\n78\tdef passes_until(root: Path, pred: Any, seconds: float = 40, env: dict[str, str] | None = None) -> None:\n79\t    \"\"\"Passes, spaced, until pred holds: how an operator's loop, the\n80\t    screen's poll, or a scheduler line would drive the item.\"\"\"\n81\t    deadline = time.monotonic() + seconds\n82\t    full = dict(FAST)\n83\t    full.update(env or {})\n84\t    while time.monotonic() < deadline:\n85\t        run_attavo(root, \"drive\", \"1\", env=full)\n86\t        if pred():\n87\t            return\n88\t        time.sleep(0.5)\n89\t    raise AssertionError(\"condition not met in time\")\n90\t\n91\t\n92\tdef clock_ahead(tmp_path: Path, seconds: float) -> dict[str, str]:\n93\t    \"\"\"The environment that puts every bound the product judges `seconds`\n94\t    past the machine's now (#257): a clock file, named by ATTAVO_CLOCK_FILE,\n95\t    that the next pass reads instead of waiting.\"\"\"\n96\t    path = tmp_path / \"attavo-clock\"\n97\t    path.write_text(str(time.time() + seconds))\n98\t    return {\"ATTAVO_CLOCK_FILE\": str(path)}\n99\t\n100\t\n101\tdef built_tenant(tmp_path: Path, seconds: float = 3) -> tuple[Path, Path]:\n102\t    root = make_tenant(tmp_path, \"build_valid\")\n103\t    add_forge(root, GREEN_FORGE)\n104\t    add_drive_stall_bound(root)\n105\t    slow_adapter(root, seconds)\n106\t    bare = add_bare_remote(root, tmp_path)\n107\t    approve_item(root)\n108\t    return root, bare\n109\t\n110\t\n111\tdef test_a_pass_returns_while_the_worker_runs_and_the_worker_outlives_it(tmp_path: Path) -> None:\n112\t    root, bare = built_tenant(tmp_path, seconds=3)\n113\t    started = time.monotonic()\n114\t    run = run_attavo(root, \"drive\", \"1\", env=FAST)\n115\t    elapsed = time.monotonic() - started\n116\t    assert run.returncode == 0, run.stdout + run.stderr\n117\t    assert elapsed < 2.5, f\"the pass took {elapsed:.1f}s: it waited for the stage\"\n118\t    assert \"Build started\" in run.stdout, run.stdout\n119\t    assert (records_dir(root) / \"build-01.started\").exists()\n120\t    assert remote_head(bare) == head_of(root), \"the marker was not pushed before the pass returned\""}]},"parent_tool_use_id":null,"session_id":"f68ad510-dfe5-4e6d-98ca-88f33284a9d0","uuid":"254994c6-744c-4e57-b343-f66616558567","timestamp":"2026-10-01T13:57:27.293Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-289/tests/test_pass.py","content":"\"\"\"The reconciler's R2 (claude/reconciler-brief-2026-09-20.md, rulings A, B,\nH): `attavo drive N` is one short pass that reads the report, acts at most\nonce, and returns; a stage runs in a detached worker with its own\nheartbeat; the marker's push is the lease; recovery is the pass's; the\nreview takes the checks the pass read on the pre-marker head.\n\nRun: python3 -m pytest tests -q\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport os\nimport socket\nimport subprocess\nimport sys\nimport time\nfrom pathlib import Path\nfrom typing import Any\n\nfrom helpers import commit_all, git, make_tenant\nfrom test_drive import (\n    GREEN_FORGE,\n    add_bare_remote,\n    add_drive_stall_bound,\n    add_forge,\n    approve_item,\n    head_of,\n    publish_approval,\n    latest_record,\n    record_files,\n    records_dir,\n    remote_head,\n    run_attavo,\n    write_dead_marker,\n)\n\nROOT = Path(__file__).resolve().parent.parent\nFAST = {\"ATTAVO_HEARTBEAT_S\": \"0.2\", \"ATTAVO_DRIVE_POLL_INTERVAL_S\": \"0.5\"}\n\n\ndef slow_adapter(root: Path, seconds: float) -> None:\n    \"\"\"A tenant-side build adapter: the product's own fixture adapter,\n    after `seconds` of sleep on the build stage.\"\"\"\n    d = root / \"attavo\" / \"adapters\" / \"fixture\"\n    d.mkdir(parents=True, exist_ok=True)\n    run = d / \"run\"\n    run.write_text(f'#!/bin/sh\\nif [ \"${{ATTAVO_STAGE:-build}}\" = build ]; then sleep {seconds}; fi\\n'\n                   f'exec sh {ROOT / \"adapters\" / \"fixture\" / \"run\"}\\n')\n    run.chmod(0o755)\n    commit_all(root, \"a slow tenant-side adapter\")\n\n\ndef git_dir(root: Path) -> Path:\n    return Path(git(root, \"rev-parse\", \"--absolute-git-dir\").strip())\n\n\ndef report(root: Path, env: dict[str, str] | None = None) -> dict[str, Any]:\n    run = run_attavo(root, \"drive\", \"1\", \"--report\", env={**FAST, **(env or {})})\n    assert run.returncode == 0, run.stdout + run.stderr\n    out: dict[str, Any] = json.loads(run.stdout)\n    return out\n\n\ndef pushed(bare: Path, subject: str) -> bool:\n    log = subprocess.run([\"git\", \"-C\", str(bare), \"log\", \"--format=%s\", \"attavo/1-x\"], capture_output=True, text=True).stdout\n    return subject in log\n\n\ndef wait_for(pred: Any, seconds: float = 20) -> None:\n    deadline = time.monotonic() + seconds\n    while time.monotonic() < deadline:\n        if pred():\n            return\n        time.sleep(0.2)\n    raise AssertionError(\"condition not met in time\")\n\n\ndef passes_until(root: Path, pred: Any, seconds: float = 40, env: dict[str, str] | None = None) -> None:\n    \"\"\"Passes, spaced, until pred holds: how an operator's loop, the\n    screen's poll, or a scheduler line would drive the item.\"\"\"\n    deadline = time.monotonic() + seconds\n    full = dict(FAST)\n    full.update(env or {})\n    while time.monotonic() < deadline:\n        run_attavo(root, \"drive\", \"1\", env=full)\n        if pred():\n            return\n        time.sleep(0.5)\n    raise AssertionError(\"condition not met in time\")\n\n\ndef clock_ahead(tmp_path: Path, seconds: float) -> dict[str, str]:\n    \"\"\"The environment that puts every bound the product judges `seconds`\n    past the machine's now (#257): a clock file, named by ATTAVO_CLOCK_FILE,\n    that the next pass reads instead of waiting.\"\"\"\n    path = tmp_path / \"attavo-clock\"\n    path.write_text(str(time.time() + seconds))\n    return {\"ATTAVO_CLOCK_FILE\": str(path)}\n\n\ndef built_tenant(tmp_path: Path, seconds: float = 3) -> tuple[Path, Path]:\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    add_drive_stall_bound(root)\n    slow_adapter(root, seconds)\n    bare = add_bare_remote(root, tmp_path)\n    approve_item(root)\n    return root, bare\n\n\ndef test_a_pass_returns_while_the_worker_runs_and_the_worker_outlives_it(tmp_path: Path) -> None:\n    root, bare = built_tenant(tmp_path, seconds=3)\n    started = time.monotonic()\n    run = run_attavo(root, \"drive\", \"1\", env=FAST)\n    elapsed = time.monotonic() - started\n    assert run.returncode == 0, run.stdout + run.stderr\n    assert elapsed < 2.5, f\"the pass took {elapsed:.1f}s: it waited for the stage\"\n    assert \"Build started\" in run.stdout, run.stdout\n    assert (records_dir(root) / \"build-01.started\").exists()\n    assert remote_head(bare) == head_of(root), \"the marker was not pushed before the pass returned\"","numLines":120,"startLine":1,"totalLines":440}}}

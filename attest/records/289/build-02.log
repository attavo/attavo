output=True, text=True).stdout\n187\t    assert log.count(\"build invocation 01 started\") == 1, log\n188\t    wait_for(lambda: \"build record for item 1\" in subprocess.run(\n189\t        [\"git\", \"-C\", str(bare), \"log\", \"--format=%s\", \"attavo/1-x\"], capture_output=True, text=True).stdout)\n190\t\n191\t\n192\tdef test_a_pass_recovers_a_dead_invocation_and_recover_is_gone(tmp_path: Path) -> None:\n193\t    root = make_tenant(tmp_path, \"build_valid\")\n194\t    git(root, \"checkout\", \"-q\", \"-b\", \"attavo/1-x\")\n195\t    add_forge(root, GREEN_FORGE)\n196\t    add_drive_stall_bound(root)\n197\t    approve_item(root)\n198\t    write_dead_marker(root, \"build\", 1)\n199\t    gone = run_attavo(root, \"drive\", \"--recover\", \"1\", env=FAST)"}]},"parent_tool_use_id":null,"session_id":"f68ad510-dfe5-4e6d-98ca-88f33284a9d0","uuid":"35fe2483-72d8-4f1a-836a-4678f486c4e0","timestamp":"2026-10-01T13:57:31.089Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-289/tests/test_pass.py","content":"    r = report(root)\n    assert r[\"state\"] == \"running\", r\n\n\ndef test_two_passes_at_once_start_one_worker_and_the_loser_says_so(tmp_path: Path) -> None:\n    root, bare = built_tenant(tmp_path, seconds=3)\n    publish_approval(root)\n    clone = tmp_path / \"second\"\n    git(root.parent, \"clone\", \"-q\", \"-b\", git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip(), str(bare), str(clone))\n    git(clone, \"config\", \"user.email\", \"test@example.com\")\n    git(clone, \"config\", \"user.name\", \"Attavo Test\")\n    git(clone, \"remote\", \"set-head\", \"origin\", \"-a\")\n    env = dict(os.environ)\n    env.update(FAST)\n    before = {c: (head_of(c), git(c, \"ls-files\", \"-s\"), git(c, \"status\", \"--porcelain\")) for c in (root, clone)}\n    procs = [subprocess.Popen([sys.executable, str(ROOT / \"bin\" / \"attavo\"), \"drive\", \"1\"], cwd=str(c),\n                              env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)\n             for c in (root, clone)]\n    outs = [p.communicate(timeout=30)[0] for p in procs]\n    started = [o for o in outs if \"Build started\" in o]\n    held = [o for o in outs if \"another pass holds\" in o]\n    assert len(started) == 1 and len(held) == 1, outs\n    loser = clone if \"another pass holds\" in outs[1] else root\n    assert (head_of(loser), git(loser, \"ls-files\", \"-s\"), git(loser, \"status\", \"--porcelain\")) == before[loser], \\\n        \"the loser's checkout (HEAD, index, working tree) moved\"\n    assert \"reset\" not in git(loser, \"reflog\", \"show\", \"HEAD\"), git(loser, \"reflog\", \"show\", \"HEAD\")\n    log = subprocess.run([\"git\", \"-C\", str(bare), \"log\", \"--format=%s\", \"attavo/1-x\"], capture_output=True, text=True).stdout\n    assert log.count(\"build invocation 01 started\") == 1, log\n    wait_for(lambda: \"build record for item 1\" in subprocess.run(\n        [\"git\", \"-C\", str(bare), \"log\", \"--format=%s\", \"attavo/1-x\"], capture_output=True, text=True).stdout)\n\n\ndef test_a_pass_recovers_a_dead_invocation_and_recover_is_gone(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"build_valid\")\n    git(root, \"checkout\", \"-q\", \"-b\", \"attavo/1-x\")\n    add_forge(root, GREEN_FORGE)\n    add_drive_stall_bound(root)\n    approve_item(root)\n    write_dead_marker(root, \"build\", 1)\n    gone = run_attavo(root, \"drive\", \"--recover\", \"1\", env=FAST)","numLines":40,"startLine":160,"totalLines":440}}}

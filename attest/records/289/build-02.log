{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01HrNPz5Fpbqxv8ogYVEiBAR","type":"tool_result","content":"160\t                if m:\n161\t                    found.add(m.group(1))\n162\t        if all(s in found for s in stages):\n163\t            return merge[\"sha\"], None\n164\t    return None, None\n165\t\n166\t\n167\tINVOCATION_MARKER_SUFFIX = \".started\"\n168\t\n169\t\n170\tdef invocation_marker_path(records_dir: Path, stage: str, nn: int) -> Path:\n171\t    return records_dir / f\"{stage}-{nn:02d}{INVOCATION_MARKER_SUFFIX}\"\n172\t\n173\t\n174\tdef heartbeat_s() -> float:\n175\t    return float(os.environ.get(\"ATTAVO_HEARTBEAT_S\", 15))\n176\t\n177\t\n178\tdef heartbeat_path(root: Path, stage: str, nn: int) -> Path:\n179\t    return stage_events_dir(root) / f\"{stage}-{nn:02d}.heartbeat\"\n180\t\n181\t\n182\tdef heartbeat_pid(path: Path) -> int | None:\n183\t    \"\"\"The pid the worker wrote as its heartbeat file's one line on its\n184\t    first beat -- the holder's own, the only pid anyone signals. None when\n185\t    the file is absent, unreadable, empty (a worker from before this\n186\t    release touched it and wrote nothing), or not a positive integer.\"\"\"\n187\t    try:\n188\t        text = path.read_text().strip()\n189\t    except OSError:\n190\t        return None\n191\t    if not text.isdigit() or int(text) <= 0:\n192\t        return None\n193\t    return int(text)\n194\t\n195\t\n196\tdef heartbeat_age_s(path: Path) -> float | None:\n197\t    \"\"\"Seconds since the heartbeat file was last touched; None when there\n198\t    is no such file.\"\"\"\n199\t    try:\n200\t        return clock.now() - path.stat().st_mtime\n201\t    except OSError:\n202\t        return None\n203\t\n204\t\n205\tdef write_invocation_marker(root: Path, records_dir: Path, stage: str, nn: int,\n206\t                            again_by: str | None = None) -> Path:\n207\t    \"\"\"The fact that an invocation began, written before it does: at,\n208\t    host, the sha it starts on, and the product that started it. No pid:\n209\t    the writer is `attavo drive`, which returns seconds later, and the\n210\t    process that holds the stage is the worker, whose own heartbeat is\n211\t    the fact of holding it. Its record's arrival is what retires a\n212\t    marker; a marker with no record is an invocation that died or hangs,\n213\t    and proof five names it. again_by is the login that pressed `--again`\n214\t    to reset a stage whose budget was spent (or whose last two signatures\n215\t    matched) -- absent on every ordinary marker, never a bare false.\"\"\"\n216\t    import socket\n217\t    from datetime import datetime, timezone\n218\t    records_dir.mkdir(parents=True, exist_ok=True)\n219\t    path = invocation_marker_path(records_dir, stage, nn)\n220\t    sha = git(root, \"rev-parse\", \"HEAD\").strip()\n221\t    info: dict[str, Any] = {\"at\": datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\"),\n222\t                            \"host\": socket.gethostname(), \"sha\": sha,\n223\t                            \"product_version\": product_version()}\n224\t    if again_by:\n225\t        info[\"again_by\"] = again_by\n226\t    path.write_text(json.dumps(info, indent=2) + \"\\n\")\n227\t    return path\n228\t\n229\t\n230\tdef invocation_age_s(info: dict[str, Any]) -> float | None:\n231\t    \"\"\"Seconds since the marker's own `at` timestamp -- how long ago the\n232\t    invocation it names began, whatever host wrote it. None when `at` is\n233\t    missing or does not parse.\"\"\"\n234\t    from datetime import datetime, timezone\n235\t    at = info.get(\"at\")\n236\t    if not isinstance(at, str):\n237\t        return None\n238\t    try:\n239\t        stamp = datetime.strptime(at, \"%Y-%m-%dT%H:%M:%SZ\").replace(tzinfo=timezone.utc)\n240\t    except ValueError:\n241\t        return None\n242\t    return clock.now() - stamp.timestamp()\n243\t\n244\t\n245\tdef invocations_without_record(item_records_dir: Path) -> list[tuple[Path, dict[str, Any]]]:\n246\t    \"\"\"Every <stage>-NN.started under one item whose <stage>-NN.json has\n247\t    not arrived, with the marker's own dict ({} when unreadable).\"\"\"\n248\t    out: list[tuple[Path, dict[str, Any]]] = []\n249\t    if not item_records_dir.is_dir():\n250\t        return out\n251\t    for marker in sorted(item_records_dir.glob(f\"*{INVOCATION_MARKER_SUFFIX}\")):\n252\t        if (item_records_dir / f\"{marker.stem}.json\").is_file():\n253\t            continue\n254\t        try:\n255\t            with marker.open() as fh:\n256\t                info = json.load(fh)\n257\t        except (OSError, ValueError):\n258\t            info = {}\n259\t        out.append((marker, info if isinstance(info, dict) else {}))\n260\t    return out\n261\t\n262\t\n263\tdef stall_bound_s(m: dict[str, Any]) -> int | None:\n264\t    \"\"\"[drive].stall_after_s: the tenant's own bound past which a live\n265\t    invocation with no new event is hung. A bound the tenant did not\n266\t    write is a forecast, so there is no default.\"\"\"\n267\t    bound = (m.get(\"drive\") or {}).get(\"stall_after_s\")\n268\t    if isinstance(bound, bool) or not isinstance(bound, (int, float)) or bound <= 0:\n269\t        return None\n270\t    return int(bound)\n271\t\n272\t\n273\tdef ceiling_s(m: dict[str, Any], stage: str) -> int | None:\n274\t    \"\"\"R3: [drive.<stage>].ceiling_s, the wall clock past which a live\n275\t    invocation of that stage is hung by its ceiling, whatever event age\n276\t    says (or does not say, for an adapter that streams none). No\n277\t    default: a ceiling the tenant did not declare is not assumed.\"\"\"\n278\t    value = ((m.get(\"drive\") or {}).get(stage) or {}).get(\"ceiling_s\")\n279\t    if isinstance(value, bool) or not isinstance(value, (int, float)) or value <= 0:\n280\t        return None\n281\t    return int(value)\n282\t\n283\t\n284\tdef attempts_budget(m: dict[str, Any]) -> int:\n285\t    \"\"\"R3: [drive].attempts, the attempts a stage may spend -- across a\n286\t    plain retry, a returned retry, and a steered one alike -- before the\n287\t    item is a person's; 3 when the manifest does not say.\"\"\"\n288\t    value = (m.get(\"drive\") or {}).get(\"attempts\")\n289\t    if isinstance(value, bool) or not isinstance(value, int) or value < 1:\n290\t        return 3\n291\t    return value\n292\t\n293\t\n294\tdef retry_after_s(m: dict[str, Any]) -> int:\n295\t    \"\"\"R3: [drive].retry_after_s, the wait a transient stop's record sits\n296\t    through before its next attempt starts; 300 when the manifest does\n297\t    not say.\"\"\"\n298\t    value = (m.get(\"drive\") or {}).get(\"retry_after_s\")\n299\t    if isinstance(value, bool) or not isinstance(value, (int, float)) or value < 0:\n300\t        return 300\n301\t    return int(value)\n302\t\n303\t\n304\tdef proof_no_invocation_lacks_record(root: Path, m: dict[str, Any] | None) -> Proof:\n305\t    import socket\n306\t    p = Proof(\"no-invocation-lacks-record\", \"no invocation lacks its record\")\n307\t    if m is None:\n308\t        return p.fail(f\"no {MANIFEST} at {root}; no records directory is declared\")\n309\t    records_rel = m.get(\"paths\", {}).get(\"records\", \"\")\n310\t    records_dir = root / records_rel\n311\t    if not records_dir.is_dir():\n312\t        return p.fail(f\"no records directory under {records_dir}\")\n313\t    bound = stall_bound_s(m)\n314\t    if bound is None:\n315\t        return p.fail(\"no [drive].stall_after_s in the manifest; a hung invocation cannot be \"\n316\t                      \"told from a running one\")\n317\t    # R3: a stage with no ceiling can run forever unjudged even when\n318\t    # stall_after_s is set (an adapter that streams no events trips no\n319\t    # stall bound at all) -- refused the same way stall_after_s's own\n320\t    # absence is, not folded into it, so the reason names exactly which\n321\t    # keys the manifest is missing.\n322\t    missing_ceilings = [f\"[drive.{stage}].ceiling_s\" for stage in (\"build\", \"verify\")\n323\t                        if ceiling_s(m, stage) is None]\n324\t    if missing_ceilings:\n325\t        return p.fail(f\"no {' or '.join(missing_ceilings)} in the manifest; a stage with no \"\n326\t                      f\"ceiling can run forever unjudged (R3)\")\n327\t    if (m.get(\"drive\") or {}).get(\"attempts\") is None:\n328\t        return p.fail(\"no [drive].attempts in the manifest; a retryable stop would spend an \"\n329\t                      \"unbounded number of attempts (R3)\")\n330\t    this_host = socket.gethostname()\n331\t    recorded = 0\n332\t    running: list[str] = []\n333\t    in_flight: list[str] = []\n334\t    problems: list[str] = []\n335\t    for item_dir in sorted(d for d in records_dir.iterdir() if d.is_dir()):\n336\t        for marker in item_dir.glob(f\"*{INVOCATION_MARKER_SUFFIX}\"):\n337\t            if (item_dir / f\"{marker.stem}.json\").is_file():\n338\t                recorded += 1\n339\t        for marker, info in invocations_without_record(item_dir):\n340\t            name = f\"item {item_dir.name} {marker.stem}\"\n341\t            stage, nn_text = marker.stem.rsplit(\"-\", 1)\n342\t            try:\n343\t                beat_age = heartbeat_age_s(heartbeat_path(root, stage, int(nn_text)))\n344\t            except (RuntimeError, ValueError):\n345\t                beat_age = None\n346\t            if beat_age is not None:\n347\t                # The holder's own fact: fresh within three beats is\n348\t                # running, older is a holder that stopped touching it.\n349\t                if beat_age <= heartbeat_s() * 3:\n350\t                    running.append(f\"{name} (heartbeat {int(beat_age)} s old, since {info.get('at')})\")\n351\t                    continue\n352\t            elif info.get(\"host\") != this_host:\n353\t                # No heartbeat file readable from here for a marker from\n354\t                # another host: not yet a failure. An invocation younger\n355\t                # than the tenant's own stall bound may simply be running\n356\t                # elsewhere, still writing toward its own record.\n357\t                age = invocation_age_s(info)\n358\t                if age is not None and age < bound:\n359\t                    in_flight.append(f\"{name} (host {info.get('host')} since {info.get('at')})\")\n360\t                    continue\n361\t            problems.append(f\"{name} started {info.get('at')} on {info.get('host')} \"\n362\t                            f\"and never wrote its record\")\n363\t    if problems:\n364\t        return p.fail(\"; \".join(problems), unrecorded_invocations=len(problems),\n365\t                      running_invocations=running, in_flight=in_flight)\n366\t    return p.hold(f\"{recorded} invocation(s) recorded, {len(running)} running, \"\n367\t                  f\"{len(in_flight)} in flight elsewhere\",\n368\t                  unrecorded_invocations=0, running_invocations=running, in_flight=in_flight)\n369\t\n370\t\n371\tdef proof_one_item_every_stage(root: Path, m: dict[str, Any] | None) -> Proof:\n372\t    p = Proof(\"one-item-every-stage\", \"one item has traversed every stage\")\n373\t    if m is None:\n374\t        return p.fail(f\"no {MANIFEST} at {root}; no records directory is declared\")\n375\t    records_rel = m.get(\"paths\", {}).get(\"records\", \"\")\n376\t    records_dir = root / records_rel\n377\t    items = load_records(records_dir)\n378\t    if not items:\n379\t        return p.fail(f\"no work item under {records_dir.relative_to(root)}\")\n380\t    complete = [item for item, stages in items.items() if all(s in stages for s in STAGES)]\n381\t    if not complete:\n382\t        best = max(items.items(), key=lambda kv: len(kv[1]))\n383\t        lacking = [s for s in STAGES if s not in best[1]]\n384\t        return p.fail(f\"no item carries every stage; item {best[0]} lacks {', '.join(lacking)}\")\n385\t\n386\t    # issue #74: a complete item is counted only when its chain holds --\n387\t    # attavo attest refuses a build re-approved after the fact or a\n388\t    # verify whose build went stale, and the coherence gate refuses the\n389\t    # merge group on exactly that; a proof that never asked would call a"}]},"parent_tool_use_id":null,"session_id":"f68ad510-dfe5-4e6d-98ca-88f33284a9d0","uuid":"3bfb8f2f-046c-42ad-9614-4883010f32c6","timestamp":"2026-10-01T13:56:11.109Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-289/attavo/doctor.py","content":"                if m:\n                    found.add(m.group(1))\n        if all(s in found for s in stages):\n            return merge[\"sha\"], None\n    return None, None\n\n\nINVOCATION_MARKER_SUFFIX = \".started\"\n\n\ndef invocation_marker_path(records_dir: Path, stage: str, nn: int) -> Path:\n    return records_dir / f\"{stage}-{nn:02d}{INVOCATION_MARKER_SUFFIX}\"\n\n\ndef heartbeat_s() -> float:\n    return float(os.environ.get(\"ATTAVO_HEARTBEAT_S\", 15))\n\n\ndef heartbeat_path(root: Path, stage: str, nn: int) -> Path:\n    return stage_events_dir(root) / f\"{stage}-{nn:02d}.heartbeat\"\n\n\ndef heartbeat_pid(path: Path) -> int | None:\n    \"\"\"The pid the worker wrote as its heartbeat file's one line on its\n    first beat -- the holder's own, the only pid anyone signals. None when\n    the file is absent, unreadable, empty (a worker from before this\n    release touched it and wrote nothing), or not a positive integer.\"\"\"\n    try:\n        text = path.read_text().strip()\n    except OSError:\n        return None\n    if not text.isdigit() or int(text) <= 0:\n        return None\n    return int(text)\n\n\ndef heartbeat_age_s(path: Path) -> float | None:\n    \"\"\"Seconds since the heartbeat file was last touched; None when there\n    is no such file.\"\"\"\n    try:\n        return clock.now() - path.stat().st_mtime\n    except OSError:\n        return None\n\n\ndef write_invocation_marker(root: Path, records_dir: Path, stage: str, nn: int,\n                            again_by: str | None = None) -> Path:\n    \"\"\"The fact that an invocation began, written before it does: at,\n    host, the sha it starts on, and the product that started it. No pid:\n    the writer is `attavo drive`, which returns seconds later, and the\n    process that holds the stage is the worker, whose own heartbeat is\n    the fact of holding it. Its record's arrival is what retires a\n    marker; a marker with no record is an invocation that died or hangs,\n    and proof five names it. again_by is the login that pressed `--again`\n    to reset a stage whose budget was spent (or whose last two signatures\n    matched) -- absent on every ordinary marker, never a bare false.\"\"\"\n    import socket\n    from datetime import datetime, timezone\n    records_dir.mkdir(parents=True, exist_ok=True)\n    path = invocation_marker_path(records_dir, stage, nn)\n    sha = git(root, \"rev-parse\", \"HEAD\").strip()\n    info: dict[str, Any] = {\"at\": datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\"),\n                            \"host\": socket.gethostname(), \"sha\": sha,\n                            \"product_version\": product_version()}\n    if again_by:\n        info[\"again_by\"] = again_by\n    path.write_text(json.dumps(info, indent=2) + \"\\n\")\n    return path\n\n\ndef invocation_age_s(info: dict[str, Any]) -> float | None:\n    \"\"\"Seconds since the marker's own `at` timestamp -- how long ago the\n    invocation it names began, whatever host wrote it. None when `at` is\n    missing or does not parse.\"\"\"\n    from datetime import datetime, timezone\n    at = info.get(\"at\")\n    if not isinstance(at, str):\n        return None\n    try:\n        stamp = datetime.strptime(at, \"%Y-%m-%dT%H:%M:%SZ\").replace(tzinfo=timezone.utc)\n    except ValueError:\n        return None\n    return clock.now() - stamp.timestamp()\n\n\ndef invocations_without_record(item_records_dir: Path) -> list[tuple[Path, dict[str, Any]]]:\n    \"\"\"Every <stage>-NN.started under one item whose <stage>-NN.json has\n    not arrived, with the marker's own dict ({} when unreadable).\"\"\"\n    out: list[tuple[Path, dict[str, Any]]] = []\n    if not item_records_dir.is_dir():\n        return out\n    for marker in sorted(item_records_dir.glob(f\"*{INVOCATION_MARKER_SUFFIX}\")):\n        if (item_records_dir / f\"{marker.stem}.json\").is_file():\n            continue\n        try:\n            with marker.open() as fh:\n                info = json.load(fh)\n        except (OSError, ValueError):\n            info = {}\n        out.append((marker, info if isinstance(info, dict) else {}))\n    return out\n\n\ndef stall_bound_s(m: dict[str, Any]) -> int | None:\n    \"\"\"[drive].stall_after_s: the tenant's own bound past which a live\n    invocation with no new event is hung. A bound the tenant did not\n    write is a forecast, so there is no default.\"\"\"\n    bound = (m.get(\"drive\") or {}).get(\"stall_after_s\")\n    if isinstance(bound, bool) or not isinstance(bound, (int, float)) or bound <= 0:\n        return None\n    return int(bound)\n\n\ndef ceiling_s(m: dict[str, Any], stage: str) -> int | None:\n    \"\"\"R3: [drive.<stage>].ceiling_s, the wall clock past which a live\n    invocation of that stage is hung by its ceiling, whatever event age\n    says (or does not say, for an adapter that streams none). No\n    default: a ceiling the tenant did not declare is not assumed.\"\"\"\n    value = ((m.get(\"drive\") or {}).get(stage) or {}).get(\"ceiling_s\")\n    if isinstance(value, bool) or not isinstance(value, (int, float)) or value <= 0:\n        return None\n    return int(value)\n\n\ndef attempts_budget(m: dict[str, Any]) -> int:\n    \"\"\"R3: [drive].attempts, the attempts a stage may spend -- across a\n    plain retry, a returned retry, and a steered one alike -- before the\n    item is a person's; 3 when the manifest does not say.\"\"\"\n    value = (m.get(\"drive\") or {}).get(\"attempts\")\n    if isinstance(value, bool) or not isinstance(value, int) or value < 1:\n        return 3\n    return value\n\n\ndef retry_after_s(m: dict[str, Any]) -> int:\n    \"\"\"R3: [drive].retry_after_s, the wait a transient stop's record sits\n    through before its next attempt starts; 300 when the manifest does\n    not say.\"\"\"\n    value = (m.get(\"drive\") or {}).get(\"retry_after_s\")\n    if isinstance(value, bool) or not isinstance(value, (int, float)) or value < 0:\n        return 300\n    return int(value)\n\n\ndef proof_no_invocation_lacks_record(root: Path, m: dict[str, Any] | None) -> Proof:\n    import socket\n    p = Proof(\"no-invocation-lacks-record\", \"no invocation lacks its record\")\n    if m is None:\n        return p.fail(f\"no {MANIFEST} at {root}; no records directory is declared\")\n    records_rel = m.get(\"paths\", {}).get(\"records\", \"\")\n    records_dir = root / records_rel\n    if not records_dir.is_dir():\n        return p.fail(f\"no records directory under {records_dir}\")\n    bound = stall_bound_s(m)\n    if bound is None:\n        return p.fail(\"no [drive].stall_after_s in the manifest; a hung invocation cannot be \"\n                      \"told from a running one\")\n    # R3: a stage with no ceiling can run forever unjudged even when\n    # stall_after_s is set (an adapter that streams no events trips no\n    # stall bound at all) -- refused the same way stall_after_s's own\n    # absence is, not folded into it, so the reason names exactly which\n    # keys the manifest is missing.\n    missing_ceilings = [f\"[drive.{stage}].ceiling_s\" for stage in (\"build\", \"verify\")\n                        if ceiling_s(m, stage) is None]\n    if missing_ceilings:\n        return p.fail(f\"no {' or '.join(missing_ceilings)} in the manifest; a stage with no \"\n                      f\"ceiling can run forever unjudged (R3)\")\n    if (m.get(\"drive\") or {}).get(\"attempts\") is None:\n        return p.fail(\"no [drive].attempts in the manifest; a retryable stop would spend an \"\n                      \"unbounded number of attempts (R3)\")\n    this_host = socket.gethostname()\n    recorded = 0\n    running: list[str] = []\n    in_flight: list[str] = []\n    problems: list[str] = []\n    for item_dir in sorted(d for d in records_dir.iterdir() if d.is_dir()):\n        for marker in item_dir.glob(f\"*{INVOCATION_MARKER_SUFFIX}\"):\n            if (item_dir / f\"{marker.stem}.json\").is_file():\n                recorded += 1\n        for marker, info in invocations_without_record(item_dir):\n            name = f\"item {item_dir.name} {marker.stem}\"\n            stage, nn_text = marker.stem.rsplit(\"-\", 1)\n            try:\n                beat_age = heartbeat_age_s(heartbeat_path(root, stage, int(nn_text)))\n            except (RuntimeError, ValueError):\n                beat_age = None\n            if beat_age is not None:\n                # The holder's own fact: fresh within three beats is\n                # running, older is a holder that stopped touching it.\n                if beat_age <= heartbeat_s() * 3:\n                    running.append(f\"{name} (heartbeat {int(beat_age)} s old, since {info.get('at')})\")\n                    continue\n            elif info.get(\"host\") != this_host:\n                # No heartbeat file readable from here for a marker from\n                # another host: not yet a failure. An invocation younger\n                # than the tenant's own stall bound may simply be running\n                # elsewhere, still writing toward its own record.\n                age = invocation_age_s(info)\n                if age is not None and age < bound:\n                    in_flight.append(f\"{name} (host {info.get('host')} since {info.get('at')})\")\n                    continue\n            problems.append(f\"{name} started {info.get('at')} on {info.get('host')} \"\n                            f\"and never wrote its record\")\n    if problems:\n        return p.fail(\"; \".join(problems), unrecorded_invocations=len(problems),\n                      running_invocations=running, in_flight=in_flight)\n    return p.hold(f\"{recorded} invocation(s) recorded, {len(running)} running, \"\n                  f\"{len(in_flight)} in flight elsewhere\",\n                  unrecorded_invocations=0, running_invocations=running, in_flight=in_flight)\n\n\ndef proof_one_item_every_stage(root: Path, m: dict[str, Any] | None) -> Proof:\n    p = Proof(\"one-item-every-stage\", \"one item has traversed every stage\")\n    if m is None:\n        return p.fail(f\"no {MANIFEST} at {root}; no records directory is declared\")\n    records_rel = m.get(\"paths\", {}).get(\"records\", \"\")\n    records_dir = root / records_rel\n    items = load_records(records_dir)\n    if not items:\n        return p.fail(f\"no work item under {records_dir.relative_to(root)}\")\n    complete = [item for item, stages in items.items() if all(s in stages for s in STAGES)]\n    if not complete:\n        best = max(items.items(), key=lambda kv: len(kv[1]))\n        lacking = [s for s in STAGES if s not in best[1]]\n        return p.fail(f\"no item carries every stage; item {best[0]} lacks {', '.join(lacking)}\")\n\n    # issue #74: a complete item is counted only when its chain holds --\n    # attavo attest refuses a build re-approved after the fact or a\n    # verify whose build went stale, and the coherence gate refuses the\n    # merge group on exactly that; a proof that never asked would call a","numLines":230,"startLine":160,"totalLines":1046}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01E5MCTwKB9j7XMEBjuTuzcQ","type":"tool_result","content":"638\t# --- the pass's own two acts: start a stage (the lease), and recover\n639\t# exactly the one invocation the report names owed one. ---\n640\t\n641\tdef _start_stage(root: Path, m: dict[str, Any], item_id: str, stage: str,\n642\t                 forge_checks: dict[str, Any] | None, again_by: str | None = None) -> int:\n643\t    \"\"\"The lease (ruling A): the marker, committed and pushed as a plain\n644\t    fast-forward with no merge and no retry, made and pushed from a\n645\t    detached worktree (transport_records). Lost to another pass, or\n646\t    refused outright by the remote, the worktree is discarded and this\n647\t    checkout was never touched; only a pushed lease starts the worker. On a\n648\t    review, forge_checks is the checks this same pass already read on\n649\t    the pre-marker head (ruling B) -- written to\n650\t    <git-dir>/attavo/verify-NN.forge-checks.json and named in\n651\t    ATTAVO_FORGE_CHECKS, so the worker's own `attavo verify` reads it\n652\t    instead of polling. again_by (R3) is the login that pressed `--again`, set\n653\t    only when it is what started this attempt, past a budget already spent\n654\t    or an early stop -- named in the marker, never on an ordinary or\n655\t    plainly-retried attempt.\"\"\"\n656\t    records_dir = root / m[\"paths\"][\"records\"] / item_id\n657\t    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n658\t    nn = next_attempt_number(records_dir, stage)\n659\t    marker = records_dir / f\"{stage}-{nn:02d}.started\"\n660\t\n661\t    def write_marker(tree: Path) -> list[Path]:\n662\t        return [write_invocation_marker(tree, tree / records_dir.relative_to(root), stage, nn,\n663\t                                        again_by=again_by, events_dir=stage_events_dir(root))]\n664\t\n665\t    outcome, err = transport_records(\n666\t        root, branch, f\"attavo: {stage} invocation {nn:02d} started for item {item_id}\",\n667\t        write_marker, lease=True)\n668\t    if outcome == \"lost-race\":\n669\t        print(f\"attavo drive: another pass holds this attempt ({marker.name}); nothing started\")\n670\t        return 0\n671\t    if outcome != \"pushed\":\n672\t        print(f\"attavo drive: stopped: could not push the {stage} invocation marker: {err}\")\n673\t        return 1\n674\t\n675\t    env = dict(os.environ)\n676\t    if forge_checks is not None:\n677\t        checks_file = forge_checks_path(root, stage, nn)\n678\t        checks_file.write_text(json.dumps(forge_checks))\n679\t        env[\"ATTAVO_FORGE_CHECKS\"] = str(checks_file)\n680\t    log = worker_log_path(root, stage, nn)\n681\t    with log.open(\"ab\") as fh, open(os.devnull, \"rb\") as devnull:\n682\t        proc = subprocess.Popen(\n683\t            [sys.executable, str(PRODUCT_ROOT / \"bin\" / \"attavo\"), \"worker\", item_id, stage, f\"{nn:02d}\"],\n684\t            cwd=str(root), env=env, stdin=devnull, stdout=fh, stderr=subprocess.STDOUT,\n685\t            start_new_session=True)\n686\t    word = \"Build\" if stage == \"build\" else \"Review\"\n687\t    print(f\"attavo drive: {word} started (attempt {nn:02d}, worker pid {proc.pid})\")\n688\t    return 0\n689\t\n690\t\n691\tdef _recover_one(root: Path, m: dict[str, Any], item_id: str, records_dir: Path) -> int:\n692\t    \"\"\"The pass's own recovery act (what `--recover` did): exactly the one\n693\t    invocation the report just read as owing one -- died or hung -- ends\n694\t    here. class died when the heartbeat is stale or absent, class hung\n695\t    when the heartbeat is fresh and a declared [drive].stall_after_s has\n696\t    passed with no newer event (or the stage's ceiling has passed), the\n697\t    holder terminated by the pid its own heartbeat names. Provenance product; the events tail as the log. Committed\n698\t    and pushed the way any stage record is (transport_records, with its\n699\t    retry that never merges) -- this is not a race for a lease, since no new\n700\t    attempt marker is written.\"\"\"\n701\t    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n702\t    bound = stall_bound_s(m)\n703\t    pending = invocations_without_record(records_dir)\n704\t    readings = [(marker, info, read_invocation(root, bound, marker, info)) for marker, info in pending]\n705\t    candidate = next(((mk, i, rd) for mk, i, rd in readings if rd.cls != \"running\"), None)\n706\t    if candidate is None:\n707\t        # The report read this a moment ago; nothing owed recovery by the\n708\t        # time this pass got here (another pass recovered it, or it\n709\t        # finished on its own).\n710\t        return 0\n711\t    marker, info, reading = candidate\n712\t    stage, nn, log, last_at, age, cls, crossed = reading\n713\t    host = info.get(\"host\")\n714\t\n715\t    if next_attempt_number(records_dir, stage) != nn:\n716\t        print(f\"attavo drive: stopped: {marker.name} names attempt {nn} but the next \"\n717\t              f\"{stage} record would be {next_attempt_number(records_dir, stage):02d}; \"\n718\t              f\"a later record already exists, read the records before recovering\")\n719\t        return 1\n720\t\n721\t    if cls == \"hung\":\n722\t        holder_file = holder_heartbeat_path(root, info, stage, nn)\n723\t        holder = heartbeat_pid(holder_file) if holder_file is not None else None\n724\t        if holder is None:\n725\t            print(f\"attavo drive: no holder to signal for {marker.stem}: its heartbeat names no pid\")\n726\t            ended = \"no holder to signal\"\n727\t            who = f\"no holder on {host}\"\n728\t        else:\n729\t            who = f\"pid {holder} on {host} alive\"\n730\t            try:\n731\t                os.kill(holder, signal.SIGTERM)\n732\t                ended = \"terminated\"\n733\t            except OSError as exc:\n734\t                ended = f\"not terminated ({exc})\"\n735\t        if crossed == \"ceiling\":\n736\t            detail = (f\"{who} {int(cast(float, age))} s after its marker, \"\n737\t                      f\"past the {stage} ceiling of {ceiling_s(m, stage)} s; {ended}\")"}]},"parent_tool_use_id":null,"session_id":"f68ad510-dfe5-4e6d-98ca-88f33284a9d0","uuid":"281452c2-dced-4349-926b-2655f199cb02","timestamp":"2026-10-01T13:57:00.115Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-289/attest/specs/289/stub/attavo/drive.py","content":"# --- the pass's own two acts: start a stage (the lease), and recover\n# exactly the one invocation the report names owed one. ---\n\ndef _start_stage(root: Path, m: dict[str, Any], item_id: str, stage: str,\n                 forge_checks: dict[str, Any] | None, again_by: str | None = None) -> int:\n    \"\"\"The lease (ruling A): the marker, committed and pushed as a plain\n    fast-forward with no merge and no retry, made and pushed from a\n    detached worktree (transport_records). Lost to another pass, or\n    refused outright by the remote, the worktree is discarded and this\n    checkout was never touched; only a pushed lease starts the worker. On a\n    review, forge_checks is the checks this same pass already read on\n    the pre-marker head (ruling B) -- written to\n    <git-dir>/attavo/verify-NN.forge-checks.json and named in\n    ATTAVO_FORGE_CHECKS, so the worker's own `attavo verify` reads it\n    instead of polling. again_by (R3) is the login that pressed `--again`, set\n    only when it is what started this attempt, past a budget already spent\n    or an early stop -- named in the marker, never on an ordinary or\n    plainly-retried attempt.\"\"\"\n    records_dir = root / m[\"paths\"][\"records\"] / item_id\n    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n    nn = next_attempt_number(records_dir, stage)\n    marker = records_dir / f\"{stage}-{nn:02d}.started\"\n\n    def write_marker(tree: Path) -> list[Path]:\n        return [write_invocation_marker(tree, tree / records_dir.relative_to(root), stage, nn,\n                                        again_by=again_by, events_dir=stage_events_dir(root))]\n\n    outcome, err = transport_records(\n        root, branch, f\"attavo: {stage} invocation {nn:02d} started for item {item_id}\",\n        write_marker, lease=True)\n    if outcome == \"lost-race\":\n        print(f\"attavo drive: another pass holds this attempt ({marker.name}); nothing started\")\n        return 0\n    if outcome != \"pushed\":\n        print(f\"attavo drive: stopped: could not push the {stage} invocation marker: {err}\")\n        return 1\n\n    env = dict(os.environ)\n    if forge_checks is not None:\n        checks_file = forge_checks_path(root, stage, nn)\n        checks_file.write_text(json.dumps(forge_checks))\n        env[\"ATTAVO_FORGE_CHECKS\"] = str(checks_file)\n    log = worker_log_path(root, stage, nn)\n    with log.open(\"ab\") as fh, open(os.devnull, \"rb\") as devnull:\n        proc = subprocess.Popen(\n            [sys.executable, str(PRODUCT_ROOT / \"bin\" / \"attavo\"), \"worker\", item_id, stage, f\"{nn:02d}\"],\n            cwd=str(root), env=env, stdin=devnull, stdout=fh, stderr=subprocess.STDOUT,\n            start_new_session=True)\n    word = \"Build\" if stage == \"build\" else \"Review\"\n    print(f\"attavo drive: {word} started (attempt {nn:02d}, worker pid {proc.pid})\")\n    return 0\n\n\ndef _recover_one(root: Path, m: dict[str, Any], item_id: str, records_dir: Path) -> int:\n    \"\"\"The pass's own recovery act (what `--recover` did): exactly the one\n    invocation the report just read as owing one -- died or hung -- ends\n    here. class died when the heartbeat is stale or absent, class hung\n    when the heartbeat is fresh and a declared [drive].stall_after_s has\n    passed with no newer event (or the stage's ceiling has passed), the\n    holder terminated by the pid its own heartbeat names. Provenance product; the events tail as the log. Committed\n    and pushed the way any stage record is (transport_records, with its\n    retry that never merges) -- this is not a race for a lease, since no new\n    attempt marker is written.\"\"\"\n    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n    bound = stall_bound_s(m)\n    pending = invocations_without_record(records_dir)\n    readings = [(marker, info, read_invocation(root, bound, marker, info)) for marker, info in pending]\n    candidate = next(((mk, i, rd) for mk, i, rd in readings if rd.cls != \"running\"), None)\n    if candidate is None:\n        # The report read this a moment ago; nothing owed recovery by the\n        # time this pass got here (another pass recovered it, or it\n        # finished on its own).\n        return 0\n    marker, info, reading = candidate\n    stage, nn, log, last_at, age, cls, crossed = reading\n    host = info.get(\"host\")\n\n    if next_attempt_number(records_dir, stage) != nn:\n        print(f\"attavo drive: stopped: {marker.name} names attempt {nn} but the next \"\n              f\"{stage} record would be {next_attempt_number(records_dir, stage):02d}; \"\n              f\"a later record already exists, read the records before recovering\")\n        return 1\n\n    if cls == \"hung\":\n        holder_file = holder_heartbeat_path(root, info, stage, nn)\n        holder = heartbeat_pid(holder_file) if holder_file is not None else None\n        if holder is None:\n            print(f\"attavo drive: no holder to signal for {marker.stem}: its heartbeat names no pid\")\n            ended = \"no holder to signal\"\n            who = f\"no holder on {host}\"\n        else:\n            who = f\"pid {holder} on {host} alive\"\n            try:\n                os.kill(holder, signal.SIGTERM)\n                ended = \"terminated\"\n            except OSError as exc:\n                ended = f\"not terminated ({exc})\"\n        if crossed == \"ceiling\":\n            detail = (f\"{who} {int(cast(float, age))} s after its marker, \"\n                      f\"past the {stage} ceiling of {ceiling_s(m, stage)} s; {ended}\")","numLines":100,"startLine":638,"totalLines":1125}}}

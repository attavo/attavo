{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DrWa5R8tXVJ3NRMh1NbTtx","type":"tool_result","content":"1\t#!/bin/sh\n2\tset -e\n3\there=$(pwd)\n4\ttmp=$(mktemp -d \"${TMPDIR:-/tmp}/attavo.XXXXXX\")\n5\tcp -R \"$here/tests/fixtures/valid/.\" \"$tmp/tenant\"\n6\tcd \"$tmp/tenant\"\n7\tgit init -q -b main .\n8\tgit config user.email fixture@attavo.invalid\n9\tgit config user.name \"fixture\"\n10\tgit add -A\n11\tgit commit -q -m install\n12\tmkdir -p \"$tmp/other-checkout-git/attavo\"\n13\tpython3 - \"$here\" \"$tmp/tenant\" \"$tmp/other-checkout-git/attavo\" <<'PY'\n14\timport json, os, socket, sys, time\n15\tfrom pathlib import Path\n16\tsys.path.insert(0, sys.argv[1])\n17\tfrom attavo.doctor import write_invocation_marker\n18\tfrom attavo.drive import read_invocation\n19\troot, elsewhere = Path(sys.argv[2]), Path(sys.argv[3])\n20\trecords = root / \"records\" / \"1\"\n21\tmarker = write_invocation_marker(root, records, \"build\", 1)\n22\tinfo = json.loads(marker.read_text())\n23\town = Path(os.popen(f\"git -C {root} rev-parse --absolute-git-dir\").read().strip()) / \"attavo\"\n24\tassert info.get(\"events\") == str(own), info\n25\tnow = time.strftime(\"%Y-%m-%dT%H:%M:%SZ\", time.gmtime())\n26\tinfo = {\"at\": now, \"host\": socket.gethostname(), \"sha\": info[\"sha\"], \"product_version\": \"x\",\n27\t        \"events\": str(elsewhere)}\n28\t(elsewhere / \"build-01.heartbeat\").write_text(str(os.getpid()))\n29\tassert read_invocation(root, 600, marker, info).cls == \"running\", \"a fresh heartbeat where the marker says\"\n30\t(elsewhere / \"build-01.heartbeat\").unlink()\n31\tassert read_invocation(root, 600, marker, info).cls == \"running\", \"no first beat yet, younger than the bound\"\n32\told = dict(info, at=\"2026-09-17T13:16:08Z\")\n33\tassert read_invocation(root, 600, marker, old).cls == \"died\", \"no heartbeat, older than the bound\"\n34\tlegacy = {k: v for k, v in info.items() if k != \"events\"}\n35\tassert read_invocation(root, 600, marker, legacy).cls == \"died\", \"a marker naming no directory reads as before\"\n36\tPY\n37\tcd \"$here\"\n38\tfor t in test_a_second_checkout_on_this_host_reads_the_first_ones_worker_as_running test_the_holders_heartbeat_is_read_where_its_marker_says test_the_marker_a_pass_writes_names_its_checkouts_heartbeat_directory\n39\tdo\n40\t  grep -q \"^def $t(\" tests/test_pass.py\n41\tdone\n42\trm -rf \"$tmp\"\n43\t"}]},"parent_tool_use_id":null,"session_id":"f68ad510-dfe5-4e6d-98ca-88f33284a9d0","uuid":"3355d2e7-db11-4cfa-a188-315a96525d81","timestamp":"2026-10-01T14:03:33.362Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-289/attest/specs/289/criteria/a-second-checkout-reads-the-holders-heartbeat-where-its-marker-says.sh","content":"#!/bin/sh\nset -e\nhere=$(pwd)\ntmp=$(mktemp -d \"${TMPDIR:-/tmp}/attavo.XXXXXX\")\ncp -R \"$here/tests/fixtures/valid/.\" \"$tmp/tenant\"\ncd \"$tmp/tenant\"\ngit init -q -b main .\ngit config user.email fixture@attavo.invalid\ngit config user.name \"fixture\"\ngit add -A\ngit commit -q -m install\nmkdir -p \"$tmp/other-checkout-git/attavo\"\npython3 - \"$here\" \"$tmp/tenant\" \"$tmp/other-checkout-git/attavo\" <<'PY'\nimport json, os, socket, sys, time\nfrom pathlib import Path\nsys.path.insert(0, sys.argv[1])\nfrom attavo.doctor import write_invocation_marker\nfrom attavo.drive import read_invocation\nroot, elsewhere = Path(sys.argv[2]), Path(sys.argv[3])\nrecords = root / \"records\" / \"1\"\nmarker = write_invocation_marker(root, records, \"build\", 1)\ninfo = json.loads(marker.read_text())\nown = Path(os.popen(f\"git -C {root} rev-parse --absolute-git-dir\").read().strip()) / \"attavo\"\nassert info.get(\"events\") == str(own), info\nnow = time.strftime(\"%Y-%m-%dT%H:%M:%SZ\", time.gmtime())\ninfo = {\"at\": now, \"host\": socket.gethostname(), \"sha\": info[\"sha\"], \"product_version\": \"x\",\n        \"events\": str(elsewhere)}\n(elsewhere / \"build-01.heartbeat\").write_text(str(os.getpid()))\nassert read_invocation(root, 600, marker, info).cls == \"running\", \"a fresh heartbeat where the marker says\"\n(elsewhere / \"build-01.heartbeat\").unlink()\nassert read_invocation(root, 600, marker, info).cls == \"running\", \"no first beat yet, younger than the bound\"\nold = dict(info, at=\"2026-09-17T13:16:08Z\")\nassert read_invocation(root, 600, marker, old).cls == \"died\", \"no heartbeat, older than the bound\"\nlegacy = {k: v for k, v in info.items() if k != \"events\"}\nassert read_invocation(root, 600, marker, legacy).cls == \"died\", \"a marker naming no directory reads as before\"\nPY\ncd \"$here\"\nfor t in test_a_second_checkout_on_this_host_reads_the_first_ones_worker_as_running test_the_holders_heartbeat_is_read_where_its_marker_says test_the_marker_a_pass_writes_names_its_checkouts_heartbeat_directory\ndo\n  grep -q \"^def $t(\" tests/test_pass.py\ndone\nrm -rf \"$tmp\"\n","numLines":43,"startLine":1,"totalLines":43}}}

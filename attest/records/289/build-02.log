{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0152G9Stih3hiVouH4nZ2Rb9","type":"tool_result","content":"600\t              f\"pushed to {branch}\")\n601\t    else:\n602\t        print(f\"attavo drive: pushed {after.name} to {branch}\")\n603\t    return rc\n604\t\n605\t\n606\tdef cmd_worker(argv: list[str]) -> int:\n607\t    \"\"\"`attavo worker N <build|verify> NN`: the detached child a pass\n608\t    starts once its marker is pushed -- the lease held, the attempt is\n609\t    this worker's to run. Its own session (start_new_session, set by the\n610\t    pass that spawns it); its stdout and stderr are the pass's own\n611\t    redirect, to <git-dir>/attavo/<stage>-NN.worker.log.\"\"\"\n612\t    cast(io.TextIOWrapper, sys.stdout).reconfigure(line_buffering=True)\n613\t    if len(argv) != 3:\n614\t        print(\"attavo worker: usage: attavo worker N <build|verify> NN\", file=sys.stderr)\n615\t        return 2\n616\t    item_id, stage, nn_text = argv\n617\t    if stage not in (\"build\", \"verify\"):\n618\t        print(f\"attavo worker: {stage!r} is not build or verify\", file=sys.stderr)\n619\t        return 2\n620\t    try:\n621\t        nn = int(nn_text)\n622\t    except ValueError:\n623\t        print(f\"attavo worker: {nn_text!r} is not an attempt number\", file=sys.stderr)\n624\t        return 2\n625\t    return _stage_body(item_id, stage, nn)\n626\t\n627\t\n628\t# --- the pass's own two acts: start a stage (the lease), and recover\n629\t# exactly the one invocation the report names owed one. ---\n630\t\n631\tdef _start_stage(root: Path, m: dict[str, Any], item_id: str, stage: str,\n632\t                 forge_checks: dict[str, Any] | None, again_by: str | None = None) -> int:\n633\t    \"\"\"The lease (ruling A): the marker, committed and pushed as a plain\n634\t    fast-forward with no merge and no retry, made and pushed from a\n635\t    detached worktree (transport_records). Lost to another pass, or\n636\t    refused outright by the remote, the worktree is discarded and this\n637\t    checkout was never touched; only a pushed lease starts the worker. On a\n638\t    review, forge_checks is the checks this same pass already read on\n639\t    the pre-marker head (ruling B) -- written to\n640\t    <git-dir>/attavo/verify-NN.forge-checks.json and named in\n641\t    ATTAVO_FORGE_CHECKS, so the worker's own `attavo verify` reads it\n642\t    instead of polling. again_by (R3) is the login that pressed `--again`, set\n643\t    only when it is what started this attempt, past a budget already spent\n644\t    or an early stop -- named in the marker, never on an ordinary or\n645\t    plainly-retried attempt.\"\"\"\n646\t    records_dir = root / m[\"paths\"][\"records\"] / item_id\n647\t    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n648\t    nn = next_attempt_number(records_dir, stage)\n649\t    marker = records_dir / f\"{stage}-{nn:02d}.started\"\n650\t\n651\t    def write_marker(tree: Path) -> list[Path]:\n652\t        return [write_invocation_marker(tree, tree / records_dir.relative_to(root), stage, nn,\n653\t                                        again_by=again_by)]\n654\t\n655\t    outcome, err = transport_records(\n656\t        root, branch, f\"attavo: {stage} invocation {nn:02d} started for item {item_id}\",\n657\t        write_marker, lease=True)\n658\t    if outcome == \"lost-race\":\n659\t        print(f\"attavo drive: another pass holds this attempt ({marker.name}); nothing started\")\n660\t        return 0\n661\t    if outcome != \"pushed\":\n662\t        print(f\"attavo drive: stopped: could not push the {stage} invocation marker: {err}\")\n663\t        return 1\n664\t\n665\t    env = dict(os.environ)\n666\t    if forge_checks is not None:\n667\t        checks_file = forge_checks_path(root, stage, nn)\n668\t        checks_file.write_text(json.dumps(forge_checks))\n669\t        env[\"ATTAVO_FORGE_CHECKS\"] = str(checks_file)\n670\t    log = worker_log_path(root, stage, nn)\n671\t    with log.open(\"ab\") as fh, open(os.devnull, \"rb\") as devnull:\n672\t        proc = subprocess.Popen(\n673\t            [sys.executable, str(PRODUCT_ROOT / \"bin\" / \"attavo\"), \"worker\", item_id, stage, f\"{nn:02d}\"],\n674\t            cwd=str(root), env=env, stdin=devnull, stdout=fh, stderr=subprocess.STDOUT,\n675\t            start_new_session=True)\n676\t    word = \"Build\" if stage == \"build\" else \"Review\"\n677\t    print(f\"attavo drive: {word} started (attempt {nn:02d}, worker pid {proc.pid})\")\n678\t    return 0\n679\t\n680\t\n681\tdef _recover_one(root: Path, m: dict[str, Any], item_id: str, records_dir: Path) -> int:\n682\t    \"\"\"The pass's own recovery act (what `--recover` did): exactly the one\n683\t    invocation the report just read as owing one -- died or hung -- ends\n684\t    here. class died when the heartbeat is stale or absent, class hung\n685\t    when the heartbeat is fresh and a declared [drive].stall_after_s has\n686\t    passed with no newer event (or the stage's ceiling has passed), the\n687\t    holder terminated by the pid its own heartbeat names. Provenance product; the events tail as the log. Committed\n688\t    and pushed the way any stage record is (transport_records, with its\n689\t    retry that never merges) -- this is not a race for a lease, since no new\n690\t    attempt marker is written.\"\"\"\n691\t    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n692\t    bound = stall_bound_s(m)\n693\t    pending = invocations_without_record(records_dir)\n694\t    readings = [(marker, info, read_invocation(root, bound, marker, info)) for marker, info in pending]\n695\t    candidate = next(((mk, i, rd) for mk, i, rd in readings if rd.cls != \"running\"), None)\n696\t    if candidate is None:\n697\t        # The report read this a moment ago; nothing owed recovery by the\n698\t        # time this pass got here (another pass recovered it, or it\n699\t        # finished on its own).\n700\t        return 0\n701\t    marker, info, reading = candidate\n702\t    stage, nn, log, last_at, age, cls, crossed = reading\n703\t    host = info.get(\"host\")\n704\t\n705\t    if next_attempt_number(records_dir, stage) != nn:\n706\t        print(f\"attavo drive: stopped: {marker.name} names attempt {nn} but the next \"\n707\t              f\"{stage} record would be {next_attempt_number(records_dir, stage):02d}; \"\n708\t              f\"a later record already exists, read the records before recovering\")\n709\t        return 1\n710\t\n711\t    if cls == \"hung\":\n712\t        holder = heartbeat_pid(heartbeat_path(root, stage, nn))\n713\t        if holder is None:\n714\t            print(f\"attavo drive: no holder to signal for {marker.stem}: its heartbeat names no pid\")\n715\t            ended = \"no holder to signal\"\n716\t            who = f\"no holder on {host}\"\n717\t        else:\n718\t            who = f\"pid {holder} on {host} alive\"\n719\t            try:\n720\t                os.kill(holder, signal.SIGTERM)\n721\t                ended = \"terminated\"\n722\t            except OSError as exc:\n723\t                ended = f\"not terminated ({exc})\"\n724\t        if crossed == \"ceiling\":\n725\t            detail = (f\"{who} {int(cast(float, age))} s after its marker, \"\n726\t                      f\"past the {stage} ceiling of {ceiling_s(m, stage)} s; {ended}\")\n727\t        else:\n728\t            detail = (f\"{who} with no event for {int(cast(float, age))} s \"\n729\t                      f\"(bound {bound} s); {ended}\")\n730\t    else:\n731\t        detail = (f\"{marker.stem} on {host} has no live heartbeat and wrote no {marker.stem}.json; \"\n732\t                  f\"started {info.get('at')}, last event {last_at or 'none'}\")\n733\t\n734\t    signature_text = log.strip().splitlines()[-1] if log.strip() else detail\n735\t\n736\t    schema = stage_schema(stage)\n737\t    record: dict[str, Any] = {k: None for k in schema.get(\"required\", [])}\n738\t    approval = latest_record(records_dir, \"approval\")\n739\t    record.update({\"sha\": info.get(\"sha\"), \"start_sha\": info.get(\"sha\"),\n740\t                   \"approval_sha\": approval.get(\"sha\") if approval else None,\n741\t                   \"at\": info.get(\"at\"),\n742\t                   \"adapter\": (m.get(\"executor\") or {}).get(stage),\n743\t                   \"status\": \"failed\", \"refusal\": None, \"halted\": None,\n744\t                   \"retry_of\": None, \"steer\": None,\n745\t                   \"stop\": {\"class\": cls, \"provenance\": \"product\", \"detail\": detail,\n746\t                            \"signature\": signature_of(signature_text), \"bound\": crossed}})\n747\t    if \"wall_clock_s\" in record:\n748\t        record[\"wall_clock_s\"] = None if age is None else int(age)\n749\t    record = {k: v for k, v in record.items() if k in schema.get(\"properties\", {})}"}]},"parent_tool_use_id":null,"session_id":"f68ad510-dfe5-4e6d-98ca-88f33284a9d0","uuid":"34c1bf39-cdbe-4e3d-9bd8-a85ca489da87","timestamp":"2026-10-01T13:56:22.658Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-289/attavo/drive.py","content":"              f\"pushed to {branch}\")\n    else:\n        print(f\"attavo drive: pushed {after.name} to {branch}\")\n    return rc\n\n\ndef cmd_worker(argv: list[str]) -> int:\n    \"\"\"`attavo worker N <build|verify> NN`: the detached child a pass\n    starts once its marker is pushed -- the lease held, the attempt is\n    this worker's to run. Its own session (start_new_session, set by the\n    pass that spawns it); its stdout and stderr are the pass's own\n    redirect, to <git-dir>/attavo/<stage>-NN.worker.log.\"\"\"\n    cast(io.TextIOWrapper, sys.stdout).reconfigure(line_buffering=True)\n    if len(argv) != 3:\n        print(\"attavo worker: usage: attavo worker N <build|verify> NN\", file=sys.stderr)\n        return 2\n    item_id, stage, nn_text = argv\n    if stage not in (\"build\", \"verify\"):\n        print(f\"attavo worker: {stage!r} is not build or verify\", file=sys.stderr)\n        return 2\n    try:\n        nn = int(nn_text)\n    except ValueError:\n        print(f\"attavo worker: {nn_text!r} is not an attempt number\", file=sys.stderr)\n        return 2\n    return _stage_body(item_id, stage, nn)\n\n\n# --- the pass's own two acts: start a stage (the lease), and recover\n# exactly the one invocation the report names owed one. ---\n\ndef _start_stage(root: Path, m: dict[str, Any], item_id: str, stage: str,\n                 forge_checks: dict[str, Any] | None, again_by: str | None = None) -> int:\n    \"\"\"The lease (ruling A): the marker, committed and pushed as a plain\n    fast-forward with no merge and no retry, made and pushed from a\n    detached worktree (transport_records). Lost to another pass, or\n    refused outright by the remote, the worktree is discarded and this\n    checkout was never touched; only a pushed lease starts the worker. On a\n    review, forge_checks is the checks this same pass already read on\n    the pre-marker head (ruling B) -- written to\n    <git-dir>/attavo/verify-NN.forge-checks.json and named in\n    ATTAVO_FORGE_CHECKS, so the worker's own `attavo verify` reads it\n    instead of polling. again_by (R3) is the login that pressed `--again`, set\n    only when it is what started this attempt, past a budget already spent\n    or an early stop -- named in the marker, never on an ordinary or\n    plainly-retried attempt.\"\"\"\n    records_dir = root / m[\"paths\"][\"records\"] / item_id\n    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n    nn = next_attempt_number(records_dir, stage)\n    marker = records_dir / f\"{stage}-{nn:02d}.started\"\n\n    def write_marker(tree: Path) -> list[Path]:\n        return [write_invocation_marker(tree, tree / records_dir.relative_to(root), stage, nn,\n                                        again_by=again_by)]\n\n    outcome, err = transport_records(\n        root, branch, f\"attavo: {stage} invocation {nn:02d} started for item {item_id}\",\n        write_marker, lease=True)\n    if outcome == \"lost-race\":\n        print(f\"attavo drive: another pass holds this attempt ({marker.name}); nothing started\")\n        return 0\n    if outcome != \"pushed\":\n        print(f\"attavo drive: stopped: could not push the {stage} invocation marker: {err}\")\n        return 1\n\n    env = dict(os.environ)\n    if forge_checks is not None:\n        checks_file = forge_checks_path(root, stage, nn)\n        checks_file.write_text(json.dumps(forge_checks))\n        env[\"ATTAVO_FORGE_CHECKS\"] = str(checks_file)\n    log = worker_log_path(root, stage, nn)\n    with log.open(\"ab\") as fh, open(os.devnull, \"rb\") as devnull:\n        proc = subprocess.Popen(\n            [sys.executable, str(PRODUCT_ROOT / \"bin\" / \"attavo\"), \"worker\", item_id, stage, f\"{nn:02d}\"],\n            cwd=str(root), env=env, stdin=devnull, stdout=fh, stderr=subprocess.STDOUT,\n            start_new_session=True)\n    word = \"Build\" if stage == \"build\" else \"Review\"\n    print(f\"attavo drive: {word} started (attempt {nn:02d}, worker pid {proc.pid})\")\n    return 0\n\n\ndef _recover_one(root: Path, m: dict[str, Any], item_id: str, records_dir: Path) -> int:\n    \"\"\"The pass's own recovery act (what `--recover` did): exactly the one\n    invocation the report just read as owing one -- died or hung -- ends\n    here. class died when the heartbeat is stale or absent, class hung\n    when the heartbeat is fresh and a declared [drive].stall_after_s has\n    passed with no newer event (or the stage's ceiling has passed), the\n    holder terminated by the pid its own heartbeat names. Provenance product; the events tail as the log. Committed\n    and pushed the way any stage record is (transport_records, with its\n    retry that never merges) -- this is not a race for a lease, since no new\n    attempt marker is written.\"\"\"\n    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n    bound = stall_bound_s(m)\n    pending = invocations_without_record(records_dir)\n    readings = [(marker, info, read_invocation(root, bound, marker, info)) for marker, info in pending]\n    candidate = next(((mk, i, rd) for mk, i, rd in readings if rd.cls != \"running\"), None)\n    if candidate is None:\n        # The report read this a moment ago; nothing owed recovery by the\n        # time this pass got here (another pass recovered it, or it\n        # finished on its own).\n        return 0\n    marker, info, reading = candidate\n    stage, nn, log, last_at, age, cls, crossed = reading\n    host = info.get(\"host\")\n\n    if next_attempt_number(records_dir, stage) != nn:\n        print(f\"attavo drive: stopped: {marker.name} names attempt {nn} but the next \"\n              f\"{stage} record would be {next_attempt_number(records_dir, stage):02d}; \"\n              f\"a later record already exists, read the records before recovering\")\n        return 1\n\n    if cls == \"hung\":\n        holder = heartbeat_pid(heartbeat_path(root, stage, nn))\n        if holder is None:\n            print(f\"attavo drive: no holder to signal for {marker.stem}: its heartbeat names no pid\")\n            ended = \"no holder to signal\"\n            who = f\"no holder on {host}\"\n        else:\n            who = f\"pid {holder} on {host} alive\"\n            try:\n                os.kill(holder, signal.SIGTERM)\n                ended = \"terminated\"\n            except OSError as exc:\n                ended = f\"not terminated ({exc})\"\n        if crossed == \"ceiling\":\n            detail = (f\"{who} {int(cast(float, age))} s after its marker, \"\n                      f\"past the {stage} ceiling of {ceiling_s(m, stage)} s; {ended}\")\n        else:\n            detail = (f\"{who} with no event for {int(cast(float, age))} s \"\n                      f\"(bound {bound} s); {ended}\")\n    else:\n        detail = (f\"{marker.stem} on {host} has no live heartbeat and wrote no {marker.stem}.json; \"\n                  f\"started {info.get('at')}, last event {last_at or 'none'}\")\n\n    signature_text = log.strip().splitlines()[-1] if log.strip() else detail\n\n    schema = stage_schema(stage)\n    record: dict[str, Any] = {k: None for k in schema.get(\"required\", [])}\n    approval = latest_record(records_dir, \"approval\")\n    record.update({\"sha\": info.get(\"sha\"), \"start_sha\": info.get(\"sha\"),\n                   \"approval_sha\": approval.get(\"sha\") if approval else None,\n                   \"at\": info.get(\"at\"),\n                   \"adapter\": (m.get(\"executor\") or {}).get(stage),\n                   \"status\": \"failed\", \"refusal\": None, \"halted\": None,\n                   \"retry_of\": None, \"steer\": None,\n                   \"stop\": {\"class\": cls, \"provenance\": \"product\", \"detail\": detail,\n                            \"signature\": signature_of(signature_text), \"bound\": crossed}})\n    if \"wall_clock_s\" in record:\n        record[\"wall_clock_s\"] = None if age is None else int(age)\n    record = {k: v for k, v in record.items() if k in schema.get(\"properties\", {})}","numLines":150,"startLine":600,"totalLines":1114}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01An1xdJLSSyZ73iDfUUMsNt","type":"tool_result","content":"150\t    if merges is None:\n151\t        merges, refusal = _merges_reachable(root)\n152\t        if refusal:\n153\t            return None, refusal\n154\t    prefix = f\"{records_rel.rstrip('/')}/{item}/\"\n155\t    for merge in merges:\n156\t        found: set[str] = set()\n157\t        for p in merge[\"touched\"]:\n158\t            if p.startswith(prefix):\n159\t                m = RECORD_RE.match(Path(p).name)\n160\t                if m:\n161\t                    found.add(m.group(1))\n162\t        if all(s in found for s in stages):\n163\t            return merge[\"sha\"], None\n164\t    return None, None\n165\t\n166\t\n167\tINVOCATION_MARKER_SUFFIX = \".started\"\n168\t\n169\t\n170\tdef invocation_marker_path(records_dir: Path, stage: str, nn: int) -> Path:\n171\t    return records_dir / f\"{stage}-{nn:02d}{INVOCATION_MARKER_SUFFIX}\"\n172\t\n173\t\n174\tdef heartbeat_s() -> float:\n175\t    return float(os.environ.get(\"ATTAVO_HEARTBEAT_S\", 15))\n176\t\n177\t\n178\tdef heartbeat_path(root: Path, stage: str, nn: int) -> Path:\n179\t    return stage_events_dir(root) / f\"{stage}-{nn:02d}.heartbeat\"\n180\t\n181\t\n182\tdef holder_heartbeat_path(root: Path, info: dict[str, Any], stage: str, nn: int) -> Path | None:\n183\t    \"\"\"Where the holder of an invocation writes its heartbeat, as far as\n184\t    this host can read it: the directory its marker names, when the\n185\t    marker is from this host and names one; this checkout's own, for a\n186\t    marker from this host written before markers named it; None for a\n187\t    marker from another host, whose heartbeat no file here holds.\"\"\"\n188\t    import socket\n189\t    if info.get(\"host\") != socket.gethostname():\n190\t        return None\n191\t    events = info.get(\"events\")\n192\t    if isinstance(events, str) and events:\n193\t        return Path(events) / f\"{stage}-{nn:02d}.heartbeat\"\n194\t    return heartbeat_path(root, stage, nn)\n195\t\n196\t\n197\tdef heartbeat_pid(path: Path) -> int | None:\n198\t    \"\"\"The pid the worker wrote as its heartbeat file's one line on its\n199\t    first beat -- the holder's own, the only pid anyone signals. None when\n200\t    the file is absent, unreadable, empty (a worker from before this\n201\t    release touched it and wrote nothing), or not a positive integer.\"\"\"\n202\t    try:\n203\t        text = path.read_text().strip()\n204\t    except OSError:\n205\t        return None\n206\t    if not text.isdigit() or int(text) <= 0:\n207\t        return None\n208\t    return int(text)\n209\t\n210\t\n211\tdef heartbeat_age_s(path: Path) -> float | None:\n212\t    \"\"\"Seconds since the heartbeat file was last touched; None when there\n213\t    is no such file.\"\"\"\n214\t    try:\n215\t        return clock.now() - path.stat().st_mtime\n216\t    except OSError:\n217\t        return None\n218\t\n219\t\n220\tdef write_invocation_marker(root: Path, records_dir: Path, stage: str, nn: int,\n221\t                            again_by: str | None = None, events_dir: Path | None = None) -> Path:\n222\t    \"\"\"The fact that an invocation began, written before it does: at,\n223\t    host, the sha it starts on, and the product that started it. No pid:\n224\t    the writer is `attavo drive`, which returns seconds later, and the\n225\t    process that holds the stage is the worker, whose own heartbeat is\n226\t    the fact of holding it. Its record's arrival is what retires a\n227\t    marker; a marker with no record is an invocation that died or hangs,\n228\t    and proof five names it. again_by is the login that pressed `--again`\n229\t    to reset a stage whose budget was spent (or whose last two signatures\n230\t    matched) -- absent on every ordinary marker, never a bare false.\n231\t    events names the directory the holder's heartbeat will be written in\n232\t    (the checkout's own <git-dir>/attavo, events_dir when the marker is\n233\t    written from a detached worktree for another checkout): two checkouts\n234\t    on one host each keep their own, so the host alone never says where\n235\t    the holder's heartbeat can be read.\"\"\"\n236\t    import socket\n237\t    from datetime import datetime, timezone\n238\t    records_dir.mkdir(parents=True, exist_ok=True)\n239\t    path = invocation_marker_path(records_dir, stage, nn)\n240\t    sha = git(root, \"rev-parse\", \"HEAD\").strip()\n241\t    info: dict[str, Any] = {\"at\": datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\"),\n242\t                            \"host\": socket.gethostname(), \"sha\": sha,\n243\t                            \"product_version\": product_version(),\n244\t                            \"events\": str(events_dir or stage_events_dir(root))}\n245\t    if again_by:\n246\t        info[\"again_by\"] = again_by\n247\t    path.write_text(json.dumps(info, indent=2) + \"\\n\")\n248\t    return path\n249\t\n250\t\n251\tdef invocation_age_s(info: dict[str, Any]) -> float | None:\n252\t    \"\"\"Seconds since the marker's own `at` timestamp -- how long ago the\n253\t    invocation it names began, whatever host wrote it. None when `at` is\n254\t    missing or does not parse.\"\"\"\n255\t    from datetime import datetime, timezone\n256\t    at = info.get(\"at\")\n257\t    if not isinstance(at, str):\n258\t        return None\n259\t    try:\n260\t        stamp = datetime.strptime(at, \"%Y-%m-%dT%H:%M:%SZ\").replace(tzinfo=timezone.utc)\n261\t    except ValueError:\n262\t        return None\n263\t    return clock.now() - stamp.timestamp()\n264\t\n265\t\n266\tdef invocations_without_record(item_records_dir: Path) -> list[tuple[Path, dict[str, Any]]]:\n267\t    \"\"\"Every <stage>-NN.started under one item whose <stage>-NN.json has\n268\t    not arrived, with the marker's own dict ({} when unreadable).\"\"\"\n269\t    out: list[tuple[Path, dict[str, Any]]] = []\n270\t    if not item_records_dir.is_dir():\n271\t        return out\n272\t    for marker in sorted(item_records_dir.glob(f\"*{INVOCATION_MARKER_SUFFIX}\")):\n273\t        if (item_records_dir / f\"{marker.stem}.json\").is_file():\n274\t            continue\n275\t        try:\n276\t            with marker.open() as fh:\n277\t                info = json.load(fh)\n278\t        except (OSError, ValueError):\n279\t            info = {}\n280\t        out.append((marker, info if isinstance(info, dict) else {}))\n281\t    return out\n282\t\n283\t\n284\tdef stall_bound_s(m: dict[str, Any]) -> int | None:\n285\t    \"\"\"[drive].stall_after_s: the tenant's own bound past which a live\n286\t    invocation with no new event is hung. A bound the tenant did not\n287\t    write is a forecast, so there is no default.\"\"\"\n288\t    bound = (m.get(\"drive\") or {}).get(\"stall_after_s\")\n289\t    if isinstance(bound, bool) or not isinstance(bound, (int, float)) or bound <= 0:\n290\t        return None\n291\t    return int(bound)\n292\t\n293\t\n294\tdef ceiling_s(m: dict[str, Any], stage: str) -> int | None:\n295\t    \"\"\"R3: [drive.<stage>].ceiling_s, the wall clock past which a live\n296\t    invocation of that stage is hung by its ceiling, whatever event age\n297\t    says (or does not say, for an adapter that streams none). No\n298\t    default: a ceiling the tenant did not declare is not assumed.\"\"\"\n299\t    value = ((m.get(\"drive\") or {}).get(stage) or {}).get(\"ceiling_s\")\n300\t    if isinstance(value, bool) or not isinstance(value, (int, float)) or value <= 0:\n301\t        return None\n302\t    return int(value)\n303\t\n304\t\n305\tdef attempts_budget(m: dict[str, Any]) -> int:\n306\t    \"\"\"R3: [drive].attempts, the attempts a stage may spend -- across a\n307\t    plain retry, a returned retry, and a steered one alike -- before the\n308\t    item is a person's; 3 when the manifest does not say.\"\"\"\n309\t    value = (m.get(\"drive\") or {}).get(\"attempts\")\n310\t    if isinstance(value, bool) or not isinstance(value, int) or value < 1:\n311\t        return 3\n312\t    return value\n313\t\n314\t\n315\tdef retry_after_s(m: dict[str, Any]) -> int:\n316\t    \"\"\"R3: [drive].retry_after_s, the wait a transient stop's record sits\n317\t    through before its next attempt starts; 300 when the manifest does\n318\t    not say.\"\"\"\n319\t    value = (m.get(\"drive\") or {}).get(\"retry_after_s\")\n320\t    if isinstance(value, bool) or not isinstance(value, (int, float)) or value < 0:\n321\t        return 300\n322\t    return int(value)\n323\t\n324\t\n325\tdef proof_no_invocation_lacks_record(root: Path, m: dict[str, Any] | None) -> Proof:\n326\t    import socket\n327\t    p = Proof(\"no-invocation-lacks-record\", \"no invocation lacks its record\")\n328\t    if m is None:\n329\t        return p.fail(f\"no {MANIFEST} at {root}; no records directory is declared\")\n330\t    records_rel = m.get(\"paths\", {}).get(\"records\", \"\")\n331\t    records_dir = root / records_rel\n332\t    if not records_dir.is_dir():\n333\t        return p.fail(f\"no records directory under {records_dir}\")\n334\t    bound = stall_bound_s(m)\n335\t    if bound is None:\n336\t        return p.fail(\"no [drive].stall_after_s in the manifest; a hung invocation cannot be \"\n337\t                      \"told from a running one\")\n338\t    # R3: a stage with no ceiling can run forever unjudged even when\n339\t    # stall_after_s is set (an adapter that streams no events trips no\n340\t    # stall bound at all) -- refused the same way stall_after_s's own\n341\t    # absence is, not folded into it, so the reason names exactly which\n342\t    # keys the manifest is missing.\n343\t    missing_ceilings = [f\"[drive.{stage}].ceiling_s\" for stage in (\"build\", \"verify\")\n344\t                        if ceiling_s(m, stage) is None]\n345\t    if missing_ceilings:\n346\t        return p.fail(f\"no {' or '.join(missing_ceilings)} in the manifest; a stage with no \"\n347\t        
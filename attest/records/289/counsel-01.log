2\\tready-to-merge (issue #84) -- under R2, one pass per invocation: read the\\n3\\treport, act at most once (recover, start the build, start the review) in\\n4\\ta detached worker, return. A level that belongs to a person is printed\\n5\\tand left. Every test uses the fixture\\n6\\tadapter and a fake `[forge].checks_command`; every record commit is\\n7\\t`git commit --only` and pushed to a real (bare) fixture remote.\\n8\\t\\n9\\tRegression tests, written and run red first: on `main` at 85f6f3b there\\n10\\twas no `drive` subcommand, so every one of these failed with \\\"unknown\\n11\\tsubcommand\\\".\\n12\\t\\n13\\tRun: python3 -m pytest tests -q\\n14\\t\\\"\\\"\\\"\\n15\\timport importlib\\n16\\timport json\\n17\\timport os\\n18\\timport socket\\n19\\timport queue\\n20\\timport subprocess\\n21\\timport sys\\n22\\timport threading\\n23\\timport time\\n24\\tfrom pathlib import Path\\n25\\tfrom typing import IO, Any, cast\\n26\\t\\n27\\tfrom helpers import commit_all as _commit_all\\n28\\tfrom helpers import git, make_tenant\\n29\\t\\n30\\tROOT = Path(__file__).resolve().parent.parent\\n31\\t\\n32\\t\\n33\\tdef commit_all(root: Path, message: str) -> None:\\n34\\t    \\\"\\\"\\\"helpers.commit_all, then the push an operator makes: the pass only\\n35\\t    fast-forwards the checkout and refuses commits origin lacks, so a\\n36\\t    fixture with a remote carries none.\\\"\\\"\\\"\\n37\\t    _commit_all(root, message)\\n38\\t    if subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"remote\\\", \\\"get-url\\\", \\\"origin\\\"],\\n39\\t                      capture_output=True).returncode == 0:\\n40\\t        git(root, \\\"push\\\", \\\"-q\\\", \\\"origin\\\", f\\\"HEAD:{git(root, 'rev-parse', '--abbrev-ref', 'HEAD').strip()}\\\")\\n41\\t\\n42\\t\\n43\\tATTAVO = ROOT / \\\"bin\\\" / \\\"attavo\\\"\\n44\\t\\n45\\tGREEN_FORGE = \\\"printf 'ci success\\\\\\\\n'\\\"\\n46\\t# A concluded conclusion -- checked and failing, not something still\\n47\\t# running. Distinct from UNCONCLUDED_FORGE below (issue #84): drive polls\\n48\\t# the one still running for the bound, but stops on the first read of a\\n49\\t# check that has already concluded, whether or not it passed.\\n50\\tRED_FORGE = \\\"printf 'ci failure\\\\\\\\n'\\\"\\n51\\tUNCONCLUDED_FORGE = \\\"printf 'ci in_progress\\\\\\\\n'\\\"\\n52\\t\\n53\\t# The real defaults (ATTAVO_DRIVE_POLL_BOUND_S=600, _INTERVAL_S=20) are a\\n54\\t# real forge's clock, not a test's -- tenant zero's own checks conclude\\n55\\t# about five minutes after a push. Every `attavo drive` call here runs\\n56\\t# against this much shorter clock instead, read at call time from the\\n57\\t# same environment variables; test_drive_forge_poll_defaults_are_a_real_\\n58\\t# forges_clock is the one test that leaves them unset, to assert the\\n59\\t# defaults themselves. The interval is kept well above typical subprocess\\n60\\t# startup overhead so a zero-sleep stop and a polled one are easy to tell\\n61\\t# apart by wall clock alone.\\n62\\tFAST_POLL_ENV = {\\\"ATTAVO_DRIVE_POLL_BOUND_S\\\": \\\"0.9\\\", \\\"ATTAVO_DRIVE_POLL_INTERVAL_S\\\": \\\"0.5\\\",\\n63\\t                 \\\"ATTAVO_HEARTBEAT_S\\\": \\\"0.2\\\"}\\n64\\t\\n65\\t\\n66\\tdef run_attavo(root: Path, *args: str, env: dict[str, Any] | None = None) -> subprocess.CompletedProcess[str]:\\n67\\t    full_env = dict(os.environ)\\n68\\t    full_env.update(FAST_POLL_ENV)\\n69\\t    if env:\\n70\\t        full_env.update(env)\\n71\\t    return subprocess.run([sys.executable, str(ATTAVO), *args], cwd=str(root),\\n72\\t                          capture_output=True, text=True, check=False, env=full_env)\\n73\\t\\n74\\t\\n75\\tdef drive(root: Path, *args: str, env: dict[str, Any] | None = None) -> subprocess.CompletedProcess[str]:\\n76\\t    \\\"\\\"\\\"One pass, then wait for the worker it may have started (R2): the pass\\n77\\t    returns as soon as the marker is pushed and the stage runs detached, so\\n78\\t    a test that reads the record after \\\"drive\\\" waits for the report to stop\\n79\\t    saying running. The pass's own output is returned, with the worker's\\n80\\t    log appended, so assertions on the stage's lines still read them.\\\"\\\"\\\"\\n81\\t    run = run_attavo(root, \\\"drive\\\", *args, env=env)\\n82\\t    import re\\n83\\t    pids = [int(x) for x in re.findall(r\\\"worker pid (\\\\d+)\\\", run.stdout)]\\n84\\t    deadline = time.monotonic() + 90\\n85\\t    while pids and time.monotonic() < deadline:\\n86\\t        try:\\n87\\t            os.kill(pids[-1], 0)\\n88\\t        except ProcessLookupError:\\n89\\t            break\\n90\\t        time.sleep(0.2)\\n91\\t    logs = sorted(Path(git(root, \\\"rev-parse\\\", \\\"--absolute-git-dir\\\").strip(), \\\"attavo\\\").glob(\\\"*.worker.log\\\"))\\n92\\t    tail = \\\"\\\".join(p.read_text() for p in logs)\\n93\\t    return subprocess.CompletedProcess(run.args, run.returncode, run.stdout + tail, run.stderr)\\n94\\t\\n95\\t\\n96\\tdef attavo_module() -> Any:\\n97\\t    \\\"\\\"\\\"attavo.verify imported in-process, for the default-constant assertion\\n98\\t    below that a CLI invocation cannot provoke without actually waiting\\n99\\t    out the real clock.\\\"\\\"\\\"\\n100\\t    return importlib.import_module(\\\"attavo.verify\\\")\\n101\\t\\n102\\t\\n103\\tdef add_forge(root: Path, checks_command: str) -> None:\\n104\\t    toml = root / \\\"attavo.toml\\\"\\n105\\t    toml.write_text(toml.read_text() + f'\\\\n[forge]\\\\nchecks_command = \\\"{checks_command}\\\"\\\\n')\\n106\\t    commit_all(root, \\\"configure the forge read\\\")\\n107\\t\\n108\\t\\n109\\tdef approve_item(root: Path, item: str = \\\"1\\\") -> None:\\n110\\t    assert run_attavo(root, \\\"spec-gate\\\", item).returncode == 0\\n111\\t    assert run_attavo(root, \\\"approve\\\", item, \\\"--by\\\", \\\"alice\\\").returncode == 0\\n112\\t    if subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"remote\\\", \\\"get-url\\\", \\\"origin\\\"],\\n113\\t                      capture_output=True).returncode == 0:\\n114\\t        # The pass only fast-forwards the checkout and refuses commits\\n115\\t        # origin lacks, so what an operator committed is pushed like one.\\n116\\t        git(root, \\\"push\\\", \\\"-q\\\", \\\"origin\\\", f\\\"HEAD:{git(root, 'rev-parse', '--abbrev-ref', 'HEAD').strip()}\\\")\\n117\\t\\n118\\t\\n119\\tdef publish_approval(root: Path) -> None:\\n120\\t    \\\"\\\"\\\"The approval and spec records approve_item leaves untracked, committed\\n121\\t    and pushed the way an operator does, so a checkout can be read as\\n122\\t    clean.\\\"\\\"\\\"\\n123\\t    commit_all(root, \\\"the approval\\\")\\n124\\t    git(root, \\\"push\\\", \\\"-q\\\", \\\"origin\\\", f\\\"HEAD:{git(root, 'rev-parse', '--abbrev-ref', 'HEAD').strip()}\\\")\\n125\\t\\n126\\t\\n127\\tITEM_BRANCH = \\\"attavo/1-x\\\"\\n128\\t\\n129\\t\\n130\\tdef add_bare_remote(root: Path, tmp_path: Path) -> Path:\\n131\\t    \\\"\\\"\\\"A real (bare) remote named origin, seeded with the tenant's current\\n132\\t    state -- drive's own push target, distinct from the fake\\n133\\t    refs/remotes/origin/* helpers.init_repo sets up purely for verify's\\n134\\t    diff base.\\\"\\\"\\\"\\n135\\t    bare = tmp_path / \\\"origin.git\\\"\\n136\\t    subprocess.run([\\\"git\\\", \\\"init\\\", \\\"--quiet\\\", \\\"--bare\\\", \\\"-b\\\", \\\"main\\\", str(bare)], check=True)\\n137\\t    git(root, \\\"remote\\\", \\\"add\\\", \\\"origin\\\", str(bare))\\n138\\t    git(root, \\\"push\\\", \\\"origin\\\", \\\"HEAD:main\\\")\\n139\\t    # The item's own branch, checked out where the pass runs: a pass from\\n140\\t    # a tenant's checkout on main ensures ../attavo-worktree-N instead.\\n141\\t    if git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip() != ITEM_BRANCH:\\n142\\t        git(root, \\\"checkout\\\", \\\"-q\\\", \\\"-b\\\", ITEM_BRANCH)\\n143\\t    git(root, \\\"push\\\", \\\"-q\\\", \\\"origin\\\", f\\\"HEAD:{ITEM_BRANCH}\\\")\\n144\\t    return bare\\n145\\t\\n146\\t\\n147\\tdef records_dir(root: Path, item: str = \\\"1\\\") -> Path:\\n148\\t    return root / \\\"records\\\" / item\\n149\\t\\n150\\t\\n151\\tdef record_files(root: Path, stage: str, item: str = \\\"1\\\") -> list[Path]:\\n152\\t    return sorted(records_dir(root, item).glob(f\\\"{stage}-*.json\\\"))\\n153\\t\\n154\\t\\n155\\tdef latest_record(root: Path, stage: str, item: str = \\\"1\\\") -> dict[str, Any]:\\n156\\t    files = record_files(root, stage, item)\\n157\\t    assert files, f\\\"no {stage} record for item {item}\\\"\\n158\\t    return cast(dict[str, Any], json.loads(files[-1].read_text()))\\n159\\t\\n160\\t\\n161\\tdef head_of(root: Path) -> str:\\n162\\t    return git(root, \\\"rev-parse\\\", \\\"HEAD\\\").strip()\\n163\\t\\n164\\t\\n165\\tdef last_commit_paths(root: Path) -> list[str]:\\n166\\t    return git(root, \\\"diff\\\", \\\"--name-only\\\", \\\"HEAD^\\\", \\\"HEAD\\\").splitlines()\\n167\\t\\n168\\t\\n169\\tdef remote_head(bare: Path, branch: str = ITEM_BRANCH) -> str:\\n170\\t    return subprocess.run([\\\"git\\\", \\\"-C\\\", str(bare), \\\"rev-parse\\\", branch],\\n171\\t                          capture_output=True, text=True, check=True).stdout.strip()\\n172\\t\\n173\\t\\n174\\tdef add_drive_stall_bound(root: Path, seconds: int = 60) -> None:\\n175\\t    toml = root / \\\"attavo.toml\\\"\\n176\\t    toml.write_text(toml.read_text() + f'\\\\n[drive]\\\\nstall_after_s = {seconds}\\\\n')\\n177\\t    commit_all(root, \\\"declare the stall bound\\\")\\n178\\t\\n179\\t\\n180\\tdef _dead_pid() -> int:\\n181\\t    \\\"\\\"\\\"A pid guaranteed not to be running: a real child, spawned and\\n182\\t    reaped, on this host.\\\"\\\"\\\"\\n183\\t    proc = subprocess.Popen([sys.executable, \\\"-c\\\", \\\"pass\\\"])\\n184\\t    proc.wait()\\n185\\t    return proc.pid\\n186\\t\\n187\\t\\n188\\tdef write_dead_marker(root: Path, stage: str, nn: int, item: str = \\\"1\\\") -> Path:\\n189\\t    \\\"\\\"\\\"A <stage>-NN.started marker as a dead invocation would have left\\n190\\t    it, committed the way `attavo drive` itself commits one -- but never\\n191\\t    followed by its own record.\\\"\\\"\\\"\\n192\\t    d = records_dir(root, item)\\n193\\t    d.mkdir(parents=True, exist_ok=True)\\n194\\t    marker = d / f\\\"{stage}-{nn:02d}.started\\\"\\n195\\t    marker.write_text(json.dumps({\\n196\\t        \\\"at\\\": \\\"2026-09-17T13:16:08Z\\\", \\\"host\\\": socket.gethostname(), \\\"pid\\\": _dead_pid(),\\n197\\t        \\\"sha\\\": head_of(root), \\\"product_version\\\": \\\"fixture\\\"}))\\n198\\t    git(root, \\\"add\\\", str(marker.relative_to(root)))\\n199\\t    git(root, \\\"commit\\\", \\\"-q\\\", \\\"-m\\\", f\\\"invocation marker for item {item}\\\")\\n200\\t    return marker\\n201\\t\\n202\\t\\n203\\t\\n204\\tdef test_drive_pass_waits_on_an_absent_approval(tmp_path: Path) -> None:\\n205\\t    \\\"\\\"\\\"Acceptance row 6, as a level (R2): with no approval the pass says\\n206\\t    the item is waiting on the operator, exits 0 because a level is not a\\n207\\t    refusal, and runs nothing -- no spec-gate, no build, no records.\\\"\\\"\\\"\\n208\\t    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n209\\t    add_forge(root, GREEN_FORGE)\\n210\\t    add_bare_remote(root, tmp_path)\"}]},\"parent_tool_use_id\":null,\"session_id\":\"b3f717aa-5c2b-4867-b022-0f24cffb6427\",\"uuid\":\"583c24f8-6d08-4f59-bd77-ff377a70822d\",\"timestamp\":\"2026-09-30T23:05:55.082Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/davidbean/Projects/attavo-worktree-289/tests/test_drive.py\",\"content\":\"\\\"\\\"\\\"attavo drive: the mechanical transitions between approval and\\nready-to-merge (issue #84) -- under R2, one pass per invocation: read the\\nreport, act at most once (recover, start the build, start the review) in\\na detached worker, return. A level that belongs to a person is printed\\nand left. Every test uses the fixture\\nadapter and a fake `[forge].checks_command`; every record commit is\\n`git commit --only` and pushed to a real (bare) fixture remote.\\n\\nRegression tests, written and run red first: on `main` at 85f6f3b there\\nwas no `drive` subcommand, so every one of these failed with \\\"unknown\\nsubcommand\\\".\\n\\nRun: python3 -m pytest tests -q\\n\\\"\\\"\\\"\\nimport importlib\\nimport json\\nimport os\\nimport socket\\nimport queue\\nimport subprocess\\nimport sys\\nimport threading\\nimport time\\nfrom pathlib import Path\\nfrom typing import IO, Any, cast\\n\\nfrom helpers import commit_all as _commit_all\\nfrom helpers import git, make_tenant\\n\\nROOT = Path(__file__).resolve().parent.parent\\n\\n\\ndef commit_all(root: Path, message: str) -> None:\\n    \\\"\\\"\\\"helpers.commit_all, then the push an operator makes: the pass only\\n    fast-forwards the checkout and refuses commits origin lacks, so a\\n    fixture with a remote carries none.\\\"\\\"\\\"\\n    _commit_all(root, message)\\n    if subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"remote\\\", \\\"get-url\\\", \\\"origin\\\"],\\n                      capture_output=True).returncode == 0:\\n        git(root, \\\"push\\\", \\\"-q\\\", \\\"origin\\\", f\\\"HEAD:{git(root, 'rev-parse', '--abbrev-ref', 'HEAD').strip()}\\\")\\n\\n\\nATTAVO = ROOT / \\\"bin\\\" / \\\"attavo\\\"\\n\\nGREEN_FORGE = \\\"printf 'ci success\\\\\\\\n'\\\"\\n# A concluded conclusion -- checked and failing, not something still\\n# running. Distinct from UNCONCLUDED_FORGE below (issue #84): drive polls\\n# the one still running for the bound, but stops on the first read of a\\n# check that has already concluded, whether or not it passed.\\nRED_FORGE = \\\"printf 'ci failure\\\\\\\\n'\\\"\\nUNCONCLUDED_FORGE = \\\"printf 'ci in_progress\\\\\\\\n'\\\"\\n\\n# The real defaults (ATTAVO_DRIVE_POLL_BOUND_S=600, _INTERVAL_S=20) are a\\n# real forge's clock, not a test's -- tenant zero's own checks conclude\\n# about five minutes after a push. Every `attavo drive` call here runs\\n# against this much shorter clock instead, read at call time from the\\n# same environment variables; test_drive_forge_poll_defaults_are_a_real_\\n# forges_clock is the one test that leaves them unset, to assert the\\n# defaults themselves. The interval is kept well above typical subprocess\\n# startup overhead so a zero-sleep stop and a polled one are easy to tell\\n# apart by wall clock alone.\\nFAST_POLL_ENV = {\\\"ATTAVO_DRIVE_POLL_BOUND_S\\\": \\\"0.9\\\", \\\"ATTAVO_DRIVE_POLL_INTERVAL_S\\\": \\\"0.5\\\",\\n                 \\\"ATTAVO_HEARTBEAT_S\\\": \\\"0.2\\\"}\\n\\n\\ndef run_attavo(root: Path, *args: str, env: dict[str, Any] | None = None) -> subprocess.CompletedProcess[str]:\\n    full_env = dict(os.environ)\\n    full_env.update(FAST_POLL_ENV)\\n    if env:\\n        full_env.update(env)\\n    return subprocess.run([sys.executable, str(ATTAVO), *args], cwd=str(root),\\n                          capture_output=True, text=True, check=False, env=full_env)\\n\\n\\ndef drive(root: Path, *args: str, env: dict[str, Any] | None = None) -> subprocess.CompletedProcess[str]:\\n    \\\"\\\"\\\"One pass, then wait for the worker it may have started (R2): the pass\\n    returns as soon as the marker is pushed and the stage runs detached, so\\n    a test that reads the record after \\\"drive\\\" waits for the report to stop\\n    saying running. The pass's own output is returned, with the worker's\\n    log appended, so assertions on the stage's lines still read them.\\\"\\\"\\\"\\n    run = run_attavo(root, \\\"drive\\\", *args, env=env)\\n    import re\\n    pids = [int(x) for x in re.findall(r\\\"worker pid (\\\\d+)\\\", run.stdout)]\\n    deadline = time.monotonic() + 90\\n    while pids and time.monotonic() < deadline:\\n        try:\\n            os.kill(pids[-1], 0)\\n        except ProcessLookupError:\\n            break\\n        time.sleep(0.2)\\n    logs = sorted(Path(git(root, \\\"rev-parse\\\", \\\"--absolute-git-dir\\\").strip(), \\\"attavo\\\").glob(\\\"*.worker.log\\\"))\\n    tail = \\\"\\\".join(p.read_text() for p in logs)\\n    return subprocess.CompletedProcess(run.args, run.returncode, run.stdout + tail, run.stderr)\\n\\n\\ndef attavo_module() -> Any:\\n    \\\"\\\"\\\"attavo.verify imported in-process, for the default-constant assertion\\n    below that a CLI invocation cannot provoke without actually waiting\\n    out the real clock.\\\"\\\"\\\"\\n    return importlib.import_module(\\\"attavo.verify\\\")\\n\\n\\ndef add_forge(root: Path, checks_command: str) -> None:\\n    toml = root / \\\"attavo.toml\\\"\\n    toml.write_text(toml.read_text() + f'\\\\n[forge]\\\\nchecks_command = \\\"{checks_command}\\\"\\\\n')\\n    commit_all(root, \\\"configure the forge read\\\")\\n\\n\\ndef approve_item(root: Path, item: str = \\\"1\\\") -> None:\\n    assert run_attavo(root, \\\"spec-gate\\\", item).returncode == 0\\n    assert run_attavo(root, \\\"approve\\\", item, \\\"--by\\\", \\\"alice\\\").returncode == 0\\n    if subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"remote\\\", \\\"get-url\\\", \\\"origin\\\"],\\n                      capture_output=True).returncode == 0:\\n        # The pass only fast-forwards the checkout and refuses commits\\n        # origin lacks, so what an operator committed is pushed like one.\\n        git(root, \\\"push\\\", \\\"-q\\\", \\\"origin\\\", f\\\"HEAD:{git(root, 'rev-parse', '--abbrev-ref', 'HEAD').strip()}\\\")\\n\\n\\ndef publish_approval(root: Path) -> None:\\n    \\\"\\\"\\\"The approval and spec records approve_item leaves untracked, committed\\n    and pushed the way an operator does, so a checkout can be read as\\n    clean.\\\"\\\"\\\"\\n    commit_all(root, \\\"the approval\\\")\\n    git(root, \\\"push\\\", \\\"-q\\\", \\\"origin\\\", f\\\"HEAD:{git(root, 'rev-parse', '--abbrev-ref', 'HEAD').strip()}\\\")\\n\\n\\nITEM_BRANCH = \\\"attavo/1-x\\\"\\n\\n\\ndef add_bare_remote(root: Path, tmp_path: Path) -> Path:\\n    \\\"\\\"\\\"A real (bare) remote named origin, seeded with the tenant's current\\n    state -- drive's own push target, distinct from the fake\\n    refs/remotes/origin/* helpers.init_repo sets up purely for verify's\\n    diff base.\\\"\\\"\\\"\\n    bare = tmp_path / \\\"origin.git\\\"\\n    subprocess.run([\\\"git\\\", \\\"init\\\", \\\"--quiet\\\", \\\"--bare\\\", \\\"-b\\\", \\\"main\\\", str(bare)], check=True)\\n    git(root, \\\"remote\\\", \\\"add\\\", \\\"origin\\\", str(bare))\\n    git(root, \\\"push\\\", \\\"origin\\\", \\\"HEAD:main\\\")\\n    # The item's own branch, checked out where the pass runs: a pass from\\n    # a tenant's checkout on main ensures ../attavo-worktree-N instead.\\n    if git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip() != ITEM_BRANCH:\\n        git(root, \\\"checkout\\\", \\\"-q\\\", \\\"-b\\\", ITEM_BRANCH)\\n    git(root, \\\"push\\\", \\\"-q\\\", \\\"origin\\\", f\\\"HEAD:{ITEM_BRANCH}\\\")\\n    return bare\\n\\n\\ndef records_dir(root: Path, item: str = \\\"1\\\") -> Path:\\n    return root / \\\"records\\\" / item\\n\\n\\ndef record_files(root: Path, stage: str, item: str = \\\"1\\\") -> list[Path]:\\n    return sorted(records_dir(root, item).glob(f\\\"{stage}-*.json\\\"))\\n\\n\\ndef latest_record(root: Path, stage: str, item: str = \\\"1\\\") -> dict[str, Any]:\\n    files = record_files(root, stage, item)\\n    assert files, f\\\"no {stage} record for item {item}\\\"\\n    return cast(dict[str, Any], json.loads(files[-1].read_text()))\\n\\n\\ndef head_of(root: Path) -> str:\\n    return git(root, \\\"rev-parse\\\", \\\"HEAD\\\").strip()\\n\\n\\ndef last_commit_paths(root: Path) -> list[str]:\\n    return git(root, \\\"diff\\\", \\\"--name-only\\\", \\\"HEAD^\\\", \\\"HEAD\\\").splitlines()\\n\\n\\ndef remote_head(bare: Path, branch: str = ITEM_BRANCH) -> str:\\n    return subprocess.run([\\\"git\\\", \\\"-C\\\", str(bare), \\\"rev-parse\\\", branch],\\n                          capture_output=True, text=True, check=True).stdout.strip()\\n\\n\\ndef add_drive_stall_bound(root: Path, seconds: int = 60) -> None:\\n    toml = root / \\\"attavo.toml\\\"\\n    toml.write_text(toml.read_text() + f'\\\\n[drive]\\\\nstall_after_s = {seconds}\\\\n')\\n    commit_all(root, \\\"declare the stall bound\\\")\\n\\n\\ndef _dead_pid() -> int:\\n    \\\"\\\"\\\"A pid guaranteed not to be running: a real child, spawned and\\n    reaped, on this host.\\\"\\\"\\\"\\n    proc = subprocess.Popen([sys.executable, \\\"-c\\\", \\\"pass\\\"])\\n    proc.wait()\\n    return proc.pid\\n\\n\\ndef write_dead_marker(root: Path, stage: str, nn: int, item: str = \\\"1\\\") -> Path:\\n    \\\"\\\"\\\"A <stage>-NN.started marker as a dead invocation would have left\\n    it, committed the way `attavo drive` itself commits one -- but never\\n    followed by its own record.\\\"\\\"\\\"\\n    d = records_dir(root, item)\\n    d.mkdir(parents=True, exist_ok=True)\\n    marker = d / f\\\"{stage}-{nn:02d}.started\\\"\\n    marker.write_text(json.dumps({\\n        \\\"at\\\": \\\"2026-09-17T13:16:08Z\\\", \\\"host\\\": socket.gethostname(), \\\"pid\\\": _dead_pid(),\\n        \\\"sha\\\": head_of(root), \\\"product_version\\\": \\\"fixture\\\"}))\\n    git(root, \\\"add\\\", str(marker.relative_to(root)))\\n    git(root, \\\"commit\\\", \\\"-q\\\", \\\"-m\\\", f\\\"invocation marker for item {item}\\\")\\n    return marker\\n\\n\\n\\ndef test_drive_pass_waits_on_an_absent_approval(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Acceptance row 6, as a level (R2): with no approval the pass says\\n    the item is waiting on the operator, exits 0 because a level is not a\\n    refusal, and runs nothing -- no spec-gate, no build, no records.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    add_bare_remote(root, tmp_path)\",\"numLines\":210,\"startLine\":1,\"totalLines\":1378}}}\n{\"type\":\"system\",\"subtype\":\"thinking_tokens\",\"estimated_tokens\":50,\"estimated_tokens_delta\":50,\"session_id\"
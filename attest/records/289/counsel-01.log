-x\\\"], capture_output=True, text=True).stdout\\n    assert log.count(\\\"build invocation 01 started\\\") == 1, log\\n    wait_for(lambda: \\\"build record for item 1\\\" in subprocess.run(\\n        [\\\"git\\\", \\\"-C\\\", str(bare), \\\"log\\\", \\\"--format=%s\\\", \\\"attavo/1-x\\\"], capture_output=True, text=True).stdout)\\n\\n\\ndef test_a_second_checkout_on_this_host_reads_the_first_ones_worker_as_running(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"The race made deterministic (#289): two checkouts of one tenant on\\n    one host is ordinary now, since the product owns each item's own\\n    working copy. Run the second's pass only after the first's marker has\\n    already landed -- no race for the lease at all -- and it must still\\n    read the first's heartbeat where its marker says to look, see it\\n    running, start nothing, and push no second invocation.\\\"\\\"\\\"\\n    root, bare = built_tenant(tmp_path, seconds=3)\\n    publish_approval(root)\\n    clone = tmp_path / \\\"second\\\"\\n    git(root.parent, \\\"clone\\\", \\\"-q\\\", \\\"-b\\\", git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip(),\\n        str(bare), str(clone))\\n    git(clone, \\\"config\\\", \\\"user.email\\\", \\\"test@example.com\\\")\\n    git(clone, \\\"config\\\", \\\"user.name\\\", \\\"Attavo Test\\\")\\n    git(clone, \\\"remote\\\", \\\"set-head\\\", \\\"origin\\\", \\\"-a\\\")\\n\\n    first = run_attavo(root, \\\"drive\\\", \\\"1\\\", env=FAST)\\n    assert \\\"Build started\\\" in first.stdout, first.stdout + first.stderr\\n\\n    second = run_attavo(clone, \\\"drive\\\", \\\"1\\\", env=FAST)\\n    assert second.returncode == 0, second.stdout + second.stderr\\n    assert \\\"Build started\\\" not in second.stdout, second.stdout\\n    assert \\\"another pass holds\\\" not in second.stdout, second.stdout\\n    assert \\\"running\\\" in second.stdout.lower(), second.stdout\\n\\n    log = subprocess.run([\\\"git\\\", \\\"-C\\\", str(bare), \\\"log\\\
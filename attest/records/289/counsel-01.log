{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/zsh -lc \"sed -n '165,265p' /Users/davidbean/Projects/attest/attavo/drive.py; sed -n '350,420p' /Users/davidbean/Projects/attest/attavo/build.py\"","aggregated_output":"        contained = subprocess.run([\"git\", \"-C\", str(root), \"merge-base\", \"--is-ancestor\", target, \"HEAD\"],\n                                   capture_output=True, text=True, check=False)\n        if contained.returncode == 0:\n            return\n        time.sleep(0.1)\n    raise TransportRefused(f\"the checkout could not fast-forward to {target[:12]}: {err}\")\n\n\ndef _stage_copies(root: Path, paths: list[str]) -> None:\n    \"\"\"Stage the checkout's own untracked copies of records the driver\n    has just committed elsewhere, so the fast-forward that brings the\n    committed ones in finds them identical to the target and has nothing\n    to collide with -- and the record is never absent from the checkout,\n    which is what a pass or a reader beside the worker sees.\"\"\"\n    if not paths:\n        return\n    out = git(root, \"ls-files\", \"--others\", \"--exclude-standard\", \"--\", *paths).splitlines()\n    if out:\n        git(root, \"add\", \"--\", *out)\n\n\ndef transport_records(root: Path, branch: str, message: str,\n                      write: Callable[[Path], list[Path]],\n                      lease: bool = False) -> tuple[str, str | None]:\n    \"\"\"Commit records in a detached worktree of the branch's tip and push\n    them from there as HEAD:branch; then fast-forward the checkout.\n    `write(tree)` puts the records in the worktree and returns the record\n    paths to commit -- called again on every try, since a retry starts\n    from a freshly fetched tip.\n\n    The first try commits on this checkout's HEAD, which carries the\n    stage's own commits. A push origin rejects is retried without a\n    merge: fetch, recreate the worktree at the new tip (which must\n    contain HEAD, see _retry_base), write again, push again as a\n    fast-forward, RECORD_PUSH_TRIES times at most. The record's own `sha` names the\n    stage's commit, not this transport commit, so moving the transport\n    commit changes nothing a record names.\n\n    lease=True is the marker's push (ruling A): one try, and a race lost\n    is (\"lost-race\", stderr) with the worktree discarded and the checkout\n    untouched. Otherwise (\"pushed\", None), or (\"refused\", reason).\"\"\"\n    err = \"\"\n    base = git(root, \"rev-parse\", \"HEAD\").strip()\n    for attempt in range(1 if lease else RECORD_PUSH_TRIES):\n        if attempt:\n            try:\n                base = _retry_base(root, branch)\n            except TransportRefused as exc:\n                return \"refused\", str(exc)\n            except RuntimeError as exc:\n                return \"refused\", f\"could not read origin's {branch}: {exc}\"\n        with record_worktree(root, base) as tree:\n            paths = write(tree)\n            try:\n                sha = commit_record(tree, paths, message)\n            except RuntimeError as exc:\n                return \"refused\", f\"could not commit: {exc}\"\n            if has_origin(root):\n                run = subprocess.run([\"git\", \"-C\", str(tree), \"push\", \"origin\", f\"HEAD:{branch}\"],\n                                     capture_output=True, text=True, check=False)\n                if run.returncode != 0:\n                    err = run.stderr.strip()\n                    if lease:\n                        raced = any(marker in run.stderr for marker in _RACE_MARKERS)\n                        return (\"lost-race\" if raced else \"refused\"), err\n                    continue\n            try:\n                _stage_copies(root, _record_paths(tree, paths))\n                sync_checkout(root, sha)\n            except (RuntimeError, TransportRefused) as exc:\n                return \"refused\", str(exc)\n            return \"pushed\", None\n    return \"refused\", f\"push rejected {RECORD_PUSH_TRIES} times: {err}\"\n\n\n_RACE_MARKERS = (\"non-fast-forward\", \"fetch first\", \"stale info\", \"cannot lock ref\",\n                 \"failed to update ref\")\n\n\ndef has_origin(root: Path) -> bool:\n    \"\"\"Whether this checkout carries an origin remote at all -- a fixture\n    or a scratch checkout with none is not a refusal; a pass commits\n    locally and skips the push, the way recovery always has.\"\"\"\n    try:\n        git(root, \"remote\", \"get-url\", \"origin\")\n        return True\n    except RuntimeError:\n        return False\n\n\ndef drive_state(root: Path, m: dict[str, Any], item_id: str) -> tuple[str, str | None, Path]:\n    \"\"\"(\"no-approval\" | \"build\" | \"verify\" | \"ready\", detail, records_dir):\n    the next mechanical step for item_id, read from its latest records\n    alone. A build only counts as current when it is a pass bound to the\n    valid approval's own sha; a verify only counts as current when it is a\n    pass bound to that build's own sha -- the same staleness a re-approval\n    or a re-build must force, attest's own chain check already enforces\n    (check_attest_chain), read here rather than re-typed.\"\"\"\n    records_rel = m[\"paths\"][\"records\"]\n    records_dir = root / records_rel / item_id\n\n\n    tests_cfg = m.get(\"tests\") or {}\n    if not tests_cfg.get(\"select\") or not tests_cfg.get(\"run\"):\n        print(\"attavo build: refused: no [tests] table in the manifest \"\n              \"([tests].select and [tests].run are both required)\")\n        return 1\n\n    if (m.get(\"checks\") or {}).get(\"probe\") and not (m.get(\"checks\") or {}).get(\"probe_timeout_s\"):\n        print(\"attavo build: refused: [checks].probe is declared without \"\n              \"[checks].probe_timeout_s (a probe with no bound is not asked)\")\n        return 1\n\n    try:\n        status = approval_status(root, m, item_id)\n    except ShallowCheckoutError as exc:\n        print(f\"attavo build: refused: {exc}\", file=sys.stderr)\n        return 2\n    if status != \"valid\":\n        print(f\"attavo build: refused: approval is {status}\")\n        return 1\n\n    adapter_path = resolve_adapter(root, adapter_name)\n    if adapter_path is None:\n        print(f\"attavo build: refused: no adapter named {adapter_name!r}\")\n        return 1\n\n    specs_rel = m[\"paths\"][\"specs\"]\n    records_rel = m[\"paths\"][\"records\"]\n    spec_dir = root / specs_rel / item_id\n    item_records_dir = root / records_rel / item_id\n    spec_sha = last_commit_touching(root, str(Path(specs_rel) / item_id))\n    latest_approval = latest_record(item_records_dir, \"approval\")\n    approval_sha = latest_approval.get(\"sha\") if latest_approval else None\n    # approval_status already refused above unless status is \"valid\", which\n    # only holds when latest_approval exists and names a sha (attavo/approval.py).\n    assert approval_sha is not None, \"approval status valid implies a latest approval sha\"\n    parsed, _ = parse_spec(spec_dir / \"spec.md\")\n    claims = parsed[\"claims\"] if parsed else []\n    criteria_names = parsed[\"criteria\"] if parsed else []\n    adapter_config = merge_adapter_config(m, adapter_name, \"build\")\n    checks_cfg = m.get(\"checks\") or {}\n    checks_command = checks_cfg.get(\"command\")\n    probe = checks_cfg.get(\"probe\")\n    probe_timeout_s = checks_cfg.get(\"probe_timeout_s\")\n    identity = executor_identity(adapter_name)\n    reports = adapter_reports(adapter_path)\n\n    start_sha = git(root, \"rev-parse\", \"HEAD\").strip()\n    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n    started = time.monotonic()\n\n    events_path = stage_events_dir(root) / f\"build-{next_attempt_number(item_records_dir, 'build'):02d}.events.jsonl\"\n\n    # Issue #115, then issue #212: whether this machine can run the tenant's\n    # checks at all is asked once here, on the approved tree, before the\n    # adapter is ever invoked -- a missing import at test collection (item\n    # #106's build-01) is not a failing check, and no build could have\n    # passed against it. A tenant that declares [checks].probe is asked by\n    # the probe, inside [checks].probe_timeout_s: exit 0 yes, anything else\n    # or the bound no. A tenant that does not is asked the old way, by\n    # running [checks].command whole -- exit 2 no, exit 0 or 1 (the checks\n    # ran and passed or failed, the expected states before a build) yes --\n    # which is the run #194's build-01 spent 215 s on. Either way the feed\n    # says what is being asked and what the answer was.\n    if checks_command:\n        append_event(events_path, \"gate\", \"checking this machine can run the checks\")\n        asked = checks_command\n        if probe:\n            asked = probe\n            code, out, err, timed_out = run_bounded(probe, root, \"\", probe_timeout_s)\n            refusal_text = (f\"[checks].probe did not finish within {probe_timeout_s} s\" if timed_out\n","exit_code":0,"status":"completed"}}

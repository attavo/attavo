{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/zsh -lc \"sed -n '205,300p' /Users/davidbean/Projects/attest/adapters/claude-code/run; rg -n '\"'^def '\"' /Users/davidbean/Projects/attest/adapters/claude-code/run | head -35\"","aggregated_output":"    named in the instruction instead of inlining the file's own text, so\n    the instruction stays a small fixed size whatever the file's size\n    (issue #86: a 27,367-line deletion diff inlined whole exceeded a\n    judge's input ceiling -- codex's, on the specimen that surfaced it).\n    Files touched counts unified-diff file headers (`diff --git a/...\n    b/...`), the shape `git diff` produces.\"\"\"\n    size = Path(path).stat().st_size\n    lines = text.count(\"\\n\") + (1 if text and not text.endswith(\"\\n\") else 0)\n    if not diff_like:\n        return f\"`{path}` ({size} bytes, {lines} lines)\"\n    files = sum(1 for l in text.splitlines() if l.startswith(\"diff --git \"))\n    return f\"`{path}` ({size} bytes, {lines} lines, {files} files touched)\"\n\n\ndef spec_sections() -> list[str]:\n    \"\"\"The spec's Problem, Claims, and Criteria sections verbatim -- what\n    both build and verify need to see, in the shape the spec contract\n    (not this adapter) already gives them.\"\"\"\n    spec_dir = Path(os.environ[\"ATTAVO_SPEC_DIR\"])\n    lines = (spec_dir / \"spec.md\").read_text().splitlines()\n    idx = [i for i, l in enumerate(lines) if l.startswith(\"## \")]\n    headings = {lines[i].strip(): i for i in idx}\n    bounds = sorted(idx) + [len(lines)]\n\n    def section(heading: str) -> str:\n        start = headings[heading]\n        end = bounds[bounds.index(start) + 1] if start in bounds else len(lines)\n        return \"\\n\".join(lines[start:end]).strip()\n\n    return [section(\"## Problem\"), section(\"## Claims\"), section(\"## Criteria\")]\n\n\ndef stub_note() -> str | None:\n    \"\"\"None when ATTAVO_SPEC_DIR carries no stub/; else the sentence\n    naming what a stub is (issue #90, closed by #93). The stub is\n    evidence -- a criterion it satisfies trivially is weak -- but twice\n    the judge reported\n    a built tree as failing to match its stub as if the stub were the\n    intended change (tenant zero #664, #644): one sentence of vocabulary\n    was missing, not a smarter judge or a dropped stub.\"\"\"\n    stub_dir = Path(os.environ[\"ATTAVO_SPEC_DIR\"]) / \"stub\"\n    if not stub_dir.is_dir():\n        return None\n    return (\n        f\"## The stub at `{stub_dir}`\\n\\n\"\n        \"The stub is the fixture the acceptance criteria were shown to \"\n        \"pass against; it is not the intended change. A difference \"\n        \"between the built tree and the stub is not a finding: a \"\n        \"criterion the stub satisfies trivially is.\")\n\n\ndef build_instruction() -> str:\n    parts = list(spec_sections())\n\n    rulings = read_text(\"ATTAVO_RULINGS\")\n    if rulings.strip():\n        parts.append(\"## Rulings\\n\\n\" + rulings.strip())\n\n    feedback_path = os.environ.get(\"ATTAVO_FEEDBACK\")\n    feedback = read_text(\"ATTAVO_FEEDBACK\")\n    if feedback.strip():\n        parts.append(\n            \"## Feedback from the previous attempt\\n\\n\"\n            f\"The feedback is at {describe_file(feedback_path, feedback, diff_like=False)}. \"\n            \"It is not inlined here: read it yourself with your own tools \"\n            \"before continuing.\")\n\n    parts.append(\n        \"commit your work on the current branch; if you cannot proceed \"\n        \"without a decision that changes the criteria, do not guess: \"\n        \"answer with status question\")\n\n    test_command = os.environ.get(\"ATTAVO_TEST_COMMAND\")\n    if test_command:\n        bound = os.environ.get(\"ATTAVO_TEST_TIMEOUT_S\")\n        parts.append(\n            f\"to run tests while you work, run `{test_command}`: it runs the tests \"\n            \"selected for the files you have changed\"\n            + (f\" and stops at {bound} s\" if bound else \"\")\n            + \". Run a single test with `\" + test_command + \" <path or test id>`. \"\n            \"Do not run the test runner directly, the whole test suite, or any \"\n            \"whole-tree check yourself: when the criteria and \" + \"`\" + test_command + \"`\"\n            + \" pass, commit and stop; the gates are run for you and any failure is \"\n            \"returned to you on the next iteration\")\n\n    return \"\\n\\n\".join(parts)\n\n\ndef verify_instruction() -> str:\n    parts = list(spec_sections())\n\n    note = stub_note()\n    if note:\n        parts.append(note)\n\n    diff_path = os.environ.get(\"ATTAVO_DIFF\")\n195:def read_text(path_env: str) -> str:\n203:def describe_file(path: str, text: str, diff_like: bool) -> str:\n219:def spec_sections() -> list[str]:\n237:def stub_note() -> str | None:\n256:def build_instruction() -> str:\n293:def verify_instruction() -> str:\n341:def counsel_instruction() -> str:\n475:def claimed_paths() -> list[str]:\n497:def claim_rule(claim: str) -> str:\n503:def build_allowed_tools() -> list[str]:\n535:def load_config() -> dict:\n540:def refused_config_key(config: dict) -> str | None:\n561:def input_limit_chars() -> int:\n570:def ceiling_refusal(instruction: str) -> str | None:\n585:def sandbox_settings(stage: str, working_directory: Path) -> dict:\n611:def foreground_env() -> dict[str, str]:\n625:def build_command(instruction: str, config: dict, schema: dict, stage: str) -> list[str]:\n658:def derive_model(response: dict, requested_model: str | None) -> tuple[str | None, str | None]:\n702:def adapter_version() -> str:\n719:def question_class(status: str, question: str | None) -> str:\n746:def transient_detail(response: dict) -> str | None:\n766:def auth_failure(raw: str) -> str | None:\n780:def subagent_refusal(response: dict) -> str | None:\n800:def load_canned_responses() -> list[dict] | None:\n820:def load_canned_stream() -> list[str] | None:\n833:def parse_strea
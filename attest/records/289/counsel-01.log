_where_the_marker_says(tmp_path: Path) -> None:\\n265:def test_the_marker_a_pass_writes_names_its_checkouts_own_directory(tmp_path: Path) -> None:\",\"is_error\":false}]},\"parent_tool_use_id\":null,\"session_id\":\"b3f717aa-5c2b-4867-b022-0f24cffb6427\",\"uuid\":\"2278c194-fe09-4837-8cc9-70f768c0a859\",\"timestamp\":\"2026-09-30T23:13:25.029Z\",\"tool_use_result\":{\"stdout\":\"192:def test_a_second_checkouts_pass_after_the_first_has_started_reads_running(tmp_path: Path) -> None:\\n225:def test_the_heartbeat_is_read_where_the_marker_says(tmp_path: Path) -> None:\\n265:def test_the_marker_a_pass_writes_names_its_checkouts_own_directory(tmp_path: Path) -> None:\",\"stderr\":\"\",\"interrupted\":false,\"isImage\":false,\"noOutputExpected\":false}}\n{\"type\":\"assistant\",\"message\":{\"model\":\"claude-sonnet-5\",\"id\":\"msg_011CfaUL7U7fuZXNvwyhALM8\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_01UX8cTgirGwNoLYWZm3TMGV\",\"name\":\"Edit\",\"input\":{\"replace_all\":false,\"file_path\":\"/Users/davidbean/Projects/attavo-worktree-289/tests/test_pass.py\",\"old_string\":\"def test_a_second_checkouts_pass_after_the_first_has_started_reads_running(tmp_path: Path) -> None:\",\"new_string\":\"def test_a_second_checkout_on_this_host_reads_the_first_ones_worker_as_running(tmp_path: Path) -> None:\"},\"caller\":{\"type\":\"direct\"}}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":485,\"cache_read_input_tokens\":156602,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":485},\"output_tokens\":16,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"b3f717aa-5c2b-4867-b022-0f24cffb6427\",\"uuid\":\"49b445c3-e856-44ef-8989-97ad6a066428\",\"timestamp\":\"2026-09-30T23:13:27.420Z\",\"request_id\":\"req_011CfaUL781uVz6TGisy6mHf\",\"wire_tool_inputs\":{\"toolu_01UX8cTgirGwNoLYWZm3TMGV\":{\"file_path\":\"/Users/davidbean/Projects/attavo-worktree-289/tests/test_pass.py\",\"old_string\":\"def test_a_second_checkouts_pass_after_the_first_has_started_reads_running(tmp_path: Path) -> None:\",\"new_string\":\"def test_a_second_checkout_on_this_host_reads_the_first_ones_worker_as_running(tmp_path: Path) -> None:\"}}}\n{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01UX8cTgirGwNoLYWZm3TMGV\",\"type\":\"tool_result\",\"content\":\"The file /Users/davidbean/Projects/attavo-worktree-289/tests/test_pass.py has been updated successfully. (note: the file had been modified on disk since you last read it — the edit applied cleanly, but the file contains other changes not in your context. Read it before edits that depend on surrounding content.)\"}]},\"parent_tool_use_id\":null,\"session_id\":\"b3f717aa-5c2b-4867-b022-0f24cffb6427\",\"uuid\":\"2fa4356b-81e8-4dd7-bda3-1242722deb16\",\"timestamp\":\"2026-09-30T23:13:27.442Z\",\"tool_use_result\":{\"filePath\":\"/Users/davidbean/Projects/attavo-worktree-289/tests/test_pass.py\",\"oldString\":\"def test_a_second_checkouts_pass_after_the_first_has_started_reads_running(tmp_path: Path) -> None:\",\"newString\":\"def test_a_second_checkout_on_this_host_reads_the_first_ones_worker_as_running(tmp_path: Path) -> None:\",\"originalFile\":\"\\\"\\\"\\\"The reconciler's R2 (claude/reconciler-brief-2026-09-20.md, rulings A, B,\\nH): `attavo drive N` is one short pass that reads the report, acts at most\\nonce, and returns; a stage runs in a detached worker with its own\\nheartbeat; the marker's push is the lease; recovery is the pass's; the\\nreview takes the checks the pass read on the pre-marker head.\\n\\nRun: python3 -m pytest tests -q\\n\\\"\\\"\\\"\\nfrom __future__ import annotations\\n\\nimport json\\nimport os\\nimport socket\\nimport subprocess\\nimport sys\\nimport time\\nfrom pathlib import Path\\nfrom typing import Any\\n\\nfrom helpers import commit_all, git, make_tenant\\nfrom test_drive import (\\n    GREEN_FORGE,\\n    add_bare_remote,\\n    add_drive_stall_bound,\\n    add_forge,\\n    approve_item,\\n    head_of,\\n    publish_approval,\\n    latest_record,\\n    record_files,\\n    records_dir,\\n    remote_head,\\n    run_attavo,\\n    write_dead_marker,\\n)\\n\\nROOT = Path(__file__).resolve().parent.parent\\nFAST = {\\\"ATTAVO_HEARTBEAT_S\\\": \\\"0.2\\\", \\\"ATTAVO_DRIVE_POLL_INTERVAL_S\\\": \\\"0.5\\\"}\\n\\n\\ndef slow_adapter(root: Path, seconds: float) -> None:\\n    \\\"\\\"\\\"A tenant-side build adapter: the product's own fixture adapter,\\n    after `seconds` of sleep on the build stage.\\\"\\\"\\\"\\n    d = root / \\\"attavo\\\" / \\\"adapters\\\" / \\\"fixture\\\"\\n    d.mkdir(parents=True, exist_ok=True)\\n    run = d / \\\"run\\\"\\n    run.write_text(f'#!/bin/sh\\\\nif [ \\\"${{ATTAVO_STAGE:-build}}\\\" = build ]; then sleep {seconds}; fi\\\\n'\\n                   f'exec sh {ROOT / \\\"adapters\\\" / \\\"fixture\\\" / \\\"run\\\"}\\\\n')\\n    run.chmod(0o755)\\n    commit_all(root, \\\"a slow tenant-side adapter\\\")\\n\\n\\ndef git_dir(root: Path) -> Path:\\n    return Path(git(root, \\\"rev-parse\\\", \\\"--absolute-git-dir\\\").strip())\\n\\n\\ndef report(root: Path, env: dict[str, str] | None = None) -> dict[str, Any]:\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\", \\\"--report\\\", env={**FAST, **(env or {})})\\n    assert run.returncode == 0, run.stdout + run.stderr\\n    out: dict[str, Any] = json.loads(run.stdout)\\n    return out\\n\\n\\ndef pushed(bare: Path, subject: str) -> bool:\\n    log = subprocess.run([\\\"git\\\", \\\"-C\\\", str(bare), \\\"log\\\", \\\"--format=%s\\\", \\\"attavo/1-x\\\"], capture_output=True, text=True).stdout\\n    return subject in log\\n\\n\\ndef wait_for(pred: Any, seconds: float = 20) -> None:\\n    deadline = time.monotonic() + seconds\\n    while time.monotonic() < deadline:\\n        if pred():\\n            return\\n        time.sleep(0.2)\\n    raise AssertionError(\\\"condition not met in time\\\")\\n\\n\\ndef passes_until(root: Path, pred: Any, seconds: float = 40, env: dict[str, str] | None = None) -> None:\\n    \\\"\\\"\\\"Passes, spaced, until pred holds: how an operator's loop, the\\n    screen's poll, or a scheduler line would drive the item.\\\"\\\"\\\"\\n    deadline = time.monotonic() + seconds\\n    full = dict(FAST)\\n    full.update(env or {})\\n    while time.monotonic() < deadline:\\n        run_attavo(root, \\\"drive\\\", \\\"1\\\", env=full)\\n        if pred():\\n            return\\n        time.sleep(0.5)\\n    raise AssertionError(\\\"condition not met in time\\\")\\n\\n\\ndef clock_ahead(tmp_path: Path, seconds: float) -> dict[str, str]:\\n    \\\"\\\"\\\"The environment that puts every bound the product judges `seconds`\\n    past the machine's now (#257): a clock file, named by ATTAVO_CLOCK_FILE,\\n    that the next pass reads instead of waiting.\\\"\\\"\\\"\\n    path = tmp_path / \\\"attavo-clock\\\"\\n    path.write_text(str(time.time() + seconds))\\n    return {\\\"ATTAVO_CLOCK_FILE\\\": str(path)}\\n\\n\\ndef built_tenant(tmp_path: Path, seconds: float = 3) -> tuple[Path, Path]:\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    add_drive_stall_bound(root)\\n    slow_adapter(root, seconds)\\n    bare = add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n    return root, bare\\n\\n\\ndef test_a_pass_returns_while_the_worker_runs_and_the_worker_outlives_it(tmp_path: Path) -> None:\\n    root, bare = built_tenant(tmp_path, seconds=3)\\n    started = time.monotonic()\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\", env=FAST)\\n    elapsed = time.monotonic() - started\\n    assert run.returncode == 0, run.stdout + run.stderr\\n    assert elapsed < 2.5, f\\\"the pass took {elapsed:.1f}s: it waited for the stage\\\"\\n    assert \\\"Build started\\\" in run.stdout, run.stdout\\n    assert (records_dir(root) / \\\"build-01.started\\\").exists()\\n    assert remote_head(bare) == head_of(root), \\\"the marker was not pushed before the pass returned\\\"\\n    assert record_files(root, \\\"build\\\") == [], \\\"the record existed before the worker could have written it\\\"\\n    wait_for(lambda: record_files(root, \\\"build\\\") != [])\\n    wait_for(lambda: remote_head(bare) == head_of(root))\\n    assert latest_record(root, \\\"build\\\")[\\\"status\\\"] == \\\"pass\\\"\\n\\n\\ndef test_the_worker_touches_its_heartbeat_and_the_report_reads_running_by_it(tmp_path: Path) -> None:\\n    root, _ = built_tenant(tmp_path, seconds=3)\\n    assert run_attavo(root, \\\"drive\\\", \\\"1\\\", env=FAST).returncode == 0\\n    beat = git_dir(root) / \\\"attavo\\\" / \\\"build-01.heartbeat\\\"\\n    wait_for(beat.exists, 5)\\n    first = beat.stat().st_mtime\\n    time.sleep(0.6)\\n    assert beat.stat().st_mtime > first, \\\"the heartbeat did not move\\\"\\n    r = report(root)\\n    assert (r[\\\"state\\\"], r[\\\"kind\\\"]) == (\\\"running\\\", \\\"waits\\\"), r\\n    wait_for(lambda: record_files(root, \\\"build\\\") != [])\\n\\n\\ndef test_a_stale_heartbeat_reads_died_though_the_pid_lives_and_a_fresh_one_reads_alive(tmp_path: Path) -> None:\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    git(root, \\\"checkout\\\", \\\"-q\\\", \\\"-b\\\", \\\"attavo/1-x\\\")\\n    add_forge(root, GREEN_FORGE)\\n    add_drive_stall_bound(root, 600)\\n    approve_item(root)\\n    d = records_dir(root)\\n    d.mkdir(parents=True, exist_ok=True)\\n    marker = d / \\\"build-01.started\\\"\\n    now = time.strftime(\\\"%Y-%m-%dT%H:%M:%SZ\\\", time.gmtime())\\n    marker.write_text(json.dumps({\\\"at\\\": now, \\\"host\\\": socket.gethostname(),\\n                                  \\\"pid\\\": os.getpid(), \\\"sha\\\": head_of(root), \\\"product_version\\\": \\\"fixture\\\"}))\\n    commit_all(root, \\\"a marker whose pid is this test\\\")\\n    beat = git_dir(root) / \\\"attavo\\\" / \\\"build-01.heartbeat\\\"\\n    beat.parent.mkdir(parents=True, exist_ok=True)\\n    beat.touch()\\n    os.utime(beat, (time.time() - 60, time.time() - 60))\\n    r = report(root)\\n    assert (r[\\\"state\\\"], r[\\\"stop_class\\\"]) == (\\\"owes-recovery\\\", \\\"died\\\"), r\\n    beat.touch()\\n    r = report(root)\\n    assert r[\\\"state\\\"] == \\\"running\\\", r\\n\\n\\ndef test_two_passes_at_once_start_one_worker_and_the_loser_says_so(tmp_path: Path) -> None:\\n    root, bare = built_tenant(tmp_path, seconds=3)\\n    publish_approval(root)\\n    clone = tmp_path / \\\"second\\\"\\n    git(root.parent, \\\"clone\\\", \\\"-q\\\", \\\"-b\\\", git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip(), str(bare), str(clone))\\n    git(clone, \\\"config\\\", \\\"user.email\\\", \\\"test@example.com\\\")\\n    git(clone, \\\"config\\\", \\\"user.name\\\", \\\"Attavo Test\\\")\\n    git(clone, \\\"remote\\\", \\\"set-head\\\", \\\"origin\\\", \\\"-a\\\")\\n    env = dict(os.environ)\\n    env.update(FAST)\\n    before = {c: (head_of(c), git(c, \\\"ls-files\\\", \\\"-s\\\"), git(c, \\\"status\\\", \\\"--porcelain\\\")) for c in (root, clone)}\\n    procs = [subprocess.Popen([sys.executable, str(ROOT / \\\"bin\\\" / \\\"attavo\\\"), \\\"drive\\\", \\\"1\\\"], cwd=str(c),\\n                              env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)\\n             for c in (root, clone)]\\n    outs = [p.communicate(timeout=30)[0] for p in procs]\\n    started = [o for o in outs if \\\"Build started\\\" in o]\\n    held = [o for o in outs if \\\"another pass holds\\\" in o]\\n    assert len(started) == 1 and len(held) == 1, outs\\n    loser = clone if \\\"another pass holds\\\" in outs[1] else root\\n    assert (head_of(loser), git(loser, \\\"ls-files\\\", \\\"-s\\\"), git(loser, \\\"status\\\", \\\"--porcelain\\\")) == before[loser], \\\\\\n        \\\"the loser's checkout (HEAD, index, working tree) moved\\\"\\n    assert \\\"reset\\\" not in git(loser, \\\"reflog\\\", \\\"show\\\", \\\"HEAD\\\"), git(loser, \\\"reflog\\\", \\\"show\\\", \\\"HEAD\\\")\\n    log = subprocess.run([\\\"git\\\", \\\"-C\\\", str(bare), \\\"log\\\", \\\"--format=%s\\\", \\\"attavo/1-x\\\"], capture_output=True, text=True).stdout\\n    assert log.count(\\\"build invocation 01 started\\\") == 1, log\\n    wait_for(lambda: \\\"build record for item 1\\\" in subprocess.run(\\n        [\\\"git\\\", \\\"-C\\\", str(bare), \\\"log\\\", \\\"--format=%s\\\", \\\"attavo/1-x\\\"], capture_output=True, text=True).stdout)\\n\\n\\ndef test_a_second_checkouts_pass_after_the_first_has_started_reads_running(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"The race made deterministic (#289): two checkouts of one tenant on\\n    one host is ordinary now, since the product owns each item's own\\n    working copy. Run the second's pass only after the first's marker has\\n    already landed -- no race for the lease at all -- and it must still\\n    read the first's heartbeat where its marker says to look, see it\\n    running, start nothing, and push no second invocation.\\\"\\\"\\\"\\n    root, bare = built_tenant(tmp_path, seconds=3)\\n    publish_approval(root)\\n    clone = tmp_path / \\\"second\\\"\\n    git(root.parent, \\\"clone\\\", \\\"-q\\\", \\\"-b\\\", git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip(),\\n        str(bare), str(clone))\\n    git(clone, \\\"config\\\", \\\"user.email\\\", \\\"test@example.com\\\")\\n    git(clone, \\\"config\\\", \\\"user.name\\\", \\\"Attavo Test\\\")\\n    git(clone, \\\"remote\\\", \\\"set-head\\\", \\\"origin\\\", \\\"-a\\\")\\n\\n    first = run_attavo(root, \\\"drive\\\", \\\"1\\\", env=FAST)\\n    assert \\\"Build started\\\" in first.stdout, first.stdout + first.stderr\\n\\n    second = run_attavo(clone, \\\"drive\\\", \\\"1\\\", env=FAST)\\n    assert second.returncode == 0, second.stdout + second.stderr\\n    assert \\\"Build started\\\" not in second.stdout, second.stdout\\n    assert \\\"another pass holds\\\" not in second.stdout, second.stdout\\n    assert \\\"running\\\" in second.stdout.lower(), second.stdout\\n\\n    log = subprocess.run([\\\"git\\\", \\\"-C\\\", str(bare), \\\"log\\\", \\\"--format=%s\\\", \\\"attavo/1-x\\\"],\\n                         capture_output=True, text=True).stdout\\n    assert log.count(\\\"build invocation 01 started\\\") == 1, log\\n    assert not (records_dir(clone) / \\\"build-02.started\\\").exists()\\n    wait_for(lambda: \\\"build record for item 1\\\" in subprocess.run(\\n        [\\\"git\\\", \\\"-C\\\", str(bare), \\\"log\\\", \\\"--format=%s\\\", \\\"attavo/1-x\\\"], capture_output=True, text=True).stdout)\\n\\n\\ndef test_the_heartbeat_is_read_where_the_marker_says(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"holder_heartbeat_path (#289): a marker from this host that names a\\n    directory is read there, not assumed to be this checkout's own --\\n    fresh there is running, absent there is still running while the\\n    marker is younger than the stall bound, and died once it is older.\\n    A marker with no `events` at all (written before this release) reads\\n    exactly as it always did: died the moment there is no heartbeat in\\n    this checkout's own directory, whatever the marker's own age.\\\"\\\"\\\"\\n    from attavo.doctor import heartbeat_path, holder_heartbeat_path, invocation_marker_path\\n    from attavo.drive import read_invocation\\n\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    git(root, \\\"checkout\\\", \\\"-q\\\", \\\"-b\\\", \\\"attavo/1-x\\\")\\n    bound = 5\\n    now = time.strftime(\\\"%Y-%m-%dT%H:%M:%SZ\\\", time.gmtime())\\n    old = time.strftime(\\\"%Y-%m-%dT%H:%M:%SZ\\\", time.gmtime(time.time() - bound * 10))\\n    other_events = tmp_path / \\\"other-checkout\\\" / \\\"attavo\\\"\\n    other_events.mkdir(parents=True)\\n    marker = invocation_marker_path(records_dir(root), \\\"build\\\", 1)\\n\\n    info = {\\\"at\\\": now, \\\"host\\\": socket.gethostname(), \\\"sha\\\": head_of(root),\\n            \\\"product_version\\\": \\\"fixture\\\", \\\"events\\\": str(other_events)}\\n    beat = holder_heartbeat_path(root, info, \\\"build\\\", 1)\\n    assert beat == other_events / \\\"build-01.heartbeat\\\"\\n\\n    beat.write_text(\\\"4242\\\\n\\\")\\n    assert read_invocation(root, bound, marker, info).cls == \\\"running\\\"\\n\\n    beat.unlink()\\n    assert read_invocation(root, bound, marker, info).cls == \\\"running\\\"\\n\\n    info_old = {**info, \\\"at\\\": old}\\n    assert read_invocation(root, bound, marker, info_old).cls == \\\"died\\\"\\n\\n    legacy = {\\\"at\\\": now, \\\"host\\\": socket.gethostname(), \\\"sha\\\": head_of(root),\\n             \\\"product_version\\\": \\\"fixture\\\"}\\n    assert holder_heartbeat_path(root, legacy, \\\"build\\\", 1) == heartbeat_path(root, \\\"build\\\", 1)\\n    assert read_invocation(root, bound, marker, legacy).cls == \\\"died\\\"\\n\\n\\ndef test_the_marker_a_pass_writes_names_its_checkouts_own_directory(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"write_invocation_marker's own `events` field, from `attavo drive`\\n    itself (#289): the marker is committed and pushed from a detached\\n    worktree, but `events` must still name the checkout's own\\n    <git-dir>/attavo, never that worktree's -- otherwise a second\\n    checkout reading this marker later would look for the heartbeat in a\\n    directory removed the moment the marker's own push returned.\\\"\\\"\\\"\\n    root, bare = built_tenant(tmp_path, seconds=0)\\n    assert run_attavo(root, \\\"drive\\\", \\\"1\\\", env=FAST).returncode == 0\\n    marker = json.loads((records_dir(root) / \\\"build-01.started\\\").read_text())\\n    assert marker[\\\"events\\\"] == str(git_dir(root) / \\\"attavo\\\"), marker\\n    wait_for(lambda: record_files(root, \\\"build\\\") != [])\\n\\n\\ndef test_a_pass_recovers_a_dead_invocation_and_recover_is_gone(tmp_path: Path) -> None:\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    git(root, \\\"checkout\\\", \\\"-q\\\", \\\"-b\\\", \\\"attavo/1-x\\\")\\n    add_forge(root, GREEN_FORGE)\\n    add_drive_stall_bound(root)\\n    approve_item(root)\\n    write_dead_marker(root, \\\"build\\\", 1)\\n    gone = run_attavo(root, \\\"drive\\\", \\\"--recover\\\", \\\"1\\\", env=FAST)\\n    assert gone.returncode == 2 and \\\"gone\\\" in gone.stderr, gone.stdout + gone.stderr\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\", env=FAST)\\n    assert run.returncode == 0, run.stdout + run.stderr\\n    rec = latest_record(root, \\\"build\\\")\\n    assert rec[\\\"stop\\\"][\\\"class\\\"] == \\\"died\\\", rec[\\\"stop\\\"]\\n\\n\\ndef test_the_review_takes_the_checks_the_pass_read_and_never_polls(tmp_path: Path) -> None:\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    calls = tmp_path / \\\"forge-calls.txt\\\"\\n    forge = tmp_path / \\\"forge.sh\\\"\\n    forge.write_text(f'#!/bin/sh\\\\necho \\\"$1\\\" >> {calls}\\\\nprintf \\\"ci success\\\\\\\\n\\\"\\\\n')\\n    forge.chmod(0o755)\\n    add_forge(root, f\\\"sh {forge}\\\")\\n    add_drive_stall_bound(root)\\n    slow_adapter(root, 0)\\n    bare = add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n    assert run_attavo(root, \\\"drive\\\", \\\"1\\\", env=FAST).returncode == 0\\n    wait_for(lambda: pushed(bare, \\\"build record for item 1\\\"))\\n    wait_for(lambda: remote_head(bare) == head_of(root))\\n    calls.write_text(\\\"\\\")\\n    pre_marker = head_of(root)\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\", env=FAST)\\n    assert \\\"Review started\\\" in run.stdout, run.stdout + run.stderr\\n    wait_for(lambda: record_files(root, \\\"verify\\\") != [])\\n    rec = latest_record(root, \\\"verify\\\")\\n    assert rec[\\\"status\\\"] == \\\"pass\\\", rec\\n    assert rec[\\\"forge_checks\\\"][\\\"sha\\\"] == pre_marker, (rec[\\\"forge_checks\\\"], pre_marker)\\n    read_by = [l for l in calls.read_text().split() if l]\\n    assert read_by == [pre_marker], f\\\"the forge was read {len(read_by)} time(s) after the build: {read_by}\\\"\\n\\n\\ndef test_until_ready_is_a_loop_of_passes_that_returns_at_ready(tmp_path: Path) -> None:\\n    root, _ = built_tenant(tmp_path, seconds=0)\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\", \\\"--until-ready\\\", env=FAST)\\n    assert run.returncode == 0, run.stdout + run.stderr\\n    assert \\\"Build started\\\" in run.stdout and \\\"Review started\\\" in run.stdout, run.stdout\\n    assert run.stdout.strip().endswith(\\\"Ready to merge\\\"), run.stdout\\n    assert report(root)[\\\"state\\\"] == \\\"ready-to-merge\\\"\\n\\n\\ndef test_a_died_stage_retries_plainly_and_again_is_a_no_op_inside_the_budget(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"R3: died is one of the four plain retryable families -- the very\\n    next pass retries it on its own, with no operator and no --again\\n    needed; `--again` inside the budget is a no-op that says so, rather\\n    than starting a second attempt of its own.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    git(root, \\\"checkout\\\", \\\"-q\\\", \\\"-b\\\", \\\"attavo/1-x\\\")\\n    add_forge(root, GREEN_FORGE)\\n    add_drive_stall_bound(root)\\n    approve_item(root)\\n    write_dead_marker(root, \\\"build\\\", 1)\\n    assert run_attavo(root, \\\"drive\\\", \\\"1\\\", env=FAST).returncode == 0\\n    assert latest_record(root, \\\"build\\\")[\\\"stop\\\"][\\\"class\\\"] == \\\"died\\\"\\n    again = run_attavo(root, \\\"drive\\\", \\\"1\\\", \\\"--again\\\", \\\"--by\\\", \\\"alice\\\", env=FAST)\\n    assert again.returncode == 0 and \\\"retries on its own\\\" in again.stdout, again.stdout\\n    assert not (records_dir(root) / \\\"build-02.started\\\").exists()\\n    plain = run_attavo(root, \\\"drive\\\", \\\"1\\\", env=FAST)\\n    assert \\\"Build started\\\" in plain.stdout, plain.stdout + plain.stderr\\n    assert (records_dir(root) / \\\"build-02.started\\\").exists()\\n    wait_for(lambda: len(record_files(root, \\\"build\\\")) == 2)\\n    assert latest_record(root, \\\"build\\\")[\\\"retry_of\\\"] == \\\"build-01\\\"\\n\\n\\ndef test_all_from_the_checkout_passes_every_unmerged_branch_on_origin_and_removes_merged_copies(\\n        tmp_path: Path) -> None:\\n    from test_working_copy import add_merged_item, copy_of, tenant_on_main\\n    root, bare = tenant_on_main(tmp_path)\\n    add_merged_item(root, bare, \\\"2\\\")\\n    merged = copy_of(tmp_path, \\\"2\\\")\\n    git(root, \\\"worktree\\\", \\\"add\\\", \\\"-q\\\", str(merged), \\\"attavo/2-y\\\")\\n    run = run_attavo(root, \\\"drive\\\", \\\"--all\\\", env=FAST)\\n    assert run.returncode == 0, run.stdout + run.stderr\\n    assert \\\"attavo-worktree-1: attavo drive: Build started\\\" in run.stdout, run.stdout\\n    assert \\\"attavo-worktree-2: attavo drive: merged: removed attavo-worktree-2\\\" in run.stdout, run.stdout\\n    assert not merged.exists()\\n    wait_for(lambda: record_files(copy_of(tmp_path), \\\"build\\\") != [])\\n\\n\\ndef test_the_report_reads_running_for_the_whole_of_counsel_and_stopped_after_the_push(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"The heartbeat is the holder's, so it runs until the holder exits: a\\n    stopped build's worker is asked for counsel, and for the length of\\n    that run the report reads running and a pass starts and recovers\\n    nothing.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    add_drive_stall_bound(root)\\n    manifest = root / \\\"attavo.toml\\\"\\n    manifest.write_text(manifest.read_text().replace(\\n        '[executor]\\\\nbuild = \\\"fixture\\\"', '[executor]\\\\nbuild = \\\"fixture\\\"\\\\ncounsel = \\\"fixture\\\"'))\\n    commit_all(root, \\\"counsel configured\\\")\\n    bare = add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n    release = tmp_path / \\\"release-counsel\\\"\\n    env = {**FAST, \\\"ATTAVO_FIXTURE_QUESTION\\\": \\\"which overlay wins?\\\",\\n           \\\"ATTAVO_FIXTURE_COUNSEL_WAIT_FOR\\\": str(release)}\\n    assert run_attavo(root, \\\"drive\\\", \\\"1\\\", env=env).returncode == 0\\n    beat = git_dir(root) / \\\"attavo\\\" / \\\"build-01.heartbeat\\\"\\n    wait_for(lambda: record_files(root, \\\"build\\\") != [])\\n    worker = int(beat.read_text())\\n    # The stage command has returned; the worker is in counsel. Let the\\n    # heartbeat's own interval pass three times over: a beat that stopped\\n    # with the command reads stale by now.\\n    time.sleep(1.0)\\n    os.kill(worker, 0)\\n    assert time.time() - beat.stat().st_mtime < 0.6, \\\"the heartbeat is stale while the worker is alive\\\"\\n    r = report(root)\\n    assert (r[\\\"state\\\"], r[\\\"kind\\\"]) == (\\\"running\\\", \\\"waits\\\"), r\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\", env=FAST)\\n    assert run.returncode == 0, run.stdout + run.stderr\\n    assert \\\"started\\\" not in run.stdout and \\\"ecover\\\" not in run.stdout, run.stdout\\n    assert not (records_dir(root) / \\\"build-02.started\\\").exists()\\n    os.kill(worker, 0)\\n    release.touch()\\n    wait_for(lambda: pushed(bare, \\\"build record for item 1 (build-01)\\\"))\\n    assert latest_record(root, \\\"counsel\\\")[\\\"record\\\"] == \\\"build-01\\\"\\n    assert report(root)[\\\"state\\\"] == \\\"stopped\\\"\\n\\n\\ndef test_a_worker_whose_commit_is_refused_beats_until_it_returns_and_then_stops(\\n        tmp_path: Path, monkeypatch: Any) -> None:\\n    import threading\\n\\n    from attavo import drive\\n    from attavo.doctor import heartbeat_path\\n\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_drive_stall_bound(root)\\n    approve_item(root)\\n    monkeypatch.chdir(root)\\n    monkeypatch.setenv(\\\"ATTAVO_HEARTBEAT_S\\\", \\\"0.1\\\")\\n    seen: dict[str, float] = {}\\n\\n    def stage(argv: list[str]) -> int:\\n        (records_dir(root) / \\\"build-01.json\\\").write_text(\\\"{}\\\")\\n        return 0\\n\\n    def refuse(*_: Any) -> None:\\n        time.sleep(0.5)\\n        seen[\\\"age\\\"] = time.time() - heartbeat_path(root, \\\"build\\\", 1).stat().st_mtime\\n        raise RuntimeError(\\\"refused\\\")\\n\\n    monkeypatch.setattr(drive, \\\"cmd_build\\\", stage)\\n    monkeypatch.setattr(drive, \\\"latest_record\\\", lambda *_: {\\\"status\\\": \\\"pass\\\"})\\n    monkeypatch.setattr(drive, \\\"commit_record\\\", refuse)\\n    before = threading.active_count()\\n    assert drive._stage_body(\\\"1\\\", \\\"build\\\", 1) == 1\\n    assert seen[\\\"age\\\"] < 0.3, f\\\"the heartbeat had stopped {seen['age']:.2f}s before the refused commit\\\"\\n    assert threading.active_count() == before, \\\"the heartbeat thread outlived the worker's body\\\"\\n\\n\\ndef test_after_the_stage_record_is_pushed_the_checkout_is_clean_and_at_origin(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"The record is committed by the driver from a detached worktree and\\n    the checkout only fast-forwards to it: no untracked or modified file,\\n    HEAD at origin's branch, the record commit the driver's with one\\n    parent.\\\"\\\"\\\"\\n    root, bare = built_tenant(tmp_path, seconds=1)\\n    publish_approval(root)\\n    assert run_attavo(root, \\\"drive\\\", \\\"1\\\", env=FAST).returncode == 0\\n    wait_for(lambda: pushed(bare, \\\"build record for item 1 (build-01)\\\"))\\n    wait_for(lambda: remote_head(bare) == head_of(root), 5)\\n    assert git(root, \\\"status\\\", \\\"--porcelain\\\") == \\\"\\\", git(root, \\\"status\\\", \\\"--porcelain\\\")\\n    subject, author, parents = git(root, \\\"log\\\", \\\"-1\\\", \\\"--format=%s%x1f%an <%ae>%x1f%P\\\", \\\"HEAD\\\").strip().split(\\\"\\\\x1f\\\")\\n    assert \\\"build record for item 1\\\" in subject, subject\\n    assert author == \\\"attavo driver <driver@attavo.invalid>\\\", author\\n    assert len(parents.split()) == 1, parents\\n    made_here = [l for l in git(root, \\\"reflog\\\", \\\"show\\\", \\\"HEAD\\\").splitlines() if \\\"attavo:\\\" in l]\\n    assert all(\\\"fast-forward\\\" in l.lower() for l in made_here), \\\\\\n        \\\"the driver made a commit in the executor's checkout:\\\\n\\\" + \\\"\\\\n\\\".join(made_here)\\n    assert (records_dir(root) / \\\"build-01.json\\\").is_file()\\n    assert not list((git_dir(root) / \\\"attavo\\\").glob(\\\"transport/*/*\\\")), \\\"a transport worktree was left behind\\\"\\n\\n\\ndef test_a_pass_every_half_second_beside_a_worker_committing_its_records_hits_no_git_error(\\n        tmp_path: Path) -> None:\\n    \\\"\\\"\\\"The collision root cause 1 names (#261): passes run every 0.5 s\\n    while the detached worker commits its stage and counsel records --\\n    the specimen is tests/test_retry.py::test_counsels_verdict_routes_\\n    the_next_pass, which failed 8 of 40 runs that way before it was\\n    changed to run one pass. No pass and no worker reports a git error,\\n    and the records land.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    add_drive_stall_bound(root)\\n    slow_adapter(root, 0)\\n    manifest = root / \\\"attavo.toml\\\"\\n    manifest.write_text(manifest.read_text().replace(\\n        '[executor]\\\\nbuild = \\\"fixture\\\"', '[executor]\\\\nbuild = \\\"fixture\\\"\\\\ncounsel = \\\"fixture\\\"'))\\n    commit_all(root, \\\"counsel configured\\\")\\n    bare = add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n    publish_approval(root)\\n    # A commit that takes a while (a slow hook holds the index lock for its\\n    # length), so a commit and several passes overlap in time.\\n    hook = Path(git(root, \\\"rev-parse\\\", \\\"--git-path\\\", \\\"hooks/pre-commit\\\").strip())\\n    hook = hook if hook.is_absolute() else root / hook\\n    hook.write_text(\\\"#!/bin/sh\\\\nsleep 0.4\\\\n\\\")\\n    hook.chmod(0o755)\\n    response = tmp_path / \\\"counsel.json\\\"\\n    response.write_text(json.dumps({\\n        \\\"model\\\": \\\"fixture\\\", \\\"model_version\\\": None, \\\"adapter_version\\\": \\\"fixture-1\\\",\\n        \\\"tokens\\\": {\\\"input\\\": 1, \\\"output\\\": 1}, \\\"cost_usd\\\": 0.0, \\\"class\\\": \\\"question\\\", \\\"verdict\\\": \\\"person\\\",\\n        \\\"citations\\\": [{\\\"kind\\\": \\\"instruction\\\", \\\"path\\\": \\\"specs/1/spec.md\\\", \\\"symbol\\\": \\\"problem\\\"}],\\n        \\\"proposal\\\": {\\\"ruling_text\\\": None, \\\"patch\\\": None, \\\"question\\\": \\\"which overlay wins?\\\"}}))\\n    env = {**FAST, \\\"ATTAVO_FIXTURE_QUESTION\\\": \\\"which overlay wins?\\\",\\n           \\\"ATTAVO_FIXTURE_COUNSEL_RESPONSE\\\": str(response)}\\n    outputs: list[str] = []\\n    beat = git_dir(root) / \\\"attavo\\\" / \\\"build-01.heartbeat\\\"\\n\\n    def worker_alive() -> bool:\\n        try:\\n            os.kill(int(beat.read_text()), 0)\\n            return True\\n        except (OSError, ValueError):\\n            return False\\n\\n    deadline = time.monotonic() + 60\\n    started = False\\n    while time.monotonic() < deadline:\\n        run = run_attavo(root, \\\"drive\\\", \\\"1\\\", env=env)\\n        outputs.append(f\\\"rc={run.returncode}\\\\n{run.stdout}{run.stderr}\\\")\\n        started = started or beat.exists()\\n        if started and not worker_alive():\\n            break\\n        time.sleep(0.5)\\n    else:\\n        raise AssertionError(\\\"the worker never returned:\\\\n\\\" + \\\"\\\\n\\\".join(outputs))\\n    assert pushed(bare, \\\"build record for item 1 (build-01)\\\"), \\\"\\\\n\\\".join(outputs)\\n    outputs.append(f\\\"rc=0\\\\n{run_attavo(root, 'drive', '1', env=env).stdout}\\\")\\n    bad = [o for o in outputs if not o.startswith(\\\"rc=0\\\") or \\\"fatal\\\" in o or \\\"stopped: could not\\\" in o or \\\"error\\\" in o.lower()]\\n    assert not bad, \\\"a pass hit a git error:\\\\n\\\" + \\\"\\\\n\\\".join(bad)\\n    worker_log = (git_dir(root) / \\\"attavo\\\" / \\\"build-01.worker.log\\\").read_text()\\n    assert \\\"fatal\\\" not in worker_log and \\\"could not\\\" not in worker_log and \\\"error\\\" not in worker_log.lower(), worker_log\\n    assert latest_record(root, \\\"counsel\\\")[\\\"verdict\\\"] == \\\"person\\\"\\n    assert git(root, \\\"status\\\", \\\"--porcelain\\\") == \\\"\\\"\\n    made_here = [l for l in git(root, \\\"reflog\\\", \\\"show\\\", \\\"HEAD\\\").splitlines() if \\\"attavo:\\\" in l]\\n    assert all(\\\"fast-forward\\\" in l.lower() for l in made_here), \\\\\\n        \\\"a pass or the worker committed in the executor's checkout:\\\\n\\\" + \\\"\\\\n\\\".join(made_here)\\n    assert \\\"build record for item 1 (build-01)\\\" in git(root, \\\"log\\\", \\\"--format=%s\\\", \\\"origin/attavo/1-x\\\")\\n\",\"structuredPatch\":[{\"oldStart\":189,\"oldLines\":7,\"newStart\":189,\"newLines\":7,\"lines\":[\"         [\\\"git\\\", \\\"-C\\\", str(bare), \\\"log\\\", \\\"--format=%s\\\", \\\"attavo/1-x\\\"], capture_output=True, text=True).stdout)\",\" \",\" \",\"-def test_a_second_checkouts_pass_after_the_first_has_started_reads_running(tmp_path: Path) -> None:\",\"+def test_a_second_checkout_on_this_host_reads_the_first_ones_worker_as_running(tmp_path: Path) -> None:\",\"     \\\"\\\"\\\"The race made deterministic (#289): two checkouts of one tenant on\",\"     one host is ordinary now, since the product owns each item's own\",\"     working copy. Run the second's pass only after the first's marker has\"]}],\"userModified\":false,\"replaceAll\":false,\"staleRecovered\":true,\"contentNotInModelContext\":true}}\n{\"type\":\"assistant\",\"message\":{\"model\":\"claude-sonnet-5\",\"id\":\"msg_011CfaUL7U7fuZXNvwyhALM8\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_01UYyRcSMTp3abh6TTDC3jRy\",\"name\":\"Edit\",\"input\":{\"replace_all\":false,\"file_path\":\"/Users/davidbean/Projects/attavo-worktree-289/tests/test_pass.py\",\"old_string\":\"def test_the_heartbeat_is_read_where_the_marker_says(tmp_path: Path) -> None:\",\"new_string\":\"def test_the_holders_heartbeat_is_read_where_its_marker_says(tmp_path: Path) -> None:\"},\"caller\":{\"type\":\"direct\"}}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":485,\"cache_read_input_tokens\":156602,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":485},\"output_tokens\":16,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"b3f717aa-5c2b-4867-b022-0f24cffb6427\",\"uuid\":\"a052e4a8-99d3-4ecd-8dcc-818117c843a5\",\"timestamp\":\"2026-09-30T23:13:28.559Z\",\"request_id\":\"req_011CfaUL781uVz6TGisy6mHf\",\"wire_tool_inputs\":{\"toolu_01UYyRcSMTp3abh6TTDC3jRy\":{\"file_path\":\"/Users/davidbean/Projects/attavo-worktree-289/tests/test_pass.py\",\"old_string\":\"def test_the_heartbeat_is_read_where_the_marker_says(tmp_path: Path) -> None:\",\"new_string\":\"def test_the_holders_heartbeat_is_read_where_its_marker_says(tmp_path: Path) -> None:\"}}}\n{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01UYyRcSMTp3abh6TTDC3jRy\",\"type\":\"tool_result\",\"content\":\"The file /Users/davidbean/Projects/attavo-worktree-289/tests/test_pass.py has been updated successfully.\"}]},\"parent_tool_use_id\":null,\"session_id\":\"b3f717aa-5c2b-4867-b022-0f24cffb6427\",\"uuid\":\"e093de60-2127-4f7b-b112-392ff3452f2f\",\"timestamp\":\"2026-09-30T23:13:28.584Z\",\"tool_use_result\":{\"filePath\":\"/Users/davidbean/Projects/attavo-worktree-289/tests/test_pass.py\",\"oldString\":\"def test_the_heartbeat_is_read_where_the_marker_says(tmp_path: Path) -> None:\",\"newString\":\"def test_the_holders_heartbeat_is_read_where_its_marker_says(tmp_path: Path) -> None:\",\"originalFile\":\"\\\"\\\"\\\"The reconciler's R2 (claude/reconciler-brief-2026-09-20.md, rulings A, B,\\nH): `attavo drive N` is one short pass that reads the report, acts at most\\nonce, and returns; a stage runs in a detached worker with its own\\nheartbeat; the marker's push is the lease; recovery is the pass's; the\\nreview takes the checks the pass read on the pre-marker head.\\n\\nRun: python3 -m pytest tests -q\\n\\\"\\\"\\\"\\nfrom __future__ import annotations\\n\\nimport json\\nimport os\\nimport socket\\nimport subprocess\\nimport sys\\nimport time\\nfrom pathlib import Path\\nfrom typing import Any\\n\\nfrom helpers import commit_all, git, make_tenant\\nfrom test_drive import (\\n    GREEN_FORGE,\\n    add_bare_remote,\\n    add_drive_stall_bound,\\n    add_forge,\\n    approve_item,\\n    head_of,\\n    publish_approval,\\n    latest_record,\\n    record_files,\\n    records_dir,\\n    remote_head,\\n    run_attavo,\\n    write_dead_marker,\\n)\\n\\nROOT = Path(__file__).resolve().parent.parent\\nFAST = {\\\"ATTAVO_HEARTBEAT_S\\\": \\\"0.2\\\", \\\"ATTAVO_DRIVE_POLL_INTERVAL_S\\\": \\\"0.5\\\"}\\n\\n\\ndef slow_adapter(root: Path, seconds: float) -> None:\\n    \\\"\\\"\\\"A tenant-side build adapter: the product's own fixture adapter,\\n    after `seconds` of sleep on the build stage.\\\"\\\"\\\"\\n    d = root / \\\"attavo\\\" / \\\"adapters\\\" / \\\"fixture\\\"\\n    d.mkdir(parents=True, exist_ok=True)\\n    run = d / \\\"run\\\"\\n    run.write_text(f'#!/bin/sh\\\\nif [ \\\"${{ATTAVO_STAGE:-build}}\\\" = build ]; then sleep {seconds}; fi\\\\n'\\n                   f'exec sh {ROOT / \\\"adapters\\\" / \\\"fixture\\\" / \\\"run\\\"}\\\\n')\\n    run.chmod(0o755)\\n    commit_all(root, \\\"a slow tenant-side adapter\\\")\\n\\n\\ndef git_dir(root: Path) -> Path:\\n    return Path(git(root, \\\"rev-parse\\\", \\\"--absolute-git-dir\\\").strip())\\n\\n\\ndef report(root: Path, env: dict[str, str] | None = None) -> dict[str, Any]:\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\", \\\"--report\\\", env={**FAST, **(env or {})})\\n    assert run.returncode == 0, run.stdout + run.stderr\\n    out: dict[str, Any] = json.loads(run.stdout)\\n    return out\\n\\n\\ndef pushed(bare: Path, subject: str) -> bool:\\n    log = subprocess.run([\\\"git\\\", \\\"-C\\\", str(bare), \\\"log\\\", \\\"--format=%s\\\", \\\"attavo/1-x\\\"], capture_output=True, text=True).stdout\\n    return subject in log\\n\\n\\ndef wait_for(pred: Any, seconds: float = 20) -> None:\\n    deadline = time.monotonic() + seconds\\n    while time.monotonic() < deadline:\\n        if pred():\\n            return\\n        time.sleep(0.2)\\n    raise AssertionError(\\\"condition not met in time\\\")\\n\\n\\ndef passes_until(root: Path, pred: Any, seconds: float = 40, env: dict[str, str] | None = None) -> None:\\n    \\\"\\\"\\\"Passes, spaced, until pred holds: how an operator's loop, the\\n    screen's poll, or a scheduler line would drive the item.\\\"\\\"\\\"\\n    deadline = time.monotonic() + seconds\\n    full = dict(FAST)\\n    full.update(env or {})\\n    while time.monotonic() < deadline:\\n        run_attavo(root, \\\"drive\\\", \\\"1\\\", env=full)\\n        if pred():\\n            return\\n        time.sleep(0.5)\\n    raise AssertionError(\\\"condition not met in time\\\")\\n\\n\\ndef clock_ahead(tmp_path: Path, seconds: float) -> dict[str, str]:\\n    \\\"\\\"\\\"The environment that puts every bound the product judges `seconds`\\n    past the machine's now (#257): a clock file, named by ATTAVO_CLOCK_FILE,\\n    that the next pass reads instead of waiting.\\\"\\\"\\\"\\n    path = tmp_path / \\\"attavo-clock\\\"\\n    path.write_text(str(time.time() + seconds))\\n    return {\\\"ATTAVO_CLOCK_FILE\\\": str(path)}\\n\\n\\ndef built_tenant(tmp_path: Path, seconds: float = 3) -> tuple[Path, Path]:\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    add_drive_stall_bound(root)\\n    slow_adapter(root, seconds)\\n    bare = add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n    return root, bare\\n\\n\\ndef test_a_pass_returns_while_the_worker_runs_and_the_worker_outlives_it(tmp_path: Path) -> None:\\n    root, bare = built_tenant(tmp_path, seconds=3)\\n    started = time.monotonic()\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\", env=FAST)\\n    elapsed = time.monotonic() - started\\n    assert run.returncode == 0, run.stdout + run.stderr\\n    assert elapsed < 2.5, f\\\"the pass took {elapsed:.1f}s: it waited for the stage\\\"\\n    assert \\\"Build started\\\" in run.stdout, run.stdout\\n    assert (records_dir(root) / \\\"build-01.started\\\").exists()\\n    assert remote_head(bare) == head_of(root), \\\"the marker was not pushed before the pass returned\\\"\\n    assert record_files(root, \\\"build\\\") == [], \\\"the record existed before the worker could have written it\\\"\\n    wait_for(lambda: record_files(root, \\\"build\\\") != [])\\n    wait_for(lambda: remote_head(bare) == head_of(root))\\n    assert latest_record(root, \\\"build\\\")[\\\"status\\\"] == \\\"pass\\\"\\n\\n\\ndef test_the_worker_touches_its_heartbeat_and_the_report_reads_running_by_it(tmp_path: Path) -> None:\\n    root, _ = built_tenant(tmp_path, seconds=3)\\n    assert run_attavo(root, \\\"drive\\\", \\\"1\\\", env=FAST).returncode == 0\\n    beat = git_dir(root) / \\\"attavo\\\" / \\\"build-01.heartbeat\\\"\\n    wait_for(beat.exists, 5)\\n    first = beat.stat().st_mtime\\n    time.sleep(0.6)\\n    assert beat.stat().st_mtime > first, \\\"the heartbeat did not move\\\"\\n    r = report(root)\\n    assert (r[\\\"state\\\"], r[\\\"kind\\\"]) == (\\\"running\\\", \\\"waits\\\"), r\\n    wait_for(lambda: record_files(root, \\\"build\\\") != [])\\n\\n\\ndef test_a_stale_heartbeat_reads_died_though_the_pid_lives_and_a_fresh_one_reads_alive(tmp_path: Path) -> None:\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    git(root, \\\"checkout\\\", \\\"-q\\\", \\\"-b\\\", \\\"attavo/1-x\\\")\\n    add_forge(root, GREEN_FORGE)\\n    add_drive_stall_bound(root, 600)\\n    approve_item(root)\\n    d = records_dir(root)\\n    d.mkdir(parents=True, exist_ok=True)\\n    marker = d / \\\"build-01.started\\\"\\n    now = time.strftime(\\\"%Y-%m-%dT%H:%M:%SZ\\\", time.gmtime())\\n    marker.write_text(json.dumps({\\\"at\\\": now, \\\"host\\\": socket.gethostname(),\\n                                  \\\"pid\\\": os.getpid(), \\\"sha\\\": head_of(root), \\\"product_version\\\": \\\"fixture\\\"}))\\n    commit_all(root, \\\"a marker whose pid is this test\\\")\\n    beat = git_dir(root) / \\\"attavo\\\" / \\\"build-01.heartbeat\\\"\\n    beat.parent.mkdir(parents=True, exist_ok=True)\\n    beat.touch()\\n    os.utime(beat, (time.time() - 60, time.time() - 60))\\n    r = report(root)\\n    assert (r[\\\"state\\\"], r[\\\"stop_class\\\"]) == (\\\"owes-recovery\\\", \\\"died\\\"), r\\n    beat.touch()\\n    r = report(root)\\n    assert r[\\\"state\\\"] == \\\"running\\\", r\\n\\n\\ndef test_two_passes_at_once_start_one_worker_and_the_loser_says_so(tmp_path: Path) -> None:\\n    root, bare = built_tenant(tmp_path, seconds=3)\\n    publish_approval(root)\\n    clone = tmp_path / \\\"second\\\"\\n    git(root.parent, \\\"clone\\\", \\\"-q\\\", \\\"-b\\\", git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip(), str(bare), str(clone))\\n    git(clone, \\\"config\\\", \\\"user.email\\\", \\\"test@example.com\\\")\\n    git(clone, \\\"config\\\", \\\"user.name\\\", \\\"Attavo Test\\\")\\n    git(clone, \\\"remote\\\", \\\"set-head\\\", \\\"origin\\\", \\\"-a\\\")\\n    env = dict(os.environ)\\n    env.update(FAST)\\n    before = {c: (head_of(c), git(c, \\\"ls-files\\\", \\\"-s\\\"), git(c, \\\"status\\\", \\\"--porcelain\\\")) for c in (root, clone)}\\n    procs = [subprocess.Popen([sys.executable, str(ROOT / \\\"bin\\\" / \\\"attavo\\\"), \\\"drive\\\", \\\"1\\\"], cwd=str(c),\\n                              env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)\\n             for c in (root, clone)]\\n    outs = [p.communicate(timeout=30)[0] for p in procs]\\n    started = [o for o in outs if \\\"Build started\\\" in o]\\n    held = [o for o in outs if \\\"another pass holds\\\" in o]\\n    assert len(started) == 1 and len(held) == 1, outs\\n    loser = clone if \\\"another pass holds\\\" in outs[1] else root\\n    assert (head_of(loser), git(loser, \\\"ls-files\\\", \\\"-s\\\"), git(loser, \\\"status\\\", \\\"--porcelain\\\")) == before[loser], \\\\\\n        \\\"the loser's checkout (HEAD, index, working tree) moved\\\"\\n    assert \\\"reset\\\" not in git(loser, \\\"reflog\\\", \\\"show\\\", \\\"HEAD\\\"), git(loser, \\\"reflog\\\", \\\"show\\\", \\\"HEAD\\\")\\n    log = subprocess.run([\\\"git\\\", \\\"-C\\\", str(bare), \\\"log\\\", \\\"--format=%s\\\", \\\"attavo/1-x\\\"], capture_output=True, text=True).stdout\\n    assert log.count(\\\"build invocation 01 started\\\") == 1, log\\n    wait_for(lambda: \\\"build record for item 1\\\" in subprocess.run(\\n        [\\\"git\\\", \\\"-C\\\", str(bare), \\\"log\\\", \\\"--format=%s\\\", \\\"attavo/1-x\\\"], capture_output=True, text=True).stdout)\\n\\n\\ndef test_a_second_checkout_on_this_host_reads_the_first_ones_worker_as_running(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"The race made deterministic (#289): two checkouts of one tenant on\\n    one host is ordinary now, since the product owns each item's own\\n    working copy. Run the second's pass only after the first's marker has\\n    already landed -- no race for the lease at all -- and it must still\\n    read the first's heartbeat where its marker says to look, see it\\n    running, start nothing, and push no second invocation.\\\"\\\"\\\"\\n    root, bare = built_tenant(tmp_path, seconds=3)\\n    publish_approval(root)\\n    clone = tmp_path / \\\"second\\\"\\n    git(root.parent, \\\"clone\\\", \\\"-q\\\", \\\"-b\\\", git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip(),\\n        str(bare), str(clone))\\n    git(clone, \\\"config\\\", \\\"user.email\\\", \\\"test@example.com\\\")\\n    git(clone, \\\"config\\\", \\\"user.name\\\", \\\"Attavo Test\\\")\\n    git(clone, \\\"remote\\\", \\\"set-head\\\", \\\"origin\\\", \\\"-a\\\")\\n\\n    first = run_attavo(root, \\\"drive\\\", \\\"1\\\", env=FAST)\\n    assert \\\"Build started\\\" in first.stdout, first.stdout + first.stderr\\n\\n    second = run_attavo(clone, \\\"drive\\\", \\\"1\\\", env=FAST)\\n    assert second.returncode == 0, second.stdout + second.stderr\\n    assert \\\"Build started\\\" not in second.stdout, second.stdout\\n    assert \\\"another pass holds\\\" not in second.stdout, second.stdout\\n    assert \\\"running\\\" in second.stdout.lower(), second.stdout\\n\\n    log = subprocess.run([\\\"git\\\", \\\"-C\\\", str(bare), \\\"log\\\", \\\"--format=%s\\\", \\\"attavo/1-x\\\"],\\n                         capture_output=True, text=True).stdout\\n    assert log.count(\\\"build invocation 01 started\\\") == 1, log\\n    assert not (records_dir(clone) / \\\"build-02.started\\\").exists()\\n    wait_for(lambda: \\\"build record for item 1\\\" in subprocess.run(\\n        [\\\"git\\\", \\\"-C\\\", str(bare), \\\"log\\\", \\\"--format=%s\\\", \\\"attavo/1-x\\\"], capture_output=True, text=True).stdout)\\n\\n\\ndef test_the_heartbeat_is_read_where_the_marker_says(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"holder_heartbeat_path (#289): a marker from this host that names a\\n    directory is read there, not assumed to be this checkout's own --\\n    fresh there is running, absent there is still running while the\\n    marker is younger than the stall bound, and died once it is older.\\n    A marker with no `events` at all (written before this release) reads\\n    exactly as it always did: died the moment there is no heartbeat in\\n    this checkout's own directory, whatever the marker's own age.\\\"\\\"\\\"\\n    from attavo.doctor import heartbeat_path, holder_heartbeat_path, invocation_marker_path\\n    from attavo.drive import read_invocation\\n\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    git(root, \\\"checkout\\\", \\\"-q\\\", \\\"-b\\\", \\\"attavo/1-x\\\")\\n    bound = 5\\n    now = time.strftime(\\\"%Y-%m-%dT%H:%M:%SZ\\\", time.gmtime())\\n    old = time.strftime(\\\"%Y-%m-%dT%H:%M:%SZ\\\", time.gmtime(time.time() - bound * 10))\\n    other_events = tmp_path / \\\"other-checkout\\\" / \\\"attavo\\\"\\n    other_events.mkdir(parents=True)\\n    marker = invocation_marker_path(records_dir(root), \\\"build\\\", 1)\\n\\n    info = {\\\"at\\\": now, \\\"host\\\": socket.gethostname(), \\\"sha\\\": head_of(root),\\n            \\\"product_version\\\": \\\"fixture\\\", \\\"events\\\": str(other_events)}\\n    beat = holder_heartbeat_path(root, info, \\\"build\\\", 1)\\n    assert beat == other_events / \\\"build-01.heartbeat\\\"\\n\\n    beat.write_text(\\\"4242\\\\n\\\")\\n    assert read_invocation(root, bound, marker, info).cls == \\\"running\\\"\\n\\n    beat.unlink()\\n    assert read_invocation(root, bound, marker, info).cls == \\\"running\\\"\\n\\n    info_old = {**info, \\\"at\\\": old}\\n    assert read_invocation(root, bound, marker, info_old).cls == \\\"died\\\"\\n\\n    legacy = {\\\"at\\\": now, \\\"host\\\": socket.gethostname(), \\\"sha\\\": head_of(root),\\n             \\\"product_version\\\": \\\"fixture\\\"}\\n    assert holder_heartbeat_path(root, legacy, \\\"build\\\", 1) == heartbeat_path(root, \\\"build\\\", 1)\\n    assert read_invocation(root, bound, marker, legacy).cls == \\\"died\\\"\\n\\n\\ndef test_the_marker_a_pass_writes_names_its_checkouts_own_directory(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"write_invocation_marker's own `events` field, from `attavo drive`\\n    itself (#289): the marker is committed and pushed from a detached\\n    worktree, but `events` must still name the checkout's own\\n    <git-dir>/attavo, never that worktree's -- otherwise a second\\n    checkout reading this marker later would look for the heartbeat in a\\n    directory removed the moment the marker's own push returned.\\\"\\\"\\\"\\n    root, bare = built_tenant(tmp_path, seconds=0)\\n    assert run_attavo(root, \\\"drive\\\", \\\"1\\\", env=FAST).returncode == 0\\n    marker = json.loads((records_dir(root) / \\\"build-01.started\\\").read_text())\\n    assert marker[\\\"events\\\"] == str(git_dir(root) / \\\"attavo\\\"), marker\\n    wait_for(lambda: record_files(root, \\\"build\\\") != [])\\n\\n\\ndef test_a_pass_recovers_a_dead_invocation_and_recover_is_gone(tmp_path: Path) -> None:\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    git(root, \\\"checkout\\\", \\\"-q\\\", \\\"-b\\\", \\\"attavo/1-x\\\")\\n    add_forge(root, GREEN_FORGE)\\n    add_drive_stall_bound(root)\\n    approve_item(root)\\n    write_dead_marker(root, \\\"build\\\", 1)\\n    gone = run_attavo(root, \\\"drive\\\", \\\"--recover\\\", \\\"1\\\", env=FAST)\\n    assert gone.returncode == 2 and \\\"gone\\\" in gone.stderr, gone.stdout + gone.stderr\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\", env=FAST)\\n    assert run.returncode == 0, run.stdout + run.stderr\\n    rec = latest_record(root, \\\"build\\\")\\n    assert rec[\\\"stop\\\"][\\\"class\\\"] == \\\"died\\\", rec[\\\"stop\\\"]\\n\\n\\ndef test_the_review_takes_the_checks_the_pass_read_and_never_polls(tmp_path: Path) -> None:\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    calls = tmp_path / \\\"forge-calls.txt\\\"\\n    forge = tmp_path / \\\"forge.sh\\\"\\n    forge.write_text(f'#!/bin/sh\\\\necho \\\"$1\\\" >> {calls}\\\\nprintf \\\"ci success\\\\\\\\n\\\"\\\\n')\\n    forge.chmod(0o755)\\n    add_forge(root, f\\\"sh {forge}\\\")\\n    add_drive_stall_bound(root)\\n    slow_adapter(root, 0)\\n    bare = add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n    assert run_attavo(root, \\\"drive\\\", \\\"1\\\", env=FAST).returncode == 0\\n    wait_for(lambda: pushed(bare, \\\"build record for item 1\\\"))\\n    wait_for(lambda: remote_head(bare) == head_of(root))\\n    calls.write_text(\\\"\\\")\\n    pre_marker = head_of(root)\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\", env=FAST)\\n    assert \\\"Review started\\\" in run.stdout, run.stdout + run.stderr\\n    wait_for(lambda: record_files(root, \\\"verify\\\") != [])\\n    rec = latest_record(root, \\\"verify\\\")\\n    assert rec[\\\"status\\\"] == \\\"pass\\\", rec\\n    assert rec[\\\"forge_checks\\\"][\\\"sha\\\"] == pre_marker, (rec[\\\"forge_checks\\\"], pre_marker)\\n    read_by = [l for l in calls.read_text().split() if l]\\n    assert read_by == [pre_marker], f\\\"the forge was read {len(read_by)} time(s) after the build: {read_by}\\\"\\n\\n\\ndef test_until_ready_is_a_loop_of_passes_that_returns_at_ready(tmp_path: Path) -> None:\\n    root, _ = built_tenant(tmp_path, seconds=0)\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\", \\\"--until-ready\\\", env=FAST)\\n    assert run.returncode == 0, run.stdout + run.stderr\\n    assert \\\"Build started\\\" in run.stdout and \\\"Review started\\\" in run.stdout, run.stdout\\n    assert run.stdout.strip().endswith(\\\"Ready to merge\\\"), run.stdout\\n    assert report(root)[\\\"state\\\"] == \\\"ready-to-merge\\\"\\n\\n\\ndef test_a_died_stage_retries_plainly_and_again_is_a_no_op_inside_the_budget(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"R3: died is one of the four plain retryable families -- the very\\n    next pass retries it on its own, with no operator and no --again\\n    needed; `--again` inside the budget is a no-op that says so, rather\\n    than starting a second attempt of its own.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    git(root, \\\"checkout\\\", \\\"-q\\\", \\\"-b\\\", \\\"attavo/1-x\\\")\\n    add_forge(root, GREEN_FORGE)\\n    add_drive_stall_bound(root)\\n    approve_item(root)\\n    write_dead_marker(root, \\\"build\\\", 1)\\n    assert run_attavo(root, \\\"drive\\\", \\\"1\\\", env=FAST).returncode == 0\\n    assert latest_record(root, \\\"build\\\")[\\\"stop\\\"][\\\"class\\\"] == \\\"died\\\"\\n    again = run_attavo(root, \\\"drive\\\", \\\"1\\\", \\\"--again\\\", \\\"--by\\\", \\\"alice\\\", env=FAST)\\n    assert again.returncode == 0 and \\\"retries on its own\\\" in again.stdout, again.stdout\\n    assert not (records_dir(root) / \\\"build-02.started\\\").exists()\\n    plain = run_attavo(root, \\\"drive\\\", \\\"1\\\", env=FAST)\\n    assert \\\"Build started\\\" in plain.stdout, plain.stdout + plain.stderr\\n    assert (records_dir(root) / \\\"build-02.started\\\").exists()\\n    wait_for(lambda: len(record_files(root, \\\"build\\\")) == 2)\\n    assert latest_record(root, \\\"build\\\")[\\\"retry_of\\\"] == \\\"build-01\\\"\\n\\n\\ndef test_all_from_the_checkout_passes_every_unmerged_branch_on_origin_and_removes_merged_copies(\\n        tmp_path: Path) -> None:\\n    from test_working_copy import add_merged_item, copy_of, tenant_on_main\\n    root, bare = tenant_on_main(tmp_path)\\n    add_merged_item(root, bare, \\\"2\\\")\\n    merged = copy_of(tmp_path, \\\"2\\\")\\n    git(root, \\\"worktree\\\", \\\"add\\\", \\\"-q\\\", str(merged), \\\"attavo/2-y\\\")\\n    run = run_attavo(root, \\\"drive\\\", \\\"--all\\\", env=FAST)\\n    assert run.returncode == 0, run.stdout + run.stderr\\n    assert \\\"attavo-worktree-1: attavo drive: Build started\\\" in run.stdout, run.stdout\\n    assert \\\"attavo-worktree-2: attavo drive: merged: removed attavo-worktree-2\\\" in run.stdout, run.stdout\\n    assert not merged.exists()\\n    wait_for(lambda: record_files(copy_of(tmp_path), \\\"build\\\") != [])\\n\\n\\ndef test_the_report_reads_running_for_the_whole_of_counsel_and_stopped_after_the_push(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"The heartbeat is the holder's, so it runs until the holder exits: a\\n    stopped build's worker is asked for counsel, and for the length of\\n    that run the report reads running and a pass starts and recovers\\n    nothing.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    add_drive_stall_bound(root)\\n    manifest = root / \\\"attavo.toml\\\"\\n    manifest.write_text(manifest.read_text().replace(\\n        '[executor]\\\\nbuild = \\\"fixture\\\"', '[executor]\\\\nbuild = \\\"fixture\\\"\\\\ncounsel = \\\"fixture\\\"'))\\n    commit_all(root, \\\"counsel configured\\\")\\n    bare = add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n    release = tmp_path / \\\"release-counsel\\\"\\n    env = {**FAST, \\\"ATTAVO_FIXTURE_QUESTION\\\": \\\"which overlay wins?\\\",\\n           \\\"ATTAVO_FIXTURE_COUNSEL_WAIT_FOR\\\": str(release)}\\n    assert run_attavo(root, \\\"drive\\\", \\\"1\\\", env=env).returncode == 0\\n    beat = git_dir(root) / \\\"attavo\\\" / \\\"build-01.heartbeat\\\"\\n    wait_for(lambda: record_files(root, \\\"build\\\") != [])\\n    worker = int(beat.read_text())\\n    # The stage command has returned; the worker is in counsel. Let the\\n    # heartbeat's own interval pass three times over: a beat that stopped\\n    # with the command reads stale by now.\\n    time.sleep(1.0)\\n    os.kill(worker, 0)\\n    assert time.time() - beat.stat().st_mtime < 0.6, \\\"the heartbeat is stale while the worker is alive\\\"\\n    r = report(root)\\n    assert (r[\\\"state\\\"], r[\\\"kind\\\"]) == (\\\"running\\\", \\\"waits\\\"), r\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\", env=FAST)\\n    assert run.returncode == 0, run.stdout + run.stderr\\n    assert \\\"started\\\" not in run.stdout and \\\"ecover\\\" not in run.stdout, run.stdout\\n    assert not (records_dir(root) / \\\"build-02.started\\\").exists()\\n    os.kill(worker, 0)\\n    release.touch()\\n    wait_for(lambda: pushed(bare, \\\"build record for item 1 (build-01)\\\"))\\n    assert latest_record(root, \\\"counsel\\\")[\\\"record\\\"] == \\\"build-01\\\"\\n    assert report(root)[\\\"state\\\"] == \\\"stopped\\\"\\n\\n\\ndef test_a_worker_whose_commit_is_refused_beats_until_it_returns_and_then_stops(\\n        tmp_path: Path, monkeypatch: Any) -> None:\\n    import threading\\n\\n    from attavo import drive\\n    from attavo.doctor import heartbeat_path\\n\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_drive_stall_bound(root)\\n    approve_item(root)\\n    monkeypatch.chdir(root)\\n    monkeypatch.setenv(\\\"ATTAVO_HEARTBEAT_S\\\", \\\"0.1\\\")\\n    seen: dict[str, float] = {}\\n\\n    def stage(argv: list[str]) -> int:\\n        (records_dir(root) / \\\"build-01.json\\\").write_text(\\\"{}\\\")\\n        return 0\\n\\n    def refuse(*_: Any) -> None:\\n        time.sleep(0.5)\\n        seen[\\\"age\\\"] = time.time() - heartbeat_path(root, \\\"build\\\", 1).stat().st_mtime\\n        raise RuntimeError(\\\"refused\\\")\\n\\n    monkeypatch.setattr(drive, \\\"cmd_build\\\", stage)\\n    monkeypatch.setattr(drive, \\\"latest_record\\\", lambda *_: {\\\"status\\\": \\\"pass\\\"})\\n    monkeypatch.setattr(drive, \\\"commit_record\\\", refuse)\\n    before = threading.active_count()\\n    assert drive._stage_body(\\\"1\\\", \\\"build\\\", 1) == 1\\n    assert seen[\\\"age\\\"] < 0.3, f\\\"the heartbeat had stopped {seen['age']:.2f}s before the refused commit\\\"\\n    assert threading.active_count() == before, \\\"the heartbeat thread outlived the worker's body\\\"\\n\\n\\ndef test_after_the_stage_record_is_pushed_the_checkout_is_clean_and_at_origin(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"The record is committed by the driver from a detached worktree and\\n    the checkout only fast-forwards to it: no untracked or modified file,\\n    HEAD at origin's branch, the record commit the driver's with one\\n    parent.\\\"\\\"\\\"\\n    root, bare = built_tenant(tmp_path, seconds=1)\\n    publish_approval(root)\\n    assert run_attavo(root, \\\"drive\\\", \\\"1\\\", env=FAST).returncode == 0\\n    wait_for(lambda: pushed(bare, \\\"build record for item 1 (build-01)\\\"))\\n    wait_for(lambda: remote_head(bare) == head_of(root), 5)\\n    assert git(root, \\\"status\\\", \\\"--porcelain\\\") == \\\"\\\", git(root, \\\"status\\\", \\\"--porcelain\\\")\\n    subject, author, parents = git(root, \\\"log\\\", \\\"-1\\\", \\\"--format=%s%x1f%an <%ae>%x1f%P\\\", \\\"HEAD\\\").strip().split(\\\"\\\\x1f\\\")\\n    assert \\\"build record for item 1\\\" in subject, subject\\n    assert author == \\\"attavo driver <driver@attavo.invalid>\\\", author\\n    assert len(parents.split()) == 1, parents\\n    made_here = [l for l in git(root, \\\"reflog\\\", \\\"show\\\", \\\"HEAD\\\").splitlines() if \\\"attavo:\\\" in l]\\n    assert all(\\\"fast-forward\\\" in l.lower() for l in made_here), \\\\\\n        \\\"the driver made a commit in the executor's checkout:\\\\n\\\" + \\\"\\\\n\\\".join(made_here)\\n    assert (records_dir(root) / \\\"build-01.json\\\").is_file()\\n    assert not list((git_dir(root) / \\\"attavo\\\").glob(\\\"transport/*/*\\\")), \\\"a transport worktree was left behind\\\"\\n\\n\\ndef test_a_pass_every_half_second_beside_a_worker_committing_its_records_hits_no_git_error(\\n        tmp_path: Path) -> None:\\n    \\\"\\\"\\\"The collision root cause 1 names (#261): passes run every 0.5 s\\n    while the detached worker commits its stage and counsel records --\\n    the specimen is tests/test_retry.py::test_counsels_verdict_routes_\\n    the_next_pass, which failed 8 of 40 runs that way before it was\\n    changed to run one pass. No pass and no worker reports a git error,\\n    and the records land.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    add_drive_stall_bound(root)\\n    slow_adapter(root, 0)\\n    manifest = root / \\\"attavo.toml\\\"\\n    manifest.write_text(manifest.read_text().replace(\\n        '[executor]\\\\nbuild = \\\"fixture\\\"', '[executor]\\\\nbuild = \\\"fixture\\\"\\\\ncounsel = \\\"fixture\\\"'))\\n    commit_all(root, \\\"counsel configured\\\")\\n    bare = add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n    publish_approval(root)\\n    # A commit that takes a while (a slow hook holds the index lock for its\\n    # length), so a commit and several passes overlap in time.\\n    hook = Path(git(root, \\\"rev-parse\\\", \\\"--git-path\\\", \\\"hooks/pre-commit\\\").strip())\\n    hook = hook if hook.is_absolute() else root / hook\\n    hook.write_text(\\\"#!/bin/sh\\\\nsleep 0.4\\\\n\\\")\\n    hook.chmod(0o755)\\n    response = tmp_path / \\\"counsel.json\\\"\\n    response.write_text(json.dumps({\\n        \\\"model\\\": \\\"fixture\\\", \\\"model_version\\\": None, \\\"adapter_version\\\": \\\"fixture-1\\\",\\n        \\\"tokens\\\": {\\\"input\\\": 1, \\\"output\\\": 1}, \\\"cost_usd\\\": 0.0, \\\"class\\\": \\\"question\\\", \\\"verdict\\\": \\\"person\\\",\\n        \\\"citations\\\": [{\\\"kind\\\": \\\"instruction\\\", \\\"path\\\": \\\"specs/1/spec.md\\\", \\\"symbol\\\": \\\"problem\\\"}],\\n        \\\"proposal\\\": {\\\"ruling_text\\\": None, \\\"patch\\\": None, \\\"question\\\": \\\"which overlay wins?\\\"}}))\\n    env = {**FAST, \\\"ATTAVO_FIXTURE_QUESTION\\\": \\\"which overlay wins?\\\",\\n           \\\"ATTAVO_FIXTURE_COUNSEL_RESPONSE\\\": str(response)}\\n    outputs: list[str] = []\\n    beat = git_dir(root) / \\\"attavo\\\" / \\\"build-01.heartbeat\\\"\\n\\n    def worker_alive() -> bool:\\n        try:\\n            os.kill(int(beat.read_text()), 0)\\n            return True\\n        except (OSError, ValueError):\\n            return False\\n\\n    deadline = time.monotonic() + 60\\n    started = False\\n    while time.monotonic() < deadline:\\n        run = run_attavo(root, \\\"drive\\\", \\\"1\\\", env=env)\\n        outputs.append(f\\\"rc={run.returncode}\\\\n{run.stdout}{run.stderr}\\\")\\n        started = started or beat.exists()\\n        if started and not worker_alive():\\n            break\\n        time.sleep(0.5)\\n    else:\\n        raise AssertionError(\\\"the worker never returned:\\\\n\\\" + \\\"\\\\n\\\".join(outputs))\\n    assert pushed(bare, \\\"build record for item 1 (build-01)\\\"), \\\"\\\\n\\\".join(outputs)\\n    outputs.append(f\\\"rc=0\\\\n{run_attavo(root, 'drive', '1', env=env).stdout}\\\")\\n    bad = [o for o in outputs if not o.startswith(\\\"rc=0\\\") or \\\"fatal\\\" in o or \\\"stopped: could not\\\" in o or \\\"error\\\" in o.lower()]\\n    assert not bad, \\\"a pass hit a git error:\\\\n\\\" + \\\"\\\\n\\\".join(bad)\\n    worker_log = (git_dir(root) / \\\"attavo\\\" / \\\"build-01.worker.log\\\").read_text()\\n    assert \\\"fatal\\\" not in worker_log and \\\"could not\\\" not in worker_log and \\\"error\\\" not in worker_log.lower(), worker_log\\n    assert latest_record(root, \\\"counsel\\\")[\\\"verdict\\\"] == \\\"person\\\"\\n    assert git(root, \\\"status\\\", \\\"--porcelain\\\") == \\\"\\\"\\n    made_here = [l for l in git(root, \\\"reflog\\\", \\\"show\\\", \\\"HEAD\\\").splitlines() if \\\"attavo:\\\" in l]\\n    assert all(\\\"fast-forward\\\" in l.lower() for l in made_here), \\\\\\n        \\\"a pass or the worker committed in the executor's checkout:\\\\n\\\" + \\\"\\\\n\\\".join(made_here)\\n    assert \\\"build record for item 1 (build-01)\\\" in git(root, \\\"log\\\", \\\"--format=%s\\\", \\\"origin/attavo/1-x\\\")\\n\",\"structuredPatch\":[{\"oldStart\":222,\"oldLines\":7,\"newStart\":222,\"newLines\":7,\"lines\":[\"         [\\\"git\\\", \\\"-C\\\", str(bare), \\\"log\\\", \\\"--format=%s\\\", \\\"attavo/1-x\\\"], capture_output=True, text=True).stdout)\",\" \",\" \",\"-def test_the_heartbeat_is_read_where_the_marker_says(tmp_path: Path) -> None:\",\"+def test_the_holders_heartbeat_is_read_where_its_marker_says(tmp_path: Path) -> None:\",\"     \\\"\\\"\\\"holder_heartbeat_path (#289): a marker from this host that names a\",\"     directory is read there, not assumed to be this checkout's own --\",\"     fresh there is running, absent there is still running while the\"]}],\"userModified\":false,\"replaceAll\":false,\"contentNotInModelContext\":true}}\n{\"type\":\"assistant\",\"message\":{\"model\":\"claude-sonnet-5\",\"id\":\"msg_011CfaUL7U7fuZXNvwyhALM8\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_01CArCWaGuRdB7LmP26r4euF\",\"name\":\"Edit\",\"input\":{\"replace_all\":false,\"file_path\":\"/Users/davidbean/Projects/attavo-worktree-289/tests/test_pass.py\",\"old_string\":\"def test_the_marker_a_pass_writes_names_its_checkouts_own_directory(tmp_path: Path) -> None:\",\"new_string\":\"def test_the_marker_a_pass_writes_names_its_checkouts_heartbeat_directory(tmp_path: Path) -> None:\"},\"caller\":{\"type\":\"direct\"}}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":485,\"cache_read_input_tokens\":156602,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":485},\"output_tokens\":16,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"b3f717aa-5c2b-4867-b022-0f24cffb6427\",\"uuid\":\"b827667a-7b49-41db-a7f5-f6a7d7e0a6c1\",\"timestamp\":\"2026-09-30T23:13:29.731Z\",\"request_id\":\"req_011CfaUL781uVz6TGisy6mHf\",\"wire_tool_inputs\":{\"toolu_01CArCWaGuRdB7LmP26r4euF\":{\"file_path\":\"/Users/davidbean/Projects/attavo-worktree-289/tests/test_pass.py\",\"old_string\":\"def test_the_marker_a_pass_writes_names_its_checkouts_own_directory(tmp_path: Path) -> None:\",\"new_string\":\"def test_the_marker_a_pass_writes_names_its_checkouts_heartbeat_directory(tmp_path: Path) -> None:\"}}}\n{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01CArCWaGuRdB7LmP26r4euF\",\"type\":\"tool_result\",\"content\":\"The file /Users/davidbean/Projects/attavo-worktree-289/tests/test_pass.py has been updated successfully.\"}]},\"parent_tool_use_id\":null,\"session_id\":\"b3f717aa-5c2b-4867-b022-0f24cffb6427\",\"uuid\":\"a29c5c05-0978-480b-90b8-2eea159dc437\",\"timestamp\":\"2026-09-30T23:13:29.766Z\",\"tool_use_result\":{\"filePath\":\"/Users/davidbean/Projects/attavo-worktree-289/tests/test_pass.py\",\"oldString\":\"def test_the_marker_a_pass_writes_names_its_checkouts_own_directory(tmp_path: Path) -> None:\",\"newString\":\"def test_the_marker_a_pass_writes_names_its_checkouts_heartbeat_directory(tmp_path: Path) -> None:\",\"originalFile\":\"\\\"\\\"\\\"The reconciler's R2 (claude/reconciler-brief-2026-09-20.md, rulings A, B,\\nH): `attavo drive N` is one short pass that reads the report, acts at most\\nonce, and returns; a stage runs in a detached worker with its own\\nheartbeat; the marker's push is the lease; recovery is the pass's; the\\nreview takes the checks the pass read on the pre-marker head.\\n\\nRun: python3 -m pytest tests -q\\n\\\"\\\"\\\"\\nfrom __future__ import annotations\\n\\nimport json\\nimport os\\nimport socket\\nimport subprocess\\nimport sys\\nimport time\\nfrom pathlib import Path\\nfrom typing import Any\\n\\nfrom helpers import commit_all, git, make_tenant\\nfrom test_drive import (\\n    GREEN_FORGE,\\n    add_bare_remote,\\n    add_drive_stall_bound,\\n    add_forge,\\n    approve_item,\\n    head_of,\\n    publish_approval,\\n    latest_record,\\n    record_files,\\n    records_dir,\\n    remote_head,\\n    run_attavo,\\n    write_dead_marker,\\n)\\n\\nROOT = Path(__file__).resolve().parent.parent\\nFAST = {\\\"ATTAVO_HEARTBEAT_S\\\": \\\"0.2\\\", \\\"ATTAVO_DRIVE_POLL_INTERVAL_S\\\": \\\"0.5\\\"}\\n\\n\\ndef slow_adapter(root: Path, seconds: float) -> None:\\n    \\\"\\\"\\\"A tenant-side build adapter: the product's own fixture adapter,\\n    after `seconds` of sleep on the build stage.\\\"\\\"\\\"\\n    d = root / \\\"attavo\\\" / \\\"adapters\\\" / \\\"fixture\\\"\\n    d.mkdir(parents=True, exist_ok=True)\\n    run = d / \\\"run\\\"\\n    run.write_text(f'#!/bin/sh\\\\nif [ \\\"${{ATTAVO_STAGE:-build}}\\\" = build ]; then sleep {seconds}; fi\\\\n'\\n                   f'exec sh {ROOT / \\\"adapters\\\" / \\\"fixture\\\" / \\\"run\\\"}\\\\n')\\n    run.chmod(0o755)\\n    commit_all(root, \\\"a slow tenant-side adapter\\\")\\n\\n\\ndef git_dir(root: Path) -> Path:\\n    return Path(git(root, \\\"rev-parse\\\", \\\"--absolute-git-dir\\\").strip())\\n\\n\\ndef report(root: Path, env: dict[str, str] | None = None) -> dict[str, Any]:\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\", \\\"--report\\\", env={**FAST, **(env or {})})\\n    assert run.returncode == 0, run.stdout + run.stderr\\n    out: dict[str, Any] = json.loads(run.stdout)\\n    return out\\n\\n\\ndef pushed(bare: Path, subject: str) -> bool:\\n    log = subprocess.run([\\\"git\\\", \\\"-C\\\", str(bare), \\\"log\\\", \\\"--format=%s\\\", \\\"attavo/1-x\\\"], capture_output=True, text=True).stdout\\n    return subject in log\\n\\n\\ndef wait_for(pred: Any, seconds: float = 20) -> None:\\n    deadline = time.monotonic() + seconds\\n    while time.monotonic() < deadline:\\n        if pred():\\n            return\\n        time.sleep(0.2)\\n    raise AssertionError(\\\"condition not met in time\\\")\\n\\n\\ndef passes_until(root: Path, pred: Any, seconds: float = 40, env: dict[str, str] | None = None) -> None:\\n    \\\"\\\"\\\"Passes, spaced, until pred holds: how an operator's loop, the\\n    screen's poll, or a scheduler line would drive the item.\\\"\\\"\\\"\\n    deadline = time.monotonic() + seconds\\n    full = dict(FAST)\\n    full.update(env or {})\\n    while time.monotonic() < deadline:\\n        run_attavo(root, \\\"drive\\\", \\\"1\\\", env=full)\\n        if pred():\\n            return\\n        time.sleep(0.5)\\n    raise AssertionError(\\\"condition not met in time\\\")\\n\\n\\ndef clock_ahead(tmp_path: Path, seconds: float) -> dict[str, str]:\\n    \\\"\\\"\\\"The environment that puts every bound the product judges `seconds`\\n    past the machine's now (#257): a clock file, named by ATTAVO_CLOCK_FILE,\\n    that the next pass reads instead of waiting.\\\"\\\"\\\"\\n    path = tmp_path / \\\"attavo-clock\\\"\\n    path.write_text(str(time.time() + seconds))\\n    return {\\\"ATTAVO_CLOCK_FILE\\\": str(path)}\\n\\n\\ndef built_tenant(tmp_path: Path, seconds: float = 3) -> tuple[Path, Path]:\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    add_drive_stall_bound(root)\\n    slow_adapter(root, seconds)\\n    bare = add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n    return root, bare\\n\\n\\ndef test_a_pass_returns_while_the_worker_runs_and_the_worker_outlives_it(tmp_path: Path) -> None:\\n    root, bare = built_tenant(tmp_path, seconds=3)\\n    started = time.monotonic()\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\", env=FAST)\\n    elapsed = time.monotonic() - started\\n    assert run.returncode == 0, run.stdout + run.stderr\\n    assert elapsed < 2.5, f\\\"the pass took {elapsed:.1f}s: it waited for the stage\\\"\\n    assert \\\"Build started\\\" in run.stdout, run.stdout\\n    assert (records_dir(root) / \\\"build-01.started\\\").exists()\\n    assert remote_head(bare) == head_of(root), \\\"the marker was not pushed before the pass returned\\\"\\n    assert record_files(root, \\\"build\\\") == [], \\\"the record existed before the worker could have written it\\\"\\n    wait_for(lambda: record_files(root, \\\"build\\\") != [])\\n    wait_for(lambda: remote_head(bare) == head_of(root))\\n    assert latest_record(root, \\\"build\\\")[\\\"status\\\"] == \\\"pass\\\"\\n\\n\\ndef test_the_worker_touches_its_heartbeat_and_the_report_reads_running_by_it(tmp_path: Path) -> None:\\n    root, _ = built_tenant(tmp_path, seconds=3)\\n    assert run_attavo(root, \\\"drive\\\", \\\"1\\\", env=FAST).returncode == 0\\n    beat = git_dir(root) / \\\"attavo\\\" / \\\"build-01.heartbeat\\\"\\n    wait_for(beat.exists, 5)\\n    first = beat.stat().st_mtime\\n    time.sleep(0.6)\\n    assert beat.stat().st_mtime > first, \\\"the heartbeat did not move\\\"\\n    r = report(root)\\n    assert (r[\\\"state\\\"], r[\\\"kind\\\"]) == (\\\"running\\\", \\\"waits\\\"), r\\n    wait_for(lambda: record_files(root, \\\"build\\\") != [])\\n\\n\\ndef test_a_stale_heartbeat_reads_died_though_the_pid_lives_and_a_fresh_one_reads_alive(tmp_path: Path) -> None:\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    git(root, \\\"checkout\\\", \\\"-q\\\", \\\"-b\\\", \\\"attavo/1-x\\\")\\n    add_forge(root, GREEN_FORGE)\\n    add_drive_stall_bound(root, 600)\\n    approve_item(root)\\n    d = records_dir(root)\\n    d.mkdir(parents=True, exist_ok=True)\\n    marker = d / \\\"build-01.started\\\"\\n    now = time.strftime(\\\"%Y-%m-%dT%H:%M:%SZ\\\", time.gmtime())\\n    marker.write_text(json.dumps({\\\"at\\\": now, \\\"host\\\": socket.gethostname(),\\n                                  \\\"pid\\\": os.getpid(), \\\"sha\\\": head_of(root), \\\"product_version\\\": \\\"fixture\\\"}))\\n    commit_all(root, \\\"a marker whose pid is this test\\\")\\n    beat = git_dir(root) / \\\"attavo\\\" / \\\"build-01.heartbeat\\\"\\n    beat.parent.mkdir(parents=True, exist_ok=True)\\n    beat.touch()\\n    os.utime(beat, (time.time() - 60, time.time() - 60))\\n    r = report(root)\\n    assert (r[\\\"state\\\"], r[\\\"stop_class\\\"]) == (\\\"owes-recovery\\\", \\\"died\\\"), r\\n    beat.touch()\\n    r = report(root)\\n    assert r[\\\"state\\\"] == \\\"running\\\", r\\n\\n\\ndef test_two_passes_at_once_start_one_worker_and_the_loser_says_so(tmp_path: Path) -> None:\\n    root, bare = built_tenant(tmp_path, seconds=3)\\n    publish_approval(root)\\n    clone = tmp_path / \\\"second\\\"\\n    git(root.parent, \\\"clone\\\", \\\"-q\\\", \\\"-b\\\", git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip(), str(bare), str(clone))\\n    git(clone, \\\"config\\\", \\\"user.email\\\", \\\"test@example.com\\\")\\n    git(clone, \\\"config\\\", \\\"user.name\\\", \\\"Attavo Test\\\")\\n    git(clone, \\\"remote\\\", \\\"set-head\\\", \\\"origin\\\", \\\"-a\\\")\\n    env = dict(os.environ)\\n    env.update(FAST)\\n    before = {c: (head_of(c), git(c, \\\"ls-files\\\", \\\"-s\\\"), git(c, \\\"status\\\", \\\"--porcelain\\\")) for c in (root, clone)}\\n    procs = [subprocess.Popen([sys.executable, str(ROOT / \\\"bin\\\" / \\\"attavo\\\"), \\\"drive\\\", \\\"1\\\"], cwd=str(c),\\n                              env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)\\n             for c in (root, clone)]\\n    outs = [p.communicate(timeout=30)[0] for p in procs]\\n    started = [o for o in outs if \\\"Build started\\\" in o]\\n    held = [o for o in outs if \\\"another pass holds\\\" in o]\\n    assert len(started) == 1 and len(held) == 1, outs\\n    loser = clone if \\\"another pass holds\\\" in outs[1] else root\\n    assert (head_of(loser), git(loser, \\\"ls-files\\\", \\\"-s\\\"), git(loser, \\\"status\\\", \\\"--porcelain\\\")) == before[loser], \\\\\\n        \\\"the loser's checkout (HEAD, index, working tree) moved\\\"\\n    assert \\\"reset\\\" not in git(loser, \\\"reflog\\\", \\\"show\\\", \\\"HEAD\\\"), git(loser, \\\"reflog\\\", \\\"show\\\", \\\"HEAD\\\")\\n    log = subprocess.run([\\\"git\\\", \\\"-C\\\", str(bare), \\\"log\\\", \\\"--format=%s\\\", \\\"attavo/1-x\\\"], capture_output=True, text=True).stdout\\n    assert log.count(\\\"build invocation 01 started\\\") == 1, log\\n    wait_for(lambda: \\\"build record for item 1\\\" in subprocess.run(\\n        [\\\"git\\\", \\\"-C\\\", str(bare), \\\"log\\\", \\\"--format=%s\\\", \\\"attavo/1-x\\\"], capture_output=True, text=True).stdout)\\n\\n\\ndef test_a_second_checkout_on_this_host_reads_the_first_ones_worker_as_running(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"The race made deterministic (#289): two checkouts of one tenant on\\n    one host is ordinary now, since the product owns each item's own\\n    working copy. Run the second's pass only after the first's marker has\\n    already landed -- no race for the lease at all -- and it must still\\n    read the first's heartbeat where its marker says to look, see it\\n    running, start nothing, and push no second invocation.\\\"\\\"\\\"\\n    root, bare = built_tenant(tmp_path, seconds=3)\\n    publish_approval(root)\\n    clone = tmp_path / \\\"second\\\"\\n    git(root.parent, \\\"clone\\\", \\\"-q\\\", \\\"-b\\\", git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip(),\\n        str(bare), str(clone))\\n    git(clone, \\\"config\\\", \\\"user.email\\\", \\\"test@example.com\\\")\\n    git(clone, \\\"config\\\", \\\"user.name\\\", \\\"Attavo Test\\\")\\n    git(clone, \\\"remote\\\", \\\"set-head\\\", \\\"origin\\\", \\\"-a\\\")\\n\\n    first = run_attavo(root, \\\"drive\\\", \\\"1\\\", env=FAST)\\n    assert \\\"Build started\\\" in first.stdout, first.stdout + first.stderr\\n\\n    second = run_attavo(clone, \\\"drive\\\", \\\"1\\\", env=FAST)\\n    assert second.returncode == 0, second.stdout + second.stderr\\n    assert \\\"Build started\\\" not in second.stdout, second.stdout\\n    assert \\\"another pass holds\\\" not in second.stdout, second.stdout\\n    assert \\\"running\\\" in second.stdout.lower(), second.stdout\\n\\n    log = subprocess.run([\\\"git\\\", \\\"-C\\\", str(bare), \\\"log\\\", \\\"--format=%s\\\", \\\"attavo/1-x\\\"],\\n                         capture_output=True, text=True).stdout\\n    assert log.count(\\\"build invocation 01 started\\\") == 1, log\\n    assert not (records_dir(clone) / \\\"build-02.started\\\").exists()\\n    wait_for(lambda: \\\"build record for item 1\\\" in subprocess.run(\\n        [\\\"git\\\", \\\"-C\\\", str(bare), \\\"log\\\", \\\"--format=%s\\\", \\\"attavo/1-x\\\"], capture_output=True, text=True).stdout)\\n\\n\\ndef test_the_holders_heartbeat_is_read_where_its_marker_says(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"holder_heartbeat_path (#289): a marker from this host that names a\\n    directory is read there, not assumed to be this checkout's own --\\n    fresh there is running, absent there is still running while the\\n    marker is younger than the stall bound, and died once it is older.\\n    A marker with no `events` at all (written before this release) reads\\n    exactly as it always did: died the moment there is no heartbeat in\\n    this checkout's own directory, whatever the marker's own age.\\\"\\\"\\\"\\n    from attavo.doctor import heartbeat_path, holder_heartbeat_path, invocation_marker_path\\n    from attavo.drive import read_invocation\\n\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    git(root, \\\"checkout\\\", \\\"-q\\\", \\\"-b\\\", \\\"attavo/1-x\\\")\\n    bound = 5\\n    now = time.strftime(\\\"%Y-%m-%dT%H:%M:%SZ\\\", time.gmtime())\\n    old = time.strftime(\\\"%Y-%m-%dT%H:%M:%SZ\\\", time.gmtime(time.time() - bound * 10))\\n    other_events = tmp_path / \\\"other-checkout\\\" / \\\"attavo\\\"\\n    other_events.mkdir(parents=True)\\n    marker = invocation_marker_path(records_dir(root), \\\"build\\\", 1)\\n\\n    info = {\\\"at\\\": now, \\\"host\\\": socket.gethostname(), \\\"sha\\\": head_of(root),\\n            \\\"product_version\\\": \\\"fixture\\\", \\\"events\\\": str(other_events)}\\n    beat = holder_heartbeat_path(root, info, \\\"build\\\", 1)\\n    assert beat == other_events / \\\"build-01.heartbeat\\\"\\n\\n    beat.write_text(\\\"4242\\\\n\\\")\\n    assert read_invocation(root, bound, marker, info).cls == \\\"running\\\"\\n\\n    beat.unlink()\\n    assert read_invocation(root, bound, marker, info).cls == \\\"running\\\"\\n\\n    info_old = {**info, \\\"at\\\": old}\\n    assert read_invocation(root, bound, marker, info_old).cls == \\\"died\\\"\\n\\n    legacy = {\\\"at\\\": now, \\\"host\\\": socket.gethostname(), \\\"sha\\\": head_of(root),\\n             \\\"product_version\\\": \\\"fixture\\\"}\\n    assert holder_heartbeat_path(root, legacy, \\\"build\\\", 1) == heartbeat_path(root, \\\"build\\\", 1)\\n    assert read_invocation(root, bound, marker, legacy).cls == \\\"died\\\"\\n\\n\\ndef test_the_marker_a_pass_writes_names_its_checkouts_own_directory(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"write_invocation_marker's own `events` field, from `attavo drive`\\n    itself (#289): the marker is committed and pushed from a detached\\n    worktree, but `events` must still name the checkout's own\\n    <git-dir>/attavo, never that worktree's -- otherwise a second\\n    checkout reading this marker later would look for the heartbeat in a\\n    directory removed the moment the marker's own push returned.\\\"\\\"\\\"\\n    root, bare = built_tenant(tmp_path, seconds=0)\\n    assert run_attavo(root, \\\"drive\\\", \\\"1\\\", env=FAST).returncode == 0\\n    marker = json.loads((records_dir(root) / \\\"build-01.started\\\").read_text())\\n    assert marker[\\\"events\\\"] == str(git_dir(root) / \\\"attavo\\\"), marker\\n    wait_for(lambda: record_files(root, \\\"build\\\") != [])\\n\\n\\ndef test_a_pass_recovers_a_dead_invocation_and_recover_is_gone(tmp_path: Path) -> None:\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    git(root, \\\"checkout\\\", \\\"-q\\\", \\\"-b\\\", \\\"attavo/1-x\\\")\\n    add_forge(root, GREEN_FORGE)\\n    add_drive_stall_bound(root)\\n    approve_item(root)\\n    write_dead_marker(root, \\\"build\\\", 1)\\n    gone = run_attavo(root, \\\"drive\\\", \\\"--recover\\\", \\\"1\\\", env=FAST)\\n    assert gone.returncode == 2 and \\\"gone\\\" in gone.stderr, gone.stdout + gone.stderr\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\", env=FAST)\\n    assert run.returncode == 0, run.stdout + run.stderr\\n    rec = latest_record(root, \\\"build\\\")\\n    assert rec[\\\"stop\\\"][\\\"class\\\"] == \\\"died\\\", rec[\\\"stop\\\"]\\n\\n\\ndef test_the_review_takes_the_checks_the_pass_read_and_never_polls(tmp_path: Path) -> None:\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    calls = tmp_path / \\\"forge-calls.txt\\\"\\n    forge = tmp_path / \\\"forge.sh\\\"\\n    forge.write_text(f'#!/bin/sh\\\\necho \\\"$1\\\" >> {calls}\\\\nprintf \\\"ci success\\\\\\\\n\\\"\\\\n')\\n    forge.chmod(0o755)\\n    add_forge(root, f\\\"sh {forge}\\\")\\n    add_drive_stall_bound(root)\\n    slow_adapter(root, 0)\\n    bare = add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n    assert run_attavo(root, \\\"drive\\\", \\\"1\\\", env=FAST).returncode == 0\\n    wait_for(lambda: pushed(bare, \\\"build record for item 1\\\"))\\n    wait_for(lambda: remote_head(bare) == head_of(root))\\n    calls.write_text(\\\"\\\")\\n    pre_marker = head_of(root)\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\", env=FAST)\\n    assert \\\"Review started\\\" in run.stdout, run.stdout + run.stderr\\n    wait_for(lambda: record_files(root, \\\"verify\\\") != [])\\n    rec = latest_record(root, \\\"verify\\\")\\n    assert rec[\\\"status\\\"] == \\\"pass\\\", rec\\n    assert rec[\\\"forge_checks\\\"][\\\"sha\\\"] == pre_marker, (rec[\\\"forge_checks\\\"], pre_marker)\\n    read_by = [l for l in calls.read_text().split() if l]\\n    assert read_by == [pre_marker], f\\\"the forge was read {len(read_by)} time(s) after the build: {read_by}\\\"\\n\\n\\ndef test_until_ready_is_a_loop_of_passes_that_returns_at_ready(tmp_path: Path) -> None:\\n    root, _ = built_tenant(tmp_path, seconds=0)\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\", \\\"--until-ready\\\", env=FAST)\\n    assert run.returncode == 0, run.stdout + run.stderr\\n    assert \\\"Build started\\\" in run.stdout and \\\"Review started\\\" in run.stdout, run.stdout\\n    assert run.stdout.strip().endswith(\\\"Ready to merge\\\"), run.stdout\\n    assert report(root)[\\\"state\\\"] == \\\"ready-to-merge\\\"\\n\\n\\ndef test_a_died_stage_retries_plainly_and_again_is_a_no_op_inside_the_budget(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"R3: died is one of the four plain retryable families -- the very\\n    next pass retries it on its own, with no operator and no --again\\n    needed; `--again` inside the budget is a no-op that says so, rather\\n    than starting a second attempt of its own.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    git(root, \\\"checkout\\\", \\\"-q\\\", \\\"-b\\\", \\\"attavo/1-x\\\")\\n    add_forge(root, GREEN_FORGE)\\n    add_drive_stall_bound(root)\\n    approve_item(root)\\n    write_dead_marker(root, \\\"build\\\", 1)\\n    assert run_attavo(root, \\\"drive\\\", \\\"1\\\", env=FAST).returncode == 0\\n    assert latest_record(root, \\\"build\\\")[\\\"stop\\\"][\\\"class\\\"] == \\\"died\\\"\\n    again = run_attavo(root, \\\"drive\\\", \\\"1\\\", \\\"--again\\\", \\\"--by\\\", \\\"alice\\\", env=FAST)\\n    assert again.returncode == 0 and \\\"retries on its own\\\" in again.stdout, again.stdout\\n    assert not (records_dir(root) / \\\"build-02.started\\\").exists()\\n    plain = run_attavo(root, \\\"drive\\\", \\\"1\\\", env=FAST)\\n    assert \\\"Build started\\\" in plain.stdout, plain.stdout + plain.stderr\\n    assert (records_dir(root) / \\\"build-02.started\\\").exists()\\n    wait_for(lambda: len(record_files(root, \\\"build\\\")) == 2)\\n    assert latest_record(root, \\\"build\\\")[\\\"retry_of\\\"] == \\\"build-01\\\"\\n\\n\\ndef test_all_from_the_checkout_passes_every_unmerged_branch_on_origin_and_removes_merged_copies(\\n        tmp_path: Path) -> None:\\n    from test_working_copy import add_merged_item, copy_of, tenant_on_main\\n    root, bare = tenant_on_main(tmp_path)\\n    add_merged_item(root, bare, \\\"2\\\")\\n    merged = copy_of(tmp_path, \\\"2\\\")\\n    git(root, \\\"worktree\\\", \\\"add\\\", \\\"-q\\\", str(merged), \\\"attavo/2-y\\\")\\n    run = run_attavo(root, \\\"drive\\\", \\\"--all\\\", env=FAST)\\n    assert run.returncode == 0, run.stdout + run.stderr\\n    assert \\\"attavo-worktree-1: attavo drive: Build started\\\" in run.stdout, run.stdout\\n    assert \\\"attavo-worktree-2: attavo drive: merged: removed attavo-worktree-2\\\" in run.stdout, run.stdout\\n    assert not merged.exists()\\n    wait_for(lambda: record_files(copy_of(tmp_path), \\\"build\\\") != [])\\n\\n\\ndef test_the_report_reads_running_for_the_whole_of_counsel_and_stopped_after_the_push(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"The heartbeat is the holder's, so it runs until the holder exits: a\\n    stopped build's worker is asked for counsel, and for the length of\\n    that run the report reads running and a pass starts and recovers\\n    nothing.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    add_drive_stall_bound(root)\\n    manifest = root / \\\"attavo.toml\\\"\\n    manifest.write_text(manifest.read_text().replace(\\n        '[executor]\\\\nbuild = \\\"fixture\\\"', '[executor]\\\\nbuild = \\\"fixture\\\"\\\\ncounsel = \\\"fixture\\\"'))\\n    commit_all(root, \\\"counsel configured\\\")\\n    bare = add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n    release = tmp_path / \\\"release-counsel\\\"\\n    env = {**FAST, \\\"ATTAVO_FIXTURE_QUESTION\\\": \\\"which overlay wins?\\\",\\n           \\\"ATTAVO_FIXTURE_COUNSEL_WAIT_FOR\\\": str(release)}\\n    assert run_attavo(root, \\\"drive\\\", \\\"1\\\", env=env).returncode == 0\\n    beat = git_dir(root) / \\\"attavo\\\" / \\\"build-01.heartbeat\\\"\\n    wait_for(lambda: record_files(root, \\\"build\\\") != [])\\n    worker = int(beat.read_text())\\n    # The stage command has returned; the worker is in counsel. Let the\\n    # heartbeat's own interval pass three times over: a beat that stopped\\n    # with the command reads stale by now.\\n    time.sleep(1.0)\\n    os.kill(worker, 0)\\n    assert time.time() - beat.stat().st_mtime < 0.6, \\\"the heartbeat is stale while the worker is alive\\\"\\n    r = report(root)\\n    assert (r[\\\"state\\\"], r[\\\"kind\\\"]) == (\\\"running\\\", \\\"waits\\\"), r\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\", env=FAST)\\n    assert run.returncode == 0, run.stdout + run.stderr\\n    assert \\\"started\\\" not in run.stdout and \\\"ecover\\\" not in run.stdout, run.stdout\\n    assert not (records_dir(root) / \\\"build-02.started\\\").exists()\\n    os.kill(worker, 0)\\n    release.touch()\\n    wait_for(lambda: pushed(bare, \\\"build record for item 1 (build-01)\\\"))\\n    assert latest_record(root, \\\"counsel\\\")[\\\"record\\\"] == \\\"build-01\\\"\\n    assert report(root)[\\\"state\\\"] == \\\"stopped\\\"\\n\\n\\ndef test_a_worker_whose_commit_is_refused_beats_until_it_returns_and_then_stops(\\n        tmp_path: Path, monkeypatch: Any) -> None:\\n    import threading\\n\\n    from attavo import drive\\n    from attavo.doctor import heartbeat_path\\n\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_drive_stall_bound(root)\\n    approve_item(root)\\n    monkeypatch.chdir(root)\\n    monkeypatch.setenv(\\\"ATTAVO_HEARTBEAT_S\\\", \\\"0.1\\\")\\n    seen: dict[str, float] = {}\\n\\n    def stage(argv: list[str]) -> int:\\n        (records_dir(root) / \\\"build-01.json\\\").write_text(\\\"{}\\\")\\n        return 0\\n\\n    def refuse(*_: Any) -> None:\\n        time.sleep(0.5)\\n        seen[\\\"age\\\"] = time.time() - heartbeat_path(root, \\\"build\\\", 1).stat().st_mtime\\n        raise RuntimeError(\\\"refused\\\")\\n\\n    monkeypatch.setattr(drive, \\\"cmd_build\\\", stage)\\n    monkeypatch.setattr(drive, \\\"latest_record\\\", lambda *_: {\\\"status\\\": \\\"pass\\\"})\\n    monkeypatch.setattr(drive, \\\"commit_record\\\", refuse)\\n    before = threading.active_count()\\n    assert drive._stage_body(\\\"1\\\", \\\"build\\\", 1) == 1\\n    assert seen[\\\"age\\\"] < 0.3, f\\\"the heartbeat had stopped {seen['age']:.2f}s before the refused commit\\\"\\n    assert threading.active_count() == before, \\\"the heartbeat thread outlived the worker's body\\\"\\n\\n\\ndef test_after_the_stage_record_is_pushed_the_checkout_is_clean_and_at_origin(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"The record is committed by the driver from a detached worktree and\\n    the checkout only fast-forwards to it: no untracked or modified file,\\n    HEAD at origin's branch, the record commit the driver's with one\\n    parent.\\\"\\\"\\\"\\n    root, bare = built_tenant(tmp_path, seconds=1)\\n    publish_approval(root)\\n    assert run_attavo(root, \\\"drive\\\", \\\"1\\\", env=FAST).returncode == 0\\n    wait_for(lambda: pushed(bare, \\\"build record for item 1 (build-01)\\\"))\\n    wait_for(lambda: remote_head(bare) == head_of(root), 5)\\n    assert git(root, \\\"status\\\", \\\"--porcelain\\\") == \\\"\\\", git(root, \\\"status\\\", \\\"--porcelain\\\")\\n    subject, author, parents = git(root, \\\"log\\\", \\\"-1\\\", \\\"--format=%s%x1f%an <%ae>%x1f%P\\\", \\\"HEAD\\\").strip().split(\\\"\\\\x1f\\\")\\n    assert \\\"build record for item 1\\\" in subject, subject\\n    assert author == \\\"attavo driver <driver@attavo.invalid>\\\", author\\n    assert len(parents.split()) == 1, parents\\n    made_here = [l for l in git(root, \\\"reflog\\\", \\\"show\\\", \\\"HEAD\\\").splitlines() if \\\"attavo:\\\" in l]\\n    assert all(\\\"fast-forward\\\" in l.lower() for l in made_here), \\\\\\n        \\\"the driver made a commit in the executor's checkout:\\\\n\\\" + \\\"\\\\n\\\".join(made_here)\\n    assert (records_dir(root) / \\\"build-01.json\\\").is_file()\\n    assert not list((git_dir(root) / \\\"attavo\\\").glob(\\\"transport/*/*\\\")), \\\"a transport worktree was left behind\\\"\\n\\n\\ndef test_a_pass_every_half_second_beside_a_worker_committing_its_records_hits_no_git_error(\\n        tmp_path: Path) -> None:\\n    \\\"\\\"\\\"The collision root cause 1 names (#261): passes run every 0.5 s\\n    while the detached worker commits its stage and counsel records --\\n    the specimen is tests/test_retry.py::test_counsels_verdict_routes_\\n    the_next_pass, which failed 8 of 40 runs that way before it was\\n    changed to run one pass. No pass and no worker reports a git error,\\n    and the records land.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    add_drive_stall_bound(root)\\n    slow_adapter(root, 0)\\n    manifest = root / \\\"attavo.toml\\\"\\n    manifest.write_text(manifest.read_text().replace(\\n        '[executor]\\\\nbuild = \\\"fixture\\\"', '[executor]\\\\nbuild = \\\"fixture\\\"\\\\ncounsel = \\\"fixture\\\"'))\\n    commit_all(root, \\\"counsel configured\\\")\\n    bare = add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n    publish_approval(root)\\n    # A commit that takes a while (a slow hook holds the index lock for its\\n    # length), so a commit and several passes overlap in time.\\n    hook = Path(git(root, \\\"rev-parse\\\", \\\"--git-path\\\", \\\"hooks/pre-commit\\\").strip())\\n    hook = hook if hook.is_absolute() else root / hook\\n    hook.write_text(\\\"#!/bin/sh\\\\nsleep 0.4\\\\n\\\")\\n    hook.chmod(0o755)\\n    response = tmp_path / \\\"counsel.json\\\"\\n    response.write_text(json.dumps({\\n        \\\"model\\\": \\\"fixture\\\", \\\"model_version\\\": None, \\\"adapter_version\\\": \\\"fixture-1\\\",\\n        \\\"tokens\\\": {\\\"input\\\": 1, \\\"output\\\": 1}, \\\"cost_usd\\\": 0.0, \\\"class\\\": \\\"question\\\", \\\"verdict\\\": \\\"person\\\",\\n        \\\"citations\\\": [{\\\"kind\\\": \\\"instruction\\\", \\\"path\\\": \\\"specs/1/spec.md\\\", \\\"symbol\\\": \\\"problem\\\"}],\\n        \\\"proposal\\\": {\\\"ruling_text\\\": None, \\\"patch\\\": None, \\\"question\\\": \\\"which overlay wins?\\\"}}))\\n    env = {**FAST, \\\"ATTAVO_FIXTURE_QUESTION\\\": \\\"which overlay wins?\\\",\\n           \\\"ATTAVO_FIXTURE_COUNSEL_RESPONSE\\\": str(response)}\\n    outputs: list[str] = []\\n    beat = git_dir(root) / \\\"attavo\\\" / \\\"build-01.heartbeat\\\"\\n\\n    def worker_alive() -> bool:\\n        try:\\n            os.kill(int(beat.read_text()), 0)\\n            return True\\n        except (OSError, ValueError):\\n            return False\\n\\n    deadline = time.monotonic() + 60\\n    started = False\\n    while time.monotonic() < deadline:\\n        run = run_attavo(root, \\\"drive\\\", \\\"1\\\", env=env)\\n        outputs.append(f\\\"rc={run.returncode}\\\\n{run.stdout}{run.stderr}\\\")\\n        started = started or beat.exists()\\n        if started and not worker_alive():\\n            break\\n        time.sleep(0.5)\\n    else:\\n        raise AssertionError(\\\"the worker never returned:\\\\n\\\" + \\\"\\\\n\\\".join(outputs))\\n    assert pushed(bare, \\\"build record for item 1 (build-01)\\\"), \\\"\\\\n\\\".join(outputs)\\n    outputs.append(f\\\"rc=0\\\\n{run_attavo(root, 'drive', '1', env=env).stdout}\\\")\\n    bad = [o for o in outputs if not o.startswith(\\\"rc=0\\\") or \\\"fatal\\\" in o or \\\"stopped: could not\\\" in o or \\\"error\\\" in o.lower()]\\n    assert not bad, \\\"a pass hit a git error:\\\\n\\\" + \\\"\\\\n\\\".join(bad)\\n    worker_log = (git_dir(root) / \\\"attavo\\\" / \\\"build-01.worker.log\\\").read_text()\\n    assert \\\"fatal\\\" not in worker_log and \\\"could not\\\" not in worker_log and \\\"error\\\" not in worker_log.lower(), worker_log\\n    assert latest_record(root, \\\"counsel\\\")[\\\"verdict\\\"] == \\\"person\\\"\\n    assert git(root, \\\"status\\\", \\\"--porcelain\\\") == \\\"\\\"\\n    made_here = [l for l in git(root, \\\"reflog\\\", \\\"show\\\", \\\"HEAD\\\").splitlines() if \\\"attavo:\\\" in l]\\n    assert all(\\\"fast-forward\\\" in l.lower() for l in made_here), \\\\\\n        \\\"a pass or the worker committed in the executor's checkout:\\\\n\\\" + \\\"\\\\n\\\".join(made_here)\\n    assert \\\"build record for item 1 (build-01)\\\" in git(root, \\\"log\\\", \\\"--format=%s\\\", \\\"origin/attavo/1-x\\\")\\n\",\"structuredPatch\":[{\"oldStart\":262,\"oldLines\":7,\"newStart\":262,\"newLines\":7,\"lines\":[\"     assert read_invocation(root, bound, marker, legacy).cls == \\\"died\\\"\",\" \",\" \",\"-def test_the_marker_a_pass_writes_names_its_checkouts_own_directory(tmp_path: Path) -> None:\",\"+def test_the_marker_a_pass_writes_names_its_checkouts_heartbeat_directory(tmp_path: Path) -> None:\",\"     \\\"\\\"\\\"write_invocation_marker's own `events` field, from `attavo drive`\",\"     itself (#289): the marker is committed and pushed from a detached\",\"     worktree, but `events` must still name the checkout's own\"]}],\"userModified\":false,\"replaceAll\":false,\"contentNotInModelContext\":true}}\n{\"type\":\"system\",\"subtype\":\"thinking_tokens\",\"estimated_tokens\":50,\"estimated_tokens_delta\":50,\"session_id\":\"b3f717aa-5c2b-4867-b022-0f24cffb6427\",\"uuid\":\"b3e3a0c4-5328-4ef1-bd04-21e2e5e06812\"}\n{\"type\":\"system\",\"subtype\":\"thinking_tokens\",\"estimated_tokens\":126,\"estimated_tokens_delta\":76,\"session_id\":\"b3f717aa-5c2b-4867-b022-0f24cffb6427\",\"uuid\":\"b6072ef8-3090-42e8-ac9b-962d4dc1e553\"}\n{\"type\":\"assistant\",\"message\":{\"model\":\"claude-sonnet-5\",\"id\":\"msg_011CfaULTmVS3AXf9ErCpVFT\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"thinking\",\"thinking\":\"\",\"signature\":\"\"}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":928,\"cache_read_input_tokens\":157087,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":928},\"output_tokens\":3,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"b3f717aa-5c2b-4867-b022-0f24cffb6427\",\"uuid\":\"876fa801-ce50-4d99-83df-04230b945196\",\"timestamp\":\"2026-09-30T23:13:31.504Z\",\"request_id\":\"req_011CfaULTQANmPTYEjNeY1Wc\"}\n{\"type\":\"assistant\",\"message\":{\"model\":\"claude-sonnet-5\",\"id\":\"msg_011CfaULTmVS3AXf9ErCpVFT\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_019xT9uRJVLSvY9yo9eWW67K\",\"name\":\"Read\",\"input\":{\"file_path\":\"/Users/davidbean/Projects/attavo-worktree-289/tests/test_pass.py\",\"offset\":160,\"limit\":120},\"caller\":{\"type\":\"direct\"}}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":928,\"cache_read_input_tokens\":157087,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":928},\"output_tokens\":3,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"b3f717aa-5c2b-4867-b022-0f24cffb6427\",\"uuid\":\"360848de-dadf-4ff1-baa6-f87ad1733bc1\",\"timestamp\":\"2026-09-30T23:13:32.305Z\",\"request_id\":\"req_011CfaULTQANmPTYEjNeY1Wc\",\"wire_tool_inputs\":{\"toolu_019xT9uRJVLSvY9yo9eWW67K\":{\"file_path\":\"/Users/davidbean/Projects/attavo-worktree-289/tests/test_pass.py\",\"offset\":160,\"limit\":120}}}\n{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_019xT9uRJVLSvY9yo9eWW67K\",\"type\":\"tool_result\",\"content\":\"160\\t    r = report(root)\\n161\\t    assert r[\\\"state\\\"] == \\\"running\\\", r\\n162\\t\\n163\\t\\n164\\tdef test_two_passes_at_once_start_one_worker_and_the_loser_says_so(tmp_path: Path) -> None:\\n165\\t    root, bare = built_tenant(tmp_path, seconds=3)\\n166\\t    publish_approval(root)\\n167\\t    clone = tmp_path / \\\"second\\\"\\n168\\t    git(root.parent, \\\"clone\\\", \\\"-q\\\", \\\"-b\\\", git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip(), str(bare), str(clone))\\n169\\t    git(clone, \\\"config\\\", \\\"user.email\\\", \\\"test@example.com\\\")\\n170\\t    git(clone, \\\"config\\\", \\\"user.name\\\", \\\"Attavo Test\\\")\\n171\\t    git(clone, \\\"remote\\\", \\\"set-head\\\", \\\"origin\\\", \\\"-a\\\")\\n172\\t    env = dict(os.environ)\\n173\\t    env.update(FAST)\\n174\\t    before = {c: (head_of(c), git(c, \\\"ls-files\\\", \\\"-s\\\"), git(c, \\\"status\\\", \\\"--porcelain\\\")) for c in (root, clone)}\\n175\\t    procs = [subprocess.Popen([sys.executable, str(ROOT / \\\"bin\\\" / \\\"attavo\\\"), \\\"drive\\\", \\\"1\\\"], cwd=str(c),\\n176\\t                              env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)\\n177\\t             for c in (root, clone)]\\n178\\t    outs = [p.communicate(timeout=30)[0] for p in procs]\\n179\\t    started = [o for o in outs if \\\"Build started\\\" in o]\\n180\\t    held = [o for o in outs if \\\"another pass holds\\\" in o]\\n181\\t    assert len(started) == 1 and len(held) == 1, outs\\n182\\t    loser = clone if \\\"another pass holds\\\" in outs[1] else root\\n183\\t    assert (head_of(loser), git(loser, \\\"ls-files\\\", \\\"-s\\\"), git(loser, \\\"status\\\", \\\"--porcelain\\\")) == before[loser], \\\\\\n184\\t        \\\"the loser's checkout (HEAD, index, working tree) moved\\\"\\n185\\t    assert \\\"reset\\\" not in git(loser, \\\"reflog\\\", \\\"show\\\", \\\"HEAD\\\"), git(loser, \\\"reflog\\\", \\\"show\\\", \\\"HEAD\\\")\\n186\\t    log = subprocess.run([\\\"git\\\", \\\"-C\\\", str(bare), \\\"log\\\", \\\"--format=%s\\\", \\\"attavo/1-x\\\"], capture_output=True, text=True).stdout\\n187\\t    assert log.count(\\\"build invocation 01 started\\\") == 1, log\\n188\\t    wait_for(lambda: \\\"build record for item 1\\\" in subprocess.run(\\n189\\t        [\\\"git\\\", \\\"-C\\\", str(bare), \\\"log\\\", \\\"--format=%s\\\", \\\"attavo/1-x\\\"], capture_output=True, text=True).stdout)\\n190\\t\\n191\\t\\n192\\tdef test_a_second_checkout_on_this_host_reads_the_first_ones_worker_as_running(tmp_path: Path) -> None:\\n193\\t    \\\"\\\"\\\"The race made deterministic (#289): two checkouts of one tenant on\\n194\\t    one host is ordinary now, since the product owns each item's own\\n195\\t    working copy. Run the second's pass only after the first's marker has\\n196\\t    already landed -- no race for the lease at all -- and it must still\\n197\\t    read the first's heartbeat where its marker says to look, see it\\n198\\t    running, start nothing, and push no second invocation.\\\"\\\"\\\"\\n199\\t    root, bare = built_tenant(tmp_path, seconds=3)\\n200\\t    publish_approval(root)\\n201\\t    clone = tmp_path / \\\"second\\\"\\n202\\t    git(root.parent, \\\"clone\\\", \\\"-q\\\", \\\"-b\\\", git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip(),\\n203\\t        str(bare), str(clone))\\n204\\t    git(clone, \\\"config\\\", \\\"user.email\\\", \\\"test@example.com\\\")\\n205\\t    git(clone, \\\"config\\\", \\\"user.name\\\", \\\"Attavo Test\\\")\\n206\\t    git(clone, \\\"remote\\\", \\\"set-head\\\", \\\"origin\\\", \\\"-a\\\")\\n207\\t\\n208\\t    first = run_attavo(root, \\\"drive\\\", \\\"1\\\", env=FAST)\\n209\\t    assert \\\"Build started\\\" in first.stdout, first.stdout + first.stderr\\n210\\t\\n211\\t    second = run_attavo(clone, \\\"drive\\\", \\\"1\\\", env=FAST)\\n212\\t    assert second.returncode == 0, second.stdout + second.stderr\\n213\\t    assert \\\"Build started\\\" not in second.stdout, second.stdout\\n214\\t    assert \\\"another pass holds\\\" not in second.stdout, second.stdout\\n215\\t    assert \\\"running\\\" in second.stdout.lower(), second.stdout\\n216\\t\\n217\\t    log = subprocess.run([\\\"git\\\", \\\"-C\\\", str(bare), \\\"log\\\", \\\"--format=%s\\\", \\\"attavo/1-x\\\"],\\n218\\t                         capture_output=True, text=True).stdout\\n219\\t    assert log.count(\\\"build invocation 01 started\\\") == 1, log\\n220\\t    assert not (records_dir(clone) / \\\"build-02.started\\\").exists()\\n221\\t    wait_for(lambda: \\\"build record for item 1\\\" in subprocess.run(\\n222\\t        [\\\"git\\\", \\\"-C\\\", str(bare), \\\"log\\\", \\\"--format=%s\\\", \\\"attavo/1-x\\\"], capture_output=True, text=True).stdout)\\n223\\t\\n224\\t\\n225\\tdef test_the_holders_heartbeat_is_read_where_its_marker_says(tmp_path: Path) -> None:\\n226\\t    \\\"\\\"\\\"holder_heartbeat_path (#289): a marker from this host that names a\\n227\\t    directory is read there, not assumed to be this checkout's own --\\n228\\t    fresh there is running, absent there is still running while the\\n229\\t    marker is younger than the stall bound, and died once it is older.\\n230\\t    A marker with no `events` at all (written before this release) reads\\n231\\t    exactly as it always did: died the moment there is no heartbeat in\\n232\\t    this checkout's own directory, whatever the marker's own age.\\\"\\\"\\\"\\n233\\t    from attavo.doctor import heartbeat_path, holder_heartbeat_path, invocation_marker_path\\n234\\t    from attavo.drive import read_invocation\\n235\\t\\n236\\t    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n237\\t    git(root, \\\"checkout\\\", \\\"-q\\\", \\\"-b\\\", \\\"attavo/1-x\\\")\\n238\\t    bound = 5\\n239\\t    now = time.strftime(\\\"%Y-%m-%dT%H:%M:%SZ\\\", time.gmtime())\\n240\\t    old = time.strftime(\\\"%Y-%m-%dT%H:%M:%SZ\\\", time.gmtime(time.time() - bound * 10))\\n241\\t    other_events = tmp_path / \\\"other-checkout\\\" / \\\"attavo\\\"\\n242\\t    other_events.mkdir(parents=True)\\n243\\t    marker = invocation_marker_path(records_dir(root), \\\"build\\\", 1)\\n244\\t\\n245\\t    info = {\\\"at\\\": now, \\\"host\\\": socket.gethostname(), \\\"sha\\\": head_of(root),\\n246\\t            \\\"product_version\\\": \\\"fixture\\\", \\\"events\\\": str(other_events)}\\n247\\t    beat = holder_heartbeat_path(root, info, \\\"build\\\", 1)\\n248\\t    assert beat == other_events / \\\"build-01.heartbeat\\\"\\n249\\t\\n250\\t    beat.write_text(\\\"4242\\\\n\\\")\\n251\\t    assert read_invocation(root, bound, marker, info).cls == \\\"running\\\"\\n252\\t\\n253\\t    beat.unlink()\\n254\\t    assert read_invocation(root, bound, marker, info).cls == \\\"running\\\"\\n255\\t\\n256\\t    info_old = {**info, \\\"at\\\": old}\\n257\\t    assert read_invocation(root, bound, marker, info_old).cls == \\\"died\\\"\\n258\\t\\n259\\t    legacy = {\\\"at\\\": now, \\\"host\\\": socket.gethostname(), \\\"sha\\\": head_of(root),\\n260\\t             \\\"product_version\\\": \\\"fixture\\\"}\\n261\\t    assert holder_heartbeat_path(root, legacy, \\\"build\\\", 1) == heartbeat_path(root, \\\"build\\\", 1)\\n262\\t    assert read_invocation(root, bound, marker, legacy).cls == \\\"died\\\"\\n263\\t\\n264\\t\\n265\\tdef test_the_marker_a_pass_writes_names_its_checkouts_heartbeat_directory(tmp_path: Path) -> None:\\n266\\t    \\\"\\\"\\\"write_invocation_marker's own `events` field, from `attavo drive`\\n267\\t    itself (#289): the marker is committed and pushed from a detached\\n268\\t    worktree, but `events` must still name the checkout's own\\n269\\t    <git-dir>/attavo, never that worktree's -- otherwise a second\\n270\\t    checkout reading this marker later would look for the heartbeat in a\\n271\\t    directory removed the moment the marker's own push returned.\\\"\\\"\\\"\\n272\\t    root, bare = built_tenant(tmp_path, seconds=0)\\n273\\t    assert run_attavo(root, \\\"drive\\\", \\\"1\\\", env=FAST).returncode == 0\\n274\\t    marker = json.loads((records_dir(root) / \\\"build-01.started\\\").read_text())\\n275\\t    assert marker[\\\"events\\\"] == str(git_dir(root) / \\\"attavo\\\"), marker\\n276\\t    wait_for(lambda: record_files(root, \\\"build\\\") != [])\\n277\\t\\n278\\t\\n279\\tdef test_a_pass_recovers_a_dead_invocation_and_recover_is_gone(tmp_path: Path) -> None:\"}]},\"parent_tool_use_id\":null,\"session_id\":\"b3f717aa-5c2b-4867-b022-0f24cffb6427\",\"uuid\":\"b730834d-011b-4d34-aa3d-70662e64dabc\",\"timestamp\":\"2026-09-30T23:13:32.319Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/davidbe
},\"caller\":{\"type\":\"direct\"}}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":476,\"cache_read_input_tokens\":28750,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":476},\"output_tokens\":8,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"b3f717aa-5c2b-4867-b022-0f24cffb6427\",\"uuid\":\"08a485ef-4e07-495e-826b-892ec00d39a8\",\"timestamp\":\"2026-09-30T23:05:35.654Z\",\"request_id\":\"req_011CfaTjPEB7XuMWpQbXJnCr\",\"wire_tool_inputs\":{\"toolu_014pSpeuWWBkz5hLBs5KngZN\":{\"file_path\":\"/Users/davidbean/Projects/attavo-worktree-289/attest/specs/289/stub/attavo/doctor.py\"}}}\n{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_014pSpeuWWBkz5hLBs5KngZN\",\"type\":\"tool_result\",\"content\":\"1\\tfrom __future__ import annotations\\n2\\t\\n3\\timport fnmatch\\n4\\timport json\\n5\\timport os\\n6\\timport re\\n7\\timport subprocess\\n8\\tfrom pathlib import Path\\n9\\tfrom typing import Any\\n10\\t\\n11\\tfrom attavo import clock\\n12\\tfrom attavo.attest import check_attest_chain, item_time_and_cost\\n13\\tfrom attavo.build import build_is_empty, driver_identity\\n14\\tfrom attavo.common import (\\n15\\t    MANIFEST,\\n16\\t    Proof,\\n17\\t    STAGES,\\n18\\t    fixture_item_id,\\n19\\t    git,\\n20\\t    product_version,\\n21\\t    read_manifest,\\n22\\t)\\n23\\tfrom attavo.events import stage_events_dir\\n24\\tfrom attavo.records import RECORD_RE, load_records, parse_attempts\\n25\\tfrom attavo.spec import parse_spec\\n26\\tfrom attavo.stops import (\\n27\\t    STOP_CLASSES,\\n28\\t    STOP_PROVENANCES,\\n29\\t    STOP_REDERIVABLE_FROM,\\n30\\t    STOP_STAGES,\\n31\\t    gate_stop,\\n32\\t    is_recovery_stop,\\n33\\t    recovery_fault,\\n34\\t    rederive_stop,\\n35\\t)\\n36\\t\\n37\\t# --- doctor's three proofs ---\\n38\\t\\n39\\tdef proof_every_gate_rejects(root: Path, m: dict[str, Any] | None) -> Proof:\\n40\\t    p = Proof(\\\"every-gate-rejects\\\", \\\"every gate rejects its fixture\\\")\\n41\\t    if m is None:\\n42\\t        return p.fail(f\\\"no {MANIFEST} at {root}; no gate is registered\\\")\\n43\\t    gates = m.get(\\\"gates\\\") or {}\\n44\\t    if not gates:\\n45\\t        return p.fail(\\\"[gates] is empty; a gate that has rejected nothing does not exist\\\")\\n46\\t    fixtures = root / m.get(\\\"paths\\\", {}).get(\\\"rejections\\\", \\\"\\\")\\n47\\t    # Proposal, not yet ruled on (issue #54): a gate that retires nothing\\n48\\t    # only adds, so proof one reports it here rather than waiting on the\\n49\\t    # schema alone -- read_manifest never validates against the manifest\\n50\\t    # schema at runtime, so a schema requirement is not an enforced one.\\n51\\t    no_retires = [name for name, gate in sorted(gates.items()) if not gate.get(\\\"retires\\\")]\\n52\\t    missing, accepted = [], []\\n53\\t    for name, gate in sorted(gates.items()):\\n54\\t        fixture = fixtures / name\\n55\\t        if not fixture.is_dir():\\n56\\t            missing.append(name)\\n57\\t            continue\\n58\\t        env = dict(os.environ)\\n59\\t        item = fixture_item_id(fixture)\\n60\\t        if item is not None:\\n61\\t            env[\\\"ATTAVO_ITEM\\\"] = item\\n62\\t        run = subprocess.run(gate[\\\"command\\\"], shell=True, cwd=str(fixture),\\n63\\t                             capture_output=True, text=True, check=False, env=env)\\n64\\t        if run.returncode == 0:\\n65\\t            accepted.append(name)\\n66\\t    if missing:\\n67\\t        return p.fail(f\\\"gate(s) with no rejection fixture: {', '.join(missing)}\\\")\\n68\\t    if accepted:\\n69\\t        return p.fail(f\\\"gate(s) that accepted their rejection fixture: {', '.join(accepted)}\\\")\\n70\\t    if no_retires:\\n71\\t        return p.fail(f\\\"gate(s) with no retires: {', '.join(no_retires)}\\\")\\n72\\t    return p.hold(f\\\"{len(gates)} gate(s) rejected their fixture\\\")\\n73\\t\\n74\\t\\n75\\tdef _merges_reachable(root: Path, ref: str | None = None) -> tuple[list[dict[str, Any]], str | None]:\\n76\\t    \\\"\\\"\\\"(merges, refusal): every merge commit on the default branch's own\\n77\\t    first-parent line -- sha, parents, and its own first-parent diff --\\n78\\t    read by one process rather than the git log plus one git diff per\\n79\\t    merge merge_introducing_records used to pay walking toward the one\\n80\\t    it wants (issue #153). refs/remotes/origin/HEAD names the default\\n81\\t    branch without hard-coding \\\"main\\\", the same primitive\\n82\\t    diff_since_approval already uses (issue #52); walking from it rather\\n83\\t    than from HEAD is what keeps a transport merge on an item branch, a\\n84\\t    pull_request checkout's own synthetic test merge, and a merge_group's\\n85\\t    temporary merge from ever being mistaken for an item's merge (issue\\n86\\t    #169) -- none of those is reachable from the default branch's first-\\n87\\t    parent line by definition. When refs/remotes/origin/HEAD is not set,\\n88\\t    this refuses by name rather than guess, exactly as diff_since_approval\\n89\\t    does.\\n90\\t\\n91\\t    The walk starts at HEAD itself when the current checkout is literally\\n92\\t    on the branch refs/remotes/origin/HEAD names (an ordinary checkout of\\n93\\t    the default branch, on push or on a developer's own machine) and at\\n94\\t    the remote-tracking ref's own value otherwise (any other branch, or\\n95\\t    the detached HEAD a pull_request or merge_group checkout leaves\\n96\\t    behind) -- HEAD only ever *is* the default branch's first-parent line\\n97\\t    in the former case; in the latter, only the remote-tracking ref names\\n98\\t    it. --diff-merges=first-parent gives each merge's diff against its\\n99\\t    first parent in the same pass git log --merges already makes to list\\n100\\t    them, in the same order, newest first.\\\"\\\"\\\"\\n101\\t    symref = subprocess.run(\\n102\\t        [\\\"git\\\", \\\"-C\\\", str(root), \\\"symbolic-ref\\\", \\\"-q\\\", \\\"refs/remotes/origin/HEAD\\\"],\\n103\\t        capture_output=True, text=True, check=False)\\n104\\t    if symref.returncode != 0:\\n105\\t        return [], \\\"refs/remotes/origin/HEAD is not set; run `git remote set-head origin -a`\\\"\\n106\\t    default_remote_ref = symref.stdout.strip()\\n107\\t    default_branch = default_remote_ref.rsplit(\\\"/\\\", 1)[-1]\\n108\\t    current_branch = subprocess.run(\\n109\\t        [\\\"git\\\", \\\"-C\\\", str(root), \\\"symbolic-ref\\\", \\\"-q\\\", \\\"--short\\\", \\\"HEAD\\\"],\\n110\\t        capture_output=True, text=True, check=False)\\n111\\t    default_ref = ref or (\\\"HEAD\\\" if current_branch.returncode == 0\\n112\\t                          and current_branch.stdout.strip() == default_branch\\n113\\t                          else default_remote_ref)\\n114\\t    try:\\n115\\t        out = git(root, \\\"log\\\", default_ref, \\\"--first-parent\\\", \\\"--merges\\\",\\n116\\t                 \\\"--diff-merges=first-parent\\\", \\\"--name-only\\\",\\n117\\t                 \\\"--format=\\\\x01%H\\\\x1f%P\\\")\\n118\\t    except RuntimeError:\\n119\\t        return [], None\\n120\\t    merges = []\\n121\\t    for block in out.split(\\\"\\\\x01\\\")[1:]:\\n122\\t        header, _, rest = block.partition(\\\"\\\\n\\\")\\n123\\t        sha, parents = header.split(\\\"\\\\x1f\\\")\\n124\\t        merges.append({\\\"sha\\\": sha, \\\"parents\\\": parents.split(),\\n125\\t                       \\\"touched\\\": [line for line in rest.splitlines() if line.strip()]})\\n126\\t    return merges, None\\n127\\t\\n128\\t\\n129\\tdef merge_introducing_records(root: Path, records_rel: str, item: str,\\n130\\t                              stages: tuple[str, ...],\\n131\\t                              merges: list[dict[str, Any]] | None = None) -> tuple[str | None, str | None]:\\n132\\t    \\\"\\\"\\\"(merge_sha, refusal): the merge commit on the default branch's own\\n133\\t    first-parent line whose first-parent diff introduces a record for\\n134\\t    every one of stages, under records_rel/item/ -- the same derivation\\n135\\t    attest itself uses (derive_attest_items), read here so proof two\\n136\\t    requires an item's stage records to have arrived by an actual merge\\n137\\t    on the default branch, not merely to sit in the tree, and not by a\\n138\\t    transport merge, a pull_request checkout's synthetic test merge, or a\\n139\\t    merge_group's temporary merge (issue #69 acceptance row 4; issue\\n140\\t    #169). merge_sha is None with no refusal when no such merge exists\\n141\\t    yet -- the item is not merged, not that the walk failed.\\n142\\t\\n143\\t    merges, when given, is _merges_reachable's own result -- ledger's\\n144\\t    cmd_ledger computes it once and passes it to every item rather than\\n145\\t    walking the default branch's merges again for each (issue #153); a\\n146\\t    caller that already has merges has also already handled\\n147\\t    _merges_reachable's refusal, so this never re-derives one. Left\\n148\\t    None, a caller with just the one item to ask (doctor's proof two)\\n149\\t    gets merges computed here, refusal and all.\\\"\\\"\\\"\\n150\\t    if merges is None:\\n151\\t        merges, refusal = _merges_reachable(root)\\n152\\t        if refusal:\\n153\\t            return None, refusal\\n154\\t    prefix = f\\\"{records_rel.rstrip('/')}/{item}/\\\"\\n155\\t    for merge in merges:\\n156\\t        found: set[str] = set()\\n157\\t        for p in merge[\\\"touched\\\"]:\\n158\\t            if p.startswith(prefix):\\n159\\t                m = RECORD_RE.match(Path(p).name)\\n160\\t                if m:\\n161\\t                    found.add(m.group(1))\\n162\\t        if all(s in found for s in stages):\\n163\\t            return merge[\\\"sha\\\"], None\\n164\\t    return None, None\\n165\\t\\n166\\t\\n167\\tINVOCATION_MARKER_SUFFIX = \\\".started\\\"\\n168\\t\\n169\\t\\n170\\tdef invocation_marker_path(records_dir: Path, stage: str, nn: int) -> Path:\\n171\\t    return records_dir / f\\\"{stage}-{nn:02d}{INVOCATION_MARKER_SUFFIX}\\\"\\n172\\t\\n173\\t\\n174\\tdef heartbeat_s() -> float:\\n175\\t    return float(os.environ.get(\\\"ATTAVO_HEARTBEAT_S\\\", 15))\\n176\\t\\n177\\t\\n178\\tdef heartbeat_path(root: Path, stage: str, nn: int) -> Path:\\n179\\t    return stage_events_dir(root) / f\\\"{stage}-{nn:02d}.heartbeat\\\"\\n180\\t\\n181\\t\\n182\\tdef holder_heartbeat_path(root: Path, info: dict[str, Any], stage: str, nn: int) -> Path | None:\\n183\\t    \\\"\\\"\\\"Where the holder of an invocation writes its heartbeat, as far as\\n184\\t    this host can read it: the directory its marker names, when the\\n185\\t    marker is from this host and names one; this checkout's own, for a\\n186\\t    marker from this host written before markers named it; None for a\\n187\\t    marker from another host, whose heartbeat no file here holds.\\\"\\\"\\\"\\n188\\t    import socket\\n189\\t    if info.get(\\\"host\\\") != socket.gethostname():\\n190\\t        return None\\n191\\t    events = info.get(\\\"events\\\")\\n192\\t    if isinstance(events, str) and events:\\n193\\t        return Path(events) / f\\\"{stage}-{nn:02d}.heartbeat\\\"\\n194\\t    return heartbeat_path(root, stage, nn)\\n195\\t\\n196\\t\\n197\\tdef heartbeat_pid(path: Path) -> int | None:\\n198\\t    \\\"\\\"\\\"The pid the worker wrote as its heartbeat file's one line on its\\n199\\t    first beat -- the holder's own, the only pid anyone signals. None when\\n200\\t    the file is absent, unreadable, empty (a worker from before this\\n201\\t    release touched it and wrote nothing), or not a positive integer.\\\"\\\"\\\"\\n202\\t    try:\\n203\\t        text = path.read_text().strip()\\n204\\t    except OSError:\\n205\\t        return None\\n206\\t    if not text.isdigit() or int(text) <= 0:\\n207\\t        return None\\n208\\t    return int(text)\\n209\\t\\n210\\t\\n211\\tdef heartbeat_age_s(path: Path) -> float | None:\\n212\\t    \\\"\\\"\\\"Seconds since the heartbeat file was last touched; None when there\\n213\\t    is no such file.\\\"\\\"\\\"\\n214\\t    try:\\n215\\t        return clock.now() - path.stat().st_mtime\\n216\\t    except OSError:\\n217\\t        return None\\n218\\t\\n219\\t\\n220\\tdef write_invocation_marker(root: Path, records_dir: Path, stage: str, nn: int,\\n221\\t                            again_by: str | None = None, events_dir: Path | None = None) -> Path:\\n222\\t    \\\"\\\"\\\"The fact that an invocation began, written before it does: at,\\n223\\t    host, the sha it starts on, and the product that started it. No pid:\\n224\\t    the writer is `attavo drive`, which returns seconds later, and the\\n225\\t    process that holds the stage is the worker, whose own heartbeat is\\n226\\t    the fact of holding it. Its record's arrival is what retires a\\n227\\t    marker; a marker with no record is an invocation that died or hangs,\\n228\\t    and proof five names it. again_by is the login that pressed `--again`\\n229\\t    to reset a stage whose budget was spent (or whose last two signatures\\n230\\t    matched) -- absent on every ordinary marker, never a bare false.\\n231\\t    events names the directory the holder's heartbeat will be written in\\n232\\t    (the checkout's own <git-dir>/attavo, events_dir when the marker is\\n233\\t    written from a detached worktree for another checkout): two checkouts\\n234\\t    on one host each keep their own, so the host alone never says where\\n235\\t    the holder's heartbeat can be read.\\\"\\\"\\\"\\n236\\t    import socket\\n237\\t    from datetime import datetime, timezone\\n238\\t    records_dir.mkdir(parents=True, exist_ok=True)\\n239\\t    path = invocation_marker_path(records_dir, stage, nn)\\n240\\t    sha = git(root, \\\"rev-parse\\\", \\\"HEAD\\\").strip()\\n241\\t    info: dict[str, Any] = {\\\"at\\\": datetime.now(timezone.utc).strftime(\\\"%Y-%m-%dT%H:%M:%SZ\\\"),\\n242\\t                            \\\"host\\\": socket.gethostname(), \\\"sha\\\": sha,\\n243\\t                            \\\"product_version\\\": product_version(),\\n244\\t                            \\\"events\\\": str(events_dir or stage_events_dir(root))}\\n245\\t    if again_by:\\n246\\t        info[\\\"again_by\\\"] = again_by\\n247\\t    path.write_text(json.dumps(info, indent=2) + \\\"\\\\n\\\")\\n248\\t    return path\\n249\\t\\n250\\t\\n251\\tdef invocation_age_s(info: dict[str, Any]) -> float | None:\\n252\\t    \\\"\\\"\\\"Seconds since the marker's own `at` timestamp -- how long ago the\\n253\\t    invocation it names began, whatever host wrote it. None when `at` is\\n254\\t    missing or does not parse.\\\"\\\"\\\"\\n255\\t    from datetime import datetime, timezone\\n256\\t    at = info.get(\\\"at\\\")\\n257\\t    if not isinstance(at, str):\\n258\\t        return None\\n259\\t    try:\\n260\\t        stamp = datetime.strptime(at, \\\"%Y-%m-%dT%H:%M:%SZ\\\").replace(tzinfo=timezone.utc)\\n261\\t    except ValueError:\\n262\\t        return None\\n263\\t    return clock.now() - stamp.timestamp()\\n264\\t\\n265\\t\\n266\\tdef invocations_without_record(item_records_dir: Path) -> list[tuple[Path, dict[str, Any]]]:\\n267\\t    \\\"\\\"\\\"Every <stage>-NN.started under one item whose <stage>-NN.json has\\n268\\t    not arrived, with the marker's own dict ({} when unreadable).\\\"\\\"\\\"\\n269\\t    out: list[tuple[Path, dict[str, Any]]] = []\\n270\\t    if not item_records_dir.is_dir():\\n271\\t        return out\\n272\\t    for marker in sorted(item_records_dir.glob(f\\\"*{INVOCATION_MARKER_SUFFIX}\\\")):\\n273\\t        if (item_records_dir / f\\\"{marker.stem}.json\\\").is_file():\\n274\\t            continue\\n275\\t        try:\\n276\\t            with marker.open() as fh:\\n277\\t                info = json.load(fh)\\n278\\t        except (OSError, ValueError):\\n279\\t            info = {}\\n280\\t        out.append((marker, info if isinstance(info, dict) else {}))\\n281\\t    return out\\n282\\t\\n283\\t\\n284\\tdef stall_bound_s(m: dict[str, Any]) -> int | None:\\n285\\t    \\\"\\\"\\\"[drive].stall_after_s: the tenant's own bound past which a live\\n286\\t    invocation with no new event is hung. A bound the tenant did not\\n287\\t    write is a forecast, so there is no default.\\\"\\\"\\\"\\n288\\t    bound = (m.get(\\\"drive\\\") or {}).get(\\\"stall_after_s\\\")\\n289\\t    if isinstance(bound, bool) or not isinstance(bound, (int, float)) or bound <= 0:\\n290\\t        return None\\n291\\t    return int(bound)\\n292\\t\\n293\\t\\n294\\tdef ceiling_s(m: dict[str, Any], stage: str) -> int | None:\\n295\\t    \\\"\\\"\\\"R3: [drive.<stage>].ceiling_s, the wall clock past which a live\\n296\\t    invocation of that stage is hung by its ceiling, whatever event age\\n297\\t    says (or does not say, for an adapter that streams none). No\\n298\\t    default: a ceiling the tenant did not declare is not assumed.\\\"\\\"\\\"\\n299\\t    value = ((m.get(\\\"drive\\\") or {}).get(stage) or {}).get(\\\"ceiling_s\\\")\\n300\\t    if isinstance(value, bool) or not isinstance(value, (int, float)) or value <= 0:\\n301\\t        return None\\n302\\t    return int(value)\\n303\\t\\n304\\t\\n305\\tdef attempts_budget(m: dict[str, Any]) -> int:\\n306\\t    \\\"\\\"\\\"R3: [drive].attempts, the attempts a stage may spend -- across a\\n307\\t    plain retry, a returned retry, and a steered one alike -- before the\\n308\\t    item is a person's; 3 when the manifest does not say.\\\"\\\"\\\"\\n309\\t    value = (m.get(\\\"drive\\\") or {}).get(\\\"attempts\\\")\\n310\\t    if isinstance(value, bool) or not isinstance(value, int) or value < 1:\\n311\\t        return 3\\n312\\t    return value\\n313\\t\\n314\\t\\n315\\tdef retry_after_s(m: dict[str, Any]) -> int:\\n316\\t    \\\"\\\"\\\"R3: [drive].retry_after_s, the wait a transient stop's record sits\\n317\\t    through before its next attempt starts; 300 when the manifest does\\n318\\t    not say.\\\"\\\"\\\"\\n319\\t    value = (m.get(\\\"drive\\\") or {}).get(\\\"retry_after_s\\\")\\n320\\t    if isinstance(value, bool) or not isinstance(value, (int, float)) or value < 0:\\n321\\t        return 300\\n322\\t    return int(value)\\n323\\t\\n324\\t\\n325\\tdef proof_no_invocation_lacks_record(root: Path, m: dict[str, Any] | None) -> Proof:\\n326\\t    import socket\\n327\\t    p = Proof(\\\"no-invocation-lacks-record\\\", \\\"no invocation lacks its record\\\")\\n328\\t    if m is None:\\n329\\t        return p.fail(f\\\"no {MANIFEST} at {root}; no records directory is declared\\\")\\n330\\t    records_rel = m.get(\\\"paths\\\", {}).get(\\\"records\\\", \\\"\\\")\\n331\\t    records_dir = root / records_rel\\n332\\t    if not records_dir.is_dir():\\n333\\t        return p.fail(f\\\"no records directory under {records_dir}\\\")\\n334\\t    bound = stall_bound_s(m)\\n335\\t    if bound is None:\\n336\\t        return p.fail(\\\"no [drive].stall_after_s in the manifest; a hung invocation cannot be \\\"\\n337\\t                      \\\"told from a running one\\\")\\n338\\t    # R3: a stage with no ceiling can run forever unjudged even when\\n339\\t    # stall_after_s is set (an adapter that streams no events trips no\\n340\\t    # stall bound at all) -- refused the same way stall_after_s's own\\n341\\t    # absence is, not folded into it, so the reason names exactly which\\n342\\t    # keys the manifest is missing.\\n343\\t    missing_ceilings = [f\\\"[drive.{stage}].ceiling_s\\\" for stage in (\\\"build\\\", \\\"verify\\\")\\n344\\t                        if ceiling_s(m, stage) is None]\\n345\\t    if missing_ceilings:\\n346\\t        return p.fail(f\\\"no {' or '.join(missing_ceilings)} in the manifest; a stage with no \\\"\\n347\\t                      f\\\"ceiling can run forever unjudged (R3)\\\")\\n348\\t    if (m.get(\\\"drive\\\") or {}).get(\\\"attempts\\\") is None:\\n349\\t        return p.fail(\\\"no [drive].attempts in the manifest; a retryable stop would spend an \\\"\\n350\\t                      \\\"unbounded number of attempts (R3)\\\")\\n351\\t    this_host = socket.gethostname()\\n352\\t    recorded = 0\\n353\\t    running: list[str] = []\\n354\\t    in_flight: list[str] = []\\n355\\t    problems: list[str] = []\\n356\\t    for item_dir in sorted(d for d in records_dir.iterdir() if d.is_dir()):\\n357\\t        for marker in item_dir.glob(f\\\"*{INVOCATION_MARKER_SUFFIX}\\\"):\\n358\\t            if (item_dir / f\\\"{marker.stem}.json\\\").is_file():\\n359\\t                recorded += 1\\n360\\t        for marker, info in invocations_without_record(item_dir):\\n361\\t            name = f\\\"item {item_dir.name} {marker.stem}\\\"\\n362\\t            stage, nn_text = marker.stem.rsplit(\\\"-\\\", 1)\\n363\\t            try:\\n364\\t                beat_file = holder_heartbeat_path(root, info, stage, int(nn_text))\\n365\\t                beat_age = heartbeat_age_s(beat_file) if beat_file is not None else None\\n366\\t            except (RuntimeError, ValueError):\\n367\\t                beat_file, beat_age = None, None\\n368\\t            if beat_age is not None:\\n369\\t                # The holder's own fact: fresh within three beats is\\n370\\t                # running, older is a holder that stopped touching it.\\n371\\t                if beat_age <= heartbeat_s() * 3:\\n372\\t                    running.append(f\\\"{name} (heartbeat {int(beat_age)} s old, since {info.get('at')})\\\")\\n373\\t                    continue\\n374\\t            elif info.get(\\\"host\\\") != this_host or info.get(\\\"events\\\"):\\n375\\t                # No heartbeat readable for a marker from another host, or\\n376\\t                # none yet where a marker from this host says its holder\\n377\\t                # beats (another checkout's worker not yet at its first\\n378\\t                # beat): not yet a failure. An invocation younger than the\\n379\\t                # tenant's own stall bound may simply be running, still\\n380\\t                # writing toward its own record.\\n381\\t                age = invocation_age_s(info)\\n382\\t                if age is not None and age < bound:\\n383\\t                    in_flight.append(f\\\"{name} (host {info.get('host')} since {info.get('at')})\\\")\\n384\\t                    continue\\n385\\t            problems.append(f\\\"{name} started {info.get('at')} on {info.get('host')} \\\"\\n386\\t                            f\\\"and never wrote its record\\\")\\n387\\t    if problems:\\n388\\t        return p.fail(\\\"; \\\".join(problems), unrecorded_invocations=len(problems),\\n389\\t                      running_invocations=running, in_flight=in_flight)\\n390\\t    return p.hold(f\\\"{recorded} invocation(s) recorded, {len(running)} running, \\\"\\n391\\t                  f\\\"{len(in_flight)} in flight elsewhere\\\",\\n392\\t                  unrecorded_invocations=0, running_invocations=running, in_flight=in_flight)\\n393\\t\\n394\\t\\n395\\tdef proof_one_item_every_stage(root: Path, m: dict[str, Any] | None) -> Proof:\\n396\\t    p = Proof(\\\"one-item-every-stage\\\", \\\"one item has traversed every stage\\\")\\n397\\t    if m is None:\\n398\\t        return p.fail(f\\\"no {MANIFEST} at {root}; no records directory is declared\\\")\\n399\\t    records_rel = m.get(\\\"paths\\\", {}).get(\\\"records\\\", \\\"\\\")\\n400\\t    records_dir = root / records_rel\\n401\\t    items = load_records(records_dir)\\n402\\t    if not items:\\n403\\t        return p.fail(f\\\"no work item under {records_dir.relative_to(root)}\\\")\\n404\\t    complete = [item for item, stages in items.items() if all(s in stages for s in STAGES)]\\n405\\t    if not complete:\\n406\\t        best = max(items.items(), key=lambda kv: len(kv[1]))\\n407\\t        lacking = [s for s in STAGES if s not in best[1]]\\n408\\t        return p.fail(f\\\"no item carries every stage; item {best[0]} lacks {', '.join(lacking)}\\\")\\n409\\t\\n410\\t    # issue #74: a complete item is counted only when its chain holds --\\n411\\t    # attavo attest refuses a build re-approved after the fact or a\\n412\\t    # verify whose build went stale, and the coherence gate refuses the\\n413\\t    # merge group on exactly that; a proof that never asked would call a\\n414\\t    # traversal the gate itself would not let through. The refusal text\\n415\\t    # is check_attest_chain's own, never re-typed here.\\n416\\t    refused, held, unmerged = [], [], []\\n417\\t    for item in complete:\\n418\\t        chain, message = check_attest_chain(records_dir / item, item)\\n419\\t        if chain is None:\\n420\\t            refused.append(f\\\"item {item}: {message}\\\")\\n421\\t            continue\\n422\\t        merge_sha, merge_refusal = merge_introducing_records(root, records_rel, item, STAGES)\\n423\\t        if merge_refusal:\\n424\\t            return p.fail(merge_refusal)\\n425\\t        if merge_sha:\\n426\\t            held.append((item, merge_sha))\\n427\\t        else:\\n428\\t            unmerged.append(item)\\n429\\t\\n430\\t    if held:\\n431\\t        names = \\\", \\\".join(item for item, _ in held)\\n432\\t        shas = \\\", \\\".join(sha[:12] for _, sha in held)\\n433\\t        return p.hold(f\\\"item(s) {names} carry {', '.join(STAGES)} with the chain held, \\\"\\n434\\t                      f\\\"merged at {shas}\\\")\\n435\\t    if refused:\\n436\\t        return p.fail(\\\"; \\\".join(refused))\\n437\\t    return p.fail(f\\\"item(s) {', '.join(unmerged)} carry every stage with the chain held but no \\\"\\n438\\t                  f\\\"merge commit's first-parent diff introduces all of them\\\")\\n439\\t\\n440\\t\\n441\\tdef commit_subject(root: Path, sha: str) -> str:\\n442\\t    return git(root, \\\"log\\\", \\\"-1\\\", \\\"--format=%s\\\", sha).strip()\\n443\\t\\n444\\t\\n445\\tdef touches_boundary(root: Path, sha: str, boundary_paths: list[str]) -> bool:\\n446\\t    \\\"\\\"\\\"Whether sha's first-parent diff touches a path [spec.boundary].paths\\n447\\t    declares governed -- an ordinary merge that does is a boundary\\n448\\t    evasion (issue #72): the tenant carried a governed change around the\\n449\\t    path the manifest itself names.\\\"\\\"\\\"\\n450\\t    diff = git(root, \\\"diff\\\", \\\"--name-only\\\", f\\\"{sha}^1\\\", sha).splitlines()\\n451\\t    return any(fnmatch.fnmatch(path, pattern) for path in diff for pattern in boundary_paths)\\n452\\t\\n453\\t\\n454\\tclass WindowRefused(Exception):\\n455\\t    \\\"\\\"\\\"The window start cannot be computed; str(exc) is the refusal.\\\"\\\"\\\"\\n456\\t\\n457\\t\\n458\\tdef proof_window_start(root: Path, m: dict[str, Any]) -> tuple[str, str, list[str]]:\\n459\\t    \\\"\\\"\\\"(install commit, window start, first-parent chain after the install\\n460\\t    commit): where proofs three and six start reading. The start is\\n461\\t    [doctor].from if the tenant set it, otherwise the commit that\\n462\\t    introduced the manifest (issue #192: proof six reads this too, so the\\n463\\t    two proofs cannot disagree).\\\"\\\"\\\"\\n464\\t    try:\\n465\\t        install = git(root, \\\"log\\\", \\\"--diff-filter=A\\\", \\\"--format=%H\\\",\\n466\\t                      \\\"--reverse\\\", \\\"--\\\", MANIFEST).split()\\n467\\t    except RuntimeError as exc:\\n468\\t        raise WindowRefused(f\\\"git: {exc}\\\") from exc\\n469\\t    if not install:\\n470\\t        raise WindowRefused(f\\\"{MANIFEST} is not committed; the tenant has no record boundary\\\")\\n471\\t    install_sha = install[0]\\n472\\t    full_chain = git(root, \\\"rev-list\\\", f\\\"{install_sha}..HEAD\\\", \\\"--first-parent\\\").split()\\n473\\t\\n474\\t    # issue #74: [doctor] from lets a tenant declare the doctor's read to\\n475\\t    # start at a later commit on main's first-parent line -- the point\\n476\\t    # after which every push arrived through the queue -- rather than the\\n477\\t    # install commit, which on a repository that adopted the product\\n478\\t    # after its history began is a boundary the doctor cannot otherwise\\n479\\t    # see. Any spelling git resolves is accepted (a short sha, a tag, a\\n480\\t    # ref) -- resolved with rev-parse --verify before the first-parent\\n481\\t    # check runs, so the two failure modes stay distinct: a spelling that\\n482\\t    # names no commit at all, and a commit that names one off the line.\\n483\\t    # Checked, not trusted: neither is silently forgiven back to install.\\n484\\t    declared_from = (m.get(\\\"doctor\\\") or {}).get(\\\"from\\\")\\n485\\t    window_start = install_sha\\n486\\t    if declared_from is not None:\\n487\\t        try:\\n488\\t            resolved_from = git(root, \\\"rev-parse\\\", \\\"--verify\\\", f\\\"{declared_from}^{{commit}}\\\").strip()\\n489\\t        except RuntimeError:\\n490\\t            raise WindowRefused(f\\\"[doctor] from {declared_from} does not resolve to a commit\\\") from None\\n491\\t        if resolved_from != install_sha and resolved_from not in full_chain:\\n492\\t            raise WindowRefused(f\\\"[doctor] from {declared_from} is not on main's first-parent \\\"\\n493\\t                                f\\\"line after the install commit {install_sha[:12]}\\\")\\n494\\t        window_start = resolved_from\\n495\\t    return install_sha, window_start, full_chain\\n496\\t\\n497\\t\\n498\\tdef proof_no_commit_lacks_record(root: Path, m: dict[str, Any] | None) -> Proof:\\n499\\t    p = Proof(\\\"no-commit-lacks-record\\\", \\\"no commit lacks a record\\\")\\n500\\t    if m is None:\\n501\\t        return p.fail(f\\\"no {MANIFEST} at {root}; the tenant has no record boundary\\\")\\n502\\t    try:\\n503\\t        install_sha, window_start, full_chain = proof_window_start(root, m)\\n504\\t    except WindowRefused as exc:\\n505\\t        return p.fail(str(exc))\\n506\\t    if not full_chain:\\n507\\t        return p.fail(f\\\"no commit after the install commit {install_sha[:12]}; nothing has been recorded\\\")\\n508\\t\\n509\\t    if window_start == install_sha:\\n510\\t        window_spec = f\\\"{install_sha}..HEAD\\\"\\n511\\t        commits = full_chain\\n512\\t    else:\\n513\\t        window_spec = f\\\"{window_start}^..HEAD\\\"\\n514\\t        commits = git(root, \\\"rev-list\\\", window_spec, \\\"--first-parent\\\").split()\\n515\\t    before_window = len(full_chain) - len(commits)\\n516\\t\\n517\\t    records_rel = m.get(\\\"paths\\\", {}).get(\\\"records\\\", \\\"\\\")\\n518\\t    records_dir = root / records_rel\\n519\\t    named: set[str] = set()\\n520\\t    for stages in load_records(records_dir).values():\\n521\\t        for rec in stages.values():\\n522\\t            sha = rec.get(\\\"sha\\\")\\n523\\t            if isinstance(sha, str):\\n524\\t                named.add(sha)\\n525\\t            for c in rec.get(\\\"commits\\\", []) or []:\\n526\\t                if isinstance(c, str):\\n527\\t                    named.add(c)\\n528\\t    record_commits = set(git(root, \\\"rev-list\\\", window_spec, \\\"--first-parent\\\",\\n529\\t                             \\\"--\\\", records_rel).split()) if records_rel else set()\\n530\\t    merges = set(git(root, \\\"rev-list\\\", window_spec, \\\"--first-parent\\\", \\\"--merges\\\").split())\\n531\\t    boundary_paths = ((m.get(\\\"spec\\\") or {}).get(\\\"boundary\\\") or {}).get(\\\"paths\\\") or []\\n532\\t\\n533\\t    # Every first-parent commit in the window is exactly one of three\\n534\\t    # (issue #72): recorded (a record names it, or its diff touches\\n535\\t    # paths.records), ordinary (a merge that doesn't), or unrecorded\\n536\\t    # (anything else -- on a protected main with a queue, a non-merge\\n537\\t    # commit is the only way a change arrives without the forge).\\n538\\t    recorded, ordinary, unrecorded = [], [], []\\n539\\t    ordinary_commits, unrecorded_commits = [], []\\n540\\t    boundary_evasions = 0\\n541\\t    for c in commits:\\n542\\t        if c in named or c in record_commits:\\n543\\t            recorded.append(c)\\n544\\t        elif c in merges:\\n545\\t            ordinary.append(c)\\n546\\t            evasion = bool(boundary_paths and touches_boundary(root, c, boundary_paths))\\n547\\t            if evasion:\\n548\\t                boundary_evasions += 1\\n549\\t            ordinary_commits.append({\\\"sha\\\": c, \\\"subject\\\": commit_subject(root, c),\\n550\\t                                     \\\"boundary_evasion\\\": evasion})\\n551\\t        else:\\n552\\t            unrecorded.append(c)\\n553\\t            unrecorded_commits.append({\\\"sha\\\": c, \\\"subject\\\": commit_subject(root, c)})\\n554\\t\\n555\\t    not_transport = driver_commits_not_transport(root, window_spec, records_rel) if records_rel else []\\n556\\t    counts = f\\\"{len(recorded)} recorded, {len(ordinary)} ordinary, {len(unrecorded)} unrecorded\\\"\\n557\\t    evasions = boundary_evasions if boundary_paths else \\\"n/a\\\"\\n558\\t    extra = {\\\"recorded\\\": len(recorded), \\\"ordinary\\\": len(ordinary),\\n559\\t             \\\"unrecorded\\\": len(unrecorded), \\\"boundary_evasions\\\": evasions,\\n560\\t             \\\"before_window\\\": before_window,\\n561\\t             \\\"ordinary_commits\\\": ordinary_commits, \\\"unrecorded_commits\\\": unrecorded_commits,\\n562\\t             \\\"driver_commits_not_transport\\\": not_transport}\\n563\\t    if not_transport:\\n564\\t        return p.fail(f\\\"a driver commit is not a records transport: {not_transport[0]}; {counts}\\\", **extra)\\n565\\t    if unrecorded:\\n566\\t        return p.fail(f\\\"{unrecorded[-1][:12]} lacks a record; {counts}; boundary evasions: \\\"\\n567\\t                      f\\\"{evasions}; before the window: {before_window}\\\", **extra)\\n568\\t    return p.hold(f\\\"{counts}; boundary evasions: {evasions}; before the window: {before_window}\\\",\\n569\\t                  **extra)\\n570\\t\\n571\\t\\n572\\tdef driver_commits_not_transport(root: Path, window_spec: str, records_rel: str) -> list[str]:\\n573\\t    \\\"\\\"\\\"Every commit in the window authored as driver_identity() that is not\\n574\\t    a records transport: more than one parent, or a path outside\\n575\\t    <records>/<N>/ for the one item N it touches. The driver's commits\\n576\\t    carry records and nothing else, one parent each (root cause 1: the\\n577\\t    driver makes them in a detached worktree and never merges), so one\\n578\\t    that does either was made by something other than the transport.\\n579\\t    Each entry reads `<sha12> <why>`.\\\"\\\"\\\"\\n580\\t    email = driver_identity()[\\\"email\\\"]\\n581\\t    bad: list[str] = []\\n582\\t    prefix = records_rel.strip(\\\"/\\\") + \\\"/\\\"\\n583\\t    out = git(root, \\\"log\\\", window_spec, \\\"--format=%H\\\\x1f%ae\\\\x1f%P\\\")\\n584\\t    for line in out.splitlines():\\n585\\t        sha, author, parents = line.split(\\\"\\\\x1f\\\")\\n586\\t        if author != email:\\n587\\t            continue\\n588\\t        if len(parents.split()) > 1:\\n589\\t            bad.append(f\\\"{sha[:12]} is a merge\\\")\\n590\\t            continue\\n591\\t        paths = git(root, \\\"diff-tree\\\", \\\"--no-commit-id\\\", \\\"--name-only\\\", \\\"-r\\\", \\\"--root\\\", sha).splitlines()\\n592\\t        items = {p[len(prefix):].split(\\\"/\\\", 1)[0] for p in paths if p.startswith(prefix) and \\\"/\\\" in p[len(prefix):]}\\n593\\t        outside = [p for p in paths if not (p.startswith(prefix) and \\\"/\\\" in p[len(prefix):])]\\n594\\t        if outside:\\n595\\t            bad.append(f\\\"{sha[:12]} touches {outside[0]}, outside its item's records\\\")\\n596\\t        elif len(items) > 1:\\n597\\t            bad.append(f\\\"{sha[:12]} touches the records of items {', '.join(sorted(items))}\\\")\\n598\\t    return bad\\n599\\t\\n600\\t\\n601\\tADAPTER_EXIT_RE = re.compile(r\\\"^\\\\[adapter exited \\\\d+\\\\]$\\\")\\n602\\t\\n603\\t_JSON_LINE_PARSE_FAILED = object()\\n604\\t\\n605\\t\\n606\\tdef _parse_json_line(text: str) -> Any:\\n607\\t    \\\"\\\"\\\"A line's own parsed JSON value, or the sentinel\\n608\\t    _JSON_LINE_PARSE_FAILED when it does not parse -- the one call site\\n609\\t    in this file for a defensive, line-at-a-time JSON parse, shared by\\n610\\t    proof four's own tool-error check below (any valid JSON satisfies\\n611\\t    it) and an events line's own `at` read (issue #151, which further\\n612\\t    requires a dict). A dedicated sentinel, not None: a line that is\\n613\\t    the literal JSON value null parses successfully and must read as\\n614\\t    such, not as a failure.\\\"\\\"\\\"\\n615\\t    try:\\n616\\t        return json.loads(text)\\n617\\t    except ValueError:\\n618\\t        return _JSON_LINE_PARSE_FAILED\\n619\\t\\n620\\t\\n621\\tdef _log_owes_tool_error(log: str | None) -> bool:\\n622\\t    \\\"\\\"\\\"True when a log's last non-empty line is exactly an adapter-exit\\n623\\t    marker and every line before it parses as JSON -- an adapter's own\\n624\\t    event stream, never a tool's own words (issue #94's own specimen,\\n625\\t    tenant zero's attest/records/659/verify-01.log: codex's\\n626\\t    \\\"thread.started\\\" event, then nothing but \\\"[adapter exited 1]\\\" -- the\\n627\\t    tool's real error line dropped before this reached the log, issue\\n628\\t    #86's own bug in split_adapter_stdout). A log that is only the exit\\n629\\t    marker, nothing before it at all, still owes the same line. An\\n630\\t    `error` event with a non-empty string `message` is the tool's own\\n631\\t    error delivered as an event (issue #200: \\\"Selected model is at\\n632\\t    capacity\\\"), so it owes nothing. So is an API error the tool reports as\\n633\\t    its own assistant message -- Claude Code's `\\\"is_api_error_message\\\":\\n634\\t    true` event, whose text is the tool's words (\\\"Failed to authenticate:\\n635\\t    OAuth session expired and could not be refreshed\\\", item 267 build-01\\n636\\t    and build-02, 2026-09-30) -- when that text is non-empty.\\\"\\\"\\\"\\n637\\t    if not log:\\n638\\t        return False\\n639\\t    lines = [l for l in log.splitlines() if l.strip()]\\n640\\t    if not lines or not ADAPTER_EXIT_RE.match(lines[-1]):\\n641\\t        return False\\n642\\t    for l in lines[:-1]:\\n643\\t        parsed = _parse_json_line(l)\\n644\\t        if parsed is _JSON_LINE_PARSE_FAILED:\\n645\\t            return False\\n646\\t        if isinstance(parsed, dict) and parsed.get(\\\"type\\\") == \\\"error\\\":\\n647\\t            message = parsed.get(\\\"message\\\")\\n648\\t            if isinstance(message, str) and message:\\n649\\t                return False\\n650\\t        if isinstance(parsed, dict) and parsed.get(\\\"is_api_error_message\\\") is True:\\n651\\t            if _api_error_text(parsed):\\n652\\t                return False\\n653\\t    return True\\n654\\t\\n655\\t\\n656\\tdef _api_error_text(event: dict[str, Any]) -> str:\\n657\\t    \\\"\\\"\\\"The text of an API error an adapter's tool delivered as its own\\n658\\t    assistant message: the non-empty text blocks of message.content,\\n659\\t    joined. Empty when there is none, which owes the line still.\\\"\\\"\\\"\\n660\\t    message = event.get(\\\"message\\\")\\n661\\t    content = message.get(\\\"content\\\") if isinstance(message, dict) else None\\n662\\t    if not isinstance(content, list):\\n663\\t        return \\\"\\\"\\n664\\t    texts = [b.get(\\\"text\\\") for b in content\\n665\\t             if isinstance(b, dict) and b.get(\\\"type\\\") == \\\"text\\\" and isinstance(b.get(\\\"text\\\"), str)]\\n666\\t    return \\\" \\\".join(t.strip() for t in texts if t and t.strip())\\n667\\t\\n668\\t\\n669\\tdef proof_no_stop_lacks_cause(root: Path, m: dict[str, Any] | None) -> Proof:\\n670\\t    p = Proof(\\\"no-stop-lacks-cause\\\", \\\"no stop lacks its cause\\\")\\n671\\t    if m is None:\\n672\\t        return p.fail(f\\\"no {MANIFEST} at {root}; no records directory is declared\\\")\\n673\\t    records_rel = m.get(\\\"paths\\\", {}).get(\\\"records\\\", \\\"\\\")\\n674\\t    records_dir = root / records_rel\\n675\\t    if not records_dir.is_dir():\\n676\\t        return p.fail(f\\\"no records directory under {records_dir}\\\")\\n677\\t\\n678\\t    # issue #89's own window lesson, proof three's already: a record\\n679\\t    # before record_version 3 has no stop by construction (schema\\n680\\t    # versions 1 and 2 predate it) -- counted here, never refused.\\n681\\t    older = 0\\n682\\t    checked = 0\\n683\\t    before_rederivable = 0\\n684\\t    problems: list[str] = []\\n685\\t    for item_dir in sorted(d for d in records_dir.iterdir() if d.is_dir()):\\n686\\t        for stage in STOP_STAGES:\\n687\\t            for n, rec in sorted(parse_attempts(item_dir, stage).items()):\\n688\\t                if rec.get(\\\"record_version\\\", 1) < 3:\\n689\\t                    older += 1\\n690\\t                    continue\\n691\\t                if rec.get(\\\"status\\\") == \\\"pass\\\":\\n692\\t                    continue\\n693\\t                checked += 1\\n694\\t                name = f\\\"{stage}-{n:02d}\\\"\\n695\\t                rederivable = rec.get(\\\"record_version\\\", 1) >= STOP_REDERIVABLE_FROM[stage]\\n696\\t                if not rederivable:\\n697\\t                    before_rederivable += 1\\n698\\t                stop = rec.get(\\\"stop\\\")\\n699\\t                if not stop:\\n700\\t                    problems.append(f\\\"item {item_dir.name} {name} carries no stop\\\")\\n701\\t                    continue\\n702\\t                cls, provenance = stop.get(\\\"class\\\"), stop.get(\\\"provenance\\\")\\n703\\t                if cls not in STOP_CLASSES:\\n704\\t                    problems.append(f\\\"item {item_dir.name} {name} stop.class {cls!r} names \\\"\\n705\\t                                    f\\\"no enumerated class\\\")\\n706\\t                    continue\\n707\\t                if provenance not in STOP_PROVENANCES:\\n708\\t                    problems.append(f\\\"item {item_dir.name} {name} stop.provenance \\\"\\n709\\t                                    f\\\"{provenance!r} names no enumerated provenance\\\")\\n710\\t                    continue\\n711\\t                # Issue #254: at the version that stores what the stop was\\n712\\t                # derived from, the stop is that function's value -- the\\n713\\t                # pass's own recovery records by their own rule.\\n714\\t                if rederivable and is_recovery_stop(rec):\\n715\\t                    fault = recovery_fault(rec)\\n716\\t                    if fault:\\n717\\t                        problems.append(f\\\"item {item_dir.name} {name} {fault}\\\")\\n718\\t                        continue\\n719\\t                elif rederivable:\\n720\\t                    derived = rederive_stop(stage, rec)\\n721\\t                    if derived is None or (derived[\\\"class\\\"], derived[\\\"provenance\\\"]) != (cls, provenance):\\n722\\t                        problems.append(\\n723\\t                            f\\\"item {item_dir.name} {name} stop is {cls}/{provenance} but its \\\"\\n724\\t                            f\\\"own fields derive \\\"\\n725\\t                            f\\\"{'no stop' if derived is None else derived['class'] + '/' + derived['provenance']}\\\")\\n726\\t                        continue\\n727\\t                if cls == \\\"unclassed\\\" and not stop.get(\\\"detail\\\"):\\n728\\t                    problems.append(f\\\"item {item_dir.name} {name} is unclassed with no detail\\\")\\n729\\t                    continue\\n730\\t                log_path = item_dir / f\\\"{name}.log\\\"\\n731\\t                log = log_path.read_text() if log_path.is_file() else None\\n732\\t                # Issue #89, rejection test 1's own specimen (tenant\\n733\\t                # zero's #659 build-01): a failed build that actually ran\\n734\\t                # the gates -- selected_tests is set only once cmd_build\\n735\\t                # reaches them -- owes their heading in the log, whatever\\n736\\t                # else stop already says.\\n737\\t                if (stage == \\\"build\\\" and rec.get(\\\"status\\\") == \\\"failed\\\"\\n738\\t                        and rec.get(\\\"selected_tests\\\") is not None\\n739\\t                        and \\\"--- attavo gates, iteration\\\" not in (log or \\\"\\\")):\\n740\\t                    problems.append(f\\\"item {item_dir.name} {name} failed after the gates ran \\\"\\n741\\t                                    f\\\"but its log carries no gates heading\\\")\\n742\\t                    continue\\n743\\t                if _log_owes_tool_error(log):\\n744\\t                    problems.append(f\\\"item {item_dir.name} {name}'s log ends in an adapter \\\"\\n745\\t                                    f\\\"exit with nothing before it but event lines; the tool's \\\"\\n746\\t                                    f\\\"own error line is owed\\\")\\n747\\t\\n748\\t        # issue #137: a refused spec-gate record is a stop too, class\\n749\\t        # \\\"gate\\\" -- synthesized the same way item_stops and\\n750\\t        # cmd_file_stops already read it, since cmd_spec_gate itself\\n751\\t        # carries no stop field to check for one. No record_version\\n752\\t        # gate here: unlike build/verify's own stop field, gate is never\\n753\\t        # persisted, so there is no older shape that predates it.\\n754\\t        for n, rec in sorted(parse_attempts(item_dir, \\\"spec\\\").items()):\\n755\\t            if rec.get(\\\"status\\\") != \\\"refused\\\":\\n756\\t                continue\\n757\\t            checked += 1\\n758\\t            name = f\\\"spec-{n:02d}\\\"\\n759\\t            stop = gate_stop(rec.get(\\\"refusal\\\"))\\n760\\t            cls, provenance = stop[\\\"class\\\"], stop[\\\"provenance\\\"]\\n761\\t            if cls not in STOP_CLASSES:\\n762\\t                problems.append(f\\\"item {item_dir.name} {name} stop.class {cls!r} names \\\"\\n763\\t                                f\\\"no enumerated class\\\")\\n764\\t                continue\\n765\\t            if provenance not in STOP_PROVENANCES:\\n766\\t                problems.append(f\\\"item {item_dir.name} {name} stop.provenance \\\"\\n767\\t                                f\\\"{provenance!r} names no enumerated provenance\\\")\\n768\\t                continue\\n769\\t            if not stop.get(\\\"detail\\\"):\\n770\\t                problems.append(f\\\"item {item_dir.name} {name} is a gate stop with no cause\\\")\\n771\\t\\n772\\t    older_note = (f\\\"{older} record(s) before stop was recorded; {before_rederivable} non-pass \\\"\\n773\\t                 f\\\"record(s) before their stop could be re-derived\\\")\\n774\\t    if problems:\\n775\\t        return p.fail(\\\"; \\\".join(problems), older_records=older,\\n776\\t                     before_rederivable=before_rederivable)\\n777\\t    return p.hold(f\\\"{checked} checked ({older_note})\\\" if checked == 0\\n778\\t                 else f\\\"{checked} non-pass record(s) carry stop with a cause ({older_note})\\\",\\n779\\t                 older_records=older, before_rederivable=before_rederivable)\\n780\\t\\n781\\t\\n782\\tdef attestation_command(m: dict[str, Any]) -> str | None:\\n783\\t    \\\"\\\"\\\"[forge].attestation_command: the tenant's own read of the store,\\n784\\t    given a merge sha on stdin, printing the statement as JSON on exit 0\\n785\\t    and nothing on a non-zero exit. Absent is not passing (issue #158:\\n786\\t    the doctor said done while #106, #148, #153 had no statement in the\\n787\\t    store at all -- there was no key to read one through).\\\"\\\"\\\"\\n788\\t    cmd = (m.get(\\\"forge\\\") or {}).get(\\\"attestation_command\\\")\\n789\\t    return cmd if isinstance(cmd, str) and cmd.strip() else None\\n790\\t\\n791\\t\\n792\\tdef statement_for(root: Path, cmd: str, merge_sha: str) -> tuple[dict[str, Any] | None, int]:\\n793\\t    \\\"\\\"\\\"The statement the forge holds for merge_sha and the command's exit\\n794\\t    code. The statement is None when the command exits non-zero or prints\\n795\\t    anything but a JSON object -- exit 2 means the store itself could not\\n796\\t    be read (issue #158, amended after build-05: distinct from exit 1,\\n797\\t    the store read fine and simply held no statement).\\\"\\\"\\\"\\n798\\t    run = subprocess.run(cmd, shell=True, cwd=str(root), input=merge_sha + \\\"\\\\n\\\",\\n799\\t                         capture_output=True, text=True, check=False)\\n800\\t    if run.returncode != 0:\\n801\\t        return None, run.returncode\\n802\\t    try:\\n803\\t        parsed = json.loads(run.stdout)\\n804\\t    except ValueError:\\n805\\t        return None, run.returncode\\n806\\t    return (parsed if isinstance(parsed, dict) else None), run.returncode\\n807\\t\\n808\\t\\n809\\tdef _is_ancestor(root: Path, earlier: str, later: str) -> bool:\\n810\\t    run = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"merge-base\\\", \\\"--is-ancestor\\\", earlier, later],\\n811\\t                         capture_output=True, check=False)\\n812\\t    return run.returncode == 0\\n813\\t\\n814\\t\\n815\\t# Maps whose keys are the records' data (a stage or an adapter that cost\\n816\\t# something), not a release's fields: a key missing from one is a difference.\\n817\\tDATA_KEYED = (\\\"by_stage_usd\\\", \\\"by_adapter_usd\\\")\\n818\\t\\n819\\t\\n820\\tdef _same(stated: Any, summed: Any) -> bool:\\n821\\t    \\\"\\\"\\\"Equal as the accounting means it: a number equals a number of the\\n822\\t    same value (a store may print 40.0 as 40), a bool equals only a bool,\\n823\\t    and a list is equal member by member. No tolerance and no conversion:\\n824\\t    both sides are the same function's rounding of the same records, and an\\n825\\t    int one past 2**53 is not the float beside it.\\\"\\\"\\\"\\n826\\t    if isinstance(stated, bool) or isinstance(summed, bool):\\n827\\t        return isinstance(stated, bool) and isinstance(summed, bool) and stated == summed\\n828\\t    if isinstance(stated, (int, float)) and isinstance(summed, (int, float)):\\n829\\t        return bool(stated == summed)\\n830\\t    if isinstance(stated, list) and isinstance(summed, list):\\n831\\t        return len(stated) == len(summed) and all(_same(a, b) for a, b in zip(stated, summed))\\n832\\t    return type(stated) is type(summed) and bool(stated == summed)\\n833\\t\\n834\\t\\n835\\tdef _differences(path: str, stated: Any, summed: Any, keyed_by_data: bool = False) -> list[str]:\\n836\\t    \\\"\\\"\\\"Every field of `stated` that is not what its records sum to, named by\\n837\\t    its path. Only the keys the statement carries are compared, at every\\n838\\t    depth, so a field a later release adds is not demanded of a statement\\n839\\t    sealed before it; a key it carries that the function does not produce\\n840\\t    is a difference.\\\"\\\"\\\"\\n841\\t    if not (isinstance(stated, dict) and isinstance(summed, dict)):\\n842\\t        return [] if _same(stated, summed) else [f\\\"{path} {stated!r} is not its records' {summed!r}\\\"]\\n843\\t    found: list[str] = []\\n844\\t    for key in sorted(stated):\\n845\\t        if key not in summed:\\n846\\t            found.append(f\\\"{path}.{key} {stated[key]!r} is not a field its records sum to\\\")\\n847\\t        else:\\n848\\t            found += _differences(f\\\"{path}.{key}\\\", stated[key], summed[key], key in DATA_KEYED)\\n849\\t    if keyed_by_data:\\n850\\t        found += [f\\\"{path}.{key} is absent; its records sum to {summed[key]!r}\\\"\\n851\\t                  for key in sorted(summed.keys() - stated.keys())]\\n852\\t    return found\\n853\\t\\n854\\t\\n855\\tdef _carried(predicate: dict[str, Any], key: str) -> str:\\n856\\t    return repr(predicate[key]) if key in predicate else \\\"absent\\\"\\n857\\t\\n858\\t\\n859\\tdef _accounting_disagrees(root: Path, item_records_dir: Path, item: str, merge_sha: str,\\n860\\t                          statement: dict[str, Any]) -> str | None:\\n861\\t    \\\"\\\"\\\"A sealed statement that carries `time` and `cost` says what its\\n862\\t    records sum to, field by field -- the same function attest summed them\\n863\\t    with, over the same records (none is written after a merge), sealed at\\n864\\t    the same commit (the statement is computed at the merge, so lead_s and\\n865\\t    waiting_s are recomputed from its committer time, not excepted). Exact:\\n866\\t    #202 retired the one-second tolerance. A statement sealed before `time`\\n867\\t    existed carries neither key and is not checked; a key that is present\\n868\\t    holds a block, so a null one, or one block without the other, is a\\n869\\t    disagreement. No new read of the store.\\\"\\\"\\\"\\n870\\t    inner = statement.get(\\\"predicate\\\")\\n871\\t    predicate = inner if isinstance(inner, dict) else statement\\n872\\t    if \\\"time\\\" not in predicate and \\\"cost\\\" not in predicate:\\n873\\t        return None\\n874\\t    stated_time, stated_cost = predicate.get(\\\"time\\\"), predicate.get(\\\"cost\\\")\\n875\\t    where = f\\\"item {item} merged at {merge_sha[:12]}\\\"\\n876\\t    if not isinstance(stated_time, dict) or not isinstance(stated_cost, dict):\\n877\\t        return (f\\\"{where}: the statement's time and cost are not both blocks \\\"\\n878\\t                f\\\"(time is {_carried(predicate, 'time')}, cost is {_carried(predicate, 'cost')})\\\")\\n879\\t    try:\\n880\\t        sealed_at: int | None = int(git(root, \\\"show\\\", \\\"-s\\\", \\\"--format=%ct\\\", merge_sha).strip())\\n881\\t    except (RuntimeError, ValueError):\\n882\\t        sealed_at = None\\n883\\t    summed_time, summed_cost = item_time_and_cost(item_records_dir, sealed_at)\\n884\\t    differing = (_differences(\\\"time\\\", stated_time, dict(summed_time))\\n885\\t                 + _differences(\\\"cost\\\", stated_cost, dict(summed_cost)))\\n886\\t    if differing:\\n887\\t        return f\\\"{where}: the statement's \\\" + \\\"; \\\".join(differing)\\n888\\t    return None\\n889\\t\\n890\\t\\n891\\tdef proof_every_attested_item_is_sealed(root: Path, m: dict[str, Any] | None) -> Proof:\\n892\\t    p = Proof(\\\"every-attested-item-is-sealed\\\", \\\"every attested item has its statement in the store\\\")\\n893\\t    if m is None:\\n894\\t        return p.fail(f\\\"no {MANIFEST} at {root}; no records directory is declared\\\")\\n895\\t    cmd = attestation_command(m)\\n896\\t    if cmd is None:\\n897\\t        return p.fail(\\\"no [forge].attestation_command in the manifest; the store cannot be read\\\")\\n898\\t    records_rel = m.get(\\\"paths\\\", {}).get(\\\"records\\\", \\\"\\\")\\n899\\t    records_dir = root / records_rel\\n900\\t    if not records_dir.is_dir():\\n901\\t        return p.fail(f\\\"no records directory under {records_dir}\\\")\\n902\\t    items = load_records(records_dir)\\n903\\t    complete = [item for item, stages in sorted(items.items()) if all(s in stages for s in STAGES)]\\n904\\t\\n905\\t    # [forge].sealed_since: merges at or before this commit are before the\\n906\\t    # window -- the tenant could not seal them (no queue, no signing\\n907\\t    # workflow, or a store that held nothing yet). They are named, never\\n908\\t    # failed. Absent, the window starts where proof three's does: the\\n909\\t    # install commit, or [doctor].from (issue #192).\\n910\\t    since = (m.get(\\\"forge\\\") or {}).get(\\\"sealed_since\\\")\\n911\\t    if not (isinstance(since, str) and since.strip()):\\n912\\t        try:\\n913\\t            since = proof_window_start(root, m)[1]\\n914\\t        except WindowRefused as exc:\\n915\\t            return p.fail(str(exc))\\n916\\t    merges, refusal = _merges_reachable(root)\\n917\\t    if refusal:\\n918\\t        return p.fail(refusal)\\n919\\t    sealed: list[str] = []\\n920\\t    before_window: list[str] = []\\n921\\t    unsealed: list[str] = []\\n922\\t    not_merged: list[str] = []\\n923\\t    not_read: list[str] = []\\n924\\t    reasons: list[str] = []\\n925\\t    for item in complete:\\n926\\t        merge_sha, _ = merge_introducing_records(root, records_rel, item, STAGES, merges=merges)\\n927\\t        if merge_sha is None:\\n928\\t            not_merged.append(item)\\n929\\t            continue\\n930\\t        if _is_ancestor(root, merge_sha, since):\\n931\\t            before_window.append(item)\\n932\\t            continue\\n933\\t        statement, exit_code = statement_for(root, cmd, merge_sha)\\n934\\t        if statement is not None:\\n935\\t            sealed.append(item)\\n936\\t            disagreement = _accounting_disagrees(root, records_dir / item, item, merge_sha,\\n937\\t                                                 statement)\\n938\\t            if disagreement:\\n939\\t                reasons.append(disagreement)\\n940\\t        elif exit_code == 2:\\n941\\t            not_read.append(item)\\n942\\t            reasons.append(f\\\"item {item} merged at {merge_sha[:12]}: not read -- \\\"\\n943\\t                           f\\\"the store could not be read; {cmd!r} exited 2\\\")\\n944\\t        else:\\n945\\t            unsealed.append(item)\\n946\\t            reasons.append(f\\\"item {item} merged at {merge_sha[:12]} has no statement in the store\\\")\\n947\\t    if reasons:\\n948\\t        return p.fail(\\\"; \\\".join(reasons), sealed=sealed, before_window=before_window,\\n949\\t                      unsealed=unsealed, not_merged=not_merged, not_read=not_read)\\n950\\t    window = f\\\" at {since[:12]}\\\" if before_window else \\\"\\\"\\n951\\t    return p.hold(f\\\"{len(sealed)} sealed, {len(before_window)} before the window{window}, \\\"\\n952\\t                 f\\\"{len(not_merged)} not merged\\\",\\n953\\t                 sealed=sealed, before_window=before_window, unsealed=unsealed,\\n954\\t                 not_merged=not_merged, not_read=not_read)\\n955\\t\\n956\\t\\n957\\tdef proof_no_attested_item_is_empty(root: Path, m: dict[str, Any] | None) -> Proof:\\n958\\t    \\\"\\\"\\\"Proof seven (item 227). Every merged, fully-staged item's passing\\n959\\t    build names a change: its tree, restricted to the item's own spec\\n960\\t    claims, differs from the approved tree there (item 229 -- asked\\n961\\t    against the approval, not the build's own start_sha, so a build\\n962\\t    that adopted a prior attempt's valid commits is not empty just\\n963\\t    because that attempt owed no commit of its own; scoped to claims,\\n964\\t    not \\\"everything outside paths.records\\\", so a commit that lands\\n965\\t    between approval and a later attempt's start but touches no\\n966\\t    claimed path never rescues or defeats the comparison on its own\\n967\\t    account). Item 227 was specified, approved, built by one\\n968\\t    invocation, judged by another, merged and sealed, and its build\\n969\\t    committed nothing -- the executor left the stub in the working tree,\\n970\\t    the gate read the tree, and main received the spec and none of the\\n971\\t    change. Six proofs held over it.\\n972\\t\\n973\\t    [doctor].built_since: merges at or before this commit are before the\\n974\\t    window -- named, never failed -- so the specimen stands on every\\n975\\t    doctor run without failing the tenant forever. Absent, the window is\\n976\\t    proof three's. A build record whose approval cannot be resolved\\n977\\t    (no approval_sha at all, or one this repository cannot read) is\\n978\\t    named as not readable, not failed.\\\"\\\"\\\"\\n979\\t    p = Proof(\\\"no-attested-item-is-empty\\\", \\\"every attested item's build names a change\\\")\\n980\\t    if m is None:\\n981\\t        return p.fail(f\\\"no {MANIFEST} at {root}; no records directory is declared\\\")\\n982\\t    records_rel = m.get(\\\"paths\\\", {}).get(\\\"records\\\", \\\"\\\")\\n983\\t    specs_rel = m.get(\\\"paths\\\", {}).get(\\\"specs\\\", \\\"\\\")\\n984\\t    records_dir = root / records_rel\\n985\\t    if not records_dir.is_dir():\\n986\\t        return p.fail(f\\\"no records directory under {records_dir}\\\")\\n987\\t    items = load_records(records_dir)\\n988\\t    complete = [item for item, stages in sorted(items.items()) if all(s in stages for s in STAGES)]\\n989\\t    since = (m.get(\\\"doctor\\\") or {}).get(\\\"built_since\\\")\\n990\\t    if not (isinstance(since, str) and since.strip()):\\n991\\t        try:\\n992\\t            since = proof_window_start(root, m)[1]\\n993\\t        except WindowRefused as exc:\\n994\\t            return p.fail(str(exc))\\n995\\t    else:\\n996\\t        try:\\n997\\t            since = git(root, \\\"rev-parse\\\", \\\"--verify\\\", f\\\"{since}^{{commit}}\\\").strip()\\n998\\t        except RuntimeError:\\n999\\t            return p.fail(f\\\"[doctor] built_since {since} does not resolve to a commit\\\")\\n1000\\t    merges, refusal = _merges_reachable(root)\\n1001\\t    if refusal:\\n1002\\t        return p.fail(refusal)\\n1003\\t    built: list[str] = []\\n1004\\t    before_window: list[str] = []\\n1005\\t    not_merged: list[str] = []\\n1006\\t    not_read: list[str] = []\\n1007\\t    empty: list[str] = []\\n1008\\t    for item in complete:\\n1009\\t        merge_sha, _ = merge_introducing_records(root, records_rel, item, STAGES, merges=merges)\\n1010\\t        if merge_sha is None:\\n1011\\t            not_merged.append(item)\\n1012\\t            continue\\n1013\\t        if _is_ancestor(root, merge_sha, since):\\n1014\\t            before_window.append(item)\\n1015\\t            continue\\n1016\\t        build = items[item][\\\"build\\\"]\\n1017\\t        sha, approval_sha = build.get(\\\"sha\\\"), build.get(\\\"approval_sha\\\")\\n1018\\t        if not sha or not approval_sha:\\n1019\\t            not_read.append(item)\\n1020\\t            continue\\n1021\\t        spec_md = root / specs_rel / item / \\\"spec.md\\\"\\n1022\\t        claims: list[str] = []\\n1023\\t        if spec_md.is_file():\\n1024\\t            parsed, _ = parse_spec(spec_md)\\n1025\\t            claims = parsed[\\\"claims\\\"] if parsed else []\\n1026\\t        is_empty = build_is_empty(root, approval_sha, sha, claims)\\n1027\\t        if is_empty is None:\\n1028\\t            not_read.append(item)\\n1029\\t        elif is_empty:\\n1030\\t            empty.append(f\\\"item {item} merged at {merge_sha[:12]}: build names no \\\"\\n1031\\t                         \\\"claimed change; nothing was built\\\")\\n1032\\t        else:\\n1033\\t            built.append(item)\\n1034\\t    if empty:\\n1035\\t        return p.fail(\\\"; \\\".join(empty), built=built, before_window=before_window,\\n1036\\t                      not_merged=not_merged, not_read=not_read)\\n1037\\t    window = f\\\" at {since[:12]}\\\" if before_window else \\\"\\\"\\n1038\\t    return p.hold(f\\\"{len(built)} built, {len(before_window)} before the window{window}, \\\"\\n1039\\t                  f\\\"{len(not_read)} without a readable approval, {len(not_merged)} not merged\\\",\\n1040\\t                  built=built, before_window=before_window, not_merged=not_merged,\\n1041\\t                  not_read=not_read)\\n1042\\t\\n1043\\t\\n1044\\tdef doctor(root: Path) -> list[Proof]:\\n1045\\t    m = read_manifest(root)\\n1046\\t    return [proof_every_gate_rejects(root, m),\\n1047\\t            proof_one_item_every_stage(root, m),\\n1048\\t            proof_no_commit_lacks_record(root, m),\\n1049\\t            proof_no_stop_lacks_cause(root, m),\\n1050\\t            proof_no_invocation_lacks_record(root, m),\\n1051\\t            proof_every_attested_item_is_sealed(root, m),\\n1052\\t            proof_no_attested_item_is_empty(root, m)]\\n1053\\t\\n1054\\t\\n1055\\tdef cmd_doctor(argv: list[str]) -> int:\\n1056\\t    as_json = \\\"--json\\\" in argv\\n1057\\t    args = [a for a in argv if a != \\\"--json\\\"]\\n1058\\t    root = Path(args[0] if args else \\\".\\\").resolve()\\n1059\\t    proofs = doctor(root)\\n1060\\t    if as_json:\\n1061\\t        print(json.dumps({\\\"root\\\": str(root), \\\"done\\\": all(p.holds for p in proofs),\\n1062\\t                          \\\"proofs\\\": [p.as_dict() for p in proofs]}, indent=2))\\n1063\\t    else:\\n1064\\t        for i, p in enumerate(proofs, 1):\\n1065\\t            print(f\\\"proof {i} {p.key}: {'HOLDS' if p.holds else 'FAILS'}: {p.reason}\\\")\\n1066\\t        print(\\\"doctor: done\\\" if all(p.holds for p in proofs)\\n1067\\t              else f\\\"doctor: not done ({sum(not p.holds for p in proofs)} of \\\"\\n1068\\t                   f\\\"{len(proofs)} proofs fail)\\\")\\n1069\\t    return 0 if all(p.holds for p in proofs) else 1\\n1070\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"b3f717aa-5c2b-4867-b022-0f24cffb6427\",\"uuid\":\"ff3f3742-87ad-44df-84f9-c6459ceb69c3\",\"timestamp\":\"2026-09-30T23:05:35.872Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/davidbean/Projects/attavo-worktree-289/attest/specs/289/stub/attavo/doctor.py\",\"content\":\"from __future__ import annotations\\n\\nimport fnmatch\\nimport json\\nimport os\\nimport re\\nimport subprocess\\nfrom pathlib import Path\\nfrom typing import Any\\n\\nfrom attavo import clock\\nfrom attavo.attest import check_attest_chain, item_time_and_cost\\nfrom attavo.build import build_is_empty, driver_identity\\nfrom attavo.common import (\\n    MANIFEST,\\n    Proof,\\n    STAGES,\\n    fixture_item_id,\\n    git,\\n    product_version,\\n    read_manifest,\\n)\\nfrom attavo.events import stage_events_dir\\nfrom attavo.records import RECORD_RE, load_records, parse_attempts\\nfrom attavo.spec import parse_spec\\nfrom attavo.stops import (\\n    STOP_CLASSES,\\n    STOP_PROVENANCES,\\n    STOP_REDERIVABLE_FROM,\\n    STOP_STAGES,\\n    gate_stop,\\n    is_recovery_stop,\\n    recovery_fault,\\n    rederive_stop,\\n)\\n\\n# --- doctor's three proofs ---\\n\\ndef proof_every_gate_rejects(root: Path, m: dict[str, Any] | None) -> Proof:\\n    p = Proof(\\\"every-gate-rejects\\\", \\\"every gate rejects its fixture\\\")\\n    if m is None:\\n        return p.fail(f\\\"no {MANIFEST} at {root}; no gate is registered\\\")\\n    gates = m.get(\\\"gates\\\") or {}\\n    if not gates:\\n        return p.fail(\\\"[gates] is empty; a gate that has rejected nothing does not exist\\\")\\n    fixtures = root / m.get(\\\"paths\\\", {}).get(\\\"rejections\\\", \\\"\\\")\\n    # Proposal, not yet ruled on (issue #54): a gate that retires nothing\\n    # only adds, so proof one reports it here rather than waiting on the\\n    # schema alone -- read_manifest never validates against the manifest\\n    # schema at runtime, so a schema requirement is not an enforced one.\\n    no_retires = [name for name, gate in sorted(gates.items()) if not gate.get(\\\"retires\\\")]\\n    missing, accepted = [], []\\n    for name, gate in sorted(gates.items()):\\n        fixture = fixtures / name\\n        if not fixture.is_dir():\\n            missing.append(name)\\n            continue\\n        env = dict(os.environ)\\n        item = fixture_item_id(fixture)\\n        if item is not None:\\n            env[\\\"ATTAVO_ITEM\\\"] = item\\n        run = subprocess.run(gate[\\\"command\\\"], shell=True, cwd=str(fixture),\\n                             capture_output=True, text=True, check=False, env=env)\\n        if run.returncode == 0:\\n            accepted.append(name)\\n    if missing:\\n        return p.fail(f\\\"gate(s) with no rejection fixture: {', '.join(missing)}\\\")\\n    if accepted:\\n        return p.fail(f\\\"gate(s) that accepted their rejection fixture: {', '.join(accepted)}\\\")\\n    if no_retires:\\n        return p.fail(f\\\"gate(s) with no retires: {', '.join(no_retires)}\\\")\\n    return p.hold(f\\\"{len(gates)} gate(s) rejected their fixture\\\")\\n\\n\\ndef _merges_reachable(root: Path, ref: str | None = None) -> tuple[list[dict[str, Any]], str | None]:\\n    \\\"\\\"\\\"(merges, refusal): every merge commit on the default branch's own\\n    first-parent line -- sha, parents, and its own first-parent diff --\\n    read by one process rather than the git log plus one git diff per\\n    merge merge_introducing_records used to pay walking toward the one\\n    it wants (issue #153). refs/remotes/origin/HEAD names the default\\n    branch without hard-coding \\\"main\\\", the same primitive\\n    diff_since_approval already uses (issue #52); walking from it rather\\n    than from HEAD is what keeps a transport merge on an item branch, a\\n    pull_request checkout's own synthetic test merge, and a merge_group's\\n    temporary merge from ever being mistaken for an item's merge (issue\\n    #169) -- none of those is reachable from the default branch's first-\\n    parent line by definition. When refs/remotes/origin/HEAD is not set,\\n    this refuses by name rather than guess, exactly as diff_since_approval\\n    does.\\n\\n    The walk starts at HEAD itself when the current checkout is literally\\n    on the branch refs/remotes/origin/HEAD names (an ordinary checkout of\\n    the default branch, on push or on a developer's own machine) and at\\n    the remote-tracking ref's own value otherwise (any other branch, or\\n    the detached HEAD a pull_request or merge_group checkout leaves\\n    behind) -- HEAD only ever *is* the default branch's first-parent line\\n    in the former case; in the latter, only the remote-tracking ref names\\n    it. --diff-merges=first-parent gives each merge's diff against its\\n    first parent in the same pass git log --merges already makes to list\\n    them, in the same order, newest first.\\\"\\\"\\\"\\n    symref = subprocess.run(\\n        [\\\"git\\\", \\\"-C\\\", str(root), \\\"symbolic-ref\\\", \\\"-q\\\", \\\"refs/remotes/origin/HEAD\\\"],\\n        capture_output=True, text=True, check=False)\\n    if symref.returncode != 0:\\n        return [], \\\"refs/remotes/origin/HEAD is not set; run `git remote set-head origin -a`\\\"\\n    default_remote_ref = symref.stdout.strip()\\n    default_branch = default_remote_ref.rsplit(\\\"/\\\", 1)[-1]\\n    current_branch = subprocess.run(\\n        [\\\"git\\\", \\\"-C\\\", str(root), \\\"symbolic-ref\\\", \\\"-q\\\", \\\"--short\\\", \\\"HEAD\\\"],\\n        capture_output=True, text=True, check=False)\\n    default_ref = ref or (\\\"HEAD\\\" if current_branch.returncode == 0\\n                          and current_branch.stdout.strip() == default_branch\\n                          else default_remote_ref)\\n    try:\\n        out = git(root, \\\"log\\\", default_ref, \\\"--first-parent\\\", \\\"--merges\\\",\\n                 \\\"--diff-merges=first-parent\\\", \\\"--name-only\\\",\\n                 \\\"--format=\\\\x01%H\\\\x1f%P\\\")\\n    except RuntimeError:\\n        return [], None\\n    merges = []\\n    for block in out.split(\\\"\\\\x01\\\")[1:]:\\n        header, _, rest = block.partition(\\\"\\\\n\\\")\\n        sha, parents = header.split(\\\"\\\\x1f\\\")\\n        merges.append({\\\"sha\\\": sha, \\\"parents\\\": parents.split(),\\n                       \\\"touched\\\": [line for line in rest.splitlines() if line.strip()]})\\n    return merges, None\\n\\n\\ndef merge_introducing_records(root: Path, records_rel: str, item: str,\\n                              stages: tuple[str, ...],\\n                              merges: list[dict[str, Any]] | None = None) -> tuple[str | None, str | None]:\\n    \\\"\\\"\\\"(merge_sha, refusal): the merge commit on the default branch's own\\n    first-parent line whose first-parent diff introduces a record for\\n    every one of stages, under records_rel/item/ -- the same derivation\\n    attest itself uses (derive_attest_items), read here so proof two\\n    requires an item's stage records to have arrived by an actual merge\\n    on the default branch, not merely to sit in the tree, and not by a\\n    transport merge, a pull_request checkout's synthetic test merge, or a\\n    merge_group's temporary merge (issue #69 acceptance row 4; issue\\n    #169). merge_sha is None with no refusal when no such merge exists\\n    yet -- the item is not merged, not that the walk failed.\\n\\n    merges, when given, is _merges_reachable's own result -- ledger's\\n    cmd_ledger computes it once and passes it to every item rather than\\n    walking the default branch's merges again for each (issue #153); a\\n    caller that already has merges has also already handled\\n    _merges_reachable's refusal, so this never re-derives one. Left\\n    None, a caller with just the one item to ask (doctor's proof two)\\n    gets merges computed here, refusal and all.\\\"\\\"\\\"\\n    if merges is None:\\n        merges, refusal = _merges_reachable(root)\\n        if refusal:\\n            return None, refusal\\n    prefix = f\\\"{records_rel.rstrip('/')}/{item}/\\\"\\n    for merge in merges:\\n        found: set[str] = set()\\n        for p in merge[\\\"touched\\\"]:\\n            if p.startswith(prefix):\\n                m = RECORD_RE.match(Path(p).name)\\n                if m:\\n                    found.add(m.group(1))\\n        if all(s in found for s in stages):\\n            return merge[\\\"sha\\\"], None\\n    return None, None\\n\\n\\nINVOCATION_MARKER_SUFFIX = \\\".started\\\"\\n\\n\\ndef invocation_marker_path(records_dir: Path, stage: str, nn: int) -> Path:\\n    return records_dir / f\\\"{stage}-{nn:02d}{INVOCATION_MARKER_SUFFIX}\\\"\\n\\n\\ndef heartbeat_s() -> float:\\n    return float(os.environ.get(\\\"ATTAVO_HEARTBEAT_S\\\", 15))\\n\\n\\ndef heartbeat_path(root: Path, stage: str, nn: int) -> Path:\\n    return stage_events_dir(root) / f\\\"{stage}-{nn:02d}.heartbeat\\\"\\n\\n\\ndef holder_heartbeat_path(root: Path, info: dict[str, Any], stage: str, nn: int) -> Path | None:\\n    \\\"\\\"\\\"Where the holder of an invocation writes its heartbeat, as far as\\n    this host can read it: the directory its marker names, when the\\n    marker is from this host and names one; this checkout's own, for a\\n    marker from this host written before markers named it; None for a\\n    marker from another host, whose heartbeat no file here holds.\\\"\\\"\\\"\\n    import socket\\n    if info.get(\\\"host\\\") != socket.gethostname():\\n        return None\\n    events = info.get(\\\"events\\\")\\n    if isinstance(events, str) and events:\\n        return Path(events) / f\\\"{stage}-{nn:02d}.heartbeat\\\"\\n    return heartbeat_path(root, stage, nn)\\n\\n\\ndef heartbeat_pid(path: Path) -> int | None:\\n    \\\"\\\"\\\"The pid the worker wrote as its heartbeat file's one line on its\\n    first beat -- the holder's own, the only pid anyone signals. None when\\n    the file is absent, unreadable, empty (a worker from before this\\n    release touched it and wrote nothing), or not a positive integer.\\\"\\\"\\\"\\n    try:\\n        text = path.read_text().strip()\\n    except OSError:\\n        return None\\n    if not text.isdigit() or int(text) <= 0:\\n        return None\\n    return int(text)\\n\\n\\ndef heartbeat_age_s(path: Path) -> float | None:\\n    \\\"\\\"\\\"Seconds since the heartbeat file was last touched; None when there\\n    is no such file.\\\"\\\"\\\"\\n    try:\\n        return clock.now() - path.stat().st_mtime\\n    except OSError:\\n        return None\\n\\n\\ndef write_invocation_marker(root: Path, records_dir: Path, stage: str, nn: int,\\n                            again_by: str | None = None, events_dir: Path | None = None) -> Path:\\n    \\\"\\\"\\\"The fact that an invocation began, written before it does: at,\\n    host, the sha it starts on, and the product that started it. No pid:\\n    the writer is `attavo drive`, which returns seconds later, and the\\n    process that holds the stage is the worker, whose own heartbeat is\\n    the fact of holding it. Its record's arrival is what retires a\\n    marker; a marker with no record is an invocation that died or hangs,\\n    and proof five names it. again_by is the login that pressed `--again`\\n    to reset a stage whose budget was spent (or whose last two signatures\\n    matched) -- absent on every ordinary marker, never a bare false.\\n    events names the directory the holder's heartbeat will be written in\\n    (the checkout's own <git-dir>/attavo, events_dir when the marker is\\n    written from a detached worktree for another checkout): two checkouts\\n    on one host each keep their own, so the host alone never says where\\n    the holder's heartbeat can be read.\\\"\\\"\\\"\\n    import socket\\n    from datetime import datetime, timezone\\n    records_dir.mkdir(parents=True, exist_ok=True)\\n    path = invocation_marker_path(records_dir, stage, nn)\\n    sha = git(root, \\\"rev-parse\\\", \\\"HEAD\\\").strip()\\n    info: dict[str, Any] = {\\\"at\\\": datetime.now(timezone.utc).strftime(\\\"%Y-%m-%dT%H:%M:%SZ\\\"),\\n                            \\\"host\\\": socket.gethostname(), \\\"sha\\\": sha,\\n                            \\\"product_version\\\": product_version(),\\n                            \\\"events\\\": str(events_dir or stage_events_dir(root))}\\n    if again_by:\\n        info[\\\"again_by\\\"] = again_by\\n    path.write_text(json.dumps(info, indent=2) + \\\"\\\\n\\\")\\n    return path\\n\\n\\ndef invocation_age_s(info: dict[str, Any]) -> float | None:\\n    \\\"\\\"\\\"Seconds since the marker's own `at` timestamp -- how long ago the\\n    invocation it names began, whatever host wrote it. None when `at` is\\n    missing or does not parse.\\\"\\\"\\\"\\n    from datetime import datetime, timezone\\n    at = info.get(\\\"at\\\")\\n    if not isinstance(at, str):\\n        return None\\n    try:\\n        stamp = datetime.strptime(at, \\\"%Y-%m-%dT%H:%M:%SZ\\\").replace(tzinfo=timezone.utc)\\n    except ValueError:\\n        return None\\n    return clock.now() - stamp.timestamp()\\n\\n\\ndef invocations_without_record(item_records_dir: Path) -> list[tuple[Path, dict[str, Any]]]:\\n    \\\"\\\"\\\"Every <stage>-NN.started under one item whose <stage>-NN.json has\\n    not arrived, with the marker's own dict ({} when unreadable).\\\"\\\"\\\"\\n    out: list[tuple[Path, dict[str, Any]]] = []\\n    if not item_records_dir.is_dir():\\n        return out\\n    for marker in sorted(item_records_dir.glob(f\\\"*{INVOCATION_MARKER_SUFFIX}\\\")):\\n        if (item_records_dir / f\\\"{marker.stem}.json\\\").is_file():\\n            continue\\n        try:\\n            with marker.open() as fh:\\n                info = json.load(fh)\\n        except (OSError, ValueError):\\n            info = {}\\n        out.append((marker, info if isinstance(info, dict) else {}))\\n    return out\\n\\n\\ndef stall_bound_s(m: dict[str, Any]) -> int | None:\\n    \\\"\\\"\\\"[drive].stall_after_s: the tenant's own bound past which a live\\n    invocation with no new event is hung. A bound the tenant did not\\n    write is a forecast, so there is no default.\\\"\\\"\\\"\\n    bound = (m.get(\\\"drive\\\") or {}).get(\\\"stall_after_s\\\")\\n    if isinstance(bound, bool) or not isinstance(bound, (int, float)) or bound <= 0:\\n        return None\\n    return int(bound)\\n\\n\\ndef ceiling_s(m: dict[str, Any], stage: str) -> int | None:\\n    \\\"\\\"\\\"R3: [drive.<stage>].ceiling_s, the wall clock past which a live\\n    invocation of that stage is hung by its ceiling, whatever event age\\n    says (or does not say, for an adapter that streams none). No\\n    default: a ceiling the tenant did not declare is not assumed.\\\"\\\"\\\"\\n    value = ((m.get(\\\"drive\\\") or {}).get(stage) or {}).get(\\\"ceiling_s\\\")\\n    if isinstance(value, bool) or not isinstance(value, (int, float)) or value <= 0:\\n        return None\\n    return int(value)\\n\\n\\ndef attempts_budget(m: dict[str, Any]) -> int:\\n    \\\"\\\"\\\"R3: [drive].attempts, the attempts a stage may spend -- across a\\n    plain retry, a returned retry, and a steered one alike -- before the\\n    item is a person's; 3 when the manifest does not say.\\\"\\\"\\\"\\n    value = (m.get(\\\"drive\\\") or {}).get(\\\"attempts\\\")\\n    if isinstance(value, bool) or not isinstance(value, int) or value < 1:\\n        return 3\\n    return value\\n\\n\\ndef retry_after_s(m: dict[str, Any]) -> int:\\n    \\\"\\\"\\\"R3: [drive].retry_after_s, the wait a transient stop's record sits\\n    through before its next attempt starts; 300 when the manifest does\\n    not say.\\\"\\\"\\\"\\n    value = (m.get(\\\"drive\\\") or {}).get(\\\"retry_after_s\\\")\\n    if isinstance(value, bool) or not isinstance(value, (int, float)) or value < 0:\\n        return 300\\n    return int(value)\\n\\n\\ndef proof_no_invocation_lacks_record(root: Path, m: dict[str, Any] | None) -> Proof:\\n    import socket\\n    p = Proof(\\\"no-invocation-lacks-record\\\", \\\"no invocation lacks its record\\\")\\n    if m is None:\\n        return p.fail(f\\\"no {MANIFEST} at {root}; no records directory is declared\\\")\\n    records_rel = m.get(\\\"paths\\\", {}).get(\\\"records\\\", \\\"\\\")\\n    records_dir = root / records_rel\\n    if not records_dir.is_dir():\\n        return p.fail(f\\\"no records directory under {records_dir}\\\")\\n    bound = stall_bound_s(m)\\n    if bound is None:\\n        return p.fail(\\\"no [drive].stall_after_s in the manifest; a hung invocation cannot be \\\"\\n                      \\\"told from a running one\\\")\\n    # R3: a stage with no ceiling can run forever unjudged even when\\n    # stall_after_s is set (an adapter that streams no events trips no\\n    # stall bound at all) -- refused the same way stall_after_s's own\\n    # absence is, not folded into it, so the reason names exactly which\\n    # keys the manifest is missing.\\n    missing_ceilings = [f\\\"[drive.{stage}].ceiling_s\\\" for stage in (\\\"build\\\", \\\"verify\\\")\\n                        if ceiling_s(m, stage) is None]\\n    if missing_ceilings:\\n        return p.fail(f\\\"no {' or '.join(missing_ceilings)} in the manifest; a stage with no \\\"\\n                      f\\\"ceiling can run forever unjudged (R3)\\\")\\n    if (m.get(\\\"drive\\\") or {}).get(\\\"attempts\\\") is None:\\n        return p.fail(\\\"no [drive].attempts in the manifest; a retryable stop would spend an \\\"\\n                      \\\"unbounded number of attempts (R3)\\\")\\n    this_host = socket.gethostname()\\n    recorded = 0\\n    running: list[str] = []\\n    in_flight: list[str] = []\\n    problems: list[str] = []\\n    for item_dir in sorted(d for d in records_dir.iterdir() if d.is_dir()):\\n        for marker in item_dir.glob(f\\\"*{INVOCATION_MARKER_SUFFIX}\\\"):\\n            if (item_dir / f\\\"{marker.stem}.json\\\").is_file():\\n                recorded += 1\\n        for marker, info in invocations_without_record(item_dir):\\n            name = f\\\"item {item_dir.name} {marker.stem}\\\"\\n            stage, nn_text = marker.stem.rsplit(\\\"-\\\", 1)\\n            try:\\n                beat_file = holder_heartbeat_path(root, info, stage, int(nn_text))\\n                beat_age = heartbeat_age_s(beat_file) if beat_file is not None else None\\n            except (RuntimeError, ValueError):\\n                beat_file, beat_age = None, None\\n            if beat_age is not None:\\n                # The holder's own fact: fresh within three beats is\\n                # running, older is a holder that stopped touching it.\\n                if beat_age <= heartbeat_s() * 3:\\n                    running.append(f\\\"{name} (heartbeat {int(beat_age)} s old, since {info.get('at')})\\\")\\n                    continue\\n            elif info.get(\\\"host\\\") != this_host or info.get(\\\"events\\\"):\\n                # No heartbeat readable for a marker from another host, or\\n                # none yet where a marker from this host says its holder\\n                # beats (another checkout's worker not yet at its first\\n                # beat): not yet a failure. An invocation younger than the\\n                # tenant's own stall bound may simply be running, still\\n                # writing toward its own record.\\n                age = invocation_age_s(info)\\n                if age is not None and age < bound:\\n                    in_flight.append(f\\\"{name} (host {info.get('host')} since {info.get('at')})\\\")\\n                    continue\\n            problems.append(f\\\"{name} started {info.get('at')} on {info.get('host')} \\\"\\n                            f\\\"and never wrote its record\\\")\\n    if problems:\\n        return p.fail(\\\"; \\\".join(problems), unrecorded_invocations=len(problems),\\n                      running_invocations=running, in_flight=in_flight)\\n    return p.hold(f\\\"{recorded} invocation(s) recorded, {len(running)} running, \\\"\\n                  f\\\"{len(in_flight)} in flight elsewhere\\\",\\n                  unrecorded_invocations=0, running_invocations=running, in_flight=in_flight)\\n\\n\\ndef proof_one_item_every_stage(root: Path, m: dict[str, Any] | None) -> Proof:\\n    p = Proof(\\\"one-item-every-stage\\\", \\\"one item has traversed every stage\\\")\\n    if m is None:\\n        return p.fail(f\\\"no {MANIFEST} at {root}; no records directory is declared\\\")\\n    records_rel = m.get(\\\"paths\\\", {}).get(\\\"records\\\", \\\"\\\")\\n    records_dir = root / records_rel\\n    items = load_records(records_dir)\\n    if not items:\\n        return p.fail(f\\\"no work item under {records_dir.relative_to(root)}\\\")\\n    complete = [item for item, stages in items.items() if all(s in stages for s in STAGES)]\\n    if not complete:\\n        best = max(items.items(), key=lambda kv: len(kv[1]))\\n        lacking = [s for s in STAGES if s not in best[1]]\\n        return p.fail(f\\\"no item carries every stage; item {best[0]} lacks {', '.join(lacking)}\\\")\\n\\n    # issue #74: a complete item is counted only when its chain holds --\\n    # attavo attest refuses a build re-approved after the fact or a\\n    # verify whose build went stale, and the coherence gate refuses the\\n    # merge group on exactly that; a proof that never asked would call a\\n    # traversal the gate itself would not let through. The refusal text\\n    # is check_attest_chain's own, never re-typed here.\\n    refused, held, unmerged = [], [], []\\n    for item in complete:\\n        chain, message = check_attest_chain(records_dir / item, item)\\n        if chain is None:\\n            refused.append(f\\\"item {item}: {message}\\\")\\n            continue\\n        merge_sha, merge_refusal = merge_introducing_records(root, records_rel, item, STAGES)\\n        if merge_refusal:\\n            return p.fail(merge_refusal)\\n        if merge_sha:\\n            held.append((item, merge_sha))\\n        else:\\n            unmerged.append(item)\\n\\n    if held:\\n        names = \\\", \\\".join(item for item, _ in held)\\n        shas = \\\", \\\".join(sha[:12] for _, sha in held)\\n        return p.hold(f\\\"item(s) {names} carry {', '.join(STAGES)} with the chain held, \\\"\\n                      f\\\"merged at {shas}\\\")\\n    if refused:\\n        return p.fail(\\\"; \\\".join(refused))\\n    return p.fail(f\\\"item(s) {', '.join(unmerged)} carry every stage with the chain held but no \\\"\\n                  f\\\"merge commit's first-parent diff introduces all of them\\\")\\n\\n\\ndef commit_subject(root: Path, sha: str) -> str:\\n    return git(root, \\\"log\\\", \\\"-1\\\", \\\"--format=%s\\\", sha).strip()\\n\\n\\ndef touches_boundary(root: Path, sha: str, boundary_paths: list[str]) -> bool:\\n    \\\"\\\"\\\"Whether sha's first-parent diff touches a path [spec.boundary].paths\\n    declares governed -- an ordinary merge that does is a boundary\\n    evasion (issue #72): the tenant carried a governed change around the\\n    path the manifest itself names.\\\"\\\"\\\"\\n    diff = git(root, \\\"diff\\\", \\\"--name-only\\\", f\\\"{sha}^1\\\", sha).splitlines()\\n    return any(fnmatch.fnmatch(path, pattern) for path in diff for pattern in boundary_paths)\\n\\n\\nclass WindowRefused(Exception):\\n    \\\"\\\"\\\"The window start cannot be computed; str(exc) is the refusal.\\\"\\\"\\\"\\n\\n\\ndef proof_window_start(root: Path, m: dict[str, Any]) -> tuple[str, str, list[str]]:\\n    \\\"\\\"\\\"(install commit, window start, first-parent chain after the install\\n    commit): where proofs three and six start reading. The start is\\n    [doctor].from if the tenant set it, otherwise the commit that\\n    introduced the manifest (issue #192: proof six reads this too, so the\\n    two proofs cannot disagree).\\\"\\\"\\\"\\n    try:\\n        install = git(root, \\\"log\\\", \\\"--diff-filter=A\\\", \\\"--format=%H\\\",\\n                      \\\"--reverse\\\", \\\"--\\\", MANIFEST).split()\\n    except RuntimeError as exc:\\n        raise WindowRefused(f\\\"git: {exc}\\\") from exc\\n    if not install:\\n        raise WindowRefused(f\\\"{MANIFEST} is not committed; the tenant has no record boundary\\\")\\n    install_sha = install[0]\\n    full_chain = git(root, \\\"rev-list\\\", f\\\"{install_sha}..HEAD\\\", \\\"--first-parent\\\").split()\\n\\n    # issue #74: [doctor] from lets a tenant declare the doctor's read to\\n    # start at a later commit on main's first-parent line -- the point\\n    # after which every push arrived through the queue -- rather than the\\n    # install commit, which on a repository that adopted the product\\n    # after its history began is a boundary the doctor cannot otherwise\\n    # see. Any spelling git resolves is accepted (a short sha, a tag, a\\n    # ref) -- resolved with rev-parse --verify before the first-parent\\n    # check runs, so the two failure modes stay distinct: a spelling that\\n    # names no commit at all, and a commit that names one off the line.\\n    # Checked, not trusted: neither is silently forgiven back to install.\\n    declared_from = (m.get(\\\"doctor\\\") or {}).get(\\\"from\\\")\\n    window_start = install_sha\\n    if declared_from is not None:\\n        try:\\n            resolved_from = git(root, \\\"rev-parse\\\", \\\"--verify\\\", f\\\"{declared_from}^{{commit}}\\\").strip()\\n        except RuntimeError:\\n            raise WindowRefused(f\\\"[doctor] from {declared_from} does not resolve to a commit\\\") from None\\n        if resolved_from != install_sha and resolved_from not in full_chain:\\n            raise WindowRefused(f\\\"[doctor] from {declared_from} is not on main's first-parent \\\"\\n                                f\\\"line after the install commit {install_sha[:12]}\\\")\\n        window_start = resolved_from\\n    return install_sha, window_start, full_chain\\n\\n\\ndef proof_no_commit_lacks_record(root: Path, m: dict[str, Any] | None) -> Proof:\\n    p = Proof(\\\"no-commit-lacks-record\\\", \\\"no commit lacks a record\\\")\\n    if m is None:\\n        return p.fail(f\\\"no {MANIFEST} at {root}; the tenant has no record boundary\\\")\\n    try:\\n        install_sha, window_start, full_chain = proof_window_start(root, m)\\n    except WindowRefused as exc:\\n        return p.fail(str(exc))\\n    if not full_chain:\\n        return p.fail(f\\\"no commit after the install commit {install_sha[:12]}; nothing has been recorded\\\")\\n\\n    if window_start == install_sha:\\n        window_spec = f\\\"{install_sha}..HEAD\\\"\\n        commits = full_chain\\n    else:\\n        window_spec = f\\\"{window_start}^..HEAD\\\"\\n        commits = git(root, \\\"rev-list\\\", window_spec, \\\"--first-parent\\\").split()\\n    before_window = len(full_chain) - len(commits)\\n\\n    records_rel = m.get(\\\"paths\\\", {}).get(\\\"records\\\", \\\"\\\")\\n    records_dir = root / records_rel\\n    named: set[str] = set()\\n    for stages in load_records(records_dir).values():\\n        for rec in stages.values():\\n            sha = rec.get(\\\"sha\\\")\\n            if isinstance(sha, str):\\n                named.add(sha)\\n            for c in rec.get(\\\"commits\\\", []) or []:\\n                if isinstance(c, str):\\n                    named.add(c)\\n    record_commits = set(git(root, \\\"rev-list\\\", window_spec, \\\"--first-parent\\\",\\n                             \\\"--\\\", records_rel).split()) if records_rel else set()\\n    merges = set(git(root, \\\"rev-list\\\", window_spec, \\\"--first-parent\\\", \\\"--merges\\\").split())\\n    boundary_paths = ((m.get(\\\"spec\\\") or {}).get(\\\"boundary\\\") or {}).get(\\\"paths\\\") or []\\n\\n    # Every first-parent commit in the window is exactly one of three\\n    # (issue #72): recorded (a record names it, or its diff touches\\n    # paths.records), ordinary (a merge that doesn't), or unrecorded\\n    # (anything else -- on a protected main with a queue, a non-merge\\n    # commit is the only way a change arrives without the forge).\\n    recorded, ordinary, unrecorded = [], [], []\\n    ordinary_commits, unrecorded_commits = [], []\\n    boundary_evasions = 0\\n    for c in commits:\\n        if c in named or c in record_commits:\\n            recorded.append(c)\\n        elif c in merges:\\n            ordinary.append(c)\\n            evasion = bool(boundary_paths and touches_boundary(root, c, boundary_paths))\\n            if evasion:\\n                boundary_evasions += 1\\n            ordinary_commits.append({\\\"sha\\\": c, \\\"subject\\\": commit_subject(root, c),\\n                                     \\\"boundary_evasion\\\": evasion})\\n        else:\\n            unrecorded.append(c)\\n            unrecorded_commits.append({\\\"sha\\\": c, \\\"subject\\\": commit_subject(root, c)})\\n\\n    not_transport = driver_commits_not_transport(root, window_spec, records_rel) if records_rel else []\\n    counts = f\\\"{len(recorded)} recorded, {len(ordinary)} ordinary, {len(unrecorded)} unrecorded\\\"\\n    evasions = boundary_evasions if boundary_paths else \\\"n/a\\\"\\n    extra = {\\\"recorded\\\": len(recorded), \\\"ordinary\\\": len(ordinary),\\n             \\\"unrecorded\\\": len(unrecorded), \\\"boundary_evasions\\\": evasions,\\n             \\\"before_window\\\": before_window,\\n             \\\"ordinary_commits\\\": ordinary_commits, \\\"unrecorded_commits\\\": unrecorded_commits,\\n             \\\"driver_commits_not_transport\\\": not_transport}\\n    if not_transport:\\n        return p.fail(f\\\"a driver commit is not a records transport: {not_transport[0]}; {counts}\\\", **extra)\\n    if unrecorded:\\n        return p.fail(f\\\"{unrecorded[-1][:12]} lacks a record; {counts}; boundary evasions: \\\"\\n                      f\\\"{evasions}; before the window: {before_window}\\\", **extra)\\n    return p.hold(f\\\"{counts}; boundary evasions: {evasions}; before the window: {before_window}\\\",\\n                  **extra)\\n\\n\\ndef driver_commits_not_transport(root: Path, window_spec: str, records_rel: str) -> list[str]:\\n    \\\"\\\"\\\"Every commit in the window authored as driver_identity() that is not\\n    a records transport: more than one parent, or a path outside\\n    <records>/<N>/ for the one item N it touches. The driver's commits\\n    carry records and nothing else, one parent each (root cause 1: the\\n    driver makes them in a detached worktree and never merges), so one\\n    that does either was made by something other than the transport.\\n    Each entry reads `<sha12> <why>`.\\\"\\\"\\\"\\n    email = driver_identity()[\\\"email\\\"]\\n    bad: list[str] = []\\n    prefix = records_rel.strip(\\\"/\\\") + \\\"/\\\"\\n    out = git(root, \\\"log\\\", window_spec, \\\"--format=%H\\\\x1f%ae\\\\x1f%P\\\")\\n    for line in out.splitlines():\\n        sha, author, parents = line.split(\\\"\\\\x1f\\\")\\n        if author != email:\\n            continue\\n        if len(parents.split()) > 1:\\n            bad.append(f\\\"{sha[:12]} is a merge\\\")\\n            continue\\n        paths = git(root, \\\"diff-tree\\\", \\\"--no-commit-id\\\", \\\"--name-only\\\", \\\"-r\\\", \\\"--root\\\", sha).splitlines()\\n        items = {p[len(prefix):].split(\\\"/\\\", 1)[0] for p in paths if p.startswith(prefix) and \\\"/\\\" in p[len(prefix):]}\\n        outside = [p for p in paths if not (p.startswith(prefix) and \\\"/\\\" in p[len(prefix):])]\\n        if outside:\\n            bad.append(f\\\"{sha[:12]} touches {outside[0]}, outside its item's records\\\")\\n        elif len(items) > 1:\\n            bad.append(f\\\"{sha[:12]} touches the records of items {', '.join(sorted(items))}\\\")\\n    return bad\\n\\n\\nADAPTER_EXIT_RE = re.compile(r\\\"^\\\\[adapter exited \\\\d+\\\\]$\\\")\\n\\n_JSON_LINE_PARSE_FAILED = object()\\n\\n\\ndef _parse_json_line(text: str) -> Any:\\n    \\\"\\\"\\\"A line's own parsed JSON value, or the sentinel\\n    _JSON_LINE_PARSE_FAILED when it does not parse -- the one call site\\n    in this file for a defensive, line-at-a-time JSON parse, shared by\\n    proof four's own tool-error check below (any valid JSON satisfies\\n    it) and an events line's own `at` read (issue #151, which further\\n    requires a dict). A dedicated sentinel, not None: a line that is\\n    the literal JSON value null parses successfully and must read as\\n    such, not as a failure.\\\"\\\"\\\"\\n    try:\\n        return json.loads(text)\\n    except ValueError:\\n        return _JSON_LINE_PARSE_FAILED\\n\\n\\ndef _log_owes_tool_error(log: str | None) -> bool:\\n    \\\"\\\"\\\"True when a log's last non-empty line is exactly an adapter-exit\\n    marker and every line before it parses as JSON -- an adapter's own\\n    event stream, never a tool's own words (issue #94's own specimen,\\n    tenant zero's attest/records/659/verify-01.log: codex's\\n    \\\"thread.started\\\" event, then nothing but \\\"[adapter exited 1]\\\" -- the\\n    tool's real error line dropped before this reached the log, issue\\n    #86's own bug in split_adapter_stdout). A log that is only the exit\\n    marker, nothing before it at all, still owes the same line. An\\n    `error` event with a non-empty string `message` is the tool's own\\n    error delivered as an event (issue #200: \\\"Selected model is at\\n    capacity\\\"), so it owes nothing. So is an API error the tool reports as\\n    its own assistant message -- Claude Code's `\\\"is_api_error_message\\\":\\n    true` event, whose text is the tool's words (\\\"Failed to authenticate:\\n    OAuth session expired and could not be refreshed\\\", item 267 build-01\\n    and build-02, 2026-09-30) -- when that text is non-empty.\\\"\\\"\\\"\\n    if not log:\\n        return False\\n    lines = [l for l in log.splitlines() if l.strip()]\\n    if not lines or not ADAPTER_EXIT_RE.match(lines[-1]):\\n        return False\\n    for l in lines[:-1]:\\n        parsed = _parse_json_line(l)\\n        if parsed is _JSON_LINE_PARSE_FAILED:\\n            return False\\n        if isinstance(parsed, dict) and parsed.get(\\\"type\\\") == \\\"error\\\":\\n            message = parsed.get(\\\"message\\\")\\n            if isinstance(message, str) and message:\\n                return False\\n        if isinstance(parsed, dict) and parsed.get(\\\"is_api_error_message\\\") is True:\\n            if _api_error_text(parsed):\\n                return False\\n    return True\\n\\n\\ndef _api_error_text(event: dict[str, Any]) -> str:\\n    \\\"\\\"\\\"The text of an API error an adapter's tool delivered as its own\\n    assistant message: the non-empty text blocks of message.content,\\n    joined. Empty when there is none, which owes the line still.\\\"\\\"\\\"\\n    message = event.get(\\\"message\\\")\\n    content = message.get(\\\"content\\\") if isinstance(message, dict) else None\\n    if not isinstance(content, list):\\n        return \\\"\\\"\\n    texts = [b.get(\\\"text\\\") for b in content\\n             if isinstance(b, dict) and b.get(\\\"type\\\") == \\\"text\\\" and isinstance(b.get(\\\"text\\\"), str)]\\n    return \\\" \\\".join(t.strip() for t in texts if t and t.strip())\\n\\n\\ndef proof_no_stop_lacks_cause(root: Path, m: dict[str, Any] | None) -> Proof:\\n    p = Proof(\\\"no-stop-lacks-cause\\\", \\\"no stop lacks its cause\\\")\\n    if m is None:\\n        return p.fail(f\\\"no {MANIFEST} at {root}; no records directory is declared\\\")\\n    records_rel = m.get(\\\"paths\\\", {}).get(\\\"records\\\", \\\"\\\")\\n    records_dir = root / records_rel\\n    if not records_dir.is_dir():\\n        return p.fail(f\\\"no records directory under {records_dir}\\\")\\n\\n    # issue #89's own window lesson, proof three's already: a record\\n    # before record_version 3 has no stop by construction (schema\\n    # versions 1 and 2 predate it) -- counted here, never refused.\\n    older = 0\\n    checked = 0\\n    before_rederivable = 0\\n    problems: list[str] = []\\n    for item_dir in sorted(d for d in records_dir.iterdir() if d.is_dir()):\\n        for stage in STOP_STAGES:\\n            for n, rec in sorted(parse_attempts(item_dir, stage).items()):\\n                if rec.get(\\\"record_version\\\", 1) < 3:\\n                    older += 1\\n                    continue\\n                if rec.get(\\\"status\\\") == \\\"pass\\\":\\n                    continue\\n                checked += 1\\n                name = f\\\"{stage}-{n:02d}\\\"\\n                rederivable = rec.get(\\\"record_version\\\", 1) >= STOP_REDERIVABLE_FROM[stage]\\n                if not rederivable:\\n                    before_rederivable += 1\\n                stop = rec.get(\\\"stop\\\")\\n                if not stop:\\n                    problems.append(f\\\"item {item_dir.name} {name} carries no stop\\\")\\n                    continue\\n                cls, provenance = stop.get(\\\"class\\\"), stop.get(\\\"provenance\\\")\\n                if cls not in STOP_CLASSES:\\n                    problems.append(f\\\"item {item_dir.name} {name} stop.class {cls!r} names \\\"\\n                                    f\\\"no enumerated class\\\")\\n                    continue\\n                if provenance not in STOP_PROVENANCES:\\n                    problems.append(f\\\"item {item_dir.name} {name} stop.provenance \\\"\\n                                    f\\\"{provenance!r} names no enumerated provenance\\\")\\n                    continue\\n                # Issue #254: at the version that stores what the stop was\\n                # derived from, the stop is that function's value -- the\\n                # pass's own recovery records by their own rule.\\n                if rederivable and is_recovery_stop(rec):\\n                    fault = recovery_fault(rec)\\n                    if fault:\\n                        problems.append(f\\\"item {item_dir.name} {name} {fault}\\\")\\n                        continue\\n                elif rederivable:\\n                    derived = rederive_stop(stage, rec)\\n                    if derived is None or (derived[\\\"class\\\"], derived[\\\"provenance\\\"]) != (cls, provenance):\\n                        problems.append(\\n                            f\\\"item {item_dir.name} {name} stop is {cls}/{provenance} but its \\\"\\n                            f\\\"own fields derive \\\"\\n                            f\\\"{'no stop' if derived is None else derived['class'] + '/' + derived['provenance']}\\\")\\n                        continue\\n                if cls == \\\"unclassed\\\" and not stop.get(\\\"detail\\\"):\\n                    problems.append(f\\\"item {item_dir.name} {name} is unclassed with no detail\\\")\\n                    continue\\n                log_path = item_dir / f\\\"{name}.log\\\"\\n                log = log_path.read_text() if log_path.is_file() else None\\n                # Issue #89, rejection test 1's own specimen (tenant\\n                # zero's #659 build-01): a failed build that actually ran\\n                # the gates -- selected_tests is set only once cmd_build\\n                # reaches them -- owes their heading in the log, whatever\\n                # else stop already says.\\n                if (stage == \\\"build\\\" and rec.get(\\\"status\\\") == \\\"failed\\\"\\n                        and rec.get(\\\"selected_tests\\\") is not None\\n                        and \\\"--- attavo gates, iteration\\\" not in (log or \\\"\\\")):\\n                    problems.append(f\\\"item {item_dir.name} {name} failed after the gates ran \\\"\\n                                    f\\\"but its log carries no gates heading\\\")\\n                    continue\\n                if _log_owes_tool_error(log):\\n                    problems.append(f\\\"item {item_dir.name} {name}'s log ends in an adapter \\\"\\n                                    f\\\"exit with nothing before it but event lines; the tool's \\\"\\n                                    f\\\"own error line is owed\\\")\\n\\n        # issue #137: a refused spec-gate record is a stop too, class\\n        # \\\"gate\\\" -- synthesized the same way item_stops and\\n        # cmd_file_stops already read it, since cmd_spec_gate itself\\n        # carries no stop field to check for one. No record_version\\n        # gate here: unlike build/verify's own stop field, gate is never\\n        # persisted, so there is no older shape that predates it.\\n        for n, rec in sorted(parse_attempts(item_dir, \\\"spec\\\").items()):\\n            if rec.get(\\\"status\\\") != \\\"refused\\\":\\n                continue\\n            checked += 1\\n            name = f\\\"spec-{n:02d}\\\"\\n            stop = gate_stop(rec.get(\\\"refusal\\\"))\\n            cls, provenance = stop[\\\"class\\\"], stop[\\\"provenance\\\"]\\n            if cls not in STOP_CLASSES:\\n                problems.append(f\\\"item {item_dir.name} {name} stop.class {cls!r} names \\\"\\n                                f\\\"no enumerated class\\\")\\n                continue\\n            if provenance not in STOP_PROVENANCES:\\n                problems.append(f\\\"item {item_dir.name} {name} stop.provenance \\\"\\n                                f\\\"{provenance!r} names no enumerated provenance\\\")\\n                continue\\n            if not stop.get(\\\"detail\\\"):\\n                problems.append(f\\\"item {item_dir.name} {name} is a gate stop with no cause\\\")\\n\\n    older_note = (f\\\"{older} record(s) before stop was recorded; {before_rederivable} non-pass \\\"\\n                 f\\\"record(s) before their stop could be re-derived\\\")\\n    if problems:\\n        return p.fail(\\\"; \\\".join(problems), older_records=older,\\n                     before_rederivable=before_rederivable)\\n    return p.hold(f\\\"{checked} checked ({older_note})\\\" if checked == 0\\n                 else f\\\"{checked} non-pass record(s) carry stop with a cause ({older_note})\\\",\\n                 older_records=older, before_rederivable=before_rederivable)\\n\\n\\ndef attestation_command(m: dict[str, Any]) -> str | None:\\n    \\\"\\\"\\\"[forge].attestation_command: the tenant's own read of the store,\\n    given a merge sha on stdin, printing the statement as JSON on exit 0\\n    and nothing on a non-zero exit. Absent is not passing (issue #158:\\n    the doctor said done while #106, #148, #153 had no statement in the\\n    store at all -- there was no key to read one through).\\\"\\\"\\\"\\n    cmd = (m.get(\\\"forge\\\") or {}).get(\\\"attestation_command\\\")\\n    return cmd if isinstance(cmd, str) and cmd.strip() else None\\n\\n\\ndef statement_for(root: Path, cmd: str, merge_sha: str) -> tuple[dict[str, Any] | None, int]:\\n    \\\"\\\"\\\"The statement the forge holds for merge_sha and the command's exit\\n    code. The statement is None when the command exits non-zero or prints\\n    anything but a JSON object -- exit 2 means the store itself could not\\n    be read (issue #158, amended after build-05: distinct from exit 1,\\n    the store read fine and simply held no statement).\\\"\\\"\\\"\\n    run = subprocess.run(cmd, shell=True, cwd=str(root), input=merge_sha + \\\"\\\\n\\\",\\n                         capture_output=True, text=True, check=False)\\n    if run.returncode != 0:\\n        return None, run.returncode\\n    try:\\n        parsed = json.loads(run.stdout)\\n    except ValueError:\\n        return None, run.returncode\\n    return (parsed if isinstance(parsed, dict) else None), run.returncode\\n\\n\\ndef _is_ancestor(root: Path, earlier: str, later: str) -> bool:\\n    run = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"merge-base\\\", \\\"--is-ancestor\\\", earlier, later],\\n                         capture_output=True, check=False)\\n    return run.returncode == 0\\n\\n\\n# Maps whose keys are the records' data (a stage or an adapter that cost\\n# something), not a release's fields: a key missing from one is a difference.\\nDATA_KEYED = (\\\"by_stage_usd\\\", \\\"by_adapter_usd\\\")\\n\\n\\ndef _same(stated: Any, summed: Any) -> bool:\\n    \\\"\\\"\\\"Equal as the accounting means it: a number equals a number of the\\n    same value (a store may print 40.0 as 40), a bool equals only a bool,\\n    and a list is equal member by member. No tolerance and no conversion:\\n    both sides are the same function's rounding of the same records, and an\\n    int one past 2**53 is not the float beside it.\\\"\\\"\\\"\\n    if isinstance(stated, bool) or isinstance(summed, bool):\\n        return isinstance(stated, bool) and isinstance(summed, bool) and stated == summed\\n    if isinstance(stated, (int, float)) and isinstance(summed, (int, float)):\\n        return bool(stated == summed)\\n    if isinstance(stated, list) and isinstance(summed, list):\\n        return len(stated) == len(summed) and all(_same(a, b) for a, b in zip(stated, summed))\\n    return type(stated) is type(summed) and bool(stated == summed)\\n\\n\\ndef _differences(path: str, stated: Any, summed: Any, keyed_by_data: bool = False) -> list[str]:\\n    \\\"\\\"\\\"Every field of `stated` that is not what its records sum to, named by\\n    its path. Only the keys the statement carries are compared, at every\\n    depth, so a field a later release adds is not demanded of a statement\\n    sealed before it; a key it carries that the function does not produce\\n    is a difference.\\\"\\\"\\\"\\n    if not (isinstance(stated, dict) and isinstance(summed, dict)):\\n        return [] if _same(stated, summed) else [f\\\"{path} {stated!r} is not its records' {summed!r}\\\"]\\n    found: list[str] = []\\n    for key in sorted(stated):\\n        if key not in summed:\\n            found.append(f\\\"{path}.{key} {stated[key]!r} is not a field its records sum to\\\")\\n        else:\\n            found += _differences(f\\\"{path}.{key}\\\", stated[key], summed[key], key in DATA_KEYED)\\n    if keyed_by_data:\\n        found += [f\\\"{path}.{key} is absent; its records sum to {summed[key]!r}\\\"\\n                  for key in sorted(summed.keys() - stated.keys())]\\n    return found\\n\\n\\ndef _carried(predicate: dict[str, Any], key: str) -> str:\\n    return repr(predicate[key]) if key in predicate else \\\"absent\\\"\\n\\n\\ndef _accounting_disagrees(root: Path, item_records_dir: Path, item: str, merge_sha: str,\\n                          statement: dict[str, Any]) -> str | None:\\n    \\\"\\\"\\\"A sealed statement that carries `time` and `cost` says what its\\n    records sum to, field by field -- the same function attest summed them\\n    with, over the same records (none is written after a merge), sealed at\\n    the same commit (the statement is computed at the merge, so lead_s and\\n    waiting_s are recomputed from its committer time, not excepted). Exact:\\n    #202 retired the one-second tolerance. A statement sealed before `time`\\n    existed carries neither key and is not checked; a key that is present\\n    holds a block, so a null one, or one block without the other, is a\\n    disagreement. No new read of the store.\\\"\\\"\\\"\\n    inner = statement.get(\\\"predicate\\\")\\n    predicate = inner if isinstance(inner, dict) else statement\\n    if \\\"time\\\" not in predicate and \\\"cost\\\" not in predicate:\\n        return None\\n    stated_time, stated_cost = predicate.get(\\\"time\\\"), predicate.get(\\\"cost\\\")\\n    where = f\\\"item {item} merged at {merge_sha[:12]}\\\"\\n    if not isinstance(stated_time, dict) or not isinstance(stated_cost, dict):\\n        return (f\\\"{where}: the statement's time and cost are not both blocks \\\"\\n                f\\\"(time is {_carried(predicate, 'time')}, cost is {_carried(predicate, 'cost')})\\\")\\n    try:\\n        sealed_at: int | None = int(git(root, \\\"show\\\", \\\"-s\\\", \\\"--format=%ct\\\", merge_sha).strip())\\n    except (RuntimeError, ValueError):\\n        sealed_at = None\\n    summed_time, summed_cost = item_time_and_cost(item_records_dir, sealed_at)\\n    differing = (_differences(\\\"time\\\", stated_time, dict(summed_time))\\n                 + _differences(\\\"cost\\\", stated_cost, dict(summed_cost)))\\n    if differing:\\n        return f\\\"{where}: the statement's \\\" + \\\"; \\\".join(differing)\\n    return None\\n\\n\\ndef proof_every_attested_item_is_sealed(root: Path, m: dict[str, Any] | None) -> Proof:\\n    p = Proof(\\\"every-attested-item-is-sealed\\\", \\\"every attested item has its statement in the store\\\")\\n    if m is None:\\n        return p.fail(f\\\"no {MANIFEST} at {root}; no records directory is declared\\\")\\n    cmd = attestation_command(m)\\n    if cmd is None:\\n        return p.fail(\\\"no [forge].attestation_command in the manifest; the store cannot be read\\\")\\n    records_rel = m.get(\\\"paths\\\", {}).get(\\\"records\\\", \\\"\\\")\\n    records_dir = root / records_rel\\n    if not records_dir.is_dir():\\n        return p.fail(f\\\"no records directory under {records_dir}\\\")\\n    items = load_records(records_dir)\\n    complete = [item for item, stages in sorted(items.items()) if all(s in stages for s in STAGES)]\\n\\n    # [forge].sealed_since: merges at or before this commit are before the\\n    # window -- the tenant could not seal them (no queue, no signing\\n    # workflow, or a store that held nothing yet). They are named, never\\n    # failed. Absent, the window starts where proof three's does: the\\n    # install commit, or [doctor].from (issue #192).\\n    since = (m.get(\\\"forge\\\") or {}).get(\\\"sealed_since\\\")\\n    if not (isinstance(since, str) and since.strip()):\\n        try:\\n            since = proof_window_start(root, m)[1]\\n        except WindowRefused as exc:\\n            return p.fail(str(exc))\\n    merges, refusal = _merges_reachable(root)\\n    if refusal:\\n        return p.fail(refusal)\\n    sealed: list[str] = []\\n    before_window: list[str] = []\\n    unsealed: list[str] = []\\n    not_merged: list[str] = []\\n    not_read: list[str] = []\\n    reasons: list[str] = []\\n    for item in complete:\\n        merge_sha, _ = merge_introducing_records(root, records_rel, item, STAGES, merges=merges)\\n        if merge_sha is None:\\n            not_merged.append(item)\\n            continue\\n        if _is_ancestor(root, merge_sha, since):\\n            before_window.append(item)\\n            continue\\n        statement, exit_code = statement_for(root, cmd, merge_sha)\\n        if statement is not None:\\n            sealed.append(item)\\n            disagreement = _accounting_disagrees(root, records_dir / item, item, merge_sha,\\n                                                 statement)\\n            if disagreement:\\n                reasons.append(disagreement)\\n        elif exit_code == 2:\\n            not_read.append(item)\\n            reasons.append(f\\\"item {item} merged at {merge_sha[:12]}: not read -- \\\"\\n                           f\\\"the store could not be read; {cmd!r} exited 2\\\")\\n        else:\\n            unsealed.append(item)\\n            reasons.append(f\\\"item {item} merged at {merge_sha[:12]} has no statement in the store\\\")\\n    if reasons:\\n        return p.fail(\\\"; \\\".join(reasons), sealed=sealed, before_window=before_window,\\n                      unsealed=unsealed, not_merged=not_merged, not_read=not_read)\\n    window = f\\\" at {since[:12]}\\\" if before_window else \\\"\\\"\\n    return p.hold(f\\\"{len(sealed)} sealed, {len(before_window)} before the window{window}, \\\"\\n                 f\\\"{len(not_merged)} not merged\\\",\\n                 sealed=sealed, before_window=before_window, unsealed=unsealed,\\n                 not_merged=not_merged, not_read=not_read)\\n\\n\\ndef proof_no_attested_item_is_empty(root: Path, m: dict[str, Any] | None) -> Proof:\\n    \\\"\\\"\\\"Proof seven (item 227). Every merged, fully-staged item's passing\\n    build names a change: its tree, restricted to the item's own spec\\n    claims, differs from the approved tree there (item 229 -- asked\\n    against the approval, not the build's own start_sha, so a build\\n    that adopted a prior attempt's valid commits is not empty just\\n    because that attempt owed no commit of its own; scoped to claims,\\n    not \\\"everything outside paths.records\\\", so a commit that lands\\n    between approval and a later attempt's start but touches no\\n    claimed path never rescues or defeats the comparison on its own\\n    account). Item 227 was specified, approved, built by one\\n    invocation, judged by another, merged and sealed, and its build\\n    committed nothing -- the executor left the stub in the working tree,\\n    the gate read the tree, and main received the spec and none of the\\n    change. Six proofs held over it.\\n\\n    [doctor].built_since: merges at or before this commit are before the\\n    window -- named, never failed -- so the specimen stands on every\\n    doctor run without failing the tenant forever. Absent, the window is\\n    proof three's. A build record whose approval cannot be resolved\\n    (no approval_sha at all, or one this repository cannot read) is\\n    named as not readable, not failed.\\\"\\\"\\\"\\n    p = Proof(\\\"no-attested-item-is-empty\\\", \\\"every attested item's build names a change\\\")\\n    if m is None:\\n        return p.fail(f\\\"no {MANIFEST} at {root}; no records directory is declared\\\")\\n    records_rel = m.get(\\\"paths\\\", {}).get(\\\"records\\\", \\\"\\\")\\n    specs_rel = m.get(\\\"paths\\\", {}).get(\\\"specs\\\", \\\"\\\")\\n    records_dir = root / records_rel\\n    if not records_dir.is_dir():\\n        return p.fail(f\\\"no records directory under {records_dir}\\\")\\n    items = load_records(records_dir)\\n    complete = [item for item, stages in sorted(items.items()) if all(s in stages for s in STAGES)]\\n    since = (m.get(\\\"doctor\\\") or {}).get(\\\"built_since\\\")\\n    if not (isinstance(since, str) and since.strip()):\\n        try:\\n            since = proof_window_start(root, m)[1]\\n        except WindowRefused as exc:\\n            return p.fail(str(exc))\\n    else:\\n        try:\\n            since = git(root, \\\"rev-parse\\\", \\\"--verify\\\", f\\\"{since}^{{commit}}\\\").strip()\\n        except RuntimeError:\\n            return p.fail(f\\\"[doctor] built_since {since} does not resolve to a commit\\\")\\n    merges, refusal = _merges_reachable(root)\\n    if refusal:\\n        return p.fail(refusal)\\n    built: list[str] = []\\n    before_window: list[str] = []\\n    not_merged: list[str] = []\\n    not_read: list[str] = []\\n    empty: list[str] = []\\n    for item in complete:\\n        merge_sha, _ = merge_introducing_records(root, records_rel, item, STAGES, merges=merges)\\n        if merge_sha is None:\\n            not_merged.append(item)\\n            continue\\n        if _is_ancestor(root, merge_sha, since):\\n            before_window.append(item)\\n            continue\\n        build = items[item][\\\"build\\\"]\\n        sha, approval_sha = build.get(\\\"sha\\\"), build.get(\\\"approval_sha\\\")\\n        if not sha or not approval_sha:\\n            not_read.append(item)\\n            continue\\n        spec_md = root / specs_rel / item / \\\"spec.md\\\"\\n        claims: list[str] = []\\n        if spec_md.is_file():\\n            parsed, _ = parse_spec(spec_md)\\n            claims = parsed[\\\"claims\\\"] if parsed else []\\n        is_empty = build_is_empty(root, approval_sha, sha, claims)\\n        if is_empty is None:\\n            not_read.append(item)\\n        elif is_empty:\\n            empty.append(f\\\"item {item} merged at {merge_sha[:12]}: build names no \\\"\\n                         \\\"claimed change; nothing was built\\\")\\n        else:\\n            built.append(item)\\n    if empty:\\n        return p.fail(\\\"; \\\".join(empty), built=built, before_window=before_window,\\n                      not_merged=not_merged, not_read=not_read)\\n    window = f\\\" at {since[:12]}\\\" if before_window else \\\"\\\"\\n    return p.hold(f\\\"{len(built)} built, {len(before_window)} before the window{window}, \\\"\\n                  f\\\"{len(not_read)} without a readable approval, {len(not_merged)} not merged\\\",\\n                  built=built, before_window=before_window, not_merged=not_merged,\\n                  not_read=not_read)\\n\\n\\ndef doctor(root: Path) -> list[Proof]:\\n    m = read_manifest(root)\\n    return [proof_every_gate_rejects(root, m),\\n            proof_one_item_every_stage(root, m),\\n            proof_no_commit_lacks_record(root, m),\\n            proof_no_stop_lacks_cause(root, m),\\n            proof_no_invocation_lacks_record(root, m),\\n            proof_every_attested_item_is_sealed(root, m),\\n            proof_no_attested_item_is_empty(root, m)]\\n\\n\\ndef cmd_doctor(argv: list[str]) -> int:\\n    as_json = \\\"--json\\\" in argv\\n    args = [a for a in argv if a != \\\"--json\\\"]\\n    root = Path(args[0] if args else \\\".\\\").resolve()\\n    proofs = doctor(root)\\n    if as_json:\\n        print(json.dumps({\\\"root\\\": str(root), \\\"done\\\": all(p.holds for p in proofs),\\n                          \\\"proofs\\\": [p.as_dict() for p in proofs]}, indent=2))\\n    else:\\n        for i, p in enumerate(proofs, 1):\\n            print(f\\\"proof {i} {p.key}: {'HOLDS' if p.holds else 'FAILS'}: {p.reason}\\\")\\n        print(\\\"doctor: done\\\" if all(p.holds for p in proofs)\\n              else f\\\"doctor: not done ({sum(not p.holds for p in proofs)} of \\\"\\n                   f\\\"{len(proofs)} proofs fail)\\\")\\n    return 0 if all(p.holds for p in proofs) else 1\\n\",\"numLines\":1070,\"startLine\":1,\"totalLines\":1070}}}\n{\"type\":\"assistant\",\"message\":{\"model\":\"claude-sonnet-5\",\"id\":\"msg_011CfaTjPaFfFwFQd4znhCnb\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_01NPtDuJSwPWG4zgN163TRo2\",\"name\":\"Read\",\"input\":{\"file_path\":\"/Users/davidbean/Projects/attavo-worktree-289/attest/specs/289/stub/attavo/drive.py\"},\"caller\":{\"type\":\"direct\"}}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":476,\"cache_read_input_tokens\":28750,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":476},\"output_tokens\":8,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"b3f717aa-5c2b-4867-b022-0f24cffb6427\",\"uuid\":\"e0eb62f7-bc20-4c50-8484-6e0378b8cba8\",\"timestamp\":\"2026-09-30T23:05:36.155Z\",\"request_id\":\"req_011CfaTjPEB7XuMWpQbXJnCr\",\"wire_tool_inputs\":{\"toolu_01NPtDuJSwPWG4zgN163TRo2\":{\"file_path\":\"/Users/davidbean/Projects/attavo-worktree-289/attest/specs/289/stub/attavo/drive.py\"}}}\n{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01NPtDuJSwPWG4zgN163TRo2\",\"type\":\"tool_result\",\"content\":\"1\\tfrom __future__ import annotations\\n2\\t\\n3\\timport contextlib\\n4\\timport io\\n5\\timport json\\n6\\timport os\\n7\\timport signal\\n8\\timport shutil\\n9\\timport subprocess\\n10\\timport sys\\n11\\timport tempfile\\n12\\timport threading\\n13\\timport time\\n14\\tfrom collections.abc import Callable, Iterator\\n15\\tfrom pathlib import Path\\n16\\tfrom typing import TYPE_CHECKING, Any, NamedTuple, cast\\n17\\t\\n18\\tfrom attavo import clock\\n19\\tfrom attavo.approval import approval_status\\n20\\tfrom attavo.build import cmd_build, driver_identity\\n21\\tfrom attavo.common import MANIFEST, PRODUCT_ROOT, derive_item_id, git, read_manifest\\n22\\tfrom attavo.counsel import cmd_counsel\\n23\\tfrom attavo.doctor import (\\n24\\t    _parse_json_line,\\n25\\t    attempts_budget,\\n26\\t    ceiling_s,\\n27\\t    heartbeat_age_s,\\n28\\t    heartbeat_path,\\n29\\t    heartbeat_pid,\\n30\\t    holder_heartbeat_path,\\n31\\t    heartbeat_s,\\n32\\t    invocation_age_s,\\n33\\t    invocations_without_record,\\n34\\t    retry_after_s,\\n35\\t    stall_bound_s,\\n36\\t    write_invocation_marker,\\n37\\t)\\n38\\tfrom attavo.events import stage_events_dir\\n39\\tfrom attavo.filing import cmd_file_stops\\n40\\tfrom attavo.records import (\\n41\\t    latest_attempt_path,\\n42\\t    latest_record,\\n43\\t    next_attempt_number,\\n44\\t    parse_attempts,\\n45\\t    stage_schema,\\n46\\t    write_record,\\n47\\t)\\n48\\tfrom attavo.stops import RETRYABLE_CLASSES, counsel_record_for, signature_of\\n49\\tfrom attavo.verify import cmd_verify, read_forge_checks\\n50\\tfrom attavo import workcopy\\n51\\t\\n52\\tif TYPE_CHECKING:\\n53\\t    from attavo.types import DriveReport\\n54\\t\\n55\\t# --- drive: the mechanical transitions between approval and ready-to-merge\\n56\\t# (issue #84), under the reconciler's R2 (rulings A, B, C's recovery half,\\n57\\t# F, G, H): `attavo drive N` is one short pass. It reads the report\\n58\\t# (attavo.report), acts at most once -- recovers a dead or hung\\n59\\t# invocation, or starts the next stage in a detached worker -- and\\n60\\t# returns within seconds; the stage itself runs in `attavo worker`, a\\n61\\t# child of the pass's own session, which outlives it. Writes no record of\\n62\\t# its own: the stage records already on disk, and the invocation markers\\n63\\t# and heartbeats beside them, are the only state a pass or a worker\\n64\\t# reads. ---\\n65\\t\\n66\\t\\n67\\tRECORD_PUSH_TRIES = 5\\n68\\t\\n69\\t\\n70\\tclass TransportRefused(RuntimeError):\\n71\\t    \\\"\\\"\\\"A record transport that could not land: the message is the reason,\\n72\\t    already worded for the pass or worker that prints it.\\\"\\\"\\\"\\n73\\t\\n74\\t\\n75\\tdef _driver_env() -> dict[str, str]:\\n76\\t    identity = driver_identity()\\n77\\t    env = dict(os.environ)\\n78\\t    env[\\\"GIT_AUTHOR_NAME\\\"] = identity[\\\"name\\\"]\\n79\\t    env[\\\"GIT_AUTHOR_EMAIL\\\"] = identity[\\\"email\\\"]\\n80\\t    env[\\\"GIT_COMMITTER_NAME\\\"] = identity[\\\"name\\\"]\\n81\\t    env[\\\"GIT_COMMITTER_EMAIL\\\"] = identity[\\\"email\\\"]\\n82\\t    return env\\n83\\t\\n84\\t\\n85\\tdef _retry_base(root: Path, branch: str) -> str:\\n86\\t    \\\"\\\"\\\"The commit a retried record is committed on: origin's branch tip,\\n87\\t    fetched now. It must contain this checkout's HEAD -- the stage's own\\n88\\t    commits are in it, and a record's `sha` names them -- because the\\n89\\t    driver neither merges nor rebases; a tip that does not is a refusal,\\n90\\t    with the commits it would strand named by sha and author.\\\"\\\"\\\"\\n91\\t    git(root, \\\"fetch\\\", \\\"-q\\\", \\\"origin\\\", branch)\\n92\\t    tip = git(root, \\\"rev-parse\\\", \\\"FETCH_HEAD\\\").strip()\\n93\\t    contained = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"merge-base\\\", \\\"--is-ancestor\\\", \\\"HEAD\\\", tip],\\n94\\t                               capture_output=True, text=True, check=False)\\n95\\t    if contained.returncode != 0:\\n96\\t        ours = git(root, \\\"log\\\", \\\"--format=%h %an <%ae>\\\", f\\\"{tip}..HEAD\\\").splitlines()\\n97\\t        raise TransportRefused(\\n98\\t            f\\\"origin's {branch} moved under this checkout's own commits and the driver \\\"\\n99\\t            f\\\"neither merges nor rebases them: {'; '.join(ours)}\\\")\\n100\\t    return tip\\n101\\t\\n102\\t\\n103\\t@contextlib.contextmanager\\n104\\tdef record_worktree(root: Path, tip: str) -> Iterator[Path]:\\n105\\t    \\\"\\\"\\\"A detached worktree of `tip` under the git dir, removed on exit:\\n106\\t    the only place the driver commits. The item's checkout is the\\n107\\t    executor's while a build runs, so nothing the driver writes or\\n108\\t    commits, resets or merges is made there.\\\"\\\"\\\"\\n109\\t    parent = stage_events_dir(root) / \\\"transport\\\"\\n110\\t    parent.mkdir(parents=True, exist_ok=True)\\n111\\t    tree = Path(tempfile.mkdtemp(prefix=\\\"tx-\\\", dir=parent)) / \\\"head\\\"\\n112\\t    git(root, \\\"worktree\\\", \\\"add\\\", \\\"--detach\\\", \\\"-q\\\", str(tree), tip)\\n113\\t    try:\\n114\\t        yield tree\\n115\\t    finally:\\n116\\t        try:\\n117\\t            git(root, \\\"worktree\\\", \\\"remove\\\", \\\"--force\\\", str(tree))\\n118\\t        except RuntimeError:\\n119\\t            shutil.rmtree(tree, ignore_errors=True)\\n120\\t            try:\\n121\\t                git(root, \\\"worktree\\\", \\\"prune\\\")\\n122\\t            except RuntimeError:\\n123\\t                pass\\n124\\t        shutil.rmtree(tree.parent, ignore_errors=True)\\n125\\t\\n126\\t\\n127\\tdef _record_paths(tree: Path, record_paths: list[Path]) -> list[str]:\\n128\\t    \\\"\\\"\\\"Each record's path relative to the tree, and each one's .log and\\n129\\t    .filed, each if one exists (issues #89, #100): the paths `git commit\\n130\\t    --only` names, so a transport commit never sweeps the index (issue\\n131\\t    #46's regression, on the transport side).\\\"\\\"\\\"\\n132\\t    paths: list[str] = []\\n133\\t    for record_path in record_paths:\\n134\\t        paths.append(str(record_path.relative_to(tree)))\\n135\\t        for suffix in (\\\".log\\\", \\\".filed\\\"):\\n136\\t            extra = record_path.with_suffix(suffix)\\n137\\t            if extra.is_file():\\n138\\t                paths.append(str(extra.relative_to(tree)))\\n139\\t    return paths\\n140\\t\\n141\\t\\n142\\tdef commit_record(tree: Path, record_paths: list[Path], message: str) -> str:\\n143\\t    \\\"\\\"\\\"`git commit --only` on the record paths given, in `tree` -- a\\n144\\t    record worktree, never the checkout -- as driver_identity(), set by\\n145\\t    the product and never the tenant's git config, so a driven item's\\n146\\t    record commits are never indistinguishable from an operator's own.\\n147\\t    Returns the commit's sha.\\\"\\\"\\\"\\n148\\t    paths = _record_paths(tree, record_paths)\\n149\\t    git(tree, \\\"add\\\", *paths)\\n150\\t    git(tree, \\\"commit\\\", \\\"--only\\\", \\\"-q\\\", \\\"-m\\\", message, *paths, env=_driver_env())\\n151\\t    return git(tree, \\\"rev-parse\\\", \\\"HEAD\\\").strip()\\n152\\t\\n153\\t\\n154\\tdef sync_checkout(root: Path, target: str) -> None:\\n155\\t    \\\"\\\"\\\"Fast-forward the item's checkout to `target`, the one thing the\\n156\\t    driver does to it. A pass in the same directory may hold the index\\n157\\t    for a moment, so a lock is retried; a checkout already at or beyond\\n158\\t    target is done.\\\"\\\"\\\"\\n159\\t    err = \\\"\\\"\\n160\\t    for _ in range(20):\\n161\\t        run = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"merge\\\", \\\"--ff-only\\\", \\\"-q\\\", target],\\n162\\t                             capture_output=True, text=True, check=False)\\n163\\t        if run.returncode == 0:\\n164\\t            return\\n165\\t        err = run.stderr.strip()\\n166\\t        contained = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"merge-base\\\", \\\"--is-ancestor\\\", target, \\\"HEAD\\\"],\\n167\\t                                   capture_output=True, text=True, check=False)\\n168\\t        if contained.returncode == 0:\\n169\\t            return\\n170\\t        time.sleep(0.1)\\n171\\t    raise TransportRefused(f\\\"the checkout could not fast-forward to {target[:12]}: {err}\\\")\\n172\\t\\n173\\t\\n174\\tdef _stage_copies(root: Path, paths: list[str]) -> None:\\n175\\t    \\\"\\\"\\\"Stage the checkout's own untracked copies of records the driver\\n176\\t    has just committed elsewhere, so the fast-forward that brings the\\n177\\t    committed ones in finds them identical to the target and has nothing\\n178\\t    to collide with -- and the record is never absent from the checkout,\\n179\\t    which is what a pass or a reader beside the worker sees.\\\"\\\"\\\"\\n180\\t    if not paths:\\n181\\t        return\\n182\\t    out = git(root, \\\"ls-files\\\", \\\"--others\\\", \\\"--exclude-standard\\\", \\\"--\\\", *paths).splitlines()\\n183\\t    if out:\\n184\\t        git(root, \\\"add\\\", \\\"--\\\", *out)\\n185\\t\\n186\\t\\n187\\tdef transport_records(root: Path, branch: str, message: str,\\n188\\t                      write: Callable[[Path], list[Path]],\\n189\\t                      lease: bool = False) -> tuple[str, str | None]:\\n190\\t    \\\"\\\"\\\"Commit records in a detached worktree of the branch's tip and push\\n191\\t    them from there as HEAD:branch; then fast-forward the checkout.\\n192\\t    `write(tree)` puts the records in the worktree and returns the record\\n193\\t    paths to commit -- called again on every try, since a retry starts\\n194\\t    from a freshly fetched tip.\\n195\\t\\n196\\t    The first try commits on this checkout's HEAD, which carries the\\n197\\t    stage's own commits. A push origin rejects is retried without a\\n198\\t    merge: fetch, recreate the worktree at the new tip (which must\\n199\\t    contain HEAD, see _retry_base), write again, push again as a\\n200\\t    fast-forward, RECORD_PUSH_TRIES times at most. The record's own `sha` names the\\n201\\t    stage's commit, not this transport commit, so moving the transport\\n202\\t    commit changes nothing a record names.\\n203\\t\\n204\\t    lease=True is the marker's push (ruling A): one try, and a race lost\\n205\\t    is (\\\"lost-race\\\", stderr) with the worktree discarded and the checkout\\n206\\t    untouched. Otherwise (\\\"pushed\\\", None), or (\\\"refused\\\", reason).\\\"\\\"\\\"\\n207\\t    err = \\\"\\\"\\n208\\t    base = git(root, \\\"rev-parse\\\", \\\"HEAD\\\").strip()\\n209\\t    for attempt in range(1 if lease else RECORD_PUSH_TRIES):\\n210\\t        if attempt:\\n211\\t            try:\\n212\\t                base = _retry_base(root, branch)\\n213\\t            except TransportRefused as exc:\\n214\\t                return \\\"refused\\\", str(exc)\\n215\\t            except RuntimeError as exc:\\n216\\t                return \\\"refused\\\", f\\\"could not read origin's {branch}: {exc}\\\"\\n217\\t        with record_worktree(root, base) as tree:\\n218\\t            paths = write(tree)\\n219\\t            try:\\n220\\t                sha = commit_record(tree, paths, message)\\n221\\t            except RuntimeError as exc:\\n222\\t                return \\\"refused\\\", f\\\"could not commit: {exc}\\\"\\n223\\t            if has_origin(root):\\n224\\t                run = subprocess.run([\\\"git\\\", \\\"-C\\\", str(tree), \\\"push\\\", \\\"origin\\\", f\\\"HEAD:{branch}\\\"],\\n225\\t                                     capture_output=True, text=True, check=False)\\n226\\t                if run.returncode != 0:\\n227\\t                    err = run.stderr.strip()\\n228\\t                    if lease:\\n229\\t                        raced = any(marker in run.stderr for marker in _RACE_MARKERS)\\n230\\t                        return (\\\"lost-race\\\" if raced else \\\"refused\\\"), err\\n231\\t                    continue\\n232\\t            try:\\n233\\t                _stage_copies(root, _record_paths(tree, paths))\\n234\\t                sync_checkout(root, sha)\\n235\\t            except (RuntimeError, TransportRefused) as exc:\\n236\\t                return \\\"refused\\\", str(exc)\\n237\\t            return \\\"pushed\\\", None\\n238\\t    return \\\"refused\\\", f\\\"push rejected {RECORD_PUSH_TRIES} times: {err}\\\"\\n239\\t\\n240\\t\\n241\\t_RACE_MARKERS = (\\\"non-fast-forward\\\", \\\"fetch first\\\", \\\"stale info\\\", \\\"cannot lock ref\\\",\\n242\\t                 \\\"failed to update ref\\\")\\n243\\t\\n244\\t\\n245\\tdef has_origin(root: Path) -> bool:\\n246\\t    \\\"\\\"\\\"Whether this checkout carries an origin remote at all -- a fixture\\n247\\t    or a scratch checkout with none is not a refusal; a pass commits\\n248\\t    locally and skips the push, the way recovery always has.\\\"\\\"\\\"\\n249\\t    try:\\n250\\t        git(root, \\\"remote\\\", \\\"get-url\\\", \\\"origin\\\")\\n251\\t        return True\\n252\\t    except RuntimeError:\\n253\\t        return False\\n254\\t\\n255\\t\\n256\\tdef drive_state(root: Path, m: dict[str, Any], item_id: str) -> tuple[str, str | None, Path]:\\n257\\t    \\\"\\\"\\\"(\\\"no-approval\\\" | \\\"build\\\" | \\\"verify\\\" | \\\"ready\\\", detail, records_dir):\\n258\\t    the next mechanical step for item_id, read from its latest records\\n259\\t    alone. A build only counts as current when it is a pass bound to the\\n260\\t    valid approval's own sha; a verify only counts as current when it is a\\n261\\t    pass bound to that build's own sha -- the same staleness a re-approval\\n262\\t    or a re-build must force, attest's own chain check already enforces\\n263\\t    (check_attest_chain), read here rather than re-typed.\\\"\\\"\\\"\\n264\\t    records_rel = m[\\\"paths\\\"][\\\"records\\\"]\\n265\\t    records_dir = root / records_rel / item_id\\n266\\t\\n267\\t    status = approval_status(root, m, item_id)\\n268\\t    if status != \\\"valid\\\":\\n269\\t        return \\\"no-approval\\\", status, records_dir\\n270\\t\\n271\\t    latest_approval = latest_record(records_dir, \\\"approval\\\")\\n272\\t    latest_build = latest_record(records_dir, \\\"build\\\")\\n273\\t    build_current = (latest_build is not None and latest_build.get(\\\"status\\\") == \\\"pass\\\"\\n274\\t                     and latest_build.get(\\\"approval_sha\\\")\\n275\\t                     == (latest_approval.get(\\\"sha\\\") if latest_approval else None))\\n276\\t    if latest_build is None or not build_current:\\n277\\t        return \\\"build\\\", None, records_dir\\n278\\t\\n279\\t    latest_verify = latest_record(records_dir, \\\"verify\\\")\\n280\\t    verify_current = (latest_verify is not None and latest_verify.get(\\\"status\\\") == \\\"pass\\\"\\n281\\t                      and latest_verify.get(\\\"build_sha\\\") == latest_build.get(\\\"sha\\\"))\\n282\\t    if not verify_current:\\n283\\t        return \\\"verify\\\", None, records_dir\\n284\\t\\n285\\t    return \\\"ready\\\", None, records_dir\\n286\\t\\n287\\t\\n288\\t# --- the heartbeat (its helpers live in attavo/doctor.py, where proof five\\n289\\t# reads it too), the worker log, and the forge-checks handoff: local\\n290\\t# facts under the checkout's own git directory (issue #140's precedent),\\n291\\t# never committed and never among the paths commit_record ever names. ---\\n292\\t\\n293\\tdef worker_log_path(root: Path, stage: str, nn: int) -> Path:\\n294\\t    return stage_events_dir(root) / f\\\"{stage}-{nn:02d}.worker.log\\\"\\n295\\t\\n296\\t\\n297\\tdef forge_checks_path(root: Path, stage: str, nn: int) -> Path:\\n298\\t    return stage_events_dir(root) / f\\\"{stage}-{nn:02d}.forge-checks.json\\\"\\n299\\t\\n300\\t\\n301\\tdef _events_path_for(root: Path, stage: str, nn: int) -> Path | None:\\n302\\t    \\\"\\\"\\\"The adapter's own events file for this invocation, under the\\n303\\t    checkout's git dir (a worktree's own dir when the checkout is one).\\\"\\\"\\\"\\n304\\t    try:\\n305\\t        gitdir = Path(git(root, \\\"rev-parse\\\", \\\"--git-dir\\\").strip())\\n306\\t    except RuntimeError:\\n307\\t        return None\\n308\\t    if not gitdir.is_absolute():\\n309\\t        gitdir = root / gitdir\\n310\\t    path = gitdir / \\\"attavo\\\" / f\\\"{stage}-{nn:02d}.events.jsonl\\\"\\n311\\t    return path if path.is_file() else None\\n312\\t\\n313\\t\\n314\\tdef _events_tail(path: Path | None, lines: int = 20) -> tuple[str, str | None]:\\n315\\t    \\\"\\\"\\\"(the last lines as a log, the last event's own at).\\\"\\\"\\\"\\n316\\t    if path is None:\\n317\\t        return \\\"no events file for this invocation\\\\n\\\", None\\n318\\t    try:\\n319\\t        text = path.read_text()\\n320\\t    except OSError:\\n321\\t        return \\\"events file unreadable\\\\n\\\", None\\n322\\t    tail = text.splitlines()[-lines:]\\n323\\t    last_at = None\\n324\\t    for line in reversed(tail):\\n325\\t        parsed = _parse_json_line(line)\\n326\\t        if not isinstance(parsed, dict):\\n327\\t            continue\\n328\\t        at = parsed.get(\\\"at\\\")\\n329\\t        if isinstance(at, str):\\n330\\t            last_at = at\\n331\\t            break\\n332\\t    return \\\"\\\\n\\\".join(tail) + \\\"\\\\n\\\", last_at\\n333\\t\\n334\\t\\n335\\tdef _seconds_since(at: str | None) -> float | None:\\n336\\t    from datetime import datetime, timezone\\n337\\t    if not at:\\n338\\t        return None\\n339\\t    try:\\n340\\t        then = datetime.strptime(at, \\\"%Y-%m-%dT%H:%M:%SZ\\\").replace(tzinfo=timezone.utc)\\n341\\t    except ValueError:\\n342\\t        return None\\n343\\t    return clock.now() - then.timestamp()\\n344\\t\\n345\\t\\n346\\tclass InvocationReading(NamedTuple):\\n347\\t    \\\"\\\"\\\"What one marker with no record reads as, from here and now.\\\"\\\"\\\"\\n348\\t    stage: str\\n349\\t    nn: int\\n350\\t    log: str\\n351\\t    last_at: str | None\\n352\\t    age: float | None\\n353\\t    cls: str  # \\\"running\\\" | \\\"hung\\\" | \\\"died\\\"\\n354\\t    bound: str | None = None  # R3: \\\"stall\\\" or \\\"ceiling\\\" when cls is \\\"hung\\\"\\n355\\t\\n356\\t\\n357\\tdef _manifest_of(root: Path) -> dict[str, Any]:\\n358\\t    m = read_manifest(root)\\n359\\t    return m if m is not None else {}\\n360\\t\\n361\\t\\n362\\tdef _streams_events(root: Path, m: dict[str, Any], stage: str) -> bool:\\n363\\t    \\\"\\\"\\\"R3: whether stage's adapter declares it streams events at all\\n364\\t    (adapters/<name>/conformance.json, \\\"streams_events\\\") -- one that does\\n365\\t    not is judged by its ceiling alone, and never called hung by event\\n366\\t    age it never produces. True (the ordinary case) when the adapter\\n367\\t    declares nothing, or none is configured to ask.\\\"\\\"\\\"\\n368\\t    name = (m.get(\\\"executor\\\") or {}).get(stage) or (m.get(\\\"executor\\\") or {}).get(\\\"build\\\")\\n369\\t    if not name:\\n370\\t        return True\\n371\\t    for base in (root / \\\"attavo\\\" / \\\"adapters\\\", PRODUCT_ROOT / \\\"adapters\\\"):\\n372\\t        conf = base / name / \\\"conformance.json\\\"\\n373\\t        if conf.is_file():\\n374\\t            try:\\n375\\t                return bool(json.loads(conf.read_text()).get(\\\"streams_events\\\", True))\\n376\\t            except (OSError, ValueError):\\n377\\t                return True\\n378\\t    return True\\n379\\t\\n380\\t\\n381\\tdef read_invocation(root: Path, bound: int | None, marker: Path, info: dict[str, Any]) -> InvocationReading:\\n382\\t    \\\"\\\"\\\"Whether an invocation that began and wrote no record is running,\\n383\\t    hung, or died -- read from the heartbeat its holder writes and from\\n384\\t    nothing else (root cause 4). A heartbeat fresh within three beats of\\n385\\t    ATTAVO_HEARTBEAT_S is a live holder: running, or, with a stall bound\\n386\\t    declared and the last event (the marker's own `at` when there is\\n387\\t    none) older than it, hung. A stale heartbeat is died, whether or not\\n388\\t    any pid lives -- a worker stuck somewhere that never reaches its own\\n389\\t    heartbeat loop again is exactly what this is for. The heartbeat is\\n390\\t    read where the marker says its holder writes it (holder_heartbeat_path),\\n391\\t    never in this checkout by assumption: two checkouts on one host each\\n392\\t    keep their own. With no heartbeat file there, a marker from this host\\n393\\t    that names no directory is died -- the holder never touched its first\\n394\\t    beat, or is gone -- and one from another host, or one naming a\\n395\\t    directory with no heartbeat yet, follows the stall bound as proof five\\n396\\t    does: running while younger, died after. The stall bound decides\\n397\\t    hung, never died.\\n398\\t\\n399\\t    R3: the stage's own ceiling (wall clock from the marker's own `at`)\\n400\\t    is judged first, before any of that -- alive past it is hung by the\\n401\\t    ceiling whatever event age says, and an adapter that declares it\\n402\\t    streams no events is judged by the ceiling alone: bound is read as\\n403\\t    None for it, so the stall check below never fires on an event age it\\n404\\t    never had.\\\"\\\"\\\"\\n405\\t    import socket\\n406\\t    stage, nn_text = marker.stem.rsplit(\\\"-\\\", 1)\\n407\\t    nn = int(nn_text)\\n408\\t    log, last_at = _events_tail(_events_path_for(root, stage, nn))\\n409\\t    m = _manifest_of(root)\\n410\\t    ceiling = ceiling_s(m, stage)\\n411\\t    since_start = _seconds_since(info.get(\\\"at\\\"))\\n412\\t    if ceiling is not None and since_start is not None and since_start > ceiling:\\n413\\t        return InvocationReading(stage, nn, log, last_at, since_start, \\\"hung\\\", \\\"ceiling\\\")\\n414\\t    stall_bound = bound\\n415\\t    if not _streams_events(root, m, stage):\\n416\\t        bound = None\\n417\\t    beat_file = holder_heartbeat_path(root, info, stage, nn)\\n418\\t    beat_age = heartbeat_age_s(beat_file) if beat_file is not None else None\\n419\\t    if beat_age is not None:\\n420\\t        if beat_age > heartbeat_s() * 3:\\n421\\t            return InvocationReading(stage, nn, log, last_at, beat_age, \\\"died\\\")\\n422\\t        age = _seconds_since(last_at or info.get(\\\"at\\\"))\\n423\\t        if bound is None or age is None or age <= bound:\\n424\\t            return InvocationReading(stage, nn, log, last_at, beat_age, \\\"running\\\")\\n425\\t        return InvocationReading(stage, nn, log, last_at, age, \\\"hung\\\", \\\"stall\\\")\\n426\\t    if info.get(\\\"host\\\") != socket.gethostname() or info.get(\\\"events\\\"):\\n427\\t        # No heartbeat to read: another host's, or, from this host, none\\n428\\t        # yet where the marker says its holder beats -- another\\n429\\t        # checkout's worker that has not reached its first beat. Running\\n430\\t        # while younger than the stall bound, as proof five reads it.\\n431\\t        marker_age = invocation_age_s(info)\\n432\\t        if stall_bound is not None and marker_age is not None and marker_age < stall_bound:\\n433\\t            return InvocationReading(stage, nn, log, last_at, marker_age, \\\"running\\\")\\n434\\t    return InvocationReading(stage, nn, log, last_at, _seconds_since(last_at or info.get(\\\"at\\\")), \\\"died\\\")\\n435\\t\\n436\\t\\n437\\tdef uncommitted_record(root: Path, records_dir: Path, stage: str) -> Path | None:\\n438\\t    \\\"\\\"\\\"The latest <stage>-NN.json this working tree carries that git has\\n439\\t    no commit for yet -- the moment between a worker's write and its own\\n440\\t    commit. None when the latest record is already committed, or there\\n441\\t    is none at all.\\\"\\\"\\\"\\n442\\t    path = latest_attempt_path(records_dir, stage)\\n443\\t    if path is None or not path.is_file():\\n444\\t        return None\\n445\\t    status = subprocess.run(\\n446\\t        [\\\"git\\\", \\\"-C\\\", str(root), \\\"status\\\", \\\"--porcelain\\\", \\\"--\\\", str(path.relative_to(root))],\\n447\\t        capture_output=True, text=True, check=False)\\n448\\t    return path if status.stdout.strip() else None\\n449\\t\\n450\\t\\n451\\tdef worker_holds_copy(root: Path, records_dir: Path) -> bool:\\n452\\t    \\\"\\\"\\\"True when this checkout's own working tree cannot safely be moved\\n453\\t    -- an invocation marker with no record yet (a worker, here or\\n454\\t    elsewhere, still holds this attempt), or a build or verify record the\\n455\\t    working tree carries that git has not committed yet. Scoped to the\\n456\\t    stage records a pass or a worker itself ever transports -- an\\n457\\t    operator's own spec-gate or approve, routinely uncommitted between\\n458\\t    their own act and the next pass, is not this. A pass never\\n459\\t    fast-forwards while this holds (never while a worker holds the\\n460\\t    copy).\\\"\\\"\\\"\\n461\\t    if invocations_without_record(records_dir):\\n462\\t        return True\\n463\\t    return (uncommitted_record(root, records_dir, \\\"build\\\") is not None\\n464\\t           or uncommitted_record(root, records_dir, \\\"verify\\\") is not None)\\n465\\t\\n466\\t\\n467\\tdef fast_forward_to_origin(root: Path, m: dict[str, Any], item_id: str) -> str | None:\\n468\\t    \\\"\\\"\\\"The pass's own read of origin's branch, taken before it reads\\n469\\t    anything else -- a commit landed there from elsewhere (an approval\\n470\\t    from the screen, a ruling, another pass's own record) is not a race\\n471\\t    for the lease, it is exactly what the lease is for. Never while a\\n472\\t    worker holds this copy (worker_holds_copy): moving a working tree a\\n473\\t    detached child is still writing into would corrupt its own commits.\\n474\\t    The checkout only fast-forwards. When it carries commits origin has\\n475\\t    not seen (an operator's approval, not yet pushed), the pass does not\\n476\\t    replay them: it returns a refusal naming each by sha and author, and\\n477\\t    the commits stay where they are. None when the checkout is now at\\n478\\t    origin's tip or there is nothing to read; silent about an absent\\n479\\t    origin or an unreachable one, which the ordinary read (and the\\n480\\t    marker push, for the lease) sort out.\\\"\\\"\\\"\\n481\\t    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n482\\t    if worker_holds_copy(root, records_dir) or not has_origin(root):\\n483\\t        return None\\n484\\t    try:\\n485\\t        branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n486\\t        git(root, \\\"fetch\\\", \\\"origin\\\", branch)\\n487\\t    except RuntimeError:\\n488\\t        return None\\n489\\t    ours = git(root, \\\"log\\\", \\\"--format=%h %an <%ae>\\\", \\\"FETCH_HEAD..HEAD\\\").splitlines()\\n490\\t    if not ours:\\n491\\t        try:\\n492\\t            git(root, \\\"merge\\\", \\\"--ff-only\\\", \\\"FETCH_HEAD\\\")\\n493\\t        except RuntimeError:\\n494\\t            pass\\n495\\t        return None\\n496\\t    listed = \\\"; \\\".join(ours)\\n497\\t    return (f\\\"this checkout carries {len(ours)} commit(s) origin's {branch} lacks and the pass \\\"\\n498\\t            f\\\"does not replay them: {listed}. Push them, or move them, and run the pass again\\\")\\n499\\t\\n500\\t\\n501\\t# --- the worker: a detached child of the pass's own session, running the\\n502\\t# stage exactly as the pass used to inline, touching its own heartbeat\\n503\\t# while it does (R2). ---\\n504\\t\\n505\\tdef _stage_body(item_id: str, stage: str, nn: int) -> int:\\n506\\t    \\\"\\\"\\\"Runs build or verify in-process -- the same command `attavo build`\\n507\\t    or `attavo verify` would run -- while touching heartbeat_path every\\n508\\t    heartbeat_s() seconds, then transports whatever it wrote: counsel and\\n509\\t    file-stops on a non-pass record (issue #100, #89), one `git commit\\n510\\t    --only`, one push with the record push's own merge retry. The\\n511\\t    marker is the pass's, already committed and pushed before this\\n512\\t    starts; this writes and transports only the stage's own record (and,\\n513\\t    on a stop, its counsel record).\\\"\\\"\\\"\\n514\\t    root = Path(\\\".\\\").resolve()\\n515\\t    m = read_manifest(root)\\n516\\t    if m is None:\\n517\\t        return 2\\n518\\t    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n519\\t    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n520\\t    before = latest_attempt_path(records_dir, stage)\\n521\\t\\n522\\t    beat = heartbeat_path(root, stage, nn)\\n523\\t    beat.parent.mkdir(parents=True, exist_ok=True)\\n524\\t    beat.write_text(f\\\"{os.getpid()}\\\\n\\\")\\n525\\t    stop_beat = threading.Event()\\n526\\t\\n527\\t    def _tick() -> None:\\n528\\t        while not stop_beat.wait(heartbeat_s()):\\n529\\t            beat.touch()\\n530\\t\\n531\\t    beat_thread = threading.Thread(target=_tick, daemon=True)\\n532\\t    beat_thread.start()\\n533\\t    # The heartbeat says the holder is alive, so it runs until the holder\\n534\\t    # returns -- through counsel, file-stops, the commit and the push --\\n535\\t    # not until the stage command does.\\n536\\t    try:\\n537\\t        return _run_and_transport(item_id, stage, root, m, records_dir, branch, before)\\n538\\t    finally:\\n539\\t        stop_beat.set()\\n540\\t        beat_thread.join()\\n541\\t\\n542\\t\\n543\\tdef _run_and_transport(item_id: str, stage: str, root: Path, m: dict[str, Any],\\n544\\t                       records_dir: Path, branch: str, before: Path | None) -> int:\\n545\\t    rc = cmd_build([item_id]) if stage == \\\"build\\\" else cmd_verify([item_id])\\n546\\t\\n547\\t    after = latest_attempt_path(records_dir, stage)\\n548\\t    if after is None or after == before:\\n549\\t        # Refused before writing anything at all (e.g. no adapter\\n550\\t        # configured) -- the stage command already printed why.\\n551\\t        return rc if rc != 0 else 1\\n552\\t\\n553\\t    record = cast(dict[str, Any], latest_record(records_dir, stage))\\n554\\t    status_out = record.get(\\\"status\\\")\\n555\\t    to_commit = [after]\\n556\\t    if status_out != \\\"pass\\\":\\n557\\t        stop = record.get(\\\"stop\\\") or {}\\n558\\t        state = retry_state(root, m, records_dir, stage, stop.get(\\\"class\\\"),\\n559\\t                            int(after.stem.rsplit(\\\"-\\\", 1)[1]))\\n560\\t        # R3: a stop the next plain pass would already retry -- now, or\\n561\\t        # once its transient wait elapses -- asks counsel nothing and\\n562\\t        # files nothing (#194's own verify-01, replayed as this item's\\n563\\t        # rejection fixture, paid for exactly this on a vendor's own\\n564\\t        # capacity error). Counsel reads it, as before, the moment that\\n565\\t        # is no longer true: the budget is spent, the early stop fired,\\n566\\t        # or the class was never a plain retry's to begin with.\\n567\\t        if not (state.eligible or state.waiting_s is not None):\\n568\\t            counsel_before = latest_attempt_path(records_dir, \\\"counsel\\\")\\n569\\t            cmd_counsel([item_id])\\n570\\t            counsel_after = latest_attempt_path(records_dir, \\\"counsel\\\")\\n571\\t            if counsel_after is not None and counsel_after != counsel_before:\\n572\\t                to_commit.append(counsel_after)\\n573\\t            # file-stops is its own idempotent read of the item's records,\\n574\\t            # so calling it here on every run that wrote a non-pass record\\n575\\t            # is safe to call again on a later run: an already-filed\\n576\\t            # stop's own marker is what stops it from being filed twice.\\n577\\t            cmd_file_stops([item_id])\\n578\\t\\n579\\t    message = f\\\"attavo: {stage} record for item {item_id} ({after.stem})\\\"\\n580\\t\\n581\\t    def copy_in(tree: Path) -> list[Path]:\\n582\\t        # The stage command wrote the records in this checkout, untracked;\\n583\\t        # they are committed from the detached worktree and the checkout's\\n584\\t        # copies become the committed ones when the checkout fast-forwards\\n585\\t        # (transport_records).\\n586\\t        copied: list[Path] = []\\n587\\t        for record_path in to_commit:\\n588\\t            for src in (record_path, record_path.with_suffix(\\\".log\\\"), record_path.with_suffix(\\\".filed\\\")):\\n589\\t                if src.is_file():\\n590\\t                    dest = tree / src.relative_to(root)\\n591\\t                    dest.parent.mkdir(parents=True, exist_ok=True)\\n592\\t                    shutil.copyfile(src, dest)\\n593\\t            copied.append(tree / record_path.relative_to(root))\\n594\\t        return copied\\n595\\t\\n596\\t    outcome, err = transport_records(root, branch, message, copy_in)\\n597\\t    if outcome != \\\"pushed\\\":\\n598\\t        print(f\\\"attavo drive: stopped: could not push the {stage} record: {err}\\\")\\n599\\t        return 1\\n600\\t    if not has_origin(root):\\n601\\t        print(f\\\"attavo drive: note: no origin remote; {after.name} is committed, not pushed\\\")\\n602\\t\\n603\\t    if status_out == \\\"halted\\\":\\n604\\t        question = (record.get(\\\"halted\\\") or {}).get(\\\"question\\\")\\n605\\t        print(f\\\"attavo drive: stopped: {stage} halted: {question} ({after.name}); \\\"\\n606\\t              f\\\"pushed to {branch}\\\")\\n607\\t    elif status_out != \\\"pass\\\":\\n608\\t        reason = record.get(\\\"refusal\\\") or status_out\\n609\\t        print(f\\\"attavo drive: stopped: {stage} {status_out}: {reason} ({after.name}); \\\"\\n610\\t              f\\\"pushed to {branch}\\\")\\n611\\t    else:\\n612\\t        print(f\\\"attavo drive: pushed {after.name} to {branch}\\\")\\n613\\t    return rc\\n614\\t\\n615\\t\\n616\\tdef cmd_worker(argv: list[str]) -> int:\\n617\\t    \\\"\\\"\\\"`attavo worker N <build|verify> NN`: the detached child a pass\\n618\\t    starts once its marker is pushed -- the lease held, the attempt is\\n619\\t    this worker's to run. Its own session (start_new_session, set by the\\n620\\t    pass that spawns it); its stdout and stderr are the pass's own\\n621\\t    redirect, to <git-dir>/attavo/<stage>-NN.worker.log.\\\"\\\"\\\"\\n622\\t    cast(io.TextIOWrapper, sys.stdout).reconfigure(line_buffering=True)\\n623\\t    if len(argv) != 3:\\n624\\t        print(\\\"attavo worker: usage: attavo worker N <build|verify> NN\\\", file=sys.stderr)\\n625\\t        return 2\\n626\\t    item_id, stage, nn_text = argv\\n627\\t    if stage not in (\\\"build\\\", \\\"verify\\\"):\\n628\\t        print(f\\\"attavo worker: {stage!r} is not build or verify\\\", file=sys.stderr)\\n629\\t        return 2\\n630\\t    try:\\n631\\t        nn = int(nn_text)\\n632\\t    except ValueError:\\n633\\t        print(f\\\"attavo worker: {nn_text!r} is not an attempt number\\\", file=sys.stderr)\\n634\\t        return 2\\n635\\t    return _stage_body(item_id, stage, nn)\\n636\\t\\n637\\t\\n638\\t# --- the pass's own two acts: start a stage (the lease), and recover\\n639\\t# exactly the one invocation the report names owed one. ---\\n640\\t\\n641\\tdef _start_stage(root: Path, m: dict[str, Any], item_id: str, stage: str,\\n642\\t                 forge_checks: dict[str, Any] | None, again_by: str | None = None) -> int:\\n643\\t    \\\"\\\"\\\"The lease (ruling A): the marker, committed and pushed as a plain\\n644\\t    fast-forward with no merge and no retry, made and pushed from a\\n645\\t    detached worktree (transport_records). Lost to another pass, or\\n646\\t    refused outright by the remote, the worktree is discarded and this\\n647\\t    checkout was never touched; only a pushed lease starts the worker. On a\\n648\\t    review, forge_checks is the checks this same pass already read on\\n649\\t    the pre-marker head (ruling B) -- written to\\n650\\t    <git-dir>/attavo/verify-NN.forge-checks.json and named in\\n651\\t    ATTAVO_FORGE_CHECKS, so the worker's own `attavo verify` reads it\\n652\\t    instead of polling. again_by (R3) is the login that pressed `--again`, set\\n653\\t    only when it is what started this attempt, past a budget already spent\\n654\\t    or an early stop -- named in the marker, never on an ordinary or\\n655\\t    plainly-retried attempt.\\\"\\\"\\\"\\n656\\t    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n657\\t    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n658\\t    nn = next_attempt_number(records_dir, stage)\\n659\\t    marker = records_dir / f\\\"{stage}-{nn:02d}.started\\\"\\n660\\t\\n661\\t    def write_marker(tree: Path) -> list[Path]:\\n662\\t        return [write_invocation_marker(tree, tree / records_dir.relative_to(root), stage, nn,\\n663\\t                                        again_by=again_by, events_dir=stage_events_dir(root))]\\n664\\t\\n665\\t    outcome, err = transport_records(\\n666\\t        root, branch, f\\\"attavo: {stage} invocation {nn:02d} started for item {item_id}\\\",\\n667\\t        write_marker, lease=True)\\n668\\t    if outcome == \\\"lost-race\\\":\\n669\\t        print(f\\\"attavo drive: another pass holds this attempt ({marker.name}); nothing started\\\")\\n670\\t        return 0\\n671\\t    if outcome != \\\"pushed\\\":\\n672\\t        print(f\\\"attavo drive: stopped: could not push the {stage} invocation marker: {err}\\\")\\n673\\t        return 1\\n674\\t\\n675\\t    env = dict(os.environ)\\n676\\t    if forge_checks is not None:\\n677\\t        checks_file = forge_checks_path(root, stage, nn)\\n678\\t        checks_file.write_text(json.dumps(forge_checks))\\n679\\t        env[\\\"ATTAVO_FORGE_CHECKS\\\"] = str(checks_file)\\n680\\t    log = worker_log_path(root, stage, nn)\\n681\\t    with log.open(\\\"ab\\\") as fh, open(os.devnull, \\\"rb\\\") as devnull:\\n682\\t        proc = subprocess.Popen(\\n683\\t            [sys.executable, str(PRODUCT_ROOT / \\\"bin\\\" / \\\"attavo\\\"), \\\"worker\\\", item_id, stage, f\\\"{nn:02d}\\\"],\\n684\\t            cwd=str(root), env=env, stdin=devnull, stdout=fh, stderr=subprocess.STDOUT,\\n685\\t            start_new_session=True)\\n686\\t    word = \\\"Build\\\" if stage == \\\"build\\\" else \\\"Review\\\"\\n687\\t    print(f\\\"attavo drive: {word} started (attempt {nn:02d}, worker pid {proc.pid})\\\")\\n688\\t    return 0\\n689\\t\\n690\\t\\n691\\tdef _recover_one(root: Path, m: dict[str, Any], item_id: str, records_dir: Path) -> int:\\n692\\t    \\\"\\\"\\\"The pass's own recovery act (what `--recover` did): exactly the one\\n693\\t    invocation the report just read as owing one -- died or hung -- ends\\n694\\t    here. class died when the heartbeat is stale or absent, class hung\\n695\\t    when the heartbeat is fresh and a declared [drive].stall_after_s has\\n696\\t    passed with no newer event (or the stage's ceiling has passed), the\\n697\\t    holder terminated by the pid its own heartbeat names. Provenance product; the events tail as the log. Committed\\n698\\t    and pushed the way any stage record is (transport_records, with its\\n699\\t    retry that never merges) -- this is not a race for a lease, since no new\\n700\\t    attempt marker is written.\\\"\\\"\\\"\\n701\\t    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n702\\t    bound = stall_bound_s(m)\\n703\\t    pending = invocations_without_record(records_dir)\\n704\\t    readings = [(marker, info, read_invocation(root, bound, marker, info)) for marker, info in pending]\\n705\\t    candidate = next(((mk, i, rd) for mk, i, rd in readings if rd.cls != \\\"running\\\"), None)\\n706\\t    if candidate is None:\\n707\\t        # The report read this a moment ago; nothing owed recovery by the\\n708\\t        # time this pass got here (another pass recovered it, or it\\n709\\t        # finished on its own).\\n710\\t        return 0\\n711\\t    marker, info, reading = candidate\\n712\\t    stage, nn, log, last_at, age, cls, crossed = reading\\n713\\t    host = info.get(\\\"host\\\")\\n714\\t\\n715\\t    if next_attempt_number(records_dir, stage) != nn:\\n716\\t        print(f\\\"attavo drive: stopped: {marker.name} names attempt {nn} but the next \\\"\\n717\\t              f\\\"{stage} record would be {next_attempt_number(records_dir, stage):02d}; \\\"\\n718\\t              f\\\"a later record already exists, read the records before recovering\\\")\\n719\\t        return 1\\n720\\t\\n721\\t    if cls == \\\"hung\\\":\\n722\\t        holder_file = holder_heartbeat_path(root, info, stage, nn)\\n723\\t        holder = heartbeat_pid(holder_file) if holder_file is not None else None\\n724\\t        if holder is None:\\n725\\t            print(f\\\"attavo drive: no holder to signal for {marker.stem}: its heartbeat names no pid\\\")\\n726\\t            ended = \\\"no holder to signal\\\"\\n727\\t            who = f\\\"no holder on {host}\\\"\\n728\\t        else:\\n729\\t            who = f\\\"pid {holder} on {host} alive\\\"\\n730\\t            try:\\n731\\t                os.kill(holder, signal.SIGTERM)\\n732\\t                ended = \\\"terminated\\\"\\n733\\t            except OSError as exc:\\n734\\t                ended = f\\\"not terminated ({exc})\\\"\\n735\\t        if crossed == \\\"ceiling\\\":\\n736\\t            detail = (f\\\"{who} {int(cast(float, age))} s after its marker, \\\"\\n737\\t                      f\\\"past the {stage} ceiling of {ceiling_s(m, stage)} s; {ended}\\\")\\n738\\t        else:\\n739\\t            detail = (f\\\"{who} with no event for {int(cast(float, age))} s \\\"\\n740\\t                      f\\\"(bound {bound} s); {ended}\\\")\\n741\\t    else:\\n742\\t        detail = (f\\\"{marker.stem} on {host} has no live heartbeat and wrote no {marker.stem}.json; \\\"\\n743\\t                  f\\\"started {info.get('at')}, last event {last_at or 'none'}\\\")\\n744\\t\\n745\\t    signature_text = log.strip().splitlines()[-1] if log.strip() else detail\\n746\\t\\n747\\t    schema = stage_schema(stage)\\n748\\t    record: dict[str, Any] = {k: None for k in schema.get(\\\"required\\\", [])}\\n749\\t    approval = latest_record(records_dir, \\\"approval\\\")\\n750\\t    record.update({\\\"sha\\\": info.get(\\\"sha\\\"), \\\"start_sha\\\": info.get(\\\"sha\\\"),\\n751\\t                   \\\"approval_sha\\\": approval.get(\\\"sha\\\") if approval else None,\\n752\\t                   \\\"at\\\": info.get(\\\"at\\\"),\\n753\\t                   \\\"adapter\\\": (m.get(\\\"executor\\\") or {}).get(stage),\\n754\\t                   \\\"status\\\": \\\"failed\\\", \\\"refusal\\\": None, \\\"halted\\\": None,\\n755\\t                   \\\"retry_of\\\": None, \\\"steer\\\": None,\\n756\\t                   \\\"stop\\\": {\\\"class\\\": cls, \\\"provenance\\\": \\\"product\\\", \\\"detail\\\": detail,\\n757\\t                            \\\"signature\\\": signature_of(signature_text), \\\"bound\\\": crossed}})\\n758\\t    if \\\"wall_clock_s\\\" in record:\\n759\\t        record[\\\"wall_clock_s\\\"] = None if age is None else int(age)\\n760\\t    record = {k: v for k, v in record.items() if k in schema.get(\\\"properties\\\", {})}\\n761\\t    tree_records = records_dir.relative_to(root)\\n762\\t\\n763\\t    def write_recovered(tree: Path) -> list[Path]:\\n764\\t        return [write_record(tree / tree_records, stage, record, m, item_id, log=log)]\\n765\\t\\n766\\t    message = (f\\\"attavo: {stage} record for item {item_id} \\\"\\n767\\t               f\\\"({stage}-{nn:02d}), recovered as {cls}\\\")\\n768\\t    try:\\n769\\t        outcome, err = transport_records(root, branch, message, write_recovered)\\n770\\t    except ValueError as exc:\\n771\\t        print(f\\\"attavo drive: stopped: could not write the {cls} record for {marker.stem}: {exc}\\\")\\n772\\t        return 1\\n773\\t    if outcome != \\\"pushed\\\":\\n774\\t        print(f\\\"attavo drive: stopped: could not push the {cls} record: {err}\\\")\\n775\\t        return 1\\n776\\t    if not has_origin(root):\\n777\\t        print(f\\\"attavo drive: note: no origin remote; {stage}-{nn:02d}.json is committed, not pushed\\\")\\n778\\t    print(f\\\"attavo drive: recovered {marker.stem} as {cls}: {detail}\\\")\\n779\\t    return 0\\n780\\t\\n781\\t\\n782\\tdef _advance_again(root: Path, m: dict[str, Any], item_id: str, stage: str, head: str | None,\\n783\\t                   again_by: str | None = None) -> int:\\n784\\t    \\\"\\\"\\\"The next attempt of a stopped stage, bypassing the level a plain\\n785\\t    pass leaves alone for the operator: what a plain retry (R3, inside\\n786\\t    the budget) starts on its own, and what `--again` starts by force\\n787\\t    once the budget is spent or an early stop fired. A review reads the\\n788\\t    forge fresh here -- once, since the report's own stopped reading\\n789\\t    never touched it -- rather than reusing a read that was never taken.\\\"\\\"\\\"\\n790\\t    if stage == \\\"build\\\":\\n791\\t        return _start_stage(root, m, item_id, \\\"build\\\", None, again_by=again_by)\\n792\\t    checks_command = (m.get(\\\"forge\\\") or {}).get(\\\"checks_command\\\")\\n793\\t    if not checks_command:\\n794\\t        print(\\\"attavo drive: refused: no [forge].checks_command in the manifest\\\")\\n795\\t        return 1\\n796\\t    forge_checks, ok = read_forge_checks(root, checks_command, cast(str, head))\\n797\\t    if not ok:\\n798\\t        conclusions = forge_checks[\\\"conclusions\\\"]\\n799\\t        named = \\\", \\\".join(f\\\"{c['name']} {c['conclusion']}\\\" for c in conclusions) or \\\"no checks reported\\\"\\n800\\t        print(f\\\"attavo drive: forge checks not green on {cast(str, head)[:12]}: {named}\\\")\\n801\\t        return 0\\n802\\t    return _start_stage(root, m, item_id, \\\"verify\\\", forge_checks, again_by=again_by)\\n803\\t\\n804\\t\\n805\\t# --- R3: the retry decision, shared by the report's own kind/says and the\\n806\\t# pass's own act (retry_state) so the two cannot drift. ---\\n807\\t\\n808\\t# Never retried by this item, whatever counsel might rule: a\\n809\\t# claims-boundary stop is a person's; a tenant's gate refusal is the\\n810\\t# spec-gate's own, earlier than any of this; an environment refusal is\\n811\\t# recorded here and acted on by R4's breaker. A question is not in this\\n812\\t# tuple -- counsel reads it exactly like any other non-pass record, and\\n813\\t# an \\\"answer\\\" verdict starts the next attempt steered by it, the same as\\n814\\t# any class counsel can rule on; a question nobody answers (no counsel\\n815\\t# configured, or its own verdict is \\\"person\\\") simply never becomes\\n816\\t# eligible, with no exclusion needed to keep it that way.\\n817\\tNEVER_RETRIED_CLASSES = (\\\"claims-boundary\\\", \\\"gate\\\", \\\"environment\\\")\\n818\\t\\n819\\t\\n820\\tdef _budget_stage(stage: str, stop_class: str | None) -> str:\\n821\\t    \\\"\\\"\\\"The stage whose [drive].attempts budget a stop spends -- build for\\n822\\t    a returned review (the check rejection or the blocking finding is the\\n823\\t    build's to answer, never the review's own to repeat), the stop's own\\n824\\t    stage for everything else.\\\"\\\"\\\"\\n825\\t    return \\\"build\\\" if stop_class == \\\"returned\\\" else stage\\n826\\t\\n827\\t\\n828\\tdef _signatures_match(records_dir: Path, stage: str) -> bool:\\n829\\t    \\\"\\\"\\\"Whether the last two attempts of stage carry the identical,\\n830\\t    non-null signature -- the early stop (R3): two attempts of one stage\\n831\\t    ending the same way spend no third.\\\"\\\"\\\"\\n832\\t    attempts = parse_attempts(records_dir, stage)\\n833\\t    if len(attempts) < 2:\\n834\\t        return False\\n835\\t    nums = sorted(attempts)\\n836\\t    sig_a = (attempts[nums[-1]].get(\\\"stop\\\") or {}).get(\\\"signature\\\")\\n837\\t    sig_b = (attempts[nums[-2]].get(\\\"stop\\\") or {}).get(\\\"signature\\\")\\n838\\t    return sig_a is not None and sig_a == sig_b\\n839\\t\\n840\\t\\n841\\tclass RetryState(NamedTuple):\\n842\\t    \\\"\\\"\\\"Whether a plain pass, right now, would start the next attempt of a\\n843\\t    stopped stage (R3) -- eligible; a transient stop still short of\\n844\\t    [drive].retry_after_s carries waiting_s instead, eligible for neither\\n845\\t    a plain pass nor `--again`'s own no-op read of the same fact; steer\\n846\\t    names the counsel record an \\\"answer\\\" verdict would hand the next\\n847\\t    attempt; target_stage is the stage the next attempt actually starts\\n848\\t    (build, for a returned review).\\\"\\\"\\\"\\n849\\t    eligible: bool\\n850\\t    waiting_s: float | None\\n851\\t    steer: str | None\\n852\\t    target_stage: str\\n853\\t\\n854\\t\\n855\\tdef retry_state(root: Path, m: dict[str, Any], records_dir: Path, stage: str,\\n856\\t                stop_class: str | None, attempt: int | None) -> RetryState:\\n857\\t    \\\"\\\"\\\"The one read behind both the report's own kind/says (a stopped\\n858\\t    stage that would retry reads as \\\"acts\\\" or \\\"waits\\\", never \\\"yours\\\") and\\n859\\t    the pass's own act, so the two cannot say different things about the\\n860\\t    same stop. died, hung, transient, and returned retry with no counsel\\n861\\t    asked, inside the shared budget and past the early stop; every other\\n862\\t    class retries only when counsel's own verdict for this exact stop is\\n863\\t    \\\"answer\\\" -- and never when the class is one of NEVER_RETRIED_CLASSES,\\n864\\t    whatever counsel might have said.\\\"\\\"\\\"\\n865\\t    target_stage = _budget_stage(stage, stop_class)\\n866\\t    if stop_class is None or stop_class in NEVER_RETRIED_CLASSES or attempt is None:\\n867\\t        return RetryState(False, None, None, target_stage)\\n868\\t    spent = next_attempt_number(records_dir, target_stage) - 1\\n869\\t    if spent >= attempts_budget(m):\\n870\\t        return RetryState(False, None, None, target_stage)\\n871\\t    if _signatures_match(records_dir, stage):\\n872\\t        return RetryState(False, None, None, target_stage)\\n873\\t    if stop_class in RETRYABLE_CLASSES:\\n874\\t        if stop_class == \\\"transient\\\":\\n875\\t            attempts = parse_attempts(records_dir, stage)\\n876\\t            rec = attempts.get(attempt)\\n877\\t            age = _seconds_since(rec.get(\\\"at\\\")) if rec else None\\n878\\t            wait = retry_after_s(m)\\n879\\t            if age is not None and age < wait:\\n880\\t                return RetryState(False, wait - age, None, target_stage)\\n881\\t        return RetryState(True, None, None, target_stage)\\n882\\t    counsel = counsel_record_for(records_dir, stage, attempt)\\n883\\t    if counsel is not None and counsel.get(\\\"verdict\\\") == \\\"answer\\\":\\n884\\t        target = f\\\"{stage}-{attempt:02d}\\\"\\n885\\t        counsel_attempts = parse_attempts(records_dir, \\\"counsel\\\")\\n886\\t        matches = [n for n, rec in counsel_attempts.items() if rec.get(\\\"record\\\") == target]\\n887\\t        if matches:\\n888\\t            return RetryState(True, None, f\\\"counsel-{max(matches):02d}\\\", target_stage)\\n889\\t    return RetryState(False, None, None, target_stage)\\n890\\t\\n891\\t\\n892\\tdef _pass_once(root: Path, m: dict[str, Any], item_id: str, again: str | None) -> tuple[int, \\\"DriveReport\\\"]:\\n893\\t    \\\"\\\"\\\"One pass: fast-forward to origin (never while a worker holds the\\n894\\t    copy), read the report, act at most once, return. owes-recovery\\n895\\t    recovers; next-build and next-review start their stage, handing a\\n896\\t    review the checks the report already read once on the pre-marker\\n897\\t    head; blocked-on-checks on a review (R3) starts it too -- the same\\n898\\t    act as next-review, since a concluded red check on a passed build's\\n899\\t    head is now a returned record, not a level a pass leaves alone. A\\n900\\t    stopped stage inside its budget (RetryState.eligible) retries itself,\\n901\\t    with no flag needed; `--again` is a no-op that says so when the plain\\n902\\t    mechanism would already act or is only waiting out retry_after_s, and\\n903\\t    forces the next attempt, naming who pressed it as again_by in its marker, when it would\\n904\\t    not. Every other level is printed in the report's own words and left.\\\"\\\"\\\"\\n905\\t    from attavo.report import drive_report\\n906\\t    refusal = fast_forward_to_origin(root, m, item_id)\\n907\\t    r = drive_report(root, m, item_id)\\n908\\t    if refusal:\\n909\\t        print(f\\\"attavo drive: stopped: {refusal}\\\")\\n910\\t        return 1, r\\n911\\t    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n912\\t\\n913\\t    if r[\\\"state\\\"] == \\\"owes-recovery\\\":\\n914\\t        return _recover_one(root, m, item_id, records_dir), r\\n915\\t    if r[\\\"state\\\"] == \\\"next-build\\\":\\n916\\t        return _start_stage(root, m, item_id, \\\"build\\\", None), r\\n917\\t    if r[\\\"state\\\"] in (\\\"next-review\\\", \\\"blocked-on-checks\\\") and r[\\\"stage\\\"] == \\\"verify\\\":\\n918\\t        checks_command = (m.get(\\\"forge\\\") or {}).get(\\\"checks_command\\\")\\n919\\t        forge_checks = {\\\"command\\\": checks_command, \\\"sha\\\": r[\\\"head\\\"], \\\"conclusions\\\": r[\\\"checks\\\"] or []}\\n920\\t        return _start_stage(root, m, item_id, \\\"verify\\\", forge_checks), r\\n921\\t    if r[\\\"state\\\"] == \\\"stopped\\\" and r[\\\"stage\\\"]:\\n922\\t        state = retry_state(root, m, records_dir, r[\\\"stage\\\"], r[\\\"stop_class\\\"], r[\\\"attempt\\\"])\\n923\\t        if again:\\n924\\t            if state.eligible or state.waiting_s is not None:\\n925\\t                print(\\\"attavo drive: --again inside the budget is a no-op; the pass retries \\\"\\n926\\t                      \\\"on its own\\\")\\n927\\t                return 0, r\\n928\\t            return _advance_again(root, m, item_id, state.target_stage, r[\\\"head\\\"], again_by=again), r\\n929\\t        if state.eligible:\\n930\\t            return _advance_again(root, m, item_id, state.target_stage, r[\\\"head\\\"]), r\\n931\\t\\n932\\t    print(f\\\"attavo drive: {r['says']}\\\")\\n933\\t    return (1 if r[\\\"state\\\"] == \\\"refused\\\" else 0), r\\n934\\t\\n935\\t\\n936\\t_TERMINAL_STATES = (\\\"waiting-on-approval\\\", \\\"stopped\\\", \\\"ready-to-merge\\\", \\\"merged\\\")\\n937\\t\\n938\\t\\n939\\tdef _until_ready(root: Path, m: dict[str, Any], item_id: str, again: str | None) -> int:\\n940\\t    \\\"\\\"\\\"--until-ready: the pass, repeated in one process, sleeping\\n941\\t    ATTAVO_DRIVE_POLL_INTERVAL_S between passes, until the level is the\\n942\\t    operator's or done (exit 0), a concluded check is red (exit 1), or\\n943\\t    an unconcluded one has not concluded within ATTAVO_DRIVE_POLL_BOUND_S\\n944\\t    (exit 1). A stage running in its own worker is not bounded by this --\\n945\\t    only time spent waiting on the forge is.\\\"\\\"\\\"\\n946\\t    from attavo.verify import drive_forge_poll_bound_s, drive_forge_poll_interval_s\\n947\\t    bound = drive_forge_poll_bound_s()\\n948\\t    interval = drive_forge_poll_interval_s()\\n949\\t    waiting_since: float | None = None\\n950\\t    while True:\\n951\\t        rc, r = _pass_once(root, m, item_id, again)\\n952\\t        state = r[\\\"state\\\"]\\n953\\t\\n954\\t        if state == \\\"waiting-on-checks\\\":\\n955\\t            if waiting_since is None:\\n956\\t                waiting_since = time.monotonic()\\n957\\t            elif time.monotonic() - waiting_since >= bound:\\n958\\t                print(f\\\"attavo drive: stopped: the checks did not conclude within {bound:.0f}s\\\")\\n959\\t                return 1\\n960\\t        else:\\n961\\t            waiting_since = None\\n962\\t\\n963\\t        if rc != 0:\\n964\\t            return rc\\n965\\t        # R3: \\\"stopped\\\" is terminal only when the pass actually left it\\n966\\t        # alone -- kind \\\"acts\\\" or \\\"waits\\\" means this same pass just\\n967\\t        # retried it (or is only waiting out retry_after_s), and the loop\\n968\\t        # must keep going rather than call that done.\\n969\\t        if state in _TERMINAL_STATES and not (state == \\\"stopped\\\" and r[\\\"kind\\\"] != \\\"yours\\\"):\\n970\\t            return 0\\n971\\t        # R3: blocked-on-checks on a review is no longer a dead end -- the\\n972\\t        # pass just converted it into a returned record and, inside its\\n973\\t        # budget, a build retry follows on its own. Only the post-verify\\n974\\t        # case (the checks went red after a passing review, stage None)\\n975\\t        # is still the level with nothing left to do but give up.\\n976\\t        if state == \\\"blocked-on-checks\\\" and r[\\\"stage\\\"] is None:\\n977\\t            return 1\\n978\\t        time.sleep(interval)\\n979\\t\\n980\\t\\n981\\tdef _drive_all() -> int:\\n982\\t    \\\"\\\"\\\"--all, from the tenant's checkout: one pass, in its own process\\n983\\t    (`attavo drive N`, which ensures the working copy), for every origin\\n984\\t    attavo/<N>-* branch whose item is not merged, and one for every\\n985\\t    existing ../attavo-worktree-N whose item is merged, to remove it.\\n986\\t    Every line either prints is prefixed with the working copy's own\\n987\\t    directory name, so an operator reading them together can tell which\\n988\\t    item each line is about.\\\"\\\"\\\"\\n989\\t    root = Path(\\\".\\\").resolve()\\n990\\t    if workcopy.on_item_branch(root):\\n991\\t        print(\\\"attavo drive: --all runs from the tenant's checkout, not from an item's working copy\\\",\\n992\\t              file=sys.stderr)\\n993\\t        return 2\\n994\\t    m = read_manifest(root)\\n995\\t    if m is None:\\n996\\t        print(f\\\"attavo drive: no {MANIFEST} at {root}\\\", file=sys.stderr)\\n997\\t        return 2\\n998\\t    try:\\n999\\t        on_origin = workcopy.fetch_origin_items(root)\\n1000\\t    except RuntimeError as exc:\\n1001\\t        print(f\\\"attavo drive: stopped: could not read origin's attavo/* branches: {exc}\\\")\\n1002\\t        return 1\\n1003\\t    have = workcopy.existing_copy_items(root)\\n1004\\t    items = sorted(set(on_origin) | set(have), key=int)\\n1005\\t    if not items:\\n1006\\t        print(\\\"attavo drive: --all found no attavo/<N>-* branch on origin and no ../attavo-worktree-N\\\")\\n1007\\t        return 0\\n1008\\t    merged = workcopy.merged_items(root, m[\\\"paths\\\"][\\\"records\\\"], items)\\n1009\\t    worst = 0\\n1010\\t    for n in items:\\n1011\\t        if n in merged and n not in have:\\n1012\\t            continue\\n1013\\t        run = subprocess.run([sys.executable, str(PRODUCT_ROOT / \\\"bin\\\" / \\\"attavo\\\"), \\\"drive\\\", n],\\n1014\\t                             cwd=str(root), capture_output=True, text=True, check=False)\\n1015\\t        for line in (run.stdout + run.stderr).splitlines():\\n1016\\t            print(f\\\"attavo-worktree-{n}: {line}\\\")\\n1017\\t        worst = max(worst, run.returncode)\\n1018\\t    return worst\\n1019\\t\\n1020\\t\\n1021\\tdef cmd_drive(argv: list[str]) -> int:\\n1022\\t    # Issue #145: Python block-buffers stdout when it is not a tty (a\\n1023\\t    # pipe, e.g. a screen reading this process live), so every line this\\n1024\\t    # prints would otherwise sit unflushed until the process exits.\\n1025\\t    # Line-buffering makes a pipe reader see each line the moment it is\\n1026\\t    # printed, the same as a terminal already does; `attavo worker`\\n1027\\t    # reconfigures its own stdout the same way.\\n1028\\t    cast(io.TextIOWrapper, sys.stdout).reconfigure(line_buffering=True)\\n1029\\t\\n1030\\t    if \\\"--recover\\\" in argv:\\n1031\\t        print(\\\"attavo drive: --recover is gone; a pass recovers a dead or hung invocation \\\"\\n1032\\t              \\\"itself, as soon as the report owes one\\\", file=sys.stderr)\\n1033\\t        return 2\\n1034\\t\\n1035\\t    until_ready = \\\"--until-ready\\\" in argv\\n1036\\t    report = \\\"--report\\\" in argv\\n1037\\t    again_flag = \\\"--again\\\" in argv\\n1038\\t    all_flag = \\\"--all\\\" in argv\\n1039\\t    by: str | None = None\\n1040\\t    positional: list[str] = []\\n1041\\t    i = 0\\n1042\\t    while i < len(argv):\\n1043\\t        if argv[i] == \\\"--by\\\":\\n1044\\t            by = argv[i + 1] if i + 1 < len(argv) else None\\n1045\\t            i += 2\\n1046\\t        else:\\n1047\\t            if not argv[i].startswith(\\\"--\\\"):\\n1048\\t                positional.append(argv[i])\\n1049\\t            i += 1\\n1050\\t    if again_flag and not by:\\n1051\\t        print(\\\"attavo drive: --again requires --by LOGIN\\\", file=sys.stderr)\\n1052\\t        return 2\\n1053\\t    if \\\"--by\\\" in argv and not again_flag:\\n1054\\t        print(\\\"attavo drive: --by is only for --again\\\", file=sys.stderr)\\n1055\\t        return 2\\n1056\\t    again = by if again_flag else None\\n1057\\t\\n1058\\t    if all_flag:\\n1059\\t        if until_ready or report or again_flag or positional:\\n1060\\t            print(\\\"attavo drive: --all runs one pass in every worktree beside this checkout; \\\"\\n1061\\t                  \\\"drop N and every other flag\\\", file=sys.stderr)\\n1062\\t            return 2\\n1063\\t        return _drive_all()\\n1064\\t\\n1065\\t    root = Path(\\\".\\\").resolve()\\n1066\\t    item_id = positional[0] if positional else derive_item_id(root)\\n1067\\t    if not item_id:\\n1068\\t        print(\\\"attavo drive: cannot derive item id; pass N or run on an attavo/N-* branch\\\",\\n1069\\t              file=sys.stderr)\\n1070\\t        return 2\\n1071\\t    m = read_manifest(root)\\n1072\\t    if m is None:\\n1073\\t        print(f\\\"attavo drive: no {MANIFEST} at {root}\\\", file=sys.stderr)\\n1074\\t        return 2\\n1075\\t\\n1076\\t    if report:\\n1077\\t        if until_ready or again_flag:\\n1078\\t            print(\\\"attavo drive: --report reads and does nothing else; drop --until-ready \\\"\\n1079\\t                  \\\"and --again\\\", file=sys.stderr)\\n1080\\t            return 2\\n1081\\t        if not workcopy.on_item_branch(root):\\n1082\\t            copy = workcopy.copy_path(root, item_id)\\n1083\\t            if copy.resolve() in workcopy.registered_copies(root) and copy.is_dir():\\n1084\\t                root = copy\\n1085\\t            else:\\n1086\\t                with workcopy.read_only_copy(root, item_id) as (tree, why):\\n1087\\t                    if tree is None:\\n1088\\t                        print(f\\\"attavo drive: stopped: {why}\\\")\\n1089\\t                        return 1\\n1090\\t                    from attavo.report import drive_report\\n1091\\t                    print(json.dumps(drive_report(tree, m, item_id), indent=2))\\n1092\\t                    return 0\\n1093\\t        os.chdir(root)\\n1094\\t        refusal = fast_forward_to_origin(root, m, item_id)\\n1095\\t        if refusal:\\n1096\\t            print(f\\\"attavo drive: note: {refusal}\\\", file=sys.stderr)\\n1097\\t        from attavo.report import drive_report\\n1098\\t        print(json.dumps(drive_report(root, m, item_id), indent=2))\\n1099\\t        return 0\\n1100\\t\\n1101\\t    if not workcopy.on_item_branch(root):\\n1102\\t        ensured = workcopy.ensure(root, item_id, m[\\\"paths\\\"][\\\"records\\\"])\\n1103\\t        if ensured.path is None:\\n1104\\t            if ensured.refusal is None:\\n1105\\t                print(f\\\"attavo drive: merged: item {item_id} is merged on origin and has no working copy\\\")\\n1106\\t                return 0\\n1107\\t            print(f\\\"attavo drive: stopped: {ensured.refusal}\\\")\\n1108\\t            return 1\\n1109\\t        root = ensured.path\\n1110\\t        os.chdir(root)\\n1111\\t        m = read_manifest(root) or m\\n1112\\t\\n1113\\t    if until_ready:\\n1114\\t        rc = _until_ready(root, m, item_id, again)\\n1115\\t        r = None\\n1116\\t    else:\\n1117\\t        rc, r = _pass_once(root, m, item_id, again)\\n1118\\t    if r is None or r[\\\"state\\\"] == \\\"merged\\\":\\n1119\\t        from attavo.report import drive_report\\n1120\\t        if (r or drive_report(root, m, item_id))[\\\"state\\\"] == \\\"merged\\\":\\n1121\\t            done = workcopy.remove_when_merged(root, item_id, m[\\\"paths\\\"][\\\"records\\\"])\\n1122\\t            if done:\\n1123\\t                print(f\\\"attavo drive: {done}\\\")\\n1124\\t    return rc\\n1125\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"b3f717aa-5c2b-4867-b022-0f24cffb6427\",\"uuid\":\"d1a8352c-4134-4d52-bf5c-475dfcb08a34\",\"timestamp\":\"2026-09-30T23:05:36.304Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/davidbean/Projects/attavo-worktree-289/attest/specs/289/stub/attavo/drive.py\",\"content\":\"from __future__ import annotations\\n\\nimport contextlib\\nimport io\\nimport json\\nimport os\\nimport signal\\nimport shutil\\nimport subprocess\\nimport sys\\nimport tempfile\\nimport threading\\nimport time\\nfrom collections.abc import Callable, Iterator\\nfrom pathlib import Path\\nfrom typing import TYPE_CHECKING, Any, NamedTuple, cast\\n\\nfrom attavo import clock\\nfrom attavo.approval import approval_status\\nfrom attavo.build import cmd_build, driver_identity\\nfrom attavo.common import MANIFEST, PRODUCT_ROOT, derive_item_id, git, read_manifest\\nfrom attavo.counsel import cmd_counsel\\nfrom attavo.doctor import (\\n    _parse_json_line,\\n    attempts_budget,\\n    ceiling_s,\\n    heartbeat_age_s,\\n    heartbeat_path,\\n    heartbeat_pid,\\n    holder_heartbeat_path,\\n    heartbeat_s,\\n    invocation_age_s,\\n    invocations_without_record,\\n    retry_after_s,\\n    stall_bound_s,\\n    write_invocation_marker,\\n)\\nfrom attavo.events import stage_events_dir\\nfrom attavo.filing import cmd_file_stops\\nfrom attavo.records import (\\n    latest_attempt_path,\\n    latest_record,\\n    next_attempt_number,\\n    parse_attempts,\\n    stage_schema,\\n    write_record,\\n)\\nfrom attavo.stops import RETRYABLE_CLASSES, counsel_record_for, signature_of\\nfrom attavo.verify import cmd_verify, read_forge_checks\\nfrom attavo import workcopy\\n\\nif TYPE_CHECKING:\\n    from attavo.types import DriveReport\\n\\n# --- drive: the mechanical transitions between approval and ready-to-merge\\n# (issue #84), under the reconciler's R2 (rulings A, B, C's recovery half,\\n# F, G, H): `attavo drive N` is one short pass. It reads the report\\n# (attavo.report), acts at most once -- recovers a dead or hung\\n# invocation, or starts the next stage in a detached worker -- and\\n# returns within seconds; the stage itself runs in `attavo worker`, a\\n# child of the pass's own session, which outlives it. Writes no record of\\n# its own: the stage records already on disk, and the invocation markers\\n# and heartbeats beside them, are the only state a pass or a worker\\n# reads. ---\\n\\n\\nRECORD_PUSH_TRIES = 5\\n\\n\\nclass TransportRefused(RuntimeError):\\n    \\\"\\\"\\\"A record transport that could not land: the message is the reason,\\n    already worded for the pass or worker that prints it.\\\"\\\"\\\"\\n\\n\\ndef _driver_env() -> dict[str, str]:\\n    identity = driver_identity()\\n    env = dict(os.environ)\\n    env[\\\"GIT_AUTHOR_NAME\\\"] = identity[\\\"name\\\"]\\n    env[\\\"GIT_AUTHOR_EMAIL\\\"] = identity[\\\"email\\\"]\\n    env[\\\"GIT_COMMITTER_NAME\\\"] = identity[\\\"name\\\"]\\n    env[\\\"GIT_COMMITTER_EMAIL\\\"] = identity[\\\"email\\\"]\\n    return env\\n\\n\\ndef _retry_base(root: Path, branch: str) -> str:\\n    \\\"\\\"\\\"The commit a retried record is committed on: origin's branch tip,\\n    fetched now. It must contain this checkout's HEAD -- the stage's own\\n    commits are in it, and a record's `sha` names them -- because the\\n    driver neither merges nor rebases; a tip that does not is a refusal,\\n    with the commits it would strand named by sha and author.\\\"\\\"\\\"\\n    git(root, \\\"fetch\\\", \\\"-q\\\", \\\"origin\\\", branch)\\n    tip = git(root, \\\"rev-parse\\\", \\\"FETCH_HEAD\\\").strip()\\n    contained = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"merge-base\\\", \\\"--is-ancestor\\\", \\\"HEAD\\\", tip],\\n                               capture_output=True, text=True, check=False)\\n    if contained.returncode != 0:\\n        ours = git(root, \\\"log\\\", \\\"--format=%h %an <%ae>\\\", f\\\"{tip}..HEAD\\\").splitlines()\\n        raise TransportRefused(\\n            f\\\"origin's {branch} moved under this checkout's own commits and the driver \\\"\\n            f\\\"neither merges nor rebases them: {'; '.join(ours)}\\\")\\n    return tip\\n\\n\\n@contextlib.contextmanager\\ndef record_worktree(root: Path, tip: str) -> Iterator[Path]:\\n    \\\"\\\"\\\"A detached worktree of `tip` under the git dir, removed on exit:\\n    the only place the driver commits. The item's checkout is the\\n    executor's while a build runs, so nothing the driver writes or\\n    commits, resets or merges is made there.\\\"\\\"\\\"\\n    parent = stage_events_dir(root) / \\\"transport\\\"\\n    parent.mkdir(parents=True, exist_ok=True)\\n    tree = Path(tempfile.mkdtemp(prefix=\\\"tx-\\\", dir=parent)) / \\\"head\\\"\\n    git(root, \\\"worktree\\\", \\\"add\\\", \\\"--detach\\\", \\\"-q\\\", str(tree), tip)\\n    try:\\n        yield tree\\n    finally:\\n        try:\\n            git(root, \\\"worktree\\\", \\\"remove\\\", \\\"--force\\\", str(tree))\\n        except RuntimeError:\\n            shutil.rmtree(tree, ignore_errors=True)\\n            try:\\n                git(root, \\\"worktree\\\", \\\"prune\\\")\\n            except RuntimeError:\\n                pass\\n        shutil.rmtree(tree.parent, ignore_errors=True)\\n\\n\\ndef _record_paths(tree: Path, record_paths: list[Path]) -> list[str]:\\n    \\\"\\\"\\\"Each record's path relative to the tree, and each one's .log and\\n    .filed, each if one exists (issues #89, #100): the paths `git commit\\n    --only` names, so a transport commit never sweeps the index (issue\\n    #46's regression, on the transport side).\\\"\\\"\\\"\\n    paths: list[str] = []\\n    for record_path in record_paths:\\n        paths.append(str(record_path.relative_to(tree)))\\n        for suffix in (\\\".log\\\", \\\".filed\\\"):\\n            extra = record_path.with_suffix(suffix)\\n            if extra.is_file():\\n                paths.append(str(extra.relative_to(tree)))\\n    return paths\\n\\n\\ndef commit_record(tree: Path, record_paths: list[Path], message: str) -> str:\\n    \\\"\\\"\\\"`git commit --only` on the record paths given, in `tree` -- a\\n    record worktree, never the checkout -- as driver_identity(), set by\\n    the product and never the tenant's git config, so a driven item's\\n    record commits are never indistinguishable from an operator's own.\\n    Returns the commit's sha.\\\"\\\"\\\"\\n    paths = _record_paths(tree, record_paths)\\n    git(tree, \\\"add\\\", *paths)\\n    git(tree, \\\"commit\\\", \\\"--only\\\", \\\"-q\\\", \\\"-m\\\", message, *paths, env=_driver_env())\\n    return git(tree, \\\"rev-parse\\\", \\\"HEAD\\\").strip()\\n\\n\\ndef sync_checkout(root: Path, target: str) -> None:\\n    \\\"\\\"\\\"Fast-forward the item's checkout to `target`, the one thing the\\n    driver does to it. A pass in the same directory may hold the index\\n    for a moment, so a lock is retried; a checkout already at or beyond\\n    target is done.\\\"\\\"\\\"\\n    err = \\\"\\\"\\n    for _ in range(20):\\n        run = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"merge\\\", \\\"--ff-only\\\", \\\"-q\\\", target],\\n                             capture_output=True, text=True, check=False)\\n        if run.returncode == 0:\\n            return\\n        err = run.stderr.strip()\\n        contained = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"merge-base\\\", \\\"--is-ancestor\\\", target, \\\"HEAD\\\"],\\n                                   capture_output=True, text=True, check=False)\\n        if contained.returncode == 0:\\n            return\\n        time.sleep(0.1)\\n    raise TransportRefused(f\\\"the checkout could not fast-forward to {target[:12]}: {err}\\\")\\n\\n\\ndef _stage_copies(root: Path, paths: list[str]) -> None:\\n    \\\"\\\"\\\"Stage the checkout's own untracked copies of records the driver\\n    has just committed elsewhere, so the fast-forward that brings the\\n    committed ones in finds them identical to the target and has nothing\\n    to collide with -- and the record is never absent from the checkout,\\n    which is what a pass or a reader beside the worker sees.\\\"\\\"\\\"\\n    if not paths:\\n        return\\n    out = git(root, \\\"ls-files\\\", \\\"--others\\\", \\\"--exclude-standard\\\", \\\"--\\\", *paths).splitlines()\\n    if out:\\n        git(root, \\\"add\\\", \\\"--\\\", *out)\\n\\n\\ndef transport_records(root: Path, branch: str, message: str,\\n                      write: Callable[[Path], list[Path]],\\n                      lease: bool = False) -> tuple[str, str | None]:\\n    \\\"\\\"\\\"Commit records in a detached worktree of the branch's tip and push\\n    them from there as HEAD:branch; then fast-forward the checkout.\\n    `write(tree)` puts the records in the worktree and returns the record\\n    paths to commit -- called again on every try, since a retry starts\\n    from a freshly fetched tip.\\n\\n    The first try commits on this checkout's HEAD, which carries the\\n    stage's own commits. A push origin rejects is retried without a\\n    merge: fetch, recreate the worktree at the new tip (which must\\n    contain HEAD, see _retry_base), write again, push again as a\\n    fast-forward, RECORD_PUSH_TRIES times at most. The record's own `sha` names the\\n    stage's commit, not this transport commit, so moving the transport\\n    commit changes nothing a record names.\\n\\n    lease=True is the marker's push (ruling A): one try, and a race lost\\n    is (\\\"lost-race\\\", stderr) with the worktree discarded and the checkout\\n    untouched. Otherwise (\\\"pushed\\\", None), or (\\\"refused\\\", reason).\\\"\\\"\\\"\\n    err = \\\"\\\"\\n    base = git(root, \\\"rev-parse\\\", \\\"HEAD\\\").strip()\\n    for attempt in range(1 if lease else RECORD_PUSH_TRIES):\\n        if attempt:\\n            try:\\n                base = _retry_base(root, branch)\\n            except TransportRefused as exc:\\n                return \\\"refused\\\", str(exc)\\n            except RuntimeError as exc:\\n                return \\\"refused\\\", f\\\"could not read origin's {branch}: {exc}\\\"\\n        with record_worktree(root, base) as tree:\\n            paths = write(tree)\\n            try:\\n                sha = commit_record(tree, paths, message)\\n            except RuntimeError as exc:\\n                return \\\"refused\\\", f\\\"could not commit: {exc}\\\"\\n            if has_origin(root):\\n                run = subprocess.run([\\\"git\\\", \\\"-C\\\", str(tree), \\\"push\\\", \\\"origin\\\", f\\\"HEAD:{branch}\\\"],\\n                                     capture_output=True, text=True, check=False)\\n                if run.returncode != 0:\\n                    err = run.stderr.strip()\\n                    if lease:\\n                        raced = any(marker in run.stderr for marker in _RACE_MARKERS)\\n                        return (\\\"lost-race\\\" if raced else \\\"refused\\\"), err\\n                    continue\\n            try:\\n                _stage_copies(root, _record_paths(tree, paths))\\n                sync_checkout(root, sha)\\n            except (RuntimeError, TransportRefused) as exc:\\n                return \\\"refused\\\", str(exc)\\n            return \\\"pushed\\\", None\\n    return \\\"refused\\\", f\\\"push rejected {RECORD_PUSH_TRIES} times: {err}\\\"\\n\\n\\n_RACE_MARKERS = (\\\"non-fast-forward\\\", \\\"fetch first\\\", \\\"stale info\\\", \\\"cannot lock ref\\\",\\n                 \\\"failed to update ref\\\")\\n\\n\\ndef has_origin(root: Path) -> bool:\\n    \\\"\\\"\\\"Whether this checkout carries an origin remote at all -- a fixture\\n    or a scratch checkout with none is not a refusal; a pass commits\\n    locally and skips the push, the way recovery always has.\\\"\\\"\\\"\\n    try:\\n        git(root, \\\"remote\\\", \\\"get-url\\\", \\\"origin\\\")\\n        return True\\n    except RuntimeError:\\n        return False\\n\\n\\ndef drive_state(root: Path, m: dict[str, Any], item_id: str) -> tuple[str, str | None, Path]:\\n    \\\"\\\"\\\"(\\\"no-approval\\\" | \\\"build\\\" | \\\"verify\\\" | \\\"ready\\\", detail, records_dir):\\n    the next mechanical step for item_id, read from its latest records\\n    alone. A build only counts as current when it is a pass bound to the\\n    valid approval's own sha; a verify only counts as current when it is a\\n    pass bound to that build's own sha -- the same staleness a re-approval\\n    or a re-build must force, attest's own chain check already enforces\\n    (check_attest_chain), read here rather than re-typed.\\\"\\\"\\\"\\n    records_rel = m[\\\"paths\\\"][\\\"records\\\"]\\n    records_dir = root / records_rel / item_id\\n\\n    status = approval_status(root, m, item_id)\\n    if status != \\\"valid\\\":\\n        return \\\"no-approval\\\", status, records_dir\\n\\n    latest_approval = latest_record(records_dir, \\\"approval\\\")\\n    latest_build = latest_record(records_dir, \\\"build\\\")\\n    build_current = (latest_build is not None and latest_build.get(\\\"status\\\") == \\\"pass\\\"\\n                     and latest_build.get(\\\"approval_sha\\\")\\n                     == (latest_approval.get(\\\"sha\\\") if latest_approval else None))\\n    if latest_build is None or not build_current:\\n        return \\\"build\\\", None, records_dir\\n\\n    latest_verify = latest_record(records_dir, \\\"verify\\\")\\n    verify_current = (latest_verify is not None and latest_verify.get(\\\"status\\\") == \\\"pass\\\"\\n                      and latest_verify.get(\\\"build_sha\\\") == latest_build.get(\\\"sha\\\"))\\n    if not verify_current:\\n        return \\\"verify\\\", None, records_dir\\n\\n    return \\\"ready\\\", None, records_dir\\n\\n\\n# --- the heartbeat (its helpers live in attavo/doctor.py, where proof five\\n# reads it too), the worker log, and the forge-checks handoff: local\\n# facts under the checkout's own git directory (issue #140's precedent),\\n# never committed and never among the paths commit_record ever names. ---\\n\\ndef worker_log_path(root: Path, stage: str, nn: int) -> Path:\\n    return stage_events_dir(root) / f\\\"{stage}-{nn:02d}.worker.log\\\"\\n\\n\\ndef forge_checks_path(root: Path, stage: str, nn: int) -> Path:\\n    return stage_events_dir(root) / f\\\"{stage}-{nn:02d}.forge-checks.json\\\"\\n\\n\\ndef _events_path_for(root: Path, stage: str, nn: int) -> Path | None:\\n    \\\"\\\"\\\"The adapter's own events file for this invocation, under the\\n    checkout's git dir (a worktree's own dir when the checkout is one).\\\"\\\"\\\"\\n    try:\\n        gitdir = Path(git(root, \\\"rev-parse\\\", \\\"--git-dir\\\").strip())\\n    except RuntimeError:\\n        return None\\n    if not gitdir.is_absolute():\\n        gitdir = root / gitdir\\n    path = gitdir / \\\"attavo\\\" / f\\\"{stage}-{nn:02d}.events.jsonl\\\"\\n    return path if path.is_file() else None\\n\\n\\ndef _events_tail(path: Path | None, lines: int = 20) -> tuple[str, str | None]:\\n    \\\"\\\"\\\"(the last lines as a log, the last event's own at).\\\"\\\"\\\"\\n    if path is None:\\n        return \\\"no events file for this invocation\\\\n\\\", None\\n    try:\\n        text = path.read_text()\\n    except OSError:\\n        return \\\"events file unreadable\\\\n\\\", None\\n    tail = text.splitlines()[-lines:]\\n    last_at = None\\n    for line in reversed(tail):\\n        parsed = _parse_json_line(line)\\n        if not isinstance(parsed, dict):\\n            continue\\n        at = parsed.get(\\\"at\\\")\\n        if isinstance(at, str):\\n            last_at = at\\n            break\\n    return \\\"\\\\n\\\".join(tail) + \\\"\\\\n\\\", last_at\\n\\n\\ndef _seconds_since(at: str | None) -> float | None:\\n    from datetime import datetime, timezone\\n    if not at:\\n        return None\\n    try:\\n        then = datetime.strptime(at, \\\"%Y-%m-%dT%H:%M:%SZ\\\").replace(tzinfo=timezone.utc)\\n    except ValueError:\\n        return None\\n    return clock.now() - then.timestamp()\\n\\n\\nclass InvocationReading(NamedTuple):\\n    \\\"\\\"\\\"What one marker with no record reads as, from here and now.\\\"\\\"\\\"\\n    stage: str\\n    nn: int\\n    log: str\\n    last_at: str | None\\n    age: float | None\\n    cls: str  # \\\"running\\\" | \\\"hung\\\" | \\\"died\\\"\\n    bound: str | None = None  # R3: \\\"stall\\\" or \\\"ceiling\\\" when cls is \\\"hung\\\"\\n\\n\\ndef _manifest_of(root: Path) -> dict[str, Any]:\\n    m = read_manifest(root)\\n    return m if m is not None else {}\\n\\n\\ndef _streams_events(root: Path, m: dict[str, Any], stage: str) -> bool:\\n    \\\"\\\"\\\"R3: whether stage's adapter declares it streams events at all\\n    (adapters/<name>/conformance.json, \\\"streams_events\\\") -- one that does\\n    not is judged by its ceiling alone, and never called hung by event\\n    age it never produces. True (the ordinary case) when the adapter\\n    declares nothing, or none is configured to ask.\\\"\\\"\\\"\\n    name = (m.get(\\\"executor\\\") or {}).get(stage) or (m.get(\\\"executor\\\") or {}).get(\\\"build\\\")\\n    if not name:\\n        return True\\n    for base in (root / \\\"attavo\\\" / \\\"adapters\\\", PRODUCT_ROOT / \\\"adapters\\\"):\\n        conf = base / name / \\\"conformance.json\\\"\\n        if conf.is_file():\\n            try:\\n                return bool(json.loads(conf.read_text()).get(\\\"streams_events\\\", True))\\n            except (OSError, ValueError):\\n                return True\\n    return True\\n\\n\\ndef read_invocation(root: Path, bound: int | None, marker: Path, info: dict[str, Any]) -> InvocationReading:\\n    \\\"\\\"\\\"Whether an invocation that began and wrote no record is running,\\n    hung, or died -- read from the heartbeat its holder writes and from\\n    nothing else (root cause 4). A heartbeat fresh within three beats of\\n    ATTAVO_HEARTBEAT_S is a live holder: running, or, with a stall bound\\n    declared and the last event (the marker's own `at` when there is\\n    none) older than it, hung. A stale heartbeat is died, whether or not\\n    any pid lives -- a worker stuck somewhere that never reaches its own\\n    heartbeat loop again is exactly what this is for. The heartbeat is\\n    read where the marker says its holder writes it (holder_heartbeat_path),\\n    never in this checkout by assumption: two checkouts on one host each\\n    keep their own. With no heartbeat file there, a marker from this host\\n    that names no directory is died -- the holder never touched its first\\n    beat, or is gone -- and one from another host, or one naming a\\n    directory with no heartbeat yet, follows the stall bound as proof five\\n    does: running while younger, died after. The stall bound decides\\n    hung, never died.\\n\\n    R3: the stage's own ceiling (wall clock from the marker's own `at`)\\n    is judged first, before any of that -- alive past it is hung by the\\n    ceiling whatever event age says, and an adapter that declares it\\n    streams no events is judged by the ceiling alone: bound is read as\\n    None for it, so the stall check below never fires on an event age it\\n    never had.\\\"\\\"\\\"\\n    import socket\\n    stage, nn_text = marker.stem.rsplit(\\\"-\\\", 1)\\n    nn = int(nn_text)\\n    log, last_at = _events_tail(_events_path_for(root, stage, nn))\\n    m = _manifest_of(root)\\n    ceiling = ceiling_s(m, stage)\\n    since_start = _seconds_since(info.get(\\\"at\\\"))\\n    if ceiling is not None and since_start is not None and since_start > ceiling:\\n        return InvocationReading(stage, nn, log, last_at, since_start, \\\"hung\\\", \\\"ceiling\\\")\\n    stall_bound = bound\\n    if not _streams_events(root, m, stage):\\n        bound = None\\n    beat_file = holder_heartbeat_path(root, info, stage, nn)\\n    beat_age = heartbeat_age_s(beat_file) if beat_file is not None else None\\n    if beat_age is not None:\\n        if beat_age > heartbeat_s() * 3:\\n            return InvocationReading(stage, nn, log, last_at, beat_age, \\\"died\\\")\\n        age = _seconds_since(last_at or info.get(\\\"at\\\"))\\n        if bound is None or age is None or age <= bound:\\n            return InvocationReading(stage, nn, log, last_at, beat_age, \\\"running\\\")\\n        return InvocationReading(stage, nn, log, last_at, age, \\\"hung\\\", \\\"stall\\\")\\n    if info.get(\\\"host\\\") != socket.gethostname() or info.get(\\\"events\\\"):\\n        # No heartbeat to read: another host's, or, from this host, none\\n        # yet where the marker says its holder beats -- another\\n        # checkout's worker that has not reached its first beat. Running\\n        # while younger than the stall bound, as proof five reads it.\\n        marker_age = invocation_age_s(info)\\n        if stall_bound is not None and marker_age is not None and marker_age < stall_bound:\\n            return InvocationReading(stage, nn, log, last_at, marker_age, \\\"running\\\")\\n    return InvocationReading(stage, nn, log, last_at, _seconds_since(last_at or info.get(\\\"at\\\")), \\\"died\\\")\\n\\n\\ndef uncommitted_record(root: Path, records_dir: Path, stage: str) -> Path | None:\\n    \\\"\\\"\\\"The latest <stage>-NN.json this working tree carries that git has\\n    no commit for yet -- the moment between a worker's write and its own\\n    commit. None when the latest record is already committed, or there\\n    is none at all.\\\"\\\"\\\"\\n    path = latest_attempt_path(records_dir, stage)\\n    if path is None or not path.is_file():\\n        return None\\n    status = subprocess.run(\\n        [\\\"git\\\", \\\"-C\\\", str(root), \\\"status\\\", \\\"--porcelain\\\", \\\"--\\\", str(path.relative_to(root))],\\n        capture_output=True, text=True, check=False)\\n    return path if status.stdout.strip() else None\\n\\n\\ndef worker_holds_copy(root: Path, records_dir: Path) -> bool:\\n    \\\"\\\"\\\"True when this checkout's own working tree cannot safely be moved\\n    -- an invocation marker with no record yet (a worker, here or\\n    elsewhere, still holds this attempt), or a build or verify record the\\n    working tree carries that git has not committed yet. Scoped to the\\n    stage records a pass or a worker itself ever transports -- an\\n    operator's own spec-gate or approve, routinely uncommitted between\\n    their own act and the next pass, is not this. A pass never\\n    fast-forwards while this holds (never while a worker holds the\\n    copy).\\\"\\\"\\\"\\n    if invocations_without_record(records_dir):\\n        return True\\n    return (uncommitted_record(root, records_dir, \\\"build\\\") is not None\\n           or uncommitted_record(root, records_dir, \\\"verify\\\") is not None)\\n\\n\\ndef fast_forward_to_origin(root: Path, m: dict[str, Any], item_id: str) -> str | None:\\n    \\\"\\\"\\\"The pass's own read of origin's branch, taken before it reads\\n    anything else -- a commit landed there from elsewhere (an approval\\n    from the screen, a ruling, another pass's own record) is not a race\\n    for the lease, it is exactly what the lease is for. Never while a\\n    worker holds this copy (worker_holds_copy): moving a working tree a\\n    detached child is still writing into would corrupt its own commits.\\n    The checkout only fast-forwards. When it carries commits origin has\\n    not seen (an operator's approval, not yet pushed), the pass does not\\n    replay them: it returns a refusal naming each by sha and author, and\\n    the commits stay where they are. None when the checkout is now at\\n    origin's tip or there is nothing to read; silent about an absent\\n    origin or an unreachable one, which the ordinary read (and the\\n    marker push, for the lease) sort out.\\\"\\\"\\\"\\n    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n    if worker_holds_copy(root, records_dir) or not has_origin(root):\\n        return None\\n    try:\\n        branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n        git(root, \\\"fetch\\\", \\\"origin\\\", branch)\\n    except RuntimeError:\\n        return None\\n    ours = git(root, \\\"log\\\", \\\"--format=%h %an <%ae>\\\", \\\"FETCH_HEAD..HEAD\\\").splitlines()\\n    if not ours:\\n        try:\\n            git(root, \\\"merge\\\", \\\"--ff-only\\\", \\\"FETCH_HEAD\\\")\\n        except RuntimeError:\\n            pass\\n        return None\\n    listed = \\\"; \\\".join(ours)\\n    return (f\\\"this checkout carries {len(ours)} commit(s) origin's {branch} lacks and the pass \\\"\\n            f\\\"does not replay them: {listed}. Push them, or move them, and run the pass again\\\")\\n\\n\\n# --- the worker: a detached child of the pass's own session, running the\\n# stage exactly as the pass used to inline, touching its own heartbeat\\n# while it does (R2). ---\\n\\ndef _stage_body(item_id: str, stage: str, nn: int) -> int:\\n    \\\"\\\"\\\"Runs build or verify in-process -- the same command `attavo build`\\n    or `attavo verify` would run -- while touching heartbeat_path every\\n    heartbeat_s() seconds, then transports whatever it wrote: counsel and\\n    file-stops on a non-pass record (issue #100, #89), one `git commit\\n    --only`, one push with the record push's own merge retry. The\\n    marker is the pass's, already committed and pushed before this\\n    starts; this writes and transports only the stage's own record (and,\\n    on a stop, its counsel record).\\\"\\\"\\\"\\n    root = Path(\\\".\\\").resolve()\\n    m = read_manifest(root)\\n    if m is None:\\n        return 2\\n    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n    before = latest_attempt_path(records_dir, stage)\\n\\n    beat = heartbeat_path(root, stage, nn)\\n    beat.parent.mkdir(parents=True, exist_ok=True)\\n    beat.write_text(f\\\"{os.getpid()}\\\\n\\\")\\n    stop_beat = threading.Event()\\n\\n    def _tick() -> None:\\n        while not stop_beat.wait(heartbeat_s()):\\n            beat.touch()\\n\\n    beat_thread = threading.Thread(target=_tick, daemon=True)\\n    beat_thread.start()\\n    # The heartbeat says the holder is alive, so it runs until the holder\\n    # returns -- through counsel, file-stops, the commit and the push --\\n    # not until the stage command does.\\n    try:\\n        return _run_and_transport(item_id, stage, root, m, records_dir, branch, before)\\n    finally:\\n        stop_beat.set()\\n        beat_thread.join()\\n\\n\\ndef _run_and_transport(item_id: str, stage: str, root: Path, m: dict[str, Any],\\n                       records_dir: Path, branch: str, before: Path | None) -> int:\\n    rc = cmd_build([item_id]) if stage == \\\"build\\\" else cmd_verify([item_id])\\n\\n    after = latest_attempt_path(records_dir, stage)\\n    if after is None or after == before:\\n        # Refused before writing anything at all (e.g. no adapter\\n        # configured) -- the stage command already printed why.\\n        return rc if rc != 0 else 1\\n\\n    record = cast(dict[str, Any], latest_record(records_dir, stage))\\n    status_out = record.get(\\\"status\\\")\\n    to_commit = [after]\\n    if status_out != \\\"pass\\\":\\n        stop = record.get(\\\"stop\\\") or {}\\n        state = retry_state(root, m, records_dir, stage, stop.get(\\\"class\\\"),\\n                            int(after.stem.rsplit(\\\"-\\\", 1)[1]))\\n        # R3: a stop the next plain pass would already retry -- now, or\\n        # once its transient wait elapses -- asks counsel nothing and\\n        # files nothing (#194's own verify-01, replayed as this item's\\n        # rejection fixture, paid for exactly this on a vendor's own\\n        # capacity error). Counsel reads it, as before, the moment that\\n        # is no longer true: the budget is spent, the early stop fired,\\n        # or the class was never a plain retry's to begin with.\\n        if not (state.eligible or state.waiting_s is not None):\\n            counsel_before = latest_attempt_path(records_dir, \\\"counsel\\\")\\n            cmd_counsel([item_id])\\n            counsel_after = latest_attempt_path(records_dir, \\\"counsel\\\")\\n            if counsel_after is not None and counsel_after != counsel_before:\\n                to_commit.append(counsel_after)\\n            # file-stops is its own idempotent read of the item's records,\\n            # so calling it here on every run that wrote a non-pass record\\n            # is safe to call again on a later run: an already-filed\\n            # stop's own marker is what stops it from being filed twice.\\n            cmd_file_stops([item_id])\\n\\n    message = f\\\"attavo: {stage} record for item {item_id} ({after.stem})\\\"\\n\\n    def copy_in(tree: Path) -> list[Path]:\\n        # The stage command wrote the records in this checkout, untracked;\\n        # they are committed from the detached worktree and the checkout's\\n        # copies become the committed ones when the checkout fast-forwards\\n        # (transport_records).\\n        copied: list[Path] = []\\n        for record_path in to_commit:\\n            for src in (record_path, record_path.with_suffix(\\\".log\\\"), record_path.with_suffix(\\\".filed\\\")):\\n                if src.is_file():\\n                    dest = tree / src.relative_to(root)\\n                    dest.parent.mkdir(parents=True, exist_ok=True)\\n                    shutil.copyfile(src, dest)\\n            copied.append(tree / record_path.relative_to(root))\\n        return copied\\n\\n    outcome, err = transport_records(root, branch, message, copy_in)\\n    if outcome != \\\"pushed\\\":\\n        print(f\\\"attavo drive: stopped: could not push the {stage} record: {err}\\\")\\n        return 1\\n    if not has_origin(root):\\n        print(f\\\"attavo drive: note: no origin remote; {after.name} is committed, not pushed\\\")\\n\\n    if status_out == \\\"halted\\\":\\n        question = (record.get(\\\"halted\\\") or {}).get(\\\"question\\\")\\n        print(f\\\"attavo drive: stopped: {stage} halted: {question} ({after.name}); \\\"\\n              f\\\"pushed to {branch}\\\")\\n    elif status_out != \\\"pass\\\":\\n        reason = record.get(\\\"refusal\\\") or status_out\\n        print(f\\\"attavo drive: stopped: {stage} {status_out}: {reason} ({after.name}); \\\"\\n              f\\\"pushed to {branch}\\\")\\n    else:\\n        print(f\\\"attavo drive: pushed {after.name} to {branch}\\\")\\n    return rc\\n\\n\\ndef cmd_worker(argv: list[str]) -> int:\\n    \\\"\\\"\\\"`attavo worker N <build|verify> NN`: the detached child a pass\\n    starts once its marker is pushed -- the lease held, the attempt is\\n    this worker's to run. Its own session (start_new_session, set by the\\n    pass that spawns it); its stdout and stderr are the pass's own\\n    redirect, to <git-dir>/attavo/<stage>-NN.worker.log.\\\"\\\"\\\"\\n    cast(io.TextIOWrapper, sys.stdout).reconfigure(line_buffering=True)\\n    if len(argv) != 3:\\n        print(\\\"attavo worker: usage: attavo worker N <build|verify> NN\\\", file=sys.stderr)\\n        return 2\\n    item_id, stage, nn_text = argv\\n    if stage not in (\\\"build\\\", \\\"verify\\\"):\\n        print(f\\\"attavo worker: {stage!r} is not build or verify\\\", file=sys.stderr)\\n        return 2\\n    try:\\n        nn = int(nn_text)\\n    except ValueError:\\n        print(f\\\"attavo worker: {nn_text!r} is not an attempt number\\\", file=sys.stderr)\\n        return 2\\n    return _stage_body(item_id, stage, nn)\\n\\n\\n# --- the pass's own two acts: start a stage (the lease), and recover\\n# exactly the one invocation the report names owed one. ---\\n\\ndef _start_stage(root: Path, m: dict[str, Any], item_id: str, stage: str,\\n                 forge_checks: dict[str, Any] | None, again_by: str | None = None) -> int:\\n    \\\"\\\"\\\"The lease (ruling A): the marker, committed and pushed as a plain\\n    fast-forward with no merge and no retry, made and pushed from a\\n    detached worktree (transport_records). Lost to another pass, or\\n    refused outright by the remote, the worktree is discarded and this\\n    checkout was never touched; only a pushed lease starts the worker. On a\\n    review, forge_checks is the checks this same pass already read on\\n    the pre-marker head (ruling B) -- written to\\n    <git-dir>/attavo/verify-NN.forge-checks.json and named in\\n    ATTAVO_FORGE_CHECKS, so the worker's own `attavo verify` reads it\\n    instead of polling. again_by (R3) is the login that pressed `--again`, set\\n    only when it is what started this attempt, past a budget already spent\\n    or an early stop -- named in the marker, never on an ordinary or\\n    plainly-retried attempt.\\\"\\\"\\\"\\n    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n    nn = next_attempt_number(records_dir, stage)\\n    marker = records_dir / f\\\"{stage}-{nn:02d}.started\\\"\\n\\n    def write_marker(tree: Path) -> list[Path]:\\n        return [write_invocation_marker(tree, tree / records_dir.relative_to(root), stage, nn,\\n                                        again_by=again_by, events_dir=stage_events_dir(root))]\\n\\n    outcome, err = transport_records(\\n        root, branch, f\\\"attavo: {stage} invocation {nn:02d} started for item {item_id}\\\",\\n        write_marker, lease=True)\\n    if outcome == \\\"lost-race\\\":\\n        print(f\\\"attavo drive: another pass holds this attempt ({marker.name}); nothing started\\\")\\n        return 0\\n    if outcome != \\\"pushed\\\":\\n        print(f\\\"attavo drive: stopped: could not push the {stage} invocation marker: {err}\\\")\\n        return 1\\n\\n    env = dict(os.environ)\\n    if forge_checks is not None:\\n        checks_file = forge_checks_path(root, stage, nn)\\n        checks_file.write_text(json.dumps(forge_checks))\\n        env[\\\"ATTAVO_FORGE_CHECKS\\\"] = str(checks_file)\\n    log = worker_log_path(root, stage, nn)\\n    with log.open(\\\"ab\\\") as fh, open(os.devnull, \\\"rb\\\") as devnull:\\n        proc = subprocess.Popen(\\n            [sys.executable, str(PRODUCT_ROOT / \\\"bin\\\" / \\\"attavo\\\"), \\\"worker\\\", item_id, stage, f\\\"{nn:02d}\\\"],\\n            cwd=str(root), env=env, stdin=devnull, stdout=fh, stderr=subprocess.STDOUT,\\n            start_new_session=True)\\n    word = \\\"Build\\\" if stage == \\\"build\\\" else \\\"Review\\\"\\n    print(f\\\"attavo drive: {word} started (attempt {nn:02d}, worker pid {proc.pid})\\\")\\n    return 0\\n\\n\\ndef _recover_one(root: Path, m: dict[str, Any], item_id: str, records_dir: Path) -> int:\\n    \\\"\\\"\\\"The pass's own recovery act (what `--recover` did): exactly the one\\n    invocation the report just read as owing one -- died or hung -- ends\\n    here. class died when the heartbeat is stale or absent, class hung\\n    when the heartbeat is fresh and a declared [drive].stall_after_s has\\n    passed with no newer event (or the stage's ceiling has passed), the\\n    holder terminated by the pid its own heartbeat names. Provenance product; the events tail as the log. Committed\\n    and pushed the way any stage record is (transport_records, with its\\n    retry that never merges) -- this is not a race for a lease, since no new\\n    attempt marker is written.\\\"\\\"\\\"\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n    bound = stall_bound_s(m)\\n    pending = invocations_without_record(records_dir)\\n    readings = [(marker, info, read_invocation(root, bound, marker, info)) for marker, info in pending]\\n    candidate = next(((mk, i, rd) for mk, i, rd in readings if rd.cls != \\\"running\\\"), None)\\n    if candidate is None:\\n        # The report read this a moment ago; nothing owed recovery by the\\n        # time this pass got here (another pass recovered it, or it\\n        # finished on its own).\\n        return 0\\n    marker, info, reading = candidate\\n    stage, nn, log, last_at, age, cls, crossed = reading\\n    host = info.get(\\\"host\\\")\\n\\n    if next_attempt_number(records_dir, stage) != nn:\\n        print(f\\\"attavo drive: stopped: {marker.name} names attempt {nn} but the next \\\"\\n              f\\\"{stage} record would be {next_attempt_number(records_dir, stage):02d}; \\\"\\n              f\\\"a later record already exists, read the records before recovering\\\")\\n        return 1\\n\\n    if cls == \\\"hung\\\":\\n        holder_file = holder_heartbeat_path(root, info, stage, nn)\\n        holder = heartbeat_pid(holder_file) if holder_file is not None else None\\n        if holder is None:\\n            print(f\\\"attavo drive: no holder to signal for {marker.stem}: its heartbeat names no pid\\\")\\n            ended = \\\"no holder to signal\\\"\\n            who = f\\\"no holder on {host}\\\"\\n        else:\\n            who = f\\\"pid {holder} on {host} alive\\\"\\n            try:\\n                os.kill(holder, signal.SIGTERM)\\n                ended = \\\"terminated\\\"\\n            except OSError as exc:\\n                ended = f\\\"not terminated ({exc})\\\"\\n        if crossed == \\\"ceiling\\\":\\n            detail = (f\\\"{who} {int(cast(float, age))} s after its marker, \\\"\\n                      f\\\"past the {stage} ceiling of {ceiling_s(m, stage)} s; {ended}\\\")\\n        else:\\n            detail = (f\\\"{who} with no event for {int(cast(float, age))} s \\\"\\n                      f\\\"(bound {bound} s); {ended}\\\")\\n    else:\\n        detail = (f\\\"{marker.stem} on {host} has no live heartbeat and wrote no {marker.stem}.json; \\\"\\n                  f\\\"started {info.get('at')}, last event {last_at or 'none'}\\\")\\n\\n    signature_text = log.strip().splitlines()[-1] if log.strip() else detail\\n\\n    schema = stage_schema(stage)\\n    record: dict[str, Any] = {k: None for k in schema.get(\\\"required\\\", [])}\\n    approval = latest_record(records_dir, \\\"approval\\\")\\n    record.update({\\\"sha\\\": info.get(\\\"sha\\\"), \\\"start_sha\\\": info.get(\\\"sha\\\"),\\n                   \\\"approval_sha\\\": approval.get(\\\"sha\\\") if approval else None,\\n                   \\\"at\\\": info.get(\\\"at\\\"),\\n                   \\\"adapter\\\": (m.get(\\\"executor\\\") or {}).get(stage),\\n                   \\\"status\\\": \\\"failed\\\", \\\"refusal\\\": None, \\\"halted\\\": None,\\n                   \\\"retry_of\\\": None, \\\"steer\\\": None,\\n                   \\\"stop\\\": {\\\"class\\\": cls, \\\"provenance\\\": \\\"product\\\", \\\"detail\\\": detail,\\n                            \\\"signature\\\": signature_of(signature_text), \\\"bound\\\": crossed}})\\n    if \\\"wall_clock_s\\\" in record:\\n        record[\\\"wall_clock_s\\\"] = None if age is None else int(age)\\n    record = {k: v for k, v in record.items() if k in schema.get(\\\"properties\\\", {})}\\n    tree_records = records_dir.relative_to(root)\\n\\n    def write_recovered(tree: Path) -> list[Path]:\\n        return [write_record(tree / tree_records, stage, record, m, item_id, log=log)]\\n\\n    message = (f\\\"attavo: {stage} record for item {item_id} \\\"\\n               f\\\"({stage}-{nn:02d}), recovered as {cls}\\\")\\n    try:\\n        outcome, err = transport_records(root, branch, message, write_recovered)\\n    except ValueError as exc:\\n        print(f\\\"attavo drive: stopped: could not write the {cls} record for {marker.stem}: {exc}\\\")\\n        return 1\\n    if outcome != \\\"pushed\\\":\\n        print(f\\\"attavo drive: stopped: could not push the {cls} record: {err}\\\")\\n        return 1\\n    if not has_origin(root):\\n        print(f\\\"attavo drive: note: no origin remote; {stage}-{nn:02d}.json is committed, not pushed\\\")\\n    print(f\\\"attavo drive: recovered {marker.stem} as {cls}: {detail}\\\")\\n    return 0\\n\\n\\ndef _advance_again(root: Path, m: dict[str, Any], item_id: str, stage: str, head: str | None,\\n                   again_by: str | None = None) -> int:\\n    \\\"\\\"\\\"The next attempt of a stopped stage, bypassing the level a plain\\n    pass leaves alone for the operator: what a plain retry (R3, inside\\n    the budget) starts on its own, and what `--again` starts by force\\n    once the budget is spent or an early stop fired. A review reads the\\n    forge fresh here -- once, since the report's own stopped reading\\n    never touched it -- rather than reusing a read that was never taken.\\\"\\\"\\\"\\n    if stage == \\\"build\\\":\\n        return _start_stage(root, m, item_id, \\\"build\\\", None, again_by=again_by)\\n    checks_command = (m.get(\\\"forge\\\") or {}).get(\\\"checks_command\\\")\\n    if not checks_command:\\n        print(\\\"attavo drive: refused: no [forge].checks_command in the manifest\\\")\\n        return 1\\n    forge_checks, ok = read_forge_checks(root, checks_command, cast(str, head))\\n    if not ok:\\n        conclusions = forge_checks[\\\"conclusions\\\"]\\n        named = \\\", \\\".join(f\\\"{c['name']} {c['conclusion']}\\\" for c in conclusions) or \\\"no checks reported\\\"\\n        print(f\\\"attavo drive: forge checks not green on {cast(str, head)[:12]}: {named}\\\")\\n        return 0\\n    return _start_stage(root, m, item_id, \\\"verify\\\", forge_checks, again_by=again_by)\\n\\n\\n# --- R3: the retry decision, shared by the report's own kind/says and the\\n# pass's own act (retry_state) so the two cannot drift. ---\\n\\n# Never retried by this item, whatever counsel might rule: a\\n# claims-boundary stop is a person's; a tenant's gate refusal is the\\n# spec-gate's own, earlier than any of this; an environment refusal is\\n# recorded here and acted on by R4's breaker. A question is not in this\\n# tuple -- counsel reads it exactly like any other non-pass record, and\\n# an \\\"answer\\\" verdict starts the next attempt steered by it, the same as\\n# any class counsel can rule on; a question nobody answers (no counsel\\n# configured, or its own verdict is \\\"person\\\") simply never becomes\\n# eligible, with no exclusion needed to keep it that way.\\nNEVER_RETRIED_CLASSES = (\\\"claims-boundary\\\", \\\"gate\\\", \\\"environment\\\")\\n\\n\\ndef _budget_stage(stage: str, stop_class: str | None) -> str:\\n    \\\"\\\"\\\"The stage whose [drive].attempts budget a stop spends -- build for\\n    a returned review (the check rejection or the blocking finding is the\\n    build's to answer, never the review's own to repeat), the stop's own\\n    stage for everything else.\\\"\\\"\\\"\\n    return \\\"build\\\" if stop_class == \\\"returned\\\" else stage\\n\\n\\ndef _signatures_match(records_dir: Path, stage: str) -> bool:\\n    \\\"\\\"\\\"Whether the last two attempts of stage carry the identical,\\n    non-null signature -- the early stop (R3): two attempts of one stage\\n    ending the same way spend no third.\\\"\\\"\\\"\\n    attempts = parse_attempts(records_dir, stage)\\n    if len(attempts) < 2:\\n        return False\\n    nums = sorted(attempts)\\n    sig_a = (attempts[nums[-1]].get(\\\"stop\\\") or {}).get(\\\"signature\\\")\\n    sig_b = (attempts[nums[-2]].get(\\\"stop\\\") or {}).get(\\\"signature\\\")\\n    return sig_a is not None and sig_a == sig_b\\n\\n\\nclass RetryState(NamedTuple):\\n    \\\"\\\"\\\"Whether a plain pass, right now, would start the next attempt of a\\n    stopped stage (R3) -- eligible; a transient stop still short of\\n    [drive].retry_after_s carries waiting_s instead, eligible for neither\\n    a plain pass nor `--again`'s own no-op read of the same fact; steer\\n    names the counsel record an \\\"answer\\\" verdict would hand the next\\n    attempt; target_stage is the stage the next attempt actually starts\\n    (build, for a returned review).\\\"\\\"\\\"\\n    eligible: bool\\n    waiting_s: float | None\\n    steer: str | None\\n    target_stage: str\\n\\n\\ndef retry_state(root: Path, m: dict[str, Any], records_dir: Path, stage: str,\\n                stop_class: str | None, attempt: int | None) -> RetryState:\\n    \\\"\\\"\\\"The one read behind both the report's own kind/says (a stopped\\n    stage that would retry reads as \\\"acts\\\" or \\\"waits\\\", never \\\"yours\\\") and\\n    the pass's own act, so the two cannot say different things about the\\n    same stop. died, hung, transient, and returned retry with no counsel\\n    asked, inside the shared budget and past the early stop; every other\\n    class retries only when counsel's own verdict for this exact stop is\\n    \\\"answer\\\" -- and never when the class is one of NEVER_RETRIED_CLASSES,\\n    whatever counsel might have said.\\\"\\\"\\\"\\n    target_stage = _budget_stage(stage, stop_class)\\n    if stop_class is None or stop_class in NEVER_RETRIED_CLASSES or attempt is None:\\n        return RetryState(False, None, None, target_stage)\\n    spent = next_attempt_number(records_dir, target_stage) - 1\\n    if spent >= attempts_budget(m):\\n        return RetryState(False, None, None, target_stage)\\n    if _signatures_match(records_dir, stage):\\n        return RetryState(False, None, None, target_stage)\\n    if stop_class in RETRYABLE_CLASSES:\\n        if stop_class == \\\"transient\\\":\\n            attempts = parse_attempts(records_dir, stage)\\n            rec = attempts.get(attempt)\\n            age = _seconds_since(rec.get(\\\"at\\\")) if rec else None\\n            wait = retry_after_s(m)\\n            if age is not None and age < wait:\\n                return RetryState(False, wait - age, None, target_stage)\\n        return RetryState(True, None, None, target_stage)\\n    counsel = counsel_record_for(records_dir, stage, attempt)\\n    if counsel is not None and counsel.get(\\\"verdict\\\") == \\\"answer\\\":\\n        target = f\\\"{stage}-{attempt:02d}\\\"\\n        counsel_attempts = parse_attempts(records_dir, \\\"counsel\\\")\\n        matches = [n for n, rec in counsel_attempts.items() if rec.get(\\\"record\\\") == target]\\n        if matches:\\n            return RetryState(True, None, f\\\"counsel-{max(matches):02d}\\\", target_stage)\\n    return RetryState(False, None, None, target_stage)\\n\\n\\ndef _pass_once(root: Path, m: dict[str, Any], item_id: str, again: str | None) -> tuple[int, \\\"DriveReport\\\"]:\\n    \\\"\\\"\\\"One pass: fast-forward to origin (never while a worker holds the\\n    copy), read the report, act at most once, return. owes-recovery\\n    recovers; next-build and next-review start their stage, handing a\\n    review the checks the report already read once on the pre-marker\\n    head; blocked-on-checks on a review (R3) starts it too -- the same\\n    act as next-review, since a concluded red check on a passed build's\\n    head is now a returned record, not a level a pass leaves alone. A\\n    stopped stage inside its budget (RetryState.eligible) retries itself,\\n    with no flag needed; `--again` is a no-op that says so when the plain\\n    mechanism would already act or is only waiting out retry_after_s, and\\n    forces the next attempt, naming who pressed it as again_by in its marker, when it would\\n    not. Every other level is printed in the report's own words and left.\\\"\\\"\\\"\\n    from attavo.report import drive_report\\n    refusal = fast_forward_to_origin(root, m, item_id)\\n    r = drive_report(root, m, item_id)\\n    if refusal:\\n        print(f\\\"attavo drive: stopped: {refusal}\\\")\\n        return 1, r\\n    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n\\n    if r[\\\"state\\\"] == \\\"owes-recovery\\\":\\n        return _recover_one(root, m, item_id, records_dir), r\\n    if r[\\\"state\\\"] == \\\"next-build\\\":\\n        return _start_stage(root, m, item_id, \\\"build\\\", None), r\\n    if r[\\\"state\\\"] in (\\\"next-review\\\", \\\"blocked-on-checks\\\") and r[\\\"stage\\\"] == \\\"verify\\\":\\n        checks_command = (m.get(\\\"forge\\\") or {}).get(\\\"checks_command\\\")\\n        forge_checks = {\\\"command\\\": checks_command, \\\"sha\\\": r[\\\"head\\\"], \\\"conclusions\\\": r[\\\"checks\\\"] or []}\\n        return _start_stage(root, m, item_id, \\\"verify\\\", forge_checks), r\\n    if r[\\\"state\\\"] == \\\"stopped\\\" and r[\\\"stage\\\"]:\\n        state = retry_state(root, m, records_dir, r[\\\"stage\\\"], r[\\\"stop_class\\\"], r[\\\"attempt\\\"])\\n        if again:\\n            if state.eligible or state.waiting_s is not None:\\n                print(\\\"attavo drive: --again inside the budget is a no-op; the pass retries \\\"\\n                      \\\"on its own\\\")\\n                return 0, r\\n            return _advance_again(root, m, item_id, state.target_stage, r[\\\"head\\\"], again_by=again), r\\n        if state.eligible:\\n            return _advance_again(root, m, item_id, state.target_stage, r[\\\"head\\\"]), r\\n\\n    print(f\\\"attavo drive: {r['says']}\\\")\\n    return (1 if r[\\\"state\\\"] == \\\"refused\\\" else 0), r\\n\\n\\n_TERMINAL_STATES = (\\\"waiting-on-approval\\\", \\\"stopped\\\", \\\"ready-to-merge\\\", \\\"merged\\\")\\n\\n\\ndef _until_ready(root: Path, m: dict[str, Any], item_id: str, again: str | None) -> int:\\n    \\\"\\\"\\\"--until-ready: the pass, repeated in one process, sleeping\\n    ATTAVO_DRIVE_POLL_INTERVAL_S between passes, until the level is the\\n    operator's or done (exit 0), a concluded check is red (exit 1), or\\n    an unconcluded one has not concluded within ATTAVO_DRIVE_POLL_BOUND_S\\n    (exit 1). A stage running in its own worker is not bounded by this --\\n    only time spent waiting on the forge is.\\\"\\\"\\\"\\n    from attavo.verify import drive_forge_poll_bound_s, drive_forge_poll_interval_s\\n    bound = drive_forge_poll_bound_s()\\n    interval = drive_forge_poll_interval_s()\\n    waiting_since: float | None = None\\n    while True:\\n        rc, r = _pass_once(root, m, item_id, again)\\n        state = r[\\\"state\\\"]\\n\\n        if state == \\\"waiting-on-checks\\\":\\n            if waiting_since is None:\\n                waiting_since = time.monotonic()\\n            elif time.monotonic() - waiting_since >= bound:\\n                print(f\\\"attavo drive: stopped: the checks did not conclude within {bound:.0f}s\\\")\\n                return 1\\n        else:\\n            waiting_since = None\\n\\n        if rc != 0:\\n            return rc\\n        # R3: \\\"stopped\\\" is terminal only when the pass actually left it\\n        # alone -- kind \\\"acts\\\" or \\\"waits\\\" means this same pass just\\n        # retried it (or is only waiting out retry_after_s), and the loop\\n        # must keep going rather than call that done.\\n        if state in _TERMINAL_STATES and not (state == \\\"stopped\\\" and r[\\\"kind\\\"] != \\\"yours\\\"):\\n            return 0\\n        # R3: blocked-on-checks on a review is no longer a dead end -- the\\n        # pass just converted it into a returned record and, inside its\\n        # budget, a build retry follows on its own. Only the post-verify\\n        # case (the checks went red after a passing review, stage None)\\n        # is still the level with nothing left to do but give up.\\n        if state == \\\"blocked-on-checks\\\" and r[\\\"stage\\\"] is None:\\n            return 1\\n        time.sleep(interval)\\n\\n\\ndef _drive_all() -> int:\\n    \\\"\\\"\\\"--all, from the tenant's checkout: one pass, in its own process\\n    (`attavo drive N`, which ensures the working copy), for every origin\\n    attavo/<N>-* branch whose item is not merged, and one for every\\n    existing ../attavo-worktree-N whose item is merged, to remove it.\\n    Every line either prints is prefixed with the working copy's own\\n    directory name, so an operator reading them together can tell which\\n    item each line is about.\\\"\\\"\\\"\\n    root = Path(\\\".\\\").resolve()\\n    if workcopy.on_item_branch(root):\\n        print(\\\"attavo drive: --all runs from the tenant's checkout, not from an item's working copy\\\",\\n              file=sys.stderr)\\n        return 2\\n    m = read_manifest(root)\\n    if m is None:\\n        print(f\\\"attavo drive: no {MANIFEST} at {root}\\\", file=sys.stderr)\\n        return 2\\n    try:\\n        on_origin = workcopy.fetch_origin_items(root)\\n    except RuntimeError as exc:\\n        print(f\\\"attavo drive: stopped: could not read origin's attavo/* branches: {exc}\\\")\\n        return 1\\n    have = workcopy.existing_copy_items(root)\\n    items = sorted(set(on_origin) | set(have), key=int)\\n    if not items:\\n        print(\\\"attavo drive: --all found no attavo/<N>-* branch on origin and no ../attavo-worktree-N\\\")\\n        return 0\\n    merged = workcopy.merged_items(root, m[\\\"paths\\\"][\\\"records\\\"], items)\\n    worst = 0\\n    for n in items:\\n        if n in merged and n not in have:\\n            continue\\n        run = subprocess.run([sys.executable, str(PRODUCT_ROOT / \\\"bin\\\" / \\\"attavo\\\"), \\\"drive\\\", n],\\n                             cwd=str(root), capture_output=True, text=True, check=False)\\n        for line in (run.stdout + run.stderr).splitlines():\\n            print(f\\\"attavo-worktree-{n}: {line}\\\")\\n        worst = max(worst, run.returncode)\\n    return worst\\n\\n\\ndef cmd_drive(argv: list[str]) -> int:\\n    # Issue #145: Python block-buffers stdout when it is not a tty (a\\n    # pipe, e.g. a screen reading this process live), so every line this\\n    # prints would otherwise sit unflushed until the process exits.\\n    # Line-buffering makes a pipe reader see each line the moment it is\\n    # printed, the same as a terminal already does; `attavo worker`\\n    # reconfigures its own stdout the same way.\\n    cast(io.TextIOWrapper, sys.stdout).reconfigure(line_buffering=True)\\n\\n    if \\\"--recover\\\" in argv:\\n        print(\\\"attavo drive: --recover is gone; a pass recovers a dead or hung invocation \\\"\\n              \\\"itself, as soon as the report owes one\\\", file=sys.stderr)\\n        return 2\\n\\n    until_ready = \\\"--until-ready\\\" in argv\\n    report = \\\"--report\\\" in argv\\n    again_flag = \\\"--again\\\" in argv\\n    all_flag = \\\"--all\\\" in argv\\n    by: str | None = None\\n    positional: list[str] = []\\n    i = 0\\n    while i < len(argv):\\n        if argv[i] == \\\"--by\\\":\\n            by = argv[i + 1] if i + 1 < len(argv) else None\\n            i += 2\\n        else:\\n            if not argv[i].startswith(\\\"--\\\"):\\n                positional.append(argv[i])\\n            i += 1\\n    if again_flag and not by:\\n        print(\\\"attavo drive: --again requires --by LOGIN\\\", file=sys.stderr)\\n        return 2\\n    if \\\"--by\\\" in argv and not again_flag:\\n        print(\\\"attavo drive: --by is only for --again\\\", file=sys.stderr)\\n        return 2\\n    again = by if again_flag else None\\n\\n    if all_flag:\\n        if until_ready or report or again_flag or positional:\\n            print(\\\"attavo drive: --all runs one pass in every worktree beside this checkout; \\\"\\n                  \\\"drop N and every other flag\\\", file=sys.stderr)\\n            return 2\\n        return _drive_all()\\n\\n    root = Path(\\\".\\\").resolve()\\n    item_id = positional[0] if positional else derive_item_id(root)\\n    if not item_id:\\n        print(\\\"attavo drive: cannot derive item id; pass N or run on an attavo/N-* branch\\\",\\n              file=sys.stderr)\\n        return 2\\n    m = read_manifest(root)\\n    if m is None:\\n        print(f\\\"attavo drive: no {MANIFEST} at {root}\\\", file=sys.stderr)\\n        return 2\\n\\n    if report:\\n        if until_ready or again_flag:\\n            print(\\\"attavo drive: --report reads and does nothing else; drop --until-ready \\\"\\n                  \\\"and --again\\\", file=sys.stderr)\\n            return 2\\n        if not workcopy.on_item_branch(root):\\n            copy = workcopy.copy_path(root, item_id)\\n            if copy.resolve() in workcopy.registered_copies(root) and copy.is_dir():\\n                root = copy\\n            else:\\n                with workcopy.read_only_copy(root, item_id) as (tree, why):\\n                    if tree is None:\\n                        print(f\\\"attavo drive: stopped: {why}\\\")\\n                        return 1\\n                    from attavo.report import drive_report\\n                    print(json.dumps(drive_report(tree, m, item_id), indent=2))\\n                    return 0\\n        os.chdir(root)\\n        refusal = fast_forward_to_origin(root, m, item_id)\\n        if refusal:\\n            print(f\\\"attavo drive: note: {refusal}\\\", file=sys.stderr)\\n        from attavo.report import drive_report\\n        print(json.dumps(drive_report(root, m, item_id), indent=2))\\n        return 0\\n\\n    if not workcopy.on_item_branch(root):\\n        ensured = workcopy.ensure(root, item_id, m[\\\"paths\\\"][\\\"records\\\"])\\n        if ensured.path is None:\\n            if ensured.refusal is None:\\n                print(f\\\"attavo drive: merged: item {item_id} is merged on origin and has no working copy\\\")\\n                return 0\\n            print(f\\\"attavo drive: stopped: {ensured.refusal}\\\")\\n            return 1\\n        root = ensured.path\\n        os.chdir(root)\\n        m = read_manifest(root) or m\\n\\n    if until_ready:\\n        rc = _until_ready(root, m, item_id, again)\\n        r = None\\n    else:\\n        rc, r = _pass_once(root, m, item_id, again)\\n    if r is None or r[\\\"state\\\"] == \\\"merged\\\":\\n        from attavo.report import drive_report\\n        if (r or drive_report(root, m, item_id))[\\\"state\\\"] == \\\"merged\\\":\\n            done = workcopy.remove_when_merged(root, item_id, m[\\\"paths\\\"][\\\"records\\\"])\\n            if done:\\n                print(f\\\"attavo drive: {done}\\\")\\n    return rc\\n\",\"numLines\":1125,\"startLine\":1,\"totalLines\":1125}}}\n{\"type\":\"assistant\",\"message\":{\"model\":\"claude-sonnet-5\",\"id\":\"msg_011CfaTjPaFfFwFQd4znhCnb\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_01Bh8tC3eEAou9bTqyPXCKCz\",\"name\":\"Read\",\"input\":{\"file_path\":\"/Users/davidbean/Projects/attavo-worktree-289/attavo/doctor.py\"},\"caller\":{\"type\":\"direct\"}}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":476,\"cache_read_input_tokens\":28750,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":476},\"output_tokens\":8,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"b3f717aa-5c2b-4867-b022-0f24cffb6427\",\"uuid\":\"b4ab3f67-63d3-4216-94e1-6337c13746dd\",\"timestamp\":\"2026-09-30T23:05:36.565Z\",\"request_id\":\"req_011CfaTjPEB7XuMWpQbXJnCr\",\"wire_tool_inputs\":{\"toolu_01Bh8tC3eEAou9bTqyPXCKCz\":{\"file_path\":\"/Users/davidbean/Projects/attavo-worktree-289/attavo/doctor.py\"}}}\n{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01Bh8tC3eEAou9bTqyPXCKCz\",\"type\":\"tool_result\",\"content\":\"1\\tfrom __future__ import annotations\\n2\\t\\n3\\timport fnmatch\\n4\\timport json\\n5\\timport os\\n6\\timport re\\n7\\timport subprocess\\n8\\tfrom pathlib import Path\\n9\\tfrom typing import Any\\n10\\t\\n11\\tfrom attavo import clock\\n12\\tfrom attavo.attest import check_attest_chain, item_time_and_cost\\n13\\tfrom attavo.build import build_is_empty, driver_identity\\n14\\tfrom attavo.common import (\\n15\\t    MANIFEST,\\n16\\t    Proof,\\n17\\t    STAGES,\\n18\\t    fixture_item_id,\\n19\\t    git,\\n20\\t    product_version,\\n21\\t    read_manifest,\\n22\\t)\\n23\\tfrom attavo.events import stage_events_dir\\n24\\tfrom attavo.records import RECORD_RE, load_records, parse_attempts\\n25\\tfrom attavo.spec import parse_spec\\n26\\tfrom attavo.stops import (\\n27\\t    STOP_CLASSES,\\n28\\t    STOP_PROVENANCES,\\n29\\t    STOP_REDERIVABLE_FROM,\\n30\\t    STOP_STAGES,\\n31\\t    gate_stop,\\n32\\t    is_recovery_stop,\\n33\\t    recovery_fault,\\n34\\t    rederive_stop,\\n35\\t)\\n36\\t\\n37\\t# --- doctor's three proofs ---\\n38\\t\\n39\\tdef proof_every_gate_rejects(root: Path, m: dict[str, Any] | None) -> Proof:\\n40\\t    p = Proof(\\\"every-gate-rejects\\\", \\\"every gate rejects its fixture\\\")\\n41\\t    if m is None:\\n42\\t        return p.fail(f\\\"no {MANIFEST} at {root}; no gate is registered\\\")\\n43\\t    gates = m.get(\\\"gates\\\") or {}\\n44\\t    if not gates:\\n45\\t        return p.fail(\\\"[gates] is empty; a gate that has rejected nothing does not exist\\\")\\n46\\t    fixtures = root / m.get(\\\"paths\\\", {}).get(\\\"rejections\\\", \\\"\\\")\\n47\\t    # Proposal, not yet ruled on (issue #54): a gate that retires nothing\\n48\\t    # only adds, so proof one reports it here rather than waiting on the\\n49\\t    # schema alone -- read_manifest never validates against the manifest\\n50\\t    # schema at runtime, so a schema requirement is not an enforced one.\\n51\\t    no_retires = [name for name, gate in sorted(gates.items()) if not gate.get(\\\"retires\\\")]\\n52\\t    missing, accepted = [], []\\n53\\t    for name, gate in sorted(gates.items()):\\n54\\t        fixture = fixtures / name\\n55\\t        if not fixture.is_dir():\\n56\\t            missing.append(name)\\n57\\t            continue\\n58\\t        env = dict(os.environ)\\n59\\t        item = fixture_item_id(fixture)\\n60\\t        if item is not None:\\n61\\t            env[\\\"ATTAVO_ITEM\\\"] = item\\n62\\t        run = subprocess.run(gate[\\\"command\\\"], shell=True, cwd=str(fixture),\\n63\\t                             capture_output=True, text=True, check=False, env=env)\\n64\\t        if run.returncode == 0:\\n65\\t            accepted.append(name)\\n66\\t    if missing:\\n67\\t        return p.fail(f\\\"gate(s) with no rejection fixture: {', '.join(missing)}\\\")\\n68\\t    if accepted:\\n69\\t        return p.fail(f\\\"gate(s) that accepted their rejection fixture: {', '.join(accepted)}\\\")\\n70\\t    if no_retires:\\n71\\t        return p.fail(f\\\"gate(s) with no retires: {', '.join(no_retires)}\\\")\\n72\\t    return p.hold(f\\\"{len(gates)} gate(s) rejected their fixture\\\")\\n73\\t\\n74\\t\\n75\\tdef _merges_reachable(root: Path, ref: str | None = None) -> tuple[list[dict[str, Any]], str | None]:\\n76\\t    \\\"\\\"\\\"(merges, refusal): every merge commit on the default branch's own\\n77\\t    first-parent line -- sha, parents, and its own first-parent diff --\\n78\\t    read by one process rather than the git log plus one git diff per\\n79\\t    merge merge_introducing_records used to pay walking toward the one\\n80\\t    it wants (issue #153). refs/remotes/origin/HEAD names the default\\n81\\t    branch without hard-coding \\\"main\\\", the same primitive\\n82\\t    diff_since_approval already uses (issue #52); walking from it rather\\n83\\t    than from HEAD is what keeps a transport merge on an item branch, a\\n84\\t    pull_request checkout's own synthetic test merge, and a merge_group's\\n85\\t    temporary merge from ever being mistaken for an item's merge (issue\\n86\\t    #169) -- none of those is reachable from the default branch's first-\\n87\\t    parent line by definition. When refs/remotes/origin/HEAD is not set,\\n88\\t    this refuses by name rather than guess, exactly as diff_since_approval\\n89\\t    does.\\n90\\t\\n91\\t    The walk starts at HEAD itself when the current checkout is literally\\n92\\t    on the branch refs/remotes/origin/HEAD names (an ordinary checkout of\\n93\\t    the default branch, on push or on a developer's own machine) and at\\n94\\t    the remote-tracking ref's own value otherwise (any other branch, or\\n95\\t    the detached HEAD a pull_request or merge_group checkout leaves\\n96\\t    behind) -- HEAD only ever *is* the default branch's first-parent line\\n97\\t    in the former case; in the latter, only the remote-tracking ref names\\n98\\t    it. --diff-merges=first-parent gives each merge's diff against its\\n99\\t    first parent in the same pass git log --merges already makes to list\\n100\\t    them, in the same order, newest first.\\\"\\\"\\\"\\n101\\t    symref = subprocess.run(\\n102\\t        [\\\"git\\\", \\\"-C\\\", str(root), \\\"symbolic-ref\\\", \\\"-q\\\", \\\"refs/remotes/origin/HEAD\\\"],\\n103\\t        capture_output=True, text=True, check=False)\\n104\\t    if symref.returncode != 0:\\n105\\t        return [], \\\"refs/remotes/origin/HEAD is not set; run `git remote set-head origin -a`\\\"\\n106\\t    default_remote_ref = symref.stdout.strip()\\n107\\t    default_branch = default_remote_ref.rsplit(\\\"/\\\", 1)[-1]\\n108\\t    current_branch = subprocess.run(\\n109\\t        [\\\"git\\\", \\\"-C\\\", str(root), \\\"symbolic-ref\\\", \\\"-q\\\", \\\"--short\\\", \\\"HEAD\\\"],\\n110\\t        capture_output=True, text=True, check=False)\\n111\\t    default_ref = ref or (\\\"HEAD\\\" if current_branch.returncode == 0\\n112\\t                          and current_branch.stdout.strip() == default_branch\\n113\\t                          else default_remote_ref)\\n114\\t    try:\\n115\\t        out = git(root, \\\"log\\\", default_ref, \\\"--first-parent\\\", \\\"--merges\\\",\\n116\\t                 \\\"--diff-merges=first-parent\\\", \\\"--name-only\\\",\\n117\\t                 \\\"--format=\\\\x01%H\\\\x1f%P\\\")\\n118\\t    except RuntimeError:\\n119\\t        return [], None\\n120\\t    merges = []\\n121\\t    for block in out.split(\\\"\\\\x01\\\")[1:]:\\n122\\t        header, _, rest = block.partition(\\\"\\\\n\\\")\\n123\\t        sha, parents = header.split(\\\"\\\\x1f\\\")\\n124\\t        merges.append({\\\"sha\\\": sha, \\\"parents\\\": parents.split(),\\n125\\t                       \\\"touched\\\": [line for line in rest.splitlines() if line.strip()]})\\n126\\t    return merges, None\\n127\\t\\n128\\t\\n129\\tdef merge_introducing_records(root: Path, records_rel: str, item: str,\\n130\\t                              stages: tuple[str, ...],\\n131\\t                              merges: list[dict[str, Any]] | None = None) -> tuple[str | None, str | None]:\\n132\\t    \\\"\\\"\\\"(merge_sha, refusal): the merge commit on the default branch's own\\n133\\t    first-parent line whose first-parent diff introduces a record for\\n134\\t    every one of stages, under records_rel/item/ -- the same derivation\\n135\\t    attest itself uses (derive_attest_items), read here so proof two\\n136\\t    requires an item's stage records to have arrived by an actual merge\\n137\\t    on the default branch, not merely to sit in the tree, and not by a\\n138\\t    transport merge, a pull_request checkout's synthetic test merge, or a\\n139\\t    merge_group's temporary merge (issue #69 acceptance row 4; issue\\n140\\t    #169). merge_sha is None with no refusal when no such merge exists\\n141\\t    yet -- the item is not merged, not that the walk failed.\\n142\\t\\n143\\t    merges, when given, is _merges_reachable's own result -- ledger's\\n144\\t    cmd_ledger computes it once and passes it to every item rather than\\n145\\t    walking the default branch's merges again for each (issue #153); a\\n146\\t    caller that already has merges has also already handled\\n147\\t    _merges_reachable's refusal, so this never re-derives one. Left\\n148\\t    None, a caller with just the one item to ask (doctor's proof two)\\n149\\t    gets merges computed here, refusal and all.\\\"\\\"\\\"\\n150\\t    if merges is None:\\n151\\t        merges, refusal = _merges_reachable(root)\\n152\\t        if refusal:\\n153\\t            return None, refusal\\n154\\t    prefix = f\\\"{records_rel.rstrip('/')}/{item}/\\\"\\n155\\t    for merge in merges:\\n156\\t        found: set[str] = set()\\n157\\t        for p in merge[\\\"touched\\\"]:\\n158\\t            if p.startswith(prefix):\\n159\\t                m = RECORD_RE.match(Path(p).name)\\n160\\t                if m:\\n161\\t                    found.add(m.group(1))\\n162\\t        if all(s in found for s in stages):\\n163\\t            return merge[\\\"sha\\\"], None\\n164\\t    return None, None\\n165\\t\\n166\\t\\n167\\tINVOCATION_MARKER_SUFFIX = \\\".started\\\"\\n168\\t\\n169\\t\\n170\\tdef invocation_marker_path(records_dir: Path, stage: str, nn: int) -> Path:\\n171\\t    return records_dir / f\\\"{stage}-{nn:02d}{INVOCATION_MARKER_SUFFIX}\\\"\\n172\\t\\n173\\t\\n174\\tdef heartbeat_s() -> float:\\n175\\t    return float(os.environ.get(\\\"ATTAVO_HEARTBEAT_S\\\", 15))\\n176\\t\\n177\\t\\n178\\tdef heartbeat_path(root: Path, stage: str, nn: int) -> Path:\\n179\\t    return stage_events_dir(root) / f\\\"{stage}-{nn:02d}.heartbeat\\\"\\n180\\t\\n181\\t\\n182\\tdef heartbeat_pid(path: Path) -> int | None:\\n183\\t    \\\"\\\"\\\"The pid the worker wrote as its heartbeat file's one line on its\\n184\\t    first beat -- the holder's own, the only pid anyone signals. None when\\n185\\t    the file is absent, unreadable, empty (a worker from before this\\n186\\t    release touched it and wrote nothing), or not a positive integer.\\\"\\\"\\\"\\n187\\t    try:\\n188\\t        text = path.read_text().strip()\\n189\\t    except OSError:\\n190\\t        return None\\n191\\t    if not text.isdigit() or int(text) <= 0:\\n192\\t        return None\\n193\\t    return int(text)\\n194\\t\\n195\\t\\n196\\tdef heartbeat_age_s(path: Path) -> float | None:\\n197\\t    \\\"\\\"\\\"Seconds since the heartbeat file was last touched; None when there\\n198\\t    is no such file.\\\"\\\"\\\"\\n199\\t    try:\\n200\\t        return clock.now() - path.stat().st_mtime\\n201\\t    except OSError:\\n202\\t        return None\\n203\\t\\n204\\t\\n205\\tdef write_invocation_marker(root: Path, records_dir: Path, stage: str, nn: int,\\n206\\t                            again_by: str | None = None) -> Path:\\n207\\t    \\\"\\\"\\\"The fact that an invocation began, written before it does: at,\\n208\\t    host, the sha it starts on, and the product that started it. No pid:\\n209\\t    the writer is `attavo drive`, which returns seconds later, and the\\n210\\t    process that holds the stage is the worker, whose own heartbeat is\\n211\\t    the fact of holding it. Its record's arrival is what retires a\\n212\\t    marker; a marker with no record is an invocation that died or hangs,\\n213\\t    and proof five names it. again_by is the login that pressed `--again`\\n214\\t    to reset a stage whose budget was spent (or whose last two signatures\\n215\\t    matched) -- absent on every ordinary marker, never a bare false.\\\"\\\"\\\"\\n216\\t    import socket\\n217\\t    from datetime import datetime, timezone\\n218\\t    records_dir.mkdir(parents=True, exist_ok=True)\\n219\\t    path = invocation_marker_path(records_dir, stage, nn)\\n220\\t    sha = git(root, \\\"rev-parse\\\", \\\"HEAD\\\").strip()\\n221\\t    info: dict[str, Any] = {\\\"at\\\": datetime.now(timezone.utc).strftime(\\\"%Y-%m-%dT%H:%M:%SZ\\\"),\\n222\\t                            \\\"host\\\": socket.gethostname(), \\\"sha\\\": sha,\\n223\\t                            \\\"product_version\\\": product_version()}\\n224\\t    if again_by:\\n225\\t        info[\\\"again_by\\\"] = again_by\\n226\\t    path.write_text(json.dumps(info, indent=2) + \\\"\\\\n\\\")\\n227\\t    return path\\n228\\t\\n229\\t\\n230\\tdef invocation_age_s(info: dict[str, Any]) -> float | None:\\n231\\t    \\\"\\\"\\\"Seconds since the marker's own `at` timestamp -- how long ago the\\n232\\t    invocation it names began, whatever host wrote it. None when `at` is\\n233\\t    missing or does not parse.\\\"\\\"\\\"\\n234\\t    from datetime import datetime, timezone\\n235\\t    at = info.get(\\\"at\\\")\\n236\\t    if not isinstance(at, str):\\n237\\t        return None\\n238\\t    try:\\n239\\t        stamp = datetime.strptime(at, \\\"%Y-%m-%dT%H:%M:%SZ\\\").replace(tzinfo=timezone.utc)\\n240\\t    except ValueError:\\n241\\t        return None\\n242\\t    return clock.now() - stamp.timestamp()\\n243\\t\\n244\\t\\n245\\tdef invocations_without_record(item_records_dir: Path) -> list[tuple[Path, dict[str, Any]]]:\\n246\\t    \\\"\\\"\\\"Every <stage>-NN.started under one item whose <stage>-NN.json has\\n247\\t    not arrived, with the marker's own dict ({} when unreadable).\\\"\\\"\\\"\\n248\\t    out: list[tuple[Path, dict[str, Any]]] = []\\n249\\t    if not item_records_dir.is_dir():\\n250\\t        return out\\n251\\t    for marker in sorted(item_records_dir.glob(f\\\"*{INVOCATION_MARKER_SUFFIX}\\\")):\\n252\\t        if (item_records_dir / f\\\"{marker.stem}.json\\\").is_file():\\n253\\t            continue\\n254\\t        try:\\n255\\t            with marker.open() as fh:\\n256\\t                info = json.load(fh)\\n257\\t        except (OSError, ValueError):\\n258\\t            info = {}\\n259\\t        out.append((marker, info if isinstance(info, dict) else {}))\\n260\\t    return out\\n261\\t\\n262\\t\\n263\\tdef stall_bound_s(m: dict[str, Any]) -> int | None:\\n264\\t    \\\"\\\"\\\"[drive].stall_after_s: the tenant's own bound past which a live\\n265\\t    invocation with no new event is hung. A bound the tenant did not\\n266\\t    write is a forecast, so there is no default.\\\"\\\"\\\"\\n267\\t    bound = (m.get(\\\"drive\\\") or {}).get(\\\"stall_after_s\\\")\\n268\\t    if isinstance(bound, bool) or not isinstance(bound, (int, float)) or bound <= 0:\\n269\\t        return None\\n270\\t    return int(bound)\\n271\\t\\n272\\t\\n273\\tdef ceiling_s(m: dict[str, Any], stage: str) -> int | None:\\n274\\t    \\\"\\\"\\\"R3: [drive.<stage>].ceiling_s, the wall clock past which a live\\n275\\t    invocation of that stage is hung by its ceiling, whatever event age\\n276\\t    says (or does not say, for an adapter that streams none). No\\n277\\t    default: a ceiling the tenant did not declare is not assumed.\\\"\\\"\\\"\\n278\\t    value = ((m.get(\\\"drive\\\") or {}).get(stage) or {}).get(\\\"ceiling_s\\\")\\n279\\t    if isinstance(value, bool) or not isinstance(value, (int, float)) or value <= 0:\\n280\\t        return None\\n281\\t    return int(value)\\n282\\t\\n283\\t\\n284\\tdef attempts_budget(m: dict[str, Any]) -> int:\\n285\\t    \\\"\\\"\\\"R3: [drive].attempts, the attempts a stage may spend -- across a\\n286\\t    plain retry, a returned retry, and a steered one alike -- before the\\n287\\t    item is a person's; 3 when the manifest does not say.\\\"\\\"\\\"\\n288\\t    value = (m.get(\\\"drive\\\") or {}).get(\\\"attempts\\\")\\n289\\t    if isinstance(value, bool) or not isinstance(value, int) or value < 1:\\n290\\t        return 3\\n291\\t    return value\\n292\\t\\n293\\t\\n294\\tdef retry_after_s(m: dict[str, Any]) -> int:\\n295\\t    \\\"\\\"\\\"R3: [drive].retry_after_s, the wait a transient stop's record sits\\n296\\t    through before its next attempt starts; 300 when the manifest does\\n297\\t    not say.\\\"\\\"\\\"\\n298\\t    value = (m.get(\\\"drive\\\") or {}).get(\\\"retry_after_s\\\")\\n299\\t    if isinstance(value, bool) or not isinstance(value, (int, float)) or value < 0:\\n300\\t        return 300\\n301\\t    return int(value)\\n302\\t\\n303\\t\\n304\\tdef proof_no_invocation_lacks_record(root: Path, m: dict[str, Any] | None) -> Proof:\\n305\\t    import socket\\n306\\t    p = Proof(\\\"no-invocation-lacks-record\\\", \\\"no invocation lacks its record\\\")\\n307\\t    if m is None:\\n308\\t        return p.fail(f\\\"no {MANIFEST} at {root}; no records directory is declared\\\")\\n309\\t    records_rel = m.get(\\\"paths\\\", {}).get(\\\"records\\\", \\\"\\\")\\n310\\t    records_dir = root / records_rel\\n311\\t    if not records_dir.is_dir():\\n312\\t        return p.fail(f\\\"no records directory under {records_dir}\\\")\\n313\\t    bound = stall_bound_s(m)\\n314\\t    if bound is None:\\n315\\t        return p.fail(\\\"no [drive].stall_after_s in the manifest; a hung invocation cannot be \\\"\\n316\\t                      \\\"told from a running one\\\")\\n317\\t    # R3: a stage with no ceiling can run forever unjudged even when\\n318\\t    # stall_after_s is set (an adapter that streams no events trips no\\n319\\t    # stall bound at all) -- refused the same way stall_after_s's own\\n320\\t    # absence is, not folded into it, so the reason names exactly which\\n321\\t    # keys the manifest is missing.\\n322\\t    missing_ceilings = [f\\\"[drive.{stage}].ceiling_s\\\" for stage in (\\\"build\\\", \\\"verify\\\")\\n323\\t                        if ceiling_s(m, stage) is None]\\n324\\t    if missing_ceilings:\\n325\\t        return p.fail(f\\\"no {' or '.join(missing_ceilings)} in the manifest; a stage with no \\\"\\n326\\t                      f\\\"ceiling can run forever unjudged (R3)\\\")\\n327\\t    if (m.get(\\\"drive\\\") or {}).get(\\\"attempts\\\") is None:\\n328\\t        return p.fail(\\\"no [drive].attempts in the manifest; a retryable stop would spend an \\\"\\n329\\t                      \\\"unbounded number of attempts (R3)\\\")\\n330\\t    this_host = socket.gethostname()\\n331\\t    recorded = 0\\n332\\t    running: list[str] = []\\n333\\t    in_flight: list[str] = []\\n334\\t    problems: list[str] = []\\n335\\t    for item_dir in sorted(d for d in records_dir.iterdir() if d.is_dir()):\\n336\\t        for marker in item_dir.glob(f\\\"*{INVOCATION_MARKER_SUFFIX}\\\"):\\n337\\t            if (item_dir / f\\\"{marker.stem}.json\\\").is_file():\\n338\\t                recorded += 1\\n339\\t        for marker, info in invocations_without_record(item_dir):\\n340\\t            name = f\\\"item {item_dir.name} {marker.stem}\\\"\\n341\\t            stage, nn_text = marker.stem.rsplit(\\\"-\\\", 1)\\n342\\t            try:\\n343\\t                beat_age = heartbeat_age_s(heartbeat_path(root, stage, int(nn_text)))\\n344\\t            except (RuntimeError, ValueError):\\n345\\t                beat_age = None\\n346\\t            if beat_age is not None:\\n347\\t                # The holder's own fact: fresh within three beats is\\n348\\t                # running, older is a holder that stopped touching it.\\n349\\t                if beat_age <= heartbeat_s() * 3:\\n350\\t                    running.append(f\\\"{name} (heartbeat {int(beat_age)} s old, since {info.get('at')})\\\")\\n351\\t                    continue\\n352\\t            elif info.get(\\\"host\\\") != this_host:\\n353\\t                # No heartbeat file readable from here for a marker from\\n354\\t                # another host: not yet a failure. An invocation younger\\n355\\t                # than the tenant's own stall bound may simply be running\\n356\\t                # elsewhere, still writing toward its own record.\\n357\\t                age = invocation_age_s(info)\\n358\\t                if age is not None and age < bound:\\n359\\t                    in_flight.append(f\\\"{name} (host {info.get('host')} since {info.get('at')})\\\")\\n360\\t                    continue\\n361\\t            problems.append(f\\\"{name} started {info.get('at')} on {info.get('host')} \\\"\\n362\\t                            f\\\"and never wrote its record\\\")\\n363\\t    if problems:\\n364\\t        return p.fail(\\\"; \\\".join(problems), unrecorded_invocations=len(problems),\\n365\\t                      running_invocations=running, in_flight=in_flight)\\n366\\t    return p.hold(f\\\"{recorded} invocation(s) recorded, {len(running)} running, \\\"\\n367\\t                  f\\\"{len(in_flight)} in flight elsewhere\\\",\\n368\\t                  unrecorded_invocations=0, running_invocations=running, in_flight=in_flight)\\n369\\t\\n370\\t\\n371\\tdef proof_one_item_every_stage(root: Path, m: dict[str, Any] | None) -> Proof:\\n372\\t    p = Proof(\\\"one-item-every-stage\\\", \\\"one item has traversed every stage\\\")\\n373\\t    if m is None:\\n374\\t        return p.fail(f\\\"no {MANIFEST} at {root}; no records directory is declared\\\")\\n375\\t    records_rel = m.get(\\\"paths\\\", {}).get(\\\"records\\\", \\\"\\\")\\n376\\t    records_dir = root / records_rel\\n377\\t    items = load_records(records_dir)\\n378\\t    if not items:\\n379\\t        return p.fail(f\\\"no work item under {records_dir.relative_to(root)}\\\")\\n380\\t    complete = [item for item, stages in items.items() if all(s in stages for s in STAGES)]\\n381\\t    if not complete:\\n382\\t        best = max(items.items(), key=lambda kv: len(kv[1]))\\n383\\t        lacking = [s for s in STAGES if s not in best[1]]\\n384\\t        return p.fail(f\\\"no item carries every stage; item {best[0]} lacks {', '.join(lacking)}\\\")\\n385\\t\\n386\\t    # issue #74: a complete item is counted only when its chain holds --\\n387\\t    # attavo attest refuses a build re-approved after the fact or a\\n388\\t    # verify whose build went stale, and the coherence gate refuses the\\n389\\t    # merge group on exactly that; a proof that never asked would call a\\n390\\t    # traversal the gate itself would not let through. The refusal text\\n391\\t    # is check_attest_chain's own, never re-typed here.\\n392\\t    refused, held, unmerged = [], [], []\\n393\\t    for item in complete:\\n394\\t        chain, message = check_attest_chain(records_dir / item, item)\\n395\\t        if chain is None:\\n396\\t            refused.append(f\\\"item {item}: {message}\\\")\\n397\\t            continue\\n398\\t        merge_sha, merge_refusal = merge_introducing_records(root, records_rel, item, STAGES)\\n399\\t        if merge_refusal:\\n400\\t            return p.fail(merge_refusal)\\n401\\t        if merge_sha:\\n402\\t            held.append((item, merge_sha))\\n403\\t        else:\\n404\\t            unmerged.append(item)\\n405\\t\\n406\\t    if held:\\n407\\t        names = \\\", \\\".join(item for item, _ in held)\\n408\\t        shas = \\\", \\\".join(sha[:12] for _, sha in held)\\n409\\t        return p.hold(f\\\"item(s) {names} carry {', '.join(STAGES)} with the chain held, \\\"\\n410\\t                      f\\\"merged at {shas}\\\")\\n411\\t    if refused:\\n412\\t        return p.fail(\\\"; \\\".join(refused))\\n413\\t    return p.fail(f\\\"item(s) {', '.join(unmerged)} carry every stage with the chain held but no \\\"\\n414\\t                  f\\\"merge commit's first-parent diff introduces all of them\\\")\\n415\\t\\n416\\t\\n417\\tdef commit_subject(root: Path, sha: str) -> str:\\n418\\t    return git(root, \\\"log\\\", \\\"-1\\\", \\\"--format=%s\\\", sha).strip()\\n419\\t\\n420\\t\\n421\\tdef touches_boundary(root: Path, sha: str, boundary_paths: list[str]) -> bool:\\n422\\t    \\\"\\\"\\\"Whether sha's first-parent diff touches a path [spec.boundary].paths\\n423\\t    declares governed -- an ordinary merge that does is a boundary\\n424\\t    evasion (issue #72): the tenant carried a governed change around the\\n425\\t    path the manifest itself names.\\\"\\\"\\\"\\n426\\t    diff = git(root, \\\"diff\\\", \\\"--name-only\\\", f\\\"{sha}^1\\\", sha).splitlines()\\n427\\t    return any(fnmatch.fnmatch(path, pattern) for path in diff for pattern in boundary_paths)\\n428\\t\\n429\\t\\n430\\tclass WindowRefused(Exception):\\n431\\t    \\\"\\\"\\\"The window start cannot be computed; str(exc) is the refusal.\\\"\\\"\\\"\\n432\\t\\n433\\t\\n434\\tdef proof_window_start(root: Path, m: dict[str, Any]) -> tuple[str, str, list[str]]:\\n435\\t    \\\"\\\"\\\"(install commit, window start, first-parent chain after the install\\n436\\t    commit): where proofs three and six start reading. The start is\\n437\\t    [doctor].from if the tenant set it, otherwise the commit that\\n438\\t    introduced the manifest (issue #192: proof six reads this too, so the\\n439\\t    two proofs cannot disagree).\\\"\\\"\\\"\\n440\\t    try:\\n441\\t        install = git(root, \\\"log\\\", \\\"--diff-filter=A\\\", \\\"--format=%H\\\",\\n442\\t                      \\\"--reverse\\\", \\\"--\\\", MANIFEST).split()\\n443\\t    except RuntimeError as exc:\\n444\\t        raise WindowRefused(f\\\"git: {exc}\\\") from exc\\n445\\t    if not install:\\n446\\t        raise WindowRefused(f\\\"{MANIFEST} is not committed; the tenant has no record boundary\\\")\\n447\\t    install_sha = install[0]\\n448\\t    full_chain = git(root, \\\"rev-list\\\", f\\\"{install_sha}..HEAD\\\", \\\"--first-parent\\\").split()\\n449\\t\\n450\\t    # issue #74: [doctor] from lets a tenant declare the doctor's read to\\n451\\t    # start at a later commit on main's first-parent line -- the point\\n452\\t    # after which every push arrived through the queue -- rather than the\\n453\\t    # install commit, which on a repository that adopted the product\\n454\\t    # after its history began is a boundary the doctor cannot otherwise\\n455\\t    # see. Any spelling git resolves is accepted (a short sha, a tag, a\\n456\\t    # ref) -- resolved with rev-parse --verify before the first-parent\\n457\\t    # check runs, so the two failure modes stay distinct: a spelling that\\n458\\t    # names no commit at all, and a commit that names one off the line.\\n459\\t    # Checked, not trusted: neither is silently forgiven back to install.\\n460\\t    declared_from = (m.get(\\\"doctor\\\") or {}).get(\\\"from\\\")\\n461\\t    window_start = install_sha\\n462\\t    if declared_from is not None:\\n463\\t        try:\\n464\\t            resolved_from = git(root, \\\"rev-parse\\\", \\\"--verify\\\", f\\\"{declared_from}^{{commit}}\\\").strip()\\n465\\t        except RuntimeError:\\n466\\t            raise WindowRefused(f\\\"[doctor] from {declared_from} does not resolve to a commit\\\") from None\\n467\\t        if resolved_from != install_sha and resolved_from not in full_chain:\\n468\\t            raise WindowRefused(f\\\"[doctor] from {declared_from} is not on main's first-parent \\\"\\n469\\t                                f\\\"line after the install commit {install_sha[:12]}\\\")\\n470\\t        window_start = resolved_from\\n471\\t    return install_sha, window_start, full_chain\\n472\\t\\n473\\t\\n474\\tdef proof_no_commit_lacks_record(root: Path, m: dict[str, Any] | None) -> Proof:\\n475\\t    p = Proof(\\\"no-commit-lacks-record\\\", \\\"no commit lacks a record\\\")\\n476\\t    if m is None:\\n477\\t        return p.fail(f\\\"no {MANIFEST} at {root}; the tenant has no record boundary\\\")\\n478\\t    try:\\n479\\t        install_sha, window_start, full_chain = proof_window_start(root, m)\\n480\\t    except WindowRefused as exc:\\n481\\t        return p.fail(str(exc))\\n482\\t    if not full_chain:\\n483\\t        return p.fail(f\\\"no commit after the install commit {install_sha[:12]}; nothing has been recorded\\\")\\n484\\t\\n485\\t    if window_start == install_sha:\\n486\\t        window_spec = f\\\"{install_sha}..HEAD\\\"\\n487\\t        commits = full_chain\\n488\\t    else:\\n489\\t        window_spec = f\\\"{window_start}^..HEAD\\\"\\n490\\t        commits = git(root, \\\"rev-list\\\", window_spec, \\\"--first-parent\\\").split()\\n491\\t    before_window = len(full_chain) - len(commits)\\n492\\t\\n493\\t    records_rel = m.get(\\\"paths\\\", {}).get(\\\"records\\\", \\\"\\\")\\n494\\t    records_dir = root / records_rel\\n495\\t    named: set[str] = set()\\n496\\t    for stages in load_records(records_dir).values():\\n497\\t        for rec in stages.values():\\n498\\t            sha = rec.get(\\\"sha\\\")\\n499\\t            if isinstance(sha, str):\\n500\\t                named.add(sha)\\n501\\t            for c in rec.get(\\\"commits\\\", []) or []:\\n502\\t                if isinstance(c, str):\\n503\\t                    named.add(c)\\n504\\t    record_commits = set(git(root, \\\"rev-list\\\", window_spec, \\\"--first-parent\\\",\\n505\\t                             \\\"--\\\", records_rel).split()) if records_rel else set()\\n506\\t    merges = set(git(root, \\\"rev-list\\\", window_spec, \\\"--first-parent\\\", \\\"--merges\\\").split())\\n507\\t    boundary_paths = ((m.get(\\\"spec\\\") or {}).get(\\\"boundary\\\") or {}).get(\\\"paths\\\") or []\\n508\\t\\n509\\t    # Every first-parent commit in the window is exactly one of three\\n510\\t    # (issue #72): recorded (a record names it, or its diff touches\\n511\\t    # paths.records), ordinary (a merge that doesn't), or unrecorded\\n512\\t    # (anything else -- on a protected main with a queue, a non-merge\\n513\\t    # commit is the only way a change arrives without the forge).\\n514\\t    recorded, ordinary, unrecorded = [], [], []\\n515\\t    ordinary_commits, unrecorded_commits = [], []\\n516\\t    boundary_evasions = 0\\n517\\t    for c in commits:\\n518\\t        if c in named or c in record_commits:\\n519\\t            recorded.append(c)\\n520\\t        elif c in merges:\\n521\\t            ordinary.append(c)\\n522\\t            evasion = bool(boundary_paths and touches_boundary(root, c, boundary_paths))\\n523\\t            if evasion:\\n524\\t                boundary_evasions += 1\\n525\\t            ordinary_commits.append({\\\"sha\\\": c, \\\"subject\\\": commit_subject(root, c),\\n526\\t                                     \\\"boundary_evasion\\\": evasion})\\n527\\t        else:\\n528\\t            unrecorded.append(c)\\n529\\t            unrecorded_commits.append({\\\"sha\\\": c, \\\"subject\\\": commit_subject(root, c)})\\n530\\t\\n531\\t    not_transport = driver_commits_not_transport(root, window_spec, records_rel) if records_rel else []\\n532\\t    counts = f\\\"{len(recorded)} recorded, {len(ordinary)} ordinary, {len(unrecorded)} unrecorded\\\"\\n533\\t    evasions = boundary_evasions if boundary_paths else \\\"n/a\\\"\\n534\\t    extra = {\\\"recorded\\\": len(recorded), \\\"ordinary\\\": len(ordinary),\\n535\\t             \\\"unrecorded\\\": len(unrecorded), \\\"boundary_evasions\\\": evasions,\\n536\\t             \\\"before_window\\\": before_window,\\n537\\t             \\\"ordinary_commits\\\": ordinary_commits, \\\"unrecorded_commits\\\": unrecorded_commits,\\n538\\t             \\\"driver_commits_not_transport\\\": not_transport}\\n539\\t    if not_transport:\\n540\\t        return p.fail(f\\\"a driver commit is not a records transport: {not_transport[0]}; {counts}\\\", **extra)\\n541\\t    if unrecorded:\\n542\\t        return p.fail(f\\\"{unrecorded[-1][:12]} lacks a record; {counts}; boundary evasions: \\\"\\n543\\t                      f\\\"{evasions}; before the window: {before_window}\\\", **extra)\\n544\\t    return p.hold(f\\\"{counts}; boundary evasions: {evasions}; before the window: {before_window}\\\",\\n545\\t                  **extra)\\n546\\t\\n547\\t\\n548\\tdef driver_commits_not_transport(root: Path, window_spec: str, records_rel: str) -> list[str]:\\n549\\t    \\\"\\\"\\\"Every commit in the window authored as driver_identity() that is not\\n550\\t    a records transport: more than one parent, or a path outside\\n551\\t    <records>/<N>/ for the one item N it touches. The driver's commits\\n552\\t    carry records and nothing else, one parent each (root cause 1: the\\n553\\t    driver makes them in a detached worktree and never merges), so one\\n554\\t    that does either was made by something other than the transport.\\n555\\t    Each entry reads `<sha12> <why>`.\\\"\\\"\\\"\\n556\\t    email = driver_identity()[\\\"email\\\"]\\n557\\t    bad: list[str] = []\\n558\\t    prefix = records_rel.strip(\\\"/\\\") + \\\"/\\\"\\n559\\t    out = git(root, \\\"log\\\", window_spec, \\\"--format=%H\\\\x1f%ae\\\\x1f%P\\\")\\n560\\t    for line in out.splitlines():\\n561\\t        sha, author, parents = line.split(\\\"\\\\x1f\\\")\\n562\\t        if author != email:\\n563\\t            continue\\n564\\t        if len(parents.split()) > 1:\\n565\\t            bad.append(f\\\"{sha[:12]} is a merge\\\")\\n566\\t            continue\\n567\\t        paths = git(root, \\\"diff-tree\\\", \\\"--no-commit-id\\\", \\\"--name-only\\\", \\\"-r\\\", \\\"--root\\\", sha).splitlines()\\n568\\t        items = {p[len(prefix):].split(\\\"/\\\", 1)[0] for p in paths if p.startswith(prefix) and \\\"/\\\" in p[len(prefix):]}\\n569\\t        outside = [p for p in paths if not (p.startswith(prefix) and \\\"/\\\" in p[len(prefix):])]\\n570\\t        if outside:\\n571\\t            bad.append(f\\\"{sha[:12]} touches {outside[0]}, outside its item's records\\\")\\n572\\t        elif len(items) > 1:\\n573\\t            bad.append(f\\\"{sha[:12]} touches the records of items {', '.join(sorted(items))}\\\")\\n574\\t    return bad\\n575\\t\\n576\\t\\n577\\tADAPTER_EXIT_RE = re.compile(r\\\"^\\\\[adapter exited \\\\d+\\\\]$\\\")\\n578\\t\\n579\\t_JSON_LINE_PARSE_FAILED = object()\\n580\\t\\n581\\t\\n582\\tdef _parse_json_line(text: str) -> Any:\\n583\\t    \\\"\\\"\\\"A line's own parsed JSON value, or the sentinel\\n584\\t    _JSON_LINE_PARSE_FAILED when it does not parse -- the one call site\\n585\\t    in this file for a defensive, line-at-a-time JSON parse, shared by\\n586\\t    proof four's own tool-error check below (any valid JSON satisfies\\n587\\t    it) and an events line's own `at` read (issue #151, which further\\n588\\t    requires a dict). A dedicated sentinel, not None: a line that is\\n589\\t    the literal JSON value null parses successfully and must read as\\n590\\t    such, not as a failure.\\\"\\\"\\\"\\n591\\t    try:\\n592\\t        return json.loads(text)\\n593\\t    except ValueError:\\n594\\t        return _JSON_LINE_PARSE_FAILED\\n595\\t\\n596\\t\\n597\\tdef _log_owes_tool_error(log: str | None) -> bool:\\n598\\t    \\\"\\\"\\\"True when a log's last non-empty line is exactly an adapter-exit\\n599\\t    marker and every line before it parses as JSON -- an adapter's own\\n600\\t    event stream, never a tool's own words (issue #94's own specimen,\\n601\\t    tenant zero's attest/records/659/verify-01.log: codex's\\n602\\t    \\\"thread.started\\\" event, then nothing but \\\"[adapter exited 1]\\\" -- the\\n603\\t    tool's real error line dropped before this reached the log, issue\\n604\\t    #86's own bug in split_adapter_stdout). A log that is only the exit\\n605\\t    marker, nothing before it at all, still owes the same line. An\\n606\\t    `error` event with a non-empty string `message` is the tool's own\\n607\\t    error delivered as an event (issue #200: \\\"Selected model is at\\n608\\t    capacity\\\"), so it owes nothing. So is an API error the tool reports as\\n609\\t    its own assistant message -- Claude Code's `\\\"is_api_error_message\\\":\\n610\\t    true` event, whose text is the tool's words (\\\"Failed to authenticate:\\n611\\t    OAuth session expired and could not be refreshed\\\", item 267 build-01\\n612\\t    and build-02, 2026-09-30) -- when that text is non-empty.\\\"\\\"\\\"\\n613\\t    if not log:\\n614\\t        return False\\n615\\t    lines = [l for l in log.splitlines() if l.strip()]\\n616\\t    if not lines or not ADAPTER_EXIT_RE.match(lines[-1]):\\n617\\t        return False\\n618\\t    for l in lines[:-1]:\\n619\\t        parsed = _parse_json_line(l)\\n620\\t        if parsed is _JSON_LINE_PARSE_FAILED:\\n621\\t            return False\\n622\\t        if isinstance(parsed, dict) and parsed.get(\\\"type\\\") == \\\"error\\\":\\n623\\t            message = parsed.get(\\\"message\\\")\\n624\\t            if isinstance(message, str) and message:\\n625\\t                return False\\n626\\t        if isinstance(parsed, dict) and parsed.get(\\\"is_api_error_message\\\") is True:\\n627\\t            if _api_error_text(parsed):\\n628\\t                return False\\n629\\t    return True\\n630\\t\\n631\\t\\n632\\tdef _api_error_text(event: dict[str, Any]) -> str:\\n633\\t    \\\"\\\"\\\"The text of an API error an adapter's tool delivered as its own\\n634\\t    assistant message: the non-empty text blocks of message.content,\\n635\\t    joined. Empty when there is none, which owes the line still.\\\"\\\"\\\"\\n636\\t    message = event.get(\\\"message\\\")\\n637\\t    content = message.get(\\\"content\\\") if isinstance(message, dict) else None\\n638\\t    if not isinstance(content, list):\\n639\\t        return \\\"\\\"\\n640\\t    texts = [b.get(\\\"text\\\") for b in content\\n641\\t             if isinstance(b, dict) and b.get(\\\"type\\\") == \\\"text\\\" and isinstance(b.get(\\\"text\\\"), str)]\\n642\\t    return \\\" \\\".join(t.strip() for t in texts if t and t.strip())\\n643\\t\\n644\\t\\n645\\tdef proof_no_stop_lacks_cause(root: Path, m: dict[str, Any] | None) -> Proof:\\n646\\t    p = Proof(\\\"no-stop-lacks-cause\\\", \\\"no stop lacks its cause\\\")\\n647\\t    if m is None:\\n648\\t        return p.fail(f\\\"no {MANIFEST} at {root}; no records directory is declared\\\")\\n649\\t    records_rel = m.get(\\\"paths\\\", {}).get(\\\"records\\\", \\\"\\\")\\n650\\t    records_dir = root / records_rel\\n651\\t    if not records_dir.is_dir():\\n652\\t        return p.fail(f\\\"no records directory under {records_dir}\\\")\\n653\\t\\n654\\t    # issue #89's own window lesson, proof three's already: a record\\n655\\t    # before record_version 3 has no stop by construction (schema\\n656\\t    # versions 1 and 2 predate it) -- counted here, never refused.\\n657\\t    older = 0\\n658\\t    checked = 0\\n659\\t    before_rederivable = 0\\n660\\t    problems: list[str] = []\\n661\\t    for item_dir in sorted(d for d in records_dir.iterdir() if d.is_dir()):\\n662\\t        for stage in STOP_STAGES:\\n663\\t            for n, rec in sorted(parse_attempts(item_dir, stage).items()):\\n664\\t                if rec.get(\\\"record_version\\\", 1) < 3:\\n665\\t                    older += 1\\n666\\t                    continue\\n667\\t                if rec.get(\\\"status\\\") == \\\"pass\\\":\\n668\\t                    continue\\n669\\t                checked += 1\\n670\\t                name = f\\\"{stage}-{n:02d}\\\"\\n671\\t                rederivable = rec.get(\\\"record_version\\\", 1) >= STOP_REDERIVABLE_FROM[stage]\\n672\\t                if not rederivable:\\n673\\t                    before_rederivable += 1\\n674\\t                stop = rec.get(\\\"stop\\\")\\n675\\t                if not stop:\\n676\\t                    problems.append(f\\\"item {item_dir.name} {name} carries no stop\\\")\\n677\\t                    continue\\n678\\t                cls, provenance = stop.get(\\\"class\\\"), stop.get(\\\"provenance\\\")\\n679\\t                if cls not in STOP_CLASSES:\\n680\\t                    problems.append(f\\\"item {item_dir.name} {name} stop.class {cls!r} names \\\"\\n681\\t                                    f\\\"no enumerated class\\\")\\n682\\t                    continue\\n683\\t                if provenance not in STOP_PROVENANCES:\\n684\\t                    problems.append(f\\\"item {item_dir.name} {name} stop.provenance \\\"\\n685\\t                                    f\\\"{provenance!r} names no enumerated provenance\\\")\\n686\\t                    continue\\n687\\t                # Issue #254: at the version that stores what the stop was\\n688\\t                # derived from, the stop is that function's value -- the\\n689\\t                # pass's own recovery records by their own rule.\\n690\\t                if rederivable and is_recovery_stop(rec):\\n691\\t                    fault = recovery_fault(rec)\\n692\\t                    if fault:\\n693\\t                        problems.append(f\\\"item {item_dir.name} {name} {fault}\\\")\\n694\\t                        continue\\n695\\t                elif rederivable:\\n696\\t                    derived = rederive_stop(stage, rec)\\n697\\t                    if derived is None or (derived[\\\"class\\\"], derived[\\\"provenance\\\"]) != (cls, provenance):\\n698\\t                        problems.append(\\n699\\t                            f\\\"item {item_dir.name} {name} stop is {cls}/{provenance} but its \\\"\\n700\\t                            f\\\"own fields derive \\\"\\n701\\t                            f\\\"{'no stop' if derived is None else derived['class'] + '/' + derived['provenance']}\\\")\\n702\\t                        continue\\n703\\t                if cls == \\\"unclassed\\\" and not stop.get(\\\"detail\\\"):\\n704\\t                    problems.append(f\\\"item {item_dir.name} {name} is unclassed with no detail\\\")\\n705\\t                    continue\\n706\\t                log_path = item_dir / f\\\"{name}.log\\\"\\n707\\t                log = log_path.read_text() if log_path.is_file() else None\\n708\\t                # Issue #89, rejection test 1's own specimen (tenant\\n709\\t                # zero's #659 build-01): a failed build that actually ran\\n710\\t                # the gates -- selected_tests is set only once cmd_build\\n711\\t                # reaches them -- owes their heading in the log, whatever\\n712\\t                # else stop already says.\\n713\\t                if (stage == \\\"build\\\" and rec.get(\\\"status\\\") == \\\"failed\\\"\\n714\\t                        and rec.get(\\\"selected_tests\\\") is not None\\n715\\t                        and \\\"--- attavo gates, iteration\\\" not in (log or \\\"\\\")):\\n716\\t                    problems.append(f\\\"item {item_dir.name} {name} failed after the gates ran \\\"\\n717\\t                                    f\\\"but its log carries no gates heading\\\")\\n718\\t                    continue\\n719\\t                if _log_owes_tool_error(log):\\n720\\t                    problems.append(f\\\"item {item_dir.name} {name}'s log ends in an adapter \\\"\\n721\\t                                    f\\\"exit with nothing before it but event lines; the tool's \\\"\\n722\\t                                    f\\\"own error line is owed\\\")\\n723\\t\\n724\\t        # issue #137: a refused spec-gate record is a stop too, class\\n725\\t        # \\\"gate\\\" -- synthesized the same way item_stops and\\n726\\t        # cmd_file_stops already read it, since cmd_spec_gate itself\\n727\\t        # carries no stop field to check for one. No record_version\\n728\\t        # gate here: unlike build/verify's own stop field, gate is never\\n729\\t        # persisted, so there is no older shape that predates it.\\n730\\t        for n, rec in sorted(parse_attempts(item_dir, \\\"spec\\\").items()):\\n731\\t            if rec.get(\\\"status\\\") != \\\"refused\\\":\\n732\\t                continue\\n733\\t            checked += 1\\n734\\t            name = f\\\"spec-{n:02d}\\\"\\n735\\t            stop = gate_stop(rec.get(\\\"refusal\\\"))\\n736\\t            cls, provenance = stop[\\\"class\\\"], stop[\\\"provenance\\\"]\\n737\\t            if cls not in STOP_CLASSES:\\n738\\t                problems.append(f\\\"item {item_dir.name} {name} stop.class {cls!r} names \\\"\\n739\\t                                f\\\"no enumerated class\\\")\\n740\\t                continue\\n741\\t            if provenance not in STOP_PROVENANCES:\\n742\\t                problems.append(f\\\"item {item_dir.name} {name} stop.provenance \\\"\\n743\\t                                f\\\"{provenance!r} names no enumerated provenance\\\")\\n744\\t                continue\\n745\\t            if not stop.get(\\\"detail\\\"):\\n746\\t                problems.append(f\\\"item {item_dir.name} {name} is a gate stop with no cause\\\")\\n747\\t\\n748\\t    older_note = (f\\\"{older} record(s) before stop was recorded; {before_rederivable} non-pass \\\"\\n749\\t                 f\\\"record(s) before their stop could be re-derived\\\")\\n750\\t    if problems:\\n751\\t        return p.fail(\\\"; \\\".join(problems), older_records=older,\\n752\\t                     before_rederivable=before_rederivable)\\n753\\t    return p.hold(f\\\"{checked} checked ({older_note})\\\" if checked == 0\\n754\\t                 else f\\\"{checked} non-pass record(s) carry stop with a cause ({older_note})\\\",\\n755\\t                 older_records=older, before_rederivable=before_rederivable)\\n756\\t\\n757\\t\\n758\\tdef attestation_command(m: dict[str, Any]) -> str | None:\\n759\\t    \\\"\\\"\\\"[forge].attestation_command: the tenant's own read of the store,\\n760\\t    given a merge sha on stdin, printing the statement as JSON on exit 0\\n761\\t    and nothing on a non-zero exit. Absent is not passing (issue #158:\\n762\\t    the doctor said done while #106, #148, #153 had no statement in the\\n763\\t    store at all -- there was no key to read one through).\\\"\\\"\\\"\\n764\\t    cmd = (m.get(\\\"forge\\\") or {}).get(\\\"attestation_command\\\")\\n765\\t    return cmd if isinstance(cmd, str) and cmd.strip() else None\\n766\\t\\n767\\t\\n768\\tdef statement_for(root: Path, cmd: str, merge_sha: str) -> tuple[dict[str, Any] | None, int]:\\n769\\t    \\\"\\\"\\\"The statement the forge holds for merge_sha and the command's exit\\n770\\t    code. The statement is None when the command exits non-zero or prints\\n771\\t    anything but a JSON object -- exit 2 means the store itself could not\\n772\\t    be read (issue #158, amended after build-05: distinct from exit 1,\\n773\\t    the store read fine and simply held no statement).\\\"\\\"\\\"\\n774\\t    run = subprocess.run(cmd, shell=True, cwd=str(root), input=merge_sha + \\\"\\\\n\\\",\\n775\\t                         capture_output=True, text=True, check=False)\\n776\\t    if run.returncode != 0:\\n777\\t        return None, run.returncode\\n778\\t    try:\\n779\\t        parsed = json.loads(run.stdout)\\n780\\t    except ValueError:\\n781\\t        return None, run.returncode\\n782\\t    return (parsed if isinstance(parsed, dict) else None), run.returncode\\n783\\t\\n784\\t\\n785\\tdef _is_ancestor(root: Path, earlier: str, later: str) -> bool:\\n786\\t    run = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"merge-base\\\", \\\"--is-ancestor\\\", earlier, later],\\n787\\t                         capture_output=True, check=False)\\n788\\t    return run.returncode == 0\\n789\\t\\n790\\t\\n791\\t# Maps whose keys are the records' data (a stage or an adapter that cost\\n792\\t# something), not a release's fields: a key missing from one is a difference.\\n793\\tDATA_KEYED = (\\\"by_stage_usd\\\", \\\"by_adapter_usd\\\")\\n794\\t\\n795\\t\\n796\\tdef _same(stated: Any, summed: Any) -> bool:\\n797\\t    \\\"\\\"\\\"Equal as the accounting means it: a number equals a number of the\\n798\\t    same value (a store may print 40.0 as 40), a bool equals only a bool,\\n799\\t    and a list is equal member by member. No tolerance and no conversion:\\n800\\t    both sides are the same function's rounding of the same records, and an\\n801\\t    int one past 2**53 is not the float beside it.\\\"\\\"\\\"\\n802\\t    if isinstance(stated, bool) or isinstance(summed, bool):\\n803\\t        return isinstance(stated, bool) and isinstance(summed, bool) and stated == summed\\n804\\t    if isinstance(stated, (int, float)) and isinstance(summed, (int, float)):\\n805\\t        return bool(stated == summed)\\n806\\t    if isinstance(stated, list) and isinstance(summed, list):\\n807\\t        return len(stated) == len(summed) and all(_same(a, b) for a, b in zip(stated, summed))\\n808\\t    return type(stated) is type(summed) and bool(stated == summed)\\n809\\t\\n810\\t\\n811\\tdef _differences(path: str, stated: Any, summed: Any, keyed_by_data: bool = False) -> list[str]:\\n812\\t    \\\"\\\"\\\"Every field of `stated` that is not what its records sum to, named by\\n813\\t    its path. Only the keys the statement carries are compared, at every\\n814\\t    depth, so a field a later release adds is not demanded of a statement\\n815\\t    sealed before it; a key it carries that the function does not produce\\n816\\t    is a difference.\\\"\\\"\\\"\\n817\\t    if not (isinstance(stated, dict) and isinstance(summed, dict)):\\n818\\t        return [] if _same(stated, summed) else [f\\\"{path} {stated!r} is not its records' {summed!r}\\\"]\\n819\\t    found: list[str] = []\\n820\\t    for key in sorted(stated):\\n821\\t        if key not in summed:\\n822\\t            found.append(f\\\"{path}.{key} {stated[key]!r} is not a field its records sum to\\\")\\n823\\t        else:\\n824\\t            found += _differences(f\\\"{path}.{key}\\\", stated[key], summed[key], key in DATA_KEYED)\\n825\\t    if keyed_by_data:\\n826\\t        found += [f\\\"{path}.{key} is absent; its records sum to {summed[key]!r}\\\"\\n827\\t                  for key in sorted(summed.keys() - stated.keys())]\\n828\\t    return found\\n829\\t\\n830\\t\\n831\\tdef _carried(predicate: dict[str, Any], key: str) -> str:\\n832\\t    return repr(predicate[key]) if key in predicate else \\\"absent\\\"\\n833\\t\\n834\\t\\n835\\tdef _accounting_disagrees(root: Path, item_records_dir: Path, item: str, merge_sha: str,\\n836\\t                          statement: dict[str, Any]) -> str | None:\\n837\\t    \\\"\\\"\\\"A sealed statement that carries `time` and `cost` says what its\\n838\\t    records sum to, field by field -- the same function attest summed them\\n839\\t    with, over the same records (none is written after a merge), sealed at\\n840\\t    the same commit (the statement is computed at the merge, so lead_s and\\n841\\t    waiting_s are recomputed from its committer time, not excepted). Exact:\\n842\\t    #202 retired the one-second tolerance. A statement sealed before `time`\\n843\\t    existed carries neither key and is not checked; a key that is present\\n844\\t    holds a block, so a null one, or one block without the other, is a\\n845\\t    disagreement. No new read of the store.\\\"\\\"\\\"\\n846\\t    inner = statement.get(\\\"predicate\\\")\\n847\\t    predicate = inner if isinstance(inner, dict) else statement\\n848\\t    if \\\"time\\\" not in predicate and \\\"cost\\\" not in predicate:\\n849\\t        return None\\n850\\t    stated_time, stated_cost = predicate.get(\\\"time\\\"), predicate.get(\\\"cost\\\")\\n851\\t    where = f\\\"item {item} merged at {merge_sha[:12]}\\\"\\n852\\t    if not isinstance(stated_time, dict) or not isinstance(stated_cost, dict):\\n853\\t        return (f\\\"{where}: the statement's time and cost are not both blocks \\\"\\n854\\t                f\\\"(time is {_carried(predicate, 'time')}, cost is {_carried(predicate, 'cost')})\\\")\\n855\\t    try:\\n856\\t        sealed_at: int | None = int(git(root, \\\"show\\\", \\\"-s\\\", \\\"--format=%ct\\\", merge_sha).strip())\\n857\\t    except (RuntimeError, ValueError):\\n858\\t        sealed_at = None\\n859\\t    summed_time, summed_cost = item_time_and_cost(item_records_dir, sealed_at)\\n860\\t    differing = (_differences(\\\"time\\\", stated_time, dict(summed_time))\\n861\\t                 + _differences(\\\"cost\\\", stated_cost, dict(summed_cost)))\\n862\\t    if differing:\\n863\\t        return f\\\"{where}: the statement's \\\" + \\\"; \\\".join(differing)\\n864\\t    return None\\n865\\t\\n866\\t\\n867\\tdef proof_every_attested_item_is_sealed(root: Path, m: dict[str, Any] | None) -> Proof:\\n868\\t    p = Proof(\\\"every-attested-item-is-sealed\\\", \\\"every attested item has its statement in the store\\\")\\n869\\t    if m is None:\\n870\\t        return p.fail(f\\\"no {MANIFEST} at {root}; no records directory is declared\\\")\\n871\\t    cmd = attestation_command(m)\\n872\\t    if cmd is None:\\n873\\t        return p.fail(\\\"no [forge].attestation_command in the manifest; the store cannot be read\\\")\\n874\\t    records_rel = m.get(\\\"paths\\\", {}).get(\\\"records\\\", \\\"\\\")\\n875\\t    records_dir = root / records_rel\\n876\\t    if not records_dir.is_dir():\\n877\\t        return p.fail(f\\\"no records directory under {records_dir}\\\")\\n878\\t    items = load_records(records_dir)\\n879\\t    complete = [item for item, stages in sorted(items.items()) if all(s in stages for s in STAGES)]\\n880\\t\\n881\\t    # [forge].sealed_since: merges at or before this commit are before the\\n882\\t    # window -- the tenant could not seal them (no queue, no signing\\n883\\t    # workflow, or a store that held nothing yet). They are named, never\\n884\\t    # failed. Absent, the window starts where proof three's does: the\\n885\\t    # install commit, or [doctor].from (issue #192).\\n886\\t    since = (m.get(\\\"forge\\\") or {}).get(\\\"sealed_since\\\")\\n887\\t    if not (isinstance(since, str) and since.strip()):\\n888\\t        try:\\n889\\t            since = proof_window_start(root, m)[1]\\n890\\t        except WindowRefused as exc:\\n891\\t            return p.fail(str(exc))\\n892\\t    merges, refusal = _merges_reachable(root)\\n893\\t    if refusal:\\n894\\t        return p.fail(refusal)\\n895\\t    sealed: list[str] = []\\n896\\t    before_window: list[str] = []\\n897\\t    unsealed: list[str] = []\\n898\\t    not_merged: list[str] = []\\n899\\t    not_read: list[str] = []\\n900\\t    reasons: list[str] = []\\n901\\t    for item in complete:\\n902\\t        merge_sha, _ = merge_introducing_records(root, records_rel, item, STAGES, merges=merges)\\n903\\t        if merge_sha is None:\\n904\\t            not_merged.append(item)\\n905\\t            continue\\n906\\t        if _is_ancestor(root, merge_sha, since):\\n907\\t            before_window.append(item)\\n908\\t            continue\\n909\\t        statement, exit_code = statement_for(root, cmd, merge_sha)\\n910\\t        if statement is not None:\\n911\\t            sealed.append(item)\\n912\\t            disagreement = _accounting_disagrees(root, records_dir / item, item, merge_sha,\\n913\\t                                                 statement)\\n914\\t            if disagreement:\\n915\\t                reasons.append(disagreement)\\n916\\t        elif exit_code == 2:\\n917\\t            not_read.append(item)\\n918\\t            reasons.append(f\\\"item {item} merged at {merge_sha[:12]}: not read -- \\\"\\n919\\t                           f\\\"the store could not be read; {cmd!r} exited 2\\\")\\n920\\t        else:\\n921\\t            unsealed.append(item)\\n922\\t            reasons.append(f\\\"item {item} merged at {merge_sha[:12]} has no statement in the store\\\")\\n923\\t    if reasons:\\n924\\t        return p.fail(\\\"; \\\".join(reasons), sealed=sealed, before_window=before_window,\\n925\\t                      unsealed=unsealed, not_merged=not_merged, not_read=not_read)\\n926\\t    window = f\\\" at {since[:12]}\\\" if before_window else \\\"\\\"\\n927\\t    return p.hold(f\\\"{len(sealed)} sealed, {len(before_window)} before the window{window}, \\\"\\n928\\t                 f\\\"{len(not_merged)} not merged\\\",\\n929\\t                 sealed=sealed, before_window=before_window, unsealed=unsealed,\\n930\\t                 not_merged=not_merged, not_read=not_read)\\n931\\t\\n932\\t\\n933\\tdef proof_no_attested_item_is_empty(root: Path, m: dict[str, Any] | None) -> Proof:\\n934\\t    \\\"\\\"\\\"Proof seven (item 227). Every merged, fully-staged item's passing\\n935\\t    build names a change: its tree, restricted to the item's own spec\\n936\\t    claims, differs from the approved tree there (item 229 -- asked\\n937\\t    against the approval, not the build's own start_sha, so a build\\n938\\t    that adopted a prior attempt's valid commits is not empty just\\n939\\t    because that attempt owed no commit of its own; scoped to claims,\\n940\\t    not \\\"everything outside paths.records\\\", so a commit that lands\\n941\\t    between approval and a later attempt's start but touches no\\n942\\t    claimed path never rescues or defeats the comparison on its own\\n943\\t    account). Item 227 was specified, approved, built by one\\n944\\t    invocation, judged by another, merged and sealed, and its build\\n945\\t    committed nothing -- the executor left the stub in the working tree,\\n946\\t    the gate read the tree, and main received the spec and none of the\\n947\\t    change. Six proofs held over it.\\n948\\t\\n949\\t    [doctor].built_since: merges at or before this commit are before the\\n950\\t    window -- named, never failed -- so the specimen stands on every\\n951\\t    doctor run without failing the tenant forever. Absent, the window is\\n952\\t    proof three's. A build record whose approval cannot be resolved\\n953\\t    (no approval_sha at all, or one this repository cannot read) is\\n954\\t    named as not readable, not failed.\\\"\\\"\\\"\\n955\\t    p = Proof(\\\"no-attested-item-is-empty\\\", \\\"every attested item's build names a change\\\")\\n956\\t    if m is None:\\n957\\t        return p.fail(f\\\"no {MANIFEST} at {root}; no records directory is declared\\\")\\n958\\t    records_rel = m.get(\\\"paths\\\", {}).get(\\\"records\\\", \\\"\\\")\\n959\\t    specs_rel = m.get(\\\"paths\\\", {}).get(\\\"specs\\\", \\\"\\\")\\n960\\t    records_dir = root / records_rel\\n961\\t    if not records_dir.is_dir():\\n962\\t        return p.fail(f\\\"no records directory under {records_dir}\\\")\\n963\\t    items = load_records(records_dir)\\n964\\t    complete = [item for item, stages in sorted(items.items()) if all(s in stages for s in STAGES)]\\n965\\t    since = (m.get(\\\"doctor\\\") or {}).get(\\\"built_since\\\")\\n966\\t    if not (isinstance(since, str) and since.strip()):\\n967\\t        try:\\n968\\t            since = proof_window_start(root, m)[1]\\n969\\t        except WindowRefused as exc:\\n970\\t            return p.fail(str(exc))\\n971\\t    else:\\n972\\t        try:\\n973\\t            since = git(root, \\\"rev-parse\\\", \\\"--verify\\\", f\\\"{since}^{{commit}}\\\").strip()\\n974\\t        except RuntimeError:\\n975\\t            return p.fail(f\\\"[doctor] built_since {since} does not resolve to a commit\\\")\\n976\\t    merges, refusal = _merges_reachable(root)\\n977\\t    if refusal:\\n978\\t        return p.fail(refusal)\\n979\\t    built: list[str] = []\\n980\\t    before_window: list[str] = []\\n981\\t    not_merged: list[str] = []\\n982\\t    not_read: list[str] = []\\n983\\t    empty: list[str] = []\\n984\\t    for item in complete:\\n985\\t        merge_sha, _ = merge_introducing_records(root, records_rel, item, STAGES, merges=merges)\\n986\\t        if merge_sha is None:\\n987\\t            not_merged.append(item)\\n988\\t            continue\\n989\\t        if _is_ancestor(root, merge_sha, since):\\n990\\t            before_window.append(item)\\n991\\t            continue\\n992\\t        build = items[item][\\\"build\\\"]\\n993\\t        sha, approval_sha = build.get(\\\"sha\\\"), build.get(\\\"approval_sha\\\")\\n994\\t        if not sha or not approval_sha:\\n995\\t            not_read.append(item)\\n996\\t            continue\\n997\\t        spec_md = root / specs_rel / item / \\\"spec.md\\\"\\n998\\t        claims: list[str] = []\\n999\\t        if spec_md.is_file():\\n1000\\t            parsed, _ = parse_spec(spec_md)\\n1001\\t            claims = parsed[\\\"claims\\\"] if parsed else []\\n1002\\t        is_empty = build_is_empty(root, approval_sha, sha, claims)\\n1003\\t        if is_empty is None:\\n1004\\t            not_read.append(item)\\n1005\\t        elif is_empty:\\n1006\\t            empty.append(f\\\"item {item} merged at {merge_sha[:12]}: build names no \\\"\\n1007\\t                         \\\"claimed change; nothing was built\\\")\\n1008\\t        else:\\n1009\\t            built.append(item)\\n1010\\t    if empty:\\n1011\\t        return p.fail(\\\"; \\\".join(empty), built=built, before_window=before_window,\\n1012\\t                      not_merged=not_merged, not_read=not_read)\\n1013\\t    window = f\\\" at {since[:12]}\\\" if before_window else \\\"\\\"\\n1014\\t    return p.hold(f\\\"{len(built)} built, {len(before_window)} before the window{window}, \\\"\\n1015\\t                  f\\\"{len(not_read)} without a readable approval, {len(not_merged)} not merged\\\",\\n1016\\t                  built=built, before_window=before_window, not_merged=not_merged,\\n1017\\t                  not_read=not_read)\\n1018\\t\\n1019\\t\\n1020\\tdef doctor(root: Path) -> list[Proof]:\\n1021\\t    m = read_manifest(root)\\n1022\\t    return [proof_every_gate_rejects(root, m),\\n1023\\t            proof_one_item_every_stage(root, m),\\n1024\\t            proof_no_commit_lacks_record(root, m),\\n1025\\t            proof_no_stop_lacks_cause(root, m),\\n1026\\t            proof_no_invocation_lacks_record(root, m),\\n1027\\t            proof_every_attested_item_is_sealed(root, m),\\n1028\\t            proof_no_attested_item_is_empty(root, m)]\\n1029\\t\\n1030\\t\\n1031\\tdef cmd_doctor(argv: list[str]) -> int:\\n1032\\t    as_json = \\\"--json\\\" in argv\\n1033\\t    args = [a for a in argv if a != \\\"--json\\\"]\\n1034\\t    root = Path(args[0] if args else \\\".\\\").resolve()\\n1035\\t    proofs = doctor(root)\\n1036\\t    if as_json:\\n1037\\t        print(json.dumps({\\\"root\\\": str(root), \\\"done\\\": all(p.holds for p in proofs),\\n1038\\t                          \\\"proofs\\\": [p.as_dict() for p in proofs]}, indent=2))\\n1039\\t    else:\\n1040\\t        for i, p in enumerate(proofs, 1):\\n1041\\t            print(f\\\"proof {i} {p.key}: {'HOLDS' if p.holds else 'FAILS'}: {p.reason}\\\")\\n1042\\t        print(\\\"doctor: done\\\" if all(p.holds for p in proofs)\\n1043\\t              else f\\\"doctor: not done ({sum(not p.holds for p in proofs)} of \\\"\\n1044\\t                   f\\\"{len(proofs)} proofs fail)\\\")\\n1045\\t    return 0 if all(p.holds for p in proofs) else 1\\n1046\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"b3f717aa-5c2b-4867-b022-0f24cffb6427\",\"uuid\":\"14639bdd-4c00-4715-9dcb-f63d6c8e9c2d\",\"timestamp\":\"2026-09-30T23:05:36.707Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/davidbean/Projects/attavo-worktree-289/attavo/doctor.py\",\"content\":\"from __future__ import annotations\\n\\nimport fnmatch\\nimport json\\nimport os\\nimport re\\nimport subprocess\\nfrom pathlib import Path\\nfrom typing import Any\\n\\nfrom attavo import clock\\nfrom attavo.attest import check_attest_chain, item_time_and_cost\\nfrom attavo.build import build_is_empty, driver_identity\\nfrom attavo.common import (\\n    MANIFEST,\\n    Proof,\\n    STAGES,\\n    fixture_item_id,\\n    git,\\n    product_version,\\n    read_manifest,\\n)\\nfrom attavo.events import stage_events_dir\\nfrom attavo.records import RECORD_RE, load_records, parse_attempts\\nfrom attavo.spec import parse_spec\\nfrom attavo.stops import (\\n    STOP_CLASSES,\\n    STOP_PROVENANCES,\\n    STOP_REDERIVABLE_FROM,\\n    STOP_STAGES,\\n    gate_stop,\\n    is_recovery_stop,\\n    recovery_fault,\\n    rederive_stop,\\n)\\n\\n# --- doctor's three proofs ---\\n\\ndef proof_every_gate_rejects(root: Path, m: dict[str, Any] | None) -> Proof:\\n    p = Proof(\\\"every-gate-rejects\\\", \\\"every gate rejects its fixture\\\")\\n    if m is None:\\n        return p.fail(f\\\"no {MANIFEST} at {root}; no gate is registered\\\")\\n    gates = m.get(\\\"gates\\\") or {}\\n    if not gates:\\n        return p.fail(\\\"[gates] is empty; a gate that has rejected nothing does not exist\\\")\\n    fixtures = root / m.get(\\\"paths\\\", {}).get(\\\"rejections\\\", \\\"\\\")\\n    # Proposal, not yet ruled on (issue #54): a gate that retires nothing\\n    # only adds, so proof one reports it here rather than waiting on the\\n    # schema alone -- read_manifest never validates against the manifest\\n    # schema at runtime, so a schema requirement is not an enforced one.\\n    no_retires = [name for name, gate in sorted(gates.items()) if not gate.get(\\\"retires\\\")]\\n    missing, accepted = [], []\\n    for name, gate in sorted(gates.items()):\\n        fixture = fixtures / name\\n        if not fixture.is_dir():\\n            missing.append(name)\\n            continue\\n        env = dict(os.environ)\\n        item = fixture_item_id(fixture)\\n        if item is not None:\\n            env[\\\"ATTAVO_ITEM\\\"] = item\\n        run = subprocess.run(gate[\\\"command\\\"], shell=True, cwd=str(fixture),\\n                             capture_output=True, text=True, check=False, env=env)\\n        if run.returncode == 0:\\n            accepted.append(name)\\n    if missing:\\n        return p.fail(f\\\"gate(s) with no rejection fixture: {', '.join(missing)}\\\")\\n    if accepted:\\n        return p.fail(f\\\"gate(s) that accepted their rejection fixture: {', '.join(accepted)}\\\")\\n    if no_retires:\\n        return p.fail(f\\\"gate(s) with no retires: {', '.join(no_retires)}\\\")\\n    return p.hold(f\\\"{len(gates)} gate(s) rejected their fixture\\\")\\n\\n\\ndef _merges_reachable(root: Path, ref: str | None = None) -> tuple[list[dict[str, Any]], str | None]:\\n    \\\"\\\"\\\"(merges, refusal): every merge commit on the default branch's own\\n    first-parent line -- sha, parents, and its own first-parent diff --\\n    read by one process rather than the git log plus one git diff per\\n    merge merge_introducing_records used to pay walking toward the one\\n    it wants (issue #153). refs/remotes/origin/HEAD names the default\\n    branch without hard-coding \\\"main\\\", the same primitive\\n    diff_since_approval already uses (issue #52); walking from it rather\\n    than from HEAD is what keeps a transport merge on an item branch, a\\n    pull_request checkout's own synthetic test merge, and a merge_group's\\n    temporary merge from ever being mistaken for an item's merge (issue\\n    #169) -- none of those is reachable from the default branch's first-\\n    parent line by definition. When refs/remotes/origin/HEAD is not set,\\n    this refuses by name rather than guess, exactly as diff_since_approval\\n    does.\\n\\n    The walk starts at HEAD itself when the current checkout is literally\\n    on the branch refs/remotes/origin/HEAD names (an ordinary checkout of\\n    the default branch, on push or on a developer's own machine) and at\\n    the remote-tracking ref's own value otherwise (any other branch, or\\n    the detached HEAD a pull_request or merge_group checkout leaves\\n    behind) -- HEAD only ever *is* the default branch's first-parent line\\n    in the former case; in the latter, only the remote-tracking ref names\\n    it. --diff-merges=first-parent gives each merge's diff against its\\n    first parent in the same pass git log --merges already makes to list\\n    them, in the same order, newest first.\\\"\\\"\\\"\\n    symref = subprocess.run(\\n        [\\\"git\\\", \\\"-C\\\", str(root), \\\"symbolic-ref\\\", \\\"-q\\\", \\\"refs/remotes/origin/HEAD\\\"],\\n        capture_output=True, text=True, check=False)\\n    if symref.returncode != 0:\\n        return [], \\\"refs/remotes/origin/HEAD is not set; run `git remote set-head origin -a`\\\"\\n    default_remote_ref = symref.stdout.strip()\\n    default_branch = default_remote_ref.rsplit(\\\"/\\\", 1)[-1]\\n    current_branch = subprocess.run(\\n        [\\\"git\\\", \\\"-C\\\", str(root), \\\"symbolic-ref\\\", \\\"-q\\\", \\\"--short\\\", \\\"HEAD\\\"],\\n        capture_output=True, text=True, check=False)\\n    default_ref = ref or (\\\"HEAD\\\" if current_branch.returncode == 0\\n                          and current_branch.stdout.strip() == default_branch\\n                          else default_remote_ref)\\n    try:\\n        out = git(root, \\\"log\\\", default_ref, \\\"--first-parent\\\", \\\"--merges\\\",\\n                 \\\"--diff-merges=first-parent\\\", \\\"--name-only\\\",\\n                 \\\"--format=\\\\x01%H\\\\x1f%P\\\")\\n    except RuntimeError:\\n        return [], None\\n    merges = []\\n    for block in out.split(\\\"\\\\x01\\\")[1:]:\\n        header, _, rest = block.partition(\\\"\\\\n\\\")\\n        sha, parents = header.split(\\\"\\\\x1f\\\")\\n        merges.append({\\\"sha\\\": sha, \\\"parents\\\": parents.split(),\\n                       \\\"touched\\\": [line for line in rest.splitlines() if line.strip()]})\\n    return merges, None\\n\\n\\ndef merge_introducing_records(root: Path, records_rel: str, item: str,\\n                              stages: tuple[str, ...],\\n                              merges: list[dict[str, Any]] | None = None) -> tuple[str | None, str | None]:\\n    \\\"\\\"\\\"(merge_sha, refusal): the merge commit on the default branch's own\\n    first-parent line whose first-parent diff introduces a record for\\n    every one of stages, under records_rel/item/ -- the same derivation\\n    attest itself uses (derive_attest_items), read here so proof two\\n    requires an item's stage records to have arrived by an actual merge\\n    on the default branch, not merely to sit in the tree, and not by a\\n    transport merge, a pull_request checkout's synthetic test merge, or a\\n    merge_group's temporary merge (issue #69 acceptance row 4; issue\\n    #169). merge_sha is None with no refusal when no such merge exists\\n    yet -- the item is not merged, not that the walk failed.\\n\\n    merges, when given, is _merges_reachable's own result -- ledger's\\n    cmd_ledger computes it once and passes it to every item rather than\\n    walking the default branch's merges again for each (issue #153); a\\n    caller that already has merges has also already handled\\n    _merges_reachable's refusal, so this never re-derives one. Left\\n    None, a caller with just the one item to ask (doctor's proof two)\\n    gets merges computed here, refusal and all.\\\"\\\"\\\"\\n    if merges is None:\\n        merges, refusal = _merges_reachable(root)\\n        if refusal:\\n            return None, refusal\\n    prefix = f\\\"{records_rel.rstrip('/')}/{item}/\\\"\\n    for merge in merges:\\n        found: set[str] = set()\\n        for p in merge[\\\"touched\\\"]:\\n            if p.startswith(prefix):\\n                m = RECORD_RE.match(Path(p).name)\\n                if m:\\n                    found.add(m.group(1))\\n        if all(s in found for s in stages):\\n            return merge[\\\"sha\\\"], None\\n    return None, None\\n\\n\\nINVOCATION_MARKER_SUFFIX = \\\".started\\\"\\n\\n\\ndef invocation_marker_path(records_dir: Path, stage: str, nn: int) -> Path:\\n    return records_dir / f\\\"{stage}-{nn:02d}{INVOCATION_MARKER_SUFFIX}\\\"\\n\\n\\ndef heartbeat_s() -> float:\\n    return float(os.environ.get(\\\"ATTAVO_HEARTBEAT_S\\\", 15))\\n\\n\\ndef heartbeat_path(root: Path, stage: str, nn: int) -> Path:\\n    return stage_events_dir(root) / f\\\"{stage}-{nn:02d}.heartbeat\\\"\\n\\n\\ndef heartbeat_pid(path: Path) -> int | None:\\n    \\\"\\\"\\\"The pid the worker wrote as its heartbeat file's one line on its\\n    first beat -- the holder's own, the only pid anyone signals. None when\\n    the file is absent, unreadable, empty (a worker from before this\\n    release touched it and wrote nothing), or not a positive integer.\\\"\\\"\\\"\\n    try:\\n        text = path.read_text().strip()\\n    except OSError:\\n        return None\\n    if not text.isdigit() or int(text) <= 0:\\n        return None\\n    return int(text)\\n\\n\\ndef heartbeat_age_s(path: Path) -> float | None:\\n    \\\"\\\"\\\"Seconds since the heartbeat file was last touched; None when there\\n    is no such file.\\\"\\\"\\\"\\n    try:\\n        return clock.now() - path.stat().st_mtime\\n    except OSError:\\n        return None\\n\\n\\ndef write_invocation_marker(root: Path, records_dir: Path, stage: str, nn: int,\\n                            again_by: str | None = None) -> Path:\\n    \\\"\\\"\\\"The fact that an invocation began, written before it does: at,\\n    host, the sha it starts on, and the product that started it. No pid:\\n    the writer is `attavo drive`, which returns seconds later, and the\\n    process that holds the stage is the worker, whose own heartbeat is\\n    the fact of holding it. Its record's arrival is what retires a\\n    marker; a marker with no record is an invocation that died or hangs,\\n    and proof five names it. again_by is the login that pressed `--again`\\n    to reset a stage whose budget was spent (or whose last two signatures\\n    matched) -- absent on every ordinary marker, never a bare false.\\\"\\\"\\\"\\n    import socket\\n    from datetime import datetime, timezone\\n    records_dir.mkdir(parents=True, exist_ok=True)\\n    path = invocation_marker_path(records_dir, stage, nn)\\n    sha = git(root, \\\"rev-parse\\\", \\\"HEAD\\\").strip()\\n    info: dict[str, Any] = {\\\"at\\\": datetime.now(timezone.utc).strftime(\\\"%Y-%m-%dT%H:%M:%SZ\\\"),\\n                            \\\"host\\\": socket.gethostname(), \\\"sha\\\": sha,\\n                            \\\"product_version\\\": product_version()}\\n    if again_by:\\n        info[\\\"again_by\\\"] = again_by\\n    path.write_text(json.dumps(info, indent=2) + \\\"\\\\n\\\")\\n    return path\\n\\n\\ndef invocation_age_s(info: dict[str, Any]) -> float | None:\\n    \\\"\\\"\\\"Seconds since the marker's own `at` timestamp -- how long ago the\\n    invocation it names began, whatever host wrote it. None when `at` is\\n    missing or does not parse.\\\"\\\"\\\"\\n    from datetime import datetime, timezone\\n    at = info.get(\\\"at\\\")\\n    if not isinstance(at, str):\\n        return None\\n    try:\\n        stamp = datetime.strptime(at, \\\"%Y-%m-%dT%H:%M:%SZ\\\").replace(tzinfo=timezone.utc)\\n    except ValueError:\\n        return None\\n    return clock.now() - stamp.timestamp()\\n\\n\\ndef invocations_without_record(item_records_dir: Path) -> list[tuple[Path, dict[str, Any]]]:\\n    \\\"\\\"\\\"Every <stage>-NN.started under one item whose <stage>-NN.json has\\n    not arrived, with the marker's own dict ({} when unreadable).\\\"\\\"\\\"\\n    out: list[tuple[Path, dict[str, Any]]] = []\\n    if not item_records_dir.is_dir():\\n        return out\\n    for marker in sorted(item_records_dir.glob(f\\\"*{INVOCATION_MARKER_SUFFIX}\\\")):\\n        if (item_records_dir / f\\\"{marker.stem}.json\\\").is_file():\\n            continue\\n        try:\\n            with marker.open() as fh:\\n                info = json.load(fh)\\n        except (OSError, ValueError):\\n            info = {}\\n        out.append((marker, info if isinstance(info, dict) else {}))\\n    return out\\n\\n\\ndef stall_bound_s(m: dict[str, Any]) -> int | None:\\n    \\\"\\\"\\\"[drive].stall_after_s: the tenant's own bound past which a live\\n    invocation with no new event is hung. A bound the tenant did not\\n    write is a forecast, so there is no default.\\\"\\\"\\\"\\n    bound = (m.get(\\\"drive\\\") or {}).get(\\\"stall_after_s\\\")\\n    if isinstance(bound, bool) or not isinstance(bound, (int, float)) or bound <= 0:\\n        return None\\n    return int(bound)\\n\\n\\ndef ceiling_s(m: dict[str, Any], stage: str) -> int | None:\\n    \\\"\\\"\\\"R3: [drive.<stage>].ceiling_s, the wall clock past which a live\\n    invocation of that stage is hung by its ceiling, whatever event age\\n    says (or does not say, for an adapter that streams none). No\\n    default: a ceiling the tenant did not declare is not assumed.\\\"\\\"\\\"\\n    value = ((m.get(\\\"drive\\\") or {}).get(stage) or {}).get(\\\"ceiling_s\\\")\\n    if isinstance(value, bool) or not isinstance(value, (int, float)) or value <= 0:\\n        return None\\n    return int(value)\\n\\n\\ndef attempts_budget(m: dict[str, Any]) -> int:\\n    \\\"\\\"\\\"R3: [drive].attempts, the attempts a stage may spend -- across a\\n    plain retry, a returned retry, and a steered one alike -- before the\\n    item is a person's; 3 when the manifest does not say.\\\"\\\"\\\"\\n    value = (m.get(\\\"drive\\\") or {}).get(\\\"attempts\\\")\\n    if isinstance(value, bool) or not isinstance(value, int) or value < 1:\\n        return 3\\n    return value\\n\\n\\ndef retry_after_s(m: dict[str, Any]) -> int:\\n    \\\"\\\"\\\"R3: [drive].retry_after_s, the wait a transient stop's record sits\\n    through before its next attempt starts; 300 when the manifest does\\n    not say.\\\"\\\"\\\"\\n    value = (m.get(\\\"drive\\\") or {}).get(\\\"retry_after_s\\\")\\n    if isinstance(value, bool) or not isinstance(value, (int, float)) or value < 0:\\n        return 300\\n    return int(value)\\n\\n\\ndef proof_no_invocation_lacks_record(root: Path, m: dict[str, Any] | None) -> Proof:\\n    import socket\\n    p = Proof(\\\"no-invocation-lacks-record\\\", \\\"no invocation lacks its record\\\")\\n    if m is None:\\n        return p.fail(f\\\"no {MANIFEST} at {root}; no records directory is declared\\\")\\n    records_rel = m.get(\\\"paths\\\", {}).get(\\\"records\\\", \\\"\\\")\\n    records_dir = root / records_rel\\n    if not records_dir.is_dir():\\n        return p.fail(f\\\"no records directory under {records_dir}\\\")\\n    bound = stall_bound_s(m)\\n    if bound is None:\\n        return p.fail(\\\"no [drive].stall_after_s in the manifest; a hung invocation cannot be \\\"\\n                      \\\"told from a running one\\\")\\n    # R3: a stage with no ceiling can run forever unjudged even when\\n    # stall_after_s is set (an adapter that streams no events trips no\\n    # stall bound at all) -- refused the same way stall_after_s's own\\n    # absence is, not folded into it, so the reason names exactly which\\n    # keys the manifest is missing.\\n    missing_ceilings = [f\\\"[drive.{stage}].ceiling_s\\\" for stage in (\\\"build\\\", \\\"verify\\\")\\n                        if ceiling_s(m, stage) is None]\\n    if missing_ceilings:\\n        return p.fail(f\\\"no {' or '.join(missing_ceilings)} in the manifest; a stage with no \\\"\\n                      f\\\"ceiling can run forever unjudged (R3)\\\")\\n    if (m.get(\\\"drive\\\") or {}).get(\\\"attempts\\\") is None:\\n        return p.fail(\\\"no [drive].attempts in the manifest; a retryable stop would spend an \\\"\\n                      \\\"unbounded number of attempts (R3)\\\")\\n    this_host = socket.gethostname()\\n    recorded = 0\\n    running: list[str] = []\\n    in_flight: list[str] = []\\n    problems: list[str] = []\\n    for item_dir in sorted(d for d in records_dir.iterdir() if d.is_dir()):\\n        for marker in item_dir.glob(f\\\"*{INVOCATION_MARKER_SUFFIX}\\\"):\\n            if (item_dir / f\\\"{marker.stem}.json\\\").is_file():\\n                recorded += 1\\n        for marker, info in invocations_without_record(item_dir):\\n            name = f\\\"item {item_dir.name} {marker.stem}\\\"\\n            stage, nn_text = marker.stem.rsplit(\\\"-\\\", 1)\\n            try:\\n                beat_age = heartbeat_age_s(heartbeat_path(root, stage, int(nn_text)))\\n            except (RuntimeError, ValueError):\\n                beat_age = None\\n            if beat_age is not None:\\n                # The holder's own fact: fresh within three beats is\\n                # running, older is a holder that stopped touching it.\\n                if beat_age <= heartbeat_s() * 3:\\n                    running.append(f\\\"{name} (heartbeat {int(beat_age)} s old, since {info.get('at')})\\\")\\n                    continue\\n            elif info.get(\\\"host\\\") != this_host:\\n                # No heartbeat file readable from here for a marker from\\n                # another host: not yet a failure. An invocation younger\\n                # than the tenant's own stall bound may simply be running\\n                # elsewhere, still writing toward its own record.\\n                age = invocation_age_s(info)\\n                if age is not None and age < bound:\\n                    in_flight.append(f\\\"{name} (host {info.get('host')} since {info.get('at')})\\\")\\n                    continue\\n            problems.append(f\\\"{name} started {info.get('at')} on {info.get('host')} \\\"\\n                            f\\\"and never wrote its record\\\")\\n    if problems:\\n        return p.fail(\\\"; \\\".join(problems), unrecorded_invocations=len(problems),\\n                      running_invocations=running, in_flight=in_flight)\\n    return p.hold(f\\\"{recorded} invocation(s) recorded, {len(running)} running, \\\"\\n                  f\\\"{len(in_flight)} in flight elsewhere\\\",\\n                  unrecorded_invocations=0, running_invocations=running, in_flight=in_flight)\\n\\n\\ndef proof_one_item_every_stage(root: Path, m: dict[str, Any] | None) -> Proof:\\n    p = Proof(\\\"one-item-every-stage\\\", \\\"one item has traversed every stage\\\")\\n    if m is None:\\n        return p.fail(f\\\"no {MANIFEST} at {root}; no records directory is declared\\\")\\n    records_rel = m.get(\\\"paths\\\", {}).get(\\\"records\\\", \\\"\\\")\\n    records_dir = root / records_rel\\n    items = load_records(records_dir)\\n    if not items:\\n        return p.fail(f\\\"no work item under {records_dir.relative_to(root)}\\\")\\n    complete = [item for item, stages in items.items() if all(s in stages for s in STAGES)]\\n    if not complete:\\n        best = max(items.items(), key=lambda kv: len(kv[1]))\\n        lacking = [s for s in STAGES if s not in best[1]]\\n        return p.fail(f\\\"no item carries every stage; item {best[0]} lacks {', '.join(lacking)}\\\")\\n\\n    # issue #74: a complete item is counted only when its chain holds --\\n    # attavo attest refuses a build re-approved after the fact or a\\n    # verify whose build went stale, and the coherence gate refuses the\\n    # merge group on exactly that; a proof that never asked would call a\\n    # traversal the gate itself would not let through. The refusal text\\n    # is check_attest_chain's own, never re-typed here.\\n    refused, held, unmerged = [], [], []\\n    for item in complete:\\n        chain, message = check_attest_chain(records_dir / item, item)\\n        if chain is None:\\n            refused.append(f\\\"item {item}: {message}\\\")\\n            continue\\n        merge_sha, merge_refusal = merge_introducing_records(root, records_rel, item, STAGES)\\n        if merge_refusal:\\n            return p.fail(merge_refusal)\\n        if merge_sha:\\n            held.append((item, merge_sha))\\n        else:\\n            unmerged.append(item)\\n\\n    if held:\\n        names = \\\", \\\".join(item for item, _ in held)\\n        shas = \\\", \\\".join(sha[:12] for _, sha in held)\\n        return p.hold(f\\\"item(s) {names} carry {', '.join(STAGES)} with the chain held, \\\"\\n                      f\\\"merged at {shas}\\\")\\n    if refused:\\n        return p.fail(\\\"; \\\".join(refused))\\n    return p.fail(f\\\"item(s) {', '.join(unmerged)} carry every stage with the chain held but no \\\"\\n                  f\\\"merge commit's first-parent diff introduces all of them\\\")\\n\\n\\ndef commit_subject(root: Path, sha: str) -> str:\\n    return git(root, \\\"log\\\", \\\"-1\\\", \\\"--format=%s\\\", sha).strip()\\n\\n\\ndef touches_boundary(root: Path, sha: str, boundary_paths: list[str]) -> bool:\\n    \\\"\\\"\\\"Whether sha's first-parent diff touches a path [spec.boundary].paths\\n    declares governed -- an ordinary merge that does is a boundary\\n    evasion (issue #72): the tenant carried a governed change around the\\n    path the manifest itself names.\\\"\\\"\\\"\\n    diff = git(root, \\\"diff\\\", \\\"--name-only\\\", f\\\"{sha}^1\\\", sha).splitlines()\\n    return any(fnmatch.fnmatch(path, pattern) for path in diff for pattern in boundary_paths)\\n\\n\\nclass WindowRefused(Exception):\\n    \\\"\\\"\\\"The window start cannot be computed; str(exc) is the refusal.\\\"\\\"\\\"\\n\\n\\ndef proof_window_start(root: Path, m: dict[str, Any]) -> tuple[str, str, list[str]]:\\n    \\\"\\\"\\\"(install commit, window start, first-parent chain after the install\\n    commit): where proofs three and six start reading. The start is\\n    [doctor].from if the tenant set it, otherwise the commit that\\n    introduced the manifest (issue #192: proof six reads this too, so the\\n    two proofs cannot disagree).\\\"\\\"\\\"\\n    try:\\n        install = git(root, \\\"log\\\", \\\"--diff-filter=A\\\", \\\"--format=%H\\\",\\n                      \\\"--reverse\\\", \\\"--\\\", MANIFEST).split()\\n    except RuntimeError as exc:\\n        raise WindowRefused(f\\\"git: {exc}\\\") from exc\\n    if not install:\\n        raise WindowRefused(f\\\"{MANIFEST} is not committed; the tenant has no record boundary\\\")\\n    install_sha = install[0]\\n    full_chain = git(root, \\\"rev-list\\\", f\\\"{install_sha}..HEAD\\\", \\\"--first-parent\\\").split()\\n\\n    # issue #74: [doctor] from lets a tenant declare the doctor's read to\\n    # start at a later commit on main's first-parent line -- the point\\n    # after which every push arrived through the queue -- rather than the\\n    # install commit, which on a repository that adopted the product\\n    # after its history began is a boundary the doctor cannot otherwise\\n    # see. Any spelling git resolves is accepted (a short sha, a tag, a\\n    # ref) -- resolved with rev-parse --verify before the first-parent\\n    # check runs, so the two failure modes stay distinct: a spelling that\\n    # names no commit at all, and a commit that names one off the line.\\n    # Checked, not trusted: neither is silently forgiven back to install.\\n    declared_from = (m.get(\\\"doctor\\\") or {}).get(\\\"from\\\")\\n    window_start = install_sha\\n    if declared_from is not None:\\n        try:\\n            resolved_from = git(root, \\\"rev-parse\\\", \\\"--verify\\\", f\\\"{declared_from}^{{commit}}\\\").strip()\\n        except RuntimeError:\\n            raise WindowRefused(f\\\"[doctor] from {declared_from} does not resolve to a commit\\\") from None\\n        if resolved_from != install_sha and resolved_from not in full_chain:\\n            raise WindowRefused(f\\\"[doctor] from {declared_from} is not on main's first-parent \\\"\\n                                f\\\"line after the install commit {install_sha[:12]}\\\")\\n        window_start = resolved_from\\n    return install_sha, window_start, full_chain\\n\\n\\ndef proof_no_commit_lacks_record(root: Path, m: dict[str, Any] | None) -> Proof:\\n    p = Proof(\\\"no-commit-lacks-record\\\", \\\"no commit lacks a record\\\")\\n    if m is None:\\n        return p.fail(f\\\"no {MANIFEST} at {root}; the tenant has no record boundary\\\")\\n    try:\\n        install_sha, window_start, full_chain = proof_window_start(root, m)\\n    except WindowRefused as exc:\\n        return p.fail(str(exc))\\n    if not full_chain:\\n        return p.fail(f\\\"no commit after the install commit {install_sha[:12]}; nothing has been recorded\\\")\\n\\n    if window_start == install_sha:\\n        window_spec = f\\\"{install_sha}..HEAD\\\"\\n        commits = full_chain\\n    else:\\n        window_spec = f\\\"{window_start}^..HEAD\\\"\\n        commits = git(root, \\\"rev-list\\\", window_spec, \\\"--first-parent\\\").split()\\n    before_window = len(full_chain) - len(commits)\\n\\n    records_rel = m.get(\\\"paths\\\", {}).get(\\\"records\\\", \\\"\\\")\\n    records_dir = root / records_rel\\n    named: set[str] = set()\\n    for stages in load_records(records_dir).values():\\n        for rec in stages.values():\\n            sha = rec.get(\\\"sha\\\")\\n            if isinstance(sha, str):\\n                named.add(sha)\\n            for c in rec.get(\\\"commits\\\", []) or []:\\n                if isinstance(c, str):\\n                    named.add(c)\\n    record_commits = set(git(root, \\\"rev-list\\\", window_spec, \\\"--first-parent\\\",\\n                             \\\"--\\\", records_rel).split()) if records_rel else set()\\n    merges = set(git(root, \\\"rev-list\\\", window_spec, \\\"--first-parent\\\", \\\"--merges\\\").split())\\n    boundary_paths = ((m.get(\\\"spec\\\") or {}).get(\\\"boundary\\\") or {}).get(\\\"paths\\\") or []\\n\\n    # Every first-parent commit in the window is exactly one of three\\n    # (issue #72): recorded (a record names it, or its diff touches\\n    # paths.records), ordinary (a merge that doesn't), or unrecorded\\n    # (anything else -- on a protected main with a queue, a non-merge\\n    # commit is the only way a change arrives without the forge).\\n    recorded, ordinary, unrecorded = [], [], []\\n    ordinary_commits, unrecorded_commits = [], []\\n    boundary_evasions = 0\\n    for c in commits:\\n        if c in named or c in record_commits:\\n            recorded.append(c)\\n        elif c in merges:\\n            ordinary.append(c)\\n            evasion = bool(boundary_paths and touches_boundary(root, c, boundary_paths))\\n            if evasion:\\n                boundary_evasions += 1\\n            ordinary_commits.append({\\\"sha\\\": c, \\\"subject\\\": commit_subject(root, c),\\n                                     \\\"boundary_evasion\\\": evasion})\\n        else:\\n            unrecorded.append(c)\\n            unrecorded_commits.append({\\\"sha\\\": c, \\\"subject\\\": commit_subject(root, c)})\\n\\n    not_transport = driver_commits_not_transport(root, window_spec, records_rel) if records_rel else []\\n    counts = f\\\"{len(recorded)} recorded, {len(ordinary)} ordinary, {len(unrecorded)} unrecorded\\\"\\n    evasions = boundary_evasions if boundary_paths else \\\"n/a\\\"\\n    extra = {\\\"recorded\\\": len(recorded), \\\"ordinary\\\": len(ordinary),\\n             \\\"unrecorded\\\": len(unrecorded), \\\"boundary_evasions\\\": evasions,\\n             \\\"before_window\\\": before_window,\\n             \\\"ordinary_commits\\\": ordinary_commits, \\\"unrecorded_commits\\\": unrecorded_commits,\\n             \\\"driver_commits_not_transport\\\": not_transport}\\n    if not_transport:\\n        return p.fail(f\\\"a driver commit is not a records transport: {not_transport[0]}; {counts}\\\", **extra)\\n    if unrecorded:\\n        return p.fail(f\\\"{unrecorded[-1][:12]} lacks a record; {counts}; boundary evasions: \\\"\\n                      f\\\"{evasions}; before the window: {before_window}\\\", **extra)\\n    return p.hold(f\\\"{counts}; boundary evasions: {evasions}; before the window: {before_window}\\\",\\n                  **extra)\\n\\n\\ndef driver_commits_not_transport(root: Path, window_spec: str, records_rel: str) -> list[str]:\\n    \\\"\\\"\\\"Every commit in the window authored as driver_identity() that is not\\n    a records transport: more than one parent, or a path outside\\n    <records>/<N>/ for the one item N it touches. The driver's commits\\n    carry records and nothing else, one parent each (root cause 1: the\\n    driver makes them in a detached worktree and never merges), so one\\n    that does either was made by something other than the transport.\\n    Each entry reads `<sha12> <why>`.\\\"\\\"\\\"\\n    email = driver_identity()[\\\"email\\\"]\\n    bad: list[str] = []\\n    prefix = records_rel.strip(\\\"/\\\") + \\\"/\\\"\\n    out = git(root, \\\"log\\\", window_spec, \\\"--format=%H\\\\x1f%ae\\\\x1f%P\\\")\\n    for line in out.splitlines():\\n        sha, author, parents = line.split(\\\"\\\\x1f\\\")\\n        if author != email:\\n            continue\\n        if len(parents.split()) > 1:\\n            bad.append(f\\\"{sha[:12]} is a merge\\\")\\n            continue\\n        paths = git(root, \\\"diff-tree\\\", \\\"--no-commit-id\\\", \\\"--name-only\\\", \\\"-r\\\", \\\"--root\\\", sha).splitlines()\\n        items = {p[len(prefix):].split(\\\"/\\\", 1)[0] for p in paths if p.startswith(prefix) and \\\"/\\\" in p[len(prefix):]}\\n        outside = [p for p in paths if not (p.startswith(prefix) and \\\"/\\\" in p[len(prefix):])]\\n        if outside:\\n            bad.append(f\\\"{sha[:12]} touches {outside[0]}, outside its item's records\\\")\\n        elif len(items) > 1:\\n            bad.append(f\\\"{sha[:12]} touches the records of items {', '.join(sorted(items))}\\\")\\n    return bad\\n\\n\\nADAPTER_EXIT_RE = re.compile(r\\\"^\\\\[adapter exited \\\\d+\\\\]$\\\")\\n\\n_JSON_LINE_PARSE_FAILED = object()\\n\\n\\ndef _parse_json_line(text: str) -> Any:\\n    \\\"\\\"\\\"A line's own parsed JSON value, or the sentinel\\n    _JSON_LINE_PARSE_FAILED when it does not parse -- the one call site\\n    in this file for a defensive, line-at-a-time JSON parse, shared by\\n    proof four's own tool-error check below (any valid JSON satisfies\\n    it) and an events line's own `at` read (issue #151, which further\\n    requires a dict). A dedicated sentinel, not None: a line that is\\n    the literal JSON value null parses successfully and must read as\\n    such, not as a failure.\\\"\\\"\\\"\\n    try:\\n        return json.loads(text)\\n    except ValueError:\\n        return _JSON_LINE_PARSE_FAILED\\n\\n\\ndef _log_owes_tool_error(log: str | None) -> bool:\\n    \\\"\\\"\\\"True when a log's last non-empty line is exactly an adapter-exit\\n    marker and every line before it parses as JSON -- an adapter's own\\n    event stream, never a tool's own words (issue #94's own specimen,\\n    tenant zero's attest/records/659/verify-01.log: codex's\\n    \\\"thread.started\\\" event, then nothing but \\\"[adapter exited 1]\\\" -- the\\n    tool's real error line dropped before this reached the log, issue\\n    #86's own bug in split_adapter_stdout). A log that is only the exit\\n    marker, nothing before it at all, still owes the same line. An\\n    `error` event with a non-empty string `message` is the tool's own\\n    error delivered as an event (issue #200: \\\"Selected model is at\\n    capacity\\\"), so it owes nothing. So is an API error the tool reports as\\n    its own assistant message -- Claude Code's `\\\"is_api_error_message\\\":\\n    true` event, whose text is the tool's words (\\\"Failed to authenticate:\\n    OAuth session expired and could not be refreshed\\\", item 267 build-01\\n    and build-02, 2026-09-30) -- when that text is non-empty.\\\"\\\"\\\"\\n    if not log:\\n        return False\\n    lines = [l for l in log.splitlines() if l.strip()]\\n    if not lines or not ADAPTER_EXIT_RE.match(lines[-1]):\\n        return False\\n    for l in lines[:-1]:\\n        parsed = _parse_json_line(l)\\n        if parsed is _JSON_LINE_PARSE_FAILED:\\n            return False\\n        if isinstance(parsed, dict) and parsed.get(\\\"type\\\") == \\\"error\\\":\\n            message = parsed.get(\\\"message\\\")\\n            if isinstance(message, str) and message:\\n                return False\\n        if isinstance(parsed, dict) and parsed.get(\\\"is_api_error_message\\\") is True:\\n            if _api_error_text(parsed):\\n                return False\\n    return True\\n\\n\\ndef _api_error_text(event: dict[str, Any]) -> str:\\n    \\\"\\\"\\\"The text of an API error an adapter's tool delivered as its own\\n    assistant message: the non-empty text blocks of message.content,\\n    joined. Empty when there is none, which owes the line still.\\\"\\\"\\\"\\n    message = event.get(\\\"message\\\")\\n    content = message.get(\\\"content\\\") if isinstance(message, dict) else None\\n    if not isinstance(content, list):\\n        return \\\"\\\"\\n    texts = [b.get(\\\"text\\\") for b in content\\n             if isinstance(b, dict) and b.get(\\\"type\\\") == \\\"text\\\" and isinstance(b.get(\\\"text\\\"), str)]\\n    return \\\" \\\".join(t.strip() for t in texts if t and t.strip())\\n\\n\\ndef proof_no_stop_lacks_cause(root: Path, m: dict[str, Any] | None) -> Proof:\\n    p = Proof(\\\"no-stop-lacks-cause\\\", \\\"no stop lacks its cause\\\")\\n    if m is None:\\n        return p.fail(f\\\"no {MANIFEST} at {root}; no records directory is declared\\\")\\n    records_rel = m.get(\\\"paths\\\", {}).get(\\\"records\\\", \\\"\\\")\\n    records_dir = root / records_rel\\n    if not records_dir.is_dir():\\n        return p.fail(f\\\"no records directory under {records_dir}\\\")\\n\\n    # issue #89's own window lesson, proof three's already: a record\\n    # before record_version 3 has no stop by construction (schema\\n    # versions 1 and 2 predate it) -- counted here, never refused.\\n    older = 0\\n    checked = 0\\n    before_rederivable = 0\\n    problems: list[str] = []\\n    for item_dir in sorted(d for d in records_dir.iterdir() if d.is_dir()):\\n        for stage in STOP_STAGES:\\n            for n, rec in sorted(parse_attempts(item_dir, stage).items()):\\n                if rec.get(\\\"record_version\\\", 1) < 3:\\n                    older += 1\\n                    continue\\n                if rec.get(\\\"status\\\") == \\\"pass\\\":\\n                    continue\\n                checked += 1\\n                name = f\\\"{stage}-{n:02d}\\\"\\n                rederivable = rec.get(\\\"record_version\\\", 1) >= STOP_REDERIVABLE_FROM[stage]\\n                if not rederivable:\\n                    before_rederivable += 1\\n                stop = rec.get(\\\"stop\\\")\\n                if not stop:\\n                    problems.append(f\\\"item {item_dir.name} {name} carries no stop\\\")\\n                    continue\\n                cls, provenance = stop.get(\\\"class\\\"), stop.get(\\\"provenance\\\")\\n                if cls not in STOP_CLASSES:\\n                    problems.append(f\\\"item {item_dir.name} {name} stop.class {cls!r} names \\\"\\n                                    f\\\"no enumerated class\\\")\\n                    continue\\n                if provenance not in STOP_PROVENANCES:\\n                    problems.append(f\\\"item {item_dir.name} {name} stop.provenance \\\"\\n                                    f\\\"{provenance!r} names no enumerated provenance\\\")\\n                    continue\\n                # Issue #254: at the version that stores what the stop was\\n                # derived from, the stop is that function's value -- the\\n                # pass's own recovery records by their own rule.\\n                if rederivable and is_recovery_stop(rec):\\n                    fault = recovery_fault(rec)\\n                    if fault:\\n                        problems.append(f\\\"item {item_dir.name} {name} {fault}\\\")\\n                        continue\\n                elif rederivable:\\n                    derived = rederive_stop(stage, rec)\\n                    if derived is None or (derived[\\\"class\\\"], derived[\\\"provenance\\\"]) != (cls, provenance):\\n                        problems.append(\\n                            f\\\"item {item_dir.name} {name} stop is {cls}/{provenance} but its \\\"\\n                            f\\\"own fields derive \\\"\\n                            f\\\"{'no stop' if derived is None else derived['class'] + '/' + derived['provenance']}\\\")\\n                        continue\\n                if cls == \\\"unclassed\\\" and not stop.get(\\\"detail\\\"):\\n                    problems.append(f\\\"item {item_dir.name} {name} is unclassed with no detail\\\")\\n                    continue\\n                log_path = item_dir / f\\\"{name}.log\\\"\\n                log = log_path.read_text() if log_path.is_file() else None\\n                # Issue #89, rejection test 1's own specimen (tenant\\n                # zero's #659 build-01): a failed build that actually ran\\n                # the gates -- selected_tests is set only once cmd_build\\n                # reaches them -- owes their heading in the log, whatever\\n                # else stop already says.\\n                if (stage == \\\"build\\\" and rec.get(\\\"status\\\") == \\\"failed\\\"\\n                        and rec.get(\\\"selected_tests\\\") is not None\\n                        and \\\"--- attavo gates, iteration\\\" not in (log or \\\"\\\")):\\n                    problems.append(f\\\"item {item_dir.name} {name} failed after the gates ran \\\"\\n                                    f\\\"but its log carries no gates heading\\\")\\n                    continue\\n                if _log_owes_tool_error(log):\\n                    problems.append(f\\\"item {item_dir.name} {name}'s log ends in an adapter \\\"\\n                                    f\\\"exit with nothing before it but event lines; the tool's \\\"\\n                                    f\\\"own error line is owed\\\")\\n\\n        # issue #137: a refused spec-gate record is a stop too, class\\n        # \\\"gate\\\" -- synthesized the same way item_stops and\\n        # cmd_file_stops already read it, since cmd_spec_gate itself\\n        # carries no stop field to check for one. No record_version\\n        # gate here: unlike build/verify's own stop field, gate is never\\n        # persisted, so there is no older shape that predates it.\\n        for n, rec in sorted(parse_attempts(item_dir, \\\"spec\\\").items()):\\n            if rec.get(\\\"status\\\") != \\\"refused\\\":\\n                continue\\n            checked += 1\\n            name = f\\\"spec-{n:02d}\\\"\\n            stop = gate_stop(rec.get(\\\"refusal\\\"))\\n            cls, provenance = stop[\\\"class\\\"], stop[\\\"provenance\\\"]\\n            if cls not in STOP_CLASSES:\\n                problems.append(f\\\"item {item_dir.name} {name} stop.class {cls!r} names \\\"\\n                                f\\\"no enumerated class\\\")\\n                continue\\n            if provenance not in STOP_PROVENANCES:\\n                problems.append(f\\\"item {item_dir.name} {name} stop.provenance \\\"\\n                                f\\\"{provenance!r} names no enumerated provenance\\\")\\n                continue\\n            if not stop.get(\\\"detail\\\"):\\n                problems.append(f\\\"item {item_dir.name} {name} is a gate stop with no cause\\\")\\n\\n    older_note = (f\\\"{older} record(s) before stop was recorded; {before_rederivable} non-pass \\\"\\n                 f\\\"record(s) before their stop could be re-derived\\\")\\n    if problems:\\n        return p.fail(\\\"; \\\".join(problems), older_records=older,\\n                     before_rederivable=before_rederivable)\\n    return p.hold(f\\\"{checked} checked ({older_note})\\\" if checked == 0\\n                 else f\\\"{checked} non-pass record(s) carry stop with a cause ({older_note})\\\",\\n                 older_records=older, before_rederivable=before_rederivable)\\n\\n\\ndef attestation_command(m: dict[str, Any]) -> str | None:\\n    \\\"\\\"\\\"[forge].attestation_command: the tenant's own read of the store,\\n    given a merge sha on stdin, printing the statement as JSON on exit 0\\n    and nothing on a non-zero exit. Absent is not passing (issue #158:\\n    the doctor said done while #106, #148, #153 had no statement in the\\n    store at all -- there was no key to read one through).\\\"\\\"\\\"\\n    cmd = (m.get(\\\"forge\\\") or {}).get(\\\"attestation_command\\\")\\n    return cmd if isinstance(cmd, str) and cmd.strip() else None\\n\\n\\ndef statement_for(root: Path, cmd: str, merge_sha: str) -> tuple[dict[str, Any] | None, int]:\\n    \\\"\\\"\\\"The statement the forge holds for merge_sha and the command's exit\\n    code. The statement is None when the command exits non-zero or prints\\n    anything but a JSON object -- exit 2 means the store itself could not\\n    be read (issue #158, amended after build-05: distinct from exit 1,\\n    the store read fine and simply held no statement).\\\"\\\"\\\"\\n    run = subprocess.run(cmd, shell=True, cwd=str(root), input=merge_sha + \\\"\\\\n\\\",\\n                         capture_output=True, text=True, check=False)\\n    if run.returncode != 0:\\n        return None, run.returncode\\n    try:\\n        parsed = json.loads(run.stdout)\\n    except ValueError:\\n        return None, run.returncode\\n    return (parsed if isinstance(parsed, dict) else None), run.returncode\\n\\n\\ndef _is_ancestor(root: Path, earlier: str, later: str) -> bool:\\n    run = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"merge-base\\\", \\\"--is-ancestor\\\", earlier, later],\\n                         capture_output=True, check=False)\\n    return run.returncode == 0\\n\\n\\n# Maps whose keys are the records' data (a stage or an adapter that cost\\n# something), not a release's fields: a key missing from one is a difference.\\nDATA_KEYED = (\\\"by_stage_usd\\\", \\\"by_adapter_usd\\\")\\n\\n\\ndef _same(stated: Any, summed: Any) -> bool:\\n    \\\"\\\"\\\"Equal as the accounting means it: a number equals a number of the\\n    same value (a store may print 40.0 as 40), a bool equals only a bool,\\n    and a list is equal member by member. No tolerance and no conversion:\\n    both sides are the same function's rounding of the same records, and an\\n    int one past 2**53 is not the float beside it.\\\"\\\"\\\"\\n    if isinstance(stated, bool) or isinstance(summed, bool):\\n        return isinstance(stated, bool) and isinstance(summed, bool) and stated == summed\\n    if isinstance(stated, (int, float)) and isinstance(summed, (int, float)):\\n        return bool(stated == summed)\\n    if isinstance(stated, list) and isinstance(summed, list):\\n        return len(stated) == len(summed) and all(_same(a, b) for a, b in zip(stated, summed))\\n    return type(stated) is type(summed) and bool(stated == summed)\\n\\n\\ndef _differences(path: str, stated: Any, summed: Any, keyed_by_data: bool = False) -> list[str]:\\n    \\\"\\\"\\\"Every field of `stated` that is not what its records sum to, named by\\n    its path. Only the keys the statement carries are compared, at every\\n    depth, so a field a later release adds is not demanded of a statement\\n    sealed before it; a key it carries that the function does not produce\\n    is a difference.\\\"\\\"\\\"\\n    if not (isinstance(stated, dict) and isinstance(summed, dict)):\\n        return [] if _same(stated, summed) else [f\\\"{path} {stated!r} is not its records' {summed!r}\\\"]\\n    found: list[str] = []\\n    for key in sorted(stated):\\n        if key not in summed:\\n            found.append(f\\\"{path}.{key} {stated[key]!r} is not a field its records sum to\\\")\\n        else:\\n            found += _differences(f\\\"{path}.{key}\\\", stated[key], summed[key], key in DATA_KEYED)\\n    if keyed_by_data:\\n        found += [f\\\"{path}.{key} is absent; its records sum to {summed[key]!r}\\\"\\n                  for key in sorted(summed.keys() - stated.keys())]\\n    return found\\n\\n\\ndef _carried(predicate: dict[str, Any], key: str) -> str:\\n    return repr(predicate[key]) if key in predicate else \\\"absent\\\"\\n\\n\\ndef _accounting_disagrees(root: Path, item_records_dir: Path, item: str, merge_sha: str,\\n                          statement: dict[str, Any]) -> str | None:\\n    \\\"\\\"\\\"A sealed statement that carries `time` and `cost` says what its\\n    records sum to, field by field -- the same function attest summed them\\n    with, over the same records (none is written after a merge), sealed at\\n    the same commit (the statement is computed at the merge, so lead_s and\\n    waiting_s are recomputed from its committer time, not excepted). Exact:\\n    #202 retired the one-second tolerance. A statement sealed before `time`\\n    existed carries neither key and is not checked; a key that is present\\n    holds a block, so a null one, or one block without the other, is a\\n    disagreement. No new read of the store.\\\"\\\"\\\"\\n    inner = statement.get(\\\"predicate\\\")\\n    predicate = inner if isinstance(inner, dict) else statement\\n    if \\\"time\\\" not in predicate and \\\"cost\\\" not in predicate:\\n        return None\\n    stated_time, stated_cost = predicate.get(\\\"time\\\"), predicate.get(\\\"cost\\\")\\n    where = f\\\"item {item} merged at {merge_sha[:12]}\\\"\\n    if not isinstance(stated_time, dict) or not isinstance(stated_cost, dict):\\n        return (f\\\"{where}: the statement's time and cost are not both blocks \\\"\\n                f\\\"(time is {_carried(predicate, 'time')}, cost is {_carried(predicate, 'cost')})\\\")\\n    try:\\n        sealed_at: int | None = int(git(root, \\\"show\\\", \\\"-s\\\", \\\"--format=%ct\\\", merge_sha).strip())\\n    except (RuntimeError, ValueError):\\n        sealed_at = None\\n    summed_time, summed_cost = item_time_and_cost(item_records_dir, sealed_at)\\n    differing = (_differences(\\\"time\\\", stated_time, dict(summed_time))\\n                 + _differences(\\\"cost\\\", stated_cost, dict(summed_cost)))\\n    if differing:\\n        return f\\\"{where}: the statement's \\\" + \\\"; \\\".join(differing)\\n    return None\\n\\n\\ndef proof_every_attested_item_is_sealed(root: Path, m: dict[str, Any] | None) -> Proof:\\n    p = Proof(\\\"every-attested-item-is-sealed\\\", \\\"every attested item has its statement in the store\\\")\\n    if m is None:\\n        return p.fail(f\\\"no {MANIFEST} at {root}; no records directory is declared\\\")\\n    cmd = attestation_command(m)\\n    if cmd is None:\\n        return p.fail(\\\"no [forge].attestation_command in the manifest; the store cannot be read\\\")\\n    records_rel = m.get(\\\"paths\\\", {}).get(\\\"records\\\", \\\"\\\")\\n    records_dir = root / records_rel\\n    if not records_dir.is_dir():\\n        return p.fail(f\\\"no records directory under {records_dir}\\\")\\n    items = load_records(records_dir)\\n    complete = [item for item, stages in sorted(items.items()) if all(s in stages for s in STAGES)]\\n\\n    # [forge].sealed_since: merges at or before this commit are before the\\n    # window -- the tenant could not seal them (no queue, no signing\\n    # workflow, or a store that held nothing yet). They are named, never\\n    # failed. Absent, the window starts where proof three's does: the\\n    # install commit, or [doctor].from (issue #192).\\n    since = (m.get(\\\"forge\\\") or {}).get(\\\"sealed_since\\\")\\n    if not (isinstance(since, str) and since.strip()):\\n        try:\\n            since = proof_window_start(root, m)[1]\\n        except WindowRefused as exc:\\n            return p.fail(str(exc))\\n    merges, refusal = _merges_reachable(root)\\n    if refusal:\\n        return p.fail(refusal)\\n    sealed: list[str] = []\\n    before_window: list[str] = []\\n    unsealed: list[str] = []\\n    not_merged: list[str] = []\\n    not_read: list[str] = []\\n    reasons: list[str] = []\\n    for item in complete:\\n        merge_sha, _ = merge_introducing_records(root, records_rel, item, STAGES, merges=merges)\\n        if merge_sha is None:\\n            not_merged.append(item)\\n            continue\\n        if _is_ancestor(root, merge_sha, since):\\n            before_window.append(item)\\n            continue\\n        statement, exit_code = statement_for(root, cmd, merge_sha)\\n        if statement is not None:\\n            sealed.append(item)\\n            disagreement = _accounting_disagrees(root, records_dir / item, item, merge_sha,\\n                                                 statement)\\n            if disagreement:\\n                reasons.append(disagreement)\\n        elif exit_code == 2:\\n            not_read.append(item)\\n            reasons.append(f\\\"item {item} merged at {merge_sha[:12]}: not read -- \\\"\\n                           f\\\"the store could not be read; {cmd!r} exited 2\\\")\\n        else:\\n            unsealed.append(item)\\n            reasons.append(f\\\"item {item} merged at {merge_sha[:12]} has no statement in the store\\\")\\n    if reasons:\\n        return p.fail(\\\"; \\\".join(reasons), sealed=sealed, before_window=before_window,\\n                      unsealed=unsealed, not_merged=not_merged, not_read=not_read)\\n    window = f\\\" at {since[:12]}\\\" if before_window else \\\"\\\"\\n    return p.hold(f\\\"{len(sealed)} sealed, {len(before_window)} before the window{window}, \\\"\\n                 f\\\"{len(not_merged)} not merged\\\",\\n                 sealed=sealed, before_window=before_window, unsealed=unsealed,\\n                 not_merged=not_merged, not_read=not_read)\\n\\n\\ndef proof_no_attested_item_is_empty(root: Path, m: dict[str, Any] | None) -> Proof:\\n    \\\"\\\"\\\"Proof seven (item 227). Every merged, fully-staged item's passing\\n    build names a change: its tree, restricted to the item's own spec\\n    claims, differs from the approved tree there (item 229 -- asked\\n    against the approval, not the build's own start_sha, so a build\\n    that adopted a prior attempt's valid commits is not empty just\\n    because that attempt owed no commit of its own; scoped to claims,\\n    not \\\"everything outside paths.records\\\", so a commit that lands\\n    between approval and a later attempt's start but touches no\\n    claimed path never rescues or defeats the comparison on its own\\n    account). Item 227 was specified, approved, built by one\\n    invocation, judged by another, merged and sealed, and its build\\n    committed nothing -- the executor left the stub in the working tree,\\n    the gate read the tree, and main received the spec and none of the\\n    change. Six proofs held over it.\\n\\n    [doctor].built_since: merges at or before this commit are before the\\n    window -- named, never failed -- so the specimen stands on every\\n    doctor run without failing the tenant forever. Absent, the window is\\n    proof three's. A build record whose approval cannot be resolved\\n    (no approval_sha at all, or one this repository cannot read) is\\n    named as not readable, not failed.\\\"\\\"\\\"\\n    p = Proof(\\\"no-attested-item-is-empty\\\", \\\"every attested item's build names a change\\\")\\n    if m is None:\\n        return p.fail(f\\\"no {MANIFEST} at {root}; no records directory is declared\\\")\\n    records_rel = m.get(\\\"paths\\\", {}).get(\\\"records\\\", \\\"\\\")\\n    specs_rel = m.get(\\\"paths\\\", {}).get(\\\"specs\\\", \\\"\\\")\\n    records_dir = root / records_rel\\n    if not records_dir.is_dir():\\n        return p.fail(f\\\"no records directory under {records_dir}\\\")\\n    items = load_records(records_dir)\\n    complete = [item for item, stages in sorted(items.items()) if all(s in stages for s in STAGES)]\\n    since = (m.get(\\\"doctor\\\") or {}).get(\\\"built_since\\\")\\n    if not (isinstance(since, str) and since.strip()):\\n        try:\\n            since = proof_window_start(root, m)[1]\\n        except WindowRefused as exc:\\n            return p.fail(str(exc))\\n    else:\\n        try:\\n            since = git(root, \\\"rev-parse\\\", \\\"--verify\\\", f\\\"{since}^{{commit}}\\\").strip()\\n        except RuntimeError:\\n            return p.fail(f\\\"[doctor] built_since {since} does not resolve to a commit\\\")\\n    merges, refusal = _merges_reachable(root)\\n    if refusal:\\n        return p.fail(refusal)\\n    built: list[str] = []\\n    before_window: list[str] = []\\n    not_merged: list[str] = []\\n    not_read: list[str] = []\\n    empty: list[str] = []\\n    for item in complete:\\n        merge_sha, _ = merge_introducing_records(root, records_rel, item, STAGES, merges=merges)\\n        if merge_sha is None:\\n            not_merged.append(item)\\n            continue\\n        if _is_ancestor(root, merge_sha, since):\\n            before_window.append(item)\\n            continue\\n        build = items[item][\\\"build\\\"]\\n        sha, approval_sha = build.get(\\\"sha\\\"), build.get(\\\"approval_sha\\\")\\n        if not sha or not approval_sha:\\n            not_read.append(item)\\n            continue\\n        spec_md = root / specs_rel / item / \\\"spec.md\\\"\\n        claims: list[str] = []\\n        if spec_md.is_file():\\n            parsed, _ = parse_spec(spec_md)\\n            claims = parsed[\\\"claims\\\"] if parsed else []\\n        is_empty = build_is_empty(root, approval_sha, sha, claims)\\n        if is_empty is None:\\n            not_read.append(item)\\n        elif is_empty:\\n            empty.append(f\\\"item {item} merged at {merge_sha[:12]}: build names no \\\"\\n                         \\\"claimed change; nothing was built\\\")\\n        else:\\n            built.append(item)\\n    if empty:\\n        return p.fail(\\\"; \\\".join(empty), built=built, before_window=before_window,\\n                      not_merged=not_merged, not_read=not_read)\\n    window = f\\\" at {since[:12]}\\\" if before_window else \\\"\\\"\\n    return p.hold(f\\\"{len(built)} built, {len(before_window)} before the window{window}, \\\"\\n                  f\\\"{len(not_read)} without a readable approval, {len(not_merged)} not merged\\\",\\n                  built=built, before_window=before_window, not_merged=not_merged,\\n                  not_read=not_read)\\n\\n\\ndef doctor(root: Path) -> list[Proof]:\\n    m = read_manifest(root)\\n    return [proof_every_gate_rejects(root, m),\\n            proof_one_item_every_stage(root, m),\\n            proof_no_commit_lacks_record(root, m),\\n            proof_no_stop_lacks_cause(root, m),\\n            proof_no_invocation_lacks_record(root, m),\\n            proof_every_attested_item_is_sealed(root, m),\\n            proof_no_attested_item_is_empty(root, m)]\\n\\n\\ndef cmd_doctor(argv: list[str]) -> int:\\n    as_json = \\\"--json\\\" in argv\\n    args = [a for a in argv if a != \\\"--json\\\"]\\n    root = Path(args[0] if args else \\\".\\\").resolve()\\n    proofs = doctor(root)\\n    if as_json:\\n        print(json.dumps({\\\"root\\\": str(root), \\\"done\\\": all(p.holds for p in proofs),\\n                          \\\"proofs\\\": [p.as_dict() for p in proofs]}, indent=2))\\n    else:\\n        for i, p in enumerate(proofs, 1):\\n            print(f\\\"proof {i} {p.key}: {'HOLDS' if p.holds else 'FAILS'}: {p.reason}\\\")\\n        print(\\\"doctor: done\\\" if all(p.holds for p in proofs)\\n              else f\\\"doctor: not done ({sum(not p.holds for p in proofs)} of \\\"\\n                   f\\\"{len(proofs)} proofs fail)\\\")\\n    return 0 if all(p.holds for p in proofs) else 1\\n\",\"numLines\":1046,\"startLine\":1,\"totalLines\":1046}}}\n{\"type\":\"assistant\",\"message\":{\"model\":\"claude-sonnet-5\",\"id\":\"msg_011CfaTjPaFfFwFQd4znhCnb\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_01HRUm326MRbZRYYKYYsYST5\",\"name\":\"Read\",\"input\":{\"file_path\":\"/Users/davidbean/Projects/attavo-worktree-289/attavo/drive.py\"},\"caller\":{\"type\":\"direct\"}}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":476,\"cache_read_input_tokens\":28750,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":476},\"output_tokens\":8,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"b3f717aa-5c2b-4867-b022-0f24cffb6427\",\"uuid\":\"57e95a45-263b-4c3f-a739-aa0abfeab9e2\",\"timestamp\":\"2026-09-30T23:05:36.928Z\",\"request_id\":\"req_011CfaTjPEB7XuMWpQbXJnCr\",\"wire_tool_inputs\":{\"toolu_01HRUm326MRbZRYYKYYsYST5\":{\"file_path\":\"/Users/davidbean/Projects/attavo-worktree-289/attavo/drive.py\"}}}\n{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01HRUm326MRbZRYYKYYsYST5\",\"type\":\"tool_result\",\"content\":\"1\\tfrom __future__ import annotations\\n2\\t\\n3\\timport contextlib\\n4\\timport io\\n5\\timport json\\n6\\timport os\\n7\\timport signal\\n8\\timport shutil\\n9\\timport subprocess\\n10\\timport sys\\n11\\timport tempfile\\n12\\timport threading\\n13\\timport time\\n14\\tfrom collections.abc import Callable, Iterator\\n15\\tfrom pathlib import Path\\n16\\tfrom typing import TYPE_CHECKING, Any, NamedTuple, cast\\n17\\t\\n18\\tfrom attavo import clock\\n19\\tfrom attavo.approval import approval_status\\n20\\tfrom attavo.build import cmd_build, driver_identity\\n21\\tfrom attavo.common import MANIFEST, PRODUCT_ROOT, derive_item_id, git, read_manifest\\n22\\tfrom attavo.counsel import cmd_counsel\\n23\\tfrom attavo.doctor import (\\n24\\t    _parse_json_line,\\n25\\t    attempts_budget,\\n26\\t    ceiling_s,\\n27\\t    heartbeat_age_s,\\n28\\t    heartbeat_path,\\n29\\t    heartbeat_pid,\\n30\\t    heartbeat_s,\\n31\\t    invocation_age_s,\\n32\\t    invocations_without_record,\\n33\\t    retry_after_s,\\n34\\t    stall_bound_s,\\n35\\t    write_invocation_marker,\\n36\\t)\\n37\\tfrom attavo.events import stage_events_dir\\n38\\tfrom attavo.filing import cmd_file_stops\\n39\\tfrom attavo.records import (\\n40\\t    latest_attempt_path,\\n41\\t    latest_record,\\n42\\t    next_attempt_number,\\n43\\t    parse_attempts,\\n44\\t    stage_schema,\\n45\\t    write_record,\\n46\\t)\\n47\\tfrom attavo.stops import RETRYABLE_CLASSES, counsel_record_for, signature_of\\n48\\tfrom attavo.verify import cmd_verify, read_forge_checks\\n49\\tfrom attavo import workcopy\\n50\\t\\n51\\tif TYPE_CHECKING:\\n52\\t    from attavo.types import DriveReport\\n53\\t\\n54\\t# --- drive: the mechanical transitions between approval and ready-to-merge\\n55\\t# (issue #84), under the reconciler's R2 (rulings A, B, C's recovery half,\\n56\\t# F, G, H): `attavo drive N` is one short pass. It reads the report\\n57\\t# (attavo.report), acts at most once -- recovers a dead or hung\\n58\\t# invocation, or starts the next stage in a detached worker -- and\\n59\\t# returns within seconds; the stage itself runs in `attavo worker`, a\\n60\\t# child of the pass's own session, which outlives it. Writes no record of\\n61\\t# its own: the stage records already on disk, and the invocation markers\\n62\\t# and heartbeats beside them, are the only state a pass or a worker\\n63\\t# reads. ---\\n64\\t\\n65\\t\\n66\\tRECORD_PUSH_TRIES = 5\\n67\\t\\n68\\t\\n69\\tclass TransportRefused(RuntimeError):\\n70\\t    \\\"\\\"\\\"A record transport that could not land: the message is the reason,\\n71\\t    already worded for the pass or worker that prints it.\\\"\\\"\\\"\\n72\\t\\n73\\t\\n74\\tdef _driver_env() -> dict[str, str]:\\n75\\t    identity = driver_identity()\\n76\\t    env = dict(os.environ)\\n77\\t    env[\\\"GIT_AUTHOR_NAME\\\"] = identity[\\\"name\\\"]\\n78\\t    env[\\\"GIT_AUTHOR_EMAIL\\\"] = identity[\\\"email\\\"]\\n79\\t    env[\\\"GIT_COMMITTER_NAME\\\"] = identity[\\\"name\\\"]\\n80\\t    env[\\\"GIT_COMMITTER_EMAIL\\\"] = identity[\\\"email\\\"]\\n81\\t    return env\\n82\\t\\n83\\t\\n84\\tdef _retry_base(root: Path, branch: str) -> str:\\n85\\t    \\\"\\\"\\\"The commit a retried record is committed on: origin's branch tip,\\n86\\t    fetched now. It must contain this checkout's HEAD -- the stage's own\\n87\\t    commits are in it, and a record's `sha` names them -- because the\\n88\\t    driver neither merges nor rebases; a tip that does not is a refusal,\\n89\\t    with the commits it would strand named by sha and author.\\\"\\\"\\\"\\n90\\t    git(root, \\\"fetch\\\", \\\"-q\\\", \\\"origin\\\", branch)\\n91\\t    tip = git(root, \\\"rev-parse\\\", \\\"FETCH_HEAD\\\").strip()\\n92\\t    contained = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"merge-base\\\", \\\"--is-ancestor\\\", \\\"HEAD\\\", tip],\\n93\\t                               capture_output=True, text=True, check=False)\\n94\\t    if contained.returncode != 0:\\n95\\t        ours = git(root, \\\"log\\\", \\\"--format=%h %an <%ae>\\\", f\\\"{tip}..HEAD\\\").splitlines()\\n96\\t        raise TransportRefused(\\n97\\t            f\\\"origin's {branch} moved under this checkout's own commits and the driver \\\"\\n98\\t            f\\\"neither merges nor rebases them: {'; '.join(ours)}\\\")\\n99\\t    return tip\\n100\\t\\n101\\t\\n102\\t@contextlib.contextmanager\\n103\\tdef record_worktree(root: Path, tip: str) -> Iterator[Path]:\\n104\\t    \\\"\\\"\\\"A detached worktree of `tip` under the git dir, removed on exit:\\n105\\t    the only place the driver commits. The item's checkout is the\\n106\\t    executor's while a build runs, so nothing the driver writes or\\n107\\t    commits, resets or merges is made there.\\\"\\\"\\\"\\n108\\t    parent = stage_events_dir(root) / \\\"transport\\\"\\n109\\t    parent.mkdir(parents=True, exist_ok=True)\\n110\\t    tree = Path(tempfile.mkdtemp(prefix=\\\"tx-\\\", dir=parent)) / \\\"head\\\"\\n111\\t    git(root, \\\"worktree\\\", \\\"add\\\", \\\"--detach\\\", \\\"-q\\\", str(tree), tip)\\n112\\t    try:\\n113\\t        yield tree\\n114\\t    finally:\\n115\\t        try:\\n116\\t            git(root, \\\"worktree\\\", \\\"remove\\\", \\\"--force\\\", str(tree))\\n117\\t        except RuntimeError:\\n118\\t            shutil.rmtree(tree, ignore_errors=True)\\n119\\t            try:\\n120\\t                git(root, \\\"worktree\\\", \\\"prune\\\")\\n121\\t            except RuntimeError:\\n122\\t                pass\\n123\\t        shutil.rmtree(tree.parent, ignore_errors=True)\\n124\\t\\n125\\t\\n126\\tdef _record_paths(tree: Path, record_paths: list[Path]) -> list[str]:\\n127\\t    \\\"\\\"\\\"Each record's path relative to the tree, and each one's .log and\\n128\\t    .filed, each if one exists (issues #89, #100): the paths `git commit\\n129\\t    --only` names, so a transport commit never sweeps the index (issue\\n130\\t    #46's regression, on the transport side).\\\"\\\"\\\"\\n131\\t    paths: list[str] = []\\n132\\t    for record_path in record_paths:\\n133\\t        paths.append(str(record_path.relative_to(tree)))\\n134\\t        for suffix in (\\\".log\\\", \\\".filed\\\"):\\n135\\t            extra = record_path.with_suffix(suffix)\\n136\\t            if extra.is_file():\\n137\\t                paths.append(str(extra.relative_to(tree)))\\n138\\t    return paths\\n139\\t\\n140\\t\\n141\\tdef commit_record(tree: Path, record_paths: list[Path], message: str) -> str:\\n142\\t    \\\"\\\"\\\"`git commit --only` on the record paths given, in `tree` -- a\\n143\\t    record worktree, never the checkout -- as driver_identity(), set by\\n144\\t    the product and never the tenant's git config, so a driven item's\\n145\\t    record commits are never indistinguishable from an operator's own.\\n146\\t    Returns the commit's sha.\\\"\\\"\\\"\\n147\\t    paths = _record_paths(tree, record_paths)\\n148\\t    git(tree, \\\"add\\\", *paths)\\n149\\t    git(tree, \\\"commit\\\", \\\"--only\\\", \\\"-q\\\", \\\"-m\\\", message, *paths, env=_driver_env())\\n150\\t    return git(tree, \\\"rev-parse\\\", \\\"HEAD\\\").strip()\\n151\\t\\n152\\t\\n153\\tdef sync_checkout(root: Path, target: str) -> None:\\n154\\t    \\\"\\\"\\\"Fast-forward the item's checkout to `target`, the one thing the\\n155\\t    driver does to it. A pass in the same directory may hold the index\\n156\\t    for a moment, so a lock is retried; a checkout already at or beyond\\n157\\t    target is done.\\\"\\\"\\\"\\n158\\t    err = \\\"\\\"\\n159\\t    for _ in range(20):\\n160\\t        run = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"merge\\\", \\\"--ff-only\\\", \\\"-q\\\", target],\\n161\\t                             capture_output=True, text=True, check=False)\\n162\\t        if run.returncode == 0:\\n163\\t            return\\n164\\t        err = run.stderr.strip()\\n165\\t        contained = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"merge-base\\\", \\\"--is-ancestor\\\", target, \\\"HEAD\\\"],\\n166\\t                                   capture_output=True, text=True, check=False)\\n167\\t        if contained.returncode == 0:\\n168\\t            return\\n169\\t        time.sleep(0.1)\\n170\\t    raise TransportRefused(f\\\"the checkout could not fast-forward to {target[:12]}: {err}\\\")\\n171\\t\\n172\\t\\n173\\tdef _stage_copies(root: Path, paths: list[str]) -> None:\\n174\\t    \\\"\\\"\\\"Stage the checkout's own untracked copies of records the driver\\n175\\t    has just committed elsewhere, so the fast-forward that brings the\\n176\\t    committed ones in finds them identical to the target and has nothing\\n177\\t    to collide with -- and the record is never absent from the checkout,\\n178\\t    which is what a pass or a reader beside the worker sees.\\\"\\\"\\\"\\n179\\t    if not paths:\\n180\\t        return\\n181\\t    out = git(root, \\\"ls-files\\\", \\\"--others\\\", \\\"--exclude-standard\\\", \\\"--\\\", *paths).splitlines()\\n182\\t    if out:\\n183\\t        git(root, \\\"add\\\", \\\"--\\\", *out)\\n184\\t\\n185\\t\\n186\\tdef transport_records(root: Path, branch: str, message: str,\\n187\\t                      write: Callable[[Path], list[Path]],\\n188\\t                      lease: bool = False) -> tuple[str, str | None]:\\n189\\t    \\\"\\\"\\\"Commit records in a detached worktree of the branch's tip and push\\n190\\t    them from there as HEAD:branch; then fast-forward the checkout.\\n191\\t    `write(tree)` puts the records in the worktree and returns the record\\n192\\t    paths to commit -- called again on every try, since a retry starts\\n193\\t    from a freshly fetched tip.\\n194\\t\\n195\\t    The first try commits on this checkout's HEAD, which carries the\\n196\\t    stage's own commits. A push origin rejects is retried without a\\n197\\t    merge: fetch, recreate the worktree at the new tip (which must\\n198\\t    contain HEAD, see _retry_base), write again, push again as a\\n199\\t    fast-forward, RECORD_PUSH_TRIES times at most. The record's own `sha` names the\\n200\\t    stage's commit, not this transport commit, so moving the transport\\n201\\t    commit changes nothing a record names.\\n202\\t\\n203\\t    lease=True is the marker's push (ruling A): one try, and a race lost\\n204\\t    is (\\\"lost-race\\\", stderr) with the worktree discarded and the checkout\\n205\\t    untouched. Otherwise (\\\"pushed\\\", None), or (\\\"refused\\\", reason).\\\"\\\"\\\"\\n206\\t    err = \\\"\\\"\\n207\\t    base = git(root, \\\"rev-parse\\\", \\\"HEAD\\\").strip()\\n208\\t    for attempt in range(1 if lease else RECORD_PUSH_TRIES):\\n209\\t        if attempt:\\n210\\t            try:\\n211\\t                base = _retry_base(root, branch)\\n212\\t            except TransportRefused as exc:\\n213\\t                return \\\"refused\\\", str(exc)\\n214\\t            except RuntimeError as exc:\\n215\\t                return \\\"refused\\\", f\\\"could not read origin's {branch}: {exc}\\\"\\n216\\t        with record_worktree(root, base) as tree:\\n217\\t            paths = write(tree)\\n218\\t            try:\\n219\\t                sha = commit_record(tree, paths, message)\\n220\\t            except RuntimeError as exc:\\n221\\t                return \\\"refused\\\", f\\\"could not commit: {exc}\\\"\\n222\\t            if has_origin(root):\\n223\\t                run = subprocess.run([\\\"git\\\", \\\"-C\\\", str(tree), \\\"push\\\", \\\"origin\\\", f\\\"HEAD:{branch}\\\"],\\n224\\t                                     capture_output=True, text=True, check=False)\\n225\\t                if run.returncode != 0:\\n226\\t                    err = run.stderr.strip()\\n227\\t                    if lease:\\n228\\t                        raced = any(marker in run.stderr for marker in _RACE_MARKERS)\\n229\\t                        return (\\\"lost-race\\\" if raced else \\\"refused\\\"), err\\n230\\t                    continue\\n231\\t            try:\\n232\\t                _stage_copies(root, _record_paths(tree, paths))\\n233\\t                sync_checkout(root, sha)\\n234\\t            except (RuntimeError, TransportRefused) as exc:\\n235\\t                return \\\"refused\\\", str(exc)\\n236\\t            return \\\"pushed\\\", None\\n237\\t    return \\\"refused\\\", f\\\"push rejected {RECORD_PUSH_TRIES} times: {err}\\\"\\n238\\t\\n239\\t\\n240\\t_RACE_MARKERS = (\\\"non-fast-forward\\\", \\\"fetch first\\\", \\\"stale info\\\", \\\"cannot lock ref\\\",\\n241\\t                 \\\"failed to update ref\\\")\\n242\\t\\n243\\t\\n244\\tdef has_origin(root: Path) -> bool:\\n245\\t    \\\"\\\"\\\"Whether this checkout carries an origin remote at all -- a fixture\\n246\\t    or a scratch checkout with none is not a refusal; a pass commits\\n247\\t    locally and skips the push, the way recovery always has.\\\"\\\"\\\"\\n248\\t    try:\\n249\\t        git(root, \\\"remote\\\", \\\"get-url\\\", \\\"origin\\\")\\n250\\t        return True\\n251\\t    except RuntimeError:\\n252\\t        return False\\n253\\t\\n254\\t\\n255\\tdef drive_state(root: Path, m: dict[str, Any], item_id: str) -> tuple[str, str | None, Path]:\\n256\\t    \\\"\\\"\\\"(\\\"no-approval\\\" | \\\"build\\\" | \\\"verify\\\" | \\\"ready\\\", detail, records_dir):\\n257\\t    the next mechanical step for item_id, read from its latest records\\n258\\t    alone. A build only counts as current when it is a pass bound to the\\n259\\t    valid approval's own sha; a verify only counts as current when it is a\\n260\\t    pass bound to that build's own sha -- the same staleness a re-approval\\n261\\t    or a re-build must force, attest's own chain check already enforces\\n262\\t    (check_attest_chain), read here rather than re-typed.\\\"\\\"\\\"\\n263\\t    records_rel = m[\\\"paths\\\"][\\\"records\\\"]\\n264\\t    records_dir = root / records_rel / item_id\\n265\\t\\n266\\t    status = approval_status(root, m, item_id)\\n267\\t    if status != \\\"valid\\\":\\n268\\t        return \\\"no-approval\\\", status, records_dir\\n269\\t\\n270\\t    latest_approval = latest_record(records_dir, \\\"approval\\\")\\n271\\t    latest_build = latest_record(records_dir, \\\"build\\\")\\n272\\t    build_current = (latest_build is not None and latest_build.get(\\\"status\\\") == \\\"pass\\\"\\n273\\t                     and latest_build.get(\\\"approval_sha\\\")\\n274\\t                     == (latest_approval.get(\\\"sha\\\") if latest_approval else None))\\n275\\t    if latest_build is None or not build_current:\\n276\\t        return \\\"build\\\", None, records_dir\\n277\\t\\n278\\t    latest_verify = latest_record(records_dir, \\\"verify\\\")\\n279\\t    verify_current = (latest_verify is not None and latest_verify.get(\\\"status\\\") == \\\"pass\\\"\\n280\\t                      and latest_verify.get(\\\"build_sha\\\") == latest_build.get(\\\"sha\\\"))\\n281\\t    if not verify_current:\\n282\\t        return \\\"verify\\\", None, records_dir\\n283\\t\\n284\\t    return \\\"ready\\\", None, records_dir\\n285\\t\\n286\\t\\n287\\t# --- the heartbeat (its helpers live in attavo/doctor.py, where proof five\\n288\\t# reads it too), the worker log, and the forge-checks handoff: local\\n289\\t# facts under the checkout's own git directory (issue #140's precedent),\\n290\\t# never committed and never among the paths commit_record ever names. ---\\n291\\t\\n292\\tdef worker_log_path(root: Path, stage: str, nn: int) -> Path:\\n293\\t    return stage_events_dir(root) / f\\\"{stage}-{nn:02d}.worker.log\\\"\\n294\\t\\n295\\t\\n296\\tdef forge_checks_path(root: Path, stage: str, nn: int) -> Path:\\n297\\t    return stage_events_dir(root) / f\\\"{stage}-{nn:02d}.forge-checks.json\\\"\\n298\\t\\n299\\t\\n300\\tdef _events_path_for(root: Path, stage: str, nn: int) -> Path | None:\\n301\\t    \\\"\\\"\\\"The adapter's own events file for this invocation, under the\\n302\\t    checkout's git dir (a worktree's own dir when the checkout is one).\\\"\\\"\\\"\\n303\\t    try:\\n304\\t        gitdir = Path(git(root, \\\"rev-parse\\\", \\\"--git-dir\\\").strip())\\n305\\t    except RuntimeError:\\n306\\t        return None\\n307\\t    if not gitdir.is_absolute():\\n308\\t        gitdir = root / gitdir\\n309\\t    path = gitdir / \\\"attavo\\\" / f\\\"{stage}-{nn:02d}.events.jsonl\\\"\\n310\\t    return path if path.is_file() else None\\n311\\t\\n312\\t\\n313\\tdef _events_tail(path: Path | None, lines: int = 20) -> tuple[str, str | None]:\\n314\\t    \\\"\\\"\\\"(the last lines as a log, the last event's own at).\\\"\\\"\\\"\\n315\\t    if path is None:\\n316\\t        return \\\"no events file for this invocation\\\\n\\\", None\\n317\\t    try:\\n318\\t        text = path.read_text()\\n319\\t    except OSError:\\n320\\t        return \\\"events file unreadable\\\\n\\\", None\\n321\\t    tail = text.splitlines()[-lines:]\\n322\\t    last_at = None\\n323\\t    for line in reversed(tail):\\n324\\t        parsed = _parse_json_line(line)\\n325\\t        if not isinstance(parsed, dict):\\n326\\t            continue\\n327\\t        at = parsed.get(\\\"at\\\")\\n328\\t        if isinstance(at, str):\\n329\\t            last_at = at\\n330\\t            break\\n331\\t    return \\\"\\\\n\\\".join(tail) + \\\"\\\\n\\\", last_at\\n332\\t\\n333\\t\\n334\\tdef _seconds_since(at: str | None) -> float | None:\\n335\\t    from datetime import datetime, timezone\\n336\\t    if not at:\\n337\\t        return None\\n338\\t    try:\\n339\\t        then = datetime.strptime(at, \\\"%Y-%m-%dT%H:%M:%SZ\\\").replace(tzinfo=timezone.utc)\\n340\\t    except ValueError:\\n341\\t        return None\\n342\\t    return clock.now() - then.timestamp()\\n343\\t\\n344\\t\\n345\\tclass InvocationReading(NamedTuple):\\n346\\t    \\\"\\\"\\\"What one marker with no record reads as, from here and now.\\\"\\\"\\\"\\n347\\t    stage: str\\n348\\t    nn: int\\n349\\t    log: str\\n350\\t    last_at: str | None\\n351\\t    age: float | None\\n352\\t    cls: str  # \\\"running\\\" | \\\"hung\\\" | \\\"died\\\"\\n353\\t    bound: str | None = None  # R3: \\\"stall\\\" or \\\"ceiling\\\" when cls is \\\"hung\\\"\\n354\\t\\n355\\t\\n356\\tdef _manifest_of(root: Path) -> dict[str, Any]:\\n357\\t    m = read_manifest(root)\\n358\\t    return m if m is not None else {}\\n359\\t\\n360\\t\\n361\\tdef _streams_events(root: Path, m: dict[str, Any], stage: str) -> bool:\\n362\\t    \\\"\\\"\\\"R3: whether stage's adapter declares it streams events at all\\n363\\t    (adapters/<name>/conformance.json, \\\"streams_events\\\") -- one that does\\n364\\t    not is judged by its ceiling alone, and never called hung by event\\n365\\t    age it never produces. True (the ordinary case) when the adapter\\n366\\t    declares nothing, or none is configured to ask.\\\"\\\"\\\"\\n367\\t    name = (m.get(\\\"executor\\\") or {}).get(stage) or (m.get(\\\"executor\\\") or {}).get(\\\"build\\\")\\n368\\t    if not name:\\n369\\t        return True\\n370\\t    for base in (root / \\\"attavo\\\" / \\\"adapters\\\", PRODUCT_ROOT / \\\"adapters\\\"):\\n371\\t        conf = base / name / \\\"conformance.json\\\"\\n372\\t        if conf.is_file():\\n373\\t            try:\\n374\\t                return bool(json.loads(conf.read_text()).get(\\\"streams_events\\\", True))\\n375\\t            except (OSError, ValueError):\\n376\\t                return True\\n377\\t    return True\\n378\\t\\n379\\t\\n380\\tdef read_invocation(root: Path, bound: int | None, marker: Path, info: dict[str, Any]) -> InvocationReading:\\n381\\t    \\\"\\\"\\\"Whether an invocation that began and wrote no record is running,\\n382\\t    hung, or died -- read from the heartbeat its holder writes and from\\n383\\t    nothing else (root cause 4). A heartbeat fresh within three beats of\\n384\\t    ATTAVO_HEARTBEAT_S is a live holder: running, or, with a stall bound\\n385\\t    declared and the last event (the marker's own `at` when there is\\n386\\t    none) older than it, hung. A stale heartbeat is died, whether or not\\n387\\t    any pid lives -- a worker stuck somewhere that never reaches its own\\n388\\t    heartbeat loop again is exactly what this is for. With no heartbeat\\n389\\t    file a marker from this host is died -- the holder never touched its\\n390\\t    first beat, or is gone -- and one from another host follows the stall\\n391\\t    bound as proof five does: running while younger, died after. The\\n392\\t    stall bound decides hung, never died.\\n393\\t\\n394\\t    R3: the stage's own ceiling (wall clock from the marker's own `at`)\\n395\\t    is judged first, before any of that -- alive past it is hung by the\\n396\\t    ceiling whatever event age says, and an adapter that declares it\\n397\\t    streams no events is judged by the ceiling alone: bound is read as\\n398\\t    None for it, so the stall check below never fires on an event age it\\n399\\t    never had.\\\"\\\"\\\"\\n400\\t    import socket\\n401\\t    stage, nn_text = marker.stem.rsplit(\\\"-\\\", 1)\\n402\\t    nn = int(nn_text)\\n403\\t    log, last_at = _events_tail(_events_path_for(root, stage, nn))\\n404\\t    m = _manifest_of(root)\\n405\\t    ceiling = ceiling_s(m, stage)\\n406\\t    since_start = _seconds_since(info.get(\\\"at\\\"))\\n407\\t    if ceiling is not None and since_start is not None and since_start > ceiling:\\n408\\t        return InvocationReading(stage, nn, log, last_at, since_start, \\\"hung\\\", \\\"ceiling\\\")\\n409\\t    stall_bound = bound\\n410\\t    if not _streams_events(root, m, stage):\\n411\\t        bound = None\\n412\\t    beat_age = heartbeat_age_s(heartbeat_path(root, stage, nn))\\n413\\t    if beat_age is not None:\\n414\\t        if beat_age > heartbeat_s() * 3:\\n415\\t            return InvocationReading(stage, nn, log, last_at, beat_age, \\\"died\\\")\\n416\\t        age = _seconds_since(last_at or info.get(\\\"at\\\"))\\n417\\t        if bound is None or age is None or age <= bound:\\n418\\t            return InvocationReading(stage, nn, log, last_at, beat_age, \\\"running\\\")\\n419\\t        return InvocationReading(stage, nn, log, last_at, age, \\\"hung\\\", \\\"stall\\\")\\n420\\t    if info.get(\\\"host\\\") != socket.gethostname():\\n421\\t        marker_age = invocation_age_s(info)\\n422\\t        if stall_bound is not None and marker_age is not None and marker_age < stall_bound:\\n423\\t            return InvocationReading(stage, nn, log, last_at, marker_age, \\\"running\\\")\\n424\\t    return InvocationReading(stage, nn, log, last_at, _seconds_since(last_at or info.get(\\\"at\\\")), \\\"died\\\")\\n425\\t\\n426\\t\\n427\\tdef uncommitted_record(root: Path, records_dir: Path, stage: str) -> Path | None:\\n428\\t    \\\"\\\"\\\"The latest <stage>-NN.json this working tree carries that git has\\n429\\t    no commit for yet -- the moment between a worker's write and its own\\n430\\t    commit. None when the latest record is already committed, or there\\n431\\t    is none at all.\\\"\\\"\\\"\\n432\\t    path = latest_attempt_path(records_dir, stage)\\n433\\t    if path is None or not path.is_file():\\n434\\t        return None\\n435\\t    status = subprocess.run(\\n436\\t        [\\\"git\\\", \\\"-C\\\", str(root), \\\"status\\\", \\\"--porcelain\\\", \\\"--\\\", str(path.relative_to(root))],\\n437\\t        capture_output=True, text=True, check=False)\\n438\\t    return path if status.stdout.strip() else None\\n439\\t\\n440\\t\\n441\\tdef worker_holds_copy(root: Path, records_dir: Path) -> bool:\\n442\\t    \\\"\\\"\\\"True when this checkout's own working tree cannot safely be moved\\n443\\t    -- an invocation marker with no record yet (a worker, here or\\n444\\t    elsewhere, still holds this attempt), or a build or verify record the\\n445\\t    working tree carries that git has not committed yet. Scoped to the\\n446\\t    stage records a pass or a worker itself ever transports -- an\\n447\\t    operator's own spec-gate or approve, routinely uncommitted between\\n448\\t    their own act and the next pass, is not this. A pass never\\n449\\t    fast-forwards while this holds (never while a worker holds the\\n450\\t    copy).\\\"\\\"\\\"\\n451\\t    if invocations_without_record(records_dir):\\n452\\t        return True\\n453\\t    return (uncommitted_record(root, records_dir, \\\"build\\\") is not None\\n454\\t           or uncommitted_record(root, records_dir, \\\"verify\\\") is not None)\\n455\\t\\n456\\t\\n457\\tdef fast_forward_to_origin(root: Path, m: dict[str, Any], item_id: str) -> str | None:\\n458\\t    \\\"\\\"\\\"The pass's own read of origin's branch, taken before it reads\\n459\\t    anything else -- a commit landed there from elsewhere (an approval\\n460\\t    from the screen, a ruling, another pass's own record) is not a race\\n461\\t    for the lease, it is exactly what the lease is for. Never while a\\n462\\t    worker holds this copy (worker_holds_copy): moving a working tree a\\n463\\t    detached child is still writing into would corrupt its own commits.\\n464\\t    The checkout only fast-forwards. When it carries commits origin has\\n465\\t    not seen (an operator's approval, not yet pushed), the pass does not\\n466\\t    replay them: it returns a refusal naming each by sha and author, and\\n467\\t    the commits stay where they are. None when the checkout is now at\\n468\\t    origin's tip or there is nothing to read; silent about an absent\\n469\\t    origin or an unreachable one, which the ordinary read (and the\\n470\\t    marker push, for the lease) sort out.\\\"\\\"\\\"\\n471\\t    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n472\\t    if worker_holds_copy(root, records_dir) or not has_origin(root):\\n473\\t        return None\\n474\\t    try:\\n475\\t        branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n476\\t        git(root, \\\"fetch\\\", \\\"origin\\\", branch)\\n477\\t    except RuntimeError:\\n478\\t        return None\\n479\\t    ours = git(root, \\\"log\\\", \\\"--format=%h %an <%ae>\\\", \\\"FETCH_HEAD..HEAD\\\").splitlines()\\n480\\t    if not ours:\\n481\\t        try:\\n482\\t            git(root, \\\"merge\\\", \\\"--ff-only\\\", \\\"FETCH_HEAD\\\")\\n483\\t        except RuntimeError:\\n484\\t            pass\\n485\\t        return None\\n486\\t    listed = \\\"; \\\".join(ours)\\n487\\t    return (f\\\"this checkout carries {len(ours)} commit(s) origin's {branch} lacks and the pass \\\"\\n488\\t            f\\\"does not replay them: {listed}. Push them, or move them, and run the pass again\\\")\\n489\\t\\n490\\t\\n491\\t# --- the worker: a detached child of the pass's own session, running the\\n492\\t# stage exactly as the pass used to inline, touching its own heartbeat\\n493\\t# while it does (R2). ---\\n494\\t\\n495\\tdef _stage_body(item_id: str, stage: str, nn: int) -> int:\\n496\\t    \\\"\\\"\\\"Runs build or verify in-process -- the same command `attavo build`\\n497\\t    or `attavo verify` would run -- while touching heartbeat_path every\\n498\\t    heartbeat_s() seconds, then transports whatever it wrote: counsel and\\n499\\t    file-stops on a non-pass record (issue #100, #89), one `git commit\\n500\\t    --only`, one push with the record push's own merge retry. The\\n501\\t    marker is the pass's, already committed and pushed before this\\n502\\t    starts; this writes and transports only the stage's own record (and,\\n503\\t    on a stop, its counsel record).\\\"\\\"\\\"\\n504\\t    root = Path(\\\".\\\").resolve()\\n505\\t    m = read_manifest(root)\\n506\\t    if m is None:\\n507\\t        return 2\\n508\\t    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n509\\t    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n510\\t    before = latest_attempt_path(records_dir, stage)\\n511\\t\\n512\\t    beat = heartbeat_path(root, stage, nn)\\n513\\t    beat.parent.mkdir(parents=True, exist_ok=True)\\n514\\t    beat.write_text(f\\\"{os.getpid()}\\\\n\\\")\\n515\\t    stop_beat = threading.Event()\\n516\\t\\n517\\t    def _tick() -> None:\\n518\\t        while not stop_beat.wait(heartbeat_s()):\\n519\\t            beat.touch()\\n520\\t\\n521\\t    beat_thread = threading.Thread(target=_tick, daemon=True)\\n522\\t    beat_thread.start()\\n523\\t    # The heartbeat says the holder is alive, so it runs until the holder\\n524\\t    # returns -- through counsel, file-stops, the commit and the push --\\n525\\t    # not until the stage command does.\\n526\\t    try:\\n527\\t        return _run_and_transport(item_id, stage, root, m, records_dir, branch, before)\\n528\\t    finally:\\n529\\t        stop_beat.set()\\n530\\t        beat_thread.join()\\n531\\t\\n532\\t\\n533\\tdef _run_and_transport(item_id: str, stage: str, root: Path, m: dict[str, Any],\\n534\\t                       records_dir: Path, branch: str, before: Path | None) -> int:\\n535\\t    rc = cmd_build([item_id]) if stage == \\\"build\\\" else cmd_verify([item_id])\\n536\\t\\n537\\t    after = latest_attempt_path(records_dir, stage)\\n538\\t    if after is None or after == before:\\n539\\t        # Refused before writing anything at all (e.g. no adapter\\n540\\t        # configured) -- the stage command already printed why.\\n541\\t        return rc if rc != 0 else 1\\n542\\t\\n543\\t    record = cast(dict[str, Any], latest_record(records_dir, stage))\\n544\\t    status_out = record.get(\\\"status\\\")\\n545\\t    to_commit = [after]\\n546\\t    if status_out != \\\"pass\\\":\\n547\\t        stop = record.get(\\\"stop\\\") or {}\\n548\\t        state = retry_state(root, m, records_dir, stage, stop.get(\\\"class\\\"),\\n549\\t                            int(after.stem.rsplit(\\\"-\\\", 1)[1]))\\n550\\t        # R3: a stop the next plain pass would already retry -- now, or\\n551\\t        # once its transient wait elapses -- asks counsel nothing and\\n552\\t        # files nothing (#194's own verify-01, replayed as this item's\\n553\\t        # rejection fixture, paid for exactly this on a vendor's own\\n554\\t        # capacity error). Counsel reads it, as before, the moment that\\n555\\t        # is no longer true: the budget is spent, the early stop fired,\\n556\\t        # or the class was never a plain retry's to begin with.\\n557\\t        if not (state.eligible or state.waiting_s is not None):\\n558\\t            counsel_before = latest_attempt_path(records_dir, \\\"counsel\\\")\\n559\\t            cmd_counsel([item_id])\\n560\\t            counsel_after = latest_attempt_path(records_dir, \\\"counsel\\\")\\n561\\t            if counsel_after is not None and counsel_after != counsel_before:\\n562\\t                to_commit.append(counsel_after)\\n563\\t            # file-stops is its own idempotent read of the item's records,\\n564\\t            # so calling it here on every run that wrote a non-pass record\\n565\\t            # is safe to call again on a later run: an already-filed\\n566\\t            # stop's own marker is what stops it from being filed twice.\\n567\\t            cmd_file_stops([item_id])\\n568\\t\\n569\\t    message = f\\\"attavo: {stage} record for item {item_id} ({after.stem})\\\"\\n570\\t\\n571\\t    def copy_in(tree: Path) -> list[Path]:\\n572\\t        # The stage command wrote the records in this checkout, untracked;\\n573\\t        # they are committed from the detached worktree and the checkout's\\n574\\t        # copies become the committed ones when the checkout fast-forwards\\n575\\t        # (transport_records).\\n576\\t        copied: list[Path] = []\\n577\\t        for record_path in to_commit:\\n578\\t            for src in (record_path, record_path.with_suffix(\\\".log\\\"), record_path.with_suffix(\\\".filed\\\")):\\n579\\t                if src.is_file():\\n580\\t                    dest = tree / src.relative_to(root)\\n581\\t                    dest.parent.mkdir(parents=True, exist_ok=True)\\n582\\t                    shutil.copyfile(src, dest)\\n583\\t            copied.append(tree / record_path.relative_to(root))\\n584\\t        return copied\\n585\\t\\n586\\t    outcome, err = transport_records(root, branch, message, copy_in)\\n587\\t    if outcome != \\\"pushed\\\":\\n588\\t        print(f\\\"attavo drive: stopped: could not push the {stage} record: {err}\\\")\\n589\\t        return 1\\n590\\t    if not has_origin(root):\\n591\\t        print(f\\\"attavo drive: note: no origin remote; {after.name} is committed, not pushed\\\")\\n592\\t\\n593\\t    if status_out == \\\"halted\\\":\\n594\\t        question = (record.get(\\\"halted\\\") or {}).get(\\\"question\\\")\\n595\\t        print(f\\\"attavo drive: stopped: {stage} halted: {question} ({after.name}); \\\"\\n596\\t              f\\\"pushed to {branch}\\\")\\n597\\t    elif status_out != \\\"pass\\\":\\n598\\t        reason = record.get(\\\"refusal\\\") or status_out\\n599\\t        print(f\\\"attavo drive: stopped: {stage} {status_out}: {reason} ({after.name}); \\\"\\n600\\t              f\\\"pushed to {branch}\\\")\\n601\\t    else:\\n602\\t        print(f\\\"attavo drive: pushed {after.name} to {branch}\\\")\\n603\\t    return rc\\n604\\t\\n605\\t\\n606\\tdef cmd_worker(argv: list[str]) -> int:\\n607\\t    \\\"\\\"\\\"`attavo worker N <build|verify> NN`: the detached child a pass\\n608\\t    starts once its marker is pushed -- the lease held, the attempt is\\n609\\t    this worker's to run. Its own session (start_new_session, set by the\\n610\\t    pass that spawns it); its stdout and stderr are the pass's own\\n611\\t    redirect, to <git-dir>/attavo/<stage>-NN.worker.log.\\\"\\\"\\\"\\n612\\t    cast(io.TextIOWrapper, sys.stdout).reconfigure(line_buffering=True)\\n613\\t    if len(argv) != 3:\\n614\\t        print(\\\"attavo worker: usage: attavo worker N <build|verify> NN\\\", file=sys.stderr)\\n615\\t        return 2\\n616\\t    item_id, stage, nn_text = argv\\n617\\t    if stage not in (\\\"build\\\", \\\"verify\\\"):\\n618\\t        print(f\\\"attavo worker: {stage!r} is not build or verify\\\", file=sys.stderr)\\n619\\t        return 2\\n620\\t    try:\\n621\\t        nn = int(nn_text)\\n622\\t    except ValueError:\\n623\\t        print(f\\\"attavo worker: {nn_text!r} is not an attempt number\\\", file=sys.stderr)\\n624\\t        return 2\\n625\\t    return _stage_body(item_id, stage, nn)\\n626\\t\\n627\\t\\n628\\t# --- the pass's own two acts: start a stage (the lease), and recover\\n629\\t# exactly the one invocation the report names owed one. ---\\n630\\t\\n631\\tdef _start_stage(root: Path, m: dict[str, Any], item_id: str, stage: str,\\n632\\t                 forge_checks: dict[str, Any] | None, again_by: str | None = None) -> int:\\n633\\t    \\\"\\\"\\\"The lease (ruling A): the marker, committed and pushed as a plain\\n634\\t    fast-forward with no merge and no retry, made and pushed from a\\n635\\t    detached worktree (transport_records). Lost to another pass, or\\n636\\t    refused outright by the remote, the worktree is discarded and this\\n637\\t    checkout was never touched; only a pushed lease starts the worker. On a\\n638\\t    review, forge_checks is the checks this same pass already read on\\n639\\t    the pre-marker head (ruling B) -- written to\\n640\\t    <git-dir>/attavo/verify-NN.forge-checks.json and named in\\n641\\t    ATTAVO_FORGE_CHECKS, so the worker's own `attavo verify` reads it\\n642\\t    instead of polling. again_by (R3) is the login that pressed `--again`, set\\n643\\t    only when it is what started this attempt, past a budget already spent\\n644\\t    or an early stop -- named in the marker, never on an ordinary or\\n645\\t    plainly-retried attempt.\\\"\\\"\\\"\\n646\\t    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n647\\t    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n648\\t    nn = next_attempt_number(records_dir, stage)\\n649\\t    marker = records_dir / f\\\"{stage}-{nn:02d}.started\\\"\\n650\\t\\n651\\t    def write_marker(tree: Path) -> list[Path]:\\n652\\t        return [write_invocation_marker(tree, tree / records_dir.relative_to(root), stage, nn,\\n653\\t                                        again_by=again_by)]\\n654\\t\\n655\\t    outcome, err = transport_records(\\n656\\t        root, branch, f\\\"attavo: {stage} invocation {nn:02d} started for item {item_id}\\\",\\n657\\t        write_marker, lease=True)\\n658\\t    if outcome == \\\"lost-race\\\":\\n659\\t        print(f\\\"attavo drive: another pass holds this attempt ({marker.name}); nothing started\\\")\\n660\\t        return 0\\n661\\t    if outcome != \\\"pushed\\\":\\n662\\t        print(f\\\"attavo drive: stopped: could not push the {stage} invocation marker: {err}\\\")\\n663\\t        return 1\\n664\\t\\n665\\t    env = dict(os.environ)\\n666\\t    if forge_checks is not None:\\n667\\t        checks_file = forge_checks_path(root, stage, nn)\\n668\\t        checks_file.write_text(json.dumps(forge_checks))\\n669\\t        env[\\\"ATTAVO_FORGE_CHECKS\\\"] = str(checks_file)\\n670\\t    log = worker_log_path(root, stage, nn)\\n671\\t    with log.open(\\\"ab\\\") as fh, open(os.devnull, \\\"rb\\\") as devnull:\\n672\\t        proc = subprocess.Popen(\\n673\\t            [sys.executable, str(PRODUCT_ROOT / \\\"bin\\\" / \\\"attavo\\\"), \\\"worker\\\", item_id, stage, f\\\"{nn:02d}\\\"],\\n674\\t            cwd=str(root), env=env, stdin=devnull, stdout=fh, stderr=subprocess.STDOUT,\\n675\\t            start_new_session=True)\\n676\\t    word = \\\"Build\\\" if stage == \\\"build\\\" else \\\"Review\\\"\\n677\\t    print(f\\\"attavo drive: {word} started (attempt {nn:02d}, worker pid {proc.pid})\\\")\\n678\\t    return 0\\n679\\t\\n680\\t\\n681\\tdef _recover_one(root: Path, m: dict[str, Any], item_id: str, records_dir: Path) -> int:\\n682\\t    \\\"\\\"\\\"The pass's own recovery act (what `--recover` did): exactly the one\\n683\\t    invocation the report just read as owing one -- died or hung -- ends\\n684\\t    here. class died when the heartbeat is stale or absent, class hung\\n685\\t    when the heartbeat is fresh and a declared [drive].stall_after_s has\\n686\\t    passed with no newer event (or the stage's ceiling has passed), the\\n687\\t    holder terminated by the pid its own heartbeat names. Provenance product; the events tail as the log. Committed\\n688\\t    and pushed the way any stage record is (transport_records, with its\\n689\\t    retry that never merges) -- this is not a race for a lease, since no new\\n690\\t    attempt marker is written.\\\"\\\"\\\"\\n691\\t    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n692\\t    bound = stall_bound_s(m)\\n693\\t    pending = invocations_without_record(records_dir)\\n694\\t    readings = [(marker, info, read_invocation(root, bound, marker, info)) for marker, info in pending]\\n695\\t    candidate = next(((mk, i, rd) for mk, i, rd in readings if rd.cls != \\\"running\\\"), None)\\n696\\t    if candidate is None:\\n697\\t        # The report read this a moment ago; nothing owed recovery by the\\n698\\t        # time this pass got here (another pass recovered it, or it\\n699\\t        # finished on its own).\\n700\\t        return 0\\n701\\t    marker, info, reading = candidate\\n702\\t    stage, nn, log, last_at, age, cls, crossed = reading\\n703\\t    host = info.get(\\\"host\\\")\\n704\\t\\n705\\t    if next_attempt_number(records_dir, stage) != nn:\\n706\\t        print(f\\\"attavo drive: stopped: {marker.name} names attempt {nn} but the next \\\"\\n707\\t              f\\\"{stage} record would be {next_attempt_number(records_dir, stage):02d}; \\\"\\n708\\t              f\\\"a later record already exists, read the records before recovering\\\")\\n709\\t        return 1\\n710\\t\\n711\\t    if cls == \\\"hung\\\":\\n712\\t        holder = heartbeat_pid(heartbeat_path(root, stage, nn))\\n713\\t        if holder is None:\\n714\\t            print(f\\\"attavo drive: no holder to signal for {marker.stem}: its heartbeat names no pid\\\")\\n715\\t            ended = \\\"no holder to signal\\\"\\n716\\t            who = f\\\"no holder on {host}\\\"\\n717\\t        else:\\n718\\t            who = f\\\"pid {holder} on {host} alive\\\"\\n719\\t            try:\\n720\\t                os.kill(holder, signal.SIGTERM)\\n721\\t                ended = \\\"terminated\\\"\\n722\\t            except OSError as exc:\\n723\\t                ended = f\\\"not terminated ({exc})\\\"\\n724\\t        if crossed == \\\"ceiling\\\":\\n725\\t            detail = (f\\\"{who} {int(cast(float, age))} s after its marker, \\\"\\n726\\t                      f\\\"past the {stage} ceiling of {ceiling_s(m, stage)} s; {ended}\\\")\\n727\\t        else:\\n728\\t            detail = (f\\\"{who} with no event for {int(cast(float, age))} s \\\"\\n729\\t                      f\\\"(bound {bound} s); {ended}\\\")\\n730\\t    else:\\n731\\t        detail = (f\\\"{marker.stem} on {host} has no live heartbeat and wrote no {marker.stem}.json; \\\"\\n732\\t                  f\\\"started {info.get('at')}, last event {last_at or 'none'}\\\")\\n733\\t\\n734\\t    signature_text = log.strip().splitlines()[-1] if log.strip() else detail\\n735\\t\\n736\\t    schema = stage_schema(stage)\\n737\\t    record: dict[str, Any] = {k: None for k in schema.get(\\\"required\\\", [])}\\n738\\t    approval = latest_record(records_dir, \\\"approval\\\")\\n739\\t    record.update({\\\"sha\\\": info.get(\\\"sha\\\"), \\\"start_sha\\\": info.get(\\\"sha\\\"),\\n740\\t                   \\\"approval_sha\\\": approval.get(\\\"sha\\\") if approval else None,\\n741\\t                   \\\"at\\\": info.get(\\\"at\\\"),\\n742\\t                   \\\"adapter\\\": (m.get(\\\"executor\\\") or {}).get(stage),\\n743\\t                   \\\"status\\\": \\\"failed\\\", \\\"refusal\\\": None, \\\"halted\\\": None,\\n744\\t                   \\\"retry_of\\\": None, \\\"steer\\\": None,\\n745\\t                   \\\"stop\\\": {\\\"class\\\": cls, \\\"provenance\\\": \\\"product\\\", \\\"detail\\\": detail,\\n746\\t                            \\\"signature\\\": signature_of(signature_text), \\\"bound\\\": crossed}})\\n747\\t    if \\\"wall_clock_s\\\" in record:\\n748\\t        record[\\\"wall_clock_s\\\"] = None if age is None else int(age)\\n749\\t    record = {k: v for k, v in record.items() if k in schema.get(\\\"properties\\\", {})}\\n750\\t    tree_records = records_dir.relative_to(root)\\n751\\t\\n752\\t    def write_recovered(tree: Path) -> list[Path]:\\n753\\t        return [write_record(tree / tree_records, stage, record, m, item_id, log=log)]\\n754\\t\\n755\\t    message = (f\\\"attavo: {stage} record for item {item_id} \\\"\\n756\\t               f\\\"({stage}-{nn:02d}), recovered as {cls}\\\")\\n757\\t    try:\\n758\\t        outcome, err = transport_records(root, branch, message, write_recovered)\\n759\\t    except ValueError as exc:\\n760\\t        print(f\\\"attavo drive: stopped: could not write the {cls} record for {marker.stem}: {exc}\\\")\\n761\\t        return 1\\n762\\t    if outcome != \\\"pushed\\\":\\n763\\t        print(f\\\"attavo drive: stopped: could not push the {cls} record: {err}\\\")\\n764\\t        return 1\\n765\\t    if not has_origin(root):\\n766\\t        print(f\\\"attavo drive: note: no origin remote; {stage}-{nn:02d}.json is committed, not pushed\\\")\\n767\\t    print(f\\\"attavo drive: recovered {marker.stem} as {cls}: {detail}\\\")\\n768\\t    return 0\\n769\\t\\n770\\t\\n771\\tdef _advance_again(root: Path, m: dict[str, Any], item_id: str, stage: str, head: str | None,\\n772\\t                   again_by: str | None = None) -> int:\\n773\\t    \\\"\\\"\\\"The next attempt of a stopped stage, bypassing the level a plain\\n774\\t    pass leaves alone for the operator: what a plain retry (R3, inside\\n775\\t    the budget) starts on its own, and what `--again` starts by force\\n776\\t    once the budget is spent or an early stop fired. A review reads the\\n777\\t    forge fresh here -- once, since the report's own stopped reading\\n778\\t    never touched it -- rather than reusing a read that was never taken.\\\"\\\"\\\"\\n779\\t    if stage == \\\"build\\\":\\n780\\t        return _start_stage(root, m, item_id, \\\"build\\\", None, again_by=again_by)\\n781\\t    checks_command = (m.get(\\\"forge\\\") or {}).get(\\\"checks_command\\\")\\n782\\t    if not checks_command:\\n783\\t        print(\\\"attavo drive: refused: no [forge].checks_command in the manifest\\\")\\n784\\t        return 1\\n785\\t    forge_checks, ok = read_forge_checks(root, checks_command, cast(str, head))\\n786\\t    if not ok:\\n787\\t        conclusions = forge_checks[\\\"conclusions\\\"]\\n788\\t        named = \\\", \\\".join(f\\\"{c['name']} {c['conclusion']}\\\" for c in conclusions) or \\\"no checks reported\\\"\\n789\\t        print(f\\\"attavo drive: forge checks not green on {cast(str, head)[:12]}: {named}\\\")\\n790\\t        return 0\\n791\\t    return _start_stage(root, m, item_id, \\\"verify\\\", forge_checks, again_by=again_by)\\n792\\t\\n793\\t\\n794\\t# --- R3: the retry decision, shared by the report's own kind/says and the\\n795\\t# pass's own act (retry_state) so the two cannot drift. ---\\n796\\t\\n797\\t# Never retried by this item, whatever counsel might rule: a\\n798\\t# claims-boundary stop is a person's; a tenant's gate refusal is the\\n799\\t# spec-gate's own, earlier than any of this; an environment refusal is\\n800\\t# recorded here and acted on by R4's breaker. A question is not in this\\n801\\t# tuple -- counsel reads it exactly like any other non-pass record, and\\n802\\t# an \\\"answer\\\" verdict starts the next attempt steered by it, the same as\\n803\\t# any class counsel can rule on; a question nobody answers (no counsel\\n804\\t# configured, or its own verdict is \\\"person\\\") simply never becomes\\n805\\t# eligible, with no exclusion needed to keep it that way.\\n806\\tNEVER_RETRIED_CLASSES = (\\\"claims-boundary\\\", \\\"gate\\\", \\\"environment\\\")\\n807\\t\\n808\\t\\n809\\tdef _budget_stage(stage: str, stop_class: str | None) -> str:\\n810\\t    \\\"\\\"\\\"The stage whose [drive].attempts budget a stop spends -- build for\\n811\\t    a returned review (the check rejection or the blocking finding is the\\n812\\t    build's to answer, never the review's own to repeat), the stop's own\\n813\\t    stage for everything else.\\\"\\\"\\\"\\n814\\t    return \\\"build\\\" if stop_class == \\\"returned\\\" else stage\\n815\\t\\n816\\t\\n817\\tdef _signatures_match(records_dir: Path, stage: str) -> bool:\\n818\\t    \\\"\\\"\\\"Whether the last two attempts of stage carry the identical,\\n819\\t    non-null signature -- the early stop (R3): two attempts of one stage\\n820\\t    ending the same way spend no third.\\\"\\\"\\\"\\n821\\t    attempts = parse_attempts(records_dir, stage)\\n822\\t    if len(attempts) < 2:\\n823\\t        return False\\n824\\t    nums = sorted(attempts)\\n825\\t    sig_a = (attempts[nums[-1]].get(\\\"stop\\\") or {}).get(\\\"signature\\\")\\n826\\t    sig_b = (attempts[nums[-2]].get(\\\"stop\\\") or {}).get(\\\"signature\\\")\\n827\\t    return sig_a is not None and sig_a == sig_b\\n828\\t\\n829\\t\\n830\\tclass RetryState(NamedTuple):\\n831\\t    \\\"\\\"\\\"Whether a plain pass, right now, would start the next attempt of a\\n832\\t    stopped stage (R3) -- eligible; a transient stop still short of\\n833\\t    [drive].retry_after_s carries waiting_s instead, eligible for neither\\n834\\t    a plain pass nor `--again`'s own no-op read of the same fact; steer\\n835\\t    names the counsel record an \\\"answer\\\" verdict would hand the next\\n836\\t    attempt; target_stage is the stage the next attempt actually starts\\n837\\t    (build, for a returned review).\\\"\\\"\\\"\\n838\\t    eligible: bool\\n839\\t    waiting_s: float | None\\n840\\t    steer: str | None\\n841\\t    target_stage: str\\n842\\t\\n843\\t\\n844\\tdef retry_state(root: Path, m: dict[str, Any], records_dir: Path, stage: str,\\n845\\t                stop_class: str | None, attempt: int | None) -> RetryState:\\n846\\t    \\\"\\\"\\\"The one read behind both the report's own kind/says (a stopped\\n847\\t    stage that would retry reads as \\\"acts\\\" or \\\"waits\\\", never \\\"yours\\\") and\\n848\\t    the pass's own act, so the two cannot say different things about the\\n849\\t    same stop. died, hung, transient, and returned retry with no counsel\\n850\\t    asked, inside the shared budget and past the early stop; every other\\n851\\t    class retries only when counsel's own verdict for this exact stop is\\n852\\t    \\\"answer\\\" -- and never when the class is one of NEVER_RETRIED_CLASSES,\\n853\\t    whatever counsel might have said.\\\"\\\"\\\"\\n854\\t    target_stage = _budget_stage(stage, stop_class)\\n855\\t    if stop_class is None or stop_class in NEVER_RETRIED_CLASSES or attempt is None:\\n856\\t        return RetryState(False, None, None, target_stage)\\n857\\t    spent = next_attempt_number(records_dir, target_stage) - 1\\n858\\t    if spent >= attempts_budget(m):\\n859\\t        return RetryState(False, None, None, target_stage)\\n860\\t    if _signatures_match(records_dir, stage):\\n861\\t        return RetryState(False, None, None, target_stage)\\n862\\t    if stop_class in RETRYABLE_CLASSES:\\n863\\t        if stop_class == \\\"transient\\\":\\n864\\t            attempts = parse_attempts(records_dir, stage)\\n865\\t            rec = attempts.get(attempt)\\n866\\t            age = _seconds_since(rec.get(\\\"at\\\")) if rec else None\\n867\\t            wait = retry_after_s(m)\\n868\\t            if age is not None and age < wait:\\n869\\t                return RetryState(False, wait - age, None, target_stage)\\n870\\t        return RetryState(True, None, None, target_stage)\\n871\\t    counsel = counsel_record_for(records_dir, stage, attempt)\\n872\\t    if counsel is not None and counsel.get(\\\"verdict\\\") == \\\"answer\\\":\\n873\\t        target = f\\\"{stage}-{attempt:02d}\\\"\\n874\\t        counsel_attempts = parse_attempts(records_dir, \\\"counsel\\\")\\n875\\t        matches = [n for n, rec in counsel_attempts.items() if rec.get(\\\"record\\\") == target]\\n876\\t        if matches:\\n877\\t            return RetryState(True, None, f\\\"counsel-{max(matches):02d}\\\", target_stage)\\n878\\t    return RetryState(False, None, None, target_stage)\\n879\\t\\n880\\t\\n881\\tdef _pass_once(root: Path, m: dict[str, Any], item_id: str, again: str | None) -> tuple[int, \\\"DriveReport\\\"]:\\n882\\t    \\\"\\\"\\\"One pass: fast-forward to origin (never while a worker holds the\\n883\\t    copy), read the report, act at most once, return. owes-recovery\\n884\\t    recovers; next-build and next-review start their stage, handing a\\n885\\t    review the checks the report already read once on the pre-marker\\n886\\t    head; blocked-on-checks on a review (R3) starts it too -- the same\\n887\\t    act as next-review, since a concluded red check on a passed build's\\n888\\t    head is now a returned record, not a level a pass leaves alone. A\\n889\\t    stopped stage inside its budget (RetryState.eligible) retries itself,\\n890\\t    with no flag needed; `--again` is a no-op that says so when the plain\\n891\\t    mechanism would already act or is only waiting out retry_after_s, and\\n892\\t    forces the next attempt, naming who pressed it as again_by in its marker, when it would\\n893\\t    not. Every other level is printed in the report's own words and left.\\\"\\\"\\\"\\n894\\t    from attavo.report import drive_report\\n895\\t    refusal = fast_forward_to_origin(root, m, item_id)\\n896\\t    r = drive_report(root, m, item_id)\\n897\\t    if refusal:\\n898\\t        print(f\\\"attavo drive: stopped: {refusal}\\\")\\n899\\t        return 1, r\\n900\\t    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n901\\t\\n902\\t    if r[\\\"state\\\"] == \\\"owes-recovery\\\":\\n903\\t        return _recover_one(root, m, item_id, records_dir), r\\n904\\t    if r[\\\"state\\\"] == \\\"next-build\\\":\\n905\\t        return _start_stage(root, m, item_id, \\\"build\\\", None), r\\n906\\t    if r[\\\"state\\\"] in (\\\"next-review\\\", \\\"blocked-on-checks\\\") and r[\\\"stage\\\"] == \\\"verify\\\":\\n907\\t        checks_command = (m.get(\\\"forge\\\") or {}).get(\\\"checks_command\\\")\\n908\\t        forge_checks = {\\\"command\\\": checks_command, \\\"sha\\\": r[\\\"head\\\"], \\\"conclusions\\\": r[\\\"checks\\\"] or []}\\n909\\t        return _start_stage(root, m, item_id, \\\"verify\\\", forge_checks), r\\n910\\t    if r[\\\"state\\\"] == \\\"stopped\\\" and r[\\\"stage\\\"]:\\n911\\t        state = retry_state(root, m, records_dir, r[\\\"stage\\\"], r[\\\"stop_class\\\"], r[\\\"attempt\\\"])\\n912\\t        if again:\\n913\\t            if state.eligible or state.waiting_s is not None:\\n914\\t                print(\\\"attavo drive: --again inside the budget is a no-op; the pass retries \\\"\\n915\\t                      \\\"on its own\\\")\\n916\\t                return 0, r\\n917\\t            return _advance_again(root, m, item_id, state.target_stage, r[\\\"head\\\"], again_by=again), r\\n918\\t        if state.eligible:\\n919\\t            return _advance_again(root, m, item_id, state.target_stage, r[\\\"head\\\"]), r\\n920\\t\\n921\\t    print(f\\\"attavo drive: {r['says']}\\\")\\n922\\t    return (1 if r[\\\"state\\\"] == \\\"refused\\\" else 0), r\\n923\\t\\n924\\t\\n925\\t_TERMINAL_STATES = (\\\"waiting-on-approval\\\", \\\"stopped\\\", \\\"ready-to-merge\\\", \\\"merged\\\")\\n926\\t\\n927\\t\\n928\\tdef _until_ready(root: Path, m: dict[str, Any], item_id: str, again: str | None) -> int:\\n929\\t    \\\"\\\"\\\"--until-ready: the pass, repeated in one process, sleeping\\n930\\t    ATTAVO_DRIVE_POLL_INTERVAL_S between passes, until the level is the\\n931\\t    operator's or done (exit 0), a concluded check is red (exit 1), or\\n932\\t    an unconcluded one has not concluded within ATTAVO_DRIVE_POLL_BOUND_S\\n933\\t    (exit 1). A stage running in its own worker is not bounded by this --\\n934\\t    only time spent waiting on the forge is.\\\"\\\"\\\"\\n935\\t    from attavo.verify import drive_forge_poll_bound_s, drive_forge_poll_interval_s\\n936\\t    bound = drive_forge_poll_bound_s()\\n937\\t    interval = drive_forge_poll_interval_s()\\n938\\t    waiting_since: float | None = None\\n939\\t    while True:\\n940\\t        rc, r = _pass_once(root, m, item_id, again)\\n941\\t        state = r[\\\"state\\\"]\\n942\\t\\n943\\t        if state == \\\"waiting-on-checks\\\":\\n944\\t            if waiting_since is None:\\n945\\t                waiting_since = time.monotonic()\\n946\\t            elif time.monotonic() - waiting_since >= bound:\\n947\\t                print(f\\\"attavo drive: stopped: the checks did not conclude within {bound:.0f}s\\\")\\n948\\t                return 1\\n949\\t        else:\\n950\\t            waiting_since = None\\n951\\t\\n952\\t        if rc != 0:\\n953\\t            return rc\\n954\\t        # R3: \\\"stopped\\\" is terminal only when the pass actually left it\\n955\\t        # alone -- kind \\\"acts\\\" or \\\"waits\\\" means this same pass just\\n956\\t        # retried it (or is only waiting out retry_after_s), and the loop\\n957\\t        # must keep going rather than call that done.\\n958\\t        if state in _TERMINAL_STATES and not (state == \\\"stopped\\\" and r[\\\"kind\\\"] != \\\"yours\\\"):\\n959\\t            return 0\\n960\\t        # R3: blocked-on-checks on a review is no longer a dead end -- the\\n961\\t        # pass just converted it into a returned record and, inside its\\n962\\t        # budget, a build retry follows on its own. Only the post-verify\\n963\\t        # case (the checks went red after a passing review, stage None)\\n964\\t        # is still the level with nothing left to do but give up.\\n965\\t        if state == \\\"blocked-on-checks\\\" and r[\\\"stage\\\"] is None:\\n966\\t            return 1\\n967\\t        time.sleep(interval)\\n968\\t\\n969\\t\\n970\\tdef _drive_all() -> int:\\n971\\t    \\\"\\\"\\\"--all, from the tenant's checkout: one pass, in its own process\\n972\\t    (`attavo drive N`, which ensures the working copy), for every origin\\n973\\t    attavo/<N>-* branch whose item is not merged, and one for every\\n974\\t    existing ../attavo-worktree-N whose item is merged, to remove it.\\n975\\t    Every line either prints is prefixed with the working copy's own\\n976\\t    directory name, so an operator reading them together can tell which\\n977\\t    item each line is about.\\\"\\\"\\\"\\n978\\t    root = Path(\\\".\\\").resolve()\\n979\\t    if workcopy.on_item_branch(root):\\n980\\t        print(\\\"attavo drive: --all runs from the tenant's checkout, not from an item's working copy\\\",\\n981\\t              file=sys.stderr)\\n982\\t        return 2\\n983\\t    m = read_manifest(root)\\n984\\t    if m is None:\\n985\\t        print(f\\\"attavo drive: no {MANIFEST} at {root}\\\", file=sys.stderr)\\n986\\t        return 2\\n987\\t    try:\\n988\\t        on_origin = workcopy.fetch_origin_items(root)\\n989\\t    except RuntimeError as exc:\\n990\\t        print(f\\\"attavo drive: stopped: could not read origin's attavo/* branches: {exc}\\\")\\n991\\t        return 1\\n992\\t    have = workcopy.existing_copy_items(root)\\n993\\t    items = sorted(set(on_origin) | set(have), key=int)\\n994\\t    if not items:\\n995\\t        print(\\\"attavo drive: --all found no attavo/<N>-* branch on origin and no ../attavo-worktree-N\\\")\\n996\\t        return 0\\n997\\t    merged = workcopy.merged_items(root, m[\\\"paths\\\"][\\\"records\\\"], items)\\n998\\t    worst = 0\\n999\\t    for n in items:\\n1000\\t        if n in merged and n not in have:\\n1001\\t            continue\\n1002\\t        run = subprocess.run([sys.executable, str(PRODUCT_ROOT / \\\"bin\\\" / \\\"attavo\\\"), \\\"drive\\\", n],\\n1003\\t                             cwd=str(root), capture_output=True, text=True, check=False)\\n1004\\t        for line in (run.stdout + run.stderr).splitlines():\\n1005\\t            print(f\\\"attavo-worktree-{n}: {line}\\\")\\n1006\\t        worst = max(worst, run.returncode)\\n1007\\t    return worst\\n1008\\t\\n1009\\t\\n1010\\tdef cmd_drive(argv: list[str]) -> int:\\n1011\\t    # Issue #145: Python block-buffers stdout when it is not a tty (a\\n1012\\t    # pipe, e.g. a screen reading this process live), so every line this\\n1013\\t    # prints would otherwise sit unflushed until the process exits.\\n1014\\t    # Line-buffering makes a pipe reader see each line the moment it is\\n1015\\t    # printed, the same as a terminal already does; `attavo worker`\\n1016\\t    # reconfigures its own stdout the same way.\\n1017\\t    cast(io.TextIOWrapper, sys.stdout).reconfigure(line_buffering=True)\\n1018\\t\\n1019\\t    if \\\"--recover\\\" in argv:\\n1020\\t        print(\\\"attavo drive: --recover is gone; a pass recovers a dead or hung invocation \\\"\\n1021\\t              \\\"itself, as soon as the report owes one\\\", file=sys.stderr)\\n1022\\t        return 2\\n1023\\t\\n1024\\t    until_ready = \\\"--until-ready\\\" in argv\\n1025\\t    report = \\\"--report\\\" in argv\\n1026\\t    again_flag = \\\"--again\\\" in argv\\n1027\\t    all_flag = \\\"--all\\\" in argv\\n1028\\t    by: str | None = None\\n1029\\t    positional: list[str] = []\\n1030\\t    i = 0\\n1031\\t    while i < len(argv):\\n1032\\t        if argv[i] == \\\"--by\\\":\\n1033\\t            by = argv[i + 1] if i + 1 < len(argv) else None\\n1034\\t            i += 2\\n1035\\t        else:\\n1036\\t            if not argv[i].startswith(\\\"--\\\"):\\n1037\\t                positional.append(argv[i])\\n1038\\t            i += 1\\n1039\\t    if again_flag and not by:\\n1040\\t        print(\\\"attavo drive: --again requires --by LOGIN\\\", file=sys.stderr)\\n1041\\t        return 2\\n1042\\t    if \\\"--by\\\" in argv and not again_flag:\\n1043\\t        print(\\\"attavo drive: --by is only for --again\\\", file=sys.stderr)\\n1044\\t        return 2\\n1045\\t    again = by if again_flag else None\\n1046\\t\\n1047\\t    if all_flag:\\n1048\\t        if until_ready or report or again_flag or positional:\\n1049\\t            print(\\\"attavo drive: --all runs one pass in every worktree beside this checkout; \\\"\\n1050\\t                  \\\"drop N and every other flag\\\", file=sys.stderr)\\n1051\\t            return 2\\n1052\\t        return _drive_all()\\n1053\\t\\n1054\\t    root = Path(\\\".\\\").resolve()\\n1055\\t    item_id = positional[0] if positional else derive_item_id(root)\\n1056\\t    if not item_id:\\n1057\\t        print(\\\"attavo drive: cannot derive item id; pass N or run on an attavo/N-* branch\\\",\\n1058\\t              file=sys.stderr)\\n1059\\t        return 2\\n1060\\t    m = read_manifest(root)\\n1061\\t    if m is None:\\n1062\\t        print(f\\\"attavo drive: no {MANIFEST} at {root}\\\", file=sys.stderr)\\n1063\\t        return 2\\n1064\\t\\n1065\\t    if report:\\n1066\\t        if until_ready or again_flag:\\n1067\\t            print(\\\"attavo drive: --report reads and does nothing else; drop --until-ready \\\"\\n1068\\t                  \\\"and --again\\\", file=sys.stderr)\\n1069\\t            return 2\\n1070\\t        if not workcopy.on_item_branch(root):\\n1071\\t            copy = workcopy.copy_path(root, item_id)\\n1072\\t            if copy.resolve() in workcopy.registered_copies(root) and copy.is_dir():\\n1073\\t                root = copy\\n1074\\t            else:\\n1075\\t                with workcopy.read_only_copy(root, item_id) as (tree, why):\\n1076\\t                    if tree is None:\\n1077\\t                        print(f\\\"attavo drive: stopped: {why}\\\")\\n1078\\t                        return 1\\n1079\\t                    from attavo.report import drive_report\\n1080\\t                    print(json.dumps(drive_report(tree, m, item_id), indent=2))\\n1081\\t                    return 0\\n1082\\t        os.chdir(root)\\n1083\\t        refusal = fast_forward_to_origin(root, m, item_id)\\n1084\\t        if refusal:\\n1085\\t            print(f\\\"attavo drive: note: {refusal}\\\", file=sys.stderr)\\n1086\\t        from attavo.report import drive_report\\n1087\\t        print(json.dumps(drive_report(root, m, item_id), indent=2))\\n1088\\t        return 0\\n1089\\t\\n1090\\t    if not workcopy.on_item_branch(root):\\n1091\\t        ensured = workcopy.ensure(root, item_id, m[\\\"paths\\\"][\\\"records\\\"])\\n1092\\t        if ensured.path is None:\\n1093\\t            if ensured.refusal is None:\\n1094\\t                print(f\\\"attavo drive: merged: item {item_id} is merged on origin and has no working copy\\\")\\n1095\\t                return 0\\n1096\\t            print(f\\\"attavo drive: stopped: {ensured.refusal}\\\")\\n1097\\t            return 1\\n1098\\t        root = ensured.path\\n1099\\t        os.chdir(root)\\n1100\\t        m = read_manifest(root) or m\\n1101\\t\\n1102\\t    if until_ready:\\n1103\\t        rc = _until_ready(root, m, item_id, again)\\n1104\\t        r = None\\n1105\\t    else:\\n1106\\t        rc, r = _pass_once(root, m, item_id, again)\\n1107\\t    if r is None or r[\\\"state\\\"] == \\\"merged\\\":\\n1108\\t        from attavo.report import drive_report\\n1109\\t        if (r or drive_report(root, m, item_id))[\\\"state\\\"] == \\\"merged\\\":\\n1110\\t            done = workcopy.remove_when_merged(root, item_id, m[\\\"paths\\\"][\\\"records\\\"])\\n1111\\t            if done:\\n1112\\t                print(f\\\"attavo drive: {done}\\\")\\n1113\\t    return rc\\n1114\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"b3f717aa-5c2b-4867-b022-0f24cffb6427\",\"uuid\":\"4be9752e-3258-4f59-9771-450ae2aeefb7\",\"timestamp\":\"2026-09-30T23:05:37.081Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/davidbean/Projects/attavo-worktree-289/attavo/drive.py\",\"content\":\"from __future__ import annotations\\n\\nimport contextlib\\nimport io\\nimport json\\nimport os\\nimport signal\\nimport shutil\\nimport subprocess\\nimport sys\\nimport tempfile\\nimport threading\\nimport time\\nfrom collections.abc import Callable, Iterator\\nfrom pathlib import Path\\nfrom typing import TYPE_CHECKING, Any, NamedTuple, cast\\n\\nfrom attavo import clock\\nfrom attavo.approval import approval_status\\nfrom attavo.build import cmd_build, driver_identity\\nfrom attavo.common import MANIFEST, PRODUCT_ROOT, derive_item_id, git, read_manifest\\nfrom attavo.counsel import cmd_counsel\\nfrom attavo.doctor import (\\n    _parse_json_line,\\n    attempts_budget,\\n    ceiling_s,\\n    heartbeat_age_s,\\n    heartbeat_path,\\n    heartbeat_pid,\\n    heartbeat_s,\\n    invocation_age_s,\\n    invocations_without_record,\\n    retry_after_s,\\n    stall_bound_s,\\n    write_invocation_marker,\\n)\\nfrom attavo.events import stage_events_dir\\nfrom attavo.filing import cmd_file_stops\\nfrom attavo.records import (\\n    latest_attempt_path,\\n    latest_record,\\n    next_attempt_number,\\n    parse_attempts,\\n    stage_schema,\\n    write_record,\\n)\\nfrom attavo.stops import RETRYABLE_CLASSES, counsel_record_for, signature_of\\nfrom attavo.verify import cmd_verify, read_forge_checks\\nfrom attavo import workcopy\\n\\nif TYPE_CHECKING:\\n    from attavo.types import DriveReport\\n\\n# --- drive: the mechanical transitions between approval and ready-to-merge\\n# (issue #84), under the reconciler's R2 (rulings A, B, C's recovery half,\\n# F, G, H): `attavo drive N` is one short pass. It reads the report\\n# (attavo.report), acts at most once -- recovers a dead or hung\\n# invocation, or starts the next stage in a detached worker -- and\\n# returns within seconds; the stage itself runs in `attavo worker`, a\\n# child of the pass's own session, which outlives it. Writes no record of\\n# its own: the stage records already on disk, and the invocation markers\\n# and heartbeats beside them, are the only state a pass or a worker\\n# reads. ---\\n\\n\\nRECORD_PUSH_TRIES = 5\\n\\n\\nclass TransportRefused(RuntimeError):\\n    \\\"\\\"\\\"A record transport that could not land: the message is the reason,\\n    already worded for the pass or worker that prints it.\\\"\\\"\\\"\\n\\n\\ndef _driver_env() -> dict[str, str]:\\n    identity = driver_identity()\\n    env = dict(os.environ)\\n    env[\\\"GIT_AUTHOR_NAME\\\"] = identity[\\\"name\\\"]\\n    env[\\\"GIT_AUTHOR_EMAIL\\\"] = identity[\\\"email\\\"]\\n    env[\\\"GIT_COMMITTER_NAME\\\"] = identity[\\\"name\\\"]\\n    env[\\\"GIT_COMMITTER_EMAIL\\\"] = identity[\\\"email\\\"]\\n    return env\\n\\n\\ndef _retry_base(root: Path, branch: str) -> str:\\n    \\\"\\\"\\\"The commit a retried record is committed on: origin's branch tip,\\n    fetched now. It must contain this checkout's HEAD -- the stage's own\\n    commits are in it, and a record's `sha` names them -- because the\\n    driver neither merges nor rebases; a tip that does not is a refusal,\\n    with the commits it would strand named by sha and author.\\\"\\\"\\\"\\n    git(root, \\\"fetch\\\", \\\"-q\\\", \\\"origin\\\", branch)\\n    tip = git(root, \\\"rev-parse\\\", \\\"FETCH_HEAD\\\").strip()\\n    contained = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"merge-base\\\", \\\"--is-ancestor\\\", \\\"HEAD\\\", tip],\\n                               capture_output=True, text=True, check=False)\\n    if contained.returncode != 0:\\n        ours = git(root, \\\"log\\\", \\\"--format=%h %an <%ae>\\\", f\\\"{tip}..HEAD\\\").splitlines()\\n        raise TransportRefused(\\n            f\\\"origin's {branch} moved under this checkout's own commits and the driver \\\"\\n            f\\\"neither merges nor rebases them: {'; '.join(ours)}\\\")\\n    return tip\\n\\n\\n@contextlib.contextmanager\\ndef record_worktree(root: Path, tip: str) -> Iterator[Path]:\\n    \\\"\\\"\\\"A detached worktree of `tip` under the git dir, removed on exit:\\n    the only place the driver commits. The item's checkout is the\\n    executor's while a build runs, so nothing the driver writes or\\n    commits, resets or merges is made there.\\\"\\\"\\\"\\n    parent = stage_events_dir(root) / \\\"transport\\\"\\n    parent.mkdir(parents=True, exist_ok=True)\\n    tree = Path(tempfile.mkdtemp(prefix=\\\"tx-\\\", dir=parent)) / \\\"head\\\"\\n    git(root, \\\"worktree\\\", \\\"add\\\", \\\"--detach\\\", \\\"-q\\\", str(tree), tip)\\n    try:\\n        yield tree\\n    finally:\\n        try:\\n            git(root, \\\"worktree\\\", \\\"remove\\\", \\\"--force\\\", str(tree))\\n        except RuntimeError:\\n            shutil.rmtree(tree, ignore_errors=True)\\n            try:\\n                git(root, \\\"worktree\\\", \\\"prune\\\")\\n            except RuntimeError:\\n                pass\\n        shutil.rmtree(tree.parent, ignore_errors=True)\\n\\n\\ndef _record_paths(tree: Path, record_paths: list[Path]) -> list[str]:\\n    \\\"\\\"\\\"Each record's path relative to the tree, and each one's .log and\\n    .filed, each if one exists (issues #89, #100): the paths `git commit\\n    --only` names, so a transport commit never sweeps the index (issue\\n    #46's regression, on the transport side).\\\"\\\"\\\"\\n    paths: list[str] = []\\n    for record_path in record_paths:\\n        paths.append(str(record_path.relative_to(tree)))\\n        for suffix in (\\\".log\\\", \\\".filed\\\"):\\n            extra = record_path.with_suffix(suffix)\\n            if extra.is_file():\\n                paths.append(str(extra.relative_to(tree)))\\n    return paths\\n\\n\\ndef commit_record(tree: Path, record_paths: list[Path], message: str) -> str:\\n    \\\"\\\"\\\"`git commit --only` on the record paths given, in `tree` -- a\\n    record worktree, never the checkout -- as driver_identity(), set by\\n    the product and never the tenant's git config, so a driven item's\\n    record commits are never indistinguishable from an operator's own.\\n    Returns the commit's sha.\\\"\\\"\\\"\\n    paths = _record_paths(tree, record_paths)\\n    git(tree, \\\"add\\\", *paths)\\n    git(tree, \\\"commit\\\", \\\"--only\\\", \\\"-q\\\", \\\"-m\\\", message, *paths, env=_driver_env())\\n    return git(tree, \\\"rev-parse\\\", \\\"HEAD\\\").strip()\\n\\n\\ndef sync_checkout(root: Path, target: str) -> None:\\n    \\\"\\\"\\\"Fast-forward the item's checkout to `target`, the one thing the\\n    driver does to it. A pass in the same directory may hold the index\\n    for a moment, so a lock is retried; a checkout already at or beyond\\n    target is done.\\\"\\\"\\\"\\n    err = \\\"\\\"\\n    for _ in range(20):\\n        run = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"merge\\\", \\\"--ff-only\\\", \\\"-q\\\", target],\\n                             capture_output=True, text=True, check=False)\\n        if run.returncode == 0:\\n            return\\n        err = run.stderr.strip()\\n        contained = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"merge-base\\\", \\\"--is-ancestor\\\", target, \\\"HEAD\\\"],\\n                                   capture_output=True, text=True, check=False)\\n        if contained.returncode == 0:\\n            return\\n        time.sleep(0.1)\\n    raise TransportRefused(f\\\"the checkout could not fast-forward to {target[:12]}: {err}\\\")\\n\\n\\ndef _stage_copies(root: Path, paths: list[str]) -> None:\\n    \\\"\\\"\\\"Stage the checkout's own untracked copies of records the driver\\n    has just committed elsewhere, so the fast-forward that brings the\\n    committed ones in finds them identical to the target and has nothing\\n    to collide with -- and the record is never absent from the checkout,\\n    which is what a pass or a reader beside the worker sees.\\\"\\\"\\\"\\n    if not paths:\\n        return\\n    out = git(root, \\\"ls-files\\\", \\\"--others\\\", \\\"--exclude-standard\\\", \\\"--\\\", *paths).splitlines()\\n    if out:\\n        git(root, \\\"add\\\", \\\"--\\\", *out)\\n\\n\\ndef transport_records(root: Path, branch: str, message: str,\\n                      write: Callable[[Path], list[Path]],\\n                      lease: bool = False) -> tuple[str, str | None]:\\n    \\\"\\\"\\\"Commit records in a detached worktree of the branch's tip and push\\n    them from there as HEAD:branch; then fast-forward the checkout.\\n    `write(tree)` puts the records in the worktree and returns the record\\n    paths to commit -- called again on every try, since a retry starts\\n    from a freshly fetched tip.\\n\\n    The first try commits on this checkout's HEAD, which carries the\\n    stage's own commits. A push origin rejects is retried without a\\n    merge: fetch, recreate the worktree at the new tip (which must\\n    contain HEAD, see _retry_base), write again, push again as a\\n    fast-forward, RECORD_PUSH_TRIES times at most. The record's own `sha` names the\\n    stage's commit, not this transport commit, so moving the transport\\n    commit changes nothing a record names.\\n\\n    lease=True is the marker's push (ruling A): one try, and a race lost\\n    is (\\\"lost-race\\\", stderr) with the worktree discarded and the checkout\\n    untouched. Otherwise (\\\"pushed\\\", None), or (\\\"refused\\\", reason).\\\"\\\"\\\"\\n    err = \\\"\\\"\\n    base = git(root, \\\"rev-parse\\\", \\\"HEAD\\\").strip()\\n    for attempt in range(1 if lease else RECORD_PUSH_TRIES):\\n        if attempt:\\n            try:\\n                base = _retry_base(root, branch)\\n            except TransportRefused as exc:\\n                return \\\"refused\\\", str(exc)\\n            except RuntimeError as exc:\\n                return \\\"refused\\\", f\\\"could not read origin's {branch}: {exc}\\\"\\n        with record_worktree(root, base) as tree:\\n            paths = write(tree)\\n            try:\\n                sha = commit_record(tree, paths, message)\\n            except RuntimeError as exc:\\n                return \\\"refused\\\", f\\\"could not commit: {exc}\\\"\\n            if has_origin(root):\\n                run = subprocess.run([\\\"git\\\", \\\"-C\\\", str(tree), \\\"push\\\", \\\"origin\\\", f\\\"HEAD:{branch}\\\"],\\n                                     capture_output=True, text=True, check=False)\\n                if run.returncode != 0:\\n                    err = run.stderr.strip()\\n                    if lease:\\n                        raced = any(marker in run.stderr for marker in _RACE_MARKERS)\\n                        return (\\\"lost-race\\\" if raced else \\\"refused\\\"), err\\n                    continue\\n            try:\\n                _stage_copies(root, _record_paths(tree, paths))\\n                sync_checkout(root, sha)\\n            except (RuntimeError, TransportRefused) as exc:\\n                return \\\"refused\\\", str(exc)\\n            return \\\"pushed\\\", None\\n    return \\\"refused\\\", f\\\"push rejected {RECORD_PUSH_TRIES} times: {err}\\\"\\n\\n\\n_RACE_MARKERS = (\\\"non-fast-forward\\\", \\\"fetch first\\\", \\\"stale info\\\", \\\"cannot lock ref\\\",\\n                 \\\"failed to update ref\\\")\\n\\n\\ndef has_origin(root: Path) -> bool:\\n    \\\"\\\"\\\"Whether this checkout carries an origin remote at all -- a fixture\\n    or a scratch checkout with none is not a refusal; a pass commits\\n    locally and skips the push, the way recovery always has.\\\"\\\"\\\"\\n    try:\\n        git(root, \\\"remote\\\", \\\"get-url\\\", \\\"origin\\\")\\n        return True\\n    except RuntimeError:\\n        return False\\n\\n\\ndef drive_state(root: Path, m: dict[str, Any], item_id: str) -> tuple[str, str | None, Path]:\\n    \\\"\\\"\\\"(\\\"no-approval\\\" | \\\"build\\\" | \\\"verify\\\" | \\\"ready\\\", detail, records_dir):\\n    the next mechanical step for item_id, read from its latest records\\n    alone. A build only counts as current when it is a pass bound to the\\n    valid approval's own sha; a verify only counts as current when it is a\\n    pass bound to that build's own sha -- the same staleness a re-approval\\n    or a re-build must force, attest's own chain check already enforces\\n    (check_attest_chain), read here rather than re-typed.\\\"\\\"\\\"\\n    records_rel = m[\\\"paths\\\"][\\\"records\\\"]\\n    records_dir = root / records_rel / item_id\\n\\n    status = approval_status(root, m, item_id)\\n    if status != \\\"valid\\\":\\n        return \\\"no-approval\\\", status, records_dir\\n\\n    latest_approval = latest_record(records_dir, \\\"approval\\\")\\n    latest_build = latest_record(records_dir, \\\"build\\\")\\n    build_current = (latest_build is not None and latest_build.get(\\\"status\\\") == \\\"pass\\\"\\n                     and latest_build.get(\\\"approval_sha\\\")\\n                     == (latest_approval.get(\\\"sha\\\") if latest_approval else None))\\n    if latest_build is None or not build_current:\\n        return \\\"build\\\", None, records_dir\\n\\n    latest_verify = latest_record(records_dir, \\\"verify\\\")\\n    verify_current = (latest_verify is not None and latest_verify.get(\\\"status\\\") == \\\"pass\\\"\\n                      and latest_verify.get(\\\"build_sha\\\") == latest_build.get(\\\"sha\\\"))\\n    if not verify_current:\\n        return \\\"verify\\\", None, records_dir\\n\\n    return \\\"ready\\\", None, records_dir\\n\\n\\n# --- the heartbeat (its helpers live in attavo/doctor.py, where proof five\\n# reads it too), the worker log, and the forge-checks handoff: local\\n# facts under the checkout's own git directory (issue #140's precedent),\\n# never committed and never among the paths commit_record ever names. ---\\n\\ndef worker_log_path(root: Path, stage: str, nn: int) -> Path:\\n    return stage_events_dir(root) / f\\\"{stage}-{nn:02d}.worker.log\\\"\\n\\n\\ndef forge_checks_path(root: Path, stage: str, nn: int) -> Path:\\n    return stage_events_dir(root) / f\\\"{stage}-{nn:02d}.forge-checks.json\\\"\\n\\n\\ndef _events_path_for(root: Path, stage: str, nn: int) -> Path | None:\\n    \\\"\\\"\\\"The adapter's own events file for this invocation, under the\\n    checkout's git dir (a worktree's own dir when the checkout is one).\\\"\\\"\\\"\\n    try:\\n        gitdir = Path(git(root, \\\"rev-parse\\\", \\\"--git-dir\\\").strip())\\n    except RuntimeError:\\n        return None\\n    if not gitdir.is_absolute():\\n        gitdir = root / gitdir\\n    path = gitdir / \\\"attavo\\\" / f\\\"{stage}-{nn:02d}.events.jsonl\\\"\\n    return path if path.is_file() else None\\n\\n\\ndef _events_tail(path: Path | None, lines: int = 20) -> tuple[str, str | None]:\\n    \\\"\\\"\\\"(the last lines as a log, the last event's own at).\\\"\\\"\\\"\\n    if path is None:\\n        return \\\"no events file for this invocation\\\\n\\\", None\\n    try:\\n        text = path.read_text()\\n    except OSError:\\n        return \\\"events file unreadable\\\\n\\\", None\\n    tail = text.splitlines()[-lines:]\\n    last_at = None\\n    for line in reversed(tail):\\n        parsed = _parse_json_line(line)\\n        if not isinstance(parsed, dict):\\n            continue\\n        at = parsed.get(\\\"at\\\")\\n        if isinstance(at, str):\\n            last_at = at\\n            break\\n    return \\\"\\\\n\\\".join(tail) + \\\"\\\\n\\\", last_at\\n\\n\\ndef _seconds_since(at: str | None) -> float | None:\\n    from datetime import datetime, timezone\\n    if not at:\\n        return None\\n    try:\\n        then = datetime.strptime(at, \\\"%Y-%m-%dT%H:%M:%SZ\\\").replace(tzinfo=timezone.utc)\\n    except ValueError:\\n        return None\\n    return clock.now() - then.timestamp()\\n\\n\\nclass InvocationReading(NamedTuple):\\n    \\\"\\\"\\\"What one marker with no record reads as, from here and now.\\\"\\\"\\\"\\n    stage: str\\n    nn: int\\n    log: str\\n    last_at: str | None\\n    age: float | None\\n    cls: str  # \\\"running\\\" | \\\"hung\\\" | \\\"died\\\"\\n    bound: str | None = None  # R3: \\\"stall\\\" or \\\"ceiling\\\" when cls is \\\"hung\\\"\\n\\n\\ndef _manifest_of(root: Path) -> dict[str, Any]:\\n    m = read_manifest(root)\\n    return m if m is not None else {}\\n\\n\\ndef _streams_events(root: Path, m: dict[str, Any], stage: str) -> bool:\\n    \\\"\\\"\\\"R3: whether stage's adapter declares it streams events at all\\n    (adapters/<name>/conformance.json, \\\"streams_events\\\") -- one that does\\n    not is judged by its ceiling alone, and never called hung by event\\n    age it never produces. True (the ordinary case) when the adapter\\n    declares nothing, or none is configured to ask.\\\"\\\"\\\"\\n    name = (m.get(\\\"executor\\\") or {}).get(stage) or (m.get(\\\"executor\\\") or {}).get(\\\"build\\\")\\n    if not name:\\n        return True\\n    for base in (root / \\\"attavo\\\" / \\\"adapters\\\", PRODUCT_ROOT / \\\"adapters\\\"):\\n        conf = base / name / \\\"conformance.json\\\"\\n        if conf.is_file():\\n            try:\\n                return bool(json.loads(conf.read_text()).get(\\\"streams_events\\\", True))\\n            except (OSError, ValueError):\\n                return True\\n    return True\\n\\n\\ndef read_invocation(root: Path, bound: int | None, marker: Path, info: dict[str, Any]) -> InvocationReading:\\n    \\\"\\\"\\\"Whether an invocation that began and wrote no record is running,\\n    hung, or died -- read from the heartbeat its holder writes and from\\n    nothing else (root cause 4). A heartbeat fresh within three beats of\\n    ATTAVO_HEARTBEAT_S is a live holder: running, or, with a stall bound\\n    declared and the last event (the marker's own `at` when there is\\n    none) older than it, hung. A stale heartbeat is died, whether or not\\n    any pid lives -- a worker stuck somewhere that never reaches its own\\n    heartbeat loop again is exactly what this is for. With no heartbeat\\n    file a marker from this host is died -- the holder never touched its\\n    first beat, or is gone -- and one from another host follows the stall\\n    bound as proof five does: running while younger, died after. The\\n    stall bound decides hung, never died.\\n\\n    R3: the stage's own ceiling (wall clock from the marker's own `at`)\\n    is judged first, before any of that -- alive past it is hung by the\\n    ceiling whatever event age says, and an adapter that declares it\\n    streams no events is judged by the ceiling alone: bound is read as\\n    None for it, so the stall check below never fires on an event age it\\n    never had.\\\"\\\"\\\"\\n    import socket\\n    stage, nn_text = marker.stem.rsplit(\\\"-\\\", 1)\\n    nn = int(nn_text)\\n    log, last_at = _events_tail(_events_path_for(root, stage, nn))\\n    m = _manifest_of(root)\\n    ceiling = ceiling_s(m, stage)\\n    since_start = _seconds_since(info.get(\\\"at\\\"))\\n    if ceiling is not None and since_start is not None and since_start > ceiling:\\n        return InvocationReading(stage, nn, log, last_at, since_start, \\\"hung\\\", \\\"ceiling\\\")\\n    stall_bound = bound\\n    if not _streams_events(root, m, stage):\\n        bound = None\\n    beat_age = heartbeat_age_s(heartbeat_path(root, stage, nn))\\n    if beat_age is not None:\\n        if beat_age > heartbeat_s() * 3:\\n            return InvocationReading(stage, nn, log, last_at, beat_age, \\\"died\\\")\\n        age = _seconds_since(last_at or info.get(\\\"at\\\"))\\n        if bound is None or age is None or age <= bound:\\n            return InvocationReading(stage, nn, log, last_at, beat_age, \\\"running\\\")\\n        return InvocationReading(stage, nn, log, last_at, age, \\\"hung\\\", \\\"stall\\\")\\n    if info.get(\\\"host\\\") != socket.gethostname():\\n        marker_age = invocation_age_s(info)\\n        if stall_bound is not None and marker_age is not None and marker_age < stall_bound:\\n            return InvocationReading(stage, nn, log, last_at, marker_age, \\\"running\\\")\\n    return InvocationReading(stage, nn, log, last_at, _seconds_since(last_at or info.get(\\\"at\\\")), \\\"died\\\")\\n\\n\\ndef uncommitted_record(root: Path, records_dir: Path, stage: str) -> Path | None:\\n    \\\"\\\"\\\"The latest <stage>-NN.json this working tree carries that git has\\n    no commit for yet -- the moment between a worker's write and its own\\n    commit. None when the latest record is already committed, or there\\n    is none at all.\\\"\\\"\\\"\\n    path = latest_attempt_path(records_dir, stage)\\n    if path is None or not path.is_file():\\n        return None\\n    status = subprocess.run(\\n        [\\\"git\\\", \\\"-C\\\", str(root), \\\"status\\\", \\\"--porcelain\\\", \\\"--\\\", str(path.relative_to(root))],\\n        capture_output=True, text=True, check=False)\\n    return path if status.stdout.strip() else None\\n\\n\\ndef worker_holds_copy(root: Path, records_dir: Path) -> bool:\\n    \\\"\\\"\\\"True when this checkout's own working tree cannot safely be moved\\n    -- an invocation marker with no record yet (a worker, here or\\n    elsewhere, still holds this attempt), or a build or verify record the\\n    working tree carries that git has not committed yet. Scoped to the\\n    stage records a pass or a worker itself ever transports -- an\\n    operator's own spec-gate or approve, routinely uncommitted between\\n    their own act and the next pass, is not this. A pass never\\n    fast-forwards while this holds (never while a worker holds the\\n    copy).\\\"\\\"\\\"\\n    if invocations_without_record(records_dir):\\n        return True\\n    return (uncommitted_record(root, records_dir, \\\"build\\\") is not None\\n           or uncommitted_record(root, records_dir, \\\"verify\\\") is not None)\\n\\n\\ndef fast_forward_to_origin(root: Path, m: dict[str, Any], item_id: str) -> str | None:\\n    \\\"\\\"\\\"The pass's own read of origin's branch, taken before it reads\\n    anything else -- a commit landed there from elsewhere (an approval\\n    from the screen, a ruling, another pass's own record) is not a race\\n    for the lease, it is exactly what the lease is for. Never while a\\n    worker holds this copy (worker_holds_copy): moving a working tree a\\n    detached child is still writing into would corrupt its own commits.\\n    The checkout only fast-forwards. When it carries commits origin has\\n    not seen (an operator's approval, not yet pushed), the pass does not\\n    replay them: it returns a refusal naming each by sha and author, and\\n    the commits stay where they are. None when the checkout is now at\\n    origin's tip or there is nothing to read; silent about an absent\\n    origin or an unreachable one, which the ordinary read (and the\\n    marker push, for the lease) sort out.\\\"\\\"\\\"\\n    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n    if worker_holds_copy(root, records_dir) or not has_origin(root):\\n        return None\\n    try:\\n        branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n        git(root, \\\"fetch\\\", \\\"origin\\\", branch)\\n    except RuntimeError:\\n        return None\\n    ours = git(root, \\\"log\\\", \\\"--format=%h %an <%ae>\\\", \\\"FETCH_HEAD..HEAD\\\").splitlines()\\n    if not ours:\\n        try:\\n            git(root, \\\"merge\\\", \\\"--ff-only\\\", \\\"FETCH_HEAD\\\")\\n        except RuntimeError:\\n            pass\\n        return None\\n    listed = \\\"; \\\".join(ours)\\n    return (f\\\"this checkout carries {len(ours)} commit(s) origin's {branch} lacks and the pass \\\"\\n            f\\\"does not replay them: {listed}. Push them, or move them, and run the pass again\\\")\\n\\n\\n# --- the worker: a detached child of the pass's own session, running the\\n# stage exactly as the pass used to inline, touching its own heartbeat\\n# while it does (R2). ---\\n\\ndef _stage_body(item_id: str, stage: str, nn: int) -> int:\\n    \\\"\\\"\\\"Runs build or verify in-process -- the same command `attavo build`\\n    or `attavo verify` would run -- while touching heartbeat_path every\\n    heartbeat_s() seconds, then transports whatever it wrote: counsel and\\n    file-stops on a non-pass record (issue #100, #89), one `git commit\\n    --only`, one push with the record push's own merge retry. The\\n    marker is the pass's, already committed and pushed before this\\n    starts; this writes and transports only the stage's own record (and,\\n    on a stop, its counsel record).\\\"\\\"\\\"\\n    root = Path(\\\".\\\").resolve()\\n    m = read_manifest(root)\\n    if m is None:\\n        return 2\\n    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n    before = latest_attempt_path(records_dir, stage)\\n\\n    beat = heartbeat_path(root, stage, nn)\\n    beat.parent.mkdir(parents=True, exist_ok=True)\\n    beat.write_text(f\\\"{os.getpid()}\\\\n\\\")\\n    stop_beat = threading.Event()\\n\\n    def _tick() -> None:\\n        while not stop_beat.wait(heartbeat_s()):\\n            beat.touch()\\n\\n    beat_thread = threading.Thread(target=_tick, daemon=True)\\n    beat_thread.start()\\n    # The heartbeat says the holder is alive, so it runs until the holder\\n    # returns -- through counsel, file-stops, the commit and the push --\\n    # not until the stage command does.\\n    try:\\n        return _run_and_transport(item_id, stage, root, m, records_dir, branch, before)\\n    finally:\\n        stop_beat.set()\\n        beat_thread.join()\\n\\n\\ndef _run_and_transport(item_id: str, stage: str, root: Path, m: dict[str, Any],\\n                       records_dir: Path, branch: str, before: Path | None) -> int:\\n    rc = cmd_build([item_id]) if stage == \\\"build\\\" else cmd_verify([item_id])\\n\\n    after = latest_attempt_path(records_dir, stage)\\n    if after is None or after == before:\\n        # Refused before writing anything at all (e.g. no adapter\\n        # configured) -- the stage command already printed why.\\n        return rc if rc != 0 else 1\\n\\n    record = cast(dict[str, Any], latest_record(records_dir, stage))\\n    status_out = record.get(\\\"status\\\")\\n    to_commit = [after]\\n    if status_out != \\\"pass\\\":\\n        stop = record.get(\\\"stop\\\") or {}\\n        state = retry_state(root, m, records_dir, stage, stop.get(\\\"class\\\"),\\n                            int(after.stem.rsplit(\\\"-\\\", 1)[1]))\\n        # R3: a stop the next plain pass would already retry -- now, or\\n        # once its transient wait elapses -- asks counsel nothing and\\n        # files nothing (#194's own verify-01, replayed as this item's\\n        # rejection fixture, paid for exactly this on a vendor's own\\n        # capacity error). Counsel reads it, as before, the moment that\\n        # is no longer true: the budget is spent, the early stop fired,\\n        # or the class was never a plain retry's to begin with.\\n        if not (state.eligible or state.waiting_s is not None):\\n            counsel_before = latest_attempt_path(records_dir, \\\"counsel\\\")\\n            cmd_counsel([item_id])\\n            counsel_after = latest_attempt_path(records_dir, \\\"counsel\\\")\\n            if counsel_after is not None and counsel_after != counsel_before:\\n                to_commit.append(counsel_after)\\n            # file-stops is its own idempotent read of the item's records,\\n            # so calling it here on every run that wrote a non-pass record\\n            # is safe to call again on a later run: an already-filed\\n            # stop's own marker is what stops it from being filed twice.\\n            cmd_file_stops([item_id])\\n\\n    message = f\\\"attavo: {stage} record for item {item_id} ({after.stem})\\\"\\n\\n    def copy_in(tree: Path) -> list[Path]:\\n        # The stage command wrote the records in this checkout, untracked;\\n        # they are committed from the detached worktree and the checkout's\\n        # copies become the committed ones when the checkout fast-forwards\\n        # (transport_records).\\n        copied: list[Path] = []\\n        for record_path in to_commit:\\n            for src in (record_path, record_path.with_suffix(\\\".log\\\"), record_path.with_suffix(\\\".filed\\\")):\\n                if src.is_file():\\n                    dest = tree / src.relative_to(root)\\n                    dest.parent.mkdir(parents=True, exist_ok=True)\\n                    shutil.copyfile(src, dest)\\n            copied.append(tree / record_path.relative_to(root))\\n        return copied\\n\\n    outcome, err = transport_records(root, branch, message, copy_in)\\n    if outcome != \\\"pushed\\\":\\n        print(f\\\"attavo drive: stopped: could not push the {stage} record: {err}\\\")\\n        return 1\\n    if not has_origin(root):\\n        print(f\\\"attavo drive: note: no origin remote; {after.name} is committed, not pushed\\\")\\n\\n    if status_out == \\\"halted\\\":\\n        question = (record.get(\\\"halted\\\") or {}).get(\\\"question\\\")\\n        print(f\\\"attavo drive: stopped: {stage} halted: {question} ({after.name}); \\\"\\n              f\\\"pushed to {branch}\\\")\\n    elif status_out != \\\"pass\\\":\\n        reason = record.get(\\\"refusal\\\") or status_out\\n        print(f\\\"attavo drive: stopped: {stage} {status_out}: {reason} ({after.name}); \\\"\\n              f\\\"pushed to {branch}\\\")\\n    else:\\n        print(f\\\"attavo drive: pushed {after.name} to {branch}\\\")\\n    return rc\\n\\n\\ndef cmd_worker(argv: list[str]) -> int:\\n    \\\"\\\"\\\"`attavo worker N <build|verify> NN`: the detached child a pass\\n    starts once its marker is pushed -- the lease held, the attempt is\\n    this worker's to run. Its own session (start_new_session, set by the\\n    pass that spawns it); its stdout and stderr are the pass's own\\n    redirect, to <git-dir>/attavo/<stage>-NN.worker.log.\\\"\\\"\\\"\\n    cast(io.TextIOWrapper, sys.stdout).reconfigure(line_buffering=True)\\n    if len(argv) != 3:\\n        print(\\\"attavo worker: usage: attavo worker N <build|verify> NN\\\", file=sys.stderr)\\n        return 2\\n    item_id, stage, nn_text = argv\\n    if stage not in (\\\"build\\\", \\\"verify\\\"):\\n        print(f\\\"attavo worker: {stage!r} is not build or verify\\\", file=sys.stderr)\\n        return 2\\n    try:\\n        nn = int(nn_text)\\n    except ValueError:\\n        print(f\\\"attavo worker: {nn_text!r} is not an attempt number\\\", file=sys.stderr)\\n        return 2\\n    return _stage_body(item_id, stage, nn)\\n\\n\\n# --- the pass's own two acts: start a stage (the lease), and recover\\n# exactly the one invocation the report names owed one. ---\\n\\ndef _start_stage(root: Path, m: dict[str, Any], item_id: str, stage: str,\\n                 forge_checks: dict[str, Any] | None, again_by: str | None = None) -> int:\\n    \\\"\\\"\\\"The lease (ruling A): the marker, committed and pushed as a plain\\n    fast-forward with no merge and no retry, made and pushed from a\\n    detached worktree (transport_records). Lost to another pass, or\\n    refused outright by the remote, the worktree is discarded and this\\n    checkout was never touched; only a pushed lease starts the worker. On a\\n    review, forge_checks is the checks this same pass already read on\\n    the pre-marker head (ruling B) -- written to\\n    <git-dir>/attavo/verify-NN.forge-checks.json and named in\\n    ATTAVO_FORGE_CHECKS, so the worker's own `attavo verify` reads it\\n    instead of polling. again_by (R3) is the login that pressed `--again`, set\\n    only when it is what started this attempt, past a budget already spent\\n    or an early stop -- named in the marker, never on an ordinary or\\n    plainly-retried attempt.\\\"\\\"\\\"\\n    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n    nn = next_attempt_number(records_dir, stage)\\n    marker = records_dir / f\\\"{stage}-{nn:02d}.started\\\"\\n\\n    def write_marker(tree: Path) -> list[Path]:\\n        return [write_invocation_marker(tree, tree / records_dir.relative_to(root), stage, nn,\\n                                        again_by=again_by)]\\n\\n    outcome, err = transport_records(\\n        root, branch, f\\\"attavo: {stage} invocation {nn:02d} started for item {item_id}\\\",\\n        write_marker, lease=True)\\n    if outcome == \\\"lost-race\\\":\\n        print(f\\\"attavo drive: another pass holds this attempt ({marker.name}); nothing started\\\")\\n        return 0\\n    if outcome != \\\"pushed\\\":\\n        print(f\\\"attavo drive: stopped: could not push the {stage} invocation marker: {err}\\\")\\n        return 1\\n\\n    env = dict(os.environ)\\n    if forge_checks is not None:\\n        checks_file = forge_checks_path(root, stage, nn)\\n        checks_file.write_text(json.dumps(forge_checks))\\n        env[\\\"ATTAVO_FORGE_CHECKS\\\"] = str(checks_file)\\n    log = worker_log_path(root, stage, nn)\\n    with log.open(\\\"ab\\\") as fh, open(os.devnull, \\\"rb\\\") as devnull:\\n        proc = subprocess.Popen(\\n            [sys.executable, str(PRODUCT_ROOT / \\\"bin\\\" / \\\"attavo\\\"), \\\"worker\\\", item_id, stage, f\\\"{nn:02d}\\\"],\\n            cwd=str(root), env=env, stdin=devnull, stdout=fh, stderr=subprocess.STDOUT,\\n            start_new_session=True)\\n    word = \\\"Build\\\" if stage == \\\"build\\\" else \\\"Review\\\"\\n    print(f\\\"attavo drive: {word} started (attempt {nn:02d}, worker pid {proc.pid})\\\")\\n    return 0\\n\\n\\ndef _recover_one(root: Path, m: dict[str, Any], item_id: str, records_dir: Path) -> int:\\n    \\\"\\\"\\\"The pass's own recovery act (what `--recover` did): exactly the one\\n    invocation the report just read as owing one -- died or hung -- ends\\n    here. class died when the heartbeat is stale or absent, class hung\\n    when the heartbeat is fresh and a declared [drive].stall_after_s has\\n    passed with no newer event (or the stage's ceiling has passed), the\\n    holder terminated by the pid its own heartbeat names. Provenance product; the events tail as the log. Committed\\n    and pushed the way any stage record is (transport_records, with its\\n    retry that never merges) -- this is not a race for a lease, since no new\\n    attempt marker is written.\\\"\\\"\\\"\\n    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n    bound = stall_bound_s(m)\\n    pending = invocations_without_record(records_dir)\\n    readings = [(marker, info, read_invocation(root, bound, marker, info)) for marker, info in pending]\\n    candidate = next(((mk, i, rd) for mk, i, rd in readings if rd.cls != \\\"running\\\"), None)\\n    if candidate is None:\\n        # The report read this a moment ago; nothing owed recovery by the\\n        # time this pass got here (another pass recovered it, or it\\n        # finished on its own).\\n        return 0\\n    marker, info, reading = candidate\\n    stage, nn, log, last_at, age, cls, crossed = reading\\n    host = info.get(\\\"host\\\")\\n\\n    if next_attempt_number(records_dir, stage) != nn:\\n        print(f\\\"attavo drive: stopped: {marker.name} names attempt {nn} but the next \\\"\\n              f\\\"{stage} record would be {next_attempt_number(records_dir, stage):02d}; \\\"\\n              f\\\"a later record already exists, read the records before recovering\\\")\\n        return 1\\n\\n    if cls == \\\"hung\\\":\\n        holder = heartbeat_pid(heartbeat_path(root, stage, nn))\\n        if holder is None:\\n            print(f\\\"attavo drive: no holder to signal for {marker.stem}: its heartbeat names no pid\\\")\\n            ended = \\\"no holder to signal\\\"\\n            who = f\\\"no holder on {host}\\\"\\n        else:\\n            who = f\\\"pid {holder} on {host} alive\\\"\\n            try:\\n                os.kill(holder, signal.SIGTERM)\\n                ended = \\\"terminated\\\"\\n            except OSError as exc:\\n                ended = f\\\"not terminated ({exc})\\\"\\n        if crossed == \\\"ceiling\\\":\\n            detail = (f\\\"{who} {int(cast(float, age))} s after its marker, \\\"\\n                      f\\\"past the {stage} ceiling of {ceiling_s(m, stage)} s; {ended}\\\")\\n        else:\\n            detail = (f\\\"{who} with no event for {int(cast(float, age))} s \\\"\\n                      f\\\"(bound {bound} s); {ended}\\\")\\n    else:\\n        detail = (f\\\"{marker.stem} on {host} has no live heartbeat and wrote no {marker.stem}.json; \\\"\\n                  f\\\"started {info.get('at')}, last event {last_at or 'none'}\\\")\\n\\n    signature_text = log.strip().splitlines()[-1] if log.strip() else detail\\n\\n    schema = stage_schema(stage)\\n    record: dict[str, Any] = {k: None for k in schema.get(\\\"required\\\", [])}\\n    approval = latest_record(records_dir, \\\"approval\\\")\\n    record.update({\\\"sha\\\": info.get(\\\"sha\\\"), \\\"start_sha\\\": info.get(\\\"sha\\\"),\\n                   \\\"approval_sha\\\": approval.get(\\\"sha\\\") if approval else None,\\n                   \\\"at\\\": info.get(\\\"at\\\"),\\n                   \\\"adapter\\\": (m.get(\\\"executor\\\") or {}).get(stage),\\n                   \\\"status\\\": \\\"failed\\\", \\\"refusal\\\": None, \\\"halted\\\": None,\\n                   \\\"retry_of\\\": None, \\\"steer\\\": None,\\n                   \\\"stop\\\": {\\\"class\\\": cls, \\\"provenance\\\": \\\"product\\\", \\\"detail\\\": detail,\\n                            \\\"signature\\\": signature_of(signature_text), \\\"bound\\\": crossed}})\\n    if \\\"wall_clock_s\\\" in record:\\n        record[\\\"wall_clock_s\\\"] = None if age is None else int(age)\\n    record = {k: v for k, v in record.items() if k in schema.get(\\\"properties\\\", {})}\\n    tree_records = records_dir.relative_to(root)\\n\\n    def write_recovered(tree: Path) -> list[Path]:\\n        return [write_record(tree / tree_records, stage, record, m, item_id, log=log)]\\n\\n    message = (f\\\"attavo: {stage} record for item {item_id} \\\"\\n               f\\\"({stage}-{nn:02d}), recovered as {cls}\\\")\\n    try:\\n        outcome, err = transport_records(root, branch, message, write_recovered)\\n    except ValueError as exc:\\n        print(f\\\"attavo drive: stopped: could not write the {cls} record for {marker.stem}: {exc}\\\")\\n        return 1\\n    if outcome != \\\"pushed\\\":\\n        print(f\\\"attavo drive: stopped: could not push the {cls} record: {err}\\\")\\n        return 1\\n    if not has_origin(root):\\n        print(f\\\"attavo drive: note: no origin remote; {stage}-{nn:02d}.json is committed, not pushed\\\")\\n    print(f\\\"attavo drive: recovered {marker.stem} as {cls}: {detail}\\\")\\n    return 0\\n\\n\\ndef _advance_again(root: Path, m: dict[str, Any], item_id: str, stage: str, head: str | None,\\n                   again_by: str | None = None) -> int:\\n    \\\"\\\"\\\"The next attempt of a stopped stage, bypassing the level a plain\\n    pass leaves alone for the operator: what a plain retry (R3, inside\\n    the budget) starts on its own, and what `--again` starts by force\\n    once the budget is spent or an early stop fired. A review reads the\\n    forge fresh here -- once, since the report's own stopped reading\\n    never touched it -- rather than reusing a read that was never taken.\\\"\\\"\\\"\\n    if stage == \\\"build\\\":\\n        return _start_stage(root, m, item_id, \\\"build\\\", None, again_by=again_by)\\n    checks_command = (m.get(\\\"forge\\\") or {}).get(\\\"checks_command\\\")\\n    if not checks_command:\\n        print(\\\"attavo drive: refused: no [forge].checks_command in the manifest\\\")\\n        return 1\\n    forge_checks, ok = read_forge_checks(root, checks_command, cast(str, head))\\n    if not ok:\\n        conclusions = forge_checks[\\\"conclusions\\\"]\\n        named = \\\", \\\".join(f\\\"{c['name']} {c['conclusion']}\\\" for c in conclusions) or \\\"no checks reported\\\"\\n        print(f\\\"attavo drive: forge checks not green on {cast(str, head)[:12]}: {named}\\\")\\n        return 0\\n    return _start_stage(root, m, item_id, \\\"verify\\\", forge_checks, again_by=again_by)\\n\\n\\n# --- R3: the retry decision, shared by the report's own kind/says and the\\n# pass's own act (retry_state) so the two cannot drift. ---\\n\\n# Never retried by this item, whatever counsel might rule: a\\n# claims-boundary stop is a person's; a tenant's gate refusal is the\\n# spec-gate's own, earlier than any of this; an environment refusal is\\n# recorded here and acted on by R4's breaker. A question is not in this\\n# tuple -- counsel reads it exactly like any other non-pass record, and\\n# an \\\"answer\\\" verdict starts the next attempt steered by it, the same as\\n# any class counsel can rule on; a question nobody answers (no counsel\\n# configured, or its own verdict is \\\"person\\\") simply never becomes\\n# eligible, with no exclusion needed to keep it that way.\\nNEVER_RETRIED_CLASSES = (\\\"claims-boundary\\\", \\\"gate\\\", \\\"environment\\\")\\n\\n\\ndef _budget_stage(stage: str, stop_class: str | None) -> str:\\n    \\\"\\\"\\\"The stage whose [drive].attempts budget a stop spends -- build for\\n    a returned review (the check rejection or the blocking finding is the\\n    build's to answer, never the review's own to repeat), the stop's own\\n    stage for everything else.\\\"\\\"\\\"\\n    return \\\"build\\\" if stop_class == \\\"returned\\\" else stage\\n\\n\\ndef _signatures_match(records_dir: Path, stage: str) -> bool:\\n    \\\"\\\"\\\"Whether the last two attempts of stage carry the identical,\\n    non-null signature -- the early stop (R3): two attempts of one stage\\n    ending the same way spend no third.\\\"\\\"\\\"\\n    attempts = parse_attempts(records_dir, stage)\\n    if len(attempts) < 2:\\n        return False\\n    nums = sorted(attempts)\\n    sig_a = (attempts[nums[-1]].get(\\\"stop\\\") or {}).get(\\\"signature\\\")\\n    sig_b = (attempts[nums[-2]].get(\\\"stop\\\") or {}).get(\\\"signature\\\")\\n    return sig_a is not None and sig_a == sig_b\\n\\n\\nclass RetryState(NamedTuple):\\n    \\\"\\\"\\\"Whether a plain pass, right now, would start the next attempt of a\\n    stopped stage (R3) -- eligible; a transient stop still short of\\n    [drive].retry_after_s carries waiting_s instead, eligible for neither\\n    a plain pass nor `--again`'s own no-op read of the same fact; steer\\n    names the counsel record an \\\"answer\\\" verdict would hand the next\\n    attempt; target_stage is the stage the next attempt actually starts\\n    (build, for a returned review).\\\"\\\"\\\"\\n    eligible: bool\\n    waiting_s: float | None\\n    steer: str | None\\n    target_stage: str\\n\\n\\ndef retry_state(root: Path, m: dict[str, Any], records_dir: Path, stage: str,\\n                stop_class: str | None, attempt: int | None) -> RetryState:\\n    \\\"\\\"\\\"The one read behind both the report's own kind/says (a stopped\\n    stage that would retry reads as \\\"acts\\\" or \\\"waits\\\", never \\\"yours\\\") and\\n    the pass's own act, so the two cannot say different things about the\\n    same stop. died, hung, transient, and returned retry with no counsel\\n    asked, inside the shared budget and past the early stop; every other\\n    class retries only when counsel's own verdict for this exact stop is\\n    \\\"answer\\\" -- and never when the class is one of NEVER_RETRIED_CLASSES,\\n    whatever counsel might have said.\\\"\\\"\\\"\\n    target_stage = _budget_stage(stage, stop_class)\\n    if stop_class is None or stop_class in NEVER_RETRIED_CLASSES or attempt is None:\\n        return RetryState(False, None, None, target_stage)\\n    spent = next_attempt_number(records_dir, target_stage) - 1\\n    if spent >= attempts_budget(m):\\n        return RetryState(False, None, None, target_stage)\\n    if _signatures_match(records_dir, stage):\\n        return RetryState(False, None, None, target_stage)\\n    if stop_class in RETRYABLE_CLASSES:\\n        if stop_class == \\\"transient\\\":\\n            attempts = parse_attempts(records_dir, stage)\\n            rec = attempts.get(attempt)\\n            age = _seconds_since(rec.get(\\\"at\\\")) if rec else None\\n            wait = retry_after_s(m)\\n            if age is not None and age < wait:\\n                return RetryState(False, wait - age, None, target_stage)\\n        return RetryState(True, None, None, target_stage)\\n    counsel = counsel_record_for(records_dir, stage, attempt)\\n    if counsel is not None and counsel.get(\\\"verdict\\\") == \\\"answer\\\":\\n        target = f\\\"{stage}-{attempt:02d}\\\"\\n        counsel_attempts = parse_attempts(records_dir, \\\"counsel\\\")\\n        matches = [n for n, rec in counsel_attempts.items() if rec.get(\\\"record\\\") == target]\\n        if matches:\\n            return RetryState(True, None, f\\\"counsel-{max(matches):02d}\\\", target_stage)\\n    return RetryState(False, None, None, target_stage)\\n\\n\\ndef _pass_once(root: Path, m: dict[str, Any], item_id: str, again: str | None) -> tuple[int, \\\"DriveReport\\\"]:\\n    \\\"\\\"\\\"One pass: fast-forward to origin (never while a worker holds the\\n    copy), read the report, act at most once, return. owes-recovery\\n    recovers; next-build and next-review start their stage, handing a\\n    review the checks the report already read once on the pre-marker\\n    head; blocked-on-checks on a review (R3) starts it too -- the same\\n    act as next-review, since a concluded red check on a passed build's\\n    head is now a returned record, not a level a pass leaves alone. A\\n    stopped stage inside its budget (RetryState.eligible) retries itself,\\n    with no flag needed; `--again` is a no-op that says so when the plain\\n    mechanism would already act or is only waiting out retry_after_s, and\\n    forces the next attempt, naming who pressed it as again_by in its marker, when it would\\n    not. Every other level is printed in the report's own words and left.\\\"\\\"\\\"\\n    from attavo.report import drive_report\\n    refusal = fast_forward_to_origin(root, m, item_id)\\n    r = drive_report(root, m, item_id)\\n    if refusal:\\n        print(f\\\"attavo drive: stopped: {refusal}\\\")\\n        return 1, r\\n    records_dir = root / m[\\\"paths\\\"][\\\"records\\\"] / item_id\\n\\n    if r[\\\"state\\\"] == \\\"owes-recovery\\\":\\n        return _recover_one(root, m, item_id, records_dir), r\\n    if r[\\\"state\\\"] == \\\"next-build\\\":\\n        return _start_stage(root, m, item_id, \\\"build\\\", None), r\\n    if r[\\\"state\\\"] in (\\\"next-review\\\", \\\"blocked-on-checks\\\") and r[\\\"stage\\\"] == \\\"verify\\\":\\n        checks_command = (m.get(\\\"forge\\\") or {}).get(\\\"checks_command\\\")\\n        forge_checks = {\\\"command\\\": checks_command, \\\"sha\\\": r[\\\"head\\\"], \\\"conclusions\\\": r[\\\"checks\\\"] or []}\\n        return _start_stage(root, m, item_id, \\\"verify\\\", forge_checks), r\\n    if r[\\\"state\\\"] == \\\"stopped\\\" and r[\\\"stage\\\"]:\\n        state = retry_state(root, m, records_dir, r[\\\"stage\\\"], r[\\\"stop_class\\\"], r[\\\"attempt\\\"])\\n        if again:\\n            if state.eligible or state.waiting_s is not None:\\n                print(\\\"attavo drive: --again inside the budget is a no-op; the pass retries \\\"\\n                      \\\"on its own\\\")\\n                return 0, r\\n            return _advance_again(root, m, item_id, state.target_stage, r[\\\"head\\\"], again_by=again), r\\n        if state.eligible:\\n            return _advance_again(root, m, item_id, state.target_stage, r[\\\"head\\\"]), r\\n\\n    print(f\\\"attavo drive: {r['says']}\\\")\\n    return (1 if r[\\\"state\\\"] == \\\"refused\\\" else 0), r\\n\\n\\n_TERMINAL_STATES = (\\\"waiting-on-approval\\\", \\\"stopped\\\", \\\"ready-to-merge\\\", \\\"merged\\\")\\n\\n\\ndef _until_ready(root: Path, m: dict[str, Any], item_id: str, again: str | None) -> int:\\n    \\\"\\\"\\\"--until-ready: the pass, repeated in one process, sleeping\\n    ATTAVO_DRIVE_POLL_INTERVAL_S between passes, until the level is the\\n    operator's or done (exit 0), a concluded check is red (exit 1), or\\n    an unconcluded one has not concluded within ATTAVO_DRIVE_POLL_BOUND_S\\n    (exit 1). A stage running in its own worker is not bounded by this --\\n    only time spent waiting on the forge is.\\\"\\\"\\\"\\n    from attavo.verify import drive_forge_poll_bound_s, drive_forge_poll_interval_s\\n    bound = drive_forge_poll_bound_s()\\n    interval = drive_forge_poll_interval_s()\\n    waiting_since: float | None = None\\n    while True:\\n        rc, r = _pass_once(root, m, item_id, again)\\n        state = r[\\\"state\\\"]\\n\\n        if state == \\\"waiting-on-checks\\\":\\n            if waiting_since is None:\\n                waiting_since = time.monotonic()\\n            elif time.monotonic() - waiting_since >= bound:\\n                print(f\\\"attavo drive: stopped: the checks did not conclude within {bound:.0f}s\\\")\\n                return 1\\n        else:\\n            waiting_since = None\\n\\n        if rc != 0:\\n            return rc\\n        # R3: \\\"stopped\\\" is terminal only when the pass actually left it\\n        # alone -- kind \\\"acts\\\" or \\\"waits\\\" means this same pass just\\n        # retried it (or is only waiting out retry_after_s), and the loop\\n        # must keep going rather than call that done.\\n        if state in _TERMINAL_STATES and not (state == \\\"stopped\\\" and r[\\\"kind\\\"] != \\\"yours\\\"):\\n            return 0\\n        # R3: blocked-on-checks on a review is no longer a dead end -- the\\n        # pass just converted it into a returned record and, inside its\\n        # budget, a build retry follows on its own. Only the post-verify\\n        # case (the checks went red after a passing review, stage None)\\n        # is still the level with nothing left to do but give up.\\n        if state == \\\"blocked-on-checks\\\" and r[\\\"stage\\\"] is None:\\n            return 1\\n        time.sleep(interval)\\n\\n\\ndef _drive_all() -> int:\\n    \\\"\\\"\\\"--all, from the tenant's checkout: one pass, in its own process\\n    (`attavo drive N`, which ensures the working copy), for every origin\\n    attavo/<N>-* branch whose item is not merged, and one for every\\n    existing ../attavo-worktree-N whose item is merged, to remove it.\\n    Every line either prints is prefixed with the working copy's own\\n    directory name, so an operator reading them together can tell which\\n    item each line is about.\\\"\\\"\\\"\\n    root = Path(\\\".\\\").resolve()\\n    if workcopy.on_item_branch(root):\\n        print(\\\"attavo drive: --all runs from the tenant's checkout, not from an item's working copy\\\",\\n              file=sys.stderr)\\n        return 2\\n    m = read_manifest(root)\\n    if m is None:\\n        print(f\\\"attavo drive: no {MANIFEST} at {root}\\\", file=sys.stderr)\\n        return 2\\n    try:\\n        on_origin = workcopy.fetch_origin_items(root)\\n    except RuntimeError as exc:\\n        print(f\\\"attavo drive: stopped: could not read origin's attavo/* branches: {exc}\\\")\\n        return 1\\n    have = workcopy.existing_copy_items(root)\\n    items = sorted(set(on_origin) | set(have), key=int)\\n    if not items:\\n        print(\\\"attavo drive: --all found no attavo/<N>-* branch on origin and no ../attavo-worktree-N\\\")\\n        return 0\\n    merged = workcopy.merged_items(root, m[\\\"paths\\\"][\\\"records\\\"], items)\\n    worst = 0\\n    for n in items:\\n        if n in merged and n not in have:\\n            continue\\n        run = subprocess.run([sys.executable, str(PRODUCT_ROOT / \\\"bin\\\" / \\\"attavo\\\"), \\\"drive\\\", n],\\n                             cwd=str(root), capture_output=True, text=True, check=False)\\n        for line in (run.stdout + run.stderr).splitlines():\\n            print(f\\\"attavo-worktree-{n}: {line}\\\")\\n        worst = max(worst, run.returncode)\\n    return worst\\n\\n\\ndef cmd_drive(argv: list[str]) -> int:\\n    # Issue #145: Python block-buffers stdout when it is not a tty (a\\n    # pipe, e.g. a screen reading this process live), so every line this\\n    # prints would otherwise sit unflushed until the process exits.\\n    # Line-buffering makes a pipe reader see each line the moment it is\\n    # printed, the same as a terminal already does; `attavo worker`\\n    # reconfigures its own stdout the same way.\\n    cast(io.TextIOWrapper, sys.stdout).reconfigure(line_buffering=True)\\n\\n    if \\\"--recover\\\" in argv:\\n        print(\\\"attavo drive: --recover is gone; a pass recovers a dead or hung invocation \\\"\\n              \\\"itself, as soon as the report owes one\\\", file=sys.stderr)\\n        return 2\\n\\n    until_ready = \\\"--until-ready\\\" in argv\\n    report = \\\"--report\\\" in argv\\n    again_flag = \\\"--again\\\" in argv\\n    all_flag = \\\"--all\\\" in argv\\n    by: str | None = None\\n    positional: list[str] = []\\n    i = 0\\n    while i < len(argv):\\n        if argv[i] == \\\"--by\\\":\\n            by = argv[i + 1] if i + 1 < len(argv) else None\\n            i += 2\\n        else:\\n            if not argv[i].startswith(\\\"--\\\"):\\n                positional.append(argv[i])\\n            i += 1\\n    if again_flag and not by:\\n        print(\\\"attavo drive: --again requires --by LOGIN\\\", file=sys.stderr)\\n        return 2\\n    if \\\"--by\\\" in argv and not again_flag:\\n        print(\\\"attavo drive: --by is only for --again\\\", file=sys.stderr)\\n        return 2\\n    again = by if again_flag else None\\n\\n    if all_flag:\\n        if until_ready or report or again_flag or positional:\\n            print(\\\"attavo drive: --all runs one pass in every worktree beside this checkout; \\\"\\n                  \\\"drop N and every other flag\\\", file=sys.stderr)\\n            return 2\\n        return _drive_all()\\n\\n    root = Path(\\\".\\\").resolve()\\n    item_id = positional[0] if positional else derive_item_id(root)\\n    if not item_id:\\n        print(\\\"attavo drive: cannot derive item id; pass N or run on an attavo/N-* branch\\\",\\n              file=sys.stderr)\\n        return 2\\n    m = read_manifest(root)\\n    if m is None:\\n        print(f\\\"attavo drive: no {MANIFEST} at {root}\\\", file=sys.stderr)\\n        return 2\\n\\n    if report:\\n        if until_ready or again_flag:\\n            print(\\\"attavo drive: --report reads and does nothing else; drop --until-ready \\\"\\n                  \\\"and --again\\\", file=sys.stderr)\\n            return 2\\n        if not workcopy.on_item_branch(root):\\n            copy = workcopy.copy_path(root, item_id)\\n            if copy.resolve() in workcopy.registered_copies(root) and copy.is_dir():\\n                root = copy\\n            else:\\n                with workcopy.read_only_copy(root, item_id) as (tree, why):\\n                    if tree is None:\\n                        print(f\\\"attavo drive: stopped: {why}\\\")\\n                        return 1\\n                    from attavo.report import drive_report\\n                    print(json.dumps(drive_report(tree, m, item_id), indent=2))\\n                    return 0\\n        os.chdir(root)\\n        refusal = fast_forward_to_origin(root, m, item_id)\\n        if refusal:\\n            print(f\\\"attavo drive: note: {refusal}\\\", file=sys.stderr)\\n        from attavo.report import drive_report\\n        print(json.dumps(drive_report(root, m, item_id), indent=2))\\n        return 0\\n\\n    if not workcopy.on_item_branch(root):\\n        ensured = workcopy.ensure(root, item_id, m[\\\"paths\\\"][\\\"records\\\"])\\n        if ensured.path is None:\\n            if ensured.refusal is None:\\n                print(f\\\"attavo drive: merged: item {item_id} is merged on origin and has no working copy\\\")\\n                return 0\\n            print(f\\\"attavo drive: stopped: {ensured.refusal}\\\")\\n            return 1\\n        root = ensured.path\\n        os.chdir(root)\\n        m = read_manifest(root) or m\\n\\n    if until_ready:\\n        rc = _until_ready(root, m, item_id, again)\\n        r = None\\n    else:\\n        rc, r = _pass_once(root, m, item_id, again)\\n    if r is None or r[\\\"state\\\"] == \\\"merged\\\":\\n        from attavo.report import drive_report\\n        if (r or drive_report(root, m, item_id))[\\\"state\\\"] == \\\"merged\\\":\\n            done = workcopy.remove_when_merged(root, item_id, m[\\\"paths\\\"][\\\"records\\\"])\\n            if done:\\n                print(f\\\"attavo drive: {done}\\\")\\n    return rc\\n\",\"numLines\":1114,\"startLine\":1,\"totalLines\":1114}}}\n{\"type\":\"system\",\"subtype\":\"thinking_tokens\",\"estimated_tokens\":50,\"estimated_tokens_delta\":50,\"session_id\":\"b3f717aa-5c2b-4867-b022-0f24cffb6427\",\"uuid\":\"c9ebda6d-5552-46a3-90a6-56539ecb69c7\"}\n{\"type\":\"system\",\"subtype\":\"thinking_tokens\",\"estimated_tokens\":137,\"estimated_tokens_delta
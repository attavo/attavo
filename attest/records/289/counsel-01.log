st/schema/records/verify.schema.json:110:                   \"ceiling\", \"claims-boundary\", \"repeated-act\", \"unclassed\", \"question\",\n/Users/davidbean/Projects/attest/schema/records/counsel.schema.json:60:               \"ceiling\", \"claims-boundary\", \"repeated-act\", \"unclassed\", null],\n/Users/davidbean/Projects/attest/adapters/claude-code/run:468:# Edit and Write are allowed on the claimed paths only, as permission\n/Users/davidbean/Projects/attest/adapters/claude-code/run:475:def claimed_paths() -> list[str]:\n/Users/davidbean/Projects/attest/adapters/claude-code/run:486:    claims: list[str] = []\n/Users/davidbean/Projects/attest/adapters/claude-code/run:493:            claims.append(line.strip()[2:].strip())\n/Users/davidbean/Projects/attest/adapters/claude-code/run:494:    return claims\n/Users/davidbean/Projects/attest/adapters/claude-code/run:497:def claim_rule(claim: str) -> str:\n/Users/davidbean/Projects/attest/adapters/claude-code/run:498:    \"\"\"A claim as a permission-rule path: a directory claim (trailing\n/Users/davidbean/Projects/attest/adapters/claude-code/run:500:    return claim + \"**\" if claim.endswith(\"/\") else claim\n/Users/davidbean/Projects/attest/adapters/claude-code/run:504:    claims = claimed_paths()\n/Users/davidbean/Projects/attest/adapters/claude-code/run:505:    if not claims:\n/Users/davidbean/Projects/attest/adapters/claude-code/run:507:    rules = [f\"{tool}({claim_rule(c)})\" for c in claims for tool in (\"Edit\", \"Write\")]\n/Users/davidbean/Projects/attest/adapters/claude-code/run:629:    # with claimed-path rules in force the mode is default, so a claimed\n/Users/davidbean/Projects/attest/adapters/claude-code/run:630:    # edit is approved by its rule and an unclaimed one asks -- and a\n/Users/davidbean/Projects/attest/adapters/claude-code/run:632:    claimed_rules = stage not in READ_ONLY_STAGES and allowed_tools is not BUILD_ALLOWED_TOOLS\n/Users/davidbean/Projects/attest/adapters/claude-code/run:633:    permission_mode = config.get(\"permission_mode\", \"default\" if claimed_rules else \"acceptEdits\")\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:11:+    this host can read it: the directory its marker names, when the\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:12:+    marker is from this host and names one; this checkout's own, for a\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:13:+    marker from this host written before markers named it; None for a\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:14:+    marker from another host, whose heartbeat no file here holds.\"\"\"\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:30: def write_invocation_marker(root: Path, records_dir: Path, stage: str, nn: int,\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:34:     host, the sha it starts on, and the product that started it. No pid:\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:36:@@ -212,7 +227,12 @@ def write_invocation_marker(root: Path, records_dir: Path, stage: str, nn: int,\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:37:     marker; a marker with no record is an invocation that died or hangs,\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:40:-    matched) -- absent on every ordinary marker, never a bare false.\"\"\"\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:41:+    matched) -- absent on every ordinary marker, never a bare false.\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:43:+    (the checkout's own <git-dir>/attavo, events_dir when the marker is\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:50:@@ -220,7 +240,8 @@ def write_invocation_marker(root: Path, records_dir: Path, stage: str, nn: int,\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:61:             name = f\"item {item_dir.name} {marker.stem}\"\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:62:             stage, nn_text = marker.stem.rsplit(\"-\", 1)\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:77:-                # No heartbeat file readable from here for a marker from\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:82:+                # No heartbeat readable for a marker from another host, or\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:83:+                # none yet where a marker from this host says its holder\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:103:@@ -385,11 +386,15 @@ def read_invocation(root: Path, bound: int | None, marker: Path, info: dict[str,\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:104:     declared and the last event (the marker's own `at` when there is\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:108:-    file a marker from this host is died -- the holder never touched its\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:113:+    read where the marker says its holder writes it (holder_heartbeat_path),\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:115:+    keep their own. With no heartbeat file there, a marker from this host\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:122:     R3: the stage's own ceiling (wall clock from the marker's own `at`)\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:124:@@ -409,7 +414,8 @@ def read_invocation(root: Path, bound: int | None, marker: Path, info: dict[str,\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:134:@@ -417,7 +423,11 @@ def read_invocation(root: Path, bound: int | None, marker: Path, info: dict[str,\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:141:+        # yet where the marker says its holder beats -- another\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:144:         marker_age = invocation_age_s(info)\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:145:         if stall_bound is not None and marker_age is not None and marker_age < stall_bound:\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:146:             return InvocationReading(stage, nn, log, last_at, marker_age, \"running\")\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:149:     def write_marker(tree: Path) -> list[Path]:\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:150:         return [write_invocation_marker(tree, tree / records_dir.relative_to(root), stage, nn,\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:155:         root, branch, f\"attavo: {stage} invocation {nn:02d} started for item {item_id}\",\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:164:             print(f\"attavo drive: no holder to signal for {marker.stem}: its heartbeat names no pid\")\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:196:+      \"name\": \"a-second-checkout-reads-the-holders-heartbeat-where-its-marker-says.sh\",\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:201:+  \"refusal\": \"criterion fails against the tree plus stub: a-second-checkout-reads-the-holders-heartbeat-where-its-marker-says.sh\",\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:223:+      \"name\": \"a-second-checkout-reads-the-holders-heartbeat-where-its-marker-says.sh\",\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:236:diff --git a/attest/specs/289/criteria/a-second-checkout-reads-the-holders-heartbeat-where-its-marker-says.sh b/attest/specs/289/criteria/a-second-checkout-reads-the-holders-heartbeat-where-its-marker-says.sh\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:240:+++ b/attest/specs/289/criteria/a-second-checkout-reads-the-holders-heartbeat-where-its-marker-says.sh\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:258:+from attavo.doctor import write_invocation_marker\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:262:+marker = write_invocation_marker(root, records, \"build\", 1)\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:263:+info = json.loads(marker.read_text())\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:270:+assert read_invocation(root, 600, marker, info).cls == \"running\", \"a fresh heartbeat where the marker says\"\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:272:+assert read_invocation(root, 600, marker, info).cls == \"running\", \"no first beat yet, younger than the bound\"\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:274:+assert read_invocation(root, 600, marker, old).cls == \"died\", \"no heartbeat, older than the bound\"\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:276:+assert read_invocation(root, 600, marker, legacy).cls == \"died\", \"a marker naming no directory reads as before\"\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:279:+for t in test_a_second_checkout_on_this_host_reads_the_first_ones_worker_as_running test_the_holders_heartbeat_is_read_where_its_marker_says test_the_marker_a_pass_writes_names_its_checkouts_heartbeat_directory\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:295:+`test_two_passes_at_once_start_one_worker_and_the_loser_says_so` fails intermittently. It failed in full runs on `d4c0bc1` and `5df6926`, and it knocked #273 out of the merge queue once. When it fails, both passes print \"Build started\". It was filed as #289, \"the pass lock admits two workers under load\", and it is not a lock problem.\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:297:+The lease is sound. Only one marker push can land. The defect is in how the losing pass reads the winner's live invocation, and the specimen is the test itself. Two clones of one tenant sit on one host. Pass A pushes `build-01.started` and starts its worker. Its worker writes its heartbeat under A's git dir: `stage_events_dir` is `<git-dir>/attavo`, per checkout, and per linked worktree too. Pass B then fetches and fast-forwards, sees A's marker with no record, and asks `read_invocation` whether it is running. The marker's `host` is B's own host, and B looks for the heartbeat in its own git dir, finds none, and reads \"died\". So it recovers, or starts a second attempt.\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:303:+This item makes the marker say where its holder beats, and every reader read there.\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:305:+- `write_invocation_marker` adds `events`, the absolute directory the holder's heartbeat will be written in. The pass writes the marker from a detached worktree, so `_start_stage` passes the checkout's own `stage_events_dir(root)`, never the worktree's.\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:307:+  - a marker from this host that names a directory is read in that directory;\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:308:+  - a marker from this host written before markers named one keeps this checkout's own directory;\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:309:+  - a marker from another host returns None, since no file here holds its heartbeat.\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:311:+- When a marker from this host names a directory that holds no heartbeat yet, the invocation is treated like one from another host: running while the marker is younger than the stall bound, died after. That covers another checkout's worker that has not reached its first beat. A stale heartbeat is still died, and the stall bound still decides hung, never died.\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:312:+- A marker without `events` keeps the old reading exactly, so the markers already in the records read as they did.\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:316:+- the race made deterministic: a second clone's pass after the first has started reads running, starts nothing, and no second invocation is pushed;\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:317:+- the heartbeat read where the marker says: fresh there, absent while young, absent when old, and a legacy marker;\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:318:+- the marker a pass writes names its checkout's directory.\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:332:+- a-second-checkout-reads-the-holders-heartbeat-where-its-marker-says.sh: on the fixture tenant, with no test runner, `write_invocation_marker` writes `events` as the checkout's own `<git-dir>/attavo`; `read_invocation` reads a marker from this host naming another directory as running with a fresh heartbeat there, running with none yet while younger than the stall bound, and died when older; a marker naming no directory reads died as before; and `tests/test_pass.py` carries the three tests named\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:505:+INVOCATION_MARKER_SUFFIX = \".started\"\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:508:+def invocation_marker_path(records_dir: Path, stage: str, nn: int) -> Path:\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:522:+    this host can read it: the directory its marker names, when the\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:523:+    marker is from this host and names one; this checkout's own, for a\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:524:+    marker from this host written before markers named it; None for a\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:525:+    marker from another host, whose heartbeat no file here holds.\"\"\"\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:558:+def write_invocation_marker(root: Path, records_dir: Path, stage: str, nn: int,\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:561:+    host, the sha it starts on, and the product that started it. No pid:\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:565:+    marker; a marker with no record is an invocation that died or hangs,\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:568:+    matched) -- absent on every ordinary marker, never a bare false.\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:570:+    (the checkout's own <git-dir>/attavo, events_dir when the marker is\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:577:+    path = invocation_marker_path(records_dir, stage, nn)\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:590:+    \"\"\"Seconds since the marker's own `at` timestamp -- how long ago the\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:605:+    \"\"\"Every <stage>-NN.started under one item whose <stage>-NN.json has\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:606:+    not arrived, with the marker's own dict ({} when unreadable).\"\"\"\n/var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp5bs3eqqo/diff.patch:610:+    for marker in sorted(item_records_dir.glob(f\"*{INVOCATION_MARKER_SUFFIX}\")):\n/var/folders/k6/kwlls81j5gvf1
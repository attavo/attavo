doctor.py attavo/drive.py tests/test_pass.py && git commit -m \\\"$(cat <<'EOF'\\nattavo: mark where each holder's heartbeat lives, and read it there (#289)\\n\\nThe pass lock is sound, but read_invocation, proof five, and the\\nhung-holder signal all assumed the host name alone locates a heartbeat.\\nTwo checkouts of one tenant on one host is now ordinary, and each keeps\\nits heartbeat under its own git dir -- a second checkout's pass read the\\nfirst's live worker as died and started a redundant build.\\n\\nwrite_invocation_marker now records events, the checkout's own heartbeat\\ndirectory; holder_heartbeat_path is the one place that resolves where a\\nmarker's holder writes, and every reader goes through it.\\n\\nCo-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>\\nEOF\\n)\\\"\\ngit status\"}},\"wire_ingest_context\":{\"toolu_018QE24oTmXitK4G4Hc2pM7D\":{\"cwd\":\"/Users/davidbean/Projects/attavo-worktree-289\"}}}\n5:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01ARtS9ApYEAzmBQWRrXzTuV\",\"type\":\"tool_result\",\"content\":\"a5bba75 attavo: build invocation 01 started for item 289\\n480ebfd attavo: approval record for item 289\\n90ffdfc attavo: spec-gate record for item 289\\n220163d amend spec for #289: the criterion runs without a test runner\\n680503a attavo: spec-gate record for item 289\\n---\\nOn branch attavo/289-holder-heartbeat\\nYour branch is up to date with 'origin/attavo/289-holder-heartbeat'.\\n\\nnothing to commit, working tree clean\",\"is_error\":false}]},\"parent_tool_use_id\":null,\"session_id\":\"b3f717aa-5c2b-4867-b022-0f24cffb6427\",\"uuid\":\"fa120ddb-844e-48f5-8fd6-2a6300f19e05\",\"timestamp\":\"2026-09-30T23:05:31.836Z\",\"tool_use_result\":{\"stdout\":\"a5bba75 attavo: build invocation 01 started for item 289\\n480ebfd attavo: approval record for item 289\\n90ffdfc attavo: spec-gate record for item 289\\n220163d amend spec for #289: the criterion runs without a test runner\\n680503a attavo: spec-gate record for item 289\\n---\\nOn branch attavo/289-holder-heartbeat\\nYour branch is up to date with 'origin/attavo/289-holder-heartbeat'.\\n\\nnothing to commit, working tree clean\",\"stderr\":\"\",\"interrupted\":false,\"isImage\":false,\"noOutputExpected\":false}}\n34:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01R4YkaAh32ZqMisAqNSFAQm\",\"type\":\"tool_result\",\"content\":\"1\\t\\\"\\\"\\\"The reconciler's R2 (claude/reconciler-brief-2026-09-20.md, rulings A, B,\\n2\\tH): `attavo drive N` is one short pass that reads the report, acts at most\\n3\\tonce, and returns; a stage runs in a detached worker with its own\\n4\\theartbeat; the marker's push is the lease; recovery is the pass's; the\\n5\\treview takes the checks the pass read on the pre-marker head.\\n6\\t\\n7\\tRun: python3 -m pytest tests -q\\n8\\t\\\"\\\"\\\"\\n9\\tfrom __future__ import annotations\\n10\\t\\n11\\timport json\\n12\\timport os\\n13\\timport socket\\n14\\timport subprocess\\n15\\timport sys\\n16\\timport time\\n17\\tfrom pathlib import Path\\n18\\tfrom typing import Any\\n19\\t\\n20\\tfrom helpers import commit_all, git, make_tenant\\n21\\tfrom test_drive import (\\n22\\t    GREEN_FORGE,\\n23\\t    add_bare_remote,\\n24\\t    add_drive_stall_bound,\\n25\\t    add_forge,\\n26\\t    approve_item,\\n27\\t    head_of,\\n28\\t    publish_approval,\\n29\\t    latest_record,\\n30\\t    record_files,\\n31\\t    records_dir,\\n32\\t    remote_head,\\n33\\t    run_attavo,\\n34\\t    write_dead_marker,\\n35\\t)\\n36\\t\\n37\\tROOT = Path(__file__).resolve().parent.parent\\n38\\tFAST = {\\\"ATTAVO_HEARTBEAT_S\\\": \\\"0.2\\\", \\\"ATTAVO_DRIVE_POLL_INTERVAL_S\\\": \\\"0.5\\\"}\\n39\\t\\n40\\t\\n41\\tdef slow_adapter(root: Path, seconds: float) -> None:\\n42\\t    \\\"\\\"\\\"A tenant-side build adapter: the product's own fixture adapter,\\n43\\t    after `seconds` of sleep on the build stage.\\\"\\\"\\\"\\n44\\t    d = root / \\\"attavo\\\" / \\\"adapters\\\" / \\\"fixture\\\"\\n45\\t    d.mkdir(parents=True, exist_ok=True)\\n46\\t    run = d / \\\"run\\\"\\n47\\t    run.write_text(f'#!/bin/sh\\\\nif [ \\\"${{ATTAVO_STAGE:-build}}\\\" = build ]; then sleep {seconds}; fi\\\\n'\\n48\\t                   f'exec sh {ROOT / \\\"adapters\\\" / \\\"fixture\\\" / \\\"run\\\"}\\\\n')\\n49\\t    run.chmod(0o755)\\n50\\t    commit_all(root, \\\"a slow tenant-side adapter\\\")\\n51\\t\\n52\\t\\n53\\tdef git_dir(root: Path) -> Path:\\n54\\t    return Path(git(root, \\\"rev-parse\\\", \\\"--absolute-git-dir\\\").strip())\\n55\\t\\n56\\t\\n57\\tdef report(root: Path, env: dict[str, str] | None = None) -> dict[str, Any]:\\n58\\t    run = run_attavo(root, \\\"drive\\\", \\\"1\\\", \\\"--report\\\", env={**FAST, **(env or {})})\\n59\\t    assert run.returncode == 0, run.stdout + run.stderr\\n60\\t    out: dict[str, Any] = json.loads(run.stdout)\\n61\\t    return out\\n62\\t\\n63\\t\\n64\\tdef pushed(bare: Path, subject: str) -> bool:\\n65\\t    log = subprocess.run([\\\"git\\\", \\\"-C\\\", str(bare), \\\"log\\\", \\\"--format=%s\\\", \\\"attavo/1-x\\\"], capture_output=True, text=True).stdout\\n66\\t    return subject in log\\n67\\t\\n68\\t\\n69\\tdef wait_for(pred: Any, seconds: float = 20) -> None:\\n70\\t    deadline = time.monotonic() + seconds\\n71\\t    while time.monotonic() < deadline:\\n72\\t        if pred():\\n73\\t            return\\n74\\t        time.sleep(0.2)\\n75\\t    raise AssertionError(\\\"condition not met in time\\\")\\n76\\t\\n77\\t\\n78\\tdef passes_until(root: Path, pred: Any, seconds: float = 40, env: dict[str, str] | None = None) -> None:\\n79\\t    \\\"\\\"\\\"Passes, spaced, until pred holds: how an operator's loop, the\\n80\\t    screen's poll, or a scheduler line would drive the item.\\\"\\\"\\\"\\n81\\t    deadline = time.monotonic() + seconds\\n82\\t    full = dict(FAST)\\n83\\t    full.update(env or {})\\n84\\t    while time.monotonic() < deadline:\\n85\\t        run_attavo(root, \\\"drive\\\", \\\"1\\\", env=full)\\n86\\t        if pred():\\n87\\t            return\\n88\\t        time.sleep(0.5)\\n89\\t    raise AssertionError(\\\"condition not met in time\\\")\\n90\\t\\n91\\t\\n92\\tdef clock_ahead(tmp_path: Path, seconds: float) -> dict[str, str]:\\n93\\t    \\\"\\\"\\\"The environment that puts every bound the product judges `seconds`\\n94\\t    past the machine's now (#257): a clock file, named by ATTAVO_CLOCK_FILE,\\n95\\t    that the next pass reads instead of waiting.\\\"\\\"\\\"\\n96\\t    path = tmp_path / \\\"attavo-clock\\\"\\n97\\t    path.write_text(str(time.time() + seconds))\\n98\\t    return {\\\"ATTAVO_CLOCK_FILE\\\": str(path)}\\n99\\t\\n100\\t\\n101\\tdef built_tenant(tmp_path: Path, seconds: float = 3) -> tuple[Path, Path]:\\n102\\t    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n103\\t    add_forge(root, GREEN_FORGE)\\n104\\t    add_drive_stall_bound(root)\\n105\\t    slow_adapter(root, seconds)\\n106\\t    bare = add_bare_remote(root, tmp_path)\\n107\\t    approve_item(root)\\n108\\t    return root, bare\\n109\\t\\n110\\t\\n111\\tdef test_a_pass_returns_while_the_worker_runs_and_the_worker_outlives_it(tmp_path: Path) -> None:\\n112\\t    root, bare = built_tenant(tmp_path, seconds=3)\\n113\\t    started = time.monotonic()\\n114\\t    run = run_attavo(root, \\\"drive\\\", \\\"1\\\", env=FAST)\\n115\\t    elapsed = time.monotonic() - started\\n116\\t    assert run.returncode == 0, run.stdout + run.stderr\\n117\\t    assert elapsed < 2.5, f\\\"the pass took {elapsed:.1f}s: it waited for the stage\\\"\\n118\\t    assert \\\"Build started\\\" in run.stdout, run.stdout\\n119\\t    assert (records_dir(root) / \\\"build-01.started\\\").exists()\\n120\\t    assert remote_head(bare) == head_of(root), \\\"the marker was not pushed before the pass returned\\\"\\n121\\t    assert record_files(root, \\\"build\\\") == [], \\\"the record existed before the worker could have written it\\\"\\n122\\t    wait_for(lambda: record_files(root, \\\"build\\\") != [])\\n123\\t    wait_for(lambda: remote_head(bare) == head_of(root))\\n124\\t    assert latest_record(root, \\\"build\\\")[\\\"status\\\"] == \\\"pass\\\"\\n125\\t\\n126\\t\\n127\\tdef test_the_worker_touches_its_heartbeat_and_the_report_reads_running_by_it(tmp_path: Path) -> None:\\n128\\t    root, _ = built_tenant(tmp_path, seconds=3)\\n129\\t    assert run_attavo(root, \\\"drive\\\", \\\"1\\\", env=FAST).returncode == 0\\n130\\t    beat = git_dir(root) / \\\"attavo\\\" / \\\"build-01.heartbeat\\\"\\n131\\t    wait_for(beat.exists, 5)\\n132\\t    first = beat.stat().st_mtime\\n133\\t    time.sleep(0.6)\\n134\\t    assert beat.stat().st_mtime > first, \\\"the heartbeat did not move\\\"\\n135\\t    r = report(root)\\n136\\t    assert (r[\\\"state\\\"], r[\\\"kind\\\"]) == (\\\"running\\\", \\\"waits\\\"), r\\n137\\t    wait_for(lambda: record_files(root, \\\"build\\\") != [])\\n138\\t\\n139\\t\\n140\\tdef test_a_stale_heartbeat_reads_died_though_the_pid_lives_and_a_fresh_one_reads_alive(tmp_path: Path) -> None:\\n141\\t    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n142\\t    git(root, \\\"checkout\\\", \\\"-q\\\", \\\"-b\\\", \\\"attavo/1-x\\\")\\n143\\t    add_forge(root, GREEN_FORGE)\\n144\\t    add_drive_stall_bound(root, 600)\\n145\\t    approve_item(root)\\n146\\t    d = records_dir(root)\\n147\\t    d.mkdir(parents=True, exist_ok=True)\\n148\\t    marker = d / \\\"build-01.started\\\"\\n149\\t    now = time.strftime(\\\"%Y-%m-%dT%H:%M:%SZ\\\", time.gmtime())\\n150\\t    marker.write_text(json.dumps({\\\"at\\\": now, \\\"host\\\": socket.gethostname(),\\n151\\t                                  \\\"pid\\\": os.getpid(), \\\"sha\\\": head_of(root), \\\"product_version\\\": \\\"fixture\\\"}))\\n152\\t    commit_all(root, \\\"a marker whose pid is this test\\\")\\n153\\t    beat = git_dir(root) / \\\"attavo\\\" / \\\"build-01.heartbeat\\\"\\n154\\t    beat.parent.mkdir(parents=True, exist_ok=True)\\n155\\t    beat.touch()\\n156\\t    os.utime(beat, (time.time() - 60, time.time() - 60))\\n157\\t    r = report(root)\\n158\\t    assert (r[\\\"state\\\"], r[\\\"stop_class\\\"]) == (\\\"owes-recovery\\\", \\\"died\\\"), r\\n159\\t    beat.touch()\\n160\\t    r = report(root)\\n161\\t    assert r[\\\"state\\\"] == \\\"running\\\", r\\n162\\t\\n163\\t\\n164\\tdef test_two_passes_at_once_start_one_worker_and_the_loser_says_so(tmp_path: Path) -> None:\\n165\\t    root, bare = built_tenant(tmp_path, seconds=3)\\n166\\t    publish_approval(root)\\n167\\t    clone = tmp_path / \\\"second\\\"\\n168\\t    git(root.parent, \\\"clone\\\", \\\"-q\\\", \\\"-b\\\", git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip(), str(bare), str(clone))\\n169\\t    git(clone, \\\"config\\\", \\\"user.email\\\", \\\"test@example.com\\\")\\n170\\t    git(clone, \\\"config\\\", \\\"user.name\\\", \\\"Attavo Test\\\")\\n171\\t    git(clone, \\\"remote\\\", \\\"set-head\\\", \\\"origin\\\", \\\"-a\\\")\\n172\\t    env = dict(os.environ)\\n173\\t    env.update(FAST)\\n174\\t    before = {c: (head_of(c), git(c, \\\"ls-files\\\", \\\"-s\\\"), git(c, \\\"status\\\", \\\"--porcelain\\\")) for c in (root, clone)}\\n175\\t    procs = [subprocess.Popen([sys.executable, str(ROOT / \\\"bin\\\" / \\\"attavo\\\"), \\\"drive\\\", \\\"1\\\"], cwd=str(c),\\n176\\t                              env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)\\n177\\t             for c in (root, clone)]\\n178\\t    outs = [p.communicate(timeout=30)[0] for p in procs]\\n179\\t    started = [o for o in outs if \\\"Build started\\\" in o]\\n180\\t    held = [o for o in outs if \\\"another pass holds\\\" in o]\\n181\\t    assert len(started) == 1 and len(held) == 1, outs\\n182\\t    loser = clone if \\\"another pass holds\\\" in outs[1] else root\\n183\\t    assert (head_of(loser), git(loser, \\\"ls-files\\\", \\\"-s\\\"), git(loser, \\\"status\\\", \\\"--porcelain\\\")) == before[loser], \\\\\\n184\\t        \\\"the loser's checkout (HEAD, index, working tree) moved\\\"\\n185\\t    assert \\\"reset\\\" not in git(loser, \\\"reflog\\\", \\\"show\\\", \\\"HEAD\\\"), git(loser, \\\"reflog\\\", \\\"show\\\", \\\"HEAD\\\")\\n186\\t    log = subprocess.run([\\\"git\\\", \\\"-C\\\", str(bare), \\\"log\\\", \\\"--format=%s\\\", \\\"attavo/1-x\\\"], capture_output=True, text=True).stdout\\n187\\t    assert log.count(\\\"build invocation 01 started\\\") == 1, log\\n188\\t    wait_for(lambda: \\\"build record for item 1\\\" in subprocess.run(\\n189\\t        [\\\"git\\\", \\\"-C\\\", str(bare), \\\"log\\\", \\\"--format=%s\\\", \\\"attavo/1-x\\\"], capture_output=True, text=True).stdout)\\n190\\t\\n191\\t\\n192\\tdef test_a_pass_recovers_a_dead_invocation_and_recover_is_gone(tmp_path: Path) -> None:\\n193\\t    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n194\\t    git(root, \\\"checkout\\\", \\\"-q\\\", \\\"-b\\\", \\\"attavo/1-x\\\")\\n195\\t    add_forge(root, GREEN_FORGE)\\n196\\t    add_drive_stall_bound(root)\\n197\\t    approve_item(root)\\n198\\t    write_dead_marker(root, \\\"build\\\", 1)\\n199\\t    gone = run_attavo(root, \\\"drive\\\", \\\"--recover\\\", \\\"1\\\", env=FAST)\\n200\\t    assert gone.returncode == 2 and \\\"gone\\\" in gone.stderr, gone.stdout + gone.stderr\\n201\\t    run = run_attavo(root, \\\"drive\\\", \\\"1\\\", env=FAST)\\n202\\t    assert run.returncode == 0, run.stdout + run.stderr\\n203\\t    rec = latest_record(root, \\\"build\\\")\\n204\\t    assert rec[\\\"stop\\\"][\\\"class\\\"] == \\\"died\\\", rec[\\\"stop\\\"]\\n205\\t\\n206\\t\\n207\\tdef test_the_review_takes_the_checks_the_pass_read_and_never_polls(tmp_path: Path) -> None:\\n208\\t    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n209\\t    calls = tmp_path / \\\"forge-calls.txt\\\"\\n210\\t    forge = tmp_path / \\\"forge.sh\\\"\\n211\\t    forge.write_text(f'#!/bin/sh\\\\necho \\\"$1\\\" >> {calls}\\\\nprintf \\\"ci success\\\\\\\\n\\\"\\\\n')\\n212\\t    forge.chmod(0o755)\\n213\\t    add_forge(root, f\\\"sh {forge}\\\")\\n214\\t    add_drive_stall_bound(root)\\n215\\t    slow_adapter(root, 0)\\n216\\t    bare = add_bare_remote(root, tmp_path)\\n217\\t    approve_item(root)\\n218\\t    assert run_attavo(root, \\\"drive\\\", \\\"1\\\", env=FAST).returncode == 0\\n219\\t    wait_for(lambda: pushed(bare, \\\"build record for item 1\\\"))\\n220\\t    wait_for(lambda: remote_head(bare) == head_of(root))\\n221\\t    calls.write_text(\\\"\\\")\\n222\\t    pre_marker = head_of(root)\\n223\\t    run = run_attavo(root, \\\"drive\\\", \\\"1\\\", env=FAST)\\n224\\t    assert \\\"Review started\\\" in run.stdout, run.stdout + run.stderr\\n225\\t    wait_for(lambda: record_files(root, \\\"verify\\\") != [])\\n226\\t    rec = latest_record(root, \\\"verify\\\")\\n227\\t    assert rec[\\\"status\\\"] == \\\"pass\\\", rec\\n228\\t    assert rec[\\\"forge_checks\\\"][\\\"sha\\\"] == pre_marker, (rec[\\\"forge_checks\\\"], pre_marker)\\n229\\t    read_by = [l for l in calls.read_text().split() if l]\\n230\\t    assert read_by == [pre_marker], f\\\"the forge was read {len(read_by)} time(s) after the build: {read_by}\\\"\\n231\\t\\n232\\t\\n233\\tdef test_until_ready_is_a_loop_of_passes_that_returns_at_ready(tmp_path: Path) -> None:\\n234\\t    root, _ = built_tenant(tmp_path, seconds=0)\\n235\\t    run = run_attavo(root, \\\"drive\\\", \\\"1\\\", \\\"--until-ready\\\", env=FAST)\\n236\\t    assert run.returncode == 0, run.stdout + run.stderr\\n237\\t    assert \\\"Build started\\\" in run.stdout and \\\"Review started\\\" in run.stdout, run.stdout\\n238\\t    assert run.stdout.strip().endswith(\\\"Ready to merge\\\"), run.stdout\\n239\\t    assert report(root)[\\\"state\\\"] == \\\"ready-to-merge\\\"\\n240\\t\\n241\\t\\n242\\tdef test_a_died_stage_retries_plainly_and_again_is_a_no_op_inside_the_budget(tmp_path: Path) -> None:\\n243\\t    \\\"\\\"\\\"R3: died is one of the four plain retryable families -- the very\\n244\\t    next pass retries it on its own, with no operator and no --again\\n245\\t    needed; `--again` inside the budget is a no-op that says so, rather\\n246\\t    than starting a second attempt of its own.\\\"\\\"\\\"\\n247\\t    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n248\\t    git(root, \\\"checkout\\\", \\\"-q\\\", \\\"-b\\\", \\\"attavo/1-x\\\")\\n249\\t    add_forge(root, GREEN_FORGE)\\n250\\t    add_drive_stall_bound(root)\\n251\\t    approve_item(root)\\n252\\t    write_dead_marker(root, \\\"build\\\", 1)\\n253\\t    assert run_attavo(root, \\\"drive\\\", \\\"1\\\", env=FAST).returncode == 0\\n254\\t    assert latest_record(root, \\\"build\\\")[\\\"stop\\\"][\\\"class\\\"] == \\\"died\\\"\\n255\\t    again = run_attavo(root, \\\"drive\\\", \\\"1\\\", \\\"--again\\\", \\\"--by\\\", \\\"alice\\\", env=FAST)\\n256\\t    assert again.returncode == 0 and \\\"retries on its own\\\" in again.stdout, again.stdout\\n257\\t    assert not (records_dir(root) / \\\"build-02.started\\\").exists()\\n258\\t    plain = run_attavo(root, \\\"drive\\\", \\\"1\\\", env=FAST)\\n259\\t    assert \\\"Build started\\\" in plain.stdout, plain.stdout + plain.stderr\\n260\\t    assert (records_dir(root) / \\\"build-02.started\\\").exists()\\n261\\t    wait_for(lambda: len(record_files(root, \\\"build\\\")) == 2)\\n262\\t    assert latest_record(root, \\\"build\\\")[\\\"retry_of\\\"] == \\\"build-01\\\"\\n263\\t\\n264\\t\\n265\\tdef test_all_from_the_checkout_passes_every_unmerged_branch_on_origin_and_removes_merged_copies(\\n266\\t        tmp_path: Path) -> None:\\n267\\t    from test_working_copy import add_merged_item, copy_of, tenant_on_main\\n268\\t    root, bare = tenant_on_main(tmp_path)\\n269\\t    add_merged_item(root, bare, \\\"2\\\")\\n270\\t    merged = copy_of(tmp_path, \\\"2\\\")\\n271\\t    git(root, \\\"worktree\\\", \\\"add\\\", \\\"-q\\\", str(merged), \\\"attavo/2-y\\\")\\n272\\t    run = run_attavo(root, \\\"drive\\\", \\\"--all\\\", env=FAST)\\n273\\t    assert run.returncode == 0, run.stdout + run.stderr\\n274\\t    assert \\\"attavo-worktree-1: attavo drive: Build started\\\" in run.stdout, run.stdout\\n275\\t    assert \\\"attavo-worktree-2: attavo drive: merged: removed attavo-worktree-2\\\" in run.stdout, run.stdout\\n276\\t    assert not merged.exists()\\n277\\t    wait_for(lambda: record_files(copy_of(tmp_path), \\\"build\\\") != [])\\n278\\t\\n279\\t\\n280\\tdef test_the_report_reads_running_for_the_whole_of_counsel_and_stopped_after_the_push(tmp_path: Path) -> None:\"}]},\"parent_tool_use_id\":null,\"session_id\":\"b3f717aa-5c2b-4867-b022-0f24cffb6427\",\"uuid\":\"722a274a-854b-4431-a65e-56ce55355c37\",\"timestamp\":\"2026-09-30T23:05:48.016Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/davidbean/Projects/attavo-worktree-289/tests/test_pass.py\",\"content\":\"\\\"\\\"\\\"The reconciler's R2 (claude/reconciler-brief-2026-09-20.md, rulings A, B,\\nH): `attavo drive N` is one short pass that reads the report, acts at most\\nonce, and returns; a stage runs in a detached worker with its own\\nheartbeat; the marker's push is the lease; recovery is the pass's; the\\nreview takes the checks the pass read on the pre-marker head.\\n\\nRun: python3 -m pytest tests -q\\n\\\"\\\"\\\"\\nfrom __future__ import annotations\\n\\nimport json\\nimport os\\nimport socket\\nimport subprocess\\nimport sys\\nimport time\\nfrom pathlib import Path\\nfrom typing import Any\\n\\nfrom helpers import commit_all, git, make_tenant\\nfrom test_drive import (\\n    GREEN_FORGE,\\n    add_bare_remote,\\n    add_drive_stall_bound,\\n    add_forge,\\n    approve_item,\\n    head_of,\\n    publish_approval,\\n    latest_record,\\n    record_files,\\n    records_dir,\\n    remote_head,\\n    run_attavo,\\n    write_dead_marker,\\n)\\n\\nROOT = Path(__file__).resolve().parent.parent\\nFAST = {\\\"ATTAVO_HEARTBEAT_S\\\": \\\"0.2\\\", \\\"ATTAVO_DRIVE_POLL_INTERVAL_S\\\": \\\"0.5\\\"}\\n\\n\\ndef slow_adapter(root: Path, seconds: float) -> None:\\n    \\\"\\\"\\\"A tenant-side build adapter: the product's own fixture adapter,\\n    after `seconds` of sleep on the build stage.\\\"\\\"\\\"\\n    d = root / \\\"attavo\\\" / \\\"adapters\\\" / \\\"fixture\\\"\\n    d.mkdir(parents=True, exist_ok=True)\\n    run = d / \\\"run\\\"\\n    run.write_text(f'#!/bin/sh\\\\nif [ \\\"${{ATTAVO_STAGE:-build}}\\\" = build ]; then sleep {seconds}; fi\\\\n'\\n                   f'exec sh {ROOT / \\\"adapters\\\" / \\\"fixture\\\" / \\\"run\\\"}\\\\n')\\n    run.chmod(0o755)\\n    commit_all(root, \\\"a slow tenant-side adapter\\\")\\n\\n\\ndef git_dir(root: Path) -> Path:\\n    return Path(git(root, \\\"rev-parse\\\", \\\"--absolute-git-dir\\\").strip())\\n\\n\\ndef report(root: Path, env: dict[str, str] | None = None) -> dict[str, Any]:\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\", \\\"--report\\\", env={**FAST, **(env or {})})\\n    assert run.returncode == 0, run.stdout + run.stderr\\n    out: dict[str, Any] = json.loads(run.stdout)\\n    return out\\n\\n\\ndef pushed(bare: Path, subject: str) -> bool:\\n    log = subprocess.run([\\\"git\\\", \\\"-C\\\", str(bare), \\\"log\\\", \\\"--format=%s\\\", \\\"attavo/1-x\\\"], capture_output=True, text=True).stdout\\n    return subject in log\\n\\n\\ndef wait_for(pred: Any, seconds: float = 20) -> None:\\n    deadline = time.monotonic() + seconds\\n    while time.monotonic() < deadline:\\n        if pred():\\n            return\\n        time.sleep(0.2)\\n    raise AssertionError(\\\"condition not met in time\\\")\\n\\n\\ndef passes_until(root: Path, pred: Any, seconds: float = 40, env: dict[str, str] | None = None) -> None:\\n    \\\"\\\"\\\"Passes, spaced, until pred holds: how an operator's loop, the\\n    screen's poll, or a scheduler line would drive the item.\\\"\\\"\\\"\\n    deadline = time.monotonic() + seconds\\n    full = dict(FAST)\\n    full.update(env or {})\\n    while time.monotonic() < deadline:\\n        run_attavo(root, \\\"drive\\\", \\\"1\\\", env=full)\\n        if pred():\\n            return\\n        time.sleep(0.5)\\n    raise AssertionError(\\\"condition not met in time\\\")\\n\\n\\ndef clock_ahead(tmp_path: Path, seconds: float) -> dict[str, str]:\\n    \\\"\\\"\\\"The environment that puts every bound the product judges `seconds`\\n    past the machine's now (#257): a clock file, named by ATTAVO_CLOCK_FILE,\\n    that the next pass reads instead of waiting.\\\"\\\"\\\"\\n    path = tmp_path / \\\"attavo-clock\\\"\\n    path.write_text(str(time.time() + seconds))\\n    return {\\\"ATTAVO_CLOCK_FILE\\\": str(path)}\\n\\n\\ndef built_tenant(tmp_path: Path, seconds: float = 3) -> tuple[Path, Path]:\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    add_forge(root, GREEN_FORGE)\\n    add_drive_stall_bound(root)\\n    slow_adapter(root, seconds)\\n    bare = add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n    return root, bare\\n\\n\\ndef test_a_pass_returns_while_the_worker_runs_and_the_worker_outlives_it(tmp_path: Path) -> None:\\n    root, bare = built_tenant(tmp_path, seconds=3)\\n    started = time.monotonic()\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\", env=FAST)\\n    elapsed = time.monotonic() - started\\n    assert run.returncode == 0, run.stdout + run.stderr\\n    assert elapsed < 2.5, f\\\"the pass took {elapsed:.1f}s: it waited for the stage\\\"\\n    assert \\\"Build started\\\" in run.stdout, run.stdout\\n    assert (records_dir(root) / \\\"build-01.started\\\").exists()\\n    assert remote_head(bare) == head_of(root), \\\"the marker was not pushed before the pass returned\\\"\\n    assert record_files(root, \\\"build\\\") == [], \\\"the record existed before the worker could have written it\\\"\\n    wait_for(lambda: record_files(root, \\\"build\\\") != [])\\n    wait_for(lambda: remote_head(bare) == head_of(root))\\n    assert latest_record(root, \\\"build\\\")[\\\"status\\\"] == \\\"pass\\\"\\n\\n\\ndef test_the_worker_touches_its_heartbeat_and_the_report_reads_running_by_it(tmp_path: Path) -> None:\\n    root, _ = built_tenant(tmp_path, seconds=3)\\n    assert run_attavo(root, \\\"drive\\\", \\\"1\\\", env=FAST).returncode == 0\\n    beat = git_dir(root) / \\\"attavo\\\" / \\\"build-01.heartbeat\\\"\\n    wait_for(beat.exists, 5)\\n    first = beat.stat().st_mtime\\n    time.sleep(0.6)\\n    assert beat.stat().st_mtime > first, \\\"the heartbeat did not move\\\"\\n    r = report(root)\\n    assert (r[\\\"state\\\"], r[\\\"kind\\\"]) == (\\\"running\\\", \\\"waits\\\"), r\\n    wait_for(lambda: record_files(root, \\\"build\\\") != [])\\n\\n\\ndef test_a_stale_heartbeat_reads_died_though_the_pid_lives_and_a_fresh_one_reads_alive(tmp_path: Path) -> None:\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    git(root, \\\"checkout\\\", \\\"-q\\\", \\\"-b\\\", \\\"attavo/1-x\\\")\\n    add_forge(root, GREEN_FORGE)\\n    add_drive_stall_bound(root, 600)\\n    approve_item(root)\\n    d = records_dir(root)\\n    d.mkdir(parents=True, exist_ok=True)\\n    marker = d / \\\"build-01.started\\\"\\n    now = time.strftime(\\\"%Y-%m-%dT%H:%M:%SZ\\\", time.gmtime())\\n    marker.write_text(json.dumps({\\\"at\\\": now, \\\"host\\\": socket.gethostname(),\\n                                  \\\"pid\\\": os.getpid(), \\\"sha\\\": head_of(root), \\\"product_version\\\": \\\"fixture\\\"}))\\n    commit_all(root, \\\"a marker whose pid is this test\\\")\\n    beat = git_dir(root) / \\\"attavo\\\" / \\\"build-01.heartbeat\\\"\\n    beat.parent.mkdir(parents=True, exist_ok=True)\\n    beat.touch()\\n    os.utime(beat, (time.time() - 60, time.time() - 60))\\n    r = report(root)\\n    assert (r[\\\"state\\\"], r[\\\"stop_class\\\"]) == (\\\"owes-recovery\\\", \\\"died\\\"), r\\n    beat.touch()\\n    r = report(root)\\n    assert r[\\\"state\\\"] == \\\"running\\\", r\\n\\n\\ndef test_two_passes_at_once_start_one_worker_and_the_loser_says_so(tmp_path: Path) -> None:\\n    root, bare = built_tenant(tmp_path, seconds=3)\\n    publish_approval(root)\\n    clone = tmp_path / \\\"second\\\"\\n    git(root.parent, \\\"clone\\\", \\\"-q\\\", \\\"-b\\\", git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip(), str(bare), str(clone))\\n    git(clone, \\\"config\\\", \\\"user.email\\\", \\\"test@example.com\\\")\\n    git(clone, \\\"config\\\", \\\"user.name\\\", \\\"Attavo Test\\\")\\n    git(clone, \\\"remote\\\", \\\"set-head\\\", \\\"origin\\\", \\\"-a\\\")\\n    env = dict(os.environ)\\n    env.update(FAST)\\n    before = {c: (head_of(c), git(c, \\\"ls-files\\\", \\\"-s\\\"), git(c, \\\"status\\\", \\\"--porcelain\\\")) for c in (root, clone)}\\n    procs = [subprocess.Popen([sys.executable, str(ROOT / \\\"bin\\\" / \\\"attavo\\\"), \\\"drive\\\", \\\"1\\\"], cwd=str(c),\\n                              env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)\\n             for c in (root, clone)]\\n    outs = [p.communicate(timeout=30)[0] for p in procs]\\n    started = [o for o in outs if \\\"Build started\\\" in o]\\n    held = [o for o in outs if \\\"another pass holds\\\" in o]\\n    assert len(started) == 1 and len(held) == 1, outs\\n    loser = clone if \\\"another pass holds\\\" in outs[1] else root\\n    assert (head_of(loser), git(loser, \\\"ls-files\\\", \\\"-s\\\"), git(loser, \\\"status\\\", \\\"--porcelain\\\")) == before[loser], \\\\\\n        \\\"the loser's checkout (HEAD, index, working tree) moved\\\"\\n    assert \\\"reset\\\" not in git(loser, \\\"reflog\\\", \\\"show\\\", \\\"HEAD\\\"), git(loser, \\\"reflog\\\", \\\"show\\\", \\\"HEAD\\\")\\n    log = subprocess.run([\\\"git\\\", \\\"-C\\\", str(bare), \\\"log\\\", \\\"--format=%s\\\", \\\"attavo/1-x\\\"], capture_output=True, text=True).stdout\\n    assert log.count(\\\"build invocation 01 started\\\") == 1, log\\n    wait_for(lambda: \\\"build record for item 1\\\" in subprocess.run(\\n        [\\\"git\\\", \\\"-C\\\", str(bare), \\\"log\\\", \\\"--format=%s\\\", \\\"attavo/1-x\\\"], capture_output=True, text=True).stdout)\\n\\n\\ndef test_a_pass_recovers_a_dead_invocation_and_recover_is_gone(tmp_path: Path) -> None:\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    git(root, \\\"checkout\\\", \\\"-q\\\", \\\"-b\\\", \\\"attavo/1-x\\\")\\n    add_forge(root, GREEN_FORGE)\\n    add_drive_stall_bound(root)\\n    approve_item(root)\\n    write_dead_marker(root, \\\"build\\\", 1)\\n    gone = run_attavo(root, \\\"drive\\\", \\\"--recover\\\", \\\"1\\\", env=FAST)\\n    assert gone.returncode == 2 and \\\"gone\\\" in gone.stderr, gone.stdout + gone.stderr\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\", env=FAST)\\n    assert run.returncode == 0, run.stdout + run.stderr\\n    rec = latest_record(root, \\\"build\\\")\\n    assert rec[\\\"stop\\\"][\\\"class\\\"] == \\\"died\\\", rec[\\\"stop\\\"]\\n\\n\\ndef test_the_review_takes_the_checks_the_pass_read_and_never_polls(tmp_path: Path) -> None:\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    calls = tmp_path / \\\"forge-calls.txt\\\"\\n    forge = tmp_path / \\\"forge.sh\\\"\\n    forge.write_text(f'#!/bin/sh\\\\necho \\\"$1\\\" >> {calls}\\\\nprintf \\\"ci success\\\\\\\\n\\\"\\\\n')\\n    forge.chmod(0o755)\\n    add_forge(root, f\\\"sh {forge}\\\")\\n    add_drive_stall_bound(root)\\n    slow_adapter(root, 0)\\n    bare = add_bare_remote(root, tmp_path)\\n    approve_item(root)\\n    assert run_attavo(root, \\\"drive\\\", \\\"1\\\", env=FAST).returncode == 0\\n    wait_for(lambda: pushed(bare, \\\"build record for item 1\\\"))\\n    wait_for(lambda: remote_head(bare) == head_of(root))\\n    calls.write_text(\\\"\\\")\\n    pre_marker = head_of(root)\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\", env=FAST)\\n    assert \\\"Review started\\\" in run.stdout, run.stdout + run.stderr\\n    wait_for(lambda: record_files(root, \\\"verify\\\") != [])\\n    rec = latest_record(root, \\\"verify\\\")\\n    assert rec[\\\"status\\\"] == \\\"pass\\\", rec\\n    assert rec[\\\"forge_checks\\\"][\\\"sha\\\"] == pre_marker, (rec[\\\"forge_checks\\\"], pre_marker)\\n    read_by = [l for l in calls.read_text().split() if l]\\n    assert read_by == [pre_marker], f\\\"the forge was read {len(read_by)} time(s) after the build: {read_by}\\\"\\n\\n\\ndef test_until_ready_is_a_loop_of_passes_that_returns_at_ready(tmp_path: Path) -> None:\\n    root, _ = built_tenant(tmp_path, seconds=0)\\n    run = run_attavo(root, \\\"drive\\\", \\\"1\\\", \\\"--until-ready\\\", env=FAST)\\n    assert run.returncode == 0, run.stdout + run.stderr\\n    assert \\\"Build started\\\" in run.stdout and \\\"Review started\\\" in run.stdout, run.stdout\\n    assert run.stdout.strip().endswith(\\\"Ready to merge\\\"), run.stdout\\n    assert report(root)[\\\"state\\\"] == \\\"ready-to-merge\\\"\\n\\n\\ndef test_a_died_stage_retries_plainly_and_again_is_a_no_op_inside_the_budget(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"R3: died is one of the four plain retryable families -- the very\\n    next pass retries it on its own, with no operator and no --again\\n    needed; `--again` inside the budget is a no-op that says so, rather\\n    than starting a second attempt of its own.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    git(root, \\\"checkout\\\", \\\"-q\\\", \\\"-b\\\", \\\"attavo/1-x\\\")\\n    add_forge(root, GREEN_FORGE)\\n    add_drive_stall_bound(root)\\n    approve_item(root)\\n    write_dead_marker(root, \\\"build\\\", 1)\\n    assert run_attavo(root, \\\"drive\\\", \\\"1\\\", env=FAST).returncode == 0\\n    assert latest_record(root, \\\"build\\\")[\\\"stop\\\"][\\\"class\\\"] == \\\"died\\\"\\n    again = run_attavo(root, \\\"drive\\\", \\\"1\\\", \\\"--again\\\", \\\"--by\\\", \\\"alice\\\", env=FAST)\\n    assert again.returncode == 0 and \\\"retries on its own\\\" in again.stdout, again.stdout\\n    assert not (records_dir(root) / \\\"build-02.started\\\").exists()\\n    plain = run_attavo(root, \\\"drive\\\", \\\"1\\\", env=FAST)\\n    assert \\\"Build started\\\" in plain.stdout, plain.stdout + plain.stderr\\n    assert (records_dir(root) / \\\"build-02.started\\\").exists()\\n    wait_for(lambda: len(record_files(root, \\\"build\\\")) == 2)\\n    assert latest_record(root, \\\"build\\\")[\\\"retry_of\\\"] == \\\"build-01\\\"\\n\\n\\ndef test_all_from_the_checkout_passes_every_unmerged_branch_on_origin_and_removes_merged_copies(\\n        tmp_path: Path) -> None:\\n    from test_working_copy import add_merged_item, copy_of, tenant_on_main\\n    root, bare = tenant_on_main(tmp_path)\\n    add_merged_item(root, bare, \\\"2\\\")\\n    merged = copy_of(tmp_path, \\\"2\\\")\\n    git(root, \\\"worktree\\\", \\\"add\\\", \\\"-q\\\", str(merged), \\\"attavo/2-y\\\")\\n    run = run_attavo(root, \\\"drive\\\", \\\"--all\\\", env=FAST)\\n    assert run.returncode == 0, run.stdout + run.stderr\\n    assert \\\"attavo-worktree-1: attavo drive: Build started\\\" in run.stdout, run.stdout\\n    assert \\\"attavo-worktree-2: attavo drive: merged: removed attavo-worktree-2\\\" in run.stdout, run.stdout\\n    assert not merged.exists()\\n    wait_for(lambda: record_files(copy_of(tmp_path), \\\"build\\\") != [])\\n\\n\\ndef test_the_report_reads_running_for_the_whole_of_counsel_and_stopped_after_the_push(tmp_path: Path) -> None:\",\"numLines\":280,\"startLine\":1,\"totalLines\":440}}}\n121:{\"type\":\"assistant\",\"message\":{\"model\":\"claude-sonnet-5\",\"id\":\"msg_011CfaTmotnzvVsMSQgdrXz3\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_01Y99kMYkhjV9yDMFqM9JZ1X\",\"name\":\"Edit\",\"input\":{\"replace_all\":false,\"file_path\":\"/Users/davidbean/Projects/attavo-worktree-289/tests/test_pass.py\",\"old_string\":\"def test_a_pass_recovers_a_dead_invocation_and_recover_is_gone(tmp_path: Path) -> None:\",\"new_string\":\"def test_a_second_checkouts_pass_after_the_first_has_started_reads_running(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"The race made deterministic (#289): two checkouts of one tenant on\\n    one host is ordinary now, since the product owns each item's own\\n    working copy. Run the second's pass only after the first's marker has\\n    already landed -- no race for the lease at all -- and it must still\\n    read the first's heartbeat where its marker says to look, see it\\n    running, start nothing, and push no second invocation.\\\"\\\"\\\"\\n    root, bare = built_tenant(tmp_path, seconds=3)\\n    publish_approval(root)\\n    clone = tmp_path / \\\"second\\\"\\n    git(root.parent, \\\"clone\\\", \\\"-q\\\", \\\"-b\\\", git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip(),\\n        str(bare), str(clone))\\n    git(clone, \\\"config\\\", \\\"user.email\\\", \\\"test@example.com\\\")\\n    git(clone, \\\"config\\\", \\\"user.name\\\", \\\"Attavo Test\\\")\\n    git(clone, \\\"remote\\\", \\\"set-head\\\", \\\"origin\\\", \\\"-a\\\")\\n\\n    first = run_attavo(root, \\\"drive\\\", \\\"1\\\", env=FAST)\\n    assert \\\"Build started\\\" in first.stdout, first.stdout + first.stderr\\n\\n    second = run_attavo(clone, \\\"drive\\\", \\\"1\\\", env=FAST)\\n    assert second.returncode == 0, second.stdout + second.stderr\\n    assert \\\"Build started\\\" not in second.stdout, second.stdout\\n    assert \\\"another pass holds\\\" not in second.stdout, second.stdout\\n    assert \\\"running\\\" in second.stdout.lower(), second.stdout\\n\\n    log = subprocess.run([\\\"git\\\", \\\"-C\\\", str(bare), \\\"log\\\", \\\"--format=%s\\\", \\\"attavo/1-x\\\"],\\n                         capture_output=True, text=True).stdout\\n    assert log.count(\\\"build invocation 01 started\\\") == 1, log\\n    assert not (records_dir(clone) / \\\"build-02.started\\\").exists()\\n    wait_for(lambda: \\\"build record for item 1\\\" in subprocess.run(\\n        [\\\"git\\\", \\\"-C\\\", str(bare), \\\"log\\\", \\\"--format=%s\\\", \\\"attavo/1-x\\\"], capture_output=True, text=True).stdout)\\n\\n\\ndef test_the_heartbeat_is_read_where_the_marker_says(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"holder_heartbeat_path (#289): a marker from this host that names a\\n    directory is read there, not assumed to be this checkout's own --\\n    fresh there is running, absent there is still running while the\\n    marker is younger than the stall bound, and died once it is older.\\n    A marker with no `events` at all (written before this release) reads\\n    exactly as it always did: died the moment there is no heartbeat in\\n    this checkout's own directory, whatever the marker's own age.\\\"\\\"\\\"\\n    from attavo.doctor import heartbeat_path, holder_heartbeat_path, invocation_marker_path\\n    from attavo.drive import read_invocation\\n\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    git(root, \\\"checkout\\\", \\\"-q\\\", \\\"-b\\\", \\\"attavo/1-x\\\")\\n    bound = 5\\n    now = time.strftime(\\\"%Y-%m-%dT%H:%M:%SZ\\\", time.gmtime())\\n    old = time.strftime(\\\"%Y-%m-%dT%H:%M:%SZ\\\", time.gmtime(time.time() - bound * 10))\\n    other_events = tmp_path / \\\"other-checkout\\\" / \\\"attavo\\\"\\n    other_events.mkdir(parents=True)\\n    marker = invocation_marker_path(records_dir(root), \\\"build\\\", 1)\\n\\n    info = {\\\"at\\\": now, \\\"host\\\": socket.gethostname(), \\\"sha\\\": head_of(root),\\n            \\\"product_version\\\": \\\"fixture\\\", \\\"events\\\": str(other_events)}\\n    beat = holder_heartbeat_path(root, info, \\\"build\\\", 1)\\n    assert beat == other_events / \\\"build-01.heartbeat\\\"\\n\\n    beat.write_text(\\\"4242\\\\n\\\")\\n    assert read_invocation(root, bound, marker, info).cls == \\\"running\\\"\\n\\n    beat.unlink()\\n    assert read_invocation(root, bound, marker, info).cls == \\\"running\\\"\\n\\n    info_old = {**info, \\\"at\\\": old}\\n    assert read_invocation(root, bound, marker, info_old).cls == \\\"died\\\"\\n\\n    legacy = {\\\"at\\\": now, \\\"host\\\": socket.gethostname(), \\\"sha\\\": head_of(root),\\n             \\\"product_version\\\": \\\"fixture\\\"}\\n    assert holder_heartbeat_path(root, legacy, \\\"build\\\", 1) == heartbeat_path(root, \\\"build\\\", 1)\\n    assert read_invocation(root, bound, marker, legacy).cls == \\\"died\\\"\\n\\n\\ndef test_the_marker_a_pass_writes_names_its_checkouts_own_directory(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"write_invocation_marker's own `events` field, from `attavo drive`\\n    itself (#289): the marker is committed and pushed from a detached\\n    worktree, but `events` must still name the checkout's own\\n    <git-dir>/attavo, never that worktree's -- otherwise a second\\n    checkout reading this marker later would look for the heartbeat in a\\n    directory removed the moment the marker's own push returned.\\\"\\\"\\\"\\n    root, bare = built_tenant(tmp_path, seconds=0)\\n    assert run_attavo(root, \\\"drive\\\", \\\"1\\\", env=FAST).returncode == 0\\n    marker = json.loads((records_dir(root) / \\\"build-01.started\\\").read_text())\\n    assert marker[\\\"events\\\"] == str(git_dir(root) / \\\"attavo\\\"), marker\\n    wait_for(lambda: record_files(root, \\\"build\\\") != [])\\n\\n\\ndef test_a_pass_recovers_a_dead_invocation_and_recover_is_gone(tmp_path: Path) -> None:\"},\"caller\":{\"type\":\"direct\"}}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":2525,\"cache_read_input_tokens\":134699,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":2525},\"output_tokens\":8,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"b3f717aa-5c2b-4867-b022-0f24cffb6427\",\"uuid\":\"0d0732b6-140a-42ca-a6e8-62c9b54f9d07\",\"timestamp\":\"2026-09-30T23:07:35.198Z\",\"request_id\":\"req_011CfaTmoWDvntgfmh8fqLtc\",\"wire_tool_inputs\":{\"toolu_01Y99kMYkhjV9yDMFqM9JZ1X\":{\"file_path\":\"/U
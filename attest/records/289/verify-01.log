{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc \"rg -n \\\"write_invocation_marker|holder_heartbeat_path|heartbeat_path\\\\(\\\" attavo tests | head -240 && sed -n '300,410p' attavo/doctor.py && sed -n '360,455p' attavo/drive.py && sed -n '680,750p' attavo/drive.py && git show --stat --oneline 90ffdfc14e757a0a31db7efc21d2c804a4ecdfff && git show --format=fuller --no-ext-diff 220163ddcd8becebd76d34006f10a115b181ee7d -- attest/specs/289\"","aggregated_output":"attavo/doctor.py:178:def heartbeat_path(root: Path, stage: str, nn: int) -> Path:\nattavo/doctor.py:182:def holder_heartbeat_path(root: Path, info: dict[str, Any], stage: str, nn: int) -> Path | None:\nattavo/doctor.py:194:    return heartbeat_path(root, stage, nn)\nattavo/doctor.py:220:def write_invocation_marker(root: Path, records_dir: Path, stage: str, nn: int,\nattavo/doctor.py:364:                beat_file = holder_heartbeat_path(root, info, stage, int(nn_text))\nattavo/drive.py:30:    holder_heartbeat_path,\nattavo/drive.py:36:    write_invocation_marker,\nattavo/drive.py:390:    read where the marker says its holder writes it (holder_heartbeat_path),\nattavo/drive.py:417:    beat_file = holder_heartbeat_path(root, info, stage, nn)\nattavo/drive.py:522:    beat = heartbeat_path(root, stage, nn)\nattavo/drive.py:662:        return [write_invocation_marker(tree, tree / records_dir.relative_to(root), stage, nn,\nattavo/drive.py:722:        holder_file = holder_heartbeat_path(root, info, stage, nn)\ntests/test_pass.py:418:        seen[\"age\"] = time.time() - heartbeat_path(root, \"build\", 1).stat().st_mtime\n    if isinstance(value, bool) or not isinstance(value, (int, float)) or value <= 0:\n        return None\n    return int(value)\n\n\ndef attempts_budget(m: dict[str, Any]) -> int:\n    \"\"\"R3: [drive].attempts, the attempts a stage may spend -- across a\n    plain retry, a returned retry, and a steered one alike -- before the\n    item is a person's;
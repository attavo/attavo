{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,120p' attavo/events.py; sed -n '275,325p' attavo/drive.py; rg -n \\\"proof_no_invocation|hung.*signal|no holder to signal|terminated|events.*heartbeat|legacy marker\\\" tests\"","aggregated_output":"from __future__ import annotations\n\nimport json\nfrom pathlib import Path\n\nfrom attavo.common import git, now_iso\n\n# --- events: the adapter contract's one optional output (issue #26) --\n# an uncommitted <stage>-NN.events.jsonl the screen tails while a stage\n# runs, never a record and never committed (commit_record names only\n# .json, .log, and .filed; this suffix is never among them). Written\n# under the checkout's own git directory, not the working tree (issue\n# #140): tenant zero's own item #688 committed its events file for\n# real -- the executor's own commit staged it, because it sat inside\n# the tree the executor runs `git status` against. ---\n\nEVENT_TEXT_MAX_CHARS = 400\n\n\ndef stage_events_dir(root: Path) -> Path:\n    \"\"\"<git-dir>/attavo, absolute -- <checkout>/.git/attavo for an\n    ordinary checkout, <main-repo>/.git/worktrees/<name>/attavo for a\n    linked worktree (issue #140). Outside the working tree either way,\n    so a file written here never appears in `git status` in root and is\n    never at risk of being staged and committed by the executor; the\n    screen's seam finds it the same way, with the same command, in its\n    own worktree.\"\"\"\n    git_dir = Path(git(root, \"rev-parse\", \"--absolute-git-dir\").strip())\n    events_dir = git_dir / \"attavo\"\n    events_dir.mkdir(parents=True, exist_ok=True)\n    return events_dir\n\n\ndef append_event(events_path: Path, kind: str, text: str) -> None:\n    \"\"\"One {at, kind, text} JSON line appended to events_path and flushed\n    at once (open-write-close, not a kept handle) -- the screen tails\n    this file while the stage is still running, so a line held in a\n    buffer is a line the feed does not move on. text is collapsed to one\n    line and capped at EVENT_TEXT_MAX_CHARS: a tool result can be a whole\n    file, and the feed renders lines, not files.\"\"\"\n    line = {\"at\": now_iso(), \"kind\": kind,\n            \"text\": \" \".join(text.split())[:EVENT_TEXT_MAX_CHARS]}\n    with events_path.open(\"a\") as fh:\n        fh.write(json.dumps(line) + \"\\n\")\n                     == (latest_approval.get(\"sha\") if latest_approval else None))\n    if latest_build is None or not build_current:\n        return \"build\", None, records_dir\n\n    latest_verify = latest_record(records_dir, \"verify\")\n    verify_current = (latest_verify is not None and latest_verify.get(\"status\") == \"pass\"\n                      and latest_verify.get(\"build_sha\") == latest_build.get(\"sha\"))\n    if not verify_current:\n        return \"verify\", None, records_dir\n\n    return \"ready\", None, records_dir\n\n\n# --- the heartbeat (its helpers live in attavo/doctor.py, where proof five\n# reads it too), the worker log, and the forge-checks handoff: local\n# facts under the checkout's own git directory (issue #140's precedent),\n# never committed and never among the paths commit_record ever names. ---\n\ndef worker_log_path(root: Path, stage: str, nn: int) -> Path:\n    return stage_events_dir(root) / f\"{stage}-{nn:02d}.worker.log\"\n\n\ndef forge_checks_path(root: Path, stage: str, nn: int) -> Path:\n    return stage_events_dir(root) / f\"{stage}-{nn:02d}.forge-checks.json\"\n\n\ndef _events_path_for(root: Path, stage: str, nn: int) -> Path | None:\n    \"\"\"The adapter's own events file for this invocation, under the\n    checkout's git dir (a worktree's own dir when the checkout is one).\"\"\"\n    try:\n        gitdir = Path(git(root, \"rev-parse\", \"--git-dir\").strip())\n    except RuntimeError:\n        return None\n    if not gitdir.is_absolute():\n        gitdir = root / gitdir\n    path = gitdir / \"attavo\" / f\"{stage}-{nn:02d}.events.jsonl\"\n    return path if path.is_file() else None\n\n\ndef _events_tail(path: Path | None, lines: int = 20) -> tuple[str, str | None]:\n    \"\"\"(the last lines as a log, the last event's own at).\"\"\"\n    if path is None:\n        return \"no events file for this invocation\\n\", None\n    try:\n        text = path.read_text()\n    except OSError:\n        return \"events file unreadable\\n\", None\n    tail = text.splitlines()[-lines:]\n    last_at = None\n    for line in reversed(tail):\n        parsed = _parse_json_line(line)\ntests/test_report.py:238:    os.kill(os.getpid(), 0)  # the report terminated nothing: this process is the heartbeat's pid\ntests/test_counsel.py:640:    assert symbols & {\"proof_no_invocation_lacks_record\", \"invocation_alive\"}, record[\"citations\"]\ntests/test_drive.py:1288:def test_hung_recovery_signals_the_pid_the_heartbeat_names(tmp_path: Path) -> None:\ntests/test_drive.py:1289:    \"\"\"The hung recovery used to signal the marker's pid -- the driver's,\ntests/test_drive.py:1290:    long gone -- and report \"terminated\" over a live hung worker. It\ntests/test_drive.py:1308:        assert f\"pid {holder.pid}\" in stop[\"detail\"] and \"terminated\" in stop[\"detail\"], stop\ntests/test_drive.py:1315:def test_hung_recovery_says_there_is_no_holder_to_signal_when_the_heartbeat_names_none(tmp_path: Path) -> None:\ntests/test_drive.py:1329:        assert \"no holder to signal\" in run.stdout, run.stdout\ntests/test_retry.py:342:    \"\"\"A worker alive past [drive.build].ceiling_s is terminated and\n","exit_code":0,"status":"completed"}}

and cmd_counsel, which both hand an adapter this\n83\t    same diff.\"\"\"\n84\t    if not approval_sha:\n85\t        return \"\", None\n86\t    symref = subprocess.run(\n87\t        [\"git\", \"-C\", str(root), \"symbolic-ref\", \"-q\", \"refs/remotes/origin/HEAD\"],\n88\t        capture_output=True, text=True, check=False)\n89\t    if symref.returncode != 0:\n90\t        return \"\", \"refs/remotes/origin/HEAD is not set; run `git remote set-head origin -a`\"\n91\t    diff_base = git(root, \"merge-base\", symref.stdout.strip(), \"HEAD\").strip()\n92\t    return git(root, \"diff\", diff_base, \"HEAD\"), None\n93\t\n94\t\n95\tdef stub_ratio(diff_text: str, stub_dir: Path, excluded: tuple[str, ...]) -> float | None:\n96\t    \"\"\"The share of the lines diff_text adds that are a line of the stub's\n97\t    file at the same path: near 1 the build shipped the spec author's stub,\n98\t    near 0 the builder wrote the change. Lines under the excluded\n99\t    directories (the specs and records, where the stub itself and the\n100\t    item's records are committed) and blank lines are not counted. None\n101\t    when there is no stub or the diff adds no counted line -- nothing was\n102\t    measured, which is not 0.0.\"\"\"\n103\t    if not stub_dir.is_dir():\n104\t        return None\n105\t    skipped = tuple(e.strip(\"/\") for e in excluded)\n106\t    stub_lines: dict[str, set[str]] = {}\n107\t    path: str | None = None\n108\t    in_hunk = False\n109\t    added = shipped = 0\n110\t    for line in diff_text.splitlines():\n111\t        if line.startswith(\"diff --git \"):\n112\t            path, in_hunk = None, False\n113\t        elif in_hunk:\n114\t            if line.startswith(\"+\") and line[1:].strip() and path is not None:\n115\t                added += 1\n116\t                shipped += line[1:].rstrip() in stub_lines[path]\n117\t        elif line.startswith(\"+++ \"):\n118\t            name = line[4:].split(\"\\t\")[0]\n119\t            path = name[2:] if name.startswith(\"b/\") else None\n120\t            if path is not None and any(path == e or path.startswith(e + \"/\") for e in skipped):\n121\t                path = None\n122\t            if path is not None and path not in stub_lines:\n123\t                stub_file = stub_dir / path\n124\t                stub_lines[path] = (\n125\t                    {text.rstrip() for text in stub_file.read_text(errors=\"replace\").splitlines()}\n126\t                    if stub_file.is_file() else set())\n127\t        elif line.startswith(\"@@\"):\n128\t            in_hunk = True\n129\t    return shipped / added if added else None\n130\t\n131\t\n132\tdef _returned_stop(forge_checks: dict[str, Any]) -> dict[str, Any]:\n133\t    \"\"\"R3 (ruling C amended): a review the forge returned because a\n134\t    required check concluded red is class returned, retryable -- the\n135\t    next build attempt is handed the evidence -- signed by the sorted\n136\t    names of the checks that concluded red. A review returned because\n137\t    the checks have not concluded at all yet (nothing to sign) stays\n138\t    forge-unconcluded, as before -- there is no rejection to hand a\n139\t    build, only a wait that already has its own bound (the drive\n140\t    forge-poll bound, unchanged by this item).\"\"\"\n141\t    conclusions = forge_checks.get(\"conclusions\") or []\n142\t    red = sorted(c[\"name\"] for c in conclusions\n143\t                if c[\"conclusion\"] not in FORGE_OK_CONCLUSIONS\n144\t                and c[\"conclusion\"] not in FORGE_UNCONCLUDED_STATUSES)\n145\t    unconcluded = [c for c in conclusions if c[\"conclusion\"] in FORGE_UNCONCLUDED_STATUSES]\n146\t    if red and not unconcluded:\n147\t        detail = \", \".join(f\"{c['name']} {c['conclusion']}\" for c in conclusions if c[\"name\"] in red)\n148\t        return {\"class\": \"returned\", \"provenance\": \"tenant\", \"detail\": detail,\n149\t               \"signature\": signature_of(\" \".join(red)), \"bound\": None}\n150\t    stop = dict(derive_stop(\"returned\") or {})\n151\t    return {**stop, \"signature\": None, \"bound\": None}\n152\t\n153\t\n154\tdef _verify_retry_seed(records_dir: Path, build_sha: str) -> tuple[str | None, str | None]:\n155\t    \"\"\"(retry_of, steer): a plain retry of verify itself -- died, hung,\n156\t    transient, or any other non-returned stop counsel answered -- names\n157\t    the prior verify attempt it retries, the same way build's own retry\n158\t    does. A returned review is never this: its own fix is a new build,\n159\t    not a new verify, so build.py's _retry_seed is what names it as\n160\t    retry_of instead.\"\"\"\n161\t    attempts = parse_attempts(records_dir, \"verify\")\n162\t    if not attempts:\n163\t        return None, None\n164\t    nn = max(attempts)\n165\t    prior = attempts[nn]\n166\t    stop = cast(\"dict[str, Any]\", prior.get(\"stop\") or {})\n167\t    if prior.get(\"status\") == \"pass\" or prior.get(\"build_sha\") != build_sha or stop.get(\"class\") == \"returned\":\n168\t        return None, None\n169\t    prior_stem = f\"verify-{nn:02d}\"\n170\t    counsel = counsel_record_for(records_dir, \"verify\", nn)\n171\t    steer = None\n172\t    if counsel is not None and counsel.get(\"verdict\") == \"answer\":\n173\t        counsel_attempts = parse_attempts(records_dir, \"counsel\")\n174\t        matches = [n for n, rec in counsel_attempts.items() if rec.get(\"record\") == prior_stem]\n175\t        if matches:\n176\t            steer = f\"counsel-{max(matches):02d}\"\n177\t    return prior_stem, steer\n178\t\n179\t\n180\tdef cmd_verify(argv: list[str]) -> int:\n181\t    root = Path(\".\").resolve()\n182\t    item_id = argv[0] if argv else derive_item_id(root)\n183\t    if not item_id:\n184\t        print(\"attavo verify: cannot derive item id; pass N or run on an attavo/N-* branch\",\n185\t              file=sys.stderr)\n186\t        return 2\n187\t    m = read_manifest(root)\n188\t    if m is None:\n189\t        print(f\"attavo
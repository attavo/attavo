{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JTMm8NrzRZAZgvBCYh9zx8","type":"tool_result","content":"1\t\"\"\"Shared helpers for building tenant fixtures at test time.\n2\t\n3\tFixtures under tests/fixtures/ are plain file trees, not git repositories;\n4\teach test copies the one it needs into a tmp_path and initializes it as its\n5\town repository, so every test gets a clean, independent commit history.\n6\t\"\"\"\n7\tfrom __future__ import annotations\n8\t\n9\timport shutil\n10\timport subprocess\n11\tfrom pathlib import Path\n12\t\n13\tFIXTURES = Path(__file__).resolve().parent / \"fixtures\"\n14\t\n15\t\n16\tdef git(root: Path, *args: str) -> str:\n17\t    out = subprocess.run([\"git\", \"-C\", str(root), *args], capture_output=True,\n18\t                         text=True, check=True)\n19\t    return out.stdout\n20\t\n21\t\n22\tdef init_repo(root: Path, message: str = \"initial\") -> None:\n23\t    git(root, \"init\", \"-q\", \"-b\", \"main\")\n24\t    git(root, \"config\", \"user.email\", \"test@example.com\")\n25\t    git(root, \"config\", \"user.name\", \"Attavo Test\")\n26\t    git(root, \"add\", \"-A\")\n27\t    git(root, \"commit\", \"-q\", \"-m\", message)\n28\t    # attavo verify reads refs/remotes/origin/HEAD to diff the item's own\n29\t    # work against (issue #52); a real checkout always has this once\n30\t    # cloned, so fixtures fake it here rather than making every test set\n31\t    # up its own origin remote.\n32\t    sha = git(root, \"rev-parse\", \"HEAD\").strip()\n33\t    git(root, \"update-ref\", \"refs/remotes/origin/main\", sha)\n34\t    git(root, \"symbolic-ref\", \"refs/remotes/origin/HEAD\", \"refs/remotes/origin/main\")\n35\t\n36\t\n37\tdef commit_all(root: Path, message: str) -> None:\n38\t    git(root, \"add\", \"-A\")\n39\t    git(root, \"commit\", \"-q\", \"-m\", message)\n40\t\n41\t\n42\tdef clone_shallow(root: Path, dest: Path) -> None:\n43\t    \"\"\"A --depth 1 clone of root, the same history-truncated checkout\n44\t    actions/checkout@v4 leaves behind with no fetch-depth set.\n45\t    \"\"\"\n46\t    subprocess.run([\"git\", \"clone\", \"--quiet\", \"--depth\", \"1\", \"--branch\",\n47\t                    git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip(),\n48\t                    f\"file://{root}\", str(dest)],\n49\t                   capture_output=True, text=True, check=True)\n50\t\n51\t\n52\tdef make_tenant(tmp_path: Path, fixture: str, name: str | None = None) -> Path:\n53\t    \"\"\"Copy tests/fixtures/<fixture> to a fresh dir and git-init + commit it.\"\"\"\n54\t    dest = tmp_path / (name or fixture)\n55\t    shutil.copytree(FIXTURES / fixture, dest)\n56\t    init_repo(dest)\n57\t    return dest\n58\t\n59\t\n60\tdef job_if_condition(yaml_text: str, job_name: str) -> str | None:\n61\t    \"\"\"Pull a workflow job's top-level `if:` condition out of template YAML\n62\t    text, or None if the job has no such condition. Reads the literal file\n63\t    rather than reimplementing YAML parsing, same as extract_step_run.\n64\t    \"\"\"\n65\t    lines = yaml_text.splitlines()\n66\t    marker = f\"{job_name}:\"\n67\t    start = next(i for i, l in enumerate(lines) if l.strip() == marker)\n68\t    job_indent = len(lines[start]) - len(lines[start].lstrip(\" \"))\n69\t    body_indent = job_indent + 2\n70\t    for line in lines[start + 1:]:"}]},"parent_tool_use_id":null,"session_id":"ec2614fd-fe76-497e-a0f4-348a6650b419","uuid":"83be6f6e-34df-402c-9500-e4d941ebcac7","timestamp":"2026-09-27T15:43:09.693Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-229/tests/helpers.py","content":"\"\"\"Shared helpers for building tenant fixtures at test time.\n\nFixtures under tests/fixtures/ are plain file trees, not git repositories;\neach test copies the one it needs into a tmp_path and initializes it as its\nown repository, so every test gets a clean, independent commit history.\n\"\"\"\nfrom __future__ import annotations\n\nimport shutil\nimport subprocess\nfrom pathlib import Path\n\nFIXTURES = Path(__file__).resolve().parent / \"fixtures\"\n\n\ndef git(root: Path, *args: str) -> str:\n    out = subprocess.run([\"git\", \"-C\", str(root), *args], capture_output=True,\n                         text=True, check=True)\n    return out.stdout\n\n\ndef init_repo(root: Path, message: str = \"initial\") -> None:\n    git(root, \"init\", \"-q\", \"-b\", \"main\")\n    git(root, \"config\", \"user.email\", \"test@example.com\")\n    git(root, \"config\", \"user.name\", \"Attavo Test\")\n    git(root, \"add\", \"-A\")\n    git(root, \"commit\", \"-q\", \"-m\", message)\n    # attavo verify reads refs/remotes/origin/HEAD to diff the item's own\n    # work against (issue #52); a real checkout always has this once\n    # cloned, so fixtures fake it here rather than making every test set\n    # up its own origin remote.\n    sha = git(root, \"rev-parse\", \"HEAD\").strip()\n    git(root, \"update-ref\", \"refs/remotes/origin/main\", sha)\n    git(root, \"symbolic-ref\", \"refs/remotes/origin/HEAD\", \"refs/remotes/origin/main\")\n\n\ndef commit_all(root: Path, message: str) -> None:\n    git(root, \"add\", \"-A\")\n    git(root, \"commit\", \"-q\", \"-m\", message)\n\n\ndef clone_shallow(root: Path, dest: Path) -> None:\n    \"\"\"A --depth 1 clone of root, the same history-truncated checkout\n    actions/checkout@v4 leaves behind with no fetch-depth set.\n    \"\"\"\n    subprocess.run([\"git\", \"clone\", \"--quiet\", \"--depth\", \"1\", \"--branch\",\n                    git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip(),\n                    f\"file://{root}\", str(dest)],\n                   capture_output=True, text=True, check=True)\n\n\ndef make_tenant(tmp_path: Path, fixture: str, name: str | None = None) -> Path:\n    \"\"\"Copy tests/fixtures/<fixture> to a fresh dir and git-init + commit it.\"\"\"\n    dest = tmp_path / (name or fixture)\n    shutil.copytree(FIXTURES / fixture, dest)\n    init_repo(dest)\n    return dest\n\n\ndef job_if_condition(yaml_text: str, job_name: str) -> str | None:\n    \"\"\"Pull a workflow job's top-level `if:` condition out of template YAML\n    text, or None if the job has no such condition. Reads the literal file\n    rather than reimplementing YAML parsing, same as extract_step_run.\n    \"\"\"\n    lines = yaml_text.splitlines()\n    marker = f\"{job_name}:\"\n    start = next(i for i, l in enumerate(lines) if l.strip() == marker)\n    job_indent = len(lines[start]) - len(lines[start].lstrip(\" \"))\n    body_indent = job_indent + 2\n    for line in lines[start + 1:]:","numLines":70,"startLine":1,"totalLines":153}}}

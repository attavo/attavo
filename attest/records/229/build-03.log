{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SkRJ21ksPdSzaT3uKVRrge","type":"tool_result","content":"1\tfrom __future__ import annotations\n2\t\n3\timport json\n4\timport re\n5\timport sys\n6\tfrom pathlib import Path\n7\tfrom typing import Any\n8\t\n9\tfrom attavo.common import MANIFEST, read_manifest\n10\tfrom attavo.records import parse_attempts, stage_schema\n11\tfrom attavo.types import CounselRecord, Stop\n12\t\n13\t# --- stop: every non-pass build or verify record's class and cause (issue\n14\t# #89) -- derived here, at write time, from the refusal, halted, and log\n15\t# the caller already has. Never a fresh read of anything: the tenant zero\n16\t# specimens this retires (#576 build-11, #659 build-01 and verify-01) are\n17\t# exactly a stop the product wrote with nothing beside it to explain\n18\t# itself after the fact. ---\n19\t\n20\tSTOP_CLASSES = (\"non-question\", \"outlived-invocation\", \"no-cause\", \"forge-unconcluded\",\n21\t               \"ceiling\", \"claims-boundary\", \"repeated-act\", \"unclassed\", \"question\",\n22\t               \"environment\", \"gate\", \"died\", \"hung\", \"transient\", \"returned\", \"empty\")\n23\t\n24\t# R3: the four families a pass retries with no person involved -- every\n25\t# other class is counsel's to read first, and a person's when counsel says\n26\t# so (or when counsel is not configured at all).\n27\tRETRYABLE_CLASSES = (\"died\", \"hung\", \"transient\", \"returned\")\n28\t\n29\t\n30\tdef signature_of(text: str | None) -> str | None:\n31\t    \"\"\"R3: a failure's signature, compared between attempts by plain string\n32\t    equality -- text with every run of digits removed, so two stops that\n33\t    differ only in a pid, a timestamp, or a retry-after count still match.\n34\t    None for no text at all (nothing to sign).\"\"\"\n35\t    if not text:\n36\t        return None\n37\t    stripped = re.sub(r\"[0-9]+\", \"\", text).strip()\n38\t    return stripped or None\n39\t\n40\t\n41\tSTOP_PROVENANCES = (\"product\", \"tenant\", \"executor\", \"spec\")\n42\t\n43\t# Beyond the enum spelling itself, the prose issue #88 actually shipped\n44\t# (adapters/claude-code/run and adapters/codex/run, on main since\n45\t# v0.16.0) once put a class's own name, or a real specimen's wording of\n46\t# it, in the transcript for the generic match below to find. Issue #94\n47\t# moves non-question and outlived-invocation onto report_class instead\n48\t# (below): non-question's own halt line (\"halted: class non-question\")\n49\t# would otherwise still satisfy the bare-name match here with no adapter\n50\t# report-line field involved at all, and outlived-invocation's refusal\n51\t# never named its class in text to begin with, so both are disabled here\n52\t# -- the same pattern issue #93 established for ceiling, just below,\n53\t# rather than removed outright.\n54\tCLASS_TEXT_MARKERS: dict[str, tuple[str, ...]] = {\n55\t    \"non-question\": (),\n56\t    \"outlived-invocation\": (),\n57\t    # R3: transient is read from the adapter's own report line\n58\t    # (report_class) below; returned is written directly by the pass or\n59\t    # cmd_verify, never derived from a log's text -- a retried attempt's\n60\t    # feedback file names the prior stop's class in prose, and that text\n61\t    # reaches the next attempt's own transcript, which must not then be\n62\t    # misread as a fresh instance of either class.\n63\t    \"transient\": (),\n64\t    \"returned\": (),\n65\t    # Issue #93: ceiling's own text-based check is CEILING_MARKERS, below,\n66\t    # with provenance \"product\" -- a fact about the tool, not an executor\n67\t    # judgment like non-question/outlived-invocation are. Left at the\n68\t    # default (the class's own name, \"ceiling\"), the generic match above\n69\t    # would instead catch adapters/codex/run's and\n70\t    # adapters/claude-code/run's own pre-emptive refusal -- which must\n71\t    # carry the word \"ceiling\" by the same issue's own brief -- as\n72\t    # provenance \"executor\", before CEILING_MARKERS is ever consulted.\n73\t    \"ceiling\": (),\n74\t    # A genuine question (issue #100's own followups) is read structurally\n75\t    # -- status \"halted\" carrying a non-empty halted.question -- not by\n76\t    # scanning for the literal word \"question\", which the question's own\n77\t    # text very often contains regardless of what it is actually asking.\n78\t    # Left at the default, the generic match above would misclassify any\n79\t    # question that happens to use the word \"question\" as executor\n80\t    # provenance, before the structural check in derive_stop is reached.\n81\t    \"question\": (),\n82\t    # environment/tenant (issue #115) is set directly by cmd_build's own\n83\t    # preflight -- the one caller who knows a [checks].command exited 2\n84\t    # on the approved tree -- never derived from adapter text. Left at\n85\t    # the default, the generic match above would catch the word\n86\t    # \"environment\" anywhere in a log or refusal (e.g. codex's own\n87\t    # OPENAI_API_KEY auth-mismatch refusal, adapters/codex/run's\n88\t    # check_auth) as an environment/executor stop that never happened.\n89\t    \"environment\": (),\n90\t}\n91\t\n92\t# Known tool error text for a declared ceiling -- issue #86's own specimen\n93\t# (codex's \"Input exceeds...\" line on a diff too large to judge) is\n94\t# \"input_too_large\"; a matching line anywhere in the log, not only its\n95\t# last line, since cmd_build and cmd_verify both append \"[adapter exited\n96\t# N]\" after whatever the tool itself printed. \"ceiling exceeded\" is issue\n97\t# #93's own addition: both adapters now refuse pre-emptively, before the\n98\t# tool is ever invoked, against a declared or fixed input limit, and\n99\t# their refusal text is not caught by any of the three markers above.\n100\tCEILING_MARKERS = (\"input_too_large\", \"exceeds the maximum context length\",\n101\t                  \"context_length_exceeded\", \"ceiling exceeded\")\n102\t\n103\t\n104\t# Issue #100's followups: an unclassed detail is the log's last line\n105\t# verbatim, and that line is sometimes an adapter's own event JSON or a\n106\t# tool's full error text -- thousands of characters wide. Capped here,\n107\t# at write time, so a filed issue's own summary of it (file-stops'\n108\t# log_tail already carries the full picture) stays short; the class\n109\t# itself, \"unclassed\", already says the full explanation lives in the\n110\t# log, not in this field.\n111\tUNCLASSED_DETAIL_MAX_CHARS = 200\n112\t\n113\t\n114\tdef _log_last_line(log: str | None) -> str:\n115\t    lines = [l for l in (log or \"\").splitlines() if l.strip()]\n116\t    last = lines[-1] if lines else \"\"\n117\t    return last[:UNCLASSED_DETAIL_MAX_CHARS]\n118\t\n119\t\n120\tdef _carries_a_known_class(text: str | None) -> str | None:\n121\t    \"\"\"Whichever of STOP_CLASSES this text names -- its own spelling, or\n122\t    one of CLASS_TEXT_MARKERS' real-world phrasings of it, when that\n123\t    class is not disabled there -- or None. Issue #88 is where an\n124\t    adapter's own halt or refusal first named its class this way; issue\n125\t    #93 added ceiling's own pre-emptive refusal to that set and disabled\n126\t    its bare-name match (CEILING_MARKERS covers it instead); issue #94\n127\t    disables non-question and outlived-invocation the same way, reading\n128\t    both from the adapter's own report line (derive_stop's report_class)\n129\t    now instead.\"\"\"\n130\t    text = text or \"\"\n131\t    for name in STOP_CLASSES:\n132\t        markers = CLASS_TEXT_MARKERS.get(name, (name,))\n133\t        if any(marker in text for marker in markers):\n134\t            return name\n135\t    return None\n136\t\n137\t\n138\tdef derive_stop(status: str, *, refusal: str | None = None, halted: dict[str, Any] | None = None,\n139\t                log: str | None = None, report_class: str | None = None,\n140\t                refusal_provenance: str | None = None) -> Stop | None:\n141\t    \"\"\"The stop field for a build or verify record: None for status \"pass\",\n142\t    else {class, provenance, detail} from what the caller already knows.\n143\t\n144\t      - report_class -- payload.get(\"class\") off the adapter's own report\n145\t        line (issue #88, #94), when it names a STOP_CLASSES member -- is\n146\t        that class, provenance \"executor\". build.schema.json and\n147\t        verify.schema.json stay untouched by issue #88 on purpose, so the\n148\t        class lives only on the report line, never a structured field\n149\t        cmd_build or cmd_verify forwards on its own account; the caller\n150\t        reads payload itself and passes this in, since only it still has\n151\t        payload once an iteration ends. This is non-question's and\n152\t        outlived-invocation's only path to a record now (issue #94):\n153\t        CLASS_TEXT_MARKERS disables both for the text scan below, the\n154\t        same way issue #93 disabled ceiling's bare-name match there. A\n155\t        class an adapter does not yet put on its report line --\n156\t        outlived-invocation today, since that refusal path prints no\n157\t        report line at all -- falls to unclassed below, same as any\n158\t        other unnamed cause, until the adapter that raises it puts a\n159\t        class on the line the way non-question already does.\n160\t      - a halt carrying a non-empty halted.question, once it is not a\n161\t        non-question caught above, is a genuine question -- question/spec,\n162\t        with the question's own first line as detail (issue #100's\n163\t        followups). This is the specimen issue #100 itself was built to\n164\t        retire: tenant zero's #663 build-01, a proper question, classed\n165\t        unclassed/product and filed as a product defect with the wrong\n166\t        provenance -- a question is about the definition of done, which is\n167\t        a person's or a ruling's to answer, never the product's own\n168\t        mechanism.\n169\t      - failing that, a refusal or the log itself that already names its\n170\t        class in text (issue #88, #93 for ceiling's own pre-emptive\n171\t        refusal) is that class, provenance \"executor\" -- the log is\n172\t        checked because neither adapter's refusal *field* carries the\n173\t        class today; the class-naming line each adapter prints reaches\n174\t        only the transcript\n175\t      - a refusal that is not that -- the write-outside-claims path\n176\t        itself, not the \"commit ... not authored by the executor\" shape\n177\t        -- is claims-boundary/spec, unless the caller already knows this\n178\t        refusal touched paths.records or paths.specs (issue #140:\n179\t        protected_path_touched, checked ahead of the ordinary claims\n180\t        match in cmd_build) and passes refusal_provenance=\"executor\" --\n181\t        the product's own directories are not a claim a spec makes, so a\n182\t        refusal there is not the spec's boundary to answer for\n183\t      - a returned verify (the forge was not green; no adapter ran) is\n184\t        forge-unconcluded/tenant\n185\t      - an adapter exit whose log carries a declared-ceiling error line is\n186\t        ceiling/product\n187\t      - anything else is unclassed/product, with the log's last line\n188\t        (capped at UNCLASSED_DETAIL_MAX_CHARS) as its detail -- the other\n189\t        class that carries a detail, since every remaining class's\n190\t        evidence already lives in refusal, halted, forge_checks, or the\n191\t        log itself.\n192\t    \"\"\"\n193\t    if status == \"pass\":\n194\t        return None\n195\t    if status == \"returned\":\n196\t        return {\"class\": \"forge-unconcluded\", \"provenance\": \"tenant\", \"detail\": None}\n197\t    if report_class in STOP_CLASSES:\n198\t        return {\"class\": report_class, \"provenance\": \"executor\", \"detail\": None}\n199\t    question = (halted or {}).get(\"question\")\n200\t    if status == \"halted\" and question:\n201\t        return {\"class\": \"question\", \"provenance\": \"spec\",\n202\t               \"detail\": question.splitlines()[0]}\n203\t    known = _carries_a_known_class(refusal) or _carries_a_known_class(log)\n204\t    if known:\n205\t        return {\"class\": known, \"provenance\": \"executor\", \"detail\": None}\n206\t    if status == \"refused\" and refusal is not None and not refusal.startswith(\"commit \"):\n207\t        return {\"class\": \"claims-boundary\", \"provenance\": refusal_provenance or \"spec\",\n208\t               \"detail\": None}\n209\t    if log and any(marker in log.lower() for marker in CEILING_MARKERS):\n210\t        return {\"class\": \"ceiling\", \"provenance\": \"product\", \"detail\": None}\n211\t    return {\"class\": \"unclassed\", \"provenance\": \"product\", \"detail\": _log_last_line(log)}\n212\t\n213\t\n214\tdef gate_stop(refusal: str | None) -> Stop:\n215\t    \"\"\"The stop for a refused spec-gate record: class \"gate\", provenance\n216\t    \"spec\", the refusal string itself as cause (issue #137) -- not\n217\t    derive_stop's generic claims-boundary/spec fallback issue #133\n218\t    reused, which named a boundary the record never crossed: \"criterion\n219\t    fails against the tree plus stub: doctor-template-absent.sh\" is not\n220\t    a write outside claims. cmd_spec_gate is untouched by this lane, so\n221\t    a spec record still carries no stop field of its own; this is\n222\t    synthesized wherever a refused one is read (item_stops,\n223\t    cmd_file_stops, proof_no_stop_lacks_cause), never persisted.\"\"\"\n224\t    return {\"class\": \"gate\", \"provenance\": \"spec\", \"detail\": refusal}\n225\t\n226\t\n227\t# --- stops: every non-pass record by class, provenance, and answerer\n228\t# (issue #129) ---\n229\t\n230\tdef item_stops(root: Path, m: dict[str, Any], item_id: str) -> dict[str, Any]:\n231\t    \"\"\"{\"item\", \"rows\", \"totals\"}: one row per non-pass build or verify\n232\t    record (STOP_STAGES), plus every refused spec-gate record (issue\n233\t    #133), class \"gate\" (issue #137) -- read from status and refusal\n234\t    rather than a stop field spec-gate records never carry (gate_stop\n235\t    synthesizes it) -- under item_id, whatever the record's own\n236\t    record_version -- a record too old to carry stop at all still gets\n237\t    a row, its class printed as the doctor's own phrase for it.\n238\t\n239\t    The answerer, a closed choice: \"counsel:<verdict>\" when\n240\t    counsel_record_for finds a counsel record naming this exact stage and\n241\t    number -- the product's own answer, which wins over whatever the stop\n242\t    itself says, since a counseled stop was already read once; failing\n243\t    that, \"person\" for class question (a person's to answer, not a\n244\t    guard's); failing that, \"guard\" for a class in GUARDED_STOP_CLASSES\n245\t    (a guard's own rejection needed no further reading); anything else\n246\t    -- no-cause, unclassed, or no stop at all -- is \"none\": nobody has\n247\t    answered it yet.\"\"\"\n248\t    records_rel = m[\"paths\"][\"records\"]\n249\t    item_records_dir = root / records_rel / item_id\n250\t    by_class = {c: 0 for c in stop_class_enum()}\n251\t    by_answerer: dict[str, int] = {}\n252\t    before_stop_was_recorded = 0\n253\t    rows: list[dict[str, Any]] = []\n254\t\n255\t    def add_row(stage: str, n: int, stop: Stop | None) -> None:\n256\t        nonlocal before_stop_was_recorded\n257\t        name = f\"{stage}-{n:02d}\"\n258\t        marker = item_records_dir / f\"{name}.filed\"\n259\t        filed_issue = marker.read_text() if marker.is_file() else None\n260\t        counsel = counsel_record_for(item_records_dir, stage, n)\n261\t\n262\t        if counsel is not None:\n263\t            answerer = f\"counsel:{counsel.get('verdict')}\"\n264\t        elif stop and stop.get(\"class\") == \"question\":\n265\t            answerer = \"person\"\n266\t        elif stop and stop.get(\"class\") in GUARDED_STOP_CLASSES:\n267\t            answerer = \"guard\"\n268\t        else:\n269\t            answerer = \"none\"\n270\t\n271\t        if stop:\n272\t            cls, provenance, detail = (stop.get(\"class\"), stop.get(\"provenance\"),\n273\t                                      stop.get(\"detail\"))\n274\t            if cls in by_class:\n275\t                by_class[cls] += 1\n276\t        else:\n277\t            cls, provenance, detail = \"before stop was recorded\", None, None\n278\t            before_stop_was_recorded += 1\n279\t\n280\t        by_answerer[answerer] = by_answerer.get(answerer, 0) + 1\n281\t        rows.append({\"item\": item_id, \"record\": name, \"class\": cls,\n282\t                    \"provenance\": provenance, \"detail\": detail,\n283\t                    \"answerer\": answerer, \"filed_issue\": filed_issue})\n284\t\n285\t    if item_records_dir.is_dir():\n286\t        for stage in STOP_STAGES:\n287\t            for n, rec in sorted(parse_attempts(item_records_dir, stage).items()):\n288\t                if rec.get(\"status\") == \"pass\":\n289\t                    continue\n290\t                add_row(stage, n, rec.get(\"stop\"))\n291\t        for n, rec in sorted(parse_attempts(item_records_dir, \"spec\").items()):\n292\t            if rec.get(\"status\") != \"refused\":\n293\t                continue\n294\t            add_row(\"spec\", n, gate_stop(rec.get(\"refusal\")))\n295\t\n296\t    totals = {\"by_class\": by_class, \"by_answerer\": by_answerer,\n297\t             \"before_stop_was_recorded\": before_stop_was_recorded}\n298\t    return {\"item\": item_id, \"rows\": rows, \"totals\": totals}\n299\t\n300\t\n301\tdef cmd_stops(argv: list[str]) -> int:\n302\t    as_json = \"--json\" in argv\n303\t    positional = [a for a in argv if a != \"--json\"]\n304\t    root = Path(\".\").resolve()\n305\t    m = read_manifest(root)\n306\t    if m is None:\n307\t        print(f\"attavo stops: no {MANIFEST} at {root}\", file=sys.stderr)\n308\t        return 2\n309\t\n310\t    records_rel = m[\"paths\"][\"records\"]\n311\t    if positional:\n312\t        item_ids = [positional[0]]\n313\t    else:\n314\t        records_root = root / records_rel\n315\t        item_ids = (sorted((p.name for p in records_root.iterdir() if p.is_dir()))\n316\t                   if records_root.is_dir() else [])\n317\t\n318\t    reports = [item_stops(root, m, item_id) for item_id in item_ids]\n319\t\n320\t    if as_json:\n321\t        if positional:\n322\t            print(json.dumps(reports[0], indent=2))\n323\t        else:\n324\t            print(json.dumps({\"items\": reports}, indent=2))\n325\t        return 0\n326\t\n327\t    for entry in reports:\n328\t        print(f\"attavo stops: item {entry['item']}\")\n329\t        for row in entry[\"rows\"]:\n330\t            filed = f\"  filed: {row['filed_issue'].strip()}\" if row[\"filed_issue\"] else \"\"\n331\t            print(f\"  {row['record']:<10} {row['class']:<24} {row['provenance'] or '-':<10} \"\n332\t                 f\"{row['answerer']:<16}{filed}\")\n333\t        t = entry[\"totals\"]\n334\t        print(f\"  by class: {t['by_class']}\")\n335\t        print(f\"  by answerer: {t['by_answerer']}\")\n336\t        print(f\"  before stop was recorded: {t['before_stop_was_recorded']}\")\n337\t    if not reports:\n338\t        print(f\"attavo stops: no item found under {records_rel}\")\n339\t    return 0\n340\t\n341\t\n342\t# The stop classes issue #89 gave no code of their own beyond the guard\n343\t# that raised them -- non-question and outlived-invocation from an\n344\t# adapter's own pre-emptive refusal, forge-unconcluded from a returned\n345\t# verify, ceiling from a declared-input-limit error, claims-boundary from\n346\t# the write-outside-claims refusal, repeated-act from... the same shape,\n347\t# environment from cmd_build's own [checks].command preflight (issue\n348\t# #115). question (a person's to answer) and the residual (no-cause,\n349\t# unclassed -- nobody has looked yet) are not in this tuple; attavo stops\n350\t# (issue #129) is the one reader, so it lives beside driver_identity,\n351\t# not beside derive_stop, which never needs to tell a guard from any\n352\t# other class once it has already named one.\n353\tGUARDED_STOP_CLASSES = (\"non-question\", \"outlived-invocation\", \"forge-unconcluded\", \"ceiling\",\n354\t                        \"claims-boundary\", \"repeated-act\", \"environment\")\n355\t\n356\t\n357\tdef stop_class_enum() -> tuple[str, ...]:\n358\t    \"\"\"Every class a stop can name, read from the build record schema's own\n359\t    enum (issue #129) rather than retyped -- STOP_CLASSES already drifted\n360\t    once (environment arrived in the schema before anything but derive_stop\n361\t    read it); a second copy is a second place to forget. build's schema is\n362\t    read, not verify's: verify's own enum is a strict subset (it never\n363\t    raises environment, cmd_build's own preflight alone).\"\"\"\n364\t    schema = stage_schema(\"build\")\n365\t    return tuple(schema[\"properties\"][\"stop\"][\"properties\"][\"class\"][\"enum\"])\n366\t\n367\t\n368\tSTOP_STAGES = (\"build\", \"verify\")\n369\t\n370\t\n371\tdef counsel_record_for(item_records_dir: Path, stage: str, n: int) -> CounselRecord | None:\n372\t    \"\"\"The latest counsel-NN.json (issue #100) whose own \"record\" field\n373\t    names f\"{stage}-{n:02d}\" -- the counsel invocation, if any, that read\n374\t    this exact stage record -- or None when counsel never ran against it\n375\t    (e.g. file-stops run standalone, outside drive).\"\"\"\n376\t    target = f\"{stage}-{n:02d}\"\n377\t    attempts = parse_attempts(item_records_dir, \"counsel\")\n378\t    matches = [rec for _, rec in sorted(attempts.items()) if rec.get(\"record\") == target]\n379\t    return matches[-1] if matches else None\n380\t"}]},"parent_tool_use_id":null,"session_id":"ec2614fd-fe76-497e-a0f4-348a6650b419","uuid":"9af33c65-8a0b-4871-873d-841404438d15","timestamp":"2026-09-27T15:42:07.179Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-229/attavo/stops.py","content":"from __future__ import annotations\n\nimport json\nimport re\nimport sys\nfrom pathlib import Path\nfrom typing import Any\n\nfrom attavo.common import MANIFEST, read_manifest\nfrom attavo.records import parse_attempts, stage_schema\nfrom attavo.types import CounselRecord, Stop\n\n# --- stop: every non-pass build or verify record's class and cause (issue\n# #89) -- derived here, at write time, from the refusal, halted, and log\n# the caller already has. Never a fresh read of anything: the tenant zero\n# specimens this retires (#576 build-11, #659 build-01 and verify-01) are\n# exactly a stop the product wrote with nothing beside it to explain\n# itself after the fact. ---\n\nSTOP_CLASSES = (\"non-question\", \"outlived-invocation\", \"no-cause\", \"forge-unconcluded\",\n               \"ceiling\", \"claims-boundary\", \"repeated-act\", \"unclassed\", \"question\",\n               \"environment\", \"gate\", \"died\", \"hung\", \"transient\", \"returned\", \"empty\")\n\n# R3: the four families a pass retries with no person involved -- every\n# other class is counsel's to read first, and a person's when counsel says\n# so (or when counsel is not configured at all).\nRETRYABLE_CLASSES = (\"died\", \"hung\", \"transient\", \"returned\")\n\n\ndef signature_of(text: str | None) -> str | None:\n    \"\"\"R3: a failure's signature, compared between attempts by plain string\n    equality -- text with every run of digits removed, so two stops that\n    differ only in a pid, a timestamp, or a retry-after count still match.\n    None for no text at all (nothing to sign).\"\"\"\n    if not text:\n        return None\n    stripped = re.sub(r\"[0-9]+\", \"\", text).strip()\n    return stripped or None\n\n\nSTOP_PROVENANCES = (\"product\", \"tenant\", \"executor\", \"spec\")\n\n# Beyond the enum spelling itself, the prose issue #88 actually shipped\n# (adapters/claude-code/run and adapters/codex/run, on main since\n# v0.16.0) once put a class's own name, or a real specimen's wording of\n# it, in the transcript for the generic match below to find. Issue #94\n# moves non-question and outlived-invocation onto report_class instead\n# (below): non-question's own halt line (\"halted: class non-question\")\n# would otherwise still satisfy the bare-name match here with no adapter\n# report-line field involved at all, and outlived-invocation's refusal\n# never named its class in text to begin with, so both are disabled here\n# -- the same pattern issue #93 established for ceiling, just below,\n# rather than removed outright.\nCLASS_TEXT_MARKERS: dict[str, tuple[str, ...]] = {\n    \"non-question\": (),\n    \"outlived-invocation\": (),\n    # R3: transient is read from the adapter's own report line\n    # (report_class) below; returned is written directly by the pass or\n    # cmd_verify, never derived from a log's text -- a retried attempt's\n    # feedback file names the prior stop's class in prose, and that text\n    # reaches the next attempt's own transcript, which must not then be\n    # misread as a fresh instance of either class.\n    \"transient\": (),\n    \"returned\": (),\n    # Issue #93: ceiling's own text-based check is CEILING_MARKERS, below,\n    # with provenance \"product\" -- a fact about the tool, not an executor\n    # judgment like non-question/outlived-invocation are. Left at the\n    # default (the class's own name, \"ceiling\"), the generic match above\n    # would instead catch adapters/codex/run's and\n    # adapters/claude-code/run's own pre-emptive refusal -- which must\n    # carry the word \"ceiling\" by the same issue's own brief -- as\n    # provenance \"executor\", before CEILING_MARKERS is ever consulted.\n    \"ceiling\": (),\n    # A genuine question (issue #100's own followups) is read structurally\n    # -- status \"halted\" carrying a non-empty halted.question -- not by\n    # scanning for the literal word \"question\", which the question's own\n    # text very often contains regardless of what it is actually asking.\n    # Left at the default, the generic match above would misclassify any\n    # question that happens to use the word \"question\" as executor\n    # provenance, before the structural check in derive_stop is reached.\n    \"question\": (),\n    # environment/tenant (issue #115) is set directly by cmd_build's own\n    # preflight -- the one caller who knows a [checks].command exited 2\n    # on the approved tree -- never derived from adapter text. Left at\n    # the default, the generic match above would catch the word\n    # \"environment\" anywhere in a log or refusal (e.g. codex's own\n    # OPENAI_API_KEY auth-mismatch refusal, adapters/codex/run's\n    # check_auth) as an environment/executor stop that never happened.\n    \"environment\": (),\n}\n\n# Known tool error text for a declared ceiling -- issue #86's own specimen\n# (codex's \"Input exceeds...\" line on a diff too large to judge) is\n# \"input_too_large\"; a matching line anywhere in the log, not only its\n# last line, since cmd_build and cmd_verify both append \"[adapter exited\n# N]\" after whatever the tool itself printed. \"ceiling exceeded\" is issue\n# #93's own addition: both adapters now refuse pre-emptively, before the\n# tool is ever invoked, against a declared or fixed input limit, and\n# their refusal text is not caught by any of the three markers above.\nCEILING_MARKERS = (\"input_too_large\", \"exceeds the maximum context length\",\n                  \"context_length_exceeded\", \"ceiling exceeded\")\n\n\n# Issue #100's followups: an unclassed detail is the log's last line\n# verbatim, and that line is sometimes an adapter's own event JSON or a\n# tool's full error text -- thousands of characters wide. Capped here,\n# at write time, so a filed issue's own summary of it (file-stops'\n# log_tail already carries the full picture) stays short; the class\n# itself, \"unclassed\", already says the full explanation lives in the\n# log, not in this field.\nUNCLASSED_DETAIL_MAX_CHARS = 200\n\n\ndef _log_last_line(log: str | None) -> str:\n    lines = [l for l in (log or \"\").splitlines() if l.strip()]\n    last = lines[-1] if lines else \"\"\n    return last[:UNCLASSED_DETAIL_MAX_CHARS]\n\n\ndef _carries_a_known_class(text: str | None) -> str | None:\n    \"\"\"Whichever of STOP_CLASSES this text names -- its own spelling, or\n    one of CLASS_TEXT_MARKERS' real-world phrasings of it, when that\n    class is not disabled there -- or None. Issue #88 is where an\n    adapter's own halt or refusal first named its class this way; issue\n    #93 added ceiling's own pre-emptive refusal to that set and disabled\n    its bare-name match (CEILING_MARKERS covers it instead); issue #94\n    disables non-question and outlived-invocation the same way, reading\n    both from the adapter's own report line (derive_stop's report_class)\n    now instead.\"\"\"\n    text = text or \"\"\n    for name in STOP_CLASSES:\n        markers = CLASS_TEXT_MARKERS.get(name, (name,))\n        if any(marker in text for marker in markers):\n            return name\n    return None\n\n\ndef derive_stop(status: str, *, refusal: str | None = None, halted: dict[str, Any] | None = None,\n                log: str | None = None, report_class: str | None = None,\n                refusal_provenance: str | None = None) -> Stop | None:\n    \"\"\"The stop field for a build or verify record: None for status \"pass\",\n    else {class, provenance, detail} from what the caller already knows.\n\n      - report_class -- payload.get(\"class\") off the adapter's own report\n        line (issue #88, #94), when it names a STOP_CLASSES member -- is\n        that class, provenance \"executor\". build.schema.json and\n        verify.schema.json stay untouched by issue #88 on purpose, so the\n        class lives only on the report line, never a structured field\n        cmd_build or cmd_verify forwards on its own account; the caller\n        reads payload itself and passes this in, since only it still has\n        payload once an iteration ends. This is non-question's and\n        outlived-invocation's only path to a record now (issue #94):\n        CLASS_TEXT_MARKERS disables both for the text scan below, the\n        same way issue #93 disabled ceiling's bare-name match there. A\n        class an adapter does not yet put on its report line --\n        outlived-invocation today, since that refusal path prints no\n        report line at all -- falls to unclassed below, same as any\n        other unnamed cause, until the adapter that raises it puts a\n        class on the line the way non-question already does.\n      - a halt carrying a non-empty halted.question, once it is not a\n        non-question caught above, is a genuine question -- question/spec,\n        with the question's own first line as detail (issue #100's\n        followups). This is the specimen issue #100 itself was built to\n        retire: tenant zero's #663 build-01, a proper question, classed\n        unclassed/product and filed as a product defect with the wrong\n        provenance -- a question is about the definition of done, which is\n        a person's or a ruling's to answer, never the product's own\n        mechanism.\n      - failing that, a refusal or the log itself that already names its\n        class in text (issue #88, #93 for ceiling's own pre-emptive\n        refusal) is that class, provenance \"executor\" -- the log is\n        checked because neither adapter's refusal *field* carries the\n        class today; the class-naming line each adapter prints reaches\n        only the transcript\n      - a refusal that is not that -- the write-outside-claims path\n        itself, not the \"commit ... not authored by the executor\" shape\n        -- is claims-boundary/spec, unless the caller already knows this\n        refusal touched paths.records or paths.specs (issue #140:\n        protected_path_touched, checked ahead of the ordinary claims\n        match in cmd_build) and passes refusal_provenance=\"executor\" --\n        the product's own directories are not a claim a spec makes, so a\n        refusal there is not the spec's boundary to answer for\n      - a returned verify (the forge was not green; no adapter ran) is\n        forge-unconcluded/tenant\n      - an adapter exit whose log carries a declared-ceiling error line is\n        ceiling/product\n      - anything else is unclassed/product, with the log's last line\n        (capped at UNCLASSED_DETAIL_MAX_CHARS) as its detail -- the other\n        class that carries a detail, since every remaining class's\n        evidence already lives in refusal, halted, forge_checks, or the\n        log itself.\n    \"\"\"\n    if status == \"pass\":\n        return None\n    if status == \"returned\":\n        return {\"class\": \"forge-unconcluded\", \"provenance\": \"tenant\", \"detail\": None}\n    if report_class in STOP_CLASSES:\n        return {\"class\": report_class, \"provenance\": \"executor\", \"detail\": None}\n    question = (halted or {}).get(\"question\")\n    if status == \"halted\" and question:\n        return {\"class\": \"question\", \"provenance\": \"spec\",\n               \"detail\": question.splitlines()[0]}\n    known = _carries_a_known_class(refusal) or _carries_a_known_class(log)\n    if known:\n        return {\"class\": known, \"provenance\": \"executor\", \"detail\": None}\n    if status == \"refused\" and refusal is not None and not refusal.startswith(\"commit \"):\n        return {\"class\": \"claims-boundary\", \"provenance\": refusal_provenance or \"spec\",\n               \"detail\": None}\n    if log and any(marker in log.lower() for marker in CEILING_MARKERS):\n        return {\"class\": \"ceiling\", \"provenance\": \"product\", \"detail\": None}\n    return {\"class\": \"unclassed\", \"provenance\": \"product\", \"detail\": _log_last_line(log)}\n\n\ndef gate_stop(refusal: str | None) -> Stop:\n    \"\"\"The stop for a refused spec-gate record: class \"gate\", provenance\n    \"spec\", the refusal string itself as cause (issue #137) -- not\n    derive_stop's generic claims-boundary/spec fallback issue #133\n    reused, which named a boundary the record never crossed: \"criterion\n    fails against the tree plus stub: doctor-template-absent.sh\" is not\n    a write outside claims. cmd_spec_gate is untouched by this lane, so\n    a spec record still carries no stop field of its own; this is\n    synthesized wherever a refused one is read (item_stops,\n    cmd_file_stops, proof_no_stop_lacks_cause), never persisted.\"\"\"\n    return {\"class\": \"gate\", \"provenance\": \"spec\", \"detail\": refusal}\n\n\n# --- stops: every non-pass record by class, provenance, and answerer\n# (issue #129) ---\n\ndef item_stops(root: Path, m: dict[str, Any], item_id: str) -> dict[str, Any]:\n    \"\"\"{\"item\", \"rows\", \"totals\"}: one row per non-pass build or verify\n    record (STOP_STAGES), plus every refused spec-gate record (issue\n    #133), class \"gate\" (issue #137) -- read from status and refusal\n    rather than a stop field spec-gate records never carry (gate_stop\n    synthesizes it) -- under item_id, whatever the record's own\n    record_version -- a record too old to carry stop at all still gets\n    a row, its class printed as the doctor's own phrase for it.\n\n    The answerer, a closed choice: \"counsel:<verdict>\" when\n    counsel_record_for finds a counsel record naming this exact stage and\n    number -- the product's own answer, which wins over whatever the stop\n    itself says, since a counseled stop was already read once; failing\n    that, \"person\" for class question (a person's to answer, not a\n    guard's); failing that, \"guard\" for a class in GUARDED_STOP_CLASSES\n    (a guard's own rejection needed no further reading); anything else\n    -- no-cause, unclassed, or no stop at all -- is \"none\": nobody has\n    answered it yet.\"\"\"\n    records_rel = m[\"paths\"][\"records\"]\n    item_records_dir = root / records_rel / item_id\n    by_class = {c: 0 for c in stop_class_enum()}\n    by_answerer: dict[str, int] = {}\n    before_stop_was_recorded = 0\n    rows: list[dict[str, Any]] = []\n\n    def add_row(stage: str, n: int, stop: Stop | None) -> None:\n        nonlocal before_stop_was_recorded\n        name = f\"{stage}-{n:02d}\"\n        marker = item_records_dir / f\"{name}.filed\"\n        filed_issue = marker.read_text() if marker.is_file() else None\n        counsel = counsel_record_for(item_records_dir, stage, n)\n\n        if counsel is not None:\n            answerer = f\"counsel:{counsel.get('verdict')}\"\n        elif stop and stop.get(\"class\") == \"question\":\n            answerer = \"person\"\n        elif stop and stop.get(\"class\") in GUARDED_STOP_CLASSES:\n            answerer = \"guard\"\n        else:\n            answerer = \"none\"\n\n        if stop:\n            cls, provenance, detail = (stop.get(\"class\"), stop.get(\"provenance\"),\n                                      stop.get(\"detail\"))\n            if cls in by_class:\n                by_class[cls] += 1\n        else:\n            cls, provenance, detail = \"before stop was recorded\", None, None\n            before_stop_was_recorded += 1\n\n        by_answerer[answerer] = by_answerer.get(answerer, 0) + 1\n        rows.append({\"item\": item_id, \"record\": name, \"class\": cls,\n                    \"provenance\": provenance, \"detail\": detail,\n                    \"answerer\": answerer, \"filed_issue\": filed_issue})\n\n    if item_records_dir.is_dir():\n        for stage in STOP_STAGES:\n            for n, rec in sorted(parse_attempts(item_records_dir, stage).items()):\n                if rec.get(\"status\") == \"pass\":\n                    continue\n                add_row(stage, n, rec.get(\"stop\"))\n        for n, rec in sorted(parse_attempts(item_records_dir, \"spec\").items()):\n            if rec.get(\"status\") != \"refused\":\n                continue\n            add_row(\"spec\", n, gate_stop(rec.get(\"refusal\")))\n\n    totals = {\"by_class\": by_class, \"by_answerer\": by_answerer,\n             \"before_stop_was_recorded\": before_stop_was_recorded}\n    return {\"item\": item_id, \"rows\": rows, \"totals\": totals}\n\n\ndef cmd_stops(argv: list[str]) -> int:\n    as_json = \"--json\" in argv\n    positional = [a for a in argv if a != \"--json\"]\n    root = Path(\".\").resolve()\n    m = read_manifest(root)\n    if m is None:\n        print(f\"attavo stops: no {MANIFEST} at {root}\", file=sys.stderr)\n        return 2\n\n    records_rel = m[\"paths\"][\"records\"]\n    if positional:\n        item_ids = [positional[0]]\n    else:\n        records_root = root / records_rel\n        item_ids = (sorted((p.name for p in records_root.iterdir() if p.is_dir()))\n                   if records_root.is_dir() else [])\n\n    reports = [item_stops(root, m, item_id) for item_id in item_ids]\n\n    if as_json:\n        if positional:\n            print(json.dumps(reports[0], indent=2))\n        else:\n            print(json.dumps({\"items\": reports}, indent=2))\n        return 0\n\n    for entry in reports:\n        print(f\"attavo stops: item {entry['item']}\")\n        for row in entry[\"rows\"]:\n            filed = f\"  filed: {row['filed_issue'].strip()}\" if row[\"filed_issue\"] else \"\"\n            print(f\"  {row['record']:<10} {row['class']:<24} {row['provenance'] or '-':<10} \"\n                 f\"{row['answerer']:<16}{filed}\")\n        t = entry[\"totals\"]\n        print(f\"  by class: {t['by_class']}\")\n        print(f\"  by answerer: {t['by_answerer']}\")\n        print(f\"  before stop was recorded: {t['before_stop_was_recorded']}\")\n    if not reports:\n        print(f\"attavo stops: no item found under {records_rel}\")\n    return 0\n\n\n# The stop classes issue #89 gave no code of their own beyond the guard\n# that raised them -- non-question and outlived-invocation from an\n# adapter's own pre-emptive refusal, forge-unconcluded from a returned\n# verify, ceiling from a declared-input-limit error, claims-boundary from\n# the write-outside-claims refusal, repeated-act from... the same shape,\n# environment from cmd_build's own [checks].command preflight (issue\n# #115). question (a person's to answer) and the residual (no-cause,\n# unclassed -- nobody has looked yet) are not in this tuple; attavo stops\n# (issue #129) is the one reader, so it lives beside driver_identity,\n# not beside derive_stop, which never needs to tell a guard from any\n# other class once it has already named one.\nGUARDED_STOP_CLASSES = (\"non-question\", \"outlived-invocation\", \"forge-unconcluded\", \"ceiling\",\n                        \"claims-boundary\", \"repeated-act\", \"environment\")\n\n\ndef stop_class_enum() -> tuple[str, ...]:\n    \"\"\"Every class a stop can name, read from the build record schema's own\n    enum (issue #129) rather than retyped -- STOP_CLASSES already drifted\n    once (environment arrived in the schema before anything but derive_stop\n    read it); a second copy is a second place to forget. build's schema is\n    read, not verify's: verify's own enum is a strict subset (it never\n    raises environment, cmd_build's own preflight alone).\"\"\"\n    schema = stage_schema(\"build\")\n    return tuple(schema[\"properties\"][\"stop\"][\"properties\"][\"class\"][\"enum\"])\n\n\nSTOP_STAGES = (\"build\", \"verify\")\n\n\ndef counsel_record_for(item_records_dir: Path, stage: str, n: int) -> CounselRecord | None:\n    \"\"\"The latest counsel-NN.json (issue #100) whose own \"record\" field\n    names f\"{stage}-{n:02d}\" -- the counsel invocation, if any, that read\n    this exact stage record -- or None when counsel never ran against it\n    (e.g. file-stops run standalone, outside drive).\"\"\"\n    target = f\"{stage}-{n:02d}\"\n    attempts = parse_attempts(item_records_dir, \"counsel\")\n    matches = [rec for _, rec in sorted(attempts.items()) if rec.get(\"record\") == target]\n    return matches[-1] if matches else None\n","numLines":380,"startLine":1,"totalLines":380}}}

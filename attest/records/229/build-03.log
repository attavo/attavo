{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013Bttucnm1RobsSJje4kC4f","type":"tool_result","content":"1\tfrom __future__ import annotations\n2\t\n3\timport os\n4\timport re\n5\timport subprocess\n6\timport tomllib\n7\tfrom datetime import datetime, timezone\n8\tfrom pathlib import Path\n9\tfrom typing import Any\n10\t\n11\tMANIFEST = \"attavo.toml\"\n12\t\n13\tSTAGES = (\"spec\", \"approval\", \"build\", \"verify\")\n14\t\n15\t\n16\tPRODUCT_ROOT = Path(__file__).resolve().parent.parent\n17\t\n18\t\n19\tclass Proof:\n20\t    def __init__(self, key: str, title: str) -> None:\n21\t        self.key = key\n22\t        self.title = title\n23\t        self.holds = False\n24\t        self.reason = \"\"\n25\t        self.extra: dict[str, Any] = {}\n26\t\n27\t    def fail(self, reason: str, **extra: Any) -> \"Proof\":\n28\t        self.holds, self.reason = False, reason\n29\t        self.extra.update(extra)\n30\t        return self\n31\t\n32\t    def hold(self, reason: str, **extra: Any) -> \"Proof\":\n33\t        self.holds, self.reason = True, reason\n34\t        self.extra.update(extra)\n35\t        return self\n36\t\n37\t    def as_dict(self) -> dict[str, Any]:\n38\t        return {\"proof\": self.key, \"title\": self.title,\n39\t                \"holds\": self.holds, \"reason\": self.reason, **self.extra}\n40\t\n41\t\n42\tdef read_manifest(root: Path) -> dict[str, Any] | None:\n43\t    path = root / MANIFEST\n44\t    if not path.is_file():\n45\t        return None\n46\t    with path.open(\"rb\") as fh:\n47\t        return tomllib.load(fh)\n48\t\n49\t\n50\tdef git(root: Path, *args: str, env: dict[str, str] | None = None) -> str:\n51\t    out = subprocess.run([\"git\", \"-C\", str(root), *args],\n52\t                         capture_output=True, text=True, check=False, env=env)\n53\t    if out.returncode != 0:\n54\t        raise RuntimeError(out.stderr.strip() or \"git failed\")\n55\t    return out.stdout\n56\t\n57\t\n58\tdef product_version() -> str:\n59\t    \"\"\"What the running program is. Three fallbacks, in order, and never an\n60\t    exception -- this runs inside write_record, after the work it\n61\t    describes already happened, and a raise here would lose the record\n62\t    for an invocation that already ran:\n63\t\n64\t      1. ATTAVO_PRODUCT_VERSION, when the environment sets it. The forge\n65\t         action sets this from its own ref (action.yml, not here -- this\n66\t         function stays forge-agnostic).\n67\t      2. git describe --tags --always --dirty against PRODUCT_ROOT: a\n68\t         tagged release reports its tag, a checkout reports its commit,\n69\t         a dirty tree says so.\n70\t      3. \"unknown\", when PRODUCT_ROOT is not a git repository at all --\n71\t         the case for a forge that extracts this action from a tarball\n72\t         rather than a git checkout, which is exactly when (1) is\n73\t         expected to already have supplied the answer.\n74\t\n75\t    Distinct from the tenant's product_pin -- an operator running a\n76\t    checkout, which is how every build and verify have actually been run\n77\t    so far, bypasses the pin entirely (issue #49).\"\"\"\n78\t    env = os.environ.get(\"ATTAVO_PRODUCT_VERSION\")\n79\t    if env:\n80\t        return env\n81\t    try:\n82\t        return git(PRODUCT_ROOT, \"describe\", \"--tags\", \"--always\", \"--dirty\").strip()\n83\t    except RuntimeError:\n84\t        return \"unknown\"\n85\t\n86\t\n87\tdef now_iso() -> str:\n88\t    return datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n89\t\n90\t\n91\tdef derive_item_id(root: Path) -> str | None:\n92\t    \"\"\"ATTAVO_ITEM first, not last: a rejection fixture's own item id must\n93\t    win over whatever attavo/N-* branch the enclosing tenant repository\n94\t    happens to be checked out on -- the common case is doctor running from\n95\t    a real item's own branch, where a fallback-only env var would never be\n96\t    consulted at all and every gate fixture would silently resolve to the\n97\t    real item instead of its own.\"\"\"\n98\t    env_item = os.environ.get(\"ATTAVO_ITEM\")\n99\t    if env_item:\n100\t        return env_item\n101\t    out = subprocess.run([\"git\", \"-C\", str(root), \"rev-parse\", \"--abbrev-ref\", \"HEAD\"],\n102\t                         capture_output=True, text=True, check=False)\n103\t    branch = out.stdout.strip()\n104\t    m = re.match(r\"^attavo/(\\d+)-\", branch)\n105\t    return m.group(1) if m else None\n106\t\n107\t\n108\tdef fixture_item_id(fixture: Path) -> str | None:\n109\t    \"\"\"The one item id under a rejection fixture's own paths.specs, so the\n110\t    doctor can export it as ATTAVO_ITEM: a fixture carries no attavo/N-*\n111\t    branch for a gate command with no argument to derive from otherwise.\"\"\"\n112\t    fm = read_manifest(fixture)\n113\t    specs_rel = ((fm or {}).get(\"paths\") or {}).get(\"specs\")\n114\t    if not specs_rel:\n115\t        return None\n116\t    specs_dir = fixture / specs_rel\n117\t    if not specs_dir.is_dir():\n118\t        return None\n119\t    items = sorted(p.name for p in specs_dir.iterdir() if p.is_dir())\n120\t    return items[0] if len(items) == 1 else None\n121\t\n122\t\n123\tclass ShallowCheckoutError(RuntimeError):\n124\t    pass\n125\t\n126\t\n127\tdef last_commit_touching(root: Path, relpath: str) -> str | None:\n128\t    shallow = subprocess.run([\"git\", \"-C\", str(root), \"rev-parse\", \"--is-shallow-repository\"],\n129\t                             capture_output=True, text=True, check=False)\n130\t    if shallow.stdout.strip() == \"true\":\n131\t        raise ShallowCheckoutError(\n132\t            \"shallow checkout: git log -1 -- <path> returns HEAD for every path on a \"\n133\t            \"shallow clone; check out with fetch-depth: 0\")\n134\t    out = subprocess.run([\"git\", \"-C\", str(root), \"log\", \"-1\", \"--format=%H\", \"--\", relpath],\n135\t                         capture_output=True, text=True, check=False)\n136\t    sha = out.stdout.strip()\n137\t    return sha or None\n138\t"}]},"parent_tool_use_id":null,"session_id":"ec2614fd-fe76-497e-a0f4-348a6650b419","uuid":"1b5197f4-170a-48e3-84a8-735a162e218e","timestamp":"2026-09-27T15:38:27.226Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-229/attavo/common.py","content":"from __future__ import annotations\n\nimport os\nimport re\nimport subprocess\nimport tomllib\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom typing import Any\n\nMANIFEST = \"attavo.toml\"\n\nSTAGES = (\"spec\", \"approval\", \"build\", \"verify\")\n\n\nPRODUCT_ROOT = Path(__file__).resolve().parent.parent\n\n\nclass Proof:\n    def __init__(self, key: str, title: str) -> None:\n        self.key = key\n        self.title = title\n        self.holds = False\n        self.reason = \"\"\n        self.extra: dict[str, Any] = {}\n\n    def fail(self, reason: str, **extra: Any) -> \"Proof\":\n        self.holds, self.reason = False, reason\n        self.extra.update(extra)\n        return self\n\n    def hold(self, reason: str, **extra: Any) -> \"Proof\":\n        self.holds, self.reason = True, reason\n        self.extra.update(extra)\n        return self\n\n    def as_dict(self) -> dict[str, Any]:\n        return {\"proof\": self.key, \"title\": self.title,\n                \"holds\": self.holds, \"reason\": self.reason, **self.extra}\n\n\ndef read_manifest(root: Path) -> dict[str, Any] | None:\n    path = root / MANIFEST\n    if not path.is_file():\n        return None\n    with path.open(\"rb\") as fh:\n        return tomllib.load(fh)\n\n\ndef git(root: Path, *args: str, env: dict[str, str] | None = None) -> str:\n    out = subprocess.run([\"git\", \"-C\", str(root), *args],\n                         capture_output=True, text=True, check=False, env=env)\n    if out.returncode != 0:\n        raise RuntimeError(out.stderr.strip() or \"git failed\")\n    return out.stdout\n\n\ndef product_version() -> str:\n    \"\"\"What the running program is. Three fallbacks, in order, and never an\n    exception -- this runs inside write_record, after the work it\n    describes already happened, and a raise here would lose the record\n    for an invocation that already ran:\n\n      1. ATTAVO_PRODUCT_VERSION, when the environment sets it. The forge\n         action sets this from its own ref (action.yml, not here -- this\n         function stays forge-agnostic).\n      2. git describe --tags --always --dirty against PRODUCT_ROOT: a\n         tagged release reports its tag, a checkout reports its commit,\n         a dirty tree says so.\n      3. \"unknown\", when PRODUCT_ROOT is not a git repository at all --\n         the case for a forge that extracts this action from a tarball\n         rather than a git checkout, which is exactly when (1) is\n         expected to already have supplied the answer.\n\n    Distinct from the tenant's product_pin -- an operator running a\n    checkout, which is how every build and verify have actually been run\n    so far, bypasses the pin entirely (issue #49).\"\"\"\n    env = os.environ.get(\"ATTAVO_PRODUCT_VERSION\")\n    if env:\n        return env\n    try:\n        return git(PRODUCT_ROOT, \"describe\", \"--tags\", \"--always\", \"--dirty\").strip()\n    except RuntimeError:\n        return \"unknown\"\n\n\ndef now_iso() -> str:\n    return datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n\n\ndef derive_item_id(root: Path) -> str | None:\n    \"\"\"ATTAVO_ITEM first, not last: a rejection fixture's own item id must\n    win over whatever attavo/N-* branch the enclosing tenant repository\n    happens to be checked out on -- the common case is doctor running from\n    a real item's own branch, where a fallback-only env var would never be\n    consulted at all and every gate fixture would silently resolve to the\n    real item instead of its own.\"\"\"\n    env_item = os.environ.get(\"ATTAVO_ITEM\")\n    if env_item:\n        return env_item\n    out = subprocess.run([\"git\", \"-C\", str(root), \"rev-parse\", \"--abbrev-ref\", \"HEAD\"],\n                         capture_output=True, text=True, check=False)\n    branch = out.stdout.strip()\n    m = re.match(r\"^attavo/(\\d+)-\", branch)\n    return m.group(1) if m else None\n\n\ndef fixture_item_id(fixture: Path) -> str | None:\n    \"\"\"The one item id under a rejection fixture's own paths.specs, so the\n    doctor can export it as ATTAVO_ITEM: a fixture carries no attavo/N-*\n    branch for a gate command with no argument to derive from otherwise.\"\"\"\n    fm = read_manifest(fixture)\n    specs_rel = ((fm or {}).get(\"paths\") or {}).get(\"specs\")\n    if not specs_rel:\n        return None\n    specs_dir = fixture / specs_rel\n    if not specs_dir.is_dir():\n        return None\n    items = sorted(p.name for p in specs_dir.iterdir() if p.is_dir())\n    return items[0] if len(items) == 1 else None\n\n\nclass ShallowCheckoutError(RuntimeError):\n    pass\n\n\ndef last_commit_touching(root: Path, relpath: str) -> str | None:\n    shallow = subprocess.run([\"git\", \"-C\", str(root), \"rev-parse\", \"--is-shallow-repository\"],\n                             capture_output=True, text=True, check=False)\n    if shallow.stdout.strip() == \"true\":\n        raise ShallowCheckoutError(\n            \"shallow checkout: git log -1 -- <path> returns HEAD for every path on a \"\n            \"shallow clone; check out with fetch-depth: 0\")\n    out = subprocess.run([\"git\", \"-C\", str(root), \"log\", \"-1\", \"--format=%H\", \"--\", relpath],\n                         capture_output=True, text=True, check=False)\n    sha = out.stdout.strip()\n    return sha or None\n","numLines":138,"startLine":1,"totalLines":138}}}

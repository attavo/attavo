ATTAVO_STAGE\"] = \"build\"\n477\t            env[\"ATTAVO_EVENTS\"] = str(events_path)\n478\t            env[\"ATTAVO_TEST_COMMAND\"] = f\"python3 {PRODUCT_ROOT / 'bin' / 'attavo'} test {item_id}\"\n479\t            if tests_cfg.get(\"call_timeout_s\"):\n480\t                env[\"ATTAVO_TEST_TIMEOUT_S\"] = str(tests_cfg[\"call_timeout_s\"])\n481\t            else:\n482\t                env.pop(\"ATTAVO_TEST_TIMEOUT_S\", None)\n483\t            env[\"GIT_AUTHOR_NAME\"] = identity[\"name\"]\n484\t            env[\"GIT_AUTHOR_EMAIL\"] = identity[\"email\"]\n485\t            env[\"GIT_COMMITTER_NAME\"] = identity[\"name\"]\n486\t            env[\"GIT_COMMITTER_EMAIL\"] = identity[\"email\"]\n487\t\n488\t            run = subprocess.run([str(adapter_path)], cwd=str(root), env=env,\n489\t                                 capture_output=True, text=True, check=False)\n490\t            transcript, payload = split_adapter_stdout(run.stdout)\n491\t            if run.returncode != 0:\n492\t                # The guarantee behind issue #53's refusal: an adapter that\n493\t                # exits non-zero always leaves a non-empty log, even one\n494\t                # that printed nothing at all on stderr.\n495\t                detail = f\"[adapter exited {run.returncode}]\"\n496\t                if run.stderr.strip():\n497\t                    detail += \"\\n\" + run.stderr.rstrip(\"\\n\")\n498\t                transcript = (transcript + \"\\n\" if transcript else \"\") + detail\n499\t            transcripts.append(transcript)\n500\t\n501\t            if run.returncode != 0 or payload is None or not payload.get(\"model\"):\n502\t                status_out = \"failed\"\n503\t                break\n504\t\n505\t            adapter_version = payload.get(\"adapter_version\")\n506\t            model = payload.get(\"model\")\n507\t            model_version = payload.get(\"model_version\")\n508\t            tok = payload.get(\"tokens\") or {}\n509\t            tokens[\"input\"] += tok.g
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012vwBXoAXi9jj7AXPxJ8YpQ","type":"tool_result","content":"1\t#!/bin/sh\n2\t# adapters/fixture/run -- see ../README.md for the contract. Exists for the\n3\t# tests and the doctor; it is not an executor, and it never writes a record.\n4\tset -eu\n5\t\n6\twrite_name=\"${ATTAVO_FIXTURE_WRITE:-built.txt}\"\n7\t\n8\tif [ -n \"${ATTAVO_FIXTURE_TRANSIENT:-}\" ]; then\n9\t  # R3: a vendor's capacity, rate, or 5xx refusal, classed on the report\n10\t  # line like every class is -- for the rejection fixture only; a real\n11\t  # adapter's own tool reports this on its own transcript, mapped the\n12\t  # same way non-question already is (issue #88).\n13\t  printf '{\"status\":\"failed\",\"question\":null,\"class\":\"transient\",\"detail\":\"%s\",\"model\":\"fixture\",\"model_version\":null,\"adapter_version\":\"fixture-1\",\"tokens\":{\"input\":1,\"output\":1},\"cost_usd\":0.0}\\n' \\\n14\t    \"${ATTAVO_FIXTURE_TRANSIENT}, retry after 30s\"\n15\t  exit 1\n16\tfi\n17\t\n18\tif [ -n \"${ATTAVO_FIXTURE_CEILING_ERROR:-}\" ]; then\n19\t  # issue #89: a tool error line matching a declared ceiling (the\n20\t  # specimen is codex's own \"input_too_large\" on a diff too large to\n21\t  # judge, issue #86) -- for the ceiling/product rejection test only; a\n22\t  # real adapter's own tool prints this, never the adapter itself.\n23\t  echo \"Error: input_too_large: request exceeds the maximum context length\"\n24\t  exit 1\n25\tfi\n26\t\n27\techo \"ATTAVO_ADAPTER_CONFIG=${ATTAVO_ADAPTER_CONFIG:-}\"\n28\techo \"--- ATTAVO_FEEDBACK ---\"\n29\tcat \"${ATTAVO_FEEDBACK:-/dev/null}\" 2>/dev/null || true\n30\techo \"--- end feedback ---\"\n31\t\n32\tif [ -n \"${ATTAVO_EVENTS:-}\" ]; then\n33\t  # issue #26: three canned events, one of each executor kind, so the\n34\t  # conformance suite can assert the shape a real adapter's own mapping\n35\t  # must also produce -- this fixture has no real executor stream to map.\n36\t  at=\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"\n37\t  printf '{\"at\":\"%s\",\"kind\":\"message\",\"text\":\"fixture: starting\"}\\n' \"$at\" >> \"$ATTAVO_EVENTS\"\n38\t  printf '{\"at\":\"%s\",\"kind\":\"tool_call\",\"text\":\"fixture-tool arg1\"}\\n' \"$at\" >> \"$ATTAVO_EVENTS\"\n39\t  printf '{\"at\":\"%s\",\"kind\":\"tool_result\",\"text\":\"ok\"}\\n' \"$at\" >> \"$ATTAVO_EVENTS\"\n40\tfi\n41\t\n42\tif [ \"${ATTAVO_STAGE:-build}\" = \"counsel\" ]; then\n43\t  # issue #100: a read-only reading of a stop -- the record, its log, and\n44\t  # the diff, all handed by path, plus the tenant manifest and this\n45\t  # product's own root. Answers from a canned file\n46\t  # (ATTAVO_FIXTURE_COUNSEL_RESPONSE) when one is set, so a test controls\n47\t  # class/verdict/citations/proposal exactly; otherwise a canned \"person\"\n48\t  # verdict, since a fixture has no rules of its own to answer from.\n49\t  echo \"--- ATTAVO_COUNSEL_RECORD ---\"\n50\t  cat \"${ATTAVO_COUNSEL_RECORD:-/dev/null}\" 2>/dev/null || true\n51\t  echo \"--- end record ---\"\n52\t  echo \"--- ATTAVO_COUNSEL_LOG ---\"\n53\t  cat \"${ATTAVO_COUNSEL_LOG:-/dev/null}\" 2>/dev/null || true\n54\t  echo \"--- end log ---\"\n55\t  echo \"--- ATTAVO_COUNSEL_DIFF ---\"\n56\t  cat \"${ATTAVO_COUNSEL_DIFF:-/dev/null}\" 2>/dev/null || true\n57\t  echo \"--- end diff ---\"\n58\t  echo \"manifest: ${ATTAVO_MANIFEST:-}\"\n59\t  echo \"product root: ${ATTAVO_PRODUCT_ROOT:-}\"\n60\t  if [ -n \"${ATTAVO_FIXTURE_COUNSEL_RESPONSE:-}\" ]; then\n61\t    cat \"${ATTAVO_FIXTURE_COUNSEL_RESPONSE}\"\n62\t    echo\n63\t  else\n64\t    printf '{\"model\":\"fixture\",\"model_version\":null,\"adapter_version\":\"fixture-1\",\"tokens\":{\"input\":1,\"output\":1},\"cost_usd\":0.0,\"class\":\"unclassed\",\"verdict\":\"person\",\"citations\":[],\"proposal\":{\"ruling_text\":null,\"patch\":null,\"question\":\"what should we do about this stop?\"}}\\n'\n65\t  fi\n66\t  exit 0\n67\tfi\n68\t\n69\tif [ \"${ATTAVO_STAGE:-build}\" = \"verify\" ]; then\n70
approval_sha, rec\n    assert rec[\"iterations\"] == 1, rec\n\n\ndef test_an_empty_iteration_is_fed_back_and_a_later_commit_passes(tmp_path: Path) -> None:"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1699,"cache_read_input_tokens":143275,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1699},"output_tokens":5,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"ec2614fd-fe76-497e-a0f4-348a6650b419","uuid":"5ff0891a-7151-405d-86f8-db097ca65b0b","timestamp":"2026-09-27T15:53:59.557Z","request_id":"req_011CfUDMLC6h2zdFhXbMKWXQ","wire_tool_inputs":{"toolu_01VeoVY7uckERxhgh5wxhvdW":{"file_path":"/Users/davidbean/Projects/attavo-worktree-229/tests/test_build.py","old_string":"def test_an_empty_iteration_is_fed_back_and_a_later_commit_passes(tmp_path: Path) -> None:","new_string":"def test_a_retried_attempt_that_adopts_a_prior_valid_commit_needs_no_commit_of_its_own(\n        tmp_path: Path) -> None:\n    \"\"\"Item 229 -- the build-01/counsel-03/build-02 race this item answers:\n    a build whose start_sha already carries a prior attempt's valid\n    commit, inherited from history rather than made by this invocation,\n    is not empty just because this attempt commits nothing of its own.\n    The comparison is against the approval, not this attempt's own\n    start_sha.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    approve_item(root)\n    approval_sha = subprocess.run([\"git\", \"-C\", str(root), \"rev-parse\", \"HEAD\"],\n                                  capture_output=True, text=True, check=True).stdout.strip()\n    # a prior attempt's own valid commit, already on the branch before\n    # this invocation's start_sha -- exactly what build-01 left behind\n    # once its own record, not its commit, was discarded.\n    (root / \"built.txt\").write_text(\"built\\n\")\n    subprocess.run([\"git\", \"-C\", str(root), \"add\", \"built.txt\"], check=True)\n    subprocess.run([\"git\", \"-C\", str(root), \"commit\", \"-q\", \"-m\", \"a prior attempt's own valid commit\"],\n                   check=True)\n\n    run = run_attavo(root, \"build\", \"1\", env={\"ATTAVO_FIXTURE_NO_COMMIT\": \"1\"})\n    assert run.returncode == 0, run.stdout + run.stderr\n    rec = latest_build(root)\n    assert rec[\"status\"] == \"pass\", rec\n    assert rec[\"sha\"] == rec[\"start_sha\"], rec\n    assert rec[\"sha\"] != approval_sha, rec\n    assert rec[\"iterations\"] == 1, rec\n\n\ndef test_an_empty_iteration_is_fed_back_and_a_later_commit_passes(tmp_path: Path) -> None:"}}}

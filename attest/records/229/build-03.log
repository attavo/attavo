{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EjrHiCwHzgvUsfGK5k57NP","type":"tool_result","content":"1\t\"\"\"attavo build: refuse unless approved, invoke the adapter the manifest\n2\tnames, check the claims boundary, run the criteria and the tenant's\n3\tselected tests, iterate on failure up to a budget, and write build-NN.json.\n4\t\n5\tRejection tests, written and run red before the capability existed: on\n6\t`main` at 600abb7 there was no `build` subcommand, so every one of these\n7\tfailed with \"unknown subcommand\".\n8\t\n9\tRun: python3 -m pytest tests -q\n10\t\"\"\"\n11\timport json\n12\timport subprocess\n13\timport sys\n14\tfrom pathlib import Path\n15\tfrom typing import Any, cast\n16\t\n17\timport jsonschema\n18\t\n19\tfrom helpers import commit_all, make_tenant\n20\t\n21\tROOT = Path(__file__).resolve().parent.parent\n22\tATTAVO = ROOT / \"bin\" / \"attavo\"\n23\t\n24\t\n25\tdef run_attavo(root: Path, *args: str, env: dict[str, Any] | None = None) -> subprocess.CompletedProcess[str]:\n26\t    import os\n27\t    full_env = dict(os.environ)\n28\t    if env:\n29\t        full_env.update(env)\n30\t    return subprocess.run([sys.executable, str(ATTAVO), *args], cwd=str(root),\n31\t                          capture_output=True, text=True, check=False, env=full_env)\n32\t\n33\t\n34\tdef builds(root: Path, item: str = \"1\") -> list[Path]:\n35\t    return sorted((root / \"records\" / item).glob(\"build-*.json\"))\n36\t\n37\t\n38\tdef latest_build(root: Path, item: str = \"1\") -> dict[str, Any]:\n39\t    files = builds(root, item)\n40\t    assert files, f\"no build record for item {item}\"\n41\t    return cast(dict[str, Any], json.loads(files[-1].read_text()))\n42\t\n43\t\n44\tdef approve_item(root: Path, item: str = \"1\") -> None:\n45\t    assert run_attavo(root, \"spec-gate\", item).returncode == 0\n46\t    assert run_attavo(root, \"approve\", item, \"--by\", \"alice\").returncode == 0\n47\t\n48\t\n49\tdef events_dir(root: Path
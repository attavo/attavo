{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013ZGSDKrZagjTQnW2XAjSYn","type":"tool_result","content":"900\t    assert not p[\"holds\"]\n901\t    assert \"stall_after_s\" in p[\"reason\"]\n902\t\n903\t\n904\tdef test_doctor_refuses_a_drive_table_without_ceilings(tmp_path: Path) -> None:\n905\t    \"\"\"R3: a [drive] table that declares a stall bound and no\n906\t    [drive.build].ceiling_s or [drive.verify].ceiling_s carries no bound\n907\t    past which a live stage is hung by wall clock -- proof five refuses\n908\t    to guess one, as it refuses to guess the stall bound.\"\"\"\n909\t    root = tmp_path / \"no_ceilings\"\n910\t    root.mkdir()\n911\t    (root / \"attavo.toml\").write_text(\n912\t        '[paths]\\nrecords = \"records\"\\n\\n[drive]\\nstall_after_s = 60\\nattempts = 3\\n')\n913\t    init_repo(root, \"install\")\n914\t\n915\t    records = root / \"records\" / \"1\"\n916\t    records.mkdir(parents=True)\n917\t    (records / \"build-01.json\").write_text(json.dumps({\"status\": \"pass\"}))\n918\t    commit_all(root, \"a drive table with no ceilings\")\n919\t\n920\t    p = run_doctor(root)[\"no-invocation-lacks-record\"]\n921\t    assert not p[\"holds\"]\n922\t    assert \"ceiling\" in p[\"reason\"]\n923\t\n924\t\n925\tdef test_doctor_refuses_a_drive_table_without_attempts(tmp_path: Path) -> None:\n926\t    \"\"\"R3: a [drive] table with both ceilings and a stall bound but no\n927\t    [drive].attempts carries no bound on how many attempts a retryable\n928\t    stop may spend -- proof five refuses to guess a default here too.\"\"\"\n929\t    root = tmp_path / \"no_attempts\"\n930\t    root.mkdir()\n931\t    (root / \"attavo.toml\").write_text(\n932\t        '[paths]\\nrecords = \"records\"\\n\\n[drive]\\nstall_after_s = 60\\n\\n'\n933\t        '[drive.build]\\nceiling_s = 600\\n\\n[drive.verify]\\nceiling_s = 600\\n')\n934\t    init_repo(root, \"install\")\n935\t\n936\t    records = root / \"records\" / \"1\"\n937\t    records.mkdir(parents=True)\n938\t    (records / \"build-01.json\").write_text(json.dumps({\"status\": \"pass\"}))\n939\t    commit_all(root, \"a drive table with no attempts budget\")\n940\t\n941\t    p = run_doctor(root)[\"no-invocation-lacks-record\"]\n942\t    assert not p[\"holds\"]\n943\t    assert \"attempts\" in p[\"reason\"]\n944\t\n945\t\n946\t# --- proof seven: no attested item is empty (item 227). Rejection tests,\n947\t# written red first against v0.29.0, whose doctor had six proofs and held\n948\t# over an attested item whose build committed nothing. ---\n949\t\n950\t\n951\tdef _four_stage_item(root: Path, build: dict[str, Any]) -> str:\n952\t    \"\"\"One item, four records, merged --no-ff; returns the merge sha.\"\"\"\n953\t    subprocess.run([\"git\", \"-C\", str(root), \"checkout\", \"-q\", \"-b\", \"attavo/1-x\"], check=True)\n954\t    records = root / \"records\" / \"1\"\n955\t    records.mkdir(parents=True)\n956\t    (records / \"spec-01.json\").write_text(json.dumps({\"status\": \"pass\"}))\n957\t    (records / \"approval-01.json\").write_text(json.dumps({\"approved_by\": \"alice\"}))\n958\t    (records / \"build-01.json\").write_text(json.dumps(build))\n959\t    (records / \"verify-01.json\").write_text(json.dumps({\"status\": \"pass\"}))\n960\t    commit_all(root, \"spec, approval, build, and verify records\")\n961\t    subprocess.run([\"git\", \"-C\", str(root), \"checkout\", \"-q\", \"main\"], check=True)\n962\t    subprocess.run([\"git\", \"-C\", str(root), \"merge\", \"-q\", \"--no-ff\", \"-m\",\n963\t                    \"Merge branch 'attavo/1-x'\", \"attavo/1-x\"], check=True)\n964\t    return subprocess.run([\"git\", \"-C\", str(root), \"rev-parse\", \"HEAD\"], capture_output=True,\n965\t                          text=True, check=True).stdout.strip()\n966\t\n967\t\n968\tdef test_doctor_proof_seven_fails_on_an_attested_item_whose_build_committed_nothing(tmp_path: Path) -> None:\n969\t    root = tmp_path / \"empty_item\"\n970\t    root.mkdir()\n971\t    (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n')\n972\t    init_repo(root, \"install\")\n973\t    merge = _four_stage_item(root, {\"status\": \"pass\", \"sha\": \"abc123abc123\", \"start_sha\": \"abc123abc123\"})\n974\t    report = run_doctor(root)\n975\t    assert \"no-attested-item-is-empty\" in report, sorted(report)\n976\t    p = report[\"no-attested-item-is-empty\"]\n977\t    assert not p[\"holds\"], p\n978\t    assert \"item 1\" in p[\"reason\"] and \"nothing was built\" in p[\"reason\"] and merge[:12] in p[\"reason\"], p[\"reason\"]\n979\t\n980\t\n981\tdef test_doctor_proof_seven_holds_on_a_build_that_names_a_change_and_names_the_specimen_before_its_window(tmp_path: Path) -> None:\n982\t    built = tmp_path / \"built_item\"\n983\t    built.mkdir()\n984\t    (built / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n')\n985\t    init_repo(built, \"install\")\n986\t    _four_stage_item(built, {\"status\": \"pass\", \"sha\": \"def456def456\", \"start_sha\": \"abc123abc123\"})\n987\t    p = run_doctor(built)[\"no-attested-item-is-empty\"]\n988\t    assert p[\"holds\"], p[\"reason\"]\n989\t    assert p[\"built\"] == [\"1\"], p\n990\t\n991\t    windowed = tmp_path / \"windowed_item\"\n992\t    windowed.mkdir()\n993\t    (windowed / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n')\n994\t    init_repo(windowed, \"install\")\n995\t    merge = _four_stage_item(windowed, {\"status\": \"pass\", \"sha\": \"abc123abc123\", \"start_sha\": \"abc123abc123\"})\n996\t    toml = windowed / \"attavo.toml\"\n997\t    toml.write_text(toml.read_text() + f'\\n[doctor]\\nbuilt_since = \"{merge[:12]}\"\\n')\n998\t    commit_all(windowed, \"declare the window after the specimen\")\n999\t    p = run_doctor(windowed)[\"no-attested-item-is-empty\"]\n1000\t    assert p[\"holds\"], p[\"reason\"]\n1001\t    assert p[\"before_window\"] == [\"1\"] and \"before the window\" in p[\"reason\"], p\n1002\t\n1003\t\n1004\tdef test_no_attested_item_is_empty() -> None:\n1005\t    \"\"\"Proof 7, item 227. On this repository the specimen, #227, is named\n1006\t    before the window ([doctor].built_since) and every later attested\n1007\t    item's build names a change.\"\"\"\n1008\t    p = run_doctor(ROOT)[\"no-attested-item-is-empty\"]\n1009\t    assert p[\"holds\"], p[\"reason\"]\n1010\t"}]},"parent_tool_use_id":null,"session_id":"ec2614fd-fe76-497e-a0f4-348a6650b419","uuid":"c7df5a0c-2309-40e9-a5c9-f630a9f76dc0","timestamp":"2026-09-27T15:42:21.656Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-229/tests/test_doctor.py","content":"    assert not p[\"holds\"]\n    assert \"stall_after_s\" in p[\"reason\"]\n\n\ndef test_doctor_refuses_a_drive_table_without_ceilings(tmp_path: Path) -> None:\n    \"\"\"R3: a [drive] table that declares a stall bound and no\n    [drive.build].ceiling_s or [drive.verify].ceiling_s carries no bound\n    past which a live stage is hung by wall clock -- proof five refuses\n    to guess one, as it refuses to guess the stall bound.\"\"\"\n    root = tmp_path / \"no_ceilings\"\n    root.mkdir()\n    (root / \"attavo.toml\").write_text(\n        '[paths]\\nrecords = \"records\"\\n\\n[drive]\\nstall_after_s = 60\\nattempts = 3\\n')\n    init_repo(root, \"install\")\n\n    records = root / \"records\" / \"1\"\n    records.mkdir(parents=True)\n    (records / \"build-01.json\").write_text(json.dumps({\"status\": \"pass\"}))\n    commit_all(root, \"a drive table with no ceilings\")\n\n    p = run_doctor(root)[\"no-invocation-lacks-record\"]\n    assert not p[\"holds\"]\n    assert \"ceiling\" in p[\"reason\"]\n\n\ndef test_doctor_refuses_a_drive_table_without_attempts(tmp_path: Path) -> None:\n    \"\"\"R3: a [drive] table with both ceilings and a stall bound but no\n    [drive].attempts carries no bound on how many attempts a retryable\n    stop may spend -- proof five refuses to guess a default here too.\"\"\"\n    root = tmp_path / \"no_attempts\"\n    root.mkdir()\n    (root / \"attavo.toml\").write_text(\n        '[paths]\\nrecords = \"records\"\\n\\n[drive]\\nstall_after_s = 60\\n\\n'\n        '[drive.build]\\nceiling_s = 600\\n\\n[drive.verify]\\nceiling_s = 600\\n')\n    init_repo(root, \"install\")\n\n    records = root / \"records\" / \"1\"\n    records.mkdir(parents=True)\n    (records / \"build-01.json\").write_text(json.dumps({\"status\": \"pass\"}))\n    commit_all(root, \"a drive table with no attempts budget\")\n\n    p = run_doctor(root)[\"no-invocation-lacks-record\"]\n    assert not p[\"holds\"]\n    assert \"attempts\" in p[\"reason\"]\n\n\n# --- proof seven: no attested item is empty (item 227). Rejection tests,\n# written red first against v0.29.0, whose doctor had six proofs and held\n# over an attested item whose build committed nothing. ---\n\n\ndef _four_stage_item(root: Path, build: dict[str, Any]) -> str:\n    \"\"\"One item, four records, merged --no-ff; returns the merge sha.\"\"\"\n    subprocess.run([\"git\", \"-C\", str(root), \"checkout\", \"-q\", \"-b\", \"attavo/1-x\"], check=True)\n    records = root / \"records\" / \"1\"\n    records.mkdir(parents=True)\n    (records / \"spec-01.json\").write_text(json.dumps({\"status\": \"pass\"}))\n    (records / \"approval-01.json\").write_text(json.dumps({\"approved_by\": \"alice\"}))\n    (records / \"build-01.json\").write_text(json.dumps(build))\n    (records / \"verify-01.json\").write_text(json.dumps({\"status\": \"pass\"}))\n    commit_all(root, \"spec, approval, build, and verify records\")\n    subprocess.run([\"git\", \"-C\", str(root), \"checkout\", \"-q\", \"main\"], check=True)\n    subprocess.run([\"git\", \"-C\", str(root), \"merge\", \"-q\", \"--no-ff\", \"-m\",\n                    \"Merge branch 'attavo/1-x'\", \"attavo/1-x\"], check=True)\n    return subprocess.run([\"git\", \"-C\", str(root), \"rev-parse\", \"HEAD\"], capture_output=True,\n                          text=True, check=True).stdout.strip()\n\n\ndef test_doctor_proof_seven_fails_on_an_attested_item_whose_build_committed_nothing(tmp_path: Path) -> None:\n    root = tmp_path / \"empty_item\"\n    root.mkdir()\n    (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n')\n    init_repo(root, \"install\")\n    merge = _four_stage_item(root, {\"status\": \"pass\", \"sha\": \"abc123abc123\", \"start_sha\": \"abc123abc123\"})\n    report = run_doctor(root)\n    assert \"no-attested-item-is-empty\" in report, sorted(report)\n    p = report[\"no-attested-item-is-empty\"]\n    assert not p[\"holds\"], p\n    assert \"item 1\" in p[\"reason\"] and \"nothing was built\" in p[\"reason\"] and merge[:12] in p[\"reason\"], p[\"reason\"]\n\n\ndef test_doctor_proof_seven_holds_on_a_build_that_names_a_change_and_names_the_specimen_before_its_window(tmp_path: Path) -> None:\n    built = tmp_path / \"built_item\"\n    built.mkdir()\n    (built / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n')\n    init_repo(built, \"install\")\n    _four_stage_item(built, {\"status\": \"pass\", \"sha\": \"def456def456\", \"start_sha\": \"abc123abc123\"})\n    p = run_doctor(built)[\"no-attested-item-is-empty\"]\n    assert p[\"holds\"], p[\"reason\"]\n    assert p[\"built\"] == [\"1\"], p\n\n    windowed = tmp_path / \"windowed_item\"\n    windowed.mkdir()\n    (windowed / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n')\n    init_repo(windowed, \"install\")\n    merge = _four_stage_item(windowed, {\"status\": \"pass\", \"sha\": \"abc123abc123\", \"start_sha\": \"abc123abc123\"})\n    toml = windowed / \"attavo.toml\"\n    toml.write_text(toml.read_text() + f'\\n[doctor]\\nbuilt_since = \"{merge[:12]}\"\\n')\n    commit_all(windowed, \"declare the window after the specimen\")\n    p = run_doctor(windowed)[\"no-attested-item-is-empty\"]\n    assert p[\"holds\"], p[\"reason\"]\n    assert p[\"before_window\"] == [\"1\"] and \"before the window\" in p[\"reason\"], p\n\n\ndef test_no_attested_item_is_empty() -> None:\n    \"\"\"Proof 7, item 227. On this repository the specimen, #227, is named\n    before the window ([doctor].built_since) and every later attested\n    item's build names a change.\"\"\"\n    p = run_doctor(ROOT)[\"no-attested-item-is-empty\"]\n    assert p[\"holds\"], p[\"reason\"]\n","numLines":111,"startLine":900,"totalLines":1010}}}

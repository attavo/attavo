{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_017qEk5QzNUo7G8wr7d1mvK1","type":"tool_result","content":"860\t    check -- refuses the build before the adapter is ever invoked: class\n861\t    environment, provenance tenant, nothing spent. Regression: item\n862\t    #106's build-01 spent three iterations, 940s, and $1.98 discovering\n863\t    a missing jsonschema import only after the fact, filed\n864\t    unclassed/product; a later change that moves this preflight after\n865\t    the invocation, or drops it, spends a build on a broken environment\n866\t    again.\n867\t    \"\"\"\n868\t    root = make_tenant(tmp_path, \"build_valid\")\n869\t    toml = root / \"attavo.toml\"\n870\t    toml.write_text(toml.read_text()\n871\t                    + '\\n[checks]\\ncommand = \"echo no jsonschema; exit 2\"\\n')\n872\t    commit_all(root, \"configure a broken checks command\")\n873\t    approve_item(root)\n874\t\n875\t    run = run_attavo(root, \"build\", \"1\")\n876\t    assert run.returncode == 1\n877\t\n878\t    rec = latest_build(root)\n879\t    assert rec[\"status\"] == \"refused\"\n880\t    assert rec[\"stop\"] == {\"class\": \"environment\", \"provenance\": \"tenant\",\n881\t                           \"detail\": \"no jsonschema\", \"signature\": \"no jsonschema\",\n882\t                           \"bound\": None}\n883\t    assert rec[\"checks\"] == {\"command\": \"echo no jsonschema; exit 2\", \"exit\": 2}\n884\t    # the adapter never ran: no commit, no model, the stub file untouched\n885\t    assert rec[\"sha\"] == rec[\"start_sha\"]\n886\t    assert rec[\"model\"] is None\n887\t    assert not (root / \"built.txt\").is_file()\n888\t\n889\t    schema = json.loads((ROOT / \"schema\" / \"records\" / \"build.schema.json\").read_text())\n890\t    jsonschema.validate(rec, schema)\n891\t\n892\t\n893\tdef test_build_proceeds_when_checks_command_exits_1_on_the_approved_tree(tmp_path: Path) -> None:\n894\t    \"\"\"Issue #115, acceptance row 2. A [checks].command exiting 1 --\n895\t    failing checks, the expected state before a build -- does not refuse:\n896\t    the preflight only catches exit 2 (the command cannot run at all).\n897\t    Regression: a preflight that refuses on failing checks would refuse\n898\t    every build, since failing criteria are the expected state before\n899\t    one runs.\n900\t    \"\"\"\n901\t    root = make_tenant(tmp_path, \"build_valid\")\n902\t    toml = root / \"attavo.toml\"\n903\t    toml.write_text(toml.read_text() + '\\n[checks]\\ncommand = \"exit 1\"\\n')\n904\t    commit_all(root, \"configure a failing checks command\")\n905\t    approve_item(root)\n906\t\n907\t    run = run_attavo(root, \"build\", \"1\")\n908\t    assert run.returncode == 1\n909\t\n910\t    rec = latest_build(root)\n911\t    # the adapter ran -- unlike the exit-2 case above, which never invokes it\n912\t    assert rec[\"model\"] == \"fixture\"\n913\t    assert rec[\"status\"] == \"failed\"\n914\t    assert rec[\"checks\"] == {\"command\": \"exit 1\", \"exit\": 1}\n915\t\n916\t\n917\t# --- an empty build is not a pass (item 227): the executor copied the\n918\t# change into the working tree, committed nothing, and answered done; the\n919\t# gate read the tree and passed; the review passed; the merge queue sealed\n920\t# an item whose change did not exist. Written red first against v0.29.0.\n921\t\n922\t\n923\tdef test_the_gate_reads_the_commit_and_an_executor_that_commits_nothing_is_halted_empty(tmp_path: Path) -> None:\n924\t    root = make_tenant(tmp_path, \"build_valid\")\n925\t    approve_item(root)\n926\t    run = run_attavo(root, \"build\", \"1\", env={\"ATTAVO_FIXTURE_NO_COMMIT\": \"1\"})\n927\t    assert run.returncode == 3, run.stdout + run.stderr\n928\t    rec = latest_build(root)\n929\t    assert rec[\"status\"] == \"halted\", rec\n930\t    assert rec[\"sha\"] == rec[\"start_sha\"], rec\n931\t    assert (rec[\"stop\"][\"class\"], rec[\"stop\"][\"provenance\"]) == (\"empty\", \"executor\"), rec[\"stop\"]\n932\t    assert \"the executor committed nothing\" in rec[\"stop\"][\"detail\"], rec[\"stop\"]\n933\t    assert \"1 path(s) modified or untracked\" in rec[\"stop\"][\"detail\"], rec[\"stop\"]\n934\t    assert (root / \"built.txt\").is_file(), \"the fixture did not leave the file in the tree\"\n935\t    assert all(c[\"exit\"] != 0 for c in rec[\"criteria\"]), (\n936\t        \"a criterion passed on a tree whose commit does not carry the change\", rec[\"criteria\"])\n937\t    log = (root / \"records\" / \"1\" / \"build-01.log\").read_text()\n938\t    assert \"you committed nothing\" in log and \"the gate reads the commit, not the tree\" in log, log\n939\t    assert rec[\"iterations\"] == 3, rec[\"iterations\"]\n940\t\n941\t\n942\tdef test_an_empty_iteration_is_fed_back_and_a_later_commit_passes(tmp_path: Path) -> None:\n943\t    \"\"\"The loop is kept: an executor that answers done without a commit on\n944\t    its first iteration is told so and iterates; a commit on the next\n945\t    iteration passes as before.\"\"\"\n946\t    root = make_tenant(tmp_path, \"build_valid\")\n947\t    approve_item(root)\n948\t    adapter_dir = root / \"attavo\" / \"adapters\" / \"fixture\"\n949\t    adapter_dir.mkdir(parents=True)\n950\t    run_path = adapter_dir / \"run\"\n951\t    run_path.write_text('#!/bin/sh\\necho built > built.txt\\n'\n952\t                        'if [ -s \"$ATTAVO_FEEDBACK\" ]; then git add built.txt; git commit -q -m built; fi\\n'\n953\t                        'printf \\'{\"status\":\"done\",\"question\":null,\"model\":\"fixture\",\"model_version\":null,'\n954\t                        '\"adapter_version\":\"fixture-1\",\"tokens\":{\"input\":1,\"output\":1},\"cost_usd\":0.0}\\\\n\\'\\n')\n955\t    run_path.chmod(0o755)\n956\t    commit_all(root, \"a tenant-side adapter that commits only once told\")\n957\t    run = run_attavo(root, \"build\", \"1\")\n958\t    assert run.returncode == 0, run.stdout + run.stderr\n959\t    rec = latest_build(root)\n960\t    assert (rec[\"status\"], rec[\"iterations\"]) == (\"pass\", 2), rec\n961\t    assert rec[\"sha\"] != rec[\"start_sha\"]\n962\t"}]},"parent_tool_use_id":null,"session_id":"ec2614fd-fe76-497e-a0f4-348a6650b419","uuid":"db130c95-ca28-4c90-a964-ef8eb8b84f9e","timestamp":"2026-09-27T15:39:15.629Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-229/tests/test_build.py","content":"    check -- refuses the build before the adapter is ever invoked: class\n    environment, provenance tenant, nothing spent. Regression: item\n    #106's build-01 spent three iterations, 940s, and $1.98 discovering\n    a missing jsonschema import only after the fact, filed\n    unclassed/product; a later change that moves this preflight after\n    the invocation, or drops it, spends a build on a broken environment\n    again.\n    \"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    toml = root / \"attavo.toml\"\n    toml.write_text(toml.read_text()\n                    + '\\n[checks]\\ncommand = \"echo no jsonschema; exit 2\"\\n')\n    commit_all(root, \"configure a broken checks command\")\n    approve_item(root)\n\n    run = run_attavo(root, \"build\", \"1\")\n    assert run.returncode == 1\n\n    rec = latest_build(root)\n    assert rec[\"status\"] == \"refused\"\n    assert rec[\"stop\"] == {\"class\": \"environment\", \"provenance\": \"tenant\",\n                           \"detail\": \"no jsonschema\", \"signature\": \"no jsonschema\",\n                           \"bound\": None}\n    assert rec[\"checks\"] == {\"command\": \"echo no jsonschema; exit 2\", \"exit\": 2}\n    # the adapter never ran: no commit, no model, the stub file untouched\n    assert rec[\"sha\"] == rec[\"start_sha\"]\n    assert rec[\"model\"] is None\n    assert not (root / \"built.txt\").is_file()\n\n    schema = json.loads((ROOT / \"schema\" / \"records\" / \"build.schema.json\").read_text())\n    jsonschema.validate(rec, schema)\n\n\ndef test_build_proceeds_when_checks_command_exits_1_on_the_approved_tree(tmp_path: Path) -> None:\n    \"\"\"Issue #115, acceptance row 2. A [checks].command exiting 1 --\n    failing checks, the expected state before a build -- does not refuse:\n    the preflight only catches exit 2 (the command cannot run at all).\n    Regression: a preflight that refuses on failing checks would refuse\n    every build, since failing criteria are the expected state before\n    one runs.\n    \"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    toml = root / \"attavo.toml\"\n    toml.write_text(toml.read_text() + '\\n[checks]\\ncommand = \"exit 1\"\\n')\n    commit_all(root, \"configure a failing checks command\")\n    approve_item(root)\n\n    run = run_attavo(root, \"build\", \"1\")\n    assert run.returncode == 1\n\n    rec = latest_build(root)\n    # the adapter ran -- unlike the exit-2 case above, which never invokes it\n    assert rec[\"model\"] == \"fixture\"\n    assert rec[\"status\"] == \"failed\"\n    assert rec[\"checks\"] == {\"command\": \"exit 1\", \"exit\": 1}\n\n\n# --- an empty build is not a pass (item 227): the executor copied the\n# change into the working tree, committed nothing, and answered done; the\n# gate read the tree and passed; the review passed; the merge queue sealed\n# an item whose change did not exist. Written red first against v0.29.0.\n\n\ndef test_the_gate_reads_the_commit_and_an_executor_that_commits_nothing_is_halted_empty(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"build_valid\")\n    approve_item(root)\n    run = run_attavo(root, \"build\", \"1\", env={\"ATTAVO_FIXTURE_NO_COMMIT\": \"1\"})\n    assert run.returncode == 3, run.stdout + run.stderr\n    rec = latest_build(root)\n    assert rec[\"status\"] == \"halted\", rec\n    assert rec[\"sha\"] == rec[\"start_sha\"], rec\n    assert (rec[\"stop\"][\"class\"], rec[\"stop\"][\"provenance\"]) == (\"empty\", \"executor\"), rec[\"stop\"]\n    assert \"the executor committed nothing\" in rec[\"stop\"][\"detail\"], rec[\"stop\"]\n    assert \"1 path(s) modified or untracked\" in rec[\"stop\"][\"detail\"], rec[\"stop\"]\n    assert (root / \"built.txt\").is_file(), \"the fixture did not leave the file in the tree\"\n    assert all(c[\"exit\"] != 0 for c in rec[\"criteria\"]), (\n        \"a criterion passed on a tree whose commit does not carry the change\", rec[\"criteria\"])\n    log = (root / \"records\" / \"1\" / \"build-01.log\").read_text()\n    assert \"you committed nothing\" in log and \"the gate reads the commit, not the tree\" in log, log\n    assert rec[\"iterations\"] == 3, rec[\"iterations\"]\n\n\ndef test_an_empty_iteration_is_fed_back_and_a_later_commit_passes(tmp_path: Path) -> None:\n    \"\"\"The loop is kept: an executor that answers done without a commit on\n    its first iteration is told so and iterates; a commit on the next\n    iteration passes as before.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    approve_item(root)\n    adapter_dir = root / \"attavo\" / \"adapters\" / \"fixture\"\n    adapter_dir.mkdir(parents=True)\n    run_path = adapter_dir / \"run\"\n    run_path.write_text('#!/bin/sh\\necho built > built.txt\\n'\n                        'if [ -s \"$ATTAVO_FEEDBACK\" ]; then git add built.txt; git commit -q -m built; fi\\n'\n                        'printf \\'{\"status\":\"done\",\"question\":null,\"model\":\"fixture\",\"model_version\":null,'\n                        '\"adapter_version\":\"fixture-1\",\"tokens\":{\"input\":1,\"output\":1},\"cost_usd\":0.0}\\\\n\\'\\n')\n    run_path.chmod(0o755)\n    commit_all(root, \"a tenant-side adapter that commits only once told\")\n    run = run_attavo(root, \"build\", \"1\")\n    assert run.returncode == 0, run.stdout + run.stderr\n    rec = latest_build(root)\n    assert (rec[\"status\"], rec[\"iterations\"]) == (\"pass\", 2), rec\n    assert rec[\"sha\"] != rec[\"start_sha\"]\n","numLines":103,"startLine":860,"totalLines":962}}}

estricted to the paths the spec claims, is\n    identical to approval_sha's tree there: no path the spec claims has\n    changed since approval (item 227's own build). Compared against the\n    approval, not a particular attempt's start_sha (item 229), so a\n    retried attempt whose head already carries a prior attempt's valid\n    commits owes no commit of its own; an attempt that ends on the\n    approved tree, whatever it left in the working directory, is empty\n    regardless of how it got there. Scoped to claims rather than\n    \"everything outside paths.records\", so a commit that lands between\n    approval and this attempt's start but touches no claimed path --\n    a tenant installing an adapter, say -- never rescues or defeats the\n    comparison on its own account; every commit an executor's own loop\n    ever lands is already confined to claims (build.py's own boundary\n    check), so a real prior attempt's work is always visible here. None\n    when either commit does not resolve in this repository -- not\n    known, not asserted.\"\"\"\n    for commit in (approval_sha, sha):\n        resolved = subprocess.run([\"git\", \"-C\", str(root), \"cat-file\", \"-e\", f\"{commit}^{{commit}}\"],\n                                  capture_output=True, text=True, check=False)\n        if resolved.returncode != 0:\n            return None\n    pathspec = claims if claims else [\".\"]\n    out = subprocess.run([\"git\", \"-C\", str(root), \"diff\", \"--quiet\", approval_sha, sha,\n                          \"--\", *pathspec], capture_output=True, text=True, check=False)\n    if out.returncode not in (0, 1):\n        return None\n    return out.returncode == 0","originalFile":"from __future__ import annotations\n\nimport os\nimport re\nimport subprocess\nimport tomllib\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom typing import Any\n\nMANIFEST = \"attavo.toml\"\n\nSTAGES = (\"spec\", \"approval\", \"build\", \"verify\")\n\n\nPRODUCT_ROOT = Path(__file__).resolve().parent.parent\n\n\nclass Proof:\n    def __init__(self, key: str, title: str) -> None:\n        self.key = key\n        self.title = title\n        self.holds = False\n        self.reason = \"\"\n        self.extra: dict[str, Any] = {}\n\n    def fail(self, reason: str, **extra: Any) -> \"Proof\":\n        self.holds, self.reason = False, reason\n        self.extra.update(extra)\n        return self\n\n    def hold(self, reason: str, **extra: Any) -> \"Proof\":\n        self.holds, self.reason = True, reason\n        self.extra.update(extra)\n        return self\n\n    def as_dict(self) -> dict[str, Any]:\n        return {\"proof\": self.key, \"title\": self.title,\n                \"holds\": self.holds, \"reason\": self.reason, **self.extra}\n\n\ndef read_manifest(root: Path) -> dict[str, Any] | None:\n    path = root / MANIFEST\n    if not path.is_file():\n        return None\n    with path.open(\"rb\") as fh:\n        return tomllib.load(fh)\n\n\ndef git(root: Path, *args: str, env: dict[str, str] | None = None) -> str:\n    out = subprocess.run([\"git\", \"-C\", str(root), *args],\n                         capture_output=True, text=True, check=False, env=env)\n    if out.returncode != 0:\n        raise RuntimeError(out.stderr.strip() or \"git failed\")\n    return out.stdout\n\n\ndef product_version() -> str:\n    \"\"\"What the running program is. Three fallbacks, in order, and never an\n    exception -- this runs inside write_record, after the work it\n    describes already happened, and a raise here would lose the record\n    for an invocation that already ran:\n\n      1. ATTAVO_PRODUCT_VERSION, when the environment sets it. The forge\n         action sets this from its own ref (action.yml, not here -- this\n         function stays forge-agnostic).\n      2. git describe --tags --always --dirty against PRODUCT_ROOT: a\n         tagged release reports its tag, a checkout reports its commit,\n         a dirty tree says so.\n      3. \"unknown\", when PRODUCT_ROOT is not a git repository at all --\n         the case for a forge that extracts this action from a tarball\n         rather than a git checkout, which is exactly when (1) is\n         expected to already have supplied the answer.\n\n    Distinct from the tenant's product_pin -- an operator running a\n    checkout, which is how every build and verify have actually been run\n    so far, bypasses the pin entirely (issue #49).\"\"\"\n    env = os.environ.get(\"ATTAVO_PRODUCT_VERSION\")\n    if env:\n        return env\n    try:\n        return git(PRODUCT_ROOT, \"describe\", \"--tags\", \"--always\", \"--dirty\").strip()\n    except RuntimeError:\n        return \"unknown\"\n\n\ndef now_iso() -> str:\n    return datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n\n\ndef build_is_empty(root: Path, approval_sha: str, sha: str, records_rel: str) -> bool | None:\n    \"\"\"True when sha's tree, outside records_rel, is identical to\n    approval_sha's tree: nothing the gate would ever read has changed\n    since approval (item 227's own build). Compared against the\n    approval, not a particular attempt's start_sha (item 229), so a\n    retried attempt whose head already carries a prior attempt's valid\n    commits owes no commit of its own; an attempt that ends on the\n    approved tree, whatever it left in the working directory, is empty\n    regardless of how it got there. None when either commit does not\n    resolve in this repository -- not known, not asserted.\"\"\"\n    for commit in (approval_sha, sha):\n        resolved = subprocess.run([\"git\", \"-C\", str(root), \"cat-file\", \"-e\", f\"{commit}^{{commit}}\"],\n                                  capture_output=True, text=True, check=False)\n        if resolved.returncode != 0:\n            return None\n    pathspec = f\":!{records_rel.rstrip('/')}\"\n    out = subprocess.run([\"git\", \"-C\", str(root), \"diff\", \"--quiet\", approval_sha, sha,\n                          \"--\", \".\", pathspec], capture_output=True, text=True, check=False)\n    if out.returncode not in (0, 1):\n        return None\n    return out.returncode == 0\n\n\ndef derive_item_id(root: Path) -> str | None:\n    \"\"\"ATTAVO_ITEM first, not last: a rejection fixture's own item id must\n    win over whatever attavo/N-* branch the enclosing tenant repository\n    happens to be checked out on -- the common case is doctor running from\n    a real item's own branch, where a fallback-only env var would never be\n    consulted at all and every gate fixture would silently resolve to the\n    real item instead of its own.\"\"\"\n    env_item = os.environ.get(\"ATTAVO_ITEM\")\n    if env_item:\n        return env_item\n    out = subprocess.run([\"git\", \"-C\", str(root), \"rev-parse\", \"--abbrev-ref\", \"HEAD\"],\n                         capture_output=True, text=True, check=False)\n    branch = out.stdout.strip()\n    m = re.match(r\"^attavo/(\\d+)-\", branch)\n    return m.group(1) if m else None\n\n\ndef fixture_item_id(fixture: Path) -> str | None:\n    \"\"\"The one item id under a rejection fixture's own paths.specs, so the\n    doctor can export it as ATTAVO_ITEM: a fixture carries no attavo/N-*\n    branch for a gate command with no argument to derive from otherwise.\"\"\"\n    fm = read_manifest(fixture)\n    specs_rel = ((fm or {}).get(\"paths\") or {}).get(\"specs\")\n    if not specs_rel:\n        return None\n    specs_dir = fixture / specs_rel\n    if not specs_dir.is_dir():\n        return None\n    items = sorted(p.name for p in specs_dir.iterdir() if p.is_dir())\n    return items[0] if len(items) == 1 else None\n\n\nclass ShallowCheckoutError(RuntimeError):\n    pass\n\n\ndef last_commit_touching(root: Path, relpath: str) -> str | None:\n    shallow = subprocess.run([\"git\", \"-C\", str(root), \"rev-parse\", \"--is-shallow-repository\"],\n                             capture_output=True, text=True, check=False)\n    if shallow.stdout.strip() == \"true\":\n        raise ShallowCheckoutError(\n            \"shallow checkout: git log -1 -- <path> returns HEAD for every path on a \"\n            \"shallow clone; check out with fetch-depth: 0\")\n    out = subprocess.run([\"git\", \"-C\", str(root), \"log\", \"-1\", \"--format=%H\", \"--\", relpath],\n                         capture_output=True, text=True, check=False)\n    sha = out.stdout.strip()\n    return sha or None\n","structuredPatch":[{"oldStart":88,"oldLines":24,"newStart":88,"newLines":31,"lines":["     return datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")"," "," ","-def build_is_empty(root: Path, approval_sha: str, sha: str, records_rel: str) -> bool | None:","-    \"\"\"True when sha's tree, outside records_rel, is identical to","-    approval_sha's tree: nothing the gate would ever read has changed","-    since approval (item 227's own build). Compared against the","+def build_is_empty(root: Path, approval_sha: str, sha: str, claims: list[str]) -> bool | None:","+    \"\"\"True when sha's tree, restricted to the paths the spec claims, is","+    identical to approval_sha's tree there: no path the spec claims has","+    changed since approval (item 227's own build). Compared against the","     approval, not a particular attempt's start_sha (item 229), so a","     retried attempt whose head already carries a prior attempt's valid","     commits owes no commit of its own; an attempt that ends on the","     approved tree, whatever it left in the working directory, is empty","-    regardless of how it got there. None when either commit does not","-    resolve in this repository -- not known, not asserted.\"\"\"","+    regardless of how it got there. Scoped to claims rather than","+    \"everything outside paths.records\", so a commit that lands between","+    approval and this attempt's start but touches no claimed path --","+    a tenant installing an adapter, say -- never rescues or defeats the","+    comparison on its own account; every commit an executor's own loop","+    ever lands is already confined to claims (build.py's own boundary","+    check), so a real prior attempt's work is always visible here. None","+    when either commit does not resolve in this repository -- not","+    known, not asserted.\"\"\"","     for commit in (approval_sha, sha):","         resolved = subprocess.run([\"git\", \"-C\", str(root), \"cat-file\", \"-e\", f\"{commit}^{{commit}}\"],","                                   capture_output=True, text=True, check=False)","         if resolved.returncode != 0:","             return None","-    pathspec = f\":!{records_rel.rstrip('/')}\"","+    pathspec = claims if claims else [\".\"]","     out = subprocess.run([\"git\", \"-C\", str(root), \"diff\", \"--quiet\", approval_sha, sha,","-                          \"--\", \".\", pathspec], capture_output=True, text=True, check=False)","+                          \"--\", *pathspec], capture_output=True, text=True, check=False)","     if out.returncode not in (0, 1):","         return None","     return out.returncode == 0"]}],"userModified":false,"replaceAll":false,"contentNotInModelContext":true}}

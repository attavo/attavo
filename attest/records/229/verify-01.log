{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"sed -n '360,560p' attavo/doctor.py; sed -n '1,170p' attavo/verify.py; sed -n '70,150p' attavo/build.py; sed -n '300,760p' attavo/build.py; rg -n \\\"empty|build_is_empty|built_since|no-attested\\\" attavo/doctor.py attavo/verify.py attavo/build.py attavo/cli.py schema tests | head -200\"","aggregated_output":"    # traversal the gate itself would not let through. The refusal text\n    # is check_attest_chain's own, never re-typed here.\n    refused, held, unmerged = [], [], []\n    for item in complete:\n        chain, message = check_attest_chain(records_dir / item, item)\n        if chain is None:\n            refused.append(f\"item {item}: {message}\")\n            continue\n        merge_sha, merge_refusal = merge_introducing_records(root, records_rel, item, STAGES)\n        if merge_refusal:\n            return p.fail(merge_refusal)\n        if merge_sha:\n            held.append((item, merge_sha))\n        else:\n            unmerged.append(item)\n\n    if held:\n        names = \", \".join(item for item, _ in held)\n        shas = \", \".join(sha[:12] for _, sha in held)\n        return p.hold(f\"item(s) {names} carry {', '.join(STAGES)} with the chain held, \"\n                      f\"merged at {shas}\")\n    if refused:\n        return p.fail(\"; \".join(refused))\n    return p.fail(f\"item(s) {', '.join(unmerged)} carry every stage with the chain held but no \"\n                  f\"merge commit's first-parent diff introduces all of them\")\n\n\ndef commit_subject(root: Path, sha: str) -> str:\n    return git(root, \"log\", \"-1\", \"--format=%s\", sha).strip()\n\n\ndef touches_boundary(root: Path, sha: str, boundary_paths: list[str]) -> bool:\n    \"\"\"Whether sha's first-parent diff touches a path [spec.boundary].paths\n    declares governed -- an ordinary merge that does is a boundary\n    evasion (issue #72): the tenant carried a governed change around the\n    path the manifest itself names.\"\"\"\n    diff = git(root, \"diff\", \"--name-only\", f\"{sha}^1\", sha).splitlines()\n    return any(fnmatch.fnmatch(path, pattern) for path in diff for pattern in boundary_paths)\n\n\nclass WindowRefused(Exception):\n    \"\"\"The window start cannot be computed; str(exc) is the refusal.\"\"\"\n\n\ndef proof_window_start(root: Path, m: dict[str, Any]) -> tuple[str, str, list[str]]:\n    \"\"\"(install commit, window start, first-parent chain after the install\n    commit): where proofs three and six start reading. The start is\n    [doctor].from if the tenant set it, otherwise the commit that\n    introduced the manifest (issue #192: proof six reads this too, so the\n    two proofs cannot disagree).\"\"\"\n    try:\n        install = git(root, \"log\", \"--diff-filter=A\", \"--format=%H\",\n                      \"--reverse\", \"--\", MANIFEST).split()\n    except RuntimeError as exc:\n        raise WindowRefused(f\"git: {exc}\") from exc\n    if not install:\n        raise WindowRefused(f\"{MANIFEST} is not committed; the tenant has no record boundary\")\n    install_sha = install[0]\n    full_chain = git(root, \"rev-list\", f\"{install_sha}..HEAD\", \"--first-parent\").split()\n\n    # issue #74: [doctor] from lets a tenant declare the doctor's read to\n    # start at a later commit on main's first-parent line -- the point\n    # after which every push arrived through the queue -- rather than the\n    # install commit, which on a repository that adopted the product\n    # after its history began is a boundary the doctor cannot otherwise\n    # see. Any spelling git resolves is accepted (a short sha, a tag, a\n    # ref) -- resolved with rev-parse --verify before the first-parent\n    # check runs, so the two failure modes stay distinct: a spelling that\n    # names no commit at all, and a commit that names one off the line.\n    # Checked, not trusted: neither is silently forgiven back to install.\n    declared_from = (m.get(\"doctor\") or {}).get(\"from\")\n    window_start = install_sha\n    if declared_from is not None:\n        try:\n            resolved_from = git(root, \"rev-parse\", \"--verify\", f\"{declared_from}^{{commit}}\").strip()\n        except RuntimeError:\n            raise WindowRefused(f\"[doctor] from {declared_from} does not resolve to a commit\") from None\n        if resolved_from != install_sha and resolved_from not in full_chain:\n            raise WindowRefused(f\"[doctor] from {declared_from} is not on main's first-parent \"\n                                f\"line after the install commit {install_sha[:12]}\")\n        window_start = resolved_from\n    return install_sha, window_start, full_chain\n\n\ndef proof_no_commit_lacks_record(root: Path, m: dict[str, Any] | None) -> Proof:\n    p = Proof(\"no-commit-lacks-record\", \"no commit lacks a record\")\n    if m is None:\n        return p.fail(f\"no {MANIFEST} at {root}; the tenant has no record boundary\")\n    try:\n        install_sha, window_start, full_chain = proof_window_start(root, m)\n    except WindowRefused as exc:\n        return p.fail(str(exc))\n    if not full_chain:\n        return p.fail(f\"no commit after the install commit {install_sha[:12]}; nothing has been recorded\")\n\n    if window_start == install_sha:\n        window_spec = f\"{install_sha}..HEAD\"\n        commits = full_chain\n    else:\n        window_spec = f\"{window_start}^..HEAD\"\n        commits = git(root, \"rev-list\", window_spec, \"--first-parent\").split()\n    before_window = len(full_chain) - len(commits)\n\n    records_rel = m.get(\"paths\", {}).get(\"records\", \"\")\n    records_dir = root / records_rel\n    named: set[str] = set()\n    for stages in load_records(records_dir).values():\n        for rec in stages.values():\n            sha = rec.get(\"sha\")\n            if isinstance(sha, str):\n                named.add(sha)\n            for c in rec.get(\"commits\", []) or []:\n                if isinstance(c, str):\n                    named.add(c)\n    record_commits = set(git(root, \"rev-list\", window_spec, \"--first-parent\",\n                             \"--\", records_rel).split()) if records_rel else set()\n    merges = set(git(root, \"rev-list\", window_spec, \"--first-parent\", \"--merges\").split())\n    boundary_paths = ((m.get(\"spec\") or {}).get(\"boundary\") or {}).get(\"paths\") or []\n\n    # Every first-parent commit in the window is exactly one of three\n    # (issue #72): recorded (a record names it, or its diff touches\n    # paths.records), ordinary (a merge that doesn't), or unrecorded\n    # (anything else -- on a protected main with a queue, a non-merge\n    # commit is the only way a change arrives without the forge).\n    recorded, ordinary, unrecorded = [], [], []\n    ordinary_commits, unrecorded_commits = [], []\n    boundary_evasions = 0\n    for c in commits:\n        if c in named or c in record_commits:\n            recorded.append(c)\n        elif c in merges:\n            ordinary.append(c)\n            evasion = bool(boundary_paths and touches_boundary(root, c, boundary_paths))\n            if evasion:\n                boundary_evasions += 1\n            ordinary_commits.append({\"sha\": c, \"subject\": commit_subject(root, c),\n                                     \"boundary_evasion\": evasion})\n        else:\n            unrecorded.append(c)\n            unrecorded_commits.append({\"sha\": c, \"subject\": commit_subject(root, c)})\n\n    counts = f\"{len(recorded)} recorded, {len(ordinary)} ordinary, {len(unrecorded)} unrecorded\"\n    evasions = boundary_evasions if boundary_paths else \"n/a\"\n    extra = {\"recorded\": len(recorded), \"ordinary\": len(ordinary),\n             \"unrecorded\": len(unrecorded), \"boundary_evasions\": evasions,\n             \"before_window\": before_window,\n             \"ordinary_commits\": ordinary_commits, \"unrecorded_commits\": unrecorded_commits}\n    if unrecorded:\n        return p.fail(f\"{unrecorded[-1][:12]} lacks a record; {counts}; boundary evasions: \"\n                      f\"{evasions}; before the window: {before_window}\", **extra)\n    return p.hold(f\"{counts}; boundary evasions: {evasions}; before the window: {before_window}\",\n                  **extra)\n\n\nADAPTER_EXIT_RE = re.compile(r\"^\\[adapter exited \\d+\\]$\")\n\n_JSON_LINE_PARSE_FAILED = object()\n\n\ndef _parse_json_line(text: str) -> Any:\n    \"\"\"A line's own parsed JSON value, or the sentinel\n    _JSON_LINE_PARSE_FAILED when it does not parse -- the one call site\n    in this file for a defensive, line-at-a-time JSON parse, shared by\n    proof four's own tool-error check below (any valid JSON satisfies\n    it) and an events line's own `at` read (issue #151, which further\n    requires a dict). A dedicated sentinel, not None: a line that is\n    the literal JSON value null parses successfully and must read as\n    such, not as a failure.\"\"\"\n    try:\n        return json.loads(text)\n    except ValueError:\n        return _JSON_LINE_PARSE_FAILED\n\n\ndef _log_owes_tool_error(log: str | None) -> bool:\n    \"\"\"True when a log's last non-empty line is exactly an adapter-exit\n    marker and every line before it parses as JSON -- an adapter's own\n    event stream, never a tool's own words (issue #94's own specimen,\n    tenant zero's attest/records/659/verify-01.log: codex's\n    \"thread.started\" event, then nothing but \"[adapter exited 1]\" -- the\n    tool's real error line dropped before this reached the log, issue\n    #86's own bug in split_adapter_stdout). A log that is only the exit\n    marker, nothing before it at all, still owes the same line. An\n    `error` event with a non-empty string `message` is the tool's own\n    error delivered as an event (issue #200: \"Selected model is at\n    capacity\"), so it owes nothing.\"\"\"\n    if not log:\n        return False\n    lines = [l for l in log.splitlines() if l.strip()]\n    if not lines or not ADAPTER_EXIT_RE.match(lines[-1]):\n        return False\n    for l in lines[:-1]:\n        parsed = _parse_json_line(l)\n        if parsed is _JSON_LINE_PARSE_FAILED:\n            return False\n        if isinstance(parsed, dict) and parsed.get(\"type\") == \"error\":\n            message = parsed.get(\"message\")\n            if isinstance(message, str) and message:\n                return False\n    return True\n\nfrom __future__ import annotations\n\nimport json\nimport os\nimport shlex\nimport subprocess\nimport sys\nimport tempfile\nimport time\nfrom pathlib import Path\nfrom typing import Any, cast\n\nfrom attavo.build import (\n    adapter_reports,\n    build_is_empty,\n    merge_adapter_config,\n    resolve_adapter,\n    split_adapter_stdout,\n)\nfrom attavo.common import MANIFEST, derive_item_id, git, now_iso, read_manifest\nfrom attavo.events import stage_events_dir\nfrom attavo.records import (\n    latest_attempt_path,\n    latest_record,\n    next_attempt_number,\n    parse_attempts,\n    write_record,\n)\nfrom attavo.spec import parse_spec\nfrom attavo.stops import counsel_record_for, derive_stop, signature_of\n\n# --- verify: the forge's own read first, a judge only once it is green ---\n\nFORGE_OK_CONCLUSIONS = {\"success\", \"neutral\", \"skipped\"}\n\n# issue #84: a concluded check's second token is a conclusion --\n# FORGE_OK_CONCLUSIONS, or another concluded one such as failure,\n# cancelled, or timed_out; an unconcluded check's is a status instead,\n# one of these. drive's own poll (poll_forge_checks) is the one reader\n# that needs to tell a still-running check apart from a concluded, not-ok\n# one -- read_forge_checks itself only ever needed \"green or not\".\nFORGE_UNCONCLUDED_STATUSES = {\"queued\", \"in_progress\", \"pending\", \"waiting\"}\n\n\ndef read_forge_checks(root: Path, checks_command: str, sha: str) -> tuple[dict[str, Any], bool]:\n    \"\"\"Runs the tenant's [forge].checks_command on sha; the product does\n    not know what forge that command reads. One line per check as\n    \"<name> <conclusion>\"; a command that fails to run, or any conclusion\n    other than success/neutral/skipped, is not green.\"\"\"\n    run = subprocess.run(f\"{checks_command} {shlex.quote(sha)}\", shell=True, cwd=str(root),\n                         capture_output=True, text=True, check=False)\n    conclusions: list[dict[str, str]] = []\n    for line in run.stdout.splitlines():\n        line = line.strip()\n        if not line:\n            continue\n        parts = line.rsplit(\" \", 1)\n        if len(parts) == 2:\n            conclusions.append({\"name\": parts[0], \"conclusion\": parts[1]})\n    # A commit the forge has no record of is not green -- it is unread.\n    # The executor's own commit is exactly this: the forge attaches\n    # checks to a pull request's head, and that commit stops being the\n    # head the moment a record commit lands on top of it. all() over an\n    # empty list is True, which is why this is spelled out rather than\n    # implied by the loop above.\n    ok = run.returncode == 0 and bool(conclusions) and all(\n        c[\"conclusion\"] in FORGE_OK_CONCLUSIONS for c in conclusions)\n    return {\"command\": checks_command, \"sha\": sha, \"conclusions\": conclusions}, ok\n\n\ndef diff_since_approval(root: Path, approval_sha: str | None) -> tuple[str, str | None]:\n    \"\"\"(diff_text, refusal): the item's own work since approval, not\n    everything merged onto the branch since then (issue #52) -- a\n    three-dot diff against approval_sha itself is not enough, since\n    approval_sha is already an ancestor of HEAD in the normal flow and\n    merge-base(approval_sha, HEAD) is just approval_sha again (verified\n    empirically, see issue #52). Diffing from the merge-base of HEAD and\n    the remote's default branch instead excludes content that arrived by\n    merging that branch in, because that content is already present on\n    both sides of the merge base. refs/remotes/origin/HEAD is what names\n    the default branch without hard-coding \"main\"; when it is not set,\n    there is nothing to diff against and this refuses rather than guess.\n    (\"\", None) when approval_sha is falsy -- nothing to diff from at all.\n    Shared by cmd_verify and cmd_counsel, which both hand an adapter this\n    same diff.\"\"\"\n    if not approval_sha:\n        return \"\", None\n    symref = subprocess.run(\n        [\"git\", \"-C\", str(root), \"symbolic-ref\", \"-q\", \"refs/remotes/origin/HEAD\"],\n        capture_output=True, text=True, check=False)\n    if symref.returncode != 0:\n        return \"\", \"refs/remotes/origin/HEAD is not set; run `git remote set-head origin -a`\"\n    diff_base = git(root, \"merge-base\", symref.stdout.strip(), \"HEAD\").strip()\n    return git(root, \"diff\", diff_base, \"HEAD\"), None\n\n\ndef stub_ratio(diff_text: str, stub_dir: Path, excluded: tuple[str, ...]) -> float | None:\n    \"\"\"The share of the lines diff_text adds that are a line of the stub's\n    file at the same path: near 1 the build shipped the spec author's stub,\n    near 0 the builder wrote the change. Lines under the excluded\n    directories (the specs and records, where the stub itself and the\n    item's records are committed) and blank lines are not counted. None\n    when there is no stub or the diff adds no counted line -- nothing was\n    measured, which is not 0.0.\"\"\"\n    if not stub_dir.is_dir():\n        return None\n    skipped = tuple(e.strip(\"/\") for e in excluded)\n    stub_lines: dict[str, set[str]] = {}\n    path: str | None = None\n    in_hunk = False\n    added = shipped = 0\n    for line in diff_text.splitlines():\n        if line.startswith(\"diff --git \"):\n            path, in_hunk = None, False\n        elif in_hunk:\n            if line.startswith(\"+\") and line[1:].strip() and path is not None:\n                added += 1\n                shipped += line[1:].rstrip() in stub_lines[path]\n        elif line.startswith(\"+++ \"):\n            name = line[4:].split(\"\\t\")[0]\n            path = name[2:] if name.startswith(\"b/\") else None\n            if path is not None and any(path == e or path.startswith(e + \"/\") for e in skipped):\n                path = None\n            if path is not None and path not in stub_lines:\n                stub_file = stub_dir / path\n                stub_lines[path] = (\n                    {text.rstrip() for text in stub_file.read_text(errors=\"replace\").splitlines()}\n                    if stub_file.is_file() else set())\n        elif line.startswith(\"@@\"):\n            in_hunk = True\n    return shipped / added if added else None\n\n\ndef _returned_stop(forge_checks: dict[str, Any]) -> dict[str, Any]:\n    \"\"\"R3 (ruling C amended): a review the forge returned because a\n    required check concluded red is class returned, retryable -- the\n    next build attempt is handed the evidence -- signed by the sorted\n    names of the checks that concluded red. A review returned because\n    the checks have not concluded at all yet (nothing to sign) stays\n    forge-unconcluded, as before -- there is no rejection to hand a\n    build, only a wait that already has its own bound (the drive\n    forge-poll bound, unchanged by this item).\"\"\"\n    conclusions = forge_checks.get(\"conclusions\") or []\n    red = sorted(c[\"name\"] for c in conclusions\n                if c[\"conclusion\"] not in FORGE_OK_CONCLUSIONS\n                and c[\"conclusion\"] not in FORGE_UNCONCLUDED_STATUSES)\n    unconcluded = [c for c in conclusions if c[\"conclusion\"] in FORGE_UNCONCLUDED_STATUSES]\n    if red and not unconcluded:\n        detail = \", \".join(f\"{c['name']} {c['conclusion']}\" for c in conclusions if c[\"name\"] in red)\n        return {\"class\": \"returned\", \"provenance\": \"tenant\", \"detail\": detail,\n               \"signature\": signature_of(\" \".join(red)), \"bound\": None}\n    stop = dict(derive_stop(\"returned\") or {})\n    return {**stop, \"signature\": None, \"bound\": None}\n\n\ndef _verify_retry_seed(records_dir: Path, build_sha: str) -> tuple[str | None, str | None]:\n    \"\"\"(retry_of, steer): a plain retry of verify itself -- died, hung,\n    transient, or any other non-returned stop counsel answered -- names\n    the prior verify attempt it retries, the same way build's own retry\n    does. A returned review is never this: its own fix is a new build,\n    not a new verify, so build.py's _retry_seed is what names it as\n    retry_of instead.\"\"\"\n    attempts = parse_attempts(records_dir, \"verify\")\n    if not attempts:\n        return None, None\n    nn = max(attempts)\n    prior = attempts[nn]\n    stop = cast(\"dict[str, Any]\", prior.get(\"stop\") or {})\n    if prior.get(\"status\") == \"pass\" or prior.get(\"build_sha\") != build_sha or stop.get(\"class\") == \"returned\":\n        return None, None\n    conformance.json at all -- an absent declaration, not a refusal.\"\"\"\n    manifest_path = adapter_path.parent / \"conformance.json\"\n    if not manifest_path.is_file():\n        return []\n    try:\n        manifest = json.loads(manifest_path.read_text())\n    except json.JSONDecodeError:\n        return []\n    reports: list[str] = manifest.get(\"reports\", [])\n    return reports\n\n\ndef changed_paths(root: Path, start_sha: str, records_rel: str) -> list[str]:\n    \"\"\"Paths changed between start_sha and HEAD, other than paths.records --\n    the records directory is where build itself writes, not a claim.\"\"\"\n    return without_records(git(root, \"diff\", \"--name-only\", start_sha, \"HEAD\").splitlines(),\n                           records_rel)\n\n\ndef matches_a_claim(path: str, claims: list[str]) -> bool:\n    return any(fnmatch.fnmatch(path, pattern) for pattern in claims)\n\n\ndef build_is_empty(root: Path, approval_sha: str, sha: str, claims: list[str]) -> bool | None:\n    \"\"\"True when sha's tree, restricted to the paths the spec claims, is\n    identical to approval_sha's tree there: no path the spec claims has\n    changed since approval (item 227's own build). Compared against the\n    approval, not a particular attempt's start_sha (item 229), so a\n    retried attempt whose head already carries a prior attempt's valid\n    commits owes no commit of its own; an attempt that ends on the\n    approved tree, whatever it left in the working directory, is empty\n    regardless of how it got there. Scoped to claims rather than\n    \"everything outside paths.records\", so a commit that lands between\n    approval and this attempt's start but touches no claimed path --\n    a tenant installing an adapter, say -- never rescues or defeats the\n    comparison on its own account; every commit an executor's own loop\n    ever lands is already confined to claims (this module's own boundary\n    check above), so a real prior attempt's work is always visible here.\n    None when either commit does not resolve in this repository -- not\n    known, not asserted.\"\"\"\n    for commit in (approval_sha, sha):\n        resolved = subprocess.run([\"git\", \"-C\", str(root), \"cat-file\", \"-e\", f\"{commit}^{{commit}}\"],\n                                  capture_output=True, text=True, check=False)\n        if resolved.returncode != 0:\n            return None\n    pathspec = claims if claims else [\".\"]\n    out = subprocess.run([\"git\", \"-C\", str(root), \"diff\", \"--quiet\", approval_sha, sha,\n                          \"--\", *pathspec], capture_output=True, text=True, check=False)\n    if out.returncode not in (0, 1):\n        return None\n    return out.returncode == 0\n\n\ndef protected_path_touched(root: Path, start_sha: str, records_rel: str,\n                           specs_rel: str) -> str | None:\n    \"\"\"The first path an executor's own commits touched under\n    paths.records or paths.specs since start_sha, or None (issue #140).\n    Neither directory is a claim a spec can make -- paths.records is\n    where the product itself writes, paths.specs is the definition of\n    done -- yet changed_paths above excludes paths.records from the\n    ordinary claims check entirely, so a path there never even reached\n    matches_a_claim to be refused: tenant zero's own item #688 committed\n    its own events file this way, under its records directory, on a\n    build that then passed. Checked directly against the raw diff, not\n    changed_paths's already-filtered list.\"\"\"\n    touched = git(root, \"diff\", \"--name-only\", start_sha, \"HEAD\").splitlines()\n    protected = []\n    for rel in (records_rel, specs_rel):\n        stripped = rel.rstrip(\"/\")\n        protected.append((stripped, stripped + \"/\"))\n    for p in touched:\n        if not p:\n            continue\n        for exact, prefix in protected:\n            if p == exact or p.startswith(prefix):\n                return p\n    return None\n\n\ndef executor_identity(adapter_name: str) -> dict[str, Any]:\n    \"\"\"The executor's identity (issue #33): set by the product, never the\n            nn, counsel = matches[-1]\n            if counsel.get(\"verdict\") == \"answer\":\n                steer_stem = f\"counsel-{nn:02d}\"\n                answer = (counsel.get(\"proposal\") or {}).get(\"ruling_text\")\n                if answer:\n                    lines += [f\"steer from {steer_stem}:\", answer.strip(), \"\"]\n\n    return prior_stem, steer_stem, \"\\n\".join(lines) + \"\\n\"\n\n\n@contextlib.contextmanager\ndef gate_checkout(root: Path) -> Iterator[Path]:\n    \"\"\"A detached worktree of root's HEAD, removed on exit: the tree the\n    build's gate reads. The executor's own directory is not it -- a file\n    written there and never committed is not part of the change, and a\n    gate that read it would pass work that does not exist on the branch\n    (item 227).\"\"\"\n    parent = Path(tempfile.mkdtemp(prefix=\"attavo-gate-\"))\n    tree = parent / \"head\"\n    git(root, \"worktree\", \"add\", \"--detach\", \"-q\", str(tree), \"HEAD\")\n    try:\n        yield tree\n    finally:\n        try:\n            git(root, \"worktree\", \"remove\", \"--force\", str(tree))\n        except RuntimeError:\n            shutil.rmtree(tree, ignore_errors=True)\n            try:\n                git(root, \"worktree\", \"prune\")\n            except RuntimeError:\n                pass\n        shutil.rmtree(parent, ignore_errors=True)\n\n\ndef cmd_build(argv: list[str]) -> int:\n    root = Path(\".\").resolve()\n    item_id = argv[0] if argv else derive_item_id(root)\n    if not item_id:\n        print(\"attavo build: cannot derive item id; pass N or run on an attavo/N-* branch\",\n              file=sys.stderr)\n        return 2\n    m = read_manifest(root)\n    if m is None:\n        print(f\"attavo build: no {MANIFEST} at {root}\", file=sys.stderr)\n        return 2\n\n    adapter_name = (m.get(\"executor\") or {}).get(\"build\")\n    if not adapter_name:\n        print(\"attavo build: refused: no [executor].build in the manifest\")\n        return 1\n\n    tests_cfg = m.get(\"tests\") or {}\n    if not tests_cfg.get(\"select\") or not tests_cfg.get(\"run\"):\n        print(\"attavo build: refused: no [tests] table in the manifest \"\n              \"([tests].select and [tests].run are both required)\")\n        return 1\n\n    if (m.get(\"checks\") or {}).get(\"probe\") and not (m.get(\"checks\") or {}).get(\"probe_timeout_s\"):\n        print(\"attavo build: refused: [checks].probe is declared without \"\n              \"[checks].probe_timeout_s (a probe with no bound is not asked)\")\n        return 1\n\n    try:\n        status = approval_status(root, m, item_id)\n    except ShallowCheckoutError as exc:\n        print(f\"attavo build: refused: {exc}\", file=sys.stderr)\n        return 2\n    if status != \"valid\":\n        print(f\"attavo build: refused: approval is {status}\")\n        return 1\n\n    adapter_path = resolve_adapter(root, adapter_name)\n    if adapter_path is None:\n        print(f\"attavo build: refused: no adapter named {adapter_name!r}\")\n        return 1\n\n    specs_rel = m[\"paths\"][\"specs\"]\n    records_rel = m[\"paths\"][\"records\"]\n    spec_dir = root / specs_rel / item_id\n    item_records_dir = root / records_rel / item_id\n    spec_sha = last_commit_touching(root, str(Path(specs_rel) / item_id))\n    latest_approval = latest_record(item_records_dir, \"approval\")\n    approval_sha = latest_approval.get(\"sha\") if latest_approval else None\n    # approval_status already refused above unless status is \"valid\", which\n    # only holds when latest_approval exists and names a sha (attavo/approval.py).\n    assert approval_sha is not None, \"approval status valid implies a latest approval sha\"\n    parsed, _ = parse_spec(spec_dir / \"spec.md\")\n    claims = parsed[\"claims\"] if parsed else []\n    criteria_names = parsed[\"criteria\"] if parsed else []\n    adapter_config = merge_adapter_config(m, adapter_name, \"build\")\n    checks_cfg = m.get(\"checks\") or {}\n    checks_command = checks_cfg.get(\"command\")\n    probe = checks_cfg.get(\"probe\")\n    probe_timeout_s = checks_cfg.get(\"probe_timeout_s\")\n    identity = executor_identity(adapter_name)\n    reports = adapter_reports(adapter_path)\n\n    start_sha = git(root, \"rev-parse\", \"HEAD\").strip()\n    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n    started = time.monotonic()\n\n    events_path = stage_events_dir(root) / f\"build-{next_attempt_number(item_records_dir, 'build'):02d}.events.jsonl\"\n\n    # Issue #115, then issue #212: whether this machine can run the tenant's\n    # checks at all is asked once here, on the approved tree, before the\n    # adapter is ever invoked -- a missing import at test collection (item\n    # #106's build-01) is not a failing check, and no build could have\n    # passed against it. A tenant that declares [checks].probe is asked by\n    # the probe, inside [checks].probe_timeout_s: exit 0 yes, anything else\n    # or the bound no. A tenant that does not is asked the old way, by\n    # running [checks].command whole -- exit 2 no, exit 0 or 1 (the checks\n    # ran and passed or failed, the expected states before a build) yes --\n    # which is the run #194's build-01 spent 215 s on. Either way the feed\n    # says what is being asked and what the answer was.\n    if checks_command:\n        append_event(events_path, \"gate\", \"checking this machine can run the checks\")\n        asked = checks_command\n        if probe:\n            asked = probe\n            code, out, err, timed_out = run_bounded(probe, root, \"\", probe_timeout_s)\n            refusal_text = (f\"[checks].probe did not finish within {probe_timeout_s} s\" if timed_out\n                            else f\"[checks].probe exited {code} on the approved tree\"\n                            if code != 0 else None)\n        else:\n            preflight = subprocess.run(checks_command, shell=True, cwd=str(root),\n                                       capture_output=True, text=True, check=False)\n            code, out, err = preflight.returncode, preflight.stdout, preflight.stderr\n            refusal_text = (\"[checks].command exited 2 on the approved tree\" if code == 2 else None)\n        if refusal_text:\n            append_event(events_path, \"gate\", f\"this machine cannot run the checks: {refusal_text}\")\n            log = out + err\n            detail = _log_last_line(out + \"\\n\" + err) or refusal_text\n            record = {\n                \"sha\": start_sha,\n                \"start_sha\": start_sha,\n                \"spec_sha\": spec_sha,\n                \"approval_sha\": approval_sha,\n                \"at\": now_iso(),\n                \"adapter\": adapter_name,\n                \"adapter_config\": adapter_config,\n                \"executor_identity\": identity,\n                \"reports\": reports,\n                \"adapter_version\": None,\n                \"model\": None,\n                \"model_version\": None,\n                \"iterations\": 1,\n                \"criteria\": [],\n                \"selected_tests\": None,\n                \"checks\": {\"command\": asked, \"exit\": code},\n                \"tokens\": {\"input\": 0, \"output\": 0},\n                \"cost_usd\": None,\n                \"wall_clock_s\": round(time.monotonic() - started, 3),\n                \"status\": \"refused\",\n                \"refusal\": refusal_text,\n                \"halted\": None,\n                \"retry_of\": None,\n                \"steer\": None,\n                # R3: environment is never retried by this item (recorded\n                # here, acted on by R4's breaker) -- signed anyway for\n                # the exhaustion report's own side-by-side, on the\n                # remote chance a person retries by hand.\n                \"stop\": {\"class\": \"environment\", \"provenance\": \"tenant\", \"detail\": detail,\n                        \"signature\": signature_of(detail), \"bound\": None},\n            }\n            record_path = write_record(item_records_dir, \"build\", record, m, item_id,\n                                       log=log or refusal_text + \"\\n\")\n            print(f\"attavo build: refused ({record_path.name})\")\n            return 1\n        append_event(events_path, \"gate\", \"this machine can run the checks\")\n\n    adapter_version = model = model_version = None\n    tokens = {\"input\": 0, \"output\": 0}\n    cost_usd = None\n    transcripts: list[str] = []\n    criteria_results: list[dict[str, Any]] = []\n    selected_tests: dict[str, Any] | None = None\n    checks_result: dict[str, Any] | None = None\n    status_out = \"failed\"\n    refusal = None\n    refusal_provenance = None\n    halted = None\n    empty_detail: str | None = None\n    iterations_used = 0\n\n    with tempfile.TemporaryDirectory() as tmp:\n        feedback_path = Path(tmp) / \"feedback.txt\"\n        feed
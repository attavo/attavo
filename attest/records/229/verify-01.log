w ([doctor].built_since) and every later attested\n+    item's build names a change.\"\"\"\n+    p = run_doctor(ROOT)[\"no-attested-item-is-empty\"]\n+    assert p[\"holds\"], p[\"reason\"]\ndiff --git a/tests/test_own_records_guard.py b/tests/test_own_records_guard.py\nindex ef93ca7..94aaaac 100644\n--- a/tests/test_own_records_guard.py\n+++ b/tests/test_own_records_guard.py\n@@ -82,7 +82,7 @@ def unmarked_own_records_readers(tests_dir: Path, skip: str,\n \n \n def test_the_test_job_deselects_the_doctor_tests_the_doctor_job_runs() -> None:\n-    assert len(deselected_by_the_test_job()) == 5, deselected_by_the_test_job()\n+    assert len(deselected_by_the_test_job()) == 6, deselected_by_the_test_job()\n \n \n def test_no_unmarked_test_reads_this_repositorys_own_records() -> None:\ndiff --git a/tests/test_self_tenancy.py b/tests/test_self_tenancy.py\nindex 8c165f7..a1ce3fc 100644\n--- a/tests/test_self_tenancy.py\n+++ b/tests/test_self_tenancy.py\n@@ -58,7 +58,9 @@ def test_manifest_declares_every_key_issue_103_lists() -> None:\n     # default), which already holds: the one first-parent commit after\n     # it is this issue's own merge, an ordinary merge touching no\n     # boundary path. Verified by simulating the merge locally.\n-    assert \"doctor\" not in m\n+    # Item 227 added [doctor].built_since, the window for proof seven; [doctor].from\n+    # stays absent for the reason above.\n+    assert set(m.get(\"doctor\") or {}) == {\"built_since\"}, m.get(\"doctor\")\n     assert m[\"forge\"][\"checks_command\"]\n     assert m[\"forge\"][\"file_issue_command\"]\n     paths = m[\"spec\"][\"boundary\"][\"paths\"]\n@@ -76,6 +78,8 @@ DESELECT_FLAGS = (\n     \"--deselect tests/test_doctor.py::test_one_item_traversed_every_stage\",\n     \"--deselect tests/test_doctor.py::test_no_commit_lacks_a_record\",\n     \"--deselect tests/test_doctor.py::test_no_stop_lacks_cause\",\n+    \"--deselect tests/test_doctor.py::test_every_attested_item_is_sealed\",\n+    \"--deselect 
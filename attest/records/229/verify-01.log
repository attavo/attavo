   build names a change: its tree, restricted to the item's own spec\n+    claims, differs from the approved tree there (item 229 -- asked\n+    against the approval, not the build's own start_sha, so a build\n+    that adopted a prior attempt's valid commits is not empty just\n+    because that attempt owed no commit of its own; scoped to claims,\n+    not \"everything outside paths.records\", so a commit that lands\n+    between approval and a later attempt's start but touches no\n+    claimed path never rescues or defeats the comparison on its own\n+    account). Item 227 was specified, approved, built by one\n+    invocation, judged by another, merged and sealed, and its build\n+    committed nothing -- the executor left the stub in the working tree,\n+    the gate read the tree, and main received the spec and none of the\n+    change. Six proofs held over it.\n+\n+    [doctor].built_since: merges at or before this commit are before the\n+    window -- named, never failed -- so the specimen stands on every\n+    doctor run without failing the tenant forever. Absent, the window is\n+    proof three's. A build record whose approval cannot be resolved\n+    (no approval_sha at all, or one this repository cannot read) is\n+    named as not readable, not failed.\"\"\"\n+    p = Proof(\"no-attested-item-is-empty\", \"every attested item's build names a change\")\n+    if m is None:\n+        return p.fail(f\"no {MANIFEST} at {root}; no records directory is declared\")\n+    records_rel = m.get(\"paths\", {}).get(\"records\", \"\")\n+    specs_rel = m.get(\"paths\", {}).get(\"specs\", \"\")\n+    records_dir = root / records_rel\n+    if not records_dir.is_dir():\n+        return p.fail(f\"no records directory under {records_dir}\")\n+    items = load_records(records_dir)\n+    complete = [item for item, stages in sorted(items.items()) if all(s in stages for s in STAGES)]\n+    since = (m.get(\"doctor\") or {}).get(\"built_since\")\n+    if not (isinstance(since, str) and since.strip()):\n+        try:\n+            since = proof_window_start(root, m)[1]\n+        except WindowRefused as exc:\n+            return p.fail(str(exc))\n+    else:\n+        try:\n+            since = git(root, \"rev-parse\", \"--verify\", f\"{since}^{{commit}}\").strip()\n+        except RuntimeError:\n+            return p.fail(f\"[doctor] built_since {since} does not resolve to a commit\")\n+    merges, refusal = _merges_reachable(root)\n+    if refusal:\n+        return p.fail(refusal)\n+    built: list[str] = []\n+    before_window: list[str] = []\n+    not_merged: list[str] = []\n+    not_read: list[str] = []\n+    empty: list[str] = []\n+    for item in complete:\n+        merge_sha, _ = merge_introducing_records(root, records_rel, item, STAGES, merges=merges)\n+        if merge_sha is None:\n+            not_merged.append(item)\n+            continue\n+        if _is_ancestor(root, merge_sha, since):\n+            before_window.append(item)\n+            continue\n+        build = items[item][\"build\"]\n+        sha, approval_sha = build.get(\"sha\"), build.get(\"approval_sha\")\n+        if not sha or not approval_sha:\n+            not_read.append(item)\n+            continue\n+        spec_md = root / specs_rel / item / \"spec.md\"\n+        claims: list[str] = []\n+        if spec_md.is_file():\n+            parsed, _ = parse_spec(spec_md)\n+            claims = parsed[\"claims\"] if parsed else []\n+        is_empty = build_is_empty(root, approval_sha, sha, claims)\n+        if is_empty is None:\n+            not_read.append(item)\n+        elif is_empty:\n+            empty.append(f\"item {item} merged at {merge_sha[:12]}: build names no \"\n+                         \"claimed change; nothing was built\")\n+        else:\n+            built.append(item)\n+    if empty:\n+        return p.fail(\"; \".join(empty), built=built, before_window=before_window,\n+                      not_merged=not_merged, not_read=not_read)\n+    window = f\" at {since[:12]}\" if before_window else \"\"\n+    return p.hold(f\"{len(built)} built, {len(before_window)} before the window{window}, \"\n+                  f\"{len(not_read)} without a readable approval, {len(not_merged)} not merged\",\n+                  built=built, before_window=before_window, not_merged=not_merged,\n+                  not_read=not_read)\n+\n+\n def doctor(root: Path) -> list[Proof]:\n     m = read_manifest(root)\n     return [proof_every_gate_rejects(root, m),\n@@ -830,7 +919,8 @@ def doctor(root: Path) -> list[Proof]:\n             proof_no_commit_lacks_record(root, m),\n             proof_no_stop_lacks_cause(root, m),\n             proof_no_invocation_lacks_record(root, m),\n-            proof_every_attested_item_is_sealed(root, m)]\n+            proof_every_attested_item_is_sealed(root, m),\n+            proof_no_attested_item_is_empty(root, m)]\n \n \n def cmd_doctor(argv: list[str]) -> int:\ndiff --git a/attavo/stops.py b/attavo/stops.py\nindex 793499a..29fc2f1 100644\n--- a/attavo/stops.py\n+++ b/attavo/stops.py\n@@ -19,7 +19,7 @@ from attavo.types import CounselRecord, Stop\n \n STOP_CLASSES = (\"non-question\", \"outlived-invocation\", \"no-cause\", \"forge-unconcluded\",\n                \"ceiling\", \"claims-boundary\", \"repeated-act\", \"unclassed\", \"question\",\n-               \"environment\", \"gate\", \"died\", \"hung\", \"transient\", \"returned\")\n+               \"environment\", \"gate\", \"died\", \"hung\", \"transient\", \"returned\", \"empty\")\n \n # R3: the four families a pass retries with no person involved -- every\n # other class is counsel's to read first, and a person's when counsel says\ndiff --git a/attavo/verify.py b/attavo/verify.py\nindex e19f4ce..8a6696f 100644\n--- a/attavo/verify.py\n+++ b/attavo/verify.py\n@@ -12,6 +12,7 @@ from typing import Any, cast\n \n from attavo.build import (\n     adapter_reports,\n+    build_is_empty,\n     merge_adapter_config,\n     resolve_adapter,\n     split_adapter_stdout,\n@@ -25,6 +26,7 @@ from attavo.records import (\n     parse_attempts,\n     write_record,\n )\n+from attavo.spec import parse_spec\n from attavo.stops import counsel_record_for, derive_stop, signature_of\n \n # --- verify: the forge's own read first, a judge only once it is green ---\n@@ -201,6 +203,27 @@ def cmd_verify(argv: list[str]) -> int:\n         print(f\"attavo verify: refused: latest build record is \"\n               f\"{latest_build.get('status')!r}, not pass\")\n         return 1\n+    # A build is empty when its tree, restricted to the spec's own\n+    # claims, is the approved tree there -- asked against the approval,\n+    # not start_sha, so a build that adopted a prior attempt's valid\n+    # commits is not empty just because this attempt owed no commit of\n+    # its own (item 229). sha == start_sha (the shape a first attempt's\n+    # own empty build always has, and the shape item 227's own build\n+    # was) is kept as a fallback for a record with no approval_sha to\n+    # ask at all.\n+    build_sha, build_start_sha = latest_build.get(\"sha\"), latest_build.get(\"start_sha\")\n+    build_approval_sha = latest_build.get(\"approval_sha\")\n+    spec_dir = root / specs_rel / item_id\n+    parsed, _ = parse_spec(spec_dir / \"spec.md\")\n+    claims = parsed[\"claims\"] if parsed else []\n+    empty = (build_is_empty(root, build_approval_sha, build_sha, claims)\n+            if build_approval_sha else build_sha == build_start_sha)\n+    if empty:\n+        detail = (f\" (sha equals start_sha {str(build_sha)[:12]})\"\n+                  if build_sha == build_start_sha else \"\")\n+        print(f\"attavo verify: refused: the latest build record names no change{detail}; \"\n+              \"nothing to review\")\n+        return 1\n \n     forge_cfg = m.get(\"forge\") or {}\n     checks_command = forge_cfg.get(\"checks_command\")\n@@ -211,7 +234,6 @@ def cmd_verify(argv: list[str]) -> int:\n     build_sha = latest_build[\"sha\"]\n+    path = sorted((root / \"records\" / \"1\").glob(\"build-*.json\"))[-1]\n+    rec = json.loads(path.read_text())\n+    rec[\"sha\"] = rec[\"start_sha\"]\n+    path.write_text(json.dumps(rec, indent=2) + \"\\n\")\n+    run = run_attavo(root, \"verify\", \"1\")\n+    assert run.returncode == 1, run.stdout + run.stderr\n+    assert \"names no change\" in run.stdout and \"sha equals start_sha\" in run.stdout, run.stdout\n+    assert list((root / \"records\" / \"1\").glob(\"verify-*.json\")) == []\ndiff --git a/schema/manifest.schema.json b/schema/manifest.schema.json\nindex e521450..a313f6f 100644\n--- a/schema/manifest.schema.json\n+++ b/schema/manifest.schema.json\n@@ -211,6 +211,11 @@\n           \"type\": \"string\",\n           \"description\": \"Anything git rev-parse --verify resolves to a commit on main's first-parent line, at or after the install commit -- a full or abbreviated sha, a tag, a ref -- where proof three's window starts. A tenant that adopted the product on a repository with pre-existing history names the commit after which every push arrived through the queue. Resolved and checked against main's first-parent line, not trusted: a spelling that does not resolve, or a commit that is not on that line, is refused by name.\",\n           \"minLength\": 1\n+        },\n+        \"built_since\": {\n+          \"type\": \"string\",\n+          \"description\": \"Anything git rev-parse --verify resolves to a commit. Proof seven (no attested item is empty) names items merged at or before it as before the window instead of failing them: the specimen that produced the proof stays on the record without failing the tenant forever. Absent, proof seven's window is proof three's.\",\n+          \"minLength\": 1\n         }\n       }\n     },\ndiff --git a/schema/records/build.schema.json b/schema/records/build.schema.json\nindex 8a40fde..ba934c6 100644\n--- a/schema/records/build.schema.json\n+++ b/schema/records/build.schema.json\n@@ -1,6 +1,6 @@\n {\n   \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n-  \"$id\": \"https://attavo.dev/schema/records/build/8\",\n+  \"$id\": \"https://attavo.dev/schema/records/build/9\",\n   \"title\": \"attavo build record (build-NN.json)\",\n   \"type\": \"object\",\n   \"additionalProperties\": false,\n@@ -110,7 +110,7 @@\n           \"type\": \"string\",\n           \"enum\": [\"non-question\", \"outlived-invocation\", \"no-cause\", \"forge-unconcluded\",\n                    \"ceiling\", \"claims-boundary\", \"repeated-act\", \"unclassed\", \"question\",\n-                   \"environment\", \"gate\", \"died\", \"hung\", \"transient\", \"returned\"]\n+                   \"environment\", \"gate\", \"died\", \"hung\", \"transient\", \"returned\", \"empty\"]\n         },\n         \"signature\": {\n           \"type\": [\"string\", \"null\"],\ndiff --git a/schema/records/verify.schema.json b/schema/records/verify.schema.json\nindex 3feb97f..96d980b 100644\n--- a/schema/records/verify.schema.json\n+++ b/schema/records/verify.schema.json\n@@ -1,6 +1,6 @@\n {\n   \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n-  \"$id\": \"https://attavo.dev/schema/records/verify/7\",\n+  \"$id\": \"https://attavo.dev/schema/records/verify/8\",\n   \"title\": \"attavo verify record (verify-NN.json)\",\n   \"type\": \"object\",\n   \"additionalProperties\": false,\n@@ -104,7 +104,7 @@\n           \"type\": \"string\",\n           \"enum\": [\"non-question\", \"outlived-invocation\", \"no-cause\", \"forge-unconcluded\",\n                    \"ceiling\", \"claims-boundary\", \"repeated-act\", \"unclassed\", \"question\",\n-                   \"died\", \"hung\", \"transient\", \"returned\"]\n+                   \"died\", \"hung\", \"transient\", \"returned\", \"empty\"]\n         },\n         \"signature\": {\n           \"type\": [\"string\", \"null\"],\ndiff --git a/tests/test_build.py b/tests/test_build.py\nindex 9fa2e3b..58d77cd 100644\n--- a/tests/test_build.py\n+++ b/tests/test_build.py\n@@ -912,3 +912,79 @@ def test_build_proceeds_when_checks_command_exits_1_on_the_approved_tree(tmp_pat\n     assert rec[\"model\"] == \"fixture\"\n     assert rec[\"status\"] == \"failed\"\n     assert rec[\"checks\"] == {\"command\": \"exit 1\", \"exit\": 1}\n+\n+\n+# --- an empty build is not a pass (item 227): the executor copied the\n+# change into the working tree, committed nothing, and answered done; the\n+# gate read the tree and passed; the review passed; the merge queue sealed\n+# an item whose change did not exist. Written red first against v0.29.0.\n+\n+\n+def test_the_gate_reads_the_commit_and_an_executor_that_commits_nothing_is_halted_empty(tmp_path: Path) -> None:\n+    root = make_tenant(tmp_path, \"build_valid\")\n+    approve_item(root)\n+    run = run_attavo(root, \"build\", \"1\", env={\"ATTAVO_FIXTURE_NO_COMMIT\": \"1\"})\n+    assert run.returncode == 3, run.stdout + run.stderr\n+    rec = latest_build(root)\n+    assert rec[\"status\"] == \"halted\", rec\n+    assert rec[\"sha\"] == rec[\"start_sha\"], rec\n+    assert (rec[\"stop\"][\"class\"], rec[\"stop\"][\"provenance\"]) == (\"empty\", \"executor\"), rec[\"stop\"]\n+    assert \"the executor committed nothing\" in rec[\"stop\"][\"detail\"], rec[\"stop\"]\n+    assert \"1 path(s) modified or untracked\" in rec[\"stop\"][\"detail\"], rec[\"stop\"]\n+    assert (root / \"built.txt\").is_file(), \"the fixture did not leave the file in the tree\"\n+    assert all(c[\"exit\"] != 0 for c in rec[\"criteria\"]), (\n+        \"a criterion passed on a tree whose commit does not carry the change\", rec[\"criteria\"])\n+    log = (root / \"records\" / \"1\" / \"build-01.log\").read_text()\n+    assert \"you committed nothing\" in log and \"the gate reads the commit, not the tree\" in log, log\n+    assert rec[\"iterations\"] == 3, rec[\"iterations\"]\n+\n+\n+def test_a_retried_attempt_that_adopts_a_prior_valid_commit_needs_no_commit_of_its_own(\n+        tmp_path: Path) -> None:\n+    \"\"\"Item 229 -- the build-01/counsel-03/build-02 race this item answers:\n+    a build whose start_sha already carries a prior attempt's valid\n+    commit, inherited from history rather than made by this invocation,\n+    is not empty just because this attempt commits nothing of its own.\n+    The comparison is against the approval, not this attempt's own\n+    start_sha.\"\"\"\n+    root = make_tenant(tmp_path, \"build_valid\")\n+    approve_item(root)\n+    approval_sha = subprocess.run([\"git\", \"-C\", str(root), \"rev-parse\", \"HEAD\"],\n+                                  capture_output=True, text=True, check=True).stdout.strip()\n+    # a prior attempt's own valid commit, already on the branch before\n+    # this invocation's start_sha -- exactly what build-01 left behind\n+    # once its own record, not its commit, was discarded.\n+    (root / \"built.txt\").write_text(\"built\\n\")\n+    subprocess.run([\"git\", \"-C\", str(root), \"add\", \"built.txt\"], check=True)\n+    subprocess.run([\"git\", \"-C\", str(root), \"commit\", \"-q\", \"-m\", \"a prior attempt's own valid commit\"],\n+                   check=True)\n+\n+    run = run_attavo(root, \"build\", \"1\", env={\"ATTAVO_FIXTURE_NO_COMMIT\": \"1\"})\n+    assert run.returncode == 0, run.stdout + run.stderr\n+    rec = latest_build(root)\n+    assert rec[\"status\"] == \"pass\", rec\n+    assert rec[\"sha\"] == rec[\"start_sha\"], rec\n+    assert rec[\"sha\"] != approval_sha, rec\n+    assert rec[\"iterations\"] == 1, rec\n+\n+\n+def test_an_empty_iteration_is_fed_back_and_a_later_commit_passes(tmp_path: Path) -> None:\n+    \"\"\"The loop is kept: an executor that answers done without a commit on\n+    its first iteration is told so and iterates; a commit on the next\n+    iteration passes as before.\"\"\"\n+    root = make_tenant(tmp_path, \"build_valid\")\n+    approve_item(root)\n+    adapter_dir = root / \"attavo\" / \"adapters\" / \"fixture\"\n+    adapter_dir.mkdir(parents=True)\n+    run_path = adapter_dir / \"run\"\n+    run_path.write_text('#!/bin/sh\\necho built > built.txt\\n'\n+                        'if [ -s \"$ATTAVO_FEEDBACK\" ]; then git add built.txt; git commit -q -m built; fi\\n'\n+                        'printf \\'{\"status\":\"done\",\"question\":null,\"model\":\"fixture\",\"model_version\":null,'\n+                        '\"adapter_version\":\"fixture-1\",\"tokens\":{\"input\":1,\"output\":1},\"cost_usd\":0.0}\\\\n\\'\\n')\n+    run_path.chmod(0o755)\n+    commit_all(root, \"a tenant-side adapter that commits only once told\")\n+    run = run_attavo(root, \"build\", \"1\")\n+    assert run.returncode == 0, run.stdout + run.stderr\n+    rec = latest_build(root)\n+    assert (rec[\"status\"], rec[\"iterations\"]) == (\"pass\", 2), rec\n+    assert rec[\"sha\"] != rec[\"start_sha\"]\ndiff --git a/tests/test_cli_help.py b/tests/test_cli_help.py\nindex cdfe42a..6994db3 100644\n--- a/tests/test_cli_help.py\n+++ b/tests/test_cli_help.py\n@@ -84,3 +84,13 @@ def test_help_names_the_test_modes_the_cache_and_the_transport_refusal() -> None\n     assert \"attavo test [N] [--all | <test>...] [--fresh]\" in run.stdout, run.stdout\n     for phrase in (\"--fresh\", \"unchanged\", \"exclude_in_executor\", \"ATTAVO_STAGE\", \"refuse\"):\n         assert phrase in run.stdout, phrase\n+\n+\n+def test_help_names_the_seventh_proof_and_the_empty_stop() -> None:\n+    \"\"\"Item 227: the doctor's seventh proof and the empty stop class. Red on\n+    the tree and on the stub: the words are the build's.\"\"\"\n+    run = subprocess.run([sys.executable, str(ATTAVO), \"--help\"],\n+                         capture_output=True, text=True, check=False)\n+    assert run.returncode == 0\n+    for phrase in (\"no attested item is empty\", \"built_since\", \"committed nothing\", \"reads the commit\"):\n+        assert phrase in run.stdout, phrase\ndiff --git a/tests/test_doctor.py b/tests/test_doctor.py\nindex c9bc62e..e00f518 100644\n--- a/tests/test_doctor.py\n+++ b/tests/test_doctor.py\n@@ -941,3 +941,144 @@ def test_doctor_refuses_a_drive_table_without_attempts(tmp_path: Path) -> None:\n     p = run_doctor(root)[\"no-invocation-lacks-record\"]\n     assert not p[\"holds\"]\n     assert \"attempts\" in p[\"reason\"]\n+\n+\n+# --- proof seven: no attested item is empty (item 227). Rejection tests,\n+# written red first against v0.29.0, whose doctor had six proofs and held\n+# over an attested item whose build committed nothing. ---\n+\n+\n+def _head(root: Path) -> str:\n+    return subprocess.run([\"git\", \"-C\", str(root), \"rev-parse\", \"HEAD\"], capture_output=True,\n+                          text=True, check=True).stdout.strip()\n+\n+\n+def _four_stage_item(root: Path, approval_sha: str, *, change: bool) -> tuple[str, str]:\n+    \"\"\"One item, four records, merged --no-ff; returns (merge_sha, build_sha).\n+    change=True lands a real content commit before the records, so the\n+    tree genuinely differs from approval_sha outside records/; change=False\n+    leaves the tree exactly as approval_sha left it -- item 227's own\n+    build, and item 229's own fix for a retried attempt that adds no\n+    commit of its own but already carries one.\"\"\"\n+    subprocess.run([\"git\", \"-C\", str(root), \"checkout\", \"-q\", \"-b\", \"attavo/1-x\"], check=True)\n+    if change:\n+        (root / \"changed.txt\").write_text(\"the item's own change\\n\")\n+        commit_all(root, \"the item's own change\")\n+    build_sha = _head(root)\n+    records = root / \"records\" / \"1\"\n+    records.mkdir(parents=True)\n+    (records / \"spec-01.json\").write_text(json.dumps({\"status\": \"pass\"}))\n+    (records / \"approval-01.json\").write_text(json.dumps({\"approved_by\": \"alice\"}))\n+    (records / \"build-01.json\").write_text(json.dumps(\n+        {\"status\": \"pass\", \"sha\": build_sha, \"start_sha\": approval_sha,\n+         \"approval_sha\": approval_sha}))\n+    (records / \"verify-01.json\").write_text(json.dumps({\"status\": \"pass\"}))\n+    commit_all(root, \"spec, approval, build, and verify records\")\n+    subprocess.run([\"git\", \"-C\", str(root), \"checkout\", \"-q\", \"main\"], check=True)\n+    subprocess.run([\"git\", \"-C\", str(root), \"merge\", \"-q\", \"--no-ff\", \"-m\",\n+                    \"Merge branch 'attavo/1-x'\", \"attavo/1-x\"], check=True)\n+    return _head(root), build_sha\n+\n+\n+def test_doctor_proof_seven_fails_on_an_attested_item_whose_build_committed_nothing(tmp_path: Path) -> None:\n+    root = tmp_path / \"empty_item\"\n+    root.mkdir()\n+    (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n')\n+    init_repo(root, \"install\")\n+    approval_sha = _head(root)\n+    merge, _ = _four_stage_item(root, approval_sha, change=False)\n+    report = run_doctor(root)\n+    assert \"no-attested-item-is-empty\" in report, sorted(report)\n+    p = report[\"no-attested-item-is-empty\"]\n+    assert not p[\"holds\"], p\n+    assert \"item 1\" in p[\"reason\"] and \"nothing was built\" in p[\"reason\"] and merge[:12] in p[\"reason\"], p[\"reason\"]\n+\n+\n+def test_doctor_proof_seven_holds_on_a_build_that_names_a_change_and_names_the_specimen_before_its_window(tmp_path: Path) -> None:\n+    built = tmp_path / \"built_item\"\n+    built.mkdir()\n+    (built / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n')\n+    init_repo(built, \"install\")\n+    _four_stage_item(built, _head(built), change=True)\n+    p = run_doctor(built)[\"no-attested-item-is-empty\"]\n+    assert p[\"holds\"], p[\"reason\"]\n+    assert p[\"built\"] == [\"1\"], p\n+\n+    windowed = tmp_path / \"windowed_item\"\n+    windowed.mkdir()\n+    (windowed / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n')\n+    init_repo(windowed, \"install\")\n+    approval_sha = _head(windowed)\n+    merge, _ = _four_stage_item(windowed, approval_sha, change=False)\n+    toml = windowed / \"attavo.toml\"\n+    toml.write_text(toml.read_text() + f'\\n[doctor]\\nbuilt_since = \"{merge[:12]}\"\\n')\n+    commit_all(windowed, \"declare the window after the specimen\")\n+    p = run_doctor(windowed)[\"no-attested-item-is-empty\"]\n+    assert p[\"holds\"], p[\"reason\"]\n+    assert p[\"before_window\"] == [\"1\"] and \"before the window\" in p[\"reason\"], p\n+\n+\n+def test_doctor_proof_seven_treats_a_retried_attempt_that_adopts_a_prior_commit_as_not_empty(\n+        tmp_path: Path) -> None:\n+    \"\"\"Item 229: a build record whose sha equals its own start_sha is not\n+    empty when that tree already differs from the approval -- a retried\n+    attempt whose head already carries a prior attempt's valid commit\n+    owes no commit of its own (item 227's own counsel question).\"\"\"\n+    root = tmp_path / \"adopted_item\"\n+    root.mkdir()\n+    (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n')\n+    init_repo(root, \"install\")\n+    approval_sha = _head(root)\n+    subprocess.run([\"git\", \"-C\", str(root), \"checkout\", \"-q\", \"-b\", \"attavo/1-x\"], check=True)\n+    (root / \"changed.txt\").write_text(\"a prior attempt's own valid commit\\n\")\n+    commit_all(root, \"a prior attempt's own valid commit\")\n+    retry_start_sha = _head(root)\n+    records = root / \"records\" / \"1\"\n+    records.mkdir(parents=True)\n+    (records / \"spec-01.json\").write_text(json.dumps({\"status\": \"pass\"}))\n+    (records / \"approval-01.json\").write_text(json.dumps({\"approved_by\": \"alice\"}))\n+    (records / \"build-02.json\").write_text(json.dumps(\n+        {\"status\": \"pass\", \"sha\": retry_start_sha, \"start_sha\": retry_start_sha,\n+         \"approval_sha\": approval_sha}))\n+    (records / \"verify-01.json\").write_text(json.dumps({\"status\": \"pass\"}))\n+    commit_all(root, \"spec, approval, build, and verify records\")\n+    subprocess.run([\"git\", \"-C\", str(root), \"checkout\", \"-q\", \"main\"], check=True)\n+    subprocess.run([\"git\", \"-C\", str(root), \"merge\", \"-q\", \"--no
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,120p' /Users/davidbean/Projects/attest/attavo/counsel.py\nsed -n '205,270p' /Users/davidbean/Projects/attest/attavo/counsel.py\nsed -n '1,130p' /Users/davidbean/Projects/attest/attavo/records.py\nrg -n 'started|in progress|latest_stop_record|no .*record|counsel.*refus' /Users/davidbean/Projects/attest/tests/test_counsel.py /Users/davidbean/Projects/attest/attavo/counsel.py /Users/davidbean/Projects/attest/attavo/records.py\nsed -n '1,120p' /Users/davidbean/Projects/attest/tests/test_counsel.py\"","aggregated_output":"from __future__ import annotations\n\nimport json\nimport os\nimport shlex\nimport subprocess\nimport sys\nimport tempfile\nimport time\nfrom pathlib import Path\nfrom typing import Any, cast\n\nfrom attavo.build import (\n    adapter_reports,\n    merge_adapter_config,\n    resolve_adapter,\n    split_adapter_stdout,\n)\nfrom attavo.common import MANIFEST, PRODUCT_ROOT, derive_item_id, git, now_iso, read_manifest\nfrom attavo.records import latest_attempt_path, latest_record, write_record\nfrom attavo.types import SpecRecord, StageRecord\nfrom attavo.verify import diff_since_approval, read_forge_checks\n\n# --- counsel: a stop is read inside the product first, before a person\n# (issue #100). Read-only -- it commits nothing and writes nothing outside\n# paths.records/<N>/ -- and it never acts: it proposes a ruling, a patch,\n# or names the one-line question a person must answer. ---\n\nCOUNSEL_STAGES = (\"build\", \"verify\")\n\n\ndef latest_non_pass_stage_record(records_dir: Path) -> tuple[str | None, StageRecord | None, Path | None]:\n    \"\"\"(stage, record, path) for the item's most recent non-pass build or\n    verify record, by its own \"at\" timestamp -- or, when neither stage\n    carries one, the item's latest refused spec-gate record (issue #133):\n    a refused gate is the same shape of stop, earlier, and it is read only\n    once a build or verify record exists to counsel first, since either\n    one already implies the gate that produced it passed. (None, None,\n    None) when none of the three exists. \"Most recent\" rather than\n    \"build, else verify\" so a stop on the stage that ran later (typically\n    verify, bound to a build that already passed) is the one counseled.\"\"\"\n    candidates: list[tuple[str, StageRecord, Path]] = []\n    for stage in COUNSEL_STAGES:\n        path = latest_attempt_path(records_dir, stage)\n        if path is None:\n            continue\n        # A path exists, so the record read from the same files does too.\n        rec = cast(StageRecord, latest_record(records_dir, stage))\n        if rec.get(\"status\") == \"pass\":\n            continue\n        candidates.append((stage, rec, path))\n    if candidates:\n        candidates.sort(key=lambda c: c[1].get(\"at\") or \"\")\n        return candidates[-1]\n    spec_path = latest_attempt_path(records_dir, \"spec\")\n    if spec_path is not None:\n        spec_rec = cast(SpecRecord, latest_record(records_dir, \"spec\"))\n        if spec_rec.get(\"status\") == \"refused\":\n            return \"spec\", spec_rec, spec_path\n    return None, None, None\n\n\ndef latest_stage_record(records_dir: Path) -> tuple[str | None, StageRecord | None, Path | None]:\n    \"\"\"(stage, record, path) for the item's most recent build or verify\n    record regardless of status, by its own \"at\" timestamp -- or, when\n    neither stage carries one, the item's latest spec-gate record,\n    regardless of status. The evidence set `attavo counsel --ask` reads\n    over (issue #175): a question is not bound to a stop, so the pass\n    filter latest_non_pass_stage_record applies does not apply here.\n    (None, None, None) when the item carries no record of any of the\n    three stages yet.\"\"\"\n    candidates: list[tuple[str, StageRecord, Path]] = []\n    for stage in COUNSEL_STAGES:\n        path = latest_attempt_path(records_dir, stage)\n        if path is None:\n            continue\n        candidates.append((stage, cast(StageRecord, latest_record(records_dir, stage)), path))\n    if candidates:\n        candidates.sort(key=lambda c: c[1].get(\"at\") or \"\")\n        return candidates[-1]\n    spec_path = latest_attempt_path(records_dir, \"spec\")\n    if spec_path is not None:\n        return \"spec\", cast(SpecRecord, latest_record(records_dir, \"spec\")), spec_path\n    return None, None, None\n\n\ndef counsel_forge_evidence(root: Path, forge_cfg: dict[str, Any], sha: str | None, tmp: Path\n                          ) -> tuple[dict[str, Any], Path]:\n    \"\"\"(forge, checks_path) -- issue #175. forge is the summary counsel's\n    own record carries: {\"read\", \"reason\", \"checks\"}, \"checks\" a list of\n    {\"name\", \"conclusion\"} pairs. checks_path is always written, under\n    tmp, as ATTAVO_COUNSEL_CHECKS: a JSON {\"read\", \"reason\", \"checks\"}\n    envelope whose own \"checks\" carry the richer {\"name\", \"conclusion\",\n    \"run_url\", \"log\"} shape the adapter reads -- \"log\" naming a sibling\n    file under tmp with that check's own failed-step log, fetched through\n    [forge].check_log_command for every check not \"success\". Absent\n    [forge].checks_command, absent [forge].check_log_command, or a\n    counseled record with no sha of its own: read is false and reason\n    names exactly which is missing -- never a checks list a reader could\n    mistake for \"all clear\" (an empty list from a real, successful read\n    is not this; that is read: true, checks: []).\"\"\"\n    checks_command = forge_cfg.get(\"checks_command\")\n    check_log_command = forge_cfg.get(\"check_log_command\")\n    checks_path = tmp / \"checks.json\"\n\n    if not checks_command:\n        reason = \"not read: no [forge].checks_command\"\n    elif not check_log_command:\n        reason = \"not read: no [forge].check_log_command\"\n    elif not sha:\n        reason = \"not read: the counseled record carries no sha\"\n    else:\n        reason = None\n\n    if reason is not None:\n        envelope = {\"read\": False, \"reason\": reason, \"checks\": []}\n        checks_path.write_text(json.dumps(envelope, indent=2) + \"\\n\")\n        return envelope, checks_path\n\n    # reason is None only when checks_command, check_log_command, and sha are all set.\ndef cmd_counsel(argv: list[str]) -> int:\n    root = Path(\".\").resolve()\n    ask: str | None = None\n    positional: list[str] = []\n    i = 0\n    while i < len(argv):\n        if argv[i] == \"--ask\":\n            ask = argv[i + 1] if i + 1 < len(argv) else None\n            i += 2\n        else:\n            positional.append(argv[i])\n            i += 1\n    item_id = positional[0] if positional else derive_item_id(root)\n    if not item_id:\n        print(\"attavo counsel: cannot derive item id; pass N or run on an attavo/N-* branch\",\n              file=sys.stderr)\n        return 2\n    if ask is not None and not ask.strip():\n        print(\"attavo counsel: --ask requires non-empty text\", file=sys.stderr)\n        return 2\n    m = read_manifest(root)\n    if m is None:\n        print(f\"attavo counsel: no {MANIFEST} at {root}\", file=sys.stderr)\n        return 2\n\n    specs_rel = m[\"paths\"][\"specs\"]\n    records_rel = m[\"paths\"][\"records\"]\n    item_records_dir = root / records_rel / item_id\n\n    # issue #175: --ask reads the item's latest records regardless of\n    # status -- a question is not bound to a stop -- everything else\n    # about the evidence set and the write is shared with the stop path.\n    if ask is not None:\n        stage, stop_record, record_path = latest_stage_record(item_records_dir)\n        no_record_msg = f\"no build, verify, or spec-gate record for item {item_id}\"\n    else:\n        stage, stop_record, record_path = latest_non_pass_stage_record(item_records_dir)\n        no_record_msg = f\"no non-pass build, verify, or spec-gate record for item {item_id}\"\n    if stop_record is None:\n        print(f\"attavo counsel: refused: {no_record_msg}\")\n        return 1\n    # latest_*_stage_record returns all three of (stage, record, path) or none.\n    stage, record_path = cast(str, stage), cast(Path, record_path)\n\n    executor = m.get(\"executor\") or {}\n    adapter_name = executor.get(\"counsel\") or executor.get(\"verify\")\n    if not adapter_name:\n        print(\"attavo counsel: refused: no [executor].counsel or [executor].verify \"\n              \"in the manifest\")\n        return 1\n    adapter_path = resolve_adapter(root, adapter_name)\n    if adapter_path is None:\n        print(f\"attavo counsel: refused: no adapter named {adapter_name!r}\")\n        return 1\n\n    adapter_config = merge_adapter_config(m, adapter_name, \"counsel\")\n    reports = adapter_reports(adapter_path)\n    spec_dir = root / specs_rel / item_id\n    log_path = record_path.with_suffix(\".log\")\n\n    diff_text, diff_refusal = diff_since_approval(root, stop_record.get(\"approval_sha\"))\n    if diff_refusal:\n        print(f\"attavo counsel: refused: {diff_refusal}\")\n        return 1\n\n    forge_cfg = m.get(\"forge\") or {}\nfrom __future__ import annotations\n\nimport json\nimport re\nfrom collections.abc import Mapping\nfrom pathlib import Path\nfrom typing import Any, Literal, cast, overload\n\nfrom attavo.common import PRODUCT_ROOT, product_version\nfrom attavo.types import ApprovalRecord, BuildRecord, CounselRecord, SpecRecord, VerifyRecord\n\n# --- record files: <stage>-NN.json, one per attempt, never overwritten ---\n\nSCHEMA_RECORDS_DIR = PRODUCT_ROOT / \"schema\" / \"records\"\n\n\ndef stage_schema(stage: str) -> dict[str, Any]:\n    \"\"\"schema/records/<stage>.schema.json -- this repository's own\n    declaration of that stage's record shape (issue #60). The only\n    artifact the outbound contract needs; there is no accessor for it\n    beyond reading the file.\"\"\"\n    schema: dict[str, Any] = json.loads((SCHEMA_RECORDS_DIR / f\"{stage}.schema.json\").read_text())\n    return schema\n\n\ndef schema_id_version(schema: dict[str, Any]) -> int:\n    \"\"\"The trailing integer of a schema's $id (\".../records/build/2\" -> 2)\n    -- the single place a record shape's version lives. write_record reads\n    this at call time rather than carrying its own copy, so the version it\n    stamps cannot drift from what the schema declares (issue #60).\"\"\"\n    return int(schema[\"$id\"].rsplit(\"/\", 1)[-1])\n\n\nclass RecordItemMismatch(RuntimeError):\n    \"\"\"A record's item field disagrees with the directory it was read\n    from (issue #60, acceptance 5) -- a misfiled or copied record, refused\n    rather than trusted.\"\"\"\n\n\ndef _load_record(path: Path, item_id: str) -> dict[str, Any]:\n    \"\"\"The one place in this repository that turns a record file's bytes\n    into a dict (issue #60, acceptance 6). Defaults record_version to 1\n    when absent -- version 1 is every record written before this release\n    and is never migrated -- and fills item from the directory when\n    absent; refuses when a present item disagrees with it.\"\"\"\n    data = json.loads(path.read_text())\n    data.setdefault(\"record_version\", 1)\n    item = data.get(\"item\")\n    if item is None:\n        data[\"item\"] = item_id\n    elif item != item_id:\n        raise RecordItemMismatch(\n            f\"{path}: item {item!r} disagrees with its directory {item_id!r}\")\n    return cast(dict[str, Any], data)\n\n\n# The typed loaders: a literal stage name selects the record kind the caller\n# gets back (issue #189). The record is read from a file and not validated\n# here, so the kind is the schema's promise, the same one the write side\n# already keeps (write_record refuses a key its schema does not declare);\n# a stage held in a variable is the untyped fallback.\n@overload\ndef parse_attempts(records_dir: Path, stage: Literal[\"spec\"]) -> dict[int, SpecRecord]: ...\n@overload\ndef parse_attempts(records_dir: Path, stage: Literal[\"approval\"]) -> dict[int, ApprovalRecord]: ...\n@overload\ndef parse_attempts(records_dir: Path, stage: Literal[\"build\"]) -> dict[int, BuildRecord]: ...\n@overload\ndef parse_attempts(records_dir: Path, stage: Literal[\"verify\"]) -> dict[int, VerifyRecord]: ...\n@overload\ndef parse_attempts(records_dir: Path, stage: Literal[\"counsel\"]) -> dict[int, CounselRecord]: ...\n@overload\ndef parse_attempts(records_dir: Path, stage: str) -> dict[int, Any]: ...\ndef parse_attempts(records_dir: Path, stage: str) -> dict[int, Any]:\n    attempts: dict[int, Any] = {}\n    if not records_dir.is_dir():\n        return attempts\n    for f in records_dir.glob(f\"{stage}-*.json\"):\n        m = RECORD_RE.match(f.name)\n        if not m or m.group(1) != stage:\n            continue\n        try:\n            attempts[int(m.group(2))] = _load_record(f, records_dir.name)\n        except json.JSONDecodeError:\n            continue\n    return attempts\n\n\n@overload\ndef latest_record(records_dir: Path, stage: Literal[\"spec\"]) -> SpecRecord | None: ...\n@overload\ndef latest_record(records_dir: Path, stage: Literal[\"approval\"]) -> ApprovalRecord | None: ...\n@overload\ndef latest_record(records_dir: Path, stage: Literal[\"build\"]) -> BuildRecord | None: ...\n@overload\ndef latest_record(records_dir: Path, stage: Literal[\"verify\"]) -> VerifyRecord | None: ...\n@overload\ndef latest_record(records_dir: Path, stage: Literal[\"counsel\"]) -> CounselRecord | None: ...\n@overload\ndef latest_record(records_dir: Path, stage: str) -> Any | None: ...\ndef latest_record(records_dir: Path, stage: str) -> Any:\n    attempts = parse_attempts(records_dir, stage)\n    return attempts[max(attempts)] if attempts else None\n\n\ndef next_attempt_number(records_dir: Path, stage: str) -> int:\n    attempts = parse_attempts(records_dir, stage)\n    return (max(attempts) + 1) if attempts else 1\n\n\ndef latest_attempt_path(records_dir: Path, stage: str) -> Path | None:\n    \"\"\"The path of the highest-numbered <stage>-NN.json, or None.\"\"\"\n    attempts = parse_attempts(records_dir, stage)\n    if not attempts:\n        return None\n    return records_dir / f\"{stage}-{max(attempts):02d}.json\"\n\n\ndef write_record(records_dir: Path, stage: str, record: Mapping[str, Any], m: dict[str, Any],\n                 item: str, log: str | None = None) -> Path:\n    \"\"\"Every record gains record_version (this stage schema's own $id\n    version -- issue #60) and item (verbatim from the caller, matching the\n    record's directory segment), plus product_version (what ran, derived\n    here) and product_pin (what the tenant declared, copied verbatim from\n    the manifest, or null when the manifest carries no [attavo] table) --\n    the latter two recorded, never enforced (issue #49). A manifest\n    missing the table is an absent fact, not a crash: this is the one\n    caller of write_record that must not raise on a shape the manifest\n    schema forbids but tomllib.load happily returns.\n\n/Users/davidbean/Projects/attest/attavo/counsel.py:70:    (None, None, None) when the item carries no record of any of the\n/Users/davidbean/Projects/attest/attavo/counsel.py:239:        no_record_msg = f\"no build, verify, or spec-gate record for item {item_id}\"\n/Users/davidbean/Projects/attest/attavo/counsel.py:242:        no_record_msg = f\"no non-pass build, verify, or spec-gate record for item {item_id}\"\n/Users/davidbean/Projects/attest/attavo/counsel.py:244:        print(f\"attavo counsel: refused: {no_record_msg}\")\n/Users/davidbean/Projects/attest/attavo/counsel.py:252:        print(\"attavo counsel: refused: no [executor].counsel or [executor].verify \"\n/Users/davidbean/Projects/attest/attavo/counsel.py:257:        print(f\"attavo counsel: refused: no adapter named {adapter_name!r}\")\n/Users/davidbean/Projects/attest/attavo/counsel.py:267:        print(f\"attavo counsel: refused: {diff_refusal}\")\n/Users/davidbean/Projects/attest/attavo/counsel.py:273:    started = time.monotonic()\n/Users/davidbean/Projects/attest/attavo/counsel.py:346:        \"wall_clock_s\": round(time.monotonic() - started, 3),\n/Users/davidbean/Projects/attest/tests/test_counsel.py:109:def test_counsel_refuses_without_a_non_pass_record(tmp_path: Path) -> None:\n/Users/davidbean/Projects/attest/tests/test_counsel.py:117:    assert \"no non-pass build, verify, or spec-gate record\" in run.stdout\n/Users/davidbean/Projects/attest/tests/test_counsel.py:121:def test_counsel_refuses_when_the_latest_record_is_a_pass(tmp_path: Path) -> None:\n/Users/davidbean/Projects/attest/tests/test_counsel.py:123:    it rests on -- carries nothing to counsel -- refused the same as an\n/Users/davidbean/Projects/attest/tests/test_counsel.py:124:    item with no record at all: the spec-gate fallback only ever reads a\n/Users/davidbean/Projects/attest/tests/test_counsel.py:134:    assert \"no non-pass build, verify, or spec-gate record\" in run.stdout\n/Users/davidbean/Projects/attest/tests/test_counsel.py:137:def test_counsel_answers_a_refused_spec_gate_record_when_no_build_or_verify_exists(tmp_path: Path) -> None:\n/Users/davidbean/Projects/attest/tests/test_counsel.py:141:    express). counsel reads it as the earliest stop, citing the refusal\n/Users/davidbean/Projects/attest/tests/test_counsel.py:317:def test_counsel_refuses_without_an_executor_counsel_or_verify_adapter(tmp_path: Path) -> None:\n/Users/davidbean/Projects/attest/tests/test_counsel.py:318:    \"\"\"No [executor].counsel and no [executor].verify -- refused by name,\n\"\"\"attavo counsel: a stop is read inside the product first, before a\nperson (issue #100). A read-only invocation of the tenant's\n[executor].counsel adapter (defaulting to [executor].verify) on the\nitem's latest non-pass build or verify record -- it commits nothing and\nwrites nothing outside paths.records/<N>/. Every test here uses the\nfixture adapter, with a canned counsel response supplied through\nATTAVO_FIXTURE_COUNSEL_RESPONSE where the verdict shape matters.\n\nRejection tests, written and run red first: on `main` before this issue\nthere was no `counsel` subcommand, so every one of these failed with\n\"unknown subcommand\".\n\nRun: python3 -m pytest tests -q\n\"\"\"\nimport json\nimport subprocess\nimport sys\nfrom pathlib import Path\nfrom typing import Any, cast\n\nimport jsonschema\n\nfrom helpers import FIXTURES, commit_all, make_tenant\n\nROOT = Path(__file__).resolve().parent.parent\nATTAVO = ROOT / \"bin\" / \"attavo\"\nCOUNSEL_SCHEMA = json.loads((ROOT / \"schema\" / \"records\" / \"counsel.schema.json\").read_text())\n\n\ndef run_attavo(root: Path, *args: str, env: dict[str, Any] | None = None) -> subprocess.CompletedProcess[str]:\n    import os\n    full_env = dict(os.environ)\n    if env:\n        full_env.update(env)\n    return subprocess.run([sys.executable, str(ATTAVO), *args], cwd=str(root),\n                          capture_output=True, text=True, check=False, env=full_env)\n\n\ndef write_probe_adapter(root: Path, name: str, script: str) -> None:\n    \"\"\"A tenant-local adapter override under attavo/adapters/<name>/run\n    (resolve_adapter's own tenant-first search, same pattern\n    tests/test_verify.py's \"silent\"/\"loud\" adapters use) -- for a probe\n    that inspects the evidence files counsel hands it. adapters/fixture/run\n    is a shared fixture this lane's own files list does not include, so a\n    probe that needs to see ATTAVO_COUNSEL_CHECKS or ATTAVO_COUNSEL_GRAPH\n    lives here instead of there.\"\"\"\n    adapter_dir = root / \"attavo\" / \"adapters\" / name\n    adapter_dir.mkdir(parents=True)\n    adapter_run = adapter_dir / \"run\"\n    adapter_run.write_text(script)\n    adapter_run.chmod(0o755)\n\n\ndef use_counsel_adapter(root: Path, name: str) -> None:\n    toml = root / \"attavo.toml\"\n    toml.write_text(toml.read_text().replace(\n        '[executor]\\nbuild = \"fixture\"', f'[executor]\\nbuild = \"fixture\"\\ncounsel = \"{name}\"'))\n    commit_all(root, f\"use the {name} counsel adapter\")\n\n\ndef configure_forge(root: Path, checks_command: str, check_log_command: str | None = None) -> None:\n    text = (root / \"attavo.toml\").read_text() + f'\\n[forge]\\nchecks_command = \"{checks_command}\"\\n'\n    if check_log_command is not None:\n        text += f'check_log_command = \"{check_log_command}\"\\n'\n    (root / \"attavo.toml\").write_text(text)\n    commit_all(root, \"configure the forge read\")\n\n\ndef configure_counsel_adapter(root: Path) -> None:\n    \"\"\"[executor].counsel = \"fixture\" -- build_valid's own manifest\n    declares [executor].build = \"fixture\" only; counsel needs its own\n    adapter named, per the lane's own default ([executor].verify, absent\n    here, so this is the only way build_valid gets a counsel adapter at\n    all).\"\"\"\n    toml = root / \"attavo.toml\"\n    toml.write_text(toml.read_text().replace(\n        '[executor]\\nbuild = \"fixture\"', '[executor]\\nbuild = \"fixture\"\\ncounsel = \"fixture\"'))\n    commit_all(root, \"configure the counsel adapter\")\n\n\ndef records_dir(root: Path, item: str = \"1\") -> Path:\n    return root / \"records\" / item\n\n\ndef approve_and_halt(root: Path, question: str = \"which overlay wins?\") -> None:\n    assert run_attavo(root, \"spec-gate\", \"1\").returncode == 0\n    assert run_attavo(root, \"approve\", \"1\", \"--by\", \"alice\").returncode == 0\n    build = run_attavo(root, \"build\", \"1\", env={\"ATTAVO_FIXTURE_QUESTION\": question})\n    assert build.returncode == 3, build.stdout + build.stderr\n\n\ndef write_counsel_response(tmp_path: Path, response: dict[str, Any]) -> Path:\n    path = tmp_path / \"counsel_response.json\"\n    path.write_text(json.dumps(response))\n    return path\n\n\ndef canned(verdict: str, **kwargs: Any) -> dict[str, Any]:\n    base: dict[str, Any] = {\n        \"model\": \"fixture\", \"model_version\": None, \"adapter_version\": \"fixture-1\",\n        \"tokens\": {\"input\": 1, \"output\": 1}, \"cost_usd\": 0.0,\n        \"class\": \"unclassed\", \"verdict\": verdict,\n        \"citations\": [], \"proposal\": {\"ruling_text\": None, \"patch\": None, \"question\": None},\n    }\n    base.update(kwargs)\n    return base\n\n\ndef test_counsel_refuses_without_a_non_pass_record(tmp_path: Path) -> None:\n    \"\"\"Acceptance row 2 (half). A fresh item with no build, verify, or\n    spec-gate record at all -- refused by name, nothing written.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    configure_counsel_adapter(root)\n\n    run = run_attavo(root, \"counsel\", \"1\")\n    assert run.returncode == 1\n    assert \"no non-pass build, verify, or spec-gate record\" in run.stdout\n    assert not records_dir(root).exists() or list(records_dir(root).glob(\"counsel-*.json\")) == []\n\n\n","exit_code":0,"status":"completed"}}

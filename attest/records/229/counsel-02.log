n\":\"completed\",\"fast_mode_state\":\"off\",\"fast_mode_disabled_reason\":\"sdk_opt_in_required\",\"subagent_stats\":{\"spawned\":0,\"requested\":{\"background\":0,\"foreground\":0,\"unset\":0},\"started_in_background\":0,\"max_depth\":0,\"spawned_by_subagents\":0,\"completed\":0,\"failed\":0,\"killed\":{\"parent\":0,\"user\":0,\"system\":0},\"refused\":{\"depth_limit\":0,\"concurrency_limit\":0,\"budget\":0},\"by_type\":{}},\"is_error\":false,\"num_turns\":12,\"subtype\":\"success\",\"api_error_status\":null,\"result\":\"{\\\"status\\\":\\\"done\\\",\\\"question\\\":null}\",\"structured_output\":{\"status\":\"done\",\"question\":null},\"ttft_ms\":3554,\"type\":\"result\",\"duration_ms\":196193,\"uuid\":\"5d674df2-b2d0-45c7-bf79-38a2e7f2e891\",\"ttft_stream_ms\":2522,\"time_to_request_ms\":36,\"first_content_frame_ms\":2523,\"queued_turn_count\":0,\"result_index\":0}\n            # build` must not reach it by inheritance either.\n            env.pop(\"ATTAVO_CHECKS_COMMAND\", None)\n            env[\"ATTAVO_SPEC_DIR\"] = str(spec_dir)\n            env[\"ATTAVO_RECORDS_DIR\"] = str(item_records_dir)\n            env[\"ATTAVO_RULINGS\"] = str(root / m[\"paths\"][\"rulings\"])\n            env[\"ATTAVO_BRANCH\"] = branch\n            env[\"ATTAVO_ITERATION\"] = str(iteration)\n            env[\"ATTAVO_FEEDBACK\"] = str(feedback_path)\n            env[\"ATTAVO_ADAPTER_CONFIG\"] = json.dumps(adapter_config)\n            env[\"ATTAVO_STAGE\"] = \"build\"\n            env[\"ATTAVO_EVENTS\"] = str(events_path)\n            env[\"ATTAVO_TEST_COMMAND\"] = f\"python3 {PRODUCT_ROOT / 'bin' / 'attavo'} test {item_id}\"\n            if tests_cfg.get(\"call_timeout_s\"):\n                env[\"ATTAVO_TEST_TIMEOUT_S\"] = str(tests_cfg[\"call_timeout_s\"])\n            else:\n                env.pop(\"ATTAVO_TEST_TIMEOUT_S\", None)\n            env[\"GIT_AUTHOR_NAME\"] = identity[\"name\"]\n            env[\"GIT_AUTHOR_EMAIL\"] = identity[\"email\"]\n            env[\"GIT_COMMITTER_NAME\"] = identity[\"name\"]\n            env[\"GIT_COMMITTER_EMAIL\"] = identity[\"email\"]\n\n            run = subprocess.run([str(adapter_path)], cwd=str(root), env=env,\n                                 capture_output=True, text=True, check=False)\n            transcript, payload = split_adapter_stdout(run.stdout)\n            if run.returncode != 0:\n                # The guarantee behind issue #53's refusal: an adapter that\n                # exits non-zero always leaves a non-empty log, even one\n                # that printed nothing at all on stderr.\n                detail = f\"[adapter exited {run.returncode}]\"\n                if run.stderr.strip():\n                    detail += \"\\n\" + run.stderr.rstrip(\"\\n\")\n                transcript = (transcript + \"\\n\" if transcript else \"\") + detail\n            transcripts.append(transcript)\n\n            if run.returncode != 0 or payload is None or not payload.get(\"model\"):\n                status_out = \"failed\"\n                break\n\n            adapter_version = payload.get(\"adapter_version\")\n            model = payload.get(\"model\")\n            model_version = payload.get(\"model_version\")\n            tok = payload.get(\"tokens\") or {}\n            tokens[\"input\"] += tok.get(\"input\", 0) or 0\n            tokens[\"output\"] += tok.get(\"output\", 0) or 0\n            iter_cost = payload.get(\"cost_usd\")\n            if iter_cost is not None:\n                cost_usd = (cost_usd or 0) + iter_cost\n\n            if payload.get(\"status\") == \"question\":\n                status_out = \"halted\"\n                halted = {\"question\": payload.get(\"question\")}\n                break\n\n            foreign = next((c for c in commits_since(root, start_sha)\n                           if c[\"name\"] != identity[\"name\"] or c[\"email\"] != identity[\"email\"]),\n                          None)\n            if foreign:\n                status_out = \"refused\"\n                refusal = f\"commit {foreign['sha']} not authored by the executor\"\n                break\n\n            protected = protected_path_touched(root, start_sha, records_rel, specs_rel)\n            if protected:\n                status_out = \"refused\"\n                refusal = protected\n                refusal_provenance = \"executor\"\n                break\n\n            touched = sorted(changed_paths(root, start_sha, records_rel))\n            bad_path = next((p for p in touched if not matches_a_claim(p, claims)), None)\n            if bad_path:\n                status_out = \"refused\"\n                refusal = bad_path\n                break\n\n            criteria_results = [\n                {\"name\": name, \"exit\": run_criterion(spec_dir / \"criteria\" / name, root)}\n                for name in criteria_names]\n            for c in criteria_results:\n                append_event(events_path, \"gate\", f\"{c['name']}: exit {c['exit']}\")\n\n            select_in = \"\".join(p + \"\\n\" for p in touched)\n            select_run = subprocess.run(tests_cfg[\"select\"], shell=True, cwd=str(root),\n                                        input=select_in, capture_output=True,\n                                        text=True, check=False)\n            identifiers = [l for l in select_run.stdout.splitlines() if l.strip()]\n    text = text or \"\"\n    for name in STOP_CLASSES:\n        markers = CLASS_TEXT_MARKERS.get(name, (name,))\n        if any(marker in text for marker in markers):\n            return name\n    return None\n\n\ndef derive_stop(status: str, *, refusal: str | None = None, halted: dict[str, Any] | None = None,\n                log: str | None = None, report_class: str | None = None,\n                refusal_provenance: str | None = None) -> Stop | None:\n    \"\"\"The stop field for a build or verify record: None for status \"pass\",\n    else {class, provenance, detail} from what the caller already knows.\n\n      - report_class -- payload.get(\"class\") off the adapter's own report\n        line (issue #88, #94), when it names a STOP_CLASSES member -- is\n        that class, provenance \"executor\". build.schema.json and\n        verify.schema.json stay untouched by issue #88 on purpose, so the\n        class lives only on the report line, never a structured field\n        cmd_build or cmd_verify forwards on its own account; the caller\n        reads payload itself and passes this in, since only it still has\n        payload once an iteration ends. This is non-question's and\n        outlived-invocation's only path to a record now (issue #94):\n        CLASS_TEXT_MARKERS disables both for the text scan below, the\n        same way issue #93 disabled ceiling's bare-name match there. A\n        class an adapter does not yet put on its report line --\n        outlived-invocation today, since that refusal path prints no\n        report line at all -- falls to unclassed below, same as any\n        other unnamed cause, until the adapter that raises it puts a\n        class on the line the way non-question already does.\n      - a halt carrying a non-empty halted.question, once it is not a\n        non-question caught above, is a genuine question -- question/spec,\n        with the question's own first line as detail (issue #100's\n        followups). This is the specimen issue #100 itself was built to\n        retire: tenant zero's #663 build-01, a proper question, classed\n        unclassed/product and filed as a product defect with the wrong\n        provenance -- a question is about the definition of done, which is\n        a person's or a ruling's to answer, never the product's own\n        mechanism.\n      - failing that, a refusal or the log itself that already names its\n        class in text (issue #88, #93 for ceiling's own pre-emptive\n        refusal) is that class, provenance \"executor\" -- the log is\n        checked because neither adapter's refusal *field* carries the\n        class today; the class-naming line each adapter prints reaches\n        only the transcript\n      - a refusal that is not that -- the write-outside-claims path\n        itself, not the \"commit ... not authored by the executor\" shape\n        -- is claims-boundary/spec, unless the caller already knows this\n        refusal touched paths.records or paths.specs (issue #140:\n        protected_path_touched, checked ahead of the ordinary claims\n        match in cmd_build) and passes refusal_provenance=\"executor\" --\n        the product's own directories are not a claim a spec makes, so a\n        refusal there is not the spec's boundary to answer for\n      - a returned verify (the forge was not green; no adapter ran) is\n        forge-unconcluded/tenant\n      - an adapter exit whose log carries a declared-ceiling error line is\n        ceiling/product\n      - anything else is unclassed/product, with the log's last line\n        (capped at UNCLASSED_DETAIL_MAX_CHARS) as its detail -- the other\n        class that carries a detail, since every remaining class's\n        evidence already lives in refusal, halted, forge_checks, or the\n        log itself.\n    \"\"\"\n    if status == \"pass\":\n        return None\n    if status == \"returned\":\n        return {\"class\": \"forge-unconcluded\", \"provenance\": \"tenant\", \"detail\": None}\n    if report_class in STOP_CLASSES:\n        return {\"class\": report_class, \"provenance\": \"executor\", \"detail\": None}\n    question = (halted or {}).get(\"question\")\n    if status == \"halted\" and question:\n        return {\"class\": \"question\", \"provenance\": \"spec\",\n               \"detail\": question.splitlines()[0]}\n    known = _carries_a_known_class(refusal) or _carries_a_known_class(log)\n    if known:\n        return {\"class\": known, \"provenance\": \"executor\", \"detail\": None}\n    if status == \"refused\" and refusal is not None and not refusal.startswith(\"commit \"):\n        return {\"class\": \"claims-boundary\", \"provenance\": refusal_provenance or \"spec\",\n               \"detail\": None}\n    if log and any(marker in log.lower() for marker in CEILING_MARKERS):\n        return {\"class\": \"ceiling\", \"provenance\": \"product\", \"detail\": None}\n    return {\"class\": \"unclassed\", \"provenance\": \"product\", \"detail\": _log_last_line(log)}\n\n\ndef gate_stop(refusal: str | None) -> Stop:\n    \"\"\"The stop for a refused spec-gate record: class \"gate\", provenance\n    \"spec\", the refusal string itself as cause (issue #137) -- not\n    derive_stop's generic claims-boundary/spec fallback issue #133\n    reused, which named a boundary the record never crossed: \"criterion\n    fails against the tree plus stub: doctor-template-absent.sh\" is not\n    a write outside claims. cmd_spec_gate is untouched by this lane, so\n    a spec record still carries no stop field of its own; this is\n    synthesized wherever a refused one is read (item_stops,\n    cmd_file_stops, proof_no_stop_lacks_cause), never persisted.\"\"\"\n    return {\"class\": \"gate\", \"provenance\": \"spec\", \"detail\": refusal}\n\ndiff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml\nindex 60ef1f2..70a96ac 100644\n--- a/.github/workflows/ci.yml\n+++ b/.github/workflows/ci.yml\n@@ -57,6 +57,7 @@ jobs:\n           --deselect tests/test_doctor.py::test_no_commit_lacks_a_record\n           --deselect tests/test_doctor.py::test_no_stop_lacks_cause\n           --deselect tests/test_doctor.py::test_every_attested_item_is_sealed\n+          --deselect tests/test_doctor.py::test_no_attested_item_is_empty\n       - name: pytest end\n         if: steps.inherit.outputs.inherit != 'true'\n         run: echo \"PYTEST_END=$(date +%s)\" >> \"$GITHUB_ENV\"\ndiff --git a/adapters/fixture/run b/adapters/fixture/run\nindex 5a8fa5a..25128e7 100755\n--- a/adapters/fixture/run\n+++ b/adapters/fixture/run\n@@ -128,8 +128,14 @@ fi\n if [ \"$should_write\" = \"1\" ]; then\n   mkdir -p \"$(dirname \"$write_name\")\"\n   echo \"built\" > \"$write_name\"\n-  git add \"$write_name\"\n-  git commit -q -m \"fixture: write $write_name\"\n+  if [ -n \"${ATTAVO_FIXTURE_NO_COMMIT:-}\" ]; then\n+    # item 227's executor: the change written into the tree and never\n+    # committed, then \"done\" -- for the rejection tests only.\n+    :\n+  else\n+    git add \"$write_name\"\n+    git commit -q -m \"fixture: write $write_name\"\n+  fi\n fi\n \n echo '{\"status\":\"done\",\"question\":null,\"model\":\"fixture\",\"model_version\":null,\"adapter_version\":\"fixture-1\",\"tokens\":{\"input\":1,\"output\":1},\"cost_usd\":0.0}'\ndiff --git a/attavo.toml b/attavo.toml\nindex aba5b0e..e0c145f 100644\n--- a/attavo.toml\n+++ b/attavo.toml\n@@ -37,7 +37,7 @@ retires = [\n [tests]\n select = \"python3 .attavo/bin/select-tests\"\n call_timeout_s = 240\n-run = \"xargs -r python3 -m pytest -q --deselect tests/test_doctor.py::test_every_gate_rejects --deselect tests/test_doctor.py::test_one_item_traversed_every_stage --deselect tests/test_doctor.py::test_no_commit_lacks_a_record --deselect tests/test_doctor.py::test_no_stop_lacks_cause --deselect tests/test_doctor.py::test_every_attested_item_is_sealed\"\n+run = \"xargs -r python3 -m pytest -q --deselect tests/test_doctor.py::test_every_gate_rejects --deselect tests/test_doctor.py::test_one_item_traversed_every_stage --deselect tests/test_doctor.py::test_no_commit_lacks_a_record --deselect tests/test_doctor.py::test_no_stop_lacks_cause --deselect tests/test_doctor.py::test_every_attested_item_is_sealed --deselect tests/test_doctor.py::test_no_attested_item_is_empty\"\n \n [paths]\n specs = \"attest/specs\"\n@@ -45,6 +45,9 @@ records = \"attest/records\"\n rulings = \"attest/rulings.md\"\n rejections = \"attest/rejections\"\n \n+[doctor]\n+built_since = \"dae6d765f3d6\"\n+\n [operators]\n approvers = [\"dbean10\"]\n \ndiff --git a/attavo/build.py b/attavo/build.py\nindex a52b008..7f0e0e1 100644\n--- a/attavo/build.py\n+++ b/attavo/build.py\n@@ -1,7 +1,9 @@\n from __future__ import annotations\n \n import fnmatch\n+import contextlib\n import json\n+import shutil\n import os\n import shlex\n import subprocess\n@@ -9,7 +11,7 @@ import sys\n import tempfile\n import time\n from pathlib import Path\n-from typing import Any, cast\n+from typing import Any, Iterator, cast\n \n from attavo.approval import approval_status\n from attavo.common import (\n@@ -275,6 +277,30 @@ def _retry_seed(root: Path, m: dict[str, Any], records_dir: Path\n1:diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml\n5:@@ -57,6 +57,7 @@ jobs:\n13:diff --git a/adapters/fixture/run b/adapters/fixture/run\n17:@@ -128,8 +128,14 @@ fi\n34:diff --git a/attavo.toml b/attavo.toml\n38:@@ -37,7 +37,7 @@ retires = [\n47:@@ -45,6 +45,9 @@ records = \"attest/records\"\n57:diff --git a/attavo/build.py b/attavo/build.py\n61:@@ -1,7 +1,9 @@\n71:@@ -9,7 +11,7 @@ import sys\n80:@@ -275,6 +277,30 @@ def _retry_seed(root: Path, m: dict[str, Any], records_dir: Path\n111:@@ -418,6 +444,7 @@ def cmd_build(argv: list[str]) -> int:\n116:     iterations_used = 0\n119:@@ -498,6 +525,20 @@ def cmd_build(argv: list[str]) -> int:\n120:                 refusal = f\"commit {foreign['sha']} not authored by the executor\"\n125:+            # an empty iteration fails its gate on the approved tree and is\n126:+            # told why; an empty last iteration is halted, class empty\n140:@@ -512,29 +553,34 @@ def cmd_build(argv: list[str]) -> int:\n170:+            # behalf (item 227). Removed before the iteration ends.\n198:@@ -558,17 +604,29 @@ def cmd_build(argv: list[str]) -> int:\n199:             transcripts[-1] += (f\"\\n--- attavo gates, iteration {iteration} ---\\n\"\n213:             if iteration == BUILD_ITERATION_BUDGET:\n230:@@ -610,9 +668,11 @@ def cmd_build(argv: list[str]) -> int:\n243:diff --git a/attavo/cli.py b/attavo/cli.py\n247:@@ -54,6 +54,18 @@ tenant root and exits 1 until every proof holds:\n266:@@ -85,11 +97,21 @@ never supplies is a defect the conformance suite catches rather than a\n278:+criterion, a test, or a check on the executor's behalf. An iteration\n281:+the commit, and iterates; the last iteration ending that way halts the\n293:diff --git a/attavo/doctor.py b/attavo/doctor.py\n297:@@ -823,6 +823,75 @@ def proof_every_attested_item_is_sealed(root: Path, m: dict[str, Any] | None) ->\n373:@@ -830,7 +899,8 @@ def doctor(root: Path) -> list[Proof]:\n383:diff --git a/attavo/stops.py b/attavo/stops.py\n387:@@ -19,7 +19,7 @@ from attavo.types import CounselRecord, Stop\n396:diff --git a/attavo/verify.py b/attavo/verify.py\n400:@@ -201,6 +201,10 @@ def cmd_verify(argv: list[str]) -> int:\n411:diff --git a/attest/records/229/approval-01.json b/attest/records/229/approval-01.json\n416:@@ -0,0 +1,10 @@\n427:diff --git a/attest/records/229/build-01.started b/attest/records/229/build-01.started\n432:@@ -0,0 +1,7 @@\n440:diff --git a/attest/records/229/counsel-01.json b/attest/records/229/counsel-01.json\n445:@@ -0,0 +1,90 @@\n536:diff --git a/attest/records/229/counsel-01.log b/attest/records/229/counsel-01.log\n541:@@ -0,0 +1,14 @@\n548:+{\"type\":\"item.completed\",\"item\":{\"id\":\"item_2\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"sed -n '1,260p' attest/specs/229/spec.md && sed -n '1,260p' attest/rulings.md && sed -n '1,260p' /var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmpybh1_4ho/diff.patch && rg -n '229|spec-01|stop|log' attest/records/229 attest -g '*.json' | head -120 && find attest/records/229 -maxdepth 2 -type f -print\\\"\",\"aggregated_output\":\"## Problem\\n\\nOn 2026-09-27 item #227 was specified, approved at a commit, built by one invocation, judged by another, merged through the queue and sealed in the attestation store, and its change does not exist. The executor copied the item's stub into the working tree, ran tests in the background, answered `done`, and never committed (83 events, 32 tool calls, none of them `git add` or `git commit`). The build's gate ran the criteria, the selected tests and the tenant's checks in that working tree and passed them; the build record committed itself with `--only`, `sha` equal to `start_sha`; the review read a build that changed nothing and passed it; `attest` on the merge group checked the chain and sealed it; six doctor proofs held over it. Main carries `attest/specs/227/` and `attest/records/227/` and not one line of the change.\\n\\nEvery statement in that attestation is true and the attestation is worthless, because two things were never asked. Whether the gate reads the commit: it read the executor's directory, where a file written and never committed is indistinguishable from one that is on the branch. Whether a build built anything: nothing in build, verify, the pass or the doctor compares `sha` to `start_sha`.\\n\\nThis item asks both.\\n\\nThe gate reads the commit. Each iteration's criteria, selected tests and tenant checks run in a detached worktree of `HEAD` (`gate_checkout`: `git worktree add --detach`, removed when the iteration's gate is done), never in the executor's directory. A file written and not committed cannot pass a criterion, a test or a check on the executor's behalf; a tenant checks command that writes beside itself writes into the worktree and is gone with it. The pre-executor probe (`[checks].probe`) still runs against the approved tree in place, as it did.\\n\\nAn empty iteration is told so. When an iteration ends with `HEAD` equal to `start_sha`, the gate runs (on the approved tree, where the criteria already fail), the log and the feedback both carry \\\"you committed nothing: no commit since <start>; N path(s) modified or untracked in the working tree, which the gate does not read\\\" and \\\"commit your work; the gate reads the commit, not the tree\\\", and the loop continues. An executor that answers `done` before committing on its first iteration and commits on its second passes as before (`test_an_empty_iteration_is_fed_back_and_a_later_commit_passes`).\\n\\nAn empty build is halted. When the last iteration ends with `HEAD` equal to `start_sha`, the record is `halted` with a new stop class `empty`, provenance `executor`, detail \\\"the executor committed nothing; ...\\\" with the count of paths left in the tree. The class is the executor's, so counsel reads it and a steer retries it under R3; no new family. `STOP_CLASSES` and the build and verify schemas carry `empty` (build/9, verify/8). The status can never be `pass` with `sha` equal to `start_sha`.\\n\\nVerify refuses an empty build. A passing build record whose `sha` equals its `start_sha` is refused before any adapter runs: \\\"the latest build record names no change (sha equals start_sha ...); nothing to review\\\". The build no longer writes such a record; the refusal is verify's own guard against any record shaped this way, whoever wrote it.\\n\\nThe doctor's seventh proof: no attested item is empty. For every merged, fully-staged item, the passing build's `sha` is not its `start_sha`. `[doctor].built_since` names a commit at or before which merges are before the window: named on every run, never failed, so #227 stands on the record as the specimen and the tenant is not red forever. Absent, the window is proof three's. A build record with no `start_sha` (written before the field) is counted as not readable, not failed. This repository declares `built_since = \\\"dae6d765f3d6\\\"`, #227's merge. The proof's test is dogfood like the other five and is deselected from `[tests].run` and the CI test job the same way; the doctor job runs it.\\n\\nNot in this item: re-doing #227's change (its own item, filed on this product once merged); a ruling record voiding an attestation (R4); reading records from `HEAD` in every stage (R5); an executor-side change to the adapter (the instruction already says commit and stop; a mechanism is what was missing, not a sentence).\\n\\nThe stub under `stub/` is the change: `gate_checkout` and the empty-iteration handling in `attavo/build.py`, the class in `attavo/stops.py` and the two schemas, verify's refusal, proof seven and the manifest key, the fixture adapter's `ATTAVO_FIXTURE_NO_COMMIT`, the self-tenant's window and deselect, and seven tests red on the tree (v0.29.0). `tests/test_cli_help.py::test_help_names_the_seventh_proof_and_the_empty_stop` is red on the stub by design; the help text is the build's. Four existing tests move with the gate: two in `tests/test_testtool.py` whose checks counter lived in the tree the gate no longer reads, `test_self_tenancy.py`'s assertion that the manifest has no `[doctor]` table, `test_own_records_guard.py`'s deselect count, and `test_stub_ratio.py`'s pinned `verify/7`. `python3 -m mypy` exits 0 on the stub.\\n\\nRetires: the working tree as what the build's gate reads; `pass` as a status a build with no commit can hold; a review of a build that changed nothing; a definition of done with no word about whether anything was built.\\n\\n## Claims\\n\\n- attavo/build.py\\n- attavo/verify.py\\n- attavo/stops.py\\n- attavo/doctor.py\\n- attavo/cli.py\\n- schema/records/build.schema.json\\n- schema/records/verify.schema.json\\n- schema/manifest.schema.json\\n- adapters/fixture/run\\n- attavo.toml\\n- .github/workflows/ci.yml\\n- tests/test_build.py\\n- tests/test_verify.py\\n- tests/test_doctor.py\\n- tests/test_cli_help.py\\n- tests/test_testtool.py\\n- tests/test_self_tenancy.py\\n- tests/test_own_records_guard.py\\n- tests/test_stub_ratio.py\\n- tests/test_stops.py\\n- tests/test_record_schemas.py\\n- tests/test_types_mirror_schemas.py\\n\\n## Criteria\\n\\n- an-executor-that-commits-nothing-does-not-pass.sh: on a fixture tenant whose executor writes the change into the tree and never commits, `attavo build 1` ends halted with stop class `empty`, provenance `executor`, `sha` equal to `start_sha`, every criterion non-zero, the log saying the executor committed nothing and that the gate reads the commit, and `attavo verify 1` refuses the halted build with no review record written\\n- a-passing-build-record-that-names-no-change-is-refused-by-verify-and-the-doctor.sh: a passing build record edited so that `sha` equals `start_sha` is refused by verify by name with no review record; merged with its item's other records it fails the doctor's `no-attested-item-is-empty` proof naming the item and the merge; with `[doctor].built_since` at that merge the proof holds and names the item before the window; this repository's manifest declares `built_since` and the seven tests named exist\\n# Rulings\\n\\nWritten by the merge of a proposed amendment only.\\nattest/records/229/approval-01.json:7:  \\\"item\\\": \\\"229\\\",\\nattest/records/229/spec-01.json:21:  \\\"item\\\": \\\"229\\\",\\nattest/specs/208/stub/schema/records/verify.schema.json:12:    \\\"stop\\\", \\\"product_version\\\", \\\"product_pin\\\"\\nattest/specs/208/stub/schema/records/verify.schema.json:97:    \\\"stop\\\": {\\nattest/specs/208/stub/schema/records/verify.schema.json:99:      \\\"description\\\": \\\"Non-null exactly when status is not \\\\\\\"pass\\\\\\\" (issue #89): what class of stop this is and whose it is, derived by the record writer from the forge_checks and log it already has -- never a fresh read of anything.\\\",\\nattest/specs/208/stub/schema/records/verify.schema.json:112:          \\\"description\\\": \\\"Populated for class \\\\\\\"unclassed\\\\\\\" (the log's last line, capped at 200 characters) and class \\\\\\\"question\\\\\\\" (the halt's own question, its first line only); null for every other class, whose evidence already lives in forge_checks or the log itself.\\\"\\nattest/specs/212/stub/schema/manifest.schema.json:88:          \\\"description\\\": \\\"Seconds [checks].probe is given; past it the build is refused as an environment stop. Required with probe: a bound the tenant did not write is a forecast.\\\"\\nattest/specs/212/stub/schema/manifest.schema.json:103:        \\\"check_log_command\\\": {\\nattest/specs/212/st
m_input_tokens\":0,\"ephemeral_1h_input_tokens\":891},\"output_tokens\":20,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"f10e7365-697a-4187-94d0-b7fffbb7e98c\",\"uuid\":\"25381827-d6bf-4c22-b330-39226e975273\",\"timestamp\":\"2026-09-27T14:37:02.777Z\",\"request_id\":\"req_011CfU7XMvbdR9WT6YfQESeK\",\"wire_tool_inputs\":{\"toolu_014aQWvc5iszNegmFGAibZiD\":{\"file_path\":\"/Users/davidbean/Projects/attavo-worktree-229/attavo/cli.py\",\"offset\":1,\"limit\":70}}}\n51:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_014aQWvc5iszNegmFGAibZiD\",\"type\":\"tool_result\",\"content\":\"1\\t\\\"\\\"\\\"attavo: the command.\\n2\\t\\n3\\t    attavo doctor [TENANT_ROOT] [--json]\\n4\\t    attavo spec-gate [N]\\n5\\t    attavo approve [N] --by LOGIN\\n6\\t    attavo approval-status [N]\\n7\\t    attavo build [N]\\n8\\t    attavo verify [N]\\n9\\t    attavo file-findings [N]\\n10\\t    attavo file-stops [N]\\n11\\t    attavo counsel [N]\\n12\\t    attavo record-only\\n13\\t    attavo attest [--partial] [N]\\n14\\t    attavo drive [N] [--until-ready] [--again] [--report]\\n15\\t    attavo drive --all\\n16\\t    attavo worker N <build|verify> NN\\n17\\t    attavo ledger [N] [--json]\\n18\\t    attavo stops [N] [--json]\\n19\\t    attavo test [N] [--all | <test>...] [--fresh]\\n20\\t\\n21\\tThe doctor is the definition of done. It asserts five proofs against a\\n22\\ttenant root and exits 1 until every proof holds:\\n23\\t\\n24\\t  1. every-gate-rejects      every gate in the manifest's [gates] table,\\n25\\t                             run against its rejection fixture, exits non-zero,\\n26\\t                             and carries a non-empty retires\\n27\\t  2. one-item-every-stage    one work item under paths.records carries a\\n28\\t                             record for every stage -- spec, approval,\\n29\\t                             build, verify -- all four introduced by one\\n30\\t                             merge commit reachable from HEAD\\n31\\t  3. no-commit-lacks-record  every commit on the default branch after the\\n32\\t                             manifest was introduced is named by a record's\\n33\\t                             sha or commits list, or itself writes under\\n34\\t                             paths.records (a record is committed with the\\n35\\t                             code it describes; an item's merge commit\\n36\\t                             carries its own record paths this way)\\n37\\t  4. no-stop-lacks-cause     every build or verify record under\\n38\\t                             paths.records at record_version 3 or later,\\n39\\t                             with a status other than pass, carries a stop\\n40\\t                             naming an enumerated class and provenance, a\\n41\\t                             non-empty detail when unclassed, the gates\\n42\\t                             heading when a build failed after running\\n43\\t                             them, and the tool's own error line when an\\n44\\t                             adapter exit ended the log -- records before\\n45\\t                             record_version 3 are counted and reported,\\n46\\t                             never refused\\n47\\t  5. every-attested-item-is-sealed\\n48\\t                             every merged item that carries a record for\\n49\\t                             every stage has a statement in the forge's\\n50\\t                             attestation store for its merge commit, read\\n51\\t                             through [forge].attestation_command -- a\\n52\\t                             merge at or before [forge].sealed_since is\\n53\\t                             named as before the window instead of failed.\\n54\\t                             [forge].attestation_command exiting 2 means\\n55\\t                             the store itself could not be read, reported\\n56\\t                             as not_read by item and never as unsealed\\n57\\t\\n58\\tNothing in doctor is a gate. The doctor reads; it never writes and it never\\n59\\tblocks a merge by itself. It is what CI runs to say whether the product\\n60\\tis done.\\n61\\t\\n62\\tspec-gate, approve, and approval-status are gates and writers. They run\\n63\\tfrom the tenant root (the current working directory); N, the work item id,\\n64\\tis read from the ATTAVO_ITEM environment variable when set, else from the\\n65\\tbranch (attavo/N-*). The doctor's first proof sets ATTAVO_ITEM for a\\n66\\trejection fixture's own item, so a gate's own command needs no argument\\n67\\teven while the enclosing repository sits on a real item's attavo/N-*\\n68\\tbranch. Every run of spec-gate or approve writes the next numbered attempt\\n69\\tfile under paths.records/N/ and never overwrites one already written. See\\n70\\tthe spec contract in the project's Phase 1 issue for the full rules each\"}]},\"parent_tool_use_id\":null,\"session_id\":\"f10e7365-697a-4187-94d0-b7fffbb7e98c\",\"uuid\":\"177f74a3-4a64-4373-a4d3-cecd09a2c76c\",\"timestamp\":\"2026-09-27T14:37:02.791Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/davidbean/Projects/attavo-worktree-229/attavo/cli.py\",\"content\":\"\\\"\\\"\\\"attavo: the command.\\n\\n    attavo doctor [TENANT_ROOT] [--json]\\n    attavo spec-gate [N]\\n    attavo approve [N] --by LOGIN\\n    attavo approval-status [N]\\n    attavo build [N]\\n    attavo verify [N]\\n    attavo file-findings [N]\\n    attavo file-stops [N]\\n    attavo counsel [N]\\n    attavo record-only\\n    attavo attest [--partial] [N]\\n    attavo drive [N] [--until-ready] [--again] [--report]\\n    attavo drive --all\\n    attavo worker N <build|verify> NN\\n    attavo ledger [N] [--json]\\n    attavo stops [N] [--json]\\n    attavo test [N] [--all | <test>...] [--fresh]\\n\\nThe doctor is the definition of done. It asserts five proofs against a\\ntenant root and exits 1 until every proof holds:\\n\\n  1. every-gate-rejects      every gate in the manifest's [gates] table,\\n                             run against its rejection fixture, exits non-zero,\\n                             and carries a non-empty retires\\n  2. one-item-every-stage    one work item under paths.records carries a\\n                             record for every stage -- spec, approval,\\n                             build, verify -- all four introduced by one\\n                             merge commit reachable from HEAD\\n  3. no-commit-lacks-record  every commit on the default branch after the\\n                             manifest was introduced is named by a record's\\n                             sha or commits list, or itself writes under\\n                             paths.records (a record is committed with the\\n                             code it describes; an item's merge commit\\n                             carries its own record paths this way)\\n  4. no-stop-lacks-cause     every build or verify record under\\n                             paths.records at record_version 3 or later,\\n                             with a status other than pass, carries a stop\\n                             naming an enumerated class and provenance, a\\n                             non-empty detail when unclassed, the gates\\n                             heading when a build failed after running\\n                             them, and the tool's own error line when an\\n                             adapter exit ended the log -- records before\\n                             record_version 3 are counted and reported,\\n                             never refused\\n  5. every-attested-item-is-sealed\\n                             every merged item that carries a record for\\n                             every stage has a statement in the forge's\\n                             attestation store for its merge commit, read\\n                             through [forge].attestation_command -- a\\n                             merge at or before [forge].sealed_since is\\n                             named as before the window instead of failed.\\n                             [forge].attestation_command exiting 2 means\\n                             the store itself could not be read, reported\\n                             as not_read by item and never as unsealed\\n\\nNothing in doctor is a gate. The doctor reads; it never writes and it never\\nblocks a merge by itself. It is what CI runs to say whether the product\\nis done.\\n\\nspec-gate, approve, and approval-status are gates and writers. They run\\nfrom the tenant root (the current working directory); N, the work item id,\\nis read from the ATTAVO_ITEM environment variable when set, else from the\\nbranch (attavo/N-*). The doctor's first proof sets ATTAVO_ITEM for a\\nrejection fixture's own item, so a gate's own command needs no argument\\neven while the enclosing repository sits on a real item's attavo/N-*\\nbranch. Every run of spec-gate or approve writes the next numbered attempt\\nfile under paths.records/N/ and never overwrites one already written. See\\nthe spec contract in the project's Phase 1 issue for the full rules each\",\"numLines\":70,\"startLine\":1,\"totalLines\":395}}}\n56:{\"type\":\"assistant\",\"message\":{\"model\":\"claude-sonnet-5\",\"id\":\"msg_011CfU7XXgj8u64zFZgbfE5q\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"thinking\",\"thinking\":\"\",\"signature\":\"\"}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":1431,\"cache_read_input_tokens\":50319,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":1431},\"output_tokens\":3,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"f10e7365-697a-4187-94d0-b7fffbb7e98c\",\"uuid\":\"1419a2ec-9514-4d8e-bc49-9bf5f5786fbf\",\"timestamp\":\"2026-09-27T14:37:08.280Z\",\"request_id\":\"req_011CfU7XXGBDGjA28wZV6ptp\"}\n63:{\"type\":\"assistant\",\"message\":{\"model\":\"claude-sonnet-5\",\"id\":\"msg_011CfU7XzhgT8yyLws7Lwuwg\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"thinking\",\"thinking\":\"\",\"signature\":\"\"}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":787,\"cache_read_input_tokens\":51750,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":787},\"output_tokens\":2,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"f10e7365-697a-4187-94d0-b7fffbb7e98c\",\"uuid\":\"2dc5ee4a-f8ef-4dcf-994e-a12e18695c4c\",\"timestamp\":\"2026-09-27T14:37:14.070Z\",\"request_id\":\"req_011CfU7XzNLHBeKQXLxz6x7U\"}\n77:{\"type\":\"assistant\",\"message\":{\"model\":\"claude-sonnet-5\",\"id\":\"msg_011CfU7YfFuotQVY18zDrNVL\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"thinking\",\"thinking\":\"\",\"signature\":\"\"}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":990,\"cache_read_input_tokens\":53098,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":990},\"output_tokens\":2,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"f10e7365-697a-4187-94d0-b7fffbb7e98c\",\"uuid\":\"3603153c-f150-4fac-b4dc-d775eda75b99\",\"timestamp\":\"2026-09-27T14:37:31.130Z\",\"request_id\":\"req_011CfU7YepcrRHobCD5Fxk1r\"}\n94:{\"type\":\"assistant\",\"message\":{\"model\":\"claude-sonnet-5\",\"id\":\"msg_011CfU7ZgDF2ehhmNuUQrSvE\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"thinking\",\"thinking\":\"\",\"signature\":\"\"}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":1282,\"cache_read_input_tokens\":54088,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":1282},\"output_tokens\":8,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"f10e7365-697a-4187-94d0-b7fffbb7e98c\",\"uuid\":\"ffe891eb-df2e-4e2d-bc9b-d6801947ff47\",\"timestamp\":\"2026-09-27T14:37:50.194Z\",\"request_id\":\"req_011CfU7ZfjU22h6u4GEngrra\"}\n96:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_016nkMXTfRYFtjZtv145CxPD\",\"type\":\"tool_result\",\"content\":\"70\\tthe spec contract in the project's Phase 1 issue for the full rules each\\n71\\tone enforces.\\n72\\t\\n73\\tbuild refuses (exit 1, naming the cause, no record) unless the manifest\\n74\\tdeclares [executor].build and [tests].select and [tests].run, and unless\\n75\\tapproval-status would print valid. It exports the executor's identity\\n76\\t(issue #33) into the adapter's environment as GIT_AUTHOR_NAME/EMAIL and\\n77\\tGIT_COMMITTER_NAME/EMAIL, set by the product and never the tenant's git\\n78\\tconfig, then invokes the named adapter (adapters/<name>/run) with the\\n79\\tspec, the corpus, and the branch. It refuses (status refused) a commit\\n80\\tbetween start_sha and HEAD not authored by that identity, checks that\\n81\\tevery path touched matches a spec claim, records the adapter's own\\n82\\tdeclared \\\"reports\\\" -- the fields adapters/<name>/conformance.json says\\n83\\tit can supply with a real value (issue #41), so a field it claims and\\n84\\tnever supplies is a defect the conformance suite catches rather than a\\n85\\tsilent null -- then runs the criteria, the\\n86\\ttests [tests].select and [tests].run name for the touched paths, and --\\n87\\twhen the manifest declares [checks].command -- the tenant's own\\n88\\twhole-tree check, from the tenant root. pass requires every criterion,\\n89\\tthe test run, and the tenant's checks (if declared) to exit 0; any\\n90\\tnon-zero exit iterates, with the failure as feedback, up to a fixed\\n91\\tbudget. [checks] is optional; a tenant that declares none is not\\n92\\trefused. Before the adapter is invoked it asks whether this machine can\\n93\\trun the checks -- of [checks].probe, run once inside [checks].probe_timeout_s\\n94\\t(exit 0 yes; anything else, or the bound, an environment refusal), or,\\n95\\tfor a tenant that declares no probe, by running [checks].command whole\\n96\\t(exit 2 no) -- and says both the question and the answer in the feed\\n97\\t(issue #212). The adapter is given ATTAVO_TEST_COMMAND, `attavo test N`,\\n98\\tand ATTAVO_TEST_TIMEOUT_S when [tests].call_timeout_s is declared; it\\n99\\tis not given the tenant's checks. It writes the next build-NN.json under paths.records/N/, with\\n100\\tthe adapter's transcript -- each iteration's gate output (criteria\\n101\\texits, the selected tests' stdout, the tenant's checks' tail) appended\\n102\\tunder an \\\"--- attavo gates, iteration N ---\\\" heading, issue #89 -- beside\\n103\\tit as build-NN.log. Every record whose status is not pass carries stop:\\n104\\t{class, provenance, detail}, derived from the refusal, halted, and log\\n105\\talready on hand (issue #89); a pass record carries stop: null. See the\\n106\\tbuild contract in the project's Phase 2 issue for the full rules it\\n107\\tenforces.\\n108\\t\\n109\\ttest [N] runs the tests [tests].select names for every path the item has\\n110\\tchanged since it left the default branch (refs/remotes/origin/HEAD),\\n111\\tcommitted or not and untracked included, paths.records aside, through\\n112\\t[tests].run (mode mapped, the default). test N <test>... runs exactly the\\n113\\tnamed tests instead (mode named), so an executor working on one test runs\\n114\\tone test; test N --all runs the whole suite through [tests].run with\\n115\\t\\\"tests\\\" as the one identifier (mode all), the same bound, event, and\\n116\\texclusion as the other two. Naming tests and --all together is refused\\n117\\t(exit 2). It prints how many were selected (or that none was, and runs\\n118\\tnothing), exits as the run does, and, when [tests].call_timeout_s is\\n119\\tdeclared and the run outlasts it, ends the run and everything it started\\n120\\tand exits 124. It exits 2 when it cannot name the changes or the selector\\n121\\tfails. A run that exits 0 is cached against a fingerprint of the tree\\n122\\t(HEAD, the diff against it, and every untracked unignored file's name and\\n123\\tcontent hash, together with the mode and the identifiers); asked again on\\n124\\tan unchanged tree it says so -- unchanged since the earlier run, not\\n125\\trerun -- without spending a second on it; --fresh reruns anyway. A\\n126\\tfailing run is never cached, since the next question after one is always\\n127\\twhether an edit fixed it. [tests].exclude_in_executor names test\\n128\\tidentifiers left out, and said so, when ATTAVO_STAGE is set (inside an\\n129\\texecutor); they run outside one and in CI. When ATTAVO_EVENTS is set, one\\n130\\tevent of kind test is written per invocation, naming the mode, the count\\n131\\tselected, the exit code, and the seconds spent (or that the answer came\\n132\\tfrom the cache). It is the one test command an executor is given (issue\\n133\\t#212); the product's own transport -- drive, worker, build, verify,\\n134\\tcounsel, file-stops -- refuses to run at all when ATTAVO_STAGE is set,\\n135\\tsince the transport is the pass's, not the executor's.\\n136\\t\\n137\\tverify refuses (exit 1) unless the item's latest build record has\\n138\\tstatus pass, and unless the manifest declares [forge].checks_command --\\n139\\ta tenant command, taking a full commit sha on argv, that prints one\\n140\\tline per check as \\\"<name> <conclusion>\\\". verify runs it on the build\\n141\\trecord's sha first: any conclusion other than success, neutral, or\\n142\\tskipped writes verify-NN.json with status returned and calls no\\n143\\tadapter, because a judge is never spent on a tree the forge already\\n144\\tcalled red. With the forge green, verify calls the adapter named by\\n145\\t[executor].verify (defaulting to [executor].build) with the diff since\\n146\\tthe build's approval, the spec, and the build record, and records its\\n147\\tfindings and its declared \\\"reports\\\" (issue #41). [executor.<adapter>.<stage>] shadows [executor.<adapter>] for\\n148\\tbuild or verify alone; both merge parent then stage before setting\\n149\\tATTAVO_ADAPTER_CONFIG, and the record's adapter_config is the merged\\n150\\tresult. Like build, every verify record whose status is not pass\\n151\\tcarries stop: {class, provenance, detail} (issue #89); a pass record\\n152\\tcarries stop: null. file-findings opens one tenant issue per finding in\\n153\\tthe item's latest verify record via [forge].file_issue_command, and\\n154\\trefuses (exit 1, nothing filed) a record carrying a finding with no\\n155\\tretires. See the verify contract in the project's Phase 2 issue for the\\n156\\tfull rules both enforce.\\n157\\t\\n158\\tfile-stops opens one tenant issue per stop record of the item with no\\n159\\tissue filed for it yet, through [forge].file_issue_command, naming the\\n160\\tclass, the provenance, the record path, and the log's last twenty\\n161\\tlines; a record it has already filed carries a <stage>-NN.filed marker\\n162\\tbeside it, holding the filing command's own stdout, so a second run\\n163\\tfiles nothing new. Like a build or verify record, this command writes\\n164\\tthe marker and leaves it uncommitted -- drive commits it, in the same\\n165\\tcommit as the record it names (issue #89). It refuses (exit 1,\\n166\\tnothing filed) a stop whose class is unclassed and whose detail is\\n167\\tempty -- a stop the product cannot even describe is not filed as if it\\n168\\tcould. See issue #89's lane for the full rules it enforces.\\n169\\t\\n170\\tcounsel reads the item's latest non-pass build or verify record -- or,\\n171\\twhen neither exists, its latest refused spec-gate record, the earliest\\n172\\tpoint a question can be answered inside the product, before any\\n173\\tapproval or executor spend (issue #133) -- and asks the tenant's\\n174\\t[executor].counsel adapter (defaulting to [executor].verify) a\\n175\\tread-only question about it: the record, its log, the spec (problem,\\n176\\tclaims, criteria, stub, including stub/.removed), paths.rulings, the\\n177\\titem's diff since approval, the tenant manifest, and this product's own\\n178\\troot (bin/attavo, adapters/, schema/, templates/) by path, under the\\n179\\tsame sandbox verify runs under. The adapter answers with class (the\\n180\\tstop enumeration, or unclassed), verdict (answer: a ruling text with\\n181\\tcitations; patch: a product defect's file, symbol, rejection test, and\\n182\\tdiff; person: a one-line question no rule covers), citations\\n183\\t(instruction, mechanism, guard, each a path and symbol or a ruling id),\\n184\\tand proposal (the ruling text, the patch, or the question). It writes\\n185\\tthe next counsel-NN.json under paths.records/N/, with the adapter's\\n186\\ttranscript beside it as counsel-NN.log, and commits nothing -- the\\n187\\tcaller commits, as with every stage. It refuses (exit 1, nothing\\n188\\twritten) when the item carries no non-pass build, verify, or spec-gate\\n189\\trecord to counsel. See issue #100's lane for the full rules it\\n190\\tenforces, and issue #133's for the spec-gate fallback.\\n191\\t\\n192\\trecord-only exits 0 when HEAD, against its first parent, touches only\\n193\\tpaths.records; 1 otherwise; 2 with no manifest. Core logic about a git\\n194\\tcheckout, not a forge's shell -- a workflow template's push-and-retrigger\\n195\\tguard is one line reading this exit code instead of carrying its own\\n196\\tcopy of the check.\\n197\\t\\n198\\tattest refuses (exit 1) unless the latest spec, approval, build, and\\n199\\tverify records for an item all exist and chain: the build's approval_sha\\n200\\tnames the latest approval, and the verify's build_sha names that build --\\n201\\ta re-approval after a build must force a re-run of what changed. With no\\n202\\tN given it derives the item from the record paths HEAD's merge commit\\n203\\ttouched under paths.records/<N>/, not from a branch name, which a squash\\n204\\tmerge discards and which names a forge's convention the product does not\\n205\\tknow; more than one item derived is a refusal naming what it found. Zero\\n206\\tis not a defect -- not every merge is an item merge -- exit 0, nothing\\n207\\tprinted but a line saying so.\\n208\\t\\n209\\tattest never writes. On a coherent chain it prints the attestation\"}]},\"parent_tool_use_id\":null,\"session_id\":\"f10e7365-697a-4187-94d0-b7fffbb7e98c\",\"uuid\":\"5fe16991-e275-41c4-9c03-0206a649f397\",\"timestamp\":\"2026-09-27T14:37:51.071Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/davidbean/Projects/attavo-worktree-229/attavo/cli.py\",\"content\":\"the spec contract in the project's Phase 1 issue for the full rules each\\none enforces.\\n\\nbuild refuses (exit 1, naming the cause, no record) unless the manifest\\ndeclares [executor].build and [tests].select and [tests].run, and unless\\napproval-status would print valid. It exports the executor's identity\\n(issue #33) into the adapter's environment as GIT_AUTHOR_NAME/EMAIL and\\nGIT_COMMITTER_NAME/EMAIL, set by the product and never the tenant's git\\nconfig, then invokes the named adapter (adapters/<name>/run) with the\\nspec, the corpus, and the branch. It refuses (status refused) a commit\\nbetween start_sha and HEAD not authored by that identity, checks that\\nevery path touched matches a spec claim, records the adapter's own\\ndeclared \\\"reports\\\" -- the fields adapters/<name>/conformance.json says\\nit can supply with a real value (issue #41), so a field it claims and\\nnever supplies is a defect the conformance suite catches rather than a\\nsilent null -- then runs the criteria, the\\ntests [tests].select and [tests].run name for the touched paths, and --\\nwhen the manifest declares [checks].command -- the tenant's own\\nwhole-tree check, from the tenant root. pass requires every criterion,\\nthe test run, and the tenant's checks (if declared) to exit 0; any\\nnon-zero exit iterates, with the failure as feedback, up to a fixed\\nbudget. [checks] is optional; a tenant that declares none is not\\nrefused. Before the adapter is invoked it asks whether this machine can\\nrun the checks -- of [checks].probe, run once inside [checks].probe_timeout_s\\n(exit 0 yes; anything else, or the bound, an environment refusal), or,\\nfor a tenant that declares no probe, by running [checks].command whole\\n(exit 2 no) -- and says both the question and the answer in the feed\\n(issue #212). The adapter is given ATTAVO_TEST_COMMAND, `attavo test N`,\\nand ATTAVO_TEST_TIMEOUT_S when [tests].call_timeout_s is declared; it\\nis not given the tenant's checks. It writes the next build-NN.json under paths.records/N/, with\\nthe adapter's transcript -- each iteration's gate output (criteria\\nexits, the selected tests' stdout, the tenant's checks' tail) appended\\nunder an \\\"--- attavo gates, iteration N ---\\\" heading, issue #89 -- beside\\nit as build-NN.log. Every record whose status is not pass carries stop:\\n{class, provenance, detail}, derived from the refusal, halted, and log\\nalready on hand (issue #89); a pass record carries stop: null. See the\\nbuild contract in the project's Phase 2 issue for the full rules it\\nenforces.\\n\\ntest [N] runs the tests [tests].select names for every path the item has\\nchanged since it left the default branch (refs/remotes/origin/HEAD),\\ncommitted or not and untracked included, paths.records aside, through\\n[tests].run (mode mapped, the default). test N <test>... runs exactly the\\nnamed tests instead (mode named), so an executor working on one test runs\\none test; test N --all runs the whole suite through [tests].run with\\n\\\"tests\\\" as the one identifier (mode all), the same bound, event, and\\nexclusion as the other two. Naming tests and --all together is refused\\n(exit 2). It prints how many were selected (or that none was, and runs\\nnothing), exits as the run does, and, when [tests].call_timeout_s is\\ndeclared and the run outlasts it, ends the run and everything it started\\nand exits 124. It exits 2 when it cannot name the changes or the selector\\nfails. A run that exits 0 is cached against a fingerprint of the tree\\n(HEAD, the diff against it, and every untracked unignored file's name and\\ncontent hash, together with the mode and the identifiers); asked again on\\nan unchanged tree it says so -- unchanged since the earlier run, not\\nrerun -- without spending a second on it; --fresh reruns anyway. A\\nfailing run is never cached, since the next question after one is always\\nwhether an edit fixed it. [tests].exclude_in_executor names test\\nidentifiers left out, and said so, when ATTAVO_STAGE is set (inside an\\nexecutor); they run outside one and in CI. When ATTAVO_EVENTS is set, one\\nevent of kind test is written per invocation, naming the mode, the count\\nselected, the exit code, and the seconds spent (or that the answer came\\nfrom the cache). It is the one test command an executor is given (issue\\n#212); the product's own transport -- drive, worker, build, verify,\\ncounsel, file-stops -- refuses to run at all when ATTAVO_STAGE is set,\\nsince the transport is the pass's, not the executor's.\\n\\nverify refuses (exit 1) unless the item's latest build record has\\nstatus pass, and unless the manifest declares [forge].checks_command --\\na tenant command, taking a full commit sha on argv, that prints one\\nline per check as \\\"<name> <conclusion>\\\". verify runs it on the build\\nrecord's sha first: any conclusion other than success, neutral, or\\nskipped writes verify-NN.json with status returned and calls no\\nadapter, because a judge is never spent on a tree the forge already\\ncalled red. With the forge green, verify calls the adapter named by\\n[executor].verify (defaulting to [executor].build) with the diff since\\nthe build's approval, the spec, and the build record, and records its\\nfindings and its declared \\\"reports\\\" (issue #41). [executor.<adapter>.<stage>] shadows [executor.<adapter>] for\\nbuild or verify alone; both merge parent then stage before setting\\nATTAVO_ADAPTER_CONFIG, and the record's adapter_config is the merged\\nresult. Like build, every verify record whose status is not pass\\ncarries stop: {class, provenance, detail} (issue #89); a pass record\\ncarries stop: null. file-findings opens one tenant issue per finding in\\nthe item's latest verify record via [forge].file_issue_command, and\\nrefuses (exit 1, nothing filed) a record carrying a finding with no\\nretires. See the verify contract in the project's Phase 2 issue for the\\nfull rules both enforce.\\n\\nfile-stops opens one tenant issue per stop record of the item with no\\nissue filed for it yet, through [forge].file_issue_command, naming the\\nclass, the provenance, the record path, and the log's last twenty\\nlines; a record it has already filed carries a <stage>-NN.filed marker\\nbeside it, holding the filing command's own stdout, so a second run\\nfiles nothing new. Like a build or verify record, this command writes\\nthe marker and leaves it uncommitted -- drive commits it, in the same\\ncommit as the record it names (issue #89). It refuses (exit 1,\\nnothing filed) a stop whose class is unclassed and whose detail is\\nempty -- a stop the product cannot even describe is not filed as if it\\ncould. See issue #89's lane for the full rules it enforces.\\n\\ncounsel reads the item's latest non-pass build or verify record -- or,\\nwhen neither exists, its latest refused spec-gate record, the earliest\\npoint a question can be answered inside the product, before any\\napproval or executor spend (issue #133) -- and asks the tenant's\\n[executor].counsel adapter (defaulting to [executor].verify) a\\nread-only question about it: the record, its log, the spec (problem,\\nclaims, criteria, stub, including stub/.removed), paths.rulings, the\\nitem's diff since approval, the tenant manifest, and this product's own\\nroot (bin/attavo, adapters/, schema/, templates/) by path, under the\\nsame sandbox verify runs under. The adapter answers with class (the\\nstop enumeration, or unclassed), verdict (answer: a ruling text with\\ncitations; patch: a product defect's file, symbol, rejection test, and\\ndiff; person: a one-line question no rule covers), citations\\n(instruction, mechanism, guard, each a path and symbol or a ruling id),\\nand proposal (the ruling text, the patch, or the question). It writes\\nthe next counsel-NN.json under paths.records/N/, with the adapter's\\ntranscript beside it as counsel-NN.log, and commits nothing -- the\\ncaller commits, as with every stage. It refuses (exit 1, nothing\\nwritten) when the item carries no non-pass build, verify, or spec-gate\\nrecord to counsel. See issue #100's lane for the full rules it\\nenforces, and issue #133's for the spec-gate fallback.\\n\\nrecord-only exits 0 when HEAD, against its first parent, touches only\\npaths.records; 1 otherwise; 2 with no manifest. Core logic about a git\\ncheckout, not a forge's shell -- a workflow template's push-and-retrigger\\nguard is one line reading this exit code instead of carrying its own\\ncopy of the check.\\n\\nattest refuses (exit 1) unless the latest spec, approval, build, and\\nverify records for an item all exist and chain: the build's approval_sha\\nnames the latest approval, and the verify's build_sha names that build --\\na re-approval after a build must force a re-run of what changed. With no\\nN given it derives the item from the record paths HEAD's merge commit\\ntouched under paths.records/<N>/, not from a branch name, which a squash\\nmerge discards and which names a forge's convention the product does not\\nknow; more than one item derived is a refusal naming what it found. Zero\\nis not a defect -- not every merge is an item merge -- exit 0, nothing\\nprinted but a line saying so.\\n\\nattest never writes. On a coherent chain it prints the attestation\",\"numLines\":140,\"startLine\":70,\"totalLines\":395}}}\n112:{\"type\":\"assistant\",\"message\":{\"model\":\"claude-sonnet-5\",\"id\":\"msg_011CfU7b6KbWdF2B7kwwTiP3\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"thinking\",\"thinking\":\"\",\"signature\":\"\"}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":5093,\"cache_read_input_tokens\":55370,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":5093},\"output_tokens\":2,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"f10e7365-697a-4187-94d0-b7fffbb7e98c\",\"uuid\":\"212c590d-4027-4215-b42c-00510f7e1249\",\"timestamp\":\"2026-09-27T14:38:10.349Z\",\"request_id\":\"req_011CfU7b5rpyMsLFdwLPLwQG\"}\n114:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01NB8xWzA4tjomuRsctor8XZ\",\"type\":\"tool_result\",\"content\":\"The file /Users/davidbean/Projects/attavo-worktree-229/attavo/cli.py has been updated successfully.\"}]},\"parent_tool_use_id\":null,\"session_id\":\"f10e7365-697a-4187-94d0-b7fffbb7e98c\",\"uuid\":\"c188f187-71af-469d-aaeb-f55fcd048af6\",\"timestamp\":\"2026-09-27T14:38:15.504Z\",\"tool_use_result\":{\"filePath\":\"/Users/davidbean/Projects/attavo-worktree-229/attavo/cli.py\",\"oldString\":\"  5. every-attested-item-is-sealed\\n                             every merged item that carries a record for\\n                             every stage has a statement in the forge's\\n                             attestation store for its merge commit, read\\n                             through [forge].attestation_command -- a\\n                             merge at or before [forge].sealed_since is\\n                             named as before the window instead of failed.\\n                             [forge].attestation_command exiting 2 means\\n                             the store itself could not be read, reported\\n                             as not_read by item and never as unsealed\\n\\nNothing in doctor is a gate.\",\"newString\":\"  5. every-attested-item-is-sealed\\n                             every merged item that carries a record for\\n                             every stage has a statement in the forge's\\n                             attestation store for its merge commit, read\\n                             through [forge].attestation_command -- a\\n                             merge at or before [forge].sealed_since is\\n                             named as before the window instead of failed.\\n                             [forge].attestation_command exiting 2 means\\n                             the store itself could not be read, reported\\n                             as not_read by item and never as unsealed\\n  6. no-attested-item-is-empty\\n                             no attested item is empty: every merged,\\n                             fully-staged item's passing build record\\n                             names a change, sha not equal to start_sha.\\n                             [doctor].built_since names a commit at or\\n                             before which merges are named as before the\\n                             window instead of failed, so the specimen\\n                             that motivated this proof stands on the\\n                             record without failing the tenant forever;\\n                             absent, the window is proof three's. A build\\n                             record with no start_sha is counted as not\\n                             readable, never as failed.\\n\\nNothing in doctor is a gate.\",\"originalFile\":\"\\\"\\\"\\\"attavo: the command.\\n\\n    attavo doctor [TENANT_ROOT] [--json]\\n    attavo spec-gate [N]\\n    attavo approve [N] --by LOGIN\\n    attavo approval-status [N]\\n    attavo build [N]\\n    attavo verify [N]\\n    attavo file-findings [N]\\n    attavo file-stops [N]\\n    attavo counsel [N]\\n    attavo record-only\\n    attavo attest [--partial] [N]\\n    attavo drive [N] [--until-ready] [--again] [--report]\\n    attavo drive --all\\n    attavo worker N <build|verify> NN\\n    attavo ledger [N] [--json]\\n    attavo stops [N] [--json]\\n    attavo test [N] [--all | <test>...] [--fresh]\\n\\nThe doctor is the definition of done. It asserts five proofs against a\\ntenant root and exits 1 until every proof holds:\\n\\n  1. every-gate-rejects      every gate in the manifest's [gates] table,\\n                             run against its rejection fixture, exits non-zero,\\n                             and carries a non-empty retires\\n  2. one-item-every-stage    one work item under paths.records carries a\\n                             record for every stage -- spec, approval,\\n                             build, verify -- all four introduced by one\\n                             merge commit reachable from HEAD\\n  3. no-commit-lacks-record  every commit on the default branch after the\\n                             manifest was introduced is named by a record's\\n                             sha or commits list, or itself writes under\\n                             paths.records (a record is committed with the\\n                             code it describes; an item's merge commit\\n                             carries its own record paths this way)\\n  4. no-stop-lacks-cause     every build or verify record under\\n                             paths.records at record_version 3 or later,\\n                             with a status other than pass, carries a stop\\n                             naming an enumerated class and provenance, a\\n                             non-empty detail when unclassed, the gates\\n                             heading when a build failed after running\\n                             them, and the tool's own error line when an\\n                             adapter exit ended the log -- records before\\n                             record_version 3 are counted and reported,\\n                             never refused\\n  5. every-attested-item-is-sealed\\n                             every merged item that carries a record for\\n                             every stage has a statement in the forge's\\n                             attestation store for its merge commit, read\\n                             through [forge].attestation_command -- a\\n                             merge at or before [forge].sealed_since is\\n                             named as before the window instead of failed.\\n                             [forge].attestation_command exiting 2 means\\n                             the store itself could not be read, reported\\n                             as not_read by item and never as unsealed\\n\\nNothing in doctor is a gate. The doctor reads; it never writes and it never\\nblocks a merge by itself. It is what CI runs to say whether the product\\nis done.\\n\\nspec-gate, approve, and approval-status are gates and writers. They run\\nfrom the tenant root (the current working directory); N, the work item id,\\nis read from the ATTAVO_ITEM environment variable when set, else from the\\nbranch (attavo/N-*). The doctor's first proof sets ATTAVO_ITEM for a\\nrejection fixture's own item, so a gate's own command needs no argument\\neven while the enclosing repository sits on a real item's attavo/N-*\\nbranch. Every run of spec-gate or approve writes the next numbered attempt\\nfile under paths.records/N/ and never overwrites one already written. See\\nthe spec contract in the project's Phase 1 issue for the full rules each\\none enforces.\\n\\nbuild refuses (exit 1, naming the cause, no record) unless the manifest\\ndeclares [executor].build and [tests].select and [tests].run, and unless\\napproval-status would print valid. It exports the executor's identity\\n(issue #33) into the adapter's environment as GIT_AUTHOR_NAME/EMAIL and\\nGIT_COMMITTER_NAME/EMAIL, set by the product and never the tenant's git\\nconfig, then invokes the named adapter (adapters/<name>/run) with the\\nspec, the corpus, and the branch. It refuses (status refused) a commit\\nbetween start_sha and HEAD not authored by that identity, checks that\\nevery path touched matches a spec claim, records the adapter's own\\ndeclared \\\"reports\\\" -- the fields adapters/<name>/conformance.json says\\nit can supply with a real value (issue #41), so a field it claims and\\nnever supplies is a defect the conformance suite catches rather than a\\nsilent null -- then runs the criteria, the\\ntests [tests].select and [tests].run name for the touched paths, and --\\nwhen the manifest declares [checks].command -- the tenant's own\\nwhole-tree check, from the tenant root. pass requires every criterion,\\nthe test run, and the tenant's checks (if declared) to exit 0; any\\nnon-zero exit iterates, with the failure as feedback, up to a fixed\\nbudget. [checks] is optional; a tenant that declares none is not\\nrefused. Before the adapter is invoked it asks whether this machine can\\nrun the checks -- of [checks].probe, run once inside [checks].probe_timeout_s\\n(exit 0 yes; anything else, or the bound, an environment refusal), or,\\nfor a tenant that declares no probe, by running [checks].command whole\\n(exit 2 no) -- and says both the question and the answer in the feed\\n(issue #212). The adapter is given ATTAVO_TEST_COMMAND, `attavo test N`,\\nand ATTAVO_TEST_TIMEOUT_S when [tests].call_timeout_s is declared; it\\nis not given the tenant's checks. It writes the next build-NN.json under paths.records/N/, with\\nthe adapter's transcript -- each iteration's gate output (criteria\\nexits, the selected tests' stdout, the tenant's checks' tail) appended\\nunder an \\\"--- attavo gates, iteration N ---\\\" heading, issue #89 -- beside\\nit as build-NN.log. Every record whose status is not pass carries stop:\\n{class, provenance, detail}, derived from the refusal, halted, and log\\nalready on hand (issue #89); a pass record carries stop: null. See the\\nbuild contract in the project's Phase 2 issue for the full rules it\\nenforces.\\n\\ntest [N] runs the tests [tests].select names for every path the item has\\nchanged since it left the default branch (refs/remotes/origin/HEAD),\\ncommitted or not and untracked included, paths.records aside, through\\n[tests].run (mode mapped, the default). test N <test>... runs exactly the\\nnamed tests instead (mode named), so an executor working on one test runs\\none test; test N --all runs the whole suite through [tests].run with\\n\\\"tests\\\" as the one identifier (mode all), the same bound, event, and\\nexclusion as the other two. Naming tests and --all together is refused\\n(exit 2). It prints how many were selected (or that none was, and runs\\nnothing), exits as the run does, and, when [tests].call_timeout_s is\\ndeclared and the run outlasts it, ends the run and everything it started\\nand exits 124. It exits 2 when it cannot name the changes or the selector\\nfails. A run that exits 0 is cached against a fingerprint of the tree\\n(HEAD, the diff against it, and every untracked unignored file's name and\\ncontent hash, together with the mode and the identifiers); asked again on\\nan unchanged tree it says so -- unchanged since the earlier run, not\\nrerun -- without spending a second on it; --fresh reruns anyway. A\\nfailing run is never cached, since the next question after one is always\\nwhether an edit fixed it. [tests].exclude_in_executor names test\\nidentifiers left out, and said so, when ATTAVO_STAGE is set (inside an\\nexecutor); they run outside one and in CI. When ATTAVO_EVENTS is set, one\\nevent of kind test is written per invocation, naming the mode, the count\\nselected, the exit code, and the seconds spent (or that the answer came\\nfrom the cache). It is the one test command an executor is given (issue\\n#212); the product's own transport -- drive, worker, build, verify,\\ncounsel, file-stops -- refuses to run at all when ATTAVO_STAGE is set,\\nsince the transport is the pass's, not the executor's.\\n\\nverify refuses (exit 1) unless the item's latest build record has\\nstatus pass, and unless the manifest declares [forge].checks_command --\\na tenant command, taking a full commit sha on argv, that prints one\\nline per check as \\\"<name> <conclusion>\\\". verify runs it on the build\\nrecord's sha first: any conclusion other than success, neutral, or\\nskipped writes verify-NN.json with status returned and calls no\\nadapter, because a judge is never spent on a tree the forge already\\ncalled red. With the forge green, verify calls the adapter named by\\n[executor].verify (defaulting to [executor].build) with the diff since\\nthe build's approval, the spec, and the build record, and records its\\nfindings and its declared \\\"reports\\\" (issue #41). [executor.<adapter>.<stage>] shadows [executor.<adapter>] for\\nbuild or verify alone; both merge parent then stage before setting\\nATTAVO_ADAPTER_CONFIG, and the record's adapter_config is the merged\\nresult. Like build, every verify record whose status is not pass\\ncarries stop: {class, provenance, detail} (issue #89); a pass record\\ncarries stop: null. file-findings opens one tenant issue per finding in\\nthe item's latest verify record via [forge].file_issue_command, and\\nrefuses (exit 1, nothing filed) a record carrying a finding with no\\nretires. See the verify contract in the project's Phase 2 issue for the\\nfull rules both enforce.\\n\\nfile-stops opens one tenant issue per stop record of the item with no\\nissue filed for it yet, through [forge].file_issue_command, naming the\\nclass, the provenance, the record path, and the log's last twenty\\nlines; a record it has already filed carries a <stage>-NN.filed marker\\nbeside it, holding the filing command's own stdout, so a second run\\nfiles nothing new. Like a build or verify record, this command writes\\nthe marker and leaves it uncommitted -- drive commits it, in the same\\ncommit as the record it names (issue #89). It refuses (exit 1,\\nnothing filed) a stop whose class is unclassed and whose detail is\\nempty -- a stop the product cannot even describe is not filed as if it\\ncould. See issue #89's lane for the full rules it enforces.\\n\\ncounsel reads the item's latest non-pass build or verify record -- or,\\nwhen neither exists, its latest refused spec-gate record, the earliest\\npoint a question can be answered inside the product, before any\\napproval or executor spend (issue #133) -- and asks the tenant's\\n[executor].counsel adapter (defaulting to [executor].verify) a\\nread-only question about it: the record, its log, the spec (problem,\\nclaims, criteria, stub, including stub/.removed), paths.rulings, the\\nitem's diff since approval, the tenant manifest, and this product's own\\nroot (bin/attavo, adapters/, schema/, templates/) by path, under the\\nsame sandbox verify runs under. The adapter answers with class (the\\nstop enumeration, or unclassed), verdict (answer: a ruling text with\\ncitations; patch: a product defect's file, symbol, rejection test, and\\ndiff; person: a one-line question no rule covers), citations\\n(instruction, mechanism, guard, each a path and symbol or a ruling id),\\nand proposal (the ruling text, the patch, or the question). It writes\\nthe next counsel-NN.json under paths.records/N/, with the adapter's\\ntranscript beside it as counsel-NN.log, and commits nothing -- the\\ncaller commits, as with every stage. It refuses (exit 1, nothing\\nwritten) when the item carries no non-pass build, verify, or spec-gate\\nrecord to counsel. See issue #100's lane for the full rules it\\nenforces, and issue #133's for the spec-gate fallback.\\n\\nrecord-only exits 0 when HEAD, against its first parent, touches only\\npaths.records; 1 otherwise; 2 with no manifest. Core logic about a git\\ncheckout, not a forge's shell -- a workflow template's push-and-retrigger\\nguard is one line reading this exit code instead of carrying its own\\ncopy of the check.\\n\\nattest refuses (exit 1) unless the latest spec, approval, build, and\\nverify records for an item all exist and chain: the build's approval_sha\\nnames the latest approval, and the verify's build_sha names that build --\\na re-approval after a build must force a re-run of what changed. With no\\nN given it derives the item from the record paths HEAD's merge commit\\ntouched under paths.records/<N>/, not from a branch name, which a squash\\nmerge discards and which names a forge's convention the product does not\\nknow; more than one item derived is a refusal naming what it found. Zero\\nis not a defect -- not every merge is an item merge -- exit 0, nothing\\nprinted but a line saying so.\\n\\nattest never writes. On a coherent chain it prints the attestation\\nstatement -- validating against schema/attestation.schema.json -- to\\nstdout as JSON and exits 0: the item, its four records and their shas,\\nand the commit the statement was computed at (sha and merge_sha are the\\nsame commit here; on the merge group that commit is the one that lands).\\nThe four stage records already under paths.records are the evidence for\\nthat statement; a forge-specific template signs the printed JSON,\\nunmodified, as the predicate, against the commit that lands, on the merge\\ngroup -- and the signed bundle in the forge's attestation store is the\\nseal over it. attest itself never signs anything and never talks to a\\nsigning service. --partial (issue #67) is for a pull request, where the\\nrecord a complete chain would need is the output of a later stage that is\\nitself waiting on this check: a missing later record is \\\"not yet\\\" (exit\\n0, naming the item and the stages present and absent, no statement\\nprinted) rather than a refusal, while the two chain assertions -- build's\\napproval_sha names the latest approval, verify's build_sha names the\\nlatest build -- still run over whatever records exist. merge_group and a\\npush to main still demand the whole chain. See issue #69's lane for the\\nfull rules it enforces.\\n\\ndrive (reconciler R2) is one short pass: it fast-forwards its working copy\\nto origin's branch (never while a worker holds it), reads the item's\\nreport (attavo.report, issue #206) exactly as --report would, and acts at\\nmost once -- one of the three states that are the product's own move --\\nbefore returning, almost always within seconds. owes-recovery writes the\\ndied or hung record for the one invocation the report named (what\\n--recover used to do, by hand); next-build and next-review start their\\nstage. Starting a stage is the lease: drive writes the invocation marker,\\ncommits it, and pushes that one commit as a plain fast-forward, no merge\\nand no retry -- a rejection that is not a fast-forward, or a ref another\\npush already holds, means another pass started this attempt first, and\\nthis one says so, resets its own marker commit, and starts nothing; a\\npush the remote refuses outright is exit 1 and starts nothing either way.\\nOn a pushed marker drive spawns `attavo worker N <build|verify> NN` in\\nits own session, its stdout and stderr appended to\\n<git-dir>/attavo/<stage>-NN.worker.log, and returns -- the worker\\noutlives the pass. Every other level is printed in the report's own\\nwords and left alone, exit 0; exit 1 is a refusal. See issue #217's lane\\n(the reconciler's R2) for the full rules it enforces.\\n\\nworker N <build|verify> NN is the stage itself, run in the detached child\\na pass just started: build or verify in-process, exactly as the pass used\\nto run it inline before R2, touching\\n<git-dir>/attavo/<stage>-NN.heartbeat every ATTAVO_HEARTBEAT_S seconds\\n(15) while it runs -- what a report or a pass reads first to tell a\\nrunning invocation from a died one, falling back to the pid only when\\nthere is no heartbeat file at all. A record the stage writes that is not\\npass is counseled (counsel, issue #100) and filed (file-stops, issue #89)\\nbefore it is transported, so its .filed marker exists in time to be\\ncommitted alongside it; the worker then commits the stage record and the\\ncounsel record together -- each with its own log and marker -- with\\n`git commit --only`, never sweeping the index, and pushes, with the\\nrecord push's own retry: a push a divergent remote rejects is retried\\nonce after `git pull --no-rebase --no-edit`, never a rebase, since the\\nrecord already names the commit's sha. On a review, ATTAVO_FORGE_CHECKS\\nnames the file the pass already wrote the forge's own read into (the\\nchecks it saw on the head before its marker, reconciler ruling B); verify\\nreads that file instead of polling when it is set.\\n\\n--until-ready repeats the pass in this same process, sleeping\\nATTAVO_DRIVE_POLL_INTERVAL_S between passes, until the level is the\\noperator's or done (exit 0), a concluded check reads red (exit 1), or an\\nunconcluded one has not concluded within ATTAVO_DRIVE_POLL_BOUND_S (exit\\n1) -- a stage running in its own worker is not bounded by either\\nconstant, only time spent waiting on the forge is. Without the flag,\\ndrive is one pass, then stop.\\n\\n--again starts the next attempt of a stopped stage -- the operator's own\\nresume, until a later reconciler ruling drives a retry itself. --recover\\nis gone: `attavo drive --recover` now exits 2 saying so; recovery is\\nwhat a pass does on its own, the moment the report owes one.\\n\\n--all runs one pass, in its own process, in every ../attavo-worktree-N\\nbeside this checkout -- each line either prints is prefixed with the\\nworktree's own directory name.\\n\\n--report prints, as JSON against schema/drive-report.schema.json, what\\nitem N is waiting on: its state, whose move it is (yours, waits, acts,\\ndone), and one sentence in the operator's words. It reads exactly what a\\npass reads -- the item's records, its invocation markers and heartbeats,\\none read of the forge -- and does nothing else: it writes no record,\\nstarts nothing, terminates nothing, and does not poll, so a concluded\\nred check reads as blocked-on-checks for as long as it is red. It exits\\n0 on every state. See issue #206's lane for the states.\\n\\nledger reads, never writes. For item N (or every item under\\npaths.records when N is omitted), it walks the commits from the item's\\nfirst spec commit to its merge (the same derivation doctor's proof two\\nand attest use) or to HEAD when the item has not merged, and prints one\\nrow per act: the sha, the identity as git names it, and a class from a\\nclosed list -- spec, amend, approve, launch, record, change, transport,\\nmerge -- derived from who committed it and, for an approval, build, or\\nverify record, what the record itself says. A summary line follows:\\noperator acts (approve, amend, launch, transport, merge), product acts\\n(record), executor commits (change), stops (non-pass records), and\\nsince (the product version on the first record). A build or verify\\nrecord's own commit, from before v0.18.0 gave the driver and the\\nexecutor their own identities, prints as record-or-launch with a note,\\ncounted toward neither total, rather than guessed. --json prints the\\nrows and the summary as one object. See issue #128's lane for the full\\nrules it enforces.\\n\\nstops reads, never writes. For item N (or every item under\\npaths.records when N is omitted), one row per non-pass build or verify\\nrecord: the record, its stop's class, provenance, and detail, and the\\nanswerer -- \\\"counsel:<verdict>\\\" when a counsel record read this exact\\nstop, else \\\"person\\\" for a question, else \\\"guard\\\" for a class a guard\\nalone raised (GUARDED_STOP_CLASSES), else \\\"none\\\". A record too old to\\ncarry stop at all prints the doctor's own phrase for it, \\\"before stop\\nwas recorded\\\", and is counted there rather than by class. Totals per\\nclass (read from the build record schema's own enum, never retyped) and\\nper answerer, plus the before-stop count, follow the rows. --json prints\\nthe rows and the totals as one object. See issue #129's lane for the\\nfull rules it enforces.\\n\\\"\\\"\\\"\\n\\nfrom __future__ import annotations\\n\\nimport os\\nimport sys\\n\\nfrom attavo.approval import cmd_approval_status, cmd_approve\\nfrom attavo.attest import cmd_attest\\nfrom attavo.build import cmd_build\\nfrom attavo.counsel import cmd_counsel\\nfrom attavo.doctor import cmd_doctor\\nfrom attavo.drive import cmd_drive, cmd_worker\\nfrom attavo.filing import cmd_file_findings, cmd_file_stops\\nfrom attavo.ledger import cmd_ledger\\nfrom attavo.record_only import cmd_record_only\\nfrom attavo.spec import cmd_spec_gate\\nfrom attavo.stops import cmd_stops\\nfrom attavo.testtool import cmd_test\\nfrom attavo.verify import cmd_verify\\n\\n\\nTRANSPORT = (\\\"drive\\\", \\\"worker\\\", \\\"build\\\", \\\"verify\\\", \\\"counsel\\\", \\\"file-stops\\\")\\n\\n\\ndef main(argv: list[str]) -> int:\\n    if not argv or argv[0] in (\\\"-h\\\", \\\"--help\\\"):\\n        print(__doc__.strip())\\n        return 0 if argv else 2\\n    if argv[0] in TRANSPORT and os.environ.get(\\\"ATTAVO_STAGE\\\"):\\n        # The product's transport is never the executor's tool: a stage\\n        # runs inside an invocation whose environment names the stage,\\n        # and nothing under it may start, judge, or record another.\\n        print(f\\\"attavo {argv[0]}: refused inside an executor (ATTAVO_STAGE is set); \\\"\\n              f\\\"the transport is the pass's, not the executor's\\\", file=sys.stderr)\\n        return 2\\n    if argv[0] == \\\"doctor\\\":\\n        return cmd_doctor(argv[1:])\\n    if argv[0] == \\\"spec-gate\\\":\\n        return cmd_spec_gate(argv[1:])\\n    if argv[0] == \\\"approve\\\":\\n        return cmd_approve(argv[1:])\\n    if argv[0] == \\\"approval-status\\\":\\n        return cmd_approval_status(argv[1:])\\n    if argv[0] == \\\"build\\\":\\n        return cmd_build(argv[1:])\\n    if argv[0] == \\\"verify\\\":\\n        return cmd_verify(argv[1:])\\n    if argv[0] == \\\"file-findings\\\":\\n        return cmd_file_findings(argv[1:])\\n    if argv[0] == \\\"file-stops\\\":\\n        return cmd_file_stops(argv[1:])\\n    if argv[0] == \\\"counsel\\\":\\n        return cmd_counsel(argv[1:])\\n    if argv[0] == \\\"record-only\\\":\\n        return cmd_record_only(argv[1:])\\n    if argv[0] == \\\"attest\\\":\\n        return cmd_attest(argv[1:])\\n    if argv[0] == \\\"drive\\\":\\n        return cmd_drive(argv[1:])\\n    if argv[0] == \\\"worker\\\":\\n        return cmd_worker(argv[1:])\\n    if argv[0] == \\\"ledger\\\":\\n        return cmd_ledger(argv[1:])\\n    if argv[0] == \\\"stops\\\":\\n        return cmd_stops(argv[1:])\\n    if argv[0] == \\\"test\\\":\\n        return cmd_test(argv[1:])\\n    print(f\\\"attavo: unknown subcommand {argv[0]!r}; only doctor, spec-gate, approve, \\\"\\n          f\\\"approval-status, build, verify, file-findings, file-stops, counsel, record-only, \\\"\\n          f\\\"attest, drive, worker, ledger, stops, test exist at this commit\\\", file=sys.stderr)\\n    return 2\\n\",\"structuredPatch\":[{\"oldStart\":54,\"oldLines\":6,\"newStart\":54,\"newLines\":18,\"lines\":[\"                              [forge].attestation_command exiting 2 means\",\"                              the store itself could not be read, reported\",\"                              as not_read by item and never as unsealed\",\"+  6. no-attested-item-is-empty\",\"+                             no attested item is empty: every merged,\",\"+                             fully-staged item's passing build record\",\"+                             names a change, sha not equal to start_sha.\",\"+                             [doctor].built_since names a commit at or\",\"+                             before which merges are named as before the\",\"+                             window instead of failed, so the specimen\",\"+                             that motivated this proof stands on the\",\"+                             record without failing the tenant forever;\",\"+                             absent, the window is proof three's. A build\",\"+                             record with no start_sha is counted as not\",\"+                             readable, never as failed.\",\" \",\" Nothing in doctor is a gate. The doctor reads; it never writes and it never\",\" blocks a merge by itself. It is what CI runs to say whether the product\"]}],\"userModified\":false,\"replaceAll\":false,\"contentNotInModelContext\":true}}\n115:{\"type\":\"assistant\",\"message\":{\"model\":\"claude-sonnet-5\",\"id\":\"msg_011CfU7ctTXjBPGTziJQyoPq\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_01E2ydJ2ovVMmmyeu3NyDvNK\",\"name\":\"Edit\",\"input\":{\"replace_all\":false,\"file_path\":\"/Users/davidbean/Projects/attavo-worktree-229/attavo/cli.py\",\"old_string\":\"tests [tests].select and [tests].run name for the touched paths, and --\\nwhen the manifest declares [checks].command -- the tenant's own\\nwhole-tree check, from the tenant root. pass requires every criterion,\\nthe test run, and the tenant's checks (if declared) to exit 0; any\\nnon-zero exit iterates, with the failure as feedback, up to a fixed\\nbudget. [checks] is optional; a tenant that declares none is not\\nrefused. Before the adapter is invoked it asks whether this machine can\",\"new_string\":\"tests [tests].select and [tests].run name for the touched paths, and --\\nwhen the manifest declares [checks].command -- the tenant's own\\nwhole-tree check, all three run in a detached worktree of HEAD and\\nnever in the executor's own directory: the gate reads the commit, not\\nthe tree, so a path written and never committed cannot pass a\\ncriterion, a test, or a check on the executor's behalf. An iteration\\nthat ends with HEAD unchanged since start_sha is told, in the feed and\\nthe log, that the executor committed nothing and that the gate reads\\nthe commit, and iterates; the last iteration ending that way halts the\\nbuild instead of failing it, stop class empty, provenance executor,\\ndetail naming that the executor committed nothing and how many paths\\nit left modified or untracked. pass requires every criterion,\\nthe test run, and the tenant's checks (if declared) to exit 0, and HEAD\\nto have moved since start_sha; any non-zero exit iterates, with the\\nfailure as feedback, up to a fixed budget. [checks] is optional; a\\ntenant that declares none is not refused. Before the adapter is invoked\\nit asks whether this machine can\"},\"caller\":{\"type\":\"direct\"}}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":2234,\"cache_read_input_tokens\":60463,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":2234},\"output_tokens\":17,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"f10e7365-697a-4187-94d0-b7fffbb7e98c\",\"uuid\":\"b995c913-1e4e-4605-a5de-dd398107b3d5\",\"timestamp\":\"2026-09-27T14:38:22.326Z\",\"request_id\":\"req_011CfU7ct7CF7QgM6xKRXrf8\",\"wire_tool_inputs\":{\"toolu_01E2ydJ2ovVMmmyeu3NyDvNK\":{\"file_path\":\"/Users/davidbean/Projects/attavo-worktree-229/attavo/cli.py\",\"old_string\":\"tests [tests].select and [tests].run name for the touched paths, and --\\nwhen the manifest declares [checks].command -- the tenant's own\\nwhole-tree check, from the tenant root. pass requires every criterion,\\nthe test run, and the tenant's checks (if declared) to exit 0; any\\nnon-zero exit iterates, with the failure as feedback, up to a fixed\\nbudget. [checks] is optional; a tenant that declares none is not\\nrefused. Before the adapter is invoked it asks whether this machine can\",\"new_string\":\"tests [tests].select and [tests].run name for the touched paths, and --\\nwhen the manifest declares [checks].command -- the tenant's own\\nwhole-tree check, all three run in a detached worktree of HEAD and\\nnever in the executor's own directory: the gate reads the commit, not\\nthe tree, so a path written and never committed cannot pass a\\ncriterion, a test, or a check on the executor's behalf. An iteration\\nthat ends with HEAD unchanged since start_sha is told, in the feed and\\nthe log, that the executor committed nothing and that the gate reads\\nthe commit, and iterates; the last iteration ending that way halts the\\nbuild instead of failing it, stop class empty, provenance executor,\\ndetail naming that the executor committed nothing and how many paths\\nit left modified or untracked. pass requires every criterion,\\nthe test run, and the tenant's checks (if declared) to exit 0, and HEAD\\nto have moved since start_sha; any non-zero exit iterates, with the\\nfailure as feedback, up to a fixed budget. [checks] is optional; a\\ntenant that declares none is not refused. Before the adapter is invoked\\nit asks whether this machine can\"}}}\n116:{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01E2ydJ2ovVMmmyeu3NyDvNK\",\"type\":\"tool_result\",\"content\":\"The file /Users/davidbean/Projects/attavo-worktree-229/attavo/cli.py has been updated successfully.\"}]},\"parent_tool_use_id\":null,\"session_id\":\"f10e7365-697a-4187-94d0-b7fffbb7e98c\",\"uuid\":\"a7e593ad-7cc2-4559-a9dc-b9599555a5e6\",\"timestamp\":\"2026-09-27T14:38:22.331Z\",\"tool_use_result\":{\"filePath\":\"/Users/davidbean/Projects/attavo-worktree-229/attavo/cli.py\",\"oldString\":\"tests [tests].select and [tests].run name for the touched paths, and --\\nwhen the manifest declares [checks].command -- the tenant's own\\nwhole-tree check, from the tenant root. pass requires every criterion,\\nthe test run, and the tenant's checks (if declared) to exit 0; any\\nnon-zero exit iterates, with the failure as feedback, up to a fixed\\nbudget. [checks] is optional; a tenant that declares none is not\\nrefused. Before the adapter is invoked it asks whether this machine can\",\"newString\":\"tests [tests].select and [tests].run name for the touched paths, and --\\nwhen the manifest declares [checks].command -- the tenant's own\\nwhole-tree check, all three run in a detached worktree of HEAD and\\nnever in the executor's own directory: the gate reads the commit, not\\nthe tree, so a path written and never committed cannot pass a\\ncriterion, a test, or a check on the executor's behalf. An iteration\\nthat ends with HEAD unchanged since start_sha is told, in the feed and\\nthe log, that the executor committed nothing and that the gate reads\\nthe commit, and iterates; the last iteration ending that way halts the\\nbuild instead of failing it, stop class empty, provenance executor,\\ndetail naming that the executor committed nothing and how many paths\\nit left modified or untracked. pass requires every criterion,\\nthe test run, and the tenant's checks (if declared) to exit 0, and HEAD\\nto have moved since start_sha; any non-zero exit iterates, with the\\nfailure as feedback, up to a fixed budget. [checks] is optional; a\\ntenant that declares none is not refused. Before the adapter is invoked\\nit asks whether this machine can\",\"originalFile\":\"\\\"\\\"\\\"attavo: the command.\\n\\n    attavo doctor [TENANT_ROOT] [--json]\\n    attavo spec-gate [N]\\n    attavo approve [N] --by LOGIN\\n    attavo approval-status [N]\\n    attavo build [N]\\n    attavo verify [N]\\n    attavo file-findings [N]\\n    attavo file-stops [N]\\n    attavo counsel [N]\\n    attavo record-only\\n    attavo attest [--partial] [N]\\n    attavo drive [N] [--until-ready] [--again] [--report]\\n    attavo drive --all\\n    attavo worker N <build|verify> NN\\n    attavo ledger [N] [--json]\\n    attavo stops [N] [--json]\\n    attavo test [N] [--all | <test>...] [--fresh]\\n\\nThe doctor is the definition of done. It asserts five proofs against a\\ntenant root and exits 1 until every proof holds:\\n\\n  1. every-gate-rejects      every gate in the manifest's [gates] table,\\n                             run against its rejection fixture, exits non-zero,\\n                             and carries a non-empty retires\\n  2. one-item-every-stage    one work item under paths.records carries a\\n                             record for every stage -- spec, approval,\\n                             build, verify -- all four introduced by one\\n                             merge commit reachable from HEAD\\n  3. no-commit-lacks-record  every commit on the default branch after the\\n                             manifest was introduced is named by a record's\\n                             sha or commits list, or itself writes under\\n                             paths.records (a record is committed with the\\n                             code it describes; an item's merge commit\\n                             carries its own record paths this way)\\n  4. no-stop-lacks-cause     every build or verify record under\\n                             paths.records at record_version 3 or later,\\n                             with a status other than pass, carries a stop\\n                             naming an enumerated class and provenance, a\\n                             non-empty detail when unclassed, the gates\\n                             heading when a build failed after running\\n                             them, and the tool's own error line when an\\n                             adapter exit ended the log -- records before\\n                             record_version 3 are counted and reported,\\n                             never refused\\n  5. every-attested-item-is-sealed\\n                             every merged item that carries a record for\\n                             every stage has a statement in the forge's\\n                             attestation store for its merge commit, read\\n                             through [forge].attestation_command -- a\\n                             merge at or before [forge].sealed_since is\\n                             named as before the window instead of failed.\\n                             [forge].attestation_command exiting 2 means\\n                             the store itself could not be read, reported\\n                             as not_read by item and never as unsealed\\n  6. no-attested-item-is-empty\\n                             no attested item is empty: every merged,\\n                             fully-staged item's passing build record\\n                             names a change, sha not equal to start_sha.\\n                             [doctor].built_since names a commit at or\\n                             before which merges are named as before the\\n                             window instead of failed, so the specimen\\n                             that motivated this proof stands on the\\n                             record without failing the tenant forever;\\n                             absent, the window is proof three's. A build\\n                             record with no start_sha is counted as not\\n                             readable, never as failed.\\n\\nNothing in doctor is a gate. The doctor reads; it never writes and it never\\nblocks a merge by itself. It is what CI runs to say whether the product\\nis done.\\n\\nspec-gate, approve, and approval-status are gates and writers. They run\\nfrom the tenant root (the current working directory); N, the work item id,\\nis read from the ATTAVO_ITEM environment variable when set, else from the\\nbranch (attavo/N-*). The doctor's first proof sets ATTAVO_ITEM for a\\nrejection fixture's own item, so a gate's own command needs no argument\\neven while the enclosing repository sits on a real item's attavo/N-*\\nbranch. Every run of spec-gate or approve writes the next numbered attempt\\nfile under paths.records/N/ and never overwrites one already written. See\\nthe spec contract in the project's Phase 1 issue for the full rules each\\none enforces.\\n\\nbuild refuses (exit 1, naming the cause, no record) unless the manifest\\ndeclares [executor].build and [tests].select and [tests].run, and unless\\napproval-status would print valid. It exports the executor's identity\\n(issue #33) into the adapter's environment as GIT_AUTHOR_NAME/EMAIL and\\nGIT_COMMITTER_NAME/EMAIL, set by the product and never the tenant's git\\nconfig, then invokes the named adapter (adapters/<name>/run) with the\\nspec, the corpus, and the branch. It refuses (status refused) a commit\\nbetween start_sha and HEAD not authored by that identity, checks that\\nevery path touched matches a spec claim, records the adapter's own\\ndeclared \\\"reports\\\" -- the fields adapters/<name>/conformance.json says\\nit can supply with a real value (issue #41), so a field it claims and\\nnever supplies is a defect the conformance suite catches rather than a\\nsilent null -- then runs the criteria, the\\ntests [tests].select and [tests].run name for the touched paths, and --\\nwhen the manifest declares [checks].command -- the tenant's own\\nwhole-tree check, from the tenant root. pass requires every criterion,\\nthe test run, and the tenant's checks (if declared) to exit 0; any\\nnon-zero exit iterates, with the failure as feedback, up to a fixed\\nbudget. [checks] is optional; a tenant that declares none is not\\nrefused. Before the adapter is invoked it asks whether this machine can\\nrun the checks -- of [checks].probe, run once inside [checks].probe_timeout_s\\n(exit 0 yes; anything else, or the bound, an environment refusal), or,\\nfor a tenant that declares no probe, by running [checks].command whole\\n(exit 2 no) -- and says both the question and the answer in the feed\\n(issue #212). The adapter is given ATTAVO_TEST_COMMAND, `attavo test N`,\\nand ATTAVO_TEST_TIMEOUT_S when [tests].call_timeout_s is declared; it\\nis not given the tenant's checks. It writes the next build-NN.json under paths.records/N/, with\\nthe adapter's transcript -- each iteration's gate output (criteria\\nexits, the selected tests' stdout, the tenant's checks' tail) appended\\nunder an \\\"--- attavo gates, iteration N ---\\\" heading, issue #89 -- beside\\nit as build-NN.log. Every record whose status is not pass carries stop:\\n{class, provenance, detail}, derived from the refusal, halted, and log\\nalready on hand (issue #89); a pass record carries stop: null. See the\\nbuild contract in the project's Phase 2 issue for the full rules it\\nenforces.\\n\\ntest [N] runs the tests [tests].select names for every path the item has\\nchanged since it left the default branch (refs/remotes/origin/HEAD),\\ncommitted or not and untracked included, paths.records aside, through\\n[tests].run (mode mapped, the default). test N <test>... runs exactly the\\nnamed tests instead (mode named), so an executor working on one test runs\\none test; test N --all runs the whole suite through [tests].run with\\n\\\"tests\\\" as the one identifier (mode all), the same bound, event, and\\nexclusion as the other two. Naming tests and --all together is refused\\n(exit 2). It prints how many were selected (or that none was, and runs\\nnothing), exits as the run does, and, when [tests].call_timeout_s is\\ndeclared and the run outlasts it, ends the run and everything it started\\nand exits 124. It exits 2 when it cannot name the changes or the selector\\nfails. A run that exits 0 is cached against a fingerprint of the tree\\n(HEAD, the diff against it, and every untracked unignored file's name and\\ncontent hash, together with the mode and the identifiers); asked again on\\nan unchanged tree it says so -- unchanged since the earlier run, not\\nrerun -- without spending a second on it; --fresh reruns anyway. A\\nfailing run is never cached, since the next question after one is always\\nwhether an edit fixed it. [tests].exclude_in_executor names test\\nidentifiers left out, and said so, when ATTAVO_STAGE is set (inside an\\nexecutor); they run outside one and in CI. When ATTAVO_EVENTS is set, one\\nevent of kind test is written per invocation, naming the mode, the count\\nselected, the exit code, and the seconds spent (or that the answer came\\nfrom the cache). It is the one test command an executor is given (issue\\n#212); the product's own transport -- drive, worker, build, verify,\\ncounsel, file-stops -- refuses to run at all when ATTAVO_STAGE is set,\\nsince the transport is the pass's, not the executor's.\\n\\nverify refuses (exit 1) unless the item's latest build record has\\nstatus pass, and unless the manifest declares [forge].checks_command --\\na tenant command, taking a full commit sha on argv, that prints one\\nline per check as \\\"<name> <conclusion>\\\". verify runs it on the build\\nrecord's sha first: any conclusion other than success, neutral, or\\nskipped writes verify-NN.json with status returned and calls no\\nadapter, because a judge is never spent on a tree the forge already\\ncalled red. With the forge green, verify calls the adapter named by\\n[executor].verify (defaulting to [executor].build) with the diff since\\nthe build's approval, the spec, and the build record, and records its\\nfindings and its declared \\\"reports\\\" (issue #41). [executor.<adapter>.<stage>] shadows [executor.<adapter>] for\\nbuild or verify alone; both merge parent then stage before setting\\nATTAVO_ADAPTER_CONFIG, and the record's adapter_config is the merged\\nresult. Like build, every verify record whose status is not pass\\ncarries stop: {class, provenance, detail} (issue #89); a pass record\\ncarries stop: null. file-findings opens one tenant issue per finding in\\nthe item's latest verify record via [forge].file_issue_command, and\\nrefuses (exit 1, nothing filed) a record carrying a finding with no\\nretires. See the verify contract in the project's Phase 2 issue for the\\nfull rules both enforce.\\n\\nfile-stops opens one tenant issue per stop record of the item with no\\nissue filed for it yet, through [forge].file_issue_command, naming the\\nclass, the provenance, the record path, and the log's last twenty\\nlines; a record it has already filed carries a <stage>-NN.filed marker\\nbeside it, holding the filing command's own stdout, so a second run\\nfiles nothing new. Like a build or verify record, this command writes\\nthe marker and leaves it uncommitted -- drive commits it, in the same\\ncommit as the record it names (issue #89). It refuses (exit 1,\\nnothing filed) a stop whose class is unclassed and whose detail is\\nempty -- a stop the product cannot even describe is not filed as if it\\ncould. See issue #89's lane for the full rules it enforces.\\n\\ncounsel reads the item's latest non-pass build or verify record -- or,\\nwhen neither exists, its latest refused spec-gate record, the earliest\\npoint a question can be answered inside the product, before any\\napproval or executor spend (issue #133) -- and asks the tenant's\\n[executor].counsel adapter (defaulting to [executor].verify) a\\nread-only question about it: the record, its log, the spec (problem,\\nclaims, criteria, stub, including stub/.removed), paths.rulings, the\\nitem's diff since approval, the tenant manifest, and this product's own\\nroot (bin/attavo, adapters/, schema/, templates/) by path, under the\\nsame sandbox verify runs under. The adapter answers with class (the\\nstop enumeration, or unclassed), verdict (answer: a ruling text with\\ncitations; patch: a product defect's file, symbol, rejection test, and\\ndiff; person: a one-line question no rule covers), citations\\n(instruction, mechanism, guard, each a path and symbol or a ruling id),\\nand proposal (the ruling text, the patch, or the question). It writes\\nthe next counsel-NN.json under paths.records/N/, with the adapter's\\ntranscript beside it as counsel-NN.log, and commits nothing -- the\\ncaller commits, as with every stage. It refuses (exit 1, nothing\\nwritten) when the item carries no non-pass build, verify, or spec-gate\\nrecord to counsel. See issue #100's lane for the full rules it\\nenforces, and issue #133's for the spec-gate fallback.\\n\\nrecord-only exits 0 when HEAD, against its first parent, touches only\\npaths.records; 1 otherwise; 2 with no manifest. Core logic about a git\\ncheckout, not a forge's shell -- a workflow template's push-and-retrigger\\nguard is one line reading this exit code instead of carrying its own\\ncopy of the check.\\n\\nattest refuses (exit 1) unless the latest spec, approval, build, and\\nverify records for an item all exist and chain: the build's approval_sha\\nnames the latest approval, and the verify's build_sha names that build --\\na re-approval after a build must force a re-run of what changed. With no\\nN given it derives the item from the record paths HEAD's merge commit\\ntouched under paths.records/<N>/, not from a branch name, which a squash\\nmerge discards and which names a forge's convention the product does not\\nknow; more than one item derived is a refusal naming what it found. Zero\\nis not a defect -- not every merge is an item merge -- exit 0, nothing\\nprinted but a line saying so.\\n\\nattest never writes. On a coherent chain it prints the attestation\\nstatement -- validating against schema/attestation.schema.json -- to\\nstdout as JSON and exits 0: the item, its four records and their shas,\\nand the commit the statement was computed at (sha and merge_sha are the\\nsame commit here; on the merge group that commit is the one that lands).\\nThe four stage records already under paths.records are the evidence for\\nthat statement; a forge-specific template signs the printed JSON,\\nunmodified, as the predicate, against the commit that lands, on the merge\\ngroup -- and the signed bundle in the forge's attestation store is the\\nseal over it. attest itself never signs anything and never talks to a\\nsigning service. --partial (issue #67) is for a pull request, where the\\nrecord a complete chain would need is the output of a later stage that is\\nitself waiting on this check: a missing later record is \\\"not yet\\\" (exit\\n0, naming the item and the stages present and absent, no statement\\nprinted) rather than a refusal, while the two chain assertions -- build's\\napproval_sha names the latest approval, verify's build_sha names the\\nlatest build -- still run over whatever records exist. merge_group and a\\npush to main still demand the whole chain. See issue #69's lane for the\\nfull rules it enforces.\\n\\ndrive (reconciler R2) is one short pass: it fast-forwards its working copy\\nto origin's branch (never while a worker holds it), reads the item's\\nreport (attavo.report, issue #206) exactly as --report would, and acts at\\nmost once -- one of the three states that are the product's own move --\\nbefore returning, almost always within seconds. owes-recovery writes the\\ndied or hung record for the one invocation the report named (what\\n--recover used to do, by hand); next-build and next-review start their\\nstage. Starting a stage is the lease: drive writes the invocation marker,\\ncommits it, and pushes that one commit as a plain fast-forward, no merge\\nand no retry -- a rejection that is not a fast-forward, or a ref another\\npush already holds, means another pass started this attempt first, and\\nthis one says so, resets its own marker commit, and starts nothing; a\\npush the remote refuses outright is exit 1 and starts nothing either way.\\nOn a pushed marker drive spawns `attavo worker N <build|verify> NN` in\\nits own session, its stdout and stderr appended to\\n<git-dir>/attavo/<stage>-NN.worker.log, and returns -- the worker\\noutlives the pass. Every other level is printed in the report's own\\nwords and left alone, exit 0; exit 1 is a refusal. See issue #217's lane\\n(the reconciler's R2) for the full rules it enforces.\\n\\nworker N <build|verify> NN is the stage itself, run in the detached child\\na pass just started: build or verify in-process, exactly as the pass used\\nto run it inline before R2, touching\\n<git-dir>/attavo/<stage>-NN.heartbeat every ATTAVO_HEARTBEAT_S seconds\\n(15) while it runs -- what a report or a pass reads first to tell a\\nrunning invocation from a died one, falling back to the pid only when\\nthere is no heartbeat file at all. A record the stage writes that is not\\npass is counseled (counsel, issue #100) and filed (file-stops, issue #89)\\nbefore it is transported, so its .filed marker exists in time to be\\ncommitted alongside it; the worker then commits the stage record and the\\ncounsel record together -- each with its own log and marker -- with\\n`git commit --only`, never sweeping the index, and pushes, with the\\nrecord push's own retry: a push a divergent remote rejects is retried\\nonce after `git pull --no-rebase --no-edit`, never a rebase, since the\\nrecord already names the commit's sha. On a review, ATTAVO_FORGE_CHECKS\\nnames the file the pass already wrote the forge's own read into (the\\nchecks it saw on the head before its marker, reconciler ruling B); verify\\nreads that file instead of polling when it is set.\\n\\n--until-ready repeats the pass in this same process, sleeping\\nATTAVO_DRIVE_POLL_INTERVAL_S between passes, until the level is the\\noperator's or done (exit 0), a concluded check reads red (exit 1), or an\\nunconcluded one has not concluded within ATTAVO_DRIVE_POLL_BOUND_S (exit\\n1) -- a stage running in its own worker is not bounded by either\\nconstant, only time spent waiting on the forge is. Without the flag,\\ndrive is one pass, then stop.\\n\\n--again starts the next attempt of a stopped stage -- the operator's own\\nresume, until a later reconciler ruling drives a retry itself. --recover\\nis gone: `attavo drive --recover` now exits 2 saying so; recovery is\\nwhat a pass does on its own, the moment the report owes one.\\n\\n--all runs one pass, in its own process, in every ../attavo-worktree-N\\nbeside this checkout -- each line either prints is prefixed with the\\nworktree's own directory name.\\n\\n--report prints, as JSON against schema/drive-report.schema.json, what\\nitem N is waiting on: its state, whose move it is (yours, waits, acts,\\ndone), and one sentence in the operator's words. It reads exactly what a\\npass reads -- the item's records, its invocation markers and heartbeats,\\none read of the forge -- and does nothing else: it writes no record,\\nstarts nothing, terminates nothing, and does not poll, so a concluded\\nred check reads as blocked-on-checks for as long as it is red. It exits\\n0 on every state. See issue #206's lane for the states.\\n\\nledger reads, never writes. For item N (or every item under\\npaths.records when N is omitted), it walks the commits from the item's\\nfirst spec commit to its merge (the same derivation doctor's proof two\\nand attest use) or to HEAD when the item has not merged, and prints one\\nrow per act: the sha, the identity as git names it, and a class from a\\nclosed list -- spec, amend, approve, launch, record, change, transport,\\nmerge -- derived from who committed it and, for an approval, build, or\\nverify record, what the record itself says. A summary line follows:\\noperator acts (approve, amend, launch, transport, merge), product acts\\n(record), executor commits (change), stops (non-pass records), and\\nsince (the product version on the first record). A build or verify\\nrecord's own commit, from before v0.18.0 gave the driver and the\\nexecutor their own identities, prints as record-or-launch with a note,\\ncounted toward neither total, rather than guessed. --json prints the\\nrows and the summary as one object. See issue #128's lane for the full\\nrules it enforces.\\n\\nstops reads, never writes. For item N (or every item under\\npaths.records when N is omitted), one row per non-pass build or verify\\nrecord: the record, its stop's class, provenance, and detail, and the\\nanswerer -- \\\"counsel:<verdict>\\\" when a counsel record read this exact\\nstop, else \\\"person\\\" for a question, else \\\"guard\\\" for a class a guard\\nalone raised (GUARDED_STOP_CLASSES), else \\\"none\\\". A record too old to\\ncarry stop at all prints the doctor's own phrase for it, \\\"before stop\\nwas recorded\\\", and is counted there rather than by class. Totals per\\nclass (read from the build record schema's own enum, never retyped) and\\nper answerer, plus the before-stop count, follow the rows. --json prints\\nthe rows and the totals as one object. See issue #129's lane for the\\nfull rules it enforces.\\n\\\"\\\"\\\"\\n\\nfrom __future__ import annotations\\n\\nimport os\\nimport sys\\n\\nfrom attavo.approval import cmd_approval_status, cmd_approve\\nfrom attavo.attest import cmd_attest\\nfrom attavo.build import cmd_build\\nfrom attavo.counsel import cmd_counsel\\nfrom attavo.doctor import cmd_doctor\\nfrom attavo.drive import cmd_drive, cmd_worker\\nfrom attavo.filing import cmd_file_findings, cmd_file_stops\\nfrom attavo.ledger import cmd_ledger\\nfrom attavo.record_only import cmd_record_only\\nfrom attavo.spec import cmd_spec_gate\\nfrom attavo.stops import cmd_stops\\nfrom attavo.testtool import cmd_test\\nfrom attavo.verify import cmd_verify\\n\\n\\nTRANSPORT = (\\\"drive\\\", \\\"worker\\\", \\\"build\\\", \\\"verify\\\", \\\"counsel\\\", \\\"file-stops\\\")\\n\\n\\ndef main(argv: list[str]) -> int:\\n    if not argv or argv[0] in (\\\"-h\\\", \\\"--help\\\"):\\n        print(__doc__.strip())\\n        return 0 if argv else 2\\n    if argv[0] in TRANSPORT and os.environ.get(\\\"ATTAVO_STAGE\\\"):\\n        # The product's transport is never the executor's tool: a stage\\n        # runs inside an invocation whose environment names the stage,\\n        # and nothing under it may start, judge, or record another.\\n        print(f\\\"attavo {argv[0]}: refused inside an executor (ATTAVO_STAGE is set); \\\"\\n              f\\\"the transport is the pass's, not the executor's\\\", file=sys.stderr)\\n        return 2\\n    if argv[0] == \\\"doctor\\\":\\n        return cmd_doctor(argv[1:])\\n    if argv[0] == \\\"spec-gate\\\":\\n        return cmd_spec_gate(argv[1:])\\n    if argv[0] == \\\"approve\\\":\\n        return cmd_approve(argv[1:])\\n    if argv[0] == \\\"approval-status\\\":\\n        return cmd_approval_status(argv[1:])\\n    if argv[0] == \\\"build\\\":\\n        return cmd_build(argv[1:])\\n    if argv[0] == \\\"verify\\\":\\n        return cmd_verify(argv[1:])\\n    if argv[0] == \\\"file-findings\\\":\\n        return cmd_file_findings(argv[1:])\\n    if argv[0] == \\\"file-stops\\\":\\n        return cmd_file_stops(argv[1:])\\n    if argv[0] == \\\"counsel\\\":\\n        return cmd_counsel(argv[1:])\\n    if argv[0] == \\\"record-only\\\":\\n        return cmd_record_only(argv[1:])\\n    if argv[0] == \\\"attest\\\":\\n        return cmd_attest(argv[1:])\\n    if argv[0] == \\\"drive\\\":\\n        return cmd_drive(argv[1:])\\n    if argv[0] == \\\"worker\\\":\\n        return cmd_worker(argv[1:])\\n    if argv[0] == \\\"ledger\\\":\\n        return cmd_ledger(argv[1:])\\n    if argv[0] == \\\"stops\\\":\\n        return cmd_stops(argv[1:])\\n    if argv[0] == \\\"test\\\":\\n        return cmd_test(argv[1:])\\n    print(f\\\"attavo: unknown subcommand {argv[0]!r}; only doctor, spec-gate, approve, \\\"\\n          f\\\"approval-status, build, verify, file-findings, file-stops, counsel, record-only, \\\"\\n          f\\\"attest, drive, worker, ledger, stops, test exist at this commit\\\", file=sys.stderr)\\n    return 2\\n\",\"structuredPatch\":[{\"oldStart\":97,\"oldLines\":11,\"newStart\":97,\"newLines\":21,\"lines\":[\" silent null -- then runs the criteria, the\",\" tests [tests].select and [tests].run name for the touched paths, and --\",\" when the manifest declares [checks].command -- the tenant's own\",\"-whole-tree check, from the tenant root. pass requires every criterion,\",\"-the test run, and the tenant's checks (if declared) to exit 0; any\",\"-non-zero exit iterates, with the failure as feedback, up to a fixed\",\"-budget. [checks] is optional; a tenant that declares none is not\",\"-refused. Before the adapter is invoked it asks whether this machine can\",\"+whole-tree check, all three run in a detached worktree of HEAD and\",\"+never in the executor's own directory: the gate reads the commit, not\",\"+the tree, so a path written and never committed cannot pass a\",\"+criterion, a test, or a check on the executor's behalf. An iteration\",\"+that ends with HEAD unchanged since start_sha is told, in the feed and\",\"+the log, that the executor committed nothing and that the gate reads\",\"+the commit, and iterates; the last iteration ending that way halts the\",\"+build instead of failing it, stop class empty, provenance executor,\",\"+detail naming that the executor committed nothing and how many paths\",\"+it left modified or untracked. pass requires every criterion,\",\"+the test run, and the tenant's checks (if declared) to exit 0, and HEAD\",\"+to have moved since start_sha; any non-zero exit iterates, with the\",\"+failure as feedback, up to a fixed budget. [checks] is optional; a\",\"+tenant that declares none is not refused. Before the adapter is invoked\",\"+it asks whether this machine can\",\" run the checks -- of [checks].probe, run once inside [checks].probe_timeout_s\",\" (exit 0 yes; anything else, or the bound, an environment refusal), or,\",\" for a tenant that declares no probe, by running [checks].command whole\"]}],\"userModified\":false,\"replaceAll\":false,\"contentNotInModelContext\":true}}\n117:{\"type\":\"assistant\",\"message\":{\"model\":\"claude-sonnet-5\",\"id\":\"msg_011CfU7dPtq4Kh4yanFPzjJq\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"Now let me apply the rest of the stub to the live tree. I'll copy each stub file over its corresponding live file.\"}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":744,\"cache_read_input_tokens\":62697,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":744},\"output_tokens\":5,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"f10e7365-697a-4187-94d0-b7fffbb7e98c\",\"uuid\":\"63845cb4-7c2e-46dc-852a-74b31a3b70c5\",\"timestamp\":\"2026-09-27T14:38:24.335Z\",\"request_id\":\"req_011CfU7dPR4i2Yb1V4fAkh7k\"}\n118:{\"type\":\"assistant\",\"message\":{\"model\":\"claude-sonnet-5\",\"id\":\"msg_011CfU7dPtq4Kh4yanFPzjJq\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016TVh8yYp6jULPYwrbyGfHt","type":"tool_result","content":"1\tfrom __future__ import annotations\n2\t\n3\timport os\n4\timport signal\n5\timport subprocess\n6\timport sys\n7\tfrom pathlib import Path\n8\tfrom typing import Any\n9\t\n10\tfrom attavo.common import MANIFEST, derive_item_id, git, read_manifest\n11\t\n12\t# --- test: the executor's one test command (issue #212) --\n13\t# The tests [tests].select names for every path the item has changed since\n14\t# it left the default branch, run through [tests].run, bounded by\n15\t# [tests].call_timeout_s. The executor is given this and not the tenant's\n16\t# whole-tree checks: given a checks command it ran it (#194's 590 s wait;\n17\t# #204 and #206 ran the suite twice inside one build), and the gate runs\n18\t# them after every commit whatever the executor does. ---\n19\t\n20\tTIMED_OUT_EXIT = 124\n21\t\n22\t# What an ended run is given to leave on its own after SIGTERM, before its\n23\t# whole process group is sent SIGKILL.\n24\tEND_GRACE_S = 2\n25\t\n26\t\n27\tdef _signal_group(proc: \"subprocess.Popen[str]\", sig: int) -> None:\n28\t    try:\n29\t        os.killpg(proc.pid, sig)\n30\t    except ProcessLookupError:\n31\t        pass\n32\t\n33\t\n34\tdef run_bounded(command: str, root: Path, stdin: str, timeout_s: int | None\n35\t                ) -> tuple[int, str, str, bool]:\n36\t    \"\"\"(exit, stdout, stderr, timed_out) of `command` run through the shell\n37\t    from root. The command is its own process group's leader, so a run past\n38\t    timeout_s is ended with everything it started -- a test runner's\n39\t    workers and a shell's background jobs alike -- rather than only the\n40\t    shell, which would leave them holding the pipes and the machine. A run\n41\t    that outlasts its bound exits 124, as timeout(1) does.\"\"\"\n42\t    proc = subprocess.Popen(command, shell=True, cwd=str(root), stdin=subprocess.PIPE,\n43\t                            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,\n44\t                            start_new_session=True)\n45\t    try:\n46\t        out, err = proc.communicate(stdin, timeout=timeout_s)\n47\t    except subprocess.TimeoutExpired:\n48\t        _signal_group(proc, signal.SIGTERM)\n49\t        try:\n50\t            out, err = proc.communicate(timeout=END_GRACE_S)\n51\t        except subprocess.TimeoutExpired:\n52\t            _signal_group(proc, signal.SIGKILL)\n53\t            try:\n54\t                out, err = proc.communicate(timeout=END_GRACE_S)\n55\t            except subprocess.TimeoutExpired:\n56\t                # something the run started left its group and holds the pipes\n57\t                out, err = \"\", \"\"\n58\t        _signal_group(proc, signal.SIGKILL)\n59\t        return TIMED_OUT_EXIT, out, err, True\n60\t    _signal_group(proc, signal.SIGKILL)\n61\t    return proc.returncode, out, err, False\n62\t\n63\t\n64\tdef without_records(paths: list[str], records_rel: str) -> list[str]:\n65\t    \"\"\"paths other than paths.records itself and what is under it -- the\n66\t    records directory is where the product writes, not the item's work.\"\"\"\n67\t    prefix = records_rel.rstrip(\"/\") + \"/\"\n68\t    return [p for p in paths if p and p != records_rel and not p.startswith(prefix)]\n69\t\n70\t\n71\tdef changed_since_default_branch(root: Path, records_rel: str) -> list[str]:\n72\t    \"\"\"Every path the item has changed since it left the default branch,\n73\t    committed or not: tracked paths whose content differs from the\n74\t    merge-base with what refs/remotes/origin/HEAD names -- deleted and\n75\t    renamed-from paths included, staged or not -- and untracked paths that\n76\t    are not ignored. Sorted; the records directory left aside.\n77\t    RuntimeError when the default branch cannot be named.\"\"\"\n78\t    default = git(root, \"symbolic-ref\", \"-q\", \"refs/remotes/origin/HEAD\").strip()\n79\t    base = git(root, \"merge-base\", default, \"HEAD\").strip()\n80\t    tracked = git(root, \"diff\", \"--name-only\", \"--no-renames\", \"-z\", base).split(\"\\0\")\n81\t    untracked = git(root, \"ls-files\", \"--others\", \"--exclude-standard\", \"-z\").split(\"\\0\")\n82\t    return sorted(set(without_records(tracked + untracked, records_rel)))\n83\t\n84\t\n85\tdef _fingerprint(root: Path) -> str:\n86\t    \"\"\"What the tree is right now: HEAD, the tracked diff against it, and\n87\t    every untracked, unignored file's name and content hash.\"\"\"\n88\t    import hashlib\n89\t    h = hashlib.sha256()\n90\t    h.update(git(root, \"rev-parse\", \"HEAD\").encode())\n91\t    h.update(git(root, \"diff\", \"HEAD\", \"--no-color\").encode())\n92\t    for name in git(root, \"ls-files\", \"--others\", \"--exclude-standard\", \"-z\").split(\"\\0\"):\n93\t        if not name:\n94\t            continue\n95\t        h.update(name.encode() + b\"\\0\")\n96\t        try:\n97\t            h.update(hashlib.sha256((root / name).read_bytes()).digest())\n98\t        except OSError:\n99\t            pass\n100\t    return h.hexdigest()\n101\t\n102\t\n103\tdef _cache_path(root: Path) -> Path:\n104\t    from attavo.events import stage_events_dir\n105\t    return stage_events_dir(root) / \"test-cache.json\"\n106\t\n107\t\n108\tdef _event(text: str) -> None:\n109\t    events = os.environ.get(\"ATTAVO_EVENTS\")\n110\t    if events:\n111\t        from attavo.events import append_event\n112\t        append_event(Path(events), \"test\", text)\n113\t\n114\t\n115\tdef cmd_test(argv: list[str]) -> int:\n116\t    root = Path(\".\").resolve()\n117\t    flags = {\"--all\", \"--fresh\"}\n118\t    positional = [a for a in argv if a not in flags]\n119\t    whole, fresh = \"--all\" in argv, \"--fresh\" in argv\n120\t    item_id = positional[0] if positional else derive_item_id(root)\n121\t    named = positional[1:]\n122\t    if not item_id:\n123\t        print(\"attavo test: cannot derive item id; pass N or run on an attavo/N-* branch\",\n124\t              file=sys.stderr)\n125\t        return 2\n126\t    m = read_manifest(root)\n127\t    if m is None:\n128\t        print(f\"attavo test: no {MANIFEST} at {root}\", file=sys.stderr)\n129\t        return 2\n130\t    tests_cfg: dict[str, Any] = m.get(\"tests\") or {}\n131\t    if not tests_cfg.get(\"select\") or not tests_cfg.get(\"run\"):\n132\t        print(\"attavo test: no [tests] table in the manifest \"\n133\t              \"([tests].select and [tests].run are both required)\", file=sys.stderr)\n134\t        return 2\n135\t    import json\n136\t    import time\n137\t    if named and whole:\n138\t        print(\"attavo test: name tests or pass --all, not both\", file=sys.stderr)\n139\t        return 2\n140\t    if named:\n141\t        mode, identifiers = \"named\", named\n142\t    elif whole:\n143\t        mode, identifiers = \"all\", [\"tests\"]\n144\t    else:\n145\t        mode = \"mapped\"\n146\t        try:\n147\t            changed = changed_since_default_branch(root, m[\"paths\"][\"records\"])\n148\t        except RuntimeError as exc:\n149\t            print(f\"attavo test: cannot name what item {item_id} has changed: {exc}; \"\n150\t                  \"run `git remote set-head origin -a`\", file=sys.stderr)\n151\t            return 2\n152\t        select_run = subprocess.run(tests_cfg[\"select\"], shell=True, cwd=str(root),\n153\t                                    input=\"\".join(p + \"\\n\" for p in changed),\n154\t                                    capture_output=True, text=True, check=False)\n155\t        if select_run.returncode != 0:\n156\t            # Nothing selected because the selector failed is not nothing to run.\n157\t            sys.stderr.write(select_run.stderr)\n158\t            print(f\"attavo test: [tests].select exited {select_run.returncode}; nothing was run\",\n159\t                  file=sys.stderr)\n160\t            return 2\n161\t        identifiers = [line for line in select_run.stdout.splitlines() if line.strip()]\n162\t        if not identifiers:\n163\t            print(f\"attavo test {item_id}: no test is selected for the {len(changed)} \"\n164\t                  \"path(s) changed since the default branch\")\n165\t            _event(f\"attavo test {item_id}: mode mapped, 0 selected, exit 0, 0 s\")\n166\t            return 0\n167\t\n168\t    inside = bool(os.environ.get(\"ATTAVO_STAGE\"))\n169\t    excluded = [x for x in (tests_cfg.get(\"exclude_in_executor\") or []) if x in identifiers] if inside else []\n170\t    if excluded:\n171\t        identifiers = [i for i in identifiers if i not in excluded]\n172\t        print(f\"attavo test {item_id}: left out inside an executor: {', '.join(excluded)}\")\n173\t\n174\t    key = _fingerprint(root) + \"|\" + mode + \"|\" + \"\\n\".join(identifiers)\n175\t    cache_file = _cache_path(root)\n176\t    cache: dict[str, Any] = {}\n177\t    if cache_file.is_file():\n178\t        try:\n179\t            cache = json.loads(cache_file.read_text())\n180\t        except ValueError:\n181\t            cache = {}\n182\t    hit = cache.get(key)\n183\t    if hit and not fresh:\n184\t        print(f\"attavo test {item_id}: {len(identifiers)} selected; unchanged since the run at \"\n185\t              f\"{hit['at']} (exit 0); not rerun; pass --fresh to rerun\")\n186\t        _event(f\"attavo test {item_id}: mode {mode}, {len(identifiers)} selected, exit 0, cached\")\n187\t        return 0\n188\t\n189\t    bound = tests_cfg.get(\"call_timeout_s\")\n190\t    print(f\"attavo test {item_id}: {len(identifiers)} selected\", flush=True)\n191\t    started = time.monotonic()\n192\t    code, out, err, timed_out = run_bounded(tests_cfg[\"run\"], root,\n193\t                                            \"\".join(i + \"\\n\" for i in identifiers), bound)\n194\t    elapsed = int(time.monotonic() - started)\n195\t    sys.stdout.write(out)\n196\t    sys.stderr.write(err)\n197\t    if timed_out:\n198\t        print(f\"attavo test {item_id}: the run did not finish within {bound} s; \"\n199\t              \"it and everything it started were ended\")\n200\t    _event(f\"attavo test {item_id}: mode {mode}, {len(identifiers)} selected, exit {code}, {elapsed} s\")\n201\t    if code == 0:\n202\t        from attavo.common import now_iso\n203\t        cache[key] = {\"at\": now_iso()}\n204\t        cache_file.parent.mkdir(parents=True, exist_ok=True)\n205\t        cache_file.write_text(json.dumps(cache))\n206\t    return code\n207\t"}]},"parent_tool_use_id":null,"session_id":"8b9a9eba-cd13-4154-8596-ab0c96cc1266","uuid":"1ed63a1c-d9fb-4964-bedc-02de10caf6ab","timestamp":"2026-09-27T15:20:24.878Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-229/attavo/testtool.py","content":"from __future__ import annotations\n\nimport os\nimport signal\nimport subprocess\nimport sys\nfrom pathlib import Path\nfrom typing import Any\n\nfrom attavo.common import MANIFEST, derive_item_id, git, read_manifest\n\n# --- test: the executor's one test command (issue #212) --\n# The tests [tests].select names for every path the item has changed since\n# it left the default branch, run through [tests].run, bounded by\n# [tests].call_timeout_s. The executor is given this and not the tenant's\n# whole-tree checks: given a checks command it ran it (#194's 590 s wait;\n# #204 and #206 ran the suite twice inside one build), and the gate runs\n# them after every commit whatever the executor does. ---\n\nTIMED_OUT_EXIT = 124\n\n# What an ended run is given to leave on its own after SIGTERM, before its\n# whole process group is sent SIGKILL.\nEND_GRACE_S = 2\n\n\ndef _signal_group(proc: \"subprocess.Popen[str]\", sig: int) -> None:\n    try:\n        os.killpg(proc.pid, sig)\n    except ProcessLookupError:\n        pass\n\n\ndef run_bounded(command: str, root: Path, stdin: str, timeout_s: int | None\n                ) -> tuple[int, str, str, bool]:\n    \"\"\"(exit, stdout, stderr, timed_out) of `command` run through the shell\n    from root. The command is its own process group's leader, so a run past\n    timeout_s is ended with everything it started -- a test runner's\n    workers and a shell's background jobs alike -- rather than only the\n    shell, which would leave them holding the pipes and the machine. A run\n    that outlasts its bound exits 124, as timeout(1) does.\"\"\"\n    proc = subprocess.Popen(command, shell=True, cwd=str(root), stdin=subprocess.PIPE,\n                            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,\n                            start_new_session=True)\n    try:\n        out, err = proc.communicate(stdin, timeout=timeout_s)\n    except subprocess.TimeoutExpired:\n        _signal_group(proc, signal.SIGTERM)\n        try:\n            out, err = proc.communicate(timeout=END_GRACE_S)\n        except subprocess.TimeoutExpired:\n            _signal_group(proc, signal.SIGKILL)\n            try:\n                out, err = proc.communicate(timeout=END_GRACE_S)\n            except subprocess.TimeoutExpired:\n                # something the run started left its group and holds the pipes\n                out, err = \"\", \"\"\n        _signal_group(proc, signal.SIGKILL)\n        return TIMED_OUT_EXIT, out, err, True\n    _signal_group(proc, signal.SIGKILL)\n    return proc.returncode, out, err, False\n\n\ndef without_records(paths: list[str], records_rel: str) -> list[str]:\n    \"\"\"paths other than paths.records itself and what is under it -- the\n    records directory is where the product writes, not the item's work.\"\"\"\n    prefix = records_rel.rstrip(\"/\") + \"/\"\n    return [p for p in paths if p and p != records_rel and not p.startswith(prefix)]\n\n\ndef changed_since_default_branch(root: Path, records_rel: str) -> list[str]:\n    \"\"\"Every path the item has changed since it left the default branch,\n    committed or not: tracked paths whose content differs from the\n    merge-base with what refs/remotes/origin/HEAD names -- deleted and\n    renamed-from paths included, staged or not -- and untracked paths that\n    are not ignored. Sorted; the records directory left aside.\n    RuntimeError when the default branch cannot be named.\"\"\"\n    default = git(root, \"symbolic-ref\", \"-q\", \"refs/remotes/origin/HEAD\").strip()\n    base = git(root, \"merge-base\", default, \"HEAD\").strip()\n    tracked = git(root, \"diff\", \"--name-only\", \"--no-renames\", \"-z\", base).split(\"\\0\")\n    untracked = git(root, \"ls-files\", \"--others\", \"--exclude-standard\", \"-z\").split(\"\\0\")\n    return sorted(set(without_records(tracked + untracked, records_rel)))\n\n\ndef _fingerprint(root: Path) -> str:\n    \"\"\"What the tree is right now: HEAD, the tracked diff against it, and\n    every untracked, unignored file's name and content hash.\"\"\"\n    import hashlib\n    h = hashlib.sha256()\n    h.update(git(root, \"rev-parse\", \"HEAD\").encode())\n    h.update(git(root, \"diff\", \"HEAD\", \"--no-color\").encode())\n    for name in git(root, \"ls-files\", \"--others\", \"--exclude-standard\", \"-z\").split(\"\\0\"):\n        if not name:\n            continue\n        h.update(name.encode() + b\"\\0\")\n        try:\n            h.update(hashlib.sha256((root / name).read_bytes()).digest())\n        except OSError:\n            pass\n    return h.hexdigest()\n\n\ndef _cache_path(root: Path) -> Path:\n    from attavo.events import stage_events_dir\n    return stage_events_dir(root) / \"test-cache.json\"\n\n\ndef _event(text: str) -> None:\n    events = os.environ.get(\"ATTAVO_EVENTS\")\n    if events:\n        from attavo.events import append_event\n        append_event(Path(events), \"test\", text)\n\n\ndef cmd_test(argv: list[str]) -> int:\n    root = Path(\".\").resolve()\n    flags = {\"--all\", \"--fresh\"}\n    positional = [a for a in argv if a not in flags]\n    whole, fresh = \"--all\" in argv, \"--fresh\" in argv\n    item_id = positional[0] if positional else derive_item_id(root)\n    named = positional[1:]\n    if not item_id:\n        print(\"attavo test: cannot derive item id; pass N or run on an attavo/N-* branch\",\n              file=sys.stderr)\n        return 2\n    m = read_manifest(root)\n    if m is None:\n        print(f\"attavo test: no {MANIFEST} at {root}\", file=sys.stderr)\n        return 2\n    tests_cfg: dict[str, Any] = m.get(\"tests\") or {}\n    if not tests_cfg.get(\"select\") or not tests_cfg.get(\"run\"):\n        print(\"attavo test: no [tests] table in the manifest \"\n              \"([tests].select and [tests].run are both required)\", file=sys.stderr)\n        return 2\n    import json\n    import time\n    if named and whole:\n        print(\"attavo test: name tests or pass --all, not both\", file=sys.stderr)\n        return 2\n    if named:\n        mode, identifiers = \"named\", named\n    elif whole:\n        mode, identifiers = \"all\", [\"tests\"]\n    else:\n        mode = \"mapped\"\n        try:\n            changed = changed_since_default_branch(root, m[\"paths\"][\"records\"])\n        except RuntimeError as exc:\n            print(f\"attavo test: cannot name what item {item_id} has changed: {exc}; \"\n                  \"run `git remote set-head origin -a`\", file=sys.stderr)\n            return 2\n        select_run = subprocess.run(tests_cfg[\"select\"], shell=True, cwd=str(root),\n                                    input=\"\".join(p + \"\\n\" for p in changed),\n                                    capture_output=True, text=True, check=False)\n        if select_run.returncode != 0:\n            # Nothing selected because the selector failed is not nothing to run.\n            sys.stderr.write(select_run.stderr)\n            print(f\"attavo test: [tests].select exited {select_run.returncode}; nothing was run\",\n                  file=sys.stderr)\n            return 2\n        identifiers = [line for line in select_run.stdout.splitlines() if line.strip()]\n        if not identifiers:\n            print(f\"attavo test {item_id}: no test is selected for the {len(changed)} \"\n                  \"path(s) changed since the default branch\")\n            _event(f\"attavo test {item_id}: mode mapped, 0 selected, exit 0, 0 s\")\n            return 0\n\n    inside = bool(os.environ.get(\"ATTAVO_STAGE\"))\n    excluded = [x for x in (tests_cfg.get(\"exclude_in_executor\") or []) if x in identifiers] if inside else []\n    if excluded:\n        identifiers = [i for i in identifiers if i not in excluded]\n        print(f\"attavo test {item_id}: left out inside an executor: {', '.join(excluded)}\")\n\n    key = _fingerprint(root) + \"|\" + mode + \"|\" + \"\\n\".join(identifiers)\n    cache_file = _cache_path(root)\n    cache: dict[str, Any] = {}\n    if cache_file.is_file():\n        try:\n            cache = json.loads(cache_file.read_text())\n        except ValueError:\n            cache = {}\n    hit = cache.get(key)\n    if hit and not fresh:\n        print(f\"attavo test {item_id}: {len(identifiers)} selected; unchanged since the run at \"\n              f\"{hit['at']} (exit 0); not rerun; pass --fresh to rerun\")\n        _event(f\"attavo test {item_id}: mode {mode}, {len(identifiers)} selected, exit 0, cached\")\n        return 0\n\n    bound = tests_cfg.get(\"call_timeout_s\")\n    print(f\"attavo test {item_id}: {len(identifiers)} selected\", flush=True)\n    started = time.monotonic()\n    code, out, err, timed_out = run_bounded(tests_cfg[\"run\"], root,\n                                            \"\".join(i + \"\\n\" for i in identifiers), bound)\n    elapsed = int(time.monotonic() - started)\n    sys.stdout.write(out)\n    sys.stderr.write(err)\n    if timed_out:\n        print(f\"attavo test {item_id}: the run did not finish within {bound} s; \"\n              \"it and everything it started were ended\")\n    _event(f\"attavo test {item_id}: mode {mode}, {len(identifiers)} selected, exit {code}, {elapsed} s\")\n    if code == 0:\n        from attavo.common import now_iso\n        cache[key] = {\"at\": now_iso()}\n        cache_file.parent.mkdir(parents=True, exist_ok=True)\n        cache_file.write_text(json.dumps(cache))\n    return code\n","numLines":207,"startLine":1,"totalLines":207}}}

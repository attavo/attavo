{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_014cMU3ranR3FFEXwPuXrAVo","type":"tool_result","content":"1\tfrom __future__ import annotations\n2\t\n3\timport fnmatch\n4\timport contextlib\n5\timport json\n6\timport shutil\n7\timport os\n8\timport shlex\n9\timport subprocess\n10\timport sys\n11\timport tempfile\n12\timport time\n13\tfrom pathlib import Path\n14\tfrom typing import Any, Iterator, cast\n15\t\n16\tfrom attavo.approval import approval_status\n17\tfrom attavo.common import (\n18\t    MANIFEST,\n19\t    PRODUCT_ROOT,\n20\t    ShallowCheckoutError,\n21\t    derive_item_id,\n22\t    git,\n23\t    last_commit_touching,\n24\t    now_iso,\n25\t    read_manifest,\n26\t)\n27\tfrom attavo.events import append_event, stage_events_dir\n28\tfrom attavo.records import latest_record, next_attempt_number, parse_attempts, write_record\n29\tfrom attavo.spec import parse_spec, run_criterion\n30\tfrom attavo.stops import _log_last_line, derive_stop, signature_of\n31\tfrom attavo.testtool import run_bounded, without_records\n32\t\n33\t# --- build: adapter, claims boundary, criteria, and the tenant's tests ---\n34\t\n35\tSTAGE_NAMES = (\"build\", \"verify\", \"counsel\")\n36\t\n37\t\n38\tdef merge_adapter_config(m: dict[str, Any], adapter_name: str, stage: str) -> dict[str, Any]:\n39\t    \"\"\"[executor.<adapter>] merged with [executor.<adapter>.<stage>], the\n40\t    stage table shadowing the parent for that stage only. Both build and\n41\t    verify call this before setting ATTAVO_ADAPTER_CONFIG, and the\n42\t    record's adapter_config is the merged result.\"\"\"\n43\t    parent = (m.get(\"executor\") or {}).get(adapter_name) or {}\n44\t    if not isinstance(parent, dict):\n45\t        return {}\n46\t    merged = {k: v for k, v in parent.items() if k not in STAGE_NAMES}\n47\t    stage_table = parent.get(stage)\n48\t    if isinstance(stage_table, dict):\n49\t        merged.update(stage_table)\n50\t    return merged\n51\t\n52\t\n53\tdef resolve_adapter(root: Path, name: str) -> Path | None:\n54\t    \"\"\"adapters/<name>/run, resolved first under the tenant's own\n55\t    attavo/adapters/, then under this product's adapters/.\"\"\"\n56\t    for base in (root / \"attavo\" / \"adapters\", PRODUCT_ROOT / \"adapters\"):\n57\t        candidate = base / name / \"run\"\n58\t        if candidate.is_file():\n59\t            return candidate\n60\t    return None\n61\t\n62\t\n63\tdef adapter_reports(adapter_path: Path) -> list[str]:\n64\t    \"\"\"Field names adapters/<name>/conformance.json declares this adapter\n65\t    can supply with a real value -- vendor independence (2026-09-09\n66\t    ruling): the record carries the declaration, so an adapter claiming\n67\t    a field and returning null for it fails the conformance suite\n68\t    instead of writing a silent, uncomparable null. [] when the\n69\t    resolved adapter (a tenant override included) declares no\n70\t    conformance.json at all -- an absent declaration, not a refusal.\"\"\"\n71\t    manifest_path = adapter_path.parent / \"conformance.json\"\n72\t    if not manifest_path.is_file():\n73\t        return []\n74\t    try:\n75\t        manifest = json.loads(manifest_path.read_text())\n76\t    except json.JSONDecodeError:\n77\t        return []\n78\t    reports: list[str] = manifest.get(\"reports\", [])\n79\t    return reports\n80\t\n81\t\n82\tdef changed_paths(root: Path, start_sha: str, records_rel: str) -> list[str]:\n83\t    \"\"\"Paths changed between start_sha and HEAD, other than paths.records --\n84\t    the records directory is where build itself writes, not a claim.\"\"\"\n85\t    return without_records(git(root, \"diff\", \"--name-only\", start_sha, \"HEAD\").splitlines(),\n86\t                           records_rel)\n87\t\n88\t\n89\tdef matches_a_claim(path: str, claims: list[str]) -> bool:\n90\t    return any(fnmatch.fnmatch(path, pattern) for pattern in claims)\n91\t\n92\t\n93\tdef protected_path_touched(root: Path, start_sha: str, records_rel: str,\n94\t                           specs_rel: str) -> str | None:\n95\t    \"\"\"The first path an executor's own commits touched under\n96\t    paths.records or paths.specs since start_sha, or None (issue #140).\n97\t    Neither directory is a claim a spec can make -- paths.records is\n98\t    where the product itself writes, paths.specs is the definition of\n99\t    done -- yet changed_paths above excludes paths.records from the\n100\t    ordinary claims check entirely, so a path there never even reached\n101\t    matches_a_claim to be refused: tenant zero's own item #688 committed\n102\t    its own events file this way, under its records directory, on a\n103\t    build that then passed. Checked directly against the raw diff, not\n104\t    changed_paths's already-filtered list.\"\"\"\n105\t    touched = git(root, \"diff\", \"--name-only\", start_sha, \"HEAD\").splitlines()\n106\t    protected = []\n107\t    for rel in (records_rel, specs_rel):\n108\t        stripped = rel.rstrip(\"/\")\n109\t        protected.append((stripped, stripped + \"/\"))\n110\t    for p in touched:\n111\t        if not p:\n112\t            continue\n113\t        for exact, prefix in protected:\n114\t            if p == exact or p.startswith(prefix):\n115\t                return p\n116\t    return None\n117\t\n118\t\n119\tdef executor_identity(adapter_name: str) -> dict[str, Any]:\n120\t    \"\"\"The executor's identity (issue #33): set by the product, never the\n121\t    tenant's git config, so an executor commit is never indistinguishable\n122\t    from an operator's own -- the specimen is attavo/code-factory@e22fa85.\n123\t    A reserved, undeliverable domain (.invalid) so no mailbox is implied.\n124\t    Distinct from the records app identity: the app says the product\n125\t    pushed this, this says an invocation authored this -- different\n126\t    facts, neither borrows the other's name.\"\"\"\n127\t    return {\"name\": f\"attavo executor ({adapter_name})\",\n128\t            \"email\": f\"executor+{adapter_name}@attavo.invalid\"}\n129\t\n130\t\n131\tdef driver_identity() -> dict[str, Any]:\n132\t    \"\"\"The driver's identity: set by the product, never the tenant's git\n133\t    config, so a driver's own transport commit -- a record commit\n134\t    `commit_record` makes on the driver's behalf -- is never\n135\t    indistinguishable from an operator's own; `git log --author='attavo\n136\t    driver'` on a driven item lists exactly those commits. Distinct from\n137\t    executor_identity: that names an adapter invocation's own commits,\n138\t    this names the transport that carries a stage's record.\"\"\"\n139\t    return {\"name\": \"attavo driver\", \"email\": \"driver@attavo.invalid\"}\n140\t\n141\t\n142\tdef commits_since(root: Path, start_sha: str, end: str = \"HEAD\") -> list[dict[str, Any]]:\n143\t    \"\"\"(sha, name, email) for every commit after start_sha up to and\n144\t    including end, first-parent only, oldest first. cmd_build's own call\n145\t    (start_sha at the invocation, end left at the default HEAD) never sees\n146\t    a merge in that window, so --first-parent changes nothing there;\n147\t    issue #128's ledger is the caller that needs it, to walk one branch's\n148\t    own line without a concurrent merge to main expanding into every\n149\t    commit main gained meanwhile.\"\"\"\n150\t    out = git(root, \"log\", \"--first-parent\", \"--reverse\",\n151\t             \"--format=%H\\x1f%an\\x1f%ae\", f\"{start_sha}..{end}\")\n152\t    commits = []\n153\t    for line in out.splitlines():\n154\t        if not line.strip():\n155\t            continue\n156\t        sha, name, email = line.split(\"\\x1f\")\n157\t        commits.append({\"sha\": sha, \"name\": name, \"email\": email})\n158\t    return commits\n159\t\n160\t\n161\tdef commits_with_diffs(root: Path, start_sha: str, end: str = \"HEAD\") -> list[dict[str, Any]]:\n162\t    \"\"\"commits_since's own (sha, name, email), each with its own\n163\t    first-parent diff already attached as \"touched\" -- one process for the\n164\t    whole range rather than commits_since's list plus a git diff per\n165\t    commit (issue #153, the cost item_ledger's own walk paid per commit).\"\"\"\n166\t    out = git(root, \"log\", \"--first-parent\", \"--reverse\", \"--diff-merges=first-parent\",\n167\t             \"--name-only\", \"--format=\\x01%H\\x1f%an\\x1f%ae\", f\"{start_sha}..{end}\")\n168\t    commits = []\n169\t    for block in out.split(\"\\x01\")[1:]:\n170\t        header, _, rest = block.partition(\"\\n\")\n171\t        sha, name, email = header.split(\"\\x1f\")\n172\t        commits.append({\"sha\": sha, \"name\": name, \"email\": email,\n173\t                        \"touched\": [line for line in rest.splitlines() if line.strip()]})\n174\t    return commits\n175\t\n176\t\n177\tdef split_adapter_stdout(stdout: str) -> tuple[str, dict[str, Any] | None]:\n178\t    \"\"\"(transcript, payload): the adapter's last non-empty stdout line is\n179\t    its JSON report, and everything before it is transcript, only when\n180\t    that last line actually parses as JSON. When it does not -- a tool's\n181\t    own error line printed last on a non-zero exit (issue #86: tenant\n182\t    zero attest/records/659/verify-01.log, codex's own \"Input exceeds...\"\n183\t    line, dropped because it was mistaken for an attempted payload) --\n184\t    nothing here is a report, and the whole stdout is the transcript, so\n185\t    that last line is not silently lost.\n186\t    \"\"\"\n187\t    lines = stdout.splitlines()\n188\t    non_empty = [i for i, l in enumerate(lines) if l.strip()]\n189\t    if not non_empty:\n190\t        return stdout, None\n191\t    last = non_empty[-1]\n192\t    try:\n193\t        payload = json.loads(lines[last])\n194\t    except ValueError:\n195\t        return stdout, None\n196\t    transcript = \"\\n\".join(lines[:last])\n197\t    return transcript, payload\n198\t\n199\t\n200\tBUILD_ITERATION_BUDGET = 3\n201\t\n202\tBUILD_HALT_EXIT = 3\n203\t\n204\tCHECKS_FEEDBACK_TAIL_LINES = 200\n205\t\n206\t\n207\tdef _retry_seed(root: Path, m: dict[str, Any], records_dir: Path\n208\t                ) -> tuple[str | None, str | None, str]:\n209\t    \"\"\"(retry_of, steer, feedback): what a retried build's first iteration\n210\t    is handed (R3), in this order -- the prior attempt's own class and\n211\t    signature; the evidence a returned review carries (a red required\n212\t    check's log, read through [forge].check_log_command, or a review's\n213\t    own blocking findings); and the newest steer newer than the blocking\n214\t    record (counsel's answer text, named by the record it came from). A\n215\t    build retries the latest build record that is not a pass, or --\n216\t    retry_of still naming that same build attempt, the one a required\n217\t    check rejected or a review returned -- the latest verify record that\n218\t    returned it (class returned, its own build_sha matching the latest\n219\t    build's): the two never coexist, since a returned review is read\n220\t    only once its own build has already passed. (None, None, \"\") on a\n221\t    first attempt -- nothing to retry, nothing to seed.\"\"\"\n222\t    latest_build = cast(\"dict[str, Any] | None\", latest_record(records_dir, \"build\"))\n223\t    latest_verify = cast(\"dict[str, Any] | None\", latest_record(records_dir, \"verify\"))\n224\t    prior_stem = f\"build-{next_attempt_number(records_dir, 'build') - 1:02d}\"\n225\t    prior: dict[str, Any] | None = None\n226\t    counsel_stage, counsel_n = \"build\", next_attempt_number(records_dir, \"build\") - 1\n227\t    if (latest_verify and (latest_verify.get(\"stop\") or {}).get(\"class\") == \"returned\"\n228\t            and latest_build and latest_verify.get(\"build_sha\") == latest_build.get(\"sha\")):\n229\t        prior = latest_verify\n230\t        verify_attempts = parse_attempts(records_dir, \"verify\")\n231\t        counsel_stage = \"verify\"\n232\t        counsel_n = max(verify_attempts) if verify_attempts else 0\n233\t    elif latest_build and latest_build.get(\"status\") != \"pass\":\n234\t        prior = latest_build\n235\t    if prior is None:\n236\t        return None, None, \"\"\n237\t\n238\t    stop: dict[str, Any] = prior.get(\"stop\") or {}\n239\t    lines = [f\"attempt {prior_stem} stopped as {stop.get('class')}: {stop.get('detail') or ''}\",\n240\t            f\"signature: {stop.get('signature') or ''}\", \"\"]\n241\t\n242\t    forge = m.get(\"forge\") or {}\n243\t    if stop.get(\"class\") == \"returned\":\n244\t        findings = [f for f in (prior.get(\"findings\") or [])\n245\t                   if str(f.get(\"severity\")) == \"blocking\"]\n246\t        if findings:\n247\t            lines.append(\"blocking findings:\")\n248\t            for finding in findings:\n249\t                lines.append(f\"- {finding.get('title')}: {finding.get('specimen')} \"\n250\t                             f\"(retires: {finding.get('retires')})\")\n251\t            lines.append(\"\")\n252\t        elif forge.get(\"check_log_command\"):\n253\t            for c in (prior.get(\"forge_checks\") or {}).get(\"conclusions\") or []:\n254\t                if c.get(\"conclusion\") in (\"success\", \"neutral\", \"skipped\"):\n255\t                    continue\n256\t                run = subprocess.run(\n257\t                    f\"{forge['check_log_command']} {shlex.quote(str(prior.get('sha')))} \"\n258\t                    f\"{shlex.quote(c['name'])}\", shell=True, cwd=str(root),\n259\t                    capture_output=True, text=True, check=False)\n260\t                lines += [f\"--- check {c['name']} {c['conclusion']} ---\",\n261\t                         run.stdout.strip(), \"\"]\n262\t\n263\t    steer_stem: str | None = None\n264\t    if counsel_n:\n265\t        target = f\"{counsel_stage}-{counsel_n:02d}\"\n266\t        counsel_attempts = parse_attempts(records_dir, \"counsel\")\n267\t        matches = [(n, rec) for n, rec in sorted(counsel_attempts.items())\n268\t                  if rec.get(\"record\") == target]\n269\t        if matches:\n270\t            nn, counsel = matches[-1]\n271\t            if counsel.get(\"verdict\") == \"answer\":\n272\t                steer_stem = f\"counsel-{nn:02d}\"\n273\t                answer = (counsel.get(\"proposal\") or {}).get(\"ruling_text\")\n274\t                if answer:\n275\t                    lines += [f\"steer from {steer_stem}:\", answer.strip(), \"\"]\n276\t\n277\t    return prior_stem, steer_stem, \"\\n\".join(lines) + \"\\n\"\n278\t\n279\t\n280\t@contextlib.contextmanager\n281\tdef gate_checkout(root: Path) -> Iterator[Path]:\n282\t    \"\"\"A detached worktree of root's HEAD, removed on exit: the tree the\n283\t    build's gate reads. The executor's own directory is not it -- a file\n284\t    written there and never committed is not part of the change, and a\n285\t    gate that read it would pass work that does not exist on the branch\n286\t    (item 227).\"\"\"\n287\t    parent = Path(tempfile.mkdtemp(prefix=\"attavo-gate-\"))\n288\t    tree = parent / \"head\"\n289\t    git(root, \"worktree\", \"add\", \"--detach\", \"-q\", str(tree), \"HEAD\")\n290\t    try:\n291\t        yield tree\n292\t    finally:\n293\t        try:\n294\t            git(root, \"worktree\", \"remove\", \"--force\", str(tree))\n295\t        except RuntimeError:\n296\t            shutil.rmtree(tree, ignore_errors=True)\n297\t            try:\n298\t                git(root, \"worktree\", \"prune\")\n299\t            except RuntimeError:\n300\t                pass\n301\t        shutil.rmtree(parent, ignore_errors=True)\n302\t\n303\t\n304\tdef cmd_build(argv: list[str]) -> int:\n305\t    root = Path(\".\").resolve()\n306\t    item_id = argv[0] if argv else derive_item_id(root)\n307\t    if not item_id:\n308\t        print(\"attavo build: cannot derive item id; pass N or run on an attavo/N-* branch\",\n309\t              file=sys.stderr)\n310\t        return 2\n311\t    m = read_manifest(root)\n312\t    if m is None:\n313\t        print(f\"attavo build: no {MANIFEST} at {root}\", file=sys.stderr)\n314\t        return 2\n315\t\n316\t    adapter_name = (m.get(\"executor\") or {}).get(\"build\")\n317\t    if not adapter_name:\n318\t        print(\"attavo build: refused: no [executor].build in the manifest\")\n319\t        return 1\n320\t\n321\t    tests_cfg = m.get(\"tests\") or {}\n322\t    if not tests_cfg.get(\"select\") or not tests_cfg.get(\"run\"):\n323\t        print(\"attavo build: refused: no [tests] table in the manifest \"\n324\t              \"([tests].select and [tests].run are both required)\")\n325\t        return 1\n326\t\n327\t    if (m.get(\"checks\") or {}).get(\"probe\") and not (m.get(\"checks\") or {}).get(\"probe_timeout_s\"):\n328\t        print(\"attavo build: refused: [checks].probe is declared without \"\n329\t              \"[checks].probe_timeout_s (a probe with no bound is not asked)\")\n330\t        return 1\n331\t\n332\t    try:\n333\t        status = approval_status(root, m, item_id)\n334\t    except ShallowCheckoutError as exc:\n335\t        print(f\"attavo build: refused: {exc}\", file=sys.stderr)\n336\t        return 2\n337\t    if status != \"valid\":\n338\t        print(f\"attavo build: refused: approval is {status}\")\n339\t        return 1\n340\t\n341\t    adapter_path = resolve_adapter(root, adapter_name)\n342\t    if adapter_path is None:\n343\t        print(f\"attavo build: refused: no adapter named {adapter_name!r}\")\n344\t        return 1\n345\t\n346\t    specs_rel = m[\"paths\"][\"specs\"]\n347\t    records_rel = m[\"paths\"][\"records\"]\n348\t    spec_dir = root / specs_rel / item_id\n349\t    item_records_dir = root / records_rel / item_id\n350\t    spec_sha = last_commit_touching(root, str(Path(specs_rel) / item_id))\n351\t    latest_approval = latest_record(item_records_dir, \"approval\")\n352\t    parsed, _ = parse_spec(spec_dir / \"spec.md\")\n353\t    claims = parsed[\"claims\"] if parsed else []\n354\t    criteria_names = parsed[\"criteria\"] if parsed else []\n355\t    adapter_config = merge_adapter_config(m, adapter_name, \"build\")\n356\t    checks_cfg = m.get(\"checks\") or {}\n357\t    checks_command = checks_cfg.get(\"command\")\n358\t    probe = checks_cfg.get(\"probe\")\n359\t    probe_timeout_s = checks_cfg.get(\"probe_timeout_s\")\n360\t    identity = executor_identity(adapter_name)\n361\t    reports = adapter_reports(adapter_path)\n362\t\n363\t    start_sha = git(root, \"rev-parse\", \"HEAD\").strip()\n364\t    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n365\t    started = time.monotonic()\n366\t\n367\t    events_path = stage_events_dir(root) / f\"build-{next_attempt_number(item_records_dir, 'build'):02d}.events.jsonl\"\n368\t\n369\t    # Issue #115, then issue #212: whether this machine can run the tenant's\n370\t    # checks at all is asked once here, on the approved tree, before the\n371\t    # adapter is ever invoked -- a missing import at test collection (item\n372\t    # #106's build-01) is not a failing check, and no build could have\n373\t    # passed against it. A tenant that declares [checks].probe is asked by\n374\t    # the probe, inside [checks].probe_timeout_s: exit 0 yes, anything else\n375\t    # or the bound no. A tenant that does not is asked the old way, by\n376\t    # running [checks].command whole -- exit 2 no, exit 0 or 1 (the checks\n377\t    # ran and passed or failed, the expected states before a build) yes --\n378\t    # which is the run #194's build-01 spent 215 s on. Either way the feed\n379\t    # says what is being asked and what the answer was.\n380\t    if checks_command:\n381\t        append_event(events_path, \"gate\", \"checking this machine can run the checks\")\n382\t        asked = checks_command\n383\t        if probe:\n384\t            asked = probe\n385\t            code, out, err, timed_out = run_bounded(probe, root, \"\", probe_timeout_s)\n386\t            refusal_text = (f\"[checks].probe did not finish within {probe_timeout_s} s\" if timed_out\n387\t                            else f\"[checks].probe exited {code} on the approved tree\"\n388\t                            if code != 0 else None)\n389\t        else:\n390\t            preflight = subprocess.run(checks_command, shell=True, cwd=str(root),\n391\t                                       capture_output=True, text=True, check=False)\n392\t            code, out, err = preflight.returncode, preflight.stdout, preflight.stderr\n393\t            refusal_text = (\"[checks].command exited 2 on the approved tree\" if code == 2 else None)\n394\t        if refusal_text:\n395\t            append_event(events_path, \"gate\", f\"this machine cannot run the checks: {refusal_text}\")\n396\t            log = out + err\n397\t            detail = _log_last_line(out + \"\\n\" + err) or refusal_text\n398\t            record = {\n399\t                \"sha\": start_sha,\n400\t                \"start_sha\": start_sha,\n401\t                \"spec_sha\": spec_sha,\n402\t                \"approval_sha\": latest_approval.get(\"sha\") if latest_approval else None,\n403\t                \"at\": now_iso(),\n404\t                \"adapter\": adapter_name,\n405\t                \"adapter_config\": adapter_config,\n406\t                \"executor_identity\": identity,\n407\t                \"reports\": reports,\n408\t                \"adapter_version\": None,\n409\t                \"model\": None,\n410\t                \"model_version\": None,\n411\t                \"iterations\": 1,\n412\t                \"criteria\": [],\n413\t                \"selected_tests\": None,\n414\t                \"checks\": {\"command\": asked, \"exit\": code},\n415\t                \"tokens\": {\"input\": 0, \"output\": 0},\n416\t                \"cost_usd\": None,\n417\t                \"wall_clock_s\": round(time.monotonic() - started, 3),\n418\t                \"status\": \"refused\",\n419\t                \"refusal\": refusal_text,\n420\t                \"halted\": None,\n421\t                \"retry_of\": None,\n422\t                \"steer\": None,\n423\t                # R3: environment is never retried by this item (recorded\n424\t                # here, acted on by R4's breaker) -- signed anyway for\n425\t                # the exhaustion report's own side-by-side, on the\n426\t                # remote chance a person retries by hand.\n427\t                \"stop\": {\"class\": \"environment\", \"provenance\": \"tenant\", \"detail\": detail,\n428\t                        \"signature\": signature_of(detail), \"bound\": None},\n429\t            }\n430\t            record_path = write_record(item_records_dir, \"build\", record, m, item_id,\n431\t                                       log=log or refusal_text + \"\\n\")\n432\t            print(f\"attavo build: refused ({record_path.name})\")\n433\t            return 1\n434\t        append_event(events_path, \"gate\", \"this machine can run the checks\")\n435\t\n436\t    adapter_version = model = model_version = None\n437\t    tokens = {\"input\": 0, \"output\": 0}\n438\t    cost_usd = None\n439\t    transcripts: list[str] = []\n440\t    criteria_results: list[dict[str, Any]] = []\n441\t    selected_tests: dict[str, Any] | None = None\n442\t    checks_result: dict[str, Any] | None = None\n443\t    status_out = \"failed\"\n444\t    refusal = None\n445\t    refusal_provenance = None\n446\t    halted = None\n447\t    empty_detail: str | None = None\n448\t    iterations_used = 0\n449\t\n450\t    with tempfile.TemporaryDirectory() as tmp:\n451\t        feedback_path = Path(tmp) / \"feedback.txt\"\n452\t        feedback_path.write_text(\"\")\n453\t        # R3: a retried attempt's first iteration starts with the prior\n454\t        # attempt's class and signature, its evidence, and the newest\n455\t        # steer newer than the blocking record -- the one file the\n456\t        # contract already passes, no new adapter input at all.\n457\t        retry_of, steer, seed = _retry_seed(root, m, item_records_dir)\n458\t        if seed:\n459\t            feedback_path.write_text(seed)\n460\t\n461\t        for iteration in range(1, BUILD_ITERATION_BUDGET + 1):\n462\t            iterations_used = iteration\n463\t            append_event(events_path, \"iteration\", f\"iteration {iteration} of {BUILD_ITERATION_BUDGET}\")\n464\t            env = dict(os.environ)\n465\t            # #212 retired the checks command reaching the executor; an\n466\t            # ATTAVO_CHECKS_COMMAND exported by whoever launched `attavo\n467\t            # build` must not reach it by inheritance either.\n468\t            env.pop(\"ATTAVO_CHECKS_COMMAND\", None)\n469\t            env[\"ATTAVO_SPEC_DIR\"] = str(spec_dir)\n470\t            env[\"ATTAVO_RECORDS_DIR\"] = str(item_records_dir)\n471\t            env[\"ATTAVO_RULINGS\"] = str(root / m[\"paths\"][\"rulings\"])\n472\t            env[\"ATTAVO_BRANCH\"] = branch\n473\t            env[\"ATTAVO_ITERATION\"] = str(iteration)\n474\t            env[\"ATTAVO_FEEDBACK\"] = str(feedback_path)\n475\t            env[\"ATTAVO_ADAPTER_CONFIG\"] = json.dumps(adapter_config)\n476\t            env[\"ATTAVO_STAGE\"] = \"build\"\n477\t            env[\"ATTAVO_EVENTS\"] = str(events_path)\n478\t            env[\"ATTAVO_TEST_COMMAND\"] = f\"python3 {PRODUCT_ROOT / 'bin' / 'attavo'} test {item_id}\"\n479\t            if tests_cfg.get(\"call_timeout_s\"):\n480\t                env[\"ATTAVO_TEST_TIMEOUT_S\"] = str(tests_cfg[\"call_timeout_s\"])\n481\t            else:\n482\t                env.pop(\"ATTAVO_TEST_TIMEOUT_S\", None)\n483\t            env[\"GIT_AUTHOR_NAME\"] = identity[\"name\"]\n484\t            env[\"GIT_AUTHOR_EMAIL\"] = identity[\"email\"]\n485\t            env[\"GIT_COMMITTER_NAME\"] = identity[\"name\"]\n486\t            env[\"GIT_COMMITTER_EMAIL\"] = identity[\"email\"]\n487\t\n488\t            run = subprocess.run([str(adapter_path)], cwd=str(root), env=env,\n489\t                                 capture_output=True, text=True, check=False)\n490\t            transcript, payload = split_adapter_stdout(run.stdout)\n491\t            if run.returncode != 0:\n492\t                # The guarantee behind issue #53's refusal: an adapter that\n493\t                # exits non-zero always leaves a non-empty log, even one\n494\t                # that printed nothing at all on stderr.\n495\t                detail = f\"[adapter exited {run.returncode}]\"\n496\t                if run.stderr.strip():\n497\t                    detail += \"\\n\" + run.stderr.rstrip(\"\\n\")\n498\t                transcript = (transcript + \"\\n\" if transcript else \"\") + detail\n499\t            transcripts.append(transcript)\n500\t\n501\t            if run.returncode != 0 or payload is None or not payload.get(\"model\"):\n502\t                status_out = \"failed\"\n503\t                break\n504\t\n505\t            adapter_version = payload.get(\"adapter_version\")\n506\t            model = payload.get(\"model\")\n507\t            model_version = payload.get(\"model_version\")\n508\t            tok = payload.get(\"tokens\") or {}\n509\t            tokens[\"input\"] += tok.get(\"input\", 0) or 0\n510\t            tokens[\"output\"] += tok.get(\"output\", 0) or 0\n511\t            iter_cost = payload.get(\"cost_usd\")\n512\t            if iter_cost is not None:\n513\t                cost_usd = (cost_usd or 0) + iter_cost\n514\t\n515\t            if payload.get(\"status\") == \"question\":\n516\t                status_out = \"halted\"\n517\t                halted = {\"question\": payload.get(\"question\")}\n518\t                break\n519\t\n520\t            foreign = next((c for c in commits_since(root, start_sha)\n521\t                           if c[\"name\"] != identity[\"name\"] or c[\"email\"] != identity[\"email\"]),\n522\t                          None)\n523\t            if foreign:\n524\t                status_out = \"refused\"\n525\t                refusal = f\"commit {foreign['sha']} not authored by the executor\"\n526\t                break\n527\t\n528\t            # An executor that committed nothing built nothing, whatever it\n529\t            # left in the working tree: the gate below reads the commit, so\n530\t            # an empty iteration fails its gate on the approved tree and is\n531\t            # told why; an empty last iteration is halted, class empty\n532\t            # (item 227: twelve stub files copied into the tree, no commit,\n533\t            # a pass, a review, a seal, and no change on main).\n534\t            committed_nothing = git(root, \"rev-parse\", \"HEAD\").strip() == start_sha\n535\t            left_uncommitted = [\n536\t                line for line in git(root, \"status\", \"--porcelain\", \"--untracked-files=all\").splitlines()\n537\t                if line.strip() and not line[3:].startswith(records_rel.rstrip(\"/\") + \"/\")]\n538\t            empty_line = (f\"no commit since {start_sha[:12]}; {len(left_uncommitted)} path(s) \"\n539\t                          \"modified or untracked in the working tree, which the gate does not read\"\n540\t                          if committed_nothing else None)\n541\t\n542\t            protected = protected_path_touched(root, start_sha, records_rel, specs_rel)\n543\t            if protected:\n544\t                status_out = \"refused\"\n545\t                refusal = protected\n546\t                refusal_provenance = \"executor\"\n547\t                break\n548\t\n549\t            touched = sorted(changed_paths(root, start_sha, records_rel))\n550\t            bad_path = next((p for p in touched if not matches_a_claim(p, claims)), None)\n551\t            if bad_path:\n552\t                status_out = \"refused\"\n553\t                refusal = bad_path\n554\t                break\n555\t\n556\t            # The gate reads the commit, never the executor's directory: a\n557\t            # detached worktree of HEAD, so a file written and not committed\n558\t            # cannot pass a criterion, a test or a check on the executor's\n559\t            # behalf (item 227). Removed before the iteration ends.\n560\t            with gate_checkout(root) as gate_root:\n561\t                criteria_results = [\n562\t                    {\"name\": name, \"exit\": run_criterion(spec_dir / \"criteria\" / name, gate_root)}\n563\t                    for name in criteria_names]\n564\t                for c in criteria_results:\n565\t                    append_event(events_path, \"gate\", f\"{c['name']}: exit {c['exit']}\")\n566\t\n567\t                select_in = \"\".join(p + \"\\n\" for p in touched)\n568\t                select_run = subprocess.run(tests_cfg[\"select\"], shell=True, cwd=str(gate_root),\n569\t                                            input=select_in, capture_output=True,\n570\t                                            text=True, check=False)\n571\t                identifiers = [l for l in select_run.stdout.splitlines() if l.strip()]\n572\t                run_in = \"\".join(i + \"\\n\" for i in identifiers)\n573\t                test_run = subprocess.run(tests_cfg[\"run\"], shell=True, cwd=str(gate_root),\n574\t                                          input=run_in, capture_output=True,\n575\t                                          text=True, check=False)\n576\t                selected_tests = {\"select\": tests_cfg[\"select\"], \"run\": tests_cfg[\"run\"],\n577\t                                  \"count\": len(identifiers), \"exit\": test_run.returncode}\n578\t\n579\t                checks_run = None\n580\t                if checks_command:\n581\t                    checks_run = subprocess.run(checks_command, shell=True, cwd=str(gate_root),\n582\t                                                capture_output=True, text=True, check=False)\n583\t                    checks_result = {\"command\": checks_command, \"exit\": checks_run.returncode}\n584\t\n585\t            # Issue #89, rejection test 1: the gate output that decides pass\n586\t            # or fail is appended to the build log itself, under a heading\n587\t            # per iteration, before this temporary directory goes away --\n588\t            # tenant zero's #576 build-11 and #659 build-01 are a failed\n589\t            # record with nothing beside it to say what was red, because\n590\t            # this output previously lived only in feedback.txt, in a\n591\t            # tempfile.TemporaryDirectory() cmd_build deletes on return.\n592\t            gate_lines = [f\"criterion {c['name']}: exit {c['exit']}\" for c in criteria_results]\n593\t            gate_lines.append(f\"selected tests ({selected_tests['count']}): exit \"\n594\t                              f\"{selected_tests['exit']}\")\n595\t            if test_run.stdout.strip():\n596\t                gate_lines += [\"--- selected tests stdout ---\", test_run.stdout.rstrip(\"\\n\")]\n597\t            if test_run.stderr.strip():\n598\t                gate_lines += [\"--- selected tests stderr ---\", test_run.stderr.rstrip(\"\\n\")]\n599\t            if checks_run is not None:\n600\t                tail = (checks_run.stdout.splitlines() + checks_run.stderr.splitlines())\n601\t                tail = tail[-CHECKS_FEEDBACK_TAIL_LINES:]\n602\t                gate_lines.append(f\"tenant checks: exit {checks_run.returncode}\")\n603\t                gate_lines += [\"--- checks output (tail) ---\", *tail]\n604\t            transcripts[-1] += (f\"\\n--- attavo gates, iteration {iteration} ---\\n\"\n605\t                               + \"\\n\".join(gate_lines))\n606\t\n607\t            if empty_line:\n608\t                transcripts[-1] += (\"\\nyou committed nothing: \" + empty_line +\n609\t                                    \"\\ncommit your work; the gate reads the commit, not the tree\")\n610\t\n611\t            failing = [c for c in criteria_results if c[\"exit\"] != 0]\n612\t            checks_ok = checks_run is None or checks_run.returncode == 0\n613\t            if not failing and test_run.returncode == 0 and checks_ok and not committed_nothing:\n614\t                status_out = \"pass\"\n615\t                break\n616\t\n617\t            if iteration == BUILD_ITERATION_BUDGET:\n618\t                if committed_nothing:\n619\t                    status_out = \"halted\"\n620\t                    halted = {\"question\": None}\n621\t                    empty_detail = f\"the executor committed nothing; {empty_line}\"\n622\t                else:\n623\t                    status_out = \"failed\"\n624\t                break\n625\t\n626\t            feedback_lines = []\n627\t            if empty_line:\n628\t                feedback_lines += [\"you committed nothing: \" + empty_line,\n629\t                                   \"commit your work; the gate reads the commit, not the tree\"]\n630\t            if failing:\n631\t                feedback_lines.append(\"criteria failing:\")\n632\t                feedback_lines += [f\"- {c['name']}: exit {c['exit']}\" for c in failing]\n633\t            if test_run.returncode != 0:\n634\t                feedback_lines += [f\"test run exit {test_run.returncode}\",\n635\t                                   \"--- stdout ---\", test_run.stdout,\n636\t                                   \"--- stderr ---\", test_run.stderr]\n637\t            if checks_run is not None and checks_run.returncode != 0:\n638\t                tail = (checks_run.stdout.splitlines() + checks_run.stderr.splitlines())\n639\t                tail = tail[-CHECKS_FEEDBACK_TAIL_LINES:]\n640\t                feedback_lines += [f\"checks exit {checks_run.returncode}\",\n641\t                                   \"--- checks output (tail) ---\", *tail]\n642\t            feedback_path.write_text(\"\\n\".join(feedback_lines) + \"\\n\")\n643\t\n644\t    record = {\n645\t        \"sha\": git(root, \"rev-parse\", \"HEAD\").strip(),\n646\t        \"start_sha\": start_sha,\n647\t        \"spec_sha\": spec_sha,\n648\t        \"approval_sha\": latest_approval.get(\"sha\") if latest_approval else None,\n649\t        \"at\": now_iso(),\n650\t        \"adapter\": adapter_name,\n651\t        \"adapter_config\": adapter_config,\n652\t        \"executor_identity\": identity,\n653\t        \"reports\": reports,\n654\t        \"adapter_version\": adapter_version,\n655\t        \"model\": model,\n656\t        \"model_version\": model_version,\n657\t        \"iterations\": iterations_used,\n658\t        \"criteria\": criteria_results,\n659\t        \"selected_tests\": selected_tests,\n660\t        \"checks\": checks_result,\n661\t        \"tokens\": tokens,\n662\t        \"cost_usd\": cost_usd,\n663\t        \"wall_clock_s\": round(time.monotonic() - started, 3),\n664\t        \"status\": status_out,\n665\t        \"refusal\": refusal,\n666\t        \"halted\": halted,\n667\t        \"retry_of\": retry_of,\n668\t        \"steer\": steer,\n669\t        \"stop\": derive_stop(status_out, refusal=refusal, halted=halted,\n670\t                            log=\"\\n\".join(transcripts),\n671\t                            report_class=\"empty\" if empty_detail else (payload or {}).get(\"class\"),\n672\t                            refusal_provenance=refusal_provenance),\n673\t    }\n674\t    if record[\"stop\"] is not None and empty_detail:\n675\t        record[\"stop\"] = {**record[\"stop\"], \"detail\": empty_detail}\n676\t    if record[\"stop\"] is not None:\n677\t        stop_out: dict[str, Any] = record[\"stop\"]\n678\t        # R3: transient's own signature is the adapter's stop detail\n679\t        # (payload.get(\"detail\")), not derive_stop's detail (which is\n680\t        # None for every class but unclassed/question/environment/gate);\n681\t        # every other non-pass class signs off its own detail (None for\n682\t        # most, so signature is None too -- the class alone, or the log\n683\t        # itself for unclassed, is the specimen's own cause).\n684\t        stop_detail: str | None = ((payload or {}).get(\"detail\") if stop_out[\"class\"] == \"transient\"\n685\t                                   else stop_out.get(\"detail\"))\n686\t        record[\"stop\"] = {**stop_out, \"detail\": stop_detail, \"signature\": signature_of(stop_detail),\n687\t                          \"bound\": None}\n688\t    record_path = write_record(item_records_dir, \"build\", record, m, item_id,\n689\t                               log=\"\\n\".join(transcripts))\n690\t\n691\t    print(f\"attavo build: {status_out} ({record_path.name})\")\n692\t    if status_out == \"halted\":\n693\t        return BUILD_HALT_EXIT\n694\t    return 0 if status_out == \"pass\" else 1\n695\t"}]},"parent_tool_use_id":null,"session_id":"8b9a9eba-cd13-4154-8596-ab0c96cc1266","uuid":"59d19d20-f5b2-438c-8b82-b1a485036cfe","timestamp":"2026-09-27T15:18:11.626Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-229/attavo/build.py","content":"from __future__ import annotations\n\nimport fnmatch\nimport contextlib\nimport json\nimport shutil\nimport os\nimport shlex\nimport subprocess\nimport sys\nimport tempfile\nimport time\nfrom pathlib import Path\nfrom typing import Any, Iterator, cast\n\nfrom attavo.approval import approval_status\nfrom attavo.common import (\n    MANIFEST,\n    PRODUCT_ROOT,\n    ShallowCheckoutError,\n    derive_item_id,\n    git,\n    last_commit_touching,\n    now_iso,\n    read_manifest,\n)\nfrom attavo.events import append_event, stage_events_dir\nfrom attavo.records import latest_record, next_attempt_number, parse_attempts, write_record\nfrom attavo.spec import parse_spec, run_criterion\nfrom attavo.stops import _log_last_line, derive_stop, signature_of\nfrom attavo.testtool import run_bounded, without_records\n\n# --- build: adapter, claims boundary, criteria, and the tenant's tests ---\n\nSTAGE_NAMES = (\"build\", \"verify\", \"counsel\")\n\n\ndef merge_adapter_config(m: dict[str, Any], adapter_name: str, stage: str) -> dict[str, Any]:\n    \"\"\"[executor.<adapter>] merged with [executor.<adapter>.<stage>], the\n    stage table shadowing the parent for that stage only. Both build and\n    verify call this before setting ATTAVO_ADAPTER_CONFIG, and the\n    record's adapter_config is the merged result.\"\"\"\n    parent = (m.get(\"executor\") or {}).get(adapter_name) or {}\n    if not isinstance(parent, dict):\n        return {}\n    merged = {k: v for k, v in parent.items() if k not in STAGE_NAMES}\n    stage_table = parent.get(stage)\n    if isinstance(stage_table, dict):\n        merged.update(stage_table)\n    return merged\n\n\ndef resolve_adapter(root: Path, name: str) -> Path | None:\n    \"\"\"adapters/<name>/run, resolved first under the tenant's own\n    attavo/adapters/, then under this product's adapters/.\"\"\"\n    for base in (root / \"attavo\" / \"adapters\", PRODUCT_ROOT / \"adapters\"):\n        candidate = base / name / \"run\"\n        if candidate.is_file():\n            return candidate\n    return None\n\n\ndef adapter_reports(adapter_path: Path) -> list[str]:\n    \"\"\"Field names adapters/<name>/conformance.json declares this adapter\n    can supply with a real value -- vendor independence (2026-09-09\n    ruling): the record carries the declaration, so an adapter claiming\n    a field and returning null for it fails the conformance suite\n    instead of writing a silent, uncomparable null. [] when the\n    resolved adapter (a tenant override included) declares no\n    conformance.json at all -- an absent declaration, not a refusal.\"\"\"\n    manifest_path = adapter_path.parent / \"conformance.json\"\n    if not manifest_path.is_file():\n        return []\n    try:\n        manifest = json.loads(manifest_path.read_text())\n    except json.JSONDecodeError:\n        return []\n    reports: list[str] = manifest.get(\"reports\", [])\n    return reports\n\n\ndef changed_paths(root: Path, start_sha: str, records_rel: str) -> list[str]:\n    \"\"\"Paths changed between start_sha and HEAD, other than paths.records --\n    the records directory is where build itself writes, not a claim.\"\"\"\n    return without_records(git(root, \"diff\", \"--name-only\", start_sha, \"HEAD\").splitlines(),\n                           records_rel)\n\n\ndef matches_a_claim(path: str, claims: list[str]) -> bool:\n    return any(fnmatch.fnmatch(path, pattern) for pattern in claims)\n\n\ndef protected_path_touched(root: Path, start_sha: str, records_rel: str,\n                           specs_rel: str) -> str | None:\n    \"\"\"The first path an executor's own commits touched under\n    paths.records or paths.specs since start_sha, or None (issue #140).\n    Neither directory is a claim a spec can make -- paths.records is\n    where the product itself writes, paths.specs is the definition of\n    done -- yet changed_paths above excludes paths.records from the\n    ordinary claims check entirely, so a path there never even reached\n    matches_a_claim to be refused: tenant zero's own item #688 committed\n    its own events file this way, under its records directory, on a\n    build that then passed. Checked directly against the raw diff, not\n    changed_paths's already-filtered list.\"\"\"\n    touched = git(root, \"diff\", \"--name-only\", start_sha, \"HEAD\").splitlines()\n    protected = []\n    for rel in (records_rel, specs_rel):\n        stripped = rel.rstrip(\"/\")\n        protected.append((stripped, stripped + \"/\"))\n    for p in touched:\n        if not p:\n            continue\n        for exact, prefix in protected:\n            if p == exact or p.startswith(prefix):\n                return p\n    return None\n\n\ndef executor_identity(adapter_name: str) -> dict[str, Any]:\n    \"\"\"The executor's identity (issue #33): set by the product, never the\n    tenant's git config, so an executor commit is never indistinguishable\n    from an operator's own -- the specimen is attavo/code-factory@e22fa85.\n    A reserved, undeliverable domain (.invalid) so no mailbox is implied.\n    Distinct from the records app identity: the app says the product\n    pushed this, this says an invocation authored this -- different\n    facts, neither borrows the other's name.\"\"\"\n    return {\"name\": f\"attavo executor ({adapter_name})\",\n            \"email\": f\"executor+{adapter_name}@attavo.invalid\"}\n\n\ndef driver_identity() -> dict[str, Any]:\n    \"\"\"The driver's identity: set by the product, never the tenant's git\n    config, so a driver's own transport commit -- a record commit\n    `commit_record` makes on the driver's behalf -- is never\n    indistinguishable from an operator's own; `git log --author='attavo\n    driver'` on a driven item lists exactly those commits. Distinct from\n    executor_identity: that names an adapter invocation's own commits,\n    this names the transport that carries a stage's record.\"\"\"\n    return {\"name\": \"attavo driver\", \"email\": \"driver@attavo.invalid\"}\n\n\ndef commits_since(root: Path, start_sha: str, end: str = \"HEAD\") -> list[dict[str, Any]]:\n    \"\"\"(sha, name, email) for every commit after start_sha up to and\n    including end, first-parent only, oldest first. cmd_build's own call\n    (start_sha at the invocation, end left at the default HEAD) never sees\n    a merge in that window, so --first-parent changes nothing there;\n    issue #128's ledger is the caller that needs it, to walk one branch's\n    own line without a concurrent merge to main expanding into every\n    commit main gained meanwhile.\"\"\"\n    out = git(root, \"log\", \"--first-parent\", \"--reverse\",\n             \"--format=%H\\x1f%an\\x1f%ae\", f\"{start_sha}..{end}\")\n    commits = []\n    for line in out.splitlines():\n        if not line.strip():\n            continue\n        sha, name, email = line.split(\"\\x1f\")\n        commits.append({\"sha\": sha, \"name\": name, \"email\": email})\n    return commits\n\n\ndef commits_with_diffs(root: Path, start_sha: str, end: str = \"HEAD\") -> list[dict[str, Any]]:\n    \"\"\"commits_since's own (sha, name, email), each with its own\n    first-parent diff already attached as \"touched\" -- one process for the\n    whole range rather than commits_since's list plus a git diff per\n    commit (issue #153, the cost item_ledger's own walk paid per commit).\"\"\"\n    out = git(root, \"log\", \"--first-parent\", \"--reverse\", \"--diff-merges=first-parent\",\n             \"--name-only\", \"--format=\\x01%H\\x1f%an\\x1f%ae\", f\"{start_sha}..{end}\")\n    commits = []\n    for block in out.split(\"\\x01\")[1:]:\n        header, _, rest = block.partition(\"\\n\")\n        sha, name, email = header.split(\"\\x1f\")\n        commits.append({\"sha\": sha, \"name\": name, \"email\": email,\n                        \"touched\": [line for line in rest.splitlines() if line.strip()]})\n    return commits\n\n\ndef split_adapter_stdout(stdout: str) -> tuple[str, dict[str, Any] | None]:\n    \"\"\"(transcript, payload): the adapter's last non-empty stdout line is\n    its JSON report, and everything before it is transcript, only when\n    that last line actually parses as JSON. When it does not -- a tool's\n    own error line printed last on a non-zero exit (issue #86: tenant\n    zero attest/records/659/verify-01.log, codex's own \"Input exceeds...\"\n    line, dropped because it was mistaken for an attempted payload) --\n    nothing here is a report, and the whole stdout is the transcript, so\n    that last line is not silently lost.\n    \"\"\"\n    lines = stdout.splitlines()\n    non_empty = [i for i, l in enumerate(lines) if l.strip()]\n    if not non_empty:\n        return stdout, None\n    last = non_empty[-1]\n    try:\n        payload = json.loads(lines[last])\n    except ValueError:\n        return stdout, None\n    transcript = \"\\n\".join(lines[:last])\n    return transcript, payload\n\n\nBUILD_ITERATION_BUDGET = 3\n\nBUILD_HALT_EXIT = 3\n\nCHECKS_FEEDBACK_TAIL_LINES = 200\n\n\ndef _retry_seed(root: Path, m: dict[str, Any], records_dir: Path\n                ) -> tuple[str | None, str | None, str]:\n    \"\"\"(retry_of, steer, feedback): what a retried build's first iteration\n    is handed (R3), in this order -- the prior attempt's own class and\n    signature; the evidence a returned review carries (a red required\n    check's log, read through [forge].check_log_command, or a review's\n    own blocking findings); and the newest steer newer than the blocking\n    record (counsel's answer text, named by the record it came from). A\n    build retries the latest build record that is not a pass, or --\n    retry_of still naming that same build attempt, the one a required\n    check rejected or a review returned -- the latest verify record that\n    returned it (class returned, its own build_sha matching the latest\n    build's): the two never coexist, since a returned review is read\n    only once its own build has already passed. (None, None, \"\") on a\n    first attempt -- nothing to retry, nothing to seed.\"\"\"\n    latest_build = cast(\"dict[str, Any] | None\", latest_record(records_dir, \"build\"))\n    latest_verify = cast(\"dict[str, Any] | None\", latest_record(records_dir, \"verify\"))\n    prior_stem = f\"build-{next_attempt_number(records_dir, 'build') - 1:02d}\"\n    prior: dict[str, Any] | None = None\n    counsel_stage, counsel_n = \"build\", next_attempt_number(records_dir, \"build\") - 1\n    if (latest_verify and (latest_verify.get(\"stop\") or {}).get(\"class\") == \"returned\"\n            and latest_build and latest_verify.get(\"build_sha\") == latest_build.get(\"sha\")):\n        prior = latest_verify\n        verify_attempts = parse_attempts(records_dir, \"verify\")\n        counsel_stage = \"verify\"\n        counsel_n = max(verify_attempts) if verify_attempts else 0\n    elif latest_build and latest_build.get(\"status\") != \"pass\":\n        prior = latest_build\n    if prior is None:\n        return None, None, \"\"\n\n    stop: dict[str, Any] = prior.get(\"stop\") or {}\n    lines = [f\"attempt {prior_stem} stopped as {stop.get('class')}: {stop.get('detail') or ''}\",\n            f\"signature: {stop.get('signature') or ''}\", \"\"]\n\n    forge = m.get(\"forge\") or {}\n    if stop.get(\"class\") == \"returned\":\n        findings = [f for f in (prior.get(\"findings\") or [])\n                   if str(f.get(\"severity\")) == \"blocking\"]\n        if findings:\n            lines.append(\"blocking findings:\")\n            for finding in findings:\n                lines.append(f\"- {finding.get('title')}: {finding.get('specimen')} \"\n                             f\"(retires: {finding.get('retires')})\")\n            lines.append(\"\")\n        elif forge.get(\"check_log_command\"):\n            for c in (prior.get(\"forge_checks\") or {}).get(\"conclusions\") or []:\n                if c.get(\"conclusion\") in (\"success\", \"neutral\", \"skipped\"):\n                    continue\n                run = subprocess.run(\n                    f\"{forge['check_log_command']} {shlex.quote(str(prior.get('sha')))} \"\n                    f\"{shlex.quote(c['name'])}\", shell=True, cwd=str(root),\n                    capture_output=True, text=True, check=False)\n                lines += [f\"--- check {c['name']} {c['conclusion']} ---\",\n                         run.stdout.strip(), \"\"]\n\n    steer_stem: str | None = None\n    if counsel_n:\n        target = f\"{counsel_stage}-{counsel_n:02d}\"\n        counsel_attempts = parse_attempts(records_dir, \"counsel\")\n        matches = [(n, rec) for n, rec in sorted(counsel_attempts.items())\n                  if rec.get(\"record\") == target]\n        if matches:\n            nn, counsel = matches[-1]\n            if counsel.get(\"verdict\") == \"answer\":\n                steer_stem = f\"counsel-{nn:02d}\"\n                answer = (counsel.get(\"proposal\") or {}).get(\"ruling_text\")\n                if answer:\n                    lines += [f\"steer from {steer_stem}:\", answer.strip(), \"\"]\n\n    return prior_stem, steer_stem, \"\\n\".join(lines) + \"\\n\"\n\n\n@contextlib.contextmanager\ndef gate_checkout(root: Path) -> Iterator[Path]:\n    \"\"\"A detached worktree of root's HEAD, removed on exit: the tree the\n    build's gate reads. The executor's own directory is not it -- a file\n    written there and never committed is not part of the change, and a\n    gate that read it would pass work that does not exist on the branch\n    (item 227).\"\"\"\n    parent = Path(tempfile.mkdtemp(prefix=\"attavo-gate-\"))\n    tree = parent / \"head\"\n    git(root, \"worktree\", \"add\", \"--detach\", \"-q\", str(tree), \"HEAD\")\n    try:\n        yield tree\n    finally:\n        try:\n            git(root, \"worktree\", \"remove\", \"--force\", str(tree))\n        except RuntimeError:\n            shutil.rmtree(tree, ignore_errors=True)\n            try:\n                git(root, \"worktree\", \"prune\")\n            except RuntimeError:\n                pass\n        shutil.rmtree(parent, ignore_errors=True)\n\n\ndef cmd_build(argv: list[str]) -> int:\n    root = Path(\".\").resolve()\n    item_id = argv[0] if argv else derive_item_id(root)\n    if not item_id:\n        print(\"attavo build: cannot derive item id; pass N or run on an attavo/N-* branch\",\n              file=sys.stderr)\n        return 2\n    m = read_manifest(root)\n    if m is None:\n        print(f\"attavo build: no {MANIFEST} at {root}\", file=sys.stderr)\n        return 2\n\n    adapter_name = (m.get(\"executor\") or {}).get(\"build\")\n    if not adapter_name:\n        print(\"attavo build: refused: no [executor].build in the manifest\")\n        return 1\n\n    tests_cfg = m.get(\"tests\") or {}\n    if not tests_cfg.get(\"select\") or not tests_cfg.get(\"run\"):\n        print(\"attavo build: refused: no [tests] table in the manifest \"\n              \"([tests].select and [tests].run are both required)\")\n        return 1\n\n    if (m.get(\"checks\") or {}).get(\"probe\") and not (m.get(\"checks\") or {}).get(\"probe_timeout_s\"):\n        print(\"attavo build: refused: [checks].probe is declared without \"\n              \"[checks].probe_timeout_s (a probe with no bound is not asked)\")\n        return 1\n\n    try:\n        status = approval_status(root, m, item_id)\n    except ShallowCheckoutError as exc:\n        print(f\"attavo build: refused: {exc}\", file=sys.stderr)\n        return 2\n    if status != \"valid\":\n        print(f\"attavo build: refused: approval is {status}\")\n        return 1\n\n    adapter_path = resolve_adapter(root, adapter_name)\n    if adapter_path is None:\n        print(f\"attavo build: refused: no adapter named {adapter_name!r}\")\n        return 1\n\n    specs_rel = m[\"paths\"][\"specs\"]\n    records_rel = m[\"paths\"][\"records\"]\n    spec_dir = root / specs_rel / item_id\n    item_records_dir = root / records_rel / item_id\n    spec_sha = last_commit_touching(root, str(Path(specs_rel) / item_id))\n    latest_approval = latest_record(item_records_dir, \"approval\")\n    parsed, _ = parse_spec(spec_dir / \"spec.md\")\n    claims = parsed[\"claims\"] if parsed else []\n    criteria_names = parsed[\"criteria\"] if parsed else []\n    adapter_config = merge_adapter_config(m, adapter_name, \"build\")\n    checks_cfg = m.get(\"checks\") or {}\n    checks_command = checks_cfg.get(\"command\")\n    probe = checks_cfg.get(\"probe\")\n    probe_timeout_s = checks_cfg.get(\"probe_timeout_s\")\n    identity = executor_identity(adapter_name)\n    reports = adapter_reports(adapter_path)\n\n    start_sha = git(root, \"rev-parse\", \"HEAD\").strip()\n    branch = git(root, \"rev-parse\", \"--abbrev-ref\", \"HEAD\").strip()\n    started = time.monotonic()\n\n    events_path = stage_events_dir(root) / f\"build-{next_attempt_number(item_records_dir, 'build'):02d}.events.jsonl\"\n\n    # Issue #115, then issue #212: whether this machine can run the tenant's\n    # checks at all is asked once here, on the approved tree, before the\n    # adapter is ever invoked -- a missing import at test collection (item\n    # #106's build-01) is not a failing check, and no build could have\n    # passed against it. A tenant that declares [checks].probe is asked by\n    # the probe, inside [checks].probe_timeout_s: exit 0 yes, anything else\n    # or the bound no. A tenant that does not is asked the old way, by\n    # running [checks].command whole -- exit 2 no, exit 0 or 1 (the checks\n    # ran and passed or failed, the expected states before a build) yes --\n    # which is the run #194's build-01 spent 215 s on. Either way the feed\n    # says what is being asked and what the answer was.\n    if checks_command:\n        append_event(events_path, \"gate\", \"checking this machine can run the checks\")\n        asked = checks_command\n        if probe:\n            asked = probe\n            code, out, err, timed_out = run_bounded(probe, root, \"\", probe_timeout_s)\n            refusal_text = (f\"[checks].probe did not finish within {probe_timeout_s} s\" if timed_out\n                            else f\"[checks].probe exited {code} on the approved tree\"\n                            if code != 0 else None)\n        else:\n            preflight = subprocess.run(checks_command, shell=True, cwd=str(root),\n                                       capture_output=True, text=True, check=False)\n            code, out, err = preflight.returncode, preflight.stdout, preflight.stderr\n            refusal_text = (\"[checks].command exited 2 on the approved tree\" if code == 2 else None)\n        if refusal_text:\n            append_event(events_path, \"gate\", f\"this machine cannot run the checks: {refusal_text}\")\n            log = out + err\n            detail = _log_last_line(out + \"\\n\" + err) or refusal_text\n            record = {\n                \"sha\": start_sha,\n                \"start_sha\": start_sha,\n                \"spec_sha\": spec_sha,\n                \"approval_sha\": latest_approval.get(\"sha\") if latest_approval else None,\n                \"at\": now_iso(),\n                \"adapter\": adapter_name,\n                \"adapter_config\": adapter_config,\n                \"executor_identity\": identity,\n                \"reports\": reports,\n                \"adapter_version\": None,\n                \"model\": None,\n                \"model_version\": None,\n                \"iterations\": 1,\n                \"criteria\": [],\n                \"selected_tests\": None,\n                \"checks\": {\"command\": asked, \"exit\": code},\n                \"tokens\": {\"input\": 0, \"output\": 0},\n                \"cost_usd\": None,\n                \"wall_clock_s\": round(time.monotonic() - started, 3),\n                \"status\": \"refused\",\n                \"refusal\": refusal_text,\n                \"halted\": None,\n                \"retry_of\": None,\n                \"steer\": None,\n                # R3: environment is never retried by this item (recorded\n                # here, acted on by R4's breaker) -- signed anyway for\n                # the exhaustion report's own side-by-side, on the\n                # remote chance a person retries by hand.\n                \"stop\": {\"class\": \"environment\", \"provenance\": \"tenant\", \"detail\": detail,\n                        \"signature\": signature_of(detail), \"bound\": None},\n            }\n            record_path = write_record(item_records_dir, \"build\", record, m, item_id,\n                                       log=log or refusal_text + \"\\n\")\n            print(f\"attavo build: refused ({record_path.name})\")\n            return 1\n        append_event(events_path, \"gate\", \"this machine can run the checks\")\n\n    adapter_version = model = model_version = None\n    tokens = {\"input\": 0, \"output\": 0}\n    cost_usd = None\n    transcripts: list[str] = []\n    criteria_results: list[dict[str, Any]] = []\n    selected_tests: dict[str, Any] | None = None\n    checks_result: dict[str, Any] | None = None\n    status_out = \"failed\"\n    refusal = None\n    refusal_provenance = None\n    halted = None\n    empty_detail: str | None = None\n    iterations_used = 0\n\n    with tempfile.TemporaryDirectory() as tmp:\n        feedback_path = Path(tmp) / \"feedback.txt\"\n        feedback_path.write_text(\"\")\n        # R3: a retried attempt's first iteration starts with the prior\n        # attempt's class and signature, its evidence, and the newest\n        # steer newer than the blocking record -- the one file the\n        # contract already passes, no new adapter input at all.\n        retry_of, steer, seed = _retry_seed(root, m, item_records_dir)\n        if seed:\n            feedback_path.write_text(seed)\n\n        for iteration in range(1, BUILD_ITERATION_BUDGET + 1):\n            iterations_used = iteration\n            append_event(events_path, \"iteration\", f\"iteration {iteration} of {BUILD_ITERATION_BUDGET}\")\n            env = dict(os.environ)\n            # #212 retired the checks command reaching the executor; an\n            # ATTAVO_CHECKS_COMMAND exported by whoever launched `attavo\n            # build` must not reach it by inheritance either.\n            env.pop(\"ATTAVO_CHECKS_COMMAND\", None)\n            env[\"ATTAVO_SPEC_DIR\"] = str(spec_dir)\n            env[\"ATTAVO_RECORDS_DIR\"] = str(item_records_dir)\n            env[\"ATTAVO_RULINGS\"] = str(root / m[\"paths\"][\"rulings\"])\n            env[\"ATTAVO_BRANCH\"] = branch\n            env[\"ATTAVO_ITERATION\"] = str(iteration)\n            env[\"ATTAVO_FEEDBACK\"] = str(feedback_path)\n            env[\"ATTAVO_ADAPTER_CONFIG\"] = json.dumps(adapter_config)\n            env[\"ATTAVO_STAGE\"] = \"build\"\n            env[\"ATTAVO_EVENTS\"] = str(events_path)\n            env[\"ATTAVO_TEST_COMMAND\"] = f\"python3 {PRODUCT_ROOT / 'bin' / 'attavo'} test {item_id}\"\n            if tests_cfg.get(\"call_timeout_s\"):\n                env[\"ATTAVO_TEST_TIMEOUT_S\"] = str(tests_cfg[\"call_timeout_s\"])\n            else:\n                env.pop(\"ATTAVO_TEST_TIMEOUT_S\", None)\n            env[\"GIT_AUTHOR_NAME\"] = identity[\"name\"]\n            env[\"GIT_AUTHOR_EMAIL\"] = identity[\"email\"]\n            env[\"GIT_COMMITTER_NAME\"] = identity[\"name\"]\n            env[\"GIT_COMMITTER_EMAIL\"] = identity[\"email\"]\n\n            run = subprocess.run([str(adapter_path)], cwd=str(root), env=env,\n                                 capture_output=True, text=True, check=False)\n            transcript, payload = split_adapter_stdout(run.stdout)\n            if run.returncode != 0:\n                # The guarantee behind issue #53's refusal: an adapter that\n                # exits non-zero always leaves a non-empty log, even one\n                # that printed nothing at all on stderr.\n                detail = f\"[adapter exited {run.returncode}]\"\n                if run.stderr.strip():\n                    detail += \"\\n\" + run.stderr.rstrip(\"\\n\")\n                transcript = (transcript + \"\\n\" if transcript else \"\") + detail\n            transcripts.append(transcript)\n\n            if run.returncode != 0 or payload is None or not payload.get(\"model\"):\n                status_out = \"failed\"\n                break\n\n            adapter_version = payload.get(\"adapter_version\")\n            model = payload.get(\"model\")\n            model_version = payload.get(\"model_version\")\n            tok = payload.get(\"tokens\") or {}\n            tokens[\"input\"] += tok.get(\"input\", 0) or 0\n            tokens[\"output\"] += tok.get(\"output\", 0) or 0\n            iter_cost = payload.get(\"cost_usd\")\n            if iter_cost is not None:\n                cost_usd = (cost_usd or 0) + iter_cost\n\n            if payload.get(\"status\") == \"question\":\n                status_out = \"halted\"\n                halted = {\"question\": payload.get(\"question\")}\n                break\n\n            foreign = next((c for c in commits_since(root, start_sha)\n                           if c[\"name\"] != identity[\"name\"] or c[\"email\"] != identity[\"email\"]),\n                          None)\n            if foreign:\n                status_out = \"refused\"\n                refusal = f\"commit {foreign['sha']} not authored by the executor\"\n                break\n\n            # An executor that committed nothing built nothing, whatever it\n            # left in the working tree: the gate below reads the commit, so\n            # an empty iteration fails its gate on the approved tree and is\n            # told why; an empty last iteration is halted, class empty\n            # (item 227: twelve stub files copied into the tree, no commit,\n            # a pass, a review, a seal, and no change on main).\n            committed_nothing = git(root, \"rev-parse\", \"HEAD\").strip() == start_sha\n            left_uncommitted = [\n                line for line in git(root, \"status\", \"--porcelain\", \"--untracked-files=all\").splitlines()\n                if line.strip() and not line[3:].startswith(records_rel.rstrip(\"/\") + \"/\")]\n            empty_line = (f\"no commit since {start_sha[:12]}; {len(left_uncommitted)} path(s) \"\n                          \"modified or untracked in the working tree, which the gate does not read\"\n                          if committed_nothing else None)\n\n            protected = protected_path_touched(root, start_sha, records_rel, specs_rel)\n            if protected:\n                status_out = \"refused\"\n                refusal = protected\n                refusal_provenance = \"executor\"\n                break\n\n            touched = sorted(changed_paths(root, start_sha, records_rel))\n            bad_path = next((p for p in touched if not matches_a_claim(p, claims)), None)\n            if bad_path:\n                status_out = \"refused\"\n                refusal = bad_path\n                break\n\n            # The gate reads the commit, never the executor's directory: a\n            # detached worktree of HEAD, so a file written and not committed\n            # cannot pass a criterion, a test or a check on the executor's\n            # behalf (item 227). Removed before the iteration ends.\n            with gate_checkout(root) as gate_root:\n                criteria_results = [\n                    {\"name\": name, \"exit\": run_criterion(spec_dir / \"criteria\" / name, gate_root)}\n                    for name in criteria_names]\n                for c in criteria_results:\n                    append_event(events_path, \"gate\", f\"{c['name']}: exit {c['exit']}\")\n\n                select_in = \"\".join(p + \"\\n\" for p in touched)\n                select_run = subprocess.run(tests_cfg[\"select\"], shell=True, cwd=str(gate_root),\n                                            input=select_in, capture_output=True,\n                                            text=True, check=False)\n                identifiers = [l for l in select_run.stdout.splitlines() if l.strip()]\n                run_in = \"\".join(i + \"\\n\" for i in identifiers)\n                test_run = subprocess.run(tests_cfg[\"run\"], shell=True, cwd=str(gate_root),\n                                          input=run_in, capture_output=True,\n                                          text=True, check=False)\n                selected_tests = {\"select\": tests_cfg[\"select\"], \"run\": tests_cfg[\"run\"],\n                                  \"count\": len(identifiers), \"exit\": test_run.returncode}\n\n                checks_run = None\n                if checks_command:\n                    checks_run = subprocess.run(checks_command, shell=True, cwd=str(gate_root),\n                                                capture_output=True, text=True, check=False)\n                    checks_result = {\"command\": checks_command, \"exit\": checks_run.returncode}\n\n            # Issue #89, rejection test 1: the gate output that decides pass\n            # or fail is appended to the build log itself, under a heading\n            # per iteration, before this temporary directory goes away --\n            # tenant zero's #576 build-11 and #659 build-01 are a failed\n            # record with nothing beside it to say what was red, because\n            # this output previously lived only in feedback.txt, in a\n            # tempfile.TemporaryDirectory() cmd_build deletes on return.\n            gate_lines = [f\"criterion {c['name']}: exit {c['exit']}\" for c in criteria_results]\n            gate_lines.append(f\"selected tests ({selected_tests['count']}): exit \"\n                              f\"{selected_tests['exit']}\")\n            if test_run.stdout.strip():\n                gate_lines += [\"--- selected tests stdout ---\", test_run.stdout.rstrip(\"\\n\")]\n            if test_run.stderr.strip():\n                gate_lines += [\"--- selected tests stderr ---\", test_run.stderr.rstrip(\"\\n\")]\n            if checks_run is not None:\n                tail = (checks_run.stdout.splitlines() + checks_run.stderr.splitlines())\n                tail = tail[-CHECKS_FEEDBACK_TAIL_LINES:]\n                gate_lines.append(f\"tenant checks: exit {checks_run.returncode}\")\n                gate_lines += [\"--- checks output (tail) ---\", *tail]\n            transcripts[-1] += (f\"\\n--- attavo gates, iteration {iteration} ---\\n\"\n                               + \"\\n\".join(gate_lines))\n\n            if empty_line:\n                transcripts[-1] += (\"\\nyou committed nothing: \" + empty_line +\n                                    \"\\ncommit your work; the gate reads the commit, not the tree\")\n\n            failing = [c for c in criteria_results if c[\"exit\"] != 0]\n            checks_ok = checks_run is None or checks_run.returncode == 0\n            if not failing and test_run.returncode == 0 and checks_ok and not committed_nothing:\n                status_out = \"pass\"\n                break\n\n            if iteration == BUILD_ITERATION_BUDGET:\n                if committed_nothing:\n                    status_out = \"halted\"\n                    halted = {\"question\": None}\n                    empty_detail = f\"the executor committed nothing; {empty_line}\"\n                else:\n                    status_out = \"failed\"\n                break\n\n            feedback_lines = []\n            if empty_line:\n                feedback_lines += [\"you committed nothing: \" + empty_line,\n                                   \"commit your work; the gate reads the commit, not the tree\"]\n            if failing:\n                feedback_lines.append(\"criteria failing:\")\n                feedback_lines += [f\"- {c['name']}: exit {c['exit']}\" for c in failing]\n            if test_run.returncode != 0:\n                feedback_lines += [f\"test run exit {test_run.returncode}\",\n                                   \"--- stdout ---\", test_run.stdout,\n                                   \"--- stderr ---\", test_run.stderr]\n            if checks_run is not None and checks_run.returncode != 0:\n                tail = (checks_run.stdout.splitlines() + checks_run.stderr.splitlines())\n                tail = tail[-CHECKS_FEEDBACK_TAIL_LINES:]\n                feedback_lines += [f\"checks exit {checks_run.returncode}\",\n                                   \"--- checks output (tail) ---\", *tail]\n            feedback_path.write_text(\"\\n\".join(feedback_lines) + \"\\n\")\n\n    record = {\n        \"sha\": git(root, \"rev-parse\", \"HEAD\").strip(),\n        \"start_sha\": start_sha,\n        \"spec_sha\": spec_sha,\n        \"approval_sha\": latest_approval.get(\"sha\") if latest_approval else None,\n        \"at\": now_iso(),\n        \"adapter\": adapter_name,\n        \"adapter_config\": adapter_config,\n        \"executor_identity\": identity,\n        \"reports\": reports,\n        \"adapter_version\": adapter_version,\n        \"model\": model,\n        \"model_version\": model_version,\n        \"iterations\": iterations_used,\n        \"criteria\": criteria_results,\n        \"selected_tests\": selected_tests,\n        \"checks\": checks_result,\n        \"tokens\": tokens,\n        \"cost_usd\": cost_usd,\n        \"wall_clock_s\": round(time.monotonic() - started, 3),\n        \"status\": status_out,\n        \"refusal\": refusal,\n        \"halted\": halted,\n        \"retry_of\": retry_of,\n        \"steer\": steer,\n        \"stop\": derive_stop(status_out, refusal=refusal, halted=halted,\n                            log=\"\\n\".join(transcripts),\n                            report_class=\"empty\" if empty_detail else (payload or {}).get(\"class\"),\n                            refusal_provenance=refusal_provenance),\n    }\n    if record[\"stop\"] is not None and empty_detail:\n        record[\"stop\"] = {**record[\"stop\"], \"detail\": empty_detail}\n    if record[\"stop\"] is not None:\n        stop_out: dict[str, Any] = record[\"stop\"]\n        # R3: transient's own signature is the adapter's stop detail\n        # (payload.get(\"detail\")), not derive_stop's detail (which is\n        # None for every class but unclassed/question/environment/gate);\n        # every other non-pass class signs off its own detail (None for\n        # most, so signature is None too -- the class alone, or the log\n        # itself for unclassed, is the specimen's own cause).\n        stop_detail: str | None = ((payload or {}).get(\"detail\") if stop_out[\"class\"] == \"transient\"\n                                   else stop_out.get(\"detail\"))\n        record[\"stop\"] = {**stop_out, \"detail\": stop_detail, \"signature\": signature_of(stop_detail),\n                          \"bound\": None}\n    record_path = write_record(item_records_dir, \"build\", record, m, item_id,\n                               log=\"\\n\".join(transcripts))\n\n    print(f\"attavo build: {status_out} ({record_path.name})\")\n    if status_out == \"halted\":\n        return BUILD_HALT_EXIT\n    return 0 if status_out == \"pass\" else 1\n","numLines":695,"startLine":1,"totalLines":695}}}

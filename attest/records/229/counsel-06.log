{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc \"sed -n '130,360p' /Users/davidbean/Projects/attest/attavo/doctor.py; sed -n '1,240p' .attavo/bin/select-tests; rg -n \\\"own_records|no_invocation|deselect\\\" tests/test_own_records_guard.py .github/workflows/ci.yml attavo.toml; rg -n \\\"def gate_checkout|gate_checkout|TemporaryDirectory\\\" attavo/build.py | head -40; git show 62bb4144:attavo/build.py | rg -n \\\"gate_checkout|selected_tests|test_run\\\"\"","aggregated_output":"    merges, when given, is _merges_reachable's own result -- ledger's\n    cmd_ledger computes it once and passes it to every item rather than\n    walking the default branch's merges again for each (issue #153); a\n    caller that already has merges has also already handled\n    _merges_reachable's refusal, so this never re-derives one. Left\n    None, a caller with just the one item to ask (doctor's proof two)\n    gets merges computed here, refusal and all.\"\"\"\n    if merges is None:\n        merges, refusal = _merges_reachable(root)\n        if refusal:\n            return None, refusal\n    prefix = f\"{records_rel.rstrip('/')}/{item}/\"\n    for merge in merges:\n        found: set[str] = set()\n        for p in merge[\"touched\"]:\n            if p.startswith(prefix):\n                m = RECORD_RE.match(Path(p).name)\n                if m:\n                    found.add(m.group(1))\n        if all(s in found for s in stages):\n            return merge[\"sha\"], None\n    return None, None\n\n\nINVOCATION_MARKER_SUFFIX = \".started\"\n\n\ndef invocation_marker_path(records_dir: Path, stage: str, nn: int) -> Path:\n    return records_dir / f\"{stage}-{nn:02d}{INVOCATION_MARKER_SUFFIX}\"\n\n\ndef write_invocation_marker(root: Path, records_dir: Path, stage: str, nn: int,\n                            again_by: bool = False) -> Path:\n    \"\"\"The fact that an invocation began, written before it does: at,\n    host, pid, the sha it starts on, and the product that started it.\n    Its record's arrival is what retires it; a marker with no record is\n    an invocation that died or hangs, and proof five names it. R3:\n    again_by is true only on a marker `--again` wrote to reset a stage\n    whose budget was spent (or whose last two signatures matched) --\n    absent on every ordinary marker, never a bare false.\"\"\"\n    import os\n    import socket\n    from datetime import datetime, timezone\n    records_dir.mkdir(parents=True, exist_ok=True)\n    path = invocation_marker_path(records_dir, stage, nn)\n    sha = git(root, \"rev-parse\", \"HEAD\").strip()\n    info: dict[str, Any] = {\"at\": datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\"),\n                            \"host\": socket.gethostname(), \"pid\": os.getpid(), \"sha\": sha,\n                            \"product_version\": product_version()}\n    if again_by:\n        info[\"again_by\"] = True\n    path.write_text(json.dumps(info, indent=2) + \"\\n\")\n    return path\n\n\ndef invocation_alive(info: dict[str, Any]) -> bool:\n    \"\"\"Whether the marker's pid is a live process on this host. Another\n    host's pid is unknowable from here and reads as not alive: a drive\n    that ran elsewhere and wrote no record is died by absence.\"\"\"\n    import os\n    import socket\n    if info.get(\"host\") != socket.gethostname():\n        return False\n    pid = info.get(\"pid\")\n    if not isinstance(pid, int) or isinstance(pid, bool) or pid <= 0:\n        return False\n    try:\n        os.kill(pid, 0)\n    except ProcessLookupError:\n        return False\n    except PermissionError:\n        return True\n    return True\n\n\ndef invocation_age_s(info: dict[str, Any]) -> float | None:\n    \"\"\"Seconds since the marker's own `at` timestamp -- how long ago the\n    invocation it names began, whatever host wrote it. None when `at` is\n    missing or does not parse.\"\"\"\n    from datetime import datetime, timezone\n    at = info.get(\"at\")\n    if not isinstance(at, str):\n        return None\n    try:\n        stamp = datetime.strptime(at, \"%Y-%m-%dT%H:%M:%SZ\").replace(tzinfo=timezone.utc)\n    except ValueError:\n        return None\n    return (datetime.now(timezone.utc) - stamp).total_seconds()\n\n\ndef invocations_without_record(item_records_dir: Path) -> list[tuple[Path, dict[str, Any]]]:\n    \"\"\"Every <stage>-NN.started under one item whose <stage>-NN.json has\n    not arrived, with the marker's own dict ({} when unreadable).\"\"\"\n    out: list[tuple[Path, dict[str, Any]]] = []\n    if not item_records_dir.is_dir():\n        return out\n    for marker in sorted(item_records_dir.glob(f\"*{INVOCATION_MARKER_SUFFIX}\")):\n        if (item_records_dir / f\"{marker.stem}.json\").is_file():\n            continue\n        try:\n            with marker.open() as fh:\n                info = json.load(fh)\n        except (OSError, ValueError):\n            info = {}\n        out.append((marker, info if isinstance(info, dict) else {}))\n    return out\n\n\ndef stall_bound_s(m: dict[str, Any]) -> int | None:\n    \"\"\"[drive].stall_after_s: the tenant's own bound past which a live\n    invocation with no new event is hung. A bound the tenant did not\n    write is a forecast, so there is no default.\"\"\"\n    bound = (m.get(\"drive\") or {}).get(\"stall_after_s\")\n    if isinstance(bound, bool) or not isinstance(bound, (int, float)) or bound <= 0:\n        return None\n    return int(bound)\n\n\ndef ceiling_s(m: dict[str, Any], stage: str) -> int | None:\n    \"\"\"R3: [drive.<stage>].ceiling_s, the wall clock past which a live\n    invocation of that stage is hung by its ceiling, whatever event age\n    says (or does not say, for an adapter that streams none). No\n    default: a ceiling the tenant did not declare is not assumed.\"\"\"\n    value = ((m.get(\"drive\") or {}).get(stage) or {}).get(\"ceiling_s\")\n    if isinstance(value, bool) or not isinstance(value, (int, float)) or value <= 0:\n        return None\n    return int(value)\n\n\ndef attempts_budget(m: dict[str, Any]) -> int:\n    \"\"\"R3: [drive].attempts, the attempts a stage may spend -- across a\n    plain retry, a returned retry, and a steered one alike -- before the\n    item is a person's; 3 when the manifest does not say.\"\"\"\n    value = (m.get(\"drive\") or {}).get(\"attempts\")\n    if isinstance(value, bool) or not isinstance(value, int) or value < 1:\n        return 3\n    return value\n\n\ndef retry_after_s(m: dict[str, Any]) -> int:\n    \"\"\"R3: [drive].retry_after_s, the wait a transient stop's record sits\n    through before its next attempt starts; 300 when the manifest does\n    not say.\"\"\"\n    value = (m.get(\"drive\") or {}).get(\"retry_after_s\")\n    if isinstance(value, bool) or not isinstance(value, (int, float)) or value < 0:\n        return 300\n    return int(value)\n\n\ndef proof_no_invocation_lacks_record(root: Path, m: dict[str, Any] | None) -> Proof:\n    import socket\n    p = Proof(\"no-invocation-lacks-record\", \"no invocation lacks its record\")\n    if m is None:\n        return p.fail(f\"no {MANIFEST} at {root}; no records directory is declared\")\n    records_rel = m.get(\"paths\", {}).get(\"records\", \"\")\n    records_dir = root / records_rel\n    if not records_dir.is_dir():\n        return p.fail(f\"no records directory under {records_dir}\")\n    bound = stall_bound_s(m)\n    if bound is None:\n        return p.fail(\"no [drive].stall_after_s in the manifest; a hung invocation cannot be \"\n                      \"told from a running one\")\n    # R3: a stage with no ceiling can run forever unjudged even when\n    # stall_after_s is set (an adapter that streams no events trips no\n    # stall bound at all) -- refused the same way stall_after_s's own\n    # absence is, not folded into it, so the reason names exactly which\n    # keys the manifest is missing.\n    missing_ceilings = [f\"[drive.{stage}].ceiling_s\" for stage in (\"build\", \"verify\")\n                        if ceiling_s(m, stage) is None]\n    if missing_ceilings:\n        return p.fail(f\"no {' or '.join(missing_ceilings)} in the manifest; a stage with no \"\n                      f\"ceiling can run forever unjudged (R3)\")\n    if (m.get(\"drive\") or {}).get(\"attempts\") is None:\n        return p.fail(\"no [drive].attempts in the manifest; a retryable stop would spend an \"\n                      \"unbounded number of attempts (R3)\")\n    this_host = socket.gethostname()\n    recorded = 0\n    running: list[str] = []\n    in_flight: list[str] = []\n    problems: list[str] = []\n    for item_dir in sorted(d for d in records_dir.iterdir() if d.is_dir()):\n        for marker in item_dir.glob(f\"*{INVOCATION_MARKER_SUFFIX}\"):\n            if (item_dir / f\"{marker.stem}.json\").is_file():\n                recorded += 1\n        for marker, info in invocations_without_record(item_dir):\n            name = f\"item {item_dir.name} {marker.stem}\"\n            if invocation_alive(info):\n                running.append(f\"{name} (pid {info.get('pid')} since {info.get('at')})\")\n                continue\n            # A marker from another host is not alive by invocation_alive's\n            # own reckoning (its pid is unknowable from here) but is not\n            # yet a failure either: an invocation younger than the tenant's\n            # own stall bound may simply be running elsewhere, still\n            # writing toward its own record.\n            if info.get(\"host\") != this_host:\n                age = invocation_age_s(info)\n                if age is not None and age < bound:\n                    in_flight.append(f\"{name} (host {info.get('host')} since {info.get('at')})\")\n                    continue\n            problems.append(f\"{name} started {info.get('at')} on {info.get('host')} \"\n                            f\"pid {info.get('pid')} and never wrote its record\")\n    if problems:\n        return p.fail(\"; \".join(problems), unrecorded_invocations=len(problems),\n                      running_invocations=running, in_flight=in_flight)\n    return p.hold(f\"{recorded} invocation(s) recorded, {len(running)} running, \"\n                  f\"{len(in_flight)} in flight elsewhere\",\n                  unrecorded_invocations=0, running_invocations=running, in_flight=in_flight)\n\n\ndef proof_one_item_every_stage(root: Path, m: dict[str, Any] | None) -> Proof:\n    p = Proof(\"one-item-every-stage\", \"one item has traversed every stage\")\n    if m is None:\n        return p.fail(f\"no {MANIFEST} at {root}; no records directory is declared\")\n    records_rel = m.get(\"paths\", {}).get(\"records\", \"\")\n    records_dir = root / records_rel\n    items = load_records(records_dir)\n    if not items:\n        return p.fail(f\"no work item under {records_dir.relative_to(root)}\")\n    complete = [item for item, stages in items.items() if all(s in stages for s in STAGES)]\n    if not complete:\n        best = max(items.items(), key=lambda kv: len(kv[1]))\n        lacking = [s for s in STAGES if s not in best[1]]\n        return p.fail(f\"no item carries every stage; item {best[0]} lacks {', '.join(lacking)}\")\n\n    # issue #74: a complete item is counted only when its chain holds --\n    # attavo attest refuses a build re-approved after the fact or a\n    # verify whose build went stale, and the coherence gate refuses the\n    # merge group on exactly that; a proof that never asked would call a\n    # traversal the gate itself would not let through. The refusal text\n    # is check_attest_chain's own, never re-typed here.\n    refused, held, unmerged = [], [], []\n#!/usr/bin/env python3\n\"\"\"select-tests: [tests].select for attavo build/verify/test (issue #103,\nmade fail-safe by issue #212).\n\nReads changed paths on stdin, one per line, and prints test identifiers\non stdout, one per line, for this repository's own test suite:\n\n  - prose (*.md, LICENSE) and this repository's own specs and records\n    (attest/specs/**, attest/records/**) select nothing;\n  - a test file (tests/test_*.py) selects itself, and the whole suite\n    when it no longer exists -- a deletion cannot select itself, and the\n    fail-safe rule below applies to it rather than exempting it (issue\n    #212's review);\n  - a path in MODULE_TESTS (a module of attavo/, and the few files that\n    are one thing's own) selects the tests written for it, and a prefix in\n    PREFIX_TESTS (adapters/, schema/, templates/) the tests written for\n    that directory;\n  - a path this selector does not know -- a module nobody mapped,\n    bin/attavo, scripts/, tests/helpers.py and the fixtures every test\n    stands on, the fixture adapter every build test invokes -- selects the\n    whole suite (\"tests\", the one path pytest needs to run everything),\n    and one such path is enough to make that the whole answer.\n\nA module that most of the others import (common, records, spec, ...) is\nleft out of MODULE_TESTS on purpose: no table of tests-per-module can know\nwhat it breaks, so it is the whole suite. The forge runs the whole suite\nonce, as the required `test` check, in any case.\n\nUsage: <changed paths> | select-tests\n\"\"\"\nfrom __future__ import annotations\n\nimport sys\nfrom pathlib import Path\n\nWHOLE_SUITE = \"tests\"\n\nSILENT_PREFIXES = (\"attest/specs/\", \"attest/records/\")\n\nWHOLE_SUITE_PREFIXES = (\"adapters/fixture/\",)\n\nMODULE_TESTS: dict[str, tuple[str, ...]] = {\n    \"attavo/attest.py\": (\"tests/test_attest.py\", \"tests/test_attest_time.py\"),\n    \"attavo/build.py\": (\"tests/test_build.py\", \"tests/test_testtool.py\"),\n    \"attavo/cli.py\": (\"tests/test_cli_help.py\", \"tests/test_testtool.py\"),\n    \"attavo/counsel.py\": (\"tests/test_counsel.py\",),\n    \"attavo/doctor.py\": (\"tests/test_doctor.py\", \"tests/test_doctor_sealed.py\",\n                         \"tests/test_proof_five_elsewhere.py\",\n                         \"tests/test_sealed_since_default.py\"),\n    \"attavo/drive.py\": (\"tests/test_drive.py\",),\n    \"attavo/filing.py\": (\"tests/test_file_findings.py\", \"tests/test_file_stops.py\"),\n    \"attavo/ledger.py\": (\"tests/test_ledger.py\",),\n    \"attavo/record_only.py\": (\"tests/test_record_only.py\",),\n    \"attavo/report.py\": (\"tests/test_report.py\",),\n    \"attavo/testtool.py\": (\"tests/test_testtool.py\",),\n    \"attavo/types.py\": (\"tests/test_types_mirror_schemas.py\",),\n    \"attavo/verify.py\": (\"tests/test_verify.py\", \"tests/test_verify_polls.py\",\n                         \"tests/test_verify_codex_proof.py\"),\n    \"action.yml\": (\"tests/test_action_yml.py\",),\n    \"attavo.toml\": (\"tests/test_self_tenancy.py\", \"tests/test_testtool.py\"),\n    \"schema/manifest.schema.json\": (\"tests/test_self_tenancy.py\", \"tests/test_record_schemas.py\",\n                                    \"tests/test_testtool.py\"),\n    \".attavo/bin/select-tests\": (\"tests/test_self_tenancy.py\", \"tests/test_testtool.py\"),\n}\n\n# The modules most of the others import: no table of tests-per-module can\n# know what a change to one of these breaks, so each selects the whole\n# suite, and each is named here so that a new module under attavo/ must be\n# placed -- in MODULE_TESTS or in this tuple -- before the suite accepts it\n# (tests/test_testtool.py).\nSHARED_MODULES: tuple[str, ...] = (\n    \"attavo/__init__.py\", \"attavo/approval.py\", \"attavo/common.py\", \"attavo/events.py\",\n    \"attavo/records.py\", \"attavo/spec.py\", \"attavo/stops.py\",\n)\n\nPREFIX_TESTS: tuple[tuple[str, tuple[str, ...]], ...] = (\n    (\"adapters/claude-code/\", (\"tests/test_adapters.py\", \"tests/test_adapter_claude_code.py\",\n                               \"tests/test_executor_conformance.py\")),\n    (\"adapters/codex/\", (\"tests/test_adapter_codex.py\", \"tests/test_adapters_codex.py\",\n                         \"tests/test_executor_conformance.py\")),\n    (\"adapters/\", (\"tests/test_adapters.py\", \"tests/test_executor_conformance.py\")),\n    (\"schema/\", (\"tests/test_record_schemas.py\", \"tests/test_attest.py\",\n                 \"tests/test_types_mirror_schemas.py\")),\n    (\"templates/\", (\"tests/test_approve_template.py\", \"tests/test_coherence_template.py\",\n                    \"tests/test_spec_gate_template.py\", \"tests/test_template_app_identity.py\",\n                    \"tests/test_templates_carry_no_repository_urls.py\",\n                    \"tests/test_self_tenancy.py\")),\n)\n\n\ndef repository_root() -> Path:\n    return Path(__file__).resolve().parent.parent.parent\n\n\ndef is_prose_or_record(path: str) -> bool:\n    return path.endswith(\".md\") or path == \"LICENSE\" or path.startswith(SILENT_PREFIXES)\n\n\ndef select_one(path: str) -> tuple[str, ...] | None:\n    \"\"\"The tests for one changed path, () for none, None for a path this\n    selector does not know.\"\"\"\n    if is_prose_or_record(path):\n        return ()\n    if path.startswith(WHOLE_SUITE_PREFIXES):\n        return None\n    if path.startswith(\"tests/test_\") and path.endswith(\".py\") and \"/\" not in path[len(\"tests/\"):]:\n        # A deleted test file cannot select itself, and the gate must not\n        # pass a deletion unexamined (issue #212's review): fail safe to\n        # the whole suite rather than the () a present file's own removal\n        # would otherwise fall through to.\n        return (path,) if (repository_root() / path).is_file() else None\n    if path in MODULE_TESTS:\n        return MODULE_TESTS[path]\n    for prefix, tests in PREFIX_TESTS:\n        if path.startswith(prefix):\n            return tests\n    return None\n\n\ndef select(paths: list[str]) -> list[str]:\n    tests: dict[str, None] = {}\n    for path in paths:\n        found = select_one(path)\n        if found is None:\n            return [WHOLE_SUITE]\n        tests.update(dict.fromkeys(found))\n    return list(tests)\n\n\ndef main() -> int:\n    changed = [line.strip() for line in sys.stdin.read().splitlines() if line.strip()]\n    for t in select(changed):\n        print(t)\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\nattavo.toml:40:run = \"xargs -r python3 -m pytest -q --deselect tests/test_doctor.py::test_every_gate_rejects --deselect tests/test_doctor.py::test_one_item_traversed_every_stage --deselect tests/test_doctor.py::test_no_commit_lacks_a_record --deselect tests/test_doctor.py::test_no_stop_lacks_cause --deselect tests/test_doctor.py::test_every_attested_item_is_sealed --deselect tests/test_doctor.py::test_no_attested_item_is_empty\"\n.github/workflows/ci.yml:16:  # records (@pytest.mark.own_records) still run. scripts/ci_inherit.py\n.github/workflows/ci.yml:43:        run: python3 -m pytest tests -q -m own_records\n.github/workflows/ci.yml:55:          --deselect tests/test_doctor.py::test_every_gate_rejects\n.github/workflows/ci.yml:56:          --deselect tests/test_doctor.py::test_one_item_traversed_every_stage\n.github/workflows/ci.yml:57:          --deselect tests/test_doctor.py::test_no_commit_lacks_a_record\n.github/workflows/ci.yml:58:          --deselect tests/test_doctor.py::test_no_stop_lacks_cause\n.github/workflows/ci.yml:59:          --deselect tests/test_doctor.py::test_every_attested_item_is_sealed\n.github/workflows/ci.yml:60:          --deselect tests/test_doctor.py::test_no_attested_item_is_empty\ntests/test_own_records_guard.py:4:marked @pytest.mark.own_records and are the only ones `test` runs on the\ntests/test_own_records_guard.py:8:`test` job deselects are exempt: they never run in `test`, they run for\ntests/test_own_records_guard.py:31:MARK = \"pytest.mark.own_records\"\ntests/test_own_records_guard.py:32:DESELECT = re.compile(r\"--deselect\\s+tests/(test_\\w+\\.py::test_\\w+)\")\ntests/test_own_records_guard.py:45:def deselected_by_the_test_job() -> frozenset[str]:\ntests/test_own_records_guard.py:46:    \"\"\"`file::test` for each test ci.yml's `test` job deselects.\"\"\"\ntests/test_own_records_guard.py:55:def unmarked_own_records_readers(tests_dir: Path, skip: str,\ntests/test_own_records_guard.py:84:def test_the_test_job_deselects_the_doctor_tests_the_doctor_job_runs() -> None:\ntests/test_own_records_guard.py:85:    assert len(deselected_by_the_test_job()) == 6, deselected_by_the_test_job()\ntests/test_own_records_guard.py:88:def test_no_unmarked_test_reads_this_repositorys_own_records() -> None:\ntests/test_own_records_guard.py:89:    assert unmarked_own_records_readers(\ntests/test_own_records_guard.py:90:        TESTS, skip=Path(__file__).name, exempt=deselected_by_the_test_job()) == []\ntests/test_own_records_guard.py:105:        f\"import pytest\\n\\n\\n@pytest.mark.own_records\\ndef test_reads() -> None:\\n    {reader}\\n\")\ntests/test_own_records_guard.py:107:        f\"import pytest\\n\\npytestmark = pytest.mark.own_records\\n\\n\\ndef test_reads() -> None:\\n    {reader}\\n\")\ntests/test_own_records_guard.py:108:    assert unmarked_own_records_readers(tmp_path, skip=\"\") == [\"test_planted.py::test_reads\"]\ntests/test_own_records_guard.py:114:    assert unmarked_own_records_readers(tmp_path, skip=\"\") == []\n311:def gate_checkout(root: Path) -> Iterator[Path]:\n484:    with tempfile.TemporaryDirectory() as tmp:\n605:            with gate_checkout(root) as gate_root:\n636:            # tempfile.TemporaryDirectory() cmd_build deletes on return.\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-85BnG59M' (errno=Operation not permitted)\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-Fqo7qp2p' (errno=Operation not permitted)\n311:def gate_checkout(root: Path) -> Iterator[Path]:\n447:                \"selected_tests\": None,\n475:    selected_tests: dict[str, Any] | None = None\n605:            with gate_checkout(root) as gate_root:\n618:                test_run = subprocess.run(tests_cfg[\"run\"], shell=True, cwd=str(gate_root),\n621:                selected_tests = {\"select\": tests_cfg[\"select\"], \"run\": tests_cfg[\"run\"],\n622:                                  \"count\": len(identifiers), \"exit\": test_run.returncode}\n638:            gate_lines.append(f\"selected tests ({selected_tests['count']}): exit \"\n639:                              f\"{selected_tests['exit']}\")\n640:            if test_run.stdout.strip():\n641:                gate_lines += [\"--- selected tests stdout ---\", test_run.stdout.rstrip(\"\\n\")]\n642:            if test_run.stderr.strip():\n643:                gate_lines += [\"--- selected tests stderr ---\", test_run.stderr.rstrip(\"\\n\")]\n658:            if not failing and test_run.returncode == 0 and checks_ok and not build_empty:\n682:            if test_run.returncode != 0:\n683:                feedback_lines += [f\"test run exit {test_run.returncode}\",\n684:                                   \"--- stdout ---\", test_run.stdout,\n685:                                   \"--- stderr ---\", test_run.stderr]\n708:        \"selected_tests\": selected_tests,\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,75p' .github/workflows/ci.yml; sed -n '1,120p' tests/test_own_records_guard.py; sed -n '290,335p' attavo/build.py; sed -n '590,630p' attavo/build.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,75p' .github/workflows/ci.yml; sed -n '1,120p' tests/test_own_records_guard.py; sed -n '290,335p' attavo/build.py; sed -n '590,630p' attavo/build.py\"","aggregated_output":"name: CI\n\n# issue #210: push runs on main only. An item's branch always has an open\n# pull request, so every branch push was a second run of what pull_request\n# already ran. A branch with no pull request gets no CI.\non:\n  push:\n    branches: [main]\n  pull_request:\n  merge_group:\n\njobs:\n  # issue #210: on a pull request, a head whose commits since a green run\n  # touch only the records directory inherits that run's `test` instead of\n  # running the suite again; the tests that read the repository's own\n  # records (@pytest.mark.own_records) still run. scripts/ci_inherit.py\n  # decides, and every doubt (no concluded success to inherit, an API read\n  # that fails, a shallow clone, a merge commit) is run-in-full. merge_group\n  # never reaches the script: the queue's run is the law and is never\n  # inherited. The inherit step's output is 'true' only when the script\n  # says so; anything else, including the step not running, runs the suite.\n  test:\n    runs-on: ubuntu-latest\n    permissions:\n      contents: read\n      checks: read\n    steps:\n      - uses: actions/checkout@v4\n        with:\n          fetch-depth: 0\n      - uses: actions/setup-python@v5\n        with:\n          python-version: \"3.11\"\n      - name: inherit test from a records-only head\n        id: inherit\n        if: github.event_name == 'pull_request'\n        run: python3 scripts/ci_inherit.py test\n        env:\n          GH_TOKEN: ${{ github.token }}\n      - run: pip install pytest jsonschema\n      - name: pytest, only the tests that read this repository's own records\n        if: steps.inherit.outputs.inherit == 'true'\n        run: python3 -m pytest tests -q -m own_records\n      # issue #181: the suite's own clock is bounded. --durations=5 puts the\n      # five slowest tests on every run's log; the last step fails the job\n      # when the pytest step took more than 180 s (the suite's baseline is\n      # about 65 s), naming the elapsed seconds.\n      - name: pytest start\n        if: steps.inherit.outputs.inherit != 'true'\n        run: echo \"PYTEST_START=$(date +%s)\" >> \"$GITHUB_ENV\"\n      - name: pytest\n        if: steps.inherit.outputs.inherit != 'true'\n        run: >\n          python3 -m pytest tests -q --durations=5\n          --deselect tests/test_doctor.py::test_every_gate_rejects\n          --deselect tests/test_doctor.py::test_one_item_traversed_every_stage\n          --deselect tests/test_doctor.py::test_no_commit_lacks_a_record\n          --deselect tests/test_doctor.py::test_no_stop_lacks_cause\n          --deselect tests/test_doctor.py::test_every_attested_item_is_sealed\n          --deselect tests/test_doctor.py::test_no_attested_item_is_empty\n      - name: pytest end\n        if: steps.inherit.outputs.inherit != 'true'\n        run: echo \"PYTEST_END=$(date +%s)\" >> \"$GITHUB_ENV\"\n      - name: the suite's wall clock is at most 180 s\n        if: steps.inherit.outputs.inherit != 'true'\n        run: |\n          elapsed=$((PYTEST_END - PYTEST_START))\n          echo \"pytest step took ${elapsed} s\"\n          if [ \"$elapsed\" -gt 180 ]; then\n            echo \"::error::the pytest step took ${elapsed} s, over the 180 s bound\"\n            exit 1\n          fi\n\n  # issue #189: mypy --strict over attavo/, bin/attavo, and tests/\n  # (pyproject.toml's [tool.mypy] names the files and the interpreter; pytest\n\"\"\"Issue #210: `test` inherits a records-only commit's result only because\nno test in the ordinary suite reads this repository's own records\ndirectory, the one thing such a commit changes. The tests that do are\nmarked @pytest.mark.own_records and are the only ones `test` runs on the\ninherit path. This guard is what keeps that list true: an unmarked test\nthat names this repository as the tenant a product reader is pointed at,\nor joins ROOT to the records directory, fails here. The doctor tests the\n`test` job deselects are exempt: they never run in `test`, they run for\nreal in the `doctor` job, which does not inherit.\n\nThe guard reads test source for the vocabulary by which a test in this\nsuite reaches the repository's own tree (ROOT handed to a product reader,\nROOT joined to \"attest\" or to the manifest's paths). It cannot follow a\nhelper that hides ROOT; a new way of reaching the records adds a pattern\nhere. The property behind the list was also checked directly when this\nguard was written: the suite run on a copy of the repository with\nattest/records removed, unmarked tests only, passed.\n\nRun: python3 -m pytest tests -q\n\"\"\"\nfrom __future__ import annotations\n\nimport ast\nimport re\nfrom pathlib import Path\n\nimport pytest\n\nTESTS = Path(__file__).resolve().parent\nCI_YML = TESTS.parent / \".github\" / \"workflows\" / \"ci.yml\"\nMARK = \"pytest.mark.own_records\"\nDESELECT = re.compile(r\"--deselect\\s+tests/(test_\\w+\\.py::test_\\w+)\")\nREADERS = (\n    re.compile(r\"\\b(?:run_doctor|drive_report|read_manifest|run_attavo)\\(\\s*ROOT\\b\"),\n    re.compile(r\"\\bROOT\\s*/\\s*[\\\"']attest[\\\"']\"),\n    re.compile(r\"\\bROOT\\b[^\\n]*\\bpaths\\b\"),\n)\n\n\ndef _is_marked(node: ast.AST) -> bool:\n    decorators = getattr(node, \"decorator_list\", [])\n    return any(ast.unparse(d) == MARK for d in decorators)\n\n\ndef deselected_by_the_test_job() -> frozenset[str]:\n    \"\"\"`file::test` for each test ci.yml's `test` job deselects.\"\"\"\n    lines = CI_YML.read_text().splitlines()\n    start = lines.index(\"  test:\")\n    end = next((i for i in range(start + 1, len(lines))\n                if lines[i].startswith(\"  \") and not lines[i].startswith(\"    \")\n                and lines[i].strip().endswith(\":\") and lines[i].strip() != \"test:\"), len(lines))\n    return frozenset(DESELECT.findall(\"\\n\".join(lines[start:end])))\n\n\ndef unmarked_own_records_readers(tests_dir: Path, skip: str,\n                                 exempt: frozenset[str] = frozenset()) -> list[str]:\n    \"\"\"`file::test` for every test in tests_dir that reads the repository's\n    own records without the marker. `skip` is a file name not scanned: this\n    file states the patterns as strings and would name itself. `exempt`\n    names tests, as `file::test`, that never run where the marker matters.\"\"\"\n    found: list[str] = []\n    for path in sorted(tests_dir.glob(\"test_*.py\")):\n        if path.name == skip:\n            continue\n        source = path.read_text()\n        tree = ast.parse(source)\n        if MARK in source and any(\n                isinstance(n, ast.Assign) and any(isinstance(t, ast.Name) and t.id == \"pytestmark\"\n                                                  for t in n.targets) and MARK in ast.unparse(n.value)\n                for n in tree.body):\n            continue\n        for node in ast.walk(tree):\n            if not isinstance(node, ast.FunctionDef) or not node.name.startswith(\"test_\"):\n                continue\n            if _is_marked(node):\n                continue\n            body = ast.get_source_segment(source, node) or \"\"\n            name = f\"{path.name}::{node.name}\"\n            if name not in exempt and any(pattern.search(body) for pattern in READERS):\n                found.append(name)\n    return found\n\n\ndef test_the_test_job_deselects_the_doctor_tests_the_doctor_job_runs() -> None:\n    assert len(deselected_by_the_test_job()) == 6, deselected_by_the_test_job()\n\n\ndef test_no_unmarked_test_reads_this_repositorys_own_records() -> None:\n    assert unmarked_own_records_readers(\n        TESTS, skip=Path(__file__).name, exempt=deselected_by_the_test_job()) == []\n\n\n@pytest.mark.parametrize(\"reader\", [\n    \"run_doctor(ROOT)\",\n    \"drive_report(ROOT, m, item)\",\n    \"read_manifest(ROOT)\",\n    \"run_attavo(ROOT, 'report')\",\n    \"list((ROOT / 'attest').rglob('*.json'))\",\n    \"sorted((ROOT / m['paths']['records']).iterdir())\",\n])\ndef test_the_guard_names_a_planted_reader_and_not_a_marked_one(tmp_path: Path, reader: str) -> None:\n    (tmp_path / \"test_planted.py\").write_text(\n        f\"def test_reads() -> None:\\n    {reader}\\n\")\n    (tmp_path / \"test_marked.py\").write_text(\n        f\"import pytest\\n\\n\\n@pytest.mark.own_records\\ndef test_reads() -> None:\\n    {reader}\\n\")\n    (tmp_path / \"test_module_marked.py\").write_text(\n        f\"import pytest\\n\\npytestmark = pytest.mark.own_records\\n\\n\\ndef test_reads() -> None:\\n    {reader}\\n\")\n    assert unmarked_own_records_readers(tmp_path, skip=\"\") == [\"test_planted.py::test_reads\"]\n\n\ndef test_the_guard_leaves_a_test_that_builds_its_own_tenant_alone(tmp_path: Path) -> None:\n    (tmp_path / \"test_own.py\").write_text(\n        \"def test_builds(tmp_path):\\n    root = make_tenant(tmp_path, 'valid')\\n    run_doctor(root)\\n\")\n    assert unmarked_own_records_readers(tmp_path, skip=\"\") == []\n                lines += [f\"--- check {c['name']} {c['conclusion']} ---\",\n                         run.stdout.strip(), \"\"]\n\n    steer_stem: str | None = None\n    if counsel_n:\n        target = f\"{counsel_stage}-{counsel_n:02d}\"\n        counsel_attempts = parse_attempts(records_dir, \"counsel\")\n        matches = [(n, rec) for n, rec in sorted(counsel_attempts.items())\n                  if rec.get(\"record\") == target]\n        if matches:\n            nn, counsel = matches[-1]\n            if counsel.get(\"verdict\") == \"answer\":\n                steer_stem = f\"counsel-{nn:02d}\"\n                answer = (counsel.get(\"proposal\") or {}).get(\"ruling_text\")\n                if answer:\n                    lines += [f\"steer from {steer_stem}:\", answer.strip(), \"\"]\n\n    return prior_stem, steer_stem, \"\\n\".join(lines) + \"\\n\"\n\n\n@contextlib.contextmanager\ndef gate_checkout(root: Path) -> Iterator[Path]:\n    \"\"\"A detached worktree of root's HEAD, removed on exit: the tree the\n    build's gate reads. The executor's own directory is not it -- a file\n    written there and never committed is not part of the change, and a\n    gate that read it would pass work that does not exist on the branch\n    (item 227).\"\"\"\n    parent = Path(tempfile.mkdtemp(prefix=\"attavo-gate-\"))\n    tree = parent / \"head\"\n    git(root, \"worktree\", \"add\", \"--detach\", \"-q\", str(tree), \"HEAD\")\n    try:\n        yield tree\n    finally:\n        try:\n            git(root, \"worktree\", \"remove\", \"--force\", str(tree))\n        except RuntimeError:\n            shutil.rmtree(tree, ignore_errors=True)\n            try:\n                git(root, \"worktree\", \"prune\")\n            except RuntimeError:\n                pass\n        shutil.rmtree(parent, ignore_errors=True)\n\n\ndef cmd_build(argv: list[str]) -> int:\n    root = Path(\".\").resolve()\n                refusal = protected\n                refusal_provenance = \"executor\"\n                break\n\n            touched = sorted(changed_paths(root, start_sha, records_rel))\n            bad_path = next((p for p in touched if not matches_a_claim(p, claims)), None)\n            if bad_path:\n                status_out = \"refused\"\n                refusal = bad_path\n                break\n\n            # The gate reads the commit, never the executor's directory: a\n            # detached worktree of HEAD, so a file written and not committed\n            # cannot pass a criterion, a test or a check on the executor's\n            # behalf (item 227). Removed before the iteration ends.\n            with gate_checkout(root) as gate_root:\n                criteria_results = [\n                    {\"name\": name, \"exit\": run_criterion(spec_dir / \"criteria\" / name, gate_root)}\n                    for name in criteria_names]\n                for c in criteria_results:\n                    append_event(events_path, \"gate\", f\"{c['name']}: exit {c['exit']}\")\n\n                select_in = \"\".join(p + \"\\n\" for p in touched)\n                select_run = subprocess.run(tests_cfg[\"select\"], shell=True, cwd=str(gate_root),\n                                            input=select_in, capture_output=True,\n                                            text=True, check=False)\n                identifiers = [l for l in select_run.stdout.splitlines() if l.strip()]\n                run_in = \"\".join(i + \"\\n\" for i in identifiers)\n                test_run = subprocess.run(tests_cfg[\"run\"], shell=True, cwd=str(gate_root),\n                                          input=run_in, capture_output=True,\n                                          text=True, check=False)\n                selected_tests = {\"select\": tests_cfg[\"select\"], \"run\": tests_cfg[\"run\"],\n                                  \"count\": len(identifiers), \"exit\": test_run.returncode}\n\n                checks_run = None\n                if checks_command:\n                    checks_run = subprocess.run(checks_command, shell=True, cwd=str(gate_root),\n                                                capture_output=True, text=True, check=False)\n                    checks_result = {\"command\": checks_command, \"exit\": checks_run.returncode}\n\n            # Issue #89, rejection test 1: the gate output that decides pass\n","exit_code":0,"status":"completed"}}

ict[str, Any] = record[\"stop\"]\n        # R3: transient's own signature is the adapter's stop detail\n        # (payload.get(\"detail\")), not derive_stop's detail (which is\n        # None for every class but unclassed/question/environment/gate);\n        # every other non-pass class signs off its own detail (None for\n        # most, so signature is None too -- the class alone, or the log\n        # itself for unclassed, is the specimen's own cause).\n        stop_detail: str | None = ((payload or {}).get(\"detail\") if stop_out[\"class\"] == \"transient\"\n                                   else stop_out.get(\"detail\"))\n        record[\"stop\"] = {**stop_out, \"detail\": stop_detail, \"signature\": signature_of(stop_detail),\n                          \"bound\": None}\n    record_path = write_record(item_records_dir, \"build\", record, m, item_id,\n                               log=\"\\n\".join(transcripts))\n\n    print(f\"attavo build: {status_out} ({record_path.name})\")\n    if status_out == \"halted\":\n        return BUILD_HALT_EXIT\n    return 0 if status_out == \"pass\" else 1\n/Users/davidbean/Projects/attest/attavo/doctor.py:154:INVOCATION_MARKER_SUFFIX = \".started\"\n/Users/davidbean/Projects/attest/attavo/doctor.py:164:    host, pid, the sha it starts on, and the product that started it.\n/Users/davidbean/Projects/attest/attavo/doctor.py:221:    \"\"\"Every <stage>-NN.started under one item whose <stage>-NN.json has\n/Users/davidbean/Projects/attest/attavo/doctor.py:279:def proof_no_invocation_lacks_record(root: Path, m: dict[str, Any] | None) -> Proof:\n/Users/davidbean/Projects/attest/attavo/doctor.py:281:    p = Proof(\"no-invocation-lacks-record\", \"no invocation lacks its record\")\n/Users/davidbean/Projects/attest/attavo/doctor.py:329:            problems.append(f\"{name} started {info.get('at')} on {info.get('host')} \"\n/Users/davidbean/Projects/attest/attavo/doctor.py:537:    \"thread.started\" event, then nothing but \"[adapter exited
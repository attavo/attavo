nsel.py\\\",\\n      \\\"symbol\\\": \\\"cmd_counsel\\\",\\n      \\\"rejection_test\\\": \\\"Create build-01.started without build-01.json, invoke `attavo counsel 1`, and assert exit 1 names the in-progress build, invokes no adapter, and writes no counsel record. Add build-01.json and assert counsel can then proceed normally.\\\",\\n      \\\"diff\\\": \\\"diff --git a/attavo/counsel.py b/attavo/counsel.py\\\\n--- a/attavo/counsel.py\\\\n+++ b/attavo/counsel.py\\\\n@@ -232,6 +232,18 @@ def cmd_counsel(argv: list[str]) -> int:\\\\n     records_rel = m[\\\\\\\"paths\\\\\\\"][\\\\\\\"records\\\\\\\"]\\\\n     item_records_dir = root / records_rel / item_id\\\\n \\\\n+    # A started marker without its corresponding record is an invocation\\\\n+    # still in progress. Counseling an older stop while that invocation is\\\\n+    # running can add a driver-authored record commit to the build's range;\\\\n+    # build must then correctly refuse that foreign commit. Wait for the\\\\n+    # stage to finish instead of manufacturing that collision.\\\\n+    in_progress = next(\\\\n+        (marker for stage in (\\\\\\\"build\\\\\\\", \\\\\\\"verify\\\\\\\")\\\\n+         for marker in sorted(item_records_dir.glob(f\\\\\\\"{stage}-*.started\\\\\\\"))\\\\n+         if not marker.with_suffix(\\\\\\\".json\\\\\\\").exists()),\\\\n+        None,\\\\n+    )\\\\n+    if in_progress is not None:\\\\n+        print(f\\\\\\\"attavo counsel: refused: {in_progress.stem} is still in progress\\\\\\\")\\\\n+        return 1\\\\n+\\\\n     # issue #175: --ask reads the item's latest records regardless of\\\\n     # status -- a question is not bound to a stop -- everything else\\\\n     # about the evidence set and the write is shared with the stop path.\\\\n\\\"\\n    },\\n    \\\"question\\\": null,\\n    \\\"issue\\\": null\\n  },\\n  \\\"forge\\\": {\\n    \\\"read\\\": true,\\n    \\\"reason\\\": null,\\n    \\\"checks\\\": [\\n      {\\n        \\\"name\\\": \\\"coherence\\\",\\n        \\\"conclusion\\\": \\\"success\\\"\\n      },\\n      {\\n        \\\"name\\\": \\\"schema-version\\\",\\n        \\\"conclusion\\\": \\\"success\\\"\\n      },\\n      {\\n        \\\"name\\\": \\\"action-self-check\\\",\\n        \\\"conclusion\\\": \\\"success\\\"\\n      },\\n      {\\n        \\\"name\\\": \\\"spec-gate\\\",\\n        \\\"conclusion\\\": \\\"success\\\"\\n      },\\n      {\\n        \\\"name\\\": \\\"doctor\\\",\\n        \\\"conclusion\\\": \\\"success\\\"\\n      },\\n      {\\n        \\\"name\\\": \\\"test\\\",\\n        \\\"conclusion\\\": \\\"in_progress\\\"\\n      },\\n      {\\n        \\\"name\\\": \\\"typecheck\\\",\\n        \\\"conclusion\\\": \\\"success\\\"\\n      }\\n    ]\\n  },\\n  \\\"question\\\": null,\\n  \\\"record_version\\\": 3,\\n  \\\"item\\\": \\\"229\\\",\\n  \\\"product_version\\\": \\\"v0.29.0-10-gdae6d76\\\",\\n  \\\"product_pin\\\": \\\"v0.29.0\\\"\\n}\\n=== counsel-03.json ===\\n{\\n  \\\"sha\\\": \\\"802de82acd0d8f6809ca8ed7757c214946c4abc3\\\",\\n  \\\"record_stage\\\": \\\"build\\\",\\n  \\\"record\\\": \\\"build-01\\\",\\n  \\\"at\\\": \\\"2026-09-27T15:10:45Z\\\",\\n  \\\"adapter\\\": \\\"codex\\\",\\n  \\\"adapter_config\\\": {\\n    \\\"model\\\": \\\"gpt-5.6-sol\\\"\\n  },\\n  \\\"adapter_version\\\": \\\"codex-cli 0.153.4\\\",\\n  \\\"model\\\": \\\"gpt-5.6-sol\\\",\\n  \\\"model_version\\\": null,\\n  \\\"reports\\\": [\\n    \\\"tokens\\\"\\n  ],\\n  \\\"tokens\\\": {\\n    \\\"input\\\": 224827,\\n    \\\"output\\\": 2743\\n  },\\n  \\\"cost_usd\\\": null,\\n  \\\"wall_clock_s\\\": 73.272,\\n  \\\"status\\\": \\\"done\\\",\\n  \\\"class\\\": \\\"no-cause\\\",\\n  \\\"verdict\\\": \\\"patch\\\",\\n  \\\"citations\\\": [\\n    {\\n      \\\"kind\\\": \\\"instruction\\\",\\n      \\\"path\\\": \\\"/Users/davidbean/Projects/attest/attavo/cli.py\\\",\\n      \\\"symbol\\\": \\\"counsel help: read-only; commits nothing\\\\u2014the caller commits, as with every stage\\\",\\n      \\\"ruling_id\\\": null\\n    },\\n    {\\n      \\\"kind\\\": \\\"mechanism\\\",\\n      \\\"path\\\": \\\"/Users/davidbean/Projects/attest/attavo/build.py\\\",\\n      \\\"symbol\\\": \\\"cmd_build foreign-commit check\\\",\\n      \\\"ruling_id\\\": null\\n    },\\n    {\\n      \\\"kind\\\": \\\"guard\\\",\\n      \\\"path\\\": \\\"/Users/davidbean/Projects/attest/tests/test_counsel.py\\\",\\n      \\\"symbol\\\": \\\"test_counsel_ask_reads_the_latest_record_even_when_it_passed\\\",\\n      \\\"ruling_id\\\": null\\n    }\\n  ],\\n  \\\"proposal\\\": {\\n    \\\"ruling_text\\\": null,\\n    \\\"patch\\\": null,\\n    \\\"question\\\": null,\\n    \\\"issue\\\": {\\n      \\\"title\\\": \\\"A counsel status question can poison an active build with a foreign commit\\\",\\n      \\\"body\\\": \\\"Severity: high / Provenance: product\\\\n\\\\n## Problem\\\\n\\\\nItem 229\\\\u2019s executor committed the requested implementation at `15a774515f5a`. While build-01 was still active, `counsel --ask \\\\\\\"how is it going so far?\\\\\\\"` wrote counsel-01 and the driver committed it at `24aed171c5ec`. On the executor\\\\u2019s next return, `cmd_build` correctly found that driver-authored commit between `start_sha` and HEAD and refused the build as `no-cause`.\\\\n\\\\nThe operator\\\\u2019s read-only status question therefore changed the active build\\\\u2019s HEAD and invalidated an otherwise executor-authored build. The green forge checks do not cure this race, and the selected-test failure does not explain the recorded refusal.\\\\n\\\\n## Retires\\\\n\\\\nA read-only counsel/status inquiry, or transport of its record, being able to introduce a foreign commit into an active build\\\\u2019s commit range.\\\\n\\\\n## Change\\\\n\\\\nMake counsel/status recording and transport unable to mutate the checkout observed by an active build. Use an isolated transport worktree or defer the counsel-record commit until the active stage has produced its record. Preserve the build\\\\u2019s foreign-author guard; driver commits must not be silently exempted from it.\\\\n\\\\n## Acceptance\\\\n\\\\n- Start a two-iteration build whose first iteration creates an executor-authored commit and whose second iteration is still running.\\\\n- Run `attavo counsel N --ask \\\\\\\"how is it going so far?\\\\\\\"` and transport its record during that interval.\\\\n- The active build\\\\u2019s HEAD and executor commit range remain unchanged by the counsel operation.\\\\n- The build is not refused for the counsel record and can pass after its gates pass.\\\\n- The counsel record is eventually committed by the driver without being lost.\\\\n- An actual non-executor commit introduced into the build\\\\u2019s range remains refused by the existing authorship guard.\\\"\\n    }\\n  },\\n  \\\"forge\\\": {\\n    \\\"read\\\": true,\\n    \\\"reason\\\": null,\\n    \\\"checks\\\": [\\n      {\\n        \\\"name\\\": \\\"coherence\\\",\\n        \\\"conclusion\\\": \\\"success\\\"\\n      },\\n      {\\n        \\\"name\\\": \\\"schema-version\\\",\\n        \\\"conclusion\\\": \\\"success\\\"\\n      },\\n      {\\n        \\\"name\\\": \\\"action-self-check\\\",\\n        \\\"conclusion\\\": \\\"success\\\"\\n      },\\n      {\\n        \\\"name\\\": \\\"spec-gate\\\",\\n        \\\"conclusion\\\": \\\"success\\\"\\n      },\\n      {\\n        \\\"name\\\": \\\"doctor\\\",\\n        \\\"conclusion\\\": \\\"success\\\"\\n      },\\n      {\\n        \\\"name\\\": \\\"test\\\",\\n        \\\"conclusion\\\": \\\"success\\\"\\n      },\\n      {\\n        \\\"name\\\": \\\"typecheck\\\",\\n        \\\"conclusion\\\": \\\"success\\\"\\n      }\\n    ]\\n  },\\n  \\\"question\\\": \\\"what is your recommendation?\\\",\\n  \\\"record_version\\\": 3,\\n  \\\"item\\\": \\\"229\\\",\\n  \\\"product_version\\\": \\\"v0.29.0-10-gdae6d76\\\",\\n  \\\"product_pin\\\": \\\"v0.29.0\\\"\\n}\",\"is_error\":false}]},\"parent_tool_use_id\":null,\"session_id\":\"8b9a9eba-cd13-4154-8596-ab0c96cc1266\",\"uu
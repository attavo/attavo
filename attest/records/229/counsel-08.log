ed: no adapter named {adapter_name!r}\\\")\\n344\\t        return 1\\n345\\t\\n346\\t    specs_rel = m[\\\"paths\\\"][\\\"specs\\\"]\\n347\\t    records_rel = m[\\\"paths\\\"][\\\"records\\\"]\\n348\\t    spec_dir = root / specs_rel / item_id\\n349\\t    item_records_dir = root / records_rel / item_id\\n350\\t    spec_sha = last_commit_touching(root, str(Path(specs_rel) / item_id))\\n351\\t    latest_approval = latest_record(item_records_dir, \\\"approval\\\")\\n352\\t    parsed, _ = parse_spec(spec_dir / \\\"spec.md\\\")\\n353\\t    claims = parsed[\\\"claims\\\"] if parsed else []\\n354\\t    criteria_names = parsed[\\\"criteria\\\"] if parsed else []\\n355\\t    adapter_config = merge_adapter_config(m, adapter_name, \\\"build\\\")\\n356\\t    checks_cfg = m.get(\\\"checks\\\") or {}\\n357\\t    checks_command = checks_cfg.get(\\\"command\\\")\\n358\\t    probe = checks_cfg.get(\\\"probe\\\")\\n359\\t    probe_timeout_s = checks_cfg.get(\\\"probe_timeout_s\\\")\\n360\\t    identity = executor_identity(adapter_name)\\n361\\t    reports = adapter_reports(adapter_path)\\n362\\t\\n363\\t    start_sha = git(root, \\\"rev-parse\\\", \\\"HEAD\\\").strip()\\n364\\t    branch = git(root, \\\"rev-parse\\\", \\\"--abbrev-ref\\\", \\\"HEAD\\\").strip()\\n365\\t    started = time.monotonic()\\n366\\t\\n367\\t    events_path = stage_events_dir(root) / f\\\"build-{next_attempt_number(item_records_dir, 'build'):02d}.events.jsonl\\\"\\n368\\t\\n369\\t    # Issue #115, then issue #212: whether this machine can run the tenant's\\n370\\t    # checks at all is asked once here, on the approved tree, before the\\n371\\t    # adapter is ever invoked -- a missing import at test collection (item\\n372\\t    # #106's build-01) is not a failing check, and no build could have\\n373\\t    # passed against it. A tenant that declares [checks].probe is asked by\\n374\\t    # the probe, inside [checks].probe_timeout_s: exit 0 yes, anything else\\n375\\t    # or the bound no. A tenant that does not is asked the old way, by\\n376\\t    # running [checks].command whole -- exit 2 no, exit 0 or 1 (the checks\\n377\\t    # ran and passed or failed, the expected states before a build) yes --\\n378\\t    # which is the run #194's build-01 spent 215 s on. Either way the feed\\n379\\t    # says what is being asked and what the answer was.\\n380\\t    if checks_command:\\n381\\t        append_event(events_path, \\\"gate\\\", \\\"checking this machine can run the checks\\\")\\n382\\t        asked = checks_command\\n383\\t        if probe:\\n384\\t            asked = probe\\n385\\t            code, out, err, timed_out = run_bounded(probe, root, \\\"\\\", probe_timeout_s)\\n386\\t            refusal_text = (f\\\"[checks].probe did not finish within {probe_timeout_s} s\\\" if timed_out\\n387\\t                            else f\\\"[checks].probe exited {code} on the approved tree\\\"\\n388\\t                            if code != 0 else None)\\n389\\t        else:\\n390\\t            preflight = subprocess.run(checks_command, shell=True, cwd=str(root),\\n391\\t                                       capture_output=True, text=True, check=False)\\n392\\t            code, out, err = preflight.returncode, preflight.stdout, preflight.stderr\\n393\\t            refusal_text = (\\\"[checks].command exited 2 on the approved tree\\\" if code == 2 else None)\\n394\\t        if refusal_text:\\n395\\t            append_event(events_path, \\\"gate\\\", f\\\"this machine cannot run the checks: {refusal_text}\\\")\\n396\\t            log = out + err\\n397\\t            detail = _log_last_line(out + \\\"\\\\n\\\" + err) or refusal_text\\n398\\t            record = {\\n399\\t                \\\"sha\\\": start_sha,\\n400\\t                \\\"start_sha\\\": start_sha,\\n401\\t                \\\"spec_sha\\\": spec_sha,\\n402\\t                \\\"approval_sha\\\": latest_approval.get(\\\"sha\\\") if latest_approval else None,\\n403\\t                \\\"at\\\": now_iso(),\\n404\\t                \\\"adapter\\\": adapter_name,\\n405\\t                \\\"adapter_config\\\": adapter_config,\\n406\\t                \\\"executor_identity\\\": identity,\\n407\\t                \\\"reports\\\": reports,\\n408\\t                \\\"adapter_version\\\": None,\\n409\\t                \\\"model\\\": None,\\n410\\t                \\\"model_version\\\": None,\\n411\\t                \\\"iterations\\\": 1,\\n412\\t                \\\"criteria\\\": [],\\n413\\t                \\\"selected_tests\\\": None,\\n414\\t                \\\"checks\\\": {\\\"command\\\": asked, \\\"exit\\\": code},\\n415\\t                \\\"tokens\\\": {\\\"input\\\": 0, \\\"output\\\": 0},\\n416\\t                \\\"cost_usd\\\": None,\\n417\\t                \\\"wall_clock_s\\\": round(time.monotonic() - started, 3),\\n418\\t                \\\"status\\\": \\\"refused\\\",\\n419\\t                \\\"refusal\\\": refusal_text,\\n420\\t                \\\"halted\\\": None,\\n421\\t                \\\"retry_of\\\": None,\\n422\\t                \\\"steer\\\": None,\\n423\\t                # R3: environment is never retried by this item (recorded\\n424\\t                # here, acted on by R4's breaker) -- signed anyway for\\n425\\t                # the exhaustion report's own side-by-side, on the\\n426\\t                # remote chance a person retries by hand.\\n427\\t                \\\"stop\\\": {\\\"class\\\": \\\"environment\\\", \\\"provenance\\\": \\\"tenant\\\", \\\"detail\\\": detail,\\n428\\t                        \\\"signature\\\": signature_of(detail), \\\"bound\\\": None},\\n429\\t            }\\n430\\t            record_path = write_record(item_records_dir, \\\"build\\\", record, m, item_id,\\n431\\t                                       log=log or refusal_text + \\\"\\\\n\\\")\\n432\\t            print(f\\\"attavo build: refused ({record_path.name})\\\")\\n433\\t            return 1\\n434\\t        append_event(events_path, \\\"gate\\\", \\\"this machine can run the checks
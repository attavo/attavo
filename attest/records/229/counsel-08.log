               not_merged=not_merged, not_read=not_read)\\n824\\t\\n825\\t\\n826\\tdef proof_no_attested_item_is_empty(root: Path, m: dict[str, Any] | None) -> Proof:\\n827\\t    \\\"\\\"\\\"Proof seven (item 227). Every merged, fully-staged item's passing\\n828\\t    build names a change: its sha is not its start_sha. Item 227 was\\n829\\t    specified, approved, built by one invocation, judged by another,\\n830\\t    merged and sealed, and its build committed nothing -- the executor\\n831\\t    left the stub in the working tree, the gate read the tree, and main\\n832\\t    received the spec and none of the change. Six proofs held over it.\\n833\\t\\n834\\t    [doctor].built_since: merges at or before this commit are before the\\n835\\t    window -- named, never failed -- so the specimen stands on every\\n836\\t    doctor run without failing the tenant forever. Absent, the window is\\n837\\t    proof three's. A build record with no start_sha (written before that\\n838\\t    field) is named as not readable, not failed.\\\"\\\"\\\"\\n839\\t    p = Proof(\\\"no-attested-item-is-empty\\\", \\\"every attested item's build names a change\\\")\\n840\\t    if m is None:\\n841\\t        return p.fail(f\\\"no {MANIFEST} at {root}; no records directory is declared\\\")\\n842\\t    records_rel = m.get(\\\"paths\\\", {}).get(\\\"records\\\", \\\"\\\")\\n843\\t    records_dir = root / records_rel\\n844\\t    if not records_dir.is_dir():\\n845\\t        return p.fail(f\\\"no records directory under {records_dir}\\\")\\n846\\t    items = load_records(records_dir)\\n847\\t    complete = [item for item, stages in sorted(items.items()) if all(s in stages for s in STAGES)]\\n848\\t    since = (m.get(\\\"doctor\\\") or {}).get(\\\"built_since\\\")\\n849\\t    if not (isinstance(since, str) and since.strip()):\\n850\\t        try:\\n851\\t            since = proof_window_start(root, m)[1]\\n852\\t        except WindowRefused as exc:\\n853\\t            return p.fail(str(exc))\\n854\\t    else:\\n855\\t        try:\\n856\\t            since = git(root, \\\"rev-parse\\\", \\\"--verify\\\", f\\\"{since}^{{commit}}\\\").strip()\\n857\\t        except RuntimeError:\\n858\\t            return p.fail(f\\\"[doctor] built_since {since} does not resolve to a commit\\\")\\n859\\t    merges, refusal = _merges_reachable(root)\\n860\\t    if refusal:\\n861\\t        return p.fail(refusal)\\n862\\t    built: list[str] = []\\n863\\t    before_window: list[str] = []\\n864\\t    not_merged: list[str] = []\\n865\\t    not_read: list[str] = []\\n866\\t    empty: list[str] = []\\n867\\t    for item in complete:\\n868\\t        merge_sha, _ = merge_introducing_records(root, records_rel, item, STAGES, merges=merges)\\n869\\t        if merge_sha is None:\\n870\\t            not_merged.append(item)\\n871\\t            continue\\n872\\t        if _is_ancestor(root, merge_sha, since):\\n873\\t            before_window.append(item)\\n874\\t            continue\\n875\\t        build = items[item][\\\"build\\\"]\\n876\\t        sha, start = build.get(\\\"sha\\\"), build.get(\\\"start_sha\\\")\\n877\\t        if not sha or not start:\\n878\\t            not_read.append(item)\\n879\\t            continue\\n880\\t        if sha == start:\\n881\\t            empty.append(f\\\"item {item} merged at {merge_sha[:12]}: build \\\"\\n882\\t                         f\\\"sha equals start_sha {str(sha)[:12]}; nothing was built\\\")\\n883\\t        else:\\n884\\t            built.append(item)\\n885\\t    if empty:\\n886\\t        return p.fail(\\\"; \\\".join(empty), built=built, before_window=before_window,\\n887\\t                      not_merged=not_merged, not_read=not_read)\\n888\\t    window = f\\\" at {since[:12]}\\\" if before_window else \\\"\\\"\\n889\\t    return p.hold(f\\\"{len(built)} built, {len(before_window)} before the window{window}, \\\"\\n890\\t                  f\\\"{len(not_read)} without start_sha, {len(not_merged)} not merged\\\",\\n891\\t                  built=built, before_window=before_window, not_merged=not_merged,\\n892\\t                  not_read=not_read)\\n893\\t\\n894\\t\\n895\\tdef doctor(root: Path) -> list[Proof]:\\n896\\t    m = read_manifest(root)\\n897\\t    return [proof_every_gate_rejects(root, m),\\n898\\t            proof_one_item_every_stage(root, m),\\n899\\t            proof_no_commit_lacks_record(root, m),\\n900\\t            proof_no_stop_lacks_cause(root, m),\\n901\\t            proof_no_invocation_lacks_record(root, m),\\n902\\t            proof_every_attested_item_is_sealed(root, m),\\n903\\t            proof_no_attested_item_is_empty(root, m)]\\n904\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"ec2614fd-fe76-497e-a0f4-348a6650b419\",\"uuid\":\"faf51797-24b5-427a-abf6-92afd9eb3003\",\"timestamp\":\"2026-09-27T15:37:53.145Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/davidbean/Projects/attavo-worktree-229/attavo/doctor.py\",\"content\":\"    unsealed: list[str] = []\\n    not_merged: list[str] = []\\n    not_read: list[str] = []\\n    reasons: list[str] = []\\n    for item in complete:\\n        merge_sha, _ = merge_introducing_records(root, records_rel, item, STAGES, merges=merges)\\n        if merge_sha is None:\\n            not_merged.append(item)\\n            continue\\n        if _is_ancestor(root, merge_sha, since):\\n            before_window.append(item)\\n            continue\\n        statement, exit_code = statement_for(root, cmd, merge_sha)\\n        if statement is not None:\\n            sealed.append(item)\\n            disagreement = _accounting_disagrees(root, records_dir / item, item, merge_sha,\\n                                                 statement)\\n            if disagreement:\\n                reasons.append(disagreement)\\n        elif exit_code == 2:\\n            not_read.append(item)\\n            reasons.append(f\\\"item {item} merged at {merge_sha[:12]}: not read -- \\\"\\n                           f\\\"the store could not be read; {cmd!r} exited 2\\\")\\n        else:\\n            unsealed.append(item)\\n            reasons.append(f\\\"item {item} merged at {merge_sha[:12]} has no statement in the store\\\")\\n    if reasons:\\n        return p.fail(\\\"; \\\".join(reasons), sealed=sealed, before_window=before_window,\\n                      unsealed=unsealed, not_merged=not_merged, not_read=not_read)\\n    window = f\\\" at {since[:12]}\\\" if before_window else \\\"\\\"\\n    return p.hold(f\\\"{len(sealed)} sealed, {len(before_window)} before the window{window}, \\\"\\n                 f\\\"{len(not_merged)} not merged\\\",\\n                 sealed=sealed, before_window=before_window, unsealed=unsealed,\\n                 not_merged=not_merged, not_read=not_read)\\n\\n\\ndef proof_no_attested_item_is_empty(root: Path, m: dict[str, Any] | None) -> Proof:\\n    \\\"\\\"\\\"Proof seven (item 227). Every merged, fully-staged item's passing\\n    build names a change: its sha is not its start_sha. Item 227 was\\n    specified, approved, built by one invocation, judged by another,\\n    merged and sealed, and its build committed nothing -- the executor\\n    left the stub in the working tree, the gate read the tree, and main\\n    received the spec and none of the change. Six proofs held over it.\\n\\n    [doctor].built_since: merges at or before this commit are before the\\n    window -- named, never failed -- so the specimen stands on every\\n    doctor run without failing the tenant forever. Absent, the window is\\n    proof three's. A build record with no start_sha (written before that\\n    field) is named as not readable, not failed.\\\"\\\"\\\"\\n    p = Proof(\\\"no-attested-item-is-empty\\\", \\\"every attested item's build names a change\\\")\\n    if m is None:\\n        return p.fail(f\\\"no {MANIFEST} at {root}; no records directory is declared\\\")\\n    records_rel = m.get(\\\"paths\\\", {}).get(\\\"records\\\", \\\"\\\")\\n    records_dir = root / records_rel\\n    if not records_dir.is_dir():\\n        return p.fail(f\\\"no records directory under {records_dir}\\\")\\n    items = load_records(records_dir)\\n    complete = [item for item, stages in sorted(items.items()) if all(s in stages for s in STAGES)]\\n    since = (m.get(\\\"doctor\\\") or {}).get(\\\"built_since\\\")\\n    if not (isinstance(since, str) and since.strip()):\\n        try:\\n            since = proof_window_start(root, m)[1]\\n        except WindowRefused as exc:\\n            return p.fail(str(exc))\\n    else:\\n        try:\\n            since = git(root, \\\"rev-parse\\\", \\\"--verify\\\", f\\\"{since}^{{commit}}\\\").strip()\\n        except RuntimeError:\\n            return p.fail(f\\\"[doctor] built_since {since} does not resolve to a commit\\\")\\n    merges, refusal = _merges_reachable(root)\\n    if refusal:\\n        return p.fail(refusal)\\n    built: list[str] = []\\n    before_window: list[str] = []\\n    not_merged: list[str] = []\\n    not_read: list[str] = []\\n    empty: list[str] = []\\n    for item in complete:\\n        merge_sha, _ = merge_introducing_records(root, records_rel, item, STAGES, merges=merges)\\n        if merge_sha is None:\\n            not_merged.append(item)\\n            continue\\n        if _is_ancestor(root, merge_sha, since):\\n            before_window.append(item)\\n            continue\\n        build = items[item][\\\"build\\\"]\\n        sha, start = build.get(\\\"sha\\\"), build.get(\\\"start_sha\\\")\\n        if not sha or not start:\\n            not_read.append(item)\\n            continue\\n        if sha == start:\\n            empty.append(f\\\"item {item} merged at {merge_sha[:12]}: build \\\"\\n                         f\\\"sha equals start_sha {str(sha)[:12]}; nothing was built\\\")\\n        else:\\n            built.append(item)\\n    if empty:\\n        return p.fail(\\\"; \\\".join(empty), built=built, before_window=before_window,\\n                      not_merged=not_merged, not_read=not_read)\\n    window = f\\\" at {since[:12]}\\\" if before_window else \\\"\\\"\\n    return p.hold(f\\\"{len(built)} built, {len(before_window)} before the window{window}, \\\"\\n                  f\\\"{len(not_read)} without start_sha, {len(not_merged)} not merged\\\",\\n                  built=built, before_window=before_window, not_merged=not_merged,\\n                  not_read=not_read)\\n\\n\\ndef doctor(root: Path) -> list[Proof]:\\n    m = read_manifest(root)\\n    return [proof_every_gate_rejects(root, m),\\n            proof_one_item_every_stage(root, m),\\n            proof_no_commit_lacks_record(root, m),\\n            proof_no_stop_lacks_cause(root, m),\\n            proof_no_invocation_lacks_record(root, m),\\n            proof_every_attested_item_is_sealed(root, m),\\n            proof_no_attested_item_is_empty(root, m)]\\n\",\"numLines\":115,\"startLine\":790,\"totalLines\":921}}}\n1929:+{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01H8TChHsMNxYdyHQG2EBuKK\",\"type\":\"tool_result\",\"content\":\"55\\t        parts = line.rsplit(\\\" \\\", 1)\\n56\\t        if len(parts) == 2:\\n57\\t            conclusions.append({\\\"name\\\": parts[0], \\\"conclusion\\\": parts[1]})\\n58\\t    # A commit the forge has no record of is not green -- it is unread.\\n59\\t    # The executor's own commit is exactly this: the forge attaches\\n60\\t    # checks to a pull request's head, and that commit stops being the\\n61\\t    # head the moment a record commit lands on top of it. all() over an\\n62\\t    # empty list is True, which is why this is spelled out rather than\\n63\\t    # implied by the loop above.\\n64\\t    ok = run.returncode == 0 and bool(conclusions) and all(\\n65\\t        c[\\\"conclusion\\\"] in FORGE_OK_CONCLUSIONS for c in conclusions)\\n66\\t    return {\\\"command\\\": checks_command, \\\"sha\\\": sha, \\\"conclusions\\\": conclusions}, ok\\n67\\t\\n68\\t\\n69\\tdef diff_since_approval(root: Path, approval_sha: 
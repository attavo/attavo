e_lines.append(f\"selected tests ({selected_tests['count']}): exit \"\n                              f\"{selected_tests['exit']}\")\n            if test_run.stdout.strip():\n                gate_lines += [\"--- selected tests stdout ---\", test_run.stdout.rstrip(\"\\n\")]\n            if test_run.stderr.strip():\n                gate_lines += [\"--- selected tests stderr ---\", test_run.stderr.rstrip(\"\\n\")]\n            if checks_run is not None:\n                tail = (checks_run.stdout.splitlines() + checks_run.stderr.splitlines())\n                tail = tail[-CHECKS_FEEDBACK_TAIL_LINES:]\n                gate_lines.append(f\"tenant checks: exit {checks_run.returncode}\")\n                gate_lines += [\"--- checks output (tail) ---\", *tail]\n            transcripts[-1] += (f\"\\n--- attavo gates, iteration {iteration} ---\\n\"\n                               + \"\\n\".join(gate_lines))\n\n            failing = [c for c in criteria_results if c[\"exit\"] != 0]\n            checks_ok = checks_run is None or checks_run.returncode == 0\n            if not failing and test_run.returncode == 0 and checks_ok:\n                status_out = \"pass\"\n                break\n\n            if iteration == BUILD_ITERATION_BUDGET:\n                status_out = \"failed\"\n                break\n\n            feedback_lines = []\n            if failing:\n                feedback_lines.append(\"criteria failing:\")\n                feedback_lines += [f\"- {c['name']}: exit {c['exit']}\" for c in failing]\n            if test_run.returncode != 0:\n                feedback_lines += [f\"test run exit {test_run.returncode}\",\n                                   \"--- stdout ---\", test_run.stdout,\n                                   \"--- stderr ---\", test_run.stderr]\n            if checks_run is not None and checks_run.returncode != 0:\n                tail = (checks_run.stdout.splitlines() + checks_run.stderr.splitlines())\n                tail = tail[-CHECKS_FEEDBACK_TAIL_LINES:]\n                feedback_lines += [f\"checks exit {checks_run.returncode}\",\n                                   \"--- checks output (tail) ---\", *tail]\n            feedback_path.write_text(\"\\n\".join(feedback_lines) + \"\\n\")\n\n    record = {\n        \"sha\": git(root, \"rev-parse\", \"HEAD\").strip(),\n        \"start_sha\": start_sha,\n        \"spec_sha\": spec_sha,\n        \"approval_sha\": latest_approval.get(\"sha\") if latest_approval else None,\n        \"The stub is the fixture the acceptance criteria were shown to \"\n        \"pass against; it is not the intended change. A difference \"\n        \"between the built tree and the stub is not a finding: a \"\n        \"criterion the stub satisfies trivially is.\")\n\n\ndef build_instruction() -> str:\n    parts = list(spec_sections())\n\n    rulings = read_text(\"ATTAVO_RULINGS\")\n    if rulings.strip():\n        parts.append(\"## Rulings\\n\\n\" + rulings.strip())\n\n    feedback_path = os.environ.get(\"ATTAVO_FEEDBACK\")\n    feedback = read_text(\"ATTAVO_FEEDBACK\")\n    if feedback.strip():\n        parts.append(\n            \"## Feedback from the previous attempt\\n\\n\"\n            f\"The feedback is at {describe_file(feedback_path, feedback, diff_like=False)}. \"\n            \"It is not inlined here: read it yourself with your own tools \"\n            \"before continuing.\")\n\n    parts.append(\n        \"commit your work on the current branch; if you cannot proceed \"\n        \"without a decision that changes the criteria, do not guess: \"\n        \"answer with status question\")\n\n    test_command = os.environ.get(\"ATTAVO_TEST_COMMAND\")\n    if test_command:\n        bound = os.environ.get(\"ATTAVO_TEST_TIMEOUT_S\")\n        parts.append(\n            f\"to run tests while you work, run `{test_command}`: it runs the tests \"\n            \"selected for the files you have changed\"\n            + (f\" and stops at {bound} s\" if bound else \"\")\n            + \". Run a
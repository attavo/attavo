se\\\",\\n  \\\"verdict\\\": \\\"patch\\\",\\n  \\\"citations\\\": [\\n    {\\n      \\\"kind\\\": \\\"instruction\\\",\\n      \\\"path\\\": \\\"/Users/davidbean/Projects/attest/attavo/cli.py\\\",\\n      \\\"symbol\\\": \\\"BUILD_HELP\\\",\\n      \\\"ruling_id\\\": null\\n    },\\n    {\\n      \\\"kind\\\": \\\"mechanism\\\",\\n      \\\"path\\\": \\\"/Users/davidbean/Projects/attest/attavo/counsel.py\\\",\\n      \\\"symbol\\\": \\\"cmd_counsel\\\",\\n      \\\"ruling_id\\\": null\\n    },\\n    {\\n      \\\"kind\\\": \\\"guard\\\",\\n      \\\"path\\\": \\\"/Users/davidbean/Projects/attest/tests/test_counsel.py\\\",\\n      \\\"symbol\\\": \\\"test_counsel_refuses_while_a_build_attempt_is_in_progress\\\",\\n      \\\"ruling_id\\\": null\\n    }\\n  ],\\n  \\\"proposal\\\": {\\n    \\\"ruling_text\\\": null,\\n    \\\"patch\\\": {\\n      \\\"file\\\": \\\"/Users/davidbean/Projects/attest/attavo/counsel.py\\\",\\n      \\\"symbol\\\": \\\"cmd_counsel\\\",\\n      \\\"rejection_test\\\": \\\"Create build-01.started without build-01.json, invoke `attavo counsel 1`, and assert exit 1 names the in-progress build, invokes no adapter, and writes no counsel record. Add build-01.json and assert counsel can then proceed normally.\\\",\\n      \\\"diff\\\": \\\"diff --git a/attavo/counsel.py b/attavo/counsel.py\\\\n--- a/attavo/counsel.py\\\\n+++ b/attavo/counsel.py\\\\n@@ -232,6 +232,18 @@ def cmd_counsel(argv: list[str]) -> int:\\\\n     records_rel = m[\\\\\\\"paths\\\\\\\"][\\\\\\\"records\\\\\\\"]\\\\n     item_records_dir = root / records_rel / item_id\\\\n \\\\n+    # A started marker without its corresponding record is an invocation\\\\n+    # still in progress. Counseling an older stop while that invocation is\\\\n+    # running can add a driver-authored record commit to the build's range;\\\\n+    # build must then correctly refuse that foreign commit. Wait for the\\\\n+    # stage to finish instead of manufacturing that collision.\\\\n+    in_progress = next(\\\\n+        (marker for stage in (\\\\\\\"build\\\\\\\", \\\\\\\"verify\\\\\\\")\\\\n+         for marker in sorted(item_records_dir.glob(f\\\\\\\"{stage}-*.started\\\\\\\"))\\\\n+         if not marker.with_suffix(\\\\\\\".json\\\\\\\").exists()),\\\\n+        None,\\\\n+    )\\\\n+    if in_progress is not None:\\\\n+        print(f\\\\\\\"attavo counsel: refused: {in_progress.stem} is still in progress\\\\\\\")\\\\n+        return 1\\\\n+\\\\n     # issue #175: --ask reads the item's latest records regardless of\\\\n     # status -- a question is not bound to a stop -- everything else\\\\n     # about the evidence set and the write is shared with the stop path.\\\\n\\\"\\n    },\\n    \\\"question\\\": null,\\n    \\\"issue\\\": null\\n  },\\n  \\\"forge\\\": {\\n    \\\"read\\\": true,\\n    \\\"reason\\\": null,\\n    \\\"checks\\\": [\\n      {\\n        \\\"name\\\": \\\"coherence\\\",\\n        \\\"conclusion\\\": \\\"success\\\"\\n      },\\n      {\\n        \\\"name\\\": \\\"schema-version\\\",\\n        \\\"conclusion\\\": \\\"success\\\"\\n      },\\n      {\\n        \\\"name\\\": \\\"action-self-check\\\",\\n        \\\"conclusion\\\": \\\"success\\\"\\n      },\\n      {\\n        \\\"name\\\": \\\"spec-gate\\\",\\n        \\\"conclusion\\\": \\\"success\\\"\\n      },\\n      {\\n        \\\"name\\\": \\\"doctor\\\",\\n        \\\"conclusion\\\": \\\"success\\\"\\n      },\\n      {\\n        \\\"name\\\": \\\"test\\\",\\n        \\\"conclusion\\\": \\\"in_progress\\\"\\n      },\\n      {\\n        \\\"name\\\": \\\"typecheck\\\",\\n        \\\"conclusion\\\": \\\"success\\\"\\n      }\\n    ]\\n  },\\n  \\\"question\\\": null,\\n  \\\"record_version\\\": 3,\\n  \\\"item\\\": \\\"229\\\",\\n  \\\"product_version\\\": \\\"v0.29.0-10-gdae6d76\\\",\\n  \\\"product_pin\\\": \\\"v0.29.0\\\"\\n}\\n=== counsel-03.json ===\\n{\\n  \\\"sha\\\": \\\"802de82acd0d8f6809ca8ed7757c214946c4abc3\\\",\\n  \\\"record_stage\\\": \\\"build\\\",\\n  \\\"record\\\": \
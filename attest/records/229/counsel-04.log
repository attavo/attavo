e f\"[checks].probe exited {code} on the approved tree\"\n                            if code != 0 else None)\n        else:\n            preflight = subprocess.run(checks_command, shell=True, cwd=str(root),\n                                       capture_output=True, text=True, check=False)\n            code, out, err = preflight.returncode, preflight.stdout, preflight.stderr\n            refusal_text = (\"[checks].command exited 2 on the approved tree\" if code == 2 else None)\n        if refusal_text:\n            append_event(events_path, \"gate\", f\"this machine cannot run the checks: {refusal_text}\")\n            log = out + err\n            detail = _log_last_line(out + \"\\n\" + err) or refusal_text\n            record = {\n                \"sha\": start_sha,\n                \"start_sha\": start_sha,\n                \"spec_sha\": spec_sha,\n                tail = (checks_run.stdout.splitlines() + checks_run.stderr.splitlines())\n                tail = tail[-CHECKS_FEEDBACK_TAIL_LINES:]\n                feedback_lines += [f\"checks exit {checks_run.returncode}\",\n                                   \"--- checks output (tail) ---\", *tail]\n            feedback_path.write_text(\"\\n\".join(feedback_lines) + \"\\n\")\n\n    record = {\n        \"sha\": git(root, \"rev-parse\", \"HEAD\").strip(),\n        \"start_sha\": start_sha,\n        \"spec_sha\": spec_sha,\n        \"approval_sha\": latest_approval.get(\"sha\") if latest_approval else None,\n        \"at\": now_iso(),\n        \"adapter\": adapter_name,\n        \"adapter_config\": adapter_config,\n        \"executor_identity\": identity,\n        \"reports\": reports,\n        \"adapter_version\": adapter_version,\n        \"model\": model,\n        \"model_version\": model_version,\n        \"iterations\": iterations_used,\n        \"criteria\": criteria_results,\n        \"selected_tests\": selected_tests,\n        \"checks\": checks_result,\n        \"tokens\": tokens,\n        \"cost_usd\": cost_usd,\n        \"wall_clock_s\": round(time.monotonic() - started, 3),\n        \"status\": status_out,\n        \"refusal\": refusal,\n        \"halted\": halted,\n        \"retry_of\": retry_of,\n        \"steer\": steer,\n        \"stop\": derive_stop(status_out, refusal=refusal, halted=halted,\n                            log=\"\\n\".join(transcripts),\n                            report_class=(payload or {}).get(\"class\"),\n                            refusal_provenance=refusal_provenance),\n    }\n    if record[\"stop\"] is not None:\n        stop_out: dict[str, Any] = record[\"stop\"]\n        # R3: transient's own signature is the adapter's stop detail\n        # (payload.get(\"detail\")), not derive_stop's detail (which is\n        # None for every class but unclassed/question/environment/gate);\n        # every other non-pass class signs off its own detail (None for\n        # most, so signature is None too -- the class alone, or the log\n        # itself for unclassed, is the specimen's own cause).\n        stop_detail: str | None = ((payload or {}).get(\"detail\") if stop_out[\"class\"] == \"transient\"\n                                   else stop_out.get(\"detail\"))\n        record[\"stop\"] = {**stop_out, \"detail\": stop_detail, \"signature\": signature_of(stop_detail),\n                          \"bound\": None}\n    record_path = write_record(item_records_dir, \"build\", record, m, item_id,\n                               log=\"\\n\".join(transcripts))\n\n    print(f\"attavo build: {status_out} ({record_path.name})\")\n    if status_out == \"halted\":\n        return BUILD_HALT_EXIT\n    return 0 if status_out == \"pass\" else 1\n\n    passes_until(root, lambda: pushed(bare, \"verify record for item 1 (verify-02)\"), seconds=40)\n    passes_until(root, lambda: counsel_records(root) != [], seconds=20)\n    assert latest_record(root, \"counsel\")[\"record\"] == \"verify-02\"\n\n\ndef test_counsels_verdict_routes_the_next_pass(tmp_path: Path) -> None:\n    \"\"\"Counsel steers: `answer` starts the next attempt with the answer as\n    its steer (recorded in `steer`); `patch` starts nothing and the\n    report reads waiting on the issue; `person` starts nothing.\"\"\"\n    responses = tmp_path / \"counsel\"\n    responses.mkdir()\n    for verdict in (\"answer\", \"patch\", \"person\"):\n        (responses / f\"{verdict}.json\").write_text(json.dumps({\n            \"model\": \"fixture\", \"model_version\": None, \"adapter_version\": \"fixture-1\",\n            \"tokens\": {\"input\": 1, \"output\": 1}, \"cost_usd\": 0.0, \"class\": \"question\", \"verdict\": verdict,\n            \"citations\": [{\"kind\": \"instruction\", \"path\": \"specs/1/spec.md\", \"symbol\": \"problem\"}],\n            \"proposal\": {\"ruling_text\": \"use the base tree\" if verdict == \"answer\" else None,\n                         \"patch\": \"the fixture cannot read overlays\" if verdict == \"patch\" else None,\n                         \"question\": None if verdict != \"person\" else \"which overlay wins?\"}}))\n    for verdict, expect_attempt in ((\"answer\", 2), (\"patch\", 1), (\"person\", 1)):\n        sub = tmp_path / verdict\n        sub.mkdir()\n        root, bare = approved_tenant(sub)\n        manifest = root / \"attavo.toml\"\n        manifest.write_text(manifest.read_text().replace('[executor]\\nbuild = \"fixture\"', '[executor]\\nbuild = \"fixture\"\\ncounsel = \"fixture\"'))\n        commit_all(root, \"counsel configured\")\n        git(root, \"push\", \"-q\", \"origin\", \"HEAD:main\")\n        env = {\"ATTAVO_FIXTURE_QUESTION\": \"which overlay wins?\",\n               \"ATTAVO_FIXTURE_COUNSEL_RESPONSE\": str(responses / f\"{verdict}.json\")}\n        passes_until(root, lambda: pushed(bare, \"build record for item 1 (build-01)\"), seconds=40, env=env)\n        assert latest_record(root, \"counsel\")[\"verdict\"] == verdict\n        for _ in range(3):\n            run_attavo(root, \"drive\", \"1\", env={**FAST, **env})\n            time.sleep(0.5)\n        if expect_attempt == 2:\n            passes_until(root, lambda: len(record_files(root, \"build\")) == 2, seconds=30, env={**env, \"ATTAVO_FIXTURE_QUESTION\": \"\"})\n            assert latest_record(root, \"build\")[\"steer\"] == \"counsel-01\"\n        else:\n            assert len(record_files(root, \"build\")) == 1, verdict\n            out = report(root)\n            assert out[\"state\"] == \"stopped\", out\n            if verdict == \"patch\":\n                assert \"waiting on\" in out[\"says\"], out[\"says\"]\n\n\n","exit_code":0,"status":"completed"}}

cts/attest/attavo/build.py:498:                refusal = f\\\"commit {foreign['sha']} not authored by the executor\\\"\\n/Users/davidbean/Projects/attest/attavo/build.py:501:            protected = protected_path_touched(root, start_sha, records_rel, specs_rel)\\n/Users/davidbean/Projects/attest/attavo/build.py:508:            touched = sorted(changed_paths(root, start_sha, records_rel))\\n/Users/davidbean/Projects/attest/attavo/build.py:587:        \\\"sha\\\": git(root, \\\"rev-parse\\\", \\\"HEAD\\\").strip(),\\n/Users/davidbean/Projects/attest/attavo/build.py:588:        \\\"start_sha\\\": start_sha,\\n/Users/davidbean/Projects/attest/attavo/build.py:610:        \\\"steer\\\": steer,\\n/Users/davidbean/Projects/attest/attavo/build.py:620:        # None for every class but unclassed/question/environment/gate);\\n/Users/davidbean/Projects/attest/attavo/counsel.py:27:# or names the one-line question a person must answer. ---\\n/Users/davidbean/Projects/attest/attavo/counsel.py:68:    over (issue #175): a question is not bound to a stop, so the pass\\n/Users/davidbean/Projects/attest/attavo/counsel.py:87:def counsel_forge_evidence(root: Path, forge_cfg: dict[str, Any], sha: str | None, tmp: Path\\n/Users/davidbean/Projects/attest/attavo/counsel.py:145:def counsel_graph_text(root: Path, m: dict[str, Any], item_id: str, sha: str | None,\\n/Users/davidbean/Projects/attest/attavo/counsel.py:154:    checkout, an unset refs/remotes/origin/HEAD) is noted in the text\\n/Users/davidbean/Projects/attest/attavo/counsel.py:160:        [\\\"git\\\", \\\"-C\\\", str(root), \\\"symbolic-ref\\\", \\\"-q\\\", \\\"refs/remotes/origin/HEAD\\\"],\\n/Users/davidbean/Projects/attest/attavo/counsel.py:166:            branch_point = git(root, \\\"merge-base\\\", default_ref, \\\"HEAD\\\").strip()\\n/Users/davidbean/Projects/attest/attavo/counsel.py:174:                    f\\\"{branch_point}..HEAD\\\").strip() or \\\"(no commits yet)\\\"))\\n/Users/davidbean/Projects/attest/attavo/counsel.py:178:        parts.append(\\\"## the default branch\\\\n\\\\n(refs/remotes/origin/HEAD is not set)\\\")\\n/Users/davidbean/Projects/attest/attavo/counsel.py:190:            recent = git(root, \\\"log\\\", \\\"--first-parent\\\", \\\"-3\\\", \\\"--format=%H\\\", \\\"HEAD\\\").split()\\n/Users/davidbean/Projects/attest/attavo/counsel.py:205:def cmd_counsel(argv: list[str]) -> int:\\n/Users/davidbean/Projects/attest/attavo/counsel.py:235:    # status -- a question is not bound to a stop -- everything else\\n/Users/davidbean/Projects/attest/attavo/counsel.py:317:    proposal = {\\\"ruling_text\\\": None, \\\"patch\\\": None, \\\"question\\\": None, \\\"issue\\\": None}\\n/Users/davidbean/Projects/attest/attavo/counsel.py:334:        \\\"sha\\\": git(root, \\\"rev-parse\\\", \\\"HEAD\\\").strip(),\\n/Users/davidbean/Projects/attest/attavo/counsel.py:353:        \\\"question\\\": ask,\\n\",\"exit_code\":2,\"status\":\"failed\"}}\n{\"type\":\"item.started\",\"item\":{\"id\":\"item_5\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"sed -n '1,220p' attest/rulings.md; sed -n '205,380p' /Users/davidbean/Projects/attest/attavo/counsel.py; sed -n '230,285p' /Users/davidbean/Projects/attest/attavo/stops.py; sed -n '450,535p' /Users/davidbean/Projects/attest/attavo/build.py; sed -n '1,140p' /Users/davidbean/Projects/attest/tests/test_counsel.py; rg -n \\\\\\\"question.*person|person.*question|definition of done|R3|steer|retry\\\\\\\" /Users/davidbean/Projects/attest/tests/test_counsel.py /Users/davidbean/Projects/attest/tests/test_stops.py /Users/davidbean/Projects/attest/tests/test_retry.py attest/rulings.md\\\"\",\"aggregated_output\":\"\",\"exit_code\":null,\"status\":\"in_progress\"}}\n{\"type\":\"item.completed\",\"item\":{\"id\":\"item_5\",\"type\":\"command_execution\",\"command\":\"/bin/zsh -lc \\\"sed -n '1,220p' attest/rulings.md; sed -n '205,380p' /Users/davidbean/Projects/attest/attavo/counsel.py; sed -n '230,285p' /Users/davidbean/Projects/attest/attavo/stops.py; sed -n '450,535p' /Users/davidbean/Projects/attest/attavo/build.py; sed -n '1,140p' /Users/davidbean/Projects/attest/tests/test_counsel.py; rg -n \\\\\\\"question.*person|person.*question|definition of done|R3|steer|retry\\\\\\\" /Users/davidbean/Projects/attest/tests/test_counsel.py /Users/davidbean/Projects/attest/tests/test_stops.py /Users/davidbean/Projects/attest/tests/test_retry.py attest/rulings.md\\\"\",\"aggregated_output\":\"# Rulings\\n\\nWritten by the merge of a proposed amendment only.\\ndef cmd_counsel(argv: list[str]) -> int:\\n    root = Path(\\\".\\\").resolve()\\n    ask: str | None = None\\n    positional: list[str] = []\\n    i = 0\\n    while i < len(argv):\\n        if argv[i] == \\\"--ask\\\":\\n            ask = argv[i + 1] if i + 1 < len(argv) else None\\n            i += 2\\n        else:\\n            positional.append(argv[i])\\n            i += 1\\n    item_id = positional[0] if positional else derive_item_id(root)\\n    if not item_id:\\n        print(\\\"attavo counsel: cannot derive item id; pass N or run on an attavo/N-* branch\\\",\\n              file=sys.stderr)\\n        return 2\\n    if ask is not None and not ask.strip():\\n        print(\\\"attavo counsel: --ask requires non-empty text\\\", file=sys.stderr)\\n        return 2\\n    m = read_manifest(root)\\n    if m is None:\\n        print(f\\\"attavo counsel: no {MANIFEST} at {root}\\\", file=sys.stderr)\\n        return 2\\n\\n    specs_rel = m[\\\"paths\\\"][\\\"specs\\\"]\\n    records_rel = m[\\\"paths\\\"][\\\"records\\\"]\\n    item_records_dir = root / records_rel / item_id\\n\\n    # issue #175: --ask reads the item's latest records regardless of\\n    # status -- a question is not bound to a stop -- everything else\\n    # about the evidence set and the write is shared with the stop path.\\n    if ask is not None:\\n        stage, stop_record, record_path = latest_stage_record(item_records_dir)\\n        no_record_msg = f\\\"no build, verify, or spec-gate record for item {item_id}\\\"\\n    else:\\n        stage, stop_record, record_path = latest_non_pass_stage_record(item_records_dir)\\n        no_record_msg = f\\\"no non-pass build, verify, or spec-gate record for item {item_id}\\\"\\n    if stop_record is None:\\n        print(f\\\"attavo counsel: refused: {no_record_msg}\\\")\\n        return 1\\n    # latest_*_stage_record returns all three of (stage, record, path) or none.\\n    stage, record_path = cast(str, stage), cast(Path, record_path)\\n\\n    executor = m.get(\\\"executor\\\") or {}\\n    adapter_name = executor.get(\\\"counsel\\\") or executor.get(\\\"verify\\\")\\n    if not adapter_name:\\n        print(\\\"attavo counsel: refused: no [executor].counsel or [executor].verify \\\"\\n              \\\"in the manifest\\\")\\n        return 1\\n    adapter_path = resolve_adapter(root, adapter_name)\\n    if adapter_path is None:\\n        print(f\\\"attavo counsel: refused: no adapter named {adapter_name!r}\\\")\\n        return 1\\n\\n    adapter_config = merge_adapter_config(m, adapter_name, \\\"counsel\\\")\\n    reports = adapter_reports(adapter_path)\\n    spec_dir = root / specs_rel / item_id\\n    log_path = record_path.with_suffix(\\\".log\\\")\\n\\n    diff_text, diff_refusal = diff_since_approval(root, stop_record.get(\\\"approval_sha\\\"))\\n    if diff_refusal:\\n        print(f\\\"attavo counsel: refused: {diff_refusal}\\\")\\n        return 1\\n\\n    forge_cfg = m.get(\\\"forge\\\") or {}\\n    stop_sha = stop_record.get(\\\"sha\\\")\\n\\n    started = time.monotonic()\\n\\n    with tempfile.TemporaryDirectory() as tmp:\\n        tmp_path = Path(tmp)\\n        diff_path = tmp_path / \\\"diff.patch\\\"\\n        diff_path.write_text(diff_text)\\n\\n        forge, checks_path = counsel_forge_evidence(root, forge_cfg, stop_sha, tmp_path)\\n\\n        graph_path = tmp_path / \\\"graph.txt\\\"\\n        graph_path.write_text(counsel_graph_text(\\n            root, m, item_id, stop_sha, forge_cfg.get(\\\"checks_command\\\")))\\n\\n        env = dict(os.environ)\\n        env[\\\"ATTAVO_SPEC_DIR\\\"] = str(spec_dir)\\n        env[\\\"ATTAVO_RECORDS_DIR\\\"] = str(item_records_dir)\\n        env[\\\"ATTAVO_RULINGS\\\"] = str(root / m[\\\"paths\\\"][\\\"rulings\\\"])\\n        env[\\\"ATTAVO_STAGE\\\"] = \\\"counsel\\\"\\n        env[\\\"ATTAVO_COUNSEL_RECORD\\\"] = str(record_path)\\n        env[\\\"ATTAVO_COUNSEL_LOG\\\"] = str(log_path) if log_path.is_file() else \\\"\\\"\\n        env[\\\"ATTAVO_COUNSEL_DIFF\\\"] = str(diff_path)\\n        env[\\\"ATTAVO_COUNSEL_CHECKS\\\"] = str(checks_path)\\n        env[\\\"ATTAVO_COUNSEL_GRAPH\\\"] = str(graph_path)\\n        env[\\\"ATTAVO_MANIFEST\\\"] = str(root / MANIFEST)\\n        env[\\\"ATTAVO_PRODUCT_ROOT\\\"] = str(PRODUCT_ROOT)\\n        env[\\\"ATTAVO_ADAPTER_CONFIG\\\"] = json.dumps(adapter_config)\\n        if ask is not None:\\n            env[\\\"ATTAVO_COUNSEL_QUESTION\\\"] = ask\\n\\n        run = subprocess.run([str(adapter_path)], cwd=str(root), env=env,\\n                             capture_output=True, text=True, check=False)\\n        transcript, payload = split_adapter_stdout(run.stdout)\\n        if run.returncode != 0:\\n            detail = f\\\"[adapter exited {run.returncode}]\\\"\\n            if run.stderr.strip():\\n                detail += \\\"\\\\n\\\" + run.stderr.rstrip(\\\"\\\\n\\\")\\n            transcript = (transcript + \\\"\\\\n\\\" if transcript else \\\"\\\") + detail\\n\\n    status_out = \\\"failed\\\"\\n    model = model_version = adapter_version_out = None\\n    tokens = {\\\"input\\\": 0, \\\"output\\\": 0}\\n    cost_usd = None\\n    cls = verdict = None\\n    citations: list[Any] = []\\n    proposal = {\\\"ruling_text\\\": None, \\\"patch\\\": None, \\\"question\\\": None, \\\"issue\\\": None}\\n\\n    if (run.returncode == 0 and payload is not None\\n            and payload.get(\\\"verdict\\\") in (\\\"answer\\\", \\\"patch\\\", \\\"person\\\")):\\n        status_out = \\\"done\\\"\\n        model = payload.get(\\\"model\\\")\\n        model_version = payload.get(\\\"model_version\\\")\\n        adapter_version_out = payload.get(\\\"adapter_version\\\")\\n        tok = payload.get(\\\"tokens\\\") or {}\\n        tokens = {\\\"input\\\": tok.get(\\\"input\\\", 0) or 0, \\\"output\\\": tok.get(\\\"output\\\", 0) or 0}\\n        cost_usd = payload.get(\\\"cost_usd\\\")\\n        cls = payload.get(\\\"class\\\")\\n        verdict = payload.get(\\\"verdict\\\")\\n        citations = payload.get(\\\"citations\\\") or []\\n        proposal = {**proposal, **(payload.get(\\\"proposal\\\") or {})}\\n\\n    record = {\\n        \\\"sha\\\": git(root, \\\"rev-parse\\\", \\\"HEAD\\\").strip(),\\n        \\\"record_stage\\\": stage,\\n        \\\"record\\\": record_path.stem,\\n        \\\"at\\\": now_iso(),\\n        \\\"adapter\\\": adapter_name,\\n        \\\"adapter_config\\\": adapter_config,\\n        \\\"adapter_version\\\": adapter_version_out,\\n        \\\"model\\\": model,\\n        \\\"model_version\\\": model_version,\\n        \\\"reports\\\": reports,\\n        \\\"tokens\\\": tokens,\\n        \\\"cost_usd\\\": cost_usd,\\n        \\\"wall_clock_s\\\": round(time.monotonic() - started, 3),\\n        \\\"status\\\": status_out,\\n        \\\"class\\\": cls,\\n        \\\"verdict\\\": verdict,\\n        \\\"citations\\\": citations,\\n        \\\"proposal\\\": proposal,\\n        \\\"forge\\\": forge,\\n        \\\"question\\\": ask,\\n    }\\n    record_out_path = write_record(item_records_dir, \\\"counsel\\\", record, m, item_id, log=transcript)\\n\\n    print(f\\\"attavo counsel: {status_out} ({record_out_path.name})\\\")\\n    return 0 if status_out == \\\"done\\\" else 1\\ndef item_stops(root: Path, m: dict[str, Any], item_id: str) -> dict[str, Any]:\\n    \\\"\\\"\\\"{\\\"item\\\", \\\"rows\\\", \\\"totals\\\"}: one row per non-pass build or verify\\n    record (STOP_STAGES), plus every refused spec-gate record (issue\\n    #133), class \\\"gate\\\" (issue #137) -- read from status and refusal\\n    rather than a stop field spec-gate records never carry (gate_stop\\n    synthesizes it) -- under item_id, whatever the record's own\\n    record_version -- a record too old to carry stop at all still gets\\n    a row, its class printed as the doctor's own phrase for it.\\n\\n    The answerer, a closed choice: \\\"counsel:<verdict>\\\" when\\n    counsel_record_for finds a counsel record naming this exact stage and\\n    number -- the product's own answer, which wins over whatever the stop\\n    itself says, since a counseled stop was already read once; failing\\n    that, \\\"person\\\" for class question (a person's to answer, not a\\n    guard's); failing that, \\\"guard\\\" for a class in GUARDED_STOP_CLASSES\\n    (a guard's own rejection needed no further reading); anything else\\n    -- no-cause, unclassed, or no stop at all -- is \\\"none\\\": nobody has\\n    answered it yet.\\\"\\\"\\\"\\n    records_rel = m[\\\"paths\\\"][\\\"records\\\"]\\n    item_records_dir = root / records_rel / item_id\\n    by_class = {c: 0 for c in stop_class_enum()}\\n    by_answerer: dict[str, int] = {}\\n    before_stop_was_recorded = 0\\n    rows: list[dict[str, Any]] = []\\n\\n    def add_row(stage: str, n: int, stop: Stop | None) -> None:\\n        nonlocal before_stop_was_recorded\\n        name = f\\\"{stage}-{n:02d}\\\"\\n        marker = item_records_dir / f\\\"{name}.filed\\\"\\n        filed_issue = marker.read_text() if marker.is_file() else None\\n        counsel = counsel_record_for(item_records_dir, stage, n)\\n\\n        if counsel is not None:\\n            answerer = f\\\"counsel:{counsel.get('verdict')}\\\"\\n        elif stop and stop.get(\\\"class\\\") == \\\"question\\\":\\n            answerer = \\\"person\\\"\\n        elif stop and stop.get(\\\"class\\\") in GUARDED_STOP_CLASSES:\\n            answerer = \\\"guard\\\"\\n        else:\\n            answerer = \\\"none\\\"\\n\\n        if stop:\\n            cls, provenance, detail = (stop.get(\\\"class\\\"), stop.get(\\\"provenance\\\"),\\n                                      stop.get(\\\"detail\\\"))\\n            if cls in by_class:\\n                by_class[cls] += 1\\n        else:\\n            cls, provenance, detail = \\\"before stop was recorded\\\", None, None\\n            before_stop_was_recorded += 1\\n\\n        by_answerer[answerer] = by_answerer.get(answerer, 0) + 1\\n        rows.append({\\\"item\\\": item_id, \\\"record\\\": name, \\\"class\\\": cls,\\n                    \\\"provenance\\\": provenance, \\\"detail\\\": detail,\\n                    \\\"answerer\\\": answerer, \\\"filed_issue\\\": filed_issue})\\n\\n    if item_records_dir.is_dir():\\n            env[\\\"ATTAVO_EVENTS\\\"] = str(events_path)\\n            env[\\\"ATTAVO_TEST_COMMAND\\\"] = f\\\"python3 {PRODUCT_ROOT / 'bin' / 'attavo'} test {item_id}\\\"\\n            if tests_cfg.get(\\\"call_timeout_s\\\"):\\n                env[\\\"ATTAVO_TEST_TIMEOUT_S\\\"] = str(tests_cfg[\\\"call_timeout_s\\\"])\\n            else:\\n                env.pop(\\\"ATTAVO_TEST_TIMEOUT_S\\\", None)\\n            env[\\\"GIT_AUTHOR_NAME\\\"] = identity[\\\"name\\\"]\\n            env[\\\"GIT_AUTHOR_EMAIL\\\"] = identity[\\\"email\\\"]\\n            env[\\\"GIT_COMMITTER_NAME\\\"] = identity[\\\"name\\\"]\\n            env[\\\"GIT_COMMITTER_EMAIL\\\"] = identity[\\\"email\\\"]\\n\\n            run = subprocess.run([str(adapter_path)], cwd=str(root), env=env,\\n                                 capture_output=True, text=True, check=False)\\n            transcript, payload = split_adapter_stdout(run.stdout)\\n            if run.returncode != 0:\\n                # The guarantee behind issue #53's refusal: an adapter that\\n                # exits non-zero always leaves a non-empty log, even one\\n                # that printed nothing at all on stderr.\\n                detail = f\\\"[adapter exited {run.returncode}]\\\"\\n                if run.stderr.strip():\\n                    detail += \\\"\\\\n\\\" + run.stderr.rstrip(\\\"\\\\n\\\")\\n                transcript = (transcript + \\\"\\\\n\\\" if transcript else \\\"\\\") + detail\\n            transcripts.append(transcript)\\n\\n            if run.returncode != 0 or payload is None or not payload.get(\\\"model\\\"):\\n                status_out = \\\"failed\\\"\\n                break\\n\\n            adapter_version = payload.get(\\\"adapter_version\\\")\\n            model = payload.get(\\\"model\\\")\\n            model_version = payload.get(\\\"model_version\\\")\\n            tok = payload.get(\\\"tokens\\\") or {}\\n            tokens[\\\"input\\\"] += tok.get(\\\"input\\\", 0) or 0\\n            tokens[\\\"output\\\"] += tok.get(\\\"output\\\", 0) or 0\\n            iter_cost = payload.get(\\\"cost_usd\\\")\\n            if iter_cost is not None:\\n                cost_usd = (cost_usd or 0) + iter_cost\\n\\n            if payload.get(\\\"status\\\") == \\\"question\\\":\\n                status_out = \\\"halted\\\"\\n                halted = {\\\"question\\\": payload.get(\\\"question\\\")}\\n                break\\n\\n            foreign = next((c for c in commits_since(root, start_sha)\\n                           if c[\\\"name\\\"] != identity[\\\"name\\\"] or c[\\\"email\\\"] != identity[\\\"email\\\"]),\\n                          None)\\n            if foreign:\\n                status_out = \\\"refused\\\"\\n                refusal = f\\\"commit {foreign['sha']} not authored by the executor\\\"\\n                break\\n\\n            protected = protected_path_touched(root, start_sha, records_rel, specs_rel)\\n            if protected:\\n                status_out = \\\"refused\\\"\\n                refusal = protected\\n                refusal_provenance = \\\"executor\\\"\\n                break\\n\\n            touched = sorted(changed_paths(root, start_sha, records_rel))\\n            bad_path = next((p for p in touched if not matches_a_claim(p, claims)), None)\\n            if bad_path:\\n                status_out = \\\"refused\\\"\\n                refusal = bad_path\\n                break\\n\\n            criteria_results = [\\n                {\\\"name\\\": name, \\\"exit\\\": run_criterion(spec_dir / \\\"criteria\\\" / name, root)}\\n                for name in criteria_names]\\n            for c in criteria_results:\\n                append_event(events_path, \\\"gate\\\", f\\\"{c['name']}: exit {c['exit']}\\\")\\n\\n            select_in = \\\"\\\".join(p + \\\"\\\\n\\\" for p in touched)\\n            select_run = subprocess.run(tests_cfg[\\\"select\\\"], shell=True, cwd=str(root),\\n                                        input=select_in, capture_output=True,\\n                                        text=True, check=False)\\n            identifiers = [l for l in select_run.stdout.splitlines() if l.strip()]\\n            run_in = \\\"\\\".join(i + \\\"\\\\n\\\" for i in identifiers)\\n            test_run = subprocess.run(tests_cfg[\\\"run\\\"], shell=True, cwd=str(root),\\n                                      input=run_in, capture_output=True,\\n                                      text=True, check=False)\\n            selected_tests = {\\\"select\\\": tests_cfg[\\\"select\\\"], \\\"run\\\": tests_cfg[\\\"run\\\"],\\n                              \\\"count\\\": len(identifiers), \\\"exit\\\": test_run.returncode}\\n\\n            checks_run = None\\n            if checks_command:\\n                checks_run = subprocess.run(checks_command, shell=True, cwd=str(root),\\n\\\"\\\"\\\"attavo counsel: a stop is read inside the product first, before a\\nperson (issue #100). A read-only invocation of the tenant's\\n[executor].counsel adapter (defaulting to [executor].verify) on the\\nitem's latest non-pass build or verify record -- it commits nothing and\\nwrites nothing outside paths.records/<N>/. Every test here uses the\\nfixture adapter, with a canned counsel response supplied through\\nATTAVO_FIXTURE_COUNSEL_RESPONSE where the verdict shape matters.\\n\\nRejection tests, written and run red first: on `main` before this issue\\nthere was no `counsel` subcommand, so every one of these failed with\\n\\\"unknown subcommand\\\".\\n\\nRun: python3 -m pytest tests -q\\n\\\"\\\"\\\"\\nimport json\\nimport subprocess\\nimport sys\\nfrom pathlib import Path\\nfrom typing import Any, cast\\n\\nimport jsonschema\\n\\nfrom helpers import FIXTURES, commit_all, make_tenant\\n\\nROOT = Path(__file__).resolve().parent.parent\\nATTAVO = ROOT / \\\"bin\\\" / \\\"attavo\\\"\\nCOUNSEL_SCHEMA = json.loads((ROOT / \\\"schema\\\" / \\\"records\\\" / \\\"counsel.schema.json\\\").read_text())\\n\\n\\ndef run_attavo(root: Path, *args: str, env: dict[str, Any] | None = None) -> subprocess.CompletedProcess[str]:\\n    import os\\n    full_env = dict(os.environ)\\n    if env:\\n        full_env.update(env)\\n    return subprocess.run([sys.executable, str(ATTAVO), *args], cwd=str(root),\\n                          capture_output=True, text=True, check=False, env=full_env)\\n\\n\\ndef write_probe_adapter(root: Path, name: str, script: str) -> None:\\n    \\\"\\\"\\\"A tenant-local adapter override under attavo/adapters/<name>/run\\n    (resolve_adapter's own tenant-first search, same pattern\\n    tests/test_verify.py's \\\"silent\\\"/\\\"loud\\\" adapters use) -- for a probe\\n    that inspects the evidence files counsel hands it. adapters/fixture/run\\n    is a shared fixture this lane's own files list does not include, so a\\n    probe that needs to see ATTAVO_COUNSEL_CHECKS or ATTAVO_COUNSEL_GRAPH\\n    lives here instead of there.\\\"\\\"\\\"\\n    adapter_dir = root / \\\"attavo\\\" / \\\"adapters\\\" / name\\n    adapter_dir.mkdir(parents=True)\\n    adapter_run = adapter_dir / \\\"run\\\"\\n    adapter_run.write_text(script)\\n    adapter_run.chmod(0o755)\\n\\n\\ndef use_counsel_adapter(root: Path, name: str) -> None:\\n    toml = root / \\\"attavo.toml\\\"\\n    toml.write_text(toml.read_text().replace(\\n        '[executor]\\\\nbuild = \\\"fixture\\\"', f'[executor]\\\\nbuild = \\\"fixture\\\"\\\\ncounsel = \\\"{name}\\\"'))\\n    commit_all(root, f\\\"use the {name} counsel adapter\\\")\\n\\n\\ndef configure_forge(root: Path, checks_command: str, check_log_command: str | None = None) -> None:\\n    text = (root / \\\"attavo.toml\\\").read_text() + f'\\\\n[forge]\\\\nchecks_command = \\\"{checks_command}\\\"\\\\n'\\n    if check_log_command is not None:\\n        text += f'check_log_command = \\\"{check_log_command}\\\"\\\\n'\\n    (root / \\\"attavo.toml\\\").write_text(text)\\n    commit_all(root, \\\"configure the forge read\\\")\\n\\n\\ndef configure_counsel_adapter(root: Path) -> None:\\n    \\\"\\\"\\\"[executor].counsel = \\\"fixture\\\" -- build_valid's own manifest\\n    declares [executor].build = \\\"fixture\\\" only; counsel needs its own\\n    adapter named, per the lane's own default ([executor].verify, absent\\n    here, so this is the only way build_valid gets a counsel adapter at\\n    all).\\\"\\\"\\\"\\n    toml = root / \\\"attavo.toml\\\"\\n    toml.write_text(toml.read_text().replace(\\n        '[executor]\\\\nbuild = \\\"fixture\\\"', '[executor]\\\\nbuild = \\\"fixture\\\"\\\\ncounsel = \\\"fixture\\\"'))\\n    commit_all(root, \\\"configure the counsel adapter\\\")\\n\\n\\ndef records_dir(root: Path, item: str = \\\"1\\\") -> Path:\\n    return root / \\\"records\\\" / item\\n\\n\\ndef approve_and_halt(root: Path, question: str = \\\"which overlay wins?\\\") -> None:\\n    assert run_attavo(root, \\\"spec-gate\\\", \\\"1\\\").returncode == 0\\n    assert run_attavo(root, \\\"approve\\\", \\\"1\\\", \\\"--by\\\", \\\"alice\\\").returncode == 0\\n    build = run_attavo(root, \\\"build\\\", \\\"1\\\", env={\\\"ATTAVO_FIXTURE_QUESTION\\\": question})\\n    assert build.returncode == 3, build.stdout + build.stderr\\n\\n\\ndef write_counsel_response(tmp_path: Path, response: dict[str, Any]) -> Path:\\n    path = tmp_path / \\\"counsel_response.json\\\"\\n    path.write_text(json.dumps(response))\\n    return path\\n\\n\\ndef canned(verdict: str, **kwargs: Any) -> dict[str, Any]:\\n    base: dict[str, Any] = {\\n        \\\"model\\\": \\\"fixture\\\", \\\"model_version\\\": None, \\\"adapter_version\\\": \\\"fixture-1\\\",\\n        \\\"tokens\\\": {\\\"input\\\": 1, \\\"output\\\": 1}, \\\"cost_usd\\\": 0.0,\\n        \\\"class\\\": \\\"unclassed\\\", \\\"verdict\\\": verdict,\\n        \\\"citations\\\": [], \\\"proposal\\\": {\\\"ruling_text\\\": None, \\\"patch\\\": None, \\\"question\\\": None},\\n    }\\n    base.update(kwargs)\\n    return base\\n\\n\\ndef test_counsel_refuses_without_a_non_pass_record(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Acceptance row 2 (half). A fresh item with no build, verify, or\\n    spec-gate record at all -- refused by name, nothing written.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    configure_counsel_adapter(root)\\n\\n    run = run_attavo(root, \\\"counsel\\\", \\\"1\\\")\\n    assert run.returncode == 1\\n    assert \\\"no non-pass build, verify, or spec-gate record\\\" in run.stdout\\n    assert not records_dir(root).exists() or list(records_dir(root).glob(\\\"counsel-*.json\\\")) == []\\n\\n\\ndef test_counsel_refuses_when_the_latest_record_is_a_pass(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Acceptance row 2 (rest). A passing build -- and the passing spec-01\\n    it rests on -- carries nothing to counsel -- refused the same as an\\n    item with no record at all: the spec-gate fallback only ever reads a\\n    refused spec record, never a passing one.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    configure_counsel_adapter(root)\\n    assert run_attavo(root, \\\"spec-gate\\\", \\\"1\\\").returncode == 0\\n    assert run_attavo(root, \\\"approve\\\", \\\"1\\\", \\\"--by\\\", \\\"alice\\\").returncode == 0\\n    assert run_attavo(root, \\\"build\\\", \\\"1\\\").returncode == 0\\n\\n    run = run_attavo(root, \\\"counsel\\\", \\\"1\\\")\\n    assert run.returncode == 1\\n    assert \\\"no non-pass build, verify, or spec-gate record\\\" in run.stdout\\n\\n\\ndef test_counsel_answers_a_refused_spec_gate_record_when_no_build_or_verify_exists(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Acceptance row 1. No build or verify record exists at all -- the\\n    item never got approved -- but a refused spec-01.json does (issue\\n    #133's own specimen, tenant zero #683: a criterion the gate cannot\\n/Users/davidbean/Projects/attest/tests/test_counsel.py:241:def test_counsel_person_verdict_carries_a_one_line_question(tmp_path: Path) -> None:\\n/Users/davidbean/Projects/attest/tests/test_counsel.py:602:    \\\"retry\\\"), which this lane retires.\\\"\\\"\\\"\\n/Users/davidbean/Projects/attest/tests/test_counsel.py:634:def assert_158_citation_and_no_retry(record: dict[str, Any]) -> None:\\n/Users/davidbean/Projects/attest/tests/test_counsel.py:641:    assert \\\"retry\\\" not in (record[\\\"proposal\\\"][\\\"ruling_text\\\"] or \\\"\\\").lower()\\n/Users/davidbean/Projects/attest/tests/test_counsel.py:644:def test_counsel_158_specimen_cites_the_marker_not_retry_with_claude_code(tmp_path: Path) -> None:\\n/Users/davidbean/Projects/attest/tests/test_counsel.py:646:    \\\"retry only after the forge exposes concluded, green checks for that\\n/Users/davidbean/Projects/attest/tests/test_counsel.py:650:    retry could ever be green. With the checks and the log now in the\\n/Users/davidbean/Projects/attest/tests/test_counsel.py:669:    assert_158_citation_and_no_retry(record)\\n/Users/davidbean/Projects/attest/tests/test_counsel.py:672:def test_counsel_158_specimen_cites_the_marker_not_retry_with_codex(tmp_path: Path) -> None:\\n/Users/davidbean/Projects/attest/tests/test_counsel.py:695:    assert_158_citation_and_no_retry(record)\\n/Users/davidbean/Projects/attest/tests/test_retry.py:1:\\\"\\\"\\\"The reconciler's R3 (claude/reconciler-brief-2026-09-20.md ruling C and\\n/Users/davidbean/Projects/attest/tests/test_retry.py:3:reason that does not touch the definition of done is started again by a\\n/Users/davidbean/Projects/attest/tests/test_retry.py:4:pass, not a person. Four retryable families (died, hung, transient,\\n/Users/davidbean/Projects/attest/tests/test_retry.py:12:(R2 as merged) and against R3's thin stub.\\n/Users/davidbean/Projects/attest/tests/test_retry.py:44:                  '\\\"detail\\\":\\\"API error: overloaded, retry after 30s\\\",\\\"model\\\":\\\"fixture\\\",'\\n/Users/davidbean/Projects/attest/tests/test_retry.py:49:def add_drive_table(root: Path, *, attempts: int = 3, retry_after_s: int = 0,\\n/Users/davidbean/Projects/attest/tests/test_retry.py:55:        f\\\"retry_after_s = {retry_after_s}\\\\n\\\\n[drive.build]\\\\nceiling_s = {build_ceiling_s}\\\\n\\\\n\\\"\\n/Users/davidbean/Projects/attest/tests/test_retry.py:124:    waits [drive].retry_after_s first (#194's verify-01 paid for a\\n/Users/davidbean/Projects/attest/tests/test_retry.py:128:    root, bare = approved_tenant(tmp_path, prelude, retry_after_s=3)\\n/Users/davidbean/Projects/attest/tests/test_retry.py:132:    assert stop_of(root, \\\"build\\\", 1)[\\\"signature\\\"] == \\\"API error: overloaded, retry after s\\\"\\n/Users/davidbean/Projects/attest/tests/test_retry.py:136:    assert early.returncode == 0 and \\\"retrying\\\" in early.stdout.lower(), early.stdout\\n/Users/davidbean/Projects/attest/tests/test_retry.py:141:    assert rec[\\\"status\\\"] == \\\"pass\\\" and rec[\\\"retry_of\\\"] == \\\"build-01\\\", rec\\n/Users/davidbean/Projects/attest/tests/test_retry.py:145:def test_died_and_hung_retry_on_the_next_pass(tmp_path: Path) -> None:\\n/Users/davidbean/Projects/attest/tests/test_retry.py:157:    assert rec[\\\"status\\\"] == \\\"pass\\\" and rec[\\\"retry_of\\\"] == \\\"build-01\\\", rec\\n/Users/davidbean/Projects/attest/tests/test_retry.py:193:    assert latest_record(root, \\\"build\\
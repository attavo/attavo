 \\\\\\\"proposal\\\\\\\": {\\\\n    \\\\\\\"ruling_text\\\\\\\": null,\\\\n    \\\\\\\"patch\\\\\\\": {\\\\n      \\\\\\\"file\\\\\\\": \\\\\\\"/Users/davidbean/Projects/attest/attavo/counsel.py\\\\\\\",\\\\n      \\\\\\\"symbol\\\\\\\": \\\\\\\"cmd_counsel\\\\\\\",\\\\n      \\\\\\\"rejection_test\\\\\\\": \\\\\\\"Create build-01.started without build-01.json, invoke `attavo counsel 1`, and assert exit 1 names the in-progress build, invokes no adapter, and writes no counsel record. Add build-01.json and assert counsel can then proceed normally.\\\\\\\",\\\\n      \\\\\\\"diff\\\\\\\": \\\\\\\"diff --git a/attavo/counsel.py b/attavo/counsel.py\\\\\\\\n--- a/attavo/counsel.py\\\\\\\\n+++ b/attavo/counsel.py\\\\\\\\n@@ -232,6 +232,18 @@ def cmd_counsel(argv: list[str]) -> int:\\\\\\\\n     records_rel = m[\\\\\\\\\\\\\\\"paths\\\\\\\\\\\\\\\"][\\\\\\\\\\\\\\\"records\\\\\\\\\\\\\\\"]\\\\\\\\n     item_records_dir = root / records_rel / item_id\\\\\\\\n \\\\\\\\n+    # A started marker without its corresponding record is an invocation\\\\\\\\n+    # still in progress. Counseling an older stop while that invocation is\\\\\\\\n+    # running can add a driver-authored record commit to the build's range;\\\\\\\\n+    # build must then correctly refuse that foreign commit. Wait for the\\\\\\\\n+    # stage to finish instead of manufacturing that collision.\\\\\\\\n+    in_progress = next(\\\\\\\\n+        (marker for stage in (\\\\\\\\\\\\\\\"build\\\\\\\\\\\\\\\", \\\\\\\\\\\\\\\"verify\\\\\\\\\\\\\\\")\\\\\\\\n+         for marker in sorted(item_records_dir.glob(f\\\\\\\\\\\\\\\"{stage}-*.started\\\\\\\\\\\\\\\"))\\\\\\\\n+         if not marker.with_suffix(\\\\\\\\\\\\\\\".json\\\\\\\\\\\\\\\").exists()),\\\\\\\\n+        None,\\\\\\\\n+    )\\\\\\\\n+    if in_progress is not None:\\\\\\\\n+        print(f\\\\\\\\\\\\\\\"attavo counsel: refused: {in_progress.stem} is still in progress\\\\\\\\\\\\\\\")\\\\\\\\n+        return 1\\\\\\\\n+\\\\\\\\n     # issue #175: --ask
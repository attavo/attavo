t_sha\": retry_start_sha,\n+         \"approval_sha\": approval_sha}))\n+    (records / \"verify-01.json\").write_text(json.dumps({\"status\": \"pass\"}))\n+    commit_all(root, \"spec, approval, build, and verify records\")\n+    subprocess.run([\"git\", \"-C\", str(root), \"checkout\", \"-q\", \"main\"], check=True)\n+    subprocess.run([\"git\", \"-C\", str(root), \"merge\", \"-q\", \"--no-ff\", \"-m\",\n+                    \"Merge branch 'attavo/1-x'\", \"attavo/1-x\"], check=True)\n+    p = run_doctor(root)[\"no-attested-item-is-empty\"]\n+    assert p[\"holds\"], p[\"reason\"]\n+    assert p[\"built\"] == [\"1\"], p\n+\n+\n+def test_doctor_proof_seven_names_a_build_with_no_readable_approval_as_not_read(tmp_path: Path) -> None:\n+    \"\"\"Item 229: a build record whose approval_sha does not resolve in this\n+    repository is counted as not readable, not failed -- an unprovable\n+    build is not asserted empty.\"\"\"\n+    root = tmp_path / \"unreadable_item\"\n+    root.mkdir()\n+    (root / \"attavo.toml\").write_text('[paths]\\nrecords = \"records\"\\n')\n+    init_repo(root, \"install\")\n+    subprocess.run([\"git\", \"-C\", str(root), \"checkout\", \"-q\", \"-b\", \"attavo/1-x\"], check=True)\n+    build_sha = _head(root)\n+    records = root / \"records\" / \"1\"\n+    records.mkdir(parents=True)\n+    (records / \"spec-01.json\").write_text(json.dumps({\"status\": \"pass\"}))\n+    (records / \"approval-01.json\").write_text(json.dumps({\"approved_by\": \"alice\"}))\n+    (records / \"build-01.json\").write_text(json.dumps(\n+        {\"status\": \"pass\", \"sha\": build_sha, \"start_sha\": build_sha, \"approval_sha\": \"f\" * 40}))\n+    (records / \"verify-01.json\").write_text(json.dumps({\"status\": \"pass\"}))\n+    commit_all(root, \"spec, approval, build, and verify records\")\n+    subprocess.run([\"git\", \"-C\", str(root), \"checkout\", \"-q\", \"main\"], check=True)\n+    subprocess.run([\"git\", \"-C\", str(root), \"merge\", \"-q\", \"--no-ff\", \"-m\",\n+                    \"Merge branch 'attavo/1-x'\", \"attavo/1-x\"], check=True)\n+    p = run_doctor(root)[\"no-attested-item-is-empty\"]\n+    assert p[\"holds\"], p[\"reason\"]\n+    assert p[\"not_read\"] == [\"1\"], p\n+\n+\n def test_no_attested_item_is_empty() -> None:\n     \"\"\"Proof 7, item 227. On this repository the specimen, #227, is named\n     before the window ([doctor].built_since) and every later attested\nfrom __future__ import annotations\n\nimport os\nimport re\nimport subprocess\nimport tomllib\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom typing import Any\n\nMANIFEST = \"attavo.toml\"\n\nSTAGES = (\"spec\", \"approval\", \"build\", \"verify\")\n\n\nPRODUCT_ROOT = Path(__file__).resolve().parent.parent\n\n\nclass Proof:\n    def __init__(self, key: str, title: str) -> None:\n        self.key = key\n        self.title = title\n        self.holds = False\n        self.reason = \"\"\n        self.extra: dict[str, Any] = {}\n\n    def fail(self, reason: str, **extra: Any) -> \"Proof\":\n        self.holds, self.reason = False, reason\n        self.extra.update(extra)\n        return self\n\n    def hold(self, reason: str, **extra: Any) -> \"Proof\":\n        self.holds, self.reason = True, reason\n        self.extra.update(extra)\n        return self\n\n    def as_dict(self) -> dict[str, Any]:\n        return {\"proof\": self.key, \"title\": self.title,\n                \"holds\": self.holds, \"reason\": self.reason, **self.extra}\n\n\ndef read_manifest(root: Path) -> dict[str, Any] | None:\n    path = root / MANIFEST\n    if not path.is_file():\n        return None\n    with path.open(\"rb\") as fh:\n        return tomllib.load(fh)\n\n\ndef git(root: Path, *args: str, env: dict[str, str] | None = None) -> str:\n    out = subprocess.run([\"git\", \"-C\", str(root), *args],\n                         capture_output=True, text=True, check=False, env=env)\n    if out.returncode != 0:\n        raise RuntimeError(out.stderr.strip() or \"git failed\")\n    return out.stdout\n\n\ndef product_version() -> str:\n    \"\"\"What the running program is. Three fallbacks, in order, and never an\n    exception -- this runs inside write_record, after the work it\n    describes already happened, and a raise here would lose the record\n    for an invocation that already ran:\n\n      1. ATTAVO_PRODUCT_VERSION, when the environment sets it. The forge\n         action sets this from its own ref (action.yml, not here -- this\n         function stays forge-agnostic).\n      2. git describe --tags --always --dirty against PRODUCT_ROOT: a\n         tagged release reports its tag, a checkout reports its commit,\n         a dirty tree says so.\n      3. \"unknown\", when PRODUCT_ROOT is not a git repository at all --\n         the case for a forge that extracts this action from a tarball\n         rather than a git checkout, which is exactly when (1) is\n         expected to already have supplied the answer.\n\n    Distinct from the tenant's product_pin -- an operator running a\n    checkout, which is how every build and verify have actually been run\n    so far, bypasses the pin entirely (issue #49).\"\"\"\n    env = os.environ.get(\"ATTAVO_PRODUCT_VERSION\")\n    if env:\n        return env\n    try:\n        return git(PRODUCT_ROOT, \"describe\", \"--tags\", \"--always\", \"--dirty\").strip()\n    except RuntimeError:\n        return \"unknown\"\n\n\ndef now_iso() -> str:\n    return datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n\n\ndef derive_item_id(root: Path) -> str | None:\n    \"\"\"ATTAVO_ITEM first, not last: a rejection fixture's own item id must\n    win over whatever attavo/N-* branch the enclosing tenant repository\n    happens to be checked out on -- the common case is doctor running from\n    a real item's own branch, where a fallback-only env var would never be\n    consulted at all and every gate fixture would silently resolve to the\n    real item instead of its own.\"\"\"\n    env_item = os.environ.get(\"ATTAVO_ITEM\")\n    if env_item:\n        return env_item\n    out = subprocess.run([\"git\", \"-C\", str(root), \"rev-parse\", \"--abbrev-ref\", \"HEAD\"],\n                         capture_output=True, text=True, check=False)\n    branch = out.stdout.strip()\n    m = re.match(r\"^attavo/(\\d+)-\", branch)\n    return m.group(1) if m else None\n\n\ndef fixture_item_id(fixture: Path) -> str | None:\n    \"\"\"The one item id under a rejection fixture's own paths.specs, so the\n    doctor can export it as ATTAVO_ITEM: a fixture carries no attavo/N-*\n    branch for a gate command with no argument to derive from otherwise.\"\"\"\n    fm = read_manifest(fixture)\n    specs_rel = ((fm or {}).get(\"paths\") or {}).get(\"specs\")\n    if not specs_rel:\n        return None\n    specs_dir = fixture / specs_rel\n    if not specs_dir.is_dir():\n        return None\n    items = sorted(p.name for p in specs_dir.iterdir() if p.is_dir())\n    return items[0] if len(items) == 1 else None\n\n\nclass ShallowCheckoutError(RuntimeError):\n    pass\n\n\ndef last_commit_touching(root: Path, relpath: str) -> str | None:\n    shallow = subprocess.run([\"git\", \"-C\", str(root), \"rev-parse\", \"--is-shallow-repository\"],\n                             capture_output=True, text=True, check=False)\n    if shallow.stdout.strip() == \"true\":\n        raise ShallowCheckoutError(\n            \"shallow checkout: git log -1 -- <path> returns HEAD for every path on a \"\n            \"shallow clone; check out with fetch-depth: 0\")\n    out = subprocess.run([\"git\", \"-C\", str(root), \"log\", \"-1\", \"--format=%H\", \"--\", relpath],\n                         capture_output=True, text=True, check=False)\n    sha = out.stdout.strip()\n    return sha or None\n        retry_of, steer, seed = _retry_seed(root, m, item_records_dir)\n        if seed:\n            feedback_path.write_text(seed)\n\n        for iteration in range(1, BUILD_ITERATION_BUDGET + 1):\n            iterations_used = iteration\n            append_event(events_path, \"iteration\", f\"iteration {iteration} of {BUILD_ITERATION_BUDGET}\")\n            env = dict(os.environ)\n            # #212 retired the checks command reaching the executor; an\n            # ATTAVO_CHECKS_COMMAND exported by whoever launched `attavo\n            # build` must not reach it by inheritance either.\n            env.pop(\"ATTAVO_CHECKS_COMMAND\", None)\n            env[\"ATTAVO_SPEC_DIR\"] = str(spec_dir)\n            env[\"ATTAVO_RECORDS_DIR\"] = str(item_records_dir)\n            env[\"ATTAVO_RULINGS\"] = str(root / m[\"paths\"][\"rulings\"])\n            env[\"ATTAVO_BRANCH\"] = branch\n            env[\"ATTAVO_ITERATION\"] = str(iteration)\n            env[\"ATTAVO_FEEDBACK\"] = str(feedback_path)\n            env[\"ATTAVO_ADAPTER_CONFIG\"] = json.dumps(adapter_config)\n            env[\"ATTAVO_STAGE\"] = \"build\"\n            env[\"ATTAVO_EVENTS\"] = str(events_path)\n            env[\"ATTAVO_TEST_COMMAND\"] = f\"python3 {PRODUCT_ROOT / 'bin' / 'attavo'} test {item_id}\"\n            if tests_cfg.get(\"call_timeout_s\"):\n                env[\"ATTAVO_TEST_TIMEOUT_S\"] = str(tests_cfg[\"call_timeout_s\"])\n            else:\n                env.pop(\"ATTAVO_TEST_TIMEOUT_S\", None)\n            env[\"GIT_AUTHOR_NAME\"] = identity[\"name\"]\n            env[\"GIT_AUTHOR_EMAIL\"] = identity[\"email\"]\n            env[\"GIT_COMMITTER_NAME\"] = identity[\"name\"]\n            env[\"GIT_COMMITTER_EMAIL\"] = identity[\"email\"]\n\n            run = subprocess.run([str(adapter_path)], cwd=str(root), env=env,\n                                 capture_output=True, text=True, check=False)\n            transcript, payload = split_adapter_stdout(run.stdout)\n            if run.returncode != 0:\n                # The guarantee behind issue #53's refusal: an adapter that\n                # exits non-zero always leaves a non-empty log, even one\n                # that printed nothing at all on stderr.\n                detail = f\"[adapter exited {run.returncode}]\"\n                if run.stderr.strip():\n                    detail += \"\\n\" + run.stderr.rstrip(\"\\n\")\n                transcript = (transcript + \"\\n\" if transcript else \"\") + detail\n            transcripts.append(transcript)\n\n            if run.returncode != 0 or payload is None or not payload.get(\"model\"):\n                status_out = \"failed\"\n                break\n\n            adapter_version = payload.get(\"adapter_version\")\n            model = payload.get(\"model\")\n            model_version = payload.get(\"model_version\")\n            tok = payload.get(\"tokens\") or {}\n            tokens[\"input\"] += tok.get(\"input\", 0) or 0\n            tokens[\"output\"] += tok.get(\"output\", 0) or 0\n            iter_cost = payload.get(\"cost_usd\")\n            if iter_cost is not None:\n                cost_usd = (cost_usd or 0) + iter_cost\n\n            if payload.get(\"status\") == \"question\":\n                status_out = \"halted\"\n                halted = {\"question\": payload.get(\"question\")}\n                break\n\n            foreign = next((c for c in commits_since(root, start_sha)\n                           if c[\"name\"] != identity[\"name\"] or c[\"email\"] != identity[\"email\"]),\n                          None)\n            if foreign:\n                status_out = \"refused\"\n                refusal = f\"commit {foreign['sha']} not authored by the executor\"\n                break\n\n            protected = protected_path_touched(root, start_sha, records_rel, specs_rel)\n            if protected:\n                status_out = \"refused\"\n                refusal = protected\n                refusal_provenance = \"executor\"\n                break\n\n            touched = sorted(changed_paths(root, start_sha, records_rel))\n            bad_path = next((p for p in touched if not matches_a_claim(p, claims)), None)\n            if bad_path:\n                status_out = \"refused\"\n                refusal = bad_path\n                break\n\n            criteria_results = [\n                {\"name\": name, \"exit\": run_criterion(spec_dir / \"criteria\" / name, root)}\n                for name in criteria_names]\n            for c in criteria_results:\n                append_event(events_path, \"gate\", f\"{c['name']}: exit {c['exit']}\")\n\n            select_in = \"\".join(p + \"\\n\" for p in touched)\n            select_run = subprocess.run(tests_cfg[\"select\"], shell=True, cwd=str(root),\n                                        input=select_in, capture_output=True,\n                                        text=True, check=False)\n            identifiers = [l for l in select_run.stdout.splitlines() if l.strip()]\n            run_in = \"\".join(i + \"\\n\" for i in identifiers)\n            test_run = subprocess.run(tests_cfg[\"run\"], shell=True, cwd=str(root),\n                                      input=run_in, capture_output=True,\n                                      text=True, check=False)\n            selected_tests = {\"select\": tests_cfg[\"select\"], \"run\": tests_cfg[\"run\"],\n                              \"count\": len(identifiers), \"exit\": test_run.returncode}\n\n            checks_run = None\n            if checks_command:\n                checks_run = subprocess.run(checks_command, shell=True, cwd=str(root),\n                                            capture_output=True, text=True, check=False)\n                checks_result = {\"command\": checks_command, \"exit\": checks_run.returncode}\n\n            # Issue #89, rejection test 1: the gate output that decides pass\n            # or fail is appended to the build log itself, under a heading\n            # per iteration, before this temporary directory goes away --\n            # tenant zero's #576 build-11 and #659 build-01 are a failed\n            # record with nothing beside it to say what was red, because\n            # this output previously lived only in feedback.txt, in a\n            # tempfile.TemporaryDirectory() cmd_build deletes on return.\n            gate_lines = [f\"criterion {c['name']}: exit {c['exit']}\" for c in criteria_results]\n            gate_lines.append(f\"selected tests ({selected_tests['count']}): exit \"\n                              f\"{selected_tests['exit']}\")\n            if test_run.stdout.strip():\n                gate_lines += [\"--- selected tests stdout ---\", test_run.stdout.rstrip(\"\\n\")]\n            if test_run.stderr.strip():\n                gate_lines += [\"--- selected tests stderr ---\", test_run.stderr.rstrip(\"\\n\")]\n            if checks_run is not None:\n                tail = (checks_run.stdout.splitlines() + checks_run.stderr.splitlines())\n                tail = tail[-CHECKS_FEEDBACK_TAIL_LINES:]\n                gate_lines.append(f\"tenant checks: exit {checks_run.returncode}\")\n                gate_lines += [\"--- checks output (tail) ---\", *tail]\n            transcripts[-1] += (f\"\\n--- attavo gates, iteration {iteration} ---\\n\"\n                               + \"\\n\".join(gate_lines))\n\n            failing = [c for c in criteria_results if c[\"exit\"] != 0]\n            checks_ok = checks_run is None or checks_run.returncode == 0\n            if not failing and test_run.returncode == 0 and checks_ok:\n                status_out = \"pass\"\n                break\n\n            if iteration == BUILD_ITERATION_BUDGET:\n                status_out = \"failed\"\n                break\n\n            feedback_lines = []\n            if failing:\n                feedback_lines.append(\"criteria failing:\")\n                feedback_lines += [f\"- {c['name']}: exit {c['exit']}\" for c in failing]\n            if test_run.returncode != 0:\n                feedback_lines += [f\"test run exit {test_run.returncode}\",\n                                   \"--- stdout ---\", test_run.stdout,\n                                   \"--- stderr ---\", test_run.stderr]\n            if checks_run is not None and checks_run.returncode != 0:\n                tail = (checks_run.stdout.splitlines() + checks_run.stderr.splitlines())\n                tail = tail[-CHECKS_FEEDBACK_TAIL_LINES:]\n                feedback_lines += [f\"checks exit {checks_run.returncode}\",\n                                   \"--- checks output (tail) ---\", *tail]\n            feedback_path.write_text(\"\\n\".join(feedback_lines) + \"\\n\")\n\n    record = {\n        \"sha\": git(root, \"rev-parse\", \"HEAD\").strip(),\n        \"start_sha\": start_sha,\n        \"spec_sha\": spec_sha,\n        \"approval_sha\": latest_approval.get(\"sha\") if latest_approval else None,\n        \"at\": now_iso(),\n        \"adapter\": adapter_name,\n        \"adapter_config\": adapter_config,\n        \"executor_identity\": identity,\n        \"reports\": reports,\n        \"adapter_version\": adapter_version,\n        \"model\": model,\n        \"model_version\": model_version,\n        \"iterations\": iterations_used,\n        \"criteria\": criteria_results,\n        \"selected_tests\": selected_tests,\n        \"checks\": checks_result,\n        \"tokens\": tokens,\n        \"cost_usd\": cost_usd,\n        \"wall_clock_s\": round(time.monotonic() - started, 3),\n        \"status\": status_out,\n        \"refusal\": refusal,\n        \"halted\": halted,\n        \"retry_of\": retry_of,\n        \"steer\": steer,\n        \"stop\": derive_stop(status_out, refusal=refusal, halted=halted,\n                            log=\"\\n\".join(transcripts),\n                            report_class=(payload or {}).get(\"class\"),\n                            refusal_provenance=refusal_provenance),\n    }\n    if record[\"stop\"] is not None:\n        stop_out: dict[str, Any] = record[\"stop\"]\n        # R3: transient's own signature is the adapter's stop detail\n        # (payload.get(\"detail\")), not derive_stop's detail (which is\n        # None for every class but unclassed/question/environment/gate);\n        # every other non-pass class signs off its own detail (None for\n        # most, so signature is None too -- the class alone, or the log\n        # itself for unclassed, is the specimen's own cause).\n        stop_detail: str | None = ((payload or {}).get(\"detail\") if stop_out[\"class\"] == \"transient\"\n                                   else stop_out.get(\"detail\"))\n        record[\"stop\"] = {**stop_out, \"detail\": stop_detail, \"signature\": signature_of(stop_detail),\n                          \"bound\": None}\n    record_path = write_record(item_records_dir, \"build\", record, m, item_id,\n                               log=\"\\n\".join(transcripts))\n\n    print(f\"attavo build: {status_out} ({record_path.name})\")\n    if status_out == \"halted\":\n        return BUILD_HALT_EXIT\n    return 0 if status_out == \"pass\" else 1\n# Rulings\n\nWritten by the merge of a proposed amendment only.\n","exit_code":0,"status":"completed"}}

{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/zsh -lc \"rg -n \\\"build_is_empty\\\" attavo tests\nsed -n '85,135p' attavo/common.py\nsed -n '1,110p' attavo/verify.py\nsed -n '820,900p' attavo/doctor.py\nrg -n -C 3 '\\\"refusal\\\":\\\"attavo/common.py\\\"|attavo/common.py|claims-boundary' attest/records/229/build-03.log | tail -n 80\nsed -n '1,220p' attest/records/229/counsel-04.json 2>/dev/null || true\nsed -n '1,220p' attest/records/229/counsel-04.log 2>/dev/null || true\"","aggregated_output":"attavo/doctor.py:16:    build_is_empty,\nattavo/doctor.py:897:        is_empty = build_is_empty(root, approval_sha, sha, claims)\nattavo/common.py:91:def build_is_empty(root: Path, approval_sha: str, sha: str, claims: list[str]) -> bool | None:\nattavo/verify.py:19:from attavo.common import MANIFEST, build_is_empty, derive_item_id, git, now_iso, read_manifest\nattavo/verify.py:218:    empty = (build_is_empty(root, build_approval_sha, build_sha, claims)\nattavo/build.py:21:    build_is_empty,\nattavo/build.py:554:            build_empty = build_is_empty(root, approval_sha, current_sha, claims)\n\n\ndef now_iso() -> str:\n    return datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n\n\ndef build_is_empty(root: Path, approval_sha: str, sha: str, claims: list[str]) -> bool | None:\n    \"\"\"True when sha's tree, restricted to the paths the spec claims, is\n    identical to approval_sha's tree there: no path the spec claims has\n    changed since approval (item 227's own build). Compared against the\n    approval, not a particular attempt's start_sha (item 229), so a\n    retried attempt whose head already carries a prior attempt's valid\n    commits owes no commit of its own; an attempt that ends on the\n    approved tree, whatever it left in the working directory, is empty\n    regardless of how it got there. Scoped to claims rather than\n    \"everything outside paths.records\", so a commit that lands between\n    approval and this attempt's start but touches no claimed path --\n    a tenant installing an adapter, say -- never rescues or defeats the\n    comparison on its own account; every commit an executor's own loop\n    ever lands is already confined to claims (build.py's own boundary\n    check), so a real prior attempt's work is always visible here. None\n    when either commit does not resolve in this repository -- not\n    known, not asserted.\"\"\"\n    for commit in (approval_sha, sha):\n        resolved = subprocess.run([\"git\", \"-C\", str(root), \"cat-file\", \"-e\", f\"{commit}^{{commit}}\"],\n                                  capture_output=True, text=True, check=False)\n        if resolved.returncode != 0:\n            return None\n    pathspec = claims if claims else [\".\"]\n    out = subprocess.run([\"git\", \"-C\", str(root), \"diff\", \"--quiet\", approval_sha, sha,\n                          \"--\", *pathspec], capture_output=True, text=True, check=False)\n    if out.returncode not in (0, 1):\n        return None\n    return out.returncode == 0\n\n\ndef derive_item_id(root: Path) -> str | None:\n    \"\"\"ATTAVO_ITEM first, not last: a rejection fixture's own item id must\n    win over whatever attavo/N-* branch the enclosing tenant repository\n    happens to be checked out on -- the common case is doctor running from\n    a real item's own branch, where a fallback-only env var would never be\n    consulted at all and every gate fixture would silently resolve to the\n    real item instead of its own.\"\"\"\n    env_item = os.environ.get(\"ATTAVO_ITEM\")\n    if env_item:\n        return env_item\n    out = subprocess.run([\"git\", \"-C\", str(root), \"rev-parse\", \"--abbrev-ref\", \"HEAD\"],\n                         capture_output=True, text=True, check=False)\n    branch = out.stdout.strip()\n    m = re.match(r\"^attavo/(\\d+)-\", branch)\n    return m.group(1) if m else None\nfrom __future__ import annotations\n\nimport json\nimport os\nimport shlex\nimport subprocess\nimport sys\nimport tempfile\nimport time\nfrom pathlib import Path\nfrom typing import Any, cast\n\nfrom attavo.build import (\n    adapter_reports,\n    merge_adapter_config,\n    resolve_adapter,\n    split_adapter_stdout,\n)\nfrom attavo.common import MANIFEST, build_is_empty, derive_item_id, git, now_iso, read_manifest\nfrom attavo.events import stage_events_dir\nfrom attavo.records import (\n    latest_attempt_path,\n    latest_record,\n    next_attempt_number,\n    parse_attempts,\n    write_record,\n)\nfrom attavo.spec import parse_spec\nfrom attavo.stops import counsel_record_for, derive_stop, signature_of\n\n# --- verify: the forge's own read first, a judge only once it is green ---\n\nFORGE_OK_CONCLUSIONS = {\"success\", \"neutral\", \"skipped\"}\n\n# issue #84: a concluded check's second token is a conclusion --\n# FORGE_OK_CONCLUSIONS, or another concluded one such as failure,\n# cancelled, or timed_out; an unconcluded check's is a status instead,\n# one of these. drive's own poll (poll_forge_checks) is the one reader\n# that needs to tell a still-running check apart from a concluded, not-ok\n# one -- read_forge_checks itself only ever needed \"green or not\".\nFORGE_UNCONCLUDED_STATUSES = {\"queued\", \"in_progress\", \"pending\", \"waiting\"}\n\n\ndef read_forge_checks(root: Path, checks_command: str, sha: str) -> tuple[dict[str, Any], bool]:\n    \"\"\"Runs the tenant's [forge].checks_command on sha; the product does\n    not know what forge that command reads. One line per check as\n    \"<name> <conclusion>\"; a command that fails to run, or any conclusion\n    other than success/neutral/skipped, is not green.\"\"\"\n    run = subprocess.run(f\"{checks_command} {shlex.quote(sha)}\", shell=True, cwd=str(root),\n                         capture_output=True, text=True, check=False)\n    conclusions: list[dict[str, str]] = []\n    for line in run.stdout.splitlines():\n        line = line.strip()\n        if not line:\n            continue\n        parts = line.rsplit(\" \", 1)\n        if len(parts) == 2:\n            conclusions.append({\"name\": parts[0], \"conclusion\": parts[1]})\n    # A commit the forge has no record of is not green -- it is unread.\n    # The executor's own commit is exactly this: the forge attaches\n    # checks to a pull request's head, and that commit stops being the\n    # head the moment a record commit lands on top of it. all() over an\n    # empty list is True, which is why this is spelled out rather than\n    # implied by the loop above.\n    ok = run.returncode == 0 and bool(conclusions) and all(\n        c[\"conclusion\"] in FORGE_OK_CONCLUSIONS for c in conclusions)\n    return {\"command\": checks_command, \"sha\": sha, \"conclusions\": conclusions}, ok\n\n\ndef diff_since_approval(root: Path, approval_sha: str | None) -> tuple[str, str | None]:\n    \"\"\"(diff_text, refusal): the item's own work since approval, not\n    everything merged onto the branch since then (issue #52) -- a\n    three-dot diff against approval_sha itself is not enough, since\n    approval_sha is already an ancestor of HEAD in the normal flow and\n    merge-base(approval_sha, HEAD) is just approval_sha again (verified\n    empirically, see issue #52). Diffing from the merge-base of HEAD and\n    the remote's default branch instead excludes content that arrived by\n    merging that branch in, because that content is already present on\n    both sides of the merge base. refs/remotes/origin/HEAD is what names\n    the default branch without hard-coding \"main\"; when it is not set,\n    there is nothing to diff against and this refuses rather than guess.\n    (\"\", None) when approval_sha is falsy -- nothing to diff from at all.\n    Shared by cmd_verify and cmd_counsel, which both hand an adapter this\n    same diff.\"\"\"\n    if not approval_sha:\n        return \"\", None\n    symref = subprocess.run(\n        [\"git\", \"-C\", str(root), \"symbolic-ref\", \"-q\", \"refs/remotes/origin/HEAD\"],\n        capture_output=True, text=True, check=False)\n    if symref.returncode != 0:\n        return \"\", \"refs/remotes/origin/HEAD is not set; run `git remote set-head origin -a`\"\n    diff_base = git(root, \"merge-base\", symref.stdout.strip(), \"HEAD\").strip()\n    return git(root, \"diff\", diff_base, \"HEAD\"), None\n\n\ndef stub_ratio(diff_text: str, stub_dir: Path, excluded: tuple[str, ...]) -> float | None:\n    \"\"\"The share of the lines diff_text adds that are a line of the stub's\n    file at the same path: near 1 the build shipped the spec author's stub,\n    near 0 the builder wrote the change. Lines under the excluded\n    directories (the specs and records, where the stub itself and the\n    item's records are committed) and blank lines are not counted. None\n    when there is no stub or the diff adds no counted line -- nothing was\n    measured, which is not 0.0.\"\"\"\n    if not stub_dir.is_dir():\n        return None\n    skipped = tuple(e.strip(\"/\") for e in excluded)\n    stub_lines: dict[str, set[str]] = {}\n    path: str | None = None\n    in_hunk = False\n    added = shipped = 0\n                      unsealed=unsealed, not_merged=not_merged, not_read=not_read)\n    window = f\" at {since[:12]}\" if before_window else \"\"\n    return p.hold(f\"{len(sealed)} sealed, {len(before_window)} before the window{window}, \"\n                 f\"{len(not_merged)} not merged\",\n                 sealed=sealed, before_window=before_window, unsealed=unsealed,\n                 not_merged=not_merged, not_read=not_read)\n\n\ndef proof_no_attested_item_is_empty(root: Path, m: dict[str, Any] | None) -> Proof:\n    \"\"\"Proof seven (item 227). Every merged, fully-staged item's passing\n    build names a change: its tree, restricted to the item's own spec\n    claims, differs from the approved tree there (item 229 -- asked\n    against the approval, not the build's own start_sha, so a build\n    that adopted a prior attempt's valid commits is not empty just\n    because that attempt owed no commit of its own; scoped to claims,\n    not \"everything outside paths.records\", so a commit that lands\n    between approval and a later attempt's start but touches no\n    claimed path never rescues or defeats the comparison on its own\n    account). Item 227 was specified, approved, built by one\n    invocation, judged by another, merged and sealed, and its build\n    committed nothing -- the executor left the stub in the working tree,\n    the gate read the tree, and main received the spec and none of the\n    change. Six proofs held over it.\n\n    [doctor].built_since: merges at or before this commit are before the\n    window -- named, never failed -- so the specimen stands on every\n    doctor run without failing the tenant forever. Absent, the window is\n    proof three's. A build record whose approval cannot be resolved\n    (no approval_sha at all, or one this repository cannot read) is\n    named as not readable, not failed.\"\"\"\n    p = Proof(\"no-attested-item-is-empty\", \"every attested item's build names a change\")\n    if m is None:\n        return p.fail(f\"no {MANIFEST} at {root}; no records directory is declared\")\n    records_rel = m.get(\"paths\", {}).get(\"records\", \"\")\n    specs_rel = m.get(\"paths\", {}).get(\"specs\", \"\")\n    records_dir = root / records_rel\n    if not records_dir.is_dir():\n        return p.fail(f\"no records directory under {records_dir}\")\n    items = load_records(records_dir)\n    complete = [item for item, stages in sorted(items.items()) if all(s in stages for s in STAGES)]\n    since = (m.get(\"doctor\") or {}).get(\"built_since\")\n    if not (isinstance(since, str) and since.strip()):\n        try:\n            since = proof_window_start(root, m)[1]\n        except WindowRefused as exc:\n            return p.fail(str(exc))\n    else:\n        try:\n            since = git(root, \"rev-parse\", \"--verify\", f\"{since}^{{commit}}\").strip()\n        except RuntimeError:\n            return p.fail(f\"[doctor] built_since {since} does not resolve to a commit\")\n    merges, refusal = _merges_reachable(root)\n    if refusal:\n        return p.fail(refusal)\n    built: list[str] = []\n    before_window: list[str] = []\n    not_merged: list[str] = []\n    not_read: list[str] = []\n    empty: list[str] = []\n    for item in complete:\n        merge_sha, _ = merge_introducing_records(root, records_rel, item, STAGES, merges=merges)\n        if merge_sha is None:\n            not_merged.append(item)\n            continue\n        if _is_ancestor(root, merge_sha, since):\n            before_window.append(item)\n            continue\n        build = items[item][\"build\"]\n        sha, approval_sha = build.get(\"sha\"), build.get(\"approval_sha\")\n        if not sha or not approval_sha:\n            not_read.append(item)\n            continue\n        spec_md = root / specs_rel / item / \"spec.md\"\n        claims: list[str] = []\n        if spec_md.is_file():\n            parsed, _ = parse_spec(spec_md)\n            claims = parsed[\"claims\"] if parsed else []\n        is_empty = build_is_empty(root, approval_sha, sha, claims)\n        if is_empty is None:\n            not_read.append(item)\n        elif is_empty:\n120-{\"type\":\"system\",\"subtype\":\"thinking_tokens\",\"estimated_tokens\":150,\"estimated_tokens_delta\":100,\"session_id\":\"ec2614fd-fe76-497e-a0f4-348a6650b419\",\"uuid\":\"f6623000-0bda-4411-9de6-07171e804e50\"}\n121-{\"type\":\"system\",\"subtype\":\"thinking_tokens\",\"estimated_tokens\":258,\"estimated_tokens_delta\":108,\"session_id\":\"ec2614fd-fe76-497e-a0f4-348a6650b419\",\"uuid\":\"6c031022-1f1e-40f3-8aed-3b7189a33ca9\"}\n--\n240-{\"type\":\"system\",\"subtype\":\"thinking_tokens\",\"estimated_tokens\":191,\"estimated_tokens_delta\":141,\"session_id\":\"ec2614fd-fe76-497e-a0f4-348a6650b419\",\"uuid\":\"6b1ba75d-16d7-4f10-8737-f948ad3fe949\"}\n241-{\"type\":\"assistant\",\"message\":{\"model\"
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01FQv9eTmE5hHwmQTVcHmxv6","type":"tool_result","content":"1\t\"\"\"bin/attavo --help and its unknown-subcommand message name every\n2\tsubcommand that exists, and the product itself names no vendor. Issue\n3\t#54, acceptance 10 and 11.\n4\t\n5\tRun: python3 -m pytest tests -q\n6\t\"\"\"\n7\timport subprocess\n8\timport sys\n9\tfrom pathlib import Path\n10\t\n11\tROOT = Path(__file__).resolve().parent.parent\n12\tATTAVO = ROOT / \"bin\" / \"attavo\"\n13\t\n14\t\n15\tdef test_help_lists_attest_and_record_only() -> None:\n16\t    run = subprocess.run([sys.executable, str(ATTAVO), \"--help\"],\n17\t                         capture_output=True, text=True, check=False)\n18\t    assert run.returncode == 0\n19\t    assert \"attavo record-only\" in run.stdout\n20\t    assert \"attavo attest\" in run.stdout\n21\t\n22\t\n23\tdef test_help_and_the_unknown_subcommand_message_name_test() -> None:\n24\t    \"\"\"Issue #212: attavo test is the executor's one test command.\"\"\"\n25\t    run = subprocess.run([sys.executable, str(ATTAVO), \"--help\"],\n26\t                         capture_output=True, text=True, check=False)\n27\t    assert run.returncode == 0\n28\t    assert \"attavo test [N]\" in run.stdout\n29\t    unknown = subprocess.run([sys.executable, str(ATTAVO), \"not-a-real-subcommand\"],\n30\t                             capture_output=True, text=True, check=False)\n31\t    assert \"stops, test exist\" in unknown.stderr\n32\t\n33\t\n34\tdef test_help_names_all_four_doctor_proofs() -> None:\n35\t    \"\"\"Issue #94, acceptance row 5: the doctor's own help text names all\n36\t    four proofs, no-stop-lacks-cause included -- a proof the help text\n37\t    forgets is one a reader would never know to expect from doctor: done.\"\"\"\n38\t    run = subprocess.run([sys.executable, str(ATTAVO), \"--help\"],\n39\t                         capture_output=True, text=True, check=False)\n40\t    assert run.returncode == 0\n41\t    assert \"every-gate-rejects\" in run.stdout\n42\t    assert \"one-item-every-stage\" in run.stdout\n43\t    assert \"no-commit-lacks-record\" in run.stdout\n44\t    assert \"no-stop-lacks-cause\" in run.stdout\n45\t"}]},"parent_tool_use_id":null,"session_id":"f10e7365-697a-4187-94d0-b7fffbb7e98c","uuid":"b80ec55c-c33c-442d-a676-124375ebb6d3","timestamp":"2026-09-27T14:37:18.103Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-229/tests/test_cli_help.py","content":"\"\"\"bin/attavo --help and its unknown-subcommand message name every\nsubcommand that exists, and the product itself names no vendor. Issue\n#54, acceptance 10 and 11.\n\nRun: python3 -m pytest tests -q\n\"\"\"\nimport subprocess\nimport sys\nfrom pathlib import Path\n\nROOT = Path(__file__).resolve().parent.parent\nATTAVO = ROOT / \"bin\" / \"attavo\"\n\n\ndef test_help_lists_attest_and_record_only() -> None:\n    run = subprocess.run([sys.executable, str(ATTAVO), \"--help\"],\n                         capture_output=True, text=True, check=False)\n    assert run.returncode == 0\n    assert \"attavo record-only\" in run.stdout\n    assert \"attavo attest\" in run.stdout\n\n\ndef test_help_and_the_unknown_subcommand_message_name_test() -> None:\n    \"\"\"Issue #212: attavo test is the executor's one test command.\"\"\"\n    run = subprocess.run([sys.executable, str(ATTAVO), \"--help\"],\n                         capture_output=True, text=True, check=False)\n    assert run.returncode == 0\n    assert \"attavo test [N]\" in run.stdout\n    unknown = subprocess.run([sys.executable, str(ATTAVO), \"not-a-real-subcommand\"],\n                             capture_output=True, text=True, check=False)\n    assert \"stops, test exist\" in unknown.stderr\n\n\ndef test_help_names_all_four_doctor_proofs() -> None:\n    \"\"\"Issue #94, acceptance row 5: the doctor's own help text names all\n    four proofs, no-stop-lacks-cause included -- a proof the help text\n    forgets is one a reader would never know to expect from doctor: done.\"\"\"\n    run = subprocess.run([sys.executable, str(ATTAVO), \"--help\"],\n                         capture_output=True, text=True, check=False)\n    assert run.returncode == 0\n    assert \"every-gate-rejects\" in run.stdout\n    assert \"one-item-every-stage\" in run.stdout\n    assert \"no-commit-lacks-record\" in run.stdout\n    assert \"no-stop-lacks-cause\" in run.stdout\n","numLines":45,"startLine":1,"totalLines":87}}}

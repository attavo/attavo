   if not command:\\n87\\t        return None, \\\"not read: no [forge].issues_command\\\"\\n88\\t    code, out, err, timed_out = run_bounded(command, root, \\\"\\\", TIMEOUT_S)\\n89\\t    if timed_out:\\n90\\t        return None, f\\\"not read: [forge].issues_command ran past {TIMEOUT_S}s\\\"\\n91\\t    if code != 0:\\n92\\t        last = (err.strip().splitlines() or [\\\"\\\"])[-1]\\n93\\t        return None, f\\\"not read: [forge].issues_command exited {code}\\\" + (f\\\": {last}\\\" if last else \\\"\\\")\\n94\\t    try:\\n95\\t        raw = json.loads(out)\\n96\\t    except json.JSONDecodeError as e:\\n97\\t        return None, f\\\"not read: [forge].issues_command printed no JSON ({e.msg})\\\"\\n98\\t    bad = _shape_error(raw)\\n99\\t    if bad:\\n100\\t        return None, f\\\"not read: [forge].issues_command: {bad}\\\"\\n101\\t    issues: list[Issue] = [{\\\"number\\\": x[\\\"number\\\"], \\\"title\\\": x[\\\"title\\\"], \\\"state\\\": x[\\\"state\\\"],\\n102\\t                            \\\"closed_at\\\": x.get(\\\"closed_at\\\"), \\\"labels\\\": list(x.get(\\\"labels\\\", [])),\\n103\\t                            \\\"claims\\\": parse_claims(x.get(\\\"body\\\", \\\"\\\") or \\\"\\\")} for x in raw]\\n104\\t    return sorted(issues, key=lambda i: i[\\\"number\\\"]), None\\n105\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"f2e0c4f7-36d4-465e-a2fe-27db257201e7\",\"uuid\":\"2c19dd7a-39b5-4c8e-bee2-96e9ed7379ad\",\"timestamp\":\"2026-09-30T01:01:15.585Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/davidbean/Projects/attavo-worktree-267/attest/specs/267/stub/attavo/issues.py\",\"content\":\"\\\"\\\"\\\"The tenant's issues, read through [forge].issues_command.\\n\\nThe issue is the unit of work (ruled 2026-09-29): the plan in the store\\n(attavo/plan.py) orders issues, and the forge holds what the plan does\\nnot -- each issue's title, whether it is open, when it closed, its\\nlabels, and, before it has a spec, the paths it claims in a \\\"## Claims\\\"\\nsection of its body. The product names no vendor: the tenant's command\\nprints the issues as JSON, one object per issue, and this module reads\\nit. The claims are parsed here, not by the tenant's command, so every\\ntenant's issues are read by one rule.\\n\\nA read that cannot be made is \\\"not read\\\" with its reason, never an empty\\nlist: no command in the manifest, a command that exits non-zero or runs\\npast its bound, or output that is not the shape below.\\n\\n    [{\\\"number\\\": 264, \\\"title\\\": \\\"...\\\", \\\"state\\\": \\\"open\\\" | \\\"closed\\\",\\n      \\\"closed_at\\\": \\\"<iso>\\\" | null, \\\"labels\\\": [\\\"...\\\"], \\\"body\\\": \\\"...\\\"}]\\n\\\"\\\"\\\"\\nfrom __future__ import annotations\\n\\nimport json\\nfrom pathlib import Path\\nfrom typing import Any, TypedDict\\n\\nfrom attavo.testtool import run_bounded\\n\\nTIMEOUT_S = 60\\nSTATES = (\\\"open\\\", \\\"closed\\\")\\n\\n\\nclass Issue(TypedDict):\\n    number: int\\n    title: str\\n    state: str\\n    closed_at: str | None\\n    labels: list[str]\\n    claims: list[str] | None\\n\\n\\ndef parse_claims(body: str) -> list[str] | None:\\n    \\\"\\\"\\\"The paths under a \\\"## Claims\\\" heading, up to the next \\\"## \\\"\\n    heading: one \\\"- path\\\" line each. None when the body has no Claims\\n    section, which is not the same as a section that lists nothing.\\\"\\\"\\\"\\n    lines = body.splitlines()\\n    starts = [i for i, line in enumerate(lines) if line.rstrip() == \\\"## Claims\\\"]\\n    if not starts:\\n        return None\\n    claims = []\\n    for line in lines[starts[0] + 1:]:\\n        if line.startswith(\\\"## \\\"):\\n            break\\n        s = line.strip()\\n        if s.startswith(\\\"- \\\"):\\n            path = s[2:].strip().strip(\\\"`\\\")\\n            if path:\\n                claims.append(path)\\n    return claims\\n\\n\\ndef _shape_error(raw: Any) -> str | None:\\n    if not isinstance(raw, list):\\n        return \\\"the output is not a list\\\"\\n    for i, x in enumerate(raw):\\n        if not isinstance(x, dict):\\n            return f\\\"entry {i} is not an object\\\"\\n        n = x.get(\\\"number\\\")\\n        if not isinstance(n, int) or isinstance(n, bool) or n < 1:\\n            return f\\\"entry {i} has no issue number\\\"\\n        if not isinstance(x.get(\\\"title\\\"), str):\\n            return f\\\"#{n} has no title\\\"\\n        if x.get(\\\"state\\\") not in STATES:\\n            return f\\\"#{n} has state {x.get('state')!r}, not open or closed\\\"\\n        if x.get(\\\"closed_at\\\") is not None and not isinstance(x.get(\\\"closed_at\\\"), str):\\n            return f\\\"#{n} has a closed_at that is not text\\\"\\n        labels = x.get(\\\"labels\\\", [])\\n        if not isinstance(labels, list) or not all(isinstance(lb, str) for lb in labels):\\n            return f\\\"#{n} has labels that are not a list of names\\\"\\n        if not isinstance(x.get(\\\"body\\\", \\\"\\\"), str):\\n            return f\\\"#{n} has a body that is not text\\\"\\n    return None\\n\\n\\ndef read_issues(root: Path, m: dict[str, Any]) -> tuple[list[Issue] | None, str | None]:\\n    \\\"\\\"\\\"(issues, None), or (None, \\\"not read: <why>\\\").\\\"\\\"\\\"\\n    command = (m.get(\\\"forge\\\") or {}).get(\\\"issues_command\\\")\\n    if not command:\\n        return None, \\\"not read: no [forge].issues_command\\\"\\n    code, out, err, timed_out = run_bounded(command, root, \\\"\\\", TIMEOUT_S)\\n    if timed_out:\\n        return None, f\\\"not read: [forge].issues_command ran past {TIMEOUT_S}s\\\"\\n    if code != 0:\\n        last = (err.strip().splitlines() or [\\\"\\\"])[-1]\\n        return None, f\\\"not read: [forge].issues_command exited {code}\\\" + (f\\\": {last}\\\" if last else \\\"\\\")\\n    try:\\n        raw = json.loads(out)\\n    except json.JSONDecodeError as e:\\n        return None, f\\\"not read: [forge].issues_command printed no JSON ({e.msg})\\\"\\n    bad = _shape_error(raw)\\n    if bad:\\n        return None, f\\\"not read: [forge].issues_command: {bad}\\\"\\n    issues: list[Issue] = [{\\\"number\\\": x[\\\"number\\\"], \\\"title\\\": x[\\\"title\\\"], \\\"state\\\": x[\\\"state\\\"],\\n                            \\\"closed_at\\\": x.get(\\\"closed_at\\\"), \\\"labels\\\": list(x.get(\\\"labels\\\", [])),\\n                            \\\"claims\\\": parse_claims(x.get(\\\"body\\\", \\\"\\\") or \\\"\\\")} for x in raw]\\n    return sorted(issues, key=lambda i: i[\\\"number\\\"]), None\\n\",\"numLines\":105,\"startLine\":1,\"totalLines\":105}}}\n{\"type\":\"assistant\",\"message\":{\"model\":\"claude-sonnet-5\",\"id\":\"msg_011CfYijwJDxhyUE25chaJjw\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_01HUsSwWbgeWs8sQW9knYA85\",\"name\":\"Read\",\"input\":{\"file_path\":\"/Users/davidbean/Projects/attavo-worktree-267/attest/specs/267/stub/.attavo/bin/forge-issues\"},\"caller\":{\"type\":\"direct\"}}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":386,\"cache_read_input_tokens\":35102,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":386},\"output_tokens\":3,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"f2e0c4f7-36d4-465e-a2fe-27db257201e7\",\"uuid\":\"abee4d09-5812-483b-b47b-43a87e0d10af\",\"timestamp\":\"2026-09-30T01:01:16.114Z\",\"request_id\":\"req_011CfYijvxczuDCjVmp7VZUQ\",\"wire_tool_inputs\":{\"toolu_01HUsSwWbgeWs8sQW9knYA85\":{\"file_path\":\"/Users/davidbean/Projects/attavo-worktree-267/attest/specs/267/stub/.attavo/bin/forge-issues\"}}}\n{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01HUsSwWbgeWs8sQW9knYA85\",\"type\":\"tool_result\",\"content\":\"1\\t#!/usr/bin/env python3\\n2\\t\\\"\\\"\\\"forge-issues: [forge].issues_command for this repository.\\n3\\t\\n4\\tPrints every issue in this repository, open and closed, as one JSON list\\n5\\tof {number, title, state, closed_at, labels, body}, the shape\\n6\\tschema/manifest.schema.json names for [forge].issues_command. The\\n7\\tproduct parses each body's \\\"## Claims\\\" section itself; this script only\\n8\\ttranslates the forge's words (\\\"OPEN\\\", label objects) into that shape.\\n9\\t\\n10\\tExits non-zero, printing nothing to stdout, when the forge cannot be\\n11\\tread: the product reads that as \\\"not read\\\", never as no issues.\\n12\\t\\n13\\tUsage: forge-issues\\n14\\tRequires: `gh`, authenticated, run inside this repository's checkout.\\n15\\t\\\"\\\"\\\"\\n16\\tfrom __future__ import annotations\\n17\\t\\n18\\timport json\\n19\\timport subprocess\\n20\\timport sys\\n21\\t\\n22\\tLIMIT = 2000\\n23\\t\\n24\\t\\n25\\tdef main() -> int:\\n26\\t    run = subprocess.run(\\n27\\t        [\\\"gh\\\", \\\"issue\\\", \\\"list\\\", \\\"--state\\\", \\\"all\\\", \\\"--limit\\\", str(LIMIT),\\n28\\t         \\\"--json\\\", \\\"number,title,state,closedAt,labels,body\\\"],\\n29\\t        capture_output=True, text=True, timeout=50, check=False,\\n30\\t    )\\n31\\t    if run.returncode != 0:\\n32\\t        print(run.stderr.strip() or \\\"forge-issues: gh issue list failed\\\", file=sys.stderr)\\n33\\t        return 1\\n34\\t    try:\\n35\\t        raw = json.loads(run.stdout)\\n36\\t    except json.JSONDecodeError:\\n37\\t        print(\\\"forge-issues: gh printed no JSON\\\", file=sys.stderr)\\n38\\t        return 1\\n39\\t    if len(raw) >= LIMIT:\\n40\\t        print(f\\\"forge-issues: {LIMIT} issues or more; the list would be cut short\\\", file=sys.stderr)\\n41\\t        return 1\\n42\\t    out = [{\\\"number\\\": i[\\\"number\\\"], \\\"title\\\": i[\\\"title\\\"], \\\"state\\\": str(i[\\\"state\\\"]).lower(),\\n43\\t            \\\"closed_at\\\": i.get(\\\"closedAt\\\") or None,\\n44\\t            \\\"labels\\\": [lb[\\\"name\\\"] for lb in i.get(\\\"labels\\\") or []],\\n45\\t            \\\"body\\\": i.get(\\\"body\\\") or \\\"\\\"} for i in raw]\\n46\\t    print(json.dumps(out))\\n47\\t    return 0\\n48\\t\\n49\\t\\n50\\tif __name__ == \\\"__main__\\\":\\n51\\t    sys.exit(main())\\n52\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"f2e0c4f7-36d4-465e-a2fe-27db257201e7\",\"uuid\":\"e9b8879d-81e1-4501-9f0c-24545b936700\",\"timestamp\":\"2026-09-30T01:01:16.130Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/davidbean/Projects/attavo-worktree-267/attest/specs/267/stub/.attavo/bin/forge-issues\",\"content\":\"#!/usr/bin/env python3\\n\\\"\\\"\\\"forge-issues: [forge].issues_command for this repository.\\n\\nPrints every issue in this repository, open and closed, as one JSON list\\nof {number, title, state, closed_at, labels, body}, the shape\\nschema/manifest.schema.json names for [forge].issues_command. The\\nproduct parses each body's \\\"## Claims\\\" section itself; this script only\\ntranslates the forge's words (\\\"OPEN\\\", label objects) into that shape.\\n\\nExits non-zero, printing nothing to stdout, when the forge cannot be\\nread: the product reads that as \\\"not read\\\", never as no issues.\\n\\nUsage: forge-issues\\nRequires: `gh`, authenticated, run inside this repository's checkout.\\n\\\"\\\"\\\"\\nfrom __future__ import annotations\\n\\nimport json\\nimport subprocess\\nimport sys\\n\\nLIMIT = 2000\\n\\n\\ndef main() -> int:\\n    run = subprocess.run(\\n        [\\\"gh\\\", \\\"issue\\\", \\\"list\\\", \\\"--state\\\", \\\"all\\\", \\\"--limit\\\", str(LIMIT),\\n         \\\"--json\\\", \\\"number,title,state,closedAt,labels,body\\\"],\\n        capture_output=True, text=True, timeout=50, check=False,\\n    )\\n    if run.returncode != 0:\\n        print(run.stderr.strip() or \\\"forge-issues: gh issue list failed\\\", file=sys.stderr)\\n        return 1\\n    try:\\n        raw = json.loads(run.stdout)\\n    except json.JSONDecodeError:\\n        print(\\\"forge-issues: gh printed no JSON\\\", file=sys.stderr)\\n        return 1\\n    if len(raw) >= LIMIT:\\n        print(f\\\"forge-issues: {LIMIT} issues or more; the list would be cut short\\\", file=sys.stderr)\\n        return 1\\n    out = [{\\\"number\\\": i[\\\"number\\\"], \\\"title\\\": i[\\\"title\\\"], \\\"state\\\": str(i[\\\"state\\\"]).lower(),\\n            \\\"closed_at\\\": i.get(\\\"closedAt\\\") or None,\\n            \\\"labels\\\": [lb[\\\"name\\\"] for lb in i.get(\\\"labels\\\") or []],\\n            \\\"body\\\": i.get(\\\"body\\\") or \\\"\\\"} for i in raw]\\n    print(json.dumps(out))\\n    return 0\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    sys.exit(main())\\n\",\"numLines\":52,\"startLine\":1,\"totalLines\":52}}}\n{\"type\":\"assistant\",\"message\":{\"model\":\"claude-sonnet-5\",\"id\":\"msg_011CfYijwJDxhyUE25chaJjw\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_015JQsqXsj12Qj2RQKX7okuF\",\"name\":\"Read\",\"input\":{\"file_path\":\"/Users/davidbean/Projects/attavo-worktree-267/attest/specs/267/stub/.attavo/bin/select-tests\"},\"caller\":{\"type\":\"direct\"}}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":386,\"cache_read_input_tokens\":35102,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":386},\"output_tokens\":3,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"f2e0c4f7-36d4-465e-a2fe-27db257201e7\",\"uuid\":\"7c2630de-86ee-480c-979a-52cc7a01be25\",\"timestamp\":\"2026-09-30T01:01:16.610Z\",\"request_id\":\"req_011CfYijvxczuDCjVmp7VZUQ\",\"wire_tool_inputs\":{\"toolu_015JQsqXsj12Qj2RQKX7okuF\":{\"file_path\":\"/Users/davidbean/Projects/attavo-worktree-267/attest/specs/267/stub/.attavo/bin/select-tests\"}}}\n{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_015JQsqXsj12Qj2RQKX7okuF\",\"type\":\"tool_result\",\"content\":\"1\\t#!/usr/bin/env python3\\n2\\t\\\"\\\"\\\"select-tests: [tests].select for attavo build/verify/test (issue #103,\\n3\\tmade fail-safe by issue #212).\\n4\\t\\n5\\tReads changed paths on stdin, one per line, and prints test identifiers\\n6\\ton stdout, one per line, for this repository's own test suite:\\n7\\t\\n8\\t  - prose (*.md, LICENSE) and this repository's own specs and records\\n9\\t    (attest/specs/**, attest/records/**) select nothing;\\n10\\t  - a test file (tests/test_*.py) selects itself, and the whole suite\\n11\\t    when it no longer exists -- a deletion cannot select itself, and the\\n12\\t    fail-safe rule below applies to it rather than exempting it (issue\\n13\\t    #212's review);\\n14\\t  - a path in MODULE_TESTS (a module of attavo/, and the few files that\\n15\\t    are one thing's own) selects the tests written for it, and a prefix in\\n16\\t    PREFIX_TESTS (adapters/, schema/, templates/) the tests written for\\n17\\t    that directory;\\n18\\t  - a path this selector does not know -- a module nobody mapped,\\n19\\t    bin/attavo, scripts/, tests/helpers.py and the fixtures every test\\n20\\t    stands on, the fixture adapter every build test invokes -- selects the\\n21\\t    whole suite (\\\"tests\\\", the one path pytest needs to run everything),\\n22\\t    and one such path is enough to make that the whole answer.\\n23\\t\\n24\\tA module that most of the others import (common, records, spec, ...) is\\n25\\tleft out of MODULE_TESTS on purpose: no table of tests-per-module can know\\n26\\twhat it breaks, so it is the whole suite. The forge runs the whole suite\\n27\\tonce, as the required `test` check, in any case.\\n28\\t\\n29\\tUsage: <changed paths> | select-tes
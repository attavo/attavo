an/Projects/attest/schema/records/build.schema.json:147:      \\\"description\\\": \\\"R3: the counsel or ruling record whose text this attempt was handed, or null\\\"\\n/Users/davidbean/Projects/attest/schema/records/counsel.schema.json:3:  \\\"$id\\\": \\\"https://attavo.dev/schema/records/counsel/3\\\",\\n/Users/davidbean/Projects/attest/schema/records/counsel.schema.json:4:  \\\"title\\\": \\\"attavo counsel record (counsel-NN.json)\\\",\\n/Users/davidbean/Projects/attest/schema/records/counsel.schema.json:20:      \\\"description\\\": \\\"Which stage's non-pass record this counsel invocation read -- \\\\\\\"spec\\\\\\\" is a refused spec-gate record, read only when no build or verify record exists yet.\\\"\\n/Users/davidbean/Projects/attest/schema/records/counsel.schema.json:25:      \\\"description\\\": \\\"The stem (e.g. \\\\\\\"build-01\\\\\\\" or \\\\\\\"spec-01\\\\\\\") of the non-pass record counsel read.\\\"\\n/Users/davidbean/Projects/attest/schema/records/counsel.schema.json:31:      \\\"description\\\": \\\"Copied verbatim from [executor.<adapter>] merged with [executor.<adapter>.counsel].\\\"\\n/Users/davidbean/Projects/attest/schema/records/counsel.schema.json:55:      \\\"description\\\": \\\"\\\\\\\"failed\\\\\\\" when the adapter exited non-zero or returned no usable structured answer; class, verdict, citations, and proposal are then null/empty.\\\"\\n/Users/davidbean/Projects/attest/schema/records/counsel.schema.json:60:               \\\"ceiling\\\", \\\"claims-boundary\\\", \\\"repeated-act\\\", \\\"unclassed\\\", null],\\n/Users/davidbean/Projects/attest/schema/records/counsel.schema.json:61:      \\\"description\\\": \\\"The stop's class as counsel itself reads it -- independent of, and possibly disagreeing with, the stop.class the counseled record already carries.\\\"\\n/Users/davidbean/Projects/attest/schema/records/counsel.schema.json:116:      \\\"description\\\": \\\"counsel's own read of the forge on the counseled record's sha (issue #175) -- independent of, and read fresh from, whatever the counseled record's own forge_checks (verify only) already carries.\\\",\\n/Users/davidbean/Projects/attest/schema/records/counsel.schema.json:122:          \\\"description\\\": \\\"false only for missing manifest configuration or a counseled record with no sha -- never silently treated as a green forge.\\\"\\n/Users/davidbean/Projects/attest/schema/records/counsel.schema.json:130:          \\\"description\\\": \\\"One entry per check [forge].checks_command reported on the counseled sha -- [] both when read is false and when a real read found no checks at all.\\\",\\n/Users/davidbean/Projects/attest/schema/records/counsel.schema.json:145:      \\\"description\\\": \\\"The operator's own text from `attavo counsel N --ask \\\\\\\"<text>\\\\\\\"` -- null for the ordinary stop path.\\\"\\n192:+{\\\"type\\\":\\\"item.completed\\\",\\\"item\\\":{\\\"id\\\":\\\"item_1\\\",\\\"type\\\":\\\"command_execution\\\",\\\"command\\\":\\\"/bin/zsh -lc \\\\\\\"sed -n '1,220p' attest/records/267/build-01.json && sed -n '1,120p' attest/records/267/build-01.log && sed -n '1,240p' attest/specs/267/spec.md 2>/dev/null || true && sed -n '1,120p' /var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp7rot6rlz/checks.json && sed -n '1,160p' /var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmp7rot6rlz/graph.txt && sed -n '1,220p' attavo.toml\\\\\\\"\\\",\\\"aggregated_output\\\":\\\"{\\\\n  \\\\\\\"sha\\\\\\\": \\\\\\\"22831ee93aa5d72a3a761ddea8cfb1895e24b8d7\\\\\\\",\\\\n  \\\\\\\"start_sha\\\\\\\": \\\\\\\"22831ee93aa5d72a3a761ddea8cfb1895e24b8d7\\\\\\\",\\\\n  \\\\\\\"spec_sha\\\\\\\": \\\\\\\"9f328be47311b149144abe7c4722ef5006130040\\\\\\\",\\\\n  \\\\\\\"approval_sha\\\\\\\": \\\\\\\"243a9c2190795c432fa08662722648349a71ebcf\\\\\\\",\\\\n  \\\\\\\"at\\\\\\\": \\\\\\\"2026-09-30T00:55:21Z\\\\\\\",\\\\n  \\\\\\\"adapter\\\\\\\": \\\\\\\"claude-code\\\\\\\",\\\\n  \\\\\\\"adapter_config\\\\\\\": {\\\\n    \\\\\\\"auth\\\\\\\": \\\\\\\"su
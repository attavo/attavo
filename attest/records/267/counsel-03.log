is named here so that a new module under attavo/ must be\\n76\\t# placed -- in MODULE_TESTS or in this tuple -- before the suite accepts it\\n77\\t# (tests/test_testtool.py).\\n78\\tSHARED_MODULES: tuple[str, ...] = (\\n79\\t    \\\"attavo/__init__.py\\\", \\\"attavo/approval.py\\\", \\\"attavo/common.py\\\", \\\"attavo/events.py\\\",\\n80\\t    \\\"attavo/records.py\\\", \\\"attavo/spec.py\\\", \\\"attavo/stops.py\\\",\\n81\\t)\\n82\\t\\n83\\tPREFIX_TESTS: tuple[tuple[str, tuple[str, ...]], ...] = (\\n84\\t    (\\\"adapters/claude-code/\\\", (\\\"tests/test_adapters.py\\\", \\\"tests/test_adapter_claude_code.py\\\",\\n85\\t                               \\\"tests/test_executor_conformance.py\\\")),\\n86\\t    (\\\"adapters/codex/\\\", (\\\"tests/test_adapter_codex.py\\\", \\\"tests/test_adapters_codex.py\\\",\\n87\\t                         \\\"tests/test_executor_conformance.py\\\")),\\n88\\t    (\\\"adapters/\\\", (\\\"tests/test_adapters.py\\\", \\\"tests/test_executor_conformance.py\\\")),\\n89\\t    (\\\"schema/\\\", (\\\"tests/test_record_schemas.py\\\", \\\"tests/test_attest.py\\\",\\n90\\t                 \\\"tests/test_types_mirror_schemas.py\\\")),\\n91\\t    (\\\"templates/\\\", (\\\"tests/test_approve_template.py\\\", \\\"tests/test_coherence_template.py\\\",\\n92\\t                    \\\"tests/test_spec_gate_template.py\\\", \\\"tests/test_template_app_identity.py\\\",\\n93\\t                    \\\"tests/test_templates_carry_no_repository_urls.py\\\",\\n94\\t                    \\\"tests/test_self_tenancy.py\\\")),\\n95\\t)\\n96\\t\\n97\\t\\n98\\tdef repository_root() -> Path:\\n99\\t    return Path(__file__).resolve().parent.parent.parent\\n100\\t\\n101\\t\\n102\\tdef is_prose_or_record(path: str) -> bool:\\n103\\t    return path.endswith(\\\".md\\\") or path == \\\"LICENSE\\\" or path.startswith(SILENT_PREFIXES)\\n104\\t\\n105\\t\\n106\\tdef select_one(path: str) -> tuple[str, ...] | None:\\n107\\t    \\\"\\\"\\\"The tests for one changed path, () for none, None for a path this\\n108\\t    selector does not know.\\\"\\\"\\\"\\n109\\t    if is_prose_or_record(path):\\n110\\t        return ()\\n111\\t    if path.startswith(WHOLE_SUITE_PREFIXES):\\n112\\t        return None\\n113\\t    if path.startswith(\\\"tests/test_\\\") and path.endswith(\\\".py\\\") and \\\"/\\\" not in path[len(\\\"tests/\\\"):]:\\n114\\t        # A deleted test file cannot select itself, and the gate must not\\n115\\t        # pass a deletion unexamined (issue #212's review): fail safe to\\n116\\t        # the whole suite rather than the () a present file's own removal\\n117\\t        # would otherwise fall through to.\\n118\\t        return (path,) if (repository_root() / path).is_file() else None\\n119\\t    if path in MODULE_TESTS:\\n120\\t        return MODULE_TESTS[path]\\n121\\t    for prefix, tests in PREFIX_TESTS:\\n122\\t        if path.startswith(prefix):\\n123\\t            return tests\\n124\\t    return None\\n125\\t\\n126\\t\\n127\\tdef select(paths: list[str]) -> list[str]:\\n128\\t    tests: dict[str, None] = {}\\n129\\t    for path in paths:\\n130\\t        found = select_one(path)\\n131\\t        if found is None:\\n132\\t            return [WHOLE_SUITE]\\n133\\t        tests.update(dict.fromkeys(found))\\n134\\t    return list(tests)\\n135\\t\\n136\\t\\n137\\tdef main() -> int:\\n138\\t    changed = [line.strip() for line in sys.stdin.read().splitlines() if line.strip()]\\n139\\t    for t in select(changed):\\n140\\t        print(t)\\n141\\t    return 0\\n142\\t\\n143\\t\\n144\\tif __name__ == \\\"__main__\\\":\\n145\\t    sys.exit(main())\\n146\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"f2e0c4f7-36d4-465e-a2fe-27db257201e7\",\"uuid\":\"2a5fffe5-e9c0-4625-b64c-3302a6df1d72\",\"timestamp\":\"2026-09-30T01:01:16.619Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/davidbean/Projects/attavo-worktree-267/attest/specs/267/stub/.attavo/bin/select-tests\",\"content\":\"#!/usr/bin/env python3\\n\\\"\\\"\\\"select-tests: [tests].select for attavo build/verify/test (issue #103,\\nmade fail-safe by issue #212).\\n\\nReads changed paths on stdin, one per line, and prints test identifiers\\non stdout, one per line, for this repository's own test suite:\\n\\n  - prose (*.md, LICENSE) and this repository's own specs and records\\n    (attest/specs/**, attest/records/**) select nothing;\\n  - a test file (tests/test_*.py) selects itself, and the whole suite\\n    when it no longer exists -- a deletion cannot select itself, and the\\n    fail-safe rule below applies to it rather than exempting it (issue\\n    #212's review);\\n  - a path in MODULE_TESTS (a module of attavo/, and the few files that\\n    are one thing's own) selects the tests written for it, and a prefix in\\n    PREFIX_TESTS (adapters/, schema/, templates/) the tests written for\\n    that directory;\\n  - a path this selector does not know -- a module nobody mapped,\\n    bin/attavo, scripts/, tests/helpers.py and the fixtures every test\\n    stands on, the fixture adapter every build test invokes -- selects the\\n    whole suite (\\\"tests\\\", the one path pytest needs to run everything),\\n    and one such path is enough to make that the whole answer.\\n\\nA module that most of the others import (common, records, spec, ...) is\\nleft out of MODULE_TESTS on purpose: no table of tests-per-module can know\\nwhat it breaks, so it is the whole suite. The forge runs the whole suite\\nonce, as the required `test` check, in any case.\\n\\nUsage: <changed paths> | select-tests\\n\\\"\\\"\\\"\\nfrom __future__ import annotations\\n\\nimport sys\\nfrom pathlib import Path\\n\\nWHOLE_SUITE = \\\"tests\\\"\\n\\nSILENT_PREFIXES = (\\\"attest/specs/\\\", \\\"attest/records/\\\")\\n\\nWHOLE_SUITE_PREFIXES = (\\\"adapters/fixture/\\\",)\\n\\nMODULE_TESTS: dict[str, tuple[str, ...]] = {\\n    \\\"attavo/attest.py\\\": (\\\"tests/test_attest.py\\\", \\\"tests/test_attest_time.py\\\"),\\n    \\\"attavo/build.py\\\": (\\\"tests/test_build.py\\\", \\\"tests/test_testtool.py\\\"),\\n    \\\"attavo/claims.py\\\": (\\\"tests/test_claims.py\\\",),\\n    \\\"attavo/clock.py\\\": (\\\"tests/test_clock.py\\\", \\\"tests/test_retry.py\\\"),\\n    \\\"attavo/cli.py\\\": (\\\"tests/test_cli_help.py\\\", \\\"tests/test_testtool.py\\\"),\\n    \\\"attavo/counsel.py\\\": (\\\"tests/test_counsel.py\\\",),\\n    \\\"attavo/doctor.py\\\": (\\\"tests/test_doctor.py\\\", \\\"tests/test_doctor_sealed.py\\\",\\n                         \\\"tests/test_proof_five_elsewhere.py\\\",\\n                         \\\"tests/test_sealed_since_default.py\\\"),\\n    \\\"attavo/drive.py\\\": (\\\"tests/test_drive.py\\\",),\\n    \\\"attavo/filing.py\\\": (\\\"tests/test_file_findings.py\\\", \\\"tests/test_file_stops.py\\\"),\\n    \\\"attavo/issues.py\\\": (\\\"tests/test_issues.py\\\",),\\n    \\\"attavo/ledger.py\\\": (\\\"tests/test_ledger.py\\\",),\\n    \\\"attavo/plan.py\\\": (\\\"tests/test_plan.py\\\",),\\n    \\\"attavo/record_only.py\\\": (\\\"tests/test_record_only.py\\\",),\\n    \\\"attavo/report.py\\\": (\\\"tests/test_report.py\\\",),\\n    \\\"attavo/store.py\\\": (\\\"tests/test_store.py\\\", \\\"tests/test_plan.py\\\"),\\n    \\\"attavo/testtool.py\\\": (\\\"tests/test_testtool.py\\\",),\\n    \\\"attavo/types.py\\\": (\\\"tests/test_types_mirror_schemas.py\\\",),\\n    \\\"attavo/verify.py\\\": (\\\"tests/test_verify.py\\\", \\\"tests/test_verify_polls.py\\\",\\n                         \\\"tests/test_verify_codex_proof.py\\\"),\\n    \\\"action.yml\\\": (\\\"tests/test_action_yml.py\\\",),\\n    \\\"attavo.toml\\\": (\\\"tests/test_self_tenancy.py\\\", \\\"tests/test_testtool.py\\\"),\\n    \\\"schema/plan.schema.json\\\": (\\\"tests/test_plan.py\\\",),\\n    \\\"schema/manifest.schema.json\\\": (\\\"tests/test_self_tenancy.py\\\", \\\"tests/test_record_schemas.py\\\",\\n                                    \\\"tests/test_testtool.py\\\"),\\n    \\\".attavo/bin/forge-issues\\\": (\\\"tests/test_issues.py\\\",),\\n    \\\".attavo/bin/select-tests\\\": (\\\"tests/test_self_tenancy.py\\\", \\\"tests/test_testtool.py\\\"),\\n}\\n\\n# The modules most of the others import: no table of tests-per-module can\\n# know what a change to one of these breaks, so each selects the whole\\n# suite, and each is named here so that a new module under attavo/ must be\\n# placed -- in MODULE_TESTS or in this tuple -- before the suite accepts it\\n# (tests/test_testtool.py).\\nSHARED_MODULES: tuple[str, ...] = (\\n    \\\"attavo/__init__.py\\\", \\\"attavo/approval.py\\\", \\\"attavo/common.py\\\", \\\"attavo/events.py\\\",\\n    \\\"attavo/records.py\\\", \\\"attavo/spec.py\\\", \\\"attavo/stops.py\\\",\\n)\\n\\nPREFIX_TESTS: tuple[tuple[str, tuple[str, ...]], ...] = (\\n    (\\\"adapters/claude-code/\\\", (\\\"tests/test_adapters.py\\\", \\\"tests/test_adapter_claude_code.py\\\",\\n                               \\\"tests/test_executor_conformance.py\\\")),\\n    (\\\"adapters/codex/\\\", (\\\"tests/test_adapter_codex.py\\\", \\\"tests/test_adapters_codex.py\\\",\\n                         \\\"tests/test_executor_conformance.py\\\")),\\n    (\\\"adapters/\\\", (\\\"tests/test_adapters.py\\\", \\\"tests/test_executor_conformance.py\\\")),\\n    (\\\"schema/\\\", (\\\"tests/test_record_schemas.py\\\", \\\"tests/test_attest.py\\\",\\n                 \\\"tests/test_types_mirror_schemas.py\\\")),\\n    (\\\"templates/\\\", (\\\"tests/test_approve_template.py\\\", \\\"tests/test_coherence_template.py\\\",\\n                    \\\"tests/test_spec_gate_template.py\\\", \\\"tests/test_template_app_identity.py\\\",\\n                    \\\"tests/test_templates_carry_no_repository_urls.py\\\",\\n                    \\\"tests/test_self_tenancy.py\\\")),\\n)\\n\\n\\ndef repository_root() -> Path:\\n    return Path(__file__).resolve().parent.parent.parent\\n\\n\\ndef is_prose_or_record(path: str) -> bool:\\n    return path.endswith(\\\".md\\\") or path == \\\"LICENSE\\\" or path.startswith(SILENT_PREFIXES)\\n\\n\\ndef select_one(path: str) -> tuple[str, ...] | None:\\n    \\\"\\\"\\\"The tests for one changed path, () for none, None for a path this\\n    selector does not know.\\\"\\\"\\\"\\n    if is_prose_or_record(path):\\n        return ()\\n    if path.startswith(WHOLE_SUITE_PREFIXES):\\n        return None\\n    if path.startswith(\\\"tests/test_\\\") and path.endswith(\\\".py\\\") and \\\"/\\\" not in path[len(\\\"tests/\\\"):]:\\n        # A deleted test file cannot select itself, and the gate must not\\n        # pass a deletion unexamined (issue #212's review): fail safe to\\n        # the whole suite rather than the () a present file's own removal\\n        # would otherwise fall through to.\\n        return (path,) if (repository_root() / path).is_file() else None\\n    if path in MODULE_TESTS:\\n        return MODULE_TESTS[path]\\n    for prefix, tests in PREFIX_TESTS:\\n        if path.startswith(prefix):\\n            return tests\\n    return None\\n\\n\\ndef select(paths: list[str]) -> list[str]:\\n    tests: dict[str, None] = {}\\n    for path in paths:\\n        found = select_one(path)\\n        if found is None:\\n            return [WHOLE_SUITE]\\n        tests.update(dict.fromkeys(found))\\n    return list(tests)\\n\\n\\ndef main() -> int:\\n    changed = [line.strip() for line in sys.stdin.read().splitlines() if line.strip()]\\n    for t in select(changed):\\n        print(t)\\n    return 0\\n\\n\\nif __name__ == \\\"__main__\\\":\\n    sys.exit(main())\\n\",\"numLines\":146,\"startLine\":1,\"totalLines\":146}}}\n496:+{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01SExE3E6esbmUfNCNUoAxUW\",\"type\":\"tool_result\",\"content\":\"1\\tschema_version = 1\\n2\\t\\n3\\t[attavo]\\n4\\tversion = \\\"v0.30.0\\\"\\n5\\t\\n6\\t[forge]\\n7\\tchecks_command = \\\"python3 .attavo/bin/forge-checks\\\"\\n8\\tcheck_log_command = \\\"python3 .attavo/bin/forge-check-log\\\"\\n9\\tfile_issue_command = \\\"python3 .attavo/bin/file-issue\\\"\\n10\\tissues_command = \\\"python3 .attavo/bin/forge-issues\\\"\\n11\\tattestation_command = \\\"sh .attavo/bin/forge-attestation\\\"\\n12\\tsealed_since = \\\"83fcbc6863fdb65956b77768c66c2103d221521b\\\"\\n13\\t\\n14\\t[executor]\\n15\\tbuild = \\\"claude-code\\\"\\n16\\tverify = \\\"codex\\\"\\n17\\t\\n18\\t[executor.claude-code]\\n19\\tauth = \\\"subscription\\\"\\n20\\tmodel = \\\"claude-sonnet-5\\\"\\n21\\t\\n22\\t[executor.codex]\\n23\\tmodel = \\\"gpt-5.6-sol\\\"\\n24\\t\\n25\\t[spec]\\n26\\t[spec.boundary]\\n27\\tpaths = [\\\"bin/**\\\", \\\"attavo/**\\\", \\\"adapters/**\\\", \\\"schema/**\\\", \\\"templates/**\\\", \\\"action.yml\\\", \\\"scripts/**\\\"]\\n28\\t\\n29\\t[gates]\\n30\\t[gates.spec]\\n31\\tcommand = \\\"attavo spec-gate\\\"\\n32\\tretires = [\\n33\\t  \\\"the lane as the product's transport: a Claude Code lane session reporting to a reviewing session, with no spec, no approval bound to a commit, no build/verify separation, and no attestation on the product's own commits\\\",\\n34\\t  \\\"the || true step in ci.yml that ran the doctor's four proofs against this repository expected to still fail\\\",\\n35\\t  \\\"the reviewing session as the reader of whether the lane did what the issue said\\\",\\n36\\t]\\n37\\t\\n38\\t[tests]\\n39\\tselect = \\\"python3 .attavo/bin/select-tests\\\"\\n40\\tcall_timeout_s = 240\\n41\\trun = \\\"xargs -r python3 -m pytest -q -m 'not own_records'\\\"\\n42\\t\\n43\\t[paths]\\n44\\tspecs = \\\"attest/specs\\\"\\n45\\trecords = \\\"attest/records\\\"\\n46\\trulings = \\\"attest/rulings.md\\\"\\n47\\trejections = \\\"attest/rejections\\\"\\n48\\t\\n49\\t[doctor]\\n50\\tbuilt_since = \\\"dae6d765f3d6\\\"\\n51\\t\\n52\\t[operators]\\n53\\tapprovers = [\\\"dbean10\\\"]\\n54\\t\\n55\\t[checks]\\n56\\tcommand = \\\"python3 -m mypy\\\"\\n57\\tprobe = \\\"python3 -c 'import pytest, mypy, jsonschema'\\\"\\n58\\tprobe_timeout_s = 60\\n59\\t\\n60\\t[drive]\\n61\\tstall_after_s = 1800\\n62\\tattempts = 3\\n63\\tretry_after_s = 300\\n64\\t\\n65\\t[drive.build]\\n66\\tceiling_s = 3600\\n67\\t\\n68\\t[drive.verify]\\n69\\tceiling_s = 1200\\n70\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"f2e0c4f7-36d4-465e-a2fe-27db257201e7\",\"uuid\":\"89140951-cefe-4693-ac6a-ce59a0d36e99\",\"timestamp\":\"2026-09-30T01:01:17.078Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/davidbean/Projects/attavo-worktree-267/attest/specs/267/stub/attavo.toml\",\"content\":\"schema_version = 1\\n\\n[attavo]\\nversion = \\\"v0.30.0\\\"\\n\\n[forge]\\nchecks_command = \\\"python3 .attavo/bin/forge-checks\\\"\\ncheck_log_command = \\\"python3 .attavo/bin/forge-check-log\\\"\\nfile_issue_command = \\\"python3 .attavo/bin/file-issue\\\"\\nissues_command = \\\"python3 .attavo/bin/forge-issues\\\"\\nattestation_command = \\\"sh .attavo/bin/forge-attestation\\\"\\nsealed_since = \\\"83fcbc6863fdb65956b77768c66c2103d221521b\\\"\\n\\n[executor]\\nbuild = \\\"claude-code\\\"\\nverify = \\\"codex\\\"\\n\\n[executor.claude-code]\\nauth = \\\"subscription\\\"\\nmodel = \\\"claude-sonnet-5\\\"\\n\\n[executor.codex]\\nmodel = \\\"gpt-5.6-sol\\\"\\n\\n[spec]\\n[spec.boundary]\\npaths = [\\\"bin/**\\\", \\\"attavo/**\\\", \\\"adapters/**\\\", \\\"schema/**\\\", \\\"templates/**\\\", \\\"action.yml\\\", \\\"scripts/**\\\"]\\n\\n[gates]\\n[gates.spec]\\ncommand = \\\"attavo spec-gate\\\"\\nretires = [\\n  \\\"the lane as the product's transport: a Claude Code lane session reporting to a reviewing session, with no spec, no approval bound to a commit, no build/verify separation, and no attestation on the product's own commits\\\",\\n  \\\"the || true step in ci.yml that ran the doctor's four proofs against this repository expected to still fail\\\",\\n  \\\"the reviewing session as the reader of whether the lane did what the issue said\\\",\\n]\\n\\n[tests]\\nselect = \\\"python3 .attavo/bin/select-tests\\\"\\ncall_timeout_s = 240\\nrun = \\\"xargs -r python3 -m pytest -q -m 'not own_records'\\\"\\n\\n[paths]\\nspecs = \\\"attest/specs\\\"\\nrecords = \\\"attest/records\\\"\\nrulings = \\\"attest/rulings.md\\\"\\nrejections = \\\"attest/rejections\\\"\\n\\n[doctor]\\nbuilt_since = \\\"dae6d765f3d6\\\"\\n\\n[operators]\\napprovers = [\\\"dbean10\\\"]\\n\\n[checks]\\ncommand = \\\"python3 -m mypy\\\"\\nprobe = \\\"python3 -c 'import pytest, mypy, jsonschema'\\\"\\nprobe_timeout_s = 60\\n\\n[drive]\\nstall_after_s = 1800\\nattempts = 3\\nretry_after_s = 300\\n\\n[drive.build]\\nceiling_s = 3600\\n\\n[drive.verify]\\nceiling_s = 1200\\n\",\"numLines\":70,\"startLine\":1,\"totalLines\":70}}}\n498:+{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01P7FTFxj3NBkoRLxeg1c23h\",\"type\":\"tool_result\",\"content\":\"1\\t{\\n2\\t  \\\"$schema\\\": \\\"https://json-schema.org/draft/2020-12/schema\\\",\\n3\\t  \\\"$id\\\": \\\"https://attavo.dev/schema/manifest/2\\\",\\n4\\t  \\\"title\\\": \\\"Attavo tenant manifest (attavo.toml)\\\",\\n5\\t  \\\"description\\\": \\\"What a tenant declares to install Attavo: the release it pins, the executor it chose, where the governed path begins and ends, the gates it runs, and where its specs, records, and rulings live. Every key is read by a script; a key no script reads does not belong here.\\\",\\n6\\t  \\\"type\\\": \\\"object\\\",\\n7\\t  \\\"additionalProperties\\\": false,\\n8\\t  \\\"required\\\": [\\\"schema_version\\\", \\\"attavo\\\", \\\"executor\\\", \\\"spec\\\", \\\"gates\\\", \\\"paths\\\", \\\"operators\\\"],\\n9\\t  \\\"properties\\\": {\\n10\\t    \\\"schema_version\\\": {\\n11\\t      \\\"type\\\": \\\"integer\\\",\\n12\\t      \\\"const\\\": 1\\n13\\t    },\\n14\\t    \\\"attavo\\\": {\\n15\\t      \\\"type\\\": \\\"object\\\",\\n16\\t      \\\"additionalProperties\\\": false,\\n17\\t      \\\"required\\\": [\\\"version\\\"],\\n18\\t      \\\"properties\\\": {\\n19\\t        \\\"version\\\": {\\n20\\t          \\\"type\\\": \\\"string\\\",\\n21\\t          \\\"description\\\": \\\"The Attavo release tag the tenant pins. The tenant holds no Attavo binary; the pinned action supplies it.\\\",\\n22\\t          \\\"pattern\\\": \\\"^v[0-9]+\\\\\\\\.[0-9]+\\\\\\\\.[0-9]+$\\\"\\n23\\t        }\\n24\\t      }\\n25\\t    },\\n26\\t    \\\"executor\\\": {\\n27\\t      \\\"type\\\": \\\"object\\\",\\n28\\t      \\\"required\\\": [\\\"build\\\"],\\n29\\t      \\\"properties\\\": {\\n30\\t        \\\"build\\\": {\\n31\\t          \\\"type\\\": \\\"string\\\",\\n32\\t          \\\"description\\\": \\\"Adapter name for the build invocation. The contract is thin: spec, corpus, and branch in; commits and a report record out.\\\",\\n33\\t          \\\"minLength\\\": 1\\n34\\t        },\\n35\\t        \\\"verify\\\": {\\n36\\t          \\\"type\\\": \\\"string\\\",\\n37\\t          \\\"description\\\": \\\"Adapter name for the verify invocation. Defaults to build's adapter; may differ.\\\",\\n38\\t          \\\"minLength\\\": 1\\n39\\t        }\\n40\\t      },\\n41\\t      \\\"additionalProperties\\\": {\\n42\\t        \\\"type\\\": \\\"object\\\",\\n43\\t        \\\"description\\\": \\\"[executor.<adapter-name>]: that adapter's own configuration, passed through as ATTAVO_ADAPTER_CONFIG and copied verbatim into build-NN.json as adapter_config. The product does not know what an adapter's settings mean -- any keys, none required. Never put a secret in here: it lands in a record.\\\"\\n44\\t      }\\n45\\t    },\\n46\\t    \\\"tests\\\": {\\n47\\t      \\\"type\\\": \\\"object\\\",\\n48\\t      \\\"description\\\": \\\"How build finds and runs the tests for a touched path. Both keys are required together; a tenant with no [tests] table has not declared selection, and attavo build refuses to run on it.\\\",\\n49\\t      \\\"additionalProperties\\\": false,\\n50\\t      \\\"required\\\": [\\\"select\\\", \\\"run\\\"],\\n51\\t      \\\"properties\\\": {\\n52\\t        \\\"select\\\": {\\n53\\t          \\\"type\\\": \\\"string\\\",\\n54\\t          \\\"description\\\": \\\"A command that reads touched paths on stdin, one per line, and writes test identifiers on stdout, one per line.\\\",\\n55\\t          \\\"minLength\\\": 1\\n56\\t        },\\n57\\t        \\\"exclude_in_executor\\\": {\\n58\\t          \\\"type\\\": \\\"array\\\",\\n59\\t          \\\"items\\\": {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1},\\n60\\t          \\\"description\\\": \\\"Test identifiers attavo test leaves out when it runs inside an executor (ATTAVO_STAGE set): tests that need a live tenant, the network, or the process's own working directory. CI runs them.\\\"\\n61\\t        },\\n62\\t        \\\"run\\\": {\\n63\\t          \\\"type\\\": \\\"string\\\",\\n64\\t          \\\"description\\\": \\\"A command that reads test identifiers on stdin, one per line; its exit code is the verdict.\\\",\\n65\\t          \\\"minLength\\\": 1\\n66\\t        },\\n67\\t        \\\"call_timeout_s\\\": {\\n68\\t          \\\"type\\\": \\\"integer\\\",\\n69\\t          \\\"minimum\\\": 1,\\n70\\t          \\\"description\\\": \\\"Seconds one `attavo test` run is given before its process group is ended and it exits 124. The executor's own test runs are bounded; the gate's are not.\\\"\\n71\\t        }\\n72\\t      }\\n73\\t    },\\n74\\t    \\\"checks\\\": {\\n75\\t      \\\"type\\\": \\\"object\\\",\\n76\\t      \\\"description\\\": \\\"The tenant's own definition of done: a whole-tree check, as the tenant runs it locally. attavo build runs it each iteration, after the claims boundary, the criteria, and the selected tests -- pass requires its exit to be 0, and a non-zero exit reaches the executor as feedback. Optional; a tenant that declares none is not refused (unlike [tests], which build requires).\\\",\\n77\\t      \\\"additionalProperties\\\": false,\\n78\\t      \\\"required\\\": [\\\"command\\\"],\\n79\\t      \\\"properties\\\": {\\n80\\t        \\\"command\\\": {\\n81\\t          \\\"type\\\": \\\"string\\\",\\n82\\t          \\\"description\\\": \\\"The tenant's whole-tree check at the gate, run from the tenant root once per iteration on the committed tree. What is fast and decisive belongs here; what the forge runs as a required check need not be run twice.\\\",\\n83\\t          \\\"minLength\\\": 1\\n84\\t        },\\n85\\t        \\\"probe\\\": {\\n86\\t          \\\"type\\\": \\\"string\\\",\\n87\\t          \\\"description\\\": \\\"A cheap command that answers whether this machine can run the checks at all, run once before a build's executor is invoked: exit 0 yes, anything else an environment refusal. When absent, attavo build asks by running [checks].command whole and reads exit 2 alone as cannot run.\\\",\\n88\\t          \\\"minLength\\\": 1\\n89\\t        },\\n90\\t        \\\"probe_timeout_s\\\": {\\n91\\t          \\\"type\\\": \\\"integer\\\",\\n92\\t          \\\"minimum\\\": 1,\\n93\\t          \\\"description\\\": \\\"Seconds [checks].probe is given; past it the build is refused as an environment stop. Required with probe: a bound the tenant did not write is a forecast.\\\"\\n94\\t        }\\n95\\t      },\\n96\\t      \\\"dependentRequired\\\": {\\\"probe\\\": [\\\"probe_timeout_s\\\"]}\\n97\\t    },\\n98\\t    \\\"forge\\\": {\\n99\\t      \\\"type\\\": \\\"object\\\",\\n100\\t      \\\"description\\\": \\\"The tenant's own commit-status and issue-tracking reads. The product names no vendor: every key is a command the tenant supplies. Optional; attavo verify refuses without checks_command, and attavo file-findings refuses without file_issue_command, but neither key requires the other.\\\",\\n101\\t      \\\"additionalProperties\\\": false,\\n102\\t      \\\"properties\\\": {\\n103\\t        \\\"checks_command\\\": {\\n104\\t          \\\"type\\\": \\\"string\\\",\\n105\\t          \\\"description\\\": \\\"Takes a full commit sha on argv; prints one line per check as \\\\\\\"<name> <conclusion>\\\\\\\". attavo verify runs it on the item's latest build record's sha before calling any adapter.\\\",\\n106\\t          \\\"minLength\\\": 1\\n107\\t        },\\n108\\t        \\\"check_log_command\\\": {\\n109\\t          \\\"type\\\": \\\"string\\\",\\n110\\t          \\\"description\\\": \\\"Takes a sha and a check name on argv; prints that check's own failed-step log. attavo counsel runs it once per check checks_command reported as not \\\\\\\"success\\\\\\\" on the counseled record's sha, before handing the adapter ATTAVO_COUNSEL_CHECKS -- absent, counsel's own record says so (forge.read: false) rather than reading the forge as if it were green.\\\",\\n111\\t          \\\"minLength\\\": 1\\n112\\t        },\\n113\\t        \\\"file_issue_command\\\": {\\n114\\t          \\\"type\\\": \\\"string\\\",\\n115\\t          \\\"description\\\": \\\"Reads one finding as JSON on stdin and files it as a tenant issue. attavo file-findings runs it once per finding in the item's latest verify record.\\\",\\n116\\t          \\\"minLength\\\": 1\\n117\\t        },\\n118\\t        \\\"issues_command\\\": {\\n119\\t          \\\"type\\\": \\\"string\\\",\\n120\\t          \\\"description\\\": \\\"Takes nothing; prints the tenant's issues, open and closed, as one JSON list of {number, title, state (open or closed), closed_at, labels, body}. The product parses each body's \\\\\\\"## Claims\\\\\\\" section itself. attavo frontier runs it once per read; absent, every reader that needs issues says \\\\\\\"not read: no [forge].issues_command\\\\\\\".\\\",\\n121\\t          \\\"minLength\\\": 1\\n122\\t        },\\n123\\t        \\\"attestation_command\\\": {\\n124\\t          \\\"type\\\": \\\"string\\\",\\n125\\t          \\\"description\\\": \\\"Reads a merge commit sha on stdin and prints that merge's attestation statement as JSON on exit 0; nothing on a non-zero exit. The doctor's fifth proof runs it once per merged, fully-staged item to require a statement in the store.\\\",\\n126\\t          \\\"minLength\\\": 1\\n127\\t        },\\n128\\t        \\\"sealed_since\\\": {\\n129\\t          \\\"type\\\": \\\"string\\\",\\n130\\t          \\\"description\\\": \\\"A commit. A merge at or before it is before the window: the tenant could not seal it (no queue, no signing workflow, or a store that held nothing yet). Defaults to the install commit; set it only for a repository that ran the product before it could seal, to the first parent of its first sealed merge, and say why in the commit that sets it.\\\",\\n131\\t          \\\"minLength\\\": 7\\n132\\t        }\\n133\\t      }\\n134\\t    },\\n135\\t    \\\"spec\\\": {\\n136\\t      \\\"type\\\": \\\"object\\\",\\n137\\t      \\\"additionalProperties\\\": false,\\n138\\t      \\\"required\\\": [\\\"boundary\\\"],\\n139\\t      \\\"properties\\\": {\\n140\\t        \\\"research\\\": {\\n141\\t          \\\"type\\\": \\\"string\\\",\\n142\\t          \\\"enum\\\": [\\\"required\\\"],\\n143\\t          \\\"description\\\": \\\"Set to \\\\\\\"required\\\\\\\" and a core spec owes a research record in the item's records before its gate passes. Absent, it owes none, and every gate record says so (ruled 2026-09-27: behind this flag until the Plan area hosts research).\\\"\\n144\\t        },\\n145\\t        \\\"boundary\\\": {\\n146\\t          \\\"type\\\": \\\"object\\\",\\n147\\t          \\\"description\\\": \\\"Which changes take the governed path. A change outside the boundary takes the tenant's ordinary pull-request flow, and the path ratio measures both.\\\",\\n148\\t          \\\"additionalProperties\\\": false,\\n149\\t          \\\"properties\\\": {\\n150\\t            \\\"paths\\\": {\\n151\\t              \\\"type\\\": \\\"array\\\",\\n152\\t              \\\"items\\\": {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1},\\n153\\t              \\\"description\\\": \\\"Glob patterns; a change touching any of them is governed.\\\"\\n154\\t            },\\n155\\t            \\\"labels\\\": {\\n156\\t              \\\"type\\\": \\\"array\\\",\\n157\\t              \\\"items\\\": {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1},\\n158\\t              \\\"description\\\": \\\"Issue labels; an issue carrying any of them is governed.\\\"\\n159\\t            },\\n160\\t            \\\"max_ordinary_lines\\\": {\\n161\\t              \\\"type\\\": \\\"integer\\\",\\n162\\t              \\\"minimum\\\": 0,\\n163\\t              \\\"description\\\": \\\"A change above this many net lines is governed regardless of path or label.\\\"\\n164\\t            }\\n165\\t          }\\n166\\t        }\\n167\\t      }\\n168\\t    },\\n169\\t    \\\"gates\\\": {\\n170\\t      \\\"type\\\": \\\"object\\\",\\n171\\t      \\\"description\\\": \\\"Every gate the tenant runs, by name. The doctor's first proof is that each one rejects its fixture; a gate absent from this table does not exist.\\\",\\n172\\t      \\\"propertyNames\\\": {\\\"pattern\\\": \\\"^[a-z][a-z0-9-]*$\\\"},\\n173\\t      \\\"additionalProperties\\\": {\\n174\\t        \\\"type\\\": \\\"object\\\",\\n175\\t        \\\"additionalProperties\\\": false,\\n176\\t        \\\"required\\\": [\\\"command\\\", \\\"retires\\\"],\\n177\\t        \\\"properties\\\": {\\n178\\t          \\\"command\\\": {\\n179\\t            \\\"type\\\": \\\"string\\\",\\n180\\t            \\\"description\\\": \\\"The script the gate runs, invoked with the tenant root as its working directory. Exit status is the verdict: non-zero rejects.\\\",\\n181\\t            \\\"minLength\\\": 1\\n182\\t          },\\n183\\t          \\\"retires\\\": {\\n184\\t            \\\"type\\\": \\\"array\\\",\\n185\\t            \\\"minItems\\\": 1,\\n186\\t            \\\"items\\\": {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1},\\n187\\t            \\\"description\\\": \\\"What this gate replaced. A gate that retires nothing is not admitted to the table.\\\"\\n188\\t          }\\n189\\t        }\\n190\\t      }\\n191\\t    },\\n192\\t    \\\"paths\\\": {\\n193\\t      \\\"type\\\": \\\"object\\\",\\n194\\t      \\\"additionalProperties\\\": false,\\n195\\t      \\\"required\\\": [\\\"specs\\\", \\\"records\\\", \\\"rulings\\\", \\\"rejections\\\"],\\n196\\t      \\\"properties\\\": {\\n197\\t        \\\"specs\\\": {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1, \\\"description\\\": \\\"Directory of specs, one per work item, named by issue number.\\\"},\\n198\\t        \\\"rejections\\\": {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1, \\\"description\\\": \\\"Directory of rejection fixtures, one subdirectory per gate name. The doctor's first proof runs each gate against its fixture and requires a rejection.\\\"},\\n199\\t        \\\"records\\\": {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1, \\\"description\\\": \\\"Directory of records, append-only, one subdirectory per work item named by issue number. Scripts write every file here.\\\"},\\n200\\t        \\\"rulings\\\": {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1, \\\"description\\\": \\\"The tenant's rulings file, rendered read-only; the merge of a proposed amendment is the ruling.\\\"}\\n201\\t      }\\n202\\t    },\\n203\\t    \\\"operators\\\": {\\n204\\t      \\\"type\\\": \\\"object\\\",\\n205\\t      \\\"additionalProperties\\\": false,\\n206\\t      \\\"required\\\": [\\\"approvers\\\"],\\n207\\t      \\\"properties\\\": {\\n208\\t        \\\"approvers\\\": {\\n209\\t          \\\"type\\\": \\\"array\\\",\\n210\\t          \\\"items\\\": {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1},\\n211\\t          \\\"description\\\": \\\"Logins allowed to bind a spec's approval to a commit. `attavo approve` refuses a LOGIN not on this list.\\\"\\n212\\t        }\\n213\\t      }\\n214\\t    },\\n215\\t    \\\"doctor\\\": {\\n216\\t      \\\"type\\\": \\\"object\\\",\\n217\\t      \\\"description\\\": \\\"Optional; the doctor's own read. Absent, proof three's window starts at the install commit, as it always has.\\\",\\n218\\t      \\\"additionalProperties\\\": false,\\n219\\t      \\\"properties\\\": {\\n220\\t        \\\"from\\\": {\\n221\\t          \\\"type\\\": \\\"string\\\",\\n222\\t          \\\"description\\\": \\\"Anything git rev-parse --verify resolves to a commit on main's first-parent line, at or after the install commit -- a full or abbreviated sha, a tag, a ref -- where proof three's window starts. A tenant that adopted the product on a repository with pre-existing history names the commit after which every push arrived through the queue. Resolved and checked against main's first-parent line, not trusted: a spelling that does not resolve, or a commit that is not on that line, is refused by name.\\\",\\n223\\t          \\\"minLength\\\": 1\\n224\\t        },\\n225\\t        \\\"built_since\\\": {\\n226\\t          \\\"type\\\": \\\"string\\\",\\n227\\t          \\\"description\\\": \\\"Anything git rev-parse --verify resolves to a commit. Proof seven (no attested item is empty) names items merged at or before it as before the window instead of failing them: the specimen that produced the proof stays on the record without failing the tenant forever. Absent, proof seven's window is proof three's.\\\",\\n228\\t          \\\"minLength\\\": 1\\n229\\t        }\\n230\\t      }\\n231\\t    },\\n232\\t    \\\"drive\\\": {\\n233\\t      \\\"type\\\": \\\"object\\\",\\n234\\t      \\\"additionalProperties\\\": false,\\n235\\t      \\\"properties\\\": {\\n236\\t        \\\"stall_after_s\\\": {\\n237\\t          \\\"type\\\": \\\"integer\\\",\\n238\\t          \\\"minimum\\\": 1,\\n239\\t          \\\"description\\\": \\\"seconds without a new event past which a live invocation is hung; attavo drive --recover terminates and records it\\\"\\n240\\t        },\\n241\\t        \\\"attempts\\\": {\\n242\\t          \\\"type\\\": \\\"integer\\\",\\n243\\t          \\\"minimum\\\": 1,\\n244\\t          \\\"description\\\": \\\"R3: attempts a stage may spend before the item is a person's; 3 when absent\\\"\\n245\\t        },\\n246\\t        \\\"retry_after_s\\\": {\\n247\\t          \\\"type\\\": \\\"integer\\\",\\n248\\t          \\\"minimum\\\": 0,\\n249\\t          \\\"description\\\": \\\"R3: seconds a transient stop waits before its next attempt; 300 when absent\\\"\\n250\\t        },\\n251\\t        \\\"build\\\": {\\n252\\t          \\\"type\\\": \\\"object\\\",\\n253\\t          \\\"additionalProperties\\\": false,\\n254\\t          \\\"properties\\\": {\\n255\\t            \\\"ceiling_s\\\": {\\\"type\\\": \\\"integer\\\", \\\"minimum\\\": 1, \\\"description\\\": \\\"R3: wall clock past which a live build is hung by its ceiling\\\"}\\n256\\t          }\\n257\\t        },\\n258\\t        \\\"verify\\\": {\\n259\\t          \\\"type\\\": \\\"object\\\",\\n260\\t          \\\"additionalProperties\\\": false,\\n261\\t          \\\"properties\\\": {\\n262\\t            \\\"ceiling_s\\\": {\\\"type\\\": \\\"integer\\\", \\\"minimum\\\": 1, \\\"description\\\": \\\"R3: wall clock past which a live review is hung by its ceiling\\\"}\\n263\\t          }\\n264\\t        }\\n265\\t      }\\n266\\t    }\\n267\\t  }\\n268\\t}\\n269\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"f2e0c4f7-36d4-465e-a2fe-27db257201e7\",\"uuid\":\"3f90a5f6-097b-451b-854e-92ce402a46bf\",\"timestamp\":\"2026-09-30T01:01:17.859Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/davidbean/Projects/attavo-worktree-267/attest/specs/267/stub/schema/manifest.schema.json\",\"content\":\"{\\n  \\\"$schema\\\": \\\"https://json-schema.org/draft/2020-12/schema\\\",\\n  \\\"$id\\\": \\\"https://attavo.dev/schema/manifest/2\\\",\\n  \\\"title\\\": \\\"Attavo tenant manifest (attavo.toml)\\\",\\n  \\\"description\\\": \\\"What a tenant declares to install Attavo: the release it pins, the executor it chose, where the governed path begins and ends, the gates it runs, and where its specs, records, and rulings live. Every key is read by a script; a key no script reads does not belong here.\\\",\\n  \\\"type\\\": \\\"object\\\",\\n  \\\"additionalProperties\\\": false,\\n  \\\"required\\\": [\\\"schema_version\\\", \\\"attavo\\\", \\\"executor\\\", \\\"spec\\\", \\\"gates\\\", \\\"paths\\\", \\\"operators\\\"],\\n  \\\"properties\\\": {\\n    \\\"schema_version\\\": {\\n      \\\"type\\\": \\\"integer\\\",\\n      \\\"const\\\": 1\\n    },\\n    \\\"attavo\\\": {\\n      \\\"type\\\": \\\"object\\\",\\n      \\\"additionalProperties\\\": false,\\n      \\\"required\\\": [\\\"version\\\"],\\n      \\\"properties\\\": {\\n        \\\"version\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"description\\\": \\\"The Attavo release tag the tenant pins. The tenant holds no Attavo binary; the pinned action supplies it.\\\",\\n          \\\"pattern\\\": \\\"^v[0-9]+\\\\\\\\.[0-9]+\\\\\\\\.[0-9]+$\\\"\\n        }\\n      }\\n    },\\n    \\\"executor\\\": {\\n      \\\"type\\\": \\\"object\\\",\\n      \\\"required\\\": [\\\"build\\\"],\\n      \\\"properties\\\": {\\n        \\\"build\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"description\\\": \\\"Adapter name for the build invocation. The contract is thin: spec, corpus, and branch in; commits and a report record out.\\\",\\n          \\\"minLength\\\": 1\\n        },\\n        \\\"verify\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"description\\\": \\\"Adapter name for the verify invocation. Defaults to build's adapter; may differ.\\\",\\n          \\\"minLength\\\": 1\\n        }\\n      },\\n      \\\"additionalProperties\\\": {\\n        \\\"type\\\": \\\"object\\\",\\n        \\\"description\\\": \\\"[executor.<adapter-name>]: that adapter's own configuration, passed through as ATTAVO_ADAPTER_CONFIG and copied verbatim into build-NN.json as adapter_config. The product does not know what an adapter's settings mean -- any keys, none required. Never put a secret in here: it lands in a record.\\\"\\n      }\\n    },\\n    \\\"tests\\\": {\\n      \\\"type\\\": \\\"object\\\",\\n      \\\"description\\\": \\\"How build finds and runs the tests for a touched path. Both keys are required together; a tenant with no [tests] table has not declared selection, and attavo build refuses to run on it.\\\",\\n      \\\"additionalProperties\\\": false,\\n      \\\"required\\\": [\\\"select\\\", \\\"run\\\"],\\n      \\\"properties\\\": {\\n        \\\"select\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"description\\\": \\\"A command that reads touched paths on stdin, one per line, and writes test identifiers on stdout, one per line.\\\",\\n          \\\"minLength\\\": 1\\n        },\\n        \\\"exclude_in_executor\\\": {\\n          \\\"type\\\": \\\"array\\\",\\n          \\\"items\\\": {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1},\\n          \\\"description\\\": \\\"Test identifiers attavo test leaves out when it runs inside an executor (ATTAVO_STAGE set): tests that need a live tenant, the network, or the process's own working directory. CI runs them.\\\"\\n        },\\n        \\\"run\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"description\\\": \\\"A command that reads test identifiers on stdin, one per line; its exit code is the verdict.\\\",\\n          \\\"minLength\\\": 1\\n        },\\n        \\\"call_timeout_s\\\": {\\n          \\\"type\\\": \\\"integer\\\",\\n          \\\"minimum\\\": 1,\\n          \\\"description\\\": \\\"Seconds one `attavo test` run is given before its process group is ended and it exits 124. The executor's own test runs are bounded; the gate's are not.\\\"\\n        }\\n      }\\n    },\\n    \\\"checks\\\": {\\n      \\\"type\\\": \\\"object\\\",\\n      \\\"description\\\": \\\"The tenant's own definition of done: a whole-tree check, as the tenant runs it locally. attavo build runs it each iteration, after the claims boundary, the criteria, and the selected tests -- pass requires its exit to be 0, and a non-zero exit reaches the executor as feedback. Optional; a tenant that declares none is not refused (unlike [tests], which build requires).\\\",\\n      \\\"additionalProperties\\\": false,\\n      \\\"required\\\": [\\\"command\\\"],\\n      \\\"properties\\\": {\\n        \\\"command\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"description\\\": \\\"The tenant's whole-tree check at the gate, run from the tenant root once per iteration on the committed tree. What is fast and decisive belongs here; what the forge runs as a required check need not be run twice.\\\",\\n          \\\"minLength\\\": 1\\n        },\\n        \\\"probe\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"description\\\": \\\"A cheap command that answers whether this machine can run the checks at all, run once before a build's executor is invoked: exit 0 yes, anything else an environment refusal. When absent, attavo build asks by running [checks].command whole and reads exit 2 alone as cannot run.\\\",\\n          \\\"minLength\\\": 1\\n        },\\n        \\\"probe_timeout_s\\\": {\\n          \\\"type\\\": \\\"integer\\\",\\n          \\\"minimum\\\": 1,\\n          \\\"description\\\": \\\"Seconds [checks].probe is given; past it the build is refused as an environment stop. Required with probe: a bound the tenant did not write is a forecast.\\\"\\n        }\\n      },\\n      \\\"dependentRequired\\\": {\\\"probe\\\": [\\\"probe_timeout_s\\\"]}\\n    },\\n    \\\"forge\\\": {\\n      \\\"type\\\": \\\"object\\\",\\n      \\\"description\\\": \\\"The tenant's own commit-status and issue-tracking reads. The product names no vendor: every key is a command the tenant supplies. Optional; attavo verify refuses without checks_command, and attavo file-findings refuses without file_issue_command, but neither key requires the other.\\\",\\n      \\\"additionalProperties\\\": false,\\n      \\\"properties\\\": {\\n        \\\"checks_command\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"description\\\": \\\"Takes a full commit sha on argv; prints one line per check as \\\\\\\"<name> <conclusion>\\\\\\\". attavo verify runs it on the item's latest build record's sha before calling any adapter.\\\",\\n          \\\"minLength\\\": 1\\n        },\\n        \\\"check_log_command\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"description\\\": \\\"Takes a sha and a check name on argv; prints that check's own failed-step log. attavo counsel runs it once per check checks_command reported as not \\\\\\\"success\\\\\\\" on the counseled record's sha, before handing the adapter ATTAVO_COUNSEL_CHECKS -- absent, counsel's own record says so (forge.read: false) rather than reading the forge as if it were green.\\\",\\n          \\\"minLength\\\": 1\\n        },\\n        \\\"file_issue_command\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"description\\\": \\\"Reads one finding as JSON on stdin and files it as a tenant issue. attavo file-findings runs it once per finding in the item's latest verify record.\\\",\\n          \\\"minLength\\\": 1\\n        },\\n        \\\"issues_command\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"description\\\": \\\"Takes nothing; prints the tenant's issues, open and closed, as one JSON list of {number, title, state (open or closed), closed_at, labels, body}. The product parses each body's \\\\\\\"## Claims\\\\\\\" section itself. attavo frontier runs it once per read; absent, every reader that needs issues says \\\\\\\"not read: no [forge].issues_command\\\\\\\".\\\",\\n          \\\"minLength\\\": 1\\n        },\\n        \\\"attestation_command\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"description\\\": \\\"Reads a merge commit sha on stdin and prints that merge's attestation statement as JSON on exit 0; nothing on a non-zero exit. The doctor's fifth proof runs it once per merged, fully-staged item to require a statement in the store.\\\",\\n          \\\"minLength\\\": 1\\n        },\\n        \\\"sealed_since\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"description\\\": \\\"A commit. A merge at or before it is before the window: the tenant could not seal it (no queue, no signing workflow, or a store that held nothing yet). Defaults to the install commit; set it only for a repository that ran the product before it could seal, to the first parent of its first sealed merge, and say why in the commit that sets it.\\\",\\n          \\\"minLength\\\": 7\\n        }\\n      }\\n    },\\n    \\\"spec\\\": {\\n      \\\"type\\\": \\\"object\\\",\\n      \\\"additionalProperties\\\": false,\\n      \\\"required\\\": [\\\"boundary\\\"],\\n      \\\"properties\\\": {\\n        \\\"research\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"enum\\\": [\\\"required\\\"],\\n          \\\"description\\\": \\\"Set to \\\\\\\"required\\\\\\\" and a core spec owes a research record in the item's records before its gate passes. Absent, it owes none, and every gate record says so (ruled 2026-09-27: behind this flag until the Plan area hosts research).\\\"\\n        },\\n        \\\"boundary\\\": {\\n          \\\"type\\\": \\\"object\\\",\\n          \\\"description\\\": \\\"Which changes take the governed path. A change outside the boundary takes the tenant's ordinary pull-request flow, and the path ratio measures both.\\\",\\n          \\\"additionalProperties\\\": false,\\n          \\\"properties\\\": {\\n            \\\"paths\\\": {\\n              \\\"type\\\": \\\"array\\\",\\n              \\\"items\\\": {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1},\\n              \\\"description\\\": \\\"Glob patterns; a change touching any of them is governed.\\\"\\n            },\\n            \\\"labels\\\": {\\n              \\\"type\\\": \\\"array\\\",\\n              \\\"items\\\": {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1},\\n              \\\"description\\\": \\\"Issue labels; an issue carrying any of them is governed.\\\"\\n            },\\n            \\\"max_ordinary_lines\\\": {\\n              \\\"type\\\": \\\"integer\\\",\\n              \\\"minimum\\\": 0,\\n              \\\"description\\\": \\\"A change above this many net lines is governed regardless of path or label.\\\"\\n            }\\n          }\\n        }\\n      }\\n    },\\n    \\\"gates\\\": {\\n      \\\"type\\\": \\\"object\\\",\\n      \\\"description\\\": \\\"Every gate the tenant runs, by name. The doctor's first proof is that each one rejects its fixture; a gate absent from this table does not exist.\\\",\\n      \\\"propertyNames\\\": {\\\"pattern\\\": \\\"^[a-z][a-z0-9-]*$\\\"},\\n      \\\"additionalProperties\\\": {\\n        \\\"type\\\": \\\"object\\\",\\n        \\\"additionalProperties\\\": false,\\n        \\\"required\\\": [\\\"command\\\", \\\"retires\\\"],\\n        \\\"properties\\\": {\\n          \\\"command\\\": {\\n            \\\"type\\\": \\\"string\\\",\\n            \\\"description\\\": \\\"The script the gate runs, invoked with the tenant root as its working directory. Exit status is the verdict: non-zero rejects.\\\",\\n            \\\"minLength\\\": 1\\n          },\\n          \\\"retires\\\": {\\n            \\\"type\\\": \\\"array\\\",\\n            \\\"minItems\\\": 1,\\n            \\\"items\\\": {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1},\\n            \\\"description\\\": \\\"What this gate replaced. A gate that retires nothing is not admitted to the table.\\\"\\n          }\\n        }\\n      }\\n    },\\n    \\\"paths\\\": {\\n      \\\"type\\\": \\\"object\\\",\\n      \\\"additionalProperties\\\": false,\\n      \\\"required\\\": [\\\"specs\\\", \\\"records\\\", \\\"rulings\\\", \\\"rejections\\\"],\\n      \\\"properties\\\": {\\n        \\\"specs\\\": {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1, \\\"description\\\": \\\"Directory of specs, one per work item, named by issue number.\\\"},\\n        \\\"rejections\\\": {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1, \\\"description\\\": \\\"Directory of rejection fixtures, one subdirectory per gate name. The doctor's first proof runs each gate against its fixture and requires a rejection.\\\"},\\n        \\\"records\\\": {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1, \\\"description\\\": \\\"Directory of records, append-only, one subdirectory per work item named by issue number. Scripts write every file here.\\\"},\\n        \\\"rulings\\\": {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1, \\\"description\\\": \\\"The tenant's rulings file, rendered read-only; the merge of a proposed amendment is the ruling.\\\"}\\n      }\\n    },\\n    \\\"operators\\\": {\\n      \\\"type\\\": \\\"object\\\",\\n      \\\"additionalProperties\\\": false,\\n      \\\"required\\\": [\\\"approvers\\\"],\\n      \\\"properties\\\": {\\n        \\\"approvers\\\": {\\n          \\\"type\\\": \\\"array\\\",\\n          \\\"items\\\": {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1},\\n          \\\"description\\\": \\\"Logins allowed to bind a spec's approval to a commit. `attavo approve` refuses a LOGIN not on this list.\\\"\\n        }\\n      }\\n    },\\n    \\\"doctor\\\": {\\n      \\\"type\\\": \\\"object\\\",\\n      \\\"description\\\": \\\"Optional; the doctor's own read. Absent, proof three's window starts at the install commit, as it always has.\\\",\\n      \\\"additionalProperties\\\": false,\\n      \\\"properties\\\": {\\n        \\\"from\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"description\\\": \\\"Anything git rev-parse --verify resolves to a commit on main's first-parent line, at or after the install commit -- a full or abbreviated sha, a tag, a ref -- where proof three's window starts. A tenant that adopted the product on a repository with pre-existing history names the commit after which every push arrived through the queue. Resolved and checked against main's first-parent line, not trusted: a spelling that does not resolve, or a commit that is not on that line, is refused by name.\\\",\\n          \\\"minLength\\\": 1\\n        },\\n        \\\"built_since\\\": {\\n          \\\"type\\\": \\\"string\\\",\\n          \\\"description\\\": \\\"Anything git rev-parse --verify resolves to a commit. Proof seven (no attested item is empty) names items merged at or before it as before the window instead of failing them: the specimen that produced the proof stays on the record without failing the tenant forever. Absent, proof seven's window is proof three's.\\\",\\n          \\\"minLength\\\": 1\\n        }\\n      }\\n    },\\n    \\\"drive\\\": {\\n      \\\"type\\\": \\\"object\\\",\\n      \\\"additionalProperties\\\": false,\\n      \\\"properties\\\": {\\n        \\\"stall_after_s\\\": {\\n          \\\"type\\\": \\\"integer\\\",\\n          \\\"minimum\\\": 1,\\n          \\\"description\\\": \\\"seconds without a new event past which a live invocation is hung; attavo drive --recover terminates and records it\\\"\\n        },\\n        \\\"attempts\\\": {\\n          \\\"type\\\": \\\"integer\\\",\\n          \\\"minimum\\\": 1,\\n          \\\"description\\\": \\\"R3: attempts a stage may spend before the item is a person's; 3 when absent\\\"\\n        },\\n        \\\"retry_after_s\\\": {\\n          \\\"type\\\": \\\"integer\\\",\\n          \\\"minimum\\\": 0,\\n          \\\"description\\\": \\\"R3: seconds a transient stop waits before its next attempt; 300 when absent\\\"\\n        },\\n        \\\"build\\\": {\\n          \\\"type\\\": \\\"object\\\",\\n          \\\"additionalProperties\\\": false,\\n          \\\"properties\\\": {\\n            \\\"ceiling_s\\\": {\\\"type\\\": \\\"integer\\\", \\\"minimum\\\": 1, \\\"description\\\": \\\"R3: wall clock past which a live build is hung by its ceiling\\\"}\\n          }\\n        },\\n        \\\"verify\\\": {\\n          \\\"type\\\": \\\"object\\\",\\n          \\\"additionalProperties\\\": false,\\n          \\\"properties\\\": {\\n            \\\"ceiling_s\\\": {\\\"type\\\": \\\"integer\\\", \\\"minimum\\\": 1, \\\"description\\\": \\\"R3: wall clock past which a live review is hung by its ceiling\\\"}\\n          }\\n        }\\n      }\\n    }\\n  }\\n}\\n\",\"numLines\":269,\"startLine\":1,\"totalLines\":269}}}\n499:+{\"type\":\"assistant\",\"message\":{\"model\":\"claude-sonnet-5\",\"id\":\"msg_011CfYijwJDxhyUE25chaJjw\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_011EUnnTPrVoPxWmyC8q9SAM\",\"name\":\"Read\",\"input\":{\"file_path\":\"/Users/davidbean/Projects/attavo-worktree-267/attest/specs/267/stub/tests/test_issues.py\"},\"caller\":{\"type\":\"direct\"}}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":386,\"cache_read_input_tokens\":35102,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":386},\"output_tokens\":3,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"f2e0c4f7-36d4-465e-a2fe-27db257201e7\",\"uuid\":\"5489e063-74ad-4ab2-bc91-7479b8f10c2d\",\"timestamp\":\"2026-09-30T01:01:18.068Z\",\"request_id\":\"req_011CfYijvxczuDCjVmp7VZUQ\",\"wire_tool_inputs\":{\"toolu_011EUnnTPrVoPxWmyC8q9SAM\":{\"file_path\":\"/Users/davidbean/Projects/attavo-worktree-267/attest/specs/267/stub/tests/test_issues.py\"}}}\n500:+{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_011EUnnTPrVoPxWmyC8q9SAM\",\"type\":\"tool_result\",\"content\":\"1\\t\\\"\\\"\\\"The tenant's issues, read through [forge].issues_command\\n2\\t(attavo/issues.py). Written red first: on 5df6926 there is no\\n3\\tattavo.issues module and no issues_command in the manifest schema.\\n4\\t\\n5\\tRun: python3 -m pytest tests/test_issues.py -q\\n6\\t\\\"\\\"\\\"\\n7\\tfrom __future__ import annotations\\n8\\t\\n9\\timport json\\n10\\timport os\\n11\\timport subprocess\\n12\\timport sys\\n13\\timport tomllib\\n14\\tfrom pathlib import Path\\n15\\tfrom typing import Any\\n16\\t\\n17\\timport jsonschema\\n18\\timport pytest\\n19\\t\\n20\\tfrom attavo import issues\\n21\\t\\n22\\tROOT = Path(__file__).resolve().parent.parent\\n23\\tSCHEMA = json.loads((ROOT / \\\"schema\\\" / \\\"manifest.schema.json\\\").read_text())\\n24\\t\\n25\\tBODY = \\\"\\\"\\\"The Plan store and `attavo plan`.\\n26\\t\\n27\\tClass: core\\n28\\t\\n29\\t## Claims\\n30\\t\\n31\\t- attavo/store.py\\n32\\t- `attavo/plan.py`\\n33\\t-   tests/test_plan.py\\n34\\t\\n35\\t## Acceptance\\n36\\t\\n37\\t- not a claim\\n38\\t\\\"\\\"\\\"\\n39\\t\\n40\\t\\n41\\tdef command_printing(tmp_path: Path, payload: Any, code: int = 0, err: str = \\\"\\\") -> str:\\n42\\t    script = tmp_path / \\\"issues-cmd.py\\\"\\n43\\t    script.write_text(\\\"import sys\\\\n\\\"\\n44\\t                      f\\\"sys.stdout.write({json.dumps(payload) if not isinstance(payload, str) else payload!r})\\\\n\\\"\\n45\\t                      f\\\"sys.stderr.write({err!r})\\\\n\\\"\\n46\\t                      f\\\"sys.exit({code})\\\\n\\\")\\n47\\t    return f\\\"{sys.executable} {script}\\\"\\n48\\t\\n49\\t\\n50\\tdef test_claims_are_read_from_the_bodys_claims_section_and_nowhere_else() -> None:\\n51\\t    assert issues.parse_claims(BODY) == [\\\"attavo/store.py\\\", \\\"attavo/plan.py\\\", \\\"tests/test_plan.py\\\"]\\n52\\t    assert issues.parse_claims(\\\"no section here\\\\n- attavo/x.py\\\\n\\\") is None\\n53\\t    assert issues.parse_claims(\\\"## Claims\\\\n\\\\n## Acceptance\\\\n- a\\\\n\\\") == []\\n54\\t\\n55\\t\\n56\\tdef test_the_command_is_read_into_issues_with_their_claims_in_number_order(tmp_path: Path) -> None:\\n57\\t    payload = [\\n58\\t        {\\\"number\\\": 264, \\\"title\\\": \\\"the Plan store\\\", \\\"state\\\": \\\"closed\\\", \\\"closed_at\\\": \\\"2026-09-29T20:00:00Z\\\",\\n59\\t         \\\"labels\\\": [\\\"class:core\\\"], \\\"body\\\": BODY},\\n60\\t        {\\\"number\\\": 231, \\\"title\\\": \\\"a fix\\\", \\\"state\\\": \\\"open\\\", \\\"closed_at\\\": None, \\\"labels\\\": [], \\\"body\\\": \\\"no claims\\\"},\\n61\\t    ]\\n62\\t    m = {\\\"forge\\\": {\\\"issues_command\\\": command_printing(tmp_path, payload)}}\\n63\\t    got, why = issues.read_issues(tmp_path, m)\\n64\\t    assert why is None and got is not None\\n65\\t    assert [i[\\\"number\\\"] for i in got] == [231, 264]\\n66\\t    assert got[0][\\\"claims\\\"] is None and got[0][\\\"state\\\"] == \\\"open\\\"\\n67\\t    assert got[1][\\\"claims\\\"] == [\\\"attavo/store.py\\\", \\\"attavo/plan.py\\\", \\\"tests/test_plan.py\\\"]\\n68\\t    assert got[1][\\\"labels\\\"] == [\\\"class:core\\\"] and got[1][\\\"closed_at\\\"] == \\\"2026-09-29T20:00:00Z\\\"\\n69\\t\\n70\\t\\n71\\tdef test_no_command_is_not_read_and_never_an_empty_list(tmp_path: Path) -> None:\\n72\\t    assert issues.read_issues(tmp_path, {}) == (None, \\\"not read: no [forge].issues_command\\\")\\n73\\t    assert issues.read_issues(tmp_path, {\\\"forge\\\": {\\\"checks_command\\\": \\\"x\\\"}})[0] is None\\n74\\t\\n75\\t\\n76\\tdef test_a_failing_command_or_output_of_the_wrong_shape_is_not_read_and_says_why(tmp_path: Path) -> None:\\n77\\t    failing = {\\\"forge\\\": {\\\"issues_command\\\": command_printing(tmp_path, \\\"\\\", code=3, err=\\\"gh: not logged in\\\\n\\\")}}\\n78\\t    got, why = issues.read_issues(tmp_path, failing)\\n79\\t    assert got is None and why == \\\"not read: [forge].issues_command exited 3: gh: not logged in\\\"\\n80\\t    for payload, needle in [\\n81\\t        (\\\"not json\\\", \\\"printed no JSON\\\"),\\n82\\t        ({\\\"number\\\": 1}, \\\"not a list\\\"),\\n83\\t        ([{\\\"number\\\": 1, \\\"title\\\": \\\"t\\\", \\\"state\\\": \\\"OPEN\\\", \\\"labels\\\": [], \\\"body\\\": \\\"\\\"}], \\\"state 'OPEN'\\\"),\\n84\\t        ([{\\\"title\\\": \\\"t\\\", \\\"state\\\": \\\"open\\\"}], \\\"no issue number\\\"),\\n85\\t        ([{\\\"number\\\": 2, \\\"title\\\": \\\"t\\\", \\\"state\\\": \\\"open\\\", \\\"labels\\\": [{\\\"name\\\": \\\"x\\\"}]}], \\\"labels\\\"),\\n86\\t    ]:\\n87\\t        (tmp_path / \\\"issues-cmd.py\\\").unlink(missing_ok=True)\\n88\\t        m = {\\\"forge\\\": {\\\"issues_command\\\": command_printing(tmp_path, payload)}}\\n89\\t        got, why = issues.read_issues(tmp_path, m)\\n90\\t        assert got is None and why is not None and needle in why, (payload, why)\\n91\\t\\n92\\t\\n93\\tdef test_a_command_that_runs_past_its_bound_is_not_read(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:\\n94\\t    monkeypatch.setattr(issues, \\\"TIMEOUT_S\\\", 1)\\n95\\t    got, why = issues.read_issues(tmp_path, {\\\"forge\\\": {\\\"issues_command\\\": \\\"sleep 10\\\"}})\\n96\\t    assert got is None and why == \\\"not read: [forge].issues_command ran past 1s\\\"\\n97\\t\\n98\\t\\n99\\tdef test_the_manifest_schema_takes_issues_command_and_this_repository_declares_it() -> None:\\n100\\t    manifest = tomllib.loads((ROOT / \\\"attavo.toml\\\").read_text())\\n101\\t    jsonschema.validate(manifest, SCHEMA)\\n102\\t    command = manifest[\\\"forge\\\"][\\\"issues_command\\\"]\\n103\\t    assert command == \\\"python3 .attavo/bin/forge-issues\\\"\\n104\\t    assert (ROOT / \\\".attavo\\\" / \\\"bin\\\" / \\\"forge-issues\\\").is_file()\\n105\\t    bad = {**manifest, \\\"forge\\\": {**manifest[\\\"forge\\\"], \\\"issues_command\\\": \\\"\\\"}}\\n106\\t    with pytest.raises(jsonschema.ValidationError):\\n107\\t        jsonschema.validate(bad, SCHEMA)\\n108\\t\\n109\\t\\n110\\tdef test_this_repositorys_command_translates_the_forges_words_into_the_shape(tmp_path: Path) -> None:\\n111\\t    fake = tmp_path / \\\"bin\\\"\\n112\\t    fake.mkdir()\\n113\\t    gh_output = [{\\\"number\\\": 264, \\\"title\\\": \\\"the Plan store\\\", \\\"state\\\": \\\"CLOSED\\\", \\\"closedAt\\\": \\\"2026-09-29T20:00:00Z\\\",\\n114\\t                  \\\"labels\\\": [{\\\"name\\\": \\\"class:core\\\", \\\"color\\\": \\\"000000\\\"}], \\\"body\\\": BODY},\\n115\\t                 {\\\"number\\\": 263, \\\"title\\\": \\\"R5\\\", \\\"state\\\": \\\"OPEN\\\", \\\"closedAt\\\": None, \\\"labels\\\": [], \\\"body\\\": \\\"\\\"}]\\n116\\t    (fake / \\\"gh\\\").write_text(f\\\"#!/bin/sh\\\\ncat <<'JSON'\\\\n{json.dumps(gh_output)}\\\\nJSON\\\\n\\\")\\n117\\t    (fake / \\\"gh\\\").chmod(0o755)\\n118\\t    env = {**os.environ, \\\"PATH\\\": f\\\"{fake}{os.pathsep}{os.environ['PATH']}\\\"}\\n119\\t    run = subprocess.run([sys.executable, str(ROOT / \\\".attavo\\\" / \\\"bin\\\" / \\\"forge-issues\\\")],\\n120\\t                         capture_output=True, text=True, env=env, check=False)\\n121\\t    assert run.returncode == 0, run.stderr\\n122\\t    m = {\\\"forge\\\": {\\\"issues_command\\\": command_printing(tmp_path, run.stdout)}}\\n123\\t    got, why = issues.read_issues(tmp_path, m)\\n124\\t    assert why is None and got is not None\\n125\\t    assert [(i[\\\"number\\\"], i[\\\"state\\\"], i[\\\"labels\\\"]) for i in got] == [(263, \\\"open\\\", []),\\n126\\t                                                                     (264, \\\"closed\\\", [\\\"class:core\\\"])]\\n127\\t    assert got[1][\\\"claims\\\"] == [\\\"attavo/store.py\\\", \\\"attavo/plan.py\\\", \\\"tests/test_plan.py\\\"]\\n128\\t    (fake / \\\"gh\\\").write_text(\\\"#!/bin/sh\\\\necho 'gh: offline' >&2\\\\nexit 1\\\\n\\\")\\n129\\t    failed = subprocess.run([sys.executable, str(ROOT / \\\".attavo\\\" / \\\"bin\\\" / \\\"forge-issues\\\")],\\n130\\t                            capture_output=True, text=True, env=env, check=False)\\n131\\t    assert failed.returncode != 0 and failed.stdout == \\\"\\\"\\n132\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"f2e0c4f7-36d4-465e-a2fe-27db257201e7\",\"uuid\":\"b78de5e7-d466-4e97-83fb-da25008c92aa\",\"timestamp\":\"2026-09-30T01:01:18.079Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/davidbean/Projects/attavo-worktree-267/attest/specs/267/stub/tests/test_issues.py\",\"content\":\"\\\"\\\"\\\"The tenant's issues, read through [forge].issues_command\\n(attavo/issues.py). Written red first: on 5df6926 there is no\\nattavo.issues module and no issues_command in the manifest schema.\\n\\nRun: python3 -m pytest tests/test_issues.py -q\\n\\\"\\\"\\\"\\nfrom __future__ import annotations\\n\\nimport json\\nimport os\\nimport subprocess\\nimport sys\\nimport tomllib\\nfrom pathlib import Path\\nfrom typing import Any\\n\\nimport jsonschema\\nimport pytest\\n\\nfrom attavo import issues\\n\\nROOT = Path(__file__).resolve().parent.parent\\nSCHEMA = json.loads((ROOT / \\\"schema\\\" / \\\"manifest.schema.json\\\").read_text())\\n\\nBODY = \\\"\\\"\\\"The Plan store and `attavo plan`.\\n\\nClass: core\\n\\n## Claims\\n\\n- attavo/store.py\\n- `attavo/plan.py`\\n-   tests/test_plan.py\\n\\n## Acceptance\\n\\n- not a claim\\n\\\"\\\"\\\"\\n\\n\\ndef command_printing(tmp_path: Path, payload: Any, code: int = 0, err: str = \\\"\\\") -> str:\\n    script = tmp_path / \\\"issues-cmd.py\\\"\\n    script.write_text(\\\"import sys\\\\n\\\"\\n                      f\\\"sys.stdout.write({json.dumps(payload) if not isinstance(payload, str) else payload!r})\\\\n\\\"\\n                      f\\\"sys.stderr.write({err!r})\\\\n\\\"\\n                      f\\\"sys.exit({code})\\\\n\\\")\\n    return f\\\"{sys.executable} {script}\\\"\\n\\n\\ndef test_claims_are_read_from_the_bodys_claims_section_and_nowhere_else() -> None:\\n    assert issues.parse_claims(BODY) == [\\\"attavo/store.py\\\", \\\"attavo/plan.py\\\", \\\"tests/test_plan.py\\\"]\\n    assert issues.parse_claims(\\\"no section here\\\\n- attavo/x.py\\\\n\\\") is None\\n    assert issues.parse_claims(\\\"## Claims\\\\n\\\\n## Acceptance\\\\n- a\\\\n\\\") == []\\n\\n\\ndef test_the_command_is_read_into_issues_with_their_claims_in_number_order(tmp_path: Path) -> None:\\n    payload = [\\n        {\\\"number\\\": 264, \\\"title\\\": \\\"the Plan store\\\", \\\"state\\\": \\\"closed\\\", \\\"closed_at\\\": \\\"2026-09-29T20:00:00Z\\\",\\n         \\\"labels\\\": [\\\"class:core\\\"], \\\"body\\\": BODY},\\n        {\\\"number\\\": 231, \\\"title\\\": \\\"a fix\\\", \\\"state\\\": \\\"open\\\", \\\"closed_at\\\": None, \\\"labels\\\": [], \\\"body\\\": \\\"no claims\\\"},\\n    ]\\n    m = {\\\"forge\\\": {\\\"issues_command\\\": command_printing(tmp_path, payload)}}\\n    got, why = issues.read_issues(tmp_path, m)\\n    assert why is None and got is not None\\n    assert [i[\\\"number\\\"] for i in got] == [231, 264]\\n    assert got[0][\\\"claims\\\"] is None and got[0][\\\"state\\\"] == \\\"open\\\"\\n    assert got[1][\\\"claims\\\"] == [\\\"attavo/store.py\\\", \\\"attavo/plan.py\\\", \\\"tests/test_plan.py\\\"]\\n    assert got[1][\\\"labels\\\"] == [\\\"class:core\\\"] and got[1][\\\"closed_at\\\"] == \\\"2026-09-29T20:00:00Z\\\"\\n\\n\\ndef test_no_command_is_not_read_and_never_an_empty_list(tmp_path: Path) -> None:\\n    assert issues.read_issues(tmp_path, {}) == (None, \\\"not read: no [forge].issues_command\\\")\\n    assert issues.read_issues(tmp_path, {\\\"forge\\\": {\\\"checks_command\\\": \\\"x\\\"}})[0] is None\\n\\n\\ndef test_a_failing_command_or_output_of_the_wrong_shape_is_not_read_and_says_why(tmp_path: Path) -> None:\\n    failing = {\\\"forge\\\": {\\\"issues_command\\\": command_printing(tmp_path, \\\"\\\", code=3, err=\\\"gh: not logged in\\\\n\\\")}}\\n    got, why = issues.read_issues(tmp_path, failing)\\n    assert got is None and why == \\\"not read: [forge].issues_command exited 3: gh: not logged in\\\"\\n    for payload, needle in [\\n        (\\\"not json\\\", \\\"printed no JSON\\\"),\\n        ({\\\"number\\\": 1}, \\\"not a list\\\"),\\n        ([{\\\"number\\\": 1, \\\"title\\\": \\\"t\\\", \\\"state\\\": \\\"OPEN\\\", \\\"labels\\\": [], \\\"body\\\": \\\"\\\"}], \\\"state 'OPEN'\\\"),\\n        ([{\\\"title\\\": \\\"t\\\", \\\"state\\\": \\\"open\\\"}], \\\"no issue number\\\"),\\n        ([{\\\"number\\\": 2, \\\"title\\\": \\\"t\\\", \\\"state\\\": \\\"open\\\", \\\"labels\\\": [{\\\"name\\\": \\\"x\\\"}]}], \\\"labels\\\"),\\n    ]:\\n        (tmp_path / \\\"issues-cmd.py\\\").unlink(missing_ok=True)\\n        m = {\\\"forge\\\": {\\\"issues_command\\\": command_printing(tmp_path, payload)}}\\n        got, why = issues.read_issues(tmp_path, m)\\n        assert got is None and why is not None and needle in why, (payload, why)\\n\\n\\ndef test_a_command_that_runs_past_its_bound_is_not_read(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:\\n    monkeypatch.setattr(issues, \\\"TIMEOUT_S\\\", 1)\\n    got, why = issues.read_issues(tmp_path, {\\\"forge\\\": {\\\"issues_command\\\": \\\"sleep 10\\\"}})\\n    assert got is None and why == \\\"not read: [forge].issues_command ran past 1s\\\"\\n\\n\\ndef test_the_manifest_schema_takes_issues_command_and_this_repository_declares_it() -> None:\\n    manifest = tomllib.loads((ROOT / \\\"attavo.toml\\\").read_text())\\n    jsonschema.validate(manifest, SCHEMA)\\n    command = manifest[\\\"forge\\\"][\\\"issues_command\\\"]\\n    assert command == \\\"python3 .attavo/bin/forge-issues\\\"\\n    assert (ROOT / \\\".attavo\\\" / \\\"bin\\\" / \\\"forge-issues\\\").is_file()\\n    bad = {**manifest, \\\"forge\\\": {**manifest[\\\"forge\\\"], \\\"issues_command\\\": \\\"\\\"}}\\n    with pytest.raises(jsonschema.ValidationError):\\n        jsonschema.validate(bad, SCHEMA)\\n\\n\\ndef test_this_repositorys_command_translates_the_forges_words_into_the_shape(tmp_path: Path) -> None:\\n    fake = tmp_path / \\\"bin\\\"\\n    fake.mkdir()\\n    gh_output = [{\\\"number\\\": 264, \\\"title\\\": \\\"the Plan store\\\", \\\"state\\\": \\\"CLOSED\\\", \\\"closedAt\\\": \\\"2026-09-29T20:00:00Z\\\",\\n                  \\\"labels\\\": [{\\\"name\\\": \\\"class:core\\\", \\\"color\\\": \\\"000000\\\"}], \\\"body\\\": BODY},\\n                 {\\\"number\\\": 263, \\\"title\\\": \\\"R5\\\", \\\"state\\\": \\\"OPEN\\\", \\\"closedAt\\\": None, \\\"labels\\\": [], \\\"body\\\": \\\"\\\"}]\\n    (fake / \\\"gh\\\").write_text(f\\\"#!/bin/sh\\\\ncat <<'JSON'\\\\n{json.dumps(gh_output)}\\\\nJSON\\\\n\\\")\\n    (fake / \\\"gh\\\").chmod(0o755)\\n    env = {**os.environ, \\\"PATH\\\": f\\\"{fake}{os.pathsep}{os.environ['PATH']}\\\"}\\n    run = subprocess.run([sys.executable, str(ROOT / \\\".attavo\\\" / \\\"bin\\\" / \\\"forge-issues\\\")],\\n                         capture_output=True, text=True, env=env, check=False)\\n    assert run.returncode == 0, run.stderr\\n    m = {\\\"forge\\\": {\\\"issues_command\\\": command_printing(tmp_path, run.stdout)}}\\n    got, why = issues.read_issues(tmp_path, m)\\n    assert why is None and got is not None\\n    assert [(i[\\\"number\\\"], i[\\\"state\\\"], i[\\\"labels\\\"]) for i in got] == [(263, \\\"open\\\", []),\\n                                                                     (264, \\\"closed\\\", [\\\"class:core\\\"])]\\n    assert got[1][\\\"claims\\\"] == [\\\"attavo/store.py\\\", \\\"attavo/plan.py\\\", \\\"tests/test_plan.py\\\"]\\n    (fake / \\\"gh\\\").write_text(\\\"#!/bin/sh\\\\necho 'gh: offline' >&2\\\\nexit 1\\\\n\\\")\\n    failed = subprocess.run([sys.executable, str(ROOT / \\\".attavo\\\" / \\\"bin\\\" / \\\"forge-issues\\\")],\\n                            capture_output=True, text=True, env=env, check=False)\\n    assert failed.returncode != 0 and failed.stdout == \\\"\\\"\\n\",\"numLines\":132,\"startLine\":1,\"totalLines\":132}}}\n501:+{\"type\":\"assistant\",\"message\":{\"model\":\"claude-sonnet-5\",\"id\":\"msg_011CfYijwJDxhyUE25chaJjw\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_014PXcu2EP8jSYdkfTjeKfz1\",\"name\":\"Read\",\"input\":{\"file_path\":\"/Users/davidbean/Projects/attavo-worktree-267/attest/specs/267/stub/tests/test_record_schemas.py\"},\"caller\":{\"type\":\"direct\"}}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":386,\"cache_read_input_tokens\":35102,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":386},\"output_tokens\":3,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"f2e0c4f7-36d4-465e-a2fe-27db257201e7\",\"uuid\":\"ec1ba503-ab16-40bb-ac24-e0c47f327eb1\",\"timestamp\":\"2026-09-30T01:01:18.537Z\",\"request_id\":\"req_011CfYijvxczuDCjVmp7VZUQ\",\"wire_tool_inputs\":{\"toolu_014PXcu2EP8jSYdkfTjeKfz1\":{\"file_path\":\"/Users/davidbean/Projects/attavo-worktree-267/attest/specs/267/stub/tests/test_record_schemas.py\"}}}\n502:+{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_014PXcu2EP8jSYdkfTjeKfz1\",\"type\":\"tool_result\",\"content\":\"1\\t\\\"\\\"\\\"spec-NN.json, approval-NN.json, build-NN.json, and verify-NN.json\\n2\\tvalidate against schema/records/*.schema.json. One test over all fixture\\n3\\trecords; extend it, don't duplicate it, as new record shapes land (issue\\n4\\t#24's adapter_config, issue #40's verify, among them).\\n5\\t\\n6\\tRun: python3 -m pytest tests -q\\n7\\t\\\"\\\"\\\"\\n8\\timport importlib\\n9\\timport importlib.util\\n10\\timport json\\n11\\timport os\\n12\\timport shutil\\n13\\timport subprocess\\n14\\timport sys\\n15\\tfrom pathlib import Path\\n16\\tfrom typing import Any, cast\\n17\\t\\n18\\timport jsonschema\\n19\\timport pytest\\n20\\t\\n21\\tfrom helpers import commit_all, make_tenant\\n22\\t\\n23\\tROOT = Path(__file__).resolve().parent.parent\\n24\\tATTAVO = ROOT / \\\"bin\\\" / \\\"attavo\\\"\\n25\\tSCHEMAS_DIR = ROOT / \\\"schema\\\" / \\\"records\\\"\\n26\\t\\n27\\t\\n28\\tdef run_attavo(root: Path, *args: str) -> subprocess.CompletedProcess[str]:\\n29\\t    return subprocess.run([sys.executable, str(ATTAVO), *args], cwd=str(root),\\n30\\t                          capture_output=True, text=True, check=False)\\n31\\t\\n32\\t\\n33\\tdef load_schema(stage: str) -> dict[str, Any]:\\n34\\t    return cast(dict[str, Any], json.loads((SCHEMAS_DIR / f\\\"{stage}.schema.json\\\").read_text()))\\n35\\t\\n36\\t\\n37\\tdef attavo_module() -> Any:\\n38\\t    \\\"\\\"\\\"attavo.records imported in-process, for the write_record/load_records\\n39\\t    unit tests below that a CLI invocation cannot provoke (there is no\\n40\\t    command-line path to a record carrying a key its schema forbids).\\\"\\\"\\\"\\n41\\t    return importlib.import_module(\\\"attavo.records\\\")\\n42\\t\\n43\\t\\n44\\tdef test_records_match_their_shapes(tmp_path: Path) -> None:\\n45\\t    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n46\\t    toml = root / \\\"attavo.toml\\\"\\n47\\t    toml.write_text(toml.read_text()\\n48\\t                    + '\\\\n[executor.fixture]\\\\ny = 2\\\\n'\\n49\\t                    + '\\\\n[checks]\\\\ncommand = \\\"true\\\"\\\\n'\\n50\\t                    + \\\"\\\"\\\"\\\\n[forge]\\\\nchecks_command = \\\"printf 'ci success\\\\\\\\n'\\\"\\\\n\\\"\\\"\\\")\\n51\\t    commit_all(root, \\\"configure the fixture adapter, the tenant's checks, and the forge read\\\")\\n52\\t\\n53\\t    assert run_attavo(root, \\\"spec-gate\\\", \\\"1\\\").returncode == 0\\n54\\t    assert run_attavo(root, \\\"approve\\\", \\\"1\\\", \\\"--by\\\", \\\"alice\\\").returncode == 0\\n55\\t    assert run_attavo(root, \\\"build\\\", \\\"1\\\").returncode == 0\\n56\\t\\n57\\t    build_rec = json.loads((root / \\\"records\\\" / \\\"1\\\" / \\\"build-01.json\\\").read_text())\\n58\\t    assert build_rec[\\\"adapter_config\\\"] == {\\\"y\\\": 2}\\n59\\t    assert build_rec[\\\"checks\\\"] == {\\\"command\\\": \\\"true\\\", \\\"exit\\\": 0}\\n60\\t\\n61\\t    verify = run_attavo(root, \\\"verify\\\", \\\"1\\\")\\n62\\t    assert verify.returncode == 0\\n63\\t    verify_rec = json.loads((root / \\\"records\\\" / \\\"1\\\" / \\\"verify-01.json\\\").read_text())\\n64\\t    assert verify_rec[\\\"status\\\"] == \\\"pass\\\"\\n65\\t    assert verify_rec[\\\"findings\\\"]\\n66\\t\\n67\\t    # the build didn't touch spec.md, so the approval is still valid: this\\n68\\t    # spec-gate run writes the new spec-02.json with status \\\"approved\\\".\\n69\\t    approved = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n70\\t    assert approved.returncode == 0\\n71\\t    assert json.loads((root / \\\"records\\\" / \\\"1\\\" / \\\"spec-02.json\\\").read_text())[\\\"status\\\"] == \\\"approved\\\"\\n72\\t\\n73\\t    # issue #28: an amendment above the line expires the approval, but a\\n74\\t    # build already ran after it -- status \\\"built\\\". Issue #36: built now\\n75\\t    # judges each criterion on both on_tree and on_stub, like a pass\\n76\\t    # record; this fixture's stub also satisfies checks_built.sh, so\\n77\\t    # on_stub is 0, not null.\\n78\\t    spec_md = root / \\\"specs\\\" / \\\"1\\\" / \\\"spec.md\\\"\\n79\\t    spec_md.write_text(spec_md.read_text().replace(\\\"does not emit\\\", \\\"used to not emit\\\"))\\n80\\t    commit_all(root, \\\"amend problem prose\\\")\\n81\\t    built = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n82\\t    assert built.returncode == 0\\n83\\t    spec_03 = json.loads((root / \\\"records\\\" / \\\"1\\\" / \\\"spec-03.json\\\").read_text())\\n84\\t    assert spec_03[\\\"status\\\"] == \\\"built\\\"\\n85\\t    assert spec_03[\\\"criteria\\\"][0][\\\"on_stub\\\"] == 0\\n86\\t\\n87\\t    # Issue #69: attest never writes -- it prints a statement instead. An\\n88\\t    # explicit item id bypasses its merge-commit derivation -- the chain\\n89\\t    # this fixture already built (build-01 against approval-01, verify-01\\n90\\t    # against build-01) is exactly what attest checks, so no merge commit\\n91\\t    # is needed to prove the statement's shape.\\n92\\t    attest = run_attavo(root, \\\"attest\\\", \\\"1\\\")\\n93\\t    assert attest.returncode == 0, attest.stdout + attest.stderr\\n94\\t    statement = json.loads(attest.stdout)\\n95\\t    jsonschema.validate(statement,\\n96\\t                        json.loads((ROOT / \\\"schema\\\" / \\\"attestation.schema.json\\\").read_text()))\\n97\\t\\n98\\t    schemas = {\\\"spec\\\": load_schema(\\\"spec\\\"), \\\"approval\\\": load_schema(\\\"approval\\\"),\\n99\\t              \\\"build\\\": load_schema(\\\"build\\\"), \\\"verify\\\": load_schema(\\\"verify\\\")}\\n100\\t\\n101\\t    records = sorted((root / \\\"records\\\" / \\\"1\\\").glob(\\\"*.json\\\"))\\n102\\t    assert ({p.stem.split(\\\"-\\\")[0] for p in records}\\n103\\t           == {\\\"spec\\\", \\\"approval\\\", \\\"build\\\", \\\"verify\\\"})\\n104\\t    for path in records:\\n105\\t        stage = path.stem.split(\\\"-\\\")[0]\\n106\\t        jsonschema.validate(json.loads(path.read_text()), schemas[stage])\\n107\\t\\n108\\t    # issue #49: product_version and product_pin are not optional extras --\\n109\\t    # every record shape requires them, the same as any other field.\\n110\\t    for stage, schema in schemas.items():\\n111\\t        assert \\\"product_version\\\" in schema[\\\"required\\\"], stage\\n112\\t        assert \\\"product_pin\\\" in schema[\\\"required\\\"], stage\\n113\\t\\n114\\t    # issue #60, acceptance 1: every record write_record writes carries\\n115\\t    # record_version -- equal to that stage schema's own $id version, the\\n116\\t    # single place the version lives -- and item, matching the directory\\n117\\t    # it was written under.\\n118\\t    for path in records:\\n119\\t        stage = path.stem.split(\\\"-\\\")[0]\\n120\\t        rec = json.loads(path.read_text())\\n121\\t        assert rec[\\\"record_version\\\"] == int(schemas[stage][\\\"$id\\\"].rsplit(\\\"/\\\", 1)[-1]), stage\\n122\\t        assert rec[\\\"item\\\"] == \\\"1\\\", stage\\n123\\t\\n124\\t\\n125\\tdef test_records_carry_product_version_distinct_from_pin(tmp_path: Path) -> None:\\n126\\t    \\\"\\\"\\\"Issue #49: a record names both what ran (product_version, derived\\n127\\t    from the running checkout via git describe) and what the tenant\\n128\\t    declared (product_pin, copied verbatim from the manifest). The\\n129\\t    build_valid fixture pins v0.2.1; this checkout is not on that tag, so\\n130\\t    every record type written against it must carry both fields and they\\n131\\t    must differ -- the mismatch is a recorded fact, not an error nothing\\n132\\t    here refuses on.\\\"\\\"\\\"\\n133\\t    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n134\\t    toml = root / \\\"attavo.toml\\\"\\n135\\t    toml.write_text(toml.read_text()\\n136\\t                    + '\\\\n[executor.fixture]\\\\ny = 2\\\\n'\\n137\\t                    + '\\\\n[checks]\\\\ncommand = \\\"true\\\"\\\\n'\\n138\\t                    + \\\"\\\"\\\"\\\\n[forge]\\\\nchecks_command = \\\"printf 'ci success\\\\\\\\n'\\\"\\\\n\\\"\\\"\\\")\\n139\\t    commit_all(root, \\\"configure the fixture adapter, the tenant's checks, and the forge read\\\")\\n140\\t\\n141\\t    assert run_attavo(root, \\\"spec-gate\\\", \\\"1\\\").returncode == 0\\n142\\t    assert run_attavo(root, \\\"approve\\\", \\\"1\\\", \\\"--by\\\", \\\"alice\\\").returncode == 0\\n143\\t    assert run_attavo(root, \\\"build\\\", \\\"1\\\").returncode == 0\\n144\\t    assert run_attavo(root, \\\"verify\\\", \\\"1\\\").returncode == 0\\n145\\t\\n146\\t    running_version = subprocess.run(\\n147\\t        [\\\"git\\\", \\\"describe\\\", \\\"--tags\\\", \\\"--always\\\", \\\"--dirty\\\"],\\n148\\t        cwd=str(ROOT), capture_output=True, text=True, check=True).stdout.strip()\\n149\\t\\n150\\t    records = sorted((root / \\\"records\\\" / \\\"1\\\").glob(\\\"*.json\\\"))\\n151\\t    assert {p.stem.split(\\\"-\\\")[0] for p in records} == {\\\"spec\\\", \\\"approval\\\", \\\"build\\\", \\\"verify\\\"}\\n152\\t    for path in records:\\n153\\t        rec = json.loads(path.read_text())\\n154\\t        assert rec[\\\"product_pin\\\"] == \\\"v0.2.1\\\"\\n155\\t        assert rec[\\\"product_version\\\"] == running_version\\n156\\t        assert rec[\\\"product_version\\\"] != rec[\\\"product_pin\\\"]\\n157\\t\\n158\\t\\n159\\tdef test_product_version_unknown_when_product_root_is_not_a_git_repo(tmp_path: Path) -> None:\\n160\\t    \\\"\\\"\\\"Issue #49 follow-up: GitHub Actions extracts an action into\\n161\\t    _actions/ from a tarball, not a git checkout -- PRODUCT_ROOT there has\\n162\\t    no .git, so `git describe` fails and, unguarded, raises inside\\n163\\t    write_record: the one function that must never fail, since it runs\\n164\\t    after the work it records already happened. A copy of bin/attavo\\n165\\t    placed under a fresh, non-git tmp_path reproduces PRODUCT_ROOT with no\\n166\\t    .git without needing an actual GitHub Actions run. Red today: the\\n167\\t    KeyError this reproduces is a RuntimeError from git(), uncaught, and\\n168\\t    no record is written at all. schema/ is copied alongside bin/, same as\\n169\\t    the real action extraction: write_record reads schema/records/<stage>.schema.json\\n170\\t    from PRODUCT_ROOT (issue #60), which the action ships beside bin/.\\\"\\\"\\\"\\n171\\t    product_bin = tmp_path / \\\"product\\\" / \\\"bin\\\"\\n172\\t    product_bin.mkdir(parents=True)\\n173\\t    shutil.copy(ATTAVO, product_bin / \\\"attavo\\\")\\n174\\t    shutil.copytree(ROOT / \\\"attavo\\\", tmp_path / \\\"product\\\" / \\\"attavo\\\")\\n175\\t    shutil.copytree(ROOT / \\\"schema\\\", tmp_path / \\\"product\\\" / \\\"schema\\\")\\n176\\t\\n177\\t    root = make_tenant(tmp_path, \\\"build_valid\\\", name=\\\"tenant\\\")\\n178\\t\\n179\\t    env = dict(os.environ)\\n180\\t    env.pop(\\\"ATTAVO_PRODUCT_VERSION\\\", None)\\n181\\t    run = subprocess.run([sys.executable, str(product_bin / \\\"attavo\\\"), \\\"spec-gate\\\", \\\"1\\\"],\\n182\\t                        cwd=str(root), env=env, capture_output=True, text=True, check=False)\\n183\\t    assert run.returncode == 0, run.stderr\\n184\\t\\n185\\t    rec = json.loads((root / \\\"records\\\" / \\\"1\\\" / \\\"spec-01.json\\\").read_text())\\n186\\t    assert rec[\\\"product_version\\\"] == \\\"unknown\\\"\\n187\\t\\n188\\t\\n189\\tdef test_manifest_schema_accepts_open_executor_config() -> None:\\n190\\t    \\\"\\\"\\\"Issue #24, acceptance 5 (manifest half): [executor.<adapter-name>]\\n191\\t    is an open table -- the schema permits any keys under it, none\\n192\\t    required, alongside the existing build/verify string keys.\\\"\\\"\\\"\\n193\\t    schema = json.loads((ROOT / \\\"schema\\\" / \\\"manifest.schema.json\\\").read_text())\\n194\\t    manifest = {\\n195\\t        \\\"schema_version\\\": 1,\\n196\\t        \\\"attavo\\\": {\\\"version\\\": \\\"v0.3.1\\\"},\\n197\\t        \\\"executor\\\": {\\n198\\t            \\\"build\\\": \\\"claude-code\\\",\\n199\\t            \\\"claude-code\\\": {\\\"auth\\\": \\\"subscription\\\", \\\"some_future_key\\\": True},\\n200\\t        },\\n201\\t        \\\"spec\\\": {\\\"boundary\\\": {\\\"paths\\\": [\\\"src/**\\\"]}},\\n202\\t        \\\"gates\\\": {},\\n203\\t        \\\"paths\\\": {\\\"specs\\\": \\\"specs\\\", \\\"records\\\": \\\"records\\\",\\n204\\t                 \\\"rulings\\\": \\\"rulings.md\\\", \\\"rejections\\\": \\\"rejections\\\"},\\n205\\t        \\\"operators\\\": {\\\"approvers\\\": [\\\"alice\\\"]},\\n206\\t    }\\n207\\t    jsonschema.validate(manifest, schema)\\n208\\t\\n209\\t\\n210\\tdef base_manifest() -> dict[str, Any]:\\n211\\t    return {\\n212\\t        \\\"schema_version\\\": 1,\\n213\\t        \\\"attavo\\\": {\\\"version\\\": \\\"v0.3.3\\\"},\\n214\\t        \\\"executor\\\": {\\\"build\\\": \\\"fixture\\\"},\\n215\\t        \\\"spec\\\": {\\\"boundary\\\": {\\\"paths\\\": [\\\"src/**\\\"]}},\\n216\\t        \\\"gates\\\": {},\\n217\\t        \\\"paths\\\": {\\\"specs\\\": \\\"specs\\\", \\\"records\\\": \\\"records\\\",\\n218\\t                 \\\"rulings\\\": \\\"rulings.md\\\", \\\"rejections\\\": \\\"rejections\\\"},\\n219\\t        \\\"operators\\\": {\\\"approvers\\\": [\\\"alice\\\"]},\\n220\\t    }\\n221\\t\\n222\\t\\n223\\tdef test_manifest_schema_describes_checks() -> None:\\n224\\t    \\\"\\\"\\\"Issue #30, acceptance 4 (manifest half): [checks] is optional, with\\n225\\t    command required inside it -- a manifest with no [checks] table at\\n226\\t    all is still valid (unlike [tests], which build itself requires).\\\"\\\"\\\"\\n227\\t    schema = json.loads((ROOT / \\\"schema\\\" / \\\"manifest.schema.json\\\").read_text())\\n228\\t\\n229\\t    without_checks = base_manifest()\\n230\\t    jsonschema.validate(without_checks, schema)\\n231\\t\\n232\\t    with_checks = base_manifest()\\n233\\t    with_checks[\\\"checks\\\"] = {\\\"command\\\": \\\"python3 bin/factory-lane check --base origin/main\\\"}\\n234\\t    jsonschema.validate(with_checks, schema)\\n235\\t\\n236\\t\\n237\\t# --- issue #60: records declare their own record_version and item ---\\n238\\t\\n239\\tdef test_write_record_refuses_a_key_its_schema_does_not_declare(tmp_path: Path) -> None:\\n240\\t    \\\"\\\"\\\"Acceptance 2: write_record enforces the declared key set at write\\n241\\t    time -- a record carrying a key its stage's schema does not list under\\n242\\t    \\\"properties\\\" is refused, and nothing is written. Enforced with the\\n243\\t    standard library (set difference against the schema's own properties),\\n244\\t    not a jsonschema import into bin/attavo -- it is a single script a\\n245\\t    tenant pins, and a runtime dependency changes installation.\\\"\\\"\\\"\\n246\\t    attavo = attavo_module()\\n247\\t    schema = load_schema(\\\"spec\\\")\\n248\\t    record: dict[str, Any] = {k: None for k in schema[\\\"properties\\\"]\\n249\\t             if k not in (\\\"record_version\\\", \\\"item\\\", \\\"product_version\\\", \\\"product_pin\\\")}\\n250\\t    record[\\\"unexpected_key\\\"] = \\\"not in the schema\\\"\\n251\\t\\n252\\t    records_dir = tmp_path / \\\"records\\\" / \\\"1\\\"\\n253\\t    with pytest.raises(ValueError, match=\\\"unexpected_key\\\"):\\n254\\t        attavo.write_record(records_dir, \\\"spec\\\", record, {\\\"attavo\\\": {}}, \\\"1\\\")\\n255\\t    assert list(records_dir.glob(\\\"spec-*.json\\\")) == []\\n256\\t\\n257\\t\\n258\\tdef test_write_record_stamps_record_version_from_the_schemas_id(tmp_path: Path) -> None:\\n259\\t    \\\"\\\"\\\"Acceptance/correction point 2: record_version is read from the\\n260\\t    stage schema's own $id at call time rather than carried separately in\\n261\\t    bin/attavo, so it cannot drift from what the schema declares. Point\\n262\\t    write_record at a copy of the real build schema whose $id is bumped\\n263\\t    past what ships today, and confirm the written record follows it.\\\"\\\"\\\"\\n264\\t    attavo = attavo_module()\\n265\\t    schema_dir = tmp_path / \\\"schema\\\"\\n266\\t    (schema_dir / \\\"records\\\").mkdir(parents=True)\\n267\\t    build_schema = load_schema(\\\"build\\\")\\n268\\t    bumped = json.loads(json.dumps(build_schema))\\n269\\t    stem, _, tail = bumped[\\\"$id\\\"].rpartition(\\\"/\\\")\\n270\\t    bumped[\\\"$id\\\"] = f\\\"{stem}/{int(tail) + 1}\\\"\\n271\\t    (schema_dir / \\\"records\\\" / \\\"build.schema.json\\\").write_text(json.dumps(bumped))\\n272\\t\\n273\\t    real_schema_dir = attavo.SCHEMA_RECORDS_DIR\\n274\\t    attavo.SCHEMA_RECORDS_DIR = schema_dir / \\\"records\\\"\\n275\\t    try:\\n276\\t        record: dict[str, Any] = {k: None for k in build_schema[\\\"properties\\\"]\\n277\\t                 if k not in (\\\"record_version\\\", \\\"item\\\", \\\"product_version\\\", \\\"product_pin\\\")}\\n278\\t        path = attavo.write_record(tmp_path / \\\"records\\\" / \\\"1\\\", \\\"build\\\", record,\\n279\\t                                   {\\\"attavo\\\": {}}, \\\"1\\\")\\n280\\t    finally:\\n281\\t        attavo.SCHEMA_RECORDS_DIR = real_schema_dir\\n282\\t\\n283\\t    assert json.loads(path.read_text())[\\\"record_version\\\"] == int(tail) + 1\\n284\\t\\n285\\t\\n286\\tdef _blank_record(stage: str) -> dict[str, Any]:\\n287\\t    schema = load_schema(stage)\\n288\\t    return {k: None for k in schema[\\\"properties\\\"]\\n289\\t            if k not in (\\\"record_version\\\", \\\"item\\\", \\\"product_version\\\", \\\"product_pin\\\")}\\n290\\t\\n291\\t\\n292\\tdef test_write_record_refuses_a_failed_record_with_no_trail(tmp_path: Path) -> None:\\n293\\t    \\\"\\\"\\\"Issue #53, rejection test 1. A failed record whose log is empty and\\n294\\t    whose refusal and halted are both null explains nothing -- write_record\\n295\\t    refuses it by name and writes neither the record nor the log. Tenant\\n296\\t    zero's build-11.json, as recorded, has exactly this shape.\\\"\\\"\\\"\\n297\\t    attavo = attavo_module()\\n298\\t    record = _blank_record(\\\"build\\\")\\n299\\t    record.update({\\\"status\\\": \\\"failed\\\", \\\"refusal\\\": None, \\\"halted\\\": None})\\n300\\t\\n301\\t    records_dir = tmp_path / \\\"records\\\" / \\\"576\\\"\\n302\\t    with pytest.raises(ValueError, match=\\\"failed\\\"):\\n303\\t        attavo.write_record(records_dir, \\\"build\\\", record, {\\\"attavo\\\": {}}, \\\"576\\\", log=\\\"\\\")\\n304\\t    assert list(records_dir.glob(\\\"build-*.json\\\")) == []\\n305\\t    assert list(records_dir.glob(\\\"build-*.log\\\")) == []\\n306\\t\\n307\\t\\n308\\tdef test_write_record_accepts_a_returned_record_with_no_log(tmp_path: Path) -> None:\\n309\\t    \\\"\\\"\\\"Issue #53, rejection test 2. A returned verify record owes no log at\\n310\\t    all, because no adapter ran -- accepted, and write_record writes no log\\n311\\t    file for it. #576's verify-02 shape.\\\"\\\"\\\"\\n312\\t    attavo = attavo_module()\\n313\\t    record = _blank_record(\\\"verify\\\")\\n314\\t    record[\\\"status\\\"] = \\\"returned\\\"\\n315\\t\\n316\\t    records_dir = tmp_path / \\\"records\\\" / \\\"1\\\"\\n317\\t    path = attavo.write_record(records_dir, \\\"verify\\\", record, {\\\"attavo\\\": {}}, \\\"1\\\")\\n318\\t    assert path.exists()\\n319\\t    assert not path.with_suffix(\\\".log\\\").exists()\\n320\\t\\n321\\t\\n322\\tdef test_write_record_accepts_a_failed_record_with_a_populated_refusal(tmp_path: Path) -> None:\\n323\\t    \\\"\\\"\\\"Issue #53, lane table row 5. A failed record with a populated\\n324\\t    refusal (or halted) and an empty log is accepted -- the refusal or\\n325\\t    halted text is itself the trail the rule requires.\\\"\\\"\\\"\\n326\\t    attavo = attavo_module()\\n327\\t    record = _blank_record(\\\"build\\\")\\n328\\t    record.update({\\\"status\\\": \\\"failed\\\", \\\"refusal\\\": \\\"outside the claims boundary\\\", \\\"halted\\\": None})\\n329\\t\\n330\\t    records_dir = tmp_path / \\\"records\\\" / \\\"1\\\"\\n331\\t    path = attavo.write_record(records_dir, \\\"build\\\", record, {\\\"attavo\\\": {}}, \\\"1\\\", log=\\\"\\\")\\n332\\t    assert path.exists()\\n333\\t    assert path.with_suffix(\\\".log\\\").exists()\\n334\\t    assert path.with_suffix(\\\".log\\\").read_text() == \\\"\\\"\\n335\\t\\n336\\t\\n337\\tdef _load_check_record_schema_version() -> Any:\\n338\\t    \\\"\\\"\\\"scripts/check_record_schema_version.py -- schema_version_drift's\\n339\\t    one home. CI's schema-version job (.github/workflows/ci.yml, on\\n340\\t    pull_request and merge_group) imports the same module to run it\\n341\\t    against this repository's real schema files at the merge base and at\\n342\\t    HEAD; a merge-base read behaves differently inside pytest than in the\\n343\\t    workflow, so that comparison lives outside this suite. This test is\\n344\\t    the helper's own rejection test, run here against a mutated copy of a\\n345\\t    real schema rather than the merge base.\\\"\\\"\\\"\\n346\\t    path = ROOT / \\\"scripts\\\" / \\\"check_record_schema_version.py\\\"\\n347\\t    spec = importlib.util.spec_from_file_location(\\\"check_record_schema_version\\\", path)\\n348\\t    assert spec is not None and spec.loader is not None\\n349\\t    module = importlib.util.module_from_spec(spec)\\n350\\t    spec.loader.exec_module(module)\\n351\\t    return module\\n352\\t\\n353\\t\\n354\\tschema_version_drift = _load_check_record_schema_version().schema_version_drift\\n355\\t\\n356\\t\\n357\\tdef test_schema_shape_change_without_a_version_bump_is_refused() -> None:\\n358\\t    \\\"\\\"\\\"Acceptance 3, run against a mutated schema fixture: drop-in a new\\n359\\t    required field on the real, committed build schema without touching\\n360\\t    its $id -- refused. The identical mutation with $id bumped alongside\\n361\\t    it is not.\\\"\\\"\\\"\\n362\\t    base = load_schema(\\\"build\\\")\\n363\\t    mutated = json.loads(json.dumps(base))\\n364\\t    mutated[\\\"properties\\\"][\\\"a_new_field\\\"] = {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1}\\n365\\t    mutated[\\\"required\\\"] = mutated[\\\"required\\\"] + [\\\"a_new_field\\\"]\\n366\\t    assert schema_version_drift(base, mutated) is not None\\n367\\t\\n368\\t    bumped = json.loads(json.dumps(mutated))\\n369\\t    stem, _, tail = bumped[\\\"$id\\\"].rpartition(\\\"/\\\")\\n370\\t    bumped[\\\"$id\\\"] = f\\\"{stem}/{int(tail) + 1}\\\"\\n371\\t    assert schema_version_drift(base, bumped) is None\\n372\\t\\n373\\t    # a change carrying no shape change at all -- e.g. a description edit\\n374\\t    # -- never needs a version bump.\\n375\\t    reworded = json.loads(json.dumps(base))\\n376\\t    reworded[\\\"title\\\"] = reworded[\\\"title\\\"] + \\\" (reworded)\\\"\\n377\\t    assert schema_version_drift(base, reworded) is None\\n378\\t\\n379\\t\\n380\\tdef test_load_records_defaults_a_version_1_record_and_fills_its_item(tmp_path: Path) -> None:\\n381\\t    \\\"\\\"\\\"Acceptance 4: a record written before record_version and item\\n382\\t    shipped -- tenant zero's real shape at 3648830, common keys across 49\\n383\\t    records: ['at', 'sha'] and nothing else -- loads with record_version 1\\n384\\t    and item filled from the directory it sits under. The disk copy is\\n385\\t    never touched: version 1 is never migrated (issue #60, operator\\n386\\t    ruling 2026-09-09: record_version is a label, never a trigger for\\n387\\t    reading or upgrading an older record).\\\"\\\"\\\"\\n388\\t    attavo = attavo_module()\\n389\\t    records_dir = tmp_path / \\\"records\\\" / \\\"1\\\"\\n390\\t    records_dir.mkdir(parents=True)\\n391\\t    tenant_zero_shape = {\\\"sha\\\": \\\"a\\\" * 40, \\\"at\\\": \\\"2026-01-01T00:00:00Z\\\"}\\n392\\t    (records_dir / \\\"build-01.json\\\").write_text(json.dumps(tenant_zero_shape))\\n393\\t\\n394\\t    items = attavo.load_records(tmp_path / \\\"records\\\")\\n395\\t    rec = items[\\\"1\\\"][\\\"build\\\"]\\n396\\t    assert rec[\\\"record_version\\\"] == 1\\n397\\t    assert rec[\\\"item\\\"] == \\\"1\\\"\\n398\\t\\n399\\t    on_disk = json.loads((records_dir / \\\"build-01.json\\\").read_text())\\n400\\t    assert on_disk == tenant_zero_shape\\n401\\t\\n402\\t\\n403\\tdef test_load_records_refuses_an_item_that_disagrees_with_its_directory(tmp_path: Path) -> None:\\n404\\t    \\\"\\\"\\\"Acceptance 5: a record whose item field names a different item\\n405\\t    than the directory it was found in -- a misfiled or copied record --\\n406\\t    is refused rather than trusted.\\\"\\\"\\\"\\n407\\t    attavo = attavo_module()\\n408\\t    records_dir = tmp_path / \\\"records\\\" / \\\"1\\\"\\n409\\t    records_dir.mkdir(parents=True)\\n410\\t    (records_dir / \\\"build-01.json\\\").write_text(json.dumps(\\n411\\t        {\\\"sha\\\": \\\"a\\\" * 40, \\\"at\\\": \\\"2026-01-01T00:00:00Z\\\", \\\"item\\\": \\\"2\\\"}))\\n412\\t\\n413\\t    with pytest.raises(attavo.RecordItemMismatch):\\n414\\t        attavo.load_records(tmp_path / \\\"records\\\")\\n415\\t\\n416\\t\\n417\\tdef test_only_load_record_parses_record_file_content() -> None:\\n418\\t    \\\"\\\"\\\"Acceptance 6: _load_record is the one place in this repository\\n419\\t    that turns a <stage>-NN.json record's bytes into a dict; parse_attempts\\n420\\t    and load_records both read through it rather than calling json.loads\\n421\\t    themselves. `git grep -n \\\"json.loads(\\\" bin/attavo` still finds eleven\\n422\\t    other sites -- a schema file, attavo test's own cache of exit-0 runs\\n423\\t    under the git directory (never a record), an adapter's conformance.json (read\\n424\\t    twice: once for its declared reports, once for R3's own\\n425\\t    streams_events), an adapter's own stdout report, proof four's own\\n426\\t    read of one log line at a time to tell an adapter's JSON event\\n427\\t    stream from a tool's plain-text error (issue #94), proof five's own\\n428\\t    read of the forge's attestation statement (issue #158), and verify's\\n429\\t    own read of the forge checks a drive pass already wrote (issue #217,\\n430\\t    ATTAVO_FORGE_CHECKS), and the Plan store's two: a version\\n431\\t    of a store document, and the file `attavo plan put` is given -- working\\n432\\t    material outside git, never a record -- and the tenant's issues as\\n433\\t    [forge].issues_command prints them.\\\"\\\"\\\"\\n434\\t    text = \\\"\\\\n\\\".join(p.read_text() for p in sorted((ROOT / \\\"attavo\\\").rglob(\\\"*.py\\\")))\\n435\\t    assert text.count(\\\"json.loads(\\\") == 12, (\\n436\\t        \\\"a new json.loads( site was added; review it against issue #60 acceptance 6 \\\"\\n437\\t        \\\"and update this count\\\")\\n438\\t    assert \\\"data = json.loads(path.read_text())\\\" in text\\n439\\t\\n440\\t    for fn in (\\\"parse_attempts\\\", \\\"load_records\\\"):\\n441\\t        # The implementation is the last def of the name: the typed loaders'\\n442\\t        # @overload stubs (issue #189) precede it.\\n443\\t        start = text.rindex(f\\\"\\\\ndef {fn}(\\\")\\n444\\t        end = text.index(\\\"\\\\ndef \\\", start + 1)\\n445\\t        body = text[start:end]\\n446\\t        assert \\\"json.loads(\\\" not in body, f\\\"{fn} should read through _load_record, not parse directly\\\"\\n447\\t        assert \\\"_load_record(\\\" in body\\n448\\t\\n449\\t\\n450\\tdef test_build_and_verify_schemas_carry_what_a_stop_is_derived_from() -> None:\\n451\\t    \\\"\\\"\\\"Issue #254: refusal_kind (build) and report_class (both) are required\\n452\\t    nullable keys, and the schema's version has moved past the last one\\n453\\t    that lacked them -- record_version is how the doctor tells them apart.\\\"\\\"\\\"\\n454\\t    build, verify = load_schema(\\\"build\\\"), load_schema(\\\"verify\\\")\\n455\\t    for schema, keys, first in ((build, (\\\"refusal_kind\\\", \\\"report_class\\\"), 11),\\n456\\t                                (verify, (\\\"report_class\\\",), 10)):\\n457\\t        for key in keys:\\n458\\t            assert key in schema[\\\"required\\\"], key\\n459\\t            assert \\\"null\\\" in schema[\\\"properties\\\"][key][\\\"type\\\"], key\\n460\\t        assert int(schema[\\\"$id\\\"].rsplit(\\\"/\\\", 1)[-1]) >= first\\n461\\t    assert \\\"refusal_kind\\\" not in verify[\\\"properties\\\"]\\n462\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"f2e0c4f7-36d4-465e-a2fe-27db257201e7\",\"uuid\":\"a4dce81f-3d62-483a-b22d-f8637b1f7d6c\",\"timestamp\":\"2026-09-30T01:01:18.552Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/davidbean/Projects/attavo-worktree-267/attest/specs/267/stub/tests/test_record_schemas.py\",\"content\":\"\\\"\\\"\\\"spec-NN.json, approval-NN.json, build-NN.json, and verify-NN.json\\nvalidate against schema/records/*.schema.json. One test over all fixture\\nrecords; extend it, don't duplicate it, as new record shapes land (issue\\n#24's adapter_config, issue #40's verify, among them).\\n\\nRun: python3 -m pytest tests -q\\n\\\"\\\"\\\"\\nimport importlib\\nimport importlib.util\\nimport json\\nimport os\\nimport shutil\\nimport subprocess\\nimport sys\\nfrom pathlib import Path\\nfrom typing import Any, cast\\n\\nimport jsonschema\\nimport pytest\\n\\nfrom helpers import commit_all, make_tenant\\n\\nROOT = Path(__file__).resolve().parent.parent\\nATTAVO = ROOT / \\\"bin\\\" / \\\"attavo\\\"\\nSCHEMAS_DIR = ROOT / \\\"schema\\\" / \\\"records\\\"\\n\\n\\ndef run_attavo(root: Path, *args: str) -> subprocess.CompletedProcess[str]:\\n    return subprocess.run([sys.executable, str(ATTAVO), *args], cwd=str(root),\\n                          capture_output=True, text=True, check=False)\\n\\n\\ndef load_schema(stage: str) -> dict[str, Any]:\\n    return cast(dict[str, Any], json.loads((SCHEMAS_DIR / f\\\"{stage}.schema.json\\\").read_text()))\\n\\n\\ndef attavo_module() -> Any:\\n    \\\"\\\"\\\"attavo.records imported in-process, for the write_record/load_records\\n    unit tests below that a CLI invocation cannot provoke (there is no\\n    command-line path to a record carrying a key its schema forbids).\\\"\\\"\\\"\\n    return importlib.import_module(\\\"attavo.records\\\")\\n\\n\\ndef test_records_match_their_shapes(tmp_path: Path) -> None:\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    toml = root / \\\"attavo.toml\\\"\\n    toml.write_text(toml.read_text()\\n                    + '\\\\n[executor.fixture]\\\\ny = 2\\\\n'\\n                    + '\\\\n[checks]\\\\ncommand = \\\"true\\\"\\\\n'\\n                    + \\\"\\\"\\\"\\\\n[forge]\\\\nchecks_command = \\\"printf 'ci success\\\\\\\\n'\\\"\\\\n\\\"\\\"\\\")\\n    commit_all(root, \\\"configure the fixture adapter, the tenant's checks, and the forge read\\\")\\n\\n    assert run_attavo(root, \\\"spec-gate\\\", \\\"1\\\").returncode == 0\\n    assert run_attavo(root, \\\"approve\\\", \\\"1\\\", \\\"--by\\\", \\\"alice\\\").returncode == 0\\n    assert run_attavo(root, \\\"build\\\", \\\"1\\\").returncode == 0\\n\\n    build_rec = json.loads((root / \\\"records\\\" / \\\"1\\\" / \\\"build-01.json\\\").read_text())\\n    assert build_rec[\\\"adapter_config\\\"] == {\\\"y\\\": 2}\\n    assert build_rec[\\\"checks\\\"] == {\\\"command\\\": \\\"true\\\", \\\"exit\\\": 0}\\n\\n    verify = run_attavo(root, \\\"verify\\\", \\\"1\\\")\\n    assert verify.returncode == 0\\n    verify_rec = json.loads((root / \\\"records\\\" / \\\"1\\\" / \\\"verify-01.json\\\").read_text())\\n    assert verify_rec[\\\"status\\\"] == \\\"pass\\\"\\n    assert verify_rec[\\\"findings\\\"]\\n\\n    # the build didn't touch spec.md, so the approval is still valid: this\\n    # spec-gate run writes the new spec-02.json with status \\\"approved\\\".\\n    approved = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert approved.returncode == 0\\n    assert json.loads((root / \\\"records\\\" / \\\"1\\\" / \\\"spec-02.json\\\").read_text())[\\\"status\\\"] == \\\"approved\\\"\\n\\n    # issue #28: an amendment above the line expires the approval, but a\\n    # build already ran after it -- status \\\"built\\\". Issue #36: built now\\n    # judges each criterion on both on_tree and on_stub, like a pass\\n    # record; this fixture's stub also satisfies checks_built.sh, so\\n    # on_stub is 0, not null.\\n    spec_md = root / \\\"specs\\\" / \\\"1\\\" / \\\"spec.md\\\"\\n    spec_md.write_text(spec_md.read_text().replace(\\\"does not emit\\\", \\\"used to not emit\\\"))\\n    commit_all(root, \\\"amend problem prose\\\")\\n    built = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert built.returncode == 0\\n    spec_03 = json.loads((root / \\\"records\\\" / \\\"1\\\" / \\\"spec-03.json\\\").read_text())\\n    assert spec_03[\\\"status\\\"] == \\\"built\\\"\\n    assert spec_03[\\\"criteria\\\"][0][\\\"on_stub\\\"] == 0\\n\\n    # Issue #69: attest never writes -- it prints a statement instead. An\\n    # explicit item id bypasses its merge-commit derivation -- the chain\\n    # this fixture already built (build-01 against approval-01, verify-01\\n    # against build-01) is exactly what attest checks, so no merge commit\\n    # is needed to prove the statement's shape.\\n    attest = run_attavo(root, \\\"attest\\\", \\\"1\\\")\\n    assert attest.returncode == 0, attest.stdout + attest.stderr\\n    statement = json.loads(attest.stdout)\\n    jsonschema.validate(statement,\\n                        json.loads((ROOT / \\\"schema\\\" / \\\"attestation.schema.json\\\").read_text()))\\n\\n    schemas = {\\\"spec\\\": load_schema(\\\"spec\\\"), \\\"approval\\\": load_schema(\\\"approval\\\"),\\n              \\\"build\\\": load_schema(\\\"build\\\"), \\\"verify\\\": load_schema(\\\"verify\\\")}\\n\\n    records = sorted((root / \\\"records\\\" / \\\"1\\\").glob(\\\"*.json\\\"))\\n    assert ({p.stem.split(\\\"-\\\")[0] for p in records}\\n           == {\\\"spec\\\", \\\"approval\\\", \\\"build\\\", \\\"verify\\\"})\\n    for path in records:\\n        stage = path.stem.split(\\\"-\\\")[0]\\n        jsonschema.validate(json.loads(path.read_text()), schemas[stage])\\n\\n    # issue #49: product_version and product_pin are not optional extras --\\n    # every record shape requires them, the same as any other field.\\n    for stage, schema in schemas.items():\\n        assert \\\"product_version\\\" in schema[\\\"required\\\"], stage\\n        assert \\\"product_pin\\\" in schema[\\\"required\\\"], stage\\n\\n    # issue #60, acceptance 1: every record write_record writes carries\\n    # record_version -- equal to that stage schema's own $id version, the\\n    # single place the version lives -- and item, matching the directory\\n    # it was written under.\\n    for path in records:\\n        stage = path.stem.split(\\\"-\\\")[0]\\n        rec = json.loads(path.read_text())\\n        assert rec[\\\"record_version\\\"] == int(schemas[stage][\\\"$id\\\"].rsplit(\\\"/\\\", 1)[-1]), stage\\n        assert rec[\\\"item\\\"] == \\\"1\\\", stage\\n\\n\\ndef test_records_carry_product_version_distinct_from_pin(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Issue #49: a record names both what ran (product_version, derived\\n    from the running checkout via git describe) and what the tenant\\n    declared (product_pin, copied verbatim from the manifest). The\\n    build_valid fixture pins v0.2.1; this checkout is not on that tag, so\\n    every record type written against it must carry both fields and they\\n    must differ -- the mismatch is a recorded fact, not an error nothing\\n    here refuses on.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    toml = root / \\\"attavo.toml\\\"\\n    toml.write_text(toml.read_text()\\n                    + '\\\\n[executor.fixture]\\\\ny = 2\\\\n'\\n                    + '\\\\n[checks]\\\\ncommand = \\\"true\\\"\\\\n'\\n                    + \\\"\\\"\\\"\\\\n[forge]\\\\nchecks_command = \\\"printf 'ci success\\\\\\\\n'\\\"\\\\n\\\"\\\"\\\")\\n    commit_all(root, \\\"configure the fixture adapter, the tenant's checks, and the forge read\\\")\\n\\n    assert run_attavo(root, \\\"spec-gate\\\", \\\"1\\\").returncode == 0\\n    assert run_attavo(root, \\\"approve\\\", \\\"1\\\", \\\"--by\\\", \\\"alice\\\").returncode == 0\\n    assert run_attavo(root, \\\"build\\\", \\\"1\\\").returncode == 0\\n    assert run_attavo(root, \\\"verify\\\", \\\"1\\\").returncode == 0\\n\\n    running_version = subprocess.run(\\n        [\\\"git\\\", \\\"describe\\\", \\\"--tags\\\", \\\"--always\\\", \\\"--dirty\\\"],\\n        cwd=str(ROOT), capture_output=True, text=True, check=True).stdout.strip()\\n\\n    records = sorted((root / \\\"records\\\" / \\\"1\\\").glob(\\\"*.json\\\"))\\n    assert {p.stem.split(\\\"-\\\")[0] for p in records} == {\\\"spec\\\", \\\"approval\\\", \\\"build\\\", \\\"verify\\\"}\\n    for path in records:\\n        rec = json.loads(path.read_text())\\n        assert rec[\\\"product_pin\\\"] == \\\"v0.2.1\\\"\\n        assert rec[\\\"product_version\\\"] == running_version\\n        assert rec[\\\"product_version\\\"] != rec[\\\"product_pin\\\"]\\n\\n\\ndef test_product_version_unknown_when_product_root_is_not_a_git_repo(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Issue #49 follow-up: GitHub Actions extracts an action into\\n    _actions/ from a tarball, not a git checkout -- PRODUCT_ROOT there has\\n    no .git, so `git describe` fails and, unguarded, raises inside\\n    write_record: the one function that must never fail, since it runs\\n    after the work it records already happened. A copy of bin/attavo\\n    placed under a fresh, non-git tmp_path reproduces PRODUCT_ROOT with no\\n    .git without needing an actual GitHub Actions run. Red today: the\\n    KeyError this reproduces is a RuntimeError from git(), uncaught, and\\n    no record is written at all. schema/ is copied alongside bin/, same as\\n    the real action extraction: write_record reads schema/records/<stage>.schema.json\\n    from PRODUCT_ROOT (issue #60), which the action ships beside bin/.\\\"\\\"\\\"\\n    product_bin = tmp_path / \\\"product\\\" / \\\"bin\\\"\\n    product_bin.mkdir(parents=True)\\n    shutil.copy(ATTAVO, product_bin / \\\"attavo\\\")\\n    shutil.copytree(ROOT / \\\"attavo\\\", tmp_path / \\\"product\\\" / \\\"attavo\\\")\\n    shutil.copytree(ROOT / \\\"schema\\\", tmp_path / \\\"product\\\" / \\\"schema\\\")\\n\\n    root = make_tenant(tmp_path, \\\"build_valid\\\", name=\\\"tenant\\\")\\n\\n    env = dict(os.environ)\\n    env.pop(\\\"ATTAVO_PRODUCT_VERSION\\\", None)\\n    run = subprocess.run([sys.executable, str(product_bin / \\\"attavo\\\"), \\\"spec-gate\\\", \\\"1\\\"],\\n                        cwd=str(root), env=env, capture_output=True, text=True, check=False)\\n    assert run.returncode == 0, run.stderr\\n\\n    rec = json.loads((root / \\\"records\\\" / \\\"1\\\" / \\\"spec-01.json\\\").read_text())\\n    assert rec[\\\"product_version\\\"] == \\\"unknown\\\"\\n\\n\\ndef test_manifest_schema_accepts_open_executor_config() -> None:\\n    \\\"\\\"\\\"Issue #24, acceptance 5 (manifest half): [executor.<adapter-name>]\\n    is an open table -- the schema permits any keys under it, none\\n    required, alongside the existing build/verify string keys.\\\"\\\"\\\"\\n    schema = json.loads((ROOT / \\\"schema\\\" / \\\"manifest.schema.json\\\").read_text())\\n    manifest = {\\n        \\\"schema_version\\\": 1,\\n        \\\"attavo\\\": {\\\"version\\\": \\\"v0.3.1\\\"},\\n        \\\"executor\\\": {\\n            \\\"build\\\": \\\"claude-code\\\",\\n            \\\"claude-code\\\": {\\\"auth\\\": \\\"subscription\\\", \\\"some_future_key\\\": True},\\n        },\\n        \\\"spec\\\": {\\\"boundary\\\": {\\\"paths\\\": [\\\"src/**\\\"]}},\\n        \\\"gates\\\": {},\\n        \\\"paths\\\": {\\\"specs\\\": \\\"specs\\\", \\\"records\\\": \\\"records\\\",\\n                 \\\"rulings\\\": \\\"rulings.md\\\", \\\"rejections\\\": \\\"rejections\\\"},\\n        \\\"operators\\\": {\\\"approvers\\\": [\\\"alice\\\"]},\\n    }\\n    jsonschema.validate(manifest, schema)\\n\\n\\ndef base_manifest() -> dict[str, Any]:\\n    return {\\n        \\\"schema_version\\\": 1,\\n        \\\"attavo\\\": {\\\"version\\\": \\\"v0.3.3\\\"},\\n        \\\"executor\\\": {\\\"build\\\": \\\"fixture\\\"},\\n        \\\"spec\\\": {\\\"boundary\\\": {\\\"paths\\\": [\\\"src/**\\\"]}},\\n        \\\"gates\\\": {},\\n        \\\"paths\\\": {\\\"specs\\\": \\\"specs\\\", \\\"records\\\": \\\"records\\\",\\n                 \\\"rulings\\\": \\\"rulings.md\\\", \\\"rejections\\\": \\\"rejections\\\"},\\n        \\\"operators\\\": {\\\"approvers\\\": [\\\"alice\\\"]},\\n    }\\n\\n\\ndef test_manifest_schema_describes_checks() -> None:\\n    \\\"\\\"\\\"Issue #30, acceptance 4 (manifest half): [checks] is optional, with\\n    command required inside it -- a manifest with no [checks] table at\\n    all is still valid (unlike [tests], which build itself requires).\\\"\\\"\\\"\\n    schema = json.loads((ROOT / \\\"schema\\\" / \\\"manifest.schema.json\\\").read_text())\\n\\n    without_checks = base_manifest()\\n    jsonschema.validate(without_checks, schema)\\n\\n    with_checks = base_manifest()\\n    with_checks[\\\"checks\\\"] = {\\\"command\\\": \\\"python3 bin/factory-lane check --base origin/main\\\"}\\n    jsonschema.validate(with_checks, schema)\\n\\n\\n# --- issue #60: records declare their own record_version and item ---\\n\\ndef test_write_record_refuses_a_key_its_schema_does_not_declare(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Acceptance 2: write_record enforces the declared key set at write\\n    time -- a record carrying a key its stage's schema does not list under\\n    \\\"properties\\\" is refused, and nothing is written. Enforced with the\\n    standard library (set difference against the schema's own properties),\\n    not a jsonschema import into bin/attavo -- it is a single script a\\n    tenant pins, and a runtime dependency changes installation.\\\"\\\"\\\"\\n    attavo = attavo_module()\\n    schema = load_schema(\\\"spec\\\")\\n    record: dict[str, Any] = {k: None for k in schema[\\\"properties\\\"]\\n             if k not in (\\\"record_version\\\", \\\"item\\\", \\\"product_version\\\", \\\"product_pin\\\")}\\n    record[\\\"unexpected_key\\\"] = \\\"not in the schema\\\"\\n\\n    records_dir = tmp_path / \\\"records\\\" / \\\"1\\\"\\n    with pytest.raises(ValueError, match=\\\"unexpected_key\\\"):\\n        attavo.write_record(records_dir, \\\"spec\\\", record, {\\\"attavo\\\": {}}, \\\"1\\\")\\n    assert list(records_dir.glob(\\\"spec-*.json\\\")) == []\\n\\n\\ndef test_write_record_stamps_record_version_from_the_schemas_id(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Acceptance/correction point 2: record_version is read from the\\n    stage schema's own $id at call time rather than carried separately in\\n    bin/attavo, so it cannot drift from what the schema declares. Point\\n    write_record at a copy of the real build schema whose $id is bumped\\n    past what ships today, and confirm the written record follows it.\\\"\\\"\\\"\\n    attavo = attavo_module()\\n    schema_dir = tmp_path / \\\"schema\\\"\\n    (schema_dir / \\\"records\\\").mkdir(parents=True)\\n    build_schema = load_schema(\\\"build\\\")\\n    bumped = json.loads(json.dumps(build_schema))\\n    stem, _, tail = bumped[\\\"$id\\\"].rpartition(\\\"/\\\")\\n    bumped[\\\"$id\\\"] = f\\\"{stem}/{int(tail) + 1}\\\"\\n    (schema_dir / \\\"records\\\" / \\\"build.schema.json\\\").write_text(json.dumps(bumped))\\n\\n    real_schema_dir = attavo.SCHEMA_RECORDS_DIR\\n    attavo.SCHEMA_RECORDS_DIR = schema_dir / \\\"records\\\"\\n    try:\\n        record: dict[str, Any] = {k: None for k in build_schema[\\\"properties\\\"]\\n                 if k not in (\\\"record_version\\\", \\\"item\\\", \\\"product_version\\\", \\\"product_pin\\\")}\\n        path = attavo.write_record(tmp_path / \\\"records\\\" / \\\"1\\\", \\\"build\\\", record,\\n                                   {\\\"attavo\\\": {}}, \\\"1\\\")\\n    finally:\\n        attavo.SCHEMA_RECORDS_DIR = real_schema_dir\\n\\n    assert json.loads(path.read_text())[\\\"record_version\\\"] == int(tail) + 1\\n\\n\\ndef _blank_record(stage: str) -> dict[str, Any]:\\n    schema = load_schema(stage)\\n    return {k: None for k in schema[\\\"properties\\\"]\\n            if k not in (\\\"record_version\\\", \\\"item\\\", \\\"product_version\\\", \\\"product_pin\\\")}\\n\\n\\ndef test_write_record_refuses_a_failed_record_with_no_trail(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Issue #53, rejection test 1. A failed record whose log is empty and\\n    whose refusal and halted are both null explains nothing -- write_record\\n    refuses it by name and writes neither the record nor the log. Tenant\\n    zero's build-11.json, as recorded, has exactly this shape.\\\"\\\"\\\"\\n    attavo = attavo_module()\\n    record = _blank_record(\\\"build\\\")\\n    record.update({\\\"status\\\": \\\"failed\\\", \\\"refusal\\\": None, \\\"halted\\\": None})\\n\\n    records_dir = tmp_path / \\\"records\\\" / \\\"576\\\"\\n    with pytest.raises(ValueError, match=\\\"failed\\\"):\\n        attavo.write_record(records_dir, \\\"build\\\", record, {\\\"attavo\\\": {}}, \\\"576\\\", log=\\\"\\\")\\n    assert list(records_dir.glob(\\\"build-*.json\\\")) == []\\n    assert list(records_dir.glob(\\\"build-*.log\\\")) == []\\n\\n\\ndef test_write_record_accepts_a_returned_record_with_no_log(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Issue #53, rejection test 2. A returned verify record owes no log at\\n    all, because no adapter ran -- accepted, and write_record writes no log\\n    file for it. #576's verify-02 shape.\\\"\\\"\\\"\\n    attavo = attavo_module()\\n    record = _blank_record(\\\"verify\\\")\\n    record[\\\"status\\\"] = \\\"returned\\\"\\n\\n    records_dir = tmp_path / \\\"records\\\" / \\\"1\\\"\\n    path = attavo.write_record(records_dir, \\\"verify\\\", record, {\\\"attavo\\\": {}}, \\\"1\\\")\\n    assert path.exists()\\n    assert not path.with_suffix(\\\".log\\\").exists()\\n\\n\\ndef test_write_record_accepts_a_failed_record_with_a_populated_refusal(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Issue #53, lane table row 5. A failed record with a populated\\n    refusal (or halted) and an empty log is accepted -- the refusal or\\n    halted text is itself the trail the rule requires.\\\"\\\"\\\"\\n    attavo = attavo_module()\\n    record = _blank_record(\\\"build\\\")\\n    record.update({\\\"status\\\": \\\"failed\\\", \\\"refusal\\\": \\\"outside the claims boundary\\\", \\\"halted\\\": None})\\n\\n    records_dir = tmp_path / \\\"records\\\" / \\\"1\\\"\\n    path = attavo.write_record(records_dir, \\\"build\\\", record, {\\\"attavo\\\": {}}, \\\"1\\\", log=\\\"\\\")\\n    assert path.exists()\\n    assert path.with_suffix(\\\".log\\\").exists()\\n    assert path.with_suffix(\\\".log\\\").read_text() == \\\"\\\"\\n\\n\\ndef _load_check_record_schema_version() -> Any:\\n    \\\"\\\"\\\"scripts/check_record_schema_version.py -- schema_version_drift's\\n    one home. CI's schema-version job (.github/workflows/ci.yml, on\\n    pull_request and merge_group) imports the same module to run it\\n    against this repository's real schema files at the merge base and at\\n    HEAD; a merge-base read behaves differently inside pytest than in the\\n    workflow, so that comparison lives outside this suite. This test is\\n    the helper's own rejection test, run here against a mutated copy of a\\n    real schema rather than the merge base.\\\"\\\"\\\"\\n    path = ROOT / \\\"scripts\\\" / \\\"check_record_schema_version.py\\\"\\n    spec = importlib.util.spec_from_file_location(\\\"check_record_schema_version\\\", path)\\n    assert spec is not None and spec.loader is not None\\n    module = importlib.util.module_from_spec(spec)\\n    spec.loader.exec_module(module)\\n    return module\\n\\n\\nschema_version_drift = _load_check_record_schema_version().schema_version_drift\\n\\n\\ndef test_schema_shape_change_without_a_version_bump_is_refused() -> None:\\n    \\\"\\\"\\\"Acceptance 3, run against a mutated schema fixture: drop-in a new\\n    required field on the real, committed build schema without touching\\n    its $id -- refused. The identical mutation with $id bumped alongside\\n    it is not.\\\"\\\"\\\"\\n    base = load_schema(\\\"build\\\")\\n    mutated = json.loads(json.dumps(base))\\n    mutated[\\\"properties\\\"][\\\"a_new_field\\\"] = {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1}\\n    mutated[\\\"required\\\"] = mutated[\\\"required\\\"] + [\\\"a_new_field\\\"]\\n    assert schema_version_drift(base, mutated) is not None\\n\\n    bumped = json.loads(json.dumps(mutated))\\n    stem, _, tail = bumped[\\\"$id\\\"].rpartition(\\\"/\\\")\\n    bumped[\\\"$id\\\"] = f\\\"{stem}/{int(tail) + 1}\\\"\\n    assert schema_version_drift(base, bumped) is None\\n\\n    # a change carrying no shape change at all -- e.g. a description edit\\n    # -- never needs a version bump.\\n    reworded = json.loads(json.dumps(base))\\n    reworded[\\\"title\\\"] = reworded[\\\"title\\\"] + \\\" (reworded)\\\"\\n    assert schema_version_drift(base, reworded) is None\\n\\n\\ndef test_load_records_defaults_a_version_1_record_and_fills_its_item(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Acceptance 4: a record written before record_version and item\\n    shipped -- tenant zero's real shape at 3648830, common keys across 49\\n    records: ['at', 'sha'] and nothing else -- loads with record_version 1\\n    and item filled from the directory it sits under. The disk copy is\\n    never touched: version 1 is never migrated (issue #60, operator\\n    ruling 2026-09-09: record_version is a label, never a trigger for\\n    reading or upgrading an older record).\\\"\\\"\\\"\\n    attavo = attavo_module()\\n    records_dir = tmp_path / \\\"records\\\" / \\\"1\\\"\\n    records_dir.mkdir(parents=True)\\n    tenant_zero_shape = {\\\"sha\\\": \\\"a\\\" * 40, \\\"at\\\": \\\"2026-01-01T00:00:00Z\\\"}\\n    (records_dir / \\\"build-01.json\\\").write_text(json.dumps(tenant_zero_shape))\\n\\n    items = attavo.load_records(tmp_path / \\\"records\\\")\\n    rec = items[\\\"1\\\"][\\\"build\\\"]\\n    assert rec[\\\"record_version\\\"] == 1\\n    assert rec[\\\"item\\\"] == \\\"1\\\"\\n\\n    on_disk = json.loads((records_dir / \\\"build-01.json\\\").read_text())\\n    assert on_disk == tenant_zero_shape\\n\\n\\ndef test_load_records_refuses_an_item_that_disagrees_with_its_directory(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Acceptance 5: a record whose item field names a different item\\n    than the directory it was found in -- a misfiled or copied record --\\n    is refused rather than trusted.\\\"\\\"\\\"\\n    attavo = attavo_module()\\n    records_dir = tmp_path / \\\"records\\\" / \\\"1\\\"\\n    records_dir.mkdir(parents=True)\\n    (records_dir / \\\"build-01.json\\\").write_text(json.dumps(\\n        {\\\"sha\\\": \\\"a\\\" * 40, \\\"at\\\": \\\"2026-01-01T00:00:00Z\\\", \\\"item\\\": \\\"2\\\"}))\\n\\n    with pytest.raises(attavo.RecordItemMismatch):\\n        attavo.load_records(tmp_path / \\\"records\\\")\\n\\n\\ndef test_only_load_record_parses_record_file_content() -> None:\\n    \\\"\\\"\\\"Acceptance 6: _load_record is the one place in this repository\\n    that turns a <stage>-NN.json record's bytes into a dict; parse_attempts\\n    and load_records both read through it rather than calling json.loads\\n    themselves. `git grep -n \\\"json.loads(\\\" bin/attavo` still finds eleven\\n    other sites -- a schema file, attavo test's own cache of exit-0 runs\\n    under the git directory (never a record), an adapter's conformance.json (read\\n    twice: once for its declared reports, once for R3's own\\n    streams_events), an adapter's own stdout report, proof four's own\\n    read of one log line at a time to tell an adapter's JSON event\\n    stream from a tool's plain-text error (issue #94), proof five's own\\n    read of the forge's attestation statement (issue #158), and verify's\\n    own read of the forge checks a drive pass already wrote (issue #217,\\n    ATTAVO_FORGE_CHECKS), and the Plan store's two: a version\\n    of a store document, and the file `attavo plan put` is given -- working\\n    material outside git, never a record -- and the tenant's issues as\\n    [forge].issues_command prints them.\\\"\\\"\\\"\\n    text = \\\"\\\\n\\\".join(p.read_text() for p in sorted((ROOT / \\\"attavo\\\").rglob(\\\"*.py\\\")))\\n    assert text.count(\\\"json.loads(\\\") == 12, (\\n        \\\"a new json.loads( site was added; review it against issue #60 acceptance 6 \\\"\\n        \\\"and update this count\\\")\\n    assert \\\"data = json.loads(path.read_text())\\\" in text\\n\\n    for fn in (\\\"parse_attempts\\\", \\\"load_records\\\"):\\n        # The implementation is the last def of the name: the typed loaders'\\n        # @overload stubs (issue #189) precede it.\\n        start = text.rindex(f\\\"\\\\ndef {fn}(\\\")\\n        end = text.index(\\\"\\\\ndef \\\", start + 1)\\n        body = text[start:end]\\n        assert \\\"json.loads(\\\" not in body, f\\\"{fn} should read through _load_record, not parse directly\\\"\\n        assert \\\"_load_record(\\\" in body\\n\\n\\ndef test_build_and_verify_schemas_carry_what_a_stop_is_derived_from() -> None:\\n    \\\"\\\"\\\"Issue #254: refusal_kind (build) and report_class (both) are required\\n    nullable keys, and the schema's version has moved past the last one\\n    that lacked them -- record_version is how the doctor tells them apart.\\\"\\\"\\\"\\n    build, verify = load_schema(\\\"build\\\"), load_schema(\\\"verify\\\")\\n    for schema, keys, first in ((build, (\\\"refusal_kind\\\", \\\"report_class\\\"), 11),\\n                                (verify, (\\\"report_class\\\",), 10)):\\n        for key in keys:\\n            assert key in schema[\\\"required\\\"], key\\n            assert \\\"null\\\" in schema[\\\"properties\\\"][key][\\\"type\\\"], key\\n        assert int(schema[\\\"$id\\\"].rsplit(\\\"/\\\", 1)[-1]) >= first\\n    assert \\\"refusal_kind\\\" not in verify[\\\"properties\\\"]\\n\",\"numLines\":462,\"startLine\":1,\"totalLines\":462}}}\n506:+{\"type\":\"assistant\",\"message\":{\"model\":\"claude-sonnet-5\",\"id\":\"msg_011CfYikPZ2fSNqz5b5phjhc\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_01RavHrbJD3FYNNZ7sq6NAFM\",\"name\":\"Bash\",\"input\":{\"command\":\"ls attavo/ | grep issues; grep -n \\\"issues_command\\\" attavo.toml schema/manifest.schema.json; ls .attavo/bin/ | grep issues; grep -n \\\"issues\\\" .attavo/bin/select-tests | head; test -f tests/test_issues.py && echo exists\"},\"caller\":{\"type\":\"direct\"}}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":27986,\"cache_read_input_tokens\":35488,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":27986},\"outp
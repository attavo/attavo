ss\",\n+  \"approval_sha\": null,\n+  \"criteria\": [\n+    {\n+      \"name\": \"the-product-reads-issues-and-their-claims-through-the-tenants-command.sh\",\n+      \"on_tree\": 2,\n+      \"on_stub\": 0\n+    }\n+  ],\n+  \"refusal\": null,\n+  \"record_version\": 2,\n+  \"item\": \"267\",\n+  \"product_version\": \"v0.30.0\",\n+  \"product_pin\": \"v0.30.0\"\n+}\ndiff --git a/attest/specs/267/criteria/the-product-reads-issues-and-their-claims-through-the-tenants-command.sh b/attest/specs/267/criteria/the-product-reads-issues-and-their-claims-through-the-tenants-command.sh\nnew file mode 100755\nindex 0000000..9f41b3b\n--- /dev/null\n+++ b/attest/specs/267/criteria/the-product-reads-issues-and-their-claims-through-the-tenants-command.sh\n@@ -0,0 +1,39 @@\n+#!/bin/sh\n+set -e\n+here=$(pwd)\n+tmp=$(mktemp -d \"${TMPDIR:-/tmp}/attavo.XXXXXX\")\n+mkdir -p \"$tmp/bin\"\n+cat > \"$tmp/bin/gh\" <<'GH'\n+#!/bin/sh\n+cat <<'JSON'\n+[{\"number\": 7, \"title\": \"seven\", \"state\": \"OPEN\", \"closedAt\": null, \"labels\": [{\"name\": \"class:fix\"}], \"body\": \"x\\n\\n## Claims\\n\\n- src/a.py\\n- `src/b.py`\\n\\n## Acceptance\\n\\n- not a claim\\n\"},\n+ {\"number\": 3, \"title\": \"three\", \"state\": \"CLOSED\", \"closedAt\": \"2026-09-29T00:00:00Z\", \"labels\": [], \"body\": \"no section\"}]\n+JSON\n+GH\n+chmod +x \"$tmp/bin/gh\"\n+PATH=\"$tmp/bin:$PATH\" python3 \"$here/.attavo/bin/forge-issues\" > \"$tmp/issues.json\"\n+printf 'import sys\\nsys.stdout.write(open(sys.argv[1]).read())\\n' > \"$tmp/cmd.py\"\n+cd \"$tmp\"\n+python3 - \"$here\" \"$tmp\" <<'PY'\n+import sys\n+from pathlib import Path\n+sys.path.insert(0, sys.argv[1])\n+from attavo import issues\n+tmp = Path(sys.argv[2])\n+got, why = issues.read_issues(tmp, {\"forge\": {\"issues_command\": f\"{sys.executable} {tmp}/cmd.py {tmp}/issues.json\"}})\n+assert why is None, why\n+assert [(i[\"number\"], i[\"state\"], i[\"labels\"], i[\"claims\"]) for i in got] == [\n+    (3, \"closed\", [], None), (7, \"open\", [\"class:fix\"], [\"src/a.py\", \"src/b.py\"])], got\n+none, why = issues.read_issues(tmp, {})\n+assert none is None and why == \"not read: no [forge].issues_command\", why\n+bad, why = issues.read_issues(tmp, {\"forge\": {\"issues_command\": \"exit 4\"}})\n+assert bad is None and why.startswith(\"not read: [forge].issues_command exited 4\"), why\n+PY\n+cd \"$here\"\n+grep -q '^issues_command = \"python3 .attavo/bin/forge-issues\"$' attavo.toml\n+grep -q '\"issues_command\"' schema/manifest.schema.json\n+for t in test_claims_are_read_from_the_bodys_claims_section_and_nowhere_else test_the_command_is_read_into_issues_with_their_claims_in_number_order test_no_command_is_not_read_and_never_an_empty_list test_a_failing_command_or_output_of_the_wrong_shape_is_not_read_and_says_why test_a_command_that_runs_past_its_bound_is_not_read test_the_manifest_schema_takes_issues_command_and_this_repository_declares_it test_this_repositorys_command_translates_the_forges_words_into_the_shape\n+do\n+  grep -q \"^def $t(\" tests/test_issues.py\n+done\n+rm -rf \"$tmp\"\ndiff --git a/attest/specs/267/spec.md b/attest/specs/267/spec.md\nnew file mode 100644\nindex 0000000..6e0181a\n--- /dev/null\n+++ b/attest/specs/267/spec.md\n@@ -0,0 +1,41 @@\n+## Problem\n+\n+Class: core\n+\n+The issue is the unit of work (ruled 2026-09-29). The plan in the store (#264) orders issues and says nothing else about them: an issue's title, whether it is open, when it closed, its labels, and the paths it claims before it has a spec all live in the forge. The product cannot read any of them. `frontier.py`, session tooling outside the product, reads open issues with `gh` directly. The screen's unclassed queue calls `gh` itself. Epic progress (closed issues over all issues under an epic) and the waves (which open issues can start, given their claims) both need this read, and the product names no vendor.\n+\n+The product already reads the forge through commands the tenant declares: `checks_command`, `check_log_command`, `file_issue_command` and `attestation_command`. This item adds a fifth, `[forge].issues_command`. It takes nothing and prints the tenant's issues, open and closed, as one JSON list of `{number, title, state, closed_at, labels, body}`.\n+\n+`attavo/issues.py` runs it, bounded at 60 s by `run_bounded`, and returns the issues in number order. Each issue's `claims` are parsed from its body's `## Claims` section: one `- path` line each, up to the next `## ` heading, with backticks stripped. An issue with no such section has `claims` None, which is not the same as a section that lists nothing. The product parses the claims, not the tenant's command, so every tenant's issues are read by one rule.\n+\n+A read that cannot be made is \"not read\" with its reason, never an empty list:\n+\n+- no command in the manifest;\n+- a non-zero exit, with the command's last stderr line;\n+- a run past its bound;\n+- output that is not JSON;\n+- an entry of the wrong shape, including a state other than `open` or `closed`, which is how the forge's own `OPEN` would show if a tenant's command passed it through.\n+\n+This repository declares `issues_command = \"python3 .attavo/bin/forge-issues\"`. That script calls `gh issue list --state all` and translates the forge's words (upper-case states, label objects) into the shape. It exits non-zero with nothing on stdout when the forge cannot be read, or when the list would be cut at its limit.\n+\n+The schema declares the new key, and the forge description no longer says there are two keys. `tests/test_record_schemas.py` counts the `json.loads(` sites under `attavo/`: the count moves from 11 to 12, and its docstring names this one (the issues as the command prints them, never a record). The selector maps `attavo/issues.py` and `.attavo/bin/forge-issues` to `tests/test_issues.py`.\n+\n+Nothing reads `read_issues` yet. `attavo frontier` (FR) is its first reader, and the screen's unclassed queue can move onto it afterwards. FI is filed ahead of FR so FR's stub stands on a merged read.\n+\n+The stub under `stub/` is the change on `5df6926`: the module, the script, the manifest line, the schema key, the selector lines, the count, and seven tests in `tests/test_issues.py`, all red on `5df6926`. `python3 -m mypy` exits 0 on the change. The suite passes on it, except four doctor proofs that read this repository's own history, which a scratch copy cannot supply; they fail identically on `5df6926` there.\n+\n+Retires: `gh` calls to read issues outside the product, first `frontier.py --github`'s issue read, once FR reads through this; and an issue's Claims section as prose that nothing in the product parses.\n+\n+## Claims\n+\n+- attavo/issues.py\n+- .attavo/bin/forge-issues\n+- .attavo/bin/select-tests\n+- attavo.toml\n+- schema/manifest.schema.json\n+- tests/test_issues.py\n+- tests/test_record_schemas.py\n+\n+## Criteria\n+\n+- the-product-reads-issues-and-their-claims-through-the-tenants-command.sh: this repository's `forge-issues`, with a stand-in `gh` on PATH, prints two issues that `read_issues` reads in number order, with states lower-cased, label names, the Claims of the one whose body has a section (backticks stripped, the Acceptance line left out) and None for the other; no command reads \"not read: no [forge].issues_command\", and a command exiting 4 reads \"not read: [forge].issues_command exited 4\"; `attavo.toml` declares the command and the schema names the key; and `tests/test_issues.py` carries the seven tests named\ndiff --git a/attest/specs/267/stub/.attavo/bin/forge-issues b/attest/specs/267/stub/.attavo/bin/forge-issues\nnew file mode 100644\nindex 0000000..154bd25\n--- /dev/null\n+++ b/attest/specs/267/stub/.attavo/bin/forge-issues\n@@ -0,0 +1,51 @@\n+#!/usr/bin/env python3\n+\"\"\"forge-issues: [forge].issues_command for this repository.\n+\n+Prints every issue in this repository, open and closed, as one JSON list\n+of {number, title, state, closed_at, labels, body}, the shape\n+schema/manifest.schema.json names for [forge].issues_command. The\n+product parses each body's \"## Claims\" section itself; this script only\n+translates the forge's words (\"OPEN\", label objects) into that shape.\n+\n+Exits non-zero, printing nothing to stdout, when the forge cannot be\n+read: the product reads that as \"not read\", never as no issues.\n+\n+Usage: forge-issues\n+Requires: `gh`, authenticated, run inside this repository's checkout.\n+\"\"\"\n+from __future__ import annotations\n+\n+import json\n+import subprocess\n+import sys\n+\n+LIMIT = 2000\n+\n+\n+def main() -> int:\n+    run = subprocess.run(\n+        [\"gh\", \"issue\", \"list\", \"--state\", \"all\", \"--limit\", str(LIMIT),\n+         \"--json\", \"number,title,state,closedAt,labels,body\"],\n+        capture_output=True, text=True, timeout=50, check=False,\n+    )\n+    if run.returncode != 0:\n+        print(run.stderr.strip() or \"forge-issues: gh issue list failed\", file=sys.stderr)\n+        return 1\n+    try:\n+        raw = json.loads(run.stdout)\n+    except json.JSONDecodeError:\n+        print(\"forge-issues: gh printed no JSON\", file=sys.stderr)\n+        return 1\n+    if len(raw) >= LIMIT:\n+        print(f\"forge-issues: {LIMIT} issues or more; the list would be cut short\", file=sys.stderr)\n+        return 1\n+    out = [{\"number\": i[\"number\"], \"title\": i[\"title\"], \"state\": str(i[\"state\"]).lower(),\n+            \"closed_at\": i.get(\"closedAt\") or None,\n+            \"labels\": [lb[\"name\"] for lb in i.get(\"labels\") or []],\n+            \"body\": i.get(\"body\") or \"\"} for i in raw]\n+    print(json.dumps(out))\n+    return 0\n+\n+\n+if __name__ == \"__main__\":\n+    sys.exit(main())\ndiff --git a/attest/specs/267/stub/.attavo/bin/select-tests b/attest/specs/267/stub/.attavo/bin/select-tests\nnew file mode 100644\nindex 0000000..2763d1b\n--- /dev/null\n+++ b/attest/specs/267/stub/.attavo/bin/select-tests\n@@ -0,0 +1,145 @@\n+#!/usr/bin/env python3\n+\"\"\
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/zsh -lc \"sed -n '500,555p' /Users/davidbean/Projects/attest/attavo/build.py; sed -n '1,180p' /Users/davidbean/Projects/attest/attavo/stops.py; sed -n '720,820p' /Users/davidbean/Projects/attest/adapters/claude-code/run; sed -n '1080,1175p' /Users/davidbean/Projects/attest/adapters/claude-code/run; sed -n '1,180p' /Users/davidbean/Projects/attest/adapters/README.md; sed -n '1,210p' /Users/davidbean/Projects/attest/adapters/claude-code/README.md; sed -n '1,150p' /Users/davidbean/Projects/attest/attavo/retry.py 2>/dev/null || true; sed -n '793,885p' /Users/davidbean/Projects/attest/attavo/drive.py\"","aggregated_output":"            env = dict(os.environ)\n            # #212 retired the checks command reaching the executor; an\n            # ATTAVO_CHECKS_COMMAND exported by whoever launched `attavo\n            # build` must not reach it by inheritance either.\n            env.pop(\"ATTAVO_CHECKS_COMMAND\", None)\n            env[\"ATTAVO_SPEC_DIR\"] = str(spec_dir)\n            env[\"ATTAVO_RECORDS_DIR\"] = str(item_records_dir)\n            env[\"ATTAVO_RULINGS\"] = str(root / m[\"paths\"][\"rulings\"])\n            env[\"ATTAVO_BRANCH\"] = branch\n            env[\"ATTAVO_ITERATION\"] = str(iteration)\n            env[\"ATTAVO_FEEDBACK\"] = str(feedback_path)\n            env[\"ATTAVO_ADAPTER_CONFIG\"] = json.dumps(adapter_config)\n            env[\"ATTAVO_STAGE\"] = \"build\"\n            env[\"ATTAVO_EVENTS\"] = str(events_path)\n            env[\"ATTAVO_TEST_COMMAND\"] = f\"python3 {PRODUCT_ROOT / 'bin' / 'attavo'} test {item_id}\"\n            if tests_cfg.get(\"call_timeout_s\"):\n                env[\"ATTAVO_TEST_TIMEOUT_S\"] = str(tests_cfg[\"call_timeout_s\"])\n            else:\n                env.pop(\"ATTAVO_TEST_TIMEOUT_S\", None)\n            env[\"GIT_AUTHOR_NAME\"] = identity[\"name\"]\n            env[\"GIT_AUTHOR_EMAIL\"] = identity[\"email\"]\n            env[\"GIT_COMMITTER_NAME\"] = identity[\"name\"]\n            env[\"GIT_COMMITTER_EMAIL\"] = identity[\"email\"]\n\n            run = subprocess.run([str(adapter_path)], cwd=str(root), env=env,\n                                 capture_output=True, text=True, check=False)\n            transcript, payload = split_adapter_stdout(run.stdout)\n            if run.returncode != 0:\n                # The guarantee behind issue #53's refusal: an adapter that\n                # exits non-zero always leaves a non-empty log, even one\n                # that printed nothing at all on stderr.\n                detail = f\"[adapter exited {run.returncode}]\"\n                if run.stderr.strip():\n                    detail += \"\\n\" + run.stderr.rstrip(\"\\n\")\n                transcript = (transcript + \"\\n\" if transcript else \"\") + detail\n            transcripts.append(transcript)\n\n            if run.returncode != 0 or payload is None or not payload.get(\"model\"):\n                status_out = \"failed\"\n                break\n\n            adapter_version = payload.get(\"adapter_version\")\n            model = payload.get(\"model\")\n            model_version = payload.get(\"model_version\")\n            tok = payload.get(\"tokens\") or {}\n            tokens[\"input\"] += tok.get(\"input\", 0) or 0\n            tokens[\"output\"] += tok.get(\"output\", 0) or 0\n            iter_cost = payload.get(\"cost_usd\")\n            if iter_cost is not None:\n                cost_usd = (cost_usd or 0) + iter_cost\n\n            if payload.get(\"status\") == \"question\":\n                status_out = \"halted\"\n                halted = {\"question\": payload.get(\"question\")}\n                break\n\nfrom __future__ import annotations\n\nimport json\nimport re\nimport sys\nfrom pathlib import Path\nfrom typing import Any, cast\n\nfrom attavo.common import MANIFEST, read_manifest\nfrom attavo.records import parse_attempts, stage_schema\nfrom attavo.types import CounselRecord, Stop\n\n# --- stop: every non-pass build or verify record's class and cause (issue\n# #89) -- derived here, at write time, from the record's own structured\n# fields and what the caller knows structurally (issue #241). The\n# transcript decides neither class nor provenance: the executor reads this\n# repository's records and docs, which name every class. ---\n\n# no-cause is the doctor's phrase for a record that predates `stop`; nothing\n# derives it.\nSTOP_CLASSES = (\"non-question\", \"outlived-invocation\", \"no-cause\", \"forge-unconcluded\",\n               \"ceiling\", \"claims-boundary\", \"repeated-act\", \"unclassed\", \"question\",\n               \"environment\", \"gate\", \"died\", \"hung\", \"transient\", \"returned\", \"empty\",\n               \"foreign-commit\")\n\n# R3: the four families a pass retries with no person involved -- every\n# other class is counsel's to read first, and a person's when counsel says\n# so (or when counsel is not configured at all).\nRETRYABLE_CLASSES = (\"died\", \"hung\", \"transient\", \"returned\")\n\n\ndef signature_of(text: str | None) -> str | None:\n    \"\"\"R3: a failure's signature, compared between attempts by plain string\n    equality -- text with every run of digits removed, so two stops that\n    differ only in a pid, a timestamp, or a retry-after count still match.\n    None for no text at all (nothing to sign).\"\"\"\n    if not text:\n        return None\n    stripped = re.sub(r\"[0-9]+\", \"\", text).strip()\n    return stripped or None\n\n\nSTOP_PROVENANCES = (\"product\", \"tenant\", \"executor\", \"spec\")\n\n# Issue #100's followups: an unclassed detail is the log's last line\n# verbatim, and that line is sometimes an adapter's own event JSON or a\n# tool's full error text -- thousands of characters wide. Capped here,\n# at write time, so a filed issue's own summary of it (file-stops'\n# log_tail already carries the full picture) stays short; the class\n# itself, \"unclassed\", already says the full explanation lives in the\n# log, not in this field.\nUNCLASSED_DETAIL_MAX_CHARS = 200\n\n\ndef _log_last_line(log: str | None) -> str:\n    lines = [l for l in (log or \"\").splitlines() if l.strip()]\n    last = lines[-1] if lines else \"\"\n    return last[:UNCLASSED_DETAIL_MAX_CHARS]\n\n\ndef _first_red(gate: dict[str, Any] | None) -> str | None:\n    \"\"\"The first red element of a build's gate, named: a criterion, then the\n    selected tests, then the checks; None when the gate is absent or green.\"\"\"\n    if not gate:\n        return None\n    for c in gate.get(\"criteria\") or []:\n        if c[\"exit\"] != 0:\n            return f\"criterion {c['name']}: exit {c['exit']}\"\n    tests = gate.get(\"selected_tests\")\n    if tests and tests[\"exit\"] != 0:\n        return f\"selected tests: exit {tests['exit']}, {tests['count']} selected\"\n    checks = gate.get(\"checks\")\n    if checks and checks[\"exit\"] != 0:\n        return f\"checks: exit {checks['exit']}\"\n    return None\n\n\ndef derive_stop(status: str, *, report_class: str | None = None,\n                halted: dict[str, Any] | None = None, refusal_kind: str | None = None,\n                refusal: str | None = None, gate: dict[str, Any] | None = None,\n                log: str | None = None) -> Stop | None:\n    \"\"\"The stop field for a build or verify record: None for status \"pass\",\n    else {class, provenance, detail} from the record's own structure and\n    what the caller knows of it, in this order, and nothing else decides:\n\n      - returned: forge-unconcluded/tenant (verify's own declaration)\n      - report_class, the adapter's report-line class, when it names a\n        STOP_CLASSES member: that class/executor\n      - a halt carrying a non-empty question: question/spec, detail the\n        question's first line\n      - refused, by refusal_kind: claims -> claims-boundary/spec; protected\n        (paths.records or paths.specs) -> claims-boundary/executor;\n        foreign-commit -> foreign-commit/tenant; detail the refusal\n      - failed with a red gate element: gate/executor, detail naming the\n        first red one\n      - anything else: unclassed/product, detail the log's last line\n        (capped at UNCLASSED_DETAIL_MAX_CHARS)\n\n    The log supplies the detail of unclassed and nothing more.\"\"\"\n    if status == \"pass\":\n        return None\n    if status == \"returned\":\n        return {\"class\": \"forge-unconcluded\", \"provenance\": \"tenant\", \"detail\": None}\n    if report_class in STOP_CLASSES:\n        return {\"class\": report_class, \"provenance\": \"executor\", \"detail\": None}\n    question = (halted or {}).get(\"question\")\n    if status == \"halted\" and question:\n        return {\"class\": \"question\", \"provenance\": \"spec\",\n               \"detail\": question.splitlines()[0]}\n    if status == \"refused\":\n        if refusal_kind == \"claims\":\n            return {\"class\": \"claims-boundary\", \"provenance\": \"spec\", \"detail\": refusal}\n        if refusal_kind == \"protected\":\n            return {\"class\": \"claims-boundary\", \"provenance\": \"executor\", \"detail\": refusal}\n        if refusal_kind == \"foreign-commit\":\n            return {\"class\": \"foreign-commit\", \"provenance\": \"tenant\", \"detail\": refusal}\n    if status == \"failed\":\n        red = _first_red(gate)\n        if red:\n            return {\"class\": \"gate\", \"provenance\": \"executor\", \"detail\": red}\n    return {\"class\": \"unclassed\", \"provenance\": \"product\", \"detail\": _log_last_line(log)}\n\n\ndef gate_of(criteria: list[dict[str, Any]] | None, selected_tests: dict[str, Any] | None,\n            checks: dict[str, Any] | None) -> dict[str, Any]:\n    \"\"\"The gate derive_stop reads, from the three fields a build record\n    carries it in (issue #254): the writer builds it here from the values\n    it is about to store, and the doctor rebuilds it here from the stored\n    ones, so the two cannot disagree about what the gate was.\"\"\"\n    return {\"criteria\": [{\"name\": c[\"name\"], \"exit\": c[\"exit\"]} for c in criteria or []],\n            \"selected_tests\": ({\"count\": selected_tests[\"count\"], \"exit\": selected_tests[\"exit\"]}\n                               if selected_tests else None),\n            \"checks\": {\"exit\": checks[\"exit\"]} if checks else None}\n\n\n# The forge's own conclusions, read by verify before any judge is called.\nFORGE_OK_CONCLUSIONS = {\"success\", \"neutral\", \"skipped\"}\n\n# issue #84: a concluded check's second token is a conclusion --\n# FORGE_OK_CONCLUSIONS, or another concluded one such as failure,\n# cancelled, or timed_out; an unconcluded check's is a status instead,\n# one of these. drive's own poll (poll_forge_checks) is the one reader\n# that needs to tell a still-running check apart from a concluded, not-ok\n# one -- read_forge_checks itself only ever needed \"green or not\".\nFORGE_UNCONCLUDED_STATUSES = {\"queued\", \"in_progress\", \"pending\", \"waiting\"}\n\n\ndef returned_stop(forge_checks: dict[str, Any]) -> dict[str, Any]:\n    \"\"\"R3 (ruling C amended): a review the forge returned because a\n    required check concluded red is class returned, retryable -- the\n    next build attempt is handed the evidence -- signed by the sorted\n    names of the checks that concluded red. A review returned because\n    the checks have not concluded at all yet (nothing to sign) stays\n    forge-unconcluded, as before -- there is no rejection to hand a\n    build, only a wait that already has its own bound (the drive\n    forge-poll bound, unchanged by this item).\"\"\"\n    conclusions = forge_checks.get(\"conclusions\") or []\n    red = sorted(c[\"name\"] for c in conclusions\n                if c[\"conclusion\"] not in FORGE_OK_CONCLUSIONS\n                and c[\"conclusion\"] not in FORGE_UNCONCLUDED_STATUSES)\n    unconcluded = [c for c in conclusions if c[\"conclusion\"] in FORGE_UNCONCLUDED_STATUSES]\n    if red and not unconcluded:\n        detail = \", \".join(f\"{c['name']} {c['conclusion']}\" for c in conclusions if c[\"name\"] in red)\n        return {\"class\": \"returned\", \"provenance\": \"tenant\", \"detail\": detail,\n               \"signature\": signature_of(\" \".join(red)), \"bound\": None}\n    stop = dict(derive_stop(\"returned\") or {})\n    return {**stop, \"signature\": None, \"bound\": None}\n\n\ndef blocking_titles(findings: list[dict[str, Any]] | None) -> list[str]:\n    \"\"\"The sorted titles of a review's blocking findings: any makes the\n    review failed with class returned, whatever else it reported.\"\"\"\n    return sorted(f[\"title\"] for f in findings or [] if str(f.get(\"severity\")) == \"blocking\")\n\n\n# The first record_version at which a build / verify record carries what\n# its stop was derived from (refusal_kind, report_class): the doctor\n# re-derives the stop of a record at or after it, and counts the rest.\nSTOP_REDERIVABLE_FROM = {\"build\": 11, \"verify\": 10}\n\n    \"\"\"\"done\" (no halt at all), \"fail\" (a question too short or absent to\n    be worth a person's judgment -- MIN_QUESTION_CHARS, unchanged since\n    v0.15.0), \"report\" (long enough but carries no \"?\" -- issue #88's\n    class A, a status update in the question channel), or \"question\" (a\n    real question).\"\"\"\n    if status != \"question\":\n        return \"done\"\n    if not question or len(question) < MIN_QUESTION_CHARS:\n        # An absent or too-short question is a report with nothing in\n        # it: a status update in the question channel (issue #150, three\n        # specimens on 2026-09-17), never an exit with no report line.\n        return \"report\"\n    if \"?\" not in question:\n        return \"report\"\n    return \"question\"\n\n\n# R3: a vendor's capacity, rate, or 5xx refusal is transient -- classed on\n# this adapter's own report line, the same way non-question already is\n# (issue #88), so a pass retries it plainly instead of paying for a\n# counsel run on a stop the definition of done never touches (#194's own\n# verify-01, closed by the item this adapter now serves).\nTRANSIENT_MARKERS = (\"overloaded\", \"rate limit\", \"rate_limit\", \"429\", \"500\", \"502\", \"503\", \"529\",\n                    \"internal server error\", \"service unavailable\", \"temporarily unavailable\")\n\n\ndef transient_detail(response: dict) -> str | None:\n    \"\"\"response.get(\"result\")'s own text when is_error and it names one of\n    TRANSIENT_MARKERS; else None -- an is_error for any other reason (an\n    auth mismatch, a malformed request) is not this.\"\"\"\n    if not response.get(\"is_error\"):\n        return None\n    text = str(response.get(\"result\") or \"\")\n    low = text.lower()\n    return text if any(marker in low for marker in TRANSIENT_MARKERS) else None\n\n\ndef subagent_refusal(response: dict) -> str | None:\n    \"\"\"None if response carries no spawned background work; else the\n    refusal naming the counts (issue #88, class B). Checked on the\n    response itself, not the flag that was supposed to forbid it --\n    tenant zero's specimen spawned three with the tool absent from\n    --allowedTools entirely, so the flag alone is not the mechanism.\"\"\"\n    stats = response.get(\"subagent_stats\") or {}\n    spawned = stats.get(\"spawned\") or 0\n    if not spawned:\n        return None\n    killed = stats.get(\"killed\") or {}\n    killed_total = sum(v or 0 for v in killed.values())\n    return (\n        f\"adapters/claude-code/run: refused: subagent_stats.spawned={spawned} \"\n        f\"-- the {' or '.join(SUBAGENT_TOOLS)} tool spawned work that can \"\n        f\"outlive this invocation (completed={stats.get('completed', 0)}, \"\n        f\"killed={killed_total}, \"\n        f\"started_in_background={stats.get('started_in_background', 0)})\")\n\n\ndef load_canned_responses() -> list[dict] | None:\n    \"\"\"None when ATTAVO_ADAPTER_RESPONSE_FILE is unset. Otherwise the\n    queue this run answers from: a single object repeats for every\n    invocation this adapter makes (unchanged since v0.3.0 -- most tests\n    make exactly one), a JSON array is consumed in order, one response\n    per invocation, its last element repeating once exhausted (issue\n    #88: the non-question retry is a second invocation inside the same\n    adapter run, and a canned test needs to hand it a different answer\n    than the first). Distinct from ATTAVO_ADAPTER_STREAM_FILE below: a\n    canned response here is the final report object itself, the shape\n    the model-derivation and report-field tests exercise, never a stream\n    to map -- unaffected by --output-format actually being stream-json\n    on a real invocation.\"\"\"\n    response_file = os.environ.get(\"ATTAVO_ADAPTER_RESPONSE_FILE\")\n    if not response_file:\n        return None\n    raw = json.loads(Path(response_file).read_text())\n    return raw if isinstance(raw, list) else [raw]\n\n\ndef load_canned_stream() -> list[str] | None:\n    \"\"\"None when ATTAVO_ADAPTER_STREAM_FILE is unset. Otherwise a\n    recorded `claude --output-format stream-json --verbose` transcript,\n    one JSONL line per list entry (issue #26, acceptance row 3) -- fed\n    through the same line-by-line mapping and terminal \"result\" read a\n    real invocation gets, so the mapping is exercised without a live\n    `claude` process.\"\"\"\n    stream_file = os.environ.get(\"ATTAVO_ADAPTER_STREAM_FILE\")\n    if not stream_file:\n        return None\n    return Path(stream_file).read_text().splitlines()\n\n\ndef parse_stream_line(line: str) -> dict | None:\n    \"\"\"One parsed JSONL line, or None when it is blank or not JSON -- a\n    tracing line on the same stream is not an error, just not an event\n    (codex's own parse_events does the same).\"\"\"\n    line = line.strip()\n    if not line:\n        return None\n    try:\n        return json.loads(line)\n    except ValueError:\n        return None\n            if common is not None:\n                print(json.dumps({**common, \"class\": \"transient\", \"detail\": detail}))\n        return 1\n\n    refusal = subagent_refusal(response)\n    if refusal:\n        sys.stderr.write(refusal + \"\\n\")\n        return 1\n\n    structured = response.get(\"structured_output\") or {}\n\n    if verifying:\n        common = report_fields(response, config.get(\"model\"))\n        if common is None:\n            return 1\n        # .get(), not \"or []\": an absent findings key must reach\n        # cmd_verify as None, distinct from an explicit empty list --\n        # that distinction is the whole fix for issue #46.\n        line = {**common,\n               \"findings\": structured.get(\"findings\"),\n               \"tests_named\": structured.get(\"tests_named\")}\n        print(json.dumps(line))\n        return 0\n\n    if counseling:\n        common = report_fields(response, config.get(\"model\"))\n        if common is None:\n            return 1\n        line = {**common,\n               \"class\": structured.get(\"class\"),\n               \"verdict\": structured.get(\"verdict\"),\n               \"citations\": structured.get(\"citations\"),\n               \"proposal\": structured.get(\"proposal\")}\n        print(json.dumps(line))\n        return 0\n\n    status = structured.get(\"status\", \"done\")\n    question = structured.get(\"question\")\n    cls = question_class(status, question)\n\n    if cls == \"fail\":\n        return 1\n\n    if cls == \"report\":\n        # Issue #88, class A: a report in the question channel is\n        # re-instructed once, in this same invocation, before it ever\n        # reaches a person.\n        reinstruction = instruction + \"\\n\\n\" + REINSTRUCTION\n        cmd2 = build_command(reinstruction, config, schema, stage)\n        exit_code2, response2 = invoke_once(cmd2, responses, 1, events_path)\n        if exit_code2 is not None:\n            return exit_code2\n        if response2.get(\"is_error\") or not response2.get(\"structured_output\"):\n            return 1\n        refusal2 = subagent_refusal(response2)\n        if refusal2:\n            sys.stderr.write(refusal2 + \"\\n\")\n            return 1\n\n        structured2 = response2.get(\"structured_output\") or {}\n        status2 = structured2.get(\"status\", \"done\")\n        question2 = structured2.get(\"question\")\n        cls2 = question_class(status2, question2)\n        if cls2 == \"fail\":\n            return 1\n\n        common2 = report_fields(response2, config.get(\"model\"))\n        if common2 is None:\n            return 1\n        # A non-question costs two executor turns, not one: sum both\n        # calls' tokens and cost into the one report line this\n        # invocation gets, whatever the retry's own outcome -- only\n        # adapter_version/model/model_version stay the second call's.\n        tokens1_input, tokens1_output, cost1 = usage_fields(response)\n        common2[\"tokens\"][\"input\"] += tokens1_input\n        common2[\"tokens\"][\"output\"] += tokens1_output\n        common2[\"cost_usd\"] = add_cost(common2[\"cost_usd\"], cost1)\n\n        if cls2 == \"report\":\n            # Two reports in a row: still a halt (someone must look),\n            # but the transcript above already carries both raw\n            # results, and this report line names the class so a\n            # reader -- or a future record field, not this one -- can\n            # tell it apart from a genuine question.\n            print(\"adapters/claude-code/run: halted: class non-question \"\n                  \"-- the executor reported instead of asking, twice in \"\n                  \"a row\")\n            line = {**common2, \"status\": \"question\", \"question\": question2,\n                   \"class\": \"non-question\"}\n            print(json.dumps(line))\n            return 0\n\n        line = {**common2, \"status\": status2, \"question\": question2}\n        print(json.dumps(line))\n        return 0\n\n# Adapters\n\nAn adapter is an executable at `adapters/<name>/run`, resolved first under\nthe tenant's `attavo/adapters/`, then under this product's `adapters/`.\n`attavo build` invokes it with the tenant root as its working directory.\n\n## Environment\n\n- `ATTAVO_SPEC_DIR` — the work item's spec directory (`spec.md`, `criteria/`, `stub/`).\n- `ATTAVO_RECORDS_DIR` — the work item's own records directory.\n- `ATTAVO_RULINGS` — the tenant's rulings file (`paths.rulings`).\n- `ATTAVO_BRANCH` — the branch the adapter must commit on.\n- `ATTAVO_ITERATION` — the 1-based attempt number within this `attavo build` invocation.\n- `ATTAVO_FEEDBACK` — a file holding the previous iteration's failing criteria, test output, and checks output; empty on the first iteration.\n- `ATTAVO_ADAPTER_CONFIG` — the tenant manifest's `[executor.<adapter-name>]` table, serialized as JSON (`{}` when the tenant declared none). The product does not know what an adapter's settings mean; each adapter documents its own keys on its own `README.md`. **Never put a secret in this table** — it is copied verbatim into `build-NN.json` as `adapter_config`, and a record is not where secrets live.\n- `ATTAVO_TEST_COMMAND` — build only: the one test command the executor is given, `attavo test <N>` (issue #212). It runs the tests the tenant's `[tests].select` names for every path the item has changed since it left the default branch, committed or not, through `[tests].run`, and exits as the run does. An adapter tells the executor to run it while working, and not to run the whole test suite or any whole-tree check: the tenant's `[checks].command` is run at the gate after every commit, and a command the executor is named is a command the executor runs (#194's build-01 waited 590 s on the suite inside the executor). The tenant's checks command is not part of the contract.\n- `ATTAVO_TEST_TIMEOUT_S` — build only, set with `ATTAVO_TEST_COMMAND` when the tenant declares `[tests].call_timeout_s`: the seconds one `attavo test` run is given before it is ended and exits 124. An adapter says so in the same sentence; absent, it says nothing about a bound.\n- `ATTAVO_STAGE` — `\"build\"`, `\"verify\"`, or `\"counsel\"` (issue #100), which invocation this is. An adapter that supports every stage branches on it; one that only builds may ignore it.\n- `ATTAVO_EVENTS` — build and verify only: a file path an adapter may append events to while it runs (issue #26). Absent on a stage that does not set it (counsel does not); an adapter that never checks for it breaks nothing.\n- `ATTAVO_DIFF` — verify only: a file holding the diff since the build's approval.\n- `ATTAVO_BUILD_RECORD` — verify only: the path to the `build-NN.json` being verified.\n- `ATTAVO_COUNSEL_RECORD` — counsel only: the path to the non-pass `build-NN.json`/`verify-NN.json` being counseled.\n- `ATTAVO_COUNSEL_LOG` — counsel only: the path to that record's own `.log`, empty when it has none.\n- `ATTAVO_COUNSEL_DIFF` — counsel only: a file holding the item's diff since approval (the same diff verify itself would compute).\n- `ATTAVO_MANIFEST` — counsel only: the path to the tenant's own `attavo.toml`.\n- `ATTAVO_PRODUCT_ROOT` — counsel only: the path to this product's own root (`bin/attavo`, `adapters/`, `schema/`, `templates/`), so a stop whose cause is the product's own mechanism can be read at it.\n- `GIT_AUTHOR_NAME`, `GIT_AUTHOR_EMAIL`, `GIT_COMMITTER_NAME`, `GIT_COMMITTER_EMAIL` — build only: the executor's identity (issue #33), set by the product and never the tenant's git config. An adapter must not override these for the commits it makes; a commit build finds not carrying this identity is refused.\n\n### The executor sees none of it (issue #198)\n\nThe variables above are the adapter's contract, not the executor's. An\nadapter launches its executor with every `ATTAVO_*` name removed from the\nchild's environment and keeps reading its own. The executor's tools would\notherwise inherit `ATTAVO_EVENTS`, the item's live events file, and write\nto it: a test suite the executor runs that runs `adapters/fixture/run`\nappended 26 of 83 lines to one item's events file (attavo/attavo#194,\nbuild-01). The adapters here pass `executor_env()` from\n`adapters/executor_env.py` as `env=` to the process that runs the\nexecutor; a tenant's own adapter does the same, by that helper's rule\n(drop every name starting `ATTAVO_`, keep the rest). Situations 20 and 21\nof `tests/test_executor_conformance.py` check it through the tool binary\neach `conformance.json` names. Probes of the tool itself (`--version`)\nare not the executor.\n\n## Output\n\nThe adapter commits its work on the current branch itself. It prints one\nJSON object on its last stdout line:\n\n```json\n{\"status\": \"done\" | \"question\", \"question\": null | \"<text>\",\n \"model\": \"<id>\", \"model_version\": \"<id or null>\",\n \"adapter_version\": \"<tool version>\",\n \"tokens\": {\"input\": n, \"output\": n}, \"cost_usd\": n | null}\n```\n\nA `\"question\"` line may also carry `\"class\": \"non-question\"` (see below);\n`attavo build` reads only `status`/`question` off this line and does not\nknow about the extra field.\n\nAnything else on stdout is the adapter's transcript and is saved beside the\nbuild record as `build-NN.log`, never inside the record.\n\nAn adapter never writes a record. `attavo build` writes the one\n`build-NN.json` for the whole invocation. What it must do with a tool\nerror, an absent report, or a bad question is `tests/test_executor_conformance.py`,\nrun against every `adapters/<name>/conformance.json` it declares.\n\n## Events (issue #26)\n\n`ATTAVO_EVENTS`, when set, names a file the adapter may append events to\nwhile it runs, mapping its own executor's stream into one JSON object\nper line, flushed on every write:\n\n```json\n{\"at\": \"<iso8601, seconds>\", \"kind\": \"message\" | \"tool_call\" | \"tool_result\",\n \"text\": \"<one line, capped at 400 characters>\"}\n```\n\n`text` is the executor's own words for `message`, the tool's name and its\nfirst argument for `tool_call`, and the tool's result's first line for\n`tool_result`. The product appends its own `iteration` and `gate` events\nto the same file (each iteration's start, and each criterion's exit,\nfrom the loop that already runs them) and, for `attavo counsel`, never\nopens the file at all -- events belong to a running stage, not a\nread-only judgment of one already finished.\n\nThe file is never a record and is never committed: it is not among the\npaths `commit_record` names, and a tenant's `.gitignore` is not touched\nfor it, since an uncommitted file in an item's own worktree is already\ninvisible to the ledger and the doctor. An adapter that never writes to\nit breaks nothing -- the file is simply absent, and the screen renders\nthe feed it has without one.\n\n## Counsel (issue #100)\n\nWith `ATTAVO_STAGE=counsel`, the report line carries `class`, `verdict`,\n`citations`, and `proposal` instead of `status`/`question`:\n\n```json\n{\"class\": \"<stop class, or \\\"unclassed\\\">\",\n \"verdict\": \"answer\" | \"patch\" | \"person\",\n \"citations\": [{\"kind\": \"instruction\" | \"mechanism\" | \"guard\",\n                \"path\": \"<path>\" | null, \"symbol\": \"<symbol>\" | null,\n                \"ruling_id\": \"<id>\" | null}, ...],\n \"proposal\": {\"ruling_text\": \"<text>\" | null,\n              \"patch\": {\"file\": \"<path>\", \"symbol\": \"<symbol>\",\n                        \"rejection_test\": \"<test>\", \"diff\": \"<unified diff>\"} | null,\n              \"question\": \"<one line>\" | null},\n \"model\": \"<id>\", \"model_version\": \"<id or null>\",\n \"adapter_version\": \"<tool version>\",\n \"tokens\": {\"input\": n, \"output\": n}, \"cost_usd\": n | null}\n```\n\nCounsel is read-only -- the same sandbox verify runs under -- and it\nnever acts: `proposal` carries a ruling's text or a patch's diff, never\na write or a commit. `adapters/<name>/conformance.json` declares which\nstages an adapter supports as `\"stages\"`; an adapter naming no\n`\"counsel\"` there has not been pointed at this stage.\n\n## Two stops (issue #88)\n\nA `\"question\"` is not always a question. A status report landing in the\nquestion channel (\"I've traced the spec's 5 criteria and dispatched an\nimplementation agent…\") halts an item to a person exactly like a real\nquestion does, but the person has nothing to rule on. Every adapter\ntherefore treats a `\"question\"` whose text clears the length gate but\ncarries no `\"?\"` as a report, not a question: it re-invokes the executor\nonce more, in the same invocation, appending \"your last answer was a\nreport, not a question; either continue to done, or ask one question\nending in a question mark that names the spec line or guard you cannot\nresolve\" to the same instruction. A proper question or a `\"done\"` on the\nretry ends the invocation normally, at the cost of one extra executor\nturn; a second report in a row still halts (someone must look), but its\nreport line carries `\"class\": \"non-question\"` and both raw results\nalready reached the transcript above it. No record field changes: the\nclass lives in the transcript and the report line, not in\n`build-NN.json`.\n\nThe report line's own `tokens` and `cost_usd` sum both calls, whatever\nthe retry's outcome — the record's cost matches the two executor turns\nactually spent, not just the second one; only `model`/`model_version`/\n`adapter_version` come from the second call.\n\nWork can also outlive the invocation that started it: a tool that spawns\nits own background subagents can report `\"done\"` and exit while those\nsubagents are still running or still being torn down, so the checks\n`attavo build` runs right after `\"done\"` land on a tree something else\nis still writing. An adapter whose tool can do this must refuse the run\nby name -- exit 1, with the counts -- rather than report `\"done\"` on it;\n`adapters/<name>/conformance.json` names this ability as\n`\"subagent_guard\": {\"supported\": true, \"situation\": \"<name>\"}` or, when\nthe tool has no such concept to check at all, `{\"supported\": false,\n\"reason\": \"<why>\"}` -- an adapter naming neither is an undeclared blind\nspot, not a legitimate absence (`tests/test_executor_conformance.py`\nenforces this the same way it enforces `\"reports\"`).\n# adapters/claude-code\n\nRuns `claude -p` against the spec. Configured through `[executor.claude-code]`\nin the tenant's manifest (see `../README.md` for how that table reaches the\nadapter as `ATTAVO_ADAPTER_CONFIG`, and lands verbatim in `build-NN.json` as\n`adapter_config`). **Never put a secret in this table** — it lands in a\nrecord.\n\n## Keys\n\n- `auth` — `\"api\"` (default) or `\"subscription\"`.\n  - `\"api\"`: runs with `--bare`. Requires `ANTHROPIC_API_KEY`; usage bills per token.\n  - `\"subscription\"`: omits `--bare`; adds `--setting-sources user` and `--strict-mcp-config` so the tenant's project hooks and MCP servers do not load (`CLAUDE.md` still does). Runs on the operator's subscription login; usage is included in the plan. `ANTHROPIC_API_KEY` is not required.\n- `model` — omitted means the executor's default. When set, passed as `--model`, and trusted verbatim as the record's `model` rather than picked out of the tool's own usage report (issue #77).\n- `setting_sources` — default `\"user\"`. Only meaningful in subscription mode; ignored in api mode (`--bare` already excludes everything).\n- `permission_mode` — default `\"acceptEdits\"`.\n- `allowed_tools` is retired (issue #78): a manifest that still declares `[executor.claude-code].allowed_tools` is refused by name rather than silently accepted or ignored. See below.\n\n## The tenant's tests\n\n`attavo build` runs the tenant's gates after each commit and feeds a\nfailure back on the next iteration — the executor is not the runner of the\ntenant's checks, and is not told what they are. When `ATTAVO_TEST_COMMAND`\nis set (`../README.md`), the instruction gives it: \"to run tests while you\nwork, run `<command>`: it runs the tests selected for the files you have\nchanged and stops at `<N>` s. Do not run the whole test suite or any\nwhole-tree check yourself: after you commit, the gates are run for you and\nany failure is returned to you on the next iteration.\" The \"stops at\" clause\nis present only when `ATTAVO_TEST_TIMEOUT_S` is set. When\n`ATTAVO_TEST_COMMAND` is unset, the instruction says nothing about tests.\n\n## The sandbox is the boundary, not an allowed_tools list\n\nEvery invocation carries `--settings` with a `sandbox` object\n(`sandbox.enabled: true`, `allowUnsandboxedCommands: false`,\n`network.allowedDomains: []`) — confirmed live against `claude 2.1.268`:\nthe sandbox refuses a write outside the working directory and any\noutbound connection, at the OS level, before `--allowedTools` is ever\nconsulted. Verify's `--settings` additionally sets\n`filesystem.denyWrite` on the working directory itself, so \"make no\nedits, write no files\" is mechanical rather than merely instructed.\n`--allowedTools` is therefore fixed per stage to the tool names the\nsandbox does not itself govern — `Read,Edit,Write,Bash` for build,\n`Read,Bash` for verify — not a curated `Bash(git *)`-style prefix list a\ntenant used to grow one denial at a time; `[executor.claude-code]` no\nlonger has a key for it. The network stays closed for both stages; an\nexecutor that needs a package index is a tenant fact for a later\nmanifest key, not this one.\n\nThe raw result's `permission_denials` (in `build-NN.log` since `v0.3.4`)\nstill exists, but a Bash tool call the sandbox will refuse at the OS\nlevel is never denied at the permission layer in the first place — a\nrefusal there shows up as the underlying shell command's own non-zero\nexit in the transcript, not as a `permission_denials` entry.\n\n## cost_usd is a meter, not always a bill\n\n`build-NN.json`'s `cost_usd` is this adapter's report of the tool's\nlist-price meter. It is billed only when `adapter_config.auth` (this\ntable's `auth` key) is `\"api\"`. Under `auth = \"subscription\"`, the same\nfigure is a measure of usage against the operator's plan, not a charge —\nthat build ran on the subscription login, not an API key.\n\n## The raw result\n\nThe whole `--output-format json` result is printed to stdout before this\nadapter's own final line, so `attavo build` saves it verbatim as the\ntranscript in `build-NN.log` — the tool's own account of what happened,\nincluding fields (`num_turns`, `duration_ms`, `is_error`,\n`permission_denials`) the final line never carries. `is_error: true`, no\n`structured_output` at all, or a `status: \"question\"` whose `question` is\nmissing or under 40 characters all make the adapter exit 1 (build records\nthe attempt `failed`) instead of a halt someone has to rule on — a\nquestion worth a person's judgment is at least a sentence.\n\n## A report is not a question (issue #88)\n\nA `status: \"question\"` whose text clears the 40-character gate but\ncarries no `\"?\"` is a report, not a question — five of tenant zero's\ntwelve non-pass build records were exactly this (\"I've traced the\nspec's 5 criteria against the tree and dispatched an implementation\nagent…\"), each costing a person a read and a re-launch for nothing to\nrule on. This adapter re-invokes `claude` once more on a report,\nappending a line asking it to either continue to done or ask a real\nquestion, before ever reporting a halt. A second report in a row still\nhalts, but its report line carries `\"class\": \"non-question\"` and both\nraw results already reached the transcript above it — see `../README.md`.\n`tokens` and `cost_usd` on that line sum both calls; `model`,\n`model_version`, and `adapter_version` come from the second call only.\n\n## Work that can outlive the invocation (issue #88)\n\nConfirmed live against `claude 2.1.269`: a prompt encouraging a\nsubagent produced `subagent_stats.spawned: 1` when the Agent tool was\nallowed, and `0` with `\"Agent\"` alone in `--disallowedTools` — the\ntool's own reply named `Workflow` as the other path to background work,\nso both are disallowed by name on every invocation, both stages.\nTenant zero's own specimen (`#659` build-01) spawned three with neither\ntool in `--allowedTools` at all, so the flag is checked after the fact\ntoo: any response whose `subagent_stats.spawned` is not zero is refused\nby name, with the counts, rather than accepted as `done` — a build the\ntool's own background work could still be writing to.\n# --- R3: the retry decision, shared by the report's own kind/says and the\n# pass's own act (retry_state) so the two cannot drift. ---\n\n# Never retried by this item, whatever counsel might rule: a\n# claims-boundary stop is a person's; a tenant's gate refusal is the\n# spec-gate's own, earlier than any of this; an environment refusal is\n# recorded here and acted on by R4's breaker. A question is not in this\n# tuple -- counsel reads it exactly like any other non-pass record, and\n# an \"answer\" verdict starts the next attempt steered by it, the same as\n# any class counsel can rule on; a question nobody answers (no counsel\n# configured, or its own verdict is \"person\") simply never becomes\n# eligible, with no exclusion needed to keep it that way.\nNEVER_RETRIED_CLASSES = (\"claims-boundary\", \"gate\", \"environment\")\n\n\ndef _budget_stage(stage: str, stop_class: str | None) -> str:\n    \"\"\"The stage whose [drive].attempts budget a stop spends -- build for\n    a returned review (the check rejection or the blocking finding is the\n    build's to answer, never the review's own to repeat), the stop's own\n    stage for everything else.\"\"\"\n    return \"build\" if stop_class == \"returned\" else stage\n\n\ndef _signatures_match(records_dir: Path, stage: str) -> bool:\n    \"\"\"Whether the last two attempts of stage carry the identical,\n    non-null signature -- the early stop (R3): two attempts of one stage\n    ending the same way spend no third.\"\"\"\n    attempts = parse_attempts(records_dir, stage)\n    if len(attempts) < 2:\n        return False\n    nums = sorted(attempts)\n    sig_a = (attempts[nums[-1]].get(\"stop\") or {}).get(\"signature\")\n    sig_b = (attempts[nums[-2]].get(\"stop\") or {}).get(\"signature\")\n    return sig_a is not None and sig_a == sig_b\n\n\nclass RetryState(NamedTuple):\n    \"\"\"Whether a plain pass, right now, would start the next attempt of a\n    stopped stage (R3) -- eligible; a transient stop still short of\n    [drive].retry_after_s carries waiting_s instead, eligible for neither\n    a plain pass nor `--again`'s own no-op read of the same fact; steer\n    names the counsel record an \"answer\" verdict would hand the next\n    attempt; target_stage is the stage the next attempt actually starts\n    (build, for a returned review).\"\"\"\n    eligible: bool\n    waiting_s: float | None\n    steer: str | None\n    target_stage: str\n\n\ndef retry_state(root: Path, m: dict[str, Any], records_dir: Path, stage: str,\n                stop_class: str | None, attempt: int | None) -> RetryState:\n    \"\"\"The one read behind both the report's own kind/says (a stopped\n    stage that would retry reads as \"acts\" or \"waits\", never \"yours\") and\n    the pass's own act, so the two cannot say different things about the\n    same stop. died, hung, transient, and returned retry with no counsel\n    asked, inside the shared budget and past the early stop; every other\n    class retries only when counsel's own verdict for this exact stop is\n    \"answer\" -- and never when the class is one of NEVER_RETRIED_CLASSES,\n    whatever counsel might have said.\"\"\"\n    target_stage = _budget_stage(stage, stop_class)\n    if stop_class is None or stop_class in NEVER_RETRIED_CLASSES or attempt is None:\n        return RetryState(False, None, None, target_stage)\n    spent = next_attempt_number(records_dir, target_stage) - 1\n    if spent >= attempts_budget(m):\n        return RetryState(False, None, None, target_stage)\n    if _signatures_match(records_dir, stage):\n        return RetryState(False, None, None, target_stage)\n    if stop_class in RETRYABLE_CLASSES:\n        if stop_class == \"transient\":\n            attempts = parse_attempts(records_dir, stage)\n            rec = attempts.get(attempt)\n            age = _seconds_since(rec.get(\"at\")) if rec else None\n            wait = retry_after_s(m)\n            if age is not None and age < wait:\n                return RetryState(False, wait - age, None, target_stage)\n        return RetryState(True, None, None, target_stage)\n    counsel = counsel_record_for(records_dir, stage, attempt)\n    if counsel is not None and counsel.get(\"verdict\") == \"answer\":\n        target = f\"{stage}-{attempt:02d}\"\n        counsel_attempts = parse_attempts(records_dir, \"counsel\")\n        matches = [n for n, rec in counsel_attempts.items() if rec.get(\"record\") == target]\n        if matches:\n            return RetryState(True, None, f\"counsel-{max(matches):02d}\", target_stage)\n    return RetryState(False, None, None, target_stage)\n\n\ndef _pass_once(root: Path, m: dict[str, Any], item_id: str, again: str | None) -> tuple[int, \"DriveReport\"]:\n    \"\"\"One pass: fast-forward to origin (never while a worker holds the\n    copy), read the report, act at most once, return. owes-recovery\n    recovers; next-build and next-review start their stage, handing a\n    review the checks the report already read once on the pre-marker\n    head; blocked-on-checks on a review (R3) starts it too -- the same\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\"class\":\"unclassed\",\"verdict\":\"answer\",\"citations\":[{\"kind\":\"instruction\",\"path\":\"adapters/claude-code/README.md\",\"symbol\":\"Keys / auth\",\"ruling_id\":null},{\"kind\":\"mechanism\",\"path\":\"adapters/claude-code/run\",\"symbol\":\"transient_detail\",\"ruling_id\":null},{\"kind\":\"guard\",\"path\":\"attavo/drive.py\",\"symbol\":\"retry_state\",\"ruling_id\":null}],\"proposal\":{\"ruling_text\":\"The build did not reach the item: the Claude Code subscription OAuth session expired and could not be refreshed. This is not a transient vendor-capacity failure and changes none of the specification or definition of done. Reauthenticate the operator's Claude Code subscription session, then retry this build; the existing unclassed stop requires this counsel answer before the retry is eligible.\",\"patch\":null,\"question\":null,\"issue\":null}}"}}

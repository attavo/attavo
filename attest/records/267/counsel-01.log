{"class": "unclassed", "verdict": "answer", "citations": [{"kind": "instruction", "path": "adapters/claude-code/README.md", "symbol": "Keys / auth", "ruling_id": null}, {"kind": "mechanism", "path": "adapters/claude-code/run", "symbol": "transient_detail", "ruling_id": null}, {"kind": "guard", "path": "attavo/drive.py", "symbol": "retry_state", "ruling_id": null}], "proposal": {"ruling_text": "The build did not reach the item: the Claude Code subscription OAuth session expired and could not be refreshed. This is not a transient vendor-capacity failure and changes none of the specification or definition of done. Reauthenticate the operator's Claude Code subscription session, then retry this build; the existing unclassed stop requires this counsel answer before the retry is eligible.", "patch": null, "question": null, "issue": null}}
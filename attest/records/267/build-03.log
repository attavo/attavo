he whole\n# suite, and each is named here so that a new module under attavo/ must be\n# placed -- in MODULE_TESTS or in this tuple -- before the suite accepts it\n# (tests/test_testtool.py).\nSHARED_MODULES: tuple[str, ...] = (\n    \"attavo/__init__.py\", \"attavo/approval.py\", \"attavo/common.py\", \"attavo/events.py\",\n    \"attavo/records.py\", \"attavo/spec.py\", \"attavo/stops.py\",\n)\n\nPREFIX_TESTS: tuple[tuple[str, tuple[str, ...]], ...] = (\n    (\"adapters/claude-code/\", (\"tests/test_adapters.py\", \"tests/test_adapter_claude_code.py\",\n                               \"tests/test_executor_conformance.py\")),\n    (\"adapters/codex/\", (\"tests/test_adapter_codex.py\", \"tests/test_adapters_codex.py\",\n                         \"tests/test_executor_conformance.py\")),\n    (\"adapters/\", (\"tests/test_adapters.py\", \"tests/test_executor_conformance.py\")),\n    (\"schema/\", (\"tests/test_record_schemas.py\", \"tests/test_attest.py\",\n                 \"tests/test_types_mirror_schemas.py\")),\n    (\"templates/\", (\"tests/test_approve_template.py\", \"tests/test_coherence_template.py\",\n                    \"tests/test_spec_gate_template.py\", \"tests/test_template_app_identity.py\",\n                    \"tests/test_templates_carry_no_repository_urls.py\",\n                    \"tests/test_self_tenancy.py\")),\n)\n\n\ndef repository_root() -> Path:\n    return Path(__file__).resolve().parent.parent.parent\n\n\ndef is_prose_or_record(path: str) -> bool:\n    return path.endswith(\".md\") or path == \"LICENSE\" or path.startswith(SILENT_PREFIXES)\n\n\ndef select_one(path: str) -> tuple[str, ...] | None:\n    \"\"\"The tests for one changed path, () for none, None for a path this\n    selector does not know.\"\"\"\n    if is_prose_or_record(path):\n        return ()\n    if path.startswith(WHOLE_SUITE_PREFIXES):\n        return None\n    if path.startswith(\"tests/test_\") and path.endswith(\".py\") and \"/\" not in path[len(\"tests/\"):]:\n        # A deleted test file cannot select itself, and the gate must not\n        # pass a deletion unexamined (issue #212's review): fail safe to\n        # the whole suite rather than the () a present file's own removal\n        # would otherwise fall through to.\n        return (path,) if (repository_root() / path).is_file() else None\n    if path in MODULE_TESTS:\n        return MODULE_TESTS[path]\n    for prefix, tests in PREFIX_TESTS:\n        if path.startswith(prefix):\n            return tests\n    return None\n\n\ndef select(paths: list[str]) -> list[str]:\n    tests: dict[str, None] = {}\n    for path in paths:\n        found = select_one(path)\n        if found is None:\n            return [WHOLE_SUITE]\n        tests.update(dict.fromkeys(found))\n    return list(tests)\n\n\ndef main() -> int:\n    changed = [line.strip() for line in sys.stdin.read().splitlines() if line.strip()]\n    for t in select(changed):\n        print(t)\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n","numLines":146,"startLine":1,"totalLines":146}}}

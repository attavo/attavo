           \"tests/test_testtool.py\"),\n69\t    \".attavo/bin/forge-issues\": (\"tests/test_issues.py\",),\n70\t    \".attavo/bin/select-tests\": (\"tests/test_self_tenancy.py\", \"tests/test_testtool.py\"),\n71\t}\n72\t\n73\t# The modules most of the others import: no table of tests-per-module can\n74\t# know what a change to one of these breaks, so each selects the whole\n75\t# suite, and each is named here so that a new module under attavo/ must be\n76\t# placed -- in MODULE_TESTS or in this tuple -- before the suite accepts it\n77\t# (tests/test_testtool.py).\n78\tSHARED_MODULES: tuple[str, ...] = (\n79\t    \"attavo/__init__.py\", \"attavo/approval.py\", \"attavo/common.py\", \"attavo/events.py\",\n80\t    \"attavo/records.py\", \"attavo/spec.py\", \"attavo/stops.py\",\n81\t)\n82\t\n83\tPREFIX_TESTS: tuple[tuple[str, tuple[str, ...]], ...] = (\n84\t    (\"adapters/claude-code/\", (\"tests/test_adapters.py\", \"tests/test_adapter_claude_code.py\",\n85\t                               \"tests/test_executor_conformance.py\")),\n86\t    (\"adapters/codex/\", (\"tests/test_adapter_codex.py\", \"tests/test_adapters_codex.py\",\n87\t                         \"tests/test_executor_conformance.py\")),\n88\t    (\"adapters/\", (\"tests/test_adapters.py\", \"tests/test_executor_conformance.py\")),\n89\t    (\"schema/\", (\"tests/test_record_schemas.py\", \"tests/test_attest.py\",\n90\t                 \"tests/test_types_mirror_schemas.py\")),\n91\t    (\"templates/\", (\"tests/test_approve_template.py\", \"tests/test_coherence_template.py\",\n92\t                    \"tests/test_spec_gate_template.py\", \"tests/test_template_app_identity.py\",\n93\t                    \"tests/test_templates_carry_no_repository_urls.py\",\n94\t                    \"tests/test_self_tenancy.py\")),\n95\t)\n96\t\n97\t\n98\tdef repository_root() -> Path:\n99\t    return Path(__file__).resolve().parent.parent.parent\n100\t\n101\t\n102\tdef is_prose_or_record(path: str) -> bool:\n103\t    return 
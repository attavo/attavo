{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01P7FTFxj3NBkoRLxeg1c23h","type":"tool_result","content":"1\t{\n2\t  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n3\t  \"$id\": \"https://attavo.dev/schema/manifest/2\",\n4\t  \"title\": \"Attavo tenant manifest (attavo.toml)\",\n5\t  \"description\": \"What a tenant declares to install Attavo: the release it pins, the executor it chose, where the governed path begins and ends, the gates it runs, and where its specs, records, and rulings live. Every key is read by a script; a key no script reads does not belong here.\",\n6\t  \"type\": \"object\",\n7\t  \"additionalProperties\": false,\n8\t  \"required\": [\"schema_version\", \"attavo\", \"executor\", \"spec\", \"gates\", \"paths\", \"operators\"],\n9\t  \"properties\": {\n10\t    \"schema_version\": {\n11\t      \"type\": \"integer\",\n12\t      \"const\": 1\n13\t    },\n14\t    \"attavo\": {\n15\t      \"type\": \"object\",\n16\t      \"additionalProperties\": false,\n17\t      \"required\": [\"version\"],\n18\t      \"properties\": {\n19\t        \"version\": {\n20\t          \"type\": \"string\",\n21\t          \"description\": \"The Attavo release tag the tenant pins. The tenant holds no Attavo binary; the pinned action supplies it.\",\n22\t          \"pattern\": \"^v[0-9]+\\\\.[0-9]+\\\\.[0-9]+$\"\n23\t        }\n24\t      }\n25\t    },\n26\t    \"executor\": {\n27\t      \"type\": \"object\",\n28\t      \"required\": [\"build\"],\n29\t      \"properties\": {\n30\t        \"build\": {\n31\t          \"type\": \"string\",\n32\t          \"description\": \"Adapter name for the build invocation. The contract is thin: spec, corpus, and branch in; commits and a report record out.\",\n33\t          \"minLength\": 1\n34\t        },\n35\t        \"verify\": {\n36\t          \"type\": \"string\",\n37\t          \"description\": \"Adapter name for the verify invocation. Defaults to build's adapter; may differ.\",\n38\t          \"minLength\": 1\n39\t        }\n40\t      },\n41\t      \"additionalProperties\": {\n42\t        \"type\": \"object\",\n43\t        \"description\": \"[executor.<adapter-name>]: that adapter's own configuration, passed through as ATTAVO_ADAPTER_CONFIG and copied verbatim into build-NN.json as adapter_config. The product does not know what an adapter's settings mean -- any keys, none required. Never put a secret in here: it lands in a record.\"\n44\t      }\n45\t    },\n46\t    \"tests\": {\n47\t      \"type\": \"object\",\n48\t      \"description\": \"How build finds and runs the tests for a touched path. Both keys are required together; a tenant with no [tests] table has not declared selection, and attavo build refuses to run on it.\",\n49\t      \"additionalProperties\": false,\n50\t      \"required\": [\"select\", \"run\"],\n51\t      \"properties\": {\n52\t        \"select\": {\n53\t          \"type\": \"string\",\n54\t          \"description\": \"A command that reads touched paths on stdin, one per line, and writes test identifiers on stdout, one per line.\",\n55\t          \"minLength\": 1\n56\t        },\n57\t        \"exclude_in_executor\": {\n58\t          \"type\": \"array\",\n59\t          \"items\": {\"type\": \"string\", \"minLength\": 1},\n60\t          \"description\": \"Test identifiers attavo test leaves out when it runs inside an executor (ATTAVO_STAGE set): tests that need a live tenant, the network, or the process's own working directory. CI runs them.\"\n61\t        },\n62\t        \"run\": {\n63\t          \"type\": \"string\",\n64\t          \"description\": \"A command that reads test identifiers on stdin, one per line; its exit code is the verdict.\",\n65\t          \"minLength\": 1\n66\t        },\n67\t        \"call_timeout_s\": {\n68\t          \"type\": \"integer\",\n69\t          \"minimum\": 1,\n70\t          \"description\": \"Seconds one `attavo test` run is given before its process group is ended and it exits 124. The executor's own test runs are bounded; the gate's are not.\"\n71\t        }\n72\t      }\n73\t    },\n74\t    \"checks\": {\n75\t      \"type\": \"object\",\n76\t      \"description\": \"The tenant's own definition of done: a whole-tree check, as the tenant runs it locally. attavo build runs it each iteration, after the claims boundary, the criteria, and the selected tests -- pass requires its exit to be 0, and a non-zero exit reaches the executor as feedback. Optional; a tenant that declares none is not refused (unlike [tests], which build requires).\",\n77\t      \"additionalProperties\": false,\n78\t      \"required\": [\"command\"],\n79\t      \"properties\": {\n80\t        \"command\": {\n81\t          \"type\": \"string\",\n82\t          \"description\": \"The tenant's whole-tree check at the gate, run from the tenant root once per iteration on the committed tree. What is fast and decisive belongs here; what the forge runs as a required check need not be run twice.\",\n83\t          \"minLength\": 1\n84\t        },\n85\t        \"probe\": {\n86\t          \"type\": \"string\",\n87\t          \"description\": \"A cheap command that answers whether this machine can run the checks at all, run once before a build's executor is invoked: exit 0 yes, anything else an environment refusal. When absent, attavo build asks by running [checks].command whole and reads exit 2 alone as cannot run.\",\n88\t          \"minLength\": 1\n89\t        },\n90\t        \"probe_timeout_s\": {\n91\t          \"type\": \"integer\",\n92\t          \"minimum\": 1,\n93\t          \"description\": \"Seconds [checks].probe is given; past it the build is refused as an environment stop. Required with probe: a bound the tenant did not write is a forecast.\"\n94\t        }\n95\t      },\n96\t      \"dependentRequired\": {\"probe\": [\"probe_timeout_s\"]}\n97\t    },\n98\t    \"forge\": {\n99\t      \"type\": \"object\",\n100\t      \"description\": \"The tenant's own commit-status and issue-tracking reads. The product names no vendor: every key is a command the tenant supplies. Optional; attavo verify refuses without checks_command, and attavo file-findings refuses without file_issue_command, but neither key requires the other.\",\n101\t      \"additionalProperties\": false,\n102\t      \"properties\": {\n103\t        \"checks_command\": {\n104\t          \"type\": \"string\",\n105\t          \"description\": \"Takes a full commit sha on argv; prints one line per check as \\\"<name> <conclusion>\\\". attavo verify runs it on the item's latest build record's sha before calling any adapter.\",\n106\t          \"minLength\": 1\n107\t        },\n108\t        \"check_log_command\": {\n109\t          \"type\": \"string\",\n110\t          \"description\": \"Takes a sha and a check name on argv; prints that check's own failed-step log. attavo counsel runs it once per check checks_command reported as not \\\"success\\\" on the counseled record's sha, before handing the adapter ATTAVO_COUNSEL_CHECKS -- absent, counsel's own record says so (forge.read: false) rather than reading the forge as if it were green.\",\n111\t          \"minLength\": 1\n112\t        },\n113\t        \"file_issue_command\": {\n114\t          \"type\": \"string\",\n115\t          \"description\": \"Reads one finding as JSON on stdin and files it as a tenant issue. attavo file-findings runs it once per finding in the item's latest verify record.\",\n116\t          \"minLength\": 1\n117\t        },\n118\t        \"issues_command\": {\n119\t          \"type\": \"string\",\n120\t          \"description\": \"Takes nothing; prints the tenant's issues, open and closed, as one JSON list of {number, title, state (open or closed), closed_at, labels, body}. The product parses each body's \\\"## Claims\\\" section itself. attavo frontier runs it once per read; absent, every reader that needs issues says \\\"not read: no [forge].issues_command\\\".\",\n121\t          \"minLength\": 1\n122\t        },\n123\t        \"attestation_command\": {\n124\t          \"type\": \"string\",\n125\t          \"description\": \"Reads a merge commit sha on stdin and prints that merge's attestation statement as JSON on exit 0; nothing on a non-zero exit. The doctor's fifth proof runs it once per merged, fully-staged item to require a statement in the store.\",\n126\t          \"minLength\": 1\n127\t        },\n128\t        \"sealed_since\": {\n129\t          \"type\": \"string\",\n130\t          \"description\": \"A commit. A merge at or before it is before the window: the tenant could not seal it (no queue, no signing workflow, or a store that held nothing yet). Defaults to the install commit; set it only for a repository that ran the product before it could seal, to the first parent of its first sealed merge, and say why in the commit that sets it.\",\n131\t          \"minLength\": 7\n132\t        }\n133\t      }\n134\t    },\n135\t    \"spec\": {\n136\t      \"type\": \"object\",\n137\t      \"additionalProperties\": false,\n138\t      \"required\": [\"boundary\"],\n139\t      \"properties\": {\n140\t        \"research\": {\n141\t          \"type\": \"string\",\n142\t          \"enum\": [\"required\"],\n143\t          \"description\": \"Set to \\\"required\\\" and a core spec owes a research record in the item's records before its gate passes. Absent, it owes none, and every gate record says so (ruled 2026-09-27: behind this flag until the Plan area hosts research).\"\n144\t        },\n145\t        \"boundary\": {\n146\t          \"type\": \"object\",\n147\t          \"description\": \"Which changes take the governed path. A change outside the boundary takes the tenant's ordinary pull-request flow, and the path ratio measures both.\",\n148\t          \"additionalProperties\": false,\n149\t          \"properties\": {\n150\t            \"paths\": {\n151\t              \"type\": \"array\",\n152\t              \"items\": {\"type\": \"string\", \"minLength\": 1},\n153\t              \"description\": \"Glob patterns; a change touching any of them is governed.\"\n154\t            },\n155\t            \"labels\": {\n156\t              \"type\": \"array\",\n157\t              \"items\": {\"type\": \"string\", \"minLength\": 1},\n158\t              \"description\": \"Issue labels; an issue carrying any of them is governed.\"\n159\t            },\n160\t            \"max_ordinary_lines\": {\n161\t              \"type\": \"integer\",\n162\t              \"minimum\": 0,\n163\t              \"description\": \"A change above this many net lines is governed regardless of path or label.\"\n164\t            }\n165\t          }\n166\t        }\n167\t      }\n168\t    },\n169\t    \"gates\": {\n170\t      \"type\": \"object\",\n171\t      \"description\": \"Every gate the tenant runs, by name. The doctor's first proof is that each one rejects its fixture; a gate absent from this table does not exist.\",\n172\t      \"propertyNames\": {\"pattern\": \"^[a-z][a-z0-9-]*$\"},\n173\t      \"additionalProperties\": {\n174\t        \"type\": \"object\",\n175\t        \"additionalProperties\": false,\n176\t        \"required\": [\"command\", \"retires\"],\n177\t        \"properties\": {\n178\t          \"command\": {\n179\t            \"type\": \"string\",\n180\t            \"description\": \"The script the gate runs, invoked with the tenant root as its working directory. Exit status is the verdict: non-zero rejects.\",\n181\t            \"minLength\": 1\n182\t          },\n183\t          \"retires\": {\n184\t            \"type\": \"array\",\n185\t            \"minItems\": 1,\n186\t            \"items\": {\"type\": \"string\", \"minLength\": 1},\n187\t            \"description\": \"What this gate replaced. A gate that retires nothing is not admitted to the table.\"\n188\t          }\n189\t        }\n190\t      }\n191\t    },\n192\t    \"paths\": {\n193\t      \"type\": \"object\",\n194\t      \"additionalProperties\": false,\n195\t      \"required\": [\"specs\", \"records\", \"rulings\", \"rejections\"],\n196\t      \"properties\": {\n197\t        \"specs\": {\"type\": \"string\", \"minLength\": 1, \"description\": \"Directory of specs, one per work item, named by issue number.\"},\n198\t        \"rejections\": {\"type\": \"string\", \"minLength\": 1, \"description\": \"Directory of rejection fixtures, one subdirectory per gate name. The doctor's first proof runs each gate against its fixture and requires a rejection.\"},\n199\t        \"records\": {\"type\": \"string\", \"minLength\": 1, \"description\": \"Directory of records, append-only, one subdirectory per work item named by issue number. Scripts write every file here.\"},\n200\t        \"rulings\": {\"type\": \"string\", \"minLength\": 1, \"description\": \"The tenant's rulings file, rendered read-only; the merge of a proposed amendment is the ruling.\"}\n201\t      }\n202\t    },\n203\t    \"operators\": {\n204\t      \"type\": \"object\",\n205\t      \"additionalProperties\": false,\n206\t      \"required\": [\"approvers\"],\n207\t      \"properties\": {\n208\t        \"approvers\": {\n209\t          \"type\": \"array\",\n210\t          \"items\": {\"type\": \"string\", \"minLength\": 1},\n211\t          \"description\": \"Logins allowed to bind a spec's approval to a commit. `attavo approve` refuses a LOGIN not on this list.\"\n212\t        }\n213\t      }\n214\t    },\n215\t    \"doctor\": {\n216\t      \"type\": \"object\",\n217\t      \"description\": \"Optional; the doctor's own read. Absent, proof three's window starts at the install commit, as it always has.\",\n218\t      \"additionalProperties\": false,\n219\t      \"properties\": {\n220\t        \"from\": {\n221\t          \"type\": \"string\",\n222\t          \"description\": \"Anything git rev-parse --verify resolves to a commit on main's first-parent line, at or after the install commit -- a full or abbreviated sha, a tag, a ref -- where proof three's window starts. A tenant that adopted the product on a repository with pre-existing history names the commit after which every push arrived through the queue. Resolved and checked against main's first-parent line, not trusted: a spelling that does not resolve, or a commit that is not on that line, is refused by name.\",\n223\t          \"minLength\": 1\n224\t        },\n225\t        \"built_since\": {\n226\t          \"type\": \"string\",\n227\t          \"description\": \"Anything git rev-parse --verify resolves to a commit. Proof seven (no attested item is empty) names items merged at or before it as before the window instead of failing them: the specimen that produced the proof stays on the record without failing the tenant forever. Absent, proof seven's window is proof three's.\",\n228\t          \"minLength\": 1\n229\t        }\n230\t      }\n231\t    },\n232\t    \"drive\": {\n233\t      \"type\": \"object\",\n234\t      \"additionalProperties\": false,\n235\t      \"properties\": {\n236\t        \"stall_after_s\": {\n237\t          \"type\": \"integer\",\n238\t          \"minimum\": 1,\n239\t          \"description\": \"seconds without a new event past which a live invocation is hung; attavo drive --recover terminates and records it\"\n240\t        },\n241\t        \"attempts\": {\n242\t          \"type\": \"integer\",\n243\t          \"minimum\": 1,\n244\t          \"description\": \"R3: attempts a stage may spend before the item is a person's; 3 when absent\"\n245\t        },\n246\t        \"retry_after_s\": {\n247\t          \"type\": \"integer\",\n248\t          \"minimum\": 0,\n249\t          \"description\": \"R3: seconds a transient stop waits before its next attempt; 300 when absent\"\n250\t        },\n251\t        \"build\": {\n252\t          \"type\": \"object\",\n253\t          \"additionalProperties\": false,\n254\t          \"properties\": {\n255\t            \"ceiling_s\": {\"type\": \"integer\", \"minimum\": 1, \"description\": \"R3: wall clock past which a live build is hung by its ceiling\"}\n256\t          }\n257\t        },\n258\t        \"verify\": {\n259\t          \"type\": \"object\",\n260\t          \"additionalProperties\": false,\n261\t          \"properties\": {\n262\t            \"ceiling_s\": {\"type\": \"integer\", \"minimum\": 1, \"description\": \"R3: wall clock past which a live review is hung by its ceiling\"}\n263\t          }\n264\t        }\n265\t      }\n266\t    }\n267\t  }\n268\t}\n269\t"}]},"parent_tool_use_id":null,"session_id":"f2e0c4f7-36d4-465e-a2fe-27db257201e7","uuid":"3f90a5f6-097b-451b-854e-92ce402a46bf","timestamp":"2026-09-30T01:01:17.859Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-267/attest/specs/267/stub/schema/manifest.schema.json","content":"{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"$id\": \"https://attavo.dev/schema/manifest/2\",\n  \"title\": \"Attavo tenant manifest (attavo.toml)\",\n  \"description\": \"What a tenant declares to install Attavo: the release it pins, the executor it chose, where the governed path begins and ends, the gates it runs, and where its specs, records, and rulings live. Every key is read by a script; a key no script reads does not belong here.\",\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"required\": [\"schema_version\", \"attavo\", \"executor\", \"spec\", \"gates\", \"paths\", \"operators\"],\n  \"properties\": {\n    \"schema_version\": {\n      \"type\": \"integer\",\n      \"const\": 1\n    },\n    \"attavo\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\"version\"],\n      \"properties\": {\n        \"version\": {\n          \"type\": \"string\",\n          \"description\": \"The Attavo release tag the tenant pins. The tenant holds no Attavo binary; the pinned action supplies it.\",\n          \"pattern\": \"^v[0-9]+\\\\.[0-9]+\\\\.[0-9]+$\"\n        }\n      }\n    },\n    \"executor\": {\n      \"type\": \"object\",\n      \"required\": [\"build\"],\n      \"properties\": {\n        \"build\": {\n          \"type\": \"string\",\n          \"description\": \"Adapter name for the build invocation. The contract is thin: spec, corpus, and branch in; commits and a report record out.\",\n          \"minLength\": 1\n        },\n        \"verify\": {\n          \"type\": \"string\",\n          \"description\": \"Adapter name for the verify invocation. Defaults to build's adapter; may differ.\",\n          \"minLength\": 1\n        }\n      },\n      \"additionalProperties\": {\n        \"type\": \"object\",\n        \"description\": \"[executor.<adapter-name>]: that adapter's own configuration, passed through as ATTAVO_ADAPTER_CONFIG and copied verbatim into build-NN.json as adapter_config. The product does not know what an adapter's settings mean -- any keys, none required. Never put a secret in here: it lands in a record.\"\n      }\n    },\n    \"tests\": {\n      \"type\": \"object\",\n      \"description\": \"How build finds and runs the tests for a touched path. Both keys are required together; a tenant with no [tests] table has not declared selection, and attavo build refuses to run on it.\",\n      \"additionalProperties\": false,\n      \"required\": [\"select\", \"run\"],\n      \"properties\": {\n        \"select\": {\n          \"type\": \"string\",\n          \"description\": \"A command that reads touched paths on stdin, one per line, and writes test identifiers on stdout, one per line.\",\n          \"minLength\": 1\n        },\n        \"exclude_in_executor\": {\n          \"type\": \"array\",\n          \"items\": {\"type\": \"string\", \"minLength\": 1},\n          \"description\": \"Test identifiers attavo test leaves out when it runs inside an executor (ATTAVO_STAGE set): tests that need a live tenant, the network, or the process's own working directory. CI runs them.\"\n        },\n        \"run\": {\n          \"type\": \"string\",\n          \"description\": \"A command that reads test identifiers on stdin, one per line; its exit code is the verdict.\",\n          \"minLength\": 1\n        },\n        \"call_timeout_s\": {\n          \"type\": \"integer\",\n          \"minimum\": 1,\n          \"description\": \"Seconds one `attavo test` run is given before its process group is ended and it exits 124. The executor's own test runs are bounded; the gate's are not.\"\n        }\n      }\n    },\n    \"checks\": {\n      \"type\": \"object\",\n      \"description\": \"The tenant's own definition of done: a whole-tree check, as the tenant runs it locally. attavo build runs it each iteration, after the claims boundary, the criteria, and the selected tests -- pass requires its exit to be 0, and a non-zero exit reaches the executor as feedback. Optional; a tenant that declares none is not refused (unlike [tests], which build requires).\",\n      \"additionalProperties\": false,\n      \"required\": [\"command\"],\n      \"properties\": {\n        \"command\": {\n          \"type\": \"string\",\n          \"description\": \"The tenant's whole-tree check at the gate, run from the tenant root once per iteration on the committed tree. What is fast and decisive belongs here; what the forge runs as a required check need not be run twice.\",\n          \"minLength\": 1\n        },\n        \"probe\": {\n          \"type\": \"string\",\n          \"description\": \"A cheap command that answers whether this machine can run the checks at all, run once before a build's executor is invoked: exit 0 yes, anything else an environment refusal. When absent, attavo build asks by running [checks].command whole and reads exit 2 alone as cannot run.\",\n          \"minLength\": 1\n        },\n        \"probe_timeout_s\": {\n          \"type\": \"integer\",\n          \"minimum\": 1,\n          \"description\": \"Seconds [checks].probe is given; past it the build is refused as an environment stop. Required with probe: a bound the tenant did not write is a forecast.\"\n        }\n      },\n      \"dependentRequired\": {\"probe\": [\"probe_timeout_s\"]}\n    },\n    \"forge\": {\n      \"type\": \"object\",\n      \"description\": \"The tenant's own commit-status and issue-tracking reads. The product names no vendor: every key is a command the tenant supplies. Optional; attavo verify refuses without checks_command, and attavo file-findings refuses without file_issue_command, but neither key requires the other.\",\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"checks_command\": {\n          \"type\": \"string\",\n          \"description\": \"Takes a full commit sha on argv; prints one line per check as \\\"<name> <conclusion>\\\". attavo verify runs it on the item's latest build record's sha before calling any adapter.\",\n          \"minLength\": 1\n        },\n        \"check_log_command\": {\n          \"type\": \"string\",\n          \"description\": \"Takes a sha and a check name on argv; prints that check's own failed-step log. attavo counsel runs it once per check checks_command reported as not \\\"success\\\" on the counseled record's sha, before handing the adapter ATTAVO_COUNSEL_CHECKS -- absent, counsel's own record says so (forge.read: false) rather than reading the forge as if it were green.\",\n          \"minLength\": 1\n        },\n        \"file_issue_command\": {\n          \"type\": \"string\",\n          \"description\": \"Reads one finding as JSON on stdin and files it as a tenant issue. attavo file-findings runs it once per finding in the item's latest verify record.\",\n          \"minLength\": 1\n        },\n        \"issues_command\": {\n          \"type\": \"string\",\n          \"description\": \"Takes nothing; prints the tenant's issues, open and closed, as one JSON list of {number, title, state (open or closed), closed_at, labels, body}. The product parses each body's \\\"## Claims\\\" section itself. attavo frontier runs it once per read; absent, every reader that needs issues says \\\"not read: no [forge].issues_command\\\".\",\n          \"minLength\": 1\n        },\n        \"attestation_command\": {\n          \"type\": \"string\",\n          \"description\": \"Reads a merge commit sha on stdin and prints that merge's attestation statement as JSON on exit 0; nothing on a non-zero exit. The doctor's fifth proof runs it once per merged, fully-staged item to require a statement in the store.\",\n          \"minLength\": 1\n        },\n        \"sealed_since\": {\n          \"type\": \"string\",\n          \"description\": \"A commit. A merge at or before it is before the window: the tenant could not seal it (no queue, no signing workflow, or a store that held nothing yet). Defaults to the install commit; set it only for a repository that ran the product before it could seal, to the first parent of its first sealed merge, and say why in the commit that sets it.\",\n          \"minLength\": 7\n        }\n      }\n    },\n    \"spec\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\"boundary\"],\n      \"properties\": {\n        \"research\": {\n          \"type\": \"string\",\n          \"enum\": [\"required\"],\n          \"description\": \"Set to \\\"required\\\" and a core spec owes a research record in the item's records before its gate passes. Absent, it owes none, and every gate record says so (ruled 2026-09-27: behind this flag until the Plan area hosts research).\"\n        },\n        \"boundary\": {\n          \"type\": \"object\",\n          \"description\": \"Which changes take the governed path. A change outside the boundary takes the tenant's ordinary pull-request flow, and the path ratio measures both.\",\n          \"additionalProperties\": false,\n          \"properties\": {\n            \"paths\": {\n              \"type\": \"array\",\n              \"items\": {\"type\": \"string\", \"minLength\": 1},\n              \"description\": \"Glob patterns; a change touching any of them is governed.\"\n            },\n            \"labels\": {\n              \"type\": \"array\",\n              \"items\": {\"type\": \"string\", \"minLength\": 1},\n              \"description\": \"Issue labels; an issue carrying any of them is governed.\"\n            },\n            \"max_ordinary_lines\": {\n              \"type\": \"integer\",\n              \"minimum\": 0,\n              \"description\": \"A change above this many net lines is governed regardless of path or label.\"\n            }\n          }\n        }\n      }\n    },\n    \"gates\": {\n      \"type\": \"object\",\n      \"description\": \"Every gate the tenant runs, by name. The doctor's first proof is that each one rejects its fixture; a gate absent from this table does not exist.\",\n      \"propertyNames\": {\"pattern\": \"^[a-z][a-z0-9-]*$\"},\n      \"additionalProperties\": {\n        \"type\": \"object\",\n        \"additionalProperties\": false,\n        \"required\": [\"command\", \"retires\"],\n        \"properties\": {\n          \"command\": {\n            \"type\": \"string\",\n            \"description\": \"The script the gate runs, invoked with the tenant root as its working directory. Exit status is the verdict: non-zero rejects.\",\n            \"minLength\": 1\n          },\n          \"retires\": {\n            \"type\": \"array\",\n            \"minItems\": 1,\n            \"items\": {\"type\": \"string\", \"minLength\": 1},\n            \"description\": \"What this gate replaced. A gate that retires nothing is not admitted to the table.\"\n          }\n        }\n      }\n    },\n    \"paths\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\"specs\", \"records\", \"rulings\", \"rejections\"],\n      \"properties\": {\n        \"specs\": {\"type\": \"string\", \"minLength\": 1, \"description\": \"Directory of specs, one per work item, named by issue number.\"},\n        \"rejections\": {\"type\": \"string\", \"minLength\": 1, \"description\": \"Directory of rejection fixtures, one subdirectory per gate name. The doctor's first proof runs each gate against its fixture and requires a rejection.\"},\n        \"records\": {\"type\": \"string\", \"minLength\": 1, \"description\": \"Directory of records, append-only, one subdirectory per work item named by issue number. Scripts write every file here.\"},\n        \"rulings\": {\"type\": \"string\", \"minLength\": 1, \"description\": \"The tenant's rulings file, rendered read-only; the merge of a proposed amendment is the ruling.\"}\n      }\n    },\n    \"operators\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\"approvers\"],\n      \"properties\": {\n        \"approvers\": {\n          \"type\": \"array\",\n          \"items\": {\"type\": \"string\", \"minLength\": 1},\n          \"description\": \"Logins allowed to bind a spec's approval to a commit. `attavo approve` refuses a LOGIN not on this list.\"\n        }\n      }\n    },\n    \"doctor\": {\n      \"type\": \"object\",\n      \"description\": \"Optional; the doctor's own read. Absent, proof three's window starts at the install commit, as it always has.\",\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"from\": {\n          \"type\": \"string\",\n          \"description\": \"Anything git rev-parse --verify resolves to a commit on main's first-parent line, at or after the install commit -- a full or abbreviated sha, a tag, a ref -- where proof three's window starts. A tenant that adopted the product on a repository with pre-existing history names the commit after which every push arrived through the queue. Resolved and checked against main's first-parent line, not trusted: a spelling that does not resolve, or a commit that is not on that line, is refused by name.\",\n          \"minLength\": 1\n        },\n        \"built_since\": {\n          \"type\": \"string\",\n          \"description\": \"Anything git rev-parse --verify resolves to a commit. Proof seven (no attested item is empty) names items merged at or before it as before the window instead of failing them: the specimen that produced the proof stays on the record without failing the tenant forever. Absent, proof seven's window is proof three's.\",\n          \"minLength\": 1\n        }\n      }\n    },\n    \"drive\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"stall_after_s\": {\n          \"type\": \"integer\",\n          \"minimum\": 1,\n          \"description\": \"seconds without a new event past which a live invocation is hung; attavo drive --recover terminates and records it\"\n        },\n        \"attempts\": {\n          \"type\": \"integer\",\n          \"minimum\": 1,\n          \"description\": \"R3: attempts a stage may spend before the item is a person's; 3 when absent\"\n        },\n        \"retry_after_s\": {\n          \"type\": \"integer\",\n          \"minimum\": 0,\n          \"description\": \"R3: seconds a transient stop waits before its next attempt; 300 when absent\"\n        },\n        \"build\": {\n          \"type\": \"object\",\n          \"additionalProperties\": false,\n          \"properties\": {\n            \"ceiling_s\": {\"type\": \"integer\", \"minimum\": 1, \"description\": \"R3: wall clock past which a live build is hung by its ceiling\"}\n          }\n        },\n        \"verify\": {\n          \"type\": \"object\",\n          \"additionalProperties\": false,\n          \"properties\": {\n            \"ceiling_s\": {\"type\": \"integer\", \"minimum\": 1, \"description\": \"R3: wall clock past which a live review is hung by its ceiling\"}\n          }\n        }\n      }\n    }\n  }\n}\n","numLines":269,"startLine":1,"totalLines":269}}}

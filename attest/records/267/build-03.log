{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UXNtsw4zZMyrpXBDZQ4mcr","type":"tool_result","content":"{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"$id\": \"https://attavo.dev/schema/manifest/2\",\n  \"title\": \"Attavo tenant manifest (attavo.toml)\",\n  \"description\": \"What a tenant declares to install Attavo: the release it pins, the executor it chose, where the governed path begins and ends, the gates it runs, and where its specs, records, and rulings live. Every key is read by a script; a key no script reads does not belong here.\",\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"required\": [\"schema_version\", \"attavo\", \"executor\", \"spec\", \"gates\", \"paths\", \"operators\"],\n  \"properties\": {\n    \"schema_version\": {\n      \"type\": \"integer\",\n      \"const\": 1\n    },\n    \"attavo\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\"version\"],\n      \"properties\": {\n        \"version\": {\n          \"type\": \"string\",\n          \"description\": \"The Attavo release tag the tenant pins. The tenant holds no Attavo binary; the pinned action supplies it.\",\n          \"pattern\": \"^v[0-9]+\\\\.[0-9]+\\\\.[0-9]+$\"\n        }\n      }\n    },\n    \"executor\": {\n      \"type\": \"object\",\n      \"required\": [\"build\"],\n      \"properties\": {\n        \"build\": {\n          \"type\": \"string\",\n          \"description\": \"Adapter name for the build invocation. The contract is thin: spec, corpus, and branch in; commits and a report record out.\",\n          \"minLength\": 1\n        },\n        \"verify\": {\n          \"type\": \"string\",\n          \"description\": \"Adapter name for the verify invocation. Defaults to build's adapter; may differ.\",\n          \"minLength\": 1\n        }\n      },\n      \"additionalProperties\": {\n        \"type\": \"object\",\n        \"description\": \"[executor.<adapter-name>]: that adapter's own configuration, passed through as ATTAVO_ADAPTER_CONFIG and copied verbatim into build-NN.json as adapter_config. The product does not know what an adapter's settings mean -- any keys, none required. Never put a secret in here: it lands in a record.\"\n      }\n    },\n    \"tests\": {\n      \"type\": \"object\",\n      \"description\": \"How build finds and runs the tests for a touched path. Both keys are required together; a tenant with no [tests] table has not declared selection, and attavo build refuses to run on it.\",\n      \"additionalProperties\": false,\n      \"required\": [\"select\", \"run\"],\n      \"properties\": {\n        \"select\": {\n          \"type\": \"string\",\n          \"description\": \"A command that reads touched paths on stdin, one per line, and writes test identifiers on stdout, one per line.\",\n          \"minLength\": 1\n        },\n        \"exclude_in_executor\": {\n          \"type\": \"array\",\n          \"items\": {\"type\": \"string\", \"minLength\": 1},\n          \"description\": \"Test identifiers attavo test leaves out when it runs inside an executor (ATTAVO_STAGE set): tests that need a live tenant, the network, or the process's own working directory. CI runs them.\"\n        },\n        \"run\": {\n          \"type\": \"string\",\n          \"description\": \"A command that reads test identifiers on stdin, one per line; its exit code is the verdict.\",\n          \"minLength\": 1\n        },\n        \"call_timeout_s\": {\n          \"type\": \"integer\",\n          \"minimum\": 1,\n          \"description\": \"Seconds one `attavo test` run is given before its process group is ended and it exits 124. The executor's own test runs are bounded; the gate's are not.\"\n        }\n      }\n    },\n    \"checks\": {\n      \"type\": \"object\",\n      \"description\": \"The tenant's own definition of done: a whole-tree check, as the tenant runs it locally. attavo build runs it each iteration, after the claims boundary, the criteria, and the selected tests -- pass requires its exit to be 0, and a non-zero exit reaches the executor as feedback. Optional; a tenant that declares none is not refused (unlike [tests], which build requires).\",\n      \"additionalProperties\": false,\n      \"required\": [\"command\"],\n      \"properties\": {\n        \"command\": {\n          \"type\": \"string\",\n          \"description\": \"The tenant's whole-tree check at the gate, run from the tenant root once per iteration on the committed tree. What is fast and decisive belongs here; what the forge runs as a required check need not be run twice.\",\n          \"minLength\": 1\n        },\n        \"probe\": {\n          \"type\": \"string\",\n          \"description\": \"A cheap command that answers whether this machine can run the checks at all, run once before a build's executor is invoked: exit 0 yes, anything else an environment refusal. When absent, attavo build asks by running [checks].command whole and reads exit 2 alone as cannot run.\",\n          \"minLength\": 1\n        },\n        \"probe_timeout_s\": {\n          \"type\": \"integer\",\n          \"minimum\": 1,\n          \"description\": \"Seconds [checks].probe is given; past it the build is refused as an environment stop. Required with probe: a bound the tenant did not write is a forecast.\"\n        }\n      },\n      \"dependentRequired\": {\"probe\": [\"probe_timeout_s\"]}\n    },\n    \"forge\": {\n      \"type\": \"object\",\n      \"description\": \"The tenant's own commit-status and issue-tracking reads. The product names no vendor: both keys are commands the tenant supplies. Optional; attavo verify refuses without checks_command, and attavo file-findings refuses without file_issue_command, but neither key requires the other.\",\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"checks_command\": {\n          \"type\": \"string\",\n          \"description\": \"Takes a full commit sha on argv; prints one line per check as \\\"<name> <conclusion>\\\". attavo verify runs it on the item's latest build record's sha before calling any adapter.\",\n          \"minLength\": 1\n        },\n        \"check_log_command\": {\n          \"type\": \"string\",\n          \"description\": \"Takes a sha and a check name on argv; prints that check's own failed-step log. attavo counsel runs it once per check checks_command reported as not \\\"success\\\" on the counseled record's sha, before handing the adapter ATTAVO_COUNSEL_CHECKS -- absent, counsel's own record says so (forge.read: false) rather than reading the forge as if it were green.\",\n          \"minLength\": 1\n        },\n        \"file_issue_command\": {\n          \"type\": \"string\",\n          \"description\": \"Reads one finding as JSON on stdin and files it as a tenant issue. attavo file-findings runs it once per finding in the item's latest verify record.\",\n          \"minLength\": 1\n        },\n        \"attestation_command\": {\n          \"type\": \"string\",\n          \"description\": \"Reads a merge commit sha on stdin and prints that merge's attestation statement as JSON on exit 0; nothing on a non-zero exit. The doctor's fifth proof runs it once per merged, fully-staged item to require a statement in the store.\",\n          \"minLength\": 1\n        },\n        \"sealed_since\": {\n          \"type\": \"string\",\n          \"description\": \"A commit. A merge at or before it is before the window: the tenant could not seal it (no queue, no signing workflow, or a store that held nothing yet). Defaults to the install commit; set it only for a repository that ran the product before it could seal, to the first parent of its first sealed merge, and say why in the commit that sets it.\",\n          \"minLength\": 7\n        }\n      }\n    },\n    \"spec\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\"boundary\"],\n      \"properties\": {\n        \"research\": {\n          \"type\": \"string\",\n          \"enum\": [\"required\"],\n          \"description\": \"Set to \\\"required\\\" and a core spec owes a research record in the item's records before its gate passes. Absent, it owes none, and every gate record says so (ruled 2026-09-27: behind this flag until the Plan area hosts research).\"\n        },\n        \"boundary\": {\n          \"type\": \"object\",\n          \"description\": \"Which changes take the governed path. A change outside the boundary takes the tenant's ordinary pull-request flow, and the path ratio measures both.\",\n          \"additionalProperties\": false,\n          \"properties\": {\n            \"paths\": {\n              \"type\": \"array\",\n              \"items\": {\"type\": \"string\", \"minLength\": 1},\n              \"description\": \"Glob patterns; a change touching any of them is governed.\"\n            },\n            \"labels\": {\n              \"type\": \"array\",\n              \"items\": {\"type\": \"string\", \"minLength\": 1},\n              \"description\": \"Issue labels; an issue carrying any of them is governed.\"\n            },\n            \"max_ordinary_lines\": {\n              \"type\": \"integer\",\n              \"minimum\": 0,\n              \"description\": \"A change above this many net lines is governed regardless of path or label.\"\n            }\n          }\n        }\n      }\n    },\n    \"gates\": {\n      \"type\": \"object\",\n      \"description\": \"Every gate the tenant runs, by name. The doctor's first proof is that each one rejects its fixture; a gate absent from this table does not exist.\",\n      \"propertyNames\": {\"pattern\": \"^[a-z][a-z0-9-]*$\"},\n      \"additionalProperties\": {\n        \"type\": \"object\",\n        \"additionalProperties\": false,\n        \"required\": [\"command\", \"retires\"],\n        \"properties\": {\n          \"command\": {\n            \"type\": \"string\",\n            \"description\": \"The script the gate runs, invoked with the tenant root as its working directory. Exit status is the verdict: non-zero rejects.\",\n            \"minLength\": 1\n          },\n          \"retires\": {\n            \"type\": \"array\",\n            \"minItems\": 1,\n            \"items\": {\"type\": \"string\", \"minLength\": 1},\n            \"description\": \"What this gate replaced. A gate that retires nothing is not admitted to the table.\"\n          }\n        }\n      }\n    },\n    \"paths\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\"specs\", \"records\", \"rulings\", \"rejections\"],\n      \"properties\": {\n        \"specs\": {\"type\": \"string\", \"minLength\": 1, \"description\": \"Directory of specs, one per work item, named by issue number.\"},\n        \"rejections\": {\"type\": \"string\", \"minLength\": 1, \"description\": \"Directory of rejection fixtures, one subdirectory per gate name. The doctor's first proof runs each gate against its fixture and requires a rejection.\"},\n        \"records\": {\"type\": \"string\", \"minLength\": 1, \"description\": \"Directory of records, append-only, one subdirectory per work item named by issue number. Scripts write every file here.\"},\n        \"rulings\": {\"type\": \"string\", \"minLength\": 1, \"description\": \"The tenant's rulings file, rendered read-only; the merge of a proposed amendment is the ruling.\"}\n      }\n    },\n    \"operators\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\"approvers\"],\n      \"properties\": {\n        \"approvers\": {\n          \"type\": \"array\",\n          \"items\": {\"type\": \"string\", \"minLength\": 1},\n          \"description\": \"Logins allowed to bind a spec's approval to a commit. `attavo approve` refuses a LOGIN not on this list.\"\n        }\n      }\n    },\n    \"doctor\": {\n      \"type\": \"object\",\n      \"description\": \"Optional; the doctor's own read. Absent, proof three's window starts at the install commit, as it always has.\",\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"from\": {\n          \"type\": \"string\",\n          \"description\": \"Anything git rev-parse --verify resolves to a commit on main's first-parent line, at or after the install commit -- a full or abbreviated sha, a tag, a ref -- where proof three's window starts. A tenant that adopted the product on a repository with pre-existing history names the commit after which every push arrived through the queue. Resolved and checked against main's first-parent line, not trusted: a spelling that does not resolve, or a commit that is not on that line, is refused by name.\",\n          \"minLength\": 1\n        },\n        \"built_since\": {\n          \"type\": \"string\",\n          \"description\": \"Anything git rev-parse --verify resolves to a commit. Proof seven (no attested item is empty) names items merged at or before it as before the window instead of failing them: the specimen that produced the proof stays on the record without failing the tenant forever. Absent, proof seven's window is proof three's.\",\n          \"minLength\": 1\n        }\n      }\n    },\n    \"drive\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"stall_after_s\": {\n          \"type\": \"integer\",\n          \"minimum\": 1,\n          \"description\": \"seconds without a new event past which a live invocation is hung; attavo drive --recover terminates and records it\"\n        },\n        \"attempts\": {\n          \"type\": \"integer\",\n          \"minimum\": 1,\n          \"description\": \"R3: attempts a stage may spend before the item is a person's; 3 when absent\"\n        },\n        \"retry_after_s\": {\n          \"type\": \"integer\",\n          \"minimum\": 0,\n          \"description\": \"R3: seconds a transient stop waits before its next attempt; 300 when absent\"\n        },\n        \"build\": {\n          \"type\": \"object\",\n          \"additionalProperties\": false,\n          \"properties\": {\n            \"ceiling_s\": {\"type\": \"integer\", \"minimum\": 1, \"description\": \"R3: wall clock past which a live build is hung by its ceiling\"}\n          }\n        },\n        \"verify\": {\n          \"type\": \"object\",\n          \"additionalProperties\": false,\n          \"properties\": {\n            \"ceiling_s\": {\"type\": \"integer\", \"minimum\": 1, \"description\": \"R3: wall clock past which a live review is hung by its ceiling\"}\n          }\n        }\n      }\n    }\n  }\n}","is_error":false}]},"parent_tool_use_id":null,"session_id":"f2e0c4f7-36d4-465e-a2fe-27db257201e7","uuid":"0cf5bfe7-38ab-4e51-846f-7470b76c0f8b","timestamp":"2026-09-30T01:01:06.817Z","tool_use_result":{"stdout":"{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"$id\": \"https://attavo.dev/schema/manifest/2\",\n  \"title\": \"Attavo tenant manifest (attavo.toml)\",\n  \"description\": \"What a tenant declares to install Attavo: the release it pins, the executor it chose, where the governed path begins and ends, the gates it runs, and where its specs, records, and rulings live. Every key is read by a script; a key no script reads does not belong here.\",\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"required\": [\"schema_version\", \"attavo\", \"executor\", \"spec\", \"gates\", \"paths\", \"operators\"],\n  \"properties\": {\n    \"schema_version\": {\n      \"type\": \"integer\",\n      \"const\": 1\n    },\n    \"attavo\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\"version\"],\n      \"properties\": {\n        \"version\": {\n          \"type\": \"string\",\n          \"description\": \"The Attavo release tag the tenant pins. The tenant holds no Attavo binary; the pinned action supplies it.\",\n          \"pattern\": \"^v[0-9]+\\\\.[0-9]+\\\\.[0-9]+$\"\n        }\n      }\n    },\n    \"executor\": {\n      \"type\": \"object\",\n      \"required\": [\"build\"],\n      \"properties\": {\n        \"build\": {\n          \"type\": \"string\",\n          \"description\": \"Adapter name for the build invocation. The contract is thin: spec, corpus, and branch in; commits and a report record out.\",\n          \"minLength\": 1\n        },\n        \"verify\": {\n          \"type\": \"string\",\n          \"description\": \"Adapter name for the verify invocation. Defaults to build's adapter; may differ.\",\n          \"minLength\": 1\n        }\n      },\n      \"additionalProperties\": {\n        \"type\": \"object\",\n        \"description\": \"[executor.<adapter-name>]: that adapter's own configuration, passed through as ATTAVO_ADAPTER_CONFIG and copied verbatim into build-NN.json as adapter_config. The product does not know what an adapter's settings mean -- any keys, none required. Never put a secret in here: it lands in a record.\"\n      }\n    },\n    \"tests\": {\n      \"type\": \"object\",\n      \"description\": \"How build finds and runs the tests for a touched path. Both keys are required together; a tenant with no [tests] table has not declared selection, and attavo build refuses to run on it.\",\n      \"additionalProperties\": false,\n      \"required\": [\"select\", \"run\"],\n      \"properties\": {\n        \"select\": {\n          \"type\": \"string\",\n          \"description\": \"A command that reads touched paths on stdin, one per line, and writes test identifiers on stdout, one per line.\",\n          \"minLength\": 1\n        },\n        \"exclude_in_executor\": {\n          \"type\": \"array\",\n          \"items\": {\"type\": \"string\", \"minLength\": 1},\n          \"description\": \"Test identifiers attavo test leaves out when it runs inside an executor (ATTAVO_STAGE set): tests that need a live tenant, the network, or the process's own working directory. CI runs them.\"\n        },\n        \"run\": {\n          \"type\": \"string\",\n          \"description\": \"A command that reads test identifiers on stdin, one per line; its exit code is the verdict.\",\n          \"minLength\": 1\n        },\n        \"call_timeout_s\": {\n          \"type\": \"integer\",\n          \"minimum\": 1,\n          \"description\": \"Seconds one `attavo test` run is given before its process group is ended and it exits 124. The executor's own test runs are bounded; the gate's are not.\"\n        }\n      }\n    },\n    \"checks\": {\n      \"type\": \"object\",\n      \"description\": \"The tenant's own definition of done: a whole-tree check, as the tenant runs it locally. attavo build runs it each iteration, after the claims boundary, the criteria, and the selected tests -- pass requires its exit to be 0, and a non-zero exit reaches the executor as feedback. Optional; a tenant that declares none is not refused (unlike [tests], which build requires).\",\n      \"additionalProperties\": false,\n      \"required\": [\"command\"],\n      \"properties\": {\n        \"command\": {\n          \"type\": \"string\",\n          \"description\": \"The tenant's whole-tree check at the gate, run from the tenant root once per iteration on the committed tree. What is fast and decisive belongs here; what the forge runs as a required check need not be run twice.\",\n          \"minLength\": 1\n        },\n        \"probe\": {\n          \"type\": \"string\",\n          \"description\": \"A cheap command that answers whether this machine can run the checks at all, run once before a build's executor is invoked: exit 0 yes, anything else an environment refusal. When absent, attavo build asks by running [checks].command whole and reads exit 2 alone as cannot run.\",\n          \"minLength\": 1\n        },\n        \"probe_timeout_s\": {\n          \"type\": \"integer\",\n          \"minimum\": 1,\n          \"description\": \"Seconds [checks].probe is given; past it the build is refused as an environment stop. Required with probe: a bound the tenant did not write is a forecast.\"\n        }\n      },\n      \"dependentRequired\": {\"probe\": [\"probe_timeout_s\"]}\n    },\n    \"forge\": {\n      \"type\": \"object\",\n      \"description\": \"The tenant's own commit-status and issue-tracking reads. The product names no vendor: both keys are commands the tenant supplies. Optional; attavo verify refuses without checks_command, and attavo file-findings refuses without file_issue_command, but neither key requires the other.\",\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"checks_command\": {\n          \"type\": \"string\",\n          \"description\": \"Takes a full commit sha on argv; prints one line per check as \\\"<name> <conclusion>\\\". attavo verify runs it on the item's latest build record's sha before calling any adapter.\",\n          \"minLength\": 1\n        },\n        \"check_log_command\": {\n          \"type\": \"string\",\n          \"description\": \"Takes a sha and a check name on argv; prints that check's own failed-step log. attavo counsel runs it once per check checks_command reported as not \\\"success\\\" on the counseled record's sha, before handing the adapter ATTAVO_COUNSEL_CHECKS -- absent, counsel's own record says so (forge.read: false) rather than reading the forge as if it were green.\",\n          \"minLength\": 1\n        },\n        \"file_issue_command\": {\n          \"type\": \"string\",\n          \"description\": \"Reads one finding as JSON on stdin and files it as a tenant issue. attavo file-findings runs it once per finding in the item's latest verify record.\",\n          \"minLength\": 1\n        },\n        \"attestation_command\": {\n          \"type\": \"string\",\n          \"description\": \"Reads a merge commit sha on stdin and prints that merge's attestation statement as JSON on exit 0; nothing on a non-zero exit. The doctor's fifth proof runs it once per merged, fully-staged item to require a statement in the store.\",\n          \"minLength\": 1\n        },\n        \"sealed_since\": {\n          \"type\": \"string\",\n          \"description\": \"A commit. A merge at or before it is before the window: the tenant could not seal it (no queue, no signing workflow, or a store that held nothing yet). Defaults to the install commit; set it only for a repository that ran the product before it could seal, to the first parent of its first sealed merge, and say why in the commit that sets it.\",\n          \"minLength\": 7\n        }\n      }\n    },\n    \"spec\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\"boundary\"],\n      \"properties\": {\n        \"research\": {\n          \"type\": \"string\",\n          \"enum\": [\"required\"],\n          \"description\": \"Set to \\\"required\\\" and a core spec owes a research record in the item's records before its gate passes. Absent, it owes none, and every gate record says so (ruled 2026-09-27: behind this flag until the Plan area hosts research).\"\n        },\n        \"boundary\": {\n          \"type\": \"object\",\n          \"description\": \"Which changes take the governed path. A change outside the boundary takes the tenant's ordinary pull-request flow, and the path ratio measures both.\",\n          \"additionalProperties\": false,\n          \"properties\": {\n            \"paths\": {\n              \"type\": \"array\",\n              \"items\": {\"type\": \"string\", \"minLength\": 1},\n              \"description\": \"Glob patterns; a change touching any of them is governed.\"\n            },\n            \"labels\": {\n              \"type\": \"array\",\n              \"items\": {\"type\": \"string\", \"minLength\": 1},\n              \"description\": \"Issue labels; an issue carrying any of them is governed.\"\n            },\n            \"max_ordinary_lines\": {\n              \"type\": \"integer\",\n              \"minimum\": 0,\n              \"description\": \"A change above this many net lines is governed regardless of path or label.\"\n            }\n          }\n        }\n      }\n    },\n    \"gates\": {\n      \"type\": \"object\",\n      \"description\": \"Every gate the tenant runs, by name. The doctor's first proof is that each one rejects its fixture; a gate absent from this table does not exist.\",\n      \"propertyNames\": {\"pattern\": \"^[a-z][a-z0-9-]*$\"},\n      \"additionalProperties\": {\n        \"type\": \"object\",\n        \"additionalProperties\": false,\n        \"required\": [\"command\", \"retires\"],\n        \"properties\": {\n          \"command\": {\n            \"type\": \"string\",\n            \"description\": \"The script the gate runs, invoked with the tenant root as its working directory. Exit status is the verdict: non-zero rejects.\",\n            \"minLength\": 1\n          },\n          \"retires\": {\n            \"type\": \"array\",\n            \"minItems\": 1,\n            \"items\": {\"type\": \"string\", \"minLength\": 1},\n            \"description\": \"What this gate replaced. A gate that retires nothing is not admitted to the table.\"\n          }\n        }\n      }\n    },\n    \"paths\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\"specs\", \"records\", \"rulings\", \"rejections\"],\n      \"properties\": {\n        \"specs\": {\"type\": \"string\", \"minLength\": 1, \"description\": \"Directory of specs, one per work item, named by issue number.\"},\n        \"rejections\": {\"type\": \"string\", \"minLength\": 1, \"description\": \"Directory of rejection fixtures, one subdirectory per gate name. The doctor's first proof runs each gate against its fixture and requires a rejection.\"},\n        \"records\": {\"type\": \"string\", \"minLength\": 1, \"description\": \"Directory of records, append-only, one subdirectory per work item named by issue number. Scripts write every file here.\"},\n        \"rulings\": {\"type\": \"string\", \"minLength\": 1, \"description\": \"The tenant's rulings file, rendered read-only; the merge of a proposed amendment is the ruling.\"}\n      }\n    },\n    \"operators\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\"approvers\"],\n      \"properties\": {\n        \"approvers\": {\n          \"type\": \"array\",\n          \"items\": {\"type\": \"string\", \"minLength\": 1},\n          \"description\": \"Logins allowed to bind a spec's approval to a commit. `attavo approve` refuses a LOGIN not on this list.\"\n        }\n      }\n    },\n    \"doctor\": {\n      \"type\": \"object\",\n      \"description\": \"Optional; the doctor's own read. Absent, proof three's window starts at the install commit, as it always has.\",\n      \"additionalProperties\": false,\n      \"properties\": {\n        \"from\": {\n          \"type\": \"string\",\n          \"description\": \"Anything git rev-parse --verify resolves to a commit on main's first-parent line, at or after the install commit -- a full or abbreviated sha, a tag, a ref -- where proof three's window starts. A tenant that adopted the product on a repository with pre-existing history names the commit after which every push arrived through the queue. Resolved and checked against main's first-parent line, not trusted: a spelling that does not resolve, or a commit that is not on that line, is refused by name.\",\n          \"minLength\": 1\n        },\n        \"built_since\": {\n          \"type\": \"string\",\n          \"description\": \"Anything git rev-parse --verify resolves to a commit. Proof seven (no attested item is empty) names items merged at or before it as before the window instead of failing them: the specimen that produced the proof stays on the record without failing the tenant forever. Absent, proof seven's window is proof three's.\",\n          \"min
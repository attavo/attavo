     return _advance_again(root, m, item_id, state.target_stage, r[\"head\"]), r\n\n    print(f\"attavo drive: {r['says']}\")\n    return (1 if r[\"state\"] == \"refused\" else 0), r\n\n\n_TERMINAL_STATES = (\"waiting-on-approval\", \"stopped\", \"ready-to-merge\", \"merged\")\n\n\ndef _until_ready(root: Path, m: dict[str, Any], item_id: str, again: str | None) -> int:\n    \"\"\"--until-ready: the pass, repeated in one process, sleeping\n    ATTAVO_DRIVE_POLL_INTERVAL_S between passes, until the level is the\n    operator's or done (exit 0), a concluded check is red (exit 1), or\n    an unconcluded one has not concluded within ATTAVO_DRIVE_POLL_BOUND_S\n    (exit 1). A stage running in its own worker is not bounded by this --\n    only time spent waiting on the forge is.\"\"\"\n    from attavo.verify import drive_forge_poll_bound_s, drive_forge_poll_interval_s\n    bound = drive_forge_poll_bound_s()\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-asweINgW' (errno=Operation not permitted)\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-f9ImgCdo' (errno=Operation not permitted)\n attest/records/267/approval-01.json | 10 ++++++\n attest/records/267/build-01.filed   |  1 +\n attest/records/267/build-01.json    | 51 +++++++++++++++++++++++++++++++\n attest/records/267/build-01.log     |  3 ++\n attest/records/267/build-01.started |  6 ++++\n attest/records/267/build-02.started |  6 ++++\n attest/records/267/counsel-01.json  | 61 +++++++++++++++++++++++++++++++++++++\n attest/records/267/counsel-01.log   | 13 ++++++++\n 8 files changed, 151 insertions(+)\n    1589 /var/folders/k6/kwlls81j5gvf1p1_hbh9mn8m0000gn/T/tmpdh0o4na5/diff.patch\n+    shipped -- tenant zero's real shape at 3648830, common keys across 49\n+    records: ['at', 'sha'] and nothing else -- loads with record_version 1\n+    and item filled from the directory it sits under. The disk copy is\n+    never touched: version 1 is never migrated (issue #60, operator\n+    ruling 2026-09-09: record_version is a label, never a trigger for\n+    reading or upgrading an older record).\"\"\"\n+    attavo = attavo_module()\n+    records_dir = tmp_path / \"records\" / \"1\"\n+    records_dir.mkdir(parents=True)\n+    tenant_zero_shape = {\"sha\": \"a\" * 40, \"at\": \"2026-01-01T00:00:00Z\"}\n+    (records_dir / \"build-01.json\").write_text(json.dumps(tenant_zero_shape))\n+\n+    items = attavo.load_records(tmp_path / \"records\")\n+    rec = items[\"1\"][\"build\"]\n+    assert rec[\"record_version\"] == 1\n+    assert rec[\"item\"] == \"1\"\n+\n+    on_disk = json.loads((records_dir / \"build-01.json\").read_text())\n+    assert on_disk == tenant_zero_shape\n+\n+\n+def test_load_records_refuses_an_item_that_disagrees_with_its_directory(tmp_path: Path) -> None:\n+    \"\"\"Acceptance 5: a record whose item field names a different item\n+    than the directory it was found in -- a misfiled or copied record --\n+    is refused rather than trusted.\"\"\"\n+    attavo = attavo_module()\n+    records_dir = tmp_path / \"records\" / \"1\"\n+    records_dir.mkdir(parents=True)\n+    (records_dir / \"build-01.json\").write_text(json.dumps(\n+        {\"sha\": \"a\" * 40, \"at\": \"2026-01-01T00:00:00Z\", \"item\": \"2\"}))\n+\n+    with pytest.raises(attavo.RecordItemMismatch):\n+        attavo.load_records(tmp_path / \"records\")\n+\n+\n+def test_only_load_record_parses_record_file_content() -> None:\n+    \"\"\"Acceptance 6: _load_record is the one place in this repository\n+    that turns a <stage>-NN.json record's bytes into a dict; parse_attempts\n+    and load_records both read through it rather than calling json.loads\n+    themselves. `git grep -n \"json.loads(\" bin/attavo` still finds eleven\n+    other sites -- a schema file, attavo test's own cache of exit-0 runs\n+    under the git directory (never a record), an adapter's conformance.json (read\n+    twice: once for its declared reports, once for R3's own\n+    streams_events), an adapter's own stdout report, proof four's own\n+    read of one log line at a time to tell an adapter's JSON event\n+    stream from a tool's plain-text error (issue #94), proof five's own\n+    read of the forge's attestation statement (issue #158), and verify's\n+    own read of the forge checks a drive pass already wrote (issue #217,\n+    ATTAVO_FORGE_CHECKS), and the Plan store's two: a version\n+    of a store document, and the file `attavo plan put` is given -- working\n+    material outside git, never a record -- and the tenant's issues as\n+    [forge].issues_command prints them.\"\"\"\n+    text = \"\\n\".join(p.read_text() for p in sorted((ROOT / \"attavo\").rglob(\"*.py\")))\n+    assert text.count(\"json.loads(\") == 12, (\n+        \"a new json.loads( site was added; review it against issue #60 acceptance 6 \"\n+        \"and update this count\")\n+    assert \"data = json.loads(path.read_text())\" in text\n+\n+    for fn in (\"parse_attempts\", \"load_records\"):\n+        # The implementation is the last def of the name: the typed loaders'\n+        # @overload stubs (issue #189) precede it.\n+        start = text.rindex(f\"\\ndef {fn}(\")\n+        end = text.index(\"\\ndef \", start + 1)\n+        body = text[start:end]\n+        assert \"json.loads(\" not in body, f\"{fn} should read through _load_record, not parse directly\"\n+        assert \"_load_record(\" in body\n+\n+\n+def test_build_and_verify_schemas_carry_what_a_stop_is_derived_from() -> None:\n+    \"\"\"Issue #254: refusal_kind (build) and report_class (both) are required\n+    nullable keys, and the schema's version has moved past the last one\n+    that lacked them -- record_version is how the doctor tells them apart.\"\"\"\n+    build, verify = load_schema(\"build\"), load_schema(\"verify\")\n+    for schema, keys, first in ((build, (\"refusal_kind\", \"report_class\"), 11),\n+                                (verify, (\"report_class\",), 10)):\n+        for key in keys:\n+            assert key in schema[\"required\"], key\n+            assert \"null\" in schema[\"properties\"][key][\"type\"], key\n+        assert int(schema[\"$id\"].rsplit(\"/\", 1)[-1]) >= first\n+    assert \"refusal_kind\" not in verify[\"properties\"]\n","exit_code":0,"status":"completed"}}

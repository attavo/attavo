{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1,75p' attavo/testtool.py; git diff 243a9c2190795c432fa08662722648349a71ebcf..e18ec719430a0e660297b96f98e77915a4acc264 -- attavo/issues.py .attavo/bin/forge-issues tests/test_issues.py schema/manifest.schema.json attavo.toml .attavo/bin/select-tests tests/test_record_schemas.py\"","aggregated_output":"from __future__ import annotations\n\nimport os\nimport signal\nimport subprocess\nimport sys\nfrom pathlib import Path\nfrom typing import Any\n\nfrom attavo.common import MANIFEST, derive_item_id, git, read_manifest\n\n# --- test: the executor's one test command (issue #212) --\n# The tests [tests].select names for every path the item has changed since\n# it left the default branch, run through [tests].run, bounded by\n# [tests].call_timeout_s. The executor is given this and not the tenant's\n# whole-tree checks: given a checks command it ran it (#194's 590 s wait;\n# #204 and #206 ran the suite twice inside one build), and the gate runs\n# them after every commit whatever the executor does. ---\n\nTIMED_OUT_EXIT = 124\n\n# What an ended run is given to leave on its own after SIGTERM, before its\n# whole process group is sent SIGKILL.\nEND_GRACE_S = 2\n\n\ndef _signal_group(proc: \"subprocess.Popen[str]\", sig: int) -> None:\n    try:\n        os.killpg(proc.pid, sig)\n    except ProcessLookupError:\n        pass\n\n\ndef run_bounded(command: str, root: Path, stdin: str, timeout_s: int | None\n                ) -> tuple[int, str, str, bool]:\n    \"\"\"(exit, stdout, stderr, timed_out) of `command` run through the shell\n    from root. The command is its own process group's leader, so a run past\n    timeout_s is ended with everything it started -- a test runner's\n    workers and a shell's background jobs alike -- rather than only the\n    shell, which would leave them holding the pipes and the machine. A run\n    that outlasts its bound exits 124, as timeout(1) does.\"\"\"\n    proc = subprocess.Popen(command, shell=True, cwd=str(root), stdin=subprocess.PIPE,\n                            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,\n                            start_new_session=True)\n    try:\n        out, err = proc.communicate(stdin, timeout=timeout_s)\n    except subprocess.TimeoutExpired:\n        _signal_group(proc, signal.SIGTERM)\n        try:\n            out, err = proc.communicate(timeout=END_GRACE_S)\n        except subprocess.TimeoutExpired:\n            _signal_group(proc, signal.SIGKILL)\n            try:\n                out, err = proc.communicate(timeout=END_GRACE_S)\n            except subprocess.TimeoutExpired:\n                # something the run started left its group and holds the pipes\n                out, err = \"\", \"\"\n        _signal_group(proc, signal.SIGKILL)\n        return TIMED_OUT_EXIT, out, err, True\n    _signal_group(proc, signal.SIGKILL)\n    return proc.returncode, out, err, False\n\n\ndef without_records(paths: list[str], records_rel: str) -> list[str]:\n    \"\"\"paths other than paths.records itself and what is under it -- the\n    records directory is where the product writes, not the item's work.\"\"\"\n    prefix = records_rel.rstrip(\"/\") + \"/\"\n    return [p for p in paths if p and p != records_rel and not p.startswith(prefix)]\n\n\ndef changed_since_default_branch(root: Path, records_rel: str) -> list[str]:\n    \"\"\"Every path the item has changed since it left the default branch,\n    committed or not: tracked paths whose content differs from the\n    merge-base with what refs/remotes/origin/HEAD names -- deleted and\n    renamed-from paths included, staged or not -- and untracked paths that\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-CUOZjFYY' (errno=Operation not permitted)\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-eB3x4bof' (errno=Operation not permitted)\ndiff --git a/.attavo/bin/forge-issues b/.attavo/bin/forge-issues\nnew file mode 100755\nindex 0000000..154bd25\n--- /dev/null\n+++ b/.attavo/bin/forge-issues\n@@ -0,0 +1,51 @@\n+#!/usr/bin/env python3\n+\"\"\"forge-issues: [forge].issues_command for this repository.\n+\n+Prints every issue in this repository, open and closed, as one JSON list\n+of {number, title, state, closed_at, labels, body}, the shape\n+schema/manifest.schema.json names for [forge].issues_command. The\n+product parses each body's \"## Claims\" section itself; this script only\n+translates the forge's words (\"OPEN\", label objects) into that shape.\n+\n+Exits non-zero, printing nothing to stdout, when the forge cannot be\n+read: the product reads that as \"not read\", never as no issues.\n+\n+Usage: forge-issues\n+Requires: `gh`, authenticated, run inside this repository's checkout.\n+\"\"\"\n+from __future__ import annotations\n+\n+import json\n+import subprocess\n+import sys\n+\n+LIMIT = 2000\n+\n+\n+def main() -> int:\n+    run = subprocess.run(\n+        [\"gh\", \"issue\", \"list\", \"--state\", \"all\", \"--limit\", str(LIMIT),\n+         \"--json\", \"number,title,state,closedAt,labels,body\"],\n+        capture_output=True, text=True, timeout=50, check=False,\n+    )\n+    if run.returncode != 0:\n+        print(run.stderr.strip() or \"forge-issues: gh issue list failed\", file=sys.stderr)\n+        return 1\n+    try:\n+        raw = json.loads(run.stdout)\n+    except json.JSONDecodeError:\n+        print(\"forge-issues: gh printed no JSON\", file=sys.stderr)\n+        return 1\n+    if len(raw) >= LIMIT:\n+        print(f\"forge-issues: {LIMIT} issues or more; the list would be cut short\", file=sys.stderr)\n+        return 1\n+    out = [{\"number\": i[\"number\"], \"title\": i[\"title\"], \"state\": str(i[\"state\"]).lower(),\n+            \"closed_at\": i.get(\"closedAt\") or None,\n+            \"labels\": [lb[\"name\"] for lb in i.get(\"labels\") or []],\n+            \"body\": i.get(\"body\") or \"\"} for i in raw]\n+    print(json.dumps(out))\n+    return 0\n+\n+\n+if __name__ == \"__main__\":\n+    sys.exit(main())\ndiff --git a/.attavo/bin/select-tests b/.attavo/bin/select-tests\nindex 1a331d9..2763d1b 100644\n--- a/.attavo/bin/select-tests\n+++ b/.attavo/bin/select-tests\n@@ -51,6 +51,7 @@ MODULE_TESTS: dict[str, tuple[str, ...]] = {\n                          \"tests/test_sealed_since_default.py\"),\n     \"attavo/drive.py\": (\"tests/test_drive.py\",),\n     \"attavo/filing.py\": (\"tests/test_file_findings.py\", \"tests/test_file_stops.py\"),\n+    \"attavo/issues.py\": (\"tests/test_issues.py\",),\n     \"attavo/ledger.py\": (\"tests/test_ledger.py\",),\n     \"attavo/plan.py\": (\"tests/test_plan.py\",),\n     \"attavo/record_only.py\": (\"tests/test_record_only.py\",),\n@@ -65,6 +66,7 @@ MODULE_TESTS: dict[str, tuple[str, ...]] = {\n     \"schema/plan.schema.json\": (\"tests/test_plan.py\",),\n     \"schema/manifest.schema.json\": (\"tests/test_self_tenancy.py\", \"tests/test_record_schemas.py\",\n                                     \"tests/test_testtool.py\"),\n+    \".attavo/bin/forge-issues\": (\"tests/test_issues.py\",),\n     \".attavo/bin/select-tests\": (\"tests/test_self_tenancy.py\", \"tests/test_testtool.py\"),\n }\n \ndiff --git a/attavo.toml b/attavo.toml\nindex 231e157..4edcb49 100644\n--- a/attavo.toml\n+++ b/attavo.toml\n@@ -7,6 +7,7 @@ version = \"v0.30.0\"\n checks_command = \"python3 .attavo/bin/forge-checks\"\n check_log_command = \"python3 .attavo/bin/forge-check-log\"\n file_issue_command = \"python3 .attavo/bin/file-issue\"\n+issues_command = \"python3 .attavo/bin/forge-issues\"\n attestation_command = \"sh .attavo/bin/forge-attestation\"\n sealed_since = \"83fcbc6863fdb65956b77768c66c2103d221521b\"\n \ndiff --git a/attavo/issues.py b/attavo/issues.py\nnew file mode 100644\nindex 0000000..af1b1c7\n--- /dev/null\n+++ b/attavo/issues.py\n@@ -0,0 +1,104 @@\n+\"\"\"The tenant's issues, read through [forge].issues_command.\n+\n+The issue is the unit of work (ruled 2026-09-29): the plan in the store\n+(attavo/plan.py) orders issues, and the forge holds what the plan does\n+not -- each issue's title, whether it is open, when it closed, its\n+labels, and, before it has a spec, the paths it claims in a \"## Claims\"\n+section of its body. The product names no vendor: the tenant's command\n+prints the issues as JSON, one object per issue, and this module reads\n+it. The claims are parsed here, not by the tenant's command, so every\n+tenant's issues are read by one rule.\n+\n+A read that cannot be made is \"not read\" with its reason, never an empty\n+list: no command in the manifest, a command that exits non-zero or runs\n+past its bound, or output that is not the shape below.\n+\n+    [{\"number\": 264, \"title\": \"...\", \"state\": \"open\" | \"closed\",\n+      \"closed_at\": \"<iso>\" | null, \"labels\": [\"...\"], \"body\": \"...\"}]\n+\"\"\"\n+from __future__ import annotations\n+\n+import json\n+from pathlib import Path\n+from typing import Any, TypedDict\n+\n+from attavo.testtool import run_bounded\n+\n+TIMEOUT_S = 60\n+STATES = (\"open\", \"closed\")\n+\n+\n+class Issue(TypedDict):\n+    number: int\n+    title: str\n+    state: str\n+    closed_at: str | None\n+    labels: list[str]\n+    claims: list[str] | None\n+\n+\n+def parse_claims(body: str) -> list[str] | None:\n+    \"\"\"The paths under a \"## Claims\" heading, up to the next \"## \"\n+    heading: one \"- path\" line each. None when the body has no Claims\n+    section, which is not the same as a section that lists nothing.\"\"\"\n+    lines = body.splitlines()\n+    starts = [i for i, line in enumerate(lines) if line.rstrip() == \"## Claims\"]\n+    if not starts:\n+        return None\n+    claims = []\n+    for line in lines[starts[0] + 1:]:\n+        if line.startswith(\"## \"):\n+            break\n+        s = line.strip()\n+        if s.startswith(\"- \"):\n+            path = s[2:].strip().strip(\"`\")\n+            if path:\n+                claims.append(path)\n+    return claims\n+\n+\n+def _shape_error(raw: Any) -> str | None:\n+    if not isinstance(raw, list):\n+        return \"the output is not a list\"\n+    for i, x in enumerate(raw):\n+        if not isinstance(x, dict):\n+            return f\"entry {i} is not an object\"\n+        n = x.get(\"number\")\n+        if not isinstance(n, int) or isinstance(n, bool) or n < 1:\n+            return f\"entry {i} has no issue number\"\n+        if not isinstance(x.get(\"title\"), str):\n+            return f\"#{n} has no title\"\n+        if x.get(\"state\") not in STATES:\n+            return f\"#{n} has state {x.get('state')!r}, not open or closed\"\n+        if x.get(\"closed_at\") is not None and not isinstance(x.get(\"closed_at\"), str):\n+            return f\"#{n} has a closed_at that is not text\"\n+        labels = x.get(\"labels\", [])\n+        if not isinstance(labels, list) or not all(isinstance(lb, str) for lb in labels):\n+            return f\"#{n} has labels that are not a list of names\"\n+        if not isinstance(x.get(\"body\", \"\"), str):\n+            return f\"#{n} has a body that is not text\"\n+    return None\n+\n+\n+def read_issues(root: Path, m: dict[str, Any]) -> tuple[list[Issue] | None, str | None]:\n+    \"\"\"(issues, None), or (None, \"not read: <why>\").\"\"\"\n+    command = (m.get(\"forge\") or {}).get(\"issues_command\")\n+    if not command:\n+        return None, \"not read: no [forge].issues_command\"\n+    code, out, err, timed_out = run_bounded(command, root, \"\", TIMEOUT_S)\n+    if timed_out:\n+        return None, f\"not read: [forge].issues_command ran past {TIMEOUT_S}s\"\n+    if code != 0:\n+        last = (err.strip().splitlines() or [\"\"])[-1]\n+        return None, f\"not read: [forge].issues_command exited {code}\" + (f\": {last}\" if last else \"\")\n+    try:\n+        raw = json.loads(out)\n+    except json.JSONDecodeError as e:\n+        return None, f\"not read: [forge].issues_command printed no JSON ({e.msg})\"\n+    bad = _shape_error(raw)\n+    if bad:\n+        return None, f\"not read: [forge].issues_command: {bad}\"\n+    issues: list[Issue] = [{\"number\": x[\"number\"], \"title\": x[\"title\"], \"state\": x[\"state\"],\n+                            \"closed_at\": x.get(\"closed_at\"), \"labels\": list(x.get(\"labels\", [])),\n+                            \"claims\": parse_claims(x.get(\"body\", \"\") or \"\")} for x in raw]\n+    return sorted(issues, key=lambda i: i[\"number\"]), None\ndiff --git a/schema/manifest.schema.json b/schema/manifest.schema.json\nindex 2bc2c5a..7903f79 100644\n--- a/schema/manifest.schema.json\n+++ b/schema/manifest.schema.json\n@@ -97,7 +97,7 @@\n     },\n     \"forge\": {\n       \"type\": \"object\",\n-      \"description\": \"The tenant's own commit-status and issue-tracking reads. The product names no vendor: both keys are commands the tenant supplies. Optional; attavo verify refuses without checks_command, and attavo file-findings refuses without file_issue_command, but neither key requires the other.\",\n+      \"description\": \"The tenant's own commit-status and issue-tracking reads. The product names no vendor: every key is a command the tenant supplies. Optional; attavo verify refuses without checks_command, and attavo file-findings refuses without file_issue_command, but neither key requires the other.\",\n       \"additionalProperties\": false,\n       \"properties\": {\n         \"checks_command\": {\n@@ -115,6 +115,11 @@\n           \"description\": \"Reads one finding as JSON on stdin and files it as a tenant issue. attavo file-findings runs it once per finding in the item's latest verify record.\",\n           \"minLength\": 1\n         },\n+        \"issues_command\": {\n+          \"type\": \"string\",\n+          \"description\": \"Takes nothing; prints the tenant's issues, open and closed, as one JSON list of {number, title, state (open or closed), closed_at, labels, body}. The product parses each body's \\\"## Claims\\\" section itself. attavo frontier runs it once per read; absent, every reader that needs issues says \\\"not read: no [forge].issues_command\\\".\",\n+          \"minLength\": 1\n+        },\n         \"attestation_command\": {\n           \"type\": \"string\",\n           \"description\": \"Reads a merge commit sha on stdin and prints that merge's attestation statement as JSON on exit 0; nothing on a non-zero exit. The doctor's fifth proof runs it once per merged, fully-staged item to require a statement in the store.\",\ndiff --git a/tests/test_issues.py b/tests/test_issues.py\nnew file mode 100644\nindex 0000000..1ab0f59\n--- /dev/null\n+++ b/tests/test_issues.py\n@@ -0,0 +1,131 @@\n+\"\"\"The tenant's issues, read through [forge].issues_command\n+(attavo/issues.py). Written red first: on 5df6926 there is no\n+attavo.issues module and no issues_command in the manifest schema.\n+\n+Run: python3 -m pytest tests/test_issues.py -q\n+\"\"\"\n+from __future__ import annotations\n+\n+import json\n+import os\n+import subprocess\n+import sys\n+import tomllib\n+from pathlib import Path\n+from typing import Any\n+\n+import jsonschema\n+import pytest\n+\n+from attavo import issues\n+\n+ROOT = Path(__file__).resolve().parent.parent\n+SCHEMA = json.loads((ROOT / \"schema\" / \"manifest.schema.json\").read_text())\n+\n+BODY = \"\"\"The Plan store and `attavo plan`.\n+\n+Class: core\n+\n+## Claims\n+\n+- attavo/store.py\n+- `attavo/plan.py`\n+-   tests/test_plan.py\n+\n+## Acceptance\n+\n+- not a claim\n+\"\"\"\n+\n+\n+def command_printing(tmp_path: Path, payload: Any, code: int = 0, err: str = \"\") -> str:\n+    script = tmp_path / \"issues-cmd.py\"\n+    script.write_text(\"import sys\\n\"\n+                      f\"sys.stdout.write({json.dumps(payload) if not isinstance(payload, str) else payload!r})\\n\"\n+                      f\"sys.stderr.write({err!r})\\n\"\n+                      f\"sys.exit({code})\\n\")\n+    return f\"{sys.executable} {script}\"\n+\n+\n+def test_claims_are_read_from_the_bodys_claims_section_and_nowhere_else() -> None:\n+    assert issues.parse_claims(BODY) == [\"attavo/store.py\", \"attavo/plan.py\", \"tests/test_plan.py\"]\n+    assert issues.parse_claims(\"no section here\\n- attavo/x.py\\n\") is None\n+    assert issues.parse_claims(\"## Claims\\n\\n## Acceptance\\n- a\\n\") == []\n+\n+\n+def test_the_command_is_read_into_issues_with_their_claims_in_number_order(tmp_path: Path) -> None:\n+    payload = [\n+        {\"number\": 264, \"title\": \"the Plan store\", \"state\": \"closed\", \"closed_at\": \"2026-09-29T20:00:00Z\",\n+         \"labels\": [\"class:core\"], \"body\": BODY},\n+        {\"number\": 231, \"title\": \"a fix\", \"state\": \"open\", \"closed_at\": None, \"labels\": [], \"body\": \"no claims\"},\n+    ]\n+    m = {\"forge\": {\"issues_command\": command_printing(tmp_path, payload)}}\n+    got, why = issues.read_issues(tmp_path, m)\n+    assert why is None and got is not None\n+    assert [i[\"number\"] for i in got] == [231, 264]\n+    assert got[0][\"claims\"] is None and got[0][\"state\"] == \"open\"\n+    assert got[1][\"claims\"] == [\"attavo/store.py\", \"attavo/plan.py\", \"tests/test_plan.py\"]\n+    assert got[1][\"labels\"] == [\"class:core\"] and got[1][\"closed_at\"] == \"2026-09-29T20:00:00Z\"\n+\n+\n+def test_no_command_is_not_read_and_never_an_empty_list(tmp_path: Path) -> None:\n+    assert issues.read_issues(tmp_path, {}) == (None, \"not read: no [forge].issues_command\")\n+    assert issues.read_issues(tmp_path, {\"forge\": {\"checks_command\": \"x\"}})[0] is None\n+\n+\n+def test_a_failing_command_or_output_of_the_wrong_shape_is_not_read_and_says_why(tmp_path: Path) -> None:\n+    failing = {\"forge\": {\"issues_command\": command_printing(tmp_path, \"\", code=3, err=\"gh: not logged in\\n\")}}\n+    got, why = issues.read_issues(tmp_path, failing)\n+    assert got is None and why == \"not read: [forge].issues_command exited 3: gh: not logged in\"\n+    for payload, needle in [\n+        (\"not json\", \"printed no JSON\"),\n+        ({\"number\": 1}, \"not a list\"),\n+        ([{\"number\": 1, \"title\": \"t\", \"state\": \"OPEN\", \"labels\": [], \"body\": \"\"}], \"state 'OPEN'\"),\n+        ([{\"title\": \"t\", \"state\": \"open\"}], \"no issue number\"),\n+        ([{\"number\": 2, \"title\": \"t\", \"state\": \"open\", \"labels\": [{\"name\": \"x\"}]}], \"labels\"),\n+    ]:\n+        (tmp_path / \"issues-cmd.py\").unlink(missing_ok=True)\n+        m = {\"forge\": {\"issues_command\": command_printing(tmp_path, payload)}}\n+        got, why = issues.read_issues(tmp_path, m)\n+        assert got is None and why is not None and needle in why, (payload, why)\n+\n+\n+def test_a_command_that_runs_past_its_bound_is_not_read(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:\n+    monkeypatch.setattr(issues, \"TIMEOUT_S\", 1)\n+    got, why = issues.read_issues(tmp_path, {\"forge\": {\"issues_command\": \"sleep 10\"}})\n+    assert got is None and why == \"not read: [forge].issues_command ran past 1s\"\n+\n+\n+def test_the_manifest_schema_takes_issues_command_and_this_repository_declares_it() -> None:\n+    manifest = tomllib.loads((ROOT / \"attavo.toml\").read_text())\n+    jsonschema.validate(manifest, SCHEMA)\n+    command = manifest[\"forge\"][\"issues_command\"]\n+    assert command == \"python3 .attavo/bin/forge-issues\"\n+    assert (ROOT / \".attavo\" / \"bin\" / \"forge-issues\").is_file()\n+    bad = {**manifest, \"forge\": {**manifest[\"forge\"], \"issues_command\": \"\"}}\n+    with pytest.raises(jsonschema.ValidationError):\n+        jsonschema.validate(bad, SCHEMA)\n+\n+\n+def test_this_repositorys_command_translates_the_forges_words_into_the_shape(tmp_path: Path) -> None:\n+    fake = tmp_path / \"bin\"\n+    fake.mkdir()\n+    gh_output = [{\"number\": 264, \"title\": \"the Plan store\", \"state\": \"CLOSED\", \"closedAt\": \"2026-09-29T20:00:00Z\",\n+                  \"labels\": [{\"name\": \"class:core\", \"color\": \"000000\"}], \"body\": BODY},\n+                 {\"number\": 263, \"title\": \"R5\", \"state\": \"OPEN\", \"closedAt\": None, \"labels\": [], \"body\": \"\"}]\n+    (fake / \"gh\").write_text(f\"#!/bin/sh\\ncat <<'JSON'\\n{json.dumps(gh_output)}\\nJSON\\n\")\n+    (fake / \"gh\").chmod(0o755)\n+    env = {**os.environ, \"PATH\": f\"{fake}{os.pathsep}{os.environ['PATH']}\"}\n+    run = subprocess.run([sys.executable, str(ROOT / \".attavo\" / \"bin\" / \"forge-issues\")],\n+                         capture_output=True, text=True, env=env, check=False)\n+    assert run.returncode == 0, run.stderr\n+    m = {\"forge\": {\"issues_command\": command_printing(tmp_path, run.stdout)}}\n+    got, why = issues.read_issues(tmp_path, m)\n+    assert why is None and got is not None\n+    assert [(i[\"number\"], i[\"state\"], i[\"labels\"]) for i in got] == [(263, \"open\", []),\n+                                                                     (264, \"closed\", [\"class:core\"])]\n+    assert got[1][\"claims\"] == [\"attavo/store.py\", \"attavo/plan.py\", \"tests/test_plan.py\"]\n+    (fake / \"gh\").write_text(\"#!/bin/sh\\necho 'gh: offline' >&2\\nexit 1\\n\")\n+    failed = subprocess.run([sys.executable, str(ROOT / \".attavo\" / \"bin\" / \"forge-issues\")],\n+                            capture_output=True, text=True, env=env, check=False)\n+    assert failed.returncode != 0 and failed.stdout == \"\"\ndiff --git a/tests/test_record_schemas.py b/tests/test_record_schemas.py\nindex cdd13fa..2f004e6 100644\n--- a/tests/test_record_schemas.py\n+++ b/tests/test_record_schemas.py\n@@ -418,7 +418,7 @@ def test_only_load_record_parses_record_file_content() -> None:\n     \"\"\"Acceptance 6: _load_record is the one place in this repository\n     that turns a <stage>-NN.json record's bytes into a dict; parse_attempts\n     and load_records both read through it rather than calling json.loads\n-    themselves. `git grep -n \"json.loads(\" bin/attavo` still finds ten\n+    themselves. `git grep -n \"json.loads(\" bin/attavo` still finds eleven\n     other sites -- a schema file, attavo test's own cache of exit-0 runs\n     under the git directory (never a record), an adapter's conformance.json (read\n     twice: once for its declared reports, once for R3's own\n@@ -429,9 +429,10 @@ def test_only_load_record_parses_record_file_content() -> None:\n     own read of the forge checks a drive pass already wrote (issue #217,\n     ATTAVO_FORGE_CHECKS), and the Plan store's two: a version\n     of a store document, and the file `attavo plan put` is given -- working\n-    material outside git, never a record.\"\"\"\n+    material outside git, never a record -- and the tenant's issues as\n+    [forge].issues_command prints them.\"\"\"\n     text = \"\\n\".join(p.read_text() for p in sorted((ROOT / \"attavo\").rglob(\"*.py\")))\n-    assert text.count(\"json.loads(\") == 11, (\n+    assert text.count(\"json.loads(\") == 12, (\n         \"a new json.loads( site was added; review it against issue #60 acceptance 6 \"\n         \"and update this count\")\n     assert \"data = json.loads(path.read_text())\" in text\n","exit_code":0,"status":"completed"}}

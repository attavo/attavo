iagnostics\\\":null,\\\"context_management\\\":null},\\\"parent_tool_use_id\\\":null,\\\"session_id\\\":\\\"8b358cc5-0655-4274-9562-475abdbf906d\\\",\\\"uuid\\\":\\\"2c1380ee-ef16-4254-99a3-855ea04e5d04\\\",\\\"timestamp\\\":\\\"2026-10-14T19:57:56.802Z\\\",\\\"request_id\\\":\\\"req_011Cg2ikANstqdQ38kNDvJvg\\\",\\\"wire_tool_inputs\\\":{\\\"toolu_01EXsMyiZsJcNTKGkmv9yNjc\\\":{\\\"file_path\\\":\\\"/Users/davidbean/Projects/attavo-worktree-353/tests/test_types_mirror_schemas.py\\\"}}}\\n+{\\\"type\\\":\\\"user\\\",\\\"message\\\":{\\\"role\\\":\\\"user\\\",\\\"content\\\":[{\\\"tool_use_id\\\":\\\"toolu_01EXsMyiZsJcNTKGkmv9yNjc\\\",\\\"type\\\":\\\"tool_result\\\",\\\"content\\\":\\\"1\\\\t\\\\\\\"\\\\\\\"\\\\\\\"Issue #189: attavo/types.py is the mirror of schema/records/*.schema.json\\\\n2\\\\tand schema/attestation.schema.json. The schema stays the contract; each\\\\n3\\\\trecord TypedDict's keys equal the schema's `properties` and its required\\\\n4\\\\tkeys equal the schema's `required`, so the type cannot drift from it.\\\\n5\\\\t\\\\n6\\\\tRun: python3 -m pytest tests -q\\\\n7\\\\t\\\\\\\"\\\\\\\"\\\\\\\"\\\\n8\\\\tfrom __future__ import annotations\\\\n9\\\\t\\\\n10\\\\timport json\\\\n11\\\\tfrom pathlib import Path\\\\n12\\\\tfrom typing import Any\\\\n13\\\\t\\\\n14\\\\timport pytest\\\\n15\\\\t\\\\n16\\\\tfrom attavo import types\\\\n17\\\\t\\\\n18\\\\tROOT = Path(__file__).resolve().parent.parent\\\\n19\\\\tSCHEMA = ROOT / \\\\\\\"schema\\\\\\\"\\\\n20\\\\t\\\\n21\\\\t# The TypedDict for each schema, by the schema's path under schema/.\\\\n22\\\\tRECORD_KINDS = {\\\\n23\\\\t    \\\\\\\"SpecRecord\\\\\\\": \\\\\\\"records/spec.schema.json\\\\\\\",\\\\n24\\\\t    \\\\\\\"ApprovalRecord\\\\\\\": \\\\\\\"records/approval.schema.json\\\\\\\",\\\\n25\\\\t    \\\\\\\"BuildRecord\\\\\\\": \\\\\\\"records/build.schema.json\\\\\\\",\\\\n26\\\\t    \\\\\\\"VerifyRecord\\\\\\\": \\\\\\\"records/verify.schema.json\\\\\\\",\\\\n27\\\\t    \\\\\\\"CounselRecord\\\\\\\": \\\\\\\"records/counsel.schema.json\\\\\\\",\\\\n28\\\\t    \\\\\\\"AttestRecord\\\\\\\": \\\\\\\"attestation.schema.json\\\\\\\",\\\\n29\\\\t    \\\\\\\"DriveReport\\\\\\\": \\\\\\\"drive-report.schema.json\\\\\\\",\\\\n30\\\\t}\\\\n31\\\\t\\\\n32\\\\t# The Stop sub-shape appears in build and verify records, each with its own\\\\n33\\\\t# class enum; the type is one shape and the schemas carry the same three keys.\\\\n34\\\\tSTOP_HOMES = (\\\\\\\"records/build.schema.json\\\\\\\", \\\\\\\"records/verify.schema.json\\\\\\\")\\\\n35\\\\t\\\\n36\\\\t\\\\n37\\\\tdef load(path: str) -> dict[str, Any]:\\\\n38\\\\t    schema: dict[str, Any] = json.loads((SCHEMA / path).read_text())\\\\n39\\\\t    return schema\\\\n40\\\\t\\\\n41\\\\t\\\\n42\\\\t@pytest.mark.parametrize(\\\\\\\"kind\\\\\\\", sorted(RECORD_KINDS))\\\\n43\\\\tdef test_the_typeddict_keys_equal_the_schemas_properties(kind: str) -> None:\\\\n44\\\\t    schema = load(RECORD_KINDS[kind])\\\\n45\\\\t    td = getattr(types, kind)\\\\n46\\\\t    assert set(td.__annotations__) == set(schema[\\\\\\\"properties\\\\\\\"])\\\\n47\\\\t\\\\n48\\\\t\\\\n49\\\\t@pytest.mark.parametrize(\\\\\\\"kind\\\\\\\", sorted(RECORD_KINDS))\\\\n50\\\\tdef test_the_typeddicts_required_keys_equal_the_schemas_required(kind: str) -> None:\\\\n51\\\\t    schema = load(RECORD_KINDS[kind])\\\\n52\\\\t    td = getattr(types, kind)\\\\n53\\\\t    assert set(td.__required_keys__) == set(schema[\\\\\\\"required\\\\\\\"])\\\\n54\\\\t    assert set(td.__optional_keys__) == set(schema[\\\\\\\"properties\\\\\\\"]) - set(schema[\\\\\\\"required\\\\\\\"])\\\\n55\\\\t\\\\n56\\\\t\\\\n57\\\\t@pytest.mark.parametrize(\\\\\\\"path\\\\\\\", STOP_HOMES)\\\\n58\\\\tdef test_the_stop_shape_mirrors_the_stop_in_each_schema_that_carries_one(path: str) -> None:\\\\n59\\\\t    stop = load(path)[\\\\\\\"properties\\\\\\\"][\\\\\\\"stop\\\\\\\"]\\\\n60\\\\t    assert set(types.Stop.__annotations__) == set(stop[\\\\\\\"properties\\\\\\\"])\\\\n61\\\\t    assert set(types.Stop.__required_keys__) == set(stop[\\\\\\\"required\\\\\\\"])\\\\n62\\\\t\\\"}]},\\\"parent_tool_use_id\\\":null,\\\"session_id\\\":\\\"8b358cc5-0655-4274-9562-475abdbf906d\\\",\\\"uuid\\\":\\\"0b683bbc-68ff-419e-8e8f-e5716ddfd241\\\",\\\"timestamp\\\":\\\"2026-10-14T19:57:56.818Z\\\",\\\"tool_use_result\\\":{\\\"type\\\":\\\"text\\\",\\\"file\\\":{\\\"filePath\\\":\\\"/Users/davidbean/Projects/attavo-worktree-353/tests/test_types_mirror_schemas.py\\\",\\\"content\\\":\\\"\\\\\\\"\\\\\\\"\\\\\\\"Issue #189: attavo/types.py is the mirror of schema/records/*.schema.json\\\\nand schema/attestation.schema.json. The schema stays the contract; each\\\\nrecord TypedDict's keys equal the schema's `properties` and its required\\\\nkeys equal the schema's `required`, so the type cannot drift from it.\\\\n\\\\nRun: python3 -m pytest tests -q\\\\n\\\\\\\"\\\\\\\"\\\\\\\"\\\\nfrom __future__ import annotations\\\\n\\\\nimport json\\\\nfrom pathlib import Path\\\\nfrom typing import Any\\\\n\\\\nimport pytest\\\\n\\\\nfrom attavo import types\\\\n\\\\nROOT = Path(__file__).resolve().parent.parent\\\\nSCHEMA = ROOT / \\\\\\\"schema\\\\\\\"\\\\n\\\\n# The TypedDict for each schema, by the schema's path under schema/.\\\\nRECORD_KINDS = {\\\\n    \\\\\\\"SpecRecord\\\\\\\": \\\\\\\"records/spec.schema.json\\\\\\\",\\\\n    \\\\\\\"ApprovalRecord\\\\\\\": \\\\\\\"records/approval.schema.json\\\\\\\",\\\\n    \\\\\\\"BuildRecord\\\\\\\": \\\\\\\"records/build.schema.json\\\\\\\",\\\\n    \\\\\\\"VerifyRecord\\\\\\\": \\\\\\\"records/verify.schema.json\\\\\\\",\\\\n    \\\\\\\"CounselRecord\\\\\\\": \\\\\\\"records/counsel.schema.json\\\\\\\",\\\\n    \\\\\\\"AttestRecord\\\\\\\": \\\\\\\"attestation.schema.json\\\\\\\",\\\\n    \\\\\\\"DriveReport\\\\\\\": \\\\\\\"drive-report.schema.json\\\\\\\",\\\\n}\\\\n\\\\n# The Stop sub-shape appears in build and verify records, each with its own\\\\n# class enum; the type is one shape and the schemas carry the same three keys.\\\\nSTOP_HOMES = (\\\\\\\"records/build.schema.json\\\\\\\", \\\\\\\"records/verify.schema.json\\\\\\\")\\\\n\\\\n\\\\ndef load(path: str) -> dict[str, Any]:\\\\n    schema: dict[str, Any] = json.loads((SCHEMA / path).read_text())\\\\n    return schema\\\\n\\\\n\\\\n@pytest.mark.parametrize(\\\\\\\"kind\\\\\\\", sorted(RECORD_KINDS))\\\\ndef test_the_typeddict_keys_equal_the_schemas_properties(kind: str) -> None:\\\\n    schema = load(RECORD_KINDS[kind])\\\\n    td = getattr(types, kind)\\\\n    assert set(td.__annotations__) == set(schema[\\\\\\\"properties\\\\\\\"])\\\\n\\\\n\\\\n@pytest.mark.parametrize(\\\\\\\"kind\\\\\\\", sorted(RECORD_KINDS))\\\\ndef test_the_typeddicts_required_keys_equal_the_schemas_required(kind: str) -> None:\\\\n    schema = load(RECORD_KINDS[kind])\\\\n    td = getattr(types, kind)\\\\n    assert set(td.__required_keys__) == set(schema[\\\\\\\"required\\\\\\\"])\\\\n    assert set(td.__optional_keys__) == set(schema[\\\\\\\"properties\\\\\\\"]) - set(schema[\\\\\\\"required\\\\\\\"])\\\\n\\\\n\\\\n@pytest.mark.parametrize(\\\\\\\"path\\\\\\\", STOP_HOMES)\\\\ndef test_the_stop_shape_mirrors_the_stop_in_each_schema_that_carries_one(path: str) -> None:\\\\n    stop = load(path)[\\\\\\\"properties\\\\\\\"][\\\\\\\"stop\\\\\\\"]\\\\n    assert set(types.Stop.__annotations__) == set(stop[\\\\\\\"properties\\\\\\\"])\\\\n    assert set(types.Stop.__required_keys__) == set(stop[\\\\\\\"required\\\\\\\"])\\\\n\\\",\\\"numLines\\\":62,\\\"startLine\\\":1,\\\"totalLines\\\":62}},\\\"tool_result_meta\\\":[{\\\"id\\\":\\\"toolu_01EXsMyiZsJcNTKGkmv9yNjc\\\",\\\"permission_decision\\\":{\\\"decision\\\":\\\"accept\\\",\\\"source\\\":\\\"config\\\",\\\"reason_type\\\":\\\"rule\\\"}}]}\\n+{\\\"type\\\":\\\"assistant\\\",\\\"message\\\":{\\\"model\\\":\\\"claude-sonnet-5\\\",\\\"id\\\":\\\"msg_011Cg2ikPzBFhCCS6fTeGxFL\\\",\\\"type\\\":\\\"message\\\",\\\"role\\\":\\\"assistant\\\",\\\"content\\\":[{\\\"type\\\":\\\"text\\\",\\\"text\\\":\\\"This test only checks top-level keys equality, not nested enums. So changing the schema's `class` enum for interventions doesn't require changes to types.py's keys (it's `list[dict[str, str]]` already). Let's verify that, and also check `test_doctor.py` and `test_attest_interventions.py` and `ledger.py::item_acts_and_interventions` for classes used.\\\"}],\\\"container\\\":null,\\\"stop_reason\\\":null,\\\"stop_sequence\\\":null,\\\"stop_details\\\":null,\\\"usage\\\":{\\\"input_tokens\\\":2,\\\"cache_creation_input_tokens\\\":1317,\\\"cache_read_input_tokens\\\":59109,\\\"cache_creation\\\":{\\\"ephemeral_5m_input_tokens\\\":0,\\\"ephemeral_1h_input_tokens\\\":1317},\\\"output_tokens\\\":1,\\\"service_tier\\\":\\\"standard\\\",\\\"inference_geo\\\":\\\"global\\\"},\\\"input_transformations\\\":[],\\\"diagnostics\\\":null,\\\"context_management\\\":null},\\\"parent_tool_use_id\\\":null,\\\"session_id\\\":\\\"8b358cc5-0655-4274-9562-475abdbf906d\\\",\\\"uuid\\\":\\\"9c03cbb3-18bc-47a1-a008-7a88680959dd\\\",\\\"timestamp\\\":\\\"2026-10-14T19:57:59.515Z\\\",\\\"request_id\\\":\\\"req_011Cg2ikPhp1W7fwKewdWwA6\\\"}\\n+{\\\"type\\\":\\\"assistant\\\",\\\"message\\\":{\\\"model\\\":\\\"claude-sonnet-5\\\",\\\"id\\\":\\\"msg_011Cg2ikPzBFhCCS6fTeGxFL\\\",\\\"type\\\":\\\"message\\\",\\\"role\\\":\\\"assistant\\\",\\\"content\\\":[{\\\"type\\\":\\\"tool_use\\\",\\\"id\\\":\\\"toolu_01MPRu7r8PAZoDewr9UzaJzt\\\",\\\"name\\\":\\\"Bash\\\",\\\"input\\\":{\\\"command\\\":\\\"sed -n '250,340p' attavo/ledger.py\\\"},\\\"caller\\\":{\\\"type\\\":\\\"direct\\\"}}],\\\"container\\\":null,\\\"stop_reason\\\":null,\\\"stop_sequence\\\":null,\\\"stop_details\\\":null,\\\"usage\\\":{\\\"input_tokens\\\":2,\\\"cache_creation_input_tokens\\\":1317,\\\"cache_read_input_tokens\\\":59109,\\\"cache_creation\\\":{\\\"ephemeral_5m_input_tokens\\\":0,\\\"ephemeral_1h_input_tokens\\\":1317},\\\"output_tokens\\\":1,\\\"service_tier\\\":\\\"standard\\\",\\\"inference_geo\\\":\\\"global\\\"},\\\"input_transformations\\\":[],\\\"diagnostics\\\":null,\\\"context_management\\\":null},\\\"parent_tool_use_id\\\":null,\\\"session_id\\\":\\\"8b358cc5-0655-4274-9562-475abdbf906d\\\",\\\"uuid\\\":\\\"cbef04f5-1ac8-4dfa-a468-e37127068e56\\\",\\\"timestamp\\\":\\\"2026-10-14T19:58:00.518Z\\\",\\\"request_id\\\":\\\"req_011Cg2ikPhp1W7fwKewdWwA6\\\",\\\"wire_tool_inputs\\\":{\\\"toolu_01MPRu7r8PAZoDewr9UzaJzt\\\":{\\\"command\\\":\\\"cd /Users/davidbean/Projects/attavo-worktree-353 && sed -n '250,340p' attavo/ledger.py\\\"}},\\\"wire_ingest_context\\\":{\\\"toolu_01MPRu7r8PAZoDewr9UzaJzt\\\":{\\\"cwd\\\":\\\"/Users/davidbean/Projects/attavo-worktree-353\\\"}}}\\n+{\\\"type\\\":\\\"user\\\",\\\"message\\\":{\\\"role\\\":\\\"user\\\",\\\"content\\\":[{\\\"tool_use_id\\\":\\\"toolu_01MPRu7r8PAZoDewr9UzaJzt\\\",\\\"type\\\":\\\"tool_result\\\",\\\"content\\\":\\\"            cls = \\\\\\\"amend\\\\\\\" if approval_seen else \\\\\\\"spec\\\\\\\"\\\\n            rows.append({\\\\\\\"sha\\\\\\\": sha, \\\\\\\"identity\\\\\\\": name, \\\\\\\"class\\\\\\\": cls})\\\\n            if cls == \\\\\\\"amend\\\\\\\":\\\\n                operator_acts += 1\\\\n            continue\\\\n\\\\n        rows.append({\\\\\\\"sha\\\\\\\": sha, \\\\\\\"identity\\\\\\\": name, \\\\\\\"class\\\\\\\": \\\\\\\"transport\\\\\\\"})\\\\n        operator_acts += 1\\\\n\\\\n    # issue #137: the same set attavo stops counts, from the same reader\\\\n    # (item_stops) -- not a second, independent count kept in sync by\\\\n    # hand. One non-pass record per row, whatever its stage; a gate\\\\n    # refusal is included the same as a non-pass build or verify record.\\\\n    stops = len(item_stops(root, m, item_id)[\\\\\\\"rows\\\\\\\"])\\\\n\\\\n    summary = {\\\\\\\"operator_acts\\\\\\\": operator_acts, \\\\\\\"product_acts\\\\\\\": product_acts,\\\\n              \\\\\\\"executor_commits\\\\\\\": executor_commits, \\\\\\\"stops\\\\\\\": stops, \\\\\\\"since\\\\\\\": since}\\\\n    return {\\\\\\\"item\\\\\\\": item_id, \\\\\\\"rows\\\\\\\": rows, \\\\\\\"summary\\\\\\\": summary}\\\\n\\\\n\\\\n# The statement's own two lists (issue #349): acts is the operator's ruled\\\\n# acts (approve, merge); rule stays in the schema's enum for the ruling\\\\n# record (#276) and is never produced here. interventions is every other\\\\n# operator row -- amend, launch, transport.\\\\nACT_CLASSES = (\\\\\\\"approve\\\\\\\", \\\\\\\"merge\\\\\\\")\\\\nINTERVENTION_CLASSES = (\\\\\\\"amend\\\\\\\", \\\\\\\"launch\\\\\\\", \\\\\\\"transport\\\\\\\")\\\\n\\\\n\\\\ndef _committer_time_iso(root: Path, shas: list[str]) -> dict[str, str]:\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"Each sha's own committer time, in the same shape attest's own `at`\\\\n    fields already carry -- one `git show` process for every sha an\\\\n    item's acts and interventions need, not one git call per row.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n    if not shas:\\\\n        return {}\\\\n    out = git(root, \\\\\\\"show\\\\\\\", \\\\\\\"-s\\\\\\\", \\\\\\\"--format=%H\\\\\\\\x1f%ct\\\\\\\", *shas)\\\\n    times: dict[str, str] = {}\\\\n    for line in out.splitlines():\\\\n        if not line.strip():\\\\n            continue\\\\n        sha, epoch = line.split(\\\\\\\"\\\\\\\\x1f\\\\\\\")\\\\n        times[sha] = datetime.fromtimestamp(int(epoch), timezone.utc).strftime(\\\\\\\"%Y-%m-%dT%H:%M:%SZ\\\\\\\")\\\\n    return times\\\\n\\\\n\\\\ndef item_acts_and_interventions(root: Path, m: dict[str, Any], item_id: str,\\\\n                                merges: list[dict[str, Any]] | None = None\\\\n                                ) -> tuple[list[dict[str, Any]], list[dict[str, Any]]]:\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"(acts, interventions): the statement's own two lists, read from\\\\n    item_ledger's own rows between the item's first spec commit and its\\\\n    merge -- each commit classed exactly once there, never classified\\\\n    twice. acts carries every approve and merge row as {act, sha, by, at};\\\\n    interventions carries every amend, launch, and transport row as\\\\n    {class, sha, by, at}. `by` is the commit's own author name\\\\n    (item_ledger's `identity`); `at` is its committer time.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n    rows = item_ledger(root, m, item_id, merges=merges)[\\\\\\\"rows\\\\\\\"]\\\\n    act_rows = [r for r in rows if r[\\\\\\\"class\\\\\\\"] in ACT_CLASSES]\\\\n    intervention_rows = [r for r in rows if r[\\\\\\\"class\\\\\\\"] in INTERVENTION_CLASSES]\\\\n    times = _committer_time_iso(root, [r[\\\\\\\"sha\\\\\\\"] for r in act_rows + intervention_rows])\\\\n    acts = [{\\\\\\\"act\\\\\\\": r[\\\\\\\"class\\\\\\\"], \\\\\\\"sha\\\\\\\": r[\\\\\\\"sha\\\\\\\"], \\\\\\\"by\\\\\\\": r[\\\\\\\"identity\\\\\\\"], \\\\\\\"at\\\\\\\": times[r[\\\\\\\"sha\\\\\\\"]]}\\\\n           for r in act_rows]\\\\n    interventions = [{\\\\\\\"class\\\\\\\": r[\\\\\\\"class\\\\\\\"], \\\\\\\"sha\\\\\\\": r[\\\\\\\"sha\\\\\\\"], \\\\\\\"by\\\\\\\": r[\\\\\\\"identity\\\\\\\"], \\\\\\\"at\\\\\\\": times[r[\\\\\\\"sha\\\\\\\"]]}\\\\n                     for r in intervention_rows]\\\\n    return acts, interventions\\\\n\\\\n\\\\ndef cmd_ledger(argv: list[str]) -> int:\\\\n    as_json = \\\\\\\"--json\\\\\\\" in argv\\\\n    positional = [a for a in argv if a != \\\\\\\"--json\\\\\\\"]\\\\n    root = Path(\\\\\\\".\\\\\\\").resolve()\\\\n    m = read_manifest(root)\\\\n    if m is None:\\\\n        print(f\\\\\\\"attavo ledger: no {MANIFEST} at {root}\\\\\\\", file=sys.stderr)\\\\n        return 2\\\\n\\\\n    records_rel = m[\\\\\\\"paths\\\\\\\"][\\\\\\\"records\\\\\\\"]\\\\n    if positional:\\\\n        item_ids = [positional[0]]\\\\n    else:\\\\n        records_root = root / records_rel\\\\n        item_ids = (sorted((p.name for p in records_root.iterdir() if p.is_dir()))\\\\n                   if records_root.is_dir() else [])\\\\n\\\\n    # Computed once for every item in this read, not once per item (issue\\\\n    # #153): the default branch's merges do not depend on which item is\\\\n    # being ask
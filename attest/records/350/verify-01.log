\\\\\\"sha\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"string\\\\\\\", \\\\\\\"minLength\\\\\\\": 1},\\\\n    \\\\\\\"merge_sha\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"string\\\\\\\", \\\\\\\"minLength\\\\\\\": 1},\\\\n    \\\\\\\"item\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"string\\\\\\\", \\\\\\\"minLength\\\\\\\": 1},\\\\n    \\\\\\\"spec\\\\\\\": {\\\\\\\"type\\\\\\\": [\\\\\\\"string\\\\\\\", \\\\\\\"null\\\\\\\"]},\\\\n    \\\\\\\"spec_sha\\\\\\\": {\\\\\\\"type\\\\\\\": [\\\\\\\"string\\\\\\\", \\\\\\\"null\\\\\\\"]},\\\\n    \\\\\\\"approval\\\\\\\": {\\\\\\\"type\\\\\\\": [\\\\\\\"string\\\\\\\", \\\\\\\"null\\\\\\\"]},\\\\n    \\\\\\\"approval_sha\\\\\\\": {\\\\\\\"type\\\\\\\": [\\\\\\\"string\\\\\\\", \\\\\\\"null\\\\\\\"]},\\\\n    \\\\\\\"build\\\\\\\": {\\\\\\\"type\\\\\\\": [\\\\\\\"string\\\\\\\", \\\\\\\"null\\\\\\\"]},\\\\n    \\\\\\\"build_sha\\\\\\\": {\\\\\\\"type\\\\\\\": [\\\\\\\"string\\\\\\\", \\\\\\\"null\\\\\\\"]},\\\\n    \\\\\\\"verify\\\\\\\": {\\\\\\\"type\\\\\\\": [\\\\\\\"string\\\\\\\", \\\\\\\"null\\\\\\\"]},\\\\n    \\\\\\\"verify_sha\\\\\\\": {\\\\\\\"type\\\\\\\": [\\\\\\\"string\\\\\\\", \\\\\\\"null\\\\\\\"]},\\\\n    \\\\\\\"at\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"string\\\\\\\", \\\\\\\"minLength\\\\\\\": 1},\\\\n    \\\\\\\"interventions\\\\\\\": {\\\\n      \\\\\\\"type\\\\\\\": \\\\\\\"array\\\\\\\",\\\\n      \\\\\\\"description\\\\\\\": \\\\\\\"Every operator row on the item other than approve and merge -- amend, launch, transport -- read from attavo/ledger.py::item_ledger's own rows between the item's first spec commit and its merge (issue #349): the row's class, its sha, the commit's own author name, and its committer time.\\\\\\\",\\\\n      \\\\\\\"items\\\\\\\": {\\\\n        \\\\\\\"type\\\\\\\": \\\\\\\"object\\\\\\\",\\\\n        \\\\\\\"additionalProperties\\\\\\\": false,\\\\n        \\\\\\\"required\\\\\\\": [\\\\\\\"at\\\\\\\", \\\\\\\"class\\\\\\\", \\\\\\\"by\\\\\\\", \\\\\\\"sha\\\\\\\"],\\\\n        \\\\\\\"properties\\\\\\\": {\\\\n          \\\\\\\"at\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"string\\\\\\\", \\\\\\\"minLength\\\\\\\": 1},\\\\n          \\\\\\\"class\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"string\\\\\\\", \\\\\\\"minLength\\\\\\\": 1},\\\\n          \\\\\\\"by\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"string\\\\\\\", \\\\\\\"minLength\\\\\\\": 1},\\\\n          \\\\\\\"sha\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"string\\\\\\\", \\\\\\\"minLength\\\\\\\": 1}\\\\n        }\\\\n      }\\\\n    },\\\\n    \\\\\\\"acts\\\\\\\": {\\\\n      \\\\\\\"type\\\\\\\": \\\\\\\"array\\\\\\\",\\\\n      \\\\\\\"description\\\\\\\": \\\\\\\"The operator's ruled acts on the item: each approve row and the merge row, read the same way (issue #349). rule stays in this enum for the ruling record (#276) and is never produced here.\\\\\\\",\\\\n      \\\\\\\"items\\\\\\\": {\\\\n        \\\\\\\"type\\\\\\\": \\\\\\\"object\\\\\\\",\\\\n        \\\\\\\"additionalProperties\\\\\\\": false,\\\\n        \\\\\\\"required\\\\\\\": [\\\\\\\"at\\\\\\\", \\\\\\\"act\\\\\\\", \\\\\\\"by\\\\\\\", \\\\\\\"sha\\\\\\\"],\\\\n        \\\\\\\"properties\\\\\\\": {\\\\n          \\\\\\\"at\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"string\\\\\\\", \\\\\\\"minLength\\\\\\\": 1},\\\\n          \\\\\\\"act\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"string\\\\\\\", \\\\\\\"enum\\\\\\\": [\\\\\\\"approve\\\\\\\", \\\\\\\"rule\\\\\\\", \\\\\\\"merge\\\\\\\"]},\\\\n          \\\\\\\"by\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"string\\\\\\\", \\\\\\\"minLength\\\\\\\": 1},\\\\n          \\\\\\\"sha\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"string\\\\\\\", \\\\\\\"minLength\\\\\\\": 1}\\\\n        }\\\\n      }\\\\n    },\\\\n    \\\\\\\"time\\\\\\\": {\\\\n      \\\\\\\"type\\\\\\\": \\\\\\\"object\\\\\\\",\\\\n      \\\\\\\"description\\\\\\\": \\\\\\\"Every invocation of the item, summed by attest from its stage records' wall_clock_s: per stage and for the item, every attempt and not the final one alone. lead_s runs from the first approval record's `at` to the committer time of the commit the statement is computed at; waiting_s is lead_s minus invocation_s. A record with no wall_clock_s is named in not_read and its sums are partial, never smaller in silence.\\\\\\\",\\\\n      \\\\\\\"additionalProperties\\\\\\\": false,\\\\n      \\\\\\\"required\\\\\\\": [\\\\\\\"build\\\\\\\", \\\\\\\"verify\\\\\\\", \\\\\\\"counsel\\\\\\\", \\\\\\\"invocation_s\\\\\\\", \\\\\\\"lead_s\\\\\\\", \\\\\\\"waiting_s\\\\\\\", \\\\\\\"partial\\\\\\\", \\\\\\\"not_read\\\\\\\"],\\\\n      \\\\\\\"properties\\\\\\\": {\\\\n        \\\\\\\"build\\\\\\\": {\\\\\\\"$ref\\\\\\\": \\\\\\\"#/$defs/stage_time\\\\\\\"},\\\\n        \\\\\\\"verify\\\\\\\": {\\\\\\\"$ref\\\\\\\": \\\\\\\"#/$defs/stage_time\\\\\\\"},\\\\n        \\\\\\\"counsel\\\\\\\": {\\\\\\\"$ref\\\\\\\": \\\\\\\"#/$defs/stage_time\\\\\\\"},\\\\n        \\\\\\\"invocation_s\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"number\\\\\\\", \\\\\\\"minimum\\\\\\\": 0},\\\\n        \\\\\\\"lead_s\\\\\\\": {\\\\\\\"type\\\\\\\": [\\\\\\\"number\\\\\\\", \\\\\\\"null\\\\\\\"]},\\\\n        \\\\\\\"waiting_s\\\\\\\": {\\\\\\\"type\\\\\\\": [\\\\\\\"number\\\\\\\", \\\\\\\"null\\\\\\\"]},\\\\n        \\\\\\\"partial\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"boolean\\\\\\\"},\\\\n        \\\\\\\"not_read\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"array\\\\\\\", \\\\\\\"items\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"string\\\\\\\", \\\\\\\"minLength\\\\\\\": 1}}\\\\n      }\\\\n    },\\\\n    \\\\\\\"cost\\\\\\\": {\\\\n      \\\\\\\"type\\\\\\\": \\\\\\\"object\\\\\\\",\\\\n      \\\\\\\"description\\\\\\\": \\\\\\\"Every record's cost summed by attest: the item's total across stages and executors (ruled 2026-09-19), with a subtotal per stage and per adapter. A record's cost_usd is taken as the adapter reported it; a record that reported none, with numeric tokens and a model the tenant's manifest has a [cost.rates] entry for, is priced as tokens times that rate (ruled 2026-10-05: computed here, never written into a record). usd is reported_usd plus estimated_usd. A record neither reported nor priceable is named in not_read, naming the missing rate, and makes usd and the subtotals it belongs to partial: absent is never zero, and a partial total says so.\\\\\\\",\\\\n      \\\\\\\"additionalProperties\\\\\\\": false,\\\\n      \\\\\\\"required\\\\\\\": [\\\\\\\"usd\\\\\\\", \\\\\\\"reported_usd\\\\\\\", \\\\\\\"estimated_usd\\\\\\\", \\\\\\\"by_stage_usd\\\\\\\", \\\\\\\"basis_by_stage\\\\\\\", \\\\\\\"by_adapter_usd\\\\\\\", \\\\\\\"rates\\\\\\\", \\\\\\\"estimate_note\\\\\\\", \\\\\\\"partial\\\\\\\", \\\\\\\"not_read\\\\\\\"],\\\\n      \\\\\\\"properties\\\\\\\": {\\\\n        \\\\\\\"usd\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"number\\\\\\\", \\\\\\\"minimum\\\\\\\": 0},\\\\n        \\\\\\\"reported_usd\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"number\\\\\\\", \\\\\\\"minimum\\\\\\\": 0},\\\\n        \\\\\\\"estimated_usd\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"number\\\\\\\", \\\\\\\"minimum\\\\\\\": 0},\\\\n        \\\\\\\"by_stage_usd\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"object\\\\\\\", \\\\\\\"additionalProperties\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"number\\\\\\\", \\\\\\\"minimum\\\\\\\": 0}},\\\\n        \\\\\\\"basis_by_stage\\\\\\\": {\\\\n          \\\\\\\"type\\\\\\\": \\\\\\\"object\\\\\\\",\\\\n          \\\\\\\"description\\\\\\\": \\\\\\\"For each stage with an amount: reported (every amount the adapter's), estimated (every amount priced here) or mixed.\\\\\\\",\\\\n          \\\\\\\"additionalProperties\\\\\\\": {\\\\\\\"enum\\\\\\\": [\\\\\\\"reported\\\\\\\", \\\\\\\"estimated\\\\\\\", \\\\\\\"mixed\\\\\\\"]}\\\\n        },\\\\n        \\\\\\\"by_adapter_usd\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"object\\\\\\\", \\\\\\\"additionalProperties\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"number\\\\\\\", \\\\\\\"minimum\\\\\\\": 0}},\\\\n        \\\\\\\"rates\\\\\\\": {\\\\n          \\\\\\\"type\\\\\\\": \\\\\\\"object\\\\\\\",\\\\n          \\\\\\\"description\\\\\\\": \\\\\\\"The tenant's rates this statement priced a record by, per model, as the manifest carried them: empty when nothing was priced.\\\\\\\",\\\\n          \\\\\\\"additionalProperties\\\\\\\": {\\\\n            \\\\\\\"type\\\\\\\": \\\\\\\"object\\\\\\\",\\\\n            \\\\\\\"additionalProperties\\\\\\\": false,\\\\n            \\\\\\\"required\\\\\\\": [\\\\\\\"input_usd_per_mtok\\\\\\\", \\\\\\\"output_usd_per_mtok\\\\\\\", \\\\\\\"as_of\\\\\\\", \\\\\\\"source\\\\\\\"],\\\\n            \\\\\\\"properties\\\\\\\": {\\\\n              \\\\\\\"input_usd_per_mtok\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"number\\\\\\\", \\\\\\\"minimum\\\\\\\": 0},\\\\n              \\\\\\\"output_usd_per_mtok\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"number\\\\\\\", \\\\\\\"minimum\\\\\\\": 0},\\\\n              \\\\\\\"as_of\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"string\\\\\\\", \\\\\\\"minLength\\\\\\\": 1},\\\\n              \\\\\\\"source\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"string\\\\\\\", \\\\\\\"minLength\\\\\\\": 1}\\\\n            }\\\\n          }\\\\n        },\\\\n        \\\\\\\"estimate_note\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"string\\\\\\\", \\\\\\\"const\\\\\\\": \\\\\\\"Estimated amounts are tokens times the tenant's published rates: a meter at API prices, not a bill.\\\\\\\"},\\\\n        \\\\\\\"partial\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"boolean\\\\\\\"},\\\\n        \\\\\\\"not_read\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"array\\\\\\\", \\\\\\\"items\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"string\\\\\\\", \\\\\\\"minLength\\\\\\\": 1}}\\\\n      }\\\\n    },\\\\n    \\\\\\\"tokens\\\\\\\": {\\\\n      \\\\\\\"type\\\\\\\": \\\\\\\"object\\\\\\\",\\\\n      \\\\\\\"description\\\\\\\": \\\\\\\"Every record's tokens summed by attest: per stage and for the item, input and output over every attempt and not the final one alone. With `time` and `cost`, the statement's only accounting. A record with no tokens is named in not_read and makes the sums it belongs to partial: absent is never zero.\\\\\\\",\\\\n      \\\\\\\"additionalProperties\\\\\\\": false,\\\\n      \\\\\\\"required\\\\\\\": [\\\\\\\"build\\\\\\\", \\\\\\\"verify\\\\\\\", \\\\\\\"counsel\\\\\\\", \\\\\\\"input\\\\\\\", \\\\\\\"output\\\\\\\", \\\\\\\"partial\\\\\\\", \\\\\\\"not_read\\\\\\\"],\\\\n      \\\\\\\"properties\\\\\\\": {\\\\n        \\\\\\\"build\\\\\\\": {\\\\\\\"$ref\\\\\\\": \\\\\\\"#/$defs/stage_tokens\\\\\\\"},\\\\n        \\\\\\\"verify\\\\\\\": {\\\\\\\"$ref\\\\\\\": \\\\\\\"#/$defs/stage_tokens\\\\\\\"},\\\\n        \\\\\\\"counsel\\\\\\\": {\\\\\\\"$ref\\\\\\\": \\\\\\\"#/$defs/stage_tokens\\\\\\\"},\\\\n        \\\\\\\"input\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"integer\\\\\\\", \\\\\\\"minimum\\\\\\\": 0},\\\\n        \\\\\\\"output\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"integer\\\\\\\", \\\\\\\"minimum\\\\\\\": 0},\\\\n        \\\\\\\"partial\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"boolean\\\\\\\"},\\\\n        \\\\\\\"not_read\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"array\\\\\\\", \\\\\\\"items\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"string\\\\\\\", \\\\\\\"minLength\\\\\\\": 1}}\\\\n      }\\\\n    },\\\\n    \\\\\\\"product_version\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"string\\\\\\\", \\\\\\\"minLength\\\\\\\": 1},\\\\n    \\\\\\\"product_pin\\\\\\\": {\\\\\\\"type\\\\\\\": [\\\\\\\"string\\\\\\\", \\\\\\\"null\\\\\\\"]}\\\\n  },\\\\n  \\\\\\\"$defs\\\\\\\": {\\\\n    \\\\\\\"stage_tokens\\\\\\\": {\\\\n      \\\\\\\"type\\\\\\\": \\\\\\\"object\\\\\\\",\\\\n      \\\\\\\"additionalProperties\\\\\\\": false,\\\\n      \\\\\\\"required\\\\\\\": [\\\\\\\"input\\\\\\\", \\\\\\\"output\\\\\\\", \\\\\\\"partial\\\\\\\"],\\\\n      \\\\\\\"properties\\\\\\\": {\\\\n        \\\\\\\"input\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"integer\\\\\\\", \\\\\\\"minimum\\\\\\\": 0},\\\\n        \\\\\\\"output\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"integer\\\\\\\", \\\\\\\"minimum\\\\\\\": 0},\\\\n        \\\\\\\"partial\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"boolean\\\\\\\"}\\\\n      }\\\\n    },\\\\n    \\\\\\\"stage_time\\\\\\\": {\\\\n      \\\\\\\"type\\\\\\\": \\\\\\\"object\\\\\\\",\\\\n      \\\\\\\"additionalProperties\\\\\\\": false,\\\\n      \\\\\\\"required\\\\\\\": [\\\\\\\"attempts\\\\\\\", \\\\\\\"invocation_s\\\\\\\", \\\\\\\"partial\\\\\\\"],\\\\n      \\\\\\\"properties\\\\\\\": {\\\\n        \\\\\\\"attempts\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"integer\\\\\\\", \\\\\\\"minimum\\\\\\\": 0},\\\\n        \\\\\\\"invocation_s\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"number\\\\\\\", \\\\\\\"minimum\\\\\\\": 0},\\\\n        \\\\\\\"partial\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"boolean\\\\\\\"}\\\\n      }\\\\n    }\\\\n  }\\\\n}\\\",\\\"is_error\\\":false}]},\\\"parent_tool_use_id\\\":null,\\\"session_id\\\":\\\"8b358cc5-0655-4274-9562-475abdbf906d\\\",\\\"uuid\\\":\\\"dd5d0ae3-2c8d-4248-80cd-c87b80c81a8f\\\",\\\"timestamp\\\":\\\"2026-10-14T19:57:49.982Z\\\",\\\"tool_use_result\\\":{\\\"stdout\\\":\\\"{\\\\n  \\\\\\\"$schema\\\\\\\": \\\\\\\"https://json-schema.org/draft/2020-12/schema\\\\\\\",\\\\n  \\\\\\\"$id\\\\\\\": \\\\\\\"https://attavo.dev/attestation/v6\\\\\\\",\\\\n  \\\\\\\"title\\\\\\\": \\\\\\\"The attestation statement `attavo attest` prints on a coherent chain (v6: `interventions` and `acts` are read from the item's own commits between its first spec commit and its merge, each one classed exactly once by attavo/ledger.py::item_ledger -- sha is now required in both; v5: `cost` also prices, from the tenant's published rates, a record whose adapter reported none, and says so; v4: `time`, `cost` and `tokens` are the only accounting, summed over every attempt; v3 statements sealed earlier also carry cost_by_stage_usd, wall_clock_by_stage_s and tokens_by_stage, the final attempt of each stage)\\\\\\\",\\\\n  \\\\\\\"type\\\\\\\": \\\\\\\"object\\\\\\\",\\\\n  \\\\\\\"additionalProperties\\\\\\\": false,\\\\n  \\\\\\\"required\\\\\\\": [\\\\n    \\\\\\\"sha\\\\\\\", \\\\\\\"merge_sha\\\\\\\", \\\\\\\"item\\\\\\\", \\\\\\\"spec\\\\\\\", \\\\\\\"spec_sha\\\\\\\", \\\\\\\"approval\\\\\\\", \\\\\\\"approval_sha\\\\\\\",\\\\n    \\\\\\\"build\\\\\\\", \\\\\\\"build_sha\\\\\\\", \\\\\\\"verify\\\\\\\", \\\\\\\"verify_sha\\\\\\\", \\\\\\\"at\\\\\\\", \\\\\\\"interventions\\\\\\\", \\\\\\\"acts\\\\\\\",\\\\n    \\\\\\\"time\\\\\\\", \\\\\\\"cost\\\\\\\", \\\\\\\"tokens\\\\\\\",\\\\n    \\\\\\\"product_version\\\\\\\", \\\\\\\"product_pin\\\\\\\"\\\\n  ],\\\\n  \\\\\\\"properties\\\\\\\": {\\\\n    \\\\\\\"sha\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"string\\\\\\\", \\\\\\\"minLength\\\\\\\": 1},\\\\n    \\\\\\\"merge_sha\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"string\\\\\\\", \\\\\\\"minLength\\\\\\\": 1},\\\\n    \\\\\\\"item\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"string\\\\\\\", \\\\\\\"minLength\\\\\\\": 1},\\\\n    \\\\\\\"spec\\\\\\\": {\\\\\\\"type\\\\\\\": [\\\\\\\"string\\\\\\\", \\\\\\\"null\\\\\\\"]},\\\\n    \\\\\\\"spec_sha\\\\\\\": {\\\\\\\"type\\\\\\\": [\\\\\\\"string\\\\\\\", \\\\\\\"null\\\\\\\"]},\\\\n    \\\\\\\"approval\\\\\\\": {\\\\\\\"type\\\\\\\": [\\\\\\\"string\\\\\\\", \\\\\\\"null\\\\\\\"]},\\\\n    \\\\\\\"approval_sha\\\\\\\": {\\\\\\\"type\\\\\\\": [\\\\\\\"string\\\\\\\", \\\\\\\"null\\\\\\\"]},\\\\n    \\\\\\\"build\\\\\\\": {\\\\\\\"type\\\\\\\": [\\\\\\\"string\\\\\\\", \\\\\\\"null\\\\\\\"]},\\\\n    \\\\\\\"build_sha\\\\\\\": {\\\\\\\"type\\\\\\\": [\\\\\\\"string\\\\\\\", \\\\\\\"null\\\\\\\"]},\\\\n    \\\\\\\"verify\\\\\\\": {\\\\\\\"type\\\\\\\": [\\\\\\\"string\\\\\\\", \\\\\\\"null\\\\\\\"]},\\\\n    \\\\\\\"verify_sha\\\\\\\": {\\\\\\\"type\\\\\\\": [\\\\\\\"string\\\\\\\", \\\\\\\"null\\\\\\\"]},\\\\n    \\\\\\\"at\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"string\\\\\\\", \\\\\\\"minLength\\\\\\\": 1},\\\\n    \\\\\\\"interventions\\\\\\\": {\\\\n      \\\\\\\"type\\\\\\\": \\\\\\\"array\\\\\\\",\\\\n      \\\\\\\"description\\\\\\\": \\\\\\\"Every operator row on the item other than approve and merge -- amend, launch, transport -- read from attavo/ledger.py::item_ledger's own rows between the item's first spec commit and its merge (issue #349): the row's class, its sha, the commit's own author name, and its committer time.\\\\\\\",\\\\n      \\\\\\\"items\\\\\\\": {\\\\n        \\\\\\\"type\\\\\\\": \\\\\\\"object\\\\\\\",\\\\n        \\\\\\\"additionalProperties\\\\\\\": false,\\\\n        \\\\\\\"required\\\\\\\": [\\\\\\\"at\\\\\\\", \\\\\\\"class\\\\\\\", \\\\\\\"by\\\\\\\", \\\\\\\"sha\\\\\\\"],\\\\n        \\\\\\\"properties\\\\\\\": {\\\\n          \\\\\\\"at\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"string\\\\\\\", \\\\\\\"minLength\\\\\\\": 1},\\\\n          \\\\\\\"class\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"string\\\\\\\", \\\\\\\"minLength\\\\\\\": 1},\\\\n          \\\\\\\"by\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"string\\\\\\\", \\\\\\\"minLength\\\\\\\": 1},\\\\n          \\\\\\\"sha\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"string\\\\\\\", \\\\\\\"minLength\\\\\\\": 1}\\\\n        }\\\\n      }\\\\n    },\\\\n    \\\\\\\"acts\\\\\\\": {\\\\n      \\\\\\\"type\\\\\\\": \\\\\\\"array\\\\\\\",\\\\n      \\\\\\\"description\\\\\\\": \\\\\\\"The operator's ruled acts on the item: each approve row and the merge row, read the same way (issue #349). rule stays in this enum for the ruling record (#276) and is never produced here.\\\\\\\",\\\\n      \\\\\\\"items\\\\\\\": {\\\\n        \\\\\\\"type\\\\\\\": \\\\\\\"object\\\\\\\",\\\\n        \\\\\\\"additionalProperties\\\\\\\": false,\\\\n        \\\\\\\"required\\\\\\\": [\\\\\\\"at\\\\\\\", \\\\\\\"act\\\\\\\", \\\\\\\"by\\\\\\\", \\\\\\\"sha\\\\\\\"],\\\\n        \\\\\\\"properties\\\\\\\": {\\\\n          \\\\\\\"at\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"string\\\\\\\", \\\\\\\"minLength\\\\\\\": 1},\\\\n          \\\\\\\"act\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"string\\\\\\\", \\\\\\\"enum\\\\\\\": [\\\\\\\"approve\\\\\\\", \\\\\\\"rule\\\\\\\", \\\\\\\"merge\\\\\\\"]},\\\\n          \\\\\\\"by\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"string\\\\\\\", \\\\\\\"minLength\\\\\\\": 1},\\\\n          \\\\\\\"sha\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"string\\\\\\\", \\\\\\\"minLength\\\\\\\": 1}\\\\n        }\\\\n      }\\\\n    },\\\\n    \\\\\\\"time\\\\\\\": {\\\\n      \\\\\\\"type\\\\\\\": \\\\\\\"object\\\\\\\",\\\\n      \\\\\\\"description\\\\\\\": \\\\\\\"Every invocation of the item, summed by attest from its stage records' wall_clock_s: per stage and for the item, every attempt and not the final one alone. lead_s runs from the first approval record's `at` to the committer time of the commit the statement is computed at; waiting_s is lead_s minus invocation_s. A record with no wall_clock_s is named in not_read and its sums are partial, never smaller in silence.\\\\\\\",\\\\n      \\\\\\\"additionalProperties\\\\\\\": false,\\\\n      \\\\\\\"required\\\\\\\": [\\\\\\\"build\\\\\\\", \\\\\\\"verify\\\\\\\", \\\\\\\"counsel\\\\\\\", \\\\\\\"invocation_s\\\\\\\", \\\\\\\"lead_s\\\\\\\", \\\\\\\"waiting_s\\\\\\\", \\\\\\\"partial\\\\\\\", \\\\\\\"not_read\\\\\\\"],\\\\n      \\\\\\\"properties\\\\\\\": {\\\\n        \\\\\\\"build\\\\\\\": {\\\\\\\"$ref\\\\\\\": \\\\\\\"#/$defs/stage_time\\\\\\\"},\\\\n        \\\\\\\"verify\\\\\\\": {\\\\\\\"$ref\\\\\\\": \\\\\\\"#/$defs/stage_time\\\\\\\"},\\\\n        \\\\\\\"counsel\\\\\\\": {\\\\\\\"$ref\\\\\\\": \\\\\\\"#/$defs/stage_time\\\\\\\"},\\\\n        \\\\\\\"invocation_s\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"number\\\\\\\", \\\\\\\"minimum\\\\\\\": 0},\\\\n        \\\\\\\"lead_s\\\\\\\": {\\\\\\\"type\\\\\\\": [\\\\\\\"number\\\\\\\", \\\\\\\"null\\\\\\\"]},\\\\n        \\\\\\\"waiting_s\\\\\\\": {\\\\\\\"type\\\\\\\": [\\\\\\\"number\\\\\\\", \\\\\\\"null\\\\\\\"]},\\\\n        \\\\\\\"partial\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"boolean\\\\\\\"},\\\\n        \\\\\\\"not_read\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"array\\\\\\\", \\\\\\\"items\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"string\\\\\\\", \\\\\\\"minLength\\\\\\\": 1}}\\\\n      }\\\\n    },\\\\n    \\\\\\\"cost\\\\\\\": {\\\\n      \\\\\\\"type\\\\\\\": \\\\\\\"object\\\\\\\",\\\\n      \\\\\\\"description\\\\\\\": \\\\\\\"Every record's cost summed by attest: the item's total across stages and executors (ruled 2026-09-19), with a subtotal per stage and per adapter. A record's cost_usd is taken as the adapter reported it; a record that reported none, with numeric tokens and a model the tenant's manifest has a [cost.rates] entry for, is priced as tokens times that rate (ruled 2026-10-05: computed here, never written into a record). usd is reported_usd plus estimated_usd. A record neither reported nor priceable is named in not_read, naming the missing rate, and makes usd and the subtotals it belongs to partial: absent is never zero, and a partial total says so.\\\\\\\",\\\\n      \\\\\\\"additionalProperties\\\\\\\": false,\\\\n      \\\\\\\"required\\\\\\\": [\\\\\\\"usd\\\\\\\", \\\\\\\"reported_usd\\\\\\\", \\\\\\\"estimated_usd\\\\\\\", \\\\\\\"by_stage_usd\\\\\\\", \\\\\\\"basis_by_stage\\\\\\\", \\\\\\\"by_adapter_usd\\\\\\\", \\\\\\\"rates\\\\\\\", \\\\\\\"estimate_note\\\\\\\", \\\\\\\"partial\\\\\\\", \\\\\\\"not_read\\\\\\\"],\\\\n      \\\\\\\"properties\\\\\\\": {\\\\n        \\\\\\\"usd\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"number\\\\\\\", \\\\\\\"minimum\\\\\\\": 0},\\\\n        \\\\\\\"reported_usd\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"number\\\\\\\", \\\\\\\"minimum\\\\\\\": 0},\\\\n        \\\\\\\"estimated_usd\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"number\\\\\\\", \\\\\\\"minimum\\\\\\\": 0},\\\\n        \\\\\\\"by_stage_usd\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"object\\\\\\\", \\\\\\\"additionalProperties\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"number\\\\\\\", \\\\\\\"minimum\\\\\\\": 0}},\\\\n        \\\\\\\"basis_by_stage\\\\\\\": {\\\\n          \\\\\\\"type\\\\\\\": \\\\\\\"object\\\\\\\",\\\\n          \\\\\\\"description\\\\\\\": \\\\\\\"For each stage with an amount: reported (every amount the adapter's), estimated (every amount priced here) or mixed.\\\\\\\",\\\\n          \\\\\\\"additionalProperties\\\\\\\": {\\\\\\\"enum\\\\\\\": [\\\\\\\"reported\\\\\\\", \\\\\\\"estimated\\\\\\\", \\\\\\\"mixed\\\\\\\"]}\\\\n        },\\\\n        \\\\\\\"by_adapter_usd\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"object\\\\\\\", \\\\\\\"additionalProperties\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"number\\\\\\\", \\\\\\\"minimum\\\\\\\": 0}},\\\\n        \\\\\\\"rates\\\\\\\": {\\\\n          \\\\\\\"type\\\\\\\": \\\\\\\"object\\\\\\\",\\\\n          \\\\\\\"description\\\\\\\": \\\\\\\"The tenant's rates this statement priced a record by, per model, as the manifest carried them: empty when nothing was priced.\\\\\\\",\\\\n          \\\\\\\"additionalProperties\\\\\\\": {\\\\n            \\\\\\\"type\\\\\\\": \\\\\\\"object\\\\\\\",\\\\n            \\\\\\\"additionalProperties\\\\\\\": false,\\\\n            \\\\\\\"required\\\\\\\": [\\\\\\\"input_usd_per_mtok\\\\\\\", \\\\\\\"output_usd_per_mtok\\\\\\\", \\\\\\\"as_of\\\\\\\", \\\\\\\"source\\\\\\\"],\\\\n            \\\\\\\"properties\\\\\\\": {\\\\n              \\\\\\\"input_usd_per_mtok\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"number\\\\\\\", \\\\\\\"minimum\\\\\\\": 0},\\\\n              \\\\\\\"output_usd_per_mtok\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"number\\\\\\\", \\\\\\\"minimum\\\\\\\": 0},\\\\n              \\\\\\\"as_of\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"string\\\\\\\", \\\\\\\"minLength\\\\\\\": 1},\\\\n              \\\\\\\"source\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"string\\\\\\\", \\\\\\\"minLength\\\\\\\": 1}\\\\n            }\\\\n          }\\\\n        },\\\\n        \\\\\\\"estimate_note\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"string\\\\\\\", \\\\\\\"const\\\\\\\": \\\\\\\"Estimated amounts are tokens times the tenant's published rates: a meter at API prices, not a bill.\\\\\\\"},\\\\n        \\\\\\\"partial\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"boolean\\\\\\\"},\\\\n        \\\\\\\"not_read\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"array\\\\\\\", \\\\\\\"items\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"string\\\\\\\", \\\\\\\"minLength\\\\\\\": 1}}\\\\n      }\\\\n    },\\\\n    \\\\\\\"tokens\\\\\\\": {\\\\n      \\\\\\\"type\\\\\\\": \\\\\\\"object\\\\\\\",\\\\n      \\\\\\\"description\\\\\\\": \\\\\\\"Every record's tokens summed by attest: per stage and for the item, input and output over every attempt and not the final one alone. With `time` and `cost`, the statement's only accounting. A record with no tokens is named in not_read and makes the sums it belongs to partial: absent is never zero.\\\\\\\",\\\\n      \\\\\\\"additionalProperties\\\\\\\": false,\\\\n      \\\\\\\"required\\\\\\\": [\\\\\\\"build\\\\\\\", \\\\\\\"verify\\\\\\\", \\\\\\\"counsel\\\\\\\", \\\\\\\"input\\\\\\\", \\\\\\\"output\\\\\\\", \\\\\\\"partial\\\\\\\", \\\\\\\"not_read\\\\\\\"],\\\\n      \\\\\\\"properties\\\\\\\": {\\\\n        \\\\\\\"build\\\\\\\": {\\\\\\\"$ref\\\\\\\": \\\\\\\"#/$defs/stage_tokens\\\\\\\"},\\\\n        \\\\\\\"verify\\\\\\\": {\\\\\\\"$ref\\\\\\\": \\\\\\\"#/$defs/stage_tokens\\\\\\\"},\\\\n        \\\\\\\"counsel\\\\\\\": {\\\\\\\"$ref\\\\\\\": \\\\\\\"#/$defs/stage_tokens\\\\\\\"},\\\\n        \\\\\\\"input\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"integer\\\\\\\", \\\\\\\"minimum\\\\\\\": 0},\\\\n        \\\\\\\"output\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"integer\\\\\\\", \\\\\\\"minimum\\\\\\\": 0},\\\\n        \\\\\\\"partial\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"boolean\\\\\\\"},\\\\n        \\\\\\\"not_read\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"array\\\\\\\", \\\\\\\"items\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"string\\\\\\\", \\\\\\\"minLength\\\\\\\": 1}}\\\\n      }\\\\n    },\\\\n    \\\\\\\"product_version\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"string\\\\\\\", \\\\\\\"minLength\\\\\\\": 1},\\\\n    \\\\\\\"product_pin\\\\\\\": {\\\\\\\"type\\\\\\\": [\\\\\\\"string\\\\\\\", \\\\\\\"null\\\\\\\"]}\\\\n  },\\\\n  \\\\\\\"$defs\\\\\\\": {\\\\n    \\\\\\\"stage_tokens\\\\\\\": {\\\\n      \\\\\\\"type\\\\\\\": \\\\\\\"object\\\\\\\",\\\\n      \\\\\\\"additionalProperties\\\\\\\": false,\\\\n      \\\\\\\"required\\\\\\\": [\\\\\\\"input\\\\\\\", \\\\\\\"output\\\\\\\", \\\\\\\"partial\\\\\\\"],\\\\n      \\\\\\\"properties\\\\\\\": {\\\\n        \\\\\\\"input\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"integer\\\\\\\", \\\\\\\"minimum\\\\\\\": 0},\\\\n        \\\\\\\"output\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"integer\\\\\\\", \\\\\\\"minimum\\\\\\\": 0},\\\\n        \\\\\\\"partial\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"boolean\\\\\\\"}\\\\n      }\\\\n    },\\\\n    \\\\\\\"stage_time\\\\\\\": {\\\\n      \\\\\\\"type\\\\\\\": \\\\\\\"object\\\\\\\",\\\\n      \\\\\\\"additionalProperties\\\\\\\": false,\\\\n      \\\\\\\"required\\\\\\\": [\\\\\\\"attempts\\\\\\\", \\\\\\\"invocation_s\\\\\\\", \\\\\\\"partial\\\\\\\"],\\\\n      \\\\\\\"properties\\\\\\\": {\\\\n        \\\\\\\"attempts\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"integer\\\\\\\", \\\\\\\"minimum\\\\\\\": 0},\\\\n        \\\\\\\"invocation_s\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"number\\\\\\\", \\\\\\\"minimum\\\\\\\": 0},\\\\n        \\\\\\\"partial\\\\\\\": {\\\\\\\"type\\\\\\\": \\\\\\\"boolean\\\\\\\"}\\\\n      }\\\\n    }\\\\n  }\\\\n}\\\",\\\"stderr\\\":\\\"\\\",\\\"interrupted\\\":false,\\\"isImage\\\":false,\\\"noOutputExpected\\\":false},\\\"tool_result_meta\\\":[{\\\"id\\\":\\\"toolu_019bU7Sre44MFFSsE9yXWFDq\\\",\\\"permission_decision\\\":{\\\"decision\\\":\\\"accept\\\",\\\"source\\\":\\\"config\\\",\\\"reason_type\\\":\\\"rule\\\"}}]}\\n+{\\\"type\\\":\\\"system\\\",\\\"subtype\\\":\\\"thinking_tokens\\\",\\\"estimated_tokens\\\":50,\\\"estimated_tokens_delta\\\":50,\\\"session_id\\\":\\\"8b358cc5-0655-4274-9562-475abdbf906d\\\",\\\"uuid\\\":\\\"3560707c-92ad-4b56-b288-9c9610b41b72\\\"}\\n+{\\\"type\\
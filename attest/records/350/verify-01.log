ain into the\\\\n7\\\\titem's branch made mid-run (8d4fd15, 19c384f), and the merge.\\\\n8\\\\t\\\\n9\\\\tRun: python3 -m pytest tests/test_attest_interventions.py -q\\\\n10\\\\t\\\\\\\"\\\\\\\"\\\\\\\"\\\\n11\\\\tfrom __future__ import annotations\\\\n12\\\\t\\\\n13\\\\timport json\\\\n14\\\\tfrom pathlib import Path\\\\n15\\\\tfrom typing import Any\\\\n16\\\\t\\\\n17\\\\timport jsonschema\\\\n18\\\\t\\\\n19\\\\tfrom helpers import commit_all, git, make_tenant\\\\n20\\\\tfrom test_attest import STATEMENT_SCHEMA, configure_forge, merge_into_main, run_attavo\\\\n21\\\\tfrom test_attest_time import INVOCATIONS, attest, make_item, proof_six, seal\\\\n22\\\\t\\\\n23\\\\t\\\\n24\\\\tdef traverse_with_a_transport(root: Path) -> str:\\\\n25\\\\t    \\\\\\\"\\\\\\\"\\\\\\\"spec-gate and approve on the item's branch; then a person merges\\\\n26\\\\t    main into it, as the operator did twice on #344; then build and\\\\n27\\\\t    verify. Returns the sha of that transport merge.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n28\\\\t    git(root, \\\\\\\"checkout\\\\\\\", \\\\\\\"-b\\\\\\\", \\\\\\\"attavo/1-x\\\\\\\")\\\\n29\\\\t    assert run_attavo(root, \\\\\\\"spec-gate\\\\\\\", \\\\\\\"1\\\\\\\").returncode == 0\\\\n30\\\\t    commit_all(root, \\\\\\\"attavo: spec-gate record for #1\\\\\\\")\\\\n31\\\\t    assert run_attavo(root, \\\\\\\"approve\\\\\\\", \\\\\\\"1\\\\\\\", \\\\\\\"--by\\\\\\\", \\\\\\\"alice\\\\\\\").returncode == 0\\\\n32\\\\t    commit_all(root, \\\\\\\"attavo: approval record for #1\\\\\\\")\\\\n33\\\\t    git(root, \\\\\\\"checkout\\\\\\\", \\\\\\\"main\\\\\\\")\\\\n34\\\\t    (root / \\\\\\\"OTHER.md\\\\\\\").write_text(\\\\\\\"landed on main while the item was in flight\\\\\\\\n\\\\\\\")\\\\n35\\\\t    commit_all(root, \\\\\\\"an unrelated change on main\\\\\\\")\\\\n36\\\\t    git(root, \\\\\\\"checkout\\\\\\\", \\\\\\\"attavo/1-x\\\\\\\")\\\\n37\\\\t    git(root, \\\\\\\"merge\\\\\\\", \\\\\\\"--no-ff\\\\\\\", \\\\\\\"-m\\\\\\\", \\\\\\\"Merge main into attavo/1-x\\\\\\\", \\\\\\\"main\\\\\\\")\\\\n38\\\\t    transport = git(root, \\\\\\\"rev-parse\\\\\\\", \\\\\\\"HEAD\\\\\\\").strip()\\\\n39\\\\t    assert run_attavo(root, \\\\\\\"build\\\\\\\", \\\\\\\"1\\\\\\\").returncode == 0\\\\n40\\\\t    commit_all(root, \\\\\\\"attavo: build record for #1\\\\\\\")\\\\n41\\\\t    assert run_attavo(root, \\\\\\\"verify\\\\\\\", \\\\\\\"1\\\\\\\").returncode == 0\\\\n42\\\\t    commit_all(root, \\\\\\\"attavo: verify record for #1\\\\\\\")\\\\n43\\\\t    merge_into_main(root, \\\\\\\"attavo/1-x\\\\\\\")\\\\n44\\\\t    return transport\\\\n45\\\\t\\\\n46\\\\t\\\\n47\\\\tdef test_a_transport_between_approval_and_merge_is_an_intervention(tmp_path: Path) -> None:\\\\n48\\\\t    root = make_tenant(tmp_path, \\\\\\\"build_valid\\\\\\\")\\\\n49\\\\t    configure_forge(root)\\\\n50\\\\t    transport = traverse_with_a_transport(root)\\\\n51\\\\t    run = run_attavo(root, \\\\\\\"attest\\\\\\\")\\\\n52\\\\t    assert run.returncode == 0, run.stdout + run.stderr\\\\n53\\\\t    statement = json.loads(run.stdout)\\\\n54\\\\t    jsonschema.validate(statement, STATEMENT_SCHEMA)\\\\n55\\\\t    interventions = statement[\\\\\\\"interventions\\\\\\\"]\\\\n56\\\\t    assert any(i[\\\\\\\"sha\\\\\\\"] == transport and i[\\\\\\\"class\\\\\\\"] == \\\\\\\"transport\\\\\\\" for i in interventions), interventions\\\\n57\\\\t    acts = {a[\\\\\\\"act\\\\\\\"] for a in statement[\\\\\\\"acts\\\\\\\"]}\\\\n58\\\\t    assert {\\\\\\\"approve\\\\\\\", \\\\\\\"merge\\\\\\\"} <= acts, statement[\\\\\\\"acts\\\\\\\"]\\\\n59\\\\t    assert all(row[\\\\\\\"sha\\\\\\\"] and row[\\\\\\\"by\\\\\\\"] and row[\\\\\\\"at\\\\\\\"] for row in statement[\\\\\\\"acts\\\\\\\"] + interventions)\\\\n60\\\\t\\\\n61\\\\t\\\\n62\\\\tdef test_doctor_proof_six_recomputes_acts_and_interventions_for_a_v6_statement(\\\\n63\\\\t        tmp_path: Path) -> None:\\\\n64\\\\t    \\\\\\\"\\\\\\\"\\\\\\\"Proof six holds a true v6 statement's acts and interventions, the\\\\n65\\\\t    same way it already holds time and cost, and fails one whose lists are\\\\n66\\\\t    not what the item's own commits give, naming the field. make_item's\\\\n67\\\\t    fixture carries no specs/ tree at all, so both lists are legitimately\\\\n68\\\\t    `[]` here (item_ledger finds no first spec commit to walk from) --\\\\n69\\\\t    declared explicitly as v6, since the heuristic that sniffs it from a\\\\n70\\\\t    sha-bearing row has nothing to find in an empty list.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n71\\\\t    root, merge = make_item(tmp_path, INVOCATIONS)\\\\n72\\\\t    statement = attest(root)\\\\n73\\\\t    assert statement[\\\\\\\"acts\\\\\\\"] == [] and statement[\\\\\\\"interventions\\\\\\\"] == []\\\\n74\\\\t    seal(root, merge, statement, \\\\\\\"https://attavo.dev/attestation/v6\\\\\\\")\\\\n75\\\\t    held = proof_six(root)\\\\n76\\\\t    assert held[\\\\\\\"holds\\\\\\\"] is True and held[\\\\\\\"sealed\\\\\\\"] == [\\\\\\\"1\\\\\\\"], held\\\\n77\\\\t\\\\n78\\\\t    forged_acts: dict[str, Any] = json.loads(json.dumps(statement))\\\\n79\\\\t    forged_acts[\\\\\\\"acts\\\\\\\"] = [{\\\\\\\"act\\\\\\\": \\\\\\\"approve\\\\\\\", \\\\\\\"sha\\\\\\\": \\\\\\\"f\\\\\\\" * 40, \\\\\\\"by\\\\\\\": \\\\\\\"nobody\\\\\\\",\\\\n80\\\\t                           \\\\\\\"at\\\\\\\": \\\\\\\"2026-01-01T00:00:00Z\\\\\\\"}]\\\\n81\\\\t    seal(root, merge, forged_acts, \\\\\\\"https://attavo.dev/attestation/v6\\\\\\\")\\\\n82\\\\t    failed = proof_six(root)\\\\n83\\\\t    assert failed[\\\\\\\"holds\\\\\\\"] is False, failed\\\\n84\\\\t    assert \\\\\\\"item 1\\\\\\\" in failed[\\\\\\\"reason\\\\\\\"] and \\\\\\\"acts\\\\\\\" in failed[\\\\\\\"reason\\\\\\\"], failed\\\\n85\\\\t\\\\n86\\\\t    forged_interventions: dict[str, Any] = json.loads(json.dumps(statement))\\\\n87\\\\t    forged_interventions[\\\\\\\"interventions\\\\\\\"] = [\\\\n88\\\\t        {\\\\\\\"class\\\\\\\": \\\\\\\"transport\\\\\\\", \\\\\\\"sha\\\\\\\": \\\\\\\"f\\\\\\\" * 40, \\\\\\\"by\\\\\\\": \\\\\\\"nobody\\\\\\\", \\\\\\\"at\\\\\\\": \\\\\\\"2026-01-01T00:00:00Z\\\\\\\"}]\\\\n89\\\\t    seal(root, merge, forged_interventions, \\\\\\\"https://attavo.dev/attestation/v6\\\\\\\")\\\\n90\\\\t    failed = proof_six(root)\\\\n91\\\\t    assert failed[\\\\\\\"holds\\\\\\\"] is False, failed\\\\n92\\\\t    assert \\\\\\\"item 1\\\\\\\" in failed[\\\\\\\"reason\\\\\\\"] and \\\\\\\"interventions\\\\\\\" in failed[\\\\\\\"reason\\\\\\\"], failed\\\\n93\\\\t\\\"}]},\\\"parent_tool_use_id\\\":null,\\\"session_id\\\":\\\"8b358cc5-0655-4274-9562-475abdbf906d\\\",\\\"uuid\\\":\\\"ca47cfab-db54-40a4-8f8c-d0ea4fc84c6f\\\",\\\"timestamp\\\":\\\"2026-10-14T19:58:06.307Z\\\",\\\"tool_use_result\\\":{\\\"type\\\":\\\"text\\\",\\\"file\\\":{\\\"filePath\\\":\\\"/Users/davidbean/Projects/attavo-worktree-353/tests/test_attest_interventions.py\\\",\\\"content\\\":\\\"\\\\\\\"\\\\\\\"\\\\\\\"The statement's acts and interventions are read from the item's own\\\\ncommits, the same classification `attavo ledger` makes (issue #349).\\\\n\\\\nSpecimen: #344's v5 statement (merged as PR #345, d2354e27) carried\\\\n`acts: []` and `interventions: []`, hard-coded in attavo/attest.py. Its\\\\nledger showed four operator acts: an approval, two merges of main into the\\\\nitem's branch made mid-run (8d4fd15, 19c384f), and the merge.\\\\n\\\\nRun: python3 -m pytest tests/test_attest_interventions.py -q\\\\n\\\\\\\"\\\\\\\"\\\\\\\"\\\\nfrom __future__ import annotations\\\\n\\\\nimport json\\\\nfrom pathlib import Path\\\\nfrom typing import Any\\\\n\\\\nimport jsonschema\\\\n\\\\nfrom helpers import commit_all, git, make_tenant\\\\nfrom test_attest import STATEMENT_SCHEMA, configure_forge, merge_into_main, run_attavo\\\\nfrom test_attest_time import INVOCATIONS, attest, make_item, proof_six, seal\\\\n\\\\n\\\\ndef traverse_with_a_transport(root: Path) -> str:\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"spec-gate and approve on the item's branch; then a person merges\\\\n    main into it, as the operator did twice on #344; then build and\\\\n    verify. Returns the sha of that transport merge.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n    git(root, \\\\\\\"checkout\\\\\\\", \\\\\\\"-b\\\\\\\", \\\\\\\"attavo/1-x\\\\\\\")\\\\n    assert run_attavo(root, \\\\\\\"spec-gate\\\\\\\", \\\\\\\"1\\\\\\\").returncode == 0\\\\n    commit_all(root, \\\\\\\"attavo: spec-gate record for #1\\\\\\\")\\\\n    assert run_attavo(root, \\\\\\\"approve\\\\\\\", \\\\\\\"1\\\\\\\", \\\\\\\"--by\\\\\\\", \\\\\\\"alice\\\\\\\").returncode == 0\\\\n    commit_all(root, \\\\\\\"attavo: approval record for #1\\\\\\\")\\\\n    git(root, \\\\\\\"checkout\\\\\\\", \\\\\\\"main\\\\\\\")\\\\n    (root / \\\\\\\"OTHER.md\\\\\\\").write_text(\\\\\\\"landed on main while the item was in flight\\\\\\\\n\\\\\\\")\\\\n    commit_all(root, \\\\\\\"an unrelated change on main\\\\\\\")\\\\n    git(root, \\\\\\\"checkout\\\\\\\", \\\\\\\"attavo/1-x\\\\\\\")\\\\n    git(root, \\\\\\\"merge\\\\\\\", \\\\\\\"--no-ff\\\\\\\", \\\\\\\"-m\\\\\\\", \\\\\\\"Merge main into attavo/1-x\\\\\\\", \\\\\\\"main\\\\\\\")\\\\n    transport = git(root, \\\\\\\"rev-parse\\\\\\\", \\\\\\\"HEAD\\\\\\\").strip()\\\\n    assert run_attavo(root, \\\\\\\"build\\\\\\\", \\\\\\\"1\\\\\\\").returncode == 0\\\\n    commit_all(root, \\\\\\\"attavo: build record for #1\\\\\\\")\\\\n    assert run_attavo(root, \\\\\\\"verify\\\\\\\", \\\\\\\"1\\\\\\\").returncode == 0\\\\n    commit_all(root, \\\\\\\"attavo: verify record for #1\\\\\\\")\\\\n    merge_into_main(root, \\\\\\\"attavo/1-x\\\\\\\")\\\\n    return transport\\\\n\\\\n\\\\ndef test_a_transport_between_approval_and_merge_is_an_intervention(tmp_path: Path) -> None:\\\\n    root = make_tenant(tmp_path, \\\\\\\"build_valid\\\\\\\")\\\\n    configure_forge(root)\\\\n    transport = traverse_with_a_transport(root)\\\\n    run = run_attavo(root, \\\\\\\"attest\\\\\\\")\\\\n    assert run.returncode == 0, run.stdout + run.stderr\\\\n    statement = json.loads(run.stdout)\\\\n    jsonschema.validate(statement, STATEMENT_SCHEMA)\\\\n    interventions = statement[\\\\\\\"interventions\\\\\\\"]\\\\n    assert any(i[\\\\\\\"sha\\\\\\\"] == transport and i[\\\\\\\"class\\\\\\\"] == \\\\\\\"transport\\\\\\\" for i in interventions), interventions\\\\n    acts = {a[\\\\\\\"act\\\\\\\"] for a in statement[\\\\\\\"acts\\\\\\\"]}\\\\n    assert {\\\\\\\"approve\\\\\\\", \\\\\\\"merge\\\\\\\"} <= acts, statement[\\\\\\\"acts\\\\\\\"]\\\\n    assert all(row[\\\\\\\"sha\\\\\\\"] and row[\\\\\\\"by\\\\\\\"] and row[\\\\\\\"at\\\\\\\"] for row in statement[\\\\\\\"acts\\\\\\\"] + interventions)\\\\n\\\\n\\\\ndef test_doctor_proof_six_recomputes_acts_and_interventions_for_a_v6_statement(\\\\n        tmp_path: Path) -> None:\\\\n    \\\\\\\"\\\\\\\"\\\\\\\"Proof six holds a true v6 statement's acts and interventions, the\\\\n    same way it already holds time and cost, and fails one whose lists are\\\\n    not what the item's own commits give, naming the field. make_item's\\\\n    fixture carries no specs/ tree at all, so both lists are legitimately\\\\n    `[]` here (item_ledger finds no first spec commit to walk from) --\\\\n    declared explicitly as v6, since the heuristic that sniffs it from a\\\\n    sha-bearing row has nothing to find in an empty list.\\\\\\\"\\\\\\\"\\\\\\\"\\\\n    root, merge = make_item(tmp_path, INVOCATIONS)\\\\n    statement = attest(root)\\\\n    assert statement[\\\\\\\"acts\\\\\\\"] == [] and statement[\\\\\\\"interventions\\\\\\\"] == []\\\\n    seal(root, merge, statement, \\\\\\\"https://attavo.dev/attestation/v6\\\\\\\")\\\\n    held = proof_six(root)\\\\n    assert held[\\\\\\\"holds\\\\\\\"] is True and held[\\\\\\\"sealed\\\\\\\"] == [\\\\\\\"1\\\\\\\"], held\\\\n\\\\n    forged_acts: dict[str, Any] = json.loads(json.dumps(statement))\\\\n    forged_acts[\\\\\\\"acts\\\\\\\"] = [{\\\\\\\"act\\\\\\\": \\\\\\\"approve\\\\\\\", \\\\\\\"sha\\\\\\\": \\\\\\\"f\\\\\\\" * 40, \\\\\\\"by\\\\\\\": \\\\\\\"nobody\\\\\\\",\\\\n                           \\\\\\
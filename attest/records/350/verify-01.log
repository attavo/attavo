statement, merges=merges)\\n             if disagreement:\\n                 reasons.append(disagreement)\\n         elif exit_code == 2:\",\"stderr\":\"\",\"interrupted\":false,\"isImage\":false,\"noOutputExpected\":false},\"tool_result_meta\":[{\"id\":\"toolu_014y8uLfzh2rKA5DzUyD32kF\",\"permission_decision\":{\"decision\":\"accept\",\"source\":\"config\",\"reason_type\":\"rule\"}}]}\n    # failed. Absent, the window starts where proof three's does: the\n    # install commit, or [doctor].from (issue #192).\n    since = (m.get(\"forge\") or {}).get(\"sealed_since\")\n    if not (isinstance(since, str) and since.strip()):\n        try:\n            since = proof_window_start(root, m)[1]\n        except WindowRefused as exc:\n            return p.fail(str(exc))\n    merges, refusal = _merges_reachable(root)\n    if refusal:\n        return p.fail(refusal)\n    sealed: list[str] = []\n    before_window: list[str] = []\n    unsealed: list[str] = []\n    not_merged: list[str] = []\n    not_read: list[str] = []\n    reasons: list[str] = []\n    for item in complete:\n        merge_sha, _ = merge_introducing_records(root, records_rel, item, STAGES, merges=merges)\n        if merge_sha is None:\n            not_merged.append(item)\n            continue\n        if _is_ancestor(root, merge_sha, since):\n            before_window.append(item)\n            continue\n        statement, exit_code = statement_for(root, cmd, merge_sha)\n        if statement is not None:\n            sealed.append(item)\n            disagreement = _accounting_disagrees(root, records_dir / item, item, merge_sha,\n                                                 statement, merges=merges)\n            if disagreement:\n                reasons.append(disagreement)\n        elif exit_code == 2:\n            not_read.append(item)\n            reasons.append(f\"item {item} merged at {merge_sha[:12]}: not read -- \"\n                           f\"the store could not be read; {cmd!r} exited 2\")\n        else:\n            unsealed.append(item)\n            reasons.append(f\"item {item} merged at {merge_sha[:12]} has no statement in the store\")\n    if reasons:\n        return p.fail(\"; \".join(reasons), sealed=sealed, before_window=before_window,\n                      unsealed=unsealed, not_merged=not_merged, not_read=not_read)\n    window = f\" at {since[:12]}\" if before_window else \"\"\n    return p.hold(f\"{len(sealed)} sealed, {len(before_window)} before the window{window}, \"\n                 f\"{len(not_merged)} not merged\",\n                 sealed=sealed, before_window=before_window, unsealed=unsealed,\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-A8aNeKxW' (errno=Operation not permitted)\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-3Oh3JPnZ' (errno=Operation not permitted)\n## Problem\n\nClass: fix\n\nThe ledger's rows carry a sha, an identity and a class, and nothing about what the commit holds. Readers then guess. The screen derives a \"record file\" column from each commit's diff and reads \"not read\" for commits that carry something nameable: invocation marker commits (`build-01.started`), a person's transport commits (nothing, by design), and the merge, whose record is the item's statement in the forge's attestation store, not a file in the tree. Specimen: #344's ledger in Analyze on 2026-10-07, five rows \"not read\". \"Not read\" should mean a source did not answer.\n\nThe change: every row carries `carries`, the repository-relative paths the commit touched under the records and specs paths (and, for the executor's change rows, every path it touched); a transport row carries `[]`. The merge row also carries `statement`: `{predicate_type, subject}` read through the manifest's `[forge].attestation_command` with the merge sha, the same read doctor proof six already makes (`statement_for`); when the store does not answer or holds none, `statement` is null and a `note` says \"not read: …\" naming which. The text form prints what each row carries. The screen's own derivation is then retired by a later pass.\n\nThe stub is thin: the two rejection tests in `tests/test_ledger.py`, red on the stub. The build writes the logic.\n\nRetires: \"not read\" as the label for \"nothing to read here\" and \"read elsewhere\"; the screen deriving a record file from a diff.\n\n## Claims\n\n- attavo/ledger.py\n- tests/test_ledger.py\n\n## Criteria\n\n- [structural] the-rejection-tests-exist.sh: tests/test_ledger.py carries test_each_ledger_row_names_what_its_commit_carries and test_the_merge_row_says_not_read_when_the_store_does_not_answer\n- [behavioural] each-row-names-what-its-commit-carries.sh: on a ledger_base tenant with a marker commit, a person's transport commit and a store holding the merge's statement, attavo ledger --json gives each row its carries (the spec file, each record file, the .started marker, the executor's touched file, nothing for the transport) and the merge row its statement's predicate type and subject digest\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-ePSJgFYh' (errno=Operation not permitted)\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-MWZcM08a' (errno=Operation not permitted)\n                   if records_root.is_dir() else [])\n\n    # Computed once for every item in this read, not once per item (issue\n    # #153): the default branch's merges do not depend on which item is\n    # being asked about.\n    merges, refusal = _merges_reachable(root)\n    if refusal:\n        print(f\"attavo ledger: refused: {refusal}\", file=sys.stderr)\n        return 2\n    ledgers = [item_ledger(root, m, item_id, merges=merges) for item_id in item_ids]\n\n    if as_json:\n        if positional:\n            print(json.dumps(ledgers[0], indent=2))\n        else:\n            print(json.dumps({\"items\": ledgers}, indent=2))\n        return 0\n\n    for entry in ledgers:\n        print(f\"attavo ledger: item {entry['item']}\")\n        for row in entry[\"rows\"]:\n            note = f\"  ({row['note']})\" if \"note\" in row else \"\"\n            print(f\"  {row['sha'][:12]}  {row['identity']:<32}  {row['class']}{note}\")\n        s = entry[\"summary\"]\n        print(f\"  operator acts: {s['operator_acts']}  product acts: {s['product_acts']}  \"\n             f\"executor commits: {s['executor_commits']}  stops: {s['stops']}  \"\n             f\"since: {s['since']}\")\n    if not ledgers:\n        print(f\"attavo ledger: no item found under {records_rel}\")\n    return 0\n\n\nCOMMANDS = (\n    Command(\n        name='ledger',\n        run=cmd_ledger,\n        usage=('attavo ledger [N] [--json]',),\n        rank=140,\n        help=(\n            (250, \"\"\"\\\nledger reads, never writes. For item N (or every item under\npaths.records when N is omitted), it walks the commits from the item's\nfirst spec commit to its merge (the same derivation doctor's proof two\nand attest use) or to HEAD when the item has not merged, and prints one\nrow per act: the sha, the identity as git names it, and a class from a\nclosed list -- spec, amend, approve, launch, record, change, transport,\nmerge -- derived from who committed it and, for an approval, build, or\nverify record, what the record itself says. A summary line follows:\noperator acts (approve, amend, launch, transport, merge), product acts\n(record), executor commits (change), stops (non-pass records), and\nsince (the product version on the first record). A build or verify\nrecord's own commit, from before v0.18.0 gave the driver and the\nexecutor their own identities, prints as record-or-launch with a note,\ncounted toward neither total, rather than guessed. --json prints the\nrows and the summary as one object. See issue #128's lane for the full\nrules it enforces.\"\"\"),\n        ),\n    ),\n)\n","exit_code":0,"status":"completed"}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019xuYKcQ4N42nEMFKg4yRgz","type":"tool_result","content":"1\t\"\"\"attavo ledger: every act on an item by identity and class (issue #128).\n2\t\n3\tRegression tests, written and run red first: on `main` before this change\n4\tthere was no `ledger` subcommand, so every one of these failed with\n5\t\"unknown subcommand\".\n6\t\n7\tRun: python3 -m pytest tests -q\n8\t\"\"\"\n9\timport json\n10\timport os\n11\timport subprocess\n12\timport sys\n13\tfrom pathlib import Path\n14\tfrom typing import Any\n15\t\n16\tfrom helpers import git, make_tenant\n17\t\n18\tROOT = Path(__file__).resolve().parent.parent\n19\tATTAVO = ROOT / \"bin\" / \"attavo\"\n20\t\n21\t# The four identities issue #128 names: a person (writes the spec, in the\n22\t# real templates also the one who comments /approve), the records app (a\n23\t# GitHub App's own bot login -- \"<app-slug>[bot]\" -- that commits\n24\t# spec-gate and approval records in attavo-spec-gate.yml and\n25\t# attavo-approve.yml), the driver (drive's own record commits), and the\n26\t# executor (an adapter invocation's own commits).\n27\tPERSON = {\"name\": \"Alice Author\", \"email\": \"alice@example.com\"}\n28\tRECORDS_APP = {\"name\": \"attavo-bot[bot]\", \"email\": \"123+attavo-bot[bot]@users.noreply.github.com\"}\n29\tDRIVER = {\"name\": \"attavo driver\", \"email\": \"driver@attavo.invalid\"}\n30\tEXECUTOR = {\"name\": \"attavo executor (fixture)\", \"email\": \"executor+fixture@attavo.invalid\"}\n31\t\n32\t\n33\tdef run_attavo(root: Path, *args: str) -> subprocess.CompletedProcess[str]:\n34\t    return subprocess.run([sys.executable, str(ATTAVO), *args], cwd=str(root),\n35\t                          capture_output=True, text=True, check=False)\n36\t\n37\t\n38\tdef commit_as(root: Path, identity: dict[str, Any], message: str, paths: list[str]) -> str:\n39\t    \"\"\"Stage exactly paths and commit as identity, both author and\n40\t    committer -- the same shape commit_record and the tenant's own CI\n41\t    templates set (never the tenant's ambient git config).\"\"\"\n42\t    git(root, \"add\", *paths)\n43\t    env = dict(os.environ)\n44\t    env[\"GIT_AUTHOR_NAME\"] = env[\"GIT_COMMITTER_NAME\"] = identity[\"name\"]\n45\t    env[\"GIT_AUTHOR_EMAIL\"] = env[\"GIT_COMMITTER_EMAIL\"] = identity[\"email\"]\n46\t    subprocess.run([\"git\", \"-C\", str(root), \"commit\", \"-q\", \"-m\", message],\n47\t                   check=True, env=env)\n48\t    return git(root, \"rev-parse\", \"HEAD\").strip()\n49\t\n50\t\n51\tdef write_record(root: Path, item: str, stage: str, n: int, content: dict[str, Any]) -> str:\n52\t    records_dir = root / \"records\" / item\n53\t    records_dir.mkdir(parents=True, exist_ok=True)\n54\t    path = records_dir / f\"{stage}-{n:02d}.json\"\n55\t    path.write_text(json.dumps(content))\n56\t    return str(path.relative_to(root))\n57\t\n58\t\n59\tdef add_spec(root: Path, item: str = \"1\") -> str:\n60\t    spec_dir = root / \"specs\" / item\n61\t    spec_dir.mkdir(parents=True)\n62\t    (spec_dir / \"spec.md\").write_text(\"## Problem\\n\\nsomething.\\n\")\n63\t    return commit_as(root, PERSON, f\"spec: item {item}\", [f\"specs/{item}\"])\n64\t\n65\t\n66\tdef build_merged_item(tmp_path: Path, item: str = \"1\") -> Path:\n67\t    \"\"\"The order #651 had: a person's spec commit, the records app's\n68\t    spec-gate and approval records, the executor's own change, the\n69\t    driver's build and verify records, then the merge landing all of it\n70\t    on main.\"\"\"\n71\t    root = make_tenant(tmp_path, \"ledger_base\")\n72\t    git(root, \"checkout\", \"-b\", \"item\")\n73\t\n74\t    spec_sha = add_spec(root, item)\n75\t\n76\t    rel = write_record(root, item, \"spec\", 1,\n77\t                       {\"status\": \"pass\", \"spec_sha\": spec_sha, \"product_version\": \"v0.19.1\"})\n78\t    commit_as(root, RECORDS_APP, f\"attavo: spec-gate record for item {item}\", [rel])\n79\t\n80\t    rel = write_record(root, item, \"approval\", 1,\n81\t                       {\"approved_by\": \"alice\", \"sha\": spec_sha, \"spec_sha\": spec_sha,\n82\t                        \"product_version\": \"v0.19.1\"})\n83\t    commit_as(root, RECORDS_APP, f\"attavo: approval record for item {item}\", [rel])\n84\t\n85\t    (root / \"built.txt\").write_text(\"built\\n\")\n86\t    commit_as(root, EXECUTOR, f\"fixture: build item {item}\", [\"built.txt\"])\n87\t\n88\t    rel = write_record(root, item, \"build\", 1, {\"status\": \"pass\", \"product_version\": \"v0.19.1\"})\n89\t    commit_as(root, DRIVER, f\"attavo: build record for item {item} (build-01)\", [rel])\n90\t\n91\t    rel = write_record(root, item, \"verify\", 1, {\"status\": \"pass\", \"product_version\": \"v0.19.1\"})\n92\t    commit_as(root, DRIVER, f\"attavo: verify record for item {item} (verify-01)\", [rel])\n93\t\n94\t    git(root, \"checkout\", \"main\")\n95\t    subprocess.run([\"git\", \"-C\", str(root), \"merge\", \"--no-ff\", \"item\",\n96\t                    \"-m\", f\"Merge pull request #{item} from x/item\"], check=True)\n97\t    return root\n98\t\n99\t\n100\tdef test_ledger_classifies_every_commit_and_counts_operator_acts(tmp_path: Path) -> None:\n101\t    \"\"\"Acceptance row 1: on a fixture with the four identities, every\n102\t    commit gets exactly one class and the summary counts operator acts 2\n103\t    -- the same shape tenant zero's own #651 reads (1 approve, 1 merge).\"\"\"\n104\t    root = build_merged_item(tmp_path)\n105\t\n106\t    run = run_attavo(root, \"ledger\", \"1\", \"--json\")\n107\t    assert run.returncode == 0, run.stdout + run.stderr\n108\t    data = json.loads(run.stdout)\n109\t\n110\t    classes = [row[\"class\"] for row in data[\"rows\"]]\n111\t    assert classes == [\"spec\", \"record\", \"approve\", \"change\", \"record\", \"record\", \"merge\"]\n112\t    assert all(row[\"class\"] and row[\"sha\"] and row[\"identity\"] for row in data[\"rows\"])\n113\t\n114\t    summary = data[\"summary\"]\n115\t    assert summary[\"operator_acts\"] == 2\n116\t    assert summary[\"product_acts\"] == 3\n117\t    assert summary[\"executor_commits\"] == 1\n118\t    assert summary[\"stops\"] == 0\n119\t    assert summary[\"since\"] == \"v0.19.1\"\n120\t\n121\t\n122\tdef test_ledger_stops_count_matches_stops_including_a_gate_refusal(tmp_path: Path) -> None:\n123\t    \"\"\"Issue #137, acceptance row 2. A refused spec-gate record and a\n124\t    non-pass build record: ledger's own stops count is the same set\n125\t    `attavo stops` counts, gate refusals included -- both computed by\n126\t    item_stops, not two producers reading one item and printing\n127\t    different numbers (tenant zero #683: stops printed 1, ledger printed\n128\t    0, because ledger's own count only ever looked at build and verify).\n129\t    \"\"\"\n130\t    root = make_tenant(tmp_path, \"ledger_base\")\n131\t    add_spec(root)\n132\t\n133\t    write_record(root, \"1\", \"spec\", 1,\n134\t                {\"status\": \"refused\",\n135\t                 \"refusal\": \"criterion fails against the tree plus stub: \"\n136\t                            \"doctor-template-absent.sh\"})\n137\t    write_record(root, \"1\", \"build\", 1, {\"status\": \"failed\"})\n138\t\n139\t    ledger_run = run_attavo(root, \"ledger\", \"1\", \"--json\")\n140\t    assert ledger_run.returncode == 0, ledger_run.stdout + ledger_run.stderr\n141\t    stops_run = run_attavo(root, \"stops\", \"1\", \"--json\")\n142\t    assert stops_run.returncode == 0, stops_run.stdout + stops_run.stderr\n143\t\n144\t    ledger_data = json.loads(ledger_run.stdout)\n145\t    stops_data = json.loads(stops_run.stdout)\n146\t\n147\t    assert len(stops_data[\"rows\"]) == 2\n148\t    assert ledger_data[\"summary\"][\"stops\"] == len(stops_data[\"rows\"])\n149\t\n150\t\n151\tdef test_ledger_marks_a_pre_v018_record_commit_as_record_or_launch(tmp_path: Path) -> None:\n152\t    \"\"\"Acceptance row 2: a person's record commit before v0.18.0 prints\n153\t    record-or-launch with the note, never launch or record -- before that\n154\t    version the driver and the executor had no identity of their own to\n155\t    tell a genuine launch apart from an automated one.\"\"\"\n156\t    root = make_tenant(tmp_path, \"ledger_base\")\n157\t    add_spec(root)\n158\t\n159\t    rel = write_record(root, \"1\", \"build\", 1, {\"status\": \"pass\", \"product_version\": \"v0.17.0\"})\n160\t    person_sha = commit_as(root, PERSON, \"manual build record for item 1\", [rel])\n161\t\n162\t    run = run_attavo(root, \"ledger\", \"1\", \"--json\")\n163\t    assert run.returncode == 0, run.stdout + run.stderr\n164\t    data = json.loads(run.stdout)\n165\t\n166\t    row = next(r for r in data[\"rows\"] if r[\"sha\"] == person_sha)\n167\t    assert row[\"class\"] == \"record-or-launch\"\n168\t    assert row[\"note\"] == \"not distinguishable before v0.18.0\"\n169\t    assert data[\"summary\"][\"operator_acts\"] == 0\n170\t    assert data[\"summary\"][\"product_acts\"] == 0\n171\t\n172\t\n173\tdef test_ledger_classifies_an_invocation_marker_commit_as_a_product_record(tmp_path: Path) -> None:\n174\t    \"\"\"Issue #151: the invocation marker's own commit, authored by the\n175\t    driver identity, touches paths.records without matching a stage\n176\t    record's own NN.json name -- classified \"record\", the product's own\n177\t    act, never \"transport\". Otherwise the same order build_merged_item\n178\t    sets up, with the marker's own commit landing just ahead of the\n179\t    build record it precedes in a real drive run.\"\"\"\n180\t    root = make_tenant(tmp_path, \"ledger_base\")\n181\t    git(root, \"checkout\", \"-b\", \"item\")\n182\t\n183\t    spec_sha = add_spec(root, \"1\")\n184\t\n185\t    rel = write_record(root, \"1\", \"spec\", 1,\n186\t                       {\"status\": \"pass\", \"spec_sha\": spec_sha, \"product_version\": \"v0.19.1\"})\n187\t    commit_as(root, RECORDS_APP, \"attavo: spec-gate record for item 1\", [rel])\n188\t\n189\t    rel = write_record(root, \"1\", \"approval\", 1,\n190\t                       {\"approved_by\": \"alice\", \"sha\": spec_sha, \"spec_sha\": spec_sha,\n191\t                        \"product_version\": \"v0.19.1\"})\n192\t    commit_as(root, RECORDS_APP, \"attavo: approval record for item 1\", [rel])\n193\t\n194\t    marker_dir = root / \"records\" / \"1\"\n195\t    marker_dir.mkdir(parents=True, exist_ok=True)\n196\t    marker = marker_dir / \"build-01.started\"\n197\t    marker.write_text(json.dumps({\"at\": \"2026-01-01T00:00:00Z\", \"host\": \"h\", \"pid\": 1,\n198\t                                  \"sha\": spec_sha, \"product_version\": \"v0.19.1\"}))\n199\t    marker_sha = commit_as(root, DRIVER, \"attavo: build invocation 01 started for item 1\",\n200\t                           [str(marker.relative_to(root))])\n201\t\n202\t    (root / \"built.txt\").write_text(\"built\\n\")\n203\t    commit_as(root, EXECUTOR, \"fixture: build item 1\", [\"built.txt\"])\n204\t\n205\t    rel = write_record(root, \"1\", \"build\", 1, {\"status\": \"pass\", \"product_version\": \"v0.19.1\"})\n206\t    commit_as(root, DRIVER, \"attavo: build record for item 1 (build-01)\", [rel])\n207\t\n208\t    rel = write_record(root, \"1\", \"verify\", 1, {\"status\": \"pass\", \"product_version\": \"v0.19.1\"})\n209\t    commit_as(root, DRIVER, \"attavo: verify record for item 1 (verify-01)\", [rel])\n210\t\n211\t    git(root, \"checkout\", \"main\")\n212\t    subprocess.run([\"git\", \"-C\", str(root), \"merge\", \"--no-ff\", \"item\",\n213\t                    \"-m\", \"Merge pull request #1 from x/item\"], check=True)\n214\t\n215\t    run = run_attavo(root, \"ledger\", \"1\", \"--json\")\n216\t    assert run.returncode == 0, run.stdout + run.stderr\n217\t    data = json.loads(run.stdout)\n218\t\n219\t    row = next(r for r in data[\"rows\"] if r[\"sha\"] == marker_sha)\n220\t    assert row[\"class\"] == \"record\"\n221\t\n222\t    classes = [r[\"class\"] for r in data[\"rows\"]]\n223\t    assert classes == [\"spec\", \"record\", \"approve\", \"record\", \"change\", \"record\", \"record\", \"merge\"]\n224\t    assert data[\"summary\"][\"product_acts\"] == 4\n225\t    assert data[\"summary\"][\"operator_acts\"] == 2\n226\t\n227\t\n228\tdef test_ledger_json_is_one_object_matching_the_text_forms_numbers(tmp_path: Path) -> None:\n229\t    \"\"\"Acceptance row 3: --json is one object with rows and summary, and\n230\t    the text form prints the same numbers.\"\"\"\n231\t    root = build_merged_item(tmp_path)\n232\t\n233\t    run_json = run_attavo(root, \"ledger\", \"1\", \"--json\")\n234\t    assert run_json.returncode == 0, run_json.stdout + run_json.stderr\n235\t    data = json.loads(run_json.stdout)\n236\t    assert set(data) == {\"item\", \"rows\", \"summary\"}\n237\t    assert isinstance(data[\"rows\"], list)\n238\t    assert isinstance(data[\"summary\"], dict)\n239\t\n240\t    run_text = run_attavo(root, \"ledger\", \"1\")\n241\t    assert run_text.returncode == 0, run_text.stdout + run_text.stderr\n242\t    summary = data[\"summary\"]\n243\t    assert f\"operator acts: {summary['operator_acts']}\" in run_text.stdout\n244\t    assert f\"product acts: {summary['product_acts']}\" in run_text.stdout\n245\t    assert f\"executor commits: {summary['executor_commits']}\" in run_text.stdout\n246\t    assert f\"stops: {summary['stops']}\" in run_text.stdout\n247\t    assert f\"since: {summary['since']}\" in run_text.stdout\n248\t"}]},"parent_tool_use_id":null,"session_id":"0a5d4e4f-a8ec-461c-a70f-8d166fde6be5","uuid":"e2d0801b-69db-49b0-8e86-2d2d3d917f5a","timestamp":"2026-10-15T15:11:36.570Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-350/tests/test_ledger.py","content":"\"\"\"attavo ledger: every act on an item by identity and class (issue #128).\n\nRegression tests, written and run red first: on `main` before this change\nthere was no `ledger` subcommand, so every one of these failed with\n\"unknown subcommand\".\n\nRun: python3 -m pytest tests -q\n\"\"\"\nimport json\nimport os\nimport subprocess\nimport sys\nfrom pathlib import Path\nfrom typing import Any\n\nfrom helpers import git, make_tenant\n\nROOT = Path(__file__).resolve().parent.parent\nATTAVO = ROOT / \"bin\" / \"attavo\"\n\n# The four identities issue #128 names: a person (writes the spec, in the\n# real templates also the one who comments /approve), the records app (a\n# GitHub App's own bot login -- \"<app-slug>[bot]\" -- that commits\n# spec-gate and approval records in attavo-spec-gate.yml and\n# attavo-approve.yml), the driver (drive's own record commits), and the\n# executor (an adapter invocation's own commits).\nPERSON = {\"name\": \"Alice Author\", \"email\": \"alice@example.com\"}\nRECORDS_APP = {\"name\": \"attavo-bot[bot]\", \"email\": \"123+attavo-bot[bot]@users.noreply.github.com\"}\nDRIVER = {\"name\": \"attavo driver\", \"email\": \"driver@attavo.invalid\"}\nEXECUTOR = {\"name\": \"attavo executor (fixture)\", \"email\": \"executor+fixture@attavo.invalid\"}\n\n\ndef run_attavo(root: Path, *args: str) -> subprocess.CompletedProcess[str]:\n    return subprocess.run([sys.executable, str(ATTAVO), *args], cwd=str(root),\n                          capture_output=True, text=True, check=False)\n\n\ndef commit_as(root: Path, identity: dict[str, Any], message: str, paths: list[str]) -> str:\n    \"\"\"Stage exactly paths and commit as identity, both author and\n    committer -- the same shape commit_record and the tenant's own CI\n    templates set (never the tenant's ambient git config).\"\"\"\n    git(root, \"add\", *paths)\n    env = dict(os.environ)\n    env[\"GIT_AUTHOR_NAME\"] = env[\"GIT_COMMITTER_NAME\"] = identity[\"name\"]\n    env[\"GIT_AUTHOR_EMAIL\"] = env[\"GIT_COMMITTER_EMAIL\"] = identity[\"email\"]\n    subprocess.run([\"git\", \"-C\", str(root), \"commit\", \"-q\", \"-m\", message],\n                   check=True, env=env)\n    return git(root, \"rev-parse\", \"HEAD\").strip()\n\n\ndef write_record(root: Path, item: str, stage: str, n: int, content: dict[str, Any]) -> str:\n    records_dir = root / \"records\" / item\n    records_dir.mkdir(parents=True, exist_ok=True)\n    path = records_dir / f\"{stage}-{n:02d}.json\"\n    path.write_text(json.dumps(content))\n    return str(path.relative_to(root))\n\n\ndef add_spec(root: Path, item: str = \"1\") -> str:\n    spec_dir = root / \"specs\" / item\n    spec_dir.mkdir(parents=True)\n    (spec_dir / \"spec.md\").write_text(\"## Problem\\n\\nsomething.\\n\")\n    return commit_as(root, PERSON, f\"spec: item {item}\", [f\"specs/{item}\"])\n\n\ndef build_merged_item(tmp_path: Path, item: str = \"1\") -> Path:\n    \"\"\"The order #651 had: a person's spec commit, the records app's\n    spec-gate and approval records, the executor's own change, the\n    driver's build and verify records, then the merge landing all of it\n    on main.\"\"\"\n    root = make_tenant(tmp_path, \"ledger_base\")\n    git(root, \"checkout\", \"-b\", \"item\")\n\n    spec_sha = add_spec(root, item)\n\n    rel = write_record(root, item, \"spec\", 1,\n                       {\"status\": \"pass\", \"spec_sha\": spec_sha, \"product_version\": \"v0.19.1\"})\n    commit_as(root, RECORDS_APP, f\"attavo: spec-gate record for item {item}\", [rel])\n\n    rel = write_record(root, item, \"approval\", 1,\n                       {\"approved_by\": \"alice\", \"sha\": spec_sha, \"spec_sha\": spec_sha,\n                        \"product_version\": \"v0.19.1\"})\n    commit_as(root, RECORDS_APP, f\"attavo: approval record for item {item}\", [rel])\n\n    (root / \"built.txt\").write_text(\"built\\n\")\n    commit_as(root, EXECUTOR, f\"fixture: build item {item}\", [\"built.txt\"])\n\n    rel = write_record(root, item, \"build\", 1, {\"status\": \"pass\", \"product_version\": \"v0.19.1\"})\n    commit_as(root, DRIVER, f\"attavo: build record for item {item} (build-01)\", [rel])\n\n    rel = write_record(root, item, \"verify\", 1, {\"status\": \"pass\", \"product_version\": \"v0.19.1\"})\n    commit_as(root, DRIVER, f\"attavo: verify record for item {item} (verify-01)\", [rel])\n\n    git(root, \"checkout\", \"main\")\n    subprocess.run([\"git\", \"-C\", str(root), \"merge\", \"--no-ff\", \"item\",\n                    \"-m\", f\"Merge pull request #{item} from x/item\"], check=True)\n    return root\n\n\ndef test_ledger_classifies_every_commit_and_counts_operator_acts(tmp_path: Path) -> None:\n    \"\"\"Acceptance row 1: on a fixture with the four identities, every\n    commit gets exactly one class and the summary counts operator acts 2\n    -- the same shape tenant zero's own #651 reads (1 approve, 1 merge).\"\"\"\n    root = build_merged_item(tmp_path)\n\n    run = run_attavo(root, \"ledger\", \"1\", \"--json\")\n    assert run.returncode == 0, run.stdout + run.stderr\n    data = json.loads(run.stdout)\n\n    classes = [row[\"class\"] for row in data[\"rows\"]]\n    assert classes == [\"spec\", \"record\", \"approve\", \"change\", \"record\", \"record\", \"merge\"]\n    assert all(row[\"class\"] and row[\"sha\"] and row[\"identity\"] for row in data[\"rows\"])\n\n    summary = data[\"summary\"]\n    assert summary[\"operator_acts\"] == 2\n    assert summary[\"product_acts\"] == 3\n    assert summary[\"executor_commits\"] == 1\n    assert summary[\"stops\"] == 0\n    assert summary[\"since\"] == \"v0.19.1\"\n\n\ndef test_ledger_stops_count_matches_stops_including_a_gate_refusal(tmp_path: Path) -> None:\n    \"\"\"Issue #137, acceptance row 2. A refused spec-gate record and a\n    non-pass build record: ledger's own stops count is the same set\n    `attavo stops` counts, gate refusals included -- both computed by\n    item_stops, not two producers reading one item and printing\n    different numbers (tenant zero #683: stops printed 1, ledger printed\n    0, because ledger's own count only ever looked at build and verify).\n    \"\"\"\n    root = make_tenant(tmp_path, \"ledger_base\")\n    add_spec(root)\n\n    write_record(root, \"1\", \"spec\", 1,\n                {\"status\": \"refused\",\n                 \"refusal\": \"criterion fails against the tree plus stub: \"\n                            \"doctor-template-absent.sh\"})\n    write_record(root, \"1\", \"build\", 1, {\"status\": \"failed\"})\n\n    ledger_run = run_attavo(root, \"ledger\", \"1\", \"--json\")\n    assert ledger_run.returncode == 0, ledger_run.stdout + ledger_run.stderr\n    stops_run = run_attavo(root, \"stops\", \"1\", \"--json\")\n    assert stops_run.returncode == 0, stops_run.stdout + stops_run.stderr\n\n    ledger_data = json.loads(ledger_run.stdout)\n    stops_data = json.loads(stops_run.stdout)\n\n    assert len(stops_data[\"rows\"]) == 2\n    assert ledger_data[\"summary\"][\"stops\"] == len(stops_data[\"rows\"])\n\n\ndef test_ledger_marks_a_pre_v018_record_commit_as_record_or_launch(tmp_path: Path) -> None:\n    \"\"\"Acceptance row 2: a person's record commit before v0.18.0 prints\n    record-or-launch with the note, never launch or record -- before that\n    version the driver and the executor had no identity of their own to\n    tell a genuine launch apart from an automated one.\"\"\"\n    root = make_tenant(tmp_path, \"ledger_base\")\n    add_spec(root)\n\n    rel = write_record(root, \"1\", \"build\", 1, {\"status\": \"pass\", \"product_version\": \"v0.17.0\"})\n    person_sha = commit_as(root, PERSON, \"manual build record for item 1\", [rel])\n\n    run = run_attavo(root, \"ledger\", \"1\", \"--json\")\n    assert run.returncode == 0, run.stdout + run.stderr\n    data = json.loads(run.stdout)\n\n    row = next(r for r in data[\"rows\"] if r[\"sha\"] == person_sha)\n    assert row[\"class\"] == \"record-or-launch\"\n    assert row[\"note\"] == \"not distinguishable before v0.18.0\"\n    assert data[\"summary\"][\"operator_acts\"] == 0\n    assert data[\"summary\"][\"product_acts\"] == 0\n\n\ndef test_ledger_classifies_an_invocation_marker_commit_as_a_product_record(tmp_path: Path) -> None:\n    \"\"\"Issue #151: the invocation marker's own commit, authored by the\n    driver identity, touches paths.records without matching a stage\n    record's own NN.json name -- classified \"record\", the product's own\n    act, never \"transport\". Otherwise the same order build_merged_item\n    sets up, with the marker's own commit landing just ahead of the\n    build record it precedes in a real drive run.\"\"\"\n    root = make_tenant(tmp_path, \"ledger_base\")\n    git(root, \"checkout\", \"-b\", \"item\")\n\n    spec_sha = add_spec(root, \"1\")\n\n    rel = write_record(root, \"1\", \"spec\", 1,\n                       {\"status\": \"pass\", \"spec_sha\": spec_sha, \"product_version\": \"v0.19.1\"})\n    commit_as(root, RECORDS_APP, \"attavo: spec-gate record for item 1\", [rel])\n\n    rel = write_record(root, \"1\", \"approval\", 1,\n                       {\"approved_by\": \"alice\", \"sha\": spec_sha, \"spec_sha\": spec_sha,\n                        \"product_version\": \"v0.19.1\"})\n    commit_as(root, RECORDS_APP, \"attavo: approval record for item 1\", [rel])\n\n    marker_dir = root / \"records\" / \"1\"\n    marker_dir.mkdir(parents=True, exist_ok=True)\n    marker = marker_dir / \"build-01.started\"\n    marker.write_text(json.dumps({\"at\": \"2026-01-01T00:00:00Z\", \"host\": \"h\", \"pid\": 1,\n                                  \"sha\": spec_sha, \"product_version\": \"v0.19.1\"}))\n    marker_sha = commit_as(root, DRIVER, \"attavo: build invocation 01 started for item 1\",\n                           [str(marker.relative_to(root))])\n\n    (root / \"built.txt\").write_text(\"built\\n\")\n    commit_as(root, EXECUTOR, \"fixture: build item 1\", [\"built.txt\"])\n\n    rel = write_record(root, \"1\", \"build\", 1, {\"status\": \"pass\", \"product_version\": \"v0.19.1\"})\n    commit_as(root, DRIVER, \"attavo: build record for item 1 (build-01)\", [rel])\n\n    rel = write_record(root, \"1\", \"verify\", 1, {\"status\": \"pass\", \"product_version\": \"v0.19.1\"})\n    commit_as(root, DRIVER, \"attavo: verify record for item 1 (verify-01)\", [rel])\n\n    git(root, \"checkout\", \"main\")\n    subprocess.run([\"git\", \"-C\", str(root), \"merge\", \"--no-ff\", \"item\",\n                    \"-m\", \"Merge pull request #1 from x/item\"], check=True)\n\n    run = run_attavo(root, \"ledger\", \"1\", \"--json\")\n    assert run.returncode == 0, run.stdout + run.stderr\n    data = json.loads(run.stdout)\n\n    row = next(r for r in data[\"rows\"] if r[\"sha\"] == marker_sha)\n    assert row[\"class\"] == \"record\"\n\n    classes = [r[\"class\"] for r in data[\"rows\"]]\n    assert classes == [\"spec\", \"record\", \"approve\", \"record\", \"change\", \"record\", \"record\", \"merge\"]\n    assert data[\"summary\"][\"product_acts\"] == 4\n    assert data[\"summary\"][\"operator_acts\"] == 2\n\n\ndef test_ledger_json_is_one_object_matching_the_text_forms_numbers(tmp_path: Path) -> None:\n    \"\"\"Acceptance row 3: --json is one object with rows and summary, and\n    the text form prints the same numbers.\"\"\"\n    root = build_merged_item(tmp_path)\n\n    run_json = run_attavo(root, \"ledger\", \"1\", \"--json\")\n    assert run_json.returncode == 0, run_json.stdout + run_json.stderr\n    data = json.loads(run_json.stdout)\n    assert set(data) == {\"item\", \"rows\", \"summary\"}\n    assert isinstance(data[\"rows\"], list)\n    assert isinstance(data[\"summary\"], dict)\n\n    run_text = run_attavo(root, \"ledger\", \"1\")\n    assert run_text.returncode == 0, run_text.stdout + run_text.stderr\n    summary = data[\"summary\"]\n    assert f\"operator acts: {summary['operator_acts']}\" in run_text.stdout\n    assert f\"product acts: {summary['product_acts']}\" in run_text.stdout\n    assert f\"executor commits: {summary['executor_commits']}\" in run_text.stdout\n    assert f\"stops: {summary['stops']}\" in run_text.stdout\n    assert f\"since: {summary['since']}\" in run_text.stdout\n","numLines":248,"startLine":1,"totalLines":248}},"tool_result_meta":[{"id":"toolu_019xuYKcQ4N42nEMFKg4yRgz","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XCFKo4cWNbZ7UzAj9BFy1D","type":"tool_result","content":"1\tfrom __future__ import annotations\n2\t\n3\timport json\n4\timport re\n5\timport subprocess\n6\timport sys\n7\timport tempfile\n8\tfrom datetime import datetime, timezone\n9\tfrom pathlib import Path\n10\tfrom typing import Any\n11\t\n12\tfrom attavo.build import commits_with_diffs, driver_identity\n13\tfrom attavo.common import MANIFEST, STAGES, git, read_manifest, git_env\n14\tfrom attavo.doctor import INVOCATION_MARKER_SUFFIX, _merges_reachable, merge_introducing_records\n15\tfrom attavo.records import RECORD_RE, _load_record\n16\tfrom attavo.stops import item_stops\n17\tfrom attavo import Command\n18\t\n19\t# --- ledger: every act on an item by identity and class (issue #128) ---\n20\t\n21\t# operator acts (a person's own decisions and transport) vs. product acts\n22\t# (the driver's or the records app's own automated commits) vs. the\n23\t# executor's own code changes -- the three totals the plan's status table\n24\t# and every reviewing session used to count by hand. record-or-launch\n25\t# (below) contributes to neither: an honest count never guesses which\n26\t# side of that line a pre-v0.18.0 commit falls on.\n27\tLEDGER_OPERATOR_CLASSES = (\"approve\", \"amend\", \"launch\", \"transport\", \"merge\")\n28\t\n29\tLEDGER_V018_CUTOFF = (0, 18, 0)\n30\t\n31\t\n32\tdef _semver_tuple(version: str | None) -> tuple[int, int, int] | None:\n33\t    m = re.match(r\"^v(\\d+)\\.(\\d+)\\.(\\d+)\", version or \"\")\n34\t    return (int(m.group(1)), int(m.group(2)), int(m.group(3))) if m else None\n35\t\n36\t\n37\tdef _is_records_app(name: str) -> bool:\n38\t    \"\"\"The forge's own app-bot login -- exactly the identity the\n39\t    attavo-spec-gate and attavo-approve templates commit spec-gate and\n40\t    approval records as (an app-token step mints it at run time from the\n41\t    tenant's own app credentials): \"<app-slug>[bot]\". Never a name this\n42\t    product can name in advance, so the one fact it can check is the\n43\t    shape the forge itself gives every app identity, not a specific one.\"\"\"\n44\t    return name.endswith(\"[bot]\")\n45\t\n46\t\n47\tdef first_commit_touching(root: Path, relpath: str) -> str | None:\n48\t    \"\"\"The earliest commit touching relpath -- the mirror of\n49\t    last_commit_touching, which answers the latest. Ledger's own walk\n50\t    starts here: the item's first spec commit.\"\"\"\n51\t    out = git(root, \"log\", \"--reverse\", \"--format=%H\", \"--\", relpath)\n52\t    lines = out.split()\n53\t    return lines[0] if lines else None\n54\t\n55\t\n56\tdef _single_commit_with_diff(root: Path, sha: str) -> dict[str, Any]:\n57\t    \"\"\"commits_with_diffs's own shape, for one commit read directly rather\n58\t    than by a range -- the one case `_commits_from` needs it for: a\n59\t    commit with no parent, which `^` cannot name.\"\"\"\n60\t    out = git(root, \"show\", \"--diff-merges=first-parent\", \"--name-only\",\n61\t             \"--format=\\x01%H\\x1f%an\\x1f%ae\", sha)\n62\t    header, _, rest = out.split(\"\\x01\")[1].partition(\"\\n\")\n63\t    c_sha, name, email = header.split(\"\\x1f\")\n64\t    return {\"sha\": c_sha, \"name\": name, \"email\": email,\n65\t           \"touched\": [line for line in rest.splitlines() if line.strip()]}\n66\t\n67\t\n68\tdef _commits_from(root: Path, first_sha: str, end: str) -> list[dict[str, Any]]:\n69\t    \"\"\"commits_with_diffs's own range, from first_sha up to and including\n70\t    end: first_sha^..end, the ordinary case. `^` cannot name the parent of\n71\t    a commit that has none -- the repository's own root commit, which a\n72\t    fixture or a squash merge can leave as an item's first spec commit --\n73\t    and `A..B` always excludes A regardless, root or not; here, first_sha's\n74\t    own diff is read directly and put first.\"\"\"\n75\t    try:\n76\t        git(root, \"rev-parse\", \"--verify\", f\"{first_sha}^\")\n77\t    except RuntimeError:\n78\t        return [_single_commit_with_diff(root, first_sha)] + commits_with_diffs(root, first_sha, end=end)\n79\t    return commits_with_diffs(root, f\"{first_sha}^\", end=end)\n80\t\n81\t\n82\tdef _record_blobs_at(root: Path, specs: list[tuple[str, str]], item_id: str) -> dict[tuple[str, str], dict[str, Any]]:\n83\t    \"\"\"{(sha, relpath): record dict} for every (sha, relpath) pair, read by\n84\t    one `git cat-file --batch` process for the whole list rather than one\n85\t    `git show` per record (issue #153, ledger's only need for a record at a\n86\t    past commit rather than the working tree -- issue #128). Each blob is\n87\t    still spilled to a throwaway file and read through _load_record (issue\n88\t    #60, acceptance 6: the one place a record's bytes become a dict),\n89\t    rather than a second json.loads of its own. A pair git cannot resolve,\n90\t    or whose blob is not valid JSON, is simply absent from the result --\n91\t    the same silence _record_at once gave a missing blob.\"\"\"\n92\t    if not specs:\n93\t        return {}\n94\t    stdin = \"\".join(f\"{sha}:{relpath}\\n\" for sha, relpath in specs)\n95\t    out = subprocess.run([\"git\", \"-C\", str(root), \"cat-file\", \"--batch\"],\n96\t                         input=stdin.encode(), capture_output=True, check=False, env=git_env())\n97\t    data = out.stdout\n98\t    pos = 0\n99\t    result: dict[tuple[str, str], dict[str, Any]] = {}\n100\t    for key in specs:\n101\t        newline = data.index(b\"\\n\", pos)\n102\t        header = data[pos:newline].decode()\n103\t        pos = newline + 1\n104\t        parts = header.split(\" \")\n105\t        if parts[-1] == \"missing\":\n106\t            continue\n107\t        size = int(parts[-1])\n108\t        content = data[pos:pos + size]\n109\t        pos += size + 1\n110\t        with tempfile.NamedTemporaryFile(\"wb\", suffix=\".json\", delete=False) as fh:\n111\t            fh.write(content)\n112\t            blob_path = Path(fh.name)\n113\t        try:\n114\t            result[key] = _load_record(blob_path, item_id)\n115\t        except json.JSONDecodeError:\n116\t            continue\n117\t        finally:\n118\t            blob_path.unlink(missing_ok=True)\n119\t    return result\n120\t\n121\t\n122\tdef item_ledger(root: Path, m: dict[str, Any], item_id: str, merges: list[dict[str, Any]] | None = None) -> dict[str, Any]:\n123\t    \"\"\"{\"item\", \"rows\", \"summary\"}: one row per act between item_id's first\n124\t    spec commit and its merge (merge_introducing_records, the same\n125\t    derivation doctor's proof two and attest both already read) or HEAD\n126\t    when the item has not merged yet.\n127\t\n128\t    merges, when given, is _merges_reachable's own result -- cmd_ledger\n129\t    computes it once and passes it here for every item, rather than each\n130\t    item walking HEAD's merges again (issue #153).\n131\t\n132\t    Each commit gets exactly one class, in this order: the merge commit\n133\t    itself is \"merge\"; a commit authored by the executor identity\n134\t    (executor_identity) is \"change\"; a commit introducing an approval\n135\t    record is \"approve\", whoever committed it -- an operator's decision,\n136\t    however it reached git; a commit introducing a spec-gate, build, or\n137\t    verify record, authored by the driver identity (driver_identity) or\n138\t    the records app, is \"record\"; the same, authored by a person, is\n139\t    \"launch\" for build or verify (spec-gate records the app always\n140\t    commits, in every template this product ships) -- unless that\n141\t    record's own product_version predates v0.18.0, when driver_identity\n142\t    did not yet exist to tell the two apart, and the row is\n143\t    \"record-or-launch\" with a note, counted in neither summary total\n144\t    rather than guessed; a person's commit touching the spec is \"spec\"\n145\t    before the first approval record and \"amend\" after; anything else by\n146\t    a person is \"transport\" (a merge of main among them).\"\"\"\n147\t    specs_rel = m[\"paths\"][\"specs\"]\n148\t    records_rel = m[\"paths\"][\"records\"]\n149\t    specs_prefix = f\"{specs_rel.rstrip('/')}/{item_id}/\"\n150\t    records_prefix = f\"{records_rel.rstrip('/')}/{item_id}/\"\n151\t    empty_summary = {\"operator_acts\": 0, \"product_acts\": 0, \"executor_commits\": 0,\n152\t                     \"stops\": 0, \"since\": None}\n153\t\n154\t    first_spec_sha = first_commit_touching(root, str(Path(specs_rel) / item_id))\n155\t    if first_spec_sha is None:\n156\t        return {\"item\": item_id, \"rows\": [], \"summary\": empty_summary}\n157\t\n158\t    if merges is None:\n159\t        merges, refusal = _merges_reachable(root)\n160\t        if refusal:\n161\t            return {\"item\": item_id, \"rows\": [], \"summary\": empty_summary}\n162\t    merge_sha, _ = merge_introducing_records(root, records_rel, item_id, STAGES, merges=merges)\n163\t    if merge_sha is not None:\n164\t        branch_tip = next(mrg[\"parents\"][1] for mrg in merges if mrg[\"sha\"] == merge_sha)\n165\t        commits = _commits_from(root, first_spec_sha, branch_tip)\n166\t        commits += commits_with_diffs(root, f\"{merge_sha}^1\", end=merge_sha)\n167\t    else:\n168\t        commits = _commits_from(root, first_spec_sha, \"HEAD\")\n169\t\n170\t    driver = driver_identity()\n171\t\n172\t    # Every record a walked commit touches, read by one batched process\n173\t    # for the whole item rather than one `git show` per record (issue\n174\t    # #153): a first pass over the already-fetched diffs finds which\n175\t    # commits touch a record, then _record_blobs_at fetches them all.\n176\t    record_touches: dict[str, tuple[str, str]] = {}\n177\t    for c in commits:\n178\t        if merge_sha is not None and c[\"sha\"] == merge_sha:\n179\t            continue\n180\t        if c[\"email\"].startswith(\"executor+\") and c[\"email\"].endswith(\"@attavo.invalid\"):\n181\t            continue\n182\t        for p in c[\"touched\"]:\n183\t            if not p.startswith(records_prefix):\n184\t                continue\n185\t            rm = RECORD_RE.match(Path(p).name)\n186\t            if rm and rm.group(1) in STAGES:\n187\t                record_touches[c[\"sha\"]] = (rm.group(1), p)\n188\t                break\n189\t    record_content = _record_blobs_at(\n190\t        root, [(sha, relpath) for sha, (_, relpath) in record_touches.items()], item_id)\n191\t\n192\t    rows: list[dict[str, Any]] = []\n193\t    operator_acts = product_acts = executor_commits = 0\n194\t    since = None\n195\t    approval_seen = False\n196\t\n197\t    for c in commits:\n198\t        sha, name, email = c[\"sha\"], c[\"name\"], c[\"email\"]\n199\t\n200\t        if merge_sha is not None and sha == merge_sha:\n201\t            rows.append({\"sha\": sha, \"identity\": name, \"class\": \"merge\"})\n202\t            operator_acts += 1\n203\t            continue\n204\t\n205\t        if email.startswith(\"executor+\") and email.endswith(\"@attavo.invalid\"):\n206\t            rows.append({\"sha\": sha, \"identity\": name, \"class\": \"change\"})\n207\t            executor_commits += 1\n208\t            continue\n209\t\n210\t        record_touch = record_touches.get(sha)\n211\t\n212\t        if record_touch is not None:\n213\t            stage, relpath = record_touch\n214\t            content = record_content.get((sha, relpath), {})\n215\t            if since is None:\n216\t                since = content.get(\"product_version\")\n217\t\n218\t            if stage == \"approval\":\n219\t                rows.append({\"sha\": sha, \"identity\": name, \"class\": \"approve\"})\n220\t                operator_acts += 1\n221\t                approval_seen = True\n222\t                continue\n223\t\n224\t            is_driver = name == driver[\"name\"] and email == driver[\"email\"]\n225\t            is_records_app = _is_records_app(name)\n226\t            if stage == \"spec\" or is_driver or is_records_app:\n227\t                rows.append({\"sha\": sha, \"identity\": name, \"class\": \"record\"})\n228\t                product_acts += 1\n229\t                continue\n230\t\n231\t            version = _semver_tuple(content.get(\"product_version\"))\n232\t            if version is not None and version < LEDGER_V018_CUTOFF:\n233\t                rows.append({\"sha\": sha, \"identity\": name, \"class\": \"record-or-launch\",\n234\t                            \"note\": \"not distinguishable before v0.18.0\"})\n235\t                continue\n236\t\n237\t            rows.append({\"sha\": sha, \"identity\": name, \"class\": \"launch\"})\n238\t            operator_acts += 1\n239\t            continue\n240\t\n241\t        # An invocation marker's own commit (proof five): the product's\n242\t        # act, never the operator's.\n243\t        if any(p.startswith(records_prefix) and p.endswith(INVOCATION_MARKER_SUFFIX)\n244\t               for p in c[\"touched\"]):\n245\t            rows.append({\"sha\": sha, \"identity\": name, \"class\": \"record\"})\n246\t            product_acts += 1\n247\t            continue\n248\t\n249\t        if any(p.startswith(specs_prefix) for p in c[\"touched\"]):\n250\t            cls = \"amend\" if approval_seen else \"spec\"\n251\t            rows.append({\"sha\": sha, \"identity\": name, \"class\": cls})\n252\t            if cls == \"amend\":\n253\t                operator_acts += 1\n254\t            continue\n255\t\n256\t        rows.append({\"sha\": sha, \"identity\": name, \"class\": \"transport\"})\n257\t        operator_acts += 1\n258\t\n259\t    # issue #137: the same set attavo stops counts, from the same reader\n260\t    # (item_stops) -- not a second, independent count kept in sync by\n261\t    # hand. One non-pass record per row, whatever its stage; a gate\n262\t    # refusal is included the same as a non-pass build or verify record.\n263\t    stops = len(item_stops(root, m, item_id)[\"rows\"])\n264\t\n265\t    summary = {\"operator_acts\": operator_acts, \"product_acts\": product_acts,\n266\t              \"executor_commits\": executor_commits, \"stops\": stops, \"since\": since}\n267\t    return {\"item\": item_id, \"rows\": rows, \"summary\": summary}\n268\t\n269\t\n270\t# The statement's own two lists (issue #349): acts is the operator's ruled\n271\t# acts (approve, merge); rule stays in the schema's enum for the ruling\n272\t# record (#276) and is never produced here. interventions is every other\n273\t# operator row -- amend, launch, transport.\n274\tACT_CLASSES = (\"approve\", \"merge\")\n275\tINTERVENTION_CLASSES = (\"amend\", \"launch\", \"transport\")\n276\t\n277\t\n278\tdef _committer_time_iso(root: Path, shas: list[str]) -> dict[str, str]:\n279\t    \"\"\"Each sha's own committer time, in the same shape attest's own `at`\n280\t    fields already carry -- one `git show` process for every sha an\n281\t    item's acts and interventions need, not one git call per row.\"\"\"\n282\t    if not shas:\n283\t        return {}\n284\t    out = git(root, \"show\", \"-s\", \"--format=%H\\x1f%ct\", *shas)\n285\t    times: dict[str, str] = {}\n286\t    for line in out.splitlines():\n287\t        if not line.strip():\n288\t            continue\n289\t        sha, epoch = line.split(\"\\x1f\")\n290\t        times[sha] = datetime.fromtimestamp(int(epoch), timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n291\t    return times\n292\t\n293\t\n294\tdef item_acts_and_interventions(root: Path, m: dict[str, Any], item_id: str,\n295\t                                merges: list[dict[str, Any]] | None = None\n296\t                                ) -> tuple[list[dict[str, Any]], list[dict[str, Any]]]:\n297\t    \"\"\"(acts, interventions): the statement's own two lists, read from\n298\t    item_ledger's own rows between the item's first spec commit and its\n299\t    merge -- each commit classed exactly once there, never classified\n300\t    twice. acts carries every approve and merge row as {act, sha, by, at};\n301\t    interventions carries every amend, launch, and transport row as\n302\t    {class, sha, by, at}. `by` is the commit's own author name\n303\t    (item_ledger's `identity`); `at` is its committer time.\"\"\"\n304\t    rows = item_ledger(root, m, item_id, merges=merges)[\"rows\"]\n305\t    act_rows = [r for r in rows if r[\"class\"] in ACT_CLASSES]\n306\t    intervention_rows = [r for r in rows if r[\"class\"] in INTERVENTION_CLASSES]\n307\t    times = _committer_time_iso(root, [r[\"sha\"] for r in act_rows + intervention_rows])\n308\t    acts = [{\"act\": r[\"class\"], \"sha\": r[\"sha\"], \"by\": r[\"identity\"], \"at\": times[r[\"sha\"]]}\n309\t           for r in act_rows]\n310\t    interventions = [{\"class\": r[\"class\"], \"sha\": r[\"sha\"], \"by\": r[\"identity\"], \"at\": times[r[\"sha\"]]}\n311\t                     for r in intervention_rows]\n312\t    return acts, interventions\n313\t\n314\t\n315\tdef cmd_ledger(argv: list[str]) -> int:\n316\t    as_json = \"--json\" in argv\n317\t    positional = [a for a in argv if a != \"--json\"]\n318\t    root = Path(\".\").resolve()\n319\t    m = read_manifest(root)\n320\t    if m is None:\n321\t        print(f\"attavo ledger: no {MANIFEST} at {root}\", file=sys.stderr)\n322\t        return 2\n323\t\n324\t    records_rel = m[\"paths\"][\"records\"]\n325\t    if positional:\n326\t        item_ids = [positional[0]]\n327\t    else:\n328\t        records_root = root / records_rel\n329\t        item_ids = (sorted((p.name for p in records_root.iterdir() if p.is_dir()))\n330\t                   if records_root.is_dir() else [])\n331\t\n332\t    # Computed once for every item in this read, not once per item (issue\n333\t    # #153): the default branch's merges do not depend on which item is\n334\t    # being asked about.\n335\t    merges, refusal = _merges_reachable(root)\n336\t    if refusal:\n337\t        print(f\"attavo ledger: refused: {refusal}\", file=sys.stderr)\n338\t        return 2\n339\t    ledgers = [item_ledger(root, m, item_id, merges=merges) for item_id in item_ids]\n340\t\n341\t    if as_json:\n342\t        if positional:\n343\t            print(json.dumps(ledgers[0], indent=2))\n344\t        else:\n345\t            print(json.dumps({\"items\": ledgers}, indent=2))\n346\t        return 0\n347\t\n348\t    for entry in ledgers:\n349\t        print(f\"attavo ledger: item {entry['item']}\")\n350\t        for row in entry[\"rows\"]:\n351\t            note = f\"  ({row['note']})\" if \"note\" in row else \"\"\n352\t            print(f\"  {row['sha'][:12]}  {row['identity']:<32}  {row['class']}{note}\")\n353\t        s = entry[\"summary\"]\n354\t        print(f\"  operator acts: {s['operator_acts']}  product acts: {s['product_acts']}  \"\n355\t             f\"executor commits: {s['executor_commits']}  stops: {s['stops']}  \"\n356\t             f\"since: {s['since']}\")\n357\t    if not ledgers:\n358\t        print(f\"attavo ledger: no item found under {records_rel}\")\n359\t    return 0\n360\t\n361\t\n362\tCOMMANDS = (\n363\t    Command(\n364\t        name='ledger',\n365\t        run=cmd_ledger,\n366\t        usage=('attavo ledger [N] [--json]',),\n367\t        rank=140,\n368\t        help=(\n369\t            (250, \"\"\"\\\n370\tledger reads, never writes. For item N (or every item under\n371\tpaths.records when N is omitted), it walks the commits from the item's\n372\tfirst spec commit to its merge (the same derivation doctor's proof two\n373\tand attest use) or to HEAD when the item has not merged, and prints one\n374\trow per act: the sha, the identity as git names it, and a class from a\n375\tclosed list -- spec, amend, approve, launch, record, change, transport,\n376\tmerge -- derived from who committed it and, for an approval, build, or\n377\tverify record, what the record itself says. A summary line follows:\n378\toperator acts (approve, amend, launch, transport, merge), product acts\n379\t(record), executor commits (change), stops (non-pass records), and\n380\tsince (the product version on the first record). A build or verify\n381\trecord's own commit, from before v0.18.0 gave the driver and the\n382\texecutor their own identities, prints as record-or-launch with a note,\n383\tcounted toward neither total, rather than guessed. --json prints the\n384\trows and the summary as one object. See issue #128's lane for the full\n385\trules it enforces.\"\"\"),\n386\t        ),\n387\t    ),\n388\t)\n389\t"}]},"parent_tool_use_id":null,"session_id":"0a5d4e4f-a8ec-461c-a70f-8d166fde6be5","uuid":"c7922851-02d3-40a7-88a1-e17229aebdc1","timestamp":"2026-10-15T15:11:36.575Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-350/attavo/ledger.py","content":"from __future__ import annotations\n\nimport json\nimport re\nimport subprocess\nimport sys\nimport tempfile\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom typing import Any\n\nfrom attavo.build import commits_with_diffs, driver_identity\nfrom attavo.common import MANIFEST, STAGES, git, read_manifest, git_env\nfrom attavo.doctor import INVOCATION_MARKER_SUFFIX, _merges_reachable, merge_introducing_records\nfrom attavo.records import RECORD_RE, _load_record\nfrom attavo.stops import item_stops\nfrom attavo import Command\n\n# --- ledger: every act on an item by identity and class (issue #128) ---\n\n# operator acts (a person's own decisions and transport) vs. product acts\n# (the driver's or the records app's own automated commits) vs. the\n# executor's own code changes -- the three totals the plan's status table\n# and every reviewing session used to count by hand. record-or-launch\n# (below) contributes to neither: an honest count never guesses which\n# side of that line a pre-v0.18.0 commit falls on.\nLEDGER_OPERATOR_CLASSES = (\"approve\", \"amend\", \"launch\", \"transport\", \"merge\")\n\nLEDGER_V018_CUTOFF = (0, 18, 0)\n\n\ndef _semver_tuple(version: str | None) -> tuple[int, int, int] | None:\n    m = re.match(r\"^v(\\d+)\\.(\\d+)\\.(\\d+)\", version or \"\")\n    return (int(m.group(1)), int(m.group(2)), int(m.group(3))) if m else None\n\n\ndef _is_records_app(name: str) -> bool:\n    \"\"\"The forge's own app-bot login -- exactly the identity the\n    attavo-spec-gate and attavo-approve templates commit spec-gate and\n    approval records as (an app-token step mints it at run time from the\n    tenant's own app credentials): \"<app-slug>[bot]\". Never a name this\n    product can name in advance, so the one fact it can check is the\n    shape the forge itself gives every app identity, not a specific one.\"\"\"\n    return name.endswith(\"[bot]\")\n\n\ndef first_commit_touching(root: Path, relpath: str) -> str | None:\n    \"\"\"The earliest commit touching relpath -- the mirror of\n    last_commit_touching, which answers the latest. Ledger's own walk\n    starts here: the item's first spec commit.\"\"\"\n    out = git(root, \"log\", \"--reverse\", \"--format=%H\", \"--\", relpath)\n    lines = out.split()\n    return lines[0] if lines else None\n\n\ndef _single_commit_with_diff(root: Path, sha: str) -> dict[str, Any]:\n    \"\"\"commits_with_diffs's own shape, for one commit read directly rather\n    than by a range -- the one case `_commits_from` needs it for: a\n    commit with no parent, which `^` cannot name.\"\"\"\n    out = git(root, \"show\", \"--diff-merges=first-parent\", \"--name-only\",\n             \"--format=\\x01%H\\x1f%an\\x1f%ae\", sha)\n    header, _, rest = out.split(\"\\x01\")[1].partition(\"\\n\")\n    c_sha, name, email = header.split(\"\\x1f\")\n    return {\"sha\": c_sha, \"name\": name, \"email\": email,\n           \"touched\": [line for line in rest.splitlines() if line.strip()]}\n\n\ndef _commits_from(root: Path, first_sha: str, end: str) -> list[dict[str, Any]]:\n    \"\"\"commits_with_diffs's own range, from first_sha up to and including\n    end: first_sha^..end, the ordinary case. `^` cannot name the parent of\n    a commit that has none -- the repository's own root commit, which a\n    fixture or a squash merge can leave as an item's first spec commit --\n    and `A..B` always excludes A regardless, root or not; here, first_sha's\n    own diff is read directly and put first.\"\"\"\n    try:\n        git(root, \"rev-parse\", \"--verify\", f\"{first_sha}^\")\n    except RuntimeError:\n        return [_single_commit_with_diff(root, first_sha)] + commits_with_diffs(root, first_sha, end=end)\n    return commits_with_diffs(root, f\"{first_sha}^\", end=end)\n\n\ndef _record_blobs_at(root: Path, specs: list[tuple[str, str]], item_id: str) -> dict[tuple[str, str], dict[str, Any]]:\n    \"\"\"{(sha, relpath): record dict} for every (sha, relpath) pair, read by\n    one `git cat-file --batch` process for the whole list rather than one\n    `git show` per record (issue #153, ledger's only need for a record at a\n    past commit rather than the working tree -- issue #128). Each blob is\n    still spilled to a throwaway file and read through _load_record (issue\n    #60, acceptance 6: the one place a record's bytes become a dict),\n    rather than a second json.loads of its own. A pair git cannot resolve,\n    or whose blob is not valid JSON, is simply absent from the result --\n    the same silence _record_at once gave a missing blob.\"\"\"\n    if not specs:\n        return {}\n    stdin = \"\".join(f\"{sha}:{relpath}\\n\" for sha, relpath in specs)\n    out = subprocess.run([\"git\", \"-C\", str(root), \"cat-file\", \"--batch\"],\n                         input=stdin.encode(), capture_output=True, check=False, env=git_env())\n    data = out.stdout\n    pos = 0\n    result: dict[tuple[str, str], dict[str, Any]] = {}\n    for key in specs:\n        newline = data.index(b\"\\n\", pos)\n        header = data[pos:newline].decode()\n        pos = newline + 1\n        parts = header.split(\" \")\n        if parts[-1] == \"missing\":\n            continue\n        size = int(parts[-1])\n        content = data[pos:pos + size]\n        pos += size + 1\n        with tempfile.NamedTemporaryFile(\"wb\", suffix=\".json\", delete=False) as fh:\n            fh.write(content)\n            blob_path = Path(fh.name)\n        try:\n            result[key] = _load_record(blob_path, item_id)\n        except json.JSONDecodeError:\n            continue\n        finally:\n            blob_path.unlink(missing_ok=True)\n    return result\n\n\ndef item_ledger(root: Path, m: dict[str, Any], item_id: str, merges: list[dict[str, Any]] | None = None) -> dict[str, Any]:\n    \"\"\"{\"item\", \"rows\", \"summary\"}: one row per act between item_id's first\n    spec commit and its merge (merge_introducing_records, the same\n    derivation doctor's proof two and attest both already read) or HEAD\n    when the item has not merged yet.\n\n    merges, when given, is _merges_reachable's own result -- cmd_ledger\n    computes it once and passes it here for every item, rather than each\n    item walking HEAD's merges again (issue #153).\n\n    Each commit gets exactly one class, in this order: the merge commit\n    itself is \"merge\"; a commit authored by the executor identity\n    (executor_identity) is \"change\"; a commit introducing an approval\n    record is \"approve\", whoever committed it -- an operator's decision,\n    however it reached git; a commit introducing a spec-gate, build, or\n    verify record, authored by the driver identity (driver_identity) or\n    the records app, is \"record\"; the same, authored by a person, is\n    \"launch\" for build or verify (spec-gate records the app always\n    commits, in every template this product ships) -- unless that\n    record's own product_version predates v0.18.0, when driver_identity\n    did not yet exist to tell the two apart, and the row is\n    \"record-or-launch\" with a note, counted in neither summary total\n    rather than guessed; a person's commit touching the spec is \"spec\"\n    before the first approval record and \"amend\" after; anything else by\n    a person is \"transport\" (a merge of main among them).\"\"\"\n    specs_rel = m[\"paths\"][\"specs\"]\n    records_rel = m[\"paths\"][\"records\"]\n    specs_prefix = f\"{specs_rel.rstrip('/')}/{item_id}/\"\n    records_prefix = f\"{records_rel.rstrip('/')}/{item_id}/\"\n    empty_summary = {\"operator_acts\": 0, \"product_acts\": 0, \"executor_commits\": 0,\n                     \"stops\": 0, \"since\": None}\n\n    first_spec_sha = first_commit_touching(root, str(Path(specs_rel) / item_id))\n    if first_spec_sha is None:\n        return {\"item\": item_id, \"rows\": [], \"summary\": empty_summary}\n\n    if merges is None:\n        merges, refusal = _merges_reachable(root)\n        if refusal:\n            return {\"item\": item_id, \"rows\": [], \"summary\": empty_summary}\n    merge_sha, _ = merge_introducing_records(root, records_rel, item_id, STAGES, merges=merges)\n    if merge_sha is not None:\n        branch_tip = next(mrg[\"parents\"][1] for mrg in merges if mrg[\"sha\"] == merge_sha)\n        commits = _commits_from(root, first_spec_sha, branch_tip)\n        commits += commits_with_diffs(root, f\"{merge_sha}^1\", end=merge_sha)\n    else:\n        commits = _commits_from(root, first_spec_sha, \"HEAD\")\n\n    driver = driver_identity()\n\n    # Every record a walked commit touches, read by one batched process\n    # for the whole item rather than one `git show` per record (issue\n    # #153): a first pass over the already-fetched diffs finds which\n    # commits touch a record, then _record_blobs_at fetches them all.\n    record_touches: dict[str, tuple[str, str]] = {}\n    for c in commits:\n        if merge_sha is not None and c[\"sha\"] == merge_sha:\n            continue\n        if c[\"email\"].startswith(\"executor+\") and c[\"email\"].endswith(\"@attavo.invalid\"):\n            continue\n        for p in c[\"touched\"]:\n            if not p.startswith(records_prefix):\n                continue\n            rm = RECORD_RE.match(Path(p).name)\n            if rm and rm.group(1) in STAGES:\n                record_touches[c[\"sha\"]] = (rm.group(1), p)\n                break\n    record_content = _record_blobs_at(\n        root, [(sha, relpath) for sha, (_, relpath) in record_touches.items()], item_id)\n\n    rows: list[dict[str, Any]] = []\n    operator_acts = product_acts = executor_commits = 0\n    since = None\n    approval_seen = False\n\n    for c in commits:\n        sha, name, email = c[\"sha\"], c[\"name\"], c[\"email\"]\n\n        if merge_sha is not None and sha == merge_sha:\n            rows.append({\"sha\": sha, \"identity\": name, \"class\": \"merge\"})\n            operator_acts += 1\n            continue\n\n        if email.startswith(\"executor+\") and email.endswith(\"@attavo.invalid\"):\n            rows.append({\"sha\": sha, \"identity\": name, \"class\": \"change\"})\n            executor_commits += 1\n            continue\n\n        record_touch = record_touches.get(sha)\n\n        if record_touch is not None:\n            stage, relpath = record_touch\n            content = record_content.get((sha, relpath), {})\n            if since is None:\n                since = content.get(\"product_version\")\n\n            if stage == \"approval\":\n                rows.append({\"sha\": sha, \"identity\": name, \"class\": \"approve\"})\n                operator_acts += 1\n                approval_seen = True\n                continue\n\n            is_driver = name == driver[\"name\"] and email == driver[\"email\"]\n            is_records_app = _is_records_app(name)\n            if stage == \"spec\" or is_driver or is_records_app:\n                rows.append({\"sha\": sha, \"identity\": name, \"class\": \"record\"})\n                product_acts += 1\n                continue\n\n            version = _semver_tuple(content.get(\"product_version\"))\n            if version is not None and version < LEDGER_V018_CUTOFF:\n                rows.append({\"sha\": sha, \"identity\": name, \"class\": \"record-or-launch\",\n                            \"note\": \"not distinguishable before v0.18.0\"})\n                continue\n\n            rows.append({\"sha\": sha, \"identity\": name, \"class\": \"launch\"})\n            operator_acts += 1\n            continue\n\n        # An invocation marker's own commit (proof five): the product's\n        # act, never the operator's.\n        if any(p.startswith(records_prefix) and p.endswith(INVOCATION_MARKER_SUFFIX)\n               for p in c[\"touched\"]):\n            rows.append({\"sha\": sha, \"identity\": name, \"class\": \"record\"})\n            product_acts += 1\n            continue\n\n        if any(p.startswith(specs_prefix) for p in c[\"touched\"]):\n            cls = \"amend\" if approval_seen else \"spec\"\n            rows.append({\"sha\": sha, \"identity\": name, \"class\": cls})\n            if cls == \"amend\":\n                operator_acts += 1\n            continue\n\n        rows.append({\"sha\": sha, \"identity\": name, \"class\": \"transport\"})\n        operator_acts += 1\n\n    # issue #137: the same set attavo stops counts, from the same reader\n    # (item_stops) -- not a second, independent count kept in sync by\n    # hand. One non-pass record per row, whatever its stage; a gate\n    # refusal is included the same as a non-pass build or verify record.\n    stops = len(item_stops(root, m, item_id)[\"rows\"])\n\n    summary = {\"operator_acts\": operator_acts, \"product_acts\": product_acts,\n              \"executor_commits\": executor_commits, \"stops\": stops, \"since\": since}\n    return {\"item\": item_id, \"rows\": rows, \"summary\": summary}\n\n\n# The statement's own two lists (issue #349): acts is the operator's ruled\n# acts (approve, merge); rule stays in the schema's enum for the ruling\n# record (#276) and is never produced here. interventions is every other\n# operator row -- amend, launch, transport.\nACT_CLASSES = (\"approve\", \"merge\")\nINTERVENTION_CLASSES = (\"amend\", \"launch\", \"transport\")\n\n\ndef _committer_time_iso(root: Path, shas: list[str]) -> dict[str, str]:\n    \"\"\"Each sha's own committer time, in the same shape attest's own `at`\n    fields already carry -- one `git show` process for every sha an\n    item's acts and interventions need, not one git call per row.\"\"\"\n    if not shas:\n        return {}\n    out = git(root, \"show\", \"-s\", \"--format=%H\\x1f%ct\", *shas)\n    times: dict[str, str] = {}\n    for line in out.splitlines():\n        if not line.strip():\n            continue\n        sha, epoch = line.split(\"\\x1f\")\n        times[sha] = datetime.fromtimestamp(int(epoch), timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n    return times\n\n\ndef item_acts_and_interventions(root: Path, m: dict[str, Any], item_id: str,\n                                merges: list[dict[str, Any]] | None = None\n                                ) -> tuple[list[dict[str, Any]], list[dict[str, Any]]]:\n    \"\"\"(acts, interventions): the statement's own two lists, read from\n    item_ledger's own rows between the item's first spec commit and its\n    merge -- each commit classed exactly once there, never classified\n    twice. acts carries every approve and merge row as {act, sha, by, at};\n    interventions carries every amend, launch, and transport row as\n    {class, sha, by, at}. `by` is the commit's own author name\n    (item_ledger's `identity`); `at` is its committer time.\"\"\"\n    rows = item_ledger(root, m, item_id, merges=merges)[\"rows\"]\n    act_rows = [r for r in rows if r[\"class\"] in ACT_CLASSES]\n    intervention_rows = [r for r in rows if r[\"class\"] in INTERVENTION_CLASSES]\n    times = _committer_time_iso(root, [r[\"sha\"] for r in act_rows + intervention_rows])\n    acts = [{\"act\": r[\"class\"], \"sha\": r[\"sha\"], \"by\": r[\"identity\"], \"at\": times[r[\"sha\"]]}\n           for r in act_rows]\n    interventions = [{\"class\": r[\"class\"], \"sha\": r[\"sha\"], \"by\": r[\"identity\"], \"at\": times[r[\"sha\"]]}\n                     for r in intervention_rows]\n    return acts, interventions\n\n\ndef cmd_ledger(argv: list[str]) -> int:\n    as_json = \"--json\" in argv\n    positional = [a for a in argv if a != \"--json\"]\n    root = Path(\".\").resolve()\n    m = read_manifest(root)\n    if m is None:\n        print(f\"attavo ledger: no {MANIFEST} at {root}\", file=sys.stderr)\n        return 2\n\n    records_rel = m[\"paths\"][\"records\"]\n    if positional:\n        item_ids = [positional[0]]\n    else:\n        records_root = root / records_rel\n        item_ids = (sorted((p.name for p in records_root.iterdir() if p.is_dir()))\n                   if records_root.is_dir() else [])\n\n    # Computed once for every item in this read, not once per item (issue\n    # #153): the default branch's merges do not depend on which item is\n    # being asked about.\n    merges, refusal = _merges_reachable(root)\n    if refusal:\n        print(f\"attavo ledger: refused: {refusal}\", file=sys.stderr)\n        return 2\n    ledgers = [item_ledger(root, m, item_id, merges=merges) for item_id in item_ids]\n\n    if as_json:\n        if positional:\n            print(json.dumps(ledgers[0], indent=2))\n        else:\n            print(json.dumps({\"items\": ledgers}, indent=2))\n        return 0\n\n    for entry in ledgers:\n        print(f\"attavo ledger: item {entry['item']}\")\n        for row in entry[\"rows\"]:\n            note = f\"  ({row['note']})\" if \"note\" in row else \"\"\n            print(f\"  {row['sha'][:12]}  {row['identity']:<32}  {row['class']}{note}\")\n        s = entry[\"summary\"]\n        print(f\"  operator acts: {s['operator_acts']}  product acts: {s['product_acts']}  \"\n             f\"executor commits: {s['executor_commits']}  stops: {s['stops']}  \"\n             f\"since: {s['since']}\")\n    if not ledgers:\n        print(f\"attavo ledger: no item found under {records_rel}\")\n    return 0\n\n\nCOMMANDS = (\n    Command(\n        name='ledger',\n        run=cmd_ledger,\n        usage=('attavo ledger [N] [--json]',),\n        rank=140,\n        help=(\n            (250, \"\"\"\\\nledger reads, never writes. For item N (or every item under\npaths.records when N is omitted), it walks the commits from the item's\nfirst spec commit to its merge (the same derivation doctor's proof two\nand attest use) or to HEAD when the item has not merged, and prints one\nrow per act: the sha, the identity as git names it, and a class from a\nclosed list -- spec, amend, approve, launch, record, change, transport,\nmerge -- derived from who committed it and, for an approval, build, or\nverify record, what the record itself says. A summary line follows:\noperator acts (approve, amend, launch, transport, merge), product acts\n(record), executor commits (change), stops (non-pass records), and\nsince (the product version on the first record). A build or verify\nrecord's own commit, from before v0.18.0 gave the driver and the\nexecutor their own identities, prints as record-or-launch with a note,\ncounted toward neither total, rather than guessed. --json prints the\nrows and the summary as one object. See issue #128's lane for the full\nrules it enforces.\"\"\"),\n        ),\n    ),\n)\n","numLines":389,"startLine":1,"totalLines":389}},"tool_result_meta":[{"id":"toolu_01XCFKo4cWNbZ7UzAj9BFy1D","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LP3z2SNbbXxzQNgTquWMxK","type":"tool_result","content":"1\t#!/bin/sh\n2\t# Depends only on the product, tests/helpers.py and the standard library.\n3\t# exit 2: the scenario could not be set up; exit 1: a row does not name what its commit carries.\n4\texec python3 - \"$(pwd)\" <<'PY'\n5\timport json, os, shutil, subprocess, sys, tempfile\n6\tfrom pathlib import Path\n7\there = Path(sys.argv[1])\n8\tsys.path.insert(0, str(here / \"tests\"))\n9\ttmp = Path(tempfile.mkdtemp(prefix=\"attavo-350-\"))\n10\tPERSON = {\"name\": \"Alice Author\", \"email\": \"alice@example.com\"}\n11\tAPP = {\"name\": \"attavo-bot[bot]\", \"email\": \"123+attavo-bot[bot]@users.noreply.github.com\"}\n12\tDRIVER = {\"name\": \"attavo driver\", \"email\": \"driver@attavo.invalid\"}\n13\tEXECUTOR = {\"name\": \"attavo executor (fixture)\", \"email\": \"executor+fixture@attavo.invalid\"}\n14\tdef commit_as(root, who, msg, paths):\n15\t    subprocess.run([\"git\", \"-C\", str(root), \"add\", *paths], check=True)\n16\t    env = dict(os.environ, GIT_AUTHOR_NAME=who[\"name\"], GIT_COMMITTER_NAME=who[\"name\"],\n17\t               GIT_AUTHOR_EMAIL=who[\"email\"], GIT_COMMITTER_EMAIL=who[\"email\"])\n18\t    subprocess.run([\"git\", \"-C\", str(root), \"commit\", \"-q\", \"-m\", msg], check=True, env=env)\n19\t    return subprocess.run([\"git\", \"-C\", str(root), \"rev-parse\", \"HEAD\"], capture_output=True, text=True, check=True).stdout.strip()\n20\tdef record(root, stage, n, body):\n21\t    p = root / \"records\" / \"1\" / f\"{stage}-{n:02d}.json\"; p.parent.mkdir(parents=True, exist_ok=True)\n22\t    p.write_text(json.dumps(body)); return str(p.relative_to(root))\n23\ttry:\n24\t    from helpers import git, make_tenant\n25\t    root = make_tenant(tmp, \"ledger_base\")\n26\t    (root / \"attavo.toml\").write_text((root / \"attavo.toml\").read_text() + '\\n[forge]\\nattestation_command = \"sh ./fake-store\"\\n')\n27\t    (root / \"fake-store\").write_text('#!/bin/sh\\nread sha\\ntest -f \"statements/$sha.json\" && cat \"statements/$sha.json\"\\n')\n28\t    commit_as(root, PERSON, \"install the store read\", [\"attavo.toml\", \"fake-store\"])\n29\t    git(root, \"checkout\", \"-b\", \"item\")\n30\t    (root / \"specs\" / \"1\").mkdir(parents=True); (root / \"specs\" / \"1\" / \"spec.md\").write_text(\"## Problem\\n\\nsomething.\\n\")\n31\t    s = {}\n32\t    s[\"spec\"] = commit_as(root, PERSON, \"spec: item 1\", [\"specs/1\"])\n33\t    s[\"spec_record\"] = commit_as(root, APP, \"spec-gate record\", [record(root, \"spec\", 1, {\"status\": \"pass\", \"spec_sha\": s[\"spec\"], \"product_version\": \"v0.19.1\"})])\n34\t    s[\"approve\"] = commit_as(root, APP, \"approval record\", [record(root, \"approval\", 1, {\"approved_by\": \"alice\", \"sha\": s[\"spec\"], \"spec_sha\": s[\"spec\"], \"product_version\": \"v0.19.1\"})])\n35\t    (root / \"NOTES.md\").write_text(\"mid-run\\n\"); s[\"transport\"] = commit_as(root, PERSON, \"notes\", [\"NOTES.md\"])\n36\t    m = root / \"records\" / \"1\" / \"build-01.started\"; m.write_text(json.dumps({\"at\": \"2026-01-01T00:00:00Z\", \"host\": \"h\", \"sha\": s[\"spec\"], \"product_version\": \"v0.19.1\"}))\n37\t    s[\"marker\"] = commit_as(root, DRIVER, \"marker\", [\"records/1/build-01.started\"])\n38\t    (root / \"built.txt\").write_text(\"built\\n\"); s[\"change\"] = commit_as(root, EXECUTOR, \"build\", [\"built.txt\"])\n39\t    s[\"build\"] = commit_as(root, DRIVER, \"build record\", [record(root, \"build\", 1, {\"status\": \"pass\", \"product_version\": \"v0.19.1\"})])\n40\t    s[\"verify\"] = commit_as(root, DRIVER, \"verify record\", [record(root, \"verify\", 1, {\"status\": \"pass\", \"product_version\": \"v0.19.1\"})])\n41\t    git(root, \"checkout\", \"main\")\n42\t    subprocess.run([\"git\", \"-C\", str(root), \"merge\", \"-q\", \"--no-ff\", \"item\", \"-m\", \"Merge pull request #1 from x/item\"], check=True)\n43\t    s[\"merge\"] = git(root, \"rev-parse\", \"HEAD\").strip()\n44\t    (root / \"statements\").mkdir()\n45\t    (root / \"statements\" / (s[\"merge\"] + \".json\")).write_text(json.dumps({\"_type\": \"https://in-toto.io/Statement/v1\", \"predicateType\": \"https://attavo.dev/attestation/v6\", \"subject\": [{\"name\": \"x\", \"digest\": {\"sha256\": \"ab\" * 32}}], \"predicate\": {\"item\": \"1\"}}))\n46\t    run = subprocess.run([sys.executable, str(here / \"bin\" / \"attavo\"), \"ledger\", \"1\", \"--json\"], cwd=str(root), capture_output=True, text=True, check=False)\n47\t    if run.returncode != 0:\n48\t        raise RuntimeError(\"ledger: \" + run.stdout + run.stderr)\n49\t    rows = {r[\"sha\"]: r for r in json.loads(run.stdout)[\"rows\"]}\n50\texcept Exception as exc:\n51\t    print(\"SETUP: %r\" % (exc,)); shutil.rmtree(tmp, ignore_errors=True); sys.exit(2)\n52\tshutil.rmtree(tmp, ignore_errors=True)\n53\twant = {\"spec\": [\"specs/1/spec.md\"], \"spec_record\": [\"records/1/spec-01.json\"], \"approve\": [\"records/1/approval-01.json\"],\n54\t        \"transport\": [], \"marker\": [\"records/1/build-01.started\"], \"change\": [\"built.txt\"], \"build\": [\"records/1/build-01.json\"], \"merge\": []}\n55\tfor role, paths in want.items():\n56\t    got = rows.get(s[role], {}).get(\"carries\")\n57\t    if got != paths:\n58\t        print(\"ASSERT: the %s row carries %r, want %r\" % (role, got, paths)); sys.exit(1)\n59\tif rows[s[\"merge\"]].get(\"statement\") != {\"predicate_type\": \"https://attavo.dev/attestation/v6\", \"subject\": \"ab\" * 32}:\n60\t    print(\"ASSERT: the merge row's statement is %r\" % (rows[s[\"merge\"]].get(\"statement\"),)); sys.exit(1)\n61\tprint(\"ok\")\n62\tPY\n63\t"}]},"parent_tool_use_id":null,"session_id":"0a5d4e4f-a8ec-461c-a70f-8d166fde6be5","uuid":"a0b9daa9-ebaf-4ba4-9304-dae9969f48a4","timestamp":"2026-10-15T15:11:42.160Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-350/attest/specs/350/criteria/each-row-names-what-its-commit-carries.sh","content":"#!/bin/sh\n# Depends only on the product, tests/helpers.py and the standard library.\n# exit 2: the scenario could not be set up; exit 1: a row does not name what its commit carries.\nexec python3 - \"$(pwd)\" <<'PY'\nimport json, os, shutil, subprocess, sys, tempfile\nfrom pathlib import Path\nhere = Path(sys.argv[1])\nsys.path.insert(0, str(here / \"tests\"))\ntmp = Path(tempfile.mkdtemp(prefix=\"attavo-350-\"))\nPERSON = {\"name\": \"Alice Author\", \"email\": \"alice@example.com\"}\nAPP = {\"name\": \"attavo-bot[bot]\", \"email\": \"123+attavo-bot[bot]@users.noreply.github.com\"}\nDRIVER = {\"name\": \"attavo driver\", \"email\": \"driver@attavo.invalid\"}\nEXECUTOR = {\"name\": \"attavo executor (fixture)\", \"email\": \"executor+fixture@attavo.invalid\"}\ndef commit_as(root, who, msg, paths):\n    subprocess.run([\"git\", \"-C\", str(root), \"add\", *paths], check=True)\n    env = dict(os.environ, GIT_AUTHOR_NAME=who[\"name\"], GIT_COMMITTER_NAME=who[\"name\"],\n               GIT_AUTHOR_EMAIL=who[\"email\"], GIT_COMMITTER_EMAIL=who[\"email\"])\n    subprocess.run([\"git\", \"-C\", str(root), \"commit\", \"-q\", \"-m\", msg], check=True, env=env)\n    return subprocess.run([\"git\", \"-C\", str(root), \"rev-parse\", \"HEAD\"], capture_output=True, text=True, check=True).stdout.strip()\ndef record(root, stage, n, body):\n    p = root / \"records\" / \"1\" / f\"{stage}-{n:02d}.json\"; p.parent.mkdir(parents=True, exist_ok=True)\n    p.write_text(json.dumps(body)); return str(p.relative_to(root))\ntry:\n    from helpers import git, make_tenant\n    root = make_tenant(tmp, \"ledger_base\")\n    (root / \"attavo.toml\").write_text((root / \"attavo.toml\").read_text() + '\\n[forge]\\nattestation_command = \"sh ./fake-store\"\\n')\n    (root / \"fake-store\").write_text('#!/bin/sh\\nread sha\\ntest -f \"statements/$sha.json\" && cat \"statements/$sha.json\"\\n')\n    commit_as(root, PERSON, \"install the store read\", [\"attavo.toml\", \"fake-store\"])\n    git(root, \"checkout\", \"-b\", \"item\")\n    (root / \"specs\" / \"1\").mkdir(parents=True); (root / \"specs\" / \"1\" / \"spec.md\").write_text(\"## Problem\\n\\nsomething.\\n\")\n    s = {}\n    s[\"spec\"] = commit_as(root, PERSON, \"spec: item 1\", [\"specs/1\"])\n    s[\"spec_record\"] = commit_as(root, APP, \"spec-gate record\", [record(root, \"spec\", 1, {\"status\": \"pass\", \"spec_sha\": s[\"spec\"], \"product_version\": \"v0.19.1\"})])\n    s[\"approve\"] = commit_as(root, APP, \"approval record\", [record(root, \"approval\", 1, {\"approved_by\": \"alice\", \"sha\": s[\"spec\"], \"spec_sha\": s[\"spec\"], \"product_version\": \"v0.19.1\"})])\n    (root / \"NOTES.md\").write_text(\"mid-run\\n\"); s[\"transport\"] = commit_as(root, PERSON, \"notes\", [\"NOTES.md\"])\n    m = root / \"records\" / \"1\" / \"build-01.started\"; m.write_text(json.dumps({\"at\": \"2026-01-01T00:00:00Z\", \"host\": \"h\", \"sha\": s[\"spec\"], \"product_version\": \"v0.19.1\"}))\n    s[\"marker\"] = commit_as(root, DRIVER, \"marker\", [\"records/1/build-01.started\"])\n    (root / \"built.txt\").write_text(\"built\\n\"); s[\"change\"] = commit_as(root, EXECUTOR, \"build\", [\"built.txt\"])\n    s[\"build\"] = commit_as(root, DRIVER, \"build record\", [record(root, \"build\", 1, {\"status\": \"pass\", \"product_version\": \"v0.19.1\"})])\n    s[\"verify\"] = commit_as(root, DRIVER, \"verify record\", [record(root, \"verify\", 1, {\"status\": \"pass\", \"product_version\": \"v0.19.1\"})])\n    git(root, \"checkout\", \"main\")\n    subprocess.run([\"git\", \"-C\", str(root), \"merge\", \"-q\", \"--no-ff\", \"item\", \"-m\", \"Merge pull request #1 from x/item\"], check=True)\n    s[\"merge\"] = git(root, \"rev-parse\", \"HEAD\").strip()\n    (root / \"statements\").mkdir()\n    (root / \"statements\" / (s[\"merge\"] + \".json\")).write_text(json.dumps({\"_type\": \"https://in-toto.io/Statement/v1\", \"predicateType\": \"https://attavo.dev/attestation/v6\", \"subject\": [{\"name\": \"x\", \"digest\": {\"sha256\": \"ab\" * 32}}], \"predicate\": {\"item\": \"1\"}}))\n    run = subprocess.run([sys.executable, str(here / \"bin\" / \"attavo\"), \"ledger\", \"1\", \"--json\"], cwd=str(root), capture_output=True, text=True, check=False)\n    if run.returncode != 0:\n        raise RuntimeError(\"ledger: \" + run.stdout + run.stderr)\n    rows = {r[\"sha\"]: r for r in json.loads(run.stdout)[\"rows\"]}\nexcept Exception as exc:\n    print(\"SETUP: %r\" % (exc,)); shutil.rmtree(tmp, ignore_errors=True); sys.exit(2)\nshutil.rmtree(tmp, ignore_errors=True)\nwant = {\"spec\": [\"specs/1/spec.md\"], \"spec_record\": [\"records/1/spec-01.json\"], \"approve\": [\"records/1/approval-01.json\"],\n        \"transport\": [], \"marker\": [\"records/1/build-01.started\"], \"change\": [\"built.txt\"], \"build\": [\"records/1/build-01.json\"], \"merge\": []}\nfor role, paths in want.items():\n    got = rows.get(s[role], {}).get(\"carries\")\n    if got != paths:\n        print(\"ASSERT: the %s row carries %r, want %r\" % (role, got, paths)); sys.exit(1)\nif rows[s[\"merge\"]].get(\"statement\") != {\"predicate_type\": \"https://attavo.dev/attestation/v6\", \"subject\": \"ab\" * 32}:\n    print(\"ASSERT: the merge row's statement is %r\" % (rows[s[\"merge\"]].get(\"statement\"),)); sys.exit(1)\nprint(\"ok\")\nPY\n","numLines":63,"startLine":1,"totalLines":63}},"tool_result_meta":[{"id":"toolu_01LP3z2SNbbXxzQNgTquWMxK","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}

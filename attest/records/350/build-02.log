{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01VbYtZ3dmkaVfD3XssLHfcF","type":"tool_result","content":"from __future__ import annotations\n\nimport json\nimport re\nimport subprocess\nimport sys\nimport tempfile\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom typing import Any\n\nfrom attavo.build import commits_with_diffs, driver_identity\nfrom attavo.common import MANIFEST, STAGES, git, read_manifest, git_env\nfrom attavo.doctor import (INVOCATION_MARKER_SUFFIX, _merges_reachable, attestation_command,\n                           merge_introducing_records, statement_for)\nfrom attavo.records import RECORD_RE, _load_record\nfrom attavo.stops import item_stops\nfrom attavo import Command\n\n# --- ledger: every act on an item by identity and class (issue #128) ---\n\n# operator acts (a person's own decisions and transport) vs. product acts\n# (the driver's or the records app's own automated commits) vs. the\n# executor's own code changes -- the three totals the plan's status table\n# and every reviewing session used to count by hand. record-or-launch\n# (below) contributes to neither: an honest count never guesses which\n# side of that line a pre-v0.18.0 commit falls on.\nLEDGER_OPERATOR_CLASSES = (\"approve\", \"amend\", \"launch\", \"transport\", \"merge\")\n\nLEDGER_V018_CUTOFF = (0, 18, 0)\n\n\ndef _semver_tuple(version: str | None) -> tuple[int, int, int] | None:\n    m = re.match(r\"^v(\\d+)\\.(\\d+)\\.(\\d+)\", version or \"\")\n    return (int(m.group(1)), int(m.group(2)), int(m.group(3))) if m else None\n\n\ndef _is_records_app(name: str) -> bool:\n    \"\"\"The forge's own app-bot login -- exactly the identity the\n    attavo-spec-gate and attavo-approve templates commit spec-gate and\n    approval records as (an app-token step mints it at run time from the\n    tenant's own app credentials): \"<app-slug>[bot]\". Never a name this\n    product can name in advance, so the one fact it can check is the\n    shape the forge itself gives every app identity, not a specific one.\"\"\"\n    return name.endswith(\"[bot]\")\n\n\ndef _carries(touched: list[str], specs_prefix: str, records_prefix: str) -> list[str]:\n    \"\"\"What a row names as its commit's own: the touched paths under\n    paths.specs or paths.records for this item -- the ledger's own\n    nameable record, never a guess at the rest of the tree a commit\n    happened to touch alongside it.\"\"\"\n    return [p for p in touched if p.startswith(specs_prefix) or p.startswith(records_prefix)]\n\n\ndef _statement_fields(statement: dict[str, Any]) -> dict[str, Any] | None:\n    \"\"\"{predicate_type, subject}: the envelope's own predicateType and its\n    first subject's sha256 digest -- the two fields a ledger row names,\n    never the statement's own predicate (attest's own business, not a\n    row's).\"\"\"\n    predicate_type = statement.get(\"predicateType\")\n    subject = statement.get(\"subject\")\n    if not isinstance(predicate_type, str):\n        return None\n    if not (isinstance(subject, list) and subject and isinstance(subject[0], dict)):\n        return None\n    digest = subject[0].get(\"digest\")\n    sha256 = digest.get(\"sha256\") if isinstance(digest, dict) else None\n    if not isinstance(sha256, str):\n        return None\n    return {\"predicate_type\": predicate_type, \"subject\": sha256}\n\n\ndef _merge_statement(root: Path, m: dict[str, Any], merge_sha: str) -> tuple[dict[str, Any] | None, str | None]:\n    \"\"\"(statement, note): the merge's own record, read through\n    [forge].attestation_command with the merge sha -- the same read\n    doctor's proof six already makes (statement_for). None and a\n    \"not read: ...\" note naming which source did not answer when the\n    manifest names no command, the command cannot read the store, or the\n    store holds nothing shaped like a statement for this sha -- never a\n    guess at what the merge carried.\"\"\"\n    cmd = attestation_command(m)\n    if cmd is None:\n        return None, \"not read: no [forge].attestation_command in the manifest\"\n    statement, exit_code = statement_for(root, cmd, merge_sha)\n    if statement is None:\n        if exit_code != 0:\n            return None, f\"not read: the store could not be read; {cmd!r} exited {exit_code}\"\n        return None, f\"not read: the store holds no statement for {merge_sha[:12]}\"\n    fields = _statement_fields(statement)\n    if fields is None:\n        return None, f\"not read: the store's statement for {merge_sha[:12]} has no subject digest\"\n    return fields, None\n\n\ndef first_commit_touching(root: Path, relpath: str) -> str | None:\n    \"\"\"The earliest commit touching relpath -- the mirror of\n    last_commit_touching, which answers the latest. Ledger's own walk\n    starts here: the item's first spec commit.\"\"\"\n    out = git(root, \"log\", \"--reverse\", \"--format=%H\", \"--\", relpath)\n    lines = out.split()\n    return lines[0] if lines else None\n\n\ndef _single_commit_with_diff(root: Path, sha: str) -> dict[str, Any]:\n    \"\"\"commits_with_diffs's own shape, for one commit read directly rather\n    than by a range -- the one case `_commits_from` needs it for: a\n    commit with no parent, which `^` cannot name.\"\"\"\n    out = git(root, \"show\", \"--diff-merges=first-parent\", \"--name-only\",\n             \"--format=\\x01%H\\x1f%an\\x1f%ae\", sha)\n    header, _, rest = out.split(\"\\x01\")[1].partition(\"\\n\")\n    c_sha, name, email = header.split(\"\\x1f\")\n    return {\"sha\": c_sha, \"name\": name, \"email\": email,\n           \"touched\": [line for line in rest.splitlines() if line.strip()]}\n\n\ndef _commits_from(root: Path, first_sha: str, end: str) -> list[dict[str, Any]]:\n    \"\"\"commits_with_diffs's own range, from first_sha up to and including\n    end: first_sha^..end, the ordinary case. `^` cannot name the parent of\n    a commit that has none -- the repository's own root commit, which a\n    fixture or a squash merge can leave as an item's first spec commit --\n    and `A..B` always excludes A regardless, root or not; here, first_sha's\n    own diff is read directly and put first.\"\"\"\n    try:\n        git(root, \"rev-parse\", \"--verify\", f\"{first_sha}^\")\n    except RuntimeError:\n        return [_single_commit_with_diff(root, first_sha)] + commits_with_diffs(root, first_sha, end=end)\n    return commits_with_diffs(root, f\"{first_sha}^\", end=end)\n\n\ndef _record_blobs_at(root: Path, specs: list[tuple[str, str]], item_id: str) -> dict[tuple[str, str], dict[str, Any]]:\n    \"\"\"{(sha, relpath): record dict} for every (sha, relpath) pair, read by\n    one `git cat-file --batch` process for the whole list rather than one\n    `git show` per record (issue #153, ledger's only need for a record at a\n    past commit rather than the working tree -- issue #128). Each blob is\n    still spilled to a throwaway file and read through _load_record (issue\n    #60, acceptance 6: the one place a record's bytes become a dict),\n    rather than a second json.loads of its own. A pair git cannot resolve,\n    or whose blob is not valid JSON, is simply absent from the result --\n    the same silence _record_at once gave a missing blob.\"\"\"\n    if not specs:\n        return {}\n    stdin = \"\".join(f\"{sha}:{relpath}\\n\" for sha, relpath in specs)\n    out = subprocess.run([\"git\", \"-C\", str(root), \"cat-file\", \"--batch\"],\n                         input=stdin.encode(), capture_output=True, check=False, env=git_env())\n    data = out.stdout\n    pos = 0\n    result: dict[tuple[str, str], dict[str, Any]] = {}\n    for key in specs:\n        newline = data.index(b\"\\n\", pos)\n        header = data[pos:newline].decode()\n        pos = newline + 1\n        parts = header.split(\" \")\n        if parts[-1] == \"missing\":\n            continue\n        size = int(parts[-1])\n        content = data[pos:pos + size]\n        pos += size + 1\n        with tempfile.NamedTemporaryFile(\"wb\", suffix=\".json\", delete=False) as fh:\n            fh.write(content)\n            blob_path = Path(fh.name)\n        try:\n            result[key] = _load_record(blob_path, item_id)\n        except json.JSONDecodeError:\n            continue\n        finally:\n            blob_path.unlink(missing_ok=True)\n    return result\n\n\ndef item_ledger(root: Path, m: dict[str, Any], item_id: str, merges: list[dict[str, Any]] | None = None) -> dict[str, Any]:\n    \"\"\"{\"item\", \"rows\", \"summary\"}: one row per act between item_id's first\n    spec commit and its merge (merge_introducing_records, the same\n    derivation doctor's proof two and attest both already read) or HEAD\n    when the item has not merged yet.\n\n    merges, when given, is _merges_reachable's own result -- cmd_ledger\n    computes it once and passes it here for every item, rather than each\n    item walking HEAD's merges again (issue #153).\n\n    Each commit gets exactly one class, in this order: the merge commit\n    itself is \"merge\"; a commit authored by the executor identity\n    (executor_identity) is \"change\"; a commit introducing an approval\n    record is \"approve\", whoever committed it -- an operator's decision,\n    however it reached git; a commit introducing a spec-gate, build, or\n    verify record, authored by the driver identity (driver_identity) or\n    the records app, is \"record\"; the same, authored by a person, is\n    \"launch\" for build or verify (spec-gate records the app always\n    commits, in every template this product ships) -- unless that\n    record's own product_version predates v0.18.0, when driver_identity\n    did not yet exist to tell the two apart, and the row is\n    \"record-or-launch\" with a note, counted in neither summary total\n    rather than guessed; a person's commit touching the spec is \"spec\"\n    before the first approval record and \"amend\" after; anything else by\n    a person is \"transport\" (a merge of main among them).\"\"\"\n    specs_rel = m[\"paths\"][\"specs\"]\n    records_rel = m[\"paths\"][\"records\"]\n    specs_prefix = f\"{specs_rel.rstrip('/')}/{item_id}/\"\n    records_prefix = f\"{records_rel.rstrip('/')}/{item_id}/\"\n    empty_summary = {\"operator_acts\": 0, \"product_acts\": 0, \"executor_commits\": 0,\n                     \"stops\": 0, \"since\": None}\n\n    first_spec_sha = first_commit_touching(root, str(Path(specs_rel) / item_id))\n    if first_spec_sha is None:\n        return {\"item\": item_id, \"rows\": [], \"summary\": empty_summary}\n\n    if merges is None:\n        merges, refusal = _merges_reachable(root)\n        if refusal:\n            return {\"item\": item_id, \"rows\": [], \"summary\": empty_summary}\n    merge_sha, _ = merge_introducing_records(root, records_rel, item_id, STAGES, merges=merges)\n    if merge_sha is not None:\n        branch_tip = next(mrg[\"parents\"][1] for mrg in merges if mrg[\"sha\"] == merge_sha)\n        commits = _commits_from(root, first_spec_sha, branch_tip)\n        commits += commits_with_diffs(root, f\"{merge_sha}^1\", end=merge_sha)\n    else:\n        commits = _commits_from(root, first_spec_sha, \"HEAD\")\n\n    driver = driver_identity()\n\n    # Every record a walked commit touches, read by one batched process\n    # for the whole item rather than one `git show` per record (issue\n    # #153): a first pass over the already-fetched diffs finds which\n    # commits touch a record, then _record_blobs_at fetches them all.\n    record_touches: dict[str, tuple[str, str]] = {}\n    for c in commits:\n        if merge_sha is not None and c[\"sha\"] == merge_sha:\n            continue\n        if c[\"email\"].startswith(\"executor+\") and c[\"email\"].endswith(\"@attavo.invalid\"):\n            continue\n        for p in c[\"touched\"]:\n            if not p.startswith(records_prefix):\n                continue\n            rm = RECORD_RE.match(Path(p).name)\n            if rm and rm.group(1) in STAGES:\n                record_touches[c[\"sha\"]] = (rm.group(1), p)\n                break\n    record_content = _record_blobs_at(\n        root, [(sha, relpath) for sha, (_, relpath) in record_touches.items()], item_id)\n\n    rows: list[dict[str, Any]] = []\n    operator_acts = product_acts = executor_commits = 0\n    since = None\n    approval_seen = False\n\n    for c in commits:\n        sha, name, email = c[\"sha\"], c[\"name\"], c[\"email\"]\n\n        if merge_sha is not None and sha == merge_sha:\n            statement, note = _merge_statement(root, m, merge_sha)\n            row = {\"sha\": sha, \"identity\": name, \"class\": \"merge\", \"carries\": [],\n                  \"statement\": statement}\n            if note is not None:\n                row[\"note\"] = note\n            rows.append(row)\n            operator_acts += 1\n            continue\n\n        if email.startswith(\"executor+\") and email.endswith(\"@attavo.invalid\"):\n            rows.append({\"sha\": sha, \"identity\": name, \"class\": \"change\",\n                        \"carries\": list(c[\"touched\"])})\n            executor_commits += 1\n            continue\n\n        record_touch = record_touches.get(sha)\n\n        if record_touch is not None:\n            stage, relpath = record_touch\n            content = record_content.get((sha, relpath), {})\n            if since is None:\n                since = content.get(\"product_version\")\n            carries = _carries(c[\"touched\"], specs_prefix, records_prefix)\n\n            if stage == \"approval\":\n                rows.append({\"sha\": sha, \"identity\": name, \"class\": \"approve\", \"carries\": carries})\n                operator_acts += 1\n                approval_seen = True\n                continue\n\n            is_driver = name == driver[\"name\"] and email == driver[\"email\"]\n            is_records_app = _is_records_app(name)\n            if stage == \"spec\" or is_driver or is_records_app:\n                rows.append({\"sha\": sha, \"identity\": name, \"class\": \"record\", \"carries\": carries})\n                product_acts += 1\n                continue\n\n            version = _semver_tuple(content.get(\"product_version\"))\n            if version is not None and version < LEDGER_V018_CUTOFF:\n                rows.append({\"sha\": sha, \"identity\": name, \"class\": \"record-or-launch\",\n                            \"note\": \"not distinguishable before v0.18.0\", \"carries\": carries})\n                continue\n\n            rows.append({\"sha\": sha, \"identity\": name, \"class\": \"launch\", \"carries\": carries})\n            operator_acts += 1\n            continue\n\n        # An invocation marker's own commit (proof five): the product's\n        # act, never the operator's.\n        if any(p.startswith(records_prefix) and p.endswith(INVOCATION_MARKER_SUFFIX)\n               for p in c[\"touched\"]):\n            rows.append({\"sha\": sha, \"identity\": name, \"class\": \"record\",\n                        \"carries\": _carries(c[\"touched\"], specs_prefix, records_prefix)})\n            product_acts += 1\n            continue\n\n        if any(p.startswith(specs_prefix) for p in c[\"touched\"]):\n            cls = \"amend\" if approval_seen else \"spec\"\n            rows.append({\"sha\": sha, \"identity\": name, \"class\": cls,\n                        \"carries\": _carries(c[\"touched\"], specs_prefix, records_prefix)})\n            if cls == \"amend\":\n                operator_acts += 1\n            continue\n\n        # A person's transport commit: nothing to name, by design (#350).\n        rows.append({\"sha\": sha, \"identity\": name, \"class\": \"transport\", \"carries\": []})\n        operator_acts += 1\n\n    # issue #137: the same set attavo stops counts, from the same reader\n    # (item_stops) -- not a second, independent count kept in sync by\n    # hand. One non-pass record per row, whatever its stage; a gate\n    # refusal is included the same as a non-pass build or verify record.\n    stops = len(item_stops(root, m, item_id)[\"rows\"])\n\n    summary = {\"operator_acts\": operator_acts, \"product_acts\": product_acts,\n              \"executor_commits\": executor_commits, \"stops\": stops, \"since\": since}\n    return {\"item\": item_id, \"rows\": rows, \"summary\": summary}\n\n\n# The statement's own two lists (issue #349): acts is the operator's ruled\n# acts (approve, merge); rule stays in the schema's enum for the ruling\n# record (#276) and is never produced here. interventions is every other\n# operator row -- amend, launch, transport.\nACT_CLASSES = (\"approve\", \"merge\")\nINTERVENTION_CLASSES = (\"amend\", \"launch\", \"transport\")\n\n\ndef _committer_time_iso(root: Path, shas: list[str]) -> dict[str, str]:\n    \"\"\"Each sha's own committer time, in the same shape attest's own `at`\n    fields already carry -- one `git show` process for every sha an\n    item's acts and interventions need, not one git call per row.\"\"\"\n    if not shas:\n        return {}\n    out = git(root, \"show\", \"-s\", \"--format=%H\\x1f%ct\", *shas)\n    times: dict[str, str] = {}\n    for line in out.splitlines():\n        if not line.strip():\n            continue\n        sha, epoch = line.split(\"\\x1f\")\n        times[sha] = datetime.fromtimestamp(int(epoch), timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n    return times\n\n\ndef item_acts_and_interventions(root: Path, m: dict[str, Any], item_id: str,\n                                merges: list[dict[str, Any]] | None = None\n                                ) -> tuple[list[dict[str, Any]], list[dict[str, Any]]]:\n    \"\"\"(acts, interventions): the statement's own two lists, read from\n    item_ledger's own rows between the item's first spec commit and its\n    merge -- each commit classed exactly once there, never classified\n    twice. acts carries every approve and merge row as {act, sha, by, at};\n    interventions carries every amend, launch, and transport row as\n    {class, sha, by, at}. `by` is the commit's own author name\n    (item_ledger's `identity`); `at` is its committer time.\"\"\"\n    rows = item_ledger(root, m, item_id, merges=merges)[\"rows\"]\n    act_rows = [r for r in rows if r[\"class\"] in ACT_CLASSES]\n    intervention_rows = [r for r in rows if r[\"class\"] in INTERVENTION_CLASSES]\n    times = _committer_time_iso(root, [r[\"sha\"] for r in act_rows + intervention_rows])\n    acts = [{\"act\": r[\"class\"], \"sha\": r[\"sha\"], \"by\": r[\"identity\"], \"at\": times[r[\"sha\"]]}\n           for r in act_rows]\n    interventions = [{\"class\": r[\"class\"], \"sha\": r[\"sha\"], \"by\": r[\"identity\"], \"at\": times[r[\"sha\"]]}\n                     for r in intervention_rows]\n    return acts, interventions\n\n\ndef cmd_ledger(argv: list[str]) -> int:\n    as_json = \"--json\" in argv\n    positional = [a for a in argv if a != \"--json\"]\n    root = Path(\".\").resolve()\n    m = read_manifest(root)\n    if m is None:\n        print(f\"attavo ledger: no {MANIFEST} at {root}\", file=sys.stderr)\n        return 2\n\n    records_rel = m[\"paths\"][\"records\"]\n    if positional:\n        item_ids = [positional[0]]\n    else:\n        records_root = root / records_rel\n        item_ids = (sorted((p.name for p in records_root.iterdir() if p.is_dir()))\n                   if records_root.is_dir() else [])\n\n    # Computed once for every item in this read, not once per item (issue\n    # #153): the default branch's merges do not depend on which item is\n    # being asked about.\n    merges, refusal = _merges_reachable(root)\n    if refusal:\n        print(f\"attavo ledger: refused: {refusal}\", file=sys.stderr)\n        return 2\n    ledgers = [item_ledger(root, m, item_id, merges=merges) for item_id in item_ids]\n\n    if as_json:\n        if positional:\n            print(json.dumps(ledgers[0], indent=2))\n        else:\n            print(json.dumps({\"items\": ledgers}, indent=2))\n        return 0\n\n    for entry in ledgers:\n        print(f\"attavo ledger: item {entry['item']}\")\n        for row in entry[\"rows\"]:\n            if row[\"class\"] == \"merge\":\n                statement = row[\"statement\"]\n                carries = (f\"statement {statement['predicate_type']} {statement['subject'][:12]}\"\n                          if statement else \"no statement\")\n            else:\n                carries = \", \".join(row[\"carries\"]) if row[\"carries\"] else \"nothing\"\n            note = f\"  ({row['note']})\" if \"note\" in row else \"\"\n            print(f\"  {row['sha'][:12]}  {row['identity']:<32}  {row['class']:<16}  {carries}{note}\")\n        s = entry[\"summary\"]\n        print(f\"  operator acts: {s['operator_acts']}  product acts: {s['product_acts']}  \"\n             f\"executor commits: {s['executor_commits']}  stops: {s['stops']}  \"\n             f\"since: {s['since']}\")\n    if not ledgers:\n        print(f\"attavo ledger: no item found under {records_rel}\")\n    return 0\n\n\nCOMMANDS = (\n    Command(\n        name='ledger',\n        run=cmd_ledger,\n        usage=('attavo ledger [N] [--json]',),\n        rank=140,\n        help=(\n            (250, \"\"\"\\\nledger reads, never writes. For item N (or every item under\npaths.records when N is omitted), it walks the commits from the item's\nfirst spec commit to its merge (the same derivation doctor's proof two\nand attest use) or to HEAD when the item has not merged, and prints one\nrow per act: the sha, the identity as git names it, and a class from a\nclosed list -- spec, amend, approve, launch, record, change, transport,\nmerge -- derived from who committed it and, for an approval, build, or\nverify record, what the record itself says. A summary line follows:\noperator acts (approve, amend, launch, transport, merge), product acts\n(record), executor commits (change), stops (non-pass records), and\nsince (the product version on the first record). A build or verify\nrecord's own commit, from before v0.18.0 gave the driver and the\nexecutor their own identities, prints as record-or-launch with a note,\ncounted toward neither total, rather than guessed. --json prints the\nrows and the summary as one object. See issue #128's lane for the full\nrules it enforces.\"\"\"),\n        ),\n    ),\n)","is_error":false}]},"parent_tool_use_id":null,"session_id":"745730c1-9745-4807-999a-bd18cbe56303","uuid":"4ab5f4e8-9c71-4c2e-993a-d677a8146ec2","timestamp":"2026-10-15T15:45:33.970Z","tool_use_result":{"stdout":"from __future__ import annotations\n\nimport json\nimport re\nimport subprocess\nimport sys\nimport tempfile\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom typing import Any\n\nfrom attavo.build import commits_with_diffs, driver_identity\nfrom attavo.common import MANIFEST, STAGES, git, read_manifest, git_env\nfrom attavo.doctor import (INVOCATION_MARKER_SUFFIX, _merges_reachable, attestation_command,\n                           merge_introducing_records, statement_for)\nfrom attavo.records import RECORD_RE, _load_record\nfrom attavo.stops import item_stops\nfrom attavo import Command\n\n# --- ledger: every act on an item by identity and class (issue #128) ---\n\n# operator acts (a person's own decisions and transport) vs. product acts\n# (the driver's or the records app's own automated commits) vs. the\n# executor's own code changes -- the three totals the plan's status table\n# and every reviewing session used to count by hand. record-or-launch\n# (below) contributes to neither: an honest count never guesses which\n# side of that line a pre-v0.18.0 commit falls on.\nLEDGER_OPERATOR_CLASSES = (\"approve\", \"amend\", \"launch\", \"transport\", \"merge\")\n\nLEDGER_V018_CUTOFF = (0, 18, 0)\n\n\ndef _semver_tuple(version: str | None) -> tuple[int, int, int] | None:\n    m = re.match(r\"^v(\\d+)\\.(\\d+)\\.(\\d+)\", version or \"\")\n    return (int(m.group(1)), int(m.group(2)), int(m.group(3))) if m else None\n\n\ndef _is_records_app(name: str) -> bool:\n    \"\"\"The forge's own app-bot login -- exactly the identity the\n    attavo-spec-gate and attavo-approve templates commit spec-gate and\n    approval records as (an app-token step mints it at run time from the\n    tenant's own app credentials): \"<app-slug>[bot]\". Never a name this\n    product can name in advance, so the one fact it can check is the\n    shape the forge itself gives every app identity, not a specific one.\"\"\"\n    return name.endswith(\"[bot]\")\n\n\ndef _carries(touched: list[str], specs_prefix: str, records_prefix: str) -> list[str]:\n    \"\"\"What a row names as its commit's own: the touched paths under\n    paths.specs or paths.records for this item -- the ledger's own\n    nameable record, never a guess at the rest of the tree a commit\n    happened to touch alongside it.\"\"\"\n    return [p for p in touched if p.startswith(specs_prefix) or p.startswith(records_prefix)]\n\n\ndef _statement_fields(statement: dict[str, Any]) -> dict[str, Any] | None:\n    \"\"\"{predicate_type, subject}: the envelope's own predicateType and its\n    first subject's sha256 digest -- the two fields a ledger row names,\n    never the statement's own predicate (attest's own business, not a\n    row's).\"\"\"\n    predicate_type = statement.get(\"predicateType\")\n    subject = statement.get(\"subject\")\n    if not isinstance(predicate_type, str):\n        return None\n    if not (isinstance(subject, list) and subject and isinstance(subject[0], dict)):\n        return None\n    digest = subject[0].get(\"digest\")\n    sha256 = digest.get(\"sha256\") if isinstance(digest, dict) else None\n    if not isinstance(sha256, str):\n        return None\n    return {\"predicate_type\": predicate_type, \"subject\": sha256}\n\n\ndef _merge_statement(root: Path, m: dict[str, Any], merge_sha: str) -> tuple[dict[str, Any] | None, str | None]:\n    \"\"\"(statement, note): the merge's own record, read through\n    [forge].attestation_command with the merge sha -- the same read\n    doctor's proof six already makes (statement_for). None and a\n    \"not read: ...\" note naming which source did not answer when the\n    manifest names no command, the command cannot read the store, or the\n    store holds nothing shaped like a statement for this sha -- never a\n    guess at what the merge carried.\"\"\"\n    cmd = attestation_command(m)\n    if cmd is None:\n        return None, \"not read: no [forge].attestation_command in the manifest\"\n    statement, exit_code = statement_for(root, cmd, merge_sha)\n    if statement is None:\n        if exit_code != 0:\n            return None, f\"not read: the store could not be read; {cmd!r} exited {exit_code}\"\n        return None, f\"not read: the store holds no statement for {merge_sha[:12]}\"\n    fields = _statement_fields(statement)\n    if fields is None:\n        return None, f\"not read: the store's statement for {merge_sha[:12]} has no subject digest\"\n    return fields, None\n\n\ndef first_commit_touching(root: Path, relpath: str) -> str | None:\n    \"\"\"The earliest commit touching relpath -- the mirror of\n    last_commit_touching, which answers the latest. Ledger's own walk\n    starts here: the item's first spec commit.\"\"\"\n    out = git(root, \"log\", \"--reverse\", \"--format=%H\", \"--\", relpath)\n    lines = out.split()\n    return lines[0] if lines else None\n\n\ndef _single_commit_with_diff(root: Path, sha: str) -> dict[str, Any]:\n    \"\"\"commits_with_diffs's own shape, for one commit read directly rather\n    than by a range -- the one case `_commits_from` needs it for: a\n    commit with no parent, which `^` cannot name.\"\"\"\n    out = git(root, \"show\", \"--diff-merges=first-parent\", \"--name-only\",\n             \"--format=\\x01%H\\x1f%an\\x1f%ae\", sha)\n    header, _, rest = out.split(\"\\x01\")[1].partition(\"\\n\")\n    c_sha, name, email = header.split(\"\\x1f\")\n    return {\"sha\": c_sha, \"name\": name, \"email\": email,\n           \"touched\": [line for line in rest.splitlines() if line.strip()]}\n\n\ndef _commits_from(root: Path, first_sha: str, end: str) -> list[dict[str, Any]]:\n    \"\"\"commits_with_diffs's own range, from first_sha up to and including\n    end: first_sha^..end, the ordinary case. `^` cannot name the parent of\n    a commit that has none -- the repository's own root commit, which a\n    fixture or a squash merge can leave as an item's first spec commit --\n    and `A..B` always excludes A regardless, root or not; here, first_sha's\n    own diff is read directly and put first.\"\"\"\n    try:\n        git(root, \"rev-parse\", \"--verify\", f\"{first_sha}^\")\n    except RuntimeError:\n        return [_single_commit_with_diff(root, first_sha)] + commits_with_diffs(root, first_sha, end=end)\n    return commits_with_diffs(root, f\"{first_sha}^\", end=end)\n\n\ndef _record_blobs_at(root: Path, specs: list[tuple[str, str]], item_id: str) -> dict[tuple[str, str], dict[str, Any]]:\n    \"\"\"{(sha, relpath): record dict} for every (sha, relpath) pair, read by\n    one `git cat-file --batch` process for the whole list rather than one\n    `git show` per record (issue #153, ledger's only need for a record at a\n    past commit rather than the working tree -- issue #128). Each blob is\n    still spilled to a throwaway file and read through _load_record (issue\n    #60, acceptance 6: the one place a record's bytes become a dict),\n    rather than a second json.loads of its own. A pair git cannot resolve,\n    or whose blob is not valid JSON, is simply absent from the result --\n    the same silence _record_at once gave a missing blob.\"\"\"\n    if not specs:\n        return {}\n    stdin = \"\".join(f\"{sha}:{relpath}\\n\" for sha, relpath in specs)\n    out = subprocess.run([\"git\", \"-C\", str(root), \"cat-file\", \"--batch\"],\n                         input=stdin.encode(), capture_output=True, check=False, env=git_env())\n    data = out.stdout\n    pos = 0\n    result: dict[tuple[str, str], dict[str, Any]] = {}\n    for key in specs:\n        newline = data.index(b\"\\n\", pos)\n        header = data[pos:newline].decode()\n        pos = newline + 1\n        parts = header.split(\" \")\n        if parts[-1] == \"missing\":\n            continue\n        size = int(parts[-1])\n        content = data[pos:pos + size]\n        pos += size + 1\n        with tempfile.NamedTemporaryFile(\"wb\", suffix=\".json\", delete=False) as fh:\n            fh.write(content)\n            blob_path = Path(fh.name)\n        try:\n            result[key] = _load_record(blob_path, item_id)\n        except json.JSONDecodeError:\n            continue\n        finally:\n            blob_path.unlink(missing_ok=True)\n    return result\n\n\ndef item_ledger(root: Path, m: dict[str, Any], item_id: str, merges: list[dict[str, Any]] | None = None) -> dict[str, Any]:\n    \"\"\"{\"item\", \"rows\", \"summary\"}: one row per act between item_id's first\n    spec commit and its merge (merge_introducing_records, the same\n    derivation doctor's proof two and attest both already read) or HEAD\n    when the item has not merged yet.\n\n    merges, when given, is _merges_reachable's own result -- cmd_ledger\n    computes it once and passes it here for every item, rather than each\n    item walking HEAD's merges again (issue #153).\n\n    Each commit gets exactly one class, in this order: the merge commit\n    itself is \"merge\"; a commit authored by the executor identity\n    (executor_identity) is \"change\"; a commit introducing an approval\n    record is \"approve\", whoever committed it -- an operator's decision,\n    however it reached git; a commit introducing a spec-gate, build, or\n    verify record, authored by the driver identity (driver_identity) or\n    the records app, is \"record\"; the same, authored by a person, is\n    \"launch\" for build or verify (spec-gate records the app always\n    commits, in every template this product ships) -- unless that\n    record's own product_version predates v0.18.0, when driver_identity\n    did not yet exist to tell the two apart, and the row is\n    \"record-or-launch\" with a note, counted in neither summary total\n    rather than guessed; a person's commit touching the spec is \"spec\"\n    before the first approval record and \"amend\" after; anything else by\n    a person is \"transport\" (a merge of main among them).\"\"\"\n    specs_rel = m[\"paths\"][\"specs\"]\n    records_rel = m[\"paths\"][\"records\"]\n    specs_prefix = f\"{specs_rel.rstrip('/')}/{item_id}/\"\n    records_prefix = f\"{records_rel.rstrip('/')}/{item_id}/\"\n    empty_summary = {\"operator_acts\": 0, \"product_acts\": 0, \"executor_commits\": 0,\n                     \"stops\": 0, \"since\": None}\n\n    first_spec_sha = first_commit_touching(root, str(Path(specs_rel) / item_id))\n    if first_spec_sha is None:\n        return {\"item\": item_id, \"rows\": [], \"summary\": empty_summary}\n\n    if merges is None:\n        merges, refusal = _merges_reachable(root)\n        if refusal:\n            return {\"item\": item_id, \"rows\": [], \"summary\": empty_summary}\n    merge_sha, _ = merge_introducing_records(root, records_rel, item_id, STAGES, merges=merges)\n    if merge_sha is not None:\n        branch_tip = next(mrg[\"parents\"][1] for mrg in merges if mrg[\"sha\"] == merge_sha)\n        commits = _commits_from(root, first_spec_sha, branch_tip)\n        commits += commits_with_diffs(root, f\"{merge_sha}^1\", end=merge_sha)\n    else:\n        commits = _commits_from(root, first_spec_sha, \"HEAD\")\n\n    driver = driver_identity()\n\n    # Every record a walked commit touches, read by one batched process\n    # for the whole item rather than one `git show` per record (issue\n    # #153): a first pass over the already-fetched diffs finds which\n    # commits touch a record, then _record_blobs_at fetches them all.\n    record_touches: dict[str, tuple[str, str]] = {}\n    for c in commits:\n        if merge_sha is not None and c[\"sha\"] == merge_sha:\n            continue\n        if c[\"email\"].startswith(\"executor+\") and c[\"email\"].endswith(\"@attavo.invalid\"):\n            continue\n        for p in c[\"touched\"]:\n            if not p.startswith(records_prefix):\n                continue\n            rm = RECORD_RE.match(Path(p).name)\n            if rm and rm.group(1) in STAGES:\n                record_touches[c[\"sha\"]] = (rm.group(1), p)\n                break\n    record_content = _record_blobs_at(\n        root, [(sha, relpath) for sha, (_, relpath) in record_touches.items()], item_id)\n\n    rows: list[dict[str, Any]] = []\n    operator_acts = product_acts = executor_commits = 0\n    since = None\n    approval_seen = False\n\n    for c in commits:\n        sha, name, email = c[\"sha\"], c[\"name\"], c[\"email\"]\n\n        if merge_sha is not None and sha == merge_sha:\n            statement, note = _merge_statement(root, m, merge_sha)\n            row = {\"sha\": sha, \"identity\": name, \"class\": \"merge\", \"carries\": [],\n                  \"statement\": statement}\n            if note is not None:\n                row[\"note\"] = note\n            rows.append(row)\n            operator_acts += 1\n            continue\n\n        if email.startswith(\"executor+\") and email.endswith(\"@attavo.invalid\"):\n            rows.append({\"sha\": sha, \"identity\": name, \"class\": \"change\",\n                        \"carries\": list(c[\"touched\"])})\n            executor_commits += 1\n            continue\n\n        record_touch = record_touches.get(sha)\n\n        if record_touch is not None:\n            stage, relpath = record_touch\n            content = record_content.get((sha, relpath), {})\n            if since is None:\n                since = content.get(\"product_version\")\n            carries = _carries(c[\"touched\"], specs_prefix, records_prefix)\n\n            if stage == \"approval\":\n                rows.append({\"sha\": sha, \"identity\": name, \"class\": \"approve\", \"carries\": carries})\n                operator_acts += 1\n                approval_seen = True\n                continue\n\n            is_driver = name == driver[\"name\"] and email == driver[\"email\"]\n            is_records_app = _is_records_app(name)\n            if stage == \"spec\" or is_driver or is_records_app:\n                rows.append({\"sha\": sha, \"identity\": name, \"class\": \"record\", \"carries\": carries})\n                product_acts += 1\n                continue\n\n            version = _semver_tuple(content.get(\"product_version\"))\n            if version is not None and version < LEDGER_V018_CUTOFF:\n                rows.append({\"sha\": sha, \"identity\": name, \"class\": \"record-or-launch\",\n                            \"note\": \"not distinguishable before v0.18.0\", \"carries\": carries})\n                continue\n\n            rows.append({\"sha\": sha, \"identity\": name, \"class\": \"launch\", \"carries\": carries})\n            operator_acts += 1\n            continue\n\n        # An invocation marker's own commit (proof five): the product's\n        # act, never the operator's.\n        if any(p.startswith(records_prefix) and p.endswith(INVOCATION_MARKER_SUFFIX)\n               for p in c[\"touched\"]):\n            rows.append({\"sha\": sha, \"identity\": name, \"class\": \"record\",\n                        \"carries\": _carries(c[\"touched\"], specs_prefix, records_prefix)})\n            product_acts += 1\n            continue\n\n        if any(p.startswith(specs_prefix) for p in c[\"touched\"]):\n            cls = \"amend\" if approval_seen else \"spec\"\n            rows.append({\"sha\": sha, \"identity\": name, \"class\": cls,\n                        \"carries\": _carries(c[\"touched\"], specs_prefix, records_prefix)})\n            if cls == \"amend\":\n                operator_acts += 1\n            continue\n\n        # A person's transport commit: nothing to name, by design (#350).\n        rows.append({\"sha\": sha, \"identity\": name, \"class\": \"transport\", \"carries\": []})\n        operator_acts += 1\n\n    # issue #137: the same set attavo stops counts, from the same reader\n    # (item_stops) -- not a second, independent count kept in sync by\n    # hand. One non-pass record per row, whatever its stage; a gate\n    # refusal is included the same as a non-pass build or verify record.\n    stops = len(item_stops(root, m, item_id)[\"rows\"])\n\n    summary = {\"operator_acts\": operator_acts, \"product_acts\": product_acts,\n              \"executor_commits\": executor_commits, \"stops\": stops, \"since\": since}\n    return {\"item\": item_id, \"rows\": rows, \"summary\": summary}\n\n\n# The statement's own two lists (issue #349): acts is the operator's ruled\n# acts (approve, merge); rule stays in the schema's enum for the ruling\n# record (#276) and is never produced here. interventions is every other\n# operator row -- amend, launch, transport.\nACT_CLASSES = (\"approve\", \"merge\")\nINTERVENTION_CLASSES = (\"amend\", \"launch\", \"transport\")\n\n\ndef _committer_time_iso(root: Path, shas: list[str]) -> dict[str, str]:\n    \"\"\"Each sha's own committer time, in the same shape attest's own `at`\n    fields already carry -- one `git show` process for every sha an\n    item's acts and interventions need, not one git call per row.\"\"\"\n    if not shas:\n        return {}\n    out = git(root, \"show\", \"-s\", \"--format=%H\\x1f%ct\", *shas)\n    times: dict[str, str] = {}\n    for line in out.splitlines():\n        if not line.strip():\n            continue\n        sha, epoch = line.split(\"\\x1f\")\n        times[sha] = datetime.fromtimestamp(int(epoch), timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n    return times\n\n\ndef item_acts_and_interventions(root: Path, m: dict[str, Any], item_id: str,\n                                merges: list[dict[str, Any]] | None = None\n                                ) -> tuple[list[dict[str, Any]], list[dict[str, Any]]]:\n    \"\"\"(acts, interventions): the statement's own two lists, read from\n    item_ledger's own rows between the item's first spec commit and its\n    merge -- each commit classed exactly once there, never classified\n    twice. acts carries every approve and merge row as {act, sha, by, at};\n    interventions carries every amend, launch, and transport row as\n    {class, sha, by, at}. `by` is the commit's own author name\n    (item_ledger's `identity`); `at` is its committer time.\"\"\"\n    rows = item_ledger(root, m, item_id, merges=merges)[\"rows\"]\n    act_rows = [r for r in rows if r[\"class\"] in ACT_CLASSES]\n    intervention_rows = [r for r in rows if r[\"class\"] in INTERVENTION_CLASSES]\n    times = _committer_time_iso(root, [r[\"sha\"] for r in act_rows + intervention_rows])\n    acts = [{\"act\": r[\"class\"], \"sha\": r[\"sha\"], \"by\": r[\"identity\"], \"at\": times[r[\"sha\"]]}\n           for r in act_rows]\n    interventions = [{\"class\": r[\"class\"], \"sha\": r[\"sha\"], \"by\": r[\"identity\"], \"at\": times[r[\"sha\"]]}\n                     for r in intervention_rows]\n    return acts, interventions\n\n\ndef cmd_ledger(argv: list[str]) -> int:\n    as_json = \"--json\" in argv\n    positional = [a for a in argv if a != \"--json\"]\n    root = Path(\".\").resolve()\n    m = read_manifest(root)\n    if m is None:\n        print(f\"attavo ledger: no {MANIFEST} at {root}\", file=sys.stderr)\n        return 2\n\n    records_rel = m[\"paths\"][\"records\"]\n    if positional:\n        item_ids = [positional[0]]\n    else:\n        records_root = root / records_rel\n        item_ids = (sorted((p.name for p in records_root.iterdir() if p.is_dir()))\n                   if records_root.is_dir() else [])\n\n    # Computed once for every item in this read, not once per item (issue\n    # #153): the default branch's merges do not depend on which item is\n    # being asked about.\n    merges, refusal = _merges_reachable(root)\n    if refusal:\n        print(f\"attavo ledger: refused: {refusal}\", file=sys.stderr)\n        return 2\n    ledgers = [item_ledger(root, m, item_id, merges=merges) for item_id in item_ids]\n\n    if as_json:\n        if positional:\n            print(json.dumps(ledgers[0], indent=2))\n        else:\n            print(json.dumps({\"items\": ledgers}, indent=2))\n        return 0\n\n    for entry in ledgers:\n        print(f\"attavo ledger: item {entry['item']}\")\n        for row in entry[\"rows\"]:\n            if row[\"class\"] == \"merge\":\n                statement = row[\"statement\"]\n                carries = (f\"statement {statement['predicate_type']} {statement['subject'][:12]}\"\n                          if statement else \"no statement\")\n            else:\n                carries = \", \".join(row[\"carries\"]) if row[\"carries\"] else \"nothing\"\n            note = f\"  ({row['note']})\" if \"note\" in row else \"\"\n            print(f\"  {row['sha'][:12]}  {row['identity']:<32}  {row['class']:<16}  {carries}{note}\")\n        s = entry[\"summary\"]\n        print(f\"  operator acts: {s['operator_acts']}  product acts: {s['product_acts']}  \"\n             f\"executor commits: {s['executor_commits']}  stops: {s['stops']}  \"\n             f\"since: {s['since']}\")\n    if not ledgers:\n        print(f\"attavo ledger: no item found under {records_rel}\")\n    return 0\n\n\nCOMMANDS = (\n    Command(\n        name='ledger',\n        run=cmd_ledger,\n        usage=('attavo ledger [N] [--json]',),\n        rank=140,\n        help=(\n            (250, \"\"\"\\\nledger reads, never writes. For item N (or every item under\npaths.records when N is omitted), it walks the commits from the item's\nfirst spec commit to its merge (the same derivation doctor's proof two\nand attest use) or to HEAD when the item has not merged, and prints one\nrow per act: the sha, the identity as git names it, and a class from a\nclosed list -- spec, amend, approve, launch, record, change, transport,\nmerge -- derived from who committed it and, for an approval, build, or\nverify record, what the record itself says. A summary line follows:\noperator acts (approve, amend, launch, transport, merge), product acts\n(record), executor commits (change), stops (non-pass records), and\nsince (the product version on the first record). A build or verify\nrecord's own commit, from before v0.18.0 gave the driver and the\nexecutor their own identities, prints as record-or-launch with a note,\ncounted toward neither total, rather than guessed. --json prints the\nrows and the summary as one object. See issue #128's lane for the full\nrules it enforces.\"\"\"),\n        ),\n    ),\n)","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_01VbYtZ3dmkaVfD3XssLHfcF","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
{"type":"assistant","message":{"model":"claude-sonnet-5","id":"msg_011Cg4HJYG8Y7uAZQushBsfb","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_0198i4afhKrMPoxS9e1XD6YZ","name":"Bash","input":{"command":"cat tests/test_ledger.py"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":969,"cache_read_input_tokens":29549,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":969},"output_tokens":2,"service_tier":"standard","inference_geo":"global"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"745730c1-9745-4807-999a-bd18cbe56303","uuid":"d12f5c71-7439-4ac8-8391-ac309614d93d","timestamp":"2026-10-15T15:45:34.292Z","request_id":"req_011Cg4HJY1zovQWWpi1q31kc","wire_tool_inputs":{"toolu_0198i4afhKrMPoxS9e1XD6YZ":{"command":"cd /Users/davidbean/Projects/attavo-worktree-350 && cat tests/test_ledger.py"}},"wire_ingest_context":{"toolu_0198i4afhKrMPoxS9e1XD6YZ":{"cwd":"/Users/davidbean/Projects/attavo-worktree-350"}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0198i4afhKrMPoxS9e1XD6YZ","type":"tool_result","content":"\"\"\"attavo ledger: every act on an item by identity and class (issue #128).\n\nRegression tests, written and run red first: on `main` before this change\nthere was no `ledger` subcommand, so every one of these failed with\n\"unknown subcommand\".\n\nRun: python3 -m pytest tests -q\n\"\"\"\nimport json\nimport os\nimport subprocess\nimport sys\nfrom pathlib import Path\nfrom typing import Any\n\nfrom helpers import git, make_tenant\n\nROOT = Path(__file__).resolve().parent.parent\nATTAVO = ROOT / \"bin\" / \"attavo\"\n\n# The four identities issue #128 names: a person (writes the spec, in the\n# real templates also the one who comments /approve), the records app (a\n# GitHub App's own bot login -- \"<app-slug>[bot]\" -- that commits\n# spec-gate and approval records in attavo-spec-gate.yml and\n# attavo-approve.yml), the driver (drive's own record commits), and the\n# executor (an adapter invocation's own commits).\nPERSON = {\"name\": \"Alice Author\", \"email\": \"alice@example.com\"}\nRECORDS_APP = {\"name\": \"attavo-bot[bot]\", \"email\": \"123+attavo-bot[bot]@users.noreply.github.com\"}\nDRIVER = {\"name\": \"attavo driver\", \"email\": \"driver@attavo.invalid\"}\nEXECUTOR = {\"name\": \"attavo executor (fixture)\", \"email\": \"executor+fixture@attavo.invalid\"}\n\n\ndef run_attavo(root: Path, *args: str) -> subprocess.CompletedProcess[str]:\n    return subprocess.run([sys.executable, str(ATTAVO), *args], cwd=str(root),\n                          capture_output=True, text=True, check=False)\n\n\ndef commit_as(root: Path, identity: dict[str, Any], message: str, paths: list[str]) -> str:\n    \"\"\"Stage exactly paths and commit as identity, both author and\n    committer -- the same shape commit_record and the tenant's own CI\n    templates set (never the tenant's ambient git config).\"\"\"\n    git(root, \"add\", *paths)\n    env = dict(os.environ)\n    env[\"GIT_AUTHOR_NAME\"] = env[\"GIT_COMMITTER_NAME\"] = identity[\"name\"]\n    env[\"GIT_AUTHOR_EMAIL\"] = env[\"GIT_COMMITTER_EMAIL\"] = identity[\"email\"]\n    subprocess.run([\"git\", \"-C\", str(root), \"commit\", \"-q\", \"-m\", message],\n                   check=True, env=env)\n    return git(root, \"rev-parse\", \"HEAD\").strip()\n\n\ndef write_record(root: Path, item: str, stage: str, n: int, content: dict[str, Any]) -> str:\n    records_dir = root / \"records\" / item\n    records_dir.mkdir(parents=True, exist_ok=True)\n    path = records_dir / f\"{stage}-{n:02d}.json\"\n    path.write_text(json.dumps(content))\n    return str(path.relative_to(root))\n\n\ndef add_spec(root: Path, item: str = \"1\") -> str:\n    spec_dir = root / \"specs\" / item\n    spec_dir.mkdir(parents=True)\n    (spec_dir / \"spec.md\").write_text(\"## Problem\\n\\nsomething.\\n\")\n    return commit_as(root, PERSON, f\"spec: item {item}\", [f\"specs/{item}\"])\n\n\ndef build_merged_item(tmp_path: Path, item: str = \"1\") -> Path:\n    \"\"\"The order #651 had: a person's spec commit, the records app's\n    spec-gate and approval records, the executor's own change, the\n    driver's build and verify records, then the merge landing all of it\n    on main.\"\"\"\n    root = make_tenant(tmp_path, \"ledger_base\")\n    git(root, \"checkout\", \"-b\", \"item\")\n\n    spec_sha = add_spec(root, item)\n\n    rel = write_record(root, item, \"spec\", 1,\n                       {\"status\": \"pass\", \"spec_sha\": spec_sha, \"product_version\": \"v0.19.1\"})\n    commit_as(root, RECORDS_APP, f\"attavo: spec-gate record for item {item}\", [rel])\n\n    rel = write_record(root, item, \"approval\", 1,\n                       {\"approved_by\": \"alice\", \"sha\": spec_sha, \"spec_sha\": spec_sha,\n                        \"product_version\": \"v0.19.1\"})\n    commit_as(root, RECORDS_APP, f\"attavo: approval record for item {item}\", [rel])\n\n    (root / \"built.txt\").write_text(\"built\\n\")\n    commit_as(root, EXECUTOR, f\"fixture: build item {item}\", [\"built.txt\"])\n\n    rel = write_record(root, item, \"build\", 1, {\"status\": \"pass\", \"product_version\": \"v0.19.1\"})\n    commit_as(root, DRIVER, f\"attavo: build record for item {item} (build-01)\", [rel])\n\n    rel = write_record(root, item, \"verify\", 1, {\"status\": \"pass\", \"product_version\": \"v0.19.1\"})\n    commit_as(root, DRIVER, f\"attavo: verify record for item {item} (verify-01)\", [rel])\n\n    git(root, \"checkout\", \"main\")\n    subprocess.run([\"git\", \"-C\", str(root), \"merge\", \"--no-ff\", \"item\",\n                    \"-m\", f\"Merge pull request #{item} from x/item\"], check=True)\n    return root\n\n\ndef test_ledger_classifies_every_commit_and_counts_operator_acts(tmp_path: Path) -> None:\n    \"\"\"Acceptance row 1: on a fixture with the four identities, every\n    commit gets exactly one class and the summary counts operator acts 2\n    -- the same shape tenant zero's own #651 reads (1 approve, 1 merge).\"\"\"\n    root = build_merged_item(tmp_path)\n\n    run = run_attavo(root, \"ledger\", \"1\", \"--json\")\n    assert run.returncode == 0, run.stdout + run.stderr\n    data = json.loads(run.stdout)\n\n    classes = [row[\"class\"] for row in data[\"rows\"]]\n    assert classes == [\"spec\", \"record\", \"approve\", \"change\", \"record\", \"record\", \"merge\"]\n    assert all(row[\"class\"] and row[\"sha\"] and row[\"identity\"] for row in data[\"rows\"])\n\n    summary = data[\"summary\"]\n    assert summary[\"operator_acts\"] == 2\n    assert summary[\"product_acts\"] == 3\n    assert summary[\"executor_commits\"] == 1\n    assert summary[\"stops\"] == 0\n    assert summary[\"since\"] == \"v0.19.1\"\n\n\ndef test_ledger_stops_count_matches_stops_including_a_gate_refusal(tmp_path: Path) -> None:\n    \"\"\"Issue #137, acceptance row 2. A refused spec-gate record and a\n    non-pass build record: ledger's own stops count is the same set\n    `attavo stops` counts, gate refusals included -- both computed by\n    item_stops, not two producers reading one item and printing\n    different numbers (tenant zero #683: stops printed 1, ledger printed\n    0, because ledger's own count only ever looked at build and verify).\n    \"\"\"\n    root = make_tenant(tmp_path, \"ledger_base\")\n    add_spec(root)\n\n    write_record(root, \"1\", \"spec\", 1,\n                {\"status\": \"refused\",\n                 \"refusal\": \"criterion fails against the tree plus stub: \"\n                            \"doctor-template-absent.sh\"})\n    write_record(root, \"1\", \"build\", 1, {\"status\": \"failed\"})\n\n    ledger_run = run_attavo(root, \"ledger\", \"1\", \"--json\")\n    assert ledger_run.returncode == 0, ledger_run.stdout + ledger_run.stderr\n    stops_run = run_attavo(root, \"stops\", \"1\", \"--json\")\n    assert stops_run.returncode == 0, stops_run.stdout + stops_run.stderr\n\n    ledger_data = json.loads(ledger_run.stdout)\n    stops_data = json.loads(stops_run.stdout)\n\n    assert len(stops_data[\"rows\"]) == 2\n    assert ledger_data[\"summary\"][\"stops\"] == len(stops_data[\"rows\"])\n\n\ndef test_ledger_marks_a_pre_v018_record_commit_as_record_or_launch(tmp_path: Path) -> None:\n    \"\"\"Acceptance row 2: a person's record commit before v0.18.0 prints\n    record-or-launch with the note, never launch or record -- before that\n    version the driver and the executor had no identity of their own to\n    tell a genuine launch apart from an automated one.\"\"\"\n    root = make_tenant(tmp_path, \"ledger_base\")\n    add_spec(root)\n\n    rel = write_record(root, \"1\", \"build\", 1, {\"status\": \"pass\", \"product_version\": \"v0.17.0\"})\n    person_sha = commit_as(root, PERSON, \"manual build record for item 1\", [rel])\n\n    run = run_attavo(root, \"ledger\", \"1\", \"--json\")\n    assert run.returncode == 0, run.stdout + run.stderr\n    data = json.loads(run.stdout)\n\n    row = next(r for r in data[\"rows\"] if r[\"sha\"] == person_sha)\n    assert row[\"class\"] == \"record-or-launch\"\n    assert row[\"note\"] == \"not distinguishable before v0.18.0\"\n    assert data[\"summary\"][\"operator_acts\"] == 0\n    assert data[\"summary\"][\"product_acts\"] == 0\n\n\ndef test_ledger_classifies_an_invocation_marker_commit_as_a_product_record(tmp_path: Path) -> None:\n    \"\"\"Issue #151: the invocation marker's own commit, authored by the\n    driver identity, touches paths.records without matching a stage\n    record's own NN.json name -- classified \"record\", the product's own\n    act, never \"transport\". Otherwise the same order build_merged_item\n    sets up, with the marker's own commit landing just ahead of the\n    build record it precedes in a real drive run.\"\"\"\n    root = make_tenant(tmp_path, \"ledger_base\")\n    git(root, \"checkout\", \"-b\", \"item\")\n\n    spec_sha = add_spec(root, \"1\")\n\n    rel = write_record(root, \"1\", \"spec\", 1,\n                       {\"status\": \"pass\", \"spec_sha\": spec_sha, \"product_version\": \"v0.19.1\"})\n    commit_as(root, RECORDS_APP, \"attavo: spec-gate record for item 1\", [rel])\n\n    rel = write_record(root, \"1\", \"approval\", 1,\n                       {\"approved_by\": \"alice\", \"sha\": spec_sha, \"spec_sha\": spec_sha,\n                        \"product_version\": \"v0.19.1\"})\n    commit_as(root, RECORDS_APP, \"attavo: approval record for item 1\", [rel])\n\n    marker_dir = root / \"records\" / \"1\"\n    marker_dir.mkdir(parents=True, exist_ok=True)\n    marker = marker_dir / \"build-01.started\"\n    marker.write_text(json.dumps({\"at\": \"2026-01-01T00:00:00Z\", \"host\": \"h\", \"pid\": 1,\n                                  \"sha\": spec_sha, \"product_version\": \"v0.19.1\"}))\n    marker_sha = commit_as(root, DRIVER, \"attavo: build invocation 01 started for item 1\",\n                           [str(marker.relative_to(root))])\n\n    (root / \"built.txt\").write_text(\"built\\n\")\n    commit_as(root, EXECUTOR, \"fixture: build item 1\", [\"built.txt\"])\n\n    rel = write_record(root, \"1\", \"build\", 1, {\"status\": \"pass\", \"product_version\": \"v0.19.1\"})\n    commit_as(root, DRIVER, \"attavo: build record for item 1 (build-01)\", [rel])\n\n    rel = write_record(root, \"1\", \"verify\", 1, {\"status\": \"pass\", \"product_version\": \"v0.19.1\"})\n    commit_as(root, DRIVER, \"attavo: verify record for item 1 (verify-01)\", [rel])\n\n    git(root, \"checkout\", \"main\")\n    subprocess.run([\"git\", \"-C\", str(root), \"merge\", \"--no-ff\", \"item\",\n                    \"-m\", \"Merge pull request #1 from x/item\"], check=True)\n\n    run = run_attavo(root, \"ledger\", \"1\", \"--json\")\n    assert run.returncode == 0, run.stdout + run.stderr\n    data = json.loads(run.stdout)\n\n    row = next(r for r in data[\"rows\"] if r[\"sha\"] == marker_sha)\n    assert row[\"class\"] == \"record\"\n\n    classes = [r[\"class\"] for r in data[\"rows\"]]\n    assert classes == [\"spec\", \"record\", \"approve\", \"record\", \"change\", \"record\", \"record\", \"merge\"]\n    assert data[\"summary\"][\"product_acts\"] == 4\n    assert data[\"summary\"][\"operator_acts\"] == 2\n\n\ndef test_ledger_json_is_one_object_matching_the_text_forms_numbers(tmp_path: Path) -> None:\n    \"\"\"Acceptance row 3: --json is one object with rows and summary, and\n    the text form prints the same numbers.\"\"\"\n    root = build_merged_item(tmp_path)\n\n    run_json = run_attavo(root, \"ledger\", \"1\", \"--json\")\n    assert run_json.returncode == 0, run_json.stdout + run_json.stderr\n    data = json.loads(run_json.stdout)\n    assert set(data) == {\"item\", \"rows\", \"summary\"}\n    assert isinstance(data[\"rows\"], list)\n    assert isinstance(data[\"summary\"], dict)\n\n    run_text = run_attavo(root, \"ledger\", \"1\")\n    assert run_text.returncode == 0, run_text.stdout + run_text.stderr\n    summary = data[\"summary\"]\n    assert f\"operator acts: {summary['operator_acts']}\" in run_text.stdout\n    assert f\"product acts: {summary['product_acts']}\" in run_text.stdout\n    assert f\"executor commits: {summary['executor_commits']}\" in run_text.stdout\n    assert f\"stops: {summary['stops']}\" in run_text.stdout\n    assert f\"since: {summary['since']}\" in run_text.stdout\n\n\n# Issue #350: each ledger row names what its commit carries.\n\ndef build_merged_item_with_a_marker_a_transport_and_a_store(tmp_path: Path) -> tuple[Path, dict[str, str]]:\n    \"\"\"build_merged_item's order plus a marker commit, a person's transport\n    commit after approval, and a [forge].attestation_command whose store\n    holds the merge's statement. Returns (root, shas by role).\"\"\"\n    root = make_tenant(tmp_path, \"ledger_base\")\n    (root / \"attavo.toml\").write_text(\n        (root / \"attavo.toml\").read_text() + '\\n[forge]\\nattestation_command = \"sh ./fake-store\"\\n')\n    (root / \"fake-store\").write_text(\n        '#!/bin/sh\\nread sha\\ntest -f \"statements/$sha.json\" && cat \"statements/$sha.json\"\\n')\n    commit_as(root, PERSON, \"install the store read\", [\"attavo.toml\", \"fake-store\"])\n    git(root, \"checkout\", \"-b\", \"item\")\n    shas: dict[str, str] = {}\n    shas[\"spec\"] = add_spec(root, \"1\")\n    rel = write_record(root, \"1\", \"spec\", 1, {\"status\": \"pass\", \"spec_sha\": shas[\"spec\"], \"product_version\": \"v0.19.1\"})\n    shas[\"spec_record\"] = commit_as(root, RECORDS_APP, \"attavo: spec-gate record for item 1\", [rel])\n    rel = write_record(root, \"1\", \"approval\", 1, {\"approved_by\": \"alice\", \"sha\": shas[\"spec\"],\n                                                  \"spec_sha\": shas[\"spec\"], \"product_version\": \"v0.19.1\"})\n    shas[\"approve\"] = commit_as(root, RECORDS_APP, \"attavo: approval record for item 1\", [rel])\n    (root / \"NOTES.md\").write_text(\"a person's commit mid-run\\n\")\n    shas[\"transport\"] = commit_as(root, PERSON, \"notes\", [\"NOTES.md\"])\n    marker = root / \"records\" / \"1\" / \"build-01.started\"\n    marker.write_text(json.dumps({\"at\": \"2026-01-01T00:00:00Z\", \"host\": \"h\", \"sha\": shas[\"spec\"],\n                                  \"product_version\": \"v0.19.1\"}))\n    shas[\"marker\"] = commit_as(root, DRIVER, \"attavo: build invocation 01 started for item 1\",\n                               [str(marker.relative_to(root))])\n    (root / \"built.txt\").write_text(\"built\\n\")\n    shas[\"change\"] = commit_as(root, EXECUTOR, \"fixture: build item 1\", [\"built.txt\"])\n    rel = write_record(root, \"1\", \"build\", 1, {\"status\": \"pass\", \"product_version\": \"v0.19.1\"})\n    shas[\"build\"] = commit_as(root, DRIVER, \"attavo: build record for item 1 (build-01)\", [rel])\n    rel = write_record(root, \"1\", \"verify\", 1, {\"status\": \"pass\", \"product_version\": \"v0.19.1\"})\n    shas[\"verify\"] = commit_as(root, DRIVER, \"attavo: verify record for item 1 (verify-01)\", [rel])\n    git(root, \"checkout\", \"main\")\n    subprocess.run([\"git\", \"-C\", str(root), \"merge\", \"--no-ff\", \"item\", \"-m\", \"Merge pull request #1 from x/item\"],\n                   check=True)\n    shas[\"merge\"] = git(root, \"rev-parse\", \"HEAD\").strip()\n    store = root / \"statements\"\n    store.mkdir()\n    (store / f\"{shas['merge']}.json\").write_text(json.dumps({\n        \"_type\": \"https://in-toto.io/Statement/v1\",\n        \"predicateType\": \"https://attavo.dev/attestation/v6\",\n        \"subject\": [{\"name\": \"attavo/attavo\", \"digest\": {\"sha256\": \"ab\" * 32}}],\n        \"predicate\": {\"item\": \"1\"}}))\n    return root, shas\n\n\ndef test_each_ledger_row_names_what_its_commit_carries(tmp_path: Path) -> None:\n    \"\"\"Specimen: #344's ledger (2026-10-07) read \"not read\" for the marker\n    commits, the two transports and the merge, when each carries something\n    nameable: the .started file, nothing by design, and the statement.\"\"\"\n    root, shas = build_merged_item_with_a_marker_a_transport_and_a_store(tmp_path)\n    run = run_attavo(root, \"ledger\", \"1\", \"--json\")\n    assert run.returncode == 0, run.stdout + run.stderr\n    rows = {r[\"sha\"]: r for r in json.loads(run.stdout)[\"rows\"]}\n    assert rows[shas[\"spec\"]][\"carries\"] == [\"specs/1/spec.md\"]\n    assert rows[shas[\"spec_record\"]][\"carries\"] == [\"records/1/spec-01.json\"]\n    assert rows[shas[\"approve\"]][\"carries\"] == [\"records/1/approval-01.json\"]\n    assert rows[shas[\"marker\"]][\"carries\"] == [\"records/1/build-01.started\"]\n    assert rows[shas[\"change\"]][\"carries\"] == [\"built.txt\"]\n    assert rows[shas[\"build\"]][\"carries\"] == [\"records/1/build-01.json\"]\n    assert rows[shas[\"transport\"]][\"class\"] == \"transport\" and rows[shas[\"transport\"]][\"carries\"] == []\n    merge = rows[shas[\"merge\"]]\n    assert merge[\"carries\"] == []\n    assert merge[\"statement\"] == {\"predicate_type\": \"https://attavo.dev/attestation/v6\", \"subject\": \"ab\" * 32}\n\n\ndef test_the_merge_row_says_not_read_when_the_store_does_not_answer(tmp_path: Path) -> None:\n    root, shas = build_merged_item_with_a_marker_a_transport_and_a_store(tmp_path)\n    (root / \"fake-store\").write_text(\"#!/bin/sh\\nexit 2\\n\")\n    run = run_attavo(root, \"ledger\", \"1\", \"--json\")\n    assert run.returncode == 0, run.stdout + run.stderr\n    merge = next(r for r in json.loads(run.stdout)[\"rows\"] if r[\"sha\"] == shas[\"merge\"])\n    assert merge[\"statement\"] is None\n    assert \"not read\" in merge[\"note\"] and \"store\" in merge[\"note\"]","is_error":false}]},"parent_tool_use_id":null,"session_id":"745730c1-9745-4807-999a-bd18cbe56303","uuid":"9ad739ad-2cc4-4976-97d1-30cf18645e17","timestamp":"2026-10-15T15:45:34.364Z","tool_use_result":{"stdout":"\"\"\"attavo ledger: every act on an item by identity and class (issue #128).\n\nRegression tests, written and run red first: on `main` before this change\nthere was no `ledger` subcommand, so every one of these failed with\n\"unknown subcommand\".\n\nRun: python3 -m pytest tests -q\n\"\"\"\nimport json\nimport os\nimport subprocess\nimport sys\nfrom pathlib import Path\nfrom typing import Any\n\nfrom helpers import git, make_tenant\n\nROOT = Path(__file__).resolve().parent.parent\nATTAVO = ROOT / \"bin\" / \"attavo\"\n\n# The four identities issue #128 names: a person (writes the spec, in the\n# real templates also the one who comments /approve), the records app (a\n# GitHub App's own bot login -- \"<app-slug>[bot]\" -- that commits\n# spec-gate and approval records in attavo-spec-gate.yml and\n# attavo-approve.yml), the driver (drive's own record commits), and the\n# executor (an adapter invocation's own commits).\nPERSON = {\"name\": \"Alice Author\", \"email\": \"alice@example.com\"}\nRECORDS_APP = {\"name\": \"attavo-bot[bot]\", \"email\": \"123+attavo-bot[bot]@users.noreply.github.com\"}\nDRIVER = {\"name\": \"attavo driver\", \"email\": \"driver@attavo.invalid\"}\nEXECUTOR = {\"name\": \"attavo executor (fixture)\", \"email\": \"executor+fixture@attavo.invalid\"}\n\n\ndef run_attavo(root: Path, *args: str) -> subprocess.CompletedProcess[str]:\n    return subprocess.run([sys.executable, str(ATTAVO), *args], cwd=str(root),\n                          capture_output=True, text=True, check=False)\n\n\ndef commit_as(root: Path, identity: dict[str, Any], message: str, paths: list[str]) -> str:\n    \"\"\"Stage exactly paths and commit as identity, both author and\n    committer -- the same shape commit_record and the tenant's own CI\n    templates set (never the tenant's ambient git config).\"\"\"\n    git(root, \"add\", *paths)\n    env = dict(os.environ)\n    env[\"GIT_AUTHOR_NAME\"] = env[\"GIT_COMMITTER_NAME\"] = identity[\"name\"]\n    env[\"GIT_AUTHOR_EMAIL\"] = env[\"GIT_COMMITTER_EMAIL\"] = identity[\"email\"]\n    subprocess.run([\"git\", \"-C\", str(root), \"commit\", \"-q\", \"-m\", message],\n                   check=True, env=env)\n    return git(root, \"rev-parse\", \"HEAD\").strip()\n\n\ndef write_record(root: Path, item: str, stage: str, n: int, content: dict[str, Any]) -> str:\n    records_dir = root / \"records\" / item\n    records_dir.mkdir(parents=True, exist_ok=True)\n    path = records_dir / f\"{stage}-{n:02d}.json\"\n    path.write_text(json.dumps(content))\n    return str(path.relative_to(root))\n\n\ndef add_spec(root: Path, item: str = \"1\") -> str:\n    spec_dir = root / \"specs\" / item\n    spec_dir.mkdir(parents=True)\n    (spec_dir / \"spec.md\").write_text(\"## Problem\\n\\nsomething.\\n\")\n    return commit_as(root, PERSON, f\"spec: item {item}\", [f\"specs/{item}\"])\n\n\ndef build_merged_item(tmp_path: Path, item: str = \"1\") -> Path:\n    \"\"\"The order #651 had: a person's spec commit, the records app's\n    spec-gate and approval records, the executor's own change, the\n    driver's build and verify records, then the merge landing all of it\n    on main.\"\"\"\n    root = make_tenant(tmp_path, \"ledger_base\")\n    git(root, \"checkout\", \"-b\", \"item\")\n\n    spec_sha = add_spec(root, item)\n\n    rel = write_record(root, item, \"spec\", 1,\n                       {\"status\": \"pass\", \"spec_sha\": spec_sha, \"product_version\": \"v0.19.1\"})\n    commit_as(root, RECORDS_APP, f\"attavo: spec-gate record for item {item}\", [rel])\n\n    rel = write_record(root, item, \"approval\", 1,\n                       {\"approved_by\": \"alice\", \"sha\": spec_sha, \"spec_sha\": spec_sha,\n                        \"product_version\": \"v0.19.1\"})\n    commit_as(root, RECORDS_APP, f\"attavo: approval record for item {item}\", [rel])\n\n    (root / \"built.txt\").write_text(\"built\\n\")\n    commit_as(root, EXECUTOR, f\"fixture: build item {item}\", [\"built.txt\"])\n\n    rel = write_record(root, item, \"build\", 1, {\"status\": \"pass\", \"product_version\": \"v0.19.1\"})\n    commit_as(root, DRIVER, f\"attavo: build record for item {item} (build-01)\", [rel])\n\n    rel = write_record(root, item, \"verify\", 1, {\"status\": \"pass\", \"product_version\": \"v0.19.1\"})\n    commit_as(root, DRIVER, f\"attavo: verify record for item {item} (verify-01)\", [rel])\n\n    git(root, \"checkout\", \"main\")\n    subprocess.run([\"git\", \"-C\", str(root), \"merge\", \"--no-ff\", \"item\",\n                    \"-m\", f\"Merge pull request #{item} from x/item\"], check=True)\n    return root\n\n\ndef test_ledger_classifies_every_commit_and_counts_operator_acts(tmp_path: Path) -> None:\n    \"\"\"Acceptance row 1: on a fixture with the four identities, every\n    commit gets exactly one class and the summary counts operator acts 2\n    -- the same shape tenant zero's own #651 reads (1 approve, 1 merge).\"\"\"\n    root = build_merged_item(tmp_path)\n\n    run = run_attavo(root, \"ledger\", \"1\", \"--json\")\n    assert run.returncode == 0, run.stdout + run.stderr\n    data = json.loads(run.stdout)\n\n    classes = [row[\"class\"] for row in data[\"rows\"]]\n    assert classes == [\"spec\", \"record\", \"approve\", \"change\", \"record\", \"record\", \"merge\"]\n    assert all(row[\"class\"] and row[\"sha\"] and row[\"identity\"] for row in data[\"rows\"])\n\n    summary = data[\"summary\"]\n    assert summary[\"operator_acts\"] == 2\n    assert summary[\"product_acts\"] == 3\n    assert summary[\"executor_commits\"] == 1\n    assert summary[\"stops\"] == 0\n    assert summary[\"since\"] == \"v0.19.1\"\n\n\ndef test_ledger_stops_count_matches_stops_including_a_gate_refusal(tmp_path: Path) -> None:\n    \"\"\"Issue #137, acceptance row 2. A refused spec-gate record and a\n    non-pass build record: ledger's own stops count is the same set\n    `attavo stops` counts, gate refusals included -- both computed by\n    item_stops, not two producers reading one item and printing\n    different numbers (tenant zero #683: stops printed 1, ledger printed\n    0, because ledger's own count only ever looked at build and verify).\n    \"\"\"\n    root = make_tenant(tmp_path, \"ledger_base\")\n    add_spec(root)\n\n    write_record(root, \"1\", \"spec\", 1,\n                {\"status\": \"refused\",\n                 \"refusal\": \"criterion fails against the tree plus stub: \"\n                            \"doctor-template-absent.sh\"})\n    write_record(root, \"1\", \"build\", 1, {\"status\": \"failed\"})\n\n    ledger_run = run_attavo(root, \"ledger\", \"1\", \"--json\")\n    assert ledger_run.returncode == 0, ledger_run.stdout + ledger_run.stderr\n    stops_run = run_attavo(root, \"stops\", \"1\", \"--json\")\n    assert stops_run.returncode == 0, stops_run.stdout + stops_run.stderr\n\n    ledger_data = json.loads(ledger_run.stdout)\n    stops_data = json.loads(stops_run.stdout)\n\n    assert len(stops_data[\"rows\"]) == 2\n    assert ledger_data[\"summary\"][\"stops\"] == len(stops_data[\"rows\"])\n\n\ndef test_ledger_marks_a_pre_v018_record_commit_as_record_or_launch(tmp_path: Path) -> None:\n    \"\"\"Acceptance row 2: a person's record commit before v0.18.0 prints\n    record-or-launch with the note, never launch or record -- before that\n    version the driver and the executor had no identity of their own to\n    tell a genuine launch apart from an automated one.\"\"\"\n    root = make_tenant(tmp_path, \"ledger_base\")\n    add_spec(root)\n\n    rel = write_record(root, \"1\", \"build\", 1, {\"status\": \"pass\", \"product_version\": \"v0.17.0\"})\n    person_sha = commit_as(root, PERSON, \"manual build record for item 1\", [rel])\n\n    run = run_attavo(root, \"ledger\", \"1\", \"--json\")\n    assert run.returncode == 0, run.stdout + run.stderr\n    data = json.loads(run.stdout)\n\n    row = next(r for r in data[\"rows\"] if r[\"sha\"] == person_sha)\n    assert row[\"class\"] == \"record-or-launch\"\n    assert row[\"note\"] == \"not distinguishable before v0.18.0\"\n    assert data[\"summary\"][\"operator_acts\"] == 0\n    assert data[\"summary\"][\"product_acts\"] == 0\n\n\ndef test_ledger_classifies_an_invocation_marker_commit_as_a_product_record(tmp_path: Path) -> None:\n    \"\"\"Issue #151: the invocation marker's own commit, authored by the\n    driver identity, touches paths.records without matching a stage\n    record's own NN.json name -- classified \"record\", the product's own\n    act, never \"transport\". Otherwise the same order build_merged_item\n    sets up, with the marker's own commit landing just ahead of the\n    build record it precedes in a real drive run.\"\"\"\n    root = make_tenant(tmp_path, \"ledger_base\")\n    git(root, \"checkout\", \"-b\", \"item\")\n\n    spec_sha = add_spec(root, \"1\")\n\n    rel = write_record(root, \"1\", \"spec\", 1,\n                       {\"status\": \"pass\", \"spec_sha\": spec_sha, \"product_version\": \"v0.19.1\"})\n    commit_as(root, RECORDS_APP, \"attavo: spec-gate record for item 1\", [rel])\n\n    rel = write_record(root, \"1\", \"approval\", 1,\n                       {\"approved_by\": \"alice\", \"sha\": spec_sha, \"spec_sha\": spec_sha,\n                        \"product_version\": \"v0.19.1\"})\n    commit_as(root, RECORDS_APP, \"attavo: approval record for item 1\", [rel])\n\n    marker_dir = root / \"records\" / \"1\"\n    marker_dir.mkdir(parents=True, exist_ok=True)\n    marker = marker_dir / \"build-01.started\"\n    marker.write_text(json.dumps({\"at\": \"2026-01-01T00:00:00Z\", \"host\": \"h\", \"pid\": 1,\n                                  \"sha\": spec_sha, \"product_version\": \"v0.19.1\"}))\n    marker_sha = commit_as(root, DRIVER, \"attavo: build invocation 01 started for item 1\",\n                           [str(marker.relative_to(root))])\n\n    (root / \"built.txt\").write_text(\"built\\n\")\n    commit_as(root, EXECUTOR, \"fixture: build item 1\", [\"built.txt\"])\n\n    rel = write_record(root, \"1\", \"build\", 1, {\"status\": \"pass\", \"product_version\": \"v0.19.1\"})\n    commit_as(root, DRIVER, \"attavo: build record for item 1 (build-01)\", [rel])\n\n    rel = write_record(root, \"1\", \"verify\", 1, {\"status\": \"pass\", \"product_version\": \"v0.19.1\"})\n    commit_as(root, DRIVER, \"attavo: verify record for item 1 (verify-01)\", [rel])\n\n    git(root, \"checkout\", \"main\")\n    subprocess.run([\"git\", \"-C\", str(root), \"merge\", \"--no-ff\", \"item\",\n                    \"-m\", \"Merge pull request #1 from x/item\"], check=True)\n\n    run = run_attavo(root, \"ledger\", \"1\", \"--json\")\n    assert run.returncode == 0, run.stdout + run.stderr\n    data = json.loads(run.stdout)\n\n    row = next(r for r in data[\"rows\"] if r[\"sha\"] == marker_sha)\n    assert row[\"class\"] == \"record\"\n\n    classes = [r[\"class\"] for r in data[\"rows\"]]\n    assert classes == [\"spec\", \"record\", \"approve\", \"record\", \"change\", \"record\", \"record\", \"merge\"]\n    assert data[\"summary\"][\"product_acts\"] == 4\n    assert data[\"summary\"][\"operator_acts\"] == 2\n\n\ndef test_ledger_json_is_one_object_matching_the_text_forms_numbers(tmp_path: Path) -> None:\n    \"\"\"Acceptance row 3: --json is one object with rows and summary, and\n    the text form prints the same numbers.\"\"\"\n    root = build_merged_item(tmp_path)\n\n    run_json = run_attavo(root, \"ledger\", \"1\", \"--json\")\n    assert run_json.returncode == 0, run_json.stdout + run_json.stderr\n    data = json.loads(run_json.stdout)\n    assert set(data) == {\"item\", \"rows\", \"summary\"}\n    assert isinstance(data[\"rows\"], list)\n    assert isinstance(data[\"summary\"], dict)\n\n    run_text = run_attavo(root, \"ledger\", \"1\")\n    assert run_text.returncode == 0, run_text.stdout + run_text.stderr\n    summary = data[\"summary\"]\n    assert f\"operator acts: {summary['operator_acts']}\" in run_text.stdout\n    assert f\"product acts: {summary['product_acts']}\" in run_text.stdout\n    assert f\"executor commits: {summary['executor_commits']}\" in run_text.stdout\n    assert f\"stops: {summary['stops']}\" in run_text.stdout\n    assert f\"since: {summary['since']}\" in run_text.stdout\n\n\n# Issue #350: each ledger row names what its commit carries.\n\ndef build_merged_item_with_a_marker_a_transport_and_a_store(tmp_path: Path) -> tuple[Path, dict[str, str]]:\n    \"\"\"build_merged_item's order plus a marker commit, a person's transport\n    commit after approval, and a [forge].attestation_command whose store\n    holds the merge's statement. Returns (root, shas by role).\"\"\"\n    root = make_tenant(tmp_path, \"ledger_base\")\n    (root / \"attavo.toml\").write_text(\n        (root / \"attavo.toml\").read_text() + '\\n[forge]\\nattestation_command = \"sh ./fake-store\"\\n')\n    (root / \"fake-store\").write_text(\n        '#!/bin/sh\\nread sha\\ntest -f \"statements/$sha.json\" && cat \"statements/$sha.json\"\\n')\n    commit_as(root, PERSON, \"install the store read\", [\"attavo.toml\", \"fake-store\"])\n    git(root, \"checkout\", \"-b\", \"item\")\n    shas: dict[str, str] = {}\n    shas[\"spec\"] = add_spec(root, \"1\")\n    rel = write_record(root, \"1\", \"spec\", 1, {\"status\": \"pass\", \"spec_sha\": shas[\"spec\"], \"product_version\": \"v0.19.1\"})\n    shas[\"spec_record\"] = commit_as(root, RECORDS_APP, \"attavo: spec-gate record for item 1\", [rel])\n    rel = write_record(root, \"1\", \"approval\", 1, {\"approved_by\": \"alice\", \"sha\": shas[\"spec\"],\n                                                  \"spec_sha\": shas[\"spec\"], \"product_version\": \"v0.19.1\"})\n    shas[\"approve\"] = commit_as(root, RECORDS_APP, \"attavo: approval record for item 1\", [rel])\n    (root / \"NOTES.md\").write_text(\"a person's commit mid-run\\n\")\n    shas[\"transport\"] = commit_as(root, PERSON, \"notes\", [\"NOTES.md\"])\n    marker = root / \"records\" / \"1\" / \"build-01.started\"\n    marker.write_text(json.dumps({\"at\": \"2026-01-01T00:00:00Z\", \"host\": \"h\", \"sha\": shas[\"spec\"],\n                                  \"product_version\": \"v0.19.1\"}))\n    shas[\"marker\"] = commit_as(root, DRIVER, \"attavo: build invocation 01 started for item 1\",\n                               [str(marker.relative_to(root))])\n    (root / \"built.txt\").write_text(\"built\\n\")\n    shas[\"change\"] = commit_as(root, EXECUTOR, \"fixture: build item 1\", [\"built.txt\"])\n    rel = write_record(root, \"1\", \"build\", 1, {\"status\": \"pass\", \"product_version\": \"v0.19.1\"})\n    shas[\"build\"] = commit_as(root, DRIVER, \"attavo: build record for item 1 (build-01)\", [rel])\n    rel = write_record(root, \"1\", \"verify\", 1, {\"status\": \"pass\", \"product_version\": \"v0.19.1\"})\n    shas[\"verify\"] = commit_as(root, DRIVER, \"attavo: verify record for item 1 (verify-01)\", [rel])\n    git(root, \"checkout\", \"main\")\n    subprocess.run([\"git\", \"-C\", str(root), \"merge\", \"--no-ff\", \"item\", \"-m\", \"Merge pull request #1 from x/item\"],\n                   check=True)\n    shas[\"merge\"] = git(root, \"rev-parse\", \"HEAD\").strip()\n    store = root / \"statements\"\n    store.mkdir()\n    (store / f\"{shas['merge']}.json\").write_text(json.dumps({\n        \"_type\": \"https://in-toto.io/Statement/v1\",\n        \"predicateType\": \"https://attavo.dev/attestation/v6\",\n        \"subject\": [{\"name\": \"attavo/attavo\", \"digest\": {\"sha256\": \"ab\" * 32}}],\n        \"predicate\": {\"item\": \"1\"}}))\n    return root, shas\n\n\ndef test_each_ledger_row_names_what_its_commit_carries(tmp_path: Path) -> None:\n    \"\"\"Specimen: #344's ledger (2026-10-07) read \"not read\" for the marker\n    commits, the two transports and the merge, when each carries something\n    nameable: the .started file, nothing by design, and the statement.\"\"\"\n    root, shas = build_merged_item_with_a_marker_a_transport_and_a_store(tmp_path)\n    run = run_attavo(root, \"ledger\", \"1\", \"--json\")\n    assert run.returncode == 0, run.stdout + run.stderr\n    rows = {r[\"sha\"]: r for r in json.loads(run.stdout)[\"rows\"]}\n    assert rows[shas[\"spec\"]][\"carries\"] == [\"specs/1/spec.md\"]\n    assert rows[shas[\"spec_record\"]][\"carries\"] == [\"records/1/spec-01.json\"]\n    assert rows[shas[\"approve\"]][\"carries\"] == [\"records/1/approval-01.json\"]\n    assert rows[shas[\"marker\"]][\"carries\"] == [\"records/1/build-01.started\"]\n    assert rows[shas[\"change\"]][\"carries\"] == [\"built.txt\"]\n    assert rows[shas[\"build\"]][\"carries\"] == [\"records/1/build-01.json\"]\n    assert rows[shas[\"transport\"]][\"class\"] == \"transport\" and rows[shas[\"transport\"]][\"carries\"] == []\n    merge = rows[shas[\"merge\"]]\n    assert merge[\"carries\"] == []\n    assert merge[\"statement\"] == {\"predicate_type\": \"https://attavo.dev/attestation/v6\", \"subject\": \"ab\" * 32}\n\n\ndef test_the_merge_row_says_not_read_when_the_store_does_not_answer(tmp_path: Path) -> None:\n    root, shas = build_merged_item_with_a_marker_a_transport_and_a_store(tmp_path)\n    (root / \"fake-store\").write_text(\"#!/bin/sh\\nexit 2\\n\")\n    run = run_attavo(root, \"ledger\", \"1\", \"--json\")\n    assert run.returncode == 0, run.stdout + run.stderr\n    merge = next(r for r in json.loads(run.stdout)[\"rows\"] if r[\"sha\"] == shas[\"merge\"])\n    assert merge[\"statement\"] is None\n    assert \"not read\" in merge[\"note\"] and \"store\" in merge[\"note\"]","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"tool_result_meta":[{"id":"toolu_0198i4afhKrMPoxS9e1XD6YZ","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}

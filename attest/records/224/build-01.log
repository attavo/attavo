{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012F2cybjvWRRenyUdxQyu1Q","type":"tool_result","content":"--- attavo/cli.py\t2026-09-26 12:23:41\n+++ attest/specs/224/stub/attavo/cli.py\t2026-09-26 12:23:41\n@@ -305,6 +305,7 @@\n \n from __future__ import annotations\n \n+import os\n import sys\n \n from attavo.approval import cmd_approval_status, cmd_approve\n@@ -322,10 +323,20 @@\n from attavo.verify import cmd_verify\n \n \n+TRANSPORT = (\"drive\", \"worker\", \"build\", \"verify\", \"counsel\", \"file-stops\")\n+\n+\n def main(argv: list[str]) -> int:\n     if not argv or argv[0] in (\"-h\", \"--help\"):\n         print(__doc__.strip())\n         return 0 if argv else 2\n+    if argv[0] in TRANSPORT and os.environ.get(\"ATTAVO_STAGE\"):\n+        # The product's transport is never the executor's tool: a stage\n+        # runs inside an invocation whose environment names the stage,\n+        # and nothing under it may start, judge, or record another.\n+        print(f\"attavo {argv[0]}: refused inside an executor (ATTAVO_STAGE is set); \"\n+              f\"the transport is the pass's, not the executor's\", file=sys.stderr)\n+        return 2\n     if argv[0] == \"doctor\":\n         return cmd_doctor(argv[1:])\n     if argv[0] == \"spec-gate\":","is_error":false}]},"parent_tool_use_id":null,"session_id":"5691906c-5ded-4857-9a37-715666a9a25d","uuid":"2f8522e1-8051-474c-87f7-984749b03170","timestamp":"2026-09-26T18:25:10.409Z","tool_use_result":{"stdout":"--- attavo/cli.py\t2026-09-26 12:23:41\n+++ attest/specs/224/stub/attavo/cli.py\t2026-09-26 12:23:41\n@@ -305,6 +305,7 @@\n \n from __future__ import annotations\n \n+import os\n import sys\n \n from attavo.approval import cmd_approval_status, cmd_approve\n@@ -322,10 +323,20 @@\n from attavo.verify import cmd_verify\n \n \n+TRANSPORT = (\"drive\", \"worker\", \"build\", \"verify\", \"counsel\", \"file-stops\")\n+\n+\n def main(argv: list[str]) -> int:\n     if not argv or argv[0] in (\"-h\", \"--help\"):\n         print(__doc__.strip())\n         return 0 if argv else 2\n+    if argv[0] in TRANSPORT and os.environ.get(\"ATTAVO_STAGE\"):\n+        # The product's transport is never the executor's tool: a stage\n+        # runs inside an invocation whose environment names the stage,\n+        # and nothing under it may start, judge, or record another.\n+        print(f\"attavo {argv[0]}: refused inside an executor (ATTAVO_STAGE is set); \"\n+              f\"the transport is the pass's, not the executor's\", file=sys.stderr)\n+        return 2\n     if argv[0] == \"doctor\":\n         return cmd_doctor(argv[1:])\n     if argv[0] == \"spec-gate\":","stderr":"","interrupted":false,"isImage":false,"returnCodeInterpretation":"Files differ","noOutputExpected":false}}

 are run for you and any failure is \\\"\\n             \\\"returned to you on the next iteration\\\")\\n \\n     return \\\"\\\\n\\\\n\\\".join(parts)\\n@@ -468,7 +470,16 @@\\n # specimen either.\\n SUBAGENT_TOOLS = [\\\"Agent\\\", \\\"Workflow\\\"]\\n \\n+# The raw test runner and the product's transport are not the executor's\\n+# tools: `attavo test` is the one test command (issue #212) and the pass\\n+# is the one transport. Permission-rule patterns, prefix-matched by the\\n+# tool; the product refuses its transport on its own account too\\n+# (ATTAVO_STAGE), so the second half here is belt beside braces.\\n+DENIED_COMMANDS = [\\\"Bash(pytest:*)\\\", \\\"Bash(python3 -m pytest:*)\\\", \\\"Bash(python -m pytest:*)\\\",\\n+                   \\\"Bash(npm test:*)\\\", \\\"Bash(npx vitest:*)\\\", \\\"Bash(go test:*)\\\", \\\"Bash(cargo test:*)\\\",\\n+                   \\\"Bash(attavo drive:*)\\\", \\\"Bash(attavo worker:*)\\\"]\\n \\n+\\n def load_config() -> dict:\\n     raw = os.environ.get(\\\"ATTAVO_ADAPTER_CONFIG\\\")\\n     return json.loads(raw) if raw else {}\\n@@ -559,7 +570,7 @@\\n            \\\"--json-schema\\\", json.dumps(schema),\\n            \\\"--permission-mode\\\", permission_mode,\\n            \\\"--allowedTools\\\", \\\",\\\".join(allowed_tools),\\n-           \\\"--disallowedTools\\\", \\\",\\\".join(SUBAGENT_TOOLS)]\\n+           \\\"--disallowedTools\\\", \\\",\\\".join(SUBAGENT_TOOLS + DENIED_COMMANDS)]\\n     model = config.get(\\\"model\\\")\\n     if model:\\n         cmd += [\\\"--model\\\", model]\\n\\n=== adapters/claude-code/conformance.json ===\\n--- adapters/claude-code/conformance.json\\t2026-09-26 12:23:41\\n+++ attest/specs/224/stub/adapters/claude-code/conformance.json\\t2026-09-26 12:23:41\\n@@ -11,6 +11,10 @@\\n     \\\"reason\\\": \\\"claude code documents no numeric input-size ceiling anywhere in its own surface (--help, docs, or any config file, confirmed against claude 2.1.269) -- this adapter asserts its own instruction stays under a fixed 64 KB bound instead\\\"\\n   },\\n   \\\"success_script\\\": \\\"#!/bin/sh\\\\ngit commit -q --allow-empty -m 'adapter commit'\\\\nprintf '{\\\\\\\"type\\\\\\\": \\\\\\\"result\\\\\\\", \\\\\\\"is_error\\\\\\\": false, \\\\\\\"structured_output\\\\\\\": {\\\\\\\"status\\\\\\\": \\\\\\\"done\\\\\\\", \\\\\\\"question\\\\\\\": null}, \\\\\\\"usage\\\\\\\": {\\\\\\\"input_tokens\\\\\\\": 1, \\\\\\\"output_tokens\\\\\\\": 1}, \\\\\\\"modelUsage\\\\\\\": {\\\\\\\"claude-sonnet-5\\\\\\\": {\\\\\\\"inputTokens\\\\\\\": 1, \\\\\\\"outputTokens\\\\\\\": 1}}}\\\\\\\\n'\\\\n\\\",\\n+  \\\"denied_commands\\\": {\\n+    \\\"mechanism\\\": \\\"--disallowedTools permission-rule patterns, prefix-matched by the tool\\\",\\n+    \\\"patterns\\\": [\\\"Bash(pytest:*)\\\", \\\"Bash(python3 -m pytest:*)\\\", \\\"Bash(python -m pytest:*)\\\", \\\"Bash(npm test:*)\\\", \\\"Bash(npx vitest:*)\\\", \\\"Bash(go test:*)\\\", \\\"Bash(cargo test:*)\\\", \\\"Bash(attavo drive:*)\\\", \\\"Bash(attavo worker:*)\\\"]\\n+  },\\n   \\\"subagent_guard\\\": {\\n     \\\"supported\\\": true,\\n     \\\"situation\\\": \\\"subagent_spawned\\\",\\n\\n=== adapters/codex/run ===\\n--- adapters/codex/run\\t2026-09-26 12:23:41\\n+++ attest/specs/224/stub/adapters/codex/run\\t2026-09-26 12:23:41\\n@@ -276,8 +276,10 @@\\n             f\\\"to run tests while you work, run `{test_command}`: it runs the tests \\\"\\n             \\\"selected for the files you have changed\\\"\\n             + (f\\\" and stops at {bound} s\\\" if bound else \\\"\\\")\\n-            + \\\". Do not run the whole test suite or any whole-tree check yourself: \\\"\\n-            \\\"after you commit, the gates are run for you and any failure is \\\"\\n+            + \\\". Run a single test with `\\\" + test_command + \\\" <path or test id>`. \\\"\\n+            \\\"Do not run the test runner directly, the whole test suite, or any \\\"\\n+            \\\"whole-tree check yourself: when the criteria and \\\" + \\\"`\\\" + test_command + \\\"`\\\"\\n+            + \\\" pass, commit and stop; the gates are run for you and any failure is \\\"\\n             \\\"returned to you on the next iteration\\\")\\n \\n     return \\\"\\\\n\\\\n\\\".join(parts)\\n\\n=== adapters/codex/conformance.json ===\\n--- adapters/codex/conformance.json\\t2026-09-26 12:23:41\\n+++ attest/specs/224/stub/adapters/codex/conformance.json\\t2026-09-26 12:23:41\\n@@ -10,6 +10,10 @@\\n     \\\"value\\\": 1048576,\\n     \\\"reason\\\": null\\n   },\\n+  \\\"denied_commands\\\": {\\n+    \\\"mechanism\\\": \\\"none per command: codex's sandbox governs writes and network, not command names; the instruction names the one test command and the product refuses its own transport under ATTAVO_STAGE\\\",\\n+    \\\"patterns\\\": []\\n+  },\\n   \\\"subagent_guard\\\": {\\n     \\\"supported\\\": false,\\n     \\\"reason\\\": \\\"codex exec's --help, its JSONL event stream (thread.*, turn.*, item.*), and its --output-schema/--output-last-message response name no subagent or background-task concept at all (confirmed against codex-cli 0.153.4) -- codex drives sandboxed shell commands as a single agent, with no tool of its own that could spawn work outliving this invocation the way issue #88's claude-code specimen did\\\"\\n\\n=== .attavo/bin/select-tests ===\\n--- .attavo/bin/select-tests\\t2026-09-26 12:23:41\\n+++ attest/specs/224/stub/.attavo/bin/select-tests\\t2026-09-26 12:23:41\\n@@ -63,6 +63,16 @@\\n     \\\".attavo/bin/select-tests\\\": (\\\"tests/test_self_tenancy.py\\\", \\\"tests/test_testtool.py\\\"),\\n }\\n \\n+# The modules most of the others import: no table of tests-per-module can\\n+# know what a change to one of these breaks, so each selects the whole\\n+# suite, and each is named here so that a new module under attavo/ must be\\n+# placed -- in MODULE_TESTS or in this tuple -- before the suite accepts it\\n+# (tests/test_testtool.py).\\n+SHARED_MODULES: tuple[str, ...] = (\\n+    \\\"attavo/__init__.py\\\", \\\"attavo/approval.py\\\", \\\"attavo/common.py\\\", \\\"attavo/events.py\\\",\\n+    \\\"attavo/records.py\\\", \\\"attavo/spec.py\\\", \\\"attavo/stops.py\\\",\\n+)\\n+\\n PREFIX_TESTS: tuple[tuple[str, tuple[str, ...]], ...] = (\\n     (\\\"adapters/claude-code/\\\", (\\\"tests/test_adapters.py\\\", \\\"tests/test_adapter_claude_code.py\\\",\\n                                \\\"tests/test_executor_conformance.py\\\")),\\n\\n=== tests/test_testtool.py ===\\n--- tests/test_testtool.py\\t2026-09-26 12:23:41\\n+++ attest/specs/224/stub/tests/test_testtool.py\\t2026-09-26 12:23:41\\n@@ -244,3 +244,148 @@\\n     assert m[\\\"tests\\\"][\\\"call_timeout_s\\\"] <= 300, m[\\\"tests\\\"]\\n     jsonschema.validate(m[\\\"checks\\\"], MANIFEST_SCHEMA[\\\"properties\\\"][\\\"checks\\\"])\\n     jsonschema.validate(m[\\\"tests\\\"], MANIFEST_SCHEMA[\\\"properties\\\"][\\\"tests\\\"])\\n+\\n+\\n+# --- the test tool as the executor's only way to run tests (v0.28.0's first\\n+# item). Specimen: #219's attempt 2 ran pytest directly 32 times against 2\\n+# runs of `attavo test` and spent a third of its 7,668 s after the tree was\\n+# green; attempt 3 ran it 0 times and passed in 247 s. Tests written red\\n+# first against v0.28.0 (f8b39f9): no cache, no modes, no test event, no\\n+# exclusion, the transport accepted inside an executor, the raw runner\\n+# allowed. ---\\n+\\n+MODES = ('[tests]\\\\nselect = \\\"sed -n s#^src/#tests/test_#p\\\"\\\\n'\\n+         'run = \\\"sh -c \\\\'cat > selected.txt; echo run >> runs.log; cat selected.txt\\\\'\\\"\\\\n'\\n+         'exclude_in_executor = [\\\"tests/test_slow.py\\\"]')\\n+\\n+\\n+def modes_tenant(tmp_path: Path) -> Path:\\n+    \\\"\\\"\\\"build_valid with src/a.py on main and src/b.py on the item's branch,\\n+    a selector that maps src/X to tests/test_X, and a run command that\\n+    counts its own runs.\\\"\\\"\\\"\\n+    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n+    toml = root / \\\"attavo.toml\\\"\\n+    toml.write_text(toml.read_text().replace('[tests]\\\\nselect = \\\"cat\\\"\\\\nrun = \\\"true\\\"', MODES))\\n+    (root / \\\".gitignore\\\").write_text(\\\"selected.txt\\\\nruns.log\\\\n\\\")\\n+    (root / \\\"src\\\").mkdir()\\n+    (root / \\\"src\\\" / \\\"a.py\\\").write_text(\\\"x = 1\\\\n\\\")\\n+    commit_all(root, \\\"configure\\\")\\n+    git(root, \\\"update-ref\\\", \\\"refs/remotes/origin/main\\\", git(root, \\\"rev-parse\\\", \\\"HEAD\\\").strip())\\n+    git(root, \\\"symbolic-ref\\\", \\\"refs/remotes/origin/HEAD\\\", \\\"refs/remotes/origin/main\\\")\\n+    git(root, \\\"checkout\\\", \\\"-q\\\", \\\"-b\\\", \\\"attavo/1-x\\\")\\n+    (root / \\\"src\\\" / \\\"b.py\\\").write_text(\\\"y = 2\\\\n\\\")\\n+    commit_all(root, \\\"change b\\\")\\n+    return root\\n+\\n+\\n+def runs(root: Path) -> int:\\n+    log = root / \\\"runs.log\\\"\\n+    return log.read_text().count(\\\"run\\\") if log.is_file() else 0\\n+\\n+\\n+def selected(root: Path) -> list[str]:\\n+    return sorted((root / \\\"selected.txt\\\").read_text().split())\\n+\\n+\\n+def test_attavo_test_answers_from_the_cache_on_an_unchanged_tree(tmp_path: Path) -> None:\\n+    root = modes_tenant(tmp_path)\\n+    assert run_attavo(root, \\\"test\\\", \\\"1\\\").returncode == 0\\n+    assert runs(root) == 1 and selected(root) == [\\\"tests/test_b.py\\\"]\\n+    started = time.monotonic()\\n+    second = run_attavo(root, \\\"test\\\", \\\"1\\\")\\n+    assert time.monotonic() - started < 5\\n+    assert second.returncode == 0 and runs(root) == 1, second.stdout + second.stderr\\n+    assert \\\"not rerun\\\" in second.stdout and \\\"--fresh\\\" in second.stdout, second.stdout\\n+    (root / \\\"src\\\" / \\\"b.py\\\").write_text(\\\"y = 3\\\\n\\\")\\n+    assert run_attavo(root, \\\"test\\\", \\\"1\\\").returncode == 0 and runs(root) == 2, \\\"an edited tree was answered from the cache\\\"\\n+    assert run_attavo(root, \\\"test\\\", \\\"1\\\", \\\"--fresh\\\").returncode == 0 and runs(root) == 3\\n+    failing = root / \\\"attavo.toml\\\"\\n+    failing.write_text(failing.read_text().replace(\\\"cat selected.txt'\\\", \\\"cat selected.txt; exit 1'\\\"))\\n+    assert run_attavo(root, \\\"test\\\", \\\"1\\\").returncode == 1 and runs(root) == 4\\n+    assert run_attavo(root, \\\"test\\\", \\\"1\\\").returncode == 1 and runs(root) == 5, \\\"a failing run was cached\\\"\\n+\\n+\\n+def test_attavo_test_runs_a_named_test_and_the_whole_suite_on_request(tmp_path: Path) -> None:\\n+    root = modes_tenant(tmp_path)\\n+    named = run_attavo(root, \\\"test\\\", \\\"1\\\", \\\"tests/test_a.py::test_a\\\")\\n+    assert named.returncode == 0 and selected(root) == [\\\"tests/test_a.py::test_a\\\"], named.stdout + named.stderr\\n+    whole = run_attavo(root, \\\"test\\\", \\\"1\\\", \\\"--all\\\")\\n+    assert whole.returncode == 0 and selected(root) == [\\\"tests\\\"], whole.stdout + whole.stderr\\n+    mapped = run_attavo(root, \\\"test\\\", \\\"1\\\")\\n+    assert mapped.returncode == 0 and selected(root) == [\\\"tests/test_b.py\\\"], mapped.stdout + mapped.stderr\\n+    both = run_attavo(root, \\\"test\\\", \\\"1\\\", \\\"--all\\\", \\\"tests/test_a.py\\\")\\n+    assert both.returncode == 2 and \\\"not both\\\" in both.stderr, both.stdout + both.stderr\\n+\\n+\\n+def test_attavo_test_writes_one_event_per_run(tmp_path: Path) -> None:\\n+    root = modes_tenant(tmp_path)\\n+    events_file = tmp_path / \\\"events.jsonl\\\"\\n+    env = {\\\"ATTAVO_EVENTS\\\": str(events_file)}\\n+    assert run_attavo(root, \\\"test\\\", \\\"1\\\", \\\"tests/test_a.py::test_a\\\", env=env).returncode == 0\\n+    assert run_attavo(root, \\\"test\\\", \\\"1\\\", \\\"--all\\\", env=env).returncode == 0\\n+    assert run_attavo(root, \\\"test\\\", \\\"1\\\", env=env).returncode == 0\\n+    assert run_attavo(root, \\\"test\\\", \\\"1\\\", env=env).returncode == 0\\n+    rows = [json.loads(line) for line in events_file.read_text().splitlines() if line.strip()]\\n+    texts = [r[\\\"text\\\"] for r in rows if r[\\\"kind\\\"] == \\\"test\\\"]\\n+    assert len(texts) == 4, rows\\n+    assert \\\"mode named, 1 selected, exit 0\\\" in texts[0], texts\\n+    assert \\\"mode all, 1 selected, exit 0\\\" in texts[1], texts\\n+    assert \\\"mode mapped, 1 selected, exit 0\\\" in texts[2] and texts[2].endswith(\\\" s\\\"), texts\\n+    assert texts[3].endswith(\\\"cached\\\"), texts\\n+\\n+\\n+def test_attavo_test_leaves_out_excluded_tests_inside_an_executor(tmp_path: Path) -> None:\\n+    root = modes_tenant(tmp_path)\\n+    (root / \\\"src\\\" / \\\"slow.py\\\").write_text(\\\"z = 1\\\\n\\\")\\n+    commit_all(root, \\\"change slow\\\")\\n\\n=== tests/test_adapters.py ===\\n--- tests/test_adapters.py\\t2026-09-26 12:23:41\\n+++ attest/specs/224/stub/tests/test_adapters.py\\t2026-09-26 12:23:41\\n@@ -250,7 +250,7 @@\\n     instruction = with_tool[with_tool.index(\\\"-p\\\") + 1]\\n     assert \\\"are run for you\\\" in instruction\\n     assert \\\"before you commit\\\" not in instruction\\n-    assert \\\"Do not run the whole test suite\\\" in instruction\\n+    assert \\\"Do not run the test runner directly, the whole test suite\\\" in instruction\\n \\n     without_tool = dry_run(tmp_path)\\n     instruction_without = without_tool[without_tool.index(\\\"-p\\\") + 1]\\n@@ -474,10 +474,10 @@\\n     tenant-zero specimen made with neither tool in it at all.\\n     \\\"\\\"\\\"\\n     build = dry_run(tmp_path)\\n-    assert build[build.index(\\\"--disallowedTools\\\") + 1] == \\\"Agent,Workflow\\\"\\n+    assert build[build.index(\\\"--disallowedTools\\\") + 1].startswith(\\\"Agent,Workflow,\\\")\\n \\n     verify = dry_run(tmp_path, extra_env={\\\"ATTAVO_STAGE\\\": \\\"verify\\\"})\\n-    assert verify[verify.index(\\\"--disallowedTools\\\") + 1] == \\\"Agent,Workflow\\\"\\n+    assert verify[verify.index(\\\"--disallowedTools\\\") + 1].startswith(\\\"Agent,Workflow,\\\")\\n \\n \\n def test_claude_code_refuses_a_result_with_spawned_subagents(tmp_path: Path) -> None:\\n@@ -716,7 +716,7 @@\\n     assert settings[\\\"sandbox\\\"][\\\"network\\\"][\\\"allowedDomains\\\"] == []\\n     assert settings[\\\"sandbox\\\"][\\\"filesystem\\\"][\\\"denyWrite\\\"] == [str(Path.cwd())]\\n     assert cmd[cmd.index(\\\"--allowedTools\\\") + 1] == \\\"Read,Bash\\\"\\n-    assert cmd[cmd.index(\\\"--disallowedTools\\\") + 1] == \\\"Agent,Workflow\\\"\\n+    assert cmd[cmd.index(\\\"--disallowedTools\\\") + 1].startswith(\\\"Agent,Workflow,\\\")\\n \\n \\n def test_claude_code_counsel_names_the_product_root_and_the_record(tmp_path: Path) -> None:\\n\\n=== tests/test_cli_help.py ===\\n--- tests/test_cli_help.py\\t2026-09-26 12:23:41\\n+++ attest/specs/224/stub/tests/test_cli_help.py\\t2026-09-26 12:23:41\\n@@ -71,3 +71,16 @@\\n         cwd=str(ROOT), capture_output=True, text=True, check=False)\\n     assert run.returncode == 1, run.stdout\\n     assert run.stdout == \\\"\\\"\\n+\\n+\\n+def test_help_names_the_test_modes_the_cache_and_the_transport_refusal() -> None:\\n+    \\\"\\\"\\\"The test tool as the executor's only way to run tests (v0.28.0's\\n+    first item): the help names the three modes, --fresh and the cache,\\n+    exclude_in_executor, and that the transport refuses inside an\\n+    executor. Red on the tree and on the stub: the words are the build's.\\\"\\\"\\\"\\n+    run = subprocess.run([sys.executable, str(ATTAVO), \\\"--help\\\"],\\n+                         capture_output=True, text=True, check=False)\\n+    assert run.returncode == 0\\n+    assert \\\"attavo test [N] [--all | <test>...] [--fresh]\\\" in run.stdout, run.stdout\\n+    for phrase in (\\\"--fresh\\\", \\\"unchanged\\\", \\\"exclude_in_executor\\\", \\\"ATTAVO_STAGE\\\", \\\"refuse\\\"):\\n+        assert phrase in run.stdout, phrase\\n\\n=== tests/test_record_schemas.py ===\\n--- tests/test_record_schemas.py\\t2026-09-26 12:23:41\\n+++ attest/specs/224/stub/tests/test_record_schemas.py\\t2026-09-26 12:23:41\\n@@ -418,8 +418,9 @@\\n     \\\"\\\"\\\"Acceptance 6: _load_record is the one place in this repository\\n     that turns a <stage>-NN.json record's bytes into a dict; parse_attempts\\n     and load_records both read through it rather than calling json.loads\\n-    themselves. `git grep -n \\\"json.loads(\\\" bin/attavo` still finds seven\\n-    other sites -- a schema file, an adapter's conformance.json (read\\n+    themselves. `git grep -n \\\"json.loads(\\\" bin/attavo` still finds eight\\n+    other sites -- a schema file, attavo test's own cache of exit-0 runs\\n+    under the git directory (never a record), an adapter's conformance.json (read\\n     twice: once for its declared reports, once for R3's own\\n     streams_events), an adapter's own stdout report, proof four's own\\n     read of one log line at a time to tell an adapter's JSON event\\n@@ -428,7 +429,7 @@\\n     own read of the forge checks a drive pass already wrote (issue #217,\\n     ATTAVO_FORGE_CHECKS) -- none of them a record.\\\"\\\"\\\"\\n     text = \\\"\\\\n\\\".join(p.read_text() for p in sorted((ROOT / \\\"attavo\\\").rglob(\\\"*.py\\\")))\\n-    assert text.count(\\\"json.loads(\\\") == 8, (\\n+    assert text.count(\\\"json.loads(\\\") == 9, (\\n         \\\"a new json.loads( site was added; review it against issue #60 acceptance 6 \\\"\\n         \\\"and update this count\\\")\\n     assert \\\"data = json.loads(path.read_text())\\\" in text\",\"is_error\":false}]},\"parent_tool_use_id\":null,\"session_id\":\"5691906c-5ded-4857-9a37-715666a9a25d\",\"uuid\":\"914ed26f-4d7e-4836-b651-4147f30c5cfb\",\"timestamp\":\"2026-09-26T18:24:14.677Z\",\"tool_use_result\":{\"stdout\":\"=== attavo/cli.py ===\\n--- attavo/cli.py\\t2026-09-26 12:23:41\\n+++ attest/specs/224/stub/attavo/cli.py\\t2026-09-26 12:23:41\\n@@ -305,6 +305,7 @@\\n \\n from __future__ import annotations\\n \\n+import os\\n import sys\\n \\n from attavo.approval import cmd_approval_status, cmd_approve\\n@@ -322,10 +323,20 @@\\n from attavo.verify import cmd_verify\\n \\n \\n+TRANSPORT = (\\\"drive\\\", \\\"worker\\\", \\\"build\\\", \\\"verify\\\", \\\"counsel\\\", \\\"file-stops\\\")\\n+\\n+\\n def main(argv: list[str]) -> int:\\n     if not argv or argv[0] in (\\\"-h\\\", \\\"--help\\\"):\\n         print(__doc__.strip())\\n         return 0 if argv else 2\\n+    if argv[0] in TRANSPORT and os.environ.get(\\\"ATTAVO_STAGE\\\"):\\n+        # The product's transport is never the executor's tool: a stage\\n+        # runs inside an invocation whose environment names the stage,\\n+        # and nothing under it may start, judge, or record another.\\n+        print(f\\\"attavo {argv[0]}: refused inside an executor (ATTAVO_STAGE is set); \\\"\\n+              f\\\"the transport is the pass's, not the executor's\\\", file=sys.stderr)\\n+        return 2\\n     if argv[0] == \\\"doctor\\\":\\n         return cmd_doctor(argv[1:])\\n     if argv[0] == \\\"spec-gate\\\":\\n\\n=== schema/manifest.schema.json ===\\n--- schema/manifest.schema.json\\t2026-09-26 12:23:41\\n+++ attest/specs/224/stub/schema/manifest.schema.json\\t2026-09-26 12:23:41\\n@@ -54,6 +54,11 @@\\n           \\\"description\\\": \\\"A command that reads touched paths on stdin, one per line, and writes test identifiers on stdout, one per line.\\\",\\n           \\\"minLength\\\": 1\\n         },\\n+        \\\"exclude_in_executor\\\": {\\n+          \\\"type\\\": \\\"array\\\",\\n+          \\\"items\\\": {\\\"type\\\": \\\"string\\\", \\\"minLength\\\": 1},\\n+          \\\"description\\\": \\\"Test identifiers attavo test leaves out when it runs inside an executor (ATTAVO_STAGE set): tests that need a live tenant, the network, or the process's own working directory. CI runs them.\\\"\\n+        },\\n         \\\"run\\\": {\\n           \\\"type\\\": \\\"string\\\",\\n           \\\"description\\\": \\\"A command that reads test identifiers on stdin, one per line; its exit code is the verdict.\\\",\\n\\n=== adapters/claude-code/run ===\\n--- adapters/claude-code/run\\t2026-09-26 12:23:41\\n+++ attest/specs/224/stub/adapters/claude-code/run\\t2026-09-26 12:23:41\\n@@ -281,8 +281,10 @@\\n             f\\\"to run tests while you work, run `{test_command}`: it runs the tests \\\"\\n             \\\"selected for the files you have changed\\\"\\n             + (f\\\" and stops at {bound} s\\\" if bound else \\\"\\\")\\n-            + \\\". Do not run the whole test suite or any whole-tree check yourself: \\\"\\n-            \\\"after you commit, the gates are run for you and any failure is \\\"\\n+            + \\\". Run a single test with `\\\" + test_command + \\\" <path or test id>`. \\\"\\n+            \\\"Do not run the test runner directly, the whole test suite, or any \\\"\\n+            \\\"whole-tree check yourself: when the criteria and \\\" + \\\"`\\\" + test_command + \\\"`\\\"\\n+            + \\\" pass, commit and stop; the gates are run for you and any failure is \\\"\\n             \\\"returned to you on the next iteration\\\")\\n \\n     return \\\"\\\\n\\\\n\\\".join(parts)\\n@@ -468,7 +470,16 @@\\n # specimen either.\\n SUBAGENT_TOOLS = [\\\"Agent\\\", \\\"Workflow\\\"]\\n \\n+# The raw test runner and the product's transport are not the executor's\\n+# tools: `attavo test` is the one test command (issue #212) and the pass\\n+# is the one transport. Permission-rule patterns, prefix-matched by the\\n+# tool; the product refuses its transport on its own account too\\n+# (ATTAVO_STAGE), so the second half here is belt beside braces.\\n+DENIED_COMMANDS = [\\\"Bash(pytest:*)\\\", \\\"Bash(python3 -m pytest:*)\\\", \\\"Bash(python -m pytest:*)\\\",\\n+                   \\\"Bash(npm test:*)\\\", \\\"Bash(npx vitest:*)\\\", \\\"Bash(go test:*)\\\", \\\"Bash(cargo test:*)\\\",\\n+                   \\\"Bash(attavo drive:*)\\\", \\\"Bash(attavo worker:*)\\\"]\\n \\n+\\n def load_config() -> dict:\\n     raw = os.environ.get(\\\"ATTAVO_ADAPTER_CONFIG\\\")\\n     return json.loads(raw) if raw else {}\\n@@ -559,7 +570,7 @@\\n            \\\"--json-schema\\\", json.dumps(schema),\\n            \\\"--permission-mode\\\", permission_mode,\\n            \\\"--allowedTools\\\", \\\",\\\".join(allowed_tools),\\n-           \\\"--disallowedTools\\\", \\\",\\\".join(SUBAGENT_TOOLS)]\\n+           \\\"--disallowedTools\\\", \\\",\\\".join(SUBAGENT_TOOLS + DENIED_COMMANDS)]\\n     model = config.get(\\\"model\\\")\\n     if model:\\n         cmd += [\\\"--model\\\", model]\\n\\n=== adapters/claude-code/conformance.json ===\\n--- adapters/claude-code/conformance.json\\t2026-09-26 12:23:41\\n+++ attest/specs/224/stub/adapters/claude-code/conformance.json\\t2026-09-26 12:23:41\\n@@ -11,6 +11,10 @@\\n     \\\"reason\\\": \\\"claude code documents no numeric input-size ceiling anywhere in its own surface (--help, docs, or any config file, confirmed against claude 2.1.269) -- this adapter asserts its own instruction stays under a fixed 64 KB bound instead\\\"\\n   },\\n   \\\"success_script\\\": \\\"#!/bin/sh\\\\ngit commit -q --allow-empty -m 'adapter commit'\\\\nprintf '{\\\\\\\"type\\\\\\\": \\\\\\\"result\\\\\\\", \\\\\\\"is_error\\\\\\\": false, \\\\\\\"structured_output\\\\\\\": {\\\\\\\"status\\\\\\\": \\\\\\\"done\\\\\\\", \\\\\\\"question\\\\\\\": null}, \\\\\\\"usage\\\\\\\": {\\\\\\\"input_tokens\\\\\\\": 1, \\\\\\\"output_tokens\\\\\\\": 1}, \\\\\\\"modelUsage\\\\\\\": {\\\\\\\"claude-sonnet-5\\\\\\\": {\\\\\\\"inputTokens\\\\\\\": 1, \\\\\\\"outputTokens\\\\\\\": 1}}}\\\\\\\\n'\\\\n\\\",\\n+  \\\"denied_commands\\\": {\\n+    \\\"mechanism\\\": \\\"--disallowedTools permission-rule patterns, prefix-matched by the tool\\\",\\n+    \\\"patterns\\\": [\\\"Bash(pytest:*)\\\", \\\"Bash(python3 -m pytest:*)\\\", \\\"Bash(python -m pytest:*)\\\", \\\"Bash(npm test:*)\\\", \\\"Bash(npx vitest:*)\\\", \\\"Bash(go test:*)\\\", \\\"Bash(cargo test:*)\\\", \\\"Bash(attavo drive:*)\\\", \\\"Bash(attavo worker:*)\\\"]\\n+  },\\n   \\\"subagent_guard\\\": {\\n     \\\"supported\\\": true,\\n     \\\"situation\\\": \\\"subagent_spawned\\\",\\n\\n=== adapters/codex/run ===\\n--- adapters/codex/run\\t2026-09-26 12:23:41\\n+++ attest/specs/224/stub/adapters/codex/run\\t2026-09-26 12:23:41\\n@@ -276,8 +276,10 @@\\n             f\\\"to run tests while you work, run `{test_command}`: it runs the tests \\\"\\n             \\\"selected for the files you have changed\\\"\\n             + (f\\\" and stops at {bound} s\\\" if bound else \\\"\\\")\\n-            + \\\". Do not run the whole test suite or any whole-tree check yourself: \\\"\\n-            \\\"after you commit, the gates are run for you and any failure is \\\"\\n+            + \\\". Run a single test with `\\\" + test_command + \\\" <path or test id>`. \\\"\\n+            \\\"Do not run the test runner directly, the whole test suite, or any \\\"\\n+            \\\"whole-tree check yourself: when the criteria and \\\" + \\\"`\\\" + test_command + \\\"`\\\"\\n+            + \\\" pass, commit and stop; the gates are run for you and any failure is \\\"\\n             \\\"returned to you on the next iteration\\\")\\n \\n     return \\\"\\\\n\\\\n\\\".join(parts)\\n\\n=== adapters/codex/conformance.json ===\\n--- adapters/codex/conformance.json\\t2026-09-26 12:23:41\\n+++ attest/specs/224/stub/adapters/codex/conformance.json\\t2026-09-26 12:23:41\\n@@ -10,6 +10,10 @@\\n     \\\"value\\\": 1048576,\\n     \\\"reason\\\": null\\n   },\\n+  \\\"denied_commands\\\": {\\n+    \\\"mechanism\\\": \\\"none per command: codex's sandbox governs writes and network, not command names; the instruction names the one test command and the product refuses its own transport under ATTAVO_STAGE\\\",\\n+    \\\"patterns\\\": []\\n+  },\\n   \\\"subagent_guard\\\": {\\n     \\\"supported\\\": false,\\n     \\\"reason\\\": \\\"codex exec's --help, its JSONL event stream (thread.*, turn.*, item.*), and its --output-schema/--output-last-message response name no subagent or background-task concept at all (confirmed against codex-cli 0.153.4) -- codex drives sandboxed shell commands as a single agent, with no tool of its own that could spawn work outliving this invocation the way issue #88's claude-code specimen did\\\"\\n\\n=== .attavo/bin/select-tests ===\\n--- .attavo/bin/select-tests\\t2026-09-26 12:23:41\\n+++ attest/specs/224/stub/.attavo/bin/select-tests\\t2026-09-26 12:23:41\\n@@ -63,6 +63,16 @@\\n     \\\".attavo/bin/select-tests\\\": (\\\"tests/test_self_tenancy.py\\\", \\\"tests/test_testtool.py\\\"),\\n }\\n \\n+# The modules most of the others import: no table of tests-per-module can\\n+# know what a change to one of these breaks, so each selects the whole\\n+# suite, and each is named here so that a new module under attavo/ must be\\n+# placed -- in MODULE_TESTS or in this tuple -- before the suite accepts it\\n+# (tests/test_testtool.py).\\n+SHARED_MODULES: tuple[str, ...] = (\\n+    \\\"attavo/__init__.py\\\", \\\"attavo/approval.py\\\", \\\"attavo/common.py\\\", \\\"attavo/events.py\\\",\\n+    \\\"attavo/records.py\\\", \\\"attavo/spec.py\\\", \\\"attavo/stops.py\\\",\\n+)\\n+\\n PREFIX_TESTS: tuple[tuple[str, tuple[str, ...]], ...] = (\\n     (\\\"adapters/claude-code/\\\", (\\\"tests/test_adapters.py\\\", \\\"tests/test_adapter_claude_code.py\\\",\\n                                \\\"tests/test_executor_conformance.py\\\")),\\n\\n=== tests/test_testtool.py ===\\n--- tests/test_testtool.py\\t2026-09-26 12:23:41\\n+++ attest/specs/224/stub/tests/test_testtool.py\\t2026-09-26 12:23:41\\n@@ -244,3 +244,148 @@\\n     assert m[\\\"tests\\\"][\\\"call_timeout_s\\\"] <= 300, m[\\\"tests\\\"]\\n     jsonschema.validate(m[\\\"checks\\\"], MANIFEST_SCHEMA[\\\"properties\\\"][\\\"checks\\\"])\\n     jsonschema.validate(m[\\\"tests\\\"], MANIFEST_SCHEMA[\\\"properties\\\"][\\\"tests\\\"])\\n+\\n+\\n+# --- the test tool as the executor's only way to run tests (v0.28.0's first\\n+# item). Specimen: #219's attempt 2 ran pytest directly 32 times against 2\\n+# runs of `attavo test` and spent a third of its 7,668 s after the tree was\\n+# green; attempt 3 ran it 0 times and passed in 247 s. Tests written red\\n+# first against v0.28.0 (f8b39f9): no cache, no modes, no test event, no\\n+# exclusion, the transport accepted inside an executor, the raw runner\\n+# allowed. ---\\n+\\n+MODES = ('[tests]\\\\nselect = \\\"sed -n s#^src/#tests/test_#p\\\"\\\\n'\\n+         'run = \\\"sh -c \\\\'cat > selected.txt; echo run >> runs.log; cat selected.txt\\\\'\\\"\\\\n'\\n+         'exclude_in_executor = [\\\"tests/test_slow.py\\\"]')\\n+\\n+\\n+def modes_tenant(tmp_path: Path) -> Path:\\n+    \\\"\\\"\\\"build_valid with src/a.py on main and src/b.py on the item's branch,\\n+    a selector that maps src/X to tests/test_X, and a run command that\\n+    counts its own runs.\\\"\\\"\\\"\\n+    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n+    toml = root / \\\"attavo.toml\\\"\\n+    toml.write_text(toml.read_text().replace('[tests]\\\\nselect = \\\"cat\\\"\\\\nrun = \\\"true\\\"', MODES))\\n+    (root / \\\".gitignore\\\").write_text(\\\"selected.txt\\\\nruns.log\\\\n\\\")\\n+    (root / \\\"src\\\").mkdir()\\n+    (root / \\\"src\\\" / \\\"a.py\\\").write_text(\\\"x = 1\\\\n\\\")\\n+    commit_all(root, \\\"configure\\\")\\n+    git(root, \\\"update-ref\\\", \\\"refs/remotes/origin/main\\\", git(root, \\\"rev-parse\\\", \\\"HEAD\\\").strip())\\n+    git(root, \\\"symbolic-ref\\\", \\\"refs/remotes/origin/HEAD\\\", \\\"refs/remotes/origin/main\\\")\\n+    git(root, \\\"checkout\\\", \\\"-q\\\", \\\"-b\\\", \\\"attavo/1-x\\\")\\n+    (root / \\\"src\\\" / \\\"b.py\\\").write_text(\\\"y = 2\\\\n\\\")\\n+    commit_all(root, \\\"change b\\\")\\n+    return root\\n+\\n+\\n+def runs(root: Path) -> int:\\n+    log = root / \\\"runs.log\\\"\\n+    return log.read_text().count(\\\"run\\\") if log.is_file() else 0\\n+\\n+\\n+def selected(root: Path) -> list[str]:\\n+    return sorted((root / \\\"selected.txt\\\").read_text().split())\\n+\\n+\\n+def test_attavo_test_answers_from_the_cache_on_an_unchanged_tree(tmp_path: Path) -> None:\\n+    root = modes_tenant(tmp_path)\\n+    assert run_attavo(root, \\\"test\\\", \\\"1\\\").returncode == 0\\n+    assert runs(root) == 1 and selected(root) == [\\\"tests/test_b.py\\\"]\\n+    started = time.monotonic()\\n+    second = run_attavo(root, \\\"test\\\", \\\"1\\\")\\n+    assert time.monotonic() - started < 5\\n+    assert second.returncode == 0 and runs(root) == 1, second.stdout + second.stderr\\n+    assert \\\"not rerun\\\" in second.stdout and \\\"--fresh\\\" in second.stdout, second.stdout\\n+    (root / \\\"src\\\" / \\\"b.py\\\").write_text(\\\"y = 3\\\\n\\\")\\n+    assert run_attavo(root, \\\"test\\\", \\\"1\\\").returncode == 0 and runs(root) == 2, \\\"an edited tree was answered from the cache\\\"\\n+    assert run_attavo(root, \\\"test\\\", \\\"1\\\", \\\"--fresh\\\").returncode == 0 and runs(root) == 3\\n+    failing = root / \\\"attavo.toml\\\"\\n+    failing.write_text(failing.read_text().replace(\\\"cat selected.txt'\\\", \\\"cat selected.txt; exit 1'\\\"))\\n+    assert run_attavo(root, \\\"test\\\", \\\"1\\\").returncode == 1 and runs(root) == 4\\n+    assert run_attavo(root, \\\"test\\\", \\\"1\\\").returncode == 1 and runs(root) == 5, \\\"a failing run was cached\\\"\\n+\\n+\\n+def test_attavo_test_runs_a_named_test_and_the_whole_suite_on_request(tmp_path: Path) -> None:\\n+    root = modes_tenant(tmp_path)\\n+    named = run_attavo(root, \\\"test\\\", \\\"1\\\", \\\"tests/test_a.py::test_a\\\")\\n+    assert named.returncode == 0 and selected(root) == [\\\"tests/test_a.py::test_a\\\"], named.stdout + named.stderr\\n+    whole = run_attavo(root, \\\"test\\\", \\\"1\\\", \\\"--all\\\")\\n+    assert whole.returncode == 0 and selected(root) == [\\\"tests\\\"], whole.stdout + whole.stderr\\n+    mapped = run_attavo(root, \\\"test\\\", \\\"1\\\")\\n+    assert mapped.returncode == 0 and selected(root) == [\\\"tests/test_b.py\\\"], mapped.stdout + mapped.stderr\\n+    both = run_attavo(root, \\\"test\\\", \\\"1\\\", \\\"--all\\\", \\\"tests/test_a.py\\\")\\n+    assert both.returncode == 2 and \\\"not both\\\" in both.stderr, both.stdout + both.stderr\\n+\\n+\\n+def test_attavo_test_writes_one_event_per_run(tmp_path: Path) -> None:\\n+    root = modes_tenant(tmp_path)\\n+    events_file = tmp_path / \\\"events.jsonl\\\"\\n+    env = {\\\"ATTAVO_EVENTS\\\": str(events_file)}\\n+    assert run_attavo(root, \\\"test\\\", \\\"1\\\", \\\"tests/test_a.py::test_a\\\", env=env).returncode == 0\\n+    assert run_attavo(root, \\\"test\\\", \\\"1\\\", \\\"--all\\\", env=env).returncode == 0\\n+    assert run_attavo(root, \\\"test\\\", \\\"1\\\", env=env).returncode == 0\\n+    assert run_attavo(root, \\\"test\\\", \\\"1\\\", env=env).returncode == 0\\n+    rows = [json.loads(line) for line in events_file.read_text().splitlines() if line.strip()]\\n+    texts = [r[\\\"text\\\"] for r in rows if r[\\\"kind\\\"] == \\\"test\\\"]\\n+    assert len(texts) == 4, rows\\n+    assert \\\"mode named, 1 selected, exit 0\\\" in texts[0], texts\\n+    assert \\\"mode all, 1 selected, exit 0\\\" in texts[1], texts\\n+    assert \\\"mode mapped, 1 selected, exit 0\\\" in texts[2] and texts[2].endswith(\\\" s\\\"), texts\\n+    assert texts[3].endswith(\\\"cached\\\"), texts\\n+\\n+\\n+def test_attavo_test_leaves_out_excluded_tests_inside_an_executor(tmp_path: Path) -> None:\\n+    root = modes_tenant(tmp_path)\\n+    (root / \\\"src\\\" / \\\"slow.py\\\").write_text(\\\"z = 1\\\\n\\\")\\n+    commit_all(root, \\\"change slow\\\")\\n\\n=== tests/test_adapters.py ===\\n--- tests/test_adapters.py\\t2026-09-26 12:23:41\\n+++ attest/specs/224/stub/tests/test_adapters.py\\t2026-09-26 12:23:41\\n@@ -250,7 +250,7 @@\\n     instruction = with_tool[with_tool.index(\\\"-p\\\") + 1]\\n     assert \\\"are run for you\\\" in instruction\\n     assert \\\"before you commit\\\" not in instruction\\n-    assert \\\"Do not run the whole test suite\\\" in instruction\\n+    assert \\\"Do not run the test runner directly, the whole test suite\\\" in instruction\\n \\n     without_tool = dry_run(tmp_path)\\n     instruction_without = without_tool[without_tool.index(\\\"-p\\\") + 1]\\n@@ -474,10 +474,10 @@\\n     tenant-zero specimen made with neither tool in it at all.\\n     \\\"\\\"\\\"\\n     build = dry_run(tmp_path)\\n-    assert build[build.index(\\\"--disallowedTools\\\") + 1] == \\\"Agent,Workflow\\\"\\n+    assert build[build.index(\\\"--disallowedTools\\\") + 1].startswith(\\\"Agent,Workflow,\\\")\\n \\n     verify = dry_run(tmp_path, extra_env={\\\"ATTAVO_STAGE\\\": \\\"verify\\\"})\\n-    assert verify[verify.index(\\\"--disallowedTools\\\") + 1] == \\\"Agent,Workflow\\\"\\n+    assert verify[verify.index(\\\"--disallowedTools\\\") + 1].startswith(\\\"Agent,Workflow,\\\")\\n \\n \\n def test_claude_code_refuses_a_result_with_spawned_subagents(tmp_path: Path) -> None:\\n@@ -716,7 +716,7 @@\\n     assert settings[\\\"sandbox\\\"][\\\"network\\\"][\\\"allowedDomains\\\"] == []\\n     assert settings[\\\"sandbox\\\"][\\\"filesystem\\\"][\\\"denyWrite\\\"] == [str(Path.cwd())]\\n     assert cmd[cmd.index(\\\"--allowedTools\\\") + 1] == \\\"Read,Bash\\\"\\n-    assert cmd[cmd.index(\\\"--disallowedTools\\\") + 1] == \\\"Agent,Workflow\\\"\\n+    assert cmd[cmd.index(\\\"--disallowedTools\\\") + 1].startswith(\\\"Agent,Workflow,\\\")\\n \\n \\n def test_claude_code_counsel_names_the_product_root_and_the_record(tmp_path: Path) -> None:\\n\\n=== tests/test_cli_help.py ===\\n--- tests/test_cli_help.py\\t2026-09-26 12:23:41\\n+++ attest/specs/224/stub/tests/test_cli_help.py\\t2026-09-26 12:23:41\\n@@ -71,3 +71,16 @@\\n         cwd=str(ROOT), capture_output=True, text=True, check=False)\\n     assert run.returncode == 1, run.stdout\\n     assert run.stdout == \\\"\\\"\\n+\\n+\\n+def test_help_names_the_test_modes_the_cache_and_the_transport_refusal() -> None:\\n+    \\\"\\\"\\\"The test tool as the executor's only way to run tests (v0.28.0's\\n+    first item): the help names the three modes, --fresh and the cache,\\n+    exclude_in_executor, and that the transport refuses inside an\\n+    executor. Red on the tree and on the stub: the words are the build's.\\\"\\\"\\\"\\n+    run = subprocess.run([sys.executable, str(ATTAVO), \\\"--help\\\"],\\n+                         capture_output=True, text=True, check=False)\\n+    assert run.returncode == 0\\n+    assert \\\"attavo test [N] [--all | <test>...] [--fresh]\\\" in run.stdout, run.stdout\\n+    for phrase in (\\\"--fresh\\\", \\\"unchanged\\\", \\\"exclude_in_executor\\\", \\\"ATTAVO_STAGE\\\", \\\"refuse\\\"):\\n+        assert phrase in run.stdout, phrase\\n\\n=== tests/test_record_schemas.py ===\\n--- tests/test_record_schemas.py\\t2026-09-26 12:23:41\\n+++ attest/specs/224/stub/tests/test_record_schemas.py\\t2026-09-26 12:23:41\\n@@ -418,8 +418,9 @@\\n     \\\"\\\"\\\"Acceptance 6: _load_record is the one place in this repository\\n     that turns a <stage>-NN.json record's bytes into a dict; parse_attempts\\n     and load_records both read through it rather than calling json.loads\\n-    themselves. `git grep -n \\\"json.loads(\\\" bin/attavo` still finds seven\\n-    other sites -- a schema file, an adapter's conformance.json (read\\n+    themselves. `git grep -n \\\"json.loads(\\\" bin/attavo` still finds eight\\n+    other sites -- a schema file, attavo test's own cache of exit-0 runs\\n+    under the git directory (never a record), an adapter's conformance.json (read\\n     twice: once for its declared reports, once for R3's own\\n     streams_events), an adapter's own stdout report, proof four's own\\n     read of one log line at a time to tell an adapter's JSON event\\n@@ -428,7 +429,7 @@\\n     own read of the forge checks a drive pass already wrote (issue #217,\\n     ATTAVO_FORGE_CHECKS) -- none of them a record.\\\"\\\"\\\"\\n     text = \\\"\\\\n\\\".join(p.read_text() for p in sorted((ROOT / \\\"attavo\\\").rglob(\\\"*.py\\\")))\\n-    assert tex
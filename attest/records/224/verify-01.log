test: the executor's one test command (issue #212) --\\n13\\t# The tests [tests].select names for every path the item has changed since\\n14\\t# it left the default branch, run through [tests].run, bounded by\\n15\\t# [tests].call_timeout_s. The executor is given this and not the tenant's\\n16\\t# whole-tree checks: given a checks command it ran it (#194's 590 s wait;\\n17\\t# #204 and #206 ran the suite twice inside one build), and the gate runs\\n18\\t# them after every commit whatever the executor does. ---\\n19\\t\\n20\\tTIMED_OUT_EXIT = 124\\n21\\t\\n22\\t# What an ended run is given to leave on its own after SIGTERM, before its\\n23\\t# whole process group is sent SIGKILL.\\n24\\tEND_GRACE_S = 2\\n25\\t\\n26\\t\\n27\\tdef _signal_group(proc: \\\"subprocess.Popen[str]\\\", sig: int) -> None:\\n28\\t    try:\\n29\\t        os.killpg(proc.pid, sig)\\n30\\t    except ProcessLookupError:\\n31\\t        pass\\n32\\t\\n33\\t\\n34\\tdef run_bounded(command: str, root: Path, stdin: str, timeout_s: int | None\\n35\\t                ) -> tuple[int, str, str, bool]:\\n36\\t    \\\"\\\"\\\"(exit, stdout, stderr, timed_out) of `command` run through the shell\\n37\\t    from root. The command is its own process group's leader, so a run past\\n38\\t    timeout_s is ended with everything it started -- a test runner's\\n39\\t    workers and a shell's background jobs alike -- rather than only the\\n40\\t    shell, which would leave them holding the pipes and the machine. A run\\n41\\t    that outlasts its bound exits 124, as timeout(1) does.\\\"\\\"\\\"\\n42\\t    proc = subprocess.Popen(command, shell=True, cwd=str(root), stdin=subprocess.PIPE,\\n43\\t                            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,\\n44\\t                            start_new_session=True)\\n45\\t    try:\\n46\\t        out, err = proc.communicate(stdin, timeout=timeout_s)\\n47\\t    except subprocess.TimeoutExpired:\\n48\\t        _signal_group(proc, signal.SIGTERM)\\n49\\t        try:\\n50\\t            out, err = proc.communicate(timeout=END_GRACE_S)\\n51\\t        except subprocess.TimeoutExpired:\\n52\\t            _signal_group(proc, signal.SIGKILL)\\n53\\t            try:\\n54\\t                out, err = proc.communicate(timeout=END_GRACE_S)\\n55\\t            except subprocess.TimeoutExpired:\\n56\\t                # something the run started left its group and holds the pipes\\n57\\t                out, err = \\\"\\\", \\\"\\\"\\n58\\t        _signal_group(proc, signal.SIGKILL)\\n59\\t        return TIMED_OUT_EXIT, out, err, True\\n60\\t    _signal_group(proc, signal.SIGKILL)\\n61\\t    return proc.returncode, out, err, False\\n62\\t\\n63\\t\\n64\\tdef without_records(paths: list[str], records_rel: str) -> list[str]:\\n65\\t    \\\"\\\"\\\"paths other than paths.records itself and what is under it -- the\\n66\\t    records directory is where the product writes, not the item's work.\\\"\\\"\\\"\\n67\\t    prefix = records_rel.rstrip(\\\"/\\\") + \\\"/\\\"\\n68\\t    return [p for p in paths if p and p != records_rel and not p.startswith(prefix)]\\n69\\t\\n70\\t\\n71\\tdef changed_since_default_branch(root: Path, records_rel: str) -> list[str]:\\n72\\t    \\\"\\\"\\\"Every path the item has changed since it left the default branch,\\n73\\t    committed or not: tracked paths whose content differs from the\\n74\\t    merge-base with what refs/remotes/origin/HEAD names -- deleted and\\n75\\t    renamed-from paths included, staged or not -- and untracked paths that\\n76\\t    are not ignored. Sorted; the records directory left aside.\\n77\\t    RuntimeError when the default branch cannot be named.\\\"\\\"\\\"\\n78\\t    default = git(root, \\\"symbolic-ref\\\", \\\"-q\\\", \\\"refs/remotes/origin/HEAD\\\").strip()\\n79\\t    base = git(root, \\\"merge-base\\\", default, \\\"HEAD\\\").strip()\\n80\\t    tracked = git(root, \\\"diff\\\", \\\"--name-only\\\", \\\"--no-renames\\\", \\\"-z\\\", base).split(\\\"\\\\0\\\")\\n81\\t    untracked = git(root, \\\"ls-files\\\", \\\"--others\\\", \\\"--exclude-standard\\\", \\\"-z\\\").split(\\\"\\\\0\\\")\\n82\\t    return sorted(set(without_records(tracked + untracked, records_rel)))\\n83\\t\\n84\\t\\n85\\tdef cmd_test(argv: list[str]) -> int:\\n86\\t    root = Path(\\\".\\\").resolve()\\n87\\t    item_id = argv[0] if argv else derive_item_id(root)\\n88\\t    if not item_id:\\n89\\t        print(\\\"attavo test: cannot derive item id; pass N or run on an attavo/N-* branch\\\",\\n90\\t              file=sys.stderr)\\n91\\t        return 2\\n92\\t    m = read_manifest(root)\\n93\\t    if m is None:\\n94\\t        print(f\\\"attavo test: no {MANIFEST} at {root}\\\", file=sys.stderr)\\n95\\t        return 2\\n96\\t    tests_cfg: dict[str, Any] = m.get(\\\"tests\\\") or {}\\n97\\t    if not tests_cfg.get(\\\"select\\\") or not tests_cfg.get(\\\"run\\\"):\\n98\\t        print(\\\"attavo test: no [tests] table in the manifest \\\"\\n99\\t              \\\"([tests].select and [tests].run are both required)\\\", file=sys.stderr)\\n100\\t        return 2\\n101\\t    try:\\n102\\t        changed = changed_since_default_branch(root, m[\\\"paths\\\"][\\\"records\\\"])\\n103\\t    except RuntimeError as exc:\\n104\\t        print(f\\\"attavo test: cannot name what item {item_id} has changed: {exc}; \\\"\\n105\\t              \\\"run `git remote set-head origin -a`\\\", file=sys.stderr)\\n106\\t        return 2\\n107\\t\\n108\\t    select_run = subprocess.run(tests_cfg[\\\"select\\\"], shell=True, cwd=str(root),\\n109\\t                                input=\\\"\\\".join(p + \\\"\\\\n\\\" for p in changed),\\n110\\t                                capture_output=True, text=True, check=False)\\n111\\t    if select_run.returncode != 0:\\n112\\t        # Nothing selected because the selector failed is not nothing to run.\\n113\\t        sys.stderr.write(select_run.stderr)\\n114\\t        print(f\\\"attavo test: [tests].select exited {select_run.returncode}; nothing was run\\\",\\n115\\t              file=sys.stderr)\\n116\\t        return 2\\n117\\t    identifiers = [line for line in select_run.stdout.splitlines() if line.strip()]\\n118\\t    if not identifiers:\\n119\\t        print(f\\\"attavo test {item_id}: no test is selected for the {len(changed)} \\\"\\n120\\t              \\\"path(s) changed since the default branch\\\")\\n121\\t        return 0\\n122\\t\\n123\\t    bound = tests_cfg.get(\\\"call_timeout_s\\\")\\n124\\t    print(f\\\"attavo test {item_id}: {len(identifiers)} selected\\\", flush=True)\\n125\\t    code, out, err, timed_out = run_bounded(tests_cfg[\\\"run\\\"], root,\\n126\\t                                            \\\"\\\".join(i + \\\"\\\\n\\\" for i in identifiers), bound)\\n127\\t    sys.stdout.write(out)\\n128\\t    sys.stderr.write(err)\\n129\\t    if timed_out:\\n130\\t        print(f\\\"attavo test {item_id}: the run did not finish within {bound} s; \\\"\\n131\\t              \\\"it and everything it started were ended\\\")\\n132\\t    return code\\n133\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"5691906c-5ded-4857-9a37-715666a9a25d\",\"uuid\":\"f36da1ab-a001-4664-a17e-6867946b4060\",\"timestamp\":\"2026-09-26T18:24:08.147Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/davidbean/Projects/attavo-worktree-224/attavo/testtool.py\",\"content\":\"from __future__ import annotations\\n\\nimport os\\nimport signal\\nimport subprocess\\nimport sys\\nfrom pathlib import Path\\nfrom typing import Any\\n\\nfrom attavo.common import MANIFEST, derive_item_id, git, read_manifest\\n\\n# --- test: the executor's one test command (issue #212) --\\n# The tests [tests].select names for every path the item has changed since\\n# it left the default branch, run through [tests].run, bounded by\\n# [tests].call_timeout_s. The executor is given this and not the tenant's\\n# whole-tree checks: given a checks command it ran it (#194's 590 s wait;\\n# #204 and #206 ran the suite twice inside one build), and the gate runs\\n# them after every commit whatever the executor does. ---\\n\\nTIMED_OUT_EXIT = 124\\n\\n# What an ended run is given to leave on its own after SIGTERM, before its\\n# whole process group is sent SIGKILL.\\nEND_GRACE_S = 2\\n\\n\\ndef _signal_group(proc: \\\"subprocess.Popen[str]\\\", sig: int) -> None:\\n    try:\\n        os.killpg(proc.pid, sig)\\n    except ProcessLookupError:\\n        pass\\n\\n\\ndef run_bounded(command: str, root: Path, stdin: str, timeout_s: int | None\\n                ) -> tuple[int, str, str, bool]:\\n    \\\"\\\"\\\"(exit, stdout, stderr, timed_out) of `command` run through the shell\\n    from root. The command is its own process group's leader, so a run past\\n    timeout_s is ended with everything it started -- a test runner's\\n    workers and a shell's background jobs alike -- rather than only the\\n    shell, which would leave them holding the pipes and the machine. A run\\n    that outlasts its bound exits 124, as timeout(1) does.\\\"\\\"\\\"\\n    proc = subprocess.Popen(command, shell=True, cwd=str(root), stdin=subprocess.PIPE,\\n                            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,\\n                            start_new_session=True)\\n    try:\\n        out, err = proc.communicate(stdin, timeout=timeout_s)\\n    except subprocess.TimeoutExpired:\\n        _signal_group(proc, signal.SIGTERM)\\n        try:\\n            out, err = proc.communicate(timeout=END_GRACE_S)\\n        except subprocess.TimeoutExpired:\\n            _signal_group(proc, signal.SIGKILL)\\n            try:\\n                out, err = proc.communicate(timeout=END_GRACE_S)\\n            except subprocess.TimeoutExpired:\\n                # something the run started left its group and holds the pipes\\n                out, err = \\\"\\\", \\\"\\\"\\n        _signal_group(proc, signal.SIGKILL)\\n        return TIMED_OUT_EXIT, out, err, True\\n    _signal_group(proc, signal.SIGKILL)\\n    return proc.returncode, out, err, False\\n\\n\\ndef without_records(paths: list[str], records_rel: str) -> list[str]:\\n    \\\"\\\"\\\"paths other than paths.records itself and what is under it -- the\\n    records directory is where the product writes, not the item's work.\\\"\\\"\\\"\\n    prefix = records_rel.rstrip(\\\"/\\\") + \\\"/\\\"\\n    return [p for p in paths if p and p != records_rel and not p.startswith(prefix)]\\n\\n\\ndef changed_since_default_branch(root: Path, records_rel: str) -> list[str]:\\n    \\\"\\\"\\\"Every path the item has changed since it left the default branch,\\n    committed or not: tracked paths whose content differs from the\\n    merge-base with what refs/remotes/origin/HEAD names -- deleted and\\n    renamed-from paths included, staged or not -- and untracked paths that\\n    are not ignored. Sorted; the records directory left aside.\\n    RuntimeError when the default branch cannot be named.\\\"\\\"\\\"\\n    default = git(root, \\\"symbolic-ref\\\", \\\"-q\\\", \\\"refs/remotes/origin/HEAD\\\").strip()\\n    base = git(root, \\\"merge-base\\\", default, \\\"HEAD\\\").strip()\\n    tracked = git(root, \\\"diff\\\", \\\"--name-only\\\", \\\"--no-renames\\\", \\\"-z\\\", base).split(\\\"\\\\0\\\")\\n    untracked = git(root, \\\"ls-files\\\", \\\"--others\\\", \\\"--exclude-standard\\\", \\\"-z\\\").split(\\\"\\\\0\\\")\\n    return sorted(set(without_records(tracked + untracked, records_rel)))\\n\\n\\ndef cmd_test(argv: list[str]) -> int:\\n    root = Path(\\\".\\\").resolve()\\n    item_id = argv[0] if argv else derive_item_id(root)\\n    if not item_id:\\n        print(\\\"attavo test: cannot derive item id; pass N or run on an attavo/N-* branch\\\",\\n              file=sys.stderr)\\n        return 2\\n    m = read_manifest(root)\\n    if m is None:\\n        print(f\\\"attavo test: no {MANIFEST} at {root}\\\", file=sys.stderr)\\n        return 2\\n    tests_cfg: dict[str, Any] = m.get(\\\"tests\\\") or {}\\n    if not tests_cf
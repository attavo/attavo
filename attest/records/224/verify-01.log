tion\"}],\"tests_named\":[\"test_a_failed_fresh_run_invalidates_the_prior_passing_cache_entry\",\"test_all_mode_leaves_out_exclude_in_executor_identifiers\",\"test_every_test_invocation_emits_exactly_one_event_including_usage_and_selector_errors\"]}"}}

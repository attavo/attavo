nin place of a whole run of the checks before the first build; one bounded\\ntest command for the executor; a selector that fails safe. The specimen is\\n#194's build-01: 215 s of suite before the executor began, 241 s of it at\\nthe gate, and a 590 s wait on a third run inside the executor, around 220 s\\nof work.\\n\\nRun: python3 -m pytest tests -q\\n\\\"\\\"\\\"\\nfrom __future__ import annotations\\n\\nimport json\\nimport subprocess\\nimport sys\\nimport time\\nfrom pathlib import Path\\nfrom typing import Any\\n\\nimport jsonschema\\n\\nfrom helpers import commit_all, git, make_tenant\\nfrom test_drive import approve_item, record_files, run_attavo\\n\\nROOT = Path(__file__).resolve().parent.parent\\nSELECT = ROOT / \\\".attavo\\\" / \\\"bin\\\" / \\\"select-tests\\\"\\nMANIFEST_SCHEMA = json.loads((ROOT / \\\"schema\\\" / \\\"manifest.schema.json\\\").read_text())\\n\\n\\ndef tenant(tmp_path: Path, checks: str = \\\"\\\", tests: str = \\\"\\\") -> Path:\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    toml = root / \\\"attavo.toml\\\"\\n    text = toml.read_text()\\n    if tests:\\n        text = text.replace('[tests]\\\\nselect = \\\"cat\\\"\\\\nrun = \\\"true\\\"', tests)\\n    toml.write_text(text + (\\\"\\\\n\\\" + checks + \\\"\\\\n\\\" if checks else \\\"\\\"))\\n    commit_all(root, \\\"configure\\\")\\n    git(root, \\\"checkout\\\", \\\"-q\\\", \\\"-b\\\", \\\"attavo/1-x\\\")\\n    return root\",\"stderr\":\"\",\"interrupted\":false,\"isImage\":false,\"noOutputExpected\":false}}\n+{\"type\":\"system\",\"subtype\":\"thinking_tokens\",\"estimated_tokens\":50,\"estimated_tokens_delta\":50,\"session_id\":\"5691906c-5ded-4857-9a37-715666a9a25d\",\"uuid\":\"3c11d3c8-a320-4b4b-af51-c2bfa0abb20e\"}\n+{\"type\":\"system\",\"subtype\":\"thinking_tokens\",\"estimated_tokens\":133,\"estimated_tokens_delta\":83,\"session_id\":\"5691906c-5ded-4857-9a37-715666a9a25d\",\"uuid\":\"9dba6b05-9358-4c82-92b2-888655930be3\"}\n+{\"type\":\"assistant\",\"message\":{\"model\":\"claude-sonnet-5\",\"id\":\"msg_011CfSX6hvxm5ju9uKKVwEKa\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"thinking\",\"thinking\":\"\",\"signature\":\"\"}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":1411,\"cache_read_input_tokens\":67313,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":1411},\"output_tokens\":5,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"5691906c-5ded-4857-9a37-715666a9a25d\",\"uuid\":\"7157ccd0-3025-4c39-9d9a-023148fd15e0\",\"timestamp\":\"2026-09-26T18:25:02.053Z\",\"request_id\":\"req_011CfSX6hVRij2XNkkKUXgUe\"}\n+{\"type\":\"assistant\",\"message\":{\"model\":\"claude-sonnet-5\",\"id\":\"msg_011CfSX6hvxm5ju9uKKVwEKa\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_01QPoQfAvM2Ezh9jRpF8VBk1\",\"name\":\"Bash\",\"input\":{\"command\":\"sed -n '1,70p' tests/test_drive.py\"},\"caller\":{\"type\":\"direct\"}}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":1411,\"cache_read_input_tokens\":67313,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":1411},\"output_tokens\":5,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"5691906c-5ded-4857-9a37-715666a9a25d\",\"uuid\":\"932e6cad-7312-4355-a35c-809a4310b0ef\",\"timestamp\":\"2026-09-26T18:25:02.707Z\",\"request_id\":\"req_011CfSX6hVRij2XNkkKUXgUe\",\"wire_tool_inputs\":{\"toolu_01QPoQfAvM2Ezh9jRpF8VBk1\":{\"command\":\"cd /Users/davidbean/Projects/attavo-worktree-224 && sed -n '1,70p' tests/test_drive.py\"}},\"wire_ingest_context\":{\"toolu_01QPoQfAvM2Ezh9jRpF8VBk1\":{\"cwd\":\"/Users/davidbean/Projects/attavo-worktree-224\"}}}\n+{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_01QPoQfAvM2Ezh9jRpF8VBk1\",\"type\":\"tool_result\",\"content\":\"\\\"\\\"\\\"attavo drive: the mechanical transitions between approval and\\nready-to-merge (issue #84) -- under R2, one pass per invocation: read the\\nreport, act at most once (recover, start the build, start the review) in\\na detached worker, return. A level that belongs to a person is printed\\nand left. Every test uses the fixture\\nadapter and a fake `[forge].checks_command`; every record commit is\\n`git commit --only` and pushed to a real (bare) fixture remote.\\n\\nRegression tests, written and run red first: on `main` at 85f6f3b there\\nwas no `drive` subcommand, so every one of these failed with \\\"unknown\\nsubcommand\\\".\\n\\nRun: python3 -m pytest tests -q\\n\\\"\\\"\\\"\\nimport importlib\\nimport json\\nimport os\\nimport socket\\nimport queue\\nimport subprocess\\nimport sys\\nimport threading\\nimport time\\nfrom pathlib import Path\\nfrom typing import IO, Any, cast\\n\\nfrom helpers import commit_all, git, make_tenant\\n\\nROOT = Path(__file__).resolve().parent.parent\\nATTAVO = ROOT / \\\"bin\\\" / \\\"attavo\\\"\\n\\nGREEN_FORGE = \\\"printf 'ci success\\\\\\\\n'\\\"\\n# A concluded conclusion -- checked and failing, not something still\\n# running. Distinct from UNCONCLUDED_FORGE below (issue #84): drive polls\\n# the one still running for the bound, but stops on the first read of a\\n# check that has already concluded, whether or not it passed.\\nRED_FORGE = \\\"printf 'ci failure\\\\\\\\n'\\\"\\nUNCONCLUDED_FORGE = \\\"printf 'ci in_progress\\\\\\\\n'\\\"\\n\\n# The real defaults (ATTAVO_DRIVE_POLL_BOUND_S=600, _INTERVAL_S=20) are a\\n# real forge's clock, not a test's -- tenant zero's own checks conclude\\n# about five minutes after a push. Every `attavo drive` call here runs\\n# against this much shorter clock instead, read at call time from the\\n# same environment variables; test_drive_forge_poll_defaults_are_a_real_\\n# forges_clock is the one test that leaves them unset, to assert the\\n# defaults themselves. The interval is kept well above typical subprocess\\n# startup overhead so a zero-sleep stop and a polled one are easy to tell\\n# apart by wall clock alone.\\nFAST_POLL_ENV = {\\\"ATTAVO_DRIVE_POLL_BOUND_S\\\": \\\"0.9\\\", \\\"ATTAVO_DRIVE_POLL_INTERVAL_S\\\": \\\"0.5\\\",\\n                 \\\"ATTAVO_HEARTBEAT_S\\\": \\\"0.2\\\"}\\n\\n\\ndef run_attavo(root: Path, *args: str, env: dict[str, Any] | None = None) -> subprocess.CompletedProcess[str]:\\n    full_env = dict(os.environ)\\n    full_env.update(FAST_POLL_ENV)\\n    if env:\\n        full_env.update(env)\\n    return subprocess.run([sys.executable, str(ATTAVO), *args], cwd=str(root),\\n                          capture_output=True, text=True, check=False, env=full_env)\\n\\n\\ndef drive(root: Path, *args: str, env: dict[str, Any] | None = None) -> subprocess.CompletedProcess[str]:\\n    \\\"\\\"\\\"One pass, then wait for the worker it may have started (R2): the pass\\n    returns as soon as the marker is pushed and the stage runs detached, so\\n    a test that reads the record after \\\"drive\\\" waits for the report to stop\\n    saying running. The pass's own output is returned, with the worker's\\n    log appended, so assertions on the stage's lines still read them.\\\"\\\"\\\"\\n    run = run_attavo(root, \\\"drive\\\", *args, env=env)\\n    import re\\n    pids = [int(x) for x in re.findall(r\\\"worker pid (\\\\d+)\\\", run.stdout)]\",\"is_error\":false}]},\"parent_tool_use_id\":null,\"session_id\":\"5691906c-5ded-4857-9a37-715666a9a25d\",\"uuid\":\"0b6e6060-5410-497e-a13e-c87d85394065\",\"timestamp\":\"2026-09-26T18:25:02.797Z\",\"tool_use_result\":{\"stdout\":\"\\\"\\\"\\\"attavo drive: the mechanical transitions between approval and\\nready-to-merge (issue #84) -- under R2, one pass per invocation: read the\\nreport, act at most once (recover, start the build, start the review) in\\na detached worker, return. A level that belongs to a person is printed\\nand left. Every test uses the fixture\\nadapter and a fake `[forge].checks_command`; every record commit is\\n`git commit --only` and pushed to a real (bare) fixture remote.\\n\\nRegression tests, written and run red first: on `main` at 85f6f3b there\\nwas no `drive` subcommand, so every one of these failed with \\\"unknown\\nsubcommand\\\".\\n\\nRun: python3 -m pytest tests -q\\n\\\"\\\"\\\"\\nimport importlib\\nimport json\\nimport os\\nimport socket\\nimport queue\\nimport subprocess\\nimport sys\\nimport threading\\nimport time\\nfrom pathlib import Path\\nfrom typing import IO, Any, cast\\n\\nfrom helpers import commit_all, git, make_tenant\\n\\nROOT = Path(__file__).resolve().parent.parent\\nATTAVO = ROOT / \\\"bin\\\" / \\\"attavo\\\"\\n\\nGREEN_FORGE = \\\"printf 'ci success\\\\\\\\n'\\\"\\n# A concluded conclusion -- checked and failing, not something still\\n# running. Distinct from UNCONCLUDED_FORGE below (issue #84): drive polls\\n# the one still running for the bound, but stops on the first read of a\\n# check that has already concluded, whether or not it passed.\\nRED_FORGE = \\\"printf 'ci failure\\\\\\\\n'\\\"\\nUNCONCLUDED_FORGE = \\\"printf 'ci in_progress\\\\\\\\n'\\\"\\n\\n# The real defaults (ATTAVO_DRIVE_POLL_BOUND_S=600, _INTERVAL_S=20) are a\\n# real forge's clock, not a test's -- tenant zero's own checks conclude\\n# about five minutes after a push. Every `attavo drive` call here runs\\n# against this much shorter clock instead, read at call time from the\\n# same environment variables; test_drive_forge_poll_defaults_are_a_real_\\n# forges_clock is the one test that leaves them unset, to assert the\\n# defaults themselves. The interval is kept well above typical subprocess\\n# startup overhead so a zero-sleep stop and a polled one are easy to tell\\n# apart by wall clock alone.\\nFAST_POLL_ENV = {\\\"ATTAVO_DRIVE_POLL_BOUND_S\\\": \\\"0.9\\\", \\\"ATTAVO_DRIVE_POLL_INTERVAL_S\\\": \\\"0.5\\\",\\n                 \\\"ATTAVO_HEARTBEAT_S\\\": \\\"0.2\\\"}\\n\\n\\ndef run_attavo(root: Path, *args: str, env: dict[str, Any] | None = None) -> subprocess.CompletedProcess[str]:\\n    full_env = dict(os.environ)\\n    full_env.update(FAST_POLL_ENV)\\n    if env:\\n        full_env.update(env)\\n    return subprocess.run([sys.executable, str(ATTAVO), *args], cwd=str(root),\\n                          capture_output=True, text=True, check=False, env=full_env)\\n\\n\\ndef drive(root: Path, *args: str, env: dict[str, Any] | None = None) -> subprocess.CompletedProcess[str]:\\n    \\\"\\\"\\\"One pass, then wait for the worker it may have started (R2): the pass\\n    returns as soon as the marker is pushed and the stage runs detached, so\\n    a test that reads the record after \\\"drive\\\" waits for the report to stop\\n    saying running. The pass's own output is returned, with the worker's\\n    log appended, so assertions on the stage's lines still read them.\\\"\\\"\\\"\\n    run = run_attavo(root, \\\"drive\\\", *args, env=env)\\n    import re\\n    pids = [int(x) for x in re.findall(r\\\"worker pid (\\\\d+)\\\", run.stdout)]\",\"stderr\":\"\",\"interrupted\":false,\"isImage\":false,\"noOutputExpected\":false}}\n+{\"type\":\"assistant\",\"message\":{\"model\":\"claude-sonnet-5\",\"id\":\"msg_011CfSX72RxD14c4mwFUvJp8\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"Good, that all lines up. Now let me apply the stub files to the real repo (straightforward copies), then handle cli.py's help text separately.\"}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":1477,\"cache_read_input_tokens\":68724,\"cache_creation\":{\"ephemeral_5m_input
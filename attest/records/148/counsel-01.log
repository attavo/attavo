                       f\\\"line after the install commit {install_sha[:12]}\\\")\\n896\\t        window_start = resolved_from\\n897\\t\\n898\\t    if window_start == install_sha:\\n899\\t        window_spec = f\\\"{install_sha}..HEAD\\\"\\n900\\t        commits = full_chain\\n901\\t    else:\\n902\\t        window_spec = f\\\"{window_start}^..HEAD\\\"\\n903\\t        commits = git(root, \\\"rev-list\\\", window_spec, \\\"--first-parent\\\").split()\\n904\\t    before_window = len(full_chain) - len(commits)\\n905\\t\\n906\\t    records_rel = m.get(\\\"paths\\\", {}).get(\\\"records\\\", \\\"\\\")\\n907\\t    records_dir = root / records_rel\\n908\\t    named: set[str] = set()\\n909\\t    for stages in load_records(records_dir).values():\\n910\\t        for rec in stages.values():\\n911\\t            sha = rec.get(\\\"sha\\\")\\n912\\t            if isinstance(sha, str):\\n913\\t                named.add(sha)\\n914\\t            for c in rec.get(\\\"commits\\\", []) or []:\\n915\\t                if isinstance(c, str):\\n916\\t                    named.add(c)\\n917\\t    record_commits = set(git(root, \\\"rev-list\\\", window_spec, \\\"--first-parent\\\",\\n918\\t                             \\\"--\\\", records_rel).split()) if records_rel else set()\\n919\\t    merges = set(git(root, \\\"rev-list\\\", window_spec, \\\"--first-parent\\\", \\\"--merges\\\").split())\\n920\\t    boundary_paths = ((m.get(\\\"spec\\\") or {}).get(\\\"boundary\\\") or {}).get(\\\"paths\\\") or []\\n921\\t\\n922\\t    # Every first-parent commit in the window is exactly one of three\\n923\\t    # (issue #72): recorded (a record names it, or its diff touches\\n924\\t    # paths.records), ordinary (a merge that doesn't), or unrecorded\\n925\\t    # (anything else -- on a protected main with a queue, a non-merge\\n926\\t    # commit is the only way a change arrives without the forge).\\n927\\t    recorded, ordinary, unrecorded = [], [], []\\n928\\t    boundary_evasions = 0\\n929\\t    for c in commits:\\n930\\t        if c in named or c in record_commits:\\n931\\t            recorded.append(c)\\n932\\t        elif c in merges:\\n933\\t            ordinary.append(c)\\n934\\t            if boundary_paths and touches_boundary(root, c, boundary_paths):\\n935\\t                boundary_evasions += 1\\n936\\t        else:\\n937\\t            unrecorded.append(c)\\n938\\t\\n939\\t    counts = f\\\"{len(recorded)} recorded, {len(ordinary)} ordinary, {len(unrecorded)} unrecorded\\\"\\n940\\t    evasions = boundary_evasions if boundary_paths else \\\"n/a\\\"\\n941\\t    extra = {\\\"recorded\\\": len(recorded), \\\"ordinary\\\": len(ordinary),\\n942\\t             \\\"unrecorded\\\": len(unrecorded), \\\"boundary_evasions\\\": evasions,\\n943\\t             \\\"before_window\\\": before_window}\\n944\\t    if unrecorded:\\n945\\t        return p.fail(f\\\"{unrecorded[-1][:12]} lacks a record; {counts}; boundary evasions: \\\"\\n946\\t                      f\\\"{evasions}; before the window: {before_window}\\\", **extra)\\n947\\t    return p.hold(f\\\"{counts}; boundary evasions: {evasions}; before the window: {before_window}\\\",\\n948\\t                  **extra)\\n949\\t\\n950\\t\\n951\\tADAPTER_EXIT_RE = re.compile(r\\\"^\\\\[adapter exited \\\\d+\\\\]$\\\")\\n952\\t\\n953\\t\\n954\\tdef _log_owes_tool_error(log: str | None) -> bool:\\n955\\t    \\\"\\\"\\\"True when a log's last non-empty line is exactly an adapter-exit\\n956\\t    marker and every line before it parses as JSON -- an adapter's own\\n957\\t    event stream, never a tool's own words (issue #94's own specimen,\\n958\\t    tenant zero's attest/records/659/verify-01.log: codex's\\n959\\t    \\\"thread.started\\\" event, then nothing but \\\"[adapter exited 1]\\\" -- the\\n960\\t    tool's real error line dropped before this reached the log, issue\\n961\\t    #86's own bug in split_adapter_stdout). A log that is only the exit\\n962\\t    marker, nothing before it at all, still owes the same line.\\
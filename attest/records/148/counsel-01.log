dinary), and, when asked, one commit made\\n305\\t    straight to main naming no record (unrecorded -- on a protected main\\n306\\t    with a queue, the only way a change arrives without the forge).\\n307\\t    \\\"\\\"\\\"\\n308\\t    root = tmp_path / name\\n309\\t    root.mkdir()\\n310\\t    manifest = '[paths]\\\\nrecords = \\\"records\\\"\\\\n'\\n311\\t    if boundary_paths is not None:\\n312\\t        patterns = \\\", \\\".join(f'\\\"{path}\\\"' for path in boundary_paths)\\n313\\t        manifest += f'\\\\n[spec.boundary]\\\\npaths = [{patterns}]\\\\n'\\n314\\t    (root / \\\"attavo.toml\\\").write_text(manifest)\\n315\\t    init_repo(root, \\\"install\\\")\\n316\\t\\n317\\t    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"-b\\\", \\\"attavo/1-x\\\"], check=True)\\n318\\t    records = root / \\\"records\\\" / \\\"1\\\"\\n319\\t    records.mkdir(parents=True)\\n320\\t    (records / \\\"spec-01.json\\\").write_text(json.dumps({\\\"status\\\": \\\"pass\\\"}))\\n321\\t    commit_all(root, \\\"spec record for item 1\\\")\\n322\\t    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"main\\\"], check=True)\\n323\\t    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"merge\\\", \\\"--no-ff\\\", \\\"-m\\\",\\n324\\t                    \\\"Merge branch 'attavo/1-x'\\\", \\\"attavo/1-x\\\"], check=True)\\n325\\t\\n326\\t    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"-b\\\", \\\"ordinary-change\\\"], check=True)\\n327\\t    touched = root / ordinary_touches\\n328\\t    touched.parent.mkdir(parents=True, exist_ok=True)\\n329\\t    touched.write_text(\\\"v2\\\\n\\\")\\n330\\t    commit_all(root, \\\"an ordinary change\\\")\\n331\\t    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"checkout\\\", \\\"main\\\"], check=True)\\n332\\t    subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"merge\\\", \\\"--no-ff\\\", \\\"-m\\\",\\n333\\t                    \\\"Merge branch 'ordinary-change'\\\", \\\"ordinary-change\\\"], check=True)\\n334\\t\\n335\\t    if include_direct_commit:\\n336\\t        (root / \\\"direct.txt\\\").write_text(\\\"direct\\\\n\\\")\\n337\\t        commit_all(root, \\\"a change committed straight to main\\\")\\n338\\t\\n339\\t    return root\\n340\\t\\n341\\t\\n342\\tdef test_proof_three_fails_naming_the_direct_commit_with_the_three_counts(tmp_path):\\n343\\t    \\\"\\\"\\\"Acceptance row 1, issue #72. The three-way fixture with its direct\\n344\\t    commit included: proof three fails, naming the direct commit and\\n345\\t    reporting all three counts in the reason.\\\"\\\"\\\"\\n346\\t    root = _three_way_fixture(tmp_path, \\\"direct_commit\\\", boundary_paths=[\\\"boundary/**\\\"],\\n347\\t                              ordinary_touches=\\\"pins/version.txt\\\", include_direct_commit=True)\\n348\\t    direct_sha = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"rev-parse\\\", \\\"HEAD\\\"],\\n349\\t                                capture_output=True, text=True, check=True).stdout.strip()\\n350\\t\\n351\\t    p = run_doctor(root)[\\\"no-commit-lacks-record\\\"]\\n352\\t    assert not p[\\\"holds\\\"]\\n353\\t    assert \\\"1 recorded, 1 ordinary, 1 unrecorded\\\" in p[\\\"reason\\\"]\\n354\\t    assert direct_sha[:12] in p[\\\"reason\\\"]\\n355\\t\\n356\\t\\n357\\tdef test_proof_three_holds_with_zero_unrecorded_once_the_direct_commit_is_gone(tmp_path):\\n358\\t    \\\"\\\"\\\"Acceptance row 2, issue #72. The same fixture with the direct commit\\n359\\t    removed: proof three holds, reporting `0 unrecorded`.\\\"\\\"\\\"\\n360\\t    root = _three_way_fixture(tmp_path, \\\"no_direct_commit\\\", boundary_paths=[\\\"boundary/**\\\"],\\n361\\t                              ordinary_touches=\\\"pins/version.txt\\\", include_direct_commit=False)\\n362\\t\\n363\\t    p = run_doctor(root)[\\\"no-commit-lacks-record\\\"]\\n364\\t    assert p[\\\"holds\\\"], p[\\\"reason\\\"]\\n365\\t    assert \\\"1 recorded, 1 ordina
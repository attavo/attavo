at all -- the envelope is what\n/Users/davidbean/Projects/attest/adapters/claude-code/run:862:        print(json.dumps({\"argv\": cmd, \"instruction\": instruction, \"schema\": schema}))\n/Users/davidbean/Projects/attest/adapters/claude-code/run:899:    if counseling:\n/Users/davidbean/Projects/attest/adapters/claude-code/run:905:               \"verdict\": structured.get(\"verdict\"),\n/Users/davidbean/Projects/attest/adapters/claude-code/run:922:        reinstruction = instruction + \"\\n\\n\" + REINSTRUCTION\n/Users/davidbean/Projects/attest/adapters/claude-code/run:923:        cmd2 = build_command(reinstruction, config, schema, stage)\n/Users/davidbean/Projects/attest/schema/records/build.schema.json:111:          \"enum\": [\"non-question\", \"outlived-invocation\", \"no-cause\", \"forge-unconcluded\",\n/Users/davidbean/Projects/attest/schema/records/build.schema.json:112:                   \"ceiling\", \"claims-boundary\", \"repeated-act\", \"unclassed\", \"question\",\n/Users/davidbean/Projects/attest/schema/records/build.schema.json:118:          \"description\": \"Populated for class \\\"unclassed\\\" (the log's last line, capped at 200 characters), class \\\"question\\\" (the halt's own question, its first line only), class \\\"environment\\\" ([checks].command's last output line, capped at 200 characters), and class \\\"gate\\\" (a refused spec-gate record's own refusal string, issue #137 -- never persisted on an actual build record; read here only because stop_class_enum sources the enum from this schema); null for every other class, whose evidence already lives in refusal, halted, or the log itself.\"\n/Users/davidbean/Projects/attest/adapters/claude-code/conformance.json:5:  \"stages\": [\"build\", \"verify\", \"counsel\"],\n/Users/davidbean/Projects/attest/adapters/claude-code/conformance.json:10:    \"reason\": \"claude code documents no numeric input-size ceiling anywhere in its own surface (--help, docs, or any config file, confirmed against claude 2.1.269) -- this adapter asserts its own instruction stays under a fixed 64 KB bound instead\"\n/Users/davidbean/Projects/attest/adapters/claude-code/conformance.json:13:  \"subagent_guard\": {\n/Users/davidbean/Projects/attest/schema/records/verify.schema.json:62:        \"required\": [\"title\", \"specimen\", \"retires\", \"rejection_test\", \"severity\"],\n/Users/davidbean/Projects/attest/schema/records/verify.schema.json:67:          \"rejection_test\": {\"type\": \"string\", \"minLength\": 1},\n/Users/davidbean/Projects/attest/schema/records/verify.schema.json:113:          \"enum\": [\"non-question\", \"outlived-invocation\", \"no-cause\", \"forge-unconcluded\",\n/Users/davidbean/Projects/attest/schema/records/verify.schema.json:114:                   \"ceiling\", \"claims-boundary\", \"repeated-act\", \"unclassed\", \"question\"]\n/Users/davidbean/Projects/attest/schema/records/verify.schema.json:119:          \"description\": \"Populated for class \\\"unclassed\\\" (the log's last line, capped at 200 characters) and class \\\"question\\\" (the halt's own question, its first line only); null for every other class, whose evidence already lives in forge_checks or the log itself.\"\n/Users/davidbean/Projects/attest/adapters/claude-code/README.md:24:the instruction says so: \"after you commit, the tenant's checks (`<command>`)\n/Users/davidbean/Projects/attest/adapters/claude-code/README.md:26:run only what you need while editing.\" When it is unset, the instruction\n/Users/davidbean/Projects/attest/schema/records/counsel.schema.json:3:  \"$id\": \"https://attavo.dev/schema/records/counsel/2\",\n/Users/davidbean/Projects/attest/schema/records/counsel.schema.json:4:  \"title\": \"attavo counsel record (counsel-NN.json)\",\n/Users/davidbean/Projects/attest/schema/records/counsel.schema.json:10:    \"tokens\", \"cost_usd\", \"wall_clock_s\", \"status\", \"class\", \"verdict\",\n/Users/davidbean/Projects/attest/schema/records/counsel.schema.json:20:      \"description\": \"Which stage's non-pass record this counsel invocation read -- \\\"spec\\\" is a refused spec-gate record, read only when no build or verify record exists yet.\"\n/Users/davidbean/Projects/attest/schema/records/counsel.schema.json:25:      \"description\": \"The stem (e.g. \\\"build-01\\\" or \\\"spec-01\\\") of the non-pass record counsel read.\"\n/Users/davidbean/Projects/attest/schema/records/counsel.schema.json:31:      \"description\": \"Copied verbatim from [executor.<adapter>] merged with [executor.<adapter>.counsel].\"\n/Users/davidbean/Projects/attest/schema/records/counsel.schema.json:55:      \"description\": \"\\\"failed\\\" when the adapter exited non-zero or returned no usable structured answer; class, verdict, citations, and proposal are then null/empty.\"\n/Users/davidbean/Projects/attest/schema/records/counsel.schema.json:59:      \"enum\": [\"non-question\", \"outlived-invocation\", \"no-cause\", \"forge-unconcluded\",\n/Users/davidbean/Projects/attest/schema/records/counsel.schema.json:60:               \"ceiling\", \"claims-boundary\", \"repeated-act\", \"unclassed\", null],\n/Users/davidbean/Projects/attest/schema/records/counsel.schema.json:61:      \"description\": \"The stop's class as counsel itself reads it -- independent of, and possibly disagreeing with, the stop.class the counseled record already carries.\"\n/Users/davidbean/Projects/attest/schema/records/counsel.schema.json:63:    \"verdict\": {\n/Users/davidbean/Projects/attest/schema/records/counsel.schema.json:66:      \"description\": \"\\\"answer\\\": the stop is answerable inside the rules. \\\"patch\\\": the stop is a product defect. \\\"person\\\": the answer would touch the definition of done and no rule covers it.\"\n/Users/davidbean/Projects/attest/schema/records/counsel.schema.json:70:      \"description\": \"instruction, mechanism, guard -- each a path and symbol or a ruling id.\",\n/Users/davidbean/Projects/attest/schema/records/counsel.schema.json:76:          \"kind\": {\"type\": \"string\", \"enum\": [\"instruction\", \"mechanism\", \"guard\"]},\n/Users/davidbean/Projects/attest/schema/records/counsel.schema.json:85:      \"description\": \"The ruling text (verdict \\\"answer\\\"), the patch (verdict \\\"patch\\\"), or the one-line question (verdict \\\"person\\\") -- exactly one populated, matching verdict.\",\n/Users/davidbean/Projects/attest/schema/records/counsel.schema.json:87:      \"required\": [\"ruling_text\", \"patch\", \"question\"],\n/Users/davidbean/Projects/attest/schema/records/counsel.schema.json:89:        \"ruling_text\": {\"type\": [\"string\", \"null\"]},\n/Users/davidbean/Projects/attest/schema/records/counsel.schema.json:93:          \"required\": [\"file\", \"symbol\", \"rejection_test\", \"diff\"],\n/Users/davidbean/Projects/attest/schema/records/counsel.schema.json:97:            \"rejection_test\": {\"type\": \"string\", \"minLength\": 1},\n        cls = payload.get(\"class\")\n        verdict = payload.get(\"verdict\")\n        citations = payload.get(\"citations\") or []\n        proposal = payload.get(\"proposal\") or proposal\n\n    record = {\n        \"sha\": git(root, \"rev-parse\", \"HEAD\").strip(),\n        \"record_stage\": stage,\n        \"record\": record_path.stem,\n        \"at\": now_iso(),\n        \"adapter\": adapter_name,\n        \"adapter_config\": adapter_config,\n        \"adapter_version\": adapter_version_out,\n        \"model\": model,\n        \"model_version\": model_version,\n        \"reports\": reports,\n        \"tokens\": tokens,\n        \"cost_usd\": cost_usd,\n        \"wall_clock_s\": round(time.monotonic() - started, 3),\n        \"status\": status_out,\n        \"class\": cls,\n        \"verdict\": verdict,\n        \"citations\": citations,\n        \"proposal\": proposal,\n    }\n    record_out_path = write_record(item_records_dir, \"counsel\", record, m, item_id, log=transcript)\n\n    print(f\"attavo counsel: {status_out} ({record_out_path.name})\")\n    return 0 if status_out == \"done\" else 1\n\n\n# --- drive: the mechanical transitions between approval and ready-to-merge\n# (issue #84) -- one step per invocation, and only that step, until a\n# state that belongs to a person. Writes no record of its own; the stage\n# records already on disk are the only state it reads. ---\n\ndef forge_checks_unconcluded(forge_checks: dict) -> bool:\n    \"\"\"Whether poll_forge_checks should keep waiting rather than stop at\n    once: an empty read (the forge has not attached any check to this sha\n    yet) or any one check still carrying a status (queued, in_progress,\n    pending, waiting) rather than a concluded conclusion. A concluded\n    conclusion that is not green (failure, cancelled, timed_out, and\n    anything else read_forge_checks did not recognize as ok) is not this\n    -- that check is done, whether or not it passed.\"\"\"\n    conclusions = forge_checks[\"conclusions\"]\n    if not conclusions:\n        return True\n    return any(c[\"conclusion\"] in FORGE_UNCONCLUDED_STATUSES for c in conclusions)\n\n\ndef poll_forge_checks(root: Path, checks_command: str, sha: str) -> tuple[dict, bool]:\n    \"\"\"read_forge_checks, retried within drive_forge_poll_bound_s() while\n    some check is still unconcluded (forge_checks_unconcluded) -- a check\n    still running is not yet red, and drive gives it a little room to\n    conclude before it gives up. A read where every check has already\n    concluded, green or not, stops here at once: there is nothing left to\n    wait on. The bound and interval are constants this lane names, not a\n    manifest key, re-read at call time so a test's own clock\n    (ATTAVO_DRIVE_POLL_BOUND_S, ATTAVO_DRIVE_POLL_INTERVAL_S) never has to\n    survive past when it was set.\"\"\"\n    bound = drive_forge_poll_bound_s()\n    interval = drive_forge_poll_interval_s()\n    deadline = time.monotonic() + bound\n    forge_checks, ok = read_forge_checks(root, checks_command, sha)\n    while not ok and forge_checks_unconcluded(forge_checks) and time.monotonic() < deadline:\n        time.sleep(interval)\n        forge_checks, ok = read_forge_checks(root, checks_command, sha)\n    return forge_checks, ok\n\n\ndef commit_record(root: Path, record_paths: Path | list[Path], message: str) -> None:\n    \"\"\"`git commit --only` on every record path given, and each one's .log\n    and .filed, each if one exists -- never the whole index. A transport\n    commit that sweeps the index is exactly the regression issue #46\n    already guards build and verify against on the adapter side; drive\n    must not reintroduce it on the transport side. The .filed marker\n    (issue #89) is committed alongside the record it names, in the same\n    commit and the same push, so a second worktree or a fresh clone reads\n    the same filed fact rather than refiling every stop it finds with no\n    marker of its own. A single Path is accepted for the common one-record\n    case; issue #100 passes a list so the counsel record lands in the same\n    commit as the stage record it counsels. Authored and committed as\n    driver_identity(), set by the product and never the tenant's git\n    config, so a driven item's record commits are never indistinguishable\n    from an operator's own.\"\"\"\n    if isinstance(record_paths, Path):\n        record_paths = [record_paths]\n    paths: list[str] = []\n    for record_path in record_paths:\n        paths.append(str(record_path.relative_to(root)))\n        log_path = record_path.with_suffix(\".log\")\n        if log_path.is_file():\n            paths.append(str(log_path.relative_to(root)))\n        marker_path = record_path.with_suffix(\".filed\")\n        if marker_path.is_file():\n            paths.append(str(marker_path.relative_to(root)))\n    identity = driver_identity()\n    env = dict(os.environ)\n    env[\"GIT_AUTHOR_NAME\"] = identity[\"name\"]\n    env[\"GIT_AUTHOR_EMAIL\"] = identity[\"email\"]\n    env[\"GIT_COMMITTER_NAME\"] = identity[\"name\"]\n    env[\"GIT_COMMITTER_EMAIL\"] = identity[\"email\"]\n    git(root, \"add\", *paths)\n    git(root, \"commit\", \"--only\", \"-m\", message, *paths, env=env)\n\n\ndef push_record_commit(root: Path, branch: str) -> tuple[bool, str | None]:\n    \"\"\"Push HEAD to branch on origin. A push a divergent remote rejects is\n    retried once after `git pull --no-rebase --no-edit origin branch` -- a\n    merge, never a rebase, because a rebase would change the sha the record\n    commit just wrote already names.\"\"\"\n    def attempt() -> tuple[bool, str]:\n        run = subprocess.run([\"git\", \"-C\", str(root), \"push\", \"origin\", f\"HEAD:{branch}\"],\n                             capture_output=True, text=True, check=False)\n        return run.returncode == 0, run.stderr.strip()\n\n    ok, err = attempt()\n    if ok:\n        return True, None\n    pull = subprocess.run([\"git\", \"-C\", str(root), \"pull\", \"--no-rebase\", \"--no-edit\",\n                           \"origin\", branch], capture_output=True, text=True, check=False)\n    if pull.returncode != 0:\n        return False, f\"push rejected and the retry merge failed: {pull.stderr.strip() or err}\"\n    ok, err = attempt()\n    if not ok:\n        return False, f\"push rejected again after merging {branch}: {err}\"\n    return True, None\n\n\ndef drive_state(root: Path, m: dict, item_id: str) -> tuple[str, str | None, Path]:\n    \"\"\"(\"no-approval\" | \"build\" | \"verify\" | \"ready\", detail, records_dir):\n    the next mechanical step for item_id, read from its latest records\n    alone. A build only counts as current when it is a pass bound to the\n    valid approval's own sha; a verify only counts as current when it is a\n    pass bound to that build's own sha -- the same staleness a re-approval\n    or a re-build must force, attest's own chain check already enforces\n    (check_attest_chain), read here rather than re-typed.\"\"\"\n    records_rel = m[\"paths\"][\"records\"]\n    records_dir = root / records_rel / item_id\n\n    status = approval_status(root, m, item_id)\n    if status != \"valid\":\n        return \"no-approval\", status, records_dir\n\n    latest_approval = latest_record(records_dir, \"approval\")\n    latest_build = latest_record(records_dir, \"build\")\n    build_current = (latest_build is not None and latest_build.get(\"status\") == \"pass\"\n                     and latest_build.get(\"approval_sha\") == (latest_approval or {}).get(\"sha\"))\n    if not build_current:\n        return \"build\", None, records_dir\n\n    latest_verify = latest_record(records_dir, \"verify\")\n    verify_current = (latest_verify is not None and latest_verify.get(\"status\") == \"pass\"\n                      and latest_verify.get(\"build_sha\") == latest_build.get(\"sha\"))\n    if not verify_current:\n        return \"verify\", None, records_dir\n\n    return \"ready\", None, records_dir\n\n\ndef _drive_run_stage(root: Path, records_dir: Path, branch: str, stage: str, item_id: str) -> int:\n    \"\"\"Runs build or verify in-process -- the same command `attavo build`\n    or `attavo verify` would run, printing the same reason on a refusal,\n    failure, or halt. A non-pass record is counseled (cmd_counsel, issue\n    #100) and filed (cmd_file_stops, issue #89) before it is transported,\n    so a stop's own counsel record and .filed marker -- the filing\n    command's stdout, the issue file-stops just opened -- exist on disk\n    in time to be committed and pushed in the very same commit as the\n    stage record and its log; a marker written only after the push would\n    never reach the ledger at all, and a second worktree or a fresh clone\n    would refile every stop it finds with no marker beside it. The stage\n    record and the counsel record (when one was written) are then\n    transported together: committed with commit_record and pushed with\n    push_record_commit, whatever the stage record's status -- the record\n    pushes stay the same pushes, made by drive in the run that produced\n    the record (issue #84's rule 42 row).\"\"\"\n    before = latest_attempt_path(records_dir, stage)\n    rc = cmd_build([item_id]) if stage == \"build\" else cmd_verify([item_id])\n    after = latest_attempt_path(records_dir, stage)\n\n    if after is None or after == before:\n/Users/davidbean/Projects/attest/.claude/scheduled_tasks.lock\n/Users/davidbean/Projects/attest/.git/COMMIT_EDITMSG\n/Users/davidbean/Projects/attest/.git/FETCH_HEAD\n/Users/davidbean/Projects/attest/.git/HEAD\n/Users/davidbean/Projects/attest/.git/ORIG_HEAD\n/Users/davidbean/Projects/attest/.git/config\n/Users/davidbean/Projects/attest/.git/description\n/Users/davidbean/Projects/attest/.git/index\n/Users/davidbean/Projects/attest/.gitignore\n/Users/davidbean/Projects/attest/.pytest_cache/.gitignore\n/Users/davidbean/Projects/attest/.pytest_cache/CACHEDIR.TAG\n/Users/davidbean/Projects/attest/.pytest_cache/README.md\n/Users/davidbean/Projects/attest/Claude outputs/phase-2-brief.html\n/Users/davidbean/Projects/attest/Claude outputs/primitives-baseline.html\n/Users/davidbean/Projects/attest/Claude outputs/tenant-zero-pin-v0.2.0.html\n/Users/davidbean/Projects/attest/LICENSE\n/Users/davidbean/Projects/attest/README.md\n/Users/davidbean/Projects/attest/action.yml\n/Users/davidbean/Projects/attest/adapters/README.md\n/Users/davidbean/Projects/attest/attavo.toml\n/Users/davidbean/Projects/attest/attest/rulings.md\n/Users/davidbean/Projects/attest/bin/attavo\n/Users/davidbean/Projects/attest/schema/attestation.schema.json\n/Users/davidbean/Projects/attest/schema/manifest.schema.json\n/Users/davidbean/Projects/attest/scripts/check_record_schema_version.py\n/Users/davidbean/Projects/attest/tests/helpers.py\n/Users/davidbean/Projects/attest/tests/test_action_yml.py\n/Users/davidbean/Projects/attest/tests/test_adapter_claude_code.py\n/Users/davidbean/Projects/attest/tests/test_adapter_codex.py\n/Users/davidbean/Projects/attest/tests/test_adapters.py\n/
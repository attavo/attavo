dbean/Projects/attest/bin/attavo:1960:    run = subprocess.run(f\"{checks_command} {shlex.quote(sha)}\", shell=True, cwd=str(root),\n/Users/davidbean/Projects/attest/bin/attavo:1972:    # checks to a pull request's head, and that commit stops being the\n/Users/davidbean/Projects/attest/bin/attavo:1978:    return {\"command\": checks_command, \"sha\": sha, \"conclusions\": conclusions}, ok\n/Users/davidbean/Projects/attest/bin/attavo:2033:    checks_command = forge_cfg.get(\"checks_command\")\n/Users/davidbean/Projects/attest/bin/attavo:2034:    if not checks_command:\n/Users/davidbean/Projects/attest/bin/attavo:2035:        print(\"attavo verify: refused: no [forge].checks_command in the manifest\")\n/Users/davidbean/Projects/attest/bin/attavo:2042:    # The forge attaches checks to a pull request's head, not to the\n/Users/davidbean/Projects/attest/bin/attavo:2046:    # be merged; build_sha and forge_checks[\"sha\"] can differ, and both\n/Users/davidbean/Projects/attest/bin/attavo:2048:    forge_checks, forge_ok = read_forge_checks(root, checks_command, head_sha)\n/Users/davidbean/Projects/attest/bin/attavo:2060:            \"forge_checks\": forge_checks,\n/Users/davidbean/Projects/attest/bin/attavo:2071:        print(f\"attavo verify: returned ({record_path.name}); the forge checks are not green\")\n/Users/davidbean/Projects/attest/bin/attavo:2167:        \"forge_checks\": forge_checks,\n/Users/davidbean/Projects/attest/bin/attavo:2346:def forge_checks_unconcluded(forge_checks: dict) -> bool:\n/Users/davidbean/Projects/attest/bin/attavo:2347:    \"\"\"Whether poll_forge_checks should keep waiting rather than stop at\n/Users/davidbean/Projects/attest/bin/attavo:2352:    anything else read_forge_checks did not recognize as ok) is not this\n/Users/davidbean/Projects/attest/bin/attavo:2354:    conclusions = forge_checks[\"conclusions\"]\n/Users/davidbean/Projects/attest/bin/attavo:2360:def poll_forge_checks(root: Path, checks_command: str, sha: str) -> tuple[dict, bool]:\n/Users/davidbean/Projects/attest/bin/attavo:2361:    \"\"\"read_forge_checks, retried within drive_forge_poll_bound_s() while\n/Users/davidbean/Projects/attest/bin/attavo:2362:    some check is still unconcluded (forge_checks_unconcluded) -- a check\n/Users/davidbean/Projects/attest/bin/attavo:2373:    forge_checks, ok = read_forge_checks(root, checks_command, sha)\n/Users/davidbean/Projects/attest/bin/attavo:2374:    while not ok and forge_checks_unconcluded(forge_checks) and time.monotonic() < deadline:\n/Users/davidbean/Projects/attest/bin/attavo:2376:        forge_checks, ok = read_forge_checks(root, checks_command, sha)\n/Users/davidbean/Projects/attest/bin/attavo:2377:    return forge_checks, ok\n/Users/davidbean/Projects/attest/bin/attavo:2539:    [forge].checks_command, the forge not green, or a stage that wrote a\n/Users/davidbean/Projects/attest/bin/attavo:2559:    checks_command = (m.get(\"forge\") or {}).get(\"checks_command\")\n/Users/davidbean/Projects/attest/bin/attavo:2560:    if not checks_command:\n/Users/davidbean/Projects/attest/bin/attavo:2561:        print(\"attavo drive: refused: no [forge].checks_command in the manifest\")\n/Users/davidbean/Projects/attest/bin/attavo:2564:    forge_checks, ok = poll_forge_checks(root, checks_command, head_sha)\n/Users/davidbean/Projects/attest/bin/attavo:2567:                                 for c in forge_checks[\"conclusions\"])\n/Users/davidbean/Projects/attest/bin/attavo:2568:                      or \"no checks reported\")\n/Users/davidbean/Projects/attest/bin/attavo:2569:        print(f\"attavo drive: stopped: forge checks not green on {head_sha[:12]}: {conclusions}\")\n/Users/davidbean/Projects/attest/bin/attavo:3247:    -- no-cause, unclassed, or no stop at all -- is \"none\": nobody has\n/Users/davidbean/Projects/attest/tests/test_counsel.py:26:COUNSEL_SCHEMA = json.loads((ROOT / \"schema\" / \"records\" / \"counsel.schema.json\").read_text())\n/Users/davidbean/Projects/attest/tests/test_counsel.py:123:    assert \"checks.sh\" in gate.stdout\n/Users/davidbean/Projects/attest/tests/test_counsel.py:129:            {\"kind\": \"mechanism\", \"path\": \"specs/1/criteria/checks.sh\", \"symbol\": None,\n/Users/davidbean/Projects/attest/tests/test_counsel.py:132:        proposal={\"ruling_text\": \"checks.sh always exits zero and never fails on the tree\",\n/Users/davidbean/Projects/attest/tests/test_counsel.py:140:    jsonschema.validate(record, COUNSEL_SCHEMA)\n/Users/davidbean/Projects/attest/tests/test_counsel.py:145:    assert \"checks.sh\" in record[\"proposal\"][\"ruling_text\"]\n/Users/davidbean/Projects/attest/tests/test_counsel.py:175:    jsonschema.validate(record, COUNSEL_SCHEMA)\n/Users/davidbean/Projects/attest/tests/test_counsel.py:227:    jsonschema.validate(record, COUNSEL_SCHEMA)\n/Users/davidbean/Projects/attest/tests/test_counsel.py:254:    jsonschema.validate(record, COUNSEL_SCHEMA)\n/Users/davidbean/Projects/attest/tests/test_counsel.py:281:    jsonschema.validate(record, COUNSEL_SCHEMA)\n/Users/davidbean/Projects/attest/tests/test_counsel.py:320:    toml.write_text(toml.read_text() + \"\"\"\\n[forge]\\nchecks_command = \"printf 'ci success\\\\n'\"\\n\"\"\")\n/Users/davidbean/Projects/attest/tests/test_build.py:179:    assert rec[\"criteria\"] == [{\"name\": \"checks_built.sh\", \"exit\": 0}]\n/Users/davidbean/Projects/attest/tests/test_build.py:211:    assert rec[\"criteria\"] == [{\"name\": \"checks_built.sh\", \"exit\": 0}]\n/Users/davidbean/Projects/attest/tests/test_build.py:226:    assert \"checks_built.sh\" in gate_line[\"text\"]\n/Users/davidbean/Projects/attest/tests/test_build.py:279:def test_build_without_a_checks_table(tmp_path):\n/Users/davidbean/Projects/attest/tests/test_build.py:280:    \"\"\"Issue #30, acceptance 3. A tenant with no [checks] table is not\n/Users/davidbean/Projects/attest/tests/test_build.py:282:    carries checks: null.\"\"\"\n/Users/davidbean/Projects/attest/tests/test_build.py:291:    assert rec[\"checks\"] is None\n/Users/davidbean/Projects/attest/tests/test_build.py:294:def test_build_fails_when_the_tenant_checks_fail(tmp_path):\n/Users/davidbean/Projects/attest/tests/test_build.py:295:    \"\"\"Issue #30, acceptance 1. The tenant's checks are part of done: a\n/Users/davidbean/Projects/attest/tests/test_build.py:297:    writes pass, if [checks].command exits non-zero. Regression:\n/Users/davidbean/Projects/attest/tests/test_build.py:299:    checks -- the specimen is attavo/code-factory@2c5708d, where a\n/Users/davidbean/Projects/attest/tests/test_build.py:301:    checks because the executor was never told they were part of done.\n/Users/davidbean/Projects/attest/tests/test_build.py:305:    toml.write_text(toml.read_text() + '\\n[checks]\\ncommand = \"exit 7\"\\n')\n/Users/davidbean/Projects/attest/tests/test_build.py:306:    commit_all(root, \"configure checks\")\n/Users/davidbean/Projects/attest/tests/test_build.py:314:    assert rec[\"checks\"] == {\"command\": \"exit 7\", \"exit\": 7}\n/Users/davidbean/Projects/attest/tests/test_build.py:315:    # the criteria and the tests passed -- only the tenant's checks failed\n/Users/davidbean/Projects/attest/tests/test_build.py:316:    assert rec[\"criteria\"] == [{\"name\": \"checks_built.sh\", \"exit\": 0}]\n/Users/davidbean/Projects/attest/tests/test_build.py:320:def test_checks_output_reaches_the_next_iteration(tmp_path):\n/Users/davidbean/Projects/attest/tests/test_build.py:321:    \"\"\"Issue #30, acceptance 2. A non-zero checks exit is fed back to the\n/Users/davidbean/Projects/attest/tests/test_build.py:322:    next iteration -- \"checks exit N\" and the bounded tail of its\n/Users/davidbean/Projects/attest/tests/test_build.py:328:    checks_script = root / \"checks.sh\"\n/Users/davidbean/Projects/attest/tests/test_build.py:329:    checks_script.write_text(\n/Users/davidbean/Projects/attest/tests/test_build.py:332:        \"  echo 'checks: built.txt present'\\n\"\n/Users/davidbean/Projects/attest/tests/test_build.py:335:        \"  echo 'checks: built.txt missing'\\n\"\n/Users/davidbean/Projects/attest/tests/test_build.py:338:    checks_script.chmod(0o755)\n/Users/davidbean/Projects/attest/tests/test_build.py:340:    toml.write_text(toml.read_text() + '\\n[checks]\\ncommand = \"./checks.sh\"\\n')\n/Users/davidbean/Projects/attest/tests/test_build.py:341:    commit_all(root, \"configure checks\")\n/Users/davidbean/Projects/attest/tests/test_build.py:350:    assert rec[\"checks\"] == {\"command\": \"./checks.sh\", \"exit\": 0}\n/Users/davidbean/Projects/attest/tests/test_build.py:353:    assert \"checks exit 1\" in log\n/Users/davidbean/Projects/attest/tests/test_build.py:354:    assert \"checks: built.txt missing\" in log\n/Users/davidbean/Projects/attest/tests/test_build.py:510:    stdout, the tenant's checks' tail -- under a heading, so the pytest\n/Users/davidbean/Projects/attest/tests/test_build.py:778:    checks, is untouched by this adapter-side path). This refusal path\n/Users/davidbean/Projects/attest/tests/test_build.py:784:    outlived-invocation class.\n/Users/davidbean/Projects/attest/tests/test_build.py:851:def test_build_refuses_when_checks_command_exits_2_on_the_approved_tree(tmp_path):\n/Users/davidbean/Projects/attest/tests/test_build.py:852:    \"\"\"Issue #115, acceptance rows 1 and 3. [checks].command exiting 2 on\n/Users/davidbean/Projects/attest/tests/test_build.py:865:                    + '\\n[checks]\\ncommand = \"echo no jsonschema; exit 2\"\\n')\n/Users/davidbean/Projects/attest/tests/test_build.py:866:    commit_all(root, \"configure a broken checks command\")\n/Users/davidbean/Projects/attest/tests/test_build.py:876:    assert rec[\"checks\"] == {\"command\": \"echo no jsonschema; exit 2\", \"exit\": 2}\n/Users/davidbean/Projects/attest/tests/test_build.py:886:def test_build_proceeds_when_checks_command_exits_1_on_the_approved_tree(tmp_path):\n/Users/davidbean/Projects/attest/tests/test_build.py:887:    \"\"\"Issue #115, acceptance row 2. A [checks].command exiting 1 --\n/Users/davidbean/Projects/attest/tests/test_build.py:888:    failing checks, the expected state before a build -- does not refuse:\n/Users/davidbean/Projects/attest/tests/test_build.py:890:    Regression: a preflight that refuses on failing checks would refuse\n/Users/davidbean/Projects/attest/tests/test_build.py:896:    toml.write_text(toml.read_text() + '\\n[checks]\\ncommand = \"exit 1\"\\n')\n/Users/davidbean/Projects/attest/tests/test_build.py:897:    commit_all(root, \"configure a failing checks command\")\n/Users/davidbean/Projects/attest/tests/test_build.py:907:    assert rec[\"checks\"] == {\"command\": \"exit 1\", \"exit\": 1}\ndef derive_stop(status: str, *, refusal: str | None = None, halted: dict | None = None,\n                log: str | None = None, report_class: str | None = None,\n                refusal_provenance: str | None = None) -> dict | None:\n    \"\"\"The stop field for a build or verify record: None for status \"pass\",\n    else {class, provenance, detail} from what the caller already knows.\n\n      - report_class -- payload.get(\"class\") off the adapter's own report\n        line (issue #88, #94), when it names a STOP_CLASSES member -- is\n        that class, provenance \"executor\". build.schema.json and\n        verify.schema.json stay untouched by issue #88 on purpose, so the\n        class lives only on the report line, never a structured field\n        cmd_build or cmd_verify forwards on its own account; the caller\n        reads payload itself and passes this in, since only it still has\n        payload once an iteration ends. This is non-question's and\n        outlived-invocation's only path to a record now (issue #94):\n        CLASS_TEXT_MARKERS disables both for the text scan below, the\n        same way issue #93 disabled ceiling's bare-name match there. A\n        class an adapter does not yet put on its report line --\n        outlived-invocation today, since that refusal path prints no\n        report line at all -- falls to unclassed below, same as any\n        other unnamed cause, until the adapter that raises it puts a\n        class on the line the way non-question already does.\n      - a halt carrying a non-empty halted.question, once it is not a\n        non-question caught above, is a genuine question -- question/spec,\n        with the question's own first line as detail (issue #100's\n        followups). This is the specimen issue #100 itself was built to\n        retire: tenant zero's #663 build-01, a proper question, classed\n        unclassed/product and filed as a product defect with the wrong\n        provenance -- a question is about the definition of done, which is\n        a person's or a ruling's to answer, never the product's own\n        mechanism.\n      - failing that, a refusal or the log itself that already names its\n        class in text (issue #88, #93 for ceiling's own pre-emptive\n        refusal) is that class, provenance \"executor\" -- the log is\n        checked because neither adapter's refusal *field* carries the\n        class today; the class-naming line each adapter prints reaches\n        only the transcript\n      - a refusal that is not that -- the write-outside-claims path\n        itself, not the \"commit ... not authored by the executor\" shape\n        -- is claims-boundary/spec, unless the caller already knows this\n        refusal touched paths.records or paths.specs (issue #140:\n        protected_path_touched, checked ahead of the ordinary claims\n        match in cmd_build) and passes refusal_provenance=\"executor\" --\n        the product's own directories are not a claim a spec makes, so a\n        refusal there is not the spec's boundary to answer for\n      - a returned verify (the forge was not green; no adapter ran) is\n        forge-unconcluded/tenant\n      - an adapter exit whose log carries a declared-ceiling error line is\n        ceiling/product\n      - anything else is unclassed/product, with the log's last line\n        (capped at UNCLASSED_DETAIL_MAX_CHARS) as its detail -- the other\n        class that carries a detail, since every remaining class's\n        evidence already lives in refusal, halted, forge_checks, or the\n        log itself.\n    \"\"\"\n    if status == \"pass\":\n        return None\n    if status == \"returned\":\n        return {\"class\": \"forge-unconcluded\", \"provenance\": \"tenant\", \"detail\": None}\n    if report_class in STOP_CLASSES:\n        return {\"class\": report_class, \"provenance\": \"executor\", \"detail\": None}\n    question = (halted or {}).get(\"question\")\n    if status == \"halted\" and question:\n        return {\"class\": \"question\", \"provenance\": \"spec\",\n               \"detail\": question.splitlines()[0]}\n    known = _carries_a_known_class(refusal) or _carries_a_known_class(log)\n    if known:\n        return {\"class\": known, \"provenance\": \"executor\", \"detail\": None}\n    if status == \"refused\" and refusal is not None and not refusal.startswith(\"commit \"):\n        return {\"class\": \"claims-boundary\", \"provenance\": refusal_provenance or \"spec\",\n               \"detail\": None}\n    if log and any(marker in log.lower() for marker in CEILING_MARKERS):\n        return {\"class\": \"ceiling\", \"provenance\": \"product\", \"detail\": None}\n    return {\"class\": \"unclassed\", \"provenance\": \"product\", \"detail\": _log_last_line(log)}\n\n\ndef gate_stop(refusal: str | None) -> dict:\n    \"\"\"The stop for a refused spec-gate record: class \"gate\", provenance\n    \"spec\", the refusal string itself as cause (issue #137) -- not\n    derive_stop's generic claims-boundary/spec fallback issue #133\n    reused, which named a boundary the record never crossed: \"criterion\n    fails against the tree plus stub: doctor-template-absent.sh\" is not\n    a write outside claims. cmd_spec_gate is untouched by this lane, so\n    a spec record still carries no stop field of its own; this is\n    synthesized wherever a refused one is read (item_stops,\n    cmd_file_stops, proof_no_stop_lacks_cause), never persisted.\"\"\"\n    return {\"class\": \"gate\", \"provenance\": \"spec\", \"detail\": refusal}\n\n\ndef load_records(records_dir: Path) -> dict[str, dict[str, dict]]:\n    \"\"\"{item_id: {stage: latest_record}} for every <records>/<item>/<stage>-NN.json.\"\"\"\n    items: dict[str, dict[str, dict]] = {}\n    if not records_dir.is_dir():\n        return items\n    for item_dir in sorted(p for p in records_dir.iterdir() if p.is_dir()):\n        by_stage: dict[str, dict[int, dict]] = {}\n        for rec in sorted(item_dir.glob(\"*.json\")):\n            m = RECORD_RE.match(rec.name)\n            if not m:\n                continue\n            stage, n = m.group(1), int(m.group(2))\n            try:\n                data = _load_record(rec, item_dir.name)\n            except json.JSONDecodeError:\n                continue\n            by_stage.setdefault(stage, {})[n] = data\n    be worth a person's judgment -- MIN_QUESTION_CHARS, unchanged since\n    v0.15.0), \"report\" (long enough but carries no \"?\" -- issue #88's\n    class A, a status update in the question channel), or \"question\" (a\n    real question).\"\"\"\n    if status != \"question\":\n        return \"done\"\n    if not question or len(question) < MIN_QUESTION_CHARS:\n        return \"fail\"\n    if \"?\" not in question:\n        return \"report\"\n    return \"question\"\n\n\ndef subagent_refusal(response: dict) -> str | None:\n    \"\"\"None if response carries no spawned background work; else the\n    refusal naming the counts (issue #88, class B). Checked on the\n    response itself, not the flag that was supposed to forbid it --\n    tenant zero's specimen spawned three with the tool absent from\n    --allowedTools entirely, so the flag alone is not the mechanism.\"\"\"\n    stats = response.get(\"subagent_stats\") or {}\n    spawned = stats.get(\"spawned\") or 0\n    if not spawned:\n        return None\n    killed = stats.get(\"killed\") or {}\n    killed_total = sum(v or 0 for v in killed.values())\n    return (\n        f\"adapters/claude-code/run: refused: subagent_stats.spawned={spawned} \"\n        f\"-- the {' or '.join(SUBAGENT_TOOLS)} tool spawned work that can \"\n        f\"outlive this invocation (completed={stats.get('completed', 0)}, \"\n        f\"killed={killed_total}, \"\n        f\"started_in_background={stats.get('started_in_background', 0)})\")\n\n\ndef load_canned_responses() -> list[dict] | None:\n    \"\"\"None when ATTAVO_ADAPTER_RESPONSE_FILE is unset. Otherwise the\n    queue this run answers from: a single object repeats for every\n    invocation this adapter makes (unchanged since v0.3.0 -- most tests\n    make exactly one), a JSON array is consumed in order, one response\n    per invocation, its last element repeating once exhausted (issue\n    #88: the non-question retry is a second invocation inside the same\n    adapter run, and a canned test needs to hand it a different answer\n    than the first). Distinct from ATTAVO_ADAPTER_STREAM_FILE below: a\n    canned response here is the final report object itself, the shape\n    the model-derivation and report-field tests exercise, never a stream\n    to map -- unaffected by --output-format actually being stream-json\n    on a real invocation.\"\"\"\n    response_file = os.environ.get(\"ATTAVO_ADAPTER_RESPONSE_FILE\")\n    if not response_file:\n        return None\n    raw = json.loads(Path(response_file).read_text())\n    return raw if isinstance(raw, list) else [raw]\n\n\ndef load_canned_stream() -> list[str] | None:\n    \"\"\"None when ATTAVO_ADAPTER_STREAM_FILE is unset. Otherwise a\n    recorded `claude --output-format stream-json --verbose` transcript,\n    one JSONL line per list entry (issue #26, acceptance row 3) -- fed\n    through the same line-by-line mapping and terminal \"result\" read a\n    real invocation gets, so the mapping is exercised without a live\n    `claude` process.\"\"\"\n    stream_file = os.environ.get(\"ATTAVO_ADAPTER_STREAM_FILE\")\n    if not stream_file:\n        return None\n    return Path(stream_file).read_text().splitlines()\n\n\ndef parse_stream_line(line: str) -> dict | None:\n    \"\"\"One parsed JSONL line, or None when it is blank or not JSON -- a\n    tracing line on the same stream is not an error, just not an event\n    (codex's own parse_events does the same).\"\"\"\n    line = line.strip()\n    if not line:\n        return None\n    try:\n        return json.loads(line)\n    except ValueError:\n        return None\n\n\ndef first_string_arg(tool_input: dict | None) -> str:\n    \"\"\"The first string-valued argument of a tool_use block's input, in\n    declaration order -- a file path or a command, the one value worth a\n    feed line; a tool whose arguments are all non-string (booleans,\n    numbers) reports \"\" rather than guess which one matters.\"\"\"\n    for value in (tool_input or {}).values():\n        if isinstance(value, str):\n            return value\n    return \"\"\n\n\ndef tool_result_content_text(content) -> str:\n    \"\"\"A tool_result block's own text, whichever of claude code's two\n    content shapes it carries: a bare string, or a list of {\"type\":\n    \"text\", \"text\": ...} blocks (an image or other non-text block\n    contributes nothing -- there is no line of text to render).\"\"\"\n    if isinstance(content, str):\n        return content\n    if isinstance(content, list):\n        return \"\\n\".join(b.get(\"text\", \"\") for b in content\n                         if isinstance(b, dict) and b.get(\"type\") == \"text\")\n    return \"\"\n\n\ndef stream_line_events(obj: dict) -> list[tuple[str, str]]:\n    \"\"\"[(kind, text), ...] for one parsed stream-json line -- zero, one,\n    or several (one assistant turn can carry a text block and a tool_use\n    block together, each its own event). An assistant message's text\n    block maps to \"message\", its tool_use blocks to \"tool_call\" (the\n    tool's name and its first string argument); a user message carrying\n    a tool_result block maps to \"tool_result\" (the result's own first\n    line). Everything else on the stream -- system, and \"result\" itself,\n    read separately for the report fields rather than rendered as a feed\n    line -- maps to nothing.\"\"\"\n    events: list[tuple[str, str]] = []\n    content = ((obj.get(\"message\") or {}).get(\"content\") or [])\n    if obj.get(\"type\") == \"assistant\":\n        for block in content:\n            if not isinstance(block, dict):\n                continue\n            if block.get(\"type\") == \"text\" and block.get(\"text\"):\n                events.append((\"message\", block[\"text\"]))\n            elif block.get(\"type\") == \"tool_use\":\n                name = block.get(\"name\") or \"\"\n                arg = first_string_arg(block.get(\"input\"))\n                events.append((\"tool_call\", f\"{name} {arg}\".strip()))\n    elif obj.get(\"type\") == \"user\":\n        for block in content:\n            if isinstance(block, dict) and block.get(\"type\") == \"tool_result\":\n                text = tool_result_content_text(block.get(\"content\"))\n                first_line = text.splitlines()[0] if text.splitlines() else \"\"\n                events.append((\"tool_result\", first_line))\n    return events\n\n\nEVENT_TEXT_MAX_CHARS = 400\n\n\ndef append_event(events_path: str, kind: str, text: str) -> None:\n    \"\"\"One {at, kind, text} JSON line appended to events_path and\n    flushed at once -- the same shape and the same open-write-close\n    discipline bin/attavo's own append_event uses for its iteration and\n    gate events, kept independently here since an adapter is a separate\n    process with no import path into the product.\"\"\"\n    line = {\"at\": datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\"),\n           \"kind\": kind, \"text\": \" \".join(text.split())[:EVENT_TEXT_MAX_CHARS]}\n    with open(events_path, \"a\") as fh:\n        fh.write(json.dumps(line) + \"\\n\")\n\n\ndef invoke_stream(cmd: list[str], events_path: str | None, canned_lines: list[str] | None\n                  ) -> tuple[str, dict | None, int]:\n    \"\"\"(raw transcript text, the terminal \"result\" object or None, exit\n    code) -- from canned_lines (ATTAVO_ADAPTER_STREAM_FILE) when given,\n    else a real `claude --output-format stream-json --verbose`\n    invocation, read line by line as it runs (not buffered until the\n    process exits) so each mapped event reaches events_path while the\n    stage is still in progress. Every raw line reaches the returned\n    transcript, mapped or not -- issue #34's guarantee: the evidence is\n    what build-NN.log saves, not just what this adapter went on to use.\n    \"\"\"\n    raw_lines: list[str] = []\ndef usage_fields(response: dict) -> tuple[int, int, float | None]:\n    \"\"\"(tokens.input, tokens.output, cost_usd) for one response, pulled\n    straight off usage/total_cost_usd -- independent of model derivation,\n    so a retry's first, discarded call still counts (issue #88: a\n    non-question costs two executor turns, and a report line built from\n    the second call alone undercounts by exactly the first one).\"\"\"\n    usage = response.get(\"usage\") or {}\n    tokens_input = ((usage.get(\"input_tokens\", 0) or 0)\n                    + (usage.get(\"cache_read_input_tokens\", 0) or 0)\n                    + (usage.get(\"cache_creation_input_tokens\", 0) or 0))\n    tokens_output = usage.get(\"output_tokens\", 0) or 0\n    return tokens_input, tokens_output, response.get(\"total_cost_usd\")\n\n\ndef add_cost(a: float | None, b: float | None) -> float | None:\n    \"\"\"None when neither call reported a cost; otherwise the sum,\n    treating an absent figure as 0 -- mirrors bin/attavo's own\n    cost_usd accumulation across build iterations.\"\"\"\n    if a is None and b is None:\n        return None\n    return (a or 0) + (b or 0)\n\n\ndef report_fields(response: dict, requested_model: str | None) -> dict | None:\n    \"\"\"The fields common to every final report line, derived from one\n    tool response; None when no model id can be derived at all (the\n    caller must fail loudly rather than emit a report with no identity\n    behind it).\"\"\"\n    model, model_version = derive_model(response, requested_model)\n    if not model:\n        sys.stderr.write(\n            \"adapters/claude-code/run: could not derive a model id -- the \"\n            \"response carried no requested model and an empty \"\n            \"'modelUsage'\\n\")\n        return None\n    if requested_model and response.get(\"modelUsage\") and not model_version:\n        sys.stderr.write(\n            f\"adapters/claude-code/run: requested model {requested_model!r} \"\n            \"matches no modelUsage canonicalModel -- model_version left \"\n            \"null\\n\")\n\n    tokens_input, tokens_output, cost = usage_fields(response)\n    return {\n        \"model\": model,\n        \"model_version\": model_version,\n        \"adapter_version\": adapter_version(),\n        \"tokens\": {\"input\": tokens_input, \"output\": tokens_output},\n        \"cost_usd\": cost,\n    }\n\n\ndef main() -> int:\n    config = load_config()\n    refusal = refused_config_key(config)\n    if refusal:\n        sys.stderr.write(f\"adapters/claude-code/run: refused: {refusal}\\n\")\n        return 1\n\n    stage = os.environ.get(\"ATTAVO_STAGE\") or \"build\"\n    if stage not in (\"build\", \"verify\", \"counsel\"):\n        stage = \"build\"\n    verifying = stage == \"verify\"\n    counseling = stage == \"counsel\"\n    if verifying:\n        instruction, schema = verify_instruction(), VERIFY_SCHEMA\n    elif counseling:\n        instruction, schema = counsel_instruction(), COUNSEL_SCHEMA\n    else:\n        instruction, schema = build_instruction(), STATUS_SCHEMA\n    cmd = build_command(instruction, config, schema, stage)\n\n    ceiling = ceiling_refusal(instruction)\n    if ceiling:\n        sys.stderr.write(f\"adapters/claude-code/run: refused: {ceiling}\\n\")\n        return 1\n\n    if os.environ.get(\"ATTAVO_ADAPTER_DRY_RUN\"):\n        # {\"argv\", \"instruction\", \"schema\"}, not a bare argv list: the\n        # instruction lives in argv's own \"-p\" value here, but a second\n        # adapter (issue #41) can deliver it on stdin instead, where\n        # argv carries no instruction at all -- the envelope is what\n        # stays adapter-agnostic for tests/test_executor_conformance.py.\n        print(json.dumps({\"argv\": cmd, \"instruction\": instruction, \"schema\": schema}))\n        return 0\n\n    responses = load_canned_responses()\n    events_path = os.environ.get(\"ATTAVO_EVENTS\")\n\n    exit_code, response = invoke_once(cmd, responses, 0, events_path)\n    if exit_code is not None:\n        return exit_code\n\n    # An error dressed as a question still costs a ruling act. Treat both\n    # the same way build already treats a non-zero adapter exit: failed,\n    # not a halt someone must rule on. Stage-independent: a tool error or\n    # an absent report is a failure whether this is a build or a verify.\n    if response.get(\"is_error\") or not response.get(\"structured_output\"):\n        return 1\n\n    refusal = subagent_refusal(response)\n    if refusal:\n        sys.stderr.write(refusal + \"\\n\")\n        return 1\n\n    structured = response.get(\"structured_output\") or {}\n\n    if verifying:\n        common = report_fields(response, config.get(\"model\"))\n        if common is None:\n            return 1\n        # .get(), not \"or []\": an absent findings key must reach\n        # cmd_verify as None, distinct from an explicit empty list --\n        # that distinction is the whole fix for issue #46.\n        line = {**common,\n               \"findings\": structured.get(\"findings\"),\n               \"tests_named\": structured.get(\"tests_named\")}\n        print(json.dumps(line))\n        return 0\n\n    if counseling:\n        common = report_fields(response, config.get(\"model\"))\n        if common is None:\n            return 1\n        line = {**common,\n               \"class\": structured.get(\"class\"),\n               \"verdict\": structured.get(\"verdict\"),\n               \"citations\": structured.get(\"citations\"),\n               \"proposal\": structured.get(\"proposal\")}\n        print(json.dumps(line))\n        return 0\n\n    status = structured.get(\"status\", \"done\")\n    question = structured.get(\"question\")\n    cls = question_class(status, question)\n\n    if cls == \"fail\":\n        return 1\n\n    if cls == \"report\":\n        # Issue #88, class A: a report in the question channel is\n        # re-instructed once, in this same invocation, before it ever\n        # reaches a person.\n        reinstruction = instruction + \"\\n\\n\" + REINSTRUCTION\n        cmd2 = build_command(reinstruction, config, schema, stage)\n        exit_code2, response2 = invoke_once(cmd2, responses, 1, events_path)\n        if exit_code2 is not None:\n            return exit_code2\n        if response2.get(\"is_error\") or not response2.get(\"structured_output\"):\n            return 1\n        refusal2 = subagent_refusal(response2)\n        if refusal2:\n            sys.stderr.write(refusal2 + \"\\n\")\n            return 1\n\n        structured2 = response2.get(\"structured_output\") or {}\n        status2 = structured2.get(\"status\", \"done\")\n        question2 = structured2.get(\"question\")\n        cls2 = question_class(status2, question2)\n        if cls2 == \"fail\":\n            return 1\n\n# Rulings\n\nWritten by the merge of a proposed amendment only.\n{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"$id\": \"https://attavo.dev/schema/records/counsel/2\",\n  \"title\": \"attavo counsel record (counsel-NN.json)\",\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"required\": [\n    \"record_version\", \"item\", \"sha\", \"record_stage\", \"record\", \"at\", \"adapter\",\n    \"adapter_config\", \"adapter_version\", \"model\", \"model_version\", \"reports\",\n    \"tokens\", \"cost_usd\", \"wall_clock_s\", \"status\", \"class\", \"verdict\",\n    \"citations\", \"proposal\", \"product_version\", \"product_pin\"\n  ],\n  \"properties\": {\n    \"record_version\": {\"type\": \"integer\", \"minimum\": 1},\n    \"item\": {\"type\": \"string\", \"minLength\": 1},\n    \"sha\": {\"type\": \"string\", \"minLength\": 1},\n    \"record_stage\": {\n      \"type\": \"string\",\n      \"enum\": [\"build\", \"verify\", \"spec\"],\n      \"description\": \"Which stage's non-pass record this counsel invocation read -- \\\"spec\\\" is a refused spec-gate record, read only when no build or verify record exists yet.\"\n    },\n    \"record\": {\n      \"type\": \"string\",\n      \"minLength\": 1,\n      \"description\": \"The stem (e.g. \\\"build-01\\\" or \\\"spec-01\\\") of the non-pass record counsel read.\"\n    },\n    \"at\": {\"type\": \"string\", \"minLength\": 1},\n    \"adapter\": {\"type\": [\"string\", \"null\"]},\n    \"adapter_config\": {\n      \"type\": \"object\",\n      \"description\": \"Copied verbatim from [executor.<adapter>] merged with [executor.<adapter>.counsel].\"\n    },\n    \"adapter_version\": {\"type\": [\"string\", \"null\"]},\n    \"model\": {\"type\": [\"string\", \"null\"]},\n    \"model_version\": {\"type\": [\"string\", \"null\"]},\n    \"reports\": {\n      \"type\": \"array\",\n      \"description\": \"Field names adapters/<name>/conformance.json declares this adapter can supply with a real value (vendor independence, 2026-09-09 ruling) -- [] when no adapter was called or it declares no conformance.json.\",\n      \"items\": {\"type\": \"string\", \"minLength\": 1}\n    },\n    \"tokens\": {\n      \"type\": \"object\",\n      \"additionalProperties\": false,\n      \"required\": [\"input\", \"output\"],\n      \"properties\": {\n        \"input\": {\"type\": \"integer\", \"minimum\": 0},\n        \"output\": {\"type\": \"integer\", \"minimum\": 0}\n      }\n    },\n    \"cost_usd\": {\"type\": [\"number\", \"null\"]},\n    \"wall_clock_s\": {\"type\": \"number\", \"minimum\": 0},\n    \"status\": {\n      \"type\": \"string\",\n      \"enum\": [\"done\", \"failed\"],\n      \"description\": \"\\\"failed\\\" when the adapter exited non-zero or returned no usable structured answer; class, verdict, citations, and proposal are then null/empty.\"\n    },\n    \"class\": {\n      \"type\": [\"string\", \"null\"],\n      \"enum\": [\"non-question\", \"outlived-invocation\", \"no-cause\", \"forge-unconcluded\",\n               \"ceiling\", \"claims-boundary\", \"repeated-act\", \"unclassed\", null],\n      \"description\": \"The stop's class as counsel itself reads it -- independent of, and possibly disagreeing with, the stop.class the counseled record already carries.\"\n    },\n    \"verdict\": {\n      \"type\": [\"string\", \"null\"],\n      \"enum\": [\"answer\", \"patch\", \"person\", null],\n      \"description\": \"\\\"answer\\\": the stop is answerable inside the rules. \\\"patch\\\": the stop is a product defect. \\\"person\\\": the answer would touch the definition of done and no rule covers it.\"\n    },\n    \"citations\": {\n      \"type\": \"array\",\n      \"description\": \"instruction, mechanism, guard -- each a path and symbol or a ruling id.\",\n      \"items\": {\n        \"type\": \"object\",\n        \"additionalProperties\": false,\n        \"required\": [\"kind\", \"path\", \"symbol\", \"ruling_id\"],\n        \"properties\": {\n          \"kind\": {\"type\": \"string\", \"enum\": [\"instruction\", \"mechanism\", \"guard\"]},\n          \"path\": {\"type\": [\"string\", \"null\"]},\n          \"symbol\": {\"type\": [\"string\", \"null\"]},\n          \"ruling_id\": {\"type\": [\"string\", \"null\"]}\n        }\n      }\n    },\n    \"proposal\": {\n      \"type\": \"object\",\n      \"description\": \"The ruling text (verdict \\\"answer\\\"), the patch (verdict \\\"patch\\\"), or the one-line question (verdict \\\"person\\\") -- exactly one populated, matching verdict.\",\n      \"additionalProperties\": false,\n      \"required\": [\"ruling_text\", \"patch\", \"question\"],\n      \"properties\": {\n        \"ruling_text\": {\"type\": [\"string\", \"null\"]},\n        \"patch\": {\n          \"type\": [\"object\", \"null\"],\n          \"additionalProperties\": false,\n          \"required\": [\"file\", \"symbol\", \"rejection_test\", \"diff\"],\n          \"properties\": {\n            \"file\": {\"type\": \"string\", \"minLength\": 1},\n            \"symbol\": {\"type\": \"string\", \"minLength\": 1},\n            \"rejection_test\": {\"type\": \"string\", \"minLength\": 1},\n            \"diff\": {\"type\": \"string\", \"minLength\": 1}\n          }\n        },\n        \"question\": {\"type\": [\"string\", \"null\"]}\n      }\n    },\n    \"product_version\": {\"type\": \"string\", \"minLength\": 1},\n    \"product_pin\": {\"type\": [\"string\", \"null\"]}\n  }\n}\n{\"type\":\"assistant\",\"message\":{\"model\":\"claude-sonnet-5\",\"id\":\"msg_011Cf92LmwkupQ2u2h6SFWvF\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"thinking\",\"thinking\":\"\",\"signature\":\"\"}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":311,\"cache_read_input_tokens\":39499,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":311},\"output_tokens\":8,\"service_tier\":\"standard\",\"inference_geo\":\"not_available\"},\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"80a7dee5-0ee7-4549-9884-9730bc7f652e\",\"uuid\":\"dde24cfe-569b-41bb-a3b0-e40b3481d281\",\"timestamp\":\"2026-09-17T12:37:48.859Z\",\"request_id\":
return p.fail(f\\\"git: {exc}\\\")\\n869\\t    if not install:\\n870\\t        return p.fail(f\\\"{MANIFEST} is not committed; the tenant has no record boundary\\\")\\n871\\t    install_sha = install[0]\\n872\\t    full_chain = git(root, \\\"rev-list\\\", f\\\"{install_sha}..HEAD\\\", \\\"--first-parent\\\").split()\\n873\\t    if not full_chain:\\n874\\t        return p.fail(f\\\"no commit after the install commit {install_sha[:12]}; nothing has been recorded\\\")\\n875\\t\\n876\\t    # issue #74: [doctor] from lets a tenant declare the doctor's read to\\n877\\t    # start at a later commit on main's first-parent line -- the point\\n878\\t    # after which every push arrived through the queue -- rather than the\\n879\\t    # install commit, which on a repository that adopted the product\\n880\\t    # after its history began is a boundary the doctor cannot otherwise\\n881\\t    # see. Any spelling git resolves is accepted (a short sha, a tag, a\\n882\\t    # ref) -- resolved with rev-parse --verify before the first-parent\\n883\\t    # check runs, so the two failure modes stay distinct: a spelling that\\n884\\t    # names no commit at all, and a commit that names one off the line.\\n885\\t    # Checked, not trusted: neither is silently forgiven back to install.\\n886\\t    declared_from = (m.get(\\\"doctor\\\") or {}).get(\\\"from\\\")\\n887\\t    window_start = install_sha\\n888\\t    if declared_from is not None:\\n889\\t        try:\\n890\\t            resolved_from = git(root, \\\"rev-parse\\\", \\\"--verify\\\", f\\\"{declared_from}^{{commit}}\\\").strip()\\n891\\t        except RuntimeError:\\n892\\t            return p.fail(f\\\"[doctor] from {declared_from} does not resolve to a commit\\\")\\n893\\t        if resolved_from != install_sha and resolved_from not in full_chain:\\n894\\t            return p.fail(f\\\"[doctor] from {declared_from} is not on main's first-parent \\\"\\n895\\t                          f\\\"line after the install commit {install_sha[:12]}\\\")\\n896\\t        window_start = resolved_from\\n897\\t\\n898\\t    if window_start == install_sha:\\n899\\t        window_spec = f\\\"{install_sha}..HEAD\\\"\\n900\\t        commits = full_chain\\n901\\t    else:\\n902\\t        window_spec = f\\\"{window_start}^..HEAD\\\"\\n903\\t        commits = git(root, \\\"rev-list\\\", window_spec, \\\"--first-parent\\\").split()\\n904\\t    before_window = len(full_chain) - len(commits)\\n905\\t\\n906\\t    records_rel = m.get(\\\"paths\\\", {}).get(\\\"records\\\", \\\"\\\")\\n907\\t    records_dir = root / records_rel\\n908\\t    named: set[str] = set()\\n909\\t    for stages in load_records(records_dir).values():\\n910\\t        for rec in stages.values():\\n911\\t            sha = rec.get(\\\"sha\\\")\\n912\\t            if isinstance(sha, str):\\n913\\t                named.add(sha)\\n914\\t            for c in rec.get(\\\"commits\\\", []) or []:\\n915\\t                if isinstance(c, str):\\n916\\t                    named.add(c)\\n917\\t    record_commits = set(git(root, \\\"rev-list\\\", window_spec, \\\"--first-parent\\\",\\n918\\t                             \\\"--\\\", records_rel).split()) if records_rel else set()\\n919\\t    merges = set(git(root, \\\"rev-list\\\", window_spec, \\\"--first-parent\\\", \\\"--merges\\\").split())\\n920\\t    boundary_paths = ((m.get(\\\"spec\\\") or {}).get(\\\"boundary\\\") or {}).get(\\\"paths\\\") or []\\n921\\t\\n922\\t    # Every first-parent commit in the window is exactly one of three\\n923\\t    # (issue #72): recorded (a record names it, or its diff touches\\n924\\t    # paths.records), ordinary (a merge that doesn't), or unrecorded\\n925\\t    # (anything else -- on a protected main with a queue, a non-merge\\n926\\t    # commit is the only way a change arrives without the forge).\\n927\\t    recorded, ordinary, unrecorded = [], [], []\\n928\\t    boundary_evasions = 0\\n929\\t    for c in commits:\\n930\\t        if c in named or c in record_commits:\\n931\\
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01A78oRZFfE2Z7veZe9nQgv8","type":"tool_result","content":"860\tdef proof_no_commit_lacks_record(root: Path, m: dict | None) -> Proof:\n861\t    p = Proof(\"no-commit-lacks-record\", \"no commit lacks a record\")\n862\t    if m is None:\n863\t        return p.fail(f\"no {MANIFEST} at {root}; the tenant has no record boundary\")\n864\t    try:\n865\t        install = git(root, \"log\", \"--diff-filter=A\", \"--format=%H\",\n866\t                      \"--reverse\", \"--\", MANIFEST).split()\n867\t    except RuntimeError as exc:\n868\t        return p.fail(f\"git: {exc}\")\n869\t    if not install:\n870\t        return p.fail(f\"{MANIFEST} is not committed; the tenant has no record boundary\")\n871\t    install_sha = install[0]\n872\t    full_chain = git(root, \"rev-list\", f\"{install_sha}..HEAD\", \"--first-parent\").split()\n873\t    if not full_chain:\n874\t        return p.fail(f\"no commit after the install commit {install_sha[:12]}; nothing has been recorded\")\n875\t\n876\t    # issue #74: [doctor] from lets a tenant declare the doctor's read to\n877\t    # start at a later commit on main's first-parent line -- the point\n878\t    # after which every push arrived through the queue -- rather than the\n879\t    # install commit, which on a repository that adopted the product\n880\t    # after its history began is a boundary the doctor cannot otherwise\n881\t    # see. Any spelling git resolves is accepted (a short sha, a tag, a\n882\t    # ref) -- resolved with rev-parse --verify before the first-parent\n883\t    # check runs, so the two failure modes stay distinct: a spelling that\n884\t    # names no commit at all, and a commit that names one off the line.\n885\t    # Checked, not trusted: neither is silently forgiven back to install.\n886\t    declared_from = (m.get(\"doctor\") or {}).get(\"from\")\n887\t    window_start = install_sha\n888\t    if declared_from is not None:\n889\t        try:\n890\t            resolved_from = git(root, \"rev-parse\", \"--verify\", f\"{declared_from}^{{commit}}\").strip()\n891\t        except RuntimeError:\n892\t            return p.fail(f\"[doctor] from {declared_from} does not resolve to a commit\")\n893\t        if resolved_from != install_sha and resolved_from not in full_chain:\n894\t            return p.fail(f\"[doctor] from {declared_from} is not on main's first-parent \"\n895\t                          f\"line after the install commit {install_sha[:12]}\")\n896\t        window_start = resolved_from\n897\t\n898\t    if window_start == install_sha:\n899\t        window_spec = f\"{install_sha}..HEAD\"\n900\t        commits = full_chain\n901\t    else:\n902\t        window_spec = f\"{window_start}^..HEAD\"\n903\t        commits = git(root, \"rev-list\", window_spec, \"--first-parent\").split()\n904\t    before_window = len(full_chain) - len(commits)\n905\t\n906\t    records_rel = m.get(\"paths\", {}).get(\"records\", \"\")\n907\t    records_dir = root / records_rel\n908\t    named: set[str] = set()\n909\t    for stages in load_records(records_dir).values():\n910\t        for rec in stages.values():\n911\t            sha = rec.get(\"sha\")\n912\t            if isinstance(sha, str):\n913\t                named.add(sha)\n914\t            for c in rec.get(\"commits\", []) or []:\n915\t                if isinstance(c, str):\n916\t                    named.add(c)\n917\t    record_commits = set(git(root, \"rev-list\", window_spec, \"--first-parent\",\n918\t                             \"--\", records_rel).split()) if records_rel else set()\n919\t    merges = set(git(root, \"rev-list\", window_spec, \"--first-parent\", \"--merges\").split())\n920\t    boundary_paths = ((m.get(\"spec\") or {}).get(\"boundary\") or {}).get(\"paths\") or []\n921\t\n922\t    # Every first-parent commit in the window is exactly one of three\n923\t    # (issue #72): recorded (a record names it, or its diff touches\n924\t    # paths.records), ordinary (a merge that doesn't), or unrecorded\n925\t    # (anything else -- on a protected main with a queue, a non-merge\n926\t    # commit is the only way a change arrives without the forge).\n927\t    recorded, ordinary, unrecorded = [], [], []\n928\t    boundary_evasions = 0\n929\t    for c in commits:\n930\t        if c in named or c in record_commits:\n931\t            recorded.append(c)\n932\t        elif c in merges:\n933\t            ordinary.append(c)\n934\t            if boundary_paths and touches_boundary(root, c, boundary_paths):\n935\t                boundary_evasions += 1\n936\t        else:\n937\t            unrecorded.append(c)\n938\t\n939\t    counts = f\"{len(recorded)} recorded, {len(ordinary)} ordinary, {len(unrecorded)} unrecorded\"\n940\t    evasions = boundary_evasions if boundary_paths else \"n/a\"\n941\t    extra = {\"recorded\": len(recorded), \"ordinary\": len(ordinary),\n942\t             \"unrecorded\": len(unrecorded), \"boundary_evasions\": evasions,\n943\t             \"before_window\": before_window}\n944\t    if unrecorded:\n945\t        return p.fail(f\"{unrecorded[-1][:12]} lacks a record; {counts}; boundary evasions: \"\n946\t                      f\"{evasions}; before the window: {before_window}\", **extra)\n947\t    return p.hold(f\"{counts}; boundary evasions: {evasions}; before the window: {before_window}\",\n948\t                  **extra)\n949\t\n950\t\n951\tADAPTER_EXIT_RE = re.compile(r\"^\\[adapter exited \\d+\\]$\")\n952\t\n953\t\n954\tdef _log_owes_tool_error(log: str | None) -> bool:\n955\t    \"\"\"True when a log's last non-empty line is exactly an adapter-exit\n956\t    marker and every line before it parses as JSON -- an adapter's own\n957\t    event stream, never a tool's own words (issue #94's own specimen,\n958\t    tenant zero's attest/records/659/verify-01.log: codex's\n959\t    \"thread.started\" event, then nothing but \"[adapter exited 1]\" -- the\n960\t    tool's real error line dropped before this reached the log, issue\n961\t    #86's own bug in split_adapter_stdout). A log that is only the exit\n962\t    marker, nothing before it at all, still owes the same line.\"\"\"\n963\t    if not log:\n964\t        return False\n965\t    lines = [l for l in log.splitlines() if l.strip()]\n966\t    if not lines or not ADAPTER_EXIT_RE.match(lines[-1]):\n967\t        return False\n968\t    for l in lines[:-1]:\n969\t        try:\n970\t            json.loads(l)\n971\t        except ValueError:\n972\t            return False\n973\t    return True\n974\t\n975\t"}]},"parent_tool_use_id":null,"session_id":"3c2265da-a647-4435-b721-67a9a41aa656","uuid":"a09b0dac-6017-4029-a9ae-1be67e3d8c05","timestamp":"2026-09-17T15:24:18.902Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-148/bin/attavo","content":"def proof_no_commit_lacks_record(root: Path, m: dict | None) -> Proof:\n    p = Proof(\"no-commit-lacks-record\", \"no commit lacks a record\")\n    if m is None:\n        return p.fail(f\"no {MANIFEST} at {root}; the tenant has no record boundary\")\n    try:\n        install = git(root, \"log\", \"--diff-filter=A\", \"--format=%H\",\n                      \"--reverse\", \"--\", MANIFEST).split()\n    except RuntimeError as exc:\n        return p.fail(f\"git: {exc}\")\n    if not install:\n        return p.fail(f\"{MANIFEST} is not committed; the tenant has no record boundary\")\n    install_sha = install[0]\n    full_chain = git(root, \"rev-list\", f\"{install_sha}..HEAD\", \"--first-parent\").split()\n    if not full_chain:\n        return p.fail(f\"no commit after the install commit {install_sha[:12]}; nothing has been recorded\")\n\n    # issue #74: [doctor] from lets a tenant declare the doctor's read to\n    # start at a later commit on main's first-parent line -- the point\n    # after which every push arrived through the queue -- rather than the\n    # install commit, which on a repository that adopted the product\n    # after its history began is a boundary the doctor cannot otherwise\n    # see. Any spelling git resolves is accepted (a short sha, a tag, a\n    # ref) -- resolved with rev-parse --verify before the first-parent\n    # check runs, so the two failure modes stay distinct: a spelling that\n    # names no commit at all, and a commit that names one off the line.\n    # Checked, not trusted: neither is silently forgiven back to install.\n    declared_from = (m.get(\"doctor\") or {}).get(\"from\")\n    window_start = install_sha\n    if declared_from is not None:\n        try:\n            resolved_from = git(root, \"rev-parse\", \"--verify\", f\"{declared_from}^{{commit}}\").strip()\n        except RuntimeError:\n            return p.fail(f\"[doctor] from {declared_from} does not resolve to a commit\")\n        if resolved_from != install_sha and resolved_from not in full_chain:\n            return p.fail(f\"[doctor] from {declared_from} is not on main's first-parent \"\n                          f\"line after the install commit {install_sha[:12]}\")\n        window_start = resolved_from\n\n    if window_start == install_sha:\n        window_spec = f\"{install_sha}..HEAD\"\n        commits = full_chain\n    else:\n        window_spec = f\"{window_start}^..HEAD\"\n        commits = git(root, \"rev-list\", window_spec, \"--first-parent\").split()\n    before_window = len(full_chain) - len(commits)\n\n    records_rel = m.get(\"paths\", {}).get(\"records\", \"\")\n    records_dir = root / records_rel\n    named: set[str] = set()\n    for stages in load_records(records_dir).values():\n        for rec in stages.values():\n            sha = rec.get(\"sha\")\n            if isinstance(sha, str):\n                named.add(sha)\n            for c in rec.get(\"commits\", []) or []:\n                if isinstance(c, str):\n                    named.add(c)\n    record_commits = set(git(root, \"rev-list\", window_spec, \"--first-parent\",\n                             \"--\", records_rel).split()) if records_rel else set()\n    merges = set(git(root, \"rev-list\", window_spec, \"--first-parent\", \"--merges\").split())\n    boundary_paths = ((m.get(\"spec\") or {}).get(\"boundary\") or {}).get(\"paths\") or []\n\n    # Every first-parent commit in the window is exactly one of three\n    # (issue #72): recorded (a record names it, or its diff touches\n    # paths.records), ordinary (a merge that doesn't), or unrecorded\n    # (anything else -- on a protected main with a queue, a non-merge\n    # commit is the only way a change arrives without the forge).\n    recorded, ordinary, unrecorded = [], [], []\n    boundary_evasions = 0\n    for c in commits:\n        if c in named or c in record_commits:\n            recorded.append(c)\n        elif c in merges:\n            ordinary.append(c)\n            if boundary_paths and touches_boundary(root, c, boundary_paths):\n                boundary_evasions += 1\n        else:\n            unrecorded.append(c)\n\n    counts = f\"{len(recorded)} recorded, {len(ordinary)} ordinary, {len(unrecorded)} unrecorded\"\n    evasions = boundary_evasions if boundary_paths else \"n/a\"\n    extra = {\"recorded\": len(recorded), \"ordinary\": len(ordinary),\n             \"unrecorded\": len(unrecorded), \"boundary_evasions\": evasions,\n             \"before_window\": before_window}\n    if unrecorded:\n        return p.fail(f\"{unrecorded[-1][:12]} lacks a record; {counts}; boundary evasions: \"\n                      f\"{evasions}; before the window: {before_window}\", **extra)\n    return p.hold(f\"{counts}; boundary evasions: {evasions}; before the window: {before_window}\",\n                  **extra)\n\n\nADAPTER_EXIT_RE = re.compile(r\"^\\[adapter exited \\d+\\]$\")\n\n\ndef _log_owes_tool_error(log: str | None) -> bool:\n    \"\"\"True when a log's last non-empty line is exactly an adapter-exit\n    marker and every line before it parses as JSON -- an adapter's own\n    event stream, never a tool's own words (issue #94's own specimen,\n    tenant zero's attest/records/659/verify-01.log: codex's\n    \"thread.started\" event, then nothing but \"[adapter exited 1]\" -- the\n    tool's real error line dropped before this reached the log, issue\n    #86's own bug in split_adapter_stdout). A log that is only the exit\n    marker, nothing before it at all, still owes the same line.\"\"\"\n    if not log:\n        return False\n    lines = [l for l in log.splitlines() if l.strip()]\n    if not lines or not ADAPTER_EXIT_RE.match(lines[-1]):\n        return False\n    for l in lines[:-1]:\n        try:\n            json.loads(l)\n        except ValueError:\n            return False\n    return True\n\n","numLines":116,"startLine":860,"totalLines":3383}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XTNkPWBVUVdFJEE2wgociy","type":"tool_result","content":"from __future__ import annotations\n\nimport shlex\nimport subprocess\nfrom pathlib import Path\nfrom typing import Any\n\nfrom attavo.records import latest_record\nfrom attavo.types import DriveReport\n\n# --- drive --report, AS A STUB. This file exists so the spec's criteria can\n# be shown to run and to be satisfiable; it is not the implementation and\n# must not be shipped. It guesses the item's state from which files exist\n# under its records directory. It does not use drive_state, so it knows\n# nothing of an approval that expired, a build bound to an earlier approval,\n# or a review of an earlier build; it treats every marker without a record\n# as died, so it never reads running or hung; it never reads merged,\n# refused, or counsel. tests/test_report.py fails on it by design. The\n# build writes the report from the product's own functions (drive_state,\n# invocations_without_record, invocation_alive, stall_bound_s,\n# read_forge_checks, merge_introducing_records, parse_attempts). ---\n\n\ndef drive_report(root: Path, m: dict[str, Any], item_id: str) -> DriveReport:\n    d = root / m[\"paths\"][\"records\"] / item_id\n    head = subprocess.run([\"git\", \"-C\", str(root), \"rev-parse\", \"HEAD\"], capture_output=True,\n                          text=True, check=False).stdout.strip() or None\n    r: DriveReport = {\"item\": item_id, \"state\": \"refused\", \"kind\": \"yours\", \"says\": \"\", \"stage\": None,\n                      \"attempt\": None, \"record\": None, \"stop_class\": None, \"counsel\": None,\n                      \"filed\": None, \"head\": head, \"checks\": None, \"since\": None,\n                      \"last_event_age_s\": None}\n\n    def have(stem: str) -> list[Path]:\n        return sorted(d.glob(f\"{stem}-[0-9][0-9].json\"))\n\n    if not have(\"approval\"):\n        r[\"state\"], r[\"says\"] = \"waiting-on-approval\", \"Waiting on you: approve the spec\"\n        return r\n    for marker in sorted(d.glob(\"*.started\")):\n        if not (d / f\"{marker.stem}.json\").exists():\n            stage, nn = marker.stem.rsplit(\"-\", 1)\n            r[\"state\"], r[\"kind\"], r[\"stage\"], r[\"attempt\"], r[\"stop_class\"] = (\n                \"owes-recovery\", \"acts\", stage, int(nn), \"died\")\n            r[\"says\"] = f\"Attempt {int(nn)} wrote no record; recovery would record it as died\"\n            return r\n    builds = have(\"build\")\n    if not builds:\n        r[\"state\"], r[\"kind\"], r[\"stage\"], r[\"says\"] = \"next-build\", \"acts\", \"build\", \"Build is next\"\n        return r\n    latest: dict[str, Any] = dict(latest_record(d, \"build\") or {})\n    if latest.get(\"status\") != \"pass\":\n        filed = d / f\"{builds[-1].stem}.filed\"\n        r[\"state\"], r[\"stage\"], r[\"record\"] = \"stopped\", \"build\", builds[-1].stem\n        r[\"stop_class\"] = (latest.get(\"stop\") or {}).get(\"class\")\n        r[\"filed\"] = filed.read_text().strip() if filed.exists() else None\n        r[\"says\"] = f\"Needs you: build stopped as {r['stop_class']}\"\n        return r\n    if have(\"verify\"):\n        r[\"state\"], r[\"says\"] = \"ready-to-merge\", \"Ready to merge\"\n        return r\n    command = (m.get(\"forge\") or {}).get(\"checks_command\", \"true\")\n    out = subprocess.run(f\"{command} {shlex.quote(head or '')}\", shell=True, cwd=str(root),\n                         capture_output=True, text=True, check=False).stdout\n    checks = [dict(zip((\"name\", \"conclusion\"), line.rsplit(\" \", 1))) for line in out.splitlines() if \" \" in line]\n    r[\"checks\"], r[\"stage\"] = checks, \"verify\"\n    named = \", \".join(f\"{c['name']} {c['conclusion']}\" for c in checks if c[\"conclusion\"] != \"success\")\n    if any(c[\"conclusion\"] == \"in_progress\" for c in checks):\n        r[\"state\"], r[\"kind\"], r[\"says\"] = \"waiting-on-checks\", \"waits\", f\"Waiting on GitHub: {named}\"\n    elif named:\n        r[\"state\"], r[\"kind\"] = \"blocked-on-checks\", \"waits\"\n        r[\"says\"] = f\"Blocked: {named} on {(head or '')[:7]}; nothing runs until the head changes\"\n    else:\n        r[\"state\"], r[\"kind\"], r[\"says\"] = \"next-review\", \"acts\", \"Review is next\"\n    return r\n{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"$id\": \"https://attavo.dev/drive-report/v1\",\n  \"title\": \"attavo drive --report\",\n  \"description\": \"What one item is waiting on and for whom: a pure function of its records, its markers, and one read of the forge. Printing it changes nothing.\",\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"required\": [\n    \"item\",\n    \"state\",\n    \"kind\",\n    \"says\",\n    \"stage\",\n    \"attempt\",\n    \"record\",\n    \"stop_class\",\n    \"counsel\",\n    \"filed\",\n    \"head\",\n    \"checks\",\n    \"since\",\n    \"last_event_age_s\"\n  ],\n  \"properties\": {\n    \"item\": {\n      \"type\": \"string\"\n    },\n    \"state\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"waiting-on-approval\",\n        \"running\",\n        \"owes-recovery\",\n        \"stopped\",\n        \"next-build\",\n        \"waiting-on-checks\",\n        \"blocked-on-checks\",\n        \"next-review\",\n        \"ready-to-merge\",\n        \"merged\",\n        \"refused\"\n      ]\n    },\n    \"kind\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"yours\",\n        \"waits\",\n        \"acts\",\n        \"done\"\n      ],\n      \"description\": \"yours: a person's act is next. waits: nothing to do but wait. acts: the next drive would act. done: nothing further from here.\"\n    },\n    \"says\": {\n      \"type\": \"string\",\n      \"description\": \"One sentence in the operator's words.\"\n    },\n    \"stage\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ],\n      \"enum\": [\n        \"build\",\n        \"verify\",\n        null\n      ]\n    },\n    \"attempt\": {\n      \"type\": [\n        \"integer\",\n        \"null\"\n      ]\n    },\n    \"record\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"stop_class\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"counsel\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"filed\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"head\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"checks\": {\n      \"type\": [\n        \"array\",\n        \"null\"\n      ],\n      \"items\": {\n        \"type\": \"object\",\n        \"required\": [\n          \"name\",\n          \"conclusion\"\n        ],\n        \"properties\": {\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"conclusion\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    },\n    \"since\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"last_event_age_s\": {\n      \"type\": [\n        \"integer\",\n        \"null\"\n      ]\n    }\n  }\n}\n\"\"\"`attavo drive N --report`: what one item is waiting on and for whom, as a\npure function of its records, its markers, and one read of the forge. It\nwrites nothing, starts nothing, and never waits (#171: a refusal nobody\ncould read, twice on #194).\n\nRun: python3 -m pytest tests -q\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport os\nimport socket\nimport time\nfrom datetime import datetime, timedelta, timezone\nfrom pathlib import Path\nfrom typing import Any\n\nfrom helpers import commit_all, git, make_tenant\nfrom test_attest_time import INVOCATIONS, make_item\nfrom test_drive import (\n    GREEN_FORGE,\n    RED_FORGE,\n    UNCONCLUDED_FORGE,\n    add_bare_remote,\n    add_drive_stall_bound,\n    add_forge,\n    approve_item,\n    head_of,\n    record_files,\n    records_dir,\n    run_attavo,\n    write_dead_marker,\n)\n\nROOT = Path(__file__).resolve().parent.parent\nSCHEMA = json.loads((ROOT / \"schema\" / \"drive-report.schema.json\").read_text())\n\n\ndef report(root: Path, item: str = \"1\", env: dict[str, Any] | None = None) -> dict[str, Any]:\n    before = (head_of(root), git(root, \"status\", \"--porcelain\"),\n              sorted(p.name for p in records_dir(root, item).glob(\"*\")))\n    run = run_attavo(root, \"drive\", item, \"--report\", env=env)\n    assert run.returncode == 0, run.stdout + run.stderr\n    after = (head_of(root), git(root, \"status\", \"--porcelain\"),\n             sorted(p.name for p in records_dir(root, item).glob(\"*\")))\n    assert before == after, \"the report wrote something\"\n    out: dict[str, Any] = json.loads(run.stdout)\n    assert set(out) == set(SCHEMA[\"required\"]) == set(SCHEMA[\"properties\"]), out\n    assert out[\"state\"] in SCHEMA[\"properties\"][\"state\"][\"enum\"], out\n    assert out[\"kind\"] in SCHEMA[\"properties\"][\"kind\"][\"enum\"], out\n    assert \"drive\" not in out[\"says\"].lower() and \"verify\" not in out[\"says\"].lower(), out\n    return out\n\n\ndef test_report_names_a_red_check_and_the_head_and_writes_nothing(tmp_path: Path) -> None:\n    \"\"\"#171: on a concluded red check the product printed one line into a\n    log nobody read, exited 1, and wrote nothing. The report says it for as\n    long as it is true.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, RED_FORGE)\n    add_bare_remote(root, tmp_path)\n    approve_item(root)\n    assert run_attavo(root, \"drive\", \"1\").returncode == 0\n    out = report(root)\n    assert (out[\"state\"], out[\"kind\"], out[\"stage\"]) == (\"blocked-on-checks\", \"waits\", \"verify\"), out\n    assert out[\"checks\"] == [{\"name\": \"ci\", \"conclusion\": \"failure\"}], out\n    assert \"ci failure\" in out[\"says\"] and head_of(root)[:7] in out[\"says\"], out\n    assert record_files(root, \"verify\") == []\n    assert report(root) == out, \"two reads of one level differ\"\n\n\ndef test_report_never_waits_on_a_check_that_is_still_running(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, UNCONCLUDED_FORGE)\n    add_bare_remote(root, tmp_path)\n    approve_item(root)\n    assert run_attavo(root, \"drive\", \"1\").returncode == 0\n    started = time.monotonic()\n    out = report(root, env={\"ATTAVO_DRIVE_POLL_BOUND_S\": \"30\", \"ATTAVO_DRIVE_POLL_INTERVAL_S\": \"5\"})\n    assert time.monotonic() - started < 4, \"the report polled\"\n    assert (out[\"state\"], out[\"kind\"]) == (\"waiting-on-checks\", \"waits\"), out\n    assert \"ci in_progress\" in out[\"says\"], out\n\n\ndef test_report_walks_an_item_from_approval_to_ready(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    add_bare_remote(root, tmp_path)\n    assert run_attavo(root, \"spec-gate\", \"1\").returncode == 0\n    out = report(root)\n    assert (out[\"state\"], out[\"kind\"]) == (\"waiting-on-approval\", \"yours\"), out\n    approve_item(root)\n    assert (report(root)[\"state\"], report(root)[\"kind\"]) == (\"next-build\", \"acts\")\n    assert run_attavo(root, \"drive\", \"1\").returncode == 0\n    assert (report(root)[\"state\"], report(root)[\"stage\"]) == (\"next-review\", \"verify\")\n    assert run_attavo(root, \"drive\", \"1\").returncode == 0\n    out = report(root)\n    assert (out[\"state\"], out[\"kind\"], out[\"says\"]) == (\"ready-to-merge\", \"yours\", \"Ready to merge\"), out\n\n\ndef test_report_says_what_recovery_would_record_for_a_dead_invocation(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    add_drive_stall_bound(root)\n    approve_item(root)\n    write_dead_marker(root, \"build\", 1)\n    out = report(root)\n    assert (out[\"state\"], out[\"kind\"], out[\"stage\"], out[\"attempt\"], out[\"stop_class\"]) == (\n        \"owes-recovery\", \"acts\", \"build\", 1, \"died\"), out\n    assert not (records_dir(root) / \"build-01.json\").exists()\n\n\ndef test_report_names_the_stopped_record_its_class_its_counsel_and_its_issue(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    add_drive_stall_bound(root)\n    approve_item(root)\n    write_dead_marker(root, \"build\", 1)\n    assert run_attavo(root, \"drive\", \"--recover\", \"1\").returncode == 0\n    d = records_dir(root)\n    (d / \"build-01.filed\").write_text(\"https://example.invalid/issues/9\\n\")\n    commit_all(root, \"the stop is filed\")\n    out = report(root)\n    assert (out[\"state\"], out[\"kind\"], out[\"record\"], out[\"stop_class\"], out[\"filed\"]) == (\n        \"stopped\", \"yours\", \"build-01\", \"died\", \"https://example.invalid/issues/9\"), out\n    assert out[\"says\"].startswith(\"Needs you: build attempt 01 stopped as died\"), out\n\n\ndef write_live_marker(root: Path, stage: str, nn: int, age_s: int) -> None:\n    \"\"\"A marker whose pid is this test's own process: alive, on this host,\n    begun age_s seconds ago, with no events file.\"\"\"\n    at = (datetime.now(timezone.utc) - timedelta(seconds=age_s)).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n    marker = records_dir(root) / f\"{stage}-{nn:02d}.started\"\n    marker.parent.mkdir(parents=True, exist_ok=True)\n    marker.write_text(json.dumps({\"at\": at, \"host\": socket.gethostname(), \"pid\": os.getpid(),\n                                  \"sha\": head_of(root), \"product_version\": \"fixture\"}))\n    commit_all(root, \"invocation marker for item 1\")\n\n\ndef test_report_reads_an_expired_approval_as_yours_and_says_why(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    approve_item(root)\n    spec = root / \"specs\" / \"1\" / \"spec.md\"\n    spec.write_text(spec.read_text() + \"\\n\")\n    commit_all(root, \"touch the spec after approval\")\n    out = report(root)\n    assert (out[\"state\"], out[\"kind\"]) == (\"waiting-on-approval\", \"yours\"), out\n    assert \"expired\" in out[\"says\"], out\n\n\ndef test_report_reads_a_live_invocation_inside_the_bound_as_running(tmp_path: Path) -> None:\n    \"\"\"Launch stayed on the screen while #194's build ran: a view guessed\n    whose move it was.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    add_drive_stall_bound(root, 60)\n    approve_item(root)\n    write_live_marker(root, \"build\", 1, age_s=5)\n    out = report(root)\n    assert (out[\"state\"], out[\"kind\"], out[\"stage\"], out[\"attempt\"]) == (\"running\", \"waits\", \"build\", 1), out\n    assert out[\"since\"] and isinstance(out[\"last_event_age_s\"], int), out\n    assert out[\"says\"].startswith(\"Build running since \"), out\n\n\ndef test_report_reads_a_live_invocation_past_the_bound_as_hung_and_ends_nothing(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    add_drive_stall_bound(root, 60)\n    approve_item(root)\n    write_live_marker(root, \"build\", 1, age_s=600)\n    out = report(root)\n    assert (out[\"state\"], out[\"kind\"], out[\"stop_class\"]) == (\"owes-recovery\", \"acts\", \"hung\"), out\n    os.kill(os.getpid(), 0)  # the report terminated nothing: this process is its \"hung\" pid\n\n\ndef test_report_reads_a_review_of_an_earlier_build_as_review_next(tmp_path: Path) -> None:\n    \"\"\"#109: a later build supersedes the latest review; the item is not\n    ready and is not stopped.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    add_bare_remote(root, tmp_path)\n    approve_item(root)\n    assert run_attavo(root, \"drive\", \"1\").returncode == 0\n    assert run_attavo(root, \"drive\", \"1\").returncode == 0\n    assert report(root)[\"state\"] == \"ready-to-merge\"\n    build = json.loads(record_files(root, \"build\")[-1].read_text())\n    build[\"sha\"] = \"f\" * 40\n    (records_dir(root) / \"build-02.json\").write_text(json.dumps(build))\n    commit_all(root, \"a second build record, minted by hand\")\n    out = report(root)\n    assert (out[\"state\"], out[\"kind\"], out[\"stage\"]) == (\"next-review\", \"acts\", \"verify\"), out\n\n\ndef test_report_does_not_read_a_failed_build_of_an_earlier_approval_as_stopped(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    approve_item(root)\n    (records_dir(root) / \"build-01.json\").write_text(json.dumps(\n        {\"status\": \"failed\", \"sha\": \"b\" * 40, \"approval_sha\": \"0\" * 40,\n         \"stop\": {\"class\": \"gate\", \"provenance\": \"tenant\", \"detail\": None}}))\n    commit_all(root, \"a failed build bound to an approval that is not the current one\")\n    out = report(root)\n    assert (out[\"state\"], out[\"kind\"]) == (\"next-build\", \"acts\"), out\n\n\ndef test_report_names_the_counsel_record_that_read_the_stop(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    add_drive_stall_bound(root)\n    approve_item(root)\n    write_dead_marker(root, \"build\", 1)\n    assert run_attavo(root, \"drive\", \"--recover\", \"1\").returncode == 0\n    (records_dir(root) / \"counsel-01.json\").write_text(json.dumps(\n        {\"record\": \"build-01\", \"record_stage\": \"build\", \"verdict\": \"person\", \"status\": \"done\"}))\n    commit_all(root, \"counsel read the stop\")\n    out = report(root)\n    assert (out[\"state\"], out[\"counsel\"]) == (\"stopped\", \"counsel-01\"), out\n    assert \"counsel-01\" in out[\"says\"] and \"person\" in out[\"says\"], out\n\n\ndef test_report_reads_a_merged_item_as_merged(tmp_path: Path) -> None:\n    \"\"\"The screen showed #204 as waiting, its pull request \"not read\", after\n    it had merged: the branch survived and no view read the history.\"\"\"\n    root, merge = make_item(tmp_path, INVOCATIONS)\n    run = run_attavo(root, \"drive\", \"1\", \"--report\")\n    assert run.returncode == 0, run.stdout + run.stderr\n    out = json.loads(run.stdout)\n    assert (out[\"state\"], out[\"kind\"]) == (\"merged\", \"done\"), out\n    assert merge[:7] in out[\"says\"], out\n\n\ndef test_report_reads_every_item_this_repository_carries(tmp_path: Path) -> None:\n    \"\"\"A new reader must not wedge on a record that already exists (#194's\n    verify-01). Every item under this repository's own records directory\n    yields a report, in-process, with no forge read of its own.\"\"\"\n    from attavo.common import read_manifest\n    from attavo.report import drive_report\n    m = read_manifest(ROOT)\n    assert m is not None\n    m = {**m, \"forge\": {**(m.get(\"forge\") or {}), \"checks_command\": \"printf 'ci success\\\\n'\"}}\n    items = sorted(p.name for p in (ROOT / m[\"paths\"][\"records\"]).iterdir() if p.is_dir())\n    assert items\n    for item in items:\n        out = drive_report(ROOT, m, item)\n        assert out[\"state\"] in SCHEMA[\"properties\"][\"state\"][\"enum\"], (item, out)\ndiff --git a/../../../../attavo/drive.py b/attavo/drive.py\nindex be6fbab..1e950e4 100644\n--- a/../../../../attavo/drive.py\n+++ b/attavo/drive.py\n@@ -266,7 +266,8 @@ def cmd_drive(argv: list[str]) -> int:\n     cast(io.TextIOWrapper, sys.stdout).reconfigure(line_buffering=True)\n     until_ready = \"--until-ready\" in argv\n     recover = \"--recover\" in argv\n-    positional = [a for a in argv if a not in (\"--until-ready\", \"--recover\")]\n+    report = \"--report\" in argv\n+    positional = [a for a in argv if a not in (\"--until-ready\", \"--recover\", \"--report\")]\n     root = Path(\".\").resolve()\n     item_id = positional[0] if positional else derive_item_id(root)\n     if not item_id:\n@@ -278,6 +279,12 @@ def cmd_drive(argv: list[str]) -> int:\n         print(f\"attavo drive: no {MANIFEST} at {root}\", file=sys.stderr)\n         return 2\n \n+    if report:\n+        import json\n+        from attavo.report import drive_report\n+        print(json.dumps(drive_report(root, m, item_id), indent=2))\n+        return 0\n+\n     if recover:\n         return _drive_recover(root, m, item_id)\n \ndiff --git a/../../../../attavo/types.py b/attavo/types.py\nindex 43cdfa4..96295bb 100644\n--- a/../../../../attavo/types.py\n+++ b/attavo/types.py\n@@ -203,3 +203,22 @@ class AttestRecord(TypedDict):\n # What counsel reads a stop from: a build or verify record, or a refused\n # spec-gate record (issue #133).\n StageRecord = SpecRecord | BuildRecord | VerifyRecord\n+\n+\n+class DriveReport(TypedDict):\n+    \"\"\"What `attavo drive N --report` prints (schema/drive-report.schema.json):\n+    the item's level, read from its records, its markers, and the forge.\"\"\"\n+    item: str\n+    state: str\n+    kind: str\n+    says: str\n+    stage: str | None\n+    attempt: int | None\n+    record: str | None\n+    stop_class: str | None\n+    counsel: str | None\n+    filed: str | None\n+    head: str | None\n+    checks: list[dict[str, str]] | None\n+    since: str | None\n+    last_event_age_s: int | None\ndiff --git a/../../../../tests/test_types_mirror_schemas.py b/tests/test_types_mirror_schemas.py\nindex e51c81c..91d0b70 100644\n--- a/../../../../tests/test_types_mirror_schemas.py\n+++ b/tests/test_types_mirror_schemas.py\n@@ -26,6 +26,7 @@ RECORD_KINDS = {\n     \"VerifyRecord\": \"records/verify.schema.json\",\n     \"CounselRecord\": \"records/counsel.schema.json\",\n     \"AttestRecord\": \"attestation.schema.json\",\n+    \"DriveReport\": \"drive-report.schema.json\",\n }\n \n # The Stop sub-shape appears in build and verify records, each with its own","is_error":false}]},"parent_tool_use_id":null,"session_id":"8de61c42-af71-4210-8ec4-d6e4cd3c023f","uuid":"bfbd8432-f19c-4262-97d2-a8526babbce9","timestamp":"2026-09-20T17:32:56.509Z","tool_use_result":{"stdout":"from __future__ import annotations\n\nimport shlex\nimport subprocess\nfrom pathlib import Path\nfrom typing import Any\n\nfrom attavo.records import latest_record\nfrom attavo.types import DriveReport\n\n# --- drive --report, AS A STUB. This file exists so the spec's criteria can\n# be shown to run and to be satisfiable; it is not the implementation and\n# must not be shipped. It guesses the item's state from which files exist\n# under its records directory. It does not use drive_state, so it knows\n# nothing of an approval that expired, a build bound to an earlier approval,\n# or a review of an earlier build; it treats every marker without a record\n# as died, so it never reads running or hung; it never reads merged,\n# refused, or counsel. tests/test_report.py fails on it by design. The\n# build writes the report from the product's own functions (drive_state,\n# invocations_without_record, invocation_alive, stall_bound_s,\n# read_forge_checks, merge_introducing_records, parse_attempts). ---\n\n\ndef drive_report(root: Path, m: dict[str, Any], item_id: str) -> DriveReport:\n    d = root / m[\"paths\"][\"records\"] / item_id\n    head = subprocess.run([\"git\", \"-C\", str(root), \"rev-parse\", \"HEAD\"], capture_output=True,\n                          text=True, check=False).stdout.strip() or None\n    r: DriveReport = {\"item\": item_id, \"state\": \"refused\", \"kind\": \"yours\", \"says\": \"\", \"stage\": None,\n                      \"attempt\": None, \"record\": None, \"stop_class\": None, \"counsel\": None,\n                      \"filed\": None, \"head\": head, \"checks\": None, \"since\": None,\n                      \"last_event_age_s\": None}\n\n    def have(stem: str) -> list[Path]:\n        return sorted(d.glob(f\"{stem}-[0-9][0-9].json\"))\n\n    if not have(\"approval\"):\n        r[\"state\"], r[\"says\"] = \"waiting-on-approval\", \"Waiting on you: approve the spec\"\n        return r\n    for marker in sorted(d.glob(\"*.started\")):\n        if not (d / f\"{marker.stem}.json\").exists():\n            stage, nn = marker.stem.rsplit(\"-\", 1)\n            r[\"state\"], r[\"kind\"], r[\"stage\"], r[\"attempt\"], r[\"stop_class\"] = (\n                \"owes-recovery\", \"acts\", stage, int(nn), \"died\")\n            r[\"says\"] = f\"Attempt {int(nn)} wrote no record; recovery would record it as died\"\n            return r\n    builds = have(\"build\")\n    if not builds:\n        r[\"state\"], r[\"kind\"], r[\"stage\"], r[\"says\"] = \"next-build\", \"acts\", \"build\", \"Build is next\"\n        return r\n    latest: dict[str, Any] = dict(latest_record(d, \"build\") or {})\n    if latest.get(\"status\") != \"pass\":\n        filed = d / f\"{builds[-1].stem}.filed\"\n        r[\"state\"], r[\"stage\"], r[\"record\"] = \"stopped\", \"build\", builds[-1].stem\n        r[\"stop_class\"] = (latest.get(\"stop\") or {}).get(\"class\")\n        r[\"filed\"] = filed.read_text().strip() if filed.exists() else None\n        r[\"says\"] = f\"Needs you: build stopped as {r['stop_class']}\"\n        return r\n    if have(\"verify\"):\n        r[\"state\"], r[\"says\"] = \"ready-to-merge\", \"Ready to merge\"\n        return r\n    command = (m.get(\"forge\") or {}).get(\"checks_command\", \"true\")\n    out = subprocess.run(f\"{command} {shlex.quote(head or '')}\", shell=True, cwd=str(root),\n                         capture_output=True, text=True, check=False).stdout\n    checks = [dict(zip((\"name\", \"conclusion\"), line.rsplit(\" \", 1))) for line in out.splitlines() if \" \" in line]\n    r[\"checks\"], r[\"stage\"] = checks, \"verify\"\n    named = \", \".join(f\"{c['name']} {c['conclusion']}\" for c in checks if c[\"conclusion\"] != \"success\")\n    if any(c[\"conclusion\"] == \"in_progress\" for c in checks):\n        r[\"state\"], r[\"kind\"], r[\"says\"] = \"waiting-on-checks\", \"waits\", f\"Waiting on GitHub: {named}\"\n    elif named:\n        r[\"state\"], r[\"kind\"] = \"blocked-on-checks\", \"waits\"\n        r[\"says\"] = f\"Blocked: {named} on {(head or '')[:7]}; nothing runs until the head changes\"\n    else:\n        r[\"state\"], r[\"kind\"], r[\"says\"] = \"next-review\", \"acts\", \"Review is next\"\n    return r\n{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"$id\": \"https://attavo.dev/drive-report/v1\",\n  \"title\": \"attavo drive --report\",\n  \"description\": \"What one item is waiting on and for whom: a pure function of its records, its markers, and one read of the forge. Printing it changes nothing.\",\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"required\": [\n    \"item\",\n    \"state\",\n    \"kind\",\n    \"says\",\n    \"stage\",\n    \"attempt\",\n    \"record\",\n    \"stop_class\",\n    \"counsel\",\n    \"filed\",\n    \"head\",\n    \"checks\",\n    \"since\",\n    \"last_event_age_s\"\n  ],\n  \"properties\": {\n    \"item\": {\n      \"type\": \"string\"\n    },\n    \"state\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"waiting-on-approval\",\n        \"running\",\n        \"owes-recovery\",\n        \"stopped\",\n        \"next-build\",\n        \"waiting-on-checks\",\n        \"blocked-on-checks\",\n        \"next-review\",\n        \"ready-to-merge\",\n        \"merged\",\n        \"refused\"\n      ]\n    },\n    \"kind\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"yours\",\n        \"waits\",\n        \"acts\",\n        \"done\"\n      ],\n      \"description\": \"yours: a person's act is next. waits: nothing to do but wait. acts: the next drive would act. done: nothing further from here.\"\n    },\n    \"says\": {\n      \"type\": \"string\",\n      \"description\": \"One sentence in the operator's words.\"\n    },\n    \"stage\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ],\n      \"enum\": [\n        \"build\",\n        \"verify\",\n        null\n      ]\n    },\n    \"attempt\": {\n      \"type\": [\n        \"integer\",\n        \"null\"\n      ]\n    },\n    \"record\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"stop_class\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"counsel\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"filed\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"head\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"checks\": {\n      \"type\": [\n        \"array\",\n        \"null\"\n      ],\n      \"items\": {\n        \"type\": \"object\",\n        \"required\": [\n          \"name\",\n          \"conclusion\"\n        ],\n        \"properties\": {\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"conclusion\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    },\n    \"since\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"last_event_age_s\": {\n      \"type\": [\n        \"integer\",\n        \"null\"\n      ]\n    }\n  }\n}\n\"\"\"`attavo drive N --report`: what one item is waiting on and for whom, as a\npure function of its records, its markers, and one read of the forge. It\nwrites nothing, starts nothing, and never waits (#171: a refusal nobody\ncould read, twice on #194).\n\nRun: python3 -m pytest tests -q\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport os\nimport socket\nimport time\nfrom datetime import datetime, timedelta, timezone\nfrom pathlib import Path\nfrom typing import Any\n\nfrom helpers import commit_all, git, make_tenant\nfrom test_attest_time import INVOCATIONS, make_item\nfrom test_drive import (\n    GREEN_FORGE,\n    RED_FORGE,\n    UNCONCLUDED_FORGE,\n    add_bare_remote,\n    add_drive_stall_bound,\n    add_forge,\n    approve_item,\n    head_of,\n    record_files,\n    records_dir,\n    run_attavo,\n    write_dead_marker,\n)\n\nROOT = Path(__file__).resolve().parent.parent\nSCHEMA = json.loads((ROOT / \"schema\" / \"drive-report.schema.json\").read_text())\n\n\ndef report(root: Path, item: str = \"1\", env: dict[str, Any] | None = None) -> dict[str, Any]:\n    before = (head_of(root), git(root, \"status\", \"--porcelain\"),\n              sorted(p.name for p in records_dir(root, item).glob(\"*\")))\n    run = run_attavo(root, \"drive\", item, \"--report\", env=env)\n    assert run.returncode == 0, run.stdout + run.stderr\n    after = (head_of(root), git(root, \"status\", \"--porcelain\"),\n             sorted(p.name for p in records_dir(root, item).glob(\"*\")))\n    assert before == after, \"the report wrote something\"\n    out: dict[str, Any] = json.loads(run.stdout)\n    assert set(out) == set(SCHEMA[\"required\"]) == set(SCHEMA[\"properties\"]), out\n    assert out[\"state\"] in SCHEMA[\"properties\"][\"state\"][\"enum\"], out\n    assert out[\"kind\"] in SCHEMA[\"properties\"][\"kind\"][\"enum\"], out\n    assert \"drive\" not in out[\"says\"].lower() and \"verify\" not in out[\"says\"].lower(), out\n    return out\n\n\ndef test_report_names_a_red_check_and_the_head_and_writes_nothing(tmp_path: Path) -> None:\n    \"\"\"#171: on a concluded red check the product printed one line into a\n    log nobody read, exited 1, and wrote nothing. The report says it for as\n    long as it is true.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, RED_FORGE)\n    add_bare_remote(root, tmp_path)\n    approve_item(root)\n    assert run_attavo(root, \"drive\", \"1\").returncode == 0\n    out = report(root)\n    assert (out[\"state\"], out[\"kind\"], out[\"stage\"]) == (\"blocked-on-checks\", \"waits\", \"verify\"), out\n    assert out[\"checks\"] == [{\"name\": \"ci\", \"conclusion\": \"failure\"}], out\n    assert \"ci failure\" in out[\"says\"] and head_of(root)[:7] in out[\"says\"], out\n    assert record_files(root, \"verify\") == []\n    assert report(root) == out, \"two reads of one level differ\"\n\n\ndef test_report_never_waits_on_a_check_that_is_still_running(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, UNCONCLUDED_FORGE)\n    add_bare_remote(root, tmp_path)\n    approve_item(root)\n    assert run_attavo(root, \"drive\", \"1\").returncode == 0\n    started = time.monotonic()\n    out = report(root, env={\"ATTAVO_DRIVE_POLL_BOUND_S\": \"30\", \"ATTAVO_DRIVE_POLL_INTERVAL_S\": \"5\"})\n    assert time.monotonic() - started < 4, \"the report polled\"\n    assert (out[\"state\"], out[\"kind\"]) == (\"waiting-on-checks\", \"waits\"), out\n    assert \"ci in_progress\" in out[\"says\"], out\n\n\ndef test_report_walks_an_item_from_approval_to_ready(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    add_bare_remote(root, tmp_path)\n    assert run_attavo(root, \"spec-gate\", \"1\").returncode == 0\n    out = report(root)\n    assert (out[\"state\"], out[\"kind\"]) == (\"waiting-on-approval\", \"yours\"), out\n    approve_item(root)\n    assert (report(root)[\"state\"], report(root)[\"kind\"]) == (\"next-build\", \"acts\")\n    assert run_attavo(root, \"drive\", \"1\").returncode == 0\n    assert (report(root)[\"state\"], report(root)[\"stage\"]) == (\"next-review\", \"verify\")\n    assert run_attavo(root, \"drive\", \"1\").returncode == 0\n    out = report(root)\n    assert (out[\"state\"], out[\"kind\"], out[\"says\"]) == (\"ready-to-merge\", \"yours\", \"Ready to merge\"), out\n\n\ndef test_report_says_what_recovery_would_record_for_a_dead_invocation(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    add_drive_stall_bound(root)\n    approve_item(root)\n    write_dead_marker(root, \"build\", 1)\n    out = report(root)\n    assert (out[\"state\"], out[\"kind\"], out[\"stage\"], out[\"attempt\"], out[\"stop_class\"]) == (\n        \"owes-recovery\", \"acts\", \"build\", 1, \"died\"), out\n    assert not (records_dir(root) / \"build-01.json\").exists()\n\n\ndef test_report_names_the_stopped_record_its_class_its_counsel_and_its_issue(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    add_drive_stall_bound(root)\n    approve_item(root)\n    write_dead_marker(root, \"build\", 1)\n    assert run_attavo(root, \"drive\", \"--recover\", \"1\").returncode == 0\n    d = records_dir(root)\n    (d / \"build-01.filed\").write_text(\"https://example.invalid/issues/9\\n\")\n    commit_all(root, \"the stop is filed\")\n    out = report(root)\n    assert (out[\"state\"], out[\"kind\"], out[\"record\"], out[\"stop_class\"], out[\"filed\"]) == (\n        \"stopped\", \"yours\", \"build-01\", \"died\", \"https://example.invalid/issues/9\"), out\n    assert out[\"says\"].startswith(\"Needs you: build attempt 01 stopped as died\"), out\n\n\ndef write_live_marker(root: Path, stage: str, nn: int, age_s: int) -> None:\n    \"\"\"A marker whose pid is this test's own process: alive, on this host,\n    begun age_s seconds ago, with no events file.\"\"\"\n    at = (datetime.now(timezone.utc) - timedelta(seconds=age_s)).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n    marker = records_dir(root) / f\"{stage}-{nn:02d}.started\"\n    marker.parent.mkdir(parents=True, exist_ok=True)\n    marker.write_text(json.dumps({\"at\": at, \"host\": socket.gethostname(), \"pid\": os.getpid(),\n                                  \"sha\": head_of(root), \"product_version\": \"fixture\"}))\n    commit_all(root, \"invocation marker for item 1\")\n\n\ndef test_report_reads_an_expired_approval_as_yours_and_says_why(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    approve_item(root)\n    spec = root / \"specs\" / \"1\" / \"spec.md\"\n    spec.write_text(spec.read_text() + \"\\n\")\n    commit_all(root, \"touch the spec after approval\")\n    out = report(root)\n    assert (out[\"state\"], out[\"kind\"]) == (\"waiting-on-approval\", \"yours\"), out\n    assert \"expired\" in out[\"says\"], out\n\n\ndef test_report_reads_a_live_invocation_inside_the_bound_as_running(tmp_path: Path) -> None:\n    \"\"\"Launch stayed on the screen while #194's build ran: a view guessed\n    whose move it was.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    add_drive_stall_bound(root, 60)\n    approve_item(root)\n    write_live_marker(root, \"build\", 1, age_s=5)\n    out = report(root)\n    assert (out[\"state\"], out[\"kind\"], out[\"stage\"], out[\"attempt\"]) == (\"running\", \"waits\", \"build\", 1), out\n    assert out[\"since\"] and isinstance(out[\"last_event_age_s\"], int), out\n    assert out[\"says\"].startswith(\"Build running since \"), out\n\n\ndef test_report_reads_a_live_invocation_past_the_bound_as_hung_and_ends_nothing(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    add_drive_stall_bound(root, 60)\n    approve_item(root)\n    write_live_marker(root, \"build\", 1, age_s=600)\n    out = report(root)\n    assert (out[\"state\"], out[\"kind\"], out[\"stop_class\"]) == (\"owes-recovery\", \"acts\", \"hung\"), out\n    os.kill(os.getpid(), 0)  # the report terminated nothing: this process is its \"hung\" pid\n\n\ndef test_report_reads_a_review_of_an_earlier_build_as_review_next(tmp_path: Path) -> None:\n    \"\"\"#109: a later build supersedes the latest review; the item is not\n    ready and is not stopped.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    add_bare_remote(root, tmp_path)\n    approve_item(root)\n    assert run_attavo(root, \"drive\", \"1\").returncode == 0\n    assert run_attavo(root, \"drive\", \"1\").returncode == 0\n    assert report(root)[\"state\"] == \"ready-to-merge\"\n    build = json.loads(record_files(root, \"build\")[-1].read_text())\n    build[\"sha\"] = \"f\" * 40\n    (records_dir(root) / \"build-02.json\").write_text(json.dumps(build))\n    commit_all(root, \"a second build record, minted by hand\")\n    out = report(root)\n    assert (out[\"state\"], out[\"kind\"], out[\"stage\"]) == (\"next-review\", \"acts\", \"verify\"), out\n\n\ndef test_report_does_not_read_a_failed_build_of_an_earlier_approval_as_stopped(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    approve_item(root)\n    (records_dir(root) / \"build-01.json\").write_text(json.dumps(\n        {\"status\": \"failed\", \"sha\": \"b\" * 40, \"approval_sha\": \"0\" * 40,\n         \"stop\": {\"class\": \"gate\", \"provenance\": \"tenant\", \"detail\": None}}))\n    commit_all(root, \"a failed build bound to an approval that is not the current one\")\n    out = report(root)\n    assert (out[\"state\"], out[\"kind\"]) == (\"next-build\", \"acts\"), out\n\n\ndef test_report_names_the_counsel_record_that_read_the_stop(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    add_drive_stall_bound(root)\n    approve_item(root)\n    write_dead_marker(root, \"build\", 1)\n    assert run_attavo(root, \"drive\", \"--recover\", \"1\").returncode == 0\n    (records_dir(root) / \"counsel-01.json\").write_text(json.dumps(\n        {\"record\": \"build-01\", \"record_stage\": \"build\", \"verdict\": \"person\", \"status\": \"done\"}))\n    commit_all(root, \"counsel read the stop\")\n    out = report(root)\n    assert (out[\"state\"], out[\"counsel\"]) == (\"stopped\", \"counsel-01\"), out\n    assert \"counsel-01\" in out[\"says\"] and \"person\" in out[\"says\"], out\n\n\ndef test_report_reads_a_merged_item_as_merged(tmp_path: Path) -> None:\n    \"\"\"The screen showed #204 as waiting, its pull request \"not read\", after\n    it had merged: the branch survived and no view read the history.\"\"\"\n    root, merge = make_item(tmp_path, INVOCATIONS)\n    run = run_attavo(root, \"drive\", \"1\", \"--report\")\n    assert run.returncode == 0, run.stdout + run.stderr\n    out = json.loads(run.stdout)\n    assert (out[\"state\"], out[\"kind\"]) == (\"merged\", \"done\"), out\n    assert merge[:7] in out[\"says\"], out\n\n\ndef test_report_reads_every_item_this_repository_carries(tmp_path: Path) -> None:\n    \"\"\"A new reader must not wedge on a record that already exists (#194's\n    verify-01). Every item under this repository's own records directory\n    yields a report, in-process, with no forge read of its own.\"\"\"\n    from attavo.common import read_manifest\n    from attavo.report import drive_report\n    m = read_manifest(ROOT)\n    assert m is not None\n    m = {**m, \"forge\": {**(m.get(\"forge\") or {}), \"checks_command\": \"printf 'ci success\\\\n'\"}}\n    items = sorted(p.name for p in (ROOT / m[\"paths\"][\"records\"]).iterdir() if p.is_dir())\n    assert items\n    for item in items:\n        out = drive_report(ROOT, m, item)\n        assert out[\"state\"] in SCHEMA[\"properties\"][\"state\"][\"enum\"], (item, out)\ndiff --git a/../../../../attavo/drive.py b/attavo/drive.py\nindex be6fbab..1e950e4 100644\n--- a/../../../../attavo/drive.py\n+++ b/attavo/drive.py\n@@ -266,7 +266,8 @@ def cmd_drive(argv: list[str]) -> int:\n     cast(io.TextIOWrapper, sys.stdout).reconfigure(line_buffering=True)\n     until_ready = \"--until-ready\" in argv\n     recover = \"--recover\" in argv\n-    positional = [a for a in argv if a not in (\"--until-ready\", \"--recover\")]\n+    report = \"--report\" in argv\n+    positional = [a for a in argv if a not in (\"--until-ready\", \"--recover\", \"--report\")]\n     root = Path(\".\").resolve()\n     item_id = positional[0] if positional else derive_item_id(root)\n     if not item_id:\n@@ -278,6 +279,12 @@ def cmd_drive(argv: list[str]) -> int:\n         print(f\"attavo drive: no {MANIFEST} at {root}\", file=sys.stderr)\n         return 2\n \n+    if report:\n+        import json\n+        from attavo.report import drive_report\n+        print(json.dumps(drive_report(root, m, item_id), indent=2))\n+        return 0\n+\n     if recover:\n         return _drive_recover(root, m, item_id)\n \ndiff --git a/../../../../attavo/types.py b/attavo/types.py\nindex 43cdfa4..96295bb 100644\n--- a/../../../../attavo/types.py\n+++ b/attavo/types.py\n@@ -203,3 +203,22 @@ class AttestRecord(TypedDict):\n # What counsel reads a stop from: a build or verify record, or a refused\n # spec-gate record (issue #133).\n StageRecord = SpecRecord | BuildRecord | VerifyRecord\n+\n+\n+class DriveReport(TypedDict):\n+    \"\"\"What `attavo drive N --report` prints (schema/drive-report.schema.json):\n+    the item's level, read from its records, its markers, and the forge.\"\"\"\n+    item: str\n+    state: str\n+    kind: str\n+    says: str\n+    stage: str | None\n+    attempt: int | None\n+    record: str | None\n+    stop_class: str | None\n+    counsel: str | None\n+    filed: str | None\n+    head: str | None\n+    checks: list[dict[str, str]] | None\n+    since: str | None\n+    last_event_age_s: int | None\ndiff --git a/../../../../tests/test_types_mirror_schemas.py b/tests/test_types_mirror_schemas.py\nindex e51c81c..91d0b70 100644\n--- a/../../../../tests/test_types_mirror_schemas.py\n+++ b/tests/test_types_mirror_schemas.py\n@@ -26,6 +26,7 @@ RECORD_KINDS = {\n     \"VerifyRecord\": \"records/verify.schema.json\",\n     \"CounselRecord\": \"records/counsel.schema.json\",\n     \"AttestRecord\": \"attestation.schema.json\",\n+    \"DriveReport\": \"drive-report.schema.json\",\n }\n \n # The Stop sub-shape appears in build and verify records, each with its own","stderr":"","interrupted":false,"isImage":false,"returnCodeInterpretation":"Files differ","noOutputExpected":false}}

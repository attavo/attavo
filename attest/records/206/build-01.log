e type is one shape and the schemas carry the same three keys.\nSTOP_HOMES = (\"records/build.schema.json\", \"records/verify.schema.json\")\n\n\ndef load(path: str) -> dict[str, Any]:\n    schema: dict[str, Any] = json.loads((SCHEMA / path).read_text())\n    return schema\n\n\n@pytest.mark.parametrize(\"kind\", sorted(RECORD_KINDS))\ndef test_the_typeddict_keys_equal_the_schemas_properties(kind: str) -> None:\n    schema = load(RECORD_KINDS[kind])\n    td = getattr(types, kind)\n    assert set(td.__annotations__) == set(schema[\"properties\"])\n\n\n@pytest.mark.parametrize(\"kind\", sorted(RECORD_KINDS))\ndef test_the_typeddicts_required_keys_equal_the_schemas_required(kind: str) -> None:\n    schema = load(RECORD_KINDS[kind])\n{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"$id\": \"https://attavo.dev/schema/records/counsel/3\",\n  \"title\": \"attavo counsel record (counsel-NN.json)\",\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"required\": [\n    \"record_version\", \"item\", \"sha\", \"record_stage\", \"record\", \"at\", \"adapter\",\n    \"adapter_config\", \"adapter_version\", \"model\", \"model_version\", \"reports\",\n    \"tokens\", \"cost_usd\", \"wall_clock_s\", \"status\", \"class\", \"verdict\",\n    \"citations\", \"proposal\", \"forge\", \"question\", \"product_version\", \"product_pin\"\n  ],\n  \"properties\": {\n    \"record_version\": {\"type\": \"integer\", \"minimum\": 1},\n    \"item\": {\"type\": \"string\", \"minLength\": 1},\n    \"sha\": {\"type\": \"string\", \"minLength\": 1},\n    \"record_stage\": {\n      \"type\": \"string\",\n      \"enum\": [\"build\", \"verify\", \"spec\"],\n      \"description\": \"Which stage's non-pass record this counsel invocation read -- \\\"spec\\\" is a refused spec-gate record, read only when no build or verify record exists yet.\"\n    },\n    \"record\": {\n      \"type\": \"string\",\n      \"minLength\": 1,\n      \"description\": \"The stem (e.g. \\\"bui
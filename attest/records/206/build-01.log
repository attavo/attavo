       if age is None or age <= bound:\n                print(f\"attavo drive: {marker.stem} is running (pid {pid}, last event \"\n                      f\"{'unknown' if age is None else int(age)} s ago, bound {bound} s); \"\n                      f\"nothing to recover\")\n                continue\n            cls = \"hung\"\n            try:'''\nnew='''        stage, nn, log, last_at, age, cls = read_invocation(root, bound, marker, info)\n        pid, host = info.get(\"pid\"), info.get(\"host\")\n        if cls == \"running\":\n            print(f\"attavo drive: {marker.stem} is running (pid {pid}, last event \"\n                  f\"{'unknown' if age is None else int(age)} s ago, bound {bound} s); \"\n                  f\"nothing to recover\")\n            continue\n        if cls == \"hung\":\n            try:'''\nassert old in s\ns=s.replace(old,new,1)\nold2='''        else:\n            cls = \"died\"\n            detail = (f\"pid {pid} on {host} is not running'''\nassert old2 in s\ns=s.replace(old2,'''        else:\n            detail = (f\"pid {pid} on {host} is not running''',1)\ns=s.replace('''            detail = (f\"pid {pid} on {host} alive with no event for {int(age)} s \"''','''            detail = (f\"pid {pid} on {host} alive with no event for {int(cast(float, age))} s \"''',1)\nopen(p,'w').write(s)\nEOF\ngit diff attavo/drive.py","description":"Extract read_invocation from _drive_recover"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1175,"cache_read_input_tokens":73345,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1175},"output_tokens":3,"service_tier":"standard","inference_geo":"not_available"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"8de61c42-af71-4210-8ec4-d6e4cd3c023f","uuid":"f44c007e-a1db-4e33-bcc4-040eba2cf358","timestamp":"20
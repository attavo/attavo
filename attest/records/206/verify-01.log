f(records_dir: Path, stem: str) -> tuple[str, CounselRecord] | None:\n    \"\"\"The latest counsel record that read the stop named stem.\"\"\"\n    attempts = parse_attempts(records_dir, \"counsel\")\n    for nn in sorted(attempts, reverse=True):\n        if attempts[nn].get(\"record\") == stem:\n            return f\"counsel-{nn:02d}\", attempts[nn]\n    return None\n\n\ndef _stopped(r: DriveReport, records_dir: Path, stage: str, stem: str, record: dict[str, Any]) -> DriveReport:\n    stop = record.get(\"stop\") or {}\n    stop_class = stop.get(\"class\")\n    r[\"state\"], r[\"kind\"], r[\"stage\"] = \"stopped\", \"yours\", stage\n    r[\"attempt\"], r[\"record\"], r[\"stop_class\"] = int(stem.rsplit(\"-\", 1)[1]), stem, stop_class\n    r[\"filed\"] = _filed(records_dir, stem)\n    how = f\"as {stop_class}\" if stop_class else f\"({record.get('status')})\"\n    says = f\"Needs you: {_WORD[stage]} attempt {stem.rsplit('-', 1)[1]} stopped {how}\"\n    counsel = _counsel_of(records_dir, stem)\n    if counsel:\n        r[\"counsel\"] = counsel[0]\n        verdict = _COUNSEL_SAYS.get(str(counsel[1].get(\"verdict\")))\n        says += f\"; {counsel[0]} {verdict or 'could not read it'}\"\n    if r[\"filed\"]:\n        says += f\"; filed as {r['filed']}\"\n    r[\"says\"] = says\n    return r\n\n\ndef _invocation(r: DriveReport, reading: InvocationReading, info: dict[str, Any],\n                bound: int) -> DriveReport:\n    stage, nn, _log, _last_at, age, cls = reading\n    r[\"stage\"], r[\"attempt\"], r[\"stop_class\"] = stage, nn, None if cls == \"running\" else cls\n    r[\"since\"] = info.get(\"at\") if isinstance(info.get(\"at\"), str) else None\n    r[\"last_event_age_s\"] = None if age is None else int(age)\n    word = _WORD[stage]\n    if cls == \"running\":\n        r[\"state\"], r[\"kind\"] = \"running\", \"waits\"\n        r[\"says\"] = (f\"{word.capitalize()} running since {r['since'] or 'an unknown time'}; \"\n                     f\"nothing to do until it finishes\")\n    else:\n        r[\"state\"], r[\"kind\"] = \"owes-recovery\", \"acts\"\n        if cls == \"hung\":\n            r[\"says\"] = (f\"{word.capitalize()} attempt {nn:02d} is alive but has had no event for \"\n                         f\"{r['last_event_age_s']} s (bound {bound} s); recovery would end it and \"\n                         f\"record it as hung\")\n        else:\n            r[\"says\"] = (f\"{word.capitalize()} attempt {nn:02d} is gone and wrote no record; \"\n                         f\"recovery would record it as died\")\n    return r\n\n\ndef _pending(root: Path, m: dict[str, Any], records_dir: Path, r: DriveReport) -> DriveReport | None:\n    \"\"\"The report for an invocation that began and wrote no record, or None\n    when every invocation has its record. One that needs recovery reads\n    before one still running: it is the one the next move is about.\"\"\"\n    pending = invocations_without_record(records_dir)\n    if not pending:\n        return None\n    bound = stall_bound_s(m)\n    if bound is None:\n        r[\"state\"], r[\"kind\"] = \"refused\", \"yours\"\n        r[\"says\"] = (\"An invocation wrote no record, and the manifest sets no stall bound, so a \"\n                     \"running one cannot be told from a hung one\")\n        return r\n    readings = [(read_invocation(root, bound, marker, info), info) for marker, info in pending]\n    reading, info = next(((rd, i) for rd, i in readings if rd.cls != \"running\"), readings[0])\n    if reading.stage not in _WORD:\n        r[\"state\"], r[\"kind\"] = \"refused\", \"yours\"\n        r[\"says\"] = f\"Found an invocation marker for an unknown stage, {reading.stage}\"\n        return r\n    if reading.cls != \"running\" and next_attempt_number(records_dir, reading.stage) != reading.nn:\n        r[\"state\"], r[\"kind\"], r[\"stage\"], r[\"attempt\"] = \"refused\", \"yours\", reading.stage, reading.nn\n        r[\"says\"] = (f\"{_WORD[reading.stage].capitalize()} attempt {reading.nn:02d} wrote no record, but a \"\n                     f\"later one exists; read the records before recovering\")\n        return r\n    return _invocation(r, reading, info, bound)\n\n\ndef _checks(r: DriveReport, forge_checks: dict[str, Any], ok: bool, ready: bool) -> DriveReport:\n    \"\"\"Read the forge's answer on the head as a level: green, still\n    running, or done and not green.\"\"\"\n    conclusions: list[dict[str, str]] = forge_checks[\"conclusions\"]\n    r[\"checks\"] = [{\"name\": c[\"name\"], \"conclusion\": c[\"conclusion\"]} for c in conclusions]\n    head7 = (r[\"head\"] or \"\")[:7]\n    if ok:\n        if ready:\n            r[\"state\"], r[\"kind\"], r[\"says\"] = \"ready-to-merge\", \"yours\", \"Ready to merge\"\n        else:\n            r[\"state\"], r[\"kind\"], r[\"stage\"] = \"next-review\", \"acts\", \"verify\"\n            r[\"says\"] = f\"Review is next; the checks are green on {head7}\"\n        return r\n    unconcluded = [c for c in conclusions if c[\"conclusion\"] in FORGE_UNCONCLUDED_STATUSES]\n    if unconcluded or not conclusions:\n        named = \", \".join(f\"{c['name']} {c['conclusion']}\" for c in unconcluded) or \"no checks reported\"\n        r[\"state\"], r[\"kind\"], r[\"stage\"] = \"waiting-on-checks\", \"waits\", None if ready else \"verify\"\n        r[\"says\"] = f\"Waiting on the checks: {named} on {head7}\"\n        return r\n    named = (\", \".join(f\"{c['name']} {c['conclusion']}\" for c in conclusions\n                       if c[\"conclusion\"] not in FORGE_OK_CONCLUSIONS)\n             or \"the checks command did not succeed\")\n    r[\"state\"], r[\"kind\"], r[\"stage\"] = \"blocked-on-checks\", \"waits\", None if ready else \"verify\"\n    after = \"the item is ready to merge\" if ready else \"review starts\"\n    r[\"says\"] = f\"Blocked: {named} on {head7}; {after} once the checks are green\"\n    return r\n\n\ndef drive_report(root: Path, m: dict[str, Any], item_id: str) -> DriveReport:\n    \"\"\"The item's level, from the same reads `attavo drive` decides on --\n    drive_state over its records, the markers recovery reads, one read of\n    the forge -- and never an act: no record written, nothing started, no\n    poll. A state for every item the records directory carries.\"\"\"\n    records_dir = root / m[\"paths\"][\"records\"] / item_id\n    r: DriveReport = {\"item\": item_id, \"state\": \"refused\", \"kind\": \"yours\", \"says\": \"\", \"stage\": None,\n                      \"attempt\": None, \"record\": None, \"stop_class\": None, \"counsel\": None,\n                      \"filed\": None, \"head\": _head(root), \"checks\": None, \"since\": None,\n                      \"last_event_age_s\": None}\n\n    merge, _ = merge_introducing_records(root, m[\"paths\"][\"records\"], item_id, STAGES)\n    if merge:\n        r[\"state\"], r[\"kind\"], r[\"says\"] = \"merged\", \"done\", f\"Merged in {merge[:7]}\"\n        return r\n\n    try:\n        step, why, _ = drive_state(root, m, item_id)\n    except ShallowCheckoutError as exc:\n        r[\"says\"] = f\"Cannot read this item: {exc}\"\n        return r\n    if step == \"no-approval\":\n        r[\"state\"], r[\"kind\"] = \"waiting-on-approval\", \"yours\"\n        r[\"says\"] = (\"Waiting on you: approve the spec\" if why == \"absent\" else\n                     \"Waiting on you: the approval expired because the spec changed after it; \"\n                     \"approve the spec again\")\n        return r\n\n    pending = _pending(root, m, records_dir, r)\n    if pending:\n        return pending\n\n    build = _latest(records_dir, \"build\")\n    if step == \"build\":\n        approval = _latest(records_dir, \"approval\")\n        if (build and build[1].get(\"status\") != \"pass\"\n                and build[1].get(\"approval_sha\") == (approval[1].get(\"sha\") if approval else None)):\n            return _stopped(r, records_dir, \"build\", build[0], build[1])\n        r[\"state\"], r[\"kind\"], r[\"stage\"] = \"next-build\", \"acts\", \"build\"\n        r[\"says\"] = \"Build is next\"\n        return r\n\n    review = _latest(records_dir, \"verify\")\n    if (step == \"verify\" and review and review[1].get(\"status\") != \"pass\"\n            and build and review[1].get(\"build_sha\") == build[1].get(\"sha\")):\n        return _stopped(r, records_dir, \"verify\", review[0], review[1])\n\n    checks_command = (m.get(\"forge\") or {}).get(\"checks_command\")\n    if not checks_command:\n        r[\"says\"] = \"No checks command is set in the manifest, so nothing can say whether the checks are green\"\n        return r\n    forge_checks, ok = read_forge_checks(root, checks_command, r[\"head\"] or \"\")\n    return _checks(r, forge_checks, ok, ready=step == \"ready\")\n\"\"\"`attavo drive N --report`: what one item is waiting on and for whom, as a\npure function of its records, its markers, and one read of the forge. It\nwrites nothing, starts nothing, and never waits (#171: a refusal nobody\ncould read, twice on #194).\n\nRun: python3 -m pytest tests -q\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport os\nimport socket\nimport time\nfrom datetime import datetime, timedelta, timezone\nfrom pathlib import Path\nfrom typing import Any\n\nfrom helpers import commit_all, git, make_tenant\nfrom test_attest_time import INVOCATIONS, make_item\nfrom test_drive import (\n    GREEN_FORGE,\n    RED_FORGE,\n    UNCONCLUDED_FORGE,\n    add_bare_remote,\n    add_drive_stall_bound,\n    add_forge,\n    approve_item,\n    head_of,\n    record_files,\n    records_dir,\n    run_attavo,\n    write_dead_marker,\n)\n\nROOT = Path(__file__).resolve().parent.parent\nSCHEMA = json.loads((ROOT / \"schema\" / \"drive-report.schema.json\").read_text())\n\n\ndef report(root: Path, item: str = \"1\", env: dict[str, Any] | None = None) -> dict[str, Any]:\n    before = (head_of(root), git(root, \"status\", \"--porcelain\"),\n              sorted(p.name for p in records_dir(root, item).glob(\"*\")))\n    run = run_attavo(root, \"drive\", item, \"--report\", env=env)\n    assert run.returncode == 0, run.stdout + run.stderr\n    after = (head_of(root), git(root, \"status\", \"--porcelain\"),\n             sorted(p.name for p in records_dir(root, item).glob(\"*\")))\n    assert before == after, \"the report wrote something\"\n    out: dict[str, Any] = json.loads(run.stdout)\n    assert set(out) == set(SCHEMA[\"required\"]) == set(SCHEMA[\"properties\"]), out\n    assert out[\"state\"] in SCHEMA[\"properties\"][\"state\"][\"enum\"], out\n    assert out[\"kind\"] in SCHEMA[\"properties\"][\"kind\"][\"enum\"], out\n    assert \"drive\" not in out[\"says\"].lower() and \"verify\" not in out[\"says\"].lower(), out\n    return out\n\n\ndef test_report_names_a_red_check_and_the_head_and_writes_nothing(tmp_path: Path) -> None:\n    \"\"\"#171: on a concluded red check the product printed one line into a\n    log nobody read, exited 1, and wrote nothing. The report says it for as\n    long as it is true.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, RED_FORGE)\n    add_bare_remote(root, tmp_path)\n    approve_item(root)\n    assert run_attavo(root, \"drive\", \"1\").returncode == 0\n    out = report(root)\n    assert (out[\"state\"], out[\"kind\"], out[\"stage\"]) == (\"blocked-on-checks\", \"waits\", \"verify\"), out\n    assert out[\"checks\"] == [{\"name\": \"ci\", \"conclusion\": \"failure\"}], out\n    assert \"ci failure\" in out[\"says\"] and head_of(root)[:7] in out[\"says\"], out\n    assert record_files(root, \"verify\") == []\n    assert report(root) == out, \"two reads of one level differ\"\n\n\ndef test_report_never_waits_on_a_check_that_is_still_running(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, UNCONCLUDED_FORGE)\n    add_bare_remote(root, tmp_path)\n    approve_item(root)\n    assert run_attavo(root, \"drive\", \"1\").returncode == 0\n    started = time.monotonic()\n    out = report(root, env={\"ATTAVO_DRIVE_POLL_BOUND_S\": \"30\", \"ATTAVO_DRIVE_POLL_INTERVAL_S\": \"5\"})\n    assert time.monotonic() - started < 4, \"the report polled\"\n    assert (out[\"state\"], out[\"kind\"]) == (\"waiting-on-checks\", \"waits\"), out\n    assert \"ci in_progress\" in out[\"says\"], out\n\n\ndef test_report_walks_an_item_from_approval_to_ready(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    add_bare_remote(root, tmp_path)\n    assert run_attavo(root, \"spec-gate\", \"1\").returncode == 0\n    out = report(root)\n    assert (out[\"state\"], out[\"kind\"]) == (\"waiting-on-approval\", \"yours\"), out\n    approve_item(root)\n    assert (report(root)[\"state\"], report(root)[\"kind\"]) == (\"next-build\", \"acts\")\n    assert run_attavo(root, \"drive\", \"1\").returncode == 0\n    assert (report(root)[\"state\"], report(root)[\"stage\"]) == (\"next-review\", \"verify\")\n    assert run_attavo(root, \"drive\", \"1\").returncode == 0\n    out = report(root)\n    assert (out[\"state\"], out[\"kind\"], out[\"says\"]) == (\"ready-to-merge\", \"yours\", \"Ready to merge\"), out\n\n\ndef test_report_says_what_recovery_would_record_for_a_dead_invocation(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    add_drive_stall_bound(root)\n    approve_item(root)\n    write_dead_marker(root, \"build\", 1)\n    out = report(root)\n    assert (out[\"state\"], out[\"kind\"], out[\"stage\"], out[\"attempt\"], out[\"stop_class\"]) == (\n        \"owes-recovery\", \"acts\", \"build\", 1, \"died\"), out\n    assert not (records_dir(root) / \"build-01.json\").exists()\n\n\ndef test_report_names_the_stopped_record_its_class_its_counsel_and_its_issue(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    add_drive_stall_bound(root)\n    approve_item(root)\n    write_dead_marker(root, \"build\", 1)\n    assert run_attavo(root, \"drive\", \"--recover\", \"1\").returncode == 0\n    d = records_dir(root)\n    (d / \"build-01.filed\").write_text(\"https://example.invalid/issues/9\\n\")\n    commit_all(root, \"the stop is filed\")\n    out = report(root)\n    assert (out[\"state\"], out[\"kind\"], out[\"record\"], out[\"stop_class\"], out[\"filed\"]) == (\n        \"stopped\", \"yours\", \"build-01\", \"died\", \"https://example.invalid/issues/9\"), out\n    assert out[\"says\"].startswith(\"Needs you: build attempt 01 stopped as died\"), out\n\n\ndef write_live_marker(root: Path, stage: str, nn: int, age_s: int) -> None:\n    \"\"\"A marker whose pid is this test's own process: alive, on this host,\n    begun age_s seconds ago, with no events file.\"\"\"\n    at = (datetime.now(timezone.utc) - timedelta(seconds=age_s)).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\n    marker = records_dir(root) / f\"{stage}-{nn:02d}.started\"\n    marker.parent.mkdir(parents=True, exist_ok=True)\n    marker.write_text(json.dumps({\"at\": at, \"host\": socket.gethostname(), \"pid\": os.getpid(),\n                                  \"sha\": head_of(root), \"product_version\": \"fixture\"}))\n    commit_all(root, \"invocation marker for item 1\")\n\n\ndef test_report_reads_an_expired_approval_as_yours_and_says_why(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    approve_item(root)\n    spec = root / \"specs\" / \"1\" / \"spec.md\"\n    spec.write_text(spec.read_text() + \"\\n\")\n    commit_all(root, \"touch the spec after approval\")\n    out = report(root)\n    assert (out[\"state\"], out[\"kind\"]) == (\"waiting-on-approval\", \"yours\"), out\n    assert \"expired\" in out[\"says\"], out\n\n\ndef test_report_reads_a_live_invocation_inside_the_bound_as_running(tmp_path: Path) -> None:\n    \"\"\"Launch stayed on the screen while #194's build ran: a view guessed\n    whose move it was.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    add_drive_stall_bound(root, 60)\n    approve_item(root)\n    write_live_marker(root, \"build\", 1, age_s=5)\n    out = report(root)\n    assert (out[\"state\"], out[\"kind\"], out[\"stage\"], out[\"attempt\"]) == (\"running\", \"waits\", \"build\", 1), out\n    assert out[\"since\"] and isinstance(out[\"last_event_age_s\"], int), out\n    assert out[\"says\"].startswith(\"Build running since \"), out\n\n\ndef test_report_reads_a_live_invocation_past_the_bound_as_hung_and_ends_nothing(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    add_drive_stall_bound(root, 60)\n    approve_item(root)\n    write_live_marker(root, \"build\", 1, age_s=600)\n    out = report(root)\n    assert (out[\"state\"], out[\"kind\"], out[\"stop_class\"]) == (\"owes-recovery\", \"acts\", \"hung\"), out\n    os.kill(os.getpid(), 0)  # the report terminated nothing: this process is its \"hung\" pid\n\n\ndef test_report_reads_a_review_of_an_earlier_build_as_review_next(tmp_path: Path) -> None:\n    \"\"\"#109: a later build supersedes the latest review; the item is not\n    ready and is not stopped.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    add_bare_remote(root, tmp_path)\n    approve_item(root)\n    assert run_attavo(root, \"drive\", \"1\").returncode == 0\n    assert run_attavo(root, \"drive\", \"1\").returncode == 0\n    assert report(root)[\"state\"] == \"ready-to-merge\"\n    build = json.loads(record_files(root, \"build\")[-1].read_text())\n    build[\"sha\"] = \"f\" * 40\n    (records_dir(root) / \"build-02.json\").write_text(json.dumps(build))\n    commit_all(root, \"a second build record, minted by hand\")\n    out = report(root)\n    assert (out[\"state\"], out[\"kind\"], out[\"stage\"]) == (\"next-review\", \"acts\", \"verify\"), out\n\n\ndef test_report_does_not_read_a_failed_build_of_an_earlier_approval_as_stopped(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    approve_item(root)\n    (records_dir(root) / \"build-01.json\").write_text(json.dumps(\n        {\"status\": \"failed\", \"sha\": \"b\" * 40, \"approval_sha\": \"0\" * 40,\n         \"stop\": {\"class\": \"gate\", \"provenance\": \"tenant\", \"detail\": None}}))\n    commit_all(root, \"a failed build bound to an approval that is not the current one\")\n    out = report(root)\n    assert (out[\"state\"], out[\"kind\"]) == (\"next-build\", \"acts\"), out\n\n\ndef test_report_names_the_counsel_record_that_read_the_stop(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"build_valid\")\n    add_forge(root, GREEN_FORGE)\n    add_drive_stall_bound(root)\n    approve_item(root)\n    write_dead_marker(root, \"build\", 1)\n    assert run_attavo(root, \"drive\", \"--recover\", \"1\").returncode == 0\n    (records_dir(root) / \"counsel-01.json\").write_text(json.dumps(\n        {\"record\": \"build-01\", \"record_stage\": \"build\", \"verdict\": \"person\", \"status\": \"done\"}))\n    commit_all(root, \"counsel read the stop\")\n    out = report(root)\n    assert (out[\"state\"], out[\"counsel\"]) == (\"stopped\", \"counsel-01\"), out\n    assert \"counsel-01\" in out[\"says\"] and \"person\" in out[\"says\"], out\n\n\ndef test_report_reads_a_merged_item_as_merged(tmp_path: Path) -> None:\n    \"\"\"The screen showed #204 as waiting, its pull request \"not read\", after\n    it had merged: the branch survived and no view read the history.\"\"\"\n    root, merge = make_item(tmp_path, INVOCATIONS)\n    run = run_attavo(root, \"drive\", \"1\", \"--report\")\n    assert run.returncode == 0, run.stdout + run.stderr\n    out = json.loads(run.stdout)\n    assert (out[\"state\"], out[\"kind\"]) == (\"merged\", \"done\"), out\n    assert merge[:7] in out[\"says\"], out\n\n\ndef test_report_reads_every_item_this_repository_carries(tmp_path: Path) -> None:\n    \"\"\"A new reader must not wedge on a record that already exists (#194's\n    verify-01). Every item under this repository's own records directory\n    yields a report, in-process, with no forge read of its own.\"\"\"\n    from attavo.common import read_manifest\n    from attavo.report import drive_report\n    m = read_manifest(ROOT)\n    assert m is not None\n{\n  \"$schema\": \"https://json-schema.org/draft/2020-12/schema\",\n  \"$id\": \"https://attavo.dev/drive-report/v1\",\n  \"title\": \"attavo drive --report\",\n  \"description\": \"What one item is waiting on and for whom: a pure function of its records, its markers, and one read of the forge. Printing it changes nothing.\",\n  \"type\": \"object\",\n  \"additionalProperties\": false,\n  \"required\": [\n    \"item\",\n    \"state\",\n    \"kind\",\n    \"says\",\n    \"stage\",\n    \"attempt\",\n    \"record\",\n    \"stop_class\",\n    \"counsel\",\n    \"filed\",\n    \"head\",\n    \"checks\",\n    \"since\",\n    \"last_event_age_s\"\n  ],\n  \"properties\": {\n    \"item\": {\n      \"type\": \"string\"\n    },\n    \"state\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"waiting-on-approval\",\n        \"running\",\n        \"owes-recovery\",\n        \"stopped\",\n        \"next-build\",\n        \"waiting-on-checks\",\n        \"blocked-on-checks\",\n        \"next-review\",\n        \"ready-to-merge\",\n        \"merged\",\n        \"refused\"\n      ]\n    },\n    \"kind\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"yours\",\n        \"waits\",\n        \"acts\",\n        \"done\"\n      ],\n      \"description\": \"yours: a person's act is next. waits: nothing to do but wait. acts: the next drive would act. done: nothing further from here.\"\n    },\n    \"says\": {\n      \"type\": \"string\",\n      \"description\": \"One sentence in the operator's words.\"\n    },\n    \"stage\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ],\n      \"enum\": [\n        \"build\",\n        \"verify\",\n        null\n      ]\n    },\n    \"attempt\": {\n      \"type\": [\n        \"integer\",\n        \"null\"\n      ]\n    },\n    \"record\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"stop_class\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"counsel\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"filed\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"head\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"checks\": {\n      \"type\": [\n        \"array\",\n        \"null\"\n      ],\n      \"items\": {\n        \"type\": \"object\",\n        \"required\": [\n          \"name\",\n          \"conclusion\"\n        ],\n        \"properties\": {\n          \"name\": {\n            \"type\": \"string\"\n          },\n          \"conclusion\": {\n            \"type\": \"string\"\n          }\n        }\n      }\n    },\n    \"since\": {\n      \"type\": [\n        \"string\",\n        \"null\"\n      ]\n    },\n    \"last_event_age_s\": {\n      \"type\": [\n        \"integer\",\n        \"null\"\n      ]\n    }\n  }\n}\n","exit_code":0,"status":"completed"}}

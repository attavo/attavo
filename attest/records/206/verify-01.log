\\"next-build\\\\\\\", \\\\\\\"waiting-on-checks\\\\\\\",\\\\n              \\\\\\\"blocked-on-checks\\\\\\\", \\\\\\\"next-review\\\\\\\", \\\\\\\"ready-to-merge\\\\\\\", \\\\\\\"merged\\\\\\\", \\\\\\\"refused\\\\\\\"):\\\\n    assert state in s[\\\\\\\"properties\\\\\\\"][\\\\\\\"state\\\\\\\"][\\\\\\\"enum\\\\\\\"], state\\\\nassert s[\\\\\\\"properties\\\\\\\"][\\\\\\\"kind\\\\\\\"][\\\\\\\"enum\\\\\\\"] == [\\\\\\\"yours\\\\\\\", \\\\\\\"waits\\\\\\\", \\\\\\\"acts\\\\\\\", \\\\\\\"done\\\\\\\"]\\\\nPY\\\\ngrep -q '\\\\\\\"DriveReport\\\\\\\": \\\\\\\"drive-report.schema.json\\\\\\\"' tests/test_types_mirror_schemas.py\\\\nfor t in test_report_names_a_red_check_and_the_head_and_writes_nothing test_report_never_waits_on_a_check_that_is_still_running test_report_walks_an_item_from_approval_to_ready test_report_says_what_recovery_would_record_for_a_dead_invocation test_report_names_the_stopped_record_its_class_its_counsel_and_its_issue test_report_reads_an_expired_approval_as_yours_and_says_why test_report_reads_a_live_invocation_inside_the_bound_as_running test_report_reads_a_live_invocation_past_the_bound_as_hung_and_ends_nothing test_report_reads_a_review_of_an_earlier_build_as_review_next test_report_does_not_read_a_failed_build_of_an_earlier_approval_as_stopped test_report_names_the_counsel_record_that_read_the_stop test_report_reads_a_merged_item_as_merged test_report_reads_every_item_this_repository_carries\\\\ndo\\\\n  grep -q \\\\\\\"^def $t(\\\\\\\" tests/test_report.py\\\\ndone\\\\nattavo\\\\nschema\\\\ntests\\\\n\\\\nstub/attavo:\\\\ndrive.py\\\\nreport.py\\\\ntypes.py\\\\n\\\\nstub/schema:\\\\ndrive-report.schema.json\\\\n\\\\nstub/tests:\\\\ntest_report.py\\\\ntest_types_mirror_schemas.py\\\\n{\\\\n  \\\\\\\"at\\\\\\\": \\\\\\\"2026-09-20T17:28:48Z\\\\\\\",\\\\n  \\\\\\\"host\\\\\\\": \\\\\\\"Davids-MacBook-Pro.local\\\\\\\",\\\\n  \\\\\\\"pid\\\\\\\": 20757,\\\\n  \\\\\\\"sha\\\\\\\": \\\\\\\"d1fd30c7121d2f4d21037851d53efb5e3c2bf174\\\\\\\",\\\\n  \\\\\\\"product_version\\\\\\\": \\\\\\\"v0.26.0-43-g1cb8af3\\\\\\\"\\\\n}\\\",\\\"is_error\\\":false}]},\\\"parent_tool_use_id\\\":null,\\\"session_id\\\":\\\"8de61c42-af71-4210-8ec4-d6e4cd3c023f\\\",\\\"uuid\\\":\\\"4634df54-ecee-4d70-973b-b8daa893dfd8\\\",\\\"timestamp\\\":\\\"2026-09-20T17:32:53.540Z\\\",\\\"tool_use_result\\\":{\\\"stdout\\\":\\\"## Problem\\\\n\\\\nThe product cannot say what an item is waiting on. `attavo drive N` decides from the item's records and one read of the forge, and then either acts or prints one line into a log and exits: on #194 a concluded red check made it print \\\\\\\"stopped: forge checks not green\\\\\\\", exit 1, and write nothing, twice, while the operator screen showed a Launch button (#171). The decision is already a pure function (`drive_state` plus `read_forge_checks`); nothing exposes it without also acting on it, so every view derives its own answer and a refusal is an event nobody recorded instead of a level anybody can read.\\\\n\\\\nThis is R1 of the reconciler (`claude/reconciler-brief-2026-09-20.md`, rulings A and G, 2026-09-20): `attavo drive N --report` prints, as JSON against `schema/drive-report.schema.json`, the item's state, whose move it is (`yours`, `waits`, `acts`, `done`), and one sentence in the operator's words. It writes nothing, starts nothing, and never waits: it reads the forge once and does not call `poll_forge_checks`. No behaviour of `attavo drive N` without the flag changes. The states are the ones today's product can be in; attempt budgets, the breaker, and rulings arrive with R3 and R4 and add states then.\\\\n\\\\nThe stub under `stub/` is thin on purpose (the operator's ruling, 2026-09-20): it guesses the state from which files exist, satisfies the criteria, and fails eight of the thirteen tests in `tests/test_report.py`, which cover what it ignores (an expired approval, a record bound to an earlier approval or build, a live invocation inside and past the bound, counsel, a merged item). The build writes the report from the product's own functions; shipping the stub's `report.py` is not a build.\\\\n\\\\nA new reader must not wedge on a record that already exists (#194's `verify-01`): the report returns a state for every item this repository's records directory carries.\\\\n\\\\nRetires: #171 (a refusal is the report's current level, recomputed on every read, so there is nothing to record); any view's own derivation of what an item is waiting on (deleted by a screen item filed against this one once a release carries it).\\\\n\\\\n## Claims\\\\n\\\\n- attavo/report.py\\\\n- attavo/drive.py\\\\n- attavo/types.py\\\\n- attavo/cli.py\\\\n- schema/drive-report.schema.json\\\\n- tests/test_report.py\\\\n- tests/test_types_mirror_schemas.py\\\\n- tests/test_cli_help.py\\\\n\\\\n## Criteria\\\\n\\\\n- report-names-a-red-check-and-writes-nothing.sh: with a built item whose head carries a concluded red check, drive 1 --report exits 0, prints state blocked-on-checks, kind waits, stage verify, the check by name and conclusion, and a sentence naming the check and the head that says neither \\\\\\\"drive\\\\\\\" nor \\\\\\\"verify\\\\\\\"; HEAD, the working tree, and the item's records directory are the same before and after\\\\n- report-never-waits.sh: with a check still in_progress and the drive's poll bound set to 30 s, the report returns in under 10 s with state waiting-on-checks and the check named\\\\n- report-walks-an-item-and-names-whose-move-it-is.sh: across one item's life the report reads waiting-on-approval yours, next-build acts, owes-recovery acts naming build attempt 1 as died (and writes no record), stopped yours naming build-01, its class, and its filed issue, next-review acts, and ready-to-merge yours\\\\n- the-report-has-its-contract-and-its-tests.sh: schema/drive-report.schema.json closes its properties, requires every one, and enumerates the eleven states and four kinds; DriveReport mirrors it in tests/test_types_mirror_schemas.py; tests/test_report.py carries its thirteen tests by name\\\\n=== criteria/report-names-a-red-check-and-writes-nothing.sh\\\\n#!/bin/sh\\\\nCONCLUSION=failure\\\\nset -e\\\\nhere=$(pwd)\\\\ntmp=$(mktemp -d)\\\\ncp -R \\\\\\\"$here/tests/fixtures/build_valid/.\\\\\\\" \\\\\\\"$tmp/tenant\\\\\\\"\\\\ncd \\\\\\\"$tmp/tenant\\\\\\\"\\\\ngit init -q -b main .\\\\ngit config user.email fixture@attavo.invalid\\\\ngit config user.name \\\\\\\"fixture\\\\\\\"\\\\nprintf '\\\\\\\\n[forge]\\\\\\\\nchecks_command = \\\\\\\"printf '\\\\\\\"'\\\\\\\"'ci %s\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\\n'\\\\\\\"'\\\\\\\"'\\\\\\\"\\\\\\\\n\\\\\\\\n[drive]\\\\\\\\nstall_after_s = 60\\\\\\\\n' \\\\\\\"$CONCLUSION\\\\\\\" >> attavo.toml\\\\ngit add -A\\\\ngit commit -q -m install\\\\ngit init -q --bare -b main \\\\\\\"$tmp/origin.git\\\\\\\"\\\\ngit remote add origin \\\\\\\"$tmp/origin.git\\\\\\\"\\\\ngit push -q origin HEAD:main\\\\ngit update-ref refs/remotes/origin/main \\\\\\\"$(git rev-parse HEAD)\\\\\\\"\\\\ngit symbolic-ref refs/remotes/origin/HEAD refs/remotes/origin/main\\\\nexport ATTAVO_DRIVE_POLL_BOUND_S=30 ATTAVO_DRIVE_POLL_INTERVAL_S=5\\\\nA=\\\\\\\"python3 $here/bin/attavo\\\\\\\"\\\\nsnapshot() { printf '%s\\\\\\\\n%s\\\\\\\\n%s\\\\\\\\n' \\\\\\\"$(git rev-parse HEAD)\\\\\\\" \\\\\\\"$(git status --porcelain)\\\\\\\" \\\\\\\"$(ls records/1 2>/dev/null)\\\\\\\"; }\\\\n$A spec-gate 1 >/dev/null\\\\n$A approve 1 --by alice >/dev/null\\\\n$A drive 1 >/dev/null\\\\nbefore=$(snapshot)\\\\n$A drive 1 --report > \\\\\\\"$tmp/report.json\\\\\\\"\\\\ntest \\\\\\\"$(snapshot)\\\\\\\" = \\\\\\\"$before\\\\\\\"\\\\npython3 - \\\\\\\"$(git rev-parse --short=7 HEAD)\\\\\\\" \\\\\\\"$tmp/report.json\\\\\\\" <<'PY'\\\\nimport json, sys\\\\nr = json.load(open(sys.argv[2]))\\\\nassert (r[\\\\\\\"state\\\\\\\"], r[\\\\\\\"kind\\\\\\\"], r[\\\\\\\"stage\\\\\\\"]) == (\\\\\\\"blocked-on-checks\\\\\\\", \\\\\\\"waits\\\\\\\", \\\\\\\"verify\\\\\\\"), r\\\\nassert r[\\\\\\\"checks\\\\\\\"] == [{\\\\\\\"name\\\\\\\": \
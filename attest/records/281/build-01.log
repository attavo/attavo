{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_013mmtXJFaNPgXhtEoKWETdP","type":"tool_result","content":"1\t\"\"\"attavo frontier: the waves, built by the product (attavo/frontier.py).\n2\tWritten red first: on 7a5cbfb there is no frontier subcommand and no\n3\tattavo.frontier module.\n4\t\n5\tRun: python3 -m pytest tests/test_frontier.py -q\n6\t\"\"\"\n7\tfrom __future__ import annotations\n8\t\n9\timport json\n10\timport re\n11\timport subprocess\n12\timport sys\n13\tfrom pathlib import Path\n14\tfrom typing import Any\n15\t\n16\timport pytest\n17\t\n18\tfrom attavo import frontier, store\n19\tfrom attavo.issues import Issue\n20\tfrom helpers import commit_all, git, make_tenant\n21\t\n22\tROOT = Path(__file__).resolve().parent.parent\n23\tATTAVO = ROOT / \"bin\" / \"attavo\"\n24\t\n25\t\n26\t@pytest.fixture(autouse=True)\n27\tdef no_store_override(monkeypatch: pytest.MonkeyPatch) -> None:\n28\t    monkeypatch.delenv(\"ATTAVO_STORE\", raising=False)\n29\t\n30\t\n31\tdef issue(n: int, claims: list[str] | None, state: str = \"open\", cls: str | None = \"core\") -> Issue:\n32\t    return {\"number\": n, \"title\": f\"issue {n}\", \"state\": state, \"closed_at\": None, \"labels\": [],\n33\t            \"claims\": claims, \"item_class\": cls}\n34\t\n35\t\n36\tdef plan(epics: list[tuple[str, list[int]]], edges: list[dict[str, Any]] | None = None) -> dict[str, Any]:\n37\t    return {\"schema\": \"plan/1\", \"epics\": [{\"id\": e, \"title\": e.title(), \"issues\": ns} for e, ns in epics],\n38\t            \"edges\": edges or [], \"policy\": {}}\n39\t\n40\t\n41\tdef wave_of(out: dict[str, Any], n: int) -> int | None:\n42\t    return next((k for k, w in enumerate(out[\"waves\"]) for x in w if x[\"issue\"] == n), None)\n43\t\n44\t\n45\tdef why_of(out: dict[str, Any], n: int) -> list[str]:\n46\t    return next(x[\"why\"] for w in out[\"waves\"] for x in w if x[\"issue\"] == n)\n47\t\n48\t\n49\tdef test_order_is_epic_rank_then_issue_rank_and_an_unplaced_open_issue_is_backlog_last() -> None:\n50\t    body = plan([(\"e1\", [3, 1]), (\"backlog\", [2])])\n51\t    issues = [issue(1, [\"a/x.py\"]), issue(2, [\"b/x.py\"]), issue(3, [\"c/x.py\"]), issue(9, [\"d/x.py\"])]\n52\t    out = frontier.compute(body, issues, [])\n53\t    assert [x[\"issue\"] for x in out[\"waves\"][1]] == [3, 1, 2, 9]\n54\t    assert out[\"order\"] == frontier.ORDER and \"Backlog, last, by number\" in out[\"order\"]\n55\t    assert next(x[\"epic\"] for x in out[\"waves\"][1] if x[\"issue\"] == 9) == \"backlog\"\n56\t\n57\t\n58\tdef test_an_issue_with_an_open_predecessor_waits_and_a_closed_one_does_not() -> None:\n59\t    body = plan([(\"e1\", [1, 2, 3]), (\"backlog\", [])],\n60\t                [{\"type\": \"depends\", \"from\": 1, \"to\": 2}, {\"type\": \"ruled\", \"from\": 4, \"to\": 3,\n61\t                                                           \"by\": \"op\", \"at\": \"2026-09-29\"}])\n62\t    issues = [issue(1, [\"a.py\"]), issue(2, [\"b.py\"]), issue(3, [\"c.py\"]), issue(4, [\"d.py\"], state=\"closed\")]\n63\t    out = frontier.compute(body, issues, [])\n64\t    assert (wave_of(out, 1), wave_of(out, 2), wave_of(out, 3)) == (1, 2, 1)\n65\t    assert why_of(out, 2) == [\"waits on #1 (depends)\"]\n66\t    assert why_of(out, 3) == []\n67\t\n68\t\n69\tdef test_two_issues_whose_claims_overlap_never_share_a_wave_and_the_lower_ranked_one_waits() -> None:\n70\t    body = plan([(\"e1\", [1, 2]), (\"backlog\", [])])\n71\t    out = frontier.compute(body, [issue(1, [\"attavo/cli.py\"]), issue(2, [\"attavo/*.py\"])], [])\n72\t    assert (wave_of(out, 1), wave_of(out, 2)) == (1, 2)\n73\t    assert why_of(out, 2) == [\"shares attavo/*.py, attavo/cli.py with #1 in wave 1\"]\n74\t\n75\t\n76\tdef test_strict_opportunism_a_lower_ranked_issue_never_takes_a_path_a_higher_ranked_one_wants() -> None:\n77\t    body = plan([(\"e1\", [1, 2]), (\"backlog\", [3, 4])], [{\"type\": \"depends\", \"from\": 1, \"to\": 2}])\n78\t    issues = [issue(1, [\"x/one.py\"]), issue(2, [\"shared.py\"]), issue(3, [\"shared.py\"]), issue(4, [\"y/four.py\"])]\n79\t    out = frontier.compute(body, issues, [])\n80\t    assert wave_of(out, 4) == 1, \"a disjoint lower-ranked issue is placed ahead of a blocked higher one\"\n81\t    assert wave_of(out, 2) == 2\n82\t    assert wave_of(out, 3) == 3\n83\t    assert \"yields shared.py to #2, ranked above\" in why_of(out, 3)\n84\t\n85\t\n86\tdef test_an_issue_overlapping_a_branch_in_flight_is_not_in_wave_one_and_says_which_branch() -> None:\n87\t    body = plan([(\"e1\", [1, 5]), (\"backlog\", [])])\n88\t    flights: list[dict[str, Any]] = [{\"branch\": \"lane/9-other\", \"item\": None, \"declared\": [], \"changed\": [\"src/marker.txt\"]},\n89\t               {\"branch\": \"attavo/5-x\", \"item\": \"5\", \"declared\": [\"lib/**\"], \"changed\": [\"lib/a.py\"]}]\n90\t    out = frontier.compute(body, [issue(1, [\"src/**\"]), issue(5, [\"lib/**\"])], flights,\n91\t                           {\"attavo/5-x\": \"awaiting approval\"})\n92\t    zero = {x[\"branch\"]: x for x in out[\"waves\"][0]}\n93\t    assert zero[\"attavo/5-x\"][\"issue\"] == 5 and zero[\"attavo/5-x\"][\"spec_state\"] == \"awaiting approval\"\n94\t    assert zero[\"lane/9-other\"][\"issue\"] is None and zero[\"lane/9-other\"][\"spec_state\"] == \"lane\"\n95\t    assert wave_of(out, 1) == 2\n96\t    assert why_of(out, 1) == [\"waits on branch lane/9-other: src/**, src/marker.txt\"]\n97\t\n98\t\n99\tdef test_an_issue_with_no_claims_is_not_placed_and_its_dependents_say_why() -> None:\n100\t    body = plan([(\"e1\", [1, 2]), (\"backlog\", [])], [{\"type\": \"depends\", \"from\": 1, \"to\": 2}])\n101\t    out = frontier.compute(body, [issue(1, None), issue(2, [\"b.py\"])], [])\n102\t    by = {x[\"issue\"]: x[\"why\"] for x in out[\"not_placed\"]}\n103\t    assert by[1] == [\"no claims: the issue has no Claims section and no spec\"]\n104\t    assert by[2] == [\"waits on #1 (depends)\"]\n105\t    assert len(out[\"waves\"]) == 1\n106\t\n107\t\n108\tdef test_epic_progress_is_closed_over_total_from_the_forge() -> None:\n109\t    body = plan([(\"e1\", [1, 2, 3]), (\"backlog\", [4])])\n110\t    issues = [issue(1, [\"a\"], \"closed\"), issue(2, [\"b\"], \"closed\"), issue(3, [\"c\"]), issue(4, [\"d\"]),\n111\t              issue(8, [\"e\"])]\n112\t    out = frontier.compute(body, issues, [])\n113\t    assert [(e[\"id\"], e[\"closed\"], e[\"total\"]) for e in out[\"epics\"]] == [(\"e1\", 2, 3), (\"backlog\", 0, 2)]\n114\t    assert not re.search(r\"\\d{4}-\\d{2}-\\d{2}\", json.dumps(out)), \"waves are an order, not a forecast\"\n115\t\n116\t\n117\tdef tenant_with_issues(tmp_path: Path, payload: list[dict[str, Any]]) -> Path:\n118\t    root = make_tenant(tmp_path, \"valid\")\n119\t    cmd = tmp_path / \"issues.py\"\n120\t    cmd.write_text(f\"import sys\\nsys.stdout.write({json.dumps(json.dumps(payload))})\\n\")\n121\t    with (root / \"attavo.toml\").open(\"a\") as f:\n122\t        f.write(f'\\n[forge]\\nissues_command = \"{sys.executable} {cmd}\"\\n')\n123\t    commit_all(root, \"the issues command\")\n124\t    git(root, \"update-ref\", \"refs/remotes/origin/main\", git(root, \"rev-parse\", \"HEAD\").strip())\n125\t    return root\n126\t\n127\t\n128\tdef run_attavo(root: Path, *args: str) -> subprocess.CompletedProcess[str]:\n129\t    return subprocess.run([sys.executable, str(ATTAVO), *args], cwd=str(root),\n130\t                          capture_output=True, text=True, check=False)\n131\t\n132\t\n133\tdef test_the_command_reads_the_store_the_issues_and_git_and_reports_the_waves(tmp_path: Path) -> None:\n134\t    body7 = \"x\\n\\nClass: core\\n\\n## Claims\\n\\n- src/**\\n\"\n135\t    payload = [{\"number\": 7, \"title\": \"seven\", \"state\": \"open\", \"closed_at\": None, \"labels\": [], \"body\": body7},\n136\t               {\"number\": 8, \"title\": \"eight\", \"state\": \"open\", \"closed_at\": None, \"labels\": [],\n137\t                \"body\": \"Class: fix\\n\\n## Claims\\n\\n- src/other.txt\\n\"},\n138\t               {\"number\": 9, \"title\": \"nine\", \"state\": \"open\", \"closed_at\": None, \"labels\": [],\n139\t                \"body\": \"## Claims\\n\\n- docs/x.md\\n\"}]\n140\t    root = tenant_with_issues(tmp_path, payload)\n141\t    store.put(root, \"plan\", plan([(\"e1\", [7, 8]), (\"backlog\", [9])]), 0, \"alice\")\n142\t    git(root, \"checkout\", \"-q\", \"-b\", \"attavo/7-seven\")\n143\t    (root / \"specs\" / \"7\").mkdir(parents=True)\n144\t    (root / \"specs\" / \"7\" / \"spec.md\").write_text(\n145\t        \"## Problem\\n\\nClass: core\\n\\nseven.\\n\\n## Claims\\n\\n- src/**\\n\\n## Criteria\\n\\n- c.sh: exits 0\\n\")\n146\t    (root / \"records\" / \"7\").mkdir(parents=True)\n147\t    (root / \"records\" / \"7\" / \"spec-01.json\").write_text(json.dumps({\"status\": \"pass\", \"item\": \"7\"}))\n148\t    commit_all(root, \"spec for 7\")\n149\t    git(root, \"update-ref\", \"refs/remotes/origin/attavo/7-seven\", git(root, \"rev-parse\", \"HEAD\").strip())\n150\t    git(root, \"checkout\", \"-q\", \"main\")\n151\t\n152\t    run = run_attavo(root, \"frontier\", \"--json\")\n153\t    assert run.returncode == 0, run.stdout + run.stderr\n154\t    out = json.loads(run.stdout)\n155\t    assert out[\"plan_version\"] == 1 and out[\"default\"] == \"refs/remotes/origin/main\"\n156\t    assert [(x[\"issue\"], x[\"spec_state\"]) for x in out[\"waves\"][0]] == [(7, \"awaiting approval\")]\n157\t    assert [x[\"issue\"] for x in out[\"waves\"][1]] == [9]\n158\t    assert [(x[\"issue\"], x[\"class\"]) for x in out[\"waves\"][2]] == [(8, \"fix\")]\n159\t    assert \"yields src/other.txt\" not in \" \".join(out[\"waves\"][2][0][\"why\"])\n160\t    assert any(line.startswith(\"waits on branch attavo/7-seven\") for line in out[\"waves\"][2][0][\"why\"])\n161\t    text = run_attavo(root, \"frontier\")\n162\t    assert text.returncode == 0 and \"wave 0 (in flight): 1\" in text.stdout and \"plan version 1\" in text.stdout\n163\t    assert git(root, \"status\", \"--porcelain\") == \"\"\n164\t\n165\t\n166\tdef test_the_command_is_not_read_without_a_plan_or_an_issues_command_and_refuses_without_origin_head(\n167\t        tmp_path: Path) -> None:\n168\t    root = tenant_with_issues(tmp_path, [])\n169\t    r = run_attavo(root, \"frontier\", \"--json\")\n170\t    assert r.returncode == 2 and \"not read: no plan in the store\" in r.stderr\n171\t    bare = make_tenant(tmp_path, \"valid\", name=\"bare\")\n172\t    store.put(bare, \"plan\", plan([(\"backlog\", [])]), 0, \"alice\")\n173\t    r = run_attavo(bare, \"frontier\")\n174\t    assert r.returncode == 2 and \"not read: no [forge].issues_command\" in r.stderr\n175\t    git(bare, \"symbolic-ref\", \"--delete\", \"refs/remotes/origin/HEAD\")\n176\t    r = run_attavo(bare, \"frontier\")\n177\t    assert r.returncode == 2 and \"refs/remotes/origin/HEAD is not set\" in r.stderr\n178\t"}]},"parent_tool_use_id":null,"session_id":"4588db83-1ef4-4bee-8419-3aef77f32fac","uuid":"a20262a1-ccf2-4a97-bb99-45cd08641c2d","timestamp":"2026-09-30T02:29:45.860Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-281/attest/specs/281/stub/tests/test_frontier.py","content":"\"\"\"attavo frontier: the waves, built by the product (attavo/frontier.py).\nWritten red first: on 7a5cbfb there is no frontier subcommand and no\nattavo.frontier module.\n\nRun: python3 -m pytest tests/test_frontier.py -q\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport re\nimport subprocess\nimport sys\nfrom pathlib import Path\nfrom typing import Any\n\nimport pytest\n\nfrom attavo import frontier, store\nfrom attavo.issues import Issue\nfrom helpers import commit_all, git, make_tenant\n\nROOT = Path(__file__).resolve().parent.parent\nATTAVO = ROOT / \"bin\" / \"attavo\"\n\n\n@pytest.fixture(autouse=True)\ndef no_store_override(monkeypatch: pytest.MonkeyPatch) -> None:\n    monkeypatch.delenv(\"ATTAVO_STORE\", raising=False)\n\n\ndef issue(n: int, claims: list[str] | None, state: str = \"open\", cls: str | None = \"core\") -> Issue:\n    return {\"number\": n, \"title\": f\"issue {n}\", \"state\": state, \"closed_at\": None, \"labels\": [],\n            \"claims\": claims, \"item_class\": cls}\n\n\ndef plan(epics: list[tuple[str, list[int]]], edges: list[dict[str, Any]] | None = None) -> dict[str, Any]:\n    return {\"schema\": \"plan/1\", \"epics\": [{\"id\": e, \"title\": e.title(), \"issues\": ns} for e, ns in epics],\n            \"edges\": edges or [], \"policy\": {}}\n\n\ndef wave_of(out: dict[str, Any], n: int) -> int | None:\n    return next((k for k, w in enumerate(out[\"waves\"]) for x in w if x[\"issue\"] == n), None)\n\n\ndef why_of(out: dict[str, Any], n: int) -> list[str]:\n    return next(x[\"why\"] for w in out[\"waves\"] for x in w if x[\"issue\"] == n)\n\n\ndef test_order_is_epic_rank_then_issue_rank_and_an_unplaced_open_issue_is_backlog_last() -> None:\n    body = plan([(\"e1\", [3, 1]), (\"backlog\", [2])])\n    issues = [issue(1, [\"a/x.py\"]), issue(2, [\"b/x.py\"]), issue(3, [\"c/x.py\"]), issue(9, [\"d/x.py\"])]\n    out = frontier.compute(body, issues, [])\n    assert [x[\"issue\"] for x in out[\"waves\"][1]] == [3, 1, 2, 9]\n    assert out[\"order\"] == frontier.ORDER and \"Backlog, last, by number\" in out[\"order\"]\n    assert next(x[\"epic\"] for x in out[\"waves\"][1] if x[\"issue\"] == 9) == \"backlog\"\n\n\ndef test_an_issue_with_an_open_predecessor_waits_and_a_closed_one_does_not() -> None:\n    body = plan([(\"e1\", [1, 2, 3]), (\"backlog\", [])],\n                [{\"type\": \"depends\", \"from\": 1, \"to\": 2}, {\"type\": \"ruled\", \"from\": 4, \"to\": 3,\n                                                           \"by\": \"op\", \"at\": \"2026-09-29\"}])\n    issues = [issue(1, [\"a.py\"]), issue(2, [\"b.py\"]), issue(3, [\"c.py\"]), issue(4, [\"d.py\"], state=\"closed\")]\n    out = frontier.compute(body, issues, [])\n    assert (wave_of(out, 1), wave_of(out, 2), wave_of(out, 3)) == (1, 2, 1)\n    assert why_of(out, 2) == [\"waits on #1 (depends)\"]\n    assert why_of(out, 3) == []\n\n\ndef test_two_issues_whose_claims_overlap_never_share_a_wave_and_the_lower_ranked_one_waits() -> None:\n    body = plan([(\"e1\", [1, 2]), (\"backlog\", [])])\n    out = frontier.compute(body, [issue(1, [\"attavo/cli.py\"]), issue(2, [\"attavo/*.py\"])], [])\n    assert (wave_of(out, 1), wave_of(out, 2)) == (1, 2)\n    assert why_of(out, 2) == [\"shares attavo/*.py, attavo/cli.py with #1 in wave 1\"]\n\n\ndef test_strict_opportunism_a_lower_ranked_issue_never_takes_a_path_a_higher_ranked_one_wants() -> None:\n    body = plan([(\"e1\", [1, 2]), (\"backlog\", [3, 4])], [{\"type\": \"depends\", \"from\": 1, \"to\": 2}])\n    issues = [issue(1, [\"x/one.py\"]), issue(2, [\"shared.py\"]), issue(3, [\"shared.py\"]), issue(4, [\"y/four.py\"])]\n    out = frontier.compute(body, issues, [])\n    assert wave_of(out, 4) == 1, \"a disjoint lower-ranked issue is placed ahead of a blocked higher one\"\n    assert wave_of(out, 2) == 2\n    assert wave_of(out, 3) == 3\n    assert \"yields shared.py to #2, ranked above\" in why_of(out, 3)\n\n\ndef test_an_issue_overlapping_a_branch_in_flight_is_not_in_wave_one_and_says_which_branch() -> None:\n    body = plan([(\"e1\", [1, 5]), (\"backlog\", [])])\n    flights: list[dict[str, Any]] = [{\"branch\": \"lane/9-other\", \"item\": None, \"declared\": [], \"changed\": [\"src/marker.txt\"]},\n               {\"branch\": \"attavo/5-x\", \"item\": \"5\", \"declared\": [\"lib/**\"], \"changed\": [\"lib/a.py\"]}]\n    out = frontier.compute(body, [issue(1, [\"src/**\"]), issue(5, [\"lib/**\"])], flights,\n                           {\"attavo/5-x\": \"awaiting approval\"})\n    zero = {x[\"branch\"]: x for x in out[\"waves\"][0]}\n    assert zero[\"attavo/5-x\"][\"issue\"] == 5 and zero[\"attavo/5-x\"][\"spec_state\"] == \"awaiting approval\"\n    assert zero[\"lane/9-other\"][\"issue\"] is None and zero[\"lane/9-other\"][\"spec_state\"] == \"lane\"\n    assert wave_of(out, 1) == 2\n    assert why_of(out, 1) == [\"waits on branch lane/9-other: src/**, src/marker.txt\"]\n\n\ndef test_an_issue_with_no_claims_is_not_placed_and_its_dependents_say_why() -> None:\n    body = plan([(\"e1\", [1, 2]), (\"backlog\", [])], [{\"type\": \"depends\", \"from\": 1, \"to\": 2}])\n    out = frontier.compute(body, [issue(1, None), issue(2, [\"b.py\"])], [])\n    by = {x[\"issue\"]: x[\"why\"] for x in out[\"not_placed\"]}\n    assert by[1] == [\"no claims: the issue has no Claims section and no spec\"]\n    assert by[2] == [\"waits on #1 (depends)\"]\n    assert len(out[\"waves\"]) == 1\n\n\ndef test_epic_progress_is_closed_over_total_from_the_forge() -> None:\n    body = plan([(\"e1\", [1, 2, 3]), (\"backlog\", [4])])\n    issues = [issue(1, [\"a\"], \"closed\"), issue(2, [\"b\"], \"closed\"), issue(3, [\"c\"]), issue(4, [\"d\"]),\n              issue(8, [\"e\"])]\n    out = frontier.compute(body, issues, [])\n    assert [(e[\"id\"], e[\"closed\"], e[\"total\"]) for e in out[\"epics\"]] == [(\"e1\", 2, 3), (\"backlog\", 0, 2)]\n    assert not re.search(r\"\\d{4}-\\d{2}-\\d{2}\", json.dumps(out)), \"waves are an order, not a forecast\"\n\n\ndef tenant_with_issues(tmp_path: Path, payload: list[dict[str, Any]]) -> Path:\n    root = make_tenant(tmp_path, \"valid\")\n    cmd = tmp_path / \"issues.py\"\n    cmd.write_text(f\"import sys\\nsys.stdout.write({json.dumps(json.dumps(payload))})\\n\")\n    with (root / \"attavo.toml\").open(\"a\") as f:\n        f.write(f'\\n[forge]\\nissues_command = \"{sys.executable} {cmd}\"\\n')\n    commit_all(root, \"the issues command\")\n    git(root, \"update-ref\", \"refs/remotes/origin/main\", git(root, \"rev-parse\", \"HEAD\").strip())\n    return root\n\n\ndef run_attavo(root: Path, *args: str) -> subprocess.CompletedProcess[str]:\n    return subprocess.run([sys.executable, str(ATTAVO), *args], cwd=str(root),\n                          capture_output=True, text=True, check=False)\n\n\ndef test_the_command_reads_the_store_the_issues_and_git_and_reports_the_waves(tmp_path: Path) -> None:\n    body7 = \"x\\n\\nClass: core\\n\\n## Claims\\n\\n- src/**\\n\"\n    payload = [{\"number\": 7, \"title\": \"seven\", \"state\": \"open\", \"closed_at\": None, \"labels\": [], \"body\": body7},\n               {\"number\": 8, \"title\": \"eight\", \"state\": \"open\", \"closed_at\": None, \"labels\": [],\n                \"body\": \"Class: fix\\n\\n## Claims\\n\\n- src/other.txt\\n\"},\n               {\"number\": 9, \"title\": \"nine\", \"state\": \"open\", \"closed_at\": None, \"labels\": [],\n                \"body\": \"## Claims\\n\\n- docs/x.md\\n\"}]\n    root = tenant_with_issues(tmp_path, payload)\n    store.put(root, \"plan\", plan([(\"e1\", [7, 8]), (\"backlog\", [9])]), 0, \"alice\")\n    git(root, \"checkout\", \"-q\", \"-b\", \"attavo/7-seven\")\n    (root / \"specs\" / \"7\").mkdir(parents=True)\n    (root / \"specs\" / \"7\" / \"spec.md\").write_text(\n        \"## Problem\\n\\nClass: core\\n\\nseven.\\n\\n## Claims\\n\\n- src/**\\n\\n## Criteria\\n\\n- c.sh: exits 0\\n\")\n    (root / \"records\" / \"7\").mkdir(parents=True)\n    (root / \"records\" / \"7\" / \"spec-01.json\").write_text(json.dumps({\"status\": \"pass\", \"item\": \"7\"}))\n    commit_all(root, \"spec for 7\")\n    git(root, \"update-ref\", \"refs/remotes/origin/attavo/7-seven\", git(root, \"rev-parse\", \"HEAD\").strip())\n    git(root, \"checkout\", \"-q\", \"main\")\n\n    run = run_attavo(root, \"frontier\", \"--json\")\n    assert run.returncode == 0, run.stdout + run.stderr\n    out = json.loads(run.stdout)\n    assert out[\"plan_version\"] == 1 and out[\"default\"] == \"refs/remotes/origin/main\"\n    assert [(x[\"issue\"], x[\"spec_state\"]) for x in out[\"waves\"][0]] == [(7, \"awaiting approval\")]\n    assert [x[\"issue\"] for x in out[\"waves\"][1]] == [9]\n    assert [(x[\"issue\"], x[\"class\"]) for x in out[\"waves\"][2]] == [(8, \"fix\")]\n    assert \"yields src/other.txt\" not in \" \".join(out[\"waves\"][2][0][\"why\"])\n    assert any(line.startswith(\"waits on branch attavo/7-seven\") for line in out[\"waves\"][2][0][\"why\"])\n    text = run_attavo(root, \"frontier\")\n    assert text.returncode == 0 and \"wave 0 (in flight): 1\" in text.stdout and \"plan version 1\" in text.stdout\n    assert git(root, \"status\", \"--porcelain\") == \"\"\n\n\ndef test_the_command_is_not_read_without_a_plan_or_an_issues_command_and_refuses_without_origin_head(\n        tmp_path: Path) -> None:\n    root = tenant_with_issues(tmp_path, [])\n    r = run_attavo(root, \"frontier\", \"--json\")\n    assert r.returncode == 2 and \"not read: no plan in the store\" in r.stderr\n    bare = make_tenant(tmp_path, \"valid\", name=\"bare\")\n    store.put(bare, \"plan\", plan([(\"backlog\", [])]), 0, \"alice\")\n    r = run_attavo(bare, \"frontier\")\n    assert r.returncode == 2 and \"not read: no [forge].issues_command\" in r.stderr\n    git(bare, \"symbolic-ref\", \"--delete\", \"refs/remotes/origin/HEAD\")\n    r = run_attavo(bare, \"frontier\")\n    assert r.returncode == 2 and \"refs/remotes/origin/HEAD is not set\" in r.stderr\n","numLines":178,"startLine":1,"totalLines":178}}}

{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0153qgnYpm6PcBWyrAC6tkwt","type":"tool_result","content":"1\t#!/bin/sh\n2\tset -e\n3\there=$(pwd)\n4\ttmp=$(mktemp -d \"${TMPDIR:-/tmp}/attavo.XXXXXX\")\n5\tunset ATTAVO_STORE\n6\tcp -R \"$here/tests/fixtures/valid/.\" \"$tmp/tenant\"\n7\tcat > \"$tmp/issues.json\" <<'JSON'\n8\t[{\"number\": 1, \"title\": \"one\", \"state\": \"open\", \"closed_at\": null, \"labels\": [], \"body\": \"Class: core\\n\\n## Claims\\n\\n- x/one.py\\n\"},\n9\t {\"number\": 2, \"title\": \"two\", \"state\": \"open\", \"closed_at\": null, \"labels\": [], \"body\": \"Class: core\\n\\n## Claims\\n\\n- shared.py\\n\"},\n10\t {\"number\": 3, \"title\": \"three\", \"state\": \"open\", \"closed_at\": null, \"labels\": [], \"body\": \"Class: fix\\n\\n## Claims\\n\\n- shared.py\\n\"},\n11\t {\"number\": 4, \"title\": \"four\", \"state\": \"open\", \"closed_at\": null, \"labels\": [], \"body\": \"Class: fix\\n\\n## Claims\\n\\n- y/four.py\\n\"},\n12\t {\"number\": 5, \"title\": \"five\", \"state\": \"closed\", \"closed_at\": \"2026-09-29T00:00:00Z\", \"labels\": [], \"body\": \"\"},\n13\t {\"number\": 6, \"title\": \"six\", \"state\": \"open\", \"closed_at\": null, \"labels\": [], \"body\": \"no claims yet\"}]\n14\tJSON\n15\tprintf 'import sys\\nsys.stdout.write(open(sys.argv[1]).read())\\n' > \"$tmp/cmd.py\"\n16\tcd \"$tmp/tenant\"\n17\tprintf '\\n[forge]\\nissues_command = \"python3 %s %s\"\\n' \"$tmp/cmd.py\" \"$tmp/issues.json\" >> attavo.toml\n18\tgit init -q -b main .\n19\tgit config user.email fixture@attavo.invalid\n20\tgit config user.name \"fixture\"\n21\tgit add -A\n22\tgit commit -q -m install\n23\tgit update-ref refs/remotes/origin/main \"$(git rev-parse HEAD)\"\n24\tgit symbolic-ref refs/remotes/origin/HEAD refs/remotes/origin/main\n25\tA=\"python3 $here/bin/attavo\"\n26\tif $A frontier --json 2> \"$tmp/nr.err\"; then exit 1; fi\n27\tgrep -q \"not read: no plan in the store\" \"$tmp/nr.err\"\n28\tcat > \"$tmp/plan.json\" <<'JSON'\n29\t{\"schema\": \"plan/1\",\n30\t \"epics\": [{\"id\": \"E1\", \"title\": \"One\", \"issues\": [1, 2, 5]},\n31\t           {\"id\": \"backlog\", \"title\": \"Backlog\", \"issues\": [3, 4]}],\n32\t \"edges\": [{\"type\": \"depends\", \"from\": 1, \"to\": 2}],\n33\t \"policy\": {}}\n34\tJSON\n35\t$A plan put \"$tmp/plan.json\" --base 0 --by alice > /dev/null\n36\tgit checkout -q -b lane/9-other\n37\tmkdir -p y\n38\tprintf 'z\\n' > y/four.py\n39\tgit add -A\n40\tgit commit -q -m other\n41\tgit update-ref refs/remotes/origin/lane/9-other \"$(git rev-parse HEAD)\"\n42\tgit checkout -q main\n43\t$A frontier --json > \"$tmp/f.json\"\n44\tpython3 - \"$tmp/f.json\" <<'PY'\n45\timport json, sys\n46\tf = json.load(open(sys.argv[1]))\n47\twaves = [[(x[\"issue\"], x.get(\"branch\")) for x in w] for w in f[\"waves\"]]\n48\tassert waves[0] == [(None, \"lane/9-other\")], waves\n49\tw = {x[\"issue\"]: k for k, wave in enumerate(f[\"waves\"]) for x in wave if x[\"issue\"]}\n50\tassert (w[1], w[2], w[3], w[4]) == (1, 2, 3, 2), w\n51\twhy3 = next(x[\"why\"] for wave in f[\"waves\"] for x in wave if x[\"issue\"] == 3)\n52\tassert \"yields shared.py to #2, ranked above\" in why3, why3\n53\twhy4 = next(x[\"why\"] for wave in f[\"waves\"] for x in wave if x[\"issue\"] == 4)\n54\tassert why4 == [\"waits on branch lane/9-other: y/four.py\"], why4\n55\tassert [x[\"issue\"] for x in f[\"not_placed\"]] == [6], f[\"not_placed\"]\n56\tassert [(e[\"id\"], e[\"closed\"], e[\"total\"]) for e in f[\"epics\"]] == [(\"E1\", 1, 3), (\"backlog\", 0, 3)], f[\"epics\"]\n57\tassert f[\"plan_version\"] == 1 and \"epic rank\" in f[\"order\"]\n58\tPY\n59\ttest -z \"$(git status --porcelain)\"\n60\tcd \"$here\"\n61\tfor t in test_order_is_epic_rank_then_issue_rank_and_an_unplaced_open_issue_is_backlog_last test_an_issue_with_an_open_predecessor_waits_and_a_closed_one_does_not test_two_issues_whose_claims_overlap_never_share_a_wave_and_the_lower_ranked_one_waits test_strict_opportunism_a_lower_
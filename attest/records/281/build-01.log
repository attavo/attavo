 path, () for none, None for a path this\n    selector does not know.\"\"\"\n    if is_prose_or_record(path):\n        return ()\n    if path.startswith(WHOLE_SUITE_PREFIXES):\n        return None\n    if path.startswith(\"tests/test_\") and path.endswith(\".py\") and \"/\" not in path[len(\"tests/\"):]:\n        # A deleted test file cannot select itself, and the gate must not\n        # pass a deletion unexamined (issue #212's review): fail safe to\n        # the whole suite rather than the () a present file's own removal\n        # would otherwise fall through to.\n        return (path,) if (repository_root() / path).is_file() else None\n    if path in MODULE_TESTS:\n        return MODULE_TESTS[path]\n    for prefix, tests in PREFIX_TESTS:\n        if path.startswith(prefix):\n            return tests\n    return None\n\n\ndef select(paths: list[str]) -> list[str]:\n    tests: dict[str, None] = {}\n    for path in paths:\n        found = select_one(path)\n        if found is None:\n            return [WHOLE_SUITE]\n        tests.update(dict.fromkeys(found))\n    return list(tests)\n\n\ndef main() -> int:\n    changed = [line.strip() for line in sys.stdin.read().splitlines() if line.strip()]\n    for t in select(changed):\n        print(t)\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n","numLines":148,"startLine":1,"totalLines":148}}}

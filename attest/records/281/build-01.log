{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EQzzqiCNeSyYrWSwaNSMF7","type":"tool_result","content":"1\t\"\"\"The tenant's issues, read through [forge].issues_command.\n2\t\n3\tThe issue is the unit of work (ruled 2026-09-29): the plan in the store\n4\t(attavo/plan.py) orders issues, and the forge holds what the plan does\n5\tnot -- each issue's title, whether it is open, when it closed, its\n6\tlabels, and, before it has a spec, the paths it claims in a \"## Claims\"\n7\tsection of its body. The product names no vendor: the tenant's command\n8\tprints the issues as JSON, one object per issue, and this module reads\n9\tit. The claims are parsed here, not by the tenant's command, so every\n10\ttenant's issues are read by one rule.\n11\t\n12\tA read that cannot be made is \"not read\" with its reason, never an empty\n13\tlist: no command in the manifest, a command that exits non-zero or runs\n14\tpast its bound, or output that is not the shape below.\n15\t\n16\t    [{\"number\": 264, \"title\": \"...\", \"state\": \"open\" | \"closed\",\n17\t      \"closed_at\": \"<iso>\" | null, \"labels\": [\"...\"], \"body\": \"...\"}]\n18\t\"\"\"\n19\tfrom __future__ import annotations\n20\t\n21\timport json\n22\tfrom pathlib import Path\n23\tfrom typing import Any, TypedDict\n24\t\n25\tfrom attavo.spec import CLASS_LINE, CLASSES\n26\tfrom attavo.testtool import run_bounded\n27\t\n28\tTIMEOUT_S = 60\n29\tSTATES = (\"open\", \"closed\")\n30\t\n31\t\n32\tclass Issue(TypedDict):\n33\t    number: int\n34\t    title: str\n35\t    state: str\n36\t    closed_at: str | None\n37\t    labels: list[str]\n38\t    claims: list[str] | None\n39\t    item_class: str | None\n40\t\n41\t\n42\tdef parse_claims(body: str) -> list[str] | None:\n43\t    \"\"\"The paths under a \"## Claims\" heading, up to the next \"## \"\n44\t    heading: one \"- path\" line each. None when the body has no Claims\n45\t    section, which is not the same as a section that lists nothing.\"\"\"\n46\t    lines = body.splitlines()\n47\t    starts = [i for i, line in enumerate(lines) if line.rstrip() == \"## Claims\"]\n48\t    if not starts:\n49\t        return None\n50\t    claims = []\n51\t    for line in lines[starts[0] + 1:]:\n52\t        if line.startswith(\"## \"):\n53\t            break\n54\t        s = line.strip()\n55\t        if s.startswith(\"- \"):\n56\t            path = s[2:].strip().strip(\"`\")\n57\t            if path:\n58\t                claims.append(path)\n59\t    return claims\n60\t\n61\t\n62\tdef parse_class(body: str, labels: list[str]) -> str | None:\n63\t    \"\"\"The class the operator declared: a \"Class: core\" or \"Class: fix\"\n64\t    line in the body (the spec's own line, read by the spec's own\n65\t    pattern), else a class:core or class:fix label. None when neither\n66\t    says, which is the unclassed queue's own reading.\"\"\"\n67\t    for line in body.splitlines():\n68\t        if line.startswith(\"## \"):\n69\t            break\n70\t        m = CLASS_LINE.match(line)\n71\t        if m and m.group(1) in CLASSES:\n72\t            return m.group(1)\n73\t    found = [lb.split(\":\", 1)[1] for lb in labels if lb in (\"class:core\", \"class:fix\")]\n74\t    return found[0] if len(found) == 1 else None\n75\t\n76\t\n77\tdef _shape_error(raw: Any) -> str | None:\n78\t    if not isinstance(raw, list):\n79\t        return \"the output is not a list\"\n80\t    for i, x in enumerate(raw):\n81\t        if not isinstance(x, dict):\n82\t            return f\"entry {i} is not an object\"\n83\t        n = x.get(\"number\")\n84\t        if not isinstance(n, int) or isinstance(n, bool) or n < 1:\n85\t            return f\"entry {i} has no issue number\"\n86\t        if not isinstance(x.get(\"title\"), str):\n87\t            return f\"#{n} has no title\"\n88\t        if x.get(\"state\") not in STATES:\n89\t            return f\"#{n} has state {x.get('state')!r}, not open or closed\"\n90\t        if x.get(\"closed_at\") is not None and not isinstance(x.get(\"closed_at\"), str):\n91\t            return f\"#{n} has a closed_at that is not text\"\n92\t        labels = x.get(\"labels\", [])\n93\t        if not isinstance(labels, list) or not all(isinstance(lb, str) for lb in labels):\n94\t            return f\"#{n} has labels that are not a list of names\"\n95\t        if not isinstance(x.get(\"body\", \"\"), str):\n96\t            return f\"#{n} has a body that is not text\"\n97\t    return None\n98\t\n99\t\n100\tdef read_issues(root: Path, m: dict[str, Any]) -> tuple[list[Issue] | None, str | None]:\n101\t    \"\"\"(issues, None), or (None, \"not read: <why>\").\"\"\"\n102\t    command = (m.get(\"forge\") or {}).get(\"issues_command\")\n103\t    if not command:\n104\t        return None, \"not read: no [forge].issues_command\"\n105\t    code, out, err, timed_out = run_bounded(command, root, \"\", TIMEOUT_S)\n106\t    if timed_out:\n107\t        return None, f\"not read: [forge].issues_command ran past {TIMEOUT_S}s\"\n108\t    if code != 0:\n109\t        last = (err.strip().splitlines() or [\"\"])[-1]\n110\t        return None, f\"not read: [forge].issues_command exited {code}\" + (f\": {last}\" if last else \"\")\n111\t    try:\n112\t        raw = json.loads(out)\n113\t    except json.JSONDecodeError as e:\n114\t        return None, f\"not read: [forge].issues_command printed no JSON ({e.msg})\"\n115\t    bad = _shape_error(raw)\n116\t    if bad:\n117\t        return None, f\"not read: [forge].issues_command: {bad}\"\n118\t    issues: list[Issue] = [{\"number\": x[\"number\"], \"title\": x[\"title\"], \"state\": x[\"state\"],\n119\t                            \"closed_at\": x.get(\"closed_at\"), \"labels\": list(x.get(\"labels\", [])),\n120\t                            \"claims\": parse_claims(x.get(\"body\", \"\") or \"\"),\n121\t                            \"item_class\": parse_class(x.get(\"body\", \"\") or \"\", list(x.get(\"labels\", [])))}\n122\t                           for x in raw]\n123\t    return sorted(issues, key=lambda i: i[\"number\"]), None\n124\t"}]},"parent_tool_use_id":null,"session_id":"4588db83-1ef4-4bee-8419-3aef77f32fac","uuid":"a4ffb4d0-2909-4928-8c0e-d647947fbae3","timestamp":"2026-09-30T02:29:24.404Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-281/attest/specs/281/stub/attavo/issues.py","content":"\"\"\"The tenant's issues, read through [forge].issues_command.\n\nThe issue is the unit of work (ruled 2026-09-29): the plan in the store\n(attavo/plan.py) orders issues, and the forge holds what the plan does\nnot -- each issue's title, whether it is open, when it closed, its\nlabels, and, before it has a spec, the paths it claims in a \"## Claims\"\nsection of its body. The product names no vendor: the tenant's command\nprints the issues as JSON, one object per issue, and this module reads\nit. The claims are parsed here, not by the tenant's command, so every\ntenant's issues are read by one rule.\n\nA read that cannot be made is \"not read\" with its reason, never an empty\nlist: no command in the manifest, a command that exits non-zero or runs\npast its bound, or output that is not the shape below.\n\n    [{\"number\": 264, \"title\": \"...\", \"state\": \"open\" | \"closed\",\n      \"closed_at\": \"<iso>\" | null, \"labels\": [\"...\"], \"body\": \"...\"}]\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nfrom pathlib import Path\nfrom typing import Any, TypedDict\n\nfrom attavo.spec import CLASS_LINE, CLASSES\nfrom attavo.testtool import run_bounded\n\nTIMEOUT_S = 60\nSTATES = (\"open\", \"closed\")\n\n\nclass Issue(TypedDict):\n    number: int\n    title: str\n    state: str\n    closed_at: str | None\n    labels: list[str]\n    claims: list[str] | None\n    item_class: str | None\n\n\ndef parse_claims(body: str) -> list[str] | None:\n    \"\"\"The paths under a \"## Claims\" heading, up to the next \"## \"\n    heading: one \"- path\" line each. None when the body has no Claims\n    section, which is not the same as a section that lists nothing.\"\"\"\n    lines = body.splitlines()\n    starts = [i for i, line in enumerate(lines) if line.rstrip() == \"## Claims\"]\n    if not starts:\n        return None\n    claims = []\n    for line in lines[starts[0] + 1:]:\n        if line.startswith(\"## \"):\n            break\n        s = line.strip()\n        if s.startswith(\"- \"):\n            path = s[2:].strip().strip(\"`\")\n            if path:\n                claims.append(path)\n    return claims\n\n\ndef parse_class(body: str, labels: list[str]) -> str | None:\n    \"\"\"The class the operator declared: a \"Class: core\" or \"Class: fix\"\n    line in the body (the spec's own line, read by the spec's own\n    pattern), else a class:core or class:fix label. None when neither\n    says, which is the unclassed queue's own reading.\"\"\"\n    for line in body.splitlines():\n        if line.startswith(\"## \"):\n            break\n        m = CLASS_LINE.match(line)\n        if m and m.group(1) in CLASSES:\n            return m.group(1)\n    found = [lb.split(\":\", 1)[1] for lb in labels if lb in (\"class:core\", \"class:fix\")]\n    return found[0] if len(found) == 1 else None\n\n\ndef _shape_error(raw: Any) -> str | None:\n    if not isinstance(raw, list):\n        return \"the output is not a list\"\n    for i, x in enumerate(raw):\n        if not isinstance(x, dict):\n            return f\"entry {i} is not an object\"\n        n = x.get(\"number\")\n        if not isinstance(n, int) or isinstance(n, bool) or n < 1:\n            return f\"entry {i} has no issue number\"\n        if not isinstance(x.get(\"title\"), str):\n            return f\"#{n} has no title\"\n        if x.get(\"state\") not in STATES:\n            return f\"#{n} has state {x.get('state')!r}, not open or closed\"\n        if x.get(\"closed_at\") is not None and not isinstance(x.get(\"closed_at\"), str):\n            return f\"#{n} has a closed_at that is not text\"\n        labels = x.get(\"labels\", [])\n        if not isinstance(labels, list) or not all(isinstance(lb, str) for lb in labels):\n            return f\"#{n} has labels that are not a list of names\"\n        if not isinstance(x.get(\"body\", \"\"), str):\n            return f\"#{n} has a body that is not text\"\n    return None\n\n\ndef read_issues(root: Path, m: dict[str, Any]) -> tuple[list[Issue] | None, str | None]:\n    \"\"\"(issues, None), or (None, \"not read: <why>\").\"\"\"\n    command = (m.get(\"forge\") or {}).get(\"issues_command\")\n    if not command:\n        return None, \"not read: no [forge].issues_command\"\n    code, out, err, timed_out = run_bounded(command, root, \"\", TIMEOUT_S)\n    if timed_out:\n        return None, f\"not read: [forge].issues_command ran past {TIMEOUT_S}s\"\n    if code != 0:\n        last = (err.strip().splitlines() or [\"\"])[-1]\n        return None, f\"not read: [forge].issues_command exited {code}\" + (f\": {last}\" if last else \"\")\n    try:\n        raw = json.loads(out)\n    except json.JSONDecodeError as e:\n        return None, f\"not read: [forge].issues_command printed no JSON ({e.msg})\"\n    bad = _shape_error(raw)\n    if bad:\n        return None, f\"not read: [forge].issues_command: {bad}\"\n    issues: list[Issue] = [{\"number\": x[\"number\"], \"title\": x[\"title\"], \"state\": x[\"state\"],\n                            \"closed_at\": x.get(\"closed_at\"), \"labels\": list(x.get(\"labels\", [])),\n                            \"claims\": parse_claims(x.get(\"body\", \"\") or \"\"),\n                            \"item_class\": parse_class(x.get(\"body\", \"\") or \"\", list(x.get(\"labels\", [])))}\n                           for x in raw]\n    return sorted(issues, key=lambda i: i[\"number\"]), None\n","numLines":124,"startLine":1,"totalLines":124}}}

y_root() -> Path:\n101\t    return Path(__file__).resolve().parent.parent.parent\n102\t\n103\t\n104\tdef is_prose_or_record(path: str) -> bool:\n105\t    return path.endswith(\".md\") or path == \"LICENSE\" or path.startswith(SILENT_PREFIXES)\n106\t\n107\t\n108\tdef select_one(path: str) -> tuple[str, ...] | None:\n109\t    \"\"\"The tests for one changed path, () for none, None for a path this\n110\t    selector does not know.\"\"\"\n111\t    if is_prose_or_record(path):\n112\t        return ()\n113\t    if path.startswith(WHOLE_SUITE_PREFIXES):\n114\t        return None\n115\t    if path.startswith(\"tests/test_\") and path.endswith(\".py\") and \"/\" not in path[len(\"tests/\"):]:\n116\t        # A deleted test file cannot select itself, and the gate must not\n117\t        # pass a deletion unexamined (issue #212's review): fail safe to\n118\t        # the whole suite rather than the () a present file's own removal\n119\t        # would otherwise fall through to.\n120\t        return (path,) if (repository_root() / path).is_file() else None\n121\t    if path in MODULE_TESTS:\n122\t        return MODULE_TESTS[path]\n123\t    for prefix, tests in PREFIX_TESTS:\n124\t        if path.startswith(prefix):\n125\t            return tests\n126\t    return None\n127\t\n128\t\n129\tdef select(paths: list[str]) -> list[str]:\n130\t    tests: dict[str, None] = {}\n131\t    for path in paths:\n132\t        found = select_one(path)\n133\t        if found is None:\n134\t            return [WHOLE_SUITE]\n135\t        tests.update(dict.fromkeys(found))\n136\t    return list(tests)\n137\t\n138\t\n139\tdef main() -> int:\n140\t    changed = [line.strip() for line in sys.stdin.read().splitlines() if line.strip()]\n141\t    for t in select(changed):\n142\t        print(t)\n143\t    return 0\n144\t\n145\t\n146\tif __name__ == \"__main__\":\n147\t    sys.exit(main())\n148\t"}]},"parent_tool_use_id":null,"session_id":"4588db83-1ef4-4bee-8419-3aef77f32fac","uuid":"fb50060a-2faf-4ef1-9cac-
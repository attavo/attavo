e(lines) if line.rstrip() == \"## Claims\"]\n46\t    if not starts:\n47\t        return None\n48\t    claims = []\n49\t    for line in lines[starts[0] + 1:]:\n50\t        if line.startswith(\"## \"):\n51\t            break\n52\t        s = line.strip()\n53\t        if s.startswith(\"- \"):\n54\t            path = s[2:].strip().strip(\"`\")\n55\t            if path:\n56\t                claims.append(path)\n57\t    return claims\n58\t\n59\t\n60\tdef _shape_error(raw: Any) -> str | None:\n61\t    if not isinstance(raw, list):\n62\t        return \"the output is not a list\"\n63\t    for i, x in enumerate(raw):\n64\t        if not isinstance(x, dict):\n65\t            return f\"entry {i} is not an object\"\n66\t        n = x.get(\"number\")\n67\t        if not isinstance(n, int) or isinstance(n, bool) or n < 1:\n68\t            return f\"entry {i} has no issue number\"\n69\t        if not isinstance(x.get(\"title\"), str):\n70\t            return f\"#{n} has no title\"\n71\t        if x.get(\"state\") not in STATES:\n72\t            return f\"#{n} has state {x.get('state')!r}, not open or closed\"\n73\t        if x.get(\"closed_at\") is not None and not isinstance(x.get(\"closed_at\"), str):\n74\t            return f\"#{n} has a closed_at that is not text\"\n75\t        labels = x.get(\"labels\", [])\n76\t        if not isinstance(labels, list) or not all(isinstance(lb, str) for lb in labels):\n77\t            return f\"#{n} has labels that are not a list of names\"\n78\t        if not isinstance(x.get(\"body\", \"\"), str):\n79\t            return f\"#{n} has a body that is not text\"\n80\t    return None\n81\t\n82\t\n83\tdef read_issues(root: Path, m: dict[str, Any]) -> tuple[list[Issue] | None, str | None]:\n84\t    \"\"\"(issues, None), or (None, \"not read: <why>\").\"\"\"\n85\t    command = (m.get(\"forge\") or {}).get(\"issues_command\")\n86\t    if not command:\n87\t        return None, \"not read: no [forge].issues_command\"\n88\t    code, out, err, timed_out = run_bounded(command, root, \"\", TIMEOUT_S)\n89\t    if timed_out:\n90\t        return None, f\"not read: [forge].issues_command ran past {TIMEOUT_S}s\"\n91\t    if code != 0:\n92\t        last = (err.strip().splitlines() or [\"\"])[-1]\n93\t        return None, f\"not read: [forge].issues_command exited {code}\" + (f\": {last}\" if last else \"\")\n94\t    try:\n95\t        raw = json.loads(out)\n96\t    except json.JSONDecodeError as e:\n97\t        return None, f\"not read: [forge].issues_command printed no JSON ({e.msg})\"\n98\t    bad = _shape_error(raw)\n99\t    if bad:\n100\t        return None, f\"not read: [forge].issues_command: {bad}\"\n101\t    issues: list[Issue] = [{\"number\": x[\"number\"], \"title\": x[\"title\"], \"state\": x[\"state\"],\n102\t                            \"closed_at\": x.get(\"closed_at\"), \"labels\": list(x.get(\"labels\", [])),\n103\t                            \"claims\": parse_claims(x.get(\"body\", \"\") or \"\")} for x in raw]\n104\t    return sorted(issues, key=lambda i: i[\"number\"]), None\n105\t"}]},"parent_tool_use_id":null,"session_id":"4588db83-1ef4-4bee-8419-3aef77f32fac","uuid":"a6dc34d9-7119-4c7f-9dfa-6fb5e4ca07a9","timestamp":"2026-09-30T02:29:30.849Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-281/attavo/issues.py","content":"\"\"\"The tenant's issues, read through [forge].issues_command.\n\nThe issue is the unit of work (ruled 2026-09-29): the plan in the store\n(attavo/plan.py) orders issues, and the forge holds what the plan does\nnot -- each issue's title, whether it is open, when it closed, its\nlabels, and, before it has a spec, the paths it claims in a \"## Claims\"\nsection of its body. The product names no vendor: the tenant's command\nprints the issues as JSON, one object per issue, and this module reads\nit. The claims are parsed here, not by the tenant's command, so every\ntenant's issues are read by one rule.\n\nA read that cannot be made is \"not read\" with its reason, never an empty\nlist: no command in the manifest, a command that exits non-zero or runs\npast its bound, or output that is not the shape below.\n\n    [{\"number\": 264, \"title\": \"...\", \"state\": \"open\" | \"closed\",\n      \"closed_at\": \"<iso>\" | null, \"labels\": [\"...\"], \"body\": \"...\"}]\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nfrom pathlib import Path\nfrom typing import Any, TypedDict\n\nfrom attavo.testtool import run_bounded\n\nTIMEOUT_S = 60\nSTATES = (\"open\", \"closed\")\n\n\nclass Issue(TypedDict):\n    number: int\n    title: str\n    state: str\n    closed_at: str | None\n    labels: list[str]\n    claims: list[str] | None\n\n\ndef parse_claims(body: str) -> list[str] | None:\n    \"\"\"The paths under a \"## Claims\" heading, up to the next \"## \"\n    heading: one \"- path\" line each. None when the body has no Claims\n    section, which is not the same as a section that lists nothing.\"\"\"\n    lines = body.splitlines()\n    starts = [i for i, line in enumerate(lines) if line.rstrip() == \"## Claims\"]\n    if not starts:\n        return None\n    claims = []\n    for line in lines[starts[0] + 1:]:\n        if line.startswith(\"## \"):\n            break\n        s = line.strip()\n        if s.startswith(\"- \"):\n            path = s[2:].strip().strip(\"`\")\n            if path:\n                claims.append(path)\n    return claims\n\n\ndef _shape_error(raw: Any) -> str | None:\n    if not isinstance(raw, list):\n        return \"the output is not a list\"\n    for i, x in enumerate(raw):\n        if not isinstance(x, dict):\n            return f\"entry {i} is not an object\"\n        n = x.get(\"number\")\n        if not isinstance(n, int) or isinstance(n, bool) or n < 1:\n            return f\"entry {i} has no issue number\"\n        if not isinstance(x.get(\"title\"), str):\n            return f\"#{n} has no title\"\n        if x.get(\"state\") not in STATES:\n            return f\"#{n} has state {x.get('state')!r}, not open or closed\"\n        if x.get(\"closed_at\") is not None and not isinstance(x.get(\"closed_at\"), str):\n            return f\"#{n} has a closed_at that is not text\"\n        labels = x.get(\"labels\", [])\n        if not isinstance(labels, list) or not all(isinstance(lb, str) for lb in labels):\n            return f\"#{n} has labels that are not a list of names\"\n        if not isinstance(x.get(\"body\", \"\"), str):\n            return f\"#{n} has a body that is not text\"\n    return None\n\n\ndef read_issues(root: Path, m: dict[str, Any]) -> tuple[list[Issue] | None, str | None]:\n    \"\"\"(issues, None), or (None, \"not read: <why>\").\"\"\"\n    command = (m.get(\"forge\") or {}).get(\"issues_command\")\n    if not command:\n        return None, \"not read: no [forge].issues_command\"\n    code, out, err, timed_out = run_bounded(command, root, \"\", TIMEOUT_S)\n    if timed_out:\n        return None, f\"not read: [forge].issues_command ran past {TIMEOUT_S}s\"\n    if code != 0:\n        last = (err.strip().splitlines() or [\"\"])[-1]\n        return None, f\"not read: [forge].issues_command exited {code}\" + (f\": {last}\" if last else \"\")\n    try:\n        raw = json.loads(out)\n    except json.JSONDecodeError as e:\n        return None, f\"not read: [forge].issues_command printed no JSON ({e.msg})\"\n    bad = _shape_error(raw)\n    if bad:\n        return None, f\"not read: [forge].issues_command: {bad}\"\n    issues: list[Issue] = [{\"number\": x[\"number\"], \"title\": x[\"title\"], \"state\": x[\"state\"],\n                            \"closed_at\": x.get(\"closed_at\"), \"labels\": list(x.get(\"labels\", [])),\n                            \"claims\": parse_claims(x.get(\"body\", \"\") or \"\")} for x in raw]\n    return sorted(issues, key=lambda i: i[\"number\"]), None\n","numLines":105,"startLine":1,"totalLines":105}}}

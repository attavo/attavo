{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01CZF6vpUsFvzqcsoJbGir9v","type":"tool_result","content":"131\tdef test_doctor_proof_six_holds_a_v5_estimate_and_fails_one_that_differs(tmp_path: Path) -> None:\n132\t    \"\"\"#277's verify-01 priced in a v5 statement holds; an estimate, a sum,\n133\t    a basis or a carried rate that is not what the records and rates give\n134\t    fails, naming the item and the cost field.\"\"\"\n135\t    root, merge = specimen(tmp_path, RATE_TABLE)\n136\t    statement = attest(root)\n137\t    seal(root, merge, statement, \"https://attavo.dev/attestation/v5\")\n138\t    held = proof_six(root)\n139\t    assert held[\"holds\"] is True and held[\"sealed\"] == [\"1\"], held\n140\t\n141\t    edits: list[tuple[tuple[str, ...], Any]] = [\n142\t        ((\"estimated_usd\",), 0.25), ((\"usd\",), 0.75), ((\"by_stage_usd\", \"verify\"), 0.3),\n143\t        ((\"basis_by_stage\", \"verify\"), \"reported\"), ((\"rates\", CODEX, \"input_usd_per_mtok\"), 2.0),\n144\t        ((\"estimate_note\",), \"A bill.\")]\n145\t    for path, value in edits:\n146\t        forged: dict[str, Any] = json.loads(json.dumps(statement))\n147\t        node = forged[\"cost\"]\n148\t        for key in path[:-1]:\n149\t            node = node[key]\n150\t        node[path[-1]] = value\n151\t        seal(root, merge, forged, \"https://attavo.dev/attestation/v5\")\n152\t        failed = proof_six(root)\n153\t        assert failed[\"holds\"] is False, (path, failed)\n154\t        assert \"item 1\" in failed[\"reason\"] and \"cost\" in failed[\"reason\"], failed\n155\t\n156\t\n157\tdef test_doctor_proof_six_still_holds_v4_and_v3_statements_by_their_own_rules(\n158\t        tmp_path: Path) -> None:\n159\t    \"\"\"A statement sealed before #307 priced nothing: #277's verify-01 stays\n160\t    unread in it, though the manifest has a rate now, and it holds. v4 by\n161\t    its predicateType and, with none declared, by carrying no v5 field.\"\"\"\n162\t    root, merge = specimen(tmp_path, RATE_TABLE)\n163\t    statement = attest(root)\n164\t    v4: dict[str, Any] = json.loads(json.dumps(statement))\n165\t    for field in V5_COST_FIELDS:\n166\t        v4[\"cost\"].pop(field)\n167\t    v4[\"cost\"][\"usd\"] = 0.5\n168\t    v4[\"cost\"][\"by_stage_usd\"] = {\"build\": 0.5}\n169\t    v4[\"cost\"][\"by_adapter_usd\"] = {\"claude-code\": 0.5}\n170\t    v4[\"cost\"][\"partial\"] = True\n171\t    v4[\"cost\"][\"not_read\"] = [\"verify-01\"]\n172\t    for declared in (\"https://attavo.dev/attestation/v4\", None):\n173\t        seal(root, merge, v4, declared)\n174\t        held = proof_six(root)\n175\t        assert held[\"holds\"] is True and held[\"sealed\"] == [\"1\"], (declared, held)\n176\t    v4[\"cost\"][\"usd\"] = 0.75\n177\t    seal(root, merge, v4, \"https://attavo.dev/attestation/v4\")\n178\t    assert proof_six(root)[\"holds\"] is False, \"v4's cost is still checked\"\n179\t\n180\t    v3: dict[str, Any] = json.loads(json.dumps(statement))\n181\t    for field in V5_COST_FIELDS:\n182\t        v3[\"cost\"].pop(field)\n183\t    v3[\"cost\"].update({\"usd\": 0.5, \"by_stage_usd\": {\"build\": 0.5},\n184\t                       \"by_adapter_usd\": {\"claude-code\": 0.5},\n185\t                       \"partial\": True, \"not_read\": [\"verify-01\"]})\n186\t    v3.pop(\"tokens\")\n187\t    v3[\"cost_by_stage_usd\"] = {\"build\": 0.5, \"verify\": None}\n188\t    seal(root, merge, v3, \"https://attavo.dev/attestation/v3\")\n189\t    held = proof_six(root)\n190\t    assert held[\"holds\"] is True and held[\"sealed\"] == [\"1\"], held\n191\t\n192\t\n193\tdef test_the_manifest_schema_accepts_the_rate_table_and_refuses_a_rate_with_no_as_of() -> None:\n194\t    \"\"\"The product carries no rate of its own: the tenant's table, each\n195\t    rate dated and sourced.\"\"\"\n196\t    cost = MANIFEST_SCHEMA[\"properties\"][\"cost\"]\n197\t    jsonschema.validate({\"rates\": {CODEX: CODEX_RATE}}, cost)\n198\t    undated = {k: v for k, v in CODEX_RATE.items() if k != \"as_of\"}\n199\t    with pytest.raises(jsonschema.ValidationError):\n200\t        jsonschema.validate({\"rates\": {CODEX: undated}}, cost)\n201\t    unsourced = {k: v for k, v in CODEX_RATE.items() if k != \"source\"}\n202\t    with pytest.raises(jsonschema.ValidationError):\n203\t        jsonschema.validate({\"rates\": {CODEX: unsourced}}, cost)\n204\t    with pytest.raises(jsonschema.ValidationError):\n205\t        jsonschema.validate({\"rates\": {CODEX: {**CODEX_RATE, \"input_usd_per_mtok\": -1}}}, cost)\n206\t\n207\t\n208\tdef test_an_item_with_no_priced_record_keeps_the_v4_totals(tmp_path: Path) -> None:\n209\t    \"\"\"INVOCATIONS carry no model: nothing is priced, nothing is renamed in not_read.\"\"\"\n210\t    root, _ = make_item(tmp_path, INVOCATIONS, manifest_extra=RATE_TABLE)\n211\t    cost = attest(root)[\"cost\"]\n212\t    assert cost[\"usd\"] == 0.875 and cost[\"estimated_usd\"] == 0.0\n213\t    assert cost[\"not_read\"] == [\"verify-01\", \"verify-02\", \"counsel-01\"]\n214\t\n215\t\n216\tdef test_a_v5_statement_whose_carried_rate_differs_from_the_manifest_at_its_sealed_commit_fails(\n217\t        tmp_path: Path) -> None:\n218\t    \"\"\"#277's verify-01 priced at a rate the manifest never declared at the\n219\t    sealed commit: the statement's own arithmetic is consistent, but the\n220\t    rate it quotes is not the tenant's, so proof six fails, naming cost.rates.\"\"\"\n221\t    root, merge = specimen(tmp_path, RATE_TABLE)\n222\t    statement = attest(root)\n223\t    quoted = {**CODEX_RATE, \"input_usd_per_mtok\": 0.01, \"output_usd_per_mtok\": 0.01}\n224\t    statement[\"cost\"][\"rates\"] = {CODEX: quoted}\n225\t    statement[\"cost\"][\"estimated_usd\"] = 0.003604\n226\t    statement[\"cost\"][\"by_stage_usd\"][\"verify\"] = 0.003604\n227\t    statement[\"cost\"][\"by_adapter_usd\"][\"codex\"] = 0.003604\n228\t    statement[\"cost\"][\"usd\"] = 0.503604\n229\t    seal(root, merge, statement, \"https://attavo.dev/attestation/v5\")\n230\t    failed = proof_six(root)\n231\t    assert failed[\"holds\"] is False, failed\n232\t    assert \"item 1\" in failed[\"reason\"] and \"cost.rates\" in failed[\"reason\"], failed\n233\t\n234\t\n235\tdef test_a_v5_statement_still_holds_after_the_manifests_rate_changes_in_a_later_commit(\n236\t        tmp_path: Path) -> None:\n237\t    \"\"\"The sealed commit does not move: a rate edited afterwards unseals nothing.\"\"\"\n238\t    root, merge = specimen(tmp_path, RATE_TABLE)\n239\t    seal(root, merge, attest(root), \"https://attavo.dev/attestation/v5\")\n240\t    manifest = root / \"attavo.toml\"\n241\t    manifest.write_text(manifest.read_text().replace(\"input_usd_per_mtok = 1.25\",\n242\t                                                     \"input_usd_per_mtok = 9.99\"))\n243\t    git(root, \"commit\", \"-q\", \"-am\", \"reprice\")\n244\t    held = proof_six(root)\n245\t    assert held[\"holds\"] is True and held[\"sealed\"] == [\"1\"], held\n246\t\n247\t\n248\tdef test_a_v5_statement_fails_when_the_manifest_cannot_be_read_at_its_sealed_commit(\n249\t        tmp_path: Path) -> None:\n250\t    \"\"\"No fallback to the carried rates: a sealed commit that holds no\n251\t    manifest fails the proof and names that.\"\"\"\n252\t    root, _ = specimen(tmp_path, RATE_TABLE)\n253\t    statement = attest(root)\n254\t    empty = git(root, \"hash-object\", \"-t\", \"tree\", \"/dev/null\").strip()\n255\t    bare = git(root, \"commit-tree\", empty, \"-m\", \"no manifest\").strip()\n256\t    envelope = {\"predicateType\": \"https://attavo.dev/attestation/v5\", \"predicate\": statement}\n257\t    reason = _accounting_disagrees(root, root / \"records\" / \"1\", \"1\", bare, envelope)\n258\t    assert reason is not None and \"item 1\" in reason, reason\n259\t    assert \"attavo.toml cannot be read at the sealed commit\" in reason, reason\n260\t"}]},"parent_tool_use_id":null,"session_id":"8b358cc5-0655-4274-9562-475abdbf906d","uuid":"bb4b7f85-b322-4aa9-8101-278baec91ea2","timestamp":"2026-10-14T20:00:54.943Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-353/tests/test_estimated_cost.py","content":"def test_doctor_proof_six_holds_a_v5_estimate_and_fails_one_that_differs(tmp_path: Path) -> None:\n    \"\"\"#277's verify-01 priced in a v5 statement holds; an estimate, a sum,\n    a basis or a carried rate that is not what the records and rates give\n    fails, naming the item and the cost field.\"\"\"\n    root, merge = specimen(tmp_path, RATE_TABLE)\n    statement = attest(root)\n    seal(root, merge, statement, \"https://attavo.dev/attestation/v5\")\n    held = proof_six(root)\n    assert held[\"holds\"] is True and held[\"sealed\"] == [\"1\"], held\n\n    edits: list[tuple[tuple[str, ...], Any]] = [\n        ((\"estimated_usd\",), 0.25), ((\"usd\",), 0.75), ((\"by_stage_usd\", \"verify\"), 0.3),\n        ((\"basis_by_stage\", \"verify\"), \"reported\"), ((\"rates\", CODEX, \"input_usd_per_mtok\"), 2.0),\n        ((\"estimate_note\",), \"A bill.\")]\n    for path, value in edits:\n        forged: dict[str, Any] = json.loads(json.dumps(statement))\n        node = forged[\"cost\"]\n        for key in path[:-1]:\n            node = node[key]\n        node[path[-1]] = value\n        seal(root, merge, forged, \"https://attavo.dev/attestation/v5\")\n        failed = proof_six(root)\n        assert failed[\"holds\"] is False, (path, failed)\n        assert \"item 1\" in failed[\"reason\"] and \"cost\" in failed[\"reason\"], failed\n\n\ndef test_doctor_proof_six_still_holds_v4_and_v3_statements_by_their_own_rules(\n        tmp_path: Path) -> None:\n    \"\"\"A statement sealed before #307 priced nothing: #277's verify-01 stays\n    unread in it, though the manifest has a rate now, and it holds. v4 by\n    its predicateType and, with none declared, by carrying no v5 field.\"\"\"\n    root, merge = specimen(tmp_path, RATE_TABLE)\n    statement = attest(root)\n    v4: dict[str, Any] = json.loads(json.dumps(statement))\n    for field in V5_COST_FIELDS:\n        v4[\"cost\"].pop(field)\n    v4[\"cost\"][\"usd\"] = 0.5\n    v4[\"cost\"][\"by_stage_usd\"] = {\"build\": 0.5}\n    v4[\"cost\"][\"by_adapter_usd\"] = {\"claude-code\": 0.5}\n    v4[\"cost\"][\"partial\"] = True\n    v4[\"cost\"][\"not_read\"] = [\"verify-01\"]\n    for declared in (\"https://attavo.dev/attestation/v4\", None):\n        seal(root, merge, v4, declared)\n        held = proof_six(root)\n        assert held[\"holds\"] is True and held[\"sealed\"] == [\"1\"], (declared, held)\n    v4[\"cost\"][\"usd\"] = 0.75\n    seal(root, merge, v4, \"https://attavo.dev/attestation/v4\")\n    assert proof_six(root)[\"holds\"] is False, \"v4's cost is still checked\"\n\n    v3: dict[str, Any] = json.loads(json.dumps(statement))\n    for field in V5_COST_FIELDS:\n        v3[\"cost\"].pop(field)\n    v3[\"cost\"].update({\"usd\": 0.5, \"by_stage_usd\": {\"build\": 0.5},\n                       \"by_adapter_usd\": {\"claude-code\": 0.5},\n                       \"partial\": True, \"not_read\": [\"verify-01\"]})\n    v3.pop(\"tokens\")\n    v3[\"cost_by_stage_usd\"] = {\"build\": 0.5, \"verify\": None}\n    seal(root, merge, v3, \"https://attavo.dev/attestation/v3\")\n    held = proof_six(root)\n    assert held[\"holds\"] is True and held[\"sealed\"] == [\"1\"], held\n\n\ndef test_the_manifest_schema_accepts_the_rate_table_and_refuses_a_rate_with_no_as_of() -> None:\n    \"\"\"The product carries no rate of its own: the tenant's table, each\n    rate dated and sourced.\"\"\"\n    cost = MANIFEST_SCHEMA[\"properties\"][\"cost\"]\n    jsonschema.validate({\"rates\": {CODEX: CODEX_RATE}}, cost)\n    undated = {k: v for k, v in CODEX_RATE.items() if k != \"as_of\"}\n    with pytest.raises(jsonschema.ValidationError):\n        jsonschema.validate({\"rates\": {CODEX: undated}}, cost)\n    unsourced = {k: v for k, v in CODEX_RATE.items() if k != \"source\"}\n    with pytest.raises(jsonschema.ValidationError):\n        jsonschema.validate({\"rates\": {CODEX: unsourced}}, cost)\n    with pytest.raises(jsonschema.ValidationError):\n        jsonschema.validate({\"rates\": {CODEX: {**CODEX_RATE, \"input_usd_per_mtok\": -1}}}, cost)\n\n\ndef test_an_item_with_no_priced_record_keeps_the_v4_totals(tmp_path: Path) -> None:\n    \"\"\"INVOCATIONS carry no model: nothing is priced, nothing is renamed in not_read.\"\"\"\n    root, _ = make_item(tmp_path, INVOCATIONS, manifest_extra=RATE_TABLE)\n    cost = attest(root)[\"cost\"]\n    assert cost[\"usd\"] == 0.875 and cost[\"estimated_usd\"] == 0.0\n    assert cost[\"not_read\"] == [\"verify-01\", \"verify-02\", \"counsel-01\"]\n\n\ndef test_a_v5_statement_whose_carried_rate_differs_from_the_manifest_at_its_sealed_commit_fails(\n        tmp_path: Path) -> None:\n    \"\"\"#277's verify-01 priced at a rate the manifest never declared at the\n    sealed commit: the statement's own arithmetic is consistent, but the\n    rate it quotes is not the tenant's, so proof six fails, naming cost.rates.\"\"\"\n    root, merge = specimen(tmp_path, RATE_TABLE)\n    statement = attest(root)\n    quoted = {**CODEX_RATE, \"input_usd_per_mtok\": 0.01, \"output_usd_per_mtok\": 0.01}\n    statement[\"cost\"][\"rates\"] = {CODEX: quoted}\n    statement[\"cost\"][\"estimated_usd\"] = 0.003604\n    statement[\"cost\"][\"by_stage_usd\"][\"verify\"] = 0.003604\n    statement[\"cost\"][\"by_adapter_usd\"][\"codex\"] = 0.003604\n    statement[\"cost\"][\"usd\"] = 0.503604\n    seal(root, merge, statement, \"https://attavo.dev/attestation/v5\")\n    failed = proof_six(root)\n    assert failed[\"holds\"] is False, failed\n    assert \"item 1\" in failed[\"reason\"] and \"cost.rates\" in failed[\"reason\"], failed\n\n\ndef test_a_v5_statement_still_holds_after_the_manifests_rate_changes_in_a_later_commit(\n        tmp_path: Path) -> None:\n    \"\"\"The sealed commit does not move: a rate edited afterwards unseals nothing.\"\"\"\n    root, merge = specimen(tmp_path, RATE_TABLE)\n    seal(root, merge, attest(root), \"https://attavo.dev/attestation/v5\")\n    manifest = root / \"attavo.toml\"\n    manifest.write_text(manifest.read_text().replace(\"input_usd_per_mtok = 1.25\",\n                                                     \"input_usd_per_mtok = 9.99\"))\n    git(root, \"commit\", \"-q\", \"-am\", \"reprice\")\n    held = proof_six(root)\n    assert held[\"holds\"] is True and held[\"sealed\"] == [\"1\"], held\n\n\ndef test_a_v5_statement_fails_when_the_manifest_cannot_be_read_at_its_sealed_commit(\n        tmp_path: Path) -> None:\n    \"\"\"No fallback to the carried rates: a sealed commit that holds no\n    manifest fails the proof and names that.\"\"\"\n    root, _ = specimen(tmp_path, RATE_TABLE)\n    statement = attest(root)\n    empty = git(root, \"hash-object\", \"-t\", \"tree\", \"/dev/null\").strip()\n    bare = git(root, \"commit-tree\", empty, \"-m\", \"no manifest\").strip()\n    envelope = {\"predicateType\": \"https://attavo.dev/attestation/v5\", \"predicate\": statement}\n    reason = _accounting_disagrees(root, root / \"records\" / \"1\", \"1\", bare, envelope)\n    assert reason is not None and \"item 1\" in reason, reason\n    assert \"attavo.toml cannot be read at the sealed commit\" in reason, reason\n","numLines":130,"startLine":131,"totalLines":260}},"tool_result_meta":[{"id":"toolu_01CZF6vpUsFvzqcsoJbGir9v","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}

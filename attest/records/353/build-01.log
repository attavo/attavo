{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Ty44YbRVXJUWAtMLoANv8N","type":"tool_result","content":"1\tfrom __future__ import annotations\n2\t\n3\timport fnmatch\n4\timport json\n5\timport os\n6\timport re\n7\timport subprocess\n8\tfrom pathlib import Path\n9\tfrom typing import Any\n10\t\n11\tfrom attavo import clock\n12\tfrom attavo.attest import check_attest_chain, item_accounting\n13\tfrom attavo.build import build_is_empty, driver_identity\n14\tfrom attavo.common import (\n15\t    MANIFEST,\n16\t    Proof,\n17\t    parse_manifest,\n18\t    STAGES,\n19\t    fixture_item_id,\n20\t    git,\n21\t    product_version,\n22\t    read_manifest,\n23\t    git_env,\n24\t)\n25\tfrom attavo.events import stage_events_dir\n26\tfrom attavo.records import RECORD_RE, load_records, parse_attempts\n27\tfrom attavo.spec import parse_spec\n28\tfrom attavo.stops import (\n29\t    STOP_CLASSES,\n30\t    STOP_PROVENANCES,\n31\t    STOP_REDERIVABLE_FROM,\n32\t    STOP_STAGES,\n33\t    gate_stop,\n34\t    is_recovery_stop,\n35\t    recovery_fault,\n36\t    rederive_stop,\n37\t)\n38\tfrom attavo import Command\n39\t\n40\t# --- doctor's three proofs ---\n41\t\n42\tdef proof_every_gate_rejects(root: Path, m: dict[str, Any] | None) -> Proof:\n43\t    p = Proof(\"every-gate-rejects\", \"every gate rejects its fixture\")\n44\t    if m is None:\n45\t        return p.fail(f\"no {MANIFEST} at {root}; no gate is registered\")\n46\t    gates = m.get(\"gates\") or {}\n47\t    if not gates:\n48\t        return p.fail(\"[gates] is empty; a gate that has rejected nothing does not exist\")\n49\t    fixtures = root / m.get(\"paths\", {}).get(\"rejections\", \"\")\n50\t    # Proposal, not yet ruled on (issue #54): a gate that retires nothing\n51\t    # only adds, so proof one reports it here rather than waiting on the\n52\t    # schema alone -- read_manifest never validates against the manifest\n53\t    # schema at runtime, so a schema requirement is not an enforced one.\n54\t    no_retires = [name for name, gate in sorted(gates.items()) if not gate.get(\"retires\")]\n55\t    missing, accepted = [], []\n56\t    for name, gate in sorted(gates.items()):\n57\t        fixture = fixtures / name\n58\t        if not fixture.is_dir():\n59\t            missing.append(name)\n60\t            continue\n61\t        env = dict(os.environ)\n62\t        item = fixture_item_id(fixture)\n63\t        if item is not None:\n64\t            env[\"ATTAVO_ITEM\"] = item\n65\t        run = subprocess.run(gate[\"command\"], shell=True, cwd=str(fixture),\n66\t                             capture_output=True, text=True, check=False, env=env)\n67\t        if run.returncode == 0:\n68\t            accepted.append(name)\n69\t    if missing:\n70\t        return p.fail(f\"gate(s) with no rejection fixture: {', '.join(missing)}\")\n71\t    if accepted:\n72\t        return p.fail(f\"gate(s) that accepted their rejection fixture: {', '.join(accepted)}\")\n73\t    if no_retires:\n74\t        return p.fail(f\"gate(s) with no retires: {', '.join(no_retires)}\")\n75\t    return p.hold(f\"{len(gates)} gate(s) rejected their fixture\")\n76\t\n77\t\n78\tdef _merges_reachable(root: Path, ref: str | None = None) -> tuple[list[dict[str, Any]], str | None]:\n79\t    \"\"\"(merges, refusal): every merge commit on the default branch's own\n80\t    first-parent line -- sha, parents, and its own first-parent diff --\n81\t    read by one process rather than the git log plus one git diff per\n82\t    merge merge_introducing_records used to pay walking toward the one\n83\t    it wants (issue #153). refs/remotes/origin/HEAD names the default\n84\t    branch without hard-coding \"main\", the same primitive\n85\t    diff_since_approval already uses (issue #52); walking from it rather\n86\t    than from HEAD is what keeps a transport merge on an item branch, a\n87\t    pull_request checkout's own synthetic test merge, and a merge_group's\n88\t    temporary merge from ever being mistaken for an item's merge (issue\n89\t    #169) -- none of those is reachable from the default branch's first-\n90\t    parent line by definition. When refs/remotes/origin/HEAD is not set,\n91\t    this refuses by name rather than guess, exactly as diff_since_approval\n92\t    does.\n93\t\n94\t    The walk starts at HEAD itself when the current checkout is literally\n95\t    on the branch refs/remotes/origin/HEAD names (an ordinary checkout of\n96\t    the default branch, on push or on a developer's own machine) and at\n97\t    the remote-tracking ref's own value otherwise (any other branch, or\n98\t    the detached HEAD a pull_request or merge_group checkout leaves\n99\t    behind) -- HEAD only ever *is* the default branch's first-parent line\n100\t    in the former case; in the latter, only the remote-tracking ref names\n101\t    it. --diff-merges=first-parent gives each merge's diff against its\n102\t    first parent in the same pass git log --merges already makes to list\n103\t    them, in the same order, newest first.\"\"\"\n104\t    symref = subprocess.run(\n105\t        [\"git\", \"-C\", str(root), \"symbolic-ref\", \"-q\", \"refs/remotes/origin/HEAD\"],\n106\t        capture_output=True, text=True, check=False, env=git_env())\n107\t    if symref.returncode != 0:\n108\t        return [], \"refs/remotes/origin/HEAD is not set; run `git remote set-head origin -a`\"\n109\t    default_remote_ref = symref.stdout.strip()\n110\t    default_branch = default_remote_ref.rsplit(\"/\", 1)[-1]\n111\t    current_branch = subprocess.run(\n112\t        [\"git\", \"-C\", str(root), \"symbolic-ref\", \"-q\", \"--short\", \"HEAD\"],\n113\t        capture_output=True, text=True, check=False, env=git_env())\n114\t    default_ref = ref or (\"HEAD\" if current_branch.returncode == 0\n115\t                          and current_branch.stdout.strip() == default_branch\n116\t                          else default_remote_ref)\n117\t    try:\n118\t        out = git(root, \"log\", default_ref, \"--first-parent\", \"--merges\",\n119\t                 \"--diff-merges=first-parent\", \"--name-only\",\n120\t                 \"--format=\\x01%H\\x1f%P\")\n121\t    except RuntimeError:\n122\t        return [], None\n123\t    merges = []\n124\t    for block in out.split(\"\\x01\")[1:]:\n125\t        header, _, rest = block.partition(\"\\n\")\n126\t        sha, parents = header.split(\"\\x1f\")\n127\t        merges.append({\"sha\": sha, \"parents\": parents.split(),\n128\t                       \"touched\": [line for line in rest.splitlines() if line.strip()]})\n129\t    return merges, None\n130\t\n131\t\n132\tdef merge_introducing_records(root: Path, records_rel: str, item: str,\n133\t                              stages: tuple[str, ...],\n134\t                              merges: list[dict[str, Any]] | None = None) -> tuple[str | None, str | None]:\n135\t    \"\"\"(merge_sha, refusal): the merge commit on the default branch's own\n136\t    first-parent line whose first-parent diff introduces a record for\n137\t    every one of stages, under records_rel/item/ -- the same derivation\n138\t    attest itself uses (derive_attest_items), read here so proof two\n139\t    requires an item's stage records to have arrived by an actual merge\n140\t    on the default branch, not merely to sit in the tree, and not by a\n141\t    transport merge, a pull_request checkout's synthetic test merge, or a\n142\t    merge_group's temporary merge (issue #69 acceptance row 4; issue\n143\t    #169). merge_sha is None with no refusal when no such merge exists\n144\t    yet -- the item is not merged, not that the walk failed.\n145\t\n146\t    merges, when given, is _merges_reachable's own result -- ledger's\n147\t    cmd_ledger computes it once and passes it to every item rather than\n148\t    walking the default branch's merges again for each (issue #153); a\n149\t    caller that already has merges has also already handled\n150\t    _merges_reachable's refusal, so this never re-derives one. Left\n151\t    None, a caller with just the one item to ask (doctor's proof two)\n152\t    gets merges computed here, refusal and all.\"\"\"\n153\t    if merges is None:\n154\t        merges, refusal = _merges_reachable(root)\n155\t        if refusal:\n156\t            return None, refusal\n157\t    prefix = f\"{records_rel.rstrip('/')}/{item}/\"\n158\t    for merge in merges:\n159\t        found: set[str] = set()\n160\t        for p in merge[\"touched\"]:\n161\t            if p.startswith(prefix):\n162\t                m = RECORD_RE.match(Path(p).name)\n163\t                if m:\n164\t                    found.add(m.group(1))\n165\t        if all(s in found for s in stages):\n166\t            return merge[\"sha\"], None\n167\t    return None, None\n168\t\n169\t\n170\tINVOCATION_MARKER_SUFFIX = \".started\"\n171\t\n172\t\n173\tdef invocation_marker_path(records_dir: Path, stage: str, nn: int) -> Path:\n174\t    return records_dir / f\"{stage}-{nn:02d}{INVOCATION_MARKER_SUFFIX}\"\n175\t\n176\t\n177\tdef heartbeat_s() -> float:\n178\t    return float(os.environ.get(\"ATTAVO_HEARTBEAT_S\", 15))\n179\t\n180\t\n181\tdef heartbeat_path(root: Path, stage: str, nn: int) -> Path:\n182\t    return stage_events_dir(root) / f\"{stage}-{nn:02d}.heartbeat\"\n183\t\n184\t\n185\tdef holder_heartbeat_path(root: Path, info: dict[str, Any], stage: str, nn: int) -> Path | None:\n186\t    \"\"\"Where the holder of an invocation writes its heartbeat, as far as\n187\t    this host can read it: the directory its marker names, when the\n188\t    marker is from this host and names one; this checkout's own, for a\n189\t    marker from this host written before markers named it; None for a\n190\t    marker from another host, whose heartbeat no file here holds.\"\"\"\n191\t    import socket\n192\t    if info.get(\"host\") != socket.gethostname():\n193\t        return None\n194\t    events = info.get(\"events\")\n195\t    if isinstance(events, str) and events:\n196\t        return Path(events) / f\"{stage}-{nn:02d}.heartbeat\"\n197\t    return heartbeat_path(root, stage, nn)\n198\t\n199\t\n200\tdef heartbeat_pid(path: Path) -> int | None:\n201\t    \"\"\"The pid the worker wrote as its heartbeat file's one line on its\n202\t    first beat -- the holder's own, the only pid anyone signals. None when\n203\t    the file is absent, unreadable, empty (a worker from before this\n204\t    release touched it and wrote nothing), or not a positive integer.\"\"\"\n205\t    try:\n206\t        text = path.read_text().strip()\n207\t    except OSError:\n208\t        return None\n209\t    if not text.isdigit() or int(text) <= 0:\n210\t        return None\n211\t    return int(text)\n212\t\n213\t\n214\tdef heartbeat_age_s(path: Path) -> float | None:\n215\t    \"\"\"Seconds since the heartbeat file was last touched; None when there\n216\t    is no such file.\"\"\"\n217\t    try:\n218\t        return clock.now() - path.stat().st_mtime\n219\t    except OSError:\n220\t        return None\n221\t\n222\t\n223\tdef write_invocation_marker(root: Path, records_dir: Path, stage: str, nn: int,\n224\t                            again_by: str | None = None, events_dir: Path | None = None) -> Path:\n225\t    \"\"\"The fact that an invocation began, written before it does: at,\n226\t    host, the sha it starts on, and the product that started it. No pid:\n227\t    the writer is `attavo drive`, which returns seconds later, and the\n228\t    process that holds the stage is the worker, whose own heartbeat is\n229\t    the fact of holding it. Its record's arrival is what retires a\n230\t    marker; a marker with no record is an invocation that died or hangs,\n231\t    and proof five names it. again_by is the login that pressed `--again`\n232\t    to reset a stage whose budget was spent (or whose last two signatures\n233\t    matched) -- absent on every ordinary marker, never a bare false.\n234\t    events names the directory the holder's heartbeat will be written in\n235\t    (the checkout's own <git-dir>/attavo, events_dir when the marker is\n236\t    written from a detached worktree for another checkout): two checkouts\n237\t    on one host each keep their own, so the host alone never says where\n238\t    the holder's heartbeat can be read.\"\"\"\n239\t    import socket\n240\t    from datetime import datetime, timezone\n241\t    records_dir.mkdir(parents=True, exist_ok=True)\n242\t    path = invocation_marker_path(records_dir, stage, nn)\n243\t    sha = git(root, \"rev-parse\", \"HEAD\").strip()\n244\t    info: dict[str, Any] = {\"at\": datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\"),\n245\t                            \"host\": socket.gethostname(), \"sha\": sha,\n246\t                            \"product_version\": product_version(),\n247\t                            \"events\": str(events_dir or stage_events_dir(root))}\n248\t    if again_by:\n249\t        info[\"again_by\"] = again_by\n250\t    path.write_text(json.dumps(info, indent=2) + \"\\n\")\n251\t    return path\n252\t\n253\t\n254\tdef invocation_age_s(info: dict[str, Any]) -> float | None:\n255\t    \"\"\"Seconds since the marker's own `at` timestamp -- how long ago the\n256\t    invocation it names began, whatever host wrote it. None when `at` is\n257\t    missing or does not parse.\"\"\"\n258\t    from datetime import datetime, timezone\n259\t    at = info.get(\"at\")\n260\t    if not isinstance(at, str):\n261\t        return None\n262\t    try:\n263\t        stamp = datetime.strptime(at, \"%Y-%m-%dT%H:%M:%SZ\").replace(tzinfo=timezone.utc)\n264\t    except ValueError:\n265\t        return None\n266\t    return clock.now() - stamp.timestamp()\n267\t\n268\t\n269\tdef invocations_without_record(item_records_dir: Path) -> list[tuple[Path, dict[str, Any]]]:\n270\t    \"\"\"Every <stage>-NN.started under one item whose <stage>-NN.json has\n271\t    not arrived, with the marker's own dict ({} when unreadable).\"\"\"\n272\t    out: list[tuple[Path, dict[str, Any]]] = []\n273\t    if not item_records_dir.is_dir():\n274\t        return out\n275\t    for marker in sorted(item_records_dir.glob(f\"*{INVOCATION_MARKER_SUFFIX}\")):\n276\t        if (item_records_dir / f\"{marker.stem}.json\").is_file():\n277\t            continue\n278\t        try:\n279\t            with marker.open() as fh:\n280\t                info = json.load(fh)\n281\t        except (OSError, ValueError):\n282\t            info = {}\n283\t        out.append((marker, info if isinstance(info, dict) else {}))\n284\t    return out\n285\t\n286\t\n287\tdef stall_bound_s(m: dict[str, Any]) -> int | None:\n288\t    \"\"\"[drive].stall_after_s: the tenant's own bound past which a live\n289\t    invocation with no new event is hung. A bound the tenant did not\n290\t    write is a forecast, so there is no default.\"\"\"\n291\t    bound = (m.get(\"drive\") or {}).get(\"stall_after_s\")\n292\t    if isinstance(bound, bool) or not isinstance(bound, (int, float)) or bound <= 0:\n293\t        return None\n294\t    return int(bound)\n295\t\n296\t\n297\tdef ceiling_s(m: dict[str, Any], stage: str) -> int | None:\n298\t    \"\"\"R3: [drive.<stage>].ceiling_s, the wall clock past which a live\n299\t    invocation of that stage is hung by its ceiling, whatever event age\n300\t    says (or does not say, for an adapter that streams none). No\n301\t    default: a ceiling the tenant did not declare is not assumed.\"\"\"\n302\t    value = ((m.get(\"drive\") or {}).get(stage) or {}).get(\"ceiling_s\")\n303\t    if isinstance(value, bool) or not isinstance(value, (int, float)) or value <= 0:\n304\t        return None\n305\t    return int(value)\n306\t\n307\t\n308\tdef attempts_budget(m: dict[str, Any]) -> int:\n309\t    \"\"\"R3: [drive].attempts, the attempts a stage may spend -- across a\n310\t    plain retry, a returned retry, and a steered one alike -- before the\n311\t    item is a person's; 3 when the manifest does not say.\"\"\"\n312\t    value = (m.get(\"drive\") or {}).get(\"attempts\")\n313\t    if isinstance(value, bool) or not isinstance(value, int) or value < 1:\n314\t        return 3\n315\t    return value\n316\t\n317\t\n318\tdef retry_after_s(m: dict[str, Any]) -> int:\n319\t    \"\"\"R3: [drive].retry_after_s, the wait a transient stop's record sits\n320\t    through before its next attempt starts; 300 when the manifest does\n321\t    not say.\"\"\"\n322\t    value = (m.get(\"drive\") or {}).get(\"retry_after_s\")\n323\t    if isinstance(value, bool) or not isinstance(value, (int, float)) or value < 0:\n324\t        return 300\n325\t    return int(value)\n326\t\n327\t\n328\tdef proof_no_invocation_lacks_record(root: Path, m: dict[str, Any] | None) -> Proof:\n329\t    import socket\n330\t    p = Proof(\"no-invocation-lacks-record\", \"no invocation lacks its record\")\n331\t    if m is None:\n332\t        return p.fail(f\"no {MANIFEST} at {root}; no records directory is declared\")\n333\t    records_rel = m.get(\"paths\", {}).get(\"records\", \"\")\n334\t    records_dir = root / records_rel\n335\t    if not records_dir.is_dir():\n336\t        return p.fail(f\"no records directory under {records_dir}\")\n337\t    bound = stall_bound_s(m)\n338\t    if bound is None:\n339\t        return p.fail(\"no [drive].stall_after_s in the manifest; a hung invocation cannot be \"\n340\t                      \"told from a running one\")\n341\t    # R3: a stage with no ceiling can run forever unjudged even when\n342\t    # stall_after_s is set (an adapter that streams no events trips no\n343\t    # stall bound at all) -- refused the same way stall_after_s's own\n344\t    # absence is, not folded into it, so the reason names exactly which\n345\t    # keys the manifest is missing.\n346\t    missing_ceilings = [f\"[drive.{stage}].ceiling_s\" for stage in (\"build\", \"verify\")\n347\t                        if ceiling_s(m, stage) is None]\n348\t    if missing_ceilings:\n349\t        return p.fail(f\"no {' or '.join(missing_ceilings)} in the manifest; a stage with no \"\n350\t                      f\"ceiling can run forever unjudged (R3)\")\n351\t    if (m.get(\"drive\") or {}).get(\"attempts\") is None:\n352\t        return p.fail(\"no [drive].attempts in the manifest; a retryable stop would spend an \"\n353\t                      \"unbounded number of attempts (R3)\")\n354\t    this_host = socket.gethostname()\n355\t    recorded = 0\n356\t    running: list[str] = []\n357\t    in_flight: list[str] = []\n358\t    problems: list[str] = []\n359\t    for item_dir in sorted(d for d in records_dir.iterdir() if d.is_dir()):\n360\t        for marker in item_dir.glob(f\"*{INVOCATION_MARKER_SUFFIX}\"):\n361\t            if (item_dir / f\"{marker.stem}.json\").is_file():\n362\t                recorded += 1\n363\t        for marker, info in invocations_without_record(item_dir):\n364\t            name = f\"item {item_dir.name} {marker.stem}\"\n365\t            stage, nn_text = marker.stem.rsplit(\"-\", 1)\n366\t            try:\n367\t                beat_file = holder_heartbeat_path(root, info, stage, int(nn_text))\n368\t                beat_age = heartbeat_age_s(beat_file) if beat_file is not None else None\n369\t            except (RuntimeError, ValueError):\n370\t                beat_file, beat_age = None, None\n371\t            if beat_age is not None:\n372\t                # The holder's own fact: fresh within three beats is\n373\t                # running, older is a holder that stopped touching it.\n374\t                if beat_age <= heartbeat_s() * 3:\n375\t                    running.append(f\"{name} (heartbeat {int(beat_age)} s old, since {info.get('at')})\")\n376\t                    continue\n377\t            elif info.get(\"host\") != this_host or info.get(\"events\"):\n378\t                # No heartbeat readable for a marker from another host, or\n379\t                # none yet where a marker from this host says its holder\n380\t                # beats (another checkout's worker not yet at its first\n381\t                # beat): not yet a failure. An invocation younger than the\n382\t                # tenant's own stall bound may simply be running, still\n383\t                # writing toward its own record.\n384\t                age = invocation_age_s(info)\n385\t                if age is not None and age < bound:\n386\t                    in_flight.append(f\"{name} (host {info.get('host')} since {info.get('at')})\")\n387\t                    continue\n388\t            problems.append(f\"{name} started {info.get('at')} on {info.get('host')} \"\n389\t                            f\"and never wrote its record\")\n390\t    if problems:\n391\t        return p.fail(\"; \".join(problems), unrecorded_invocations=len(problems),\n392\t                      running_invocations=running, in_flight=in_flight)\n393\t    return p.hold(f\"{recorded} invocation(s) recorded, {len(running)} running, \"\n394\t                  f\"{len(in_flight)} in flight elsewhere\",\n395\t                  unrecorded_invocations=0, running_invocations=running, in_flight=in_flight)\n396\t\n397\t\n398\tdef proof_one_item_every_stage(root: Path, m: dict[str, Any] | None) -> Proof:\n399\t    p = Proof(\"one-item-every-stage\", \"one item has traversed every stage\")\n400\t    if m is None:\n401\t        return p.fail(f\"no {MANIFEST} at {root}; no records directory is declared\")\n402\t    records_rel = m.get(\"paths\", {}).get(\"records\", \"\")\n403\t    records_dir = root / records_rel\n404\t    items = load_records(records_dir)\n405\t    if not items:\n406\t        return p.fail(f\"no work item under {records_dir.relative_to(root)}\")\n407\t    complete = [item for item, stages in items.items() if all(s in stages for s in STAGES)]\n408\t    if not complete:\n409\t        best = max(items.items(), key=lambda kv: len(kv[1]))\n410\t        lacking = [s for s in STAGES if s not in best[1]]\n411\t        return p.fail(f\"no item carries every stage; item {best[0]} lacks {', '.join(lacking)}\")\n412\t\n413\t    # issue #74: a complete item is counted only when its chain holds --\n414\t    # attavo attest refuses a build re-approved after the fact or a\n415\t    # verify whose build went stale, and the coherence gate refuses the\n416\t    # merge group on exactly that; a proof that never asked would call a\n417\t    # traversal the gate itself would not let through. The refusal text\n418\t    # is check_attest_chain's own, never re-typed here.\n419\t    refused, held, unmerged = [], [], []\n420\t    for item in complete:\n421\t        chain, message = check_attest_chain(records_dir / item, item)\n422\t        if chain is None:\n423\t            refused.append(f\"item {item}: {message}\")\n424\t            continue\n425\t        merge_sha, merge_refusal = merge_introducing_records(root, records_rel, item, STAGES)\n426\t        if merge_refusal:\n427\t            return p.fail(merge_refusal)\n428\t        if merge_sha:\n429\t            held.append((item, merge_sha))\n430\t        else:\n431\t            unmerged.append(item)\n432\t\n433\t    if held:\n434\t        names = \", \".join(item for item, _ in held)\n435\t        shas = \", \".join(sha[:12] for _, sha in held)\n436\t        return p.hold(f\"item(s) {names} carry {', '.join(STAGES)} with the chain held, \"\n437\t                      f\"merged at {shas}\")\n438\t    if refused:\n439\t        return p.fail(\"; \".join(refused))\n440\t    return p.fail(f\"item(s) {', '.join(unmerged)} carry every stage with the chain held but no \"\n441\t                  f\"merge commit's first-parent diff introduces all of them\")\n442\t\n443\t\n444\tdef commit_subject(root: Path, sha: str) -> str:\n445\t    return git(root, \"log\", \"-1\", \"--format=%s\", sha).strip()\n446\t\n447\t\n448\tdef touches_boundary(root: Path, sha: str, boundary_paths: list[str]) -> bool:\n449\t    \"\"\"Whether sha's first-parent diff touches a path [spec.boundary].paths\n450\t    declares governed -- an ordinary merge that does is a boundary\n451\t    evasion (issue #72): the tenant carried a governed change around the\n452\t    path the manifest itself names.\"\"\"\n453\t    diff = git(root, \"diff\", \"--name-only\", f\"{sha}^1\", sha).splitlines()\n454\t    return any(fnmatch.fnmatch(path, pattern) for path in diff for pattern in boundary_paths)\n455\t\n456\t\n457\tclass WindowRefused(Exception):\n458\t    \"\"\"The window start cannot be computed; str(exc) is the refusal.\"\"\"\n459\t\n460\t\n461\tdef proof_window_start(root: Path, m: dict[str, Any]) -> tuple[str, str, list[str]]:\n462\t    \"\"\"(install commit, window start, first-parent chain after the install\n463\t    commit): where proofs three and six start reading. The start is\n464\t    [doctor].from if the tenant set it, otherwise the commit that\n465\t    introduced the manifest (issue #192: proof six reads this too, so the\n466\t    two proofs cannot disagree).\"\"\"\n467\t    try:\n468\t        install = git(root, \"log\", \"--diff-filter=A\", \"--format=%H\",\n469\t                      \"--reverse\", \"--\", MANIFEST).split()\n470\t    except RuntimeError as exc:\n471\t        raise WindowRefused(f\"git: {exc}\") from exc\n472\t    if not install:\n473\t        raise WindowRefused(f\"{MANIFEST} is not committed; the tenant has no record boundary\")\n474\t    install_sha = install[0]\n475\t    full_chain = git(root, \"rev-list\", f\"{install_sha}..HEAD\", \"--first-parent\").split()\n476\t\n477\t    # issue #74: [doctor] from lets a tenant declare the doctor's read to\n478\t    # start at a later commit on main's first-parent line -- the point\n479\t    # after which every push arrived through the queue -- rather than the\n480\t    # install commit, which on a repository that adopted the product\n481\t    # after its history began is a boundary the doctor cannot otherwise\n482\t    # see. Any spelling git resolves is accepted (a short sha, a tag, a\n483\t    # ref) -- resolved with rev-parse --verify before the first-parent\n484\t    # check runs, so the two failure modes stay distinct: a spelling that\n485\t    # names no commit at all, and a commit that names one off the line.\n486\t    # Checked, not trusted: neither is silently forgiven back to install.\n487\t    declared_from = (m.get(\"doctor\") or {}).get(\"from\")\n488\t    window_start = install_sha\n489\t    if declared_from is not None:\n490\t        try:\n491\t            resolved_from = git(root, \"rev-parse\", \"--verify\", f\"{declared_from}^{{commit}}\").strip()\n492\t        except RuntimeError:\n493\t            raise WindowRefused(f\"[doctor] from {declared_from} does not resolve to a commit\") from None\n494\t        if resolved_from != install_sha and resolved_from not in full_chain:\n495\t            raise WindowRefused(f\"[doctor] from {declared_from} is not on main's first-parent \"\n496\t                                f\"line after the install commit {install_sha[:12]}\")\n497\t        window_start = resolved_from\n498\t    return install_sha, window_start, full_chain\n499\t\n500\t\n501\tdef proof_no_commit_lacks_record(root: Path, m: dict[str, Any] | None) -> Proof:\n502\t    p = Proof(\"no-commit-lacks-record\", \"no commit lacks a record\")\n503\t    if m is None:\n504\t        return p.fail(f\"no {MANIFEST} at {root}; the tenant has no record boundary\")\n505\t    try:\n506\t        install_sha, window_start, full_chain = proof_window_start(root, m)\n507\t    except WindowRefused as exc:\n508\t        return p.fail(str(exc))\n509\t    if not full_chain:\n510\t        return p.fail(f\"no commit after the install commit {install_sha[:12]}; nothing has been recorded\")\n511\t\n512\t    if window_start == install_sha:\n513\t        window_spec = f\"{install_sha}..HEAD\"\n514\t        commits = full_chain\n515\t    else:\n516\t        window_spec = f\"{window_start}^..HEAD\"\n517\t        commits = git(root, \"rev-list\", window_spec, \"--first-parent\").split()\n518\t    before_window = len(full_chain) - len(commits)\n519\t\n520\t    records_rel = m.get(\"paths\", {}).get(\"records\", \"\")\n521\t    records_dir = root / records_rel\n522\t    named: set[str] = set()\n523\t    for stages in load_records(records_dir).values():\n524\t        for rec in stages.values():\n525\t            sha = rec.get(\"sha\")\n526\t            if isinstance(sha, str):\n527\t                named.add(sha)\n528\t            for c in rec.get(\"commits\", []) or []:\n529\t                if isinstance(c, str):\n530\t                    named.add(c)\n531\t    record_commits = set(git(root, \"rev-list\", window_spec, \"--first-parent\",\n532\t                             \"--\", records_rel).split()) if records_rel else set()\n533\t    merges = set(git(root, \"rev-list\", window_spec, \"--first-parent\", \"--merges\").split())\n534\t    boundary_paths = ((m.get(\"spec\") or {}).get(\"boundary\") or {}).get(\"paths\") or []\n535\t\n536\t    # Every first-parent commit in the window is exactly one of three\n537\t    # (issue #72): recorded (a record names it, or its diff touches\n538\t    # paths.records), ordinary (a merge that doesn't), or unrecorded\n539\t    # (anything else -- on a protected main with a queue, a non-merge\n540\t    # commit is the only way a change arrives without the forge).\n541\t    recorded, ordinary, unrecorded = [], [], []\n542\t    ordinary_commits, unrecorded_commits = [], []\n543\t    boundary_evasions = 0\n544\t    for c in commits:\n545\t        if c in named or c in record_commits:\n546\t            recorded.append(c)\n547\t        elif c in merges:\n548\t            ordinary.append(c)\n549\t            evasion = bool(boundary_paths and touches_boundary(root, c, boundary_paths))\n550\t            if evasion:\n551\t                boundary_evasions += 1\n552\t            ordinary_commits.append({\"sha\": c, \"subject\": commit_subject(root, c),\n553\t                                     \"boundary_evasion\": evasion})\n554\t        else:\n555\t            unrecorded.append(c)\n556\t            unrecorded_commits.append({\"sha\": c, \"subject\": commit_subject(root, c)})\n557\t\n558\t    not_transport = driver_commits_not_transport(root, window_spec, records_rel) if records_rel else []\n559\t    counts = f\"{len(recorded)} recorded, {len(ordinary)} ordinary, {len(unrecorded)} unrecorded\"\n560\t    evasions = boundary_evasions if boundary_paths else \"n/a\"\n561\t    extra = {\"recorded\": len(recorded), \"ordinary\": len(ordinary),\n562\t             \"unrecorded\": len(unrecorded), \"boundary_evasions\": evasions,\n563\t             \"before_window\": before_window,\n564\t             \"ordinary_commits\": ordinary_commits, \"unrecorded_commits\": unrecorded_commits,\n565\t             \"driver_commits_not_transport\": not_transport}\n566\t    if not_transport:\n567\t        return p.fail(f\"a driver commit is not a records transport: {not_transport[0]}; {counts}\", **extra)\n568\t    if unrecorded:\n569\t        return p.fail(f\"{unrecorded[-1][:12]} lacks a record; {counts}; boundary evasions: \"\n570\t                      f\"{evasions}; before the window: {before_window}\", **extra)\n571\t    return p.hold(f\"{counts}; boundary evasions: {evasions}; before the window: {before_window}\",\n572\t                  **extra)\n573\t\n574\t\n575\tdef driver_commits_not_transport(root: Path, window_spec: str, records_rel: str) -> list[str]:\n576\t    \"\"\"Every commit in the window authored as driver_identity() that is not\n577\t    a records transport: more than one parent, or a path outside\n578\t    <records>/<N>/ for the one item N it touches. The driver's commits\n579\t    carry records and nothing else, one parent each (root cause 1: the\n580\t    driver makes them in a detached worktree and never merges), so one\n581\t    that does either was made by something other than the transport.\n582\t    Each entry reads `<sha12> <why>`.\"\"\"\n583\t    email = driver_identity()[\"email\"]\n584\t    bad: list[str] = []\n585\t    prefix = records_rel.strip(\"/\") + \"/\"\n586\t    out = git(root, \"log\", window_spec, \"--format=%H\\x1f%ae\\x1f%P\")\n587\t    for line in out.splitlines():\n588\t        sha, author, parents = line.split(\"\\x1f\")\n589\t        if author != email:\n590\t            continue\n591\t        if len(parents.split()) > 1:\n592\t            bad.append(f\"{sha[:12]} is a merge\")\n593\t            continue\n594\t        paths = git(root, \"diff-tree\", \"--no-commit-id\", \"--name-only\", \"-r\", \"--root\", sha).splitlines()\n595\t        items = {p[len(prefix):].split(\"/\", 1)[0] for p in paths if p.startswith(prefix) and \"/\" in p[len(prefix):]}\n596\t        outside = [p for p in paths if not (p.startswith(prefix) and \"/\" in p[len(prefix):])]\n597\t        if outside:\n598\t            bad.append(f\"{sha[:12]} touches {outside[0]}, outside its item's records\")\n599\t        elif len(items) > 1:\n600\t            bad.append(f\"{sha[:12]} touches the records of items {', '.join(sorted(items))}\")\n601\t    return bad\n602\t\n603\t\n604\tADAPTER_EXIT_RE = re.compile(r\"^\\[adapter exited \\d+\\]$\")\n605\t\n606\t_JSON_LINE_PARSE_FAILED = object()\n607\t\n608\t\n609\tdef _parse_json_line(text: str) -> Any:\n610\t    \"\"\"A line's own parsed JSON value, or the sentinel\n611\t    _JSON_LINE_PARSE_FAILED when it does not parse -- the one call site\n612\t    in this file for a defensive, line-at-a-time JSON parse, shared by\n613\t    proof four's own tool-error check below (any valid JSON satisfies\n614\t    it) and an events line's own `at` read (issue #151, which further\n615\t    requires a dict). A dedicated sentinel, not None: a line that is\n616\t    the literal JSON value null parses successfully and must read as\n617\t    such, not as a failure.\"\"\"\n618\t    try:\n619\t        return json.loads(text)\n620\t    except ValueError:\n621\t        return _JSON_LINE_PARSE_FAILED\n622\t\n623\t\n624\tdef _log_owes_tool_error(log: str | None) -> bool:\n625\t    \"\"\"True when a log's last non-empty line is exactly an adapter-exit\n626\t    marker and every line before it parses as JSON -- an adapter's own\n627\t    event stream, never a tool's own words (issue #94's own specimen,\n628\t    tenant zero's attest/records/659/verify-01.log: codex's\n629\t    \"thread.started\" event, then nothing but \"[adapter exited 1]\" -- the\n630\t    tool's real error line dropped before this reached the log, issue\n631\t    #86's own bug in split_adapter_stdout). A log that is only the exit\n632\t    marker, nothing before it at all, still owes the same line. An\n633\t    `error` event with a non-empty string `message` is the tool's own\n634\t    error delivered as an event (issue #200: \"Selected model is at\n635\t    capacity\"), so it owes nothing. So is an API error the tool reports as\n636\t    its own assistant message -- Claude Code's `\"is_api_error_message\":\n637\t    true` event, whose text is the tool's words (\"Failed to authenticate:\n638\t    OAuth session expired and could not be refreshed\", item 267 build-01\n639\t    and build-02, 2026-09-30) -- when that text is non-empty.\"\"\"\n640\t    if not log:\n641\t        return False\n642\t    lines = [l for l in log.splitlines() if l.strip()]\n643\t    if not lines or not ADAPTER_EXIT_RE.match(lines[-1]):\n644\t        return False\n645\t    for l in lines[:-1]:\n646\t        parsed = _parse_json_line(l)\n647\t        if parsed is _JSON_LINE_PARSE_FAILED:\n648\t            return False\n649\t        if isinstance(parsed, dict) and parsed.get(\"type\") == \"error\":\n650\t            message = parsed.get(\"message\")\n651\t            if isinstance(message, str) and message:\n652\t                return False\n653\t        if isinstance(parsed, dict) and parsed.get(\"is_api_error_message\") is True:\n654\t            if _api_error_text(parsed):\n655\t                return False\n656\t    return True\n657\t\n658\t\n659\tdef _api_error_text(event: dict[str, Any]) -> str:\n660\t    \"\"\"The text of an API error an adapter's tool delivered as its own\n661\t    assistant message: the non-empty text blocks of message.content,\n662\t    joined. Empty when there is none, which owes the line still.\"\"\"\n663\t    message = event.get(\"message\")\n664\t    content = message.get(\"content\") if isinstance(message, dict) else None\n665\t    if not isinstance(content, list):\n666\t        return \"\"\n667\t    texts = [b.get(\"text\") for b in content\n668\t             if isinstance(b, dict) and b.get(\"type\") == \"text\" and isinstance(b.get(\"text\"), str)]\n669\t    return \" \".join(t.strip() for t in texts if t and t.strip())\n670\t\n671\t\n672\tdef proof_no_stop_lacks_cause(root: Path, m: dict[str, Any] | None) -> Proof:\n673\t    p = Proof(\"no-stop-lacks-cause\", \"no stop lacks its cause\")\n674\t    if m is None:\n675\t        return p.fail(f\"no {MANIFEST} at {root}; no records directory is declared\")\n676\t    records_rel = m.get(\"paths\", {}).get(\"records\", \"\")\n677\t    records_dir = root / records_rel\n678\t    if not records_dir.is_dir():\n679\t        return p.fail(f\"no records directory under {records_dir}\")\n680\t\n681\t    # issue #89's own window lesson, proof three's already: a record\n682\t    # before record_version 3 has no stop by construction (schema\n683\t    # versions 1 and 2 predate it) -- counted here, never refused.\n684\t    older = 0\n685\t    checked = 0\n686\t    before_rederivable = 0\n687\t    problems: list[str] = []\n688\t    for item_dir in sorted(d for d in records_dir.iterdir() if d.is_dir()):\n689\t        for stage in STOP_STAGES:\n690\t            for n, rec in sorted(parse_attempts(item_dir, stage).items()):\n691\t                if rec.get(\"record_version\", 1) < 3:\n692\t                    older += 1\n693\t                    continue\n694\t                if rec.get(\"status\") == \"pass\":\n695\t                    continue\n696\t                checked += 1\n697\t                name = f\"{stage}-{n:02d}\"\n698\t                rederivable = rec.get(\"record_version\", 1) >= STOP_REDERIVABLE_FROM[stage]\n699\t                if not rederivable:\n700\t                    before_rederivable += 1\n701\t                stop = rec.get(\"stop\")\n702\t                if not stop:\n703\t                    problems.append(f\"item {item_dir.name} {name} carries no stop\")\n704\t                    continue\n705\t                cls, provenance = stop.get(\"class\"), stop.get(\"provenance\")\n706\t                if cls not in STOP_CLASSES:\n707\t                    problems.append(f\"item {item_dir.name} {name} stop.class {cls!r} names \"\n708\t                                    f\"no enumerated class\")\n709\t                    continue\n710\t                if provenance not in STOP_PROVENANCES:\n711\t                    problems.append(f\"item {item_dir.name} {name} stop.provenance \"\n712\t                                    f\"{provenance!r} names no enumerated provenance\")\n713\t                    continue\n714\t                # Issue #254: at the version that stores what the stop was\n715\t                # derived from, the stop is that function's value -- the\n716\t                # pass's own recovery records by their own rule.\n717\t                if rederivable and is_recovery_stop(rec):\n718\t                    fault = recovery_fault(rec)\n719\t                    if fault:\n720\t                        problems.append(f\"item {item_dir.name} {name} {fault}\")\n721\t                        continue\n722\t                elif rederivable:\n723\t                    derived = rederive_stop(stage, rec)\n724\t                    if derived is None or (derived[\"class\"], derived[\"provenance\"]) != (cls, provenance):\n725\t                        problems.append(\n726\t                            f\"item {item_dir.name} {name} stop is {cls}/{provenance} but its \"\n727\t                            f\"own fields derive \"\n728\t                            f\"{'no stop' if derived is None else derived['class'] + '/' + derived['provenance']}\")\n729\t                        continue\n730\t                if cls == \"unclassed\" and not stop.get(\"detail\"):\n731\t                    problems.append(f\"item {item_dir.name} {name} is unclassed with no detail\")\n732\t                    continue\n733\t                log_path = item_dir / f\"{name}.log\"\n734\t                log = log_path.read_text() if log_path.is_file() else None\n735\t                # Issue #89, rejection test 1's own specimen (tenant\n736\t                # zero's #659 build-01): a failed build that actually ran\n737\t                # the gates -- selected_tests is set only once cmd_build\n738\t                # reaches them -- owes their heading in the log, whatever\n739\t                # else stop already says.\n740\t                if (stage == \"build\" and rec.get(\"status\") == \"failed\"\n741\t                        and rec.get(\"selected_tests\") is not None\n742\t                        and \"--- attavo gates, iteration\" not in (log or \"\")):\n743\t                    problems.append(f\"item {item_dir.name} {name} failed after the gates ran \"\n744\t                                    f\"but its log carries no gates heading\")\n745\t                    continue\n746\t                if _log_owes_tool_error(log):\n747\t                    problems.append(f\"item {item_dir.name} {name}'s log ends in an adapter \"\n748\t                                    f\"exit with nothing before it but event lines; the tool's \"\n749\t                                    f\"own error line is owed\")\n750\t\n751\t        # issue #137: a refused spec-gate record is a stop too, class\n752\t        # \"gate\" -- synthesized the same way item_stops and\n753\t        # cmd_file_stops already read it, since cmd_spec_gate itself\n754\t        # carries no stop field to check for one. No record_version\n755\t        # gate here: unlike build/verify's own stop field, gate is never\n756\t        # persisted, so there is no older shape that predates it.\n757\t        for n, rec in sorted(parse_attempts(item_dir, \"spec\").items()):\n758\t            if rec.get(\"status\") != \"refused\":\n759\t                continue\n760\t            checked += 1\n761\t            name = f\"spec-{n:02d}\"\n762\t            stop = gate_stop(rec.get(\"refusal\"))\n763\t            cls, provenance = stop[\"class\"], stop[\"provenance\"]\n764\t            if cls not in STOP_CLASSES:\n765\t                problems.append(f\"item {item_dir.name} {name} stop.class {cls!r} names \"\n766\t                                f\"no enumerated class\")\n767\t                continue\n768\t            if provenance not in STOP_PROVENANCES:\n769\t                problems.append(f\"item {item_dir.name} {name} stop.provenance \"\n770\t                                f\"{provenance!r} names no enumerated provenance\")\n771\t                continue\n772\t            if not stop.get(\"detail\"):\n773\t                problems.append(f\"item {item_dir.name} {name} is a gate stop with no cause\")\n774\t\n775\t    older_note = (f\"{older} record(s) before stop was recorded; {before_rederivable} non-pass \"\n776\t                 f\"record(s) before their stop could be re-derived\")\n777\t    if problems:\n778\t        return p.fail(\"; \".join(problems), older_records=older,\n779\t                     before_rederivable=before_rederivable)\n780\t    return p.hold(f\"{checked} checked ({older_note})\" if checked == 0\n781\t                 else f\"{checked} non-pass record(s) carry stop with a cause ({older_note})\",\n782\t                 older_records=older, before_rederivable=before_rederivable)\n783\t\n784\t\n785\tdef attestation_command(m: dict[str, Any]) -> str | None:\n786\t    \"\"\"[forge].attestation_command: the tenant's own read of the store,\n787\t    given a merge sha on stdin, printing the statement as JSON on exit 0\n788\t    and nothing on a non-zero exit. Absent is not passing (issue #158:\n789\t    the doctor said done while #106, #148, #153 had no statement in the\n790\t    store at all -- there was no key to read one through).\"\"\"\n791\t    cmd = (m.get(\"forge\") or {}).get(\"attestation_command\")\n792\t    return cmd if isinstance(cmd, str) and cmd.strip() else None\n793\t\n794\t\n795\tdef statement_for(root: Path, cmd: str, merge_sha: str) -> tuple[dict[str, Any] | None, int]:\n796\t    \"\"\"The statement the forge holds for merge_sha and the command's exit\n797\t    code. The statement is None when the command exits non-zero or prints\n798\t    anything but a JSON object -- exit 2 means the store itself could not\n799\t    be read (issue #158, amended after build-05: distinct from exit 1,\n800\t    the store read fine and simply held no statement).\"\"\"\n801\t    run = subprocess.run(cmd, shell=True, cwd=str(root), input=merge_sha + \"\\n\",\n802\t                         capture_output=True, text=True, check=False)\n803\t    if run.returncode != 0:\n804\t        return None, run.returncode\n805\t    try:\n806\t        parsed = json.loads(run.stdout)\n807\t    except ValueError:\n808\t        return None, run.returncode\n809\t    return (parsed if isinstance(parsed, dict) else None), run.returncode\n810\t\n811\t\n812\tdef _is_ancestor(root: Path, earlier: str, later: str) -> bool:\n813\t    run = subprocess.run([\"git\", \"-C\", str(root), \"merge-base\", \"--is-ancestor\", earlier, later],\n814\t                         capture_output=True, check=False, env=git_env())\n815\t    return run.returncode == 0\n816\t\n817\t\n818\t# Maps whose keys are the records' data (a stage or an adapter that cost\n819\t# something), not a release's fields: a key missing from one is a difference.\n820\tDATA_KEYED = (\"by_stage_usd\", \"by_adapter_usd\")\n821\t\n822\t\n823\tdef _same(stated: Any, summed: Any) -> bool:\n824\t    \"\"\"Equal as the accounting means it: a number equals a number of the\n825\t    same value (a store may print 40.0 as 40), a bool equals only a bool,\n826\t    and a list is equal member by member. No tolerance and no conversion:\n827\t    both sides are the same function's rounding of the same records, and an\n828\t    int one past 2**53 is not the float beside it.\"\"\"\n829\t    if isinstance(stated, bool) or isinstance(summed, bool):\n830\t        return isinstance(stated, bool) and isinstance(summed, bool) and stated == summed\n831\t    if isinstance(stated, (int, float)) and isinstance(summed, (int, float)):\n832\t        return bool(stated == summed)\n833\t    if isinstance(stated, list) and isinstance(summed, list):\n834\t        return len(stated) == len(summed) and all(_same(a, b) for a, b in zip(stated, summed))\n835\t    return type(stated) is type(summed) and bool(stated == summed)\n836\t\n837\t\n838\tdef _differences(path: str, stated: Any, summed: Any, keyed_by_data: bool = False) -> list[str]:\n839\t    \"\"\"Every field of `stated` that is not what its records sum to, named by\n840\t    its path. Only the keys the statement carries are compared, at every\n841\t    depth, so a field a later release adds is not demanded of a statement\n842\t    sealed before it; a key it carries that the function does not produce\n843\t    is a difference.\"\"\"\n844\t    if not (isinstance(stated, dict) and isinstance(summed, dict)):\n845\t        return [] if _same(stated, summed) else [f\"{path} {stated!r} is not its records' {summed!r}\"]\n846\t    found: list[str] = []\n847\t    for key in sorted(stated):\n848\t        if key not in summed:\n849\t            found.append(f\"{path}.{key} {stated[key]!r} is not a field its records sum to\")\n850\t        else:\n851\t            found += _differences(f\"{path}.{key}\", stated[key], summed[key], key in DATA_KEYED)\n852\t    if keyed_by_data:\n853\t        found += [f\"{path}.{key} is absent; its records sum to {summed[key]!r}\"\n854\t                  for key in sorted(summed.keys() - stated.keys())]\n855\t    return found\n856\t\n857\t\n858\tdef _carried(predicate: dict[str, Any], key: str) -> str:\n859\t    return repr(predicate[key]) if key in predicate else \"absent\"\n860\t\n861\t\n862\tV3_ONLY_FIELDS = (\"cost_by_stage_usd\", \"wall_clock_by_stage_s\", \"tokens_by_stage\")\n863\t\n864\t\n865\tV5_COST_FIELDS = (\"reported_usd\", \"estimated_usd\", \"basis_by_stage\", \"rates\", \"estimate_note\")\n866\t\n867\t\n868\tdef _carries_act_sha(rows: Any) -> bool:\n869\t    \"\"\"True when `rows` is a non-empty list whose entries already carry\n870\t    `sha` -- v6's own shape for `acts` and `interventions` (issue #349);\n871\t    v5 and earlier wrote both as `[]`, never a sha.\"\"\"\n872\t    return isinstance(rows, list) and any(isinstance(r, dict) and \"sha\" in r for r in rows)\n873\t\n874\t\n875\tdef _predicate_version(statement: dict[str, Any], predicate: dict[str, Any]) -> int:\n876\t    \"\"\"The attestation version a statement was sealed under (issues #309,\n877\t    #307, #349): named by its envelope's predicateType, else known by what\n878\t    it carries -- v3 by the final-attempt fields v4 retired, v6 by a sha\n879\t    on an act or intervention row, v5 by the rates its cost block carries,\n880\t    v4 otherwise. Each is judged by its own rules; nothing sealed is\n881\t    rewritten.\"\"\"\n882\t    declared = statement.get(\"predicateType\")\n883\t    named = re.search(r\"/attestation/v(\\d+)$\", declared) if isinstance(declared, str) else None\n884\t    if named:\n885\t        return int(named.group(1))\n886\t    if any(key in predicate for key in V3_ONLY_FIELDS):\n887\t        return 3\n888\t    if _carries_act_sha(predicate.get(\"acts\")) or _carries_act_sha(predicate.get(\"interventions\")):\n889\t        return 6\n890\t    cost = predicate.get(\"cost\")\n891\t    return 5 if isinstance(cost, dict) and \"rates\" in cost else 4\n892\t\n893\t\n894\tdef _accounting_disagrees(root: Path, item_records_dir: Path, item: str, merge_sha: str,\n895\t                          statement: dict[str, Any],\n896\t                          merges: list[dict[str, Any]] | None = None) -> str | None:\n897\t    \"\"\"A sealed statement that carries `time` and `cost` (and, from v4,\n898\t    `tokens`; from v6, `acts` and `interventions`) says what its records sum\n899\t    to, field by field -- the same function attest summed them with, over\n900\t    the same records (none is written after a merge), sealed at the same\n901\t    commit (the statement is computed at the merge, so lead_s and\n902\t    waiting_s are recomputed from its committer time, not excepted). Exact:\n903\t    #202 retired the one-second tolerance. A statement sealed before `time`\n904\t    existed carries neither key and is not checked; a key that is present\n905\t    holds a block, so a null one, or one block without the other, is a\n906\t    disagreement. No new read of the store. merges, when given, is\n907\t    _merges_reachable's own result -- the caller's loop over every item\n908\t    computes it once rather than each item's acts and interventions\n909\t    walking the default branch's merges again.\"\"\"\n910\t    inner = statement.get(\"predicate\")\n911\t    predicate = inner if isinstance(inner, dict) else statement\n912\t    if \"time\" not in predicate and \"cost\" not in predicate:\n913\t        return None\n914\t    stated_time, stated_cost = predicate.get(\"time\"), predicate.get(\"cost\")\n915\t    where = f\"item {item} merged at {merge_sha[:12]}\"\n916\t    if not isinstance(stated_time, dict) or not isinstance(stated_cost, dict):\n917\t        return (f\"{where}: the statement's time and cost are not both blocks \"\n918\t                f\"(time is {_carried(predicate, 'time')}, cost is {_carried(predicate, 'cost')})\")\n919\t    try:\n920\t        sealed_at: int | None = int(git(root, \"show\", \"-s\", \"--format=%ct\", merge_sha).strip())\n921\t    except (RuntimeError, ValueError):\n922\t        sealed_at = None\n923\t    version = _predicate_version(statement, predicate)\n924\t    # v5 prices a record by the [cost.rates] the tenant's manifest declared\n925\t    # at the sealed commit, never by the rates the statement carries: the\n926\t    # carried block is then compared like any field, and a later edit to the\n927\t    # manifest cannot unseal anything. v3 and v4 priced nothing.\n928\t    rates: dict[str, Any] | None = None\n929\t    if version >= 5:\n930\t        try:\n931\t            declared = parse_manifest(git(root, \"show\", f\"{merge_sha}:{MANIFEST}\"))\n932\t        except (RuntimeError, ValueError) as exc:\n933\t            return (f\"{where}: the manifest {MANIFEST} cannot be read at the sealed commit, \"\n934\t                    f\"so a v5 statement's estimate cannot be checked ({exc})\")\n935\t        found = (declared.get(\"cost\") or {}).get(\"rates\")\n936\t        rates = found if isinstance(found, dict) else {}\n937\t    summed_time, summed_cost, summed_tokens = item_accounting(\n938\t        item_records_dir, sealed_at, rates)\n939\t    cost_now = {k: v for k, v in summed_cost.items() if version >= 5 or k not in V5_COST_FIELDS}\n940\t    if version < 5:  # v3 and v4 named the record, never the missing rate\n941\t        cost_now[\"not_read\"] = [n.split(\" (no [cost.rates]\")[0] for n in summed_cost[\"not_read\"]]\n942\t    differing = (_differences(\"time\", stated_time, dict(summed_time))\n943\t                 + _differences(\"cost\", stated_cost, cost_now))\n944\t    if version >= 4:\n945\t        stated_tokens = predicate.get(\"tokens\")\n946\t        if isinstance(stated_tokens, dict):\n947\t            differing += _differences(\"tokens\", stated_tokens, dict(summed_tokens))\n948\t        else:\n949\t            differing.append(f\"tokens is {_carried(predicate, 'tokens')}, not a block \"\n950\t                             f\"its records sum to {dict(summed_tokens)!r}\")\n951\t    if version >= 6:\n952\t        # Imported here, not at module level: attavo.ledger imports from\n953\t        # this module, a cycle resolved by deferring to call time.\n954\t        from attavo.ledger import item_acts_and_interventions\n955\t        summed_acts, summed_interventions = item_acts_and_interventions(\n956\t            root, declared, item, merges=merges)\n957\t        stated_acts, stated_interventions = predicate.get(\"acts\"), predicate.get(\"interventions\")\n958\t        if not (isinstance(stated_acts, list) and _same(stated_acts, summed_acts)):\n959\t            differing.append(f\"acts {stated_acts!r} is not its records' {summed_acts!r}\")\n960\t        if not (isinstance(stated_interventions, list) and _same(stated_interventions, summed_interventions)):\n961\t            differing.append(f\"interventions {stated_interventions!r} is not its \"\n962\t                             f\"records' {summed_interventions!r}\")\n963\t    if differing:\n964\t        return f\"{where}: the statement's \" + \"; \".join(differing)\n965\t    return None\n966\t\n967\t\n968\tdef proof_every_attested_item_is_sealed(root: Path, m: dict[str, Any] | None) -> Proof:\n969\t    p = Proof(\"every-attested-item-is-sealed\", \"every attested item has its statement in the store\")\n970\t    if m is None:\n971\t        return p.fail(f\"no {MANIFEST} at {root}; no records directory is declared\")\n972\t    cmd = attestation_command(m)\n973\t    if cmd is None:\n974\t        return p.fail(\"no [forge].attestation_command in the manifest; the store cannot be read\")\n975\t    records_rel = m.get(\"paths\", {}).get(\"records\", \"\")\n976\t    records_dir = root / records_rel\n977\t    if not records_dir.is_dir():\n978\t        return p.fail(f\"no records directory under {records_dir}\")\n979\t    items = load_records(records_dir)\n980\t    complete = [item for item, stages in sorted(items.items()) if all(s in stages for s in STAGES)]\n981\t\n982\t    # [forge].sealed_since: merges at or before this commit are before the\n983\t    # window -- the tenant could not seal them (no queue,
{"type":"assistant","message":{"model":"claude-sonnet-5","id":"msg_011Cg2imL9Y4LqsxNdHfmhhH","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01YF6Fg2yCkptcWXha853xaM","name":"Read","input":{"file_path":"/Users/davidbean/Projects/attavo-worktree-353/tests/test_attest_time.py","offset":1,"limit":340},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1070,"cache_read_input_tokens":65805,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1070},"output_tokens":14,"service_tier":"standard","inference_geo":"global"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"8b358cc5-0655-4274-9562-475abdbf906d","uuid":"d21d3ee2-b3e9-489b-a7e5-1e49c8a7799d","timestamp":"2026-10-14T19:58:12.118Z","request_id":"req_011Cg2imKoh6PptVQdJ58Zh5","wire_tool_inputs":{"toolu_01YF6Fg2yCkptcWXha853xaM":{"file_path":"/Users/davidbean/Projects/attavo-worktree-353/tests/test_attest_time.py","offset":1,"limit":340}}}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01YF6Fg2yCkptcWXha853xaM","type":"tool_result","content":"1\t\"\"\"The statement's `time` and `cost` blocks: every invocation of an item\n2\tsummed by `attavo attest` from the records it already reads, and doctor's\n3\tsixth proof holding the statement to those records.\n4\t\n5\tRegression, run red first on main at 1d2257b: the statement carried the\n6\tfinal attempt per stage and nothing else, so a view derived its own\n7\t\"product time\" -- 20 minutes for an item whose nineteen invocations ran\n8\t115 -- and no record said otherwise.\n9\t\n10\tRun: python3 -m pytest tests -q\n11\t\"\"\"\n12\tfrom __future__ import annotations\n13\t\n14\timport json\n15\timport subprocess\n16\timport sys\n17\tfrom pathlib import Path\n18\tfrom typing import Any\n19\t\n20\timport jsonschema\n21\t\n22\tfrom helpers import git\n23\t\n24\tROOT = Path(__file__).resolve().parent.parent\n25\tATTAVO = ROOT / \"bin\" / \"attavo\"\n26\tSCHEMA = json.loads((ROOT / \"schema\" / \"attestation.schema.json\").read_text())\n27\t\n28\t# (stage, attempt, wall_clock_s, cost_usd, adapter): three builds on one\n29\t# executor, two verifies and one counsel on another that reports no cost.\n30\tINVOCATIONS: list[tuple[str, int, float | None, float | None, str]] = [\n31\t    (\"build\", 1, 100.5, 0.25, \"alpha\"),\n32\t    (\"build\", 2, 200.0, 0.5, \"alpha\"),\n33\t    (\"build\", 3, 50.25, 0.125, \"alpha\"),\n34\t    (\"verify\", 1, 10.0, None, \"beta\"),\n35\t    (\"verify\", 2, 30.0, None, \"beta\"),\n36\t    (\"counsel\", 1, 7.5, None, \"beta\"),\n37\t]\n38\t\n39\t\n40\tdef run(root: Path, *args: str, stdin: str | None = None) -> subprocess.CompletedProcess[str]:\n41\t    return subprocess.run([sys.executable, str(ATTAVO), *args], cwd=str(root), input=stdin,\n42\t                          capture_output=True, text=True, check=False)\n43\t\n44\t\n45\tdef write(path: Path, obj: dict[str, Any]) -> None:\n46\t    path.parent.mkdir(parents=True, exist_ok=True)\n47\t    path.write_text(json.dumps(obj))\n48\t\n49\t\n50\tdef tokens_of(stage: str, n: int) -> dict[str, int]:\n51\t    \"\"\"A record's tokens, distinct per attempt so a sum cannot pass by luck.\"\"\"\n52\t    base = {\"build\": 1000, \"verify\": 500, \"counsel\": 200}[stage]\n53\t    return {\"input\": base * n, \"output\": base * n // 100}\n54\t\n55\t\n56\tdef make_item(tmp_path: Path, invocations: list[tuple[str, int, float | None, float | None, str]],\n57\t              tokenless: frozenset[str] = frozenset(), manifest_extra: str = \"\",\n58\t              models: dict[str, str] | None = None,\n59\t              tokens: dict[str, dict[str, int]] | None = None) -> tuple[Path, str]:\n60\t    \"\"\"A tenant with one item merged on main's first-parent line: spec and\n61\t    approval records, then every invocation in `invocations`, the chain\n62\t    coherent on the latest of each stage. Returns (root, merge sha).\"\"\"\n63\t    root = tmp_path / \"tenant\"\n64\t    root.mkdir(parents=True)\n65\t    git(root, \"init\", \"-q\", \"-b\", \"main\", \".\")\n66\t    git(root, \"config\", \"user.email\", \"fixture@attavo.invalid\")\n67\t    git(root, \"config\", \"user.name\", \"fixture\")\n68\t    (root / \"attavo.toml\").write_text(\n69\t        '[paths]\\nrecords = \"records\"\\nspecs = \"specs\"\\n\\n'\n70\t        '[forge]\\nattestation_command = \"sh ./fake-store\"\\n' + manifest_extra)\n71\t    (root / \"fake-store\").write_text(\n72\t        '#!/bin/sh\\nread sha\\ntest -f \"statements/$sha.json\" && cat \"statements/$sha.json\"\\n')\n73\t    git(root, \"add\", \"-A\")\n74\t    git(root, \"commit\", \"-q\", \"-m\", \"install\")\n75\t    git(root, \"checkout\", \"-q\", \"-b\", \"attavo/1-x\")\n76\t    rec = root / \"records\" / \"1\"\n77\t    write(rec / \"spec-01.json\", {\"status\": \"pass\", \"sha\": \"s1\", \"at\": \"2026-01-01T00:00:00Z\"})\n78\t    write(rec / \"approval-01.json\", {\"sha\": \"a1\", \"spec_sha\": \"s1\", \"at\": \"2026-01-01T00:00:00Z\"})\n79\t    for stage, n, wall, cost, adapter in invocations:\n80\t        body: dict[str, Any] = {\"status\": \"pass\", \"sha\": f\"{stage}{n}\", \"adapter\": adapter,\n81\t                                \"approval_sha\": \"a1\", \"cost_usd\": cost}\n82\t        if wall is not None:\n83\t            body[\"wall_clock_s\"] = wall\n84\t        name = f\"{stage}-{n:02d}\"\n85\t        if models and name in models:\n86\t            body[\"model\"] = models[name]\n87\t        if name not in tokenless:\n88\t            body[\"tokens\"] = (tokens or {}).get(name) or tokens_of(stage, n)\n89\t        if stage == \"verify\":\n90\t            last_build = max(i[1] for i in invocations if i[0] == \"build\")\n91\t            body[\"build_sha\"] = f\"build{last_build}\"\n92\t        write(rec / f\"{stage}-{n:02d}.json\", body)\n93\t    git(root, \"add\", \"-A\")\n94\t    git(root, \"commit\", \"-q\", \"-m\", \"records for item 1\")\n95\t    git(root, \"checkout\", \"-q\", \"main\")\n96\t    git(root, \"merge\", \"-q\", \"--no-ff\", \"-m\", \"Merge branch 'attavo/1-x'\", \"attavo/1-x\")\n97\t    git(root, \"update-ref\", \"refs/remotes/origin/main\", \"main\")\n98\t    git(root, \"symbolic-ref\", \"refs/remotes/origin/HEAD\", \"refs/remotes/origin/main\")\n99\t    return root, git(root, \"rev-parse\", \"HEAD\").strip()\n100\t\n101\t\n102\tdef attest(root: Path) -> dict[str, Any]:\n103\t    done = run(root, \"attest\", \"1\")\n104\t    assert done.returncode == 0, done.stdout + done.stderr\n105\t    statement: dict[str, Any] = json.loads(done.stdout)\n106\t    return statement\n107\t\n108\t\n109\tdef proof_six(root: Path) -> dict[str, Any]:\n110\t    out = json.loads(run(root, \"doctor\", \"--json\", str(root)).stdout)\n111\t    found: dict[str, Any] = [p for p in out[\"proofs\"]\n112\t                             if p[\"proof\"] == \"every-attested-item-is-sealed\"][0]\n113\t    return found\n114\t\n115\t\n116\tdef test_attest_sums_every_invocation_per_stage_and_per_item(tmp_path: Path) -> None:\n117\t    root, _ = make_item(tmp_path, INVOCATIONS)\n118\t    statement = attest(root)\n119\t    jsonschema.validate(statement, SCHEMA)\n120\t    time = statement[\"time\"]\n121\t    assert time[\"build\"] == {\"attempts\": 3, \"invocation_s\": 350.75, \"partial\": False}\n122\t    assert time[\"verify\"] == {\"attempts\": 2, \"invocation_s\": 40.0, \"partial\": False}\n123\t    assert time[\"counsel\"] == {\"attempts\": 1, \"invocation_s\": 7.5, \"partial\": False}\n124\t    assert time[\"invocation_s\"] == 398.25\n125\t    assert time[\"partial\"] is False and time[\"not_read\"] == []\n126\t    # lead runs from approval-01's `at` to the merge's committer time\n127\t    merged_at = int(git(root, \"show\", \"-s\", \"--format=%ct\", \"HEAD\").strip())\n128\t    assert time[\"lead_s\"] == merged_at - 1767225600\n129\t    assert time[\"waiting_s\"] == round(time[\"lead_s\"] - 398.25, 3)\n130\t\n131\t\n132\tdef test_attest_names_a_record_without_wall_clock_and_never_sums_it_as_zero(tmp_path: Path) -> None:\n133\t    invocations = [i if i[:2] != (\"build\", 2) else (\"build\", 2, None, 0.5, \"alpha\")\n134\t                   for i in INVOCATIONS]\n135\t    root, _ = make_item(tmp_path, invocations)\n136\t    time = attest(root)[\"time\"]\n137\t    assert time[\"not_read\"] == [\"build-02\"]\n138\t    assert time[\"build\"][\"partial\"] is True and time[\"partial\"] is True\n139\t    assert time[\"build\"][\"attempts\"] == 3\n140\t    assert time[\"verify\"][\"partial\"] is False\n141\t\n142\t\n143\tdef test_attest_sums_cost_across_executors_and_says_when_the_total_is_partial(tmp_path: Path) -> None:\n144\t    root, _ = make_item(tmp_path, INVOCATIONS)\n145\t    cost = attest(root)[\"cost\"]\n146\t    assert cost[\"usd\"] == 0.875\n147\t    assert cost[\"by_stage_usd\"] == {\"build\": 0.875}\n148\t    assert cost[\"by_adapter_usd\"] == {\"alpha\": 0.875}\n149\t    assert cost[\"partial\"] is True\n150\t    assert cost[\"not_read\"] == [\"verify-01\", \"verify-02\", \"counsel-01\"]\n151\t\n152\t    priced = [i if i[3] is not None else (i[0], i[1], i[2], 0.0625, i[4]) for i in INVOCATIONS]\n153\t    root2, _ = make_item(tmp_path / \"priced\", priced)\n154\t    cost2 = attest(root2)[\"cost\"]\n155\t    assert cost2[\"usd\"] == 0.875 + 3 * 0.0625\n156\t    assert cost2[\"by_adapter_usd\"] == {\"alpha\": 0.875, \"beta\": 0.1875}\n157\t    assert cost2[\"partial\"] is False and cost2[\"not_read\"] == []\n158\t\n159\t\n160\tdef test_doctor_proof_six_fails_a_statement_whose_time_is_not_its_records(tmp_path: Path) -> None:\n161\t    root, merge = make_item(tmp_path, INVOCATIONS)\n162\t    statement = attest(root)\n163\t    store = root / \"statements\"\n164\t    store.mkdir()\n165\t    envelope = {\"_type\": \"https://in-toto.io/Statement/v1\", \"predicate\": statement}\n166\t    (store / f\"{merge}.json\").write_text(json.dumps(envelope))\n167\t    held = proof_six(root)\n168\t    assert held[\"holds\"] is True and held[\"sealed\"] == [\"1\"], held\n169\t\n170\t    statement[\"time\"][\"invocation_s\"] = 20.0\n171\t    (store / f\"{merge}.json\").write_text(json.dumps(envelope))\n172\t    failed = proof_six(root)\n173\t    assert failed[\"holds\"] is False, failed\n174\t    assert \"item 1\" in failed[\"reason\"] and \"time.invocation_s\" in failed[\"reason\"], failed\n175\t\n176\t    # a statement sealed before `time` and `cost` existed carries neither\n177\t    # and is not checked; one without the other is a disagreement (#203)\n178\t    del statement[\"time\"]\n179\t    del statement[\"cost\"]\n180\t    (store / f\"{merge}.json\").write_text(json.dumps(envelope))\n181\t    assert proof_six(root)[\"holds\"] is True\n182\t\n183\t\n184\tdef seal(root: Path, merge: str, statement: dict[str, Any],\n185\t         predicate_type: str | None = None) -> None:\n186\t    store = root / \"statements\"\n187\t    store.mkdir(exist_ok=True)\n188\t    envelope: dict[str, Any] = {\"_type\": \"https://in-toto.io/Statement/v1\", \"predicate\": statement}\n189\t    if predicate_type:\n190\t        envelope[\"predicateType\"] = predicate_type\n191\t    (store / f\"{merge}.json\").write_text(json.dumps(envelope))\n192\t\n193\t\n194\tdef test_doctor_rejects_a_subsecond_time_invocation_mismatch(tmp_path: Path) -> None:\n195\t    \"\"\"#202: the check allowed one second either way, so a statement could\n196\t    say 398.75 of records that sum to 398.25 and hold.\"\"\"\n197\t    root, merge = make_item(tmp_path, INVOCATIONS)\n198\t    statement = attest(root)\n199\t    assert statement[\"time\"][\"invocation_s\"] == 398.25\n200\t    statement[\"time\"][\"invocation_s\"] = 398.75\n201\t    seal(root, merge, statement)\n202\t    failed = proof_six(root)\n203\t    assert failed[\"holds\"] is False, failed\n204\t    assert \"item 1\" in failed[\"reason\"] and \"time.invocation_s\" in failed[\"reason\"], failed\n205\t\n206\t\n207\tdef test_doctor_rejects_statement_whose_time_or_cost_breakdown_disagrees_with_records(\n208\t        tmp_path: Path) -> None:\n209\t    \"\"\"#203: only time.invocation_s was compared, so every other field of\n210\t    the accounting could say anything. Each case leaves invocation_s true.\"\"\"\n211\t    root, merge = make_item(tmp_path, INVOCATIONS)\n212\t    true_statement = attest(root)\n213\t    seal(root, merge, true_statement)\n214\t    assert proof_six(root)[\"holds\"] is True\n215\t\n216\t    def forged(path: tuple[str, ...], value: Any) -> dict[str, Any]:\n217\t        copy: dict[str, Any] = json.loads(json.dumps(true_statement))\n218\t        node = copy\n219\t        for key in path[:-1]:\n220\t            node = node[key]\n221\t        node[path[-1]] = value\n222\t        return copy\n223\t\n224\t    cases: list[tuple[tuple[str, ...], Any, str]] = [\n225\t        ((\"time\", \"build\", \"invocation_s\"), 1.0, \"time.build\"),\n226\t        ((\"time\", \"build\", \"attempts\"), 1, \"time.build\"),\n227\t        ((\"time\", \"lead_s\"), 1.0, \"time.lead_s\"),\n228\t        ((\"time\", \"waiting_s\"), 1.0, \"time.waiting_s\"),\n229\t        ((\"time\", \"partial\"), True, \"time.partial\"),\n230\t        ((\"time\", \"not_read\"), [\"build-02\"], \"time.not_read\"),\n231\t        ((\"cost\", \"usd\"), 0.5, \"cost.usd\"),\n232\t        ((\"cost\", \"by_stage_usd\"), {\"build\": 0.5}, \"cost.by_stage_usd\"),\n233\t        ((\"cost\", \"by_adapter_usd\"), {\"alpha\": 0.5}, \"cost.by_adapter_usd\"),\n234\t        ((\"cost\", \"partial\"), False, \"cost.partial\"),\n235\t        ((\"cost\", \"not_read\"), [], \"cost.not_read\"),\n236\t        ((\"cost\", \"rate_usd\"), 1.0, \"cost.rate_usd\"),\n237\t    ]\n238\t    for path, value, named in cases:\n239\t        seal(root, merge, forged(path, value))\n240\t        failed = proof_six(root)\n241\t        assert failed[\"holds\"] is False, (path, failed)\n242\t        assert \"item 1\" in failed[\"reason\"] and named in failed[\"reason\"], (path, failed)\n243\t\n244\t    one_block: dict[str, Any] = json.loads(json.dumps(true_statement))\n245\t    del one_block[\"cost\"]\n246\t    seal(root, merge, one_block)\n247\t    assert proof_six(root)[\"holds\"] is False\n248\t\n249\t\n250\tdef test_doctor_holds_a_true_statement_however_its_store_prints_it(tmp_path: Path) -> None:\n251\t    \"\"\"The rule that keeps a sealed statement from wedging the doctor: a\n252\t    store may print 40.0 as 40, and a release after the seal may add a\n253\t    field the sealed statement never carried. Neither is a disagreement.\"\"\"\n254\t    root, merge = make_item(tmp_path, INVOCATIONS)\n255\t    statement = attest(root)\n256\t    assert statement[\"time\"][\"verify\"][\"invocation_s\"] == 40.0\n257\t    statement[\"time\"][\"verify\"][\"invocation_s\"] = 40\n258\t    del statement[\"time\"][\"counsel\"]\n259\t    del statement[\"time\"][\"build\"][\"partial\"]\n260\t    seal(root, merge, statement)\n261\t    held = proof_six(root)\n262\t    assert held[\"holds\"] is True and held[\"sealed\"] == [\"1\"], held\n263\t\n264\t\n265\tdef test_doctor_rejects_null_time_without_cost(tmp_path: Path) -> None:\n266\t    \"\"\"#204's review: `\"time\": null` with no cost read as a statement sealed\n267\t    before the accounting existed, and was not checked at all.\"\"\"\n268\t    root, merge = make_item(tmp_path, INVOCATIONS)\n269\t    statement = attest(root)\n270\t    statement[\"time\"] = None\n271\t    del statement[\"cost\"]\n272\t    seal(root, merge, statement)\n273\t    failed = proof_six(root)\n274\t    assert failed[\"holds\"] is False, failed\n275\t    assert \"item 1\" in failed[\"reason\"] and \"time\" in failed[\"reason\"], failed\n276\t\n277\t    statement[\"cost\"] = None\n278\t    seal(root, merge, statement)\n279\t    assert proof_six(root)[\"holds\"] is False, \"both blocks null is carried, not absent\"\n280\t\n281\t\n282\tdef test_doctor_rejects_large_integer_that_rounds_to_summed_float(tmp_path: Path) -> None:\n283\t    \"\"\"#204's review: both sides were converted to float, so an integer one\n284\t    past 2**53 equalled the float beside it.\"\"\"\n285\t    big = 9007199254740992.0\n286\t    root, merge = make_item(tmp_path, [(\"build\", 1, big, 0.25, \"alpha\"), (\"verify\", 1, 0.0, None, \"beta\")])\n287\t    statement = attest(root)\n288\t    assert statement[\"time\"][\"build\"][\"invocation_s\"] == big\n289\t    seal(root, merge, statement)\n290\t    assert proof_six(root)[\"holds\"] is True\n291\t    statement[\"time\"][\"build\"][\"invocation_s\"] = 9007199254740993\n292\t    seal(root, merge, statement)\n293\t    failed = proof_six(root)\n294\t    assert failed[\"holds\"] is False, failed\n295\t    assert \"item 1\" in failed[\"reason\"] and \"time.build\" in failed[\"reason\"], failed\n296\t\n297\t\n298\tV5_COST_FIELDS = (\"reported_usd\", \"estimated_usd\", \"basis_by_stage\", \"rates\", \"estimate_note\")\n299\tRETIRED = (\"cost_by_stage_usd\", \"wall_clock_by_stage_s\", \"tokens_by_stage\")\n300\t\n301\t\n302\tdef test_statement_carries_only_the_summed_accounting(tmp_path: Path) -> None:\n303\t    \"\"\"#309, specimen #289: the screen read the three final-attempt fields\n304\t    and showed $1.13 and ~14 minutes against a true $2.93 and ~26.5 minutes.\n305\t    Two build attempts and one verify: the statement carries none of the\n306\t    three fields, and time, cost and tokens are the sums over all three\n307\t    records.\"\"\"\n308\t    root, _ = make_item(tmp_path, [(\"build\", 1, 752.0, 1.8, \"alpha\"),\n309\t                                   (\"build\", 2, 777.0, 1.13, \"alpha\"),\n310\t                                   (\"verify\", 1, 58.0, None, \"alpha\")])\n311\t    statement = attest(root)\n312\t    jsonschema.validate(statement, SCHEMA)\n313\t    for field in RETIRED:\n314\t        assert field not in statement, field\n315\t    assert statement[\"time\"][\"invocation_s\"] == 1587.0\n316\t    assert statement[\"cost\"][\"usd\"] == 2.93\n317\t    assert statement[\"tokens\"][\"build\"] == {\"input\": 3000, \"output\": 30, \"partial\": False}\n318\t    assert statement[\"tokens\"][\"verify\"] == {\"input\": 500, \"output\": 5, \"partial\": False}\n319\t    assert statement[\"tokens\"][\"counsel\"] == {\"input\": 0, \"output\": 0, \"partial\": False}\n320\t    assert statement[\"tokens\"][\"input\"] == 3500 and statement[\"tokens\"][\"output\"] == 35\n321\t    assert statement[\"tokens\"][\"partial\"] is False and statement[\"tokens\"][\"not_read\"] == []\n322\t\n323\t\n324\tdef test_schema_is_v6_and_names_no_retired_field() -> None:\n325\t    \"\"\"#309: the predicate type moved to v4 with the three fields gone; #307\n326\t    moved it to v5, and #349 to v6; they stay gone.\"\"\"\n327\t    assert SCHEMA[\"$id\"] == \"https://attavo.dev/attestation/v6\"\n328\t    for field in RETIRED:\n329\t        assert field not in SCHEMA[\"properties\"] and field not in SCHEMA[\"required\"]\n330\t    assert \"tokens\" in SCHEMA[\"required\"]\n331\t\n332\t\n333\tdef test_a_record_without_tokens_makes_tokens_partial_and_is_named(tmp_path: Path) -> None:\n334\t    \"\"\"#309, as #289's verify-01 had no cost: a record with no tokens is\n335\t    named in not_read and its sums are partial, never counted as zero.\"\"\"\n336\t    root, _ = make_item(tmp_path, INVOCATIONS, tokenless=frozenset({\"build-02\"}))\n337\t    tokens = attest(root)[\"tokens\"]\n338\t    assert tokens[\"not_read\"] == [\"build-02\"]\n339\t    assert tokens[\"partial\"] is True and tokens[\"build\"][\"partial\"] is True\n340\t    assert tokens[\"verify\"][\"partial\"] is False"}]},"parent_tool_use_id":null,"session_id":"8b358cc5-0655-4274-9562-475abdbf906d","uuid":"8a8c6a17-2125-4220-af7d-f87e5b104564","timestamp":"2026-10-14T19:58:12.151Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-353/tests/test_attest_time.py","content":"\"\"\"The statement's `time` and `cost` blocks: every invocation of an item\nsummed by `attavo attest` from the records it already reads, and doctor's\nsixth proof holding the statement to those records.\n\nRegression, run red first on main at 1d2257b: the statement carried the\nfinal attempt per stage and nothing else, so a view derived its own\n\"product time\" -- 20 minutes for an item whose nineteen invocations ran\n115 -- and no record said otherwise.\n\nRun: python3 -m pytest tests -q\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport subprocess\nimport sys\nfrom pathlib import Path\nfrom typing import Any\n\nimport jsonschema\n\nfrom helpers import git\n\nROOT = Path(__file__).resolve().parent.parent\nATTAVO = ROOT / \"bin\" / \"attavo\"\nSCHEMA = json.loads((ROOT / \"schema\" / \"attestation.schema.json\").read_text())\n\n# (stage, attempt, wall_clock_s, cost_usd, adapter): three builds on one\n# executor, two verifies and one counsel on another that reports no cost.\nINVOCATIONS: list[tuple[str, int, float | None, float | None, str]] = [\n    (\"build\", 1, 100.5, 0.25, \"alpha\"),\n    (\"build\", 2, 200.0, 0.5, \"alpha\"),\n    (\"build\", 3, 50.25, 0.125, \"alpha\"),\n    (\"verify\", 1, 10.0, None, \"beta\"),\n    (\"verify\", 2, 30.0, None, \"beta\"),\n    (\"counsel\", 1, 7.5, None, \"beta\"),\n]\n\n\ndef run(root: Path, *args: str, stdin: str | None = None) -> subprocess.CompletedProcess[str]:\n    return subprocess.run([sys.executable, str(ATTAVO), *args], cwd=str(root), input=stdin,\n                          capture_output=True, text=True, check=False)\n\n\ndef write(path: Path, obj: dict[str, Any]) -> None:\n    path.parent.mkdir(parents=True, exist_ok=True)\n    path.write_text(json.dumps(obj))\n\n\ndef tokens_of(stage: str, n: int) -> dict[str, int]:\n    \"\"\"A record's tokens, distinct per attempt so a sum cannot pass by luck.\"\"\"\n    base = {\"build\": 1000, \"verify\": 500, \"counsel\": 200}[stage]\n    return {\"input\": base * n, \"output\": base * n // 100}\n\n\ndef make_item(tmp_path: Path, invocations: list[tuple[str, int, float | None, float | None, str]],\n              tokenless: frozenset[str] = frozenset(), manifest_extra: str = \"\",\n              models: dict[str, str] | None = None,\n              tokens: dict[str, dict[str, int]] | None = None) -> tuple[Path, str]:\n    \"\"\"A tenant with one item merged on main's first-parent line: spec and\n    approval records, then every invocation in `invocations`, the chain\n    coherent on the latest of each stage. Returns (root, merge sha).\"\"\"\n    root = tmp_path / \"tenant\"\n    root.mkdir(parents=True)\n    git(root, \"init\", \"-q\", \"-b\", \"main\", \".\")\n    git(root, \"config\", \"user.email\", \"fixture@attavo.invalid\")\n    git(root, \"config\", \"user.name\", \"fixture\")\n    (root / \"attavo.toml\").write_text(\n        '[paths]\\nrecords = \"records\"\\nspecs = \"specs\"\\n\\n'\n        '[forge]\\nattestation_command = \"sh ./fake-store\"\\n' + manifest_extra)\n    (root / \"fake-store\").write_text(\n        '#!/bin/sh\\nread sha\\ntest -f \"statements/$sha.json\" && cat \"statements/$sha.json\"\\n')\n    git(root, \"add\", \"-A\")\n    git(root, \"commit\", \"-q\", \"-m\", \"install\")\n    git(root, \"checkout\", \"-q\", \"-b\", \"attavo/1-x\")\n    rec = root / \"records\" / \"1\"\n    write(rec / \"spec-01.json\", {\"status\": \"pass\", \"sha\": \"s1\", \"at\": \"2026-01-01T00:00:00Z\"})\n    write(rec / \"approval-01.json\", {\"sha\": \"a1\", \"spec_sha\": \"s1\", \"at\": \"2026-01-01T00:00:00Z\"})\n    for stage, n, wall, cost, adapter in invocations:\n        body: dict[str, Any] = {\"status\": \"pass\", \"sha\": f\"{stage}{n}\", \"adapter\": adapter,\n                                \"approval_sha\": \"a1\", \"cost_usd\": cost}\n        if wall is not None:\n            body[\"wall_clock_s\"] = wall\n        name = f\"{stage}-{n:02d}\"\n        if models and name in models:\n            body[\"model\"] = models[name]\n        if name not in tokenless:\n            body[\"tokens\"] = (tokens or {}).get(name) or tokens_of(stage, n)\n        if stage == \"verify\":\n            last_build = max(i[1] for i in invocations if i[0] == \"build\")\n            body[\"build_sha\"] = f\"build{last_build}\"\n        write(rec / f\"{stage}-{n:02d}.json\", body)\n    git(root, \"add\", \"-A\")\n    git(root, \"commit\", \"-q\", \"-m\", \"records for item 1\")\n    git(root, \"checkout\", \"-q\", \"main\")\n    git(root, \"merge\", \"-q\", \"--no-ff\", \"-m\", \"Merge branch 'attavo/1-x'\", \"attavo/1-x\")\n    git(root, \"update-ref\", \"refs/remotes/origin/main\", \"main\")\n    git(root, \"symbolic-ref\", \"refs/remotes/origin/HEAD\", \"refs/remotes/origin/main\")\n    return root, git(root, \"rev-parse\", \"HEAD\").strip()\n\n\ndef attest(root: Path) -> dict[str, Any]:\n    done = run(root, \"attest\", \"1\")\n    assert done.returncode == 0, done.stdout + done.stderr\n    statement: dict[str, Any] = json.loads(done.stdout)\n    return statement\n\n\ndef proof_six(root: Path) -> dict[str, Any]:\n    out = json.loads(run(root, \"doctor\", \"--json\", str(root)).stdout)\n    found: dict[str, Any] = [p for p in out[\"proofs\"]\n                             if p[\"proof\"] == \"every-attested-item-is-sealed\"][0]\n    return found\n\n\ndef test_attest_sums_every_invocation_per_stage_and_per_item(tmp_path: Path) -> None:\n    root, _ = make_item(tmp_path, INVOCATIONS)\n    statement = attest(root)\n    jsonschema.validate(statement, SCHEMA)\n    time = statement[\"time\"]\n    assert time[\"build\"] == {\"attempts\": 3, \"invocation_s\": 350.75, \"partial\": False}\n    assert time[\"verify\"] == {\"attempts\": 2, \"invocation_s\": 40.0, \"partial\": False}\n    assert time[\"counsel\"] == {\"attempts\": 1, \"invocation_s\": 7.5, \"partial\": False}\n    assert time[\"invocation_s\"] == 398.25\n    assert time[\"partial\"] is False and time[\"not_read\"] == []\n    # lead runs from approval-01's `at` to the merge's committer time\n    merged_at = int(git(root, \"show\", \"-s\", \"--format=%ct\", \"HEAD\").strip())\n    assert time[\"lead_s\"] == merged_at - 1767225600\n    assert time[\"waiting_s\"] == round(time[\"lead_s\"] - 398.25, 3)\n\n\ndef test_attest_names_a_record_without_wall_clock_and_never_sums_it_as_zero(tmp_path: Path) -> None:\n    invocations = [i if i[:2] != (\"build\", 2) else (\"build\", 2, None, 0.5, \"alpha\")\n                   for i in INVOCATIONS]\n    root, _ = make_item(tmp_path, invocations)\n    time = attest(root)[\"time\"]\n    assert time[\"not_read\"] == [\"build-02\"]\n    assert time[\"build\"][\"partial\"] is True and time[\"partial\"] is True\n    assert time[\"build\"][\"attempts\"] == 3\n    assert time[\"verify\"][\"partial\"] is False\n\n\ndef test_attest_sums_cost_across_executors_and_says_when_the_total_is_partial(tmp_path: Path) -> None:\n    root, _ = make_item(tmp_path, INVOCATIONS)\n    cost = attest(root)[\"cost\"]\n    assert cost[\"usd\"] == 0.875\n    assert cost[\"by_stage_usd\"] == {\"build\": 0.875}\n    assert cost[\"by_adapter_usd\"] == {\"alpha\": 0.875}\n    assert cost[\"partial\"] is True\n    assert cost[\"not_read\"] == [\"verify-01\", \"verify-02\", \"counsel-01\"]\n\n    priced = [i if i[3] is not None else (i[0], i[1], i[2], 0.0625, i[4]) for i in INVOCATIONS]\n    root2, _ = make_item(tmp_path / \"priced\", priced)\n    cost2 = attest(root2)[\"cost\"]\n    assert cost2[\"usd\"] == 0.875 + 3 * 0.0625\n    assert cost2[\"by_adapter_usd\"] == {\"alpha\": 0.875, \"beta\": 0.1875}\n    assert cost2[\"partial\"] is False and cost2[\"not_read\"] == []\n\n\ndef test_doctor_proof_six_fails_a_statement_whose_time_is_not_its_records(tmp_path: Path) -> None:\n    root, merge = make_item(tmp_path, INVOCATIONS)\n    statement = attest(root)\n    store = root / \"statements\"\n    store.mkdir()\n    envelope = {\"_type\": \"https://in-toto.io/Statement/v1\", \"predicate\": statement}\n    (store / f\"{merge}.json\").write_text(json.dumps(envelope))\n    held = proof_six(root)\n    assert held[\"holds\"] is True and held[\"sealed\"] == [\"1\"], held\n\n    statement[\"time\"][\"invocation_s\"] = 20.0\n    (store / f\"{merge}.json\").write_text(json.dumps(envelope))\n    failed = proof_six(root)\n    assert failed[\"holds\"] is False, failed\n    assert \"item 1\" in failed[\"reason\"] and \"time.invocation_s\" in failed[\"reason\"], failed\n\n    # a statement sealed before `time` and `cost` existed carries neither\n    # and is not checked; one without the other is a disagreement (#203)\n    del statement[\"time\"]\n    del statement[\"cost\"]\n    (store / f\"{merge}.json\").write_text(json.dumps(envelope))\n    assert proof_six(root)[\"holds\"] is True\n\n\ndef seal(root: Path, merge: str, statement: dict[str, Any],\n         predicate_type: str | None = None) -> None:\n    store = root / \"statements\"\n    store.mkdir(exist_ok=True)\n    envelope: dict[str, Any] = {\"_type\": \"https://in-toto.io/Statement/v1\", \"predicate\": statement}\n    if predicate_type:\n        envelope[\"predicateType\"] = predicate_type\n    (store / f\"{merge}.json\").write_text(json.dumps(envelope))\n\n\ndef test_doctor_rejects_a_subsecond_time_invocation_mismatch(tmp_path: Path) -> None:\n    \"\"\"#202: the check allowed one second either way, so a statement could\n    say 398.75 of records that sum to 398.25 and hold.\"\"\"\n    root, merge = make_item(tmp_path, INVOCATIONS)\n    statement = attest(root)\n    assert statement[\"time\"][\"invocation_s\"] == 398.25\n    statement[\"time\"][\"invocation_s\"] = 398.75\n    seal(root, merge, statement)\n    failed = proof_six(root)\n    assert failed[\"holds\"] is False, failed\n    assert \"item 1\" in failed[\"reason\"] and \"time.invocation_s\" in failed[\"reason\"], failed\n\n\ndef test_doctor_rejects_statement_whose_time_or_cost_breakdown_disagrees_with_records(\n        tmp_path: Path) -> None:\n    \"\"\"#203: only time.invocation_s was compared, so every other field of\n    the accounting could say anything. Each case leaves invocation_s true.\"\"\"\n    root, merge = make_item(tmp_path, INVOCATIONS)\n    true_statement = attest(root)\n    seal(root, merge, true_statement)\n    assert proof_six(root)[\"holds\"] is True\n\n    def forged(path: tuple[str, ...], value: Any) -> dict[str, Any]:\n        copy: dict[str, Any] = json.loads(json.dumps(true_statement))\n        node = copy\n        for key in path[:-1]:\n            node = node[key]\n        node[path[-1]] = value\n        return copy\n\n    cases: list[tuple[tuple[str, ...], Any, str]] = [\n        ((\"time\", \"build\", \"invocation_s\"), 1.0, \"time.build\"),\n        ((\"time\", \"build\", \"attempts\"), 1, \"time.build\"),\n        ((\"time\", \"lead_s\"), 1.0, \"time.lead_s\"),\n        ((\"time\", \"waiting_s\"), 1.0, \"time.waiting_s\"),\n        ((\"time\", \"partial\"), True, \"time.partial\"),\n        ((\"time\", \"not_read\"), [\"build-02\"], \"time.not_read\"),\n        ((\"cost\", \"usd\"), 0.5, \"cost.usd\"),\n        ((\"cost\", \"by_stage_usd\"), {\"build\": 0.5}, \"cost.by_stage_usd\"),\n        ((\"cost\", \"by_adapter_usd\"), {\"alpha\": 0.5}, \"cost.by_adapter_usd\"),\n        ((\"cost\", \"partial\"), False, \"cost.partial\"),\n        ((\"cost\", \"not_read\"), [], \"cost.not_read\"),\n        ((\"cost\", \"rate_usd\"), 1.0, \"cost.rate_usd\"),\n    ]\n    for path, value, named in cases:\n        seal(root, merge, forged(path, value))\n        failed = proof_six(root)\n        assert failed[\"holds\"] is False, (path, failed)\n        assert \"item 1\" in failed[\"reason\"] and named in failed[\"reason\"], (path, failed)\n\n    one_block: dict[str, Any] = json.loads(json.dumps(true_statement))\n    del one_block[\"cost\"]\n    seal(root, merge, one_block)\n    assert proof_six(root)[\"holds\"] is False\n\n\ndef test_doctor_holds_a_true_statement_however_its_store_prints_it(tmp_path: Path) -> None:\n    \"\"\"The rule that keeps a sealed statement from wedging the doctor: a\n    store may print 40.0 as 40, and a release after the seal may add a\n    field the sealed statement never carried. Neither is a disagreement.\"\"\"\n    root, merge = make_item(tmp_path, INVOCATIONS)\n    statement = attest(root)\n    assert statement[\"time\"][\"verify\"][\"invocation_s\"] == 40.0\n    statement[\"time\"][\"verify\"][\"invocation_s\"] = 40\n    del statement[\"time\"][\"counsel\"]\n    del statement[\"time\"][\"build\"][\"partial\"]\n    seal(root, merge, statement)\n    held = proof_six(root)\n    assert held[\"holds\"] is True and held[\"sealed\"] == [\"1\"], held\n\n\ndef test_doctor_rejects_null_time_without_cost(tmp_path: Path) -> None:\n    \"\"\"#204's review: `\"time\": null` with no cost read as a statement sealed\n    before the accounting existed, and was not checked at all.\"\"\"\n    root, merge = make_item(tmp_path, INVOCATIONS)\n    statement = attest(root)\n    statement[\"time\"] = None\n    del statement[\"cost\"]\n    seal(root, merge, statement)\n    failed = proof_six(root)\n    assert failed[\"holds\"] is False, failed\n    assert \"item 1\" in failed[\"reason\"] and \"time\" in failed[\"reason\"], failed\n\n    statement[\"cost\"] = None\n    seal(root, merge, statement)\n    assert proof_six(root)[\"holds\"] is False, \"both blocks null is carried, not absent\"\n\n\ndef test_doctor_rejects_large_integer_that_rounds_to_summed_float(tmp_path: Path) -> None:\n    \"\"\"#204's review: both sides were converted to float, so an integer one\n    past 2**53 equalled the float beside it.\"\"\"\n    big = 9007199254740992.0\n    root, merge = make_item(tmp_path, [(\"build\", 1, big, 0.25, \"alpha\"), (\"verify\", 1, 0.0, None, \"beta\")])\n    statement = attest(root)\n    assert statement[\"time\"][\"build\"][\"invocation_s\"] == big\n    seal(root, merge, statement)\n    assert proof_six(root)[\"holds\"] is True\n    statement[\"time\"][\"build\"][\"invocation_s\"] = 9007199254740993\n    seal(root, merge, statement)\n    failed = proof_six(root)\n    assert failed[\"holds\"] is False, failed\n    assert \"item 1\" in failed[\"reason\"] and \"time.build\" in failed[\"reason\"], failed\n\n\nV5_COST_FIELDS = (\"reported_usd\", \"estimated_usd\", \"basis_by_stage\", \"rates\", \"estimate_note\")\nRETIRED = (\"cost_by_stage_usd\", \"wall_clock_by_stage_s\", \"tokens_by_stage\")\n\n\ndef test_statement_carries_only_the_summed_accounting(tmp_path: Path) -> None:\n    \"\"\"#309, specimen #289: the screen read the three final-attempt fields\n    and showed $1.13 and ~14 minutes against a true $2.93 and ~26.5 minutes.\n    Two build attempts and one verify: the statement carries none of the\n    three fields, and time, cost and tokens are the sums over all three\n    records.\"\"\"\n    root, _ = make_item(tmp_path, [(\"build\", 1, 752.0, 1.8, \"alpha\"),\n                                   (\"build\", 2, 777.0, 1.13, \"alpha\"),\n                                   (\"verify\", 1, 58.0, None, \"alpha\")])\n    statement = attest(root)\n    jsonschema.validate(statement, SCHEMA)\n    for field in RETIRED:\n        assert field not in statement, field\n    assert statement[\"time\"][\"invocation_s\"] == 1587.0\n    assert statement[\"cost\"][\"usd\"] == 2.93\n    assert statement[\"tokens\"][\"build\"] == {\"input\": 3000, \"output\": 30, \"partial\": False}\n    assert statement[\"tokens\"][\"verify\"] == {\"input\": 500, \"output\": 5, \"partial\": False}\n    assert statement[\"tokens\"][\"counsel\"] == {\"input\": 0, \"output\": 0, \"partial\": False}\n    assert statement[\"tokens\"][\"input\"] == 3500 and statement[\"tokens\"][\"output\"] == 35\n    assert statement[\"tokens\"][\"partial\"] is False and statement[\"tokens\"][\"not_read\"] == []\n\n\ndef test_schema_is_v6_and_names_no_retired_field() -> None:\n    \"\"\"#309: the predicate type moved to v4 with the three fields gone; #307\n    moved it to v5, and #349 to v6; they stay gone.\"\"\"\n    assert SCHEMA[\"$id\"] == \"https://attavo.dev/attestation/v6\"\n    for field in RETIRED:\n        assert field not in SCHEMA[\"properties\"] and field not in SCHEMA[\"required\"]\n    assert \"tokens\" in SCHEMA[\"required\"]\n\n\ndef test_a_record_without_tokens_makes_tokens_partial_and_is_named(tmp_path: Path) -> None:\n    \"\"\"#309, as #289's verify-01 had no cost: a record with no tokens is\n    named in not_read and its sums are partial, never counted as zero.\"\"\"\n    root, _ = make_item(tmp_path, INVOCATIONS, tokenless=frozenset({\"build-02\"}))\n    tokens = attest(root)[\"tokens\"]\n    assert tokens[\"not_read\"] == [\"build-02\"]\n    assert tokens[\"partial\"] is True and tokens[\"build\"][\"partial\"] is True\n    assert tokens[\"verify\"][\"partial\"] is False","numLines":340,"startLine":1,"totalLines":391}},"tool_result_meta":[{"id":"toolu_01YF6Fg2yCkptcWXha853xaM","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}

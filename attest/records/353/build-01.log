{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01EXsMyiZsJcNTKGkmv9yNjc","type":"tool_result","content":"1\t\"\"\"Issue #189: attavo/types.py is the mirror of schema/records/*.schema.json\n2\tand schema/attestation.schema.json. The schema stays the contract; each\n3\trecord TypedDict's keys equal the schema's `properties` and its required\n4\tkeys equal the schema's `required`, so the type cannot drift from it.\n5\t\n6\tRun: python3 -m pytest tests -q\n7\t\"\"\"\n8\tfrom __future__ import annotations\n9\t\n10\timport json\n11\tfrom pathlib import Path\n12\tfrom typing import Any\n13\t\n14\timport pytest\n15\t\n16\tfrom attavo import types\n17\t\n18\tROOT = Path(__file__).resolve().parent.parent\n19\tSCHEMA = ROOT / \"schema\"\n20\t\n21\t# The TypedDict for each schema, by the schema's path under schema/.\n22\tRECORD_KINDS = {\n23\t    \"SpecRecord\": \"records/spec.schema.json\",\n24\t    \"ApprovalRecord\": \"records/approval.schema.json\",\n25\t    \"BuildRecord\": \"records/build.schema.json\",\n26\t    \"VerifyRecord\": \"records/verify.schema.json\",\n27\t    \"CounselRecord\": \"records/counsel.schema.json\",\n28\t    \"AttestRecord\": \"attestation.schema.json\",\n29\t    \"DriveReport\": \"drive-report.schema.json\",\n30\t}\n31\t\n32\t# The Stop sub-shape appears in build and verify records, each with its own\n33\t# class enum; the type is one shape and the schemas carry the same three keys.\n34\tSTOP_HOMES = (\"records/build.schema.json\", \"records/verify.schema.json\")\n35\t\n36\t\n37\tdef load(path: str) -> dict[str, Any]:\n38\t    schema: dict[str, Any] = json.loads((SCHEMA / path).read_text())\n39\t    return schema\n40\t\n41\t\n42\t@pytest.mark.parametrize(\"kind\", sorted(RECORD_KINDS))\n43\tdef test_the_typeddict_keys_equal_the_schemas_properties(kind: str) -> None:\n44\t    schema = load(RECORD_KINDS[kind])\n45\t    td = getattr(types, kind)\n46\t    assert set(td.__annotations__) == set(schema[\"properties\"])\n47\t\n48\t\n49\t@pytest.mark.parametrize(\"kind\", sorted(RECORD_KINDS))\n50\tdef test_the_typeddicts_required_keys_equal_the_schemas_required(kind: str) -> None:\n51\t    schema = load(RECORD_KINDS[kind])\n52\t    td = getattr(types, kind)\n53\t    assert set(td.__required_keys__) == set(schema[\"required\"])\n54\t    assert set(td.__optional_keys__) == set(schema[\"properties\"]) - set(schema[\"required\"])\n55\t\n56\t\n57\t@pytest.mark.parametrize(\"path\", STOP_HOMES)\n58\tdef test_the_stop_shape_mirrors_the_stop_in_each_schema_that_carries_one(path: str) -> None:\n59\t    stop = load(path)[\"properties\"][\"stop\"]\n60\t    assert set(types.Stop.__annotations__) == set(stop[\"properties\"])\n61\t    assert set(types.Stop.__required_keys__) == set(stop[\"required\"])\n62\t"}]},"parent_tool_use_id":null,"session_id":"8b358cc5-0655-4274-9562-475abdbf906d","uuid":"0b683bbc-68ff-419e-8e8f-e5716ddfd241","timestamp":"2026-10-14T19:57:56.818Z","tool_use_result":{"type":"text","file":{"filePath":"/Users/davidbean/Projects/attavo-worktree-353/tests/test_types_mirror_schemas.py","content":"\"\"\"Issue #189: attavo/types.py is the mirror of schema/records/*.schema.json\nand schema/attestation.schema.json. The schema stays the contract; each\nrecord TypedDict's keys equal the schema's `properties` and its required\nkeys equal the schema's `required`, so the type cannot drift from it.\n\nRun: python3 -m pytest tests -q\n\"\"\"\nfrom __future__ import annotations\n\nimport json\nfrom pathlib import Path\nfrom typing import Any\n\nimport pytest\n\nfrom attavo import types\n\nROOT = Path(__file__).resolve().parent.parent\nSCHEMA = ROOT / \"schema\"\n\n# The TypedDict for each schema, by the schema's path under schema/.\nRECORD_KINDS = {\n    \"SpecRecord\": \"records/spec.schema.json\",\n    \"ApprovalRecord\": \"records/approval.schema.json\",\n    \"BuildRecord\": \"records/build.schema.json\",\n    \"VerifyRecord\": \"records/verify.schema.json\",\n    \"CounselRecord\": \"records/counsel.schema.json\",\n    \"AttestRecord\": \"attestation.schema.json\",\n    \"DriveReport\": \"drive-report.schema.json\",\n}\n\n# The Stop sub-shape appears in build and verify records, each with its own\n# class enum; the type is one shape and the schemas carry the same three keys.\nSTOP_HOMES = (\"records/build.schema.json\", \"records/verify.schema.json\")\n\n\ndef load(path: str) -> dict[str, Any]:\n    schema: dict[str, Any] = json.loads((SCHEMA / path).read_text())\n    return schema\n\n\n@pytest.mark.parametrize(\"kind\", sorted(RECORD_KINDS))\ndef test_the_typeddict_keys_equal_the_schemas_properties(kind: str) -> None:\n    schema = load(RECORD_KINDS[kind])\n    td = getattr(types, kind)\n    assert set(td.__annotations__) == set(schema[\"properties\"])\n\n\n@pytest.mark.parametrize(\"kind\", sorted(RECORD_KINDS))\ndef test_the_typeddicts_required_keys_equal_the_schemas_required(kind: str) -> None:\n    schema = load(RECORD_KINDS[kind])\n    td = getattr(types, kind)\n    assert set(td.__required_keys__) == set(schema[\"required\"])\n    assert set(td.__optional_keys__) == set(schema[\"properties\"]) - set(schema[\"required\"])\n\n\n@pytest.mark.parametrize(\"path\", STOP_HOMES)\ndef test_the_stop_shape_mirrors_the_stop_in_each_schema_that_carries_one(path: str) -> None:\n    stop = load(path)[\"properties\"][\"stop\"]\n    assert set(types.Stop.__annotations__) == set(stop[\"properties\"])\n    assert set(types.Stop.__required_keys__) == set(stop[\"required\"])\n","numLines":62,"startLine":1,"totalLines":62}},"tool_result_meta":[{"id":"toolu_01EXsMyiZsJcNTKGkmv9yNjc","permission_decision":{"decision":"accept","source":"config","reason_type":"rule"}}]}
{"type":"assistant","message":{"model":"claude-sonnet-5","id":"msg_011Cg2ikPzBFhCCS6fTeGxFL","type":"message","role":"assistant","content":[{"type":"text","text":"This test only checks top-level keys equality, not nested enums. So changing the schema's `class` enum for interventions doesn't require changes to types.py's keys (it's `list[dict[str, str]]` already). Let's verify that, and also check `test_doctor.py` and `test_attest_interventions.py` and `ledger.py::item_acts_and_interventions` for classes used."}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1317,"cache_read_input_tokens":59109,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1317},"output_tokens":1,"service_tier":"standard","inference_geo":"global"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"8b358cc5-0655-4274-9562-475abdbf906d","uuid":"9c03cbb3-18bc-47a1-a008-7a88680959dd","timestamp":"2026-10-14T19:57:59.515Z","request_id":"req_011Cg2ikPhp1W7fwKewdWwA6"}

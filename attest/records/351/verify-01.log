crashes.sh\\\"\\n< \\n< \\n< def test_a_thin_stub_whose_criteria_exit_exactly_1_still_passes(tmp_path: Path) -> None:\\n<     root = make_tenant(tmp_path, \\\"valid\\\")\\n<     set_criteria(root, [STRUCT, BEHAV],\\n<                  {\\\"checks_marker.sh\\\": \\\"test -f src/marker.txt || exit 1\\\",\\n<                   \\\"logic.sh\\\": \\\"test \\\\\\\"$(cat src/logic.txt 2>/dev/null)\\\\\\\" = done || exit 1\\\"},\\n<                  THIN_STUB)\\n<     run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n<     assert run.returncode == 0, run.stdout + run.stderr\\n<     assert latest_record(root, \\\"1\\\", \\\"spec\\\")[\\\"status\\\"] == \\\"pass\\\"\",\"stderr\":\"\",\"interrupted\":false,\"isImage\":false,\"returnCodeInterpretation\":\"Files differ\",\"noOutputExpected\":false},\"tool_result_meta\":[{\"id\":\"toolu_01Rja4A3wRHLto4g7dnQ87y3\",\"permission_decision\":{\"decision\":\"accept\",\"source\":\"config\",\"reason_type\":\"rule\"}}]}\n+{\"type\":\"assistant\",\"message\":{\"model\":\"claude-sonnet-5\",\"id\":\"msg_011Cg2ikrhXWX1CBhaj5jNjL\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"Good, that confirms exactly what to add. Now let's look at attavo/spec.py to understand current logic for running criteria.\"}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":1689,\"cache_read_input_tokens\":52090,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":1689},\"output_tokens\":4,\"service_tier\":\"standard\",\"inference_geo\":\"global\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"0fabd1e2-92b8-4212-a6d0-e85fc14548ff\",\"uuid\":\"d8f72afa-87b7-45c9-99f5-ad031b114d38\",\"timestamp\":\"2026-10-14T19:58:04.569Z\",\"request_id\":\"req_011Cg2ikrU8pZtRPBqrQ834s\"}\n+{\"type\":\"assistant\",\"message\":{\"model\":\"claude-sonnet-5\",\"id\":\"msg_011Cg2ikrhXWX1CBhaj5jNjL\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_0191VQy42usMJpjMPihchAve\",\"name\":\"Read\",\"input\":{\"file_path\":\"/Users/davidbean/Projects/attavo-worktree-351/attavo/spec.py\"},\"caller\":{\"type\":\"direct\"}}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":1689,\"cache_read_input_tokens\":52090,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":1689},\"output_tokens\":4,\"service_tier\":\"standard\",\"inference_geo\":\"global\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"0fabd1e2-92b8-4212-a6d0-e85fc14548ff\",\"uuid\":\"9268c684-a415-4120-b78b-1a6715a00f63\",\"timestamp\":\"2026-10-14T19:58:05.160Z\",\"request_id\":\"req_011Cg2ikrU8pZtRPBqrQ834s\",\"wire_tool_inputs\":{\"toolu_0191VQy42usMJpjMPihchAve\":{\"file_path\":\"/Users/davidbean/Projects/attavo-worktree-351/attavo/spec.py\"}}}\n+{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_0191VQy42usMJpjMPihchAve\",\"type\":\"tool_result\",\"content\":\"1\\tfrom __future__ import annotations\\n2\\t\\n3\\timport fnmatch\\n4\\timport os\\n5\\timport re\\n6\\timport shutil\\n7\\timport subprocess\\n8\\timport sys\\n9\\timport tempfile\\n10\\tfrom pathlib import Path\\n11\\tfrom typing import Any, cast\\n12\\t\\n13\\tfrom attavo.approval import approval_status\\n14\\tfrom attavo.common import (\\n15\\t    MANIFEST,\\n16\\t    ShallowCheckoutError,\\n17\\t    derive_item_id,\\n18\\t    git,\\n19\\t    last_commit_touching,\\n20\\t    now_iso,\\n21\\t    read_manifest,\\n22\\t    git_env,\\n23\\t)\\n24\\tfrom attavo.records import latest_record, write_record\\n25\\tfrom attavo import Command\\n26\\t\\n27\\t# --- the spec contract ---\\n28\\t\\n29\\tROOT_CAUSE_LINE = re.compile(r\\\"^Root-cause:\\\\s*([a-z0-9][a-z0-9-]*)\\\\s*$\\\")\\n30\\tROOT_CAUSE_ENTRY = re.compile(r\\\"^- ([a-z0-9][a-z0-9-]*):\\\\s+\\\\S\\\")\\n31\\tCLASS_LINE = re.compile(r\\\"^Class:\\\\s*(\\\\S+)\\\\s*$\\\")\\n32\\tCLASSES = (\\\"core\\\", \\\"fix\\\")\\n33\\tKINDS = (\\\"behavioural\\\", \\\"structural\\\")\\n34\\t# \\\"- [kind] name.sh: ...\\\" -- the label is parsed off before the name, which\\n35\\t# is everything between the dash (and label) and the first colon.\\n36\\tKIND_LABEL = re.compile(r\\\"^\\\\[([^\\\\]]*)\\\\]\\\\s*\\\")\\n37\\t\\n38\\t\\n39\\tdef parse_spec(spec_md: Path) -> tuple[dict[str, Any] | None, str | None]:\\n40\\t    lines = spec_md.read_text().splitlines()\\n41\\t    heading_idx = [i for i, l in enumerate(lines) if l.startswith(\\\"## \\\")]\\n42\\t    headings = [lines[i].rstrip() for i in heading_idx]\\n43\\t    expected = [\\\"## Problem\\\", \\\"## Claims\\\", \\\"## Criteria\\\"]\\n44\\t    if headings != expected:\\n45\\t        bad = next((h for h in headings if h not in expected), None)\\n46\\t        if bad is None:\\n47\\t            missing = [h for h in expected if h not in headings]\\n48\\t            bad = missing[0] if missing else \\\"heading order\\\"\\n49\\t        return None, f\\\"headings: found {headings or ['(none)']}, expected {expected} ({bad})\\\"\\n50\\t    idx_problem, idx_claims, idx_criteria = heading_idx\\n51\\t    claims = [l.strip()[2:].strip() for l in lines[idx_claims + 1:idx_criteria]\\n52\\t              if l.strip().startswith(\\\"- \\\")]\\n53\\t    # A fix item names the root cause its change closes, as one line in\\n54\\t    # the problem: \\\"Root-cause: <slug>\\\". Optional; when present the gate\\n55\\t    # checks it against the tenant's closed list (root_cause_refusal).\\n56\\t    root_cause = None\\n57\\t    for l in lines[idx_problem + 1:idx_claims]:\\n58\\t        m = ROOT_CAUSE_LINE.match(l)\\n59\\t        if m:\\n60\\t            root_cause = m.group(1)\\n61\\t            break\\n62\\t    # The item's class, declared by the operator at filing as one line in\\n63\\t    # the problem: \\\"Class: core\\\" (the change touches the mechanism) or\\n64\\t    # \\\"Class: fix\\\". Optional to parse; the gate requires it (class_refusal).\\n65\\t    item_class = None\\n66\\t    for l in lines[idx_problem + 1:idx_claims]:\\n67\\t        cm = CLASS_LINE.match(l)\\n68\\t        if cm:\\n69\\t            item_class = cm.group(1)\\n70\\t            break\\n71\\t    criteria = []\\n72\\t    kinds: dict[str, str] = {}\\n73\\t    for l in lines[idx_criteria + 1:]:\\n74\\t        s = l.strip()\\n75\\t        if not s.startswith(\\\"- \\\") or \\\":\\\" not in s:\\n76\\t            continue\\n77\\t        body = s[2:]\\n78\\t        label = KIND_LABEL.match(body)\\n79\\t        kind = \\\"structural\\\"\\n80\\t        if label:\\n81\\t            body = body[label.end():]\\n82\\t            kind = label.group(1).strip()\\n83\\t        name = body.split(\\\":\\\", 1)[0].strip()\\n84\\t        if kind not in KINDS:\\n85\\t            return None, f\\\"criterion has an unknown kind [{kind}]: {name}\\\"\\n86\\t        criteria.append(name)\\n87\\t        kinds[name] = kind\\n88\\t    return {\\\"claims\\\": claims, \\\"criteria\\\": criteria, \\\"kinds\\\": kinds,\\n89\\t            \\\"root_cause\\\": root_cause, \\\"class\\\": item_class}, None\\n90\\t\\n91\\t\\n92\\tdef root_causes_path(root: Path, m: dict[str, Any]) -> Path:\\n93\\t    \\\"\\\"\\\"The tenant's closed list of root causes: root-causes.md beside\\n94\\t    the specs directory (attest/root-causes.md when specs live in\\n95\\t    attest/specs). One root cause per line, \\\"- <slug>: <one sentence>\\\".\\\"\\\"\\\"\\n96\\t    return root / Path(m[\\\"paths\\\"][\\\"specs\\\"]).parent / \\\"root-causes.md\\\"\\n97\\t\\n98\\t\\n99\\tdef listed_root_causes(path: Path) -> list[str]:\\n100\\t    if not path.is_file():\\n101\\t        return []\\n102\\t    return [mm.group(1) for mm in (ROOT_CAUSE_ENTRY.match(l) for l in path.read_text().splitlines()) if mm]\\n103\\t\\n104\\t\\n105\\tdef root_cause_refusal(root: Path, m: dict[str, Any], root_cause: str | None) -> str | None:\\n106\\t    \\\"\\\"\\\"A spec that names a root cause must name one the tenant lists.\\n107\\t    Symptom counts do not converge; root-cause counts can, and only if\\n108\\t    every root cause a fix item names is one the list already carries or\\n109\\t    an item added on purpose. No root-cause line, no check: a capability\\n110\\t    item has no root cause.\\\"\\\"\\\"\\n111\\t    if root_cause is None:\\n112\\t        return None\\n113\\t    path = root_causes_path(root, m)\\n114\\t    if not path.is_file():\\n115\\t        return f\\\"root cause: {root_cause} named but {path.relative_to(root)} does not exist\\\"\\n116\\t    if root_cause not in listed_root_causes(path):\\n117\\t        return f\\\"root cause: {root_cause} is not listed in {path.relative_to(root)}\\\"\\n118\\t    return None\\n119\\t\\n120\\t\\n121\\tdef research_policy(m: dict[str, Any]) -> str:\\n122\\t    \\\"\\\"\\\"[spec].research: \\\"required\\\" makes a core spec owe a research record\\n123\\t    before its gate passes; absent, it owes none. Ruled 2026-09-27: every\\n124\\t    core item owes research in the end state, behind this flag until the\\n125\\t    Plan area hosts research. The gate record says which policy applied.\\\"\\\"\\\"\\n126\\t    return \\\"required\\\" if (m.get(\\\"spec\\\") or {}).get(\\\"research\\\") == \\\"required\\\" else \\\"not required by policy\\\"\\n127\\t\\n128\\t\\n129\\tdef class_refusal(m: dict[str, Any], parsed: dict[str, Any], records_dir: Path) -> str | None:\\n130\\t    \\\"\\\"\\\"A spec declares its class; a spec that names a root cause is core\\n131\\t    (ruled 2026-09-27: a root cause lies behind several issues, and closing\\n132\\t    it changes the mechanism); and, when the tenant requires research, a\\n133\\t    core spec has a research record in the item's records before its gate\\n134\\t    passes.\\\"\\\"\\\"\\n135\\t    item_class = parsed.get(\\\"class\\\")\\n136\\t    if item_class is None:\\n137\\t        return \\\"class: none declared; add a line 'Class: core' or 'Class: fix' to the problem\\\"\\n138\\t    if item_class not in CLASSES:\\n139\\t        return f\\\"class: {item_class} is not core or fix\\\"\\n140\\t    if parsed.get(\\\"root_cause\\\") and item_class != \\\"core\\\":\\n141\\t        return f\\\"class: {item_class} with root cause {parsed['root_cause']}; a root-cause item is core\\\"\\n142\\t    if (item_class == \\\"core\\\" and research_policy(m) == \\\"required\\\"\\n143\\t            and latest_record(records_dir, \\\"research\\\") is None):\\n144\\t        return \\\"research: [spec].research is required and the item has no research record\\\"\\n145\\t    return None\\n146\\t\\n147\\t\\n148\\tdef run_criterion(exe: Path, cwd: Path) -> int:\\n149\\t    try:\\n150\\t        run = subprocess.run([str(exe)], cwd=str(cwd), capture_output=True,\\n151\\t                             timeout=CRITERION_TIMEOUT, check=False)\\n152\\t        return run.returncode\\n153\\t    except subprocess.TimeoutExpired:\\n154\\t        return 124\\n155\\t    except OSError:\\n156\\t        return 126\\n157\\t\\n158\\t\\n159\\tdef stub_outside_claims(spec_dir: Path, claims: list[str]) -> str | None:\\n160\\t    \\\"\\\"\\\"The first path under stub/ (or named in stub/.removed) that no claim\\n161\\t    matches, or None. The stub is the change's floor: a path it touches is\\n162\\t    a path the build will touch, so a Claims list that does not name it is\\n163\\t    wrong before any build runs (item 229: a claim missed at filing cost\\n164\\t    an attempt to find). Matched the way cmd_build matches (fnmatch), with\\n165\\t    a directory claim covering everything under it.\\\"\\\"\\\"\\n166\\t    stub_dir = spec_dir / \\\"stub\\\"\\n167\\t    if not stub_dir.is_dir():\\n168\\t        return None\\n169\\t    paths = sorted(p.relative_to(stub_dir).as_posix() for p in stub_dir.rglob(\\\"*\\\")\\n170\\t                   if p.is_file() and p.name != \\\".removed\\\")\\n171\\t    paths += parse_removed(stub_dir)\\n172\\t    patterns = [c + \\\"**\\\" if c.endswith(\\\"/\\\") else c for c in claims]\\n173\\t    for path in paths:\\n174\\t        if not any(fnmatch.fnmatch(path, pat) or path.startswith(pat.rstrip(\\\"*\\\")) and pat.endswith(\\\"**\\\")\\n175\\t                   for pat in patterns):\\n176\\t            return path\\n177\\t    return None\\n178\\t\\n179\\t\\n180\\tdef parse_removed(stub_dir: Path) -> list[str]:\\n181\\t    \\\"\\\"\\\"The paths listed in stub/.removed, one per line, comments (lines\\n182\\t    starting with #) and blank lines ignored. [] when the stub carries no\\n183\\t    .removed at all.\\n184\\t    \\\"\\\"\\\"\\n185\\t    removed_file = stub_dir / \\\".removed\\\"\\n186\\t    if not removed_file.is_file():\\n187\\t        return []\\n188\\t    paths = []\\n189\\t    for line in removed_file.read_text().splitlines():\\n190\\t        s = line.strip()\\n191\\t        if not s or s.startswith(\\\"#\\\"):\\n192\\t            continue\\n193\\t        paths.append(s)\\n194\\t    return paths\\n195\\t\\n196\\t\\n197\\tdef removed_path_refusal(root: Path, stub_dir: Path, rel: str) -> str | None:\\n198\\t    p = Path(rel)\\n199\\t    if p.is_absolute() or \\\"..\\\" in p.parts:\\n200\\t        return f\\\"stub/.removed names a path outside the tree: {rel}\\\"\\n201\\t    if not (root / p).exists():\\n202\\t        return f\\\"stub/.removed names a path not in the tree: {rel}\\\"\\n203\\t    if (stub_dir / p).exists():\\n204\\t        return f\\\"stub/.removed names a path the stub also supplies: {rel}\\\"\\n205\\t    return None\\n206\\t\\n207\\t\\n208\\tdef stub_removed_refusal(root: Path, spec_dir: Path) -> str | None:\\n209\\t    \\\"\\\"\\\"Validated by name, before any criterion runs -- a stub whose\\n210\\t    .removed cannot be applied has no meaning to gate against.\\n211\\t    \\\"\\\"\\\"\\n212\\t    stub_dir = spec_dir / \\\"stub\\\"\\n213\\t    for rel in parse_removed(stub_dir):\\n214\\t        refusal = removed_path_refusal(root, stub_dir, rel)\\n215\\t        if refusal:\\n216\\t            return refusal\\n217\\t    return None\\n218\\t\\n219\\t\\n220\\tdef run_criteria(root: Path, spec_dir: Path, names: list[str],\\n221\\t                 kinds: dict[str, str] | None = None) -> list[dict[str, Any]]:\\n222\\t    criteria_dir = spec_dir / \\\"criteria\\\"\\n223\\t    stub_dir = spec_dir / \\\"stub\\\"\\n224\\t    with tempfile.TemporaryDirectory() as tmp:\\n225\\t        tree = Path(tmp) / \\\"tree\\\"\\n226\\t        stubbed = Path(tmp) / \\\"stubbed\\\"\\n227\\t        shutil.copytree(root, tree, ignore=shutil.ignore_patterns(\\\".git\\\"))\\n228\\t        shutil.copytree(root, stubbed, ignore=shutil.ignore_patterns(\\\".git\\\"))\\n229\\t        if stub_dir.is_dir():\\n230\\t            shutil.copytree(stub_dir, stubbed, dirs_exist_ok=True)\\n231\\t            for rel in parse_removed(stub_dir):\\n232\\t                target = stubbed / rel\\n233\\t                if target.is_dir():\\n234\\t                    shutil.rmtree(target)\\n235\\t                elif target.exists():\\n236\\t                    target.unlink()\\n237\\t            removed_marker = stubbed / \\\".removed\\\"\\n238\\t            if removed_marker.exists():\\n239\\t                removed_marker.unlink()\\n240\\t        results = []\\n241\\t        for name in names:\\n242\\t            exe = criteria_dir / name\\n243\\t            results.append({\\\"name\\\": name,\\n244\\t                            \\\"kind\\\": (kinds or {}).get(name, \\\"structural\\\"),\\n245\\t                            \\\"on_tree\\\": run_criterion(exe, tree),\\n246\\t                            \\\"on_stub\\\": run_criterion(exe, stubbed)})\\n247\\t        return results\\n248\\t\\n249\\t\\n250\\tdef commit_postdates(root: Path, earlier: str, later: str) -> bool:\\n251\\t    \\\"\\\"\\\"Whether later is a strict descendant of earlier on this branch.\\\"\\\"\\\"\\n252\\t    if earlier == later:\\n253\\t        return False\\n254\\t    run = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"merge-base\\\", \\\"--is-ancestor\\\", earlier, later],\\n255\\t                         capture_output=True, check=False, env=git_env())\\n256\\t    return run.returncode == 0\\n257\\t\\n258\\t\\n259\\tdef cmd_spec_gate(argv: list[str]) -> int:\\n260\\t    root = Path(\\\".\\\").resolve()\\n261\\t    item_id = argv[0] if argv else derive_item_id(root)\\n262\\t    if not item_id:\\n263\\t        print(\\\"attavo spec-gate: cannot derive item id; pass N or run on an attavo/N-* branch\\\",\\n264\\t              file=sys.stderr)\\n265\\t        return 2\\n266\\t    m = read_manifest(root)\\n267\\t    if m is None:\\n268\\t        print(f\\\"attavo spec-gate: no {MANIFEST} at {root}\\\", file=sys.stderr)\\n269\\t        return 2\\n270\\t    specs_rel = m[\\\"paths\\\"][\\\"specs\\\"]\\n271\\t    records_rel = m[\\\"paths\\\"][\\\"records\\\"]\\n272\\t    spec_dir = root / specs_rel / item_id\\n273\\t    spec_md = spec_dir / \\\"spec.md\\\"\\n274\\t    if not spec_md.is_file():\\n275\\t        print(f\\\"attavo spec-gate: no spec at {spec_dir}\\\", file=sys.stderr)\\n276\\t        return 2\\n277\\t    spec_rel = str(Path(specs_rel) / item_id)\\n278\\t    try:\\n279\\t        spec_sha = last_commit_touching(root, spec_rel)\\n280\\t    except ShallowCheckoutError as exc:\\n281\\t        print(f\\\"attavo spec-gate: refused: {exc}\\\", file=sys.stderr)\\n282\\t        return 2\\n283\\t\\n284\\t    records_dir = root / records_rel / item_id\\n285\\t    try:\\n286\\t        approved = approval_status(root, m, item_id) == \\\"valid\\\"\\n287\\t    except ShallowCheckoutError as exc:\\n288\\t        print(f\\\"attavo spec-gate: refused: {exc}\\\", file=sys.stderr)\\n289\\t        return 2\\n290\\t    latest_approval = latest_record(records_dir, \\\"approval\\\")\\n291\\t    if approved:\\n292\\t        record: dict[str, Any] = {\\\"sha\\\": git(root, \\\"rev-parse\\\", \\\"HEAD\\\").strip(), \\\"spec_sha\\\": spec_sha,\\n293\\t                  \\\"at\\\": now_iso(), \\\"status\\\": \\\"approved\\\",\\n294\\t                  \\\"approval_sha\\\": latest_approval.get(\\\"sha\\\") if latest_approval else None,\\n295\\t                  \\\"criteria\\\": [], \\\"refusal\\\": None}\\n296\\t        write_record(records_dir, \\\"spec\\\", record, m, item_id)\\n297\\t        print(\\\"attavo spec-gate: approved (no criteria run)\\\")\\n298\\t        return 0\\n299\\t\\n300\\t    # Third verdict, beside \\\"approved\\\" and Phase 1's \\\"pass\\\": the approval\\n301\\t    # is not valid, but a build already ran after it -- the amendment that\\n302\\t    # expired the approval landed above the line, not below it, and the\\n303\\t    # tree the build produced is what must satisfy the criteria now, not\\n304\\t    # the stub that only ever proved they were reachable before approval.\\n305\\t    # Issue #98: whatever the build's status, including a halt -- the\\n306\\t    # executor commits then asks, so a halted build's sha postdating the\\n307\\t    # approval means it did the work. commit_postdates already excludes a\\n308\\t    # halt that committed nothing, since such a build's sha equals its\\n309\\t    # start_sha and so postdates nothing.\\n310\\t    latest_build = latest_record(records_dir, \\\"build\\\")\\n311\\t    built = bool(\\n312\\t        latest_approval and latest_build\\n313\\t        and commit_postdates(root, latest_approval[\\\"sha\\\"], latest_build[\\\"sha\\\"]))\\n314\\t\\n315\\t    parsed, refusal = parse_spec(spec_md)\\n316\\t    results: list[dict[str, Any]] = []\\n317\\t    if refusal is None:\\n318\\t        # parse_spec returns a refusal exactly when it returns no spec.\\n319\\t        parsed = cast(dict[str, Any], parsed)\\n320\\t        refusal = root_cause_refusal(root, m, parsed.get(\\\"root_cause\\\"))\\n321\\t    if refusal is None and not built:\\n322\\t        # Required before approval only: an item already approved and\\n323\\t        # built re-gates as it did, so no item in flight is stranded.\\n324\\t        refusal = class_refusal(m, cast(dict[str, Any], parsed), records_dir)\\n325\\t    if refusal is None:\\n326\\t        parsed = cast(dict[str, Any], parsed)\\n327\\t        if built:\\n328\\t            refusal = stub_removed_refusal(root, spec_dir)\\n329\\t            if refusal is None:\\n330\\t                # Per criterion, not the set: passing on the tree is what\\n331\\t                # the build already satisfied; failing on the tree but\\n332\\t                # passing on the stub is a new obligation the next build\\n333\\t                # must meet -- an operator scripting a ruling the executor\\n334\\t                # skipped. Refused only when a criterion satisfies neither.\\n335\\t                results = run_criteria(root, spec_dir, parsed[\\\"criteria\\\"], parsed[\\\"kinds\\\"])\\n336\\t                # A behavioural criterion fails on the stub by design, so\\n337\\t                # after a build it is judged on the tree alone.\\n338\\t                fail_behav = next((c for c in results\\n339\\t                                   if c[\\\"kind\\\"] == \\\"behavioural\\\" and c[\\\"on_tree\\\"] != 0), None)\\n340\\t                fail = next((c for c in results if c[\\\"kind\\\"] == \\\"structural\\\"\\n341\\t                             and c[\\\"on_tree\\\"] != 0 and c[\\\"on_stub\\\"] != 0), None)\\n342\\t                if fail_behav:\\n343\\t                    refusal = f\\\"criterion labelled behavioural fails on the tree: {fail_behav['name']}\\\"\\n344\\t                elif fail:\\n345\\t                    refusal = f\\\"criterion fails against the tree plus stub: {fail['name']}\\\"\\n346\\t        elif not parsed[\\\"claims\\\"]:\\n347\\t            refusal = \\\"claims: empty; the build may touch nothing\\\"\\n348\\t        elif not parsed[\\\"criteria\\\"]:\\n349\\t            # Zero criteria match zero files in criteria/, so the prose check\\n350\\t            # below would pass a spec that asserts nothing, and approve it.\\n351\\t            refusal = \\\"criteria: empty; the spec asserts nothing\\\"\\n352\\t        elif stub_outside_claims(spec_dir, parsed[\\\"claims\\\"]) is not None:\\n353\\t            refusal = (\\\"stub touches a path the claims do not name: \\\"\\n354\\t                       f\\\"{stub_outside_claims(spec_dir, parsed['claims'])}\\\")\\n355\\t        elif parsed[\\\"criteria\\\"] and \\\"structural\\\" not in parsed[\\\"kinds\\\"].values():\\n356\\t            # A behavioural criterion only has to fail on the stub, so a\\n357\\t            # spec of nothing else proves nothing reachable before approval.\\n358\\t            refusal = (\\\"no structural criterion: nothing shows the stub reaches \\\"\\n359\\t                       \\\"what the behavioural criteria test\\\")\\n360\\t        else:\\n361\\t            criteria_dir = spec_dir / \\\"criteria\\\"\\n362\\t            listed = parsed[\\\"criteria\\\"]\\n363\\t            existing = sorted(p.name for p in criteria_dir.iterdir()) if criteria_dir.is_dir() else []\\n364\\t            prose = None\\n365\\t            for name in listed:\\n366\\t                if name not in existing:\\n367\\t                    prose = name\\n368\\t                    break\\n369\\t            if prose is None:\\n370\\t                for name in existing:\\n371\\t                    if name not in listed:\\n372\\t                        prose = name\\n373\\t                        break\\n374\\t            if prose is None:\\n375\\t                for name in listed:\\n376\\t                    if not os.access(criteria_dir / name, os.X_OK):\\n377\\t                        prose = name\\n378\\t                        break\\n379\\t            if prose:\\n380\\t                refusal = f\\\"criterion is prose: {prose}\\\"\\n381\\t            else:\\n382\\t                refusal = stub_removed_refusal(root, spec_dir)\\n383\\t                if refusal is None:\\n384\\t                    results = run_criteria(root, spec_dir, listed, parsed[\\\"kinds\\\"])\\n385\\t                    fail_tree = next((c for c in results if c[\\\"on_tree\\\"] == 0), None)\\n386\\t                    if fail_tree:\\n387\\t                        refusal = f\\\"criterion passes against the tree: {fail_tree['name']}\\\"\\n388\\t                    else:\\n389\\t                        # The label is checked against the measured exits.\\n390\\t                        fail_stub = next((c for c in results if c[\\\"kind\\\"] == \\\"structural\\\"\\n391\\t                                          and c[\\\"on_stub\\\"] != 0), None)\\n392\\t                        pass_stub = next((c for c in results if c[\\\"kind\\\"] == \\\"behavioural\\\"\\n393\\t                                          and c[\\\"on_stub\\\"] == 0), None)\\n394\\t                        if fail_stub:\\n395\\t                            refusal = (\\\"criterion labelled structural fails on the tree plus stub: \\\"\\n396\\t                                       f\\\"{fail_stub['name']}\\\")\\n397\\t                        elif pass_stub:\\n398\\t                            refusal = (\\\"criterion labelled behavioural passes on the tree plus stub: \\\"\\n399\\t                                       f\\\"{pass_stub['name']}\\\")\\n400\\t\\n401\\t    status = \\\"refused\\\" if refusal else (\\\"built\\\" if built else \\\"pass\\\")\\n402\\t    record = {\\\"sha\\\": git(root, \\\"rev-parse\\\", \\\"HEAD\\\").strip(),\\n403\\t              \\\"spec_sha\\\": spec_sha,\\n404\\t              \\\"at\\\": now_iso(), \\\"status\\\": status, \\\"approval_sha\\\": None,\\n405\\t              \\\"criteria\\\": results, \\\"refusal\\\": refusal,\\n406\\t              \\\"class\\\": (parsed or {}).get(\\\"class\\\"), \\\"research\\\": research_policy(m)}\\n407\\t    write_record(records_dir, \\\"spec\\\", record, m, item_id)\\n408\\t\\n409\\t    if refusal:\\n410\\t        print(f\\\"attavo spec-gate: refused: {refusal}\\\")\\n411\\t        return 1\\n412\\t    print(f\\\"attavo spec-gate: {status} ({len(results)} criterion/criteria)\\\")\\n413\\t    return 0\\n414\\t\\n415\\t\\n416\\tCRITERION_TIMEOUT = 120\\n417\\t\\n418\\t\\n419\\tCOMMANDS = (\\n420\\t    Command(\\n421\\t        name='spec-gate',\\n422\\t        run=cmd_spec_gate,\\n423\\t        usage=('attavo spec-gate [N]',),\\n424\\t        rank=20,\\n425\\t        help=(\\n426\\t            (50, \\\"\\\"\\\"\\\\\\n427\\tspec-gate, approve, and approval-status are gates and writers. They run\\n428\\tfrom the tenant root (the current working directory); N, the work item id,\\n429\\tis read from the ATTAVO_ITEM environment variable when set, else from the\\n430\\tbranch (attavo/N-*). The doctor's first proof sets ATTAVO_ITEM for a\\n431\\trejection fixture's own item, so a gate's own command needs no argument\\n432\\teven while the enclosing repository sits on a real item's attavo/N-*\\n433\\tbranch. Every run of spec-gate or approve writes the next numbered attempt\\n434\\tfile under paths.records/N/ and never overwrites one already written. A\\n435\\tfix item's spec may name the root cause its change closes as one\\n436\\t\\\"Root-cause: <slug>\\\" line in the problem; spec-gate refuses a slug the\\n437\\ttenant's root-causes.md (beside paths.specs) does not list, or any slug\\n438\\twhen that file is absent, before any criterion runs -- a spec with no\\n439\\troot-cause line is untouched. spec-gate also refuses, before any\\n440\\tcriterion runs, \\\"stub touches a path the claims do not name: <path>\\\" for\\n441\\tthe first path under stub/ (or in stub/.removed) that no claim matches.\\n442\\tA criterion line may carry a kind after its dash, \\\"- [behavioural] name.sh: ...\\\"\\n443\\tor \\\"- [structural] name.sh: ...\\\"; unlabelled is structural. Structural must\\n444\\tfail on the tree and pass on the tree plus stub; behavioural must fail on\\n445\\tboth, so the stub can be thin; before approval a spec needs at least one\\n446\\tstructural criterion. A label the measured exits contradict is\\n447\\trefused by name, as is an unknown one. After a build a behavioural\\n448\\tcriterion must pass on the tree.\\n449\\tSee the spec contract in the project's Phase 1 issue for the full rules\\n450\\teach one enforces.\\\"\\\"\\\"),\\n451\\t        ),\\n452\\t    ),\\n453\\t)\\n454\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"0fabd1e2-92b8-4212-a6d0-e85fc14548ff\",\"uuid\":\"cecb0140-b3b3-4012-a5ed-772b9b1a60ac\",\"timestamp\":\"2026-10-14T19:58:05.168Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/davidbean/Projects/attavo-worktree-351/attavo/spec.py\",\"content\":\"from __future__ import annotations\\n\\nimport fnmatch\\nimport os\\nimport re\\nimport shutil\\nimport subprocess\\nimport sys\\nimport tempfile\\nfrom pathlib import Path\\nfrom typing import Any, cast\\n\\nfrom attavo.approval import approval_status\\nfrom attavo.common import (\\n    MANIFEST,\\n    ShallowCheckoutError,\\n    derive_item_id,\\n    git,\\n    last_commit_touching,\\n    now_iso,\\n    read_manifest,\\n    git_env,\\n)\\nfrom attavo.records import latest_record, write_record\\nfrom attavo import Command\\n\\n# --- the spec contract ---\\n\\nROOT_CAUSE_LINE = re.compile(r\\\"^Root-cause:\\\\s*([a-z0-9][a-z0-9-]*)\\\\s*$\\\")\\nROOT_CAUSE_ENTRY = re.compile(r\\\"^- ([a-z0-9][a-z0-9-]*):\\\\s+\\\\S\\\")\\nCLASS_LINE = re.compile(r\\\"^Class:\\\\s*(\\\\S+)\\\\s*$\\\")\\nCLASSES = (\\\"core\\\", \\\"fix\\\")\\nKINDS = (\\\"behavioural\\\", \\\"structural\\\")\\n# \\\"- [kind] name.sh: ...\\\" -- the label is parsed off before the name, which\\n# is everything between the dash (and label) and the first colon.\\nKIND_LABEL = re.compile(r\\\"^\\\\[([^\\\\]]*)\\\\]\\\\s*\\\")\\n\\n\\ndef parse_spec(spec_md: Path) -> tuple[dict[str, Any] | None, str | None]:\\n    lines = spec_md.read_text().splitlines()\\n    heading_idx = [i for i, l in enumerate(lines) if l.startswith(\\\"## \\\")]\\n    headings = [lines[i].rstrip() for i in heading_idx]\\n    expected = [\\\"## Problem\\\", \\\"## Claims\\\", \\\"## Criteria\\\"]\\n    if headings != expected:\\n        bad = next((h for h in headings if h not in expected), None)\\n        if bad is None:\\n            missing = [h for h in expected if h not in headings]\\n            bad = missing[0] if missing else \\\"heading order\\\"\\n        return None, f\\\"headings: found {headings or ['(none)']}, expected {expected} ({bad})\\\"\\n    idx_problem, idx_claims, idx_criteria = heading_idx\\n    claims = [l.strip()[2:].strip() for l in lines[idx_claims + 1:idx_criteria]\\n              if l.strip().startswith(\\\"- \\\")]\\n    # A fix item names the root cause its change closes, as one line in\\n    # the problem: \\\"Root-cause: <slug>\\\". Optional; when present the gate\\n    # checks it against the tenant's closed list (root_cause_refusal).\\n    root_cause = None\\n    for l in lines[idx_problem + 1:idx_claims]:\\n        m = ROOT_CAUSE_LINE.match(l)\\n        if m:\\n            root_cause = m.group(1)\\n            break\\n    # The item's class, declared by the operator at filing as one line in\\n    # the problem: \\\"Class: core\\\" (the change touches the mechanism) or\\n    # \\\"Class: fix\\\". Optional to parse; the gate requires it (class_refusal).\\n    item_class = None\\n    for l in lines[idx_problem + 1:idx_claims]:\\n        cm = CLASS_LINE.match(l)\\n        if cm:\\n            item_class = cm.group(1)\\n            break\\n    criteria = []\\n    kinds: dict[str, str] = {}\\n    for l in lines[idx_criteria + 1:]:\\n        s = l.strip()\\n        if not s.startswith(\\\"- \\\") or \\\":\\\" not in s:\\n            continue\\n        body = s[2:]\\n        label = KIND_LABEL.match(body)\\n        kind = \\\"structural\\\"\\n        if label:\\n            body = body[label.end():]\\n            kind = label.group(1).strip()\\n        name = body.split(\\\":\\\", 1)[0].strip()\\n        if kind not in KINDS:\\n            return None, f\\\"criterion has an unknown kind [{kind}]: {name}\\\"\\n        criteria.append(name)\\n        kinds[name] = kind\\n    return {\\\"claims\\\": claims, \\\"criteria\\\": criteria, \\\"kinds\\\": kinds,\\n            \\\"root_cause\\\": root_cause, \\\"class\\\": item_class}, None\\n\\n\\ndef root_causes_path(root: Path, m: dict[str, Any]) -> Path:\\n    \\\"\\\"\\\"The tenant's closed list of root causes: root-causes.md beside\\n    the specs directory (attest/root-causes.md when specs live in\\n    attest/specs). One root cause per line, \\\"- <slug>: <one sentence>\\\".\\\"\\\"\\\"\\n    return root / Path(m[\\\"paths\\\"][\\\"specs\\\"]).parent / \\\"root-causes.md\\\"\\n\\n\\ndef listed_root_causes(path: Path) -> list[str]:\\n    if not path.is_file():\\n        return []\\n    return [mm.group(1) for mm in (ROOT_CAUSE_ENTRY.match(l) for l in path.read_text().splitlines()) if mm]\\n\\n\\ndef root_cause_refusal(root: Path, m: dict[str, Any], root_cause: str | None) -> str | None:\\n    \\\"\\\"\\\"A spec that names a root cause must name one the tenant lists.\\n    Symptom counts do not converge; root-cause counts can, and only if\\n    every root cause a fix item names is one the list already carries or\\n    an item added on purpose. No root-cause line, no check: a capability\\n    item has no root cause.\\\"\\\"\\\"\\n    if root_cause is None:\\n        return None\\n    path = root_causes_path(root, m)\\n    if not path.is_file():\\n        return f\\\"root cause: {root_cause} named but {path.relative_to(root)} does not exist\\\"\\n    if root_cause not in listed_root_causes(path):\\n        return f\\\"root cause: {root_cause} is not listed in {path.relative_to(root)}\\\"\\n    return None\\n\\n\\ndef research_policy(m: dict[str, Any]) -> str:\\n    \\\"\\\"\\\"[spec].research: \\\"required\\\" makes a core spec owe a research record\\n    before its gate passes; absent, it owes none. Ruled 2026-09-27: every\\n    core item owes research in the end state, behind this flag until the\\n    Plan area hosts research. The gate record says which policy applied.\\\"\\\"\\\"\\n    return \\\"required\\\" if (m.get(\\\"spec\\\") or {}).get(\\\"research\\\") == \\\"required\\\" else \\\"not required by policy\\\"\\n\\n\\ndef class_refusal(m: dict[str, Any], parsed: dict[str, Any], records_dir: Path) -> str | None:\\n    \\\"\\\"\\\"A spec declares its class; a spec that names a root cause is core\\n    (ruled 2026-09-27: a root cause lies behind several issues, and closing\\n    it changes the mechanism); and, when the tenant requires research, a\\n    core spec has a research record in the item's records before its gate\\n    passes.\\\"\\\"\\\"\\n    item_class = parsed.get(\\\"class\\\")\\n    if item_class is None:\\n        return \\\"class: none declared; add a line 'Class: core' or 'Class: fix' to the problem\\\"\\n    if item_class not in CLASSES:\\n        return f\\\"class: {item_class} is not core or fix\\\"\\n    if parsed.get(\\\"root_cause\\\") and item_class != \\\"core\\\":\\n        return f\\\"class: {item_class} with root cause {parsed['root_cause']}; a root-cause item is core\\\"\\n    if (item_class == \\\"core\\\" and research_policy(m) == \\\"required\\\"\\n            and latest_record(records_dir, \\\"research\\\") is None):\\n        return \\\"research: [spec].research is required and the item has no research record\\\"\\n    return None\\n\\n\\ndef run_criterion(exe: Path, cwd: Path) -> int:\\n    try:\\n        run = subprocess.run([str(exe)], cwd=str(cwd), capture_output=True,\\n                             timeout=CRITERION_TIMEOUT, check=False)\\n        return run.returncode\\n    except subprocess.TimeoutExpired:\\n        return 124\\n    except OSError:\\n        return 126\\n\\n\\ndef stub_outside_claims(spec_dir: Path, claims: list[str]) -> str | None:\\n    \\\"\\\"\\\"The first path under stub/ (or named in stub/.removed) that no claim\\n    matches, or None. The stub is the change's floor: a path it touches is\\n    a path the build will touch, so a Claims list that does not name it is\\n    wrong before any build runs (item 229: a claim missed at filing cost\\n    an attempt to find). Matched the way cmd_build matches (fnmatch), with\\n    a directory claim covering everything under it.\\\"\\\"\\\"\\n    stub_dir = spec_dir / \\\"stub\\\"\\n    if not stub_dir.is_dir():\\n        return None\\n    paths = sorted(p.relative_to(stub_dir).as_posix() for p in stub_dir.rglob(\\\"*\\\")\\n                   if p.is_file() and p.name != \\\".removed\\\")\\n    paths += parse_removed(stub_dir)\\n    patterns = [c + \\\"**\\\" if c.endswith(\\\"/\\\") else c for c in claims]\\n    for path in paths:\\n        if not any(fnmatch.fnmatch(path, pat) or path.startswith(pat.rstrip(\\\"*\\\")) and pat.endswith(\\\"**\\\")\\n                   for pat in patterns):\\n            return path\\n    return None\\n\\n\\ndef parse_removed(stub_dir: Path) -> list[str]:\\n    \\\"\\\"\\\"The paths listed in stub/.removed, one per line, comments (lines\\n    starting with #) and blank lines ignored. [] when the stub carries no\\n    .removed at all.\\n    \\\"\\\"\\\"\\n    removed_file = stub_dir / \\\".removed\\\"\\n    if not removed_file.is_file():\\n        return []\\n    paths = []\\n    for line in removed_file.read_text().splitlines():\\n        s = line.strip()\\n        if not s or s.startswith(\\\"#\\\"):\\n            continue\\n        paths.append(s)\\n    return paths\\n\\n\\ndef removed_path_refusal(root: Path, stub_dir: Path, rel: str) -> str | None:\\n    p = Path(rel)\\n    if p.is_absolute() or \\\"..\\\" in p.parts:\\n        return f\\\"stub/.removed names a path outside the tree: {rel}\\\"\\n    if not (root / p).exists():\\n        return f\\\"stub/.removed names a path not in the tree: {rel}\\\"\\n    if (stub_dir / p).exists():\\n        return f\\\"stub/.removed names a path the stub also supplies: {rel}\\\"\\n    return None\\n\\n\\ndef stub_removed_refusal(root: Path, spec_dir: Path) -> str | None:\\n    \\\"\\\"\\\"Validated by name, before any criterion runs -- a stub whose\\n    .removed cannot be applied has no meaning to gate against.\\n    \\\"\\\"\\\"\\n    stub_dir = spec_dir / \\\"stub\\\"\\n    for rel in parse_removed(stub_dir):\\n        refusal = removed_path_refusal(root, stub_dir, rel)\\n        if refusal:\\n            return refusal\\n    return None\\n\\n\\ndef run_criteria(root: Path, spec_dir: Path, names: list[str],\\n                 kinds: dict[str, str] | None = None) -> list[dict[str, Any]]:\\n    criteria_dir = spec_dir / \\\"criteria\\\"\\n    stub_dir = spec_dir / \\\"stub\\\"\\n    with tempfile.TemporaryDirectory() as tmp:\\n        tree = Path(tmp) / \\\"tree\\\"\\n        stubbed = Path(tmp) / \\\"stubbed\\\"\\n        shutil.copytree(root, tree, ignore=shutil.ignore_patterns(\\\".git\\\"))\\n        shutil.copytree(root, stubbed, ignore=shutil.ignore_patterns(\\\".git\\\"))\\n        if stub_dir.is_dir():\\n            shutil.copytree(stub_dir, stubbed, dirs_exist_ok=True)\\n            for rel in parse_removed(stub_dir):\\n                target = stubbed / rel\\n                if target.is_dir():\\n                    shutil.rmtree(target)\\n                elif target.exists():\\n                    target.unlink()\\n            removed_marker = stubbed / \\\".removed\\\"\\n            if removed_marker.exists():\\n                removed_marker.unlink()\\n        results = []\\n        for name in names:\\n            exe = criteria_dir / name\\n            results.append({\\\"name\\\": name,\\n                            \\\"kind\\\": (kinds or {}).get(name, \\\"structural\\\"),\\n                            \\\"on_tree\\\": run_criterion(exe, tree),\\n                            \\\"on_stub\\\": run_criterion(exe, stubbed)})\\n        return results\\n\\n\\ndef commit_postdates(root: Path, earlier: str, later: str) -> bool:\\n    \\\"\\\"\\\"Whether later is a strict descendant of earlier on this branch.\\\"\\\"\\\"\\n    if earlier == later:\\n        return False\\n    run = subprocess.run([\\\"git\\\", \\\"-C\\\", str(root), \\\"merge-base\\\", \\\"--is-ancestor\\\", earlier, later],\\n                         capture_output=True, check=False, env=git_env())\\n    return run.returncode == 0\\n\\n\\ndef cmd_spec_gate(argv: list[str]) -> int:\\n    root = Path(\\\".\\\").resolve()\\n    item_id = argv[0] if argv else derive_item_id(root)\\n    if not item_id:\\n        print(\\\"attavo spec-gate: cannot derive item id; pass N or run on an attavo/N-* branch\\\",\\n              file=sys.stderr)\\n        return 2\\n    m = read_manifest(root)\\n    if m is None:\\n        print(f\\\"attavo spec-gate: no {MANIFEST} at {root}\\\", file=sys.stderr)\\n        return 2\\n    specs_rel = m[\\\"paths\\\"][\\\"specs\\\"]\\n    records_rel = m[\\\"paths\\\"][\\\"records\\\"]\\n    spec_dir = root / specs_rel / item_id\\n    spec_md = spec_dir / \\\"spec.md\\\"\\n    if not spec_md.is_file():\\n        print(f\\\"attavo spec-gate: no spec at {spec_dir}\\\", file=sys.stderr)\\n        return 2\\n    spec_rel = str(Path(specs_rel) / item_id)\\n    try:\\n        spec_sha = last_commit_touching(root, spec_rel)\\n    except ShallowCheckoutError as exc:\\n        print(f\\\"attavo spec-gate: refused: {exc}\\\", file=sys.stderr)\\n        return 2\\n\\n    records_dir = root / records_rel / item_id\\n    try:\\n        approved = approval_status(root, m, item_id) == \\\"valid\\\"\\n    except ShallowCheckoutError as exc:\\n        print(f\\\"attavo spec-gate: refused: {exc}\\\", file=sys.stderr)\\n        return 2\\n    latest_approval = latest_record(records_dir, \\\"approval\\\")\\n    if approved:\\n        record: dict[str, Any] = {\\\"sha\\\": git(root, \\\"rev-parse\\\", \\\"HEAD\\\").strip(), \\\"spec_sha\\\": spec_sha,\\n                  \\\"at\\\": now_iso(), \\\"status\\\": \\\"approved\\\",\\n                  \\\"approval_sha\\\": latest_approval.get(\\\"sha\\\") if latest_approval else None,\\n                  \\\"criteria\\\": [], \\\"refusal\\\": None}\\n        write_record(records_dir, \\\"spec\\\", record, m, item_id)\\n        print(\\\"attavo spec-gate: approved (no criteria run)\\\")\\n        return 0\\n\\n    # Third verdict, beside \\\"approved\\\" and Phase 1's \\\"pass\\\": the approval\\n    # is not valid, but a build already ran after it -- the amendment that\\n    # expired the approval landed above the line, not below it, and the\\n    # tree the build produced is what must satisfy the criteria now, not\\n    # the stub that only ever proved they were reachable before approval.\\n    # Issue #98: whatever the build's status, including a halt -- the\\n    # executor commits then asks, so a halted build's sha postdating the\\n    # approval means it did the work. commit_postdates already excludes a\\n    # halt that committed nothing, since such a build's sha equals its\\n    # start_sha and so postdates nothing.\\n    latest_build = latest_record(records_dir, \\\"build\\\")\\n    built = bool(\\n        latest_approval and latest_build\\n        and commit_postdates(root, latest_approval[\\\"sha\\\"], latest_build[\\\"sha\\\"]))\\n\\n    parsed, refusal = parse_spec(spec_md)\\n    results: list[dict[str, Any]] = []\\n    if refusal is None:\\n        # parse_spec returns a refusal exactly when it returns no spec.\\n        parsed = cast(dict[str, Any], parsed)\\n        refusal = root_cause_refusal(root, m, parsed.get(\\\"root_cause\\\"))\\n    if refusal is None and not built:\\n        # Required before approval only: an item already approved and\\n        # built re-gates as it did, so no item in flight is stranded.\\n        refusal = class_refusal(m, cast(dict[str, Any], parsed), records_dir)\\n    if refusal is None:\\n        parsed = cast(dict[str, Any], parsed)\\n        if built:\\n            refusal = stub_removed_refusal(root, spec_dir)\\n            if refusal is None:\\n                # Per criterion, not the set: passing on the tree is what\\n                # the build already satisfied; failing on the tree but\\n                # passing on the stub is a new obligation the next build\\n                # must meet -- an operator scripting a ruling the executor\\n                # skipped. Refused only when a criterion satisfies neither.\\n                results = run_criteria(root, spec_dir, parsed[\\\"criteria\\\"], parsed[\\\"kinds\\\"])\\n                # A behavioural criterion fails on the stub by design, so\\n                # after a build it is judged on the tree alone.\\n                fail_behav = next((c for c in results\\n                                   if c[\\\"kind\\\"] == \\\"behavioural\\\" and c[\\\"on_tree\\\"] != 0), None)\\n                fail = next((c for c in results if c[\\\"kind\\\"] == \\\"structural\\\"\\n                             and c[\\\"on_tree\\\"] != 0 and c[\\\"on_stub\\\"] != 0), None)\\n                if fail_behav:\\n                    refusal = f\\\"criterion labelled behavioural fails on the tree: {fail_behav['name']}\\\"\\n                elif fail:\\n                    refusal = f\\\"criterion fails against the tree plus stub: {fail['name']}\\\"\\n        elif not parsed[\\\"claims\\\"]:\\n            refusal = \\\"claims: empty; the build may touch nothing\\\"\\n        elif not parsed[\\\"criteria\\\"]:\\n            # Zero criteria match zero files in criteria/, so the prose check\\n            # below would pass a spec that asserts nothing, and approve it.\\n            refusal = \\\"criteria: empty; the spec asserts nothing\\\"\\n        elif stub_outside_claims(spec_dir, parsed[\\\"claims\\\"]) is not None:\\n            refusal = (\\\"stub touches a path the claims do not name: \\\"\\n                       f\\\"{stub_outside_claims(spec_dir, parsed['claims'])}\\\")\\n        elif parsed[\\\"criteria\\\"] and \\\"structural\\\" not in parsed[\\\"kinds\\\"].values():\\n            # A behavioural criterion only has to fail on the stub, so a\\n            # spec of nothing else proves nothing reachable before approval.\\n            refusal = (\\\"no structural criterion: nothing shows the stub reaches \\\"\\n                       \\\"what the behavioural criteria test\\\")\\n        else:\\n            criteria_dir = spec_dir / \\\"criteria\\\"\\n            listed = parsed[\\\"criteria\\\"]\\n            existing = sorted(p.name for p in criteria_dir.iterdir()) if criteria_dir.is_dir() else []\\n            prose = None\\n            for name in listed:\\n                if name not in existing:\\n                    prose = name\\n                    break\\n            if prose is None:\\n                for name in existing:\\n                    if name not in listed:\\n                        prose = name\\n                        break\\n            if prose is None:\\n                for name in listed:\\n                    if not os.access(criteria_dir / name, os.X_OK):\\n                        prose = name\\n                        break\\n            if prose:\\n                refusal = f\\\"criterion is prose: {prose}\\\"\\n            else:\\n                refusal = stub_removed_refusal(root, spec_dir)\\n                if refusal is None:\\n                    results = run_criteria(root, spec_dir, listed, parsed[\\\"kinds\\\"])\\n                    fail_tree = next((c for c in results if c[\\\"on_tree\\\"] == 0), None)\\n                    if fail_tree:\\n                        refusal = f\\\"criterion passes against the tree: {fail_tree['name']}\\\"\\n                    else:\\n                        # The label is checked against the measured exits.\\n                        fail_stub = next((c for c in results if c[\\\"kind\\\"] == \\\"structural\\\"\\n                                          and c[\\\"on_stub\\\"] != 0), None)\\n                        pass_stub = next((c for c in results if c[\\\"kind\\\"] == \\\"behavioural\\\"\\n                                          and c[\\\"on_stub\\\"] == 0), None)\\n                        if fail_stub:\\n                            refusal = (\\\"criterion labelled structural fails on the tree plus stub: \\\"\\n                                       f\\\"{fail_stub['name']}\\\")\\n                        elif pass_stub:\\n                            refusal = (\\\"criterion labelled behavioural passes on the tree plus stub: \\\"\\n                                       f\\\"{pass_stub['name']}\\\")\\n\\n    status = \\\"refused\\\" if refusal else (\\\"built\\\" if built else \\\"pass\\\")\\n    record = {\\\"sha\\\": git(root, \\\"rev-parse\\\", \\\"HEAD\\\").strip(),\\n              \\\"spec_sha\\\": spec_sha,\\n              \\\"at\\\": now_iso(), \\\"status\\\": status, \\\"approval_sha\\\": None,\\n              \\\"criteria\\\": results, \\\"refusal\\\": refusal,\\n              \\\"class\\\": (parsed or {}).get(\\\"class\\\"), \\\"research\\\": research_policy(m)}\\n    write_record(records_dir, \\\"spec\\\", record, m, item_id)\\n\\n    if refusal:\\n        print(f\\\"attavo spec-gate: refused: {refusal}\\\")\\n        return 1\\n    print(f\\\"attavo spec-gate: {status} ({len(results)} criterion/criteria)\\\")\\n    return 0\\n\\n\\nCRITERION_TIMEOUT = 120\\n\\n\\nCOMMANDS = (\\n    Command(\\n        name='spec-gate',\\n        run=cmd_spec_gate,\\n        usage=('attavo spec-gate [N]',),\\n        rank=20,\\n        help=(\\n            (50, \\\"\\\"\\\"\\\\\\nspec-gate, approve, and approval-status are gates and writers. They run\\nfrom the tenant root (the current working directory); N, the work item id,\\nis read from the ATTAVO_ITEM environment variable when set, else from the\\nbranch (attavo/N-*). The doctor's first proof sets ATTAVO_ITEM for a\\nrejection fixture's own item, so a gate's own command needs no argument\\neven while the enclosing repository sits on a real item's attavo/N-*\\nbranch. Every run of spec-gate or approve writes the next numbered attempt\\nfile under paths.records/N/ and never overwrites one already written. A\\nfix item's spec may name the root cause its change closes as one\\n\\\"Root-cause: <slug>\\\" line in the problem; spec-gate refuses a slug the\\ntenant's root-causes.md (beside paths.specs) does not list, or any slug\\nwhen that file is absent, before any criterion runs -- a spec with no\\nroot-cause line is untouched. spec-gate also refuses, before any\\ncriterion runs, \\\"stub touches a path the claims do not name: <path>\\\" for\\nthe first path under stub/ (or in stub/.removed) that no claim matches.\\nA criterion line may carry a kind after its dash, \\\"- [behavioural] name.sh: ...\\\"\\nor \\\"- [structural] name.sh: ...\\\"; unlabelled is structural. Structural must\\nfail on the tree and pass on the tree plus stub; behavioural must fail on\\nboth, so the stub can be thin; before approval a spec needs at least one\\nstructural criterion. A label the measured exits contradict is\\nrefused by name, as is an unknown one. After a build a behavioural\\ncriterion must pass on the tree.\\nSee the spec contract in the project's Phase 1 issue for the full rules\\neach one enforces.\\\"\\\"\\\"),\\n        ),\\n    ),\\n)\\n\",\"numLines\":454,\"startLine\":1,\"totalLines\":454}},\"tool_result_meta\":[{\"id\":\"toolu_0191VQy42usMJpjMPihchAve\",\"permission_decision\":{\"decision\":\"accept\",\"source\":\"config\",\"reason_type\":\"rule\"}}]}\n+{\"type\":\"system\",\"subtype\":\"thinking_tokens\",\"estimated_tokens\":50,\"estimated_tokens_delta\":50,\"session_id\":\"0fabd1e2-92b8-4212-a6d0-e85fc14548ff\",\"uuid\":\"1bd43b71-5bef-422d-988b-3f963dd3f0e9\"}\n+{\"type\":\"system\",\"subtype\":\"thinking_tokens\",\"estimated_tokens\":150,\"estimated_tokens_delta\":100,\"session_id\":\"0fabd1e2-92b8-4212-a6d0-e85fc14548ff\",\"uuid\":\"3d1c913e-c40c-45f3-85c1-610ebf6ff33d\"}\n+{\"type\":\"system\",\"subtype\":\"thinking_tokens\",\"estimated_tokens\":300,\"estimated_tokens_delta\":150,\"session_id\":\"0fabd1e2-92b8-4212-a6d0-e85fc14548ff\",\"uuid\":\"d4c39bab-ab23-4007-8e39-bada913b5158\"}\n+{\"type\":\"system\",\"subtype\":\"thinking_tokens\",\"estimated_tokens\":400,\"estimated_tokens_delta\":100,\"session_id\":\"0fabd1e2-92b8-4212-a6d0-e85fc14548ff\",\"uuid\":\"503da901-585f-4466-919e-8a4edce5ebd9\"}\n+{\"type\":\"system\",\"subtype\":\"thinking_tokens\",\"estimated_tokens\":550,\"estimated_tokens_delta\":150,\"session_id\":\"0fabd1e2-92b8-4212-a6d0-e85fc14548ff\",\"uuid\":\"9ad71caa-24ed-4215-b49a-0db6725db501\"}\n+{\"type\":\"system\",\"subtype\":\"thinking_tokens\",\"estimated_tokens\":700,\"estimated_tokens_delta\":150,\"session_id\":\"0fabd1e2-92b8-4212-a6d0-e85fc14548ff\",\"uuid\":\"9a0ab77c-3505-40d3-90a0-9c8a93f67a47\"}\n+{\"type\":\"system\",\"subtype\":\"thinking_tokens\",\"estimated_tokens\":800,\"estimated_tokens_delta\":100,\"session_id\":\"0fabd1e2-92b8-4212-a6d0-e85fc14548ff\",\"uuid\":\"475b8de0-26ef-4784-99b7-b65539c314cb\"}\n+{\"type\":\"system\",\"subtype\":\"thinking_tokens\",\"estimated_tokens\":900,\"estimated_tokens_delta\":100,\"session_id\":\"0fabd1e2-92b8-4212-a6d0-e85fc14548ff\",\"uuid\":\"947da68c-061c-412c-9417-494a36f2e567\"}\n+{\"type\":\"system\",\"subtype\":\"thinking_tokens\",\"estimated_tokens\":1000,\"estimated_tokens_delta\":100,\"session_id\":\"0fabd1e2-92b8-4212-a6d0-e85fc14548ff\",\"uuid\":\"50b9e442-5d15-4d4e-8e7b-29f36d19b6f6\"}\n+{\"type\":\"system\",\"subtype\":\"thinking_tokens\",\"estimated_tokens\":1150,\"estimated_tokens_delta\":150,\"session_id\":\"0fabd1e2-92b8-4212-a6d0-e85fc14548ff\",\"uuid\":\"dab9a297-a0ea-482e-95be-68c13bf326d6\"}\n+{\"type\":\"system\",
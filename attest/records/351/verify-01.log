tmp/xcrun_db-PS6Q8HKQ' (errno=Operation not permitted)\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tmp/xcrun_db-6uFl6QFZ' (errno=Operation not permitted)\ndiff --git a/attavo/spec.py b/attavo/spec.py\nindex 2dc3389..e97e73e 100644\n--- a/attavo/spec.py\n+++ b/attavo/spec.py\n@@ -247,6 +247,18 @@ def run_criteria(root: Path, spec_dir: Path, names: list[str],\n         return results\n \n \n+def could_not_check_refusal(results: list[dict[str, Any]]) -> str | None:\n+    \"\"\"Exit codes are a contract: 0 when a criterion holds, 1 when its\n+    assertion fails, and nothing else -- any other exit, on the tree or the\n+    stub, means the criterion could not check at all (its own setup failed,\n+    or it crashed) and is refused by name before its kind is judged.\"\"\"\n+    for c in results:\n+        for exit_code in (c[\"on_tree\"], c[\"on_stub\"]):\n+            if exit_code not in (0, 1):\n+                return f\"criterion could not check (exit {exit_code}): {c['name']}\"\n+    return None\n+\n+\n def commit_postdates(root: Path, earlier: str, later: str) -> bool:\n     \"\"\"Whether later is a strict descendant of earlier on this branch.\"\"\"\n     if earlier == later:\n@@ -333,16 +345,18 @@ def cmd_spec_gate(argv: list[str]) -> int:\n                 # must meet -- an operator scripting a ruling the executor\n                 # skipped. Refused only when a criterion satisfies neither.\n                 results = run_criteria(root, spec_dir, parsed[\"criteria\"], parsed[\"kinds\"])\n-                # A behavioural criterion fails on the stub by design, so\n-                # after a build it is judged on the tree alone.\n-                fail_behav = next((c for c in results\n-                                   if c[\"kind\"] == \"behavioural\" and c[\"on_tree\"] != 0), None)\n-                fail = next((c for c in results if c[\"kind\"] == \"structural\"\n-                             and c[\"on_tree\"] != 0 and c[\"on_stub\"] != 0), None)\n-                if fail_behav:\n-                    refusal = f\"criterion labelled behavioural fails on the tree: {fail_behav['name']}\"\n-                elif fail:\n-                    refusal = f\"criterion fails against the tree plus stub: {fail['name']}\"\n+                refusal = could_not_check_refusal(results)\n+                if refusal is None:\n+                    # A behavioural criterion fails on the stub by design, so\n+                    # after a build it is judged on the tree alone.\n+                    fail_behav = next((c for c in results\n+                                       if c[\"kind\"] == \"behavioural\" and c[\"on_tree\"] != 0), None)\n+                    fail = next((c for c in results if c[\"kind\"] == \"structural\"\n+                                 and c[\"on_tree\"] != 0 and c[\"on_stub\"] != 0), None)\n+                    if fail_behav:\n+                        refusal = f\"criterion labelled behavioural fails on the tree: {fail_behav['name']}\"\n+                    elif fail:\n+                        refusal = f\"criterion fails against the tree plus stub: {fail['name']}\"\n         elif not parsed[\"claims\"]:\n             refusal = \"claims: empty; the build may touch nothing\"\n         elif not parsed[\"criteria\"]:\n@@ -382,6 +396,8 @@ def cmd_spec_gate(argv: list[str]) -> int:\n                 refusal = stub_removed_refusal(root, spec_dir)\n                 if refusal is None:\n                     results = run_criteria(root, spec_dir, listed, parsed[\"kinds\"])\n+                    refusal = could_not_check_refusal(results)\n+                if refusal is None:\n                     fail_tree = next((c for c in results if c[\"on_tree\"] == 0), None)\n                     if fail_tree:\n                         refusal = f\"criterion passes against the tree: {fail_tree['name']}\"\n@@ -446,6 +462,13 @@ both, so the stub can be thin; before approval a spec needs at least one\n structural criterion. A label the measured exits contradict is\n refused by name, as is an unknown one. After a build a behavioural\n criterion must pass on the tree.\n+Exit codes are a contract: a criterion exits 0 when it holds, 1 when its\n+assertion fails, and anything else when it could not check. Before\n+approval, every criterion must exit exactly 1 on the tree, and a\n+behavioural one exactly 1 on the tree plus stub; after a build, a\n+criterion whose exit is neither 0 nor 1 is refused the same way. Either\n+way it is refused as \"criterion could not check (exit N): <name>\",\n+before kinds are judged, and never counted as a failing criterion.\n See the spec contract in the project's Phase 1 issue for the full rules\n each one enforces.\"\"\"),\n         ),\ndiff --git a/tests/test_spec_gate.py b/tests/test_spec_gate.py\nindex b0b7f4f..d90f045 100644\n--- a/tests/test_spec_gate.py\n+++ b/tests/test_spec_gate.py\n@@ -783,3 +783,48 @@ def test_a_spec_with_no_criteria_is_refused_before_any_criterion_runs(tmp_path:\n     assert rec[\"status\"] == \"refused\"\n     assert rec[\"criteria\"] == []\n     assert rec[\"refusal\"] == NO_CRITERIA\n+\n+\n+# Issue #351: a criterion that could not check is not a failing criterion.\n+\n+COULD_NOT_CHECK = \"criterion could not check (exit 2): \"\n+\n+\n+def test_a_behavioural_criterion_that_exits_other_than_1_on_both_is_refused_by_name(tmp_path: Path) -> None:\n+    \"\"\"Specimen: #349's behavioural criterion exited 2 (its own code for\n+    \"the scenario could not be set up\") on the tree and on the stub in the\n+    CI gate, and v0.34.0 accepted 2/2 as \"fails on both\".\"\"\"\n+    root = make_tenant(tmp_path, \"valid\")\n+    set_criteria(root, [STRUCT, \"- [behavioural] broken.sh: a scenario that cannot be set up\"],\n+                 {\"checks_marker.sh\": \"test -f src/marker.txt || exit 1\",\n+                  \"broken.sh\": \"exit 2\"},\n+                 THIN_STUB)\n+    run = run_attavo(root, \"spec-gate\", \"1\")\n+    assert run.returncode == 1, run.stdout + run.stderr\n+    assert COULD_NOT_CHECK + \"broken.sh\" in run.stdout, run.stdout\n+    rec = latest_record(root, \"1\", \"spec\")\n+    assert rec[\"status\"] == \"refused\" and rec[\"refusal\"] == COULD_NOT_CHECK + \"broken.sh\"\n+\n+\n+def test_a_structural_criterion_that_exits_other_than_1_on_the_tree_is_refused_by_name(tmp_path: Path) -> None:\n+    \"\"\"`grep -q` on a missing file exits 2; a structural criterion must say\n+    1 when the thing it checks is absent, so a crash is told from a no.\"\"\"\n+    root = make_tenant(tmp_path, \"valid\")\n+    set_criteria(root, [\"- [structural] crashes.sh: the marker file exists\"],\n+                 {\"crashes.sh\": \"test -f src/marker.txt || exit 3\"},\n+                 THIN_STUB)\n+    run = run_attavo(root, \"spec-gate\", \"1\")\n+    assert run.returncode == 1, run.stdout + run.stderr\n+    assert \"criterion could not check (exit 3): crashes.sh\" in run.stdout, run.stdout\n+    assert latest_record(root, \"1\", \"spec\")[\"refusal\"] == \"criterion could not check (exit 3): crashes.sh\"\n+\n+\n+def test_a_thin_stub_whose_criteria_exit_exactly_1_still_passes(tmp_path: Path) -> None:\n+    root = make_tenant(tmp_path, \"valid\")\n+    set_criteria(root, [STRUCT, BEHAV],\n+                 {\"checks_marker.sh\": \"test -f src/marker.txt || exit 1\",\n+                  \"logic.sh\": \"test \\\"$(cat src/logic.txt 2>/dev/null)\\\" = done || exit 1\"},\n+                 THIN_STUB)\n+    run = run_attavo(root, \"spec-gate\", \"1\")\n+    assert run.returncode == 0, run.stdout + run.stderr\n+    assert latest_record(root, \"1\", \"spec\")[\"status\"] == \"pass\"\n{\n  \"sha\": \"95cc223178c88362da6963f54007d2db14151d8d\",\n  \"spec_sha\": \"95cc223178c88362da6963f54007d2db14151d8d\",\n  \"at\": \"2026-10-14T19:53:16Z\",\n  \"status\": \"pass\",\n  \"approval_sha\": null,\n  \"criteria\": [\n    {\n      \"name\": \"the-rejection-tests-exist.sh\",\n      \"kind\": \"structural\",\n      \"on_tree\": 1,\n      \"on_stub\": 0\n    },\n    {\n      \"name\": \"a-criterion-that-could-not-check-is-refused.sh\",\n      \"kind\": \"behavioural\",\n      \"on_tree\": 1,\n      \"on_stub\": 1\n    }\n  ],\n  \"refusal\": null,\n  \"class\": \"fix\",\n  \"research\": \"not required by policy\",\n  \"record_version\": 4,\n  \"item\": \"351\",\n  \"product_version\": \"v0.34.0\",\n  \"product_pin\": \"v0.34.0\"\n}\n## Problem\n\nClass: fix\n\nA behavioural criterion passes the gate on any failure, including a failure of its own setup. Under #340 a behavioural criterion only has to fail on the tree and on the tree plus stub, so a script that cannot set up its scenario fails on both and the gate accepts it. The build can then never satisfy it: prose with an exit code.\n\nSpecimen: #349's behavioural criterion exited 2, its own code for \"the scenario could not be set up\", on the tree and on the stub in the CI gate; v0.34.0 accepted 2/2 as \"fails on both\". Only its push script, on the operator's Mac, had required exactly 1. A second: `grep -q` on a missing file exits 2, so a structural criterion written that way cannot be told from a crash.\n\nThe change: exit codes are a contract. A criterion exits 0 when it holds, 1 when its assertion fails, and anything else when it could not check. Before approval, every criterion must exit exactly 1 on the tree, and a behavioural one exactly 1 on the tree plus stub; any other non-zero exit is refused before kinds are judged, as \"criterion could not check (exit N): <name>\". After a build, a criterion whose exit is neither 0 nor 1 is refused the same way, never judged. The spec-gate help says so. Merged specs are not re-gated and are left as they are.\n\nThe stub is thin: three tests in `tests/test_spec_gate.py`, red on the stub (the two refusals) and one holding the thin-stub pass with criteria that exit exactly 1. The build writes the logic.\n\nRetires: \"fails\" meaning any non-zero exit.\n\n## Claims\n\n- attavo/spec.py\n- tests/test_spec_gate.py\n\n## Criteria\n\n- [structural] the-rejection-tests-exist.sh: tests/test_spec_gate.py carries test_a_behavioural_criterion_that_exits_other_than_1_on_both_is_refused_by_name and test_a_structural_criterion_that_exits_other_than_1_on_the_tree_is_refused_by_name\n- [behavioural] a-criterion-that-could-not-check-is-refused.sh: on the valid fixture, a behavioural criterion that exits 2 on the tree and on the stub is refused with \"criterion could not check (exit 2): broken.sh\", with the record's refusal saying the same\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_5","type":"agent_message","text":"{\"findings\":[{\"title\":\"The gate judges criterion kinds before enforcing the exit-code contract\",\"specimen\":\"attavo/spec.py:369\",\"retires\":\"The guarantee that every non-0/1 result is refused as “criterion could not check” before kinds are judged\",\"rejection_test\":\"test_a_spec_with_only_a_behavioural_criterion_that_cannot_check_reports_the_exit_code_refusal_before_no_structural\",\"severity\":\"Blocking when a pre-approval spec has no structural criterion and a behavioural criterion exits outside 0/1; the gate reports the kind-based “no structural criterion” refusal without running or recording the broken criterion.\"}],\"tests_named\":[\"test_a_spec_with_only_a_behavioural_criterion_that_cannot_check_reports_the_exit_code_refusal_before_no_structural\"]}"}}

ec-gate` subcommand, so\\nevery one of these failed with \\\"unknown subcommand\\\".\\n\\nRun: python3 -m pytest tests -q\\n\\\"\\\"\\\"\\nimport json\\nimport os\\nimport shutil\\nimport subprocess\\nimport sys\\nfrom pathlib import Path\\nfrom typing import Any, cast\\n\\nimport pytest\\nfrom helpers import commit_all, git, make_tenant\\n\\nROOT = Path(__file__).resolve().parent.parent\\nATTAVO = ROOT / \\\"bin\\\" / \\\"attavo\\\"\\n\\n\\ndef run_attavo(root: Path, *args: str, env: dict[str, Any] | None = None) -> subprocess.CompletedProcess[str]:\\n    full_env = dict(os.environ)\\n    if env:\\n        full_env.update(env)\\n    return subprocess.run([sys.executable, str(ATTAVO), *args], cwd=str(root),\\n                          capture_output=True, text=True, check=False, env=full_env)\\n\\n\\ndef latest_record(root: Path, item: str, stage: str) -> dict[str, Any]:\\n    records = sorted((root / \\\"records\\\" / item).glob(f\\\"{stage}-*.json\\\"))\\n    assert records, f\\\"no {stage} record for item {item}\\\"\\n    return cast(dict[str, Any], json.loads(records[-1].read_text()))\\n\\n\\ndef test_spec_gate_refuses_prose_criterion(tmp_path: Path) -> None:\\n    root = make_tenant(tmp_path, \\\"prose_criterion\\\")\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 1\\n    assert \\\"missing.sh\\\" in run.stdout\\n    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n    assert rec[\\\"status\\\"] == \\\"refused\\\"\\n    assert \\\"missing.sh\\\" in rec[\\\"refusal\\\"]\\n    # issue #49: this fixture's manifest carries no [attavo] table at all --\\n    # product_pin is the absent fact, null, not a crash reading it.\\n    assert rec[\\\"product_pin\\\"] is None\\n    assert rec[\\\"product_version\\\"]\\n\\n\\ndef test_spec_gate_refuses_criterion_passing_on_tree(tmp_path: Path) -> None:\\n    root = make_tenant(tmp_path, \\\"passes_on_tree\\\")\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 1\\n    assert \\\"checks.sh\\\" in run.stdout\\n...\\n</persisted-output>\",\"is_error\":false}]},\"parent_tool_use_id\":null,\"session_id\":\"0fabd1e2-92b8-4212-a6d0-e85fc14548ff\",\"uuid\":\"ad1d8aaf-2ecf-4a1c-981a-959804905151\",\"timestamp\":\"2026-10-14T19:57:53.628Z\",\"tool_use_result\":{\"stdout\":\"\\\"\\\"\\\"The spec contract: attavo spec-gate N.\\n\\nEach test is a rejection test, written and run red before the capability\\nexisted: on `main` at commit 22ca1e1 there was no `spec-gate` subcommand, so\\nevery one of these failed with \\\"unknown subcommand\\\".\\n\\nRun: python3 -m pytest tests -q\\n\\\"\\\"\\\"\\nimport json\\nimport os\\nimport shutil\\nimport subprocess\\nimport sys\\nfrom pathlib import Path\\nfrom typing import Any, cast\\n\\nimport pytest\\nfrom helpers import commit_all, git, make_tenant\\n\\nROOT = Path(__file__).resolve().parent.parent\\nATTAVO = ROOT / \\\"bin\\\" / \\\"attavo\\\"\\n\\n\\ndef run_attavo(root: Path, *args: str, env: dict[str, Any] | None = None) -> subprocess.CompletedProcess[str]:\\n    full_env = dict(os.environ)\\n    if env:\\n        full_env.update(env)\\n    return subprocess.run([sys.executable, str(ATTAVO), *args], cwd=str(root),\\n                          capture_output=True, text=True, check=False, env=full_env)\\n\\n\\ndef latest_record(root: Path, item: str, stage: str) -> dict[str, Any]:\\n    records = sorted((root / \\\"records\\\" / item).glob(f\\\"{stage}-*.json\\\"))\\n    assert records, f\\\"no {stage} record for item {item}\\\"\\n    return cast(dict[str, Any], json.loads(records[-1].read_text()))\\n\\n\\ndef test_spec_gate_refuses_prose_criterion(tmp_path: Path) -> None:\\n    root = make_tenant(tmp_path, \\\"prose_criterion\\\")\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 1\\n    assert \\\"missing.sh\\\" in run.stdout\\n    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n    assert rec[\\\"status\\\"] == \\\"refused\\\"\\n    assert \\\"missing.sh\\\" in rec[\\\"refusal\\\"]\\n    # issue #49: this fixture's manifest carries no [attavo] table at all --\\n    # product_pin is the absent fact, null, not a crash reading it.\\n    assert rec[\\\"product_pin\\\"] is None\\n    assert rec[\\\"product_version\\\"]\\n\\n\\ndef test_spec_gate_refuses_criterion_passing_on_tree(tmp_path: Path) -> None:\\n    root = make_tenant(tmp_path, \\\"passes_on_tree\\\")\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 1\\n    assert \\\"checks.sh\\\" in run.stdout\\n    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n    assert rec[\\\"status\\\"] == \\\"refused\\\"\\n    assert \\\"checks.sh\\\" in rec[\\\"refusal\\\"]\\n\\n\\ndef test_spec_gate_refuses_criterion_failing_on_stub(tmp_path: Path) -> None:\\n    root = make_tenant(tmp_path, \\\"fails_on_stub\\\")\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 1\\n    assert \\\"checks.sh\\\" in run.stdout\\n    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n    assert rec[\\\"status\\\"] == \\\"refused\\\"\\n    assert \\\"checks.sh\\\" in rec[\\\"refusal\\\"]\\n\\n\\ndef test_spec_gate_refuses_wrong_headings(tmp_path: Path) -> None:\\n    root = make_tenant(tmp_path, \\\"wrong_headings\\\")\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 1\\n    assert \\\"Design\\\" in run.stdout\\n    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n    assert rec[\\\"status\\\"] == \\\"refused\\\"\\n    assert \\\"Design\\\" in rec[\\\"refusal\\\"]\\n\\n\\ndef test_spec_gate_passes_and_writes_record(tmp_path: Path) -> None:\\n    root = make_tenant(tmp_path, \\\"valid\\\")\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 0\\n\\n    first = root / \\\"records\\\" / \\\"1\\\" / \\\"spec-01.json\\\"\\n    assert first.is_file()\\n    rec = json.loads(first.read_text())\\n    assert rec[\\\"status\\\"] == \\\"pass\\\"\\n    assert rec[\\\"spec_sha\\\"]\\n    assert rec[\\\"criteria\\\"] == [{\\\"name\\\": \\\"checks_marker.sh\\\", \\\"kind\\\": \\\"structural\\\", \\\"on_tree\\\": 1, \\\"on_stub\\\": 0}]\\n    assert rec[\\\"refusal\\\"] is None\\n\\n    run2 = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run2.returncode == 0\\n    assert (root / \\\"records\\\" / \\\"1\\\" / \\\"spec-02.json\\\").is_file()\\n\\n\\ndef amend_problem(root: Path) -> None:\\n    spec_md = root / \\\"specs\\\" / \\\"1\\\" / \\\"spec.md\\\"\\n    spec_md.write_text(spec_md.read_text().replace(\\n        \\\"does not emit\\\", \\\"used to not emit\\\"))\\n    commit_all(root, \\\"amend problem prose\\\")\\n\\n\\ndef approve_valid(root: Path) -> None:\\n    assert run_attavo(root, \\\"spec-gate\\\", \\\"1\\\").returncode == 0\\n    assert run_attavo(root, \\\"approve\\\", \\\"1\\\", \\\"--by\\\", \\\"alice\\\").returncode == 0\\n\\n\\ndef complete_the_build(root: Path) -> None:\\n    \\\"\\\"\\\"The marker.txt the criterion checks for, committed with no touch to\\n    spec.md: the same commit shape a real `attavo build` leaves behind --\\n    spec_sha, and so the approval, is unchanged.\\\"\\\"\\\"\\n    (root / \\\"src\\\").mkdir(parents=True, exist_ok=True)\\n    (root / \\\"src\\\" / \\\"marker.txt\\\").write_text(\\\"built\\\\n\\\")\\n    commit_all(root, \\\"build completed\\\")\\n\\n\\ndef test_spec_gate_reports_approved_when_approval_is_valid(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Issue #21, acceptance 1. Once a build has made the criterion pass on\\n    the tree, the gate must not re-run it and refuse the very success\\n    approval exists to bind: it reports the approval instead. Red today:\\n    the unmodified gate refuses this by name (\\\"criterion passes against\\n    the tree: checks_marker.sh\\\").\\n    \\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"valid\\\")\\n    approve_valid(root)\\n    complete_the_build(root)\\n\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 0\\n\\n    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n    assert rec[\\\"status\\\"] == \\\"approved\\\"\\n    assert rec[\\\"criteria\\\"] == []\\n    assert rec[\\\"refusal\\\"] is None\\n    assert rec[\\\"spec_sha\\\"]\\n    approval = json.loads(sorted((root / \\\"records\\\" / \\\"1\\\").glob(\\\"approval-*.json\\\"))[-1].read_text())\\n    assert rec[\\\"approval_sha\\\"] == approval[\\\"sha\\\"]\\n\\n\\ndef test_spec_gate_runs_when_approval_expired(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Issue #21, acceptance 2. The same fixture, after an edit above the\\n    line expires the approval: the gate must fall through to running the\\n    criteria for real, not keep reporting approved past the approval it\\n    no longer holds.\\n    \\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"valid\\\")\\n    approve_valid(root)\\n    complete_the_build(root)\\n    assert run_attavo(root, \\\"spec-gate\\\", \\\"1\\\").returncode == 0  # approved, short-circuited\\n\\n    amend_problem(root)\\n\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 1\\n    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n    assert rec[\\\"status\\\"] == \\\"refused\\\"\\n    assert \\\"checks_marker.sh\\\" in rec[\\\"refusal\\\"]\\n\\n\\ndef run_real_build(root: Path) -> subprocess.CompletedProcess[str]:\\n    \\\"\\\"\\\"A real `attavo build`, the fixture adapter writing the marker.txt\\n    the criterion checks for -- inside src/**, the claim -- unlike\\n    complete_the_build above, which only fakes the commit shape.\\\"\\\"\\\"\\n    return run_attavo(root, \\\"build\\\", \\\"1\\\", env={\\\"ATTAVO_FIXTURE_WRITE\\\": \\\"src/marker.txt\\\"})\\n\\n\\ndef test_spec_gate_built_after_build(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Issue #28, acceptance 1. Approve, build for real, then an\\n    amendment above the line expires the approval: the gate reports\\n    status built, not a refusal. Red today: refused for passing on the\\n    tree, PR #600's specimen.\\n\\n    Issue #36 changed built to judge each criterion (both on_tree and\\n    on_stub, as a pass record already does) rather than the tree alone;\\n    this fixture's stub also satisfies checks_marker.sh, so on_stub is\\n    0 here, not null -- the null-on_stub shape was retired with the\\n    \\\"criterion fails against the tree\\\" refusal it belonged to.\\n    \\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"valid\\\")\\n    approve_valid(root)\\n    assert run_real_build(root).returncode == 0\\n\\n    amend_problem(root)\\n\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 0\\n\\n    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n    assert rec[\\\"status\\\"] == \\\"built\\\"\\n    assert rec[\\\"criteria\\\"] == [{\\\"name\\\": \\\"checks_marker.sh\\\", \\\"kind\\\": \\\"structural\\\", \\\"on_tree\\\": 0, \\\"on_stub\\\": 0}]\\n    assert rec[\\\"refusal\\\"] is None\\n\\n\\ndef test_spec_gate_built_refuses_a_failing_criterion(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Issue #28, acceptance 2. Same shape, but a criterion no longer\\n    satisfiable at all -- gone from the tree and from the stub overlay\\n    both -- is refused by name, not rubber-stamped built just because a\\n    build record exists.\\n\\n    Issue #36 made built judge tree-fail-stub-pass as an accepted new\\n    obligation, not a refusal, so this specimen must fail on the stub\\n    too (removed from specs/1/stub/, not just the real tree) to still\\n    exercise a refusal at all.\\n    \\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"valid\\\")\\n    approve_valid(root)\\n    assert run_real_build(root).returncode == 0\\n\\n    (root / \\\"src\\\" / \\\"marker.txt\\\").unlink()\\n    (root / \\\"specs\\\" / \\\"1\\\" / \\\"stub\\\" / \\\"src\\\" / \\\"marker.txt\\\").unlink()\\n    commit_all(root, \\\"regression: the marker is gone from the tree and the stub\\\")\\n    amend_problem(root)\\n\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 1\\n\\n    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n    assert rec[\\\"status\\\"] == \\\"refused\\\"\\n    assert rec[\\\"refusal\\\"] == \\\"criterion fails against the tree plus stub: checks_marker.sh\\\"\\n    assert rec[\\\"criteria\\\"] == [{\\\"name\\\": \\\"checks_marker.sh\\\", \\\"kind\\\": \\\"structural\\\", \\\"on_tree\\\": 1, \\\"on_stub\\\": 1}]\\n\\n\\ndef test_spec_gate_removed_deletes_the_path_from_the_stub(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Issue #132, acceptance 1. stub/.removed names a path the change\\n    deletes; the gate must drop it from the stubbed copy before running\\n    the criteria, so a criterion asserting its absence passes on the\\n    stub and fails on the tree, where the path is still there. Red\\n    today: the overlay is add-only, so the path survives into the\\n    stubbed tree and the criterion fails on both.\\n    \\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"removed_present\\\")\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 0\\n\\n    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n    assert rec[\\\"status\\\"] == \\\"pass\\\"\\n    assert rec[\\\"criteria\\\"] == [{\\\"name\\\": \\\"absent.sh\\\", \\\"kind\\\": \\\"structural\\\", \\\"on_tree\\\": 1, \\\"on_stub\\\": 0}]\\n    assert rec[\\\"refusal\\\"] is None\\n\\n\\ndef test_spec_gate_removed_refuses_a_path_absent_from_the_tree(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Issue #132, acceptance 2. A .removed entry naming a path that\\n    isn't in the tree at all removes nothing, so it is refused by name\\n    before any criterion runs -- no criteria entries in the record.\\n    \\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"removed_absent\\\")\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 1\\n    assert \\\"nope.txt\\\" in run.stdout\\n\\n    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n    assert rec[\\\"status\\\"] == \\\"refused\\\"\\n    assert \\\"nope.txt\\\" in rec[\\\"refusal\\\"]\\n    assert rec[\\\"criteria\\\"] == []\\n\\n\\ndef test_spec_gate_removed_refuses_a_path_the_stub_also_supplies(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Issue #132, acceptance 3. A path named in .removed that the stub\\n    also supplies is a contradiction -- add and remove the same path --\\n    and is refused by name before any criterion runs.\\n    \\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"removed_contradicts_stub\\\")\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 1\\n    assert \\\"src/marker.txt\\\" in run.stdout\\n\\n    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n    assert rec[\\\"status\\\"] == \\\"refused\\\"\\n    assert \\\"src/marker.txt\\\" in rec[\\\"refusal\\\"]\\n    assert rec[\\\"criteria\\\"] == []\\n\\n\\ndef test_spec_gate_removed_refuses_a_path_outside_the_tree(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Issue #132, acceptance 4. A .removed entry that escapes the tree\\n    is refused by name before any criterion runs -- the stubbed copy is\\n    the only thing the gate may delete from.\\n    \\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"removed_outside_tree\\\")\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 1\\n    assert \\\"../escape.txt\\\" in run.stdout\\n\\n    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n    assert rec[\\\"status\\\"] == \\\"refused\\\"\\n    assert \\\"../escape.txt\\\" in rec[\\\"refusal\\\"]\\n    assert rec[\\\"criteria\\\"] == []\\n\\n\\ndef test_spec_gate_phase1_rule_unchanged_without_build(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Issue #28, acceptance 3. No build record at all: the third verdict\\n    does not apply, and Phase 1's original rule holds unchanged.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"valid\\\")\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 0\\n    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n    assert rec[\\\"status\\\"] == \\\"pass\\\"\\n    assert rec[\\\"criteria\\\"] == [{\\\"name\\\": \\\"checks_marker.sh\\\", \\\"kind\\\": \\\"structural\\\", \\\"on_tree\\\": 1, \\\"on_stub\\\": 0}]\\n\\n\\ndef add_scripted_criterion(root: Path, satisfies_stub: bool) -> None:\\n    \\\"\\\"\\\"The move an operator makes when an executor skipped a ruling\\n    nothing enforced: script it, after the build. Adds one criterion,\\n    extra.sh, testing for extra.txt -- present in the stub overlay only\\n    when satisfies_stub, so the new criterion fails on the tree (the\\n    build never created it) and either passes or fails on the stub.\\n    \\\"\\\"\\\"\\n    spec_md = root / \\\"specs\\\" / \\\"1\\\" / \\\"spec.md\\\"\\n    spec_md.write_text(\\n        spec_md.read_text() + \\\"- extra.sh: a ruling scripted after the build\\\\n\\\")\\n    script = root / \\\"specs\\\" / \\\"1\\\" / \\\"criteria\\\" / \\\"extra.sh\\\"\\n    script.write_text(\\\"#!/bin/sh\\\\ntest -f extra.txt\\\\n\\\")\\n    script.chmod(0o755)\\n    if satisfies_stub:\\n        stub_marker = root / \\\"specs\\\" / \\\"1\\\" / \\\"stub\\\" / \\\"extra.txt\\\"\\n        stub_marker.write_text(\\\"stub\\\\n\\\")\\n    commit_all(root, \\\"amend: script a ruling the executor skipped\\\")\\n\\n\\ndef test_built_accepts_a_criterion_added_after_the_build(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Issue #36, acceptance 1. A criterion added after a build, failing\\n    on the tree (the build never satisfied it) but passing on the stub\\n    (a new obligation the next build must meet), does not refuse built\\n    -- it is exactly the move an operator makes when an executor skipped\\n    a ruling nothing enforced: script it. Red today: built refuses any\\n    tree failure regardless of the stub; specimen attavo/code-factory\\n    spec-22.json, a correct amendment refused by name.\\n    \\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"valid\\\")\\n    approve_valid(root)\\n    assert run_real_build(root).returncode == 0\\n\\n    add_scripted_criterion(root, satisfies_stub=True)\\n\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 0\\n\\n    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n    assert rec[\\\"status\\\"] == \\\"built\\\"\\n    assert rec[\\\"refusal\\\"] is None\\n    by_name = {c[\\\"name\\\"]: c for c in rec[\\\"criteria\\\"]}\\n    assert by_name[\\\"checks_marker.sh\\\"] == {\\\"name\\\": \\\"checks_marker.sh\\\", \\\"kind\\\": \\\"structural\\\", \\\"on_tree\\\": 0, \\\"on_stub\\\": 0}\\n    assert by_name[\\\"extra.sh\\\"] == {\\\"name\\\": \\\"extra.sh\\\", \\\"kind\\\": \\\"structural\\\", \\\"on_tree\\\": 1, \\\"on_stub\\\": 0}\\n\\n\\ndef test_built_refuses_a_criterion_failing_on_both(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Issue #36, acceptance 2. Same shape, but the new criterion is not\\n    satisfiable at all -- fails on the tree and on the stub both:\\n    refused by name, not accepted as a scriptable new obligation.\\n    \\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"valid\\\")\\n    approve_valid(root)\\n    assert run_real_build(root).returncode == 0\\n\\n    add_scripted_criterion(root, satisfies_stub=False)\\n\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 1\\n\\n    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n    assert rec[\\\"status\\\"] == \\\"refused\\\"\\n    assert rec[\\\"refusal\\\"] == \\\"criterion fails against the tree plus stub: extra.sh\\\"\\n    by_name = {c[\\\"name\\\"]: c for c in rec[\\\"criteria\\\"]}\\n    assert by_name[\\\"extra.sh\\\"] == {\\\"name\\\": \\\"extra.sh\\\", \\\"kind\\\": \\\"structural\\\", \\\"on_tree\\\": 1, \\\"on_stub\\\": 1}\\n\\n\\ndef write_build_record(root: Path, item: str, *, sha: str, status: str) -> None:\\n    \\\"\\\"\\\"A minimal build-01.json, faked directly rather than run through the\\n    fixture adapter: the adapter has no way to both commit and halt with a\\n    question in one invocation (adapters/fixture/run answers a question\\n    before it ever reaches the write-and-commit step), and cmd_spec_gate\\n    reads nothing off a build record but sha and status.\\n    \\\"\\\"\\\"\\n    records_dir = root / \\\"records\\\" / item\\n    records_dir.mkdir(parents=True, exist_ok=True)\\n    (records_dir / \\\"build-01.json\\\").write_text(json.dumps({\\\"sha\\\": sha, \\\"status\\\": status}) + \\\"\\\\n\\\")\\n\\n\\ndef test_spec_gate_built_after_halted_build_that_committed(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Issue #98, acceptance 1. The executor commits its work, then halts\\n    with a question -- the common shape, since it commits before it asks.\\n    An amendment above the line must still be judged against the tree the\\n    halted build produced, not refused for the success that tree already\\n    holds. Red today: refused, \\\"criterion passes against the tree:\\n    checks_marker.sh\\\" -- the status != \\\"halted\\\" clause excluded the one\\n    build that had done the work; tenant zero's #663 build-01/spec-02 is\\n    the specimen.\\n    \\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"valid\\\")\\n    approve_valid(root)\\n    complete_the_build(root)\\n    build_sha = git(root, \\\"rev-parse\\\", \\\"HEAD\\\").strip()\\n    write_build_record(root, \\\"1\\\", sha=build_sha, status=\\\"halted\\\")\\n\\n    amend_problem(root)\\n\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 0\\n\\n    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n    assert rec[\\\"status\\\"] == \\\"built\\\"\\n    assert rec[\\\"criteria\\\"] == [{\\\"name\\\": \\\"checks_marker.sh\\\", \\\"kind\\\": \\\"structural\\\", \\\"on_tree\\\": 0, \\\"on_stub\\\": 0}]\\n    assert rec[\\\"refusal\\\"] is None\\n\\n\\ndef test_spec_gate_stub_verdict_after_halted_build_that_committed_nothing(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Issue #98, acceptance 2. A halted build whose sha equals its\\n    start_sha did no work -- commit_postdates already treats that as\\n    postdating nothing -- so the gate must keep judging it against the\\n    stub, exactly as before the fix: Phase 1's rule, not built. The\\n    criterion still fails on the real tree (no build ever touched it) and\\n    passes on the stub, so the verdict is pass, not built and not refused.\\n    \\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"valid\\\")\\n    approve_valid(root)\\n    approval_sha = git(root, \\\"rev-parse\\\", \\\"HEAD\\\").strip()\\n    write_build_record(root, \\\"1\\\", sha=approval_sha, status=\\\"halted\\\")\\n\\n    amend_problem(root)\\n\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 0\\n\\n    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n    assert rec[\\\"status\\\"] == \\\"pass\\\"\\n    assert rec[\\\"criteria\\\"] == [{\\\"name\\\": \\\"checks_marker.sh\\\", \\\"kind\\\": \\\"structural\\\", \\\"on_tree\\\": 1, \\\"on_stub\\\": 0}]\\n    assert rec[\\\"refusal\\\"] is None\\n\\n\\ndef add_root_cause_line(root: Path, root_cause: str) -> None:\\n    spec_md = root / \\\"specs\\\" / \\\"1\\\" / \\\"spec.md\\\"\\n    # a root-cause item is core (ruled 2026-09-27); the fixture declares fix\\n    text = spec_md.read_text().replace(\\\"Class: fix\\\\n\\\", \\\"Class: core\\\\n\\\", 1)\\n    text = text.replace(\\\"## Problem\\\\n\\\", f\\\"## Problem\\\\n\\\\nRoot-cause: {root_cause}\\\\n\\\", 1)\\n    spec_md.write_text(text)\\n    commit_all(root, f\\\"name root cause {root_cause}\\\")\\n\\n\\ndef test_spec_gate_refuses_a_root_cause_the_tenant_does_not_list_and_passes_a_listed_one(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Root causes (#229 build-04 and the convergence ruling of\\n    2026-09-27): a fix item names the root cause its change closes as one\\n    'Root-cause: <slug>' line in its problem, and the gate refuses a slug\\n    the tenant's root-causes.md (beside the specs directory) does not\\n    list, or a line with no such file. Written red first: on v0.30.0 the\\n    line is prose and the gate passes it.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"valid\\\")\\n    add_root_cause_line(root, \\\"shared-working-copy\\\")\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 1, run.stdout + run.stderr\\n    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n    assert rec[\\\"status\\\"] == \\\"refused\\\"\\n    assert rec[\\\"refusal\\\"] == \\\"root cause: shared-working-copy named but root-causes.md does not exist\\\", rec[\\\"refusal\\\"]\\n    assert rec[\\\"criteria\\\"] == [], \\\"refused before any criterion ran\\\"\\n\\n    (root / \\\"root-causes.md\\\").write_text(\\n        \\\"# root causes\\\\n\\\\n- liveness-by-proxy: a pid stood in for the holder\\\\n\\\")\\n    commit_all(root, \\\"list one root cause\\\")\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 1\\n    assert latest_record(root, \\\"1\\\", \\\"spec\\\")[\\\"refusal\\\"] == \\\"root cause: shared-working-copy is not listed in root-causes.md\\\"\\n\\n    (root / \\\"root-causes.md\\\").write_text(\\n        \\\"# root causes\\\\n\\\\n- liveness-by-proxy: a pid stood in for the holder\\\\n\\\"\\n        \\\"- shared-working-copy: one checkout, many writers\\\\n\\\")\\n    commit_all(root, \\\"list the root cause\\\")\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n    assert rec[\\\"status\\\"] == \\\"pass\\\" and rec[\\\"refusal\\\"] is None\\n\\n\\ndef test_spec_gate_leaves_a_spec_with_no_root_cause_line_alone(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"A capability item has no root cause; the check is on the line, not\\n    on every spec, and a tenant with no root-causes.md is not asked for\\n    one.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"valid\\\")\\n    assert not (root / \\\"root-causes.md\\\").exists()\\n    assert run_attavo(root, \\\"spec-gate\\\", \\\"1\\\").returncode == 0\\n\\n\\n# --- the item's class and the research policy (ruled 2026-09-25, 2026-09-27) ---\\n\\ndef set_class_line(root: Path, line: str | None) -> None:\\n    spec_md = root / \\\"specs\\\" / \\\"1\\\" / \\\"spec.md\\\"\\n    text = spec_md.read_text().replace(\\\"Class: fix\\\\n\\\", \\\"\\\" if line is None else line + \\\"\\\\n\\\", 1)\\n    spec_md.write_text(text)\\n    commit_all(root, f\\\"class line: {line}\\\")\\n\\n\\ndef test_spec_gate_refuses_a_spec_that_declares_no_class_before_any_criterion_runs(tmp_path: Path) -> None:\\n    root = make_tenant(tmp_path, \\\"valid\\\")\\n    set_class_line(root, None)\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 1, run.stdout + run.stderr\\n    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n    assert rec[\\\"status\\\"] == \\\"refused\\\" and rec[\\\"criteria\\\"] == [], rec\\n    assert rec[\\\"refusal\\\"] == \\\"class: none declared; add a line 'Class: core' or 'Class: fix' to the problem\\\", rec[\\\"refusal\\\"]\\n    assert rec[\\\"class\\\"] is None and rec[\\\"research\\\"] == \\\"not required by policy\\\", rec\\n\\n\\ndef test_spec_gate_refuses_a_class_other_than_core_or_fix(tmp_path: Path) -> None:\\n    root = make_tenant(tmp_path, \\\"valid\\\")\\n    set_class_line(root, \\\"Class: feature\\\")\\n    assert run_attavo(root, \\\"spec-gate\\\", \\\"1\\\").returncode == 1\\n    assert latest_record(root, \\\"1\\\", \\\"spec\\\")[\\\"refusal\\\"] == \\\"class: feature is not core or fix\\\"\\n\\n\\ndef test_spec_gate_refuses_a_root_cause_item_declared_fix(tmp_path: Path) -> None:\\n    root = make_tenant(tmp_path, \\\"valid\\\")\\n    (root / \\\"root-causes.md\\\").write_text(\\\"# root causes\\\\n\\\\n- shared-working-copy: one checkout, many writers\\\\n\\\")\\n    spec_md = root / \\\"specs\\\" / \\\"1\\\" / \\\"spec.md\\\"\\n    spec_md.write_text(spec_md.read_text().replace(\\\"## Problem\\\\n\\\", \\\"## Problem\\\\n\\\\nRoot-cause: shared-working-copy\\\\n\\\", 1))\\n    commit_all(root, \\\"a root cause named on a fix\\\")\\n    assert run_attavo(root, \\\"spec-gate\\\", \\\"1\\\").returncode == 1\\n    assert latest_record(root, \\\"1\\\", \\\"spec\\\")[\\\"refusal\\\"] == \\\"class: fix with root cause shared-working-copy; a root-cause item is core\\\"\\n\\n\\ndef test_spec_gate_records_the_class_and_that_research_was_not_required(tmp_path: Path) -> None:\\n    root = make_tenant(tmp_path, \\\"valid\\\")\\n    set_class_line(root, \\\"Class: core\\\")\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n    assert rec[\\\"status\\\"] == \\\"pass\\\" and rec[\\\"class\\\"] == \\\"core\\\", rec\\n    assert rec[\\\"research\\\"] == \\\"not required by policy\\\", rec\\n\\n\\ndef test_with_research_required_a_core_spec_owes_a_research_record_and_a_fix_spec_does_not(tmp_path: Path) -> None:\\n    root = make_tenant(tmp_path, \\\"valid\\\")\\n    manifest = root / \\\"attavo.toml\\\"\\n    text = manifest.read_text()\\n    assert \\\"[spec]\\\\n\\\" in text, text\\n    manifest.write_text(text.replace(\\\"[spec]\\\\n\\\", '[spec]\\\\nresearch = \\\"required\\\"\\\\n', 1))\\n    commit_all(root, \\\"research required\\\")\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n    assert latest_record(root, \\\"1\\\", \\\"spec\\\")[\\\"research\\\"] == \\\"required\\\"\\n    set_class_line(root, \\\"Class: core\\\")\\n    assert run_attavo(root, \\\"spec-gate\\\", \\\"1\\\").returncode == 1\\n    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n    assert rec[\\\"refusal\\\"] == \\\"research: [spec].research is required and the item has no research record\\\", rec\\n    (root / \\\"records\\\" / \\\"1\\\" / \\\"research-01.json\\\").write_text(\\\"{}\\\\n\\\")\\n    commit_all(root, \\\"a research record\\\")\\n    assert run_attavo(root, \\\"spec-gate\\\", \\\"1\\\").returncode == 0\\n\\n\\ndef test_an_approved_and_built_item_whose_spec_declares_no_class_still_regates_built(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"No item in flight is stranded: class is required before approval,\\n    and an item approved and built before the gate read class re-gates\\n    after an amendment exactly as it did.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"valid\\\")\\n    approve_valid(root)\\n    assert run_real_build(root).returncode == 0\\n    set_class_line(root, None)\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n    assert rec[\\\"status\\\"] == \\\"built\\\" and rec[\\\"class\\\"] is None, rec\\n\\n\\ndef test_spec_gate_refuses_a_stub_that_touches_a_path_the_claims_do_not_name(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Item 229's third attempt: the change needed attavo/common.py, the\\n    Claims list did not name it, and the gate found out 2,754 s later. The\\n    stub is the change's floor, so a stub path outside the claims is a\\n    wrong Claims list before any build runs. Red first against v0.29.0.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"valid\\\")\\n    stub = root / \\\"specs\\\" / \\\"1\\\" / \\\"stub\\\"\\n    (stub / \\\"lib\\\").mkdir(parents=True)\\n    (stub / \\\"lib\\\" / \\\"helper.py\\\").write_text(\\\"x = 1\\\\n\\\")\\n    commit_all(root, \\\"a stub file the claims do not name\\\")\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 1, run.stdout + run.stderr\\n    assert \\\"stub touches a path the claims do not name: lib/helper.py\\\" in run.stdout, run.stdout\\n    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n    assert rec[\\\"status\\\"] == \\\"refused\\\" and \\\"lib/helper.py\\\" in rec[\\\"refusal\\\"], rec\\n    spec_md = root / \\\"specs\\\" / \\\"1\\\" / \\\"spec.md\\\"\\n    spec_md.write_text(spec_md.read_text().replace(\\\"- src/**\\\\n\\\", \\\"- src/**\\\\n- lib/\\\\n\\\"))\\n    commit_all(root, \\\"claim the directory\\\")\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n    assert latest_record(root, \\\"1\\\", \\\"spec\\\")[\\\"status\\\"] == \\\"pass\\\"\\n\\n\\n# Issue #340 (rulings 1 and 2 on #299): criterion kinds, so a stub can be thin.\\n\\ndef set_criteria(root: Path, lines: list[str], scripts: dict[str, str],\\n                 stub: dict[str, str] | None = None) -> None:\\n    \\\"\\\"\\\"Replace the valid fixture's Criteria with `lines` (spec.md bullets),\\n    write each script executable, and set the stub overlay to `stub`\\n    (path -> content) in place of the fixture's marker.txt.\\\"\\\"\\\"\\n    spec_dir = root / \\\"specs\\\" / \\\"1\\\"\\n    spec_md = spec_dir / \\\"spec.md\\\"\\n    head = spec_md.read_text().split(\\\"## Criteria\\\")[0]\\n    spec_md.write_text(head + \\\"## Criteria\\\\n\\\\n\\\" + \\\"\\\\n\\\".join(lines) + \\\"\\\\n\\\")\\n    criteria = spec_dir / \\\"criteria\\\"\\n    for old in criteria.iterdir():\\n        old.unlink()\\n    for name, body in scripts.items():\\n        (criteria / name).write_text(\\\"#!/bin/sh\\\\n\\\" + body + \\\"\\\\n\\\")\\n        (criteria / name).chmod(0o755)\\n    shutil.rmtree(spec_dir / \\\"stub\\\")\\n    for rel, content in (stub or {}).items():\\n        (spec_dir / \\\"stub\\\" / rel).parent.mkdir(parents=True, exist_ok=True)\\n        (spec_dir / \\\"stub\\\" / rel).write_text(content)\\n    commit_all(root, \\\"criteria with kinds\\\")\\n\\n\\nSTRUCT = \\\"- [structural] checks_marker.sh: the marker file exists\\\"\\nBEHAV = \\\"- [behavioural] logic.sh: the logic reports done\\\"\\nTHIN_SCRIPTS = {\\\"checks_marker.sh\\\": \\\"test -f src/marker.txt\\\",\\n                \\\"logic.sh\\\": \\\"test \\\\\\\"$(cat src/logic.txt 2>/dev/null)\\\\\\\" = done\\\"}\\nTHIN_STUB = {\\\"src/marker.txt\\\": \\\"ok\\\\n\\\", \\\"src/logic.txt\\\": \\\"todo\\\\n\\\"}\\n\\n\\ndef test_a_thin_stub_passes_and_the_record_carries_each_criterions_kind(tmp_path: Path) -> None:\\n    root = make_tenant(tmp_path, \\\"valid\\\")\\n    set_criteria(root, [STRUCT, BEHAV], THIN_SCRIPTS, THIN_STUB)\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n    assert rec[\\\"status\\\"] == \\\"pass\\\"\\n    assert rec[\\\"criteria\\\"] == [\\n        {\\\"name\\\": \\\"checks_marker.sh\\\", \\\"kind\\\": \\\"structural\\\", \\\"on_tree\\\": 1, \\\"on_stub\\\": 0},\\n        {\\\"name\\\": \\\"logic.sh\\\", \\\"kind\\\": \\\"behavioural\\\", \\\"on_tree\\\": 1, \\\"on_stub\\\": 1}]\\n\\n\\ndef test_a_behavioural_criterion_that_passes_on_the_stub_is_refused_by_name(tmp_path: Path) -> None:\\n    root = make_tenant(tmp_path, \\\"valid\\\")\\n    set_criteria(root, [STRUCT, BEHAV], THIN_SCRIPTS,\\n                 {\\\"src/marker.txt\\\": \\\"ok\\\\n\\\", \\\"src/logic.txt\\\": \\\"done\\\\n\\\"})\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 1\\n    want = \\\"criterion labelled behavioural passes on the tree plus stub: logic.sh\\\"\\n    assert want in run.stdout, run.stdout\\n    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n    assert rec[\\\"status\\\"] == \\\"refused\\\" and rec[\\\"refusal\\\"] == want\\n\\n\\ndef test_a_structural_criterion_that_fails_on_the_stub_is_refused_by_name(tmp_path: Path) -> None:\\n    root = make_tenant(tmp_path, \\\"valid\\\")\\n    set_criteria(root, [STRUCT, BEHAV], THIN_SCRIPTS, {\\\"src/logic.txt\\\": \\\"todo\\\\n\\\"})\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 1\\n    want = \\\"criterion labelled structural fails on the tree plus stub: checks_marker.sh\\\"\\n    assert want in run.stdout, run.stdout\\n    assert latest_record(root, \\\"1\\\", \\\"spec\\\")[\\\"refusal\\\"] == want\\n\\n\\ndef test_an_unknown_kind_label_is_refused_by_name(tmp_path: Path) -> None:\\n    root = make_tenant(tmp_path, \\\"valid\\\")\\n    set_criteria(root, [\\\"- [cosmetic] checks_marker.sh: the marker file exists\\\"],\\n                 {\\\"checks_marker.sh\\\": \\\"test -f src/marker.txt\\\"}, {\\\"src/marker.txt\\\": \\\"ok\\\\n\\\"})\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 1\\n    want = \\\"criterion has an unknown kind [cosmetic]: checks_marker.sh\\\"\\n    assert want in run.stdout, run.stdout\\n    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n    assert rec[\\\"status\\\"] == \\\"refused\\\" and rec[\\\"refusal\\\"] == want\\n\\n\\ndef test_an_unlabelled_criterion_is_structural(tmp_path: Path) -> None:\\n    root = make_tenant(tmp_path, \\\"valid\\\")\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n    assert latest_record(root, \\\"1\\\", \\\"spec\\\")[\\\"criteria\\\"] == [\\n        {\\\"name\\\": \\\"checks_marker.sh\\\", \\\"kind\\\": \\\"structural\\\", \\\"on_tree\\\": 1, \\\"on_stub\\\": 0}]\\n    # An unlabelled criterion failing on the stub is refused as structural.\\n    set_criteria(root, [\\\"- checks_marker.sh: the marker file exists\\\"],\\n                 {\\\"checks_marker.sh\\\": \\\"test -f src/ma\",\"stderr\":\"\",\"interrupted\":false,\"isImage\":false,\"noOutputExpected\":false,\"persistedOutputPath\":\"/Users/davidbean/.claude/projects/-Users-davidbean-Projects-attavo-worktree-351/0fabd1e2-92b8-4212-a6d0-e85fc14548ff/tool-results/bic488230.txt\",\"persistedOutputSize\":37840},\"tool_result_meta\":[{\"id\":\"toolu_015KY9ZLY5F4pvcq1dQRJtiu\",\"permission_decision\":{\"decision\":\"accept\",\"source\":\"config\",\"reason_type\":\"rule\"}}]}\n+{\"type\":\"assistant\",\"message\":{\"model\":\"claude-sonnet-5\",\"id\":\"msg_011Cg2ikAN8id4tnDBivXSYF\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"text\",\"text\":\"Let's view the full stub file and the full tests/test_spec_gate.py and attavo/spec.py.\"}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":2434,\"cache_read_input_tokens\":31613,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":2434},\"output_tokens\":8,\"service_tier\":\"standard\",\"inference_geo\":\"global\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"0fabd1e2-92b8-4212-a6d0-e85fc14548ff\",\"uuid\":\"6733c77a-2bbf-4499-8f46-5c7c4f4996f8\",\"timestamp\":\"2026-10-14T19:57:55.235Z\",\"request_id\":\"req_011Cg2ikA2JdA3baeeX4GEH2\"}\n+{\"type\":\"assistant\",\"message\":{\"model\":\"claude-sonnet-5\",\"id\":\"msg_011Cg2ikAN8id4tnDBivXSYF\",\"type\":\"message\",\"role\":\"assistant\",\"content\":[{\"type\":\"tool_use\",\"id\":\"toolu_0113LAeNsazrvgdmLmx5aX9E\",\"name\":\"Read\",\"input\":{\"file_path\":\"/Users/davidbean/.claude/projects/-Users-davidbean-Projects-attavo-worktree-351/0fabd1e2-92b8-4212-a6d0-e85fc14548ff/tool-results/bic488230.txt\"},\"caller\":{\"type\":\"direct\"}}],\"container\":null,\"stop_reason\":null,\"stop_sequence\":null,\"stop_details\":null,\"usage\":{\"input_tokens\":2,\"cache_creation_input_tokens\":2434,\"cache_read_input_tokens\":31613,\"cache_creation\":{\"ephemeral_5m_input_tokens\":0,\"ephemeral_1h_input_tokens\":2434},\"output_tokens\":8,\"service_tier\":\"standard\",\"inference_geo\":\"global\"},\"input_transformations\":[],\"diagnostics\":null,\"context_management\":null},\"parent_tool_use_id\":null,\"session_id\":\"0fabd1e2-92b8-4212-a6d0-e85fc14548ff\",\"uuid\":\"a0abf1d0-b874-44fd-a1fa-bee1a5285e32\",\"timestamp\":\"2026-10-14T19:57:55.988Z\",\"request_id\":\"req_011Cg2ikA2JdA3baeeX4GEH2\",\"wire_tool_inputs\":{\"toolu_0113LAeNsazrvgdmLmx5aX9E\":{\"file_path\":\"/Users/davidbean/.claude/projects/-Users-davidbean-Projects-attavo-worktree-351/0fabd1e2-92b8-4212-a6d0-e85fc14548ff/tool-results/bic488230.txt\"}}}\n+{\"type\":\"user\",\"message\":{\"role\":\"user\",\"content\":[{\"tool_use_id\":\"toolu_0113LAeNsazrvgdmLmx5aX9E\",\"type\":\"tool_result\",\"content\":\"1\\t\\\"\\\"\\\"The spec contract: attavo spec-gate N.\\n2\\t\\n3\\tEach test is a rejection test, written and run red before the capability\\n4\\texisted: on `main` at commit 22ca1e1 there was no `spec-gate` subcommand, so\\n5\\tevery one of these failed with \\\"unknown subcommand\\\".\\n6\\t\\n7\\tRun: python3 -m pytest tests -q\\n8\\t\\\"\\\"\\\"\\n9\\timport json\\n10\\timport os\\n11\\timport shutil\\n12\\timport subprocess\\n13\\timport sys\\n14\\tfrom pathlib import Path\\n15\\tfrom typing import Any, cast\\n16\\t\\n17\\timport pytest\\n18\\tfrom helpers import commit_all, git, make_tenant\\n19\\t\\n20\\tROOT = Path(__file__).resolve().parent.parent\\n21\\tATTAVO = ROOT / \\\"bin\\\" / \\\"attavo\\\"\\n22\\t\\n23\\t\\n24\\tdef run_attavo(root: Path, *args: str, env: dict[str, Any] | None = None) -> subprocess.CompletedProcess[str]:\\n25\\t    full_env = dict(os.environ)\\n26\\t    if env:\\n27\\t        full_env.update(env)\\n28\\t    return subprocess.run([sys.executable, str(ATTAVO), *args], cwd=str(root),\\n29\\t                          capture_output=True, text=True, check=False, env=full_env)\\n30\\t\\n31\\t\\n32\\tdef latest_record(root: Path, item: str, stage: str) -> dict[str, Any]:\\n33\\t    records = sorted((root / \\\"records\\\" / item).glob(f\\\"{stage}-*.json\\\"))\\n34\\t    assert records, f\\\"no {stage} record for item {item}\\\"\\n35\\t    return cast(dict[str, Any], json.loads(records[-1].read_text()))\\n36\\t\\n37\\t\\n38\\tdef test_spec_gate_refuses_prose_criterion(tmp_path: Path) -> None:\\n39\\t    root = make_tenant(tmp_path, \\\"prose_criterion\\\")\\n40\\t    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n41\\t    assert run.returncode == 1\\n42\\t    assert \\\"missing.sh\\\" in run.stdout\\n43\\t    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n44\\t    assert rec[\\\"status\\\"] == \\\"refused\\\"\\n45\\t    assert \\\"missing.sh\\\" in rec[\\\"refusal\\\"]\\n46\\t    # issue #49: this fixture's manifest carries no [attavo] table at all --\\n47\\t    # product_pin is the absent fact, null, not a crash reading it.\\n48\\t    assert rec[\\\"product_pin\\\"] is None\\n49\\t    assert rec[\\\"product_version\\\"]\\n50\\t\\n51\\t\\n52\\tdef test_spec_gate_refuses_criterion_passing_on_tree(tmp_path: Path) -> None:\\n53\\t    root = make_tenant(tmp_path, \\\"passes_on_tree\\\")\\n54\\t    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n55\\t    assert run.returncode == 1\\n56\\t    assert \\\"checks.sh\\\" in run.stdout\\n57\\t    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n58\\t    assert rec[\\\"status\\\"] == \\\"refused\\\"\\n59\\t    assert \\\"checks.sh\\\" in rec[\\\"refusal\\\"]\\n60\\t\\n61\\t\\n62\\tdef test_spec_gate_refuses_criterion_failing_on_stub(tmp_path: Path) -> None:\\n63\\t    root = make_tenant(tmp_path, \\\"fails_on_stub\\\")\\n64\\t    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n65\\t    assert run.returncode == 1\\n66\\t    assert \\\"checks.sh\\\" in run.stdout\\n67\\t    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n68\\t    assert rec[\\\"status\\\"] == \\\"refused\\\"\\n69\\t    assert \\\"checks.sh\\\" in rec[\\\"refusal\\\"]\\n70\\t\\n71\\t\\n72\\tdef test_spec_gate_refuses_wrong_headings(tmp_path: Path) -> None:\\n73\\t    root = make_tenant(tmp_path, \\\"wrong_headings\\\")\\n74\\t    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n75\\t    assert run.returncode == 1\\n76\\t    assert \\\"Design\\\" in run.stdout\\n77\\t    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n78\\t    assert rec[\\\"status\\\"] == \\\"refused\\\"\\n79\\t    assert \\\"Design\\\" in rec[\\\"refusal\\\"]\\n80\\t\\n81\\t\\n82\\tdef test_spec_gate_passes_and_writes_record(tmp_path: Path) -> None:\\n83\\t    root = make_tenant(tmp_path, \\\"valid\\\")\\n84\\t    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n85\\t    assert run.returncode == 0\\n86\\t\\n87\\t    first = root / \\\"records\\\" / \\\"1\\\" / \\\"spec-01.json\\\"\\n88\\t    assert first.is_file()\\n89\\t    rec = json.loads(first.read_text())\\n90\\t    assert rec[\\\"status\\\"] == \\\"pass\\\"\\n91\\t    assert rec[\\\"spec_sha\\\"]\\n92\\t    assert rec[\\\"criteria\\\"] == [{\\\"name\\\": \\\"checks_marker.sh\\\", \\\"kind\\\": \\\"structural\\\", \\\"on_tree\\\": 1, \\\"on_stub\\\": 0}]\\n93\\t    assert rec[\\\"refusal\\\"] is None\\n94\\t\\n95\\t    run2 = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n96\\t    assert run2.returncode == 0\\n97\\t    assert (root / \\\"records\\\" / \\\"1\\\" / \\\"spec-02.json\\\").is_file()\\n98\\t\\n99\\t\\n100\\tdef amend_problem(root: Path) -> None:\\n101\\t    spec_md = root / \\\"specs\\\" / \\\"1\\\" / \\\"spec.md\\\"\\n102\\t    spec_md.write_text(spec_md.read_text().replace(\\n103\\t        \\\"does not emit\\\", \\\"used to not emit\\\"))\\n104\\t    commit_all(root, \\\"amend problem prose\\\")\\n105\\t\\n106\\t\\n107\\tdef approve_valid(root: Path) -> None:\\n108\\t    assert run_attavo(root, \\\"spec-gate\\\", \\\"1\\\").returncode == 0\\n109\\t    assert run_attavo(root, \\\"approve\\\", \\\"1\\\", \\\"--by\\\", \\\"alice\\\").returncode == 0\\n110\\t\\n111\\t\\n112\\tdef complete_the_build(root: Path) -> None:\\n113\\t    \\\"\\\"\\\"The marker.txt the criterion checks for, committed with no touch to\\n114\\t    spec.md: the same commit shape a real `attavo build` leaves behind --\\n115\\t    spec_sha, and so the approval, is unchanged.\\\"\\\"\\\"\\n116\\t    (root / \\\"src\\\").mkdir(parents=True, exist_ok=True)\\n117\\t    (root / \\\"src\\\" / \\\"marker.txt\\\").write_text(\\\"built\\\\n\\\")\\n118\\t    commit_all(root, \\\"build completed\\\")\\n119\\t\\n120\\t\\n121\\tdef test_spec_gate_reports_approved_when_approval_is_valid(tmp_path: Path) -> None:\\n122\\t    \\\"\\\"\\\"Issue #21, acceptance 1. Once a build has made the criterion pass on\\n123\\t    the tree, the gate must not re-run it and refuse the very success\\n124\\t    approval exists to bind: it reports the approval instead. Red today:\\n125\\t    the unmodified gate refuses this by name (\\\"criterion passes against\\n126\\t    the tree: checks_marker.sh\\\").\\n127\\t    \\\"\\\"\\\"\\n128\\t    root = make_tenant(tmp_path, \\\"valid\\\")\\n129\\t    approve_valid(root)\\n130\\t    complete_the_build(root)\\n131\\t\\n132\\t    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n133\\t    assert run.returncode == 0\\n134\\t\\n135\\t    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n136\\t    assert rec[\\\"status\\\"] == \\\"approved\\\"\\n137\\t    assert rec[\\\"criteria\\\"] == []\\n138\\t    assert rec[\\\"refusal\\\"] is None\\n139\\t    assert rec[\\\"spec_sha\\\"]\\n140\\t    approval = json.loads(sorted((root / \\\"records\\\" / \\\"1\\\").glob(\\\"approval-*.json\\\"))[-1].read_text())\\n141\\t    assert rec[\\\"approval_sha\\\"] == approval[\\\"sha\\\"]\\n142\\t\\n143\\t\\n144\\tdef test_spec_gate_runs_when_approval_expired(tmp_path: Path) -> None:\\n145\\t    \\\"\\\"\\\"Issue #21, acceptance 2. The same fixture, after an edit above the\\n146\\t    line expires the approval: the gate must fall through to running the\\n147\\t    criteria for real, not keep reporting approved past the approval it\\n148\\t    no longer holds.\\n149\\t    \\\"\\\"\\\"\\n150\\t    root = make_tenant(tmp_path, \\\"valid\\\")\\n151\\t    approve_valid(root)\\n152\\t    complete_the_build(root)\\n153\\t    assert run_attavo(root, \\\"spec-gate\\\", \\\"1\\\").returncode == 0  # approved, short-circuited\\n154\\t\\n155\\t    amend_problem(root)\\n156\\t\\n157\\t    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n158\\t    assert run.returncode == 1\\n159\\t    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n160\\t    assert rec[\\\"status\\\"] == \\\"refused\\\"\\n161\\t    assert \\\"checks_marker.sh\\\" in rec[\\\"refusal\\\"]\\n162\\t\\n163\\t\\n164\\tdef run_real_build(root: Path) -> subprocess.CompletedProcess[str]:\\n165\\t    \\\"\\\"\\\"A real `attavo build`, the fixture adapter writing the marker.txt\\n166\\t    the criterion checks for -- inside src/**, the claim -- unlike\\n167\\t    complete_the_build above, which only fakes the commit shape.\\\"\\\"\\\"\\n168\\t    return run_attavo(root, \\\"build\\\", \\\"1\\\", env={\\\"ATTAVO_FIXTURE_WRITE\\\": \\\"src/marker.txt\\\"})\\n169\\t\\n170\\t\\n171\\tdef test_spec_gate_built_after_build(tmp_path: Path) -> None:\\n172\\t    \\\"\\\"\\\"Issue #28, acceptance 1. Approve, build for real, then an\\n173\\t    amendment above the line expires the approval: the gate reports\\n174\\t    status built, not a refusal. Red today: refused for passing on the\\n175\\t    tree, PR #600's specimen.\\n176\\t\\n177\\t    Issue #36 changed built to judge each criterion (both on_tree and\\n178\\t    on_stub, as a pass record already does) rather than the tree alone;\\n179\\t    this fixture's stub also satisfies checks_marker.sh, so on_stub is\\n180\\t    0 here, not null -- the null-on_stub shape was retired with the\\n181\\t    \\\"criterion fails against the tree\\\" refusal it belonged to.\\n182\\t    \\\"\\\"\\\"\\n183\\t    root = make_tenant(tmp_path, \\\"valid\\\")\\n184\\t    approve_valid(root)\\n185\\t    assert run_real_build(root).returncode == 0\\n186\\t\\n187\\t    amend_problem(root)\\n188\\t\\n189\\t    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n190\\t    assert run.returncode == 0\\n191\\t\\n192\\t    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n193\\t    assert rec[\\\"status\\\"] == \\\"built\\\"\\n194\\t    assert rec[\\\"criteria\\\"] == [{\\\"name\\\": \\\"checks_marker.sh\\\", \\\"kind\\\": \\\"structural\\\", \\\"on_tree\\\": 0, \\\"on_stub\\\": 0}]\\n195\\t    assert rec[\\\"refusal\\\"] is None\\n196\\t\\n197\\t\\n198\\tdef test_spec_gate_built_refuses_a_failing_criterion(tmp_path: Path) -> None:\\n199\\t    \\\"\\\"\\\"Issue #28, acceptance 2. Same shape, but a criterion no longer\\n200\\t    satisfiable at all -- gone from the tree and from the stub overlay\\n201\\t    both -- is refused by name, not rubber-stamped built just because a\\n202\\t    build record exists.\\n203\\t\\n204\\t    Issue #36 made built judge tree-fail-stub-pass as an accepted new\\n205\\t    obligation, not a refusal, so this specimen must fail on the stub\\n206\\t    too (removed from specs/1/stub/, not just the real tree) to still\\n207\\t    exercise a refusal at all.\\n208\\t    \\\"\\\"\\\"\\n209\\t    root = make_tenant(tmp_path, \\\"valid\\\")\\n210\\t    approve_valid(root)\\n211\\t    assert run_real_build(root).returncode == 0\\n212\\t\\n213\\t    (root / \\\"src\\\" / \\\"marker.txt\\\").unlink()\\n214\\t    (root / \\\"specs\\\" / \\\"1\\\" / \\\"stub\\\" / \\\"src\\\" / \\\"marker.txt\\\").unlink()\\n215\\t    commit_all(root, \\\"regression: the marker is gone from the tree and the stub\\\")\\n216\\t    amend_problem(root)\\n217\\t\\n218\\t    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n219\\t    assert run.returncode == 1\\n220\\t\\n221\\t    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n222\\t    assert rec[\\\"status\\\"] == \\\"refused\\\"\\n223\\t    assert rec[\\\"refusal\\\"] == \\\"criterion fails against the tree plus stub: checks_marker.sh\\\"\\n224\\t    assert rec[\\\"criteria\\\"] == [{\\\"name\\\": \\\"checks_marker.sh\\\", \\\"kind\\\": \\\"structural\\\", \\\"on_tree\\\": 1, \\\"on_stub\\\": 1}]\\n225\\t\\n226\\t\\n227\\tdef test_spec_gate_removed_deletes_the_path_from_the_stub(tmp_path: Path) -> None:\\n228\\t    \\\"\\\"\\\"Issue #132, acceptance 1. stub/.removed names a path the change\\n229\\t    deletes; the gate must drop it from the stubbed copy before running\\n230\\t    the criteria, so a criterion asserting its absence passes on the\\n231\\t    stub and fails on the tree, where the path is still there. Red\\n232\\t    today: the overlay is add-only, so the path survives into the\\n233\\t    stubbed tree and the criterion fails on both.\\n234\\t    \\\"\\\"\\\"\\n235\\t    root = make_tenant(tmp_path, \\\"removed_present\\\")\\n236\\t    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n237\\t    assert run.returncode == 0\\n238\\t\\n239\\t    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n240\\t    assert rec[\\\"status\\\"] == \\\"pass\\\"\\n241\\t    assert rec[\\\"criteria\\\"] == [{\\\"name\\\": \\\"absent.sh\\\", \\\"kind\\\": \\\"structural\\\", \\\"on_tree\\\": 1, \\\"on_stub\\\": 0}]\\n242\\t    assert rec[\\\"refusal\\\"] is None\\n243\\t\\n244\\t\\n245\\tdef test_spec_gate_removed_refuses_a_path_absent_from_the_tree(tmp_path: Path) -> None:\\n246\\t    \\\"\\\"\\\"Issue #132, acceptance 2. A .removed entry naming a path that\\n247\\t    isn't in the tree at all removes nothing, so it is refused by name\\n248\\t    before any criterion runs -- no criteria entries in the record.\\n249\\t    \\\"\\\"\\\"\\n250\\t    root = make_tenant(tmp_path, \\\"removed_absent\\\")\\n251\\t    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n252\\t    assert run.returncode == 1\\n253\\t    assert \\\"nope.txt\\\" in run.stdout\\n254\\t\\n255\\t    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n256\\t    assert rec[\\\"status\\\"] == \\\"refused\\\"\\n257\\t    assert \\\"nope.txt\\\" in rec[\\\"refusal\\\"]\\n258\\t    assert rec[\\\"criteria\\\"] == []\\n259\\t\\n260\\t\\n261\\tdef test_spec_gate_removed_refuses_a_path_the_stub_also_supplies(tmp_path: Path) -> None:\\n262\\t    \\\"\\\"\\\"Issue #132, acceptance 3. A path named in .removed that the stub\\n263\\t    also supplies is a contradiction -- add and remove the same path --\\n264\\t    and is refused by name before any criterion runs.\\n265\\t    \\\"\\\"\\\"\\n266\\t    root = make_tenant(tmp_path, \\\"removed_contradicts_stub\\\")\\n267\\t    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n268\\t    assert run.returncode == 1\\n269\\t    assert \\\"src/marker.txt\\\" in run.stdout\\n270\\t\\n271\\t    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n272\\t    assert rec[\\\"status\\\"] == \\\"refused\\\"\\n273\\t    assert \\\"src/marker.txt\\\" in rec[\\\"refusal\\\"]\\n274\\t    assert rec[\\\"criteria\\\"] == []\\n275\\t\\n276\\t\\n277\\tdef test_spec_gate_removed_refuses_a_path_outside_the_tree(tmp_path: Path) -> None:\\n278\\t    \\\"\\\"\\\"Issue #132, acceptance 4. A .removed entry that escapes the tree\\n279\\t    is refused by name before any criterion runs -- the stubbed copy is\\n280\\t    the only thing the gate may delete from.\\n281\\t    \\\"\\\"\\\"\\n282\\t    root = make_tenant(tmp_path, \\\"removed_outside_tree\\\")\\n283\\t    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n284\\t    assert run.returncode == 1\\n285\\t    assert \\\"../escape.txt\\\" in run.stdout\\n286\\t\\n287\\t    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n288\\t    assert rec[\\\"status\\\"] == \\\"refused\\\"\\n289\\t    assert \\\"../escape.txt\\\" in rec[\\\"refusal\\\"]\\n290\\t    assert rec[\\\"criteria\\\"] == []\\n291\\t\\n292\\t\\n293\\tdef test_spec_gate_phase1_rule_unchanged_without_build(tmp_path: Path) -> None:\\n294\\t    \\\"\\\"\\\"Issue #28, acceptance 3. No build record at all: the third verdict\\n295\\t    does not apply, and Phase 1's original rule holds unchanged.\\\"\\\"\\\"\\n296\\t    root = make_tenant(tmp_path, \\\"valid\\\")\\n297\\t    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n298\\t    assert run.returncode == 0\\n299\\t    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n300\\t    assert rec[\\\"status\\\"] == \\\"pass\\\"\\n301\\t    assert rec[\\\"criteria\\\"] == [{\\\"name\\\": \\\"checks_marker.sh\\\", \\\"kind\\\": \\\"structural\\\", \\\"on_tree\\\": 1, \\\"on_stub\\\": 0}]\\n302\\t\\n303\\t\\n304\\tdef add_scripted_criterion(root: Path, satisfies_stub: bool) -> None:\\n305\\t    \\\"\\\"\\\"The move an operator makes when an executor skipped a ruling\\n306\\t    nothing enforced: script it, after the build. Adds one criterion,\\n307\\t    extra.sh, testing for extra.txt -- present in the stub overlay only\\n308\\t    when satisfies_stub, so the new criterion fails on the tree (the\\n309\\t    build never created it) and either passes or fails on the stub.\\n310\\t    \\\"\\\"\\\"\\n311\\t    spec_md = root / \\\"specs\\\" / \\\"1\\\" / \\\"spec.md\\\"\\n312\\t    spec_md.write_text(\\n313\\t        spec_md.read_text() + \\\"- extra.sh: a ruling scripted after the build\\\\n\\\")\\n314\\t    script = root / \\\"specs\\\" / \\\"1\\\" / \\\"criteria\\\" / \\\"extra.sh\\\"\\n315\\t    script.write_text(\\\"#!/bin/sh\\\\ntest -f extra.txt\\\\n\\\")\\n316\\t    script.chmod(0o755)\\n317\\t    if satisfies_stub:\\n318\\t        stub_marker = root / \\\"specs\\\" / \\\"1\\\" / \\\"stub\\\" / \\\"extra.txt\\\"\\n319\\t        stub_marker.write_text(\\\"stub\\\\n\\\")\\n320\\t    commit_all(root, \\\"amend: script a ruling the executor skipped\\\")\\n321\\t\\n322\\t\\n323\\tdef test_built_accepts_a_criterion_added_after_the_build(tmp_path: Path) -> None:\\n324\\t    \\\"\\\"\\\"Issue #36, acceptance 1. A criterion added after a build, failing\\n325\\t    on the tree (the build never satisfied it) but passing on the stub\\n326\\t    (a new obligation the next build must meet), does not refuse built\\n327\\t    -- it is exactly the move an operator makes when an executor skipped\\n328\\t    a ruling nothing enforced: script it. Red today: built refuses any\\n329\\t    tree failure regardless of the stub; specimen attavo/code-factory\\n330\\t    spec-22.json, a correct amendment refused by name.\\n331\\t    \\\"\\\"\\\"\\n332\\t    root = make_tenant(tmp_path, \\\"valid\\\")\\n333\\t    approve_valid(root)\\n334\\t    assert run_real_build(root).returncode == 0\\n335\\t\\n336\\t    add_scripted_criterion(root, satisfies_stub=True)\\n337\\t\\n338\\t    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n339\\t    assert run.returncode == 0\\n340\\t\\n341\\t    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n342\\t    assert rec[\\\"status\\\"] == \\\"built\\\"\\n343\\t    assert rec[\\\"refusal\\\"] is None\\n344\\t    by_name = {c[\\\"name\\\"]: c for c in rec[\\\"criteria\\\"]}\\n345\\t    assert by_name[\\\"checks_marker.sh\\\"] == {\\\"name\\\": \\\"checks_marker.sh\\\", \\\"kind\\\": \\\"structural\\\", \\\"on_tree\\\": 0, \\\"on_stub\\\": 0}\\n346\\t    assert by_name[\\\"extra.sh\\\"] == {\\\"name\\\": \\\"extra.sh\\\", \\\"kind\\\": \\\"structural\\\", \\\"on_tree\\\": 1, \\\"on_stub\\\": 0}\\n347\\t\\n348\\t\\n349\\tdef test_built_refuses_a_criterion_failing_on_both(tmp_path: Path) -> None:\\n350\\t    \\\"\\\"\\\"Issue #36, acceptance 2. Same shape, but the new criterion is not\\n351\\t    satisfiable at all -- fails on the tree and on the stub both:\\n352\\t    refused by name, not accepted as a scriptable new obligation.\\n353\\t    \\\"\\\"\\\"\\n354\\t    root = make_tenant(tmp_path, \\\"valid\\\")\\n355\\t    approve_valid(root)\\n356\\t    assert run_real_build(root).returncode == 0\\n357\\t\\n358\\t    add_scripted_criterion(root, satisfies_stub=False)\\n359\\t\\n360\\t    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n361\\t    assert run.returncode == 1\\n362\\t\\n363\\t    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n364\\t    assert rec[\\\"status\\\"] == \\\"refused\\\"\\n365\\t    assert rec[\\\"refusal\\\"] == \\\"criterion fails against the tree plus stub: extra.sh\\\"\\n366\\t    by_name = {c[\\\"name\\\"]: c for c in rec[\\\"criteria\\\"]}\\n367\\t    assert by_name[\\\"extra.sh\\\"] == {\\\"name\\\": \\\"extra.sh\\\", \\\"kind\\\": \\\"structural\\\", \\\"on_tree\\\": 1, \\\"on_stub\\\": 1}\\n368\\t\\n369\\t\\n370\\tdef write_build_record(root: Path, item: str, *, sha: str, status: str) -> None:\\n371\\t    \\\"\\\"\\\"A minimal build-01.json, faked directly rather than run through the\\n372\\t    fixture adapter: the adapter has no way to both commit and halt with a\\n373\\t    question in one invocation (adapters/fixture/run answers a question\\n374\\t    before it ever reaches the write-and-commit step), and cmd_spec_gate\\n375\\t    reads nothing off a build record but sha and status.\\n376\\t    \\\"\\\"\\\"\\n377\\t    records_dir = root / \\\"records\\\" / item\\n378\\t    records_dir.mkdir(parents=True, exist_ok=True)\\n379\\t    (records_dir / \\\"build-01.json\\\").write_text(json.dumps({\\\"sha\\\": sha, \\\"status\\\": status}) + \\\"\\\\n\\\")\\n380\\t\\n381\\t\\n382\\tdef test_spec_gate_built_after_halted_build_that_committed(tmp_path: Path) -> None:\\n383\\t    \\\"\\\"\\\"Issue #98, acceptance 1. The executor commits its work, then halts\\n384\\t    with a question -- the common shape, since it commits before it asks.\\n385\\t    An amendment above the line must still be judged against the tree the\\n386\\t    halted build produced, not refused for the success that tree already\\n387\\t    holds. Red today: refused, \\\"criterion passes against the tree:\\n388\\t    checks_marker.sh\\\" -- the status != \\\"halted\\\" clause excluded the one\\n389\\t    build that had done the work; tenant zero's #663 build-01/spec-02 is\\n390\\t    the specimen.\\n391\\t    \\\"\\\"\\\"\\n392\\t    root = make_tenant(tmp_path, \\\"valid\\\")\\n393\\t    approve_valid(root)\\n394\\t    complete_the_build(root)\\n395\\t    build_sha = git(root, \\\"rev-parse\\\", \\\"HEAD\\\").strip()\\n396\\t    write_build_record(root, \\\"1\\\", sha=build_sha, status=\\\"halted\\\")\\n397\\t\\n398\\t    amend_problem(root)\\n399\\t\\n400\\t    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n401\\t    assert run.returncode == 0\\n402\\t\\n403\\t    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n404\\t    assert rec[\\\"status\\\"] == \\\"built\\\"\\n405\\t    assert rec[\\\"criteria\\\"] == [{\\\"name\\\": \\\"checks_marker.sh\\\", \\\"kind\\\": \\\"structural\\\", \\\"on_tree\\\": 0, \\\"on_stub\\\": 0}]\\n406\\t    assert rec[\\\"refusal\\\"] is None\\n407\\t\\n408\\t\\n409\\tdef test_spec_gate_stub_verdict_after_halted_build_that_committed_nothing(tmp_path: Path) -> None:\\n410\\t    \\\"\\\"\\\"Issue #98, acceptance 2. A halted build whose sha equals its\\n411\\t    start_sha did no work -- commit_postdates already treats that as\\n412\\t    postdating nothing -- so the gate must keep judging it against the\\n413\\t    stub, exactly as before the fix: Phase 1's rule, not built. The\\n414\\t    criterion still fails on the real tree (no build ever touched it) and\\n415\\t    passes on the stub, so the verdict is pass, not built and not refused.\\n416\\t    \\\"\\\"\\\"\\n417\\t    root = make_tenant(tmp_path, \\\"valid\\\")\\n418\\t    approve_valid(root)\\n419\\t    approval_sha = git(root, \\\"rev-parse\\\", \\\"HEAD\\\").strip()\\n420\\t    write_build_record(root, \\\"1\\\", sha=approval_sha, status=\\\"halted\\\")\\n421\\t\\n422\\t    amend_problem(root)\\n423\\t\\n424\\t    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n425\\t    assert run.returncode == 0\\n426\\t\\n427\\t    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n428\\t    assert rec[\\\"status\\\"] == \\\"pass\\\"\\n429\\t    assert rec[\\\"criteria\\\"] == [{\\\"name\\\": \\\"checks_marker.sh\\\", \\\"kind\\\": \\\"structural\\\", \\\"on_tree\\\": 1, \\\"on_stub\\\": 0}]\\n430\\t    assert rec[\\\"refusal\\\"] is None\\n431\\t\\n432\\t\\n433\\tdef add_root_cause_line(root: Path, root_cause: str) -> None:\\n434\\t    spec_md = root / \\\"specs\\\" / \\\"1\\\" / \\\"spec.md\\\"\\n435\\t    # a root-cause item is core (ruled 2026-09-27); the fixture declares fix\\n436\\t    text = spec_md.read_text().replace(\\\"Class: fix\\\\n\\\", \\\"Class: core\\\\n\\\", 1)\\n437\\t    text = text.replace(\\\"## Problem\\\\n\\\", f\\\"## Problem\\\\n\\\\nRoot-cause: {root_cause}\\\\n\\\", 1)\\n438\\t    spec_md.write_text(text)\\n439\\t    commit_all(root, f\\\"name root cause {root_cause}\\\")\\n440\\t\\n441\\t\\n442\\tdef test_spec_gate_refuses_a_root_cause_the_tenant_does_not_list_and_passes_a_listed_one(tmp_path: Path) -> None:\\n443\\t    \\\"\\\"\\\"Root causes (#229 build-04 and the convergence ruling of\\n444\\t    2026-09-27): a fix item names the root cause its change closes as one\\n445\\t    'Root-cause: <slug>' line in its problem, and the gate refuses a slug\\n446\\t    the tenant's root-causes.md (beside the specs directory) does not\\n447\\t    list, or a line with no such file. Written red first: on v0.30.0 the\\n448\\t    line is prose and the gate passes it.\\\"\\\"\\\"\\n449\\t    root = make_tenant(tmp_path, \\\"valid\\\")\\n450\\t    add_root_cause_line(root, \\\"shared-working-copy\\\")\\n451\\t    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n452\\t    assert run.returncode == 1, run.stdout + run.stderr\\n453\\t    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n454\\t    assert rec[\\\"status\\\"] == \\\"refused\\\"\\n455\\t    assert rec[\\\"refusal\\\"] == \\\"root cause: shared-working-copy named but root-causes.md does not exist\\\", rec[\\\"refusal\\\"]\\n456\\t    assert rec[\\\"criteria\\\"] == [], \\\"refused before any criterion ran\\\"\\n457\\t\\n458\\t    (root / \\\"root-causes.md\\\").write_text(\\n459\\t        \\\"# root causes\\\\n\\\\n- liveness-by-proxy: a pid stood in for the holder\\\\n\\\")\\n460\\t    commit_all(root, \\\"list one root cause\\\")\\n461\\t    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n462\\t    assert run.returncode == 1\\n463\\t    assert latest_record(root, \\\"1\\\", \\\"spec\\\")[\\\"refusal\\\"] == \\\"root cause: shared-working-copy is not listed in root-causes.md\\\"\\n464\\t\\n465\\t    (root / \\\"root-causes.md\\\").write_text(\\n466\\t        \\\"# root causes\\\\n\\\\n- liveness-by-proxy: a pid stood in for the holder\\\\n\\\"\\n467\\t        \\\"- shared-working-copy: one checkout, many writers\\\\n\\\")\\n468\\t    commit_all(root, \\\"list the root cause\\\")\\n469\\t    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n470\\t    assert run.returncode == 0, run.stdout + run.stderr\\n471\\t    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n472\\t    assert rec[\\\"status\\\"] == \\\"pass\\\" and rec[\\\"refusal\\\"] is None\\n473\\t\\n474\\t\\n475\\tdef test_spec_gate_leaves_a_spec_with_no_root_cause_line_alone(tmp_path: Path) -> None:\\n476\\t    \\\"\\\"\\\"A capability item has no root cause; the check is on the line, not\\n477\\t    on every spec, and a tenant with no root-causes.md is not asked for\\n478\\t    one.\\\"\\\"\\\"\\n479\\t    root = make_tenant(tmp_path, \\\"valid\\\")\\n480\\t    assert not (root / \\\"root-causes.md\\\").exists()\\n481\\t    assert run_attavo(root, \\\"spec-gate\\\", \\\"1\\\").returncode == 0\\n482\\t\\n483\\t\\n484\\t# --- the item's class and the research policy (ruled 2026-09-25, 2026-09-27) ---\\n485\\t\\n486\\tdef set_class_line(root: Path, line: str | None) -> None:\\n487\\t    spec_md = root / \\\"specs\\\" / \\\"1\\\" / \\\"spec.md\\\"\\n488\\t    text = spec_md.read_text().replace(\\\"Class: fix\\\\n\\\", \\\"\\\" if line is None else line + \\\"\\\\n\\\", 1)\\n489\\t    spec_md.write_text(text)\\n490\\t    commit_all(root, f\\\"class line: {line}\\\")\\n491\\t\\n492\\t\\n493\\tdef test_spec_gate_refuses_a_spec_that_declares_no_class_before_any_criterion_runs(tmp_path: Path) -> None:\\n494\\t    root = make_tenant(tmp_path, \\\"valid\\\")\\n495\\t    set_class_line(root, None)\\n496\\t    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n497\\t    assert run.returncode == 1, run.stdout + run.stderr\\n498\\t    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n499\\t    assert rec[\\\"status\\\"] == \\\"refused\\\" and rec[\\\"criteria\\\"] == [], rec\\n500\\t    assert rec[\\\"refusal\\\"] == \\\"class: none declared; add a line 'Class: core' or 'Class: fix' to the problem\\\", rec[\\\"refusal\\\"]\\n501\\t    assert rec[\\\"class\\\"] is None and rec[\\\"research\\\"] == \\\"not required by policy\\\", rec\\n502\\t\\n503\\t\\n504\\tdef test_spec_gate_refuses_a_class_other_than_core_or_fix(tmp_path: Path) -> None:\\n505\\t    root = make_tenant(tmp_path, \\\"valid\\\")\\n506\\t    set_class_line(root, \\\"Class: feature\\\")\\n507\\t    assert run_attavo(root, \\\"spec-gate\\\", \\\"1\\\").returncode == 1\\n508\\t    assert latest_record(root, \\\"1\\\", \\\"spec\\\")[\\\"refusal\\\"] == \\\"class: feature is not core or fix\\\"\\n509\\t\\n510\\t\\n511\\tdef test_spec_gate_refuses_a_root_cause_item_declared_fix(tmp_path: Path) -> None:\\n512\\t    root = make_tenant(tmp_path, \\\"valid\\\")\\n513\\t    (root / \\\"root-causes.md\\\").write_text(\\\"# root causes\\\\n\\\\n- shared-working-copy: one checkout, many writers\\\\n\\\")\\n514\\t    spec_md = root / \\\"specs\\\" / \\\"1\\\" / \\\"spec.md\\\"\\n515\\t    spec_md.write_text(spec_md.read_text().replace(\\\"## Problem\\\\n\\\", \\\"## Problem\\\\n\\\\nRoot-cause: shared-working-copy\\\\n\\\", 1))\\n516\\t    commit_all(root, \\\"a root cause named on a fix\\\")\\n517\\t    assert run_attavo(root, \\\"spec-gate\\\", \\\"1\\\").returncode == 1\\n518\\t    assert latest_record(root, \\\"1\\\", \\\"spec\\\")[\\\"refusal\\\"] == \\\"class: fix with root cause shared-working-copy; a root-cause item is core\\\"\\n519\\t\\n520\\t\\n521\\tdef test_spec_gate_records_the_class_and_that_research_was_not_required(tmp_path: Path) -> None:\\n522\\t    root = make_tenant(tmp_path, \\\"valid\\\")\\n523\\t    set_class_line(root, \\\"Class: core\\\")\\n524\\t    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n525\\t    assert run.returncode == 0, run.stdout + run.stderr\\n526\\t    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n527\\t    assert rec[\\\"status\\\"] == \\\"pass\\\" and rec[\\\"class\\\"] == \\\"core\\\", rec\\n528\\t    assert rec[\\\"research\\\"] == \\\"not required by policy\\\", rec\\n529\\t\\n530\\t\\n531\\tdef test_with_research_required_a_core_spec_owes_a_research_record_and_a_fix_spec_does_not(tmp_path: Path) -> None:\\n532\\t    root = make_tenant(tmp_path, \\\"valid\\\")\\n533\\t    manifest = root / \\\"attavo.toml\\\"\\n534\\t    text = manifest.read_text()\\n535\\t    assert \\\"[spec]\\\\n\\\" in text, text\\n536\\t    manifest.write_text(text.replace(\\\"[spec]\\\\n\\\", '[spec]\\\\nresearch = \\\"required\\\"\\\\n', 1))\\n537\\t    commit_all(root, \\\"research required\\\")\\n538\\t    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n539\\t    assert run.returncode == 0, run.stdout + run.stderr\\n540\\t    assert latest_record(root, \\\"1\\\", \\\"spec\\\")[\\\"research\\\"] == \\\"required\\\"\\n541\\t    set_class_line(root, \\\"Class: core\\\")\\n542\\t    assert run_attavo(root, \\\"spec-gate\\\", \\\"1\\\").returncode == 1\\n543\\t    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n544\\t    assert rec[\\\"refusal\\\"] == \\\"research: [spec].research is required and the item has no research record\\\", rec\\n545\\t    (root / \\\"records\\\" / \\\"1\\\" / \\\"research-01.json\\\").write_text(\\\"{}\\\\n\\\")\\n546\\t    commit_all(root, \\\"a research record\\\")\\n547\\t    assert run_attavo(root, \\\"spec-gate\\\", \\\"1\\\").returncode == 0\\n548\\t\\n549\\t\\n550\\tdef test_an_approved_and_built_item_whose_spec_declares_no_class_still_regates_built(tmp_path: Path) -> None:\\n551\\t    \\\"\\\"\\\"No item in flight is stranded: class is required before approval,\\n552\\t    and an item approved and built before the gate read class re-gates\\n553\\t    after an amendment exactly as it did.\\\"\\\"\\\"\\n554\\t    root = make_tenant(tmp_path, \\\"valid\\\")\\n555\\t    approve_valid(root)\\n556\\t    assert run_real_build(root).returncode == 0\\n557\\t    set_class_line(root, None)\\n558\\t    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n559\\t    assert run.returncode == 0, run.stdout + run.stderr\\n560\\t    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n561\\t    assert rec[\\\"status\\\"] == \\\"built\\\" and rec[\\\"class\\\"] is None, rec\\n562\\t\\n563\\t\\n564\\tdef test_spec_gate_refuses_a_stub_that_touches_a_path_the_claims_do_not_name(tmp_path: Path) -> None:\\n565\\t    \\\"\\\"\\\"Item 229's third attempt: the change needed attavo/common.py, the\\n566\\t    Claims list did not name it, and the gate found out 2,754 s later. The\\n567\\t    stub is the change's floor, so a stub path outside the claims is a\\n568\\t    wrong Claims list before any build runs. Red first against v0.29.0.\\\"\\\"\\\"\\n569\\t    root = make_tenant(tmp_path, \\\"valid\\\")\\n570\\t    stub = root / \\\"specs\\\" / \\\"1\\\" / \\\"stub\\\"\\n571\\t    (stub / \\\"lib\\\").mkdir(parents=True)\\n572\\t    (stub / \\\"lib\\\" / \\\"helper.py\\\").write_text(\\\"x = 1\\\\n\\\")\\n573\\t    commit_all(root, \\\"a stub file the claims do not name\\\")\\n574\\t    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n575\\t    assert run.returncode == 1, run.stdout + run.stderr\\n576\\t    assert \\\"stub touches a path the claims do not name: lib/helper.py\\\" in run.stdout, run.stdout\\n577\\t    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n578\\t    assert rec[\\\"status\\\"] == \\\"refused\\\" and \\\"lib/helper.py\\\" in rec[\\\"refusal\\\"], rec\\n579\\t    spec_md = root / \\\"specs\\\" / \\\"1\\\" / \\\"spec.md\\\"\\n580\\t    spec_md.write_text(spec_md.read_text().replace(\\\"- src/**\\\\n\\\", \\\"- src/**\\\\n- lib/\\\\n\\\"))\\n581\\t    commit_all(root, \\\"claim the directory\\\")\\n582\\t    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n583\\t    assert run.returncode == 0, run.stdout + run.stderr\\n584\\t    assert latest_record(root, \\\"1\\\", \\\"spec\\\")[\\\"status\\\"] == \\\"pass\\\"\\n585\\t\\n586\\t\\n587\\t# Issue #340 (rulings 1 and 2 on #299): criterion kinds, so a stub can be thin.\\n588\\t\\n589\\tdef set_criteria(root: Path, lines: list[str], scripts: dict[str, str],\\n590\\t                 stub: dict[str, str] | None = None) -> None:\\n591\\t    \\\"\\\"\\\"Replace the valid fixture's Criteria with `lines` (spec.md bullets),\\n592\\t    write each script executable, and set the stub overlay to `stub`\\n593\\t    (path -> content) in place of the fixture's marker.txt.\\\"\\\"\\\"\\n594\\t    spec_dir = root / \\\"specs\\\" / \\\"1\\\"\\n595\\t    spec_md = spec_dir / \\\"spec.md\\\"\\n596\\t    head = spec_md.read_text().split(\\\"## Criteria\\\")[0]\\n597\\t    spec_md.write_text(head + \\\"## Criteria\\\\n\\\\n\\\" + \\\"\\\\n\\\".join(lines) + \\\"\\\\n\\\")\\n598\\t    criteria = spec_dir / \\\"criteria\\\"\\n599\\t    for old in criteria.iterdir():\\n600\\t        old.unlink()\\n601\\t    for name, body in scripts.items():\\n602\\t        (criteria / name).write_text(\\\"#!/bin/sh\\\\n\\\" + body + \\\"\\\\n\\\")\\n603\\t        (criteria / name).chmod(0o755)\\n604\\t    shutil.rmtree(spec_dir / \\\"stub\\\")\\n605\\t    for rel, content in (stub or {}).items():\\n606\\t        (spec_dir / \\\"stub\\\" / rel).parent.mkdir(parents=True, exist_ok=True)\\n607\\t        (spec_dir / \\\"stub\\\" / rel).write_text(content)\\n608\\t    commit_all(root, \\\"criteria with kinds\\\")\\n609\\t\\n610\\t\\n611\\tSTRUCT = \\\"- [structural] checks_marker.sh: the marker file exists\\\"\\n612\\tBEHAV = \\\"- [behavioural] logic.sh: the logic reports done\\\"\\n613\\tTHIN_SCRIPTS = {\\\"checks_marker.sh\\\": \\\"test -f src/marker.txt\\\",\\n614\\t                \\\"logic.sh\\\": \\\"test \\\\\\\"$(cat src/logic.txt 2>/dev/null)\\\\\\\" = done\\\"}\\n615\\tTHIN_STUB = {\\\"src/marker.txt\\\": \\\"ok\\\\n\\\", \\\"src/logic.txt\\\": \\\"todo\\\\n\\\"}\\n616\\t\\n617\\t\\n618\\tdef test_a_thin_stub_passes_and_the_record_carries_each_criterions_kind(tmp_path: Path) -> None:\\n619\\t    root = make_tenant(tmp_path, \\\"valid\\\")\\n620\\t    set_criteria(root, [STRUCT, BEHAV], THIN_SCRIPTS, THIN_STUB)\\n621\\t    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n622\\t    assert run.returncode == 0, run.stdout + run.stderr\\n623\\t    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n624\\t    assert rec[\\\"status\\\"] == \\\"pass\\\"\\n625\\t    assert rec[\\\"criteria\\\"] == [\\n626\\t        {\\\"name\\\": \\\"checks_marker.sh\\\", \\\"kind\\\": \\\"structural\\\", \\\"on_tree\\\": 1, \\\"on_stub\\\": 0},\\n627\\t        {\\\"name\\\": \\\"logic.sh\\\", \\\"kind\\\": \\\"behavioural\\\", \\\"on_tree\\\": 1, \\\"on_stub\\\": 1}]\\n628\\t\\n629\\t\\n630\\tdef test_a_behavioural_criterion_that_passes_on_the_stub_is_refused_by_name(tmp_path: Path) -> None:\\n631\\t    root = make_tenant(tmp_path, \\\"valid\\\")\\n632\\t    set_criteria(root, [STRUCT, BEHAV], THIN_SCRIPTS,\\n633\\t                 {\\\"src/marker.txt\\\": \\\"ok\\\\n\\\", \\\"src/logic.txt\\\": \\\"done\\\\n\\\"})\\n634\\t    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n635\\t    assert run.returncode == 1\\n636\\t    want = \\\"criterion labelled behavioural passes on the tree plus stub: logic.sh\\\"\\n637\\t    assert want in run.stdout, run.stdout\\n638\\t    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n639\\t    assert rec[\\\"status\\\"] == \\\"refused\\\" and rec[\\\"refusal\\\"] == want\\n640\\t\\n641\\t\\n642\\tdef test_a_structural_criterion_that_fails_on_the_stub_is_refused_by_name(tmp_path: Path) -> None:\\n643\\t    root = make_tenant(tmp_path, \\\"valid\\\")\\n644\\t    set_criteria(root, [STRUCT, BEHAV], THIN_SCRIPTS, {\\\"src/logic.txt\\\": \\\"todo\\\\n\\\"})\\n645\\t    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n646\\t    assert run.returncode == 1\\n647\\t    want = \\\"criterion labelled structural fails on the tree plus stub: checks_marker.sh\\\"\\n648\\t    assert want in run.stdout, run.stdout\\n649\\t    assert latest_record(root, \\\"1\\\", \\\"spec\\\")[\\\"refusal\\\"] == want\\n650\\t\\n651\\t\\n652\\tdef test_an_unknown_kind_label_is_refused_by_name(tmp_path: Path) -> None:\\n653\\t    root = make_tenant(tmp_path, \\\"valid\\\")\\n654\\t    set_criteria(root, [\\\"- [cosmetic] checks_marker.sh: the marker file exists\\\"],\\n655\\t                 {\\\"checks_marker.sh\\\": \\\"test -f src/marker.txt\\\"}, {\\\"src/marker.txt\\\": \\\"ok\\\\n\\\"})\\n656\\t    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n657\\t    assert run.returncode == 1\\n658\\t    want = \\\"criterion has an unknown kind [cosmetic]: checks_marker.sh\\\"\\n659\\t    assert want in run.stdout, run.stdout\\n660\\t    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n661\\t    assert rec[\\\"status\\\"] == \\\"refused\\\" and rec[\\\"refusal\\\"] == want\\n662\\t\\n663\\t\\n664\\tdef test_an_unlabelled_criterion_is_structural(tmp_path: Path) -> None:\\n665\\t    root = make_tenant(tmp_path, \\\"valid\\\")\\n666\\t    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n667\\t    assert run.returncode == 0, run.stdout + run.stderr\\n668\\t    assert latest_record(root, \\\"1\\\", \\\"spec\\\")[\\\"criteria\\\"] == [\\n669\\t        {\\\"name\\\": \\\"checks_marker.sh\\\", \\\"kind\\\": \\\"structural\\\", \\\"on_tree\\\": 1, \\\"on_stub\\\": 0}]\\n670\\t    # An unlabelled criterion failing on the stub is refused as structural.\\n671\\t    set_criteria(root, [\\\"- checks_marker.sh: the marker file exists\\\"],\\n672\\t                 {\\\"checks_marker.sh\\\": \\\"test -f src/marker.txt\\\"}, {})\\n673\\t    assert run_attavo(root, \\\"spec-gate\\\", \\\"1\\\").returncode == 1\\n674\\t\\n675\\t\\n676\\t@pytest.mark.own_records\\n677\\tdef test_every_merged_spec_parses_with_unlabelled_criteria_structural() -> None:\\n678\\t    \\\"\\\"\\\"Regression: every spec under attest/specs/ parses with no refusal and\\n679\\t    no label leaking into a name, and each criterion's kind is the one its\\n680\\t    line declares: unlabelled is structural. Specs written before labels\\n681\\t    are all unlabelled; #344's was the first labelled one, and an earlier\\n682\\t    form of this test asserted that no spec would ever carry a label.\\\"\\\"\\\"\\n683\\t    from attavo.spec import KIND_LABEL, parse_spec\\n684\\t    specs = sorted((ROOT / \\\"attest\\\" / \\\"specs\\\").glob(\\\"*/spec.md\\\"))\\n685\\t    assert specs\\n686\\t    for spec_md in specs:\\n687\\t        parsed, refusal = parse_spec(spec_md)\\n688\\t        assert refusal is None and parsed is not None, spec_md\\n689\\t        assert all(not n.startswith(\\\"[\\\") for n in parsed[\\\"criteria\\\"]), spec_md\\n690\\t        assert list(parsed[\\\"kinds\\\"]) == parsed[\\\"criteria\\\"], spec_md\\n691\\t        for line in spec_md.read_text().split(\\\"## Criteria\\\", 1)[1].splitlines():\\n692\\t            s = line.strip()\\n693\\t            if not s.startswith(\\\"- \\\") or \\\":\\\" not in s:\\n694\\t                continue\\n695\\t            label = KIND_LABEL.match(s[2:])\\n696\\t            name = (s[2:][label.end():] if label else s[2:]).split(\\\":\\\", 1)[0].strip()\\n697\\t            declared = label.group(1).strip() if label else \\\"structural\\\"\\n698\\t            assert parsed[\\\"kinds\\\"][name] == declared, (spec_md, name)\\n699\\t\\n700\\t\\n701\\tdef test_built_refuses_a_behavioural_criterion_that_fails_on_the_tree(tmp_path: Path) -> None:\\n702\\t    root = make_tenant(tmp_path, \\\"valid\\\")\\n703\\t    approve_valid(root)\\n704\\t    assert run_real_build(root).returncode == 0\\n705\\t    spec_md = root / \\\"specs\\\" / \\\"1\\\" / \\\"spec.md\\\"\\n706\\t    spec_md.write_text(spec_md.read_text() + BEHAV + \\\"\\\\n\\\")\\n707\\t    script = root / \\\"specs\\\" / \\\"1\\\" / \\\"criteria\\\" / \\\"logic.sh\\\"\\n708\\t    script.write_text(\\\"#!/bin/sh\\\\n\\\" + THIN_SCRIPTS[\\\"logic.sh\\\"] + \\\"\\\\n\\\")\\n709\\t    script.chmod(0o755)\\n710\\t    (root / \\\"specs\\\" / \\\"1\\\" / \\\"stub\\\" / \\\"src\\\" / \\\"logic.txt\\\").write_text(\\\"todo\\\\n\\\")\\n711\\t    commit_all(root, \\\"amend: a behavioural criterion the build never met\\\")\\n712\\t    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n713\\t    assert run.returncode == 1\\n714\\t    want = \\\"criterion labelled behavioural fails on the tree: logic.sh\\\"\\n715\\t    assert want in run.stdout, run.stdout\\n716\\t    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n717\\t    assert rec[\\\"status\\\"] == \\\"refused\\\" and rec[\\\"refusal\\\"] == want\\n718\\t\\n719\\t\\n720\\tdef test_built_accepts_a_behavioural_criterion_that_passes_on_the_tree(tmp_path: Path) -> None:\\n721\\t    root = make_tenant(tmp_path, \\\"valid\\\")\\n722\\t    approve_valid(root)\\n723\\t    assert run_real_build(root).returncode == 0\\n724\\t    spec_md = root / \\\"specs\\\" / \\\"1\\\" / \\\"spec.md\\\"\\n725\\t    spec_md.write_text(spec_md.read_text() + BEHAV + \\\"\\\\n\\\")\\n726\\t    script = root / \\\"specs\\\" / \\\"1\\\" / \\\"criteria\\\" / \\\"logic.sh\\\"\\n727\\t    script.write_text(\\\"#!/bin/sh\\\\n\\\" + THIN_SCRIPTS[\\\"logic.sh\\\"] + \\\"\\\\n\\\")\\n728\\t    script.chmod(0o755)\\n729\\t    (root / \\\"specs\\\" / \\\"1\\\" / \\\"stub\\\" / \\\"src\\\" / \\\"logic.txt\\\").write_text(\\\"todo\\\\n\\\")\\n730\\t    (root / \\\"src\\\" / \\\"logic.txt\\\").write_text(\\\"done\\\\n\\\")\\n731\\t    commit_all(root, \\\"amend: a behavioural criterion the build met\\\")\\n732\\t    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n733\\t    assert run.returncode == 0, run.stdout + run.stderr\\n734\\t    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n735\\t    assert rec[\\\"status\\\"] == \\\"built\\\"\\n736\\t    by_name = {c[\\\"name\\\"]: c for c in rec[\\\"criteria\\\"]}\\n737\\t    assert by_name[\\\"logic.sh\\\"] == {\\\"name\\\": \\\"logic.sh\\\", \\\"kind\\\": \\\"behavioural\\\", \\\"on_tree\\\": 0, \\\"on_stub\\\": 1}\\n738\\t\\n739\\t\\n740\\tNO_STRUCTURAL = (\\\"no structural criterion: nothing shows the stub reaches \\\"\\n741\\t                 \\\"what the behavioural criteria test\\\")\\n742\\t\\n743\\t\\n744\\tdef test_a_spec_of_only_behavioural_criteria_is_refused(tmp_path: Path) -> None:\\n745\\t    root = make_tenant(tmp_path, \\\"valid\\\")\\n746\\t    set_criteria(root, [BEHAV], {\\\"logic.sh\\\": THIN_SCRIPTS[\\\"logic.sh\\\"]},\\n747\\t                 {\\\"src/logic.txt\\\": \\\"todo\\\\n\\\"})\\n748\\t    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n749\\t    assert run.returncode == 1\\n750\\t    assert NO_STRUCTURAL in run.stdout, run.stdout\\n751\\t    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n752\\t    assert rec[\\\"status\\\"] == \\\"refused\\\" and rec[\\\"refusal\\\"] == NO_STRUCTURAL\\n753\\t\\n754\\t\\n755\\tdef test_the_no_structural_refusal_comes_before_any_criterion_refusal(tmp_path: Path) -> None:\\n756\\t    \\\"\\\"\\\"The one behavioural criterion here also passes on the stub, which\\n757\\t    alone would be refused by name; the spec-level refusal is reported.\\\"\\\"\\\"\\n758\\t    root = make_tenant(tmp_path, \\\"valid\\\")\\n759\\t    set_criteria(root, [BEHAV], {\\\"logic.sh\\\": THIN_SCRIPTS[\\\"logic.sh\\\"]},\\n760\\t                 {\\\"src/logic.txt\\\": \\\"done\\\\n\\\"})\\n761\\t    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n762\\t    assert run.returncode == 1\\n763\\t    assert latest_record(root, \\\"1\\\", \\\"spec\\\")[\\\"refusal\\\"] == NO_STRUCTURAL\\n764\\t\\n765\\t\\n766\\tNO_CRITERIA = \\\"criteria: empty; the spec asserts nothing\\\"\\n767\\t\\n768\\t\\n769\\tdef test_a_spec_with_no_criteria_is_refused_before_any_criterion_runs(tmp_path: Path) -> None:\\n770\\t    \\\"\\\"\\\"An empty Criteria section and no criteria/ directory asserts nothing.\\n771\\t    Zero criteria match zero files, so before this rule the gate passed it\\n772\\t    and an approval bound to no executable claim could follow.\\\"\\\"\\\"\\n773\\t    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n774\\t    spec_dir = root / \\\"specs\\\" / \\\"1\\\"\\n775\\t    spec_md = spec_dir / \\\"spec.md\\\"\\n776\\t    spec_md.write_text(spec_md.read_text().split(\\\"## Criteria\\\")[0] + \\\"## Criteria\\\\n\\\\n\\\")\\n777\\t    shutil.rmtree(spec_dir / \\\"criteria\\\")\\n778\\t    commit_all(root, \\\"criteria emptied\\\")\\n779\\t    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n780\\t    assert run.returncode == 1\\n781\\t    assert NO_CRITERIA in run.stdout, run.stdout\\n782\\t    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n783\\t    assert rec[\\\"status\\\"] == \\\"refused\\\"\\n784\\t    assert rec[\\\"criteria\\\"] == []\\n785\\t    assert rec[\\\"refusal\\\"] == NO_CRITERIA\\n786\\t\\n787\\t\\n788\\t# Issue #351: a criterion that could not check is not a failing criterion.\\n789\\t\\n790\\tCOULD_NOT_CHECK = \\\"criterion could not check (exit 2): \\\"\\n791\\t\\n792\\t\\n793\\tdef test_a_behavioural_criterion_that_exits_other_than_1_on_both_is_refused_by_name(tmp_path: Path) -> None:\\n794\\t    \\\"\\\"\\\"Specimen: #349's behavioural criterion exited 2 (its own code for\\n795\\t    \\\"the scenario could not be set up\\\") on the tree and on the stub in the\\n796\\t    CI gate, and v0.34.0 accepted 2/2 as \\\"fails on both\\\".\\\"\\\"\\\"\\n797\\t    root = make_tenant(tmp_path, \\\"valid\\\")\\n798\\t    set_criteria(root, [STRUCT, \\\"- [behavioural] broken.sh: a scenario that cannot be set up\\\"],\\n799\\t                 {\\\"checks_marker.sh\\\": \\\"test -f src/marker.txt || exit 1\\\",\\n800\\t                  \\\"broken.sh\\\": \\\"exit 2\\\"},\\n801\\t                 THIN_STUB)\\n802\\t    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n803\\t    assert run.returncode == 1, run.stdout + run.stderr\\n804\\t    assert COULD_NOT_CHECK + \\\"broken.sh\\\" in run.stdout, run.stdout\\n805\\t    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n806\\t    assert rec[\\\"status\\\"] == \\\"refused\\\" and rec[\\\"refusal\\\"] == COULD_NOT_CHECK + \\\"broken.sh\\\"\\n807\\t\\n808\\t\\n809\\tdef test_a_structural_criterion_that_exits_other_than_1_on_the_tree_is_refused_by_name(tmp_path: Path) -> None:\\n810\\t    \\\"\\\"\\\"`grep -q` on a missing file exits 2; a structural criterion must say\\n811\\t    1 when the thing it checks is absent, so a crash is told from a no.\\\"\\\"\\\"\\n812\\t    root = make_tenant(tmp_path, \\\"valid\\\")\\n813\\t    set_criteria(root, [\\\"- [structural] crashes.sh: the marker file exists\\\"],\\n814\\t                 {\\\"crashes.sh\\\": \\\"test -f src/marker.txt || exit 3\\\"},\\n815\\t                 THIN_STUB)\\n816\\t    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n817\\t    assert run.returncode == 1, run.stdout + run.stderr\\n818\\t    assert \\\"criterion could not check (exit 3): crashes.sh\\\" in run.stdout, run.stdout\\n819\\t    assert latest_record(root, \\\"1\\\", \\\"spec\\\")[\\\"refusal\\\"] == \\\"criterion could not check (exit 3): crashes.sh\\\"\\n820\\t\\n821\\t\\n822\\tdef test_a_thin_stub_whose_criteria_exit_exactly_1_still_passes(tmp_path: Path) -> None:\\n823\\t    root = make_tenant(tmp_path, \\\"valid\\\")\\n824\\t    set_criteria(root, [STRUCT, BEHAV],\\n825\\t                 {\\\"checks_marker.sh\\\": \\\"test -f src/marker.txt || exit 1\\\",\\n826\\t                  \\\"logic.sh\\\": \\\"test \\\\\\\"$(cat src/logic.txt 2>/dev/null)\\\\\\\" = done || exit 1\\\"},\\n827\\t                 THIN_STUB)\\n828\\t    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n829\\t    assert run.returncode == 0, run.stdout + run.stderr\\n830\\t    assert latest_record(root, \\\"1\\\", \\\"spec\\\")[\\\"status\\\"] == \\\"pass\\\"\\n831\\t\"}]},\"parent_tool_use_id\":null,\"session_id\":\"0fabd1e2-92b8-4212-a6d0-e85fc14548ff\",\"uuid\":\"4a48c1a7-b9c2-4b8f-9360-ab23c8d8ed94\",\"timestamp\":\"2026-10-14T19:57:56.206Z\",\"tool_use_result\":{\"type\":\"text\",\"file\":{\"filePath\":\"/Users/davidbean/.claude/projects/-Users-davidbean-Projects-attavo-worktree-351/0fabd1e2-92b8-4212-a6d0-e85fc14548ff/tool-results/bic488230.txt\",\"content\":\"\\\"\\\"\\\"The spec contract: attavo spec-gate N.\\n\\nEach test is a rejection test, written and run red before the capability\\nexisted: on `main` at commit 22ca1e1 there was no `spec-gate` subcommand, so\\nevery one of these failed with \\\"unknown subcommand\\\".\\n\\nRun: python3 -m pytest tests -q\\n\\\"\\\"\\\"\\nimport json\\nimport os\\nimport shutil\\nimport subprocess\\nimport sys\\nfrom pathlib import Path\\nfrom typing import Any, cast\\n\\nimport pytest\\nfrom helpers import commit_all, git, make_tenant\\n\\nROOT = Path(__file__).resolve().parent.parent\\nATTAVO = ROOT / \\\"bin\\\" / \\\"attavo\\\"\\n\\n\\ndef run_attavo(root: Path, *args: str, env: dict[str, Any] | None = None) -> subprocess.CompletedProcess[str]:\\n    full_env = dict(os.environ)\\n    if env:\\n        full_env.update(env)\\n    return subprocess.run([sys.executable, str(ATTAVO), *args], cwd=str(root),\\n                          capture_output=True, text=True, check=False, env=full_env)\\n\\n\\ndef latest_record(root: Path, item: str, stage: str) -> dict[str, Any]:\\n    records = sorted((root / \\\"records\\\" / item).glob(f\\\"{stage}-*.json\\\"))\\n    assert records, f\\\"no {stage} record for item {item}\\\"\\n    return cast(dict[str, Any], json.loads(records[-1].read_text()))\\n\\n\\ndef test_spec_gate_refuses_prose_criterion(tmp_path: Path) -> None:\\n    root = make_tenant(tmp_path, \\\"prose_criterion\\\")\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 1\\n    assert \\\"missing.sh\\\" in run.stdout\\n    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n    assert rec[\\\"status\\\"] == \\\"refused\\\"\\n    assert \\\"missing.sh\\\" in rec[\\\"refusal\\\"]\\n    # issue #49: this fixture's manifest carries no [attavo] table at all --\\n    # product_pin is the absent fact, null, not a crash reading it.\\n    assert rec[\\\"product_pin\\\"] is None\\n    assert rec[\\\"product_version\\\"]\\n\\n\\ndef test_spec_gate_refuses_criterion_passing_on_tree(tmp_path: Path) -> None:\\n    root = make_tenant(tmp_path, \\\"passes_on_tree\\\")\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 1\\n    assert \\\"checks.sh\\\" in run.stdout\\n    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n    assert rec[\\\"status\\\"] == \\\"refused\\\"\\n    assert \\\"checks.sh\\\" in rec[\\\"refusal\\\"]\\n\\n\\ndef test_spec_gate_refuses_criterion_failing_on_stub(tmp_path: Path) -> None:\\n    root = make_tenant(tmp_path, \\\"fails_on_stub\\\")\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 1\\n    assert \\\"checks.sh\\\" in run.stdout\\n    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n    assert rec[\\\"status\\\"] == \\\"refused\\\"\\n    assert \\\"checks.sh\\\" in rec[\\\"refusal\\\"]\\n\\n\\ndef test_spec_gate_refuses_wrong_headings(tmp_path: Path) -> None:\\n    root = make_tenant(tmp_path, \\\"wrong_headings\\\")\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 1\\n    assert \\\"Design\\\" in run.stdout\\n    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n    assert rec[\\\"status\\\"] == \\\"refused\\\"\\n    assert \\\"Design\\\" in rec[\\\"refusal\\\"]\\n\\n\\ndef test_spec_gate_passes_and_writes_record(tmp_path: Path) -> None:\\n    root = make_tenant(tmp_path, \\\"valid\\\")\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 0\\n\\n    first = root / \\\"records\\\" / \\\"1\\\" / \\\"spec-01.json\\\"\\n    assert first.is_file()\\n    rec = json.loads(first.read_text())\\n    assert rec[\\\"status\\\"] == \\\"pass\\\"\\n    assert rec[\\\"spec_sha\\\"]\\n    assert rec[\\\"criteria\\\"] == [{\\\"name\\\": \\\"checks_marker.sh\\\", \\\"kind\\\": \\\"structural\\\", \\\"on_tree\\\": 1, \\\"on_stub\\\": 0}]\\n    assert rec[\\\"refusal\\\"] is None\\n\\n    run2 = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run2.returncode == 0\\n    assert (root / \\\"records\\\" / \\\"1\\\" / \\\"spec-02.json\\\").is_file()\\n\\n\\ndef amend_problem(root: Path) -> None:\\n    spec_md = root / \\\"specs\\\" / \\\"1\\\" / \\\"spec.md\\\"\\n    spec_md.write_text(spec_md.read_text().replace(\\n        \\\"does not emit\\\", \\\"used to not emit\\\"))\\n    commit_all(root, \\\"amend problem prose\\\")\\n\\n\\ndef approve_valid(root: Path) -> None:\\n    assert run_attavo(root, \\\"spec-gate\\\", \\\"1\\\").returncode == 0\\n    assert run_attavo(root, \\\"approve\\\", \\\"1\\\", \\\"--by\\\", \\\"alice\\\").returncode == 0\\n\\n\\ndef complete_the_build(root: Path) -> None:\\n    \\\"\\\"\\\"The marker.txt the criterion checks for, committed with no touch to\\n    spec.md: the same commit shape a real `attavo build` leaves behind --\\n    spec_sha, and so the approval, is unchanged.\\\"\\\"\\\"\\n    (root / \\\"src\\\").mkdir(parents=True, exist_ok=True)\\n    (root / \\\"src\\\" / \\\"marker.txt\\\").write_text(\\\"built\\\\n\\\")\\n    commit_all(root, \\\"build completed\\\")\\n\\n\\ndef test_spec_gate_reports_approved_when_approval_is_valid(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Issue #21, acceptance 1. Once a build has made the criterion pass on\\n    the tree, the gate must not re-run it and refuse the very success\\n    approval exists to bind: it reports the approval instead. Red today:\\n    the unmodified gate refuses this by name (\\\"criterion passes against\\n    the tree: checks_marker.sh\\\").\\n    \\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"valid\\\")\\n    approve_valid(root)\\n    complete_the_build(root)\\n\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 0\\n\\n    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n    assert rec[\\\"status\\\"] == \\\"approved\\\"\\n    assert rec[\\\"criteria\\\"] == []\\n    assert rec[\\\"refusal\\\"] is None\\n    assert rec[\\\"spec_sha\\\"]\\n    approval = json.loads(sorted((root / \\\"records\\\" / \\\"1\\\").glob(\\\"approval-*.json\\\"))[-1].read_text())\\n    assert rec[\\\"approval_sha\\\"] == approval[\\\"sha\\\"]\\n\\n\\ndef test_spec_gate_runs_when_approval_expired(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Issue #21, acceptance 2. The same fixture, after an edit above the\\n    line expires the approval: the gate must fall through to running the\\n    criteria for real, not keep reporting approved past the approval it\\n    no longer holds.\\n    \\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"valid\\\")\\n    approve_valid(root)\\n    complete_the_build(root)\\n    assert run_attavo(root, \\\"spec-gate\\\", \\\"1\\\").returncode == 0  # approved, short-circuited\\n\\n    amend_problem(root)\\n\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 1\\n    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n    assert rec[\\\"status\\\"] == \\\"refused\\\"\\n    assert \\\"checks_marker.sh\\\" in rec[\\\"refusal\\\"]\\n\\n\\ndef run_real_build(root: Path) -> subprocess.CompletedProcess[str]:\\n    \\\"\\\"\\\"A real `attavo build`, the fixture adapter writing the marker.txt\\n    the criterion checks for -- inside src/**, the claim -- unlike\\n    complete_the_build above, which only fakes the commit shape.\\\"\\\"\\\"\\n    return run_attavo(root, \\\"build\\\", \\\"1\\\", env={\\\"ATTAVO_FIXTURE_WRITE\\\": \\\"src/marker.txt\\\"})\\n\\n\\ndef test_spec_gate_built_after_build(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Issue #28, acceptance 1. Approve, build for real, then an\\n    amendment above the line expires the approval: the gate reports\\n    status built, not a refusal. Red today: refused for passing on the\\n    tree, PR #600's specimen.\\n\\n    Issue #36 changed built to judge each criterion (both on_tree and\\n    on_stub, as a pass record already does) rather than the tree alone;\\n    this fixture's stub also satisfies checks_marker.sh, so on_stub is\\n    0 here, not null -- the null-on_stub shape was retired with the\\n    \\\"criterion fails against the tree\\\" refusal it belonged to.\\n    \\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"valid\\\")\\n    approve_valid(root)\\n    assert run_real_build(root).returncode == 0\\n\\n    amend_problem(root)\\n\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 0\\n\\n    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n    assert rec[\\\"status\\\"] == \\\"built\\\"\\n    assert rec[\\\"criteria\\\"] == [{\\\"name\\\": \\\"checks_marker.sh\\\", \\\"kind\\\": \\\"structural\\\", \\\"on_tree\\\": 0, \\\"on_stub\\\": 0}]\\n    assert rec[\\\"refusal\\\"] is None\\n\\n\\ndef test_spec_gate_built_refuses_a_failing_criterion(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Issue #28, acceptance 2. Same shape, but a criterion no longer\\n    satisfiable at all -- gone from the tree and from the stub overlay\\n    both -- is refused by name, not rubber-stamped built just because a\\n    build record exists.\\n\\n    Issue #36 made built judge tree-fail-stub-pass as an accepted new\\n    obligation, not a refusal, so this specimen must fail on the stub\\n    too (removed from specs/1/stub/, not just the real tree) to still\\n    exercise a refusal at all.\\n    \\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"valid\\\")\\n    approve_valid(root)\\n    assert run_real_build(root).returncode == 0\\n\\n    (root / \\\"src\\\" / \\\"marker.txt\\\").unlink()\\n    (root / \\\"specs\\\" / \\\"1\\\" / \\\"stub\\\" / \\\"src\\\" / \\\"marker.txt\\\").unlink()\\n    commit_all(root, \\\"regression: the marker is gone from the tree and the stub\\\")\\n    amend_problem(root)\\n\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 1\\n\\n    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n    assert rec[\\\"status\\\"] == \\\"refused\\\"\\n    assert rec[\\\"refusal\\\"] == \\\"criterion fails against the tree plus stub: checks_marker.sh\\\"\\n    assert rec[\\\"criteria\\\"] == [{\\\"name\\\": \\\"checks_marker.sh\\\", \\\"kind\\\": \\\"structural\\\", \\\"on_tree\\\": 1, \\\"on_stub\\\": 1}]\\n\\n\\ndef test_spec_gate_removed_deletes_the_path_from_the_stub(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Issue #132, acceptance 1. stub/.removed names a path the change\\n    deletes; the gate must drop it from the stubbed copy before running\\n    the criteria, so a criterion asserting its absence passes on the\\n    stub and fails on the tree, where the path is still there. Red\\n    today: the overlay is add-only, so the path survives into the\\n    stubbed tree and the criterion fails on both.\\n    \\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"removed_present\\\")\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 0\\n\\n    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n    assert rec[\\\"status\\\"] == \\\"pass\\\"\\n    assert rec[\\\"criteria\\\"] == [{\\\"name\\\": \\\"absent.sh\\\", \\\"kind\\\": \\\"structural\\\", \\\"on_tree\\\": 1, \\\"on_stub\\\": 0}]\\n    assert rec[\\\"refusal\\\"] is None\\n\\n\\ndef test_spec_gate_removed_refuses_a_path_absent_from_the_tree(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Issue #132, acceptance 2. A .removed entry naming a path that\\n    isn't in the tree at all removes nothing, so it is refused by name\\n    before any criterion runs -- no criteria entries in the record.\\n    \\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"removed_absent\\\")\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 1\\n    assert \\\"nope.txt\\\" in run.stdout\\n\\n    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n    assert rec[\\\"status\\\"] == \\\"refused\\\"\\n    assert \\\"nope.txt\\\" in rec[\\\"refusal\\\"]\\n    assert rec[\\\"criteria\\\"] == []\\n\\n\\ndef test_spec_gate_removed_refuses_a_path_the_stub_also_supplies(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Issue #132, acceptance 3. A path named in .removed that the stub\\n    also supplies is a contradiction -- add and remove the same path --\\n    and is refused by name before any criterion runs.\\n    \\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"removed_contradicts_stub\\\")\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 1\\n    assert \\\"src/marker.txt\\\" in run.stdout\\n\\n    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n    assert rec[\\\"status\\\"] == \\\"refused\\\"\\n    assert \\\"src/marker.txt\\\" in rec[\\\"refusal\\\"]\\n    assert rec[\\\"criteria\\\"] == []\\n\\n\\ndef test_spec_gate_removed_refuses_a_path_outside_the_tree(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Issue #132, acceptance 4. A .removed entry that escapes the tree\\n    is refused by name before any criterion runs -- the stubbed copy is\\n    the only thing the gate may delete from.\\n    \\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"removed_outside_tree\\\")\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 1\\n    assert \\\"../escape.txt\\\" in run.stdout\\n\\n    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n    assert rec[\\\"status\\\"] == \\\"refused\\\"\\n    assert \\\"../escape.txt\\\" in rec[\\\"refusal\\\"]\\n    assert rec[\\\"criteria\\\"] == []\\n\\n\\ndef test_spec_gate_phase1_rule_unchanged_without_build(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Issue #28, acceptance 3. No build record at all: the third verdict\\n    does not apply, and Phase 1's original rule holds unchanged.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"valid\\\")\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 0\\n    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n    assert rec[\\\"status\\\"] == \\\"pass\\\"\\n    assert rec[\\\"criteria\\\"] == [{\\\"name\\\": \\\"checks_marker.sh\\\", \\\"kind\\\": \\\"structural\\\", \\\"on_tree\\\": 1, \\\"on_stub\\\": 0}]\\n\\n\\ndef add_scripted_criterion(root: Path, satisfies_stub: bool) -> None:\\n    \\\"\\\"\\\"The move an operator makes when an executor skipped a ruling\\n    nothing enforced: script it, after the build. Adds one criterion,\\n    extra.sh, testing for extra.txt -- present in the stub overlay only\\n    when satisfies_stub, so the new criterion fails on the tree (the\\n    build never created it) and either passes or fails on the stub.\\n    \\\"\\\"\\\"\\n    spec_md = root / \\\"specs\\\" / \\\"1\\\" / \\\"spec.md\\\"\\n    spec_md.write_text(\\n        spec_md.read_text() + \\\"- extra.sh: a ruling scripted after the build\\\\n\\\")\\n    script = root / \\\"specs\\\" / \\\"1\\\" / \\\"criteria\\\" / \\\"extra.sh\\\"\\n    script.write_text(\\\"#!/bin/sh\\\\ntest -f extra.txt\\\\n\\\")\\n    script.chmod(0o755)\\n    if satisfies_stub:\\n        stub_marker = root / \\\"specs\\\" / \\\"1\\\" / \\\"stub\\\" / \\\"extra.txt\\\"\\n        stub_marker.write_text(\\\"stub\\\\n\\\")\\n    commit_all(root, \\\"amend: script a ruling the executor skipped\\\")\\n\\n\\ndef test_built_accepts_a_criterion_added_after_the_build(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Issue #36, acceptance 1. A criterion added after a build, failing\\n    on the tree (the build never satisfied it) but passing on the stub\\n    (a new obligation the next build must meet), does not refuse built\\n    -- it is exactly the move an operator makes when an executor skipped\\n    a ruling nothing enforced: script it. Red today: built refuses any\\n    tree failure regardless of the stub; specimen attavo/code-factory\\n    spec-22.json, a correct amendment refused by name.\\n    \\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"valid\\\")\\n    approve_valid(root)\\n    assert run_real_build(root).returncode == 0\\n\\n    add_scripted_criterion(root, satisfies_stub=True)\\n\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 0\\n\\n    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n    assert rec[\\\"status\\\"] == \\\"built\\\"\\n    assert rec[\\\"refusal\\\"] is None\\n    by_name = {c[\\\"name\\\"]: c for c in rec[\\\"criteria\\\"]}\\n    assert by_name[\\\"checks_marker.sh\\\"] == {\\\"name\\\": \\\"checks_marker.sh\\\", \\\"kind\\\": \\\"structural\\\", \\\"on_tree\\\": 0, \\\"on_stub\\\": 0}\\n    assert by_name[\\\"extra.sh\\\"] == {\\\"name\\\": \\\"extra.sh\\\", \\\"kind\\\": \\\"structural\\\", \\\"on_tree\\\": 1, \\\"on_stub\\\": 0}\\n\\n\\ndef test_built_refuses_a_criterion_failing_on_both(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Issue #36, acceptance 2. Same shape, but the new criterion is not\\n    satisfiable at all -- fails on the tree and on the stub both:\\n    refused by name, not accepted as a scriptable new obligation.\\n    \\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"valid\\\")\\n    approve_valid(root)\\n    assert run_real_build(root).returncode == 0\\n\\n    add_scripted_criterion(root, satisfies_stub=False)\\n\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 1\\n\\n    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n    assert rec[\\\"status\\\"] == \\\"refused\\\"\\n    assert rec[\\\"refusal\\\"] == \\\"criterion fails against the tree plus stub: extra.sh\\\"\\n    by_name = {c[\\\"name\\\"]: c for c in rec[\\\"criteria\\\"]}\\n    assert by_name[\\\"extra.sh\\\"] == {\\\"name\\\": \\\"extra.sh\\\", \\\"kind\\\": \\\"structural\\\", \\\"on_tree\\\": 1, \\\"on_stub\\\": 1}\\n\\n\\ndef write_build_record(root: Path, item: str, *, sha: str, status: str) -> None:\\n    \\\"\\\"\\\"A minimal build-01.json, faked directly rather than run through the\\n    fixture adapter: the adapter has no way to both commit and halt with a\\n    question in one invocation (adapters/fixture/run answers a question\\n    before it ever reaches the write-and-commit step), and cmd_spec_gate\\n    reads nothing off a build record but sha and status.\\n    \\\"\\\"\\\"\\n    records_dir = root / \\\"records\\\" / item\\n    records_dir.mkdir(parents=True, exist_ok=True)\\n    (records_dir / \\\"build-01.json\\\").write_text(json.dumps({\\\"sha\\\": sha, \\\"status\\\": status}) + \\\"\\\\n\\\")\\n\\n\\ndef test_spec_gate_built_after_halted_build_that_committed(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Issue #98, acceptance 1. The executor commits its work, then halts\\n    with a question -- the common shape, since it commits before it asks.\\n    An amendment above the line must still be judged against the tree the\\n    halted build produced, not refused for the success that tree already\\n    holds. Red today: refused, \\\"criterion passes against the tree:\\n    checks_marker.sh\\\" -- the status != \\\"halted\\\" clause excluded the one\\n    build that had done the work; tenant zero's #663 build-01/spec-02 is\\n    the specimen.\\n    \\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"valid\\\")\\n    approve_valid(root)\\n    complete_the_build(root)\\n    build_sha = git(root, \\\"rev-parse\\\", \\\"HEAD\\\").strip()\\n    write_build_record(root, \\\"1\\\", sha=build_sha, status=\\\"halted\\\")\\n\\n    amend_problem(root)\\n\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 0\\n\\n    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n    assert rec[\\\"status\\\"] == \\\"built\\\"\\n    assert rec[\\\"criteria\\\"] == [{\\\"name\\\": \\\"checks_marker.sh\\\", \\\"kind\\\": \\\"structural\\\", \\\"on_tree\\\": 0, \\\"on_stub\\\": 0}]\\n    assert rec[\\\"refusal\\\"] is None\\n\\n\\ndef test_spec_gate_stub_verdict_after_halted_build_that_committed_nothing(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Issue #98, acceptance 2. A halted build whose sha equals its\\n    start_sha did no work -- commit_postdates already treats that as\\n    postdating nothing -- so the gate must keep judging it against the\\n    stub, exactly as before the fix: Phase 1's rule, not built. The\\n    criterion still fails on the real tree (no build ever touched it) and\\n    passes on the stub, so the verdict is pass, not built and not refused.\\n    \\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"valid\\\")\\n    approve_valid(root)\\n    approval_sha = git(root, \\\"rev-parse\\\", \\\"HEAD\\\").strip()\\n    write_build_record(root, \\\"1\\\", sha=approval_sha, status=\\\"halted\\\")\\n\\n    amend_problem(root)\\n\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 0\\n\\n    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n    assert rec[\\\"status\\\"] == \\\"pass\\\"\\n    assert rec[\\\"criteria\\\"] == [{\\\"name\\\": \\\"checks_marker.sh\\\", \\\"kind\\\": \\\"structural\\\", \\\"on_tree\\\": 1, \\\"on_stub\\\": 0}]\\n    assert rec[\\\"refusal\\\"] is None\\n\\n\\ndef add_root_cause_line(root: Path, root_cause: str) -> None:\\n    spec_md = root / \\\"specs\\\" / \\\"1\\\" / \\\"spec.md\\\"\\n    # a root-cause item is core (ruled 2026-09-27); the fixture declares fix\\n    text = spec_md.read_text().replace(\\\"Class: fix\\\\n\\\", \\\"Class: core\\\\n\\\", 1)\\n    text = text.replace(\\\"## Problem\\\\n\\\", f\\\"## Problem\\\\n\\\\nRoot-cause: {root_cause}\\\\n\\\", 1)\\n    spec_md.write_text(text)\\n    commit_all(root, f\\\"name root cause {root_cause}\\\")\\n\\n\\ndef test_spec_gate_refuses_a_root_cause_the_tenant_does_not_list_and_passes_a_listed_one(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Root causes (#229 build-04 and the convergence ruling of\\n    2026-09-27): a fix item names the root cause its change closes as one\\n    'Root-cause: <slug>' line in its problem, and the gate refuses a slug\\n    the tenant's root-causes.md (beside the specs directory) does not\\n    list, or a line with no such file. Written red first: on v0.30.0 the\\n    line is prose and the gate passes it.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"valid\\\")\\n    add_root_cause_line(root, \\\"shared-working-copy\\\")\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 1, run.stdout + run.stderr\\n    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n    assert rec[\\\"status\\\"] == \\\"refused\\\"\\n    assert rec[\\\"refusal\\\"] == \\\"root cause: shared-working-copy named but root-causes.md does not exist\\\", rec[\\\"refusal\\\"]\\n    assert rec[\\\"criteria\\\"] == [], \\\"refused before any criterion ran\\\"\\n\\n    (root / \\\"root-causes.md\\\").write_text(\\n        \\\"# root causes\\\\n\\\\n- liveness-by-proxy: a pid stood in for the holder\\\\n\\\")\\n    commit_all(root, \\\"list one root cause\\\")\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 1\\n    assert latest_record(root, \\\"1\\\", \\\"spec\\\")[\\\"refusal\\\"] == \\\"root cause: shared-working-copy is not listed in root-causes.md\\\"\\n\\n    (root / \\\"root-causes.md\\\").write_text(\\n        \\\"# root causes\\\\n\\\\n- liveness-by-proxy: a pid stood in for the holder\\\\n\\\"\\n        \\\"- shared-working-copy: one checkout, many writers\\\\n\\\")\\n    commit_all(root, \\\"list the root cause\\\")\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n    assert rec[\\\"status\\\"] == \\\"pass\\\" and rec[\\\"refusal\\\"] is None\\n\\n\\ndef test_spec_gate_leaves_a_spec_with_no_root_cause_line_alone(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"A capability item has no root cause; the check is on the line, not\\n    on every spec, and a tenant with no root-causes.md is not asked for\\n    one.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"valid\\\")\\n    assert not (root / \\\"root-causes.md\\\").exists()\\n    assert run_attavo(root, \\\"spec-gate\\\", \\\"1\\\").returncode == 0\\n\\n\\n# --- the item's class and the research policy (ruled 2026-09-25, 2026-09-27) ---\\n\\ndef set_class_line(root: Path, line: str | None) -> None:\\n    spec_md = root / \\\"specs\\\" / \\\"1\\\" / \\\"spec.md\\\"\\n    text = spec_md.read_text().replace(\\\"Class: fix\\\\n\\\", \\\"\\\" if line is None else line + \\\"\\\\n\\\", 1)\\n    spec_md.write_text(text)\\n    commit_all(root, f\\\"class line: {line}\\\")\\n\\n\\ndef test_spec_gate_refuses_a_spec_that_declares_no_class_before_any_criterion_runs(tmp_path: Path) -> None:\\n    root = make_tenant(tmp_path, \\\"valid\\\")\\n    set_class_line(root, None)\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 1, run.stdout + run.stderr\\n    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n    assert rec[\\\"status\\\"] == \\\"refused\\\" and rec[\\\"criteria\\\"] == [], rec\\n    assert rec[\\\"refusal\\\"] == \\\"class: none declared; add a line 'Class: core' or 'Class: fix' to the problem\\\", rec[\\\"refusal\\\"]\\n    assert rec[\\\"class\\\"] is None and rec[\\\"research\\\"] == \\\"not required by policy\\\", rec\\n\\n\\ndef test_spec_gate_refuses_a_class_other_than_core_or_fix(tmp_path: Path) -> None:\\n    root = make_tenant(tmp_path, \\\"valid\\\")\\n    set_class_line(root, \\\"Class: feature\\\")\\n    assert run_attavo(root, \\\"spec-gate\\\", \\\"1\\\").returncode == 1\\n    assert latest_record(root, \\\"1\\\", \\\"spec\\\")[\\\"refusal\\\"] == \\\"class: feature is not core or fix\\\"\\n\\n\\ndef test_spec_gate_refuses_a_root_cause_item_declared_fix(tmp_path: Path) -> None:\\n    root = make_tenant(tmp_path, \\\"valid\\\")\\n    (root / \\\"root-causes.md\\\").write_text(\\\"# root causes\\\\n\\\\n- shared-working-copy: one checkout, many writers\\\\n\\\")\\n    spec_md = root / \\\"specs\\\" / \\\"1\\\" / \\\"spec.md\\\"\\n    spec_md.write_text(spec_md.read_text().replace(\\\"## Problem\\\\n\\\", \\\"## Problem\\\\n\\\\nRoot-cause: shared-working-copy\\\\n\\\", 1))\\n    commit_all(root, \\\"a root cause named on a fix\\\")\\n    assert run_attavo(root, \\\"spec-gate\\\", \\\"1\\\").returncode == 1\\n    assert latest_record(root, \\\"1\\\", \\\"spec\\\")[\\\"refusal\\\"] == \\\"class: fix with root cause shared-working-copy; a root-cause item is core\\\"\\n\\n\\ndef test_spec_gate_records_the_class_and_that_research_was_not_required(tmp_path: Path) -> None:\\n    root = make_tenant(tmp_path, \\\"valid\\\")\\n    set_class_line(root, \\\"Class: core\\\")\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n    assert rec[\\\"status\\\"] == \\\"pass\\\" and rec[\\\"class\\\"] == \\\"core\\\", rec\\n    assert rec[\\\"research\\\"] == \\\"not required by policy\\\", rec\\n\\n\\ndef test_with_research_required_a_core_spec_owes_a_research_record_and_a_fix_spec_does_not(tmp_path: Path) -> None:\\n    root = make_tenant(tmp_path, \\\"valid\\\")\\n    manifest = root / \\\"attavo.toml\\\"\\n    text = manifest.read_text()\\n    assert \\\"[spec]\\\\n\\\" in text, text\\n    manifest.write_text(text.replace(\\\"[spec]\\\\n\\\", '[spec]\\\\nresearch = \\\"required\\\"\\\\n', 1))\\n    commit_all(root, \\\"research required\\\")\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n    assert latest_record(root, \\\"1\\\", \\\"spec\\\")[\\\"research\\\"] == \\\"required\\\"\\n    set_class_line(root, \\\"Class: core\\\")\\n    assert run_attavo(root, \\\"spec-gate\\\", \\\"1\\\").returncode == 1\\n    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n    assert rec[\\\"refusal\\\"] == \\\"research: [spec].research is required and the item has no research record\\\", rec\\n    (root / \\\"records\\\" / \\\"1\\\" / \\\"research-01.json\\\").write_text(\\\"{}\\\\n\\\")\\n    commit_all(root, \\\"a research record\\\")\\n    assert run_attavo(root, \\\"spec-gate\\\", \\\"1\\\").returncode == 0\\n\\n\\ndef test_an_approved_and_built_item_whose_spec_declares_no_class_still_regates_built(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"No item in flight is stranded: class is required before approval,\\n    and an item approved and built before the gate read class re-gates\\n    after an amendment exactly as it did.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"valid\\\")\\n    approve_valid(root)\\n    assert run_real_build(root).returncode == 0\\n    set_class_line(root, None)\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n    assert rec[\\\"status\\\"] == \\\"built\\\" and rec[\\\"class\\\"] is None, rec\\n\\n\\ndef test_spec_gate_refuses_a_stub_that_touches_a_path_the_claims_do_not_name(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Item 229's third attempt: the change needed attavo/common.py, the\\n    Claims list did not name it, and the gate found out 2,754 s later. The\\n    stub is the change's floor, so a stub path outside the claims is a\\n    wrong Claims list before any build runs. Red first against v0.29.0.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"valid\\\")\\n    stub = root / \\\"specs\\\" / \\\"1\\\" / \\\"stub\\\"\\n    (stub / \\\"lib\\\").mkdir(parents=True)\\n    (stub / \\\"lib\\\" / \\\"helper.py\\\").write_text(\\\"x = 1\\\\n\\\")\\n    commit_all(root, \\\"a stub file the claims do not name\\\")\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 1, run.stdout + run.stderr\\n    assert \\\"stub touches a path the claims do not name: lib/helper.py\\\" in run.stdout, run.stdout\\n    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n    assert rec[\\\"status\\\"] == \\\"refused\\\" and \\\"lib/helper.py\\\" in rec[\\\"refusal\\\"], rec\\n    spec_md = root / \\\"specs\\\" / \\\"1\\\" / \\\"spec.md\\\"\\n    spec_md.write_text(spec_md.read_text().replace(\\\"- src/**\\\\n\\\", \\\"- src/**\\\\n- lib/\\\\n\\\"))\\n    commit_all(root, \\\"claim the directory\\\")\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n    assert latest_record(root, \\\"1\\\", \\\"spec\\\")[\\\"status\\\"] == \\\"pass\\\"\\n\\n\\n# Issue #340 (rulings 1 and 2 on #299): criterion kinds, so a stub can be thin.\\n\\ndef set_criteria(root: Path, lines: list[str], scripts: dict[str, str],\\n                 stub: dict[str, str] | None = None) -> None:\\n    \\\"\\\"\\\"Replace the valid fixture's Criteria with `lines` (spec.md bullets),\\n    write each script executable, and set the stub overlay to `stub`\\n    (path -> content) in place of the fixture's marker.txt.\\\"\\\"\\\"\\n    spec_dir = root / \\\"specs\\\" / \\\"1\\\"\\n    spec_md = spec_dir / \\\"spec.md\\\"\\n    head = spec_md.read_text().split(\\\"## Criteria\\\")[0]\\n    spec_md.write_text(head + \\\"## Criteria\\\\n\\\\n\\\" + \\\"\\\\n\\\".join(lines) + \\\"\\\\n\\\")\\n    criteria = spec_dir / \\\"criteria\\\"\\n    for old in criteria.iterdir():\\n        old.unlink()\\n    for name, body in scripts.items():\\n        (criteria / name).write_text(\\\"#!/bin/sh\\\\n\\\" + body + \\\"\\\\n\\\")\\n        (criteria / name).chmod(0o755)\\n    shutil.rmtree(spec_dir / \\\"stub\\\")\\n    for rel, content in (stub or {}).items():\\n        (spec_dir / \\\"stub\\\" / rel).parent.mkdir(parents=True, exist_ok=True)\\n        (spec_dir / \\\"stub\\\" / rel).write_text(content)\\n    commit_all(root, \\\"criteria with kinds\\\")\\n\\n\\nSTRUCT = \\\"- [structural] checks_marker.sh: the marker file exists\\\"\\nBEHAV = \\\"- [behavioural] logic.sh: the logic reports done\\\"\\nTHIN_SCRIPTS = {\\\"checks_marker.sh\\\": \\\"test -f src/marker.txt\\\",\\n                \\\"logic.sh\\\": \\\"test \\\\\\\"$(cat src/logic.txt 2>/dev/null)\\\\\\\" = done\\\"}\\nTHIN_STUB = {\\\"src/marker.txt\\\": \\\"ok\\\\n\\\", \\\"src/logic.txt\\\": \\\"todo\\\\n\\\"}\\n\\n\\ndef test_a_thin_stub_passes_and_the_record_carries_each_criterions_kind(tmp_path: Path) -> None:\\n    root = make_tenant(tmp_path, \\\"valid\\\")\\n    set_criteria(root, [STRUCT, BEHAV], THIN_SCRIPTS, THIN_STUB)\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n    assert rec[\\\"status\\\"] == \\\"pass\\\"\\n    assert rec[\\\"criteria\\\"] == [\\n        {\\\"name\\\": \\\"checks_marker.sh\\\", \\\"kind\\\": \\\"structural\\\", \\\"on_tree\\\": 1, \\\"on_stub\\\": 0},\\n        {\\\"name\\\": \\\"logic.sh\\\", \\\"kind\\\": \\\"behavioural\\\", \\\"on_tree\\\": 1, \\\"on_stub\\\": 1}]\\n\\n\\ndef test_a_behavioural_criterion_that_passes_on_the_stub_is_refused_by_name(tmp_path: Path) -> None:\\n    root = make_tenant(tmp_path, \\\"valid\\\")\\n    set_criteria(root, [STRUCT, BEHAV], THIN_SCRIPTS,\\n                 {\\\"src/marker.txt\\\": \\\"ok\\\\n\\\", \\\"src/logic.txt\\\": \\\"done\\\\n\\\"})\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 1\\n    want = \\\"criterion labelled behavioural passes on the tree plus stub: logic.sh\\\"\\n    assert want in run.stdout, run.stdout\\n    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n    assert rec[\\\"status\\\"] == \\\"refused\\\" and rec[\\\"refusal\\\"] == want\\n\\n\\ndef test_a_structural_criterion_that_fails_on_the_stub_is_refused_by_name(tmp_path: Path) -> None:\\n    root = make_tenant(tmp_path, \\\"valid\\\")\\n    set_criteria(root, [STRUCT, BEHAV], THIN_SCRIPTS, {\\\"src/logic.txt\\\": \\\"todo\\\\n\\\"})\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 1\\n    want = \\\"criterion labelled structural fails on the tree plus stub: checks_marker.sh\\\"\\n    assert want in run.stdout, run.stdout\\n    assert latest_record(root, \\\"1\\\", \\\"spec\\\")[\\\"refusal\\\"] == want\\n\\n\\ndef test_an_unknown_kind_label_is_refused_by_name(tmp_path: Path) -> None:\\n    root = make_tenant(tmp_path, \\\"valid\\\")\\n    set_criteria(root, [\\\"- [cosmetic] checks_marker.sh: the marker file exists\\\"],\\n                 {\\\"checks_marker.sh\\\": \\\"test -f src/marker.txt\\\"}, {\\\"src/marker.txt\\\": \\\"ok\\\\n\\\"})\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 1\\n    want = \\\"criterion has an unknown kind [cosmetic]: checks_marker.sh\\\"\\n    assert want in run.stdout, run.stdout\\n    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n    assert rec[\\\"status\\\"] == \\\"refused\\\" and rec[\\\"refusal\\\"] == want\\n\\n\\ndef test_an_unlabelled_criterion_is_structural(tmp_path: Path) -> None:\\n    root = make_tenant(tmp_path, \\\"valid\\\")\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n    assert latest_record(root, \\\"1\\\", \\\"spec\\\")[\\\"criteria\\\"] == [\\n        {\\\"name\\\": \\\"checks_marker.sh\\\", \\\"kind\\\": \\\"structural\\\", \\\"on_tree\\\": 1, \\\"on_stub\\\": 0}]\\n    # An unlabelled criterion failing on the stub is refused as structural.\\n    set_criteria(root, [\\\"- checks_marker.sh: the marker file exists\\\"],\\n                 {\\\"checks_marker.sh\\\": \\\"test -f src/marker.txt\\\"}, {})\\n    assert run_attavo(root, \\\"spec-gate\\\", \\\"1\\\").returncode == 1\\n\\n\\n@pytest.mark.own_records\\ndef test_every_merged_spec_parses_with_unlabelled_criteria_structural() -> None:\\n    \\\"\\\"\\\"Regression: every spec under attest/specs/ parses with no refusal and\\n    no label leaking into a name, and each criterion's kind is the one its\\n    line declares: unlabelled is structural. Specs written before labels\\n    are all unlabelled; #344's was the first labelled one, and an earlier\\n    form of this test asserted that no spec would ever carry a label.\\\"\\\"\\\"\\n    from attavo.spec import KIND_LABEL, parse_spec\\n    specs = sorted((ROOT / \\\"attest\\\" / \\\"specs\\\").glob(\\\"*/spec.md\\\"))\\n    assert specs\\n    for spec_md in specs:\\n        parsed, refusal = parse_spec(spec_md)\\n        assert refusal is None and parsed is not None, spec_md\\n        assert all(not n.startswith(\\\"[\\\") for n in parsed[\\\"criteria\\\"]), spec_md\\n        assert list(parsed[\\\"kinds\\\"]) == parsed[\\\"criteria\\\"], spec_md\\n        for line in spec_md.read_text().split(\\\"## Criteria\\\", 1)[1].splitlines():\\n            s = line.strip()\\n            if not s.startswith(\\\"- \\\") or \\\":\\\" not in s:\\n                continue\\n            label = KIND_LABEL.match(s[2:])\\n            name = (s[2:][label.end():] if label else s[2:]).split(\\\":\\\", 1)[0].strip()\\n            declared = label.group(1).strip() if label else \\\"structural\\\"\\n            assert parsed[\\\"kinds\\\"][name] == declared, (spec_md, name)\\n\\n\\ndef test_built_refuses_a_behavioural_criterion_that_fails_on_the_tree(tmp_path: Path) -> None:\\n    root = make_tenant(tmp_path, \\\"valid\\\")\\n    approve_valid(root)\\n    assert run_real_build(root).returncode == 0\\n    spec_md = root / \\\"specs\\\" / \\\"1\\\" / \\\"spec.md\\\"\\n    spec_md.write_text(spec_md.read_text() + BEHAV + \\\"\\\\n\\\")\\n    script = root / \\\"specs\\\" / \\\"1\\\" / \\\"criteria\\\" / \\\"logic.sh\\\"\\n    script.write_text(\\\"#!/bin/sh\\\\n\\\" + THIN_SCRIPTS[\\\"logic.sh\\\"] + \\\"\\\\n\\\")\\n    script.chmod(0o755)\\n    (root / \\\"specs\\\" / \\\"1\\\" / \\\"stub\\\" / \\\"src\\\" / \\\"logic.txt\\\").write_text(\\\"todo\\\\n\\\")\\n    commit_all(root, \\\"amend: a behavioural criterion the build never met\\\")\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 1\\n    want = \\\"criterion labelled behavioural fails on the tree: logic.sh\\\"\\n    assert want in run.stdout, run.stdout\\n    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n    assert rec[\\\"status\\\"] == \\\"refused\\\" and rec[\\\"refusal\\\"] == want\\n\\n\\ndef test_built_accepts_a_behavioural_criterion_that_passes_on_the_tree(tmp_path: Path) -> None:\\n    root = make_tenant(tmp_path, \\\"valid\\\")\\n    approve_valid(root)\\n    assert run_real_build(root).returncode == 0\\n    spec_md = root / \\\"specs\\\" / \\\"1\\\" / \\\"spec.md\\\"\\n    spec_md.write_text(spec_md.read_text() + BEHAV + \\\"\\\\n\\\")\\n    script = root / \\\"specs\\\" / \\\"1\\\" / \\\"criteria\\\" / \\\"logic.sh\\\"\\n    script.write_text(\\\"#!/bin/sh\\\\n\\\" + THIN_SCRIPTS[\\\"logic.sh\\\"] + \\\"\\\\n\\\")\\n    script.chmod(0o755)\\n    (root / \\\"specs\\\" / \\\"1\\\" / \\\"stub\\\" / \\\"src\\\" / \\\"logic.txt\\\").write_text(\\\"todo\\\\n\\\")\\n    (root / \\\"src\\\" / \\\"logic.txt\\\").write_text(\\\"done\\\\n\\\")\\n    commit_all(root, \\\"amend: a behavioural criterion the build met\\\")\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n    assert rec[\\\"status\\\"] == \\\"built\\\"\\n    by_name = {c[\\\"name\\\"]: c for c in rec[\\\"criteria\\\"]}\\n    assert by_name[\\\"logic.sh\\\"] == {\\\"name\\\": \\\"logic.sh\\\", \\\"kind\\\": \\\"behavioural\\\", \\\"on_tree\\\": 0, \\\"on_stub\\\": 1}\\n\\n\\nNO_STRUCTURAL = (\\\"no structural criterion: nothing shows the stub reaches \\\"\\n                 \\\"what the behavioural criteria test\\\")\\n\\n\\ndef test_a_spec_of_only_behavioural_criteria_is_refused(tmp_path: Path) -> None:\\n    root = make_tenant(tmp_path, \\\"valid\\\")\\n    set_criteria(root, [BEHAV], {\\\"logic.sh\\\": THIN_SCRIPTS[\\\"logic.sh\\\"]},\\n                 {\\\"src/logic.txt\\\": \\\"todo\\\\n\\\"})\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 1\\n    assert NO_STRUCTURAL in run.stdout, run.stdout\\n    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n    assert rec[\\\"status\\\"] == \\\"refused\\\" and rec[\\\"refusal\\\"] == NO_STRUCTURAL\\n\\n\\ndef test_the_no_structural_refusal_comes_before_any_criterion_refusal(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"The one behavioural criterion here also passes on the stub, which\\n    alone would be refused by name; the spec-level refusal is reported.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"valid\\\")\\n    set_criteria(root, [BEHAV], {\\\"logic.sh\\\": THIN_SCRIPTS[\\\"logic.sh\\\"]},\\n                 {\\\"src/logic.txt\\\": \\\"done\\\\n\\\"})\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 1\\n    assert latest_record(root, \\\"1\\\", \\\"spec\\\")[\\\"refusal\\\"] == NO_STRUCTURAL\\n\\n\\nNO_CRITERIA = \\\"criteria: empty; the spec asserts nothing\\\"\\n\\n\\ndef test_a_spec_with_no_criteria_is_refused_before_any_criterion_runs(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"An empty Criteria section and no criteria/ directory asserts nothing.\\n    Zero criteria match zero files, so before this rule the gate passed it\\n    and an approval bound to no executable claim could follow.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"build_valid\\\")\\n    spec_dir = root / \\\"specs\\\" / \\\"1\\\"\\n    spec_md = spec_dir / \\\"spec.md\\\"\\n    spec_md.write_text(spec_md.read_text().split(\\\"## Criteria\\\")[0] + \\\"## Criteria\\\\n\\\\n\\\")\\n    shutil.rmtree(spec_dir / \\\"criteria\\\")\\n    commit_all(root, \\\"criteria emptied\\\")\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 1\\n    assert NO_CRITERIA in run.stdout, run.stdout\\n    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n    assert rec[\\\"status\\\"] == \\\"refused\\\"\\n    assert rec[\\\"criteria\\\"] == []\\n    assert rec[\\\"refusal\\\"] == NO_CRITERIA\\n\\n\\n# Issue #351: a criterion that could not check is not a failing criterion.\\n\\nCOULD_NOT_CHECK = \\\"criterion could not check (exit 2): \\\"\\n\\n\\ndef test_a_behavioural_criterion_that_exits_other_than_1_on_both_is_refused_by_name(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"Specimen: #349's behavioural criterion exited 2 (its own code for\\n    \\\"the scenario could not be set up\\\") on the tree and on the stub in the\\n    CI gate, and v0.34.0 accepted 2/2 as \\\"fails on both\\\".\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"valid\\\")\\n    set_criteria(root, [STRUCT, \\\"- [behavioural] broken.sh: a scenario that cannot be set up\\\"],\\n                 {\\\"checks_marker.sh\\\": \\\"test -f src/marker.txt || exit 1\\\",\\n                  \\\"broken.sh\\\": \\\"exit 2\\\"},\\n                 THIN_STUB)\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 1, run.stdout + run.stderr\\n    assert COULD_NOT_CHECK + \\\"broken.sh\\\" in run.stdout, run.stdout\\n    rec = latest_record(root, \\\"1\\\", \\\"spec\\\")\\n    assert rec[\\\"status\\\"] == \\\"refused\\\" and rec[\\\"refusal\\\"] == COULD_NOT_CHECK + \\\"broken.sh\\\"\\n\\n\\ndef test_a_structural_criterion_that_exits_other_than_1_on_the_tree_is_refused_by_name(tmp_path: Path) -> None:\\n    \\\"\\\"\\\"`grep -q` on a missing file exits 2; a structural criterion must say\\n    1 when the thing it checks is absent, so a crash is told from a no.\\\"\\\"\\\"\\n    root = make_tenant(tmp_path, \\\"valid\\\")\\n    set_criteria(root, [\\\"- [structural] crashes.sh: the marker file exists\\\"],\\n                 {\\\"crashes.sh\\\": \\\"test -f src/marker.txt || exit 3\\\"},\\n                 THIN_STUB)\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 1, run.stdout + run.stderr\\n    assert \\\"criterion could not check (exit 3): crashes.sh\\\" in run.stdout, run.stdout\\n    assert latest_record(root, \\\"1\\\", \\\"spec\\\")[\\\"refusal\\\"] == \\\"criterion could not check (exit 3): crashes.sh\\\"\\n\\n\\ndef test_a_thin_stub_whose_criteria_exit_exactly_1_still_passes(tmp_path: Path) -> None:\\n    root = make_tenant(tmp_path, \\\"valid\\\")\\n    set_criteria(root, [STRUCT, BEHAV],\\n                 {\\\"checks_marker.sh\\\": \\\"test -f src/marker.txt || exit 1\\\",\\n                  \\\"logic.sh\\\": \\\"test \\\\\\\"$(cat src/logic.txt 2>/dev/null)\\\\\\\" = done || exit 1\\\"},\\n                 THIN_STUB)\\n    run = run_attavo(root, \\\"spec-gate\\\", \\\"1\\\")\\n    assert run.returncode == 0, run.stdout + run.stderr\\n    assert latest_record(root, \\\"1\\\", \\\"spec\\\")[\\\"status\\\"] == \\\"pass\\\"\\n\",\"numLines\":831,\"startLine\":1,\"totalLines\":831}},\"tool_result_meta\":[{\"id\":\"toolu_0113LAeNsazrvgdmLmx5aX9E\",\"permission_decision\":{\"decision\":\"accept\",\"source\":\"config\",\"reason_type\":\"rule\"}}]}\n+{\"type\":\"system\",\"subtype\":\"thinking_tokens\",\"estimated_tokens\":50,\"estimated_tokens_delta\":50,\"session_id\":\"0fabd1e2-92b8-4212-a6d0-e85fc14548ff\",\"uuid\":\"6adfcf68-6ae2-4087-8213-17e1ca1928fa\"}\n+{\"type\":\"system\",\"subtype\":\"thinking_tokens\",\"estimated_tokens\":200,\"estimated_tokens_delta\":150,\"session_id\":\"0fabd1e2-92b8-4212-a6d0-e85fc14548ff\",\"uuid\":\"53d5a472-b6c7-4a04-871d-c58acc67cb39\"}\n+{\"type\":\"system\",\"subtype\":\"thinking_tokens\",\"estimated_tokens\":350,\"estimated_tokens_de
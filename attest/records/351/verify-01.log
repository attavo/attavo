used_by_name(tmp_path: Path) -> None:\ntests/test_spec_gate.py:794:    \"\"\"Specimen: #349's behavioural criterion exited 2 (its own code for\ntests/test_spec_gate.py:798:    set_criteria(root, [STRUCT, \"- [behavioural] broken.sh: a scenario that cannot be set up\"],\ntests/test_spec_gate.py:799:                 {\"checks_marker.sh\": \"test -f src/marker.txt || exit 1\",\ntests/test_spec_gate.py:802:    run = run_attavo(root, \"spec-gate\", \"1\")\ntests/test_spec_gate.py:809:def test_a_structural_criterion_that_exits_other_than_1_on_the_tree_is_refused_by_name(tmp_path: Path) -> None:\ntests/test_spec_gate.py:810:    \"\"\"`grep -q` on a missing file exits 2; a structural criterion must say\ntests/test_spec_gate.py:813:    set_criteria(root, [\"- [structural] crashes.sh: the marker file exists\"],\ntests/test_spec_gate.py:816:    run = run_attavo(root, \"spec-gate\", \"1\")\ntests/test_spec_gate.py:818:    assert \"criterion could not check (exit 3): crashes.sh\" in run.stdout, run.stdout\ntests/test_spec_gate.py:819:    assert latest_record(root, \"1\", \"spec\")[\"refusal\"] == \"criterion could not check (exit 3): crashes.sh\"\ntests/test_spec_gate.py:822:def test_a_thin_stub_whose_criteria_exit_exactly_1_still_passes(tmp_path: Path) -> None:\ntests/test_spec_gate.py:825:                 {\"checks_marker.sh\": \"test -f src/marker.txt || exit 1\",\ntests/test_spec_gate.py:826:                  \"logic.sh\": \"test \\\"$(cat src/logic.txt 2>/dev/null)\\\" = done || exit 1\"},\ntests/test_spec_gate.py:828:    run = run_attavo(root, \"spec-gate\", \"1\")\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"sed -n '220,435p' attavo/spec.py; sed -n '600,850p' tests/test_spec_gate.py; git diff --stat 95cc223178c88362da6963f54007d2db14151d8d..199c50d4e8e5c471846eb33e058745ca1e31b82a; git diff --name-status 95cc223178c88362da6963f54007d2db14151d8d..199c50d4e8e5c471846eb33e058745ca1e31b82a; git show --stat --oneline e1c48978f279131dc5cbdc1ae74050c6d7d1632e; git status --short\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/zsh -lc \"sed -n '220,435p' attavo/spec.py; sed -n '600,850p' tests/test_spec_gate.py; git diff --stat 95cc223178c88362da6963f54007d2db14151d8d..199c50d4e8e5c471846eb33e058745ca1e31b82a; git diff --name-status 95cc223178c88362da6963f54007d2db14151d8d..199c50d4e8e5c471846eb33e058745ca1e31b82a; git show --stat --oneline e1c48978f279131dc5cbdc1ae74050c6d7d1632e; git status --short\"","aggregated_output":"def run_criteria(root: Path, spec_dir: Path, names: list[str],\n                 kinds: dict[str, str] | None = None) -> list[dict[str, Any]]:\n    criteria_dir = spec_dir / \"criteria\"\n    stub_dir = spec_dir / \"stub\"\n    with tempfile.TemporaryDirectory() as tmp:\n        tree = Path(tmp) / \"tree\"\n        stubbed = Path(tmp) / \"stubbed\"\n        shutil.copytree(root, tree, ignore=shutil.ignore_patterns(\".git\"))\n        shutil.copytree(root, stubbed, ignore=shutil.ignore_patterns(\".git\"))\n        if stub_dir.is_dir():\n            shutil.copytree(stub_dir, stubbed, dirs_exist_ok=True)\n            for rel in parse_removed(stub_dir):\n                target = stubbed / rel\n                if target.is_dir():\n                    shutil.rmtree(target)\n                elif target.exists():\n                    target.unlink()\n            removed_marker = stubbed / \".removed\"\n            if removed_marker.exists():\n                removed_marker.unlink()\n        results = []\n        for name in names:\n            exe = criteria_dir / name\n            results.append({\"name\": name,\n                            \"kind\": (kinds or {}).get(name, \"structural\"),\n                            \"on_tree\": run_criterion(exe, tree),\n                            \"on_stub\": run_criterion(exe, stubbed)})\n        return results\n\n\ndef could_not_check_refusal(results: list[dict[str, Any]]) -> str | None:\n    \"\"\"Exit codes are a contract: 0 when a criterion holds, 1 when its\n    assertion fails, and nothing else -- any other exit, on the tree or the\n    stub, means the criterion could not check at all (its own setup failed,\n    or it crashed) and is refused by name before its kind is judged.\"\"\"\n    for c in results:\n        for exit_code in (c[\"on_tree\"], c[\"on_stub\"]):\n            if exit_code not in (0, 1):\n                return f\"criterion could not check (exit {exit_code}): {c['name']}\"\n    return None\n\n\ndef commit_postdates(root: Path, earlier: str, later: str) -> bool:\n    \"\"\"Whether later is a strict descendant of earlier on this branch.\"\"\"\n    if earlier == later:\n        return False\n    run = subprocess.run([\"git\", \"-C\", str(root), \"merge-base\", \"--is-ancestor\", earlier, later],\n                         capture_output=True, check=False, env=git_env())\n    return run.returncode == 0\n\n\ndef cmd_spec_gate(argv: list[str]) -> int:\n    root = Path(\".\").resolve()\n    item_id = argv[0] if argv else derive_item_id(root)\n    if not item_id:\n        print(\"attavo spec-gate: cannot derive item id; pass N or run on an attavo/N-* branch\",\n              file=sys.stderr)\n        return 2\n    m = read_manifest(root)\n    if m is None:\n        print(f\"attavo spec-gate: no {MANIFEST} at {root}\", file=sys.stderr)\n        return 2\n    specs_rel = m[\"paths\"][\"specs\"]\n    records_rel = m[\"paths\"][\"records\"]\n    spec_dir = root / specs_rel / item_id\n    spec_md = spec_dir / \"spec.md\"\n    if not spec_md.is_file():\n        print(f\"attavo spec-gate: no spec at {spec_dir}\", file=sys.stderr)\n        return 2\n    spec_rel = str(Path(specs_rel) / item_id)\n    try:\n        spec_sha = last_commit_touching(root, spec_rel)\n    except ShallowCheckoutError as exc:\n        print(f\"attavo spec-gate: refused: {exc}\", file=sys.stderr)\n        return 2\n\n    records_dir = root / records_rel / item_id\n    try:\n        approved = approval_status(root, m, item_id) == \"valid\"\n    except ShallowCheckoutError as exc:\n        print(f\"attavo spec-gate: refused: {exc}\", file=sys.stderr)\n        return 2\n    latest_approval = latest_record(records_dir, \"approval\")\n    if approved:\n        record: dict[str, Any] = {\"sha\": git(root, \"rev-parse\", \"HEAD\").strip(), \"spec_sha\": spec_sha,\n                  \"at\": now_iso(), \"status\": \"approved\",\n                  \"approval_sha\": latest_approval.get(\"sha\") if latest_approval else None,\n                  \"criteria\": [], \"refusal\": None}\n        write_record(records_dir, \"spec\", record, m, item_id)\n        print(\"attavo spec-gate: approved (no criteria run)\")\n        return 0\n\n    # Third verdict, beside \"approved\" and Phase 1's \"pass\": the approval\n    # is not valid, but a build already ran after it -- the amendment that\n    # expired the approval landed above the line, not below it, and the\n    # tree the build produced is what must satisfy the criteria now, not\n    # the stub that only ever proved they were reachable before approval.\n    # Issue #98: whatever the build's status, including a halt -- the\n    # executor commits then asks, so a halted build's sha postdating the\n    # approval means it did the work. commit_postdates already excludes a\n    # halt that committed nothing, since such a build's sha equals its\n    # start_sha and so postdates nothing.\n    latest_build = latest_record(records_dir, \"build\")\n    built = bool(\n        latest_approval and latest_build\n        and commit_postdates(root, latest_approval[\"sha\"], latest_build[\"sha\"]))\n\n    parsed, refusal = parse_spec(spec_md)\n    results: list[dict[str, Any]] = []\n    if refusal is None:\n        # parse_spec returns a refusal exactly when it returns no spec.\n        parsed = cast(dict[str, Any], parsed)\n        refusal = root_cause_refusal(root, m, parsed.get(\"root_cause\"))\n    if refusal is None and not built:\n        # Required before approval only: an item already approved and\n        # built re-gates as it did, so no item in flight is stranded.\n        refusal = class_refusal(m, cast(dict[str, Any], parsed), records_dir)\n    if refusal is None:\n        parsed = cast(dict[str, Any], parsed)\n        if built:\n            refusal = stub_removed_refusal(root, spec_dir)\n            if refusal is None:\n                # Per criterion, not the set: passing on the tree is what\n                # the build already satisfied; failing on the tree but\n                # passing on the stub is a new obligation the next build\n                # must meet -- an operator scripting a ruling the executor\n                # skipped. Refused only when a criterion satisfies neither.\n                results = run_criteria(root, spec_dir, parsed[\"criteria\"], parsed[\"kinds\"])\n                refusal = could_not_check_refusal(results)\n                if refusal is None:\n                    # A behavioural criterion fails on the stub by design, so\n                    # after a build it is judged on the tree alone.\n                    fail_behav = next((c for c in results\n                                       if c[\"kind\"] == \"behavioural\" and c[\"on_tree\"] != 0), None)\n                    fail = next((c for c in results if c[\"kind\"] == \"structural\"\n                                 and c[\"on_tree\"] != 0 and c[\"on_stub\"] != 0), None)\n                    if fail_behav:\n                        refusal = f\"criterion labelled behavioural fails on the tree: {fail_behav['name']}\"\n                    elif fail:\n                        refusal = f\"criterion fails against the tree plus stub: {fail['name']}\"\n        elif not parsed[\"claims\"]:\n            refusal = \"claims: empty; the build may touch nothing\"\n        elif not parsed[\"criteria\"]:\n            # Zero criteria match zero files in criteria/, so the prose check\n            # below would pass a spec that asserts nothing, and approve it.\n            refusal = \"criteria: empty; the spec asserts nothing\"\n        elif stub_outside_claims(spec_dir, parsed[\"claims\"]) is not None:\n            refusal = (\"stub touches a path the claims do not name: \"\n                       f\"{stub_outside_claims(spec_dir, parsed['claims'])}\")\n        elif parsed[\"criteria\"] and \"structural\" not in parsed[\"kinds\"].values():\n            # A behavioural criterion only has to fail on the stub, so a\n            # spec of nothing else proves nothing reachable before approval.\n            refusal = (\"no structural criterion: nothing shows the stub reaches \"\n                       \"what the behavioural criteria test\")\n        else:\n            criteria_dir = spec_dir / \"criteria\"\n            listed = parsed[\"criteria\"]\n            existing = sorted(p.name for p in criteria_dir.iterdir()) if criteria_dir.is_dir() else []\n            prose = None\n            for name in listed:\n                if name not in existing:\n                    prose = name\n                    break\n            if prose is None:\n                for name in existing:\n                    if name not in listed:\n                        prose = name\n                        break\n            if prose is None:\n                for name in listed:\n                    if not os.access(criteria_dir / name, os.X_OK):\n                        prose = name\n                        break\n            if prose:\n                refusal = f\"criterion is prose: {prose}\"\n            else:\n                refusal = stub_removed_refusal(root, spec_dir)\n                if refusal is None:\n                    results = run_criteria(root, spec_dir, listed, parsed[\"kinds\"])\n                    refusal = could_not_check_refusal(results)\n                if refusal is None:\n                    fail_tree = next((c for c in results if c[\"on_tree\"] == 0), None)\n                    if fail_tree:\n                        refusal = f\"criterion passes against the tree: {fail_tree['name']}\"\n                    else:\n                        # The label is checked against the measured exits.\n                        fail_stub = next((c for c in results if c[\"kind\"] == \"structural\"\n                                          and c[\"on_stub\"] != 0), None)\n                        pass_stub = next((c for c in results if c[\"kind\"] == \"behavioural\"\n                                          and c[\"on_stub\"] == 0), None)\n                        if fail_stub:\n                            refusal = (\"criterion labelled structural fails on the tree plus stub: \"\n                                       f\"{fail_stub['name']}\")\n                        elif pass_stub:\n                            refusal = (\"criterion labelled behavioural passes on the tree plus stub: \"\n                                       f\"{pass_stub['name']}\")\n\n    status = \"refused\" if refusal else (\"built\" if built else \"pass\")\n    record = {\"sha\": git(root, \"rev-parse\", \"HEAD\").strip(),\n              \"spec_sha\": spec_sha,\n              \"at\": now_iso(), \"status\": status, \"approval_sha\": None,\n              \"criteria\": results, \"refusal\": refusal,\n              \"class\": (parsed or {}).get(\"class\"), \"research\": research_policy(m)}\n    write_record(records_dir, \"spec\", record, m, item_id)\n\n    if refusal:\n        print(f\"attavo spec-gate: refused: {refusal}\")\n        return 1\n    print(f\"attavo spec-gate: {status} ({len(results)} criterion/criteria)\")\n    return 0\n\n\nCRITERION_TIMEOUT = 120\n\n\nCOMMANDS = (\n        old.unlink()\n    for name, body in scripts.items():\n        (criteria / name).write_text(\"#!/bin/sh\\n\" + body + \"\\n\")\n        (criteria / name).chmod(0o755)\n    shutil.rmtree(spec_dir / \"stub\")\n    for rel, content in (stub or {}).items():\n        (spec_dir / \"stub\" / rel).parent.mkdir(parents=True, exist_ok=True)\n        (spec_dir / \"stub\" / rel).write_text(content)\n    commit_all(root, \"criteria with kinds\")\n\n\nSTRUCT = \"- [structural] checks_marker.sh: the marker file exists\"\nBEHAV = \"- [behavioural] logic.sh: the logic reports done\"\nTHIN_SCRIPTS = {\"checks_marker.sh\": \"test -f src/marker.txt\",\n                \"logic.sh\": \"test \\\"$(cat src/logic.txt 2>/dev/null)\\\" = done\"}\nTHIN_STUB = {\"src/marker.txt\": \"ok\\n\", \"src/logic.txt\": \"todo\\n\"}\n\n\ndef test_a_thin_stub_passes_and_the_record_carries_each_criterions_kind(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"valid\")\n    set_criteria(root, [STRUCT, BEHAV], THIN_SCRIPTS, THIN_STUB)\n    run = run_attavo(root, \"spec-gate\", \"1\")\n    assert run.returncode == 0, run.stdout + run.stderr\n    rec = latest_record(root, \"1\", \"spec\")\n    assert rec[\"status\"] == \"pass\"\n    assert rec[\"criteria\"] == [\n        {\"name\": \"checks_marker.sh\", \"kind\": \"structural\", \"on_tree\": 1, \"on_stub\": 0},\n        {\"name\": \"logic.sh\", \"kind\": \"behavioural\", \"on_tree\": 1, \"on_stub\": 1}]\n\n\ndef test_a_behavioural_criterion_that_passes_on_the_stub_is_refused_by_name(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"valid\")\n    set_criteria(root, [STRUCT, BEHAV], THIN_SCRIPTS,\n                 {\"src/marker.txt\": \"ok\\n\", \"src/logic.txt\": \"done\\n\"})\n    run = run_attavo(root, \"spec-gate\", \"1\")\n    assert run.returncode == 1\n    want = \"criterion labelled behavioural passes on the tree plus stub: logic.sh\"\n    assert want in run.stdout, run.stdout\n    rec = latest_record(root, \"1\", \"spec\")\n    assert rec[\"status\"] == \"refused\" and rec[\"refusal\"] == want\n\n\ndef test_a_structural_criterion_that_fails_on_the_stub_is_refused_by_name(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"valid\")\n    set_criteria(root, [STRUCT, BEHAV], THIN_SCRIPTS, {\"src/logic.txt\": \"todo\\n\"})\n    run = run_attavo(root, \"spec-gate\", \"1\")\n    assert run.returncode == 1\n    want = \"criterion labelled structural fails on the tree plus stub: checks_marker.sh\"\n    assert want in run.stdout, run.stdout\n    assert latest_record(root, \"1\", \"spec\")[\"refusal\"] == want\n\n\ndef test_an_unknown_kind_label_is_refused_by_name(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"valid\")\n    set_criteria(root, [\"- [cosmetic] checks_marker.sh: the marker file exists\"],\n                 {\"checks_marker.sh\": \"test -f src/marker.txt\"}, {\"src/marker.txt\": \"ok\\n\"})\n    run = run_attavo(root, \"spec-gate\", \"1\")\n    assert run.returncode == 1\n    want = \"criterion has an unknown kind [cosmetic]: checks_marker.sh\"\n    assert want in run.stdout, run.stdout\n    rec = latest_record(root, \"1\", \"spec\")\n    assert rec[\"status\"] == \"refused\" and rec[\"refusal\"] == want\n\n\ndef test_an_unlabelled_criterion_is_structural(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"valid\")\n    run = run_attavo(root, \"spec-gate\", \"1\")\n    assert run.returncode == 0, run.stdout + run.stderr\n    assert latest_record(root, \"1\", \"spec\")[\"criteria\"] == [\n        {\"name\": \"checks_marker.sh\", \"kind\": \"structural\", \"on_tree\": 1, \"on_stub\": 0}]\n    # An unlabelled criterion failing on the stub is refused as structural.\n    set_criteria(root, [\"- checks_marker.sh: the marker file exists\"],\n                 {\"checks_marker.sh\": \"test -f src/marker.txt\"}, {})\n    assert run_attavo(root, \"spec-gate\", \"1\").returncode == 1\n\n\n@pytest.mark.own_records\ndef test_every_merged_spec_parses_with_unlabelled_criteria_structural() -> None:\n    \"\"\"Regression: every spec under attest/specs/ parses with no refusal and\n    no label leaking into a name, and each criterion's kind is the one its\n    line declares: unlabelled is structural. Specs written before labels\n    are all unlabelled; #344's was the first labelled one, and an earlier\n    form of this test asserted that no spec would ever carry a label.\"\"\"\n    from attavo.spec import KIND_LABEL, parse_spec\n    specs = sorted((ROOT / \"attest\" / \"specs\").glob(\"*/spec.md\"))\n    assert specs\n    for spec_md in specs:\n        parsed, refusal = parse_spec(spec_md)\n        assert refusal is None and parsed is not None, spec_md\n        assert all(not n.startswith(\"[\") for n in parsed[\"criteria\"]), spec_md\n        assert list(parsed[\"kinds\"]) == parsed[\"criteria\"], spec_md\n        for line in spec_md.read_text().split(\"## Criteria\", 1)[1].splitlines():\n            s = line.strip()\n            if not s.startswith(\"- \") or \":\" not in s:\n                continue\n            label = KIND_LABEL.match(s[2:])\n            name = (s[2:][label.end():] if label else s[2:]).split(\":\", 1)[0].strip()\n            declared = label.group(1).strip() if label else \"structural\"\n            assert parsed[\"kinds\"][name] == declared, (spec_md, name)\n\n\ndef test_built_refuses_a_behavioural_criterion_that_fails_on_the_tree(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"valid\")\n    approve_valid(root)\n    assert run_real_build(root).returncode == 0\n    spec_md = root / \"specs\" / \"1\" / \"spec.md\"\n    spec_md.write_text(spec_md.read_text() + BEHAV + \"\\n\")\n    script = root / \"specs\" / \"1\" / \"criteria\" / \"logic.sh\"\n    script.write_text(\"#!/bin/sh\\n\" + THIN_SCRIPTS[\"logic.sh\"] + \"\\n\")\n    script.chmod(0o755)\n    (root / \"specs\" / \"1\" / \"stub\" / \"src\" / \"logic.txt\").write_text(\"todo\\n\")\n    commit_all(root, \"amend: a behavioural criterion the build never met\")\n    run = run_attavo(root, \"spec-gate\", \"1\")\n    assert run.returncode == 1\n    want = \"criterion labelled behavioural fails on the tree: logic.sh\"\n    assert want in run.stdout, run.stdout\n    rec = latest_record(root, \"1\", \"spec\")\n    assert rec[\"status\"] == \"refused\" and rec[\"refusal\"] == want\n\n\ndef test_built_accepts_a_behavioural_criterion_that_passes_on_the_tree(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"valid\")\n    approve_valid(root)\n    assert run_real_build(root).returncode == 0\n    spec_md = root / \"specs\" / \"1\" / \"spec.md\"\n    spec_md.write_text(spec_md.read_text() + BEHAV + \"\\n\")\n    script = root / \"specs\" / \"1\" / \"criteria\" / \"logic.sh\"\n    script.write_text(\"#!/bin/sh\\n\" + THIN_SCRIPTS[\"logic.sh\"] + \"\\n\")\n    script.chmod(0o755)\n    (root / \"specs\" / \"1\" / \"stub\" / \"src\" / \"logic.txt\").write_text(\"todo\\n\")\n    (root / \"src\" / \"logic.txt\").write_text(\"done\\n\")\n    commit_all(root, \"amend: a behavioural criterion the build met\")\n    run = run_attavo(root, \"spec-gate\", \"1\")\n    assert run.returncode == 0, run.stdout + run.stderr\n    rec = latest_record(root, \"1\", \"spec\")\n    assert rec[\"status\"] == \"built\"\n    by_name = {c[\"name\"]: c for c in rec[\"criteria\"]}\n    assert by_name[\"logic.sh\"] == {\"name\": \"logic.sh\", \"kind\": \"behavioural\", \"on_tree\": 0, \"on_stub\": 1}\n\n\nNO_STRUCTURAL = (\"no structural criterion: nothing shows the stub reaches \"\n                 \"what the behavioural criteria test\")\n\n\ndef test_a_spec_of_only_behavioural_criteria_is_refused(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"valid\")\n    set_criteria(root, [BEHAV], {\"logic.sh\": THIN_SCRIPTS[\"logic.sh\"]},\n                 {\"src/logic.txt\": \"todo\\n\"})\n    run = run_attavo(root, \"spec-gate\", \"1\")\n    assert run.returncode == 1\n    assert NO_STRUCTURAL in run.stdout, run.stdout\n    rec = latest_record(root, \"1\", \"spec\")\n    assert rec[\"status\"] == \"refused\" and rec[\"refusal\"] == NO_STRUCTURAL\n\n\ndef test_the_no_structural_refusal_comes_before_any_criterion_refusal(tmp_path: Path) -> None:\n    \"\"\"The one behavioural criterion here also passes on the stub, which\n    alone would be refused by name; the spec-level refusal is reported.\"\"\"\n    root = make_tenant(tmp_path, \"valid\")\n    set_criteria(root, [BEHAV], {\"logic.sh\": THIN_SCRIPTS[\"logic.sh\"]},\n                 {\"src/logic.txt\": \"done\\n\"})\n    run = run_attavo(root, \"spec-gate\", \"1\")\n    assert run.returncode == 1\n    assert latest_record(root, \"1\", \"spec\")[\"refusal\"] == NO_STRUCTURAL\n\n\nNO_CRITERIA = \"criteria: empty; the spec asserts nothing\"\n\n\ndef test_a_spec_with_no_criteria_is_refused_before_any_criterion_runs(tmp_path: Path) -> None:\n    \"\"\"An empty Criteria section and no criteria/ directory asserts nothing.\n    Zero criteria match zero files, so before this rule the gate passed it\n    and an approval bound to no executable claim could follow.\"\"\"\n    root = make_tenant(tmp_path, \"build_valid\")\n    spec_dir = root / \"specs\" / \"1\"\n    spec_md = spec_dir / \"spec.md\"\n    spec_md.write_text(spec_md.read_text().split(\"## Criteria\")[0] + \"## Criteria\\n\\n\")\n    shutil.rmtree(spec_dir / \"criteria\")\n    commit_all(root, \"criteria emptied\")\n    run = run_attavo(root, \"spec-gate\", \"1\")\n    assert run.returncode == 1\n    assert NO_CRITERIA in run.stdout, run.stdout\n    rec = latest_record(root, \"1\", \"spec\")\n    assert rec[\"status\"] == \"refused\"\n    assert rec[\"criteria\"] == []\n    assert rec[\"refusal\"] == NO_CRITERIA\n\n\n# Issue #351: a criterion that could not check is not a failing criterion.\n\nCOULD_NOT_CHECK = \"criterion could not check (exit 2): \"\n\n\ndef test_a_behavioural_criterion_that_exits_other_than_1_on_both_is_refused_by_name(tmp_path: Path) -> None:\n    \"\"\"Specimen: #349's behavioural criterion exited 2 (its own code for\n    \"the scenario could not be set up\") on the tree and on the stub in the\n    CI gate, and v0.34.0 accepted 2/2 as \"fails on both\".\"\"\"\n    root = make_tenant(tmp_path, \"valid\")\n    set_criteria(root, [STRUCT, \"- [behavioural] broken.sh: a scenario that cannot be set up\"],\n                 {\"checks_marker.sh\": \"test -f src/marker.txt || exit 1\",\n                  \"broken.sh\": \"exit 2\"},\n                 THIN_STUB)\n    run = run_attavo(root, \"spec-gate\", \"1\")\n    assert run.returncode == 1, run.stdout + run.stderr\n    assert COULD_NOT_CHECK + \"broken.sh\" in run.stdout, run.stdout\n    rec = latest_record(root, \"1\", \"spec\")\n    assert rec[\"status\"] == \"refused\" and rec[\"refusal\"] == COULD_NOT_CHECK + \"broken.sh\"\n\n\ndef test_a_structural_criterion_that_exits_other_than_1_on_the_tree_is_refused_by_name(tmp_path: Path) -> None:\n    \"\"\"`grep -q` on a missing file exits 2; a structural criterion must say\n    1 when the thing it checks is absent, so a crash is told from a no.\"\"\"\n    root = make_tenant(tmp_path, \"valid\")\n    set_criteria(root, [\"- [structural] crashes.sh: the marker file exists\"],\n                 {\"crashes.sh\": \"test -f src/marker.txt || exit 3\"},\n                 THIN_STUB)\n    run = run_attavo(root, \"spec-gate\", \"1\")\n    assert run.returncode == 1, run.stdout + run.stderr\n    assert \"criterion could not check (exit 3): crashes.sh\" in run.stdout, run.stdout\n    assert latest_record(root, \"1\", \"spec\")[\"refusal\"] == \"criterion could not check (exit 3): crashes.sh\"\n\n\ndef test_a_thin_stub_whose_criteria_exit_exactly_1_still_passes(tmp_path: Path) -> None:\n    root = make_tenant(tmp_path, \"valid\")\n    set_criteria(root, [STRUCT, BEHAV],\n                 {\"checks_marker.sh\": \"test -f src/marker.txt || exit 1\",\n                  \"logic.sh\": \"test \\\"$(cat src/logic.txt 2>/dev/null)\\\" = done || exit 1\"},\n                 THIN_STUB)\n    run = run_attavo(root, \"spec-gate\", \"1\")\n    assert run.returncode == 0, run.stdout + run.stderr\n    assert latest_record(root, \"1\", \"spec\")[\"status\"] == \"pass\"\ngit: warning: confstr() failed with code 5: couldn't get path of DARWIN_USER_TEMP_DIR; using /tmp instead\ngit: error: couldn't create cache file '/tm
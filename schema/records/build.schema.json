{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://attavo.dev/schema/records/build/1",
  "title": "attavo build record (build-NN.json)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sha", "start_sha", "spec_sha", "approval_sha", "at", "adapter",
    "adapter_config", "executor_identity", "reports", "adapter_version",
    "model", "model_version", "iterations", "criteria", "selected_tests",
    "checks", "tokens", "cost_usd", "wall_clock_s", "status", "refusal",
    "halted", "product_version", "product_pin"
  ],
  "properties": {
    "sha": {"type": "string", "minLength": 1},
    "start_sha": {"type": "string", "minLength": 1},
    "spec_sha": {"type": ["string", "null"]},
    "approval_sha": {"type": ["string", "null"]},
    "at": {"type": "string", "minLength": 1},
    "adapter": {"type": "string", "minLength": 1},
    "adapter_config": {
      "type": "object",
      "description": "Copied verbatim from [executor.<adapter>]; shape is the adapter's own contract, not this schema's."
    },
    "executor_identity": {
      "type": "object",
      "description": "Set by the product, never the tenant's git config (issue #33); every commit between start_sha and sha must carry it.",
      "additionalProperties": false,
      "required": ["name", "email"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "email": {"type": "string", "minLength": 1}
      }
    },
    "reports": {
      "type": "array",
      "description": "Field names adapters/<name>/conformance.json declares this adapter can supply with a real value (vendor independence, 2026-09-09 ruling) -- [] when the adapter declares no conformance.json. Dollars are never summed across adapters; a field absent here renders as not reported by this executor, never zero or blank.",
      "items": {"type": "string", "minLength": 1}
    },
    "adapter_version": {"type": ["string", "null"]},
    "model": {"type": ["string", "null"]},
    "model_version": {"type": ["string", "null"]},
    "iterations": {"type": "integer", "minimum": 1},
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "exit"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "exit": {"type": "integer"}
        }
      }
    },
    "selected_tests": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["select", "run", "count", "exit"],
      "properties": {
        "select": {"type": "string", "minLength": 1},
        "run": {"type": "string", "minLength": 1},
        "count": {"type": "integer", "minimum": 0},
        "exit": {"type": "integer"}
      }
    },
    "checks": {
      "type": ["object", "null"],
      "description": "Null when the manifest declares no [checks] table.",
      "additionalProperties": false,
      "required": ["command", "exit"],
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "exit": {"type": "integer"}
      }
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "output"],
      "properties": {
        "input": {"type": "integer", "minimum": 0},
        "output": {"type": "integer", "minimum": 0}
      }
    },
    "cost_usd": {
      "type": ["number", "null"],
      "description": "The tool's list-price meter, from the adapter's own report. Billed only when the build ran under adapter_config.auth = \"api\"; under auth = \"subscription\" this figure is a measure, not a bill -- usage is included in the operator's plan."
    },
    "wall_clock_s": {"type": "number", "minimum": 0},
    "status": {"type": "string", "enum": ["pass", "refused", "halted", "failed"]},
    "refusal": {"type": ["string", "null"]},
    "halted": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["question"],
      "properties": {
        "question": {"type": ["string", "null"]}
      }
    },
    "product_version": {"type": "string", "minLength": 1},
    "product_pin": {"type": ["string", "null"]}
  }
}

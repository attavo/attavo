#!/usr/bin/env python3
"""attavo: the command.

The implementation is the attavo/ package beside this directory, one module
per section of what used to be this one script; attavo/cli.py holds the
usage text, the command table, and main. This file only puts the package on
the import path and calls main, so a tenant that pins this repository by
version still runs one path with nothing to install.
"""
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from attavo.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

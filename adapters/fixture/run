#!/bin/sh
# adapters/fixture/run -- see ../README.md for the contract. Exists for the
# tests and the doctor; it is not an executor, and it never writes a record.
set -eu

write_name="${ATTAVO_FIXTURE_WRITE:-built.txt}"

if [ -n "${ATTAVO_FIXTURE_CEILING_ERROR:-}" ]; then
  # issue #89: a tool error line matching a declared ceiling (the
  # specimen is codex's own "input_too_large" on a diff too large to
  # judge, issue #86) -- for the ceiling/product rejection test only; a
  # real adapter's own tool prints this, never the adapter itself.
  echo "Error: input_too_large: request exceeds the maximum context length"
  exit 1
fi

echo "ATTAVO_ADAPTER_CONFIG=${ATTAVO_ADAPTER_CONFIG:-}"
echo "--- ATTAVO_FEEDBACK ---"
cat "${ATTAVO_FEEDBACK:-/dev/null}" 2>/dev/null || true
echo "--- end feedback ---"

if [ "${ATTAVO_STAGE:-build}" = "verify" ]; then
  echo "--- ATTAVO_DIFF ---"
  cat "${ATTAVO_DIFF:-/dev/null}" 2>/dev/null || true
  echo "--- end diff ---"
  if [ -n "${ATTAVO_FIXTURE_COMMIT_DURING_VERIFY:-}" ]; then
    # a verifier that commits anyway (issue #46) -- for the rejection
    # test only; a real adapter must never do this.
    echo "should not exist" > verify-side-effect.txt
    git add verify-side-effect.txt
    git commit -q -m "fixture: illegitimate commit during verify"
  fi
  if [ -n "${ATTAVO_FIXTURE_OMIT_FINDINGS:-}" ]; then
    # no findings key at all -- the absent-channel case issue #46 fixes,
    # distinct from an explicit empty list.
    printf '{"model":"fixture","model_version":null,"adapter_version":"fixture-1","tokens":{"input":1,"output":1},"cost_usd":0.0}\n'
  else
    # verify is a report, not a commit: one canned finding naming what
    # the criteria did not assert.
    printf '{"model":"fixture","model_version":null,"adapter_version":"fixture-1","tokens":{"input":1,"output":1},"cost_usd":0.0,"findings":[{"title":"fixture finding","specimen":"fixture","retires":"nothing real","rejection_test":"none","severity":"info"}],"tests_named":["tests/test_fixture.py::test_marker"]}\n'
  fi
  exit 0
fi

if [ -n "${ATTAVO_FIXTURE_QUESTION:-}" ]; then
  printf '{"status":"question","question":"%s","model":"fixture","model_version":null,"adapter_version":"fixture-1","tokens":{"input":0,"output":0},"cost_usd":0.0}\n' \
    "$ATTAVO_FIXTURE_QUESTION"
  exit 0
fi

if [ -n "${ATTAVO_FIXTURE_FOREIGN_COMMIT:-}" ]; then
  # a commit not authored by the executor identity build exports (issue
  # #33) -- for the rejection test only; unset the exported GIT_AUTHOR_*
  # and GIT_COMMITTER_* first, since those env vars outrank -c user.name
  # in git's own precedence and a real adapter never does either.
  echo "built" > built.txt
  git add built.txt
  env -u GIT_AUTHOR_NAME -u GIT_AUTHOR_EMAIL -u GIT_COMMITTER_NAME -u GIT_COMMITTER_EMAIL \
    git -c user.name="someone" -c user.email="someone@example.com" \
    commit -q -m "fixture: a commit not authored by the executor"
  echo '{"status":"done","question":null,"model":"fixture","model_version":null,"adapter_version":"fixture-1","tokens":{"input":1,"output":1},"cost_usd":0.0}'
  exit 0
fi

should_write=1
if [ -n "${ATTAVO_FIXTURE_REQUIRE_FEEDBACK:-}" ]; then
  should_write=0
  if [ -s "${ATTAVO_FEEDBACK:-/dev/null}" ]; then
    should_write=1
  fi
fi

if [ "$should_write" = "1" ]; then
  mkdir -p "$(dirname "$write_name")"
  echo "built" > "$write_name"
  git add "$write_name"
  git commit -q -m "fixture: write $write_name"
fi

echo '{"status":"done","question":null,"model":"fixture","model_version":null,"adapter_version":"fixture-1","tokens":{"input":1,"output":1},"cost_usd":0.0}'

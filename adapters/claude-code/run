#!/usr/bin/env python3
"""adapters/claude-code/run -- see README.md (this directory) for the five
configuration keys, and ../README.md for the shared adapter contract.

Not exercised by the test suite (judgment is measured, not tested); its
argument construction is checked by ATTAVO_ADAPTER_DRY_RUN=1, which prints
the `claude` command line as a JSON array instead of running it, and its
response handling is checked by ATTAVO_ADAPTER_RESPONSE_FILE, which reads a
canned --output-format json response from a file instead of invoking
`claude`.

The whole result is printed to stdout before this adapter's own final
line, so build-NN.log carries it as the transcript -- a halt otherwise
cannot be explained after the fact. is_error or an absent
structured_output exit 1 on either stage; a build status "question"
whose question is missing or under MIN_QUESTION_CHARS characters also
exits 1 (build records the attempt as failed) rather than a halt
someone must rule on.

ATTAVO_STAGE=verify branches to a different objective, schema, and
report shape (issue #46): the instruction states the verify objective
(see verify_instruction) instead of the build one, --json-schema is
VERIFY_SCHEMA instead of STATUS_SCHEMA, and the final line carries
findings and tests_named instead of status and question.
"""
from __future__ import annotations

import json
import os
import subprocess
import sys
from pathlib import Path

STATUS_SCHEMA = {
    "type": "object",
    "additionalProperties": False,
    "required": ["status", "question"],
    "properties": {
        "status": {"type": "string", "enum": ["done", "question"]},
        "question": {"type": ["string", "null"]},
    },
}

# The verify objective (issue #46): a verifier reports findings, not a
# commit. additionalProperties: False means the tool cannot hand back a
# structured_output shaped like STATUS_SCHEMA's status/question by
# accident -- an absent findings key is what cmd_verify treats as
# failed, not a lenient default here.
VERIFY_SCHEMA = {
    "type": "object",
    "additionalProperties": False,
    "required": ["findings", "tests_named"],
    "properties": {
        "findings": {
            "type": "array",
            "items": {
                "type": "object",
                "additionalProperties": False,
                "required": ["title", "specimen", "retires", "rejection_test", "severity"],
                "properties": {
                    "title": {"type": "string", "minLength": 1},
                    "specimen": {"type": "string", "minLength": 1},
                    "retires": {"type": "string", "minLength": 1},
                    "rejection_test": {"type": "string", "minLength": 1},
                    "severity": {"type": "string", "minLength": 1},
                },
            },
        },
        "tests_named": {"type": "array", "items": {"type": "string", "minLength": 1}},
    },
}


def read_text(path_env: str) -> str:
    path = os.environ.get(path_env)
    if not path:
        return ""
    p = Path(path)
    return p.read_text() if p.is_file() else ""


def spec_sections() -> list[str]:
    """The spec's Problem, Claims, and Criteria sections verbatim -- what
    both build and verify need to see, in the shape the spec contract
    (not this adapter) already gives them."""
    spec_dir = Path(os.environ["ATTAVO_SPEC_DIR"])
    lines = (spec_dir / "spec.md").read_text().splitlines()
    idx = [i for i, l in enumerate(lines) if l.startswith("## ")]
    headings = {lines[i].strip(): i for i in idx}
    bounds = sorted(idx) + [len(lines)]

    def section(heading: str) -> str:
        start = headings[heading]
        end = bounds[bounds.index(start) + 1] if start in bounds else len(lines)
        return "\n".join(lines[start:end]).strip()

    return [section("## Problem"), section("## Claims"), section("## Criteria")]


def build_instruction() -> str:
    parts = list(spec_sections())

    rulings = read_text("ATTAVO_RULINGS")
    if rulings.strip():
        parts.append("## Rulings\n\n" + rulings.strip())

    feedback = read_text("ATTAVO_FEEDBACK")
    if feedback.strip():
        parts.append("## Feedback from the previous attempt\n\n" + feedback.strip())

    parts.append(
        "commit your work on the current branch; if you cannot proceed "
        "without a decision that changes the criteria, do not guess: "
        "answer with status question")

    checks_command = os.environ.get("ATTAVO_CHECKS_COMMAND")
    if checks_command:
        parts.append(
            f"after you commit, the tenant's checks (`{checks_command}`) are run "
            "for you and any failure is returned to you on the next iteration; "
            "run only what you need while editing")

    return "\n\n".join(parts)


def verify_instruction() -> str:
    parts = list(spec_sections())

    diff = read_text("ATTAVO_DIFF")
    parts.append("## Diff since the approved spec\n\n" + (diff.strip() or "(the diff is empty)"))

    build_record = read_text("ATTAVO_BUILD_RECORD")
    if build_record.strip():
        parts.append("## The build record\n\n" + build_record.strip())

    parts.append(
        "you are verifying a completed build, not building: make no edits, "
        "write no files, commit nothing. Read the diff above against the "
        "criteria and name what the criteria do not assert but the diff "
        "should still be judged on, and name the tests that would assert "
        "it if they existed. A spec whose approval commit does not "
        "describe the working tree the build produced is itself a "
        "finding: the diff is judged against what was approved, and a "
        "divergence between them is reportable rather than assumed "
        "away. Report each as a finding: title, specimen (the file or "
        "commit the finding is about), retires (what having this "
        "finding on record replaces or closes -- every finding must "
        "carry one, or it is refused unfiled), rejection_test (the test "
        "that would catch a regression of it), and severity. Severity "
        "is derived rather than judged: the version, counter, "
        "condition, or state change that flips a finding from harmless "
        "to blocking; an adjective is not a severity. An empty "
        "findings list means you looked and found nothing to report, not "
        "that you did not look.")
    return "\n\n".join(parts)


DEFAULT_ALLOWED_TOOLS = ["Read", "Edit", "Write", "Bash(git *)", "Bash(python3 *)"]


def load_config() -> dict:
    raw = os.environ.get("ATTAVO_ADAPTER_CONFIG")
    return json.loads(raw) if raw else {}


def build_command(instruction: str, config: dict, schema: dict) -> list[str]:
    auth = config.get("auth", "api")
    allowed_tools = list(config.get("allowed_tools") or DEFAULT_ALLOWED_TOOLS)
    permission_mode = config.get("permission_mode", "acceptEdits")

    cmd = ["claude"]
    if auth == "subscription":
        # no --bare: this is the tenant's own login, not a bare API key, so
        # the tenant's project hooks and MCP servers must not load -- only
        # --setting-sources (CLAUDE.md still loads) and --strict-mcp-config
        # keep them out, the same isolation --bare gives in api mode.
        setting_sources = config.get("setting_sources", "user")
        cmd += ["--setting-sources", setting_sources, "--strict-mcp-config"]
    else:
        cmd += ["--bare"]
    cmd += ["-p", instruction,
           "--output-format", "json",
           "--json-schema", json.dumps(schema),
           "--permission-mode", permission_mode,
           "--allowedTools", ",".join(allowed_tools)]
    model = config.get("model")
    if model:
        cmd += ["--model", model]
    return cmd


def derive_model(response: dict) -> str | None:
    """--output-format json carries no top-level "model" field; the model
    id is the key of modelUsage, the per-model cost/usage breakdown. A
    request can carry more than one key (e.g. a lightweight helper model
    running alongside the primary one); the key with the most total
    tokens is the model that did the work.
    """
    model = response.get("model")
    if model:
        return model
    model_usage = response.get("modelUsage") or {}
    if not model_usage:
        return None

    def total_tokens(key: str) -> int:
        entry = model_usage[key]
        return (entry.get("inputTokens", 0) or 0) + (entry.get("outputTokens", 0) or 0)

    return max(model_usage, key=total_tokens)


def adapter_version() -> str:
    try:
        out = subprocess.run(["claude", "--version"], capture_output=True,
                             text=True, check=False)
    except OSError:
        return ""
    return out.stdout.strip()


MIN_QUESTION_CHARS = 40


def main() -> int:
    config = load_config()
    verifying = os.environ.get("ATTAVO_STAGE") == "verify"
    if verifying:
        instruction, schema = verify_instruction(), VERIFY_SCHEMA
    else:
        instruction, schema = build_instruction(), STATUS_SCHEMA
    cmd = build_command(instruction, config, schema)

    if os.environ.get("ATTAVO_ADAPTER_DRY_RUN"):
        # {"argv", "instruction", "schema"}, not a bare argv list: the
        # instruction lives in argv's own "-p" value here, but a second
        # adapter (issue #41) can deliver it on stdin instead, where
        # argv carries no instruction at all -- the envelope is what
        # stays adapter-agnostic for tests/test_executor_conformance.py.
        print(json.dumps({"argv": cmd, "instruction": instruction, "schema": schema}))
        return 0

    response_file = os.environ.get("ATTAVO_ADAPTER_RESPONSE_FILE")
    if response_file:
        raw_result = Path(response_file).read_text()
        response = json.loads(raw_result)
        print(raw_result.rstrip("\n"))
    else:
        run = subprocess.run(cmd, capture_output=True, text=True, check=False)
        if run.returncode != 0:
            # keep the evidence: claude's own account of a failure is the
            # only record of it once this process exits.
            if run.stdout.strip():
                print(run.stdout.rstrip("\n"))
            if run.stderr.strip():
                print(run.stderr.rstrip("\n"))
            return run.returncode
        response = json.loads(run.stdout)
        # keep the evidence: the whole result, not just the five fields
        # below, is the transcript build-NN.log saves -- a halt otherwise
        # cannot be explained after the fact.
        print(run.stdout.rstrip("\n"))
        if run.stderr.strip():
            print(run.stderr.rstrip("\n"))

    structured = response.get("structured_output") or {}

    # An error dressed as a question still costs a ruling act. Treat both
    # the same way build already treats a non-zero adapter exit: failed,
    # not a halt someone must rule on. Stage-independent: a tool error or
    # an absent report is a failure whether this is a build or a verify.
    if response.get("is_error") or not response.get("structured_output"):
        return 1

    model = derive_model(response)
    if not model:
        sys.stderr.write(
            "adapters/claude-code/run: could not derive a model id -- the "
            "response carried no top-level 'model' and an empty "
            "'modelUsage'\n")
        return 1

    usage = response.get("usage") or {}
    common = {
        "model": model,
        "model_version": response.get("model_version"),
        "adapter_version": adapter_version(),
        "tokens": {
            "input": usage.get("input_tokens", 0),
            "output": usage.get("output_tokens", 0),
        },
        "cost_usd": response.get("total_cost_usd"),
    }

    if verifying:
        # .get(), not "or []": an absent findings key must reach
        # cmd_verify as None, distinct from an explicit empty list --
        # that distinction is the whole fix for issue #46.
        line = {**common,
               "findings": structured.get("findings"),
               "tests_named": structured.get("tests_named")}
        print(json.dumps(line))
        return 0

    status = structured.get("status", "done")
    question = structured.get("question")
    if status == "question" and (not question or len(question) < MIN_QUESTION_CHARS):
        return 1

    line = {**common, "status": status, "question": question}
    print(json.dumps(line))
    return 0


if __name__ == "__main__":
    sys.exit(main())

#!/usr/bin/env python3
"""adapters/claude-code/run -- see README.md (this directory) for the five
configuration keys, and ../README.md for the shared adapter contract,
including the normalized event shape this adapter writes to stderr while
running.

Not exercised by the test suite (judgment is measured, not tested); its
argument construction is checked by ATTAVO_ADAPTER_DRY_RUN=1, which prints
the `claude` command line as a JSON array instead of running it, and its
response handling is checked by ATTAVO_ADAPTER_RESPONSE_FILE, which reads a
canned --output-format stream-json stream from a file (one JSON object per
line, the last one the final result) instead of invoking `claude`. A file
holding a single JSON object -- no stream, just the old single-response
shape -- still works: zero preceding lines means zero events to map.
"""
from __future__ import annotations

import json
import os
import subprocess
import sys
import threading
from datetime import datetime, timezone
from pathlib import Path

STATUS_SCHEMA = {
    "type": "object",
    "additionalProperties": False,
    "required": ["status", "question"],
    "properties": {
        "status": {"type": "string", "enum": ["done", "question"]},
        "question": {"type": ["string", "null"]},
    },
}


def read_text(path_env: str) -> str:
    path = os.environ.get(path_env)
    if not path:
        return ""
    p = Path(path)
    return p.read_text() if p.is_file() else ""


def build_instruction() -> str:
    spec_dir = Path(os.environ["ATTAVO_SPEC_DIR"])
    lines = (spec_dir / "spec.md").read_text().splitlines()
    idx = [i for i, l in enumerate(lines) if l.startswith("## ")]
    headings = {lines[i].strip(): i for i in idx}
    bounds = sorted(idx) + [len(lines)]

    def section(heading: str) -> str:
        start = headings[heading]
        end = bounds[bounds.index(start) + 1] if start in bounds else len(lines)
        return "\n".join(lines[start:end]).strip()

    parts = [section("## Problem"), section("## Claims"), section("## Criteria")]

    rulings = read_text("ATTAVO_RULINGS")
    if rulings.strip():
        parts.append("## Rulings\n\n" + rulings.strip())

    feedback = read_text("ATTAVO_FEEDBACK")
    if feedback.strip():
        parts.append("## Feedback from the previous attempt\n\n" + feedback.strip())

    parts.append(
        "commit your work on the current branch; if you cannot proceed "
        "without a decision that changes the criteria, do not guess: "
        "answer with status question")
    return "\n\n".join(parts)


DEFAULT_ALLOWED_TOOLS = ["Read", "Edit", "Write", "Bash(git *)", "Bash(python3 *)"]


def load_config() -> dict:
    raw = os.environ.get("ATTAVO_ADAPTER_CONFIG")
    return json.loads(raw) if raw else {}


def build_command(instruction: str, config: dict) -> list[str]:
    auth = config.get("auth", "api")
    allowed_tools = list(config.get("allowed_tools") or DEFAULT_ALLOWED_TOOLS)
    test_run = os.environ.get("ATTAVO_TEST_RUN_COMMAND")
    if test_run:
        allowed_tools.append(f"Bash({test_run} *)")
    permission_mode = config.get("permission_mode", "acceptEdits")

    cmd = ["claude"]
    if auth == "subscription":
        # no --bare: this is the tenant's own login, not a bare API key, so
        # the tenant's project hooks and MCP servers must not load -- only
        # --setting-sources (CLAUDE.md still loads) and --strict-mcp-config
        # keep them out, the same isolation --bare gives in api mode.
        setting_sources = config.get("setting_sources", "user")
        cmd += ["--setting-sources", setting_sources, "--strict-mcp-config"]
    else:
        cmd += ["--bare"]
    cmd += ["-p", instruction,
           "--output-format", "stream-json", "--verbose",
           "--json-schema", json.dumps(STATUS_SCHEMA),
           "--permission-mode", permission_mode,
           "--allowedTools", ",".join(allowed_tools)]
    model = config.get("model")
    if model:
        cmd += ["--model", model]
    return cmd


def derive_model(response: dict) -> str | None:
    """--output-format json carries no top-level "model" field; the model
    id is the key of modelUsage, the per-model cost/usage breakdown. A
    request can carry more than one key (e.g. a lightweight helper model
    running alongside the primary one); the key with the most total
    tokens is the model that did the work.
    """
    model = response.get("model")
    if model:
        return model
    model_usage = response.get("modelUsage") or {}
    if not model_usage:
        return None

    def total_tokens(key: str) -> int:
        entry = model_usage[key]
        return (entry.get("inputTokens", 0) or 0) + (entry.get("outputTokens", 0) or 0)

    return max(model_usage, key=total_tokens)


def now_iso() -> str:
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def normalized_event(event: str, tool: str | None = None, target: str | None = None,
                     detail: str | None = None) -> dict:
    """adapters/README.md's shape: {at, event, tool, target, detail}."""
    return {"at": now_iso(), "event": event, "tool": tool, "target": target, "detail": detail}


def tool_target(block: dict) -> str | None:
    """A tool_use content block's target: a file path or a command, one
    line -- never the tool's full input, which can be large or non-text.
    """
    inp = block.get("input") or {}
    for key in ("file_path", "path", "notebook_path"):
        if inp.get(key):
            return str(inp[key])
    command = inp.get("command")
    if command:
        return str(command).splitlines()[0]
    return None


def stream_events(raw: dict) -> list[dict]:
    """One raw claude --output-format stream-json line -> zero or more
    normalized events. Only assistant messages carry anything worth
    surfacing live; init, rate-limit, and tool-result lines map to nothing.
    """
    if raw.get("type") != "assistant":
        return []
    blocks = (raw.get("message") or {}).get("content") or []
    events = []
    for block in blocks:
        if block.get("type") == "tool_use":
            events.append(normalized_event("tool", tool=block.get("name"),
                                           target=tool_target(block)))
        elif block.get("type") == "text":
            events.append(normalized_event("text", detail=block.get("text")))
    return events


def emit(event: dict) -> None:
    sys.stderr.write(json.dumps(event) + "\n")
    sys.stderr.flush()


def adapter_version() -> str:
    try:
        out = subprocess.run(["claude", "--version"], capture_output=True,
                             text=True, check=False)
    except OSError:
        return ""
    return out.stdout.strip()


def main() -> int:
    config = load_config()
    cmd = build_command(build_instruction(), config)

    if os.environ.get("ATTAVO_ADAPTER_DRY_RUN"):
        print(json.dumps(cmd))
        return 0

    response_file = os.environ.get("ATTAVO_ADAPTER_RESPONSE_FILE")
    if response_file:
        lines = [l for l in Path(response_file).read_text().splitlines() if l.strip()]
        if not lines:
            sys.stderr.write("adapters/claude-code/run: ATTAVO_ADAPTER_RESPONSE_FILE is empty\n")
            return 1
        for raw_line in lines[:-1]:
            for event in stream_events(json.loads(raw_line)):
                emit(event)
        response = json.loads(lines[-1])
    else:
        proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                text=True, bufsize=1)
        stderr_lines: list[str] = []
        stderr_thread = threading.Thread(
            target=lambda: stderr_lines.extend(l.rstrip("\n") for l in proc.stderr))
        stderr_thread.start()

        last_line = None
        for raw_line in proc.stdout:
            raw_line = raw_line.rstrip("\n")
            if not raw_line.strip():
                continue
            last_line = raw_line
            try:
                parsed = json.loads(raw_line)
            except ValueError:
                continue
            for event in stream_events(parsed):
                emit(event)

        proc.stdout.close()
        stderr_thread.join()
        proc.wait()

        if proc.returncode != 0:
            sys.stderr.write("\n".join(stderr_lines))
            return proc.returncode
        if last_line is None:
            sys.stderr.write("adapters/claude-code/run: claude produced no output\n")
            return 1
        response = json.loads(last_line)

    model = derive_model(response)
    if not model:
        sys.stderr.write(
            "adapters/claude-code/run: could not derive a model id -- the "
            "response carried no top-level 'model' and an empty "
            "'modelUsage'\n")
        return 1

    structured = response.get("structured_output") or {}
    usage = response.get("usage") or {}
    line = {
        "status": structured.get("status", "done"),
        "question": structured.get("question"),
        "model": model,
        "model_version": response.get("model_version"),
        "adapter_version": adapter_version(),
        "tokens": {
            "input": usage.get("input_tokens", 0),
            "output": usage.get("output_tokens", 0),
        },
        "cost_usd": response.get("total_cost_usd"),
    }
    print(json.dumps(line))
    return 0


if __name__ == "__main__":
    sys.exit(main())
